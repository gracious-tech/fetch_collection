  <book code="MAT" style="id">EN_VLT vi_Vietnamese_ltr Mon Feb 26 2024 09:39:01 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Phúc Âm Ma-thi-ơ</para>
  <para style="toc2">Ma-thi-ơ</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-thi-ơ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Bảng gia phả của Chúa Cứu Thế Giê-xu, con cháu Đa-vít, con cháu Áp-ra-ham: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Áp-ra-ham sinh Y-sác, Y-sác sinh Gia-cốp, Gia-cốp sinh Giu-đa và anh em của ông, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Giu-đa bởi Ta-ma sinh Phê-rết và Sê-rách, Phê-rết sinh Hết-rôn, Hết-rôn sinh A-ram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />A-ram sinh A-mi-na-đáp, A-mi-na-đáp sinh Na-ách-son, Na-ách-son sinh Sanh-môn, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Sanh-môn bởi Ra-háp sinh Bô-ô, Bô-ô bởi Ru-tơ sinh Ô-bết, Ô-bết sinh Gie-sê, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Gie-sê sinh vua Đa-vít, Đa-vít bởi vợ của U-ri sinh Sa-lô-môn,<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-lô-môn sinh Rô-bô-am, Rô-bô-am sinh A-bi-gia, A-bi-gia sinh A-sa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa sinh Giô-sa-phát, Giô-sa-phát sinh Giô-ram, Giô-ram sinh Ô-xia. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ô-xia sinh Giô-tam, Giô-tam sinh A-cha, A-cha sinh Ê-xê-chia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ê-xê-chia sinh Ma-na-se, Ma-na-se sinh A-môn, A-môn sinh Giô-si-a, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Giô-si-a sinh Giê-cô-nia và anh em của ông vào cuộc lưu đày qua Ba-by-lôn,<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />và sau cuộc lưu đày qua Ba-by-lôn, Giê-cô-nia sinh Sa-la-thi-ên, Sa-la-thi-ên sinh Xô-rô-ba-bên, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Xô-rô-ba-bên sinh A-bi-út, A-bi-út sinh Ê-li-a-kim, Ê-li-a-kim sinh A-xô, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-xô sinh Sa-đốc, Sa-đốc sinh A-chim, A-chim sinh Ê-li-út, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-út sinh Ê-lê-a-xa, Ê-lê-a-xa sinh Ma-than, Ma-than sinh Gia-cốp, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Gia-cốp sinh Giô-sép, chồng của Ma-ri, mà bởi bà, Chúa Giê-xu, Đấng được gọi là Chúa Cứu Thế, được sinh ra. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Như vậy, toàn bộ các thế hệ từ Áp-ra-ham đến Đa-vít là mười bốn thế hệ, từ Đa-vít đến cuộc lưu đày qua Ba-by-lôn là mười bốn thế hệ, và từ cuộc lưu đày qua Ba-by-lôn đến Chúa Cứu Thế là mười bốn thế hệ.<verse eid="MAT 1:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Sự giáng sinh của Chúa Cứu Thế Giê-xu là như sau: Khi Ma-ri, mẹ Ngài, đã đính hôn với Giô-sép, nhưng trước lúc họ ăn ở với nhau, cô bị phát hiện mang thai do nơi Chúa Thánh Linh. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Còn Giô-sép, chồng cô, là người công chính, và vì không muốn công khai vạch trần cô, anh định âm thầm ly hôn cô. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Nhưng khi anh đang suy nghĩ về những việc ấy, thì hãy xem kìa, thiên sứ của Chúa hiện ra cùng anh trong giấc mơ, bảo: “Giô-sép, con cháu Đa-vít, anh đừng ngại lấy Ma-ri làm vợ, vì con trẻ được hoài thai trong cô ấy là do nơi Chúa Thánh Linh. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Cô ấy sẽ sinh một con trai, và anh sẽ đặt tên con là Giê-xu, vì con ấy sẽ cứu dân mình ra khỏi tội lỗi họ.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Mọi việc này xảy ra để được ứng nghiệm điều đã được Chúa phán qua vị tiên tri, rằng:<verse eid="MAT 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="MAT 1:23" />“Hãy xem kìa, trinh nữ sẽ mang thai và sinh một con trai, và người ta sẽ gọi danh Ngài là Em-ma-nu-ên” — được dịch là “Thiên Chúa ở cùng chúng ta.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Rồi sau khi được đánh thức khỏi giấc ngủ, Giô-sép đã làm y như thiên sứ của Chúa đã phán dặn và lấy cô ấy làm vợ mình. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Nhưng anh không ăn ở với cô ấy cho đến khi cô sinh một con trai. Rồi anh gọi tên con ấy là Giê-xu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Sau khi Chúa Giê-xu đã được sinh ra tại Bết-lê-hem vùng Giu-đê trong thời vua Hê-rốt, thì hãy xem kìa, các nhà thông thái từ phương đông đến tại Giê-ru-sa-lem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />hỏi rằng: “Đấng đã được sinh ra là Vua dân Do Thái ở đâu? Vì chúng tôi đã thấy ngôi sao của Ngài tại phương đông và đến để tôn thờ Ngài.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Nhưng sau khi nghe điều ấy, vua Hê-rốt bị kích động, và cả thành Giê-ru-sa-lem cũng như ông. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Rồi sau khi triệu tập tất cả các thầy tế lễ cả và các thầy dạy luật trong dân chúng, ông tra hỏi họ: “Cứu Chúa được sinh ra tại đâu?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Họ tâu với vua: “Tại Bết-lê-hem vùng Giu-đê, vì đã được viết như thế qua vị tiên tri,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Còn Bết-lê-hem, đất Giu-đa,</para>
  <para style="q1" vid="MAT 2:6">ngươi chẳng hề là nhỏ nhất trong giới lãnh đạo của Giu-đa,</para>
  <para style="q1" vid="MAT 2:6">vì từ ngươi sẽ ra một Đấng cai trị</para>
  <para style="q1" vid="MAT 2:6">là Đấng sẽ chăn dắt Y-sơ-ra-ên, dân Ta.’”<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Lúc đó, sau khi bí mật gọi các nhà thông thái đến, Hê-rốt gặng hỏi họ thời điểm xuất hiện của ngôi sao. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Khi đã để họ đi đến Bết-lê-hem, ông dặn: “Sau khi đi, các ông hãy tra hỏi kỹ càng về con trẻ, rồi lúc các ông đã tìm thấy, hãy báo cho ta để ta cũng đến tôn thờ Ngài.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Sau khi đã nghe vua, họ được lên đường, và hãy xem kìa, ngôi sao mà họ đã nhìn thấy ở phương đông đi trước họ cho tới khi đã đến thì nó đứng yên trên chỗ con trẻ ở. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Khi đã nhìn thấy ngôi sao, họ mừng rỡ trong niềm vui quá đỗi. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Sau khi vào trong nhà, họ thấy con trẻ cùng Ma-ri, mẹ Ngài. Rồi lúc đã quỳ xuống thì họ thờ phượng Ngài, và khi đã mở báu vật của mình ra, họ dâng cho Ngài các lễ vật: vàng, nhũ hương và nhựa thơm. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Và vì đã được cảnh báo đừng quay trở lại với Hê-rốt trong một giấc mơ, họ về nước mình bằng đường khác.<verse eid="MAT 2:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Lúc họ đã đi rồi, thì hãy xem kìa, một thiên sứ của Chúa hiện ra với Giô-sép qua một giấc mơ, phán rằng: “Sau khi tỉnh dậy, hãy đưa theo mình con trẻ cùng mẹ con trẻ ấy và lánh sang Ai Cập, rồi hãy ở lại đó cho đến khi nào tôi bảo anh, vì Hê-rốt định tìm con trẻ để giết đi.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Rồi sau khi tỉnh dậy, anh đã đưa con trẻ cùng mẹ Ngài lánh sang Ai Cập trong ban đêm, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />và anh ở lại đó cho đến khi Hê-rốt qua đời, ấy là để được ứng nghiệm điều đã được phán bởi Chúa qua vị tiên tri, rằng: “Ta đã gọi con Ta ra khỏi Ai Cập.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Lúc ấy, khi thấy rằng mình đã bị các nhà thông thái giễu cợt, Hê-rốt rất tức giận, sau khi truyền tin đi, ông sát hại hết thảy các bé trai từ hai tuổi trở xuống tại Bết-lê-hem và trong toàn cõi của vùng đó, theo như thời điểm mà ông ta gặng hỏi từ các nhà thông thái. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Như vậy là được ứng nghiệm điều đã được phán qua tiên tri Giê-rê-mi, rằng:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Một tiếng kêu được nghe thấy trong thành Ra-ma,</para>
  <para style="q1" vid="MAT 2:18">tiếng rên rỉ và than thở thảm thiết,</para>
  <para style="q1" vid="MAT 2:18">Ra-chên khóc cho các con mình,</para>
  <para style="q1" vid="MAT 2:18">và nàng không chịu được yên ủi, vì chúng không còn nữa.”<verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Bấy giờ, khi Hê-rốt đã qua đời, thì hãy xem kìa, một thiên sứ của Chúa hiện ra với Giô-sép qua một giấc mơ tại Ai Cập, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />bảo rằng: “Sau khi tỉnh dậy, hãy đưa theo mình con trẻ cùng mẹ con trẻ ấy và đi đến đất Y-sơ-ra-ên, vì những kẻ truy sát tính mạng của con trẻ đã chết.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Rồi lúc đã thức dậy, ông đưa theo mình con trẻ cùng mẹ Ngài, và vào trong đất Y-sơ-ra-ên. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Tuy nhiên, khi nghe rằng A-chê-la-u đang cai trị trên vùng Giu-đê thay cho Hê-rốt, cha mình, anh sợ đi đến đó. Nhưng khi đã được cảnh báo qua giấc mơ, anh lui về vùng Ga-li-lê, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />và khi đã đến đó rồi, anh cư ngụ trong một thành được gọi là Na-xa-rét, để được ứng nghiệm điều đã được phán qua các vị tiên tri, rằng Ngài sẽ được gọi là người Na-xa-rét.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Trong những ngày đó, Giăng Báp-tít đến rao giảng trong hoang mạc vùng Giu-đê, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />rằng: “Hãy ăn năn, vì vương quốc thiên đàng đã gần.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Vì đây là người đã được nói đến bởi tiên tri Ê-sai, rằng:</para>
  <para style="q1" vid="MAT 3:3">“Có tiếng người kêu lớn trong hoang mạc:</para>
  <para style="q1" vid="MAT 3:3">‘Hãy dọn sẵn đường của Chúa,</para>
  <para style="q1" vid="MAT 3:3">hãy làm bằng phẳng các lối Ngài.’”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Giăng này mặc đồ từ lông lạc đà, đeo thắt lưng bằng da quanh hông, còn thức ăn của ông là châu chấu và mật ong rừng. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Rồi dân thành Giê-ru-sa-lem, cả vùng Giu-đê và toàn bộ khu vực xung quanh sông Giô-đanh đến với ông, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />và khi đang xưng tội mình, họ được ông làm báp-têm dưới sông Giô-đanh. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Sau khi nhìn thấy nhiều người Pha-ri-si và Sa-đu-sê đến vì phép báp-têm của mình, ông nói với họ: “Bọn con cháu của rắn độc kia! Ai đã cảnh báo các người trốn chạy khỏi cơn thịnh nộ sắp đến? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Vậy nên, hãy kết quả xứng đáng với lòng ăn năn. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Và các ông cũng đừng tưởng mà bảo nhau: ‘Chúng ta có tổ phụ Áp-ra-ham.’ Vì tôi nói với các ông rằng Thiên Chúa có thể dấy lên con cháu cho Áp-ra-ham từ những hòn đá này. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Nhưng cái rìu đã được đặt kề rễ cây rồi. Cho nên, tất cả các cây nếu không sinh trái tốt thì bị chặt xuống và quăng vào lửa. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Tôi làm báp-têm về sự ăn năn cho anh chị em bằng nước. Nhưng Đấng đến sau tôi có quyền năng hơn tôi, về Đấng ấy thì tôi là kẻ không xứng đáng để xách giày của Ngài. Ngài sẽ làm báp-têm cho anh chị em bằng Chúa Thánh Linh và bằng lửa; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />cây chĩa của Ngài ở trong tay Ngài, rồi Ngài sẽ rê sạch sẽ sân đập lúa mình và gom lúa của Ngài vào kho. Nhưng Ngài sẽ đốt trụi rơm rạ bằng lửa chẳng bao giờ dập tắt được.”<verse eid="MAT 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Lúc ấy, Chúa Giê-xu đi từ xứ Ga-li-lê đến sông Giô-đanh, chỗ của Giăng, để được ông làm báp-têm cho. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Nhưng Giăng cứ một mực can ngăn Ngài, rằng: “Tôi mới có nhu cầu được Ngài làm báp-têm cho, vậy mà Ngài lại đến với tôi ư?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Nhưng khi đáp lại, Chúa Giê-xu nói với ông: “Bây giờ, hãy làm vậy đi, vì như thế là thích hợp đối với chúng ta để làm trọn mọi sự công chính.” Rồi Ngài để ông làm. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Bấy giờ, sau khi chịu báp-têm rồi, Chúa Giê-xu lập tức lên khỏi nước, và xem kìa, các tầng trời được mở ra cho Ngài, rồi Ngài nhìn thấy Thánh Linh của Thiên Chúa giáng xuống giống như chim bồ câu, đậu trên Ngài, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />và xem kìa, một tiếng phán từ các tầng trời rằng: “Đây là Con yêu dấu của Ta. Ta hài lòng nơi Con ấy.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Rồi Chúa Giê-xu được dẫn vào hoang mạc bởi Thánh Linh để chịu ma quỷ cám dỗ. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Sau đó, lúc đã kiêng ăn bốn mươi ngày và bốn mươi đêm, thì Ngài đói. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Sau khi đến gần, kẻ cám dỗ nói với Ngài: “Nếu ông là Con Thiên Chúa, hãy ra lệnh để những hòn đá này trở thành bánh đi.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Nhưng đáp lại, Ngài nói: “Có lời được chép: ‘Con người sẽ sống chẳng phải nhờ bánh mà thôi, nhưng là nhờ mọi lời phát ra từ miệng Thiên Chúa.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Rồi ma quỷ đem Ngài vào trong thành thánh, cho Ngài đứng ở trên điểm cao nhất của đền thờ, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />và nói với Ngài: “Nếu ông là Con Thiên Chúa, hãy quăng mình xuống đi, vì có lời được chép, rằng: ‘Ngài sẽ truyền lệnh về con cho các thiên sứ Ngài,’ và: ‘Họ sẽ nâng con dựa trên tay họ, kẻo chân con có thể vấp vào hòn đá.’”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Chúa Giê-xu đáp lại nó: “Mặt khác, có lời được chép: ‘Con sẽ chẳng thử Chúa, là Thiên Chúa của con.’” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Một lần nữa, ma quỷ đem Ngài lên một ngọn núi rất cao và cho Ngài xem tất cả các nước trên thế gian cùng sự tráng lệ của chúng. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Và nó nói với Ngài: “Tôi sẽ cho ông tất cả những thứ này, nếu ông thờ lạy tôi, bằng cách sắp mình xuống.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Lúc đó, Chúa Giê-xu phán với nó: “Sa-tan, hãy biến đi! Vì có lời được chép: ‘Con sẽ thờ phượng Chúa, là Thiên Chúa của con, và con sẽ phục vụ chỉ một mình Ngài.’” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Rồi ma quỷ lìa khỏi Ngài, và xem kìa, các thiên sứ đến và bắt đầu phục vụ Ngài.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Bấy giờ, sau khi nghe rằng Giăng đã bị bắt, Ngài lui về xứ Ga-li-lê. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Khi đã rời khỏi Na-xa-rét, Ngài đến sống tại thành Ca-bê-na-um cạnh biển, trong địa phận Sa-bu-lôn và Nép-ta-li, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />để được ứng nghiệm điều đã được phán qua tiên tri Ê-sai, rằng:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Đất Sa-bu-lôn và đất Nép-ta-li,</para>
  <para style="q1" vid="MAT 4:15">con đường ra hướng biển, bên kia sông Giô-đanh,</para>
  <para style="q1" vid="MAT 4:15">tức là xứ Ga-li-lê của các dân ngoại quốc —<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />dân ngồi trong bóng tối</para>
  <para style="q1" vid="MAT 4:16">đã nhìn thấy ánh sáng lớn,</para>
  <para style="q1" vid="MAT 4:16">và với những kẻ ngồi trong vùng đất và bóng sự chết,</para>
  <para style="q1" vid="MAT 4:16">thì ánh sáng đã rạng soi trên họ.”<verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Từ lúc đó, Chúa Giê-xu bắt đầu rao giảng và phán: “Hãy ăn năn, vì vương quốc thiên đàng đã đến gần.” <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Bấy giờ, lúc đang đi bộ bên biển Ga-li-lê, Ngài nhìn thấy hai anh em, Si-môn, được gọi là Phi-e-rơ, và Anh-rê, em ông ấy, đang thả lưới xuống biển vì họ là ngư phủ. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Và Ngài bảo họ: “Hãy đi theo thầy, thì thầy sẽ khiến anh em thành những tay đánh lưới người.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Lập tức, khi đã rời bỏ lưới mình, họ theo Ngài. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Sau khi từ đó đi tiếp, Ngài thấy hai anh em khác, là Gia-cơ con của Xê-bê-đê, và Giăng, em ông, trong thuyền cùng với Xê-bê-đê, cha của họ, đang vá lưới mình và Ngài kêu gọi họ, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />rồi lập tức, khi đã rời bỏ thuyền và cha mình, họ theo Ngài.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Và Ngài đi đây đó trong khắp xứ Ga-li-lê, dạy dỗ trong các nhà hội của người dân, rao giảng Phúc Âm về vương quốc, cùng chữa lành mọi bệnh tật và mọi đau ốm trong dân chúng. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Tin đồn về Ngài vang ra cho đến khắp cả xứ Sy-ri, và người ta đem đến cho Ngài mọi kẻ có bệnh, bị mắc phải nhiều chứng bệnh và đau nhức khác nhau, bị quỷ ám, động kinh, bại liệt, và Ngài chữa lành cho họ. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Những đoàn dân đông đi theo Ngài từ Ga-li-lê, Đê-ca-bô-lơ, Giê-ru-sa-lem, Giu-đê và phía bên kia sông Giô-đanh.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Bấy giờ, sau khi thấy đoàn dân, Ngài đi lên trên núi, và khi Ngài đã ngồi xuống, các môn đồ Ngài đến cùng Ngài. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Ngài mở miệng dạy dỗ họ, rằng:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Phước thay là những người nghèo khó trong tâm linh,</para>
  <para style="q2" vid="MAT 5:3">vì vương quốc thiên đàng là của họ.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Phước thay là những người than khóc,</para>
  <para style="q2" vid="MAT 5:4">vì họ sẽ được an ủi.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Phước thay là những người nhu mì,</para>
  <para style="q2" vid="MAT 5:5">vì họ sẽ hưởng được đất.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Phước thay là những người đói và khát sự công chính,</para>
  <para style="q2" vid="MAT 5:6">vì họ sẽ được thỏa dạ.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Phước thay là những người hay thương xót,</para>
  <para style="q2" vid="MAT 5:7">vì họ sẽ được thương xót.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Phước thay là những người thanh sạch trong tấm lòng,</para>
  <para style="q2" vid="MAT 5:8">vì họ sẽ nhìn thấy Thiên Chúa.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Phước thay là những người giải hòa,</para>
  <para style="q2" vid="MAT 5:9">vì họ sẽ được gọi là các con của Thiên Chúa.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Phước thay là những người bị bắt bớ bởi cớ sự công chính,</para>
  <para style="q2" vid="MAT 5:10">vì vương quốc thiên đàng là của họ.<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />Anh chị em có phước khi người ta sỉ nhục anh chị em, cùng bức hại và nói mọi điều dữ vu khống nghịch cùng anh chị em vì cớ thầy.<verse eid="MAT 5:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 5:12" />Hãy vui mừng và sung sướng, bởi phần thưởng của anh chị em rất lớn trên thiên đàng, vì người ta đã bắt bớ các vị tiên tri trước anh chị em y như vậy.<verse eid="MAT 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Anh chị em là muối của đất. Nhưng nếu muối bị mất vị, thì nó sẽ được làm cho mặn bằng cái gì? Ngoại trừ bị quăng ra ngoài để bị giẫm đạp bởi người ta, thì nó chẳng ích lợi cho điều gì nữa. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Anh chị em là ánh sáng của thế gian. Một thành phố nằm trên đỉnh đồi thì không thể bị che khuất được. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Cũng không ai thắp đèn và đặt nó dưới cái thùng, nhưng là trên chân đèn, và nó soi sáng cho mọi người trong nhà. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Tương tự, ánh sáng của anh chị em hãy chiếu ra trước mặt người ta, sao cho họ có thể thấy những việc lành của anh chị em và ngợi khen Cha của anh chị em trên thiên đàng.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Đừng nghĩ rằng thầy đã đến để phá hủy luật pháp hay các lời tiên tri. Thầy đã đến không phải để phá hủy, nhưng là để làm cho trọn. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Vì quả thật, thầy nói với anh chị em, cho đến khi trời và đất qua đi, thì một chấm hoặc một nét trong luật pháp chắc chắn không qua đi cho tới lúc nào mọi sự được thành tựu. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Vì thế, hễ ai hủy bỏ một trong những điều nhỏ nhất của các điều răn này và dạy người ta như vậy thì sẽ bị gọi là nhỏ nhất trong vương quốc thiên đàng. Nhưng người nào thực hiện và truyền dạy chúng, người đó sẽ được gọi là lớn trong vương quốc thiên đàng. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Vì thầy nói với anh chị em rằng nếu sự công chính của anh chị em không trổi hơn sự công chính của các thầy dạy luật và người Pha-ri-si, thì anh chị em chắc chắn sẽ không vào trong vương quốc thiên đàng.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Anh chị em đã nghe như vầy, điều đã được truyền cho người xưa: ‘Không được giết người,’ mà ‘Kẻ nào giết người thì sẽ phải chịu sự phán xét.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Nhưng thầy nói với anh chị em rằng mọi kẻ nổi giận với anh em mình sẽ chịu sự phán xét. Mà kẻ nào kêu anh em mình: ‘Đồ ngu!’ thì sẽ chịu hội đồng xét xử. Còn kẻ nào chửi: ‘Đồ dốt nát!’ thì sẽ chịu trừng phạt tại hỏa ngục. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Do đó, nếu anh chị em đang dâng của lễ mình nơi bàn thờ rồi tại đó, anh chị em nhớ ra rằng một người anh em của mình có điều gì đó nghịch với mình, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />thì hãy bỏ lại của lễ mình ở trước bàn thờ và rời đi; trước hết hãy làm hòa với người anh em của mình đó, và rồi, sau khi đi, hãy dâng của lễ mình. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Hãy dàn xếp trong thiện cảm với người thưa kiện mình cách nhanh chóng hễ khi nào anh chị em đang ở trên đường cùng với người ấy, kẻo người thưa kiện có thể giao anh chị em cho quan tòa, và quan tòa chuyển cho cảnh binh, rồi anh chị em sẽ bị ném vào tù. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Quả thật, thầy nói với anh chị em, anh chị em chắc chắn sẽ không ra khỏi đó cho tới khi nào anh chị em có thể trả đồng tiền cuối cùng.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Anh chị em đã nghe như vầy, lời đã được truyền: ‘Không được phạm tội ngoại tình.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Nhưng thầy nói với anh chị em rằng bất cứ ai nhìn một phụ nữ với mục đích ham muốn cô ấy, thì kẻ đó đã phạm tội ngoại tình với cô ấy trong lòng mình rồi. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Mặt khác, nếu con mắt bên phải của anh chị em khiến mình phạm tội, hãy móc nó ra và quăng xa khỏi anh chị em. Vì như thế là tốt hơn cho anh chị em khi một phần trong các chi thể của anh chị em bị hư đi, mà toàn bộ thân thể mình không bị ném vào hỏa ngục. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Và nếu tay phải của anh chị em khiến mình vấp phạm, hãy chặt nó và quăng xa khỏi anh chị em. Vì như thế là tốt hơn cho anh chị em khi một phần trong các chi thể của anh chị em bị hư đi, mà toàn bộ thân thể mình không đi vào hỏa ngục. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Còn lời đã được truyền: ‘Người nào bỏ vợ mình, thì người ấy hãy trao cho nàng một chứng thư ly hôn.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Nhưng thầy nói với anh chị em rằng bất cứ ai ly dị vợ mình, mà không có cáo buộc về tội gian dâm, thì làm cho nàng chịu tội ngoại tình. Và hễ ai cưới người từng bị ly dị thì phạm tội ngoại tình.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Anh chị em lại đã nghe như vầy, lời đã được truyền cho người xưa: ‘Không được thề dối, nhưng hãy thực hiện lời thề của mình với Chúa.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Nhưng thầy bảo anh chị em đừng thề thốt gì cả, cũng đừng chỉ trời mà thề, vì đó là ngai của Thiên Chúa; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />cũng đừng chỉ đất mà thề, vì đó là bệ đỡ của chân Ngài; cũng đừng chỉ thành Giê-ru-sa-lem mà thề, vì đó là thành của Vua lớn. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Anh chị em cũng đừng chỉ đầu mình mà thề, vì anh chị em chẳng có khả năng để làm một sợi tóc trở nên trắng hay đen. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Nhưng lời của anh chị em hãy là ‘Có, là có,’ hoặc ‘Không, là không.’ Còn điều gì vượt quá việc này là từ ma quỷ.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Anh chị em đã nghe như vầy, lời đã được truyền: ‘Mắt đền mắt, và răng đền răng.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Nhưng, thầy bảo anh chị em đừng chống cự kẻ ác. Thay vào đó, bất cứ ai vả anh chị em vào má bên phải, cũng hãy đưa má còn lại cho người đó. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Đối với kẻ muốn kiện anh chị em ra tòa và lấy đi áo trong của anh chị em, hãy để kẻ ấy lấy luôn áo ngoài mình. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Và ai đó sẽ cưỡng bách anh chị em đi một dặm, thì hãy đi với người ấy hai dặm. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Hãy cho người hỏi xin anh chị em, và đừng ngoảnh mặt khỏi người muốn vay mượn từ nơi anh chị em.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Anh chị em đã nghe như vầy, lời đã được truyền: ‘Yêu người lân cận mình và ghét kẻ thù mình.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Nhưng thầy bảo anh chị em hãy yêu thương kẻ thù mình và cầu nguyện thay cho kẻ bức hại mình, <note caller="+" style="f"><char style="ft" closed="false">Các phiên bản cổ tốt nhất không có </char><char style="fqa">Hãy chúc phước cho những kẻ nguyền rủa con, hãy làm điều lành cho những ai ghen ghét con.</char></note> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />sao cho anh chị em có thể được trở nên con của Cha mình trên thiên đàng. Ấy là vì Ngài khiến mặt trời của Ngài mọc trên kẻ dữ lẫn người lành, và Ngài ban mưa trên người công chính lẫn kẻ bất chính. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Vì nếu anh chị em yêu thương những ai yêu thương mình, thì anh chị em có phần thưởng gì? Chẳng phải những kẻ thu thuế cũng làm y như vậy sao? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Và nếu anh chị em chỉ đón chào những người anh em mình, thì anh chị em làm trổi hơn điều gì? Chẳng phải các dân ngoại quốc cũng làm y như vậy sao? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Vậy, anh chị em sẽ phải toàn hảo, giống như Cha thiên thượng của anh chị em là toàn hảo.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Hãy thận trọng về việc công chính của mình sao cho đừng làm trước mặt người ta để được họ nhìn thấy, nhưng nếu không phải vậy, thì e rằng anh chị em chẳng có phần thưởng trong sự hiện diện của Cha mình trên thiên đàng. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Do đó, lúc anh chị em trao của bố thí, đừng thổi kèn trước mặt mình y như những kẻ đạo đức giả làm trong các nhà hội và ngoài đường phố, sao cho họ được khen ngợi bởi người ta. Quả thật, thầy nói với anh chị em, họ có đủ phần thưởng của mình. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Nhưng khi anh chị em trao của bố thí, đừng để cho tay trái của anh chị em biết việc tay phải mình đang làm, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />sao cho việc bố thí của anh chị em có thể ở trong chỗ kín đáo, và Cha của anh chị em, Đấng nhìn thấy trong chỗ kín đáo, sẽ ban thưởng cho anh chị em.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Và lúc anh chị em cầu nguyện, thì đừng như kẻ đạo đức giả, vì họ ưng cầu nguyện khi đã đứng trong các nhà hội và tại những góc đường, sao cho họ có thể được người ta nhìn thấy. Quả thật, thầy nói với anh chị em, họ có đủ phần thưởng của mình. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Còn anh chị em, khi anh chị em cầu nguyện, hãy vào trong phòng riêng của anh chị em, và khi đã đóng cửa phòng mình lại, hãy cầu nguyện với Cha mình trong chỗ kín đáo ấy, và Cha của anh chị em, Đấng nhìn thấy trong chỗ kín đáo, sẽ ban thưởng cho anh chị em. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Và đang khi cầu nguyện, anh chị em đừng lặp đi lặp lại cách vô ích y như các dân ngoại quốc, vì họ tưởng rằng nhờ sự nhiều lời của mình, họ sẽ được lắng nghe. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Do đó, anh chị em chẳng nên giống như họ, vì Cha của anh chị em biết anh chị em có nhu cầu gì trước khi anh chị em cầu xin Ngài. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Vậy, anh chị em hãy cầu nguyện thế này:</para>
  <para style="q1" vid="MAT 6:9">‘Lạy Cha chúng con trên thiên đàng,</para>
  <para style="q2" vid="MAT 6:9">Xin Danh Ngài được tôn thánh.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Xin vương quốc Ngài hãy đến,</para>
  <para style="q2" vid="MAT 6:10">xin ý muốn Ngài được xảy ra</para>
  <para style="q2" vid="MAT 6:10">dưới đất cũng như trên trời.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Xin ban cho chúng con hôm nay thức ăn hằng ngày của chúng con;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />và xin tha thứ chúng con về những nợ tội của chúng con,</para>
  <para style="q2" vid="MAT 6:12">như chúng con cũng đã tha thứ những kẻ nợ tội với chúng con;<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />và xin đừng đem chúng con vào cám dỗ,</para>
  <para style="q2" vid="MAT 6:13">nhưng giải cứu chúng con khỏi kẻ ác.’<note caller="+" style="f"><char style="ft" closed="false">Các thủ bản cổ nhất không có câu</char><char style="fqa">Vì vương quốc, năng quyền và vinh quang đều thuộc về Cha đời đời. A-men.</char></note><verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Vì nếu anh chị em tha thứ cho người ta những vi phạm của họ, thì Cha thiên thượng của anh chị em cũng sẽ tha thứ cho anh chị em. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Còn nếu anh chị em không tha thứ cho người ta, thì Cha của anh chị em cũng sẽ không tha thứ những vi phạm của anh chị em.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Ngoài ra, khi anh chị em kiêng ăn, đừng ra vẻ như những kẻ buồn rầu đạo đức giả, vì họ nhăn nhó mặt mày của mình để họ có thể tỏ cho người ta thấy là đang kiêng ăn. Quả thật, thầy nói với anh chị em, họ có đủ phần thưởng của mình. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Còn anh chị em, khi kiêng ăn, hãy xức dầu trên đầu mình và rửa mặt mình, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />sao cho anh chị em chẳng có thể tỏ cho người ta thấy là đang kiêng ăn, nhưng là cho Cha mình trong chỗ kín đáo; và Cha của anh chị em, Đấng nhìn thấy trong chỗ kín đáo, sẽ ban thưởng cho anh chị em.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Đừng tích lũy cho bản thân của báu dưới đất, là nơi mà mối mọt cùng rỉ sét hủy hoại, cũng là nơi mà kẻ trộm lẻn vào và đánh cắp. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Nhưng hãy tích lũy cho mình của báu trên trời, là nơi không có mối mọt hay rỉ sét hủy hoại, và là nơi mà kẻ trộm không lẻn vào hay đánh cắp. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Vì của báu của anh chị em ở đâu, thì lòng của anh chị em cũng sẽ ở đó. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Con mắt là đèn của thân thể. Do đó, nếu mắt anh chị em là tốt, thì cả thân thể anh chị em sẽ được tràn ngập ánh sáng. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Nhưng nếu mắt anh chị em là xấu, thì cả thân thể anh chị em sẽ bị đầy tràn bóng tối. Vậy, nếu ánh sáng trong anh chị em là bóng tối, thì bóng tối ấy thật lớn biết bao! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Không ai có thể phục vụ hai chủ, vì người đó hoặc sẽ ghét chủ này mà yêu chủ kia, hoặc sẽ tận tụy với chủ này mà xem thường chủ kia. Anh chị em không thể phục vụ Thiên Chúa lẫn tiền tài được. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Vì cớ điều này, thầy nói với anh chị em, đừng lo lắng cho sự sống của anh chị em, về thứ gì mình ăn hay thứ gì mình uống, hoặc cho thân thể của anh chị em, về thứ gì mình mặc. Chẳng phải sự sống thì giá trị hơn đồ ăn, và thân thể giá trị hơn đồ mặc hay sao? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Hãy quan sát nơi các loài chim trời, rằng chúng chẳng gieo, cũng không gặt hay thâu trữ vào kho vựa, mà Cha thiên thượng của anh chị em nuôi chúng. Anh chị em chẳng có giá trị vượt trội hơn chúng hay sao? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Mặt khác, người nào giữa vòng anh chị em khi lo âu thì có thể thêm một khắc vào tuổi đời của mình? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Và sao anh chị em lo âu về quần áo? Hãy xem xét thực tế về loài hoa huệ ngoài đồng, cách nào mà chúng mọc lên. Chúng chẳng lao nhọc, cũng không xe chỉ. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Nhưng thầy nói với anh chị em rằng ngay cả vua Sa-lô-môn, trong tất cả sự sang trọng của ông, cũng không mặc trang phục cho mình giống như một trong số các hoa đó. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Còn nếu Thiên Chúa mặc như thế cho cỏ ngoài đồng, là thứ nay còn, và mai bị quăng vào lò, thì những kẻ kém đức tin kia, liệu Ngài chẳng làm được nhiều hơn hay sao? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Do đó, anh chị em chẳng nên lo lắng mà nói: ‘Chúng ta ăn gì?’ hoặc là ‘Chúng ta uống gì?’ hay là ‘Chúng ta mặc gì?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Vì các dân ngoại quốc tìm kiếm hết thảy những thứ này; và vì Cha thiên thượng của anh chị em biết rằng anh chị em cần toàn bộ những điều ấy. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Nhưng trước hết hãy tìm kiếm vương quốc và sự công chính của Ngài thì hết thảy những điều đó sẽ được thêm vào cho anh chị em. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Do đó, anh chị em chẳng nên lo âu về ngày mai, vì ngày mai sẽ lo cho bản thân nó. Có đủ cho một ngày chuyện khó nhọc của chính nó.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Đừng xét đoán, để anh chị em không bị xét đoán. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Vì trong sự kết án mà anh chị em xét đoán, anh chị em sẽ chịu xét đoán, và bởi mực thước mà anh chị em đo lường, mực thước ấy sẽ được đo lường đối với anh chị em. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Mà sao anh nhìn ra mảnh dằm trong mắt người anh em mình, nhưng anh không phát hiện khúc gỗ trong mắt mình? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Hay bằng cách nào mà anh sẽ bảo người anh em mình: ‘Hãy để tôi lấy mảnh dằm ra khỏi mắt bạn,’ mà xem kìa, khúc gỗ đang ở trong mắt của anh? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Kẻ đạo đức giả kia! Trước tiên, hãy lấy khúc gỗ ra khỏi mắt mình, thì sau đó, anh sẽ thấy rõ để lấy mảnh dằm ra khỏi mắt người anh em mình. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Anh chị em đừng cho lũ chó đồ thánh, cũng đừng quăng ngọc trai của mình trước mặt bầy heo. Kẻo e chúng sẽ giẫm đạp những thứ đó dưới chân chúng, và sau khi quay lại thì chúng cắn xé anh chị em thành từng mảnh.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Hãy xin, và điều đó sẽ được ban cho anh chị em. Hãy tìm, và anh chị em sẽ gặp. Hãy gõ, và cửa sẽ được mở cho anh chị em. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Vì bất kỳ ai xin thì được; ai tìm thì gặp; và, cửa sẽ được mở cho ai gõ. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Hay có ai trong vòng anh chị em, là người mà con mình xin bánh — chẳng lẽ người đó sẽ cho đứa con cục đá? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Hoặc đứa con cũng xin cá — chẳng lẽ người đó sẽ cho nó rắn? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Vậy, nếu anh chị em, là xấu, biết cho con cái mình những tặng phẩm tốt đẹp, thì Cha của anh chị em trên thiên đàng sẽ ban cho những ai xin Ngài nhiều điều tốt đẹp hơn biết dường nào? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Do đó, trong mọi việc, nếu anh chị em muốn bất cứ điều gì để người ta làm cho mình, thì anh chị em cũng hãy làm như thế cho họ, vì đó là luật pháp và các lời tiên tri.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Hãy đi vào qua cổng hẹp. Vì cổng rộng và đường thênh thang dẫn đến sự hủy diệt, và có nhiều người đi vào qua nó. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ấy là do cửa hẹp và đường được làm cho hẹp dẫn đến sự sống, mà có ít người tìm thấy nó.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Hãy coi chừng về các tiên tri giả, là những kẻ đội lốt chiên đến với anh chị em, nhưng bên trong, họ là loài sói háu ăn. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Anh chị em sẽ nhận biết họ từ nơi trái của họ. Người ta chẳng lẽ có hái nho từ bụi gai, hay trái vả từ cỏ dại? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Tương tự, mọi cây tốt thì sinh trái tốt, còn cây xấu thì sinh trái xấu. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Cây tốt không thể sinh trái xấu, cây xấu cũng không thể sinh trái tốt. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Mọi cây không sinh trái tốt thì bị đốn và quăng vào lửa. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Thế nên, ít ra thì anh chị em sẽ nhận ra họ từ nơi trái của họ. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Không phải mọi kẻ nói với thầy: ‘Lạy Chúa, lạy Chúa’, sẽ vào trong vương quốc thiên đàng, nhưng là người thực hiện ý muốn của Cha thầy trên thiên đàng. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Trong ngày đó, nhiều người sẽ thưa cùng thầy: ‘Lạy Chúa, lạy Chúa, chẳng phải chúng con đã nhân danh Ngài nói tiên tri, đã nhân danh Ngài đuổi quỷ và đã nhân danh Ngài làm nhiều việc quyền năng sao?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Và lúc đó, thầy sẽ tuyên bố rõ với họ rằng: ‘Ta chẳng hề biết các người bao giờ! Bọn làm ác kia, hãy biến đi khỏi Ta!’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Do đó, mỗi người, tức là bất cứ ai lắng nghe những lời này của thầy và thực hiện chúng thì sẽ được ví như một người khôn ngoan, là người xây nhà mình trên vầng đá. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Mưa sa xuống, nước lũ về, gió thổi và tác động mạnh vào nhà ấy, mà nó không sập vì nó đã được xây trên vầng đá. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Và mọi kẻ lắng nghe những lời này của thầy mà không thực hiện chúng thì sẽ được ví như một người ngu dại, là kẻ xây nhà mình trên cát. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Mưa sa xuống, nước lũ về, gió thổi và đập vào nhà ấy, thì nó sập xuống và sự đổ nát của nó là rất lớn.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Việc xảy ra đó là lúc Chúa Giê-xu giảng xong những lời này, đoàn dân bị kinh ngạc bởi sự dạy dỗ của Ngài, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />vì Ngài dạy dỗ họ như có thẩm quyền, mà không giống những thầy dạy luật của họ.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Bấy giờ, sau khi Ngài từ trên núi đi xuống, những đoàn dân đông đi theo Ngài. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Nhìn kìa, một người bị bệnh phong cùi sau khi tiến đến, đã quỳ trước Ngài, thưa: “Lạy Chúa, nếu Ngài sẵn lòng, Ngài có quyền để khiến tôi được sạch.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Rồi khi đã đưa tay ra, Ngài chạm vào anh, bảo: “Tôi sẵn lòng. Hãy sạch đi.” Lập tức, anh ta được tẩy sạch phong cùi của mình. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Chúa Giê-xu nói với anh: “Hãy cẩn thận, anh đừng nên nói với ai, nhưng hãy đi, trình diện bản thân với thầy tế lễ và dâng của lễ mà Môi-se đã truyền dạy, như một lời chứng cho họ.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Bấy giờ, sau khi Ngài đi vào trong thành Ca-bê-na-um, một viên đội trưởng đã đến cùng Ngài, cầu xin Ngài <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />rằng: “Lạy Chúa, đầy tớ của tôi nằm liệt ở nhà, chịu đau đớn khủng khiếp lắm.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Ngài nói với ông: “Khi đến rồi, tôi sẽ chữa lành cho cậu ấy.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Khi đáp lại, viên đội trưởng thưa: “Lạy Chúa, tôi thì chẳng xứng đáng để Ngài có thể đi vào dưới mái nhà mình, tuy nhiên xin Ngài chỉ phán một lời, thì đầy tớ của tôi sẽ được chữa lành. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Vì tôi cũng là một người được đặt dưới thẩm quyền, có các binh lính ở dưới mình. Tôi nói với người này: ‘Đi đi,’ thì anh ta đi, với người khác: ‘Hãy đến,’ thì anh ta đến, và với đầy tớ mình: ‘Hãy làm điều này,’ thì nó làm.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Nhưng sau khi nghe thế, Chúa Giê-xu ngạc nhiên và nói với những người đang đi theo Ngài: “Quả thật, thầy nói với anh chị em, thầy không thấy đức tin lớn như vậy từ một người nào trong Y-sơ-ra-ên. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Trái lại, thầy bảo anh chị em rằng nhiều người sẽ đến từ phương đông và phương tây, rồi họ sẽ được ngồi ăn cùng với Áp-ra-ham, Y-sác và Gia-cốp trong vương quốc thiên đàng. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Nhưng các con của vương quốc sẽ bị quăng vào chốn tối tăm bên ngoài, là nơi sẽ có sự than khóc và nghiến răng.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Rồi Chúa Giê-xu nói với viên đội trưởng: “Hãy đi đi! Như ông đã tin, việc ấy phải được làm thành cho ông.” Và người đầy tớ ấy đã được chữa lành trong giờ đó.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Sau khi Chúa Giê-xu vào trong nhà của Phi-e-rơ, Ngài thấy mẹ vợ của ông nằm trên giường và đang bị sốt. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ngài chạm vào tay của bà, và cơn sốt rời khỏi bà, rồi bà ngồi dậy và bắt đầu phục vụ Ngài. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Bấy giờ, lúc đã đến chiều tối, người ta đem tới cho Ngài nhiều người bị quỷ ám, Ngài trục xuất các linh ấy bằng một lời phán và chữa lành cho hết thảy những ai mắc bệnh, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />sao cho việc ấy được ứng nghiệm lời đã được nói bởi tiên tri Ê-sai, rằng: “Chính Ngài đã mang lấy những nỗi đau yếu của chúng ta và đã gánh chịu các tật bệnh của chúng ta.”<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Bấy giờ, lúc nhìn thấy đoàn dân chung quanh mình, Chúa Giê-xu truyền lệnh lên đường qua bờ bên kia. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Rồi một thầy dạy luật, sau khi đến gần, đã nói với Ngài: “Thưa thầy, tôi sẽ theo thầy dù thầy đi đâu.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Chúa Giê-xu nói cùng ông: “Cáo có hang, và chim trời có tổ, nhưng Con Người không có chỗ mà Ngài có thể gối đầu.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Thế rồi, một người khác trong các môn đồ thưa với Ngài: “Lạy Chúa, xin cho phép tôi trước hết là rời đi và chôn cha tôi.” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Nhưng Chúa Giê-xu nói với anh: “Hãy theo thầy, và hãy để người chết chôn người chết của họ.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Khi Ngài đã vào trong thuyền, các môn đồ của Ngài đi theo Ngài. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Nhìn kìa, một cơn bão rất lớn xảy ra trên biển, đến nỗi thuyền bị sóng phủ lấp. Nhưng Ngài đang ngủ. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Rồi khi lại gần, họ đánh thức Ngài, thưa: “Lạy Chúa, xin Ngài cứu giúp; chúng ta sắp chết rồi!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Và Ngài nói với họ: “Mấy người ít đức tin kia, sao anh em sợ hãi?” Sau đó, khi đã ngồi dậy, Ngài quở gió và biển, thì sự tĩnh lặng vô cùng xảy ra. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Còn những người ấy kinh ngạc, bảo: “Người này là thế nào, vì thậm chí gió và biển đều vâng lời người?”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Rồi lúc Ngài đã đi qua bờ bên kia, tới vùng Ga-đa-ra, hai người bị quỷ ám đã đến gặp Ngài, sau khi đi ra từ chốn mộ địa, họ cực kỳ dữ tợn đến nỗi không ai đủ sức để băng qua con đường đó. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Nhìn kìa, họ gào lên, rằng: “Lạy Con Thiên Chúa, chúng tôi với Ngài có việc chi? Ngài đến đây để làm khổ chúng tôi trước kỳ định chăng?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Lúc ấy, có một bầy heo đông đảo đang ăn cách họ một khoảng. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Thế rồi, bọn quỷ nài xin Ngài, rằng: “Nếu Ngài trục xuất chúng tôi, xin cho chúng tôi nhập vào bầy heo đó.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Ngài bảo chúng: “Đi ra!” Thế là sau khi ra khỏi, bọn chúng nhập vào bầy heo; và hãy xem kìa, cả bầy bổ nhào xuống con dốc đứng dẫn ra biển, rồi chúng chết dưới nước. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Lúc ấy, những kẻ chăn heo bỏ chạy, và sau khi về đến thành, họ thuật lại mọi chuyện, kể cả những chuyện liên quan đến mấy người bị quỷ ám. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Và hãy xem kìa, cả thành kéo ra để gặp Chúa Giê-xu. Khi đã thấy Ngài, họ nài xin sao cho Ngài rời đi chỗ khác khỏi địa phận của họ.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Lúc đã vào trong thuyền, Ngài vượt biển và về đến thành của mình. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Nhìn kìa, người ta đem đến cho Ngài một người bị bại liệt đang nằm trên chiếu. Khi Chúa Giê-xu thấy đức tin của họ, Ngài bảo người bị bại liệt: “Này con, hãy mạnh dạn lên. Các tội lỗi con được tha thứ.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Và xem kìa, một số trong các thầy dạy luật nói với nhau: “Tên này phạm thượng.” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Bởi đã biết những suy nghĩ của họ, Chúa Giê-xu nói: “Các ông ngẫm nghĩ xấu xa trong lòng mình để làm chi? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Vì điều nào là dễ hơn để nói: ‘Các tội lỗi con được tha thứ’ hay nói: ‘Hãy đứng dậy và bước đi’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Nhưng để các ông có thể biết rằng Con Người có thẩm quyền ở trên đất để tha tội …” thì vào lúc đó, Ngài bảo người bị bại liệt: “Hãy đứng dậy, gom chiếu lên, và đi về nhà mình.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Và sau khi đứng dậy, người đó đi về nhà mình. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Thế là, khi thấy vậy, đoàn dân kinh hãi và tôn vinh Thiên Chúa vì đã ban cho loài người thẩm quyền như vậy. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Khi đã từ nơi đó rời đi, Chúa Giê-xu nhìn thấy một người tên Ma-thi-ơ đang ngồi tại chốt thu thuế, rồi Ngài bảo ông: “Hãy theo thầy.” Và sau khi bật dậy, ông đi theo Ngài.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Việc xảy ra khi Ngài ngồi ăn trong nhà, thì nhìn kìa, nhiều nhân viên thu thuế và kẻ có tội đi tới, đã ngồi vào bàn ăn cùng Chúa Giê-xu và các môn đồ Ngài. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Khi nhận thấy vậy, những người Pha-ri-si nói với các môn đồ Ngài: “Vì cớ gì mà thầy của các anh ăn chung với bọn thu thuế và kẻ có tội?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Nhưng sau khi nghe thấy, Ngài nói: “Người mạnh khỏe không có nhu cầu về thầy thuốc, mà là người mắc bệnh. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Còn sau khi đi khỏi, hãy học hiểu câu này là sao: ‘Ta muốn lòng thương xót, không phải sinh tế.’ Vì chẳng phải tôi đến để gọi người công chính, nhưng là kẻ có tội.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Lúc đó, các môn đồ của Giăng tiếp cận Ngài, thưa: “Vì cớ gì mà chúng tôi và những người Pha-ri-si thường kiêng ăn, còn các môn đồ của thầy thì không kiêng ăn?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Chúa Giê-xu nói với họ: “Chẳng lẽ những bạn bè tham dự lễ cưới có thể sầu thảm trong thời gian bao lâu mà chàng rễ ở cùng với họ? Nhưng sẽ đến ngày khi mà chàng rể bị đem đi khỏi họ, thì lúc đó họ sẽ kiêng ăn. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Ngoài ra, không ai vá một miếng vải mới chưa bị co rút vào cái áo cũ, vì miếng vá chằng rách khỏi cái áo ấy, và một vết rách tệ hơn xuất hiện. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Cũng không ai đổ rượu mới vào bầu da cũ. Nhưng nếu chẳng phải vậy, thì e rằng bầu da bị nứt vỡ, rượu bị đổ ra và bầu bị hư. Thay vào đó, người ta đổ rượu mới vào bầu da mới, và cả hai được bảo toàn.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Trong khi Ngài đang nói những lời ấy với họ, thì xem kìa, một người lãnh đạo nhà hội sau khi lại gần, đã quỳ xuống trước Ngài, thưa rằng: “Con gái tôi vừa mới chết, thế nhưng lúc đến đó, xin hãy đặt tay thầy trên con bé, thì con bé sẽ sống.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Sau khi đứng dậy, Chúa Giê-xu và các môn đồ Ngài đi theo ông ấy. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Và nhìn kìa, một phụ nữ chịu đựng căn bệnh rong huyết suốt mười hai năm, khi tiến đến phía sau Ngài rồi, thì đã chạm vào vạt áo của Ngài, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />vì chị tự nhủ: “Nếu mình chỉ chạm vào áo Ngài thôi, thì mình sẽ được lành bệnh.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Nhưng sau khi quay lại và thấy chị, Chúa Giê-xu nói: “Con gái ơi, hãy mạnh dạn; đức tin con đã chữa lành con.” Và người phụ nữ ấy được lành bệnh từ giờ đó. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Rồi Chúa Giê-xu, sau khi đi tới nhà người lãnh đạo nhà hội ấy và thấy mấy kẻ thổi sáo cùng đám đông nhốn nháo, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />đã truyền: “Hãy lui ra, vì bé gái đã không chết, nhưng là đang ngủ.” Rồi họ cười nhạo Ngài. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Thế là, lúc đám đông bị đuổi ra ngoài rồi, thì sau khi vào trong, Ngài nắm tay đứa nhỏ, và bé gái ấy tự ngồi dậy. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Tin tức này loan ra trong khắp vùng đó.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Đang khi Chúa Giê-xu từ nơi đó rời đi, thì hai người mù đã đi theo Ngài, la lớn và thưa: “Lạy Con vua Đa-vít, xin thương xót chúng tôi!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Lúc ấy, khi vào trong nhà rồi, hai người mù đến gần Ngài và Chúa Giê-xu nói với họ: “Có phải các anh tin rằng tôi có thể thực hiện việc ấy?” Họ nói với Ngài: “Phải, thưa Chúa.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Kế đến, Ngài chạm vào mắt họ, bảo: “Việc ấy phải được xảy ra cho các anh theo như đức tin của các anh.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Mắt họ được mở ra, và Chúa Giê-xu cảnh báo họ, rằng: “Hãy cẩn thận, các anh đừng cho ai biết.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Nhưng sau khi ra ngoài, họ tường thuật việc ấy trong khắp vùng đó.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Bấy giờ, đang khi họ đi ra, thì xem kìa, người ta đem đến cho Ngài một người câm bị quỷ ám. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Lúc quỷ bị trục xuất rồi, thì người câm nói được, và đoàn dân kinh ngạc, nói: “Một việc như thế chưa bao giờ được tỏ bày trong Y-sơ-ra-ên!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Nhưng những người Pha-ri-si vốn bảo: “Ông ta đuổi quỷ nhờ vào chúa quỷ.”<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Chúa Giê-xu đi qua lại hết thảy các thành và làng mạc, dạy dỗ trong các nhà hội của dân chúng, rao giảng Phúc Âm của vương quốc, và chữa lành từng tật bệnh cùng mọi đau yếu. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Bấy giờ, khi nhìn thấy những đoàn dân đông, Ngài cảm thương thay cho họ, bởi họ đang bị quấy phá và chịu cảnh tan tác, như thể chiên không có người chăn. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Sau đó, Ngài nói với các môn đồ mình: “Tuy mùa gặt thì trúng, nhưng thợ gặt thì ít. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Do đó, hãy khẩn xin Chủ của mùa gặt, sao cho Ngài sai phái các thợ gặt vào trong mùa gặt của mình.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Sau khi gọi mười hai môn đồ của mình đến, Ngài đã ban cho họ thẩm quyền trên các uế linh, để trục xuất chúng và chữa lành từng tật bệnh cùng mọi đau yếu. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Tên của mười hai sứ đồ là như vầy: Đầu tiên, Si-môn (được gọi là Phi-e-rơ) và Anh-rê, em trai ông; Gia-cơ con của Xê-bê-đê và Giăng, em trai ông; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-líp và Ba-thê-lê-my; Thô-ma và Ma-thi-ơ, nhân viên thu thuế; Gia-cơ con của A-phê, và Tha-đê; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môn Xê-lốt, và Giu-đa Ích-ca-ri-ốt, cũng là kẻ đã phản Ngài.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Chúa Giê-xu đã sai mười hai người này đi, sau khi truyền dặn họ, rằng: “Đừng đi trên con đường của các dân ngoại quốc, cũng đừng vào trong thành của người Sa-ma-ri. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Nhưng hãy đến với những con chiên lạc mất của nhà Y-sơ-ra-ên thì hơn. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Bấy giờ, lúc đi đường, anh em hãy rao giảng, nói rằng: ‘Vương quốc thiên đàng đã đến gần.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Hãy chữa lành người đau yếu, khiến người chết sống lại, làm sạch người phong cùi và trục xuất các quỷ. Anh em đã lãnh không, thì hãy cho không. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Đừng cất trữ vàng, hoặc bạc, hay tiền đồng trong ví lưng của anh em, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />không bao bị cho chuyến đi, hay hai áo, hoặc giày, hoặc gậy, vì người làm công đáng được phần ăn mình. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Còn trong thành hoặc làng nào mà anh em đi vào, hãy tìm hiểu một ai đó trong nơi này là người xứng đáng, hãy ở tại đó cho đến khi nào anh em ra đi. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Bấy giờ, khi vào trong nhà đó, hãy chúc bình an cho nơi ấy. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Một mặt, nếu nhà đó là nơi xứng đáng, thì sự bình an của anh em phải đến trên nó, mặt khác, nếu nó không phải là nơi xứng đáng, thì sự bình an của anh em phải được trở về với anh em. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Và kẻ nào không tiếp đón anh em, cũng không lắng nghe các lời của anh em, thì khi đi ra khỏi nhà hoặc thành đó, hãy phủi bụi dưới chân anh em. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Quả thật, thầy nói với anh em, sẽ là dễ chịu cho đất Sô-đôm và Gô-mô-rơ trong ngày phán xét hơn là cho thành đó.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Nhìn này, thầy sai anh em đi như chiên ở giữa bầy sói, cho nên hãy trở nên khôn ngoan như rắn và chất phác như chim bồ câu. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Nhưng hãy thận trọng về người ta, vì họ sẽ giao nộp anh em cho hội đồng xét xử, và người ta sẽ đánh anh em bằng roi trong nhà hội của họ; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />rồi anh em thậm chí sẽ bị giải đến trước các tổng đốc và các vua vì cớ thầy, để như một lời chứng cho họ và cho các dân ngoại quốc. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Nhưng lúc họ giao nộp anh em, đừng lo lắng về cách nào hoặc điều gì mình cần nói, vì điều mà anh em cần nói sẽ được ban cho anh em trong giờ đó. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Vì chẳng phải anh em là người nói, nhưng là Thánh Linh của Cha anh em nói trong anh em. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Ngoài ra, anh sẽ nộp em vào chỗ chết, và cha thì nộp con, và con cái sẽ dấy lên nghịch với cha mẹ và sẽ khiến họ phải chết. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Và anh em sẽ bị mọi người thù ghét vì danh thầy, nhưng người nào chịu nổi đến cuối cùng, người ấy sẽ được cứu. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Nhưng khi nào người ta bức hại anh em trong thành này, thì hãy chạy sang thành khác, vì quả thật, thầy nói với anh em, chắc chắn anh em chẳng thể nào đi hết các thành của Y-sơ-ra-ên cho tới tận lúc Con Người đến.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Môn đồ thì không hơn thầy, nô lệ cũng không hơn chủ mình. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Đối với môn đồ, sao cho người ấy có thể được như thầy mình, và đầy tớ thì như chủ mình, là đủ rồi. Nếu người ta đã gọi chủ nhà là Bê-ên-xê-bun, thì người nhà của chủ còn tệ hơn đến mức nào! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Vậy, đừng sợ họ, vì chẳng có điều gì bị che đậy mà sẽ không được tỏ ra, bị giấu giếm mà sẽ không được nhận biết. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Điều thầy truyền bảo anh em ở nơi tối, hãy nói ra ở nơi sáng, và điều anh em nghe nơi tai, hãy công bố trên nóc nhà. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Đừng hãi hùng trước những kẻ giết chết thân thể mà không thể giết chết linh hồn. Nhưng hãy khiếp sợ Đấng có thể hủy diệt cả linh hồn lẫn thân thể trong hỏa ngục thì hơn. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Chẳng phải hai con chim sẻ được bán với giá một xu hay sao? Và không một con nào trong số chúng sẽ rơi xuống đất ngoài ý muốn của Cha anh em. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Mà ngay cả tóc trên đầu anh em, hết thảy là đã được đếm rồi. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Do đó, đừng sợ; anh em cao trọng hơn nhiều con chim sẻ. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Vậy, mỗi người, tức là bất cứ ai sẽ xưng nhận về thầy trước mặt người ta, thì thầy cũng sẽ xưng nhận về người đó trước mặt Cha thầy trên thiên đàng. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Nhưng bất cứ kẻ nào chối thầy trước mặt người ta, thì thầy cũng sẽ chối người đó trước mặt Cha thầy trên thiên đàng.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Đừng tưởng rằng thầy đến để đem bình an trên đất. Thầy không đến để đem bình an, mà là gươm đao. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Vì thầy đến để khiến con trai chống lại cha mình, con gái chống lại mẹ mình, con dâu chống lại mẹ chồng mình; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />và kẻ thù của một người là những ai trong gia đình của người ấy. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Ai yêu cha hoặc mẹ hơn thầy thì không xứng đáng với thầy; ai yêu con trai hoặc con gái hơn thầy thì cũng không xứng đáng với thầy. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Và kẻ nào không vác cây thập tự mình và theo sau thầy thì chẳng xứng đáng với thầy. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ai tìm sự sống mình sẽ đánh mất nó, mà ai mất sự sống mình vì cớ thầy sẽ tìm được nó.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Ai tiếp đón anh em là tiếp đón thầy, và ai tiếp đón thầy là tiếp đón Đấng đã sai phái thầy. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Ai tiếp đón một tiên tri bởi danh phận vị tiên tri sẽ nhận lãnh phần thưởng của vị tiên tri, và ai tiếp đón một người công chính bởi danh phận người công chính sẽ nhận lãnh phần thưởng của một người công chính. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Và hễ ai cho một trong những kẻ bé nhỏ này uống một cốc nước lạnh chỉ bởi danh phận môn đồ, thì quả thật, thầy nói với anh em, người đó chắc chắn không mất phần thưởng của mình.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Việc xảy ra khi Chúa Giê-xu đã truyền dạy mười hai môn đồ của mình xong, Ngài rời khỏi đó để dạy dỗ và rao giảng trong các thành của dân chúng. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Bấy giờ, Giăng, sau khi từ trong tù nghe tường thuật về những việc làm của Chúa Cứu Thế, thì thông qua các môn đồ mình đã phái đi, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />đã thưa với Ngài: “Thầy là Đấng phải đến, hay chúng tôi đang mong chờ một Đấng khác?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Để đáp lại, Chúa Giê-xu nói với họ: “Sau khi rời đi, hãy thuật lại cho Giăng những gì anh em thấy và nghe. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Người mù nhìn thấy, người què bước đi, người phong cùi được tẩy sạch, người điếc nghe hiểu, người chết được khiến sống lại và người nghèo khó được giảng cho Phúc Âm. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Và hễ ai không bị vấp phạm vì cớ thầy là người được phước.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Bấy giờ, khi những người đó lên đường rồi, Chúa Giê-xu bắt đầu nói với đoàn dân về Giăng: “Anh chị em đi ra nơi hoang mạc để xem gì — cây sậy bị rung lắc bởi gió sao? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Chẳng phải thế thì anh chị em đi ra để xem gì — một người được trang phục trong nhung lụa hay sao? Nhìn kìa, người mặc nhung lụa thì ở trong cung vua. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Trái lại, anh chị em đi ra để xem gì — một tiên tri phải không? Tôi nói với anh chị em, phải và thậm chí hơn cả một tiên tri. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Ấy là về người mà lời này đã được chép:</para>
  <para style="q1" vid="MAT 11:10">‘Nhìn kìa, Ta đang sai sứ giả của Ta đi trước mặt con, người sẽ dọn đường của con trước mặt con.’<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Quả thật, tôi nói với anh chị em, không một ai được dấy lên trong những người được phụ nữ sinh ra là cao trọng hơn Giăng Báp-tít, mà người bé nhất trong vương quốc thiên đàng thì cao trọng hơn ông. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Nhưng, từ ngày của Giăng Báp-tít cho đến nay, vương quốc thiên đàng chịu đương đầu với bạo lực, và những kẻ hung tàn vận dụng sức mạnh chiếm đoạt nó. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Vì toàn bộ các tiên tri và luật pháp đã dự ngôn cho đến Giăng; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />và nếu anh chị em sẵn lòng chấp nhận, thì ông ấy là Ê-li, người phải đến. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ai có tai để nghe, hãy nghe. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Nhưng tôi sẽ so sánh thế hệ này với điều gì? Nó thì giống như đám trẻ con ngồi nơi phố chợ, mà chúng réo gọi nhau, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />rằng: ‘Chúng tớ thổi sáo cho các cậu, mà các cậu không nhảy múa. Chúng tớ kêu than mà các cậu chẳng khóc.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Vì Giăng đến, chẳng ăn cũng chẳng uống, thì họ bảo: ‘Ông ta bị quỷ ám.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Con Người đến, ăn và uống, thì họ nói: ‘Nhìn ông ta kìa, một kẻ phàm ăn, một tên bợm rượu, bạn của bọn thu thuế và đám người tội lỗi!’ Nhưng rồi sự khôn ngoan được biện minh bởi các con cái của nàng.”<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Sau đó, Ngài bắt đầu quở trách những thành mà hầu hết các phép lạ của Ngài được thực hiện tại các nơi ấy, vì họ đã không ăn năn. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Khốn cho ngươi, Cô-ra-xin! Khốn cho ngươi, Bết-sai-đa! Vì nếu những việc quyền năng xảy ra giữa các ngươi đã được thể hiện tại Ty-rơ và Si-đôn, thì hẳn là chúng đã ăn năn trong vải xô và tro bụi từ lâu rồi. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Tuy vậy, Ta nói với các ngươi, sẽ có sự dễ chịu hơn cho Ty-rơ và Si-đôn trong ngày phán xét hơn là cho các ngươi. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Còn ngươi, Ca-bê-na-um, chẳng lẽ ngươi sẽ được nhấc cao đến tận trời? Ngươi sẽ đi xuống tới tận âm phủ. Vì nếu những việc quyền năng xảy ra nơi ngươi đã được thể hiện tại Sô-đôm, thì hẳn là thành ấy đã còn lại cho đến ngày nay. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Tuy vậy, Ta nói với các ngươi, trong ngày phán xét, mọi sự sẽ dễ chịu cho đất Sô-đôm hơn là cho các ngươi.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Vào lúc đó, Chúa Giê-xu mở lời thưa: “Lạy Cha, là Chúa của trời và đất, con ngợi khen Cha, vì Cha đã che giấu những điều này khỏi người khôn ngoan và kẻ hiểu biết, mà bày tỏ chúng cho trẻ nhỏ. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Vâng, thưa Cha, vì như vậy là điều vừa ý trước mặt Cha. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Mọi việc đã được Cha tôi ủy thác cho tôi; không ai biết Con ngoại trừ Cha, cũng không ai biết Cha ngoại trừ Con và những ai mà nếu Con muốn bày tỏ cho. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Hãy đến với tôi, hỡi tất cả những ai lao nhọc và chịu gánh nặng, và tôi sẽ cho anh chị em sự nghỉ ngơi. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Hãy mang lấy ách của tôi trên anh chị em và học từ nơi tôi, vì tôi có lòng nhu mì và khiêm nhường, rồi anh chị em sẽ tìm được sự nghỉ ngơi cho linh hồn mình. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Vì ách của tôi dễ chịu và gánh của tôi là nhẹ nhàng.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Trong khoảng thời gian đó, Chúa Giê-xu đi qua những cánh đồng lúa vào ngày Sa-bát, mà các môn đồ của Ngài đói nên họ bắt đầu bứt các bông lúa và ăn. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Nhưng sau khi thấy điều đó, những người Pha-ri-si nói với Ngài: “Nhìn kìa, các môn đồ của thầy làm chuyện không được phép làm trong ngày Sa-bát.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Tuy nhiên, Ngài nói với họ: “Các ông đã không đọc thấy chuyện Đa-vít đã làm trong khi vua và những người đi cùng mình bị đói hay sao? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Thể nào vua đã vào trong nhà của Thiên Chúa và ăn bánh cung hiến, mà bánh ấy thì không cho phép vua và những người đi cùng vua để ăn, ngoại trừ chỉ dành cho thầy tế lễ? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Hay các ông đã chẳng đọc thấy trong luật pháp rằng vào ngày Sa-bát, các thầy tế lễ trong đền thờ vi phạm ngày Sa-bát mà họ thì vô tội sao? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Nhưng tôi nói với các ông rằng một Đấng lớn hơn đền thờ đang ở đây. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Nhưng nếu các ông vốn đã nhận biết ý nghĩa câu này là gì: ‘Ta muốn lòng thương xót chứ không phải sinh tế,’ thì hẳn là các ông đã không lên án những người vô tội. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Vì Con Người là Chúa của ngày Sa-bát.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Và khi đã rời đi khỏi đó, Ngài vào trong nhà hội của họ. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Xem kìa, một người có tay bị teo, và họ chất vấn Chúa Giê-xu, rằng: “Phải chăng được phép chữa bệnh trong ngày Sa-bát?” hầu cho họ có thể buộc tội Ngài. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Nhưng Ngài nói với họ: “Có người nào trong các ông, mà người ấy có một con chiên, và nếu nó rớt xuống hố vào ngày Sa-bát, thì người ấy sẽ không nắm chặt lấy nó và kéo lên chăng? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Và rồi con người thì quý trọng hơn con chiên biết chừng nào! Thế nên, có phép làm việc lành vào ngày Sa-bát.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Sau đó, Ngài nói với người ấy: “Hãy duỗi tay của anh ra.” Người ấy duỗi tay ra và nó được phục hồi khỏe mạnh, y như bàn tay kia. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Nhưng sau khi đi ra, những người Pha-ri-si lập mưu chống Ngài sao cho họ có thể giết Ngài.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Nhưng vì đã biết như vậy, Chúa Giê-xu rút lui khỏi nơi đó. Nhiều người đã đi theo Ngài, rồi Ngài chữa lành cho tất cả họ, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />và Ngài cảnh cáo họ để họ đừng làm cho Ngài lộ diện, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />hầu cho lời đã được phán qua tiên tri Ê-sai được ứng nghiệm, rằng:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Nhìn này, đầy tớ Ta, Người mà Ta đã chọn;</para>
  <para style="q1" vid="MAT 12:18">Người yêu dấu của Ta, mà nơi Người, linh hồn Ta hoàn toàn hài lòng.</para>
  <para style="q1" vid="MAT 12:18">Ta sẽ đặt Thần Ta trên Người,</para>
  <para style="q1" vid="MAT 12:18">và Người sẽ công bố sự công chính cho các dân ngoại quốc.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Người sẽ không tranh cãi hay la lối;</para>
  <para style="q1" vid="MAT 12:19">cũng chẳng ai sẽ nghe tiếng Người trên đường phố.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Người sẽ chẳng bẻ cây sậy đã bị giập;</para>
  <para style="q1" vid="MAT 12:20">Người sẽ chẳng dập tim đèn cháy âm ỉ,</para>
  <para style="q1" vid="MAT 12:20">cho đến khi nào Người đưa sự công chính đến khải hoàn,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />và các dân ngoại quốc sẽ hy vọng nơi danh Người.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Sau đó, một người mù và câm bị quỷ ám được đem đến cho Ngài, rồi Ngài chữa lành cho người đó, đến nỗi người câm này nói được và nhìn thấy. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Cả đoàn dân đều kinh ngạc và nói: “Chẳng lẽ người này là Con của Đa-vít?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Còn những người Pha-ri-si, sau khi nghe chuyện này, đã nói: “Ông ta không trục xuất được quỷ nếu chẳng phải là bởi Bê-ên-xê-bun, tức là chúa quỷ.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Nhưng vốn đã biết ý nghĩ của họ, Ngài nói với họ: “Mọi vương quốc bị chia rẽ chống lại chính mình thì bị tan hoang, và mọi thành hay nhà bị chia rẽ nghịch với chính nó thì sẽ chẳng đứng vững. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Nếu Sa-tan trục xuất Sa-tan, thì nó bị chia rẽ chống lại chính nó. Thế thì, làm thế nào vương quốc nó sẽ đứng vững? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Và nếu tôi bởi Bê-ên-xê-bun trục xuất các quỷ, thì con các ông bởi ai trục xuất chúng? Vì lý do này, chúng sẽ là những người xét đoán các ông. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Nhưng nếu tôi trục xuất các quỷ bởi Thánh Linh của Thiên Chúa, thế thì vương quốc Thiên Chúa đã đến trên các ông. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Hay làm sao mà kẻ nào đó có thể vào trong nhà của người mạnh sức và trộm đồ của người nếu trước hết kẻ đó chẳng trói người mạnh sức ấy lại? Rồi sau đó, kẻ này sẽ vơ vét nhà anh ta. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Ai không ở cùng với tôi là chống lại tôi, và ai không nhóm hiệp chung với tôi thì tan tác. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Vì lý do này, tôi nói với các ông, mọi tội lỗi và lời phạm thượng sẽ được tha cho người ta, nhưng lời phạm đến Thánh Linh thì sẽ không được tha. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nếu ai nói lời chống nghịch Con Người, thì người ấy sẽ được tha thứ. Nhưng kẻ nào nói nghịch với Chúa Thánh Linh, thì kẻ đó sẽ không được tha thứ, cả trong đời này hay trong đời sắp đến. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Hoặc là, chăm cây tốt thì trái nó tốt, hoặc chăm cây xấu thì trái nó xấu, vì cây được nhận biết nhờ trái của nó. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Dòng dõi rắn lục kia, vì là ác, các ông làm sao có thể nói điều tốt? Vì miệng phát ngôn từ thứ đầy dẫy trong lòng. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Người lành, xuất phát từ sự tích trữ tốt đẹp của mình, sinh ra điều lành, mà người ác, xuất phát từ sự tích trữ gian ác của mình, sinh ra điều ác. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Nhưng tôi nói với các ông rằng mọi lời vô bổ mà người ta nói, họ sẽ đưa ra lời khai trình về nó trong ngày phán xét. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Vì từ nơi những phát ngôn của mình, các ông sẽ được xưng công chính, và từ nơi những phát ngôn của mình, các ông sẽ bị định tội.”<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Sau đó, một số thầy dạy luật và người Pha-ri-si đã phản hồi cùng Ngài, rằng: “Thưa thầy, chúng tôi muốn thấy nơi thầy một dấu lạ.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Nhưng để đáp lại, Ngài nói với họ: “Một thế hệ tà ác và gian dâm tìm kiếm một dấu lạ, nhưng chẳng có dấu lạ nào sẽ được ban cho nó, ngoại trừ dấu lạ của tiên tri Giô-na. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Vì Giô-na đã ở trong bụng con cá lớn ba ngày và ba đêm thể nào, thì Con Người sẽ ở ba ngày và ba đêm trong lòng đất thể ấy. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Trong ngày phán xét, dân Ni-ni-ve sẽ đứng lên cùng với thế hệ này và sẽ lên án nó. Vì họ đã ăn năn trước lời rao giảng của Giô-na, mà nhìn này, Đấng cao trọng hơn Giô-na ở đây. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Trong ngày phán xét, nữ hoàng phương Nam sẽ trỗi dậy cùng với thế hệ này và sẽ lên án nó, vì từ những nơi tận cùng của đất, bà đã đến để nghe sự khôn ngoan của Sa-lô-môn, mà nhìn này, Đấng cao trọng hơn Sa-lô-môn ở đây. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Ngoài ra, khi uế linh đã rời khỏi một người, nó băng qua những nơi khô hạn, tìm chỗ nghỉ mà chẳng thấy. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Lúc đó, nó bảo: ‘Ta sẽ trở lại tại nhà ta mà ta đã ra đi từ nơi ấy.’ Sau khi đến, nó phát hiện ngôi nhà trống không, đã được quét dọn sạch sẽ và sắp xếp ngăn nắp. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Sau đó, nó đi và dẫn về chung với nó bảy linh khác còn tà ác hơn nó, và khi đã vào trong, cả bọn sống ở đó. Rồi kết cục của người ấy trở nên tồi tệ hơn ban đầu. Chuyện cũng sẽ là như vậy đối với thế hệ gian ác này.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Trong khi Ngài vẫn còn đang nói với dân chúng, xem kìa, mẹ và các em của Ngài vốn đã đứng bên ngoài, tìm cách để nói chuyện với Ngài. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Bấy giờ, một người nọ thưa cùng Ngài: “Nhìn kìa, mẹ thầy và các em của thầy đã đứng bên ngoài, tìm cách để nói chuyện với thầy.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Nhưng khi đáp lời, Ngài nói với người thưa chuyện cùng mình: “Ai là mẹ tôi và ai là các em của tôi?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Rồi sau khi đưa tay mình hướng về các môn đồ của mình, Ngài nói: “Xem kìa, mẹ tôi và các em của tôi đây! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Vì hễ người nào thực hiện ý muốn của Cha tôi trên thiên đàng, thì người đó là em trai, em gái và mẹ của tôi.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Trong ngày đó, sau khi đi ra khỏi nhà, Chúa Giê-xu ngồi bên bờ biển. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Đoàn dân rất đông đã nhóm lại chung quanh Ngài. Đến nỗi, sau khi bước lên một chiếc thuyền, Ngài ngồi xuống, mà cả đoàn dân thì đứng trên bờ. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Rồi Ngài nói với họ nhiều điều bằng ẩn dụ, rằng: “Xem này, một người gieo giống đi ra để gieo. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Lúc gieo giống, một số hạt rơi bên đường, thì chim trời đến và ăn hết chúng. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Một số khác rơi trên đất đá sỏi, là nơi không có nhiều đất thịt. Lập tức, hạt giống nảy mầm, vì lớp đất không có độ sâu. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Nhưng sau khi mặt trời mọc lên, nó đã bị thiêu đốt và héo khô vì không có rễ. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Còn một số khác rơi giữa các cây gai, thì những cây gai lớn lên và chèn ép chúng. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Mà số khác nữa rơi trên đất tốt và cho ra hoa lợi, hạt thì một trăm lần nhiều hơn, hạt thì sáu chục, hạt thì ba chục. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ai có tai, hãy nghe.”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Rồi các môn đồ, sau khi lại gần, đã thưa với Ngài: “Vì lý do gì mà thầy lại nói bằng các ẩn dụ với dân chúng?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Thế là, khi đáp lời, Ngài đã nói với họ rằng: “Đối với anh em thì đã được ban cho để nhận biết những huyền nhiệm về vương quốc thiên đàng, còn đối với những kẻ đó thì không được ban cho. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Bởi người nào có, thì về phần người ấy sẽ được cho thêm, và người ấy sẽ được dư dật. Nhưng người nào không có, thì sẽ bị lấy đi khỏi người ngay cả điều người ấy đang có. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Vì lý do này, thầy nói với họ bằng ẩn dụ; vì dù có nhìn, họ chẳng nhận thấy; và dù lắng tai, họ không nghe được, cũng không hiểu được. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Và lời tiên tri của Ê-sai thì được ứng nghiệm nơi họ, rằng:</para>
  <para style="q1" vid="MAT 13:14">‘Đối với việc nghe, các con sẽ lắng tai, mà chắc chắn các con sẽ không hiểu;</para>
  <para style="q1" vid="MAT 13:14">còn khi nhìn, các con sẽ ngó xem, mà chắc chắn các con sẽ không nhận thấy.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Vì lòng dân này đã trở nên đần độn;</para>
  <para style="q1" vid="MAT 13:15">tai họ đã nghe cách khó khăn,</para>
  <para style="q1" vid="MAT 13:15">và họ đã nhắm mắt mình,</para>
  <para style="q1" vid="MAT 13:15">kẻo e họ có thể nhìn thấy bằng mắt,</para>
  <para style="q1" vid="MAT 13:15">lắng nghe bằng tai,</para>
  <para style="q1" vid="MAT 13:15">hiểu bằng tấm lòng,</para>
  <para style="q1" vid="MAT 13:15">rồi quay trở lại,</para>
  <para style="q1" vid="MAT 13:15">và Ta sẽ chữa lành họ.’<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Nhưng phước thay là mắt của anh chị em, vì thấy được, và tai của anh chị em, vì nghe được. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Quả thật, thầy nói với anh em rằng nhiều tiên tri và người công chính khao khát để thấy những gì anh em thấy, mà họ đã không thấy được, và để nghe những gì anh em nghe, mà họ đã không nghe được. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Vậy, anh em hãy nghe ẩn dụ về người gieo giống. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Mọi người nghe đạo của vương quốc mà không hiểu, thì ma quỷ đến và cướp đi điều đã được gieo trong lòng người đó. Đây là hạt giống bị gieo bên đường. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Còn hạt giống bị gieo vào đất đá sỏi, đó là người nghe đạo và lập tức nhận lấy đạo cùng với lòng hân hoan; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />mà người đó không có rễ trong mình, nhưng là tồn tại tạm thời; thế rồi khổ nạn hoặc bức hại xảy đến vì cớ đạo, thì người đó liền bị vấp ngã. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Còn hạt giống bị gieo giữa những cây gai, đây là người nghe đạo, mà mối bận tâm về đời này và ảo tưởng của sự giàu sang làm cho đạo ấy nghẹt ngòi và nó trở nên không kết quả. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Nhưng hạt giống được gieo trên đất tốt, đó là người nghe đạo và hiểu, người đó thật kết quả và sản sinh một thành một trăm, một thành sáu mươi, một thành ba mươi.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Ngài bày ra trước họ một ẩn dụ khác, rằng: “Vương quốc thiên đàng được ví như một người đã gieo giống tốt trong ruộng mình. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Nhưng lúc người ta ngủ, kẻ thù của ông ấy đến và gieo cỏ lùng xen vào giữa lúa mì rồi đi khỏi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Khi cây lúa lớn lên và trổ bông, thì cỏ lùng cũng bị lộ diện. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Bấy giờ, các đầy tớ của người chủ ấy, sau khi đến, đã nói với ông: ‘Thưa ông chủ, chẳng phải ông đã gieo hạt giống tốt trong ruộng mình hay sao? Vậy, cỏ lùng từ đâu mà có?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Thế là ông bảo họ: ‘Một người thù địch đã làm chuyện này.’ Rồi các đầy tớ thưa với ông: ‘Vậy, ông có muốn khi ra đó, chúng tôi nhổ hết chúng không?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Nhưng chủ đáp: ‘Đừng, kẻo đang khi nhổ cỏ lùng, mấy anh có thể bứng lúa mì chung với chúng. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Hãy để cả hai được cùng lớn lên cho đến tận kỳ thu hoạch, và vào thời điểm thu hoạch, tôi sẽ bảo các thợ gặt: Trước hết, hãy gom cỏ lùng lại và buộc chúng thành bó đặng đốt chúng đi, nhưng hãy gom lúa mì vào trong kho vựa của tôi.’”<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Ngài bày ra trước họ một ẩn dụ khác, rằng: “Vương quốc thiên đàng thì tựa như một hạt cải mà sau khi lấy, một người đã gieo trong ruộng mình; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />mà hạt giống ấy tuy là nhỏ nhất trong tất cả các loại hạt, nhưng khi nó phát triển, nó lớn hơn các giống cây trong vườn và trở thành một cái cây, đến nỗi chim trời đến và làm tổ trên các nhánh của nó.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Ngài kể cho họ một ẩn dụ khác: “Vương quốc thiên đàng thì tựa như men mà sau khi lấy, người phụ nữ đã trộn với ba lường bột cho đến khi cả tảng bột dậy lên.”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Chúa Giê-xu đã nói mọi điều đó với đoàn dân bằng ẩn dụ, và Ngài chẳng nói điều gì với họ mà không bằng ẩn dụ, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />sao cho lời đã được phán qua vị tiên tri được ứng nghiệm, rằng:</para>
  <para style="q1" vid="MAT 13:35">“Ta sẽ mở miệng Ta bằng những ẩn dụ.</para>
  <para style="q1" vid="MAT 13:35">Ta sẽ công bố những điều từng được giấu kín từ lúc lập nền thế giới.”<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Sau đó, khi đã rời khỏi đoàn dân đông, Ngài đi vào nhà. Các môn đồ Ngài đến gần Ngài, thưa: “Xin giải thích cho chúng tôi ẩn dụ về cỏ lùng trong đồng ruộng.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Bấy giờ, khi trả lời, Ngài nói: “Người gieo giống tốt là Con Người, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />mà cánh đồng là thế gian, còn hạt giống tốt — đây là con cái của vương quốc. Trái lại, cỏ lùng là con cái của kẻ ác, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />mà kẻ thù, là kẻ đã gieo chúng, là ma quỷ. Còn mùa gặt là kỳ tận thế, mà các thợ gặt là các thiên sứ. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Vậy, thể nào mà cỏ lùng được gom lại và bị đốt trong lửa, thì việc cũng sẽ xảy ra như vậy vào kỳ tận thế. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Con Người sẽ sai phái các thiên sứ của mình, và họ sẽ gom ra khỏi vương quốc Ngài hết thảy những thứ gây vấp phạm cùng những kẻ làm điều vô đạo. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Và họ sẽ ném chúng vào lò lửa, là nơi sẽ có sự than khóc và nghiến răng. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Lúc đó, những người công chính sẽ chói sáng như mặt trời trong vương quốc của Cha họ. Ai có tai, hãy nghe.”<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Vương quốc thiên đàng thì tựa như một kho báu được che giấu trong một cánh đồng, là thứ mà một người đã giấu đi sau khi tìm thấy. Xuất phát từ niềm vui sướng của mình, người ấy lên đường, bán tất tần tật mọi thứ mình có và mua cánh đồng ấy. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />Thêm nữa, vương quốc thiên đàng thì tựa như một người, là thương nhân tìm kiếm ngọc châu quý giá. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Thế rồi, lúc đã tìm được một viên ngọc châu vô cùng quý giá, thì sau khi rời đi, anh đã bán tất tần tật mọi thứ mình sở hữu và mua nó.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Còn nữa, vương quốc thiên đàng thì tựa như một tấm lưới được quăng xuống biển và thâu lên đủ mọi loài, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />mà lúc lưới đã đầy, người ta kéo vào bờ, và sau khi ngồi xuống, họ gom những vật tốt vào trong giỏ đựng, còn mấy thứ vô giá trị, họ vứt ra ngoài. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Mọi sự sẽ là như vậy vào kỳ tận thế: Các thiên sứ sẽ đi ra, và sẽ phân rẽ bọn gian ác khỏi giữa những người công chính, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />rồi họ sẽ ném bọn đó vào lò lửa, là nơi sẽ có sự than khóc và nghiến răng. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Anh em đã hiểu hết những điều này chưa?” Họ thưa cùng Ngài: “Vâng.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Bấy giờ, Ngài nói với họ: “Vì lý do này, mỗi thầy dạy luật đã được chỉ dạy cho vương quốc thiên đàng thì tựa như một người chủ nhà, là người lôi ra đồ cũ và đồ mới từ trong kho tàng của mình.” <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Việc xảy ra đó là khi Chúa Giê-xu kết thúc các ẩn dụ này, Ngài đã rời đi khỏi chỗ đó.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Sau khi đi tới quê nhà mình, Ngài đã dạy dỗ dân chúng trong nhà hội của họ, đến rỗi khiến họ kinh ngạc và nói: “Sự khôn ngoan ấy cùng các phép lạ do nơi người này ra từ đâu? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Chẳng phải người này là con trai ông thợ mộc sao? Chẳng phải mẹ ông ấy được gọi là Ma-ri, và các em trai của ông ta là Gia-cơ, Giô-sép, Si-môn và Giu-đa à? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Chẳng phải tất cả các cô em gái của ông ta đang ở với chúng ta hay sao? Vậy, mọi điều này do nơi ông ấy ra từ đâu?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Họ bị vấp ngã nơi Ngài. Nhưng Chúa Giê-xu nói với họ: “Tiên tri chẳng bị coi thường, ngoại trừ tại quê nhà mình và trong gia đình mình.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Ngài đã không làm nhiều phép lạ ở đó vì lòng vô tín của họ.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Vào thời điểm đó, vua chư hầu Hê-rốt nghe tin về Chúa Giê-xu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Vua nói với các tôi tớ mình: “Ấy là Giăng Báp-tít. Ông ấy đã được khiến sống lại từ cõi chết, nên bởi đó, những việc quyền năng đang vận hành nơi người này.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Do Hê-rốt, sau khi bắt Giăng, đã cho xiềng ông và tống vào ngục, vì cớ Hê-rô-đia, vợ của Phi-líp, em trai vua. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Vì Giăng đã nói với vua: “Về phần vua, không được phép lấy bà ta.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Và dù muốn giết ông ấy đi, nhưng vua sợ dân chúng, vì họ xem Giăng như một tiên tri. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Nhưng khi đến tiệc sinh nhật của Hê-rốt, con gái của Hê-rô-đia nhảy múa ở giữa tiệc và làm hài lòng Hê-rốt, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />vì thế, vua đã hứa cùng với một lời thề để ban cho cô hễ điều gì mà cô xin. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Bấy giờ, khi đã bị xúi giục trước đó bởi mẹ mình, cô thưa: “Xin cho con ngay tại đây, cái đầu của Giăng Báp-tít ở trên mâm.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Và dù rất buồn phiền, nhưng vì cớ lời thề của mình và những quan khách cùng ngồi ăn, vua đã ra lệnh để nàng được ban cho. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Sau khi sai người đi, vua cho chém đầu Giăng trong ngục. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Đầu của ông được mang đến ở trên mâm rồi được trao cho cô gái, và cô đem cho mẹ mình. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Khi tiếp cận được rồi, các môn đồ của ông lấy xác và chôn cất nó. Và lúc đã đi tới, họ thuật lại cho Chúa Giê-xu.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Bấy giờ, khi nghe rồi, Chúa Giê-xu rút khỏi đó trong một chiếc thuyền hướng tới nơi vắng vẻ ở riêng một mình. Vì nghe biết như vậy, những đoàn dân từ các thành đi bộ theo Ngài. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Và sau khi đi ra, Ngài thấy một đoàn người đông đảo, thì động lòng thương xót với những người dân và Ngài chữa lành những người đau yếu của họ. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Bấy giờ, khi đến chiều tối, các môn đồ đến với Ngài, thưa: “Nơi này thì hoang vắng, và giờ này thì trễ rồi. Xin thầy giải tán đoàn dân để khi đi đến các làng rồi, họ có thể mua thức ăn cho mình.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Nhưng Chúa Giê-xu nói với họ: “Họ không có nhu cầu rời đi. Anh em hãy cho họ ăn.” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Lúc ấy, họ thưa với Ngài: “Ở đây chúng tôi chẳng có gì ngoài năm ổ bánh và hai con cá.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Rồi Ngài bảo: “Hãy đem chúng đến đây cho thầy.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Và khi truyền cho đoàn dân ngồi xuống trên cỏ rồi, lúc cầm năm ổ bánh và hai con cá, ngước mặt lên trời, Ngài chúc tạ, và bẻ ra, Ngài trao thức ăn cho các môn đồ, còn các môn đồ phân phát cho đoàn dân. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Hết thảy dân chúng đã ăn và được no nê. Rồi người ta nhặt phần thừa lại từ các mẩu bẻ vụn — được mười hai giỏ đầy. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Bấy giờ, số người ăn là khoảng năm ngàn đàn ông, chưa tính phụ nữ và trẻ em.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Lập tức, Ngài thúc ép các môn đồ bước vào trong thuyền và đi trước Ngài sang bờ bên kia, trong lúc Ngài giải tán đoàn dân. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Lúc đã cho dân chúng về, Ngài đi lên trên núi để tự cầu nguyện riêng. Đến tối, Ngài ở đó một mình. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Còn chiếc thuyền ở giữa biển rồi thì bị sóng dập tới tấp vì gió ngược. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Bấy giờ, vào canh tư đêm ấy, Ngài đến cùng họ, khi đi bộ trên biển. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Nhưng sau khi thấy Ngài bước đi trên biển, các môn đồ bị hoảng hốt, nói rằng: “Đó là ma,” rồi họ la toáng lên trong cơn sợ hãi. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Thế là, Chúa Giê-xu liền lên tiếng với họ rằng: “Can đảm nào! Là thầy đây. Đừng sợ!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Bấy giờ, khi đáp lại Ngài, Phi-e-rơ thưa: “Lạy Chúa, nếu là thầy, xin truyền cho tôi đi trên nước đến với thầy.” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Rồi Ngài truyền: “Hãy đến đi.” Và sau khi bước ra khỏi thuyền, Phi-e-rơ đã bước đi trên nước để đến với Chúa Giê-xu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Nhưng khi thấy gió mạnh, ông sợ hãi, và lúc bắt đầu chìm xuống, ông la lên, rằng: “Chúa ôi, xin cứu tôi!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Tức thì, sau khi giơ tay ra, Chúa Giê-xu nắm lấy Phi-e-rơ và bảo ông: “Này người ít đức tin, bởi cớ gì mà anh nghi sợ?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Lúc họ bước lên trên thuyền rồi, gió ngừng thổi. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Còn những người trong thuyền thì thờ lạy Ngài, rằng: “Quả thật, thầy là Con Thiên Chúa.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Lúc băng qua bên kia rồi, họ cập vào bờ tại Ghê-nê-xa-rết. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Sau khi nhận ra Ngài, dân chúng ở nơi ấy cử người đưa tin đến khắp khu vực xung quanh đó, và người ta đem đến cho Ngài mọi kẻ mắc bệnh. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Họ xin Ngài chỉ để mình có thể chạm vào vạt áo của Ngài, và bất kể là ai chạm vào thì được chữa lành.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Kế đó, những người Pha-ri-si và thầy dạy luật từ Giê-ru-sa-lem đến với Chúa Giê-xu, nói rằng: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Tại sao các môn đồ của thầy vi phạm những truyền thống của các trưởng lão? Bởi bọn họ không rửa tay khi ăn bánh.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Nhưng khi đáp lại, Ngài nói với họ: “Tại sao các ông lại vi phạm điều răn của Thiên Chúa vì cớ những truyền thống của mình? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Bởi Thiên Chúa đã truyền dạy, rằng: ‘Hãy hiếu kính cha mẹ của con,’ và ‘Kẻ nào phỉ báng cha hoặc mẹ, hãy xử tử kẻ đó.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Nhưng các ông bảo: ‘Người nào nói với cha hoặc mẹ mình: “Hễ điều gì từ nơi con có thể ích lợi cho cha mẹ đều là của lễ dâng lên Thiên Chúa rồi,”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />thì người đó sẽ hoàn toàn không phải hiếu kính cha mình. Như vậy, các ông đã bãi bỏ lời Thiên Chúa<note caller="+" style="f"><char style="ft" closed="false">Những bản cổ đáng tin cậy nhất thể hiện</char><char style="fqa">lời của Thiên Chúa</char> nhưng một số cổ bản khác ghi là <char style="fqa">điều răn.</char> Rất khó chọn cách nào là đúng hơn.</note> vì cớ truyền thống của mình. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Bọn đạo đức giả kia! Ê-sai đã dự ngôn rất đúng về các ông, rằng:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Dân này tôn kính Ta ở đầu môi chót lưỡi,</para>
  <para style="q1" vid="MAT 15:8">nhưng lòng chúng thì cách xa khỏi Ta.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Mà chúng thờ phượng Ta cách vô ích,</para>
  <para style="q1" vid="MAT 15:9">khi dạy các giáo lý là những luật lệ của con người.’”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Rồi sau khi gọi đoàn dân đến, Ngài nói với họ: “Hãy nghe và hiểu: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Chẳng điều gì đi vào trong miệng làm cho ô uế một người, nhưng là điều từ miệng phát ra, thứ này làm cho ô uế người ấy.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Sau đó, khi đã đến gần, các môn đồ thưa với Ngài: “Thầy biết rằng những người Pha-ri-si đã thấy bị xúc phạm sau khi nghe lời ấy không?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Nhưng khi trả lời, Ngài bảo: “Mọi cây mà Cha thiên thượng của thầy không trồng sẽ bị nhổ tận gốc. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Kệ họ đi! Họ là những hướng dẫn viên mù lòa. Mà nếu người mù dẫn người mù, thì cả hai sẽ té xuống hố.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Bấy giờ khi đáp lại, Phi-e-rơ thưa với Chúa: “Xin giải thích cho chúng tôi ẩn dụ ấy.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Nhưng Ngài nói: “Thậm chí đến lúc này, anh em cũng không hiểu sao? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Anh em chưa hiểu rằng mọi thứ đi vào trong miệng thì đi xuống bụng rồi được thải ra trong nhà xí hay sao? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Nhưng những thứ bật ra khỏi miệng xuất phát từ tấm lòng, và chúng làm cho ô uế người ta. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Vì từ lòng phát ra những suy nghĩ xấu xa, giết người, ngoại tình, tà dâm, trộm cắp, chứng dối và những lời lộng ngôn. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Đó là những điều làm cho ô uế người, còn ăn bằng tay chưa rửa thì không làm cho ô uế người ta.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Rồi sau khi đi ra khỏi đó, Chúa Giê-xu lui về các địa phận của Ty-rơ và Si-đôn. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Và nhìn kìa, một phụ nữ người Ca-na-an, sau khi từ vùng đó đến, đã kêu gào, rằng: “Lạy Chúa, Con vua Đa-vít, xin thương xót tôi! Con gái tôi bị quỷ ám tồi tệ lắm.” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Nhưng Ngài không đáp lại cô lời nào. Sau khi đến gần Ngài, các môn đồ cầu xin Ngài, rằng: “Xin thầy bảo chị ấy đi đi, vì chị ta cứ kêu gào đằng sau chúng ta.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Còn lúc trả lời, Ngài nói: “Thầy đã chẳng được sai đến, nếu không phải cho các chiên lạc của nhà Y-sơ-ra-ên.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Nhưng sau khi đến, cô ấy quỳ xuống trước Ngài, thưa: “Lạy Chúa, xin cứu giúp tôi.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Bấy giờ, khi đáp lại, Ngài nói: “Lấy bánh của con cái rồi thảy cho chó con là không hay.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Nhưng cô ấy thưa: “Lạy Chúa, đúng vậy, chỉ là ngay cả mấy con chó con thì được ăn nơi các mẩu vụn rơi xuống từ bàn chủ của chúng.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Lúc đó, để đáp lại, Chúa Giê-xu nói với cô: “Này người phụ nữ kia, đức tin của chị lớn thay. Việc phải được thành cho chị theo như chị muốn.” Và con gái của cô được chữa lành từ giờ đó.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Sau khi rời đi khỏi vùng ấy, Chúa Giê-xu đi dọc biển Ga-li-lê, và lúc lên trên một ngọn đồi rồi, Ngài ngồi tại đó. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Rồi những đoàn dân đông đi lên với Ngài, có những người què, người mù, người tàn tật, người câm, và nhiều người khác cùng với họ. Người ta đặt những người đó nơi chân Ngài và Ngài chữa lành cho họ, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />đến nỗi, đoàn dân kinh ngạc khi thấy người câm nói được, người tàn tật thì lành lặn, người què bước đi và người mù nhìn thấy, rồi họ ngợi khen Thiên Chúa của Y-sơ-ra-ên.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Bấy giờ, sau khi gọi các môn đồ mình lại, Chúa Giê-xu bảo: “Thầy cảm thương với đoàn dân, vì họ đã cứ ở cùng thầy ba ngày rồi mà không có gì để ăn. Thầy không muốn cho họ về bụng đói, kẻo họ có thể ngất xỉu trên đường.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Các môn đồ thưa cùng Ngài: “Trong hoang mạc thì từ đâu ra nhiều bánh như vậy để chúng tôi cho đoàn dân đông thế kia ăn no?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Chúa Giê-xu nói với họ: “Anh em có bao nhiêu ổ bánh?” Rồi họ đáp: “Bảy ổ, và mấy con cá nhỏ.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Và sau khi truyền cho đoàn dân ngồi xuống trên đất, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Ngài cầm bảy ổ bánh cùng mấy con cá, và sau khi tạ ơn, Ngài bẻ ra trao cho các môn đồ, rồi các môn đồ phân phát cho đoàn dân. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Dân chúng đều ăn và được no nê. Họ thu bảy giỏ đầy phần thừa của các mẩu vụn. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Bấy giờ, số người ăn là bốn ngàn đàn ông, không kể phụ nữ và trẻ em. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Khi đã cho dân chúng về, Ngài vào trong thuyền và đi đến vùng Ma-ga-đan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Sau khi đến gần, những người Pha-ri-si và Sa-đu-sê — vì thử Ngài — đã xin Ngài tỏ cho họ một dấu lạ từ trời. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Nhưng lúc đáp lại, Ngài nói với họ:<note caller="+" style="f"><char style="ft" closed="false">Một số cổ bản thêm vào.</char></note> [“Khi đến chiều tối, các ông bảo: ‘Thời tiết đẹp, vì trời đỏ.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Sáng sớm nay thì bảo: ‘Thời tiết giông bão, vì trời đỏ, u ám.’ Tuy các ông biết phân biệt sắc trời, nhưng không có khả năng về các dấu hiệu của thời kỳ.”] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />“Một thế hệ tà ác và gian dâm tìm kiếm dấu lạ, nhưng dấu lạ sẽ chẳng được ban cho nó, ngoại trừ dấu lạ của Giô-na.” Và lúc bỏ họ lại rồi, thì Ngài đi khỏi.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Còn các môn đồ thì đã quên đem theo bánh, sau khi đi đến bờ bên kia. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Bấy giờ, Chúa Giê-xu nói với họ: “Hãy xem chừng và cảnh giác về men của những người Pha-ri-si và Sa-đu-sê.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Thế nhưng, họ cứ tranh luận với nhau rằng: “Đó là vì chúng ta đã không đem theo bánh.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Nhưng khi biết điều này, Chúa Giê-xu bảo: “Những kẻ ít đức tin kia, sao anh em tranh luận với nhau rằng ấy là do mình không có bánh? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Anh em vẫn chưa thông suốt và cũng không nhớ năm ổ bánh cho năm ngàn người rồi anh em đã thu gom được bao nhiêu giỏ sao? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Hay bảy ổ bánh cho bốn ngàn người, rồi anh em đã thu gom được bao nhiêu giỏ sao? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Làm thế nào mà anh em không hiểu được rằng thầy đã chẳng nói với anh em về bánh? Nhưng hãy cảnh giác về men của những người Pha-ri-si và Sa-đu-sê.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Lúc đó họ hiểu ra rằng Ngài không bảo họ cảnh giác về men của bánh, nhưng là về giáo huấn của những người Pha-ri-si và Sa-đu-sê.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Bấy giờ, sau khi đi đến địa phận thành Xê-sa-rê Phi-líp, Chúa Giê-xu đã hỏi các môn đồ mình, rằng: “Người ta nói Con Người là ai?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Rồi họ thưa: “Một số người nói là Giăng Báp-tít; còn một số nói là Ê-li; mà số khác thì nói là Giê-rê-mi hoặc một trong các vị tiên tri.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Ngài nói cùng họ: “Còn anh em nói thầy là ai?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Thế là, khi trả lời, Si-môn Phi-e-rơ thưa: “Thầy là Chúa Cứu Thế, Con Thiên Chúa hằng sống.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Bấy giờ, khi đáp lại, Chúa Giê-xu nói với ông: “Si-môn, con Giô-na, anh có phước thay, vì chẳng phải thịt và máu đã bày tỏ cho anh, nhưng là Cha của thầy trên thiên đàng. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Còn thầy cũng nói với anh rằng anh là Phi-e-rơ, và trên tảng đá này, thầy sẽ xây dựng hội thánh của thầy, và các cửa của âm phủ sẽ chẳng địch lại được hội đó. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Thầy sẽ giao cho anh các chìa khóa của vương quốc thiên đàng, hễ điều gì anh buộc dưới đất thì sẽ được buộc trên thiên đàng, và hễ điều gì anh mở dưới đất thì sẽ được mở trên thiên đàng.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Kế đó, Ngài nghiêm cấm các môn đồ để họ không nói với ai rằng Ngài là Chúa Cứu Thế.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Từ thời điểm đó, Chúa Cứu Thế Giê-xu bắt đầu cho các môn đồ của mình biết rằng Ngài cần phải đi đến Giê-ru-sa-lem, và chịu nhiều khổ nạn từ nơi các trưởng lão, các thầy tế lễ thượng phẩm cùng các thầy dạy luật, rồi bị giết chết và được khiến sống lại vào ngày thứ ba. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Và sau khi kéo Ngài qua một bên, Phi-e-rơ bắt đầu trách Ngài, rằng: “Chúa ôi, Thiên Chúa tỏ lòng nhân từ với thầy. Chuyện đó sẽ chẳng bao giờ xảy đến cho thầy.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Nhưng xoay người lại, Ngài nói với Phi-e-rơ: “Sa-tan kia, hãy đi khuất ra đằng sau Ta! Anh là hòn đá làm vấp chân cho thầy, vì anh không để tâm đến những việc của Thiên Chúa, nhưng là những việc của người ta.” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Kế đó, Chúa Giê-xu nói với các môn đồ của Ngài: “Nếu ai muốn đi theo sau thầy, thì người đó phải chối bỏ bản thân, cùng vác cây thập tự của mình và theo thầy. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Vì hễ ai muốn cứu sự sống mình thì sẽ mất nó, còn người nào mất sự sống mình vì cớ thầy thì sẽ tìm được nó. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Bởi một người sẽ được ích lợi gì nếu giành được cả thế gian, nhưng bị mất sự sống mình? Hoặc một người sẽ cho đi điều gì trong việc đổi lại sự sống mình? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Vì Con Người sắp đến trong vinh hiển của Cha Ngài cùng với các thiên sứ Ngài. Và vào lúc đó, Ngài sẽ trả cho mỗi người tùy theo hành vi của họ. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Quả thật, thầy nói với anh em rằng có mấy người đang đứng đây, là những người chắc chắn sẽ không nếm trải sự chết cho đến khi nào họ thấy Con Người đến trong vương quốc Ngài.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Sáu ngày sau, Chúa Giê-xu đem theo Phi-e-rơ, cùng Gia-cơ và Giăng, em ông, rồi Ngài dẫn riêng họ cùng nhau lên đến một ngọn núi cao. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Vẻ ngoài của Ngài được biến hóa trước mắt họ, và mặt Ngài chiếu rạng như mặt trời, còn áo Ngài trở nên chói lói như ánh sáng. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Và xem kìa, Môi-se cùng Ê-li xuất hiện trước họ, trò chuyện với Ngài. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Bấy giờ, khi mở lời, Phi-e-rơ thưa với Chúa Giê-xu: “Lạy Chúa, thật là tốt cho chúng ta để ở tại đây. Nếu thầy muốn, tôi sẽ dựng nơi này ba cái lều — một cho thầy, một cho Môi-se và một cho Ê-li.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Trong lúc ông vẫn còn đang nói, thì xem kìa, một đám mây sáng rực che phủ họ, và nhìn này, một tiếng phán từ nơi đám mây, rằng: “Đây là Con yêu dấu của Ta, mà Ta rất hài lòng nơi Con. Hãy nghe theo Con ấy.” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Khi nghe rồi, các môn đồ ngã sấp mặt và vô cùng kinh hãi. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Rồi Chúa Giê-xu, sau khi lại gần và chạm vào họ, đã nói: “Hãy đứng dậy và đừng kinh hãi.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Nhưng khi ngước mắt mình lên, họ không thấy ai ngoại trừ một mình Chúa Giê-xu.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Đang khi họ từ trên núi đi xuống, Chúa Giê-xu ra lệnh cho họ, rằng: “Đừng thuật lại điều đã thấy với ai cho đến khi Con Người đã từ cõi chết sống lại.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Các môn đồ ấy hỏi Ngài, rằng: “Vậy vì sao các thầy dạy luật nói là Ê-li cần phải đến trước?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Bấy giờ, khi trả lời, Ngài nói: “Tuy Ê-li phải đến và sẽ phục hồi mọi việc. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Nhưng thầy nói với anh em rằng Ê-li đã đến rồi, và họ đã chẳng nhận ra ông. Thay vào đó, họ làm đủ mọi thứ họ muốn với ông. Cũng một thể ấy, Con Người sắp phải chịu khổ bởi họ.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Lúc đó, các môn đồ hiểu rằng Ngài nói với họ về Giăng Báp-tít.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Khi đã đến cùng đoàn dân, một người đàn ông đã lại gần Ngài, quỳ gối xuống trước Ngài <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />và thưa: “Chúa ôi, xin thương xót con trai tôi, vì nó mắc chứng động kinh và bị nặng lắm, bởi nó hay ngã vào lửa, và thường té xuống nước. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Tôi đã đem nó đến cho các môn đồ của Ngài, nhưng họ không có khả năng chữa lành cho nó.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Bấy giờ, khi đáp lại, Chúa Giê-xu nói: “Thế hệ vô tín và băng hoại kia, tôi sẽ ở với các người cho đến khi nào? Sẽ chịu đựng các người cho đến bao lâu? Hãy đem thằng bé đến đây cho tôi.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Chúa Giê-xu quở trách nó, thì quỷ đi ra khỏi cậu bé, và cậu được chữa lành từ giờ đó.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Kế đó, sau khi tiếp cận riêng với Chúa Giê-xu, các môn đồ thưa: “Vì lý do gì chúng tôi không thể đuổi nó ra được?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Rồi Ngài nói với họ: “Do đức tin kém cỏi của anh em. Vì quả thật, thầy nói với anh em, nếu anh em có đức tin như một hạt cải, thì anh em sẽ truyền cho hòn núi này: ‘Hãy dời từ chỗ này sang chỗ kia,’ thì nó sẽ dời đi, và sẽ chẳng có gì là không thể đối với anh em.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" /><note caller="+" style="f"><char style="ft" closed="false">Một số thủ bản cổ bao gồm câu 21.</char></note> [Nhưng thứ quỷ này chẳng bị trục xuất nếu không bằng sự cầu nguyện và kiêng ăn.]<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Bấy giờ, trong khi họ nhóm nhau lại tại Ga-li-lê, Chúa Giê-xu nói với họ: “Con Người sắp bị nộp vào tay người ta, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />và họ sẽ giết Ngài đi, rồi vào ngày thứ ba, Ngài sẽ được khiến sống lại.” Các môn đồ trở nên vô cùng buồn bã.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Lúc ấy, khi họ đã đi đến thành Ca-bê-na-um, những người thu thuế đền thờ đến cùng Phi-e-rơ và hỏi: “Thầy của anh không nộp thuế đền thờ sao?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Ông bảo: “Có.” Và lúc vào trong nhà rồi, Chúa Giê-xu đã lên tiếng với ông trước, rằng: “Si-môn, anh nghĩ gì thế? Các vua trên đất thu phí hay thuế từ ai? Từ con cái họ hay từ người ngoài?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Sau khi đáp: “Từ người ngoài”, Chúa Giê-xu nói với ông: “Vậy con cái thì được miễn. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Nhưng để chúng ta không gây vấp phạm cho họ, thì lúc đi ra biển, anh hãy thả câu và kéo con cá lên đầu tiên. Sau khi banh miệng nó ra, anh sẽ thấy một siếc-lơ. Lấy được tiền đó rồi, hãy nộp cho họ ứng với phần của thầy và anh.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Vào giờ đó, các môn đồ đến gần Chúa Giê-xu, thưa: “Sau cùng thì ai là lớn hơn hết trong vương quốc thiên đàng?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Rồi sau khi gọi một đứa bé đến với mình, Ngài đặt cậu ở giữa họ <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />và nói: “Quả thật, thầy nói với anh em, nếu anh em không được biến đổi và trở nên như những đứa trẻ, thì chắc chắn anh em sẽ không đi vào trong vương quốc thiên đàng. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Vậy, bất cứ ai hạ mình xuống giống như đứa bé này, thì người đó là lớn hơn hết trong vương quốc thiên đàng. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Nếu ai nhân danh thầy tiếp một đứa bé như thế này, thì người đó tiếp rước thầy. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Nhưng kẻ nào gây vấp phạm cho một trong những người bé mọn này, tức những người tin nơi thầy, thì điều thiết thực cho kẻ đó chính là một cối xây dành cho lừa được treo quanh cổ hắn, rồi hắn bị nhận chìm xuống biển sâu.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Khốn thay cho thế gian vì cớ những thứ gây vấp phạm! Bởi vì những thứ gây vấp phạm phải đến là điều tất yếu, dẫu vậy, khốn thay cho kẻ mà cớ gây vấp phạm đến qua kẻ ấy! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Mặt khác, nếu tay hoặc chân anh em gây cho anh em vấp phạm, hãy chặt bỏ nó và quăng xa khỏi anh em. Ấy là điều tốt cho anh em để bị cụt tay hoặc què chân rồi vào trong sự sống hơn là khi có hai tay hoặc hai chân để rồi bị quăng vào lửa đời đời. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Nếu mắt anh em gây cho anh em vấp phạm, hãy móc nó ra và quăng xa khỏi anh em. Ấy là điều tốt cho anh em để chỉ còn một mắt rồi vào trong sự sống, hơn là khi có hai mắt để rồi bị quăng vào hỏa ngục. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Hãy coi chừng, anh em chẳng nên khinh dể một trong những người bé mọn này. Vì thầy nói với anh em rằng các thiên sứ của chúng trên trời hằng luôn nhìn thấy mặt Cha thầy trên thiên đàng. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><note caller="+" style="f"><char style="ft" closed="false">Vài thủ bản cổ bao gồm câu 11.</char></note> [Vì Con Người đã đến để cứu kẻ bị lạc mất.] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Anh em nghĩ sao? Nếu một người nọ có một trăm con chiên, mà một trong số chúng bị lạc, thì chẳng phải sau khi để lại chín mươi chín con trên đồi và lên đường, người ấy tìm kiếm con chiên bị lạc hay sao? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Nếu người ấy có thể tìm thấy nó, thì quả thật, thầy nói với anh em rằng người đó sẽ vui mừng về nó hơn là về chín mươi chín con chiên không bị lạc. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Tương tự, ý muốn trước mặt Cha trên thiên đàng của anh em không phải là để một trong những người bé mọn này bị hư vong.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Mặt khác, nếu một người anh chị em của anh em phạm tội với anh em, hãy đi, hãy khiển trách người giữa anh em với người đó mà thôi. Nếu người đó nghe theo anh em, thì anh em được lại người anh chị em mình. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Nhưng nếu người đó không nghe theo, hãy dẫn theo mình một hoặc hai người nữa, để cho bởi miệng của hai hoặc ba người làm chứng thì mọi lời có thể được xác nhận. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Còn nếu người đó từ chối nghe theo họ, hãy trình bày cho hội thánh. Mà nếu người đó cũng từ chối nghe theo hội thánh, thì đối với anh chị em, người đó thậm chí phải như là dân ngoại quốc và kẻ thu thuế. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Quả thật, thầy nói với anh em, nếu anh em buộc bất luận điều gì dưới đất, thì điều ấy sẽ bị buộc trên trời; và nếu anh em mở bất luận điều gì ở dưới đất, thì điều ấy sẽ được mở trên trời. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Một lần nữa, quả thật, thầy nói với anh em rằng nếu hai người trong anh em đồng lòng với nhau dưới đất về mọi điều gì mà hễ họ cầu xin, thì điều đó sẽ được làm thành cho họ bởi Cha thầy trên thiên đàng. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Vì nơi nào có hai hoặc ba người được hiệp nhau lại trong danh thầy, thì thầy ở nơi đó ngay giữa họ.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Kế đó, sau khi đến gần, Phi-e-rơ thưa với Ngài: “Lạy Chúa, một người anh em tôi sẽ phạm lỗi nghịch với tôi và tôi sẽ tha thứ anh ta bao nhiêu lần? Đến tận bảy lần chăng?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Chúa Giê-xu nói với ông: “Thầy không nói với anh đến bảy lần, nhưng là đến tận bảy mươi lần bảy. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Vì lý do này, vương quốc thiên đàng có thể được ví như một người làm vua, mà người ấy muốn giải quyết sổ sách với các nô lệ mình. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Bấy giờ, khi vua bắt đầu tính sổ, một con nợ mười ngàn ta-lâng được giải đến cho vua. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Nhưng kẻ đó không có khả năng trả, nên vua đã lệnh cho anh ta phải bị bán, cùng vợ, con và tất tần tật mọi thứ mình có, rồi trả nợ. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Thế là sau khi ngã quỵ xuống, tên nô lệ ấy quỳ trước vua, thưa: ‘Chủ ơi, xin kiên nhẫn với tôi, rồi tôi sẽ trả lại ngài tất cả.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Bấy giờ, bởi động lòng thương xót, chủ của tên nô lệ đó đã phóng thích và tha nợ cho hắn ta. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Nhưng lúc ra ngoài rồi, tên nô lệ đó bắt gặp một trong các kẻ đồng nô lệ với mình, là người mắc nợ hắn một trăm đơ-ni-ê, và sau khi tóm lấy người đó, hắn siết cổ, bảo: ‘Mày nợ gì thì trả đi.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Thế là, sau khi quỳ xuống, kẻ đồng nô lệ với hắn năn nỉ hắn, rằng: ‘Xin kiên nhẫn với tôi, rồi tôi sẽ trả lại anh.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Nhưng anh ta không chịu. Thay vào đó, khi lên đường, hắn cho tống người kia vào tù cho đến khi anh ta trả số tiền nợ. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Vậy, sau khi thấy việc đã xảy ra, các kẻ đồng nô lệ của hắn rất đau lòng. Khi tiến đến rồi, họ thưa trình đầy đủ với chủ mình mọi chuyện đã xảy ra. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Kế đó, sau khi truyền cho tên nô lệ ấy đến, chủ của hắn nói với hắn: ‘Tên nô lệ gian ác kia, ta đã tha hết nợ đó cho anh vì anh đã nài xin ta. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Việc cũng cần làm dành cho anh không phải là thương xót người đồng nô lệ với mình, cũng như ta đã thương xót anh, hay sao?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Bởi bị chọc giận như thế, chủ của hắn đã giao hắn cho bọn tra tấn cho đến khi hắn trả hết mọi thứ mắc nợ. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Cha thiên thượng của thầy cũng sẽ đối đãi với anh em theo cách như vậy, nếu mỗi người trong anh em không tha lỗi cho người anh em của mình xuất phát từ tấm lòng mình.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Việc xảy ra là khi Chúa Giê-xu đã kết thúc những lời ấy, Ngài rời khỏi Ga-li-lê và đi đến vùng Giu-đê ở bên kia sông Giô-đanh. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Những đoàn dân đông theo Ngài và Ngài chữa bệnh cho họ tại đó.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Mấy người Pha-ri-si lại gần Ngài, thử Ngài và thưa: “Có hay không cho phép một người đàn ông ly dị vợ mình vì bất kỳ lý do nào?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Khi trả lời, Ngài nói: “Các ông chưa đọc rằng Đấng sáng tạo từ lúc ban đầu đã dựng nên họ, một người nam và một người nữ, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />và phán: ‘Bởi cớ ấy, người đàn ông sẽ lìa cha và mẹ mà gắn bó mật thiết với vợ mình, và cả hai sẽ là một thịt’ hay sao? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Đến nỗi, họ không còn là hai, nhưng là một thịt. Do đó, điều mà Thiên Chúa đã kết hiệp lại, thì con người không được phân rẽ.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Họ thưa với Ngài: “Vậy, vì sao Môi-se đã truyền dạy phải trao chứng thư ly hôn rồi bỏ vợ đi?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Ngài bảo họ rằng: “Vì sự cứng lòng của các ông mà Môi-se đã cho phép các ông ly dị vợ mình, nhưng từ ban đầu, điều đó không phải là như vậy. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Nhưng tôi nói với các ông rằng ngoại trừ vì tội gian dâm, người nào ly dị vợ mình rồi cưới người khác thì phạm tội ngoại tình; kẻ cưới người đã bị ly dị cũng phạm tội ngoại tình.” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Các môn đồ thưa với Ngài: “Nếu sự tình của người đàn ông cùng với vợ mình là như vậy, thì thà không lập gia đình.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Nhưng Ngài nói với họ: “Không phải hết thảy có thể đón nhận lời này, nhưng là dành cho những ai mà sự ấy được ban cho. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Vì có những người hoạn, là những người được sinh ra từ trong lòng mẹ đã thế; có những người hoạn mà bị người ta làm cho hoạn; và có những người hoạn là những người tự hoạn chính mình vì cớ vương quốc thiên đàng. Ai có thể tiếp nhận lời này, người đó hãy tiếp nhận.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Kế đó, những đứa trẻ nhỏ được đem đến cho Ngài để Ngài đặt tay trên chúng và cầu nguyện, nhưng các môn đồ khiển trách chúng. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Tuy nhiên, Chúa Giê-xu bảo: “Hãy để cho các con trẻ đến với thầy, và đừng ngăn cấm chúng, vì vương quốc thiên đàng là của những ai như thế.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Sau khi đặt tay lên chúng, Ngài từ đó lên đường.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Và xem kìa, một người kia khi đến gần Ngài, đã nói: “Thưa thầy, tôi phải làm việc lành gì để tôi có được sự sống đời đời?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Rồi Ngài nói với anh: “Sao anh hỏi tôi về việc lành? Chỉ một Đấng là thiện lành, còn nếu anh muốn vào trong sự sống, thì hãy giữ các điều răn.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Người đó thưa với Ngài: “Những điều răn nào?” Rồi Chúa Giê-xu bảo: “Đừng giết người, đừng phạm tội tà dâm, đừng trộm cắp, đừng làm chứng dối, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />hãy hiếu kính cha và mẹ, và yêu thương người lân cận của anh như bản thân mình.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Chàng thanh niên ấy thưa với Ngài: “Tôi đã vâng giữ tất cả những điều ấy. Tôi còn thiếu điều gì nữa?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Chúa Giê-xu nói với anh: “Nếu anh muốn được trọn vẹn, hãy đi, hãy bán những gì mình có rồi bố thí cho người nghèo, thì anh sẽ có kho báu trên thiên đàng; và hãy theo tôi nào!” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Nhưng khi nghe lời ấy xong, chàng thanh niên đã bỏ đi vì buồn bã, bởi chàng ta vốn đang có rất nhiều của cải.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Bấy giờ, Chúa Giê-xu nói với các môn đồ mình: “Quả thật, thầy nói với anh em rằng: người giàu sẽ vào trong vương quốc thiên đàng một cách khó khăn. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Mà thầy lại nói cùng anh em, để con lạc đà chui qua lỗ kim là điều dễ dàng hơn so với người giàu vào trong vương quốc của Thiên Chúa.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Bấy giờ, sau khi nghe vậy, các môn đồ rất kinh ngạc, thưa: “Thế thì ai có thể được cứu?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Chăm chú nhìn họ, Chúa Giê-xu nói cùng họ: “Với con người, việc này là không thể, nhưng với Thiên Chúa, mọi việc thì có thể.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Lúc đó, để đáp lại, Phi-e-rơ nói với Ngài: “Thầy nhìn xem, chúng tôi đã bỏ tất cả và theo thầy. Thế thì sẽ có điều gì dành cho chúng tôi?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Rồi Chúa Giê-xu nói với họ: “Quả thật, thầy nói với anh em, rằng anh em, tức là những người đã theo thầy, trong kỳ đổi mới, khi Con Người ngự trên ngôi vinh hiển mình, thì anh em cũng sẽ ngồi trên mười hai ngai, xét đoán mười hai chi tộc Y-sơ-ra-ên. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Mỗi người, tức hễ ai đã bỏ nhà cửa, anh em, chị em, cha, mẹ, vợ, con hoặc đất ruộng vì cớ danh của thầy, sẽ nhận gấp một trăm lần và được hưởng sự sống đời đời. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Nhưng nhiều người đầu sẽ trở nên cuối, và những người cuối sẽ trở nên đầu.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Vì vương quốc thiên đàng thì tựa như một người chủ đất, là người đi ra vào buổi sáng sớm để thuê nhân công cho vườn nho mình. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Bấy giờ, sau khi thỏa thuận cùng những nhân công với một đơ-ni-ê cho một ngày, ông sai họ vào vườn nho của mình. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Và khi đi ra vào khoảng giờ thứ ba, ông thấy số khác đang đứng rảnh rỗi trong khu chợ. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ông nói với họ: ‘Mấy anh cũng hãy vào trong vườn nho, và công giá nào là phải lẽ, thì tôi sẽ trả cho các anh.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Rồi họ đi theo. Sau khi lại đi ra vào khoảng giờ thứ sáu và thứ chín, ông cũng làm như vậy. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Thế rồi, lúc đi ra chừng giờ thứ mười một, ông phát hiện số khác đang đứng, và ông nói với họ: ‘Sao các anh đứng rảnh rỗi cả ngày ở đây?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Họ thưa với ông: ‘Vì chẳng ai thuê chúng tôi.’ Ông nói với họ: ‘Các anh cũng hãy đi vào trong vườn nho.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Rồi đến chiều tối, chủ vườn nho bảo người quản lý của mình: ‘Hãy gọi các nhân công đến và trả thù lao cho họ, bắt đầu từ mấy người cuối cho đến những người đầu.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Sau khi tiến đến, những người được thuê vào khoảng giờ thứ mười một, mỗi người nhận được một đơ-ni-ê. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Còn những nhân công đầu tiên, lúc tiến đến, đã nghĩ rằng mình sẽ nhận nhiều hơn, mà họ cũng nhận một đơ-ni-ê cho mỗi người. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Nhưng sau khi nhận rồi, họ lầm bầm về người chủ đất, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />rằng: ‘Mấy nhân công sau chót đó đã làm việc một giờ, mà chủ để họ ngang bằng với chúng tôi, là những người đã chịu cực nhọc cả ngày cùng cái nóng thiêu đốt.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Nhưng đáp lại, người chủ nói với một người trong bọn họ: ‘Này anh bạn, tôi không có xử tệ với các anh. Chẳng phải các anh đã đồng ý với tôi một đơ-ni-ê hay sao? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Hãy nhận phần của anh và đi đi. Còn tôi thì muốn đưa cho những người cuối này cũng y như cho anh. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Hay chẳng có phép cho tôi để làm điều tôi muốn với những thứ của mình? Hay mắt anh thì khó chịu vì tôi có lòng tốt?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Tương tự, người cuối sẽ trở nên đầu và người đầu trở nên cuối.”<note caller="+" style="f"><char style="ft" closed="false">Các cổ bản đáng tin cậy nhất không có </char><char style="fqa">Nhiều người được gọi, nhưng ít người được chọn.</char></note><verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Đang khi đi lên thành Giê-ru-sa-lem, Chúa Giê-xu đem theo mười hai môn đồ riêng với mình, và trên đường đi, Ngài nói với họ: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Nhìn này, chúng ta đang đi lên đến Giê-ru-sa-lem, và Con Người sẽ bị nộp cho các thầy tế lễ cả và các thầy dạy luật, rồi họ sẽ kết án tử hình Ngài <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />và sẽ giao Ngài cho các dân ngoại quốc để nhạo báng, đánh đòn, và đóng đinh Ngài trên cây thập tự. Rồi vào ngày thứ ba, Ngài sẽ sống lại.”<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Lúc đó, mẹ của hai con trai Xê-bê-đê cùng với các con bà đến gần Ngài, cúi lạy và cầu xin một điều từ Ngài. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Rồi Ngài nói với bà: “Cô muốn điều gì?” Bà thưa với Ngài: “Xin truyền sao cho hai đứa con trai này của tôi, một đứa có thể ngồi ở bên phải, và một đứa ở bên trái thầy trong vương quốc của thầy.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Nhưng khi đáp lại, Chúa Giê-xu bảo: “Ba người chẳng biết mình đang cầu xin điều gì đâu. Hai anh em có thể uống chén mà thầy sắp uống không?” Họ thưa với Ngài: “Chúng tôi có thể.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Ngài nói với họ: “Tuy anh em sẽ uống chén của thầy, nhưng để ngồi ở bên phải và ở bên trái của thầy không phải là việc của thầy quyết định, nhưng là dành cho những người đã được chuẩn bị bởi Cha thầy.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Sau khi nghe chuyện này, mười môn đồ kia nổi giận với hai anh em. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Nhưng lúc đã gọi họ đến với mình, Chúa Giê-xu nói: “Anh em biết rằng những vua chúa của các dân ngoại quốc thì áp chế dân, và những kẻ làm lớn thì thể hiện quyền lực trên người ta. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Trong anh em thì không như vậy. Thay vào đó, nếu ai muốn trở nên lớn giữa vòng anh em, thì người ấy sẽ làm người phục vụ của anh em, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />và người nào muốn làm đầu trong anh em thì sẽ làm đầy tớ của anh em, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />thậm chí như Con Người đã không đến để được phục vụ, nhưng là để phục vụ, và để hiến mạng sống mình như giá chuộc thay thế cho nhiều người.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Rồi khi họ từ thành Giê-ri-cô đi ra, một đoàn dân đông đi theo Ngài. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Và xem kìa, hai người mù đang ngồi ở bên đường. Sau khi nghe rằng Chúa Giê-xu đang đi ngang qua, họ la lên, rằng: “Lạy Chúa, Con vua Đa-vít, xin thương xót chúng tôi.” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Nhưng đoàn dân quở mắng hai người, để họ im đi, thế mà họ thậm chí la lớn hơn nữa, rằng: “Lạy Chúa, Con vua Đa-vít, xin thương xót chúng tôi.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Khi đứng lại rồi, Chúa Giê-xu gọi họ đến và nói: “Các anh muốn tôi làm gì cho các anh?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Họ thưa với Ngài: “Lạy Chúa, ấy là xin cho mắt chúng tôi được sáng.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Bấy giờ, bởi động lòng thương xót, Chúa Giê-xu chạm vào mắt họ. Lập tức, họ phục hồi thị lực và đi theo Ngài.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Khi họ gần đến thành Giê-ru-sa-lem, và đi tới Bê-pha-giê, hướng về Núi Ô-liu, lúc ấy Chúa Giê-xu sai hai môn đồ, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />bảo họ: “Hãy đi vào ngôi làng trước mặt anh em, rồi anh em sẽ thấy ngay một con lừa cái bị buộc, cùng một lừa con ở với nó. Sau khi mở dây buộc, hãy đem đến cho thầy. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Và nếu một ai đó bảo gì với anh em, thì anh em sẽ nói rằng: ‘Chúa có nhu cầu dùng chúng,’ rồi người đó sẽ lập tức để chúng đi.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Mặt khác, việc này xảy ra để cho lời đã được phán thông qua vị tiên tri có thể được ứng nghiệm, rằng:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Hãy bảo con gái của Si-ôn:</para>
  <para style="q1" vid="MAT 21:5">Nhìn kìa, Vua ngươi đến cùng ngươi,</para>
  <para style="q1" vid="MAT 21:5">khiêm nhường và cưỡi lừa</para>
  <para style="q1" vid="MAT 21:5">— tức là trên một lừa con, con của lừa cái.”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Bấy giờ, các môn đồ, sau khi đi và thực hiện y như Chúa Giê-xu đã chỉ dạy họ, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />đã đem lừa cái cùng lừa con về, và trải áo choàng của mình trên chúng, rồi Ngài ngồi trên đó. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Bấy giờ, đại đa số người dân trải áo choàng của mình trên đường, còn một số khác thì chặt các nhánh cây và trải ra trên đường. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Thế rồi, những đoàn đông đi trước Ngài và theo sau đã la lên, rằng:</para>
  <para style="q1" vid="MAT 21:9">“Hô-sa-na Con vua Đa-vít!</para>
  <para style="q1" vid="MAT 21:9">Đáng tôn ngợi Đấng đến trong danh Chúa!</para>
  <para style="q1" vid="MAT 21:9">Hô-sa-na trên nơi chí cao!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Sau khi Ngài vào trong thành Giê-ru-sa-lem, cả thành bị khuấy động, bảo: “Đó là ai?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Thế rồi đoàn dân đáp: “Ấy là tiên tri Giê-xu, từ Na-xa-rét, vùng Ga-li-lê.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Chúa Giê-xu đi vào trong đền thờ, rồi Ngài đuổi hết thảy các kẻ mua bán trong đền, và hất đổ bàn của bọn đổi tiền cùng ghế của đám buôn bồ câu. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ngài nói với họ: “Lời đã được chép: ‘Nhà Ta sẽ được gọi là nhà cầu nguyện,’ nhưng các ông đã biến nó thành hang trộm cướp.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Rồi những người mù và người què đến gần Ngài trong đền thờ, và Ngài chữa lành cho họ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Nhưng các thầy tế lễ cả và các thầy dạy luật, sau khi thấy những việc kỳ diệu mà Ngài đã làm, và thấy bọn trẻ con tung hô trong đền thờ, rằng: “Hô-sa-na Con vua Đa-vít,” thì họ nổi giận. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Họ nói cùng Ngài: “Thầy có nghe chúng nói gì không?” Nhưng Chúa Giê-xu bảo họ: “Có! Các ông chưa bao giờ đọc rằng: ‘Chúa đã chuẩn bị sẵn sự ca ngợi từ miệng của những trẻ thơ và các bé đang bú,’ hay sao?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Sau khi rời bỏ họ, Ngài đi ra khỏi thành đến Bê-tha-ni và nghỉ đêm tại đó.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Đến sáng, đang khi trở vào thành, thì Ngài đói. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Sau khi nhìn thấy một cây vả bên đường, Ngài đi đến cây ấy và phát hiện chẳng có gì trên nó ngoại trừ lá mà thôi. Ngài phán với nó: “Trái chẳng còn có nơi mày nữa cho đến đời đời,” và lập tức, cây vả đó héo khô. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Thấy như vậy rồi, các môn đồ kinh ngạc, bảo: “Làm thế nào mà cây vả đã lập tức héo khô?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Rồi khi trả lời, Chúa Giê-xu nói với họ: “Quả thật, thầy nói với anh em, nếu anh em có đức tin và không nghi ngờ, thì anh em sẽ làm được không chỉ điều này cho cây vả, mà thậm chí nếu anh em bảo với núi này: ‘Hãy được nhấc lên và bị quăng xuống biển,’ thì việc ấy sẽ xảy ra. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Mọi điều, bất luận những điều nào anh em nài xin trong lời cầu nguyện, thì anh em sẽ nhận được khi tin cậy.”<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Và khi Ngài vào trong đền thờ rồi, các thầy tế lễ thượng phẩm cùng những trưởng lão trong dân chúng đã đến gặp Ngài đang khi Ngài giảng dạy, bảo: “Bởi thẩm quyền nào thầy làm những việc này, và ai đã cho thầy thẩm quyền ấy?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Nhưng để trả lời, Chúa Giê-xu nói với họ: “Tôi cũng sẽ hỏi các ông một câu, mà nếu các ông có thể đáp lời tôi, thì tôi cũng sẽ nói cho các ông biết tôi đang làm những điều này bởi thẩm quyền nào. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Phép báp-têm của Giăng — phép ấy là từ đâu? Từ trời hay từ loài người?” Thế rồi, họ tranh luận với nhau, rằng: “Nếu chúng ta bảo: ‘Từ trời,’ thì hắn sẽ nói với chúng ta: ‘Vậy vì lý do gì mà các ông không tin người?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Còn nếu chúng ta bảo: ‘Từ loài người,’ thì chúng ta e ngại dân chúng, bởi tất cả họ coi Giăng là một vị tiên tri.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Nên khi trả lời Chúa Giê-xu, họ nói: “Chúng tôi không biết.” Ngài cũng bảo họ: “Tôi cũng không cho các ông biết tôi làm những việc này bởi thẩm quyền nào. <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />Thế nhưng, các ông nghĩ sao? Một người có hai con trai, và sau khi đến với đứa thứ nhất, ông bảo: ‘Con trai, hôm nay con hãy đi làm việc ở vườn nho.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Mà khi đáp lại, cậu nói: ‘Con không muốn,’ nhưng sau đó, khi đã đổi ý, thì cậu đi. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Còn sau khi đến gặp đứa thứ hai, người cha nói y như vậy. Rồi, khi trả lời, cậu nói: ‘Có con, thưa cha,’ mà cậu ta chẳng đi. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Ai trong hai con trai đó đã thực hiện ý muốn của cha mình?” Họ đáp: “Đứa thứ nhất.” Chúa Giê-xu nói với họ: “Quả thật, tôi bảo các ông rằng những kẻ thu thuế và gái điếm đi vào trong vương quốc của Thiên Chúa trước các ông. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Vì Giăng đã đến với các ông trong đường lối công chính, mà các ông không tin người. Còn những kẻ thu thuế và gái điếm thì tin người. Nhưng các ông, dù nhìn thấy rồi, đã chẳng ăn năn sau đó để tin người.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Hãy nghe một ẩn dụ khác. Có một người chủ đất, là người đã trồng một vườn nho, dựng hàng rào xung quanh vườn ấy, đào hầm ép rượu trong đó, xây tháp canh và cho bọn trồng nho thuê nó, rồi ông đi phương xa. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Bấy giờ, vào lúc mùa thu hoạch gần đến, ông sai mấy người đầy tớ mình đến với bọn trồng nho để thu phần hoa lợi của ông. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Mà khi cầm giữ nhóm đầy tớ của chủ rồi, bọn trồng nho đánh đứa này, giết đứa kia, ném đá đứa nọ. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ông lại sai những đầy tớ khác đến, đông hơn nhóm trước, mà chúng đãi họ y như vậy. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Rồi sau cùng, ông sai chính con trai mình đến cùng họ, rằng: ‘Chúng sẽ kiêng nể con trai mình.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Nhưng bọn trồng nho, sau khi thấy người con ấy, đã bàn với nhau: ‘Đây là đứa thừa kế. Nào, chúng ta cần giết hắn rồi sở hữu sản nghiệp của hắn.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Lúc cầm giữ người con rồi, chúng ném cậu ra khỏi vườn nho và giết đi. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Vậy, khi người chủ vườn nho đến, ông ta sẽ làm gì với bọn trồng nho ấy?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Họ thưa với Ngài: “Ông ấy sẽ diệt trừ bọn gian ác kia cách thê thảm, rồi sẽ cho những người trồng nho khác thuê vườn, là những người sẽ nộp lại cho ông phần hoa lợi vào mùa vụ của họ.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Chúa Giê-xu nói với họ: “Phải chăng các ông chưa từng đọc trong Kinh Thánh:</para>
  <para style="q1" vid="MAT 21:42">‘Hòn đá mà những thợ xây loại bỏ,</para>
  <para style="q1" vid="MAT 21:42">nó đã được trở nên đá mấu chốt của góc nhà.</para>
  <para style="q1" vid="MAT 21:42">Việc này xảy đến từ Chúa,</para>
  <para style="q1" vid="MAT 21:42">và nó thật là diệu kỳ trong mắt chúng ta?’<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Vì lý do này, tôi nói với các ông rằng vương quốc của Thiên Chúa sẽ bị cất lấy khỏi các ông và sẽ được ban cho một dân sản sinh kết quả của vương quốc ấy. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Ai ngã vào hòn đá này sẽ bị vỡ vụn, còn hòn đá rơi trên người nào, nó sẽ đè nát người đó.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Sau khi nghe các ẩn dụ của Ngài, các thầy tế lễ thượng phẩm và những người Pha-ri-si nhận biết rằng Ngài đang nói về họ. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Khi tìm cách bắt Ngài, họ lại e ngại đám đông, vì dân chúng xem Ngài là một vị tiên tri.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Và đáp lại, Chúa Giê-xu một lần nữa nói với họ bằng ẩn dụ, rằng: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Vương quốc thiên đàng được ví như một người là vua, mà vua ấy chuẩn bị tiệc cưới cho con trai mình. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Vua sai các đầy tớ của mình đi để gọi những người đã được mời đến tiệc cưới, mà họ không muốn đến. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Vua lại sai các đầy tớ khác, rằng: ‘Hãy nói với những người đã được mời: “Xem kìa, ta đã dọn tiệc của ta. Những con bò và thú mập của ta đã được làm thịt, và mọi thứ sẵn sàng rồi. Hãy đến với bữa tiệc.”’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Nhưng họ bỏ đi vì chẳng quan tâm, kẻ này ra ruộng mình, kẻ kia hướng tới việc kinh doanh của mình. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Mà số còn lại, sau khi cầm giữ các đầy tớ của vua, thì đã sỉ nhục và giết đi. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Thế rồi, nhà vua bị chọc giận, nên sau khi sai lính mình đi, ông đã cho diệt trừ bọn sát nhân đó và đốt thành của chúng. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Sau đó, vua bảo các đầy tớ của mình: ‘Tuy tiệc cưới đã sẵn sàng, nhưng những kẻ từng được mời đó thì không xứng đáng. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Vậy, hãy đi đến các giao lộ, rồi nếu các anh gặp bất luận bao nhiêu người, thì hãy mời đến tiệc cưới.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Và những đầy tớ đó, sau khi đi ra tại các con đường, đã tập hợp tất cả những ai mà họ gặp, cả xấu lẫn tốt, rồi sảnh tiệc đã được lấp đầy bởi những thực khách. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Nhưng khi vào để xem các khách ngồi ăn, vua thấy một người kia không mặc y phục tiệc cưới. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Vua nói người đó: ‘Này bạn, làm thế nào anh vào đây khi không có y phục tiệc cưới?’ Nhưng người đó bị cứng họng. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Kế đó, vua bảo các đầy tớ: ‘Hãy trói tay chân của tên này lại rồi quăng hắn vào chỗ tối tăm ngoài kia, nơi sẽ có sự than khóc và nghiến răng.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Vì nhiều người được gọi, nhưng ít người được chọn.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Lúc đó, sau khi bỏ đi, những người Pha-ri-si bàn mưu tính kế sao cho họ có thể gài bẫy Ngài trong lời nói. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Họ sai các môn đồ mình, cùng những người thuộc đảng Hê-rốt, đến với Ngài, nói: “Thưa thầy, chúng tôi biết rằng thầy là người thành thật và dạy dỗ đường lối của Thiên Chúa bằng chân lý, và không có sự vị nể ở nơi thầy về bất kỳ ai, vì thầy không nhìn nơi mặt ngoài của người ta. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Vì thế, xin cho chúng tôi biết thầy nghĩ thế nào? Có được nộp thuế cho Xê-xa hay không?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Nhưng vì đã biết tâm địa gian tà của họ, Chúa Giê-xu bảo: “Những kẻ đạo đức giả kia, sao các ông thử tôi? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Hãy cho tôi xem đồng tiền nộp thuế.” Họ đem cho Ngài đồng một đơ-ni-ê. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Ngài nói với họ: “Hình và danh hiệu này là của ai?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Họ đáp: “Của Xê-xa.” Lúc ấy, Ngài nói với họ: “Vậy, hãy trả cho Xê-xa những gì của Xê-xa, và cho Thiên Chúa những gì của Thiên Chúa.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Sau khi nghe lời ấy, họ rất kinh ngạc, rồi họ rời đi, bỏ Ngài lại.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Vào hôm đó, mấy người Sa-đu-sê đến gần Ngài, vì thường bảo là không có sự sống lại, nên họ đã chất vấn Ngài, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />rằng: “Thưa thầy, Môi-se nói: ‘Nếu một người nào đó chết khi không có con, thì em trai người ấy sẽ cưới vợ của anh và sinh con cho người anh của mình.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Nhưng giữa chúng tôi có bảy anh em trai, người đầu tiên, sau khi lập gia đình, thì đã chết. Và anh để lại vợ của anh cho người em mình, khi không có con. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Người thứ hai rồi người thứ ba, cho đến người thứ bảy, cũng như thế. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Rồi sau hết thảy, người phụ nữ chết đi. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Vậy, trong sự sống lại, chị sẽ là vợ của ai trong bảy anh em? Vì tất cả họ đã lấy chị.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Nhưng khi trả lời, Chúa Giê-xu nói với họ: “Các ông bị lệch lạc rồi, vì không biết Kinh Thánh lẫn quyền phép của Thiên Chúa. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Vì trong sự sống lại, người ta không cưới cũng không được gả đi, nhưng họ thì giống như các thiên sứ trên trời. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Còn về sự sống lại của kẻ chết, các ông chưa đọc lời đã được Thiên Chúa phán với mình, rằng: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ta là Thiên Chúa của Áp-ra-ham, Thiên Chúa của Y-sác và Thiên Chúa của Gia-cốp’? Thiên Chúa không phải là của kẻ chết, nhưng là của người sống.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Lúc nghe như vậy, dân chúng bị kinh ngạc về giáo huấn của Ngài.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Còn những người Pha-ri-si, sau khi nghe rằng Ngài đã khiến mấy người Sa-đu-sê cứng họng, thì đã tập hợp với nhau. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Một người trong số họ, là luật gia, đã chất vấn để thử Ngài — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Thưa thầy, điều răn nào lớn nhất trong luật pháp?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Rồi Ngài nói cùng anh ta: “‘Hãy yêu mến Chúa, là Thiên Chúa của con, bằng hết cả tấm lòng con, cùng hết cả linh hồn con và hết cả trí tuệ con.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Đó là điều răn lớn và quan trọng nhất. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Còn điều răn thứ hai tương tự điều ấy — ‘Hãy yêu thương người lân cận của con như bản thân mình.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Toàn bộ luật pháp và các tiên tri được neo trên hai điều răn này.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Bấy giờ, sau khi mấy người Pha-ri-si được tập hợp cùng nhau, Chúa Giê-xu hỏi họ, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />rằng: “Các ông nghĩ thế nào về Chúa Cứu Thế? Ngài là con của ai?” Họ trả lời Ngài: “Của vua Đa-vít.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Ngài nói với họ: “Vậy làm thế nào mà Đa-vít, trong Thánh Linh, gọi Ngài là Chúa, khi nói:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Chúa phán với Chúa tôi:</para>
  <para style="q1" vid="MAT 22:44">“Hãy ngồi ở bên phải Ta,</para>
  <para style="q1" vid="MAT 22:44">cho đến khi nào Ta đặt các kẻ thù của con dưới chân con”’?<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Vậy nếu Đa-vít gọi Ngài là ‘Chúa,’ thì làm sao Ngài là con vua ấy?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Không ai có thể đáp lại Ngài một lời, cũng chẳng một người nào dám chất vấn Ngài nữa kể từ ngày hôm đó.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Kế đó, Chúa Giê-xu nói với đoàn dân và các môn đồ mình, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />rằng: “Các thầy dạy luật và những người Pha-ri-si ngồi trên ghế của Môi-se. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Do đó, nếu họ truyền dạy anh chị em bất kể điều gì, hãy thực hiện và tuân giữ tất cả. Nhưng đừng làm theo các hành vi của họ, vì họ nói mà không làm. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Họ buộc những gánh nặng nề và khó mang, rồi họ chất lên vai người ta, nhưng bản thân họ chẳng muốn động ngón tay mình vào chúng. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Họ thực hiện mọi công việc của mình để được người ta xem thấy. Vì họ làm những hộp đựng kinh luật của mình cho lớn và kết những tua áo mình cho dài. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Họ yêu thích vị trí cao trọng nhất trong đám tiệc, và những chỗ ngồi tôn kính nhất trong nhà hội, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />cùng những lời chào nơi phố chợ, và được dân chúng gọi là ‘Ra-bi.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Nhưng anh chị em không nên được gọi là ‘Ra-bi’, vì thầy của anh chị em chỉ có một, còn tất cả anh chị em là huynh đệ. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Và anh chị em đừng gọi bất cứ ai trên đất là ‘cha’ vì anh chị em chỉ có một Cha thiên thượng. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Cũng đừng để mình được gọi là ‘giáo chủ,’ vì giáo chủ của anh chị em chỉ có một — tức là Chúa Cứu Thế. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Nhưng người lớn nhất giữa vòng anh chị em sẽ là tôi tớ anh chị em <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Còn ai tự tôn mình lên sẽ bị hạ xuống; và ai tự hạ mình xuống sẽ được tôn lên.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Nhưng khốn cho các ông, những thầy dạy luật và người Pha-ri-si, bọn đạo đức giả kia! Bởi các ông đóng vương quốc thiên đàng lại trước mặt người ta. Vì các ông thì không vào trong, cũng chẳng để cho ai tiến vào được bước vô trong. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><note caller="+" style="f"><char style="ft" closed="false">Các cổ bản đáng tin cậy nhất không có phần đầu câu 14 (Một số bản thêm phần này vào sau câu 12).</char></note> [Khốn cho các ông, những thầy dạy luật và người Pha-ri-si, bọn đạo đức giả kia! Bởi các ông ăn nuốt nhà các góa phụ, mà cầu nguyện cách dài dòng trong sự giả bộ.] Vì lý do ấy, các ông sẽ nhận bản tuyên án nặng hơn. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Khốn cho các ông, những thầy dạy luật và người Pha-ri-si, bọn đạo đức giả kia! Bởi các ông băng qua biển cả lẫn đất khô để khiến cho một người cải đạo, và khi người đó đã trở nên như vậy, các ông xui khiến người ấy thành đứa con của hỏa ngục gấp hai lần các ông.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Khốn cho các ông, những kẻ dẫn đường mù lòa, tức là những kẻ nói: ‘Người nào thề bởi đền thờ thì chẳng sao. Nhưng người nào thề bởi vàng của đền thờ thì ấy là bắt buộc.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Những kẻ ngu dại và bọn mù lòa kia! Vì điều nào là trọng hơn, vàng hay đền thờ khiến vàng được thánh? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Lại còn: ‘Người nào thề bởi bàn thờ thì chẳng sao. Nhưng người nào thề bởi của lễ bên trên bàn thờ thì ấy là bắt buộc.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Những kẻ ngu dại và bọn mù lòa kia! Vì điều nào trọng hơn, của lễ hay bàn thờ khiến của lễ được thánh? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Do đó, ai đã thề bởi bàn thờ thì thề bởi bàn thờ và bởi mọi thứ bên trên đó. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Ai đã thề bởi đền thờ thì thề bởi đền thờ và bởi Đấng ngự trong đó. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Và ai đã thề bởi trời thì thề bởi ngôi của Thiên Chúa và bởi Đấng ngự trên đó.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Khốn cho các ông, những thầy dạy luật và người Pha-ri-si, bọn đạo đức giả kia! Bởi các ông nộp phần mười bạc hà, thì là và rau cần, mà bỏ lơ những điều hệ trọng hơn của luật pháp — tức là sự công chính, lòng thương xót và sự trung tín. Mặt khác, ấy là điều cần thiết để thực hiện những việc này, và không bỏ qua các việc kia. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Bọn dẫn đường mù lòa kia, tức là những kẻ sàn lọc ra một con muỗi tí ti, nhưng nuốt trôi một con lạc đà!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Khốn cho các ông, những thầy dạy luật và người Pha-ri-si, bọn đạo đức giả kia! Bởi các ông rửa sạch bên ngoài của chén và dĩa, nhưng bên trong thì chúng đầy dẫy sự cướp bóc và buông thả. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Những kẻ Pha-ri-si mù lòa kia! Trước hết, hãy rửa sạch bên trong chén và dĩa, để bên ngoài của chúng cũng trở nên sạch sẽ.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Khốn cho các ông, những thầy dạy luật và người Pha-ri-si, bọn đạo đức giả kia! Bởi các ông giống những ngôi mộ được tô trắng, là những thứ tuy tỏ ra đẹp đẽ bên ngoài, nhưng bên trong thì đầy xương cốt người chết và đủ thứ dơ bẩn. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Cũng tương tự như vậy, tuy bên ngoài các ông ra vẻ công chính đối với người ta, nhưng bên trong các ông thì đầy thói giả hình và vô luật pháp.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Khốn cho các ông, những thầy dạy luật và người Pha-ri-si, bọn đạo đức giả kia! Bởi các ông xây cất lăng mộ của các vị tiên tri và trang hoàng mồ mả của những người công chính. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Các ông bảo: ‘Nếu chúng tôi ở trong thời của các tổ phụ mình, thì hẳn là chúng tôi đã không làm những kẻ dự phần với họ nơi máu của các vị tiên tri.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Thế nên, các ông tự làm chứng về mình rằng mình là con cháu của những kẻ đã giết các vị tiên tri, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />và các ông hãy làm đầy trọn cái lường tội ác của tổ phụ mình! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Bọn rắn độc kia, dòng dõi của rắn lục, các ông sẽ chạy thoát khỏi sự đoán phạt của hỏa ngục bằng cách nào? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Vì lý do này, hãy xem kìa, tôi sai phái những vị tiên tri, người khôn ngoan và thầy dạy luật đến với các ông. Từ giữa vòng họ, các ông sẽ giết chết và đóng đinh, cũng từ giữa vòng họ, các ông sẽ đánh đòn trong các nhà hội mình và truy đuổi từ thành này qua thành khác, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />sao cho có thể đến trên các ông tất cả máu công chính đã bị đổ ra trên đất, từ máu của A-bên, người công chính, cho đến máu của Xa-cha-ri, con trai Ba-ra-chi, người mà các ông đã giết chết giữa đền thờ và bàn thờ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Quả thật, tôi nói với các ông, mọi việc đó sẽ xảy đến trên thế hệ này.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Giê-ru-sa-lem, Giê-ru-sa-lem, ngươi đã giết chết các vị tiên tri và ném đá những người được sai đến với ngươi! Bao nhiêu lần ta muốn tập hợp con cái của ngươi lại, theo cách mà gà mái túc con mình dưới cánh, mà ngươi không chịu! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Nhìn này, nhà của các ông sẽ bị bỏ lại hoang vu cho các ông. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Vì tôi nói với các ông, các ông chắc chắn sẽ không thấy tôi từ giờ cho đến khi nào các ông nói: ‘Chúc tụng Đấng đến trong danh Chúa!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Sau khi ra khỏi đền thờ, Chúa Giê-xu tiếp tục chuyến đi. Rồi các môn đồ Ngài đến gần để chỉ cho Ngài xem những công trình của đền thờ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Nhưng khi đáp lại, Ngài bảo họ: “Anh em không nhìn thấy mọi thứ đó sao? Quả thật, thầy nói với anh em, nơi đây chắc chắn sẽ không còn lại khối đá này trên khối đá kia mà chẳng bị phá đổ.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Bấy giờ, khi Ngài đang ngồi trên núi Ô-liu, các môn đồ đến riêng gần Ngài, thưa: “Xin cho chúng tôi biết chừng nào những việc ấy sẽ xảy ra, và dấu hiệu sự đến của thầy và của kỳ tận chung là gì?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Khi trả lời, Chúa Giê-xu nói với họ: “Hãy cẩn thận để không ai có thể làm cho anh em lầm lạc. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Vì lắm kẻ sẽ đến trong danh thầy, xưng: ‘Ta là Chúa Cứu Thế,’ và sẽ làm cho nhiều người lầm lạc. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mặt khác, anh em sắp sửa nghe về chiến tranh và những thông tin về chiến tranh. Anh em hãy coi chừng, đừng bị rối trí, vì việc ấy cần phải xảy ra, nhưng vẫn chưa phải là cuối cùng. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Vì dân này sẽ nổi lên chống lại dân khác, nước này nghịch lại nước kia, rồi sẽ có đói kém và động đất ở nhiều nơi. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Nhưng tất cả những việc này là điểm khởi đầu của các cơn đau chuyển dạ. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Kế đó, người ta sẽ đẩy anh em vào cảnh hoạn nạn rồi giết anh em đi, và anh em sẽ bị mọi dân căm ghét vì cớ danh thầy. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Rồi nhiều người sẽ bị vấp phạm, phản bội nhau và thù ghét nhau. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Nhiều tiên tri giả sẽ được dấy lên và làm cho nhiều người lầm lạc. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Vì tình trạng vô luật pháp bị gia tăng, tình yêu của nhiều người sẽ bị nguội lạnh. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Nhưng ai bền lòng cho đến cuối cùng, người đó sẽ được cứu. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Phúc Âm này về vương quốc sẽ được rao giảng trên khắp thế giới để làm một lời chứng cho mọi dân, và rồi sự cuối cùng sẽ đến.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Do đó, khi anh em nhìn thấy điều kinh tởm của cảnh hoang tàn, là điều đã được tiên tri Đa-ni-ên nói đến, đặt trong nơi thánh” (người đọc phải hiểu), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“lúc đó, ai trong vùng Giu-đê hãy chạy trốn đến vùng núi, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ai ở trên mái nhà, đừng đi xuống để lấy thứ gì khỏi nhà mình, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />và ai ở ngoài đồng đừng trở về để lấy áo khoác mình. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Nhưng thật bất hạnh cho phụ nữ mang thai và những ai đang cho con bú trong các ngày đó! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Nhưng hãy cầu nguyện để việc chạy nạn của anh em không diễn ra vào mùa đông, hay nhằm ngày Sa-bát. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Vì lúc ấy sẽ có sự hoạn nạn lớn, chưa từng xảy ra giống như vậy từ lúc khởi đầu thế giới cho đến ngày nay, và chắc chắn cũng sẽ không có. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Nếu những ngày ấy không được rút ngắn, thì hẳn là mọi xác thịt đã chẳng được cứu. Nhưng vì cớ những người được chọn, những ngày đó sẽ được giảm bớt. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Lúc đó, nếu một ai đó nói với anh em: ‘Xem kìa, Chúa Cứu Thế ở đây!’ hoặc ‘Ở đó!’ thì anh em đừng tin. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Vì những cứu chúa giả cùng các tiên tri giả sẽ được vực dậy và tỏ ra những dấu hiệu cùng các phép lạ lớn lao đến nỗi làm cho lầm lạc, nếu có thể, thì ngay cả những người được chọn. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Nhìn này, thầy nói trước cho anh em rồi đó. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Vậy, nếu người ta nói với anh em: ‘Xem kìa, Ngài đang trong hoang mạc,’ thì anh em chẳng nên đi ra đó. Hay ‘Xem này, nơi các phòng kín,’ thì anh em đừng nên tin. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Vì tia chớp phát ra từ phương đông rồi vụt sáng đến tận phương tây thể nào, thì sự hiện đến của Con Người sẽ là thể ấy. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Hễ xác chết ở nơi nào, kền kền sẽ bu lại nơi đó.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Nhưng ngay sau cơn hoạn nạn của những ngày đó, mặt trời sẽ bị làm cho tối tăm, mặt trăng sẽ không chiếu ánh sáng của nó, các ngôi sao sẽ từ trời rơi rụng, và các quyền lực của các tầng trời sẽ bị rúng động. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Lúc đó, dấu hiệu về Con Người sẽ được tỏ ra trên bầu trời, và rồi hết thảy các dân tộc trên đất sẽ than khóc. Họ sẽ thấy Con Người đến trên những đám mây trời với quyền phép và vinh quang lớn. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ngài sẽ sai phái các thiên sứ của Ngài cùng với tiếng kèn lớn, và họ sẽ tập hợp lại những người được chọn của Ngài từ bốn phương, từ cuối vùng trời này đến tận cuối vùng trời kia.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Mặt khác, hãy học biết ẩn dụ này từ cây vả. Khi nhánh nó trở nên mềm và ra lá rồi, thì anh em biết rằng mùa hè gần đến. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Cũng theo cách đó, khi anh em thấy mọi điều này, thì anh em biết rằng Ngài đang ở gần, ngay tại cửa. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Quả thật, thầy nói với anh em, rằng thế hệ này chắc chắn sẽ không qua đi cho đến khi nào tất cả những điều ấy đã xảy ra. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Trời và đất sẽ qua đi, nhưng những lời của thầy chắc chắn sẽ không qua đi. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Còn liên quan đến ngày và giờ đó thì không ai biết, kể cả các thiên sứ trên thiên đàng hay Con, ngoại trừ Cha mà thôi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Bởi thời Nô-ê như thế nào, thì sự đến của Con Người sẽ là như thế ấy. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Vì như trong những ngày trước cơn nước lụt, người ta vốn ăn uống, cưới gả cho đến ngày Nô-ê vào trong tàu, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />và họ không nhận ra cho đến lúc nước lụt đến và cuốn họ đi — sự đến của Con Người cũng sẽ là như thế. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Lúc ấy, hai người nam đang ở ngoài đồng — một người bị đem đi, một người được để lại. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Hai phụ nữ đang xay cối — một người bị đem đi, một người được để lại. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Vì thế, hãy cảnh giác vì anh em không biết vào ngày nào Chúa mình sẽ đến. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Nhưng anh em nhận thức việc này, rằng nếu chủ nhà đã biết kẻ trộm đến vào canh nào của đêm, thì hẳn là ông ấy đã cảnh giác và ắt không để cho nhà mình bị đột nhập. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Vì lý do này, anh em cũng phải trở nên sẵn sàng, vì Con Người sẽ đến trong giờ anh em không nghĩ đến.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Cho nên, ai là đầy tớ trung tín và khôn ngoan mà chủ chỉ định coi sóc trên người nhà của chủ để cung ứng đồ ăn cho họ vào đúng thời điểm? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Phước thay là người đầy tớ đó, là người mà chủ của anh, sau khi đến, sẽ thấy anh đang thực hiện như vậy. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Quả thật thầy nói với anh em rằng chủ sẽ đặt để anh ta coi sóc trên mọi thứ chủ sở hữu. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Nhưng nếu tên đầy tớ gian ác đó nói trong lòng mình: ‘Chủ ta đang chậm trễ,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />rồi bắt đầu đánh đập những người đồng là đầy tớ với mình, mà ăn uống với bọn say rượu, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />thì người chủ của tên đầy tớ đó sẽ đến vào ngày mà hắn không mong đợi và trong giờ mà hắn không biết. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Ông ấy sẽ đánh xé hắn cách nghiêm khắc và sẽ ấn định chỗ của hắn chung với bọn đạo đức giả; tại nơi đó sẽ có sự than khóc và nghiến răng.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Vậy, vương quốc thiên đàng sẽ được ví như mười trinh nữ, là những người cầm đèn mình đi ra đến nơi đón tiếp chú rể. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Nhưng năm cô trong số họ là dại, và năm cô thì khôn. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Vì năm cô dại, sau khi cầm đèn của họ đi, đã không đem dầu theo với mình. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Còn những cô khôn thì đã đem dầu theo trong bình cùng với đèn mình. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Bấy giờ, vì chàng rể chậm trễ, tất cả họ đã trở nên mơ màng rồi ngủ thiếp đi. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Nhưng vào nửa đêm, có tiếng hô: ‘Chú rể kìa! Hãy đi ra đến nơi đón tiếp.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Lúc đó, tất cả các trinh nữ ấy được đánh thức và sửa soạn đèn mình. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Bấy giờ, các cô dại nói với các cô khôn: ‘Xin cho chúng tôi một phần dầu của các cô, vì đèn của chúng tôi sắp tắt.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Nhưng khi đáp lại, các cô khôn nói: ‘E là sẽ không thể nào có đủ cho chúng tôi và các chị. Thà rằng, hãy đi tới những người buôn bán mà mua cho mình.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Tuy nhiên, trong khi họ đi mua, chú rể đã đến, và những ai sẵn sàng cùng với chàng thì vào trong bữa tiệc cưới, rồi cửa được đóng lại. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Rồi sau đó, các trinh nữ kia cũng đến, thưa: ‘Chủ ơi, chủ ơi, xin mở cửa cho chúng tôi.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Nhưng khi đáp lại, chủ nói: ‘Quả thật, tôi nói với các cô, tôi chẳng biết các cô.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Vậy, hãy tỉnh thức, bởi anh em không biết ngày hay giờ.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Vì giống như một người sắp đi phương xa, ông đã gọi các đầy tớ của mình lại và giao họ tài sản của ông. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Ông cho người này năm ta-lâng, người kia hai ta-lâng, người khác nữa một ta-lâng — đối với mỗi người tùy theo khả năng riêng. Rồi ông lập tức lên đường đi phương xa. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Khi ông đi rồi, người nhận năm ta-lâng đã giao thương thông qua chúng và kiếm được năm ta-lâng khác. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Tương tự, người có hai ta-lâng cũng kiếm được hai ta-lâng khác. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Nhưng người đã nhận một ta-lâng, sau khi đi ra, đã đào đất và giấu tiền của chủ mình. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Bấy giờ, sau một thời gian dài, chủ của những người đầy tớ ấy đến và tính toán sổ sách với họ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Sau khi đến gần, người nhận năm ta-lâng đã đem năm ta-lâng khác, nói rằng: ‘Thưa ông chủ, ông đã giao cho tôi năm ta-lâng. Nhưng xin xem này, tôi đã làm lợi thêm năm ta-lâng.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Chủ của anh nói với anh: ‘Được lắm, anh đầy tớ ngay lành và trung tín! Anh đã trung tín trên vài việc. Tôi sẽ chỉ định anh coi sóc trên nhiều việc. Hãy vào trong niềm vui của chủ mình.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Người có hai ta-lâng, sau khi đến gần, cũng đã nói: ‘Thưa ông chủ, ông đã giao cho tôi hai ta-lâng, nhưng xin xem này, tôi đã làm lợi thêm hai ta-lâng.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Chủ của anh nói với anh: ‘Được lắm, anh đầy tớ ngay lành và trung tín! Anh đã trung tín trên vài việc. Tôi sẽ chỉ định anh coi sóc trên nhiều việc. Hãy vào trong niềm vui của chủ mình.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Còn người nhận một ta-lâng, cũng tiến đến, đã nói: ‘Thưa ông chủ, tôi biết ông, rằng ông là một người hà khắc, gặt ở chỗ mình không gieo và thu hoạch ở chỗ mình không rải ra. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Vì hoảng sợ, nên sau khi đi ra, tôi đã giấu ta-lâng của ông dưới đất. Xin xem này, ông sở hữu phần của mình.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Nhưng lúc đáp lại, người chủ của kẻ ấy nói với hắn: ‘Tên đầy tớ gian ác và biếng nhác kia! Anh vốn đã biết rằng tôi gặt ở nơi tôi không gieo và thu hoạch ở chỗ tôi không rải ra. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Thế thì, đáng lẽ anh cần phải đem để tiền của tôi ở ngân hàng, rồi sau khi đến, thì hẳn là tôi đã nhận lại vốn của tôi cùng tiền lời. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Vậy, hãy lấy ta-lâng khỏi tên này và đưa chúng cho người đang có mười ta-lâng. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Vì với người đang có, thì mọi thứ sẽ được ban cho — thậm chí sẽ được dư đầy. Nhưng đối với kẻ chẳng có, thì ngay cả điều hắn có sẽ bị lấy đi khỏi hắn. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Và hãy quăng tên đầy tớ vô dụng đó vào chỗ tối tăm bên ngoài, là nơi sẽ có sự than khóc và nghiến răng.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Còn lúc Con Người đến trong vinh quang Ngài và tất cả thiên sứ cùng với Ngài, thì khi ấy, Ngài sẽ ngồi trên ngôi vinh hiển mình. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Hết thảy các dân sẽ được tập hợp trước mặt Ngài, và Ngài sẽ phân tách họ với nhau, như thể người chăn phân tách chiên ra khỏi dê. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ngài sẽ để chiên ở bên phải mình, còn dê ở bên trái. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Sau đó, Vua sẽ bảo những ai ở bên phải mình: ‘Những người đã được Cha Ta ban phước, đến đây nào, hãy hưởng vương quốc đã được sắm sẵn cho mình từ lúc lập nền thế giới. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Vì Ta đói, thì các con cho Ta ăn; Ta khát, thì các con cho Ta uống; Ta là khách lạ, thì các con tiếp đãi Ta; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ta trần truồng, thì các con mặc cho Ta; Ta đau ốm, thì các con chăm sóc Ta; Ta ở trong tù, thì các con đến với Ta.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Khi ấy, những người công chính sẽ đáp lại Ngài, rằng: ‘Lạy Chúa, chúng con đã thấy Ngài đói mà cho ăn, hay là khát mà cho uống vào lúc nào? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Rồi chúng con đã thấy Ngài như khách lạ mà tiếp đãi, hay trần truồng mà mặc cho vào lúc nào? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Và chúng con đã thấy Ngài đau ốm hay ở trong tù khi nào mà đến với Ngài?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Khi trả lời, Vua sẽ nói với họ: ‘Quả thật, Ta nói với các con, dựa vào mọi chuyện các con đã làm cho một trong những người bé mọn nhất nơi những anh chị em này của Ta, thì các con đã làm cho Ta.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Kế tiếp, Vua cũng sẽ bảo những kẻ ở bên trái: ‘Hãy đi xa khỏi Ta, những kẻ bị rủa sả kia, hướng vào lửa đời đời đã dành sẵn cho ma quỷ và các quỷ sứ của nó. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Vì Ta đói mà các người không cho Ta ăn; Ta khát mà các người không cho Ta uống; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ta là khách lạ, mà các người không tiếp đãi Ta; trần truồng thì các người chẳng mặc cho Ta; đau ốm và ở trong tù, thì các người chẳng chăm sóc Ta.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Khi ấy, họ cũng sẽ đáp, rằng: ‘Thưa Chúa, chúng con đã thấy Ngài đói, hay khát, hoặc như khách lạ, hay trần truồng, hoặc đau ốm, hay ở trong tù lúc nào mà chẳng phục vụ Ngài?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Thế rồi, Vua sẽ trả lời họ, rằng: ‘Quả thật, Ta nói với các người, dựa vào mọi chuyện các người đã không làm cho một trong những người bé mọn nhất nơi những người này, thì các người đã không làm cho Ta.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Những kẻ đó sẽ đi vào sự trừng phạt vĩnh cửu, còn những người công chính thì vào sự sống đời đời.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Việc xảy ra khi Chúa Giê-xu đã kết thúc tất cả những lời đó, Ngài bảo các môn đồ mình: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Anh em biết rằng hai ngày nữa sẽ đến lễ Vượt Qua, và Con Người sẽ bị nộp để chịu đóng đinh trên cây thập tự.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Lúc ấy, những thầy tế lễ thượng phẩm và các trưởng lão trong dân chúng đã được tập hợp trong dinh của thầy thượng phẩm, tên là Cai-phe. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Họ cùng nhau bàn luận để họ có thể bằng mưu kế bắt giữ Chúa Giê-xu và giết Ngài đi. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Nhưng họ nói: “Không phải trong kỳ lễ, để bạo loạn không xảy ra giữa vòng dân chúng.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Bấy giờ, khi Chúa Giê-xu đã ở tại Bê-tha-ni, trong nhà Si-môn, người bị phong cùi, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />một phụ nữ đem chiếc bình ngọc chứa loại dầu thơm rất đắt tiền đến gần Ngài, và chị đổ lên đầu Ngài, đang khi ngồi ăn. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Nhưng sau khi thấy vậy, các môn đồ nổi giận, bảo: “Lãng phí thế này để làm chi? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Vì dầu này có thể bán được nhiều tiền và bố thí cho người nghèo.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Nhưng biết điều này, Chúa Giê-xu bảo họ: “Sao anh em làm khó người phụ nữ này? Vì chị đã làm một việc tốt cho thầy. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Bởi anh em luôn có người nghèo ở với mình, nhưng không phải anh em luôn có thầy. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Vì khi chị đổ dầu này lên người thầy, chị đã làm thế cho việc an táng thầy. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Quả thật, thầy nói với anh em, hễ nơi nào Phúc Âm này được giảng ra trên khắp thế giới, thì việc chị này đã làm cũng sẽ được nói đến trong sự ghi nhớ về chị.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Lúc đó, một trong mười hai sứ đồ, tên là Giu-đa Ích-ca-ri-ốt, sau khi đi đến cùng các thầy tế lễ cả, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />đã nói: “Các ông sẵn lòng trả tôi bao nhiêu, rồi tôi sẽ giao nộp người ấy cho các ông?” Thế là, họ cân cho hắn ba mươi siếc-lơ bạc. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Và từ thời điểm đó, hắn bắt đầu tìm cơ hội để có thể giao nộp Ngài.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Bấy giờ, vào ngày thứ nhất của lễ Bánh Không Men, các môn đồ đến gần Chúa Giê-xu, thưa: “Thầy muốn chúng tôi chuẩn bị cho thầy ăn lễ Vượt Qua ở đâu?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Rồi Ngài bảo: “Hãy đi vào thành, đến với một người nọ và nói với anh ta: ‘Thầy bảo: “Thời điểm của thầy thì đang cận kề; thầy cử hành lễ Vượt Qua tại nhà anh cùng với các môn đồ thầy.”’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Các môn đồ làm như Chúa Giê-xu chỉ dẫn họ, và họ chuẩn bị lễ Vượt Qua.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Bấy giờ, khi buổi tối đến, Ngài ngồi ăn cùng với mười hai sứ đồ. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Khi họ đang ăn, Ngài nói: “Quả thật, thầy nói với anh em rằng một người trong anh em sẽ phản thầy.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Vì buồn rầu quá đỗi, mỗi một người bắt đầu thưa cùng Ngài: “Chúa ôi, không phải là tôi chứ?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Nhưng để trả lời, Ngài nói: “Người đã nhúng tay mình vào trong đĩa chung với thầy, người đó sẽ phản thầy. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Tuy Con Người sẽ ra đi, theo như lời đã được chép về Ngài, nhưng khốn thay cho kẻ ấy, bởi hắn mà Con Người bị phản bội! Nếu kẻ ấy vốn đã không được sinh ra thì tốt hơn cho hắn.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Nhưng khi đáp lại, Giu-đa, kẻ phản Ngài, nói: “Ra-bi, lẽ nào là tôi?” Ngài nói với ông: “Anh đã tự nói rồi.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Bấy giờ, khi họ đang ăn, lúc lấy bánh và chúc tạ rồi, Chúa Giê-xu đã bẻ nó ra. Và sau khi trao cho các môn đồ, Ngài nói: “Hãy nhận lấy, ăn đi. Đây là thân thể của thầy.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Và lúc lấy chén và tạ ơn rồi, Ngài đã trao cho họ, bảo: “Hết thảy hãy uống nơi chén này. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Vì đây là huyết giao ước của thầy được đổ ra đối với nhiều người dành cho sự tha thứ tội lỗi. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Nhưng thầy nói với anh em kể từ thời điểm này, thầy chắc chắn sẽ không uống nơi nước nho này cho đến ngày ấy, là lúc mà thầy uống nước nho mới chung với anh em trong vương quốc của Cha thầy.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Sau khi hát thánh ca, họ ra đi đến núi Ô-liu. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Lúc đó, Chúa Giê-xu nói với họ: “Trong chính đêm nay, tất cả anh em sẽ bị vấp ngã nơi thầy, vì lời đã được chép:</para>
  <para style="q1" vid="MAT 26:31">‘Ta sẽ đánh kẻ chăn</para>
  <para style="q1" vid="MAT 26:31">rồi chiên của bầy sẽ bị tan tác.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Rồi sau khi thầy được khiến sống lại, thầy sẽ đi trước anh em đến Ga-li-lê.” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Nhưng đáp lại, Phi-e-rơ thưa với Ngài: “Dù tất cả sẽ bị vấp ngã nơi thầy, nhưng tôi sẽ không bao giờ bị vấp ngã.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Chúa Giê-xu nói với ông: “Quả thật, thầy nói với anh, rằng trong chính đêm nay, trước khi gà gáy, anh sẽ chối thầy ba lần.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Phi-e-rơ thưa với Ngài: “Thậm chí nếu buộc tôi phải chết với thầy, tôi chắc chắn sẽ không chối thầy.” Và tất cả các môn đồ cũng nói y như vậy.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Sau đó, Chúa Giê-xu đi cùng với họ đến một nơi được gọi là Ghết-sê-ma-nê, và Ngài bảo các môn đồ: “Hãy ngồi đây suốt lúc thầy đến đằng kia cầu nguyện.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Sau khi dẫn theo Phi-e-rơ và hai con trai của Xê-bê-đê, Ngài khởi sự đau buồn và phiền não. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Lúc đó, Ngài nói với họ: “Linh hồn thầy đang sầu muộn lắm cho đến chết. Hãy ở lại đây và tỉnh thức chung với thầy.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Khi đã đi xa thêm một chút, Ngài sấp mặt mình xuống, cầu nguyện và thưa: “Cha của con ơi, nếu điều này là có thể, xin cho chén này qua khỏi con. Dầu vậy, không như con muốn, mà là như Cha.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Rồi Ngài đến với các môn đồ và thấy họ đang ngủ, thì Ngài nói với Phi-e-rơ: “Vậy là, anh em chẳng thể tỉnh thức với thầy được một giờ sao? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Hãy tỉnh thức và cầu nguyện để anh em khỏi sa vào cám dỗ. Tuy tâm linh thì háo hức, mà xác thịt thì yếu đuối.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Một lần nữa, khi đi khỏi vào lần thứ hai, Ngài cầu nguyện, rằng: “Cha của con ơi, nếu chuyện này chẳng có thể qua đi, trừ phi con uống chén ấy, thì xin ý Cha được nên.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Sau khi đến lần nữa, Ngài thấy họ đang ngủ, vì mắt họ đã bị trĩu nặng. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Và một lần nữa, sau khi để họ lại rồi đi, Ngài cầu nguyện vào lần thứ ba, thưa cùng những lời như vậy nữa. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Sau đó, Ngài đến với các môn đồ và nói với họ: “Anh em còn đang ngủ và nghỉ ngơi sao? Nhìn kìa, giờ đến gần rồi, và Con Người đang bị nộp vào tay những kẻ tội lỗi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Hãy đứng dậy, chúng ta nên đi thôi. Xem này, kẻ phản thầy tiến đến rồi.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Khi Ngài vẫn còn đang nói, thì xem kìa, Giu-đa, một trong mười hai sứ đồ, đến, và chung với hắn là một đám người rất đông cùng gươm và gậy, từ chỗ những thầy tế lễ thượng phẩm và các trưởng lão trong dân chúng. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Bấy giờ, kẻ phản Ngài đã cho họ một dấu hiệu, rằng: “Người nào mà tôi hôn thì là người đó. Hãy bắt ông ấy.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Lập tức, sau khi đến gần Chúa Giê-xu, hắn nói: “Xin chào Ra-bi!” rồi hắn hôn Ngài. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Nhưng Chúa Giê-xu nói với hắn: “Anh bạn, vì điều này mà anh đến đây.” Kế tiếp, sau khi đến gần, họ tra tay trên Chúa Giê-xu và bắt giữ Ngài. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Và nhìn kìa, một trong những người đi với Chúa Giê-xu, khi vươn tay ra, đã rút gươm mình và chém tên đầy tớ của thầy tế lễ thượng phẩm, cắt đứt lỗ tai của anh này. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Lúc đó, Chúa Giê-xu bảo người ấy: “Hãy thu lại gươm của anh về chỗ của nó, vì hết thảy những ai cầm gươm sẽ chết bởi gươm. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Hay anh tưởng rằng thầy không có quyền kêu cầu Cha thầy, rồi Ngài sẽ phái đến ngay cho thầy hơn mười hai đạo binh thiên sứ hay sao? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Thế thì, làm sao những lời Kinh Thánh được ứng nghiệm, rằng chuyện này phải xảy ra như vậy?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Vào giờ đó, Chúa Giê-xu nói với đám đông: “Các ông đi ra cùng với gươm và gậy gộc để bắt tôi như chống lại một kẻ cướp sao? Hằng ngày, tôi ngồi giảng dạy trong đền thờ mà các ông đã chẳng bắt tôi. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Nhưng mọi việc này xảy ra để các ghi chép của những vị tiên có thể tri được ứng nghiệm.” Lúc đó, khi bỏ Ngài lại rồi, hết thảy các môn đồ đã chạy trốn.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Bấy giờ, những kẻ bắt Chúa Giê-xu đã dẫn Ngài đến cho thầy tế lễ thượng phẩm Cai-phe, là nơi mà những thầy dạy luật và các trưởng lão được tập hợp cùng nhau. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Còn Phi-e-rơ đi theo Ngài từ đằng xa cho đến sân của thầy cả thượng phẩm. Khi vào bên trong rồi, ông ngồi xuống chung với bọn lính canh để xem kết cục ra sao. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Bấy giờ, những thầy tế lễ thượng phẩm và toàn thể Hội Đồng đang tìm chứng dối chống lại Chúa Giê-xu, sao cho họ có thể kết án tử hình Ngài. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Và họ không tìm được gì, dù nhiều kẻ làm chứng dối đã đứng ra. Nhưng sau đó, hai người nọ tiến lên, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />đã nói: “Người này đã tuyên bố: ‘Tôi có thể phá hủy đền thờ của Thiên Chúa và xây dựng lại trong ba ngày.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Sau khi đứng dậy, thầy tế lễ thượng phẩm bảo Ngài: “Anh không trả lời sao? Những người này đang làm chứng chống lại anh chuyện gì thế kia?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Nhưng Chúa Giê-xu yên lặng. Thầy tế lễ thượng phẩm nói với Ngài: “Bởi Thiên Chúa hằng sống, tôi buộc anh để anh nói cho chúng tôi biết liệu anh có phải là Chúa Cứu Thế, Con Thiên Chúa, hay không?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Chúa Giê-xu nói cùng ông ta: “Chính ông đã tự nói như thế. Dầu vậy, tôi nói cho các ông biết, kể từ thời điểm này, các ông sẽ thấy Con Người ngồi ở bên phải của Đấng Quyền Năng, và ngự đến trên các đám mây trời.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Lúc này, thầy tế lễ thượng phẩm đã xé áo dài mình, bảo: “Hắn phạm thượng! Sao chúng ta còn cần nhân chứng nữa? Kia kìa, bây giờ các ông đã nghe lời phạm thượng ấy rồi. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Các ông nghĩ sao?” Rồi khi trả lời, họ nói: “Hắn thật là đáng chết.” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Sau đó, họ nhổ vào mặt Ngài, đánh đập Ngài, rồi tát Ngài, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />rằng: “Này Chúa Cứu Thế, nói tiên tri cho chúng tôi đi. Ai là kẻ đã đánh ông?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Bấy giờ, Phi-e-rơ đang ngồi trong sân bên ngoài, và một đầy tớ gái đến gần ông, nói: “Ông cũng ở chung với Giê-xu, người Ga-li-lê.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Nhưng ông chối trước mặt mọi người, rằng: “Tôi chẳng biết cô đang nói gì.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Rồi sau khi đi ra đến cổng, một đầy tớ gái khác đã nhìn thấy ông và nói với những người ở đó: “Gã này ở chung với Giê-xu, người Na-xa-rét.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Và ông lại chối cùng với một lời thề, rằng: “Tôi chẳng biết người đó!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Nhưng một lát sau, những người từng đứng đó, sau khi đến gần, đã nói với Phi-e-rơ: “Chắc chắn ông cũng ở trong số bọn họ, vì ngay cả cách nói của ông khiến cho ông lộ tẩy.” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Lúc ấy, ông bắt đầu rủa, và thề rằng: “Tôi chẳng biết người đó,” rồi tức thì, gà gáy. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Và Phi-e-rơ nhớ lại những lời của Chúa Giê-xu đã nói, rằng: “Trước khi gà gáy, anh sẽ chối thầy ba lần.” Rồi khi đã đi ra bên ngoài, ông khóc lóc cách đắng cay.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Bấy giờ, vào lúc sáng sớm, tất cả những thầy tế lễ thượng phẩm và các trưởng lão trong dân chúng đã bàn mưu tính kế chống lại Chúa Giê-xu để giết Ngài đi. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Khi đã trói Ngài lại, họ dẫn Ngài đi và giao nộp cho quan tổng đốc Phi-lát.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Lúc đó, sau khi Giu-đa, kẻ phản Ngài, thấy rằng Ngài đã bị kết án, thì vì hối hận, hắn đã trả lại ba mươi siếc-lơ bạc cho những thầy tế lễ thượng phẩm và các trưởng lão, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />nói rằng: “Tôi đã phạm tội vì phản nộp máu vô tội.” Nhưng họ bảo: “Liên quan gì đến chúng tôi? Anh tự chịu.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Và sau khi ném mấy siếc-lơ bạc vào trong đền thờ, hắn trở lui, và khi đi xa rồi, hắn thắt cổ tự tử. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Bấy giờ, sau khi lượm số siếc-lơ bạc lên, các thầy tế lễ thượng phẩm nói: “Để số bạc này vào kho của đền thờ là không phải lẽ vì ấy là cái giá của máu.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Nhưng khi tiến hành bàn bạc rồi, họ đã mua cánh đồng của người thợ gốm bằng số bạc ấy dành cho việc chôn cất các khách lạ. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Vì thế, cánh đồng đó được gọi là “Ruộng Huyết” cho đến ngày nay. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Thế là, điều được tuyên bố bởi tiên tri Giê-rê-mi đã được ứng nghiệm, rằng: “Họ lấy ba mươi siếc-lơ bạc, là giá của người được định, là người mà đã được tính giá từ nơi con cái Y-sơ-ra-ên, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />và họ đã đưa số bạc ấy để lấy cánh đồng của thợ gốm, y như Chúa đã chỉ thị ta.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Bấy giờ, Chúa Giê-xu đứng trước mặt quan tổng đốc, và viên quan ấy thẩm vấn Ngài, rằng: “Phải chăng anh là Vua dân Do Thái?” Rồi Chúa Giê-xu nói với ông ta: “Ông đang nói đấy.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Và trong khi Ngài bị cáo tội bởi những thầy tế lễ thượng phẩm và các trưởng lão, thì Ngài chẳng đáp lại điều gì. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Kế đến, Phi-lát nói cùng Ngài: “Anh không nghe biết bao nhiêu điều họ đang làm chứng chống lại anh sao?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Và Ngài đã không trả lời ông ta, thậm chí bằng một lời cũng không, đến nỗi quan tổng đốc thấy lạ lùng lắm. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Bấy giờ, vào dịp lễ, quan tổng đốc vốn có thông lệ phóng thích cho dân chúng một phạm nhân mà họ chọn lựa. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Mặt khác, trong thời điểm đó, người ta đang giam một tên tù khét tiếng được gọi là Ba-ra-ba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Vậy, sau khi họ được tập hợp, Phi-lát nói với họ: “Các vị muốn ta thả ai cho các vị? Ba-ra-ba, hay Giê-xu, người được gọi là Chúa Cứu Thế?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Vì ông vốn biết rằng họ đã giao nộp Ngài cho ông bởi lòng đố kỵ. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Bấy giờ, trong lúc ông đang ngồi trên ghế xử án, vợ của ông đã sai gửi lời nhắn đến ông, rằng: “Nguyện chẳng chuyện gì xảy đến cho anh và cho người công chính đó. Vì hôm nay, em dày vò quá đỗi bởi một giấc mơ về người này.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Còn những thầy tế lễ thượng phẩm và các trưởng lão thuyết phục dân chúng để họ yêu cầu thả Ba-ra-ba mà xử tử Chúa Giê-xu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Nhưng để đáp lại, quan tổng đốc nói với họ: “Các vị muốn tôi thả ai trong hai người này cho các vị?” Rồi họ bảo: “Ba-ra-ba.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-lát nói với họ: “Vậy, tôi cần làm gì với Giê-xu, người được gọi là Chúa Cứu Thế?” Hết thảy bọn họ đáp: “Hắn phải bị đóng đinh trên cây thập tự.” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Nhưng ông nói: “Vì điều ác nào mà anh ấy đã phạm?” Tuy nhiên, họ càng la hét lớn hơn, rằng: “Hắn phải bị đóng đinh trên cây thập tự.” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Bấy giờ, Phi-lát, sau khi thấy rằng mình không giúp được gì, nhưng thay vào đó, một cuộc bạo loạn đang hình thành, thì lúc cho lấy nước rồi, ông đã rửa tay mình trước mặt dân chúng, nói: “Tôi vô tội nơi máu của người này. Các vị tự chịu.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Và khi đáp lại, hết thảy dân chúng nói: “Máu của hắn ở trên chúng tôi và trên con cháu chúng tôi.” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Sau đó, ông ta thả Ba-ra-ba cho họ, rồi khi đã cho đánh đòn Chúa Giê-xu, ông cho giải Ngài đi để chịu đóng đinh trên cây thập tự.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Lúc ấy, sau khi đem Chúa Giê-xu vào trong dinh tổng đốc, những binh lính của quan tổng đốc đã tập hợp lại trước mặt Ngài toàn bộ trung đội. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Sau khi lột sạch Ngài, chúng khoác một cái áo choàng màu đỏ tươi lên Ngài. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Lúc bện một cái mão bằng gai rồi, chúng đặt lên đầu Ngài, cùng cây sậy vào tay phải Ngài, và sau khi quỳ xuống trước mặt Ngài, chúng nhạo báng Ngài, rằng: “Kính lạy Vua dân Do Thái!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Rồi sau khi khạc nhổ vào Ngài, chúng lấy cây sậy và cứ đánh lên đầu Ngài. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Khi chúng nhạo báng Ngài xong, chúng cởi áo choàng ra và mặc vào cho Ngài áo của Ngài, rồi lôi Ngài đi để đóng đinh trên cây thập tự.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Bấy giờ, đang khi đi ra, chúng thấy một người từ Sy-ren, tên Si-môn, mà chúng bắt ép để ông vác thập tự giá của Ngài. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Sau khi đi đến một nơi được gọi là Gô-gô-tha, mà nơi ấy nghĩa là “Chỗ Sọ,” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />chúng cho Ngài uống rượu được pha với mật đắng. Khi đã nếm thử, thì Ngài không chịu uống. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Bấy giờ, lúc đóng đinh Ngài trên cây thập tự rồi, chúng chia nhau bộ áo của Ngài bằng cách bắt thăm, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />và chúng canh giữ Ngài, khi ngồi tại đó. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Phía trên đầu Ngài, chúng để thêm cáo trạng của Ngài, được viết như sau: “Đây là Giê-xu, Vua dân Do Thái.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Lúc đó, có hai tên cướp bị đóng đinh với Ngài, một tên ở bên phải và một tên ở bên trái. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Những kẻ đi ngang qua sỉ nhục Ngài, lắc đầu mình <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />và nói: “Cái tên hủy phá đền thờ và xây lại trong ba ngày kia, hãy tự cứu mình đi! Nếu mày là Con Thiên Chúa, thì hãy xuống khỏi cây thập tự!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Cũng một thể ấy, những thầy tế lễ thượng phẩm, cùng với những thầy dạy luật và các trưởng lão, khi nhạo báng Ngài, đã nói: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Hắn đã cứu những người khác; hắn thì không có khả năng tự cứu mình. Hắn là Vua của Y-sơ-ra-ên. Bây giờ, hắn phải xuống khỏi cây thập tự, thì chúng ta sẽ tin nơi hắn. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Hắn tin cậy nơi Thiên Chúa; giờ thì hãy để Ngài giải cứu hắn nếu Ngài muốn hắn. Vì hắn đã nói rằng: ‘Tôi là Con Thiên Chúa.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Mặt khác, chính mấy tên cướp, là những kẻ bị đóng đinh với Ngài, bọn họ cũng sỉ nhục Ngài.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Bấy giờ, từ giờ thứ sáu, bóng tối xuất hiện trên khắp cả xứ cho đến giờ thứ chín. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Rồi khoảng giờ thứ chín, Chúa Giê-xu kêu một tiếng lớn, rằng: “Ê-li, Ê-li, la-ma sa-bách-tha-ni?” nghĩa là “Thiên Chúa tôi ôi, Thiên Chúa tôi ôi, sao Ngài lìa bỏ tôi?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Nhưng sau khi nghe vậy, mấy kẻ vốn đứng đó nói rằng: “Hắn kêu Ê-li.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Lập tức, một người trong số họ, sau khi chạy đi và lấy miếng bọt biển, vừa thấm đầy giấm vừa gắn lên cây sậy, đã đưa cho Ngài uống. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Nhưng những kẻ còn lại bảo: “Hãy mặc kệ hắn. Chúng ta xem liệu Ê-li có đến cứu hắn không.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Thế rồi, sau khi lại kêu lên một tiếng lớn, Chúa Giê-xu trút linh hồn. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Và nhìn kìa, bức màn của đền thờ bị xé làm đôi từ trên xuống dưới, còn đất bị rúng động, và đá lớn bị vỡ ra. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Nhiều mồ mả bị mở toang và nhiều thây của các người thánh đã ngủ được khiến sống lại. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Và lúc ra khỏi mồ sau sự phục sinh của Ngài, họ đã vào trong thành thánh và xuất hiện cho nhiều người. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Bấy giờ, sau khi thấy động đất và những việc xảy ra, viên đội trưởng cùng những kẻ đang canh giữ Chúa Giê-xu chung với ông đã bị khiếp đảm tột độ, nói rằng: “Quả thật, người này là Con Thiên Chúa.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Còn có nhiều phụ nữ tại đó, nhìn chăm chăm từ xa, là những người đã đi theo Chúa Giê-xu, phục vụ Ngài từ xứ Ga-li-lê. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Trong số họ có Ma-ri Ma-đơ-len, Ma-ri mẹ Gia-cơ và Giô-sép, cùng mẹ của các con trai Xê-bê-đê.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Bấy giờ, khi đã đến buổi chiều tối, một người giàu đã đến từ A-ri-ma-thê, tên là Giô-sép, mà bản thân ông cũng chịu làm môn đồ theo Chúa Giê-xu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Sau khi đến gặp Phi-lát, ông xin xác Chúa Giê-xu. Lúc đó, Phi-lát ra lệnh để xác được giao cho ông. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Lúc đã lấy xác, Giô-sép quấn xác ấy lại trong vải lanh sạch, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />rồi đặt xác vào ngôi mộ mới của chính mình mà ông đã đục trong hang đá. Khi lăn một hòn đá lớn chặn cửa mộ rồi, ông rời đi. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Bấy giờ, Ma-ri Ma-đơ-len và một Ma-ri khác ở đó, ngồi đối diện với ngôi mộ.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Rồi ngày hôm sau, tức là sau ngày Sắm Sửa, các thầy tế lễ thượng phẩm và những người Pha-ri-si đã được tập hợp lại trước Phi-lát, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />thưa rằng: “Bẩm quan, chúng tôi nhớ rằng lúc còn sống, tên lừa dối kia đã nói: ‘Sau ba ngày, thì tôi được khiến sống lại.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Do đó, xin ra lệnh để ngôi mộ được đảm bảo an toàn cho đến ngày thứ ba. Bằng không, các môn đồ của hắn đến rồi, có thể trộm xác hắn, và nói với dân chúng: ‘Ngài đã được khiến sống lại từ cõi chết,’ thì sự lừa dối lúc sau sẽ còn tồi tệ hơn lúc đầu.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Thế rồi Phi-lát nói với họ: “Các ông có lính canh. Đi đi, phải đảm bảo an toàn như các ông biết.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Rồi sau khi đi, niêm phong tảng đá cùng với lính canh, họ đảm bảo ngôi mộ an toàn.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Bấy giờ, sau ngày Sa-bát, lúc bình minh ngày thứ nhất trong tuần đang đến, Ma-ri Ma-đơ-len và một Ma-ri khác đến thăm mộ. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Xem kìa, một cơn động đất lớn đã xảy ra, vì một thiên sứ của Chúa, sau khi từ trời giáng xuống và đến gần, đã lăn tảng đá rồi ngồi trên đó. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Lúc ấy, diện mạo của vị ấy thì giống như chớp, còn áo của người thì trắng như tuyết. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Thế rồi, do nơi kinh hoảng vì vị ấy, bọn lính canh bị chấn động và trở nên như người chết. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Nhưng khi mở lời, thiên sứ nói với những người phụ nữ: “Các chị đừng sợ, vì tôi biết rằng các chị tìm Giê-xu, Đấng đã bị đóng đinh. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Ngài không ở đây đâu, vì Ngài được khiến sống lại rồi, đúng y như Ngài đã phán. Đến đây nào, hãy nhìn xem chỗ mà Ngài đã nằm. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Rồi sau khi nhanh chóng lên đường, hãy thuật cho các môn đồ Ngài rằng: ‘Ngài đã được khiến sống lại từ cõi chết. Và nhìn kìa, Ngài đang đi trước anh chị em đến Ga-li-lê. Tại đó, anh chị em sẽ gặp Ngài.’ Xem này, tôi đã nói cho các chị biết rồi đó.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Và lúc nhanh chóng rời khỏi ngôi mộ với sự hoảng sợ lẫn niềm vui quá đỗi, họ đã chạy đi để thông báo cho các môn đồ của Ngài. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Nhìn này, Chúa Giê-xu gặp họ, nói: “Chào các chị!” Rồi sau khi đến gần, họ ôm chân Ngài và thờ lạy Ngài. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Kế tiếp, Chúa Giê-xu nói với họ: “Đừng sợ. Hãy đi, thông báo cho các anh em của thầy để họ có thể lên đường đến Ga-li-lê, và tại đó, họ sẽ gặp thầy.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Bấy giờ, đang lúc họ đi đường, xem này, vài kẻ trong số bọn lính canh, sau khi vào trong thành, đã thuật lại cho những thầy tế lễ thượng phẩm mọi việc đã xảy ra. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Và lúc đã được tập hợp cùng với các trưởng lão, đồng thời tiến hành bàn bạc rồi, họ đã cho bọn lính một số tiền đáng kể, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />bảo rằng: “Hãy nói: ‘Sau khi đến vào ban đêm, các môn đồ của hắn đã trộm xác hắn trong lúc chúng tôi đang ngủ.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Và nếu tin này được báo cho quan tổng đốc, chúng tôi sẽ thuyết phục ông ấy và làm cho các anh khỏi rắc rối.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Thế rồi, sau khi nhận tiền, bọn đó làm như đã được dặn bảo. Tin này được đồn ra rộng rãi giữa dân Do Thái, thậm chí cho đến ngày nay.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Bấy giờ, mười một môn đồ đã đi đến Ga-li-lê, tới ngọn núi mà Chúa Giê-xu đã chỉ định cho họ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Và khi đã gặp Ngài, họ thờ phượng Ngài, nhưng vài người nghi sợ. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Sau khi tiến đến gần, Chúa Giê-xu trò chuyện với họ, rằng: “Mọi thẩm quyền trên trời và dưới đất đã được trao cho thầy. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Vì vậy, anh em hãy đi môn đồ hóa hết thảy các dân, làm báp-têm cho họ trong danh Cha, Con và Chúa Thánh Linh; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />dạy dỗ họ để vâng giữ mọi điều mà thầy đã truyền cho anh em. Và nhìn này, thầy ở cùng với anh em mọi ngày cho đến tận thế.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>