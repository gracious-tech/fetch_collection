  <book code="OBA" style="id">EN_VLT vi_Vietnamese_ltr Thu Jul 18 2024 15:04:36 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Obadiah</para>
  <para style="toc1">Sách Áp-đia</para>
  <para style="toc2">Áp-đia</para>
  <para style="toc3">Oba</para>
  <para style="mt">Áp-đia</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Khải tượng của Áp-đia: Chúa của tôi, Chúa Hằng Hữu phán thế nầy về Ê-đôm.</para>
  <para style="q1" vid="OBA 1:1">Chúng ta đã nghe lời tuyên bố từ Chúa Hằng Hữu, và một sứ giả đã được sai đến giữa các dân tộc:</para>
  <para style="q2" vid="OBA 1:1">Hãy trỗi dậy! Và chúng ta hãy dấy lên cuộc chiến chống lại nó.<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />Xem này, Ta sắp làm cho ngươi trở nên bé nhỏ giữa các dân tộc,</para>
  <para style="q2" vid="OBA 1:2">ngươi vô cùng bị khinh thường.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Sự kiêu ngạo của lòng ngươi đã dối gạt ngươi: là kẻ sống trong các khe núi đá, cao ngạo về chỗ trú ngụ của mình;</para>
  <para style="q2" vid="OBA 1:3">kẻ nói trong lòng mình rằng: “Ai sẽ lôi ta xuống đất?”<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Dù ngươi khiến mình như đại bàng trên cao,</para>
  <para style="q1" vid="OBA 1:4">dù tổ của ngươi nằm giữa các vì sao,</para>
  <para style="q2" vid="OBA 1:4">chính từ nơi đó, Ta sẽ kéo ngươi ngã nhào: Đây là lời tuyên phán của Chúa Hằng Hữu.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />Nếu bọn trộm và lũ cướp</para>
  <para style="q1" vid="OBA 1:5">ban đêm đến chỗ ngươi (ngươi sẽ bị tiêu diệt là thể nào!), chẳng lẽ chúng cướp chỉ vừa đủ cho mình?</para>
  <para style="q2" vid="OBA 1:5">Nếu những kẻ hái nho đến chỗ ngươi, chẳng lẽ họ bỏ sót lại một ít cho mót?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Thể nào mà Ê-sau bị cướp bóc,</para>
  <para style="q2" vid="OBA 1:6">châu báu bí mật nó bị lục tung!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Tất cả những kẻ có hiệp ước với ngươi sẽ đuổi ngươi ra tận biên cương.</para>
  <para style="q1" vid="OBA 1:7">Những kẻ thân thiện với ngươi dối gạt ngươi và áp đảo chống nghịch ngươi.</para>
  <para style="q2" vid="OBA 1:7">Những kẻ dùng bánh của ngươi sẽ đặt bẫy bên dưới ngươi. Chẳng hề có sự hiểu biết nơi nó.<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />(Đây là lời tuyên phán của Chúa Hằng Hữu) Ta há sẽ không tiêu diệt trong ngày đó</para>
  <para style="q2" vid="OBA 1:8">những nhà thông thái trong xứ Ê-đôm,</para>
  <para style="q2" vid="OBA 1:8">và các nhà hiền triết trên núi của Ê-sau?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Ôi Thê-man, rồi các dũng sĩ của ngươi sẽ hoang mang sợ hãi,</para>
  <para style="q2" vid="OBA 1:9">nên người ta sẽ bị đánh hạ trên núi Ê-sau bởi cuộc thảm sát.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />Vì cớ sự tàn bạo đối với anh em ngươi là Gia-cốp, sự sỉ nhục sẽ bao trùm ngươi,</para>
  <para style="q2" vid="OBA 1:10">và ngươi sẽ bị hủy diệt cho đến đời đời.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Vào ngày ngươi đứng bên phe đối nghịch,</para>
  <para style="q1" vid="OBA 1:11">vào ngày bọn xa lạ cướp đoạt tài sản của nó,</para>
  <para style="q2" vid="OBA 1:11">và quân ngoại xâm tiến vào cổng thành của nó và khi chúng rút thăm về thành Giê-ru-sa-lem,</para>
  <para style="q2" vid="OBA 1:11">ngươi cũng như một bọn với chúng.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />Thế nhưng, lẽ ra ngươi không nên chăm xem ngày anh em mình, là ngày bất hạnh của nó.</para>
  <para style="q1" vid="OBA 1:12">Lẽ ra ngươi không nên vui mừng về các con cháu Giu-đa trong ngày họ bị hủy phá.</para>
  <para style="q2" vid="OBA 1:12">Và lẽ ra ngươi không nên để miệng mình khoe khoang khoác lác trong ngày hoạn nạn ấy.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Lẽ ra ngươi không nên bước vào cổng thành dân Ta trong ngày tai họa của họ.</para>
  <para style="q1" vid="OBA 1:13">Đúng, chính ngươi! — Lẽ ra ngươi không nên chăm xem điều tồi tệ nó trong ngày thảm họa của nó.</para>
  <para style="q2" vid="OBA 1:13">Và đàn bà của ngươi lẽ ra không nên chiếm đoạt của cải nó trong ngày tai họa của nó.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Lẽ ra ngươi không nên đứng tại các giao lộ để chặn giết những người trốn chạy của nó.</para>
  <para style="q2" vid="OBA 1:14">Lẽ ra ngươi không nên giao nộp những kẻ sống sót của nó trong ngày khốn cùng.<verse eid="OBA 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />Vì ngày của Chúa Hằng Hữu đến gần trên mọi dân tộc.</para>
  <para style="q2" vid="OBA 1:15">Dựa theo việc nào ngươi đã làm, việc ấy sẽ được làm cho ngươi;</para>
  <para style="q2" vid="OBA 1:15">sự báo trả ngươi sẽ trút lại trên đầu ngươi.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Vì theo cách mà ngươi đã uống trên núi thánh Ta, hết thảy các dân tộc sẽ uống không ngừng.</para>
  <para style="q2" vid="OBA 1:16">Và chúng sẽ uống, và sẽ nuốt, rồi sẽ trở nên như thể chúng chưa bao giờ tồn tại.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />Nhưng trên núi Si-ôn sẽ còn một lối thoát,</para>
  <para style="q1" vid="OBA 1:17">cũng sẽ có sự thánh khiết,</para>
  <para style="q2" vid="OBA 1:17">rồi nhà Gia-cốp sẽ sở hữu những sản nghiệp mình.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Và nhà Gia-cốp sẽ trở nên đám lửa hừng, và nhà Giô-sép là ngọn lửa, còn nhà Ê-sau như rơm rạ. Rồi họ sẽ đốt cháy chúng và thiêu hủy chúng.</para>
  <para style="q2" vid="OBA 1:18">Rồi sẽ không còn một kẻ sống sót nơi nhà Ê-sau,</para>
  <para style="q2" vid="OBA 1:18">vì Chúa Hằng Hữu đã phán như vậy.<verse eid="OBA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />Và dân Nê-ghép sẽ chiếm cứ núi Ê-sau,</para>
  <para style="q1" vid="OBA 1:19">còn dân Sơ-phê-la chiếm đất người Phi-li-tin.</para>
  <para style="q1" vid="OBA 1:19">Và họ sẽ chiếm hữu cánh đồng Ép-ra-im và cánh đồng Sa-ma-ri,</para>
  <para style="q2" vid="OBA 1:19">còn Bên-gia-min sẽ chiếm xứ Ga-la-át.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Và đoàn quân lưu vong này của con cháu Y-sơ-ra-ên, là những người sẽ chiếm hữu đất dân Ca-na-an cho đến tận Xa-rê-phát,</para>
  <para style="q1" vid="OBA 1:20">và những người bị lưu đày của Giê-ru-sa-lem mà ở tại Sê-pha-rát:</para>
  <para style="q2" vid="OBA 1:20">họ sẽ chiếm cứ các thành của Nê-ghép.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Những người giải cứu sẽ tiến lên núi Si-ôn để xét xử núi Ê-sau,</para>
  <para style="q2" vid="OBA 1:21">và vương quốc sẽ thuộc về Chúa Hằng Hữu.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>