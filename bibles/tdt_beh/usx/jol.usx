<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- ATG BSA Training 1</book>
  <para style="h">Joel</para>
  <para style="toc3">Joel</para>
  <para style="toc2">Joel</para>
  <para style="toc1">Joel</para>
  <para style="mt1">Joel</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="s">Povu Israel halerik tanba gafanhotu haan mohu ai haan iha toos</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />NAI Maromak nia liafuan tuun ba Petuel nia oan Joel dehan nunee:<verse eid="JOL 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Imi katuas lia nain sira, rona mai;</para>
  <para style="q2" vid="JOL 1:2">ema hotu nebee moris iha rai nee, see tilun mai.</para>
  <para style="q1" vid="JOL 1:2">Buat hanesan nee akontese ona iha imi nia moris ka?</para>
  <para style="q2" vid="JOL 1:2">Buat hanesan nee mosu ona iha imi nia bei-ala sira nia tempu ka?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Konta buat sira nee ba imi nia oan sira;</para>
  <para style="q2" vid="JOL 1:3">sira tenki konta fali ba sira nia oan,</para>
  <para style="q2" vid="JOL 1:3">no sira nia oan konta tutan ba jerasaun tuir mai.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Saida mak gafanhotu grupu primeiru haan la hotu iha toos laran,</para>
  <para style="q2" vid="JOL 1:4">gafanhotu bo-boot mai haan tiha;</para>
  <para style="q1" vid="JOL 1:4">saida mak gafanhotu boot sira haan la hotu,</para>
  <para style="q2" vid="JOL 1:4">gafanhotu lotuk sira mai haan tiha;</para>
  <para style="q1" vid="JOL 1:4">saida mak gafanhotu lotuk sira haan la hotu,</para>
  <para style="q2" vid="JOL 1:4">gafanhotu sel-seluk mai haan moos tiha.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Imi lanu-teen sira, hadeer ona, tanis ona ba!</para>
  <para style="q2" vid="JOL 1:5">Hemu tua door sira, halerik ba!</para>
  <para style="q1" vid="JOL 1:5">Halerik husu tua foun,</para>
  <para style="q2" vid="JOL 1:5">tanba ema hadau ona husi imi nia ibun.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Nasaun ida mai ataka ona hau nia rain.</para>
  <para style="q2" vid="JOL 1:6">Sira nee forsa boot, sura la bele;</para>
  <para style="q1" vid="JOL 1:6">sira nia nehan hanesan liaun nia nehan;</para>
  <para style="q2" vid="JOL 1:6">sira nia nehan kroat hanesan liaun inan nian.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Nasaun nee estraga tiha ona hau nia toos uvas;</para>
  <para style="q2" vid="JOL 1:7">sira halo rahun tiha hau nia ai figeira.</para>
  <para style="q1" vid="JOL 1:7">Sira loke ai figeira nia kulit hodi soe tiha,</para>
  <para style="q2" vid="JOL 1:7">halo ai sanak bo-boot sai mutin ona.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Imi tanis lelir ba, hanesan feto virjen nebee hatais lutu</para>
  <para style="q2" vid="JOL 1:8">hodi tanis ba nia noivu nia mate isin.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Ema la lori tan oferta trigu ho tua</para>
  <para style="q2" vid="JOL 1:9">ba iha NAI Maromak nia uma.</para>
  <para style="q1" vid="JOL 1:9">Tanba nee nai lulik sira halerik;</para>
  <para style="q2" vid="JOL 1:9">ema nebee serbi NAI Maromak laran susar.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Toos rahun tiha ona;</para>
  <para style="q2" vid="JOL 1:10">rai maran dekor tiha;</para>
  <para style="q1" vid="JOL 1:10">trigu iha toos laran estraga tiha ona;</para>
  <para style="q2" vid="JOL 1:10">tua foun sai maran tiha;</para>
  <para style="q2" vid="JOL 1:10">mina azeite mos la iha tan.<verse eid="JOL 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Imi toos nain sira, halerik ba!</para>
  <para style="q2" vid="JOL 1:11">Ema nebee servisu iha toos uvas nian, tanis ba!</para>
  <para style="q1" vid="JOL 1:11">Tanba trigu iha toos mohu tiha ona;</para>
  <para style="q2" vid="JOL 1:11">rezultadu toos estraga tiha ona.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Uvas huun maran tiha ona;</para>
  <para style="q2" vid="JOL 1:12">ai figeira namlaik hotu;</para>
  <para style="q1" vid="JOL 1:12">rumaun, ai tamara, masaan huun,</para>
  <para style="q2" vid="JOL 1:12">ai huun iha toos laran, hotu-hotu maran;</para>
  <para style="q2" vid="JOL 1:12">povu nia ksolok mohu ona.<verse eid="JOL 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Imi nai lulik sira, hatais lutu hodi tanis ho laran susar ba;</para>
  <para style="q2" vid="JOL 1:13">imi nebee serbi iha altar oin, tanis halerik ba.</para>
  <para style="q1" vid="JOL 1:13">Imi nebee serbi hau nia Maromak,</para>
  <para style="q2" vid="JOL 1:13">hatais lutu hodi mai halerik kalan tomak.</para>
  <para style="q1" vid="JOL 1:13">Tanba iha imi nia Maromak nia uma</para>
  <para style="q2" vid="JOL 1:13">la iha tan oferta trigu ho oferta tua.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Haruka ema hotu-hotu halo jejun iha Maromak nia oin;</para>
  <para style="q2" vid="JOL 1:14">halibur povu hamutuk iha Nia prezensa.</para>
  <para style="q1" vid="JOL 1:14">Bolu hamutuk katuas lia nain sira</para>
  <para style="q2" vid="JOL 1:14">ho ema hotu nebee moris iha rai nee</para>
  <para style="q1" vid="JOL 1:14">baa iha NAI imi nia Maromak nia uma</para>
  <para style="q2" vid="JOL 1:14">hodi husu tulun ba NAI.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />Ai! Susar ona,</para>
  <para style="q2" vid="JOL 1:15">tanba NAI nia loron besik ona;</para>
  <para style="q2" vid="JOL 1:15">iha loron nee mak Maromak Kbiit Nain hatuun dezastre.<verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Loos duni, ita nia ai haan hasai tiha ona husi ita nia oin;</para>
  <para style="q2" vid="JOL 1:16">ksolok ho kontenti lakon tiha ona husi ita nia Maromak nia uma.<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Fini nebee kuda iha rai la tubun;</para>
  <para style="q2" vid="JOL 1:17">armazen sira abandona too naksobu tiha,</para>
  <para style="q2" vid="JOL 1:17">tanba rezultadu toos la iha.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Animal hakiak sira halerik hela;</para>
  <para style="q2" vid="JOL 1:18">karau sira lao tuun-sae,</para>
  <para style="q1" vid="JOL 1:18">tanba la iha ona duut ba sira;</para>
  <para style="q2" vid="JOL 1:18">bibi malae sira mos terus.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />NAI Maromak, hau halerik husu tulun ba Ita Boot,</para>
  <para style="q2" vid="JOL 1:19">tanba ahi haan hotu ona duut iha rai fuik;</para>
  <para style="q2" vid="JOL 1:19">ahi lakan haan mohu tiha ona ai huun hotu-hotu iha fat-fatin.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Animal fuik sira mos halerik ba Ita Boot,</para>
  <para style="q2" vid="JOL 1:20">tanba bee mota maran hotu ona,</para>
  <para style="q2" vid="JOL 1:20">no ahi haan hotu ona duut iha rai fuik.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">NAI Maromak haruka gafanhotu estraga rai hanesan fali tropas</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Huu bibi dikur iha foho Siaun;</para>
  <para style="q2" vid="JOL 2:1">halo alarme lian iha Hau nia foho santu.</para>
  <para style="q1" vid="JOL 2:1">Ema hotu iha rai nee nakdedar ba,</para>
  <para style="q2" vid="JOL 2:1">tanba NAI nia loron besik dadauk ona;</para>
  <para style="q2" vid="JOL 2:1">loron nee besik loos ona.<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />Loron nee loron nakukun boot nian;</para>
  <para style="q2" vid="JOL 2:2">kalohan metan mahar taka metin rai.</para>
  <para style="q1" vid="JOL 2:2">Tropas lubuk boot nebee forsa makaas nadodon mai,</para>
  <para style="q2" vid="JOL 2:2">hanesan nakukun falun dadauk foho hotu.</para>
  <para style="q1" vid="JOL 2:2">Buat hanesan nee nunka akontese iha tempu uluk,</para>
  <para style="q2" vid="JOL 2:2">no sei la akontese tan iha tempu oin mai.<verse eid="JOL 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Gafanhotu sira nee haan mohu rai hanesan ahi;</para>
  <para style="q2" vid="JOL 2:3">iha sira nia kotuk ahi lakan sae makaas.</para>
  <para style="q1" vid="JOL 2:3">Rai iha oin matak hanesan toos Eden,</para>
  <para style="q2" vid="JOL 2:3">maibee iha kotuk rai fuik maran,</para>
  <para style="q2" vid="JOL 2:3">buat ida mos la moris.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Tropas sira nee haree ba hanesan kuda;</para>
  <para style="q2" vid="JOL 2:4">sira halai mai hanesan kuda funu nian.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Sira halo lian barulhu hanesan kuda kareta funu nian;</para>
  <para style="q2" vid="JOL 2:5">sira haksoit liu foho tutun sira;</para>
  <para style="q1" vid="JOL 2:5">sira halo lian tarutu hanesan ahi lakan boot nebee haan duut maran;</para>
  <para style="q2" vid="JOL 2:5">sira hanesan militar bar-barak nebee prontu atu baa funu.<verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Povu nebee haree, tauk too nakdedar;</para>
  <para style="q2" vid="JOL 2:6">ida-idak nia oin sai kamutis tiha.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Tropas sira halai mai hanesan funu nain;</para>
  <para style="q2" vid="JOL 2:7">sira sae moru hanesan soldadu.</para>
  <para style="q1" vid="JOL 2:7">Sira hotu-hotu marxa tuir formatura,</para>
  <para style="q2" vid="JOL 2:7">la lao sees husi sira nia dalan.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Sira avansa la dudu malu;</para>
  <para style="q2" vid="JOL 2:8">sira marxa nafatin ida-idak tuir nia dalan.</para>
  <para style="q1" vid="JOL 2:8">Sira hasoru tropas sidade nia diman, sira baa oin nafatin,</para>
  <para style="q2" vid="JOL 2:8">la troka sira nia formatura.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Sira halai tama ba sidade laran;</para>
  <para style="q2" vid="JOL 2:9">sira halai tuir moru leten.</para>
  <para style="q1" vid="JOL 2:9">Sira sae ba uma laran;</para>
  <para style="q2" vid="JOL 2:9">sira tama liu husi janela hanesan ema naok-teen.<verse eid="JOL 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />Rai nakdoko iha sira nia oin;</para>
  <para style="q2" vid="JOL 2:10">lalehan nakdedar.</para>
  <para style="q1" vid="JOL 2:10">Loro matan ho fulan sai nakukun tiha;</para>
  <para style="q2" vid="JOL 2:10">fitun sira la foo naroman tan.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />NAI Maromak nia lian sai mai hanesan rai tarutu iha Nia militar sira nia oin;</para>
  <para style="q2" vid="JOL 2:11">Nia tropas barak teb-tebes, sura la bele.</para>
  <para style="q1" vid="JOL 2:11">Nia tropas sira nee makaas teb-tebes;</para>
  <para style="q2" vid="JOL 2:11">sira halo tuir Nia orden.</para>
  <para style="q1" vid="JOL 2:11">NAI nia loron nee boot teb-tebes;</para>
  <para style="q2" vid="JOL 2:11">loron nee halo ema tauk nakdedar, see mak bele aguenta?<verse eid="JOL 2:11" /></para>
  <para style="s">NAI Maromak haruka Nia povu arepende</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />NAI Maromak hatete, “Agora tempu sei iha;</para>
  <para style="q2" vid="JOL 2:12">fila fali mai Hau ho laran tomak,</para>
  <para style="q2" vid="JOL 2:12">ho jejun, tanis halerik ho laran susar.<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Lalika lees imi nia hena,</para>
  <para style="q2" vid="JOL 2:13">maibee lees imi nia fuan.</para>
  <para style="q1" vid="JOL 2:13">Fila fali ba NAI imi nia Maromak,</para>
  <para style="q2" vid="JOL 2:13">tanba Nia laran diak no laran luak,</para>
  <para style="q1" vid="JOL 2:13">Pasiensia Nain no nakonu ho domin rohan-laek;</para>
  <para style="q2" vid="JOL 2:13">Nia prontu dada fila fali dezastre nebee mak Nia atu foo.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />See mak hatene, keta halo be Nia laran nakfilak,</para>
  <para style="q2" vid="JOL 2:14">Nia dada fali Nia kastigu</para>
  <para style="q1" vid="JOL 2:14">hodi husik hela bensaun ba imi;</para>
  <para style="q2" vid="JOL 2:14">karik NAI imi nia Maromak hatuun trigu ho tua</para>
  <para style="q2" vid="JOL 2:14">para imi bele oferese fali ba Nia.<verse eid="JOL 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Huu bibi dikur iha foho Siaun;</para>
  <para style="q2" vid="JOL 2:15">haruka ema hotu-hotu halo jejun iha Maromak nia oin;</para>
  <para style="q2" vid="JOL 2:15">halibur povu hamutuk iha Nia prezensa.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Bolu hamutuk povu tomak;</para>
  <para style="q2" vid="JOL 2:16">halo sira sai moos atu sira bele mai iha Hau nia prezensa.</para>
  <para style="q1" vid="JOL 2:16">Halibur katuas lia nain sira;</para>
  <para style="q2" vid="JOL 2:16">halibur labarik sira too kiik oan sira nebee sei susu hela.</para>
  <para style="q1" vid="JOL 2:16">Haruka noivu sai husi nia kuartu laran;</para>
  <para style="q2" vid="JOL 2:16">haruka noiva sai husi nia tenda kazamentu.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Nai lulik sira nebee serbi NAI Maromak iha Nia uma kreda,</para>
  <para style="q2" vid="JOL 2:17">tenki tanis iha odamatan ho altar nia klaran.</para>
  <para style="q1" vid="JOL 2:17">Sira tenki dehan, ‘NAI, hanoin Ita Boot nia povu;</para>
  <para style="q2" vid="JOL 2:17">keta husik ema hamoe Ita Boot nia riku-soin;</para>
  <para style="q2" vid="JOL 2:17">la bele husik nasaun sira soe lia ba ami.</para>
  <para style="q1" vid="JOL 2:17">Nusaa mak povu husi rai sel-seluk dehan ba malu,</para>
  <para style="q2" vid="JOL 2:17">“Ema sira nee nia Maromak iha nebee?”’”<verse eid="JOL 2:17" /></para>
  <para style="s">NAI Maromak promete atu hadia fali Nia povu nia moris</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Depois NAI Maromak hanoin teb-tebes Nia rain;</para>
  <para style="q2" vid="JOL 2:18">Nia hatudu laran luak ba Nia povu.<verse eid="JOL 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19" />NAI Maromak hataan nunee ba Nia povu:</para>
  <para style="q2" vid="JOL 2:19">“Hau sei hatuun trigu musan, tua foun ho mina azeite,</para>
  <para style="q2" vid="JOL 2:19">para imi haan-hemu too bosu.</para>
  <para style="q1" vid="JOL 2:19">Hau sei la husik tan nasaun seluk hamoe imi.<verse eid="JOL 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />Tropas sira nebee mai husi parte norte, Hau sei hadook tiha husi imi;</para>
  <para style="q2" vid="JOL 2:20">Hau sei dudu sira tama ba iha rai maran dekor.</para>
  <para style="q1" vid="JOL 2:20">Sira nebee forma iha parte lorosae, sei mout iha Tasi Mate;</para>
  <para style="q2" vid="JOL 2:20">sira nebee forma husi parte loromonu, sei tama ba iha Tasi Mediteráneu.</para>
  <para style="q1" vid="JOL 2:20">Sira nia isin sei dodok dois.</para>
  <para style="q2" vid="JOL 2:20">NAI Maromak halo tiha ona buat boot!<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />Rai Judá, lalika tauk;</para>
  <para style="q2" vid="JOL 2:21">haksolok no haklalak ba!</para>
  <para style="q2" vid="JOL 2:21">Tanba NAI halo tiha ona buat boot.<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />Imi animal fuik sira, lalika tauk,</para>
  <para style="q2" vid="JOL 2:22">tanba duut iha rai fuik sai matak dadauk;</para>
  <para style="q1" vid="JOL 2:22">ai huun sira nia fuan iha fali ona;</para>
  <para style="q2" vid="JOL 2:22">ai figeira ho ai uvas foo fuan tebar nakonu.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Povu Siaun haksolok ba;</para>
  <para style="q2" vid="JOL 2:23">haklalak tanba NAI imi nia Maromak.</para>
  <para style="q1" vid="JOL 2:23">Nia sempre kaer metin Nia liafuan;</para>
  <para style="q2" vid="JOL 2:23">Nia hatuun tiha ona udan hanesan baibain;</para>
  <para style="q2" vid="JOL 2:23">udan monu rai tuir nia tempu, too udan ikus mos tuir nia tempu.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Fatin nebee baibain ema baku trigu musan sei nakonu fali;</para>
  <para style="q2" vid="JOL 2:24">tua foun ho mina azeite nia fatin mos sei nakonu too suli sai.<verse eid="JOL 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />Buat nebee gafanhotu estraga tiha ona iha tinan barak nia laran,</para>
  <para style="q2" vid="JOL 2:25">Hau sei foo fali;</para>
  <para style="q1" vid="JOL 2:25">Hau sei selu fali saida deit mak gafanhotu grupu primeiru, gafanhotu boot sira, gafanhotu lotuk sira ho gafanhotu sel-seluk haan tiha ona.</para>
  <para style="q1" vid="JOL 2:25">Sira lubuk boot nee Hau nia tropas;</para>
  <para style="q2" vid="JOL 2:25">Hau mak manda ba iha imi nia klaran.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Agora imi sei hetan ai haan barak too bosu;</para>
  <para style="q2" vid="JOL 2:26">imi sei foti aas NAI imi nia Maromak nia naran.</para>
  <para style="q1" vid="JOL 2:26">Nia halo tiha ona buat furak ba imi;</para>
  <para style="q2" vid="JOL 2:26">Hau nia povu nunka atu moe tan.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Nunee imi sei hatene katak Hau iha hela ema Israel sira nia klaran;</para>
  <para style="q2" vid="JOL 2:27">Hau mak NAI imi nia Maromak,</para>
  <para style="q1" vid="JOL 2:27">la iha tan maromak seluk.</para>
  <para style="q2" vid="JOL 2:27">Hau nia povu nunka atu moe tan.<verse eid="JOL 2:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />Hotu tiha,</para>
  <para style="q2" vid="JOL 2:28">Hau sei haruka Hau nia Espiritu tuun ba iha ema hotu-hotu.</para>
  <para style="q1" vid="JOL 2:28">Imi nia oan feto ho oan mane sira</para>
  <para style="q2" vid="JOL 2:28">sei foo tutan Hau nia lia menon.</para>
  <para style="q1" vid="JOL 2:28">Imi nia ferik-katuas sira sei mehi buat nebee mak Hau foo ba sira;</para>
  <para style="q2" vid="JOL 2:28">imi nia joven sira sei haree buat nebee mak Hau hatudu ba sira.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Hau sei haruka Hau nia Espiritu</para>
  <para style="q2" vid="JOL 2:29">tuun ba iha Hau nia atan mane ho atan feto sira iha tempu nee.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Hau sei halo sinal oi-oin iha lalehan nebee halo ema admira,</para>
  <para style="q2" vid="JOL 2:30">no halo sinal oi-oin iha mundu,</para>
  <para style="q2" vid="JOL 2:30">hanesan raan, ahi ho ahi suar sae makaas.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Loro matan sei sai nakukun;</para>
  <para style="q2" vid="JOL 2:31">fulan sei sai mean hanesan raan.</para>
  <para style="q1" vid="JOL 2:31">Hotu tiha mak foin NAI nia loron too.</para>
  <para style="q2" vid="JOL 2:31">Iha loron ida nee NAI Maromak sei hatudu sai Nia kbiit boot, halo ema tauk teb-tebes.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />Maibee see mak husu tulun ba NAI</para>
  <para style="q2" vid="JOL 2:32">sei hetan salvasaun.</para>
  <para style="q1" vid="JOL 2:32">Tanba iha foho Siaun ho Jerusalém, ema balu sei konsege moris,</para>
  <para style="q2" vid="JOL 2:32">hanesan NAI Maromak dehan tiha ona.</para>
  <para style="q1" vid="JOL 2:32">Ema nebee NAI hili mak sei moris.”<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">NAI Maromak sei foo kastigu ba Nia povu nia inimigu</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />NAI Maromak dehan, “Bainhira buat sira nee akontese,</para>
  <para style="q2" vid="JOL 3:1">Hau sei hadia fali povu Judá ho Jerusalém sira nia moris.<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />Hau sei halibur nasaun hotu-hotu hamutuk</para>
  <para style="q2" vid="JOL 3:2">hodi lori sira tuun ba iha rai klean Josafat nian.</para>
  <para style="q1" vid="JOL 3:2">Iha nebaa Hau sei foo justisa ba sira</para>
  <para style="q2" vid="JOL 3:2">kona ba saida mak sira halo tiha ona ba Hau nia povu rasik, ema Israel.</para>
  <para style="q1" vid="JOL 3:2">Tanba sira halo namkari Hau nia povu ba iha nasaun sel-seluk,</para>
  <para style="q2" vid="JOL 3:2">no fahe Hau nia rai halo keta-ketak.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Sira dada rifa kona ba Hau nia povu;</para>
  <para style="q2" vid="JOL 3:3">sira faan mane oan sira para bele hetan feto luroon;</para>
  <para style="q2" vid="JOL 3:3">sira faan feto oan sira para bele hetan tua hodi hemu.<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />Agora povu sidade Tiru ho Sidon, ho rejiaun hotu-hotu rai Filístia nian, imi iha problema saida ho Hau? Imi kontra Hau atu halo saida? Imi atu selu fali buat aat ruma nebee Hau halo ona ba imi ka? Se nunee, saida mak imi halo, lalais deit Hau sei tidin fali ba iha imi nia ulun rasik. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Tanba imi foti tiha ona Hau nia osan mutin ho osan mean, imi lori tiha ona Hau nia sasaan mesak di-diak deit ba iha imi nia maromak sira nia uma lulik. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Imi mos faan tiha ema Judá ho ema Jerusalém sira ba ema Gregu, atu nunee imi bele hasai sira dook husi sira nia rain moris fatin.<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />Haree deit, Hau sei fanu sira para sai husi fatin nebee imi faan sira ba. Depois saida mak imi halo ona ba sira, Hau sei tidin fali ba iha imi nia ulun rasik. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Hau sei faan imi nia oan mane ho oan feto sira ba iha ema Judá, depois sira sei faan tutan imi nia oan sira ba ema Seba, nasaun ida nebee dook.” Ida nee NAI Maromak mak hatete.<verse eid="JOL 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Foo sai ba iha nasaun jentiu sira:</para>
  <para style="q1" vid="JOL 3:9">Prepara atu halo funu!</para>
  <para style="q2" vid="JOL 3:9">Haruka funu nain sira hamriik;</para>
  <para style="q2" vid="JOL 3:9">manda militar sira hakbesik mai hodi ataka.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Tuku tiha imi nia besi karau dikur sai fali surik;</para>
  <para style="q2" vid="JOL 3:10">tuku tiha imi nia katana sai fali diman.</para>
  <para style="q2" vid="JOL 3:10">Ema nebee fraku tenki dehan, “Hau nee makaas!”<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Imi nasaun jentiu sira nebee hela besik Israel, mai lalais ba;</para>
  <para style="q2" vid="JOL 3:11">halibur hamutuk iha rai klean Josafat nian.</para>
  <para style="q2" vid="JOL 3:11">NAI, lori Ita Boot nia aswain sira tuun mai!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />Nasaun jentiu sira tenki hamriik</para>
  <para style="q2" vid="JOL 3:12">hodi lao tuun ba iha rai klean Josafat nian,</para>
  <para style="q1" vid="JOL 3:12">tanba Hau, NAI Maromak sei tuur iha nebaa</para>
  <para style="q2" vid="JOL 3:12">hodi foo justisa ba nasaun jentiu sira hotu nebee hela besik Israel.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Sira nee hanesan trigu iha toos nebee tasak ona;</para>
  <para style="q2" vid="JOL 3:13">hodi katana lere ona ba!</para>
  <para style="q1" vid="JOL 3:13">Sira hanesan uvas fuan nebee nakonu ona iha tanki sama uvas nian;</para>
  <para style="q2" vid="JOL 3:13">tama hodi sama ba,</para>
  <para style="q1" vid="JOL 3:13">halo uvas nia been suli sai husi nia fatin,</para>
  <para style="q2" vid="JOL 3:13">tanba sira nia moris nakonu ho hahalok aat.<verse eid="JOL 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Ema lubuk boot, barak teb-tebes iha hela rai klean justisa nian,</para>
  <para style="q2" vid="JOL 3:14">tanba NAI nia loron besik dadauk iha rai klean justisa nee.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Loro matan ho fulan sei sai nakukun tiha;</para>
  <para style="q2" vid="JOL 3:15">fitun la foo naroman tan.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />NAI Maromak foo sai ho lian makaas husi foho Siaun;</para>
  <para style="q2" vid="JOL 3:16">Nia lian tarutu iha Jerusalém,</para>
  <para style="q2" vid="JOL 3:16">halo lalehan ho rai nakdoko tiha.</para>
  <para style="q1" vid="JOL 3:16">Maibee NAI mak fatin seguru ba Nia povu;</para>
  <para style="q2" vid="JOL 3:16">Nia mak povu Israel nia abrigu.<verse eid="JOL 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />“Nunee imi sei hatene katak Hau, NAI imi nia Maromak,</para>
  <para style="q2" vid="JOL 3:17">Hau hela iha Hau nia foho santu Siaun.</para>
  <para style="q1" vid="JOL 3:17">Jerusalém sei sai santu;</para>
  <para style="q2" vid="JOL 3:17">militar husi rai liur nunka atu hadau tan rai nee.<verse eid="JOL 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />Iha tempu nee tua foun sei turu tuun husi foho bo-boot;</para>
  <para style="q2" vid="JOL 3:18">susu been suli tuun husi foho kiik sira.</para>
  <para style="q1" vid="JOL 3:18">Bee sei suli iha mota hotu-hotu iha rai Judá;</para>
  <para style="q2" vid="JOL 3:18">bee matan sei suli sai husi NAI nia uma</para>
  <para style="q2" vid="JOL 3:18">hodi habokon rai klean Xitim nian.<verse eid="JOL 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Maibee rai Ejitu sei sai mamuk;</para>
  <para style="q2" vid="JOL 3:19">Edom sei sai rai maran fuik,</para>
  <para style="q1" vid="JOL 3:19">tanba ema husi rai nee halo violensia hasoru povu Judá;</para>
  <para style="q2" vid="JOL 3:19">iha rai Judá nee sira halo ema nia raan fakar maski ema sira nee la sala.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />Rai Judá, ema sei hela nafatin ba nafatin;</para>
  <para style="q2" vid="JOL 3:20">Jerusalém, ema sei hela husi jerasaun ba jerasaun.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Hau atu husik deit sira nebee fakar tiha ona ema sala-laek nia raan ka?</para>
  <para style="q2" vid="JOL 3:21">Lae! Hau sei kastigu sira.”</para>
  <para style="b" vid="JOL 3:21" />
  <para style="q1" vid="JOL 3:21">NAI Maromak hela iha foho Siaun.<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>