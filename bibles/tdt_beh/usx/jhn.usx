<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id" />
  <para style="h">João</para>
  <para style="toc1">João</para>
  <para style="toc2">João</para>
  <para style="toc3">João</para>
  <para style="mt2">Evanjelhu</para>
  <para style="mt1">João</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Nai Jesus mak foo konhese Nai Maromak ba ita</para>
  <para style="q1">
    <verse number="1" style="v" sid="JHN 1:1" />Hori uluk liu, lalehan ho rai seidauk iha,</para>
  <para style="q2" vid="JHN 1:1">Ida nebee hanaran Liafuan iha nanis ona.<note caller="+" style="f"><char style="fr" closed="false">1:1: </char><char style="ft" closed="false">João uza naran “Liafuan” hodi hatudu ba Nai Jesus Kristu, tanba durante Jesus moris iha mundu nee, Nia hatudu sai Nai Maromak ba ita ema.</char></note></para>
  <para style="q1" vid="JHN 1:1">Nia hamutuk ho Maromak,</para>
  <para style="q2" vid="JHN 1:1">i Nia Maromak duni.<verse eid="JHN 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JHN 1:2" />Nia hamutuk ho Maromak</para>
  <para style="q2" vid="JHN 1:2">hori uluk kedas.<verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />Maromak foo fiar ba Nia</para>
  <para style="q2" vid="JHN 1:3">hodi halo lalehan ho rai.</para>
  <para style="q1" vid="JHN 1:3">Se Nia la halo karik,</para>
  <para style="q2" vid="JHN 1:3">buat hotu-hotu la iha.<verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />Nia mak moris nia huun,</para>
  <para style="q2" vid="JHN 1:4">i Nia moris nee foo naroman ba ita ema.<verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />Naroman nee leno iha nakukun laran,</para>
  <para style="q2" vid="JHN 1:5">i nakukun la iha forsa atu hamate Naroman nee.<verse eid="JHN 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JHN 1:6" />Iha loron ida, Maromak haruka ema ida mai,</para>
  <para style="q2" vid="JHN 1:6">nia naran João.<note caller="+" style="x"><char style="xo" closed="false">1:6: </char><char style="xt" closed="false"><ref loc="MAT 3:1">Mateus 3:1</ref>; <ref loc="MRK 1:4">Marcos 1:4</ref>; <ref loc="LUK 3:1-2">Lucas 3:1-2</ref></char></note><verse eid="JHN 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JHN 1:7" />Nia mai atu foo sasin kona ba Naroman nee,</para>
  <para style="q2" vid="JHN 1:7">atu ema hotu-hotu bele fiar liu husi nia sasin.<verse eid="JHN 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JHN 1:8" />João rasik laos Naroman nee,</para>
  <para style="q2" vid="JHN 1:8">nia so mai atu foo sasin deit kona ba Naroman nee.<verse eid="JHN 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JHN 1:9" />Iha tempu nebaa Naroman nee atu mai ona iha mundu.</para>
  <para style="q2" vid="JHN 1:9">Nia mak Naroman lo-loos nebee leno ema hotu nia moris.<verse eid="JHN 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JHN 1:10" />Hori uluk kedas Maromak foo fiar ba Nia</para>
  <para style="q2" vid="JHN 1:10">mak halo mundu.</para>
  <para style="q1" vid="JHN 1:10">Nia iha mundu nanis,</para>
  <para style="q2" vid="JHN 1:10">maibee ema iha mundu la hatene Nia.<verse eid="JHN 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JHN 1:11" />Nia mai iha Nia rain rasik,</para>
  <para style="q2" vid="JHN 1:11">maibee Nia maluk rasik lakohi simu Nia.<verse eid="JHN 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JHN 1:12" />Maski nunee ema hotu nebee simu Nia i fiar ba Nia,</para>
  <para style="q2" vid="JHN 1:12">Nia foo direitu ba sira hodi sai Maromak nia oan.<verse eid="JHN 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JHN 1:13" />Sira sai Maromak nia oan nee laos tanba moris husi ema,</para>
  <para style="q2" vid="JHN 1:13">i laos liu husi feen-laen nia hakarak atu hetan oan,</para>
  <para style="q3" vid="JHN 1:13">maibee Maromak rasik mak foo moris ba sira.<verse eid="JHN 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JHN 1:14" />Ida nebee hanaran Liafuan nee nakfilak ba ema,</para>
  <para style="q2" vid="JHN 1:14">i hela iha ita nia klaran durante tempu badak.</para>
  <para style="q1" vid="JHN 1:14">Ita haree tiha ona Nia kbiit boot</para>
  <para style="q2" vid="JHN 1:14">nudar Maromak nia Oan mane mesak.</para>
  <para style="q1" vid="JHN 1:14">Nia mai husi Maromak,</para>
  <para style="q2" vid="JHN 1:14">Nia laran diak nunka hotu</para>
  <para style="q3" vid="JHN 1:14">i Nia koalia sempre loos.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />João foo sasin ho lian makaas kona ba Ema nee dehan, “Nia nee mak uluk hau dehan tiha ona, ‘Iha Ema ida sei mai. Maski hau mak mai uluk maibee Nia boot liu hau, tanba molok hau moris mai, Nia iha nanis tiha ona.’ ”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Husi Nia laran diak teb-tebes mak ita hotu hetan bensaun fila-fila. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Tanba Maromak foo Nia lei liu husi Moisés, maibee Nia laran diak ho lia loos ita hetan liu husi Jesus Kristu. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />La iha ema ida mak haree ona Maromak. Maibee Maromak nia Oan mane mesak mak hela iha Aman Maromak nia sorin, i Nia mak foo konhese Maromak ba ita.<verse eid="JHN 1:18" /></para>
  <para style="s">João Sarani Nain prepara dalan ba Nai Jesus</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mateus 3:1-12</ref>; <ref loc="MRK 1:1-8">Marcos 1:1-8</ref>; <ref loc="LUK 3:1-18">Lucas 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Iha loron ida, nai ulun Judeu sira iha Jerusalém haruka nai lulik ho ema Levi balu ba iha João hodi husu dehan, “Ita boot nee see?”</para>
  <para style="p" vid="JHN 1:19">João hataan kona ba nia aan, <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />nia la bosok, maibee foo sai mo-moos dehan, “Hau laos Mesias, Salvador nebee Maromak atu haruka mai.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Sira husu tan dehan, “Se nunee ita boot see loos? Ita boot mak Maromak nia profeta Elias ka?”</para>
  <para style="p" vid="JHN 1:21">João hataan nafatin, “Lae.”</para>
  <para style="p" vid="JHN 1:21">Sira husu tan, “Ita boot nee Profeta nebee mak ami hein hela ka?”<note caller="+" style="x"><char style="xo" closed="false">1:21: </char><char style="xt" closed="false"><ref loc="DEU 18:15">Deuteronómiu 18:15</ref>, <ref loc="DEU 18">18</ref>; <ref loc="MAL 4:5">Malakias 4:5</ref></char></note></para>
  <para style="p" vid="JHN 1:21">João hataan, “Lae.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Too ikus sira husu, “Entaun ita boot nee see? Hatete mai ami kona ba ita boot nia aan atu nunee ami bele foo hatene fali ba ema nebee mak haruka ami mai.”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />João hataan tuir liafuan nebee profeta Isaias uluk foo sai tiha ona dehan, “Hau nee ema ida nebee foo sai ho lian makaas iha rai fuik maran dehan, ‘Hadia dalan nebee kleuk para simu ita nia Nai mai.’ ”<note caller="+" style="x"><char style="xo" closed="false">1:23: </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isaias 40:3</ref></char></note><verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Iha mos ema Farizeu balu nebee nai ulun Judeu sira haruka mai. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Sira husu ba João, “Se ita boot laos Mesias, laos profeta Elias, i laos Profeta nebee ami hein hela, entaun nusaa mak ita boot foo sarani ema?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />João hataan, “Hau foo sarani hodi bee deit, maibee iha Ema ida iha imi nia klaran, imi la konhese Nia. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Maski hau mak mai uluk, maibee atu kore deit Nia sandalias talin mos, hau la serve.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Buat sira nee hotu akontese iha rai Betánia, iha mota Jordaun nia sorin ba, iha fatin nebee João foo sarani ema.<verse eid="JHN 1:28" /></para>
  <para style="s">Nai Jesus mak Maromak nia Bibi Oan</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Aban fali João haree Jesus lao mai, i nia dehan, “Haree ba! Maromak nia Bibi Oan nebee hasai mundu nia sala, Nia mak nee. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Hau foo sai tiha ona kona ba Nia dehan, ‘Iha Ema ida sei mai. Maski hau mak mai uluk maibee Nia boot liu hau, tanba molok hau moris mai, Nia iha nanis tiha ona.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Uluk hau rasik la hatene Nia nee see loos. Maibee hau mai foo sarani ema hodi bee atu povu Israel bele konhese Nia.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Depois João foo sasin hanesan nee: “Iha loron ida hau haree Maromak nia Espiritu tuun mai husi lalehan hanesan manu pombu, i hela iha Ema nee. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Uluk hau la hatene Nia nee see loos. Maibee Maromak haruka hau foo sarani hodi bee, i Nia hatete nanis mai hau dehan, ‘O sei haree Espiritu Santu tuun mai hela iha Ema ida. Ema nee mak sei foo sarani hodi Espiritu Santu.’ Husi nee mak foin hau konhese lo-loos Nia. <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Hau haree ho matan rasik, nunee hau foo sasin katak Nia nee Maromak nia Oan.”<verse eid="JHN 1:34" /></para>
  <para style="s">Nai Jesus nia eskolante primeiru</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Iha loron tuir mai João ho nia eskolante nain rua iha fali fatin nee. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Bainhira nia haree Jesus lao liu, nia dehan, “Haree ba! Maromak nia Bibi Oan mak nee!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Rona nunee, João nia eskolante nain rua nee baa tuir kedas Jesus. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Jesus hateke ba kotuk, haree sira nain rua tuir hela Nia. I Nia husu sira, “Imi buka saida?”</para>
  <para style="p" vid="JHN 1:38">Sira hataan, “Rabi, Ita Boot hela iha nebee?” (Liafuan rabi dehan “mestri”.)<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Jesus hataan, “Mai haree rasik.” Nunee sira baa hamutuk ho Jesus, i haree Nia hela fatin. Iha loron nee tuku haat lokraik ona, entaun sira hela ho Nia too kalan.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Eskolante nain rua nebee rona João nia liafuan hodi tuir Jesus, ida mak André, Simão Pedro nia alin. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />André baa kedas buka nia maun Simão hodi hatete ba nia, “Ami hetan ona Mesias!” (Mesias katak “Kristu”, Salvador nebee Maromak atu haruka mai.) <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Depois André lori nia maun ba Jesus.</para>
  <para style="p" vid="JHN 1:42">Jesus hateke ba Simão hodi dehan, “O nee Simão, João nia oan. Ema sei bolu o Cefas.” (Cefas katak “Pedro” ka “fatuk isin”.)<verse eid="JHN 1:42" /></para>
  <para style="s">Nai Jesus bolu Filipe ho Natanael</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Aban fali Jesus desidi atu baa iha provinsia Galileia. Nia hasoru Filipe, i dehan, “Mai tuir Hau.” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Filipe nee husi aldeia Betsaida, Pedro ho André mos husi nebaa.<verse eid="JHN 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45" />Depois Filipe hetan Natanael hodi dehan, “Ami hetan tiha ona Ema nebee mak Moisés foo sai iha Maromak nia lei, profeta sira seluk mos hakerek kona ba Ema nee. Nia nee Jesus husi aldeia Nazaré, José nia oan.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Natanael hataan, “Buat diak ida hanesan nee bele mosu fali husi Nazaré ka?”</para>
  <para style="p" vid="JHN 1:46">Filipe dehan, “Mai haree rasik.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Bainhira Jesus haree Natanael lao dadauk mai, Nia koalia kona ba Natanael dehan, “Ema nee Israel isin, nia la hatene bosok.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Natanael husu ba Jesus, “Oinsaa mak Ita Boot bele konhese hau?”</para>
  <para style="p" vid="JHN 1:48">Jesus hataan, “Molok Filipe bolu o mai, Hau haree tiha ona o iha ai figeira huun.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Depois Natanael foo sai dehan, “Mestri, Ita Boot mak Maromak nia Oan. Ita Boot nee ema Israel sira nia Liurai.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Jesus dehan, “O fiar tanba Hau foo sai katak Hau haree o iha ai figeira huun ka? O sei haree buat makaas liu fali ida nee.”<verse eid="JHN 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 1:51" />Depois Jesus hatutan tan, “Hau dehan lo-loos ba imi. Imi sei haree lalehan nakloke i Maromak nia anju sira sae-tuun mai iha Hau, Ema Umanu nia Oan.”<note caller="+" style="f"><char style="fr" closed="false">1:51 </char><char style="ft" closed="false">Nai Jesus temi “Ema Umanu nia Oan” hodi refere ba Nia Aan rasik. Nia foti liafuan nee husi Daniel 7:13-14. Nunee titulu nee hatudu katak Nai Jesus nee Ema, ho mos Liurai boot nebee mak atu ukun mundu tomak too tinan ba tinan.</char></note><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Festa kazamentu iha Kaná</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Iha loron tolu, ema halo festa kazamentu iha aldeia Kaná iha provinsia Galileia. Jesus nia inan baa iha festa nee, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Jesus ho Nia eskolante sira mos ema konvida hotu.<verse eid="JHN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 2:3" />Bainhira tua hotu ona, Jesus nia inan hatete ba Nia, “Sira nia tua la iha ona.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Jesus hataan, “Hau nia inan, tansaa mak hatete fali mai Hau? Hau nia tempu seidauk too.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Maibee Nia inan hatete ba ema sira nebee serve iha festa nee dehan, “Halo tuir saida deit mak Nia haruka.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Besik iha nebaa iha sanan boot neen halo husi fatuk. Sanan nee baibain enxe bee iha laran atu ema bele hamoos aan tuir lisan Judeu nian. Sanan ida-ida bele enxe bee maizoumenus litru atus ida. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Jesus hatete ba ema nebee serve iha festa nee dehan, “Enxe bee iha sanan sira nee.” Entaun sira enxe sanan sira nee too nakonu hotu. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Depois Jesus hatete ba sira, “Agora kuru uitoan foo ba mestri tenda hemu.” Nunee sira mos halo tuir. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Mestri tenda koko tiha, afinal bee nee sai tiha ona tua. Nia la hatene tua nee mai husi nebee, maibee ema nebee ohin kuru bee nee hatene.</para>
  <para style="p" vid="JHN 2:9">Depois mestri tenda bolu noivu <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />hodi dehan, “Baibain ema halo festa, sira hasai uluk tua diak nian, kuandu bainaka sira hemu barak ona mak foin hasai tua baratu. Maibee ita boot hasai fali tua diak nian ikus.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Milagre nebee Jesus halo iha Kaná iha Galileia nee mak milagre primeiru nebee Jesus halo. Nunee Nia hatudu sai Nia kbiit lalehan nian, i Nia eskolante sira fiar ba Nia.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Hotu tiha Jesus baa iha sidade Kafarnaum hamutuk ho Nia inan, Nia alin sira ho mos Nia eskolante sira. Sira hela iha nebaa loron hira nia laran.<note caller="+" style="x"><char style="xo" closed="false">2:12: </char><char style="xt" closed="false"><ref loc="MAT 4:13">Mateus 4:13</ref></char></note><verse eid="JHN 2:12" /></para>
  <para style="s">Nai Jesus duni sai kontratu nain sira husi uma kreda boot</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mateus 21:12-13</ref>; <ref loc="MRK 11:15-17">Marcos 11:15-17</ref>; <ref loc="LUK 19:45-46">Lucas 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Bainhira ema Judeu nia loron boot Paskua besik ona,<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Ema Judeu tin-tinan selebra festa Paskua durante loron walu. Iha festa nee, sira hanoin fali uluk, Maromak salva sira nia bei-ala sira nebee mak atan iha rai Ejitu. Haree Ézodu 12.</char></note> Jesus baa iha sidade Jerusalém.<note caller="+" style="x"><char style="xo" closed="false">2:13: </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Ézodu 12:1-27</ref></char></note> <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Iha area uma kreda boot, Nia haree ema faan karau, bibi ho manu pombu, iha mos ema balu tuur iha meza hodi troka osan. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Entaun Nia halo sikoti husi tali hodi duni sai sira hotu husi area uma kreda boot nee, karau ho bibi mos Nia duni sai hotu. Nia soe namkari tiha osan nebee ema troka, i baku fila hotu sira nia meza. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Nia hatete ba ema nebee faan manu pombu dehan, “Lori sai tiha manu nee hotu! La bele halo Hau nia Aman nia uma hanesan fali merkadu.”<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Jesus nia eskolante sira hanoin hetan buat nebee hakerek iha Livru Sagradu dehan, “Hau foo Aan tomak hodi defende Ita Boot nia uma, maski ida nee sei lori Hau ba mate.”<note caller="+" style="x"><char style="xo" closed="false">2:17: </char><char style="xt" closed="false"><ref loc="PSA 69:9">Salmu 69:9</ref></char></note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Depois nai ulun Judeu sira sadik Jesus hodi dehan, “Hatudu took mai ami milagre ruma atu sai sinal katak O iha direitu hodi halo buat sira nee.”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Jesus hataan, “Halo rahun took uma kreda boot nee, i Hau sei harii fali iha loron tolu nia laran.”<note caller="+" style="x"><char style="xo" closed="false">2:19: </char><char style="xt" closed="false"><ref loc="MAT 26:61">Mateus 26:61</ref>, <ref loc="MAT 27:40">27:40</ref>; <ref loc="MRK 14:58">Marcos 14:58</ref>, <ref loc="MRK 15:29">15:29</ref></char></note><verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Sira hataan fali dehan, “Uma nee halo durante tinan haat-nulu resin neen, O atu harii fali iha loron tolu deit ka?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Afinal uma kreda boot nebee mak Jesus temi nee mak Nia isin lolon rasik. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Bainhira Maromak halo Jesus moris fila fali husi mate mak foin Nia eskolante sira hanoin hetan fali Nia liafuan nee. I sira fiar buat nebee hakerek iha Livru Sagradu ho mos buat nebee Jesus koalia tiha ona.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Jesus hela iha Jerusalém durante tempu Paskua. Iha momentu nebaa ema barak haree milagre nebee mak Nia halo, i sira fiar ba Nia. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Maski nunee Jesus la fiar sira, tanba Nia konhese mo-moos ita ema. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Nia hatene nanis ona ita nia laran, nunee la presiza ema ida foo hatene fali Nia kona ba ita.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Nai Jesus dada lia ho Nicodemos</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Iha justisa nain relijiaun Judeu ida naran Nicodemos, nia ema husi grupu Farizeu. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Iha kalan ida nia baa hasoru Jesus hodi dehan, “Mestri, ami hatene katak Maromak haruka Ita Boot mai atu hanorin ami. Tanba Maromak hamutuk ho ema ida mak foin ema nee bele halo milagre hanesan Ita Boot halo nee.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Jesus hataan dehan, “Hau hatete lo-loos ba ita, ema tenki moris fila fali mak foin bele hola parte iha Maromak nia reinu. Se lae, la bele.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nicodemos husu fali, “Nee halo nusaa? Ema nebee boot ona bele tama fali ba iha nia inan nia kabun laran atu nia bele moris fila fali ka?!”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Jesus hataan, “Hau hatete lo-loos ba ita, see-see deit mak hakarak sai Maromak nia reinu, nia tenki moris fila fali liu husi bee ho mos Maromak nia Espiritu. Se lae, la bele. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Ema nia isin hetan moris husi ema. Maibee moris tuir Espiritu, Maromak nia Espiritu mak foo. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />La bele hakfodak ba Hau nia liafuan ohin dehan, ‘Imi tenki moris fila fali.’ <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Hau foti ezemplu husi anin. Anin huu tuir nia hakarak. Ita bele rona nia lian, maibee la hatene mai husi nebee ka atu baa iha nebee. Maromak nia Espiritu foo moris foun ba ema mos hanesan nee.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nicodemos husu tan, “Oinsaa mak buat nee bele akontese?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Jesus hataan, “Ita boot ema Israel nia mestri ida. Nusaa mak la kompriende buat sira nee? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Hau hatete lo-loos ba ita, Ami nee hanorin kona ba buat nebee Ami hatene tuir. I Ami foo sasin tuir buat nebee mak Ami haree tiha ona. Maibee imi sira nee la simu nafatin Ami nia sasin. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Hau koalia tiha ona ba imi kona ba buat mundu nian, maibee imi la fiar. Saa tan Hau koalia kona ba buat lalehan nian, imi atu fiar oinsaa? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />La iha ema ida mak sae tiha ona ba lalehan. So Hau, Ema Umanu nia Oan deit mak tuun mai husi nebaa.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Uluk bainhira ita nia bei-ala sira iha rai fuik maran, Moisés halo samea husi riti i hasae ba iha ai riin ida. See-see deit mak samea tata, bainhira hateke ba samea riti nee, sira la mate. Nunee mos Hau, Ema Umanu nia Oan. Ema tenki hasae Hau iha ai<note caller="+" style="f"><char style="fr" closed="false">3:14: </char><char style="ft" closed="false">Uluk liu, povu Israel kontra Maromak iha rai fuik maran. Entaun Maromak haruka samea hodi tata mate sira. La kleur sira hakribi sira nia sala. Nunee Maromak haruka Moisés halo samea ida husi riti hodi tau iha ai riin leten, atu ema hotu nebee samea tata, bainhira haree ba samea riti nee, bele hetan kura. (Haree Númerus (Bilangan) 21:4-9.) Nunee mos ema hotu nebee hakribi nia sala hodi fiar ba Nai Jesus, sei hetan moris rohan-laek.</char></note> <note caller="+" style="x"><char style="xo" closed="false">3:14: </char><char style="xt" closed="false"><ref loc="NUM 21:4-9">Númerus 21:4-9</ref></char></note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />atu see-see deit mak fiar mai Hau hetan moris rohan-laek.”<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Maromak nia domin ba ema iha mundu nee boot teb-tebes, too Nia entrega Nia Oan mane mesak. Nunee see-see deit mak fiar ba Nia Oan nee, la mate haketak aan husi Maromak, maibee hetan moris rohan-laek. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Tanba Maromak haruka Nia Oan mai iha mundu nee laos atu foo justisa ba ema, maibee atu liu husi Nia, ema iha mundu nee bele hetan salvasaun. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Ema nebee mak fiar ba Maromak nia Oan, Maromak nia kastigu la monu ba sira. Maibee ema nebee mak la fiar, Maromak desidi nanis ona atu kastigu sira tanba sira la fiar ba Maromak nia Oan mane mesak. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Sira hetan kastigu nee tanba naroman mai tiha ona iha mundu, maibee ema gosta liu moris iha nakukun laran duke moris iha naroman laran, tanba sira nia hahalok aat. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Ema hotu nebee halo buat aat, sira odi naroman. Sira lakohi mai iha naroman tanba sira tauk atu naroman nee hatudu sai sira nia hahalok aat. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Maibee see-see deit mak moris tuir dalan loos, sira mai iha naroman, atu ema bele haree mo-moos katak sira nia hahalok diak tanba Maromak tulun sira.<verse eid="JHN 3:21" /></para>
  <para style="s">Nai Jesus boot liu João Sarani Nain</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Hotu tiha Jesus ho Nia eskolante sira baa iha rai Judeia. Nia hela hamutuk ho sira iha nebaa iha tempu badak nia laran hodi foo sarani ema. <verse eid="JHN 3:22" /><verse number="23-24" style="v" sid="JHN 3:23-24" />Iha tempu nebaa João seidauk tama iha komarka. Nia foo sarani ema iha rai Enon, besik aldeia Salim, tanba iha nebaa iha bee barak. Ema nadodon mai iha fatin nee atu João foo sarani sira.<note caller="+" style="x"><char style="xo" closed="false">3:23-24: </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mateus 14:3</ref>; <ref loc="MRK 6:17">Marcos 6:17</ref>; <ref loc="LUK 3:19-20">Lucas 3:19-20</ref></char></note><verse eid="JHN 3:23-24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />João nia eskolante sira ho ema Judeu ida komesa diskuti malu kona ba serimonia hamoos aan. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Sira baa iha João hodi dehan, “Mestri, ita boot sei hanoin Ema ida nebee uluk hamutuk ho ita boot iha mota Jordaun nia sorin ba, ita foo sasin kona ba Nia. Agora Nia mos foo sarani ema too ema halai hotu ba Nia!”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />João hataan, “Ita ema so bele simu deit buat nebee Maromak foo mai ita. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Imi rasik rona tiha ona hau dehan, ‘Hau laos Mesias, Salvador nebee Maromak atu haruka mai. Maibee Maromak haruka hau mai uluk hodi prepara dalan ba Nia.’<note caller="+" style="x"><char style="xo" closed="false">3:28: </char><char style="xt" closed="false"><ref loc="JHN 1:20">João 1:20</ref></char></note> <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Iha loron kazamentu, noivu mak kaben ho noiva. Noivu nia kolega hamriik hela iha nia sorin hodi asisti, i haksolok teb-tebes rona noivu nia lian. Nunee mos, agora hau haksolok teb-tebes tanba ema barak tuir Jesus. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Nia tenki sai boot liu, hau tenki sai kiik fali.<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Nia nee mai husi leten nebaa, nunee Nia boot liu hotu-hotu. See mak mai husi mundu nee, nia ema mundu nian deit, nunee koalia hanesan ema mundu nian deit. Maibee Ida nebee mai husi lalehan, Nia boot liu hotu-hotu. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Nia foo sasin kona ba buat nebee mak Nia haree i rona rasik, maski nunee ema lakohi simu Nia liafuan. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Maibee sira nebee simu Nia liafuan, sira deklara katak Maromak sempre koalia loos. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Ema nebee Maromak mak haruka, Nia hatoo Maromak nia liafuan, tanba Maromak foo tomak Espiritu Santu ba Nia. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Aman Maromak hadomi Nia Oan i entrega tiha ona buat hotu-hotu ba iha Nia liman laran.<note caller="+" style="x"><char style="xo" closed="false">3:35: </char><char style="xt" closed="false"><ref loc="MAT 11:27">Mateus 11:27</ref>; <ref loc="LUK 10:22">Lucas 10:22</ref></char></note> <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />See deit mak fiar ba Maromak nia Oan, nia hetan ona moris rohan-laek. Maibee see-see deit mak lakohi simu Maromak nia Oan, nia sei la hetan moris rohan-laek, maibee Maromak fakar Nia hirus ba ema nee.”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Nai Jesus dada lia ho feto Samaria ida</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Iha tempu nebaa ema balu husi grupu Farizeu rona katak, ema nebee tuir Jesus barak liu fali ema nebee tuir João. Sira mos rona dehan, Jesus foo sarani ema barak liu. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Afinal Jesus rasik la foo sarani ema, Nia eskolante sira mak foo sarani. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Jesus hatene katak istoria nee too ona iha ema Farizeu nia tilun. Nunee Nia ho Nia eskolante sira sai husi provinsia Judeia baa fali iha provinsia Galileia. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Atu baa Galileia tenki liu husi provinsia Samaria. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Entaun sira too iha sidade ida iha Samaria naran Sikar, besik rai nebee uluk Jacó foo ba nia oan José.<note caller="+" style="x"><char style="xo" closed="false">4:5: </char><char style="xt" closed="false"><ref loc="GEN 33:19">Jénesis 33:19</ref>; <ref loc="JOS 24:32">Josué 24:32</ref></char></note> <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Bee posu Jacó nian iha nebaa. Tanba sira lao dook ona, entaun Jesus kolen liu, i Nia baa tuur iha bee posu nee nia leten. Iha momentu nebaa meudia ona, <verse eid="JHN 4:6" /><verse number="7-8" style="v" sid="JHN 4:7-8" />nunee Jesus nia eskolante sira baa iha sidade atu sosa hahaan.</para>
  <para style="p" vid="JHN 4:7-8">Depois feto Samaria ida mai atu kuru bee, i Jesus husu ba nia, “Foo netik bee uitoan mai Hau hemu lai.”<verse eid="JHN 4:7-8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Feto Samaria nee dehan, “Ita Boot ema Judeu, hau feto Samaria. Nusaa mak husu fali bee mai hau?” Nia hatete nunee tanba ema Judeu la gosta liga ema Samaria.<note caller="+" style="x"><char style="xo" closed="false">4:9: </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">Esdras 4:1-5</ref>; <ref loc="NEH 4:1-2">Neemias 4:1-2</ref></char></note><verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Jesus hataan, “Se karik ita hatene tuir buat nebee Maromak atu foo, i hatene See loos mak husu bee nee, entaun ita sei husu bee mai Hau, nunee Hau sei foo bee moris nian.”<note caller="+" style="x"><char style="xo" closed="false">4:10: </char><char style="xt" closed="false"><ref loc="JER 2:13">Jeremias 2:13</ref>; <ref loc="ZEC 14:8">Zacarias 14:8</ref>; <ref loc="EZK 47:9">Ezequiel 47:9</ref></char></note><verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Feto nee hataan, “Senhor, Ita Boot nia kanaba la iha, i bee posu nee naruk. Ita Boot atu hetan bee moris nian husi nebee? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Uluk ami nia bei-ala Jacó mak kee bee posu nee. Nia ho nia oan sira ho mos nia animal sira hemu bee husi posu nee. Senhor boot liu fali nia ka?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Jesus hataan, “Ema nebee hemu bee ida nee, la kleur hamrook fali. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Maibee see mak hemu bee nebee Hau foo, nia sei la hamrook tan. Tanba bee nebee Hau foo ba nia nee sei sai hanesan bee matan ida iha nia laran, bee nee sei suli nafatin hodi foo moris rohan-laek ba nia.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Feto nee dehan ba Jesus, “Senhor, se nunee foo bee nee mai hau atu hau la bele hamrook tan, para hau lalika mai beibeik kuru bee iha nee.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Jesus hatete ba nia, “Baa bolu ita nia kaben, imi nain rua mai.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Feto nee hataan fali, “Hau laos kaben nain.”</para>
  <para style="p" vid="JHN 4:17">Jesus hatete ba nia, “Saida mak ita koalia nee loos, ita la iha kaben duni. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Ita kaben dala lima ona i mane nebee moris hamutuk ho ita agora nee laos ita nia kaben. Buat nebee ohin ita koalia nee loos duni.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Feto nee dehan, “Senhor, agora hau hatene ona katak, senhor nee Maromak nia profeta ida. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Ami nia bei-ala sira adora Maromak iha foho nebaa, maibee imi Judeu dehan ema tenki adora Maromak iha Jerusalém.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Jesus hatete, “Senhora, fiar Hau nia liafuan nee. Too tempu ida imi la presiza sae tan foho nebaa ka baa iha Jerusalém mak foin adora Aman Maromak. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Imi ema Samaria adora Maromak maski la konhese Nia. Ami ema Judeu adora Nia i konhese Nia. Tanba Maromak sei foo salvasaun ba ema liu husi ema Judeu. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Too tempu ida, tempu nee mak komesa agora nee, ema nebee adora lo-loos Aman Maromak sei adora Nia tuir Nia Espiritu hanorin i tuir buat nebee loos. Ida nee mak Maromak hakarak. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Maromak nee Espiritu. I see deit mak adora Nia tenki adora Nia tuir Nia Espiritu hanorin i tuir buat nebee loos.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Feto nee dehan, “Hau hatene katak Mesias sei mai. Bainhira Nia mai, Nia sei foo sai buat hotu-hotu ba ita.” (Mesias katak “Kristu”, Salvador nebee Maromak atu haruka mai.)<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Depois Jesus hatete, “Ida nebee ita temi Mesias mak agora dadauk koalia hela ho ita nee.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Jesus sei koalia hela, Nia eskolante sira fila husi sidade. Sira hakfodak haree Jesus dada lia hela ho feto ida. Maibee sira ida mos la husu, “Ita presiza saida?” La iha ida mak husu Jesus dehan, “Nusaa mak Ita Boot dada lia ho nia?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Depois feto nee husik hela nia sanan iha nebaa, i fila ba iha sidade laran hodi foo hatene ba ema sira iha nebaa dehan, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Mai haree! Iha ema ida foo sai buat hotu nebee hau halo tiha ona! Karik Nia nee Mesias?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Nunee ema sira nee sai husi sidade atu baa haree Jesus.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Sira seidauk too, Jesus nia eskolante sira hatete, “Mestri, haan lai.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Maibee Nia hataan, “Hau iha hahaan nebee imi la hatene.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Nunee Nia eskolante sira husu ba malu dehan, “Keta ema ruma mai foo hahaan ba Nia karik?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Jesus dehan, “Hau nia hahaan mak halo tuir Maromak nia hakarak, i halo hotu knaar nebee Nia foo mai Hau. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Baibain imi dehan, ‘Fulan haat tan, tempu silu batar.’ Hau hatete ba imi, loke matan hodi haree ema sira nebee mai nee. Sira hanesan batar iha toos nebee maran ona, prontu atu silu. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Hanesan ema silu batar hodi hatama ba armazen, nunee mos imi lori ema mai iha Hau para sira bele hetan moris rohan-laek. Nunee imi simu ona imi nia kolen. Too ikus ema nebee kuda ho ema nebee silu sei haksolok hamutuk. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Ema baibain soe lia dehan, ‘Ida kuda, ida seluk mak silu.’ Nee loos duni. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Hau haruka ona imi atu silu batar nebee ema seluk kuda. Sira servisu mate aan hodi halo toos i imi hein silu deit.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Iha tempu nebaa ema Samaria barak husi sidade nee fiar ba Jesus tanba sira rona feto nee foo sasin dehan, “Nia foo sai buat hotu nebee hau halo tiha ona.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Entaun bainhira ema Samaria sira too iha Jesus, sira husu fila-fila atu Nia hela hamutuk ho sira. Nunee Jesus hela loron rua iha nebaa.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Too ikus ema barak liu tan fiar ba Jesus tanba sira rona rasik Nia hanorin. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Sira hatete ba feto nee, “Agora ami fiar ba Nia tanba ami rona rasik Nia hanorin, laos deit tanba o nia liafuan. Agora ami hatene katak Nia mak atu salva ema hotu.”<verse eid="JHN 4:42" /></para>
  <para style="s">Nai Jesus kura funsionariu boot ida nia oan</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Liu tiha loron rua Jesus baa liu iha provinsia Galileia. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Nia rasik hatete tiha ona katak, ema la respeita profeta ida iha nia rain rasik.<note caller="+" style="x"><char style="xo" closed="false">4:44: </char><char style="xt" closed="false"><ref loc="MAT 13:57">Mateus 13:57</ref>; <ref loc="MRK 6:4">Marcos 6:4</ref>; <ref loc="LUK 4:24">Lucas 4:24</ref></char></note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Maibee bainhira Nia too iha nebaa, ema Galileia simu Nia ho diak tanba foin dadauk sira asisti festa Paskua iha Jerusalém, sira haree hotu buat nebee Nia halo iha nebaa.<note caller="+" style="x"><char style="xo" closed="false">4:45: </char><char style="xt" closed="false"><ref loc="JHN 2:23">João 2:23</ref></char></note> <verse eid="JHN 4:45" /><verse number="46" style="v" sid="JHN 4:46" />Iha Galileia, Jesus fila ba iha aldeia Kaná, fatin nee mak uluk Nia halo bee sai fali tua.</para>
  <para style="p" vid="JHN 4:46">Iha funsionariu boot ida hela iha sidade Kafarnaum, nia oan moras hela,<note caller="+" style="x"><char style="xo" closed="false">4:46: </char><char style="xt" closed="false"><ref loc="JHN 2:1-11">João 2:1-11</ref></char></note> <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />besik atu mate. Bainhira funsionariu nee rona katak Jesus mai tiha ona husi provinsia Judeia too iha Galileia, nia baa iha Kaná hasoru Jesus hodi husu ho haraik aan atu Jesus baa kura nia oan.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />Maibee Jesus hatete ba nia, “Imi sira nee so fiar bainhira imi haree milagre ho sinal oi-oin nebee halo imi admira. Se lae imi la fiar.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Funsionariu nee hatete, “Senhor, favor baa lalais, se lae hau nia oan mate.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Jesus hataan, “Ita bele fila ona, ita nia oan diak ona, la mate ida.” Funsionariu nee fiar Jesus nia liafuan nee, i nia fila kedas.<verse eid="JHN 4:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51" />Iha dalan klaran, nia atan sira mai hasoru nia hodi foo hatene dehan, “Ita boot nia oan diak fali ona.”<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Depois funsionariu nee husu ba sira, saa oras mak nia oan hetan fali isin diak. Nia atan sira hataan, “Horiseik lokraik tuku ida nia isin manas lakon.”<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Depois labarik nia aman hanoin fali katak, iha duni oras hanesan nee mak Jesus hatete ba nia, “Ita nia oan diak ona, la mate ida.” Nunee nia ho nia uma laran tomak fiar ba Jesus.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Jesus halo milagre nee bainhira Nia fila husi Judeia. Ida nee mak milagre segundu nebee Nia halo iha provinsia Galileia.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Nai Jesus kura ema ain aat ida iha bee kolan</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Hotu tiha Jesus baa iha Jerusalém atu tuir loron boot ema Judeu nian. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Iha nebaa iha bee kolan ida, varanda lima haleu, iha lian Ebreu naran Betesda. Bee kolan nee besik portaun boot naran Portaun Bibi Malae.<note caller="+" style="f"><char style="fr" closed="false">5:2: </char><char style="ft" closed="false">Evanjelhu João nee iha kopia barak husi tempu antigu. Barak hakerek “Betesda”, balu “Betsata”, balu “Betsaida”.</char></note> <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Ema moras barak mak toba hela iha varanda nee, hanesan ema matan delek, ema ain aat, ho ema liman-ain mate. [Sira hein hela bee nee nakdoko. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Tanba dala ruma Nai Maromak nia anju tuun mai halo bee nee nakdoko. Depois see mak tama uluk iha bee laran, nia moras saida deit hetan kura.]<note caller="+" style="f"><char style="fr" closed="false">5:3b-4</char><char style="ft" closed="false">Evanjelhu João nee iha kopia barak husi tempu antigu. Kopia nebee antigu liu la hakerek versikulu 3b-4 nee.</char></note><verse eid="JHN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5" />Iha mos mane ida ain aat lao la diak durante tinan tolu-nulu resin walu ona. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Bainhira Jesus haree nia latan hela iha nebaa, Jesus hatene katak ema nee moras kleur loos ona. Entaun Jesus husu ba nia, “O hakarak hetan isin diak ka?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Ema nee hataan, “Senhor, bainhira bee nakdoko, la iha ema ida atu ajuda hau tama ba iha bee laran. Bainhira hau hakaas aan atu tama, ema seluk tama uluk tiha ona.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Depois Jesus hatete ba nia, “Hamriik ona! Foti o nia biti, lao ona!” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Iha momentu nee kedas ema nee hetan isin diak, nia foti nia biti hodi lao.</para>
  <para style="p" vid="JHN 5:9">Loron nee loron Sabadu. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Nunee nai ulun Judeu sira hatete ba ema nebee foin hetan kura nee dehan, “Ohin loron Sabadu, lei bandu loron Sabadu la bele lori o nia biti.”<note caller="+" style="x"><char style="xo" closed="false">5:10: </char><char style="xt" closed="false"><ref loc="NEH 13:19">Neemias 13:19</ref>; <ref loc="JER 17:21">Jeremias 17:21</ref></char></note><verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Maibee nia hataan, “Ema nebee kura hau mak haruka hau dehan, ‘Foti o nia biti, lao ona!’ ”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Entaun sira husu ba nia, “Nia nee see fali mak haruka o foti o nia biti hodi lao?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ema nebee foin hetan kura nee la hatene see mak kura nia, tanba iha fatin nee ema barak, i Jesus sai tiha ona husi nebaa ho nonook.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />La kleur Jesus hetan fali ema nee iha uma kreda boot, i hatete ba nia, “Agora o isin diak ona. Kuidadu, la bele halo sala tan, se lae buat aat liu tan bele kona o.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Depois ema nee fila fali ba iha nai ulun Judeu sira hodi foo hatene katak, Ema nebee kura nia nee naran Jesus. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Nunee nai ulun Judeu sira komesa hatete aat Jesus tanba Nia kura ema iha loron Sabadu.<verse eid="JHN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />Maibee Jesus hatete ba sira, “Hau nia Aman servisu nunka para, Hau mos servisu nunee.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Jesus nia liafuan nee halo nai ulun Judeu sira hakarak liu tan atu oho Jesus, tanba Nia kontra beibeik regra loron Sabadu nian. Laos nee deit maibee Nia mos dehan Maromak mak Nia Aman rasik, nunee Nia halo Nia Aan hanesan fali Maromak.<verse eid="JHN 5:18" /></para>
  <para style="s">Nai Jesus foo sai katak Nia nee Nai Maromak nia Oan</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Rona nunee Jesus dehan ba sira, “Hau hatete lo-loos ba imi, Maromak nia Oan la bele halo buat ida mes-mesak, Nia haree buat nebee mak Nia Aman halo, Nia mos halo tuir. Saida deit mak Nia Aman halo, ida nee mak Nia halo. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Tanba Nia Aman hadomi Nia, i buat hotu-hotu nebee Nia Aman halo, hatudu ba Nia. Nia Aman sei hatudu ba Nia buat nebee makaas liu tan, halo imi admira. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Nia Aman halo moris fali ema mate, i foo moris rohan-laek ba sira. Nunee mos Nia Oan sei foo moris foun ba ema nebee mak Nia hili. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Nia Aman la foo justisa ba ema ida. Maibee Nia foo fiar tiha ona ba Nia Oan atu foo justisa ba ema, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />atu ema hotu respeita Nia Oan hanesan sira respeita Nia Aman. See deit mak la respeita Nia Oan, la respeita mos Nia Aman nebee haruka Nia mai.”<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Jesus hatutan tan dehan, “Hau hatete lo-loos ba imi, see deit mak rona Hau nia liafuan i fiar ba Ida nebee haruka Hau mai, sira hetan ona moris rohan-laek, sira sei la hetan kastigu. Sira sai tiha ona husi mate hodi tama ba moris rohan-laek. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Hau hatete lo-loos ba imi, too tempu ida, tempu nee mak komesa agora nee, ema nebee hanesan mate tiha ona tanba haketak aan husi Maromak, sira sei rona Maromak nia Oan nia lian. I see mak rona sei hetan moris.<verse eid="JHN 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 5:26" />Tanba Aman Maromak mak moris nia huun, i Nia foo tiha ona kbiit ba Nia Oan atu foo moris ba ema. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Nia mos foo tiha ona kbiit ba Nia Oan atu foo justisa ba ema, tanba Nia mak Ema Umanu nia Oan.<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />La bele hakfodak. Too loron ida, matebian sira hotu sei rona Maromak nia Oan nia lian. <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />Depois matebian sira nee sei sai mai. Sira nebee uluk halo buat diak, hetan moris rohan-laek. Maibee sira nebee uluk halo buat aat, sei hetan kastigu.<note caller="+" style="x"><char style="xo" closed="false">5:29: </char><char style="xt" closed="false"><ref loc="DAN 12:2">Daniel 12:2</ref></char></note><verse eid="JHN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />Hau la bele halo buat ida mes-mesak, Hau so foo justisa tuir buat nebee mak Hau rona husi Hau nia Aman. Justisa nebee Hau foo nee loos. Tanba Hau laos halo tuir Hau nia hakarak rasik. Maibee Hau halo tuir Hau nia Aman nia hakarak, tanba Nia mak haruka Hau mai.”<verse eid="JHN 5:30" /></para>
  <para style="s">Iha sasin barak foo sai kona ba Nai Jesus</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“Se karik Hau mesak mak foo sasin kona ba Hau nia Aan, entaun Hau nia sasin la vale ida. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Maibee iha Ida mak foo sasin kona ba Hau, nee mak Aman Maromak rasik. Hau hatene katak Nia sasin kona ba Hau nee loos.<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />Imi haruka ona ema ba iha João, i nia foo sasin ba buat nebee loos.<note caller="+" style="x"><char style="xo" closed="false">5:33: </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">João 1:19-27</ref>, <ref loc="JHN 3:27-30">3:27-30</ref></char></note> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Afinal Hau la presiza ema ida atu foo sasin kona ba Hau. Maibee Hau so foo hanoin fila fali ba imi kona ba João nia liafuan atu imi bele hetan salvasaun. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Bainhira João hela iha imi nia leet, nia hanesan ahi-oan nebee lakan iha tempu badak nia laran, i imi kontenti simu nia naroman nee.<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />Maibee iha buat seluk nebee foo sasin boot liu fali João nian, nee mak servisu nebee Hau nia Aman foo mai Hau atu halao too hotu. Servisu nee mak Hau halo durante nee, i servisu nee hatudu katak Hau nia Aman mak haruka Hau mai. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Hau nia Aman nebee haruka Hau mai nee, Nia rasik foo sasin kona ba Hau. Imi nunka rona Nia lian, i nunka haree Nia oin.<note caller="+" style="x"><char style="xo" closed="false">5:37: </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mateus 3:17</ref>; <ref loc="MRK 1:11">Marcos 1:11</ref>; <ref loc="LUK 3:22">Lucas 3:22</ref></char></note> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Imi la simu Nia liafuan, tanba imi lakohi fiar Ida nebee mak Nia haruka mai. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Imi badinas estuda Livru Sagradu, tanba imi hanoin katak liu husi Livru nee imi hetan moris rohan-laek. Afinal Livru Sagradu nee rasik foo sasin kona ba Hau, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />maibee imi lakohi mai iha Hau atu hetan moris.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Hau la buka atu ema gaba Hau. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Maibee Hau hatene imi nia laran, Hau hatene imi la hadomi Maromak. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Hau mai hodi Hau nia Aman nia naran maibee imi la simu Hau. Ema seluk mai hodi nia naran rasik, nee mak imi simu fali. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Imi la buka atu Maromak gaba imi, maski Nia mesak deit mak Maromak. Imi buka fali atu imi nia maluk sira mak gaba. Entaun oinsaa mak imi atu fiar mai Hau?<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />Keta hanoin dehan Hau sei hamriik iha Hau nia Aman nia oin hodi foo sala ba imi. Moisés mak sei foo sala ba imi, maski imi laran metin ba nia. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Se karik imi fiar Moisés nia liafuan, entaun imi fiar mos Hau, tanba nia hakerek tiha ona kona ba Hau. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Maibee imi la fiar buat nebee Moisés hakerek, nunee oinsaa mak imi atu fiar buat nebee Hau koalia?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Nai Jesus foo haan ema rihun lima resin</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mateus 14:13-21</ref>; <ref loc="MRK 6:30-44">Marcos 6:30-44</ref>; <ref loc="LUK 9:10-17">Lucas 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Hotu tiha Jesus ho Nia eskolante sira baa iha tasi Galileia nia sorin ba, tasi nee nia naran seluk mak Tiberiades. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Ema barak teb-tebes tuir Nia tanba sira haree milagre nebee mak Nia halo tiha ona ba ema moras sira. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Depois Jesus sae ba foho ida, i Nia tuur hamutuk ho Nia eskolante sira. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Iha tempu nee ema Judeu nia loron boot Paskua besik ona.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />Jesus hateke tuun, iha ema barak teb-tebes nadodon sae mai. Nunee Nia hatete ba Filipe, “Ita atu sosa paun iha nebee para sira hotu bele haan?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Nia hatete nunee para koko Filipe, afinal Nia rasik hatene ona saida mak Nia atu halo.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filipe hataan, “Ema badaen nia salariu fulan walu nian<note caller="+" style="f"><char style="fr" closed="false">6:7: </char><char style="ft" closed="false">João hakerek dehan, “</char><char style="it">denáriu</char> atus rua”. Iha tempu nebaa badaen sira loron ida manaan <char style="it">denáriu</char> ida.</note> mos la too atu sosa hahaan ba ema barak hanesan nee. Atu ema ida-ida hetan deit paun pedasuk ida mos la too.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Depois eskolante ida seluk naran André, Simão Pedro nia alin foo hatene dehan, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Labarik mane ida iha nee, nia lori paun baratu nian fuan lima ho ikan rua, maibee nee la too atu foo haan ba ema barak hanesan nee.”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Iha nebaa iha duut matak barak. Jesus foo hatene ba Nia eskolante sira dehan, “Haruka sira tuur.” Sira mos tuur iha duut leten. Ema sira nee maizoumenus rihun lima, nee mane deit, seidauk konta feto ho labarik.<verse eid="JHN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 6:11" />Depois Jesus foti paun nee i foo agradese ba Maromak. Hotu tiha Nia foo ba Nia eskolante sira hodi fahe ba ema sira nebee tuur nee. Ikan sira nee mos hanesan. Ema lubun boot nee haan too bosu.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Sira hotu bosu ona, Jesus haruka Nia eskolante sira dehan, “Tau hamutuk hahaan restu atu la bele estraga.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Nunee eskolante sira tau hamutuk hahaan restu husi paun fuan lima nebee ema barak haan nee, hamutuk bote sanulu resin rua nakonu.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Bainhira ema barak nee haree milagre nebee Jesus halo, sira dehan, “Tebes duni, Ema nee Profeta nebee atu mai iha mundu.” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Jesus hatene katak ema barak nee hakarak obriga Nia atu sai sira nia liurai, nunee Nia sai husi sira nia klaran hodi baa mes-mesak iha foho ida.<verse eid="JHN 6:15" /></para>
  <para style="s">Nai Jesus lao iha bee leten</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mateus 14:22-33</ref>; <ref loc="MRK 6:45-52">Marcos 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Rai besik kalan ona, Jesus nia eskolante sira tuun ba iha tasi ibun. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Rai nakukun ona, Jesus seidauk mai hamutuk ho sira. Nunee sira sae roo atu hakur tasi ba iha sidade Kafarnaum. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Sira lao dadauk, anin komesa huu makaas, i laloran mos boot. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Bainhira sira hean roo too tiha ona kilometru lima ka neen, sira haree Jesus lao mai iha bee leten, halo sira tauk teb-tebes. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Maibee Jesus dehan ba sira, “Nee Hau. Keta tauk!” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Rona nunee, sira kontenti simu Nia tama ba iha roo laran. Derepenti roo nee too iha fatin nebee sira atu baa.<verse eid="JHN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Ema barak nebee ohin Jesus foo haan nee sei hela iha tasi sorin. Aban fali sira hakarak haree tan Jesus. Sira hatene katak, horiseik roo ida deit mak para iha nebaa, i Jesus nia eskolante sira deit mak sae roo nee, Jesus la sae hamutuk ho sira. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />La kleur iha roo balu mai husi sidade Tiberiades. Roo sira nee para iha fatin nebee horiseik Nai Jesus foo agradese ba Maromak hodi foo paun ba ema barak nee haan. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Ema barak nee haree katak Jesus ho Nia eskolante sira nee la iha tiha ona. Nunee sira sae roo hirak nee hodi baa iha Kafarnaum buka Jesus.<verse eid="JHN 6:24" /></para>
  <para style="s">Nai Jesus mak Paun Moris nian</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Bainhira ema lubun boot nee too iha tasi sorin, sira hetan Jesus iha nebaa. Sira husu ba Nia, “Mestri too hori bainhira?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Jesus hataan, “Hau hatete lo-loos ba imi, imi buka Hau laos tanba imi aprende buat ruma husi milagre nebee mak Hau halo. Maibee imi buka Hau tanba paun nebee mak imi haan too bosu di-diak. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />La bele servisu para hetan deit hahaan nebee la dura. Maibee servisu para hetan hahaan nebee mak iha nafatin hodi foo moris tinan ba tinan. Hau, Ema Umanu nia Oan mak sei foo hahaan nee ba imi, tanba Aman Maromak foo fiar tiha ona mai Hau atu halo ida nee.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Depois sira husu ba Nia, “Ami tenki halo servisu saida atu bele halo tuir Maromak nia hakarak?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Jesus hataan, “Servisu nebee Maromak hakarak atu imi halo mak nee: Imi tenki fiar ba Ida nebee Nia haruka mai.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Sira husu fali, “Se nunee hatudu lai sinal ruma mai ami para ami bele haree hodi fiar. Ita Boot sei halo saida? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Uluk ita nia bei-ala sira haan paun manaa iha rai fuik maran, hanesan hakerek iha Livru Sagradu dehan, ‘Nia foo paun husi lalehan para sira haan.’ ”<note caller="+" style="x"><char style="xo" closed="false">6:31: </char><char style="xt" closed="false"><ref loc="EXO 16:4">Ézodu 16:4</ref>, <ref loc="EXO 15">15</ref>; <ref loc="PSA 78:24">Salmu 78:24</ref></char></note><verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Jesus dehan ba sira, “Hau hatete lo-loos ba imi, uluk imi nia bei-ala sira hetan paun husi lalehan, laos Moisés mak foo. Agora Paun lalehan nian lo-loos mos, Hau nia Aman mak foo ba imi. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Paun nebee Maromak foo mak Ema ida nebee tuun mai husi lalehan hodi foo moris rohan-laek ba ema iha mundu.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Sira hatete ba Nia, “Senhor, foo paun nee mai ami loro-loron.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Depois Jesus hatete, “Hau mak Paun nebee foo moris. See-see deit mak mai iha Hau, nia la hamlaha tan, i see mak fiar mai Hau, sei la hamrook tan. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Maibee Hau dehan tiha ona ba imi, maski imi haree tiha ona Hau mos, imi la fiar Hau nafatin. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Ema hotu nebee Hau nia Aman entrega tiha ona mai Hau, sira sei mai iha Hau. I kuandu sira mai iha Hau, Hau sei la duni sai sira. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Tanba Hau mai husi lalehan laos atu halo tuir Hau nia hakarak, maibee atu halo tuir Hau nia Aman nia hakarak, tanba Nia mak haruka Hau mai. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />I Nia hakarak mak nee: Ema nebee Nia entrega ona mai Hau, ida mos la bele lakon, i bainhira mundu nee remata, Hau halo sira moris fali husi mate. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Hau nia Aman hakarak atu see-see deit mak konhese katak Hau Maromak nia Oan i fiar mai Hau, sei hetan moris rohan-laek. I Hau sei halo moris fali sira bainhira mundu nee remata.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Entaun nai ulun Judeu sira komesa murmura kona ba Jesus tanba Nia dehan, “Hau mak Paun nebee tuun mai husi lalehan.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Sira dehan, “Nia nee Jesus, José nia oan. Ita konhese hela Nia inan-aman. Nusaa mak Nia bele dehan fali, Nia tuun mai husi lalehan? ”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Jesus hatete ba sira, “Imi la bele murmura tan. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Hau nia Aman mak haruka Hau mai. La iha ema ida bele mai mesak iha Hau. So Hau nia Aman lori nia mak foin bele. I see deit mak mai iha Hau, Hau sei halo nia moris fali bainhira mundu remata. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Iha Livru Sagradu Maromak nia profeta hakerek dehan, ‘Maromak sei hanorin ema hotu.’ Nunee ema hotu nebee rona Hau nia Aman i aprende husi Nia sei mai iha Hau.<note caller="+" style="x"><char style="xo" closed="false">6:45: </char><char style="xt" closed="false"><ref loc="ISA 54:13">Isaias 54:13</ref></char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />La iha ema ida mak haree ona Aman Maromak. So Hau deit mak haree tiha ona Nia tanba Hau mai husi Nia.<verse eid="JHN 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47" />Hau hatete lo-loos ba imi, ema nebee fiar mai Hau, sei hetan moris rohan-laek. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Hau mak Paun nebee foo moris. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Imi nia bei-ala sira haan duni paun manaa iha rai fuik maran, maibee too ikus sira mate. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Maibee Paun nebee tuun mai husi lalehan agora dadauk iha nee hela. See deit mak haan Paun nee sei la mate. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Hau mak Paun Moris nian nebee tuun ona husi lalehan. See deit mak haan Paun Moris nian nee sei moris tinan ba tinan. Paun nee mak Hau nia isin nebee Hau foo atu ema iha mundu nee hetan moris.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Rona nunee, ema Judeu sira komesa haksesuk malu makaas hodi dehan, “Oinsaa mak Ema nee bele foo Nia isin atu ita haan?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Entaun Jesus dehan ba sira, “Nudar Ema Umanu nia Oan, Hau hatete lo-loos ba imi, imi tenki haan Hau nia isin i hemu Hau nia raan, se lae imi la hetan moris. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />See deit mak haan Hau nia isin ho hemu Hau nia raan hetan ona moris rohan-laek. I Hau sei halo moris fali nia bainhira mundu nee remata. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Tanba Hau nia isin ho Hau nia raan mak haan-hemu lo-loos. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />See deit mak haan Hau nia isin i hemu Hau nia raan, nia ida deit ho Hau. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Hau nia Aman mak moris nia huun, Nia mak haruka Hau mai, i Hau moris tanba Nia. Nunee mos ema nebee haan Hau nia isin sei moris tanba Hau. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Hau mak Paun nebee tuun mai ona husi lalehan. Ema nebee mak haan Paun nee sei moris tinan ba tinan. Laos hanesan paun manaa nebee imi nia bei-ala sira haan, maski sira haan maibee too ikus mate.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Jesus hanorin buat sira nee iha uma kreda laran iha Kafarnaum.<verse eid="JHN 6:59" /></para>
  <para style="s">Nai Jesus nia eskolante barak lakohi tuir tan Nia</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Rona Jesus nia hanorin nee, ema barak nebee baibain tuir Nia hodi sai Nia eskolante komesa dehan ba malu, “Nia hanorin nee susar atu kompriende, see mak bele simu?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Jesus hatene katak Nia eskolante sira murmura ba malu kona ba buat nebee Nia hanorin nee. Nunee Nia hatete ba sira dehan, “Hau nia hanorin nee xoke imi nia laran ka? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Entaun aban-bainrua imi haree Hau, Ema Umanu nia Oan sae fila fali ba Hau nia fatin uluk, imi sei hanoin saida loos?<verse eid="JHN 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="JHN 6:63" />Maromak nia Espiritu mak foo moris, ema la bele. Liafuan nebee Hau hanorin nee mai husi Maromak nia Espiritu hodi foo moris ba ema. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Maski nunee iha ema balu iha imi nia leet la fiar.” Jesus hatete nunee tanba Nia hatene nanis ona see mak la fiar, i see mak atu faan Nia.<verse eid="JHN 6:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="JHN 6:65" />Jesus hatutan tan dehan, “Tanba nee mak Hau hatete tiha ona ba imi katak, la iha ema ida bele mai mesak iha Hau. So Hau nia Aman ajuda nia mak foin nia bele mai iha Hau.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Komesa husi loron nee Jesus nia eskolante sira barak husik tiha Nia i lakohi tuir tan. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Jesus husu ba Nia eskolante nain sanulu resin rua dehan, “Imi sira nee mos hakarak atu husik Hau ka?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Simão Pedro hataan, “Nai, ami atu baa loos nebee? Ita Boot nia liafuan mak foo moris rohan-laek. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Ami fiar, i ami hatene katak Ita Boot mak Ema Santu nebee Maromak haruka mai.”<note caller="+" style="x"><char style="xo" closed="false">6:69: </char><char style="xt" closed="false"><ref loc="MAT 16:16">Mateus 16:16</ref>; <ref loc="MRK 8:29">Marcos 8:29</ref>; <ref loc="LUK 9:20">Lucas 9:20</ref></char></note><verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Depois Jesus hataan, “Hau rasik mak hili imi sanulu resin rua nee sai Hau nia eskolante. Maibee imi ida diabu.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Jesus koalia kona ba Judas, Simão Iscariotes nia oan. Maski Judas nee eskolante ida husi sira nain sanulu resin rua, maibee too ikus nia mak faan Jesus.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Nai Jesus nia alin sira la fiar ba Nia</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Hotu tiha Jesus lao haleu provinsia Galileia laran. Nia lakohi baa iha provinsia Judeia, tanba nai ulun Judeu sira iha nebaa hakarak oho Nia. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Iha tempu nebaa ema Judeu nia loron boot nebee bolu “Baraka” besik ona.<note caller="+" style="f"><char style="fr" closed="false">7:2: </char><char style="ft" closed="false">Iha Selebrasaun Baraka, ema Israel hela iha baraka okos durante loron walu. Nunee sira hanoin fila fali katak sira nia bei-ala sira hela iha baraka durante tinan haat-nulu bainhira Maromak lori sira sai husi rai Ejitu.</char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Nunee Jesus nia alin sira hatete ba Nia, “Diak liu sai husi fatin nee hodi baa iha Judeia, atu Ita Boot nia eskolante sira iha nebaa bele haree Ita Boot nia milagre. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Tanba see mak hakarak sai boot, nia la bele subar buat nebee nia halo. Se Ita Boot halo ona milagre, entaun hatudu Aan ba mundu atu ema hotu haree.” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Sira hatete nunee tanba maski sira Jesus nia alin maibee sira la fiar ba Nia.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Nunee Jesus hataan ba sira dehan, “Agora Hau nia tempu seidauk too. Maibee ba imi, tempu saida deit imi bele baa. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ema mundu nee laos odi imi, sira odi mak Hau tanba Hau foo hatene beibeik ba sira katak sira nia hahalok aat. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Imi baa tuir selebrasaun nee. Hau la baa tanba Hau nia tempu seidauk too.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Koalia tiha nunee, Nia hela iha Galileia.<verse eid="JHN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Maibee bainhira Nia alin sira baa tiha, Nia mos baa nonook deit tuir festa nee, ema seluk la hatene. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Iha festa nee, nai ulun Judeu sira buka Jesus hodi husu tuun-sae dehan, “Ema nee iha nebee?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Ema barak nebee tuir festa nee komesa bis-bisu ba malu kona ba Jesus. Iha ema balu dehan, “Nia ema diak.” Balu tan dehan, “Lae, Nia lohi ema barak lao sala dalan.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Maibee la iha ema ida mak brani koalia mo-moos kona ba Nia, tanba sira tauk nai ulun Judeu sira.<verse eid="JHN 7:13" /></para>
  <para style="s">Nai Jesus hanorin iha loron boot Judeu nian</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Selebrasaun Baraka nee lao too klaran ona, Jesus baa iha uma kreda boot hodi hanorin. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Nai ulun Judeu sira admira hodi dehan, “Ema nee laos eskola boot ida. Nia aprende buat sira nee husi nebee?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Nunee Jesus dehan, “Buat nebee Hau hanorin nee laos mai husi Hau nia Aan rasik, maibee mai husi Ida nebee haruka Hau mai. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Ema nebee prontu halo tuir Maromak nia hakarak, nia sei hatene, Hau nia hanorin mai husi Maromak ka mai husi Hau nia hanoin rasik. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />See mak hanorin husi nia hanoin rasik, nia buka atu ema foti aas nia. Maibee see mak buka atu foti aas Ida nebee haruka nia mai, ema nee sempre koalia deit buat loos i la hatene bosok. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Moisés foo lei ba imi, maibee imi ida la halo tuir lei nee. Entaun nusaa mak imi atu oho fali Hau?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Ema lubun boot hataan, “Diabu tama ona O nia laran! See mak atu oho O?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Jesus hataan, “Foin dadauk Hau halo milagre ida iha loron Sabadu, imi hotu hakfodak. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Maibee se labarik mane ida nia loron atu sunat monu iha Sabadu, imi rasik mos sunat nia iha loron nee, atu nunee imi kumpri Moisés nia lei. Afinal sunat nee nia huun laos Moisés nia lei, maibee tuun husi bei-ala sira.<note caller="+" style="x"><char style="xo" closed="false">7:22: </char><char style="xt" closed="false"><ref loc="GEN 17:10">Jénesis 17:10</ref>; <ref loc="LEV 12:3">Levítiku 12:3</ref></char></note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Entaun atu halo tuir Moisés nia lei, imi sunat labarik mane iha loron Sabadu. Se nunee, nusaa mak imi hirus Hau tanba Hau kura ema moras iha loron Sabadu? Afinal Hau halo nia isin lolon tomak sai diak.<note caller="+" style="x"><char style="xo" closed="false">7:23: </char><char style="xt" closed="false"><ref loc="JHN 5:9">João 5:9</ref></char></note> <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Tetu ho lo-loos mak foin dehan ema seluk sala ka la sala. La bele ona foo sala ba ema tuir deit buat nebee imi haree husi liur.”<verse eid="JHN 7:24" /></para>
  <para style="s">Nai Jesus nee Mesias ka laos?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Depois ema Jerusalém balu husu ba malu dehan, “Ema nee mak nai ulun sira buka hela atu oho nee ka lae? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Haree took, agora Nia koalia iha ema barak nia oin, i nai ulun sira la hatete buat ida hasoru Nia. Keta halo be sira konhese ona katak Nia mak Mesias, Salvador nebee Maromak atu haruka mai. <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Maibee oinsaa mak bele? Tanba bainhira Mesias mai, la iha ema ida mak hatene Nia mai husi nebee. Ema nee, ita hatene hela Nia.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Iha tempu nee, Jesus sei hanorin hela iha area uma kreda boot. Bainhira Nia rona ema koalia nunee, Nia hatete ba ema barak nee ho lian makaas dehan, “Imi konhese duni Hau, i imi hatene Hau husi nebee. Hau mai laos tanba Hau nia hakarak rasik. Ida nebee haruka Hau mai, Nia sempre koalia lia loos. Imi la konhese Nia, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />maibee Hau konhese Nia, tanba Hau mai husi Nia i Nia mak haruka Hau mai.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Rona nunee, sira hakarak atu kaer Jesus, maibee la iha ida mak konsege tau liman ba Nia, tanba Nia loron seidauk too. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Maski nunee povu barak komesa fiar ba Nia. Sira dehan ba malu, “Ema nee halo milagre barak. Kuandu Mesias mai, Nia atu halo liu fali Ema nee ka?”<verse eid="JHN 7:31" /></para>
  <para style="s">Nai ulun sira haruka ema baa kaer Nai Jesus</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Ema Farizeu sira rona hela ema barak bis-bisu ba malu nunee kona ba Jesus. Entaun sira hamutuk ho nai lulik nia ulun sira haruka seguransa uma kreda boot nian atu baa kaer Jesus.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Jesus hatete, “Hau hamutuk ho imi iha tempu badak deit, depois Hau sei fila fali ba Ida nebee haruka Hau mai. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Imi sei buka Hau, maibee la hetan Hau, tanba imi la bele baa iha fatin nebee mak Hau hela.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Nunee nai ulun Judeu sira hatete ba malu, “Ema nee atu baa iha nebee mak ita la bele hetan Nia? Keta halo be Nia atu baa iha ita nia maluk Judeu sira nebee namkari iha ema jentiu sira nia rai hodi hanorin ema jentiu sira iha nebaa. <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Ohin Nia dehan, ‘Imi sei buka Hau maibee la hetan Hau.’ I ‘Imi la bele baa iha fatin nebee mak Hau hela.’ Nia liafuan nee dehan saida?”<verse eid="JHN 7:36" /></para>
  <para style="s">Bee nebee foo moris</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Iha loron ikus selebrasaun Baraka nian, loron nee mak loron importante liu, Jesus hamriik foo sai ho lian makaas dehan, “See deit mak hamrook, mai iha Hau hodi hemu bee.<note caller="+" style="x"><char style="xo" closed="false">7:37: </char><char style="xt" closed="false"><ref loc="LEV 23:36">Levítiku 23:36</ref></char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Hanesan hakerek ona iha Livru Sagradu dehan, ema nebee fiar mai Hau, ‘bee moris nian sei suli sai husi nia laran.’ ”<note caller="+" style="x"><char style="xo" closed="false">7:38: </char><char style="xt" closed="false"><ref loc="EZK 47:1-12">Ezequiel 47:1-12</ref>; <ref loc="ZEC 14:8">Zacarias 14:8</ref>; <ref loc="NEH 9:15">Neemias 9:15</ref>,<ref loc="NEH 9:19-20">19-20</ref></char></note> <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Nunee Jesus koalia kona ba Maromak nia Espiritu, ema nebee fiar ba Jesus sei simu Espiritu nee. Maibee momentu Jesus koalia, Maromak seidauk foo Nia Espiritu tanba Maromak seidauk foti aas Jesus.<verse eid="JHN 7:39" /></para>
  <para style="s">Povu barak haksesuk malu kona ba Nai Jesus</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Rona Jesus koalia nunee, povu balu dehan, “Loos duni. Ema nee Profeta nebee mak ita hein hela.”<note caller="+" style="x"><char style="xo" closed="false">7:40: </char><char style="xt" closed="false"><ref loc="DEU 18:18-19">Deuteronómiu 18:18-19</ref></char></note><verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Iha balu dehan, “Nia nee Mesias, Salvador nebee Maromak atu haruka mai.”</para>
  <para style="p" vid="JHN 7:41">Balu tan husu, “Mesias mai husi Galileia fali ka? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Iha Livru Sagradu dehan Mesias sei mai husi liurai David nia jerasaun, husi David nia aldeia Belém.”<note caller="+" style="x"><char style="xo" closed="false">7:42: </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 Samuel 7:12</ref>; <ref loc="MIC 5:2">Mikeias 5:2</ref></char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Nunee povu barak haksesuk malu kona ba Jesus. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Sira balu hakarak kaer Jesus maibee la iha ida mak konsege tau liman ba Nia.<verse eid="JHN 7:44" /></para>
  <para style="s">Nai ulun Judeu sira lakohi fiar ba Nai Jesus</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Too ikus seguransa uma kreda boot nian fila fali ba nai lulik nia ulun sira ho ema Farizeu sira. Sira nee husu ba seguransa dehan, “Nusaa mak imi la lori Nia mai?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Sira hataan, “Seidauk iha ema ida mak hanorin hanesan Ema nee.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Ema Farizeu sira nee dehan, “Keta halo be Nia lohi tan imi. <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Ami nai ulun sira ho Farizeu sira fiar ba Nia ka? La iha! <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Maibee povu sira nee beik, la hatene Moisés nia lei. Malisan sei kona sira.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Iha nebaa iha ema Farizeu ida naran Nicodemos, nia mak uluk baa hasoru Jesus. Nia hatete ba sira,<note caller="+" style="x"><char style="xo" closed="false">7:50: </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">João 3:1-2</ref></char></note> <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Tuir ita nia lei, ita desidi kedas atu kastigu ema ka, ita rona uluk lai husi nia ibun kona ba saida mak nia halo, depois mak foin tesi nia lia?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Sira hataan, “O mos ema Galileia ka?! Baa buka di-diak iha Livru Sagradu, o sei hatene katak la iha profeta ida mak mai husi Galileia.”<verse eid="JHN 7:52" /></para>
  <para style="s">Feto ida nebee halo sala seksual</para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />[Hotu tiha sira ida-idak fila ba sira nia uma.<note caller="+" style="f"><char style="fr" closed="false">7:53—8:11: </char><char style="ft" closed="false">Kopia Evanjelhu João husi tempu antigu barak. Istoria ida nee tama iha kopia balu, maibee la tama iha kopia nebee antigu liu.</char></note><verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Maibee Jesus baa iha foho Oliveira. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Iha dadeer-saan deit, Nia baa fali iha area uma kreda boot. Ema barak nadodon mai iha Nia, i Nia tuur hodi hanorin sira.<verse eid="JHN 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 8:3" />Depois mestri relijiaun ho ema Farizeu sira lori feto ida ba iha Jesus. Feto nee ema kaer toman bainhira nia halo hela relasaun seksual ho ema nia laen. Sira obriga feto nee hamriik iha ema barak nia oin. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Depois sira husu ba Jesus, “Mestri, feto nee ema kaer toman bainhira nia halo hela relasaun seksual ho ema nia laen. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Tuir Moisés nia lei, feto hanesan nee ita tenki tuda mate ho fatuk. Tuir Ita Boot nia hanoin oinsaa?”<note caller="+" style="x"><char style="xo" closed="false">8:5: </char><char style="xt" closed="false"><ref loc="LEV 20:10">Levítiku 20:10</ref>; <ref loc="DEU 22:22-24">Deuteronómiu 22:22-24</ref></char></note> <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Sira husu nunee atu lasu Nia tanba sira buka razaun atu foo sala ba Nia.<note caller="+" style="f"><char style="fr" closed="false">8:6: </char><char style="ft" closed="false">Se Jesus dehan lalika oho, sira bele foo sala ba Nia tanba la tuir lei Moisés nian. Se Jesus dehan tenki oho, sira bele kesar iha governador Roma tanba iha tempu nebaa ema Judeu la iha direitu atu desidi kastigu mate ema.</char></note></para>
  <para style="p" vid="JHN 8:6">Maibee Jesus hakruuk i hakerek iha rai ho Nia liman fuan. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Nai ulun sira husu beibeik ba Nia. Nunee Nia hamriik i hatete ba sira, “Imi sira nee, see mak nunka halo sala, nia mak tuda uluk fatuk ba feto nee.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Depois Nia hakruuk fali i hakerek iha rai.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />Bainhira sira rona Jesus nia liafuan nee, sira lao ida-idak nian, komesa husi katuas sira too joven. Ikus mai Jesus mesak iha nebaa ho feto nee. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Depois Jesus hamriik fali hodi husu ba feto nee, “Senhora, ema sira ohin nee iha nebee tiha ona? La iha ema ida mak atu kastigu senhora ka?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Feto nee hataan, “La iha Senhor!”</para>
  <para style="p" vid="JHN 8:11">Jesus hatete ba nia, “Hau mos la kastigu ita. Agora bele baa ona. Maibee la bele halo sala tan.”]<verse eid="JHN 8:11" /></para>
  <para style="s">Nai Jesus mak naroman mundu nian</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Hotu tiha Jesus koalia tan ho ema lubun boot nee dehan, “Hau mak naroman mundu nian. See deit mak tuir Hau, nia sei moris iha naroman nee nia laran. Nia dalan la nakukun tan ona.”<note caller="+" style="x"><char style="xo" closed="false">8:12: </char><char style="xt" closed="false"><ref loc="MAT 5:14">Mateus 5:14</ref>; <ref loc="JHN 9:5">João 9:5</ref></char></note><verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Depois ema Farizeu sira hatete, “O mesak mak foo sasin kona ba O nia Aan, entaun O nia sasin nee la vale ida.”<note caller="+" style="x"><char style="xo" closed="false">8:13: </char><char style="xt" closed="false"><ref loc="JHN 5:31">João 5:31</ref></char></note><verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Jesus hataan dehan, “Maski Hau mesak mak foo sasin kona ba Hau nia Aan, maibee sasin nebee Hau foo nee loos nafatin. Tanba Hau hatene hela, Hau mai husi nebee i Hau sei baa iha nebee, maibee imi la hatene Hau husi nebee i sei baa iha nebee. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Imi tesi lia tuir dalan mundu nian, Hau laos mai atu tesi ema ida nia lia. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Maibee se Hau tesi lia, Hau halo ho lo-loos. Tanba Hau laos foo justisa mes-mesak, maibee Hau hamutuk ho Hau nia Aman nebee mak haruka Hau mai. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Iha imi nia lei dehan, ema nain rua foo sasin nebee hanesan mak foin sasin nee vale. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Iha Testemunhu rua mak foo sasin kona ba Hau. Ida mak Hau rasik, Ida seluk mak Hau nia Aman nebee haruka Hau mai.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Entaun sira husu ba Nia, “O nia Aman iha nebee?”</para>
  <para style="p" vid="JHN 8:19">Jesus hataan, “Imi la konhese Hau ho Hau nia Aman. Se karik imi konhese Hau, entaun imi mos konhese Hau nia Aman.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Jesus hatete buat sira nee bainhira Nia hanorin iha area uma kreda boot besik kaixa oferta. Maski Nia hanorin iha fatin nee, maibee la iha ema ida mak kaer Nia, tanba Nia loron seidauk too.<verse eid="JHN 8:20" /></para>
  <para style="s">Nai ulun Judeu sira la kompriende Nai Jesus nia hanorin</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Dala ida tan Jesus hatete ba ema barak nee, “Hau sei baa, i imi sei buka Hau. Maibee imi la bele baa iha fatin nebee mak Hau baa, i imi sei mate ho imi nia sala.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Rona nunee nai ulun Judeu sira husu ba malu, “Nia atu oho Aan karik. Tanba nee mak Nia dehan, ‘Imi la bele baa iha fatin nebee mak Hau baa.’ ”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Maibee Jesus hatete ba sira, “Imi husi kraik, Hau husi leten nebaa. Imi ema mundu nian, Hau lae. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Tanba nee mak Hau hatete ba imi katak imi sei mate ho imi nia sala. Se imi la fiar katak Hau mak Ida nebee imi hein hela nee,<note caller="+" style="f"><char style="fr" closed="false">8:24 </char><char style="ft" closed="false">Lian Gregu iha nee besik liu liafuan Portuges “Eu Sou”, maibee ita tradus ba Tetun la bele. Matenek nain kona ba Biblia, barak dehan ida nee hatudu ba Nai Maromak nia naran. (Haree Ézodu 3:14-15.) Liafuan nee mos hakerek iha João 8:28 ho 8:58.</char></note> imi sei mate duni ho imi nia sala.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Sira husu ba Jesus, “Entaun Ita Boot nee see fali?”</para>
  <para style="p" vid="JHN 8:25">Jesus hataan, “Hori uluk too agora Hau foo hatene tiha ona kona ba Hau nia Aan. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Tuir loos Hau bele hatete buat barak kona ba imi hodi hatudu sai imi nia sala. Maibee Hau laos atu halo ida nee. Ida nebee haruka Hau mai nee sempre koalia buat nebee loos. I saida mak Hau rona husi Nia, nee deit mak Hau hatoo ba ema iha mundu nee.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Sira la kompriende katak Jesus koalia kona ba Nia Aman iha lalehan. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Tanba nee Jesus dehan, “Bainhira imi hasae Hau, Ema Umanu nia Oan ba iha fatin aas mak foin imi hatene katak Hau mak Ida nebee imi hein hela nee. I imi sei hatene katak Hau la halo buat ida mes-mesak, maibee Hau koalia deit buat nebee mak Hau nia Aman hanorin tiha ona mai Hau. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Ida nebee haruka Hau mai, Nia sempre hamutuk ho Hau, Nia nunka husik Hau mesak, tanba Hau sempre halo haksolok Nia laran.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Bainhira Jesus koalia nunee, ema barak komesa fiar ba Nia.<verse eid="JHN 8:30" /></para>
  <para style="s">Ema nia hahalok hatudu ema nee tuir see</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Jesus hatete ba ema Judeu sira nebee fiar tiha ona ba Nia dehan, “Se imi kaer metin Hau nia hanorin, imi Hau nia eskolante duni. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Nunee imi sei hatene lia loos, i lia loos nee sei halo imi livre.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Sira hataan, “Ami nee Abraão nia jerasaun, ami nunka sai ema ida nia atan. Nusaa mak Ita Boot dehan, ami sei sai livre?”<note caller="+" style="x"><char style="xo" closed="false">8:33: </char><char style="xt" closed="false"><ref loc="MAT 3:9">Mateus 3:9</ref>; <ref loc="LUK 3:8">Lucas 3:8</ref></char></note><verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Jesus hataan, “Hau hatete lo-loos ba imi, see mak halo sala, nia sai ona atan ba sala. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Atan ida la bele laran metin atu hela nafatin ho patraun nia familia. So patraun nia oan rasik mak nafatin iha familia nee too tinan ba tinan. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Entaun se Patraun nia Oan mak halo imi livre, imi livre duni.<verse eid="JHN 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 8:37" />Hau hatene imi nee Abraão nia jerasaun, maibee imi hakarak oho fali Hau, tanba imi lakohi simu Hau nia hanorin. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Hau foo hatene ba imi saida mak Hau nia Aman hatudu ona mai Hau. Maibee imi halo saida mak imi nia aman hatete ona ba imi.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Sira hataan, “Ami nia aman mak Abraão.”</para>
  <para style="p" vid="JHN 8:39">Jesus dehan, “Se imi Abraão nia jerasaun duni, entaun imi sei halo tuir Abraão nia hahalok. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Maibee imi lae. Imi sira nee buka dalan atu oho Hau, maski Hau foo hatene ba imi lia loos nebee Hau rona husi Maromak. Buat nebee imi halo nee, Abraão nunka halo. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Imi halo tuir fali saida mak imi nia aman rasik halo.”</para>
  <para style="p" vid="JHN 8:41">Sira hataan, “Ami nee laos oan hili. Ami nia Aman ida deit, nee mak Maromak rasik, aman seluk la iha.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Jesus dehan ba sira, “Se Maromak mak imi nia Aman duni, entaun imi sei hadomi Hau, tanba Hau mai husi Maromak. Hau laos mai tanba Hau nia hakarak rasik, maibee Maromak mak haruka Hau mai. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Nusaa mak imi la kompriende buat nebee Hau koalia? Tanba imi lakohi rona.<verse eid="JHN 8:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 8:44" />Imi nia aman mak Satanás, imi gosta tuir imi nia aman nee nia hakarak. Hori uluk kedas Satanás nee oho door i sempre kontra lia loos, tanba lia loos la bele hela iha nia laran. Bainhira nia koalia, nia bosok, tanba nia kakutak nakonu ho buat bosok deit. Nia rasik bosok-teen, i Nia mak bosok-teen hotu-hotu nia aman. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Maibee Hau foo sai buat nebee loos ba imi, nee mak imi lakohi fiar Hau. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Husi imi sira nee, see mak bele hatudu dehan, Hau halo sala? Se Hau koalia buat nebee loos, nusaa mak imi lakohi fiar Hau?<verse eid="JHN 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 8:47" />Ema nebee mai husi Maromak, nia rona Maromak nia liafuan. Maibee imi laos husi Maromak, tanba nee mak imi lakohi rona.”<verse eid="JHN 8:47" /></para>
  <para style="s">Nai Jesus boot liu ema Judeu nia bei-ala Abraão</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Entaun ema Judeu sira hatete ba Jesus, “Ami dehan nanis katak O nee ema Samaria, diabu tama tiha ona O. Nee loos duni.”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Jesus hatete, “Diabu la tama iha Hau ida. Hau respeita Hau nia Aman, imi hatuun fali Hau. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Hau la buka atu ema foti aas Hau, maibee iha Ida mak hakarak atu ema foti aas Hau. Nia mak sei desidi see mak loos i see mak sala.<verse eid="JHN 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 8:51" />Hau hatete lo-loos ba imi, see mak halo tuir Hau nia liafuan, nia sei la mate.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Rona nunee, ema Judeu sira dehan, “Agora ami hatene mo-moos katak diabu tama iha O nia laran! Abraão rasik mate tiha ona, profeta sira mos mate ona, maibee O dehan, see mak halo tuir O nia liafuan sei la mate. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />O hanoin O makaas liu ami nia bei-ala Abraão ka? Afinal Abraão mate tiha ona, profeta sira mos mate ona. O hanoin O nee see fali?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Jesus hataan, “Se Hau rasik mak foti aas Hau nia Aan, nee la iha folin ida. Maibee Ida nebee foti aas Hau mak Hau nia Aman, Nia nee mak imi bolu imi nia Maromak. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Afinal imi la konhese Nia. Hau konhese Nia, se karik Hau dehan Hau la konhese Nia, entaun Hau bosok-teen hanesan mos imi. Maibee Hau konhese duni Nia i halo tuir Nia liafuan. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Imi nia bei-ala Abraão hakarak teb-tebes atu haree Hau mai. Bainhira nia hanoin kona ba Hau nia loron, nia laran haksolok. Nia haree duni, i nia kontenti.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Depois ema Judeu sira dehan ba Nia, “O nia tinan seidauk too lima-nulu maibee O haree tiha ona Abraão ka?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Jesus hataan, “Hau hatete lo-loos ba imi, molok Abraão moris, Hau iha uluk ona.”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Rona nunee, sira foti fatuk atu tuda mate Nia tanba Nia halo Nia Aan hanesan Maromak. Maibee Jesus lao helik tiha husi sira nia klaran hodi sai husi area uma kreda boot.<note caller="+" style="x"><char style="xo" closed="false">8:59: </char><char style="xt" closed="false"><ref loc="JHN 5:18">João 5:18</ref></char></note><verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Nai Jesus kura ema matan delek ida</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Jesus lao dadauk, Nia haree mane ida nebee moris mai matan delek nanis. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Nia eskolante sira husu, “Mestri, see nia sala mak halo ema nee moris mai matan delek? Nia sala rasik ka nia inan-aman nian?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Jesus hataan, “Nia matan delek laos tanba nia sala rasik ka tanba nia inan-aman nia sala. Maibee nia sai nunee para ema bele haree Maromak nia kbiit iha nia. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Maromak mak haruka Hau mai. Ita tenki halao Nia servisu durante rai sei loron. Kuandu rai kalan ona, ema ida la bele halao servisu tan. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Durante Hau sei iha mundu nee, Hau mak naroman mundu nian.”<note caller="+" style="x"><char style="xo" closed="false">9:5: </char><char style="xt" closed="false"><ref loc="MAT 5:14">Mateus 5:14</ref>; <ref loc="JHN 8:12">João 8:12</ref></char></note><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Koalia tiha nunee Jesus tafui kabeen ba rai, kahur ho rai halo tahu, depois kose ba ema nee nia matan. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Nia hatete ba ema nee, “Baa fase o nia matan iha kolan Siloé.” (Siloé katak “haruka”.) Entaun ema nee baa fase nia matan. Bainhira nia fila fali, nia bele haree.<note caller="+" style="x"><char style="xo" closed="false">9:7: </char><char style="xt" closed="false"><ref loc="GEN 49:10">Jénesis 49:10</ref>; <ref loc="2KI 20:20">2 Liurai 20:20</ref>; <ref loc="ISA 8:6">Isaias 8:6</ref></char></note><verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Nia vizinhu sira ho mos ema seluk nebee baibain haree nia husu ezmola hatete ba malu dehan, “Ema nee mak baibain tuur hodi husu ezmola nee ka lae?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Iha balu dehan, “Nia duni.”</para>
  <para style="p" vid="JHN 9:9">Balu dehan, “Lae, nia oin mak atu hanesan.”</para>
  <para style="p" vid="JHN 9:9">Maibee ema nee rasik dehan, “Hau duni.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Nunee sira husu, “Entaun halo nusaa mak o nia matan bele haree?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Nia hataan, “Ema ida naran Jesus halo tahu kose ba hau nia matan, i haruka hau baa fase iha bee Siloé. Hau baa fase tiha, depois hau bele haree.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Sira husu fali, “Ema nee iha nebee?”</para>
  <para style="p" vid="JHN 9:12">Nia hataan, “Hau la hatene.”<verse eid="JHN 9:12" /></para>
  <para style="s">Farizeu sira investiga ema nebee uluk matan delek</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Depois ema lori mane nebee uluk matan delek nee ba iha ema husi grupu Farizeu. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Tanba loron nebee Jesus halo tahu hodi kura ema matan delek nee loron Sabadu, ema Judeu nia loron deskansa. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Nunee ema Farizeu sira husu ba ema nee, “Halo nusaa mak o nia matan bele haree?”</para>
  <para style="p" vid="JHN 9:15">Nia hataan, “Nia kose tahu ba iha hau nia matan, depois hau baa fase tiha, agora hau bele haree.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Ema Farizeu balu dehan, “Ema nee laos mai husi Maromak, tanba Nia halo fali servisu iha loron Sabadu.”</para>
  <para style="p" vid="JHN 9:16">Maibee balu dehan, “Sala nain ida bele halo milagre hanesan nee ka?” Nunee sira haksesuk malu.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Too ikus ema Farizeu sira husu fali ba ema nebee uluk matan delek nee dehan, “Nia kura o nia matan. Entaun oinsaa o nia hanoin kona ba Nia?”</para>
  <para style="p" vid="JHN 9:17">Ema nee hataan, “Nia Maromak nia profeta ida.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Maibee nai ulun Judeu sira nee la fiar nafatin katak, ema nee uluk matan delek i agora bele haree. Nunee sira haruka ema baa bolu nia inan-aman mai. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Depois nai ulun sira nee husu dehan, “Ema nee imi nia oan ka? Nia mak imi dehan moris mai matan delek ka? Se nunee halo nusaa mak nia bele haree?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Nia inan-aman hataan, “Loos duni, nia ami nia oan. Ami hatene nia moris mai matan delek. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Maibee oinsaa mak nia bele haree, ami la hatene. Ami mos la hatene see mak kura nia matan. Ita boot sira bele husu rasik ba nia. Nia boot ona, nia bele hataan mesak.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Nia inan-aman hataan nunee tanba sira tauk. Tanba nai ulun Judeu sira kombina malu tiha ona katak see mak foo sai dehan Jesus mak Mesias, nia la bele tama tan iha uma kreda. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Nee mak nia inan-aman dehan, “Nia boot ona, ita boot sira bele husu rasik ba nia.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Nunee nai ulun Judeu sira bolu fila fali ema nebee uluk matan delek nee hodi dehan, “O jura took iha Maromak nia oin atu hataan ho lo-loos. Ami hatene katak Ema nee sala nain ida.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Nia hataan, “Ema nee sala nain ka lae, hau la hatene. Buat nebee hau hatene mak uluk hau matan delek, maibee agora hau bele haree.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Nunee sira husu fali, “Nia halo saida ba o? Oinsaa mak Nia kura o nia matan?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Nia hataan, “Hau hatete tiha ona ba ita boot sira maibee ita boot sira lakohi rona. Nusaa mak ita boot sira hakarak rona tan? Keta halo be ita boot sira mos hakarak sai Nia eskolante?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Depois sira hatete aat nia. I sira dehan tan, “O mak Ema nee nia eskolante, ami lae! Ami Moisés nia eskolante. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Ami hatene katak Maromak koalia ba Moisés. Maibee kona ba Ema nee, Nia mosu husi nebee ami la hatene.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Nunee nia hataan, “Hau admira! Ita boot sira dehan la hatene Ema nee mai husi nebee. Afinal Nia kura tiha ona hau nia matan. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Ita hotu hatene katak Maromak la rona ema sala nain, Nia so rona ema nebee adora Nia i halo tuir Nia hakarak.<note caller="+" style="x"><char style="xo" closed="false">9:31: </char><char style="xt" closed="false"><ref loc="PSA 66:18">Salmu 66:18</ref>,<ref loc="PSA 66:19">19</ref></char></note> <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Hori uluk liu too agora seidauk iha ema ida mak kura ema nebee moris mai matan delek, atu nia bele haree. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Se karik Ema nee laos mai husi Maromak, entaun Nia la bele halo buat ida.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Rona nunee sira hataan, “O nee moris mai nakonu ho sala tiha ona. O mak hanorin fali ami ka?” Depois sira duni sai tiha nia husi uma kreda.<verse eid="JHN 9:34" /></para>
  <para style="s">Ema nebee matan tomak kona ba Maromak nia dalan</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Jesus rona katak nai ulun Judeu sira duni sai tiha ona ema nebee uluk matan delek nee husi uma kreda. Nunee Nia baa hasoru ema nee hodi dehan, “O fiar Ema Umanu nia Oan ka lae?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Ema nee husu fali ba Jesus, “Senhor, Ema Umanu nia Oan nee see? Foo hatene hau atu hau bele fiar.”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Jesus hatete ba nia, “O haree tiha ona Nia, agora dadauk Nia mak koalia ho o nee.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Ema nee hataan, “Hau fiar, Nai.” I nia hakneak hodi adora Jesus.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Depois Jesus dehan, “Hau mai iha mundu nee atu hatudu see mak sala i see mak loos. Nunee ema nebee hatene aan dehan nia matan tomak hela, nia sei haree hetan. Maibee ema nebee hanoin dehan nia haree moos hela, nia sei sai matan tomak fali.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Iha ema Farizeu balu rona Jesus nia liafuan nee, i sira husu, “O hanoin ami nee matan tomak kona ba Maromak ka?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Jesus hataan, “Se imi matan tomak duni, nee la sala ida. Maibee imi dehan imi bele haree, nunee imi sei lori nafatin imi nia sala.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Nai Jesus mak Bibi Atan nebee diak</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Jesus hatutan tan dehan, “Hau hatete lo-loos ba imi, ema nebee tama iha bibi luhan laran laos liu husi odamatan maibee liu fali dalan seluk, ema nee naok-teen ho hadau door.<verse eid="JHN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 10:2" />Bibi atan lo-loos sempre liu husi odamatan. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Ema nebee hein odamatan nee sei loke odamatan ba nia, bibi sira mos rona nia. Nia bolu bibi ida-ida nia naran, i sira tuir nia sai ba liur. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Bainhira bibi atan lori nia bibi sira hotu sai ba liur ona, nia lao uluk, nia bibi sira lao tuir tanba sira konhese nia lian. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Ema nebee sira la konhese, sira la tuir. Sira sei halai dook tiha, tanba la konhese ema nee nia lian.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Jesus halo komparasaun nee maibee sira la hatene Nia liafuan nee dehan saida.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Entaun Jesus koalia tan dehan, “Hau hatete lo-loos ba imi, Hau mak bibi luhan nia odamatan. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Bibi atan sira nebee mai uluk, sira nee naok-teen ho hadau door, bibi sira lakohi rona sira.<note caller="+" style="f"><char style="fr" closed="false">10:8: </char><char style="ft" closed="false">Iha nee Nai Jesus koalia kona ba nai ulun relijiaun Judeu sira nebee mak la interese ba povu, i la lori sira ba dalan loos.</char></note> <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Hau mak odamatan. See mak tama liu husi Hau, nia sei hetan salvasaun. Nia sei tama-sai ho livre hodi hetan ai haan.<note caller="+" style="x"><char style="xo" closed="false">10:9: </char><char style="xt" closed="false"><ref loc="PSA 118:20">Salmu 118:20</ref></char></note> <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Naok-teen mai so hakarak naok deit, oho deit, i estraga deit. Maibee Hau mai atu Hau nia ema sira bele hetan moris too nakonu resin.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Hau nee Bibi Atan nebee diak. Bibi atan nebee diak prontu foo nia moris hodi salva nia bibi sira. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Maibee ema nebee simu osan atu tau matan ba ema seluk nia bibi, se nia haree asu fuik ida mai, nia sei halai husik tiha bibi sira nee, tanba laos ninian. Depois asu fuik tata bibi balu, i bibi sira seluk halai namkari. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Ema nee halai husik tiha bibi tanba nia servisu atu hetan deit osan, nia la interese ho bibi sira nee.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />Hau mak Bibi Atan nebee diak, Hau konhese Hau nia bibi sira, i sira mos konhese Hau, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />hanesan Hau nia Aman iha lalehan konhese Hau i Hau mos konhese Hau nia Aman. Hau foo Hau nia moris hodi salva Hau nia bibi sira.<note caller="+" style="x"><char style="xo" closed="false">10:15: </char><char style="xt" closed="false"><ref loc="MAT 11:27">Mateus 11:27</ref>; <ref loc="LUK 10:22">Lucas 10:22</ref></char></note> <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Hau sei iha tan bibi seluk nebee laos husi luhan ida nee. Hau tenki lori sira mai. Sira mos sei rona Hau, depois sira hotu sei sai luhan ida deit ho bibi atan ida deit.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />Hau nia Aman hadomi Hau tanba Hau foo Aan ba mate atu nunee Hau bele moris fila fali. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />La iha ema ida mak hasai Hau nia moris, maibee Hau rasik mak foo Hau nia Aan ba mate. Hau iha kbiit atu foo Hau nia Aan ba mate, Hau mos iha kbiit atu moris fila fali. Ida nee mak knaar nebee Hau simu husi Hau nia Aman.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Bainhira ema Judeu sira rona Jesus nia hanorin nee, sira komesa haksesuk malu dala ida tan. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Sira barak dehan, “Nia bulak tiha ona, diabu tama hela iha Nia laran. Ita rona Nia atu manaan saida?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Maibee iha ema seluk dehan, “Ema nebee diabu tama iha laran sei la koalia hanesan nee. Diabu bele kura ema matan delek ka?”<verse eid="JHN 10:21" /></para>
  <para style="s">Ema Judeu barak lakohi simu Jesus</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Too iha tempu malirin, ema Judeu sira halo festa hodi hanoin fila fali inaugurasaun uma kreda boot iha Jerusalém. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Jesus lao hela iha area uma kreda boot iha parte ida naran Varanda Salomão. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Depois ema Judeu sira mai haleu Nia hodi husu, “Kleur loos ona ami hein Ita Boot atu foo sai ba ami kona ba Ita Boot nia Aan. Hatete lo-loos mai ami, Ita Boot mak Mesias, Salvador nebee Maromak atu haruka mai ka lae?”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Jesus hataan, “Hau hatete tiha ona ba imi, maibee imi la fiar. Milagre sira nebee Hau halo hodi Hau nia Aman nia naran hatudu katak Hau nee see. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Maibee imi la fiar Hau, tanba imi laos Hau nia bibi. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Hau nia bibi sira rona Hau. Hau mos konhese sira i sira tuir Hau. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Hau foo moris rohan-laek ba sira, i sira sei la mate haketak aan husi Maromak. La iha ema ida bele hadau sira husi Hau nia liman laran. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Hau nia Aman mak foo sira mai Hau, Nia kbiit boot liu hotu-hotu. Nee mak la iha ema ida bele hadau sira husi Nia liman laran. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Hau ho Hau nia Aman ida deit.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Rona nunee, dala ida tan ema Judeu sira foti fatuk atu tuda mate Jesus. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Maibee Jesus dehan ba sira, “Imi haree Hau halo buat diak barak hodi Hau nia Aman nia naran. Hau nia hahalok diak ida nebee mak la kona imi nia laran too imi hakarak tuda mate Hau?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Ema Judeu sira hataan, “Ami atu tuda O laos tanba O halo buat diak sira nee, maibee tanba O hatete aat Maromak. O ema baibain deit mos hakarak halo O nia Aan hanesan fali Maromak.”<note caller="+" style="x"><char style="xo" closed="false">10:33: </char><char style="xt" closed="false"><ref loc="LEV 24:16">Levítiku 24:16</ref></char></note><verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Jesus hataan, “Iha imi nia lei Maromak dehan, ‘Imi sira nee maromak oan.’<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false">Iha Salmu 82:1, Nai Maromak bolu ukun nain Israel sira “maromak oan” tanba Nia hili sira atu ukun Nia povu hodi Nia naran.</char></note><note caller="+" style="x"><char style="xo" closed="false">10:34: </char><char style="xt" closed="false"><ref loc="PSA 82:1">Salmu 82:1</ref>,<ref loc="PSA 82:2">2</ref>,<ref loc="PSA 82:6">6</ref></char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Maromak rasik koalia ba sira hodi hanaran sira nee ‘maromak oan’. I imi hatene katak buat hotu nebee hakerek iha Livru Sagradu loos nafatin. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Entaun bainhira Hau dehan, ‘Hau Maromak nia Oan’, oinsaa mak imi dehan fali, Hau hatete aat Maromak? Afinal Nia mak hili Hau i haruka Hau mai iha mundu nee. <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Se karik Hau la halo knaar nebee Hau nia Aman hatudu tiha ona mai Hau, entaun imi lalika fiar Hau. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Maibee Hau halo duni. Entaun imi tenki fiar ba buat nebee mak Hau halo, maski imi la fiar Hau. Nunee imi sei hatene mo-moos katak Hau nia Aman ho Hau ida deit.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Nunee dala ida tan sira atu kaer Jesus, maibee Nia konsege sai husi sira nia klaran.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Depois Jesus baa iha mota Jordaun nia sorin ba hodi hela iha nebaa. Fatin nee mak uluk João foo sarani ema.<note caller="+" style="x"><char style="xo" closed="false">10:40: </char><char style="xt" closed="false"><ref loc="JHN 1:28">João 1:28</ref></char></note> <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Ema barak baa hasoru Jesus iha nebaa. Sira dehan ba malu, “João nunka halo milagre, maibee buat hotu nebee nia foo sai kona ba Ema nee loos duni.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />I sira barak fiar ba Jesus.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Lázaro nia mate</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Iha ema ida naran Lázaro moras todan. Nia hela iha aldeia Betánia hamutuk ho nia feton nain rua, Maria ho Marta. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Maria nee feto ida nebee fui mina morin ba iha Nai Jesus nia ain i hamaran ho nia fuuk. Tanba Lázaro moras todan,<note caller="+" style="x"><char style="xo" closed="false">11:2: </char><char style="xt" closed="false"><ref loc="LUK 10:38-39">Lucas 10:38-39</ref>; <ref loc="JHN 12:3">João 12:3</ref></char></note> <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />nunee nia feton nain rua nee haruka lia menon ba Jesus dehan, “Nai, Ita Boot nia belun nebee Ita Boot hadomi nee moras hela.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Rona nunee Jesus dehan, “Moras nee sei la halo nia mate. Maibee nia moras nee foo fatin atu Maromak hatudu sai Nia kbiit boot, atu nunee ema hahii adora Maromak nia Oan.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Jesus hadomi Marta, Maria ho Lázaro. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Maski nunee Nia rona katak Lázaro moras, Nia la baa lalais. Liu tiha loron rua <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />foin Nia hatete ba Nia eskolante sira, “Mai ita fila ba Judeia.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Maibee eskolante sira hataan dehan, “Mestri, foin dadauk ema Judeu atu tuda mate Ita Boot ho fatuk iha nebaa. Agora Ita Boot hakarak baa fali ka?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Jesus hataan, “Loron ida iha oras sanulu resin rua, loos ka lae? Ema nebee lao iha rai loron, nia sei la sidi tanba naroman mundu nian leno hela nia dalan. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Maibee ema nebee lao iha rai kalan, nia sei sidi tanba la iha naroman iha nia.”<verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />Koalia hotu tiha Jesus hatutan tan dehan, “Ita nia belun Lázaro toba tiha ona, maibee Hau atu baa fanu nia.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Nia eskolante sira hataan, “Nai, se Lázaro toba ona, nee hatudu katak nia sei diak fali.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Sira hanoin Jesus koalia kona ba ema toba baibain, afinal Nia koalia kona ba Lázaro nia mate. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Entaun Jesus hatete mo-moos ba sira dehan, “Lázaro mate tiha ona. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Foin dadauk nia mate, Hau la iha nebaa. Nee halo Hau kontenti, tanba foo oportunidade ba imi atu fiar liu tan mai Hau. Agora mai ita baa iha nebaa.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Depois Jesus nia eskolante ida naran Tomé, baibain ema bolu Kaduak nee, hatete ba nia maluk eskolante sira seluk dehan, “Mai ita baa hotu, atu ita mate hamutuk ho Nia.”<verse eid="JHN 11:16" /></para>
  <para style="s">Nai Jesus baa foo korajen ba Marta</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Bainhira Jesus ho Nia eskolante sira too iha Betánia, sira rona dehan, ema hakoi Lázaro loron haat liu ba. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Betánia nee besik sidade Jerusalém, maizoumenus kilometru tolu. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Nunee ema Judeu barak mai iha Marta ho Maria nia uma hodi foo korajen sira tanba sira nia alin mate tiha ona.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Bainhira Marta rona katak Jesus mai dadauk, nia sai baa hasoru Jesus, maibee Maria hela iha uma. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Too iha nebaa, Marta hatete ba Jesus, “Nai, se Nai iha nee karik, Hau nia alin la mate ida. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Maski nunee hau hatene katak saida mak Ita Boot husu agora, Maromak sei foo.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Jesus hatete ba nia, “O nia alin sei moris fali.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Marta hataan, “Hau hatene katak bainhira mundu remata i Maromak halo ema hotu moris fali, Nia mos sei halo hau nia alin moris fila fali.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Jesus dehan ba nia, “Hau mak halo moris fali ema mate. Hau mak moris nia huun. Ema nebee fiar mai Hau, nia sei moris nafatin, maski nia mate. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Ema nebee moris hodi fiar mai Hau, nia sei la mate haketak aan husi Maromak. O fiar liafuan nee ka lae?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Marta hataan, “Nai, hau fiar. Hau fiar katak Ita Boot mak Mesias, Maromak nia Oan nebee atu mai iha mundu.”<verse eid="JHN 11:27" /></para>
  <para style="s">Nai Jesus tanis</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Koalia hotu tiha, Marta fila baa bolu nia alin Maria mes-mesak hodi foo hatene dehan, “Mestri mai tiha ona. Nia haruka bolu o.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Rona nunee, Maria hamriik lalais hodi baa hasoru Jesus. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Iha momentu nee, Jesus seidauk tama iha aldeia laran, Nia sei iha hela fatin nebee mak ohin Marta hasoru malu ho Nia. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Ema Judeu sira nebee hamutuk ho Maria iha uma hodi foo korajen ba nia, sira haree Maria hamriik hodi sai lalais. Sira hanoin nia atu baa tanis iha Lázaro nia rate, entaun sira mos tuir nia ba.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Maria too iha fatin nebee Jesus hein hela, nia haree Jesus. I nia hakneak kedas iha Jesus nia ain hodi dehan, “Nai, se Nai iha nee karik, Hau nia alin la mate ida.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Jesus haree Maria tanis, i ema Judeu sira nebee tuir Maria mos tanis, Nia fuan dodok ho laran susar teb-tebes. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Nia husu dehan, “Imi hakoi nia iha nebee?”</para>
  <para style="p" vid="JHN 11:34">Sira hataan, “Nai, mai haree rasik.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Jesus mos tanis. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Haree nunee, ema Judeu sira koalia ba malu dehan, “Haree ba! Nia hadomi teb-tebes Lázaro.”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Maibee iha balu dehan, “Ema nee kura ona ema matan delek. Nusaa mak Nia la bele halo buat ida para Lázaro la mate?”<verse eid="JHN 11:37" /></para>
  <para style="s">Nai Jesus halo moris fali Lázaro husi mate</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Ho laran dodok Jesus baa iha Lázaro nia rate. Rate nee fatuk kuak ida nebee taka ho fatuk boot. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Jesus haruka dehan, “Dudu sees tiha fatuk nee.”</para>
  <para style="p" vid="JHN 11:39">Maibee Marta, matebian nia feton nee dehan, “Nai, ami hakoi nia loron haat ona. Nia dois ona!”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Jesus dehan ba nia, “Ohin Hau hatete ona ba o katak, se o fiar, o sei haree Maromak nia kbiit. Loos ka lae?”<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Nunee sira muda sees tiha fatuk nee. Depois Jesus hateke sae hodi halo orasaun nunee: “Hau nia Aman, Hau agradese ba Ita Boot tanba Ita Boot rona Hau. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Hau hatene nanis katak Ita Boot sempre rona Hau, maibee Hau koalia nunee atu ema sira nebee hamriik iha nee, bele fiar katak Ita Boot mak haruka Hau mai.”<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Jesus halo orasaun hotu tiha, Nia bolu ho lian makaas dehan, “Lázaro, sai mai ona!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Nunee Lázaro, ema ida nebee mate tiha ona nee sai mai. Nia liman ho nia ain sei bobar hela ho hena, nia oin mos taka hela ho hena ida.</para>
  <para style="p" vid="JHN 11:44">Depois Jesus haruka sira dehan, “Hasai tiha hena nebee bobar nia isin nee atu nia bele lao.”<verse eid="JHN 11:44" /></para>
  <para style="s">Nai ulun Judeu sira halo planu atu oho Nai Jesus</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mateus 26:1-5</ref>; <ref loc="MRK 14:1-2">Marcos 14:1-2</ref>; <ref loc="LUK 22:1-2">Lucas 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Ema Judeu sira nebee mai vizita Maria i haree buat nebee Jesus halo nee, sira barak komesa fiar ba Nia. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Maibee iha ema balu baa konta fali ba ema Farizeu sira kona ba buat nebee mak Jesus halo nee.<verse eid="JHN 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 11:47" />Nunee ema Farizeu sira ho nai lulik nia ulun sira foo hatene justisa nain relijiaun Judeu sira atu halibur hamutuk. Justisa nain sira nee foo hanoin ba malu dehan, “Ema nee halo milagre barak. Ita atu halo saida? <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Se ita husik deit Nia, ema hotu sei fiar ba Nia. I se sira hotu tuir Nia, entaun estadu Roma sei mai halo rahun tiha ita nia uma kreda i hadau ita nia rain.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Husi justisa nain sira nee, iha ida naran Kaifás, nia mak nai lulik boot iha tinan nebaa. Nia dehan nunee: “Imi la hatene buat ida! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Imi la hili saida mak diak ba imi. Diak liu ema ida mate ba ita hotu duke ita ema Judeu tomak mate mohu.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Kaifás hatete nunee laos tuir nia hanoin rasik. Maibee tanba iha tempu nebaa nia mak nai lulik boot, entaun Maromak foo sai liu husi nia katak, Jesus sei mate ba ema Judeu tomak. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Afinal Jesus mate laos ba ema Judeu deit, maibee Nia mos mate ba Maromak nia oan sira nebee namkari iha rai sel-seluk, atu nunee Nia halibur sira hodi halo sira sai ida deit.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Komesa husi loron nebaa, nai ulun Judeu sira kombina malu atu oho Jesus.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />Tanba nee, Jesus la lao livre tan iha ema Judeu nia leet. Maibee Nia baa fali iha aldeia ida naran Efraim, besik rai fuik maran. I Nia hela ho Nia eskolante sira iha nebaa.<note caller="+" style="x"><char style="xo" closed="false">11:54: </char><char style="xt" closed="false"><ref loc="NUM 9:10">Númerus 9:10</ref></char></note><verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Iha tempu nee ema Judeu nia loron boot Paskua besik ona. Ema husi aldeia bar-barak baa iha sidade Jerusalém atu halo serimonia hamoos aan molok festa Paskua nee. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Sira buka Jesus tuun-sae. Bainhira sira hamriik hela iha area uma kreda boot, sira husu ba malu dehan, “Tuir imi nia hanoin oinsaa? Nia mai iha festa nee ka lae? Lae karik!” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Sira hatete nunee tanba nai lulik nia ulun sira ho ema Farizeu sira foo orden tiha ona katak, se iha ema ruma hatene Jesus iha nebee, nia tenki mai foo hatene, atu sira bele baa kaer Jesus.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Maria fui mina morin ba Nai Jesus nia ain</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mateus 26:6-13</ref>; <ref loc="MRK 14:3-9">Marcos 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Falta loron neen atu tama ba festa Paskua, Jesus too iha Betánia, Lázaro nia aldeia. Lázaro nee mak foin lalais Jesus halo moris fali husi mate. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Ema iha fatin nee prepara hahaan kalan nian hodi simu Jesus. Marta serve iha meza, i Lázaro tuur iha meza ho bainaka sira seluk hodi haan hamutuk ho Jesus. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Depois Maria mai lori mina morin folin karun teb-tebes litru sorin. Nia fui mina morin nee ba iha Jesus nia ain, depois hamaran ho nia fuuk. Nunee uma laran tomak morin hotu.<note caller="+" style="x"><char style="xo" closed="false">12:3: </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">Lucas 7:37-38</ref></char></note><verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />Maibee Judas Iscariotes, Jesus nia eskolante ida nebee sei faan Jesus dehan, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Nusaa mak nia la faan mina morin nee, depois nia osan foo ba ema kiak sira? Tanba mina nee folin karun, hanesan ema badaen nia salariu ba tinan ida tomak.”<note caller="+" style="f"><char style="fr" closed="false">12:5: </char><char style="ft" closed="false">João hakerek dehan, mina nee nia folin </char><char style="it">denáriu</char> 300. Iha tempu nebaa badaen sira loron ida manaan <char style="it">denáriu</char> ida.</note> <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Judas hatete nunee laos tanba nia interese ba ema kiak maibee tanba nia naok-teen ida. Nia mak toma konta Jesus ho Nia eskolante sira nia osan, maibee nia gosta foti osan balu husi kofre ba nia aan rasik.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Jesus hataan, “Keta hirus nia! Tanba nia prepara mina morin nee atu hamorin Hau nia isin para hakoi. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Ema kiak sira sempre iha imi nia leet, maibee Hau laos atu hela nafatin ho imi.”<note caller="+" style="x"><char style="xo" closed="false">12:8: </char><char style="xt" closed="false"><ref loc="DEU 15:11">Deuteronómiu 15:11</ref></char></note><verse eid="JHN 12:8" /></para>
  <para style="s">Nai lulik nia ulun sira hakarak oho Lázaro</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Ema Judeu barak rona katak Jesus iha Betánia hela, nunee sira mos baa iha nebaa. Sira baa laos atu haree deit Jesus, maibee sira mos hakarak haree Lázaro tanba Jesus halo moris fali nia husi mate. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Nunee nai lulik nia ulun sira halo planu atu oho hotu Lázaro, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />tanba nia istoria nee halo ema Judeu barak husik tiha nai lulik sira hodi fiar ba Jesus.<verse eid="JHN 12:11" /></para>
  <para style="s">Ema barak haklalak simu Nai Jesus tama iha Jerusalém</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateus 21:1-11</ref>; <ref loc="MRK 11:1-11">Marcos 11:1-11</ref>; <ref loc="LUK 19:28-40">Lucas 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Aban fali ema barak nebee too uluk ona iha Jerusalém atu tuir festa Paskua rona katak Jesus iha hela dalan atu baa iha nebaa. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Nunee sira foti ramus hodi baa simu Nia. Sira haklalak hahii Maromak dehan,</para>
  <para style="q1" vid="JHN 12:13">“Hosana!</para>
  <para style="q1" vid="JHN 12:13">Nai Maromak foo bensaun ba Ida nebee mak mai hodi Maromak nia naran.</para>
  <para style="q2" vid="JHN 12:13">Maromak foo bensaun ba ema Israel sira nia Liurai.”<note caller="+" style="x"><char style="xo" closed="false">12:13: </char><char style="xt" closed="false"><ref loc="PSA 118:26">Salmu 118:26</ref></char></note><verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Jesus hetan kuda buru oan ida, i Nia sae kuda buru nee. Nunee Nia halo tuir buat nebee hakerek iha Livru Sagradu dehan,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“Jerusalém oan sira,<note caller="+" style="f"><char style="fr" closed="false">12:15: </char><char style="ft" closed="false">João hakerek dehan, “Siaun nia oan feto”. Siaun nee Jerusalém nia naran seluk.</char></note></para>
  <para style="q2" vid="JHN 12:15">keta tauk!</para>
  <para style="q1" vid="JHN 12:15">Haree ba, imi nia Liurai mai,</para>
  <para style="q2" vid="JHN 12:15">sae kuda buru oan.”<note caller="+" style="x"><char style="xo" closed="false">12:15: </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Zacarias 9:9</ref></char></note><verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Iha tempu nebaa Jesus nia eskolante sira la kompriende saida mak akontese nee. Bainhira Maromak foti aas Jesus foin sira kompriende katak, buat nebee sira halo nee hakerek nanis ona iha Livru Sagradu.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ema barak nebee uluk haree Jesus bolu Lázaro sai husi rate hodi halo moris fali nia, sira konta nafatin istoria nee ba ema seluk. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Nee mak ema barak sai baa hodi simu Jesus, tanba sira rona katak Nia halo ona milagre ida nee. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Entaun ema Farizeu sira hatete ba malu dehan, “Ita la bele halo buat ida ona. Haree took, ema iha mundu tomak halai hotu ba Nia!”<verse eid="JHN 12:19" /></para>
  <para style="s">Nai Jesus koalia kona ba Nia mate</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Husi ema barak nebee mak baa iha Jerusalém atu adora Maromak iha festa Paskua nee, balu ema Gregu, laos ema Judeu. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Sira baa hasoru malu ho Filipe husi aldeia Betsaida, provinsia Galileia hodi husu, “Senhor, ami hakarak hasoru malu ho Jesus.” <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Depois Filipe hatete ba André, i sira nain rua baa foo hatene Jesus.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Jesus dehan, “Tempu too ona atu Maromak foti aas Hau, Ema Umanu nia Oan. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Hau hatete lo-loos ba imi, se trigu fini ida la kuda ba rai i mate, nia nafatin musan ida deit. Fini nee mate mak foin foo fali trigu musan barak. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Ema nebee hadomi liu nia moris iha mundu nee, sei lakon fali nia moris. Maibee see mak tau nia moris nee iha kotuk fali, nia sei hetan moris rohan-laek.<note caller="+" style="x"><char style="xo" closed="false">12:25: </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mateus 10:39</ref>, <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">Marcos 8:35</ref>; <ref loc="LUK 9:24">Lucas 9:24</ref>, <ref loc="LUK 17:33">17:33</ref></char></note> <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Ema nebee halao Hau nia servisu, nia tenki tuir Hau. Nunee Hau iha nebee deit, nia mos hamutuk ho Hau. I Hau nia Aman sei respeita nia.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Agora Hau nia laran susar. Hau atu dehan saida? Hau atu husu Hau nia Aman hasai Hau husi tempu terus nee ka? Lae. Hau la bele husu nunee, tanba Hau mai iha mundu atu hetan terus nee duni. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Nee mak Hau husu dehan, ‘Hau nia Aman, foti aas Ita Boot nia naran ba!’ ”</para>
  <para style="p" vid="JHN 12:28">Derepenti iha lian ida husi lalehan dehan, “Hau foti aas tiha ona Hau nia naran, i Hau sei foti aas fali tan.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Ema barak nebee hamriik iha nebaa rona lian nee. Balu dehan rai tarutu. Balu tan dehan Maromak nia anju ida koalia ho Jesus.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Jesus dehan, “Lian nebee imi rona nee laos atu tulun Hau, maibee atu tulun imi. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Agora tempu too ona atu Maromak foo justisa ba mundu nee, agora Nia atu hamonu ona Satanás, liurai mundu nee nian. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Maibee bainhira ema foti sae Hau iha fatin aas, Hau sei dada ema hotu-hotu mai iha Hau.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Jesus hatete nunee para foo sai oinsaa mak Nia atu mate.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Ema lubuk boot nee husu dehan, “Ami rona ema lee sai husi Livru Sagradu dehan, Mesias sei moris tinan ba tinan. Entaun nusaa mak Ita Boot dehan, ‘Ema sei foti sae Ema Umanu nia Oan’? Ema Umanu nia Oan nee see loos?”<note caller="+" style="x"><char style="xo" closed="false">12:34: </char><char style="xt" closed="false"><ref loc="PSA 110:4">Salmu 110:4</ref>; <ref loc="ISA 9:6">Isaias 9:6</ref>; <ref loc="EZK 37:25">Ezequiel 37:25</ref>; <ref loc="DAN 7:14">Daniel 7:14</ref></char></note><verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Depois Jesus soe lia kona ba nia Aan dehan, “La kleur tan, naroman la hamutuk ho imi ona. Entaun durante naroman nee sei hamutuk ho imi, imi tenki moris nafatin iha naroman nee, atu nakukun la bele taka imi. Tanba ema nebee lao iha nakukun laran, nia la hatene nia baa loos nebee. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Bainhira naroman sei hamutuk ho imi, imi tenki fiar ba naroman nee, atu nunee imi mos bele sai hanesan naroman nee.”</para>
  <para style="p" vid="JHN 12:36">Koalia hotu tiha, Jesus sai husi fatin nee, i Nia la hatudu Nia Aan ba sira tan.<verse eid="JHN 12:36" /></para>
  <para style="s">Ema Judeu barak la fiar nafatin ba Nai Jesus</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Maski Jesus halo milagre bar-barak iha ema Judeu sira nia klaran, maibee sira la fiar nafatin ba Nia. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Nee hanesan Maromak nia profeta Isaias hakerek nanis tiha ona dehan,</para>
  <para style="q1" vid="JHN 12:38">“Nai, ema uitoan deit mak fiar ba liafuan nebee mak ami foo sai.</para>
  <para style="q2" vid="JHN 12:38">Ita Boot nia kbiit hatudu sai ba see loos?”<note caller="+" style="x"><char style="xo" closed="false">12:38: </char><char style="xt" closed="false"><ref loc="ISA 53:1">Isaias 53:1</ref></char></note><verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Sira la bele fiar tanba buat nebee profeta Isaias hakerek nanis ona kona loos sira. Nia dehan,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“Maromak halo sira nia matan delek tiha,</para>
  <para style="q2" vid="JHN 12:40">i halo sira nia hanoin sai beik tiha,</para>
  <para style="q1" vid="JHN 12:40">atu nunee sira la bele haree</para>
  <para style="q2" vid="JHN 12:40">i la bele kompriende.</para>
  <para style="q1" vid="JHN 12:40">Nunee sira la bele fila fali ba Maromak,</para>
  <para style="q2" vid="JHN 12:40">atu Maromak salva sira.”<note caller="+" style="x"><char style="xo" closed="false">12:40: </char><char style="xt" closed="false"><ref loc="ISA 6:10">Isaias 6:10</ref></char></note><verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Isaias koalia hanesan nee tanba nia haree tiha ona Jesus nia kbiit lalehan nian, nunee nia konta kona ba Jesus.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Maski ema barak la fiar ba Jesus, maibee iha mos ema barak fiar. Nai ulun Judeu balu mos fiar ba Nia, maibee sira lakohi foo sai dehan sira fiar ba Jesus, tanba sira tauk ema Farizeu sira bandu la bele tama tan iha uma kreda. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Tanba nai ulun sira nee gosta liu ema mak gaba sira duke Maromak mak gaba.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Depois Jesus foo sai ho lian makaas ba ema barak dehan, “Ema nebee mak fiar mai Hau, nia laos fiar deit Hau maibee nia fiar mos Ida nebee mak haruka Hau mai. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Ema nebee haree Hau, nia haree mos Ida nebee mak haruka Hau mai. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Hau mai iha mundu nee nudar naroman, atu ema hotu nebee fiar mai Hau la bele hela tan iha nakukun laran.<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />Ema nebee rona Hau nia hanorin maibee la halo tuir, laos Hau mak atu hamonu kastigu ba nia. Tanba Hau mai laos atu tesi lia ba ema iha mundu nee, maibee atu salva sira. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Maski nunee ema nebee lakohi simu Hau i la simu Hau nia liafuan, bainhira mundu nee remata, liafuan nebee Hau hatoo tiha ona mak sai hanesan juis hodi hamonu kastigu ba nia. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Tanba Hau koalia laos tuir Hau nia hanoin rasik, maibee Hau nia Aman nebee haruka Hau mai mak foo orden mai Hau oinsaa atu koalia. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Hau hatene katak buat nebee Nia haruka Hau foo sai nee lori ema ba moris rohan-laek. Tanba nee, Hau koalia tuir lo-loos Hau nia Aman haruka.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Nai Jesus fase Nia eskolante sira nia ain</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Festa Paskua besik ona, Jesus hatene katak Nia oras too ona atu husik mundu nee hodi fila fali ba Nia Aman. Nia sempre hadomi Nia ema sira iha mundu nee, I Nia hadomi nafatin sira too rohan.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Jesus ho Nia eskolante sira tuur atu haan kalan hamutuk. Satanás foo hanoin tiha ona ba Judas, Simão Iscariotes nia oan atu faan Jesus.<verse eid="JHN 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 13:3" />Jesus hatene katak Nia Aman entrega tiha ona buat hotu-hotu ba iha Nia liman laran. Nia mos hatene katak Nia mai husi Maromak i atu fila fali ona ba Maromak. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Nunee sira sei haan hela, Jesus hamriik, hasai tiha Nia batina, i foti toalha ida kesi ba iha Nia kanotak. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Depois Nia fui bee ba iha basia ida i komesa fase Nia eskolante sira nia ain hodi hamaran ho toalha nebee mak kesi hela iha Nia kanotak. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Bainhira too iha Simão Pedro, Pedro hatete ba Jesus, “Nai, Ita Boot atu fase fali hau nia ain ka?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Jesus hataan dehan, “Agora o seidauk kompriende saida mak Hau halo nee, maibee too loron ida o sei kompriende.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Pedro dehan, “Lae! Ita Boot la bele fase fali Hau nia ain.”</para>
  <para style="p" vid="JHN 13:8">Jesus hataan, “Se Hau la fase o nia ain, entaun o laos Hau nian.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Simão Pedro hataan fali, “Nai, se nunee la bele fase deit hau nia ain, maibee fase hotu hau nia liman ho ulun.”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Jesus dehan, “Ema nebee hariis ona, so fase deit nia ain, tanba nia isin moos ona. Imi sira nee moos ona, maibee laos imi hotu-hotu mak moos.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Jesus hatene tiha ona see mak atu faan Nia. Tanba nee mak nia dehan, laos sira hotu-hotu mak moos.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Bainhira Jesus fase hotu sira nia ain, Nia hatais fali Nia batina hodi baa tuur fali iha Nia fatin. Depois Nia husu ba sira dehan, “Imi kompriende buat nebee Hau halo ba imi nee ka lae? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Imi bolu Hau ‘Mestri’ ho ‘Nai’. Nee loos, tanba Hau nunee duni. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Agora imi nia Mestri ho imi nia Nai fase tiha ona imi nia ain, entaun imi mos tenki halo nunee ba malu. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Hau halo ida nee hanesan ezemplu ida atu imi bele halo tuir.<note caller="+" style="x"><char style="xo" closed="false">13:15: </char><char style="xt" closed="false"><ref loc="LUK 22:27">Lucas 22:27</ref></char></note> <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Hau hatete lo-loos ba imi, atan ida la bele boot liu fali nia patraun. Nunee mos ema nebee lori ema seluk nia lia menon, nia la bele boot liu fali ida nebee mak haruka nia baa.<note caller="+" style="x"><char style="xo" closed="false">13:16: </char><char style="xt" closed="false"><ref loc="MAT 10:24">Mateus 10:24</ref>; <ref loc="LUK 6:40">Lucas 6:40</ref>; <ref loc="JHN 15:20">João 15:20</ref></char></note> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Agora imi hatene ona buat sira nee, se imi halo tuir, imi sei hetan bensaun.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />Hau nia liafuan nee laos kona imi hotu. Hau konhese di-diak imi nebee mak Hau hili tiha ona. Maibee saida mak atu akontese nee hanesan lo-loos buat nebee hakerek tiha ona iha Livru Sagradu dehan, ‘Ema nebee tuur haan hamutuk ho Hau, nia sai fali Hau nia inimigu.’<note caller="+" style="x"><char style="xo" closed="false">13:18: </char><char style="xt" closed="false"><ref loc="PSA 41:10">Salmu 41:10</ref></char></note> <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Ida nee Hau foo hatene kedas ba imi, atu nunee bainhira buat nee akontese, imi bele fiar katak, Hau mak Ida nebee imi hein hela nee. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Hau hatete lo-loos ba imi, see mak simu ema nebee Hau haruka, nia simu ona Hau. See mak simu Hau, nia simu ona Ida nebee haruka Hau mai.”<note caller="+" style="x"><char style="xo" closed="false">13:20: </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mateus 10:40</ref>; <ref loc="MRK 9:37">Marcos 9:37</ref>; <ref loc="LUK 9:48">Lucas 9:48</ref>, <ref loc="LUK 10:16">10:16</ref></char></note><verse eid="JHN 13:20" /></para>
  <para style="s">Nai Jesus foo sai dehan ema ida atu faan Nia</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mateus 26:20-25</ref>; <ref loc="MRK 14:17-21">Marcos 14:17-21</ref>; <ref loc="LUK 22:21-23">Lucas 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Koalia tiha nunee, Jesus laran susar teb-tebes, i Nia hatete sai dehan, “Hau hatete lo-loos ba imi, husi imi sira nee, ida sei faan Hau ba Hau nia inimigu sira.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Rona nunee, Nia eskolante sira hateke ba malu. Sira bilaan tiha, la hatene Jesus koalia kona ba see. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Iha eskolante ida nebee Jesus hadomi liu<note caller="+" style="f"><char style="fr" closed="false">13:23: </char><char style="ft" closed="false">Tuir ema matenek nain sira kona ba Biblia, “eskolante nebee Jesus hadomi liu” nee mak João, ida nebee hakerek livru nee.</char></note> tuur iha Jesus nia sorin. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Entaun Simão Pedro foo sinal ba nia hodi dehan, “Husu took, Nia koalia kona ba see loos?”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Eskolante nee sadere ba Jesus hodi husu, “Nai, see mak atu halo ida nee?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Jesus hataan, “Hau sei hatama paun pedasuk ba iha manko laran depois foo ba ema ida, nia mak nee.” Depois Jesus foti paun pedasuk hatama ba iha manko laran hodi foo ba Judas, Simão Iscariotes nia oan. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Judas simu tiha paun nee, Satanás tama kedas iha nia laran. Jesus hatete ba Judas, “O atu halo saida, halo lalais ona ba.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Sira nebee tuur haan hamutuk ho Jesus, la iha ida mak kompriende tansaa mak Jesus hatete nunee. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Sira balu hanoin dehan Jesus haruka Judas atu baa sosa buat ruma ba festa Paskua ka foo osan ba ema kiak sira, tanba Judas mak toma konta sira nia osan. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Simu tiha paun, Judas sai kedas husi fatin nee. Rai mos kalan ona.<verse eid="JHN 13:30" /></para>
  <para style="s">Jesus nia ukun fuan foun</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Judas sai tiha, Jesus hatete ba Nia eskolante sira seluk dehan, “Agora Maromak atu foti aas Hau, Ema Umanu nia Oan. Agora Maromak atu hatudu sai Nia kbiit liu husi Hau. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Tanba Nia hatudu Nia kbiit liu husi Hau, nunee la kleur tan Nia rasik sei foti aas Hau.<verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />Hau nia oan doben sira, Hau hela ho imi la kleur tan ona. Imi sei buka Hau, maibee hanesan Hau hatete tiha ona ba nai ulun Judeu sira katak, iha fatin nebee mak Hau atu baa, imi la bele baa.<note caller="+" style="x"><char style="xo" closed="false">13:33: </char><char style="xt" closed="false"><ref loc="JHN 7:34">João 7:34</ref>, <ref loc="JHN 8:22-23">8:22-23</ref></char></note> <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Agora Hau foo ukun fuan foun ba imi nunee: Hadomi malu ba. Hanesan Hau hadomi imi, nunee mos imi tenki hadomi malu.<note caller="+" style="x"><char style="xo" closed="false">13:34: </char><char style="xt" closed="false"><ref loc="JHN 15:12">João 15:12</ref>, <ref loc="JHN 17">17</ref>; <ref loc="1JN 3:23">1 João 3:23</ref>; <ref loc="2JN 1:5">2 João 5</ref></char></note> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Se imi hadomi malu nunee, ema hotu sei hatene katak imi nee Hau nia eskolante.”<verse eid="JHN 13:35" /></para>
  <para style="s">Nai Jesus dehan, Pedro sei nega Nia</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateus 26:31-35</ref>; <ref loc="MRK 14:27-31">Marcos 14:27-31</ref>; <ref loc="LUK 22:31-34">Lucas 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simão Pedro husu ba Jesus, “Nai, Ita Boot atu baa iha nebee?”</para>
  <para style="p" vid="JHN 13:36">Jesus hataan, “Fatin nebee Hau atu baa nee, o la bele tuir agora. Aban-bainrua mak o tuir.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Pedro husu fali, “Nai, tansaa mak hau la bele tuir agora? Hau prontu mate ba Ita Boot.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Jesus hataan, “Tebes ka? O prontu mate ba Hau ka? Hau hatete lo-loos ba o, molok manu kokoreek, o sei nega Hau dala tolu.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Nai Jesus mak dalan ba Nai Maromak</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Jesus hatutan tan dehan, “Imi keta laran susar. Fiar ba Maromak, fiar mos mai Hau. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Iha Hau nia Aman nia uma iha fatin barak. Hau hatete nunee tanba fatin iha duni, se lae, Hau la hatete ida. Agora Hau atu baa uluk prepara fatin ba imi iha nebaa. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Hau prepara tiha imi nia fatin mak Hau mai fali hodi lori imi ba atu imi bele hamutuk ho Hau. Nunee fatin nebee mak Hau hela, imi mos hela hotu iha nebaa. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Fatin nebee Hau baa, imi hatene nia dalan.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tomé husu, “Nai, ami la hatene Ita Boot atu baa iha nebee. Oinsaa mak ami bele hatene nia dalan?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Jesus hataan, “Hau mak dalan, Hau mak lia loos, Hau mak moris nia huun. See mak atu baa iha Hau nia Aman, nia tenki liu husi Hau. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Se imi konhese lo-loos ona Hau, entaun imi konhese mos Hau nia Aman. Komesa agora imi konhese duni Nia i haree ona Nia.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filipe dehan, “Nai, hatudu Ita Boot nia Aman mai ami, nee too ona ba ami.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Jesus hataan, “Filipe, Hau hela kleur ona ho imi, maibee imi seidauk konhese lo-loos Hau ka? Ema nebee haree ona Hau, nia haree ona Hau nia Aman. Entaun nusaa mak o husu fali atu Hau hatudu Hau nia Aman ba imi? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />O la fiar katak Hau ho Hau nia Aman ida deit ka? Buat nebee Hau foo sai ba imi laos mai husi Hau nia Aan. Maibee Hau nia Aman hela iha Hau hodi halao Nia servisu. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Hau hatete ba imi, Hau ho Hau nia Aman ida deit, imi tenki fiar Hau nia liafuan nee. Se imi la fiar Hau nia liafuan nee, entaun fiar netik buat nebee Hau halo tiha ona. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Hau hatete lo-loos ba imi, see mak fiar Hau, nia sei halo buat nebee mak Hau halo, nia mos sei halo buat nebee makaas liu tan, tanba Hau baa hela hamutuk ho Hau nia Aman. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />I saida deit mak imi husu hodi Hau nia naran, Hau sei halo, atu nunee ema foti aas Hau nia Aman nia naran tanba buat nebee mak Nia Oan halo nee. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Imi bele husu saida deit hodi Hau nia naran, Hau sei halo.”<verse eid="JHN 14:14" /></para>
  <para style="s">Nai Jesus promete atu haruka Espiritu Santu mai</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“Se imi hadomi Hau, imi sei halo tuir Hau nia ukun fuan. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Hau sei husu ba Hau nia Aman, i Nia sei foo Ajudador ida atu mai hela hamutuk ho imi tinan ba tinan. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Nia nee Maromak nia Espiritu, Nia hatudu sai lia loos. Ema mundu nian la bele simu Nia tanba sira la haree Nia i la konhese Nia. Maibee imi konhese Nia tanba Nia sei hela hamutuk ho imi i hela iha imi nia laran.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />Hau sei la husik imi mesak hanesan oan kiak, Hau sei mai fali. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />La kleur tan, ema mundu nian la haree tan Hau, maibee imi sei haree. Tanba Hau moris, entaun imi mos sei moris. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Bainhira imi haree fali Hau mak imi sei hatene katak Hau laran ida ho Hau nia Aman i imi mos ida deit ho Hau.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />See mak simu Hau nia ukun fuan hodi halo tuir, nia nee hadomi Hau. Hau nia Aman hadomi ema nebee hadomi Hau nee. Hau mos hadomi nia, i sei hatudu Hau nia Aan ba nia.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Depois eskolante ida naran Judas, laos Judas Iscariotes, dehan ba Jesus, “Nai, nusaa mak Nai atu hatudu Aan mai ami deit, maibee lakohi hatudu Aan ba ema seluk iha mundu nee?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Jesus dehan, “Ema nebee hadomi Hau, nia sei halo tuir Hau nia liafuan. Hau nia Aman sei hadomi nia, i Hau ho Hau nia Aman sei mai hela hamutuk ho nia. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Ema nebee la hadomi Hau, nia la halo tuir Hau nia liafuan. Buat nebee imi rona husi Hau laos mai husi Hau nia Aan, maibee mai husi Hau nia Aman nebee mak haruka Hau mai.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />Buat sira nee hotu Hau hatete ba imi bainhira Hau sei hamutuk ho imi. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Maibee Hau nia Aman sei haruka Ajudador ba imi hodi troka Hau, Nia nee mak Espiritu Santu. Nia sei hanorin buat hotu ba imi i foo hanoin fila fali ba imi kona ba buat hotu-hotu nebee Hau hanorin tiha ona ba imi.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Hau husik hela pas ho hakmatek ba imi. Pas ho hakmatek nebee Hau foo nee, la hanesan imi bele hetan iha mundu nee. Entaun la bele laran susar i la bele tauk! <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Imi rona tiha ona Hau nia liafuan dehan, ‘Hau atu baa ona, i Hau sei fila fali mai.’ Se imi hadomi duni Hau, entaun bainhira Hau baa iha Hau nia Aman, imi sei kontenti, tanba Hau nia Aman boot liu Hau. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Hau foo hatene kedas ba imi molok buat sira nee akontese, atu bainhira akontese imi bele fiar mai Hau. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Hau koalia ho imi la kleur tan ona, tanba Satanás, liurai mundu nee ninian atu mai ona. Nia la bele domina Hau. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Maibee buat sira nee akontese atu ema iha mundu nee hatene katak Hau hadomi Hau nia Aman i halo tuir lo-loos buat nebee mak Nia haruka.”</para>
  <para style="p" vid="JHN 14:31">Hotu tiha Jesus dehan, “Mai ita baa ona!”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Nai Jesus hanesan uvas huun, ita hanesan nia sanak</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />Jesus halo komparasaun ida nunee: “Hau mak uvas huun lo-loos,<note caller="+" style="f"><char style="fr" closed="false">15:1: </char><char style="ft" closed="false">Iha Antigu Testamentu dala barak kompara ema Israel ho uvas huun (ezemplu Salmu 80:8-16; Isaias 5:1-7; Jeremias 2:21; Ezekiel 15:1-8, 19:10-14; Oseias (Hosea) 10:1). Maibee ema Israel la halo tuir Maromak nia hakarak. Nunee Jesus dehan Nia mak uvas huun lo-loos, tanba Nia mak halo tuir hotu Maromak nia hakarak.</char></note> Hau nia Aman mak Toos Nain. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Hau iha sanak barak. Sanak nebee la foo fuan, Toos Nain sei tesi sai tiha hotu. Maibee sanak nebee foo fuan, Toos Nain aparu halo moos atu bele foo fuan barak liu tan. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Imi nee moos tiha ona tanba imi simu ona hanorin nebee Hau foo ba imi. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Imi tenki laran ida ho Hau nafatin, Hau mos sei laran ida ho imi nafatin. Tanba ai sanak nebee haketak aan ona husi nia huun la bele foo fuan, nia tenki hamutuk ho nia huun mak foin foo fuan. Nunee mos imi, imi tenki laran ida ho Hau nafatin mak foin imi bele foo fuan.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />Hau mak uvas huun, imi mak nia sanak. Se imi ho Hau nafatin ida deit, imi hanesan sanak ida nebee foo fuan barak. Se imi haketak aan husi Hau, imi la bele halo buat ida. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />See mak haketak aan husi Hau, nia hanesan uvas sanak nebee la iha folin. Nunee toos nain soe tiha too maran, depois raut soe ba ahi hodi sunu tiha. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Se imi laran ida nafatin ho Hau, i imi rai nafatin Hau nia hanorin iha imi nia laran, imi bele husu saida deit ba Hau nia Aman, Nia sei foo.<verse eid="JHN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 15:8" />Bainhira imi hanesan uvas sanak nebee foo fuan barak, nee halo ema foti aas Hau nia Aman nia naran. Nunee imi mos hatudu katak, imi nee Hau nia eskolante duni.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />Hanesan Hau nia Aman hadomi Hau, nunee mos Hau hadomi imi. Imi tenki moris nafatin iha Hau nia domin nee. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Hau halo tuir buat nebee Hau nia Aman haruka hodi moris nafatin iha Nia domin. Se imi halo tuir Hau nia ukun fuan, imi mos sei moris nafatin iha Hau nia domin.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />Hau hatete buat sira nee hotu ba imi atu nunee imi nia laran haksolok teb-tebes hanesan mos Hau nia laran haksolok. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Hau nia ukun fuan mak nee: Hadomi malu hanesan Hau hadomi imi.<note caller="+" style="x"><char style="xo" closed="false">15:12: </char><char style="xt" closed="false"><ref loc="JHN 13:34">João 13:34</ref>, <ref loc="JHN 15:17">15:17</ref>; <ref loc="1JN 3:23">1 João 3:23</ref>; <ref loc="2JN 1:5">2 João 5</ref></char></note> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Ema nebee hadomi liu nia belun sira mak ema nebee foo nia moris atu salva sira, domin boot liu ida nee la iha. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Imi nee mak Hau nia belun sira, naran katak imi halo tuir buat nebee Hau haruka. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Hau sei la bolu tan imi ‘atan’ tanba atan la hatene saida mak nia patraun halo. Hau bolu imi ‘belun’ tanba buat hotu nebee Hau rona husi Hau nia Aman, Hau foo hatene hotu ba imi. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Laos imi mak hili Hau, maibee Hau mak hili imi. Hau foti ona imi atu baa halao Hau nia servisu hodi foo fuan nebee mak dura nafatin. Nunee imi husu saida deit ba Hau nia Aman hodi Hau nia naran, Nia sei foo. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Ida nee mak Hau nia ukun fuan: Hadomi malu ba.”<verse eid="JHN 15:17" /></para>
  <para style="s">Ema mundu nian odi Nai Jesus nia eskolante sira</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />Jesus hatutan tan dehan, “Bainhira ema mundu nian odi imi, keta haluha katak, sira odi uluk tiha ona Hau. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Se karik imi hanesan sira, entaun sira sei hadomi imi hanesan sira hadomi sira nia ema. Maibee imi la hanesan ho sira, Hau haketak tiha ona imi husi sira. Nee mak sira odi imi.<verse eid="JHN 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 15:20" />Hanoin di-diak liafuan nebee uluk Hau hatete tiha ona ba imi: ‘Atan ida la bele boot liu fali nia patraun.’ Ema mundu halo terus ona Hau, entaun sira mos sei halo terus imi. Se sira halo tuir buat nebee Hau hanorin, sira mos sei halo tuir imi nia hanorin.<note caller="+" style="x"><char style="xo" closed="false">15:20: </char><char style="xt" closed="false"><ref loc="MAT 10:24">Mateus 10:24</ref>; <ref loc="LUK 6:40">Lucas 6:40</ref>; <ref loc="JHN 13:16">João 13:16</ref></char></note> <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Sira sei halo terus imi tanba imi tuir Hau. Sira halo nunee tanba sira la konhese Ida nebee haruka Hau mai. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Se karik Hau la mai foo sai Maromak nia liafuan ba sira, entaun Maromak la foo sala ba sira. Maibee Hau foo sai duni, nunee agora sira la iha tan razaun atu defende aan.<verse eid="JHN 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 15:23" />Ema nebee odi Hau, nia odi mos Hau nia Aman. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Hau halo ona milagre iha sira nia oin, milagre nebee ema seluk nunka halo. Se karik hau nunka halo milagre sira nee, entaun Maromak la foo sala ba sira. Maibee Hau halo duni, i sira haree ho matan rasik. Maski nunee sira odi nafatin Hau, too odi mos Hau nia Aman. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Maibee buat nee akontese hodi halo tuir saida mak hakerek iha sira nia Livru Sagradu dehan, ‘Sira odi Hau maski la iha razaun.’<note caller="+" style="x"><char style="xo" closed="false">15:25: </char><char style="xt" closed="false"><ref loc="PSA 35:19">Salmu 35:19</ref>, <ref loc="PSA 69:5">69:5</ref></char></note><verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />Hau sei haruka Ajudador mai. Nia mai husi Hau nia Aman. Nia nee mak Espiritu nebee hatudu sai lia loos. Bainhira Nia mai, Nia sei foo sasin kona ba Hau. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Imi mos tenki foo sasin kona ba Hau, tanba hori uluk too agora imi hamutuk ho Hau.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />Hau hatete buat sira nee hotu ba imi atu imi la bele lao sala dalan. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Aban-bainrua ema Judeu sei bandu imi la bele tama tan iha uma kreda. Laos nee deit, maibee too tempu ida, ema sei oho imi, sira hanoin katak sira oho imi para serbi Maromak. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Sira halo nunee tanba sira la konhese Hau nia Aman i la konhese mos Hau. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Maibee Hau hatete kedas buat nee ba imi atu aban-bainrua akontese karik, imi lalika hakfodak, tanba Hau foo sai tiha ona ba imi. Fo-foun Hau la foo sai buat sira nee ba imi tanba iha tempu nebaa Hau sei hamutuk ho imi.”<verse eid="JHN 16:4" /></para>
  <para style="s">Espiritu Santu nia servisu</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“Agora Hau atu fila fali ba Ida nebee haruka Hau mai. Maibee imi sira nee la iha ida mak husu, ‘Ita Boot atu baa nebee?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Imi nia laran tristi teb-tebes tanba Hau foo sai buat sira nee. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Maibee Hau hatete lo-loos ba imi, se Hau baa, nee diak liu ba imi. Se Hau la baa karik, Ajudador sei la mai iha imi. Hau baa mak Hau haruka Nia mai.<verse eid="JHN 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 16:8" />Bainhira Nia too mai, Nia sei halo ema iha mundu nee rekonhese buat tolu: Sira nia sala, saida mak loos, i Maromak hamonu Nia kastigu ba mundu. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Kona ba sala, Ajudador sei hatudu ba sira katak, sira sala tanba sira lakohi fiar mai Hau. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Kona ba saida mak loos, Ajudador sei halo sira kompriende katak, Hau nee moris loos. Sira hatene nunee tanba Hau atu baa ona iha Hau nia Aman i imi sei la haree tan Hau. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Kona ba Maromak nia kastigu, Ajudador sei foo hanoin ba sira katak, iha duni justisa ba aban-bainrua, tanba Maromak hamonu ona kastigu ba Satanás, liurai mundu nee nian.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Sei iha buat barak mak Hau atu foo sai ba imi, maibee agora imi seidauk bele simu hotu. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Maibee bainhira Espiritu Santu mai, Nia sei hatudu sai lia loos ba imi atu imi hatene hotu. Nia laos koalia tuir Nia hanoin rasik, maibee Nia koalia tuir buat nebee Nia rona husi Hau nia Aman. I Nia sei foo hatene ba imi kona ba saida mak sei akontese aban-bainrua. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Nia sei foti aas Hau tanba buat nebee Nia hatoo ba imi, Nia simu husi Hau. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Buat hotu nebee Hau nia Aman nian, nee Hau nian. Tanba nee mak Hau dehan, buat nebee Espiritu Santu hatoo ba imi, Nia simu husi Hau.”<verse eid="JHN 16:15" /></para>
  <para style="s">Eskolante sira sei tristi lai mak foin haksolok fali</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Jesus hatutan dehan, “La kleur tan imi la haree ona Hau. Depois iha tempu badak nia laran, imi sei haree fali Hau.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Jesus nia eskolante balu husu ba malu dehan, “Liafuan nee dehan saida? Nia foo sai mai ita dehan, la kleur tan ita la haree ona Nia. Depois iha tempu badak nia laran, ita sei haree fali Nia. I Nia mos dehan Nia atu baa ona iha Nia Aman.” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Sira husu nafatin dehan, “Liafuan ‘la kleur tan’ nee dehan saida? Ita la kompriende.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Jesus hatene hela sira atu husu Nia kona ba buat nee. Entaun Nia dehan ba sira, “Ohin Hau hatete, ‘La kleur tan imi la haree ona Hau. Depois iha tempu badak nia laran, imi sei haree fali Hau.’ Imi husu malu kona ba ida nee ka?<verse eid="JHN 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 16:20" />Hau hatete lo-loos ba imi, bainhira Hau baa, imi sei tanis halerik ho laran susar, maibee ema mundu nian sei haksolok. Imi nia laran sei tristi maibee imi nia laran tristi nee sei sai fali haksolok. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Nee hanesan inan ida nebee tempu too ona atu tuur ahi, nia tanis hakilar. Maibee bainhira nia oan moris ona, nia haluha tiha nia terus nee. Nia laran haksolok, tanba labarik ida moris mai ona iha mundu nee. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Nunee mos ho imi. Agora imi nia tempu atu tristi. Maibee aban-bainrua Hau fila fali mai haree imi, imi nia laran sei haksolok. La iha ema ida mak bele hasai fali imi nia ksolok nee.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />Bainhira Hau hasoru malu fali ho imi, imi sei la husu tan buat ida ba Hau. Hau hatete lo-loos ba imi, imi husu saida deit hodi Hau nia naran, Hau nia Aman sei foo. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Too agora imi seidauk husu buat ruma hodi Hau nia naran. Husu deit ba. Imi sei simu, atu imi nia laran bele haksolok teb-tebes.”<verse eid="JHN 16:24" /></para>
  <para style="s">Nai Jesus manaan tiha ona mundu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Durante nee Hau hanorin imi ho komparasaun. Maibee too tempu ida Hau sei la uza tan komparasaun, Hau koalia mo-moos ba imi kona ba Hau nia Aman. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Too iha tempu nee, imi ida-idak sei husu rasik ba Hau nia Aman hodi Hau nia naran, la presiza Hau mak hatoo ba Nia. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Hau nia Aman rasik hadomi imi, tanba imi hadomi Hau i imi fiar ona katak Hau mai husi Maromak. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Loos duni, Hau mai iha mundu nee, Hau mai husi Nia. Agora Hau atu husik fali mundu nee, Hau fila fali ba Nia.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Depois Nia eskolante sira dehan, “Agora Ita Boot koalia mo-moos, la uza komparasaun tan ona. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Agora ami kompriende katak, Ita Boot hatene buat hotu-hotu, ami seidauk husu buat ruma mos, Ita Boot hatene uluk ona ami nia hanoin. Nee mak ami fiar katak Ita Boot mai husi Maromak.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Jesus husu fali ba sira, “Entaun agora imi fiar ona ka? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Too tempu ida, tempu nee mak komesa agora nee, imi sei halai namkari, imi ida-ida halai ba nia uma husik hela Hau mesak. Maibee Hau laos mesak, tanba Hau nia Aman hamutuk ho Hau. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Hau hatete buat sira nee hotu ba imi atu imi bele moris iha pas ho hakmatek tanba imi laran ida ho Hau. Iha mundu nee imi sei hetan susar. Maibee aten brani ba, tanba Hau manaan tiha ona mundu.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Jesus halo orasaun ba Nia Aan rasik</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Jesus koalia hotu tiha nunee, Nia hateke ba lalehan hodi harohan, “Hau nia Aman, agora oras too ona. Hau husu atu Ita Boot foti aas Ita Boot nia Oan, Hau, atu nunee Hau foti aas Ita Boot nia naran. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Tanba Ita Boot foo tiha ona kbiit mai Hau hodi ukun ema hotu-hotu, atu Hau bele foo moris rohan-laek ba ema nebee mak Ita Boot entrega ona mai Hau. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Moris rohan-laek katak ema konhese Ita Boot mak Maromak loos, la iha tan seluk. I sira konhese mos Hau, Jesus Kristu, nebee Ita Boot haruka mai. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Hau halo hotu ona servisu nebee mak Ita Boot foo mai Hau. Nunee Hau hatudu sai tiha ona Ita Boot nia kbiit iha mundu nee. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Hau nia Aman, Hau husu atu Ita Boot foti aas fali Hau iha Ita Boot nia prezensa, hanesan uluk Hau hamutuk ho Ita Boot bainhira mundu nee seidauk iha.”<verse eid="JHN 17:5" /></para>
  <para style="s">Nai Jesus halo orasaun ba Nia eskolante sira</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />Jesus halo orasaun nafatin dehan, “Hau foo konhese tiha ona Ita Boot<note caller="+" style="f"><char style="fr" closed="false">17:6 </char><char style="ft" closed="false">Versikulu nee iha lian Gregu dehan Jesus foo konhese Nia Aman nia “naran”, nee dehan katak Nia Aan.</char></note> ba ema sira nebee Ita Boot entrega mai Hau iha mundu nee. Sira nee Ita Boot nian. Ita Boot foo sira mai Hau, i sira halo tuir Ita Boot nia liafuan. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Agora sira hatene ona katak, buat hotu nebee Ita Boot foo ba Hau mai husi Ita Boot. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Tanba Hau hatoo tiha ona liafuan hotu-hotu nebee Ita Boot foo mai Hau, i sira simu tiha ona. Sira hatene katak Hau mai duni husi Ita Boot, i sira fiar katak Ita Boot mak haruka Hau mai.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Hau harohan ba sira. Hau laos harohan ba ema hotu iha mundu nee, maibee Hau harohan ba sira nebee mak Ita Boot foo mai Hau, tanba sira nee Ita Boot nian. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />See deit mak Hau nian, Ita Boot nian. Ita Boot mak foo sira nee mai Hau, i sira hatudu sai ona Hau nia kbiit. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Agora Hau atu fila ona ba Ita Boot, Hau la hela tan ona iha mundu, maibee sira sei hela iha mundu nee. Aman Santu, kuidadu sira ho Ita Boot nia kbiit<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">Lian Gregu iha nee dehan, “Ita Boot nia naran”. Nee hatudu ba Nai Maromak nia kbiit ho prezensa.</char></note> nebee mak Ita Boot foo tiha ona mai Hau. Ho nunee sira hamutuk ida deit hanesan Ita Nain rua ida deit. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Durante Hau hamutuk ho sira, Hau kuidadu sira ho Ita Boot nia naran nebee Ita Boot foo mai Hau. Hau tau matan ba sira. Nunee sira iha hotu, so ida deit mak lakon. Ema ida nee tenki lakon duni tuir buat nebee hakerek nanis ona iha Livru Sagradu.<note caller="+" style="x"><char style="xo" closed="false">17:12: </char><char style="xt" closed="false"><ref loc="PSA 41:9">Salmu 41:9</ref>; <ref loc="JHN 13:18">João 13:18</ref></char></note><verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />Agora Hau atu baa ona iha Ita Boot, maibee Hau harohan buat sira nee bainhira Hau sei iha mundu nee, atu sira nia laran bele haksolok teb-tebes hanesan mos Hau nia laran haksolok. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Hau foo hatene tiha ona Ita Boot nia liafuan ba sira. Hau laos ema mundu nian, sira mos lae. Nee mak ema seluk iha mundu nee odi sira. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Hau la husu atu Ita Boot hasai sira husi mundu nee, maibee Hau husu atu Ita Boot proteje sira husi aat nain. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Sira laos mundu nian, hanesan Hau mos laos mundu nian.<verse eid="JHN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 17:17" />Uza Ita Boot nia liafuan hodi halo sira nia laran moos, tanba Ita Boot nia liafuan sempre loos. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Hanesan Ita Boot haruka Hau mai iha mundu nee, nunee mos Hau haruka sira baa iha mundu tomak. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Hau entrega Hau nia Aan tomak ba Ita Boot atu sira mos bele entrega sira nia aan tomak sai Ita Boot nian lo-loos.”<verse eid="JHN 17:19" /></para>
  <para style="s">Nai Jesus halo orasaun ba ema hotu nebee sei fiar aban-bainrua</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />Jesus harohan nafatin dehan, “Hau halo orasaun laos ba Hau nia eskolante sira deit, maibee Hau mos halo orasaun ba ema nebee aban-bainrua sei fiar mai Hau liu husi sira nia liafuan.<verse eid="JHN 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 17:21" />Hau nia Aman, Hau husu atu sira hotu hamutuk ida deit, hanesan Ita Boot ho Hau mos ida deit. Hau harohan atu sira laran ida ho Ita Nain rua, atu nunee ema iha mundu nee bele fiar katak Ita Boot mak haruka Hau mai. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ita Boot foti aas tiha ona Hau, i Hau mos foti aas tiha ona sira atu nunee sira sai laran ida hanesan Ita Nain rua mos laran ida. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Nunee Hau ida deit ho sira, i Ita Boot ida deit ho Hau, too sira sai neon ida laran ida. Ho nunee ema iha mundu sei hatene katak Ita Boot mak haruka Hau mai, i Ita Boot sempre hadomi sira, hanesan Ita Boot hadomi Hau.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />Hau nia Aman, ema sira nebee Ita Boot foo tiha ona mai Hau nee, Hau hakarak atu sira hela hamutuk ho Hau. Nunee sira bele haree katak Ita Boot foti aas tiha ona Hau tanba Ita Boot hadomi nanis Hau molok mundu nee iha.<verse eid="JHN 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25" />Hau nia Aman, Ita Boot sempre halo buat nebee mak loos. Maski ema mundu nian la konhese Ita Boot, maibee Hau konhese, i Hau nia eskolante sira nee hatene katak Ita Boot mak haruka Hau mai. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Hau foo konhese tiha ona ita Boot ba sira, i Hau sei foo konhese nafatin ba sira atu nunee Ita Boot nia domin mai Hau bele hela iha sira, i Hau mos hela iha sira.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Ema kaer Nai Jesus</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateus 26:47-56</ref>; <ref loc="MRK 14:43-50">Marcos 14:43-50</ref>; <ref loc="LUK 22:47-53">Lucas 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Bainhira Jesus halo orasaun hotu ona, Nia ho Nia eskolante sira baa iha mota Sedron nia sorin ba. Iha nebaa iha toos oliveira ida, i Jesus ho Nia eskolante sira tama iha toos nee.<verse eid="JHN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2" />Judas ida nebee faan Jesus mos hatene fatin nee, tanba dala barak Jesus ho Nia eskolante sira halibur hamutuk iha nebaa. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Nunee Judas mai hamutuk ho tropas Roma lubuk ida ho mos seguransa uma kreda boot nian balu. Ema seguransa sira nee mai tanba nai lulik nia ulun sira ho ema Farizeu sira mak haruka. Sira hotu lori ahi-oan, ahi ho mos sasaan kroat.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />Jesus hatene ona buat nebee mak atu akontese ba Nia, nunee Nia sai baa hodi husu ema sira nee dehan, “Imi buka see?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Sira hataan, “Jesus, Ema Nazaré.”</para>
  <para style="p" vid="JHN 18:5">Jesus hataan, “Hau mak nee.” Judas ida nebee faan Jesus mos hamriik hamutuk ho sira. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Bainhira Jesus dehan, “Hau mak nee”, sira hotu hakiduk monu ba rai.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Jesus husu fali ba sira dehan, “Imi buka see?”</para>
  <para style="p" vid="JHN 18:7">Sira hataan, “Jesus, Ema Nazaré.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Jesus hataan, “Hau hatete tiha ona ba imi, Hau mak nee. Se imi buka duni Hau, entaun husik Hau nia eskolante sira nee fila ona.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Jesus koalia nunee atu halo tuir Nia liafuan nebee uluk Nia harohan ba Nia Aman dehan, “Ema nebee Ita Boot foo mai Hau nee, ida mos la lakon.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Iha tempu nee, Simão Pedro lori hela surik. Nia losu surik nee hodi tesi kotu tiha nai lulik boot nia atan ida nia tilun sorin loos. Atan nee naran Malku. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Jesus dehan ba Pedro, “Hatama tiha o nia surik ba iha nia fatin. O hanoin Hau la bele simu terus nebee Hau nia Aman desidi tiha ona ka?”<note caller="+" style="x"><char style="xo" closed="false">18:11: </char><char style="xt" closed="false"><ref loc="MAT 26:39">Mateus 26:39</ref>; <ref loc="MRK 14:36">Marcos 14:36</ref>; <ref loc="LUK 22:42">Lucas 22:42</ref></char></note><verse eid="JHN 18:11" /></para>
  <para style="s">Ema lori Nai Jesus ba iha nai lulik Anás nia uma</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Depois tropas Roma ho sira nia komandante, ho mos ema Judeu nebee halo seguransa iha uma kreda boot kaer Jesus i futu Nia. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Sira lori Nia baa uluk iha Anás nia uma, Anás nee Kaifás nia banin. Kaifás mak nai lulik boot iha tinan nebaa, <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />nia mak uluk foo hanoin ba nai ulun Judeu sira katak, diak liu ema ida mate hodi povu tomak nia fatin.<note caller="+" style="x"><char style="xo" closed="false">18:14: </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">João 11:49-50</ref></char></note><verse eid="JHN 18:14" /></para>
  <para style="s">Pedro nega Nai Jesus</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mateus 26:69-70</ref>; <ref loc="MRK 14:66-68">Marcos 14:66-68</ref>; <ref loc="LUK 22:55-57">Lucas 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simão Pedro ho eskolante ida seluk lao tu-tuir Jesus husi kotuk too nai lulik boot nia uma. Eskolante ida seluk nee nai lulik boot konhese hela, nunee bainhira ema lori Jesus tama too uma oin, eskolante nee mos tama. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Maibee Pedro la bele tama, nia hamriik iha liur deit besik portaun. Tanba nai lulik boot konhese hela eskolante ida seluk nee, entaun eskolante nee baa koalia ho atan feto nebee mak hein portaun, nunee Pedro bele tama. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Depois feto nebee hein portaun nee husu ba Pedro, “O mos Ema nee nia eskolante ida, loos ka lae?”</para>
  <para style="p" vid="JHN 18:17">Maibee Pedro hataan, “Lae.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Iha kalan nee rai malirin, nunee atan sira ho mos seguransa uma kreda boot sunu ahi, i sira hamriik haneruk hela ahi. Entaun Pedro mos hamriik hamutuk ho sira hodi haneruk ahi.<verse eid="JHN 18:18" /></para>
  <para style="s">Nai lulik boot investiga Nai Jesus</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mateus 26:59-66</ref>; <ref loc="MRK 14:55-64">Marcos 14:55-64</ref>; <ref loc="LUK 22:66-71">Lucas 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Iha tempu nee, nai lulik boot husu Jesus kona ba Nia eskolante sira ho mos kona ba Nia hanorin.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />Jesus dehan, “Hau baibain koalia iha ema barak nia oin, Hau nunka koalia subar. Hau sempre hanorin iha area uma kreda boot nian ho mos iha uma kreda sel-seluk, fatin sira nee mak ema Judeu sira baibain halibur hamutuk. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Entaun nusaa mak ita husu fali buat sira nee mai Hau? Husu deit ba sira nebee mak rona tiha ona Hau nia hanorin. Sira hatene kona ba buat nebee Hau hatete.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Jesus koalia nunee, seguransa ida nebee hamriik besik Nia basa Nia oin hodi dehan, “O brani hataan nunee ba nai lulik boot ka?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Jesus hataan dehan, “Se karik Hau koalia sala, hatudu took Hau nia sala iha nebee. Maibee se Hau koalia loos, nusaa mak o basa fali Hau?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Depois Anás haruka ema lori Jesus ba iha nai lulik boot Kaifás nia uma. Bainhira sira lori Nia, Nia liman futu metin hela.<verse eid="JHN 18:24" /></para>
  <para style="s">Pedro nega tan Nai Jesus</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mateus 26:71-75</ref>; <ref loc="MRK 14:69-72">Marcos 14:69-72</ref>; <ref loc="LUK 22:58-62">Lucas 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Iha tempu nebaa Simão Pedro sei hamriik haneruk hela ahi. Iha ema balu husu dehan, “O mos Nia eskolante ida, loos ka lae?”</para>
  <para style="p" vid="JHN 18:25">Maibee Pedro nega dehan, “Lae!”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Iha nebaa iha nai lulik boot nia atan ida, nia sei maluk ho ema nebee mak Pedro tesi kotu nia tilun nee. Atan nee husu ba Pedro, “Hau haree ohin o hamutuk ho Nia iha toos oliveira laran, loos ka lae?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Maibee Pedro nega dala ida tan. Iha momentu nee kedas manu kokoreek.<verse eid="JHN 18:27" /></para>
  <para style="s">Nai Jesus iha governador Pilatus nia oin</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mateus 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Marcos 15:1-5</ref>; <ref loc="LUK 23:1-5">Lucas 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Iha dadeer-saan, ema Judeu sira lori Jesus husi Kaifás nia uma ba iha governador Roma nia uma. Too iha nebaa, sira lakohi tama liu ba laran, tanba governador laos ema Judeu, nunee se sira tama karik, lei Judeu bandu sira la bele tuir festa Paskua. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Entaun governador Pilatus sai mai hasoru malu ho sira hodi husu, “Nia halo sala saida mak imi mai kesar iha hau?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Sira hataan, “Se Nia laos ema kriminozu, ami la lori Nia mai iha ita boot.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pilatus dehan, “Lori Nia baa hodi foo justisa tuir imi nia lei rasik.”</para>
  <para style="p" vid="JHN 18:31">Maibee sira hataan, “Ami ema Judeu la iha direitu atu foo kastigu mate ema.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Sira hatete nunee atu Jesus nia liafuan kona ba oinsaa mak Nia atu mate bele sai realidade.<note caller="+" style="x"><char style="xo" closed="false">18:32: </char><char style="xt" closed="false"><ref loc="JHN 3:14">João 3:14</ref>, <ref loc="JHN 12:32-33">12:32-33</ref></char></note><verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Nunee Pilatus tama fali iha uma laran. Nia bolu Jesus mai hodi husu, “O mak ema Judeu sira nia Liurai ka?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Jesus hataan, “Pergunta nee mai husi ita rasik ka, ema ruma mak foo hatene ba ita kona ba Hau?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Pilatus hataan fali dehan, “O hatene hau nee see. Hau ema Judeu ka?! O nia maluk Judeu rasik ho nai lulik nia ulun sira mak entrega O mai Hau. O nia sala saida?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Jesus hataan, “Laos ema mundu nian mak hili Hau sai Liurai. Se nunee karik, entaun ohin ema Judeu sira baa kaer Hau nee, Hau nia reinu sei funu hasoru sira. Maibee Hau nia kbiit atu ukun laos husi nee.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pilatus husu, “Entaun O nee Liurai ka?”</para>
  <para style="p" vid="JHN 18:37">Jesus hataan, “Ita rasik mak dehan katak Hau Liurai. Hau mai iha mundu atu foo sasin kona ba lia loos. See mak kaer metin lia loos, nia rona Hau.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38a" style="v" sid="JHN 18:38a" />Pilatus hataan fali dehan, “Lia loos? Saida mak nee?!”<verse eid="JHN 18:38a" /></para>
  <para style="s">Governador Pilatus hamonu kastigu mate ba Nai Jesus</para>
  <para style="r">(<ref loc="MAT 27:15-31">Mateus 27:15-31</ref>; <ref loc="MRK 15:6-20">Marcos 15:6-20</ref>; <ref loc="LUK 23:13-25">Lucas 23:13-25</ref>)</para>
  <para style="p">
    <verse number="38b" style="v" sid="JHN 18:38b" />Hotu tiha Pilatus sai fali ba liur hodi koalia ba ema Judeu sira dehan, “Hau la hetan sala ida iha Ema nee. <verse eid="JHN 18:38b" /><verse number="39" style="v" sid="JHN 18:39" />Maibee tin-tinan iha tempu Paskua hau sempre hasai ema dadur ida ba imi. Agora imi hakarak hau husik imi nia Liurai nee ka?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Rona nunee, sira hataan ho hakilar dehan, “Lae! Laos Nia! Hasai mak Barabás.” Afinal Barabás nee ema naok-teen boot ida.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Depois Pilatus haruka nia tropas sira baku Jesus ho sikoti. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Sira mos dulas ai tarak halo kabuar hanesan koroa liurai nian hodi tau ba Nia ulun. Sira foo hatais batina kor mean ida hanesan ema boot nian. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Depois sira ida-ida mai hakbesik Nia hodi goza Nia dehan, “Viva, ema Judeu sira nia Liurai!” I sira basa Nia oin fila-fila.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Hotu tiha Pilatus sai fali mai liur hatete ba ema barak nee dehan, “Haree ba, hau lori Nia sai mai atu imi hatene katak hau la hetan sala ida iha Nia.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Nunee Jesus sai mai ho koroa ai tarak iha Nia ulun i hatais hena mean. Pilatus hatete ba sira dehan, “Haree took, Nia mak nee!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Bainhira nai lulik nia ulun sira ho seguransa uma kreda boot nian haree Jesus, sira hakilar dehan, “Prega tiha Nia ba krus! Prega tiha Nia ba krus!”</para>
  <para style="p" vid="JHN 19:6">Maibee Pilatus hataan, “Imi lori Nia baa prega ba! Hau la hetan sala ida iha Nia.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Ema Judeu sira hataan, “Tuir ami nia lei, Nia tenki hetan kastigu mate tanba Nia foti Nia Aan dehan Nia mak Maromak nia Oan.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Bainhira Pilatus rona sira nia liafuan, nia tauk loos. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Nunee nia lori Jesus tama fali ba uma laran. Depois nia husu, “O nee ema nebee?” Maibee Jesus la hataan buat ida.<verse eid="JHN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 19:10" />Pilatus dehan, “Nusaa mak O lakohi hataan mai hau? O la hatene hau ka? Hau iha kbiit atu husik O, hau mos iha kbiit atu prega O ba krus too mate.”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Jesus hataan, “Ita boot nia kbiit nee mai husi leten. Se laos husi leten, ita boot la bele halo buat ida mai Hau. Nee duni ema nebee entrega Hau ba ita boot, nia sala boot liu fali ita boot nian.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Rona tiha Jesus nia liafuan nee, Pilatus buka dalan atu husik tiha Jesus. Maibee ema Judeu sira hakilar tan dehan, “Se senhor husik Ema nee, entaun senhor sai inimigu ba liurai boot César. Tanba ema nebee foti aan hanesan liurai, nia kontra César.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Bainhira Pilatus rona liafuan nee, nia haruka ema lori Jesus sai fali ba liur. Depois Pilatus baa tuur iha kadeira juis nian iha fatin ida ema bolu Fatin Nahe Fatuk, iha lian Ebreu dehan Gabata. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Momentu nee besik meudia ona, iha loron preparasaun ba festa Paskua nian. Pilatus hatete ba ema sira nee dehan, “Imi nia Liurai mak nee!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Sira hakilar dehan, “Halakon tiha Nia! Halakon tiha Nia! Prega tiha Nia ba krus!”</para>
  <para style="p" vid="JHN 19:15">Pilatus husu fali, “Imi hakarak hau prega imi nia Liurai ba krus ka?”</para>
  <para style="p" vid="JHN 19:15">Maibee nai lulik nia ulun sira hataan, “Ami nia liurai mak César deit. La iha tan seluk.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16a" style="v" sid="JHN 19:16a" />Too ikus Pilatus entrega Jesus ba sira atu prega ba krus too mate.<verse eid="JHN 19:16a" /></para>
  <para style="s">Ema prega Nai Jesus iha krus</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mateus 27:32-44</ref>; <ref loc="MRK 15:21-32">Marcos 15:21-32</ref>; <ref loc="LUK 23:26-43">Lucas 23:26-43</ref>)</para>
  <para style="p">
    <verse number="16b" style="v" sid="JHN 19:16b" />Nunee tropas sira lori Jesus sai. <verse eid="JHN 19:16b" /><verse number="17" style="v" sid="JHN 19:17" />Jesus rasik hulan hela Nia krus. Sira sai husi sidade lao too iha fatin ida naran Fatin Ulun Ruin, iha lian Ebreu dehan Golgota.<verse eid="JHN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 19:18" />Too iha nebaa, sira prega Jesus iha krus. Sira mos prega ema nain rua tan iha krus iha Jesus nia sor-sorin, Jesus mak iha klaran. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pilatus haruka ema hakerek liafuan iha ai kabelak ida, depois taka iha Jesus nia krus leten. Liafuan nee hakerek hanesan nee: “Jesus Ema Nazaré, ema Judeu sira nia Liurai.”<verse eid="JHN 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 19:20" />Ema Judeu barak lee liafuan nee, tanba fatin nebee prega Jesus ba iha krus nee la dook husi sidade, i liafuan nee hakerek iha lian Ebreu, Latin, ho lian Gregu. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Maibee nai lulik Judeu nia ulun sira baa hatete ba Pilatus dehan, “Senhor la bele hakerek ‘ema Judeu sira nia Liurai’! Diak liu hakerek hanesan nee: ‘Ema nee dehan, Nia mak ema Judeu sira nia Liurai.’ ”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Maibee Pilatus hataan, “Buat nebee hau hakerek tiha ona, la bele troka fali.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Bainhira tropas sira prega tiha Jesus iha krus, sira nain haat fahe Jesus nia hena ba malu. Hela deit Nia hena naruk ida nebee soru tomak husi leten too kraik, la suku. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Depois tropas sira hatete ba malu, “Ita lalika lees hena naruk nee. Mai ita dada rifa deit, atu hatene see mak bele hetan.” Buat nee akontese hodi halo tuir saida mak hakerek iha Livru Sagradu dehan,</para>
  <para style="q1" vid="JHN 19:24">“Sira fahe Hau nia hena ba malu;</para>
  <para style="q2" vid="JHN 19:24">sira dada rifa para hatene, Hau nia hena naruk monu ba see.”</para>
  <para style="p" vid="JHN 19:24">Nunee tropas sira halo tuir duni liafuan nee.<note caller="+" style="x"><char style="xo" closed="false">19:24: </char><char style="xt" closed="false"><ref loc="PSA 22:19">Salmu 22:19</ref></char></note><verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Iha momentu nee Jesus nia inan, Nia inan nia alin feto, Kleofas nia kaben Maria, ho Maria Madalena hamriik besik hela krus. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Jesus haree Nia inan iha nebaa i haree Nia eskolante ida nebee Nia hadomi liu nee mos hamriik besik, depois Nia dehan ba Nia inan, “Hau nia inan, ida nee ita nia oan.” <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />I Nia hatete ba Nia eskolante nee dehan, “Ida nee o nia inan.” Komesa husi loron nee, eskolante nee lori Jesus nia inan baa hela iha nia uma.<verse eid="JHN 19:27" /></para>
  <para style="s">Nai Jesus mate</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mateus 27:45-56</ref>; <ref loc="MRK 15:33-41">Marcos 15:33-41</ref>; <ref loc="LUK 23:44-49">Lucas 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Jesus hatene katak Nia halo hotu ona Nia knaar. Nunee, atu halo tuir buat nebee hakerek iha Livru Sagradu, Nia dehan, “Hau hamrook.”<note caller="+" style="x"><char style="xo" closed="false">19:28: </char><char style="xt" closed="false"><ref loc="PSA 69:22">Salmu 69:22</ref>, <ref loc="PSA 22:16">22:16</ref></char></note><verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Iha nebaa iha manko ida, tua siin iha laran. Ema ida baa foti esponza rohan ida habokon ho tua siin nee, tau ba iha ai hisopu hodi lolo ba iha Jesus nia ibun. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Jesus koko tiha tua siin nee, Nia dehan, “Hotu ona.” Depois Nia hakruuk hodi hakotu Nia iis.<verse eid="JHN 19:30" /></para>
  <para style="s">Soldadu sona diman ba Nai Jesus nia sorin</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Loron nee Sesta, loron preparasaun ba Sabadu, aban fali loron boot Paskua nian. Nai ulun Judeu sira lakohi atu ema nia mate isin tara nafatin iha krus leten iha loron Sabadu. Entaun sira baa husu Pilatus atu haruka ema baa baku tohar tiha ema nebee tara iha krus nee nia ain para sira bele mate lalais. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Nunee tropas sira baa uluk ema nain rua nebee mak prega iha Jesus nia sorin loos ho sorin karuk hodi baku tohar sira nia ain. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Maibee bainhira sira too iha Jesus, sira haree Nia mate tiha ona. Nunee sira la baku tohar Nia ain. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Maibee soldadu ida hodi diman sona Jesus nia sorin, derepenti raan ho bee suli sai.<verse eid="JHN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 19:35" />Ida nebee konta buat nee ba imi, nia haree ho matan rasik, nee mak nia hatene katak buat nebee nia konta nee loos duni. Nia foo sasin atu imi mos bele fiar. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Buat nee akontese ba Jesus tuir saida mak hakerek nanis ona iha Livru Sagradu dehan, “Nia ruin ida mos ema la baku tohar.”<note caller="+" style="x"><char style="xo" closed="false">19:36: </char><char style="xt" closed="false"><ref loc="EXO 12:46">Ézodu 12:46</ref>; <ref loc="NUM 9:12">Númerus 9:12</ref>; <ref loc="PSA 34:21">Salmu 34:21</ref></char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Iha Livru Sagradu mos hakerek dehan, “Sira sei hateke ba Ida nebee mak sira sona.”<note caller="+" style="x"><char style="xo" closed="false">19:37: </char><char style="xt" closed="false"><ref loc="ZEC 12:10">Zacarias 12:10</ref>; <ref loc="REV 1:7">Apokalipse 1:7</ref></char></note><verse eid="JHN 19:37" /></para>
  <para style="s">Ema hakoi Nai Jesus nia mate isin</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mateus 27:57-61</ref>; <ref loc="MRK 15:42-47">Marcos 15:42-47</ref>; <ref loc="LUK 23:50-56">Lucas 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Depois José husi sidade Arimateia baa husu lisensa ba Pilatus atu hasai Jesus nia mate isin. José nee Jesus nia eskolante ida, maibee nia sub-subar deit tanba nia tauk nai ulun Judeu sira. Pilatus foo lisensa, nunee José baa hasai Jesus nia mate isin. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Nicodemos, ida nebee uluk mai hasoru Jesus iha kalan, nia mos baa hamutuk ho José. Nia lori ai morin ho mina morin diak nian hamutuk maizoumenus kilu tolu-nulu. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Ema nain rua nee lori Jesus nia mate isin, depois falun ho hena mutin diak nian hamutuk ho ai morin ho mina morin nee. Ida nee tuir ema Judeu sira nia kultura hakoi mate.<verse eid="JHN 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 19:41" />Iha fatin nebee ema prega Jesus, iha toos ida. Iha toos laran nee iha rate foun ida mak seidauk uza hodi hakoi mate. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Tempu badak ona tanba atu tama ona ba loron Sabadu, ema Judeu nia loron deskansa. Nunee sira nain rua haloot Jesus nia mate isin iha rate nee, tanba besik hela.<note caller="+" style="f"><char style="fr" closed="false">19:42: </char><char style="ft" closed="false">Tuir ema Judeu, kuandu loro matan monu mak tama ona ba loron foun. Nunee bainhira loro matan monu iha Sesta, tama kedas ba loron Sabadu. Iha loron Sabadu sira la bele halo servisu.</char></note><verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Nai Jesus moris fila fali</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mateus 28:1-8</ref>; <ref loc="MRK 16:1-8">Marcos 16:1-8</ref>; <ref loc="LUK 24:1-12">Lucas 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Iha loron Domingu, dadeer-saan nakukun, Maria Madalena baa iha rate. Too iha nebaa, nia haree fatuk ida hodi taka rate nee muda sees tiha ona. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Nunee nia halai baa foo hatene Simão Pedro ho eskolante ida nebee Jesus hadomi liu nee. Nia dehan, “Ema foti tiha ona ita nia Nai nia mate isin husi rate, sira tau iha nebee ami la hatene.”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Nunee Pedro ho eskolante ida seluk nee baa iha rate. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Sira nain rua halai, maibee eskolante ida seluk nee halai makaas liu i nia mak too uluk iha rate. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Nia hakruuk hateke tama ba rate laran, nia haree hetan hena mutin nebee uza hodi falun mate isin, maibee nia la tama liu ba laran.<verse eid="JHN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 20:6" />Simão Pedro too ikus, i nia tama kedas ba rate laran. Nia haree hena mutin nee iha nebaa. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />Nia mos haree hena nebee mak ema bobar ba Jesus nia ulun, hena nee hikar tiha ona, la tau hamutuk ho hena seluk. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Depois eskolante ida nebee too uluk nee mos tama ba laran. Nia haree i fiar. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Iha tempu nebaa sira nain rua seidauk kompriende buat nebee hakerek nanis ona iha Livru Sagradu dehan Jesus tenki moris fali husi mate. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Depois eskolante nain rua nee fila ba uma.<verse eid="JHN 20:10" /></para>
  <para style="s">Nai Jesus hatudu Aan ba Maria Madalena</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mateus 28:9-10</ref>; <ref loc="MRK 16:9-11">Marcos 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Maibee Maria sei hamriik tanis hela iha rate oin. Tanis dadauk, nia hakruuk hodi hateke ba rate laran. <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />Nia haree anju rua hatais hena mutin. Sira tuur iha fatin nebee foin dadauk Jesus nia mate isin latan ba nee. Ida tuur iha ulun, ida seluk tuur iha ain. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Sira husu ba Maria, “Senhora, tansaa mak ita tanis?”</para>
  <para style="p" vid="JHN 20:13">Nia hataan, “Ema hasai tiha ona hau nia Nai nia mate isin, sira tau iha nebee hau la hatene.”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Koalia hotu tiha Maria hateke ba kotuk, nia haree Jesus hamriik hela iha nebaa, maibee nia la hatene katak nee Jesus.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Jesus husu nia dehan, “Senhora, tansaa mak ita tanis? Ita buka see?”</para>
  <para style="p" vid="JHN 20:15">Maria la konhese Jesus, nia hanoin toos nain mak koalia ho nia. Entaun nia husu fali dehan, “Senhor, se karik ita boot mak lori Nia baa tau fali iha fatin seluk, foo hatene mai hau, ita boot tau Nia iha nebee, atu hau bele baa foti Nia.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Jesus hatete ba nia, “Maria!”</para>
  <para style="p" vid="JHN 20:16">Maria fila oin hodi hateke ba Jesus dehan, “Raboni”, iha lian Ebreu dehan “Mestri.”<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Jesus dehan, “La bele kaer Hau, tanba Hau seidauk sae fali ba iha Hau nia Aman. Maibee baa foo hatene ba Hau nia maun-alin sira katak agora Hau atu sae fali ona ba iha Hau nia Aman, Nia mos imi nia Aman. Nia nee Hau nia Maromak ho mos imi nia Maromak.”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Nunee Maria Madalena baa foo hatene Jesus nia eskolante sira dehan, “Ohin hau haree ita nia Nai!” Depois nia foo hatene Jesus nia lia menon ba sira.<verse eid="JHN 20:18" /></para>
  <para style="s">Nai Jesus hatudu Aan ba Nia eskolante sira</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mateus 28:16-20</ref>; <ref loc="MRK 16:14-18">Marcos 16:14-18</ref>; <ref loc="LUK 24:36-49">Lucas 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Iha Domingu kalan, Jesus nia eskolante sira halibur hamutuk, sira xavi odamatan metin tanba tauk nai ulun Judeu sira. Derepenti deit Jesus mai hamriik iha sira nia klaran hodi kumprimenta sira dehan, “Maromak foo pas ba imi!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Koalia tiha nunee, Jesus mos hatudu Nia liman kanek ho sorin kanek ba sira. Bainhira sira haree sira nia Nai, sira kontenti teb-tebes.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />Depois Jesus hatete ba sira dala ida tan, “Maromak foo pas ba imi. Hanesan Hau nia Aman haruka Hau mai, nunee mos Hau haruka imi baa.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Depois Nia huu Nia iis ba sira hodi dehan, “Simu Espiritu Santu ba. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Se imi foo perdaun ba ema ruma nia sala, Maromak mos foo perdaun ba nia. Se imi la foo perdaun ba nia sala, Maromak mos la foo perdaun ba nia.”<note caller="+" style="x"><char style="xo" closed="false">20:23: </char><char style="xt" closed="false"><ref loc="MAT 16:19">Mateus 16:19</ref>, <ref loc="MAT 18:18">18:18</ref></char></note><verse eid="JHN 20:23" /></para>
  <para style="s">Nai Jesus hatudu Aan ba Tomé</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Husi Jesus nia eskolante nain sanulu resin rua, iha ida naran Tomé, baibain ema bolu Kaduak. Bainhira Jesus hatudu Aan ba Nia eskolante sira, Tomé nee la iha. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Nunee eskolante sira seluk dehan ba nia, “Ami haree tiha ona ita nia Nai!”</para>
  <para style="p" vid="JHN 20:25">Maibee Tomé hatete ba sira dehan, “Hau haree lai pregu fatin iha Nia liman hodi hatama hau nia liman fuan ba, i hau hatama lai hau nia liman ba iha Nia sorin kanek. Nee mak foin hau fiar!”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Liu tiha semana ida, Jesus nia eskolante sira halibur malu fali iha uma, Tomé mos iha nebaa. Odamatan xavi metin hotu, maibee Jesus mai hamriik iha sira nia klaran hodi kumprimenta sira dehan, “Maromak foo pas ba imi!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Depois Jesus hatete ba Tomé, “Haree Hau nia liman, i hatama o nia liman fuan ba! Lolo o nia liman mai hodi hatama iha Hau nia sorin kanek nee. Keta duvida tan maibee fiar ba!”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Tomé dehan ba Jesus, “Hau nia Nai. Hau nia Maromak!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Depois Jesus hatete ba Tomé, “O fiar tanba o haree tiha ona Hau. Maibee ema nebee fiar maski nia la haree Hau, nia hetan bensaun boot liu tan.”<verse eid="JHN 20:29" /></para>
  <para style="s">Livru nee hakerek atu ema bele fiar ba Nai Jesus</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Jesus halo milagre barak tan iha Nia eskolante sira nia oin hodi hatudu Maromak nia kbiit. Milagre sira nee la hakerek hotu iha livru nee. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Maibee buat sira nee hakerek atu imi bele fiar katak Jesus mak Mesias, Maromak nia Oan. Liu husi imi nia fiar ba Nia mak imi hetan moris rohan-laek.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Nai Jesus hatudu Aan ba Nia eskolante iha tasi ibun</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Iha loron ida Jesus hatudu Aan ba Nia eskolante sira dala ida tan, iha tasi Tiberiades.<note caller="+" style="f"><char style="fr" closed="false">21:1: </char><char style="ft" closed="false">Tasi Tiberiades mak tasi Galileia.</char></note> Istoria nee hanesan nee: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Iha tempu nee Jesus nia eskolante balu hamutuk iha fatin ida. Sira nee mak Simão Pedro, Tomé ema baibain bolu Kaduak, Natanael husi aldeia Kaná provinsia Galileia, Zebedeu nia oan nain rua ho mos eskolante nain rua tan.<verse eid="JHN 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 21:3" />Iha momentu nebaa Simão Pedro dehan, “Hau atu baa tasi hodi tiha ikan.”</para>
  <para style="p" vid="JHN 21:3">Eskolante sira seluk hataan, “Ami baa hotu.” Entaun sira baa sae roo, maibee tiha ikan kalan tomak, la hetan buat ida.<note caller="+" style="x"><char style="xo" closed="false">21:3: </char><char style="xt" closed="false"><ref loc="LUK 5:5">Lucas 5:5</ref></char></note><verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />Iha dadeer-saan rai huun mutin, Jesus hamriik iha tasi ibun, maibee eskolante sira nee la konhese katak Nia nee Jesus. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Jesus bolu sira hodi husu, “Belun sira, imi hetan ikan ruma ka lae?”</para>
  <para style="p" vid="JHN 21:5">Sira hataan, “Ami la hetan buat ida.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Entaun Nia hatete ba sira, “Soe imi nia redi baa iha roo nia sorin loos mak imi sei hetan.”</para>
  <para style="p" vid="JHN 21:6">Bainhira sira soe redi, sira atu dada fali redi nee ba iha roo, dada la bele, tanba iha ikan barak teb-tebes.<note caller="+" style="x"><char style="xo" closed="false">21:6: </char><char style="xt" closed="false"><ref loc="LUK 5:6">Lucas 5:6</ref></char></note><verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Depois eskolante ida nebee Jesus hadomi liu nee hatete ba Pedro, “Ita nia Nai mak iha nebaa.” Bainhira Simão Pedro rona katak sira nia Nai mak iha nebaa, nia hatais fali nia faru, tanba ohin nia hasai nia faru atu bele servisu. Depois nia haksoit tuun ba bee laran hodi nani ba tasi ibun. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Eskolante sira seluk mak hean roo, dada tuir redi nebee nakonu ho ikan nee. Sira hean roo too iha tasi ibun laduun dook, maizoumenus metru atus ida.<verse eid="JHN 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 21:9" />Bainhira sira tuun husi roo, sira haree ahi lakan, ikan balu tunu hela iha ahi nee, iha mos paun. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Depois Jesus hatete ba sira, “Ikan nebee imi foin hetan nee, lori balu mai.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Entaun Simão Pedro sae ba roo leten hodi dada redi nee ba tasi ibun. Redi nee nakonu ho ikan bo-boot, hamutuk atus ida lima-nulu resin tolu. Maski ikan barak hanesan nee, maibee redi la naklees.<verse eid="JHN 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12" />Jesus hatete ba sira, “Mai haan ona.” Eskolante sira la iha ida mak brani husu tuir Nia nee see. Sira hatene katak Nia nee sira nia Nai.<verse eid="JHN 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 21:13" />Depois Jesus baa foti paun hodi foo ba sira, ikan mos Nia halo nunee.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Durante Jesus moris fali husi mate, ida nee mak dala tolu ona Nia hatudu Aan ba Nia eskolante sira.<verse eid="JHN 21:14" /></para>
  <para style="s">Nai Jesus koalia ho Pedro</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Bainhira sira haan hotu tiha, Jesus husu ba Simão Pedro dehan, “Simão, João nia oan, o hadomi Hau liu fali sira hotu ka?”</para>
  <para style="p" vid="JHN 21:15">Pedro hataan, “Loos Nai, Ita Boot hatene hau hadomi Ita Boot.”</para>
  <para style="p" vid="JHN 21:15">Jesus dehan, “Entaun hein Hau nia bibi oan sira.”<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Dala ida tan Jesus husu ba nia, “Simão, João nia oan, o hadomi Hau ka?”</para>
  <para style="p" vid="JHN 21:16">Nia hataan, “Loos Nai, Ita Boot hatene hau hadomi Ita Boot.”</para>
  <para style="p" vid="JHN 21:16">Jesus dehan tan, “Entaun tau matan ba Hau nia bibi sira.”<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Jesus husu ba dala tolu dehan, “Simão, João nia oan, o hadomi Hau ka?”</para>
  <para style="p" vid="JHN 21:17">Pedro laran susar tanba Jesus husu nia dala tolu kedas dehan, “O hadomi Hau ka?” Nunee nia dehan, “Nai, Ita Boot hatene buat hotu, Ita Boot hatene katak hau hadomi Ita Boot.”</para>
  <para style="p" vid="JHN 21:17">Jesus hatete ba nia, “Entaun hein Hau nia bibi sira. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Hau hatete lo-loos ba o, uluk o sei joven, o kesi o nia kanotak hodi lao tuir o nia hakarak rasik. Maibee aban-bainrua o katuas ona, o sei lolo o nia liman atu ema seluk kesi i lori o ba iha fatin nebee mak o lakohi atu baa.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Jesus nia liafuan nee foo sai oinsaa mak Pedro atu mate hodi hatudu sai Maromak nia kbiit boot.<note caller="+" style="f"><char style="fr" closed="false">21:19: </char><char style="ft" closed="false">Tuir istoria balu, tinan tolu-nulu tan Pedro mos mate iha krus. Maibee nia senti nia la merese atu mate hanesan Nai Jesus, nunee nia husu atu sira prega nia ho ulun tuun.</char></note></para>
  <para style="p" vid="JHN 21:19">Hotu tiha Jesus hatete ba Pedro, “Mai tuir Hau!”<verse eid="JHN 21:19" /></para>
  <para style="s">Eskolante nebee Jesus hadomi</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Pedro hateke ba kotuk, nia haree eskolante ida nebee Jesus hadomi liu lao tuir sira. Eskolante nee mak uluk tuur sadere ba Jesus bainhira haan kalan hamutuk, nia mak husu ba Jesus dehan, “Nai, see mak atu faan Ita Boot?”<note caller="+" style="x"><char style="xo" closed="false">21:20: </char><char style="xt" closed="false"><ref loc="JHN 13:25">João 13:25</ref></char></note> <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Bainhira Pedro haree eskolante nee, nia husu ba Jesus, “Nai, oinsaa kona ba nia?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Jesus hataan, “Se karik Hau hakarak nia moris nafatin too Hau fila fali mai, o la presiza hatene. O tenki tuir Hau.”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Tanba Jesus koalia nunee mak ema nebee fiar ba Nia komesa konta ba malu katak eskolante ida nee sei la mate. Afinal Jesus laos dehan eskolante nee aban-bainrua la mate. Maibee Nia dehan, “Se karik Hau hakarak nia moris nafatin too Hau fila fali mai, o la presiza hatene.”<verse eid="JHN 21:23" /></para>
  <para style="s">João taka nia surat</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Eskolante ida nee mak foo sasin kona ba akontesimentu sira nee. Nia mak hakerek buat sira nee, i ita hatene katak buat nebee nia foo sai nee loos hotu.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Sei iha buat barak tan mak Jesus halo. Se karik hakerek buat sira nee hotu, hau hanoin fatin iha mundu nee la too atu rai livru sira nee.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>