<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id" />
  <para style="h">Mateus</para>
  <para style="toc1">Mateus</para>
  <para style="toc2">Mateus</para>
  <para style="toc3">Mat</para>
  <para style="mt2">Evanjelhu</para>
  <para style="mt1">Mateus</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Nai Jesus nia bei-ala sira</para>
  <para style="r">(<ref loc="LUK 3:23-38">Lucas 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Livru nee koalia kona ba Jesus Kristu. Jesus husi liurai David nia jerasaun, i David nee husi Abraão nia jerasaun.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Jesus nia bei-ala sira nia naran komesa husi Abraão too liurai David hanesan tuir mai nee:</para>
  <para style="q1" vid="MAT 1:2">Abraão nia oan Isac.</para>
  <para style="q1" vid="MAT 1:2">Isac nia oan Jacó.</para>
  <para style="q1" vid="MAT 1:2">Jacó nia oan Judá ho ninia maun-alin sira.<verse eid="MAT 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3" />Judá nia oan Perez ho Zerá, sira nia inan naran Tamar.</para>
  <para style="q1" vid="MAT 1:3">Perez nia oan Hesron.</para>
  <para style="q1" vid="MAT 1:3">Hesron nia oan Aram.<verse eid="MAT 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4" />Aram nia oan Aminadab.</para>
  <para style="q1" vid="MAT 1:4">Aminadab nia oan Nahason.</para>
  <para style="q1" vid="MAT 1:4">Nahason nia oan Salmon.<verse eid="MAT 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5" />Salmon nia oan Boaz, nia inan naran Rahab.</para>
  <para style="q1" vid="MAT 1:5">Boaz nia oan Obed, nia inan naran Rute.</para>
  <para style="q1" vid="MAT 1:5">Obed nia oan Jessé.<verse eid="MAT 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6" />Jessé nia oan liurai David.</para>
  <para style="p" vid="MAT 1:6">Jesus nia bei-ala sira husi liurai David too nia jerasaun nebee mak militar lori baa dadur iha rai Babilónia, sira nia naran mak tuir mai nee:</para>
  <para style="q1" vid="MAT 1:6">David nia oan Salomão, nia inan nee uluk Urias nia feen.<verse eid="MAT 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7" />Salomão nia oan Roboão.</para>
  <para style="q1" vid="MAT 1:7">Roboão nia oan Abias.</para>
  <para style="q1" vid="MAT 1:7">Abias nia oan Aza.<verse eid="MAT 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8" />Aza nia oan Josafat.</para>
  <para style="q1" vid="MAT 1:8">Josafat nia oan Jorão.</para>
  <para style="q1" vid="MAT 1:8">Jorão nia oan Uzias.<verse eid="MAT 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9" />Uzias nia oan Jotam.</para>
  <para style="q1" vid="MAT 1:9">Jotam nia oan Ahaz.</para>
  <para style="q1" vid="MAT 1:9">Ahaz nia oan Ezequias.<verse eid="MAT 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10" />Ezequias nia oan Manassés.</para>
  <para style="q1" vid="MAT 1:10">Manassés nia oan Amon.</para>
  <para style="q1" vid="MAT 1:10">Amon nia oan Jozias.<verse eid="MAT 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11" />Jozias nia oan mak Jekonias ho nia alin sira. Iha sira nia tempu mak militar lori povu Israel baa dadur iha Babilónia.<note caller="+" style="x"><char style="xo" closed="false">1:11: </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 Liurai 24:14-15</ref>; <ref loc="2CH 36:10">2 Krónikas 36:10</ref>; <ref loc="JER 27:20">Jeremias 27:20</ref></char></note><verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Jesus nia bei-ala sira husi tempu dadur nee ba oin mak tuir mai nee:</para>
  <para style="q1" vid="MAT 1:12">Jekonias nia oan Salatiel.</para>
  <para style="q1" vid="MAT 1:12">Salatiel nia oan Zorobabel.<verse eid="MAT 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13" />Zorobabel nia oan Abiud.</para>
  <para style="q1" vid="MAT 1:13">Abiud nia oan Eliakim.</para>
  <para style="q1" vid="MAT 1:13">Eliakim nia oan Azur.<verse eid="MAT 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14" />Azur nia oan Zadok.</para>
  <para style="q1" vid="MAT 1:14">Zadok nia oan Jakim.</para>
  <para style="q1" vid="MAT 1:14">Jakim nia oan Eliud.<verse eid="MAT 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15" />Eliud nia oan Eleazar.</para>
  <para style="q1" vid="MAT 1:15">Eleazar nia oan Matan.</para>
  <para style="q1" vid="MAT 1:15">Matan nia oan Jacó.<verse eid="MAT 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16" />Jacó nia oan José.</para>
  <para style="p" vid="MAT 1:16">José kaben ho Maria, i Maria mak kous Jesus. Jesus nee, ema mos bolu Nia Mesias, nee dehan katak, Salvador nebee Maromak promete hori uluk kedas atu haruka mai.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Nunee, komesa husi Abraão too David hamutuk jerasaun sanulu resin haat. Husi David too militar lori povu Israel baa dadur iha Babilónia mos jerasaun sanulu resin haat. I husi jerasaun nebee dadur iha Babilónia too Mesias hamutuk jerasaun sanulu resin haat tan.<verse eid="MAT 1:17" /></para>
  <para style="s">Nai Jesus Kristu moris mai</para>
  <para style="r">(<ref loc="LUK 2:1-7">Lucas 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Istoria kona ba Jesus Kristu nia moris hanesan nee: Nia inan Maria troka prenda ona ho José. Maibee bainhira sira nain rua seidauk moris hamutuk nudar feen ho laen, Maria hatene ona katak nia isin rua liu husi Espiritu Santu nia kbiit.<note caller="+" style="x"><char style="xo" closed="false">1:18: </char><char style="xt" closed="false"><ref loc="LUK 1:27">Lucas 1:27</ref></char></note> <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Bainhira José hatene katak Maria isin rua ona, nia hakarak atu hakotu sira nain rua nia relasaun. Maibee José lakohi halo moe Maria iha ema barak nia oin, tanba nia ema ida nebee laran moos. Nunee nia desidi atu hakotu nonook deit.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Maibee bainhira José hanoin hela buat nee, Nai Maromak nia anju ida mai hatudu aan ba nia liu husi mehi. Anju nee dehan, “José, liurai David nia jerasaun, la bele tauk atu kaben ho Maria. Tanba Labarik nebee mak iha Maria nia kabun laran nee mai husi Espiritu Santu. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Maria sei tuur ahi oan mane ida. O tenki foo naran Jesus, tanba Nia mak sei salva Nia povu husi sira nia sala.”<note caller="+" style="f"><char style="fr" closed="false">1:21: </char><char style="ft" closed="false">Naran Jesus dehan “Nai Maromak foo salvasaun”.</char></note> <note caller="+" style="x"><char style="xo" closed="false">1:21: </char><char style="xt" closed="false"><ref loc="LUK 1:31">Lucas 1:31</ref></char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Buat hirak nee hotu sai nunee tuir saida mak Nai Maromak nia profeta hori uluk kedas hakerek ona dehan, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Aban-bainrua iha feto raan ida sei isin rua hodi tuur ahi oan mane ida. Labarik nee nia naran Emanuel.” Nee dehan katak “Maromak hamutuk ho ita”.<note caller="+" style="x"><char style="xo" closed="false">1:23: </char><char style="xt" closed="false"><ref loc="ISA 7:14">Isaias 7:14</ref></char></note><verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Bainhira José hadeer, nia halo tuir saida mak anju nee hatete ba nia. Nia kaben ho Maria. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Maibee nia la halo relasaun ho Maria hanesan feen-laen too Maria tuur ahi. I José foo naran ba Labarik nee, Jesus.<note caller="+" style="x"><char style="xo" closed="false">1:25: </char><char style="xt" closed="false"><ref loc="LUK 2:21">Lucas 2:21</ref></char></note><verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Matenek nain sira husi lorosae mai adora Nai Jesus</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Jesus moris iha aldeia Belém iha provinsia Judeia. Iha tempu nebaa liurai Herodes mak ukun rai nee. Iha loron ida matenek nain balu nebee hatene siik sinal iha fitun, sira mai husi rai dook, husi parte lorosae. Too iha sidade Jerusalém, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />sira husu, “Kosok Oan nebee moris atu sai ema Judeu sira nia liurai nee iha nebee? Ami haree tiha ona fitun ida iha parte lorosae nebee foo sinal kona ba Nia moris. Tanba nee mak ami mai atu adora Nia.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Bainhira liurai Herodes rona sira nia liafuan nee, nia laran susar teb-tebes, nunee mos povu iha Jerusalém tomak. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Depois Herodes halibur nai lulik nia ulun sira ho mestri relijiaun sira hotu hodi husu, “Mesias, Salvador nebee Maromak promete hori uluk kedas atu haruka mai nee, sei moris iha nebee?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Sira hataan, “Iha aldeia Belém iha provinsia Judeia. Tanba hori uluk kedas Maromak nia profeta hakerek dehan,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Imi ema Belém, iha povu Judá nia rain,</para>
  <para style="q2" vid="MAT 2:6">keta hanoin dehan imi mak kiik liu iha Judá nee.</para>
  <para style="q1" vid="MAT 2:6">Tanba ukun nain ida sei mai husi imi nia rain,</para>
  <para style="q2" vid="MAT 2:6">Nia mak sei sai bibi atan ba Hau nia povu Israel.’”<note caller="+" style="x"><char style="xo" closed="false">2:6: </char><char style="xt" closed="false"><ref loc="MIC 5:1">Mikeias 5:1</ref>; <ref loc="2SA 5:2">2 Samuel 5:2</ref></char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Rona nunee, Herodes bolu nonook matenek nain sira nee hodi husu ba sira, hori-bainhira loos mak fitun nee mosu. I sira mos esplika ba nia. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Depois nia haruka sira baa Belém. Nia hameno hela dehan, “Senhor sira baa buka di-diak Labarik nee. Bainhira hetan ona Nia, mai fali foo hatene hau, para hau mos bele baa adora Nia.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9-10" style="v" sid="MAT 2:9-10" />Rona tiha liurai nia liafuan, matenek nain sira nee komesa lao ba dadauk. Derepenti fitun nebee sira uluk haree iha lorosae nee, mosu fila fali iha sira nia oin. Haree nunee, sira mos kontenti teb-tebes, i sira lao tuir fitun nee. Too iha Labarik nee nia hela fatin, fitun nee mos para iha uma leten.<verse eid="MAT 2:9-10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 2:11" />Nunee sira tama liu ba uma laran haree Labarik nee ho Nia inan Maria, i sira hakneak hakruuk too rai hodi adora Nia. Depois sira hasai sira nia prezenti karun teb-tebes, sira foo ba Labarik nee osan mean, ai been morin ho mina morin diak nian.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Hotu tiha Maromak foo hanoin ba sira liu husi mehi katak sira la bele fila fali ba Herodes. Entaun sira fila ba sira nia rain liu husi dalan seluk.<verse eid="MAT 2:12" /></para>
  <para style="s">José lori Nai Jesus ho Maria halai ba rai Ejitu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Bainhira matenek nain sira fila tiha, Nai Maromak nia anju mai hatudu aan ba José liu husi mehi. Anju nee foo hatene dehan, “Hadeer ona! Lori Labarik nee ho Nia inan halai ba iha rai Ejitu, tanba Herodes buka hela Labarik nee atu oho Nia. Hela iha nebaa too hau foo hatene fali ba o katak imi bele fila.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Iha kalan nee kedas, José hadeer lori Labarik nee ho Nia inan halai ba Ejitu, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />i sira hela iha nebaa too Herodes mate. Uluk kedas Nai Maromak koalia liu husi Nia profeta dehan, “Hau bolu Hau nia Oan sai husi Ejitu.” Agora sai duni nunee.<note caller="+" style="x"><char style="xo" closed="false">2:15: </char><char style="xt" closed="false"><ref loc="HOS 11:1">Oseias 11:1</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">Liurai Herodes oho labarik kiikoan sira iha Belém</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Bainhira liurai Herodes hatene katak, matenek nain sira halo beik tiha nia hodi fila liu husi dalan seluk, nia hirus teb-tebes. Nia foo orden ba soldadu sira atu baa Belém vila ho rai nebee besik hodi oho hotu labarik mane kiikoan nebee tinan rua mai kraik. Nia foo orden nunee tuir informasaun husi matenek nain sira kona ba tempu nebee mak sira haree fitun nee mosu.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Buat nee akontese tuir saida mak Maromak nia profeta Jeremias foo sai uluk kedas dehan,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Iha ema tanis hakilar iha aldeia Rama.</para>
  <para style="q2" vid="MAT 2:18">Rakél tanis halerik tanba nia oan sira la iha ona.</para>
  <para style="q1" vid="MAT 2:18">Ema hamaus nia atu la bele tanis</para>
  <para style="q2" vid="MAT 2:18">maibee nia lakohi rona.”<note caller="+" style="x"><char style="xo" closed="false">2:18: </char><char style="xt" closed="false"><ref loc="JER 31:15">Jeremias 31:15</ref></char></note><verse eid="MAT 2:18" /></para>
  <para style="s">José lori Nai Jesus ho Maria fila husi Ejitu</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ikus mai liurai Herodes mate. Iha tempu nebaa Nai Maromak nia anju hatudu aan ba José liu husi mehi iha rai Ejitu. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Anju nee dehan, “Hadeer ona! Lori Labarik nee ho Nia inan fila fali ba rai Israel, tanba ema nebee hakarak oho Labarik nee mate tiha ona.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Entaun José hadeer i lori Labarik nee ho Nia inan fila fali ba Israel.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Maibee too iha nebaa, José rona katak liurai Herodes nia oan Arquelau mak ukun fali iha provinsia Judeia, nunee nia tauk atu fila ba nebaa. Maromak mos foo hanoin ba nia liu husi mehi. Entaun sira baa hela fali iha provinsia Galileia, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />iha aldeia ida naran Nazaré. Nunee buat nebee profeta sira uluk koalia akontese duni. Sira dehan, “Ema sei bolu Nia Nazaré oan.”<note caller="+" style="x"><char style="xo" closed="false">2:23: </char><char style="xt" closed="false"><ref loc="MRK 1:24">Marcos 1:24</ref>; <ref loc="LUK 2:39">Lucas 2:39</ref>; <ref loc="JHN 1:45">João 1:45</ref></char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">João Sarani Nain prepara dalan ba Nai Jesus</para>
  <para style="r">(<ref loc="MRK 1:1-8">Marcos 1:1-8</ref>; <ref loc="LUK 3:1-18">Lucas 3:1-18</ref>; <ref loc="JHN 1:19-28">João 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Molok Jesus hahuu Nia knaar, João Sarani Nain komesa hanorin ema iha rai fuik maran iha rai Judeia. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Nia foo sai dehan, “Hakribi ona imi nia sala, tanba tempu besik ona atu Maromak ukun imi.”<note caller="+" style="x"><char style="xo" closed="false">3:2: </char><char style="xt" closed="false"><ref loc="MAT 4:17">Mateus 4:17</ref>; <ref loc="MRK 1:15">Marcos 1:15</ref></char></note><verse eid="MAT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3" />Uluk liu Maromak nia profeta Isaias hakerek ona kona ba João dehan,</para>
  <para style="q1" vid="MAT 3:3">“Iha ema ida foo sai ho lian makaas iha rai fuik maran dehan,</para>
  <para style="q2" vid="MAT 3:3">‘Imi tenki hadia dalan para simu ita nia Nai.</para>
  <para style="q3" vid="MAT 3:3">Halo loos tiha dalan nebee kleuk para Nia lao tuir.’ ”<note caller="+" style="x"><char style="xo" closed="false">3:3: </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isaias 40:3</ref></char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />João nia hena halo husi kuda kamelu nia fulun, i nia sintu halo husi animal nia kulit. Nia hahaan mak gafanhotu ho bani been.<note caller="+" style="x"><char style="xo" closed="false">3:4: </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Liurai 1:8</ref></char></note><verse eid="MAT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 3:5" />Ema barak mai husi fatin oi-oin atu haree João. Sira mai husi sidade Jerusalém, husi provinsia Judeia tomak ho mos husi aldeia sira nebee mak besik iha mota Jordaun. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Sira foo sai sira nia sala, depois João foo sarani sira iha mota Jordaun.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Iha mos ema barak husi grupu Farizeu ho Saduseu mai atu João foo sarani sira. Maibee bainhira João haree sira, nia siak sira dehan, “Hoi! Samea nia oan! Maromak sei kastigu imi tanba imi nia hahalok aat. Karik ema bosok imi dehan imi bele sarani para sees aan husi kastigu nee.<note caller="+" style="x"><char style="xo" closed="false">3:7: </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mateus 12:34</ref>, <ref loc="MAT 23:33">23:33</ref></char></note> <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Imi tenki muda imi nia hahalok hodi hatudu katak imi husik duni imi nia sala. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />I lalika hanoin dehan, imi loos ona tanba deit imi Abraão nia jerasaun. Lae! Hau hatete ba imi, fatuk sira nee mos, Maromak bele halo sai Abraão nia jerasaun.<note caller="+" style="x"><char style="xo" closed="false">3:9: </char><char style="xt" closed="false"><ref loc="JHN 8:33">João 8:33</ref></char></note> <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Maromak hanesan toos nain nebee kaer hela baliu atu tesi ona ai huun too abut. Ai huun hotu-hotu nebee la foo fuan diak, Nia sei tesi tiha hodi soe ba ahi laran.<note caller="+" style="x"><char style="xo" closed="false">3:10: </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mateus 7:19</ref></char></note><verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Hau foo sarani imi ho bee deit para hatudu katak, imi hakribi ona imi nia sala. Maibee la kleur tan, Ema ida boot liu hau sei mai. Atu lori deit Nia sandalias mos, hau la serve. Ema nee laos foo sarani imi ho bee, maibee Nia sei foo sarani imi hodi Espiritu Santu ho mos ahi. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Nia hanesan natar nain nebee prontu ona atu haketak hare isin ho hare kulit sira nee. Hotu tiha, hare isin nia sei rai di-diak iha armazen, maibee hare kulit nia soe tiha ba ahi ida nebee nunka mate.”<verse eid="MAT 3:12" /></para>
  <para style="s">João foo sarani Nai Jesus</para>
  <para style="r">(<ref loc="MRK 1:9-11">Marcos 1:9-11</ref>; <ref loc="LUK 3:21-22">Lucas 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Iha tempu nebaa Jesus mai husi rai Galileia ba iha mota Jordaun para João foo sarani Nia. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Maibee João lakohi. Nia dehan, “Tuir lo-loos Ita Boot mak foo sarani hau. Nusaa mak Ita Boot mai fali iha hau?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Jesus hataan, “Husik ba, agora nee ita mak foo sarani Hau para halo tuir Maromak nia hakarak.” João mos simu.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Sarani hotu tiha, Jesus sai kedas husi bee laran. Derepenti lalehan nakloke, i Nia haree Maromak nia Espiritu hanesan manu pombu tuun ba iha Nia. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Depois lian ida husi lalehan hatete,</para>
  <para style="q1" vid="MAT 3:17">“Ida nee Hau nia Oan Doben;</para>
  <para style="q2" vid="MAT 3:17">Nia halo Hau nia laran haksolok teb-tebes.”<note caller="+" style="x"><char style="xo" closed="false">3:17: </char><char style="xt" closed="false"><ref loc="GEN 22:2">Jénesis 22:2</ref>; <ref loc="PSA 2:7">Salmu 2:7</ref>; <ref loc="ISA 42:1">Isaias 42:1</ref>; <ref loc="MAT 12:18">Mateus 12:18</ref>, <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">Marcos 1:11</ref>; <ref loc="LUK 9:35">Lucas 9:35</ref></char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Satanás koko Nai Jesus</para>
  <para style="r">(<ref loc="LUK 4:1-13">Lucas 4:1-13</ref>; <ref loc="MRK 1:12-13">Marcos 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Hotu tiha, Maromak nia Espiritu domina Jesus i lori Nia ba iha rai fuik maran atu Satanás bele koko Nia.<note caller="+" style="x"><char style="xo" closed="false">4:1: </char><char style="xt" closed="false"><ref loc="HEB 2:18">Ebreu 2:18</ref>, <ref loc="HEB 4:15">4:15</ref></char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Iha nebaa Jesus jejun durante loron haat-nulu, kalan haat-nulu, too Nia hamlaha. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Depois diabu tentador mai koko Jesus. Diabu nee dehan, “Se O Maromak nia Oan duni, haruka fatuk sira nee sai paun.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Maibee Jesus hataan, “Iha Livru Sagradu hakerek,</para>
  <para style="q1" vid="MAT 4:4">‘Ema kriatura laos moris husi hahaan deit,</para>
  <para style="q2" vid="MAT 4:4">maibee presiza mos Maromak nia liafuan hotu-hotu.’”<note caller="+" style="x"><char style="xo" closed="false">4:4: </char><char style="xt" closed="false"><ref loc="DEU 8:3">Deuteronómiu 8:3</ref></char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Depois Satanás lori Jesus ba iha Jerusalém, Maromak nia sidade. Satanás lori Nia baa hamriik iha uma kreda boot nia tutun, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />i dehan, “Se O Maromak nia Oan duni, soe aan tuun ba rai. Tanba iha Livru Sagradu hakerek dehan,</para>
  <para style="q1" vid="MAT 4:6">‘Maromak sei haruka Nia anju sira mai kuidadu O.’</para>
  <para style="q2" vid="MAT 4:6">‘Sira sei lolo liman hodi tane O, atu O nia ain la bele kona fatuk.’”<note caller="+" style="x"><char style="xo" closed="false">4:6: </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Salmu 91:11-12</ref></char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Maibee Jesus hataan dehan, “Iha Livru Sagradu mos bandu ema dehan,</para>
  <para style="q1" vid="MAT 4:7">‘La bele koko Maromak, o nia Nai.’”<note caller="+" style="x"><char style="xo" closed="false">4:7: </char><char style="xt" closed="false"><ref loc="DEU 6:16">Deuteronómiu 6:16</ref></char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Depois Satanás lori tan Jesus ba iha foho ida aas teb-tebes nia tutun, i hatudu ba Jesus nasaun hotu-hotu iha mundu tomak ho sira nia riku-soin hotu. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Satanás dehan ba Jesus, “Buat sira nee hotu hau sei foo ba O, naran katak O hakneak hodi adora hau.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Maibee Jesus hataan fali dehan, “Satanás, sai tiha husi nee! Tanba iha Livru Sagradu haruka ema hotu-hotu nunee:</para>
  <para style="q1" vid="MAT 4:10">‘O tenki adora Maromak, o nia Nai,</para>
  <para style="q2" vid="MAT 4:10">i serbi mak Nia deit.’ ”<note caller="+" style="x"><char style="xo" closed="false">4:10: </char><char style="xt" closed="false"><ref loc="DEU 6:13">Deuteronómiu 6:13</ref></char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Hotu tiha Satanás husik tiha Jesus, i anju sira mai serbi Nia.<verse eid="MAT 4:11" /></para>
  <para style="s">Nai Jesus komesa foo sai Liafuan Diak</para>
  <para style="r">(<ref loc="MRK 1:14-15">Marcos 1:14-15</ref>; <ref loc="LUK 4:14-15">Lucas 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Iha loron ida, Jesus rona katak ema kaer tiha João Sarani Nain hodi baa dadur iha komarka. Nunee Jesus husik tiha provinsia Judeia baa fali iha provinsia Galileia.<note caller="+" style="x"><char style="xo" closed="false">4:12: </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mateus 14:3</ref>; <ref loc="MRK 6:17">Marcos 6:17</ref>; <ref loc="LUK 3:19-20">Lucas 3:19-20</ref></char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Too iha nebaa, Nia baa uluk iha Nia aldeia Nazaré, depois baa hela fali iha sidade Kafarnaum. Sidade nee iha tasi Galileia nia sorin, iha rai Zebulón ho Naftali.<note caller="+" style="x"><char style="xo" closed="false">4:13: </char><char style="xt" closed="false"><ref loc="JHN 2:12">João 2:12</ref></char></note> <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Nunee Jesus halo tuir saida mak Maromak nia profeta Isaias hakerek nanis ona dehan,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Rai Zebulón ho rai Naftali,</para>
  <para style="q2" vid="MAT 4:15">besik tasi Galileia, iha mota Jordaun nia sorin ba,</para>
  <para style="q3" vid="MAT 4:15">rai Galileia, ema nebee laos Judeu nia hela fatin.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Iha rai nee, ema uluk moris iha nakukun laran,</para>
  <para style="q2" vid="MAT 4:16">maibee agora sira hetan ona naroman boot.</para>
  <para style="q1" vid="MAT 4:16">Iha sira nia rain, uluk nakukun atu lori sira ba mate haketak aan husi Maromak,</para>
  <para style="q2" vid="MAT 4:16">maibee agora naroman mosu ona hodi leno sira.”<note caller="+" style="x"><char style="xo" closed="false">4:16: </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">Isaias 9:1-2</ref></char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Iha tempu nebaa Jesus komesa foo sai ba ema dehan, “Hakribi ona imi nia sala, tanba tempu besik ona atu Maromak ukun imi.”<note caller="+" style="x"><char style="xo" closed="false">4:17: </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mateus 3:2</ref></char></note><verse eid="MAT 4:17" /></para>
  <para style="s">Nai Jesus bolu peskador nain haat atu tuir Nia</para>
  <para style="r">(<ref loc="MRK 1:16-20">Marcos 1:16-20</ref>; <ref loc="LUK 5:1-11">Lucas 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Iha loron ida Jesus lao hela iha tasi ibun Galileia. Nia haree peskador nain rua soe hela dai iha tasi. Sira nain rua nee maun-alin, maun naran Simão, ema mos bolu nia Pedro. Alin naran André. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Jesus dehan ba sira, “Mai tuir Hau! Imi nee peskador ikan nian, maibee agora Hau sei hanorin imi atu sai peskador ba ema.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Sira mos husik kedas sira nia dai hodi tuir Jesus.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Jesus lao nafatin, Nia haree tan ema nain rua, Tiago ho nia alin João. Sira nain rua hadia hela redi iha roo laran hamutuk ho sira nia aman Zebedeu. Jesus bolu tan sira nain rua atu tuir Nia. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Tiago ho João mos husik kedas sira nia aman ho sira nia roo hodi tuir Jesus.<verse eid="MAT 4:22" /></para>
  <para style="s">Nai Jesus hanorin ema barak i kura sira nia moras</para>
  <para style="r">(<ref loc="LUK 6:17-19">Lucas 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Jesus lao iha provinsia Galileia tomak hodi hanorin iha ema Judeu sira nia uma kreda. Nia foo sai Liafuan Diak kona ba oinsaa Maromak ukun nudar Liurai. I ema nia moras oi-oin deit, Nia kura hotu kedas.<note caller="+" style="x"><char style="xo" closed="false">4:23: </char><char style="xt" closed="false"><ref loc="MAT 9:35">Mateus 9:35</ref>; <ref loc="MRK 1:39">Marcos 1:39</ref></char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Buat nebee Jesus halo, ema konta iha nebee-nebee too iha provinsia Síria tomak. Ema barak mai lori sira nia maluk nebee moras oi-oin, balu diabu tama iha laran, balu moras bibi maten, liman-ain mate ho moras sel-seluk tan. I Jesus kura moras sira nee hotu. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ema barak teb-tebes mak tuir Jesus. Iha ema husi Galileia, husi rai Dekápolis, husi sidade Jerusalém ho provinsia Judeia, balu tan mai husi mota Jordaun nia sorin ba.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Nai Jesus hanorin iha foho ida</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Iha loron ida Jesus haree ema barak mai hobur Nia, entaun Nia baa sae iha foho ida. Too iha nebaa, Nia tuur, i Nia eskolante sira mai haleu Nia. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Depois Nia komesa hanorin sira.<verse eid="MAT 5:2" /></para>
  <para style="s">See mak hetan bensaun</para>
  <para style="r">(<ref loc="LUK 6:20-23">Lucas 6:20-23</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />Jesus hanorin nunee:</para>
  <para style="q1" vid="MAT 5:3">“Ema sira nebee hatene aan dehan sira presiza hela Maromak,</para>
  <para style="q2" vid="MAT 5:3">sira simu bensaun nunee: Sira nee Maromak nia reinu.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Ema sira nebee tanis ho laran susar,</para>
  <para style="q2" vid="MAT 5:4">sira simu bensaun nunee: Maromak sei hamaran sira nia matan been.<note caller="+" style="x"><char style="xo" closed="false">5:4: </char><char style="xt" closed="false"><ref loc="ISA 61:2">Isaias 61:2</ref></char></note><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Ema sira nebee haraik aan,</para>
  <para style="q2" vid="MAT 5:5">sira simu bensaun nunee: Maromak sei foo mundu foun ba sira atu hela.<note caller="+" style="x"><char style="xo" closed="false">5:5: </char><char style="xt" closed="false"><ref loc="PSA 37:11">Salmu 37:11</ref></char></note><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Ema sira nebee hakarak teb-tebes atu moris loos,</para>
  <para style="q2" vid="MAT 5:6">sira simu bensaun nunee: Maromak sei foo tuir sira nia hakarak nee.<note caller="+" style="x"><char style="xo" closed="false">5:6: </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">Isaias 55:1-2</ref></char></note><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Ema sira nebee mak hatudu laran luak ba ema seluk,</para>
  <para style="q2" vid="MAT 5:7">sira simu bensaun nunee: Maromak sei hatudu Nia laran luak ba sira.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Ema sira nebee laran moos,</para>
  <para style="q2" vid="MAT 5:8">sira simu bensaun nunee: Sira sei haree Maromak.<note caller="+" style="x"><char style="xo" closed="false">5:8: </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">Salmu 24:3-4</ref></char></note><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Ema sira nebee gosta tulun ema seluk atu moris iha dame nia laran,</para>
  <para style="q2" vid="MAT 5:9">sira simu bensaun nunee: Maromak sei bolu sira nee Nia oan.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Ema nebee hetan terus tanba moris tuir Maromak nia hakarak,</para>
  <para style="q2" vid="MAT 5:10">sira simu bensaun nunee: Sira nee Maromak nia reinu.<note caller="+" style="x"><char style="xo" closed="false">5:10: </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 Pedro 3:14</ref></char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Bainhira ema hatete aat imi i halo terus imi tanba imi tuir Hau, ka sira bobar lia tuun-sae hodi hatete aat imi nia naran tanba Hau, imi hetan bensaun.<note caller="+" style="x"><char style="xo" closed="false">5:11: </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 Pedro 4:14</ref></char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Kuandu ema halo imi terus nunee, simu ho haksolok i kontenti deit ba, tanba Maromak sei foo premiu boot ba imi iha lalehan. Keta haluha katak, Maromak nia profeta sira nebee moris iha tempu uluk mos, ema halo terus sira hanesan nee.”<note caller="+" style="x"><char style="xo" closed="false">5:12: </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 Krónikas 36:16</ref>; <ref loc="ACT 7:52">Apostolu sira nia Istoria 7:52</ref></char></note><verse eid="MAT 5:12" /></para>
  <para style="s">Ema nebee mak tuir Nai Jesus, hanesan masin ho naroman</para>
  <para style="r">(<ref loc="MRK 9:50">Marcos 9:50</ref>; <ref loc="LUK 14:34-35">Lucas 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Imi hanesan masin ba mundu. Maibee se masin nee sai miis ona karik, ita la bele halo meer fila fali, la iha folin tan ona. Ita soe tiha deit i ema sama.<note caller="+" style="x"><char style="xo" closed="false">5:13: </char><char style="xt" closed="false"><ref loc="MRK 9:50">Marcos 9:50</ref>; <ref loc="LUK 14:34-35">Lucas 14:34-35</ref></char></note><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Imi mos hanesan ahi-oan nebee foo naroman ba mundu. Imi nia naroman hanesan sidade nebee mak harii iha foho leten, ema hotu-hotu bele haree.<note caller="+" style="x"><char style="xo" closed="false">5:14: </char><char style="xt" closed="false"><ref loc="JHN 8:12">João 8:12</ref>, <ref loc="JHN 9:5">9:5</ref></char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Nunee mos bainhira ema sunu ahi-oan, nia nunka taka fali ho sanan. Maibee ahi-oan tenki tau iha fatin aas para bele foo naroman ba ema hotu nebee iha uma laran.<note caller="+" style="x"><char style="xo" closed="false">5:15: </char><char style="xt" closed="false"><ref loc="MRK 4:21">Marcos 4:21</ref>; <ref loc="LUK 8:16">Lucas 8:16</ref>, <ref loc="LUK 11:33">11:33</ref></char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Imi nia moris mos tenki nunee, imi tenki sai naroman ba ema seluk atu nunee sira bele haree buat diak nebee imi halo. Nunee sira sei hahii imi nia Aman iha lalehan.”<note caller="+" style="x"><char style="xo" closed="false">5:16: </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 Pedro 2:12</ref></char></note><verse eid="MAT 5:16" /></para>
  <para style="s">Nai Jesus kumpri Maromak nia liafuan hotu</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“La bele hanoin katak, Hau mai iha mundu nee atu halakon Moisés nia lei ho profeta sira nia liafuan. Lae! Hau mai laos atu halakon maibee atu kumpri lo-loos buat hotu-hotu nebee mak sira hakerek tiha ona. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Hau hatete lo-loos ba imi, bainhira lalehan ho rai sei iha, buat hotu nebee hakerek iha lei nee, buat kiikoan ida mos sei la lakon, too buat hotu nebee Maromak hatete, sai realidade.<note caller="+" style="x"><char style="xo" closed="false">5:18: </char><char style="xt" closed="false"><ref loc="LUK 16:17">Lucas 16:17</ref></char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Nunee, see mak kontra lei ruma tanba dehan lei nee kiikoan deit, depois hanorin ema seluk atu lalika halo tuir, Maromak sei konsidera nia ema kiik liu iha Nia reinu. Maibee see mak moris tuir lei nee i hanorin ema seluk mos atu halo tuir, Maromak sei konsidera nia ema boot iha Nia reinu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Hau dehan ba imi, imi tenki moris loos liu fali mestri relijiaun sira ho ema Farizeu sira. Se lae, imi la bele tama iha Maromak nia reinu.”<verse eid="MAT 5:20" /></para>
  <para style="s">Keta hirus malu</para>
  <para style="r">(<ref loc="LUK 12:57-59">Lucas 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Jesus hanorin nafatin Nia eskolante sira dehan, “Imi rona ona katak uluk ita nia bei-ala sira hetan lei ida nebee dehan, ‘La bele oho ema. See mak oho ema, nia sei hetan kastigu.’<note caller="+" style="x"><char style="xo" closed="false">5:21: </char><char style="xt" closed="false"><ref loc="EXO 20:13">Ézodu 20:13</ref>; <ref loc="DEU 5:17">Deuteronómiu 5:17</ref></char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Maibee Hau hatete ba imi, see mak hirus ema seluk, nia sei hetan kastigu. See mak hirus ema seluk too tolok, nia sei baa hataan iha tribunal. I see mak hirus ema seluk dehan, ‘O beik-teen’, ema nee lao dadauk ona ba iha ahi infernu.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Nunee, se o baa iha altar atu foo o nia oferta ba Maromak, maibee too iha nebaa o hanoin hetan ema ruma hirus o tanba o nia hahalok, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />husik lai o nia oferta iha altar oin. Depois baa dame malu ho ema nee lai mak foin fila fali mai hodi foo oferta nee ba Maromak.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Se ema ruma atu lori o ba iha tribunal, diak liu molok too tribunal o dame malu kedas ho nia. Se lae, ema nee bele entrega o ba iha juis, juis bele entrega o ba iha polisia, i polisia hatama o iha kadeia. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Hau dehan lo-loos ba o, o selu kotu tiha multa mak foin bele sai fali husi kadeia.”<verse eid="MAT 5:26" /></para>
  <para style="s">Ita tenki soe saida deit mak halo ita monu ba sala</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Imi rona ona lei nebee dehan, ‘La bele halo sala seksual ho ema nia feen ka laen.’<note caller="+" style="x"><char style="xo" closed="false">5:27: </char><char style="xt" closed="false"><ref loc="EXO 20:14">Ézodu 20:14</ref>; <ref loc="DEU 5:18">Deuteronómiu 5:18</ref></char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Maibee Hau hatete ba imi, se mane ida fihir feto ida hodi hanoin foer ba nia, mane nee halo ona sala seksual ho nia iha nia laran. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Se o nia matan sorin loos halo o monu ba sala karik, sukit sai o nia matan nee i soe tiha. Diak liu o moris ho matan sorin deit, duke o tama ba iha infernu ho matan kompletu.<note caller="+" style="x"><char style="xo" closed="false">5:29: </char><char style="xt" closed="false"><ref loc="MAT 18:9">Mateus 18:9</ref>; <ref loc="MRK 9:47">Marcos 9:47</ref></char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Se o nia liman loos halo o monu ba sala karik, tesi sai o nia liman nee i soe tiha. Diak liu o moris ho liman ida deit, duke o tama ba iha infernu ho liman kompletu.”<note caller="+" style="x"><char style="xo" closed="false">5:30: </char><char style="xt" closed="false"><ref loc="MAT 18:8">Mateus 18:8</ref>; <ref loc="MRK 9:43">Marcos 9:43</ref></char></note><verse eid="MAT 5:30" /></para>
  <para style="s">Feen ho laen keta soe malu</para>
  <para style="r">(<ref loc="MAT 19:9">Mateus 19:9</ref>; <ref loc="MRK 10:11-12">Marcos 10:11-12</ref>; <ref loc="LUK 16:18">Lucas 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“Iha lei ida nebee dehan, ‘See mak hakarak soe nia feen, tenki halo surat deklarasaun ida foo ba nia.’<note caller="+" style="x"><char style="xo" closed="false">5:31: </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Deuteronómiu 24:1-4</ref>; <ref loc="MAT 19:7">Mateus 19:7</ref>; <ref loc="MRK 10:4">Marcos 10:4</ref></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Maibee Hau hatete ba imi, mane so bele soe nia feen kuandu nia feen halo ona sala seksual ho ema seluk. Se nia feen la sala ida, maibee mane nee soe nia, nee dehan katak, mane nee mak dudu nia feen atu halo sala seksual. Tanba se nia feen hola fali mane seluk, nee sala ona. I se mane ida kaben fali ho feto nebee nia laen soe tiha nee, mane nee mos halo sala seksual.”<note caller="+" style="x"><char style="xo" closed="false">5:32: </char><char style="xt" closed="false"><ref loc="MAT 19:9">Mateus 19:9</ref>; <ref loc="MRK 10:11-12">Marcos 10:11-12</ref>; <ref loc="LUK 16:18">Lucas 16:18</ref>; <ref loc="1CO 7:10-11">1 Korintu 7:10-11</ref></char></note><verse eid="MAT 5:32" /></para>
  <para style="s">La bele jura para haforsa ita nia promesa</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Nunee mos imi rona ona katak, uluk ita nia bei-ala sira simu lei ida nebee dehan, ‘Buat nebee mak o jura ba Nai Maromak, o tenki halo tuir duni, la bele kontra fali.’<note caller="+" style="x"><char style="xo" closed="false">5:33: </char><char style="xt" closed="false"><ref loc="LEV 19:12">Levítiku 19:12</ref>; <ref loc="NUM 30:2">Númerus 30:2</ref>; <ref loc="DEU 23:21">Deuteronómiu 23:21</ref></char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Maibee Hau hatete ba imi, la bele halo juramentu saida deit. La bele jura temi lalehan, tanba lalehan nee Maromak nia kadeira hodi tuur kaer ukun.<note caller="+" style="x"><char style="xo" closed="false">5:34: </char><char style="xt" closed="false"><ref loc="JAS 5:12">Tiago 5:12</ref>; <ref loc="ISA 66:1">Isaias 66:1</ref>; <ref loc="MAT 23:22">Mateus 23:22</ref></char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />La bele jura temi rai, tanba rai nee fatin hodi Maromak tau Nia ain. La bele jura temi Jerusalém, tanba Jerusalém nee Liurai Boot nia sidade.<note caller="+" style="x"><char style="xo" closed="false">5:35: </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isaias 66:1</ref>; <ref loc="PSA 48:3">Salmu 48:3</ref></char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />I la bele jura temi imi nia ulun rasik, tanba imi nia fuuk lahan ida mos, imi la bele halo metan ka halo mutin. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Entaun se imi promete atu halo buat ruma, dehan deit, ‘Sin, hau sei halo.’ Se lae, dehan deit, ‘Lae.’ Se imi aumenta tan para haforsa imi nia promesa, entaun liafuan sira nee mai husi aat nain.”<verse eid="MAT 5:37" /></para>
  <para style="s">La bele halo aat ba ema nebee mak halo aat ita</para>
  <para style="r">(<ref loc="LUK 6:29-30">Lucas 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Imi rona ona lei nebee dehan, ‘Matan tenki selu ho matan, nehan tenki selu ho nehan.’<note caller="+" style="x"><char style="xo" closed="false">5:38: </char><char style="xt" closed="false"><ref loc="EXO 21:24">Ézodu 21:24</ref>; <ref loc="LEV 24:20">Levítiku 24:20</ref>; <ref loc="DEU 19:21">Deuteronómiu 19:21</ref></char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Maibee Hau hatete ba imi, la bele halo aat fali ba ema nebee mak halo aat imi. Se ema ruma basa imi nia hasan sorin loos karik, foo tan hasan sorin ba nia. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Se iha ema ruma hakarak hadau imi nia faru, foo mos imi nia faru manas ba nia. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Se iha militar ruma mak obriga imi atu hulan nia sasaan lao too kilometru ida, kontinua lao ho nia too kilometru rua. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Se ema husu imi nia sasaan ruma, foo deit ba. Se ema hakarak empresta buat ruma husi imi, foo empresta ba.”<verse eid="MAT 5:42" /></para>
  <para style="s">Hadomi ita nia inimigu</para>
  <para style="r">(<ref loc="LUK 6:27-28">Lucas 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Imi rona ema dehan, ‘Hadomi o nia maluk, odi o nia inimigu.’<note caller="+" style="x"><char style="xo" closed="false">5:43: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Levítiku 19:18</ref></char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Maibee Hau hatete ba imi, hadomi imi nia inimigu sira, i harohan atu Maromak tulun ema nebee mak halo terus imi. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Se imi halo nunee, imi hatudu katak imi halo tuir imi nia Aman iha lalehan. Tanba Nia halo loro matan sae hodi foo naroman ba ema diak ho mos ema aat. I Nia foo udan ba ema nebee moris loos ho mos ema nebee moris iha sala laran. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Se imi hadomi deit ema nebee mak hadomi imi, imi atu manaan saida? Tanba kobrador impostu sira gosta han-matak ema maibee sira mos hadomi ema nebee mak hadomi sira. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Se imi kumprimenta deit imi nia maluk, imi nia hahalok nee diak liu ema seluk ka? Lae! Ema nebee la konhese Maromak mos halo ida nee. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Imi tenki laran diak teb-tebes, hanesan mos imi nia Aman iha lalehan laran diak.”<note caller="+" style="x"><char style="xo" closed="false">5:48: </char><char style="xt" closed="false"><ref loc="LEV 19:2">Levítiku 19:2</ref>; <ref loc="DEU 18:13">Deuteronómiu 18:13</ref></char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Bainhira ajuda ema kiak, la bele konta ba-mai</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Jesus hanorin nafatin nunee: “Kuidadu, keta foti aan hatudu imi nia hahalok diak iha ema nia oin atu sira bele haree. Se imi halo nunee, imi nia Aman iha lalehan sei la selu imi nia kolen.<note caller="+" style="x"><char style="xo" closed="false">6:1: </char><char style="xt" closed="false"><ref loc="MAT 23:5">Mateus 23:5</ref></char></note><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Bainhira o foo buat ruma ba ema kiak, la bele konta tuun-sae hanesan fali ema nebee buka oin. Sira sempre konta tuir sira nia diak iha uma kreda laran ho mos iha estrada ibun para ema bele gaba sira. Hau dehan lo-loos ba imi, sira simu hotu ona sira nia kolen. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Maibee bainhira o foo buat ruma ba ema kiak, saida mak o nia liman loos foo, o nia liman karuk lalika hatene. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Ho nunee, o foo sub-subar deit. O nia Aman iha lalehan haree hotu saida mak ema halo sub-subar, i Nia sei selu o nia kolen.”<verse eid="MAT 6:4" /></para>
  <para style="s">Oinsaa halo orasaun</para>
  <para style="r">(<ref loc="LUK 11:2-4">Lucas 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“Bainhira imi halo orasaun, la bele hanesan ema nebee buka oin. Sira gosta hamriik halo orasaun iha uma kreda laran ho mos iha estrada boot atu ema bele haree. Hau dehan lo-loos ba imi, sira simu hotu ona sira nia kolen.<note caller="+" style="x"><char style="xo" closed="false">6:5: </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">Lucas 18:10-14</ref></char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Maibee bainhira imi halo orasaun, tama iha kuartu laran, taka odamatan i halo orasaun ba imi nia Aman iha lalehan. Imi nia Aman nee, ema ida la haree. Maibee Nia haree hotu saida mak ema halo sub-subar, i Nia sei selu imi nia kolen.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Bainhira imi halo orasaun, la bele koalia fila ba fila mai hanesan fali jentiu sira, tanba sira hanoin dehan harohan ho liafuan naruk mak foin sira nia maromak simu. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />La bele halo orasaun hanesan sira, tanba molok imi husu buat ruma ba imi nia Aman iha lalehan, Nia hatene uluk ona buat nebee mak imi presiza. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Nunee, halo orasaun hanesan nee:</para>
  <para style="q1" vid="MAT 6:9">‘Ami nia Aman iha lalehan,</para>
  <para style="q2" vid="MAT 6:9">tulun ema atu foti aas Ita Boot nia naran santu.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Mai ukun ema hotu-hotu ba.</para>
  <para style="q1" vid="MAT 6:10">Tulun ema iha mundu nee atu halo tuir Ita Boot nia hakarak,</para>
  <para style="q2" vid="MAT 6:10">hanesan sira iha lalehan mos halo tuir.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Foo ai haan natoon mai ami iha loron ida nee.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Perdua ami nia sala,</para>
  <para style="q2" vid="MAT 6:12">hanesan ami mos perdua ona ba ema nebee halo sala mai ami.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Keta husik ami atu monu ba tentasaun,</para>
  <para style="q2" vid="MAT 6:13">maibee hasai ami husi buat aat.</para>
  <para style="q1" vid="MAT 6:13">[Ita Boot mak Liurai,</para>
  <para style="q2" vid="MAT 6:13">Ita Boot mak Kbiit Nain,</para>
  <para style="q1" vid="MAT 6:13">Ita Boot mak serve atu ema hotu-hotu hahii,</para>
  <para style="q2" vid="MAT 6:13">too tinan ba tinan. Amen.]’<note caller="+" style="f"><char style="fr" closed="false">6:13: </char><char style="ft" closed="false">b: Kopia evanjelhu Mateus husi tempu antigu barak. Balu hakerek versikulu 13b nee, balu lae.</char></note><verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Se imi perdua ema nebee mak halo sala hasoru imi, entaun imi nia Aman iha lalehan mos sei perdua imi nia sala. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Maibee se imi la perdua ema nebee mak halo sala hasoru imi, imi nia Aman mos sei la perdua imi nia sala.”<note caller="+" style="x"><char style="xo" closed="false">6:15: </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">Marcos 11:25-26</ref></char></note><verse eid="MAT 6:15" /></para>
  <para style="s">Oinsaa halo jejun</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Bainhira imi halo jejun, la bele halo imi nia oin tristi hanesan fali ema sira nebee buka oin. Sira hatudu aan nunee para ema bele hatene katak sira jejun hela. Hau dehan lo-loos ba imi, sira simu hotu ona sira nia kolen. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Maibee bainhira imi halo jejun, fase imi nia oin halo moos i sui imi nia fuuk halo kabeer, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />para ema nebee haree imi la nota katak imi jejun hela. So imi nia Aman iha lalehan mak hatene. Ema ida la haree Nia, maibee Nia haree hotu saida mak ema halo sub-subar, i Nia sei selu imi nia kolen.”<verse eid="MAT 6:18" /></para>
  <para style="s">Rai riku-soin iha lalehan</para>
  <para style="r">(<ref loc="LUK 12:33-34">Lucas 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“La bele rai riku-soin mundu nian ba imi nia aan, tanba iha mundu nee nehek mutin bele estraga, bele fuhuk tiha, i naok-teen bele tama baa foti.<note caller="+" style="x"><char style="xo" closed="false">6:19: </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">Tiago 5:2-3</ref></char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Diak liu rai riku-soin ba imi nia aan iha lalehan. Iha nebaa nehek mutin la estraga, la fuhuk, i naok-teen mos la tama baa foti. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Tanba imi nia riku-soin tau iha nebee, imi nia laran mos iha nebaa.”<verse eid="MAT 6:21" /></para>
  <para style="s">Moris iha naroman</para>
  <para style="r">(<ref loc="LUK 11:34-36">Lucas 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“Imi nia matan hanesan ahi-oan nebee foo naroman ba imi nia aan tomak. Se imi nia matan haree moos, imi nia aan mos naroman. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Maibee se imi nia matan aat, imi nia aan mos sai nakukun tiha. I kuandu naroman nebee iha imi nia aan la iha ona, entaun imi nia moris nakukun teb-tebes.”<verse eid="MAT 6:23" /></para>
  <para style="s">Keta preokupa ho imi nia moris</para>
  <para style="r">(<ref loc="LUK 16:13">Lucas 16:13</ref>, <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“La iha ema ida mak bele serbi patraun nain rua. Tanba nia sei odi ida, i hadomi ida seluk. Nia sei foo laran ba ida, i lakohi interese ida seluk. Nunee mos imi la bele serbi Maromak i serbi osan dala ida.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Tanba nee, Hau hatete ba imi, lalika preokupa ho imi nia moris loro-loron, atu haan saida, ka atu hemu saida ka atu hatais saida. Ita nia moris folin liu hahaan, i ita nia isin lolon folin liu ropa. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Haree took manu fuik sira nebee semo iha leten nebaa. Manu sira nee la kuda batar, la silu batar, la rai hahaan iha armazen. Maibee imi nia Aman iha lalehan foo ai haan ba sira. Imi folin liu manu sira nee. <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Se imi preokupa kona ba imi nia moris, nee bele aumenta imi nia tinan ka? Lae! Atu aumenta oras ida deit mos la bele.<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Entaun nusaa mak imi preokupa kona ba imi nia ropa? Haree took ai funan nebee moris iha rai fuik nebaa. Ai funan nee la halo servisu, la soru tais. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Maibee Hau dehan ba imi, liurai Salomão, maski riku teb-tebes, nia hatais kapaas halo nusaa mos, ai funan sira nee kapaas liu nafatin. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Duut nebee ohin loron matak iha rai fuik, aban ema soe fali ba ahi laran mos, Maromak halo furak. Saa tan imi! Nia sei foo ropa ba imi hatais. Entaun nusaa mak imi nia fiar fraku hanesan nee?!<note caller="+" style="x"><char style="xo" closed="false">6:30: </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 Liurai 10:4-7</ref>; <ref loc="2CH 9:3-6">2 Krónikas 9:3-6</ref></char></note> <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Nee duni lalika preokupa dehan, ‘Ita atu haan saida?’ ka ‘Ita atu hemu saida?’ ka ‘Ita atu hatais saida?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ema nebee la konhese Maromak, sira buka tuun-sae buat sira nee. Maibee imi nia Aman iha lalehan hatene hotu imi nia presiza nee. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Hakaas aan liu-liu atu serbi Maromak nudar imi nia Liurai hodi moris loos iha Nia oin mak Maromak sei foo tan buat sira nee ba imi. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Entaun lalika preokupa kona ba loron aban, tanba loron aban nee preokupasaun ketak fali. Susar nebee ita hetan iha loron ida nee, too ona ba loron nee.”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Keta ansi foo sala ba ema</para>
  <para style="r">(<ref loc="LUK 6:37-38">Lucas 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Jesus hanorin nafatin Nia eskolante sira dehan, “La bele ansi foo sala ba ema, atu nunee Maromak la foo sala ba o. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Imi tetu ema seluk nia sala oinsaa, Maromak mos sei tetu imi nunee. I sasukat nebee mak imi uza ba ema seluk, Maromak sei uza fali sasukat nee ba imi.<note caller="+" style="x"><char style="xo" closed="false">7:2: </char><char style="xt" closed="false"><ref loc="MRK 4:24">Marcos 4:24</ref></char></note><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />Nusaa mak o haree ai uut iha ema seluk nia matan, maibee ai kabelak nebee taka o nia matan rasik, o la senti? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Oinsaa mak o brani dehan ba o nia maluk, ‘Mai hau hasai tiha ai uut nee husi o nia matan.’ Afinal iha ai kabelak ida taka hela o nia matan rasik. <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Imi nee koalia oin seluk, hahalok oin seluk! Hasai tiha uluk ai kabelak iha o nia matan rasik mak foin o haree hetan para bele hasai ai uut husi o nia maluk nia matan.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Buat nebee Maromak nian, la bele foo ba ema nebee lakohi rona. Nee hanesan imi foo fali ba asu, ka foo buat murak mean ba fahi. Se imi halo nunee, fahi sei sama tiha ba rai, i asu sei fila hodi ataka imi.”<verse eid="MAT 7:6" /></para>
  <para style="s">Harohan beibeik ba Nai Maromak</para>
  <para style="r">(<ref loc="LUK 11:9-13">Lucas 11:9-13</ref>)</para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 7:7" />“Husu beibeik ba Maromak,</para>
  <para style="q2" vid="MAT 7:7">Nia sei foo.</para>
  <para style="q1" vid="MAT 7:7">Buka beibeik,</para>
  <para style="q2" vid="MAT 7:7">o sei hetan.</para>
  <para style="q1" vid="MAT 7:7">Dere beibeik odamatan,</para>
  <para style="q2" vid="MAT 7:7">odamatan sei nakloke ba o.<verse eid="MAT 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 7:8" />Tanba, see mak husu beibeik ba Maromak, nia sei simu. See mak buka beibeik, nia sei hetan. See mak dere beibeik odamatan, Maromak sei loke ba nia.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Imi aman sira, bainhira imi nia oan husu paun, imi foo fali fatuk ka? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Se nia husu ikan, imi foo fali samea ka? Nunka! <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Maski imi ema aat, maibee imi hatene foo buat diak ba imi nia oan sira. Saa tan imi nia Aman iha lalehan! Bainhira imi husu, Nia sei foo buat diak teb-tebes ba imi.”<note caller="+" style="x"><char style="xo" closed="false">7:11: </char><char style="xt" closed="false"><ref loc="LUK 6:31">Lucas 6:31</ref></char></note><verse eid="MAT 7:11" /></para>
  <para style="s">Ukun fuan nebee mak importante liu</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Saida mak o hakarak atu ema seluk halo ba o, o mos tenki halo buat nee ba ema seluk. Ida nee mak Moisés nia lei ho profeta sira nia livru hanorin hori uluk kedas.”<verse eid="MAT 7:12" /></para>
  <para style="s">Odamatan lalehan nian kloot</para>
  <para style="r">(<ref loc="LUK 13:24">Lucas 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“Atu tama ba moris rohan-laek, tenki liu husi odamatan kloot. Tanba odamatan ba infernu luan, nia dalan mos fasil atu ema liu, i ema barak mak tama liu husi odamatan nee. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Maibee odamatan atu tama ba moris rohan-laek kloot, nia dalan mos susar, i ema uitoan deit mak buka odamatan nee too hetan.”<verse eid="MAT 7:14" /></para>
  <para style="s">Ita bele konhese profeta falsu husi sira nia hahalok</para>
  <para style="r">(<ref loc="LUK 6:43-44">Lucas 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Kuidadu ho ema nebee bosok dehan, sira Maromak nia profeta. Sira finji maus hanesan bibi malae, afinal sira gosta estraga ema hanesan asu fuik. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Imi sei hatene sira husi sira nia hahalok, hanesan ita hatene ai huun ida husi nia fuan. Ai tarak nunka foo fuan fali uvas ka ai fuan figeira. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ai huun nebee diak sei foo fuan nebee diak. I ai huun nebee la diak sei foo fuan nebee aat. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ai huun diak la bele foo fuan nebee mak aat. I ai huun nebee aat la bele foo fuan diak. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Ai nebee mak la foo fuan diak, sei tesi tiha hodi soe ba ahi.<note caller="+" style="x"><char style="xo" closed="false">7:19: </char><char style="xt" closed="false"><ref loc="MAT 3:10">Mateus 3:10</ref>; <ref loc="LUK 3:9">Lucas 3:9</ref></char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Nunee mos ho profeta falsu sira, imi bele konhese sira husi sira nia hahalok.”<note caller="+" style="x"><char style="xo" closed="false">7:20: </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mateus 12:33</ref></char></note><verse eid="MAT 7:20" /></para>
  <para style="s">Se bolu Jesus “Nai”, tenki moris tuir Maromak nia hakarak</para>
  <para style="r">(<ref loc="LUK 13:25-27">Lucas 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Ema barak bolu Hau dehan, ‘Nai, Nai!’ Maibee laos sira hotu-hotu mak sei tama ba Maromak nia reinu. So sira nebee moris tuir Hau nia Aman iha lalehan nia hakarak mak bele tama. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Iha loron ikus bainhira Maromak tesi ema hotu-hotu nia lia, ema barak sei mai dehan, ‘Nai, Nai, ami uluk foo tutan Maromak nia lia menon hodi Nai nia naran. Ami mos temi Ita Boot nia naran hodi duni sai diabu husi ema, i halo milagre oi-oin.’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Maibee Hau sei koalia mo-moos ba sira dehan, ‘Hau nunka konhese imi. Imi ema aat, sai husi nee!’ ”<note caller="+" style="x"><char style="xo" closed="false">7:23: </char><char style="xt" closed="false"><ref loc="PSA 6:9">Salmu 6:9</ref></char></note><verse eid="MAT 7:23" /></para>
  <para style="s">Ema matenek ho ema beik harii uma</para>
  <para style="r">(<ref loc="LUK 6:47-49">Lucas 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Ema nebee rona Hau nia liafuan nee i halo tuir, nia hanesan ema matenek ida nebee harii nia uma iha fatuk leten. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Depois udan boot mai, mota tuun, anin boot mos baku makaas uma nee. Maibee uma nee la monu, tanba harii metin iha fatuk leten.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />Ema nebee rona Hau nia liafuan maibee la halo tuir, nia hanesan ema beik ida nebee harii nia uma iha rai henek leten. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Depois udan boot mai, mota tuun, anin boot mos baku makaas uma nee. I uma nee naksobu tiha too rai.”<verse eid="MAT 7:27" /></para>
  <para style="s">Nai Jesus hanorin ho kbiit</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Bainhira Jesus hanorin tiha hotu, ema barak nebee rona nee admira, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />tanba Nia hanorin ho kbiit, la hanesan ho mestri relijiaun sira nia hanorin.<note caller="+" style="x"><char style="xo" closed="false">7:29: </char><char style="xt" closed="false"><ref loc="MRK 1:22">Marcos 1:22</ref>; <ref loc="LUK 4:32">Lucas 4:32</ref></char></note><verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Nai Jesus kura ema lepra ida</para>
  <para style="r">(<ref loc="MRK 1:40-45">Marcos 1:40-45</ref>; <ref loc="LUK 5:12-16">Lucas 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Jesus lao tuun mai husi foho, ema lubun boot nee mos lao tuir Nia. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Derepenti ema ida moras lepra mai hakneak iha Jesus nia oin hodi husu tulun dehan, “Nai, Ita Boot iha kbiit atu kura hau nia moras hodi halo hau nia isin sai moos fali, naran katak Ita Boot hakarak.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Jesus lolo liman ba tau iha nia isin hodi dehan, “Hau hakarak. O diak ona ba!” I ema nee nia isin moos kedas. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Depois Jesus dehan ba nia, “La bele konta sai buat nee ba ema seluk. Maibee baa aprezenta aan iha nai lulik, atu nia haree katak o nia isin moos ona. Depois foo oferta tuir lei Moisés nian, para ema hotu bele hatene katak o diak ona.”<note caller="+" style="x"><char style="xo" closed="false">8:4: </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Levítiku 14:1-32</ref></char></note><verse eid="MAT 8:4" /></para>
  <para style="s">Nai Jesus kura komandante Roma ida nia atan</para>
  <para style="r">(<ref loc="LUK 7:1-10">Lucas 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Depois Jesus tama ba iha sidade Kafarnaum. Iha nebaa komandante Roma ida mai hasoru Jesus hodi husu tulun <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />dehan, “Nai, Hau nia atan mane ida moras todan iha uma. Nia la bele book aan hodi hadeer husi toba fatin, nia terus atu mate.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Jesus hataan, “Hau sei baa kura nia.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Maibee komandante nee hataan fali dehan, “Nai, hau la serve atu simu Ita Boot iha hau nia uma. Nai foo deit orden ba moras nee mak moras nee sai husi hau nia atan. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Hau hatene nunee tanba hau nia komandante sira mos iha kbiit atu foo orden mai hau. Nunee mos, hau iha kbiit atu foo orden ba hau nia soldadu sira. Se hau manda hau nia soldadu ida dehan, ‘Baa nebaa!’, nia mos baa. Se hau hatete, ‘Mai iha nee!’, nia mai. Se hau haruka hau nia atan dehan, ‘Halo ida nee!’, nia halo duni.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Rona nunee, Jesus admira, i Nia hatete ba ema sira nebee tuir Nia, “Hau dehan lo-loos ba imi, Hau seidauk haree ema Israel ida nebee fiar makaas hanesan ema Roma nee. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Rona mai. Ema barak sei mai husi fat-fatin, husi lorosae-loromonu, sira sei mai tuur haan hamutuk ho Ita nia bei-ala Abraão, Isac ho Jacó iha Maromak nia festa boot iha lalehan.<note caller="+" style="x"><char style="xo" closed="false">8:11: </char><char style="xt" closed="false"><ref loc="LUK 13:29">Lucas 13:29</ref></char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Hori uluk Maromak hili ema Israel atu sai Nia reinu hodi tama iha nebaa. Maibee barak mak Nia sei soe sai ba iha fatin nakukun. Iha nebaa sira sei tanis hakilar i ruun nehan.” <note caller="+" style="x"><char style="xo" closed="false">8:12: </char><char style="xt" closed="false"><ref loc="MAT 22:13">Mateus 22:13</ref>, <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Lucas 13:28</ref></char></note><verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Depois Jesus dehan ba komandante nee, “Bele baa ona. Buat nebee ita fiar nee sei akontese duni.” Iha oras nee kedas komandante nia atan hetan fali isin diak.<verse eid="MAT 8:13" /></para>
  <para style="s">Nai Jesus kura Pedro nia banin feto ho ema barak tan</para>
  <para style="r">(<ref loc="MRK 1:29-34">Marcos 1:29-34</ref>; <ref loc="LUK 4:38-41">Lucas 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Loron ida, Jesus baa iha Pedro nia uma. Nia tama baa haree Pedro nia banin feto toba hela, tanba nia isin manas. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Jesus kaer nia liman, derepenti nia isin manas lakon tiha, i nia hadeer kedas baa prepara hahaan foo ba Jesus.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Bainhira kalan ona, ema barak mai lori sira nia maluk nebee mak diabu tama iha laran. Depois Jesus foo orden deit, diabu sira nee sai kedas. Nia mos kura ema moras hotu-hotu. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Nunee Nia halo tuir saida mak Maromak nia profeta Isaias hakerek nanis ona dehan,</para>
  <para style="q1" vid="MAT 8:17">“Nia rasik hasai ita nia moras.</para>
  <para style="q2" vid="MAT 8:17">Ita nia moras aat, Nia mak lori.”<note caller="+" style="x"><char style="xo" closed="false">8:17: </char><char style="xt" closed="false"><ref loc="ISA 53:4">Isaias 53:4</ref></char></note><verse eid="MAT 8:17" /></para>
  <para style="s">Tuir Nai Jesus laos fasil</para>
  <para style="r">(<ref loc="LUK 9:57-62">Lucas 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Iha loron ida, Jesus haree ema barak mai haleu Nia. Entaun Nia haruka Nia eskolante sira prepara roo para baa iha tasi sorin. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Jesus seidauk sae roo, mestri relijiaun ida mai dehan ba Nia, “Mestri, Ita Boot baa nebee deit, hau prontu atu tuir.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Jesus hataan, “Asu fuik iha nia fatin hodi hela. Manu fuik mos iha nia knuuk. Maibee Hau, Ema Umanu nia Oan la iha fatin ida hodi tau Hau nia ulun ba.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Iha tan ema ida nebee baibain tuir Jesus dehan ba Nia, “Nai, husik hau fila baa hakoi hau nia aman lai mak foin hau tuir Ita Boot.”<note caller="+" style="f"><char style="fr" closed="false">8:21: </char><char style="ft" closed="false">Tuir ema matenek balu, ema nee nia aman sei moris hela, sei forti hela.</char></note><verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Maibee Jesus hataan, “Mai tuir Hau! Ema nebee lakohi rona Maromak, sira hanesan ema nebee mate tiha ona. Husik sira mak hakoi malu.”<verse eid="MAT 8:22" /></para>
  <para style="s">Nai Jesus halo hakmatek anin boot</para>
  <para style="r">(<ref loc="MRK 4:35-41">Marcos 4:35-41</ref>; <ref loc="LUK 8:22-25">Lucas 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Hotu tiha Jesus sae roo, i Nia eskolante sira mos tuir Nia. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Iha tasi klaran derepenti anin boot mai, too laloran boot halo tasi been tama iha roo laran. Maibee Jesus dukur hela. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Nia eskolante sira fanu Nia dehan, “Nai, salva lai ami, ita atu mout ona!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Jesus hataan, “Imi nee fiar fraku. Nusaa mak imi tauk hanesan nee?” Depois Nia hadeer hodi siak anin ho laloran boot nee. Anin para kedas, tasi mos hakmatek liu.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Nia eskolante sira admira dehan, “Ema nee see loos mak too anin ho laloran mos rona Nia?”<verse eid="MAT 8:27" /></para>
  <para style="s">Nai Jesus duni sai diabu husi ema nain rua</para>
  <para style="r">(<ref loc="MRK 5:1-20">Marcos 5:1-20</ref>; <ref loc="LUK 8:26-39">Lucas 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Depois Jesus too iha tasi sorin, iha ema Gadara<note caller="+" style="f"><char style="fr" closed="false">8:28: </char><char style="ft" closed="false">Kopia evanjelhu Mateus husi tempu antigu barak. Balu hakerek “Gadara”, balu hakerek “Gergesa”, i balu tan hakerek “Gerasa”.</char></note> sira nia rain. Iha nebaa iha mane nain rua diabu tama iha sira nia laran. Sira nee siak loos, too la iha ema ida mak brani atu lao liu husi nebaa. Sira sai mai husi fatuk kuak nebee ema halo ba rate, i hasoru Jesus. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Sira hakilar dehan, “Maromak nia Oan, O hakarak halo saida mai ami? Tempu seidauk too mos, O atu kastigu ami ka?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Iha momentu nebaa iha fahi barak teb-tebes haan hela iha foho lolon, laduun dook husi fatin nee. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Diabu sira husu fila-fila ba Jesus, “Se O atu duni sai ami karik, entaun haruka ami tama ba iha fahi sira nebaa.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Jesus haruka sira dehan, “Baa ona!” Entaun diabu sira sai tiha husi ema nain rua nee hodi tama fali iha fahi. Derepenti fahi sira nee halai saruntu malu tuun husi foho nee, monu hotu ba tasi laran, i mout too mate hotu.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Haree nunee, fahi atan sira halai ba vila laran hodi konta sai kona ba ema nain rua nebee uluk diabu domina nee, ho mos istoria nee tomak. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Depois ema hotu sai mai husi vila hasoru Jesus, i sira husu fila-fila atu Nia sai ona husi rai nee.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Nai Jesus kura ema ida liman-ain mate</para>
  <para style="r">(<ref loc="MRK 2:1-12">Marcos 2:1-12</ref>; <ref loc="LUK 5:17-26">Lucas 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Hotu tiha Jesus sae fali roo fila ba iha tasi sorin hodi baa iha Nia sidade. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Iha nebaa ema balu mai hulan mane ida liman-ain mate, latan hela iha nia toba fatin. Sira lori nia ba Jesus. Bainhira Jesus haree sira nia fiar, Nia dehan ba ema isin mate nee, “Oan, laran metin ba! O nia sala hamoos tiha ona.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Mestri relijiaun sira rona liafuan nee, sira murmura dehan, “Ema nee foti Aan hanesan fali Maromak!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Maibee Jesus hatene hela sira nia hanoin, entaun Nia dehan, “Nusaa mak imi hanoin aat nunee? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Se Hau dehan ba ema nee katak, nia sala hamoos tiha ona, imi seidauk hatene, sai duni nunee ka lae. Maibee se Hau haruka nia hamriik ona hodi lao, imi bele haree ho matan. <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Agora Hau sei hatudu mo-moos ba imi katak, iha mundu nee Hau, Ema Umanu nia Oan iha kbiit hodi hamoos ema nia sala.” Depois Jesus hatete ba ema liman-ain mate nee, “Hamriik ona! Foti o nia toba fatin hodi fila ba uma.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Ema nee mos hamriik kedas hodi lao ba uma.<verse eid="MAT 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 9:8" />Ema barak haree buat nebee Jesus halo nee. Sira hakfodak ho tauk, i sira hahii Maromak tanba Nia foo tiha ona kbiit hanesan nee ba ema.<verse eid="MAT 9:8" /></para>
  <para style="s">Nai Jesus bolu Mateus para tuir Nia</para>
  <para style="r">(<ref loc="MRK 2:13-17">Marcos 2:13-17</ref>; <ref loc="LUK 5:27-32">Lucas 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Depois Jesus husik tiha fatin nee. Nia lao dadauk, Nia hetan ema kobrador impostu ida naran Mateus, tuur hela iha nia servisu fatin. Jesus dehan ba nia, “Mai tuir Hau!” Mateus mos hamriik hodi tuir Jesus.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Depois Jesus ho Nia eskolante sira baa haan iha Mateus nia uma, i kobrador impostu barak ho ema aat sira seluk mai haan hamutuk ho sira.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />Ema husi grupu Farizeu sira haree, i sira husu ba Jesus nia eskolante sira, “Nusaa mak imi nia mestri haan hamutuk fali ho kobrador impostu ho ema aat sira nee?”<note caller="+" style="x"><char style="xo" closed="false">9:11: </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">Lucas 15:1-2</ref></char></note><verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Maibee bainhira Jesus rona sira nia liafuan nee, Nia dehan, “So ema moras mak presiza doutor, ema isin diak lae. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Baa aprende di-diak Maromak nia liafuan nebee dehan, ‘Hau hakarak atu imi hatudu laran luak ba malu. Se lae, imi lori sakrifisiu foo mai Hau mos la iha folin.’ Hau mai atu bolu ema aat sira, laos atu bolu ema nebee konsidera nia aan moris loos ona.”<note caller="+" style="x"><char style="xo" closed="false">9:13: </char><char style="xt" closed="false"><ref loc="MAT 12:7">Mateus 12:7</ref>; <ref loc="HOS 6:6">Oseias 6:6</ref></char></note><verse eid="MAT 9:13" /></para>
  <para style="s">Tansaa mak Nai Jesus nia eskolante sira la jejun</para>
  <para style="r">(<ref loc="MRK 2:18-22">Marcos 2:18-22</ref>; <ref loc="LUK 5:33-39">Lucas 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Depois João Sarani Nain nia eskolante sira mai husu Jesus nunee: “Ami nebee tuir João Sarani Nain baibain halo jejun. Ema Farizeu sira nia eskolante sira mos hanesan. Maibee tansaa mak Ita Boot nia eskolante sira la jejun?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Jesus hataan ho komparasaun dehan, “Hau hanesan noivu ida nebee selebra nia festa kazamentu. Bainhira noivu sei hamutuk ho nia bainaka sira, sira la bele tristi. Maibee too iha loron ida, ema sei lori lakon tiha noivu nee. Iha loron nee mak nia bainaka sira sei jejun.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />La iha ema ida uza hena foun hodi taka fali ba hena bosan nebee kuak. Se lae, hena foun dada hamutuk sai kiik tiha too estraga fali hena bosan nee halo naklees liu tan.<verse eid="MAT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 9:17" />Nunee mos ema halo tua, la tau iha tua fatin nebee halo husi animal nia kulit nebee tuan ona. Tanba tua foun sempre nafurin sae hodi halo kulit tuan nee nakfera tanba toos tiha ona. Nunee tua mos fakar sai. Tua foun, tenki tau iha tua fatin foun. Nunee tua fatin bele dura i tua mos la fakar sai.”<note caller="+" style="f"><char style="fr" closed="false">9:16-17: </char><char style="ft" closed="false">Nunee Jesus hanorin dehan, la bele kahur Nia hanorin nebee foun ho ema Farizeu sira nia hanorin nebee tuan.</char></note><verse eid="MAT 9:17" /></para>
  <para style="s">Nai Jesus halo moris menina ida, i kura feto ida tan</para>
  <para style="r">(<ref loc="MRK 5:21-43">Marcos 5:21-43</ref>; <ref loc="LUK 8:40-56">Lucas 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Jesus sei koalia hela ho João Sarani Nain nia eskolante sira, responsavel uma kreda ida mai hakneak iha Jesus nia oin hodi husu tulun dehan, “Hau nia oan feto foin mate. Hau husu atu Ita Boot baa tau liman ba nia hodi halo nia moris fali.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Entaun Jesus hamriik lao tuir responsavel nee, i Nia eskolante sira mos baa hamutuk ho Nia.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="MAT 9:20-21" />Iha dalan klaran, iha feto ida, nia fulan mai la para durante tinan sanulu resin rua. Feto nee hanoin nunee: “Naran katak hau kona kois deit Nia hena mos, hau nia moras sei diak.” Entaun nia bes-besik ba iha Jesus nia kotuk hodi kona Jesus nia hena rohan.<verse eid="MAT 9:20-21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Jesus fila ba kotuk i haree feto nee hodi dehan, “Oan, laran metin ba! O hetan kura tanba o fiar mai Hau.” I nia moras diak kedas.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Bainhira Jesus too iha responsavel nia uma, Nia haree ema toka muzika mate nian i ema barak tanis halerik. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Jesus dehan ba sira, “Imi hotu sai. Menina nee la mate ida, nia toba deit.” Maibee sira hamnasa fali Nia.<verse eid="MAT 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25" />Bainhira ema sira nee sai hotu, Jesus tama ba laran hodi kaer menina nee nia liman, i menina nee hadeer fali. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Buat nebee Jesus halo nee, ema konta lemo-lemo, too ema iha rejiaun nee tomak hatene.<verse eid="MAT 9:26" /></para>
  <para style="s">Nai Jesus kura ema matan delek nain rua</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Depois Jesus sai husi fatin nee. Nia lao dadauk, iha ema matan delek nain rua lao tu-tuir Nia hodi bolu ho lian makaas dehan, “Liurai David nia Jerasaun, hanoin ami ba!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Jesus tama iha uma laran, ema matan delek nain rua nee mos tama tuir Nia. Jesus husu ba sira dehan, “Imi fiar katak Hau bele kura imi nia matan ka?”</para>
  <para style="p" vid="MAT 9:28">Sira hataan, “Ami fiar, Nai.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Depois Jesus tau liman ba sira nia matan hodi dehan, “Tanba imi nia fiar mak imi hetan kura.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Sira nain rua nia matan haree moos kedas. Jesus bandu makaas sira dehan, “La bele foo hatene buat nee ba see-see deit.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Maibee sira sai baa konta lemo-lemo kona ba Jesus iha rejiaun nee tomak.<verse eid="MAT 9:31" /></para>
  <para style="s">Nai Jesus kura ema ida nebee koalia la diak</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Bainhira sira nain rua nee sai dadauk, ema lori tan sira nia maluk ida ba Jesus. Ema nee diabu domina ona too nia koalia la diak. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Jesus duni sai tiha diabu, ema nee bele koalia kedas. Ema barak nebee haree buat nee, sira hotu admira dehan, “Buat ida hanesan nee foin mak akontese iha rai Israel.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Maibee ema Farizeu sira dehan, “Nia duni sai diabu tanba diabu nia xefi mak foo kbiit ba Nia.”<note caller="+" style="x"><char style="xo" closed="false">9:34: </char><char style="xt" closed="false"><ref loc="MAT 10:25">Mateus 10:25</ref>, <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Marcos 3:22</ref>; <ref loc="LUK 11:15">Lucas 11:15</ref></char></note><verse eid="MAT 9:34" /></para>
  <para style="s">Presiza tan ema atu halao Nai Maromak nia servisu</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Jesus lao husi sidade ba sidade ho aldeia ba aldeia hodi hanorin iha uma kreda laran. Nia foo sai Liafuan Diak kona ba oinsaa Maromak ukun nudar Liurai. I ema nebee moras oi-oin Nia kura tiha hotu.<note caller="+" style="x"><char style="xo" closed="false">9:35: </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mateus 4:23</ref>; <ref loc="MRK 1:39">Marcos 1:39</ref>; <ref loc="LUK 4:44">Lucas 4:44</ref></char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Bainhira Jesus haree ema barak nee, Nia hanoin loos sira, tanba sira la hatene atu halo oinsaa, i la iha ema ida atu tulun sira. Sira hanesan bibi malae nebee la iha bibi atan atu hatudu dalan ba sira.<note caller="+" style="x"><char style="xo" closed="false">9:36: </char><char style="xt" closed="false"><ref loc="NUM 27:17">Númerus 27:17</ref>; <ref loc="1KI 22:17">1 Liurai 22:17</ref>; <ref loc="2CH 18:16">2 Krónikas 18:16</ref>; <ref loc="EZK 34:5">Ezequiel 34:5</ref>; <ref loc="ZEC 10:2">Zacarias 10:2</ref>; <ref loc="MRK 6:34">Marcos 6:34</ref></char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Depois Jesus soe lia ba Nia eskolante sira dehan, “Batar iha toos laran maran tiha ona. Batar nee barak teb-tebes, maibee ema atu silu, uitoan deit. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Tanba nee, harohan ba Toos Nain atu haruka tan ema hodi silu batar nee.”<note caller="+" style="f"><char style="fr" closed="false">9:38: </char><char style="ft" closed="false">Batar maran mak ema nebee prontu atu rona Maromak nia liafuan. Toos Nain mak Maromak. Ema nebee silu batar mak ema nebee haklaken Maromak nia liafuan.</char></note> <note caller="+" style="x"><char style="xo" closed="false">9:37-38: </char><char style="xt" closed="false"><ref loc="LUK 10:2">Lucas 10:2</ref></char></note><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Nai Jesus hili Nia apostolu sanulu resin rua</para>
  <para style="r">(<ref loc="MRK 3:13-19">Marcos 3:13-19</ref>; <ref loc="LUK 6:12-16">Lucas 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Iha loron ida Jesus halibur Nia eskolante nain sanulu resin rua. Nia foti sira sai Nia apostolu hodi foo kbiit ba sira atu duni sai diabu husi ema i kura ema nia moras oi-oin. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Sira nain sanulu resin rua nia naran mak hanesan tuir mai nee:</para>
  <para style="q2" vid="MAT 10:2">Primeiru, Simão (ema mos bolu nia Pedro), ho nia alin André,</para>
  <para style="q2" vid="MAT 10:2">Tiago ho nia alin João (sira nain rua Zebedeu nia oan),<verse eid="MAT 10:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="MAT 10:3" />Filipe ho Bartolomeu,</para>
  <para style="q2" vid="MAT 10:3">Tomé ho Mateus (nia kobrador impostu),</para>
  <para style="q2" vid="MAT 10:3">Tiago (nia Alfeu nia oan) ho Tadeu,<verse eid="MAT 10:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="MAT 10:4" />Simão (nia ema Patriota),<note caller="+" style="f"><char style="fr" closed="false">10:4: </char><char style="ft" closed="false">Patriota sira luta atu ema Judeu sira bele sai husi estadu Roma nia okos hodi ukun rasik aan. Ema mos bolu sira Zelote.</char></note></para>
  <para style="q2" vid="MAT 10:4">ho Judas Iscariotes (ikus mai nia mak faan Jesus).<verse eid="MAT 10:4" /></para>
  <para style="s">Nai Jesus foo knaar ba Nia apostolu sira</para>
  <para style="r">(<ref loc="MRK 6:7-13">Marcos 6:7-13</ref>; <ref loc="LUK 9:1-6">Lucas 9:1-6</ref>, <ref loc="LUK 10:4-12">10:4-12</ref>)</para>
  <para style="p">
    <verse number="5-6" style="v" sid="MAT 10:5-6" />Jesus foo knaar ba apostolu nain sanulu resin rua hanesan nee: “Imi baa ona. Imi tenki baa iha ema Israel sira deit, tanba sira hanesan bibi malae nebee lao sala dalan ona. La bele baa tama iha ema jentiu sira nia leet. Ema Samaria nia aldeia sira mos la bele tama. <verse eid="MAT 10:5-6" /><verse number="7" style="v" sid="MAT 10:7" />Baa foo hatene ema Israel sira dehan, ‘Tempu besik ona atu Maromak ukun imi.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Baa kura ema moras, halo moris fali ema mate, foo isin diak ba ema nebee moras lepra, i duni sai diabu husi ema nia laran. Imi simu kbiit nee ho gratis, tenki foo mos ho gratis. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />La bele lori osan mean ka osan mutin, atu doit ida mos la bele. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Lalika lori pasta, lalika lori hena tahan rua ka sandalias atu troka iha dalan, i lalika lori imi nia ai tonka. Tanba ema nebee servisu, nia iha direitu atu ema foo buat nebee mak nia presiza.<note caller="+" style="x"><char style="xo" closed="false">10:10: </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 Korintu 9:14</ref>; <ref loc="1TI 5:18">1 Timóteo 5:18</ref></char></note><verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Bainhira imi tama iha sidade ida ka aldeia ida, baa buka uluk ema ida nebee laran diak, i hela iha nia uma too imi sai fali husi fatin nee. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Bainhira imi tama iha uma laran, harohan ba Maromak atu foo bensaun ba uma kain nee. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Se uma nain simu imi ho diak, sira sei hetan duni bensaun nee. Se lae, dada fila fali imi nia liafuan bensaun nee. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Se imi baa too iha uma ida ka aldeia ida mak ema la simu imi ka lakohi rona imi nia liafuan, husik tiha fatin nee. I hisik rai rahun husi imi nia ain okos nudar sinal katak sira rasik mak sei lori todan.<note caller="+" style="x"><char style="xo" closed="false">10:14: </char><char style="xt" closed="false"><ref loc="ACT 13:51">Apostolu sira nia Istoria 13:51</ref></char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Hau hatete lo-loos ba imi, iha loron ikus bainhira Maromak tesi ema hotu-hotu nia lia, ema iha aldeia nee sei simu kastigu todan liu fali ema aat sira nebee uluk hela iha rai Sodoma ho Gomora.”<note caller="+" style="x"><char style="xo" closed="false">10:15: </char><char style="xt" closed="false"><ref loc="MAT 11:24">Mateus 11:24</ref>; <ref loc="GEN 19:24-28">Jénesis 19:24-28</ref></char></note><verse eid="MAT 10:15" /></para>
  <para style="s">Nai Jesus nia eskolante sira sei terus</para>
  <para style="r">(<ref loc="MRK 13:9-13">Marcos 13:9-13</ref>; <ref loc="LUK 21:12-17">Lucas 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Jesus hatutan tan dehan, “Rona di-diak, Hau haruka imi baa hanesan bibi malae nebee tama iha asu fuik nia leet. Imi tenki matenek hanesan samea. I imi nia laran tenki moos hanesan manu pombu.<note caller="+" style="x"><char style="xo" closed="false">10:16: </char><char style="xt" closed="false"><ref loc="LUK 10:3">Lucas 10:3</ref></char></note> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Kuidadu, tanba ema sei mai kaer imi hodi lori imi ba iha tribunal. Sira sei baku imi ho sikoti iha sira nia uma kreda laran. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Sira mos sei foo sala ba imi iha nai ulun ho liurai sira nia oin. Buat sira nee hotu sai nunee tanba imi tuir Hau. Ho nunee imi sei foo sasin kona ba Hau iha sira nia oin ho mos iha ema nebee laos Judeu nia oin. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Bainhira ema lori imi baa hataan iha tribunal, lalika preokupa atu koalia saida ka atu hataan oinsaa. Tanba iha oras nee duni Maromak sei foo hatene ba imi liafuan nebee mak imi atu koalia sai. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Iha tempu nee, laos imi mak koalia, maibee imi nia Aman nia Espiritu mak koalia liu husi imi.<note caller="+" style="x"><char style="xo" closed="false">10:20: </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">Marcos 13:9-11</ref>; <ref loc="LUK 12:11-12">Lucas 12:11-12</ref>, <ref loc="LUK 21:12-15">21:12-15</ref></char></note><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Iha uma laran ida, se iha ema ida mak fiar mai Hau, nia maun-alin rasik mak sei entrega nia ba nai ulun sira para oho. Se oan ida fiar mai Hau, nia aman rasik mak entrega nia ba ema seluk para oho. Se inan-aman mak fiar, sira nia oan rasik mak hamriik hasoru sira hodi foo ba ema oho.<note caller="+" style="x"><char style="xo" closed="false">10:21: </char><char style="xt" closed="false"><ref loc="MRK 13:12">Marcos 13:12</ref>; <ref loc="LUK 21:16">Lucas 21:16</ref></char></note> <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ema iha nebee-nebee deit sei odi imi tanba imi tuir Hau. Maibee ema nebee mak aguenta nafatin too rohan, Maromak sei salva sira.<note caller="+" style="x"><char style="xo" closed="false">10:22: </char><char style="xt" closed="false"><ref loc="MAT 24:9">Mateus 24:9</ref>, <ref loc="MAT 13">13</ref>; <ref loc="MRK 13:13">Marcos 13:13</ref>; <ref loc="LUK 21:17">Lucas 21:17</ref></char></note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Bainhira ema halo terus imi iha sidade ida tanba imi fiar mai Hau, halai ba sidade seluk. Hau hatete lo-loos ba imi, imi seidauk haleu sidade hotu iha Israel laran, Hau, Ema Umanu nia Oan mai fali ona.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Estudante ida la bele boot liu nia mestri, i atan ida la bele boot liu fali nia patraun.<note caller="+" style="x"><char style="xo" closed="false">10:24: </char><char style="xt" closed="false"><ref loc="LUK 6:40">Lucas 6:40</ref>; <ref loc="JHN 13:16">João 13:16</ref>, <ref loc="JHN 15:20">15:20</ref></char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Se estudante ida sai hanesan nia mestri, nee too ona. I atan ida sai hanesan nia patraun, nee mos too ona. Hau hanesan imi nia xefi familia, maibee ema hatete aat Hau dehan, Hau diabu nia xefi Belzebu. Entaun imi nebee tama iha Hau nia familia mos, ema sei hatete imi aat loos.”<note caller="+" style="x"><char style="xo" closed="false">10:25: </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mateus 9:34</ref>, <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Marcos 3:22</ref>; <ref loc="LUK 11:15">Lucas 11:15</ref></char></note><verse eid="MAT 10:25" /></para>
  <para style="s">Tauk mak Nai Maromak deit</para>
  <para style="r">(<ref loc="LUK 12:2-7">Lucas 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Nunee lalika tauk ema sira nee. Tanba buat hotu-hotu nebee agora taka hela, loron ida sei nakloke. I buat hotu-hotu nebee agora subar hela, aban-bainrua ema sei hatene.<note caller="+" style="x"><char style="xo" closed="false">10:26: </char><char style="xt" closed="false"><ref loc="MRK 4:22">Marcos 4:22</ref>; <ref loc="LUK 8:17">Lucas 8:17</ref></char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Buat nebee mak Hau foo hatene ba imi iha kotu-kotuk, imi tenki hatete sai. I saida mak Hau hanorin bis-bisu deit ba imi, imi tenki foo sai ho lian makaas iha ema barak nia oin. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />La bele tauk ema nebee mak hakarak oho imi, tanba sira so bele oho deit imi nia isin, imi nia klamar sira la bele oho. Diak liu imi tauk mak Maromak, tanba Nia iha kbiit atu oho imi nia isin hodi soe imi nia klamar iha infernu laran. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Hanoin took manu liin. Manu liin rua, ema faan sentavus ida deit. Maski baratu liu, maibee la iha ida mak monu ba rai, se imi nia Aman iha lalehan la foo lisensa. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Laos nee deit, maibee Maromak mos hatene lo-loos imi nia fuuk lahan hira mak iha imi nia ulun. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Nee duni lalika tauk, tanba imi folin boot liu manu liin barak.”<verse eid="MAT 10:31" /></para>
  <para style="s">Keta moe foo sai katak ita tuir Nai Jesus</para>
  <para style="r">(<ref loc="LUK 12:8-9">Lucas 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“See mak foo sai iha ema nia oin katak nia fiar mai Hau, aban-bainrua Hau mos sei foo sai iha Hau nia Aman iha lalehan nia oin katak, nia Hau nia ema. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Maibee see mak foo sai iha ema nia oin katak nia la konhese Hau, aban-bainrua Hau mos sei foo sai iha Hau nia Aman iha lalehan nia oin katak, nia laos Hau nia ema.”<note caller="+" style="x"><char style="xo" closed="false">10:33: </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 Timóteo 2:12</ref></char></note><verse eid="MAT 10:33" /></para>
  <para style="s">Nai Jesus mai, halo ema fahe malu</para>
  <para style="r">(<ref loc="LUK 12:51-53">Lucas 12:51-53</ref>, <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“Keta hanoin dehan Hau mai iha mundu nee atu lori dame. Hau mai laos atu lori dame, maibee atu lori konflitu. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Hau mai para halo ‘oan mane kontra nia aman, oan feto kontra nia inan, feto foun kontra nia banin feto. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Ema nia inimigu mai husi nia uma laran rasik.’<note caller="+" style="x"><char style="xo" closed="false">10:36: </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mikeias 7:6</ref></char></note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />See mak hadomi liu nia inan-aman duke nia hadomi Hau, nia la serve atu sai Hau nia ema. Nunee mos ema nebee mak hadomi nia oan mane ka oan feto liu fali Hau, nia la serve sai Hau nian. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />See mak hakarak sai Hau nia ema, nia tenki tuir Hau, i nia tenki prontu atu simu terus, hanesan ema nebee lori nia krus too mate. Se lae, nia la serve sai Hau nia ema.<note caller="+" style="x"><char style="xo" closed="false">10:38: </char><char style="xt" closed="false"><ref loc="MAT 16:24">Mateus 16:24</ref>; <ref loc="MRK 8:34">Marcos 8:34</ref>; <ref loc="LUK 9:23">Lucas 9:23</ref></char></note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ema nebee hanoin liu nia moris iha mundu nee, sei lakon fali nia moris. Maibee see mak lakon nia moris iha mundu nee tanba nia tuir Hau, nia sei hetan moris rohan-laek.”<note caller="+" style="x"><char style="xo" closed="false">10:39: </char><char style="xt" closed="false"><ref loc="MAT 16:25">Mateus 16:25</ref>; <ref loc="MRK 8:35">Marcos 8:35</ref>; <ref loc="LUK 9:24">Lucas 9:24</ref>, <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">João 12:25</ref></char></note><verse eid="MAT 10:39" /></para>
  <para style="s">Nai Maromak sei selu buat nebee mak ita halo</para>
  <para style="r">(<ref loc="MRK 9:41">Marcos 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“See mak simu imi, nia simu ona Hau. See mak simu Hau, nia simu ona Ida nebee mak haruka Hau mai.<note caller="+" style="x"><char style="xo" closed="false">10:40: </char><char style="xt" closed="false"><ref loc="MRK 9:37">Marcos 9:37</ref>; <ref loc="LUK 9:48">Lucas 9:48</ref>, <ref loc="LUK 10:16">10:16</ref>; <ref loc="JHN 13:20">João 13:20</ref></char></note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />See mak simu profeta ida tanba profeta nee foo tutan Maromak nia lia menon, iha loron ikus bainhira Maromak selu profeta sira nia kolen, ema nee mos simu hanesan. I see mak simu ema ida nebee moris loos tanba nia moris nee loos, iha loron ikus bainhira Maromak selu ema moris loos sira nia kolen, ema nee mos simu hanesan. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Hau dehan lo-loos ba imi, see mak foo tulun ba ema kiik ida tanba ema nee tuir Hau, maski nia foo bee kopu ida deit mos, Maromak la haluha nia kolen.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">João Sarani Nain haruka nia eskolante baa hasoru Nai Jesus</para>
  <para style="r">(<ref loc="LUK 7:18-35">Lucas 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Bainhira Jesus hanorin tiha buat sira nee hotu ba Nia eskolante nain sanulu resin rua, Nia husik tiha fatin nee. Depois Nia lao husi aldeia ba aldeia iha rejiaun nee hodi hanorin ema i foo sai Maromak nia liafuan.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Iha tempu nebaa João Sarani Nain dadur tiha ona iha kadeia. Nia rona buat nebee Mesias halo. Nunee nia haruka nia eskolante balu baa hasoru Jesus hodi husu, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“Ita Boot mak Ema ida nebee Maromak promete atu haruka mai ka, ami tenki hein fali ema seluk?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Jesus hataan dehan, “Imi fila baa konta ba João kona ba buat hotu-hotu nebee imi ohin rona ho saida mak imi haree. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Ema matan delek bele haree. Ema ain aat bele lao. Ema moras lepra, isin sai moos. Ema tilun diuk bele rona. Ema mate moris fila fali. I ema kiak rona Liafuan Diak.<note caller="+" style="f"><char style="fr" closed="false">11:5: </char><char style="ft" closed="false">Iha tempu nebaa ema matan delek, ain aat, moras lepra ka tilun diuk, la bele hetan kura. Uluk kedas Maromak nia profeta Isaias foo hatene katak, aban-bainrua Maromak sei haruka Mesias mai para kura moras sira nee i foo sai Liafuan Diak ba ema kiak sira (Isaias 35:5-6, 61:1). Nai Jesus temi Isaias nia liafuan nee hodi hatudu ba João Sarani Nain katak, Jesus mak Mesias, Ida nebee Maromak promete atu haruka mai nee.</char></note> <note caller="+" style="x"><char style="xo" closed="false">11:5: </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Isaias 35:5-6</ref>, <ref loc="ISA 61:1">61:1</ref></char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Hatete mos ba João dehan, ‘Ema nebee fiar nafatin mai Hau too rohan, nia hetan bensaun.’ ”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Bainhira João nia eskolante sira fila dadauk, Jesus komesa koalia kona ba João. Nia husu ema barak nebee haleu Nia nunee: “Uluk imi baa iha rai fuik maran atu haree see loos? Imi baa atu haree ema nebee nakdoko ba-mai tuir anin hanesan fali duut manulain ka? Lae! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Entaun imi baa atu haree see? Imi baa atu haree ema nebee hatais hena folin karun ka? Lae! Ema nebee hatais hena folin karun hela iha uma liurai nian. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Entaun imi baa atu haree see? Imi hanoin atu haree Maromak nia profeta ka? Loos duni! Maibee Hau hatete ba imi, João nee boot liu fali profeta. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Nia nee uluk kedas Livru Sagradu temi tiha ona dehan,</para>
  <para style="q1" vid="MAT 11:10">‘Rona mai! Hau haruka Hau nia ema ida baa uluk</para>
  <para style="q2" vid="MAT 11:10">hodi prepara dalan ba O.’<note caller="+" style="x"><char style="xo" closed="false">11:10: </char><char style="xt" closed="false"><ref loc="MAL 3:1">Malakias 3:1</ref></char></note><verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Hau hatete lo-loos ba imi, hori uluk kedas, la iha ema ida iha mundu nee mak hetan bensaun boot liu João Sarani Nain. Maski nunee komesa agora ba oin, see mak hakruuk ba Maromak nudar Liurai, bele ema nee kiik mos, nia sei hetan bensaun boot liu fali João.<note caller="+" style="f"><char style="fr" closed="false">11:11: </char><char style="ft" closed="false">Nunee Nai Jesus dehan, se ita tuir Nia, nee bensaun boot liu fali bensaun nebee mak João Sarani Nain hetan. João foo hatene antes kona ba Jesus nia servisu, depois ema dadur nia iha komarka, i too ikus oho nia. Nunee João rasik la konsege akompanha Jesus nia servisu, i la haree Nia mate ho moris fali.</char></note> <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Husi tempu João Sarani Nain mai too agora, iha ema uza violensia kontra Maromak nia reinu atu hatuun Maromak nudar Liurai.<note caller="+" style="f"><char style="fr" closed="false">11:12: </char><char style="ft" closed="false">Versikulu nee nia signifikadu laduun klaru. Ema balu kompriende hanesan nee: Husi tempu João Sarani Nain mai too agora, Maromak nia reinu aumenta makaas, i ema hakaas aan atu tama.</char></note> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Molok João mai, profeta sira ho mos Moisés nia lei foo sai antes tiha ona kona ba saida mak akontese agora dadauk.<note caller="+" style="x"><char style="xo" closed="false">11:12-13: </char><char style="xt" closed="false"><ref loc="LUK 16:16">Lucas 16:16</ref></char></note> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Se imi hakarak fiar buat nebee mak loos, entaun imi sei hatene katak João mak profeta Elias nebee durante nee ema hein hela.<note caller="+" style="x"><char style="xo" closed="false">11:14: </char><char style="xt" closed="false"><ref loc="MAL 4:5">Malakias 4:5</ref>; <ref loc="MAT 17:10-13">Mateus 17:10-13</ref>; <ref loc="MRK 9:11-13">Marcos 9:11-13</ref></char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Imi nebee iha tilun, rona di-diak ba!”<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Jesus dehan tan, “Ema agora dadauk nee, Hau atu kompara ho saida? Sira hanesan labarik nebee tuur iha merkadu hodi hakilar ba sira nia kolega halimar dehan,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />‘Ami toka muzika kapaas loos,</para>
  <para style="q2" vid="MAT 11:17">maibee imi la dansa.</para>
  <para style="q1" vid="MAT 11:17">Ami tanis lelir,</para>
  <para style="q2" vid="MAT 11:17">maibee imi la tanis.’<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />Nunee mos João mai, nia sempre jejun i la hemu tua, depois ema dehan, diabu tama iha nia laran. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Maibee Hau, Ema Umanu nia Oan mai, Hau haan ho hemu tua hanesan ema baibain, depois ema dehan, Hau kaan-teen ho lanu-teen, i halo belun ho kobrador impostu sira ho ema aat sira. Maibee ema hotu-hotu nebee moris tuir Maromak nia matenek, sira hatudu katak Maromak nia matenek nee loos duni.”<verse eid="MAT 11:19" /></para>
  <para style="s">Ema nebee lakohi husik sala sei terus</para>
  <para style="r">(<ref loc="LUK 10:13-15">Lucas 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Depois Jesus komesa kritika ema iha aldeia balu, tanba iha aldeia hirak nee mak Nia halo milagre barak liu, maibee ema sira nee lakohi hakribi sira nia sala. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Jesus dehan, “Imi ema Korazim sei terus. Imi ema Betsaida sei terus. Hau halo ona milagre bar-barak iha imi nia leet, maibee imi lakohi hakribi imi nia sala. Ema jentiu sira nebee uluk liu hela iha sidade Tiru ho Sidon nunka haree milagre sira nee. Se sira haree karik, entaun sira tuur hakdasak iha ahu kdesan i hatais hena lutu hodi hatudu katak sira hakribi ona sira nia sala.<note caller="+" style="x"><char style="xo" closed="false">11:21: </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isaias 23:1-18</ref>; <ref loc="EZK 26:1-28:26">Ezequiel 26:1—28:26</ref>; <ref loc="JOL 3:4-8">Joel 3:4-8</ref>; <ref loc="AMO 1:9-10">Amós 1:9-10</ref>; <ref loc="ZEC 9:2-4">Zacarias 9:2-4</ref></char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Maibee Hau hatete ba imi, iha loron ikus bainhira Maromak tesi ema hotu-hotu nia lia, imi sei simu kastigu todan liu fali ema Tiru ho ema Sidon.<verse eid="MAT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23" />Nunee mos imi ema Kafarnaum sira, keta hanoin katak, Maromak sei foti sae imi ba lalehan. Lae! Nia sei soe imi ba infernu. Se karik uluk ema jentiu sira iha sidade Sodoma haree milagre nebee Hau halo iha imi nia rai nee, entaun sira husik sira nia sala, i Maromak la sunu mutuk sidade nee.<note caller="+" style="x"><char style="xo" closed="false">11:23: </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">Isaias 14:13-15</ref>; <ref loc="GEN 19:24-28">Jénesis 19:24-28</ref></char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Hau dehan ba imi, iha loron ikus bainhira Maromak tesi ema nia lia, Maromak sei foo kastigu ba imi todan liu fali ema Sodoma sira nian.”<note caller="+" style="x"><char style="xo" closed="false">11:24: </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mateus 10:15</ref>; <ref loc="LUK 10:12">Lucas 10:12</ref></char></note><verse eid="MAT 11:24" /></para>
  <para style="s">Liu husi Nai Jesus deit mak ita bele konhese Aman Maromak</para>
  <para style="r">(<ref loc="LUK 10:21-22">Lucas 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Iha tempu nee, Jesus hahii Maromak dehan, “Hau nia Aman, lalehan ho rai nia Nain. Hau hahii Ita Boot, tanba Ita Boot taka buat sira nee ba ema matenek ho ema eskola boot, maibee Ita hatudu fali ba ema nebee kiik. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Hau nia Aman, ida nee halo Ita Boot nia laran haksolok duni.”<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Hotu tiha, Jesus koalia ba ema iha nebaa nunee: “Hau nia Aman foo ona kbiit ho matenek hotu-hotu mai Hau. La iha ema ida konhese lo-loos Hau, so Hau nia Aman deit. I la iha ema ida mak konhese lo-loos Hau nia Aman, so Nia Oan, Hau deit. Hau mos hili ema seluk hodi hatudu Hau nia Aman ba sira, para sira mos bele konhese Nia.<note caller="+" style="x"><char style="xo" closed="false">11:27: </char><char style="xt" closed="false"><ref loc="JHN 3:35">João 3:35</ref>, <ref loc="JHN 1:18">1:18</ref>, <ref loc="JHN 10:15">10:15</ref></char></note><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Imi nebee kole, imi nebee loro-loron lori naha todan, mai iha Hau, i Hau sei halo kamaan imi nia todan. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Mai aprende husi Hau i moris tuir Hau nia hanorin, tanba Hau nee laran maus ho haraik Aan. Nunee imi nia laran bele senti kamaan.<note caller="+" style="x"><char style="xo" closed="false">11:29: </char><char style="xt" closed="false"><ref loc="JER 6:16">Jeremias 6:16</ref></char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Tanba buat nebee Hau hanorin la susar, i naha nebee Hau foo ba imi atu lori mos la todan.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Nai Jesus mak loron Sabadu nia Nain</para>
  <para style="r">(<ref loc="MRK 2:23-28">Marcos 2:23-28</ref>; <ref loc="LUK 6:1-5">Lucas 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Iha loron Sabadu ida, Jesus ho Nia eskolante sira lao liu husi ema nia toos. Nia eskolante sira hamlaha, entaun sira komesa korut trigu musan hodi haan.<note caller="+" style="x"><char style="xo" closed="false">12:1: </char><char style="xt" closed="false"><ref loc="DEU 23:25">Deuteronómiu 23:25</ref></char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Iha ema husi grupu Farizeu haree, i sira hasee Jesus dehan, “Haree took. Ita Boot nia eskolante sira servisu fali iha loron Sabadu. Ida nee kontra ita nia lei!”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Jesus hataan, “Imi lee tiha ona liurai David nia istoria. Nusaa mak imi la kompriende nafatin? Iha loron ida David ho nia ema sira hamlaha loos. <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Nia tama ba tenda orasaun. Iha nebaa iha paun nebee nai lulik sira oferese ona ba Maromak. Tuir lo-loos, so nai lulik sira deit mak bele haan paun nee, David ho nia ema sira nee la bele. Maibee David foti tiha paun nee, i nia ho nia ema sira haan.<note caller="+" style="x"><char style="xo" closed="false">12:4: </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Samuel 21:1-6</ref>; <ref loc="LEV 24:9">Levítiku 24:9</ref></char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Imi mos lee tiha ona Moisés nia lei. Tuir lei nee dehan, se nai lulik ida nia loron atu servisu iha uma kreda boot monu iha Sabadu, entaun nia tenki servisu duni. Maski kontra lei Sabadu nian, maibee Maromak la foo sala ba nia.<note caller="+" style="x"><char style="xo" closed="false">12:5: </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">Númerus 28:9-10</ref></char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Hau dehan ba imi, agora iha imi nia leet iha Ema ida boot liu uma kreda nee. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Iha Livru Sagradu hakerek dehan, ‘Hau hakarak atu imi hatudu laran luak ba malu. Se lae, imi lori sakrifisiu foo mai Hau mos la iha folin.’ Maibee liafuan nee, karik imi la simu. Nee mak imi hatudu liman ba ema nebee mak la sala.<note caller="+" style="x"><char style="xo" closed="false">12:7: </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mateus 9:13</ref>; <ref loc="HOS 6:6">Oseias 6:6</ref></char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Hau, Ema Umanu nia Oan mak loron Sabadu nia Nain. Hau mak iha direitu atu desidi, ema bele halo saida iha loron nee.”<verse eid="MAT 12:8" /></para>
  <para style="s">Nai Jesus kura ema liman sorin mate iha loron Sabadu</para>
  <para style="r">(<ref loc="MRK 3:1-6">Marcos 3:1-6</ref>; <ref loc="LUK 6:6-11">Lucas 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Depois Jesus lao husi toos nee, baa tama fali iha uma kreda. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Iha nebaa iha mane ida nia liman sorin mate. Ema Farizeu sira buka dalan atu foo sala ba Jesus. Entaun sira husu ba Jesus dehan, “Tuir lei Moisés nian, bele kura ema moras iha loron Sabadu ka lae?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Jesus hataan, “Se karik loron Sabadu mak imi nia bibi ida monu tama ba rai kuak laran, imi baa hasai ka lae?<note caller="+" style="x"><char style="xo" closed="false">12:11: </char><char style="xt" closed="false"><ref loc="LUK 14:5">Lucas 14:5</ref></char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Entaun halo buat diak ba ema iha loron Sabadu mos la kontra lei. Tanba kompara ho bibi, ema mak folin boot liu.”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Depois Jesus dehan ba ema liman sorin mate nee, “Lolo o nia liman mate nee mai!” Ema nee lolo ba, nia liman diak kedas hanesan fali nia liman sorin.<verse eid="MAT 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />Maibee ema Farizeu sira sai tiha ba liur hodi kombina malu para oho Jesus.<verse eid="MAT 12:14" /></para>
  <para style="s">Nai Maromak hili nanis Nai Jesus</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Jesus hatene hela ema Farizeu sira nia planu, nunee Nia husik tiha fatin nee. Ema barak tuir Nia, i Nia kura sira nia moras hotu. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Maibee Nia bandu sira atu la bele hatete sai kona ba Nia. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Nunee Nia halo tuir buat nebee mak Maromak foo sai tiha ona liu husi profeta Isaias. Maromak dehan,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Haree ba! Nee Hau nia Atan,</para>
  <para style="q2" vid="MAT 12:18">Hau mak hili Nia.</para>
  <para style="q1" vid="MAT 12:18">Hau hadomi Nia,</para>
  <para style="q2" vid="MAT 12:18">i Nia halo haksolok Hau nia laran.</para>
  <para style="q1" vid="MAT 12:18">Hau sei tau Hau nia Espiritu iha Nia,</para>
  <para style="q2" vid="MAT 12:18">i Nia sei foo sai lia loos ba ema husi suku hotu-hotu.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Nia la diskuti malu ho ema, i la hakilar.</para>
  <para style="q2" vid="MAT 12:19">Nia la koalia ho lian makaas tuir dalan.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Ai sanak lotuk nebee mak besik atu tohar, Nia la silu tohar.</para>
  <para style="q2" vid="MAT 12:20">Ahi-oan nebee mak besik atu mate, Nia la huu mate.</para>
  <para style="q1" vid="MAT 12:20">Nia sei hatudu Nia laran luak beibeik too lia loos mak manaan.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Ema iha suku hotu-hotu sei laran metin ba Nia.”<note caller="+" style="x"><char style="xo" closed="false">12:21: </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Isaias 42:1-4</ref></char></note><verse eid="MAT 12:21" /></para>
  <para style="s">Nai Jesus nunka uza Satanás nia kbiit</para>
  <para style="r">(<ref loc="MRK 3:20-30">Marcos 3:20-30</ref>; <ref loc="LUK 11:14-23">Lucas 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Depois ema balu lori mane ida ba Jesus. Ema nee diabu domina too nia matan delek i la hatene koalia. Jesus kura nia, nunee nia bele koalia ho haree fila fali. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ema hotu admira hodi dehan, “Keta halo be Ema nee mak David nia Jerasaun nebee Maromak promete atu haruka mai?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Maibee bainhira ema husi grupu Farizeu rona nunee, sira dehan, “Ema nee duni sai diabu tanba deit Nia simu kbiit husi diabu nia xefi Belzebu.”<note caller="+" style="x"><char style="xo" closed="false">12:24: </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mateus 9:34</ref>, <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Maibee Jesus hatene sira hotu nia hanoin. Nunee Nia hatete ba sira, “Se iha nasaun ida, nia povu haan malu hela deit, nasaun nee sei rahun. Se iha sidade ida ka uma kain ida, nia ema sira istori malu hela deit, sira sei naksobu. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Se Satanás mak duni sai Satanás, entaun diabu sira haan malu hela deit, i Satanás nia ukun sei la dura. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Imi duun Hau dehan, hodi Belzebu nia kbiit mak Hau duni sai diabu. Entaun bainhira imi nia eskolante sira duni sai diabu, sira mos uza Belzebu nia kbiit ka? Lae! Imi nia eskolante sira rasik mak sei hatete sai katak, buat nebee imi duun Hau nee, la loos. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Hau duni sai diabu hodi Maromak nia Espiritu. Nee hatudu katak Maromak ukun ona iha imi nia leet nudar Liurai.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Hau foo ezemplu tan. Se ema ida hakarak tama baa foti sasaan husi ema forti ida nia uma, nia tenki futu metin tiha ema forti nee uluk mak foin bele lalin sasaan sai husi nia uma.<note caller="+" style="f"><char style="fr" closed="false">12:29: </char><char style="ft" closed="false">Nunee Jesus hatete katak, Nia forsa liu Satanás. Nia mak bele hasai ema husi Satanás nia liman laran.</char></note><verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Ema nebee la hamutuk ho Hau, nia kontra Hau. I ema nebee la servisu hamutuk ho Hau, nia estraga Hau nia servisu.<note caller="+" style="x"><char style="xo" closed="false">12:30: </char><char style="xt" closed="false"><ref loc="MRK 9:40">Marcos 9:40</ref></char></note> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Nunee Hau dehan ba imi, ema nebee halo sala, too hatete aat Maromak mos, Maromak sei foo perdaun. Maibee see mak hatete aat Maromak nia Espiritu, Maromak la foo perdaun ba nia. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nunee mos ema nebee mak koalia aat Hau, Ema Umanu nia Oan, nia sei hetan perdaun. Maibee see mak koalia aat Espiritu Santu, Maromak la foo perdaun ba nia too tinan ba tinan.”<note caller="+" style="x"><char style="xo" closed="false">12:32: </char><char style="xt" closed="false"><ref loc="LUK 12:10">Lucas 12:10</ref></char></note><verse eid="MAT 12:32" /></para>
  <para style="s">Ema nia hahalok hatudu nia laran diak ka aat</para>
  <para style="r">(<ref loc="LUK 6:43-45">Lucas 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Jesus koalia nafatin ba ema Farizeu sira dehan, “Ai huun nebee diak sei foo fuan diak. Maibee ai huun nebee la diak sei foo fuan la diak. Tanba ai nee nia fuan mak hatudu sai katak ai huun nee diak ka la diak.<note caller="+" style="x"><char style="xo" closed="false">12:33: </char><char style="xt" closed="false"><ref loc="MAT 7:20">Mateus 7:20</ref>; <ref loc="LUK 6:44">Lucas 6:44</ref></char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Imi nee samea nia oan! Imi ema laran aat bele koalia buat diak ka? Lae! Tanba buat nebee mak rai iha ema nia laran, ida nee mak sei sai husi nia ibun.<note caller="+" style="x"><char style="xo" closed="false">12:34: </char><char style="xt" closed="false"><ref loc="MAT 3:7">Mateus 3:7</ref>, <ref loc="MAT 23:33">23:33</ref>, <ref loc="MAT 15:18">15:18</ref>; <ref loc="LUK 3:7">Lucas 3:7</ref>, <ref loc="LUK 6:45">6:45</ref></char></note> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Ema nebee diak koalia liafuan diak, tanba nia laran nakonu ho buat diak. I ema nebee aat koalia buat aat, tanba nia laran nakonu ho buat aat.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />Hanoin di-diak! Iha loron ikus bainhira Maromak tesi ema hotu-hotu nia lia, Nia sei tetu ema nia liafuan ida-ida. Imi nia liafuan nebee mak imi koalia arbiru, imi tenki hataan iha Maromak nia oin. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Atu Maromak desidi foo kastigu ka, desidi dehan imi la sala, depende ba imi nia liafuan.”<verse eid="MAT 12:37" /></para>
  <para style="s">Ema husu Nai Jesus atu hatudu milagre</para>
  <para style="r">(<ref loc="MRK 8:11-12">Marcos 8:11-12</ref>; <ref loc="LUK 11:29-32">Lucas 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Depois ema Farizeu ho mestri relijiaun balu husu ba Jesus dehan, “Mestri, ami hakarak haree milagre husi Ita Boot hodi hatudu katak Ita Boot nia kbiit mai husi Maromak.”<note caller="+" style="x"><char style="xo" closed="false">12:38: </char><char style="xt" closed="false"><ref loc="MAT 16:1">Mateus 16:1</ref>; <ref loc="MRK 8:11">Marcos 8:11</ref>; <ref loc="LUK 11:16">Lucas 11:16</ref></char></note><verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Jesus hataan, “Imi ema agora nee mesak aat deit i la foo laran ba Maromak! Imi husu Hau halo milagre hanesan sinal atu imi bele fiar. Maibee Hau sei la halo. Milagre nebee Maromak uluk halo liu husi profeta Jonas too ona.<note caller="+" style="x"><char style="xo" closed="false">12:39: </char><char style="xt" closed="false"><ref loc="MAT 16:4">Mateus 16:4</ref>; <ref loc="MRK 8:12">Marcos 8:12</ref></char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Jonas hela iha ikan boot nia kabun laran loron tolu kalan tolu. Nunee mos Hau, Ema Umanu nia Oan sei hela iha rai okos loron tolu kalan tolu.<note caller="+" style="x"><char style="xo" closed="false">12:40: </char><char style="xt" closed="false"><ref loc="JON 1:17">Jonas 1:17</ref></char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Iha loron ikus bainhira Maromak tesi ema hotu-hotu nia lia, ema jentiu sira husi sidade Nínive sei hamriik hodi foo sala ba imi. Tanba uluk bainhira Jonas baa foo sai Maromak nia liafuan ba sira, sira husik kedas sira nia sala. Agora iha Ema ida nebee boot liu fali Jonas iha imi nia leet, maibee imi lakohi husik imi nia sala.<note caller="+" style="x"><char style="xo" closed="false">12:41: </char><char style="xt" closed="false"><ref loc="JON 3:5">Jonas 3:5</ref></char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Laos povu Nínive deit mak sei foo sala ba imi. Liurai feto husi rai Seba mos sei moris fali, i hamriik hodi foo sala ba imi nebee moris agora, tanba uluk nia mai husi rai dook atu rona rasik liafuan matenek nian husi liurai Salomão. Agora iha Ema ida boot liu fali Salomão iha imi nia leet, maibee imi lakohi rona Nia.”<note caller="+" style="x"><char style="xo" closed="false">12:42: </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 Liurai 10:1-10</ref>; <ref loc="2CH 9:1-12">2 Krónikas 9:1-12</ref></char></note><verse eid="MAT 12:42" /></para>
  <para style="s">Diabu fila ba nia hela fatin uluk</para>
  <para style="r">(<ref loc="LUK 11:24-26">Lucas 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Bainhira espiritu aat sai husi ema ida, espiritu aat nee baa lao lemo-lemo iha rai fuik maran hodi buka fatin atu hela. Maibee nia la hetan fatin nebee diak. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Entaun nia dehan, ‘Diak liu hau fila fali ba hau nia hela fatin uluk.’ Kuandu nia fila, nia haree fatin nee mamuk, hamoos tiha ona i buat hotu-hotu tau tuir nia fatin. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Depois espiritu aat nee baa bolu tan espiritu hitu nebee aat liu fali nia, i sira hotu baa hela iha ema nee. Nunee ema nee nia moris aat liu fali uluk. Ema aat nebee moris agora mos sei sai hanesan nee.”<verse eid="MAT 12:45" /></para>
  <para style="s">See mak Nai Jesus nia familia lo-loos</para>
  <para style="r">(<ref loc="MRK 3:31-35">Marcos 3:31-35</ref>; <ref loc="LUK 8:19-21">Lucas 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Jesus sei koalia hela ba ema lubun boot, Nia inan ho Nia alin mane sira mai hamriik iha liur atu koalia ho Nia. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Iha ema ida foo hatene ba Jesus dehan, “Ita Boot nia inan ho alin sira hamriik iha liur. Sira husu atu koalia ho Ita Boot.”<note caller="+" style="f"><char style="fr" closed="false">12:47: </char><char style="ft" closed="false">Kopia evanjelhu Mateus husi tempu antigu barak. Maioria tau versikulu 47, maibee balu lae.</char></note><verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Maibee Jesus hataan ba ema nee dehan, “Hau nia inan mak see? I Hau nia alin sira mak see?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Depois Nia hatudu ba Nia eskolante sira hodi dehan, “Sira nee mak Hau nia inan ho Hau nia alin sira. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Tanba see mak halo tuir Hau nia Aman iha lalehan nia hakarak, sira nee mak Hau nia inan, Hau nia feton ho Hau nia alin sira.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Komparasaun kona ba ema nebee kari fini</para>
  <para style="r">(<ref loc="MRK 4:1-9">Marcos 4:1-9</ref>; <ref loc="LUK 8:4-8">Lucas 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Iha loron nebaa, Jesus sai husi uma nee i baa tuur iha tasi ibun. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Ema barak teb-tebes mak mai haleu Nia, nunee Nia baa tuur iha roo laran, i ema sira nee hamriik deit iha tasi ibun.<note caller="+" style="x"><char style="xo" closed="false">13:2: </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">Lucas 5:1-3</ref></char></note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Nia hanorin buat barak uza komparasaun. Nia dehan nunee: “Iha toos nain ida baa kari fini iha nia toos. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Bainhira nia kari fini nee, balu monu iha dalan. I manu fuik mai haan tiha hotu.<verse eid="MAT 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 13:5" />Fini balu monu iha fatuk leten, fini nee moris lalais deit tanba rai mihis. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Maibee bainhira loro matan sae, loro manas sunu fini nebee foin moris sai mai nee too namlaik tiha, tanba abut la tama iha rai okos.<verse eid="MAT 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 13:7" />Fini balu monu iha duut tarak laran. Fini nee moris, maibee duut tarak habit tiha too la buras sae.<verse eid="MAT 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 13:8" />Iha fini balu tan monu iha rai bokur. Fini nee moris too foo isin barak, balu too musan atus ida, balu too musan neen-nulu, i balu too tolu-nulu.<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />Imi nebee iha tilun, rona di-diak ba!”<verse eid="MAT 13:9" /></para>
  <para style="s">Tanba saa mak Nai Jesus hanorin uza komparasaun?</para>
  <para style="r">(<ref loc="MRK 4:10-12">Marcos 4:10-12</ref>; <ref loc="LUK 8:9-10">Lucas 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Depois Jesus nia eskolante sira mai husu Nia dehan, “Nusaa mak Ita Boot hanorin sira uza fali komparasaun?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Jesus hataan, “Uluk ema seidauk hatene, oinsaa mak Maromak ukun nudar Liurai. Agora Hau foo sai mo-moos ba imi deit, ba ema seluk lae. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Tanba ema nebee kompriende ona, Maromak sei halo nia kompriende liu tan. Maibee ema nebee lakohi hatene, buat uitoan nebee nia kompriende tiha ona mos, Maromak sei hasai tiha husi nia hanoin.<note caller="+" style="x"><char style="xo" closed="false">13:12: </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mateus 25:29</ref>; <ref loc="MRK 4:25">Marcos 4:25</ref>; <ref loc="LUK 8:18">Lucas 8:18</ref>, <ref loc="LUK 19:26">19:26</ref></char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Hau hanorin sira uza komparasaun tanba</para>
  <para style="q1" vid="MAT 13:13">‘Sira haree hela,</para>
  <para style="q2" vid="MAT 13:13">maibee hanesan la haree.</para>
  <para style="q1" vid="MAT 13:13">Sira rona hela,</para>
  <para style="q2" vid="MAT 13:13">maibee hanesan la rona i la kompriende.’<verse eid="MAT 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />Maromak nia liafuan liu husi profeta Isaias kona loos sira. Maromak dehan,</para>
  <para style="q1" vid="MAT 13:14">‘Imi sei rona beibeik,</para>
  <para style="q2" vid="MAT 13:14">maibee la kompriende nafatin.</para>
  <para style="q1" vid="MAT 13:14">Imi sei haree beibeik,</para>
  <para style="q2" vid="MAT 13:14">maibee nafatin la hatene tuir.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Tanba povu nee nia laran toos tiha ona,</para>
  <para style="q2" vid="MAT 13:15">sira lakohi rona ho sira nia tilun,</para>
  <para style="q3" vid="MAT 13:15">sira nia matan taka metin.</para>
  <para style="q1" vid="MAT 13:15">Sira halo nunee atu sira nia matan la bele haree,</para>
  <para style="q2" vid="MAT 13:15">sira nia tilun la bele rona,</para>
  <para style="q3" vid="MAT 13:15">i sira nia laran la bele kompriende.</para>
  <para style="q1" vid="MAT 13:15">Nunee sira la bele fila fali mai Hau,</para>
  <para style="q2" vid="MAT 13:15">atu Hau salva sira.’<note caller="+" style="x"><char style="xo" closed="false">13:15: </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isaias 6:9-10</ref></char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Maibee imi nee hetan bensaun tanba imi nia matan haree, imi nia tilun rona. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Hau hatete lo-loos ba imi, uluk profeta barak ho ema seluk nebee moris loos, hakarak teb-tebes atu haree buat nebee mak agora imi haree, maibee sira la haree. Sira hakarak teb-tebes atu rona buat nebee agora imi rona, maibee sira la rona.”<note caller="+" style="x"><char style="xo" closed="false">13:17: </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">Lucas 10:23-24</ref></char></note><verse eid="MAT 13:17" /></para>
  <para style="s">Komparasaun kona ba kari fini dehan saida?</para>
  <para style="r">(<ref loc="MRK 4:13-20">Marcos 4:13-20</ref>; <ref loc="LUK 8:11-15">Lucas 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“Entaun rona mai, istoria kona ba ema kari fini nee dehan saida? <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Fini nebee monu iha dalan mak ema nebee rona Maromak nia liafuan kona ba oinsaa Nia ukun nudar Liurai, maibee ema nee la kompriende. Depois aat nain mai hadau tiha liafuan nebee iha tiha ona nia laran.<verse eid="MAT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 13:20" />Fini nebee monu iha fatuk leten mak ema nebee rona Maromak nia liafuan, i simu kedas ho laran haksolok. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Maibee liafuan nee la iha abut. Nunee nia fiar duni maibee la kleur ida. Bainhira susar kona nia, ka ema seluk halo terus nia tanba nia simu liafuan nee, nia husik tiha kedas.<verse eid="MAT 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 13:22" />Fini nebee monu iha duut tarak laran mak ema nebee rona Maromak nia liafuan, maibee nia preokupa ho nia moris loro-loron nian, i matan naklosu ba riku-soin mundu nian. Nia preokupasaun nee la foo fatin ba Maromak nia liafuan, nunee liafuan nee la muda nia moris.<verse eid="MAT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 13:23" />Maibee fini nebee monu iha rai bokur mak ema nebee rona Maromak nia liafuan hodi kompriende. Depois ema nee moris tuir, hanesan fini nebee moris too foo isin, balu too musan atus ida, balu musan neen-nulu, i balu musan tolu-nulu.”<verse eid="MAT 13:23" /></para>
  <para style="s">Komparasaun kona ba duut fuik iha toos laran</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Depois Jesus halo tan komparasaun dehan, “Maromak ukun nudar Liurai, nee hanesan toos nain ida baa kari fini diak iha nia toos. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Kalan boot ema hotu toba dukur tiha, toos nain nia inimigu ida mai kari tan duut nia musan ba iha toos nee nia laran. Hotu tiha inimigu nee fila. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Bainhira fini nee moris i fulin komesa sai mai, duut fuik mos moris buras. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Haree nunee, atan sira nebee mak servisu iha toos nee baa foo hatene toos nain dehan, ‘Patraun, uluk ita kari deit fini diak. Nusaa mak duut fuik mosu hotu?’<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />Toos nain nee hataan, ‘Hau nia inimigu mak halo ida nee.’</para>
  <para style="p" vid="MAT 13:28">Atan sira dehan tan, ‘Se patraun hakarak, ami baa fokit sai tiha.’<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />Maibee toos nain hataan dehan, ‘La bele. Keta fokit lai, tanba se imi fokit sai duut fuik nee, imi mos bele fokit sai fini diak nebee moris ona nee. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Husik sira moris hamutuk. Bainhira too nia tempu atu koa mak hau haruka ema nebee servisu atu baa fokit sai duut nee hodi futu hamutuk ba sunu tiha. Depois toos nia rezultadu tau hamutuk hodi rai iha armazen laran.’ ”<verse eid="MAT 13:30" /></para>
  <para style="s">Komparasaun kona ba ai musan ho fermentu</para>
  <para style="r">(<ref loc="MRK 4:30-32">Marcos 4:30-32</ref>; <ref loc="LUK 13:18-21">Lucas 13:18-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Jesus halo tan komparasaun dehan, “Maromak Nia reinu, nee hanesan ai musan kiikoan loos nebee mak ema kuda iha nia toos. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Maski ai musan nee kiik liu musan sira seluk, maibee nia moris i buras too sai ai huun ida nebee mak boot liu iha toos laran. Nunee manu fuik sira mai halo knuuk iha nia sanak.”<note caller="+" style="f"><char style="fr" closed="false">13:32: </char><char style="ft" closed="false">Nunee Nai Jesus hanorin katak, maski fo-foun ema uitoan deit mak hakruuk ba Maromak nudar Liurai, maibee too ikus Nia reinu sei sai barak loos.</char></note><verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Jesus halo tan komparasaun seluk dehan, “Maromak ukun Nia reinu, nee hanesan fermentu nebee senhora ida kahur ho trigu saka ida hodi halo paun. Too ikus, fermentu uitoan nee halo trigu tomak sae.”<note caller="+" style="f"><char style="fr" closed="false">13:33: </char><char style="ft" closed="false">Nunee Nai Jesus hanorin katak, maski ema uitoan hakruuk ba Maromak nudar Liurai, maibee bele muda ema barak nia moris.</char></note><verse eid="MAT 13:33" /></para>
  <para style="s">Nai Jesus sempre uza komparasaun hodi hanorin buat foun</para>
  <para style="r">(<ref loc="MRK 4:33-34">Marcos 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Jesus esplika reinu lalehan ba ema lubun boot nee ho komparasaun oi-oin. Nia sempre hanorin sira uza komparasaun. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Nunee Nia halo tuir saida mak Maromak nia profeta hakerek tiha ona dehan,</para>
  <para style="q1" vid="MAT 13:35">“Hau sei hanorin uza komparasaun.</para>
  <para style="q2" vid="MAT 13:35">Hau sei foo sai buat nebee mak ema nunka rona</para>
  <para style="q3" vid="MAT 13:35">komesa husi Maromak halo mundu too agora.”<note caller="+" style="x"><char style="xo" closed="false">13:35: </char><char style="xt" closed="false"><ref loc="PSA 78:2">Salmu 78:2</ref></char></note><verse eid="MAT 13:35" /></para>
  <para style="s">Komparasaun kona ba duut fuik iha toos laran dehan saida?</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Depois Jesus sai tiha husi ema barak nee nia leet hodi tama ba iha uma laran. Nia eskolante sira mai tuir Nia hodi husu dehan, “Esplika mai ami komparasaun kona ba duut fuik nee.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Jesus hataan dehan, “Ema nebee mak kari fini diak mak Hau, Ema Umanu nia Oan. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Toos mak mundu nee. Fini diak mak Maromak nia reinu, i duut fuik mak ema nebee tuir Satanás. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Inimigu nebee kari duut fuik nee mak Satanás. Tempu koa nian mak bainhira mundu remata, i ema nebee hatama rezultadu toos mak Maromak nia anju sira. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Duut fuik fokit tiha hodi sunu iha ahi laran. Nunee mos bainhira mundu nee atu remata. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Hau, Ema Umanu nia Oan sei haruka Hau nia anju sira baa iha Hau nia povu nia leet hodi fokit sai see-see deit mak halo sala ho mos ema nebee mak halo ema seluk too monu ba sala. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Hau nia anju sira sei soe ema aat sira nee ba iha ahi lakan laran, iha nebaa sira sei tanis hakilar i ruun nehan. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Maibee ema nebee mak moris loos, sira sei tama iha lalehan hodi hela hamutuk ho Maromak, Nia mak sira nia Aman ho sira nia Liurai. Iha nebaa sira sei nabilan hanesan loro matan. See mak iha tilun, rona di-diak ba!”<verse eid="MAT 13:43" /></para>
  <para style="s">Nai Maromak ukun ita nudar Liurai folin boot liu riku-soin hotu-hotu</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Maromak ukun nudar Liurai, ita bele kompara ho riku-soin ida karun teb-tebes nebee subar hela iha rai okos. Iha ema ida hetan riku-soin nee. Nia kontenti loos, entaun nia hakoi fila fali, i baa faan tiha nia sasaan hotu-hotu hodi sosa rai nee, para riku-soin nee bele sai ninian.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Maromak ukun nudar Liurai, ita mos bele kompara hanesan nee: Iha kontratu nain ida buka hela buat murak mean atu sosa. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Bainhira nia hetan ida nebee diak liu, nia baa faan tiha nia sasaan hotu-hotu hodi sosa buat murak mean nee.”<verse eid="MAT 13:46" /></para>
  <para style="s">Komparasaun kona ba redi</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Maromak ukun nudar Liurai, bele mos kompara hanesan nee. Iha peskador balu hatuun redi ba iha tasi laran hodi hetan ikan oi-oin deit. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Bainhira redi nee ikan nakonu ona, sira dada sai ba iha tasi ibun. Depois sira tuur hodi hasai tiha ikan barak nee husi redi. Ikan diak nian, sira hatama ba iha nia fatin. Ikan nebee mak aat, sira soe tiha.<verse eid="MAT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 13:49" />Nunee mos bainhira mundu nee atu remata, anju sira sei mai haketak tiha ema aat husi ema nebee mak moris loos. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Ema aat, sei soe ba iha ahi lakan laran, iha nebaa sira sei tanis hakilar i ruun nehan.”<verse eid="MAT 13:50" /></para>
  <para style="s">Nai Maromak nia hanorin uluk ho agora</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Depois Jesus husu Nia eskolante sira dehan, “Buat nebee ohin Hau hanorin nee, imi kompriende hotu ka lae?”</para>
  <para style="p" vid="MAT 13:51">Nia eskolante sira hataan, “Ami kompriende.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Jesus dehan, “Se nunee imi hanesan mestri relijiaun nebee hatene ona Maromak nia liafuan uluk nian i hatene mos buat nebee mak agora Hau hanorin kona ba Maromak ukun nudar Liurai. Imi hanesan uma nain nebee mak rai riku-soin antigu nian ho riku-soin foun hamutuk iha fatin ida, depois hatudu sai ba ema.”<verse eid="MAT 13:52" /></para>
  <para style="s">Ema Nazaré lakohi simu Nai Jesus</para>
  <para style="r">(<ref loc="MRK 6:1-6">Marcos 6:1-6</ref>; <ref loc="LUK 4:16-30">Lucas 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Bainhira Jesus hanorin hotu komparasaun hirak nee, Nia husik tiha fatin nee <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />hodi baa fali iha Nia aldeia rasik. Iha nebaa Nia tama iha uma kreda hodi hanorin. Ema nebee rona Nia admira hodi husu ba malu, “Ema nee hetan matenek husi nebee? Nia hetan kbiit husi nebee mak bele halo milagre boot hanesan nee? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ita hatene hela Nia. Nia aman badaen ai ida. Nia inan mak Maria, i nia alin sira Tiago, José, Simão ho Judas. <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Nia alin feto sira mos hela iha nee hotu. Entaun Ema nee hetan buat sira nee husi nebee?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Nunee sira laran moras too lakohi simu Nia.</para>
  <para style="p" vid="MAT 13:57">Maibee Jesus hatete ba sira, “Ema iha nebee-nebee deit respeita Maromak nia profeta. So ema husi nia aldeia rasik ho nia familia rasik mak la respeita nia.”<note caller="+" style="x"><char style="xo" closed="false">13:57: </char><char style="xt" closed="false"><ref loc="JHN 4:44">João 4:44</ref></char></note> <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Entaun Jesus halo milagre uitoan deit iha sira nia leet, tanba sira lakohi fiar ba Nia.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Liurai Herodes haruka tesi João Sarani Nain nia ulun</para>
  <para style="r">(<ref loc="MRK 6:14-29">Marcos 6:14-29</ref>; <ref loc="LUK 9:7-9">Lucas 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Iha tempu nebaa liurai Herodes mak ukun iha provinsia Galileia. Nia rona buat oi-oin kona ba Jesus, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />too nia hatete ba nia funsionariu sira, “Keta halo be Ema nee João Sarani Nain mak moris fali ona husi mate. Nee mak Nia iha kbiit hodi halo milagre.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3-4" style="v" sid="MAT 14:3-4" />João Sarani Nain ho Herodes nia istoria nunee: Uluk Herodes hola fali nia alin Filipe nia kaben, naran Herodias. Iha tempu nebaa João hasee nia fila-fila dehan, “Ita la bele hola fali ita nia alin nia kaben, hahalok nee kontra Maromak nia lei!” Tanba nee, Herodes haruka ema kaer João i futu nia hodi hatama ba iha komarka.<note caller="+" style="x"><char style="xo" closed="false">14:3-4: </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Lucas 3:19-20</ref>; <ref loc="LEV 18:16">Levítiku 18:16</ref>, <ref loc="LEV 20:21">20:21</ref></char></note> <verse eid="MAT 14:3-4" /><verse number="5" style="v" sid="MAT 14:5" />Tuir lo-loos Herodes hakarak atu oho João, maibee nia la brani tanba povu hanoin dehan João nee Maromak nia profeta ida.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Iha loron ida Herodes halo nia tinan, i Herodias nia oan feto mai dansa iha bainaka sira nia oin. Menina nee nia dansa halo Herodes nia laran kontenti teb-tebes, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />too nia jura ba menina nee atu foo saida deit mak nia husu.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Menina nia inan rona kona ba juramentu nee, i nia hamaus nia oan atu husu João Sarani Nain nia ulun. Entaun menina nee husu ba Herodes, “Hau hakarak João nia ulun, tau iha bandeja ida, entrega kedas mai hau.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Liurai laran susar teb-tebes. Maibee nia jura tiha ona iha bainaka sira nia oin, entaun nia haruka ema baa halo tuir saida mak menina nee husu. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Sira baa iha komarka hodi tesi tiha João nia ulun, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />i tau iha bandeja foo ba menina nee. Depois menina nee lori baa entrega ba nia inan.<verse eid="MAT 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 14:12" />Hotu tiha João nia eskolante sira baa lori sai João nia mate isin baa hakoi tiha. Depois sira baa foo hatene Jesus.<verse eid="MAT 14:12" /></para>
  <para style="s">Nai Jesus foo hahaan ba ema rihun lima resin</para>
  <para style="r">(<ref loc="MRK 6:30-44">Marcos 6:30-44</ref>; <ref loc="LUK 9:10-17">Lucas 9:10-17</ref>; <ref loc="JHN 6:1-14">João 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Jesus rona katak ema oho tiha ona João. Entaun Nia husik tiha fatin nee hodi sae roo ba iha rai fuik ida. Maibee ema rona katak Nia atu baa iha nebaa, nunee ema barak husi aldeia oi-oin lao liu husi tasi ibun hodi tuir Nia. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Bainhira Jesus tuun husi roo, Nia haree ema lubun boot hein hela Nia iha nebaa. Nia hanoin loos sira, i Nia kura sira nebee mak moras.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Bainhira lokraik ona, Jesus nia eskolante sira mai hatete ba Nia dehan, “Iha nee rai fuik, rai mos besik kalan ona. Diak liu haruka ema sira nee baa iha aldeia hodi sosa hahaan rasik.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Maibee Jesus dehan, “Lae, sira la presiza baa sosa hahaan. Imi mak foo hahaan ba sira.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Nia eskolante sira hataan, “Ami iha deit paun fuan lima ho ikan rua.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Jesus hataan fali, “Lori mai.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Depois Jesus haruka ema lubun boot nee tuur hotu iha duut leten. Nia foti paun fuan lima ho ikan rua nee, i hateke ba lalehan hodi foo agradese ba Maromak. Nia silu paun ho ikan halo pedasuk-pedasuk, i foo ba Nia eskolante sira. Depois Nia eskolante sira hodi baa fahe ba ema lubun boot nee. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Sira hotu haan too bosu, hahaan mos resin. Nia eskolante sira tau hamutuk hahaan restu sira nee iha bote sanulu resin rua nakonu. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ema nebee haan nee maizoumenus rihun lima. Nee foin sura mane deit, feto ho labarik la sura.<verse eid="MAT 14:21" /></para>
  <para style="s">Nai Jesus lao iha bee leten</para>
  <para style="r">(<ref loc="MRK 6:45-52">Marcos 6:45-52</ref>; <ref loc="JHN 6:16-21">João 6:16-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Hotu tiha, Jesus haruka kedas Nia eskolante sira sae roo hodi baa uluk iha tasi sorin. Maibee Nia sei hela iha nebaa, atu haruka ema lubun boot nee fila. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Bainhira sira fila hotu ona, Jesus mesak sae ba foho ida hodi halo orasaun. Rai besik kalan ona, Nia mes-mesak iha foho leten. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Iha momentu nebaa roo nebee Nia eskolante sira sae nee iha tiha ona tasi klaran. Roo nee halai hasoru anin boot, laloran mos baku makaas. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Iha dadeer-saan nakukun Jesus lao iha bee leten baa hasoru Nia eskolante sira. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Bainhira Nia eskolante sira haree Nia lao iha bee leten, sira tauk hodi hakilar makaas dehan, “Mate klamar mai nee!”<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Maibee Jesus hataan kedas, “Brani ba! Nee Hau. La bele tauk!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Pedro hataan, “Nai, se Nai mak iha nebaa duni, entaun haruka hau lao iha bee leten baa hasoru Ita Boot.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Jesus dehan, “Mai ba!” Nunee Pedro tuun husi roo i lao iha bee leten atu baa Jesus. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Maibee bainhira Pedro haree anin boot, nia komesa tauk i mout dadauk iha tasi laran. Nia hakilar makaas ba Jesus dehan, “Nai, salva hau ba!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Jesus lolo kedas Nia liman ba Pedro hodi kaer nia dehan, “O nee fiar fraku! Nusaa mak o duvida hanesan nee?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Depois sira nain rua tama iha roo laran, i anin mos para kedas. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Sira hotu nebee iha roo laran komesa adora Jesus dehan, “Ita Boot mak Maromak nia Oan duni!”<verse eid="MAT 14:33" /></para>
  <para style="s">Nai Jesus kura ema moras iha Genesaré</para>
  <para style="r">(<ref loc="MRK 6:53-56">Marcos 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Bainhira Jesus ho Nia eskolante sira too iha tasi sorin, sira tuun iha rai Genesaré. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ema iha nebaa konhese kedas Jesus, i sira baa foo hatene ema iha rejiaun nee tomak. Nunee ema lori sira nia maluk sira nebee moras ba Jesus. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Sira husu ba Jesus atu ema moras sira nee bele kona deit Nia hena rohan. I ema moras sira nebee konsege kona Nia hena rohan, sira hetan kura hotu.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Keta troka Nai Maromak nia lei ho ita nia lisan</para>
  <para style="r">(<ref loc="MRK 7:1-13">Marcos 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Loron ida ema balu husi grupu Farizeu ho mestri relijiaun balu mai husi Jerusalém atu hasoru malu ho Jesus. Too iha nebaa, sira husu Nia, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Tuir ita nia bei-ala sira nia lisan, molok atu haan tenki fase liman lai. Maibee Ita Boot nia eskolante sira lae. Nusaa mak sira kontra fali ita nia lisan nee?”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Jesus hataan dehan, “Nusaa mak imi kontra Maromak nia lei tanba deit imi hakarak tuir imi nia lisan? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Tanba Maromak hatete, ‘Respeita o nia inan-aman.’ Nia mos dehan, ‘See mak koalia liafuan aat hasoru nia inan-aman, ema nee sei hetan kastigu mate.’<note caller="+" style="x"><char style="xo" closed="false">15:4: </char><char style="xt" closed="false"><ref loc="EXO 20:12">Ézodu 20:12</ref>, <ref loc="EXO 21:17">21:17</ref>; <ref loc="LEV 20:9">Levítiku 20:9</ref>; <ref loc="DEU 5:16">Deuteronómiu 5:16</ref></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Maibee imi hanorin oin seluk fali. Tuir imi, ema bele hatete ba nia inan-aman dehan, ‘Sasaan nebee apaa ho amaa presiza, hau la bele foo, tanba hau promete ona atu foo ba Maromak.’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Nunee imi hanorin ema atu la respeita sira nia inan-aman. Imi halakon tiha Maromak nia lei tanba deit imi hakarak halo tuir imi nia lisan. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Imi koalia oin seluk, hahalok oin seluk! Buat nebee hori uluk kedas profeta Isaias hakerek, kona loos imi. Nia foo tutan Maromak nia liafuan nunee:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Ema sira nee hahii Hau ho ibun tutun,</para>
  <para style="q2" vid="MAT 15:8">maibee sira nia laran dook husi Hau.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Sira adora Hau</para>
  <para style="q2" vid="MAT 15:9">maibee la iha folin.</para>
  <para style="q1" vid="MAT 15:9">Sira hanorin deit lei ema nian,</para>
  <para style="q2" vid="MAT 15:9">maibee bosok fali dehan, sira nia hanorin nee mai husi Hau.’ ”<note caller="+" style="x"><char style="xo" closed="false">15:9: </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isaias 29:13</ref></char></note><verse eid="MAT 15:9" /></para>
  <para style="s">Buat aat iha ema nia laran mak halo nia foer</para>
  <para style="r">(<ref loc="MRK 7:14-23">Marcos 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Depois Jesus bolu ema hotu iha nebaa atu mai besik. Nia dehan ba sira, “Rona mai, i kompriende di-diak Hau nia liafuan nee. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Hahaan saida mak hatama husi ema nia ibun, nee la halo foer nia iha Maromak nia oin. Maibee liafuan nebee mak sai husi ema nia ibun, nee mak halo foer nia.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Jesus nia eskolante sira mai dehan ba Nia, “Ita Boot hatene ka lae? Ita Boot nia liafuan ohin nee xoke loos ema Farizeu sira.”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Maibee Jesus soe lia hodi hataan sira dehan, “Ai horis hotu-hotu nebee laos Hau nia Aman iha lalehan mak kuda, Nia sei fokit sai tiha. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Husik sira hirus ba! Sira nee hanesan ema matan delek nebee hakarak hatudu dalan ba ema matan delek seluk, too ikus sira monu hotu ba rai kuak.”<note caller="+" style="x"><char style="xo" closed="false">15:14: </char><char style="xt" closed="false"><ref loc="LUK 6:39">Lucas 6:39</ref></char></note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Pedro husu, “Ohin Mestri koalia kona ba buat nebee halo foer ema. Liafuan nee dehan saida?”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Jesus hataan, “Imi la kompriende nafatin ka? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Imi hatene katak buat nebee ema haan liu husi nia ibun sei tama iha nia kabun laran depois sai fali. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Maibee buat nebee mak sai husi ema nia ibun mai husi nia laran. Ida nee mak halo foer nia.<note caller="+" style="x"><char style="xo" closed="false">15:18: </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mateus 12:34</ref></char></note> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Tanba hanoin aat nebee mosu husi ema nia laran mak lori nia ba oho ema, halo sala ho ema nia feen ka laen ho sala seksual sel-seluk, naok, foo sasin falsu i hatete aat ema seluk. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Hahalok sira nee mak halo ema sai foer iha Maromak nia oin. Laos haan la fase liman mak halo sira sai foer.”<verse eid="MAT 15:20" /></para>
  <para style="s">Feto jentiu ida fiar makaas ba Nai Jesus</para>
  <para style="r">(<ref loc="MRK 7:24-30">Marcos 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Depois Jesus husik tiha fatin nee hodi baa fali iha rai ida besik sidade Tiru ho Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Iha nebaa iha feto Kanaán ida husi rai nee mai hasoru Jesus. Nia husu fila-fila ho lian makaas dehan, “Nai, Liurai David nia Jerasaun, hanoin hau ba! Hau nia oan feto, diabu tama iha nia laran halo nia terus liu.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Maibee Jesus la hataan buat ida. Nunee Nia eskolante sira mai hatete ba Nia dehan, “Senhora nee hakilar la para iha ita nia kotuk, diak liu haruka nia fila.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Maibee Jesus hataan dehan, “Maromak haruka Hau mai atu ajuda deit ema Israel, tanba sira hanesan bibi malae nebee lao sala dalan ona.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Maski nunee senhora nee mai hakneak iha Jesus nia oin hodi dehan, “Nai, ajuda hau!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Jesus soe lia dehan, “La bele foti labarik nia hahaan hodi soe fali ba asu. Nee la loos.”<note caller="+" style="f"><char style="fr" closed="false">15:26: </char><char style="ft" closed="false">Iha nee labarik hatudu ba ema Israel, i asu ba ema jentiu.</char></note><verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Senhora nee hataan fali dehan, “Loos duni Nai, maibee asu sira bele hili labarik nia hahaan nebee mak monu iha meza okos.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Rona nunee Jesus dehan, “Senhora, ita nia fiar makaas! Saida mak ita husu sei akontese duni.” Iha oras nee kedas senhora nee nia oan feto diak fali.<verse eid="MAT 15:28" /></para>
  <para style="s">Nai Jesus kura ema jentiu barak nia moras</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Depois Jesus husik tiha fatin nee, lao tuir tasi Galileia nia ninin. Nia sae ba foho ida hodi tuur, <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />i ema barak teb-tebes mai iha Nia. Sira lori sira nia maluk nebee ain mate, ain aat, matan delek, koalia la diak, ho ema moras oi-oin tan. Sira tau ema sira nee iha Jesus nia oin, i Nia kura sira hotu kedas. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Bainhira sira haree saida mak Jesus halo nee, sira hotu admira. Ema nebee uluk koalia la diak agora bele koalia, ema ain mate ho ain aat bele lao, i ema matan delek bele haree. Entaun sira hotu hahii Israel nia Maromak.<verse eid="MAT 15:31" /></para>
  <para style="s">Nai Jesus foo hahaan ba ema rihun haat</para>
  <para style="r">(<ref loc="MRK 8:1-10">Marcos 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Depois Jesus bolu Nia eskolante sira hamutuk, foin Nia dehan ba sira, “Hau hanoin loos ema barak nee. Sira hamutuk ho Hau loron tolu ona, i sira nia hahaan la iha ona. Hau lakohi haruka sira fila ho kabun mamuk. Se lae, sira oin nakukun, bele monu iha dalan.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Nia eskolante sira hataan, “Rai nee fuik. Ita atu hetan hahaan husi nebee mak atu foo hahaan ba ema barak hanesan nee?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Jesus husu, “Imi sei iha paun fuan hira?”</para>
  <para style="p" vid="MAT 15:34">Sira hataan, “Iha deit paun fuan hitu, ho ikan kiik, uitoan deit.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Depois Jesus haruka ema lubun boot nee tuur hotu iha rai. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Nia foti paun fuan hitu ho ikan nee hodi foo agradese ba Maromak. Nia silu halo rohan-rohan tiha, i foo ba Nia eskolante sira. Depois Nia eskolante sira fahe ba ema lubun boot nee. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Sira hotu haan too bosu, hahaan mos resin. Nia eskolante sira tau hamutuk hahaan restu sira nee iha bote hitu nakonu. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Ema nebee haan nee, rihun haat. Nee foin sura mane deit, feto ho labarik la sura.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Hotu tiha Jesus haruka ema lubun boot nee fila. Depois Nia baa sae roo hodi baa iha rai Magadán.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Ema Farizeu ho Saduseu husu Nai Jesus atu hatudu milagre</para>
  <para style="r">(<ref loc="MRK 8:11-13">Marcos 8:11-13</ref>; <ref loc="LUK 12:54-56">Lucas 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Iha loron ida ema balu husi grupu Farizeu ho Saduseu mai koko Jesus. Sira husu para Nia halo tan milagre hodi hatudu katak Nia kbiit nee mai duni husi Maromak.<note caller="+" style="x"><char style="xo" closed="false">16:1: </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mateus 12:38</ref>; <ref loc="LUK 11:16">Lucas 11:16</ref></char></note><verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Maibee Jesus hataan, “Bainhira loro matan atu besik monu, imi haree kalohan mihis sai mean, imi siik dehan, aban la udan. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Iha dadeer-saan fali, bainhira imi haree loro matan leno kalohan mahar, imi siik dehan, karik orsida udan. Imi hatene siik sinal nebee mosu iha kalohan. Maibee sinal nebee mak akontese iha imi nia oin agora dadauk nee, imi la hatene siik. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Imi ema agora nee mesak aat deit i la foo laran ba Maromak! Imi husu Hau halo milagre hanesan sinal atu imi bele fiar. Maibee Hau sei la halo. Milagre nebee Maromak uluk halo liu husi profeta Jonas too ona.” <note caller="+" style="f"><char style="fr" closed="false">16:4: </char><char style="ft" closed="false">Uluk liu ikan boot tolan tiha Maromak nia profeta ida naran Jonas. Too loron tolu, ikan nee muta sai fali Jonas iha tasi ibun, moris hela. Iha nee Jesus temi Jonas hodi hatudu ba Nia Aan rasik. Nia sei mate i ema sei hakoi Nia, depois iha loron tolu Nia sei moris fila fali.</char></note> <note caller="+" style="x"><char style="xo" closed="false">16:4: </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mateus 12:39</ref>; <ref loc="LUK 11:29">Lucas 11:29</ref></char></note> Koalia tiha hotu, Jesus lao husik tiha sira.<verse eid="MAT 16:4" /></para>
  <para style="s">Kuidadu ho ema Farizeu ho Saduseu sira nia hanorin</para>
  <para style="r">(<ref loc="MRK 8:14-21">Marcos 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Jesus ho Nia eskolante sira baa iha tasi sorin. Too iha nebaa, Nia eskolante sira foin hanoin katak sira haluha lori paun. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Depois Jesus hatete ba sira, “Kuidadu! Hadook aan husi ema Farizeu ho Saduseu sira nia fermentu.”<note caller="+" style="x"><char style="xo" closed="false">16:6: </char><char style="xt" closed="false"><ref loc="LUK 12:1">Lucas 12:1</ref></char></note><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Nunee Nia eskolante sira komesa hatete ba malu dehan, “Karik Nia koalia hanesan nee tanba ita la lori paun.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Jesus hatene hela saida mak sira koalia. Entaun Nia hatete, “Imi nee fiar fraku! Nusaa mak imi diskuti malu fali kona ba paun? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Imi seidauk kompriende ka? Imi haluha ona paun fuan lima nebee mak Hau fahe ba ema rihun lima ka? Iha tempu nebaa imi tau hamutuk hahaan restu too bote hira?<note caller="+" style="x"><char style="xo" closed="false">16:9: </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">Mateus 14:17-21</ref></char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Depois oinsaa ho paun fuan hitu nebee Hau fahe ba ema rihun haat? Imi tau hamutuk hahaan restu too bote hira?<note caller="+" style="x"><char style="xo" closed="false">16:10: </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">Mateus 15:34-38</ref></char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Nusaa mak ohin Hau temi fermentu, imi hanoin kedas Hau koalia kona ba paun? Laos nunee! Maibee Hau foo hanoin ba imi atu kuidadu ho ema Farizeu ho Saduseu sira nia fermentu.”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Nee mak foin Nia eskolante sira kompriende katak, Nia laos koalia kona ba fermentu nebee mak halo trigu sae. Maibee Nia koalia kona ba ema Farizeu ho Saduseu sira nia hanorin nebee mak lori ema lao sala dalan.<verse eid="MAT 16:12" /></para>
  <para style="s">Pedro rekonhese Nai Jesus mak Mesias</para>
  <para style="r">(<ref loc="MRK 8:27-30">Marcos 8:27-30</ref>; <ref loc="LUK 9:18-21">Lucas 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Depois Jesus baa iha rai ida nebee besik sidade Sezareia Filipi. Too iha nebaa, Nia husu ba Nia eskolante sira dehan, “Tuir ema konta, Hau, Ema Umanu nia Oan nee see?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Sira hataan, “Iha balu dehan, Ita Boot João Sarani Nain. Balu tan dehan, profeta Elias. Seluk tan dehan, Jeremias ka profeta ida seluk.”<note caller="+" style="x"><char style="xo" closed="false">16:14: </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">Mateus 14:1-2</ref>; <ref loc="MRK 6:14-15">Marcos 6:14-15</ref>; <ref loc="LUK 9:7-8">Lucas 9:7-8</ref></char></note><verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Jesus husu tan, “Tuir imi rasik, Hau nee see?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simão Pedro hataan, “Ita Boot nee Mesias, Salvador nebee Maromak promete hori uluk ona atu haruka mai. Ita Boot mak Maromak Moris nia Oan.”<note caller="+" style="x"><char style="xo" closed="false">16:16: </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">João 6:68-69</ref></char></note><verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Jesus dehan, “Simão, Jonas nia oan, o hetan bensaun, tanba laos ema mak foo hatene ba o kona ba buat nee. Maibee Hau nia Aman iha lalehan mak foo hatene ba o. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Hau hatete ba o, Hau bolu o Pedro. (Nee dehan katak ‘fatuk isin’.) Hau sei harii Hau nia povu iha fatuk nee nia leten, hanesan igreja ida nebee hamriik metin, too mate mos la bele manaan sira. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Hau sei foo xavi reinu lalehan nian ba o. Saida mak o bandu iha mundu nee, Maromak iha lalehan mos bandu. I saida mak o foo lisensa atu halo iha mundu nee, Maromak iha lalehan mos foo lisensa.”<note caller="+" style="f"><char style="fr" closed="false">16:19: </char><char style="ft" closed="false">Versikulu nee bele mos tradus hanesan nee: Saida mak o bandu iha mundu nee, Maromak iha lalehan bandu uluk ona. I saida mak o foo lisensa atu halo iha mundu nee, Maromak iha lalehan foo lisensa uluk ona.</char></note> <note caller="+" style="x"><char style="xo" closed="false">16:19: </char><char style="xt" closed="false"><ref loc="MAT 18:18">Mateus 18:18</ref>; <ref loc="JHN 20:23">João 20:23</ref></char></note><verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Depois Jesus bandu Nia eskolante sira atu la bele hatete sai ba see-see deit katak Nia mak Mesias.<verse eid="MAT 16:20" /></para>
  <para style="s">Nai Jesus foo sai katak Nia sei mate i moris fali</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Marcos 8:31—9:1</ref>; <ref loc="LUK 9:22-27">Lucas 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Komesa husi loron nee, Jesus hatete sai ba Nia eskolante sira katak, Nia tenki baa iha Jerusalém i tenki simu terus oi-oin. Nai ulun Judeu sira, nai lulik nia ulun sira ho mestri relijiaun sira sei halo terus Nia. Ema sei oho tiha Nia, maibee too iha loron tolu, Maromak sei halo Nia moris fila fali.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Rona nunee, Pedro dada Jesus ba sorin hodi siak Nia dehan, “Lae, Nai! Maromak sei la foo lisensa atu buat nee akontese.”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Maibee Jesus fila ba Pedro hodi siak fali nia dehan, “Satanás, sees tiha husi Hau nia oin! O atu taka dalan mai Hau! O nia hanoin nee laos mai husi Maromak, maibee mai husi ema nia hanoin.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Depois Jesus dehan ba Nia eskolante sira, “See mak hakarak tuir Hau, nia tenki husik tiha nia hakarak rasik, i tenki prontu simu terus, hanesan ema nebee lori nia krus too mate. I nia tenki tuir Hau nafatin.<note caller="+" style="x"><char style="xo" closed="false">16:24: </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mateus 10:38</ref>; <ref loc="LUK 14:27">Lucas 14:27</ref></char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Tanba see mak hakarak salva nia aan, nia sei lakon fali. I see mak lakon nia moris tanba nia tuir Hau, nia sei hetan moris rohan-laek.<note caller="+" style="x"><char style="xo" closed="false">16:25: </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mateus 10:39</ref>; <ref loc="LUK 17:33">Lucas 17:33</ref>; <ref loc="JHN 12:25">João 12:25</ref></char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Se ema ida hetan riku-soin mundu nian hotu-hotu, maibee too ikus la hetan moris rohan-laek karik, nia manaan saida loos? La iha buat ida mak nia bele foo hodi troka nia klamar. <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Tanba aban-bainrua Hau, Ema Umanu nia Oan sei fila fali mai husi lalehan ho Hau nia Aman nia kbiit tomak, i Nia anju sira haleu Hau. Iha tempu nee mak Hau sei foo justisa ba ema ida-idak tuir saida mak nia halo.<note caller="+" style="x"><char style="xo" closed="false">16:27: </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mateus 25:31</ref>; <ref loc="PSA 62:12">Salmu 62:12</ref>; <ref loc="ROM 2:6">Roma 2:6</ref></char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Hau hatete lo-loos ba imi, husi imi sira nee, balu sei moris too haree Hau, Ema Umanu nia Oan mai ukun nudar Liurai mak foin sira mate.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Nai Jesus nakfilak Aan iha foho leten</para>
  <para style="r">(<ref loc="MRK 9:2-13">Marcos 9:2-13</ref>; <ref loc="LUK 9:28-36">Lucas 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Liu tiha loron neen, Jesus lori Pedro, Tiago ho Tiago nia alin João, sira mes-mesak baa sae ba foho aas ida. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Too iha nebaa, Nia eskolante nain tolu nee haree Jesus nakfilak Aan tiha. Nia oin nabilan hanesan loro matan, i Nia hena sai mutin nabilan. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Derepenti sira mos haree profeta Moisés ho Elias koalia hela ho Jesus.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Haree nunee Pedro dehan ba Jesus, “Nai, ita hamutuk iha nee, furak. Se Nai hakarak, hau halo tenda tolu iha nee, ida ba Ita Boot, ida ba Moisés, ho ida ba Elias.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Pedro sei koalia hela nunee, derepenti kalohan nabilan ida mai falun tiha sira. I lian ida sai husi kalohan nee dehan, “Ida nee Hau nia Oan doben. Nia halo Hau nia laran haksolok teb-tebes. Imi tenki rona Nia!”<note caller="+" style="x"><char style="xo" closed="false">17:5: </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Pedro 1:17-18</ref>; <ref loc="GEN 22:2">Jénesis 22:2</ref>; <ref loc="PSA 2:7">Salmu 2:7</ref>; <ref loc="ISA 42:1">Isaias 42:1</ref>; <ref loc="MAT 3:17">Mateus 3:17</ref>, <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Marcos 1:11</ref>; <ref loc="LUK 3:22">Lucas 3:22</ref>; <ref loc="DEU 18:15">Deuteronómiu 18:15</ref></char></note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Rona lian nee, sira nain tolu tauk teb-tebes, i sira taka rabat iha rai. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Maibee Jesus mai kaer sira hodi dehan, “Hamriik ona! Keta tauk.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Bainhira sira hateke sae, sira la haree tan ema seluk, so Jesus deit.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Hotu tiha Jesus ho Nia eskolante sira tuun fali husi foho. Sira lao tuun dadauk, Jesus bandu dehan, “Saida mak ohin imi haree nee, la bele hatete ba ema ida. Bainhira Maromak halo Hau, Ema Umanu nia Oan moris fali husi mate mak foin imi bele foo sai ba ema.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Depois Nia eskolante sira husu ba Jesus dehan, “Entaun nusaa mak mestri relijiaun sira dehan, Elias tenki mai uluk mak foin Mesias mai?”<note caller="+" style="x"><char style="xo" closed="false">17:10: </char><char style="xt" closed="false"><ref loc="MAL 4:5">Malakias 4:5</ref></char></note><verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Jesus hataan, “Loos duni, Elias mai atu prepara buat hotu-hotu. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Maibee Hau hatete ba imi, Elias mai tiha ona, i ema la hatene nia, too halo aat nia tuir sira nia hakarak. Hau, Ema Umanu nia Oan mos sira sei halo terus hanesan nee.”<note caller="+" style="x"><char style="xo" closed="false">17:12: </char><char style="xt" closed="false"><ref loc="MAT 11:14">Mateus 11:14</ref></char></note><verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Rona nunee, Nia eskolante sira foin kompriende katak Elias ida nebee Jesus konta nee mak João Sarani Nain.<verse eid="MAT 17:13" /></para>
  <para style="s">Nai Jesus duni sai diabu husi labarik ida</para>
  <para style="r">(<ref loc="MRK 9:14-29">Marcos 9:14-29</ref>; <ref loc="LUK 9:37-43a">Lucas 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Bainhira Jesus ho Nia eskolante sira fila fali ba iha ema barak nia leet, iha mane ida mai hakneak iha Jesus nia oin <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />hodi dehan, “Nai, hanoin hau nia oan ba! Nia moras bibi maten, i terus liu. Dala barak nia monu tama ba ahi laran ka bee laran. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Hau lori ona nia ba Ita Boot nia eskolante sira, maibee sira la bele kura nia.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Jesus siak sira hotu dehan, “Imi ema nebee sempre halo aat i la fiar ba Maromak. Hau tenki hela ho imi too bainhira tan? Hau tenki pasiensia ho imi too iha nebee?! Lori labarik nee mai.”<verse eid="MAT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 17:18" />Depois Jesus foo orden ba diabu. Diabu mos sai husi labarik nee, i labarik nee diak kedas.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Bainhira Jesus mesak fali, Nia eskolante sira mai besik hodi husu, “Nusaa mak ami ohin la bele duni sai diabu nee?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Jesus hataan, “Tanba imi nia fiar fraku liu. Hau hatete lo-loos ba imi, se imi nia fiar kiikoan hanesan mostarda musan ida mos, imi bele foo orden ba foho ida dehan, ‘Muda husi nee, baa iha nebaa.’ I foho nee sei muda duni. Imi atu halo saida deit, bele.<note caller="+" style="x"><char style="xo" closed="false">17:20: </char><char style="xt" closed="false"><ref loc="MAT 21:21">Mateus 21:21</ref>; <ref loc="MRK 11:23">Marcos 11:23</ref>; <ref loc="1CO 13:2">1 Korintu 13:2</ref></char></note> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Maibee atu duni sai diabu hanesan ida ohin nee, imi tenki halo orasaun i halo jejun.]”<note caller="+" style="f"><char style="fr" closed="false">17:21: </char><char style="ft" closed="false">Kopia evanjelhu Mateus husi tempu antigu barak. Versikulu 21 nee tama iha kopia nee balu, maibee iha kopia nebee antigu liu la tama.</char></note><verse eid="MAT 17:21" /></para>
  <para style="s">Nai Jesus koalia tan kona ba Nia mate</para>
  <para style="r">(<ref loc="MRK 9:30-32">Marcos 9:30-32</ref>; <ref loc="LUK 9:43b-45">Lucas 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Iha loron ida, Jesus ho Nia eskolante sira halibur hamutuk iha provinsia Galileia. Iha nebaa Jesus hatete ba sira, “Aban-bainrua ema sei faan Hau, Ema Umanu nia Oan ba ema aat. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Sira sei oho Hau, maibee iha loron tolu Maromak sei halo Hau moris fali husi mate.” Rona nunee, Nia eskolante sira tristi loos.<verse eid="MAT 17:23" /></para>
  <para style="s">Nai Jesus selu impostu ba uma kreda boot</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Jesus ho Nia eskolante sira too iha sidade Kafarnaum. Iha nebaa kobrador impostu balu mai husu Simão Pedro dehan, “O nia mestri baibain selu impostu ba iha uma kreda boot ka lae?”<note caller="+" style="x"><char style="xo" closed="false">17:24: </char><char style="xt" closed="false"><ref loc="EXO 30:13">Ézodu 30:13</ref>, <ref loc="EXO 38:26">38:26</ref></char></note><verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Pedro hataan, “Nia selu.”</para>
  <para style="p" vid="MAT 17:25">Bainhira Pedro tama ba uma laran, Jesus husu kedas nia dehan, “Simão, hanoin took. Liurai sira iha mundu nee husu impostu husi see? Husi sira nia oan rasik ka husi ema seluk?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Pedro hataan, “Husi ema seluk.”</para>
  <para style="p" vid="MAT 17:26">Jesus dehan, “Se nunee, liurai nia oan rasik la selu ida. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Maibee atu sira la bele laran moras ba ita tanba deit ita la selu impostu nee, o baa kail ikan iha tasi. Ikan primeiru nebee o hetan, loke tiha nia ibun, foin foti osan mutin ida iha ikan nee nia ibun laran. Osan nee too atu selu ita nain rua nia impostu.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ema nebee mak boot liu iha Maromak nia reinu</para>
  <para style="r">(<ref loc="MRK 9:33-37">Marcos 9:33-37</ref>, <ref loc="MRK 9:42-48">9:42-48</ref>; <ref loc="LUK 9:46-48">Lucas 9:46-48</ref>, <ref loc="LUK 17:1-2">17:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Iha tempu nebaa Jesus nia eskolante sira mai husu Nia dehan, “Ema nebee mak boot liu iha Maromak nia reinu?”<note caller="+" style="x"><char style="xo" closed="false">18:1: </char><char style="xt" closed="false"><ref loc="LUK 22:24">Lucas 22:24</ref></char></note><verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Entaun Jesus bolu labarik ida mai hamriik iha sira nia klaran, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />i Nia dehan ba sira, “Hau hatete lo-loos ba imi, see mak atu sai Maromak nia reinu, nia tenki muda nia moris hodi sai hanesan labarik kiik ida. Se lae, la bele.<note caller="+" style="x"><char style="xo" closed="false">18:3: </char><char style="xt" closed="false"><ref loc="MRK 10:15">Marcos 10:15</ref>; <ref loc="LUK 18:17">Lucas 18:17</ref></char></note> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Nunee see mak haraik aan nudar labarik nee, nia mak boot liu iha Maromak nia reinu.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />See mak simu labarik ida hanesan nee hodi Hau nia naran, nia simu Hau. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Maibee see mak halo labarik kiik ida monu ba sala too la fiar mai Hau, ema nee sei simu kastigu todan. Ba nia, diak liu ema kesi fatuk boot ida iha nia kakorok depois soe nia tama ba tasi laran! Tanba kastigu nebee nia sei simu todan liu fali ida nee. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Koitadu, mundu nee sei terus tanba iha buat barak mak halo ema monu ba sala. Loos duni, buat hanesan nee sempre iha. Maibee see mak lori ema seluk atu monu ba sala, nia sei terus.<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Se o nia liman ka o nia ain halo o monu ba sala karik, tesi i soe tiha. Diak liu o tama iha lalehan ho liman ka ain sorin deit duke o tama ba iha infernu ho liman-ain kompletu.<note caller="+" style="x"><char style="xo" closed="false">18:8: </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mateus 5:30</ref></char></note> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Se o nia matan halo o monu ba sala karik, sukit sai tiha o nia matan nee i soe tiha. Diak liu o tama ba iha lalehan ho matan sorin deit duke o tama ba iha infernu ho matan kompletu.”<note caller="+" style="x"><char style="xo" closed="false">18:9: </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mateus 5:29</ref></char></note><verse eid="MAT 18:9" /></para>
  <para style="s">Bibi malae nebee lakon</para>
  <para style="r">(<ref loc="LUK 15:3-7">Lucas 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“Kuidadu, keta hanoin dehan ema kiik sira nee la iha folin, atu hatuun ema kiik ida mos la bele. Hau hatete ba imi, anju sira iha lalehan nebee mak tau matan ba sira sempre hamriik iha Hau nia Aman iha lalehan nia oin hodi husu atu tulun ema kiik sira nee.<verse eid="MAT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11" />[Hau, Ema Umanu nia Oan mai atu salva ema nebee mak lao sala dalan.]<note caller="+" style="f"><char style="fr" closed="false">18:11: </char><char style="ft" closed="false">Kopia evanjelhu Mateus husi tempu antigu barak. Kopia balu hakerek versikulu nee, maibee kopia antigu liu lae.</char></note> <note caller="+" style="x"><char style="xo" closed="false">18:11: </char><char style="xt" closed="false"><ref loc="LUK 19:10">Lucas 19:10</ref></char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Imi nia hanoin oinsaa? Se ema ida iha bibi atus ida, depois bibi ida lao sala dalan, bibi nain sei halo saida? Nia sei husik hela bibi sia-nulu resin sia iha foho, i baa buka tuir bibi ida nebee lao sala dalan nee. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Hau dehan lo-loos ba imi, kuandu nia hetan ona bibi nee, nia kontenti liu ho bibi ida nee duke bibi sia-nulu resin sia seluk nebee nunka lao sala dalan. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Nunee mos imi nia Aman iha lalehan, Nia lakohi atu ema ida lakon, atu ema kiik ida lakon mos Nia lakohi.”<verse eid="MAT 18:14" /></para>
  <para style="s">Oinsaa ita diak malu ho ema nebee mak halo sala hasoru ita</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Jesus hatutan tan dehan, “Se o nia maluk ida halo sala hasoru o, baa koalia ho nia hodi foo hatene nia sala, maibee imi nain rua deit, la bele iha ema nia oin. Se nia simu o nia liafuan, entaun o diak malu fali ho nia.<note caller="+" style="x"><char style="xo" closed="false">18:15: </char><char style="xt" closed="false"><ref loc="LUK 17:3">Lucas 17:3</ref></char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Maibee se nia lakohi rona o, entaun lori ema ida-rua baa koalia tan ho nia, atu sira sai sasin ba buat nebee imi koalia. Tanba iha Livru Sagradu hakerek dehan, ‘Tenki iha sasin nain rua ka tolu mak foin bele tesi lia.’<note caller="+" style="x"><char style="xo" closed="false">18:16: </char><char style="xt" closed="false"><ref loc="DEU 19:15">Deuteronómiu 19:15</ref></char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Se nia lakohi rona imi, baa foo hatene Maromak nia povu. Se Maromak nia povu mos nia lakohi rona, lalika liga nia, konsidera nia hanesan kobrador impostu ida ka ema ida nebee mak la konhese Maromak.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Hau hatete lo-loos ba imi, saida mak imi bandu iha mundu nee, Maromak iha lalehan mos bandu. I saida mak imi foo lisensa atu halo iha mundu nee, Maromak iha lalehan mos foo lisensa.<note caller="+" style="f"><char style="fr" closed="false">18:18: </char><char style="ft" closed="false">Versikulu nee bele mos tradus hanesan nee: Saida mak imi bandu iha mundu nee, Maromak iha lalehan bandu uluk ona. I saida mak imi foo lisensa atu halo iha mundu nee, Maromak iha lalehan foo lisensa uluk ona.</char></note> <note caller="+" style="x"><char style="xo" closed="false">18:18: </char><char style="xt" closed="false"><ref loc="MAT 16:19">Mateus 16:19</ref>; <ref loc="JHN 20:23">João 20:23</ref></char></note><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Iha tan buat ida mak Hau hakarak hatete: Husi imi sira nee, se iha nain rua mak lian ida iha mundu nee hodi husu buat ruma ba Hau nia Aman iha lalehan, entaun Nia sei foo. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Tanba se iha ema nain rua ka tolu halibur hamutuk hodi Hau nia naran, Hau mos iha sira nia klaran.”<verse eid="MAT 18:20" /></para>
  <para style="s">Komparasaun kona ba funsionariu nebee lakohi perdua nia maluk</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Depois Pedro mai husu Jesus, “Nai, se hau nia maluk halo sala fila-fila hasoru hau karik, hau tenki perdua nia dala hira? Too dala hitu ka?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Jesus hataan, “Lae, laos dala hitu deit! Maibee o tenki perdua nia fila-fila too hitu-nulu dala hitu.<note caller="+" style="f"><char style="fr" closed="false">18:22: </char><char style="ft" closed="false">Iha nee bele tradus dehan “70 dala 7”, bele mos “dala 77”.</char></note> <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Tanba Maromak ukun nudar Liurai hanesan komparasaun nee: Iha loron ida, liurai ida hakarak sura tuir nia osan nebee mak nia funsionariu sira deve. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Bainhira nia hahuu sura, iha ema balu lori nia funsionariu ida mai. Funsionariu nee deve osan mean bornal rihun sanulu. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Maibee funsionariu nee la iha kbiit atu selu. Entaun liurai foo orden ba nia soldadu sira atu baa faan tiha ema nee, nia feen ho oan sira ho mos nia riku-soin hotu.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />Rona nunee, funsionariu nee hakneak hakruuk too rai iha liurai nia ain hodi husu dehan, ‘Favor ida, foo tempu mai hau! Hau sei selu hotu hau nia tusan nee.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Liurai hanoin loos nia, too hamoos tiha nia tusan hotu hodi husik nia baa ho livre.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Bainhira funsionariu nee sai mai, nia hetan nia maluk funsionariu ida nebee mak deve nia osan mutin atus ida deit. Nia baa kaer ema nee i buti nia kakorok hodi sisi dehan, ‘O tenki selu hotu o nia tusan nee!’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Rona nunee, nia maluk funsionariu nee hakneak hakruuk too rai hodi husu dehan, ‘Favor ida, foo tempu mai hau! Hau sei selu hau nia tusan nee.’<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />Maibee funsionariu nee la simu, nia sulan nia maluk nee ba iha komarka too selu hotu nia tusan. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Bainhira liurai nia funsionariu sira seluk haree, sira nia laran susar teb-tebes i sira baa kesar iha liurai.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />Depois liurai bolu funsionariu nee hodi dehan, ‘Funsionariu laran aat! O nia tusan hau hamoos hotu tiha ona tanba o hakneak hodi husu mai hau. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Hau hatudu tiha ona laran luak ba o. Nusaa mak o la hatudu laran luak ba o nia maluk nee?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Liurai nee hirus teb-tebes too haruka ema baa lori funsionariu aat nee kastigu iha komarka laran too selu hotu nia tusan.”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Jesus taka Nia istoria dehan, “Hau nia Aman iha lalehan mos sei halo nunee ba imi ida-idak, se imi la perdua imi nia maluk ho laran tomak.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Farizeu sira husu kona ba feen-laen soe malu</para>
  <para style="r">(<ref loc="MRK 10:1-12">Marcos 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Jesus hanorin hotu tiha, Nia lao sai husi Galileia hodi baa iha provinsia Judeia iha mota Jordaun nia sorin ba. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ema barak teb-tebes tuir Nia, i Nia kura sira nia moras.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Depois ema balu husi grupu Farizeu mai koko atu hamonu Nia. Sira husu dehan, “Tuir Moisés nia lei, laen soe nia feen ho razaun saida deit, bele ka lae?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Jesus hataan, “Imi la lee iha Livru Sagradu kona ba Maromak halo ema ka? Iha nebaa hakerek dehan, ‘Nia halo sira mane ho feto.’<note caller="+" style="x"><char style="xo" closed="false">19:4: </char><char style="xt" closed="false"><ref loc="GEN 1:27">Jénesis 1:27</ref>, <ref loc="GEN 5:2">5:2</ref></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />I hakerek tan dehan,</para>
  <para style="q1" vid="MAT 19:5">‘Tanba nee, mane sei husik nia inan-aman</para>
  <para style="q2" vid="MAT 19:5">hodi baa moris neon ida laran ida ho nia feen,</para>
  <para style="q3" vid="MAT 19:5">i sira nain rua sai ona ida.’<note caller="+" style="x"><char style="xo" closed="false">19:5: </char><char style="xt" closed="false"><ref loc="GEN 2:24">Jénesis 2:24</ref></char></note><verse eid="MAT 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 19:6" />Entaun sira laos ona ema nain rua, maibee sai ona ida. Nee duni se Maromak tau feto ho mane hamutuk sai feen-laen ona, ema keta fahe fali.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Depois ema Farizeu sira nee husu fali ba Jesus, “Se nunee, nusaa mak Moisés dehan, laen bele soe nia feen, naran katak nia foo surat deklarasaun soe malu nian?”<note caller="+" style="x"><char style="xo" closed="false">19:7: </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Deuteronómiu 24:1-4</ref>; <ref loc="MAT 5:31">Mateus 5:31</ref></char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Jesus hataan, “Moisés nia lei foo lisensa atu imi soe imi nia feen tanba imi nia ulun toos. Maibee fo-foun Maromak halo lalehan ho rai laos nunee. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Hau hatete ba imi, mane so bele soe nia feen kuandu nia feen halo ona sala seksual ho ema seluk. Se nia feen la halo sala nee, maibee mane nee soe nia hodi hola fali feto seluk, mane nee halo sala seksual.”<note caller="+" style="x"><char style="xo" closed="false">19:9: </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mateus 5:32</ref>; <ref loc="1CO 7:10-11">1 Korintu 7:10-11</ref></char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Rona nunee, Jesus nia eskolante sira dehan, “Se hanesan nee, diak liu lalika kaben.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Jesus hataan, “Laos ema hotu-hotu mak bele simu liafuan nee. So ema nebee Maromak foo kbiit ba sira mak bele simu. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Iha ema balu la kaben tanba moris mai sira la bele duni. Iha ema balu la kaben tanba ema seluk mak halo sira nunee. Iha mos ema balu la kaben tanba sira hakarak foo aan tomak atu serbi Maromak nudar Liurai. See mak bele simu liafuan nee, simu ba.”<verse eid="MAT 19:12" /></para>
  <para style="s">Nai Jesus foo bensaun ba labarik</para>
  <para style="r">(<ref loc="MRK 10:13-16">Marcos 10:13-16</ref>; <ref loc="LUK 18:15-17">Lucas 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Depois ema balu mai lori labarik ba Jesus atu Nia tau liman ba sira hodi husu Maromak foo bensaun ba sira. Maibee Jesus nia eskolante sira bandu. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Entaun Jesus siak Nia eskolante sira dehan, “Husik labarik sira nee mai iha Hau, la bele bandu. Tanba ema hanesan labarik sira nee mak sai Maromak nia reinu.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Nia tau liman ba labarik sira nee, depois Nia sai husi nebaa.<verse eid="MAT 19:15" /></para>
  <para style="s">Ema riku nebee hakarak tama lalehan</para>
  <para style="r">(<ref loc="MRK 10:17-31">Marcos 10:17-31</ref>; <ref loc="LUK 18:18-30">Lucas 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Iha loron ida, iha mane joven ida mai husu Jesus dehan, “Mestri, hau tenki halo buat diak saida para hau bele hetan moris rohan-laek?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Jesus hataan dehan, “Nusaa mak ita husu mai Hau kona ba saida mak diak? So Maromak deit mak diak. Se ita hakarak hetan moris rohan-laek, halo tuir Nia ukun fuan.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Joven nee husu fali, “Ukun fuan nebee?”</para>
  <para style="p" vid="MAT 19:18">Jesus hataan, “La bele oho ema, la bele halo sala ho ema nia kaben, la bele naok, la bele foo sasin falsu,<note caller="+" style="x"><char style="xo" closed="false">19:18: </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">Ézodu 20:13-16</ref>; <ref loc="DEU 5:17-20">Deuteronómiu 5:17-20</ref></char></note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />respeita o nia inan-aman, i hadomi o nia maluk hanesan o hadomi o nia aan rasik.”<note caller="+" style="x"><char style="xo" closed="false">19:19: </char><char style="xt" closed="false"><ref loc="EXO 20:12">Ézodu 20:12</ref>; <ref loc="DEU 5:16">Deuteronómiu 5:16</ref>; <ref loc="LEV 19:18">Levítiku 19:18</ref></char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Joven nee hataan dehan, “Ukun fuan sira nee hau halo tuir hotu ona. Saida mak sei falta?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Jesus hataan, “Se ita hakarak moris kompletu, entaun baa faan tiha ita nia riku-soin hotu, i osan nee fahe ba ema kiak. Nunee mak ita sei hetan fali riku-soin iha lalehan. Fahe hotu tiha, mai tuir Hau.”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Bainhira joven nee rona nunee, nia fila ho laran susar tanba nia riku teb-tebes.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Depois Jesus dehan ba Nia eskolante sira, “Hau hatete lo-loos ba imi, susar teb-tebes ema riku ida atu sai Maromak nia reinu. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Dala ida tan Hau dehan ba imi, kuda kamelu tama liu husi daun kuak susar teb-tebes. Maibee susar liu tan, ema riku ida atu sai Maromak nia reinu hodi hakruuk ba Nia nudar Liurai.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Bainhira Jesus nia eskolante sira rona nunee, sira admira teb-tebes hodi husu, “Se nunee, see loos mak sei hetan salvasaun?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Jesus hateke ba sira hodi dehan, “Ba ema, la bele duni. Maibee ba Maromak, buat hotu-hotu bele.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Depois Pedro dehan, “Ami husik tiha ona buat hotu-hotu hodi tuir Ita Boot. Entaun ami sei hetan saida?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Jesus hatete ba sira, “Hau dehan lo-loos ba imi, iha mundu foun Hau, Ema Umanu nia Oan sei tuur iha kadeira ukun, i naroman lalehan nian haleu hela Hau. Imi sira nebee agora tuir Hau, imi mos sei tuur iha kadeira ukun sanulu resin rua hodi ukun Israel nia suku sanulu resin rua hotu.<note caller="+" style="x"><char style="xo" closed="false">19:28: </char><char style="xt" closed="false"><ref loc="MAT 25:31">Mateus 25:31</ref>; <ref loc="LUK 22:30">Lucas 22:30</ref></char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />See mak husik ona nia uma, nia maun-alin, nia inan-aman, nia oan sira ka nia toos tanba nia tuir Hau, ema nee sei simu fali dala atus ida i sei hetan moris rohan-laek. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Maibee ema barak nebee agora boot sei sai kiik. I ema barak nebee agora kiik sei sai boot.”<note caller="+" style="x"><char style="xo" closed="false">19:30: </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mateus 20:16</ref>; <ref loc="LUK 13:30">Lucas 13:30</ref></char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Komparasaun kona ba ema nebee servisu iha toos uvas nian</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Maromak ukun nudar Liurai, nee hanesan komparasaun tuir mai: Iha toos nain ida, dadeer-saan deit nia baa iha merkadu hodi buka ema atu servisu iha nia toos uvas nian. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Hetan tiha ema, nia konkorda malu ho sira atu selu loron ida osan mutin ida, i nia haruka sira baa servisu kedas iha nia toos.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Tuku sia dadeer, toos nain baa fali merkadu, nia haree tan ema balu hamriik hela, la halo buat ida. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Nia hatete ba sira, ‘Imi baa servisu iha hau nia toos, hau sei selu imi ho lo-loos.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />I sira mos baa.</para>
  <para style="p" vid="MAT 20:5">Tuku sanulu resin rua, toos nain sai baa bolu tan ema seluk. Nunee mos tuku tolu lokraik. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Tuku lima mos, nia baa merkadu, hetan ema seluk tan nebee hamriik hela deit. Nia husu sira, ‘Nusaa mak loron tomak imi hamriik iha nee deit, la halo buat ida?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Sira hataan, ‘La iha ema ida mak foo servisu mai ami.’</para>
  <para style="p" vid="MAT 20:7">Toos nain dehan, ‘Se nunee, imi baa servisu iha hau nia toos deit.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Rai besik kalan ona, nia hatete ba mandor dehan, ‘Baa bolu ema sira nebee mak servisu iha toos hodi selu sira ida-ida. Maibee selu uluk ema sira nebee mak tama ikus. Sira nebee mak tama uluk, selu ikus.’<note caller="+" style="x"><char style="xo" closed="false">20:8: </char><char style="xt" closed="false"><ref loc="LEV 19:13">Levítiku 19:13</ref>; <ref loc="DEU 24:15">Deuteronómiu 24:15</ref></char></note><verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Nunee mandor bolu uluk ema nebee mak mai servisu iha tuku lima lokraik, i sira ida-ida simu osan mutin ida. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Entaun ema sira nebee mak mai servisu husi dadeer-saan hanoin katak sira atu simu barak liu fali. Afinal sira mos simu osan mutin ida. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Bainhira sira simu hotu sira nia osan, ema nebee mak tama servisu husi dadeer nee mai murmura ba toos nain <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />dehan, ‘Sira nebee mai ikus servisu oras ida deit. Nusaa mak sira simu osan hanesan fali ho ami? Ami nee servisu mate aan husi dadeer too lokraik, loron manas mos ami servisu nafatin.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Rona nunee, toos nain nee hataan ba ema ida husi sira dehan, ‘Belun, hau la halo sala hasoru o. Ita konkorda malu tiha ona katak, o atu simu osan mutin ida iha loron ida, loos ka lae? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Foti o nia osan nee hodi fila ona. Hau hakarak atu ema nebee tama servisu ikus mos simu osan hanesan ho imi. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Nee hau nia osan. Hau iha direitu atu uza tuir hau nia hakarak. Keta halo be o laran moras ba hau tanba hau halo buat diak ba ema seluk.’ ”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Jesus taka Nia liafuan dehan, “Nunee mos ema nebee mak ikus aban-bainrua sai fali primeiru. I ema nebee mak primeiru sai fali ikus.”<note caller="+" style="x"><char style="xo" closed="false">20:16: </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mateus 19:30</ref>; <ref loc="MRK 10:31">Marcos 10:31</ref>; <ref loc="LUK 13:30">Lucas 13:30</ref></char></note><verse eid="MAT 20:16" /></para>
  <para style="s">Nai Jesus koalia ba dala tolu kona ba Nia mate</para>
  <para style="r">(<ref loc="MRK 10:32-34">Marcos 10:32-34</ref>; <ref loc="LUK 18:31-34">Lucas 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Jesus lao dadauk ba sidade Jerusalém, Nia halibur Nia eskolante nain sanulu resin rua hamutuk hodi koalia ba sira deit dehan, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Rona mai! Ita lao dadauk ba Jerusalém. Too iha nebaa, ema sei entrega Hau, Ema Umanu nia Oan ba iha nai lulik nia ulun sira ho mestri relijiaun sira. Ema sira nee sei tesi Hau nia lia katak, Hau tenki hetan kastigu mate. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Sira sei entrega Hau ba iha ema nebee la fiar Maromak. I ema sira nee sei tarata Hau, baku Hau ho sikoti, i prega Hau iha krus. Maibee iha loron tolu Maromak sei halo Hau moris fali husi mate.”<verse eid="MAT 20:19" /></para>
  <para style="s">Tiago ho João nia inan husu atu sira sai ema boot</para>
  <para style="r">(<ref loc="MRK 10:35-45">Marcos 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Depois Zebedeu nia feen mai hamutuk ho nia oan Tiago ho João. Senhora nee mai hakneak iha Jesus nia oin hodi husu atu Jesus foo buat ruma ba nia.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Jesus husu, “Senhora hakarak saida?”</para>
  <para style="p" vid="MAT 20:21">Senhora nee hataan, “Hau husu atu aban-bainrua kuandu Ita Boot ukun nudar Liurai, hau nia oan nain rua nee, ida tuur iha Ita Boot nia sorin loos, ida iha sorin karuk.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Maibee Jesus hatete ba Tiago ho João dehan, “Imi la kompriende saida mak imi husu. La kleur tan Hau sei simu terus todan. Imi mos prontu simu terus nee ka lae?”<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">Tradusaun literal dehan, “Imi bele hemu husi kopu nebee Hau atu hemu ka?” Iha Biblia, “hemu husi kopu” dala barak signifika hetan terus.</char></note></para>
  <para style="p" vid="MAT 20:22">Sira hataan, “Ami prontu.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Jesus hatete ba sira, “Loos duni, imi sei simu duni terus hanesan Hau. Maibee Hau la iha direitu atu hili see mak atu tuur iha Hau nia sorin loos ho sorin karuk. Kona ba ida nee, Hau nia Aman iha lalehan desidi tiha ona.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Bainhira eskolante nain sanulu rona buat nebee mak Tiago ho João husu, sira hirus maun-alin nain rua nee. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Entaun, Jesus bolu sira hamutuk hodi dehan, “Imi hatene katak, iha nasaun sel-seluk, nai ulun sira manda ema tuun-sae, i ukun nain sira hanehan sira nia povu.<note caller="+" style="x"><char style="xo" closed="false">20:25: </char><char style="xt" closed="false"><ref loc="LUK 22:26">Lucas 22:26</ref></char></note> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Maibee imi la bele halo hanesan nee. Husi imi sira nee, see mak hakarak sai boot, nia tenki haraik aan hodi serbi nia maluk sira seluk. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />See mak hakarak sai ema boot liu, nia tenki sai atan ba nia maluk sira seluk hodi serbi sira.<note caller="+" style="x"><char style="xo" closed="false">20:26-27: </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mateus 23:11</ref>; <ref loc="MRK 9:35">Marcos 9:35</ref>; <ref loc="LUK 22:26">Lucas 22:26</ref></char></note> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Nia tenki hanesan Hau, Ema Umanu nia Oan. Hau mai iha mundu nee laos atu ema serbi Hau. Maibee Hau mai atu serbi ema seluk i foo Aan ba mate atu ema barak hetan liberdade.”<verse eid="MAT 20:28" /></para>
  <para style="s">Nai Jesus kura ema matan delek nain rua</para>
  <para style="r">(<ref loc="MRK 10:46-52">Marcos 10:46-52</ref>; <ref loc="LUK 18:35-43">Lucas 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Depois Jesus ho nia eskolante sira sai husi sidade Jerikó, i ema lubun boot mos tuir Nia. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Iha nebaa iha ema matan delek nain rua tuur hela iha dalan ninin. Bainhira sira rona katak Jesus mak liu, sira bolu ho lian makaas dehan, “Nai, liurai David nia Jerasaun, hanoin ami ba!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ema lubun boot nee siak sira nain rua hodi haruka sira nonook. Maibee sira nain rua bolu makaas liu tan dehan, “Nai, liurai David nia Jerasaun, hanoin ami ba!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Rona nunee, Jesus mos para, i Nia bolu sira mai hodi husu, “Imi hakarak Hau halo saida ba imi?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Sira hataan, “Nai, ami hakarak haree.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Rona nunee, Jesus hanoin sira nain rua. Nia tau liman ba sira nia matan, i sira haree kedas. Depois sira tuir Jesus.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Ema barak haklalak simu Nai Jesus tama iha Jerusalém</para>
  <para style="r">(<ref loc="MRK 11:1-11">Marcos 11:1-11</ref>; <ref loc="LUK 19:28-40">Lucas 19:28-40</ref>; <ref loc="JHN 12:12-19">João 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Bainhira Jesus ho Nia eskolante sira besik ona sidade Jerusalém, sira too iha aldeia Betfagé iha foho Oliveira nia lolon, Nia haruka Nia eskolante nain rua baa uluk. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Nia dehan ba sira, “Imi baa iha aldeia nebaa. Bainhira imi tama, imi hetan kedas kuda buru inan ida kesi hela, nia oan iha hela nia sorin. Imi kore tiha dada mai. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Se iha ema ruma husu imi karik, foo hatene dehan, ‘Nai mak presiza.’ Ema nee sei haruka imi dada kedas kuda buru nee.”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Nee tuir saida mak Maromak koalia liu husi Nia profeta hori uluk kedas dehan,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Hatete ba Jerusalém oan sira nunee:<note caller="+" style="f"><char style="fr" closed="false">21:5: </char><char style="ft" closed="false">Mateus hakerek dehan, “Siaun nia oan feto”. Siaun nee Jerusalém nia naran seluk.</char></note></para>
  <para style="q2" vid="MAT 21:5">‘Haree ba, imi nia Liurai mai iha imi.</para>
  <para style="q1" vid="MAT 21:5">Nia mai ho haraik Aan,</para>
  <para style="q2" vid="MAT 21:5">sae deit kuda buru oan.’ ”<note caller="+" style="x"><char style="xo" closed="false">21:5: </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Zacarias 9:9</ref></char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Depois eskolante nain rua nee baa halo tuir saida mak Jesus haruka. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Sira dada kuda buru inan nee ho nia oan lori ba Jesus. Too iha nebaa, sira hasai sira nia hena tau ba iha kuda nia kotuk, depois Jesus sae. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ema barak hasai sira nia hena hodi nahe tu-tuir dalan. Iha mos ema balu taa ramus latan tuir dalan. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ema balu lao uluk iha Jesus nia oin, iha balu lao husi kotuk. Sira hotu haklalak hahii Maromak dehan,</para>
  <para style="q1" vid="MAT 21:9">“Hosana, liurai David nia Jerasaun!</para>
  <para style="q2" vid="MAT 21:9">Maromak foo bensaun ba Ida nebee mak mai lori Nai Maromak nia naran.</para>
  <para style="q1" vid="MAT 21:9">Hosana,</para>
  <para style="q2" vid="MAT 21:9">hahii Nia iha fatin aas liu!”<note caller="+" style="x"><char style="xo" closed="false">21:9: </char><char style="xt" closed="false"><ref loc="PSA 118:26">Salmu 118:26</ref></char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Bainhira Jesus tama iha Jerusalém, ema hotu iha sidade nee hakfodak hodi husu malu tuun-sae dehan, “Ema nee see loos?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Ema barak nebee mak lao hamutuk ho Jesus nee hataan dehan, “Nia nee Jesus, Maromak nia Profeta husi Nazaré iha provinsia Galileia.”<verse eid="MAT 21:11" /></para>
  <para style="s">Nai Jesus duni sai kontratu nain sira husi uma kreda boot</para>
  <para style="r">(<ref loc="MRK 11:15-19">Marcos 11:15-19</ref>; <ref loc="LUK 19:45-48">Lucas 19:45-48</ref>; <ref loc="JHN 2:13-22">João 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Depois Jesus tama iha area uma kreda boot nian, Nia duni sai ema sira nebee mak halo kontratu iha fatin nee. Nia baku fila tiha meza nebee mak ema uza hodi troka osan, banku nebee mak ema tuur hodi faan manu pombu mos Nia baku fila hotu. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Nia siak sira dehan, “Iha Maromak nia liafuan hakerek tiha ona dehan, ‘Tuir lo-loos Hau nia uma nee fatin para halo orasaun.’ Maibee imi halo fali hanesan ema naok-teen sira nia subar fatin.”<note caller="+" style="x"><char style="xo" closed="false">21:13: </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isaias 56:7</ref>; <ref loc="JER 7:11">Jeremias 7:11</ref></char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Hotu tiha, ema matan delek ho ema ain aat sira mai hasoru Jesus iha area uma kreda boot nee, i Nia kura sira hotu. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Bainhira nai lulik nia ulun sira ho mestri relijiaun sira haree milagre nebee mak Jesus halo, sira hirus. Sira mos hirus tanba labarik sira haklalak dehan, “Hosana, liurai David nia Jerasaun!” <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Nunee sira hasee Jesus dehan, “Labarik sira haklalak saida ba O nee?! O la rona ka?”</para>
  <para style="p" vid="MAT 21:16">Jesus hataan, “Hau rona. Maibee iha Livru Sagradu dehan, ‘Maromak, Ita Boot hanorin labarik sira ho kiikoan sira nebee sei susu hela atu hahii Ita Boot.’ Liafuan nee imi la lee ka?”<note caller="+" style="x"><char style="xo" closed="false">21:16: </char><char style="xt" closed="false"><ref loc="PSA 8:3">Salmu 8:3</ref></char></note><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Depois Jesus husik tiha sira hodi baa fali iha aldeia Betánia, i Nia hela iha nebaa kalan ida.<verse eid="MAT 21:17" /></para>
  <para style="s">Nai Jesus foo malisan ba ai huun nebee la foo fuan</para>
  <para style="r">(<ref loc="MRK 11:12-14">Marcos 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Aban dadeer-saan fali, Jesus fila ba iha Jerusalém. Iha dalan Nia hamlaha. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Nia haree ai figeira huun ida iha dalan ninin, i Nia baa besik ai huun nee hodi buka nia fuan. Maibee la iha, tahan deit mak iha. Haree nunee, Jesus hatete ba ai huun nee dehan, “O sei la foo fuan tan!” Derepenti ai nee namlaik tiha.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Bainhira Jesus nia eskolante sira haree, sira admira hodi husu dehan, “Nusaa mak ai huun nee namlaik tiha derepenti hanesan nee?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Jesus hataan, “Hau hatete lo-loos ba imi, se imi nia fiar la nakdoko maibee metin nafatin, entaun imi mos bele halo saida mak Hau halo tiha ona ba ai figeira huun nee. Laos ida nee deit, maibee imi mos bele haruka foho nee muda ba iha tasi laran, i sei muda duni.<note caller="+" style="x"><char style="xo" closed="false">21:21: </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mateus 17:20</ref>; <ref loc="1CO 13:2">1 Korintu 13:2</ref></char></note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Saida deit mak imi husu liu husi orasaun, imi sei hetan, naran katak imi fiar.”<verse eid="MAT 21:22" /></para>
  <para style="s">Nai ulun Judeu husu, see mak foo direitu ba Nai Jesus</para>
  <para style="r">(<ref loc="MRK 11:27-33">Marcos 11:27-33</ref>; <ref loc="LUK 20:1-8">Lucas 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Jesus tama iha area uma kreda boot hodi hanorin iha nebaa. Nia sei hanorin hela, nai lulik nia ulun sira ho katuas lia nain sira mai husu dehan, “O iha direitu saida para halo buat sira nee? See mak foo direitu nee ba O?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Jesus hataan, “Hau mos atu husu buat ida. Se imi hataan ho lo-loos mak Hau foo hatene imi, see mak foo direitu mai Hau hodi halo buat sira nee. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Hau nia pergunta mak nee: See mak foo direitu ba João Sarani Nain hodi foo sarani ema? Maromak mak foo ka, ema mak foo?”</para>
  <para style="p" vid="MAT 21:25">Sira diskuti malu dehan, “Ita susar ona. Se ita hataan, ‘Maromak mak foo direitu ba nia’, Jesus sei husu fali ita dehan, ‘Entaun, nusaa mak imi la fiar ba nia?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Maibee se ita dehan, ‘Ema mak foo direitu’, entaun ita tauk povu, tanba povu sira hanoin dehan, João nee Maromak nia profeta ida.”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Nunee sira hataan dehan, “Ami la hatene.”</para>
  <para style="p" vid="MAT 21:27">Jesus dehan ba sira, “Se nunee, Hau mos la hatete ba imi, see mak foo direitu mai Hau hodi halo buat sira nee.”<verse eid="MAT 21:27" /></para>
  <para style="s">Komparasaun kona ba aman ida ho nia oan nain rua</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Depois Jesus hatete ba nai ulun relijiaun sira dehan, “Imi hanoin took komparasaun nebee Hau atu koalia nee. Iha senhor ida iha oan mane nain rua. Loron ida nia hatete ba nia oan mane boot dehan, ‘Oan, loron ida nee o baa servisu iha toos uvas nian.’<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />Nia oan mane boot hataan, ‘Hau lakohi.’ Maibee too ikus nia arepende i baa duni servisu iha toos.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />Depois senhor nee haruka tan nia oan kiik atu baa servisu iha toos.</para>
  <para style="p" vid="MAT 21:30">Nia oan mane kiik hataan, ‘Diak apaa, hau sei baa.’ Maibee too ikus nia la baa.”<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />Konta tiha hotu, Jesus husu ba sira dehan, “Tuir imi nia hanoin, oan ida nebee mak halo tuir nia aman nia hakarak?”</para>
  <para style="p" vid="MAT 21:31">Sira hataan, “Oan mane boot.”</para>
  <para style="p" vid="MAT 21:31">Jesus dehan ba sira, “Hau hatete lo-loos ba imi, kobrador impostu ho feto luroon sira sei tama iha Maromak nia reinu uluk liu fali imi. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Tanba uluk João Sarani Nain mai hanorin imi oinsaa mak bele moris loos, i imi lakohi rona. Maibee kobrador impostu sira ho feto luroon sira rona hodi halo tuir. Imi haree hela sira hakribi sira nia sala, maibee imi rasik lakohi hakribi imi nia sala i la simu nafatin João nia liafuan.”<note caller="+" style="x"><char style="xo" closed="false">21:32: </char><char style="xt" closed="false"><ref loc="LUK 3:12">Lucas 3:12</ref>, <ref loc="LUK 7:29-30">7:29-30</ref></char></note><verse eid="MAT 21:32" /></para>
  <para style="s">Komparasaun kona ba ema nebee aluga toos uvas</para>
  <para style="r">(<ref loc="MRK 12:1-12">Marcos 12:1-12</ref>; <ref loc="LUK 20:9-19">Lucas 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Jesus hatutan tan dehan, “Rona tan komparasaun ida nee. Iha toos nain ida kuda uvas iha nia toos ida tomak. Nia halo lutu haleu tiha toos nee, i kee rai kuak halo tanki ida atu hasai uvas been. Nia mos harii fatin aas ida ba seguransa sira atu hein toos nee. Hotu tiha, nia foo ba ema aluga, depois nia baa hela iha rai liur.<note caller="+" style="x"><char style="xo" closed="false">21:33: </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">Isaias 5:1-2</ref></char></note><verse eid="MAT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34" />Bainhira uvas besik tasak ona, toos nain haruka nia atan balu fila baa hodi simu uvas nebee mak ema aluga toos nee tenki foo ba nia. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Maibee ema aluga toos nee kaer tiha atan sira nee. Ida sira baku, ida sira tuda ho fatuk, ida seluk sira oho. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Depois toos nain haruka nia atan barak liu tan. Maibee ema aluga toos nee halo aat nafatin.<verse eid="MAT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37" />Too ikus toos nain haruka nia oan rasik mak baa, tanba nia hanoin dehan, ‘Sira sei respeita hau nia oan.’<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Maibee bainhira ema aluga toos nee haree toos nain nia oan, sira dehan ba malu, ‘Nia mak sei hetan nia aman nia riku-soin tomak. Diak liu ita oho tiha nia, atu toos nee sai ita nian fali.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Nunee sira kaer nia, rasta nia sai husi toos laran, i oho tiha nia.”<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Konta hotu tiha, Jesus husu ba nai ulun relijiaun sira dehan, “Tuir imi nia hanoin, bainhira toos nain nee fila fali mai, nia sei halo saida ba ema sira nebee aluga toos nee?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Sira hataan dehan, “Nia sei kastigu mate tiha ema aat sira nee. I nia sei foo fali toos ba ema diak mak aluga, atu nunee too tempu kuu uvas, sira prontu foo toos nain nia parte.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Depois Jesus hatete ba sira, “Iha Livru Sagradu kompara Mesias hanesan fatuk ida. Imi nunka lee ka? Iha nebaa dehan,</para>
  <para style="q1" vid="MAT 21:42">‘Iha fatuk ida nebee badaen fatuk sira lakohi uza,</para>
  <para style="q2" vid="MAT 21:42">maibee agora fatuk nee mak sai fali fatuk nebee prinsipal.</para>
  <para style="q1" vid="MAT 21:42">Nai Maromak rasik mak hili fatuk nee,</para>
  <para style="q2" vid="MAT 21:42">ita haree ba furak teb-tebes.’ ”<note caller="+" style="f"><char style="fr" closed="false">21:42: </char><char style="ft" closed="false">Fatuk nee mak Jesus, ema mos bolu Mesias. Ema Judeu barak lakohi simu Nia, afinal Maromak haruka Nia mai iha mundu hodi salva ita ema.</char></note> <note caller="+" style="x"><char style="xo" closed="false">21:42: </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Salmu 118:22-23</ref></char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />Jesus foo atensaun ba sira dehan, “Imi la simu Fatuk nee. Nee duni Hau dehan ba imi, Maromak sei hasai imi sira nee husi Nia reinu. Nia sei hili fali povu seluk, i sira sei moris tuir Nia hakarak. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />[Ema nebee monu kona Fatuk nee, nia sei nakfera. I se karik Fatuk nee mak monu kona ema ruma, ema nee sei rahun.]”<note caller="+" style="f"><char style="fr" closed="false">21:44: </char><char style="ft" closed="false">Kopia evanjelhu Mateus husi tempu antigu barak. Balu hakerek versikulu 44 nee, balu lae.</char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Bainhira nai lulik nia ulun sira ho ema Farizeu sira rona komparasaun hirak nee, sira hatene katak Jesus soe lia ba sira. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Entaun sira buka dalan atu kaer Jesus, maibee sira tauk ema lubun boot nee, tanba povu fiar katak Jesus nee profeta ida.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Komparasaun kona ba festa boot</para>
  <para style="r">(<ref loc="LUK 14:15-24">Lucas 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Depois Jesus koalia tan ho sira uza komparasaun dehan, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Maromak ukun ema nudar Liurai, hanesan istoria tuir mai nee: Iha liurai ida halo preparasaun ba nia oan mane nia festa kazamentu. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Bainhira buat hotu besik prontu ona, liurai haruka nia atan sira baa foo hatene fali ema nebee mak nia konvida tiha ona hodi bolu sira mai ona. Maibee konvidadu sira hotu lakohi baa festa nee.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />Depois liurai haruka nia atan seluk baa foo hatene tan dala ida ba konvidadu sira. Nia hameno dehan, ‘Hahaan prepara ona. Hau oho tiha ona karau aman ho karau oan bokur. Buat hotu-hotu prontu ona. Mai ona!’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Atan sira mos baa, maibee konvidadu sira nee la interese nafatin. Sira balu baa fali sira nia toos, balu baa sira nia servisu fatin. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Konvidadu sira seluk kaer tiha atan sira nee hodi halo terus sira i oho sira.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />Rona nunee, liurai hirus teb-tebes i haruka nia soldadu sira baa oho tiha ema oho door sira nee i sunu mutuk sira nia sidade.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />Depois liurai hatete ba nia atan sira dehan, ‘Festa kazamentu prontu ona, maibee ema nebee mak hau konvida la serve atu tuir festa nee. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Agora imi baa iha estrada boot iha sidade laran. See-see deit mak imi hetan iha nebaa, bolu sira mai deit.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Nunee atan sira baa iha estrada bo-boot. See-see deit mak sira hetan, atu ema diak ka ema aat, sira halibur hotu, too halo nakonu fatin kazamentu nee.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Depois liurai tama iha fatin kazamentu atu hasoru bainaka sira. Iha nebaa nia haree ema ida la hatais ropa festa nian.<note caller="+" style="f"><char style="fr" closed="false">22:11: </char><char style="ft" closed="false">Matenek nain balu kona ba Biblia dehan, liurai nee hirus tanba nia prepara tiha ona ropa festa nian ba bainaka sira hotu, maibee ema ida nee lakohi hatais.</char></note> <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Entaun nia husu, ‘Belun, o la hatais ropa festa nian, oinsaa mak o bele tama mai?’ Maibee ema nee la hataan buat ida. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Nunee liurai hatete ba nia atan sira dehan, ‘Futu ema nee nia liman-ain i soe sai ba iha fatin nakukun. Iha nebaa ema sei tanis hakilar i ruun nehan.’ ”<note caller="+" style="x"><char style="xo" closed="false">22:13: </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mateus 8:12</ref>, <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Lucas 13:28</ref></char></note><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Jesus taka komparasaun nee dehan, “Nunee mos Maromak konvida ema barak, maibee uitoan deit mak Nia hili atu sai Nia reinu.”<verse eid="MAT 22:14" /></para>
  <para style="s">Pergunta kona ba selu impostu</para>
  <para style="r">(<ref loc="MRK 12:13-17">Marcos 12:13-17</ref>; <ref loc="LUK 20:20-26">Lucas 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Depois ema Farizeu sira sai husi nebaa hodi kombina malu atu hamonu Jesus liu husi pergunta oi-oin. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Nunee sira haruka ema balu baa atu koko Jesus. Ema sira nee mak Farizeu nia eskolante ho partidu Herodes nia membru. Sira finji husu ba Jesus dehan, “Mestri, ami hatene katak Ita Boot ema nebee mak moris loos i sempre hanorin Maromak nia dalan ho lo-loos. Ita Boot la preokupa ema seluk nia hanoin, tanba Ita Boot la fihir ema. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Ita Boot nia hanoin oinsaa? Tuir ita nia lei relijiaun, ita selu impostu ba liurai boot César, nee loos ka la loos?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Maibee Jesus hatene sira nia hanoin aat, i Nia dehan ba sira, “Imi nee laran makerek! Nusaa mak imi hakarak hamonu Hau? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Hatudu took mai Hau osan nebee mak uza hodi selu impostu.” Depois sira lori osan mutin ida foo ba Nia.<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />Jesus husu ba sira, “See nia oin mak iha osan nee? I see nia naran?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Sira hataan, “Liurai boot César nian.”</para>
  <para style="p" vid="MAT 22:21">Jesus hatete ba sira, “Se nunee, foo ba estadu buat nebee mak estadu nian, i foo ba Maromak buat nebee mak Maromak nian.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Bainhira sira rona Jesus nia liafuan nee, sira hotu admira, i sira husik hela Jesus iha nebaa hodi baa fali fatin seluk.<verse eid="MAT 22:22" /></para>
  <para style="s">Nai Jesus hanorin kona ba ema mate moris fila fali</para>
  <para style="r">(<ref loc="MRK 12:18-27">Marcos 12:18-27</ref>; <ref loc="LUK 20:27-40">Lucas 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Iha loron nee ema husi grupu Saduseu mos mai koko Jesus. Ema Saduseu sira hanorin dehan, ema mate sei la moris fali. Entaun sira husu ba Jesus,<note caller="+" style="x"><char style="xo" closed="false">22:23: </char><char style="xt" closed="false"><ref loc="ACT 23:8">Apostolu sira nia Istoria 23:8</ref></char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Mestri, Moisés dehan, se mane ida mate, maibee la iha oan, mane nia alin tenki kaben fali ho feto faluk nee para bele foo jerasaun ba nia maun.<note caller="+" style="x"><char style="xo" closed="false">22:24: </char><char style="xt" closed="false"><ref loc="DEU 25:5">Deuteronómiu 25:5</ref></char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Entaun, hanesan nee: Uluk iha ami nia rain iha maun-alin nain hitu. Maun boot kaben, depois nia mate, la iha oan. Entaun nia alin ida tuir nia nee kaben fali ho feto faluk nee. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Nia mos mate, la iha oan. Nunee beibeik too alin ikun mos kaben ho feto faluk nee, depois mate, la iha oan. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Too ikus feto faluk nee mos mate. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Agora ami husu nunee: Feto nee kaben ho mane nain hitu. Aban-bainrua Maromak halo moris fali ema mate, feto nee nia kaben mak ida nebee loos?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Jesus hataan dehan, “Imi nia hanoin nee la loos tanba imi la hatene saida mak hakerek iha Livru Sagradu, i la kompriende Maromak nia kbiit. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Bainhira ema mate moris fila fali, sira la kaben tan ona. Maibee sira hanesan anju sira iha lalehan. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Kona ba ema mate moris fali, Maromak koalia ona ba imi iha Livru Sagradu. Imi lee tiha ona ka lae? Maromak dehan, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Hau mak o nia bei-ala Abraão nia Maromak, Isac nia Maromak ho Jacó nia Maromak, sira hotu adora nafatin Hau too agora.’ Nee hatudu katak ema mate sei moris fali. Tanba so ema moris deit mak bele adora Maromak, ema mate lae.”<note caller="+" style="x"><char style="xo" closed="false">22:32: </char><char style="xt" closed="false"><ref loc="EXO 3:6">Ézodu 3:6</ref></char></note><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Bainhira ema lubun boot nee rona Jesus nia hanorin nee, sira admira teb-tebes.<verse eid="MAT 22:33" /></para>
  <para style="s">Ukun fuan nebee mak importante liu</para>
  <para style="r">(<ref loc="MRK 12:28-34">Marcos 12:28-34</ref>; <ref loc="LUK 10:25-28">Lucas 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ema Farizeu sira rona katak Jesus halo ema Saduseu sira la brani atu koalia tan. Nunee Farizeu sira halibur malu atu koko tan Jesus. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Entaun mestri relijiaun ida husi sira mai husu Jesus, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Mestri, iha Moisés nia lei, ukun fuan ida nebee mak importante liu?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Jesus hataan, “ ‘O tenki hadomi Maromak, o nia Nai, ho o nia aan tomak, ho laran tomak, ho neon tomak.’ <note caller="+" style="x"><char style="xo" closed="false">22:37: </char><char style="xt" closed="false"><ref loc="DEU 6:5">Deuteronómiu 6:5</ref></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Ida nee mak ukun fuan nebee boot liu i importante liu. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Iha tan ukun fuan ida nebee atu hanesan: ‘O tenki hadomi o nia maluk hanesan o hadomi o nia aan rasik.’<note caller="+" style="x"><char style="xo" closed="false">22:39: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Levítiku 19:18</ref></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Moisés nia lei tomak ho profeta sira nia liafuan hotu nia huun mak ukun fuan rua nee.”<note caller="+" style="x"><char style="xo" closed="false">22:40: </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Lucas 10:25-28</ref></char></note><verse eid="MAT 22:40" /></para>
  <para style="s">Mesias, Salvador nebee atu mai nee see?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Marcos 12:35-37</ref>; <ref loc="LUK 20:41-44">Lucas 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Bainhira ema Farizeu sira sei halibur malu iha nebaa, Jesus husu ba sira dehan, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Imi hanoin saida kona ba Mesias? Mesias nee see nia Jerasaun?”</para>
  <para style="p" vid="MAT 22:42">Sira hataan, “Nia nee liurai David nia Jerasaun.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Jesus husu tan dehan, “Se nunee, nusaa mak Maromak nia Espiritu foo hanoin ba liurai David atu bolu Mesias nee ‘Nai’? David hakerek dehan,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Nai Maromak hatete ona ba hau nia Nai dehan,</para>
  <para style="q2" vid="MAT 22:44">“Mai tuur iha Hau nia sorin loos,</para>
  <para style="q3" vid="MAT 22:44">too Hau hamonu O nia inimigu sira iha O nia ain okos.”’<note caller="+" style="x"><char style="xo" closed="false">22:44: </char><char style="xt" closed="false"><ref loc="PSA 110:1">Salmu 110:1</ref></char></note><verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />Iha nee liurai David rasik bolu Mesias nee nia Nai. Entaun oinsaa mak Mesias nee bele sai fali David nia Jerasaun?”<note caller="+" style="f"><char style="fr" closed="false">22:45: </char><char style="ft" closed="false">Nunee Nai Jesus hanorin dehan, Nia laos liurai David nia Jerasaun deit, maibee Nia mos liurai David nia Nai.</char></note><verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Sira hotu la bele hataan. Komesa iha loron nee la iha ema ida brani atu husu tan pergunta ba Nia.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Nai Jesus kritika mestri relijiaun ho ema Farizeu sira</para>
  <para style="r">(<ref loc="MRK 12:38-39">Marcos 12:38-39</ref>; <ref loc="LUK 11:43">Lucas 11:43</ref>,<ref loc="LUK 11:46">46</ref>, <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Hotu tiha Jesus foo hanoin ba Nia eskolante sira ho ema barak nebee mak halibur hamutuk iha fatin nee. Nia dehan nunee: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“Mestri relijiaun sira ho mos ema Farizeu sira iha direitu atu hanorin Moisés nia lei. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Nee duni imi tenki rona sira i halo tuir sira nia hanorin. Maibee la bele halo tuir sira nia hahalok, tanba sira la moris tuir buat nebee mak sira rasik hanorin. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Sira foo regulamentu todan liu ba povu, maibee sira la ajuda netik ema atu bele halo tuir. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Sira halo saida deit, sira halo so atu ema seluk bele haree hodi gaba. Ezemplu, sira hakerek Maromak nia liafuan taka ba sira nia reen toos i suku fita iha sira nia batina tutun tuir lei Moisés nian. Maibee sira halo sira nian boot liu atu ema seluk gaba.<note caller="+" style="f"><char style="fr" closed="false">23:5: </char><char style="ft" closed="false">Iha tempu nebaa ema mane sira hakerek liafuan balu husi Biblia tau iha karteira ida kesi ba sira nia reen toos ho sira nia liman kabun hodi foo hanoin ba sira atu moris tuir Maromak nia ukun fuan. Sira mos suku fita azul iha sira nia batina tutun hodi hatudu katak sira Maromak nian. Mestri relijiaun ho ema Farizeu sira halo sira nia karteira boot liu ho sira nia fita naruk liu atu ema seluk bele gaba sira.</char></note> <note caller="+" style="x"><char style="xo" closed="false">23:5: </char><char style="xt" closed="false"><ref loc="MAT 6:1">Mateus 6:1</ref>; <ref loc="DEU 6:8">Deuteronómiu 6:8</ref>; <ref loc="NUM 15:38">Númerus 15:38</ref></char></note><verse eid="MAT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 23:6" />Kuandu iha festa ka iha uma kreda laran, sira gosta tuur iha oin hanesan ema boot. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Sira gosta ema kumprimenta sira iha merkadu, i gosta ema bolu sira ‘mestri’. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Maibee imi la bele halo tuir sira nia hahalok nee. Imi la bele husik ema gaba imi hodi bolu imi ‘mestri’, tanba imi nia Mestri ida deit, i imi hotu mesak maun-alin. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Imi la bele foti aas ema ida iha mundu nee dehan ‘aman’, tanba imi nia Aman iha ida deit, Nia iha lalehan. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Imi la bele husik atu ema bolu imi ‘xefi’, tanba imi nia Xefi iha ida deit, Nia mak Mesias. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Husi imi sira nee, see mak boot liu, nia sei haraik aan hodi serbi nia maluk sira seluk.<note caller="+" style="x"><char style="xo" closed="false">23:11: </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mateus 20:26-27</ref>; <ref loc="MRK 9:35">Marcos 9:35</ref>, <ref loc="MRK 10:43-44">10:43-44</ref>; <ref loc="LUK 22:26">Lucas 22:26</ref></char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Tanba see mak foti aan sai boot, Maromak sei hatuun nia. Maibee see mak haraik aan, Maromak sei foti sae nia.”<note caller="+" style="x"><char style="xo" closed="false">23:12: </char><char style="xt" closed="false"><ref loc="LUK 14:11">Lucas 14:11</ref>, <ref loc="LUK 18:14">18:14</ref></char></note><verse eid="MAT 23:12" /></para>
  <para style="s">Nai Jesus kritika nai ulun relijiaun sira</para>
  <para style="r">(<ref loc="MRK 12:40">Marcos 12:40</ref>; <ref loc="LUK 11:39-42">Lucas 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:47-52">47-52</ref>, <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Depois Jesus hatete ba nai ulun relijiaun sira dehan, “Imi mestri relijiaun sira ho Farizeu sira, imi sei terus. Imi koalia oin seluk, hahalok oin seluk. Imi rasik lakohi tama Maromak nia reinu. Se iha ema seluk hakarak tama mos, imi taka odamatan ba sira, atu sira la bele tama.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />[Imi mestri relijiaun sira ho Farizeu sira, imi sei terus. Imi koalia oin seluk, hahalok oin seluk. Imi gosta han-matak feto faluk sira hodi hadau sira nia uma, i finji harohan nar-naruk para taka falta imi nia hahalok aat. Nee duni Maromak sei kastigu imi todan liu fali ema seluk.]<note caller="+" style="f"><char style="fr" closed="false">23:14: </char><char style="ft" closed="false">Evanjelhu Mateus nee, iha kopia barak husi tempu antigu. Kopia nebee foun liu hakerek versikulu 14 nee, maibee kopia nebee antigu liu lae.</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Imi mestri relijiaun sira ho Farizeu sira, imi sei terus. Imi koalia oin seluk, hahalok oin seluk. Imi baa iha nebee-nebee too hakur tasi hodi buka ema ida atu tuir imi nia hanorin. Maibee bainhira imi hetan tiha, imi halo nia moris aat liu tan too nia merese hetan kastigu iha infernu todan liu fali imi dala rua.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Imi mestri matan delek! Imi sei terus. Imi hanorin dehan, ‘Se ema ida jura temi uma kreda boot nia naran, nia la halo tuir mos la buat ida. Maibee se nia jura temi osan mean nebee mak iha uma kreda laran, entaun nia tenki halo tuir.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Imi matan delek i beik-teen! Ida nebee mak importante liu? Osan mean ka Maromak nia uma kreda boot nebee mak halo osan mean nee sai lulik?<verse eid="MAT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 23:18" />Imi mos hanorin dehan, ‘Se ema ida jura temi altar iha uma kreda boot, nia la halo tuir mos la buat ida. Maibee se nia jura temi oferta nebee mak iha altar nee nia leten, nia tenki halo tuir.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Imi nee matan delek duni! Ida nebee mak importante liu? Oferta ka altar nebee mak halo oferta nee sai lulik? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Nee duni se ema jura temi altar, nee dehan katak nia temi mos buat hotu-hotu nebee mak iha altar nee nia leten. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Se nia jura temi uma kreda boot, nee dehan katak nia temi mos Maromak tanba Nia mak hela iha uma kreda nee. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Se nia jura temi lalehan, nee dehan katak nia temi Maromak nia kadeira ukun i temi mos Maromak tanba Nia mak tuur iha kadeira nee.<note caller="+" style="x"><char style="xo" closed="false">23:22: </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isaias 66:1</ref>; <ref loc="MAT 5:34">Mateus 5:34</ref></char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Imi mestri relijiaun sira ho Farizeu sira, imi sei terus. Imi koalia oin seluk, hahalok oin seluk. Bainhira imi kuu modo tahan, imi badinas foo parte ida husi parte sanulu nudar oferta ba Maromak. Too modo tahan kiikoan-kiikoan hanesan ortelaun ho ruku mos imi foo. Maibee imi la interese kona ba buat nebee mak importante liu iha Maromak nia lei, hanesan justisa, ajuda ema kbiit-laek ho foo laran ba Maromak. Tuir loos buat sira nee mak tenki halo uluk. Maibee keta haluha foo mos parte ida husi sanulu ba Maromak.<note caller="+" style="x"><char style="xo" closed="false">23:23: </char><char style="xt" closed="false"><ref loc="LEV 27:30">Levítiku 27:30</ref></char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Imi mestri matan delek! Imi bele taes bee hodi hasai lalar nebee mak monu tama ba imi nia kopu laran, maibee kuda kamelu imi tolan tomak!<note caller="+" style="f"><char style="fr" closed="false">23:24: </char><char style="ft" closed="false">Nee dehan katak, sira badinas halo buat nebee laduun importante, maibee lei nebee mak importante liu, sira la interese.</char></note><verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Imi mestri relijiaun sira ho Farizeu sira, imi sei terus. Imi koalia oin seluk, hahalok oin seluk. Imi badinas hamoos kopu ho bikan nia liur. Maibee imi nia laran foer nafatin tanba imi gosta hadau ema nia sasaan hodi hanoin deit imi nia aan.<verse eid="MAT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 23:26" />Imi Farizeu matan delek duni! Fase uluk bikan nia laran mak nia liur sai moos hotu.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Imi mestri relijiaun sira ho Farizeu sira, imi sei terus. Imi koalia oin seluk, hahalok oin seluk. Imi hanesan rate nebee mak ema pinta mutin. Husi liur haree ba furak, maibee iha laran iha mate ruin ho buat oi-oin nebee halo ema hakribi.<note caller="+" style="x"><char style="xo" closed="false">23:27: </char><char style="xt" closed="false"><ref loc="ACT 23:3">Apostolu sira nia Istoria 23:3</ref></char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Imi mos nunee. Bainhira ema haree imi husi liur, imi ema diak. Afinal imi nia laran hakarak kontra Maromak nia ukun fuan, i imi finji sai ema nebee moris loos.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Imi mestri relijiaun sira ho Farizeu sira, imi sei terus. Imi koalia oin seluk, hahalok oin seluk. Imi hada Maromak nia profeta sira nia rate halo bo-boot, ema moris loos sira nia rate mos imi enfeita halo kapaas. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Depois imi dehan, ‘Se ami moris iha ami nia bei-ala sira nia tempu karik, ami lakohi hamutuk ho sira hodi oho profeta sira nee.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Afinal imi nia liafuan nee hatudu sai katak, imi nee jerasaun husi ema sira nebee mak oho profeta sira. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Entaun buat aat nebee mak imi nia bei-ala sira husik hela ba imi, husik imi hatutan ba too hotu!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Samea nia oan! Oinsaa mak imi bele halai sees husi kastigu nebee atu kona imi iha infernu? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Tanba nee, rona di-diak! Hau sei haruka nafatin profeta ho ema matenek ho mos mestri nebee mak hanorin Maromak nia liafuan. Maibee imi sei oho balu, i prega balu ba iha krus. Sira seluk imi baku ho sikoti iha imi nia uma kreda i duni husi aldeia ba aldeia. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Nunee, ema moris loos hotu-hotu nebee imi nia bei-ala sira oho, imi nebee moris agora mak sei lori todan. Nee sura husi Abel, ema ida nebee moris loos, too iha Zacarias, Barakias nia oan. Ema oho Zacarias iha area uma kreda boot besik meza sakrifisiu. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Hau hatete lo-loos ba imi, sira hotu nia mate, imi nebee moris agora mak tenki lori todan.”<verse eid="MAT 23:36" /></para>
  <para style="s">Nai Jesus hanoin loos ema Jerusalém</para>
  <para style="r">(<ref loc="LUK 13:34-35">Lucas 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“Koitadu, imi ema Jerusalém! Imi oho Maromak nia profeta sira, i ema nebee Maromak haruka ba imi, imi tuda ho fatuk too mate. Dala barak Hau hakarak halibur imi hanesan manu inan halibur nia oan sira atu luut, maibee imi lakohi. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Rona mai! Maromak husik tiha ona imi nia hela fatin. Agora imi mesak ona. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Hau hatete ba imi, imi sei la haree tan Hau too imi foo sai dehan, ‘Maromak foo bensaun ba Ema ida nebee mai lori Nai Maromak nia naran.’ ”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Uma kreda boot sei rahun</para>
  <para style="r">(<ref loc="MRK 13:1-2">Marcos 13:1-2</ref>; <ref loc="LUK 21:5-6">Lucas 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Koalia hotu tiha, Jesus lao sai husi uma kreda boot. Nia lao dadauk, Nia eskolante sira mai besik hodi hatudu uma kreda nia furak ba Nia. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Maibee Jesus hataan, “Imi haree di-diak ba! Hau hatete lo-loos ba imi, too loron ida, buat sira nee sei rahun hotu. Fatuk sira nee hotu sei tetuk too rai.”<verse eid="MAT 24:2" /></para>
  <para style="s">Terus boot sei mai</para>
  <para style="r">(<ref loc="MRK 13:3-23">Marcos 13:3-23</ref>; <ref loc="LUK 21:7-24">Lucas 21:7-24</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Depois Jesus lao baa tuur mesak iha foho Oliveira. Nia eskolante sira baa besik Nia hodi husu, “Hatete took mai ami, buat nebee ohin Ita Boot koalia nee, bainhira mak sei akontese? Kuandu Ita Boot atu fila fali mai, sinal saida mak sei mosu? I sinal saida mak sei hatudu katak mundu atu remata ona?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Jesus hataan dehan, “Kuidadu di-diak para ema la bele bosok imi. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ema barak sei mai lori Hau nia naran dehan sira nee mak Mesias, Salvador nebee Maromak promete ona hori uluk atu haruka mai. I sira lohi ema barak atu lao sala dalan. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Imi sei rona kona ba funu oi-oin, i ema sei konta tutan kona ba funu iha fat-fatin. Maibee keta tauk. Buat sira nee tenki akontese uluk, maibee nee laos dehan katak mundu atu remata ona. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Nasaun sei funu hasoru nasaun, estadu sei funu hasoru estadu. Sei iha rai hamlaha boot, i rai sei nakdoko iha fat-fatin. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Maibee susar sira nee foin mak hahuu, hanesan feto isin rua nebee foin kanotak moras atu tuur ahi.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Ema iha nasaun hotu-hotu sei odi imi tanba imi tuir Hau. Sira sei entrega imi ba ema seluk atu halo terus imi i oho imi.<note caller="+" style="x"><char style="xo" closed="false">24:9: </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mateus 10:22</ref></char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Iha tempu nee mos ema nebee fiar mai Hau, barak sei fila kotuk mai Hau. Sira sei odi malu i faan malu ba inimigu sira. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Profeta falsu barak sei mosu hodi bosok ema barak atu tuir sira. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Hahalok aat iha mundu nee aumenta ba beibeik too ema barak liu mak la hatudu domin ba malu tan. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Maibee see mak tuir nafatin Hau too rohan, Maromak sei salva nia.<note caller="+" style="x"><char style="xo" closed="false">24:13: </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mateus 10:22</ref></char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Liafuan Diak kona ba oinsaa Maromak ukun nudar Liurai, ema sei haklaken iha mundu tomak, atu nunee ema husi nasaun hotu-hotu bele hatene. Haklaken hotu tiha mak foin mundu nee remata.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Hori uluk profeta Daniel hakerek kona ba buat ida aat liu nebee sei tama ba iha Fatin Lulik iha uma kreda boot, halo too Maromak hakribi. See mak lee liafuan nee, kompriende ba! Bainhira imi haree buat aat nee,<note caller="+" style="x"><char style="xo" closed="false">24:15: </char><char style="xt" closed="false"><ref loc="DAN 9:27">Daniel 9:27</ref>, <ref loc="DAN 11:31">11:31</ref>, <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />imi nebee iha provinsia Judeia tenki halai ona ba foho. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Iha loron nee, ema nebee iha hela liur, la bele tama baa foti sasaan iha uma laran. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />I ema nebee iha hela toos, la bele fila baa foti nia hena iha uma.<note caller="+" style="x"><char style="xo" closed="false">24:18: </char><char style="xt" closed="false"><ref loc="LUK 17:31">Lucas 17:31</ref></char></note> <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Iha tempu nee, feto isin rua ho inan sira nebee foo susu nia oan, sei terus teb-tebes. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Harohan ba Maromak atu loron nebee mak imi halai ba foho nee, la bele monu iha tempu malirin ka iha loron Sabadu, ita ema Judeu nia loron deskansa. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Tanba iha tempu nee, ema sei terus aat liu. Komesa husi Maromak halo mundu too agora, seidauk iha terus aat ida hanesan nee. I kuandu terus boot nee liu tiha, sei la akontese tan hanesan nee.<note caller="+" style="x"><char style="xo" closed="false">24:21: </char><char style="xt" closed="false"><ref loc="DAN 12:1">Daniel 12:1</ref>; <ref loc="REV 7:14">Apokalipse 7:14</ref></char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Se Maromak la habadak tempu terus nee, la iha tan ema ida mak moris. Maibee Nia sei habadak duni, tanba Nia hadomi ema nebee mak Nia hili tiha ona.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Iha tempu nee, se ema ruma dehan ba imi, ‘Haree took, Mesias iha nee’ ka ‘Mesias iha nebaa’, keta fiar. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Tanba ema sei mai bosok dehan sira mak Mesias ka sira Maromak nia profeta. Sira sei hatudu milagre bo-boot nebee halo ema admira, atu nunee sira bele lohi ema hotu-hotu atu lao sala dalan. Too ema nebee Maromak hili mos sira hakarak hamonu. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Entaun hanoin di-diak! Aban-bainrua buat sira nee akontese, lalika hakfodak, tanba Hau foo hatene ona ba imi.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Nunee se ema mai bosok imi dehan, ‘Haree ba, Mesias iha rai fuik maran nebaa’, lalika sai baa buka. Se ema dehan, ‘Mesias iha hela subar fatin nee’, lalika fiar. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Tanba bainhira Hau, Ema Umanu nia Oan fila fali mai husi lalehan, ema hotu sei haree mo-moos, hanesan rai lakan nebee mak naroman husi lorosae too loromonu.<note caller="+" style="x"><char style="xo" closed="false">24:27: </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">Lucas 17:23-24</ref></char></note><verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />Bainhira imi haree manu metan semo hamutuk ba iha fatin ida, nee sinal hodi hatudu mo-moos katak iha mate isin dodok iha nebaa.”<note caller="+" style="f"><char style="fr" closed="false">24:28: </char><char style="ft" closed="false">Tuir matenek nain balu kona ba Biblia, nee dehan katak, aban-bainrua Nai Jesus atu besik fila fali mai, sei iha sinal hodi hatudu mo-moos katak Nia atu mai ona.</char></note> <note caller="+" style="x"><char style="xo" closed="false">24:28: </char><char style="xt" closed="false"><ref loc="LUK 17:37">Lucas 17:37</ref></char></note><verse eid="MAT 24:28" /></para>
  <para style="s">Nai Jesus sei fila fali mai husi lalehan</para>
  <para style="r">(<ref loc="MRK 13:24-31">Marcos 13:24-31</ref>; <ref loc="LUK 21:25-33">Lucas 21:25-33</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Bainhira loron terus nee liu tiha, loro matan sai nakukun tiha, fulan mos la foo naroman tan. Fitun sira iha lalehan sei monu namtate, i forsa hotu-hotu iha kalohan leten sei nakdoko.<note caller="+" style="x"><char style="xo" closed="false">24:29: </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isaias 13:10</ref>, <ref loc="ISA 34:4">34:4</ref>; <ref loc="EZK 32:7">Ezequiel 32:7</ref>; <ref loc="JOL 2:10">Joel 2:10</ref>,<ref loc="JOL 2:31">31</ref>, <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12-13">Apokalipse 6:12-13</ref></char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />Ema hotu-hotu iha mundu sei haree sinal ida iha lalehan hatudu sai katak Hau, Ema Umanu nia Oan atu mai ona. Haree nunee, sira nebee lakohi simu Hau sei tanis ho laran susar. Depois ema hotu-hotu sei haree Hau, Ema Umanu nia Oan tuun mai iha kalohan leten, ho kbiit boot ho naroman lalehan nian.<note caller="+" style="x"><char style="xo" closed="false">24:30: </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daniel 7:13</ref>; <ref loc="ZEC 12:10-14">Zacarias 12:10-14</ref>; <ref loc="REV 1:7">Apokalipse 1:7</ref></char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />I Hau sei haruka Hau nia anju huu korneta ho lian makaas hodi bolu anju sira atu halibur ema sira nebee mak Hau hili tiha ona husi mundu tomak, husi rai ulun too rai ikun.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Hanoin took ai figeira, i aprende husi ai nee. Bainhira ai figeira nia sanak komesa matak i nia dikin komesa sai, imi hatene katak bailoron besik ona. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Nunee mos bainhira imi haree buat sira nee hotu akontese, imi hatene katak Hau besik mai ona, Hau iha ona odamatan oin. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Hau hatete lo-loos ba imi, husi ema hotu nebee mak moris iha tempu nee, iha balu sei moris too buat sira nee hotu akontese. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Lalehan ho rai sei remata, maibee Hau nia liafuan sei la remata.”<verse eid="MAT 24:35" /></para>
  <para style="s">La iha ema ida hatene bainhira mak Nai Jesus atu mai fali</para>
  <para style="r">(<ref loc="MRK 13:32-37">Marcos 13:32-37</ref>; <ref loc="LUK 17:26-30">Lucas 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Kona ba loron ho oras nebee mak Hau atu fila fali mai, la iha ema ida mak hatene. Anju sira iha lalehan mos la hatene.<note caller="+" style="f"><char style="fr" closed="false">24:36: </char><char style="ft" closed="false">Evanjelhu Mateus nee iha kopia barak husi tempu antigu. Balu dehan, “Hau, Maromak nia Oan mos la hatene.” Maibee balu la temi liafuan nee.</char></note> So Aman Maromak deit mak hatene. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Bainhira loron too atu Hau, Ema Umanu nia Oan fila fali mai, ema sei moris baibain hanesan iha Noé nia tempu uluk.<note caller="+" style="x"><char style="xo" closed="false">24:37: </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Jénesis 6:5-8</ref></char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Iha tempu nebaa molok bee boot sae, ema haan-hemu i halo festa kazamentu hanesan baibain, too loron Noé tama ba roo boot laran. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Bainhira bee sae lori lakon tiha ema sira hotu foin sira nia matan nakloke hodi hatene saida mak akontese. Nunee mos bainhira Hau, Ema Umanu nia Oan fila fali mai.<note caller="+" style="x"><char style="xo" closed="false">24:39: </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">Jénesis 7:6-24</ref></char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Iha tempu nee, ema nain rua servisu hela iha toos laran, Maromak sei lori tiha ida i husik hela ida seluk. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Iha feto nain rua fai hela hare, Maromak sei lori tiha ida, i husik hela ida seluk.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />Entaun imi tenki matan moris, tanba imi la hatene saa loron mak Hau, imi nia Nai fila fali mai. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Hanoin di-diak! Se iha uma nain ida hatene lo-loos iha oras nebee mak naok-teen atu mai, nia matan moris nafatin atu naok-teen la bele tama. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Nee duni imi tenki prontu nafatin. Tanba aban-bainrua Hau, Ema Umanu nia Oan sei fila fali mai derepenti deit iha oras nebee imi la hatene.”<note caller="+" style="x"><char style="xo" closed="false">24:44: </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">Lucas 12:39-40</ref></char></note><verse eid="MAT 24:44" /></para>
  <para style="s">Atan diak ho atan aat</para>
  <para style="r">(<ref loc="LUK 12:41-48">Lucas 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Entaun imi tenki hanesan atan ida nebee matenek toma konta nia patraun nia sasaan, i foo laran ba nia patraun. Patraun sei foo fiar ba ema nee atu fahe hahaan ba nia atan sira seluk tuir oras. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Bainhira patraun fila ba uma, haree atan nee badinas halao nia servisu, atan nee sorti boot. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Hau hatete lo-loos ba imi, patraun sei foti nia hodi toma konta nia riku-soin hotu.<verse eid="MAT 24:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 24:48" />Maibee karik atan nee ema aat ida, nia hanoin dehan, ‘Patraun sei kleur mak fila.’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Depois nia komesa baku nia maluk atan sira seluk, i haan-hemu hamutuk ho ema lanu-teen sira. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Se nunee, iha loron nebee nia la hein, i oras nebee nia la hatene, derepenti deit nia patraun fila mai. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Depois patraun sei tetak rahun tiha atan nee i soe hamutuk ho ema sira nebee koalia oin ida hahalok oin seluk. Iha nebaa ema sei tanis hakilar i ruun nehan.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Komparasaun kona ba feto raan matenek ho feto raan beik</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Jesus koalia tan dehan, “Aban-bainrua Hau fila fali mai hodi ukun nudar Liurai, sei sai hanesan komparasaun ida nee: Iha kalan ida, ema atu halo festa kazamentu. Iha feto raan nain sanulu baa hein noivu iha liur, ida-idak lori nia ahi-oan.<note caller="+" style="x"><char style="xo" closed="false">25:1: </char><char style="xt" closed="false"><ref loc="LUK 12:35">Lucas 12:35</ref></char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Husi feto raan nain sanulu nee, nain lima matenek, nain lima seluk beik. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Nain lima beik nee lori deit ahi-oan, la lori mina rezerva. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Maibee nain lima matenek nee lori mina rezerva iha botir.<verse eid="MAT 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 25:5" />Sira hotu baa hein noivu. Maibee noivu nee kleur loos foin too, nunee sira matan dukur toba tiha.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />Iha kalan boot ema ida hakilar dehan, ‘Noivu mai ona! Imi mai hasoru nia ona!’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Rona nunee, feto raan nain sanulu nee hadeer hodi prepara sira nia ahi-oan. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Nain lima beik nee, sira nia mina atu hotu ona. Nunee sira hatete ba nain lima matenek dehan, ‘Foo imi nia mina uitoan mai, tanba ami nia ahi besik atu mate.’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Maibee nain lima matenek nee hataan, ‘Ami la bele foo. Se ami foo, entaun ami nia ahi mos bele mate. Diak liu imi baa sosa iha ema sira nebee faan mina.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Bainhira sira baa buka mina atu sosa, noivu mos too. I feto raan nain lima nebee prontu hela atu simu noivu nee, tama hamutuk ho noivu iha festa laran. Depois ema taka tiha odamatan.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Too ikus feto raan nain lima beik nee mos too mai iha odamatan oin hodi bolu dehan, ‘Senhor! Senhor! Favor loke odamatan mai ami.’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Maibee noivu hataan, ‘Hau dehan lo-loos ba imi, hau la konhese imi.’ ”<note caller="+" style="x"><char style="xo" closed="false">25:12: </char><char style="xt" closed="false"><ref loc="LUK 13:25">Lucas 13:25</ref></char></note><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Konta hotu tiha, Jesus dehan, “Entaun matan moris neon nain nafatin ba. Tanba imi la hatene loron ho oras nebee mak Hau atu fila fali mai.”<verse eid="MAT 25:13" /></para>
  <para style="s">Komparasaun kona ba atan nebee kaer patraun nia osan</para>
  <para style="r">(<ref loc="LUK 19:11-27">Lucas 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Hau foo komparasaun ida tan kona ba Hau nia loron atu fila fali mai. Iha ema riku ida atu baa iha rai dook. Molok atu baa, nia bolu nia atan sira hodi foo fiar ba sira kaer nia osan too nia fila. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Nia foo ba atan sira nee tuir ida-idak nia kapasidade. Atan ida, nia entrega osan mutin bornal lima. Ida seluk, nia entrega osan mutin bornal rua. Ida seluk tan, nia entrega osan mutin bornal ida. Fahe hotu tiha, nia sai ona ba rai liur.<verse eid="MAT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 25:16" />Atan ida nebee simu osan mutin bornal lima nee, baa fila liman kedas, i nia manaan tan osan mutin bornal lima. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Nunee mos atan ida nebee simu osan mutin bornal rua. Nia baa fila liman i manaan tan osan mutin bornal rua. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Maibee atan ida nebee simu osan mutin bornal ida, nia baa kee rai kuak hodi hakoi subar tiha nia patraun nia osan.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Kleur loos mak foin atan sira nia patraun fila. Too iha uma, patraun bolu sira hodi husu tuir, sira ida-idak manaan fali osan hira. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Atan ida nebee simu osan mutin bornal lima nee mai uluk. Nia lori osan mutin bornal sanulu hodi dehan, ‘Patraun, uluk patraun entrega osan mutin bornal lima mai hau. Agora haree took, hau manaan tan bornal lima.’<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />Nia patraun hatete ba nia, ‘Diak loos! O nee atan diak, i foo laran ba hau duni. O halo buat kiikoan nee ho loos, nunee hau sei foo tan buat boot atu o tau matan. Mai haksolok hamutuk ho hau.’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Nunee mos atan nebee mak simu osan mutin bornal rua. Nia mai dehan, ‘Patraun, uluk patraun entrega osan mutin bornal rua mai hau. Haree took, hau manaan tan bornal rua.’<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />Nia patraun hataan, ‘Diak loos! O nee atan diak, i foo laran ba hau duni. O halo buat kiikoan nee ho loos, nunee hau sei foo tan buat boot atu o tau matan. Mai haksolok hamutuk ho hau.’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Depois atan nebee simu osan mutin bornal ida deit mai dehan, ‘Patraun, hau hatene ita boot siak-teen. Ita boot gosta kuu buat nebee laos ita boot mak kuda, i simu buat nebee laos ita boot nia kosar been. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Nee mak hau tauk, i hau baa hakoi subar tiha patraun nia osan. Haree ba, ita boot nia osan mak nee.’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />Maibee nia patraun hataan, ‘Atan aat i baruk-teen! O hatene katak hau gosta kuu buat nebee laos hau mak kuda, i simu buat nebee laos hau nia kosar been. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Tuir lo-loos o rai hau nia osan iha banku para hau fila mai, bele simu fali osan nee ho nia funan.’<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />Depois patraun hatete ba nia atan seluk, ‘Foti tiha osan nee husi nia hodi foo fali ba atan ida nebee mak iha ona osan mutin bornal sanulu. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Tanba ema nebee iha ona, sei simu tan too nakonu resin. Maibee ema nebee la iha, uitoan nebee nia iha mos, sei hasai tiha husi nia.<note caller="+" style="x"><char style="xo" closed="false">25:29: </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mateus 13:12</ref>; <ref loc="MRK 4:25">Marcos 4:25</ref>; <ref loc="LUK 8:18">Lucas 8:18</ref></char></note><verse eid="MAT 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 25:30" />Agora kaer tiha atan nebee la iha folin nee hodi soe sai ba iha fatin nakukun. Iha nebaa ema sei tanis hakilar i ruun nehan.’ ”<note caller="+" style="x"><char style="xo" closed="false">25:30: </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">Lucas 19:11-27</ref>; <ref loc="MAT 8:12">Mateus 8:12</ref>, <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">Lucas 13:28</ref></char></note><verse eid="MAT 25:30" /></para>
  <para style="s">Nai Jesus sei tesi ema hotu-hotu nia lia</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Jesus hatutan tan dehan, “Hau, Ema Umanu nia Oan sei fila fali mai husi lalehan ho naroman nabilan, i anju sira hotu mai hamutuk ho Hau. Hau sei tuur iha kadeira ukun nudar Liurai.<note caller="+" style="x"><char style="xo" closed="false">25:31: </char><char style="xt" closed="false"><ref loc="MAT 16:27">Mateus 16:27</ref>, <ref loc="MAT 19:28">19:28</ref></char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Depois anju sira sei halibur ema husi nasaun hotu-hotu iha Hau nia oin, i Hau sei fahe ema sira nee ba grupu rua, hanesan bibi atan haketak bibi malae ho bibi timur. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ema nebee moris loos, Hau tau iha Hau nia sorin loos, sira seluk Hau tau iha Hau nia sorin karuk. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Nudar Liurai, Hau sei hatete ba ema sira nebee mak iha Hau nia sorin loos dehan, ‘Imi sira nee mak hetan bensaun husi Hau nia Aman, mai tama ona ba imi nia fatin iha reinu lalehan. Fatin nee prepara nanis ona ba imi bainhira Maromak halo mundu nee. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Tanba uluk bainhira Hau hamlaha, imi foo hahaan mai Hau. Hau hamrook, imi foo Hau hemu. Hau hanesan ema lao rai ida iha imi nia rain, imi simu Hau iha imi nia uma. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Hau la iha hena atu hatais, imi foo hena mai Hau. Hau moras, imi tau matan mai Hau. Hau dadur iha komarka, imi baa vizita Hau.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Depois ema nebee moris loos nee husu, ‘Nai, hori bainhira mak ami haree Ita Boot hamlaha, i foo hahaan ba Ita, ka Ita hamrook i ami foo Ita hemu? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Hori bainhira mak Ita Boot hanesan ema lao rai, depois ami simu Ita iha uma? Hori bainhira mak Ita Boot la iha hena, i ami foo hena ba Ita? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Hori bainhira mak ami haree Ita Boot moras ka dadur iha komarka, depois ami baa vizita Ita?’<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />Hau sei hataan dehan, ‘Rona di-diak! Bainhira imi halo buat diak sira nee ba Hau nia maluk ida, maski ema kiik ida mos, nee hanesan imi halo ona mai Hau.’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Depois Hau hatete ba ema sira nebee mak iha Hau nia sorin karuk dehan, ‘Imi sira nee hetan ona malisan. Sai tiha husi fatin nee, i baa tama iha ahi nebee mak nunka mate tinan ba tinan. Ahi nee prepara tiha ona ba Satanás ho nia anju sira. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Tanba uluk bainhira Hau hamlaha, imi la foo hahaan mai Hau. Hau hamrook, imi la foo Hau hemu. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Hau hanesan ema lao rai ida iha imi nia rain, imi la simu Hau iha imi nia uma. Hau la iha hena atu hatais, imi la foo hena mai Hau. Hau moras ka dadur iha komarka, imi la tau matan ba Hau.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Sira mos husu, ‘Nai, hori bainhira mak ami haree Ita Boot hamlaha ka hamrook, depois ami la foo haan-hemu? I hori bainhira mak Ita Boot hanesan ema lao rai, ka la iha hena atu hatais, ka moras ka dadur iha komarka, depois ami la tau matan?’<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />Hau sei hataan, ‘Rona di-diak! Bainhira imi la halo buat diak sira nee ba Hau nia maluk ida, maski ema kiik ida mos, nee hanesan imi la halo mai Hau.’<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />Hotu tiha ema sira nee sei sai husi Hau nia sorin hodi hetan kastigu tinan ba tinan. Maibee ema nebee mak moris loos sei hetan moris rohan-laek.”<note caller="+" style="x"><char style="xo" closed="false">25:46: </char><char style="xt" closed="false"><ref loc="DAN 12:2">Daniel 12:2</ref></char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Nai ulun relijiaun Judeu sira buka dalan atu oho Nai Jesus</para>
  <para style="r">(<ref loc="MRK 14:1-2">Marcos 14:1-2</ref>; <ref loc="LUK 22:1-2">Lucas 22:1-2</ref>; <ref loc="JHN 11:45-53">João 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Bainhira Jesus hanorin tiha hotu buat sira nee, Nia hatete ba Nia eskolante sira dehan, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Imi hatene katak, hela deit loron rua atu festa Paskua. Iha tempu nee, ema sei entrega Hau, Ema Umanu nia Oan ba ema aat atu prega iha krus too mate.”<note caller="+" style="x"><char style="xo" closed="false">26:2: </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Ézodu 12:1-27</ref></char></note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Iha tempu nebaa nai lulik nia ulun sira ho katuas lia nain sira halibur hamutuk iha nai lulik boot Kaifás nia uma. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Sira kombina malu atu kaer Jesus nonook deit hodi oho. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Maibee sira hatete, “La bele kaer Nia iha loron festa nee, se lae povu bele halo rungu-ranga.”<verse eid="MAT 26:5" /></para>
  <para style="s">Feto ida fui mina morin ba Nai Jesus nia ulun</para>
  <para style="r">(<ref loc="MRK 14:3-9">Marcos 14:3-9</ref>; <ref loc="JHN 12:1-8">João 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Jesus baa iha aldeia Betánia hodi haan iha Simão ida nebee uluk moras lepra nia uma. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Bainhira Jesus haan hela, feto ida mai lori botir ida halo husi fatuk murak, mina morin karun teb-tebes mak iha laran. Nia baa besik Jesus hodi fui mina morin nee ba iha Jesus nia ulun.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Bainhira Jesus nia eskolante sira haree, sira hirus hodi dehan ba malu, “Nusaa mak nia estraga deit mina morin folin karun nee? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Se mina morin nee faan karik, bele hetan osan barak hodi ajuda ema kiak sira.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Maibee Jesus hatene hela sira nia hanoin, nunee Nia dehan, “Imi keta hirus feto nee, tanba nia halo ona buat furak mai Hau. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ema kiak sira sempre iha imi nia leet, maibee Hau laos atu hela nafatin ho imi.<note caller="+" style="x"><char style="xo" closed="false">26:11: </char><char style="xt" closed="false"><ref loc="DEU 15:11">Deuteronómiu 15:11</ref></char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Nia fui mina morin nee ba Hau nia isin para Hau mate karik, hein hakoi deit. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Hau hatete lo-loos ba imi, aban-bainrua bainhira ema foo sai Liafuan Diak iha mundu tomak, sira mos sei konta kona ba buat nebee mak nia halo mai Hau, atu ema hanoin nafatin nia.”<verse eid="MAT 26:13" /></para>
  <para style="s">Judas iha planu atu faan Nai Jesus</para>
  <para style="r">(<ref loc="MRK 14:10-11">Marcos 14:10-11</ref>; <ref loc="LUK 22:3-6">Lucas 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Depois Judas Iscariotes, eskolante ida husi sanulu resin rua nee, baa hasoru nai lulik nia ulun sira. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Too iha nebaa, nia husu, “Se hau entrega Nia ba imi nia liman, imi sei foo saida ba hau?”</para>
  <para style="p" vid="MAT 26:15">Entaun sira sura osan mutin tolu-nulu hodi foo ba nia.<note caller="+" style="x"><char style="xo" closed="false">26:15: </char><char style="xt" closed="false"><ref loc="ZEC 11:12">Zacarias 11:12</ref></char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />I Judas sai kedas hodi buka dalan atu entrega Jesus ba sira.<verse eid="MAT 26:16" /></para>
  <para style="s">Nai Jesus haan hamutuk ho Nia eskolante sira iha festa Paskua</para>
  <para style="r">(<ref loc="MRK 14:12-26">Marcos 14:12-26</ref>; <ref loc="LUK 22:7-23">Lucas 22:7-23</ref>; <ref loc="JHN 13:21-30">João 13:21-30</ref>; <ref loc="1CO 11:23-25">1 Korintu 11:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Festa Paun la Tau Fermentu hahuu ona.<note caller="+" style="f"><char style="fr" closed="false">26:17: </char><char style="ft" closed="false">Iha festa Paun la Tau Fermentu, ema Judeu hanoin sira nia bei-ala sira uluk halai sai husi rai Ejitu. Bainhira sira halai, sira la iha tempu atu prepara paun ho fermentu. Festa nee lao durante loron walu. Iha kalan primeiru mak sira selebra festa Paskua. Lee iha Ézodu (Keluaran) 12: 6-15.</char></note> Iha loron primeiru Jesus nia eskolante sira baa husu Nia dehan, “Ita Boot hakarak ami baa prepara hahaan atu selebra festa Paskua iha nebee?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Jesus hataan, “Baa iha sidade laran, iha nebaa imi sei hasoru ema ida. Hatete ba nia nunee: ‘Mestri hameno katak, Nia loron nebee Maromak desidi nee besik ona, i Nia hakarak selebra festa Paskua hamutuk ho Nia eskolante sira iha ita nia uma.’ ”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Depois Nia eskolante sira baa halo tuir buat nebee mak Jesus haruka. Sira halo preparasaun ba festa Paskua iha nebaa.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Bainhira kalan ona, Jesus tuur hamutuk ho Nia eskolante nain sanulu resin rua iha meza. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Sira haan daudaun, Nia dehan, “Hau hatete lo-loos ba imi, husi imi sira nee, ida sei faan Hau ba Hau nia inimigu sira.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Rona nunee, Nia eskolante sira tristi teb-tebes. I sira ida-ida komesa husu ba Nia dehan, “Nai, laos hau, loos ka lae?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Jesus hataan, “Ida nebee agora haan lisuk ho Hau iha manko, nia mak sei faan Hau.<note caller="+" style="x"><char style="xo" closed="false">26:23: </char><char style="xt" closed="false"><ref loc="PSA 41:10">Salmu 41:10</ref></char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Hau, Ema Umanu nia Oan tenki mate duni tuir buat nebee hakerek tiha ona iha Livru Sagradu. Maibee ema nebee faan Hau nee, sei terus teb-tebes. Diak liu uluk kedas nia lalika moris.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Depois Judas, ida nebee atu faan Jesus nee husu, “Mestri, laos hau, loos ka lae?”</para>
  <para style="p" vid="MAT 26:25">Jesus hataan, “O duni.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Bainhira sira haan hela, Jesus foti paun hodi foo agradese ba Maromak. Nia silu paun nee hodi fahe ba Nia eskolante sira dehan, “Simu hodi haan ba. Nee Hau nia isin.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Depois Nia foti tua kopu ida. Nia foo agradese ba Maromak, i foo ba Nia eskolante sira dehan, “Imi hotu hemu ba. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Tua nee Hau nia raan. Liu husi Hau nia raan fakar mak Maromak kumpri Nia promesa hodi hamoos ema barak nia sala.<note caller="+" style="x"><char style="xo" closed="false">26:28: </char><char style="xt" closed="false"><ref loc="EXO 24:8">Ézodu 24:8</ref>; <ref loc="JER 31:31-34">Jeremias 31:31-34</ref></char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Hau hatete ba imi, Hau sei la hemu tan tua nee. Bainhira Hau nia Aman iha lalehan ukun Nia povu hotu mak foin Hau hemu fali tua foun hamutuk ho imi.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Hotu tiha Jesus ho Nia eskolante sira kanta hamutuk hodi hahii Maromak. Depois sira sai baa iha foho Oliveira.<verse eid="MAT 26:30" /></para>
  <para style="s">Nai Jesus dehan, Pedro sei nega Nia</para>
  <para style="r">(<ref loc="MRK 14:27-31">Marcos 14:27-31</ref>; <ref loc="LUK 22:31-34">Lucas 22:31-34</ref>; <ref loc="JHN 13:36-38">João 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Jesus hatete ba Nia eskolante sira dehan, “Iha kalan nee kedas, imi hotu-hotu sei halai husik hela Hau tanba imi haree saida mak akontese mai Hau. Tanba iha Livru Sagradu hakerek dehan, ‘Hau sei oho tiha bibi atan, i bibi sira sei halai namkari hotu.’<note caller="+" style="x"><char style="xo" closed="false">26:31: </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zacarias 13:7</ref></char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Hau sei mate duni. Maibee bainhira Hau moris fali, Hau baa hein imi iha provinsia Galileia.”<note caller="+" style="x"><char style="xo" closed="false">26:32: </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mateus 28:16</ref></char></note><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Pedro hataan, “Maski sira hotu halai namkari tanba buat nebee mak akontese ba Ita Boot, maibee hau sei la halai.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Jesus dehan ba nia, “Hau hatete lo-loos ba o, iha kalan nee duni, molok manu kokoreek, o sei nega Hau dala tolu.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Pedro hataan fali, “Maski hau tenki mate hamutuk ho Ita Boot mos, hau sei la nega.” Eskolante sira seluk mos hatete nunee.<verse eid="MAT 26:35" /></para>
  <para style="s">Nai Jesus harohan iha toos Getsémani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Marcos 14:32-42</ref>; <ref loc="LUK 22:39-46">Lucas 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Depois Jesus lao hamutuk ho Nia eskolante sira baa iha fatin ida naran Getsémani. Too iha nebaa, Nia hatete ba sira, “Imi tuur iha nee, Hau sei baa halo orasaun iha nebaa lai.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Nia lao tan uitoan, lori ho Pedro ho Zebedeu nia oan nain rua, Tiago ho João. Iha tempu nee Jesus nia laran susar teb-tebes i la hakmatek. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Jesus hatete ba sira nain tolu, “Hau nia laran susar teb-tebes, too senti atu besik mate ona. Imi hein Hau iha nee hodi hadeer nafatin.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Jesus lao tan uitoan husi sira, depois Nia taka rabat ba rai hodi harohan dehan, “Hau nia Aman, se bele karik hasai tiha terus ida nee husi Hau. Maibee la bele halo tuir Hau nia hakarak, halo tuir deit Ita Boot nia hakarak.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Depois Nia fila fali ba nia eskolante nain tolu nee, Nia haree sira toba dukur hela. Nia hatete ba Pedro, “Imi atu hadeer deit oras ida hamutuk ho Hau mos la bele ka? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Hadeer hodi halo orasaun atu imi la bele monu ba tentasaun. Tanba imi nia laran hakarak atu halo buat nebee loos, maibee imi ema nebee fraku.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Dala ida tan Jesus baa halo orasaun dehan, “Hau nia Aman, se Hau tenki simu terus nee, entaun halo tuir Ita Boot nia hakarak ba.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Bainhira Nia fila fali, Nia haree sira nain tolu toba fali, tanba sira nia matan dukur loos.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Entaun Nia husik sira i fila fali hodi halo orasaun ba dala tolu. Nia harohan hanesan ohin. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Hotu tiha Nia fila fali ba Nia eskolante sira hodi dehan, “Imi sei toba deskansa ka? Agora oras too ona atu ema faan Hau, Ema Umanu nia Oan ba iha ema aat nia liman. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Hadeer ona. Haree ba! Ema nebee mak faan Hau ba ema aat nee mai daudaun ona. Mai ita baa took iha sira.”<verse eid="MAT 26:46" /></para>
  <para style="s">Ema kaer Nai Jesus</para>
  <para style="r">(<ref loc="MRK 14:43-50">Marcos 14:43-50</ref>; <ref loc="LUK 22:47-53">Lucas 22:47-53</ref>; <ref loc="JHN 18:3-12">João 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Jesus sei koalia hela, Judas, eskolante ida husi sira nain sanulu resin rua nee, too mai. Ema barak mai hamutuk ho nia, lori surik ho ai dona. Ema sira nee, nai lulik nia ulun sira ho katuas lia nain sira mak haruka. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Molok too iha nebaa, Judas foo tiha ona sinal ba sira dehan, “Ema nebee mak hau rei, Nia mak nee, imi kaer Nia.”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Entaun Judas baa kedas kumprimenta Jesus dehan, “Mestri.” I nia rei Jesus.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Jesus hatete, “Belun, halo tuir o nia planu ba.” Depois ema sira nee mai kaer Jesus.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Derepenti Jesus nia eskolante ida losu nia surik hodi tesi kotu tiha ema ida nia tilun. Ema nee nai lulik boot nia atan. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Haree nunee, Jesus hatete, “Hatama tiha o nia surik nee ba iha nia fatin. Tanba see-see deit mak hodi surik hasoru ema, nia sei mate mos ho surik. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Hau hatete lo-loos ba o, se Hau husu tulun ba Hau nia Aman iha lalehan, Nia haruka kedas anju barak teb-tebes, liu fali batalhaun sanulu resin rua, para ajuda Hau. <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Maibee se Hau husu nunee karik, saida mak hakerek iha Livru Sagradu kona ba Hau nee la sai realidade.”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Depois Jesus hatete ba ema barak nee dehan, “Nusaa mak imi mai lori surik ho ai dona atu kaer Hau? Imi hanoin Hau ema kriminozu ka? Afinal loro-loron Hau iha hela area uma kreda boot hodi hanorin, i imi la kaer Hau.<note caller="+" style="x"><char style="xo" closed="false">26:55: </char><char style="xt" closed="false"><ref loc="LUK 19:47">Lucas 19:47</ref>, <ref loc="LUK 21:37">21:37</ref></char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Maibee buat sira nee hotu akontese hodi kumpri saida mak profeta sira foo sai tiha ona iha Livru Sagradu.” Depois Jesus nia eskolante sira husik hela Nia hodi halai namkari hotu.<verse eid="MAT 26:56" /></para>
  <para style="s">Nai Jesus iha justisa nain relijiaun Judeu nia oin</para>
  <para style="r">(<ref loc="MRK 14:53-65">Marcos 14:53-65</ref>; <ref loc="LUK 22:54-55">Lucas 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">João 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Depois ema nebee kaer Jesus lori Nia ba iha nai lulik boot Kaifás nia uma. Iha nebaa mestri relijiaun sira ho katuas lia nain sira halibur hamutuk ona atu foo justisa ba Jesus. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Pedro lao tu-tuir Jesus husi dook deit, i tama liu ba moru laran. Nia tuur hamutuk ho ema seguransa sira iha uma oin, atu hatene tuir saida mak akontese ba Jesus.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Iha uma laran, nai lulik nia ulun sira ho justisa nain relijiaun Judeu sira seluk buka hela ema atu foo sasin falsu para bele kastigu mate Jesus. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Maski ema barak mai hamriik iha oin hodi duun Nia, maibee justisa nain sira la hetan sala ida atu bele kastigu Nia. Too ikus ema nain rua tan baa hamriik iha oin <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />hodi foo sasin dehan, “Ema nee hatete hanesan nee: ‘Hau bele halo rahun Maromak nia uma kreda boot nee, depois iha loron tolu nia laran Hau bele harii fila fali.’ ”<note caller="+" style="x"><char style="xo" closed="false">26:61: </char><char style="xt" closed="false"><ref loc="JHN 2:19">João 2:19</ref></char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Depois nai lulik boot hamriik hodi dehan ba Jesus, “Ema sira nee foo sasin tiha ona kona ba O nia sala. Nusaa mak O la hataan sira?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Maibee Jesus nonook deit.</para>
  <para style="p" vid="MAT 26:63">Nunee nai lulik boot dehan, “Jura took hodi Maromak Moris nia naran, O mak Mesias, Maromak nia Oan, ka?”<note caller="+" style="f"><char style="fr" closed="false">26:63: </char><char style="ft" closed="false">Liafuan Mesias dehan, Ema ida nebee Maromak hili nanis ona atu salva Nia povu hodi ukun sira.</char></note><verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Jesus hataan, “Ita dehan nee loos. Maibee Hau hatete ba imi, aban-bainrua imi sei haree Hau, Ema Umanu nia Oan tuur iha Maromak Kbiit Nain nia sorin loos. I imi sei haree Hau tuun mai husi lalehan iha kalohan laran.”<note caller="+" style="x"><char style="xo" closed="false">26:64: </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daniel 7:13</ref></char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Rona nunee, nai lulik boot nee hirus too lees tiha nia batina hodi dehan ba justisa nain sira, “Agora imi rona rasik ona Nia liafuan. Nia hatete aat Maromak! Nusaa mak ita hein tan sasin seluk? <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Imi foo justisa oinsaa?”</para>
  <para style="p" vid="MAT 26:66">Justisa nain sira hataan, “Nia merese mate.”<note caller="+" style="x"><char style="xo" closed="false">26:66: </char><char style="xt" closed="false"><ref loc="LEV 24:16">Levítiku 24:16</ref></char></note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Depois sira tafui kabeen ba Jesus nia oin i baku Nia. Balu basa Nia hasan<note caller="+" style="x"><char style="xo" closed="false">26:67: </char><char style="xt" closed="false"><ref loc="ISA 50:6">Isaias 50:6</ref></char></note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />hodi husu, “He, Mesias, Profeta, foo sai took, see mak baku O nee?”<verse eid="MAT 26:68" /></para>
  <para style="s">Pedro nega Nai Jesus dala tolu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Marcos 14:66-72</ref>; <ref loc="LUK 22:56-62">Lucas 22:56-62</ref>; <ref loc="JHN 18:15-18">João 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Pedro sei tuur hela iha uma oin, iha kriada ida mai besik nia dehan, “O mos hamutuk ho Jesus, Ema Galileia nee.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Maibee Pedro nega iha ema hotu nia oin dehan, “Hau la hatene buat nebee o koalia nee.”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Depois Pedro sai ba iha portaun, kriada ida tan haree nia i hatete ba ema nebee mak besik dehan, “Ema nee ohin hamutuk ho Jesus, Ema Nazaré.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Pedro nega tan dala ida hodi dehan, “Hau jura, hau la konhese Ema nee.”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />La kleur ema sira nebee hamriik iha nebaa mai besik Pedro hodi dehan, “O nee Nia ema duni. Tanba o koalia hanesan ema Galileia.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Maibee Pedro jura dehan, “Hau la konhese Ema nee. Se hau bosok karik, husik Maromak kastigu hau ba.” Derepenti manu kokoreek.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Rona nunee, Pedro hanoin fila fali liafuan nebee uluk Jesus dehan, “Molok manu kokoreek, o sei nega Hau dala tolu.” Entaun Pedro sai husi nebaa i tanis ho laran dodok.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Ema lori Nai Jesus ba iha governador Pilatus</para>
  <para style="r">(<ref loc="MRK 15:1">Marcos 15:1</ref>; <ref loc="LUK 23:1-2">Lucas 23:1-2</ref>; <ref loc="JHN 18:28-32">João 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Dadeer-saan deit, nai lulik nia ulun sira ho katuas lia nain sira foti desizaun atu kastigu mate Jesus. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Depois sira futu Nia hodi lori Nia baa entrega ba governador Pilatus.<note caller="+" style="f"><char style="fr" closed="false">27:2: </char><char style="ft" closed="false">Iha tempu nebaa ema Judeu la iha direitu atu desidi kastigu mate ema. Tanba nee, sira lori Nai Jesus ba iha estadu Roma atu tesi tan Nia lia.</char></note><verse eid="MAT 27:2" /></para>
  <para style="s">Judas tara aan</para>
  <para style="r">(<ref loc="ACT 1:18-19">Apostolu sira nia Istoria 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Bainhira Judas, eskolante nebee mak faan Jesus nee, hatene katak sira atu kastigu mate Jesus, nia laran tristi teb-tebes. Nunee nia entrega fali osan mutin tolu-nulu nee ba nai lulik nia ulun sira ho katuas lia nain sira. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Nia hatete, “Hau halo sala ona! Ema ida nebee la iha sala sei mate tanba hau mak faan.”</para>
  <para style="p" vid="MAT 27:4">Maibee sira hataan, “Ami la interese. O halo sala ka lae, nee o mak hatene.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Entaun Judas soe osan nee ba iha uma kreda boot laran. Depois nia sai baa tara aan mate tiha.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Nai lulik nia ulun sira hili tiha osan nebee mak Judas soe nee hodi dehan, “Osan nee raan nia folin. Lei bandu atu hatama fali hamutuk ho osan uma kreda boot nian.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Entaun sira desidi uza osan nee hodi sosa rai pedasuk nebee uluk badaen sanan rai nian. I sira foo rai nee atu sai fatin hodi hakoi ema estranjeiru. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Too agora ema bolu rai nee Rai Raan.<note caller="+" style="x"><char style="xo" closed="false">27:8: </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">Apostolu sira nia Istoria 1:18-19</ref></char></note><verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Nunee sira halo tuir liafuan nebee profeta Jeremias hakerek hori uluk dehan, “Ema Israel sira desidi tiha ona katak, Nia folin mak osan mutin tolu-nulu. Entaun sira foti osan nee <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />hodi sosa rai nebee uluk badaen sanan rai nian, tuir orden nebee mak Nai Maromak foo mai hau.”<note caller="+" style="x"><char style="xo" closed="false">27:10: </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">Zacarias 11:12-13</ref>; <ref loc="JER 18:2-4">Jeremias 18:2-4</ref>, <ref loc="JER 19:1-11">19:1-11</ref>, <ref loc="JER 32:6-15">32:6-15</ref></char></note><verse eid="MAT 27:10" /></para>
  <para style="s">Nai Jesus iha governador Pilatus nia oin</para>
  <para style="r">(<ref loc="MRK 15:2-5">Marcos 15:2-5</ref>; <ref loc="LUK 23:3-5">Lucas 23:3-5</ref>; <ref loc="JHN 18:33-38">João 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Bainhira Jesus hamriik iha governador Pilatus nia oin, governador husu ba Nia, “Loos ka, O mak ema Judeu sira nia Liurai ka?”</para>
  <para style="p" vid="MAT 27:11">Jesus hataan, “Ita dehan nee loos.”<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Maibee bainhira nai lulik nia ulun sira ho katuas lia nain sira duun Jesus iha Pilatus nia oin, Jesus la hataan buat ida.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Entaun Pilatus hatete ba Jesus dehan, “O la rona ka? Ema sira nee foo sasin oi-oin hodi hasoru O!”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Maibee Nia la hataan, uitoan mos lae, halo governador Pilatus admira loos.<verse eid="MAT 27:14" /></para>
  <para style="s">Governador Pilatus hamonu kastigu mate ba Nai Jesus</para>
  <para style="r">(<ref loc="MRK 15:6-15">Marcos 15:6-15</ref>; <ref loc="LUK 23:13-25">Lucas 23:13-25</ref>; <ref loc="JHN 18:39-19:16">João 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Tin-tinan, bainhira ema Judeu halo festa Paskua, governador sempre hasai ema dadur ida tuir povu nia hakarak. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Iha tempu nebaa iha ema dadur ida naran Barabás, ema hotu konhese nia kriminozu boot ida. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Entaun bainhira ema barak halibur hamutuk ona, Pilatus husu ba sira dehan, “Imi hakarak hau husik ida nebee? Barabás ka Jesus nebee ema bolu Mesias?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pilatus koalia nunee tanba nia hatene hela nai ulun Judeu sira laran moras ba Jesus, nee mak sira entrega Jesus ba nia.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Bainhira Pilatus tuur iha kadeira juis nian atu tesi Jesus nia lia, nia feen haruka lia menon dehan, “Keta halo buat ruma ba Ema nee tanba Nia la sala ida. Hau ohin mehi aat kona ba Nia, halo hau hanoin barak.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Maibee nai lulik nia ulun sira ho katuas lia nain sira obriga deit ema barak nee husu ba Pilatus atu husik Barabás, i oho Jesus. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Depois governador Pilatus husu fali dehan, “Husi ema nain rua nee, imi hakarak hau husik ida nebee?”</para>
  <para style="p" vid="MAT 27:21">Sira hataan, “Barabás!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Rona nunee Pilatus husu tan, “Entaun hau atu halo saida ba Jesus nebee ema bolu Mesias nee?”</para>
  <para style="p" vid="MAT 27:22">Sira hotu hakilar, “Prega tiha Nia ba krus!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Depois Pilatus husu, “Tansaa? Nia halo krimi saida?”</para>
  <para style="p" vid="MAT 27:23">Maibee sira hakilar makaas liu tan, “Prega tiha Nia ba krus!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pilatus haree katak ema barak nee atu halo rungu-ranga, i nia la bele halo buat ida. Entaun nia foti bee hodi fase nia liman iha ema barak nee nia oin dehan, “Kona ba Ema nee nia mate, hau la hatene! Imi mak sei lori todan.”<note caller="+" style="x"><char style="xo" closed="false">27:24: </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">Deuteronómiu 21:6-9</ref></char></note><verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Sira hotu hataan, “Husik ba, Ema nee nia raan, ami ho ami nia jerasaun sira mak lori.”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Entaun Pilatus halo tuir sira nia hakarak hodi hasai Barabás husi kadeia. I nia haruka ema baku Jesus ho sikoti, depois entrega Jesus ba soldadu sira atu prega iha krus.<verse eid="MAT 27:26" /></para>
  <para style="s">Soldadu sira hamoe Nai Jesus</para>
  <para style="r">(<ref loc="MRK 15:16-20">Marcos 15:16-20</ref>; <ref loc="JHN 19:2-3">João 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Hotu tiha soldadu sira lori Jesus ba iha governador Pilatus nia rezidensia<note caller="+" style="f"><char style="fr" closed="false">27:27 </char><char style="ft" closed="false">Tradusaun balu hakerek “Praetóriu”. Nee lian Latin hodi hatudu ba governador nia palasiu.</char></note> i sira halibur sira nia maluk soldadu sira seluk nebee hela iha nebaa hodi mai haleu Nia. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Sira kolu tiha Jesus nia hena hodi foo hatais fali batina kor mean ida hanesan liurai sira baibain hatais. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Sira mos dulas ai tarak halo kabuar hanesan koroa liurai nian hodi tau ba Nia ulun. Sira tau ai sanak lotuk ida iha Nia liman loos hanesan ai tonka. Sira hakneak iha Nia oin hodi hamoe Nia dehan, “Viva, ema Judeu sira nia Liurai!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Sira mos tafui kabeen ba Nia i foti fali ai sanak nee husi Nia liman laran hodi baku Nia ulun fila-fila. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Sira hamoe tiha Nia nunee, sira kolu fali batina mean hodi foo hatais fali Nia hena rasik. Hotu tiha sira lori Nia sai atu baa prega iha krus.<verse eid="MAT 27:31" /></para>
  <para style="s">Ema prega Nai Jesus iha krus</para>
  <para style="r">(<ref loc="MRK 15:21-32">Marcos 15:21-32</ref>; <ref loc="LUK 23:26-43">Lucas 23:26-43</ref>; <ref loc="JHN 19:17-27">João 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Iha dalan klaran, soldadu sira nebee mak lori Jesus nee hetan ema ida husi sidade Sirene, naran Simão. Sira obriga nia lori Jesus nia krus. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Sira too iha fatin ida naran Golgota, katak “Fatin Ulun Ruin”. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Iha nebaa sira kahur tua ho aimoruk hodi foo ba Jesus. Nia koko tiha maibee lakohi hemu.<note caller="+" style="x"><char style="xo" closed="false">27:34: </char><char style="xt" closed="false"><ref loc="PSA 69:22">Salmu 69:22</ref></char></note><verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Depois sira prega Jesus iha krus. I soldadu sira dada rifa atu hatene see mak bele hetan Jesus nia hena.<note caller="+" style="x"><char style="xo" closed="false">27:35: </char><char style="xt" closed="false"><ref loc="PSA 22:19">Salmu 22:19</ref></char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Hotu tiha sira tuur hodi hein Nia. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Sira mos iha ai kabelak ida nebee hakerek nunee: “Nee Jesus, ema Judeu sira nia Liurai.” Nee foo hatene razaun saida mak Jesus simu kastigu mate. I sira prega ai kabelak nee iha Nia ulun leten.<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Sira prega tan ema naok-teen boot nain rua iha krus, ida iha Jesus nia sorin loos, ida iha sorin karuk.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Ema nebee liu husi fatin nee, sira doko ulun hodi koalia aat Jesus.<note caller="+" style="x"><char style="xo" closed="false">27:39: </char><char style="xt" closed="false"><ref loc="PSA 22:8">Salmu 22:8</ref>, <ref loc="PSA 109:25">109:25</ref></char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Sira hatete, “Uluk O dehan atu halo rahun uma kreda boot, depois harii fali iha loron tolu nia laran. Se O Maromak nia Oan duni, entaun salva took O nia Aan hodi tuun husi krus nee.”<note caller="+" style="x"><char style="xo" closed="false">27:40: </char><char style="xt" closed="false"><ref loc="MAT 26:61">Mateus 26:61</ref>; <ref loc="JHN 2:19">João 2:19</ref></char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Nai lulik nia ulun sira, mestri relijiaun sira ho katuas lia nain sira mos hatete aat Jesus dehan, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Nia salva ona ema seluk, maibee Nia la bele salva Nia Aan rasik. Nia dehan, Nia mak ema Israel nia Liurai, entaun diak liu agora Nia tuun husi krus atu ita fiar. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Nia fiar ba Maromak. Se Maromak gosta Nia, entaun ita haree took Maromak mai salva Nia ka lae. Tanba Nia rasik hatete katak Nia Maromak nia Oan.”<note caller="+" style="x"><char style="xo" closed="false">27:43: </char><char style="xt" closed="false"><ref loc="PSA 22:9">Salmu 22:9</ref></char></note><verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Naok-teen nain rua nebee mak iha Jesus nia sor-sorin mos tarata aat Jesus nunee.<verse eid="MAT 27:44" /></para>
  <para style="s">Nai Jesus mate</para>
  <para style="r">(<ref loc="MRK 15:33-41">Marcos 15:33-41</ref>; <ref loc="LUK 23:44-49">Lucas 23:44-49</ref>; <ref loc="JHN 19:28-30">João 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Komesa meudia, nakukun taka metin rejiaun nee tomak too tuku tolu lokraik. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Iha tuku tolu lokraik, Jesus hakilar ho lian makaas dehan, “Eloi, Eloi, lama sabaktani?” Nee dehan, “Hau nia Maromak, Hau nia Maromak, tansaa mak Ita Boot husik Hau mesak?”<note caller="+" style="x"><char style="xo" closed="false">27:46: </char><char style="xt" closed="false"><ref loc="PSA 22:2">Salmu 22:2</ref></char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Rona nunee, ema balu nebee hamriik besik dehan, “Nia bolu profeta Elias.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Sira ida halai kedas baa foti esponza rohan ida habokon ho tua siin, tau ba ai naruk ida hodi lolo ba iha Jesus nia ibun atu hemu.<note caller="+" style="x"><char style="xo" closed="false">27:48: </char><char style="xt" closed="false"><ref loc="PSA 69:22">Salmu 69:22</ref></char></note><verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Maibee sira seluk dehan, “Hein lai! Ita haree took, Elias mai salva duni Nia ka lae.”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Depois Jesus hakilar dala ida tan ho lian makaas, i Nia hakotu Nia iis.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Bainhira Jesus nia iis kotu, kurtina boot nebee taka Fatin Lulik iha uma kreda boot, naklees husi leten too kraik fahe tiha ba rua. Rai nakdoko makaas i fatuk bo-boot sira nakfera tiha.<note caller="+" style="x"><char style="xo" closed="false">27:51: </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Ézodu 26:31-33</ref></char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Rate sira mos nakloke. I Maromak nia ema balu nebee mate tiha ona, Nia halo moris fali. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Sira ida-idak sai husi sira nia rate. Bainhira Jesus moris fila fali, sira mos tama iha sidade santu Jerusalém, i ema barak haree.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Bainhira komandante Roma ho soldadu sira nebee hein Jesus nee haree rai nakdoko ho buat seluk nebee akontese, sira tauk teb-tebes hodi dehan, “Loos duni! Ema nee Maromak nia Oan.”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Iha nebaa iha senhora barak asisti husi dook deit. Sira nee uluk tuir Jesus husi Galileia too iha Jerusalém hodi serbi Nia. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Sira nee mak Maria Madalena, Maria ida seluk (Tiago ho José nia inan), Zebedeu nia feen (Tiago ho João nia inan) ho mos sel-seluk tan.<note caller="+" style="x"><char style="xo" closed="false">27:56: </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Lucas 8:2-3</ref></char></note><verse eid="MAT 27:56" /></para>
  <para style="s">Ema hakoi Nai Jesus nia mate isin</para>
  <para style="r">(<ref loc="MRK 15:42-47">Marcos 15:42-47</ref>; <ref loc="LUK 23:50-56">Lucas 23:50-56</ref>; <ref loc="JHN 19:38-42">João 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Iha ema riku ida husi sidade Arimateia, naran José. Nia mos Jesus nia eskolante ida. Loro matan atu monu ona, <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />nia baa hasoru Pilatus hodi husu Jesus nia mate isin atu hakoi. Entaun Pilatus haruka soldadu sira entrega Jesus nia mate isin ba José. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Depois José simu Jesus nia mate isin, i falun ho hena mutin diak nian nebee foun. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Nia lori Jesus nia mate isin baa haloot iha rate nebee nia prepara tiha ona ba nia aan rasik. Fatin nee fatuk lolon nebee ema bahat tiha ona atu sai rate. Depois nia duir fatuk boot ida hodi taka rate nee. Hotu tiha nia fila.<verse eid="MAT 27:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MAT 27:61" />Maibee Maria Madalena ho Maria ida seluk tuur hela hodi hateke ba rate nee.<verse eid="MAT 27:61" /></para>
  <para style="s">Soldadu sira halo seguransa metin iha Nai Jesus nia rate</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Iha fali aban, loron Sabadu, nai lulik nia ulun sira ho ema Farizeu sira baa hasoru malu ho governador Pilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Sira dehan, “Senhor, ami hanoin hela Ema bosok-teen nee nia liafuan. Uluk Nia sei moris, Nia dehan katak too iha loron tolu Maromak sei halo Nia moris fali.<note caller="+" style="x"><char style="xo" closed="false">27:63: </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mateus 16:21</ref>, <ref loc="MAT 17:23">17:23</ref>, <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">Marcos 8:31</ref>, <ref loc="MRK 9:31">9:31</ref>, <ref loc="MRK 10:33-34">10:33-34</ref>; <ref loc="LUK 9:22">Lucas 9:22</ref>, <ref loc="LUK 18:31-33">18:31-33</ref></char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Nee duni haruka ita boot nia soldadu sira baa halo seguransa iha rate too iha loron tolu. Keta halo be Nia eskolante sira mai naok tiha Nia mate isin, depois sira dehan, Maromak halo Nia moris fali ona husi mate. Se ida nee mak akontese, entaun sira nee bosok aat liu fali sira nia Mestri.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pilatus hataan, “Entaun lori soldadu balu ba iha rate hodi halo seguransa metin iha nebaa.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Nunee nai ulun Judeu sira hamutuk ho soldadu sira baa iha rate. Sira tau sinal ba rate nee nia odamatan atu ema keta tama. Depois soldadu sira halo seguransa nafatin iha nebaa.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Nai Jesus moris fila fali</para>
  <para style="r">(<ref loc="MRK 16:1-10">Marcos 16:1-10</ref>; <ref loc="LUK 24:1-12">Lucas 24:1-12</ref>; <ref loc="JHN 20:1-10">João 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Aban fali iha loron Domingu dadeer-saan nakukun, Maria Madalena ho Maria ida seluk baa haree rate. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Derepenti rai nakdoko makaas teb-tebes tanba Nai Maromak nia anju ida tuun mai husi lalehan hodi duir tiha fatuk nebee taka rate nee. Depois nia tuur iha leten. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Anju nee nia oin nabilan hanesan rai lakan, i nia hena mutin loos. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Haree nunee, seguransa sira tauk teb-tebes too sira nakdedar i monu tiha ba rai hanesan ema mate.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Depois anju hatete ba senhora nain rua nee dehan, “La bele tauk. Hau hatene imi buka hela Jesus, Ida nebee ema prega tiha ona ba krus nee. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Nia la iha nee ona, tanba Maromak halo moris fali ona Nia, tuir buat nebee uluk Nia hatete tiha ona. Mai haree fatin nebee mak ema tau Nia mate isin nee. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Haree tiha, imi baa lalais foo hatene Nia eskolante sira dehan, ‘Maromak halo moris fali ona Jesus husi mate. Nia sei baa iha Galileia hodi hein imi, i imi sei haree Nia iha nebaa.’ Keta haluha hau nia lia menon nee.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Nunee senhora nain rua nee husik kedas rate. Sira tauk maibee sira mos haksolok teb-tebes. Sira halai lalais atu baa foo hatene Jesus nia eskolante sira.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Iha dalan klaran, derepenti Jesus hasoru sira i kumprimenta sira. Entaun sira baa besik Nia i hakruuk hakuak Nia ain hodi adora Nia. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Depois Jesus hatete ba sira, “La bele tauk. Baa foo hatene Hau nia maluk sira atu sira baa iha Galileia. Iha nebaa sira sei haree Hau.”<verse eid="MAT 28:10" /></para>
  <para style="s">Ema seguransa iha rate habelar lia falsu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Bainhira senhora sira nee lao dadauk, seguransa sira balu hamriik hodi baa iha sidade Jerusalém. Too iha nebaa, sira konta ba nai lulik nia ulun sira kona ba buat hotu-hotu nebee mak ohin akontese iha rate. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Entaun nai lulik nia ulun sira hasoru malu ho katuas lia nain sira hodi halo planu. Sira foo osan barak ba soldadu sira nebee kontrola rate nee. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />I sira hameno dehan, “Imi tenki foo sai dehan, ‘Iha kalan boot bainhira ami toba dukur hela, Nia eskolante sira mai naok tiha Nia mate isin.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Se governador rona karik, ami mak baa koalia ho nia atu nunee imi la bele hetan kastigu.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Entaun ema seguransa sira simu osan nee i habelar lia falsu nebee mak hameno tiha ona ba sira. Too agora istoria nee ema Judeu sira sei konta nafatin.<verse eid="MAT 28:15" /></para>
  <para style="s">Nai Jesus Nia lia menon ikus</para>
  <para style="r">(<ref loc="MRK 16:14-18">Marcos 16:14-18</ref>; <ref loc="LUK 24:36-49">Lucas 24:36-49</ref>; <ref loc="JHN 20:19-23">João 20:19-23</ref>; <ref loc="ACT 1:6-8">Apostolu sira nia Istoria 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Depois Jesus nia eskolante nain sanulu resin ida baa sae foho ida iha provinsia Galileia, tuir buat nebee Jesus hameno tiha ona ba sira.<note caller="+" style="x"><char style="xo" closed="false">28:16: </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mateus 26:32</ref>; <ref loc="MRK 14:28">Marcos 14:28</ref></char></note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Bainhira sira haree Jesus, sira adora Nia. Maibee sira balu sei duvida hela.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />Depois Jesus baa besik sira hodi dehan, “Maromak foo tiha ona kbiit tomak mai Hau atu ukun buat hotu-hotu iha lalehan ho rai. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Tanba nee, baa hanorin ema iha nasaun hotu-hotu atu sira sai Hau nia eskolante. Foo sarani sira hodi Aman, Oan ho Espiritu Santu sira nia naran.<note caller="+" style="x"><char style="xo" closed="false">28:19: </char><char style="xt" closed="false"><ref loc="ACT 1:8">Apostolu sira nia Istoria 1:8</ref></char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Hanorin sira atu halo tuir buat hotu-hotu nebee mak Hau hatete ona ba imi. Keta haluha, Hau sempre hamutuk ho imi too mundu nee remata.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>