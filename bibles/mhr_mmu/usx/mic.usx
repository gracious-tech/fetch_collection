<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Meadow Mari Bible</book>
  <para style="h">Мих</para>
  <para style="toc3">Мих</para>
  <para style="toc2">Михей</para>
  <para style="toc1">Пророк Михейын книгаже</para>
  <para style="mt">ПРОРОК МИХЕЙЫН КНИГАЖЕ</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">Господьын Михейлан каласыме шомакше. Самарий ден Иерусалимын пытымышт.</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Теве Господьын шомакше, тудо Морасфа гыч Михейлан лийын. Тиде Иуда кугыжа-влак Иофамын, Ахазын да Езекийын вуйлатымышт годым лийын. Теве мом тудлан Самарий ден Иерусалим шотышто ончыктымо улмаш.<verse eid="MIC 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />Колыштса, калык-влак,</para>
  <para style="q1" vid="MIC 1:2">мланде да мо тушто уло, тӱткын колыштса!</para>
  <para style="q1" vid="MIC 1:2">Тек Господь Юмо тендан ваштареш таныклыше лиеш,</para>
  <para style="q1" vid="MIC 1:2">тек Господь шке святой храмже гыч ойла!<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />Теве Господь шке верже гыч лектеш,</para>
  <para style="q1" vid="MIC 1:3">мландын кӱкшӧ верлаж дене ошкылын, Тудо вола.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />Кузе тул дечын шыште лева,</para>
  <para style="q1" vid="MIC 1:4">кузе тайыл дене вӱд йога,</para>
  <para style="q1" vid="MIC 1:4">туге Тудын йымалныже курык-влак леват,</para>
  <para style="q1" vid="MIC 1:4">лапвер-влак шелалтыт.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />Чыла тиде Иаковын осал пашажлан кӧра,</para>
  <para style="q2" vid="MIC 1:5">Израиль тукымын сулыкшылан кӧра лийын.</para>
  <para style="q1" vid="MIC 1:5">Кӧ дечын Иаков тидлан тунемын?</para>
  <para style="q1" vid="MIC 1:5">Самарий деч огыл мо?</para>
  <para style="q1" vid="MIC 1:5">Иуда мландыште кумалме кӱкшакам ыштымылан кӧ титакан?</para>
  <para style="q1" vid="MIC 1:5">Иерусалим огыл мо?<verse eid="MIC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />«Садлан Мый Самарий деч кӱ орам гына кодем,</para>
  <para style="q1" vid="MIC 1:6">тиде вер виноград аҥалан веле йӧра.</para>
  <para style="q1" vid="MIC 1:6">Кӱжӧ-влакым лапверыш кудалтем,</para>
  <para style="q1" vid="MIC 1:6">тудым негыз марте шалатем.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />Чыла шояк юмыжо шалатыме,</para>
  <para style="q1" vid="MIC 1:7">яжарланен налме пӧлекше-влак йӱлалтыме лийыт.</para>
  <para style="q1" vid="MIC 1:7">Чыла полган юмыжым Мый пытарем,</para>
  <para style="q1" vid="MIC 1:7">вет тудо нуным нине пӧлек гыч ыштен,</para>
  <para style="q1" vid="MIC 1:7">да нуно угыч яжар-влаклан тӱлымӧ пӧлек лийыт».<verse eid="MIC 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />Тидлан верч мый шорташ да ойгыраш,</para>
  <para style="q1" vid="MIC 1:8">чарайола да чараматын кошташ тӱҥалам.</para>
  <para style="q1" vid="MIC 1:8">Тулпире семын урмыжаш,</para>
  <para style="q1" vid="MIC 1:8">страус семын магыраш тӱҥалам,<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />вет Самарийын сусыржо паремдаш лийдыме,</para>
  <para style="q1" vid="MIC 1:9">тудо Иуда мланде марте,</para>
  <para style="q1" vid="MIC 1:9">эсогыл калыкемын капкаж деке,</para>
  <para style="q1" vid="MIC 1:9">Иерусалим марте шуын.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />Ида каласкале тидын нерген Гефыште,</para>
  <para style="q1" vid="MIC 1:10">тушто йӱкын ида шорт.</para>
  <para style="q1" vid="MIC 1:10">Бет-Офраште ӱмбакыда ломыжым шавыза!<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />Шафирыште илыше-влак,</para>
  <para style="q1" vid="MIC 1:11">чара да мыскылалтше кайыза!</para>
  <para style="q1" vid="MIC 1:11">Цааныште илыше-влак ола гыч лектын огыт керт!</para>
  <para style="q1" vid="MIC 1:11">Бет-Ецель шортеш, тудын деч полыш ок лий.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />Марофышто<note caller="*" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Мароф лӱм ’кочылык’ манмым ончыкта.</char></note> илыше-влак cайым тургыжланен вучат,</para>
  <para style="q1" vid="MIC 1:12">но Господь Иерусалимын капкаж деке ойгым колтен.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />Лахисыште илыше-шамыч,</para>
  <para style="q1" vid="MIC 1:13">имне-влакым орвашке кычкыза,</para>
  <para style="q1" vid="MIC 1:13">вет тендам ончен, Израиль сулыкыш пурен,</para>
  <para style="q1" vid="MIC 1:13">Сион ӱдырын осал пашаже-влак тендан деч тӱҥалыныт.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />Сандене те кузык шотеш пӧлек-влакым</para>
  <para style="q2" vid="MIC 1:14">Морешеф-Гефыш колтеда,</para>
  <para style="q1" vid="MIC 1:14">но Ахзив ола Израиль кугыжа-влаклан ондалчык лиеш.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />Тендан дек, Марешаште илыше-шамыч,</para>
  <para style="q1" vid="MIC 1:15">Мый адакат у озам кондем.<note caller="*" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">«Мареша» лӱм еврей йылмысе ’оза’ шомак дене ик семынрак йоҥга.</char></note></para>
  <para style="q1" vid="MIC 1:15">Израильын чапше, тудын онжо-влак, Одолламыш каят.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />Йӧратыме эргыда-влак верчын ойгырен,</para>
  <para style="q1" vid="MIC 1:16">ӱпдам нӱжын кудалтыза,</para>
  <para style="q1" vid="MIC 1:16">чаравуян кайык гай лийза,</para>
  <para style="q1" vid="MIC 1:16">вет йочада-влакым тендан деч пленыш наҥгаят.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="cl">2 ГЛАВА</para>
  <para style="cd">1 Йорло еҥым шыгыремдылше-влаклан ойго! 12 Утлен кодшо израильтян-шамычым Господь утараш сӧра.</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />Ойго нунылан, кӧмыт осалым ышташ шонат!</para>
  <para style="q1" vid="MIC 2:1">Малаш вочмекышт, нуно тидым кузе ышташ шонкалат,</para>
  <para style="q1" vid="MIC 2:1">а эрдене, волгыжмеке, шонымыштым шуктат,</para>
  <para style="q1" vid="MIC 2:1">вет тидым ышташ вийышт уло.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />Еҥ пасум налнешт – руалтен налыт,</para>
  <para style="q1" vid="MIC 2:2">пӧртым налнешт – тидымат ыштат:</para>
  <para style="q1" vid="MIC 2:2">озажым, тудын ешыжым шыгыремдат,</para>
  <para style="q1" vid="MIC 2:2">мландыштым шупшын налыт.<verse eid="MIC 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 2:3" />Сандене Господь тыге ойла:</para>
  <para style="q1" vid="MIC 2:3">«Тиде тукым ӱмбаке Мый тугай туткарым колташ шонем,</para>
  <para style="q1" vid="MIC 2:3">могайым ӱмбачда налын огыда кудалте.</para>
  <para style="q1" vid="MIC 2:3">Тетла оҥдам кадыртен ода кошт,</para>
  <para style="q1" vid="MIC 2:3">вет тиде ойган жап лиеш.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />Тудо кечын тендам сотараш тӱҥалыт,</para>
  <para style="q1" vid="MIC 2:4">шортмо мурым мурымо семын тыге мыскылат:</para>
  <para style="q1" vid="MIC 2:4">”Мучаш, мыланна мучаш толын,</para>
  <para style="q1" vid="MIC 2:4">калыкнан мландыжым весе-влаклан пуымо!</para>
  <para style="q1" vid="MIC 2:4">Тудым пӧртылташ лиеш мо?</para>
  <para style="q1" vid="MIC 2:4">Пасуна-влакым йот калык-шамыч пайленыт!”»<verse eid="MIC 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />Сандене Господьын калыкше коклаште</para>
  <para style="q1" vid="MIC 2:5">тыланет мландым шерева дене пайлыше нигӧ ок лий.<verse eid="MIC 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />Калык манеш: «Пророк шомакдам ида ойло!</para>
  <para style="q1" vid="MIC 2:6">Тыгай нерген пророклен ойлаш ок лий!</para>
  <para style="q1" vid="MIC 2:6">Ме намысыш огына пуро!»<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />Лиеш мо тыге ойлаш, Иаков тукым?</para>
  <para style="q1" vid="MIC 2:7">Господьын чытымашыже пытен мо?</para>
  <para style="q1" vid="MIC 2:7">Тудо тыгайым ышта ыле мо?</para>
  <para style="q1" vid="MIC 2:7">«Кӧ чын корно дене коштеш,</para>
  <para style="q1" vid="MIC 2:7">тудлан Мыйын шомакем сайлан огыл мо?<note caller="*" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">6-7 стихлаште мом возымым тӱрлын кусараш лиеш.</char></note><verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />Шукерте огыл те Мыйын калыкем лийында,</para>
  <para style="q1" vid="MIC 2:8">а кызыт тушман гайыш савырненда:</para>
  <para style="q1" vid="MIC 2:8">кӧмыт воктечда тыныслын эртен каят</para>
  <para style="q1" vid="MIC 2:8">але сар гыч пӧртылыт,</para>
  <para style="q1" vid="MIC 2:8">те вургемыштым кудашын налыда.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />Мыйын калыкемын ӱдырамашыштым</para>
  <para style="q1" vid="MIC 2:9">те йӧратыме пӧртышт гыч поктен луктыда,</para>
  <para style="q1" vid="MIC 2:9">йочаштым Мыйын пуымо мландем деч посна кодеда.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />Кынелза да кайыза, тетла тыште тыныс уке!</para>
  <para style="q1" vid="MIC 2:10">Шакшылалтмыжлан кӧра тиде вер пеш чот шалатыме лиеш.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />Иктаж шояче, муторгаж тендан деке толеш да</para>
  <para style="q1" vid="MIC 2:11">”Мый йошкар арака да пӱрӧ нерген ойлем!” манеш гын,</para>
  <para style="q1" vid="MIC 2:11">тудо тыланда келшен толшо пророк лиеш.<verse eid="MIC 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />Но Мый тендам, Иаков тукым, чыладам погем,</para>
  <para style="q1" vid="MIC 2:12">Израильын утлен кодшыжо-влакым иктеш чумырем –</para>
  <para style="q1" vid="MIC 2:12">кузе Восораште шорыкым, кӱтымӧ верыште кӱтӱм погат,</para>
  <para style="q1" vid="MIC 2:12">тугак нуным пырля чумырем.</para>
  <para style="q1" vid="MIC 2:12">Тунам кугу калык тӱшкан йӱкшӧ шокташ тӱҥалеш».<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />Нунын ончыч пырдыжым шалатыше кая,</para>
  <para style="q1" vid="MIC 2:13">чаракым шалатен, нуно капка гоч каят да тушечын лектыт.</para>
  <para style="q1" vid="MIC 2:13">Нунын ончыч кугыжашт кая,</para>
  <para style="q1" vid="MIC 2:13">а вуйлатышышт Господь лиеш.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="cl">3 ГЛАВА</para>
  <para style="cd">Израильын он ден пророкшо-влакым титаклымаш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 3:1" />Каласенам мый:</para>
  <para style="q1" vid="MIC 3:1">«Иаковын вуйлатышыже-влак,</para>
  <para style="q2" vid="MIC 3:1">Израиль тукымын онжо-влак, колыштса!</para>
  <para style="q1" vid="MIC 3:1">Те огыл мо чынлыкым палышаш улыда?<verse eid="MIC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 3:2" />А тендан порым ужмыда ок шу,</para>
  <para style="q1" vid="MIC 3:2">йӧратеда те осалым,</para>
  <para style="q1" vid="MIC 3:2">еҥ-влакын коваштыштым ньыктыда,</para>
  <para style="q1" vid="MIC 3:2">лушт деч шылым кӱрыштыда.<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />Те мыйын калыкем кочкыда,</para>
  <para style="q1" vid="MIC 3:3">еҥ-шамычын коваштыштым ньыктыда,</para>
  <para style="q1" vid="MIC 3:3">а лужо-влакым шалатеда.</para>
  <para style="q1" vid="MIC 3:3">Калыкем кӧршӧкыш пыштышаш шыл семын руэда,</para>
  <para style="q1" vid="MIC 3:3">пуйто подыш пышташ пӱчкыда».<verse eid="MIC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />Кунам нуно Господьым ӱжын кумалыт,</para>
  <para style="q1" vid="MIC 3:4">Тудо нунылан ок вашеште,</para>
  <para style="q1" vid="MIC 3:4">осал пашам ыштымыштлан кӧра</para>
  <para style="q2" vid="MIC 3:4">шке чурийжым нунын деч савыра.<verse eid="MIC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 3:5" />Пророк-влак шотышто Господь тыге ойла:</para>
  <para style="q1" vid="MIC 3:5">«Нуно Мыйын калыкем чын корно гыч кораҥдат.</para>
  <para style="q1" vid="MIC 3:5">Кӧмыт нуным пукшат –</para>
  <para style="q1" vid="MIC 3:5">нунылан тынысым пророклен ойлат,</para>
  <para style="q1" vid="MIC 3:5">а кӧ нимомат ок пу –</para>
  <para style="q1" vid="MIC 3:5">тудын ваштареш сарым увертарат.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />Садлан тендам кончымаш укеан йӱд авалта,</para>
  <para style="q1" vid="MIC 3:6">ончыкужмаш укеан тӱп пычкемыш вуча.</para>
  <para style="q1" vid="MIC 3:6">Кечын волгыдыжо нине пророк-влак дечын шылеш,</para>
  <para style="q1" vid="MIC 3:6">нунын кечышт пычкемыш лиеш.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />Вожылмашыш пурат ончыкужшо-влак,</para>
  <para style="q1" vid="MIC 3:7">мужедше-шамыч мыскылалтыт –</para>
  <para style="q1" vid="MIC 3:7">вожылмышт дене нуно чурийыштым петырат,</para>
  <para style="q1" vid="MIC 3:7">вет Юмо деч вашмут огеш лий».<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />А мый вий-куат да Господьын Шӱлышыж дене,</para>
  <para style="q2" vid="MIC 3:8">чынлык да лӱддымылык дене темынам –</para>
  <para style="q1" vid="MIC 3:8">Иаковлан осал пашаж нерген,</para>
  <para style="q2" vid="MIC 3:8">Израильлан сулыкшо нерген каласем.<verse eid="MIC 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />Колыштса тидым, Иаков тукым вуйлатыше-влак,</para>
  <para style="q1" vid="MIC 3:9">Израиль тукымын онжо-шамыч!</para>
  <para style="q1" vid="MIC 3:9">Чын суд деч те йырнеда,</para>
  <para style="q1" vid="MIC 3:9">чыла тура корным кадырым ыштеда,<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />Сионым вӱр дене чоҥеда,</para>
  <para style="q1" vid="MIC 3:10">Иерусалимым – закондымылык дене!<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />Тыште вуйлатыше-влак судитлымыштлан взяткым налыт,</para>
  <para style="q1" vid="MIC 3:11">иерей-шамычын туныктымыштлан тӱлыман,</para>
  <para style="q1" vid="MIC 3:11">пророк-влакын ойлымыштлан оксам пуыман.</para>
  <para style="q1" vid="MIC 3:11">Но тидын годым нуно Господьлан эҥертат,</para>
  <para style="q1" vid="MIC 3:11">тыге ойлат: «Господь мемнан коклаште огыл мо?</para>
  <para style="q1" vid="MIC 3:11">Мемнан деке туткар огеш тол!»<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />Сандене тыланда верч Сионым пасу семын куралыт,</para>
  <para style="q1" vid="MIC 3:12">Иерусалим кӱ орашке савырна,</para>
  <para style="q1" vid="MIC 3:12">а тиде курыкышто, кушан Юмын пӧртым чоҥеныт,</para>
  <para style="q1" vid="MIC 3:12">кушкын шогалеш чодыра!<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="cl">4 ГЛАВА</para>
  <para style="cd">1 Ончыкшым мландымбалне сар огеш лий. 6 Израиль калык плен гыч пӧртылеш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />Пытартыш кечылаште тыге лиеш:</para>
  <para style="q1" vid="MIC 4:1">курык, кушто Господьын пӧртшӧ шинча,</para>
  <para style="q1" vid="MIC 4:1">чыла курык ден кӱкшака деч кӱшнӧ шогаш тӱҥалеш,</para>
  <para style="q1" vid="MIC 4:1">да тудын дек калык-влак вӱд гай йоген толыт.<verse eid="MIC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 4:2" />Шуко калык тушко мия да каласа:</para>
  <para style="q1" vid="MIC 4:2">«Толза, Господьын курыкышкыжо</para>
  <para style="q2" vid="MIC 4:2">да Иаковын Юмыжын пӧртышкыжӧ кӱзена.</para>
  <para style="q1" vid="MIC 4:2">Тудо мемнам шке корныжлан туныкта,</para>
  <para style="q1" vid="MIC 4:2">да ме Тудын йолгорныж дене кошташ тӱҥалына,</para>
  <para style="q1" vid="MIC 4:2">вет Сион гычын закон лектеш,</para>
  <para style="q1" vid="MIC 4:2">Иерусалим гыч – Господьын шомакше».<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />Тудо шуко калыклан судым ышта,</para>
  <para style="q1" vid="MIC 4:3">тора эллаште виян тукым-влакым мут кучаш шогалта.</para>
  <para style="q1" vid="MIC 4:3">Шке кердышт гыч нуно шогавуйым,</para>
  <para style="q2" vid="MIC 4:3">умдышт гыч сорлам таптен ыштат.</para>
  <para style="q1" vid="MIC 4:3">Ик калык вес калык ӱмбаке керде дене ок кае,</para>
  <para style="q1" vid="MIC 4:3">кредалаш тетла огыт тунем.<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />Кажныже виноград ден смоква пушеҥгыже йымалне</para>
  <para style="q2" vid="MIC 4:4">шинчаш тӱҥалеш,</para>
  <para style="q1" vid="MIC 4:4">нигӧ нуным ок лӱдыктӧ,</para>
  <para style="q1" vid="MIC 4:4">вет Господь Саваоф тыге каласен.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />Кажне калык шке юмыжын лӱмжым ӱжын ила,</para>
  <para style="q1" vid="MIC 4:5">а ме Господь Юмынан лӱмжылан курымеш инанен илена.<verse eid="MIC 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />«Тудо кечын, – ойла Господь, –</para>
  <para style="q1" vid="MIC 4:6">окшак-влакым, поктен колтымо-влакым погем,</para>
  <para style="q1" vid="MIC 4:6">кӧмытлан ойгым колтенам, чылаштым чумырем.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />Окшак-влак гыч утаралт кодшо калыкым ыштем,</para>
  <para style="q1" vid="MIC 4:7">шалатен колтымо-влак гыч – виян калыкым.</para>
  <para style="q1" vid="MIC 4:7">Господь нуным Сион курыкышто</para>
  <para style="q2" vid="MIC 4:7">тиде жап гыч курым-курымеш вуйлаташ тӱҥалеш».<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />А тый, кӱтӱ-влак кокласе башне,</para>
  <para style="q1" vid="MIC 4:8">Сион ӱдырын кӱкшакаже!</para>
  <para style="q1" vid="MIC 4:8">Ончычсо кучемвиетым мӧҥгеш налат,</para>
  <para style="q1" vid="MIC 4:8">кугыжа кучемвий угыч Иерусалим ӱдырын лиеш.<verse eid="MIC 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />А молан тый кызыт кугу йӱкын магырет?</para>
  <para style="q1" vid="MIC 4:9">Тыйын кугыжат уке мо?</para>
  <para style="q1" vid="MIC 4:9">Але каҥашым пуышет уке?</para>
  <para style="q1" vid="MIC 4:9">Азам ыштыше ӱдырамашын гай орлык тыйым авалтен.<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />Азам ыштыше ӱдырамаш семын</para>
  <para style="q2" vid="MIC 4:10">корштымо деч кечкыж да кугыргыл, Сион ӱдыр,</para>
  <para style="q1" vid="MIC 4:10">вет кызыт тылат олам кодаш логалеш,</para>
  <para style="q1" vid="MIC 4:10">чара пасушто тый илаш тӱҥалат.</para>
  <para style="q1" vid="MIC 4:10">Миен шуат Вавилон марте –</para>
  <para style="q1" vid="MIC 4:10">тушто тый утарыме лият,</para>
  <para style="q1" vid="MIC 4:10">тушто тыйым Господь</para>
  <para style="q2" vid="MIC 4:10">тушман-влакетын кидышт гыч сулен налеш.<verse eid="MIC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />А кызыт тыйын ваштареш шуко калык погынен.</para>
  <para style="q1" vid="MIC 4:11">Ойлат нуно: «Тек тудо шакшылыме лиеш,</para>
  <para style="q1" vid="MIC 4:11">тек шинчана Сионын пытымыжым ужеш!»<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />Но нуно Господьын шонымыжым огыт пале,</para>
  <para style="q1" vid="MIC 4:12">Тудын мом шонен пыштымыжым огыт умыло,</para>
  <para style="q1" vid="MIC 4:12">вет Тудо нуным идымыш кылтам погымо семын поген.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />«Кынел да шияш тӱҥал, Сион ӱдыр!</para>
  <para style="q1" vid="MIC 4:13">Мый тыйын тӱкетым кӱртньым, йолгӱчетым тойым ыштем,</para>
  <para style="q1" vid="MIC 4:13">да тый шуко калыкым тошкен шалатет».</para>
  <para style="q1" vid="MIC 4:13">Нунын руалтен налме погыштым Господьлан,</para>
  <para style="q1" vid="MIC 4:13">поянлыкыштым пӱтынь мландын Озажлан</para>
  <para style="q1" vid="MIC 4:13">надыр шотеш пӧлеклен, тӱрыснек пытарет.<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="cl">5 ГЛАВА</para>
  <para style="cd">1 Израильлан сӧрымӧ Вуйлатыше Вифлеем гыч лиеш. 5 Израиль калык тӱзлана. Шояк юмылан кумалмылан мучаш толеш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />А кызыт, сарлан ямдылалтше ола,</para>
  <para style="q1" vid="MIC 5:1">сарзывиетым пого!</para>
  <para style="q1" vid="MIC 5:1">Мемнам йырым-йыр авыреныт,</para>
  <para style="q1" vid="MIC 5:1">Израильын судьяжым шӱргыж гыч</para>
  <para style="q2" vid="MIC 5:1">тоя дене кыраш тӱҥалыт.<verse eid="MIC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />«А тый, Вифлеем-Ефрафа,</para>
  <para style="q1" vid="MIC 5:2">Иуда мландысе ола-влак коклаште кеч изи улат,</para>
  <para style="q1" vid="MIC 5:2">Мыйын шонымем шукташ манын,</para>
  <para style="q1" vid="MIC 5:2">тый дечет Тудо лектеш,</para>
  <para style="q1" vid="MIC 5:2">Кӧ Израильын Вуйлатышыже лиеш.</para>
  <para style="q1" vid="MIC 5:2">Тудын тӱҥалтышыже – акрет жап гычак,</para>
  <para style="q1" vid="MIC 5:2">ожнысо кечыла гычак».<verse eid="MIC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />Сандене Господь,</para>
  <para style="q1" vid="MIC 5:3">азам ыштышаш ӱдырамашын ыштымешкыже,</para>
  <para style="q1" vid="MIC 5:3">Израиль эрге-влакым икмыняр жаплан коден кая.</para>
  <para style="q1" vid="MIC 5:3">Тунам нунын деке моло иза-шольышт пӧртылыт.<verse eid="MIC 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />Тудо кынел шогалеш да Господьын куатше дене,</para>
  <para style="q1" vid="MIC 5:4">шке Господь Юмыжын кӱдыратле лӱмжӧ дене кӱташ тӱҥалеш.</para>
  <para style="q1" vid="MIC 5:4">Илаш тӱҥалыт нуно лӱдыкшӧ деч посна,</para>
  <para style="q1" vid="MIC 5:4">вет Тудын лӱмжӧ мланде тӱр марте шарла.<verse eid="MIC 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />Тудо чылаштлан тыныслыкым конда.</para>
  <para style="q1" vid="MIC 5:5">Кунам мландышкына Ассирий толеш</para>
  <para style="q1" vid="MIC 5:5">да карман-влакнам шалаташ тӱҥалеш,</para>
  <para style="q1" vid="MIC 5:5">ме тудын ваштареш шым сарзывуйым,</para>
  <para style="q2" vid="MIC 5:5">кандаш оным шогалтена.<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />Нуно Ассирийым керде дене кӱташ,</para>
  <para style="q1" vid="MIC 5:6">Нимрод мландын капкаж воктене шогаш тӱҥалыт.</para>
  <para style="q1" vid="MIC 5:6">Кунам элышкына Ассирий толеш</para>
  <para style="q1" vid="MIC 5:6">да мландынам тошкаш тӱҥалеш,</para>
  <para style="q1" vid="MIC 5:6">тудын деч мемнам ты Вуйлатыше утара.<verse eid="MIC 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />Иаковын утлен кодшыжо-влак</para>
  <para style="q1" vid="MIC 5:7">шуко калык коклаште Господьын лупсыж гай,</para>
  <para style="q2" vid="MIC 5:7">шудо ӱмбак йогышо кугу йӱр гай лийыт.</para>
  <para style="q1" vid="MIC 5:7">Нуно айдемын кучемвийже деч эрыкан улыт,</para>
  <para style="q1" vid="MIC 5:7">айдемын эргыж-влаклан огыт инане.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />Иаковын утаралт кодшыжо-влак</para>
  <para style="q2" vid="MIC 5:8">шуко калык ден тукым коклаште</para>
  <para style="q1" vid="MIC 5:8">лийыт чодырасе янлык коклаште улшо лев гай,</para>
  <para style="q1" vid="MIC 5:8">шорык кӱтӱ кокласе самырык лев гай:</para>
  <para style="q1" vid="MIC 5:8">кунам тудо нунын дек толын лектеш,</para>
  <para style="q1" vid="MIC 5:8">тошкен пытара, кӱрыштеш –</para>
  <para style="q1" vid="MIC 5:8">нигӧ тудын деч ок утаре.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />Кидетым тушман-влак ваштареш нӧлталат,</para>
  <para style="q1" vid="MIC 5:9">лийыт нуно чыланат пытарыме!<verse eid="MIC 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 5:10" />«Тудо кечын, – ойла Господь, –</para>
  <para style="q1" vid="MIC 5:10">чыла имнетым пытарем, сарлык орват-влакым шалатем,<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />мландыштет ола-влакым пытарем,</para>
  <para style="q1" vid="MIC 5:11">чыла карманетым сӱмырем.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />Юзо пашатлан Мый мучашым пыштем,</para>
  <para style="q1" vid="MIC 5:12">мужедше-влакет тетла огыт лий.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />Полган юмет ден онакӱэт-влакым пытарем,</para>
  <para style="q1" vid="MIC 5:13">мом шке кидет дене ыштенат –</para>
  <para style="q1" vid="MIC 5:13">нунылан тый тетла кумалаш от тӱҥал.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />Ашера меҥгет-влакым Мый луктын кудалтем,</para>
  <para style="q1" vid="MIC 5:14">ола-шамычетым пӱтынек шалатем.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />Мутем колыштдымо калык-влаклан</para>
  <para style="q2" vid="MIC 5:15">кугу шыдем дене ӱчым шуктем».<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="cl">6 ГЛАВА</para>
  <para style="cd">1 Господь Израильым титакла. 6 Теве мом Господь айдеме деч йодеш. 9 Израильын титакше да тудым мут кучыктымаш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 6:1" />Колыштса, мом Господь ойла:</para>
  <para style="q1" vid="MIC 6:1">«Кынел, курык-влак ончылно судитлалт,</para>
  <para style="q1" vid="MIC 6:1">тек кӱкшака-влак йӱкетым колыт!<verse eid="MIC 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />Колыштса, курык-влак, Господьын титаклымыжым,</para>
  <para style="q1" vid="MIC 6:2">тыят, мландын пеҥгыде негызше!</para>
  <para style="q1" vid="MIC 6:2">Господь шке калыкше дене судитлалтеш,</para>
  <para style="q1" vid="MIC 6:2">Тудо Израиль ваштареш шогаш тӱҥалеш.<verse eid="MIC 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />Калыкем, мом Мый тылат ыштенам?</para>
  <para style="q1" vid="MIC 6:3">Мо дене илышет нелемденам? Вашеште Мылам.<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />Мый тыйым Египет гыч луктынам,</para>
  <para style="q1" vid="MIC 6:4">кул лийме вер гыч сулен налынам,</para>
  <para style="q1" vid="MIC 6:4">тыйын ончычет Моисейым, Аароным да Мариамым колтенам.<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />Мыйын калыкем, шарналте –</para>
  <para style="q1" vid="MIC 6:5">мом Моав кугыжа Валак шонен пыштен</para>
  <para style="q1" vid="MIC 6:5">да могай вашмутым тудлан Веор эрге Валаам пуэн,</para>
  <para style="q1" vid="MIC 6:5">Ситтим гыч Галгалыш кайыме годым мо лийын.</para>
  <para style="q1" vid="MIC 6:5">Тунам ужат, мыняр чынле пашам тылат Господь ыштен».<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />Мо дене мылам Господь ончыко шогалаш,</para>
  <para style="q1" vid="MIC 6:6">кавасе Юмо ончылно вуем саваш?</para>
  <para style="q1" vid="MIC 6:6">Шогалаш мо Тудын ончыко</para>
  <para style="q1" vid="MIC 6:6">йӱлалтен пуымо надыр дене, икияш презе-влак дене?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />Лиеш мо тӱжемле тага дене</para>
  <para style="q1" vid="MIC 6:7">але шотлен пытарыдыме олив ӱй йогын дене</para>
  <para style="q1" vid="MIC 6:7">Господьлан келшаш?</para>
  <para style="q1" vid="MIC 6:7">Пуэм мо надырлан Тудлан осал пашам верч кугэргем,</para>
  <para style="q1" vid="MIC 6:7">сулыкем верч – шке шочшем?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />О айдеме, Господь тылат каласен –</para>
  <para style="q1" vid="MIC 6:8">мо сай, да мом Тудо тый дечет йодеш:</para>
  <para style="q1" vid="MIC 6:8">чыным ышташ, порылыкым йӧраташ</para>
  <para style="q1" vid="MIC 6:8">да Юмет ончылно ӱҥышын кошташ.<verse eid="MIC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />Господьын йӱкшӧ олалан кычкыра,</para>
  <para style="q1" vid="MIC 6:9">мунлылык Тудын лӱмжӧ деч лӱдаш ӱжеш:</para>
  <para style="q1" vid="MIC 6:9">«Кучемвий тоям да тудым пеҥгыдемден шогалтыше Господьым колыштса!<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />Осал паша дене ыштен налме поянлык</para>
  <para style="q1" vid="MIC 6:10">да иземден ончыктышо йырнык висыме ате</para>
  <para style="q1" vid="MIC 6:10">осалым ыштен илыме пӧртыштӧ огытыл мо?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />Чыташ тӱҥалам мо шояк висам</para>
  <para style="q1" vid="MIC 6:11">але ондалыше кир-влакым?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />Поян еҥ-шамыч тиде олаште темден илат,</para>
  <para style="q1" vid="MIC 6:12">тушто илыше-влак ондалкалат,</para>
  <para style="q1" vid="MIC 6:12">умша ден йылмыштышт – шояк.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />Садлан Мый ӱмбакет черым колтем,</para>
  <para style="q1" vid="MIC 6:13">сулыкетлан тыйым пустаҥдем.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />Тый кочкаш тӱҥалат, но от тем – пагарет яра лиеш.</para>
  <para style="q1" vid="MIC 6:14">Погаш тӱҥалат, но арален от керт.</para>
  <para style="q1" vid="MIC 6:14">А мом арален кодет – Мый кердылан пуэм.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />Ӱдаш тӱҥалат, но от тӱред;</para>
  <para style="q1" vid="MIC 6:15">оливым темдаш тӱҥалат, но ӱй дене шкендым от шӱрӧ;</para>
  <para style="q1" vid="MIC 6:15">виноградым темдаш тӱҥалат, но йошкар аракам от йӱ.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />Тый Амврийын йӱлажым</para>
  <para style="q2" vid="MIC 6:16">да Ахав тукымын чыла пашажым шуктен шогет,</para>
  <para style="q1" vid="MIC 6:16">нунын каҥашышт почеш ыштет.</para>
  <para style="q1" vid="MIC 6:16">Садлан Мый тыйым пустаҥдем,</para>
  <para style="q1" vid="MIC 6:16">еҥет-влакым намыс дене леведам.</para>
  <para style="q1" vid="MIC 6:16">Те, Мыйын калыкем, мыскылтыш лийыда».<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="cl">7 ГЛАВА</para>
  <para style="cd">1 Израиль калыкын осал пашаже-влак. 8 Господь шке еҥже-шамычым утара. 14 Шке калыкше деке Тудо угыч поро лиеш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />Ойго мыланем! Мый тудо еҥ гай улам,</para>
  <para style="q1" vid="MIC 7:1">кӧ кеҥежымсе саскам погаш лектын,</para>
  <para style="q1" vid="MIC 7:1">но тиде жап эртен, виноград аҥа яра кодын –</para>
  <para style="q1" vid="MIC 7:1">кочшашлык ик орлаҥгат уке,</para>
  <para style="q1" vid="MIC 7:1">кочкаш шонымо икымше смоква ок кой.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />Тыгакак элыштына поро еҥ-влакым от му,</para>
  <para style="q1" vid="MIC 7:2">калык коклаште чын ыштыше уке.</para>
  <para style="q1" vid="MIC 7:2">Вӱрым йоктараш ваҥен шинчат,</para>
  <para style="q1" vid="MIC 7:2">икте-весыштлан оптышым шындат.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />Осалым ышташ нунын кидышт мастар:</para>
  <para style="q1" vid="MIC 7:3">вуйлатыше пӧлекым йодеш,</para>
  <para style="q1" vid="MIC 7:3">судья взяткылан судитла,</para>
  <para style="q1" vid="MIC 7:3">а виян-влак шке кумылышт почеш ыштыктат –</para>
  <para style="q1" vid="MIC 7:3">тыге нуно чыным вес семын савырат.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />Нунын кокла гыч эн сайже – иман вондер дене иктак,</para>
  <para style="q1" vid="MIC 7:4">эн чын ыштышыже – шуркалыше воштыран пече деч ударак.</para>
  <para style="q1" vid="MIC 7:4">Толеш тудо кече, мут кучыктымо кече,</para>
  <para style="q1" vid="MIC 7:4">кудын нерген пророк уверзет-влак ойленыт,</para>
  <para style="q1" vid="MIC 7:4">тунам калык аптыранымашыш пура.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />Лишыл еҥетлан ит ӱшане,</para>
  <para style="q1" vid="MIC 7:5">йолташетлан ит инане.</para>
  <para style="q1" vid="MIC 7:5">Ӧндалтышыштет кийыше дене кутырымет годым</para>
  <para style="q2" vid="MIC 7:5">умшат гыч лекше шомакым эскере.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />Эрге ачажым шӱктара,</para>
  <para style="q1" vid="MIC 7:6">ӱдыр аваже ваштареш шогалеш,</para>
  <para style="q1" vid="MIC 7:6">шешке – авалийшыже ваштареш,</para>
  <para style="q1" vid="MIC 7:6">айдемылан мӧҥгысыжӧ-влак тушманыш савырнат.<verse eid="MIC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />А мый ончалтышем Господь дек савырем,</para>
  <para style="q1" vid="MIC 7:7">мыйым утарыше Юмемлан инанем:</para>
  <para style="q1" vid="MIC 7:7">Тудо мыйым колеш.<verse eid="MIC 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />Тушманем, ойгемлан ит куане!</para>
  <para style="q1" vid="MIC 7:8">Кеч мый камвозынам, но угыч кынелам,</para>
  <para style="q1" vid="MIC 7:8">кеч пычкемыште улам, но Господь мылам волгыдо лиеш.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />Господь ончылно сулыкыш пуренам,</para>
  <para style="q1" vid="MIC 7:9">садлан мылам чын судым ыштымешкыже</para>
  <para style="q1" vid="MIC 7:9">да мыйым арален налмешкыже,</para>
  <para style="q1" vid="MIC 7:9">Тудын шыдыжым чытышаш улам.</para>
  <para style="q1" vid="MIC 7:9">Господь мыйым волгыдыш луктеш,</para>
  <para style="q1" vid="MIC 7:9">да мый Тудын чынлыкшым ужам.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />«Кушто Господь, тыйын Юмет?» манын ойлышо тушман,</para>
  <para style="q1" vid="MIC 7:10">тидым ужын, намысыш пура.</para>
  <para style="q1" vid="MIC 7:10">Шке шинчам дене ужам мый,</para>
  <para style="q1" vid="MIC 7:10">кузе тудым уремысе лавыра семын тошкаш тӱҥалыт.<verse eid="MIC 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />Толеш тудо кече,</para>
  <para style="q1" vid="MIC 7:11">кунам ола пырдыжетым угыч чоҥат,</para>
  <para style="q1" vid="MIC 7:11">мландетым кумдаҥдат.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />Тудо кечын тый декет чыла вер гыч толыт:</para>
  <para style="q1" vid="MIC 7:12">Ассирий ден Египетысе олала гыч,</para>
  <para style="q1" vid="MIC 7:12">Египет деч Евфрат эҥер марте шуйнышо кундемла гыч,</para>
  <para style="q1" vid="MIC 7:12">теҥыз деч теҥыз, курык деч курык марте</para>
  <para style="q2" vid="MIC 7:12">шуйналтше мландыла гыч.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />А коден кайыме мланде пуста лиеш –</para>
  <para style="q1" vid="MIC 7:13">тушто илыше-влаклан кӧра,</para>
  <para style="q1" vid="MIC 7:13">нунын осал пашаштлан кӧра.<verse eid="MIC 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />Пондет дене кӱтӧ, Господь, шке калыкетым,</para>
  <para style="q1" vid="MIC 7:14">сай мланде<note caller="*" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">«Сай мланде» – тидым «Кармил» манынат кусараш лиеш; «кармил» мут ’сад-пакчан мланде’ манмым ончыкта.</char></note> покшелнысе чодыраште посна илыше кӱтӱэтым.</para>
  <para style="q1" vid="MIC 7:14">Тек тудо ожнысо семын</para>
  <para style="q2" vid="MIC 7:14">Васан ден Галаадыште кочкын коштеш!<verse eid="MIC 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />«Египет гыч лекме годсо семын</para>
  <para style="q2" vid="MIC 7:15">Мый тылат ӧрыктарыше паша-влакым ончыктем».<verse eid="MIC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />Калык-влак тидым ужыт</para>
  <para style="q1" vid="MIC 7:16">да вий-куатышт улмо ӱмбач вожылмашыш пурат.</para>
  <para style="q1" vid="MIC 7:16">Кидышт дене нуно умшаштым петырат,</para>
  <para style="q1" vid="MIC 7:16">пылышышт соҥгыра лиеш.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />Кишке семын, мланде ӱмбалне нушкын коштшо семын</para>
  <para style="q2" vid="MIC 7:17">тӱҥалыт нуно пуракым нулаш.</para>
  <para style="q1" vid="MIC 7:17">Чытырен лектыт шке карманышт гыч,</para>
  <para style="q1" vid="MIC 7:17">Господь Юмына деч лӱдыт.</para>
  <para style="q1" vid="MIC 7:17">Тый дечет, Господь, нуно ӧрткымашыш пурат!<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />Уло мо Тый гает Юмо,</para>
  <para style="q1" vid="MIC 7:18">Кӧ титакым кудалта,</para>
  <para style="q1" vid="MIC 7:18">калыкшын утаралт кодшыжо-влакым</para>
  <para style="q2" vid="MIC 7:18">осал пашаштлан ок наказатле?</para>
  <para style="q1" vid="MIC 7:18">Курымешлан огыл Тудын шыдыже,</para>
  <para style="q1" vid="MIC 7:18">вет Господь серлагаш йӧрата.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />Тудо мемнам угыч чамана,</para>
  <para style="q1" vid="MIC 7:19">чыла осал пашанам ӱштыл шуа,</para>
  <para style="q1" vid="MIC 7:19">сулыкнам теҥыз пундашыш кудалта.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />Кугезе кочана-влаклан ожно годым товатлымет семынак</para>
  <para style="q1" vid="MIC 7:20">Тый Иаковлан ӱшанле лият,</para>
  <para style="q1" vid="MIC 7:20">Авраамлан порылыкым ончыктет.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>