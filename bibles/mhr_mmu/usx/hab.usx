<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Meadow Mari Bible</book>
  <para style="h">Авв</para>
  <para style="toc3">Авв</para>
  <para style="toc2">Аввакум</para>
  <para style="toc1">Пророк Аввакумын книгаже</para>
  <para style="mt">ПРОРОК АВВАКУМЫН КНИГАЖЕ</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">1 Пророкын икымше вуйшиймашыже. 5 Юмын икымше вашмутшо. 12 Пророкын кокымшо вуйшиймашыже.</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />Пророк шомак, тудо пророк Аввакумлан кончымаш гоч пуымо лийын.<verse eid="HAB 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />О Господь, Тый дечет полышым эше мыняр йодман,</para>
  <para style="q1" vid="HAB 1:2">Тый мыйым от кол мо?</para>
  <para style="q1" vid="HAB 1:2">Шыгыремдыме нерген эше мыняр кычкырыман,</para>
  <para style="q1" vid="HAB 1:2">Тый от утаре мо?<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />Молан Тый мылам осал пашам ужыктет,</para>
  <para style="q1" vid="HAB 1:3">тиде неле-йӧсылыкым кузе ончен кертат?</para>
  <para style="q1" vid="HAB 1:3">Шинча ончылнем – пызырымаш ден пытарымаш,</para>
  <para style="q1" vid="HAB 1:3">вуйым нӧлтат келшыдымаш ден ужмышудымаш.<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />Тидлан кӧра закон вийжым йомдарен, чын суд уке:</para>
  <para style="q1" vid="HAB 1:4">осал еҥ титакдымым сеҥа,</para>
  <para style="q1" vid="HAB 1:4">чынлык деч посна суд ышталтеш.<verse eid="HAB 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />«Ончалза тӱткын калык-влак ӱмбаке,</para>
  <para style="q1" vid="HAB 1:5">те пеш чот ӧрыда!</para>
  <para style="q1" vid="HAB 1:5">Мый тендан кечылаште ӧрыктарыше пашам ыштем,</para>
  <para style="q1" vid="HAB 1:5">тидын нерген тыланда каласат ыле гын,</para>
  <para style="q1" vid="HAB 1:5">огыда ӱшане ыле.<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />Теве Мый халдей-влакым,</para>
  <para style="q2" vid="HAB 1:6">ажгын да чаманыдыме калыкым, нӧлталам.</para>
  <para style="q1" vid="HAB 1:6">Йот калыкын илемлажым руалташ манын,</para>
  <para style="q1" vid="HAB 1:6">тудо тӱня мучко кая.<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />Тиде калык лӱдыкшӧ да шучко,</para>
  <para style="q1" vid="HAB 1:7">шкаланже шке – закон да кучемвий.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />Улыт имньыже-влак леопард деч писырак,</para>
  <para style="q1" vid="HAB 1:8">йӱд пире деч чулымрак.</para>
  <para style="q1" vid="HAB 1:8">Имнян сарзывийже уло вийын чыма,</para>
  <para style="q1" vid="HAB 1:8">имнешкыже-влак умбачын кудал толыт.</para>
  <para style="q1" vid="HAB 1:8">Кучышаш янлык ӱмбак куткыж семын чоҥештен толыт,<verse eid="HAB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 1:9" />толыт нуно руалтен налаш.</para>
  <para style="q1" vid="HAB 1:9">Эрвел мардеж гай чыма сарзывийже,<note caller="*" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note></para>
  <para style="q1" vid="HAB 1:9">ошма пырче наре еҥым пленыш налеш.<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />Кугыжа-влак тудлан улыт воштылчык,</para>
  <para style="q1" vid="HAB 1:10">вуйлатыше-шамыч – мыскылтыш,</para>
  <para style="q1" vid="HAB 1:10">карман-влак ӱмбаке тудо воштылын онча,</para>
  <para style="q1" vid="HAB 1:10">мланде кӱкшака-шамычым нӧлтен, нуным сеҥен налеш.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />Кугешныше чон шӱлышыжӧ эшеат чот кугешна,<note caller="*" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Еврей йылмыште ик мутак «шӱлыш» ден «мардеж» шомакым ончыкта, сандене тидым «Мардеж семын корныштыжо чыла ӱштын кудалта» манынат кусараш лиеш.</char></note></para>
  <para style="q1" vid="HAB 1:11">кайымыж годым тудо чыла пустаҥда,</para>
  <para style="q1" vid="HAB 1:11">тудын юмыжо – шке вийже».<verse eid="HAB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />Но Тый огыл мо ожнысек Господь улат?</para>
  <para style="q1" vid="HAB 1:12">Святой Юмем, ме огына коло!</para>
  <para style="q1" vid="HAB 1:12">Господь, Тый тиде калыкым мут кучыкташ колтенат.</para>
  <para style="q1" vid="HAB 1:12">Кӱ курыкем! Шке судетым ышташ Тый тудым ойыренат.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />Тыйын яндар, святой шинчат осал пашам ончен ок керт,</para>
  <para style="q1" vid="HAB 1:13">пызырымашым Тый чытен от керт.</para>
  <para style="q1" vid="HAB 1:13">Молан Тый ондален илыше-влак ӱмбаке ончет</para>
  <para style="q1" vid="HAB 1:13">да, кунам осал еҥ шкеж деч чынрак ыштышым пӧжга, шып улат?<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />Тый еҥ-шамычым вуйлатыше деч посна илыше теҥыз кол гайым,</para>
  <para style="q2" vid="HAB 1:14">вӱдысӧ тыгыде чонан-влак гайым ыштенат.<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />Тушман нуным эҥыр дене луктеш,</para>
  <para style="q1" vid="HAB 1:15">вапш дене куча, шӧрӧка дене пога –</para>
  <para style="q1" vid="HAB 1:15">тидлан йывырта да куана.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />Садлан тудо шке вапшыжлан надырым конда,</para>
  <para style="q1" vid="HAB 1:16">шке шӧрӧкажлан тӱтыра,</para>
  <para style="q1" vid="HAB 1:16">вет нунылан кӧра тудын пайже чапле</para>
  <para style="q2" vid="HAB 1:16">да ӱстелже пеш поян.<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />Ок тол мо мучаш вапшыж гыч ястаркалымылан,</para>
  <para style="q1" vid="HAB 1:17">калык-влакым чаманыде пытарымыжлан?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="cl">2 ГЛАВА</para>
  <para style="cd">1 Юмын кокымшо вашмутшо. 6 Осал еҥ-влаклан мут кучашышт логалеш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />Мый оролаш шогалынам</para>
  <para style="q1" vid="HAB 2:1">да башне ӱмбалне шогымем годым эскеренам:</para>
  <para style="q1" vid="HAB 2:1">мом мылам Господь каласа,</para>
  <para style="q1" vid="HAB 2:1">вуйшиймем шотышто мылам мом эше ойлаш.<verse eid="HAB 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 2:2" />Господь мылам вашештен:</para>
  <para style="q1" vid="HAB 2:2">«Кончымашым возен нал,</para>
  <para style="q1" vid="HAB 2:2">изоҥаш сайын возен шынде –</para>
  <para style="q1" vid="HAB 2:2">тудым лудаш куштылго лийже.<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />Вет тиде кончымаш – палемдыме пагыт нерген,</para>
  <para style="q1" vid="HAB 2:3">тудо пытартыш жапыште мо лийшаш нерген ойла да ок ондале.</para>
  <para style="q1" vid="HAB 2:3">Кончымаш вашке шукталтдымыла чучеш гынат, вучо –</para>
  <para style="q1" vid="HAB 2:3">тудо, юватылде, чынжымак шукталтеш.<verse eid="HAB 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />Теве тырга айдемын шӱм-чоныштыжо чынлык уке,</para>
  <para style="q1" vid="HAB 2:4">а чын ыштыше еҥ ӱшанымашыж дене<note caller="*" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">«Ӱшанымашыж дене» – тидым тыгеат кусараш лиеш: «ӱшанле улмыж дене».</char></note> илаш тӱҥалеш.<verse eid="HAB 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />Кугешныше айдеме – йошкар арака гай ондалчык,</para>
  <para style="q1" vid="HAB 2:5">тудын шӱм-чоныштыжо тыныс уке.</para>
  <para style="q1" vid="HAB 2:5">Вес тӱня гай тудо умшажым кара,</para>
  <para style="q1" vid="HAB 2:5">колымаш семын тудо темын кертдыме.</para>
  <para style="q1" vid="HAB 2:5">Чыла калыкым шкаланже колыштара,</para>
  <para style="q1" vid="HAB 2:5">чыла тукымым кид йымакше налеш.<verse eid="HAB 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 2:6" />Но нунышт тудын нерген мыскылен ойлат</para>
  <para style="q1" vid="HAB 2:6">да тыге койдарен мурат:</para>
  <para style="q1" vid="HAB 2:6">”Ойго тудлан, кӧ весын погыж дене поя</para>
  <para style="q1" vid="HAB 2:6">да шуко залогым пога!”</para>
  <para style="q1" vid="HAB 2:6">Кужун мо тиде шуйна?<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />Кенета огыт кынел мо еҥ-влак арымеш налметым тӱлыкташ?</para>
  <para style="q1" vid="HAB 2:7">Толын огыт шогал мо тыйым лӱдыкташ?</para>
  <para style="q1" vid="HAB 2:7">Нуно тый дечет чыла шупшын налыт.<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />Тый шуко калыкым агенат,</para>
  <para style="q1" vid="HAB 2:8">сандене тыйымат моло калык ага –</para>
  <para style="q1" vid="HAB 2:8">тый вӱрым йоктаренат,</para>
  <para style="q1" vid="HAB 2:8">мландым, олалам пустаҥденат,</para>
  <para style="q1" vid="HAB 2:8">тушто илыше-влакым пытаренат.<verse eid="HAB 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />Ойго тудлан, кӧ шке пӧртшылан погым</para>
  <para style="q2" vid="HAB 2:9">чын огыл паша дене ыштен налеш,</para>
  <para style="q1" vid="HAB 2:9">азап деч утлаш манын,</para>
  <para style="q1" vid="HAB 2:9">шке пыжашыжым кӱшан вераҥда!<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />Пӧртыштет илыше-влакым намысыш пуртенат,</para>
  <para style="q1" vid="HAB 2:10">калык-влакым пытарымет дене илышетлан лӱдыкшым конденат.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />Пырдыж кӱ-влак кычкыраш тӱҥалыт,</para>
  <para style="q1" vid="HAB 2:11">пу кашта-влак нунылан вашештат:<verse eid="HAB 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />”Ойго тудлан, кӧ вӱрым йоктарен олам чоҥа,</para>
  <para style="q1" vid="HAB 2:12">негызшылан закондымылыкым пышта!”<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />Господь Саваоф деч огыл мо тиде:</para>
  <para style="q1" vid="HAB 2:13">калык-влакын пашашт туллан кочкыш лийыт,</para>
  <para style="q1" vid="HAB 2:13">тукым-шамыч шкештым арам улныктарат?<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />Кузе вӱд теҥызым тема,</para>
  <para style="q1" vid="HAB 2:14">туге Господьын чапшым палымаш мландым тема.<verse eid="HAB 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />Ойго тудлан, кӧ лишылъеҥже-влаклан шке коркаж гыч</para>
  <para style="q2" vid="HAB 2:15">ужмышудымаш дене йӧрымӧ йошкар аракам йӱкта,</para>
  <para style="q1" vid="HAB 2:15">чара капыштым ужаш манын,</para>
  <para style="q2" vid="HAB 2:15">нуным руштмешкышт йӱкта!<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />Тый чап дене огыл, а вожылмаш дене темат!</para>
  <para style="q1" vid="HAB 2:16">Ынде шкежат йӱ да намысле веретым ончыкто!</para>
  <para style="q1" vid="HAB 2:16">Господьын пурла кидыштыже улшо чаше</para>
  <para style="q2" vid="HAB 2:16">тыйымат эртен огеш кай,</para>
  <para style="q1" vid="HAB 2:16">да чапетым намыс вашталта.<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />Ливан курыклаште ыштыме осал пашат шке ӱмбакетак толеш:</para>
  <para style="q1" vid="HAB 2:17">янлыкым чаманыде пуштедыметлан,</para>
  <para style="q1" vid="HAB 2:17">айдеме вӱрым йоктарыметлан,</para>
  <para style="q1" vid="HAB 2:17">мландым, олалам пустаҥдыметлан,</para>
  <para style="q1" vid="HAB 2:17">тушто илыше-влакым пытарыметлан</para>
  <para style="q1" vid="HAB 2:17">тый лӱдын чытыраш тӱҥалат.<verse eid="HAB 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />Могай пайда кидмастарын ыштыме шояк юмыж деч,</para>
  <para style="q1" vid="HAB 2:18">велен ыштыме тиде статуй деч,</para>
  <para style="q1" vid="HAB 2:18">кудо лач шояклан туныкта?</para>
  <para style="q1" vid="HAB 2:18">Мастар инана шке ыштыме юмыжлан,</para>
  <para style="q1" vid="HAB 2:18">а тудыжо – лач йылмыдыме полган.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />Ойго тудлан, кӧ пулан ойла: ”Кынел!”</para>
  <para style="q1" vid="HAB 2:19">да кутырен кертдыме кӱлан: ”Помыжалт!”</para>
  <para style="q1" vid="HAB 2:19">Туныкта мо тудо иктаж-молан?</para>
  <para style="q1" vid="HAB 2:19">Тудо шӧртньӧ да ший дене комыжлымо,</para>
  <para style="q1" vid="HAB 2:19">кӧргыштыжӧ шӱлыш уке».<verse eid="HAB 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />А Господь – шке святой храмыштыже:</para>
  <para style="q1" vid="HAB 2:20">тек уло мланде Тудын ончылныжо шыплана!<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="cl">3 ГЛАВА</para>
  <para style="cd">Аввакумын кумалмыже.</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />Пророк Аввакумын кумалме мутшо. Муро семын мурашлан.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />Господь, мый Тыйын пашат нерген колынам,</para>
  <para style="q1" vid="HAB 3:2">мом ыштыметым пален налынам да лӱдынам.<note caller="*" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Грек ден славян йылмылашке кусарымаште тидын деч вара тыгай ешартыш уло: ”кок илыше коклаште Тый пален налме лият”.</char></note></para>
  <para style="q1" vid="HAB 3:2">Господь, мемнан илыме кечылаште шке пашатым угыч ончыкто,</para>
  <para style="q1" vid="HAB 3:2">мемнан жапыште тыгайымак ыште,</para>
  <para style="q1" vid="HAB 3:2">шыдешкет гынат, мемнан деке поро лий.<verse eid="HAB 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />Феман гыч Юмо лишемеш,</para>
  <para style="q1" vid="HAB 3:3">Фаран курык деч Святой толеш.</para>
  <para style="q1" vid="HAB 3:3">Тудын кӱдыратлыкше кавам леведын,</para>
  <para style="q1" vid="HAB 3:3">Тудым моктымаш дене мланде темын.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />Тудын йолгалтмыже – пуйто кече волгыдо,</para>
  <para style="q1" vid="HAB 3:4">кидше гыч тулйол-влак лектыт,</para>
  <para style="q1" vid="HAB 3:4">тушто – Тудын вий-куатше.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />Чурийже ончыч шучко чер кая,</para>
  <para style="q1" vid="HAB 3:5">йолтаганже почеш – когартыше шокшымужо.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />Кунам Тудо шогалеш, мланде чытырналтеш,</para>
  <para style="q1" vid="HAB 3:6">ончалеш – калык-шамыч лӱдын пырткат.</para>
  <para style="q1" vid="HAB 3:6">Курымашле курык-влак шелалтыт,</para>
  <para style="q1" vid="HAB 3:6">акрет кӱкшака-шамыч лапемыт.</para>
  <para style="q1" vid="HAB 3:6">Но Тудын коштмо корныжо-влак курымашле улыт!<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />Ужам мый: эфиоп омаш-влак туткарыш логалыныт,</para>
  <para style="q1" vid="HAB 3:7">Мадиам мландысе илем-влак чытырат.<verse eid="HAB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />Эҥер-шамычлан мо, Господь,</para>
  <para style="q2" vid="HAB 3:8">йогын-влаклан мо ылыжын Тыйын шыдет?</para>
  <para style="q1" vid="HAB 3:8">Але теҥызлан ылыжын кугу шыдет?</para>
  <para style="q1" vid="HAB 3:8">Сандене мо Тый шке имнет-влак,</para>
  <para style="q2" vid="HAB 3:8">сеҥымашым кондышо орват-влак ӱмбак шинчынат?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />Израиль тукым-шамычлан пуымо товатмутет почеш</para>
  <para style="q1" vid="HAB 3:9">Тый шке пикшйоҥежетым чымалтаренат.</para>
  <para style="q1" vid="HAB 3:9">Мландым Тый эҥер-влак дене шелынат.<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />Тыйым ужын, курык-шамыч чытырнат,</para>
  <para style="q1" vid="HAB 3:10">кугу вӱд йога, вӱд келгыт гӱжла,</para>
  <para style="q1" vid="HAB 3:10">толкынжым кӱшкӧ нӧлталеш.<verse eid="HAB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />Кунам пикшет-влак чолгыжыт</para>
  <para style="q2" vid="HAB 3:11">да волгенчетын умдыжо-влак йылгыжыт,</para>
  <para style="q1" vid="HAB 3:11">кече ден тылзе шке верыштышт чарнен шогалыт.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />Шыдет дене Тый мланде мучко эртет,</para>
  <para style="q1" vid="HAB 3:12">кугун сырымет дене калык-влакым тошкет.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />Лектат Тый шке калыкетым утараш,</para>
  <para style="q1" vid="HAB 3:13">шӱрен палемдыметым саклен кодаш.</para>
  <para style="q1" vid="HAB 3:13">Осал калыкын вуйлатышыжым Тый кырен шалатет,</para>
  <para style="q1" vid="HAB 3:13">тудым чараҥден, пӱтынек пытарет.<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />Кунам тудын сарзывуйжо-влак,</para>
  <para style="q1" vid="HAB 3:14">пуйто шолып верыште йорло еҥым нелаш шонымылан куанен,</para>
  <para style="q1" vid="HAB 3:14">мыйым тӱтан мардеж гай кырен шалаташ лупшалтыт,</para>
  <para style="q1" vid="HAB 3:14">Тый тудын умдыж дене нунын вуйыштым шӱтет.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />Теҥыз гоч Тый шке имнет-влак ӱмбалне</para>
  <para style="q2" vid="HAB 3:15">кугу вӱдлам шоҥештарен кудалат.<verse eid="HAB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />Мый тидым кольым, да шӱмем пырткаш тӱҥале,</para>
  <para style="q1" vid="HAB 3:16">гӱжлымӧ йӱкым колын, тӱрвем чытырналте.</para>
  <para style="q1" vid="HAB 3:16">Луэм-влак коршташ тӱҥальыч,</para>
  <para style="q1" vid="HAB 3:16">йолем йымалне мландым мый ом шиж.</para>
  <para style="q1" vid="HAB 3:16">Но, шӱм-чон ласкалыкым йомдарыде,</para>
  <para style="q1" vid="HAB 3:16">вучаш тӱҥалам тудо кечым,</para>
  <para style="q1" vid="HAB 3:16">кунам тушманем-влак ӱмбак туткар толеш.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />Кеч смоква пушеҥге ок пелед,</para>
  <para style="q1" vid="HAB 3:17">виноград вондерыште саска огеш лий,</para>
  <para style="q1" vid="HAB 3:17">олив саска ок шоч, пасу лектышым ок пу,</para>
  <para style="q1" vid="HAB 3:17">кеч шорыквечыште шорык-влак</para>
  <para style="q2" vid="HAB 3:17">да вӱташте ушкал-влак огыт код,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />тунамат мый Господьлан йывырташ,</para>
  <para style="q1" vid="HAB 3:18">утарыше Юмемлан куанаш тӱҥалам.<verse eid="HAB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />Господь Юмо – мыйын вием:</para>
  <para style="q1" vid="HAB 3:19">йолемым пӱчын гайым ышта</para>
  <para style="q1" vid="HAB 3:19">да мыйым кӱкшака верыш кӱзыкта!</para>
  <para style="b" vid="HAB 3:19" />
  <para style="q1" vid="HAB 3:19">Хор вуйлатышылан. Кылан семӱзгар дене.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>