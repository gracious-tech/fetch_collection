<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Meadow Mari Bible</book>
  <para style="h">Наум</para>
  <para style="toc3">Наум</para>
  <para style="toc2">Наум</para>
  <para style="toc1">Пророк Наумын книгаже</para>
  <para style="mt">ПРОРОК НАУМЫН КНИГАЖЕ</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">Ниневий олалан Господь ӱчым шукта.</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Ниневий нерген пророклен ойлымаш. Елкос гыч улшо Наумын кончымашым возымо книгаже.<verse eid="NAM 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />Господь – ушкалыше да ӱчым шуктышо Юмо.</para>
  <para style="q1" vid="NAM 1:2">Господь – ӱчым шуктышо, шыдешкымыж годым лӱдыкшӧ.</para>
  <para style="q1" vid="NAM 1:2">Тудо шке тушманже-влаклан ӱчым шукта,</para>
  <para style="q1" vid="NAM 1:2">нунын ваштареш шыдыжым ок луштаре.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />Господь – кужун чытыше, вий-куатше кугу,</para>
  <para style="q1" vid="NAM 1:3">Тудо мут кучыктыде нигунам ок кодо.</para>
  <para style="q1" vid="NAM 1:3">Господь ошкылеш тӱтаныште, кугу мардежыште,</para>
  <para style="q1" vid="NAM 1:3">пыл-влак Тудын йол йымачынже пурак семын нӧлталтыт.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />Кӱштен каласа Господь теҥызлан, да тудыжо кошка,</para>
  <para style="q1" vid="NAM 1:4">эҥер-влаклан – нуно пучат,</para>
  <para style="q1" vid="NAM 1:4">Васан ден Кармил лывыжгат,</para>
  <para style="q1" vid="NAM 1:4">Ливан курыкысо пеледыш-влак шапалгат.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Тудын ончылно курык-влак чытырат,</para>
  <para style="q1" vid="NAM 1:5">чоҥгата-шамыч лапемыт,</para>
  <para style="q1" vid="NAM 1:5">Тудын чурийже ончылно мланде лӱҥгалтеш,</para>
  <para style="q1" vid="NAM 1:5">тӱня да тушто чыла илыше чытырат.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Кӧ Тудын шыдыже ончылно шоген кертеш?</para>
  <para style="q1" vid="NAM 1:6">Тудын йӱлышӧ шыдыжым кӧ чыта?</para>
  <para style="q1" vid="NAM 1:6">Тул семын Господьын шыдыже йога,</para>
  <para style="q1" vid="NAM 1:6">кӱ курык-влак Тудын ончылно шаланат.<verse eid="NAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />Господь поро, туткар кечын Тудо – куржын утлымо вер,</para>
  <para style="q1" vid="NAM 1:7">Тудлан инаныше-влакым Тудо пала да утара.<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />Шарлыше вӱдташлем дене</para>
  <para style="q2" vid="NAM 1:8">Тудо Ниневийым негыз марте шалата,</para>
  <para style="q1" vid="NAM 1:8">да Тудын тушманже-влакым пычкемыш авалта.<verse eid="NAM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Мом те Господь ваштареш ышташ шонеда?</para>
  <para style="q1" vid="NAM 1:9">Тудо чыла пытара,</para>
  <para style="q1" vid="NAM 1:9">да туткар угычын огеш лий.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Иман вондер семын нуно пӱтыралтыныт,</para>
  <para style="q1" vid="NAM 1:10">йӱшӧ-влак семын руштыныт –</para>
  <para style="q1" vid="NAM 1:10">кукшо олым семын нуно йӱлалтыме лийыт.<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />Тый дечет, Ниневий,</para>
  <para style="q1" vid="NAM 1:11">Господь ваштареш осалым ышташ шонышо,</para>
  <para style="q2" vid="NAM 1:11">осал чоялыкым пӱктен шинчыше лектын.<verse eid="NAM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12" />Тыге Господь ойла:</para>
  <para style="q1" vid="NAM 1:12">«Кеч нуно виян да шукын улыт,</para>
  <para style="q1" vid="NAM 1:12">но сӱмырен шумо лийыт да йомыт.</para>
  <para style="q1" vid="NAM 1:12">А тыйым, калыкем, Мый йӧсландаренам,</para>
  <para style="q1" vid="NAM 1:12">но ончыкшым тидым ом ыште.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Тылат чиктыме омытам Мый кызыт шалатем,</para>
  <para style="q1" vid="NAM 1:13">шинчыретым кӱрлын кудалтем!»<verse eid="NAM 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />А тыланет, Ассирий, Господь теве мом палемден:</para>
  <para style="q1" vid="NAM 1:14">«Лӱметым нумалше тукымет тетла огеш лий,</para>
  <para style="q1" vid="NAM 1:14">Юмет-влакын пӧртыштышт Мый</para>
  <para style="q2" vid="NAM 1:14">пӱчкын лукмо да велен ыштыме статуй-влакым пытарем,</para>
  <para style="q1" vid="NAM 1:14">тылат шӱгарым ямдылем,</para>
  <para style="q1" vid="NAM 1:14">вет тый нимолан йӧрдымӧ улат».<verse eid="NAM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />Теве курык ӱмбалне уверзе вашка –</para>
  <para style="q1" vid="NAM 1:15">тудо поро уверым конда,</para>
  <para style="q1" vid="NAM 1:15">тыныс нерген увертара!</para>
  <para style="q1" vid="NAM 1:15">Иуда, пайрем-влакетым эртаре,</para>
  <para style="q1" vid="NAM 1:15">мом сӧрыметым шукто!</para>
  <para style="q1" vid="NAM 1:15">Осал еҥ мландышкет тетла керылт ок пуро,</para>
  <para style="q1" vid="NAM 1:15">вет тудо пӱтынек пытарыме.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="cl">2 ГЛАВА</para>
  <para style="cd">Ниневийын пытымыж нерген пророклен ойлымаш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Тыйын ӱмбакет шалатыше толеш!</para>
  <para style="q1" vid="NAM 2:1">Карман-влакетым ороло,</para>
  <para style="q1" vid="NAM 2:1">корным эскере, ямдылалт, вийым пого!<verse eid="NAM 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />Вет Господь Иаковын кугулыкшым,</para>
  <para style="q1" vid="NAM 2:2">Израильын кугулыкшым угыч нӧлталеш,</para>
  <para style="q1" vid="NAM 2:2">кеч пустаҥдыше-влак нуным шалатеныт,</para>
  <para style="q1" vid="NAM 2:2">виноград укшыштым пытареныт.<verse eid="NAM 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Патырже-шамычын авыртышышт йошкарге,</para>
  <para style="q1" vid="NAM 2:3">сарзыж-влакын вургемышт ал тӱсан.</para>
  <para style="q1" vid="NAM 2:3">Кредалаш ямдылалтме кечын</para>
  <para style="q1" vid="NAM 2:3">орваж-влак тул семын йолгат,</para>
  <para style="q1" vid="NAM 2:3">умдо-шамыч чодырала лойгат.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Урем дене орва-влак чымат,</para>
  <para style="q1" vid="NAM 2:4">ола мучко кудалыт.</para>
  <para style="q1" vid="NAM 2:4">Тул семын нуно волгалтыт,</para>
  <para style="q1" vid="NAM 2:4">волгенчыла йолгат.<verse eid="NAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Тале сарзе-влакым ӱжын погат,</para>
  <para style="q1" vid="NAM 2:5">нунышт вашкымышт дене шӱртньылыт,</para>
  <para style="q1" vid="NAM 2:5">ола пырдыж деке куржыт,</para>
  <para style="q1" vid="NAM 2:5">туштыжо олам сеҥен налаш чоҥежым нӧлтат.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />Эҥер дек лукшо капка-влак почылтыт,</para>
  <para style="q1" vid="NAM 2:6">да полатым шалатат.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />Пунчалым лукмо: Ниневий<note caller="*" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">«Ниневий» – тидым «Ниневийын ӱдырамаш кугыжаже» манынат кусараш лиеш. Тыште, очыни, Ассирийын ӱдырамаш кугыжаже але ӱдырамаш юмо Иштарын статуйжо нерген ойлалтеш.</char></note> чараҥдыме,</para>
  <para style="q1" vid="NAM 2:7">пленыш наҥгайыме лиеш.</para>
  <para style="q1" vid="NAM 2:7">Тудын тарзе ӱдырамашыже-влак</para>
  <para style="q2" vid="NAM 2:7">кӧгӧрчен семын йӧсланен васланат,</para>
  <para style="q1" vid="NAM 2:7">шкеныштым оҥышт гыч кырат.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Ниневий эре вӱд дене темше пӱя гай лийын,</para>
  <para style="q1" vid="NAM 2:8">а кызыт еҥ-влак тушеч урыктарыше<note caller="*" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Урыктараш – прорвать.</char></note> вӱд семын куржыт.</para>
  <para style="q1" vid="NAM 2:8">«Шогалза, шогалза!» – нунылан кычкырат,</para>
  <para style="q1" vid="NAM 2:8">но нигӧат ок савырне.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />«Налза шийым, шӧртньым руалтыза!</para>
  <para style="q1" vid="NAM 2:9">Нунын поянлыкыштлан уке мучаш,</para>
  <para style="q1" vid="NAM 2:9">шергакан арверыштым ок лий шотлен пытараш».<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />Олам агыме, пустаҥдыме, шалатыме.</para>
  <para style="q1" vid="NAM 2:10">Шӱм кӱлтка, пулвуй чытыра,</para>
  <para style="q1" vid="NAM 2:10">йыжыҥ пыта, чурий шапалга.<verse eid="NAM 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Кушто кызыт тиде кугу ола?</para>
  <para style="q1" vid="NAM 2:11">Тудо лев-влакын пыжашышт гай,</para>
  <para style="q2" vid="NAM 2:11">янлык-шамычын илыме верышт гай лийын.</para>
  <para style="q1" vid="NAM 2:11">Коштыныт тушто лев, лев иге ден аваже,</para>
  <para style="q1" vid="NAM 2:11">тургыжландарен огыл нуным нигӧ.<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Игыж-влакым пукшаш лев моло янлыкым кӱрыштын,</para>
  <para style="q1" vid="NAM 2:12">ава левлан пуаш мо кучымыжым пиктен пуштын,</para>
  <para style="q1" vid="NAM 2:12">илыме вержым, шке пыжашыжым,</para>
  <para style="q2" vid="NAM 2:12">кучен кӱрыштмӧ янлык-влак дене темен.<verse eid="NAM 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />«Мый тыйын ӱмбакет толам! –</para>
  <para style="q1" vid="NAM 2:13">ойла Господь Саваоф. –</para>
  <para style="q1" vid="NAM 2:13">Орват-влакым йӱлалтем, савырнат нуно шикшыш,</para>
  <para style="q1" vid="NAM 2:13">самырык лев-влакетым керде пытара.</para>
  <para style="q1" vid="NAM 2:13">Сонарыште иктаж-мом кучыметлан мучашым ыштем,</para>
  <para style="q1" vid="NAM 2:13">уверзе-влакетын йӱкышт тетла ок шокто».<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="cl">3 ГЛАВА</para>
  <para style="cd">1 Ойго Ниневийлан! 8 Ниневийым воштылмо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Вӱрым йоктарыше олалан ойго!</para>
  <para style="q1" vid="NAM 3:1">Темын тудо ондалчык да поген налме поянлык дене,</para>
  <para style="q1" vid="NAM 3:1">уке тушто агымашлан мучаш.<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Солам лупшымо да орава колдыртатыме йӱк шокта,</para>
  <para style="q1" vid="NAM 3:2">имне-влак рокмат, орва-влак кылдыртен каят.<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Тӧрга имнян сарзывий,</para>
  <para style="q1" vid="NAM 3:3">керде йылгыжеш, умдо йолга!</para>
  <para style="q1" vid="NAM 3:3">Шукын пытат, колышо кап-влак ора дене кият –</para>
  <para style="q1" vid="NAM 3:3">ок лий нуным шотлен пытараш,</para>
  <para style="q1" vid="NAM 3:3">кайышыштла нине капыш шӱртнят.<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />Тиде яжар ола шуко курваланен,<note caller="*" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Курваланаш – развратничать.</char></note></para>
  <para style="q1" vid="NAM 3:4">тудо мотор сынан, юзыланаш мастар,</para>
  <para style="q1" vid="NAM 3:4">яжарланымыж дене калык-влакым ужален,</para>
  <para style="q1" vid="NAM 3:4">юзыланымыж дене – тукым-шамычым.<verse eid="NAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />«Сандене Мый тыйын ӱмбакет толам, –</para>
  <para style="q1" vid="NAM 3:5">ойла Господь Саваоф. –</para>
  <para style="q1" vid="NAM 3:5">Вургем урвалтетым чурий декет нӧлталам</para>
  <para style="q1" vid="NAM 3:5">да калык-шамычлан чара улметым ончыктем,</para>
  <para style="q1" vid="NAM 3:5">кугыжаныш-влаклан намысле веретым почам.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Ӱмбакет тӱрлӧ йырныкым кышкен пытарем,</para>
  <para style="q1" vid="NAM 3:6">тыйым мыскылтышым ыштем</para>
  <para style="q1" vid="NAM 3:6">да еҥ шинча ончыко луктын шогалтем.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Тыйым ужын, кажныже тый дечет куржеш</para>
  <para style="q1" vid="NAM 3:7">да каласа: ”Ниневийым шалатыме!</para>
  <para style="q1" vid="NAM 3:7">Кӧ тудын верч шорташ тӱҥалеш?”</para>
  <para style="q1" vid="NAM 3:7">Кушто тылат лыпландарыше-влакым муам?»<verse eid="NAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Но-Амон<note caller="*" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Тиде олам Фива манынат лӱмдат, тудо акрет годсо Египетыште Мемфис деч вара кокымшо кугу ола лийын.</char></note> деч тый сайрак улат мо?</para>
  <para style="q1" vid="NAM 3:8">Тиде ола эҥер-влак коклаште шога,</para>
  <para style="q1" vid="NAM 3:8">чыла могырым тудым вӱд авырен.</para>
  <para style="q1" vid="NAM 3:8">Теҥыз тудын аралтышыже,</para>
  <para style="q2" vid="NAM 3:8">вӱд тудын пырдыжше лийыныт.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Эфиопий ден Египет тудын кугу вийже лийыныт,</para>
  <para style="q1" vid="NAM 3:9">Фут ден Ливий тудлан полшеныт.<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Но тиде олат пленыш логалын,</para>
  <para style="q1" vid="NAM 3:10">тушто илыше-шамычым вес верыш наҥгаеныт.</para>
  <para style="q1" vid="NAM 3:10">Изи йочаже-влакым уремлаште руэн пуштыныт,</para>
  <para style="q1" vid="NAM 3:10">лӱмлӧ еҥже-шамыч шотышто шеревам кышкеныт,</para>
  <para style="q1" vid="NAM 3:10">тӧраже-влакым шинчырленыт.<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Тый денетат тыгак лиеш – ушым йомдарымеш руштат,</para>
  <para style="q1" vid="NAM 3:11">тушман деч аралтышым кычал кает.<verse eid="NAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Карманет-влак смоква пушеҥгын кӱшӧ саскаж гай улыт:</para>
  <para style="q1" vid="NAM 3:12">рӱзалташ гын, кочкаш шонышын умшашкыже вигак камвозыт.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Ончал, сарзет-влак ӱдырамаш гай улыт:</para>
  <para style="q1" vid="NAM 3:13">тушман ончылно элысе капкат-влак комдык почылтыт,</para>
  <para style="q1" vid="NAM 3:13">тӱкылтыш-шамычым тул пӧжга.<verse eid="NAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Вӱдым шапашле, олам авырен налмылан ямдылалт,</para>
  <para style="q1" vid="NAM 3:14">карман-влакетым чоткыдемде!</para>
  <para style="q1" vid="NAM 3:14">Кай шунан верыш, тушто шуным тошко,</para>
  <para style="q1" vid="NAM 3:14">кермычлан калыпым ямдыле.<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Шукш ден шурнышырчык семын тӱлаҥат гынат,</para>
  <para style="q1" vid="NAM 3:15">тушто тыйым тул пӧжга, керде руа,</para>
  <para style="q1" vid="NAM 3:15">шукш семын тыйым пытарат.<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Сатучет-влак кавасе шӱдыр деч шукырак улыт,</para>
  <para style="q1" vid="NAM 3:16">но нунат шулдыраҥше шурнышырчык семын чоҥештен каят.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Тӧра ден возкалышет-влак шурнышырчык тӱшка гай улыт:</para>
  <para style="q1" vid="NAM 3:17">йӱштӧ годым нуно кӱ савар шелшыш шылыт,</para>
  <para style="q1" vid="NAM 3:17">кунам кече лектеш – чоҥештен пытат,</para>
  <para style="q1" vid="NAM 3:17">а кушко – ок пале нигӧат.<verse eid="NAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />Ассирий кугыжа! Вуйлатышет-влак мален колтеныт,</para>
  <para style="q1" vid="NAM 3:18">тӧрат-влак курымаш омо дене малат.</para>
  <para style="q1" vid="NAM 3:18">Калыкет курыклашке шаланен пытен,</para>
  <para style="q1" vid="NAM 3:18">нигӧлан нуным погаш.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Сусыретым паремдаш ок лий,</para>
  <para style="q1" vid="NAM 3:19">эмганыметше ок тӧрлане.</para>
  <para style="q1" vid="NAM 3:19">Чыланат, тый денет мо лиймым палымеке,</para>
  <para style="q1" vid="NAM 3:19">тӱҥалыт совыштым кыраш.</para>
  <para style="q1" vid="NAM 3:19">Мучашдыме осаллыкетым кӧлан гына чыташ логалын огыл?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>