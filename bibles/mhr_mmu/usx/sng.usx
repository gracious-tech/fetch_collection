<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Meadow Mari Bible</book>
  <para style="h">Мур</para>
  <para style="toc3">Мур</para>
  <para style="toc2">Чыла мурылан муро</para>
  <para style="toc1">Чыла мурылан муро</para>
  <para style="mt">ЧЫЛА МУРЫЛАН МУРО</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">1 Ӱдыр йӧратымашыж нерген ойла. 8 Каче йӧратыме ӱдыржым мокта. 11 Ӱдыр ден каче икте-весыштлан ойлат.</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 1:1" />«Тек тудо мыйым шупшалеш, ӱмаж дене леведеш!</para>
  <para style="q1" vid="SNG 1:1">Тыйын йӧратымашет йошкар арака деч сайрак.<verse eid="SNG 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Шӱрымӧ ӱетше могай тамле пушан!</para>
  <para style="q1" vid="SNG 1:2">Лӱметше – велыме тамлыпушан ӱй гай,</para>
  <para style="q1" vid="SNG 1:2">садлан ӱдыр-влак тыйым йӧратат.<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />Наҥгай мыйым пеленет, айда куржына!</para>
  <para style="q1" vid="SNG 1:3">Кугыжам мыйым шке пӧлемлашкыже пуртыш.</para>
  <para style="q1" vid="SNG 1:3">Ме тый денет куанен йывырташ тӱҥалына,</para>
  <para style="q1" vid="SNG 1:3">вет йӧратымашет йошкар арака деч чаплырак –</para>
  <para style="q1" vid="SNG 1:3">арам огыл тыйым тынар йӧратат.<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Иерусалимын ӱдыржӧ-влак,</para>
  <para style="q1" vid="SNG 1:4">улам мый шеме, но мотор,</para>
  <para style="q1" vid="SNG 1:4">Кедарысе омаш-влак да Соломонын пӱрдышыж гай.<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />Тыгай шеме улам манын ида ончо –</para>
  <para style="q1" vid="SNG 1:5">тиде мый кечеш кӱынам.</para>
  <para style="q1" vid="SNG 1:5">Иза-шольым-влак мылам шыдешкеныт</para>
  <para style="q1" vid="SNG 1:5">да виноград аҥам оролаш шогалтеныт,</para>
  <para style="q1" vid="SNG 1:5">сандене мый шке виноград аҥам оролен кертын омыл.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />Каласе, йӧратымем, кушто кӱтӱм кӱтет,</para>
  <para style="q1" vid="SNG 1:6">кушто нунын дене кечывалым канет?</para>
  <para style="q1" vid="SNG 1:6">Молан мылам йолташет-влакын кӱтӱшт воктене,</para>
  <para style="q2" vid="SNG 1:6">чурием леведын, тыйым кычалын кошташ?»<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />«Ӱдырамаш-влак кокла гыч эн моторжо,</para>
  <para style="q1" vid="SNG 1:7">тый тидым от пале гын,</para>
  <para style="q1" vid="SNG 1:7">шорык-влакын кышашт почеш кае</para>
  <para style="q1" vid="SNG 1:7">да казапачат-шамычым кӱтӱчӧ-влакын омашышт воктене кӱтӧ».<verse eid="SNG 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />«Йӧратымем, тый фараон орваш кычкыме вӱльӧ гай улат!<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />Сӧрастарыш йымалысе шӱргыначкат,</para>
  <para style="q1" vid="SNG 1:9">шерым сакыман шӱет моторын койыт!<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />Ыштена ме тылат шӧртньӧ сӧрастарышым,</para>
  <para style="q1" vid="SNG 1:10">ший чинчаным».<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />«Кунам мыйын кугыжам ӱстелтӧрыштӧ лийын,</para>
  <para style="q1" vid="SNG 1:11">капем нард<note caller="*" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Нард – кушкыл, тудын вожшо гыч тамле пушан ӱйым ыштеныт.</char></note> семын тамлыпушым луктын.<verse eid="SNG 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />Мыйын йӧратымем – пуйто миррам<note caller="*" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">Мирра – Аравийысе кушкылын тамлын ӱпшышӧ кишыже.</char></note> пыштыман калта,</para>
  <para style="q1" vid="SNG 1:12">оҥпогем коклаште тудыжо кия.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Мыйын йӧратымем –</para>
  <para style="q1" vid="SNG 1:13">пуйто Ен-Гедисе виноград аҥасе хна пеледыш аршаш».<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />«Могай мотор улат, йӧратымем, улат тый сылне,</para>
  <para style="q1" vid="SNG 1:14">а шинчатше кӧгӧрчен гай!»<verse eid="SNG 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />«Могай мотор улат, шӱмбелем, улат тый сӧрал!</para>
  <para style="q1" vid="SNG 1:15">Мемнан кийыме верна – ужар шудо,<verse eid="SNG 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />кедр-влак улыт пӧрт леведышна,</para>
  <para style="q1" vid="SNG 1:16">а туврашыже – кипарис гычын».<verse eid="SNG 1:16" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="cl">2 ГЛАВА</para>
  <para style="cd">1 Шаронысо нарцисс да олмапу. 8 Мыйын йӧратымем лишемеш. 10 Мурымо жап толын шуын. 16 Йӧратымем улеш мыйын, да мыят тудын улам.</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />«Улам мый Шаронысо нарцисс,</para>
  <para style="q1" vid="SNG 2:1">лапверысе лилий улам!»<verse eid="SNG 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />«Моло ӱдыр коклаште мыйын йӧратымем –</para>
  <para style="q1" vid="SNG 2:2">пуйто иман вондер лоҥгаште лилий».<verse eid="SNG 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />«Моло рвезе коклаште мыйын йӧратымем –</para>
  <para style="q1" vid="SNG 2:3">пуйто чодырасе пушеҥге лоҥгаште олмапу.</para>
  <para style="q1" vid="SNG 2:3">Йӧратем мый тудын ӱмылыштыжӧ шинчаш,</para>
  <para style="q1" vid="SNG 2:3">саскажат умшамлан пеш шере.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />Тудо мыйым йошкар аракам йӱмӧ омашыш пуртен,</para>
  <para style="q1" vid="SNG 2:4">ӱмбалнем тудын тистыже – йӧратымаш.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Вийым погаш манын,</para>
  <para style="q1" vid="SNG 2:5">пуыза мылам изюмым, пукшыза олмам –</para>
  <para style="q1" vid="SNG 2:5">йӧратымаш деч мыйын алем кая.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Тудын шола кидше – вуй йымалнем,</para>
  <para style="q1" vid="SNG 2:6">а пурлаже мыйым ӧндалеш.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />Иерусалимын ӱдыржӧ-влак,</para>
  <para style="q1" vid="SNG 2:7">ирказа да пӱчӧ-влак дене мылам товатлыза:</para>
  <para style="q1" vid="SNG 2:7">жап деч ончыч йӧратымашым ида помыжалте,</para>
  <para style="q1" vid="SNG 2:7">тудым ида кынелте!<verse eid="SNG 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Йӧратымемын йӱкшым колам!</para>
  <para style="q1" vid="SNG 2:8">Теве тудо толеш –</para>
  <para style="q1" vid="SNG 2:8">чоҥгата ӱмбалне тӧрштылын, курыкла ӱмбалне тӧрген.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Шӱмбелемже – пуйто ир казатага але самырык пӱчӧ.</para>
  <para style="q1" vid="SNG 2:9">Теве тудо шога пӧрт пырдыжна шеҥгелне,</para>
  <para style="q1" vid="SNG 2:9">тӧрзашке онча, окна петыртыш гоч ужнеже.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Йӧратымем мылам каласыш:</para>
  <para style="q1" vid="SNG 2:10">”Кынел, шӱмбелем, лек, моторем!<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Ончал – теле эртен,</para>
  <para style="q1" vid="SNG 2:11">йӱр чарнен, эртен каен.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Олыклаште пеледыш коеш,</para>
  <para style="q1" vid="SNG 2:12">мурымо жап толын шуын,</para>
  <para style="q1" vid="SNG 2:12">кундемыштына кеде йӱк шокта.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Смоква пушеҥгын саскаже кӱэш,</para>
  <para style="q1" vid="SNG 2:13">пеледше виноград тамле пушым шара.</para>
  <para style="q1" vid="SNG 2:13">Кынел, йӧратымем, лек, моторем!<verse eid="SNG 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />Курыкоҥ помышышто шинчыше кӧгӧрченем,</para>
  <para style="q1" vid="SNG 2:14">сергӱ йымалне шылше шӱмбелем!</para>
  <para style="q1" vid="SNG 2:14">Мылам чуриетым ончыкто, йӱкетым колнем,</para>
  <para style="q1" vid="SNG 2:14">вет йӱкетше ныжыл, чуриет мотор”».<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />Кучыза рывыж-влакым, изи рывыж-влакым –</para>
  <para style="q1" vid="SNG 2:15">локтылыт нуно виноград аҥам.</para>
  <para style="q1" vid="SNG 2:15">А кызыт виноград аҥана-влак лач пеледыт!<verse eid="SNG 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />«Йӧратымем улеш мыйын, мыят тудын улам.</para>
  <para style="q1" vid="SNG 2:16">Лилий коклаште тудын кӱтымӧ верже.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />Юалге кас мардеж лекмешке да ӱмыл йоммешке</para>
  <para style="q2" vid="SNG 2:17">пӧртыл, йӧратымем:</para>
  <para style="q1" vid="SNG 2:17">курыкан верласе ир казатага але самырык пӱчӧ семын вашке!»<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="cl">3 ГЛАВА</para>
  <para style="cd">1 «Кушто мыйын йӧратыме качем?» 6 «Кӧ тиде ӱдыр, ир мланде гыч толшо?»</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />«Йӱдым вакшыштем шке йӧратымем кычальым –</para>
  <para style="q1" vid="SNG 3:1">кычальым мый, но шым му.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />”Кынелам мый, каем ола мучко,</para>
  <para style="q1" vid="SNG 3:2">урем-влакым, калык погынымо верлам эртем –</para>
  <para style="q1" vid="SNG 3:2">кычалам мый тудым, кӧм йӧратем”.</para>
  <para style="q1" vid="SNG 3:2">Кычальым тудым, но шым му.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />Ола мучко коштшо орол-влак мыйым вашлийыч,</para>
  <para style="q1" vid="SNG 3:3">да мый нунын деч йодым:</para>
  <para style="q1" vid="SNG 3:3">”Ужында мо те мыйын йӧратымем?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Изиш веле нунын деч кораҥым –</para>
  <para style="q1" vid="SNG 3:4">муым тудым, кӧм йӧратем.</para>
  <para style="q1" vid="SNG 3:4">Тудым пӱтырен кучышым, нигушкат шым колто</para>
  <para style="q1" vid="SNG 3:4">да авамын пӧртышкыжӧ, мыйым шочыктышын пӧлемышкыже,</para>
  <para style="q2" vid="SNG 3:4">тудым кондышым».<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />Иерусалимын ӱдыржӧ-влак,</para>
  <para style="q1" vid="SNG 3:5">ирказа да пӱчӧ-влак дене мылам товатлыза:</para>
  <para style="q1" vid="SNG 3:5">жап деч ончыч йӧратымашым ида помыжалте,</para>
  <para style="q1" vid="SNG 3:5">тудым ида кынелте.<verse eid="SNG 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Кӧ тиде ӱдыр, ир мланде гыч шикш меҥге семын толшо?</para>
  <para style="q1" vid="SNG 3:6">Тудо мирра да ладын дене,</para>
  <para style="q1" vid="SNG 3:6">купеч-влакын кондымо тамлыпушан насташт дене пушлана.<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Ончалза! Тиде Соломонын паланкинже,<note caller="*" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Паланкин – леведышан да эҥертышан шинчыме вер, тудым кок вара дене нумал коштыныт.</char></note></para>
  <para style="q1" vid="SNG 3:7">тудын йыр – кудло сарзе,</para>
  <para style="q1" vid="SNG 3:7">улыт нуно Израильын тале сарзыже-влак.<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />Чылаштын уло керде, туныктымо улыт нуно кредалаш,</para>
  <para style="q1" vid="SNG 3:8">кажнын эрдыштыже керде кеча,</para>
  <para style="q1" vid="SNG 3:8">ямде улыт нуно йӱд лӱдыкшым чактараш.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Ыштен шке паланкинжым Соломон кугыжа</para>
  <para style="q2" vid="SNG 3:9">ливанысе пушеҥге дене,<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />меҥгыжым – ший дене,</para>
  <para style="q1" vid="SNG 3:10">эҥертышыжым – шӧртньӧ дене.</para>
  <para style="q1" vid="SNG 3:10">Шинчыме вержым шемалге-йошкар куэм дене леведме,</para>
  <para style="q1" vid="SNG 3:10">кӧргыжым Иерусалимын ӱдыржӧ-влак йӧратен сӧрастареныт.<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />Толза, Сионын ӱдыржӧ-влак,</para>
  <para style="q1" vid="SNG 3:11">вуйшӱдышым чийыше Соломон кугыжам ончалза –</para>
  <para style="q1" vid="SNG 3:11">ты вуйшӱдышым аваже тудлан сӱан кечын,</para>
  <para style="q2" vid="SNG 3:11">эргыжын эн куанле кечынже, чиктен.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="cl">4 ГЛАВА</para>
  <para style="cd">1 Каче шке таҥжын мотор улмыж нерген ойла. 8 «Шӱмбелем, каена мый денем!»</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />«Мотор улат, йӧратымем, улат сӧрале!</para>
  <para style="q1" vid="SNG 4:1">Чурий леведыш вошт шинчат коеш кӧгӧрчен гай,</para>
  <para style="q1" vid="SNG 4:1">ӱпетше – Галаад курык гыч волышо каза кӱтӱ гай.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />Пӱетше – мушмо да тӱредме шорык кӱтӱ гай,</para>
  <para style="q1" vid="SNG 4:2">кажныжын йыгыр пелашыже уло,</para>
  <para style="q1" vid="SNG 4:2">нунын коклаште шкет кодшо уке.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Тӱрвет – ал тасма гай,</para>
  <para style="q1" vid="SNG 4:3">умшат тыйын чатка.</para>
  <para style="q1" vid="SNG 4:3">Шӱргыначкатше – гранат саска гай,</para>
  <para style="q1" vid="SNG 4:3">чурий леведыш вошт тудо коеш.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />Шӱетше – саргураллан чоҥымо Давидын башньыж гай,</para>
  <para style="q1" vid="SNG 4:4">тӱжем авыртыш тушто кеча,</para>
  <para style="q1" vid="SNG 4:4">нуно сарзе-влакын авыртышышт улыт.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />Кок чызет – пуйто кок самырык пӱчӧ,</para>
  <para style="q1" vid="SNG 4:5">лилий-влак коклаште коштшо йыгыр ирказа.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />Юалге кас мардеж лекмешке да ӱмыл йоммешке,</para>
  <para style="q1" vid="SNG 4:6">мый мирра курыкыш да ладын чоҥгашке каем.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />Йӧратымем, улат чатка тый пӱтынек,</para>
  <para style="q1" vid="SNG 4:7">ик экшыкат уке ӱмбалнет!<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Шӱмбелем, каена мый денем, каена Ливан гыч!</para>
  <para style="q1" vid="SNG 4:8">Воло Амана курык вуй гыч,</para>
  <para style="q1" vid="SNG 4:8">Сенир ден Ермон курык вуй гыч,</para>
  <para style="q1" vid="SNG 4:8">левын пыжашыж деч,</para>
  <para style="q1" vid="SNG 4:8">леопардын илыме курыкшо гыч!<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Шӱжарем, шӱмбелем, шӱмем савыренат!</para>
  <para style="q1" vid="SNG 4:9">Шӱйысӧ шеретым ужмо денак,</para>
  <para style="q2" vid="SNG 4:9">ик ончалтышет дене мыйым сымыстаренат.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />Шӱжарем, шӱмбелем,</para>
  <para style="q1" vid="SNG 4:10">могай ямле йӧратымашет!</para>
  <para style="q1" vid="SNG 4:10">Йошкар арака деч тудо мыняр пачаш сайрак,</para>
  <para style="q1" vid="SNG 4:10">шӱрымӧ ӱетын пушыжат чыла тамлыпуш деч сайрак!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />Шӱмбелем, тӱрвет гыч караш мӱй чыпча,</para>
  <para style="q1" vid="SNG 4:11">шупшалметше мӱй да шӧр гай тамле,</para>
  <para style="q1" vid="SNG 4:11">Ливан кедрын тамлыпушыжо вургемет деч шарла.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />Шӱжарем, шӱмбелем,</para>
  <para style="q1" vid="SNG 4:12">тый тӱкылен шындыме сад,</para>
  <para style="q2" vid="SNG 4:12">леведме таве, печать дене петырыме памаш улат!<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Кушкыт тиде садыште гранат,</para>
  <para style="q2" vid="SNG 4:13">тӱрлӧ чапле саска, нард ден хна.<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />Тушто – нард ден шафран, аир ден корице,</para>
  <para style="q1" vid="SNG 4:14">тамлыпушан тӱрлӧ пушеҥге, мирра ден алой,</para>
  <para style="q1" vid="SNG 4:14">эн сай тамлыпушан кушкыл-влак.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />Улат тый садысе памаш – йоргыктышо вӱдан таве,</para>
  <para style="q1" vid="SNG 4:15">йогынжо Ливан курык гыч толеш».<verse eid="SNG 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />«Кынел, йӱдвелысе мардеж!</para>
  <para style="q1" vid="SNG 4:16">Тол, кечывалвел мардеж!</para>
  <para style="q1" vid="SNG 4:16">Пуалза сад ӱмбакем, тамле пушыжым шарыза!</para>
  <para style="q1" vid="SNG 4:16">Тек йӧратыме качем шке садышкыже толеш</para>
  <para style="q1" vid="SNG 4:16">да чапле саскажым кочкеш».<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="cl">5 ГЛАВА</para>
  <para style="cd">1 «Шке садышкем мый тольым». 2 Ӱдырын омыжо. 9 Ӱдыр шке качыжын могай улмыж нерген ойла.</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />«Шӱжарем, шӱмбелем, шке садышкем мый тольым,</para>
  <para style="q1" vid="SNG 5:1">тамлыпуш ден миррам погышым.</para>
  <para style="q1" vid="SNG 5:1">Кочкым шке караш мӱемым,</para>
  <para style="q1" vid="SNG 5:1">йӱым йошкар арака ден шӧрем.</para>
  <para style="q1" vid="SNG 5:1">Кочса, йолташем-влак!</para>
  <para style="q1" vid="SNG 5:1">Шер теммеш йӱза, йӧратымем-влак!»<verse eid="SNG 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />«Кеч малем мый, но шӱмем ок мале...</para>
  <para style="q1" vid="SNG 5:2">Колам – тӱкала, йӧратымемын йӱкшӧ шокта:</para>
  <para style="q1" vid="SNG 5:2">”Поч, шӱжарем, поч, йӧратымем, ару кӧгӧрченем.</para>
  <para style="q1" vid="SNG 5:2">Вуем лупс дене нӧрен, ӱпем – йӱд вӱдыжгӧ дене”.<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Вургемым мый кудашынам – угычын мо чийыман?</para>
  <para style="q1" vid="SNG 5:3">Йолемым мушкынам – адакат амыртыман?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Йӧратымем шке кидшым омса вишыш чыкыш,</para>
  <para style="q1" vid="SNG 5:4">да чыла кӧргем йӱлаш тӱҥале.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Йӧратымемлан почаш манын, мый кынельым –</para>
  <para style="q1" vid="SNG 5:5">кидемже гыч мирра чыпчен,</para>
  <para style="q1" vid="SNG 5:5">мирра парням гыч омса тӱкылтышыш чыпчен.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Йӧратымемлан мый почым омсам,</para>
  <para style="q1" vid="SNG 5:6">а тудо савырнен да каенат шуктен!</para>
  <para style="q1" vid="SNG 5:6">Чонем пуйто лекте –</para>
  <para style="q1" vid="SNG 5:6">кычальым мый тудым, но шым му,</para>
  <para style="q1" vid="SNG 5:6">ӱжым, но тудо йӱкым ыш пу.<note caller="*" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />Ола мучко коштшо орол-влак мыйым вашлийыч,</para>
  <para style="q1" vid="SNG 5:7">нуно мыйым кырышт, сусыртышт –</para>
  <para style="q1" vid="SNG 5:7">пырдыжым оролышо-шамыч ӱмбал леведышем шупшын нальыч.<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />Иерусалимын ӱдыржӧ-влак, мылам товатлыза:</para>
  <para style="q1" vid="SNG 5:8">йӧратымемым вашлийыда гын, каласыза тудлан –</para>
  <para style="q1" vid="SNG 5:8">йӧратымаш деч мыйын алем кая».<verse eid="SNG 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />«Ӱдыр-влак кокла гыч эн сӧрале,</para>
  <para style="q1" vid="SNG 5:9">мо дене тыйын йӧратымет моло деч сайрак?</para>
  <para style="q1" vid="SNG 5:9">Молан тый мемнам тыге товатлаш йодат –</para>
  <para style="q1" vid="SNG 5:9">мо дене тудо моло деч сайрак?»<verse eid="SNG 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />«Йӧратымем мыйын сынле да чевер,</para>
  <para style="q1" vid="SNG 5:10">лу тӱжем пӧръеҥ деч чаплырак.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Вуйжо тудын – яндар шӧртньӧ,</para>
  <para style="q1" vid="SNG 5:11">ӱпшӧ – кудыр, курныж гай шем тӱсан.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Шинчаже – вӱдйогын воктенысе кӧгӧрчен гай,</para>
  <para style="q1" vid="SNG 5:12">кудышт шӧрыштӧ йӱштылыт, пӱя воктене шинчат.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Шӱргыначкаже – тамым пуышо кушкылан пакча,</para>
  <para style="q1" vid="SNG 5:13">тамлыпушан шудым шочыктышо йыраҥ,</para>
  <para style="q1" vid="SNG 5:13">тӱрвыжӧ – пуйто лилий, кушечын мирра чыпча.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Кидше – шӧртньӧ вара, топаз дене сӧрастарыме.</para>
  <para style="q1" vid="SNG 5:14">Мӱшкыржӧ – пуйто слон лу гыч ыштыме</para>
  <para style="q2" vid="SNG 5:14">да сапфир дене леведме.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Йолжо – пуйто мрамор меҥге,</para>
  <para style="q1" vid="SNG 5:15">негызше тудыжын шӧртньӧ.</para>
  <para style="q1" vid="SNG 5:15">Коеш тудо Ливанысе чодыра гай,</para>
  <para style="q1" vid="SNG 5:15">кедр гай кӱдыратле улеш.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Ӱмаже тудын шере,</para>
  <para style="q1" vid="SNG 5:16">пӱтынек тудо чонйодмемлан келшыше.</para>
  <para style="q1" vid="SNG 5:16">Теве тыгай йӧратымем, мыйын таҥем,</para>
  <para style="q1" vid="SNG 5:16">Иерусалимын ӱдыржӧ-влак!»<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="cl">6 ГЛАВА</para>
  <para style="cd">1 Ӱдыр дене мутланат. 4 Каче шке ӱдыржын моторлыкшым мокта. 8 Мыйын йӧратыме ӱдырем гай весе уке. 11 Пӱкшерме пакчаште.</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />«Ӱдыр-влак кокла гыч эн сӧрале,</para>
  <para style="q1" vid="SNG 6:1">кушто тыйын йӧратыметше?</para>
  <para style="q1" vid="SNG 6:1">Кудо велыш тудо каен?</para>
  <para style="q1" vid="SNG 6:1">Ме тудым тый денет пырля кычалаш тӱҥалына».<verse eid="SNG 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />«Йӧратымем каен шке садышкыже,</para>
  <para style="q1" vid="SNG 6:2">тамым пуышо кушкылан пакчашке –</para>
  <para style="q1" vid="SNG 6:2">сад лоҥгаште кошташ да лилийым погаш.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Мый шӱмбелемын улам, а тудо – мыйын.</para>
  <para style="q1" vid="SNG 6:3">Лилий коклаште тудын кӱтымӧ верже».<verse eid="SNG 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />«Йӧратымем, улат тый Фирца<note caller="*" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Фирца – акрет годым Израильысе тиде ола мотор улмыж дене чапланен.</char></note> гай мотор,</para>
  <para style="q1" vid="SNG 6:4">Иерусалим гай сӧрале,</para>
  <para style="q1" vid="SNG 6:4">тисте-влакан сарзывий семын лӱдмашым лукшо.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Ӱмбачем шинчатым кораҥде,</para>
  <para style="q1" vid="SNG 6:5">тудо чонем пудырата.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Ӱпетше – Галаад курык гыч волышо каза кӱтӱ гай,</para>
  <para style="q1" vid="SNG 6:6">пӱетше – мушмо шорык кӱтӱ гай,</para>
  <para style="q1" vid="SNG 6:6">кажныжын йыгыр пелашыже уло,</para>
  <para style="q1" vid="SNG 6:6">нунын коклаште шкет кодшо уке.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Шӱргыначкатше – гранат саска гай,</para>
  <para style="q1" vid="SNG 6:7">чурий леведыш вошт тудо коеш.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Кудло кугыжанвате, кандашле кулвате</para>
  <para style="q2" vid="SNG 6:8">да шотлен пытарыдыме ӱдыр-влак улыт,<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />но тудо мыйын тыгай икте–</para>
  <para style="q1" vid="SNG 6:9">кӧгӧрченем, ару да яндарем.</para>
  <para style="q1" vid="SNG 6:9">Тудо – аважын ик шкет ӱдыржӧ,</para>
  <para style="q1" vid="SNG 6:9">тудым шочыктышын ойыртемалтше ӱдыржӧ.</para>
  <para style="q1" vid="SNG 6:9">Тудым ужын, ӱдыр-влак ”пиалан улат” маныныт,</para>
  <para style="q1" vid="SNG 6:9">кугыжанвате ден кулвате-влак тудым моктеныт».<verse eid="SNG 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />«Кӧ тиде – эр ӱжара гай волгалтше,</para>
  <para style="q1" vid="SNG 6:10">тылзе гай мотор, кече гай чолгыжшо,</para>
  <para style="q1" vid="SNG 6:10">тисте-влакан сарзывий семын лӱдмашым лукшо?»<verse eid="SNG 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />«Кайышым мый пӱкшерме пакчаш</para>
  <para style="q2" vid="SNG 6:11">лапверысе ужаргым ончалаш.</para>
  <para style="q1" vid="SNG 6:11">Нерешталтын мо виноград,</para>
  <para style="q1" vid="SNG 6:11">гранат пушеҥгылаште коеш мо пеледыш?<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Мый денем мо лийын, шкежат ом пале –</para>
  <para style="q1" vid="SNG 6:12">шке калыкемын лӱмлӧ еҥже-влакын орваштышт мый лийым».<note caller="*" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="SNG 6:12" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="cl">7 ГЛАВА</para>
  <para style="cd">1 Сулам гыч ӱдыр. 2 Каче шке ӱдыржын моторлыкшым мокта. 11 Ӱдыр качылан вашешта.</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />«Пӧртыл, савырне мӧҥгеш, Сулам гыч ӱдыр!</para>
  <para style="q1" vid="SNG 7:1">Пӧртыл, савырне мӧҥгеш – ме тыйым ончалына!»</para>
  <para style="q1" vid="SNG 7:1">Молан тыланда Сулам ӱдыр ӱмбак</para>
  <para style="q1" vid="SNG 7:1">Манаимысе куштымашым ончымо семын ончаш?<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />«Лӱмлӧ ӱдыр,</para>
  <para style="q1" vid="SNG 7:2">сандальым чийыше йолетше мотор,</para>
  <para style="q1" vid="SNG 7:2">эрдет – уста мастарын ыштыме шӱшерже гай йыргешке.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />Мӱшкырет – пуйто йыргешке чаше,</para>
  <para style="q1" vid="SNG 7:3">кушто тамлештарыме йошкар арака огеш шагалем.</para>
  <para style="q1" vid="SNG 7:3">Тудо – пуйто шыдаҥ кышыл,</para>
  <para style="q1" vid="SNG 7:3">лилий-влак дене авырыме.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Чызет – пуйто кок самырык пӱчӧ, йыгыр ирказа.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Шӱет – пуйто слон лу гыч ыштыме башне,</para>
  <para style="q1" vid="SNG 7:5">шинчат – Батраббим капка воктенысе Есевон пӱя,</para>
  <para style="q1" vid="SNG 7:5">неретше – пуйто Дамаскыш ончышо мотор Ливан башне.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Вует тыйын – пуйто Кармил курык,</para>
  <para style="q1" vid="SNG 7:6">вуйысо ӱпет – шемалге-йошкарге,</para>
  <para style="q1" vid="SNG 7:6">кудыр ӱпет дене тый кугыжам шке декет савырет.<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Могай тый мотор да сымыстарыше улат, йӧратымем!</para>
  <para style="q1" vid="SNG 7:7">Улат тый мыйын куанем!<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />Капкылетше – пуйто пальме,</para>
  <para style="q1" vid="SNG 7:8">оҥпогетше – тудын саскаже.<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />Шоналтышым мый:</para>
  <para style="q1" vid="SNG 7:9">”Тиде пальмыш кӱзем,</para>
  <para style="q1" vid="SNG 7:9">укшлажым руалтен кучем”.</para>
  <para style="q1" vid="SNG 7:9">Оҥпогет лиеш тудын саскаже,</para>
  <para style="q1" vid="SNG 7:9">шӱлалтышет олма дене пушлана,<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />а умшатше – пуйто эн сай йошкар арака».</para>
  <para style="q1" vid="SNG 7:10">«Йоген кая тудо йӧратыме качем дек,</para>
  <para style="q1" vid="SNG 7:10">малыше-влакын тӱрвышкышт йога.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Улам мый лач йӧратымемын,</para>
  <para style="q1" vid="SNG 7:11">тудынат кумылжо мый декем шупшеш.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Тол, йӧратымем, олыкыш каена,</para>
  <para style="q1" vid="SNG 7:12">йӱдым ялыште эртарена.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />А эрдене каена виноград аҥалашке</para>
  <para style="q1" vid="SNG 7:13">да ончалына – нерешталтын мо виноград,</para>
  <para style="q1" vid="SNG 7:13">почылтын мо пеледышлык,</para>
  <para style="q1" vid="SNG 7:13">гранат пушеҥгылаште коеш мо пеледыш?</para>
  <para style="q1" vid="SNG 7:13">Тушто тылат мый йӧратымашем пӧлеклем.<verse eid="SNG 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 7:14" />Мандрагор-влак тамле пушым шарат,</para>
  <para style="q1" vid="SNG 7:14">омсана воктене улыт тӱрлӧ сай саска, у ден тоштыжат –</para>
  <para style="q1" vid="SNG 7:14">нуным, йӧратымем, тылат арален коденам!»<verse eid="SNG 7:14" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="cl">8 ГЛАВА</para>
  <para style="cd">1 «О, тый мыйын изам лият ыле гын!» 5 Йӧратымаш – колымаш гай виян. 11 Соломонын виноград аҥаже. 14 «Вашке тол, йӧратыме качем!»</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />«Лият ыле гын тый мыйын изам,</para>
  <para style="q1" vid="SNG 8:1">кӧлан авам чызыжым пукшен –</para>
  <para style="q1" vid="SNG 8:1">уремыште, тыйым вашлиймеке,</para>
  <para style="q1" vid="SNG 8:1">шупшал пытарем ыле,</para>
  <para style="q1" vid="SNG 8:1">да нигӧ мыйым ок шылтале ыле.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />Мый тыйым вӱден наҥгаем ыле,</para>
  <para style="q1" vid="SNG 8:2">кондем ыле авамын суртышкыжо.</para>
  <para style="q1" vid="SNG 8:2">Тый мыйым туныктет ыле,</para>
  <para style="q1" vid="SNG 8:2">а мый тыланет тамлештарыме йошкар аракам,</para>
  <para style="q2" vid="SNG 8:2">гранат-влакемын сокшым йӱктем ыле.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Йӧратымемын шола кидше – вуй йымалнем,</para>
  <para style="q1" vid="SNG 8:3">а пурлаже мыйым ӧндалеш».<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />Иерусалимын ӱдыржӧ-влак, мылам товатлыза:</para>
  <para style="q1" vid="SNG 8:4">жап деч ончыч йӧратымашым ида помыжалте,</para>
  <para style="q1" vid="SNG 8:4">тудым ида кынелте!<verse eid="SNG 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Кӧ тиде ир мланде гыч толеш,</para>
  <para style="q1" vid="SNG 8:5">йӧратымыжын кидышкыже эҥертен?</para>
  <para style="q1" vid="SNG 8:5">Олмапу йымалне мый тыйым помыжалтышым,</para>
  <para style="q1" vid="SNG 8:5">тушто тыйым ават ыштен,</para>
  <para style="q2" vid="SNG 8:5">шочыктышет тыйым ыштен.<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Пыште мыйым печать семын шӱмышкет,</para>
  <para style="q1" vid="SNG 8:6">печатян шергаш семын чикте парняшкет,</para>
  <para style="q1" vid="SNG 8:6">вет йӧратымаш – колымаш гай виян,</para>
  <para style="q1" vid="SNG 8:6">тудын тулжо вес тӱня гай ажгын.</para>
  <para style="q1" vid="SNG 8:6">Тудын пикшыже-влак улыт тулан,</para>
  <para style="q1" vid="SNG 8:6">йӧратымаш – кугу куатан тулйолкын.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Кугу вӱд-влак тудым йӧртен огыт керт,</para>
  <para style="q1" vid="SNG 8:7">эҥер-влак тудым мушкын огыт наҥгай.</para>
  <para style="q1" vid="SNG 8:7">Иктаж-кӧ йӧратымаш верч пуа гын чыла поянлыкшым,</para>
  <para style="q1" vid="SNG 8:7">тыгай еҥ мыскылымашым гына сула ыле.<verse eid="SNG 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />«Мемнан уло изи шӱжарна,</para>
  <para style="q1" vid="SNG 8:8">тудын чызыжат эше кушкын огыл.</para>
  <para style="q1" vid="SNG 8:8">Мом мыланна шӱжар дене ышташ,</para>
  <para style="q1" vid="SNG 8:8">кунам толыт тудын дек туларташ?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Лиеш ыле гын тудо пырдыж,</para>
  <para style="q1" vid="SNG 8:9">ме тушан ший пӱян башне-влакым нӧлталына ыле,</para>
  <para style="q1" vid="SNG 8:9">лиеш ыле гын тудо омса,</para>
  <para style="q1" vid="SNG 8:9">ме тудым кедр оҥа дене комыжлена ыле».<verse eid="SNG 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />«Улам мый пырдыж,</para>
  <para style="q1" vid="SNG 8:10">оҥпогемже – пуйто башне,</para>
  <para style="q1" vid="SNG 8:10">садлан тудын шинчаштыже кушкын шушо ӱдыр улам.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />Ваал-Гамонышто Соломонын виноград аҥаже лийын,</para>
  <para style="q1" vid="SNG 8:11">тудым Соломон еҥ-влаклан ончаш пуэн.</para>
  <para style="q1" vid="SNG 8:11">Саскажлан кажныже тӱжем ший оксам кондышаш улмаш.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />А мыйын виноград аҥам – лач мыйын.</para>
  <para style="q1" vid="SNG 8:12">Тек тӱжем ший окса, Соломон, тылат лиеш,</para>
  <para style="q1" vid="SNG 8:12">а кокшӱдӧ – саскам ончышылан».<verse eid="SNG 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />«Сад коклаште шинчыше ӱдыр!</para>
  <para style="q1" vid="SNG 8:13">Йолташем-влак колыт йӱкетым,</para>
  <para style="q1" vid="SNG 8:13">пу мыламат тыйын йӱкетым колаш».<verse eid="SNG 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />«Вашке тол, йӧратымем!</para>
  <para style="q1" vid="SNG 8:14">Лий бальзам курыкласе ир казатага але самырык пӱчӧ гай!»<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>