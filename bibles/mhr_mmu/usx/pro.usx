<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Meadow Mari Bible</book>
  <para style="h">Тун.кал</para>
  <para style="toc3">Тун.кал</para>
  <para style="toc2">Соломонын тун. кал. ойжо-влак</para>
  <para style="toc1">Соломонын туныктен каласыме ойжо-влак</para>
  <para style="mt">СОЛОМОНЫН ТУНЫКТЕН КАЛАСЫМЕ ОЙЖО-ВЛАК</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">1 Ончылмут. 8 Уда йолташ-влак шотышто шижтарен ойлымаш. 20 Мунлылык<note caller="*" style="f"><char style="ft" closed="false">Мунлылык – мудрость.</char></note> ӱжын кычкыра.</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Давид эрге Соломонын, Израиль кугыжан, туныктен каласыме ойжо-влак.<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Тек нуно мунлылык ден туныктымашым кондат,</para>
  <para style="q1" vid="PRO 1:2">ушан ойым умылаш полшат,<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />ушан-шотан илыш ден чын ыштымашлан,</para>
  <para style="q1" vid="PRO 1:3">чын суд ден чынлыклан туныктат.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Тек ужарвуй-влаклан<note caller="*" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Ужарвуй – неопытный, наивный.</char></note> пуат умылен моштымашым,</para>
  <para style="q1" vid="PRO 1:4">самырыклан – шинчымаш ден шонен моштымашым.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Тек мунло еҥат, нуным колын, кугемда шинчымашыжым,</para>
  <para style="q1" vid="PRO 1:5">ушан еҥат мунло ой-каҥашым муэш –<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />кузе умылаш туныктен каласыме ден вес семын ойлымым,</para>
  <para style="q2" vid="PRO 1:6">мунло еҥ-влакын мутышт ден туштен ойлымыштым.<verse eid="PRO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Мунлылыкын<note caller="*" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">«Мунлылыкын» – еврей текстыште «шинчымашын».</char></note> тӱҥалтышыже – Господь деч лӱдмаш.</para>
  <para style="q1" vid="PRO 1:7">[Кӧм тудо виктарен шога, чылаштлан пуа умылымашым.</para>
  <para style="q1" vid="PRO 1:7">А Юмым шотлымаш – уш-акылын тӱҥалтышыже.]</para>
  <para style="q1" vid="PRO 1:7">Ушдымо-влак гына огыт шотло мунлылык ден туныктымашым.<verse eid="PRO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Эргым, ачатын каҥашыжым колышт,</para>
  <para style="q1" vid="PRO 1:8">аватын туныктен ойлымыжым ит шӱкал,<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />лийыт нуно вуйыштет сӧрал вуйшӱдыш,</para>
  <para style="q1" vid="PRO 1:9">шӱйыштет – мотор шӱшер.<verse eid="PRO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Эргым, сулыкан-влак тыйым савыраш тӧчат гын,</para>
  <para style="q1" vid="PRO 1:10">ит келше!<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Нуно каласат гын: «Айда мемнан дене,</para>
  <para style="q1" vid="PRO 1:11">пушташлан шылын шинчына,</para>
  <para style="q1" vid="PRO 1:11">титакдыме еҥым амал деч посна ваҥена,<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />вес тӱня семын нуным илышынек,</para>
  <para style="q2" vid="PRO 1:12">шӱгарыш волышым нелме семын тичмашнек нелына.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Поген налына шергакан тӱрлӧ арверым,</para>
  <para style="q1" vid="PRO 1:13">поянлык дене пӧртнам темена.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Кышкаш тӱҥалат шеревам мемнан дене,</para>
  <para style="q1" vid="PRO 1:14">чылаланна лиеш ик оксагалта», –<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />ит кай нунын дене, эргым,</para>
  <para style="q1" vid="PRO 1:15">ит шогал нунын корнышкышт.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Вет нунын йолышт осалым ышташ куржыт,</para>
  <para style="q1" vid="PRO 1:16">вӱрым йоктараш вашкат.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Кайык-влакын шинчашт ончылно шындыме лӧдӧ деч шот огеш лий,<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />а нине еҥ-влак шылын шинчыт шке вӱрыштым йоктараш,</para>
  <para style="q1" vid="PRO 1:18">ваҥен шинчат шкеныштым пытараш!<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Тыге лиеш осал паша дене шкаланже погым погышо еҥ дене:</para>
  <para style="q1" vid="PRO 1:19">тиде пого тудын илышыжым пытара.<verse eid="PRO 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Мунлылык кычкыра уремлаште,</para>
  <para style="q1" vid="PRO 1:20">еҥ погынымо верлаште шке йӱкшым кугемда,<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />ӱжын кычкыра лӱшкышӧ калык коклаште,</para>
  <para style="q1" vid="PRO 1:21">ола капкаш пурымаште шке мутшым ойла:<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />«Ушдымо-влак, кунар эше те ушдымылыкым йӧраташ тӱҥалыда?</para>
  <para style="q1" vid="PRO 1:22">Мыскылыше-влак шке мыскылымышт дене кунар эше келанаш<note caller="*" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">Келанаш – наслаждаться.</char></note> тӱҥалыт,</para>
  <para style="q1" vid="PRO 1:22">а ушдымо-влак шинчымашым ужмышудымо лийыт?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Савырныза мыйын шылталыме мутем дек:</para>
  <para style="q1" vid="PRO 1:23">мый ӱмбакыда мунлылык шӱлышем опталам,</para>
  <para style="q1" vid="PRO 1:23">тыланда шомакем увертарем.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Мый ӱжынам – те колыштын огыдал,</para>
  <para style="q1" vid="PRO 1:24">кидем шуенам – нигӧ тидым шотыш налын огыл.<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Чыла ой-каҥашем те шӱкалында,</para>
  <para style="q1" vid="PRO 1:25">шылталыме мутем кӱлдымыш луктында.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Сандене мыят воштылам,</para>
  <para style="q1" vid="PRO 1:26">кунам тендан деке туткар толеш,</para>
  <para style="q1" vid="PRO 1:26">койдарем, кунам тендам шучкылык авалта!<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />Тӱтан семын ӱмбакыда шучкылык толеш,</para>
  <para style="q1" vid="PRO 1:27">пӧрдшымардеж семын азап авалта,</para>
  <para style="q1" vid="PRO 1:27">ойго ден орлык тендам темдалыт.<verse eid="PRO 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />Тунам мыйым ӱжын кычкырат, но ом вашеште,</para>
  <para style="q1" vid="PRO 1:28">чыла вере кычалыт, но огыт му.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Вет нуно шинчымашым ужмышудымо лийыныт,</para>
  <para style="q1" vid="PRO 1:29">ойырен налын огытыл Господь деч лӱдмашым,<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />ой-каҥашем шӱкалыныт,</para>
  <para style="q1" vid="PRO 1:30">кӱлдымыш луктыныт шылталыме мутем.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Сандене нуно шке паша саскаштым кочкыт,</para>
  <para style="q1" vid="PRO 1:31">осал шонымашышт деч темыт.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Вет шотдымо-влакым ӱскырт улмышт кошарта,</para>
  <para style="q1" vid="PRO 1:32">ушдымо-шамычым шоныде илымышт пытара.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />А кӧ мыйым колыштеш – лӱдыкшым палыде ила,</para>
  <para style="q1" vid="PRO 1:33">осал дечын тудо огеш лӱд».<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="cl">2 ГЛАВА</para>
  <para style="cd">Мунлылыкын кӱлешлыкше.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Эргым, мыйын мутем шотыш налат</para>
  <para style="q2" vid="PRO 2:1">да кӱштымем шӱмышкет пыштет гын,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />шке пылышетым мунлылык дек савырет</para>
  <para style="q2" vid="PRO 2:2">да шӱметым умылен моштымашлан почат гын,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />шинчымашым ӱжаш да умылымаш деке кугу йӱкын кычкыраш,<verse eid="PRO 2:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 2:4" />тудым ший семын муаш тыршаш,</para>
  <para style="q2" vid="PRO 2:4">шылтыме поянлык семын кычалаш тӱҥалат гын,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />мо тыгай Господь деч лӱдмаш – умылет,</para>
  <para style="q1" vid="PRO 2:5">Юмым палымашым муат.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Вет Господь мунлылыкым пуа,</para>
  <para style="q1" vid="PRO 2:6">Тудын умшаж гыч лектыт шинчымаш ден умылымаш.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Чын ыштыше-влаклан Тудо ямдылен сеҥымашым,</para>
  <para style="q1" vid="PRO 2:7">титакыш пурыде илыше-влаклан Тудо – аралтыш.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Чынлыкын корныжым Господь арала,</para>
  <para style="q1" vid="PRO 2:8">Тудлан ӱшанле-влакын йолгорныштым сакла.<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Тунам тый пален налат –</para>
  <para style="q1" vid="PRO 2:9">мо тыгай чын ыштымаш да чынлык, тура да чын корно.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Шӱмышкет мунлылык пура,</para>
  <para style="q1" vid="PRO 2:10">чонетлан шинчымаш куаным конда.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Шонен моштымаш тыйым аралаш тӱҥалеш,</para>
  <para style="q1" vid="PRO 2:11">умылен моштымаш тыйым сакла.<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Утарен кодат нуно тыйым осал корно дечын,</para>
  <para style="q1" vid="PRO 2:12">ондален ойлышо еҥ-влак дечын –<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />нунышт тура корным коденыт,</para>
  <para style="q1" vid="PRO 2:13">пычкемыш корным ойыреныт,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />осал пашаштлан йывыртат,</para>
  <para style="q1" vid="PRO 2:14">чыла тӱрлӧ пужлымашлан куанат.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Нунын корнышт кадыр,</para>
  <para style="q1" vid="PRO 2:15">тушто нуно йомын коштыт.<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Тыге тый аралалт кодат еҥ вате деч,</para>
  <para style="q1" vid="PRO 2:16">ӱедылше шомакым ойлышо вес ӱдырамаш деч –<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />самырык годсо пелашыжым тудо кудалтен каен,</para>
  <para style="q1" vid="PRO 2:17">Юмыж ончылно ыштыме ойпидышым монден.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Тудын пӧртшӧ – колымаш капка,</para>
  <para style="q1" vid="PRO 2:18">вес тӱнясе пычкемышыш корныжо наҥгая.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Кӧ тудын дек пура, нигӧ огеш лек,</para>
  <para style="q1" vid="PRO 2:19">илыш корныш тетла ок шогал.<verse eid="PRO 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Сандене кошт сай еҥ-влакын корнышт дене,</para>
  <para style="q1" vid="PRO 2:20">чын ыштыше-влакын йолгорнышт гыч ит кораҥ,<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />вет чын ыштыше-шамыч илаш тӱҥалыт мландымбалне,</para>
  <para style="q1" vid="PRO 2:21">ару шӱм-чонан-влак кодыт тушан.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />А осалым ыштыше-шамыч лийыт мландымбач пытарыме,</para>
  <para style="q1" vid="PRO 2:22">ӱшанле огыл-влак – тушеч ӱштыл шуымо.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="cl">3 ГЛАВА</para>
  <para style="cd">1 Юмым колыштын, шот дене иле. 13 Чын пиал.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Эргым, мыйын туныктымем ит мондо,</para>
  <para style="q1" vid="PRO 3:1">тек шӱмет кӱштымаш-влакем шарна:<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />нуно илышаш ий ден кечым ешарат,</para>
  <para style="q1" vid="PRO 3:2">тылат тыныслыкым кондат.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Коден ынышт кай тыйым порылык ден чынлык –</para>
  <para style="q1" vid="PRO 3:3">сакалте нуным шӱйышкет,</para>
  <para style="q1" vid="PRO 3:3">возен шынде шӱмышкет,<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />тунам тый Юмын да еҥ-влакын шинчаштышт</para>
  <para style="q2" vid="PRO 3:4">поро кумыл ден аклымашым сулет.<verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Уло шӱмет дене Господьлан инане,</para>
  <para style="q1" vid="PRO 3:5">шке ушетлан ит ӱшане.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Коштмо чыла корныштет Тудым пален шого,</para>
  <para style="q1" vid="PRO 3:6">тунам Тудо тыйым чын корно дене наҥгая.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Ит шотло шкендым мунло еҥлан,</para>
  <para style="q1" vid="PRO 3:7">Господь деч лӱд, осал деч кошт кораҥын –<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />тиде капетлан тазалыкым конда,</para>
  <para style="q1" vid="PRO 3:8">чыла луэтым пеҥгыдемда.<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Господьым шотлен, пуэн шого Тудлан мо улет гыч,</para>
  <para style="q1" vid="PRO 3:9">чыла лектышетын икымше саскаж гыч –<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />тунам клат-влакет тич темыме лийыт,</para>
  <para style="q1" vid="PRO 3:10">виноградым темдыме верет<note caller="*" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Темдыме вер – давильня.</char></note> саска вӱд дене темеш.<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Эргым, Господьын тӧрлымыжым кӱлдымыш ит лук,</para>
  <para style="q1" vid="PRO 3:11">Тудын шылталымыж деч тупынь ит савырне.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Вет кузе ача шке эргыжым мут кучаш шогалта,</para>
  <para style="q1" vid="PRO 3:12">тугак Господь, кӧм йӧрата, тудым наказатла.<verse eid="PRO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Пиалан тудо еҥ, кӧ мунлылыкым кычал муын,</para>
  <para style="q1" vid="PRO 3:13">кӧ пален налын уш-акылым.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Вет мунлылык ший деч сайрак,</para>
  <para style="q1" vid="PRO 3:14">тудын деч пайда шӧртньӧ деч кугурак,<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />тудо шергакан кӱ деч шергырак.</para>
  <para style="q1" vid="PRO 3:15">[Нимогай осал тудын ваштареш шоген ок керт,</para>
  <para style="q1" vid="PRO 3:15">тудын дек чак лийше-влаклан мунлылык сайын палыме.]</para>
  <para style="q1" vid="PRO 3:15">Налаш шонымет гыч нимом тудын дене от таҥастаре.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Кужу ӱмыр – тудын пурла кидыштыже,</para>
  <para style="q1" vid="PRO 3:16">а шолаштыже – поянлык ден чап,</para>
  <para style="q1" vid="PRO 3:16">[тудын умшаж гыч лектеш чынлык,</para>
  <para style="q1" vid="PRO 3:16">йылмыштыже – закон ден порылык].<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Тудын корныжо-влак сӧрал,</para>
  <para style="q1" vid="PRO 3:17">чыла йолгорныжо лӱдыкшӧ деч посна улыт.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Мунлылыкым пеҥгыдын кучышылан тудо илыш пушеҥге лиеш,</para>
  <para style="q1" vid="PRO 3:18">да пиалан улыт нуно, кӧмыт тудым огыт колто!<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Мунлылык дене Господь мландым негызлен,</para>
  <para style="q1" vid="PRO 3:19">уш-акыл дене кавам пеҥгыдемден,<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Тудын шинчымашыж дене вӱд келгыт-влак почылтыныт</para>
  <para style="q1" vid="PRO 3:20">да пыл-влак лупсым йоктарат.<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Эргым, яндар уш ден шонен моштымашым арале,</para>
  <para style="q1" vid="PRO 3:21">нуным шинча ончычет ит йомдаре –<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />нуно чонетлан илышым пуат,</para>
  <para style="q1" vid="PRO 3:22">шӱетлан лийыт сӧрастарыш.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Тунам шке корнет дене лӱдде кает,</para>
  <para style="q1" vid="PRO 3:23">да ок шӱртньӧ тыйын йолет.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Лӱдде малаш тый возат,</para>
  <para style="q1" vid="PRO 3:24">тамле омо дене малет.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />От лӱд тый вучыдымо азап деч,</para>
  <para style="q1" vid="PRO 3:25">осал-влакым пытарыше туткар деч,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />вет Господь лиеш тыйын ӱшанет,</para>
  <para style="q1" vid="PRO 3:26">Тудо арален кода оптыш деч йолет.<verse eid="PRO 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Кӧлан полыш кӱлеш, тудлан полшыде ит код,</para>
  <para style="q1" vid="PRO 3:27">кунам тыйын кидет тидым ыштен кертеш.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Вес еҥлан мом пуаш тыйын уло гын, ит ойло:</para>
  <para style="q1" vid="PRO 3:28">«Кай да угыч тол, тылат эрла пуэм».</para>
  <para style="q1" vid="PRO 3:28">[Вет мом эрласе кече конда, тый от пале.]<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Осалым ышташ ит шоно лишылъеҥетлан,</para>
  <para style="q1" vid="PRO 3:29">кудыжо тыйын воктенет лӱдде ила.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Вес еҥ тылат осалым ыштен огыл гын,</para>
  <para style="q1" vid="PRO 3:30">амал деч посна тудын дене ит ӱчаше.<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Весым темден илыше еҥлан ит кӧране,</para>
  <para style="q1" vid="PRO 3:31">тудын ик корныжымат ойырен ит нал,<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />вет осал чоя айдеме Господьлан йырнык,</para>
  <para style="q1" vid="PRO 3:32">а чын ыштыше еҥ дек Тудо лишыл лиеш.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Осал еҥын пӧртшӧ ӱмбак Господь каргымашым колта,</para>
  <para style="q1" vid="PRO 3:33">а чын ыштышын илемжым Тудо суапландара.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Мыскылен ойлышо-влакым Тудо воштылеш,</para>
  <para style="q1" vid="PRO 3:34">а ӱҥышӧ-влаклан<note caller="*" style="f"><char style="fr" closed="false">3:34 </char><char style="ft" closed="false">Ӱҥышӧ – кроткий, смиренный.</char></note> порылыкым ончыкта.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Мунло-влак чапыште лийыт,</para>
  <para style="q1" vid="PRO 3:35">а ушдымо-шамыч намысыш пурат.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="cl">4 ГЛАВА</para>
  <para style="cd">Ачан туныктымыжым колыштса.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Колыштса, йоча-влак, ачан каҥашыжым –</para>
  <para style="q1" vid="PRO 4:1">тӱткын колыштса, погыза уш-акылым.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Вет мый тыланда поро каҥашым пуэм,</para>
  <para style="q1" vid="PRO 4:2">туныктымем деч ида кораҥ.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Мыят ачамын лийынам вет эргыже,</para>
  <para style="q1" vid="PRO 4:3">авамын шыман йӧратыме ик эргыже.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Ачам, мыйым туныктен, тыге ойлен:</para>
  <para style="q1" vid="PRO 4:4">«Шӱмыштет мутем-влакым арале,</para>
  <para style="q1" vid="PRO 4:4">шуктен шого сугынем – тунам илаш тӱҥалат.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Кычал му тый мунлылыкым, уш-акылым пого:</para>
  <para style="q1" vid="PRO 4:5">ит мондо нине шомакем, нунын дечын ит кораҥ.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Коден ит кай мунлылыкым – тудо тыйым арала,</para>
  <para style="q1" vid="PRO 4:6">йӧрате тудым – тудо тыйым перега.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Эн тӱҥ – тиде мунлылык,</para>
  <para style="q1" vid="PRO 4:7">сандене тудым кычал му,</para>
  <para style="q1" vid="PRO 4:7">чыла деч чот уш-акылым пого.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Кугун акле мунлылыкым – тудо тыйым кӱш нӧлталеш,</para>
  <para style="q1" vid="PRO 4:8">ӧндал кучет гын тудым, чапыште лият.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Тудо вуйышкет сӧрал вуйшӱдышым пышта,</para>
  <para style="q1" vid="PRO 4:9">чапле вуйпидышым тылат конда».<verse eid="PRO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Колышт, эргым, да шотыш нал мутемым –</para>
  <para style="q1" vid="PRO 4:10">илышаш кечет-влак ешаралтыт тунам.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Тылат мый мунлылык корным ончыктем,</para>
  <para style="q1" vid="PRO 4:11">чын йолгорно дене тыйым наҥгаем.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Кунам кает, ок лий корныштет чарак,</para>
  <para style="q1" vid="PRO 4:12">куржат гынат, от шӱртньӧ.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Пеҥгыдын кучо тиде туныктымашым,</para>
  <para style="q1" vid="PRO 4:13">тудын деч ит кораҥ, чот арале,</para>
  <para style="q1" vid="PRO 4:13">вет тудо – тыйын илышет.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Ит шогал йӧрдымӧ-влакын йолгорнышкышт,</para>
  <para style="q1" vid="PRO 4:14">осал-шамычын корныштым ит тошко –<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />кай тушеч, тудын дене ит кошт,</para>
  <para style="q1" vid="PRO 4:15">кораҥ тушеч, эртен кай воктечын.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Нуно осалым огыт ыште гын, мален огыт колто,</para>
  <para style="q1" vid="PRO 4:16">нигӧм огыт шӱртньыктӧ гын, омышт йомеш.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Осал паша – теве нунын киндышт,</para>
  <para style="q1" vid="PRO 4:17">весым темден илымаш – йошкар аракашт.<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Чын ыштыше-влакын корнышт – ӱжаран волгыдыж гай,</para>
  <para style="q1" vid="PRO 4:18">кечывал жаплан тудо эшеат волгыдемеш.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />А осал-влакын корнышт – тӱп пычкемыш:</para>
  <para style="q1" vid="PRO 4:19">огыт пале, кушан нуно шӱртнят.<verse eid="PRO 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Эргым, мутем-влакым тӱткын колышт,</para>
  <para style="q1" vid="PRO 4:20">мом ойлымем дек пылышетым савыре.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Шинча ончычет нуным ит йомдаре,</para>
  <para style="q1" vid="PRO 4:21">кажныжым шӱмыштет арале,<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />вет нуным мушо еҥлан нуно илыш улыт,</para>
  <para style="q1" vid="PRO 4:22">тазалыкым кондат уло капшылан.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Эн чот шке шӱметым арале,</para>
  <para style="q1" vid="PRO 4:23">вет тудо илышетым виктарен шога.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Умшат гыч шояк мутым кораҥде,</para>
  <para style="q1" vid="PRO 4:24">йылметым ондалымаш дечын кучо.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Шинчат онча тек туран,</para>
  <para style="q1" vid="PRO 4:25">ончалтышет виктаралтше ончыко.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Могай корно дене каяш – сайын шоналте,</para>
  <para style="q1" vid="PRO 4:26">тек йолет тура корно дене ошкылеш.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Ит кораҥ тушеч пурлашкат, шолашкат,</para>
  <para style="q1" vid="PRO 4:27">осал корно дечын кошт кораҥын.<verse eid="PRO 4:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 4:28" />[Вет чын корным Господь эскера,</para>
  <para style="q1" vid="PRO 4:28">а шолагай корно-влак улыт пужлышо.<verse eid="PRO 4:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 4:29" />Йолгорнетым Тудо турам ышта,</para>
  <para style="q1" vid="PRO 4:29">корнетым тыныслыкыш виктара.]<verse eid="PRO 4:29" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="cl">5 ГЛАВА</para>
  <para style="cd">Еҥ вате дене коштмо деч шекландарымаш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Эргым, тӱткын колышт мунло шомакем,</para>
  <para style="q1" vid="PRO 5:1">пылышетым уш-акылем дек савыре –<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />тунам шонен моштымаш пеленет лиеш,</para>
  <para style="q1" vid="PRO 5:2">ойлымо шомакыштет шинчымаш лиеш.</para>
  <para style="q1" vid="PRO 5:2">[Ит колышт шотдымо ӱдырамашым,]<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />вет еҥ ватын умшаж гыч мӱй чыпча,</para>
  <para style="q1" vid="PRO 5:3">ӱй деч пушкыдо тудын шомакше,<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />но мучашлан тудо арымшудо гай кочо,</para>
  <para style="q1" vid="PRO 5:4">кок могырымат пӱсемдыме керде гай лиеш.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Йолжо тудын колымашыш вола,</para>
  <para style="q1" vid="PRO 5:5">ошкылжо вес тӱняшке виктаралтын.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Илыш корно нерген огешат шоналте,</para>
  <para style="q1" vid="PRO 5:6">тудо йомын коштеш да тидым ок пале.<verse eid="PRO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Тыгеракын, икшывем-влак, мыйым колыштса,</para>
  <para style="q1" vid="PRO 5:7">мыйын шомакем деч ида кораҥ.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Эргым, тыгай ӱдырамаш деч лий тораште,</para>
  <para style="q1" vid="PRO 5:8">тудын пӧрт омсаж деке ит лишем,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />уке гын весе-влаклан шке виетым пытарет,</para>
  <para style="q1" vid="PRO 5:9">орландарыше еҥлан ий-влакетым пуэт,<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />погетым йот еҥ-влак кучылтыт,</para>
  <para style="q1" vid="PRO 5:10">тыйын чыла ыштымет вес пӧртлан лиеш.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Кунам капет лунчырга да кошка,</para>
  <para style="q1" vid="PRO 5:11">тунам, ӱмырет эртымеке, тый кечкыж <verse eid="PRO 5:11" /><verse number="12" style="v" sid="PRO 5:12" />каласет:</para>
  <para style="q1" vid="PRO 5:12">«Молан туныктымаш дек лийынам ужмышудымо,</para>
  <para style="q1" vid="PRO 5:12">шылталыме мутым шӱмем кӱлдымыш луктын?<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Молан колыштын омыл туныктышо-влакым,</para>
  <para style="q1" vid="PRO 5:13">илыш корныш лукшо-влаклан пылышем почын омыл?<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Уло калык шинча ончылно</para>
  <para style="q2" vid="PRO 5:14">изиш гына мый ойгыш шым логал!»<verse eid="PRO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Йӱ вӱдым шке памашет гыч,</para>
  <para style="q1" vid="PRO 5:15">шке тавет гыч лекше вӱдым йӱ.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Молан йогаш пуэт памаш вӱдетлан уремлаште,</para>
  <para style="q1" vid="PRO 5:16">вӱдйогынетлан – шке суртет дечын тӱжвалне?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Тек лийыт нуно тыйын веле,</para>
  <para style="q1" vid="PRO 5:17">весе-влак дене нуным ит пайле.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Тек тыйын памашет лиеш суапландарыме,</para>
  <para style="q1" vid="PRO 5:18">да самырык годым налме ватетлан куане.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Тудо – йӧратыме пӱчет, чатката ирказат,</para>
  <para style="q1" vid="PRO 5:19">тек оҥпогыжо тыйым эмрата ӱмыр мучко,</para>
  <para style="q1" vid="PRO 5:19">йӧратымашыж дене эре ракатлане.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Молан тылат, эргым, вес вате дек шӱмаҥаш,</para>
  <para style="q1" vid="PRO 5:20">тудын чызыжым ӧндалкалаш?<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Вет айдемын корныжо – Господь шинча ончылно,</para>
  <para style="q1" vid="PRO 5:21">Тудо кажнын йолгорныжым шымла.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Осал еҥым сулыкшо оптышыш наҥгая,</para>
  <para style="q1" vid="PRO 5:22">сулык кепшыл тудым пеҥгыдын куча:<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />туныктымашым шотыш налдеак, тудо кола,</para>
  <para style="q1" vid="PRO 5:23">кугу ушдымылыкшылан кӧра йомеш.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="cl">6 ГЛАВА</para>
  <para style="cd">Ушдымо паша деч шекландарымаш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Эргым, тый лишылъеҥетын парымже верч мутым кучаш сӧренат,</para>
  <para style="q2" vid="PRO 6:1">вес еҥын парымжым шке ӱмбакет налынат гын,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />тугеже шомакет дене оптышыш логалынат,</para>
  <para style="q1" vid="PRO 6:2">умшат гыч лекше мутет дене кучымо лийынат.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Теве мом тунам ыште, эргым, да шкендым утаре –</para>
  <para style="q1" vid="PRO 6:3">вет тый лишылъеҥетын кидышкыже логалынат:</para>
  <para style="q1" vid="PRO 6:3">кай, ончылныжо кумык возын, тудым сӧрвале.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Покто омым шке дечет,</para>
  <para style="q1" vid="PRO 6:4">шинчатлан ит пу петырнаш,<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />утаре шкендым,</para>
  <para style="q1" vid="PRO 6:5">кузе пӱчӧ сонарзын кидше гыч утла,</para>
  <para style="q1" vid="PRO 6:5">кузе кайык тудым кучышо деч мучыштен кая.<verse eid="PRO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Йолагай, кай кутко деке,</para>
  <para style="q1" vid="PRO 6:6">ончал тудын пашажым да мунло лий.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Уке тудын вуйлатышыже,</para>
  <para style="q2" vid="PRO 6:7">тӧра ден кугыжаже,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />но тудо кеҥежым ямдыла шке киндыжым,</para>
  <para style="q1" vid="PRO 6:8">тӱредме годым шкаланже кочкышым пога.</para>
  <para style="q1" vid="PRO 6:8">[Але кай мӱкш дек да пален нал:</para>
  <para style="q1" vid="PRO 6:8">могай тудо пашаче, могай кӱлешан пашам ышта.</para>
  <para style="q1" vid="PRO 6:8">Таза лияш манын, тудын погымо мӱйжым</para>
  <para style="q2" vid="PRO 6:8">кугыжа-влакат, тыглай еҥат кочкыт.</para>
  <para style="q1" vid="PRO 6:8">Чылан тудым йӧратат да жаплат,</para>
  <para style="q1" vid="PRO 6:8">кеч вийже шагал, но мунло улмыжлан чылан пагалат.]<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Мыняр жап эше, йолагай, тый кияш тӱҥалат?</para>
  <para style="q1" vid="PRO 6:9">Кунам тый мален кынелат?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Эше изишак малет, изиш нералтет,</para>
  <para style="q1" vid="PRO 6:10">кидетым кыргештен,<note caller="*" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">Кидым кыргешташ – сложить руки крест-накрест.</char></note> изиш киялтет –<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />аген коштшо семын тый декет нужналык толеш,</para>
  <para style="q1" vid="PRO 6:11">толышо еҥ семын йорлылык поктен шуэш.</para>
  <para style="q1" vid="PRO 6:11">[Тый його от лий гын,</para>
  <para style="q1" vid="PRO 6:11">лектышет памаш семын йоген толеш,</para>
  <para style="q1" vid="PRO 6:11">нужналык тый дечет умбаке куржеш.]<verse eid="PRO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Йӧрдымӧ еҥ, осал айдеме</para>
  <para style="q2" vid="PRO 6:12">чыла вере шояк мутым ойлыштеш,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />пӱялеш шинчажым, весын йолжым тошкалеш</para>
  <para style="q1" vid="PRO 6:13">але шолып ончыкта парняж дене.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Шӱмыштыжӧ тудын чоялык,</para>
  <para style="q1" vid="PRO 6:14">эре шонен коштеш осалым,</para>
  <para style="q1" vid="PRO 6:14">ӱда тудо келшыдымашым.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Садлан тудын дек туткар кенета толеш</para>
  <para style="q1" vid="PRO 6:15">да вучыдымын тудо пытарыме лиеш,</para>
  <para style="q1" vid="PRO 6:15">паремдымашым ок уж.<verse eid="PRO 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Нине кудыт дек Господь ужмышудымо,</para>
  <para style="q1" vid="PRO 6:16">эсогыл шымыт Тудлан улыт йырнык:<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />кугешныше шинча, шояк йылме,</para>
  <para style="q1" vid="PRO 6:17">титакдыме вӱрым йоктарыше кид,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />осалым ышташ шонышо шӱм,</para>
  <para style="q1" vid="PRO 6:18">осал-чоя пашашке писын куржшо йол,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />шояк таныклыше, кудо ондален ойлыштеш</para>
  <para style="q1" vid="PRO 6:19">да иза-шольо коклаште келшыдымашым шочыкта.<verse eid="PRO 6:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Эргым! Ачатын кӱштымыжым ушыштет тый кучо,</para>
  <para style="q1" vid="PRO 6:20">аватын туныктен ойлымыж деч ит кораҥ.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Нумал нуным эре шӱмыштет,</para>
  <para style="q1" vid="PRO 6:21">сакалте нуным шӱйышкет.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Кунам кает, нуно тыйым вӱден наҥгаят,</para>
  <para style="q1" vid="PRO 6:22">малаш возат – оролаш тӱҥалыт,</para>
  <para style="q1" vid="PRO 6:22">кынелат – тыйым туныктат.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Вет нине кӱштымаш-влак улыт чӱктымӧ лампе,</para>
  <para style="q1" vid="PRO 6:23">каҥаш-влак улыт тылат волгыдо,</para>
  <para style="q1" vid="PRO 6:23">а туныктен ойлымо шылталымаш – илыш корно.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Нуно тыйым осал ӱдырамаш деч,</para>
  <para style="q2" vid="PRO 6:24">пыльген кутырышо еҥ вате деч арален кодат.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Ит алгаштаралт тудын моторлыкшо дене,</para>
  <para style="q1" vid="PRO 6:25">[тудым ончен, ит логал вапшышкыже,]</para>
  <para style="q1" vid="PRO 6:25">ончалтышыже тыйым ынже сымыстаре.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Вет яжар ӱдырамашын акше – изи ӱяча,</para>
  <para style="q1" vid="PRO 6:26">а еҥ ватылан кӧра илышет йомдарет.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Кертеш мо иктаж-кӧ тулым помышыш шылтен</para>
  <para style="q1" vid="PRO 6:27">да вургемжым йӱлалтыде коден?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Кертеш мо иктаж-кӧ йӱлышӧ тулшолышто коштын,</para>
  <para style="q1" vid="PRO 6:28">йӱлалтыде шке йолжым?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Тыгак лиеш тудын дене, кӧ лишылъеҥжын ватыж дене коштеш:</para>
  <para style="q1" vid="PRO 6:29">кӧ тудын дек тӱкна, мут кучыде огеш код.<verse eid="PRO 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Чотшак огыт шыдешке ворлан,</para>
  <para style="q1" vid="PRO 6:30">кунам тудо шужышо мӱшкыржым темаш шолыштеш;<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />но, кучымо лиймекше,</para>
  <para style="q1" vid="PRO 6:31">тудо шым пачаш шукырак тӱла, уло погыжым пуа.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Но кӧ еҥ вате дене яжарлана, тудын ушыжо уке –</para>
  <para style="q1" vid="PRO 6:32">тыге ыштыше шкенжым шке пытара.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Тудым кыралтмаш да вожылмаш вучат,</para>
  <para style="q1" vid="PRO 6:33">нигунам ок мондалт тудын намысше.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Вет марийын ушкалымашыже кугу шыдым ылыжта,</para>
  <para style="q1" vid="PRO 6:34">ӱчым шуктымо кечын тудо чаманаш ок тӱҥал –<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />нимогай сулен налме акым тудо ок нал,</para>
  <para style="q1" vid="PRO 6:35">ок серлаге, пӧлекым шукемдет гынат.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="cl">7 ГЛАВА</para>
  <para style="cd">Яжар ӱдырамаш шотышто шекландарымаш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Эргым, шарне мут-влакем,</para>
  <para style="q1" vid="PRO 7:1">кӱштымем шӱмыштет арале.</para>
  <para style="q1" vid="PRO 7:1">[Эргым, шотлен иле Господьым –</para>
  <para style="q1" vid="PRO 7:1">тунам тый пеҥгыде лият.</para>
  <para style="q1" vid="PRO 7:1">Тудын деч гына лӱдын иле!]<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Шуктен шого кӱштымем – тунам тый илаш тӱҥалат.</para>
  <para style="q1" vid="PRO 7:2">Мыйын туныктымем шинчасорта семын арале,<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />кылде нуным парняшкет,</para>
  <para style="q1" vid="PRO 7:3">возен шынде шӱмышкет.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Каласе мунлылыклан: «Улат тый акам!»,</para>
  <para style="q1" vid="PRO 7:4">уш-акылым «мыйын родем» манын ойло.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Тунам нуно тыйым арален кодат еҥ вате деч,</para>
  <para style="q1" vid="PRO 7:5">ӱедылше шомакан вес ӱдырамаш деч.<verse eid="PRO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Икана мый мӧҥгыштем окнасе решотка гоч онченам.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Ужынам ужарвуй-влак коклаште,</para>
  <para style="q2" vid="PRO 7:7">шекланенам самырык-влак коклаште ушдымо рвезым.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Ошкылын тудо тыгай ӱдырамашын илыме уремже дене,</para>
  <para style="q1" vid="PRO 7:8">тудын пӧртшӧ деке корныжым шуен.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Лийын тиде кече шичме деч вара,</para>
  <para style="q1" vid="PRO 7:9">рӱмбалгымеке, йӱд пычкемыш волымо годым.<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Тудын ваштарешыже лектын ӱдырамаш,</para>
  <para style="q1" vid="PRO 7:10">яжар семын чийыше, осал чоя шӱман,<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />лӱшкаш йӧратыше, ӱскырт койышан.</para>
  <para style="q1" vid="PRO 7:11">Шинчен ок керт тиде ӱдырамаш мӧҥгыштӧ –<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />уремлаште, еҥ погынымо верлаште</para>
  <para style="q2" vid="PRO 7:12">шога тудо кажне лукышто ваҥен.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Тудо рвезым руалтен кучен, шупшалын</para>
  <para style="q1" vid="PRO 7:13">да намысдыме чурий дене ойлен:<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />«Татулык надыр шылем мыйын уло,</para>
  <para style="q1" vid="PRO 7:14">таче мый мо сӧрымем шуктенам.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Сандене тыйын ваштареш лектынам –</para>
  <para style="q1" vid="PRO 7:15">кычалынам мый тыйым, ынде муынам.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Вакшыш ӱмбаке шаренам чапле леведышым,</para>
  <para style="q1" vid="PRO 7:16">Египет гыч кондымо тӱрлӧ тӱсан куэмым,<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />малыме верем смирна, алой да корице дене пушландаренам.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Пуро, эр марте шыматен модына,</para>
  <para style="q1" vid="PRO 7:18">икте-весым йӧратен, ракатым налына.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Вет мӧҥгыштӧ уке марием:</para>
  <para style="q1" vid="PRO 7:19">тора корныш тудо каен,<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />пеленже шуко шийым налын,</para>
  <para style="q1" vid="PRO 7:20">мӧҥгӧ пӧртылеш тичмаш тылзе годым».<verse eid="PRO 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Шуко ныжыл мут дене рвезым сымыстарен,</para>
  <para style="q1" vid="PRO 7:21">ӱедылше шомакше дене тудым савырен.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Тунамак каен рвезе почешыже –</para>
  <para style="q1" vid="PRO 7:22">кузе кая ӱшкыж шӱшкылмашке,</para>
  <para style="q1" vid="PRO 7:22">[пий – шинчырлымашке]</para>
  <para style="q1" vid="PRO 7:22">да пӱчӧ – лӱйымашке,<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />тунам пикш шӱта тудын мокшыжым.</para>
  <para style="q1" vid="PRO 7:23">Кайык семын чоҥешта тудо шӧргашке,</para>
  <para style="q1" vid="PRO 7:23">тушто колымаш улмым палыде.<verse eid="PRO 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Тыгеракын, икшывем-влак, мыйым колыштса,</para>
  <para style="q1" vid="PRO 7:24">мутем деке тӱткӧ лийза:<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />шӱмда ынже савырне тыгай ӱдырамашын корнышкыжо,</para>
  <para style="q1" vid="PRO 7:25">йомын ида кошт тудын йолгорныштыжо.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Вет шукым тудо сӱмырен кудалтен,</para>
  <para style="q1" vid="PRO 7:26">шагалым огыл пытарен.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Тудын пӧртшӧ – вес тӱняшке корно,</para>
  <para style="q1" vid="PRO 7:27">наҥгая тиде корно колымашын тӱняшкыже.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="cl">8 ГЛАВА</para>
  <para style="cd">1 Мунлылык еҥ-влакым колышташ ӱжеш. 12 Мунлылык шке нергенже каласкала. 22 Тудын шочмыжо. 32 Мунлылыкым колыштшо айдеме пиалан.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Мунлылык огыл мо ӱжеш?</para>
  <para style="q1" vid="PRO 8:1">Уш-акыл огыл мо шке йӱкшым кугемда?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Шога мунлылык кӱкшакалаште,</para>
  <para style="q1" vid="PRO 8:2">корно воктене, корнывожлаште,<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />ола капка воктене тудо кычкыра,</para>
  <para style="q1" vid="PRO 8:3">олаш пурымаште йӱклана:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />«Тендам мый ӱжам, еҥ-шамыч,</para>
  <para style="q1" vid="PRO 8:4">айдеме тукым дек мыйын йӱкем!<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Ужарвуй-влак, умылен мошташ тунемза,</para>
  <para style="q1" vid="PRO 8:5">ушдымо-шамыч, ушым погыза!<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Колыштса, каласем мый эн кӱлешаным,</para>
  <para style="q1" vid="PRO 8:6">умшам увертара кере шомакым.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Йылмем каласа лач чыным,</para>
  <para style="q1" vid="PRO 8:7">шоякым ойлаш – умшамлан йырнык.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Чыла мутем улыт чынле,</para>
  <para style="q1" vid="PRO 8:8">осал чоялык ден ондалчык тушто уке.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Ушан еҥлан нуно улыт раш,</para>
  <para style="q1" vid="PRO 8:9">шинчымашым налшылан куштылго нуным умылаш.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Мыйын туныктымем ший деч чот аклыза,</para>
  <para style="q1" vid="PRO 8:10">шинчымашым – яндар шӧртньӧ деч чотрак.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Вет мунлылык шергакан кӱ деч шергырак,</para>
  <para style="q1" vid="PRO 8:11">налаш шонымет гыч нимом тудын дене от таҥастаре.<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Мый, мунлылык, уш-акыл дене пырля илем,</para>
  <para style="q1" vid="PRO 8:12">шонен моштымаш ден шинчымаш улыт пеленем.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Господь деч лӱдмаш – осалым ужмышудымаш.</para>
  <para style="q1" vid="PRO 8:13">Кугешнымым, шкем кӱшкӧ шындымым,</para>
  <para style="q1" vid="PRO 8:13">осал корно ден шояк мутым ок шу ужмем.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Мый денем – ой-каҥаш ден шонен моштымаш,</para>
  <para style="q1" vid="PRO 8:14">мыйын улыт уш-акыл ден вий-куат.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Мыйын полшымо дене кугыжа-влак вуйлатат,</para>
  <para style="q1" vid="PRO 8:15">тӧра-шамыч луктыт чынле законым.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Вуйлатыше ден он-влак, мландымбалысе чын судья-влак</para>
  <para style="q2" vid="PRO 8:16">мыйын полшымо дене вуйлатен шогат.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Мыйым йӧратыше-влакым мыят йӧратем,</para>
  <para style="q1" vid="PRO 8:17">мыйым кычалше-шамыч мыйым муыт.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Мый денем улыт поянлык ден чап,</para>
  <para style="q1" vid="PRO 8:18">мучашдыме перкелык ден чынлык.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Саскам-влак улыт шӧртньӧ деч сайрак,</para>
  <para style="q1" vid="PRO 8:19">яндар шӧртньӧ деч чеслырак,</para>
  <para style="q1" vid="PRO 8:19">мый дечем пайда – яндар ший деч кугурак.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Коштам мый чын ыштымаш корно дене,</para>
  <para style="q1" vid="PRO 8:20">чынлыкын йолгорныжым тошкем.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Кӧ мыйым йӧрата, тудлан улан илышым пуэм,</para>
  <para style="q1" vid="PRO 8:21">клатше-влакым поянлык дене темем.</para>
  <para style="q1" vid="PRO 8:21">[Кажне кечын мо лийме нерген ойлымем годым</para>
  <para style="q1" vid="PRO 8:21">тӱҥалтыш гычак чыла мо лийшымат ушештараш ом мондо.]<verse eid="PRO 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />Господь мыйым тӱҥалтыште,</para>
  <para style="q2" vid="PRO 8:22">чыла пашаж деч ончыч, эн ожно ыштен.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Тӱҥалтыштак, эше тӱням негызлыме деч ончыч,</para>
  <para style="q2" vid="PRO 8:23">акрет годым мый ыштыме лийынам.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Мый шочынам, кунам эше вӱд келгыт-влак лийын огытыл,</para>
  <para style="q2" vid="PRO 8:24">вӱд дене темше памаш-шамыч лектын огытыл.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Мый шочынам, кунам курык-влак нӧлталме лийын огытыл,</para>
  <para style="q1" vid="PRO 8:25">кунам чоҥгата-шамыч эше лийын огытыл,<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />кунам Тудо эше мландымат, нурымат,</para>
  <para style="q2" vid="PRO 8:26">сандалыкын икымше пурак пырчыжымат ыштен огыл.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Кунам Тудо вераҥден кавам, мый тушто лийынам.</para>
  <para style="q1" vid="PRO 8:27">Кунам Тудо вӱд келгыт ӱмбалне каватӱрым колтен,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />кунам кӱшан пыл-влакым вераҥден,</para>
  <para style="q2" vid="PRO 8:28">келгытын вӱдшинчаже-влакым ыштен,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />да, вӱд ӧрдыжкӧ ынже лек манын,</para>
  <para style="q2" vid="PRO 8:29">теҥызлан чекым пыштен,</para>
  <para style="q1" vid="PRO 8:29">кунам мланде негызым палемден,<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />мый Тудын пелен уста чоҥышо лийынам,</para>
  <para style="q1" vid="PRO 8:30">лийынам кажне кечысе куан,</para>
  <para style="q1" vid="PRO 8:30">Тудын ончылныжо чарныде йомартланенам,<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />куаненам Тудын ыштыме мланде кумдыкшылан,</para>
  <para style="q1" vid="PRO 8:31">айдеме тукымлан йывыртенам.<verse eid="PRO 8:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />Тыгеракын, икшывем-влак, мыйым колыштса:</para>
  <para style="q1" vid="PRO 8:32">пиалан улыт нуно, кӧмыт мыйын корнем дене каят!<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Колыштса туныктымем, мунло лийза,</para>
  <para style="q1" vid="PRO 8:33">тудын деч ида кораҥ.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Пиалан тудо, кӧ мыйым колыштеш,</para>
  <para style="q1" vid="PRO 8:34">капкам воктене кажне кечын эскера,</para>
  <para style="q1" vid="PRO 8:34">омсам воктене вучен шога!<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Вет кӧ мыйым муэш – илышым муэш</para>
  <para style="q2" vid="PRO 8:35">да Господь деч суапым налеш.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />А кӧ мый дечем посна йомын коштеш,</para>
  <para style="q2" vid="PRO 8:36">шке чонжылан конда зияным:</para>
  <para style="q1" vid="PRO 8:36">мыйым ужмышудымо-влак йӧратат колымашым».<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="cl">9 ГЛАВА</para>
  <para style="cd">Мунлылык еҥ-влакым шкеж деке ӱжеш, ушдымылыкат шкеж деке савыраш тӧча.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Мунлылык шкаланже пӧртым чоҥен,</para>
  <para style="q1" vid="PRO 9:1">тудлан шым меҥгым локшинчын,<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />вольыкым шӱшкылын,</para>
  <para style="q1" vid="PRO 9:2">йошкар аракам тамлештарен, ӱстелым поген<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />да тарзе ӱдырамашыже-влакым</para>
  <para style="q2" vid="PRO 9:3">оласе кӱкшакала гыч тыге увертараш колтен:<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />«Шонен моштыдымо-влак, тышке толза!»</para>
  <para style="q1" vid="PRO 9:4">Ушдымо-шамычлан каласен:<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />«Толза, мыйын киндем кочса,</para>
  <para style="q1" vid="PRO 9:5">тамлештарыме йошкар аракам йӱза.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Кодыза ушдымылыкдам – илаш тӱҥалыда,</para>
  <para style="q1" vid="PRO 9:6">уш-акылын корныж дене коштса».<verse eid="PRO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Намысдыме еҥым вурсет – шкеак лият шӱктарыме,</para>
  <para style="q1" vid="PRO 9:7">осал еҥым шылталет – лият мыскылыме.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Ит шылтале намысдыме еҥым,</para>
  <para style="q1" vid="PRO 9:8">уке гын тудлан ужмышудымо лият,</para>
  <para style="q1" vid="PRO 9:8">шылтале мунло еҥым –</para>
  <para style="q1" vid="PRO 9:8">тудо тыйым йӧраташ тӱҥалеш.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Пу каҥашым мунло еҥлан –</para>
  <para style="q1" vid="PRO 9:9">лиеш тудо эше мунлырак,</para>
  <para style="q1" vid="PRO 9:9">туныкто чын ыштыше еҥым –</para>
  <para style="q1" vid="PRO 9:9">лиеш тудо эше ушанрак.<verse eid="PRO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Мунлылыкын тӱҥалтышыже – Господь деч лӱдмаш,</para>
  <para style="q1" vid="PRO 9:10">Святойым пален налмаш – теве уш-акыл.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Вет мыланем кӧра илышаш кечет-влак шукемыт,</para>
  <para style="q2" vid="PRO 9:11">тыйын ий-влакет ешаралтыт.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />[Эргым,] тый мунло улат гын,</para>
  <para style="q1" vid="PRO 9:12">мунлылыкет пайдам шкаланет [да лишылъеҥет-влаклан] конда,</para>
  <para style="q1" vid="PRO 9:12">а вуянче улат гын, шкеак орланаш тӱҥалат.</para>
  <para style="q1" vid="PRO 9:12">[Кӧ шоякеш негызлалтын, тудо мардежым кӱта,</para>
  <para style="q2" vid="PRO 9:12">чоҥештылше кайык-влакым поктылеш:</para>
  <para style="q1" vid="PRO 9:12">вет тудо шке виноград аҥасе корныж гыч кораҥын</para>
  <para style="q1" vid="PRO 9:12">да пасусо йолгорнылаштыже йомын коштеш.</para>
  <para style="q1" vid="PRO 9:12">Тудо вӱддымӧ, кошкаш пӱралтше ир мланде гоч кая,</para>
  <para style="q1" vid="PRO 9:12">саскам погаш кидшым шуялта, но нуно уке улыт.]<verse eid="PRO 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Ушдымылык – тиде лӱшкышӧ, окмак,</para>
  <para style="q2" vid="PRO 9:13">нимом палыдыме ӱдырамаш.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Шинча тудо шке пӧрт омсаж воктене,</para>
  <para style="q1" vid="PRO 9:14">оласе кӱкшака верыште, пӱкеныште,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />да ӱжын кычкыра эртен кайыше-шамычым,</para>
  <para style="q1" vid="PRO 9:15">шке корнышт дене тура кайыше-влакым:<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />«Шонен моштыдымо-влак, тышке толза!»</para>
  <para style="q1" vid="PRO 9:16">Ушдымо-шамычлан ойла:<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />«Шолыштмо вӱд шере,</para>
  <para style="q1" vid="PRO 9:17">шылтыме кинде тамле».<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Ок пале саде еҥ:</para>
  <para style="q1" vid="PRO 9:18">тушто колышо-влакын чонышт улыт,</para>
  <para style="q1" vid="PRO 9:18">тиде ӱдырамашын ӱжмӧ еҥже-влак вес тӱнясе келгытыште улыт.</para>
  <para style="q1" vid="PRO 9:18">[Но тый курж тушечын, тушто ит шого,</para>
  <para style="q1" vid="PRO 9:18">ит ончо тудын ӱмбак –</para>
  <para style="q1" vid="PRO 9:18">тыге тый йот вӱдым эртен кает.</para>
  <para style="q1" vid="PRO 9:18">Кораҥ кай йот вӱд дечын,</para>
  <para style="q1" vid="PRO 9:18">весын памашыж гыч ит йӱ –</para>
  <para style="q1" vid="PRO 9:18">тунам тый кужун илет,</para>
  <para style="q1" vid="PRO 9:18">илышаш ий-влакет ешаралтыт.]<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="cl">10 ГЛАВА</para>
  <para style="cd">Соломонын тӱрлӧ нерген туныктен каласыме ойжо-влак (10:1 – 22:16).</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Соломонын туныктен каласыме ойжо-влак.</para>
  <para style="q1" vid="PRO 10:1">Мунло эрге – ачалан куан,</para>
  <para style="q1" vid="PRO 10:1">а ушдымо эрге – авалан ойго.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Пайдам ок пу шолагай поянлык,</para>
  <para style="q1" vid="PRO 10:2">а чын ыштымаш колымаш деч утара.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Чын ыштыше еҥым Господь шужышым ок кодо,</para>
  <para style="q1" vid="PRO 10:3">а осал еҥын опкын кумылжым шуктыде кода.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Йолагай кид йорлылыкым конда,</para>
  <para style="q1" vid="PRO 10:4">а тыршыше кид – поянлыкым.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Кӧ кеҥежым пога – тудо ушан,</para>
  <para style="q1" vid="PRO 10:5">а кӧ тӱредме жап годым мален кия – намысыш пура.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Чын ыштыше еҥын вуй ӱмбалныже суапландарымаш,</para>
  <para style="q1" vid="PRO 10:6">а осал-влакын шомакыштышт шылын шинча весым темдымаш.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Чын ыштыше еҥым шарнымаш суапландарымашым конда,</para>
  <para style="q1" vid="PRO 10:7">а осал еҥын лӱмжӧ йомеш.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Мунло шӱман еҥ каҥашым колыштеш,</para>
  <para style="q1" vid="PRO 10:8">а ушдымын умшаже шукта пытымашке.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Кӧ чын корно дене коштеш, тудлан лӱдыкшӧ огыл,</para>
  <para style="q1" vid="PRO 10:9">а кӧ тушеч кораҥеш – осаллыкше чараш лектеш.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Шинчам пӱялымаш ойгым конда,</para>
  <para style="q1" vid="PRO 10:10">а ушдымын умшаже пытымашке шукта.<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Чын ыштыше еҥын умшаже – илыш памаш,</para>
  <para style="q1" vid="PRO 10:11">а осал-влакын шомакыштышт шылын шинча вуянче койыш.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Ужмышудымаш келшыдымашым луктеш,</para>
  <para style="q1" vid="PRO 10:12">а йӧратымаш чыла сулыкым леведеш.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Ушан еҥын умшаштыже – мунлылык,</para>
  <para style="q1" vid="PRO 10:13">а ушдымын тупыштыжо – розго.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Мунло-влак шинчымашым погат,</para>
  <para style="q1" vid="PRO 10:14">а ушдымын умшаже пытымашке наҥгая.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Поян еҥ шке погыжым чоткыдемдыме олалан шотла,</para>
  <para style="q1" vid="PRO 10:15">а йорлым нужналык пытара.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Чын ыштыше еҥын тыршымыже илышым конда,</para>
  <para style="q1" vid="PRO 10:16">а осал еҥын парышыже сулыкыш наҥгая.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Кӧ шылталымым колыштеш – илыш корнышто шога,</para>
  <para style="q1" vid="PRO 10:17">а кӧ тудым шотыш ок нал – йомын коштеш.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Кӧ ужмышудымашым шылта, умшаштыже – шояк,</para>
  <para style="q1" vid="PRO 10:18">кӧ манеш-манешым шаркала, тудо – ушдымо.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Шуко ойлымо годым сулыкыш пурыде от код,</para>
  <para style="q1" vid="PRO 10:19">а йылмым кучен моштышо – ушан.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Чын ыштышын йылмыже – яндар ший,</para>
  <para style="q1" vid="PRO 10:20">а осал еҥын шӱмжӧ нимом ок шого.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Чын ыштыше еҥын шомакше шукым пукша,</para>
  <para style="q1" vid="PRO 10:21">а ушдымо-влак ушышт укелан кӧра пытат.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Господьын суапландарымашыже пойдара,</para>
  <para style="q2" vid="PRO 10:22">пеленже ойгым ок кондо.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Ушдымо еҥым осал пашам ыштымыже куандара,</para>
  <para style="q1" vid="PRO 10:23">а ушан еҥын куанже – мунлылык.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Мо деч осал еҥ лӱдеш, тидак тудын дене лиеш,</para>
  <para style="q1" vid="PRO 10:24">а чын ыштыше-влакын ӱшанен вучымышт шукталтеш.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Тӱтан мардеж эртен кая – осал еҥ тетла уке,</para>
  <para style="q1" vid="PRO 10:25">а чын ыштыше еҥ курымеш пеҥгыдын шога.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Кузе уксус умшалан да шикш шинчалан,</para>
  <para style="q1" vid="PRO 10:26">тугак йолагай еҥ – тудым сомыл ышташ колтышылан.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Господь деч лӱдмаш ешара илышаш кечым,</para>
  <para style="q1" vid="PRO 10:27">а осал еҥ-влакын ӱмырышт кӱчыкемеш.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Чын ыштыше-влакын вучен илымышт конда куаным,</para>
  <para style="q1" vid="PRO 10:28">а осал еҥ-шамычын ӱшанышт шукталтде кодеш.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Шылталаш амалдыме еҥлан Господьын корныжо – кӱ курык,</para>
  <para style="q1" vid="PRO 10:29">а осалым ыштышылан тудо лӱдмашым конда.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Чын ыштыше эре пеҥгыдын шога,</para>
  <para style="q1" vid="PRO 10:30">а осал-влакын ӱмырышт кӱчык лиеш.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Чын ыштышын умшаж гыч мунлылык йога,</para>
  <para style="q1" vid="PRO 10:31">а аяр йылме пӱчкын шуымо лиеш.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Чын ыштышын умшаж гыч сай лектеш,</para>
  <para style="q1" vid="PRO 10:32">а осал еҥ-влакын йылмышт гыч – аяр.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="cl">11 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Ондалыше виса – Господьлан йырнык,</para>
  <para style="q1" vid="PRO 11:1">а чын ончыктышо кир Тудлан келша.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Кушто кугешнымаш, тушко намыс толеш,</para>
  <para style="q1" vid="PRO 11:2">а ӱҥышӧ-влак дене мунлылык лиеш.</para>
  <para style="q1" vid="PRO 11:2">[Чын ыштыше еҥын колымыжлан ойгырат,</para>
  <para style="q1" vid="PRO 11:2">а осал-влакын колымышт вучыдымо да куандарыше лиеш.]<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Ару чонан-шамычым чынлыкышт виктарен шога,</para>
  <para style="q1" vid="PRO 11:3">а шыҥышыр<note caller="*" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">Шыҥышыр – ехидный, язвительный.</char></note> еҥ-влакым осал чоялыкышт пытара.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Господьын шыдыжын кечынже поянлык ок полшо,</para>
  <para style="q1" vid="PRO 11:4">а чын ыштымаш колымаш деч утара.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Шылталаш амалдыме еҥын чынлыкше</para>
  <para style="q2" vid="PRO 11:5">тудын корныжым тӧрым ышта,</para>
  <para style="q1" vid="PRO 11:5">а осал еҥым шке осаллыкше сӱмырен шуа.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Ару чонан-влакым чынлыкышт утара,</para>
  <para style="q1" vid="PRO 11:6">а шыҥышыр еҥ-влак опкын кумылыштын вапшышкыже логалыт.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Осал еҥын колымыж дене пыта тудын ӱшанже,</para>
  <para style="q1" vid="PRO 11:7">вучен илымыже арам лиеш.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Чын ыштыше еҥ азап деч утарыме лиеш,</para>
  <para style="q1" vid="PRO 11:8">олмешыже туткарыш осал айдеме логалеш.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Юмым шотлыдымо айдемын шомакше лишылъеҥжым пытара,</para>
  <para style="q1" vid="PRO 11:9">а чын ыштышым шинчымаш утара.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Кунам чын ыштыше-влак сайын илат, ола куана,</para>
  <para style="q1" vid="PRO 11:10">кунам осал еҥ-шамыч пытат, куан йӱк шокта.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Ару чонан-влак олалан суапым йодыт,</para>
  <para style="q2" vid="PRO 11:11">да тудо нӧлталтеш,</para>
  <para style="q1" vid="PRO 11:11">а осал еҥ-влакын мутышт олам шалата.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Ушдымо шке лишылъеҥжым мыскыла,</para>
  <para style="q1" vid="PRO 11:12">а ушан айдеме шып лиеш.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Шалаумша вес еҥын шолып пашажым почеш,</para>
  <para style="q1" vid="PRO 11:13">а ӱшанле айдеме уто шомакым ок лук.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Вуйлатыме деч посна калык пыта,</para>
  <para style="q1" vid="PRO 11:14">а каҥашым пуышо шуко гын, сайын ила.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Кӧ еҥын парымже верч мутым кучаш сӧра,</para>
  <para style="q2" vid="PRO 11:15">шкаланже ойгым конда,</para>
  <para style="q1" vid="PRO 11:15">а кӧ тыгай сӧрымашым пуаш ок келше,</para>
  <para style="q2" vid="PRO 11:15">аралалт кодеш.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Сай койыш-шоктышан вате [марийжылан] чап лиеш,</para>
  <para style="q1" vid="PRO 11:16">[а чыным ужмышудымо вате кугу намысым конда.</para>
  <para style="q1" vid="PRO 11:16">Йолагай марий-влак йорло лийыт],</para>
  <para style="q1" vid="PRO 11:16">а виян-шамыч поянлыкым погат.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Поро айдеме шкаланже сайым конда,</para>
  <para style="q1" vid="PRO 11:17">а весым чаманыдыме еҥ – эҥгекым.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Осал еҥын паша лектышыже южгойшо<note caller="*" style="f"><char style="fr" closed="false">11:18 </char><char style="ft" closed="false">Южгойшо – мираж, обманчивый призрак.</char></note> лиеш,</para>
  <para style="q1" vid="PRO 11:18">а чынлыкым ӱдышӧ айдеме чын суапым налеш.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Чын ыштыше еҥ илаш тӱҥалеш,</para>
  <para style="q1" vid="PRO 11:19">а осалым кычалше колымашым муэш.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Осал чоя еҥ-влак Господьлан йырнык улыт,</para>
  <para style="q1" vid="PRO 11:20">а чын корным тошкышо-влак Тудлан келшат.<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Пален шого: осал еҥ мут кучыде ок код,</para>
  <para style="q1" vid="PRO 11:21">а чын ыштышын тукымжо утарыме лиеш.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Мотор, но ушдымо ӱдырамаш</para>
  <para style="q2" vid="PRO 11:22">сӧсна нерыш пижыктыме шӧртньӧ колча дене иктак.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Чын ыштыше-влакын вучен илымышт сайым конда,</para>
  <para style="q1" vid="PRO 11:23">а осал еҥ-шамычын – шыдым.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Икте чаманыде пуа, да тудын эшеат ешаралтеш,</para>
  <para style="q1" vid="PRO 11:24">весе пеш чот чаҥга, но йорлештеш гына.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Кӧ чаманыде пуа, тудын шуко лиеш,</para>
  <para style="q1" vid="PRO 11:25">кӧ весылан вӱдым пуа – шкежат йӱктымӧ лиеш.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Кӧ шурныжым шылта, тудым каргат,</para>
  <para style="q1" vid="PRO 11:26">а кӧ ужалаш ямде, тыгай еҥым моктат.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Кӧ порым ышташ тырша – Юмын суапшым муэш,</para>
  <para style="q1" vid="PRO 11:27">а кӧ осалым кычалеш – тудыжо ӱмбакше толеш.<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Шке поянлыкшылан ӱшаныше еҥ кошка,</para>
  <para style="q1" vid="PRO 11:28">а чын ыштыше-влак тӱзланат.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Кӧ шке суртшылан эҥгекым конда,</para>
  <para style="q1" vid="PRO 11:29">тудын ужашыже лач мардеж,</para>
  <para style="q1" vid="PRO 11:29">да ушдымо еҥ мунло айдемын тарзыже лиеш.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Чын ыштыше еҥын саскаже – илыш пушеҥге,</para>
  <para style="q1" vid="PRO 11:30">да мунло айдеме шкеж деке шӱмаҥда.<verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Чын ыштыше еҥын пашажлан мландымбалнак пӧртылтымӧ лиеш гын,</para>
  <para style="q1" vid="PRO 11:31">осал да сулыкан еҥлан, мутат уке, пашаже почеш пӧртылтымӧ лиеш.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="cl">12 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Кӧ тӧрлатымым йӧрата – йӧрата шинчымашым,</para>
  <para style="q1" vid="PRO 12:1">а кӧ шылталымым чытен ок керт – ушдымо.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Поро айдеме дек Господь поро кумылан,</para>
  <para style="q1" vid="PRO 12:2">а осал чоя еҥым Тудо титаканыш луктеш.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Осал пашажлан кӧра айдемын негызше пеҥгыде огыл,</para>
  <para style="q1" vid="PRO 12:3">а чын ыштыше-влакын вожышт ок тарване.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Сай вате – шке марийжылан вуйшӱдыш,</para>
  <para style="q1" vid="PRO 12:4">а пышткойшо – тудын лулегыштыже погынышо шӱйшӧ дене иктак.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Чын ыштыше-влакын шонымашышт улыт чынле,</para>
  <para style="q1" vid="PRO 12:5">а осал еҥ-шамычын – осал чоя.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Осал еҥ-влакын мутышт вӱрым йоктараш виктаралтыт,</para>
  <para style="q1" vid="PRO 12:6">а чын ыштыше-влакын шомакышт чоным утарен кодат.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Толеш осал еҥ дек азап, да тудо йомеш,</para>
  <para style="q1" vid="PRO 12:7">а чын ыштышын тукымжо пеҥгыдын шога.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Айдемым ушыжлан моктат,</para>
  <para style="q1" vid="PRO 12:8">а пужлышо уш-акыланым огыт шотло.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Шкенжым кугуэш ужшо, но шужен шинчыше еҥ лиймешке,</para>
  <para style="q1" vid="PRO 12:9">лучо изи лӱмнеран, но шкем пукшен-йӱктышӧ айдеме лияш.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Чын ыштыше еҥ шке вольыкшо верчат тырша,</para>
  <para style="q1" vid="PRO 12:10">а осал еҥ поро лияш тӧчымыж годымат чаманыдыме.<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Кӧ шке мландыжым курал-ӱда – темше лиеш,</para>
  <para style="q1" vid="PRO 12:11">а кӧ южым чумен коштеш, тудын ушыжо уке.</para>
  <para style="q1" vid="PRO 12:11">[Кӧ шке жапшым аракам йӱын эртара,</para>
  <para style="q1" vid="PRO 12:11">тудо шке пӧртшым намысла.]<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Осал еҥ весым осаллык вапшышкыже кучынеже,</para>
  <para style="q1" vid="PRO 12:12">а чын ыштыше-влакын вожышт пеҥгыде.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Осал еҥ шке сулыкан шомакше дене кучалтеш,</para>
  <para style="q1" vid="PRO 12:13">а чын ыштыше айдеме азап дечын утла.</para>
  <para style="q1" vid="PRO 12:13">[Тыматлын ончышо еҥ дек поро кумыл лиеш,</para>
  <para style="q1" vid="PRO 12:13">а ола капкаште вашлийме еҥ молым шыгыремда.]<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Айдемын поро шомакше тудлан шуко сайым конда,</para>
  <para style="q1" vid="PRO 12:14">пашаже почеш тудлан пӧртылтымӧ лиеш.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Ушдымо еҥ шке корныжым чынлан шотла,</para>
  <para style="q1" vid="PRO 12:15">а каҥашым колыштшо – мунло айдеме.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Ушдымо еҥ шке шыдыжым тунамак ончыкта,</para>
  <para style="q1" vid="PRO 12:16">а ушан айдеме осал шомакым шотыш ок нал.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Чын еҥ каласа лач чыным,</para>
  <para style="q1" vid="PRO 12:17">а шояк таныклыше – ондалчыкым.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Шоныде ойлыштшо айдеме керде семын сусырта,</para>
  <para style="q1" vid="PRO 12:18">а мунло еҥын мутшо паремда.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Чын шомак кодеш курымешлан,</para>
  <para style="q1" vid="PRO 12:19">а шояк мут – лач ик татлан.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Осал чоя-влакын шӱмыштышт – ондалчык,</para>
  <para style="q1" vid="PRO 12:20">а тынысым кондышо-влакын – куан.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Чын ыштыше дене нимогай осал ок лий,</para>
  <para style="q1" vid="PRO 12:21">а осал-влакын илышышт неле-йӧсӧ дене темеш.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Ондалчык умша – Господьлан йырнык,</para>
  <para style="q1" vid="PRO 12:22">а шке мутшым шуктышо еҥ Тудлан келша.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Ушан ок ончыкто шке шинчымашыжым,</para>
  <para style="q1" vid="PRO 12:23">а ушдымо-влак окмак улмыштым почын ончыктат.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Тыршыше кид тӱҥалеш вуйлаташ,</para>
  <para style="q1" vid="PRO 12:24">йолагай – ӧкым пашам ышташ.<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Шӱм-чон тургыжланымаш кумылым волта,</para>
  <para style="q1" vid="PRO 12:25">а поро шомак куандара.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Чын ыштыше шке лишылъеҥжылан чын корным ончыкта,</para>
  <para style="q1" vid="PRO 12:26">а осал-влак шке корныштышт йомын коштыт.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Йолагай сонарлен кондымо шылжым ок кӱктӧ,</para>
  <para style="q1" vid="PRO 12:27">а тыршыше айдемын погыжо улан.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Чынлык корнышто – илыш,</para>
  <para style="q1" vid="PRO 12:28">уке тушто колымаш.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="cl">13 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Ушан эрге ачажын каҥашыжым колыштеш,</para>
  <para style="q1" vid="PRO 13:1">а вуянче эрге шылталымым шотыш ок нал.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Поро шомакше дене айдеме шуко сайлыкым налеш,</para>
  <para style="q1" vid="PRO 13:2">а ондален илыше еҥын чонжо весым темдаш ӱжеш.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Кӧ шке йылмыжым куча – чонжым арала,</para>
  <para style="q1" vid="PRO 13:3">а кӧ умшажым ок петыре – шкенжым кошарта.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Йолагай пеш вуча, но арам,</para>
  <para style="q1" vid="PRO 13:4">а тыршыше еҥын шонымыжо шукталтеш.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Чын ыштыше еҥ чытен ок керт шоякым,</para>
  <para style="q1" vid="PRO 13:5">а осалым ыштыше лӱмнержым шӱктара, намысыш пура.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Чын корно дене коштшым чынлык арала,</para>
  <para style="q1" vid="PRO 13:6">а осал еҥым сулык пытара.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Икте поянла кояш тӧча, а тудын ниможат уке,</para>
  <para style="q1" vid="PRO 13:7">весын поянлыкше шуко гынат, шкенжым нужналан шотла.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Поянлыкше дене айдеме шке чонжым сулен налын кертеш,</para>
  <para style="q1" vid="PRO 13:8">а йорло еҥым нигӧ ок лӱдыктӧ.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Чын ыштыше-влакын тулышт куанлын йӱла,</para>
  <para style="q1" vid="PRO 13:9">а осал-шамычын лампышт йӧра.</para>
  <para style="q1" vid="PRO 13:9">[Осал чоя-влак шке сулыкыштышт йомын коштыт,</para>
  <para style="q1" vid="PRO 13:9">а чын ыштыше-влак поро, чаманыше улыт.]<verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Шкем кӱшкӧ шындымаш ӱчашымашым шочыкта,</para>
  <para style="q1" vid="PRO 13:10">а каҥашым колыштшо еҥ – мунло.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Вашке погымо поянлык йомеш,</para>
  <para style="q1" vid="PRO 13:11">а изин-изин погымо – шукемеш.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Шукталтдыме ӱшан туржеш шӱм-чоным,</para>
  <para style="q1" vid="PRO 13:12">а шукталтше шонымаш – пуйто илыш пушеҥге.<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Кӧ туныктымым кӱлдымыш луктеш – ышта шкаланже зияным,</para>
  <para style="q1" vid="PRO 13:13">а кӧ кӱштымашым пагала – налеш суапым.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />[Осал чоя еҥым нимо сай ок вучо,</para>
  <para style="q1" vid="PRO 13:14">а ушан тарзын пашаже воранен толеш,</para>
  <para style="q1" vid="PRO 13:14">коштмо корныжат тура.]<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Мунло еҥын туныктымыжо – илыш памаш,</para>
  <para style="q1" vid="PRO 13:15">колымаш вапш деч тудо арален кода.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Шонен моштышо уш-акыл поро кумылым сула,</para>
  <para style="q1" vid="PRO 13:16">а осал чоя-влакын корнышт колымашыш наҥгая.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Ушан еҥ чылажымат шот дене ышта,</para>
  <para style="q1" vid="PRO 13:17">а ушдымо айдеме окмак улмыжым ончыкта.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Уда уверзе деч туткарым вучо,</para>
  <para style="q1" vid="PRO 13:18">а ӱшанле уверзе – паремдыше эм гай.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Кӧ кӱлдымыш луктеш каҥашым,</para>
  <para style="q1" vid="PRO 13:19">тудым йорлылык ден вожылмаш вучат,</para>
  <para style="q1" vid="PRO 13:19">а кӧ шылталымым колыштеш – чапыште лиеш.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Шукталтше шонымаш чонлан куаным конда,</para>
  <para style="q1" vid="PRO 13:20">а ушдымо еҥлан осал деч кораҥаш шучко.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Мунло-влак дене пырля коштат – шкежат мунло лият,</para>
  <para style="q1" vid="PRO 13:21">ушдымо-влак дене келшет – азапыш логалат.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Сулыкан еҥ почеш туткар коштеш,</para>
  <para style="q1" vid="PRO 13:22">а чын ыштыше суапым налеш.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Поро еҥын поянлыкше уныкажланат кодеш,</para>
  <para style="q1" vid="PRO 13:23">а сулыкан еҥын поянлыкше чын ыштышылан аралалтеш.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Йорлын пасуштыжат шурно шуко лийын кертеш,</para>
  <para style="q1" vid="PRO 13:24">но элыште чындымылык озалана гын, лектыш весылан лиеш.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Кӧ кидышкыже розгым налын огыл,</para>
  <para style="q1" vid="PRO 13:25">тудо шке эргыжым ок йӧрате,</para>
  <para style="q1" vid="PRO 13:25">а кӧ йӧрата – изинекак тудлан ушым пурта.<verse eid="PRO 13:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 13:26" />Чын ыштыше теммеш кочкеш,</para>
  <para style="q1" vid="PRO 13:26">а осал еҥ шужышо лиеш.<verse eid="PRO 13:26" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="cl">14 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Мунло вате шке суртшым ворандара,</para>
  <para style="q1" vid="PRO 14:1">а ушдымо – шке кидше дене шалата.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Кӧ тура корно дене коштеш – Господь деч лӱдеш,</para>
  <para style="q1" vid="PRO 14:2">а кӧн корныжо кадыр – Тудым ок шотло.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Ушдымо еҥын ойлымыжо – тупшылан тоя,</para>
  <para style="q1" vid="PRO 14:3">а мунло еҥын шомакше лиеш тудлан аралтыш.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Ӱшкыж-влак уке улыт гын, шерча яра шога,</para>
  <para style="q1" vid="PRO 14:4">а кушто виян ӱшкыж, тушто сай шурнылектыш.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Ӱшанле таныклыше ок ондале,</para>
  <para style="q1" vid="PRO 14:5">а шояк таныклыше шуко шоям ойлыштеш.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Намысдыме еҥ мунлылыкым кычалеш гынат, ок му,</para>
  <para style="q1" vid="PRO 14:6">а ушан еҥлан шинчымаш куштылгын пуалтеш.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Кораҥ кай ушдымо еҥ дечын,</para>
  <para style="q1" vid="PRO 14:7">вет тудын шомакше деч от нал шинчымашым.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Ушан еҥын мунлылыкшо – шке илыш-корныжым умылаш,</para>
  <para style="q1" vid="PRO 14:8">а ушдымо еҥын окмак улмыжо тудым ондала.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Ушдымо-влакым сулыкышт воштылтара,</para>
  <para style="q1" vid="PRO 14:9">а чын ыштыше-влак поро кумылым сулен налыт.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Шӱмет гына пала ойгетым,</para>
  <para style="q1" vid="PRO 14:10">куанымат от керт весе дене пайлен.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Осал еҥ-влакын пӧртышт шалана,</para>
  <para style="q1" vid="PRO 14:11">а чын ыштыше-влакын илемышт тӱзлана.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Айдеме шке корныжым чынлан шотла,</para>
  <para style="q1" vid="PRO 14:12">но мучаште тудыжо колымашке шукта.<verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Воштылмо годымат южгунам шӱм коршта,</para>
  <para style="q1" vid="PRO 14:13">куан деч варат ойго толеш.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Чын корно гыч кораҥше еҥлан пашаж почеш пӧртылтымӧ лиеш,</para>
  <para style="q1" vid="PRO 14:14">тыгак сай айдемат шке пашаж дене келшышын налеш.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Ужарвуй кажне шомаклан ӱшана,</para>
  <para style="q1" vid="PRO 14:15">а ушан шке корныжым тӱткын эскера.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Мунло еҥ осалым ыштыме деч шекланен да кораҥын коштеш,</para>
  <para style="q1" vid="PRO 14:16">а ушдымо шкаланже инана, шкенжым кучен ок мошто.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Кӧ вашке шыдешка – орадым ыштылеш,</para>
  <para style="q1" vid="PRO 14:17">кӧ осал чоя пашам ыштылеш – ужмышудымо лиеш.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Шонен моштыдымо-влакын пайышт – ушдымылык,</para>
  <para style="q1" vid="PRO 14:18">а ушан-шамычын вуйшӱдышышт шинчымаш лиеш.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Осал еҥ-влак вуйыштым поро-влак ончылно сават,</para>
  <para style="q1" vid="PRO 14:19">сулыкан-влак – чын ыштыше-шамычын капкашт ончылно.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Йорлым эсогыл пошкудыжо-влак огыт йӧрате,</para>
  <para style="q1" vid="PRO 14:20">а поян еҥын йолташыже шуко.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Кӧ лишылъеҥжым ок шотло – сулыкым ышта,</para>
  <para style="q1" vid="PRO 14:21">а кӧ йорло-влак деке поро, тудо пиалан.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Осалым ышташ шонышо-влак чын корно гыч кораҥын огытыл мо?</para>
  <para style="q1" vid="PRO 14:22">[Осалым ыштыше-шамыч поро да ӱшанле лиймым огыт пале,]</para>
  <para style="q1" vid="PRO 14:22">поро да ӱшанле лиймаш – сайым шонышо-влак дене.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Кеч-могай тыршымаш пайдам конда,</para>
  <para style="q1" vid="PRO 14:23">а яра шомакым ойлыштмаш – лач нужналыкым.<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Мунло-влакын вуйшӱдышышт – поянлык,</para>
  <para style="q1" vid="PRO 14:24">а ушдымо-шамычын – ушдымылык.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Ӱшанле таныклыше илышым утара,</para>
  <para style="q1" vid="PRO 14:25">а шояк таныклыше шуко шоям ойлыштеш.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Господь деч лӱдмаш – айдемылан ӱшанле аралтыш,</para>
  <para style="q2" vid="PRO 14:26">тудлан да эргыж-влаклан куржын утлымо вер.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Господь деч лӱдмаш – илыш памаш,</para>
  <para style="q1" vid="PRO 14:27">колымаш вапш деч тудо арален кода.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Калыкше шуко улмо годым кугыжа чапыште,</para>
  <para style="q1" vid="PRO 14:28">а калык деч посна вуйлатыше пыта.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Кӧ вашке ок шыдешке, тудын ушыжо шуко,</para>
  <para style="q1" vid="PRO 14:29">а вашке сырыше шке ушдымылыкшым ончыкта.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Тыматле шӱм-чон – капкыллан тазалык,</para>
  <para style="q1" vid="PRO 14:30">а кӧранымаш – лулегыште погынышо шӱйшӧ дене иктак.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Кӧ йорло еҥым шыгыремда – тудын Ыштышыжым мыскыла,</para>
  <para style="q1" vid="PRO 14:31">а кӧ Юмым шотла – йорло еҥлан порым ышта.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Осал еҥ-влакым осал пашашт пытара,</para>
  <para style="q1" vid="PRO 14:32">а чын ыштышын колымыж годымат аралтышыже уло.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Ушан еҥын шӱмыштыжӧ мунлылык ила,</para>
  <para style="q1" vid="PRO 14:33">ушдымо-влак коклаштат тудо шкенжым палдара.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Чын ыштымаш калыкын чапшым нӧлта,</para>
  <para style="q1" vid="PRO 14:34">а сулык тудым намысыш пурта.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Ушан тарзе дек кугыжа поро кумылан,</para>
  <para style="q1" vid="PRO 14:35">а кӧн пашаже намысле – тыгай еҥ ӱмбак шыдыже лектеш.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="cl">15 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />[Ушан-влакымат шыде пытара.]</para>
  <para style="q1" vid="PRO 15:1">Тыматле вашмут сырымашым кораҥда,</para>
  <para style="q1" vid="PRO 15:1">а торжа шомак шыде тулым ылыжта.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Мунло еҥын йылмыже сай шинчымашым пуа,</para>
  <para style="q1" vid="PRO 15:2">а ушдымын умшаж гыч орадылык тӱргалт лектеш.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Господьын шинчаже чыла вере:</para>
  <para style="q1" vid="PRO 15:3">тудо осал-влакымат, поро-влакымат ужеш.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Лыпландарыше шомак илышым конда,</para>
  <para style="q1" vid="PRO 15:4">а осал чоя мут шӱм-чоным темда.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Ушдымо йоча ачажын туныктымыжым кӱлдымыш луктеш,</para>
  <para style="q1" vid="PRO 15:5">а кӧ шылталымым колыштеш, тудо ушан.</para>
  <para style="q1" vid="PRO 15:5">[Чыным ыштымаш шукемеш гын, тиде – кугу вий,</para>
  <para style="q1" vid="PRO 15:5">а осал еҥ-влак мландымбач пытарыме лийыт.]<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Чын ыштышын пӧртыштыжӧ поянлык шуко,</para>
  <para style="q1" vid="PRO 15:6">а осал еҥын парышыже ойгым конда.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Мунло еҥын йылмыже шинчымашым шара,</para>
  <para style="q1" vid="PRO 15:7">а ушдымо-влак тыге огыт ыште.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Осал еҥын надырже – Господьлан йырнык,</para>
  <para style="q1" vid="PRO 15:8">а чын ыштышын кумалмыже Тудлан келша.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Осал еҥын корныжо – Господьлан йырнык,</para>
  <para style="q1" vid="PRO 15:9">а чын ышташ тыршышым Тудо йӧрата.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Чын корно гыч кораҥше еҥ чот наказатлыме лиеш,</para>
  <para style="q1" vid="PRO 15:10">кӧ шылталымым чытен ок керт – пыта.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Вес тӱня ден колымашат Господьлан шылтыме огытыл гын,</para>
  <para style="q1" vid="PRO 15:11">айдеме шӱм нергенже мом ойлаш!<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Намысдыме еҥ шылталымым ок йӧрате,</para>
  <para style="q1" vid="PRO 15:12">мунло-влак деке тудо ок кай.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Куаныше шӱм чурийым веселаҥда,</para>
  <para style="q1" vid="PRO 15:13">а ойгырышо – чоным темда.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Ушан айдеме кычалеш шинчымашым,</para>
  <para style="q1" vid="PRO 15:14">а ушдымо-влакым окмаклык пукша.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Нужна еҥын чыла кечыже неле,</para>
  <para style="q1" vid="PRO 15:15">а куаныше шӱмын эре пайрем.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Кугу поянлык дене тургыжланен илымешке,</para>
  <para style="q1" vid="PRO 15:16">лучо шагал поган лияш да Господь деч лӱдын илаш.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Ӧрдыктарыме ӱшкыж шылым ужмышудымаш дене кочмешке,</para>
  <para style="q1" vid="PRO 15:17">лучо пакчасаскам йӧратымаш дене кочкаш.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Вашке шыдешкыше еҥ луктеш келшыдымашым,</para>
  <para style="q1" vid="PRO 15:18">а чытышан еҥ ӱчашымашлан мучашым пышта.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Йолагайын корныштыжо иман вондер кушкын,</para>
  <para style="q1" vid="PRO 15:19">а чын ыштышын корныжо тӧр.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Ушан эрге ачажым куандара,</para>
  <para style="q1" vid="PRO 15:20">а ушдымо шке аважым ок шотло.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Ушдымылык – окмак еҥын куанже,</para>
  <para style="q1" vid="PRO 15:21">а ушан айдеме тура корно дене кая.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Шонен пыштыме паша каҥаш деч посна ок воране,</para>
  <para style="q1" vid="PRO 15:22">а каҥашым пуышо шуко гын, шукталтеш.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Кӱлеш годым вашмутым муаш – тиде куан,</para>
  <para style="q1" vid="PRO 15:23">да могай сай шке жапыштыже каласыме шомак!<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Ушан еҥ илыш корно дене кӱшкӧ кӱза,</para>
  <para style="q1" vid="PRO 15:24">ӱлнӧ улшо вес тӱня деч тудо утаралт кодеш.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Шкем кӱшкӧ шындыше-влакын пӧртыштым Господь шалата,</para>
  <para style="q1" vid="PRO 15:25">но тулык ватын межажым Тудо арален кода.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Осал шонымаш Господьлан йырнык,</para>
  <para style="q1" vid="PRO 15:26">а поро мут Тудлан келша.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Опкын еҥ шке суртышкыжо ойгым конда,</para>
  <para style="q1" vid="PRO 15:27">а кӧ взятке дек ужмышудымо – илаш тӱҥалеш.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Чын ыштыше айдеме вашмутым шонен пуа,</para>
  <para style="q1" vid="PRO 15:28">а осал еҥын умшаж гыч осаллык тӱргалт лектеш.</para>
  <para style="q1" vid="PRO 15:28">[Чын ыштыше-влакын корнышт Господьлан келша,</para>
  <para style="q1" vid="PRO 15:28">нунын гоч тушман-влакат лийыт йолташ.]<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Осал еҥ-шамыч деч Господь умбалне,</para>
  <para style="q1" vid="PRO 15:29">а чын ыштыше-влакын кумалмыштым Тудо колеш.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Волгыдо шинчаончалтыш шӱмым куандара,</para>
  <para style="q1" vid="PRO 15:30">сай увер капкыллан вийым пуа.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Кӧ ушан-шотан шылталымым колыштеш,</para>
  <para style="q1" vid="PRO 15:31">мунло еҥ-влак коклаште шинчаш тӱҥалеш.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Кӧ туныктымым шотыш ок нал – шке илышыжым ок акле,</para>
  <para style="q1" vid="PRO 15:32">а кӧ шылталымым колыштеш – уш-акылым пога.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Господь деч лӱдмаш мунло лияш туныкта,</para>
  <para style="q1" vid="PRO 15:33">а чап деч ончыч ӱҥышылык толеш.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="cl">16 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Айдеме тидым-тудым ышташ шона,</para>
  <para style="q1" vid="PRO 16:1">но пытартыш шомак – Господь дечын.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Коштмо чыла корныжым айдеме чынлан шотла,</para>
  <para style="q1" vid="PRO 16:2">но шӱм-чон шонымашым Господь терга.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Шке пашатым Господьлан ӱшане,</para>
  <para style="q1" vid="PRO 16:3">мом шонен пыштымет тунам шукталтеш.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Чылажымат Господь шке шонымыжым шукташ ыштен,</para>
  <para style="q1" vid="PRO 16:4">эсогыл осал еҥым азап кечылан ыштен.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Йырнык улыт Господь ончылно кугешныше шӱман-влак,</para>
  <para style="q1" vid="PRO 16:5">пален шого: тыгай-влак мут кучыде огыт код.</para>
  <para style="q1" vid="PRO 16:5">[Сай корнылан тӱҥалтыш – чыным ыштымаш.</para>
  <para style="q1" vid="PRO 16:5">Юмын шинча ончылныжо тиде надырым кондымаш деч сайрак.</para>
  <para style="q1" vid="PRO 16:5">Господьым кычалше еҥ шинчымаш ден чынлыкым муэш,</para>
  <para style="q1" vid="PRO 16:5">Тудым уло чон дене кычалше-влак тынысым муыт.]<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Порылык да ӱшанле лиймаш сулыкым касарат,</para>
  <para style="q1" vid="PRO 16:6">Господь деч лӱдмаш осал деч кораҥда.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Кӧн коштмо корныжо Тудлан келша,</para>
  <para style="q1" vid="PRO 16:7">Господь ты айдемын тушманжымат тудын дене сӧрасыкта.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Чын ыштен налме изи парыш</para>
  <para style="q2" vid="PRO 16:8">чын огыл ыштен налме кугу парыш деч сайрак.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Могай корно дене каяш – айдеме шке шона,</para>
  <para style="q1" vid="PRO 16:9">но тудын ошкылжым Господь виктара.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Кугыжан умшаштыже – Юмын пуымо шомакше,</para>
  <para style="q1" vid="PRO 16:10">судышто тудо чын пунчалым луктеш.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Чын виса ден пезмен Господьын улыт,</para>
  <para style="q1" vid="PRO 16:11">купеч сумкасе кир-влакат Тудын улыт.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Осал паша кугыжалан йырнык,</para>
  <para style="q1" vid="PRO 16:12">вет чын ыштыме дене престол пеҥгыдын шога.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Чынле умша кугыжалан келша,</para>
  <para style="q1" vid="PRO 16:13">чыным ойлышым тудо йӧрата.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Кугыжан шыдыже колымаш нерген увертара,</para>
  <para style="q1" vid="PRO 16:14">но мунло айдеме тудым лыпландара.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Кугыжан волгыдо чурийже илышым конда,</para>
  <para style="q1" vid="PRO 16:15">тудын поро кумылжо – пуйто шошо йӱрым кондышо пыл.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Мунлылыкым мумаш шӧртньӧ деч сайрак,</para>
  <para style="q1" vid="PRO 16:16">уш-акылым погымаш яндар ший деч шергырак.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Чын ыштыше-влакын корнышт осал деч кораҥеш,</para>
  <para style="q1" vid="PRO 16:17">кӧ шке корныжым эскера – чонжым арален кода.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Сӱмырлымӧ деч ончыч толеш кугешнымаш,</para>
  <para style="q1" vid="PRO 16:18">камвочмо деч ончыч – шкем кӱшкӧ шындымаш.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Руалтен налме погым кугешныше-влак дене пайлымешке,</para>
  <para style="q2" vid="PRO 16:19">лучо йорло-шамыч коклаште ӱҥышын илаш.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Кӧ пашам шонен виктара, тудын чылажат ворана,</para>
  <para style="q1" vid="PRO 16:20">кӧ Господьлан инанен ила, тудо пиалан.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Мунло шӱман еҥым ушан манын лӱмдат,</para>
  <para style="q1" vid="PRO 16:21">а тыматлын ойлымаш шинчымашым ешара.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Кӧн уш-акылже уло, тудлан тиде – илыш памаш,</para>
  <para style="q1" vid="PRO 16:22">а ушдымо-влакым шке окмаклыкышт чуриктара.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Мунло еҥын шӱмжӧ ышта йылмыжым ушаным</para>
  <para style="q2" vid="PRO 16:23">да умшаштыже шинчымашым шукемда.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Лыжга шомак – караш мӱй дене иктак:</para>
  <para style="q1" vid="PRO 16:24">чонлан ласка, каплан – эм.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Айдеме шке корныжым чынлан шотла,</para>
  <para style="q1" vid="PRO 16:25">но мучаште тудыжо колымашке шукта.<verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Кочмо шумаш айдемым пашам ыштыкта,</para>
  <para style="q1" vid="PRO 16:26">шужышо мӱшкыржӧ тудым покта.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Йӧрдымӧ айдеме ышташ шона осалым,</para>
  <para style="q1" vid="PRO 16:27">йылмыштыже – пуйто когартыше тул.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Осал чоя айдеме келшыдымашым ӱда,</para>
  <para style="q1" vid="PRO 16:28">манеш-манешым шаркалыше еҥ йолташ-влакым ойыра.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Вуянче еҥ лишылъеҥжым алгаштара,</para>
  <para style="q1" vid="PRO 16:29">тудым уда корныш наҥгая.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Кӧ шинчажым пӱялеш – ондалаш шона,</para>
  <para style="q1" vid="PRO 16:30">кӧ пӱйым пуреш – осалым ышта,</para>
  <para style="q1" vid="PRO 16:30">[тудо – осаллык дене темше коҥга].<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Чал ӱп – чапын вуйшӱдышыжӧ,</para>
  <para style="q1" vid="PRO 16:31">чын корно дене коштмо деч тудо лиеш.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Шуко чытышан айдеме патыр еҥ деч сайрак,</para>
  <para style="q1" vid="PRO 16:32">шкем кучен моштышо еҥ олам сеҥен налше деч сайрак.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Кудалтат шеревам вургем урвалтеш,</para>
  <para style="q1" vid="PRO 16:33">но вашмут – Господь дечын.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="cl">17 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Пайрем чесан да вурседылмашан пӧртыштӧ лиймешке,</para>
  <para style="q1" vid="PRO 17:1">кукшо кинде катышым тыныслын кочкаш сайрак.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Ушан тарзе шке озажын шотдымо эргыжым виктараш тӱҥалеш</para>
  <para style="q1" vid="PRO 17:2">да тудын иза-шольыж-влак дене пырля югыпогым налеш.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Левыктыме вер – шийлан, коҥга – шӧртньылан,</para>
  <para style="q1" vid="PRO 17:3">а шӱм-чоным Господь терга.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Осал еҥ колыштеш осал шомакым,</para>
  <para style="q1" vid="PRO 17:4">шояче – аяр йылмым.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Кӧ йорло еҥым шыгыремда, тудым ыштыше Юмым мыскыла,</para>
  <para style="q1" vid="PRO 17:5">кӧ еҥын ойгыжлан куана – мут кучыде ок код,</para>
  <para style="q1" vid="PRO 17:5">[а весым чаманыше лиеш серлагыме].<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Шоҥгыеҥ-влакын вуйшӱдышышт – нунын уныкашт,</para>
  <para style="q1" vid="PRO 17:6">йоча-влакын чапышт – ача-авашт.</para>
  <para style="q1" vid="PRO 17:6">[Ӱшанле еҥын поянлыкше шуко,</para>
  <para style="q1" vid="PRO 17:6">а кӧ ӱшанле огыл, тудын ик ыржат уке.]<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Келшен ок тол ушдымо еҥлан чапле шомак,</para>
  <para style="q2" vid="PRO 17:7">пагалыме еҥлан – шояк мут.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Айдемын пуымо взяткыже тудлан юзо кӱ гай:</para>
  <para style="q1" vid="PRO 17:8">кеч-кушко кая – тудын чылажат ворана.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Кӧ ӧпкем кудалта – кычалеш йӧратымашым,</para>
  <para style="q1" vid="PRO 17:9">но кӧ тудым шарныкта – йомдара йолташым.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Шылтален ойлымо мут ушан еҥым туныкта,</para>
  <para style="q1" vid="PRO 17:10">а ушдымылан шӱдӧ гана перымат ок полшо.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Осал еҥ кычалеш лач пудыранчыкым,</para>
  <para style="q1" vid="PRO 17:11">сандене чаманыдыме уверзе<note caller="*" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">«Уверзе»: еврей йылмысе тиде шомакым «суксо» манынат кусараш лиеш.</char></note> ваштарешыже колтымо лиеш.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Ушдымо еҥым да тудын окмаклыкшым вашлиймешке,</para>
  <para style="q2" vid="PRO 17:12">лучо игыжым йомдарыше ава маскам вашлияш.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Кӧ порылан осал дене пӧртылта,</para>
  <para style="q1" vid="PRO 17:13">осал тудын пӧртшӧ деч огеш кораҥ.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Вурседылмашын тӱҥалтышыже пӱян урылтмыж<note caller="*" style="f"><char style="fr" closed="false">17:14 </char><char style="ft" closed="false">Урылташ – прорваться.</char></note> дене иктак,</para>
  <para style="q1" vid="PRO 17:14">сандене шып лий, тек вурседылмаш умбакыже ок шарле.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Титаканым чыныш лукшо да чын ыштышым титаклыше –</para>
  <para style="q1" vid="PRO 17:15">коктынат Господьлан йырнык улыт.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Ушдымо еҥлан окса деч могай пайда?</para>
  <para style="q1" vid="PRO 17:16">Мунлылыкым налаш тудын ушыжо ок сите.</para>
  <para style="q1" vid="PRO 17:16">[Кӧ шке пӧртшым кӱкшым ышта – сӱмырлымашым кычалеш,</para>
  <para style="q1" vid="PRO 17:16">а кӧ тунемме деч кораҥеш – азапыш логалеш.]<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Йолташ чыла годымат йӧрата,</para>
  <para style="q1" vid="PRO 17:17">ойгым пайлаш иза-шольо шочын.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Лач ушдымо еҥ шке кидшым пуа</para>
  <para style="q2" vid="PRO 17:18">да лишылъеҥжын парымже верч мутым кучаш сӧра.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Вурседылаш йӧратыше айдеме сулыкым йӧрата,</para>
  <para style="q1" vid="PRO 17:19">а кӱкшӧ мотор капкам чоҥышо еҥ пытымашым кычалеш.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Осал чоя еҥ сайым ок уж,</para>
  <para style="q1" vid="PRO 17:20">шояк йылме ойгыш логалеш.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Кӧ ушдымо йочам ыштен, тудым ойго вуча,</para>
  <para style="q1" vid="PRO 17:21">окмак эргын ачаже куаным ок уж.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Весела шӱм-чон – эн сай эм,</para>
  <para style="q1" vid="PRO 17:22">а ойган чон-шӱлыш лулегым кошта.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Осал еҥ, чынле судым пужаш манын,</para>
  <para style="q1" vid="PRO 17:23">помыш гыч лукмо пӧлекым налеш.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Ушанын ончалтышыже мунлылык дек савырыме,</para>
  <para style="q1" vid="PRO 17:24">а ушдымын шинчаже мланде тӱрыштӧ йомын коштеш.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Ушдымо эрге – ачажлан ойго,</para>
  <para style="q1" vid="PRO 17:25">аважлан тудо чон орлыкым конда.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Сай огыл титакдыме еҥлан штрафым тӱлыкташ</para>
  <para style="q2" vid="PRO 17:26">але пагалыме еҥым чын улмыжлан кыраш.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Ушан-шотан еҥ шке мутшым арам ок кышке,</para>
  <para style="q1" vid="PRO 17:27">шонен моштышо айдеме шкенжым кучен мошта.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Окмак еҥат, кунам тудо шып, койын кертеш мунло еҥла,</para>
  <para style="q1" vid="PRO 17:28">кунам умшажым петыра – чучеш ушанла.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="cl">18 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Моло деч ойыралт илыше еҥ шке кумыл шупшмыжо почеш ышта,</para>
  <para style="q2" vid="PRO 18:1">ушан каҥашым кӱлдымыш луктеш.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Умылен моштымаш ушдымо еҥлан куаным ок кондо,</para>
  <para style="q1" vid="PRO 18:2">тудо шке шонымыжым веле ойлаш йӧрата.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Осал еҥ дене пырля шотлыдымаш толеш,</para>
  <para style="q1" vid="PRO 18:3">а намыс дене пырля – мыскылалтмаш.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Айдемын мутшо – келге вӱд,</para>
  <para style="q1" vid="PRO 18:4">мунлылык памаш – йоргыктышо вӱдйогын.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Сай огыл пыдал налаш осал еҥым</para>
  <para style="q2" vid="PRO 18:5">да чын ыштышым чынле суд деч посна кодаш.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Ушдымын йылмыже вурседылмашым конда,</para>
  <para style="q1" vid="PRO 18:6">шомакше кыралтмашке шукта.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Ушдымын умшаже – тудлан пытымаш,</para>
  <para style="q1" vid="PRO 18:7">йылмыже – чонжылан вапш.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />[Йолагай еҥым лӱдмаш сеҥа,</para>
  <para style="q1" vid="PRO 18:8">ӱдырамаш гай пӧръеҥ-влак шужен шинчат.]<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Манеш-манешым шаркалышын мутшо – пуйто томсык,<note caller="*" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">Томсык – деликатес.</char></note></para>
  <para style="q1" vid="PRO 18:9">мӱшкыр кӧргыш тудо куштылгын пура.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Йолагай пашазе – шалатен пытарышын шольыжо.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Господьын лӱмжӧ – чоткыдо башне:</para>
  <para style="q1" vid="PRO 18:11">чын ыштыше тушко куржын утла.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Поян еҥ шке погыжым чоткыдемдыме олалан шотла,</para>
  <para style="q1" vid="PRO 18:12">кӱкшӧ пырдыж семын тудым ужеш.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Камвочмо деч ончыч айдемын шӱмжӧ кугешнымаш дене темеш,</para>
  <para style="q1" vid="PRO 18:13">а чап деч ончыч ӱҥышылык толеш.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Колышт пытарыде вашмутым пуышо еҥ – ушдымо,</para>
  <para style="q1" vid="PRO 18:14">ончылно тудым намыс вуча.<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Чон-шӱлышыжӧ виян гын, айдеме черым сеҥа,</para>
  <para style="q1" vid="PRO 18:15">а ойгаҥше гын, кузе тудо чытен кертеш?<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Ушан еҥын шӱмжӧ пога шинчымашым,</para>
  <para style="q1" vid="PRO 18:16">мунло еҥын пылышыже тудым кычалеш.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Айдемын пуымо пӧлекше тудлан корным почеш,</para>
  <para style="q1" vid="PRO 18:17">тӧра-влак декат намиен шукта.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Кӧ судышто икымше каласкала – мутшо чынла чучеш,</para>
  <para style="q1" vid="PRO 18:18">но ваштареш шогышо еҥ толеш да тудым терга.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Шерева ӱчашымашлан мучашым пышта</para>
  <para style="q2" vid="PRO 18:19">да виян-влак коклам тӧрла.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Ӧпкелалтше иза – чоткыдемдыме ола гай,</para>
  <para style="q1" vid="PRO 18:20">а вурседылмаш – карманын капка тӱкылтышыж дене иктак.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Кутырен моштымыж дене айдеме мӱшкыржым тема,</para>
  <para style="q1" vid="PRO 18:21">умшаж гыч лекше мут дене тудо шкенжым пукша.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Илымаш ден колымаш – йылмын кидыштыже,</para>
  <para style="q1" vid="PRO 18:22">ойлаш йӧратыше-влак шке шомакышт деч саскам погат.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Кӧ [сай] ватым муын – суапым муын</para>
  <para style="q2" vid="PRO 18:23">да Господьын поро кумылжым сулен.</para>
  <para style="q1" vid="PRO 18:23">[Кӧ сай ватым поктен колта – пиалым поктен колта,</para>
  <para style="q1" vid="PRO 18:23">а кӧ яжар ӱдырамашым ашна – ушдымо да Юмым шотлыдымо.]<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Йорло еҥ сӧрвален ойла,</para>
  <para style="q1" vid="PRO 18:24">а поян торжан вашешта.<verse eid="PRO 18:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 18:25" />Улыт йолташ-влак, кудышт йолташла койыт гына,</para>
  <para style="q1" vid="PRO 18:25">но южо йолташыже иза-шольо деч лишылрак.<verse eid="PRO 18:25" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="cl">19 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />[Поян], шояк йылман да эшежым ушдымо еҥ деч</para>
  <para style="q2" vid="PRO 19:1">йорло да титакыш пурыде илыше айдеме сайрак.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Айдемылан шинчымаш деч посна сай огыл,</para>
  <para style="q1" vid="PRO 19:2">да вашкыше еҥын йолжо шӱртня.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Ушдымылык айдемын илыш корныжым локтылеш,</para>
  <para style="q1" vid="PRO 19:3">а тудо, шыдешкен, Господьлан йолам ышта.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Шуко йолташым конда поянлык,</para>
  <para style="q1" vid="PRO 19:4">а нужнам йолташыжат коден кая.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Шояк таныклыше еҥ мут кучыде ок код,</para>
  <para style="q1" vid="PRO 19:5">шоям ойлышо ок утло.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Лӱмлӧ еҥ-влак ончылно шукын ӱедылыт,</para>
  <para style="q1" vid="PRO 19:6">пӧлекым ыштыше айдемылан кажныже йолташ.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Йорло еҥ шке иза-шольыжлан ужмышудымо,</para>
  <para style="q1" vid="PRO 19:7">кораҥыт тудын деч йолташыже-влакат –</para>
  <para style="q1" vid="PRO 19:7">арам тӧча тудо нунын дене кутыраш.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Кӧ ушым пога – шке илышыжым акла,</para>
  <para style="q1" vid="PRO 19:8">кӧ уш-акылым арала – муэш суапым.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Шояк таныклыше еҥ мут кучыде ок код,</para>
  <para style="q1" vid="PRO 19:9">да кӧ шоям ойла, тудым пытымаш вуча.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Келшен ок тол ушдымылан улан илыш,</para>
  <para style="q2" vid="PRO 19:10">куллан – тӧра-влакым вуйлаташ.<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Уш-акыл айдемым шыде деч куча,</para>
  <para style="q1" vid="PRO 19:11">тудын чапше – ӧпкелалтде илымаш.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Кугыжан шыдыже – левын ырлымыж дене иктак,</para>
  <para style="q1" vid="PRO 19:12">а поро кумылжо – шудыш вочшо лупс гай.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Ушдымо эрге – ачажлан ойго,</para>
  <para style="q1" vid="PRO 19:13">ӱчашаш йӧратыше вате – пуйто чыпчен шичыше вӱд.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Пӧрт ден пого – ача-ава деч,</para>
  <para style="q1" vid="PRO 19:14">а ушан вате – Господь деч.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Йогылык конда келге омым,</para>
  <para style="q1" vid="PRO 19:15">йолагай шужен кошташ тӱҥалеш.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Кӱштымашым шуктен шогышо шке чонжым арала,</para>
  <para style="q1" vid="PRO 19:16">а кӧ коштмо корныжым ок эскере – пыта.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Кӧ йорлылан полша – Господьлан арымеш пуа,</para>
  <para style="q1" vid="PRO 19:17">да Господь тудлан пӱтынек пӧртылта.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Наказатле шке эргычым, кунам эше уло ӱшан,</para>
  <para style="q1" vid="PRO 19:18">ит пу тудын чонжылан пыташ.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Вашке шыдешкыше еҥ наказатлыме лийшаш,</para>
  <para style="q1" vid="PRO 19:19">налат гын чаманен, логалеш вара чотрак наказатлаш.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Колышт каҥашым, шотыш нал шылталымым –</para>
  <para style="q1" vid="PRO 19:20">ончыкшым лият мунлырак.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Айдемын шӱмыштыжӧ шуко шонымаш,</para>
  <para style="q1" vid="PRO 19:21">но мо Господь дечын – лач тиде шукталтеш.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Айдемын ӱшанле улмыжо кугун аклалтеш,</para>
  <para style="q1" vid="PRO 19:22">да йорло айдеме шояче деч сайрак.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Господь деч лӱдмаш илышым конда:</para>
  <para style="q1" vid="PRO 19:23">ласкан малет, осал тый декет ок лишем.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Йолагай шке кидшым кӱмыжыш чыка,</para>
  <para style="q1" vid="PRO 19:24">но умшаж дек кондаш ӧркана.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Мыскылыше еҥым наказатлет – ужарвуй-влак ушым шындат,</para>
  <para style="q1" vid="PRO 19:25">ушаным шылталет – каласыметым тудо ушышкыжо пышта.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Ачажым кырыше да аважым поктен лукшо эрге –</para>
  <para style="q2" vid="PRO 19:26">намысдыме да лӱмнержым шӱктарыше.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Эргым, чарнет гын туныктымым колышташ,</para>
  <para style="q1" vid="PRO 19:27">ушан шомак дечын посна йомат.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Йӧрдымӧ таныклыше судым шӱктара,</para>
  <para style="q1" vid="PRO 19:28">осал еҥын умшаже осал мутшо дене темеш.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Намысдыме айдемым суд вуча,</para>
  <para style="q1" vid="PRO 19:29">а ушдымын тупшым – кырымаш.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="cl">20 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Йошкар арака конда мыскылымашым, пӱрӧ – ажгынымашым,</para>
  <para style="q1" vid="PRO 20:1">кӧ нунылан вуйжым пуэн, тудо ушан огыл.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Кугыжан кугу шыдыже – левын ырлымыж дене иктак:</para>
  <para style="q1" vid="PRO 20:2">кӧ тудым сырыкта – илышыжлан лӱдыкшым конда.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Чап тудлан, кӧ вурседылмаш деч шкенжым куча,</para>
  <para style="q1" vid="PRO 20:3">а ушдымо еҥ туманлаш йӧрата.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Ок курал йолагай шке жапыштыже:</para>
  <para style="q1" vid="PRO 20:4">уржа-сорла годым кычалаш лектеш, но нимом ок му.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Айдемын шонен пыштымыже – келге вӱд,</para>
  <para style="q1" vid="PRO 20:5">но ушан еҥ тудым коштал налын кертеш.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Шукын кычкырат ӱшанле улмышт нерген,</para>
  <para style="q1" vid="PRO 20:6">но чынжымак ӱшанле айдемым кӧ муэш?<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Чын ыштыше еҥ титакыш пурыде ила,</para>
  <para style="q1" vid="PRO 20:7">пиалан улыт йочаже-влак тудын деч вара!<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Кунам кугыжа судитлаш шинчеш,</para>
  <para style="q1" vid="PRO 20:8">ончалмыж дене чыла осалым шеклана.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Кӧ каласен кертеш:</para>
  <para style="q1" vid="PRO 20:9">«Шӱмем эрныктенам, сулыкем деч ару улам»?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Чын огыл кир, ондалыше виса –</para>
  <para style="q1" vid="PRO 20:10">чыла тиде Господьлан йырнык.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Рвезым пашаж дене палаш лиеш:</para>
  <para style="q1" vid="PRO 20:11">сай мо, чын мо тудын койыш-шоктышыжо.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Колшо пылыш да ужшо шинча –</para>
  <para style="q1" vid="PRO 20:12">тидыжымат, тудыжымат Господь ыштен.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Ит йӧрате малаш – тунам от лий нужна,</para>
  <para style="q1" vid="PRO 20:13">кынел эрден эрак – тунам теммеш кочкат.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />«Уда, уда сату!» – ойла сатум налше,</para>
  <para style="q1" vid="PRO 20:14">а кораҥмекше, моктана.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Шӧртньӧ уло, шергакан кӱ шуко,</para>
  <para style="q1" vid="PRO 20:15">но ушан шомак – эн шергакан.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Кӧ палыдыме еҥын парымже верч мутым кучаш сӧрен –</para>
  <para style="q1" vid="PRO 20:16">тудын деч вургемжым нал,</para>
  <para style="q1" vid="PRO 20:16">йот еҥ верчат тудын деч залогым нал.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Ондален налме кинде тамле,</para>
  <para style="q1" vid="PRO 20:17">но тудын деч вара умша ошма дене темеш.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Каҥашымеке, ышташ шонымо паша вийым налеш,</para>
  <para style="q1" vid="PRO 20:18">сар дене кайымет годым шотыш нал каҥашым.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Кӧ манеш-манешым шаркала – вес еҥын шолып пашажым почеш,</para>
  <para style="q1" vid="PRO 20:19">тыгай шалаумша деч тый кораҥын кошт.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Кӧ шке ачажым але аважым шӱктарен ойла,</para>
  <para style="q1" vid="PRO 20:20">тудын лампыже йӱд пычкемыште йӧра.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Жап деч ончыч да вашке налме югыпого</para>
  <para style="q2" vid="PRO 20:21">варажым суапландарымашым ок кондо.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Ит ойло: «Осалым ыштымылан ӱчым шуктем!»</para>
  <para style="q1" vid="PRO 20:22">Пу тиде пашам Господьлан – Тудо тыйым арален налеш.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Йырнык улыт Господьлан чын огыл кир-влак,</para>
  <para style="q1" vid="PRO 20:23">ондалыше виса-влакат Тудлан йырынчык улыт.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Айдемын ошкылжым Господь виктарен шога,</para>
  <para style="q1" vid="PRO 20:24">шке корныжым айдеме кузе умылен кертеш?<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Айдемылан оптыш – Господьлан сӧрымашым шоныде пуаш</para>
  <para style="q2" vid="PRO 20:25">да вара гына сайын шоналташ.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Мунло кугыжа осал еҥ-влакым арва семын пуалта</para>
  <para style="q1" vid="PRO 20:26">да шийме орва дене ӱмбачышт кудал эрта.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Айдемын шӱлышыжӧ – Господьын лампыже,</para>
  <para style="q1" vid="PRO 20:27">тудо шӱмын кӧргӧ луклажым терга.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Порылык ден чынлык кугыжам аралат,</para>
  <para style="q1" vid="PRO 20:28">порылыклан кӧра тудын престолжо пеҥгыдын шога.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Рвезын чапше – тудын вийже,</para>
  <para style="q1" vid="PRO 20:29">а шоҥгыеҥым чал ӱп сӧрастара.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Перен сусыртымаш осал деч эрныкта,</para>
  <para style="q1" vid="PRO 20:30">да кырымаш айдеме шӱмым тӧрлата.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="cl">21 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Кугыжан шӱмжӧ Господьын кидыште – пуйто вӱдйогын:</para>
  <para style="q1" vid="PRO 21:1">Господь тудым кушко шона, тушко виктара.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Коштмо чыла корныжым айдеме чынлан шотла,</para>
  <para style="q1" vid="PRO 21:2">но шӱм-чон шонымашым Господь терга.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Чын ыштымаш ден чынлыкым Господь</para>
  <para style="q2" vid="PRO 21:3">надырым кондымаш деч сайраклан шотла.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Кугешныше ончалтыш, моктаныше шӱм-чон –</para>
  <para style="q1" vid="PRO 21:4">тиде осал еҥын лампыже, сулык корныш нуно наҥгаят.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Тыршыше еҥын шонен пыштыме пашаже перкелыкым конда,</para>
  <para style="q1" vid="PRO 21:5">а кыдач-покшеч ыштылше айдеме нужна лиеш.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Еҥым ондален погымо поянлык – вашке шаланыше тӱтыра,</para>
  <para style="q1" vid="PRO 21:6">тудо колымашыш наҥгая.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Осал еҥ-влакын осал пашашт шке ӱмбакышт толеш,</para>
  <para style="q1" vid="PRO 21:7">вет нуно чынлыкым ышташ келшен огытыл.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Осал чоя айдемын корныжо кадыр,</para>
  <para style="q1" vid="PRO 21:8">а ару шӱм-чонан еҥын ыштымыже чын.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Вурседылше вате дене кугу пӧртыштӧ илымеш,</para>
  <para style="q2" vid="PRO 21:9">лучо пӧрт леведыш лукышто илаш.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Осал еҥ осаллан опкын,</para>
  <para style="q1" vid="PRO 21:10">ок чамане тудо лишыл еҥжымат.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Мыскылыше еҥым наказатлет – ужарвуй-влак ушым шындат,</para>
  <para style="q1" vid="PRO 21:11">мунло еҥым туныктет – налеш тудо шинчымашым.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Осал еҥын пӧртшым Чын Ыштыше эскера</para>
  <para style="q1" vid="PRO 21:12">да тудын ӱмбак азапым колта.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Кӧ незерын кычкырымыж деч пылышыжым петыра,</para>
  <para style="q1" vid="PRO 21:13">тудо шкежат кычкыраш тӱҥалеш, но вашмут огеш лий.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Шолып ыштыме пӧлек шыдым луштара,</para>
  <para style="q1" vid="PRO 21:14">помышыш пуымо взятке – кугу ажгынымашым.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Чынлыкым ыштымаш – чын ыштышылан куан,</para>
  <para style="q1" vid="PRO 21:15">а осалым ыштышылан тудо лӱдмашым конда.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Кӧ уш-акылын корныж гыч кораҥын,</para>
  <para style="q1" vid="PRO 21:16">колышо чон-влак коклаште лиеш.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Кӧ веселитлаш йӧрата – нужнаҥеш,</para>
  <para style="q1" vid="PRO 21:17">кӧ кочкаш-йӱаш йӧрата – поян ок лий.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Чын ыштыше еҥым сулен налаш осал еҥ пуалтеш,</para>
  <para style="q1" vid="PRO 21:18">чынле айдемым сулен налаш – шояк еҥ.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Вурседылше да шыде вате дене илымеш,</para>
  <para style="q2" vid="PRO 21:19">лучо ир мландыште илаш.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Мунло еҥын суртыштыжо – кӱлешан пого ден сай кочкыш,</para>
  <para style="q1" vid="PRO 21:20">а ушдымо чыла тидым кучылт пытара.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Чынлык ден порылыкым ышташ тыршыше еҥ</para>
  <para style="q2" vid="PRO 21:21">илышым, чынлыкым да чапым муэш.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Мунло еҥ виян-влакын олашкышт пура</para>
  <para style="q1" vid="PRO 21:22">да нунын ӱшанен илыме карманыштым шалата.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Кӧ шке умшаж ден йылмыжым шеклана,</para>
  <para style="q1" vid="PRO 21:23">тудо шкенжым орлык деч арала.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Торжа, кугешныше еҥым кугу кугешнымаш виктара,</para>
  <para style="q1" vid="PRO 21:24">лӱмжӧ тудын – «мыскылыше».<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Йолагайым кумыл шупшмыжо пытара,</para>
  <para style="q1" vid="PRO 21:25">вет кидше ынеж ыште пашам.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Кажне кечын тудым кумыл йодмыжо нулта,</para>
  <para style="q1" vid="PRO 21:26">а чын ыштыше чаманыде пуа.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Осал еҥ-влакын надырышт – йырнык,</para>
  <para style="q1" vid="PRO 21:27">поснак – осал чоя шонымаш дене кондымышт.<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Шояк таныклыше пыта,</para>
  <para style="q1" vid="PRO 21:28">а ӱшанле таныклыше эре ойлаш тӱҥалеш.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Осал еҥын чурийже вожылдымо,</para>
  <para style="q1" vid="PRO 21:29">а чын ыштыше шке корныж дене тура кая.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Айдеме мунлылык, уш-акыл да каҥаш</para>
  <para style="q2" vid="PRO 21:30">Господь ваштареш шоген огыт керт.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Имньым ямдылат сӧй кечылан,</para>
  <para style="q1" vid="PRO 21:31">но сеҥымаш – Господь дечын.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="cl">22 ГЛАВА</para>
  <para style="cd">1-16 Соломонын тӱрлӧ нерген туныктен каласыме кӱчык ойжо-влак мучашлалтыт. 17 Мунло-влакын кумло ойышт.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Поро лӱм кугу поянлык деч шергырак,</para>
  <para style="q1" vid="PRO 22:1">еҥ-влакын пагалымышт ший-шӧртньӧ деч сайрак.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Поян ден йорло теве мо дене икгай улыт:</para>
  <para style="q1" vid="PRO 22:2">нуным когыньыштымат Господь ыштен.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Ушан еҥ лӱдыкшым ужеш да шылеш,</para>
  <para style="q1" vid="PRO 22:3">а ужарвуй-влак ончыко каят да туткарыш логалыт.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Ӱҥышылык да Господь деч лӱдмаш</para>
  <para style="q2" vid="PRO 22:4">поянлыкым, чапым да илышым кондат.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Осал чоя еҥын корныштыжо – иман вондер ден оптыш,</para>
  <para style="q1" vid="PRO 22:5">кӧлан шке илышыже шерге, тудо тушко ок лишем.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Йочам чын корно дене каяш тӱҥалтыштак туныкто –</para>
  <para style="q1" vid="PRO 22:6">шоҥгеммекат, тушечын тудо ок кораҥ.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Поян – йорло айдемылан оза,</para>
  <para style="q1" vid="PRO 22:7">парыман еҥ – арымеш пуышо еҥлан тарзе.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Кӧ чындымылыкым ӱда – ойгым тӱредеш,</para>
  <para style="q1" vid="PRO 22:8">да тудын шыдылык тояже пудырга.</para>
  <para style="q1" vid="PRO 22:8">[Уло кумылын пуышо еҥым Юмо йӧрата</para>
  <para style="q1" vid="PRO 22:8">да тудлан мо кӱлешым пуа.]<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Поро чонан еҥ суапландарыме лиеш,</para>
  <para style="q1" vid="PRO 22:9">вет тудо шке киндыжым незер дене пайла.</para>
  <para style="q1" vid="PRO 22:9">[Чаманыде пуышо еҥ сеҥымаш ден чапым налеш,</para>
  <para style="q1" vid="PRO 22:9">кӧлан полшен, нуным шкеж велке савыра.]<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Поктен колто мыскылаш йӧратыше еҥым –</para>
  <para style="q1" vid="PRO 22:10">шургымаш пыта, вурседылмаш ден ӧпкелымаш чарнат.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Кӧ шӱм-чон арулыкым йӧрата да лыжган кутыра,</para>
  <para style="q1" vid="PRO 22:11">тудын йолташыже кугыжа лиеш.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Господь чыным арала,</para>
  <para style="q1" vid="PRO 22:12">а ондален илыше еҥын шомакшым укеш луктеш.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Йолагай еҥ ойла: «Уремыште лев!</para>
  <para style="q1" vid="PRO 22:13">Лектам гын тушко, мый колем!»<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Еҥ ватын умшаже – келге вынем:</para>
  <para style="q1" vid="PRO 22:14">тушко тудо еҥ камвозеш, кӧлан Господь шыдешкен.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Йочан шӱмышкӧ окмаклык пижын шинчын,</para>
  <para style="q1" vid="PRO 22:15">но ушым пуртышо розго тудым поктен колта.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Кӧ, пояш манын, йорлым шыгыремда</para>
  <para style="q2" vid="PRO 22:16">да кӧ поян еҥлан пӧлекым ышта – лийыт нужна.<verse eid="PRO 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Савыре пылышет, мунло-влакын мутыштым колышт,</para>
  <para style="q1" vid="PRO 22:17">шӱметым поч туныктымемлан.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Аралет гын нуным шӱмыштет,</para>
  <para style="q1" vid="PRO 22:18">лийыт гын нуно умшаштет –</para>
  <para style="q1" vid="PRO 22:18">лиеш тылат куанле да ласка.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Господьлан инанаш тунем манын,</para>
  <para style="q1" vid="PRO 22:19">мый нуным таче тылат увертарем.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Ушан кумло ойым мый тылат возенам –</para>
  <para style="q1" vid="PRO 22:20">тушто тый каҥаш ден шинчымашым муат,<note caller="*" style="f"><char style="fr" closed="false">22:20 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />чыным, кере шомакым пален налат</para>
  <para style="q1" vid="PRO 22:21">да тыйым колтышо-влаклан чын вашмутым пуэн кертат.<verse eid="PRO 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Нужна еҥым нужна улмыжлан ит аге,</para>
  <para style="q1" vid="PRO 22:22">незер еҥым судышто<note caller="*" style="f"><char style="fr" closed="false">22:22 </char><char style="ft" closed="false">Судышто – еврей текстыште «ола капка воктене». Тушто еҥ погынымо вер лийын, туштак судым ыштеныт.</char></note> ит шыгыремдыл –<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />вет нунын пашаштым Господь арала</para>
  <para style="q1" vid="PRO 22:23">да нуным агыше-влакын чоныштым налеш.<verse eid="PRO 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Ит келше шыде еҥ дене,</para>
  <para style="q1" vid="PRO 22:24">вашке сырыше дене таҥ ит лий,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />уке гын тудын корныжым тошкаш тунемат</para>
  <para style="q1" vid="PRO 22:25">да оптышыш логалат.<verse eid="PRO 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Еҥын парымжым шке ӱмбакет ит нал,</para>
  <para style="q1" vid="PRO 22:26">тудын парымже верч мутым кучаш ит сӧрӧ,<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />вет тылат нимо дене тӱлаш лиеш гын,</para>
  <para style="q1" vid="PRO 22:27">йымачет вакшышетымат налын каят.<verse eid="PRO 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Ожнак ыштыме межам ит кусаре,</para>
  <para style="q1" vid="PRO 22:28">тудым ача-кочат-влак колтеныт.<verse eid="PRO 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Ужынат мо шке пашажым мастарын ыштыше еҥым?</para>
  <para style="q1" vid="PRO 22:29">Тудо тыглай еҥ-шамыч ончылно огыл,</para>
  <para style="q2" vid="PRO 22:29">а кугыжа-влак ончылно шогаш тӱҥалеш.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="cl">23 ГЛАВА</para>
  <para style="cd">Мунло-влакын кумло ойышт (умбакыже).</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Кунам вуйлатыше дене кочкаш шинчат,</para>
  <para style="q1" vid="PRO 23:1">мо<note caller="*" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">«Мо» – еврей мутым «кӧ» манынат кусараш лиеш.</char></note> тыйын ончылнет – шеклане:<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />кочкышлан сут улат гын,</para>
  <para style="q1" vid="PRO 23:2">логарышкет чаракым шынде.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Тудын тамле сийжылан ит сутлане,</para>
  <para style="q1" vid="PRO 23:3">тиде – ондалчык кочкыш.<verse eid="PRO 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Пояш тӧчымӧ дене шкендым ит улныктаре,</para>
  <para style="q1" vid="PRO 23:4">тыгай шонымашым кодо.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Ончалат веле поянлык ӱмбаке – тудо укеат:</para>
  <para style="q1" vid="PRO 23:5">шкаланже шулдырым кушта</para>
  <para style="q1" vid="PRO 23:5">да арыслан семын кавашке чоҥешта.<verse eid="PRO 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Ит коч чаҥга еҥын кочкышыжым,</para>
  <para style="q1" vid="PRO 23:6">тамле сийжылан ит сутлане,<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />вет тыгай еҥ шке пайдаже нерген веле шона.</para>
  <para style="q1" vid="PRO 23:7">Каласа тылат: «Коч, йӱ»,</para>
  <para style="q1" vid="PRO 23:7">а ушыштыжо – йӧршеш весе.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Кочмо катышетым тый укшич шуэт,</para>
  <para style="q1" vid="PRO 23:8">каласыме сай шомакет ярашке лектеш.<verse eid="PRO 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Нимом ит ойло ушдымо еҥлан –</para>
  <para style="q1" vid="PRO 23:9">ушан шомакетым тудо кӱлдымыш луктеш.<verse eid="PRO 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Ожнак ыштыме межам ит кусаре,</para>
  <para style="q1" vid="PRO 23:10">тулык-влакын пасуштым шкаланет ит нал,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />вет нуным Аралыше виян,</para>
  <para style="q1" vid="PRO 23:11">тый денет судитлалтмышт годым Тудо нуным пыдал налеш.<verse eid="PRO 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Шӱметым туныктымаш дек савыре,</para>
  <para style="q1" vid="PRO 23:12">ушан шомаклан пылышетым поч.<verse eid="PRO 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Йочам мут кучыктыде ит кодо:</para>
  <para style="q1" vid="PRO 23:13">розго дене кырет гын, колымаш деч утарет.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Кырен налат тудым розго дене</para>
  <para style="q1" vid="PRO 23:14">да вес тӱня деч арален кодет.<verse eid="PRO 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Эргым, шӱмет мунло лиеш гын,</para>
  <para style="q1" vid="PRO 23:15">мыйынат шӱмем куана,<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />умшат чыным кутыра гын,</para>
  <para style="q1" vid="PRO 23:16">уло кӧргем йывырта.<verse eid="PRO 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Тек сулыкан-влаклан шӱмет ок кӧране,</para>
  <para style="q1" vid="PRO 23:17">тек тудо Господь дечын эре лӱдеш,<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />вет уло тыйын ончыкылык,</para>
  <para style="q1" vid="PRO 23:18">арам ок лий инанен илымет.<verse eid="PRO 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Колышт, эргым, да лий мунло,</para>
  <para style="q1" vid="PRO 23:19">шке шӱметым чын корныш виктаре.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Ит лий йӱын руштшо-влак коклаште,</para>
  <para style="q1" vid="PRO 23:20">шылым утыждене кочшо-влак дене ит шинчылт,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />вет йӱын коштшо ден сут логар-влак нужнаҥыт,</para>
  <para style="q1" vid="PRO 23:21">нерен шинчымышт нунылан сырве-сорво вургемым чикта.<verse eid="PRO 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Колышт ачатым – тудо тыйым шочыктен,</para>
  <para style="q1" vid="PRO 23:22">кӱлдымыш ит лук аватым, кунам тудо шоҥгемеш.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Кычал му чыным да мунлылыкым ит йомдаре,</para>
  <para style="q1" vid="PRO 23:23">ит кораҥ туныктымаш деч, уш-акылым пого.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Чын ыштыше эргын ачаже куана,</para>
  <para style="q1" vid="PRO 23:24">мунло эргым шочыктышо йывырта.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Тек куанат ачат ден ават,</para>
  <para style="q1" vid="PRO 23:25">тыйым шочыктышо йывырта!<verse eid="PRO 23:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Эргым, мый декем шӱметым савыре,</para>
  <para style="q1" vid="PRO 23:26">мыйын корнем дек шинчатым виктаре.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Яжар ӱдырамаш – тиде келге вынем,</para>
  <para style="q1" vid="PRO 23:27">вес еҥын ватыже – шыгыр таве,<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />агаш лекше семын тудо ваҥен шога</para>
  <para style="q1" vid="PRO 23:28">да ватыштым ондалыше пӧръеҥ чотым шукемда.<verse eid="PRO 23:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Кӧ варгыжеш? Кӧ кечкыжеш?</para>
  <para style="q1" vid="PRO 23:29">Кӧн шургымаш? Кӧ вуйым шиеш?</para>
  <para style="q1" vid="PRO 23:29">Кӧн чурийже какаргыше? Кӧн шинчаже йошкаргыше?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Нунын, кӧмыт арака воктене кужун шинчат,</para>
  <para style="q1" vid="PRO 23:30">кӧмыт тамлештарыме йошкар аракам кычал коштыт.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Ит ончо аракам, могай тудо йошкарге,</para>
  <para style="q1" vid="PRO 23:31">кузе тудо коркаште йолгыжеш да куштылгын йӱалтеш –<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />варажым тудо пурлеш кишке семын,</para>
  <para style="q1" vid="PRO 23:32">шемгишке семын чӱҥгалеш.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Ужаш тӱҥалеш шинчатше ыҥлаш лийдымым,</para>
  <para style="q1" vid="PRO 23:33">шотдымо шонымаш-влак шӱметым авалтат –<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />пуйто теҥыз покшелне киет,</para>
  <para style="q1" vid="PRO 23:34">мачте вуйышто малет.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />[Каласет тый:] «Мыйым кыреныт – корштен огыл,</para>
  <para style="q1" vid="PRO 23:35">мыйым лупшеныт – нимат шижын омыл.</para>
  <para style="q1" vid="PRO 23:35">Кунам помыжалтам, адак йӱаш кычал каем».<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="cl">24 ГЛАВА</para>
  <para style="cd">1-22 Мунло-влакын кумло ойышт (мучаш). 23 Мунлыеҥ-влакын вес ойпогышт.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Осал еҥ-влаклан ит кӧране</para>
  <para style="q1" vid="PRO 24:1">да нунын дене пырля лияш ит тырше,<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />вет ушышт осал пашам ышташ шона,</para>
  <para style="q1" vid="PRO 24:2">умшашт ойгым кондаш кутыра.<verse eid="PRO 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Мунлылык полшымо дене пӧрт чоҥалтеш,</para>
  <para style="q1" vid="PRO 24:3">уш-акыл полшымо дене тудо пеҥгыдын шога,<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />да шинчымаш полшымо дене пӧлемже-влак</para>
  <para style="q2" vid="PRO 24:4">шергакан да мотор арвер дене темыт.<verse eid="PRO 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Кӧ мунло, тудо куатан,</para>
  <para style="q1" vid="PRO 24:5">кӧн шинчымашыже уло, тудо вийым пога.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Сар дене кает – ой-каҥашым колышт,</para>
  <para style="q1" vid="PRO 24:6">вет каҥашым пуышо шуко гын, сеҥымаш лиеш.<verse eid="PRO 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Ушдымо еҥлан мунлылык – умылаш лийдыме,</para>
  <para style="q1" vid="PRO 24:7">ола капка воктене тудо умшажым ок поч.<verse eid="PRO 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Осалым ышташ шонышо еҥым</para>
  <para style="q2" vid="PRO 24:8">«осал чоя» манын лӱмдат.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Ушдымылыкын мом ышташ шонымыжо – сулык,</para>
  <para style="q1" vid="PRO 24:9">да мыскылыше айдеме – еҥ-влаклан йырнык.<verse eid="PRO 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Ойган кечын тый пеҥгыде лийын отыл гын,</para>
  <para style="q1" vid="PRO 24:10">шагал тугеже тыйын виет.<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Утаре титак деч посна колымашлан пуымо-влакым,</para>
  <para style="q1" vid="PRO 24:11">пушташ наҥгайыме-влак деч кораҥын ит кай.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Каласет мо: «Ме тидым пален огынал»?</para>
  <para style="q1" vid="PRO 24:12">Но шӱм-чоным Тергыше ок пале мо?</para>
  <para style="q1" vid="PRO 24:12">Тыйын илышетым Эскерыше тидым пала,</para>
  <para style="q1" vid="PRO 24:12">айдемылан Тудо пашаж почеш пӧртылта.<verse eid="PRO 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Коч мӱйым, эргым – тудо пайдале,</para>
  <para style="q1" vid="PRO 24:13">коч караш мӱйым – умшатлан тудо шере.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Тыгаяк лиеш чонетлан мунлылык,</para>
  <para style="q1" vid="PRO 24:14">муат тудым – уло ончыкылыкет,</para>
  <para style="q1" vid="PRO 24:14">арам ок лий инанен илымет.<verse eid="PRO 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Осал еҥ, чын ыштышын пӧртшӧ воктене ваҥен ит шинче,</para>
  <para style="q1" vid="PRO 24:15">тудын илыме вержым ит аге –<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />чын ыштыше шым гана камвозеш гынат, кынелеш,</para>
  <para style="q1" vid="PRO 24:16">а осал еҥ-влак шӱртнят да туткарыш логалыт.<verse eid="PRO 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Ит йывырте, кунам тушманет камвозеш,</para>
  <para style="q1" vid="PRO 24:17">шӱмет ынже куане, кунам тудо шӱртня,<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />вет Господь шинча ончылно тиде осал паша,</para>
  <para style="q1" vid="PRO 24:18">да Тудо шке шыдыжым тушманет деч кораҥда.<verse eid="PRO 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Ит шыдешке осалым ыштыше-влаклан,</para>
  <para style="q1" vid="PRO 24:19">сулыкан-влаклан ит кӧране,<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />вет осал еҥын ончыкылыкшо уке,</para>
  <para style="q1" vid="PRO 24:20">сулыкан-влакын лампышт йӧра.<verse eid="PRO 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Эргым, Господь деч да кугыжа деч лӱд,</para>
  <para style="q1" vid="PRO 24:21">вуянче-влак дене кылым ит кучо,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />вет когыньышт деч толеш вучыдымын азап –</para>
  <para style="q1" vid="PRO 24:22">кӧ пала, могай ойгым нуно колтат.<verse eid="PRO 24:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />Теве эше мунлыеҥ-влакын ойлымышт.</para>
  <para style="q1" vid="PRO 24:23">Судышто еҥым ойыркалаш сай огыл.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Кӧ титакан еҥлан «тый чын улат» манын каласа,</para>
  <para style="q1" vid="PRO 24:24">тудым калык-влак каргаш, тукым-влак ужмышудымын ончаш тӱҥалыт.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />А кӧ титакан еҥым мут кучаш шогалта,</para>
  <para style="q1" vid="PRO 24:25">тудын дене сай лиеш, ӱмбакше суапландарымаш толеш.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Чынле вашмут – тӱрвым шупшалме дене иктак.<verse eid="PRO 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Ондак пӧрт воктенысе сомылым ыште,</para>
  <para style="q1" vid="PRO 24:27">пасушто пашатым пытаре,</para>
  <para style="q1" vid="PRO 24:27">вара гына пӧртетым чоҥо.<verse eid="PRO 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Лишылъеҥет ӱмбак шояклен ит таныкле –</para>
  <para style="q1" vid="PRO 24:28">молан тылат ондален ойлаш?<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Ит ойло: «Кузе тудо мый денем ыштен,</para>
  <para style="q1" vid="PRO 24:29">мыят тудын дене тыгак ыштем –</para>
  <para style="q1" vid="PRO 24:29">пашаж почеш тудлан пӧртылтем».<verse eid="PRO 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Эртен каенам мый йолагай еҥын пасужо воктеч,</para>
  <para style="q1" vid="PRO 24:30">ушдымо айдемын виноград аҥаже воктеч:<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />чыла вере кушкын шогалын коршаҥге,</para>
  <para style="q1" vid="PRO 24:31">почкалтыш леведын, кӱ пырдыж сӱмырлен.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Чыла тидым ончен, мый шонкаленам –</para>
  <para style="q1" vid="PRO 24:32">теве мом ужынам да умыленам:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />изишак малет, изиш нералтет,</para>
  <para style="q1" vid="PRO 24:33">кидет кыргештен, изиш киялтет –<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />аген коштшо семын тый декет нужналык толеш,</para>
  <para style="q1" vid="PRO 24:34">толышо еҥ семын йорлылык поктен шуэш.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="cl">25 ГЛАВА</para>
  <para style="cd">Соломонын туныктен каласыме моло ойжо, нуным Езекий кугыжан еҥже-влак погеныт (25 гыч 29 глава марте).</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Теве эше Соломонын туныктен каласыме ойжо-влак, нуным Иуда кугыжа Езекийын еҥже-влак погеныт.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Юмын чапше – айдеме шинча деч пашам шылташ,</para>
  <para style="q1" vid="PRO 25:2">кугыжан чапше – тидым шымлаш.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Каван кӱкшытшӧ да мландын келгытше семын</para>
  <para style="q2" vid="PRO 25:3">кугыжан шӱмжат шымлаш лийдыме.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Ший деч шлакым ойырет гын,</para>
  <para style="q1" vid="PRO 25:4">мастар кидыште ате шочеш;<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />кугыжа деч осал еҥым кораҥдет гын,</para>
  <para style="q1" vid="PRO 25:5">чын ыштыме дене престолжо пеҥгыдын шогаш тӱҥалеш.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Кугыжа ончылно шкендым кугу еҥ семын ит кучо</para>
  <para style="q1" vid="PRO 25:6">да тӧра-влак коклаште верым налаш ит тырше:<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />лӱмлӧ еҥ-влак ончылно тыйым ӱлык шындымешке,</para>
  <para style="q1" vid="PRO 25:7">тек лучо тылат «тышке лишем» манын каласат.</para>
  <para style="q1" vid="PRO 25:7">Мом шке шинчат дене ужынат,<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />судыш лукташ ит вашке –</para>
  <para style="q1" vid="PRO 25:8">тушто тыйым вес еҥ вожылмашке пурта гын,</para>
  <para style="q1" vid="PRO 25:8">мом тый ышташ тӱҥалат?<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Вес еҥ дене судитлалтат гын,</para>
  <para style="q1" vid="PRO 25:9">еҥын тайныжым ит поч:<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />уке гын тидын нерген колшо еҥ тыйым шылтала,</para>
  <para style="q1" vid="PRO 25:10">тунам намыс тый дечет огеш кораҥ.</para>
  <para style="q1" vid="PRO 25:10">[Эрыкым кондат йӧратымаш ден келшымаш:</para>
  <para style="q1" vid="PRO 25:10">мыскылалташ огыл манын, кучо нуным пеленет,</para>
  <para style="q1" vid="PRO 25:10">тек коштмо корнет тынысле лиеш.]<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Шке жапыште каласыме шомак –</para>
  <para style="q2" vid="PRO 25:11">ший теркесе шӧртньӧ олма дене иктак.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Тӱткӧ пылышлан мунло шылталымаш</para>
  <para style="q1" vid="PRO 25:12">шӧртньӧ кӧрж, яндар шӧртньӧ гыч ыштыме сӧрастарыш гай улеш.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Ӱшанле уверзе шке озажлан</para>
  <para style="q2" vid="PRO 25:13">уржа-сорла жап годым лумын йӱштыж дене иктак:</para>
  <para style="q1" vid="PRO 25:13">тудо шке озажлан вийым пуа.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Пыл да мардеж, но йӱр уке –</para>
  <para style="q1" vid="PRO 25:14">тыгаяк тудо еҥ, кӧ пуыдымо пӧлекше дене моктана.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Чытен моштымо дене савыраш лиеш вуйлатышым,</para>
  <para style="q1" vid="PRO 25:15">тыматле шомак торешланымым сеҥа.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Мӱйым муынат – коч мыняр кӱлешым,</para>
  <para style="q1" vid="PRO 25:16">утыжым кочкат гын, укшинчаш тӱҥалат.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Ит кошт йолташын пӧртышкыжӧ чӱчкыдын,</para>
  <para style="q1" vid="PRO 25:17">уке гын тудо тый дечет ноя, да тудлан ужмышудымо лият.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Лишылъеҥже ваштареш шояклен таныклыше еҥ –</para>
  <para style="q2" vid="PRO 25:18">шугыньо, керде да пӱсӧ пикш дене иктак.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Туткар кечын шояк еҥлан ӱшанаш –</para>
  <para style="q2" vid="PRO 25:19">пудыргышо пӱй але окшак йол дене иктак.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Ойган шӱманлан мурым мураш –</para>
  <para style="q2" vid="PRO 25:20">йӱштӧ кечын вургемым кудашме</para>
  <para style="q2" vid="PRO 25:20">але сусыр верыш уксусым йоктарыме дене иктак.</para>
  <para style="q1" vid="PRO 25:20">[Вургемлан эҥгекым когарш, пушеҥгылан – шукш,</para>
  <para style="q2" vid="PRO 25:20">а айдемын шӱмжылан ойго кондат.]<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Тушманет шужышо гын‚ тудым пукшо‚</para>
  <para style="q1" vid="PRO 25:21">йӱмыжӧ шуэш гын‚ йӱктӧ:<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />тыге ыштен‚ тый тудын вуйжылан йӱлышӧ тулшолым погет,</para>
  <para style="q1" vid="PRO 25:22">а тылат Господь пашат почеш пӧртылта.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Йӱдвел мардеж конда йӱрым,</para>
  <para style="q1" vid="PRO 25:23">а шалаумшан йылмыже – сырыше чурийым.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Вурседылше вате дене кугу пӧртыштӧ илымеш,</para>
  <para style="q2" vid="PRO 25:24">лучо пӧрт леведыш лукышто илаш.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Мӱндыр кундем гыч поро увер –</para>
  <para style="q2" vid="PRO 25:25">сусынышо еҥлан йӱштӧ вӱд дене иктак.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Осал еҥлан вуйым пуышо чынле айдеме –</para>
  <para style="q2" vid="PRO 25:26">румбыкан вӱдшинча да шалатыме памаш дене иктак.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Кузе мӱйым утыждене кочкаш сай огыл,</para>
  <para style="q1" vid="PRO 25:27">тугак сай огыл эре чапым кычалаш.<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Шкенжым кучен моштыдымо еҥ –</para>
  <para style="q2" vid="PRO 25:28">пырдыж деч посна кодшо, шалатыме ола дене иктак.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="cl">26 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Кеҥежлан лум, уржа-сорлалан йӱр,</para>
  <para style="q2" vid="PRO 26:1">а ушдымылан чап келшен огыт тол.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Кузе пӧрткайык але вараксим чоҥештен каят,</para>
  <para style="q1" vid="PRO 26:2">тыгак сулен налдыме каргымаш эртен кая.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Сола – имньылан, шӧрмыч – осёллан,</para>
  <para style="q1" vid="PRO 26:3">а розго – ушдымын тупшылан.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Ушдымылан тудын ушдымылыкшо почеш ит вашеште,</para>
  <para style="q1" vid="PRO 26:4">уке гын тыят тудын гай лият.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Ушдымылан тудын ушдымылыкшо почеш вашеште,</para>
  <para style="q1" vid="PRO 26:5">уке гын тудо шкенжым мунлылан шотлаш тӱҥалеш.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Кӧ ушдымо еҥ дене уверым колта – туткарыш логалеш,</para>
  <para style="q1" vid="PRO 26:6">пуйто шке йолжым пӱчкын шуа.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Ушдымо еҥын ушан ойым пелешташ тӧчымыжӧ –</para>
  <para style="q2" vid="PRO 26:7">окшак еҥын окшаклен кайымыж дене иктак.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Ушдымылан чапым пуымаш –</para>
  <para style="q2" vid="PRO 26:8">рогаткыш кӱм кылдыме дене иктак.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Ушдымо еҥын ушан ойым пелешташ тӧчымыжӧ –</para>
  <para style="q2" vid="PRO 26:9">йӱшын кидыштыже улшо иман вондо дене иктак.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Ушдымым але перныл коштшым пашаш налше еҥ –</para>
  <para style="q2" vid="PRO 26:10">куш логалын, тушко лӱйкалыше пикшызе дене иктак.<note caller="*" style="f"><char style="fr" closed="false">26:10 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Кузе пий шке укшинчышыж дек пӧртылеш,</para>
  <para style="q1" vid="PRO 26:11">тыгак ушдымо еҥ шке ушдымо пашажым угыч ышта.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Ужынат мо шкенжым мунлылан шотлышо айдемым?</para>
  <para style="q1" vid="PRO 26:12">Тудын дене таҥастарымаште, ушдымо еҥлан ӱшан кугурак.<verse eid="PRO 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Йолагай ойла: «Уремыште лев!</para>
  <para style="q1" vid="PRO 26:13">Уремыште лев коштеш!»<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Топсаште<note caller="*" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">Топса – петля.</char></note> омса тышке-тушко коштеш,</para>
  <para style="q1" vid="PRO 26:14">а йолагай шке вакшыштыже почаҥеш.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Йолагай шке кидшым кӱмыжыш чыка,</para>
  <para style="q1" vid="PRO 26:15">а умша дек намиен шукташ тудлан неле.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Шотан вашмутым пуышо шым еҥ деч</para>
  <para style="q2" vid="PRO 26:16">йолагай шкенжым ушанраклан шотла.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Эртен кайышыла, еҥ вурседылмашыш шӱшкылтмаш</para>
  <para style="q2" vid="PRO 26:17">осал пийым пылышыж гыч руалтен кучымо дене иктак.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />Кӧ вес еҥым ондала,</para>
  <para style="q1" vid="PRO 26:18-19">а вара «мыскарам веле ыштышым» манеш,</para>
  <para style="q1" vid="PRO 26:18-19">уш пудыраныше еҥ дене иктак,</para>
  <para style="q1" vid="PRO 26:18-19">кудыжо йӱлышӧ пикшым колтылеш да колымашым ӱда.<verse eid="PRO 26:18-19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Пу пыта – тул йӧра,</para>
  <para style="q1" vid="PRO 26:20">манеш-манешым колтышо уке – вурседылмаш пыта.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Тулшол деч шокшо, пу деч тул лектеш,</para>
  <para style="q1" vid="PRO 26:21">а вурседылше еҥ келшыдымашым ылыжта.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Манеш-манешым шаркалышын мутшо – пуйто томсык,</para>
  <para style="q1" vid="PRO 26:22">мӱшкыр кӧргыш тудо куштылгын пура.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Осал шӱм-чонан еҥын йымыжан кутырымыжо</para>
  <para style="q2" vid="PRO 26:23">шун кӧршӧкым комыжлымо ший дене иктак.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Чоян ӱедылеш умшаж дене тушман,</para>
  <para style="q1" vid="PRO 26:24">а шӱмыштыжӧ шона осалым.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Кеч ныжылге йӱк дене ойла, тудлан ит ӱшане:</para>
  <para style="q1" vid="PRO 26:25">шым йырнык уло тудын шӱмыштыжӧ.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Чоян шылта гынат ужмышудымашым,</para>
  <para style="q1" vid="PRO 26:26">калык ончылно осаллыкше садак почылтеш.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Кӧ вынемым кӱнча – тушко шкеак камвозеш,</para>
  <para style="q1" vid="PRO 26:27">кӧ кугу кӱм пӧрдыкта – тудын йымаке шке логалеш.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Шояк йылман еҥ кӧм сусыртен, нуным ужмыжо ок шу,</para>
  <para style="q1" vid="PRO 26:28">а ӱедыл ойлышо айдеме ойгым конда.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="cl">27 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Эрласе кече дене ит моктане,</para>
  <para style="q1" vid="PRO 27:1">вет тудо мом конда – тый от пале.<verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Тек тыйым шке умшат огыл, а вес еҥ мокта –</para>
  <para style="q2" vid="PRO 27:2">тыйын огыл, а весын йылмыже.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Кӱ неле, ошмат куштылго огыл,</para>
  <para style="q1" vid="PRO 27:3">а ушдымо еҥын чоным туржмыжо эшеат нелырак.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Шыде – шучко, ажгынлык – кучен кертдыме,</para>
  <para style="q1" vid="PRO 27:4">но ушкалымаш ваштареш кӧ шоген кертеш?<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Чон почын шылталымаш</para>
  <para style="q2" vid="PRO 27:5">шолып йӧратымаш деч сайрак.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Йолташын шылталымыже – чынле,</para>
  <para style="q1" vid="PRO 27:6">тушманын шупшалмыже – шоя.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Темше мӱшкыр караш мӱйымат тошкен коштеш,</para>
  <para style="q1" vid="PRO 27:7">а шужышо мӱшкырлан кочыжат шерыла чучеш.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Шке мландыжым коден кайыше еҥ</para>
  <para style="q2" vid="PRO 27:8">шке пыжашыжым кодышо кайык дене иктак.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Кузе олив ӱй ден тамлыпушан наста<note caller="*" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">Тамлыпушан наста – благовонное вещество.</char></note> шӱм-чоным куандарат,</para>
  <para style="q1" vid="PRO 27:9">тугак йолташын шӱм гыч лекше каҥашыже чонлан келша.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Ит кодо шке йолташетым, ачатын йолташыжымат.</para>
  <para style="q1" vid="PRO 27:10">Ойгыш логалмекет, изатын пӧртышкыжӧ ит кай:</para>
  <para style="q1" vid="PRO 27:10">лишне улшо пошкудет умбалне илыше изат деч сайрак.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Эргым, мунло лий да шӱмем куандаре –</para>
  <para style="q1" vid="PRO 27:11">тунам палем, мом мыйым вурсышылан вашешташ.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Ушан еҥ лӱдыкшым ужеш да шылеш,</para>
  <para style="q1" vid="PRO 27:12">а ужарвуй-влак ончыко каят да туткарыш логалыт.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Кӧ палыдыме еҥын парымже верч мутым кучаш сӧрен,</para>
  <para style="q1" vid="PRO 27:13">тудын деч вургемжым нал,</para>
  <para style="q1" vid="PRO 27:13">йот еҥ верчат тудын деч залогым нал.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Кӧ эрден эр шке пошкудыжлан суапым кугу йӱкын тылана,</para>
  <para style="q1" vid="PRO 27:14">тудым каргыше еҥлан шотлат.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Ӱчашаш йӧратыше вате</para>
  <para style="q2" vid="PRO 27:15">йӱран кечын чыпчен шинчыше вӱд гай:<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />тудым чараш тӧчымаш –</para>
  <para style="q1" vid="PRO 27:16">мардежым чарыме але олив ӱйым урзышто кучымо дене иктак.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Кӱртньӧ кӱртньым шума,</para>
  <para style="q1" vid="PRO 27:17">айдеме – айдемым.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Кӧ смоква пушеҥгым ончен кушта – саскажым кочкеш,</para>
  <para style="q1" vid="PRO 27:18">кӧ шке озаже верч тырша – чапыште лиеш.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Кузе вӱд ӱмбалне айдемын чурийже коеш,</para>
  <para style="q1" vid="PRO 27:19">тугак ик еҥын шӱмжӧ гоч весыным пуйто воштончышышто ужаш лиеш.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Темдыме улыт вес тӱня ден колымаш,</para>
  <para style="q1" vid="PRO 27:20">айдемын шинчажат тыгаяк темдыме.</para>
  <para style="q1" vid="PRO 27:20">[Кугешнен ончымаш – Господь шинча ончылно йырнык,</para>
  <para style="q1" vid="PRO 27:20">а кужу йылман-влак ушдымо улыт.]<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Левыктыме вер – шийлан, коҥга – шӧртньылан,</para>
  <para style="q1" vid="PRO 27:21">а айдемым моктеммут терга.</para>
  <para style="q1" vid="PRO 27:21">[Сулыкан еҥын шӱмжӧ кычалеш осалым,</para>
  <para style="q1" vid="PRO 27:21">а чынле шӱм – шинчымашым.]<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Ушдымо еҥым пырче дене пырля</para>
  <para style="q2" vid="PRO 27:22">кеч шуарвондо дене шуареш шуро –</para>
  <para style="q1" vid="PRO 27:22">ушдымылыкшо тудын деч садак ок ойырло.<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Кузе вольыкет илыштеш – эскерен шого,</para>
  <para style="q1" vid="PRO 27:23">шорык кӱтӱ-влакетым сайын ончо,<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />вет нимогай поянлык курымашле огыл,</para>
  <para style="q1" vid="PRO 27:24">да кучемвий тукым гыч тукымыш ок шуйно.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Кунам, шудым поген налмеке, кайшудо лектеш</para>
  <para style="q1" vid="PRO 27:25">да курык тайылыштат шудым погымо,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />тунам пача меж гыч шкаланет вургемым ыштет,</para>
  <para style="q1" vid="PRO 27:26">каза-влакым ужален, пасум налат.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Шкендым, ешетым да тарзе ӱдырамаш-влакетым пукшаш</para>
  <para style="q2" vid="PRO 27:27">каза шӧрет ситышын лиеш.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="cl">28 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Осал еҥ куржеш, кеч тудым нигӧ ок покто,</para>
  <para style="q1" vid="PRO 28:1">а чын ыштыше еҥ – лев гай лӱддымӧ.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Элыште пудыранчык гын, вуйлатыше-влак шукын лийыт,</para>
  <para style="q1" vid="PRO 28:2">а ушан-шотан вуйлатыше годым эл пеҥгыдын шога.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Незер-влакым шыгыремдылше йорло еҥ</para>
  <para style="q2" vid="PRO 28:3">шурным пытарыше кугу йӱр дене иктак.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Закон деч кораҥше-влак осал еҥ-шамычым моктат,</para>
  <para style="q1" vid="PRO 28:4">а законым шуктен шогышо-влак нунын ваштареш шогат.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Осал еҥ-влак чынлыкым огыт умыло,</para>
  <para style="q1" vid="PRO 28:5">а Господьым кычалше-влак тудым пӱтынек умылат.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Титакыш пурыде илыше йорло айдеме</para>
  <para style="q2" vid="PRO 28:6">пужлышо корно дене коштшо поян еҥ деч сайрак.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Кӧ законым шуктен шога, тудо ушан эрге,</para>
  <para style="q1" vid="PRO 28:7">а шотдымо-влак дене келшыше шке ачажым шӱктара.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Кӧ шке поянлыкшым кугу ашламым налын шукемда,</para>
  <para style="q1" vid="PRO 28:8">мом погымыжо йорло-влаклан полшышо еҥлан лиеш.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Кӧ Господьын законжым ынеж колышт,</para>
  <para style="q1" vid="PRO 28:9">тудын кумалмыже Господьлан йырнык.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Чын ыштыше-влакым осал корныш савырыше еҥ</para>
  <para style="q2" vid="PRO 28:10">шке кӱнчымӧ вынемышкыже логалеш,</para>
  <para style="q1" vid="PRO 28:10">а чын корным тошкышо-влакым суап вуча.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Поян шкенжым мунлылан шотла,</para>
  <para style="q1" vid="PRO 28:11">но ушан йорло еҥ тудым вошт ужеш.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Кунам чын ыштыше-влак йывыртат – кугу куан озалана,</para>
  <para style="q1" vid="PRO 28:12">а кунам осал еҥ-влак нӧлталтыт – калык шылеш.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Кӧ шке сулыкшым шылта – илышыже ок воране,</para>
  <para style="q1" vid="PRO 28:13">а кӧ титакшым луктын каласа да тудын деч кораҥеш –</para>
  <para style="q2" vid="PRO 28:13">серлагыме лиеш.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Господь деч лӱдын илыше айдеме суапым налеш,</para>
  <para style="q1" vid="PRO 28:14">а шӱмжым пешкыдемдыше еҥ азапыш логалеш.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Йорло калыклан осал вуйлатыше –</para>
  <para style="q2" vid="PRO 28:15">ырлыше лев але ажгыныше маска гай.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Ушдымо вуйлатыше шуко шыгыремдылеш,</para>
  <para style="q1" vid="PRO 28:16">а шолагай оксам ужмышудымо еҥ кужу ӱмыран лиеш.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Айдеме вӱрым йоктарыше еҥ</para>
  <para style="q2" vid="PRO 28:17">колымешкыже шылын куржталаш тӱҥалеш,</para>
  <para style="q1" vid="PRO 28:17">тек тудлан полшышо нигӧ огеш лий.<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Кӧ осалым ыштыде ила – лӱдыкшым ок уж,</para>
  <para style="q1" vid="PRO 28:18">а кӧ кадыр корно дене коштеш – вучыдымын камвозеш.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Кӧ шке мландыжым курал-ӱда – темше лиеш,</para>
  <para style="q1" vid="PRO 28:19">а южым чумен коштшым нужналык вуча.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Ӱшанле айдеме суапландарымашлан поян,</para>
  <para style="q1" vid="PRO 28:20">а кӧ пояш толаша – мут кучыде ок код.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Еҥым ойыркалаш сай огыл,</para>
  <para style="q1" vid="PRO 28:21">но южышт кинде шултыш верчат сулыкыш пурат.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Чаҥга айдеме пояш вашка,</para>
  <para style="q1" vid="PRO 28:22">но ок пале – тудым нужналык вуча.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Йылме дене ӱедылшым огыл,</para>
  <para style="q2" vid="PRO 28:23">а шылталыше еҥым тӱҥалыт варажым аклаш.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Кӧ шке ачаж ден аважын мо улыжым поген налеш</para>
  <para style="q1" vid="PRO 28:24">да «тиде сулык огыл» манеш,</para>
  <para style="q1" vid="PRO 28:24">тудо – пуштедыше-влаклан йолташ.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Опкын еҥ вурседылмашым ылыжта,</para>
  <para style="q1" vid="PRO 28:25">а Господьлан инаныше сайын ила.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Кӧ шкаланже инана, тудо ушдымо,</para>
  <para style="q1" vid="PRO 28:26">а кӧ мунло корно дене коштеш – лӱдыкшӧ деч утла.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Незер-влаклан пуышо еҥын чылажат ситышын лиеш,</para>
  <para style="q1" vid="PRO 28:27">а кӧ нунын деч шинчажым кораҥда –</para>
  <para style="q1" vid="PRO 28:27">шкеж ӱмбаке каргымашым конда.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Кунам осал еҥ-влак нӧлталтыт – еҥ-шамыч шылыт,</para>
  <para style="q1" vid="PRO 28:28">а кунам нуно пытат – чын ыштыше-влак тӱзланат.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="cl">29 ГЛАВА</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Кӧ шуко гана шылталыме деч варат ӱскыртлана,</para>
  <para style="q1" vid="PRO 29:1">вучыдымын пытарыме лиеш,</para>
  <para style="q1" vid="PRO 29:1">паремдымашым тудо ок уж.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Кунам чын ыштыше-влак вийым налыт – калык куана,</para>
  <para style="q1" vid="PRO 29:2">а кунам осал еҥ озалана – калык кечкыжеш.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Кӧ мунлылыкым йӧрата – шке ачажым куандара,</para>
  <para style="q1" vid="PRO 29:3">а кӧ яжар ӱдырамаш-влак дене коштеш – уло погыжым пытара.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Чынлык дене кугыжа элым пеҥгыдемда,</para>
  <para style="q1" vid="PRO 29:4">а взяткым йӧратыше тудым шалата.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Кӧ шке лишылже ончылно ӱедылеш,</para>
  <para style="q1" vid="PRO 29:5">тудын йолжылан оптышым шында.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Осал еҥын сулыкшо шкаланжак оптыш лиеш,</para>
  <para style="q1" vid="PRO 29:6">а чын ыштыше куанен мура.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Чын ыштыше еҥ судышто йорлын пашажым тӱткын шымла,</para>
  <para style="q1" vid="PRO 29:7">а осал айдеме ончашат ок тӱҥал.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Вуянче-влак олаште пудыранчыкым нӧлталыт,</para>
  <para style="q1" vid="PRO 29:8">а мунло-влак шыдым луштарат.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Кунам ушдымо еҥ мунло дене судитлалтеш,</para>
  <para style="q1" vid="PRO 29:9">тудо я сыра, я воштылеш, нигузе ок лыплане.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Титакдыме еҥым вӱр йоктарыше-влакын ужмышт ок шу,</para>
  <para style="q1" vid="PRO 29:10">а чын ыштыше-влак тудын дене йолташ лийнешт.<note caller="*" style="f"><char style="fr" closed="false">29:10 </char><char style="ft" closed="false">«Тудын дене йолташ лийнешт»: тидым «тудым арален налнешт» манынат кусараш лиеш.</char></note><verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Ушдымо еҥ уло шыдыжым луктын ончыкта,</para>
  <para style="q1" vid="PRO 29:11">а мунло шке шыдыжым кучен мошта.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Вуйлатыше шоякым колыштеш гын,</para>
  <para style="q1" vid="PRO 29:12">тудын полатыштыже чыланат осал лийыт.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Йорло ден шыгыремдылше теве мо дене икгай улыт:</para>
  <para style="q1" vid="PRO 29:13">когыньыштынат шинчаштлан волгыдым Господь пуэн.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Кугыжа йорло-влакым чын судитла гын,</para>
  <para style="q1" vid="PRO 29:14">тудын престолжо курымеш шога.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Розго ден шылталымаш ушым пуртат,</para>
  <para style="q1" vid="PRO 29:15">а туныктыде кушшо эрге аважым намысыш пурта.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Осал еҥ-влак шукемыт – сулык шукемеш,</para>
  <para style="q1" vid="PRO 29:16">но чын ыштыше-влак нунын пытымыштым ужыт.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Наказатле шке эргычым – ласкан илаш тӱҥалат,</para>
  <para style="q1" vid="PRO 29:17">чонетлан тудо куаным конда.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Кавасе кончымаш деч посна калык лиеш кучен кертдыме;</para>
  <para style="q1" vid="PRO 29:18">но законым шуктен шогышо-влак лийыт пиалан.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Кулым мут дене гына туныкташ огеш лий:</para>
  <para style="q1" vid="PRO 29:19">ойлымым умыла гынат, садак ок колышт.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Ужынат мо тый шоналтыде ойлышо айдемым?</para>
  <para style="q1" vid="PRO 29:20">Тудын дене таҥастарымаште, ушдымо еҥлан ӱшан кугурак.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Кулым изинекак нечкын ончен куштет гын,</para>
  <para style="q1" vid="PRO 29:21">варажым тудо тылат ойгым конда.<note caller="*" style="f"><char style="fr" closed="false">29:21 </char><char style="ft" closed="false">«Тылат ойгым конда»: тидым «эрге лияш шонен пышта» манынат кусараш лиеш.</char></note><verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Вашке шыдешкыше еҥ вурседылмашым ылыжта,</para>
  <para style="q1" vid="PRO 29:22">чыдыртан<note caller="*" style="f"><char style="fr" closed="false">29:22 </char><char style="ft" closed="false">Чыдыртан – вспыльчивый.</char></note> айдеме шуко сулыкым ышта.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Кугешнымаш айдемым ӱлыкӧ шында,</para>
  <para style="q1" vid="PRO 29:23">а ӱҥышӧ чонан чапыште лиеш.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Кӧ ворлан йолташ, тудо шкаланже тушман:</para>
  <para style="q1" vid="PRO 29:24">каргымым колеш, но нимом ок ойло.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Айдеме деч лӱдмаш – тиде оптыш,</para>
  <para style="q1" vid="PRO 29:25">а Господьлан инаныше еҥлан нимогай лӱдыкшӧ уке.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Шукышт вуйлатышын поро кумылжым кычалыт,</para>
  <para style="q1" vid="PRO 29:26">но айдемылан чын суд – Господь деч.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Чын ыштыше еҥлан осал айдеме йырнык,</para>
  <para style="q2" vid="PRO 29:27">а осал еҥлан – чын ыштыше айдеме.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="cl">30 ГЛАВА</para>
  <para style="cd">Агурын туныктен каласыме ойжо-влак.</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Агурын, Иакей эргын, каласыме шомакше-влак. Юмын пуымо нине шомакым тудо Ифииллан, Ифиил ден Укаллан<note caller="*" style="f"><char style="fr" closed="false">30:1 </char><char style="ft" closed="false">«Ифииллан, Ифиил ден Укаллан»: нине шомакым тыгеат кусараш лиеш: «Мый ноенам, Юмем. Мый ноенам, Юмем. Кузе мылам сеҥен лекташ?»</char></note> ойлен:<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />«Мутат уке, мый чыла еҥ деч окмакрак улам,</para>
  <para style="q1" vid="PRO 30:2">айдеме уш-акылем мыйын уке,<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />мунлылыклан тунемын омыл,</para>
  <para style="q1" vid="PRO 30:3">святой-влакын шинчымашышт мыйын уке.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Кӧ кӱзен кавашке да тушечын волен?</para>
  <para style="q1" vid="PRO 30:4">Кӧ мардежым шке урзышкыжо поген?</para>
  <para style="q1" vid="PRO 30:4">Кӧ вӱдым вургемышке вӱдылын?</para>
  <para style="q1" vid="PRO 30:4">Кӧ мландын чыла тӱржым палемден?</para>
  <para style="q1" vid="PRO 30:4">Кузе тудын лӱмжӧ?</para>
  <para style="q1" vid="PRO 30:4">Кузе тудын эргыжын лӱмжӧ?</para>
  <para style="q1" vid="PRO 30:4">Очыни, палет?<verse eid="PRO 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Юмын кажне шомакше яндар,</para>
  <para style="q1" vid="PRO 30:5">Тудлан инаныше-влаклан Тудо аралтыш.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Тудын шомакше дек нимом ит ешаре –</para>
  <para style="q1" vid="PRO 30:6">уке гын, Тудо тыйым шылтала,</para>
  <para style="q1" vid="PRO 30:6">да тый лектат шоячыш.<verse eid="PRO 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Кокытым мый Тый дечет йодам,</para>
  <para style="q1" vid="PRO 30:7">илымем годым нуным шукташ тореш ит лий:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />кӱлдымӧ шомак ден шоям мый дечем кораҥде,</para>
  <para style="q1" vid="PRO 30:8">мылам нужналыкымат, поянлыкымат ит пу.</para>
  <para style="q1" vid="PRO 30:8">Илышаш киндем мылам пуэн шого.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Уке гын мый, утыжден поян лиймеке,</para>
  <para style="q1" vid="PRO 30:9">Тый дечет кораҥын, ”Кӧ тыгай Господь?” манын кертам,</para>
  <para style="q1" vid="PRO 30:9">але, нужнаҥмеке, шолышташ тӱҥалын,</para>
  <para style="q1" vid="PRO 30:9">Юмын лӱмжым шӱктарен кертам.<verse eid="PRO 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Оза ончылно тудын кулжо нерген осалым ит ойло,</para>
  <para style="q1" vid="PRO 30:10">уке гын тудо тыйым карга, да титакетлан мутым кучет.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Улыт тыгай-влак, кӧмыт шке ачаштым каргат</para>
  <para style="q1" vid="PRO 30:11">да аваштлан суапым огыт тылане.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Улыт тыгай-влак, кӧмыт шкештым арулан ужыт,</para>
  <para style="q1" vid="PRO 30:12">кеч лавырашт деч эрыктыме огытыл.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Улыт тыгай-влак – о, кузе нуно кугешнен ончат,</para>
  <para style="q1" vid="PRO 30:13">кузе нуно нерыштым кӱшкӧ нӧлтат!<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Улыт тыгай-влак, кӧмытын пӱйышт керде гай,</para>
  <para style="q1" vid="PRO 30:14">оҥылашлушт кӱзӧ гай:</para>
  <para style="q1" vid="PRO 30:14">нуно мландымбалне йорло-шамычым пӧжгат,</para>
  <para style="q1" vid="PRO 30:14">еҥ-влак кокла гыч незер-влакым пытарат.<verse eid="PRO 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Сутланымашын кок ӱдыржӧ уло: ”Эше, эше!”</para>
  <para style="q1" vid="PRO 30:15">Теве кумыт, кудышт улыт темдыме,</para>
  <para style="q1" vid="PRO 30:15">эсогыл нылыт, кудышт огыт каласе: ”Сита!” –<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />вес тӱня, азам ыштен кертдыме мӱшкыр,</para>
  <para style="q1" vid="PRO 30:16">мланде, кудо вӱд деч нигунам огеш тем,</para>
  <para style="q1" vid="PRO 30:16">да тул, кудо нигунам ок каласе: ”Сита!”<verse eid="PRO 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Кӧ ача-аважым игылтеш да нуным ок колышт –</para>
  <para style="q1" vid="PRO 30:17">тудын шинчажым лапверысе курныж-влак чӱҥген луктыт,</para>
  <para style="q1" vid="PRO 30:17">арыслан иге-шамыч чӱҥген пытарат.<verse eid="PRO 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Кумыт мылам умылаш лийдыме,</para>
  <para style="q1" vid="PRO 30:18">нылыт, кудыштым ом керт умылен:<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />арысланын корныжо каваште,</para>
  <para style="q1" vid="PRO 30:19">кишкын корныжо кӱ коклаште,</para>
  <para style="q1" vid="PRO 30:19">корабльын корныжо теҥыз покшелне</para>
  <para style="q1" vid="PRO 30:19">да пӧръеҥын корныжо ӱдыр деке.<verse eid="PRO 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />А яжарланыше ватын корныжо тыгай:</para>
  <para style="q1" vid="PRO 30:20">кочкеш, умшажым ӱштылеш да каласа:</para>
  <para style="q1" vid="PRO 30:20">”Мый нимо удам ыштен омыл”.<verse eid="PRO 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Кумыт деч мланде чытырналтеш,</para>
  <para style="q1" vid="PRO 30:21">нылытым тудо ок керт чытен:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />кулым, кунам тудо кугыжа лиеш,</para>
  <para style="q1" vid="PRO 30:22">ушдымым, кунам тудо теммеш кочкеш,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />ужмышудымо ӱдырамашым, кунам тудо марлан лектеш,</para>
  <para style="q1" vid="PRO 30:23">да тарзе ӱдырамашым, кунам тудо озаватыжын вержым налеш.<verse eid="PRO 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Теве нылытын мландымбалне изи улыт,</para>
  <para style="q1" vid="PRO 30:24">но улыт мунло деч мунлырак:<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />кутко-влак – виян урлык огытыл,</para>
  <para style="q1" vid="PRO 30:25">а кочкыш шапашым кеҥежымак ямдылат,<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />даман-влак – куньырий урлык улыт,</para>
  <para style="q1" vid="PRO 30:26">а пыжашым кӱ курыкеш ыштат,<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />шурнышырчык-влак – нунын кугыжашт уке,</para>
  <para style="q1" vid="PRO 30:27">но лектыт рат дене,<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />шыҥшале-влак – кучаш лиеш нуным кид дене,</para>
  <para style="q1" vid="PRO 30:28">но кугыжан полатыште нуно лиедат.<verse eid="PRO 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Теве кумыньыштын ошкылышт яшката,</para>
  <para style="q1" vid="PRO 30:29">нылытын коштыт чаткатан:<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />лев – янлык-влак кокла гыч эн патыр,</para>
  <para style="q1" vid="PRO 30:30">нигӧн ончылно тудо ок кораҥ,<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />агытан, вуйым кӱш нӧлталын коштшо,</para>
  <para style="q1" vid="PRO 30:31">казатага, [кӱтӱм вӱден наҥгайыше,]</para>
  <para style="q1" vid="PRO 30:31">да кугыжа шке сарзыж-влак коклаште.<verse eid="PRO 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Окмак улмет дене тый шкендым кӱш шынденат</para>
  <para style="q2" vid="PRO 30:32">да осалым шонен пыштенат гын,</para>
  <para style="q1" vid="PRO 30:32">умшатым кидет дене петыре,<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />вет ӱмбалым пудыратыме деч ӱй лиеш,</para>
  <para style="q1" vid="PRO 30:33">нерым перыме деч вӱр йога,</para>
  <para style="q1" vid="PRO 30:33">а шыдым тарватыме деч келшыдымаш шочеш».<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="cl">31 ГЛАВА</para>
  <para style="cd">1 Лемуил кугыжан туныктен каласыме ойжо-влак. 10 Сай ватым моктымаш.</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Лемуил кугыжан каласыме шомакше-влак. Юмын пуымо нине шомаклан тудым аваже туныктен:<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />«Мо, эргым? Мо, мӱшкырыштем нумалме падырашем?</para>
  <para style="q1" vid="PRO 31:2">Мо, сӧрымӧ мутемын эргыже?<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Ит пытаре шке виетым ӱдырамаш-влаклан,</para>
  <para style="q1" vid="PRO 31:3">ӱнаретым – кугыжа-шамычым пытарыше ӱдырамаш-влаклан.<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Келшен ок тол кугыжа-влаклан, Лемуил,</para>
  <para style="q1" vid="PRO 31:4">келшен ок тол кугыжа-влаклан йошкар аракам,</para>
  <para style="q1" vid="PRO 31:4">вуйлатыше-шамычлан пӱрым йӱаш.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Руштмеке, нуно законым мондат</para>
  <para style="q1" vid="PRO 31:5">да йорло-влакым чын суд деч посна кодат.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Пуыза пӱрым колаш тӱҥалше еҥлан,</para>
  <para style="q1" vid="PRO 31:6">йошкар аракам – ойганыше чонанлан.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Тек тудо йӱэш да незерлыкшым монда,</para>
  <para style="q1" vid="PRO 31:7">шке орлыкшым ок шарналте тетла.<verse eid="PRO 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Поч умшатым шкешт верч шоген кертдыме-влак верч,</para>
  <para style="q1" vid="PRO 31:8">чыла вийдыме-влакым нал арален.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Поч умшатым чын судитлаш,</para>
  <para style="q1" vid="PRO 31:9">йорло да незерын пашаштым арален налаш».<verse eid="PRO 31:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Кӧ сай ватым муын кертеш?</para>
  <para style="q1" vid="PRO 31:10">Тудо шергакан кӱ деч шергырак.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Марийжын шӱмжӧ тудлан ӱшана,</para>
  <para style="q1" vid="PRO 31:11">огеш код тудо парыш дечын посна.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Илыме чыла кечылаштыже тудо марийжылан</para>
  <para style="q2" vid="PRO 31:12">осал дене огыл, а порылык дене пӧртылта.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Уло тудын межат, йытынат,</para>
  <para style="q1" vid="PRO 31:13">уло кумылын шке кидше дене тырша.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Тудо купеч корабль семын</para>
  <para style="q2" vid="PRO 31:14">умбачын кочкышым конда.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Волгыжмо деч ончыч кынелеш</para>
  <para style="q1" vid="PRO 31:15">да мӧҥгысыжӧ-влаклан кочкышым ямдыла,</para>
  <para style="q1" vid="PRO 31:15">тарзе ӱдырамашыже-влаклан пашам пуа.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Ончен лектеш пасум да тӱлен налеш,</para>
  <para style="q1" vid="PRO 31:16">ыштен налме парышыж дене виноград аҥам шында.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Куат дене тудо пашалан пижеш,</para>
  <para style="q1" vid="PRO 31:17">чыла сомыллан кидше кожмак.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Тудо пала: торгайыме пашаже парышым конда,</para>
  <para style="q1" vid="PRO 31:18">тудын лампыже йӱдымат йӱла.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Кидшым кӱнчылавондо дек шуя,</para>
  <para style="q1" vid="PRO 31:19">парняже шӱдырым ӱшанлын куча.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Йорлылан тудо кидкопажым почеш,</para>
  <para style="q1" vid="PRO 31:20">незерлан полыш кидшым шуялта.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Лум толмо деч ок лӱд тудын ешыже,</para>
  <para style="q1" vid="PRO 31:21">вет кажныжлан шокшо вургемым чикта.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Шкаланже тудо леведышым ышта,</para>
  <para style="q1" vid="PRO 31:22">вургемже улыт чапле йытын гыч ыштыме, шемалге-йошкар.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Марийже – ола капка воктене пагалыме еҥ,</para>
  <para style="q1" vid="PRO 31:23">шке элжын кугуракше-влак коклаште шинча.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Йытын вургемым тудо ужалаш ышта,</para>
  <para style="q1" vid="PRO 31:24">ханаан купеч-влаклан ӱштым ямдыла.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Вий-куат ден моторлык – тудын вургемже,</para>
  <para style="q1" vid="PRO 31:25">у кечылан тудо куана.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Умшаштыже – мунло шомак,</para>
  <para style="q1" vid="PRO 31:26">йылмыштыже – тыматле туныктымаш.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Суртышто кузе паша кая – эскерен шога,</para>
  <para style="q1" vid="PRO 31:27">яра киндым тудо ок коч.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Кынелыт йочаж-влак да тудым чаплат,</para>
  <para style="q1" vid="PRO 31:28">тыгак марийже тудым мокта:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />«Шукын улыт сай ӱдырамаш-влак,</para>
  <para style="q1" vid="PRO 31:29">но тый чылаштым эртенат!»<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Сӧраллык ондала, моторлык йомеш,</para>
  <para style="q1" vid="PRO 31:30">но Господь деч лӱдшӧ вате моктымашым сулен налеш.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Пӧртылтыза тудлан пашаже почеш,</para>
  <para style="q1" vid="PRO 31:31">тек тудо ола капка воктене пашаж дене чаплана!<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>