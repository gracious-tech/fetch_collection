<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Meadow Mari Bible</book>
  <para style="h">Авд</para>
  <para style="toc3">Авд</para>
  <para style="toc2">Авдий</para>
  <para style="toc1">Пророк Авдийын книгаже</para>
  <para style="mt">ПРОРОК АВДИЙЫН КНИГАЖЕ</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">1 Едомлан Юмо судым ышта. 15 Юмо калык-влакым судитлаш тӱҥалеш.</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Авдийлан ончыктымо кончымаш.</para>
  <para style="q1" vid="OBA 1:1">Едом шотышто Господь Юмо теве мом ойла.</para>
  <para style="q1" vid="OBA 1:1">Господь деч ме уверым колынна,</para>
  <para style="q1" vid="OBA 1:1">калык-влак дек уверзым колтымо:</para>
  <para style="q1" vid="OBA 1:1">«Кынелза, Едом ваштареш сар дене лектына!<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />Мый тыйым калык-влак коклаште изим ыштем,</para>
  <para style="q1" vid="OBA 1:2">еҥ-шамыч тыйым шотлымым чарнат.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Кугешныше шӱмет тыйым ондален.</para>
  <para style="q1" vid="OBA 1:3">Кӱан кӱкшӧ верыште, курык шелшыште,</para>
  <para style="q1" vid="OBA 1:3">тый нигӧ деч лӱдде илет да шке семынет шонет:</para>
  <para style="q1" vid="OBA 1:3">”Кӧ мыйым мландымбаке сӱмырен кертеш?”<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Кеч арыслангайык семын тый кӱшкӧ кӱзет</para>
  <para style="q1" vid="OBA 1:4">да пыжашетым шӱдыр-влак коклаште ыштет,</para>
  <para style="q1" vid="OBA 1:4">тушечат Мый тыйым сӱмырал кудалтем, – ойла Господь. –<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />Тый декет вор-влак але йӱдым аген коштшо-влак толыт гын,</para>
  <para style="q1" vid="OBA 1:5">тыйым нуно чот аген кодат ыле!</para>
  <para style="q1" vid="OBA 1:5">Но нуно шкаланышт мо кӱлешым гына шолыштыт ыле.</para>
  <para style="q1" vid="OBA 1:5">Тый декет виноградым погышо-влак толыт гын,</para>
  <para style="q1" vid="OBA 1:5">икмыняр саскам огыт кодо ыле мо?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Но Исав деч чыла поген налме,</para>
  <para style="q1" vid="OBA 1:6">чыла шылтымым кычал мумо!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Тый денет ик ушемыште лийше-влак</para>
  <para style="q2" vid="OBA 1:7">тыйым чек деке шумеш поктен колтат.</para>
  <para style="q1" vid="OBA 1:7">Тый денет тыныслын илыше-шамыч тыйым ондалат да сеҥат,</para>
  <para style="q1" vid="OBA 1:7">тый денет пырля кочшо-влак тылат оптышым шындат.</para>
  <para style="q1" vid="OBA 1:7">Но Едом шонен ок мошто!<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />Тудо кечын, – ойла Господь, –</para>
  <para style="q1" vid="OBA 1:8">Мый Едомышто мунло-влакым,</para>
  <para style="q2" vid="OBA 1:8">Исавын курыкыштыжо шонен моштышо-влакым пытарем.<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Тале сарзет-шамыч, Феман, лӱдын шогалыт,</para>
  <para style="q1" vid="OBA 1:9">Исавын курыкыштыжо илыше-влак</para>
  <para style="q2" vid="OBA 1:9">чылан шӱшкыл пуштмо лийыт.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />Шольычым, Иаков тукымым, шыгыремдыметлан</para>
  <para style="q2" vid="OBA 1:10">тыйым намыс леведеш,</para>
  <para style="q1" vid="OBA 1:10">пытарыме лият тый курымешлан.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Тудо кечын, кунам йот калык-влак</para>
  <para style="q2" vid="OBA 1:11">Иаковын поянлыкшым наҥгаеныт,</para>
  <para style="q1" vid="OBA 1:11">кунам йот тукым-влак капкашкыже пуреныт</para>
  <para style="q1" vid="OBA 1:11">да Иерусалим шотышто шеревам кышкеныт,</para>
  <para style="q1" vid="OBA 1:11">тый чыла тидым ончен шогенат,</para>
  <para style="q1" vid="OBA 1:11">нунын кокла гыч иктыж гай лийынат!<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />Огеш кӱл ыле тылат шольычын ойган кечыжлан куанаш,</para>
  <para style="q1" vid="OBA 1:12">Иуда эрге-влакым пытымышт кечын воштылаш,</para>
  <para style="q1" vid="OBA 1:12">орлыкан кечышт годым нуным мыскылен ойлаш.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Огеш кӱл ыле калыкемын ойган кечынже</para>
  <para style="q2" vid="OBA 1:13">тудын капкашкыже пураш,</para>
  <para style="q1" vid="OBA 1:13">огеш кӱл ыле туткар кечынже тудын пытымыжым ончаш,</para>
  <para style="q1" vid="OBA 1:13">азап толмо кечын тудын погыжым тӱкаш.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Огеш кӱл ыле тылат корнывожышто шогаш</para>
  <para style="q1" vid="OBA 1:14">да куржшо-влакым пуштедаш,</para>
  <para style="q1" vid="OBA 1:14">огеш кӱл ыле орлык толмо кечын</para>
  <para style="q2" vid="OBA 1:14">утаралт кодшо-влакым тушман кидыш пуаш.<verse eid="OBA 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />Господьын суд кечыже чыла калык ӱмбак толеш!</para>
  <para style="q1" vid="OBA 1:15">Мом тый ыштенат, тый денетат тыгакак ыштыме лиеш,</para>
  <para style="q1" vid="OBA 1:15">чыла пашат шке ӱмбакет пӧртылеш.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Мом те Мыйын святой курыкыштем йӱында,</para>
  <para style="q1" vid="OBA 1:16">тудымак чыла калыклан йӱаш логалеш:</para>
  <para style="q1" vid="OBA 1:16">нуно йӱыт, йӱын темыт да ӱмыл гай йомыт,</para>
  <para style="q1" vid="OBA 1:16">пуйто лийынат огытыл.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />А Сион курыкышто утарымаш лиеш,</para>
  <para style="q1" vid="OBA 1:17">тудо святой верлан шотлалташ тӱҥалеш,</para>
  <para style="q1" vid="OBA 1:17">Иаков тукым шке мландыжым угыч налеш.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Иаков тукым тул лиеш,</para>
  <para style="q1" vid="OBA 1:18">Иосиф тукым – тулйолкын,</para>
  <para style="q1" vid="OBA 1:18">а Исав тукым олым лиеш.</para>
  <para style="q1" vid="OBA 1:18">Нуно тудым ылыжтат да йӱлалтат,</para>
  <para style="q1" vid="OBA 1:18">Исав тукым гыч нигӧ ок код», –</para>
  <para style="q1" vid="OBA 1:18">тыге Господь каласен.<verse eid="OBA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />Кечывалвел мландыште илыше-влак</para>
  <para style="q2" vid="OBA 1:19">Исавын курыкшым руалтен налыт,</para>
  <para style="q1" vid="OBA 1:19">тӧрверыште илыше-шамыч – филистим-влакын мландыштым.</para>
  <para style="q1" vid="OBA 1:19">Нуно Ефрем ден Самарий кундемлам сеҥен налыт,</para>
  <para style="q1" vid="OBA 1:19">а Вениамин – Галаадым.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Пленыш наҥгайыме Израиль эрге-влак</para>
  <para style="q2" vid="OBA 1:20">Ханаан мландым Сарепта марте сеҥен налыт,</para>
  <para style="q1" vid="OBA 1:20">а Иерусалим гыч наҥгайыме</para>
  <para style="q2" vid="OBA 1:20">да кызыт Сефарадыште илыше-шамыч</para>
  <para style="q1" vid="OBA 1:20">Кечывалвел мландын олаж-влаклан оза лийыт.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Сеҥыше-влак Сион курыкыш кӱзат,</para>
  <para style="q1" vid="OBA 1:21">Исавын курыкыштыжо судитлаш тӱҥалыт,</para>
  <para style="q1" vid="OBA 1:21">тунам Господь Шкеак кугыжа лиеш.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>