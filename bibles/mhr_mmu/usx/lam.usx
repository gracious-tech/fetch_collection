<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Meadow Mari Bible</book>
  <para style="h">Шорт.мур</para>
  <para style="toc3">Шорт.мур</para>
  <para style="toc2">Иеремийын шортмо мурыжо</para>
  <para style="toc1">Иеремийын шортмо мурыжо</para>
  <para style="mt">ИЕРЕМИЙЫН ШОРТМО МУРЫЖО</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">Иерусалим шкет кодшо тулык вате гай лийын.</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />О, шкет шинча рӱдола,</para>
  <para style="q2" vid="LAM 1:1">ала-кунам шуко еҥан улшо!</para>
  <para style="q1" vid="LAM 1:1">Калык-влак коклаште кугу лийше</para>
  <para style="q2" vid="LAM 1:1">ынде тулык вате гай кодын,</para>
  <para style="q1" vid="LAM 1:1">кундем-влак коклаште он лийше</para>
  <para style="q2" vid="LAM 1:1">кызыт кулыш савырнен.<verse eid="LAM 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />Кочын шортеш тудо йӱдым,</para>
  <para style="q1" vid="LAM 1:2">чурийже гыч шинчавӱд йога.</para>
  <para style="q1" vid="LAM 1:2">Кӧмыт тудым йӧратеныт,</para>
  <para style="q1" vid="LAM 1:2">нунын коклаште лыпландарыше уке.</para>
  <para style="q1" vid="LAM 1:2">Чыла йолташыже ондален,</para>
  <para style="q1" vid="LAM 1:2">тушманыш савырнен.<verse eid="LAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />Орланен илыме деч вара Иудам пленыш наҥгаеныт,</para>
  <para style="q1" vid="LAM 1:3">перкан илыш деч вара тудо кул пашаш кычкалтын.</para>
  <para style="q1" vid="LAM 1:3">Йот калык-влак коклаште кызыт ила,</para>
  <para style="q1" vid="LAM 1:3">ласкалыкым ок му.</para>
  <para style="q1" vid="LAM 1:3">Ойго-орлыкшо годым</para>
  <para style="q2" vid="LAM 1:3">чуриктарыше-влак тудым поктен шуыныт.<verse eid="LAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />Сион корно-влак ойгаҥыныт,</para>
  <para style="q1" vid="LAM 1:4">вет пайремыш толшо нигӧ уке.</para>
  <para style="q1" vid="LAM 1:4">Олан капкаже-влак пустаҥыныт,</para>
  <para style="q1" vid="LAM 1:4">тушто иерей-шамыч йӧсын кечкыжыт,</para>
  <para style="q1" vid="LAM 1:4">ӱдыр-влак ойгырен шортыт,</para>
  <para style="q1" vid="LAM 1:4">олам шкенжымат шӱлык авалтен.<verse eid="LAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />Тушман-влак лийыныт оза,</para>
  <para style="q1" vid="LAM 1:5">сеҥен налше-влак эсен илат.</para>
  <para style="q1" vid="LAM 1:5">Шуко сулыкым ыштымыжлан</para>
  <para style="q2" vid="LAM 1:5">Господь тудлан ойгым колтен.</para>
  <para style="q1" vid="LAM 1:5">Йочаже-влакым пленыш наҥгаеныт,</para>
  <para style="q1" vid="LAM 1:5">тушман нуным поктен каен.<verse eid="LAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />Сион ӱдыр шке чапшым йомдарен.</para>
  <para style="q1" vid="LAM 1:6">Онжо-влак пуйто пӱчӧ улыт,</para>
  <para style="q2" vid="LAM 1:6">кудышт огыт му кочкын коштмо верлам,</para>
  <para style="q1" vid="LAM 1:6">поктышо-влак деч куржаш тӧчат,</para>
  <para style="q1" vid="LAM 1:6">но вийышт пытен.<verse eid="LAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />Ойган, кусныл коштмо кечылаштыже</para>
  <para style="q2" vid="LAM 1:7">Иерусалим ончычсо суапшым шарналта.</para>
  <para style="q1" vid="LAM 1:7">Кунам калыкше тушман кидыш логалын,</para>
  <para style="q1" vid="LAM 1:7">нигӧ тудлан полшен огыл.</para>
  <para style="q1" vid="LAM 1:7">Тушман-влак ӱмбакше онченыт,</para>
  <para style="q1" vid="LAM 1:7">сеҥалтмыжым ужын, воштылыныт.<verse eid="LAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />Кугу сулыкыш пурен Иерусалим,</para>
  <para style="q1" vid="LAM 1:8">сандене шакшыш савырнен.</para>
  <para style="q1" vid="LAM 1:8">Кӧ тудым ончыч кугуэш ужын – кызыт койдара,</para>
  <para style="q1" vid="LAM 1:8">вет тудын чара улмыжым ужын.</para>
  <para style="q1" vid="LAM 1:8">Нелын шӱлештеш Иерусалим,</para>
  <para style="q1" vid="LAM 1:8">вожылмыж дене чурийжым савыра.<verse eid="LAM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />Вургемжым ару огыллыкшо амыртен.</para>
  <para style="q1" vid="LAM 1:9">Шонен огыл тудо ончыкылык нерген,</para>
  <para style="q1" vid="LAM 1:9">сандене сӱмырлымыжӧ чылаштым ӧрыктарен,</para>
  <para style="q1" vid="LAM 1:9">нигӧ уке тудым лыпландарыше.</para>
  <para style="q1" vid="LAM 1:9">«Господь, ончал мыйын орлыкем,</para>
  <para style="q1" vid="LAM 1:9">кузе тушманем вуйжым нӧлталын!»<verse eid="LAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />Мо лийын шерге тудлан, тушман чыла поген налын.</para>
  <para style="q1" vid="LAM 1:10">Ужеш тудо: йот калык еҥ-влак храмыш пуреныт,</para>
  <para style="q1" vid="LAM 1:10">а вет нуно Тыйын калыкет коклаште лийшаш огытыл.<verse eid="LAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />Киндым кычалын,</para>
  <para style="q2" vid="LAM 1:11">тудын калыкше йӧсын кечкыжеш,</para>
  <para style="q1" vid="LAM 1:11">илыше кодаш манын,</para>
  <para style="q2" vid="LAM 1:11">чыла мо шергаканжым кочкышлан вашталта.</para>
  <para style="q1" vid="LAM 1:11">«Ончал, Господь, ончал!</para>
  <para style="q1" vid="LAM 1:11">Могай мый мыскынь лийынам!»<verse eid="LAM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />«Воктеч эртен кайыше-влак,</para>
  <para style="q1" vid="LAM 1:12">тек тендан дене тыгае ок лий!</para>
  <para style="q1" vid="LAM 1:12">Ончалза да шекланыза –</para>
  <para style="q1" vid="LAM 1:12">уло мо орлык, мылам логалше дене икгай?</para>
  <para style="q1" vid="LAM 1:12">Йӱлышӧ шыдыжын кечынже</para>
  <para style="q2" vid="LAM 1:12">мылам тудым Господь колтен.<verse eid="LAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />Кӱшычын тулым колтен,</para>
  <para style="q1" vid="LAM 1:13">тудыжо эсогыл луэм авалтен!</para>
  <para style="q1" vid="LAM 1:13">Йолемлан Тудо вапшым шынден</para>
  <para style="q1" vid="LAM 1:13">да мыйым мӧҥгеш савырен.</para>
  <para style="q1" vid="LAM 1:13">Господь мыйым кудалтен коден,</para>
  <para style="q1" vid="LAM 1:13">кажне кечын мый улнем.<verse eid="LAM 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />Сулык-влакем Тудо кидышкыже налын,</para>
  <para style="q1" vid="LAM 1:14">нунын дене пидын мылам омытам.</para>
  <para style="q1" vid="LAM 1:14">Нуным, иктыш пунен, шӱйышкем пыштен,</para>
  <para style="q1" vid="LAM 1:14">вий-куат деч посна мыйым коден.</para>
  <para style="q1" vid="LAM 1:14">Господь мыйым тыгай-влакын кидышкышт пуэн,</para>
  <para style="q2" vid="LAM 1:14">кӧмыт ваштареш мый ом керт шоген.<verse eid="LAM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />Виян сарзем-влакым Господь</para>
  <para style="q2" vid="LAM 1:15">чылаштым нимош луктын,</para>
  <para style="q1" vid="LAM 1:15">самырык пӧръеҥ-влакемым пытараш</para>
  <para style="q2" vid="LAM 1:15">тушман-шамычым поген.</para>
  <para style="q1" vid="LAM 1:15">Виноградым тошкымо семын</para>
  <para style="q2" vid="LAM 1:15">Иуда ӱдырым Господь тошкен!<verse eid="LAM 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />Теве молан шортам мый,</para>
  <para style="q1" vid="LAM 1:16">шинчам гыч чарныде вӱд йога.</para>
  <para style="q1" vid="LAM 1:16">Лыпландарыше мый дечем умбалне,</para>
  <para style="q1" vid="LAM 1:16">уке чонемым ылыжтарыше.</para>
  <para style="q1" vid="LAM 1:16">Уке йочам-влакын ончыкылыкышт,</para>
  <para style="q1" vid="LAM 1:16">вет мыйым тушман сеҥен».<verse eid="LAM 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />Шуя шке кидшым Сион,</para>
  <para style="q1" vid="LAM 1:17">но уке тудым лыпландарыше.</para>
  <para style="q1" vid="LAM 1:17">Иаков шотышто Господь тыге кӱштен:</para>
  <para style="q1" vid="LAM 1:17">тек пошкудо калык-влак тудлан тушман лийыт.</para>
  <para style="q1" vid="LAM 1:17">Иерусалим нунын коклаште амырген.<verse eid="LAM 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />«Чын ыштен Господь,</para>
  <para style="q1" vid="LAM 1:18">вет мый Тудын кӱштымыж ваштареш шогенам.</para>
  <para style="q1" vid="LAM 1:18">Колыштса, чыла калык-влак,</para>
  <para style="q1" vid="LAM 1:18">мыйын орлыкем ӱмбак ончалза:</para>
  <para style="q1" vid="LAM 1:18">ӱдыр ден рвезе-влакем наҥгаеныт,</para>
  <para style="q1" vid="LAM 1:18">нуно пленыште улыт.<verse eid="LAM 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />Йолташ-влакем ӱжынам,</para>
  <para style="q1" vid="LAM 1:19">но нуно мыйым ондаленыт.</para>
  <para style="q1" vid="LAM 1:19">Иерей ден кугурак-влакем</para>
  <para style="q2" vid="LAM 1:19">олаште шужен коленыт,</para>
  <para style="q1" vid="LAM 1:19">илыше кодаш манын,</para>
  <para style="q2" vid="LAM 1:19">шкаланышт кочкышым кычалыныт гынат.<verse eid="LAM 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />Ончал, Господь, кузе мый орланем:</para>
  <para style="q1" vid="LAM 1:20">кӧргыштем чыла йӱла,</para>
  <para style="q1" vid="LAM 1:20">шӱмем вургыжеш,</para>
  <para style="q1" vid="LAM 1:20">вет Тыйын ваштареш чот шогенам.</para>
  <para style="q1" vid="LAM 1:20">Уремыште керде пытарен кая,</para>
  <para style="q1" vid="LAM 1:20">а пӧртыштӧ колымаш вуча.<verse eid="LAM 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />Тушман-влак колыт йӧсын кечкыжмем,</para>
  <para style="q1" vid="LAM 1:21">но уке мыйым лыпландарыше!</para>
  <para style="q1" vid="LAM 1:21">Орлыкем нерген нуно колыт</para>
  <para style="q1" vid="LAM 1:21">да тидым Тыйын ыштыметлан куанат.</para>
  <para style="q1" vid="LAM 1:21">Тек Тыйын сӧрымӧ кечет толеш –</para>
  <para style="q1" vid="LAM 1:21">тек нунат мый гаемак лийыт!<verse eid="LAM 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />Тек нунын чыла осал пашашт</para>
  <para style="q2" vid="LAM 1:22">Тыйын шинча ончылнет лиеш.</para>
  <para style="q1" vid="LAM 1:22">Кузе Тый сулыкемлан мыйым мут кучаш шогалтенат,</para>
  <para style="q1" vid="LAM 1:22">нунын денат тугак ыште.</para>
  <para style="q1" vid="LAM 1:22">Мучаш уке кечкыжмемлан,</para>
  <para style="q1" vid="LAM 1:22">чонемже мыйын улнен».<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="cl">2 ГЛАВА</para>
  <para style="cd">Господь Иерусалимым мут кучаш шогалта.</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />О, Господь шке шыдыж дене</para>
  <para style="q2" vid="LAM 2:1">Сион ӱдырым пычкемышыш сӱмырал шуэн!</para>
  <para style="q1" vid="LAM 2:1">Израильын моторжым</para>
  <para style="q2" vid="LAM 2:1">кава гыч мландыш кудалтен,</para>
  <para style="q1" vid="LAM 2:1">шке шыдыжын кечынже Тудо</para>
  <para style="q2" vid="LAM 2:1">йол шындыме вержым шарналтен огыл!<verse eid="LAM 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />Иаковын илыме верлажым</para>
  <para style="q2" vid="LAM 2:2">Господь чаманыде пытарен,</para>
  <para style="q1" vid="LAM 2:2">Иуда ӱдырын карманже-влакым</para>
  <para style="q2" vid="LAM 2:2">шыдыж дене шалатен, мландымбак сӱмырен.</para>
  <para style="q1" vid="LAM 2:2">Уло кугыжанышым да онжо-влакым</para>
  <para style="q2" vid="LAM 2:2">Тудо намысыш пуртен,<verse eid="LAM 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />Израильын чыла тӱкыжым</para>
  <para style="q2" vid="LAM 2:3">йӱлышӧ шыдыж дене шалатен.</para>
  <para style="q1" vid="LAM 2:3">Шке кидшым Тудо кораҥден,</para>
  <para style="q1" vid="LAM 2:3">тушман деч аралымыжым чарнен.</para>
  <para style="q1" vid="LAM 2:3">Когартыше да йырым-йыр чыла пытарыше тул семын</para>
  <para style="q2" vid="LAM 2:3">Тудо Иаковым йӱлалтен!<verse eid="LAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />Господь шке пикшйоҥежшым чымалтарен,</para>
  <para style="q1" vid="LAM 2:4">тушман семын кидшым лӱяш виктарен.</para>
  <para style="q1" vid="LAM 2:4">Мо шинчам куандарен,</para>
  <para style="q1" vid="LAM 2:4">чыла пытарен,</para>
  <para style="q1" vid="LAM 2:4">Сион ӱдырын омашыже ӱмбак</para>
  <para style="q2" vid="LAM 2:4">шыдыжым тул семын йоктарен.<verse eid="LAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />Тушман семын лийын Господь,</para>
  <para style="q1" vid="LAM 2:5">Израильым Тудо пытарен!</para>
  <para style="q1" vid="LAM 2:5">Полатше-влакым шалатен,</para>
  <para style="q1" vid="LAM 2:5">карманже-шамычым сӱмырен,</para>
  <para style="q1" vid="LAM 2:5">Иуда ӱдырын уремлажым</para>
  <para style="q2" vid="LAM 2:5">мӱгырен шортмо йӱк дене темен!<verse eid="LAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />Шке пырдыжшым Тудо садым авырыше пырдыж семын шалатен,</para>
  <para style="q1" vid="LAM 2:6">шке погынымаш вержым сӱмырен шуэн!</para>
  <para style="q1" vid="LAM 2:6">Святой пайрем ден шуматкече-влакым</para>
  <para style="q2" vid="LAM 2:6">Господь Сионышто мондыктен,</para>
  <para style="q1" vid="LAM 2:6">кугун шыдешкымыж дене Тудо</para>
  <para style="q2" vid="LAM 2:6">кугыжа ден иерейым Шкеж деч кораҥден.<verse eid="LAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />Шке жертвенникше дек Тудо тупынь савырнен,</para>
  <para style="q1" vid="LAM 2:7">святой вержым коден каен!</para>
  <para style="q1" vid="LAM 2:7">Полат-влакын пырдыжыштым</para>
  <para style="q2" vid="LAM 2:7">Господь тушман кидыш пуэн.</para>
  <para style="q1" vid="LAM 2:7">Господьын пӧртыштыжӧ тушман гӱжлен,</para>
  <para style="q1" vid="LAM 2:7">пуйто тудын пайрем!<verse eid="LAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />Шонен пыштен Господь</para>
  <para style="q2" vid="LAM 2:8">Сион ӱдырын пырдыжшым шалаташ –</para>
  <para style="q1" vid="LAM 2:8">висыме кандырам Тудо шуен,</para>
  <para style="q1" vid="LAM 2:8">пытарыме деч кидшым кучен огыл.</para>
  <para style="q1" vid="LAM 2:8">Башне ден пырдыж-влак шортыт,</para>
  <para style="q1" vid="LAM 2:8">нуно чыланат пырля сӱмырленыт!<verse eid="LAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />Капкаже-влак лыптырген волен шинчыныт,</para>
  <para style="q1" vid="LAM 2:9">тӱкылтыш-шамычшым Тудо шалатен кудалтен!</para>
  <para style="q1" vid="LAM 2:9">Кугыжам да он-влакым пленыш наҥгаеныт,</para>
  <para style="q1" vid="LAM 2:9">йот калык-шамыч коклаште нуно улыт.</para>
  <para style="q1" vid="LAM 2:9">Законым тетла огыт туныкто,</para>
  <para style="q1" vid="LAM 2:9">пророк-влаклан Господь кончымашым ок колто.<verse eid="LAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Сионын кугуракше-влак</para>
  <para style="q2" vid="LAM 2:10">мланде ӱмбалне шып шинчат,</para>
  <para style="q1" vid="LAM 2:10">вуйышкышт пуракым шавеныт,</para>
  <para style="q1" vid="LAM 2:10">ӱмбакышт чоштыра вургемым чиеныт.</para>
  <para style="q1" vid="LAM 2:10">Иерусалимын ӱдыржӧ-влак</para>
  <para style="q2" vid="LAM 2:10">вуйыштым кумык сакеныт.<verse eid="LAM 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />Шинчавӱд деч вудакаҥын шинчамже,</para>
  <para style="q1" vid="LAM 2:11">уло кӧргем йӱла,</para>
  <para style="q1" vid="LAM 2:11">шӱмем кӱрышталтеш –</para>
  <para style="q1" vid="LAM 2:11">мыйын калыкем пыта!</para>
  <para style="q1" vid="LAM 2:11">Йоча ден изи аза-влак</para>
  <para style="q2" vid="LAM 2:11">ола уремлаште шужен колат!<verse eid="LAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />Шке аваштлан нуно ойлат:</para>
  <para style="q1" vid="LAM 2:12">«Кочмем шуэш, йӱмем шуэш!»</para>
  <para style="q1" vid="LAM 2:12">Сусыргышо семын нуно</para>
  <para style="q2" vid="LAM 2:12">ола уремлаште колат,</para>
  <para style="q1" vid="LAM 2:12">шке аваштын кидыште</para>
  <para style="q2" vid="LAM 2:12">пытартыш шӱлышышт лектеш.<verse eid="LAM 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />Мом мый тылат каласем,</para>
  <para style="q1" vid="LAM 2:13">мо дене тыйым таҥастарем, Иерусалим ӱдыр?</para>
  <para style="q1" vid="LAM 2:13">Тыйым лыпландараш манын,</para>
  <para style="q1" vid="LAM 2:13">мо дене тыйым таҥастарем, Сион ӱдыр?</para>
  <para style="q1" vid="LAM 2:13">Тыйын сусырет теҥыз гай келге,</para>
  <para style="q1" vid="LAM 2:13">кӧ тыйым паремден кертеш?<verse eid="LAM 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />Яра, шояк кончымашым тылат</para>
  <para style="q2" vid="LAM 2:14">пророк-влакет увертареныт.</para>
  <para style="q1" vid="LAM 2:14">Сулыкет-влакым нуно тылат ончыктен огытыл,</para>
  <para style="q1" vid="LAM 2:14">уке гын плен деч утарен кодат ыле.</para>
  <para style="q1" vid="LAM 2:14">Пророк шомакышт лийын шоя,</para>
  <para style="q2" vid="LAM 2:14">тыйым ондален наҥгайыше.<verse eid="LAM 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />Воктеч эртен кайыше-влак, тыйым ужын,</para>
  <para style="q1" vid="LAM 2:15">кидышт дене лупшалыт,</para>
  <para style="q1" vid="LAM 2:15">Иерусалим ӱдыр ӱмбак ончен,</para>
  <para style="q1" vid="LAM 2:15">ӧрын шӱшкалтат да вуйыштым рӱзалтен каласат:</para>
  <para style="q1" vid="LAM 2:15">«Тиде олам огыл мо ”эн сӧрал да чевер,</para>
  <para style="q2" vid="LAM 2:15">уло тӱнян куанже” манын лӱмденыт?»<verse eid="LAM 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />Тушманет-влак тыйым мыскылаш</para>
  <para style="q2" vid="LAM 2:16">почыныт умшаштым,</para>
  <para style="q1" vid="LAM 2:16">чушлат да пӱйыштым пурын ойлат:</para>
  <para style="q1" vid="LAM 2:16">«Ме тудым пытарышна!</para>
  <para style="q1" vid="LAM 2:16">Тиде кечым ме кужун вучышна,</para>
  <para style="q1" vid="LAM 2:16">теве ынде вучен шуктышна!»<verse eid="LAM 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />Господь мом шонен пыштымыжым ыштен,</para>
  <para style="q1" vid="LAM 2:17">мом ожнак увертарен, тиде шомакшым шуктен.</para>
  <para style="q1" vid="LAM 2:17">Тудо тыйым чаманыде шалатен,</para>
  <para style="q1" vid="LAM 2:17">сеҥалтмет дене тушманетым куандарен,</para>
  <para style="q1" vid="LAM 2:17">нунын тӱкыштым нӧлталын.<verse eid="LAM 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />Уло шӱм-чон дене еҥ-влак</para>
  <para style="q2" vid="LAM 2:18">Господьым ӱжын кычкырат.<note caller="*" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Тидым вес семынат умылаш лиеш: «Уло шӱм-чонет дене Господьым ӱжын кычкыре!»</char></note></para>
  <para style="q1" vid="LAM 2:18">О, Сион ӱдырын пырдыжше!</para>
  <para style="q1" vid="LAM 2:18">Эҥер семын йӱдшӧ-кечыже</para>
  <para style="q2" vid="LAM 2:18">шинчавӱдым йоктаре,</para>
  <para style="q1" vid="LAM 2:18">ик татланат ит чарне,</para>
  <para style="q1" vid="LAM 2:18">шинчатлан канышым ит пу!<verse eid="LAM 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />Кынел, йӱдым кажне орол черет тӱҥалтыште<note caller="*" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Йӱд орол черет – Израильыште йӱдым кум орол черетлан шелыныт.</char></note> ӱжын кычкыре!</para>
  <para style="q1" vid="LAM 2:19">Господь чурий ончылно поч шӱм-чонетым!</para>
  <para style="q1" vid="LAM 2:19">Тудын деке кидетым нӧлтал,</para>
  <para style="q1" vid="LAM 2:19">йочат-влак илыше кодышт манын кумал,</para>
  <para style="q1" vid="LAM 2:19">вет нуно кажне урем лукышто шужен лунчыргат.<verse eid="LAM 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />«Ончал, Господь, ончал:</para>
  <para style="q1" vid="LAM 2:20">кӧлан Тый иктаж-кунам тыгайым ыштенат?</para>
  <para style="q1" vid="LAM 2:20">Ава-влак шке азаштым кочкыт,</para>
  <para style="q2" vid="LAM 2:20">кӧмытым йӧратен ончен пукшеныт!</para>
  <para style="q1" vid="LAM 2:20">Господьын святой верыштыже</para>
  <para style="q2" vid="LAM 2:20">иерей ден пророк-влакым пуштедат!<verse eid="LAM 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />Йоча ден шоҥгыеҥ-шамыч</para>
  <para style="q2" vid="LAM 2:21">уремлаште пуракыште кият,</para>
  <para style="q1" vid="LAM 2:21">ӱдыр ден рвезе-влакемым</para>
  <para style="q2" vid="LAM 2:21">керде пытарен.</para>
  <para style="q1" vid="LAM 2:21">Шыдетын кечынже Тый нуным пуштынат,</para>
  <para style="q1" vid="LAM 2:21">чаманыде шӱшкылынат.<verse eid="LAM 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />Пайремыш ӱжмӧ семын мыйын ӱмбакем</para>
  <para style="q2" vid="LAM 2:22">Тый шучкылыкым чыла велым ӱжынат.</para>
  <para style="q1" vid="LAM 2:22">Господьын шыдыжын кечынже</para>
  <para style="q2" vid="LAM 2:22">нигӧ утлен огыл, илыше кодын огыл.</para>
  <para style="q1" vid="LAM 2:22">Кӧм пукшенам, ончен куштенам –</para>
  <para style="q1" vid="LAM 2:22">тушманем чылаштым пытарен!»<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="cl">3 ГЛАВА</para>
  <para style="cd">Кеч-мыняр неле гынат, ӱшан садак уло.</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />Господьын шыдылык тояже мыйым кырен,</para>
  <para style="q1" vid="LAM 3:1">улам мый шуко орлыкым ужшо айдеме.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />Тудо мыйым наҥгаен</para>
  <para style="q1" vid="LAM 3:2">да волгыдыш огыл, а пычкемышыш пуртен.<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />Шке кидшым Тудо ӱмбакем виктарен,</para>
  <para style="q1" vid="LAM 3:3">кажне кечын тудым нӧлталеш.<verse eid="LAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />Капем ден коваштем лунчыртен,</para>
  <para style="q1" vid="LAM 3:4">луэмым пудыртен.<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />Мыйым йыр авырен налын,</para>
  <para style="q1" vid="LAM 3:5">кочо орлык дене авалтен.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />Пычкемыш верыш Тудо петырен шынден,</para>
  <para style="q1" vid="LAM 3:6">мый пуйто шукертак колышо-влак коклаште улам.<verse eid="LAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />Пырдыж дене авырен – ом керт мый лектын,</para>
  <para style="q1" vid="LAM 3:7">неле шинчыр дене мыйым кепшылтен.<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />Кычкырем, полышым йодам,</para>
  <para style="q1" vid="LAM 3:8">но ынеж кол Тудо кумалмем.<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />Кӱ-влак дене корнем петырен,</para>
  <para style="q1" vid="LAM 3:9">кайышаш йолгорнем гыч мыйым кораҥден.<verse eid="LAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />Лийын Тудо мыланем ваҥен шинчыше маска гай,</para>
  <para style="q2" vid="LAM 3:10">шылын шичше лев гай.<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />Корнем гыч мыйым кораҥден,</para>
  <para style="q1" vid="LAM 3:11">кӱрыштын да кудалтен коден.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />Чымалтарен Тудо йоҥежшым,</para>
  <para style="q1" vid="LAM 3:12">пикшыжлан мишеньым мыйым ыштен,<verse eid="LAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />шке лодакше гыч пикш-влакым вергышкем лӱен.<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />Лийынам мый уло калыкемлан воштылчык –</para>
  <para style="q1" vid="LAM 3:14">кажне кечын мыйым мыскылен мурат.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />Тудо мылам кочо шудым теммеш пукшен,</para>
  <para style="q1" vid="LAM 3:15">арымшудо вӱдым йӱктен.<verse eid="LAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />Кӱм пурыктен, пӱем пудыртен,</para>
  <para style="q1" vid="LAM 3:16">мыйым пуракыш тошкен.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />Йомдаренам чон ласкалыкым,</para>
  <para style="q1" vid="LAM 3:17">сай илышым монденам.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Тунам каласенам мый:</para>
  <para style="q1" vid="LAM 3:18">«Уке нимогай куатем, Господь мый дечем ӱшанем налын!»<verse eid="LAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />Шарналте мыйын орлыкем, перныл коштмем,</para>
  <para style="q1" vid="LAM 3:19">вет илышем – лач арымшудо да кочо орлык.<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />Чонем тидым сайын шарна,</para>
  <para style="q1" vid="LAM 3:20">мыйым шӱлык авалтен.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Но теве мом шӱмемлан ойлем,</para>
  <para style="q1" vid="LAM 3:21">теве мыйын инанымашем:<verse eid="LAM 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />Господьын порылыкшылан кӧра ме пытен огынал,</para>
  <para style="q1" vid="LAM 3:22">Тудын чаманымашыже иземын огыл!<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />Кажне эрдене Тудын порылыкшо уэмеш.</para>
  <para style="q1" vid="LAM 3:23">Ӱшанле улмет Тыйын кугу!<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />Чонемже ойла: Господь – мыйын ужашем,</para>
  <para style="q1" vid="LAM 3:24">Тудлан мый инанем!<verse eid="LAM 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />Тудым ӱшанен вучышо, Тудым кычалше еҥ деке</para>
  <para style="q2" vid="LAM 3:25">Господь поро лиеш.<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />Сай лиеш тудо еҥлан,</para>
  <para style="q2" vid="LAM 3:26">кӧ Господьын утарымашыжым чытен вуча.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />Сай лиеш тудо еҥлан,</para>
  <para style="q2" vid="LAM 3:27">кӧ самырык годсек омытам нумалеш.<note caller="*" style="f"><char style="fr" closed="false">3:27 </char><char style="ft" closed="false">Тыште мут колыштшо, шкенжым ӱҥышемден кертше еҥ нерген ойлалтеш.</char></note><verse eid="LAM 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Тек тудо шкетын шып шинча,</para>
  <para style="q1" vid="LAM 3:28">вет ӱмбакше омытам Господь пыштен.<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />Тек тудо кумык возеш, умшаж дене мланде дек пызна –</para>
  <para style="q1" vid="LAM 3:29">ала эше кодын ӱшан.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />Тек шӱргыжым совкалаш пуа,</para>
  <para style="q1" vid="LAM 3:30">шуко намысым чыта.<verse eid="LAM 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />Вет курымешлан огыл Господь коден каен,<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />кеч Тудо ойгым колтен,</para>
  <para style="q2" vid="LAM 3:32">варажым кугу порылыкшылан кӧра чамана.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />Вет Тудо шӱм кумылжо почеш огыл</para>
  <para style="q2" vid="LAM 3:33">айдеме эрге-влакым наказатла да ойгандара.<verse eid="LAM 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />А кунам эрык деч посна кодымо-влакым</para>
  <para style="q2" vid="LAM 3:34">йол дене тошкат,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />кунам Чыла деч Кӱшылысын чурийже ончылно</para>
  <para style="q2" vid="LAM 3:35">еҥым чын огыл судитлат,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />кунам судышто шыгыремдылыт,</para>
  <para style="q1" vid="LAM 3:36">чыла тидым Господь ок уж мо?<verse eid="LAM 3:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />Иктаж-кӧн каласымыже шукталтеш мо,</para>
  <para style="q2" vid="LAM 3:37">тидлан шукталташ Господь кӱштен огыл гын?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />Чыла деч Кӱшылысын шомакше почеш огыл мо</para>
  <para style="q2" vid="LAM 3:38">сайжат, осалжат толеш?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />Молан илыше айдеме вуйым шиеш,</para>
  <para style="q2" vid="LAM 3:39">кунам шке сулыкшылан мутым куча?<verse eid="LAM 3:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />Тергена, шымлена шке корнынам</para>
  <para style="q1" vid="LAM 3:40">да Господь дек савырнена!<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />Каваште улшо Юмо дек киднам нӧлталына,</para>
  <para style="q1" vid="LAM 3:41">шӱмнам савырена да каласена:<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />«Ме Тый дечет кораҥынна, ӱскырт лийынна,</para>
  <para style="q1" vid="LAM 3:42">да Тый языкнам кудалтен отыл.<verse eid="LAM 3:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />Леведалтынат Тый шыде дене,</para>
  <para style="q1" vid="LAM 3:43">мемнам поктенат, чаманыде пытаренат.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Кумалмына Тый декет ынже шу манын,</para>
  <para style="q1" vid="LAM 3:44">Шкендым пыл дене леведынат.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />Калык-влак коклаште мемнам</para>
  <para style="q2" vid="LAM 3:45">шӱкшакыш, лавыраш савыренат.<verse eid="LAM 3:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />Чыла тушманна мемнан ӱмбак умшаштым кареныт.<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />Шучкылык ден вынем, пустаҥмаш ден пытымаш –</para>
  <para style="q1" vid="LAM 3:47">теве мо мемнан дене лийын!»<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />Шинчам гыч эҥер семын вӱд йога,</para>
  <para style="q1" vid="LAM 3:48">вет мыйын калыкем пыта!<verse eid="LAM 3:48" /></para>
  <para style="q1">
    <verse number="49-50" style="v" sid="LAM 3:49-50" />Господьын ончалмешкыже,</para>
  <para style="q1" vid="LAM 3:49-50">кава гычын ужмешкыже,</para>
  <para style="q1" vid="LAM 3:49-50">шинчам гыч вӱд йогаш тӱҥалеш, ик татланат ок чарне.<verse eid="LAM 3:49-50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Ончем мый, да оламын ӱдыржӧ-влак верч</para>
  <para style="q2" vid="LAM 3:51">чонемым ойго авалта.<verse eid="LAM 3:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />Мыйым, пуйто кайыкым, кучаш тӧченыт,</para>
  <para style="q1" vid="LAM 3:52">амал деч посна тушманем-влак поктеныт.<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />Мыйым илышынек вынемыш кудалтеныт,</para>
  <para style="q1" vid="LAM 3:53">ӱмбакем кӱм кышкеныт.<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />Вуем деч кӱшкӧ вӱд нӧлталтын,</para>
  <para style="q1" vid="LAM 3:54">да мый шоналтышым: «Толын мыланем мучаш!»<verse eid="LAM 3:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />Келге вынем гыч, Господь,</para>
  <para style="q1" vid="LAM 3:55">мый лӱметым ӱжынам.<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />Колынат Тый мыйын йӱкем;</para>
  <para style="q1" vid="LAM 3:56">ит петыре пылышетым полышым йодын кумалмем деч!<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />Кунам мый Тыйым ӱжын кумалынам,</para>
  <para style="q1" vid="LAM 3:57">лишемынат да ойленат: «Ит лӱд».<verse eid="LAM 3:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />Тый мыйым, Господь, пыдалынат,</para>
  <para style="q1" vid="LAM 3:58">чонемым сулен налынат.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />Господь, Тый мыйым шыгыремдымым ужат –</para>
  <para style="q1" vid="LAM 3:59">мылам чын судым ыште.<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />Палет Тый нунын ӱчым шуктышо кумылыштым,</para>
  <para style="q2" vid="LAM 3:60">мылам осалым ышташ шонымыштым.<verse eid="LAM 3:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />Ужат Тый, Господь, нунын мыскылымыштым,</para>
  <para style="q2" vid="LAM 3:61">мылам осалым ышташ шонымыштым,<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />кузе тушманем-влак кажне кечын</para>
  <para style="q2" vid="LAM 3:62">мыйын ваштареш осал чоям кутырат.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />Ончал: шинчат нуно але шогат –</para>
  <para style="q1" vid="LAM 3:63">шке мурыштышт мыйым мыскылен мурат.<verse eid="LAM 3:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />Пӧртылтӧ нунылан, Господь,</para>
  <para style="q2" vid="LAM 3:64">кидыштын пашашт почеш,<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />колто уш аҥыргымашым,</para>
  <para style="q1" vid="LAM 3:65">ӱмбакышт – шке каргымашетым!<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />Господь, поктен кай нуным шыдет дене,</para>
  <para style="q1" vid="LAM 3:66">кава йымач пытаре!<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="cl">4 ГЛАВА</para>
  <para style="cd">Шалатыме Иерусалим.</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />О, кузе шӧртньӧ йолгыжмыжым чарнен,</para>
  <para style="q1" vid="LAM 4:1">эн чапле шӧртньӧ вашталтын!</para>
  <para style="q1" vid="LAM 4:1">Святой верын кӱжӧ-влакым</para>
  <para style="q2" vid="LAM 4:1">кажне урем лукышто кышкен пытарыме.<verse eid="LAM 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />Сионын шергакан эргыже-влак ондак</para>
  <para style="q2" vid="LAM 4:2">эн яндар шӧртньӧ семын аклалтыныт,</para>
  <para style="q1" vid="LAM 4:2">а кызыт нуным шун ате,</para>
  <para style="q2" vid="LAM 4:2">кӧршӧкым ыштышын атыже семын аклат!<verse eid="LAM 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />Тулпире-влакат шке игыштлан</para>
  <para style="q2" vid="LAM 4:3">чызыштым пуат да нуным пукшат,</para>
  <para style="q1" vid="LAM 4:3">а калыкемын ӱдыржӧ-влак</para>
  <para style="q2" vid="LAM 4:3">ир мландысе страус гай шӱмдымӧ лийыныт.<verse eid="LAM 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />Изи азан йылмыже йӱмӧ шумо деч</para>
  <para style="q2" vid="LAM 4:4">умшаношмыш пижын шинчын,</para>
  <para style="q1" vid="LAM 4:4">йоча-влак киндым йодыт,</para>
  <para style="q1" vid="LAM 4:4">но нигӧ нунылан тудым ок пу.<verse eid="LAM 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />Эре пайрем сийым кочшо-влак</para>
  <para style="q2" vid="LAM 4:5">кызыт уремыште шужен лунчыргат,</para>
  <para style="q1" vid="LAM 4:5">чапле вургемым чиен тунемше-влак</para>
  <para style="q2" vid="LAM 4:5">шӱкшакыште пургедыт.<verse eid="LAM 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />Калыкемым наказатлымаш</para>
  <para style="q2" vid="LAM 4:6">Содомым сулыкшылан наказатлымаш деч кугурак –</para>
  <para style="q1" vid="LAM 4:6">тудыжо ик татыште сӱмырен кудалтыме лийын</para>
  <para style="q2" vid="LAM 4:6">айдеме кид тӱкнымӧ деч посна.<verse eid="LAM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />Сионын лӱмлӧ онжо-влак лум деч волгыдырак,</para>
  <para style="q2" vid="LAM 4:7">шӧр деч ошырак лийыныт,</para>
  <para style="q1" vid="LAM 4:7">капкылышт коралл деч чеверрак,</para>
  <para style="q2" vid="LAM 4:7">сынышт дене сапфир гай лийыныт.<verse eid="LAM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />А кызыт шӱч деч шеме улыт –</para>
  <para style="q1" vid="LAM 4:8">уремлаште нуным огыт пале,</para>
  <para style="q1" vid="LAM 4:8">коваштышт лу деке пижын шинчын,</para>
  <para style="q1" vid="LAM 4:8">кошкышо пушеҥге гай лийын.<verse eid="LAM 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />Керде деч колышо-влак</para>
  <para style="q2" vid="LAM 4:9">шужен колышо-шамыч деч пиаланрак улыт,</para>
  <para style="q1" vid="LAM 4:9">вет пасу лектыш укелан кӧра</para>
  <para style="q2" vid="LAM 4:9">нуно мерчен пытат.<verse eid="LAM 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />Ныжылге шӱман ава-влак йочаштым</para>
  <para style="q2" vid="LAM 4:10">шке кидышт дене шолтеныт,</para>
  <para style="q1" vid="LAM 4:10">калыкем пытарыме жапыште</para>
  <para style="q2" vid="LAM 4:10">аза-влак нунылан кочкыш лийыныт.<verse eid="LAM 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />Господь шке шыдыжым пӱтынек йоктарен,</para>
  <para style="q1" vid="LAM 4:11">кугу шыдыжым кышкалын.</para>
  <para style="q1" vid="LAM 4:11">Сионышто тулым ылыжтен,</para>
  <para style="q1" vid="LAM 4:11">тудыжо негыз марте чыла йӱлалтен.<verse eid="LAM 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />Калыкнам поктылшо тушман</para>
  <para style="q2" vid="LAM 4:12">Иерусалимын капкашкыже пурен кертеш манын,</para>
  <para style="q1" vid="LAM 4:12">мландымбалысе кугыжа-влакат,</para>
  <para style="q2" vid="LAM 4:12">тӱняште чыла илыше-шамычат ӱшанен огытыл.<verse eid="LAM 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />Чыла тиде пророкшо-влакын сулыкыштлан,</para>
  <para style="q2" vid="LAM 4:13">иерейже-шамычын осал пашаштлан кӧра лийын –</para>
  <para style="q1" vid="LAM 4:13">нуно чын ыштыше-влакын вӱрыштым</para>
  <para style="q2" vid="LAM 4:13">Иерусалимыште йоктареныт.<verse eid="LAM 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />Сокыр семын нуно</para>
  <para style="q2" vid="LAM 4:14">уремлаште перныл коштыныт,</para>
  <para style="q1" vid="LAM 4:14">лийыныт вӱр дене амыргыше,</para>
  <para style="q2" vid="LAM 4:14">вургемышт дек нигӧ тӱкнен кертын огыл.<verse eid="LAM 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />Кычкыреныт нунылан: «Кораҥза, ару огыл-влак!</para>
  <para style="q1" vid="LAM 4:15">Кораҥза, ида тӱкнӧ!»</para>
  <para style="q1" vid="LAM 4:15">Тунам нуно каеныт, перныл коштыныт,</para>
  <para style="q1" vid="LAM 4:15">йот калык-влакат «тышан ынышт код» манын ойленыт.<verse eid="LAM 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />Господь Шкежак нуным шалатен колтен,</para>
  <para style="q1" vid="LAM 4:16">ынде ок ончал ӱмбакышт,</para>
  <para style="q1" vid="LAM 4:16">вет иерей-влак дек уке пагалымаш,</para>
  <para style="q1" vid="LAM 4:16">кугурак-шамыч деке – шотлымаш!<verse eid="LAM 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />Полышым арам вучен,</para>
  <para style="q2" vid="LAM 4:17">мемнан шинчана ноен.</para>
  <para style="q1" vid="LAM 4:17">Орол башньыште вученна калыкым,</para>
  <para style="q2" vid="LAM 4:17">кудыжо мемнам утарен кертын огыл.<verse eid="LAM 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />Кажне ошкылнам тушман эскерен,</para>
  <para style="q1" vid="LAM 4:18">шкенан урем дене ме коштын кертын огынал.</para>
  <para style="q1" vid="LAM 4:18">Мучаш лишне, пытартыш кечына лишемын,</para>
  <para style="q1" vid="LAM 4:18">мучаш толын мыланна!<verse eid="LAM 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />Мемнам поктылшо-влак лийыныт</para>
  <para style="q2" vid="LAM 4:19">кавасе куткыж деч писырак,</para>
  <para style="q1" vid="LAM 4:19">поктен каеныт курыклаште,</para>
  <para style="q1" vid="LAM 4:19">ир мландыште мемнам ваҥеныт.<verse eid="LAM 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />Господьын шӱрен палемдыме еҥже –</para>
  <para style="q2" vid="LAM 4:20">илышнан шӱлышыжӧ – вынемышкышт логалын!</para>
  <para style="q1" vid="LAM 4:20">А ме тудын нерген ойленна:</para>
  <para style="q1" vid="LAM 4:20">«Йот калык коклаште тудо мемнам арален кода!»<verse eid="LAM 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />Куане да веселитле, Едом ӱдыр,</para>
  <para style="q2" vid="LAM 4:21">Уц мландыште илыше!</para>
  <para style="q1" vid="LAM 4:21">Но шыдылык чаше миен шуэш тый декетат,</para>
  <para style="q1" vid="LAM 4:21">руштмешке йӱат тый да чаралыкет почат!<verse eid="LAM 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />Сион ӱдыр! Мут кучымо жапет вашке пыта,</para>
  <para style="q1" vid="LAM 4:22">пленыште лийметлан Господь мучашым пышта.</para>
  <para style="q1" vid="LAM 4:22">А тыйым, Едом ӱдыр, осал пашатлан наказатла</para>
  <para style="q1" vid="LAM 4:22">да чыла сулыкетым почеш!<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="cl">5 ГЛАВА</para>
  <para style="cd">Господь утарен кодыжо манын, Иерусалимын кумалмыже.</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />Шарналте, Господь, мо мемнан дене лийын,</para>
  <para style="q1" vid="LAM 5:1">ончал, кузе ме мыскылыме улына.<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />Мланде ден уло погына весе-влаклан логалын,</para>
  <para style="q1" vid="LAM 5:2">пӧртна – йот тукым еҥын кидыште.<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />Кодынна ме тулык, ача деч посна,</para>
  <para style="q1" vid="LAM 5:3">авана-влак лийыныт тулык вате.<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />Вӱднам ме тӱлен йӱына,</para>
  <para style="q1" vid="LAM 5:4">шкенан пунам оксала налына.<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />Шӱйышкына шинчын, мемнам поктылыт –</para>
  <para style="q1" vid="LAM 5:5">неле паша дене индырат, огыт пу шӱлалташат.<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />Кочкаш киндым йодын,</para>
  <para style="q2" vid="LAM 5:6">Египет ден Ассирий дек киднам шуена.<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />Сулыкым ыштеныт ача-кочана-влак,</para>
  <para style="q1" vid="LAM 5:7">нуно кызыт уке улыт, а осал пашаштлан мутым ме кучена.<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />Кул-влак мемнан дене озаланат,</para>
  <para style="q1" vid="LAM 5:8">кидышт деч утарыше нигӧ уке.<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />Кинде лийже манын, илышнамат огына чамане,</para>
  <para style="q1" vid="LAM 5:9">ир мландыште мемнам керде ваҥа.<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />Кугу шужымаш деч коваштына когарген,</para>
  <para style="q1" vid="LAM 5:10">ме пуйто коҥгаште йӱлена.<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />Вате-влакым намыслат Сионышто,</para>
  <para style="q1" vid="LAM 5:11">ӱдыр-влакым Иуда мландысе олалаште виешлат.<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />Он-шамычым сакен пуштыныт,</para>
  <para style="q1" vid="LAM 5:12">кугурак-влак деке уке пагалымаш.<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />Самырык еҥ-влак вакшкӱ дене йоҥыштат,</para>
  <para style="q1" vid="LAM 5:13">рвезе-шамыч пум нумалшыштла камвозыт.<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />Шоҥгыеҥ-влак капка воктене огыт шинче,</para>
  <para style="q1" vid="LAM 5:14">огыт муро тетла рвезе-влакат.<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />Шӱм-чонна гыч йомын куан,</para>
  <para style="q1" vid="LAM 5:15">куштымашым вашталтен ойгырымаш.<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />Камвозын вуйна гыч вуйшӱдыш –</para>
  <para style="q1" vid="LAM 5:16">ойго мыланна, ме сулыкыш пуренна!<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />Садланак чонна орлана,</para>
  <para style="q1" vid="LAM 5:17">теве молан шинчана вудакаҥын.<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />Сион курык пустаҥын,</para>
  <para style="q1" vid="LAM 5:18">тушто тулпире-влак коштыт.<verse eid="LAM 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />Тый, Господь, курымеш Кугыжа улат,</para>
  <para style="q1" vid="LAM 5:19">Тыйын престолет – тукым гыч тукымыш.<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />Молан Тый мемнам монденат,</para>
  <para style="q1" vid="LAM 5:20">кужу жаплан коден каенат?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />Пу мыланна Тый декет пӧртылаш, да ме пӧртылына.</para>
  <para style="q1" vid="LAM 5:21">О, Господь, ончычсо гай кече-влакым угыч пу мыланна!<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />Йӧршешлан мо мемнам Шке дечет кораҥденат,</para>
  <para style="q1" vid="LAM 5:22">уке мо шыдетлан мучаш?<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>