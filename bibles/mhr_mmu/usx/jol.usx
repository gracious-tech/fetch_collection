<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Meadow Mari Bible</book>
  <para style="h">Иоиль</para>
  <para style="toc3">Иоиль</para>
  <para style="toc2">Иоиль</para>
  <para style="toc1">Пророк Иоильын книгаже</para>
  <para style="mt">ПРОРОК ИОИЛЬЫН КНИГАЖЕ</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="cl">1 ГЛАВА</para>
  <para style="cd">1 Элыш шурнышырчык-влак толыт да чыла кушкылым пытарат. 13 Пророк уло калыкым кумалаш ӱжеш.</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Иоильлан, Вафуил эргылан, Господь деч тыгай шомак лийын.<verse eid="JOL 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Колыштса, калык кугурак-влак,</para>
  <para style="q1" vid="JOL 1:2">тӱткӧ лийза, тиде мландыште илыше-шамыч!</para>
  <para style="q1" vid="JOL 1:2">Тендан илыме кечылаште але ача-кочадан илымышт годым</para>
  <para style="q2" vid="JOL 1:2">тыгае лийын мо?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Каласкалыза тидын нерген йочада-влаклан,</para>
  <para style="q1" vid="JOL 1:3">йочада-шамыч тек шке икшывыштлан каласкалат,</para>
  <para style="q1" vid="JOL 1:3">а нунышт – вес тукымлан.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Мо шукш деч кодын,</para>
  <para style="q1" vid="JOL 1:4">тудым шудышырчык кочкын,</para>
  <para style="q1" vid="JOL 1:4">мо шудышырчык деч кодын,</para>
  <para style="q1" vid="JOL 1:4">тудым шурнышырчык рожген,</para>
  <para style="q1" vid="JOL 1:4">а шурнышырчык деч кодшым копшаҥге пытарен.<verse eid="JOL 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Помыжалтса, йӱшӧ-влак, да шортса,</para>
  <para style="q1" vid="JOL 1:5">йошкар аракам йӱаш йӧратыше-шамыч, магырыза,</para>
  <para style="q1" vid="JOL 1:5">вет виноград вӱд умшашкыда тетла ок логал!<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Мыйын мландышкем калык толын –</para>
  <para style="q1" vid="JOL 1:6">виян, шотлен пытарыдыме.</para>
  <para style="q1" vid="JOL 1:6">Тудын пӱйжӧ – левын пӱйжӧ гай,</para>
  <para style="q1" vid="JOL 1:6">азупӱйжӧ – ава левын гай.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Тудо виноград вондерем пытарен,</para>
  <para style="q1" vid="JOL 1:7">смоква пушеҥгем тодыштын:</para>
  <para style="q1" vid="JOL 1:7">шӱмжым тӧргалтен, тудым чарам коден,</para>
  <para style="q1" vid="JOL 1:7">укшыжо-влак ошемыныт.<verse eid="JOL 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Колышо качыже шотышто магырыше,</para>
  <para style="q2" vid="JOL 1:8">чоштыра вургемым чийыше оръеҥ семын шорт!<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Кинде надыр ден йошкар арака надырым</para>
  <para style="q2" vid="JOL 1:9">Господьын пӧртыш тетла огыт кондо,</para>
  <para style="q1" vid="JOL 1:9">иерей-влак, Господьлан служитлыше-шамыч, ойгырат.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Пасу-влак пустаҥыныт, мланде ойгыра,</para>
  <para style="q1" vid="JOL 1:10">вет шурным пытареныт,</para>
  <para style="q1" vid="JOL 1:10">виноград кошкен, олив ӱй пытен.<verse eid="JOL 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Вуйдам сакыза, мланде пашаеҥ-влак,</para>
  <para style="q1" vid="JOL 1:11">виноградым ончышо-шамыч, ойгаҥза!</para>
  <para style="q1" vid="JOL 1:11">Вет шыдаҥ ден шож уке,</para>
  <para style="q1" vid="JOL 1:11">уке лектыш пасулаште.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Виноград вондо ден смоква пушеҥге кошкеныт,</para>
  <para style="q1" vid="JOL 1:12">гранат, пальме, олмапу – чыла лывыжген,</para>
  <para style="q1" vid="JOL 1:12">айдеме эрге-влакын куаныштлан толын мучаш.<verse eid="JOL 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Иерей-влак, чоштыра вургемым чийыза да шортса,</para>
  <para style="q1" vid="JOL 1:13">жертвенник ончылно служитлыше-шамыч, магырыза!</para>
  <para style="q1" vid="JOL 1:13">Мыйын Юмемлан служитлыше-влак, толза</para>
  <para style="q1" vid="JOL 1:13">да чоштыра вургем дене йӱдлам эртарыза!</para>
  <para style="q1" vid="JOL 1:13">Вет кинде надыр ден йошкар арака надыр</para>
  <para style="q2" vid="JOL 1:13">Юмыдан пӧртыштыжӧ тетла уке.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Пӱтым кучаш палемдыза,</para>
  <para style="q1" vid="JOL 1:14">погынымашым увертарыза!</para>
  <para style="q1" vid="JOL 1:14">Господь Юмыдан пӧртышкыжӧ калык кугурак-влакым,</para>
  <para style="q2" vid="JOL 1:14">тиде мландыште илыше-шамычым погыза</para>
  <para style="q1" vid="JOL 1:14">да Господьым ӱжын кумалза.<verse eid="JOL 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />О, могай кече мемнам вуча!</para>
  <para style="q1" vid="JOL 1:15">Господьын кечыже лишне!</para>
  <para style="q1" vid="JOL 1:15">Толеш тудо Чылакертшын колтымо пытарымашыже семын.<verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Мемнан шинча ончылно кочкыш уке лийын,</para>
  <para style="q1" vid="JOL 1:16">Юмынан пӧртыштыжӧ куан ден веселалык йомыныт.<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Кукшо мландыште пырче кошкен,</para>
  <para style="q1" vid="JOL 1:17">клат-влак пустаҥыныт, амбар-шамыч шаланеныт,</para>
  <para style="q1" vid="JOL 1:17">вет шурно лектыш уке.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Кузе вольык йӧсланен ломыжеш!</para>
  <para style="q1" vid="JOL 1:18">Ушкал кӱтӱ-влак перныл коштыт,</para>
  <para style="q1" vid="JOL 1:18">вет шудо нунылан уке,</para>
  <para style="q1" vid="JOL 1:18">шорык кӱтӱ-влакат орланат.<verse eid="JOL 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />Тый дечет, Господь, полышым йодын кычкырем,</para>
  <para style="q1" vid="JOL 1:19">вет ир мландысе кӱтымӧ верлам тул йӱлалтен,</para>
  <para style="q1" vid="JOL 1:19">тушто чыла пушеҥгым тулйолкын пытарен.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Янлык-шамычат Тый дечет полышым йодын кычкырат,</para>
  <para style="q1" vid="JOL 1:20">вет вӱдйогын-влак кошкеныт,</para>
  <para style="q1" vid="JOL 1:20">ир мландысе кӱтымӧ верлам тул йӱлалтен.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="cl">2 ГЛАВА</para>
  <para style="cd">1 Шурнышырчык-влакын толмышт Господьын кечыже лишемме нерген шижтара. 12 Господь Юмыда дек савырныза – пӱтым кучыза, шортса, ойганыза! 18 Мланде лектышым Юмо угыч суапландара. 28 Юмо шке Шӱлышыжым чыла айдеме ӱмбак опталеш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />«Пучым пуалтыза Сионышто,</para>
  <para style="q1" vid="JOL 2:1">Мыйын святой курыкыштем тургыж йӱкым нӧлталза!</para>
  <para style="q1" vid="JOL 2:1">Тек мландымбалне илыше-влак чытырат,</para>
  <para style="q1" vid="JOL 2:1">вет Господьын кечыже толеш, тудо лишне –<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />рӱмбык да пычкемыш кече,</para>
  <para style="q1" vid="JOL 2:2">шем пылан, тӱп пычкемыш кече:</para>
  <para style="q1" vid="JOL 2:2">шуко чотан да виян сарзе калык</para>
  <para style="q2" vid="JOL 2:2">курыкла мучко эр ӱжара семын шарла.</para>
  <para style="q1" vid="JOL 2:2">Тыгайже ончыч лийын огыл</para>
  <para style="q1" vid="JOL 2:2">да тетла нигунам огеш лий.<verse eid="JOL 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Тудын ончылныжо тул пӧжга,</para>
  <para style="q1" vid="JOL 2:3">шеҥгелныже – когартыше тулйолкын.</para>
  <para style="q1" vid="JOL 2:3">Тудын ончылно мланде – пуйто Эдем сад,</para>
  <para style="q1" vid="JOL 2:3">а тудын деч вара – пустаҥдыме ир мланде.</para>
  <para style="q1" vid="JOL 2:3">Нимо тудын деч ок утаралт!<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Сынышт дене имньыла койыт,</para>
  <para style="q1" vid="JOL 2:4">имнян сарзывий семын нуно йортат.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Сарлык орва семын курык вуй ӱмбалне лӱшкен кудалыт,</para>
  <para style="q1" vid="JOL 2:5">олымым пӧжгышӧ тул семын чодыртатат,</para>
  <para style="q1" vid="JOL 2:5">пуйто кугу сарзывий рат дене кредалаш кая.<verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Нуным ужын, калык-влак чытырат,</para>
  <para style="q1" vid="JOL 2:6">чурийышт шапалга, ошемеш.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Кредалше-влак семын нуно куржыт,</para>
  <para style="q1" vid="JOL 2:7">лӱддымӧ сарзе-влак семын пырдыжыш кӱзат.</para>
  <para style="q1" vid="JOL 2:7">Кажныже ончыко тура кая,</para>
  <para style="q1" vid="JOL 2:7">корныж гыч огеш кораҥ.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Икте-весым огыт шӱкедыл,</para>
  <para style="q1" vid="JOL 2:8">кажныже шке корныж дене тура кая,</para>
  <para style="q1" vid="JOL 2:8">умдо-влак кокла гыч эртат,</para>
  <para style="q1" vid="JOL 2:8">нигӧ ок керт нуным чарен.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Ола ӱмбаке керылтыт,</para>
  <para style="q1" vid="JOL 2:9">пырдыжыш кержалтыт,</para>
  <para style="q1" vid="JOL 2:9">пӧрт ӱмбаке кӱзат,</para>
  <para style="q1" vid="JOL 2:9">вор семын окна гоч пурат.<verse eid="JOL 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />Нунын ончылно мланде лӱҥгалтеш, кава чытырна,</para>
  <para style="q1" vid="JOL 2:10">кече ден тылзе пычкемышалтыт,</para>
  <para style="q1" vid="JOL 2:10">шӱдыр-влакын чолгыжмышт ок кой.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />Тиде сарзывий ончылно Господьын йӱкшӧ шокта.</para>
  <para style="q1" vid="JOL 2:11">Тудын кугу армийже – шотлаш лийдыме,</para>
  <para style="q1" vid="JOL 2:11">шомакшым шуктышо-влак улыт куатан.</para>
  <para style="q1" vid="JOL 2:11">Господьын кечыже кугу да пеш шучко,</para>
  <para style="q1" vid="JOL 2:11">кӧ тудым чыта?<verse eid="JOL 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />Но эше кызытат Господь ойла:</para>
  <para style="q1" vid="JOL 2:12">уло шӱм-чон дене Мый декем савырныза –</para>
  <para style="q1" vid="JOL 2:12">кучыза пӱтым, шортса, ойганыза!»<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Вургемдам огыл, а шӱмдам кушкедса</para>
  <para style="q1" vid="JOL 2:13">да Господь Юмыда дек савырныза,</para>
  <para style="q1" vid="JOL 2:13">вет Тудо поро да чаманыше,</para>
  <para style="q1" vid="JOL 2:13">кужун чытыше да серлагыше,</para>
  <para style="q1" vid="JOL 2:13">туткарым колташ шонымыжым вашталташ ямде.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />Кӧ пала, ала Тудо чамана,</para>
  <para style="q1" vid="JOL 2:14">угыч тендам суапландара?</para>
  <para style="q1" vid="JOL 2:14">Тунам Господь Юмыланда пуышаш</para>
  <para style="q2" vid="JOL 2:14">кинде надыр ден йошкар арака надырда лиеш.<verse eid="JOL 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Сионышто пучым пуалтыза,</para>
  <para style="q1" vid="JOL 2:15">пӱтым кучаш палемдыза</para>
  <para style="q1" vid="JOL 2:15">да погынымашым увертарыза!<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Калыкым погыза да святитлыза –</para>
  <para style="q1" vid="JOL 2:16">шоҥгыеҥ-влакымат ӱжса,</para>
  <para style="q1" vid="JOL 2:16">йоча ден чызым кочшо аза-шамычымат кондыза.</para>
  <para style="q1" vid="JOL 2:16">Тек каче ден оръеҥат шке пӧлемышт гыч лектыт.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Тек иерей-влак, Господьлан служитлыше-влак,</para>
  <para style="q1" vid="JOL 2:17">храмыш пуртышо кыдеж ден жертвенник коклаште шортыт.</para>
  <para style="q1" vid="JOL 2:17">Тек нуно кычкырат:</para>
  <para style="q1" vid="JOL 2:17">«Господь, шке калыкетым чамане!</para>
  <para style="q1" vid="JOL 2:17">Тудым намысыш ит пурто,</para>
  <para style="q1" vid="JOL 2:17">вес калык-влаклан мыскылаш ит пу!</para>
  <para style="q1" vid="JOL 2:17">Тек калык-влак коклаште огыт ойло:</para>
  <para style="q1" vid="JOL 2:17">”Кушто нунын Юмышт?”»<verse eid="JOL 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Тунам Господьын чонжо шке мландыж верч йӱлаш тӱҥалеш,</para>
  <para style="q1" vid="JOL 2:18">да Тудо шке калыкшым чаманен налеш.<verse eid="JOL 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19" />Господь вашешта, шке калыкшылан каласа:</para>
  <para style="q1" vid="JOL 2:19">«Мый тыланда киндым, йошкар арака ден олив ӱйым колтем,</para>
  <para style="q1" vid="JOL 2:19">те теммеш кочкаш тӱҥалыда.</para>
  <para style="q1" vid="JOL 2:19">Тетла тендам вес калык-влаклан мыскылаш ом пу.<verse eid="JOL 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />Йӱдвел гыч толшо-влакым тендан деч кораҥдем</para>
  <para style="q1" vid="JOL 2:20">да кошкышо, пуста мландыш поктен колтем.</para>
  <para style="q1" vid="JOL 2:20">Ончыл рат-влакым эрвел теҥызыш,</para>
  <para style="q2" vid="JOL 2:20">а шеҥгелысе-влакым касвел теҥызыш<note caller="*" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">Эрвел теҥыз – Шинчалан теҥыз, Касвел теҥыз – Мландыкокла теҥыз.</char></note> кудалтем.</para>
  <para style="q1" vid="JOL 2:20">Нунын деч йыгыжге ӱпш лектеш,</para>
  <para style="q1" vid="JOL 2:20">шакше пуш нӧлталтеш,</para>
  <para style="q1" vid="JOL 2:20">вет нуно шуко осалым ыштеныт.<verse eid="JOL 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />Ит лӱд, мланде – куане, веселитле,</para>
  <para style="q1" vid="JOL 2:21">вет Господь кугу пашам ыштен!<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />Ида лӱд, янлык-влак,</para>
  <para style="q1" vid="JOL 2:22">вет ир мландыште шудо кушкеш,</para>
  <para style="q1" vid="JOL 2:22">пушеҥге-шамыч саскам кондат,</para>
  <para style="q1" vid="JOL 2:22">смоква пушеҥге ден виноград вондер</para>
  <para style="q2" vid="JOL 2:22">тӱвыргӧ лектышым пуат.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Те, Сионын йочаже-влак,</para>
  <para style="q1" vid="JOL 2:23">Господь Юмыланда куаныза, веселитлыза!</para>
  <para style="q1" vid="JOL 2:23">Тудо тыланда йӱрым шке жапыштыже пуа,</para>
  <para style="q1" vid="JOL 2:23">ончычсо семынак шыже ден шошо йӱрым колта.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Идым-влак шурно дене темыт,</para>
  <para style="q1" vid="JOL 2:24">виноград ден оливым темдыме вер-влак</para>
  <para style="q2" vid="JOL 2:24">виноград вӱд да олив ӱй дене тӱргоч темыт.<verse eid="JOL 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />Шукш ден шудышырчык, шурнышырчык ден копшаҥге</para>
  <para style="q2" vid="JOL 2:25">лектышдам ий гыч ийыш кочкыныт,</para>
  <para style="q1" vid="JOL 2:25">вет Мый нуным ӱмбакыда кугу сарзывий семын колтенам,</para>
  <para style="q1" vid="JOL 2:25">но нине ий-влаклан Мый тыланда чыла пӧртылтем.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Те теммеш кочкаш</para>
  <para style="q2" vid="JOL 2:26">да Господь Юмыдан лӱмжым чаплаш тӱҥалыда,</para>
  <para style="q1" vid="JOL 2:26">вет Тудо тыланда ӧрыктарыше паша-влакым ыштен.</para>
  <para style="q1" vid="JOL 2:26">Мыйын калыкем тетла нигунам намысыш ок пуро.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Тунам те пален налыда:</para>
  <para style="q1" vid="JOL 2:27">Мый Израиль калык коклаште илем,</para>
  <para style="q1" vid="JOL 2:27">Мый тендан Господь Юмыда улам,</para>
  <para style="q1" vid="JOL 2:27">моло вес Юмо уке.</para>
  <para style="q1" vid="JOL 2:27">Тетла Мыйын калыкем намысыш ок пуро.<verse eid="JOL 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />Тидын деч вара Мый</para>
  <para style="q1" vid="JOL 2:28">чыла еҥ ӱмбак Шӱлышем опталам.</para>
  <para style="q1" vid="JOL 2:28">Эрге ден ӱдырда пророклен ойлаш тӱҥалыт,</para>
  <para style="q1" vid="JOL 2:28">шоҥго пӧръеҥланда омо-влак кончат,</para>
  <para style="q1" vid="JOL 2:28">рвезе-влакда кончымашым ужыт.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Тудо кечылаште Мый Шӱлышем</para>
  <para style="q2" vid="JOL 2:29">пӧръеҥ ден ӱдырамаш тарзем-влак ӱмбакат опталам.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Каваште да мландымбалне ӧрыктарыше палым ончыктем:</para>
  <para style="q1" vid="JOL 2:30">вӱрым, тулым да шикш меҥгым.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Господьын кӱдыратле да шучко кечыже толмо деч ончыч</para>
  <para style="q1" vid="JOL 2:31">кече пычкемышалтеш, тылзе вӱрыш савырна.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />Полышым йодын, Господьын лӱмжым ӱжшӧ</para>
  <para style="q2" vid="JOL 2:32">кажне еҥ утарыме лиеш.</para>
  <para style="q1" vid="JOL 2:32">Господь каласыме семынак,</para>
  <para style="q1" vid="JOL 2:32">Сион курыкышто да Иерусалимыште утаралт кодшо-влак лийыт –</para>
  <para style="q1" vid="JOL 2:32">кӧм Господь ӱжеш, нуно утарыме лийыт.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="cl">3 ГЛАВА</para>
  <para style="cd">1 Калык-влакым судитлымаш. 17 Иуда калыкын ончыкылык илышыже сай да волгыдо лиеш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />Тудо кечылаште да тудо жапыште,</para>
  <para style="q1" vid="JOL 3:1">кунам Иуда ден Иерусалимым плен гыч пӧртылтем,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />Мый чыла моло калыкым погем,</para>
  <para style="q1" vid="JOL 3:2">нуным Иосафат<note caller="*" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">«Иосафат» лӱм ’Господь судитла’ манмым ончыкта.</char></note> лапверыш кондем.</para>
  <para style="q1" vid="JOL 3:2">Ойырен налме шке калыкем верч, Израиль верч,</para>
  <para style="q1" vid="JOL 3:2">тушто Мый нуным судитлаш тӱҥалам –</para>
  <para style="q1" vid="JOL 3:2">нуно Израильым калык-влак коклашке шалатеныт,</para>
  <para style="q1" vid="JOL 3:2">Мыйын мландем пайленыт.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Мыйын калыкем шотышто шеревам кышкеныт,</para>
  <para style="q1" vid="JOL 3:3">яжар ӱдырамашлан тӱлаш манын, рвезым пуэныт,</para>
  <para style="q1" vid="JOL 3:3">йошкар аракам йӱаш манын, изи ӱдырым ужаленыт.<verse eid="JOL 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 3:4" />Тир ден Сидон, филистим кундем,</para>
  <para style="q1" vid="JOL 3:4">мом те Мыйын ваштареш шонен пыштенда?</para>
  <para style="q1" vid="JOL 3:4">Мылам ӱчым шуктынеда?</para>
  <para style="q1" vid="JOL 3:4">Мылам мутым кучыктынеда гын,</para>
  <para style="q1" vid="JOL 3:4">Мый тудым куштылгын да вашке вуй ӱмбакыда пӧртылтем.<verse eid="JOL 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 3:5" />Те Мыйын ший ден шӧртнем налында,</para>
  <para style="q1" vid="JOL 3:5">эн чапле поянлыкем шке юмыдан пӧртлашкыже пуртенда.<verse eid="JOL 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 3:6" />Шочмо верышт гыч кораҥдаш манын,</para>
  <para style="q1" vid="JOL 3:6">Иуда ден Иерусалим эрге-влакым грек-влаклан ужаленда.<verse eid="JOL 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 3:7" />Но кушко те нуным ужален колтенда,</para>
  <para style="q1" vid="JOL 3:7">тушеч Мый нуным ӱжын кондем</para>
  <para style="q1" vid="JOL 3:7">да тыланда пашада почеш пӧртылтем:<verse eid="JOL 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 3:8" />эрге ден ӱдырда-влакым Иуда эрге-шамычлан ужалем,</para>
  <para style="q1" vid="JOL 3:8">а нунышт йочадам мӱндыр савей калыклан<note caller="*" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Савей калык – Аравийын кечывалвел ужашыштыже илыше калык, нуно торгаен иленыт.</char></note> ужалат.</para>
  <para style="q1" vid="JOL 3:8">Тыге Господь каласен.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Тидым калык-влак коклаште увертарыза,</para>
  <para style="q1" vid="JOL 3:9">сарлан ямдылалтса, тале салтак-шамычым кынелтыза!</para>
  <para style="q1" vid="JOL 3:9">Тек нуно лектыт, тек сарзе-влак каят!<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Шогавуйда гыч кердым,</para>
  <para style="q1" vid="JOL 3:10">сорлада гыч умдым таптен ыштыза.</para>
  <para style="q1" vid="JOL 3:10">Тек вийдыме каласа: ”Мый виян улам!”<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Йыр улшо калык-влак, вашкыза да погыныза,</para>
  <para style="q1" vid="JOL 3:11">чыла велым толза!»</para>
  <para style="q1" vid="JOL 3:11">Тушко, Господь, тале сарзет-влакым наҥгай!<verse eid="JOL 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />«Тек калык-влак тарванат</para>
  <para style="q1" vid="JOL 3:12">да Иосафат лапверыш волат.</para>
  <para style="q1" vid="JOL 3:12">Тушан Мый шинчам</para>
  <para style="q1" vid="JOL 3:12">да йыр улшо калык-влакым судитлаш тӱҥалам.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Сорла-влакым пашаш колтыза,</para>
  <para style="q1" vid="JOL 3:13">вет тӱредме жап шуын!</para>
  <para style="q1" vid="JOL 3:13">Кайыза, виноградым тошкыза,</para>
  <para style="q1" vid="JOL 3:13">вет тудым темдыме вер темын,</para>
  <para style="q1" vid="JOL 3:13">виноград вӱд тӱргоч йога.</para>
  <para style="q1" vid="JOL 3:13">Калык-влакын осал пашашт пеш кугу!»<verse eid="JOL 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Кугу тӱшка-влак, еҥ тӱшка-влак Суд лапверыште улыт!</para>
  <para style="q1" vid="JOL 3:14">Вет Господьын кечыже Суд лапвер деке чак лишемын!<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Кече ден тылзе пычкемышалтыт,</para>
  <para style="q1" vid="JOL 3:15">шӱдыр-влакын чолгыжмышт ок кой.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />Господь Сион гыч кӱдырта,</para>
  <para style="q1" vid="JOL 3:16">Иерусалим гыч шке йӱкшым пуа –</para>
  <para style="q1" vid="JOL 3:16">кава ден мланде чытырналтыт.</para>
  <para style="q1" vid="JOL 3:16">Но Господь шке калыкшылан аралтыш,</para>
  <para style="q1" vid="JOL 3:16">Израиль эрге-влаклан чоткыдо карман лиеш.<verse eid="JOL 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />«Тунам пален налыда:</para>
  <para style="q1" vid="JOL 3:17">Мый тендан Господь Юмыда улам,</para>
  <para style="q1" vid="JOL 3:17">Мый Сионышто, шке святой курыкыштем, илем.</para>
  <para style="q1" vid="JOL 3:17">Иерусалим святой вер лиеш,</para>
  <para style="q1" vid="JOL 3:17">тушко йот тукым сарзе-влак тетла огыт пуро.<verse eid="JOL 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />Тудо кечын тыге лиеш:</para>
  <para style="q1" vid="JOL 3:18">курыкла гыч виноград вӱд,</para>
  <para style="q2" vid="JOL 3:18">кӱкшакала гыч шӧр йогаш тӱҥалыт.</para>
  <para style="q1" vid="JOL 3:18">Иуда мландысе корем-влак вӱд дене темыт,</para>
  <para style="q1" vid="JOL 3:18">а Господьын пӧртшӧ гыч памаш лектеш</para>
  <para style="q1" vid="JOL 3:18">да Ситтим лапверым йӱкта.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Египет пустаҥеш,</para>
  <para style="q1" vid="JOL 3:19">Едом ир мландыш савырна,</para>
  <para style="q1" vid="JOL 3:19">вет нуно Иуда эрге-влакым шыгыремдылыныт,</para>
  <para style="q1" vid="JOL 3:19">нунын мландыштышт титакдыме вӱрым йоктареныт.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />А Иуда мландыште курым-курымеш,</para>
  <para style="q1" vid="JOL 3:20">Иерусалимыште тукым гыч тукымыш илаш тӱҥалыт.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Калыкемын вӱржӧ верч Мый ӱчым эше шуктен омыл,</para>
  <para style="q1" vid="JOL 3:21">но тидым ыштыде ом кодо.</para>
  <para style="q1" vid="JOL 3:21">Господь Сионышто илаш тӱҥалеш!»<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>