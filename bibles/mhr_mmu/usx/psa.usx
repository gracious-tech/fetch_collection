<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Meadow Mari Bible</book>
  <para style="h">Пс</para>
  <para style="toc3">Пс</para>
  <para style="toc2">Псалтирь</para>
  <para style="toc1">Псалтирь</para>
  <para style="mt">ПСАЛТИРЬ</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="cl">1 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Пиалан тудо еҥ,</para>
  <para style="q1" vid="PSA 1:1">кӧ осал еҥ-влакын каҥашышт почеш ок ыште,</para>
  <para style="q1" vid="PSA 1:1">сулыкан-шамычын корнышт дене ок кай</para>
  <para style="q1" vid="PSA 1:1">да мыскылен воштылшо-влакын погынымаштышт ок шинче,<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />но Господьын законжылан куана,</para>
  <para style="q1" vid="PSA 1:2">тудын нерген йӱд-кече шонкала!<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Тудо вӱдйогын воктене шындыме пушеҥге гай лиеш:</para>
  <para style="q1" vid="PSA 1:3">шке жапыштыже саскам конда,</para>
  <para style="q1" vid="PSA 1:3">лышташыжат ок лывыжге,</para>
  <para style="q1" vid="PSA 1:3">кеч-мом ышта – чылажат воранен толеш.<verse eid="PSA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Осал еҥ-влак дене тыге ок лий –</para>
  <para style="q1" vid="PSA 1:4">нуно [мландымбач] мардеж дене пуал нӧлталме арва гай улыт.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Осал еҥ-влак Юмын судышто шоген огыт керт,</para>
  <para style="q1" vid="PSA 1:5">сулыкан-шамыч – чын ыштыше-влакын погынымаштышт.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Вет чын ыштыше-влакын корныштым Господь вӱда,</para>
  <para style="q1" vid="PSA 1:6">а осал еҥ-влакын корнышт пытымашке наҥгая.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="cl">2 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Молан калык-влак лӱшкат,</para>
  <para style="q1" vid="PSA 2:1">тукым-шамыч кӱлдымӧ ойым пидыт?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Тӱнясе кугыжа-влак кынелыт,</para>
  <para style="q1" vid="PSA 2:2">тӧра-шамыч, пырля погынен,</para>
  <para style="q2" vid="PSA 2:2">Господь да Тудын Шӱрен Палемдымыж ваштареш каҥашат:<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />«Мыланна чиктыме кепшылыштым шалатена,</para>
  <para style="q1" vid="PSA 2:3">шинчырыштым кӱрлына».<verse eid="PSA 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Пылпомышто Илыше тидлан воштылеш,</para>
  <para style="q1" vid="PSA 2:4">Господь нуным мыскылтышыш луктеш.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Тунам Тудо сырымыж дене нунылан каласа,</para>
  <para style="q1" vid="PSA 2:5">шке шыдыж дене пеш чот лӱдыкта:<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />«Мый Сионышто, святой курыкыштем,</para>
  <para style="q2" vid="PSA 2:6">шке Кугыжамым шогалтенам».<verse eid="PSA 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />Господьын пунчалжым увертарем:</para>
  <para style="q1" vid="PSA 2:7">«Мылам Тудо каласен:</para>
  <para style="q1" vid="PSA 2:7">Тый Мыйын Эргым улат,</para>
  <para style="q1" vid="PSA 2:7">Мый таче Тыйым шочыктенам.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Йод Мый дечем –</para>
  <para style="q1" vid="PSA 2:8">Мый тылат калык-влакым пуэм,</para>
  <para style="q1" vid="PSA 2:8">мланде тӱр марте озаланаш тӱҥалат.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Тый нуным кӱртньӧ тоя дене пытарет,</para>
  <para style="q1" vid="PSA 2:9">шун кӧршӧкым пудыртымо семын шалатет».<verse eid="PSA 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Тыгеракын, ушым шындыза, кугыжа-влак,</para>
  <para style="q1" vid="PSA 2:10">тунемза, мландысе тӧра-влак!<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Господь деч лӱдын, Тудлан служитлыза,</para>
  <para style="q1" vid="PSA 2:11">[Тудын ончылныжо] чытырен куаныза.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />Кугун пагален, Эргым шупшалза –</para>
  <para style="q1" vid="PSA 2:12">тунам Господь ок шыдешке,</para>
  <para style="q1" vid="PSA 2:12">да коштмо корныштыда те огыда коло,</para>
  <para style="q1" vid="PSA 2:12">вет Тудын шыдыже ик татыште ылыжеш.</para>
  <para style="q1" vid="PSA 2:12">Тудын полышыжлан инаныше-влак улыт пиалан!<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="cl">3 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 3:1" />Давидын Авессалом эргыж деч куржмыж годым возымо псаломжо.<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Господь, тушманем-влак мыняр шукын улыт!</para>
  <para style="q1" vid="PSA 3:2">Шукын мыйын ваштареш шогалыт,<verse eid="PSA 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />шукын мыйын нергенем ойлат:</para>
  <para style="q1" vid="PSA 3:3">«Юмо тудым ок утаре».<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Но Тый, Господь, мыйын авыртышем да чапем улат,</para>
  <para style="q1" vid="PSA 3:4">вуем Тый кӱшкӧ нӧлталат.<verse eid="PSA 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Кугу йӱкын мый Господьым ӱжам,</para>
  <para style="q1" vid="PSA 3:5">Тудо мыланем святой курыкшо гыч вашешта.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Малаш возам мый, малем да кынелам,</para>
  <para style="q1" vid="PSA 3:6">вет мыйым Господь арала.<verse eid="PSA 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Ом лӱд еҥ-влак деч, кеч тӱжем дене лийышт</para>
  <para style="q1" vid="PSA 3:7">да мыйым чыла могырым авырышт.<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Господь, кынел! Юмем, мыйым утаре!</para>
  <para style="q1" vid="PSA 3:8">Тушманем-влакым Тый шӱргышт гыч перет,</para>
  <para style="q1" vid="PSA 3:8">осал еҥ-влакын пӱйыштым шалатет.<verse eid="PSA 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 3:9" />Утарымаш – Господь дечын.</para>
  <para style="q1" vid="PSA 3:9">Тыйын суапландарымашет – шке калыкет ӱмбалне.<verse eid="PSA 3:9" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="cl">4 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 4:1" />Хор вуйлатышылан. Кылан семӱзгар дене. Давидын псаломжо.<verse eid="PSA 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Кунам мый ӱжам, мылам вашеште,</para>
  <para style="q1" vid="PSA 4:2">чын ыштыше Юмем!</para>
  <para style="q1" vid="PSA 4:2">Шыгыр годым Тый мылам йоҥгыдылыкым пуэнат.</para>
  <para style="q1" vid="PSA 4:2">Серлаге мыйым да кумалмемым кол.<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Айдеме эрге-влак!</para>
  <para style="q1" vid="PSA 4:3">Мыняр жап эше мыйын чапем волташ тӱҥалыда?</para>
  <para style="q1" vid="PSA 4:3">Мыняр жап эше те кӱлеш-оккӱлым йӧраташ</para>
  <para style="q2" vid="PSA 4:3">да шояк верч шогаш тӱҥалыда?<verse eid="PSA 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Палыза, Господь Шкаланже святой еҥжым ойырен:</para>
  <para style="q1" vid="PSA 4:4">Господь колеш, кунам мый Тудым ӱжам.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Сыреда гынат, сулыкыш ида пуро –</para>
  <para style="q1" vid="PSA 4:5">шып лийза, кийыме верыштыда тидын нерген шонкалыза.<verse eid="PSA 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Чын надыр-влакым кондыза</para>
  <para style="q1" vid="PSA 4:6">да Господьын полышыжлан инаныза.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Шукын ойлат: «Кӧ мыланна сайым конда?»</para>
  <para style="q1" vid="PSA 4:7">Господь, волгыдо чуриетым мемнан век савыре!<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Тый мыйын шӱмем тугай кугу куан дене теменат,</para>
  <para style="q1" vid="PSA 4:8">могайже кинде, йошкар арака [да олив ӱй]</para>
  <para style="q2" vid="PSA 4:8">перкелыклан куаныше-влакынат уке.<verse eid="PSA 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 4:9" />Ласкан возам да малем,</para>
  <para style="q1" vid="PSA 4:9">вет Тый гына, Господь, мылам лӱдде илаш пуэт.<verse eid="PSA 4:9" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="cl">5 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 5:1" />Хор вуйлатышылан. Шиялтыш дене. Давидын псаломжо.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Господь, кол мыйын шомакем,</para>
  <para style="q1" vid="PSA 5:2">шотыш нал сӧрвалымем!<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />Мыйын Кугыжам да Юмем,</para>
  <para style="q1" vid="PSA 5:3">полышым йодын кычкырымем дек пылышет савыре,</para>
  <para style="q1" vid="PSA 5:3">вет мый Тылат кумалам.<verse eid="PSA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Господь! Эрден эрак кол йӱкемым –</para>
  <para style="q1" vid="PSA 5:4">эрден эрак Тыйын ончыкет шогалам</para>
  <para style="q1" vid="PSA 5:4">да вучаш тӱҥалам.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Юмем, осалым ыштымаш Тылат ок келше,</para>
  <para style="q1" vid="PSA 5:5">осалым ыштыше Тый денет илен ок керт.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Моктаныше еҥ-влак чурий ончылнет шоген огыт керт,</para>
  <para style="q1" vid="PSA 5:6">осалым ыштыше-шамычым Тыйын ужмет ок шу.<verse eid="PSA 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Ондалыше-влакым Тый пытарет,</para>
  <para style="q1" vid="PSA 5:7">вӱрым йоктарыше да шояче еҥ деч Господь йырна.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />А мый шуко порылыкетлан кӧра Тыйын пӧртышкет пурем,</para>
  <para style="q1" vid="PSA 5:8">Тый дечет лӱдын, святой храметлан вуйым савем.<verse eid="PSA 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Тушманем-влаклан кӧра, Господь,</para>
  <para style="q1" vid="PSA 5:9">шке чынлыкет дене мыйым вӱден наҥгае,</para>
  <para style="q1" vid="PSA 5:9">мыйын ончылнем шке корнетым тӧрым ыште.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Нунын шомакыштышт чын уке,</para>
  <para style="q1" vid="PSA 5:10">шӱмыштым пуштмаш авалтен,</para>
  <para style="q1" vid="PSA 5:10">логарышт – почмо шӱгар,</para>
  <para style="q1" vid="PSA 5:10">йылмышт дене ӱедылыт.<verse eid="PSA 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Судитле нуным, Юмем,</para>
  <para style="q1" vid="PSA 5:11">осалым ышташ шонымыштлан тек шкеак камвозыт.</para>
  <para style="q1" vid="PSA 5:11">Шуко осалланымыштлан кӧра нуным поктен колто,</para>
  <para style="q1" vid="PSA 5:11">вет Тыйын ваштареш нуно шогалыныт.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Тек Тыйын полышетлан ӱшаныше-влак йывыртат,</para>
  <para style="q2" vid="PSA 5:12">курымеш куанен йӱкланат.</para>
  <para style="q1" vid="PSA 5:12">Нуным Тый арален шогаш тӱҥалат,</para>
  <para style="q1" vid="PSA 5:12">Тыйын лӱметым йӧратыше-влак</para>
  <para style="q2" vid="PSA 5:12">Тый денет моктанаш тӱҥалыт.<verse eid="PSA 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 5:13" />Господь, Тый чын ыштышым суапландарет,</para>
  <para style="q1" vid="PSA 5:13">Тыйын поро кумылет тудлан авыртыш лиеш.<verse eid="PSA 5:13" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="cl">6 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 6:1" />Хор вуйлатышылан. Кандаш кылан семӱзгар дене. Давидын псаломжо.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Господь, кугу шыдет дене мыйым ит шылтале,</para>
  <para style="q1" vid="PSA 6:2">сырымет дене мыйым ит наказатле.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Серлаге мыйым, Господь, вет вийдыме улам,</para>
  <para style="q1" vid="PSA 6:3">паремде мыйым, Господь, вет луэм-влак чытырат.<verse eid="PSA 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Чонем чот вургыжеш.</para>
  <para style="q1" vid="PSA 6:4">Господь, мыняр жап эше тиде шуйна?<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Савырне мый декем, Господь, чонем утаре,</para>
  <para style="q1" vid="PSA 6:5">порылыкетлан кӧра мыйым нал пыдалын.<verse eid="PSA 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Вет колымеке Тыйым нигӧ ок шарналте.</para>
  <para style="q1" vid="PSA 6:6">Кӧ Тыйым шӱгарыште мокташ тӱҥалеш?<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Ойганен илымем деч ноенам,</para>
  <para style="q1" vid="PSA 6:7">малыме верем кажне йӱдым ночко –</para>
  <para style="q1" vid="PSA 6:7">шинчавӱд дене тудым нӧртем.<verse eid="PSA 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Ойгырен, шинчамже начарештын,</para>
  <para style="q1" vid="PSA 6:8">тушман-влаклан кӧра тудо вудакан ужеш.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />Осалым ыштыше-влак, мый дечем чылан кораҥза,</para>
  <para style="q1" vid="PSA 6:9">вет Господь шортмо йӱкемым колын.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Господь колын полышым йодмем,</para>
  <para style="q1" vid="PSA 6:10">кумалмемлан Тудо вашешта.<verse eid="PSA 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 6:11" />Тек тушманем-влак лийыт вожылтарыме,</para>
  <para style="q1" vid="PSA 6:11">лийыт пеш чот лӱдыктымӧ,</para>
  <para style="q1" vid="PSA 6:11">вучыдымын намысыш пурен, тек чакнен куржыт.<verse eid="PSA 6:11" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="cl">7 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 7:1" />Вениамин тукым гыч улшо Хус верч Давидын Господьлан шортын мурымыжо.<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Господь Юмем, мый полышетлан ӱшанен илем.</para>
  <para style="q1" vid="PSA 7:2">Утаре поктылшо-влакем деч, мыйым нал пыдалын.<verse eid="PSA 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />Уке гын нуно мыйым лев семын кӱрышт пытарат –</para>
  <para style="q1" vid="PSA 7:3">уке мыйым утарыше, [уке пыдалын налше].<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />О, Господь Юмем!</para>
  <para style="q1" vid="PSA 7:4">Иктаж-мом удам ыштенам гын,</para>
  <para style="q1" vid="PSA 7:4">чын огыл дене кидем амыртенам<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />але мый денем келшен илышылан осал дене тӱленам гын, –</para>
  <para style="q1" vid="PSA 7:5">мый, амал деч посна тушманем лийшымат утарыше, –<verse eid="PSA 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />тек чонемым поктылеш тушман да поктен шуэш,</para>
  <para style="q1" vid="PSA 7:6">илышем мландыш тошка, чапем пуракышке шуа.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Господь, кынел шыдет дене,</para>
  <para style="q1" vid="PSA 7:7">ажгыныше тушманем-влак ваштареш тарване,</para>
  <para style="q1" vid="PSA 7:7">мылам кӧра кынел палемдыме судет ышташ.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />Тек калык-влак йырет погынат,</para>
  <para style="q1" vid="PSA 7:8">нунын ӱмбалне каваште Тый престолышко шич.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />Господь калык-влакым судитла.</para>
  <para style="q1" vid="PSA 7:9">Господь, мылам чын судым ыште –</para>
  <para style="q1" vid="PSA 7:9">мый чын ыштыше, титак дечын посна улам.<verse eid="PSA 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Мучаш тек толеш осал еҥ-влакын пашаштлан,</para>
  <para style="q1" vid="PSA 7:10">а чын ыштышым Тый пеҥгыдемде,</para>
  <para style="q1" vid="PSA 7:10">вет Тый, чын Юмем, айдеме шӱм-чоным тергет!<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Юмо – мыйын авыртышем,</para>
  <para style="q1" vid="PSA 7:11">яндар шӱм-чонаным Тудо утара.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Юмо – чын ыштыше судья,</para>
  <para style="q1" vid="PSA 7:12">[куатан да шуко чытыше,]</para>
  <para style="q1" vid="PSA 7:12">осал пашалан кажне кечын мут кучаш шогалтыше.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Кӧ сулыкшо деч ок кораҥ,</para>
  <para style="q1" vid="PSA 7:13">тыгайлан Тудо шке кердыжым пӱсемда,</para>
  <para style="q1" vid="PSA 7:13">чымалтара йоҥежшым да тудын велыш виктара,<verse eid="PSA 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />колымашым кондышо саргуралым ямдыла,</para>
  <para style="q1" vid="PSA 7:14">пикшыже-влакым йӱлатышым ышта.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Осал еҥ чындымылыкым пӱктен шинча,</para>
  <para style="q1" vid="PSA 7:15">кӧргыштыжӧ осалым нумалеш</para>
  <para style="q1" vid="PSA 7:15">да шоякым шочыкта.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Кӱнча вынемым, кӱнчен пытара –</para>
  <para style="q1" vid="PSA 7:16">кӱнчымӧ вынемышкыже шкеак пурен кая.<verse eid="PSA 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Осалже тудын шке вуйжо ӱмбакак толеш,</para>
  <para style="q1" vid="PSA 7:17">весым темдымыже шкеж декак пӧртылеш.<verse eid="PSA 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 7:18" />Чаплем мый Господьым Тудын чынлыкшылан,</para>
  <para style="q1" vid="PSA 7:18">Чыла деч Кӱшылысын лӱмжым моктен мурем!<verse eid="PSA 7:18" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="cl">8 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 8:1" />Хор вуйлатышылан. Гефысе семӱзгар дене. Давидын псаломжо.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Господь Юмына!</para>
  <para style="q1" vid="PSA 8:2">Могай кӱдыратле Тыйын лӱмет пӱтынь мландымбалне!</para>
  <para style="q1" vid="PSA 8:2">Тыйын чапет кава деч кӱшкӧ шуэш!<verse eid="PSA 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Изи икшывын да чызе кочшын умшашт гоч</para>
  <para style="q2" vid="PSA 8:3">ямдыленат Тый моктымашым.</para>
  <para style="q1" vid="PSA 8:3">Тушманет-влак верчын тидым ыштенат,</para>
  <para style="q1" vid="PSA 8:3">ӱчызӧ еҥ ден тушманым пытараш.<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />Кунам мый Тыйын кидет дене ыштыме кавам,</para>
  <para style="q1" vid="PSA 8:4">тушто Тыйын вераҥдыме тылзым да шӱдыр-влакым ончем,<verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />тунам шонем: «Мо тугай айдеме? А Тый тудым шарнет.</para>
  <para style="q1" vid="PSA 8:5">Але айдеме эрге? А Тый тудын дек порын савырнет.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Тый тудым Суксо-влак<note caller="*" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">«Суксо-влак» – еврей текстыште ’Юмо’ але ’юмо-влак’.</char></note> деч изиш веле ӱлыкрак шынденат,</para>
  <para style="q1" vid="PSA 8:6">тудым чап да пагалымаш дене леведынат,<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />кидет дене ыштыметын озажлан шогалтенат,</para>
  <para style="q1" vid="PSA 8:7">тудын йол йымакше чыла пыштенат:<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />тыгыде ден шолдыра вольыкым, янлыкым,<verse eid="PSA 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />кавасе кайык ден теҥызысе колым,</para>
  <para style="q1" vid="PSA 8:9">теҥызыште чыла ийын коштшым».<verse eid="PSA 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 8:10" />Господь Юмына!</para>
  <para style="q1" vid="PSA 8:10">Могай кӱдыратле Тыйын лӱмет пӱтынь мландымбалне!<verse eid="PSA 8:10" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="cl">9 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 9:1" />Хор вуйлатышылан. «Эрге колымо» семлан возымо.<note caller="*" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">Еврей текстыште кучылтмо «алму́т лаббе́н» шомак-влакын чынжымак мом ончыктымыштым каласаш неле.</char></note> Давидын псаломжо.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Тыйым, Господь, уло шӱмем дене чапландарем,</para>
  <para style="q1" vid="PSA 9:2">ӧрыктарыше чыла пашат нерген ойлем!<verse eid="PSA 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Тылат мый куанем да йывыртем,</para>
  <para style="q1" vid="PSA 9:3">Чыла деч Кӱшылысӧ, лӱмет моктен мурем!<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Тушманем-влак чакнен куржыт,</para>
  <para style="q1" vid="PSA 9:4">шӱртнен камвозыт да чурий ончылнет колат.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Вет Тый мылам судым ыштенат,</para>
  <para style="q1" vid="PSA 9:5">мыйын пашам пыдал налынат –</para>
  <para style="q1" vid="PSA 9:5">Тый, Чынле Судья, престолыш шинчынат.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Калык-влакым Тый судитленат,</para>
  <para style="q1" vid="PSA 9:6">осалым ыштыше-шамычым пытаренат,</para>
  <para style="q1" vid="PSA 9:6">лӱмыштым мландымбач курымешлан ӱштылынат.<verse eid="PSA 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Тушманлан толын мучаш,</para>
  <para style="q1" vid="PSA 9:7">олаже-влакым Тый шалатенат –</para>
  <para style="q1" vid="PSA 9:7">тушман-влак нерген шарнымаш нунын дене пырля пытен.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Но Господь курымеш кугыжалана,</para>
  <para style="q1" vid="PSA 9:8">шке престолжым Тудо судлан ямдылен –<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />уло тӱням чынлык дене судитла,</para>
  <para style="q1" vid="PSA 9:9">калык-влаклан чын судым ышта.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Шыгыремдыме еҥлан Господь лиеш аралтыш,</para>
  <para style="q1" vid="PSA 9:10">неле жапыште Тудо шылын куржмо вер лиеш.<verse eid="PSA 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Тыйым пален налше-влак Тыланет ӱшанен илат,</para>
  <para style="q1" vid="PSA 9:11">вет Тыйым кычалше-влакым, Господь, Тый от кодо.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Сионышто илыше Господьым моктен мурыза,</para>
  <para style="q1" vid="PSA 9:12">Тудын пашаж-влак нерген калык-шамыч коклаште каласкалыза!<verse eid="PSA 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />Вет Тудо йоктарыме вӱр верч ӱчым шукта,</para>
  <para style="q2" vid="PSA 9:13">шыгыремдыме-влакым шарна,</para>
  <para style="q1" vid="PSA 9:13">нунын йӧсын кычкырымыштым ок мондо.<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />Серлаге мыйым, Господь!</para>
  <para style="q1" vid="PSA 9:14">Мыйым ужмышудымо-влаклан кӧра орланымем ончал!</para>
  <para style="q1" vid="PSA 9:14">Тый мыйым колымаш капка деч илышыш пӧртылтет,<verse eid="PSA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />да мый Сион ӱдырын капкаж воктене</para>
  <para style="q2" vid="PSA 9:15">Тыйын нергенет моктен увертарем,</para>
  <para style="q1" vid="PSA 9:15">Тыйын утарыметлан куанем.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Вес калык-влак кӱнчымӧ вынемышкышт шкеак пурен каеныт,</para>
  <para style="q1" vid="PSA 9:16">шылтен шындыме лӧдышкышт шке йолышт пижын.<verse eid="PSA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Еҥ-влакым чын судитлымыж дене Господь Шкенжым палдарен:</para>
  <para style="q1" vid="PSA 9:17">шке шындыме капканышкыже осал еҥ логалын.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Тек Юмым пагалыдыме еҥ-влак</para>
  <para style="q2" vid="PSA 9:18">да Юмым мондышо чыла калык вес тӱняшке каят.<verse eid="PSA 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Вет незер айдеме эрелан мондымо огеш лий,</para>
  <para style="q1" vid="PSA 9:19">йорло-влакын ӱшанышт йӧршешлан ок йом.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Кынел, Господь! Ит пу айдемылан сеҥаш,</para>
  <para style="q1" vid="PSA 9:20">тек калык-влак Тыйын ончылнет судитлыме лийыт.<verse eid="PSA 9:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 9:21" />Нунылан, Господь, лӱдмашым колто:</para>
  <para style="q1" vid="PSA 9:21">тек калык-влак палат – нуно айдеме гына улыт.<verse eid="PSA 9:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 9:22" />Молан, Господь, тораште шогет,</para>
  <para style="q1" vid="PSA 9:22">орлыкан жап годым Шкендым шылтет?<verse eid="PSA 9:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 9:23" />Осал еҥ кугешнымыж дене йорлым поктылеш –</para>
  <para style="q1" vid="PSA 9:23">шонен пыштыме чоялыкешыже тек шкеак пижеш.<verse eid="PSA 9:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 9:24" />Вет тыгай еҥ осал кумыл шупшмыж дене моктана,</para>
  <para style="q1" vid="PSA 9:24">шкаланже веле пайдам налаш йӧратыше еҥ «пиалан улам» манеш.</para>
  <para style="q1" vid="PSA 9:24">Господьым тудо мыскыла!<verse eid="PSA 9:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 9:25" />Господьын ончыкылык судшым</para>
  <para style="q2" vid="PSA 9:25">кугешныше осал еҥ шотыш ок нал,</para>
  <para style="q1" vid="PSA 9:25">тудын чыла шонымашыже – «Юмо уке!»<verse eid="PSA 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 9:26" />Тудын чыла пашаже воранен толеш,</para>
  <para style="q1" vid="PSA 9:26">Тыйын судет-влакым тудо ок умыло,</para>
  <para style="q1" vid="PSA 9:26">чыла тушманже ӱмбаке кӱшыч онча.<verse eid="PSA 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 9:27" />Шкаланже ойла:</para>
  <para style="q1" vid="PSA 9:27">«Мый пеҥгыдын шогем,</para>
  <para style="q1" vid="PSA 9:27">мый денем уда нигунам огеш лий».<verse eid="PSA 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 9:28" />Тудын умшаже каргымаш, шояклымаш да лӱдыктымаш дене темын,</para>
  <para style="q1" vid="PSA 9:28">йылмыж гыч орлык ден зияным кондышо мут-влак лектыт.<verse eid="PSA 9:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 9:29" />Ял мучаште тудо шылын-ваҥен шинча,</para>
  <para style="q1" vid="PSA 9:29">шолып верлаште титакдымым пуштеда,</para>
  <para style="q1" vid="PSA 9:29">шинчаже тудын полышдымо еҥым кӱта.<verse eid="PSA 9:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 9:30" />Кузе лев шылме верыштыже ваҥа,</para>
  <para style="q2" vid="PSA 9:30">тудат шылме верже гыч кӱта,</para>
  <para style="q1" vid="PSA 9:30">йорлым кучаш манын, вучен шинча –</para>
  <para style="q1" vid="PSA 9:30">да тудым, шке вапшешыже кучен, руалта.<verse eid="PSA 9:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 9:31" />Пӱгырна, возеш,</para>
  <para style="q2" vid="PSA 9:31">да полышдымо-влак тудын виян кӱчышкыжӧ логалыт.<verse eid="PSA 9:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 9:32" />Шке семынже ойла: «Юмо монден,</para>
  <para style="q1" vid="PSA 9:32">чурийжым петырен, нигунам огеш уж».<verse eid="PSA 9:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 9:33" />Кынел, Господь, мыйын Юмем!</para>
  <para style="q1" vid="PSA 9:33">Нӧлтал шке кидетым,</para>
  <para style="q1" vid="PSA 9:33">индыралтше-влакетым [йылт] ит мондо.<verse eid="PSA 9:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 9:34" />Кузе осалым ыштыше еҥ, Юмым укешке луктын, шонаш тоштеш:</para>
  <para style="q1" vid="PSA 9:34">«Юмо мыйым мут кучаш ок шогалте»?<verse eid="PSA 9:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 9:35" />Тый ужат орландарымаш ден пызырымашым,</para>
  <para style="q1" vid="PSA 9:35">Тый ончет да шке кидет дене вашмутым кучыктет.</para>
  <para style="q1" vid="PSA 9:35">Полышдымо еҥ шкенжым Тыйын кидышкет пуа,</para>
  <para style="q1" vid="PSA 9:35">тулык йочалан Тый полшышо улат.<verse eid="PSA 9:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 9:36" />Юмым пагалыдыме осал еҥын вийжым шалате –</para>
  <para style="q1" vid="PSA 9:36">тек чын огылжо деч огеш код кышат.<verse eid="PSA 9:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 9:37" />Господь курымешлан кугыжа, эрелан;</para>
  <para style="q1" vid="PSA 9:37">Тудын мландыштыже йот калык-влак пытат.<verse eid="PSA 9:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 9:38" />Господь! Тый колат ӱҥышемше-влакын сӧрвалымыштым,</para>
  <para style="q1" vid="PSA 9:38">пеҥгыдемде нунын шӱмыштым.</para>
  <para style="q1" vid="PSA 9:38">Поч шке пылышетым,<verse eid="PSA 9:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 9:39" />тулык йоча ден шыгыремдыме еҥлан чын судым ыште,</para>
  <para style="q1" vid="PSA 9:39">да ынже лӱдыктыл тетла ты мландыште илыше айдеме.<verse eid="PSA 9:39" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="cl">10 ПСАЛОМ</para>
  <para style="d">Хор вуйлатышылан. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />Господьын полшымыжлан ӱшанен илем.</para>
  <para style="q1" vid="PSA 10:1">А те мылам ойледа:</para>
  <para style="q1" vid="PSA 10:1">«Кайык семын курыкыш чоҥештен утло!»<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Теве осал еҥ-шамыч йоҥежыштым шупшыныт,</para>
  <para style="q1" vid="PSA 10:2">пикшыштым пикшвӱчыш пыштеныт</para>
  <para style="q2" vid="PSA 10:2">яндар шӱм-чонан-влакым пычкемыште лӱяш.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Негыз марте мер илыш пужлен гын,</para>
  <para style="q1" vid="PSA 10:3">чын ыштыше айдеме мом ыштен кертеш?<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Господь – шке святой храмыштыже,</para>
  <para style="q1" vid="PSA 10:4">Господьын престолжо – пылпомышто,</para>
  <para style="q1" vid="PSA 10:4">Тудын шинчаже [йорло еҥым] ужеш,</para>
  <para style="q1" vid="PSA 10:4">Тудын ончалтышыже айдеме эрге-влакым терга.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Чыным ыштен илыше еҥымат,</para>
  <para style="q2" vid="PSA 10:5">осал айдемымат Господь терга,</para>
  <para style="q1" vid="PSA 10:5">а весе-влакым темдаш йӧратыше айдеме дек</para>
  <para style="q2" vid="PSA 10:5">Тудо ужмышудымаш дене темын.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Йӱлышӧ тулшолым, тул ден чӱкчыгишым</para>
  <para style="q2" vid="PSA 10:6">Тудо осал еҥ-влак ӱмбаке йоктара,</para>
  <para style="q1" vid="PSA 10:6">нунын ужашышт – когартыше мардеж.<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Вет Господь – чын ыштыше,</para>
  <para style="q1" vid="PSA 10:7">Тудо чын ыштымым йӧрата;</para>
  <para style="q1" vid="PSA 10:7">чыным ыштен илыше-влак Тудын чурийжым ужыт.<verse eid="PSA 10:7" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="cl">11 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 11:1" />Хор вуйлатышылан. Давидын псаломжо. Кандаш кылан семӱзгар дене.<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />Утаре [мыйым], Господь, вет Юмым шотлышо-влак кодын огытыл,</para>
  <para style="q1" vid="PSA 11:2">айдеме эрге-влак кокла гыч ӱшанле еҥ-шамыч йомыныт.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Чылан икте-весыштлан шоякым ойлат,</para>
  <para style="q1" vid="PSA 11:3">йылмышт дене ӱедылыт, чоя шӱм дене кутырат.<verse eid="PSA 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />Господь пытара ӱедыл ойлышо умшам,</para>
  <para style="q1" vid="PSA 11:4">моктаныше чыла йылмым,<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />кудышт ойлат: «Йылмына дене сеҥена,</para>
  <para style="q1" vid="PSA 11:5">умшана мыланна полша. Кӧ мыланна оза?»<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />«Йорло-влакын орланымыштлан</para>
  <para style="q1" vid="PSA 11:6">да незер-шамычын нелын шӱлымыштлан кӧра</para>
  <para style="q2" vid="PSA 11:6">ынде кынелам, – ойла Господь, –</para>
  <para style="q1" vid="PSA 11:6">да вучымо утарымашым нунылан кондем».<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Господьын шомакше-влак яндар улыт,</para>
  <para style="q1" vid="PSA 11:7">коҥгаште мланде деч эрыктыме,</para>
  <para style="q1" vid="PSA 11:7">тулышто шым пачаш левыктыме ший гай улыт.<verse eid="PSA 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 11:8" />Тый, Господь, незер-влакым арален кодет,</para>
  <para style="q1" vid="PSA 11:8">тиде тукым деч нуным курымеш саклет.<verse eid="PSA 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 11:9" />Чыла вере осалым ыштыше-шамыч коштыт,</para>
  <para style="q1" vid="PSA 11:9">да айдеме эрге-влак коклаште йӧрдымӧ койыш озалана.<verse eid="PSA 11:9" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="cl">12 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 12:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Господь, мыняр эше тыге шуйна?</para>
  <para style="q1" vid="PSA 12:2">Тый мыйым курымешлан монденат мо?</para>
  <para style="q1" vid="PSA 12:2">Шке чуриетым мый дечем эше мыняр шылтет?<verse eid="PSA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Мыняр жап мылам утлаш йӧным кычалман,</para>
  <para style="q1" vid="PSA 12:3">шӱмыштем йӱдшӧ-кечыже орлыкым кучыман?</para>
  <para style="q1" vid="PSA 12:3">Эше мыняр жап тушман ӱмбакем кӱшыч ончаш тӱҥалеш?<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Ончал да вашеште мылам, Господь Юмем!</para>
  <para style="q1" vid="PSA 12:4">Волгыдым колто мыйын шинчамлан,</para>
  <para style="q1" vid="PSA 12:4">уке гын колымаш омо дене мален колтем.<verse eid="PSA 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />Ынже каласе тушман: «Мый тудым сеҥенам»,</para>
  <para style="q1" vid="PSA 12:5">ынже куане тудо мыйын шӱртньымемлан.<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Мый гын порылыкетлан ӱшанем,</para>
  <para style="q1" vid="PSA 12:6">Тыйын утарымашетлан куана шӱмем.</para>
  <para style="q1" vid="PSA 12:6">Мылам порым ыштыше Господьлан муралтем,</para>
  <para style="q1" vid="PSA 12:6">[Чыла деч Кӱшылысӧ Господьын лӱмжым моктен мурем.]<verse eid="PSA 12:6" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="cl">13 ПСАЛОМ</para>
  <para style="d">Хор вуйлатышылан. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Ушдымо еҥ шке семынже шона: «Юмо уке».</para>
  <para style="q1" vid="PSA 13:1">Тыгай еҥ-влак пужленыт, нуно йырнык пашам ыштат,</para>
  <para style="q1" vid="PSA 13:1">коклаштышт порым ыштыше уке.<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Пылпомыш гыч Господь айдеме эрге-влак ӱмбак онча –</para>
  <para style="q1" vid="PSA 13:2">уло мо шонен моштышо, Юмым кычалше?<verse eid="PSA 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Но чыланат кораҥыныт, чылан йӧрдымӧ лийыныт;</para>
  <para style="q1" vid="PSA 13:3">уке порым ыштыше, иктат уке.<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />Нимат огыт умыло мо осалым ыштыше нине еҥ-влак,</para>
  <para style="q1" vid="PSA 13:4">мыйын калыкемым киндым кочмо семын кочшо</para>
  <para style="q1" vid="PSA 13:4">да Господьын лӱмжым ӱжде илыше-влак?<verse eid="PSA 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />[Тудо верыште, кушто лӱдмаш уке,]</para>
  <para style="q2" vid="PSA 13:5">нуным пеш кугу лӱдмаш авалта,</para>
  <para style="q1" vid="PSA 13:5">вет Юмо – чын ыштыше-влак дене.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Незер еҥын вучымыжлан те воштылыда,</para>
  <para style="q1" vid="PSA 13:6">но полышым тудо Господь деч ӱшанен вуча.<verse eid="PSA 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 13:7" />Сион гыч Израильлан утарымаш толжо ыле!</para>
  <para style="q1" vid="PSA 13:7">Куана Иаков, Израиль йывырта,</para>
  <para style="q1" vid="PSA 13:7">кунам Господь пленыште улшо калыкшым мӧҥгеш пӧртылта.<verse eid="PSA 13:7" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="cl">14 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />Господь, кӧ Тыйын илыме верыштет лийын сеҥа?</para>
  <para style="q1" vid="PSA 14:1">Кӧ Тыйын святой курыкыштет илен кертеш?<verse eid="PSA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />Тудо, кӧ титакыш пурыде коштеш, чыным ышта,</para>
  <para style="q1" vid="PSA 14:2">уло шӱм-чонжо дене чыным ойла;<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />кӧ йылмыж дене еҥ ӱмбак лавырам ок кышке,</para>
  <para style="q1" vid="PSA 14:3">весылан осалым ок ыште,</para>
  <para style="q1" vid="PSA 14:3">лишыл еҥжым шӱктарыме дене ок келше;<verse eid="PSA 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />кӧм Юмо Шкеж деч кораҥден, тыгай еҥым ужмыжо ок шу,</para>
  <para style="q1" vid="PSA 14:4">а Господь деч лӱдшӧ-влакым тудо мокта;</para>
  <para style="q1" vid="PSA 14:4">товатмутшылан оза кодеш,</para>
  <para style="q2" vid="PSA 14:4">кеч тидыже тудлан эҥгекым конден кертеш;<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />оксам арымеш пуымеке, ашламым ок йод,</para>
  <para style="q1" vid="PSA 14:5">титакдыме еҥым титаклаш ок нал пӧлекым.</para>
  <para style="q1" vid="PSA 14:5">Тыге ыштыше еҥ курымеш пеҥгыдын шога.<verse eid="PSA 14:5" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="cl">15 ПСАЛОМ</para>
  <para style="d">Давидын мурыжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />Арале мыйым, Юмем,</para>
  <para style="q1" vid="PSA 15:1">вет Тыйын полшыметлан ӱшанен илем.<verse eid="PSA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Мый Господьлан каласенам:</para>
  <para style="q1" vid="PSA 15:2">«Тый мыйын Озам улат,</para>
  <para style="q1" vid="PSA 15:2">Тый дечет моло мыйын нимо сайжат уке».<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />Мландымбалне улшо святой да суапле-влак гына</para>
  <para style="q2" vid="PSA 15:3">мыйын чонемлан куаным кондат.<note caller="*" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Кӧмыт вес юмо дек каят, нунын орлык шукемеш;</para>
  <para style="q1" vid="PSA 15:4">вес юмылан вӱр надырым мый ом йоктаре,</para>
  <para style="q1" vid="PSA 15:4">вес юмо-влакын лӱмыштым ойлаш умшамым ом поч.<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />Господь – мылам палемдыме ужаш, мыйын йӱмӧ коркам.</para>
  <para style="q1" vid="PSA 15:5">Мыйын шеревам – Тыйын кидыштет.<verse eid="PSA 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 15:6" />Мыйын межам чапле верла гоч колтымо,</para>
  <para style="q1" vid="PSA 15:6">да мылам логалше мланде пеш сӧрал.<verse eid="PSA 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 15:7" />Ой-каҥашым пуэн шогышо Господьым моктем,</para>
  <para style="q1" vid="PSA 15:7">эсогыл йӱдым кӧргыштем туныктымыжым колам.<verse eid="PSA 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 15:8" />Господьым эре шке ончылнем ужам,</para>
  <para style="q1" vid="PSA 15:8">мый пеҥгыдын шогаш тӱҥалам,</para>
  <para style="q1" vid="PSA 15:8">вет Тудо – мыйын пурла могырыштем.<verse eid="PSA 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 15:9" />Садлан шӱмем куана, чонем<note caller="*" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">«Чонем» – Еврей текстыште ’чапем’.</char></note> йывырта,</para>
  <para style="q1" vid="PSA 15:9">ӱшанен вучен, капем тыныслын ила.<verse eid="PSA 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 15:10" />Вет Тый чонемым вес тӱняш от кодо,</para>
  <para style="q1" vid="PSA 15:10">шке святоетлан шӱйын кияш от пу.<verse eid="PSA 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 15:11" />Тый илыш корным ончыктет мылам:</para>
  <para style="q1" vid="PSA 15:11">ончылнет – кугу куан,</para>
  <para style="q1" vid="PSA 15:11">пурла велыштет – курымаш пиал.<verse eid="PSA 15:11" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="cl">16 ПСАЛОМ</para>
  <para style="d">Давидын кумалмыже.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Кол мыйым, Господь, мый чын судым кычалам,</para>
  <para style="q1" vid="PSA 16:1">колышт полышым йодын кычкырымем,</para>
  <para style="q1" vid="PSA 16:1">шотыш нал шоякдыме умшам гыч лекше сӧрвалыме мутем.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Тек Тый дечет мылам суд толеш,</para>
  <para style="q1" vid="PSA 16:2">тек Тыйын шинчат чыным ужеш.<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Тый тергышыч шӱмем, тольыч мый декемже йӱдым,</para>
  <para style="q1" vid="PSA 16:3">шымлышыч мыйым, но шыч му нимогай удам –</para>
  <para style="q1" vid="PSA 16:3">келшен толыт мутем ден шонымем.<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Кеч-мом ыштышт весе-шамыч,</para>
  <para style="q1" vid="PSA 16:4">а мый Тыйын шомакетым шуктен шогем,</para>
  <para style="q2" vid="PSA 16:4">шыгыремдыше-влакын корнышт деч шкемым арален кодем.<verse eid="PSA 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />Йолтошкалтышем шке корныштет пеҥгыдемде:</para>
  <para style="q1" vid="PSA 16:5">тек мыйын йолем йоҥылыш огеш тошкал.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Юмем, Тыйым сӧрвален ӱжам,</para>
  <para style="q1" vid="PSA 16:6">вет мыйым Тый колат.</para>
  <para style="q1" vid="PSA 16:6">Савыре пылышет, колышт ойлымем.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Ӧрыктарыше порылыкетым ончыкто,</para>
  <para style="q1" vid="PSA 16:7">полышетлан инаныше-влакым тушман деч куатет дене утаре.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Шинчасорта семын мыйым арале,</para>
  <para style="q1" vid="PSA 16:8">шке шулдырет йымаке шылте<verse eid="PSA 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />ӱмбакем кержалтше осал-влак дечын,</para>
  <para style="q1" vid="PSA 16:9">пушташ шонен авырыше тушманем-влак дечын.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />Чаманыдыме нунын чонышт, йӱштӧ,</para>
  <para style="q1" vid="PSA 16:10">шке умшашт дене кугешнен ойлат.<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Поктылшем-влак мыйым авырен нальыч,</para>
  <para style="q1" vid="PSA 16:11">мыйым мландымбаке йӧрыкташлан эскерен шогат.<verse eid="PSA 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 16:12" />Нуно кочкышым ваҥыше лев гай,</para>
  <para style="q1" vid="PSA 16:12">шылын вочшо самырык лев гай улыт.<verse eid="PSA 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 16:13" />Кынел, Господь, ваштарешышт шогал, йӧрыктӧ нуным.</para>
  <para style="q1" vid="PSA 16:13">Кердет дене чонемым осал-влак деч утаре,<verse eid="PSA 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 16:14" />шке кидет дене, Господь, еҥ-шамыч деч сакле.</para>
  <para style="q1" vid="PSA 16:14">Тӱнясе еҥ-влак деч утаре,</para>
  <para style="q1" vid="PSA 16:14">суапым нунышт тиде илышыштак налыт.</para>
  <para style="q1" vid="PSA 16:14">Вет шке клатет гыч пуэн, темет нунын мӱшкырыштым,</para>
  <para style="q1" vid="PSA 16:14">нунын эргышт темше улыт,</para>
  <para style="q1" vid="PSA 16:14">да мо кодшыжым шке йочаштлан кодат.<verse eid="PSA 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 16:15" />А мый чын ыштыше улам да Тыйын чуриетым ончаш тӱҥалам,</para>
  <para style="q1" vid="PSA 16:15">помыжалтмеке, воктенем улметлан куан дене темам.<verse eid="PSA 16:15" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="cl">17 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 17:1" />Хор вуйлатышылан. Господьын Давид тарзыжын псаломжо. Кунам тудым Господь чыла тушманже да Саулын кидше деч утарен, Давид тиде мурым Господьлан мурен. Тудо каласен:<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Господь, Тыйым йӧратем,</para>
  <para style="q1" vid="PSA 17:2">улат Тый вий-куатем!<verse eid="PSA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Господь – пеҥгыдылыкем, аралтышем да утарышем,</para>
  <para style="q1" vid="PSA 17:3">мыйын Юмем – кӱ курыкем,</para>
  <para style="q1" vid="PSA 17:3">Тудын полшымыжлан ӱшанен илем;</para>
  <para style="q1" vid="PSA 17:3">Тудо – авыртышем, виян утарышем да шылын куржмо верем.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Моктымашым сулышо Господьым мый ӱжам</para>
  <para style="q1" vid="PSA 17:4">да тушманем-влак деч утарыме лиям.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Колымаш кандыра-влак мыйым авырышт,</para>
  <para style="q1" vid="PSA 17:5">пужлымашын йогынжо-шамыч лӱдыктышт;<verse eid="PSA 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />вес тӱнян шинчырже-влак мыйым авырышт,</para>
  <para style="q1" vid="PSA 17:6">колымашын вапшыже йырем пӱтырналте.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Чонлан шыгыр лийме годым Господьым ӱжым,</para>
  <para style="q1" vid="PSA 17:7">шке Юмемым сӧрвален мый йодым.</para>
  <para style="q1" vid="PSA 17:7">[Святой] верже гыч Тудо йӱкем кольо,</para>
  <para style="q1" vid="PSA 17:7">кычкырымем Тудын пылышыж дек миен шуо.<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Юмын шыдыж деч мланде лӱҥгалте да чытырналте,</para>
  <para style="q1" vid="PSA 17:8">курык-влакын негызышт чытырнышт, тарванышт.<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Нерже гыч шикш лекте,</para>
  <para style="q1" vid="PSA 17:9">умшаж гыч – чыла пытарыше тул,</para>
  <para style="q1" vid="PSA 17:9">Тудын деч тулшол-влак йогышт.<verse eid="PSA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Тудо пылпомышым пӱгыртыш да волыш,</para>
  <para style="q1" vid="PSA 17:10">йол йымалныже – тӱп пычкемыш.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Херувим ӱмбаке шинче да чоҥештыш,</para>
  <para style="q1" vid="PSA 17:11">мардежын шулдырешыже кайыш.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Пычкемыш гыч ыштыш Шкаланже леведышым,</para>
  <para style="q1" vid="PSA 17:12">пычкемыш вӱд ден кава пыл гыч – Шке йырже пӱрдышым.<verse eid="PSA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Тудын ончылныжо волгалтме деч пыл-влак лектыч,</para>
  <para style="q1" vid="PSA 17:13">а тушечын – шолем ден тулшол.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />Господь пылпомышышто кӱдыртыш,</para>
  <para style="q1" vid="PSA 17:14">Чыла деч Кӱшылысӧ шке йӱкшым пуыш,</para>
  <para style="q1" vid="PSA 17:14">шолем ден тулшолым колтыш.<verse eid="PSA 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Пикш-влакым колтен, тушманым шалатыш,</para>
  <para style="q1" vid="PSA 17:15">шуко-шуко волгенче дене нуным чактарыш.<verse eid="PSA 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 17:16" />Господь, Тыйын кӱштымет деч,</para>
  <para style="q1" vid="PSA 17:16">Тыйын шыдетын пуал колтымыж деч</para>
  <para style="q1" vid="PSA 17:16">вӱдйогын-влак почылтыч,</para>
  <para style="q1" vid="PSA 17:16">тӱнян негызше-влак койыч.<verse eid="PSA 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 17:17" />Кидшым кӱшыч шуялтен, мыйым нале,</para>
  <para style="q1" vid="PSA 17:17">шуко вӱд кокла гыч мыйым лукто.<verse eid="PSA 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 17:18" />Утарыш мыйым виян тушманем деч,</para>
  <para style="q1" vid="PSA 17:18">мыйым ужмышудымо еҥ-влак деч,</para>
  <para style="q1" vid="PSA 17:18">кӧмытын куатышт лийын мый дечем шукырак.<verse eid="PSA 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 17:19" />Мылам неле лийме кечын нуно ӱмбакем кержалтыч,</para>
  <para style="q1" vid="PSA 17:19">но Господь мылам эҥертыш лие.<verse eid="PSA 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 17:20" />Утарыш мыйым, йоҥгыдо верыш лукто,</para>
  <para style="q1" vid="PSA 17:20">вет Тудо мый декем поро кумылан.<verse eid="PSA 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 17:21" />Чыным ыштымем почеш Господь мылам пӧртылта,</para>
  <para style="q1" vid="PSA 17:21">кидемын арулыкшо почеш Тудо пуа.<verse eid="PSA 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 17:22" />Вет мый Господьын корныж дене коштынам,</para>
  <para style="q1" vid="PSA 17:22">осалым ыштен, Юмем деч кораҥын омыл;<verse eid="PSA 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 17:23" />Тудын чыла кӱштымашыжым ушыштем эре кучем,</para>
  <para style="q1" vid="PSA 17:23">пунчалже-влак деч мый кораҥын омыл.<verse eid="PSA 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 17:24" />Тудын ончылно шылталаш лийдыме лийынам</para>
  <para style="q1" vid="PSA 17:24">да сулыкым ыштыме деч шекланенам.<verse eid="PSA 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 17:25" />Чыным ыштымем почеш Господь мылам пӧртылта,</para>
  <para style="q1" vid="PSA 17:25">вет Тудын шинчаж ончылно кидем ару.<verse eid="PSA 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 17:26" />Поро еҥ дене Тый поро лият,</para>
  <para style="q1" vid="PSA 17:26">чынле еҥ дене – чынле,<verse eid="PSA 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 17:27" />яндар дене – яндар,</para>
  <para style="q1" vid="PSA 17:27">а шояк еҥ дене – чоя.<verse eid="PSA 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 17:28" />Ӱҥышӧ-влакым Тый утарет,</para>
  <para style="q1" vid="PSA 17:28">а кугешныше ончалтышым ӱлыкшемдет.<verse eid="PSA 17:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 17:29" />Господь, Тый мылам лампым чӱктет,</para>
  <para style="q1" vid="PSA 17:29">мыйын Юмем волгалтара пычкемышем.<verse eid="PSA 17:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 17:30" />Тыйын полшымет дене тушман ӱмбак керылтам,</para>
  <para style="q1" vid="PSA 17:30">Юмем дене ола пырдыжым вончем.<verse eid="PSA 17:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 17:31" />Юмо! Тудын корныжо чынле,</para>
  <para style="q1" vid="PSA 17:31">Господьын шомакше яндар.</para>
  <para style="q1" vid="PSA 17:31">Кӧ Тудын полышыжлан ӱшанен ила,</para>
  <para style="q1" vid="PSA 17:31">чылаштлан Тудо авыртыш лиеш.<verse eid="PSA 17:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 17:32" />Господь деч моло кӧ эше Юмо уло,</para>
  <para style="q1" vid="PSA 17:32">Юмына деч моло кӧ эше аралтыш уло?<verse eid="PSA 17:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 17:33" />Юмо мылам вий-куатым пуа</para>
  <para style="q1" vid="PSA 17:33">да чын корныш шогалта.<verse eid="PSA 17:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 17:34" />Йолемым ышта пӱчын гайым,</para>
  <para style="q1" vid="PSA 17:34">кӱкшака верыш мыйым шогалта;<verse eid="PSA 17:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 17:35" />кидемым кредалаш туныкта,</para>
  <para style="q1" vid="PSA 17:35">той пикшйоҥежым кидем чымалтара.<verse eid="PSA 17:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 17:36" />Утарымаш авыртышым Тый мылам пуэт,</para>
  <para style="q1" vid="PSA 17:36">пурла кидет дене мылам полшен шогет,</para>
  <para style="q1" vid="PSA 17:36">Тыйын порылыкет мыйым нӧлта.<verse eid="PSA 17:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 17:37" />Йолемлан коштмо верым лопкаҥдет,</para>
  <para style="q1" vid="PSA 17:37">да огеш тайнышт мыйын йолем.<verse eid="PSA 17:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 17:38" />Мый тушман-влакем поктем да поктен шуам,</para>
  <para style="q1" vid="PSA 17:38">нуным шалатен пытарымеш мӧҥгеш ом пӧртыл.<verse eid="PSA 17:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 17:39" />Кырен шалатем нуным – кынелын огыт керт,</para>
  <para style="q1" vid="PSA 17:39">йол йымакем йӧралтыт.<verse eid="PSA 17:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 17:40" />Тый мылам кредалаш вий-куатым пуэт,</para>
  <para style="q1" vid="PSA 17:40">ваштарешем шогалше-влакым ончылнем сӱмырет.<verse eid="PSA 17:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 17:41" />Тушман-шамычем мый дечем куржыктет,</para>
  <para style="q1" vid="PSA 17:41">мыйым ужмышудымо-влакым мый пытарем.<verse eid="PSA 17:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 17:42" />Полышым йодын, нуно кычкырат, но утарыше уке,</para>
  <para style="q1" vid="PSA 17:42">Господьым сӧрвалат, но Тудо нуным ок кол.<verse eid="PSA 17:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 17:43" />Пуракыш савырен, мый нуным мардеж почеш колтем,</para>
  <para style="q1" vid="PSA 17:43">уремысе лавыра семын нуным тошкем.<verse eid="PSA 17:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 17:44" />Калык пудыранымаш деч Тый мыйым утарышыч,</para>
  <para style="q1" vid="PSA 17:44">вес калык-влакын вуйлатышыштлан шогалтышыч –</para>
  <para style="q1" vid="PSA 17:44">калык, кудым ончыч пален омыл, мылам служитла.<verse eid="PSA 17:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 17:45" />Ик гана ойлымекак, нуно мыйым колыштыт,</para>
  <para style="q1" vid="PSA 17:45">йот калык мыланем келшаш тӧча.<verse eid="PSA 17:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 17:46" />Йот тукым-влак ошем каят ончылнем,</para>
  <para style="q1" vid="PSA 17:46">карманышт гыч лектыт чытырен.<verse eid="PSA 17:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 17:47" />Господь илыше! Моктымо лийже мыйын аралышем,</para>
  <para style="q1" vid="PSA 17:47">чапландарыме лийже мыйым утарыше Юмем!<verse eid="PSA 17:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 17:48" />Мылам верч Юмо ӱчым шукта,</para>
  <para style="q1" vid="PSA 17:48">калык-влакым кид йымакем пуа,<verse eid="PSA 17:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 17:49" />тушман-шамыч дечын мыйым утара!</para>
  <para style="q1" vid="PSA 17:49">Ваштарешем шогалше-влак деч кӱшкӧ</para>
  <para style="q2" vid="PSA 17:49">Тый мыйым нӧлталынат,</para>
  <para style="q1" vid="PSA 17:49">поктылшо еҥ дечын Тый утаренат.<verse eid="PSA 17:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 17:50" />Сандене Тыйым, Господь, вес калык-влак коклаште чапландарем,</para>
  <para style="q1" vid="PSA 17:50">Тыйын лӱметым мый моктен мурем!<verse eid="PSA 17:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 17:51" />Шке кугыжатлан Тый кугу сеҥымашым пӧлеклет,</para>
  <para style="q1" vid="PSA 17:51">шӱрен палемдыме Давид ден тудын тукымжылан</para>
  <para style="q2" vid="PSA 17:51">порылыкым курым-курымеш ыштет.<verse eid="PSA 17:51" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="cl">18 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 18:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />Юмын чапше нерген пылпомыш ойла,</para>
  <para style="q1" vid="PSA 18:2">Тудын чыла пашаж нерген кава увертара.<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Кече кечылан каласкала,</para>
  <para style="q1" vid="PSA 18:3">йӱд йӱдлан шинчымашым пуа.<verse eid="PSA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Кеч огыт ойло, мутым огыт лук</para>
  <para style="q1" vid="PSA 18:4">да йӱкыштат ок шокто,<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />но каласымышт мланде мучко шарла,</para>
  <para style="q1" vid="PSA 18:5">шомакышт тӱня тӱр марте шуэш.</para>
  <para style="q1" vid="PSA 18:5">Каваште Тудо кечылан илыме верым ыштен.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Качын шке сӱан омашыж гыч лекме семын кече шыргыж лектеш,</para>
  <para style="q1" vid="PSA 18:6">шке корныж дене каяш лекше патыр семын куана.<verse eid="PSA 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Ик могыр каватӱр гыч тудо лектеш,</para>
  <para style="q1" vid="PSA 18:7">каен эрта вес каватӱр дек шумеш,</para>
  <para style="q1" vid="PSA 18:7">да тудын шокшыж деч нимоат шылын ок код.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Господьын законжо – ситыдымаш деч посна,</para>
  <para style="q1" vid="PSA 18:8">тудо шӱм-чоным пеҥгыдемда.</para>
  <para style="q1" vid="PSA 18:8">Господьын сугыньжо – чынле,</para>
  <para style="q1" vid="PSA 18:8">ужарвуй-влакым<note caller="*" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">Ужарвуй – неопытный, наивный.</char></note> тудо ушаным ышта.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Чынле улыт Господьын кӱштымашыже-влак,</para>
  <para style="q1" vid="PSA 18:9">нуно шӱмым куандарат.</para>
  <para style="q1" vid="PSA 18:9">Волгыдо улыт Господьын шӱдымашыже-влак,</para>
  <para style="q1" vid="PSA 18:9">нуно сайын ужаш полшат.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Господь деч лӱдмаш яндар, тудо курымеш лиеш.</para>
  <para style="q1" vid="PSA 18:10">Господьын судшо-влак – тиде чынлык, чын улыт нуно чыланат.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Нуно шӧртньӧ деч, шуко яндар шӧртньӧ деч шергырак,</para>
  <para style="q1" vid="PSA 18:11">мӱй, карашан мӱй чӱчалтыш деч улыт шерырак.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Нуно Тыйын тарзетым аралат,</para>
  <para style="q1" vid="PSA 18:12">нуным шуктен толмаш кугу суапым конда.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />Кӧ шке чыла йоҥылышыжым ужын сеҥа?</para>
  <para style="q1" vid="PSA 18:13">Шекланыде ыштыме сулыкем деч эрыкте мыйым.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Лӱмын ыштыме сулык деч арале шке тарзетым,</para>
  <para style="q1" vid="PSA 18:14">тек тудо мыйым огеш керт сеҥен.</para>
  <para style="q1" vid="PSA 18:14">Тунам лиям мый титакдыме,</para>
  <para style="q1" vid="PSA 18:14">кугу язык деч лиям яндар.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Тек умшам гыч лекше мут-влак да шӱмысӧ шонымашем-влак</para>
  <para style="q2" vid="PSA 18:15">Тылат келшыше лийыт.</para>
  <para style="q1" vid="PSA 18:15">Господь, Тый мыйын кӱ курыкем да Утарышем улат!<verse eid="PSA 18:15" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="cl">19 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 19:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Неле лийме кечын Господь тыйым колжо,</para>
  <para style="q1" vid="PSA 19:2">Иаковын Юмыжын лӱмжӧ тыйым аралыже.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Святой верже гыч тылат полышым колтыжо</para>
  <para style="q1" vid="PSA 19:3">да Сион гыч тыйым пеҥгыдемдыже.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Тыйын кондымо чыла надыретым шарналтыже,</para>
  <para style="q1" vid="PSA 19:4">да йӱлалтен пуымо надырет Юмылан келшыше лийже.<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />Тек [Господь] тылат шӱметын йодмыж почеш пуа,</para>
  <para style="q1" vid="PSA 19:5">чыла ышташ шоныметым шукта.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Тунам ме тыйын сеҥымашетлан куанена</para>
  <para style="q1" vid="PSA 19:6">да шкенан Юмына лӱмеш тистым нӧлталына.</para>
  <para style="q1" vid="PSA 19:6">Тек Господь чыла йодмашетым шукта.<verse eid="PSA 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Кызыт палем мый:</para>
  <para style="q1" vid="PSA 19:7">Господь шке шӱрен палемдымыжлан полша,</para>
  <para style="q1" vid="PSA 19:7">шке утарыше кидшын вий-куатше дене</para>
  <para style="q2" vid="PSA 19:7">святой пылпомыш гычше тудлан вашешта.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Южышт орвашт дене, южышт имньышт дене моктанат,</para>
  <para style="q1" vid="PSA 19:8">а ме Господь Юмынан лӱмжӧ дене моктанена.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Нуно шӱртнят да йӧрлыт,</para>
  <para style="q1" vid="PSA 19:9">а ме шогалын улына да пеҥгыдын шогена.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Господь, утаре кугыжам да кол мемнам,</para>
  <para style="q1" vid="PSA 19:10">кунам ме Тыйым ӱжын кычкыраш тӱҥалына.<verse eid="PSA 19:10" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="cl">20 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 20:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Господь! Тыйын куатетлан йывырта кугыжа,</para>
  <para style="q1" vid="PSA 20:2">Тыйын полышетлан моткоч куана.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Тый тудлан шӱм йодмыж почеш пуэнат,</para>
  <para style="q1" vid="PSA 20:3">сӧрвалымыжым ӧрдыжкӧ шӱкалын отыл.<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Вет Тый тудым поро суап дене вашлийынат,</para>
  <para style="q1" vid="PSA 20:4">вуйышкыжо яндар шӧртньӧ гыч ыштыме вуйшӱдышым пыштенат.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Тудо Тый дечет илышым йодын –</para>
  <para style="q1" vid="PSA 20:5">Тый тудлан курымеш шуйнышо кечылам пуэнат.<verse eid="PSA 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Тыйын полышет тудлан кугу чапым конден:</para>
  <para style="q1" vid="PSA 20:6">Тый тудым чап да кугулык<note caller="*" style="f"><char style="fr" closed="false">20:6 </char><char style="ft" closed="false">Кугулык – величие.</char></note> дене леведынат.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Тый курымешлан тудым суапландаренат,</para>
  <para style="q1" vid="PSA 20:7">эре пеленже улмет тудлан кугу куаным конда.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Вет кугыжа Господьлан инана</para>
  <para style="q1" vid="PSA 20:8">да Чыла деч Кӱшылысын порылыкшо дене пеҥгыдын шога.<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Тыйын кидет чыла тушманетым муэш,</para>
  <para style="q1" vid="PSA 20:9">Тыйым ужмышудымо-влакым пурла кидет муэш.<verse eid="PSA 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 20:10" />Лишемын, Тый нуным пуйто коҥгасе тулышто йӱлалтет.</para>
  <para style="q1" vid="PSA 20:10">Господь шыдыж дене нуным пытара,</para>
  <para style="q1" vid="PSA 20:10">тушман-влакым тул кочкеш.<verse eid="PSA 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 20:11" />Мландымбач Тый нунын тукымыштым ӱштыл кудалтет,</para>
  <para style="q1" vid="PSA 20:11">айдеме эрге-влак кокла гыч урлыкыштым пытарет.<verse eid="PSA 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 20:12" />Вет нуно Тыйын ваштареш ышташ шонат осалым,</para>
  <para style="q1" vid="PSA 20:12">шонен пыштымышт чоя, но тудо шукталтде кодеш.<verse eid="PSA 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 20:13" />Йоҥеж гычет ӱмбакышт пикшым виктарет,</para>
  <para style="q1" vid="PSA 20:13">нуным Тый мӧҥгеш куржыктет.<verse eid="PSA 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 20:14" />Шке куатет дене, Господь, чылан ӱмбалне нӧлталт!</para>
  <para style="q1" vid="PSA 20:14">Ме Тыйын вий-куатетым моктен мураш тӱҥалына!<verse eid="PSA 20:14" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="cl">21 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 21:1" />Хор вуйлатышылан. «Ӱжаран пӱчыжӧ» семлан возымо. Давидын псаломжо.<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Юмем, мыйын Юмем, [кол мыйым]!</para>
  <para style="q1" vid="PSA 21:2">Молан Тый мыйым кудалтен коденат?</para>
  <para style="q1" vid="PSA 21:2">Полышым йодын кычкырем,</para>
  <para style="q1" vid="PSA 21:2">но утарымаш тораште мый дечем.<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Мыйын Юмем!</para>
  <para style="q1" vid="PSA 21:3">Мый кечывалым кычкырем – Тый от вашеште,</para>
  <para style="q1" vid="PSA 21:3">йӱдым – уке мылам лыпланымаш.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Но Тый улат Святой,</para>
  <para style="q1" vid="PSA 21:4">Израильын моктеммутшо коклаште престолышто шинчет.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Тылат инаненыт ача-кочана-влак;</para>
  <para style="q1" vid="PSA 21:5">ӱшаненыт, да Тый нунылан полшенат.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Нуно Тыйым сӧрваленыт, да лийыныт утарыме.</para>
  <para style="q1" vid="PSA 21:6">Ӱшаненыт Тылат да вожылмашыш пурен огытыл.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Мыйже айдеме огыл, а шукш улам,</para>
  <para style="q1" vid="PSA 21:7">калыклан мыскылтыш лийынам,</para>
  <para style="q1" vid="PSA 21:7">еҥ-влак мыйым шотлымым чарненыт.<verse eid="PSA 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Мыйым ужын, чылан игылт воштылыт,</para>
  <para style="q1" vid="PSA 21:8">вуйыштым рӱзен, койдарен ойлат:<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />«Господьлан тудо инанен, тугеже Господь тудым утарыже,</para>
  <para style="q1" vid="PSA 21:9">тудын деке поро кумылан гын, полшыжо тудлан».<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Но тиде Тый ава мӱшкыр гыч мыйым луктынат,</para>
  <para style="q1" vid="PSA 21:10">чызым кочмем годымак шӱмышкем инанымашым пыштенат.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Шочмем годсекак Тыйын кидыштет лийынам,</para>
  <para style="q1" vid="PSA 21:11">ава мӱшкыр гыч лекмекак, Тый Юмем улат.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Ит лий мый дечем тораште,</para>
  <para style="q1" vid="PSA 21:12">вет лишне туткар, а полшышо уке.<verse eid="PSA 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Ӱшкыж кӱтӱ семын мыйын йыр шогальыч,</para>
  <para style="q1" vid="PSA 21:13">Васанын виян ӱшкыжшӧ-влак мыйым авырышт,<verse eid="PSA 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 21:14" />ырлыше, кӱрышташ ямде лев семын</para>
  <para style="q2" vid="PSA 21:14">ӱмбакем умшаштым карышт.<verse eid="PSA 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 21:15" />Мыйын вием мландыш вӱд гай йоген волыш,</para>
  <para style="q1" vid="PSA 21:15">чыла луэм моклеште,</para>
  <para style="q1" vid="PSA 21:15">шӱмем шыште семын оҥыштем левен кайыш.<verse eid="PSA 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 21:16" />Шун кӧршӧк пудырго семын виемже кошкыш,</para>
  <para style="q1" vid="PSA 21:16">йылмем умшаношмыш пижын шинче –</para>
  <para style="q1" vid="PSA 21:16">мылам колаш манын, мланде пуракыш мыйым волтышыч.<verse eid="PSA 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 21:17" />Вет пий-влак мыйым авырышт,</para>
  <para style="q1" vid="PSA 21:17">осал тӱшка йырым-йыр шогале,</para>
  <para style="q1" vid="PSA 21:17">шуралтышт кид ден йолем,<verse eid="PSA 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 21:18" />чыла луэм шотлен налаш лиеш.</para>
  <para style="q1" vid="PSA 21:18">Мыйым мыскылен, ӱмбакем ончат.<verse eid="PSA 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 21:19" />Шке коклаштышт вургемем пайлат,</para>
  <para style="q1" vid="PSA 21:19">мыйын чиемем верч шеревам кышкат.<verse eid="PSA 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 21:20" />Но Тый, Господь, ит лий мый дечем тораште;</para>
  <para style="q1" vid="PSA 21:20">мыйын вием, мылам полшаш вашке.<verse eid="PSA 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 21:21" />Утаре мыйын чонем керде дечын,</para>
  <para style="q1" vid="PSA 21:21">утаре илышем пий-влак дечын.<verse eid="PSA 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 21:22" />Утаре левын умшаж деч,</para>
  <para style="q1" vid="PSA 21:22">арале ир ӱшкыжын тӱкыж деч, мылам вашеште.<verse eid="PSA 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 21:23" />Тӱҥалам иза-шольо-влакемлан Тыйын нергенет ойлаш,</para>
  <para style="q1" vid="PSA 21:23">погынымаште Тыйым мокташ.<verse eid="PSA 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 21:24" />Господь деч лӱдшӧ-влак, моктыза Тудым!</para>
  <para style="q1" vid="PSA 21:24">Иаковын уло тукымжо, чапландаре Тудым!</para>
  <para style="q1" vid="PSA 21:24">Тек уло Израиль калык Юмым жапла,<verse eid="PSA 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 21:25" />вет Тудо орланыше еҥын ойгыжым изиэш ужын огыл,</para>
  <para style="q1" vid="PSA 21:25">тудын деч чурийжым шылтен огыл,</para>
  <para style="q1" vid="PSA 21:25">сӧрвален ӱжмекше, тудым колын.<verse eid="PSA 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 21:26" />Кугу погынымаште мый Тыйым моктем,</para>
  <para style="q1" vid="PSA 21:26">Юмо деч лӱдшӧ-влак ончылно сӧрымем шуктем.<verse eid="PSA 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 21:27" />Тек йорло-шамыч кочкыт да темыт,</para>
  <para style="q1" vid="PSA 21:27">тек Господьым кычалше-влак Тудым моктат.</para>
  <para style="q1" vid="PSA 21:27">Тек чонда курымеш ила!<verse eid="PSA 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 21:28" />Мландын чыла тӱрыштыжӧ ушым шындат да Господь дек савырнат –</para>
  <para style="q1" vid="PSA 21:28">чыла калык ден тукым Тыйын ончылнет вуйыштым сават,<verse eid="PSA 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 21:29" />вет Господь – Кугыжа,</para>
  <para style="q1" vid="PSA 21:29">Тудо – чыла калыклан Оза.<verse eid="PSA 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 21:30" />Мландымбалне улан илыше-влак пайрем чесым кочкаш</para>
  <para style="q1" vid="PSA 21:30">да Тудын ончылно вуйыштым саваш тӱҥалыт –</para>
  <para style="q1" vid="PSA 21:30">чылан, кӧмыт колымаш деч утлен огыт керт,</para>
  <para style="q1" vid="PSA 21:30">кӧмыт мланде пуракыш волышаш улыт,</para>
  <para style="q1" vid="PSA 21:30">Тудын ончылно вуйыштым мланде марте сават.<verse eid="PSA 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 21:31" />Мыйын тукымем Тудлан служитлаш</para>
  <para style="q1" vid="PSA 21:31">да ончыкылык тукымлан Господь нерген каласкалаш тӱҥалеш –<verse eid="PSA 21:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 21:32" />тудо толеш да ончыкшым шочшаш еҥ-влаклан</para>
  <para style="q2" vid="PSA 21:32">Господьын чынлыкше, мом ыштымыж нерген каласкала.<verse eid="PSA 21:32" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="cl">22 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />Господь – мыйын Кӱтӱчем,</para>
  <para style="q1" vid="PSA 22:1">мылам мо кӱлеш – чылажат уло:<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Тудо мыйым ужар олыклаште кандара,</para>
  <para style="q1" vid="PSA 22:2">шып йогышо вӱд деке конда,<verse eid="PSA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />пеҥгыдемда мыйын чонемым,</para>
  <para style="q1" vid="PSA 22:3">шке лӱмжылан кӧра мыйым чын корно дене наҥгая.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Кеч колымаш ӱмылан лапвер дене каем,</para>
  <para style="q1" vid="PSA 22:4">ом лӱд осал дечын – Тый пеленем улат.</para>
  <para style="q1" vid="PSA 22:4">Тыйын кӱтӱчӧ тоят ден пондет мыйым лыпландарат.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Тушманем-влак ончылно Тый мылам ӱстелым погет,</para>
  <para style="q1" vid="PSA 22:5">вуемым ӱй дене шӱрет –</para>
  <para style="q1" vid="PSA 22:5">мыйын коркам тӱргоч темыме.<verse eid="PSA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Тыйын порылыкет ден чаманымашет</para>
  <para style="q2" vid="PSA 22:6">чыла илышаш кечыштем пеленем лийыт,</para>
  <para style="q1" vid="PSA 22:6">да мый Господьын пӧртыштыжӧ ӱмыр мучко лиям.<verse eid="PSA 22:6" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="cl">23 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо. [Арнян икымше кечынже.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />Чылажат Господьын – мланде да мо тушто уло,</para>
  <para style="q1" vid="PSA 23:1">тӱня да тушто чыла илыше,<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />вет Тудо теҥыз-влак ӱмбалне мландылан негызым пыштен,</para>
  <para style="q1" vid="PSA 23:2">эҥер-влак ӱмбалне тудым пеҥгыдемден.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />Кӧ Господьын курыкышкыжо кӱза,</para>
  <para style="q1" vid="PSA 23:3">кӧ Тудын святой верыштыже шоген кертеш?<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Тудо, кӧн кидше титакдыме да шӱмжӧ яндар,</para>
  <para style="q1" vid="PSA 23:4">кӧ полган юмо-влаклан ок инане</para>
  <para style="q1" vid="PSA 23:4">да лишылъеҥжылан шояк товатмутым ок пу.<verse eid="PSA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Тудо Господь деч суапландарымашым налеш,</para>
  <para style="q1" vid="PSA 23:5">Утарыше Юмыжо тудым чыныш луктеш.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Тыгай улеш Тудым кычалше тукым,</para>
  <para style="q1" vid="PSA 23:6">Тыйын чуриетым кычалше тукым, Иаковын Юмыжо!<verse eid="PSA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 23:7" />Комдык почылтса, капка-влак,</para>
  <para style="q1" vid="PSA 23:7">курымашле омса-влак, почылтса –</para>
  <para style="q1" vid="PSA 23:7">чапын Кугыжаже пура!<verse eid="PSA 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 23:8" />Кӧ тиде чапын Кугыжаже?</para>
  <para style="q1" vid="PSA 23:8">Господь, пеҥгыде да куатан,</para>
  <para style="q1" vid="PSA 23:8">тиде Господь – кучедалмаште виян.<verse eid="PSA 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 23:9" />Комдык почылтса, капка-влак,</para>
  <para style="q1" vid="PSA 23:9">курымашле омса-влак, почылтса –</para>
  <para style="q1" vid="PSA 23:9">чапын Кугыжаже пура!<verse eid="PSA 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 23:10" />Кӧ тиде чапын Кугыжаже?</para>
  <para style="q1" vid="PSA 23:10">Господь Саваоф,</para>
  <para style="q1" vid="PSA 23:10">Тудо – чапын Кугыжаже!<verse eid="PSA 23:10" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="cl">24 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Тый декет, Господь, чонемым кондем.<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Юмем! Тыйын полшыметлан ӱшанен илем,</para>
  <para style="q1" vid="PSA 24:2">мыйым вожылмашыш [нигунам] ит пурто,</para>
  <para style="q1" vid="PSA 24:2">ит пу, мыйым сеҥен, тушман-влаклан куанаш.<verse eid="PSA 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Тылат инаныше нигӧ ынже пуро вожылмашыш,</para>
  <para style="q1" vid="PSA 24:3">но Тый дечет арам кораҥше-влак тек намысыш пурат.<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Господь, мылам шке корнетым ончыкто,</para>
  <para style="q1" vid="PSA 24:4">йолгорнет дене каяш мыйым туныкто.<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Тыйын чынет почеш илаш мыйым туныкто,</para>
  <para style="q1" vid="PSA 24:5">вет Тый утарыше Юмем улат;</para>
  <para style="q1" vid="PSA 24:5">мый кажне кечын Тылат инанен илем.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Шарналте, Господь, шке порылыкетым,</para>
  <para style="q1" vid="PSA 24:6">чаманыше кумылетым – улыт нуно курымашле.<verse eid="PSA 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Самырык годсо сулык ден титакем-влакым ит шарне,</para>
  <para style="q1" vid="PSA 24:7">поро улметлан кӧра, Господь, шке порылыкетлан кӧра мыйым шарналте!<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Господь – поро да чынле,</para>
  <para style="q1" vid="PSA 24:8">сандене сулыкан-влакым чын корныш шогалта,<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />ӱҥышӧ-влакым чынлыкыш наҥгая,</para>
  <para style="q1" vid="PSA 24:9">нуным шке корныжлан туныкта.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Кӧ Тудын ойпидышыжым, кӱштымашыже-влакым шуктен шога,</para>
  <para style="q1" vid="PSA 24:10">тудлан Господьын чыла корныжо – порылык да чын.<verse eid="PSA 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 24:11" />Господь, шке лӱметлан кӧра языкем кудалте –</para>
  <para style="q1" vid="PSA 24:11">тудо пеш кугу.<verse eid="PSA 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 24:12" />Лӱдеш гын айдеме Господь деч,</para>
  <para style="q1" vid="PSA 24:12">тудлан Господь кайышаш корным ончыкта.<verse eid="PSA 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 24:13" />Сай илыш дене тудо илаш тӱҥалеш,</para>
  <para style="q1" vid="PSA 24:13">тудын тукымжо мландын озаже лиеш.<verse eid="PSA 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 24:14" />Господь деч лӱдшӧ-влак Тудын мом шонен пыштымыжым палат,</para>
  <para style="q1" vid="PSA 24:14">шке ойпидышыжым палаш Тудо нуным туныкта.<verse eid="PSA 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 24:15" />Мыйын шинчам эре Господьым онча,</para>
  <para style="q1" vid="PSA 24:15">вет Тудо йолемым оптыш гыч луктеш.<verse eid="PSA 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 24:16" />Ончал ӱмбакем, мый декем лий поро,</para>
  <para style="q1" vid="PSA 24:16">вет мый шкет улам, мыйым шыгыремдылыт.<verse eid="PSA 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 24:17" />Нелылык темда чонемым –</para>
  <para style="q1" vid="PSA 24:17">ты орлык гычын мыйым лук,<verse eid="PSA 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 24:18" />орланымем, ойганымем Тый уж,</para>
  <para style="q1" vid="PSA 24:18">чыла языкем кудалте.<verse eid="PSA 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 24:19" />Ончал, мыняр шуко тушманем,</para>
  <para style="q1" vid="PSA 24:19">ужмышудымаш дене темын, мылам зияным ыштынешт.<verse eid="PSA 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 24:20" />Арале чонем, мыйым утаре,</para>
  <para style="q1" vid="PSA 24:20">намысыш пураш ит пу,</para>
  <para style="q1" vid="PSA 24:20">вет мый полышетлан ӱшанен илем.<verse eid="PSA 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 24:21" />Титакдымылык ден чынлык тек мыйым аралат,</para>
  <para style="q1" vid="PSA 24:21">вет Тыйым мый вучен илем.<verse eid="PSA 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 24:22" />Юмем, Израильым чыла орлыкшо деч утаре!<verse eid="PSA 24:22" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="cl">25 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />Господь, мылам чын судым ыште,</para>
  <para style="q1" vid="PSA 25:1">вет иленам титакым ыштыде.</para>
  <para style="q1" vid="PSA 25:1">Господьлан инанен, мый пеҥгыдын шогем!<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Шымлен нал, Господь, да мыйым терге,</para>
  <para style="q1" vid="PSA 25:2">кӧргем ден шӱмемым ший семын левыкте.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Вет Тыйын порылыкет – шинча ончылнем,</para>
  <para style="q1" vid="PSA 25:3">мый Тыйын чынет почеш иленам.<verse eid="PSA 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Шояк еҥ-влак дене пырля шинчен омыл,</para>
  <para style="q1" vid="PSA 25:4">осал чоя еҥ-шамыч дене ом кай.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Осалым ыштыше-влакын погынымашыштым ужмем ок шу,</para>
  <para style="q1" vid="PSA 25:5">Юмым шотлыдымо еҥ-шамыч дене пырля ом шич.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Титакдыме улам – кидемым мушкам,</para>
  <para style="q1" vid="PSA 25:6">Тыйын жертвенникет йыр, Господь, коштам.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Уло йӱкем дене Тыйым моктен мурем,</para>
  <para style="q1" vid="PSA 25:7">ӧрыктарыше чыла пашатым мый каласкалем.<verse eid="PSA 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />Йӧратем, Господь, Тыйын илыме пӧртетым,</para>
  <para style="q1" vid="PSA 25:8">Тыйын чапетын илыме вержым.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Ит пытаре мыйын чонем сулыкан-влак дене пырля,</para>
  <para style="q1" vid="PSA 25:9">илышем – вӱрым йоктарыше-влак дене пырля.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Нунын кидышт осал пашам ышта,</para>
  <para style="q1" vid="PSA 25:10">взятке дене пурла кидышт темын.<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />А мый илем титакым ыштыде –</para>
  <para style="q1" vid="PSA 25:11">[Господь], утаре, мый декем лий поро!<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Мыйын йолем тӧр верыште шога,</para>
  <para style="q1" vid="PSA 25:12">погынымашыште мый Господьым моктем.<verse eid="PSA 25:12" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="cl">26 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо. [Шӱрен палемдыме деч ончыч.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Господь – мыйын волгыдем, утарымашем.</para>
  <para style="q1" vid="PSA 26:1">Кӧ деч мылам лӱдаш?</para>
  <para style="q1" vid="PSA 26:1">Господь – мыйын илышемлан аралтыш,</para>
  <para style="q1" vid="PSA 26:1">кӧ деч мылам чытыраш?<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Осал еҥ-шамыч але тушман-влак</para>
  <para style="q2" vid="PSA 26:2">капемым кӱрышташ ӱмбакем кержалтыт гын,</para>
  <para style="q1" vid="PSA 26:2">нуно шкешт шӱртнен камвозыт.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Тушман сарзе-влак мыйым авырат гын,</para>
  <para style="q1" vid="PSA 26:3">огеш лӱд шӱмем тунамат.</para>
  <para style="q1" vid="PSA 26:3">Ваштарешем сар дене толыт гын,</para>
  <para style="q1" vid="PSA 26:3">тунамат инанаш тӱҥалам.<verse eid="PSA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Иктым веле йодынам Господь деч,</para>
  <para style="q1" vid="PSA 26:4">тидым гына кычалам –</para>
  <para style="q1" vid="PSA 26:4">илыме чыла кечыштем Господьын пӧртыштыжӧ лияш,</para>
  <para style="q1" vid="PSA 26:4">Господьын сӧраллыкшым ончаш,</para>
  <para style="q1" vid="PSA 26:4">Тудын [святой] храмыштыже вашмутым вучаш.<note caller="*" style="f"><char style="fr" closed="false">26:4 </char><char style="ft" closed="false">«Тудын [святой] храмыштыже вашмутым вучаш»: еврей текстыште тыште мом возымым умылаш неле. Южышт тидым «Тудын [святой] храмышкыже кошташ» семын умыленыт.</char></note><verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Вет орлык толмо кечын мыйым</para>
  <para style="q2" vid="PSA 26:5">Тудо шке омашышкыже пурта,</para>
  <para style="q1" vid="PSA 26:5">шке илыме верешыже шылта,</para>
  <para style="q1" vid="PSA 26:5">кӱ курыкыш кӱзыкта.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Тунам мыйым авырыше тушман-влак ӱмбалне вуем нӧлталтеш,</para>
  <para style="q1" vid="PSA 26:6">да мый Тудын скинийже пелен надырым куанен кондем,</para>
  <para style="q1" vid="PSA 26:6">Господь ончылно моктен мурем.<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />Господь, мыйын сӧрвалымем кол,</para>
  <para style="q1" vid="PSA 26:7">серлаге мыйым да колышт!<verse eid="PSA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />Шӱмемже Тыйын мутетым шарна:</para>
  <para style="q1" vid="PSA 26:8">«кычалза Мыйын чурием» –</para>
  <para style="q1" vid="PSA 26:8">Господь, мый Тыйын чуриетым кычалаш тӱҥалам.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Ит петыре мый дечем чуриетым,</para>
  <para style="q1" vid="PSA 26:9">сырымет дене ит шӱкал шке тарзетым.</para>
  <para style="q1" vid="PSA 26:9">Лийынат Тый полыш мыланем.</para>
  <para style="q1" vid="PSA 26:9">Утарыше Юмем, ит шӱкал, ит кай коден!<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Коден каят гынат ачам ден авам,</para>
  <para style="q1" vid="PSA 26:10">Господь мыйым Шкеж деке налеш.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Туныкто, Господь, мыйым шке корнетлан,</para>
  <para style="q1" vid="PSA 26:11">тушман-влакемлан кӧра тура йолгорно дене вӱден наҥгае.<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Ит пу мыйым тушман-влакын кидышкышт,</para>
  <para style="q1" vid="PSA 26:12">вет шояк таныклыше-влак ваштарешем кынелыныт</para>
  <para style="q2" vid="PSA 26:12">да осалын шӱлат.<verse eid="PSA 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 26:13" />Но илыше-влакын мландыштышт</para>
  <para style="q2" vid="PSA 26:13">мый Господьын порылыкшым ужам манын ӱшанем.<verse eid="PSA 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 26:14" />Господьлан инане, нимо деч ит лӱд,</para>
  <para style="q1" vid="PSA 26:14">лий пеҥгыде, Господьлан ӱшане!<verse eid="PSA 26:14" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="cl">27 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />Тыйым, Господь, ӱжын сӧрвалем:</para>
  <para style="q1" vid="PSA 27:1">мыйын аралтышем, мыйым колдымо ит лий!</para>
  <para style="q1" vid="PSA 27:1">От вашеште, шып лият гын,</para>
  <para style="q1" vid="PSA 27:1">мый шӱгарыш волышо еҥ гай лиям.<verse eid="PSA 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Кол мыйын кумалмем, кунам Тыйым ӱжам,</para>
  <para style="q1" vid="PSA 27:2">кунам святой храмет велке кидемым шуялтем.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Осалым да чын огылым ыштыше-влак дене пырля мыйым ит пытаре.</para>
  <para style="q1" vid="PSA 27:3">Лишылъеҥышт-влак дене нуно сайын кутырат,</para>
  <para style="q1" vid="PSA 27:3">а шӱмыштышт – осал.<verse eid="PSA 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Пӧртылтӧ нунылан пашашт почеш, осалым ыштымышт почеш,</para>
  <para style="q1" vid="PSA 27:4">мом кидышт ыштен – тудымак пӧртылтӧ,</para>
  <para style="q1" vid="PSA 27:4">мом сулен налыныт – тудымак пу.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Нуно Господьын мом ыштымыжым,</para>
  <para style="q1" vid="PSA 27:5">Тудын кидше дене ыштыме пашажым шотыш огыт нал,</para>
  <para style="q1" vid="PSA 27:5">сандене Тудо нуным шалата да угыч ок нӧлтал.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Моктымо лийже Господь,</para>
  <para style="q1" vid="PSA 27:6">вет Тудо кумалмемым колын.<verse eid="PSA 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Господь – мыйын вием да авыртышем:</para>
  <para style="q1" vid="PSA 27:7">шӱмем Тудлан инана.</para>
  <para style="q1" vid="PSA 27:7">Полшыш Тудо мыланем, да чонемже куана –</para>
  <para style="q1" vid="PSA 27:7">Тудым мый мурен чапландарем.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Господь – шке калыкшын куатше,</para>
  <para style="q1" vid="PSA 27:8">шке шӱрен палемдымыжым утарен саклыше.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Утаре шке калыкетым,</para>
  <para style="q1" vid="PSA 27:9">Шкаланет налме тукымым суапландаре,</para>
  <para style="q1" vid="PSA 27:9">нуным кӱтӧ, курымеш арале!<verse eid="PSA 27:9" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="cl">28 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо. [Тудым Омаш пайрем эртымеке мурат.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Чапым пуыза Господьлан, Юмын эргыже-влак,</para>
  <para style="q1" vid="PSA 28:1">чап ден вий-куатшылан Тудым моктыза.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Господьын лӱмжым чапландарыза,</para>
  <para style="q1" vid="PSA 28:2">сӧрал святой верыштыже Тудлан вуйдам савыза!<verse eid="PSA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Господьын йӱкшӧ вӱд ӱмбалне шокта,</para>
  <para style="q1" vid="PSA 28:3">чапланыше Юмо кӱдырта, Господь – кугу вӱд ӱмбалне!<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Господьын йӱкшӧ куатле,</para>
  <para style="q1" vid="PSA 28:4">Тудын йӱкшӧ кӱдыратле!<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Господьын йӱкшӧ кедр-влакым пудырта,</para>
  <para style="q1" vid="PSA 28:5">Ливан кедр-влакым Господь шалата.<verse eid="PSA 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Тудо Ливан ден Сирион курык-влакым презе семын,</para>
  <para style="q2" vid="PSA 28:6">самырык ӱшкыж семын тӧрштылыкта.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />Господьын йӱкшӧ деч тулйылме лектеда.<verse eid="PSA 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />Тудын йӱкшӧ ир мландым чытырыкта,</para>
  <para style="q1" vid="PSA 28:8">Кадес ир мландым Господь чытырыкта.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Кунам Господьын йӱкшӧ кӱдырта,</para>
  <para style="q1" vid="PSA 28:9">тӱж пӱчӧ-влак презым ыштат, чодыра-влак чараҥыт.</para>
  <para style="q1" vid="PSA 28:9">Тудын храмыштыже чылан каласат: «Чап лийже Тудлан!»<verse eid="PSA 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 28:10" />Ташлыше вӱд ӱмбалне Господь престолыштыжо шинчен,</para>
  <para style="q1" vid="PSA 28:10">курымеш Тудо кугыжа семын шинчаш тӱҥалеш.<verse eid="PSA 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 28:11" />Господь шке калыкшылан вийым пуа,</para>
  <para style="q1" vid="PSA 28:11">Господь, тынысым пуэн, шке калыкшым суапландара.<verse eid="PSA 28:11" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="cl">29 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 29:1" />Давидын псаломжо. Тудым храмым уэмдымылан возымо.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Господь, Тыйым чапландарем!</para>
  <para style="q1" vid="PSA 29:2">Тый мыйым вынем гыч луктынат,</para>
  <para style="q1" vid="PSA 29:2">ойгемлан куанаш тушманлан пуэн отыл.<verse eid="PSA 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Господь Юмем! Мый Тыйым ӱжынам,</para>
  <para style="q1" vid="PSA 29:3">да Тый мыйым паремденат.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Господь! Тый вес тӱня гыч чонем луктынат,</para>
  <para style="q1" vid="PSA 29:4">илышем утарен коденат,</para>
  <para style="q1" vid="PSA 29:4">да мый шӱгарыш волен омыл.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Господьлан мурыза, Тудын ӱшанле еҥже-влак,</para>
  <para style="q1" vid="PSA 29:5">Тудын святой лӱмжым чапландарыза!<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Вет Тудын шыдыже – ик татлан,</para>
  <para style="q1" vid="PSA 29:6">а поро кумылжо – ӱмырешлан:</para>
  <para style="q1" vid="PSA 29:6">кастене шортмаш лиеш, а эрдене куан толеш.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Сайын илыме годым мый ойленам:</para>
  <para style="q1" vid="PSA 29:7">«Мый эре пеҥгыдын шогем».<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Поро кумылетлан кӧра, Господь,</para>
  <para style="q1" vid="PSA 29:8">мыйым курык гай чоткыдым ыштенат.</para>
  <para style="q1" vid="PSA 29:8">Но кунам Тый мый дечем чуриет шылтенат,</para>
  <para style="q1" vid="PSA 29:8">мый чот ӧрткенам.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Тунам, Господь, мый Тыйым ӱжынам,</para>
  <para style="q1" vid="PSA 29:9">Господьым сӧрвален кумалынам:<verse eid="PSA 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />«Мый колем да шӱгарыш возам гын,</para>
  <para style="q1" vid="PSA 29:10">тидын деч могай пайда?</para>
  <para style="q1" vid="PSA 29:10">Мокташ тӱҥалеш мо Тыйым мланде пурак?</para>
  <para style="q1" vid="PSA 29:10">Тыйын чын улмет нерген тӱҥалеш мо ойлаш?<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />Мыйым кол, Господь, чамане!</para>
  <para style="q1" vid="PSA 29:11">Господь, мылам полшо!»<verse eid="PSA 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 29:12" />Ойгырен шортмем Тый юарлымашыш савырышыч,</para>
  <para style="q1" vid="PSA 29:12">чоштыра вургемым ӱмбачем кудашыч</para>
  <para style="q1" vid="PSA 29:12">да мыланем куаным ӱштальыч.<verse eid="PSA 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 29:13" />Мый Тыйым чарныде моктен мураш тӱҥалам.</para>
  <para style="q1" vid="PSA 29:13">Господь, мыйын Юмем!</para>
  <para style="q1" vid="PSA 29:13">Мый Тыйым курымеш мокташ тӱҥалам!<verse eid="PSA 29:13" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="cl">30 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 30:1" />Хор вуйлатышылан. Давидын псаломжо. [Тудым ойган жап годым муреныт.]<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Тыйын полышетлан, Господь, ӱшанен илем,</para>
  <para style="q1" vid="PSA 30:2">тек намысыш мый нигунам ом пуро.</para>
  <para style="q1" vid="PSA 30:2">Шке чынлыкет почеш мыйым утаре.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Кол мыйын йӱкем, утараш мыйым вашке.</para>
  <para style="q1" vid="PSA 30:3">Лий мылам пеҥгыде аралтыш, шылын куржмо вер –</para>
  <para style="q1" vid="PSA 30:3">мыйым утаре.<verse eid="PSA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Вет Тый кӱ курыкем, чоткыдо карманем улат,</para>
  <para style="q1" vid="PSA 30:4">шке лӱметлан кӧра мыйым вӱдӧ да виктарен шого.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Мылам йышт шындыме вапш гыч лук мыйым,</para>
  <para style="q1" vid="PSA 30:5">вет Тый аралтышем улат.<verse eid="PSA 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Тыйын кидышкет шке чонем пуэм.</para>
  <para style="q1" vid="PSA 30:6">Господь, ӱшанле Юмем,</para>
  <para style="q1" vid="PSA 30:6">Тый мыйым шуко гана утаренат!<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />Полган юмо-влаклан кумалше-шамычым ужмем ок шу,</para>
  <para style="q1" vid="PSA 30:7">мый Господьлан инанем.<verse eid="PSA 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Тыйын порылыкетлан йывыртем да куанем,</para>
  <para style="q1" vid="PSA 30:8">вет Тый ужынат орлыкем, паленат, кузе мылам неле,<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />тушман кидыш мыйым пуэн отыл,</para>
  <para style="q1" vid="PSA 30:9">а кумда, йоҥгыдо верыш луктынат.<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Господь, чамане мыйым, вет неле мылам,</para>
  <para style="q1" vid="PSA 30:10">шинчам, чонем да кӧргем ойганен начарештыныт.<verse eid="PSA 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Ойгырен илен, илышем эрта,</para>
  <para style="q1" vid="PSA 30:11">нелын шӱлен, ий-влакем йомыт.</para>
  <para style="q1" vid="PSA 30:11">Сулыкемлан кӧра вием лушкен,</para>
  <para style="q1" vid="PSA 30:11">луэм-влакат кошкеныт.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Тушман-влакемлан кӧра лийынам мый воштылчык,</para>
  <para style="q1" vid="PSA 30:12">игылтыт мыйым пошкудем-шамычат,</para>
  <para style="q1" vid="PSA 30:12">палымем-влаклан лийынам лӱдыктыш,</para>
  <para style="q1" vid="PSA 30:12">куржыт мый дечем уремыште ужшо-шамычат.<verse eid="PSA 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 30:13" />Монденыт мыйым, пуйто коленам,</para>
  <para style="q1" vid="PSA 30:13">пудыргышо ате семын лийынам.<verse eid="PSA 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 30:14" />Шукышт деч мый осал шомакым колам,</para>
  <para style="q1" vid="PSA 30:14">чыла могырым кугу лӱдмаш –</para>
  <para style="q1" vid="PSA 30:14">нуно мыйын ваштареш каҥашен кутырат,</para>
  <para style="q1" vid="PSA 30:14">мыйын чонем пытараш шонат.<verse eid="PSA 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 30:15" />А мый, Господь, Тыланет инанем,</para>
  <para style="q1" vid="PSA 30:15">ойлем: «Тый мыйын Юмем улат!»<verse eid="PSA 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 30:16" />Тыйын кидыштет илышаш кечем-влак,</para>
  <para style="q1" vid="PSA 30:16">утаре мыйым тушманем-влакын кидышт деч</para>
  <para style="q1" vid="PSA 30:16">да мыйым поктылшо-шамыч деч.<verse eid="PSA 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 30:17" />Шке тарзет ӱмбак волгыдо чуриет дене ончал,</para>
  <para style="q1" vid="PSA 30:17">шке порылыкет дене мыйым утаре.<verse eid="PSA 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 30:18" />Господь! Тыйым сӧрвален ӱжам,</para>
  <para style="q1" vid="PSA 30:18">тек ом пуро вожылмашыш,</para>
  <para style="q1" vid="PSA 30:18">но осалым ыштыше-влак тек намысыш пурат,</para>
  <para style="q1" vid="PSA 30:18">шӱгарыште умшаштым петырат.<verse eid="PSA 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 30:19" />Шып лийыт тек шояк умша-влак –</para>
  <para style="q1" vid="PSA 30:19">нуно, кӧмыт кугешнен, шкеныштым кӱш шынден,</para>
  <para style="q1" vid="PSA 30:19">чын ыштыше еҥ ваштареш намысдымын ойлат.<verse eid="PSA 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 30:20" />Мыняр шуко Тыйын порылыкет!</para>
  <para style="q1" vid="PSA 30:20">Тый дечет лӱдшӧ-влаклан тудо нигунам ок пыте,</para>
  <para style="q1" vid="PSA 30:20">Тыйын полышетлан инаныше-влаклан</para>
  <para style="q2" vid="PSA 30:20">чыла еҥ ончылно порым ыштет.<verse eid="PSA 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 30:21" />Нуным Тый Шке помышыштет</para>
  <para style="q2" vid="PSA 30:21">еҥ-влакын осал шонымашышт деч аралет,</para>
  <para style="q1" vid="PSA 30:21">йылме-влак титаклыме деч нуным саклет.<verse eid="PSA 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 30:22" />Моктымо лийже Господь,</para>
  <para style="q1" vid="PSA 30:22">вет авырен налме олаште</para>
  <para style="q1" vid="PSA 30:22">Тудо мылам ӧрыктарыше порылыкшым ончыктен!<verse eid="PSA 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 30:23" />А мый ӧрын-тургыжланен шоненам:</para>
  <para style="q1" vid="PSA 30:23">«Тыйын шинча ончычет кораҥдыме улам».</para>
  <para style="q1" vid="PSA 30:23">Но Тый мыйын кумалмем колынат,</para>
  <para style="q1" vid="PSA 30:23">кунам мый Тыйым сӧрвален ӱжынам.<verse eid="PSA 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 30:24" />Йӧратыза Господьым, Тудын ӱшанле еҥже-влак!</para>
  <para style="q1" vid="PSA 30:24">Вет шке ӱшанле-влакшым Господь арала,</para>
  <para style="q1" vid="PSA 30:24">а кугешныше-шамычлан тӱргоч пӧртылта.<verse eid="PSA 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 30:25" />Лӱддымӧ да пеҥгыде лийза,</para>
  <para style="q1" vid="PSA 30:25">Господьлан инаныше-влак чыланат!<verse eid="PSA 30:25" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="cl">31 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо. Туныктымаш.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Поро пиалан тудо еҥ,</para>
  <para style="q1" vid="PSA 31:1">кӧн титакшым Юмо кудалтен,</para>
  <para style="q1" vid="PSA 31:1">кӧн языкшым леведын!<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Пиалан тудо еҥ,</para>
  <para style="q1" vid="PSA 31:2">кӧм Господь сулыкшылан ок титакле,</para>
  <para style="q1" vid="PSA 31:2">кӧн чоныштыжо шояк уке!<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Кунам мый шып лийынам,</para>
  <para style="q1" vid="PSA 31:3">чарныде нелын кечкыжмем деч</para>
  <para style="q2" vid="PSA 31:3">капем ӱнарым йомдарен.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Вет йӱдшӧ-кечыже Тыйын кидет нелын киен ӱмбалнем;</para>
  <para style="q1" vid="PSA 31:4">шокшо кеҥеж игечыште кошкымо семын пытен мыйын ӱнарем.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />Но мый почым Тылат языкем,</para>
  <para style="q1" vid="PSA 31:5">титакемым шым шылте.</para>
  <para style="q1" vid="PSA 31:5">Мый каласышым:</para>
  <para style="q1" vid="PSA 31:5">«Сулыкем Господьлан луктын каласем»,</para>
  <para style="q1" vid="PSA 31:5">да сулыкем ден титакем Тый кудалтышыч.<verse eid="PSA 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Садлан тек кажне ӱшанле еҥ</para>
  <para style="q2" vid="PSA 31:6">туткар годым Тылат кумалеш,</para>
  <para style="q1" vid="PSA 31:6">тунам чот шарлыше вӱд тудын дек миен ок шу.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Мылам Тый куржын утлымо вер улат,</para>
  <para style="q1" vid="PSA 31:7">Тый ойго дечын мыйым аралет,</para>
  <para style="q1" vid="PSA 31:7">утарымашлан куанен кычкырлыме йӱк мыйын йыр шокта.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />«Пуэм тылат ушым, могай корно дене каяш туныктем,</para>
  <para style="q1" vid="PSA 31:8">тыйым Мый вӱден наҥгаем,</para>
  <para style="q1" vid="PSA 31:8">кажне ошкылетым эскерем».<verse eid="PSA 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />«Ида лий шонен моштыдымо имне ден мул гай.</para>
  <para style="q1" vid="PSA 31:9">Колыштышт манын, шӧрмыч ден сорлыкым чиктен,</para>
  <para style="q1" vid="PSA 31:9">нуным ӱҥышемдаш кӱлеш».<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Осал еҥын ойгыжо шуко,</para>
  <para style="q1" vid="PSA 31:10">а Господьлан инанышым Тудын порылыкшо авыра.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Чын ыштыше-влак, куаныза, йывыртыза Господьлан!</para>
  <para style="q1" vid="PSA 31:11">Яндар шӱм-чонан-влак, кугу йӱкын куаныза чылан!<verse eid="PSA 31:11" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="cl">32 ПСАЛОМ</para>
  <para style="d">[Давидын псаломжо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />Чын ыштыше-влак, Господьлан куаныза!</para>
  <para style="q1" vid="PSA 32:1">Чынле-влаклан Господьым мокташ келшен толеш.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Моктыза Господьым лира дене,</para>
  <para style="q1" vid="PSA 32:2">мурыза Тудлан лу кылан кӱсле дене!<verse eid="PSA 32:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Мурыза Тудлан у мурым,</para>
  <para style="q1" vid="PSA 32:3">шоктыза моторын, кугу йӱкын куанен!<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Вет Господьын шомакше чын,</para>
  <para style="q1" vid="PSA 32:4">Тудын чыла пашаже ӱшанле.<verse eid="PSA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Господь йӧрата чынлык ден чын ыштымашым,</para>
  <para style="q1" vid="PSA 32:5">Тудын порылыкшо дене мланде темын.<verse eid="PSA 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Господьын шомакше дене кава шочын,</para>
  <para style="q1" vid="PSA 32:6">чыла, мо тушто уло, Тудын умша шӱлышыж дене ышталтын.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Кугу ора семын Тудо теҥыз вӱдым поген,</para>
  <para style="q1" vid="PSA 32:7">пундашдыме вӱдым аралыме верлашке пыштен.<verse eid="PSA 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Тек уло мланде Господь деч лӱдеш,</para>
  <para style="q1" vid="PSA 32:8">тӱняште илыше-влак ончылныжо чытырат.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Вет мом Тудо каласен – тидак ышталтын,</para>
  <para style="q1" vid="PSA 32:9">Тудо кӱштен ойлен – тыгак лийын.<verse eid="PSA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Господь калык-влакын шонен пыштымыштым,</para>
  <para style="q1" vid="PSA 32:10">тукым-шамычын шонымыштым шалата,</para>
  <para style="q1" vid="PSA 32:10">[тӧра-влакын каҥашыштым укешке луктеш].<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Господьын пунчалже курымашле,</para>
  <para style="q1" vid="PSA 32:11">мом шонен пыштымыже тукым гыч тукымыш кодеш.<verse eid="PSA 32:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 32:12" />Пиалан тудо калык, кӧн Юмыжо – Господь,</para>
  <para style="q1" vid="PSA 32:12">пиалан тудо тукым, кӧм Тудо Шкаланже ойырен налын.<verse eid="PSA 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 32:13" />Онча Господь пылпомыш гыч,</para>
  <para style="q1" vid="PSA 32:13">чыла айдеме эрге-влакым ужеш.<verse eid="PSA 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 32:14" />Шке престолжо гыч, шинчыме верже гыч,</para>
  <para style="q1" vid="PSA 32:14">Тудо мландымбалне илыше-влак ӱмбаке онча:<verse eid="PSA 32:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 32:15" />чыланыштын шӱмыштым Тудо ыштен</para>
  <para style="q1" vid="PSA 32:15">да нунын чыла пашаштым пала.<verse eid="PSA 32:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 32:16" />Кугыжам кугу сарзывийже ок утаре,</para>
  <para style="q1" vid="PSA 32:16">патырым кугу куатше ок арале.<verse eid="PSA 32:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 32:17" />Имне сеҥымашым конда манын, ӱшанаш огеш кӱл,</para>
  <para style="q1" vid="PSA 32:17">тудын кугу вийже ок утаре.<verse eid="PSA 32:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 32:18" />Господьын ончалтышыже – Тудын деч лӱдшӧ-влак ӱмбалне,</para>
  <para style="q1" vid="PSA 32:18">Тудын порылыкшылан инаныше-влак ӱмбаке Тудын шинчаже онча.<verse eid="PSA 32:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 32:19" />Нунын чоныштым Тудо колымаш деч утара,</para>
  <para style="q1" vid="PSA 32:19">шужымаш годым илен лекташ полша.<verse eid="PSA 32:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 32:20" />Мемнан чонна Господьым ӱшанен вуча,</para>
  <para style="q1" vid="PSA 32:20">Тудо – мемнан полыш ден аралтышна.<verse eid="PSA 32:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 32:21" />Тудлан куана мемнан шӱмна,</para>
  <para style="q1" vid="PSA 32:21">святой лӱмжылан ме эҥертена.<verse eid="PSA 32:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 32:22" />Тек порылыкет, Господь, лиеш мемнан ӱмбалне,</para>
  <para style="q1" vid="PSA 32:22">вет ме Тылат эҥертена.<verse eid="PSA 32:22" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="cl">33 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 33:1" />Авимелех деч кайымеке, Давидын возымо псаломжо. Авимелех ончылно тудо ушдымыла койынат, поктен колтымо лийын.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Эре моктем Господьым,</para>
  <para style="q1" vid="PSA 33:2">Тудым чарныде моктымаш – мыйын умшаштем.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Мыйын чонем Господьлан йывырта,</para>
  <para style="q1" vid="PSA 33:3">тек ӱҥышӧ-влак колыт да куанат.<verse eid="PSA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Чапландарыза Господьым мый денем пырля,</para>
  <para style="q1" vid="PSA 33:4">Тудын лӱмжым пырля моктена!<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />Кычалынам Господьым, да Тудо мыйым колын,</para>
  <para style="q1" vid="PSA 33:5">чыла лӱдмашем деч мыйым утарен.<verse eid="PSA 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Кӧ ончалтышыжым Тудын дек савырен,</para>
  <para style="q1" vid="PSA 33:6">тудо куан дене волгалтын –</para>
  <para style="q1" vid="PSA 33:6">тыгай еҥын чурийжым вожылмаш ок левед.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Саде ӱҥышӧ сӧрвален – Господь тудым колын</para>
  <para style="q1" vid="PSA 33:7">да чыла орлыкшо деч утарен.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Господь деч лӱдшӧ еҥ-влак йыр</para>
  <para style="q1" vid="PSA 33:8">Тудын Суксыжо шогалеш да нуным утара.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Господьын поро улмыжым тамлен ончыза да пален налза!</para>
  <para style="q1" vid="PSA 33:9">Пиалан айдеме, кӧ Тудын полышыжлан ӱшана.<verse eid="PSA 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />Лӱдса Господь деч, Тудын святойжо-влак,</para>
  <para style="q1" vid="PSA 33:10">вет Тудын деч лӱдшӧ-шамычын мо кӱлешышт чыла уло.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Самырык лев-влакын нимошт уке, шужен шинчат,</para>
  <para style="q1" vid="PSA 33:11">а Господьым кычалше-шамычын чыла кӱлешлык сайышт уло.<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Толза, йоча-влак, колыштса мыйым:</para>
  <para style="q1" vid="PSA 33:12">Господь деч лӱдмашлан тендам туныктем.<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />Илаш шонет мо, айдеме,</para>
  <para style="q1" vid="PSA 33:13">йӧратет мо кужу сай ӱмырым?<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />Кучо шке йылметым осал деч,</para>
  <para style="q1" vid="PSA 33:14">умшатым – осал-чоя шомак деч.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />Кораҥ кай осал деч да порым ыште,</para>
  <para style="q1" vid="PSA 33:15">тыныслыкым кычал, тудын деке лишемаш тырше.<verse eid="PSA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Господьын шинчаже чын ыштыше-влакым онча,</para>
  <para style="q1" vid="PSA 33:16">пылышыже нунын сӧрвален йодмыштым колыштеш.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Но осалым ыштыше-влак нерген шарнымашым мландымбач пытараш манын,</para>
  <para style="q1" vid="PSA 33:17">Господьын чурийже нунын ваштареш лиеш.<verse eid="PSA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />[Чын ыштыше-влакын] сӧрвален йодмыштым Господь колеш,</para>
  <para style="q1" vid="PSA 33:18">чыла орлыкышт деч нуным утара.<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />Сусыргышо шӱм-чонан-влак пелен Господь лиеш,</para>
  <para style="q1" vid="PSA 33:19">ӱҥышемше шӱлышан-влакым Тудо утарен кода.<verse eid="PSA 33:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Чын ыштыше еҥын ойгыжо шуко,</para>
  <para style="q1" vid="PSA 33:20">но Господь чылашт деч утара.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Господь арала тудын чыла лужым,</para>
  <para style="q1" vid="PSA 33:21">ок пудырго иктыжат.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Осал еҥым осаллыкше пуштеш,</para>
  <para style="q1" vid="PSA 33:22">да кӧн чын ыштыше еҥым ужмыжо ок шу,</para>
  <para style="q1" vid="PSA 33:22">тудо титаканыш лукмо лиеш.<verse eid="PSA 33:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 33:23" />Господь шке тарзыж-влакын чоныштым утара,</para>
  <para style="q1" vid="PSA 33:23">Тудлан инаныше ик еҥат титаканыш лукмо ок лий.<verse eid="PSA 33:23" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="cl">34 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Кучедал, Господь, мый денем кучедалше-влак дене,</para>
  <para style="q1" vid="PSA 34:1">кредал, Господь, мый денем кредалше-влак дене.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Изи ден кугу авыртышым нал</para>
  <para style="q1" vid="PSA 34:2">да мыланем полшаш шогал.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Мыйым поктылшо-влакым вашлияш</para>
  <para style="q2" vid="PSA 34:3">умдо ден сарлык товаретым лук,</para>
  <para style="q1" vid="PSA 34:3">каласе мыйын чонемлан:</para>
  <para style="q1" vid="PSA 34:3">«Мый тыйын утарымашет улам!»<verse eid="PSA 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Чонем кычалше-влак тек намысыш да вожылмашыш пурат,</para>
  <para style="q1" vid="PSA 34:4">мылам осалым шонышо-влак тек чакнат да намыс дене леведалтыт.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Мардеж дене нӧлталме арва гай нуно лийышт,</para>
  <para style="q1" vid="PSA 34:5">тек Господьын Суксыжо нуным покта.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Тек корнышт лиеш пычкемыш да яклака,</para>
  <para style="q1" vid="PSA 34:6">тек Господьын Суксыжо нуным поктен кая.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Вет титакем уке ӱмбач мылам вапшым шынденыт,</para>
  <para style="q1" vid="PSA 34:7">титакем уке ӱмбач мылам вынемым кӱнченыт.<verse eid="PSA 34:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />Тек нуно вучыдымын кошаргат,</para>
  <para style="q1" vid="PSA 34:8">шындыме вапшышт тек шкеныштым куча,</para>
  <para style="q1" vid="PSA 34:8">тек тушко логалыт колашлан.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />А мыйын чонем Господьлан куана,</para>
  <para style="q1" vid="PSA 34:9">Тудын утарымыжлан йывырта.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Уло шӱм-чонем дене мый каласем:</para>
  <para style="q1" vid="PSA 34:10">«Господь, Кӧ уло Тый гает?</para>
  <para style="q1" vid="PSA 34:10">Начарым Тый виян деч утарет,</para>
  <para style="q1" vid="PSA 34:10">йорло ден незерым – нуным агыше деч».<verse eid="PSA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Осалым шонышо таныкче-влак мыйын ваштареш шогалыныт:</para>
  <para style="q1" vid="PSA 34:11">мом ом пале, тидын нерген йодыштыт.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Порым ыштымемлан мылам осал дене тӱлат,</para>
  <para style="q1" vid="PSA 34:12">чонемже мыйын кодын тулыкеш.<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />А мый черлышт годым чоштыра вургемым чиенам,</para>
  <para style="q1" vid="PSA 34:13">пӱтӧ дене чонем орландаренам,</para>
  <para style="q1" vid="PSA 34:13">но кумалмемлан вашмутым налын омыл.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Йолташ але иза шотеш ужын, нунын верч коляненам,</para>
  <para style="q1" vid="PSA 34:14">ава колымылан шортын коштшо гай,</para>
  <para style="q2" vid="PSA 34:14">вуйым ӱлыкӧ сакен, ойганен коштынам.<verse eid="PSA 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />А кунам мый шӱртненам,</para>
  <para style="q1" vid="PSA 34:15">нуно куанен пырля чумыргеныт,</para>
  <para style="q1" vid="PSA 34:15">мыйым вурсышо-влак погыненыт.</para>
  <para style="q1" vid="PSA 34:15">Ом пале – молан мыйым чарныде шӱктареныт,<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />сайла кояш тӧчен воштылшо-влак дене пырля</para>
  <para style="q2" vid="PSA 34:16">ваштарешем шке пӱйыштым пурыныт.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Господь! Кунар эше тидым ончаш тӱҥалат?</para>
  <para style="q1" vid="PSA 34:17">Утаре нунын умшашт деч мыйын чонем,</para>
  <para style="q1" vid="PSA 34:17">нине лев-влак дечын мыйын илышем.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />Моктем Тыйым кугу погынымаште,</para>
  <para style="q1" vid="PSA 34:18">чаплем Тыйым шуко еҥ коклаште.<verse eid="PSA 34:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Амал деч посна тушманем лийше-влак ойгемлан ынышт куане,</para>
  <para style="q1" vid="PSA 34:19">титакем уке ӱмбач мыйым ужмышудымо-влак</para>
  <para style="q2" vid="PSA 34:19">шинчаштым икте-весыштлан ынышт пӱял.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />Вет нуно тыныс нерген огыт ойло,</para>
  <para style="q1" vid="PSA 34:20">но элыште тыныслын илыше-влак ваштареш осал-чоя пашам ышташ шонат.<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Умшаштым ӱмбакем карен, тыге ойлат:</para>
  <para style="q1" vid="PSA 34:21">«Туге, туге! Шке шинчана дене ужынна».<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />Чыла Тый ужынат, Господь, шып ит лий!</para>
  <para style="q1" vid="PSA 34:22">Господь! Ит лий мый дечем тораште.<verse eid="PSA 34:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 34:23" />Кынел, Господь Юмем, мыйым арале,</para>
  <para style="q1" vid="PSA 34:23">титаклымышт деч мыйым нал пыдалын!<verse eid="PSA 34:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 34:24" />Господь Юмем, чынлыкет почеш мылам чын судым ыште,</para>
  <para style="q1" vid="PSA 34:24">тек нуно ойгемлан огыт куане.<verse eid="PSA 34:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 34:25" />Ынышт ойло шке шӱмыштышт:</para>
  <para style="q1" vid="PSA 34:25">«О! Чылажат мемнан шонымына семын лие!»</para>
  <para style="q1" vid="PSA 34:25">Ынышт ойло: «Ме тудым пытарышна!»<verse eid="PSA 34:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 34:26" />Тек вожылыт да намысыш пурат чылан, кӧ ойгемлан куанен:</para>
  <para style="q1" vid="PSA 34:26">шкеныштым мый дечем кӱшкӧ шындыше-влакым</para>
  <para style="q2" vid="PSA 34:26">тек вожылмаш ден намыс леведыт.<verse eid="PSA 34:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 34:27" />А нуно, кӧмыт мыйым чыныш лукмым ужнешт,</para>
  <para style="q1" vid="PSA 34:27">тек куанат да йывыртат, чарныде ойлат:</para>
  <para style="q1" vid="PSA 34:27">«Господь кӱдыратле, шке тарзыжлан Тудо тынысым шона!»<verse eid="PSA 34:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 34:28" />Йылмем ойлаш тӱҥалеш Тыйын чынлыкет нерген,</para>
  <para style="q1" vid="PSA 34:28">Тыйым мокташ тӱҥалеш кажне кечын.<verse eid="PSA 34:28" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="cl">35 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 35:1" />Хор вуйлатышылан. Господьын Давид тарзыжын мурыжо.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Осал еҥын сулыкшо тудын шӱмыштыжӧ кутыра,</para>
  <para style="q1" vid="PSA 35:2">Юмо деч лӱдмаш тудын уке.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Вет тудо шкенжым пеш кугуэш ужеш,</para>
  <para style="q1" vid="PSA 35:3">сандене сулыкшым огешат шеклане,</para>
  <para style="q1" vid="PSA 35:3">тудым ужмышудымо ок лий.<verse eid="PSA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Умшаж гыч лекше шомак-влак – шояк да чоялык,</para>
  <para style="q1" vid="PSA 35:4">уш-акылым тудо шӱкалын, порым ыштымым чарнен.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Осалым ышташ шонкала малыме верыштыже,</para>
  <para style="q1" vid="PSA 35:5">осал корныш шогалеш, осал деч ок йырне.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />Господь, кава дек шумеш Тыйын порылыкет,</para>
  <para style="q1" vid="PSA 35:6">пыл ора дек шумеш Тыйын ӱшанле улмет!<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Тыйын чынлыкет кугу курыкла гай,</para>
  <para style="q1" vid="PSA 35:7">чын судет – келге, пундашдыме!</para>
  <para style="q1" vid="PSA 35:7">Айдеме ден вольык-янлыкым Тый аралет, Господь!<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Мыняр шергакан Тыйын порылыкет, Юмына!</para>
  <para style="q1" vid="PSA 35:8">Айдеме эрге-влак шулдыр йымалнет саклыме улыт.<verse eid="PSA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Тыйын пӧртетын чесше дене нуно темыт,</para>
  <para style="q1" vid="PSA 35:9">тичмаш куанетын эҥерже гыч Тый нуным йӱктет.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Вет илыш памаш Тый денет,</para>
  <para style="q1" vid="PSA 35:10">Тыйын волгыдыштет ме волгыдым ужына.<verse eid="PSA 35:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Тыйым палыше-влаклан шке порылыкетым шуйо,</para>
  <para style="q1" vid="PSA 35:11">яндар шӱм-чонан-влаклан – шке чынлыкетым.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Кугешныше айдемын йолжо мыйым ынже тошкал,</para>
  <para style="q1" vid="PSA 35:12">осал еҥын кидше мыйым поктен ынже колто.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Теве осалым ыштыше-влак йӧрлыныт –</para>
  <para style="q1" vid="PSA 35:13">нуным сӱмыреныт, нуно огыт керт кынел.<verse eid="PSA 35:13" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="cl">36 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />Осал еҥлан кӧра ит шыдешке,</para>
  <para style="q1" vid="PSA 36:1">осалым ыштылшылан ит кӧране –<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />вашке нуно шудо семын лывыжгат,</para>
  <para style="q1" vid="PSA 36:2">ужар кушкыл семын кошкат.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Инане Господьлан да сайым ыште,</para>
  <para style="q1" vid="PSA 36:3">иле мландыште да лий ӱшанле.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Господьлан куане,</para>
  <para style="q1" vid="PSA 36:4">да Тудо шӱметын шонымыжым шукта.<verse eid="PSA 36:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Господьлан шке корнетым кучыкто да Тудлан инане:</para>
  <para style="q1" vid="PSA 36:5">кузе кӱлеш – Тудо ышта.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Тудо титакдыме улметым ӱжара семын,</para>
  <para style="q1" vid="PSA 36:6">чынлыкетым кече семын нӧлталеш.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Господьым колышт иле да Тудым ӱшанен вучо.</para>
  <para style="q1" vid="PSA 36:7">Воранен илыше айдемылан,</para>
  <para style="q1" vid="PSA 36:7">осал-чоя пашам ыштышылан ит кӧране.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Чарне шыдешкымым, кугу сырымашым кодо –</para>
  <para style="q1" vid="PSA 36:8">шыдешкымаш сайыш ок шукто.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Вет осалым ыштыше-влак пытат,</para>
  <para style="q1" vid="PSA 36:9">да мланде Господьлан инаныше-влакын лиеш.<verse eid="PSA 36:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Эше изишак – да осалым ыштыше еҥ огешат лий,</para>
  <para style="q1" vid="PSA 36:10">ончалат тудын лийме верышкыже – тудо уке.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Мланде ӱҥышӧ-влакын лиеш,</para>
  <para style="q1" vid="PSA 36:11">тыныс-эсенлыкыште нуно куанен илаш тӱҥалыт.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Осал еҥ чын ыштыше ваштареш шонкала осалым,</para>
  <para style="q1" vid="PSA 36:12">тудын ваштареш пӱйжым пуреш.<verse eid="PSA 36:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 36:13" />Тудым ончен, Господь воштылеш:</para>
  <para style="q1" vid="PSA 36:13">пала – вашке тудын кечыже шуэш.<verse eid="PSA 36:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 36:14" />Йорло ден незерым йӧрыкташ</para>
  <para style="q2" vid="PSA 36:14">да чын корно дене кайыше-влакым пытараш манын,</para>
  <para style="q1" vid="PSA 36:14">осалым ыштыше-влак кердыштым луктыт,</para>
  <para style="q1" vid="PSA 36:14">йоҥежыштым чымалтарат.<verse eid="PSA 36:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 36:15" />Но кердышт шке шӱмышкышт пура,</para>
  <para style="q1" vid="PSA 36:15">да пикшйоҥежышт шалана.<verse eid="PSA 36:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 36:16" />Чын ыштыше еҥын шагал погыжо</para>
  <para style="q2" vid="PSA 36:16">шуко осал еҥын поянлыкышт деч сайрак,<verse eid="PSA 36:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 36:17" />вет нунын кидышт пудыртымо лиеш,</para>
  <para style="q1" vid="PSA 36:17">а чын ыштыше-влакым Господь пеҥгыдемда.<verse eid="PSA 36:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 36:18" />Господь ужеш шылталаш лийдыме еҥ-влакын кечыштым,</para>
  <para style="q1" vid="PSA 36:18">шке мландышт курымеш нунынак лиеш.<verse eid="PSA 36:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 36:19" />Неле жап годым огыт пуро намысыш,</para>
  <para style="q1" vid="PSA 36:19">кинде укеан кечылаштат нуно темше лийыт.<verse eid="PSA 36:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 36:20" />А осалым ыштыше-влак колат,</para>
  <para style="q1" vid="PSA 36:20">Господьын тушманже-влак пача коям йӱлатыме семын пытат,</para>
  <para style="q1" vid="PSA 36:20">шикш семын нуно йомыт.<verse eid="PSA 36:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 36:21" />Осал еҥ кӱсын налеш да мӧҥгеш огеш пу,</para>
  <para style="q1" vid="PSA 36:21">а чын ыштыше еҥ шкенжыным чаманыде пуа.<verse eid="PSA 36:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 36:22" />Мланде Юмын суапландарымыже-влакын лиеш,</para>
  <para style="q1" vid="PSA 36:22">а каргымыже-шамыч пытат.<verse eid="PSA 36:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 36:23" />Кӧн коштмо корныжо Господьлан келша,</para>
  <para style="q1" vid="PSA 36:23">тыгай айдемын ошкылжым Тудо пеҥгыдемда.<verse eid="PSA 36:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 36:24" />Кунам тудо пуреҥгаяш тӱҥалеш – пурен ок кай,</para>
  <para style="q1" vid="PSA 36:24">вет Господь тудым кидше гыч куча.<verse eid="PSA 36:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 36:25" />Мый самырык лийынам да шоҥгемынам,</para>
  <para style="q1" vid="PSA 36:25">но ужын омыл чын ыштыше еҥым шуэн кодымым</para>
  <para style="q1" vid="PSA 36:25">да тудын шочшыжо-влакым киндым йодышт коштшым.<verse eid="PSA 36:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 36:26" />Тудо кажне кечын порылыкым ончыкта да кӱсын пуа,</para>
  <para style="q1" vid="PSA 36:26">шочшыж-влак моло еҥлан суапландарымаш лийыт.<verse eid="PSA 36:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 36:27" />Кораҥ осал деч, порым ыште –</para>
  <para style="q1" vid="PSA 36:27">тунам тый мландыштет курымеш илет,<verse eid="PSA 36:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 36:28" />вет Господь чынлыкым йӧрата</para>
  <para style="q1" vid="PSA 36:28">да шке ӱшанлыже-влакым огеш кодо,</para>
  <para style="q1" vid="PSA 36:28">нуным Тудо курымеш арала.</para>
  <para style="q1" vid="PSA 36:28">[А осал еҥ-шамыч поктен колтымо лийыт,]</para>
  <para style="q1" vid="PSA 36:28">Юмым пагалыдыме-влакын тукымышт пытат.<verse eid="PSA 36:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 36:29" />Мланде чын ыштыше-влакын лиеш,</para>
  <para style="q1" vid="PSA 36:29">тушто нуно илаш тӱҥалыт курымеш.<verse eid="PSA 36:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 36:30" />Чын ыштыше еҥ умшаж гыч ушан шомакым луктеш,</para>
  <para style="q1" vid="PSA 36:30">йылмыже тудын чын мутым ойла.<verse eid="PSA 36:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 36:31" />Юмыжын законжо – тудын шӱмыштыжӧ,</para>
  <para style="q1" vid="PSA 36:31">ошкылжо тудын огеш тайнышт.<verse eid="PSA 36:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 36:32" />Осал еҥ чын ыштышым эскерен коштеш,</para>
  <para style="q1" vid="PSA 36:32">тудым пушташ йӧнан жапым кычалеш.<verse eid="PSA 36:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 36:33" />Но Господь шке еҥжым тудын кидыш ок пу,</para>
  <para style="q1" vid="PSA 36:33">судышто тудым титаканыш лукташ ок пу.<verse eid="PSA 36:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 36:34" />Господьлан инане, Тудын корныж деч ит кораҥ –</para>
  <para style="q1" vid="PSA 36:34">тунам Тудо тыйым нӧлталеш, мланде тыйын лиеш,</para>
  <para style="q1" vid="PSA 36:34">да тый осал еҥ-влакын пытымыштым ужат.<verse eid="PSA 36:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 36:35" />Ужынам мый осал-торжа айдемым,</para>
  <para style="q1" vid="PSA 36:35">кӱкшӧ да ладыра пушеҥге семын шогышым.<verse eid="PSA 36:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 36:36" />Но тудо каен йомо,</para>
  <para style="q1" vid="PSA 36:36">кычальым тудым – шым верешт.<verse eid="PSA 36:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 36:37" />Эскере титакдыме еҥым, чын ыштышым ончо:</para>
  <para style="q1" vid="PSA 36:37">тынысле еҥым ончыкылык вуча.<verse eid="PSA 36:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 36:38" />А осалым ыштыше-влак чылан пытарыме лийыт:</para>
  <para style="q1" vid="PSA 36:38">Юмым пагалыдыме-шамычын ончыкылыкышт ок лий.<verse eid="PSA 36:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 36:39" />Чын ыштыше-влаклан утаралтмаш – Господь деч,</para>
  <para style="q1" vid="PSA 36:39">неле жап годым Тудо нуным арала.<verse eid="PSA 36:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 36:40" />Господь нунылан полша да нуным утара.</para>
  <para style="q1" vid="PSA 36:40">Утара нуным осал еҥ дечын,</para>
  <para style="q1" vid="PSA 36:40">вет нуно Тудын полышыжлан инанат.<verse eid="PSA 36:40" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="cl">37 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 37:1" />Давидын псаломжо. [Шуматкечым] шарнашлан.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />Господь, кугун сырымет дене ит шылтале мыйым,</para>
  <para style="q1" vid="PSA 37:2">кугу шыдет дене мыйым ит наказатле.<verse eid="PSA 37:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Вет Тыйын пикшет-влак капышкем пуреныт,</para>
  <para style="q1" vid="PSA 37:3">Тыйын кидет мыйым темда.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Тыйын шыдетлан верч капыштем корштыдымо вер кодын огыл,</para>
  <para style="q1" vid="PSA 37:4">сулыкемлан кӧра луэм-влаклан уке ласкалык.<verse eid="PSA 37:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Осал пашам-влак вуем дечат кӱшнӧ улыт,</para>
  <para style="q1" vid="PSA 37:5">неле нумалтыш гай мыйым темдат.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Ушдымо лиймемлан кӧра</para>
  <para style="q2" vid="PSA 37:6">сусырем-влак шӱйыт да ӱпшалтыт.<verse eid="PSA 37:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Вуйым сакен, чылт пӱгырген,</para>
  <para style="q1" vid="PSA 37:7">кече мучко мый ойган коштам.<verse eid="PSA 37:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Вет мыйын уло кӧргем йӱла,</para>
  <para style="q1" vid="PSA 37:8">капыштем уке корштыдымо вер.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Вием пытен, ӱнарем кодын огыл,</para>
  <para style="q1" vid="PSA 37:9">чон йӧсӧ дене чот кычкырем.<verse eid="PSA 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Господь, чыла кумыл шонымем – Тыйын ончылнет,</para>
  <para style="q1" vid="PSA 37:10">нелын шӱлымем Тыйын пылышет колеш.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Шӱмем чытыра, кодын огыл вием,</para>
  <para style="q1" vid="PSA 37:11">шинчам волгыдым начарын ужеш.<verse eid="PSA 37:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Йолташ ден лишыл еҥем-влак,</para>
  <para style="q2" vid="PSA 37:12">мыйын орлыкем ужын, кораҥыт,</para>
  <para style="q1" vid="PSA 37:12">родем-шамычат тораште шогат.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Чонемым кычалше-влак мылам лӧдым шындылыт,</para>
  <para style="q1" vid="PSA 37:13">осалым шонышо-влак мыйым пушташ кутырат,</para>
  <para style="q1" vid="PSA 37:13">кузе ондалаш манын, кажне кечын шонат.<verse eid="PSA 37:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />А мый пуйто соҥгыра улам – нимом ом кол,</para>
  <para style="q1" vid="PSA 37:14">пуйто йылмыдыме – умшам ом поч.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Лийынам мый тугай айдеме, кӧ огеш кол,</para>
  <para style="q1" vid="PSA 37:15">кӧн умшаштыже уке вашмут.<verse eid="PSA 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Вет мый, Господь, Тыйым вучем;</para>
  <para style="q1" vid="PSA 37:16">Тый вашештет мылам, Господь, мыйын Юмем.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Каласенам мый: [тушманем-влак] ойгемлан ынышт йывырте,</para>
  <para style="q1" vid="PSA 37:17">йолем тайныштме годым ончылнем ынышт кугешне.<verse eid="PSA 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Мый теве-теве камвозам,</para>
  <para style="q1" vid="PSA 37:18">орлыкем эре пеленем.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Осал пашамым почын ойлем,</para>
  <para style="q1" vid="PSA 37:19">сулык ыштымемлан ойгырем.<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />А тушманем-влак илат, вийым погат,</para>
  <para style="q1" vid="PSA 37:20">амал деч посна мыйым ужмышудымо-влак шукын улыт.<verse eid="PSA 37:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Сайым ыштымемлан нуно осал дене пӧртылтат,</para>
  <para style="q1" vid="PSA 37:21">порым ышташ тыршымемлан мыйын ваштареш шогат.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Господь, мыйын Юмем! Мыйым ит кодо,</para>
  <para style="q1" vid="PSA 37:22">ит лий мый дечем тораште!<verse eid="PSA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Господь, мыйын Утарышем,</para>
  <para style="q1" vid="PSA 37:23">мыланем полшаш вашке!<verse eid="PSA 37:23" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="cl">38 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 38:1" />Хор вуйлатыше Идифунлан. Давидын псаломжо.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Каласенам мый:</para>
  <para style="q1" vid="PSA 38:2">коштмо корнемым эскераш тӱҥалам,</para>
  <para style="q1" vid="PSA 38:2">йылмемлан ом пу сулыкым ышташ,</para>
  <para style="q1" vid="PSA 38:2">ончылнем осал еҥ улмо годым умшамым суралем.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Мый йылмыдыме, йӱкдымӧ лийынам,</para>
  <para style="q1" vid="PSA 38:3">эсогыл сай нерген ойлен омыл,</para>
  <para style="q1" vid="PSA 38:3">да ойгем эшеат кугемын.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Шӱмемже кӧргыштем йӱлаш тӱҥалын,</para>
  <para style="q1" vid="PSA 38:4">чот шонкалымем дене тул эшеат вияҥын.</para>
  <para style="q1" vid="PSA 38:4">Тунам умшам гыч мут-влак лектыч:<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />«Полшо умылаш, Господь, мыйын ӱмырем,</para>
  <para style="q1" vid="PSA 38:5">мыняр кечым мыланем шотлымо:</para>
  <para style="q1" vid="PSA 38:5">мылам палашлан – могай кӱчык илышем.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Шеч наре пуэнат Тый илышашлык кечым,</para>
  <para style="q1" vid="PSA 38:6">уло илышемже Тыйын ончылнет – уке дене иктак,</para>
  <para style="q1" vid="PSA 38:6">кажне айдемын илышыже – ик шӱлалтыш дене иктак.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Ӱмыл семын коштеш вет айдеме,</para>
  <para style="q1" vid="PSA 38:7">тырша тудо чылтак арам,</para>
  <para style="q1" vid="PSA 38:7">пога да ок пале – кӧлан чыла тиде логалеш.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />А кызытше мылам мом вучыман, Господь?</para>
  <para style="q1" vid="PSA 38:8">Лач Тыланет мый инанен илем.<verse eid="PSA 38:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Утаре мыйым чыла закондымылыкем деч,</para>
  <para style="q1" vid="PSA 38:9">ит пу мыйым ушдымо еҥлан мыскылаш.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Мый йылмыдыме лийынам, ом поч умшамым,</para>
  <para style="q1" vid="PSA 38:10">вет чыла тиде – Тый дечет.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Кораҥде мый дечем кидетым –</para>
  <para style="q1" vid="PSA 38:11">кырыметым мый тетла чытен ом керт.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Тый айдемым сулыкшылан шылталет, мут кучаш шогалтет гын,</para>
  <para style="q1" vid="PSA 38:12">мом тудо йӧратен ила – когарш кочмо семын пыта,</para>
  <para style="q1" vid="PSA 38:12">вет айдемын илышыже – ик шӱлалтыш дене иктак!<verse eid="PSA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Господь, кол мыйын кумалмем,</para>
  <para style="q1" vid="PSA 38:13">колышт сӧрвален кычкырымем,</para>
  <para style="q1" vid="PSA 38:13">шинчавӱдем ужмеке, шып ит шого.</para>
  <para style="q1" vid="PSA 38:13">Вет Тыйын ончылнет мый ача-кочам-влак семынак</para>
  <para style="q2" vid="PSA 38:13">кусныл коштшо ӧрдыжъеҥ улам.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Ит ончо шыдын ӱмбакем,</para>
  <para style="q1" vid="PSA 38:14">тышечын кайымем да уке лиймем деч ончыч</para>
  <para style="q1" vid="PSA 38:14">тек мый кеч изишак куанем».<verse eid="PSA 38:14" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="cl">39 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 39:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Господьым мый вучен иленам,</para>
  <para style="q1" vid="PSA 39:2">да Тудо мый декем лап лийын,</para>
  <para style="q1" vid="PSA 39:2">полышым йодын кычкырымем колын.<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />Луктын мыйым шучко вынем гыч,</para>
  <para style="q1" vid="PSA 39:3">лӱҥген шинчыше лӱкӧ куп гыч,</para>
  <para style="q1" vid="PSA 39:3">йолем кӱ курык ӱмбак шогалтен,</para>
  <para style="q1" vid="PSA 39:3">йолтошкалтышем пеҥгыдемден,<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />у мурым умшашкем пыштен –</para>
  <para style="q1" vid="PSA 39:4">мемнан Юмыланна моктеммурым.</para>
  <para style="q1" vid="PSA 39:4">Шукын тидым ужыт да лӱдыт,</para>
  <para style="q1" vid="PSA 39:4">Господьлан инанаш тӱҥалыт.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Пиалан тудо айдеме, кӧ Господьлан инана,</para>
  <para style="q1" vid="PSA 39:5">кӧ кугешныше, шояк корныш шогалше дене ок ушно.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Господь, мыйын Юмем!</para>
  <para style="q1" vid="PSA 39:6">Шуко Тыйын ӧрыктарыше пашат,</para>
  <para style="q1" vid="PSA 39:6">мемнан шотышто мом ышташ шонымет!</para>
  <para style="q1" vid="PSA 39:6">Мый нунын нерген увертарынем ыле,</para>
  <para style="q1" vid="PSA 39:6">но ок лий нуным шотлен пытараш.</para>
  <para style="q1" vid="PSA 39:6">Кӧ эше Тый гает уло?!<verse eid="PSA 39:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />Надыр ден пӧлекым Тый ынет нал,</para>
  <para style="q1" vid="PSA 39:7">йӱлалтен пуымо вольык ден сулык верч надырым йодын отыл,</para>
  <para style="q1" vid="PSA 39:7">но мылам колын кертше пылышым пуэнат.<note caller="*" style="f"><char style="fr" closed="false">39:7 </char><char style="ft" closed="false">«Мылам колын кертше пылышым пуэнат»: Септуагинтын южо кидвозышыштыжо «мылам капым ямдыленат».</char></note><verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Тунам каласенам: теве мый толынам,</para>
  <para style="q1" vid="PSA 39:8">книгаште мыйын нергенем возымо.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Юмем, мый Тыйын шоныметым шуктынем,</para>
  <para style="q1" vid="PSA 39:9">Тыйын законет мыйын шӱмыштем.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Кугу погынымаште Тыйын чынле улмет нерген увертаренам,</para>
  <para style="q1" vid="PSA 39:10">ойлымем мый чарнен омыл –</para>
  <para style="q1" vid="PSA 39:10">Господь, Тый тидым палет.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Тыйын чынле улмет нерген шып лийын омыл,</para>
  <para style="q1" vid="PSA 39:11">ӱшанле улмет да утарымашет нерген мый ойленам.</para>
  <para style="q1" vid="PSA 39:11">Тыйын порылыкет ден йӧратымашет нерген</para>
  <para style="q2" vid="PSA 39:11">кугу погынымаш ончылно ойлыде кодын омыл.<verse eid="PSA 39:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />Господь, порылыкетым ит нал мый дечем,</para>
  <para style="q1" vid="PSA 39:12">тек Тыйын чаманымашет ден чынет мыйым шогат арален.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Шотлен пытарыдыме ойго мыйым авырен,</para>
  <para style="q1" vid="PSA 39:13">сулыкем-влак мыйым поктен шуыныт,</para>
  <para style="q1" vid="PSA 39:13">нимом мый ужынат ом керт.</para>
  <para style="q1" vid="PSA 39:13">Титакем-влак вуйысо ӱпем деч шукырак улыт,</para>
  <para style="q1" vid="PSA 39:13">шӱмемым лӱдмаш авалтен.<verse eid="PSA 39:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 39:14" />Поро лий, Господь, утаре!</para>
  <para style="q1" vid="PSA 39:14">Господь, мылам полшаш вашке!<verse eid="PSA 39:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 39:15" />Чонемлан колымашым кычалше-влак чылан</para>
  <para style="q2" vid="PSA 39:15">тек вожылыт да намысыш пурат!</para>
  <para style="q1" vid="PSA 39:15">Мыланем осалым шонышо-шамыч</para>
  <para style="q2" vid="PSA 39:15">тек мӧҥгеш савырыме да воштылчыкыш лукмо лийыт!<verse eid="PSA 39:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 39:16" />Мыланем «Тыгак кӱлеш! Тыгак кӱлеш!» манын ойлышо-влак</para>
  <para style="q2" vid="PSA 39:16">тек намысыш пурымышт деч ӧрткат.<verse eid="PSA 39:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 39:17" />Тек Тыйым кычалше-влак чылан Тылат куанен йывыртат,</para>
  <para style="q1" vid="PSA 39:17">Тыйын утарымашетым йӧратыше-влак чарныде ойлат:</para>
  <para style="q1" vid="PSA 39:17">«Господь кӱдыратле!»<verse eid="PSA 39:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 39:18" />Мый улам незер да йорло,</para>
  <para style="q1" vid="PSA 39:18">но Господь мыланем полша.</para>
  <para style="q1" vid="PSA 39:18">Тый мыйын полышем, утарышем улат!</para>
  <para style="q1" vid="PSA 39:18">Мыйын Юмем! Тол, ит шуйкале.<verse eid="PSA 39:18" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="cl">40 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 40:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Пиалан тудо еҥ, кӧ незер [ден йорло] нерген шона!</para>
  <para style="q1" vid="PSA 40:2">Неле-йӧсӧ кечын тудым Господь утара.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />Господь тудым сакла, илышыжым арален кода,</para>
  <para style="q1" vid="PSA 40:3">мланде ӱмбалне тудо пиалан лиеш.</para>
  <para style="q1" vid="PSA 40:3">Тый тудым тушман кидыш от пу.<verse eid="PSA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Черланен кийымыж годым Господь пеҥгыдемда,</para>
  <para style="q1" vid="PSA 40:4">йӧсланен кийыме верже гыч тудым кынелта.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Каласенам мый: серлаге, Господь, мыйым паремде –</para>
  <para style="q1" vid="PSA 40:5">Тыйын ончылнет сулыкыш пуренам.<verse eid="PSA 40:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Тушманем-влак мыйын нерген кутырат осалым:</para>
  <para style="q1" vid="PSA 40:6">«Кунам тудо кола да лӱмжӧ йомеш?»<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Кӧ мыйым ужаш толеш гын, кутыра шоякым,</para>
  <para style="q1" vid="PSA 40:7">ушыж дене удам шона,</para>
  <para style="q1" vid="PSA 40:7">да лекмекше, тидымак ойлыштеш.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Чыланат, кӧмытын мыйым ужмышт ок шу,</para>
  <para style="q1" vid="PSA 40:8">шке коклаштышт йыштак мыйын ваштареш кутырат,</para>
  <para style="q1" vid="PSA 40:8">мый денем уда лиймым вучат:<verse eid="PSA 40:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />«Ала-мо осал тудым сеҥен –</para>
  <para style="q1" vid="PSA 40:9">пурен возын тудо, тетла ок кынел».<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Эсогыл лишыл йолташем, кӧлан ӱшаненам,</para>
  <para style="q1" vid="PSA 40:10">кӧ мый денем пырля киндым кочкын,</para>
  <para style="q1" vid="PSA 40:10">ынде ӱмбакем йолтаганжым нӧлталын.<verse eid="PSA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Но Тый, Господь, серлаге мыйым да кынелте,</para>
  <para style="q1" vid="PSA 40:11">тунам мый пӧртылтем нунылан.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Тушманлан мыйым сеҥаш да куанаш от пу гын,</para>
  <para style="q1" vid="PSA 40:12">палаш тӱҥалам: мый декем Тый поро кумылан улат.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />А мыйым титакдыме улмемлан кӧра арален кодет</para>
  <para style="q1" vid="PSA 40:13">да чурий ончыкет курымешлан шогалтет.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Тек моктымо лиеш Господь, Израильын Юмыжо,</para>
  <para style="q1" vid="PSA 40:14">курым-курымеш! Аминь, аминь!<verse eid="PSA 40:14" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="cl">41 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 41:1" />Хор вуйлатышылан. Корей эрге-влакын туныктымашышт.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />Кузе пӱчӧ вӱдйогыным кычалеш,</para>
  <para style="q1" vid="PSA 41:2">тыгак чонемже Тый декет, Юмем, шупшеш!<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Юмо дек, илыше Юмо дек мыйын чонем шупшеш:</para>
  <para style="q1" vid="PSA 41:3">кунам гын мый Юмын чурий ончык миен шогалам?<verse eid="PSA 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Шинчавӱдем йӱдшӧ-кечыже лийын мыйын киндем,</para>
  <para style="q1" vid="PSA 41:4">ойлат мылам кажне кечын: «Кушто тыйын Юмет?»<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Тидым шарналтем да шӱм-чонем почам:</para>
  <para style="q1" vid="PSA 41:5">коштынам мый шуко калык коклаште,</para>
  <para style="q1" vid="PSA 41:5">пайремлыше калыкын куан йӱкшӧ да моктеммурыж дене</para>
  <para style="q1" vid="PSA 41:5">мый Юмын пӧртыш коштынам.<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Мом тый, чонем, ойгырет да мом азапланет?</para>
  <para style="q1" vid="PSA 41:6">Инане Юмылан! Мый Тудым эше мокташ тӱҥалам –</para>
  <para style="q1" vid="PSA 41:6">мыйын Утарышемым, мыйын Юмемым!<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Ойгыра мыйын кӧргыштем чонем –</para>
  <para style="q1" vid="PSA 41:7">Иордан мландыште, Ермон ден Мицар курыклаште</para>
  <para style="q1" vid="PSA 41:7">мый Тыйын нергенет шарналтем.<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />Тыйын вӱдшуҥгалтыш-влакетын гӱжлымышт дене</para>
  <para style="q2" vid="PSA 41:8">пундашдыме ик келгыт весым ӱжеш;</para>
  <para style="q1" vid="PSA 41:8">Тыйын вӱдшор ден толкынет-влак мыйын ӱмбачем эртеныт.<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Кечывалым Господь ончыкта шке порылыкшым,</para>
  <para style="q1" vid="PSA 41:9">а йӱдым мый Тудлан мурым мурем,</para>
  <para style="q1" vid="PSA 41:9">илышым пуышо Юмемлан кумалам.<verse eid="PSA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Каласем Юмылан, аралтышемлан:</para>
  <para style="q1" vid="PSA 41:10">молан Тый мыйым монденат?</para>
  <para style="q1" vid="PSA 41:10">Молан тушманын шыгыремдымыжлан ойгырен коштам?<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Тушманем-влак мыйым шӱктарат,</para>
  <para style="q1" vid="PSA 41:11">чыла луэм пудыргымыла чучеш.</para>
  <para style="q1" vid="PSA 41:11">Вет кажне кечын мыланем ойлат:</para>
  <para style="q1" vid="PSA 41:11">«Кушто тыйын Юмет?»<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Мом тый, чонем, ойгырет да мом азапланет?</para>
  <para style="q1" vid="PSA 41:12">Инане Юмылан! Мый Тудым эше мокташ тӱҥалам –</para>
  <para style="q1" vid="PSA 41:12">мыйын Утарышемым, мыйын Юмемым!<verse eid="PSA 41:12" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="cl">42 ПСАЛОМ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Юмем, мылам чын судым ыште,</para>
  <para style="q1" vid="PSA 42:1">Тыйым шотлыдымо калык деч мыйым пыдал нал,</para>
  <para style="q1" vid="PSA 42:1">шояк да чын огыл еҥ деч мыйым утаре!<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Юмем, мыйын аралтышем,</para>
  <para style="q1" vid="PSA 42:2">молан Тый мыйым коденат?</para>
  <para style="q1" vid="PSA 42:2">Молан тушманын шыгыремдымыжлан ойгырен коштам?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Колто волгыдетым да чынетым,</para>
  <para style="q1" vid="PSA 42:3">тек нуно мыйым вӱден наҥгаят,</para>
  <para style="q1" vid="PSA 42:3">святой курыкышкет, Тыйын илыме верышкет кондат.<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Миен шогалам Юмын жертвенникше дек,</para>
  <para style="q1" vid="PSA 42:4">мыланем куан ден йывыртымашым пуышо Юмо дек.</para>
  <para style="q1" vid="PSA 42:4">Юмем, мыйын Юмем, Тыйым кӱсле дене чапландараш тӱҥалам!<verse eid="PSA 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Мом тый, чонем, ойгырет да мом азапланет?</para>
  <para style="q1" vid="PSA 42:5">Инане Юмылан! Мый Тудым эше мокташ тӱҥалам,</para>
  <para style="q1" vid="PSA 42:5">мыйын Утарышемым, мыйын Юмемым!<verse eid="PSA 42:5" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="cl">43 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 43:1" />Хор вуйлатышылан. Корей эрге-влакын туныктымашышт.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Юмына, ме шке пылышна дене колынна –</para>
  <para style="q1" vid="PSA 43:2">ача-кочана-влак мыланна каласкаленыт,</para>
  <para style="q2" vid="PSA 43:2">мом Тый нунын илыме жапыште, акрет кечылаште, ыштенат.<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Шке кидет дене Тый калык-влакым пытаренат,</para>
  <para style="q1" vid="PSA 43:3">нунын мландешышт ача-кочана-влакым вераҥденат,</para>
  <para style="q1" vid="PSA 43:3">кырен шалатенат йот тукым-влакым, нуным поктен колтенат.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Шке кердышт дене огыл ачана-влак мландым налыныт,</para>
  <para style="q1" vid="PSA 43:4">шке вийышт огыл нунылан сеҥымашым конден,</para>
  <para style="q1" vid="PSA 43:4">а Тыйын кидет, вий-куатет да волгыдо чуриет,</para>
  <para style="q1" vid="PSA 43:4">вет Тый нунын дек поро кумылан лийынат.<verse eid="PSA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Тый Юмем, мыйын Кугыжам улат!</para>
  <para style="q1" vid="PSA 43:5">Пу Иаковлан сеҥымашым.<verse eid="PSA 43:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 43:6" />Тый денет ӧрген чактарена тушманым,</para>
  <para style="q1" vid="PSA 43:6">Тыйын лӱмет дене тошкена мемнан ваштареш шогалшым.<verse eid="PSA 43:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 43:7" />Мый шке пикшемлан ом ӱшане,</para>
  <para style="q1" vid="PSA 43:7">кердем мыйым ок утаре.<verse eid="PSA 43:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 43:8" />Тый мемнам тушман деч утарет,</para>
  <para style="q1" vid="PSA 43:8">мемнам ужмышудымо-влакым намысыш пуртет.<verse eid="PSA 43:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 43:9" />Кажне кечын ме Юмо дене моктанена,</para>
  <para style="q1" vid="PSA 43:9">лӱметым курымеш мокташ тӱҥалына.<verse eid="PSA 43:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 43:10" />Но кызыт Тый мемнам кодышыч, вожылмашыш пуртышыч,</para>
  <para style="q1" vid="PSA 43:10">сарзына-влак дене пырля шыч лек кредалаш.<verse eid="PSA 43:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 43:11" />Тый мемнам тушман деч куржыктышыч,</para>
  <para style="q1" vid="PSA 43:11">мемнам ужмышудымо-влак погынам агат.<verse eid="PSA 43:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 43:12" />Шорык семын пуышыч мемнам шӱшкылаш,</para>
  <para style="q1" vid="PSA 43:12">калык коклашке шалатышыч мемнам.<verse eid="PSA 43:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 43:13" />Парышым налде, калыкет ужалышыч,</para>
  <para style="q1" vid="PSA 43:13">шулдо ак дене Тый пуышыч.<verse eid="PSA 43:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 43:14" />Пошкудына-влаклан мемнам Тый пуышыч мыскылаш,</para>
  <para style="q1" vid="PSA 43:14">мемнан йыр илыше-шамычлан – вурсаш да воштылаш.<verse eid="PSA 43:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 43:15" />Калык-влак коклаште мемнам воштылчыкым ыштышыч,</para>
  <para style="q1" vid="PSA 43:15">йот тукым-влак вуйыштым мыланна воштыл рӱзалтат.<verse eid="PSA 43:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 43:16" />Кече мучко чытем мыскылымашым,</para>
  <para style="q1" vid="PSA 43:16">чуриемым вожылмаш леведеш –<verse eid="PSA 43:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 43:17" />колам шӱктарымым, игылтмым,</para>
  <para style="q1" vid="PSA 43:17">тушман да ӱчым шуктышо-влак ӱмбакем шӧрын ончат.<verse eid="PSA 43:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 43:18" />Чыла тиде мемнан дене лийын,</para>
  <para style="q1" vid="PSA 43:18">но ме Тыйым монден огынал,</para>
  <para style="q1" vid="PSA 43:18">пудыртен огынал ойпидышетым,<verse eid="PSA 43:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 43:19" />шӱмна Тый дечет кораҥын огыл,</para>
  <para style="q1" vid="PSA 43:19">йолна Тыйын корнет деч ӧрдыжкӧ каен огыл.<verse eid="PSA 43:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 43:20" />Тулпире-влакын мландыштышт мемнам Тый кырышыч,</para>
  <para style="q1" vid="PSA 43:20">колымашын ӱмылжӧ дене мемнам леведыч.<verse eid="PSA 43:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 43:21" />Шке Юмынам монден,</para>
  <para style="q1" vid="PSA 43:21">вес юмо дек киднам нӧлтална гын,<verse eid="PSA 43:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 43:22" />Юмо тидым пален ок нал ыле мо?</para>
  <para style="q1" vid="PSA 43:22">Вет Тудо шӱмын чыла шолыпшым пала.<verse eid="PSA 43:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 43:23" />Тылат верч мемнам кажне кечын пуштедат,</para>
  <para style="q1" vid="PSA 43:23">шӱшкылшаш шорыклан шотлат.<verse eid="PSA 43:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 43:24" />Помыжалт, Господь, молан Тый малет?</para>
  <para style="q1" vid="PSA 43:24">Кынел, курымешлан мемнам ит кудалте.<verse eid="PSA 43:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 43:25" />Молан Тый чуриетым шылтет,</para>
  <para style="q1" vid="PSA 43:25">орлыкнам, шыгыремдалт илымынам мондет?<verse eid="PSA 43:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 43:26" />Мемнан чонна пуракыште кия,</para>
  <para style="q1" vid="PSA 43:26">капна мландыш пижын шинчын.<verse eid="PSA 43:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 43:27" />Кынел, Господь, полшаш мыланна,</para>
  <para style="q1" vid="PSA 43:27">порылыкетлан кӧра мемнам утаре!<verse eid="PSA 43:27" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="cl">44 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 44:1" />Хор вуйлатышылан. «Лилий-влак» семлан возымо. Корей эрге-влакын туныктымашышт. Йӧратымаш муро.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Сӧрал шомак шӱмем гыч йоген лекте.</para>
  <para style="q1" vid="PSA 44:2">Каласем мый: шке мурем кугыжалан пӧлеклем,</para>
  <para style="q1" vid="PSA 44:2">йылмем уста возкалышын пераж гай.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Чыла айдеме деч сӧрал улат тый,</para>
  <para style="q1" vid="PSA 44:3">суапле шомак умшат гычын лектеш –</para>
  <para style="q1" vid="PSA 44:3">тыге тыйым Юмо курымешлан суапландарен.<verse eid="PSA 44:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Талешке, кыдалышкет кердетым сакалте,</para>
  <para style="q1" vid="PSA 44:4">ончыкто чапет ден виет.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Куатет дене чаплане,</para>
  <para style="q1" vid="PSA 44:5">чынлык, ӱҥышӧ лиймаш да чын ыштымаш верч</para>
  <para style="q2" vid="PSA 44:5">кудалын лек тый кредалаш.</para>
  <para style="q1" vid="PSA 44:5">Тек тыйын пурла кидет ӧрыктарыше пашам ончыкта.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />[Талешке!] Пикшет-влак пӱсӧ улыт,</para>
  <para style="q1" vid="PSA 44:6">тушман-влакетын шӱмышкышт нуно керылтыт –</para>
  <para style="q1" vid="PSA 44:6">Тыйын ончылнет, Кугыжа, калык-влак йӧралтыт.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Юмем, Тыйын престолет курым-курымеш,</para>
  <para style="q1" vid="PSA 44:7">Тыйын кугыжан тоят – чынлык тоя.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Тый чын ыштымым йӧратет,</para>
  <para style="q1" vid="PSA 44:8">закондымылыкым ужмет ок шу.</para>
  <para style="q1" vid="PSA 44:8">Сандене Юмо, тыйын Юмет, куан ӱй дене тыйым</para>
  <para style="q2" vid="PSA 44:8">пеленет улшо-влак деч утларак шӱрен.<verse eid="PSA 44:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Тыйын чыла вургемет смирна, алой да кассий пушан улыт;</para>
  <para style="q1" vid="PSA 44:9">слон лу дене сӧрастарыме полатла гыч тыйым кӱсле йӱк веселаҥда.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Кугыжан ӱдыр-шамыч полатыштет пагалыме ӱдырамаш-влак коклаште улыт,</para>
  <para style="q1" vid="PSA 44:10">Офирысе шӧртньым чийыман кугыжанвате пурла могырыштет шога.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Колышт, ӱдыр, да ончо, пылышетым савыре –</para>
  <para style="q1" vid="PSA 44:11">калыкетым, шке ачатын пӧртшым мондо.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Тыйын моторлыкетлан кугыжан шӱм-чонжо ылыжеш,</para>
  <para style="q1" vid="PSA 44:12">тудо – тыйын озат, тудлан вуетым саве.<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Тир ӱдыр толеш пӧлек дене,</para>
  <para style="q2" vid="PSA 44:13">калык кокла гыч эн поян-шамычат</para>
  <para style="q1" vid="PSA 44:13">тыйын поро кумылетым тӱҥалыт кычалаш.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Кугыжан налшаш ӱдыржӧ полатыш мия, тудо пеш сӧрал,</para>
  <para style="q1" vid="PSA 44:14">вургемже шӧртньӧ дене тӱрлымӧ.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Сынле<note caller="*" style="f"><char style="fr" closed="false">44:15 </char><char style="ft" closed="false">Сынле – яркий, красочный.</char></note> вургеманым тудым кугыжа дек кондат,</para>
  <para style="q1" vid="PSA 44:15">а почешыже – йолташ ӱдыржӧ-влакым.<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />Куанен да йывыртен нуным кондат,</para>
  <para style="q1" vid="PSA 44:16">кугыжан полатышке нуно пурат.<verse eid="PSA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Кугыжа, тыйын эргыч-влак ача-кочат-шамычым алмаштат,</para>
  <para style="q1" vid="PSA 44:17">пӱтынь мланде мучко нуным вуйлатышылан шогалтет.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Лӱметым тукым гыч тукымыш мондалтдымым ыштем,</para>
  <para style="q1" vid="PSA 44:18">калык-влак мокташ тӱҥалыт тыйым курым-курымеш.<verse eid="PSA 44:18" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="cl">45 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 45:1" />Хор вуйлатышылан. Корей эрге-влакын мурышт. Вичкыж йӱкын мурыман.<verse eid="PSA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Юмо мыланна – аралтыш да куат,</para>
  <para style="q1" vid="PSA 45:2">йӧсӧ лийме годым вашке полшышо.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Сандене ме огына лӱд, кеч мланде чытырналтше,</para>
  <para style="q1" vid="PSA 45:3">курык-влак теҥыз келгытыш порволышт,<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />кеч тудын вӱдшӧ шаулыжо, шоҥешталтше</para>
  <para style="q1" vid="PSA 45:4">да лӱшкымыж деч курык-влак чытырнышт.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Эҥер вӱдйогын-влак веселаҥдат Юмын олажым,</para>
  <para style="q1" vid="PSA 45:5">Чыла деч Кӱшылысын святой илыме вержым.<verse eid="PSA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />Юмо – ола покшелне, тудо ок чытырне,</para>
  <para style="q1" vid="PSA 45:6">эрден эрак тӱҥалын, полша Юмо тудлан.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Калык-влак пудыранат,</para>
  <para style="q1" vid="PSA 45:7">кугыжаныш-влак чытырнат,</para>
  <para style="q1" vid="PSA 45:7">[Чыла деч Кӱшылысын] йӱкшӧ деч мланде лӱҥгалтеш.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Господь Саваоф – мемнан дене,</para>
  <para style="q1" vid="PSA 45:8">Иаковын Юмыжо мемнам арала.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Толза да Господьын мом ыштымыжым ончалза,</para>
  <para style="q1" vid="PSA 45:9">ӧрыктарыше паша-влакым Тудо мландымбалне ыштен.<verse eid="PSA 45:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Господь мланде тӱр марте сар-влакым чарен:</para>
  <para style="q1" vid="PSA 45:10">йоҥежым туген, умдым пудыртен,</para>
  <para style="q1" vid="PSA 45:10">сарлык орва-влакым тул дене йӱлалтен.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />«Чарнен шогалза да пален налза: Мый Юмо улам,</para>
  <para style="q1" vid="PSA 45:11">калык-влак деч кӱшнӧ,</para>
  <para style="q1" vid="PSA 45:11">уло мланде ӱмбалне эн кугу улам».<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Господь Саваоф – мемнан дене,</para>
  <para style="q1" vid="PSA 45:12">Иаковын Юмыжо мемнам арала.<verse eid="PSA 45:12" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="cl">46 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 46:1" />Хор вуйлатышылан. Корей эрге-влакын псаломышт.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Совыдам кырыза, чыла калык,</para>
  <para style="q1" vid="PSA 46:2">Юмылан йывыртен кычкырыза!<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />Вет Чыла деч Кӱшылысӧ Господь лӱдмашым луктеш,</para>
  <para style="q1" vid="PSA 46:3">Тудо уло мландылан кугу Кугыжа.<verse eid="PSA 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Калык-влакым Тудо мемнан кидыш пуэн,</para>
  <para style="q1" vid="PSA 46:4">тукым-шамычым йол йымакына пыштен,<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />мыланна мландым ойырен налын,</para>
  <para style="q1" vid="PSA 46:5">йӧратыме Иаковшын кундемжым пуэн,</para>
  <para style="q1" vid="PSA 46:5">кудыж дене тудо кугешнен илен.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Йывыртен кычкырыме годым Юмо престолыш шинче,</para>
  <para style="q1" vid="PSA 46:6">пуч пуымо йӱк дене Господь кӱшкӧ нӧлталте.<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />Мурыза мемнан Юмылан, мурыза,</para>
  <para style="q1" vid="PSA 46:7">моктыза мемнан Кугыжанам, моктыза!<verse eid="PSA 46:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Вет Юмо – пӱтынь мландын Кугыжаже,</para>
  <para style="q1" vid="PSA 46:8">муро дене Тудым чапландарыза!<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Юмо – чыла калыкын Кугыжаже,</para>
  <para style="q1" vid="PSA 46:9">шке святой престолышкыжо Тудо шинчын.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Авраамын Юмыжын калыкше деке</para>
  <para style="q2" vid="PSA 46:10">калык-влакын онышт погыненыт,</para>
  <para style="q1" vid="PSA 46:10">вет мландысе вуйлатыше-влак<note caller="*" style="f"><char style="fr" closed="false">46:10 </char><char style="ft" closed="false">Вуйлатыше-влак – але: авыртыш-влак.</char></note> Юмын улыт,</para>
  <para style="q1" vid="PSA 46:10">Тудо нунын дечын кӱшнӧ!<verse eid="PSA 46:10" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="cl">47 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 47:1" />Муро. Корей эрге-влакын псаломышт.<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Господь кӱдыратле да чот моктымо</para>
  <para style="q2" vid="PSA 47:2">мемнан Юмынан олаштыже, шке святой курыкыштыжо.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Тиде – сӧрал да кӱкшӧ вер, уло мландын куанже,</para>
  <para style="q1" vid="PSA 47:3">Сион курык – кӱдыратле Кугыжан олаже,</para>
  <para style="q1" vid="PSA 47:3">тудо – йӱдвелысе тора курык гай.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Тиде олан карманыштыже Юмым</para>
  <para style="q2" vid="PSA 47:4">чоткыдо аралтыш семын палат.<verse eid="PSA 47:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Теве кугыжа-влак погынен толыныт,</para>
  <para style="q1" vid="PSA 47:5">ола ӱмбаке кержалташ шонен пыштеныт.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Мом нуно ужыныт – ӧрмашым луктын,</para>
  <para style="q1" vid="PSA 47:6">нуно пудыраненыт, куржыныт мӧҥгеш.<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />Тушто нуным авалтен лӱдмаш,</para>
  <para style="q1" vid="PSA 47:7">ӱдырамашын азам ыштымыж годсо гай орланымаш –<verse eid="PSA 47:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />эрвел мардежын Фарсис корабль-влакым шалатымыж семын</para>
  <para style="q1" vid="PSA 47:8">нуным Тый пытаренат.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Мо нерген колынна, тудымак Господь Саваофын олаштыже,</para>
  <para style="q2" vid="PSA 47:9">мемнан Юмынан олаштыже, ужынна –</para>
  <para style="q1" vid="PSA 47:9">курымешлан тудым Юмо пеҥгыдемден.<verse eid="PSA 47:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 47:10" />Юмына, ме Тыйын храмыштет</para>
  <para style="q2" vid="PSA 47:10">Тыйын порылыкет нерген шонкалена.<verse eid="PSA 47:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 47:11" />Юмына, лӱмет шарлен чыла вере,</para>
  <para style="q1" vid="PSA 47:11">моктат Тыйым мланде тӱр марте,</para>
  <para style="q1" vid="PSA 47:11">пурла кидет чынлык дене темын.<verse eid="PSA 47:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 47:12" />[Господь], Тыйын чын судет-влаклан</para>
  <para style="q2" vid="PSA 47:12">тек куана Сион курык,</para>
  <para style="q2" vid="PSA 47:12">тек Иудан олаже-влак куанат.<verse eid="PSA 47:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 47:13" />Кайыза Сион йыр, тудым савырныза,</para>
  <para style="q1" vid="PSA 47:13">башньыже-влакым шотлен лекса.<verse eid="PSA 47:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 47:14" />Ончалза тудын пеҥгыде пырдыжшым,</para>
  <para style="q1" vid="PSA 47:14">ончал савырныза карманже-влакым –</para>
  <para style="q1" vid="PSA 47:14">каласкаледа вара ончыкылык тукымлан.<verse eid="PSA 47:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 47:15" />Вет тиде Юмо – курымешлан мемнан Юмына,</para>
  <para style="q1" vid="PSA 47:15">колымешкына мемнам Тудо вӱден наҥгая.<verse eid="PSA 47:15" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="cl">48 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 48:1" />Хор вуйлатышылан. Корей эрге-влакын псаломышт.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />Калык-влак, тидым колыштса,</para>
  <para style="q1" vid="PSA 48:2">тӱнямбалне илыше-шамыч, тӱткын колыштса –<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />тыглай айдеме да лӱмлӧ,</para>
  <para style="q1" vid="PSA 48:3">поян еҥ ден нужнат.<verse eid="PSA 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Умшам луктеш ушан шомакым,</para>
  <para style="q1" vid="PSA 48:4">шӱм шонкалымашем-влак умылаш туныктат.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Мый туштен ойлымаш дек пылышем савырем,</para>
  <para style="q1" vid="PSA 48:5">кӱсле сем почеш муам неле йодышлан вашмутым.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Молан лӱдаш мылам орлык толмо жап годым,</para>
  <para style="q1" vid="PSA 48:6">кунам осаллык мыйым чыла велым авыра?<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Нуно шке вийыштлан ӱшанат,</para>
  <para style="q1" vid="PSA 48:7">шуко поянлыкышт дене моктанат.<verse eid="PSA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Иза-шольыжым айдеме сулен налын ок керт,</para>
  <para style="q1" vid="PSA 48:8">тудлан верч Юмылан акым ок пу.<verse eid="PSA 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Тудын чонжым сулен налаш ак пеш шерге,</para>
  <para style="q1" vid="PSA 48:9">да тидым ышташ ок лий нигунам.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Вет, шӱгарыш логалде,</para>
  <para style="q1" vid="PSA 48:10">курымеш илаш иктат ок код.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Кажныже ужеш: кугу ушан еҥ-влакат колат,</para>
  <para style="q1" vid="PSA 48:11">шотдымо ден ушдымо семынак пытат,</para>
  <para style="q1" vid="PSA 48:11">шке погыштым весылан кодат.<verse eid="PSA 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Кеч нуно мландыштлан шке лӱмыштым пуэныт,</para>
  <para style="q1" vid="PSA 48:12">шӱгар курымешлан нунын пӧртышт,</para>
  <para style="q1" vid="PSA 48:12">тукым гыч тукымыш илемышт лиеш.<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />Чапыште улшо еҥат курымеш ок иле,</para>
  <para style="q1" vid="PSA 48:13">вольык семын тудат пыта.<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Тиде корнышт – ушдымылык,</para>
  <para style="q1" vid="PSA 48:14">кеч почешышт кайыше-влак нунын шонымыштым сайлан шотлат.<verse eid="PSA 48:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 48:15" />Шорык семын нуным поктен пуртат вес тӱняш,</para>
  <para style="q1" vid="PSA 48:15">кӱташ тӱҥалеш нуным колымаш,</para>
  <para style="q1" vid="PSA 48:15">вес кечынак чын ыштыше-влак олмешышт тӱҥалыт озаланаш.</para>
  <para style="q1" vid="PSA 48:15">Нунын вийышт пыта, шӱгар лиеш нунын илыме верышт.<note caller="*" style="f"><char style="fr" closed="false">48:14-15 </char><char style="ft" closed="false">Еврей текстыште нине стих-влакын мом ончыктымыштым умылаш неле.</char></note><verse eid="PSA 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 48:16" />Но Юмо, мыйым Шкеж дек налын,</para>
  <para style="q1" vid="PSA 48:16">вес тӱнян кидше деч чонем утара.<verse eid="PSA 48:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 48:17" />Ит кӧране, кунам айдеме поя,</para>
  <para style="q1" vid="PSA 48:17">кунам пӧртшын чапше кушкеш:<verse eid="PSA 48:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 48:18" />кола тудо – нимом ок нал пеленже,</para>
  <para style="q1" vid="PSA 48:18">чапше ок кай тудын почешыже.<verse eid="PSA 48:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 48:19" />Кеч илымыж годым шкенжым пиаланлан шотлен –</para>
  <para style="q1" vid="PSA 48:19">вет тыйым моктат, кунам тыйын чылажат воранен толеш –<verse eid="PSA 48:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 48:20" />ача-кочаж-влак деке тудо кая,</para>
  <para style="q1" vid="PSA 48:20">кудышт тетла волгыдым огыт уж.<verse eid="PSA 48:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 48:21" />Чапыште лиеш гынат, ок умыло айдеме:</para>
  <para style="q1" vid="PSA 48:21">вольык семын тудат пыта.<verse eid="PSA 48:21" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="cl">49 ПСАЛОМ</para>
  <para style="d">Асафын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Господь – юмо-влакын Юмышт – ойла</para>
  <para style="q1" vid="PSA 49:1">да эрвел гыч касвел марте чыла айдемым ӱжын пога.<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />Чыла дечат сӧрал Сион гыч Юмо волгалт лишемеш,<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />толеш мемнан Юмына, да йӱк деч посна огыл:</para>
  <para style="q1" vid="PSA 49:3">Тудын ончылныжо – чыла пытарыше тул,</para>
  <para style="q1" vid="PSA 49:3">Тудын йырже – тале тӱтан мардеж.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Шке калыкшым судитлымашке</para>
  <para style="q2" vid="PSA 49:4">Тудо пылпомыш ден мландым ӱжеш:<verse eid="PSA 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />«Погыза Мый декем Мыйын ӱшанле-влакем,</para>
  <para style="q1" vid="PSA 49:5">нуно, надырым конден, ыштеныт Мый денем ойпидышым».<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />Пылпомыш увертара Тудын чынлыкшым,</para>
  <para style="q1" vid="PSA 49:6">вет Юмо улеш судья.<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />«Колышт, калыкем, Мый ойлаш тӱҥалам,</para>
  <para style="q1" vid="PSA 49:7">Израиль, Мый ваштарешет таныклем,</para>
  <para style="q1" vid="PSA 49:7">Мый Юмо, тыйын Юмет, улам.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Надырет верч огыл Мый тыйым шылталем,</para>
  <para style="q1" vid="PSA 49:8">йӱлалтен пуымо надырет эре Мыйын ончылнем.<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />Ом нал суртет гыч ӱшкыжым,</para>
  <para style="q1" vid="PSA 49:9">кудывечет гыч казатага-влакымат.<verse eid="PSA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Вет Мыйын улыт чодырасе чыла янлык,</para>
  <para style="q1" vid="PSA 49:10">тӱжемле курык ӱмбалне улшо вольыкат.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Палем курык ӱмбалысе чыла кайыкым,</para>
  <para style="q1" vid="PSA 49:11">нурышто илыше чонан-влакат Мыйын улыт.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Шужем ыле гынат, Мый тылат ом каласе ыле,</para>
  <para style="q1" vid="PSA 49:12">вет тӱня да чыла, мо тушто уло – Мыйын улыт.<verse eid="PSA 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Кочкам мо Мый ӱшкыж шылым,</para>
  <para style="q1" vid="PSA 49:13">казатага вӱрым йӱам мо?<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Кондо Юмылан надыр шотеш моктымашым,</para>
  <para style="q1" vid="PSA 49:14">Чыла деч Кӱшылысылан мом сӧрыметым шукто.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Ӱж Мыйым неле кече годым –</para>
  <para style="q1" vid="PSA 49:15">Мый тыйым утарем,</para>
  <para style="q1" vid="PSA 49:15">тунам тый Мыйым чапландарет».<verse eid="PSA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Сулыкан еҥлан Юмо ойла:</para>
  <para style="q1" vid="PSA 49:16">«Кузе тый Мыйын кӱштымаш-влакем увертараш,</para>
  <para style="q1" vid="PSA 49:16">ойпидышем нерген умшат дене кутыраш тоштат,<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />кунам Мыйын шылталыме мутем дек ужмышудымо улат,</para>
  <para style="q1" vid="PSA 49:17">Мыйын шомакем кӱлдымыш луктат?<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Шолыштшо еҥым ужмек, тудым йолташлан шотлет,</para>
  <para style="q1" vid="PSA 49:18">яжар-влак денат тый келшен илет.<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />Умшатым почат осал мутым ойлаш,</para>
  <para style="q1" vid="PSA 49:19">йылмет ондален кутыркала.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Шинчет да шке иза-шольыч ӱмбак шоякым ойлет,</para>
  <para style="q1" vid="PSA 49:20">аватын эргыж ӱмбак лавырам кышкет.<verse eid="PSA 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 49:21" />Чыла тидым тый ыштылынат – Мый шып лийынам,</para>
  <para style="q1" vid="PSA 49:21">шоналтенат тый: Мый тый гаетак улам.</para>
  <para style="q1" vid="PSA 49:21">Но Мый тыйым мут кучаш шогалтем,</para>
  <para style="q1" vid="PSA 49:21">чыла сулыкетым шинча ончыкет луктам.<verse eid="PSA 49:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 49:22" />Умылыза тидым, Юмым мондышо-влак,</para>
  <para style="q1" vid="PSA 49:22">уке гын Мый тендам пытарем,</para>
  <para style="q1" vid="PSA 49:22">да нигӧ утарыше ок лий.<verse eid="PSA 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 49:23" />Кӧ надыр шотеш моктымашым конда,</para>
  <para style="q1" vid="PSA 49:23">тудо Мыйым жапла,</para>
  <para style="q1" vid="PSA 49:23">кӧ чын корно дене кая,</para>
  <para style="q1" vid="PSA 49:23">тудлан Мый Юмын утарымашыжым ончыктем».<verse eid="PSA 49:23" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="cl">50 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 50:1" />Хор вуйлатышылан. Давидын псаломжо. <verse eid="PSA 50:1" /><verse number="2" style="v" sid="PSA 50:2" />Давид тудым Вирсавия дене мален лекмекше, тудын деке пророк Нафанын толмыж деч вара возен.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Юмем, шке порылыкет дене мыйым серлаге,</para>
  <para style="q1" vid="PSA 50:3">шуко сайлыкет дене осал паша-влакем ӱштын кудалте.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Мушкын колто сулыкем,</para>
  <para style="q1" vid="PSA 50:4">титакем деч мыйым эрыкте.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />Осал паша-влакемым мый палем,</para>
  <para style="q1" vid="PSA 50:5">сулыкемже – эре ончылнем.<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Тыйын, ик Тыйын ваштареш сулыкым ыштенам,</para>
  <para style="q1" vid="PSA 50:6">Тыйын шинча ончылнет осалым ыштенам.</para>
  <para style="q1" vid="PSA 50:6">Тыйын каласымет – чын,</para>
  <para style="q1" vid="PSA 50:6">Тыйын судет – яндар.<verse eid="PSA 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />Сулыкан мый шочынам,</para>
  <para style="q1" vid="PSA 50:7">ава мӱшкыр гыч лекмекак, сулыкан лийынам.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Но Тый шӱмыштӧ чын улмым йӧратет,</para>
  <para style="q1" vid="PSA 50:8">да мыланем шке мунлылыкетым ончыктет.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Ӱмбакем иссоп укш дене шыжыкте – лиям яндар,</para>
  <para style="q1" vid="PSA 50:9">муш мыйым – лиям лум дечат ошо.<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Пу мылам куан ден йывыртыме йӱкым колаш –</para>
  <para style="q1" vid="PSA 50:10">куанат тек луэм-влак, кудыштым Тый шалатенат.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Шке ончалтышетым сулыкем деч кораҥде,</para>
  <para style="q1" vid="PSA 50:11">чыла осал пашамым ӱштын кудалте.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Юмем, кӧргыштем яндар шӱмым ыште,</para>
  <para style="q1" vid="PSA 50:12">шӱлышем уэмде, пеҥгыдемде.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Шке чуриет ончыч мыйым ит кораҥде,</para>
  <para style="q1" vid="PSA 50:13">святой Шӱлышетым мый дечем ит нал.<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Пӧртылтӧ мылам утарыметлан куаным,</para>
  <para style="q1" vid="PSA 50:14">чолга Шӱлышет дене мыйым пеҥгыдемде.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />Тунам мый осалым ыштыше-влакым Тыйын корнетлан туныктем,</para>
  <para style="q1" vid="PSA 50:15">да сулыкан-шамыч Тый декет савырнат.<verse eid="PSA 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Юмем, мыйым утарыше Юмем!</para>
  <para style="q1" vid="PSA 50:16">Вӱр йоктарымаш деч мыйым утаре,</para>
  <para style="q1" vid="PSA 50:16">тунам йылмем Тыйын чынлыкетым куанен мокта.<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Господь! Поч мыйын умшам,</para>
  <para style="q1" vid="PSA 50:17">тунам мый Тыйым чапландарем.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Вольык надырым кондем ыле,</para>
  <para style="q1" vid="PSA 50:18">но тудым Тый ынет нал,</para>
  <para style="q1" vid="PSA 50:18">йӱлалтен пуымо надыр Тылат ок келше.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Юмылан келшыше надыр – кӱрышталтше шӱм-чон,</para>
  <para style="q1" vid="PSA 50:19">кӱрышталтше да ӱҥышемше шӱмым Тый изиэш от уж, Юмем.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Шке порылыкет дене, [Господь,] Сионлан сайлыкым ыште,</para>
  <para style="q1" vid="PSA 50:20">Иерусалимын пырдыжшым угыч нӧлтал.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Тунам келша Тыланет чын надыр,</para>
  <para style="q1" vid="PSA 50:21">йӱлалтен пуымо да пӱтынек пуымо надыр,</para>
  <para style="q1" vid="PSA 50:21">тунам жертвенникышкет самырык ӱшкыж-влакым пыштат.<verse eid="PSA 50:21" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="cl">51 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 51:1" />Хор вуйлатышылан. Давидын туныктымашыже. <verse eid="PSA 51:1" /><verse number="2" style="v" sid="PSA 51:2" />Идумей Доикын Саул деке толмекше да «Ахимелехын пӧртышкыжӧ Давид толын» манын увертарымекше, Давид тидым возен.<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Мом осал пашат дене моктанет, «талешке»?</para>
  <para style="q1" vid="PSA 51:3">Юмын порылыкшо эре мый денем.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Весылан пытымашым кычалеш йылмет,</para>
  <para style="q1" vid="PSA 51:4">бритве гай пӱсӧ тудо, осал чоя айдеме!<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Поро дечын путырак тый осалым,</para>
  <para style="q1" vid="PSA 51:5">чыным ойлымо деч путырак шояклымым йӧратет.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Пытымашыш наҥгайыше мутым,</para>
  <para style="q1" vid="PSA 51:6">чояланыше йылмым тый йӧратет.<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Садланак Юмо тыйым курымешлан пытара,</para>
  <para style="q1" vid="PSA 51:7">пӱтырен куча да омашет гыч луктын шуа,</para>
  <para style="q1" vid="PSA 51:7">илыше-влакын мландышт гыч вожге кукла.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Ужыт тидым чын ыштыше-влак да лӱдыт,</para>
  <para style="q1" vid="PSA 51:8">вара тыйын нергенет воштыл каласат:<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />«Теве айдеме, кӧ Юмым шке аралтышыжлан шотлен огыл,</para>
  <para style="q1" vid="PSA 51:9">а шке кугу поянлыкшылан ӱшанен,</para>
  <para style="q1" vid="PSA 51:9">осал пашаж дене вийым поген».<verse eid="PSA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />А мый Юмын пӧртыштӧ ладыра олив пушеҥге гай улам</para>
  <para style="q1" vid="PSA 51:10">да Юмын порылыкшылан курым-курымеш инанем.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Чыла пашатлан мый Тыйым курымеш моктем,</para>
  <para style="q1" vid="PSA 51:11">инанаш тӱҥалам Тыйын лӱметлан,</para>
  <para style="q1" vid="PSA 51:11">вет Тый шке ӱшанле-влакет дек поро улат.<verse eid="PSA 51:11" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="cl">52 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 52:1" />Хор вуйлатышылан. Пуэн шоктыман семӱзгар дене. Давидын туныктымашыже.<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Ушдымо еҥ шке семынже шона: «Юмо уке».</para>
  <para style="q1" vid="PSA 52:2">Тыгай еҥ-влак пужленыт, ыштат нуно йырнык пашам,</para>
  <para style="q1" vid="PSA 52:2">уке нунын коклаште порым ыштыше.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Пылпомыш гыч Юмо айдеме эрге-влак ӱмбак онча –</para>
  <para style="q1" vid="PSA 52:3">уло мо шонен моштышо, Юмым кычалше?<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Но чыланат кораҥыныт, чылан йӧрдымӧ лийыныт,</para>
  <para style="q1" vid="PSA 52:4">уке порым ыштыше, иктат уке.<verse eid="PSA 52:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Нимат огыт умыло мо осалым ыштыше нине еҥ-влак,</para>
  <para style="q1" vid="PSA 52:5">мыйын калыкемым киндым кочмо семын кочшо</para>
  <para style="q1" vid="PSA 52:5">да Юмын лӱмжым ӱжде илыше-влак?<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Тудо верыште, кушто лӱдмаш уке,</para>
  <para style="q2" vid="PSA 52:6">нуным пеш кугу лӱдмаш авалта.</para>
  <para style="q1" vid="PSA 52:6">Тыйым шыгыремдылше-влакын лулегыштым Юмо шалатен кышка.</para>
  <para style="q1" vid="PSA 52:6">Намысыш пуртет тый нуным,</para>
  <para style="q1" vid="PSA 52:6">вет Юмо нуным Шкеж деч кораҥден.<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />Сион гыч Израильлан утарымаш толжо ыле!</para>
  <para style="q1" vid="PSA 52:7">Куана Иаков, Израиль йывырта,</para>
  <para style="q1" vid="PSA 52:7">кунам пленыште улшо калыкшым Юмо мӧҥгеш пӧртылта.<verse eid="PSA 52:7" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="cl">53 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 53:1" />Хор вуйлатышылан. Кылан семӱзгар дене. Давидын туныктымашыже. <verse eid="PSA 53:1" /><verse number="2" style="v" sid="PSA 53:2" />Тудым Давид зифей-влакын Саул деке толмышт да «Давид мемнан дене шылын» манмышт деч вара возен.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Юмем, лӱметын вийже дене мыйым утаре,</para>
  <para style="q1" vid="PSA 53:3">шке куатет дене мылам чын судым ыште!<verse eid="PSA 53:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Юмем! Кол мыйын кумалмем,</para>
  <para style="q1" vid="PSA 53:4">умшам гыч лекше мутым колышт,<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />вет йот еҥ-влак ваштарешем шогалыныт,</para>
  <para style="q1" vid="PSA 53:5">чаманыдыме-шамыч мыйым пуштнешт –</para>
  <para style="q1" vid="PSA 53:5">уке нунын ушыштышт Юмо.<verse eid="PSA 53:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Но Юмо мыланем полша,</para>
  <para style="q1" vid="PSA 53:6">Господь чонем пеҥгыдемда.<verse eid="PSA 53:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 53:7" />Тушман-влакын осалыштым Тудо вуй ӱмбакышт пӧртылта.</para>
  <para style="q1" vid="PSA 53:7">Шке чынлыкет почеш нуным пытаре.<verse eid="PSA 53:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 53:8" />Шке кумылын Тылат мый надырым кондем,</para>
  <para style="q1" vid="PSA 53:8">Господь, Тыйын лӱметым моктем,</para>
  <para style="q1" vid="PSA 53:8">вет тудо поро.<verse eid="PSA 53:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 53:9" />Тый мыйым чыла ойгем деч утарышыч,</para>
  <para style="q1" vid="PSA 53:9">тушман ӱмбаке шинчам куанен онча.<verse eid="PSA 53:9" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="cl">54 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 54:1" />Хор вуйлатышылан. Кылан семӱзгар дене. Давидын туныктымашыже.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Юмем, мыйын кумалмемым кол,</para>
  <para style="q1" vid="PSA 54:2">сӧрвалымем деч ит шыл,<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 54:3-4" />колышт мыйым да вашеште!</para>
  <para style="q1" vid="PSA 54:3-4">Чонемым ойго туржеш,</para>
  <para style="q1" vid="PSA 54:3-4">тушманын кычкырымыже,</para>
  <para style="q1" vid="PSA 54:3-4">осал еҥын шыгыремдымыже</para>
  <para style="q2" vid="PSA 54:3-4">мыйым аптыранымашыш пуртат.</para>
  <para style="q1" vid="PSA 54:3-4">Нуно мыланем эҥгекым кондат,</para>
  <para style="q1" vid="PSA 54:3-4">шыдышт дене ваштарешем тушманлат.<verse eid="PSA 54:3-4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Шӱмем чытыра кӧргыштем,</para>
  <para style="q1" vid="PSA 54:5">колымаш деч лӱдмаш мыйым авалтен.<verse eid="PSA 54:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Шучкылык ден ӧрткымаш мыйым темдалыныт,</para>
  <para style="q1" vid="PSA 54:6">кугу лӱдмаш мыйым авалтен.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Каласышым тунам:</para>
  <para style="q1" vid="PSA 54:7">«Пуат ыле гын мылам кӧгӧрченын гай шулдырым –</para>
  <para style="q1" vid="PSA 54:7">чоҥештен каем да лыпланем ыле.<verse eid="PSA 54:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 54:8" />Торашке-торашке чоҥештем ыле,</para>
  <para style="q1" vid="PSA 54:8">ир мландыште кодам ыле,<verse eid="PSA 54:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 54:9" />виян мардеж дечын, тӱтан мардеж дечын</para>
  <para style="q2" vid="PSA 54:9">аралтышым муаш вашкем ыле».<verse eid="PSA 54:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 54:10" />Господь, ойыштым луген пытаре,</para>
  <para style="q1" vid="PSA 54:10">вет олаште мый темдымаш ден шургымашым ужам –<verse eid="PSA 54:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 54:11" />йӱдшӧ-кечыже нуно ола йыр пырдыж дене коштыт,</para>
  <para style="q1" vid="PSA 54:11">а ола кӧргыштӧ – осал паша, эҥгек.<verse eid="PSA 54:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 54:12" />Тушто – пытымаш,</para>
  <para style="q1" vid="PSA 54:12">огыт кораҥ уремлаж гыч осал чоялык ден ондалымаш.<verse eid="PSA 54:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 54:13" />Мыйым тушман шӱктара гын,</para>
  <para style="q1" vid="PSA 54:13">тидым чытем ыле,</para>
  <para style="q1" vid="PSA 54:13">мыйым ужмышудымо еҥ ончылнем кугешна гын,</para>
  <para style="q1" vid="PSA 54:13">тудын деч шылам ыле,<verse eid="PSA 54:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 54:14" />но тиде – тый, мый гаемак айдеме,</para>
  <para style="q1" vid="PSA 54:14">мыйын йолташем да лишыл еҥем,<verse eid="PSA 54:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 54:15" />кӧн дене чон почын кутыренна,</para>
  <para style="q1" vid="PSA 54:15">Юмын пӧртышкӧ пырля коштынна.<verse eid="PSA 54:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 54:16" />Тек нунын дек вучыдымын колымаш толеш,</para>
  <para style="q1" vid="PSA 54:16">тек нуно илышынек вес тӱняшке волат,</para>
  <para style="q1" vid="PSA 54:16">вет илыме верыштым осаллык авалтен.<verse eid="PSA 54:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 54:17" />А мый Юмым сӧрвален йодам,</para>
  <para style="q1" vid="PSA 54:17">да мыйым Господь утара.<verse eid="PSA 54:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 54:18" />Кастене, эрдене да кечывалым</para>
  <para style="q2" vid="PSA 54:18">мый сӧрвалаш да шортын йодаш тӱҥалам,</para>
  <para style="q1" vid="PSA 54:18">да Тудо йӱкемым колеш:<verse eid="PSA 54:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 54:19" />ваштарешем кынелше-влак дечын,</para>
  <para style="q1" vid="PSA 54:19">нуно шукын лийыт гынат,</para>
  <para style="q1" vid="PSA 54:19">мыйым утарен кода да тынысым пуа.<verse eid="PSA 54:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 54:20" />Юмо колеш, акрет годсек Кугыжаланыше нуным колыштара,<note caller="*" style="f"><char style="fr" closed="false">54:20 </char><char style="ft" closed="false">Колыштараш – подчинить.</char></note></para>
  <para style="q1" vid="PSA 54:20">вет нуно огыт вашталт, Юмо дечын огыт лӱд.<verse eid="PSA 54:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 54:21" />Нунын дене келшен илыше ӱмбак кидыштым нӧлтат,</para>
  <para style="q1" vid="PSA 54:21">ойпидышым пудыртат.<verse eid="PSA 54:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 54:22" />Ӱй деч пушкыдо шомакышт,</para>
  <para style="q1" vid="PSA 54:22">а шӱмыштышт – ужмышудымаш,</para>
  <para style="q1" vid="PSA 54:22">олив ӱй деч яклака нунын мутышт,</para>
  <para style="q1" vid="PSA 54:22">но пӱсӧ керде гай нуно улыт.<verse eid="PSA 54:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 54:23" />Пу Господьлан шке тургыжланыметым –</para>
  <para style="q1" vid="PSA 54:23">Тудо тыланет полша,</para>
  <para style="q1" vid="PSA 54:23">чын ыштыше айдемылан тайнышташ нигунам ок пу.<verse eid="PSA 54:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 54:24" />Тый, Юмем, нуным эн келге вынемыш шуэт,</para>
  <para style="q1" vid="PSA 54:24">вӱр йоктарыше ден шояче-влак</para>
  <para style="q2" vid="PSA 54:24">пел ӱмырыштымат огыт шукто илен.</para>
  <para style="q1" vid="PSA 54:24">А мый Тылат, [Господь,] ӱшанен илем.<verse eid="PSA 54:24" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="cl">55 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 55:1" />Хор вуйлатышылан. «Умбалне йӱкым лукде илыше кӧгӧрчен» семлан возымо. Филистим-влакын Давидым Гефыште кучымекышт, Давидын возымашыже.<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Юмем, мыйым серлаге!</para>
  <para style="q1" vid="PSA 55:2">Еҥ-влак мыйым шыгыремдылыт,</para>
  <para style="q1" vid="PSA 55:2">ӱмбакем керылтше-влак кечыгут поктылыт.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Кажне кечын тушманем-влак мыйым шыгыремдылыт,</para>
  <para style="q1" vid="PSA 55:3">вет ваштарешем шогалше шукын улыт,</para>
  <para style="q1" vid="PSA 55:3">о, Чыла деч Кӱшылысӧ!<verse eid="PSA 55:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Лӱдмем годым Тыйын полышетлан ӱшанем.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Мый Юмын мутшым моктем,</para>
  <para style="q1" vid="PSA 55:5">ом лӱд – Юмын полшымыжлан ӱшанем,</para>
  <para style="q1" vid="PSA 55:5">мом ыштен кертеш мылам айдеме?<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Кажне кечын тушманем-влак вес семын савырат мутем,</para>
  <para style="q1" vid="PSA 55:6">иктым нуно шонат – ышташ мылам осалым.<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Пырля погынат, шылын шинчыт,</para>
  <para style="q1" vid="PSA 55:7">мыйым пушташ ваҥен,</para>
  <para style="q1" vid="PSA 55:7">кажне йолтошкалтышем эскерат.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Осал пашаштлан мутым огыт кучо мо?</para>
  <para style="q1" vid="PSA 55:8">Юмем, калык-влакым шке шыдет дене сӱмырен кудалте!<verse eid="PSA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Кусныл коштмо кажне кечем Тый шотленат.</para>
  <para style="q1" vid="PSA 55:9">Мыйын шинчавӱдем шке атышкет пого –</para>
  <para style="q1" vid="PSA 55:9">нуно Тыйын книгашкет возымо огытыл мо?<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Кунам мый Тыйым сӧрвален ӱжам,</para>
  <para style="q1" vid="PSA 55:10">тушманем-влак савырнат мӧҥгеш.</para>
  <para style="q1" vid="PSA 55:10">Тышечын мый палем: Юмо – мыйын велне.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Мый Юмын мутшым моктем,</para>
  <para style="q1" vid="PSA 55:11">Господьын пуымо мутшым чаплем.<verse eid="PSA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Мый Юмылан инанен илем, нимо дечын ом лӱд,</para>
  <para style="q1" vid="PSA 55:12">мом ыштен кертеш мылам айдеме?<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Юмем, Тылат мом сӧрымем шуктем,</para>
  <para style="q1" vid="PSA 55:13">моктымаш надырым кондем.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Вет утарышыч чонем Тый колымаш деч,</para>
  <para style="q1" vid="PSA 55:14">[шинчамым – шинчавӱд деч,]</para>
  <para style="q1" vid="PSA 55:14">йолемым – шӱртньымаш деч,</para>
  <para style="q1" vid="PSA 55:14">да мый Юмын ончылно, илышын волгыдыштыжо, коштын кертам.<verse eid="PSA 55:14" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="cl">56 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 56:1" />Хор вуйлатышылан. «Ит пытаре» семлан. Саул деч курыкпомышыш шылын куржмеке, Давидын возымашыже.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Серлаге, Юмем, мыйым серлаге,</para>
  <para style="q1" vid="PSA 56:2">вет чонемже Тылат инана.</para>
  <para style="q1" vid="PSA 56:2">Туткар эртен кайымешке,</para>
  <para style="q1" vid="PSA 56:2">мый шулдыретын ӱмылешыже шылам.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Чыла деч Кӱшылысӧ Юмым,</para>
  <para style="q1" vid="PSA 56:3">мыйым пыдал налше Юмым, сӧрвален йодам.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Колта кава гыч Тудо полышым да утара,</para>
  <para style="q1" vid="PSA 56:4">мыйым поктылшо-влакым вожылмашыш пурта.</para>
  <para style="q1" vid="PSA 56:4">Юмо мылам шке порылыкшым,</para>
  <para style="q1" vid="PSA 56:4">ӱшанле улмыжым ончыкта!<verse eid="PSA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />А мый лев-влак коклаште улам,</para>
  <para style="q1" vid="PSA 56:5">айдеме эрге-шамычым кочшо-влак коклаште кием,</para>
  <para style="q1" vid="PSA 56:5">нунын пӱйышт – умдо да пикш,</para>
  <para style="q1" vid="PSA 56:5">йылмышт – пӱсӧ керде.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Юмем, кава деч кӱшкӧ лий нӧлталме,</para>
  <para style="q1" vid="PSA 56:6">пӱтынь мланде ӱмбалне лийже Тыйын чапет!<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Йолемлан нуно вапшым шынденыт –</para>
  <para style="q1" vid="PSA 56:7">чыла ӱшаным мый йомдаренам,</para>
  <para style="q1" vid="PSA 56:7">ончылнем вынемым кӱнченыт,</para>
  <para style="q1" vid="PSA 56:7">но тушко шкештак пурен каеныт.<verse eid="PSA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Шӱмем мыйын ямде, Юмем, шӱмем мыйын ямде –</para>
  <para style="q1" vid="PSA 56:8">мый мураш да чапландараш тӱҥалам.<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Помыжалт, чонем, помыжалтса, кӱсле ден арфе!</para>
  <para style="q1" vid="PSA 56:9">Мый ӱжара дене кынелам<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />да Тыйым, Господь, калык-влак коклаште чапландарем,</para>
  <para style="q1" vid="PSA 56:10">тукым-шамыч коклаште моктен мурем.<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Вет Тыйын порылыкет кава марте шуэш,</para>
  <para style="q1" vid="PSA 56:11">Тыйын ӱшанле улмет – пыл ора дек шумеш.<verse eid="PSA 56:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Юмем, кава деч кӱшкӧ лий нӧлталме,</para>
  <para style="q1" vid="PSA 56:12">пӱтынь мланде ӱмбалне лийже Тыйын чапет!<verse eid="PSA 56:12" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="cl">57 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 57:1" />Хор вуйлатышылан. «Ит пытаре» семлан. Давидын возымашыже.<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Судья-влак, чыным ойледа мо,</para>
  <para style="q1" vid="PSA 57:2">айдеме эрге-шамыч, чын судитледа мо?<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Уке, шӱмыштыда осал шонымашым нумалыда,</para>
  <para style="q1" vid="PSA 57:3">тендан кидда вес еҥ-влакым темда.<verse eid="PSA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Шочмышт годсекак йомын коштыт осал еҥ-влак,</para>
  <para style="q1" vid="PSA 57:4">ава мӱшкыр гыч лекмекак, чын корно гыч кораҥын, шояклат.<verse eid="PSA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Аярышт нунын кишкын гай,</para>
  <para style="q1" vid="PSA 57:5">соҥгыра шемгишкын гай,</para>
  <para style="q1" vid="PSA 57:5">кудо петыра шке пылышыжым<verse eid="PSA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />да кишкым юлен туныктышын йӱкшым ок кол,</para>
  <para style="q1" vid="PSA 57:6">кеч-мыняр устан тудыжо юла гынат.<verse eid="PSA 57:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Юмем, умшасе пӱйыштым шалате,</para>
  <para style="q1" vid="PSA 57:7">Господь, нине лев-влакын оҥылашлуштым шалате!<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Тек нуно вӱд йоген кайыме семын йомыт!</para>
  <para style="q1" vid="PSA 57:8">Кунам Юмо чымалтара шке пикшыжым,</para>
  <para style="q1" vid="PSA 57:8">лийыт нуно сӱмырен кудалтыме.<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Тек нуно коштшыжла тазылашукш семын кошкат,</para>
  <para style="q1" vid="PSA 57:9">лугыч лийше аза семын огыт уж кечым.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Подышт-влакын йӱлышӧ шуанвондо шокшым шижын шуктымешкышт,</para>
  <para style="q1" vid="PSA 57:10">нуным, ужаргым але когаргышым, тек пӧрдшымардеж наҥгая.<note caller="*" style="f"><char style="fr" closed="false">57:10 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PSA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Нунылан ӱчым шуктымым ужмеке,</para>
  <para style="q1" vid="PSA 57:11">чын ыштыше айдеме йывырта,</para>
  <para style="q1" vid="PSA 57:11">йолжым мушкеш осал еҥын вӱрешыже.<verse eid="PSA 57:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 57:12" />Тунам еҥ-влак каласат:</para>
  <para style="q1" vid="PSA 57:12">«Чын ыштыше айдемылан суап лиеш!</para>
  <para style="q1" vid="PSA 57:12">Уло Юмо, мландымбалне судитлыше!»<verse eid="PSA 57:12" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="cl">58 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 58:1" />Хор вуйлатышылан. «Ит пытаре» семлан. Давидын возымашыже, кунам Саул, Давидым пушташ манын, тудын пӧртшым эскераш колтен.<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Юмем, утаре мыйым тушманем-влак дечын,</para>
  <para style="q1" vid="PSA 58:2">ваштарешем кынелше-влак дечын мыйым арале!<verse eid="PSA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Утаре мыйым осалым ыштыше-шамыч дечын,</para>
  <para style="q1" vid="PSA 58:3">вӱрым йоктарыше-влак дечын мыйым арале!<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Господь, теве титакемлан верч огыл, сулыкемлан верч огыл</para>
  <para style="q1" vid="PSA 58:4">нуно мыйын чонемым ваҥат,</para>
  <para style="q1" vid="PSA 58:4">ваштарешем виян-влак погынат.<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />Титакем уке ӱмбач писын погынат, сарлан ямдылалтыт.</para>
  <para style="q1" vid="PSA 58:5">Кынел мыланем полшаш, ӱмбакем ончал!<verse eid="PSA 58:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Тый, Господь, Саваоф Юмем, Израильын Юмыжо,</para>
  <para style="q1" vid="PSA 58:6">калык-влаклан ӱчым шукташ помыжалт,</para>
  <para style="q1" vid="PSA 58:6">осал чоя да ӱшанле огыл-влакым иктымат ит чамане!<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Кастене нуно пӧртылыт</para>
  <para style="q1" vid="PSA 58:7">да, пий гай урмыжын, ола мучко коштыт.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Йылмышт дене нуно шӱктарен вурсат,</para>
  <para style="q1" vid="PSA 58:8">мутышт нунын пуйто керде.</para>
  <para style="q1" vid="PSA 58:8">«Кӧ мемнам колеш?» – нуно шонат.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Но Тый, Господь, нуным воштылат,</para>
  <para style="q1" vid="PSA 58:9">чыла нине калыкым ӱлык шындет.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Юмем, вий-куатем, ӱмбакет шинчаончалтышем виктарем,</para>
  <para style="q1" vid="PSA 58:10">улат Тый мыйын аралтышем.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Мыйым чаманыше Юмо ончычем кая,</para>
  <para style="q1" vid="PSA 58:11">тушманем-влак дене мо лиймым Тудо мылам ужаш пуа.<verse eid="PSA 58:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 58:12" />Но, калыкем Тыйым ынже мондо манын, нуным ит пушт –</para>
  <para style="q1" vid="PSA 58:12">шалате нуным шке виет дене,</para>
  <para style="q1" vid="PSA 58:12">сӱмырен кудалте нуным, Господь, мемнан Аралышына!<verse eid="PSA 58:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 58:13" />Йылмышт гыч лекше кажне мут дене нуно сулыкыш пурат –</para>
  <para style="q1" vid="PSA 58:13">шудалмыштлан да шоякым ойлымыштлан</para>
  <para style="q2" vid="PSA 58:13">тек нуно шке кугешнымашышт дене кучымо лийыт.<verse eid="PSA 58:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 58:14" />Шалате нуным шыдет дене, шалате,</para>
  <para style="q1" vid="PSA 58:14">тек нуно огыт лий, тек пален налыт чылан –</para>
  <para style="q1" vid="PSA 58:14">Юмо Иаковын мландыштыже да мланде тӱр мартеат кугыжалана.<verse eid="PSA 58:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 58:15" />Кастене нуно пӧртылыт,</para>
  <para style="q1" vid="PSA 58:15">да, пий гай урмыжын, ола мучко коштыт.<verse eid="PSA 58:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 58:16" />Коштыт нуно, кочкышым кычалын,</para>
  <para style="q1" vid="PSA 58:16">мӱшкырышт ок тем гын, йыҥысат.<verse eid="PSA 58:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 58:17" />А мый Тыйын куатетым моктен мурем,</para>
  <para style="q1" vid="PSA 58:17">эрден эрак тӱҥалын, Тыйын порылыкетым моктем.</para>
  <para style="q1" vid="PSA 58:17">Вет Тый лийынат мылам аралтыш,</para>
  <para style="q1" vid="PSA 58:17">неле кече годым шылын куржмо вер.<verse eid="PSA 58:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 58:18" />Мыйын Куатем! Тыйым моктен мураш тӱҥалам,</para>
  <para style="q1" vid="PSA 58:18">вет Тый, Юмем, мыйым арален налше,</para>
  <para style="q1" vid="PSA 58:18">мылам порылыкым ончыктышо Юмо улат!<verse eid="PSA 58:18" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="cl">59 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 59:1" />Хор вуйлатышылан. «Танык лилий» семлан возымо.<note caller="*" style="f"><char style="fr" closed="false">59:1 </char><char style="ft" closed="false">Псалтирь книгаште музык дене кылдалтше термин-влакын мом ончыктымышт раш пале огыл.</char></note> Давидын туныктымо сынан возымашыже. <verse eid="PSA 59:1" /><verse number="2" style="v" sid="PSA 59:2" />Месопотамийысе да Цовасе сириян-влак дене кредалмыж деч вара, Иоавын пӧртылшыла Шинчалан лапверыште латкок тӱжем идумейым кырен шалатымекше, Давид тидым возен.<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Юмем, Тый мемнам Шке дечет кораҥдышыч да мемнам шалатышыч;</para>
  <para style="q1" vid="PSA 59:3">Тый мыланна шыдешкышыч, но садак мемнан дек савырне!<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Тый чытырыктышыч мландым, тудым печкалтарышыч –</para>
  <para style="q1" vid="PSA 59:4">тӧрлате тудын шелшыжым, вет тудо чытыра.<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Шке калыкетлан Тый кугу нелылыкым ужыктышыч,</para>
  <para style="q1" vid="PSA 59:5">аҥыртарыше аракам мыланна йӱктышыч.<verse eid="PSA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Тый дечет лӱдын илыше-влаклан тистым нӧлталат –</para>
  <para style="q1" vid="PSA 59:6">тудын йырже погынен,</para>
  <para style="q1" vid="PSA 59:6">нуно пикш дечын шылын кертыт.<note caller="*" style="f"><char style="fr" closed="false">59:6 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Тек утлен кодыт Тыйын йӧратымет-влак.</para>
  <para style="q1" vid="PSA 59:7">Мыйым кол, пурла кидет дене утаре.<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Шке святой верже гыч Юмо каласен:</para>
  <para style="q1" vid="PSA 59:8">«Сеҥымашлан куанен,</para>
  <para style="q1" vid="PSA 59:8">Сихем мландым, Сокхоф лапверым шеледен пуэм.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />Галаад ден Манассий Мыйын улыт,</para>
  <para style="q1" vid="PSA 59:9">Ефрем – вуйыштем ӧшлӧк,</para>
  <para style="q1" vid="PSA 59:9">Иуда кучемвий тоям лиеш.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />Моав – мушкылтмо атем,</para>
  <para style="q1" vid="PSA 59:10">Едом ӱмбак йолчиемем шуэм.<note caller="*" style="f"><char style="fr" closed="false">59:10 </char><char style="ft" closed="false">Йолчиемым шуышо еҥын тыге ыштымыже «мландын озаже ынде мый улам» манмым ончыктен кертын.</char></note></para>
  <para style="q1" vid="PSA 59:10">Филистим мланде, Мыйым куан йӱк дене вашлий!»<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Кӧ мыйым чоткыдемдыме олаш вӱден пурта,</para>
  <para style="q1" vid="PSA 59:11">Едом марте кӧ мыйым ужата?<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Вет Тый, Юмына, мемнам Шке дечет кораҥденат,</para>
  <para style="q1" vid="PSA 59:12">сарзына-влак дене пырля от лек.<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />Полшо мыланна сеҥаш тушманым,</para>
  <para style="q1" vid="PSA 59:13">вет айдеме полышлан ӱшан лиеш арам.<verse eid="PSA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Юмо дене ме сеҥена,</para>
  <para style="q1" vid="PSA 59:14">Тудо тушманнам тошка.<verse eid="PSA 59:14" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="cl">60 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 60:1" />Хор вуйлатышылан. Кылан семӱзгар дене. Давидын псаломжо.<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Юмем, сӧрвален йодмемым кол,</para>
  <para style="q1" vid="PSA 60:2">кумалмем дек пылышетым савыре!<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Чонемлан йӧсӧ лийме годым мланде тӱр гыч Тыйым ӱжам:</para>
  <para style="q1" vid="PSA 60:3">кӱзыктӧ мыйым кӱ курыкыш –</para>
  <para style="q1" vid="PSA 60:3">шке вием дене тушко ом керт кӱзен.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Вет Тый улат аралтышем,</para>
  <para style="q1" vid="PSA 60:4">тушман деч саклыше пеҥгыде пырдыжем.<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Ӱмырем мучко Тыйын илыме верыштет илынем,</para>
  <para style="q1" vid="PSA 60:5">Тыйын шулдырет йымалне мый утаралтнем.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Вет Тый, Юмем, сӧрымем колынат,</para>
  <para style="q1" vid="PSA 60:6">лӱметым жаплыше-влакын налшаш суапыштым пуышыч мыламат.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Кугыжан илышаш кечыжым шукемде,</para>
  <para style="q1" vid="PSA 60:7">кугыжаланыме ийлажым тукым гыч тукымыш шуйо.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Тек тудо Юмын ончылно курымеш кугыжалана,</para>
  <para style="q1" vid="PSA 60:8">Тыйын порылыкет да ӱшанле улмет тек тудым оролат.<verse eid="PSA 60:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />А мый Тыйын лӱметым курымеш моктен мурем,</para>
  <para style="q1" vid="PSA 60:9">сӧрымем кече гыч кечыш шуктен шогем.<verse eid="PSA 60:9" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="cl">61 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 61:1" />Хор вуйлатыше Идифунлан. Давидын псаломжо.<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Юмо гына чонемлан тынысым пуа,</para>
  <para style="q1" vid="PSA 61:2">Тудын деч – мыйын утаралтмашем.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Лач Тудо – кӱ курыкем, утарымашем, шылын куржмо верем;</para>
  <para style="q1" vid="PSA 61:3">мый пеҥгыдын шогаш тӱҥалам.<verse eid="PSA 61:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Мыняр жап те эше еҥ ӱмбаке кержалташ тӱҥалыда?</para>
  <para style="q1" vid="PSA 61:4">Те тудым пуштыда,</para>
  <para style="q1" vid="PSA 61:4">тудо – тайныше пырдыж, лӱҥгышӧ пече гай.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Шонен пыштеныт нуно тудым кӱшычын сӱмырал шуаш,</para>
  <para style="q1" vid="PSA 61:5">келша нунылан ондалкалаш:</para>
  <para style="q1" vid="PSA 61:5">умшашт дене суапым тыланат, а шӱмыштышт каргат.<verse eid="PSA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Чонем, Юмо дене ушнымаште веле лыпланымашым кычал!</para>
  <para style="q1" vid="PSA 61:6">Вет Тудо мылам инанымашым пуа,<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Тудо гына – мыйын кӱ курыкем,</para>
  <para style="q2" vid="PSA 61:7">утарымашем да шылын куржмо верем,</para>
  <para style="q1" vid="PSA 61:7">мый пеҥгыдын шогаш тӱҥалам.<verse eid="PSA 61:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Юмо гына – мыйын утаралтмашем да чапем,</para>
  <para style="q1" vid="PSA 61:8">Юмо – пеҥгыде кӱ курыкем, шылын куржмо верем.<verse eid="PSA 61:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 61:9" />Калыкем, чыла жапыштат Тудлан ӱшане,</para>
  <para style="q1" vid="PSA 61:9">шӱмыштет мо уло – поч Тудлан.</para>
  <para style="q1" vid="PSA 61:9">Юмо – мемнан аралтышна.<verse eid="PSA 61:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 61:10" />Айдеме – шӱлалтыш дене иктак,</para>
  <para style="q1" vid="PSA 61:10">еҥ-влак лач ондалчык улыт.</para>
  <para style="q1" vid="PSA 61:10">Нуным чылаштым пышташ гын висаш,</para>
  <para style="q1" vid="PSA 61:10">куштылгырак лийыт шӱлалтыш дечат.<verse eid="PSA 61:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 61:11" />Весым темден илымылан ида инане,</para>
  <para style="q1" vid="PSA 61:11">агымылан ӱшанен ида иле.</para>
  <para style="q1" vid="PSA 61:11">Поянлыкда шукемеш гынат,</para>
  <para style="q1" vid="PSA 61:11">тушко шӱмдам ида пыште.<verse eid="PSA 61:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 61:12" />Ик гана Юмо каласыш,</para>
  <para style="q1" vid="PSA 61:12">кок гана мый тидым кольым:</para>
  <para style="q1" vid="PSA 61:12">чыла вий-куат – Юмын,<verse eid="PSA 61:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 61:13" />Тый гына, Господь, поро улат.</para>
  <para style="q1" vid="PSA 61:13">Кажныжлан Тый пашаже почеш пӧртылтет.<verse eid="PSA 61:13" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="cl">62 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 62:1" />Иуда тукымын ир мландыштыже лиймыж годым Давидын возымо псаломжо.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Юмем! Тый мыйын Юмем улат,</para>
  <para style="q1" vid="PSA 62:2">эр ӱжара денак мый Тыйым кычалам.</para>
  <para style="q1" vid="PSA 62:2">Вӱддымӧ, кошкышо ир мландыште</para>
  <para style="q1" vid="PSA 62:2">чонемже Тый декет шупшеш,</para>
  <para style="q1" vid="PSA 62:2">капемже Тыйым кычалеш.<verse eid="PSA 62:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Тыйын виет ден чапетым ужаш манын,</para>
  <para style="q1" vid="PSA 62:3">святой верыште ӱмбакет онченам.<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Тыйын порылыкет илыш деч сайрак!</para>
  <para style="q1" vid="PSA 62:4">Мыйын умшам Тыйым тӱҥалеш мокташ.<verse eid="PSA 62:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Илыме чыла кечыштем Тыйым чапландарем,</para>
  <para style="q1" vid="PSA 62:5">кидем нӧлталын, лӱметым ӱжын кумалам.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6-7" style="v" sid="PSA 62:6-7" />Кунам вакшыштем Тыйым шарналтен кием</para>
  <para style="q1" vid="PSA 62:6-7">да Тыйын нергенет йӱдым шонкалем,</para>
  <para style="q1" vid="PSA 62:6-7">чонем пуйто эн сай кочкыш дене темеш,</para>
  <para style="q1" vid="PSA 62:6-7">йылмем Тыйым куанен мокта.<verse eid="PSA 62:6-7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Вет Тый улат мыйын полышем,</para>
  <para style="q1" vid="PSA 62:8">Тыйын шулдырет йымалне мый куанем.<verse eid="PSA 62:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Тый декет пижын мыйын чонем,</para>
  <para style="q1" vid="PSA 62:9">Тыйын пурла кидет мыйым куча.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />А чонемым пытараш шонышо-влак</para>
  <para style="q1" vid="PSA 62:10">мланде кӧргыш порволат.<verse eid="PSA 62:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Логалыт нуно керде йымаке,</para>
  <para style="q1" vid="PSA 62:11">тулпире-влаклан кочкыш лийыт.<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />Юмылан кугыжа йывырта,</para>
  <para style="q1" vid="PSA 62:12">Юмо дене товатлыше кажне еҥ куанаш тӱҥалеш,</para>
  <para style="q1" vid="PSA 62:12">вет шояче-влакын умшашт петырыме лиеш.<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="cl">63 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 63:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Юмем, сӧрвален кумалмемым кол,</para>
  <para style="q1" vid="PSA 63:2">лӱдмашым лукшо тушман деч илышем арале.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Осал чоя-влакын шонен пыштымышт деч,</para>
  <para style="q1" vid="PSA 63:3">лӱшкышӧ осал еҥ-шамыч деч мыйым шылте.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Нуно керде семын пӱсемденыт йылмыштым,</para>
  <para style="q1" vid="PSA 63:4">мутышт – чымалтарен шындыме аяран пикш гае.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Шылын шичме верышт гыч нуно титакдымым лӱят,</para>
  <para style="q1" vid="PSA 63:5">вучыдымын лӱят ӱмбакше да огытат лӱд.<verse eid="PSA 63:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Осалым ышташ шонымаштышт пеҥгыдын шогат,</para>
  <para style="q1" vid="PSA 63:6">кутырен келшеныт лӧдым шындаш,</para>
  <para style="q1" vid="PSA 63:6">ойлат нуно: «Кӧ мемнам ужеш?»<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />Ышташ шонат осалым, тыге ойлат:</para>
  <para style="q1" vid="PSA 63:7">«Чылажымат ме сайын шоненна!»</para>
  <para style="q1" vid="PSA 63:7">Умылаш ок лий айдеме шӱм-чоным!<note caller="*" style="f"><char style="fr" closed="false">63:7 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Но Юмо ӱмбакышт пикшым колта,</para>
  <para style="q1" vid="PSA 63:8">кенеташте нуно сусыртымо лийыт.<verse eid="PSA 63:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Шке йылмышт дене нуно зияным шкаланышт кондат.</para>
  <para style="q1" vid="PSA 63:9">Нуным ужшо-влак воктечышт кораҥыт.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Чыла еҥым лӱдмаш авалта,</para>
  <para style="q1" vid="PSA 63:10">нуно Юмын пашаж нерген каласкалаш</para>
  <para style="q1" vid="PSA 63:10">да Тудын мом ыштымыж нерген шонкалаш тӱҥалыт.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Господьлан куана чын ыштыше айдеме,</para>
  <para style="q1" vid="PSA 63:11">Господьлан тудо инанен ила,</para>
  <para style="q1" vid="PSA 63:11">да яндар шӱм-чонан-влак чылан йывыртат.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="cl">64 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 64:1" />Хор вуйлатышылан. Давидын псаломжо. Муро.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Тыйым, Юмем, моктена Сионышто,</para>
  <para style="q1" vid="PSA 64:2">[Иерусалимыште] Тылат чыла сӧрымынам шуктена.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Тый кумалмым колат,</para>
  <para style="q1" vid="PSA 64:3">чыла еҥ-влак Тый декет мият.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Сулыкан пашана-влак мемнам темдат,</para>
  <para style="q1" vid="PSA 64:4">но нунын деч Тый эрыктет мемнам.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Пиалан, кӧм Тый ойырен налынат</para>
  <para style="q2" vid="PSA 64:5">да Шке декет лишемденат –</para>
  <para style="q1" vid="PSA 64:5">тудо Тыйын сурт-печышкет илаш пура.</para>
  <para style="q1" vid="PSA 64:5">Тыйын пӧртетын, святой храметын,</para>
  <para style="q2" vid="PSA 64:5">перкелыкше дене ме темына.<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Кол мемнам, Юмына, мемнан Утарышына,</para>
  <para style="q1" vid="PSA 64:6">чын судитлыше да лӱдмашым лукшо!</para>
  <para style="q1" vid="PSA 64:6">Мланде тӱр ден мӱндыр теҥыз-влакын улат Тый ӱшанышт.<verse eid="PSA 64:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Шке куатет дене шогалтенат курык-влакым,</para>
  <para style="q1" vid="PSA 64:7">кыдалешет ӱшталынат вий-куатым.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Теҥыз лӱшкымым, вӱдтолкын йӱкым,</para>
  <para style="q2" vid="PSA 64:8">калык пудыранчыкым Тый лыпландарет!<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Мланде тӱрыштӧ илыше-влакат</para>
  <para style="q2" vid="PSA 64:9">Тыйын палдарыше палет-влак дечын лӱдыт,</para>
  <para style="q1" vid="PSA 64:9">эрвел ден касвелнат Тый чапландараш кумылым луктат.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Мланде дек порын савырнен, йӱрым колтет,</para>
  <para style="q1" vid="PSA 64:10">тудым лектышаным ыштет –</para>
  <para style="q1" vid="PSA 64:10">Юмын йогынжо эре вӱд дене темше!</para>
  <para style="q1" vid="PSA 64:10">Киндым шочыкташ Тый мландым ямдыленат:<verse eid="PSA 64:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 64:11" />куралме кашым вӱдыжтарет,</para>
  <para style="q1" vid="PSA 64:11">комыля-влакым тӧрлет,</para>
  <para style="q1" vid="PSA 64:11">йӱр дене тудым пушкыдемдет,</para>
  <para style="q1" vid="PSA 64:11">лекше озымым суапландарет.<verse eid="PSA 64:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 64:12" />Идалыкым Тый кинде перке дене сӧрастарет,</para>
  <para style="q1" vid="PSA 64:12">кушто Тый эртет, тушто мланде перкелык дене темеш.<verse eid="PSA 64:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 64:13" />Такыр олык-влак шудо дене леведалтыт,</para>
  <para style="q1" vid="PSA 64:13">кӱкшака-шамыч куан вургемым чият.<verse eid="PSA 64:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 64:14" />Олык-влак кӱтӱ дене,</para>
  <para style="q2" vid="PSA 64:14">лапвер-влак шурно дене леведалтыт,</para>
  <para style="q1" vid="PSA 64:14">уло мланде куанен мура!<verse eid="PSA 64:14" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="cl">65 ПСАЛОМ</para>
  <para style="d">Хор вуйлатышылан. Муро. Псалом.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Пӱтынь мланде, Юмылан куанен кычкырал!<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />Тудын лӱмжын чапшым моктен мурыза,</para>
  <para style="q1" vid="PSA 65:2">Тудым чапландарыза!<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Каласыза Юмылан:</para>
  <para style="q1" vid="PSA 65:3">«Ӧрыктарыше улыт Тыйын пашат-влак!</para>
  <para style="q1" vid="PSA 65:3">Тыйын кугу куатетлан кӧра</para>
  <para style="q2" vid="PSA 65:3">тушманет, ӱҥышыла койын, Тыланет келшаш тӧча».<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />[Чыла деч Кӱшылысӧ,] пӱтынь мланде Тылат вуйым савыже,</para>
  <para style="q1" vid="PSA 65:4">Тылат мурыжо, лӱметым моктен мурыжо!<verse eid="PSA 65:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Толза да ончалза Юмын пашаже-влакым –</para>
  <para style="q1" vid="PSA 65:5">мом Тудо айдеме эрге-шамычлан ышта, чылажат ӧрыктарыше.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Теҥызым Тудо кукшо мландыш савырен,</para>
  <para style="q1" vid="PSA 65:6">эҥер гоч калык йолын лектын,</para>
  <para style="q1" vid="PSA 65:6">Тудлан ме тушто куаненна.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />Куатше дене Тудо курымеш кугыжалана,</para>
  <para style="q1" vid="PSA 65:7">шинчаже Тудын чыла калыкым эскера –</para>
  <para style="q1" vid="PSA 65:7">вуянче-влак ваштарешыже ынышт нӧлталт.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Калык-влак, Юмынам чапландарыза,</para>
  <para style="q1" vid="PSA 65:8">Тудым кугу йӱкын моктыза!<verse eid="PSA 65:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Тудо илышнам арален коден,</para>
  <para style="q1" vid="PSA 65:9">йолналан шӱртняш пуэн огыл.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Юмына, Тый мемнам тергенат,</para>
  <para style="q1" vid="PSA 65:10">шийым левыктыме семын мемнам левыктен эрыктенат.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Вӱден наҥгайышыч мемнам Тый оптышыш,</para>
  <para style="q1" vid="PSA 65:11">ӱмбакына нелылыкым пыштышыч.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Орван еҥ-влак вуй ӱмбачна коштыч,</para>
  <para style="q1" vid="PSA 65:12">тул ден вӱдыш мыланна пураш логале,</para>
  <para style="q1" vid="PSA 65:12">но мемнам Тый йоҥгыдо верыш луктыч.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Йӱлалтен пуымо надыр дене Тыйын пӧртышкет пурем –</para>
  <para style="q1" vid="PSA 65:13">Тылат мом сӧрымем чыла шуктем.<verse eid="PSA 65:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 65:14" />Орлыкем годым умшам гыч нуно лектыныт,</para>
  <para style="q1" vid="PSA 65:14">мыйын йылмем нуным ойлен.<verse eid="PSA 65:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 65:15" />Ӧрдышӧ вольыкым Тылат мый йӱлалтен пуэм –</para>
  <para style="q1" vid="PSA 65:15">тагам йӱлалтыме тамле пушан шикшым пӧлеклем,</para>
  <para style="q1" vid="PSA 65:15">ӱшкыж ден казатага-влакым надырлан кондем.<verse eid="PSA 65:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 65:16" />Юмо деч лӱдшӧ-влак, толза да колыштса чылан –</para>
  <para style="q1" vid="PSA 65:16">Юмын мыланем мом ыштымыж нерген каласкалем.<verse eid="PSA 65:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 65:17" />Умшам дене Тудым мый сӧрвален ӱжынам,</para>
  <para style="q1" vid="PSA 65:17">йылмем дене Тудым мокташ ямде лийынам.<verse eid="PSA 65:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 65:18" />Лиеш ыле гын шӱмыштем закондымылык,</para>
  <para style="q1" vid="PSA 65:18">Господь мыйым огеш кол ыле.<verse eid="PSA 65:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 65:19" />Но Юмо мыйым колын,</para>
  <para style="q1" vid="PSA 65:19">кумалмемлан пылышыжым почын.<verse eid="PSA 65:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 65:20" />Тек Юмо моктымо лиеш!</para>
  <para style="q1" vid="PSA 65:20">Кумалмем Тудо кӱлдымыш луктын огыл,</para>
  <para style="q1" vid="PSA 65:20">порылыкшым мый дечем кораҥден огыл.<verse eid="PSA 65:20" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="cl">66 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 66:1" />Хор вуйлатышылан. Кылан семӱзгар дене. Псалом. Муро.<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />Юмына, лий мемнан деке поро,</para>
  <para style="q1" vid="PSA 66:2">мемнам суапландаре,</para>
  <para style="q1" vid="PSA 66:2">чуриетын волгыдыж дене мемнам волгалтаре –<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />тек пален налыт Тыйын корнетым мландымбалне,</para>
  <para style="q1" vid="PSA 66:3">Тыйын утарымашетым – чыла калык коклаште.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Юмына, тек моктат Тыйым калык-влак,</para>
  <para style="q1" vid="PSA 66:4">тек моктат Тыйым калык-влак чылан!<verse eid="PSA 66:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Тек йывыртат да куанат тукым-шамыч!</para>
  <para style="q1" vid="PSA 66:5">Вет Тый калык-влакым чын судитлет,</para>
  <para style="q1" vid="PSA 66:5">мландымбалысе тукым-шамычым виктарен шогет.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />Юмына, тек моктат Тыйым калык-влак,</para>
  <para style="q1" vid="PSA 66:6">тек моктат Тыйым калык-влак чылан!<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Мланде мыланна шке саскажым пуа.</para>
  <para style="q1" vid="PSA 66:7">Юмо, мемнан Юмына, тек суапландара мемнам!<verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Тек Юмо суапландара мемнам,</para>
  <para style="q1" vid="PSA 66:8">тек мландын чыла тӱрыштыжӧ Тудын деч лӱдын илат!<verse eid="PSA 66:8" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="cl">67 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 67:1" />Хор вуйлатышылан. Давидын псаломжо. Муро.<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />Тек Юмо кынелеш, да тушманже-влак шаланен пытат,</para>
  <para style="q1" vid="PSA 67:2">тек Юмым ужмышудымо-влак Тудын чурийже деч куржыт!<verse eid="PSA 67:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Шикш шаланыме семын нуным шалате,</para>
  <para style="q1" vid="PSA 67:3">тек шыштын тулышто левен шулымыж семын</para>
  <para style="q2" vid="PSA 67:3">осал еҥ-влак Юмын чурий ончылно пытат.<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />А чын ыштыше-влак тек йывыртат да куанат,</para>
  <para style="q1" vid="PSA 67:4">кугу куан дене Юмын ончылно йомартланат.<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Мурыза Юмылан, Тудын лӱмжым моктыза,</para>
  <para style="q1" vid="PSA 67:5">кава дене Коштшым чапландарыза!</para>
  <para style="q1" vid="PSA 67:5">Лӱмжӧ Тудын – Господь,</para>
  <para style="q1" vid="PSA 67:5">Тудын чурийже ончылно куаныза!<verse eid="PSA 67:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Тудо – тулык-влакын ачашт,</para>
  <para style="q2" vid="PSA 67:6">тулык вате-шамычлан чын судым ыштыше,</para>
  <para style="q1" vid="PSA 67:6">Юмо – шке святой илыме верыштыже.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Шкет кодшо еҥым Юмо пӧртыш илаш пурта,</para>
  <para style="q1" vid="PSA 67:7">петырымаште улшо-влакым эрыкыш луктеш,</para>
  <para style="q1" vid="PSA 67:7">а ӱскырт-влак кошкышо мландыште илаш тӱҥалыт.<verse eid="PSA 67:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 67:8" />Юмем, кунам шке калыкет ончылно каенат,</para>
  <para style="q1" vid="PSA 67:8">кунам ир мланде дене ошкылынат –<verse eid="PSA 67:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 67:9" />Тыйын ончылнет, Синайысе Юмо, Израильын Юмыжо,</para>
  <para style="q1" vid="PSA 67:9">мланде чытырналтын, кава йӱрым йоктарен.<verse eid="PSA 67:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 67:10" />Шке мландет ӱмбаке, Юмем,</para>
  <para style="q2" vid="PSA 67:10">Тый тале йӱрым колтенат,</para>
  <para style="q1" vid="PSA 67:10">кунам тудо лунчырген, Тый тудым ылыжтенат.<verse eid="PSA 67:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 67:11" />Тыйын калыкет тушто илен;</para>
  <para style="q1" vid="PSA 67:11">шке порылыкет дене, Юмем,</para>
  <para style="q1" vid="PSA 67:11">Тый йорло-влаклан мо кӱлешым пуэнат.<verse eid="PSA 67:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 67:12" />Господь колта шке шомакшым,</para>
  <para style="q1" vid="PSA 67:12">уверзе ӱдырамаш-влак шукын улыт:<verse eid="PSA 67:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 67:13" />куржыт, сеҥалтын куржыт сарзывий-влак да нунын кугыжашт,</para>
  <para style="q1" vid="PSA 67:13">а мӧҥгыштӧ ӱдырамаш-влак мом поген налмым шеледат.<verse eid="PSA 67:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 67:14" />Шке тукым мландыштыда киен,</para>
  <para style="q1" vid="PSA 67:14">те кӧгӧрчен гай лийында,</para>
  <para style="q2" vid="PSA 67:14">кудыжын шулдыржо ший дене,</para>
  <para style="q2" vid="PSA 67:14">пыстылже яндар шӧртньӧ дене леведалтын.<verse eid="PSA 67:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 67:15" />Кунам кугыжа-влакым Чылакертше кырен шалатен,</para>
  <para style="q1" vid="PSA 67:15">Селмон курыкышто лум лумын.<verse eid="PSA 67:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 67:16" />Васан курык, Юмын курык!</para>
  <para style="q1" vid="PSA 67:16">Васан курык, кӱкшӧ курык!<verse eid="PSA 67:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 67:17" />Кӱкшӧ курык-влак, те молан</para>
  <para style="q2" vid="PSA 67:17">Юмын илаш шонымо курык ӱмбак кӧранен ончеда?</para>
  <para style="q1" vid="PSA 67:17">Тушто Господь курымеш илаш тӱҥалеш.<verse eid="PSA 67:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 67:18" />Юмын сарорваже шотлен пытарыдыме – тӱжем-тӱжемле,</para>
  <para style="q1" vid="PSA 67:18">Господь нунын покшелнышт Синайыште, святой верыште.<verse eid="PSA 67:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 67:19" />Тый кӱкшытыш кӱзенат,</para>
  <para style="q1" vid="PSA 67:19">пленыш налме-влакым пеленет наҥгаенат,</para>
  <para style="q1" vid="PSA 67:19">айдеме-влак деч налынат пӧлекым,</para>
  <para style="q1" vid="PSA 67:19">тунам ӱскырт-влак кокла гычат Господь Юмо дене илен кертыт.<verse eid="PSA 67:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 67:20" />Моктымо лийже Господь кажне кечын!</para>
  <para style="q1" vid="PSA 67:20">Мемнан ӱмбаке Юмо нумалтышым пышта,</para>
  <para style="q1" vid="PSA 67:20">но Тудак мемнам утара.<verse eid="PSA 67:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 67:21" />Мемнан Юмына – утарыше Юмо,</para>
  <para style="q1" vid="PSA 67:21">Господь Юмо мемнам колымаш деч утара.<verse eid="PSA 67:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 67:22" />Юмо чынжымак шалата тушманже-влакын вуйыштым,</para>
  <para style="q1" vid="PSA 67:22">сулык корно дене коштшо-шамычын ӱпан вуйыштым.<verse eid="PSA 67:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 67:23" />Господь каласен:</para>
  <para style="q1" vid="PSA 67:23">«Васан гыч пӧртылтем Мый нуным,</para>
  <para style="q1" vid="PSA 67:23">теҥыз пундаш гычат муын луктам.<verse eid="PSA 67:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 67:24" />Тунам тушман-влакетын вӱрышкышт тошкалат,</para>
  <para style="q1" vid="PSA 67:24">пиет-влакат тудым йӱаш тӱҥалыт».<verse eid="PSA 67:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 67:25" />Юмына, Тыйын лӱмеш тӱшкан ошкылмым ужыныт,</para>
  <para style="q1" vid="PSA 67:25">Кугыжа Юмем лӱмеш святой верыш ошкылмым ужыныт.<verse eid="PSA 67:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 67:26" />Ончылно ошкылыныт мурызо-влак,</para>
  <para style="q1" vid="PSA 67:26">шеҥгелне – семӱзгар дене шоктышо-шамыч,</para>
  <para style="q1" vid="PSA 67:26">коклаштышт – ӱдыр-влак тимпан дене.<verse eid="PSA 67:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 67:27" />«Те, Израиль тукым гыч лекше-влак,</para>
  <para style="q1" vid="PSA 67:27">Господь Юмым погынымашыште моктыза!»<verse eid="PSA 67:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 67:28" />Тушто Вениамин, эн изи шольо, нуным вӱден наҥгая,</para>
  <para style="q1" vid="PSA 67:28">туштак улыт Иудан тукымвуйжо-влак шке еҥышт дене,</para>
  <para style="q1" vid="PSA 67:28">Завулон ден Неффалимын тукымвуй-влакшат.<verse eid="PSA 67:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 67:29" />Юмет тылат вийым ончылгоч палемден.</para>
  <para style="q1" vid="PSA 67:29">Юмына, мом Тый мыланна ыштенат, угыч ончыкто.<verse eid="PSA 67:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 67:30" />Иерусалимысе храметлан кӧра</para>
  <para style="q2" vid="PSA 67:30">кугыжа-влак Тылат пӧлекым кондат.<verse eid="PSA 67:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 67:31" />Пеҥгыдын каласе омыж коклаште илыше янлыклан,</para>
  <para style="q1" vid="PSA 67:31">презе-влак коклаште улшо ӱшкыж кӱтӱлан.</para>
  <para style="q1" vid="PSA 67:31">Тек нуно лийыт ӱлыкшемдыме, кондат ший моклакам.<note caller="*" style="f"><char style="fr" closed="false">67:31 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note></para>
  <para style="q1" vid="PSA 67:31">Кредалаш шонышо калыкым шалатен пытаре!<verse eid="PSA 67:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 67:32" />Толыт Египет гыч колтымо лӱмлӧ еҥ-шамыч,</para>
  <para style="q1" vid="PSA 67:32">Эфиопийыште илыше-влакат Юмо деке кидыштым шуят.<verse eid="PSA 67:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 67:33" />Мландысе кугыжаныш-влак,</para>
  <para style="q1" vid="PSA 67:33">Юмылан мурыза, Господьым моктен мурыза!<verse eid="PSA 67:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 67:34" />Акрет кава дене Тудо кая,</para>
  <para style="q1" vid="PSA 67:34">кӱдырчӧ гай йӱкшӧ Тудын шокта!<verse eid="PSA 67:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 67:35" />Чапым пуыза Юмылан!</para>
  <para style="q1" vid="PSA 67:35">Тудын кӱдыратлыкше – Израиль ӱмбалне,</para>
  <para style="q1" vid="PSA 67:35">Тудын куатше – пыл лоҥгаште.<verse eid="PSA 67:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 67:36" />Луктеш лӱдмашым Юмо,</para>
  <para style="q2" vid="PSA 67:36">Израильын Юмыжо, шке святой верыштыже.</para>
  <para style="q1" vid="PSA 67:36">Тудо шке калыкшылан вийым да пеҥгыдылыкым пуа.</para>
  <para style="q1" vid="PSA 67:36">Тек Юмо чапландарыме лиеш!<verse eid="PSA 67:36" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="cl">68 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 68:1" />Хор вуйлатышылан. «Лилий-влак» семлан возымо. Давидын псаломжо.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Юмем, утаре мыйым –</para>
  <para style="q1" vid="PSA 68:2">вӱд шуын шӱй марте.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Пижынам мый келге купыш –</para>
  <para style="q1" vid="PSA 68:3">пеҥгыде мланде йол йымалнем уке.</para>
  <para style="q1" vid="PSA 68:3">Логалынам келге вӱдыш –</para>
  <para style="q1" vid="PSA 68:3">писе вӱдйогын мыйым наҥгая.<verse eid="PSA 68:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Кычкырен сӧрвалымем деч чот улненам,</para>
  <para style="q1" vid="PSA 68:4">логарем оралген.</para>
  <para style="q1" vid="PSA 68:4">Юмемым вучен, шинчамже ноен.<verse eid="PSA 68:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />Амал деч посна мыйым ужмышудымо еҥ-влак</para>
  <para style="q2" vid="PSA 68:5">вуйысо ӱпем дечат шукын улыт.</para>
  <para style="q1" vid="PSA 68:5">Мыйым нимолан поктылшо тушманем-влак вияҥыныт:</para>
  <para style="q1" vid="PSA 68:5">мом шолыштын омыл, тудым пӧртылтышаш улам.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Юмем, Тый палет мыйын ушдымылыкем,</para>
  <para style="q1" vid="PSA 68:6">титакем-влак Тый дечет шылтыме огытыл.<verse eid="PSA 68:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Господь, Господь Саваоф!</para>
  <para style="q1" vid="PSA 68:7">Тыланет инаныше-влак тек мыйын верч вожылтарыме огыт лий.</para>
  <para style="q1" vid="PSA 68:7">Израильын Юмыжо!</para>
  <para style="q1" vid="PSA 68:7">Тыйым кычалше-влак мыйын верч ынышт пуро намысыш.<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />Вет Тылат кӧра чытем шӱктарымашым,</para>
  <para style="q1" vid="PSA 68:8">вожылмаш леведын мыйын чурием.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Йот еҥ лийынам иза-шольо-влакемлан,</para>
  <para style="q1" vid="PSA 68:9">авамын эргыж-влаклан лийынам ӧрдыжъеҥ.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Тыйын пӧртетын чапше верч тыршымаш йӱлалта чонемым,</para>
  <para style="q1" vid="PSA 68:10">Тыйым вурсен ойлышо-влакын мыскылымышт возыт ӱмбакем.<verse eid="PSA 68:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Кунам мый шортам да пӱтым кучем,</para>
  <para style="q1" vid="PSA 68:11">тидлан мыйым мыскылат.<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />Кунам тыглай вургем олмеш чоштыра вургемым чием,</para>
  <para style="q1" vid="PSA 68:12">тидлан мыйым воштылыт.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Капка воктене шинчыше-влак мыйын нерген кутырат,</para>
  <para style="q1" vid="PSA 68:13">аракам йӱшӧ-шамыч шке мурыштышт мыйын нерген мурат.<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />А мый, Господь, Тылат кумалам,</para>
  <para style="q1" vid="PSA 68:14">келшыше жап годым Тыйым сӧрвалем.</para>
  <para style="q1" vid="PSA 68:14">Юмем, кугу порылыкет ден утарыше чынлыкетлан кӧра</para>
  <para style="q2" vid="PSA 68:14">мыйым кол.<verse eid="PSA 68:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Лук мыйым лӱкӧ лавыра гыч, ит пу мылам пуреҥгаяш.</para>
  <para style="q1" vid="PSA 68:15">Мыйым ужмышудымо-влак деч, келге вӱд деч утаре.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Ынже наҥгай мыйым вӱдйогын,</para>
  <para style="q1" vid="PSA 68:16">ынже нел мыйым келгыт,</para>
  <para style="q1" vid="PSA 68:16">ынже петыре умшажым ӱмбалнем поргем.<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Вашеште мыланем, Господь,</para>
  <para style="q1" vid="PSA 68:17">вет Тый улат чаманыше, ӱшанле,</para>
  <para style="q1" vid="PSA 68:17">шуко порылыкетлан кӧра ончал ӱмбакем.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />Ит шылте чуриетым шке тарзет деч,</para>
  <para style="q1" vid="PSA 68:18">вет мый кугу ойгыш логалнам.</para>
  <para style="q1" vid="PSA 68:18">Мыланем вашешташ Тый вашке,<verse eid="PSA 68:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />лишем мый декем, чонемым утаре,</para>
  <para style="q1" vid="PSA 68:19">тушман-влак дечын мыйым нал арален.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Палет Тый, кузе мыйым мыскылат,</para>
  <para style="q1" vid="PSA 68:20">шӱктарат да намыслат,</para>
  <para style="q1" vid="PSA 68:20">чыла тушманем улыт Тыйын ончылнет.<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Шӱмемжым кӱрыштеш мыскылымаш,</para>
  <para style="q1" vid="PSA 68:21">мый чот лунчыргенам.</para>
  <para style="q1" vid="PSA 68:21">Вучышым чаманымашым, но тудо уке,</para>
  <para style="q1" vid="PSA 68:21">кычальым лыпландарышым, но шым му.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Кочкышыш мылам шекшым пыштышт,</para>
  <para style="q1" vid="PSA 68:22">йӱмем шумо годым сыркам<note caller="*" style="f"><char style="fr" closed="false">68:22 </char><char style="ft" closed="false">Сырка – уксус.</char></note> йӱктышт.<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />Тек ӱстел сийышт нунылан лӧдӧ лиеш,</para>
  <para style="q1" vid="PSA 68:23">надыр пайремышт – йолыштлан вапш.<verse eid="PSA 68:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Тек шинчашт вудакаҥеш да сокыр лиеш,</para>
  <para style="q1" vid="PSA 68:24">тек йолышт нунын эре чытыра.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Оптал ӱмбакышт шке шыдетым,</para>
  <para style="q1" vid="PSA 68:25">тек йӱлышӧ шыдет нунын ӱмбак йога.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Лиеш тек яра нунын илыме верышт,</para>
  <para style="q1" vid="PSA 68:26">илыше-влак ынышт лий нунын омашыштышт.<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Вет кӧм Тый перенат, тудым поктылыт нунат,</para>
  <para style="q1" vid="PSA 68:27">кӧм сусыртенат, тудлан орлыкым ешарат.<verse eid="PSA 68:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Титакышт ӱмбак титакым ешаре,</para>
  <para style="q1" vid="PSA 68:28">тек чыныш лукмо огыт лий Тыйын ончылнет.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Тек лӱмышт илыш книга гыч ӱштылалтеш,</para>
  <para style="q1" vid="PSA 68:29">чын ыштыше-влак дене пырля возымо ок лий.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />А мый улам мыскынь, орлык мыйым авалтен.</para>
  <para style="q1" vid="PSA 68:30">Тек Тыйын полышет, Юмем, мыйым йол ӱмбаке шогалта.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Тунам Юмемын лӱмжым чапландарен мурем,</para>
  <para style="q1" vid="PSA 68:31">Тудым тауштен моктем.<verse eid="PSA 68:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Вет тӱкан да кӱчан самырык надыр ӱшкыж деч</para>
  <para style="q2" vid="PSA 68:32">Господьлан тиде путырак келша.<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Тидым ужын, шыгыремдалт илыше-шамыч куанат.</para>
  <para style="q1" vid="PSA 68:33">Юмым кычалше-влак, тендан шӱм-чонда ылыжеш,<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />вет Господь незер-влакын кумалмыштым колеш,</para>
  <para style="q1" vid="PSA 68:34">петырымаште шинчыше шке еҥже-влакым ок уж изиэш.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Тек моктат Тудым кава ден мланде,</para>
  <para style="q1" vid="PSA 68:35">теҥыз да тушто илыше-влак!<verse eid="PSA 68:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 68:36" />Вет Юмо утара Сионым,</para>
  <para style="q1" vid="PSA 68:36">Иудан ола-влакшым угыч нӧлталеш,</para>
  <para style="q1" vid="PSA 68:36">Тудын калыкше тушто илаш да озаланаш тӱҥалеш.<verse eid="PSA 68:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 68:37" />Юмын тарзыж-влакын тукымышт тиде мландым налыт,</para>
  <para style="q1" vid="PSA 68:37">Тудын лӱмжым йӧратыше-шамыч тушто илаш тӱҥалыт.<verse eid="PSA 68:37" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="cl">69 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 69:1" />Хор вуйлатышылан. Давидын псаломжо. Шарнашлан.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Юмем, мыйым утараш ит шуйкале,</para>
  <para style="q1" vid="PSA 69:2">Господь, мыланем полшаш вашке.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Тек мыйын чонемлан колымашым кычалше-влак</para>
  <para style="q2" vid="PSA 69:3">вожылтарыме, намысыш пуртымо лийыт.</para>
  <para style="q1" vid="PSA 69:3">Тек мыланем осалым шонышо-влак</para>
  <para style="q2" vid="PSA 69:3">мӧҥгеш савырыме да воштылчыкыш лукмо лийыт!<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />«Тыгак кӱлеш, тыгак кӱлеш!» манын мылам ойлышо-влак</para>
  <para style="q2" vid="PSA 69:4">тек, намысыш пурен, савырнат мӧҥгеш.<verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Тек Тыйым кычалше-влак чылан Тылат куанен йывыртат,</para>
  <para style="q1" vid="PSA 69:5">тек Тыйын утарымашетым йӧратыше-влак чарныде ойлат:</para>
  <para style="q1" vid="PSA 69:5">«Юмына кӱдыратле!»<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Мый улам незер да йорло –</para>
  <para style="q1" vid="PSA 69:6">вашке мый декем, Юмем!</para>
  <para style="q1" vid="PSA 69:6">Тый мыйын полышем, утарышем улат!</para>
  <para style="q1" vid="PSA 69:6">Тол, Господь, ит шуйкале!<verse eid="PSA 69:6" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="cl">70 ПСАЛОМ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Тыйын полышетлан, Господь, ӱшанен илем,</para>
  <para style="q1" vid="PSA 70:1">тек намысыш мый нигунам ом пуро.<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Лук мыйым эрыкыш, шке чынлыкет почеш утаре!</para>
  <para style="q1" vid="PSA 70:2">Кол мыйын йӱкем, мыйым утаре!<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Лий мыйын пеҥгыде аралтышем,</para>
  <para style="q1" vid="PSA 70:3">кушан мый эре шылын кертам.</para>
  <para style="q1" vid="PSA 70:3">Тый мыйым утараш шонен пыштенат,</para>
  <para style="q1" vid="PSA 70:3">Тый кӱ курыкем, чоткыдо карманем улат.<verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Юмем, утаре мыйым осал еҥын кидше деч,</para>
  <para style="q1" vid="PSA 70:4">вуянче да шыгыремдыше-влак деч утаре.<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Тый мыйын ӱшанем улат, Господь Юмем,</para>
  <para style="q1" vid="PSA 70:5">Тылат мый самырык годсек инанем.<verse eid="PSA 70:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 70:6" />Шочмем годсекак мый Тылат эҥертем,</para>
  <para style="q1" vid="PSA 70:6">ава мӱшкыр гыч мыйым Тый луктынат –</para>
  <para style="q1" vid="PSA 70:6">ом чарне Тыйым моктымем.<verse eid="PSA 70:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 70:7" />Лийынам мый шукыштлан ӧрмашым лукшо,</para>
  <para style="q1" vid="PSA 70:7">но Тый пеҥгыде аралтышем улат.<verse eid="PSA 70:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 70:8" />Тек умшам моктымаш дене темеш –</para>
  <para style="q1" vid="PSA 70:8">[мураш Тыйын чапет нерген,]</para>
  <para style="q1" vid="PSA 70:8">Тыйын сылнылыкетым кажне кечын моктен мураш.<verse eid="PSA 70:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 70:9" />Ит кодо мыйым шоҥго лиймекем,</para>
  <para style="q1" vid="PSA 70:9">вием пыташ тӱҥалме годым ит шӱкал Шке дечет.<verse eid="PSA 70:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 70:10" />Теве тушманем-влак мыйын ваштареш кутырат,</para>
  <para style="q1" vid="PSA 70:10">чонем ваҥыше-влак, погынен, шке коклаштышт ойлат:<verse eid="PSA 70:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 70:11" />«Юмо тудым коден.</para>
  <para style="q1" vid="PSA 70:11">Поктен кайыза, тудым кучыза –</para>
  <para style="q1" vid="PSA 70:11">тудын утарышыже уке».<verse eid="PSA 70:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 70:12" />Юмем, ит лий мый дечем тораште.</para>
  <para style="q1" vid="PSA 70:12">Мыйын Юмем, мыланем полшаш вашке.<verse eid="PSA 70:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 70:13" />Тек, намысыш пурен, мыйын тушманем-влак йомыт!</para>
  <para style="q1" vid="PSA 70:13">Осалым кӧ мылам шона, тек нуным вожылмаш да намыс леведыт!<verse eid="PSA 70:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 70:14" />А мый [Тылат] инанен илем,</para>
  <para style="q1" vid="PSA 70:14">Тыйым эшеат чот моктем.<verse eid="PSA 70:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 70:15" />Кажне кечын Тыйын чынлыкет нерген,</para>
  <para style="q2" vid="PSA 70:15">утарыше пашат-влак нерген ойлаш тӱҥалам,</para>
  <para style="q1" vid="PSA 70:15">кеч нуным шотлен пытаренат ом керт.<verse eid="PSA 70:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 70:16" />Господь Юмын кугу пашаж-влак нерген каласкалем,</para>
  <para style="q1" vid="PSA 70:16">Тыйын чынлыкетым, лач Тыйыным, мый увертарем.<verse eid="PSA 70:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 70:17" />Юмем, йоча жапем гычак мыйым туныктен шогенат,</para>
  <para style="q1" vid="PSA 70:17">ӧрыктарыше пашат-влак нерген таче мартеат увертарем.<verse eid="PSA 70:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 70:18" />Юмем, ит кодо мыйым шоҥго, чал ӱпан лиймекемат –</para>
  <para style="q1" vid="PSA 70:18">Тыйын виет нерген мый тиде тукымлан каласкалынем,</para>
  <para style="q1" vid="PSA 70:18">ончыкылык тукым-влаклан куатет нерген ойлынем.<verse eid="PSA 70:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 70:19" />Тыйын чынлыкет кавашке шуэш,</para>
  <para style="q1" vid="PSA 70:19">кӱдыратле улыт ыштыме пашат-влак.</para>
  <para style="q1" vid="PSA 70:19">Юмем, кӧ уло Тый гает?<verse eid="PSA 70:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 70:20" />Шуко неле орлыкым мылам Тый колтенат,</para>
  <para style="q1" vid="PSA 70:20">но угыч да угыч мыйым ылыжтенат,</para>
  <para style="q1" vid="PSA 70:20">мланде пундаш гыч луктынат.<verse eid="PSA 70:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 70:21" />Чапем нӧлталын, адакат лыпландаренат,</para>
  <para style="q1" vid="PSA 70:21">[мланде пундаш гыч мыйым луктынат].<verse eid="PSA 70:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 70:22" />Юмем, Тыйын порылыкетым арфе дене моктем,</para>
  <para style="q1" vid="PSA 70:22">Израильын Святойжо, кӱсле дене Тыйым моктен мурем!<verse eid="PSA 70:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 70:23" />Тылат мурымо годым умшам куан дене темеш,</para>
  <para style="q1" vid="PSA 70:23">йывырта чонем, кудым Тый утаренат.<verse eid="PSA 70:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 70:24" />Тыйын чынлыкет нерген йылмем кажне кечын ойла,</para>
  <para style="q1" vid="PSA 70:24">вет мылам осалым шонышо-влак</para>
  <para style="q2" vid="PSA 70:24">вожылтарыме да намысыш пуртымо улыт.<verse eid="PSA 70:24" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="cl">71 ПСАЛОМ</para>
  <para style="d">Соломонлан. [Давидын псаломжо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Юмем, кугыжалан чын судитлен моштыметым</para>
  <para style="q2" vid="PSA 71:1">да кугыжа эргылан шке чынлыкетым пӧлекле.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Тек Тыйын калыкетым тудо чын судитла,</para>
  <para style="q1" vid="PSA 71:2">йорло-влакетлан чын судым ышта.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Тек курык-влак калыклан тыныслыкым,</para>
  <para style="q2" vid="PSA 71:3">кӱкшака-влак чынлыкым кондат.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Тек йорло еҥлан кугыжа чын судым ышта,</para>
  <para style="q1" vid="PSA 71:4">незер-влакын йочаштым арален налеш,</para>
  <para style="q1" vid="PSA 71:4">а шыгыремдыше еҥым тек пытара.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Мыняр жап кече ден тылзе лийыт,</para>
  <para style="q1" vid="PSA 71:5">тынар жап еҥ-влак Тый дечет</para>
  <para style="q2" vid="PSA 71:5">тукым гыч тукымыш тек лӱдын шогат.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Тек кугыжа солен налме олыкыш йӱршӧ йӱр гай,</para>
  <para style="q2" vid="PSA 71:6">мландым вӱдыжтарыше кугу йӱр гай лиеш.<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Тудын кугыжаланымыж годым чын ыштыше еҥ тек тӱзлана,</para>
  <para style="q1" vid="PSA 71:7">тылзын уке лиймешкыже тыныслык тек озалана.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Теҥыз деч теҥыз марте,</para>
  <para style="q1" vid="PSA 71:8">Евфрат эҥер деч мланде тӱр марте</para>
  <para style="q2" vid="PSA 71:8">кугыжа тек оза лиеш.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Ир мландыште илыше-влак тудын ончык кумык возышт,</para>
  <para style="q1" vid="PSA 71:9">тушманже-влак пуракым нулышт.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Фарсисын да отро-влакын кугыжашт,</para>
  <para style="q2" vid="PSA 71:10">Сава<note caller="*" style="f"><char style="fr" closed="false">71:10 </char><char style="ft" closed="false">«Сава» – Грек текстыште «Аравий».</char></note> ден Севан кугыжашт тек тудлан пӧлекым кондат.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Чыла кугыжа кумык вочшо ончыланже,</para>
  <para style="q1" vid="PSA 71:11">чыла калык тӱҥалже тудлан тарзыланаш.<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Вет полышым йодшо йорло еҥлан тудо полша,</para>
  <para style="q1" vid="PSA 71:12">незер еҥым, кӧн полшышыжо уке, пыдалын налеш.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Йорло ден незерым тудо чамана,</para>
  <para style="q1" vid="PSA 71:13">нунын чоныштым утара.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Шыгыремдымаш да пызырымаш деч чоныштым утара,</para>
  <para style="q1" vid="PSA 71:14">нунын вӱрышт тудлан шергакан.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Тек тудо шуко ийым ила,</para>
  <para style="q1" vid="PSA 71:15">тек Сава гыч тудлан шӧртньым кондат.</para>
  <para style="q1" vid="PSA 71:15">Тек тудын верч эре кумалыт,</para>
  <para style="q1" vid="PSA 71:15">кажне кечын тудлан суапым йодыт.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Мландыште шурно ток лийже,</para>
  <para style="q1" vid="PSA 71:16">курыкыштат шурно парча Ливан чодыра семын лӱҥгалтше,</para>
  <para style="q1" vid="PSA 71:16">олаште еҥ-влак мландысе кушкыл семын шукемышт.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />[Моктымо лийже] тудын лӱмжӧ курымеш,</para>
  <para style="q1" vid="PSA 71:17">мыняр жап сандалыкым кече волгалтара,</para>
  <para style="q2" vid="PSA 71:17">тек тунар жап тудын лӱмжым шарнат.</para>
  <para style="q1" vid="PSA 71:17">[Мландысе чыла тукымлан] суапландарымаш тудын гоч толжо,</para>
  <para style="q1" vid="PSA 71:17">чыла калык кугыжам пиалан манже.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Моктымо лийже Господь Юмо, Израильын Юмыжо,</para>
  <para style="q1" vid="PSA 71:18">Тудо гына ӧрыктарыше пашам ышта!<verse eid="PSA 71:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Моктымо лийже Тудын чапланыше лӱмжӧ курымеш,</para>
  <para style="q1" vid="PSA 71:19">Тудын чапше дене уло мланде темже! Аминь, аминь!<verse eid="PSA 71:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="PSA 71:20" />Тидын дене Иессей эрге Давидын кумалме мутшо пытен.<verse eid="PSA 71:20" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="cl">72 ПСАЛОМ</para>
  <para style="d">Асафын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />Юмо Израиль деке чынжымак поро кумылан,</para>
  <para style="q1" vid="PSA 72:1">нунын деке, кӧмытын шӱм-чонышт яндар!<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />А мый изиш гына шым шӱртньӧ,</para>
  <para style="q1" vid="PSA 72:2">йолем изиш гына ыш яклешт.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Осал еҥ-влакын сайын илымыштым ужын,</para>
  <para style="q1" vid="PSA 72:3">нине намысдыме еҥ-шамычлан мый кӧранен колтышым.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Колымешкышт уке нунын нимогай йӧсылык,</para>
  <para style="q1" vid="PSA 72:4">чока капан, таза нуно улыт.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Моло еҥ семын огыт орлане,</para>
  <para style="q1" vid="PSA 72:5">илышын кочыжым огыт пале.<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Сандене кугешнымаш – нунын шӱшерышт,</para>
  <para style="q1" vid="PSA 72:6">пызырымаш – нунын чиемышт.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Кояҥмышт дене шинчаштат огеш кой,</para>
  <para style="q1" vid="PSA 72:7">уда, оккӱл шонымаш дене шӱмышт темын.<verse eid="PSA 72:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Мыскылен воштылыт, ойлат осалым,</para>
  <para style="q1" vid="PSA 72:8">шкеныштым кӱшкӧ шынден, весе-влакым лӱдыктылыт.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Умшашт кутыра пылпомыш ваштареш,</para>
  <para style="q1" vid="PSA 72:9">пӱтынь мланде ваштареш йылмышт ойла.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Юмын калыкшат савырна нунын могырыш,</para>
  <para style="q1" vid="PSA 72:10">нунын мутыштым вӱд семын корка тич кошталын йӱэш.<note caller="*" style="f"><char style="fr" closed="false">72:10 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Ойлат нуно: «Кузе Юмо пален налеш?</para>
  <para style="q1" vid="PSA 72:11">Чыла деч Кӱшылысӧ пала мо?»<verse eid="PSA 72:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Тыгае улыт нине осал еҥ-влак,</para>
  <para style="q1" vid="PSA 72:12">илат эре сайын, поянлыкым поген.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />[Каласенам мый:]</para>
  <para style="q1" vid="PSA 72:13">«Арам мо тугеже шӱмем яндарым кученам,</para>
  <para style="q2" vid="PSA 72:13">титакдыме улмем ончыкташ кидем мушкынам?»<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Кажне кечем орлык дене темын,</para>
  <para style="q1" vid="PSA 72:14">кажне эрдене мылам шылталымым колаш логалын.<verse eid="PSA 72:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Но каласем ыле гын:</para>
  <para style="q1" vid="PSA 72:15">«Тӱҥалам ойлаш мый нунын семын», –</para>
  <para style="q1" vid="PSA 72:15">Тыйын калыкетым ондалем ыле.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Шонкаленам мый: кузе гын чыла тидым умылаш,</para>
  <para style="q1" vid="PSA 72:16">но неле лийын тиде мыланем.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Вара гына, Юмын святой верышкыже пурымеке,</para>
  <para style="q1" vid="PSA 72:17">мый умыленам – могай мучаш нуным вуча.<verse eid="PSA 72:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Яклака корныш Тый нуным шогалтет,</para>
  <para style="q1" vid="PSA 72:18">Тый нуным пӱтынек пытарет.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Кузе нуно ик татыште пытарыме лийыт,</para>
  <para style="q1" vid="PSA 72:19">пытат нуно, мучашышт лиеш шучко!<verse eid="PSA 72:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Помыжалтмеке, кузе ужмо омым мондат,</para>
  <para style="q1" vid="PSA 72:20">туге Тылатат, Господь, кынелмекет,</para>
  <para style="q1" vid="PSA 72:20">нунын сынышт нигунам лийдыме гай лиеш.<verse eid="PSA 72:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 72:21" />Кунам шӱмемлан кочо лийын да кӧргем йӱлен,<verse eid="PSA 72:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 72:22" />умылен кертын омыл, лийынам шонен моштыдымо,</para>
  <para style="q1" vid="PSA 72:22">Тыйын ончылнет вольык гае лийынам.<verse eid="PSA 72:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 72:23" />Но мый эре улам Тый денет,</para>
  <para style="q1" vid="PSA 72:23">пурла кидем гыч Тый мыйым кучет.<verse eid="PSA 72:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 72:24" />Каҥашым пуэн, ончыктет мылам корным,</para>
  <para style="q1" vid="PSA 72:24">вара чапышке вӱден кондет.<verse eid="PSA 72:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 72:25" />Каваште Тый дечет моло кӧ мыйын уло?</para>
  <para style="q1" vid="PSA 72:25">Мландыштат Тый дечет моло мыланем нимо ок кӱл.<verse eid="PSA 72:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 72:26" />Мыйын капем ден чонем начарештыт,</para>
  <para style="q1" vid="PSA 72:26">но Юмо – шӱмемын пеҥгыдылыкше,</para>
  <para style="q1" vid="PSA 72:26">Тудо – курымешлан мыйын ужашем.<verse eid="PSA 72:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 72:27" />А Тый дечет кораҥше-влак пытат.</para>
  <para style="q1" vid="PSA 72:27">Пытарет Тый кажным, кӧ Тылат ӱшанле огыл.<verse eid="PSA 72:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 72:28" />Мыланем гын пиал – Юмо дек лишыл лияш!</para>
  <para style="q1" vid="PSA 72:28">Господь Юмо дене мый аралтышым муынам.</para>
  <para style="q1" vid="PSA 72:28">[Сион ӱдырын уремлаштыже]</para>
  <para style="q1" vid="PSA 72:28">Тыйын пашат-влак нерген ойлаш тӱҥалам.<verse eid="PSA 72:28" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="cl">73 ПСАЛОМ</para>
  <para style="d">Асафын туныктымашыже.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Юмына, молан Тый мемнам Шке дечет кораҥдышыч?</para>
  <para style="q1" vid="PSA 73:1">Молан кӱтӱэтын шорыкшо-влаклан шыдет ылыжын?<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Шарналте ожнак сулен налме калыкетым,</para>
  <para style="q2" vid="PSA 73:2">Шкаланет тӱлен налме тукымым,</para>
  <para style="q1" vid="PSA 73:2">да Сион курыкым, кушто Тый илаш тӱҥалынат.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Йолетым курымешлан сӱмырен кодымо пӧрт верыш виктаре –</para>
  <para style="q1" vid="PSA 73:3">святой верыште мо улмым тушман чыла шалатен.<verse eid="PSA 73:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Тыйын лӱмеш погынымо верыште тушман-влак ырлат.</para>
  <para style="q1" vid="PSA 73:4">Сеҥымаш пале семын шогалтеныт тушто шке тистыштым,<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />нугыдо чашкерыште пушеҥгым руышо семын товарыштым нӧлтыштыныт,<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />тушто улшо пӱчкеден ыштыме узор-влакым икте кодде</para>
  <para style="q2" vid="PSA 73:6">товар да шугыньо дене шалатеныт.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Святой верышкет нуно тулым чыкеныт,</para>
  <para style="q1" vid="PSA 73:7">Тыйын лӱметлан кумалме верым шакшыленыт.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Каласеныт шке шӱмыштышт: «Нуным пӱтынек пытарена»,</para>
  <para style="q1" vid="PSA 73:8">да ты элыште Юмын лӱмеш погынымо чыла верым йӱлалтеныт.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Нимогай палым она уж,</para>
  <para style="q1" vid="PSA 73:9">кодын огытыл пророк-влак мемнан коклаште,</para>
  <para style="q1" vid="PSA 73:9">чыла тиде мыняре шуйна – уке тидым палыше.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Юмына, эше мыняр жап тушман мыскылаш тӱҥалеш?</para>
  <para style="q1" vid="PSA 73:10">Курымеш мо тудо лӱметым шӱктараш тӱҥалеш?<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Молан Тый шке кидет дене, пурла кидет дене, от полшо?</para>
  <para style="q1" vid="PSA 73:11">Лук кидетым помышет гыч да нуным пытаре.<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Юмо – тӱҥалтыш гычак мыйын Кугыжам,</para>
  <para style="q1" vid="PSA 73:12">ыштет Тый мландымбалне утарымаш пашатым!<verse eid="PSA 73:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Шке куатет дене теҥызым кокыте шелынат,</para>
  <para style="q1" vid="PSA 73:13">вӱдыштӧ теҥыз кишке-влакын вуйыштым шалатенат.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Шалатенат левиафанын<note caller="*" style="f"><char style="fr" closed="false">73:14 </char><char style="ft" closed="false">Левиафан – теҥызыште илыше акрет годсо мифысе шуко вуян кугу янлык.</char></note> вуйжо-влакым,</para>
  <para style="q1" vid="PSA 73:14">пуэнат тудым ир мландысе [Эфиопий] калыклан кочкаш.<verse eid="PSA 73:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Тый почынат памаш ден йогын-влакым,</para>
  <para style="q1" vid="PSA 73:15">а кугу вӱдан эҥер-шамычым коштенат.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Кече – Тыйын, йӱдат – Тыйын,</para>
  <para style="q1" vid="PSA 73:16">тылзе ден кечымат Тый ыштенат.<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />Палемденат мландын чыла тӱржым,</para>
  <para style="q1" vid="PSA 73:17">кеҥеж ден телым ыштенат.<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Шарнен шого, Господь, кузе тушман игылт воштылеш,</para>
  <para style="q1" vid="PSA 73:18">ушдымо калык Тыйын лӱметым шӱктара.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Ит пу янлыклан шке кӧгӧрченетын чонжым,</para>
  <para style="q1" vid="PSA 73:19">незер калыкетым эрелан ит мондо.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Ит мондо шке ойпидышетым,</para>
  <para style="q1" vid="PSA 73:20">вет мландын чыла пычкемыш верже пызырымаш дене темын.<verse eid="PSA 73:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Шыгыремдыме еҥ мыскылалтше ынже кай,</para>
  <para style="q1" vid="PSA 73:21">йорло ден незер-влак тек лӱметым моктат.<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />Кынел, Юмем, да судитлалтме пашатым нал арален,</para>
  <para style="q1" vid="PSA 73:22">ушдымо еҥын Тыйым кечыгут шӱктарымыжым шарналте.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Ит мондо тушман-влакетын кычкырымыштым,</para>
  <para style="q1" vid="PSA 73:23">ваштарешет шогалше-влакын чарныде лӱшкымыштым.<verse eid="PSA 73:23" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="cl">74 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 74:1" />Хор вуйлатышылан. «Ит пытаре» семлан. Асафын псаломжо. Муро.<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Моктена ме Тыйым, Юмына, моктена,</para>
  <para style="q1" vid="PSA 74:2">вет мемнан деке Тый чак улат!</para>
  <para style="q1" vid="PSA 74:2">Ӧрыктарыше пашат-влак нерген еҥ-шамыч увертарат.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Каласенат Тый:</para>
  <para style="q1" vid="PSA 74:3">«Палемдыме жапыште Мый чын судым ыштем.<verse eid="PSA 74:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Чытырналтше кеч мланде да тушто чыла илыше,</para>
  <para style="q1" vid="PSA 74:4">тудым кучышо негыз меҥгым Мый пеҥгыдемдем.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Моктаныше-влаклан ойлем: ”Ида моктане”,</para>
  <para style="q1" vid="PSA 74:5">да осал-влаклан: ”Ида нӧлтӧ тӱкыдам.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Кӱшкӧ тӱкыдам ида нӧлтӧ,</para>
  <para style="q1" vid="PSA 74:6">вуйдам кӱшкӧ нӧлтен, [Юмо ваштареш] ида кутыро”».<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Эрвел гыч огыл, касвел гыч огыл,</para>
  <para style="q1" vid="PSA 74:7">ир мланде гычат огыл айдеме чапым нӧлтымаш,<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />а Юмо – чылаштлан судья:</para>
  <para style="q1" vid="PSA 74:8">иктым Тудо ӱлыкшемда, весым нӧлта.<verse eid="PSA 74:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Вет Господьын кидыште тич темыме чаше,</para>
  <para style="q1" vid="PSA 74:9">тушто шоҥалтеш тамлештарыме<note caller="*" style="f"><char style="fr" closed="false">74:9 </char><char style="ft" closed="false">Тамлештараш – приправлять. Йошкар аракам тӱрлӧ приправе дене тамлештареныт.</char></note> йошкар арака.</para>
  <para style="q1" vid="PSA 74:9">Тиде аракам Господь темкала,</para>
  <para style="q1" vid="PSA 74:9">мландымбалне илыше чыла осал еҥлан</para>
  <para style="q2" vid="PSA 74:9">тудын кучажымат йӱашышт логалеш.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />А мый Иаковын Юмыж нерген ойлаш,</para>
  <para style="q1" vid="PSA 74:10">Тудым курымеш моктен мураш тӱҥалам!<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />«Осал еҥ-шамычын тӱкыштым пудыртем,</para>
  <para style="q1" vid="PSA 74:11">да чын ыштыше-влакын тӱкышт нӧлталтыт».<verse eid="PSA 74:11" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="cl">75 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 75:1" />Хор вуйлатышылан. Кылан семӱзгар дене. Асафын псаломжо. Муро.<verse eid="PSA 75:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Иуда мландыште Юмым палат,</para>
  <para style="q1" vid="PSA 75:2">Израильыште Тудын лӱмжӧ кугу.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Салимыште Тудо ила,</para>
  <para style="q1" vid="PSA 75:3">Сионышто Тудын илыме верже.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Тушто Тудо йоҥеж пикшым, авыртыш ден кердым</para>
  <para style="q2" vid="PSA 75:4">да моло саргуралым пудыртен.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Чапет Тыйын волгалтеш,</para>
  <para style="q1" vid="PSA 75:5">янлык илыме курык-влак деч Тый куатан улат.<verse eid="PSA 75:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Лӱддымӧ сарзе-влакын мо улыштым поген налме,</para>
  <para style="q1" vid="PSA 75:6">нуным омо темдалын, кидыштышт вий кодын огыл.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Тыйын кӱштымӧ йӱкет деч, Иаковын Юмыжо,</para>
  <para style="q2" vid="PSA 75:7">орва ден имне-влакат пуйто пич омо дене мален колтеныт.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Лӱдмашым лукшо Юмо Тый улат,</para>
  <para style="q1" vid="PSA 75:8">Тыйын шыдешкымет годым чурий ончылнет кӧ шоген кертеш?<verse eid="PSA 75:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Увертаренат пылпомыш гыч Тый судым,</para>
  <para style="q1" vid="PSA 75:9">да мланде лӱдмыж дене шыпланен.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />Шогалын Юмо судым ышташ,</para>
  <para style="q1" vid="PSA 75:10">мландымбалне пызырналт илыше чыла еҥым Тудо утара.<verse eid="PSA 75:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 75:11" />Еҥ-влакын шыдыштат конда Тылат чапым,</para>
  <para style="q1" vid="PSA 75:11">кодшо шыдетым саргурал семын Тый ӱштальыч ӱмбакет.<verse eid="PSA 75:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 75:12" />Господь Юмыланда сӧрымаш-влакым пуыза</para>
  <para style="q2" vid="PSA 75:12">да нуным шуктыза,</para>
  <para style="q1" vid="PSA 75:12">тек йыр улшо-влак чылан лӱдмашым лукшо Юмылан пӧлекым кондат.<verse eid="PSA 75:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 75:13" />Вуйлатыше-влакым Тудо темдалеш,</para>
  <para style="q1" vid="PSA 75:13">мландымбалысе кугыжа-влаклан Юмо лӱдмашан.<verse eid="PSA 75:13" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="cl">76 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 76:1" />Хор вуйлатыше Идифунлан. Асафын псаломжо.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Юмо деч полышым йодын кумалам,</para>
  <para style="q1" vid="PSA 76:2">Юмым сӧрвалем, да Тудо мыйым колеш.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Кунам мылам неле, кычалам Господьым,</para>
  <para style="q1" vid="PSA 76:3">кидем Тудын дек йӱдымат нӧлталме,</para>
  <para style="q1" vid="PSA 76:3">ынеж лыплане мыйын чонем.<verse eid="PSA 76:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Юмо нерген шонен, каньысырланем,</para>
  <para style="q1" vid="PSA 76:4">шонкалем мый – чонемланже шуй чучеш.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />От пу Тый мылам шинчам петыраш,</para>
  <para style="q1" vid="PSA 76:5">чонем пудырана – ом керт кутыренат.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Ончычсо жапым, эртен кайыше ийлам шонкалем.<verse eid="PSA 76:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Йӱдым шарналтем мурым мурымем,</para>
  <para style="q1" vid="PSA 76:7">шӱмыштем шонкалем, чонем вашмутым кычалеш:<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />йӧршешлан мо Господь мемнам Шкеж деч кораҥден,</para>
  <para style="q1" vid="PSA 76:8">суапшым ок ончыкто мо тетла?<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />Йӧршешлан мо пытен Тудын порылыкшо,</para>
  <para style="q1" vid="PSA 76:9">тукым гыч тукымыш ойлымо мутшылан мучаш толын мо?<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Монден мо Юмо сайым ышташ,</para>
  <para style="q1" vid="PSA 76:10">шыдешкымыжлан кӧра тетла ынеж чамане мо?<verse eid="PSA 76:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Шоненам мый:</para>
  <para style="q1" vid="PSA 76:11">«Чыла деч Кӱшылысын кидше мемнам тетла ок арале –</para>
  <para style="q1" vid="PSA 76:11">теве мо ойгандара чонем».<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Мом Господь ыштен, мый ом мондо.</para>
  <para style="q1" vid="PSA 76:12">Ондак ыштыме ӧрыктарыше пашат-влакым шарнем,<verse eid="PSA 76:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 76:13" />Тыйын ыштыме пашат-влак нерген,</para>
  <para style="q2" vid="PSA 76:13">кӱдыратле пашат-влак нерген шонкалем.<verse eid="PSA 76:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 76:14" />Юмына, Тыйын корнет святой!</para>
  <para style="q1" vid="PSA 76:14">Уло мо мемнан Юмына гай вес кугу Юмо?<verse eid="PSA 76:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 76:15" />Тый ӧрыктарыше паша-влакым ыштыше Юмо улат,</para>
  <para style="q1" vid="PSA 76:15">калык-влак коклаште шке куатет ончыктенат.<verse eid="PSA 76:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 76:16" />Виян кидет дене Тый шке калыкетым,</para>
  <para style="q2" vid="PSA 76:16">Иаков ден Иосиф эрге-влакым, утаренат.<verse eid="PSA 76:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 76:17" />Вӱд-влак Тыйым ужыныт, Юмына,</para>
  <para style="q1" vid="PSA 76:17">вӱд-влак Тыйым ужыныт да лӱдыныт,</para>
  <para style="q1" vid="PSA 76:17">пундашдыме келгыт-шамыч чытыреныт.<verse eid="PSA 76:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 76:18" />Пыл-влак вӱдым йоктареныт,</para>
  <para style="q1" vid="PSA 76:18">каваште кӱдырчӧ кӱдыртен,</para>
  <para style="q1" vid="PSA 76:18">Тыйын волгенче пикшет-влак чоҥештылыныт.<verse eid="PSA 76:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 76:19" />Тыйын кӱдыртымӧ йӱкет пылпомышышто шергылтын,</para>
  <para style="q1" vid="PSA 76:19">волгенче-влак тӱням волгалтареныт –</para>
  <para style="q1" vid="PSA 76:19">мланде лӱҥгалтын да чытырнен.<verse eid="PSA 76:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 76:20" />Тыйын корнет эртен теҥыз гочын,</para>
  <para style="q1" vid="PSA 76:20">йолгорнет келге вӱд гоч каен,</para>
  <para style="q1" vid="PSA 76:20">Тыйын йол кышатым нигӧ ужын огыл.<verse eid="PSA 76:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 76:21" />Тый шке калыкетым шорык кӱтӱ семын</para>
  <para style="q2" vid="PSA 76:21">Моисей ден Ааронын кидышт дене наҥгаенат.<verse eid="PSA 76:21" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="cl">77 ПСАЛОМ</para>
  <para style="d">Асафын туныктымашыже.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Колышт, калыкем, мыйын туныктымем,</para>
  <para style="q1" vid="PSA 77:1">ойлымо шомакем дек савыре пылышет.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Туштен ойлаш йылмем рудем,</para>
  <para style="q1" vid="PSA 77:2">акрет годсо туштым мый ойлем.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Мом колынна да пален налынна,</para>
  <para style="q1" vid="PSA 77:3">мом ачана-влак мыланна каласкаленыт –<verse eid="PSA 77:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />йоча-влак дечын она шылте,</para>
  <para style="q1" vid="PSA 77:4">толшаш тукымлан ме Господьын чапшым,</para>
  <para style="q2" vid="PSA 77:4">Тудын куатше ден ӧрыктарыше пашаж-влакым увертарена.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Пуэн Иаковлан Тудо сугыньым,</para>
  <para style="q1" vid="PSA 77:5">Израильлан – шке законжым,</para>
  <para style="q1" vid="PSA 77:5">тудым ачана-влак шке йочаштлан туныктышт манын кӱштен коден.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Палышт тудым кушкын шушо тукым,</para>
  <para style="q1" vid="PSA 77:6">ончыкшым шочшаш йоча-влак,</para>
  <para style="q1" vid="PSA 77:6">да нунат шке жапыштыже икшывыштлан ойлышт.<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />Тек Юмо лиеш нунын ӱшанышт,</para>
  <para style="q1" vid="PSA 77:7">Юмын пашажым нуно ынышт мондо</para>
  <para style="q1" vid="PSA 77:7">да Тудын кӱштымашыж-влакым шуктен шогышт.<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Ынышт лий нуно ача-кочашт гай,</para>
  <para style="q1" vid="PSA 77:8">нунышт ӱскырт, мут колыштдымо тукым лийыныт,</para>
  <para style="q1" vid="PSA 77:8">шӱмышт кокытеланыше улмаш,</para>
  <para style="q1" vid="PSA 77:8">чонышт Юмылан ӱшанле лийын огыл.<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Пикшым лӱйкалыше саргуралан Ефрем эрге-влак</para>
  <para style="q2" vid="PSA 77:9">кредалме кечын тушман деч куржыныт.<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Юмын ойпидышыжым нуно шуктен огытыл,</para>
  <para style="q1" vid="PSA 77:10">Тудын законжо почеш илаш келшен огытыл.<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Монденыт нуно Тудын мом ыштымыжым,</para>
  <para style="q1" vid="PSA 77:11">нунылан ончыктымо ӧрыктарыше пашаж-влакым.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Ачаштын шинча ончылнышт Египет мландыште, Цоан кундемыште</para>
  <para style="q2" vid="PSA 77:12">Юмо ӧрыктарыше паша-влакым ыштен.<verse eid="PSA 77:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Теҥызым шелын да нуным тудын гоч луктын,</para>
  <para style="q1" vid="PSA 77:13">вӱдым пырдыж семын шогалтен.<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Вӱден каен нуным кечывалым пыл дене,</para>
  <para style="q1" vid="PSA 77:14">а йӱдым тул волгыдо дене наҥгаен.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Ир мландыште Тудо кӱм шелын,</para>
  <para style="q1" vid="PSA 77:15">пуйто кугу келгыт гыч вӱдым луктын, нуным йӱктен.<verse eid="PSA 77:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Кӱ курык гыч луктын йогыным,</para>
  <para style="q1" vid="PSA 77:16">да вӱд эҥер семын йоген.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Но нуно Тудын ваштареш сулыкым тугак ыштеныт,</para>
  <para style="q1" vid="PSA 77:17">Чыла деч Кӱшылысым ир мландыште колыштын огытыл.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Юмым нуно лӱмынак тергеныт,</para>
  <para style="q1" vid="PSA 77:18">чоныштлан келшыше кочкышым пуаш йодыныт.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Юмо ваштареш ӧпкелен ойленыт:</para>
  <para style="q1" vid="PSA 77:19">«Кертеш мо Юмо ир мландыште ӱстелым поген?<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Чынжымак, Тудо кӱм перен,</para>
  <para style="q1" vid="PSA 77:20">да тушеч вӱд лектын, эҥер семын йоген.</para>
  <para style="q1" vid="PSA 77:20">А кертеш мо Тудо киндымат пуэн,</para>
  <para style="q1" vid="PSA 77:20">шке калыкшылан шылымат пукшен?»<verse eid="PSA 77:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 77:21" />Господь тидым колын да моткоч шыдешкен,</para>
  <para style="q1" vid="PSA 77:21">тул лектын Иаков ӱмбаке,</para>
  <para style="q1" vid="PSA 77:21">шыдыже ылыжын Израиль ваштареш.<verse eid="PSA 77:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 77:22" />Вет ӱшанен огытыл нуно Юмылан,</para>
  <para style="q1" vid="PSA 77:22">Тудын утарымыжлан инанен огытыл.<verse eid="PSA 77:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 77:23" />Но пыл-влаклан Тудо пуэн кӱштымашым,</para>
  <para style="q1" vid="PSA 77:23">кавасе омса-влакым почын<verse eid="PSA 77:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 77:24" />да ӱмбакышт йӱр семын манным колтен,</para>
  <para style="q1" vid="PSA 77:24">кава гыч киндым нунылан кочкаш пуэн.<verse eid="PSA 77:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 77:25" />Суксо-влакын кондымо киндыштым кочкын айдеме,</para>
  <para style="q1" vid="PSA 77:25">нунылан кочкышым Юмо ток колтен.<verse eid="PSA 77:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 77:26" />Эрвел мардежым Тудо тарватен кава гыч,</para>
  <para style="q1" vid="PSA 77:26">куатше дене кечывалвел мардежым конден,<verse eid="PSA 77:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 77:27" />пурак наре йӱрыктен нунылан Тудо шылым,</para>
  <para style="q1" vid="PSA 77:27">теҥыз ошма наре шулдыран кайыкым кышкен.<verse eid="PSA 77:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 77:28" />Нунын станышкышт, омашышт воктек</para>
  <para style="q2" vid="PSA 77:28">Тудо кайыкым кышкен.<verse eid="PSA 77:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 77:29" />Нуно кочкыныт, утыждене темыныт,</para>
  <para style="q1" vid="PSA 77:29">мо шонымыштым Тудо нунылан пуэн.<verse eid="PSA 77:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 77:30" />Но нунын эше шерышт темын огыл,</para>
  <para style="q1" vid="PSA 77:30">умшаштышт эше кочкыш улмаш,<verse eid="PSA 77:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 77:31" />ӱмбакышт Юмын шыдыже ылыжын:</para>
  <para style="q1" vid="PSA 77:31">нунын виян еҥыштым пуштын,</para>
  <para style="q1" vid="PSA 77:31">Израильын самырык пӧръеҥже-влакым сӱмырен кудалтен.<verse eid="PSA 77:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 77:32" />Тидын деч варат нуно сулыкым ыштымыштым чарнен огытыл,</para>
  <para style="q1" vid="PSA 77:32">Тудын ӧрыктарыше пашаж-влаклан ӱшанен огытыл.<verse eid="PSA 77:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 77:33" />Сандене Тудо илыме кечыштлан мучашым пыштен,</para>
  <para style="q1" vid="PSA 77:33">нунышт шӱлалтыш семын йомыныт –</para>
  <para style="q1" vid="PSA 77:33">илыме ийлаштым Тудо шучкын пытарен.<verse eid="PSA 77:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 77:34" />Кунам Юмо нуным пуштеден,</para>
  <para style="q1" vid="PSA 77:34">нуно Тудым кычалыныт, Тудын дек савырненыт,</para>
  <para style="q1" vid="PSA 77:34">эр гычак тӱҥалын, Юмо дек лишемаш тыршеныт.<verse eid="PSA 77:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 77:35" />Шарналтеныт тунам: Юмо – нунын кӱ курыкышт,</para>
  <para style="q1" vid="PSA 77:35">Чыла деч Кӱшылысӧ Юмо – нуным Утарыше.<verse eid="PSA 77:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 77:36" />Туге гынат нуно умшашт дене Тудым ондаленыт,</para>
  <para style="q1" vid="PSA 77:36">йылмышт дене шойыштыныт.<verse eid="PSA 77:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 77:37" />Шӱмышт Тудын ончылно чын лийын огыл,</para>
  <para style="q1" vid="PSA 77:37">Тудын ойпидышыжлан нуно ӱшанле лийын огытыл.<verse eid="PSA 77:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 77:38" />Но Тудо, поро кумылан,</para>
  <para style="q1" vid="PSA 77:38">сулыкыштым кудалтен да нуным пытарен огыл,</para>
  <para style="q1" vid="PSA 77:38">шуко гана сырымашыжым кораҥден,</para>
  <para style="q1" vid="PSA 77:38">уло шыдыжлан ылыжаш пуэн огыл.<verse eid="PSA 77:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 77:39" />Тудо шарнен: улыт нуно айдеме гына,</para>
  <para style="q1" vid="PSA 77:39">шӱлалтыш, кудо лектеш да мӧҥгеш ок пӧртыл.<verse eid="PSA 77:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 77:40" />Мыняр гана нуно ир мландыште Тудын ваштареш шогалыныт,</para>
  <para style="q1" vid="PSA 77:40">еҥ илыдыме верыште Тудым ойгандареныт!<verse eid="PSA 77:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 77:41" />Угыч да угыч нуно Юмым тергеныт,</para>
  <para style="q1" vid="PSA 77:41">Израильын Святойжым йӧсландареныт.<verse eid="PSA 77:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 77:42" />Шарналтен огытыл Тудын виян кидшым,</para>
  <para style="q2" vid="PSA 77:42">нуным пызыралтмаш деч утарыме кечыжым.<verse eid="PSA 77:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 77:43" />Тунам Тудо Египетыште палдарыше палыж-влакым,</para>
  <para style="q1" vid="PSA 77:43">шке ӧрыктарыше пашаж-влакым Цоан кундемыште ончыктен.<verse eid="PSA 77:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 77:44" />Египтян-влакын эҥерыштым Тудо вӱрыш савырен,</para>
  <para style="q1" vid="PSA 77:44">нуно вӱдйогынышт гыч йӱын кертын огытыл.<verse eid="PSA 77:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 77:45" />Нуным пурашлан колтен ӱмбакышт пормо-влакым</para>
  <para style="q1" vid="PSA 77:45">да ужава-шамычым – орлыкым кондашлан.<verse eid="PSA 77:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 77:46" />Пуэн шукш-влаклан нунын мланде кушкылыштым,</para>
  <para style="q1" vid="PSA 77:46">да шурнышырчыклан – паша лектышыштым.<verse eid="PSA 77:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 77:47" />Виноград вондыштым шолемлан кырыктен,</para>
  <para style="q1" vid="PSA 77:47">ир смоква пушеҥгыштым йӱштӧ налын.<verse eid="PSA 77:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 77:48" />Вольыкышт ӱмбак шолемым колтен,</para>
  <para style="q1" vid="PSA 77:48">кӱтӱштым волгенче дене пытарен.<verse eid="PSA 77:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 77:49" />Колтен нунын ӱмбак йӱлышӧ шыдыжым,</para>
  <para style="q1" vid="PSA 77:49">сырымаш ден неле орлыкым ӱмбакышт йоктарен –</para>
  <para style="q1" vid="PSA 77:49">пытарыше суксо-влакым пеш шуко колтен.<verse eid="PSA 77:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 77:50" />Кучаш тӱҥалын огыл Тудо шыдыжым,</para>
  <para style="q1" vid="PSA 77:50">арален огыл колымаш деч чоныштым –</para>
  <para style="q1" vid="PSA 77:50">нуным шучко черлан пуэн.<verse eid="PSA 77:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 77:51" />Египетын чыла кугэргыжым пуштын,</para>
  <para style="q1" vid="PSA 77:51">Хамын илемыштыже пӧръеҥ вийын икымше саскажым пытарен.<verse eid="PSA 77:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 77:52" />Луктын шке калыкшым шорык семын,</para>
  <para style="q1" vid="PSA 77:52">ир мландыште нуным кӱтӱ семын наҥгаен.<verse eid="PSA 77:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 77:53" />Корныштышт Тудо арален каен,</para>
  <para style="q1" vid="PSA 77:53">лӱдын огытыл нуно нимо деч,</para>
  <para style="q1" vid="PSA 77:53">а тушманыштым теҥыз петырен.<verse eid="PSA 77:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 77:54" />Нуным Тудо шке святой мландышкыже,</para>
  <para style="q2" vid="PSA 77:54">шке кидше дене сеҥен налме курыкышкыжо, конден.<verse eid="PSA 77:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 77:55" />Тусо калык-влакым нунын ончыч поктен колтен,</para>
  <para style="q1" vid="PSA 77:55">мландыштым Израиль калыклан шеледен пуэн,</para>
  <para style="q1" vid="PSA 77:55">илемышкышт Израиль тукым-влакым вераҥден.<verse eid="PSA 77:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 77:56" />Но нуно умбакыжат Юмым тергеныт,</para>
  <para style="q1" vid="PSA 77:56">Чыла деч Кӱшылысӧ ваштареш шогалыныт,</para>
  <para style="q1" vid="PSA 77:56">Тудын сугыньжым шуктен огытыл.<verse eid="PSA 77:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 77:57" />Ача-кочашт семын Юмо деч кораҥыныт,</para>
  <para style="q1" vid="PSA 77:57">Тудлан ӱшанле лийын огытыл –</para>
  <para style="q1" vid="PSA 77:57">йӧрдымӧ пикшйоҥеж гай нуно лийыныт.<verse eid="PSA 77:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 77:58" />Кумалме кӱкшакашт дене Юмым шыдештареныт,</para>
  <para style="q1" vid="PSA 77:58">шке ыштыме юмышт дене Тудым сырыктеныт.<verse eid="PSA 77:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 77:59" />Тидым ужын, Юмо чот сырен,</para>
  <para style="q1" vid="PSA 77:59">Израильлан Тудо шыдешкен:<verse eid="PSA 77:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 77:60" />коден каен Силомысо илыме вержым –</para>
  <para style="q1" vid="PSA 77:60">еҥ-влак коклаште илыме скинийжым.<verse eid="PSA 77:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 77:61" />Пуэн шке куатшым<note caller="*" style="f"><char style="fr" closed="false">77:61 </char><char style="ft" closed="false">«Куатшым» – Тыште Юмын шондыкшо нерген ойлалтеш, тудым филистим-влак руалтен налыныт. Ончо: 1 Куг 4-ше глава.</char></note> пленыш,</para>
  <para style="q1" vid="PSA 77:61">шке чапшым – тушман кидыш.<verse eid="PSA 77:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 77:62" />Шке калыкшылан Юмо шыдешкен,</para>
  <para style="q1" vid="PSA 77:62">тудым керде дене пушташ пуэн.<verse eid="PSA 77:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 77:63" />Тул кочкын нунын рвезыштым,</para>
  <para style="q1" vid="PSA 77:63">сӱан мурым мурен огытыл ӱдырыштлан.<verse eid="PSA 77:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 77:64" />Иерей-влакышт керде деч пытеныт,</para>
  <para style="q1" vid="PSA 77:64">тулык ватышт шортмо йӱлам эртарен кертын огытыл.<verse eid="PSA 77:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 77:65" />Тунам омо деч вара помыжалтше,</para>
  <para style="q1" vid="PSA 77:65">аракам йӱмӧ деч вара шӧрлышӧ патыр семын</para>
  <para style="q2" vid="PSA 77:65">Господь помыжалтын.<verse eid="PSA 77:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 77:66" />Тушман-влакым мӧҥгеш куржыктен,</para>
  <para style="q1" vid="PSA 77:66">курымаш намысыш нуным пуртен.<verse eid="PSA 77:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 77:67" />Иосифын илыме вержым кудалтен каен,</para>
  <para style="q1" vid="PSA 77:67">Ефрем тукымым Шкаланже ойырен налын огыл,<verse eid="PSA 77:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 77:68" />но Иуда тукымым, йӧратыме Сион курыкшым,</para>
  <para style="q2" vid="PSA 77:68">Тудо ойырен налын.<verse eid="PSA 77:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 77:69" />Тушан Шкаланже кава гай кӱкшӧ святой верым чоҥен,</para>
  <para style="q1" vid="PSA 77:69">курымешлан тудым мланде гай пеҥгыдым ыштен.<verse eid="PSA 77:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 77:70" />Ойырен налын шке Давид тарзыжым,</para>
  <para style="q1" vid="PSA 77:70">шорык кудывече гыч тудым налын.<verse eid="PSA 77:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 77:71" />Пачам пукшышо шорык кокла гыч</para>
  <para style="q2" vid="PSA 77:71">конден тудым шке калыкшым кӱташ –</para>
  <para style="q1" vid="PSA 77:71">кӱташ Иаковым, шке Израиль калыкшым.<verse eid="PSA 77:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 77:72" />Нуным Давид яндар шӱм-чон дене кӱтен,</para>
  <para style="q1" vid="PSA 77:72">уста кид дене вуйлатен.<verse eid="PSA 77:72" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="cl">78 ПСАЛОМ</para>
  <para style="d">Асафын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Юмем, йот калык-влак мландышкет тольыч,</para>
  <para style="q1" vid="PSA 78:1">Тыйын святой храметым шакшылышт,</para>
  <para style="q1" vid="PSA 78:1">Иерусалимым шалатен пытарышт.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />Тарзе-влакетын капыштым кайыклан,</para>
  <para style="q2" vid="PSA 78:2">ӱшанле-влакетын капыштым янлыклан кочкаш пуышт.<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />Иерусалим мучко вӱрыштым вӱд семын йоктарышт,</para>
  <para style="q1" vid="PSA 78:3">нуным тойышо нигӧ уке.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Пошкудо-влаклан ме воштылчык лийна,</para>
  <para style="q1" vid="PSA 78:4">йыр улшо калык мемнам вурса да мыскыла.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Мыняр жап эше, Господь, мыланна Тый сырет,</para>
  <para style="q1" vid="PSA 78:5">эре мо йӱлаш тӱҥалеш тул семын Тыйын шыдет?<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />Тыйым палыдыме калык-влак ӱмбак шыдетым оптал,</para>
  <para style="q1" vid="PSA 78:6">лӱметым ӱжде илыше кугыжаныш-влак ӱмбак сырыметым йоктаре,<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />вет нуно Иаковым пытареныт,</para>
  <para style="q1" vid="PSA 78:7">тудын илыме вержым пустаҥденыт.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Ит пыште мемнан ӱмбак ача-кочанан сулыкыштым,</para>
  <para style="q1" vid="PSA 78:8">шке порылыкетлан кӧра вашке мемнам серлаге,</para>
  <para style="q1" vid="PSA 78:8">вет чот мыскыньыш ме савырненна.<verse eid="PSA 78:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Полшо мыланна, Юмына, мемнан Утарышына,</para>
  <para style="q2" vid="PSA 78:9">шке лӱметын чапшылан кӧра.</para>
  <para style="q1" vid="PSA 78:9">Шке лӱметлан верч мемнам утаре,</para>
  <para style="q1" vid="PSA 78:9">сулыкнам Тый кудалте.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Ынышт ойло йот калык-влак:</para>
  <para style="q1" vid="PSA 78:10">«Кушто нунын Юмышт?»</para>
  <para style="q1" vid="PSA 78:10">Тарзет-влакын вӱрыштым йоктарымылан</para>
  <para style="q2" vid="PSA 78:10">тек мемнан шинча ончылно калык-влаклан ӱчӧ шукталтеш,</para>
  <para style="q1" vid="PSA 78:10">тек пален налыт калык-влак тидын нерген.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Пленыште улшо-влакын йӧсланен кычкырымыштым кол,</para>
  <para style="q1" vid="PSA 78:11">пушташ пуымо-шамычым виян кидет дене утаре.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />Шым пачаш пӧртылтӧ кажне пошкудо калыклан,</para>
  <para style="q2" vid="PSA 78:12">Тыйым, Господь, шӱктарымыштлан.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />А ме, Тыйын калыкет да кӱтӱэтын шорыкшо-влак,</para>
  <para style="q2" vid="PSA 78:13">курымеш Тылат таум ыштена,</para>
  <para style="q1" vid="PSA 78:13">тукым гыч тукымыш Тыйым моктен мурена.<verse eid="PSA 78:13" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="cl">79 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 79:1" />Хор вуйлатышылан. «Лилий-влак» семлан возымо. Асафын таныклымыже. Псалом.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Колышт мемнам, Израильын Кӱтӱчыжӧ,</para>
  <para style="q2" vid="PSA 79:2">кӱтӱ семын Иосифым Вӱдышӧ!</para>
  <para style="q1" vid="PSA 79:2">Волгалт лишем, херувим-влак ӱмбалне Шинчыше!<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Ончыкто шке виетым Ефрем, Вениамин да Манассий ончылно,</para>
  <para style="q1" vid="PSA 79:3">тол утараш мемнам.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Юмына, мемнам угыч йол ӱмбак шогалте!</para>
  <para style="q1" vid="PSA 79:4">Тек чуриет мемнам волгалтара, да ме утарыме лийына!<verse eid="PSA 79:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Господь Юмо Саваоф,</para>
  <para style="q1" vid="PSA 79:5">калыкетын кумалмыжлан мыняр эше шыдешкаш тӱҥалат?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Тый нунылан шинчавӱд киндым пукшенат,</para>
  <para style="q1" vid="PSA 79:6">пеш шуко шинчавӱдым йӱктенат.<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Пошкудына-влак мемнан мландынам тавалат,</para>
  <para style="q1" vid="PSA 79:7">тушман-влаклан ме воштылчык улына.<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Саваоф Юмо, мемнам угыч йол ӱмбак шогалте!</para>
  <para style="q1" vid="PSA 79:8">Тек чуриет мемнам волгалтара, да ме утарыме лийына!<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Египет гыч Тый виноград вондым конденат,</para>
  <para style="q1" vid="PSA 79:9">поктен колтен калык-влакым, тудым шынденат,<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />эрыктенат тудлан верым.</para>
  <para style="q1" vid="PSA 79:10">Тудо вожым колтен, мланде мучко шарлен.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Тудын ӱмылжӧ курык-влакым леведын,</para>
  <para style="q1" vid="PSA 79:11">укшыж-влак Юмын кедр гай лийыныт.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Шарлен тудын укшыжо теҥыз марте,</para>
  <para style="q1" vid="PSA 79:12">игыж-влак эҥер<note caller="*" style="f"><char style="fr" closed="false">79:12 </char><char style="ft" closed="false">«Эҥер» – Тыште Евфрат нерген ойлалтеш.</char></note> дек шумеш шуыныт.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Молан шалатенат тудым авырыше пырдыжым?</para>
  <para style="q1" vid="PSA 79:13">Кажне эртен кайыше ынде саскажым кӱрыштеш!<verse eid="PSA 79:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 79:14" />Тудым ир сӧсна пургедеш, янлык кочкеш.<verse eid="PSA 79:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 79:15" />Саваоф Юмо, савырне, ончал пылпомыш гыч,</para>
  <para style="q1" vid="PSA 79:15">тиде виноград вондетым толын ончал!<verse eid="PSA 79:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 79:16" />Шке кидет дене шындымым,</para>
  <para style="q2" vid="PSA 79:16">вияҥден куштымо игетым арален кодо.<verse eid="PSA 79:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 79:17" />Тудо тул дене йӱлалтыме, пӱчкедыме...</para>
  <para style="q1" vid="PSA 79:17">Тек Тыйын шыдет деч тушман-влак пытат!<verse eid="PSA 79:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 79:18" />Пурла велнет улшо айдеме эргым,</para>
  <para style="q1" vid="PSA 79:18">кӧм Тый Шкаланет виян тарзым ыштенат,</para>
  <para style="q1" vid="PSA 79:18">тек Тыйын кидет арален шога.<verse eid="PSA 79:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 79:19" />Ме Тый дечет огына кораҥ!</para>
  <para style="q1" vid="PSA 79:19">Иландаре мемнам, ме Тыйын лӱметым ӱжаш тӱҥалына!<verse eid="PSA 79:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 79:20" />Господь Юмо Саваоф,</para>
  <para style="q1" vid="PSA 79:20">мемнам угыч йол ӱмбак шогалте!</para>
  <para style="q1" vid="PSA 79:20">Тек чуриет мемнам волгалтара, да ме утарыме лийына!<verse eid="PSA 79:20" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="cl">80 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 80:1" />Хор вуйлатышылан. Гефысе семӱзгар дене. Асафын псаломжо.<verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />Юмо – мемнан вий-куатна, Тудлан куанен мурыза!</para>
  <para style="q1" vid="PSA 80:2">Иаковын Юмыжлан йывыртен кычкыралза!<verse eid="PSA 80:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Мурыза псаломым, шоктыза тимпаным,</para>
  <para style="q2" vid="PSA 80:3">мотор йӱкан кӱсле ден арфым,<verse eid="PSA 80:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />у тылзе годым пучым пуалтыза,</para>
  <para style="q1" vid="PSA 80:4">пайремна кечын, тичмаш тылзе годым пуалтыза.<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Тыгай Израильлан кӱштымаш,</para>
  <para style="q1" vid="PSA 80:5">Иаковын Юмыжо тыге ышташ шӱден.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Тидым Тудо Иосифлан сугыньлен,</para>
  <para style="q1" vid="PSA 80:6">кунам тудыжо Египет гыч лектын.</para>
  <para style="q1" vid="PSA 80:6">Тушто мый палыдыме йылме дене ойлымым кольым:<verse eid="PSA 80:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />«Тупшо гыч нумалтышым Мый кораҥденам,</para>
  <para style="q1" vid="PSA 80:7">кидыштым комдым нумалме деч утаренам.<verse eid="PSA 80:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Орлык годым тый Мыйым ӱжынат – Мый утаренам,</para>
  <para style="q1" vid="PSA 80:8">кӱдырчан пыл кокла гыч тылат вашештенам,</para>
  <para style="q1" vid="PSA 80:8">Мерива вӱд воктене тыйым тергенам.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Колышт, калыкем, Мыйын шижтарыме мутем!</para>
  <para style="q1" vid="PSA 80:9">Эх, колыштат ыле гын Мыйым, Израиль!<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Тек вес юмо тыйын ок лий,</para>
  <para style="q1" vid="PSA 80:10">йот юмылан вуетым ит саве.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Мый Господь, тыйым Египет гыч лукшо Юмет улам,</para>
  <para style="q1" vid="PSA 80:11">умшатым поч – Мый тыйым теммеш пукшем.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Но калыкем Мыйым колыштын огыл,</para>
  <para style="q1" vid="PSA 80:12">мутем Израиль шуктен огыл.<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Мый нуным вустыкымак коденам –</para>
  <para style="q1" vid="PSA 80:13">тек шке шонымышт почеш илат.<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Эх, колыштеш ыле гын Мыйым калыкем,</para>
  <para style="q1" vid="PSA 80:14">коштеш ыле гын Израиль Мыйын корнем дене!<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />Мый нунын тушманыштым вашке колыштарем ыле,</para>
  <para style="q1" vid="PSA 80:15">шыгыремдылшышт ӱмбак кидем нӧлталам ыле.<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Мыйым ужмышудымо-влак, ӱҥышыла койын,</para>
  <para style="q1" vid="PSA 80:16">Мылам келшаш тӧчат ыле,</para>
  <para style="q1" vid="PSA 80:16">курымеш нуно орланат ыле.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />А шке калыкемлан пукшем ыле эн сай шыдаҥым,</para>
  <para style="q1" vid="PSA 80:17">теммеш пукшем ыле кӱ курыкысо мӱйым».<verse eid="PSA 80:17" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="cl">81 ПСАЛОМ</para>
  <para style="d">Асафын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Юмо шогалын юмо тӱшка коклаште,</para>
  <para style="q1" vid="PSA 81:1">юмо-влак коклаште судым ыштен:<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />«Мыняр жап те эше чын огыл судитледа</para>
  <para style="q1" vid="PSA 81:2">да осал-влак велне лийыда?<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Йорло еҥ ден тулык йочалан чын судым ыштыза,</para>
  <para style="q1" vid="PSA 81:3">пызырналтше ден незерлан чынлыкым ончыктыза.<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Утарыза нужна ден йорлым,</para>
  <para style="q1" vid="PSA 81:4">осал еҥын кидше гыч шупшын налза».<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Но нине юмо-влак огыт пале, огыт умыло –</para>
  <para style="q1" vid="PSA 81:5">коштыт нуно пычкемыште.</para>
  <para style="q1" vid="PSA 81:5">Мландын чыла негызше лӱҥгалтеш.<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />«Мый каласышым: кеч те юмо,</para>
  <para style="q1" vid="PSA 81:6">Чыла деч Кӱшылысын эргыже улыда,<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />но те еҥ-шамыч семын коледа,</para>
  <para style="q1" vid="PSA 81:7">тӧра-влак семын пытеда».<verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Кынел, Юмем, судитле мландым,</para>
  <para style="q1" vid="PSA 81:8">вет чыла калык Тыйын улыт!<verse eid="PSA 81:8" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="cl">82 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 82:1" />Муро. Асафын псаломжо.<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />Юмем, шып ит лий, йӱкдымӧ ит лий,</para>
  <para style="q1" vid="PSA 82:2">нимом ыштыде ит шого, Юмем!<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Теве тушманет-влак пудыраненыт,</para>
  <para style="q1" vid="PSA 82:3">Тыйым ужмышудымо-влак вуйыштым нӧлталыныт.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Тыйын калыкет ваштареш кутырен келшеныт,</para>
  <para style="q1" vid="PSA 82:4">Тылат шерге еҥ-влак ваштареш нуно каҥашат.<verse eid="PSA 82:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />Каласеныт: «Каена да калык кокла гыч нуным пытарена,</para>
  <para style="q1" vid="PSA 82:5">тек Израильын лӱмжӧ йӧршешлан мондымо лиеш».<verse eid="PSA 82:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />Ик ой дене кутырен келшеныт,</para>
  <para style="q1" vid="PSA 82:6">ваштарешет ушемым ыштеныт:<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Едом калык да Измаил тукым,</para>
  <para style="q1" vid="PSA 82:7">Моав ден агарян-влак,<verse eid="PSA 82:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />Гевал, Аммон да Амалик,</para>
  <para style="q1" vid="PSA 82:8">филистим-влак ден Тирыште илыше-шамыч.<verse eid="PSA 82:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 82:9" />Нунын дек эсогыл Ассирий ушнен,</para>
  <para style="q1" vid="PSA 82:9">Лотын эргыже-влаклан полыш кидшым шуен.<verse eid="PSA 82:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 82:10" />Ыште нунын дене тидымак, мом Тый Мадиамлан,</para>
  <para style="q2" vid="PSA 82:10">Киссон эҥер воктене Сисара ден Иавинлан ыштенат.<verse eid="PSA 82:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 82:11" />Пытарыме лийыныт нуно Ен-Дорышто,</para>
  <para style="q1" vid="PSA 82:11">капышт-влак мландыште терыс семын киеныт.<verse eid="PSA 82:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 82:12" />Ыште нунын онышт дене,</para>
  <para style="q2" vid="PSA 82:12">кузе Орив да Зив дене ыштенат,</para>
  <para style="q1" vid="PSA 82:12">нунын чыла вуйлатышышт дене –</para>
  <para style="q2" vid="PSA 82:12">кузе Зевей да Салман дене ыштенат.<verse eid="PSA 82:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 82:13" />Вет нуно ойленыт:</para>
  <para style="q1" vid="PSA 82:13">«Юмын мландыжым поген налына».<verse eid="PSA 82:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 82:14" />Юмем, тек нуно тӱтан дене тарватыме пурак гай,</para>
  <para style="q2" vid="PSA 82:14">кугу мардеж дене нӧлталме арва гай лийыт.<verse eid="PSA 82:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 82:15" />Кузе тул чодырам йӱлалта, курыкым тулйылме когарта,<verse eid="PSA 82:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 82:16" />тугак нуным кугу мардежет дене покто,</para>
  <para style="q1" vid="PSA 82:16">тӱтан мардежет дене чот лӱдыктӧ.<verse eid="PSA 82:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 82:17" />Намыс дене чурийыштым левед,</para>
  <para style="q1" vid="PSA 82:17">тек нуно Тыйын лӱметым ӱжын кумалыт, Господь!<verse eid="PSA 82:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 82:18" />Тек вожылыт да пудыранат курымешлан,</para>
  <para style="q1" vid="PSA 82:18">мыскылтышыш лектыт да колат.<verse eid="PSA 82:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 82:19" />Тыйын лӱмет – Господь.</para>
  <para style="q1" vid="PSA 82:19">Тек нуно палат:</para>
  <para style="q1" vid="PSA 82:19">Тый гына мландымбалне Чыла деч Кӱшылысӧ улат!<verse eid="PSA 82:19" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="cl">83 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 83:1" />Хор вуйлатышылан. Гефысе семӱзгар дене. Корей эрге-влакын псаломышт.<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Кузе мый Тыйын илыме веретым йӧратем, Господь Саваоф!<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Господьын пӧртшын кудывечышкыже каяш шонен,</para>
  <para style="q1" vid="PSA 83:3">мый чон улнен йокрокланем,</para>
  <para style="q1" vid="PSA 83:3">илыше Юмылан куанен мурат мыйын шӱмем ден капем.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Кайыкат шкаланже муын илыме верым,</para>
  <para style="q1" vid="PSA 83:4">вараксимат – пыжашым, кушан кушта шке игыж-влакым,</para>
  <para style="q1" vid="PSA 83:4">Тыйын жертвенникет дене, Господь Саваоф,</para>
  <para style="q1" vid="PSA 83:4">мыйын Кугыжам да мыйын Юмем!<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Пиалан улыт Тыйын пӧртыштет илыше-влак,</para>
  <para style="q1" vid="PSA 83:5">нуно Тыйым чарныде моктат.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />Пиалан айдеме, кӧн вийже Тый дечет,</para>
  <para style="q1" vid="PSA 83:6">кӧн шӱмыштыжӧ – Тыйын курыкышкет кӱзаш шонымаш.<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />Шортмаш лапверым эртымышт годым</para>
  <para style="q2" vid="PSA 83:7">нуно тудым памашан верыш савырат,</para>
  <para style="q1" vid="PSA 83:7">йӱрат тудым шке суапше дене леведеш.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Нуно, эшеат чот вийым налын,</para>
  <para style="q1" vid="PSA 83:8">Юмын ончыко Сионыш толыт.<verse eid="PSA 83:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />Господь Юмо Саваоф, кол мыйын кумалмем,</para>
  <para style="q1" vid="PSA 83:9">Иаковын Юмыжо, колышт мыйым!<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />Юмына, мемнан аралышына!</para>
  <para style="q1" vid="PSA 83:10">Порын ончал шӱрен палемдыметын чурийжым,<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />вет Тыйын кудывечыштет ик кечым эртарымаш</para>
  <para style="q2" vid="PSA 83:11">вес вере тӱжем кече лийме деч сайрак.</para>
  <para style="q1" vid="PSA 83:11">Осалым ыштыше еҥын суртыштыжо илымеш</para>
  <para style="q2" vid="PSA 83:11">лучо мылам Юмын пӧртын омсалондемыштыже шогаш.<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />Вет Господь Юмо – кече да авыртыш,</para>
  <para style="q1" vid="PSA 83:12">Господь шке порылыкшым ончыкта да чапым пуа,</para>
  <para style="q1" vid="PSA 83:12">осал пашам ыштыде илыше еҥ деч суапым Тудо ок кораҥде.<verse eid="PSA 83:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Господь Саваоф, Тыланет ӱшанен илыше еҥ пиалан!<verse eid="PSA 83:13" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="cl">84 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 84:1" />Хор вуйлатышылан. Корей эрге-влакын псаломышт.<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Господь! Тый шке мландет деке поро лийынат,</para>
  <para style="q1" vid="PSA 84:2">Иаков тукымлан эрыкым пӧлекленат;<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />калыкетын титакшым кудалтенат,</para>
  <para style="q1" vid="PSA 84:3">чыла сулыкшым петыренат.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Тый сырыметым чарненат,</para>
  <para style="q1" vid="PSA 84:4">кугу шыдетым йӧртенат.<verse eid="PSA 84:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Мемнан утарыше Юмына,</para>
  <para style="q1" vid="PSA 84:5">мемнам угыч йол ӱмбак шогалте,</para>
  <para style="q1" vid="PSA 84:5">мыланна кугун шыдешкыметым чарне.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Курымеш тӱҥалат мо мыланна сыраш,</para>
  <para style="q1" vid="PSA 84:6">тукым гыч тукымыш шыдетым шуяш?<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Мемнам угыч от иландаре мо?</para>
  <para style="q1" vid="PSA 84:7">Тунам Тыйын калыкет Тылат куана ыле.<verse eid="PSA 84:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Ончыкто, Господь, мыланна шке порылыкетым,</para>
  <para style="q1" vid="PSA 84:8">пӧлекле мыланна шке утарымашетым.<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Господь Юмын мом ойлымыжым колыштам.</para>
  <para style="q1" vid="PSA 84:9">Шке калыкшылан, ӱшанле тарзыж-влаклан Тудо тынысым сӧра,</para>
  <para style="q1" vid="PSA 84:9">шонен моштыдымаш гына нуным угыч ынже авалте.<verse eid="PSA 84:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Чынжымак, Юмо деч лӱдшӧ-влаклан Тудын утарымашыже лишне,</para>
  <para style="q1" vid="PSA 84:10">тунам мландыштына чап илаш тӱҥалеш!<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Порылык ден чынлык вашлийыт,</para>
  <para style="q1" vid="PSA 84:11">чын ыштымаш ден тыныс шупшалалтыт.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />Чынлык кушкын лектеш мланде гыч,</para>
  <para style="q1" vid="PSA 84:12">чын ыштымаш пылпомыш гыч ончалеш.<verse eid="PSA 84:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 84:13" />Господь пӧлекла чыла сайлыкым,</para>
  <para style="q1" vid="PSA 84:13">да мландына шке саскажым пуа.<verse eid="PSA 84:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 84:14" />Чын ыштымаш Господьын ончылныжо кая</para>
  <para style="q1" vid="PSA 84:14">да Тудлан ошкылашыже корным ямдыла.<verse eid="PSA 84:14" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="cl">85 ПСАЛОМ</para>
  <para style="d">Давидын кумалмыже.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />Колышт мыйым, Господь, да мылам вашеште,</para>
  <para style="q1" vid="PSA 85:1">вет мый йорло да мыскынь улам.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Арален кодо мыйын чонем,</para>
  <para style="q1" vid="PSA 85:2">вет Тыйым шотлен илем.</para>
  <para style="q1" vid="PSA 85:2">Юмем, утаре мыйым, Тылат ӱшаныше тарзетым.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Серлаге мыйым, Господь,</para>
  <para style="q1" vid="PSA 85:3">вет кажне кечын Тыйым сӧрвален йодам.<verse eid="PSA 85:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Тый декет, Господь, чонем кондем,</para>
  <para style="q1" vid="PSA 85:4">куандаре шке тарзетын чонжым.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Вет Тый дечет полышым йодын кумалше-влак деке</para>
  <para style="q2" vid="PSA 85:5">Тый, Господь, эре поро улат.</para>
  <para style="q1" vid="PSA 85:5">Тый титакыштым кудалтет да нунылан суапым ыштет.<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Господь, мыйын сӧрвален йодмемым кол,</para>
  <para style="q1" vid="PSA 85:6">мыйын кумалмем Тый колышт.<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Кунам мылам неле, мый Тыйым ӱжам,</para>
  <para style="q1" vid="PSA 85:7">вет Тый вашештет мылам.<verse eid="PSA 85:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Уке юмо-влак коклаште Тыйын гай, Господь,</para>
  <para style="q1" vid="PSA 85:8">уке улыт Тыйын ыштыме гай паша-влак.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Тыйын ыштыме калык-влак толыт чылан,</para>
  <para style="q1" vid="PSA 85:9">Тыйын ончылнет, Господь, вуйыштым сават</para>
  <para style="q1" vid="PSA 85:9">да Тыйын лӱмет чапландарат.<verse eid="PSA 85:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Вет Тый улат кӱдыратле, ӧрыктарыше пашам ыштыше,</para>
  <para style="q1" vid="PSA 85:10">Тый гына Юмо улат.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Господь, шке корнет дене кошташ мыйым туныкто –</para>
  <para style="q1" vid="PSA 85:11">Тыйын чыныштет мый тӱҥалам кошташ,</para>
  <para style="q1" vid="PSA 85:11">пу мылам ӱшанле шӱмым – Тыйын лӱметым шотлен илаш.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Тыйым, Господь Юмем, уло шӱмем дене мокташ тӱҥалам,</para>
  <para style="q1" vid="PSA 85:12">Тыйын лӱметым курымеш чапландарем.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Вет Тыйын порылыкет кугу мый декем,</para>
  <para style="q1" vid="PSA 85:13">вес тӱнян келгытше деч утаренат чонем.<verse eid="PSA 85:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 85:14" />Юмем! Кугешныше-влак шогалыныт ваштарешем,</para>
  <para style="q1" vid="PSA 85:14">чаманыдыме еҥ тӱшка мыйын чонем кычалеш;</para>
  <para style="q1" vid="PSA 85:14">Тыйым нуно шотыш огыт нал.<verse eid="PSA 85:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 85:15" />Но Тый, Господь, улат чаманыше да поро,</para>
  <para style="q1" vid="PSA 85:15">шуко чытыше, суапым ыштыше да ӱшанле Юмо улат.<verse eid="PSA 85:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 85:16" />Ончал ӱмбакем да мыйым серлаге,</para>
  <para style="q1" vid="PSA 85:16">шке тарзетлан вий-куатетым пу,</para>
  <para style="q1" vid="PSA 85:16">шке тарзе ӱдырамашетын эргыжым утаре.<verse eid="PSA 85:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 85:17" />Мый декем поро улметым ончыкто –</para>
  <para style="q1" vid="PSA 85:17">кӧмытын мыйым ужмышт ок шу, тек нуно тидым ужыт да вожылыт,</para>
  <para style="q1" vid="PSA 85:17">вет Тый, Господь, мылам полшенат да мыйым лыпландаренат.<verse eid="PSA 85:17" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="cl">86 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 86:1" />Корей эрге-влакын псаломышт. Муро.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Святой курык ӱмбалне Господь шке олажлан негызым пыштен.</para>
  <para style="q1" vid="PSA 86:2">Сионым Тудо Иаковын моло илемже деч чотрак йӧрата.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />Юмын олаже, тыйын нергенет чапмут йоҥгалтеш!<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Раав<note caller="*" style="f"><char style="fr" closed="false">86:4 </char><char style="ft" closed="false">Раав – вес семынже Египет.</char></note> ден Вавилон мыйым палыше-влак коклаште лийыт,</para>
  <para style="q1" vid="PSA 86:4">тыгак филистим-влак, Тир ден Эфиопийыште илыше-влак каласат:</para>
  <para style="q1" vid="PSA 86:4">«Нине еҥ-шамыч тушан шочыныт».<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Сион нерген тыге каласат:</para>
  <para style="q1" vid="PSA 86:5">«Тудат, нине еҥ-влакат тушан шочыныт,</para>
  <para style="q1" vid="PSA 86:5">Чыла деч Кӱшылысӧ Шкежак тиде олам чоткыдемден».<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Господь калык-влакым шотлен возымо годым серен шында:</para>
  <para style="q1" vid="PSA 86:6">«Тиде айдеме тушан шочын».<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Мурышо да куштышо-влак каласат:</para>
  <para style="q1" vid="PSA 86:7">«Мемнан суап памашна тый дечет йоген лектеш».<verse eid="PSA 86:7" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="cl">87 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 87:1" />Муро. Корей эрге-влакын псаломышт. Хор вуйлатышылан. Махалаф сем дене мурашлан. Езрах тукым Еманын шонкалымашыже.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />Господь, мыйым утарыше Юмем!</para>
  <para style="q1" vid="PSA 87:2">Кечывалымат, йӱдымат Тыйым сӧрвален кычкырем.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Мыйын кумалмем Тый декет миен шужо,</para>
  <para style="q1" vid="PSA 87:3">мыйын сӧрвалымем дек пылышетым савыре.<verse eid="PSA 87:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />Чонем мыйын орлык дене темын,</para>
  <para style="q1" vid="PSA 87:4">илышем вес тӱня дек лишемын.<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Шотлат мыйым пел йол дене шӱгарыште шогышо еҥлан,</para>
  <para style="q1" vid="PSA 87:5">ӱнарем йӧршеш кодын огыл,<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />улам колышо еҥ-влак коклаш кудалтыме,</para>
  <para style="q1" vid="PSA 87:6">шӱгарыште кийыше, пуштмо еҥ-шамыч гай –</para>
  <para style="q1" vid="PSA 87:6">кудышт нерген Тый от шарналте,</para>
  <para style="q1" vid="PSA 87:6">кидет ок полшо нунылан тетла.<verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Тый мыйым пундашдыме вынемыш,</para>
  <para style="q1" vid="PSA 87:7">пычкемыш поргемыш пыштенат.<verse eid="PSA 87:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 87:8" />Кугу шыдет мыйын ӱмбалнем нелемын,</para>
  <para style="q1" vid="PSA 87:8">толкынет-влак мыйым чот темдат.<verse eid="PSA 87:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 87:9" />Палымем-влакым мый дечем кораҥденат,</para>
  <para style="q1" vid="PSA 87:9">нунылан мыйым йырныкым ыштенат;</para>
  <para style="q1" vid="PSA 87:9">мый пуйто петырымаште улам да лектын ом керт.<verse eid="PSA 87:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 87:10" />Ойгырымем дене шинчам вудакаҥын.</para>
  <para style="q1" vid="PSA 87:10">Господь, кече мучко Тыйым сӧрвалем,</para>
  <para style="q1" vid="PSA 87:10">Тый декет кидем шуем.<verse eid="PSA 87:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 87:11" />Колышо-влаклан Тый ӧрыктарыше пашам ыштет мо?</para>
  <para style="q1" vid="PSA 87:11">Колышо-шамыч кынелыт да Тыйым мокташ тӱҥалыт мо?<verse eid="PSA 87:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 87:12" />Увертарат мо Тыйын порылыкет нерген шӱгарыште,</para>
  <para style="q1" vid="PSA 87:12">Тыйын ӱшанле улмет нерген – шӱймӧ верыште?<verse eid="PSA 87:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 87:13" />Пален налыт мо ӧрыктарыше пашат-влакым пычкемыште,</para>
  <para style="q1" vid="PSA 87:13">Тыйын чынлыкетым – мондымаш мландыште?<verse eid="PSA 87:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 87:14" />Но мый Тыйым, Господь, ӱжын сӧрвалем,</para>
  <para style="q1" vid="PSA 87:14">эр эрденак кумалмем ончыкет кондем.<verse eid="PSA 87:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 87:15" />Молан, Господь, мыйым Шке дечет поктет,</para>
  <para style="q1" vid="PSA 87:15">шке чуриетым мый дечем шылтет?<verse eid="PSA 87:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 87:16" />Самырык годсек мый орланем да колымаш дек чак улам,</para>
  <para style="q1" vid="PSA 87:16">колтымо шучкылыкет деч ӱшанем йомеш.<verse eid="PSA 87:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 87:17" />Тыйын шыдет ӱмбачем эртен каен,</para>
  <para style="q1" vid="PSA 87:17">лӱдыктымет мыйым темдалын.<verse eid="PSA 87:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 87:18" />Кажне кечын нуно вӱд семын авырат,</para>
  <para style="q1" vid="PSA 87:18">мыйым йырым-йыр темдат.<verse eid="PSA 87:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 87:19" />Мый дечем кораҥденат Тый таҥем ден йолташем,</para>
  <para style="q1" vid="PSA 87:19">лач пычкемыш мыйым ужатен кая.<verse eid="PSA 87:19" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="cl">88 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 88:1" />Езрах тукым Ефамын туныктымашыже.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Тыйын порылыкет нерген, Господь,</para>
  <para style="q2" vid="PSA 88:2">тӱҥалам эре мураш,</para>
  <para style="q1" vid="PSA 88:2">Тыйын ӱшанле улмет нерген</para>
  <para style="q2" vid="PSA 88:2">тукым гыч тукымыш ойлаш.<verse eid="PSA 88:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Каласышым мый:</para>
  <para style="q1" vid="PSA 88:3">порылыкет Тыйын курымашле,</para>
  <para style="q1" vid="PSA 88:3">ӱшанле улметым Тый пылпомышто пеҥгыдемденат.</para>
  <para style="q1" vid="PSA 88:3">Каласенат Тый:<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />«Ойырен налме еҥем дене ыштенам ойпидышым,</para>
  <para style="q1" vid="PSA 88:4">шке Давид тарземлан товатмутым пуэнам:<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />тыйын урлыкетым курымешлан пеҥгыдемдем,</para>
  <para style="q1" vid="PSA 88:5">престолым тылат тукым гыч тукымыш пуэм».<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Ӧрыктарыше пашат-влакым, Господь, пылпомыш чапла,</para>
  <para style="q1" vid="PSA 88:6">святой Суксо-шамыч Тыйын ӱшанле улметым моктат.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Пылпомышто кӧ уло Господь гай?</para>
  <para style="q1" vid="PSA 88:7">Юмын эрге-влак коклаште кӧ уло Господь гай?<verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Лӱдмашым Юмо луктеш святой Суксо-влакын погынымаштышт,</para>
  <para style="q1" vid="PSA 88:8">Тудын деч лӱдыт йырже улшо-влак чылан.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />Господь Саваоф, кӧ уло весе Тый гает?</para>
  <para style="q1" vid="PSA 88:9">Тый куатан улат, Господь,</para>
  <para style="q1" vid="PSA 88:9">ӱшанле улмет Тыйым авырен шога.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Лӱшкышӧ теҥызлан Тый Оза улат,</para>
  <para style="q1" vid="PSA 88:10">нӧлталтше толкынжо-влакым Тый лыпландарет.<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Сеҥенат Тый Раавым,<note caller="*" style="f"><char style="fr" closed="false">88:11 </char><char style="ft" closed="false">Раав – мифысе теҥыз янлык, тудо осал вийым да пытымашым ончыкта.</char></note> тудым пуштынат,</para>
  <para style="q1" vid="PSA 88:11">тушман-влакетым виян кидет дене шалатенат.<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Тыйын улыт кава ден мланде,</para>
  <para style="q1" vid="PSA 88:12">вет уло сандалыкым да мо тушто уло – Тый ыштенат.<verse eid="PSA 88:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Тый ыштенат йӱдвел ден кечывалвелым,</para>
  <para style="q1" vid="PSA 88:13">Тыйын лӱметлан Фавор ден Ермон куанат.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Виян Тыйын кидет, чоткыдо тудо!</para>
  <para style="q1" vid="PSA 88:14">Пурла кидет кӱшкӧ нӧлталме!<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Чын ыштымаш ден чын суд престолетын негызше улыт,</para>
  <para style="q1" vid="PSA 88:15">порылыкет да ӱшанле улмет Тыйын ончылнет каят.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Пиалан улеш пуч йӱкым палыше калык!</para>
  <para style="q1" vid="PSA 88:16">Чуриетын волгыдыштыжо, Господь, нуно коштыт.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Тыйын лӱметлан куанат кажне кечын,</para>
  <para style="q1" vid="PSA 88:17">Тыйын чынлыкет нуным кӱшкӧ нӧлталеш.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Вет Тый нунын вий ден чапышт улат,</para>
  <para style="q1" vid="PSA 88:18">Тыйын поро кумылет дене мемнан тӱкына нӧлталтеш.<verse eid="PSA 88:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 88:19" />Мемнан авыртышна – Господь деч,</para>
  <para style="q1" vid="PSA 88:19">Израильын Святойжо деч – мемнан кугыжана.<verse eid="PSA 88:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 88:20" />Ала-кунам кончымаш гоч Тый ӱшанле еҥет-влаклан каласенат:</para>
  <para style="q1" vid="PSA 88:20">«Патыр сарзылан пуэнам Мый полышым,</para>
  <para style="q1" vid="PSA 88:20">калык кокла гыч ойырен налме еҥем кӱш нӧлталынам.<verse eid="PSA 88:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 88:21" />Муынам Мый Давидым, шке тарземым,</para>
  <para style="q1" vid="PSA 88:21">тудым шке святой елеем дене шӱренам.<verse eid="PSA 88:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 88:22" />Мыйын кидем тудын пелен лиеш,</para>
  <para style="q1" vid="PSA 88:22">Мыйын куатем тудым пеҥгыдемда.<verse eid="PSA 88:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 88:23" />Тушман огеш керт тудым сеҥен,</para>
  <para style="q1" vid="PSA 88:23">осалым ыштыше ок шыгыремде.<verse eid="PSA 88:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 88:24" />Тудын ончылно тушманже-влакым темдалам,</para>
  <para style="q1" vid="PSA 88:24">тудым ужмышудымо-шамычым пытарем.<verse eid="PSA 88:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 88:25" />Мыйын порылыкем да ӱшанле улмем лийыт пеленже,</para>
  <para style="q1" vid="PSA 88:25">Мыйын лӱмем дене тудын тӱкыжӧ нӧлталтеш.<verse eid="PSA 88:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 88:26" />Тудын кидшым Мый теҥыз ӱмбаке,</para>
  <para style="q1" vid="PSA 88:26">тудын пурла кидшым эҥер-влак ӱмбаке пыштем.<verse eid="PSA 88:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 88:27" />Мыйым тудо тыге лӱмдаш тӱҥалеш:</para>
  <para style="q1" vid="PSA 88:27">”Тый мыйын Ачаем, мыйын Юмем, утарыше кӱ курыкем улат”.<verse eid="PSA 88:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 88:28" />Тудым Мый кугэргым ыштем,</para>
  <para style="q1" vid="PSA 88:28">мландымбалысе кугыжа-влак коклаште тудо эн кугу лиеш.<verse eid="PSA 88:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 88:29" />Порылыкем тудын дене курымешлан лиеш,</para>
  <para style="q1" vid="PSA 88:29">тудын дене ыштыме ойпидышем пеҥгыде.<verse eid="PSA 88:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 88:30" />Тудын тукымжым Мый курым-курымеш шуем,</para>
  <para style="q1" vid="PSA 88:30">мыняр жап кава лиеш, тынар жап престолжо шогаш тӱҥалеш.<verse eid="PSA 88:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 88:31" />Но эргыж-влак Мыйын законем кодат</para>
  <para style="q2" vid="PSA 88:31">да туныктымем семын ышташ огыт тӱҥал гын –<verse eid="PSA 88:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 88:32" />кӱштымашем пудыртат,</para>
  <para style="q1" vid="PSA 88:32">сугынем огыт шукто –<verse eid="PSA 88:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 88:33" />тунам титакыштлан нуным тоя дене,</para>
  <para style="q2" vid="PSA 88:33">сулыкыштлан лупш дене кырем.<verse eid="PSA 88:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 88:34" />Туге гынат, нунын деч порылыкем ом нал,</para>
  <para style="q1" vid="PSA 88:34">ӱшанле улмем деч ом кораҥ.<verse eid="PSA 88:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 88:35" />Мый шке ойпидышем ом пудырто,</para>
  <para style="q1" vid="PSA 88:35">умшам гыч лекше шомакем ом вашталте.<verse eid="PSA 88:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 88:36" />Икана товатленам шке святой лӱмем дене,</para>
  <para style="q1" vid="PSA 88:36">Давидлан Мый ом шойышт:<verse eid="PSA 88:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 88:37" />курымеш лиеш тудын тукымжо,</para>
  <para style="q1" vid="PSA 88:37">престолжо ончылнем кече семын эре лиеш,<verse eid="PSA 88:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 88:38" />тылзе семын курымешлан тудо пеҥгыде кодеш.</para>
  <para style="q1" vid="PSA 88:38">Ӱшанле таныклыше – каваште».<verse eid="PSA 88:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 88:39" />Но кызыт Тый шыдешкенат шӱрен палемдыме еҥетлан,</para>
  <para style="q1" vid="PSA 88:39">кораҥынат тудын деч, тудым шӱкалынат.<verse eid="PSA 88:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 88:40" />Кӱрлынат шке тарзет дене ыштыме ойпидышым,</para>
  <para style="q1" vid="PSA 88:40">кугыжан вуйшӱдышыжым мландыш кудалтенат.<verse eid="PSA 88:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 88:41" />Шалатенат олажын чыла пырдыжшым,</para>
  <para style="q1" vid="PSA 88:41">карманже-влакым сӱмырен шуэнат.<verse eid="PSA 88:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 88:42" />Воктеч эртен кайыше-шамыч тудым агат,</para>
  <para style="q1" vid="PSA 88:42">пошкудыж-влаклан тудо воштылчык лийын.<verse eid="PSA 88:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 88:43" />Тушманже-шамычлан Тый сеҥаш полшенат,</para>
  <para style="q1" vid="PSA 88:43">ваштарешыже шогышо-влакым куандаренат.<verse eid="PSA 88:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 88:44" />А тудын пӱсӧ кердыжым мӧҥгеш савыренат,</para>
  <para style="q1" vid="PSA 88:44">кредалме годым тудым пеҥгыдемден отыл,<verse eid="PSA 88:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 88:45" />йолгышо чапым тудын деч налынат,</para>
  <para style="q1" vid="PSA 88:45">престолжым мландымбак сӱмырен шуэнат.<verse eid="PSA 88:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 88:46" />Кӱчыкемденат тудын рвезе жапшым,</para>
  <para style="q1" vid="PSA 88:46">намыс дене тудым леведынат.<verse eid="PSA 88:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 88:47" />Господь, мыняр жап эше Тый шылаш тӱҥалат?</para>
  <para style="q1" vid="PSA 88:47">Мыняр жап йӱла тул семын шыдет?<verse eid="PSA 88:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 88:48" />Шарналте, могай кӱчык мыйын илышем,</para>
  <para style="q1" vid="PSA 88:48">могай кӱлдымӧ илышлан айдеме эрге-влакым ыштенат!<verse eid="PSA 88:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 88:49" />Кӧ ила да ок уж колымашым?</para>
  <para style="q1" vid="PSA 88:49">Кӧ вес тӱня деч чонжым утара?<verse eid="PSA 88:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 88:50" />Кушто Тыйын ончычсо порылыкет, Господь?</para>
  <para style="q1" vid="PSA 88:50">Ӱшанле улмет дене тудым Тый Давидлан товатленат.<verse eid="PSA 88:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 88:51" />Ончал, Господь, кузе тарзет-влакым шӱктарат,</para>
  <para style="q1" vid="PSA 88:51">калык-шамычын воштылмыштым мый шӱмыштем нумалам.<verse eid="PSA 88:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 88:52" />Тыйын тушманет-влак шудалыт, Господь,</para>
  <para style="q1" vid="PSA 88:52">шӱрен палемдыметын кажне ошкылжым мыскылат!<verse eid="PSA 88:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 88:53" />Моктымо лийже Господь курым-курымеш!</para>
  <para style="q1" vid="PSA 88:53">Аминь, аминь.<verse eid="PSA 88:53" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="cl">89 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 89:1" />Моисейын, Юмын еҥжын, кумалмыже.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Господь! Тукым гыч тукымыш</para>
  <para style="q2" vid="PSA 89:2">Тый мемнан аралтышна улат.<verse eid="PSA 89:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Курык-влакын шочмышт деч ончычак,</para>
  <para style="q2" vid="PSA 89:3">мланде ден сандалыкым ыштымет деч ончычак</para>
  <para style="q1" vid="PSA 89:3">Тый курым гыч курымыш Юмо улат.<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />Тый айдеме-влакым мланде пуракыш пӧртылтет,</para>
  <para style="q1" vid="PSA 89:4">«Пӧртылза, айдеме эрге-шамыч!» – ойлет.<verse eid="PSA 89:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />Вет Тыйын шинча ончылнет тӱжем ий</para>
  <para style="q2" vid="PSA 89:5">теҥгече эртыше кече гай, йӱдын ик орол черетше гай.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Вӱдташлем наҥгайыме семын Тый нуным наҥгает,</para>
  <para style="q1" vid="PSA 89:6">омо семын нуно каят эртен.</para>
  <para style="q1" vid="PSA 89:6">Нуно шудо гай улыт –</para>
  <para style="q1" vid="PSA 89:6">тудыжо эрден кушкеш, эрденак пелед шогалеш,</para>
  <para style="q1" vid="PSA 89:6">а кастене лывыжга да кошка.<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Вет Тыйын сырыметлан кӧра ме пытена,</para>
  <para style="q1" vid="PSA 89:7">Тыйын шыдет мемнам кугу лӱдмашыш пурта.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Тый мемнан сулыкнам пыштенат Шке ончыкет,</para>
  <para style="q1" vid="PSA 89:8">шолып ыштыме языкна – Тыйын чурий ончылнет.<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Тыйын шыдетлан кӧра илыме кечына-влак кӱчыкемыт,</para>
  <para style="q1" vid="PSA 89:9">мемнан ийна-влак шӱлалтыш семын йомыт.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Мемнан ӱмырна шымле ий шуйна,</para>
  <para style="q1" vid="PSA 89:10">ӱнар уло гын – кандашле,</para>
  <para style="q1" vid="PSA 89:10">эн сай пагытна-влакат паша ден орлыкышто эртат,</para>
  <para style="q1" vid="PSA 89:10">писын ий-влак йортат, да ме йомына.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Кӧ пала Тыйын сырыметын вийжым?</para>
  <para style="q1" vid="PSA 89:11">Кӧ Тыйын шыдет деч ок лӱд?<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Илышаш кече чотым шотлаш туныкто мемнам,</para>
  <para style="q1" vid="PSA 89:12">тунам ме мунло шӱм-чонан лийына.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Мемнан дек савырне, Господь!</para>
  <para style="q1" vid="PSA 89:13">Мыняр жап тиде шуйнаш тӱҥалеш?</para>
  <para style="q1" vid="PSA 89:13">Шке тарзет-влакым чамане.<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Порылыкетын перкелыкше дене мемнам эрденак теме,</para>
  <para style="q1" vid="PSA 89:14">да кажне илыме кечын ме куанен йывыртена.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Мыняр кече Тый мемнам шӱлыкаҥденат,</para>
  <para style="q1" vid="PSA 89:15">мыняр ий ме эҥгекым ужынна –</para>
  <para style="q1" vid="PSA 89:15">тунарак мыланна пу куанен илаш.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Ончыкто кӱдыратле пашатым шке тарзет-влаклан,</para>
  <para style="q2" vid="PSA 89:16">чапетым – нунын эргышт-влаклан.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Господь, мемнан Юмына, лий мемнан дек поро,</para>
  <para style="q1" vid="PSA 89:17">пашанам ворандарен шого,</para>
  <para style="q1" vid="PSA 89:17">ворандарен шого мемнан пашанам!<verse eid="PSA 89:17" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="cl">90 ПСАЛОМ</para>
  <para style="d">[Давидын моктеммурыжо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Чыла деч Кӱшылысын леведыш йымалныже илыше,</para>
  <para style="q2" vid="PSA 90:1">Чылакертшын ӱмылыштыжӧ шинчыше еҥ<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Господьлан ойла:</para>
  <para style="q1" vid="PSA 90:2">«Юмем, улат Тый шылын куржмо верем,</para>
  <para style="q1" vid="PSA 90:2">мыйын аралтышем, Тылат мый ӱшанем!»<verse eid="PSA 90:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Кучаш тӧчышын вапшыж деч да шучко чер деч</para>
  <para style="q2" vid="PSA 90:3">Тудо тыйым утара.<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Шке пыстылже-влак дене тыйым леведеш,</para>
  <para style="q1" vid="PSA 90:4">Тудын шулдыржо – тылат аралтыш,</para>
  <para style="q1" vid="PSA 90:4">Тудын ӱшанле улмыжо – пырдыж ден авыртыш.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />От лӱд йӱдым шучкылык деч,</para>
  <para style="q1" vid="PSA 90:5">кечывалым чоҥештыше пикш деч,<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />пычкемыште коштшо аярмужо<note caller="*" style="f"><char style="fr" closed="false">90:6 </char><char style="ft" closed="false">Аярмужо – мор.</char></note> деч,</para>
  <para style="q1" vid="PSA 90:6">кечывалым пуштедыше шучко чер деч.<verse eid="PSA 90:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Тӱжем еҥ йӧрлеш тыйын воктенет,</para>
  <para style="q1" vid="PSA 90:7">лу тӱжем – пурла могырыштет,</para>
  <para style="q1" vid="PSA 90:7">но чыла нине азап тыйым огыт логал.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Осал еҥ-влаклан пӧртылтымӧ лиеш,</para>
  <para style="q1" vid="PSA 90:8">тый тидым шке шинчат дене ужат.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Вет тый каласенат: «Господь – шылын куржмо верем»,</para>
  <para style="q1" vid="PSA 90:9">Чыла деч Кӱшылысым тый шке аралтышетым ыштенат.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Нимогай осал тый денет огеш лий,</para>
  <para style="q1" vid="PSA 90:10">илыме верышкет ойго-орлык ок лишем.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Вет Тудо Суксыж-влаклан тыйын шотышто кӱшта –</para>
  <para style="q1" vid="PSA 90:11">тыйым чыла корныштет аралаш.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Йолет дене кӱэш ит шӱртньӧ манын,</para>
  <para style="q1" vid="PSA 90:12">нуно тыйым кидешышт нумал наҥгаят.<verse eid="PSA 90:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Тошкалат кишкым, чӱҥгалше аяр кишкым,</para>
  <para style="q1" vid="PSA 90:13">лев ден драконым тый тошкет.<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />«Мыйым йӧратымыжлан тудым утарем,</para>
  <para style="q1" vid="PSA 90:14">Мыйын лӱмем палымыжлан тудым аралем.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Мыйым ӱжын кычкыра – тудым колам,</para>
  <para style="q1" vid="PSA 90:15">ойгыж годым пеленже лиям,</para>
  <para style="q1" vid="PSA 90:15">тудым утарем да чапым пуэм.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Тудлан Мый шуко илышаш кечым пуэм,</para>
  <para style="q1" vid="PSA 90:16">шке утарымашем тудлан ончыктем».<verse eid="PSA 90:16" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="cl">91 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 91:1" />Псалом. Шуматкечын мурымо муро.<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />Могай сай – Господьым мокташ,</para>
  <para style="q2" vid="PSA 91:2">Чыла деч Кӱшылысын лӱмжым моктен мураш!<verse eid="PSA 91:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Порылыкет нерген эрдене,</para>
  <para style="q2" vid="PSA 91:3">ӱшанле улмет нерген кастене каласкалаш,<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />лу кылан кӱсле дене, арфе да лира дене шоктен мураш!<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Куандаренат, Господь, мыйым шке пашат дене,</para>
  <para style="q1" vid="PSA 91:5">кидетын мом ыштымыжым ончен, мый йывыртем.<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />Господь, могай кугу улыт Тыйын пашат-влак,</para>
  <para style="q1" vid="PSA 91:6">шонымашет-влак пеш келге улыт!<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Ок пале тидым ушдымо айдеме,</para>
  <para style="q1" vid="PSA 91:7">шонен моштыдымо ок умыло.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Кеч йӧрдымӧ еҥ-влак шудо семын кушкыт</para>
  <para style="q1" vid="PSA 91:8">да осалым ыштыше-шамыч пеледалтыт,</para>
  <para style="q1" vid="PSA 91:8">нуно садак курымешлан йомыт.<verse eid="PSA 91:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />А Тый, Господь, курымеш чыла деч кӱшнӧ улат!<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />Вет тушманет-влак, Господь, Тыйын тушманет-влак пытат,</para>
  <para style="q1" vid="PSA 91:10">осалым ыштыше-шамыч чылан шалатыме лийыт.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />А мыйын тӱкем Тый ир ӱшкыжын тӱкыж гай нӧлталат,</para>
  <para style="q1" vid="PSA 91:11">свежа ӱй дене мыйым шӱрет.<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />Тушманем-влак ӱмбаке шинчам куанен онча,</para>
  <para style="q1" vid="PSA 91:12">ваштарешем шогалше осал еҥ-влакын варгыжмыштым пылышем колеш.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Чын ыштыше-влак пальме семын пеледалтыт,</para>
  <para style="q1" vid="PSA 91:13">ливанысе кедр семын нӧлталтыт.<verse eid="PSA 91:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />Нуно Господьын пӧртыштыжӧ шындыме улыт,</para>
  <para style="q1" vid="PSA 91:14">Юмынан кудывечылаштыже пеледалтыт.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Шоҥгеммекат нуно саскам пуышо, лӧза да нӧргӧ лийыт,<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Господьын чынлыкше нерген увертарат.</para>
  <para style="q1" vid="PSA 91:16">Тудо – мыйын кӱ курыкем,</para>
  <para style="q1" vid="PSA 91:16">Тудын нимогай чындымылыкше уке.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="cl">92 ПСАЛОМ</para>
  <para style="d">[Давидын моктеммурыжо. Айдеме тукымын ош тӱняште илаш тӱҥалмыж нерген шарныктарыше муро, тудым шуматкече деч ончыч муреныт.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Господь кугыжалана!</para>
  <para style="q1" vid="PSA 92:1">Тудо кӱдыратлык дене вӱдылалтын,</para>
  <para style="q1" vid="PSA 92:1">Господь куат дене вӱдылалтын,</para>
  <para style="q1" vid="PSA 92:1">тудым кыдалешыже ӱшталын.</para>
  <para style="q1" vid="PSA 92:1">Пеҥгыдын шога тӱня, тудо ок чытырне.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />Акрет годсек престолет пеҥгыдын шога,</para>
  <para style="q1" vid="PSA 92:2">Тый курым годсек улат.<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />Лӱшкат йогын-влак, Господь,</para>
  <para style="q1" vid="PSA 92:3">вӱдйогын-шамыч йӱкыштым кугемдат,</para>
  <para style="q1" vid="PSA 92:3">эҥер-влак толкыныштым нӧлтат.<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Но кава кӱкшытыштӧ илыше Господь</para>
  <para style="q2" vid="PSA 92:4">кугу вӱдын лӱшкымыж деч виянрак,</para>
  <para style="q2" vid="PSA 92:4">теҥызысе виян толкын деч куатанрак.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Сугынет-влак, Господь, чот ӱшанле улыт,</para>
  <para style="q1" vid="PSA 92:5">Тыйын пӧртет курымеш святой.<verse eid="PSA 92:5" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="cl">93 ПСАЛОМ</para>
  <para style="d">[Давидын псаломжо. Арнян нылымше кечынже муреныт.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />О, ӱчым шуктышо Юмо, Господь,</para>
  <para style="q1" vid="PSA 93:1">ӱчым шуктышо Юмо, волгалтын лишем!<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Кынел, тӱнян Судьяже,</para>
  <para style="q1" vid="PSA 93:2">кугешныше-влаклан пашашт почеш пӧртылтӧ.<verse eid="PSA 93:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />Господь, мыняр жап эше,</para>
  <para style="q1" vid="PSA 93:3">мыняр жап эше осал еҥ-влак тӱҥалыт куанаш?<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Тӱргалт лектеш умшашт гыч намысдыме шомак,</para>
  <para style="q1" vid="PSA 93:4">осалым ыштыше-влак шкеныштым кӱшкӧ шындат.<verse eid="PSA 93:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Шыгыремдат Тыйын калыкетым, Господь,</para>
  <para style="q1" vid="PSA 93:5">Тыйын еҥет-влакым нуно пызырат.<verse eid="PSA 93:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 93:6" />Пуштедат йот калык еҥ ден тулык ватым,</para>
  <para style="q1" vid="PSA 93:6">тулык йоча-влакым пытарат.<verse eid="PSA 93:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 93:7" />Ойлат: «Господь ок уж, Иаковын Юмыжо пален ок нал».<verse eid="PSA 93:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 93:8" />Ушым шындыза, шонен моштыдымо-влак!</para>
  <para style="q1" vid="PSA 93:8">Кузе те ода умыло, ушдымо-шамыч?<verse eid="PSA 93:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 93:9" />Пылышым пуышо ок кол мо,</para>
  <para style="q1" vid="PSA 93:9">шинчам ыштыше ок уж мо?<verse eid="PSA 93:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 93:10" />Калык-влаклан ушым Пуртышо, айдемылан шинчымашым Пуышо</para>
  <para style="q2" vid="PSA 93:10">мут кучаш ок шогалте мо?<verse eid="PSA 93:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 93:11" />Господь пала айдемын шонымашыжым –</para>
  <para style="q1" vid="PSA 93:11">улыт нуно кӱлдымӧ, арам.<verse eid="PSA 93:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 93:12" />Пиалан тудо еҥ, кӧлан Тый, Господь, ушым пуртет,</para>
  <para style="q1" vid="PSA 93:12">кӧм шке законетлан туныктет.<verse eid="PSA 93:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 93:13" />Тудлан Тый, осал еҥлан вынем кӱнчымӧ лиймешке,</para>
  <para style="q1" vid="PSA 93:13">неле жап годымат ласкалыкым пуэт.<verse eid="PSA 93:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 93:14" />Ок шӱкал Господь шке калыкшым,</para>
  <para style="q1" vid="PSA 93:14">шке еҥже-влакым Тудо ок кодо.<verse eid="PSA 93:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 93:15" />Судитлыме паша угыч чынле лиеш,</para>
  <para style="q1" vid="PSA 93:15">яндар шӱм-чонан-влак тидым сайлан шотлат.<verse eid="PSA 93:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 93:16" />Кӧ мылам верчын осал еҥ-влак ваштареш шогалеш?</para>
  <para style="q1" vid="PSA 93:16">Кӧ мыйым вуянче-шамыч деч арален налеш?<verse eid="PSA 93:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 93:17" />Ок полшо ыле гын мылам Господь,</para>
  <para style="q1" vid="PSA 93:17">шӱгарысе тып-тымыкыш шукертак каенам ыле.<verse eid="PSA 93:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 93:18" />Кунам мый ойленам: «Йолем яклештеш», –</para>
  <para style="q1" vid="PSA 93:18">порылыкет, Господь, мыланем полшен шоген.<verse eid="PSA 93:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 93:19" />Шӱмем чот тургыжланыме годым</para>
  <para style="q2" vid="PSA 93:19">чонемлан куаным Тыйын лыпландарымашет конда.<verse eid="PSA 93:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 93:20" />Законым чоян кучылтын, осалым ыштыше судья-влак</para>
  <para style="q2" vid="PSA 93:20">Тый денет ик ушемыште лийын кертыт мо?<verse eid="PSA 93:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 93:21" />Чын ыштыше ӱмбак нуно тӱшка дене керылтыт,</para>
  <para style="q1" vid="PSA 93:21">титакдыме еҥым пушташ пунчалыт.<verse eid="PSA 93:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 93:22" />А мыйын аралтышем – Господь,</para>
  <para style="q1" vid="PSA 93:22">Юмо – кӱ курыкем, шылын утлымо верем.<verse eid="PSA 93:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 93:23" />Осал пашаштым Юмо ӱмбакыштак савыра,</para>
  <para style="q1" vid="PSA 93:23">осалышт денак Тудо нуным пытара,</para>
  <para style="q1" vid="PSA 93:23">Господь Юмына нуным пытара.<verse eid="PSA 93:23" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="cl">94 ПСАЛОМ</para>
  <para style="d">[Давидын моктеммурыжо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />Толза, Господьлан куанен мурена,</para>
  <para style="q1" vid="PSA 94:1">[Юмылан,] утарыше кӱ курыкланна, йывыртен кычкыралына!<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Юмылан тауштен, миена Тудын ончыко,</para>
  <para style="q1" vid="PSA 94:2">йывыртен мурена ме Тудлан.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />Вет Господь улеш кугу Юмо,</para>
  <para style="q1" vid="PSA 94:3">чыла юмо-влаклан кугу Кугыжа.<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Тудын кидыштыже – мландын келгытше-влак,</para>
  <para style="q1" vid="PSA 94:4">курык вуй-шамычат Тудын улыт.<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Теҥыз – Тудын, Господь тудым ыштен,</para>
  <para style="q1" vid="PSA 94:5">кукшо мландымат Тудын кидше шочыктен.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Толза, вуйнам савен, кумык возына,</para>
  <para style="q1" vid="PSA 94:6">мемнам ыштыше Господь ончылно сукен шинчына.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Тудо – мемнан Юмына,</para>
  <para style="q1" vid="PSA 94:7">а ме Тудын кӱтымӧ калыкше,</para>
  <para style="q2" vid="PSA 94:7">кидыштыже улшо шорыкшо улына.</para>
  <para style="q1" vid="PSA 94:7">Эх, колыда ыле гын таче кечын Тудын йӱкшым:<verse eid="PSA 94:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />«Ида пешкыдемде шӱмдам Мерива воктенысе семын,</para>
  <para style="q2" vid="PSA 94:8">ир мландыште тергыме кечысе семын.<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Тушто Мыйым ачада-влак тергеныт</para>
  <para style="q1" vid="PSA 94:9">да ужыныт Мыйын пашам.<note caller="*" style="f"><char style="fr" closed="false">94:9 </char><char style="ft" closed="false">Ончо: Лекм 17:1-7.</char></note><verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Нылле ий тиде тукым Мыйым витарен,</para>
  <para style="q1" vid="PSA 94:10">да Мый каласенам: тиде калык шӱмжӧ дене йомын коштеш,</para>
  <para style="q1" vid="PSA 94:10">пален налын огытыл нуно Мыйын корнем.<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />Сандене шыдем дене товатленам:</para>
  <para style="q1" vid="PSA 94:11">Мыйын ласкалык верышкем нуно огыт пуро».<verse eid="PSA 94:11" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="cl">95 ПСАЛОМ</para>
  <para style="d">[Давидын моктеммурыжо. Плен гыч пӧртылмеке, Юмын пӧртым чоҥымо годым.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />У мурым мурыза Господьлан,</para>
  <para style="q1" vid="PSA 95:1">пӱтынь мланде, Господьлан муро!<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Мурыза Господьлан, Тудын лӱмжым чаплыза,</para>
  <para style="q1" vid="PSA 95:2">Тудын утарымыж нерген кажне кечын ойлыза!<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Калык-влак коклаште Тудын чапшым,</para>
  <para style="q2" vid="PSA 95:3">чыла тукым коклаште ӧрыктарыше пашаж-влакым увертарыза!<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Вет Господь кӱдыратле, моктымашым сулышо.</para>
  <para style="q1" vid="PSA 95:4">Тудо кугу лӱдмашым луктеш, чыла юмо деч кӱшнӧ улеш!<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Вет моло калыкын юмышт улыт полган,</para>
  <para style="q1" vid="PSA 95:5">а Господь кавам ыштен.<verse eid="PSA 95:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Тудын пеленже – чап ден кугулык,</para>
  <para style="q1" vid="PSA 95:6">святой верыштыже – сылнылык, куат.<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />Тӱнясе чыла калык, чапым пуыза Господьлан,</para>
  <para style="q1" vid="PSA 95:7">моктыза Тудым чап ден вий-куатшылан!<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />Господьын лӱмжым чапландарыза,</para>
  <para style="q1" vid="PSA 95:8">Тудын кудывечышкыже пӧлек дене мийыза,<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />святой сӧраллык дене Господьлан вуйдам савыза.</para>
  <para style="q1" vid="PSA 95:9">Пӱтынь мланде, Тудын ончылныжо чытыре!<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Калык-влаклан каласыза: «Господь кугыжалана!»</para>
  <para style="q1" vid="PSA 95:10">Тӱня пеҥгыдын шога, ок чытырне.</para>
  <para style="q1" vid="PSA 95:10">Чынлык дене Господь тӱням судитлаш тӱҥалеш.<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />Тек йывырта кава да мланде куана,</para>
  <para style="q1" vid="PSA 95:11">теҥыз да мо тушто уло – тек куанен лӱшкат.<verse eid="PSA 95:11" /></para>
  <para style="q1">
    <verse number="12-13" style="v" sid="PSA 95:12-13" />Тек куана пасу да мо тушто уло,</para>
  <para style="q1" vid="PSA 95:12-13">тек чодырасе пушеҥге-влак Господь ончылно йывыртен гӱжлат.</para>
  <para style="q1" vid="PSA 95:12-13">Вет толеш, вет Тудо толеш мландым судитлаш.</para>
  <para style="q1" vid="PSA 95:12-13">Тудо тӱнялан чын судым ышта,</para>
  <para style="q1" vid="PSA 95:12-13">калык-влакым шке чынлыкше почеш судитла.<verse eid="PSA 95:12-13" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="cl">96 ПСАЛОМ</para>
  <para style="d">[Давидын псаломжо, кунам вуйлатыме мландыжым шотыш конденыт.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Господь кугыжалана!</para>
  <para style="q1" vid="PSA 96:1">Тек мланде йывырта, отро-влак куанат!<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Тудын йырже пыл ден пычкемыш улыт,</para>
  <para style="q1" vid="PSA 96:2">престолжын негызше – чынлык ден чын ыштымаш.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Тул кая Тудын ончычшо,</para>
  <para style="q1" vid="PSA 96:3">тушманже-влакым йырваш пытара.<verse eid="PSA 96:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Тудын волгенчыже-влак тӱням волгалтарат,</para>
  <para style="q1" vid="PSA 96:4">тидым ужын, мланде чытырна.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Тудын чурийже ончылно, уло мландын Господьшо ончылно,</para>
  <para style="q1" vid="PSA 96:5">курык-влак шыште семын шулат.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Пылпомыш-влак Тудын чынлыкше нерген ойлат,</para>
  <para style="q1" vid="PSA 96:6">чыла калык Тудын чапшым ужеш.<verse eid="PSA 96:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />Тек шке ыштыме юмылан кумалше-шамыч,</para>
  <para style="q1" vid="PSA 96:7">шояк юмо дене моктаныше-влак чылан вожылмашыш пурат.</para>
  <para style="q1" vid="PSA 96:7">Чыла юмо-влак, Тудын ончылно кумык вочса!<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Тидым колын, Сион куана,</para>
  <para style="q1" vid="PSA 96:8">Тыйын судет-влаклан, Господь,</para>
  <para style="q1" vid="PSA 96:8">Иудан ӱдыржӧ-шамыч куанат.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Вет Тый, Господь, пӱтынь мланде деч кӱшнӧ улат,</para>
  <para style="q1" vid="PSA 96:9">чыла юмо деч кӱшнӧ улат!<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Господьым йӧратыше-влак, осал дек ужмышудымо лийза,</para>
  <para style="q1" vid="PSA 96:10">вет шке ӱшанлыже-влакын чоныштым Тудо арала,</para>
  <para style="q1" vid="PSA 96:10">осал еҥ-шамычын кидышт деч нуным утара.<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Волгалтара чын ыштыше еҥым волгыдо,</para>
  <para style="q1" vid="PSA 96:11">яндар шӱм-чонан-влакым – куан.<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Чын ыштыше-влак, Господьлан йывыртыза,</para>
  <para style="q1" vid="PSA 96:12">святой улмыжым шарнен, Тудым моктыза!<verse eid="PSA 96:12" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="cl">97 ПСАЛОМ</para>
  <para style="d">[Давидын] псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />У мурым мурыза Господьлан,</para>
  <para style="q1" vid="PSA 97:1">вет ӧрыктарыше паша-влакым Тудо ыштен.</para>
  <para style="q1" vid="PSA 97:1">Тудын пурла кидше, святой куатше</para>
  <para style="q2" vid="PSA 97:1">конденыт Тудлан сеҥымашым.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Ончыктен Господь шке утарымашыжым,</para>
  <para style="q1" vid="PSA 97:2">шке чынлыкшым калык-влак ончылно почын.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Шарнен Тудо [Иаков деке] поро улмыжым,</para>
  <para style="q1" vid="PSA 97:3">Израиль калык дек ӱшанле улмыжым.</para>
  <para style="q1" vid="PSA 97:3">Мландын чыла тӱржӧ Юмынан утарымашыжым ужын.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Мландымбалне илыше-влак,</para>
  <para style="q1" vid="PSA 97:4">Господьлан куанен кычкыралза,</para>
  <para style="q1" vid="PSA 97:4">йывыртыза да мурыза!<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Мурыза Господьлан кӱсле дене,</para>
  <para style="q1" vid="PSA 97:5">кӱслем шоктен, муро сем почеш моктыза!<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Той пуч ден тӱкӧ пучын йӱкышт почеш</para>
  <para style="q2" vid="PSA 97:6">Господь Кугыжа ончылно куанен кычкырыза.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Тек теҥыз да тушто мо уло,</para>
  <para style="q2" vid="PSA 97:7">тӱня да тушто чыла илыше куанен лӱшкат.<verse eid="PSA 97:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Тек эҥер-влак совыштым кырат,</para>
  <para style="q1" vid="PSA 97:8">курык-шамыч пырля куанен моктат<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Господь чурий ончылно,</para>
  <para style="q1" vid="PSA 97:9">вет Тудо мландым судитлаш толеш.</para>
  <para style="q1" vid="PSA 97:9">Уло тӱням тӱҥалеш судитлаш чын дене,</para>
  <para style="q1" vid="PSA 97:9">калык-влакым – чынлык дене.<verse eid="PSA 97:9" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="cl">98 ПСАЛОМ</para>
  <para style="d">[Давидын псаломжо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Господь кугыжалана, тек калык-влак чытырат!</para>
  <para style="q1" vid="PSA 98:1">Тудо херувим-влак ӱмбалне шинча,</para>
  <para style="q1" vid="PSA 98:1">тек мланде чытырна!<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />Господь Сионышто кӱдыратле,</para>
  <para style="q1" vid="PSA 98:2">чыла калык деч Тудо кӱшнӧ.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Тек нуно Тыйын лӱметым моктат –</para>
  <para style="q1" vid="PSA 98:3">тудо кӱдыратле, лӱдмашым лукшо да святой!<verse eid="PSA 98:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Кугыжа вий-куатан, йӧрата чын судым.</para>
  <para style="q1" vid="PSA 98:4">Тый чын ыштымашым пеҥгыдемденат,</para>
  <para style="q1" vid="PSA 98:4">Иаков тукымым чын суд ден чынлыклан туныктенат.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Чаплыза Господьым, мемнан Юмынам,</para>
  <para style="q1" vid="PSA 98:5">вуйдам савыза Тудын йол шындыме верже ончылно:</para>
  <para style="q1" vid="PSA 98:5">Тудо святой!<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />Иерей-влак кокла гыч Моисей ден Аарон,</para>
  <para style="q2" vid="PSA 98:6">Тудын лӱмжым ӱжын кумалше кокла гыч Самуил</para>
  <para style="q2" vid="PSA 98:6">Господьым ӱжын кумалыныт – Тудо нуным колын.<verse eid="PSA 98:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Тудо нунылан пыл меҥге кокла гыч ойлен,</para>
  <para style="q1" vid="PSA 98:7">пуэн кодымо сугынь ден пунчалже-влакым нуно шуктеныт.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Господь Юмына! Тый нуным колынат,</para>
  <para style="q1" vid="PSA 98:8">языкыштым кудалтенат,</para>
  <para style="q1" vid="PSA 98:8">но осал пашаштлан мутым кучыктенат.<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />Чаплыза Господь Юмынам,</para>
  <para style="q1" vid="PSA 98:9">Тудын святой курыкшо воктене вуйдам савыза,</para>
  <para style="q1" vid="PSA 98:9">вет Господь Юмына святой.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="cl">99 ПСАЛОМ</para>
  <para style="d">[Давидын] моктен мурымо псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />Пӱтынь мланде, Господьлан йывыртен кычкырал!<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />Господьлан куанен служитлыза,</para>
  <para style="q1" vid="PSA 99:2">Тудын ончыкшо кугу йӱкын куанен толза!<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Палыза: Господь улеш Юмо,</para>
  <para style="q1" vid="PSA 99:3">Тудо мемнам ыштен, ме Тудын улына –</para>
  <para style="q1" vid="PSA 99:3">Тудын калыкше да кӱтӱжын шорыкшо.<verse eid="PSA 99:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Тудын капкалашкыже таумут дене пурыза,</para>
  <para style="q1" vid="PSA 99:4">Тудын кудывечылашкыже – моктымаш дене.</para>
  <para style="q1" vid="PSA 99:4">Тудлан тауштыза, Тудын лӱмжым моктыза!<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Вет Господь поро:</para>
  <para style="q1" vid="PSA 99:5">порылыкшо Тудын курымеш,</para>
  <para style="q1" vid="PSA 99:5">тукым гыч тукымыш Тудо ӱшанле.<verse eid="PSA 99:5" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="cl">100 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Порылык ден чын суд нерген мурем,</para>
  <para style="q1" vid="PSA 100:1">Тыйым, Господь, моктен мурем.<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />Илыш корнемын яндарлыкше нерген шонкалем,</para>
  <para style="q1" vid="PSA 100:2">кунам Тый мый декем толат?</para>
  <para style="q1" vid="PSA 100:2">Яндар шӱм дене илынем шке калыкем коклаште.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Шинча ончыкем нимо удам ом пыште,</para>
  <para style="q1" vid="PSA 100:3">осал пашам ужмем ок шу,</para>
  <para style="q1" vid="PSA 100:3">мый нунын деч кораҥ коштам.<verse eid="PSA 100:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Шӱмем гыч йӧрдымӧ шонымашым кораҥдем,</para>
  <para style="q1" vid="PSA 100:4">осал дене варнымем ок шу.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Лишылъеҥже ӱмбак лавырам шолып кышкышым мый пытарем,</para>
  <para style="q1" vid="PSA 100:5">кугешныше ончалтышаным, моктаныше шӱм-чонаным чыташ ом тӱҥал.<verse eid="PSA 100:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 100:6" />Элын ӱшанле еҥже-влак ӱмбак лиеш ончалтышем,</para>
  <para style="q1" vid="PSA 100:6">лийыт нуно мыйын воктенем;</para>
  <para style="q1" vid="PSA 100:6">ару корно дене коштшо мыланем служитлаш тӱҥалеш.<verse eid="PSA 100:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 100:7" />Илаш ок тӱҥал пӧртыштем ондалыше еҥ,</para>
  <para style="q1" vid="PSA 100:7">шоякым ойлышо еҥ шинча ончылнем огеш лий.<verse eid="PSA 100:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 100:8" />Эр гычак тӱҥалын, пытараш тӱҥалам мый</para>
  <para style="q2" vid="PSA 100:8">чыла осал еҥым шке мландыштем,</para>
  <para style="q1" vid="PSA 100:8">осалым ыштыше-влакым Господьын олаж гыч пӱтынек пытарем.<verse eid="PSA 100:8" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="cl">101 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 101:1" />Орланышын кумалмыже, кунам тудын ӱнарже пыта да тудо Господьлан вуйым шиеш.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Господь, мыйын кумалмемым кол,</para>
  <para style="q1" vid="PSA 101:2">полышым йодын кычкырымем тек Тый декет миен шуэш.<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Ит шылте чуриетым мый дечем,</para>
  <para style="q1" vid="PSA 101:3">ойган кечыштем мый декем пылышетым савыре.</para>
  <para style="q1" vid="PSA 101:3">Тыйым ӱжын кумалмем годым мылам вашешташ вашке.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Шикш семын йомыныт кечем-влак,</para>
  <para style="q1" vid="PSA 101:4">луэм-влак пуйто тулеш когаргеныт.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Шӱмемже кошкен, лывыжген шудо семын,</para>
  <para style="q1" vid="PSA 101:5">мый эсогыл кочкашат мондем.<verse eid="PSA 101:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Кечкыжмем дене мый дечем</para>
  <para style="q2" vid="PSA 101:6">лач лу ден коваште кодыныт.<verse eid="PSA 101:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Лийынам мый ир мландысе пеликан гай,</para>
  <para style="q1" vid="PSA 101:7">шалатен кодымо олаште илыше тумна гай.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Ом мале мый,</para>
  <para style="q2" vid="PSA 101:8">леведыш ӱмбалне шинчыше шкет кайык гай улам.<verse eid="PSA 101:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 101:9" />Кажне кечын мыйым тушманем-влак шӱктарат,</para>
  <para style="q1" vid="PSA 101:9">мыйым мыскылыше-шамыч каргаш лӱмемым кучылтыт.<verse eid="PSA 101:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 101:10" />Кинде семын кочкам мый ломыжым,</para>
  <para style="q1" vid="PSA 101:10">йӱшаш вӱдышкем шинчавӱд йога,<verse eid="PSA 101:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 101:11" />вет Тый мылам сырышыч, шыдешкышыч,</para>
  <para style="q1" vid="PSA 101:11">мыйым налын кудалтышыч.<verse eid="PSA 101:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 101:12" />Кечем-влак кас ӱмыл семын йомыт,</para>
  <para style="q1" vid="PSA 101:12">шудо семын мый кошкем.<verse eid="PSA 101:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 101:13" />Но Тый, Господь, курымеш кугыжаланет,</para>
  <para style="q1" vid="PSA 101:13">тукым гыч тукымыш Тыйым шарнен илат.<verse eid="PSA 101:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 101:14" />Тый кынелат да Сионым чаманен налат,</para>
  <para style="q1" vid="PSA 101:14">вет шуын жап, жап шуын тудым серлагаш.<verse eid="PSA 101:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 101:15" />Тарзет-влаклан Сионын кажне кӱжӧ шерге,</para>
  <para style="q1" vid="PSA 101:15">эсогыл пуракше чаманымашым луктеш.<verse eid="PSA 101:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 101:16" />Господьын лӱмжӧ деч лӱдаш тӱҥалыт калык-влак,</para>
  <para style="q1" vid="PSA 101:16">Тудын чапше деч – мландысе кугыжа-шамыч.<verse eid="PSA 101:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 101:17" />Вет Господь Сионым угыч чоҥа,</para>
  <para style="q1" vid="PSA 101:17">шке чапше дене Тудо конча.<verse eid="PSA 101:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 101:18" />Колеш Тудо полышдымо-влакын кумалмыштым,</para>
  <para style="q1" vid="PSA 101:18">нунын йодмыштым шотыш налеш.<verse eid="PSA 101:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 101:19" />Шочшаш тукымлан тидын нерген возымо лиеш,</para>
  <para style="q1" vid="PSA 101:19">ончыкылык еҥ-влак Господьым мокташ тӱҥалыт.<verse eid="PSA 101:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 101:20" />Онча Господь святой кӱкшӧ верже гыч,</para>
  <para style="q1" vid="PSA 101:20">пылпомыш гыч Тудо мландыш онча.<verse eid="PSA 101:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 101:21" />Пленыш налме-влакын кечкыжмыштым Тудо колеш,</para>
  <para style="q1" vid="PSA 101:21">пушташ пуымо-шамычым эрыкыш луктеш.<verse eid="PSA 101:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 101:22" />Моктен увертарат Господьын лӱмжым Сионышто,</para>
  <para style="q1" vid="PSA 101:22">чапландарат Тудым Иерусалимыште,<verse eid="PSA 101:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 101:23" />кунам калык ден кугыжаныш-влак</para>
  <para style="q2" vid="PSA 101:23">Господьлан кумалаш пырля погынат.<verse eid="PSA 101:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 101:24" />Жап деч ончыч Тудо мыйым лунчыртен,</para>
  <para style="q1" vid="PSA 101:24">илышаш кечем кӱчыкемден.<verse eid="PSA 101:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 101:25" />Каласенам мый: Юмем, мыйым ӱмыр лугыч ит нал.</para>
  <para style="q1" vid="PSA 101:25">Тый тукым гыч тукымыш илет!<verse eid="PSA 101:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 101:26" />Тый, [Господь], тӱҥалтыште мландым негызленат,</para>
  <para style="q1" vid="PSA 101:26">кават – кидетын пашаже.<verse eid="PSA 101:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 101:27" />Нуно пытат, а Тый эре улат.</para>
  <para style="q1" vid="PSA 101:27">Вургем семын нуно тоштемыт,</para>
  <para style="q1" vid="PSA 101:27">чием семын Тый нуным вашталтет, да нуно весемыт.<verse eid="PSA 101:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 101:28" />Но Тый эре тугаяк кодат,</para>
  <para style="q1" vid="PSA 101:28">илышаш кечет огеш пыте.<verse eid="PSA 101:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 101:29" />Тарзет-влакын эргышт илаш тӱҥалыт тыныслын,</para>
  <para style="q1" vid="PSA 101:29">Тыйын чурий ончылнет нунын тукымышт пеҥгыде лиеш.<verse eid="PSA 101:29" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="cl">102 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />Чонем, Господьым мокто,</para>
  <para style="q1" vid="PSA 102:1">да уло кӧргем – Тудын святой лӱмжым!<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Чонем, Господьым мокто</para>
  <para style="q1" vid="PSA 102:2">да Тудын чыла поро пашажым ит мондо.<verse eid="PSA 102:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Тудо чыла титакетым кудалта,</para>
  <para style="q1" vid="PSA 102:3">чыла черетым паремда.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Утарен кода шӱгар деч илышетым,</para>
  <para style="q1" vid="PSA 102:4">порылык да чаманымаш дене тыйым леведеш.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Порылыкшо дене мо кӱлешетым тема,</para>
  <para style="q1" vid="PSA 102:5">арыслангайык семын тый угыч самырык да виян лият.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Чын улыт Господьын пашаже-влак,</para>
  <para style="q1" vid="PSA 102:6">чыла пызырналтшылан Тудо чын судым ышта.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Тудо шке корныжым Моисейлан,</para>
  <para style="q2" vid="PSA 102:7">шке пашажым Израиль эрге-влаклан ончыктен.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Господь – поро да чаманыше,</para>
  <para style="q1" vid="PSA 102:8">кужун чытыше да шуко порылыкан.<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Эрелан огыл Тудын титаклымыже,</para>
  <para style="q1" vid="PSA 102:9">курымешлан огыл шыдыже.<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />Мыланна осал пашана почеш ыштен огыл,</para>
  <para style="q1" vid="PSA 102:10">сулыкна почеш мыланна пӧртылтен огыл.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Вет кузе кава мланде деч кӱшнӧ,</para>
  <para style="q1" vid="PSA 102:11">тунар кугу Господьын порылыкшо</para>
  <para style="q2" vid="PSA 102:11">Тудын деч лӱдшӧ-влак деке.<verse eid="PSA 102:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Кузе эрвел деч касвел мӱндырнӧ,</para>
  <para style="q1" vid="PSA 102:12">тыгак мӱндыркӧ кораҥден мемнан деч сулыкнам.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Кузе ача эргыж-влакым чамана,</para>
  <para style="q1" vid="PSA 102:13">тугак Господь Тудын деч лӱдшӧ-влакым чамана.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Вет Тудо мемнан мо гыч ышталтмынам пала,</para>
  <para style="q1" vid="PSA 102:14">мланде пурак улмынам шарна.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Айдемын ӱмыржӧ шудо гай,</para>
  <para style="q1" vid="PSA 102:15">олык пеледыш семын тудо пеледеш.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Ӱмбачынже мардеж эрта – тудо уке лиеш,</para>
  <para style="q1" vid="PSA 102:16">тудын кушмо вержат тудым ок пале.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Но Господь деч лӱдшӧ-влаклан</para>
  <para style="q2" vid="PSA 102:17">Тудын порылыкшо курым гыч курымыш лиеш,<verse eid="PSA 102:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />нунын эргышт-влакын эргышт ӱмбалне –</para>
  <para style="q1" vid="PSA 102:18">кӧмыт Тудын ойпидышыжым шуктен шогат,</para>
  <para style="q1" vid="PSA 102:18">Тудын кӱштымашыже-влакым шарнат да шуктат –</para>
  <para style="q1" vid="PSA 102:18">Господьын чынлыкше лиеш.<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />Господь пылпомышеш шке престолжым шынден,</para>
  <para style="q1" vid="PSA 102:19">уло тӱня дене Тудо кугыжалана.<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />Те, Тудын куатан Суксыжо-влак,</para>
  <para style="q1" vid="PSA 102:20">Тудын ойлымыжым колыштшо да мутшым шуктышо-влак,</para>
  <para style="q1" vid="PSA 102:20">Господьым моктыза!<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Те, Тудлан служитлыше,</para>
  <para style="q1" vid="PSA 102:21">Тудын кумылжым шуктен шогышо патырже-влак,</para>
  <para style="q1" vid="PSA 102:21">Господьым моктыза!<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />Господьын ыштымыже-шамыч, Тудым моктыза,</para>
  <para style="q1" vid="PSA 102:22">чыла озаланыме верыштыже Тудым чапландарыза.</para>
  <para style="q1" vid="PSA 102:22">Чонем, Господьым мокто!<verse eid="PSA 102:22" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="cl">103 ПСАЛОМ</para>
  <para style="d">[Тӱням ыштыме нерген Давидын псаломжо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Чонем, Господьым мокто!</para>
  <para style="q1" vid="PSA 103:1">Господь, мыйын Юмем!</para>
  <para style="q1" vid="PSA 103:1">Могай Тый кӱдыратле улат,</para>
  <para style="q1" vid="PSA 103:1">Тый чап да кугулык дене вӱдылалтынат.<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Тый волгыдым пуйто вургемым чиет,</para>
  <para style="q1" vid="PSA 103:2">пылпомышым пуйто куэмым шарет.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />Кӱшнысӧ вӱд-влак ӱмбалне илыме веретым шындет,</para>
  <para style="q1" vid="PSA 103:3">пыл-влакым Шкаланет орвам ыштет,</para>
  <para style="q1" vid="PSA 103:3">мардежын шулдырешыже чоҥештен коштат.<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />Суксет-влакым Тый шӱлышым ыштет,</para>
  <para style="q1" vid="PSA 103:4">Тылат служитлыше-шамычым – тулйылмым.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />Тый мландым шынденат чоткыдо негызеш:</para>
  <para style="q1" vid="PSA 103:5">верже гыч ок тарване тудо курым-курымеш.<verse eid="PSA 103:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />Келге вӱд-влак дене, пуйто вургем дене,</para>
  <para style="q2" vid="PSA 103:6">тудым Тый леведынат –</para>
  <para style="q1" vid="PSA 103:6">вӱд эсогыл курык-влакым петырен.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Тыйын шӱдымет дене вӱд-влак куржыныт,</para>
  <para style="q1" vid="PSA 103:7">кӱдыртымӧ йӱкет деч нуно писын йогеныт.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />Кӱзеныт курык ӱмбаке, лапверыш воленыт,</para>
  <para style="q1" vid="PSA 103:8">Тыйын палемдыме верыш логалыныт.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Вӱд-влаклан Тый чекым пыштенат,</para>
  <para style="q1" vid="PSA 103:9">тудым нуно огыт вончо,</para>
  <para style="q1" vid="PSA 103:9">мландым леведаш огыт пӧртыл.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />Памаш-влакым лапверлашке колтенат,</para>
  <para style="q1" vid="PSA 103:10">курыкла коклаште нуно йогат.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Йӱктат памаш-влак чыла янлыкым,</para>
  <para style="q1" vid="PSA 103:11">ир осёл-влак теммешкышт йӱыт.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Нунын воктене кавасе кайык-влак илат,</para>
  <para style="q1" vid="PSA 103:12">укшерла кокла гыч йӱкыштым луктыт.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Шке кӱкшытет гыч курык-влакым йӱктет,</para>
  <para style="q1" vid="PSA 103:13">Тыйын пашатын саскаже-влакым мланде теммеш кочкеш.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />Тый вольыклан шудым куштет,</para>
  <para style="q1" vid="PSA 103:14">айдемылан илаш – кушкыл-влакым,</para>
  <para style="q1" vid="PSA 103:14">тыге Тый мланде гыч кочкышым шочыктет:<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />йошкар аракам – тудо айдемын шӱмжым куандара,</para>
  <para style="q1" vid="PSA 103:15">ӱйым – тудын деч чурийже йылгыжеш,</para>
  <para style="q1" vid="PSA 103:15">да киндым – айдеме капкыллан тудо вийым пуа.<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />Вӱдыжтарыме улыт Господьын пушеҥгыже-влак –</para>
  <para style="q1" vid="PSA 103:16">Тудын шындыме Ливан кедр-влак.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Тушан кайык-шамыч пыжашым оптат,</para>
  <para style="q1" vid="PSA 103:17">пушеҥге вуй-влак аистын илыме верже улыт,<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />кӱкшӧ курык-влак ирказан,</para>
  <para style="q2" vid="PSA 103:18">курык шелше-влак даманын<note caller="*" style="f"><char style="fr" closed="false">103:18 </char><char style="ft" closed="false">Даман – кролик кугытан, нултышо янлыкым ушештарыше янлык. Тӱҥ шотышто курыкан верыште ила.</char></note> шылме верышт улыт.<verse eid="PSA 103:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />Жапым ончыкташ ыштен Тудо тылзым,</para>
  <para style="q1" vid="PSA 103:19">кечат шке шичме жапшым пала.<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Колтет Тый пычкемышым – йӱд лиеш,</para>
  <para style="q1" vid="PSA 103:20">да чодырасе чыла янлык лектын коштеш.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Ырлат лев-влак иктаж-мом кучаш,</para>
  <para style="q1" vid="PSA 103:21">Юмо деч нуно кочкышым йодыт.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Кече лекмеке, пырля погынат,</para>
  <para style="q1" vid="PSA 103:22">пурен возыт шке пыжашышкышт.<verse eid="PSA 103:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 103:23" />Айдеме гын пашам ышташ лектеш,</para>
  <para style="q1" vid="PSA 103:23">кас пычкемыш марте тудо тырша.<verse eid="PSA 103:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 103:24" />Шотлен пытарыдыме Тыйын пашат, Господь!</para>
  <para style="q1" vid="PSA 103:24">Чылажымат Тый мунлын ыштенат,</para>
  <para style="q1" vid="PSA 103:24">Тыйын ыштымет дене мланде темын.<verse eid="PSA 103:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 103:25" />Теве пеш кугу, кумда теҥыз:</para>
  <para style="q1" vid="PSA 103:25">тушто илыше чонан-влакым шотлен пытараш ок лий –</para>
  <para style="q1" vid="PSA 103:25">тӱрлӧ кугу да изи янлык шолыт.<verse eid="PSA 103:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 103:26" />Теҥыз мучко ийын коштыт корабль-влак,</para>
  <para style="q1" vid="PSA 103:26">Тыйын ыштыме левиафанат тушто модын коштеш.<verse eid="PSA 103:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 103:27" />Нуно чыланат Тыйын ӱмбакет ончат,</para>
  <para style="q1" vid="PSA 103:27">шке жапыштыже кочкыш пуыметым вучат.<verse eid="PSA 103:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 103:28" />Тый пуэт – нуно налыт,</para>
  <para style="q1" vid="PSA 103:28">чаманыде пуышо кидет дене нуным теммеш пукшет.<verse eid="PSA 103:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 103:29" />Шылтет чуриетым – пудыранат,</para>
  <para style="q1" vid="PSA 103:29">шӱлышыштым налат – колат,</para>
  <para style="q1" vid="PSA 103:29">угыч мланде пуракыш савырнат.<verse eid="PSA 103:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 103:30" />Шке шӱлышетым колтет – у илыш шочеш:</para>
  <para style="q1" vid="PSA 103:30">мландын сынжым Тый уэмдет.<verse eid="PSA 103:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 103:31" />Чап лийже Господьлан курымеш,</para>
  <para style="q1" vid="PSA 103:31">чыла мом ыштымыжлан Тудо тек йывырта!<verse eid="PSA 103:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 103:32" />Тудо мланде ӱмбак ончалеш – мланде чытырналтеш,</para>
  <para style="q1" vid="PSA 103:32">курык-влак деке тӱкна – нуно шикшаш тӱҥалыт.<verse eid="PSA 103:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 103:33" />Мураш тӱҥалам Господьлан ӱмыр мучко,</para>
  <para style="q1" vid="PSA 103:33">моктен мурем Юмемым, кунар эше илем.<verse eid="PSA 103:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 103:34" />Мыйын мурем Тудлан тек келшыше лиеш;</para>
  <para style="q1" vid="PSA 103:34">Господьлан куана чонем.<verse eid="PSA 103:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 103:35" />Тек йомыт мландымбачын языкан-влак,</para>
  <para style="q1" vid="PSA 103:35">осал еҥ-влак ынышт лий тетла.</para>
  <para style="q1" vid="PSA 103:35">Чонем, Господьым мокто! Аллилуия!<verse eid="PSA 103:35" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="cl">104 ПСАЛОМ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Чаплыза Господьым, лӱмжым ӱжын кумалза,</para>
  <para style="q1" vid="PSA 104:1">калык-шамыч коклаште Тудын пашаж-влакым каласкалыза.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />Тудым чаплыза, Тудлан мурыза,</para>
  <para style="q1" vid="PSA 104:2">Тудын чыла ӧрыктарыше пашаж-влак нерген ойлыза.<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />Тудын святой лӱмжӧ дене кугешныза,</para>
  <para style="q1" vid="PSA 104:3">Господьым кычалше шӱм-влак тек куанат.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />Кычалза Господьым да Тудын вийжым,</para>
  <para style="q1" vid="PSA 104:4">кычалза Тудын чурийжым эре.<verse eid="PSA 104:4" /></para>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 104:5-6" />Те, Авраам тарзыжын тукымжо,</para>
  <para style="q1" vid="PSA 104:5-6">Иаковын эргыже-влак, Тудын ойырен налмыже-влак!</para>
  <para style="q1" vid="PSA 104:5-6">Тудын ӧрыктарыше пашаж-влакым,</para>
  <para style="q2" vid="PSA 104:5-6">палдарыше пале ден увертарыме судшо-влакым шарныза.<verse eid="PSA 104:5-6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Тудо – мемнан Господь Юмына,</para>
  <para style="q1" vid="PSA 104:7">чыла вере мландымбалне судым ышта.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Курымеш шарна Тудо шке ойпидышыжым,</para>
  <para style="q2" vid="PSA 104:8">тӱжем тукымлан пуымо мутшым,<verse eid="PSA 104:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 104:9" />Авраам дене ыштыме ойпидышыжым,</para>
  <para style="q2" vid="PSA 104:9">Исааклан пуымо товатмутшым.<verse eid="PSA 104:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Иаковлан тидым закон семын,</para>
  <para style="q2" vid="PSA 104:10">Израильлан курымаш ойпидыш семын пеҥгыдемден.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Тудо каласен: «Ханаан мландым тыланда пуэм,</para>
  <para style="q1" vid="PSA 104:11">тудо озаланен илыме мландыда лиеш».<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Тунам Израиль калык пеш шагал улмаш,</para>
  <para style="q1" vid="PSA 104:12">да нуно тушто ӧрдыж гыч толшо лийыныт,<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />ик калык деч вес калык деке,</para>
  <para style="q2" vid="PSA 104:13">ик кугыжаныш гыч вес кугыжанышыш кусныл коштыныт.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Но Тудо нуным нигӧлан шыгыремдаш пуэн огыл,</para>
  <para style="q1" vid="PSA 104:14">нунын шотышто кугыжа-влаклан шижтарен ойлен:<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />«Шӱрен палемдыме-влакем ида тӱкӧ,</para>
  <para style="q1" vid="PSA 104:15">пророк-влакемлан осалым ида ыште».<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Ты мландыш Тудо колтен шужымашым,</para>
  <para style="q1" vid="PSA 104:16">нуным кинде деч посна коден.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Нунын деч ончыч колтен ик еҥым:</para>
  <para style="q1" vid="PSA 104:17">Иосиф кул семын ужалыме лийын.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Тудын йолжым шинчырленыт,</para>
  <para style="q1" vid="PSA 104:18">шӱйышкыжӧ кӱртньӧ кепшылым чиктеныт,<verse eid="PSA 104:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />но жап шуын – Юмын мутшо шукталтын.</para>
  <para style="q1" vid="PSA 104:19">Тыге Господьын шомакше тудын чын улмыжым ончыктен.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Кугыжа кӱштен, да Иосифым руденыт,</para>
  <para style="q1" vid="PSA 104:20">калык-влакым вуйлатыше тудым эрыкыш луктын.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Тудо Иосифым шке пӧртшын тӱҥ тӧражлан,</para>
  <para style="q2" vid="PSA 104:21">уло погыжын озажлан шогалтен.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Иосиф тӧра-влакым шонымыж семын виктарен шогышаш,</para>
  <para style="q1" vid="PSA 104:22">кугурак-шамычым мунлылыклан туныктышаш улмаш.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Тунам Израиль Египетыш толын,</para>
  <para style="q1" vid="PSA 104:23">Хам мландышке Иаков илаш куснен.<verse eid="PSA 104:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />Юмо шке калыкшым чот шукемден,</para>
  <para style="q1" vid="PSA 104:24">тушманышт деч виянракым ыштен.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Тыге Господь египтян-влакын шӱмыштышт</para>
  <para style="q2" vid="PSA 104:25">шке калыкше дек ужмышудымашым шочыктен,</para>
  <para style="q1" vid="PSA 104:25">да нуно Тудын тарзыж-влак ваштареш</para>
  <para style="q2" vid="PSA 104:25">осал чоялыкым ышташ тӱҥалыныт.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />Но Господь шке Моисей тарзыжым</para>
  <para style="q2" vid="PSA 104:26">да Аароным, ойырен налме еҥжым, колтен.<verse eid="PSA 104:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Египтян-шамыч коклаште нуно</para>
  <para style="q2" vid="PSA 104:27">Тудын палдарыше палыж-влакым ончыктеныт,</para>
  <para style="q1" vid="PSA 104:27">ӧрыктарыше паша-влакым Хам мландыште ыштеныт.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Тӱп пычкемышым Тудо колтен,</para>
  <para style="q1" vid="PSA 104:28">Моисей ден Аарон Тудын шомакшылан торешланен огытыл.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Савырен нунын вӱдыштым вӱрыш,</para>
  <para style="q1" vid="PSA 104:29">да чыла кол пытен.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Ужава-влак дене мландышт темын,</para>
  <para style="q1" vid="PSA 104:30">пуреныт нуно кугыжан малыме пӧлемышкат.<verse eid="PSA 104:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Господь кӱштен – пеш шуко пормо толын темын,</para>
  <para style="q1" vid="PSA 104:31">мланде мучко ӱвыра шарлен.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Йӱр олмеш ӱмбакышт шолемым йоктарен,</para>
  <para style="q1" vid="PSA 104:32">йӱлатыше тулым мландышкышт колтен,<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />виноград ден смоква пушеҥгыштым пытарен,</para>
  <para style="q1" vid="PSA 104:33">мланде мучко чыла пушеҥгым пудыртен.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Господь кӱштен – толын лектыныт шурнышырчык-влак,</para>
  <para style="q2" vid="PSA 104:34">шотлен пытараш лийдыме шукш-влак.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Нунын мландыште чыла кушкылым пӧжгеныт,</para>
  <para style="q1" vid="PSA 104:35">пасушто чыла лектышым кочкын пытареныт.<verse eid="PSA 104:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 104:36" />Мландыштышт Тудо чыла кугэргым пуштын –</para>
  <para style="q1" vid="PSA 104:36">пӧръеҥ вийын икымше саскажым пытарен.<verse eid="PSA 104:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 104:37" />Израиль калыкым тушеч ший да шӧртньӧ дене луктын,</para>
  <para style="q1" vid="PSA 104:37">тудын тукымлаштыже лийын огыл ик черлат.<verse eid="PSA 104:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 104:38" />Израиль кайымылан Египет йывыртен,</para>
  <para style="q1" vid="PSA 104:38">вет Израиль деч тудо лӱдын.<verse eid="PSA 104:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 104:39" />Господь нуным пыл дене леведын,</para>
  <para style="q1" vid="PSA 104:39">йӱдым волгалтараш тулым колтен.<verse eid="PSA 104:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 104:40" />Нуно йодыныт – пулдырчо-влакым колтен,</para>
  <para style="q1" vid="PSA 104:40">кавасе киндым нунылан пукшен.<verse eid="PSA 104:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 104:41" />Шелын кӱ курыкым – вӱд йоген лектын,</para>
  <para style="q1" vid="PSA 104:41">эҥер семын тудо кукшо верыште йоген.<verse eid="PSA 104:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 104:42" />Тудо шке святой шомакшым,</para>
  <para style="q2" vid="PSA 104:42">Авраам тарзыжлан пуымо мутшым, шарналтен<verse eid="PSA 104:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 104:43" />да шке калыкшым йывыртымаш дене,</para>
  <para style="q2" vid="PSA 104:43">ойырен налмыже-влакым куан дене луктын.<verse eid="PSA 104:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 104:44" />Пуэн нунылан вес калык-влакын мландыштым,</para>
  <para style="q1" vid="PSA 104:44">весе-влакын паша лектышыштым нуно налыныт.<verse eid="PSA 104:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 104:45" />Нуно Тудын законжым шотлышаш,</para>
  <para style="q1" vid="PSA 104:45">кӱштымашыже-влакым шуктен шогышаш улыт.</para>
  <para style="q1" vid="PSA 104:45">Аллилуия!<verse eid="PSA 104:45" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="cl">105 ПСАЛОМ</para>
  <para style="d">Аллилуия.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Моктыза Господьым – Тудо поро,</para>
  <para style="q1" vid="PSA 105:1">порылыкшо Тудын курымеш.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Кӧ Господьын куатан пашаж-влакым пӱтынек каласкален,</para>
  <para style="q2" vid="PSA 105:2">моктымашым сулышо чыла пашажым увертарен кертеш?<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Пиалан улыт чынлыкым шуктен шогышо,</para>
  <para style="q2" vid="PSA 105:3">эре чыным ыштыше-влак!<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Господь, шке калыкетлан порылыкым ончыктымет годым</para>
  <para style="q2" vid="PSA 105:4">мыйым шарналте:</para>
  <para style="q1" vid="PSA 105:4">кунам нуным утараш тӱҥалат – мыламат полшо.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />Пу мылам ойырен налмет-влакын сайын илымыштым ужаш,</para>
  <para style="q1" vid="PSA 105:5">Тыйын калыкет дене пырля йывырташ,</para>
  <para style="q1" vid="PSA 105:5">Тыйын еҥет-влак дене пырля куанаш.<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />Ача-кочана-влак семын ме сулыкыш пуренна,</para>
  <para style="q1" vid="PSA 105:6">осал, уда паша-шамычым ыштенна.<verse eid="PSA 105:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Египетыште улмышт годым ача-кочана-влак</para>
  <para style="q2" vid="PSA 105:7">Тыйын ӧрыктарыше пашат-влакым умылен огытыл,</para>
  <para style="q1" vid="PSA 105:7">шуко гана ончыктымо порылыкетым монденыт,</para>
  <para style="q1" vid="PSA 105:7">Йошкар теҥыз воктене ӱскыртланеныт.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Но шке куатшым ончыкташ манын,</para>
  <para style="q1" vid="PSA 105:8">шке лӱмжылан кӧра Тудо нуным утарен.<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />Йошкар теҥызлан кӱштен каласен – тудо кошкен,</para>
  <para style="q1" vid="PSA 105:9">Господь нуным теҥыз пундаш дене</para>
  <para style="q2" vid="PSA 105:9">пуйто кукшо мланде дене наҥгаен.<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />Тудо нуным ужмышудымо-влакын кидышт гыч утарен,</para>
  <para style="q1" vid="PSA 105:10">тушман кид гыч эрыкыш колтен.<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />Вӱд леведын нунын тушманыштым,</para>
  <para style="q1" vid="PSA 105:11">кодын огыл илыше иктат.<verse eid="PSA 105:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Тудын мутшылан нуно ӱшаненыт,</para>
  <para style="q1" vid="PSA 105:12">Тудым моктен муреныт.<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />Но Тудын пашаж-влакым вашке монденыт,</para>
  <para style="q1" vid="PSA 105:13">Тудын каҥашыжым вучен огытыл.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />Ир мландыште нуно кумыл йодмыштлан вуйым пуэныт,</para>
  <para style="q1" vid="PSA 105:14">еҥ илыдыме верыште Юмым тергеныт.<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />Нунын йодмыштым Тудо шуктен,</para>
  <para style="q1" vid="PSA 105:15">но ӱмбакышт шучко черым колтен.<verse eid="PSA 105:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />Станыште нуно кӧраненыт Моисейлан,</para>
  <para style="q2" vid="PSA 105:16">да Ааронлан, Господьын святойжылан.<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />Мланде шелалт почылтын да Дафаным нелын,</para>
  <para style="q1" vid="PSA 105:17">Авирон кашакым помышешыже тоен.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />Тул ылыжын нунын коклаште,</para>
  <para style="q1" vid="PSA 105:18">осал еҥ-влакым тулйылме йӱлалтен.<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />Хорив курык воктене велен ыштеныт ӱшкыжым,</para>
  <para style="q1" vid="PSA 105:19">кумалыныт нуно шояк юмылан –<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Юмыштым, шке Чапыштым,</para>
  <para style="q2" vid="PSA 105:20">шудым кочкын илыше ӱшкыжын тӱсшылан вашталтеныт.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />Монденыт нуно Утарыше Юмыштым,</para>
  <para style="q1" vid="PSA 105:21">кеч Тудыжо Египетыште кугу паша-влакым,<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />Хам мландыште ӧрмашан</para>
  <para style="q2" vid="PSA 105:22">да Йошкар теҥыз воктене лӱдмашан паша-влакым ыштен.<verse eid="PSA 105:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Шке калыкшым Тудо пытараш шонен,</para>
  <para style="q1" vid="PSA 105:23">но Моисей, Тудын ойырен налме еҥже,</para>
  <para style="q1" vid="PSA 105:23">Тудын ончыко шелшыш шогалын –</para>
  <para style="q1" vid="PSA 105:23">да, нуным Юмо ынже пытаре манын,</para>
  <para style="q1" vid="PSA 105:23">Тудын шыдыжым кораҥден.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />Налаш шонымо мландыштым аклен моштен огытыл,</para>
  <para style="q1" vid="PSA 105:24">Юмын мутшылан ӱшанен огытыл.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />Ӧпкелен ойленыт шке омашлаштышт,</para>
  <para style="q1" vid="PSA 105:25">Господьын йӱкшым колыштын огытыл.<verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />Тунам Тудо кидшым нӧлталын –</para>
  <para style="q1" vid="PSA 105:26">нуным ир мландыште кошарташ,<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />тукымыштым калык-влак коклаште пытараш,</para>
  <para style="q1" vid="PSA 105:27">вес эллашке нуным шалатен колташ.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />Нуно Ваал-Фегорлан кумалаш тӱҥалыныт,</para>
  <para style="q1" vid="PSA 105:28">чондымо юмо-влаклан кондымо надырым кочкыныт.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />Шке пашашт дене Господьын шыдыжым луктыныт,</para>
  <para style="q1" vid="PSA 105:29">да нунын коклаште шучко чер шарлен.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Но тунам Финеес кынелын</para>
  <para style="q1" vid="PSA 105:30">да судым ыштен – тыге чер чарнен.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />Тиде пашажлан тудо тукым гыч тукымыш, курымеш</para>
  <para style="q2" vid="PSA 105:31">чын ыштышылан шотлалтеш.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />Мерива вӱд воктене шыдештареныт нуно Юмым,</para>
  <para style="q1" vid="PSA 105:32">ойгым ужын нунын верч Моисей.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Тудын чонжылан нуно кочым конденыт,</para>
  <para style="q1" vid="PSA 105:33">да сайын шоналтыде тудо каласен.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />Господьын пытараш шӱдымӧ калык-влакым</para>
  <para style="q2" vid="PSA 105:34">нуно пытарен огытыл,<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />йот калык-влак дене лугалтыныт,</para>
  <para style="q1" vid="PSA 105:35">нунын йӱлаштлан тунемыныт,<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />шояк юмыштлан кумалыныт,</para>
  <para style="q1" vid="PSA 105:36">нунышт израиль калыклан лӧдӧ лийыныт.<verse eid="PSA 105:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Шке эрге-ӱдырыштым нуно ия-влаклан надыр шотеш конденыт,<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />титакдыме вӱрым, эрге-ӱдырыштын вӱрым, йоктареныт,</para>
  <para style="q1" vid="PSA 105:38">Ханаанысе шояк юмо-влаклан нуным надырлан конденыт –</para>
  <para style="q1" vid="PSA 105:38">вӱрышт дене мланде шакшылалтын.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />Тыге нуно пашашт дене шкеныштым амыртеныт,</para>
  <para style="q1" vid="PSA 105:39">мом ыштылмышт дене яжарланеныт.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />Тунам Господьын шыдыже шке калыкшылан ылыжын:</para>
  <para style="q1" vid="PSA 105:40">шке еҥже-влак деч Тудо йырнен.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />Пуэн нуным йот калык-влакын кидышкышт,</para>
  <para style="q1" vid="PSA 105:41">нуным ужмышудымо-шамыч нунын дене озаланеныт.<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Шыгыремденыт нуным тушман-влак,</para>
  <para style="q1" vid="PSA 105:42">тушман кид йымалне нуно ӱҥышемыныт.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Шуко гана Тудо нуным утарен,</para>
  <para style="q1" vid="PSA 105:43">а нуно вустыкланымышт дене Тудым сырыктеныт</para>
  <para style="q1" vid="PSA 105:43">да шке сулыкешышт пижын шинчыныт.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />Но Тудо нунын йӧсланымыштым ужын,</para>
  <para style="q1" vid="PSA 105:44">полышым йодын кычкырымыштым колын.<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />Нунын дене ыштыме ойпидышыжым шарнен,</para>
  <para style="q1" vid="PSA 105:45">шуко порылыкшылан кӧра нуным чаманен.<verse eid="PSA 105:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 105:46" />Кӧ нуным пленыште кучен,</para>
  <para style="q2" vid="PSA 105:46">нунын шӱмышкӧ Господь чаманымашым пыштен.<verse eid="PSA 105:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 105:47" />Утаре мемнам, Господь Юмына,</para>
  <para style="q1" vid="PSA 105:47">калык-влак кокла гыч мемнам пого,</para>
  <para style="q1" vid="PSA 105:47">тунам ме Тыйын святой лӱметым чаплена,</para>
  <para style="q1" vid="PSA 105:47">Тыйым куанен моктена.<verse eid="PSA 105:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 105:48" />Тек Израильын Господь Юмыжо курым-курымеш моктымо лиеш!</para>
  <para style="q1" vid="PSA 105:48">Тек уло калык каласа: Аминь! Аллилуия!<verse eid="PSA 105:48" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="cl">106 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />Моктыза Господьым – Тудо поро,</para>
  <para style="q1" vid="PSA 106:1">порылыкшо Тудын курымеш!<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Тыге тек Господьын утарыме еҥже-влак ойлат.</para>
  <para style="q1" vid="PSA 106:2">Нуным Тудо тушман кид гыч утарен,<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />тӱрлӧ эл гыч, эрвел да касвел гыч,</para>
  <para style="q2" vid="PSA 106:3">йӱдвел да кечывалвел гыч поген.<verse eid="PSA 106:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Йомын коштыныт нуно еҥ илыдыме ир мландыште,</para>
  <para style="q1" vid="PSA 106:4">муын огытыл корным еҥ-влак илыман олашке.<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />Чытеныт шужымашым, йӱмӧ шумашым,</para>
  <para style="q1" vid="PSA 106:5">нуно пеш чот улненыт.<verse eid="PSA 106:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Шке ойгыштышт ӱжын кумалыныт Господьлан,</para>
  <para style="q1" vid="PSA 106:6">да Тудо орлыкышт деч нуным утарен:<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />тура корно дене еҥ-влак илыман олашке наҥгаен.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Тек моктат Господьым Тудын порылыкшылан,</para>
  <para style="q2" vid="PSA 106:8">айдеме эрге-влаклан ыштыме чыла ӧрыктарыше пашажлан,<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />вет йӱмӧ шушо чоным Тудо йӱктен,</para>
  <para style="q1" vid="PSA 106:9">шужышо чонлан тамле кочкышым пукшен.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Ойго да кӱртньӧ дене шинчырлыме,</para>
  <para style="q2" vid="PSA 106:10">нуно пычкемыште, колымаш ӱмылыштӧ шинченыт,<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />вет Юмын мутшылан нуно торешланеныт,</para>
  <para style="q1" vid="PSA 106:11">Чыла деч Кӱшылысын каҥашыжым кӱлдымыш луктыныт.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />Неле паша дене Тудо нуным темден,</para>
  <para style="q1" vid="PSA 106:12">нуно шӱртненыт, нигӧ полшен огыл.<verse eid="PSA 106:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Но шке ойгыштышт ӱжын кумалыныт Господьлан,</para>
  <para style="q1" vid="PSA 106:13">да Тудо орлыкышт деч утарен,<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />луктын нуным пычкемыш гыч, колымаш ӱмыл гыч,</para>
  <para style="q1" vid="PSA 106:14">шинчырыштым кӱрлын шуэн.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Тек моктат Господьым Тудын порылыкшылан,</para>
  <para style="q1" vid="PSA 106:15">айдеме эрге-влаклан ыштыме чыла ӧрыктарыше пашажлан!<verse eid="PSA 106:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />Вет Тудо той капка-влакым пудыртен,</para>
  <para style="q1" vid="PSA 106:16">кӱртньӧ тӱкылтыш-влакым шалатен.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Сулыкан корныштлан, осал пашаштлан кӧра</para>
  <para style="q2" vid="PSA 106:17">шотдымо еҥ-влак орланеныт.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Нунын чонышт чыла кочкыш деч йырнен,</para>
  <para style="q1" vid="PSA 106:18">колымаш капка деке нуно лишемыныт.<verse eid="PSA 106:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />Но шке ойгыштышт ӱжын кумалыныт Господьлан,</para>
  <para style="q1" vid="PSA 106:19">да Тудо орлыкышт деч нуным утарен.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Тудо шке шомакшым колтен да нуным паремден,</para>
  <para style="q1" vid="PSA 106:20">шӱгар деч нуным утарен.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Тек моктат Господьым Тудын порылыкшылан,</para>
  <para style="q2" vid="PSA 106:21">айдеме эрге-влаклан ыштыме чыла ӧрыктарыше пашажлан!<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />Тек кондат Тудлан моктымаш надырым,</para>
  <para style="q1" vid="PSA 106:22">Тудын пашаж нерген йывыртен увертарат!<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Южышт корабль дене теҥызыш коштыныт,</para>
  <para style="q1" vid="PSA 106:23">кугу вӱд ӱмбалне сомылым шуктеныт –<verse eid="PSA 106:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />нуно Господьын мом ыштымыжым ужыныт,</para>
  <para style="q1" vid="PSA 106:24">вӱд келгытыште ыштыме ӧрыктарыше пашажым эскереныт.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Тудо кӱштен, да тале мардеж кынелын,</para>
  <para style="q1" vid="PSA 106:25">теҥыз толкын-влак кӱш нӧлталтыныт.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Кӱзеныт еҥ-шамыч пылпомыш марте,</para>
  <para style="q1" vid="PSA 106:26">вара келгытыш воленыт,</para>
  <para style="q1" vid="PSA 106:26">тиде туткарыште чонышт ӱшаным йомдарен.<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />Йӱшӧ семын нуно пӧрдыныт, лӱҥгеныт –</para>
  <para style="q1" vid="PSA 106:27">чыла моштымашышт лектын укеш.<verse eid="PSA 106:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />Но шке ойгыштышт ӱжын кумалыныт Господьлан,</para>
  <para style="q1" vid="PSA 106:28">да Тудо орлыкышт деч нуным утарен.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Тыпландарен Тудо тӱтаным,</para>
  <para style="q1" vid="PSA 106:29">да толкын-влак шыпланеныт.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Куаненыт утарыме-влак теҥыз лыпланымылан,</para>
  <para style="q1" vid="PSA 106:30">да Тудо нуным толаш шонымо гаваньыш конден.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Тек моктат Господьым Тудын порылыкшылан,</para>
  <para style="q2" vid="PSA 106:31">айдеме эрге-влаклан ыштыме чыла ӧрыктарыше пашажлан!<verse eid="PSA 106:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />Тек Тудым чаплат калык погынымаште</para>
  <para style="q1" vid="PSA 106:32">да кугурак-влакын каҥашыштышт моктат!<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Эҥерым Тудо савыра ошманурыш,</para>
  <para style="q1" vid="PSA 106:33">памашым – кошкышо мландыш,<verse eid="PSA 106:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />киндым шочыктышо мландым – шинчалан кундемыш.</para>
  <para style="q1" vid="PSA 106:34">Вет тушто илыше-влак осал пашам ыштеныт.<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />Тудак савыра ошманурым ерыш,</para>
  <para style="q1" vid="PSA 106:35">кошкышо мландым – вӱдан памашыш;<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />шужен илыше-влакым нине кундемыш вераҥда,</para>
  <para style="q1" vid="PSA 106:36">нуно илашышт олам чоҥат.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />Ӱдат пасум, шындат виноградым –</para>
  <para style="q1" vid="PSA 106:37">кондат нунышт шуко саскам.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />Суапландара Тудо нуным, да нуно чот шукемыт,</para>
  <para style="q1" vid="PSA 106:38">вольыкыштымат Тудо шукемда.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Но кунам нуно шагалемыт,</para>
  <para style="q1" vid="PSA 106:39">пызырналт илыме деч, ойго-орлык дечын лунчыргат,<verse eid="PSA 106:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Господь он-влакым намыс дене леведеш,</para>
  <para style="q1" vid="PSA 106:40">корныдымо ир мландыште йомын кошташ кода.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Но йорлым Тудо незерлык гыч луктеш,</para>
  <para style="q1" vid="PSA 106:41">тудын тукымжым шорык кӱтӱ гай кугум ышта.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Тидым ужын, чын ыштыше-влак куанат,</para>
  <para style="q1" vid="PSA 106:42">а осалым ыштыше-шамыч умшаштым петырат.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Кӧ ушан – тидым шӱмышкыжӧ пышта</para>
  <para style="q1" vid="PSA 106:43">да Господьын порылыкшым умыла.<verse eid="PSA 106:43" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="cl">107 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 107:1" />Муро. Давидын псаломжо.<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Юмем, ямде мыйын шӱмем, [шӱмем мыйын ямде] –</para>
  <para style="q1" vid="PSA 107:2">тӱҥалам мураш, уло чонем дене Тыйым мокташ.<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />Помыжалтса, кӱсле ден арфе!</para>
  <para style="q1" vid="PSA 107:3">Мый ӱжара дене кынелам<verse eid="PSA 107:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />да Тыйым, Господь, калык-влак коклаште чапландарем,</para>
  <para style="q1" vid="PSA 107:4">тукым-шамыч коклаште моктен мурем.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Вет Тыйын порылыкет кава деч кӱшкӧ шуэш,</para>
  <para style="q1" vid="PSA 107:5">Тыйын ӱшанле улмет – пыл ора дек шумеш.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Юмем, кава деч кӱшкӧ лий нӧлталме,</para>
  <para style="q1" vid="PSA 107:6">пӱтынь мланде ӱмбалне лийже Тыйын чапет!<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Тек утлен кодыт Тыйын йӧратымет-влак.</para>
  <para style="q1" vid="PSA 107:7">Мыйым кол, пурла кидет дене утаре.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Шке святой верже гыч Юмо каласен:</para>
  <para style="q1" vid="PSA 107:8">«Сеҥымашлан куанен,</para>
  <para style="q2" vid="PSA 107:8">Сихем мландым, Сокхоф лапверым шеледен пуэм.<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />Галаад ден Манассий Мыйын улыт,</para>
  <para style="q1" vid="PSA 107:9">Ефрем – вуйыштем ӧшлӧк,</para>
  <para style="q1" vid="PSA 107:9">Иуда кучемвий тоям лиеш.<verse eid="PSA 107:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Моав – мушкылтмо атем,</para>
  <para style="q1" vid="PSA 107:10">Едом ӱмбак йолчиемем шуэм.</para>
  <para style="q1" vid="PSA 107:10">Филистим мландыште Мый куанен кычкыраш тӱҥалам».<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />Кӧ мыйым чоткыдемдыме олаш вӱден пурта,</para>
  <para style="q1" vid="PSA 107:11">Едом марте кӧ мыйым ужата?<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Вет Тый, Юмына, мемнам Шке дечет кораҥденат,</para>
  <para style="q1" vid="PSA 107:12">сарзына-влак дене пырля от лек.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Полшо мыланна сеҥаш тушманым,</para>
  <para style="q1" vid="PSA 107:13">вет айдеме полышлан ӱшан лиеш арам.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Юмо дене ме сеҥена,</para>
  <para style="q1" vid="PSA 107:14">Тудо тушманнам тошка.<verse eid="PSA 107:14" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="cl">108 ПСАЛОМ</para>
  <para style="d">Хор вуйлатышылан. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Мыйын моктымо Юмем, шып ит лий!<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Вет осал да ондалчык еҥ-влак умшаштым ӱмбакем кареныт,</para>
  <para style="q1" vid="PSA 108:2">мый денем шояк йылме дене кутырат.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Ужмышудымо мут-влакым чыла велым кышкат,</para>
  <para style="q1" vid="PSA 108:3">амал деч посна ӱмбакем кержалтыт.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Йӧратымемлан нуно мыйым титаклат,</para>
  <para style="q1" vid="PSA 108:4">а мый кумалам.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Порым ыштымемлан осал дене пӧртылтат,</para>
  <para style="q1" vid="PSA 108:5">йӧратымемлан ужмышудымаш дене тӱлат.<verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Тушманем ваштареш осал судьям шогалте,</para>
  <para style="q1" vid="PSA 108:6">а пурла велныже тек титаклыше лиеш.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Тек судышто тудо лектеш титаканыш,</para>
  <para style="q1" vid="PSA 108:7">тудын кумалмыже тек сулыклан шотлалтеш.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Илышаш кечыже кӱчык лийже,</para>
  <para style="q1" vid="PSA 108:8">тек тудын пашажым весе налеш.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Йочаж-влак кодышт тулыкеш,</para>
  <para style="q1" vid="PSA 108:9">ватыжат тек тулыкеш кодеш.<verse eid="PSA 108:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Перныл коштшо, кӱчызӧ лийышт йочаж-влак,</para>
  <para style="q1" vid="PSA 108:10">шаланен пытыше суртышт деч тораште тек нуно йодышт коштыт.<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Кӱсын пуышо еҥ тудын мо улыжым чыла поген налже,</para>
  <para style="q1" vid="PSA 108:11">йот еҥ-влак тудын погыжым агышт.<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Нигӧ тудын деке поро ынже лий,</para>
  <para style="q1" vid="PSA 108:12">тулык йочаж-влакым нигӧ ынже чамане.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Пытыже тудын тукымжо,</para>
  <para style="q1" vid="PSA 108:13">лӱмжӧ вес тукымыштак йомжо.<verse eid="PSA 108:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 108:14" />Тек шарналта Господь ача-кочаж-влакын осал пашаштым,</para>
  <para style="q2" vid="PSA 108:14">аважын сулыкшым ок мондо.<verse eid="PSA 108:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 108:15" />Тек сулыкышт эре Господь шинча ончылно лиеш,</para>
  <para style="q1" vid="PSA 108:15">а тиде тукым нерген шарнымашым</para>
  <para style="q2" vid="PSA 108:15">тек Тудо мландымбач ӱштыл кудалта.<verse eid="PSA 108:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 108:16" />Вет тиде еҥ порылыкым ончыкташ шонен огыл,</para>
  <para style="q1" vid="PSA 108:16">йорло ден незерым поктылын,</para>
  <para style="q1" vid="PSA 108:16">ойган еҥым пушташ шонен.<verse eid="PSA 108:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 108:17" />Йӧратен тудо каргымашым –</para>
  <para style="q1" vid="PSA 108:17">шкенжын ӱмбакшак каргымаш толеш,</para>
  <para style="q1" vid="PSA 108:17">келшен огыл тудлан суапландарымаш –</para>
  <para style="q1" vid="PSA 108:17">тудо ты еҥ деч тораште лиеш.<verse eid="PSA 108:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 108:18" />Тек каргымаш тудын вургемже лиеш,</para>
  <para style="q1" vid="PSA 108:18">вӱд семын кӧргышкыжӧ пура,</para>
  <para style="q1" vid="PSA 108:18">ӱй гае лулегышкыже вита.<verse eid="PSA 108:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 108:19" />Тек каргымаш эре чийыме вургемже,</para>
  <para style="q2" vid="PSA 108:19">кажне кечын ӱшталме ӱштыжӧ лиеш.<verse eid="PSA 108:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 108:20" />Тыге пӧртылтыжӧ Господь мыйым титаклыше,</para>
  <para style="q1" vid="PSA 108:20">мыйын ӱмбакем осалым ойлышо-влаклан!<verse eid="PSA 108:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 108:21" />Но мыйын верч, Господь Юмем, шке лӱметлан кӧра шогал,</para>
  <para style="q1" vid="PSA 108:21">вет Тыйын порылыкет кугу – мыйым утаре.<verse eid="PSA 108:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 108:22" />Мый йорло да незер улам,</para>
  <para style="q1" vid="PSA 108:22">шӱмемым сусыртеныт.<verse eid="PSA 108:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 108:23" />Мый кас ӱмыл гай йомам,</para>
  <para style="q1" vid="PSA 108:23">пуйто шурнышырчыкым мыйым налын кудалтат.<verse eid="PSA 108:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 108:24" />Пӱтым кучымо деч чытыра пулвуем,</para>
  <para style="q1" vid="PSA 108:24">капем пеш чот явыген.<verse eid="PSA 108:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 108:25" />Еҥ-влаклан лийынам мый мыскылтыш:</para>
  <para style="q1" vid="PSA 108:25">мыйым ужын, нуно вуйыштым рӱзат.<verse eid="PSA 108:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 108:26" />Полшо мыланем, Господь Юмем,</para>
  <para style="q1" vid="PSA 108:26">шке порылыкетлан кӧра мыйым утаре:<verse eid="PSA 108:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 108:27" />тек палат – тиде Тыйын кидет,</para>
  <para style="q2" vid="PSA 108:27">чыла тидым, Господь, Тый ыштенат.<verse eid="PSA 108:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 108:28" />Тек нуно каргат, а Тый суапландаре,</para>
  <para style="q1" vid="PSA 108:28">ваштареш шогалмышт нунылан тек вожылмашыш савырна,</para>
  <para style="q1" vid="PSA 108:28">а Тыйын тарзет тек куана.<verse eid="PSA 108:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 108:29" />Титаклышем-влак намыс дене леведалтышт,</para>
  <para style="q1" vid="PSA 108:29">вожылмаш тек нунын вургемышт лиеш.<verse eid="PSA 108:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 108:30" />А мый Господьым чот мокташ тӱҥалам,</para>
  <para style="q1" vid="PSA 108:30">шуко еҥ коклаште Тудым чапландарем.<verse eid="PSA 108:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 108:31" />Вет Тудо незер еҥын пурла могырыштыжо шога,</para>
  <para style="q1" vid="PSA 108:31">пушташ шонен судитлыше-влак дечын тудым утара.<verse eid="PSA 108:31" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="cl">109 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Господь мыйын Господемлан каласен:</para>
  <para style="q1" vid="PSA 109:1">тушманет-влакым йол йымакет пыштымешкем,</para>
  <para style="q1" vid="PSA 109:1">пурла велыштем шинче.<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Господь Тылат Сион гыч кучемвий тоям кучыкта,</para>
  <para style="q1" vid="PSA 109:2">тушман-влакет коклаште озалане!<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Вий-куатетым ончыктымо кечын</para>
  <para style="q1" vid="PSA 109:3">Тыйын калыкет шке святой сӧраллыкше дене</para>
  <para style="q2" vid="PSA 109:3">Тыйын почешет каяш ямде.</para>
  <para style="q1" vid="PSA 109:3">Эр ӱжара гыч лекше лупс семын Мый Тыйым шочыктенам.<note caller="*" style="f"><char style="fr" closed="false">109:3 </char><char style="ft" closed="false">Еврей текстыште тыште мом возымым умылаш неле.</char></note><verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Господь товатлен да тидлан ок ӧкынӧ:</para>
  <para style="q1" vid="PSA 109:4">«Мелхиседекын иерей радамже дене Тый курымашлык иерей улат».<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Господь Тыйын пурла могырыштет.</para>
  <para style="q1" vid="PSA 109:5">Шыде кечынже Тудо кугыжа-влакым пытара,<verse eid="PSA 109:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />калык-шамычлан судым ышта,</para>
  <para style="q1" vid="PSA 109:6">колышо кап дене мландым тема,</para>
  <para style="q1" vid="PSA 109:6">мландымбалне чыла вере вуй-влакым шалата.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Тудо корно воктенысе вӱдйогын гыч йӱэш</para>
  <para style="q1" vid="PSA 109:7">да вуйжым кӱшкӧ нӧлталеш.<verse eid="PSA 109:7" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="cl">110 ПСАЛОМ</para>
  <para style="d">Аллилуия.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />Уло шӱмем дене, Господь, Тыйым моктем,</para>
  <para style="q1" vid="PSA 110:1">чын ыштыше-влак коклаште, погынымаште чаплем.<verse eid="PSA 110:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />Кугу улыт Господьын пашаже-влак,</para>
  <para style="q1" vid="PSA 110:2">кӧ нуным йӧрата, нунын нерген эре шонкала.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Тудын пашаже чапле, кӱдыратле,</para>
  <para style="q1" vid="PSA 110:3">чынлыкше Тудын курымеш.<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />Мондаш лийдыме улыт Тудын ӧрыктарыше пашаж-влак,</para>
  <para style="q1" vid="PSA 110:4">Господь поро да чаманыше улеш.<verse eid="PSA 110:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />Туддеч лӱдшӧ-влаклан Тудо кочкышым пуа,</para>
  <para style="q1" vid="PSA 110:5">шке ойпидышыжым курымеш шарна.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Шке пашажын куатшым Тудо шке калыкшылан ончыктен,</para>
  <para style="q1" vid="PSA 110:6">йот калык-влакын мландыштым тудлан пуэн.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Тудын кидшын пашаже ӱшанле да чынле,</para>
  <para style="q1" vid="PSA 110:7">чыла кӱштымашыже вашталтдыме,<verse eid="PSA 110:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 110:8" />курым-курымешлан пеҥгыдемдыме улыт,</para>
  <para style="q1" vid="PSA 110:8">негызышт нунын – чын ден кере.<verse eid="PSA 110:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 110:9" />Тудо шке калыкшылан утарымашым колтен,</para>
  <para style="q1" vid="PSA 110:9">шке ойпидышыжым курымешлан пеҥгыдемден.</para>
  <para style="q1" vid="PSA 110:9">Лӱмжӧ Тудын святой, лӱдмашым лукшо!<verse eid="PSA 110:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 110:10" />Мунлылыкын тӱҥалтышыже – Господь деч лӱдмаш,</para>
  <para style="q1" vid="PSA 110:10">Тудын кӱштымыжым шуктышо еҥ шонен моштышо.</para>
  <para style="q1" vid="PSA 110:10">Мокташ тӱҥалыт Тудым курымеш!<verse eid="PSA 110:10" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="cl">111 ПСАЛОМ</para>
  <para style="d">Аллилуия.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Пиалан тудо еҥ, кӧ Господь деч лӱдеш</para>
  <para style="q1" vid="PSA 111:1">да Тудын кӱштымашыже-влакым чот йӧрата!<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Тудын урлыкшо мландымбалне виян лиеш,</para>
  <para style="q1" vid="PSA 111:2">чын ыштыше тукым суапландаралтеш.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Тудын пӧртыштыжӧ – перке ден поянлык,</para>
  <para style="q1" vid="PSA 111:3">тудын чынлыкше курым-курымеш.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Чын ыштыше еҥлан пычкемыште волгыдо лектеш,</para>
  <para style="q1" vid="PSA 111:4">вет тудо поро, чын да чаманыше.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Поро еҥ чамана да кӱсын пуа,</para>
  <para style="q1" vid="PSA 111:5">чыла пашаже тудын чынле.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Тудо курымеш пеҥгыдын шога,</para>
  <para style="q1" vid="PSA 111:6">чын ыштышым эре шарнаш тӱҥалыт.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Уда увер деч тудо ок лӱд,</para>
  <para style="q1" vid="PSA 111:7">шӱм-чонжо Господьлан чот инана.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Тудо ок лӱд, огеш тургыжлане,</para>
  <para style="q1" vid="PSA 111:8">тушманжын сеҥалтмыжым ужеш.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Тудо шеледа, йорло-влаклан пуа,</para>
  <para style="q1" vid="PSA 111:9">чын ыштымыже курым-курымешлан кодеш,</para>
  <para style="q1" vid="PSA 111:9">тудын тӱкыжӧ чапланен нӧлталтеш.<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Тидым ужын, сулыкан еҥ шыдешка,</para>
  <para style="q1" vid="PSA 111:10">пӱйжым пуреш да мерчен пыта.</para>
  <para style="q1" vid="PSA 111:10">Осал еҥын шонымыжо ок шукталт.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="cl">112 ПСАЛОМ</para>
  <para style="d">Аллилуия.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Моктыза, Господьын тарзыже-влак,</para>
  <para style="q1" vid="PSA 112:1">Господьын лӱмжым моктыза!<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Моктымо лийже Господьын лӱмжӧ</para>
  <para style="q2" vid="PSA 112:2">кызыт да курым-курымеш!<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Эрвел гыч касвел марте</para>
  <para style="q2" vid="PSA 112:3">Господьын лӱмжӧ чаплыме лийже!<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Господь чыла калык деч кӱшнӧ,</para>
  <para style="q1" vid="PSA 112:4">Тудын чапше кава деч кӱшнӧ.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Кӧ уло Господь Юмына гай?</para>
  <para style="q1" vid="PSA 112:5">Кӱшнӧ Тудо шинча,<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />кава ден мландым ончалашлан лап лиеш.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Пурак гыч Тудо йорлым нӧлталеш,</para>
  <para style="q1" vid="PSA 112:7">лавыра гыч незерым луктеш,<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />тудым он-влак коклашке,</para>
  <para style="q2" vid="PSA 112:8">шке калыкшын онжо-влак коклаш, шында.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />Азам ыштен кертдыме ӱдырамашым</para>
  <para style="q2" vid="PSA 112:9">суртыштыжо пиалан авам ышта.</para>
  <para style="q1" vid="PSA 112:9">Аллилуия!<verse eid="PSA 112:9" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="cl">113 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Кунам Израиль Египет гыч,</para>
  <para style="q1" vid="PSA 113:1">Иаковын тукымжо йот калык кокла гыч лектын,<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Иуда Тудын святой тукымжо,</para>
  <para style="q2" vid="PSA 113:2">Израиль Тудын озаланыме калыкше лийын.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Тидым ужын, теҥыз чакнен,</para>
  <para style="q1" vid="PSA 113:3">Иордан эҥер мӧҥгеш савырнен.<verse eid="PSA 113:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Лӱдмышт дене курык-влак тага семын,</para>
  <para style="q2" vid="PSA 113:4">чоҥгата-влак пача семын тӧрштылыныт.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Мо лие тый денет, теҥыз, молан чакнышыч,</para>
  <para style="q1" vid="PSA 113:5">да [тый денет], Иордан – молан мӧҥгеш савырнышыч?<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />Курык-влак, молан те тага семын</para>
  <para style="q2" vid="PSA 113:6">да те, чоҥгата-влак, пача семын тӧрштылыда?<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Чытыре, мланде, Господь чурий ончылно,</para>
  <para style="q1" vid="PSA 113:7">Иаковын Юмыжын чурийже ончылно,<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />вет кӱ курыкым Тудо ерыш,</para>
  <para style="q2" vid="PSA 113:8">кӱм памашыш савыра.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Мыланна огыл, Господь, мыланна огыл,</para>
  <para style="q2" vid="PSA 113:9">а Тыйын лӱметлан чап лийже,</para>
  <para style="q1" vid="PSA 113:9">Тыйын порылыкетлан, Тыйын ӱшанле улметлан кӧра.<verse eid="PSA 113:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 113:10" />Ынышт ойло йот калык-влак:</para>
  <para style="q1" vid="PSA 113:10">«Кушто нунын Юмышт?»<verse eid="PSA 113:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 113:11" />Мемнан Юмына – пылпомышто [да мландыште],</para>
  <para style="q1" vid="PSA 113:11">мом шона, Тудо чыла ышта.<verse eid="PSA 113:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 113:12" />А нунын шояк юмышт ший да шӧртньӧ дене ыштыме,</para>
  <para style="q1" vid="PSA 113:12">айдеме кидын пашаже улыт.<verse eid="PSA 113:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 113:13" />Уло нунын умшашт, но огыт ойло,</para>
  <para style="q1" vid="PSA 113:13">уло шинчашт, но огыт уж.<verse eid="PSA 113:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 113:14" />Уло нунын пылышышт, но огыт кол,</para>
  <para style="q1" vid="PSA 113:14">уло неррожышт, но ӱпшым огыт шиж.<verse eid="PSA 113:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 113:15" />Уло нунын кидышт, но уке кидшӱмышт,</para>
  <para style="q1" vid="PSA 113:15">уло йолышт, но огыт кошт,</para>
  <para style="q1" vid="PSA 113:15">да логарышт гыч нимогай йӱк ок лек.<verse eid="PSA 113:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 113:16" />Нуным ыштыше да нунылан ӱшаныше-влак</para>
  <para style="q2" vid="PSA 113:16">тек шкештат нунын гаяк лийыт!<verse eid="PSA 113:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 113:17" />Израиль [тукым], Господьлан инанен иле:</para>
  <para style="q1" vid="PSA 113:17">Тудо мыланна полыш да авыртыш.<verse eid="PSA 113:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 113:18" />Аарон тукым, Господьлан инанен иле:</para>
  <para style="q1" vid="PSA 113:18">Тудо мыланна полыш да авыртыш.<verse eid="PSA 113:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 113:19" />Господь деч лӱдшӧ-влак, Господьлан инанен илыза:</para>
  <para style="q1" vid="PSA 113:19">Тудо мыланна полыш да авыртыш.<verse eid="PSA 113:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 113:20" />Господь шарна да суапландара мемнам,</para>
  <para style="q1" vid="PSA 113:20">суапландара Израиль тукымым,</para>
  <para style="q1" vid="PSA 113:20">суапландара Аарон тукымым.<verse eid="PSA 113:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 113:21" />Суапландара Господь Тудын деч лӱдшӧ-влакым:</para>
  <para style="q1" vid="PSA 113:21">изижымат, кугужымат.<verse eid="PSA 113:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 113:22" />Тек Господь тендам шукемда:</para>
  <para style="q1" vid="PSA 113:22">тендам да йочада-влакым.<verse eid="PSA 113:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 113:23" />Суапландара тендам Господь,</para>
  <para style="q1" vid="PSA 113:23">кавам да мландым Ыштыше.<verse eid="PSA 113:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 113:24" />Кава – Господьын,</para>
  <para style="q1" vid="PSA 113:24">а мландым Тудо айдеме эрге-шамычлан пуэн.<verse eid="PSA 113:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 113:25" />Колышо-влак, шӱгарысе тып-тымыкыш волышо-влак</para>
  <para style="q2" vid="PSA 113:25">Господьым огыт мокто,<verse eid="PSA 113:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 113:26" />а ме, [илыше-влак,] чапландарена Господьым</para>
  <para style="q2" vid="PSA 113:26">кызыт да курым-курымеш. Аллилуия!<verse eid="PSA 113:26" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="cl">114 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Господьым мый йӧратем,</para>
  <para style="q1" vid="PSA 114:1">колеш Тудо йӱкем, мыйын кумалмем,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />савыра шке пылышыжым мый декем –</para>
  <para style="q1" vid="PSA 114:2">чыла илыме кечыштем Тудым ӱжын кумалам.<verse eid="PSA 114:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Колымашын кепшылже мыйым пидын,</para>
  <para style="q1" vid="PSA 114:3">вес тӱнясе шучкылык мыйым авалтен,</para>
  <para style="q1" vid="PSA 114:3">пален налынам мый ойго ден орлыкым.<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Тунам Господьын лӱмжым ӱжын кумальым:</para>
  <para style="q1" vid="PSA 114:4">«О, Господь, утаре чонем!»<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Господь чаманыше да чынле,</para>
  <para style="q1" vid="PSA 114:5">поро мемнан Юмына.<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Арала Господь полышдымо еҥ-влакым:</para>
  <para style="q1" vid="PSA 114:6">кунам ӱнардыме лийым, Тудо мыйым утарыш.<verse eid="PSA 114:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Чонем, угыч лыплане,</para>
  <para style="q1" vid="PSA 114:7">вет Господь тылат порылыкым ыштыш.<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />Тый утарышыч чонем колымаш деч,</para>
  <para style="q1" vid="PSA 114:8">шинчам – шинчавӱд деч</para>
  <para style="q1" vid="PSA 114:8">да йолем – шӱртньымаш деч.</para>
  <para style="q1" vid="PSA 114:8">Мый илыше-влакын мландыштышт</para>
  <para style="q2" vid="PSA 114:8">Господь чурий ончылно кошташ тӱҥалам.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="cl">115 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Мый ӱшаненам, садлан ойленам.</para>
  <para style="q1" vid="PSA 115:1">Мый ойгыш логалнам,<verse eid="PSA 115:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />чот тургыжланымем дене каласенам:</para>
  <para style="q1" vid="PSA 115:2">«Кажне айдеме – шояче».<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Господьын мылам ыштыме чыла порылыкшылан</para>
  <para style="q2" vid="PSA 115:3">Тудлан мо дене тӱлем?<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Утарымаш чашым нӧлталам</para>
  <para style="q1" vid="PSA 115:4">да Господьын лӱмжым ӱжын кумалам,<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Тудын калыкшын шинча ончылныжо</para>
  <para style="q2" vid="PSA 115:5">Господьлан сӧрымем шуктем.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Шке ӱшанле еҥже-влакын колымышт</para>
  <para style="q2" vid="PSA 115:6">Господьын шинча ончылныжо шергакан.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Господь, мый Тыйын тарзет улам,</para>
  <para style="q1" vid="PSA 115:7">улам тарзет, Тыйын ӱдырамаш тарзетын эргыже,</para>
  <para style="q1" vid="PSA 115:7">Тый мыйын кепшылем руденат.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Моктымаш надырым Тылат кондем,</para>
  <para style="q1" vid="PSA 115:8">Господьын лӱмжым ӱжын кумалам.<verse eid="PSA 115:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Господьлан сӧрымем шуктем</para>
  <para style="q1" vid="PSA 115:9">Тудын калыкшын шинча ончылныжо,<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Господьын пӧртшын кудывечылаштыже,</para>
  <para style="q1" vid="PSA 115:10">тыйын покшелнет, Иерусалим! Аллилуия!<verse eid="PSA 115:10" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="cl">116 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Чыла калык-влак, Господьым моктыза,</para>
  <para style="q1" vid="PSA 116:1">чыла тукым-влак, Тудым чаплыза!<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Вет Тудын порылыкшо мемнан дек пеш кугу,</para>
  <para style="q1" vid="PSA 116:2">Господьын ӱшанле улмыжо курымешлан. Аллилуия!<verse eid="PSA 116:2" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="cl">117 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Моктыза Господьым – Тудо поро,</para>
  <para style="q1" vid="PSA 117:1">порылыкшо Тудын курымеш.<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Тек Израиль тукым каласа:</para>
  <para style="q1" vid="PSA 117:2">[Тудо поро,] порылыкшо Тудын курымеш.<verse eid="PSA 117:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 117:3" />Тек Аарон тукым каласа:</para>
  <para style="q1" vid="PSA 117:3">[Тудо поро,] порылыкшо Тудын курымеш.<verse eid="PSA 117:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 117:4" />Господь деч лӱдшӧ-влак каласышт:</para>
  <para style="q1" vid="PSA 117:4">[Тудо поро,] порылыкшо Тудын курымеш.<verse eid="PSA 117:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 117:5" />Чонлан шыгыр лийме годым Господьым ӱжынам,</para>
  <para style="q1" vid="PSA 117:5">Тудо мыйым колын да йоҥгыдо верыш луктын.<verse eid="PSA 117:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 117:6" />Господь – мыйын велне, сандене ом лӱд,</para>
  <para style="q1" vid="PSA 117:6">мом ыштен кертеш мылам айдеме?<verse eid="PSA 117:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 117:7" />Господь полша мыланем –</para>
  <para style="q1" vid="PSA 117:7">сеҥалтше тушманем-влак ӱмбаке мый ончем.<verse eid="PSA 117:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 117:8" />Айдемылан ӱшанымеш</para>
  <para style="q2" vid="PSA 117:8">Господьлан инанен илаш сайрак.<verse eid="PSA 117:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 117:9" />Тӧра-влаклан ӱшанымеш</para>
  <para style="q2" vid="PSA 117:9">Господьлан инанен илаш сайрак.<verse eid="PSA 117:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 117:10" />Чыла калык-влак авырышт мыйым,</para>
  <para style="q1" vid="PSA 117:10">но Господьын лӱмжӧ дене нуным сӱмырал шуышым.<verse eid="PSA 117:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 117:11" />Чыла могырым авырен нальыч мыйым,</para>
  <para style="q1" vid="PSA 117:11">но Господьын лӱмжӧ дене нуным сӱмырал шуышым.<verse eid="PSA 117:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 117:12" />Авырен нальыч мыйым мӱкш еш семын,</para>
  <para style="q1" vid="PSA 117:12">но шуанвондышто йӱлышӧ тул семын писын йӧрышт –</para>
  <para style="q1" vid="PSA 117:12">Господьын лӱмжӧ дене нуным сӱмырал шуышым.<verse eid="PSA 117:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 117:13" />Мыйым йӧрыкташ манын, чот шӱкал колтышт,</para>
  <para style="q1" vid="PSA 117:13">но Господь мылам эҥертыш лие.<verse eid="PSA 117:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 117:14" />Господь – мыйын вием да моктымо мурем,</para>
  <para style="q1" vid="PSA 117:14">Тудо лие мыйын утарымашем.<verse eid="PSA 117:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 117:15" />Чын ыштыше-влакын омашыштышт</para>
  <para style="q2" vid="PSA 117:15">утарымашлан куаныме йӱк шокта:</para>
  <para style="q1" vid="PSA 117:15">Господьын пурла кидше шке куатшым ончыкта!<verse eid="PSA 117:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 117:16" />Господьын пурла кидше кӱшнӧ,</para>
  <para style="q1" vid="PSA 117:16">Господьын кидше шке куатшым ончыкта!<verse eid="PSA 117:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 117:17" />Мый ом коло, илаш тӱҥалам</para>
  <para style="q1" vid="PSA 117:17">да Господьын пашаж-влак нерген каласкалем.<verse eid="PSA 117:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 117:18" />Чот наказатлыш мыйым Господь,</para>
  <para style="q1" vid="PSA 117:18">но колымашлан ыш пу.<verse eid="PSA 117:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 117:19" />Почса мылам чынлыкын капкажым –</para>
  <para style="q1" vid="PSA 117:19">мый тудын гоч пурем да Господьым чаплем.<verse eid="PSA 117:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 117:20" />Теве Господьын капкаже,</para>
  <para style="q1" vid="PSA 117:20">чын ыштыше-влак тудын гоч пурат.<verse eid="PSA 117:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 117:21" />Тыйым чаплем, вет Тый мыйым колынат</para>
  <para style="q1" vid="PSA 117:21">да мыйын утарымашем лийынат.<verse eid="PSA 117:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 117:22" />Чоҥышо-влакын йӧрдымыш лукмо кӱышт</para>
  <para style="q2" vid="PSA 117:22">негыз пусак кӱ лийын:<verse eid="PSA 117:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 117:23" />тидыже – Господь деч,</para>
  <para style="q1" vid="PSA 117:23">мемнан шинча ончылно моткоч ӧрыктарыше.<verse eid="PSA 117:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 117:24" />Тиде кечым Господь ыштен:</para>
  <para style="q1" vid="PSA 117:24">куанен йывыртена тудлан!<verse eid="PSA 117:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 117:25" />О, Господь, утаре! О, Господь, сеҥаш полшо!<verse eid="PSA 117:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 117:26" />Господьын лӱмжӧ дене толшылан тек суап лиеш!</para>
  <para style="q1" vid="PSA 117:26">Господьын пӧртшӧ гыч тыланда суапым тыланена.<verse eid="PSA 117:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 117:27" />Юмо – Господь, Тудо мемнам волгалтарен.</para>
  <para style="q1" vid="PSA 117:27">Вуйшӱдыш дене пайремым эртарыза,</para>
  <para style="q1" vid="PSA 117:27">жертвенникын тӱкыж-влак деке погыныза.<verse eid="PSA 117:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 117:28" />Тый мыйын Юмем улат, мый Тыйым чаплем,</para>
  <para style="q1" vid="PSA 117:28">Юмем, мый Тыйым моктем.</para>
  <para style="q1" vid="PSA 117:28">[Тыйым чаплем, вет мыйым колынат</para>
  <para style="q1" vid="PSA 117:28">да мыйын утарымашем лийынат.]<verse eid="PSA 117:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 117:29" />Моктыза Господьым – Тудо поро,</para>
  <para style="q1" vid="PSA 117:29">порылыкшо Тудын курымеш!<verse eid="PSA 117:29" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="cl">118 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Пиалан улыт чын корным тошкышо-влак,</para>
  <para style="q1" vid="PSA 118:1">Господьын законжо почеш илыше-влак.<verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Пиалан улыт Тудын сугыньжым шуктен шогышо-шамыч,</para>
  <para style="q1" vid="PSA 118:2">Тудым уло чон дене кычалше-шамыч.<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Нуно осал пашам огыт ыште,</para>
  <para style="q1" vid="PSA 118:3">Господьын корныж дене коштыт.<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Тый Шке шӱдымаш-влакетым тӱткын шуктен шогаш кӱштенат.<verse eid="PSA 118:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />О, мылам тура корно дене каяш ыле,</para>
  <para style="q1" vid="PSA 118:5">Тыйын пунчалет-влакым шуктен шогаш ыле!<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />Тунам, кӱштымаш-влакетым ушыштем кучен,</para>
  <para style="q1" vid="PSA 118:6">вожылмашыш мый ом пуро.<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />Ару шӱм-чон дене Тыйым моктем,</para>
  <para style="q1" vid="PSA 118:7">Тыйын чын уставет-влаклан тунемам.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Пунчал-влакетым мый шукташ тӱҥалам,</para>
  <para style="q1" vid="PSA 118:8">ит кодо мыйым йӧршешлан.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Кузе рвезыеҥлан шке корныжым арулыкышто кучаш? –</para>
  <para style="q1" vid="PSA 118:9">Тыйын шомакетым шуктен шогымо дене.<verse eid="PSA 118:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Уло шӱмем дене Тыйым кычалам,</para>
  <para style="q1" vid="PSA 118:10">ит пу мылам кӱштымаш-влакет деч кораҥаш.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Ончылнет сулыкым ышташ огыл манын,</para>
  <para style="q1" vid="PSA 118:11">Тыйын шомакетым шӱмыштем аралем.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Моктымо улат Тый, Господь!</para>
  <para style="q1" vid="PSA 118:12">Пунчал-влакетлан мыйым туныкто.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Тыйын умшат гыч лекше устав-влакым</para>
  <para style="q2" vid="PSA 118:13">мыйын йылмем увертара.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />Сугынь-влакетым шуктен илымылан</para>
  <para style="q2" vid="PSA 118:14">мый поянлыклан куаныме семын йывыртем.<verse eid="PSA 118:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Тыйын шӱдымашет-влак нерген шонкалем,</para>
  <para style="q1" vid="PSA 118:15">Тыйын корнет-влакым ончем.<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />Пунчалет-влак мыйым лыпландарат,</para>
  <para style="q1" vid="PSA 118:16">Тыйын шомакетым мый ом мондо.<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Шке тарзетлан порылыкетым ончыкто –</para>
  <para style="q1" vid="PSA 118:17">тунам мый умбакыжат илем, Тыйын шомакет шуктем.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />Поч мыйын шинчам,</para>
  <para style="q1" vid="PSA 118:18">тунам законетын ӧрыктарыше чынже-влакым ужам.<verse eid="PSA 118:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Мландымбалне мый жаплан толшо гына улам –</para>
  <para style="q1" vid="PSA 118:19">кӱштымаш-влакетым мый дечем ит шылте.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Устав-влакетым палаш шонен,</para>
  <para style="q1" vid="PSA 118:20">мый чон улнен йокрокланем.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Кугешныше-шамычым Тый шылталенат–</para>
  <para style="q1" vid="PSA 118:21">нуно каргыме улыт,</para>
  <para style="q1" vid="PSA 118:21">кӱштымаш-влакет деч кораҥыныт.<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Намыс ден шӱктарымашым мый дечем кораҥде,</para>
  <para style="q1" vid="PSA 118:22">вет Тыйын сугынет-влакым мый шуктен шогем.<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Тӧра-шамыч шинчат да мыйын ваштареш каҥашен кутырат,</para>
  <para style="q1" vid="PSA 118:23">а Тыйын тарзет пунчалет-влак нерген шонкала.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Тыйын сугынет-влак – мыланем куан,</para>
  <para style="q1" vid="PSA 118:24">[пунчалет-влак улыт] ойым пуышо.<verse eid="PSA 118:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />Мыйын чонем пуракыште кия,</para>
  <para style="q1" vid="PSA 118:25">шке мутет почеш мыйым иландаре.<verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Шке корнем-влак нерген Тылат ойленам –</para>
  <para style="q1" vid="PSA 118:26">Тый мыйым колынат.</para>
  <para style="q1" vid="PSA 118:26">Туныкто мыйым шке пунчалет-влаклан!<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />Полшо умылаш шӱдымаш-влакетын корныштым,</para>
  <para style="q1" vid="PSA 118:27">да ӧрыктарыше пашат-влак нерген шонкалаш тӱҥалам.<verse eid="PSA 118:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Чонемже ойгырен шортеш –</para>
  <para style="q1" vid="PSA 118:28">шке мутет дене мыйым пеҥгыдемде.<verse eid="PSA 118:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Шояк корным мый дечем кораҥде,</para>
  <para style="q1" vid="PSA 118:29">порылыкет дене мыйым законетлан туныкто.<verse eid="PSA 118:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 118:30" />Ойырен налынам мый чынлык корным,</para>
  <para style="q1" vid="PSA 118:30">Тыйын уставет-влак эре шинча ончылнем улыт.<verse eid="PSA 118:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 118:31" />Сугынет-шамычым, Господь, мый шӱмыштем ашнем –</para>
  <para style="q1" vid="PSA 118:31">ит пурто мыйым вожылмашыш.<verse eid="PSA 118:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 118:32" />Куржам мый кӱштымаш-влакетын корнышт дене,</para>
  <para style="q1" vid="PSA 118:32">Тый мыйын умылымашем кумдаҥдет.<verse eid="PSA 118:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 118:33" />Ончыкто мылам, Господь, пунчал-влакетын корныштым,</para>
  <para style="q1" vid="PSA 118:33">мый тудын дене мучаш марте каем.<verse eid="PSA 118:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 118:34" />Пу мылам ушым – тӱҥалам законетым шукташ,</para>
  <para style="q1" vid="PSA 118:34">уло шӱмем дене тудым аралаш.<verse eid="PSA 118:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 118:35" />Шогалте мыйым кӱштымаш-влакетын йолгорнышкышт,</para>
  <para style="q1" vid="PSA 118:35">вет тушто мый куаным муам.<verse eid="PSA 118:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 118:36" />Мыйын шӱмем сутлык шонымаш дек огыл,</para>
  <para style="q2" vid="PSA 118:36">а Тыйын сугынет деке савыре.<verse eid="PSA 118:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 118:37" />Кораҥде мыйын шинчам чыла кӱлдымаш деч,</para>
  <para style="q1" vid="PSA 118:37">шке корныштет мыйым иландаре.<verse eid="PSA 118:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 118:38" />Шукто шке тарзетлан сӧрымӧ мутетым,</para>
  <para style="q1" vid="PSA 118:38">Тыйым шотлен илыше-влаклан Тый тудым пуэнат.<verse eid="PSA 118:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 118:39" />Ит пу мыланем мыскылыме лияш –</para>
  <para style="q1" vid="PSA 118:39">тидын дечын мый лӱдам.</para>
  <para style="q1" vid="PSA 118:39">Тыйын уставет-влак сай улыт.<verse eid="PSA 118:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 118:40" />Шӱдымаш-влакетым мый вучен илем,</para>
  <para style="q1" vid="PSA 118:40">шке чынлыкет дене мыйым иландаре.<verse eid="PSA 118:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 118:41" />Господь, мылам порылыкетым ончыкто,</para>
  <para style="q1" vid="PSA 118:41">сӧрымет семынак мыйым утаре.<verse eid="PSA 118:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 118:42" />Тунам мыйым шӱктарышылан пуэн кертам вашмутым,</para>
  <para style="q1" vid="PSA 118:42">вет Тыйын шомакетлан ӱшанен илем.<verse eid="PSA 118:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 118:43" />Умшам гыч чынле мутым ит кораҥде,</para>
  <para style="q1" vid="PSA 118:43">вет Тыйын уставет-влаклан ӱшанен илем.<verse eid="PSA 118:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 118:44" />Эре, курым-курымеш</para>
  <para style="q2" vid="PSA 118:44">мый Тыйын законет шуктем.<verse eid="PSA 118:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 118:45" />Эрыкан кошташ мый тӱҥалам,</para>
  <para style="q1" vid="PSA 118:45">вет шӱдымашет-влак почеш илаш тыршем.<verse eid="PSA 118:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 118:46" />Тыйын сугынет-влак нерген кугыжа-шамычлан ойлем,</para>
  <para style="q1" vid="PSA 118:46">вожылмашыш мый ом пуро.<verse eid="PSA 118:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 118:47" />Тыйын кӱштымаш-влакетлан куанем,</para>
  <para style="q1" vid="PSA 118:47">нуным мый йӧратем.<verse eid="PSA 118:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 118:48" />Кидем шуем Тыйын кӱштымаш-влакет дек,</para>
  <para style="q1" vid="PSA 118:48">нуным мый йӧратем,</para>
  <para style="q1" vid="PSA 118:48">пунчалет-влак нерген мый шонкалем.<verse eid="PSA 118:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 118:49" />Шарналте шке тарзетлан пуымо мутетым,</para>
  <para style="q1" vid="PSA 118:49">тудо шукталтеш манын, Тый мылам ӱшаным пуэнат.<verse eid="PSA 118:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 118:50" />Йӧсӧ годым тудо мыйым лыпландара,</para>
  <para style="q1" vid="PSA 118:50">Тыйын мутет мыйым иландара.<verse eid="PSA 118:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 118:51" />Кугешныше-влак мыйым чот воштылыт,</para>
  <para style="q1" vid="PSA 118:51">но мый Тыйын законет деч ом кораҥ.<verse eid="PSA 118:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 118:52" />Шарналтем Тыйын уставет-влакым, Господь,</para>
  <para style="q1" vid="PSA 118:52">Тыйын акрет устав-влакетым, да лыпланем.<verse eid="PSA 118:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 118:53" />Осал еҥ-шамычлан мый шыдешкем –</para>
  <para style="q1" vid="PSA 118:53">Тыйын законетым нуно кӱлдымыш луктыт.<verse eid="PSA 118:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 118:54" />Чыла вере, кушто йот еҥ семын илем,</para>
  <para style="q1" vid="PSA 118:54">муро гай улыт пунчалет-влак мыланем.<verse eid="PSA 118:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 118:55" />Йӱдымат, Господь, Тыйым шарнем,</para>
  <para style="q1" vid="PSA 118:55">Тыйын законетым ушыштем кучем.<verse eid="PSA 118:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 118:56" />Чыла тиде мый денем лийын,</para>
  <para style="q1" vid="PSA 118:56">вет мый шӱдымаш-влакетым шуктен шогем.<verse eid="PSA 118:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 118:57" />Господь – мылам палемдыме ужаш,</para>
  <para style="q1" vid="PSA 118:57">Тыйын шомакетым шуктен шогаш мый сӧренам.<verse eid="PSA 118:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 118:58" />Уло шӱм-чон дене Тылат кумалам:</para>
  <para style="q1" vid="PSA 118:58">каласымет семынак поро лий мый декем.<verse eid="PSA 118:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 118:59" />Коштмо корнем-влак нерген шонкалем</para>
  <para style="q1" vid="PSA 118:59">да Тыйын сугынь корнышкет шке йолем савырем.<verse eid="PSA 118:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 118:60" />Вашкем мый, ом юватыл</para>
  <para style="q2" vid="PSA 118:60">Тыйын кӱштымаш-влакетым шукташ.<verse eid="PSA 118:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 118:61" />Осал еҥ-шамычын кандырашт мыйым авырат,</para>
  <para style="q1" vid="PSA 118:61">но Тыйын законетым мый ом мондо.<verse eid="PSA 118:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 118:62" />Чын уставет-влаклан Тыйым мокташ</para>
  <para style="q2" vid="PSA 118:62">мый пелйӱдым кынелам.<verse eid="PSA 118:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 118:63" />Тый дечет лӱдшӧ да шӱдыметым шуктышо-влаклан</para>
  <para style="q2" vid="PSA 118:63">чылаштлан мый йолташ улам.<verse eid="PSA 118:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 118:64" />Тыйын порылыкет дене, Господь, мланде темын –</para>
  <para style="q1" vid="PSA 118:64">шке пунчалет-влаклан мыйым туныкто.<verse eid="PSA 118:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 118:65" />Господь, cӧрымет семынак</para>
  <para style="q2" vid="PSA 118:65">Тый шке тарзетлан сайым ыштенат.<verse eid="PSA 118:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 118:66" />Мыйым шонен мошташ туныкто, шинчымашым пу,</para>
  <para style="q1" vid="PSA 118:66">вет Тыйын кӱштымаш-влакетлан ӱшанем.<verse eid="PSA 118:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 118:67" />Орлыкым эртымешке, мый йомын коштым,</para>
  <para style="q1" vid="PSA 118:67">а кызыт Тыйын шомакет шуктен шогем.<verse eid="PSA 118:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 118:68" />Поро Тый улат, [Господь,] ыштет лач порым!</para>
  <para style="q1" vid="PSA 118:68">Шке пунчалет-влаклан мыйым туныкто.<verse eid="PSA 118:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 118:69" />Кугешныше-влак ӱмбакем шоям кышкат,</para>
  <para style="q1" vid="PSA 118:69">а мый уло шӱмем дене шӱдыметым шуктем.<verse eid="PSA 118:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 118:70" />Нунын шӱмышт кӱжгемын,</para>
  <para style="q1" vid="PSA 118:70">а мый Тыйын законетлан куанем.<verse eid="PSA 118:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 118:71" />Орлыкем мылам сайыш савырнен –</para>
  <para style="q1" vid="PSA 118:71">пунчал-влакетым мый тунемынам.<verse eid="PSA 118:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 118:72" />Тыйын умшат гыч лекше закон мыланем</para>
  <para style="q2" vid="PSA 118:72">пеш шуко шӧртньӧ ден ший деч шергырак.<verse eid="PSA 118:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 118:73" />Тыйын кидет мыйым ыштен да калыплен:</para>
  <para style="q1" vid="PSA 118:73">пу мылам ушым – Тыйын кӱштымашет-влаклан тунемам.<verse eid="PSA 118:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 118:74" />Тый дечет лӱдшӧ-влак мыйым ужыт да куанат,</para>
  <para style="q1" vid="PSA 118:74">вет Тыйын шомакетлан мый инанен илем.<verse eid="PSA 118:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 118:75" />Палем, Господь – Тый чын судитлет,</para>
  <para style="q1" vid="PSA 118:75">Тыйын колтымо орлыкым мый суленам.<verse eid="PSA 118:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 118:76" />Тек Тыйын порылыкет мыйым лыпландара,</para>
  <para style="q1" vid="PSA 118:76">тидым Тый шке тарзетлан сӧренат.<verse eid="PSA 118:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 118:77" />Тек Тыйын чаманымашет пеленем лиеш –</para>
  <para style="q1" vid="PSA 118:77">мый умбакыжат илаш тӱҥалам,</para>
  <para style="q1" vid="PSA 118:77">Тыйын законет – мыланем куан.<verse eid="PSA 118:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 118:78" />Тек кугешныше-влак вожылмашыш пурат –</para>
  <para style="q1" vid="PSA 118:78">титакем уке ӱмбач нуно мыйым шыгыремдылыт,</para>
  <para style="q1" vid="PSA 118:78">а мый Тыйын шӱдымашет-влак нерген шонкалем.<verse eid="PSA 118:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 118:79" />Тек Тый дечет лӱдшӧ да сугынетым палыше-шамыч</para>
  <para style="q2" vid="PSA 118:79">мый декем толыт.<verse eid="PSA 118:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 118:80" />Тек шӱмем Тыйын пунчалет-влак почеш ила,</para>
  <para style="q1" vid="PSA 118:80">тунам ом пуро вожылмашыш.<verse eid="PSA 118:80" /></para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 118:81" />Утарыметым вучен, йӧслана чонем:</para>
  <para style="q1" vid="PSA 118:81">Тыйын шомакетлан инанен илем.<verse eid="PSA 118:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 118:82" />Тыйын мутетым вучен, шинчамже ноен –</para>
  <para style="q1" vid="PSA 118:82">ойлем мый: кунам пуэт мылам лыпланымашым?<verse eid="PSA 118:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 118:83" />Лийынам мый шикш деч туртын пытыше шувыш гай,</para>
  <para style="q1" vid="PSA 118:83">но Тыйын пунчал-влакетым монден омыл.<verse eid="PSA 118:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 118:84" />Мыняр жап эше Тыйын тарзетлан вучаш?</para>
  <para style="q1" vid="PSA 118:84">Мыйым поктылшо-влаклан кунам Тый судым ыштет?<verse eid="PSA 118:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 118:85" />Тыйын законетым кӱлдымыш луктын,</para>
  <para style="q1" vid="PSA 118:85">кугешныше-влак мылам вынемым кӱнченыт.<verse eid="PSA 118:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 118:86" />Тыйын чыла кӱштымашет чынле улыт.</para>
  <para style="q1" vid="PSA 118:86">Нимолан огыл мыйым поктылыт – полшо мыланем!<verse eid="PSA 118:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 118:87" />Изиш гына мыйым ышт пытаре,</para>
  <para style="q1" vid="PSA 118:87">но Тыйын шӱдымашет-влакым мый шым кодо.<verse eid="PSA 118:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 118:88" />Шке порылыкет дене арален кодо илышем –</para>
  <para style="q1" vid="PSA 118:88">Тыйын пуымо сугынетым мый шуктен шогем.<verse eid="PSA 118:88" /></para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 118:89" />Курымешлан, Господь, Тыйын шомакет каваште пеҥгыдемдыме,<verse eid="PSA 118:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 118:90" />Тыйын чынлыкет – тукым гыч тукымыш.</para>
  <para style="q1" vid="PSA 118:90">Ыштенат Тый мландым, да тудо шога.<verse eid="PSA 118:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 118:91" />Тыйын уставет почеш чылажат таче кече марте шога,</para>
  <para style="q1" vid="PSA 118:91">чылажат Тыланет служитла.<verse eid="PSA 118:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 118:92" />Тыйын законет мылам куаным ок пу ыле гын,</para>
  <para style="q1" vid="PSA 118:92">пытем ыле ойгемлан кӧра.<verse eid="PSA 118:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 118:93" />Ом мондо нигунам шӱдымаш-влакетым,</para>
  <para style="q1" vid="PSA 118:93">нунын дене Тый арален кодет илышем.<verse eid="PSA 118:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 118:94" />Тыйын мый улам – утаре мыйым,</para>
  <para style="q1" vid="PSA 118:94">вет шӱдымашет-влак почеш илаш тыршем.<verse eid="PSA 118:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 118:95" />Вучен коштыт осал еҥ-влак мыйым пушташлан,</para>
  <para style="q1" vid="PSA 118:95">а мый Тыйын сугынет нерген шонем.<verse eid="PSA 118:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 118:96" />Кеч-монат шке чекше уло – мый тидым ужынам,</para>
  <para style="q1" vid="PSA 118:96">а Тыйын кӱштымашет-влак улыт пеш кумда.<verse eid="PSA 118:96" /></para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 118:97" />Кузе мый Тыйын законетым йӧратем!</para>
  <para style="q1" vid="PSA 118:97">Кече мучко тудын нерген шонкалем.<verse eid="PSA 118:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 118:98" />Тыйын кӱштымашет-влак эре ушыштем улыт,</para>
  <para style="q1" vid="PSA 118:98">нуно мыйым чыла тушманем деч мунлыракым ыштат.<verse eid="PSA 118:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 118:99" />Ушанрак лийынам чыла туныктышем деч,</para>
  <para style="q1" vid="PSA 118:99">вет Тыйын сугынет-влак нерген мый шонкалем.<verse eid="PSA 118:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 118:100" />Ушан-шотанрак лийынам калык кугурак-шамыч дечын,</para>
  <para style="q1" vid="PSA 118:100">вет Тыйын шӱдымаш-влакетым мый шуктен шогем.<verse eid="PSA 118:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 118:101" />Нимогай осал корныш ом пу шогалаш йолемлан,</para>
  <para style="q1" vid="PSA 118:101">Тыйын шомакетым мый шуктен шогынем.<verse eid="PSA 118:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 118:102" />Ом кораҥ Тыйын уставет-влак дечын,</para>
  <para style="q1" vid="PSA 118:102">вет Тый Шкеак мыйым туныктет.<verse eid="PSA 118:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 118:103" />Могай тамле улыт мутет-влак йылмемлан,</para>
  <para style="q1" vid="PSA 118:103">умшамлан улыт мӱй деч шерырак.<verse eid="PSA 118:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 118:104" />Тыйын шӱдымашет-влак пуат мылам ушым,</para>
  <para style="q1" vid="PSA 118:104">садлан тӱрлӧ шояк корным ужмем ок шу.<verse eid="PSA 118:104" /></para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 118:105" />Тыйын шомакет – йолемлан волгыдым пуышо,</para>
  <para style="q2" vid="PSA 118:105">йолгорнемым волгалтарыше тул.<verse eid="PSA 118:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 118:106" />Мый чын устав-влакетым шуктен шогаш товатленам:</para>
  <para style="q1" vid="PSA 118:106">сӧрымемым мый шуктем.<verse eid="PSA 118:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 118:107" />Господь, мый пеш чот орланем –</para>
  <para style="q1" vid="PSA 118:107">шке мутет почеш мыйым иландаре.<verse eid="PSA 118:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 118:108" />Господь, тек Тыланет келша умшам гыч лекше шомакем –</para>
  <para style="q1" vid="PSA 118:108">тудым шке кумылын мый надырлан кондем;</para>
  <para style="q1" vid="PSA 118:108">шке устав-влакетлан мыйым туныкто.<verse eid="PSA 118:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 118:109" />Кеч илышемым лӱдыкшылык авырен шога,</para>
  <para style="q1" vid="PSA 118:109">но Тыйын законетым мый ом мондо.<verse eid="PSA 118:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 118:110" />Осал еҥ-влак мылам лӧдым шынденыт,</para>
  <para style="q1" vid="PSA 118:110">но Тыйын шӱдымет деч мый кораҥын омыл.<verse eid="PSA 118:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 118:111" />Тый дечет мый сугынь-влакым курымешлан налынам,</para>
  <para style="q1" vid="PSA 118:111">вет нуно шӱм-чонем куандарат.<verse eid="PSA 118:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 118:112" />Шонен пыштенам мый</para>
  <para style="q2" vid="PSA 118:112">Тыйын пунчалет почеш эре илаш.<verse eid="PSA 118:112" /></para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 118:113" />Тылат ӱшанле огыл-влакым ужмем огеш шу,</para>
  <para style="q1" vid="PSA 118:113">а Тыйын законетым мый йӧратем.<verse eid="PSA 118:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 118:114" />Тый мыйын авыртышем, куржын утлымо верем улат,</para>
  <para style="q1" vid="PSA 118:114">Тыйын шомакетлан инанен илем.<verse eid="PSA 118:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 118:115" />Осалым ыштыше-шамыч, мый дечем кораҥза –</para>
  <para style="q1" vid="PSA 118:115">Юмемын кӱштымашыж-влакым мый шуктен шогем.<verse eid="PSA 118:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 118:116" />Шке мутет почеш мыйым пеҥгыдемде –</para>
  <para style="q1" vid="PSA 118:116">тунам умбакыжат илаш тӱҥалам,</para>
  <para style="q1" vid="PSA 118:116">Тылат инанымылан мыйым вожылмашыш ит пурто.<verse eid="PSA 118:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 118:117" />Полшо мыланем – тунам лиям утарыме,</para>
  <para style="q1" vid="PSA 118:117">пунчал-влакетым ушыштем эре кучаш тӱҥалам.<verse eid="PSA 118:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 118:118" />Пунчал-влакет деч кораҥше-шамычым Тый поктен колтет,</para>
  <para style="q1" vid="PSA 118:118">вет нуно лач чояланен да ондален моштат.<verse eid="PSA 118:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 118:119" />Тый мландысе чыла осал еҥым куштыра семын ӱштыл кудалтет,</para>
  <para style="q1" vid="PSA 118:119">а мый Тыйын сугынетым йӧратем.<verse eid="PSA 118:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 118:120" />Тый дечет лӱдмем дене капем чытыра,</para>
  <para style="q1" vid="PSA 118:120">Тыйын суд-влакет деч мый лӱдам.<verse eid="PSA 118:120" /></para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 118:121" />Чын пашам ыштен, мый чынлын иленам –</para>
  <para style="q1" vid="PSA 118:121">ит пу мыйым поктылшо-влак кидыш.<verse eid="PSA 118:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 118:122" />Арален нал шке тарзетым, мылам сайым ыште,</para>
  <para style="q1" vid="PSA 118:122">кугешныше-влак мыйым ынышт шыгыремдыл.<verse eid="PSA 118:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 118:123" />Тыйын утарыметым, чынле мутетын шукталтмыжым вучен,</para>
  <para style="q1" vid="PSA 118:123">мыйын шинчам ноен.<verse eid="PSA 118:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 118:124" />Ончыкто тарзетлан шке порылыкетым,</para>
  <para style="q1" vid="PSA 118:124">шке пунчалет-влаклан мыйым туныкто.<verse eid="PSA 118:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 118:125" />Улам мый Тыйын тарзет, пу мылам ушым –</para>
  <para style="q1" vid="PSA 118:125">пален налам мый Тыйын сугынетым.<verse eid="PSA 118:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 118:126" />Жап шуын Господьлан шке пашажым ышташ,</para>
  <para style="q1" vid="PSA 118:126">вет Тыйын законетым кӱлдымыш луктыныт.<verse eid="PSA 118:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 118:127" />А мый Тыйын кӱштымаш-влакетым</para>
  <para style="q2" vid="PSA 118:127">шӧртньӧ деч чот, яндар шӧртньӧ деч чот йӧратем.<verse eid="PSA 118:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 118:128" />Мый чыла шӱдымашетым шуктен шогем,</para>
  <para style="q1" vid="PSA 118:128">садлан тӱрлӧ шояк корным ужмем ок шу.<verse eid="PSA 118:128" /></para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 118:129" />Ӧрмашан улыт Тыйын сугынет-влак,</para>
  <para style="q1" vid="PSA 118:129">сандене мыйын чонемлан нуно шерге улыт.<verse eid="PSA 118:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 118:130" />Шомакетым умылымаш волгыдым конда,</para>
  <para style="q1" vid="PSA 118:130">ужарвуй-влакланат ушым шында.<verse eid="PSA 118:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 118:131" />Умшам почын, нелын шӱлештам –</para>
  <para style="q1" vid="PSA 118:131">тыге мый кӱштымаш-влакетым вучем.<verse eid="PSA 118:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 118:132" />Ончал ӱмбакем да мыйым чамане,</para>
  <para style="q1" vid="PSA 118:132">вет лӱметым йӧратыше-влак дене Тый тыге ыштет.<verse eid="PSA 118:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 118:133" />Шке мутет дене ошкылем пеҥгыдемде,</para>
  <para style="q1" vid="PSA 118:133">нимогай сулыклан мыйым ит пу сеҥаш.<verse eid="PSA 118:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 118:134" />Утаре мыйым айдеме шыгыремдымаш деч,</para>
  <para style="q1" vid="PSA 118:134">тунам Тыйын шӱдымаш-влакетым шуктем.<verse eid="PSA 118:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 118:135" />Шке чуриетын волгыдыж дене тарзетым волгалтаре</para>
  <para style="q1" vid="PSA 118:135">да шке пунчал-влакетлан мыйым туныкто.<verse eid="PSA 118:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 118:136" />Еҥ-влак Тыйын законетым огыт шукто,</para>
  <para style="q1" vid="PSA 118:136">садлан шинчам гыч вӱд чот йога.<verse eid="PSA 118:136" /></para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 118:137" />Тый чын ыштыше улат, Господь,</para>
  <para style="q1" vid="PSA 118:137">чынле улыт Тыйын уставет-влак.<verse eid="PSA 118:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 118:138" />Тыйын пуымо сугынет-влак</para>
  <para style="q2" vid="PSA 118:138">чын деч чын улыт.<verse eid="PSA 118:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 118:139" />Монденыт тушманем-влак Тыйын шомакетым –</para>
  <para style="q1" vid="PSA 118:139">тиде мыйын чонем йӱлалта.<verse eid="PSA 118:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 118:140" />Тыйын шомакет пеш яндар,</para>
  <para style="q1" vid="PSA 118:140">Тыйын тарзет тудым йӧрата.<verse eid="PSA 118:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 118:141" />Мыйым изиэш ужыт, огыт шотло,</para>
  <para style="q1" vid="PSA 118:141">но Тыйын шӱдымаш-влакетым мый ом мондо.<verse eid="PSA 118:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 118:142" />Тыйын чынлыкет курымашле,</para>
  <para style="q1" vid="PSA 118:142">Тыйын законет чынле.<verse eid="PSA 118:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 118:143" />Йӧсланымаш ден ойго мыйым авалтеныт,</para>
  <para style="q1" vid="PSA 118:143">но кӱштымаш-влакет мылам куаным кондат.<verse eid="PSA 118:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 118:144" />Сугынет-влак курымеш чынле улыт:</para>
  <para style="q1" vid="PSA 118:144">пу ушым мылам, да мый умбакыжат илаш тӱҥалам.<verse eid="PSA 118:144" /></para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 118:145" />Уло шӱмем дене ӱжын кумалам:</para>
  <para style="q1" vid="PSA 118:145">кол мыйым, Господь –</para>
  <para style="q1" vid="PSA 118:145">пунчал-влакетым мый шуктен шогем.<verse eid="PSA 118:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 118:146" />Тыйым ӱжам – мыйым утаре,</para>
  <para style="q1" vid="PSA 118:146">тунам Тыйын сугынетым шукташ тӱҥалам.<verse eid="PSA 118:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 118:147" />Волгыжмо деч ончычак Тыйым сӧрвален ӱжам –</para>
  <para style="q1" vid="PSA 118:147">мый Тыйын шомакетлан инанен илем.<verse eid="PSA 118:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 118:148" />Йӱдвошт мый шинчам ом петыре,</para>
  <para style="q1" vid="PSA 118:148">Тыйын шомакет нерген шонкалем.<verse eid="PSA 118:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 118:149" />Шке порылыкет дене, Господь, кол йӱкемым,</para>
  <para style="q1" vid="PSA 118:149">чын судым ыштен, мыйым иландаре.<verse eid="PSA 118:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 118:150" />Лишемыт поктылшем-влак осал шонымаш дене,</para>
  <para style="q1" vid="PSA 118:150">Тыйын законет деч нуно мӱндырнӧ улыт.<verse eid="PSA 118:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 118:151" />Лишне Тый улат, Господь,</para>
  <para style="q1" vid="PSA 118:151">Тыйын чыла кӱштымашет улыт чынле.<verse eid="PSA 118:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 118:152" />Сугынь-влакетым шукертсек палем,</para>
  <para style="q1" vid="PSA 118:152">Тый нуным курымешлан пеҥгыдемденат.<verse eid="PSA 118:152" /></para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 118:153" />Ончал орлыкем да мыйым утаре,</para>
  <para style="q1" vid="PSA 118:153">вет Тыйын законетым мый ом мондо.<verse eid="PSA 118:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 118:154" />Нал мыйым пыдалын, мыйым арале –</para>
  <para style="q1" vid="PSA 118:154">шке мутет почеш мыйым иландаре.<verse eid="PSA 118:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 118:155" />Осалым ыштыше-влак деч утаралтмаш мӱндырнӧ,</para>
  <para style="q1" vid="PSA 118:155">вет пунчал-влакетым нунын палымышт ок шу.<verse eid="PSA 118:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 118:156" />Господь, Тыйын чаманыше порылыкет пеш шуко –</para>
  <para style="q1" vid="PSA 118:156">чын судым ыштен, мыйым иландаре.<verse eid="PSA 118:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 118:157" />Шуко мыйын поктылшем да тушманем,</para>
  <para style="q1" vid="PSA 118:157">но сугынь-влакет деч ом кораҥ.<verse eid="PSA 118:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 118:158" />Тый дечет кораҥше-влакым ужын, мый йырнем,</para>
  <para style="q1" vid="PSA 118:158">вет нуно Тыйын шомакетым огыт шукто.<verse eid="PSA 118:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 118:159" />Ончал, кузе мый шӱдымаш-влакетым йӧратем –</para>
  <para style="q1" vid="PSA 118:159">шке порылыкет дене, Господь, мыйым иландаре.<verse eid="PSA 118:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 118:160" />Тыйын шомакет тӱрыснек чын,</para>
  <para style="q1" vid="PSA 118:160">Тыйын чынле судет-влак курымашле улыт.<verse eid="PSA 118:160" /></para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 118:161" />Титакем уке ӱмбач тӧра-влак мыйым поктылыт,</para>
  <para style="q1" vid="PSA 118:161">но шӱмемже Тыйын шомакет деч веле лӱдеш.<verse eid="PSA 118:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 118:162" />Куанем мый Тыйын мутетлан,</para>
  <para style="q1" vid="PSA 118:162">кугу поянлык тудо мыланем.<verse eid="PSA 118:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 118:163" />Ужмем ок шу шоякым, тудын деч йырнем,</para>
  <para style="q1" vid="PSA 118:163">а Тыйын законетым йӧратем.<verse eid="PSA 118:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 118:164" />Чын уставет-влаклан Тыйым</para>
  <para style="q2" vid="PSA 118:164">кечылан шым гана моктем.<verse eid="PSA 118:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 118:165" />Кугу тыныслык лиеш нунылан, кӧмыт законетым йӧратат,</para>
  <para style="q1" vid="PSA 118:165">огыт шӱртньӧ нуно нигунам.<verse eid="PSA 118:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 118:166" />Тыйын утарыметлан, Господь, инанен илем,</para>
  <para style="q1" vid="PSA 118:166">Тыйын кӱштымашет-влакым мый шуктен шогем.<verse eid="PSA 118:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 118:167" />Тыйын сугынет-влак улыт мылам шерге,</para>
  <para style="q1" vid="PSA 118:167">нуным мый моткоч йӧратем.<verse eid="PSA 118:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 118:168" />Шуктен шогем мый шӱдымаш ден сугынетым,</para>
  <para style="q1" vid="PSA 118:168">вет мыйын коштмо корнем Тыйын ончылнет.<verse eid="PSA 118:168" /></para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 118:169" />Господь, полышым йодын кычкырымем</para>
  <para style="q2" vid="PSA 118:169">тек Тый декет миен шуэш –</para>
  <para style="q1" vid="PSA 118:169">шке мутет почеш пу ушым мыланем.<verse eid="PSA 118:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 118:170" />Тек мыйын кумалмем Тыйын ончыкет миен шуэш –</para>
  <para style="q1" vid="PSA 118:170">шке мутет почеш мыйым утаре.<verse eid="PSA 118:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 118:171" />Умшам Тыйым мокташ тӱҥалеш,</para>
  <para style="q1" vid="PSA 118:171">вет Тый мыйым пунчал-влакетлан туныктет.<verse eid="PSA 118:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 118:172" />Тыйын шомакетым йылмем мураш тӱҥалеш,</para>
  <para style="q1" vid="PSA 118:172">вет Тыйын кӱштымашет-влак улыт чынле.<verse eid="PSA 118:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 118:173" />Тек Тыйын кидет мылам полыш лиеш,</para>
  <para style="q1" vid="PSA 118:173">вет Тыйын шӱдымашет-влак почеш илаш шонен пыштенам.<verse eid="PSA 118:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 118:174" />Тыйын утарыметым, Господь, мый чот вучен илем,</para>
  <para style="q1" vid="PSA 118:174">Тыйын законет мылам конда куаным.<verse eid="PSA 118:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 118:175" />Тек чонем ила да Тыйым мокта,</para>
  <para style="q1" vid="PSA 118:175">уставет-влак тек мылам полшат.<verse eid="PSA 118:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 118:176" />Йомдарыме шорык семын мый йомынам:</para>
  <para style="q1" vid="PSA 118:176">кычал му шке тарзетым,</para>
  <para style="q1" vid="PSA 118:176">вет Тыйын кӱштымаш-влакетым монден омыл.<verse eid="PSA 118:176" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="cl">119 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.<note caller="*" style="f"><char style="ft" closed="false">Очыни, кунам Юмын палемдыме пайремже-влакым пайремлаш Иерусалимыш тайыл дене кӱзеныт, нине псалом-влакым муреныт.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Орлыкем годым Господьым ӱжын кумальым,</para>
  <para style="q1" vid="PSA 119:1">да Тудо мыйым кольо.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Господь, мыйым шояк еҥ деч,</para>
  <para style="q2" vid="PSA 119:2">ондалчык йылме деч утаре.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Ондалчык йылме, мо тыйым ончылно вуча,</para>
  <para style="q1" vid="PSA 119:3">Господь тылат мо дене пӧртылта?<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Виян сарзын пӱсӧ пикшыжым,</para>
  <para style="q1" vid="PSA 119:4">йӱлышӧ тулшолым Тудо тыланет колта!<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Ойго мылам: улам мый Мешехыште,</para>
  <para style="q1" vid="PSA 119:5">Кедар омаш коклаште илем.<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Шуко иленам мый тынысым ужмышудымо еҥ-влак коклаште.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Мый тыныс верч улам,</para>
  <para style="q1" vid="PSA 119:7">но умшам веле почам – ямде улыт нуно сарлан.<verse eid="PSA 119:7" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="cl">120 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Курыкла деке вуем нӧлталам –</para>
  <para style="q1" vid="PSA 120:1">полыш мылам кушечын толеш?<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Полыш мылам – Господь деч,</para>
  <para style="q1" vid="PSA 120:2">кава ден мландым Ыштыше деч.<verse eid="PSA 120:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Йолетлан Тудо ок пу тайнышташ,</para>
  <para style="q1" vid="PSA 120:3">тыйым Аралыше ок нералте.<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Огеш нералте, огеш мале Израильым Аралыше.<verse eid="PSA 120:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Господь – тыйын Аралышет,</para>
  <para style="q1" vid="PSA 120:5">Господь – тыйын пурла велнет,</para>
  <para style="q1" vid="PSA 120:5">Тудо тыйым ӱмыл семын леведеш.<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Кечывалым кече, йӱдым тылзе</para>
  <para style="q2" vid="PSA 120:6">тылат зияным огыт ыште.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Господь тыйым чыла осал деч арала,</para>
  <para style="q1" vid="PSA 120:7">илышетым [Тудо] арален кода.<verse eid="PSA 120:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 120:8" />Кайымет годым, толмет годым,</para>
  <para style="q1" vid="PSA 120:8">кызыт да курым-курымеш Господь тыйым арала.<verse eid="PSA 120:8" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="cl">121 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Чот йывыртышым мый, кунам каласышт:</para>
  <para style="q1" vid="PSA 121:1">«Господьын пӧртыш каена».<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Теве мемнан йолна, Иерусалим,</para>
  <para style="q1" vid="PSA 121:2">тыйын капкат дене шога.<verse eid="PSA 121:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Иерусалим, тый виян да ик тичмаш семын чоҥымо ола улат!<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Тушко тукым-влак, Господьын калыкшын тукымжо-влак,</para>
  <para style="q2" vid="PSA 121:4">Израильлан пуымо сугынь почеш Господьын лӱмжым чаплаш кӱзат.<verse eid="PSA 121:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />Тушто судья-шамычын престолышт,</para>
  <para style="q2" vid="PSA 121:5">Давид тукымын престолжо-влак шогат.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Иерусалимлан Юмо деч тынысым йодса:</para>
  <para style="q1" vid="PSA 121:6">«Тыйым йӧратыше-влаклан эсенлык лийже,<verse eid="PSA 121:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />пырдыжлаштет тыныслык лийже,</para>
  <para style="q1" vid="PSA 121:7">полатлаштет эсенлык лийже!»<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />Иза-шольо ден лишылем-влаклан кӧра ойлем мый:</para>
  <para style="q1" vid="PSA 121:8">«Тыныс тыланет!»<verse eid="PSA 121:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 121:9" />Господь Юмынан пӧртшылан кӧра</para>
  <para style="q2" vid="PSA 121:9">тылат мый сайлыкым тыланем.<verse eid="PSA 121:9" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="cl">122 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Тый декет мый вуем нӧлталам,</para>
  <para style="q1" vid="PSA 122:1">пылпомышто Илыше!<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Кузе кул пӧръеҥын шинчаже шке озажын кидышкыже</para>
  <para style="q2" vid="PSA 122:2">да кул ӱдырамашын шинчаже озаватыжын кидышке онча,</para>
  <para style="q1" vid="PSA 122:2">тугак мемнан шинчана Господь Юмына ӱмбак онча</para>
  <para style="q1" vid="PSA 122:2">да Тудын порылыкшым вуча.<verse eid="PSA 122:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Серлаге мемнам, Господь, серлаге –</para>
  <para style="q1" vid="PSA 122:3">шуко жап мемнам нимоэш шотлен огытыл,<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />сӱрза еҥ-шамычын игылтмышт деч,</para>
  <para style="q2" vid="PSA 122:4">кугешныше-влакын мыскылымышт деч ме ноенна.<verse eid="PSA 122:4" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="cl">123 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Господь огеш лий ыле гын мемнан дене, –</para>
  <para style="q1" vid="PSA 123:1">тыге каласыже Израиль, –<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />тушман-влакын ӱмбакна кержалтмышт годым</para>
  <para style="q2" vid="PSA 123:2">Господь огеш лий ыле гын мемнан дене,<verse eid="PSA 123:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />мемнан ӱмбак шыдышт ылыжмеке,</para>
  <para style="q1" vid="PSA 123:3">нуно мемнам илышынек нелыт ыле.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Вӱд-влак мемнам наҥгаят ыле,</para>
  <para style="q1" vid="PSA 123:4">вӱдйогын эртен кая ыле мемнан ӱмбачын,<verse eid="PSA 123:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 123:5" />тале вӱд йоген кая ыле мемнан ӱмбачын.<verse eid="PSA 123:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 123:6" />Моктымо лийже Господь!</para>
  <para style="q1" vid="PSA 123:6">Тудо мемнам нунын кидышкышт пуэн огыл,</para>
  <para style="q1" vid="PSA 123:6">нунын пӱйышт мемнам кӱрыштын огыл.<verse eid="PSA 123:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 123:7" />Кайык семын ме кучышо-влакын лӧдышт гыч утленна,</para>
  <para style="q1" vid="PSA 123:7">тудыжо шаланен – ме утаралтынна.<verse eid="PSA 123:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 123:8" />Полыш мыланна Господь деч толеш,</para>
  <para style="q1" vid="PSA 123:8">Тудыжо кава ден мландым ыштен.<verse eid="PSA 123:8" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="cl">124 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Господьлан инаныше еҥ Сион курык гай,</para>
  <para style="q1" vid="PSA 124:1">тудо ок чытырне, курымеш пеҥгыдын шога.<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />Кузе курык-влак Иерусалимым авырен шогат,</para>
  <para style="q1" vid="PSA 124:2">туге Господь шке калыкшым кызыт да курым-курымеш авырен шога.<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />Чын ыштыше-влакын мландыштышт</para>
  <para style="q2" vid="PSA 124:3">[Господь] осал еҥ-шамычлан кужу жап озаланаш огеш пу,</para>
  <para style="q1" vid="PSA 124:3">тунам чын ыштыше-влак кидыштым осал пашам ышташ огыт шуялте.<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />Господь, поро еҥ-влаклан, яндар шӱм-чонан-влаклан</para>
  <para style="q2" vid="PSA 124:4">сайым ыште.<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />А кадыр корныш савырныше-влакым, Господь,</para>
  <para style="q1" vid="PSA 124:5">осалым ыштыше-шамыч дене пырля поктен колто.</para>
  <para style="q1" vid="PSA 124:5">Тыныс лийже Израильлан!<verse eid="PSA 124:5" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="cl">125 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Кунам пленыште улшо-влакым Господь Сионыш пӧртылтен,</para>
  <para style="q1" vid="PSA 125:1">тиде мыланна омо гай лийын.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Тунам ме кугу йӱкын йывыртенна,</para>
  <para style="q1" vid="PSA 125:2">умшана чарныде куанен мурен.</para>
  <para style="q1" vid="PSA 125:2">Мемнам ончен, вес калык-влак ойленыт:</para>
  <para style="q1" vid="PSA 125:2">«Господь нунын дене кугу пашам ыштен!»<verse eid="PSA 125:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Чынак, кугу пашам ыштен Господь мемнан дене –</para>
  <para style="q1" vid="PSA 125:3">тидлан ме куаненна.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Пӧртылтӧ, Господь, пленыште улшо-влакнам</para>
  <para style="q2" vid="PSA 125:4">кечывалвел мландысе кошкышо йогынлашке вӱдым колтымо семын.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Кӧ шинчавӱд дене ӱда,</para>
  <para style="q1" vid="PSA 125:5">тӱредеш куан дене.<verse eid="PSA 125:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 125:6" />Кӧ нӧшмым ӱдаш шортын кая,</para>
  <para style="q1" vid="PSA 125:6">кылтаж-влакым нумалын, пӧртылеш куан дене.<verse eid="PSA 125:6" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="cl">126 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро. Соломонын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Господь ок ыште гын пӧртым,</para>
  <para style="q1" vid="PSA 126:1">тудым чоҥышо-влак тыршат арам.</para>
  <para style="q1" vid="PSA 126:1">Господь ок арале гын олам,</para>
  <para style="q1" vid="PSA 126:1">оролын чарныде оролымыжо арам.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Арам те эр кынелыда да йӱд марте шинчеда,</para>
  <para style="q1" vid="PSA 126:2">неле паша дене ыштен налме киндым кочкыда –</para>
  <para style="q1" vid="PSA 126:2">вет Господь йӧратымыже-влаклан мо кӱлешым</para>
  <para style="q2" vid="PSA 126:2">малымышт годымат пуа.<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Йоча-влак – Господьын пуымо суапше,</para>
  <para style="q1" vid="PSA 126:3">авагудын саскаже – Тудын деч пӧлек.<verse eid="PSA 126:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />Самырык годым шочыктымо эрге-влак</para>
  <para style="q2" vid="PSA 126:4">виян сарзын кидыштыже улшо пикш гай улыт.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Пиалан айдеме, кӧ нунын дене шке пикш лодакшым темен!</para>
  <para style="q1" vid="PSA 126:5">Ок пуро тудо намысыш,</para>
  <para style="q1" vid="PSA 126:5">кунам тушманже дене ола капка воктене кутыра.<verse eid="PSA 126:5" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="cl">127 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Пиалан кажне еҥ, кӧ Господь деч лӱдын ила,</para>
  <para style="q1" vid="PSA 127:1">Тудын корныж дене коштеш!<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Тый шке кидет дене ыштен налмым кочкат.</para>
  <para style="q1" vid="PSA 127:2">Пиалан тый улат, чылажат тыйын сай!<verse eid="PSA 127:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Ватетше пӧртыштет шуко саскам пуышо виноград пушеҥге гай,</para>
  <para style="q1" vid="PSA 127:3">эргыч-влак ӱстел йырет улыт олив пушеҥге иге гай.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Господь деч лӱдын илыше айдеме тыге суапландарыме лиеш!<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Суапландара Господь тыйым Сион гыч –</para>
  <para style="q1" vid="PSA 127:5">ӱмырет мучко Иерусалимын пеледалт илымыжым ужат,<verse eid="PSA 127:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 127:6" />йочат-влакын йочаштым тый ужат.</para>
  <para style="q1" vid="PSA 127:6">Тыныс лийже Израильлан!<verse eid="PSA 127:6" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="cl">128 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Самырык жап гычак мыйым шуко шыгыремденыт, –</para>
  <para style="q1" vid="PSA 128:1">каласыже тыге Израиль, –<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />шыгыремденыт мыйым самырык жап гычак,</para>
  <para style="q1" vid="PSA 128:2">но сеҥен кертын огытыл.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Куралше-влак тупыштем куралыныт,</para>
  <para style="q1" vid="PSA 128:3">шке кужу кашыштым колтеныт.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Но Господь чынле –</para>
  <para style="q1" vid="PSA 128:4">осал еҥ-влакын чиктыме кепшылыштым Тудо пӱчкын.<verse eid="PSA 128:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Тек намысыш пурат да чакнен каят чылан,</para>
  <para style="q1" vid="PSA 128:5">кӧмытын Сионым ужмышт ок шу.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Тек лийыт нуно леведыш ӱмбалысе шудо гай –</para>
  <para style="q1" vid="PSA 128:6">кӱрлын шумо деч ончыч тудо кошка,<verse eid="PSA 128:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 128:7" />тӱредше еҥын ӧлтыштыжӧ ок лий,</para>
  <para style="q1" vid="PSA 128:7">кылтам пидше тудым поген ок нал.<verse eid="PSA 128:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 128:8" />Эртен кайыше-влак нунылан огыт каласе:</para>
  <para style="q1" vid="PSA 128:8">«Господь тендам суапландарыже,</para>
  <para style="q1" vid="PSA 128:8">Господьын лӱмжӧ дене тыланда суапым тыланена!»<verse eid="PSA 128:8" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="cl">129 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />Господь, келгыт гыч Тыйым ӱжын кычкырем!<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />Господь! Кол мыйын йӱкем!</para>
  <para style="q1" vid="PSA 129:2">Тек Тыйын пылышет кумалме йӱкемлан тӱткӧ лиеш.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Господь, кажне сулыкнам шотыш налат гын,</para>
  <para style="q1" vid="PSA 129:3">тидым, Господь, кӧ чытен кертеш?<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Но Тый улат титакым кудалтыше,</para>
  <para style="q1" vid="PSA 129:4">тек Тыйым чылан шотлен илат!<verse eid="PSA 129:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Господьлан инанен илем, вуча Тудым мыйын чонем,</para>
  <para style="q1" vid="PSA 129:5">Тудын шомакшылан мый инанем.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Оролын эрым вучымыж деч чот</para>
  <para style="q2" vid="PSA 129:6">мыйын чонем Господьым вуча,</para>
  <para style="q1" vid="PSA 129:6">оролын эрым вучымыж деч чот вуча!<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />Тек Израиль инанен ила Господьлан,</para>
  <para style="q1" vid="PSA 129:7">вет Тудын порылыкшо кугу,</para>
  <para style="q1" vid="PSA 129:7">утараш Господь эре ямде.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Тудо Израильым чыла сулыкшо деч утара.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="cl">130 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />Господь, уке шӱмыштем моктанымаш,</para>
  <para style="q1" vid="PSA 130:1">шинчам кугешнен ок ончо.</para>
  <para style="q1" vid="PSA 130:1">Мо кугу да мылам умылаш лийдыме,</para>
  <para style="q2" vid="PSA 130:1">тыгайлан пижын омыл.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />Мый шке чонем луштаренам, шыматенам –</para>
  <para style="q1" vid="PSA 130:2">тудо чызе деч ойырымо да ава оҥыш пызныше азан гай лийын,</para>
  <para style="q1" vid="PSA 130:2">чызе деч посна тунемше аза гай лийын мыйын чонем.<verse eid="PSA 130:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Тек Израиль инанен ила Господьлан</para>
  <para style="q2" vid="PSA 130:3">кызыт да курым-курымеш.<verse eid="PSA 130:3" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="cl">131 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Господь, шарналте Давидым,</para>
  <para style="q1" vid="PSA 131:1">тудын чыла орлыкшым.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Тудо Господьлан товатлен,</para>
  <para style="q1" vid="PSA 131:2">Иаковын куатан Юмыжлан мутым пуэн:<verse eid="PSA 131:2" /></para>
  <para style="q1">
    <verse number="3-5" style="v" sid="PSA 131:3-5" />«Господьлан верым,</para>
  <para style="q2" vid="PSA 131:3-5">Иаковын куатан Юмыжлан илемым мумешке,</para>
  <para style="q1" vid="PSA 131:3-5">мый омашышкем ом пуро, вакшышкем ом воч,</para>
  <para style="q1" vid="PSA 131:3-5">ом пу шинчамлан омым,</para>
  <para style="q1" vid="PSA 131:3-5">шинчагомдышемлан – нерымашым».<verse eid="PSA 131:3-5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 131:6" />Теве ме Ефрафаште ойпидыш шондык нерген колна,</para>
  <para style="q1" vid="PSA 131:6">Иарим нурышто тудым муна.<verse eid="PSA 131:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 131:7" />Каена Тудын илыме верышкыже,</para>
  <para style="q1" vid="PSA 131:7">Тудын йол шындыме верже ончылно вуйнам савена.<verse eid="PSA 131:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 131:8" />Кынел, Господь, шке илыме верышкет тол –</para>
  <para style="q1" vid="PSA 131:8">Тый да Тыйын куатетын шондыкшо.<note caller="*" style="f"><char style="fr" closed="false">131:8 </char><char style="ft" closed="false">«Куатетын шондыкшо» – ойпидыш шондык, мутерым ончо.</char></note><verse eid="PSA 131:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 131:9" />Тек иерей-влакет чынлык дене вӱдылалтыт,</para>
  <para style="q2" vid="PSA 131:9">ӱшанле еҥет-шамыч куанен кычкырат.<verse eid="PSA 131:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 131:10" />Давид тарзетлан кӧра</para>
  <para style="q2" vid="PSA 131:10">шке шӱрен палемдыметым Шке дечет ит кораҥде.<verse eid="PSA 131:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 131:11" />Ӱшанле товатмутым Господь пуэн Давидлан,</para>
  <para style="q1" vid="PSA 131:11">шке мутшо дечын Тудо ок кораҥ:</para>
  <para style="q1" vid="PSA 131:11">«Тыйын тукымет гыч лекшым Мый престолышкет шындем.<verse eid="PSA 131:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 131:12" />Тӱҥалыт гын эргыч-влак шуктен шогаш ойпидышем,</para>
  <para style="q2" vid="PSA 131:12">нуным туныктымо сугынь-влакем –</para>
  <para style="q1" vid="PSA 131:12">тунам нунын эргыштат тыйын престолыштет</para>
  <para style="q2" vid="PSA 131:12">шинчаш тӱҥалыт курымеш».<verse eid="PSA 131:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 131:13" />Господь ойырен налын Сионым,</para>
  <para style="q1" vid="PSA 131:13">ышташ шонен тудым шке илемжым:<verse eid="PSA 131:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 131:14" />«Тиде – мыйын курымешлан илыме верем,</para>
  <para style="q1" vid="PSA 131:14">тыште илаш тӱҥалам, чонемлан тудо келша.<verse eid="PSA 131:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 131:15" />Кинде перке дене тудым суапландарем,</para>
  <para style="q1" vid="PSA 131:15">йорлыж-влакым теммеш пукшем,<verse eid="PSA 131:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 131:16" />иерейже-шамычым утарымаш дене вӱдылам,</para>
  <para style="q1" vid="PSA 131:16">тудын ӱшанле еҥже-влак куанен йӱкланат.<verse eid="PSA 131:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 131:17" />Тушто Давидын тӱкыжым нӧлталам,</para>
  <para style="q1" vid="PSA 131:17">шӱрен палемдымемлан лампым чӱктем.<verse eid="PSA 131:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 131:18" />Тушманжым намыс дене леведам,</para>
  <para style="q1" vid="PSA 131:18">а тудын вуйыштыжо кугыжан вуйшӱдыш йылгыжаш тӱҥалеш».<verse eid="PSA 131:18" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="cl">132 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Могай сай да могай чесле,</para>
  <para style="q1" vid="PSA 132:1">кунам иза-шольо-влак пырля келшен илат!<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Тиде – вуйыш шӱрымӧ шергакан елей гай,</para>
  <para style="q1" vid="PSA 132:2">тудо пондашышке, Ааронын пондашышкыже,</para>
  <para style="q2" vid="PSA 132:2">тудын вургемышкыже йоген вола.<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />Тиде – Сион курыкыш вочшо Ермонысо лупс гай.</para>
  <para style="q1" vid="PSA 132:3">Вет Сионышто Господь суапландарымашым – курымаш илышым – пуэн.<verse eid="PSA 132:3" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="cl">133 ПСАЛОМ</para>
  <para style="d">Кӱзымӧ годым мурымо муро.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Моктыза Господьым, Тудын тарзыже-влак,</para>
  <para style="q1" vid="PSA 133:1">Тудын пӧртыштыжӧ,</para>
  <para style="q1" vid="PSA 133:1">[мемнан Юмынан кудывечылаштыже]</para>
  <para style="q1" vid="PSA 133:1">йӱдым служитлен шогышо-влак!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Киддам святой вер дек нӧлталза</para>
  <para style="q1" vid="PSA 133:2">да Господьым чапландарыза!<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Тек кавам да мландым Ыштыше Господь</para>
  <para style="q2" vid="PSA 133:3">тыйым Сион гыч суапландара.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="cl">134 ПСАЛОМ</para>
  <para style="d">Аллилуия.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Господьын лӱмжым моктыза,</para>
  <para style="q1" vid="PSA 134:1">Господьын тарзыже-влак, моктыза,<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Господьын пӧртыштыжӧ,</para>
  <para style="q2" vid="PSA 134:2">мемнан Юмынан кудывечылаштыже служитлыше-влак!<verse eid="PSA 134:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Моктыза Господьым – Тудо поро,</para>
  <para style="q1" vid="PSA 134:3">Тудын лӱмжым моктен мурыза – тудо чесле!<verse eid="PSA 134:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 134:4" />Вет Господь Шкаланже Иаковым ойырен налын,</para>
  <para style="q1" vid="PSA 134:4">Израильым Шкенжыным ыштен.<verse eid="PSA 134:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 134:5" />Палем мый: Господь – кӱдыратле,</para>
  <para style="q1" vid="PSA 134:5">чыла моло юмо деч Тудо кугу.<verse eid="PSA 134:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 134:6" />Господь мом шона, тудым ышта:</para>
  <para style="q1" vid="PSA 134:6">каваште да мландыште,</para>
  <para style="q1" vid="PSA 134:6">теҥызлаште да чыла келгытыште.<verse eid="PSA 134:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 134:7" />Мланде тӱр гыч нӧлталеш пыл-влакым,</para>
  <para style="q1" vid="PSA 134:7">йӱр годым волгенчым колтылеш,</para>
  <para style="q1" vid="PSA 134:7">шке аралыме верлаж гыч мардежым луктеш.<verse eid="PSA 134:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 134:8" />Египетыште Тудо икымше шочшо-влакым пытарен –</para>
  <para style="q1" vid="PSA 134:8">айдеме гыч тӱҥалын вольык марте.<verse eid="PSA 134:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 134:9" />Тыйын калыкет коклаште, Египет,</para>
  <para style="q1" vid="PSA 134:9">фараон ден тудын тарзыж-влаклан</para>
  <para style="q2" vid="PSA 134:9">палдарыше пале ден ӧрыктарыше паша-влакым ончыктен.<verse eid="PSA 134:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 134:10" />Шуко калыкым Тудо кырен шалатен,</para>
  <para style="q1" vid="PSA 134:10">виян кугыжа-влакым пытарен:<verse eid="PSA 134:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 134:11" />Аморрей кугыжа Сигоным,</para>
  <para style="q1" vid="PSA 134:11">Васан кугыжа Огым,</para>
  <para style="q1" vid="PSA 134:11">Ханаанысе чыла кугыжанышым.<verse eid="PSA 134:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 134:12" />Израильлан, шке калыкшылан,</para>
  <para style="q2" vid="PSA 134:12">нунын мландыштым пуэн.<verse eid="PSA 134:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 134:13" />Господь, Тыйын лӱмет курымашле!</para>
  <para style="q1" vid="PSA 134:13">Господь, Тыйым тукым гыч тукымыш шарнат!<verse eid="PSA 134:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 134:14" />Господь шке калыкшылан чын судым ышта,</para>
  <para style="q1" vid="PSA 134:14">шке тарзыж-влакым чаманен налеш.<verse eid="PSA 134:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 134:15" />Вес калык-влакын шояк юмышт ший да шӧртньӧ дене ыштыме,</para>
  <para style="q1" vid="PSA 134:15">айдеме кидын пашаже улыт.<verse eid="PSA 134:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 134:16" />Уло нунын умшашт, но огыт ойло,</para>
  <para style="q1" vid="PSA 134:16">уло шинчашт, но огыт уж.<verse eid="PSA 134:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 134:17" />Уло нунын пылышышт, но огыт кол,</para>
  <para style="q1" vid="PSA 134:17">умшаштышт шӱлыш уке.<verse eid="PSA 134:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 134:18" />Шояк юмым ыштыше да нунылан ӱшаныше-влак</para>
  <para style="q2" vid="PSA 134:18">шкештат нунын гаяк лийыт.<verse eid="PSA 134:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 134:19" />Израиль тукым, Господьым мокто!</para>
  <para style="q1" vid="PSA 134:19">Аарон тукым, Господьым чапландаре!<verse eid="PSA 134:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 134:20" />Левий тукым, Господьым мокто!</para>
  <para style="q1" vid="PSA 134:20">Господь деч лӱдшӧ-влак, Господьым чаплыза!<verse eid="PSA 134:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 134:21" />Моктымо лийже Сионышто Господь,</para>
  <para style="q1" vid="PSA 134:21">Иерусалимыште илыше! Аллилуия!<verse eid="PSA 134:21" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="cl">135 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Чаплыза Господьым – Тудо поро,</para>
  <para style="q1" vid="PSA 135:1">порылыкшо Тудын курымеш!<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />Чаплыза юмо-влакын Юмыштым –</para>
  <para style="q1" vid="PSA 135:2">порылыкшо Тудын курымеш!<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Чаплыза оза-влакын Озаштым –</para>
  <para style="q1" vid="PSA 135:3">порылыкшо Тудын курымеш!<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Тудо гына ӧрыктарыше кугу паша-влакым ышта –</para>
  <para style="q1" vid="PSA 135:4">порылыкшо Тудын курымеш!<verse eid="PSA 135:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Кавам Тудо кугу уш-акыл дене ыштен –</para>
  <para style="q1" vid="PSA 135:5">порылыкшо Тудын курымеш!<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />Вӱд-влак ӱмбалне мландым шарен –</para>
  <para style="q1" vid="PSA 135:6">порылыкшо Тудын курымеш!<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Кугу тӱняволгалтыш-влакым ыштен –</para>
  <para style="q1" vid="PSA 135:7">порылыкшо Тудын курымеш!<verse eid="PSA 135:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Кечым – кечывалым виктараш,</para>
  <para style="q1" vid="PSA 135:8">порылыкшо Тудын курымеш!<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Тылзе ден шӱдыр-влакым – йӱдым виктараш,</para>
  <para style="q1" vid="PSA 135:9">порылыкшо Тудын курымеш!<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Египетын кугэргыж-влакым пытарен –</para>
  <para style="q1" vid="PSA 135:10">порылыкшо Тудын курымеш!<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Израильым тушеч луктын –</para>
  <para style="q1" vid="PSA 135:11">порылыкшо Тудын курымеш!<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />Нӧлталме виян кидше дене луктын –</para>
  <para style="q1" vid="PSA 135:12">порылыкшо Тудын курымеш!<verse eid="PSA 135:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Йошкар теҥызым кокыте шелын –</para>
  <para style="q1" vid="PSA 135:13">порылыкшо Тудын курымеш!<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Израильым теҥыз покшеч наҥгаен –</para>
  <para style="q1" vid="PSA 135:14">порылыкшо Тудын курымеш!<verse eid="PSA 135:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />А фараоным да сарзыж-влакым Йошкар теҥызыш пуртен колтен –</para>
  <para style="q1" vid="PSA 135:15">порылыкшо Тудын курымеш!<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Шке калыкшым ир мланде гоч наҥгаен –</para>
  <para style="q1" vid="PSA 135:16">порылыкшо Тудын курымеш!<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Кугу кугыжа-влакым кырен шалатен –</para>
  <para style="q1" vid="PSA 135:17">порылыкшо Тудын курымеш!<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Виян кугыжа-влакым пуштын –</para>
  <para style="q1" vid="PSA 135:18">порылыкшо Тудын курымеш!<verse eid="PSA 135:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Аморрей кугыжа Сигоным –</para>
  <para style="q1" vid="PSA 135:19">порылыкшо Тудын курымеш!<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Васан кугыжа Огым –</para>
  <para style="q1" vid="PSA 135:20">порылыкшо Тудын курымеш!<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Нунын мландыштым шке калыкшылан пуэн –</para>
  <para style="q1" vid="PSA 135:21">порылыкшо Тудын курымеш!<verse eid="PSA 135:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 135:22" />Пуэн тудым шке Израиль тарзыжлан –</para>
  <para style="q1" vid="PSA 135:22">порылыкшо Тудын курымеш!<verse eid="PSA 135:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 135:23" />Пызырналтмына годым мемнам шарналтен –</para>
  <para style="q1" vid="PSA 135:23">порылыкшо Тудын курымеш!<verse eid="PSA 135:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 135:24" />Тушман-влакна деч мемнам утарен –</para>
  <para style="q1" vid="PSA 135:24">порылыкшо Тудын курымеш!<verse eid="PSA 135:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 135:25" />Чыла илышылан Тудо кочкышым пуа –</para>
  <para style="q1" vid="PSA 135:25">порылыкшо Тудын курымеш!<verse eid="PSA 135:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 135:26" />Чаплыза кавасе Юмым –</para>
  <para style="q1" vid="PSA 135:26">порылыкшо Тудын курымеш!<verse eid="PSA 135:26" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="cl">136 ПСАЛОМ</para>
  <para style="d">[Давидын псаломжо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />Тушто, Вавилонысо эҥер-влак воктене,</para>
  <para style="q2" vid="PSA 136:1">Сионым шарналтен, ме шортын шинченна,<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />арама укшлашке кӱсленам сакенна.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Мемнам пленыш налше-влак</para>
  <para style="q2" vid="PSA 136:3">тушто мыланна мураш кӱштеныт,</para>
  <para style="q1" vid="PSA 136:3">шыгыремдылшына-влак нуным веселитлаш шӱденыт:</para>
  <para style="q1" vid="PSA 136:3">«Мыланна Сион муро-влакым мурыза!»<verse eid="PSA 136:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Кузе мыланна Господьын мурыжым йот мландыште мураш?<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Мый тыйым мондем гын, Иерусалим,</para>
  <para style="q1" vid="PSA 136:5">тек пурла кидем мом ыштен моштымыжым монда.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Шарнаш ом тӱҥал гын тыйым,</para>
  <para style="q2" vid="PSA 136:6">огеш лий гын Иерусалим эн кугу куанем –</para>
  <para style="q1" vid="PSA 136:6">тек йылмем умшаношмыш пижын шинчеш.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Шарналте, Господь, мом Едом эрге-влак</para>
  <para style="q2" vid="PSA 136:7">Иерусалимым шалатыме кечын ойленыт:</para>
  <para style="q1" vid="PSA 136:7">«Шалатыза тудым, негыз марте шалатыза!»<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Вавилон ӱдыр, тый шалатыме лият!</para>
  <para style="q1" vid="PSA 136:8">Пиалан тудо, кӧ мыланна мом ыштыметлан</para>
  <para style="q2" vid="PSA 136:8">тылат чыла пӧртылта!<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Пиалан тудо, кӧ йочат-влакым налеш</para>
  <para style="q1" vid="PSA 136:9">да нуным кӱэш перен пуштеш!<verse eid="PSA 136:9" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="cl">137 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Уло шӱмем дене Тыйым моктем,</para>
  <para style="q1" vid="PSA 137:1">юмо-влак ончылно<note caller="*" style="f"><char style="fr" closed="false">137:1 </char><char style="ft" closed="false">«Юмо-влак ончылно»: Грек йылме дене кусарымаште «суксо-влак ончылно».</char></note> моктен мурем,</para>
  <para style="q1" vid="PSA 137:1">[вет Тый чыла мутемым колынат]!<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Святой храм ончылнет вуемым савем,</para>
  <para style="q1" vid="PSA 137:2">порылыкетлан, ӱшанле улметлан Тыйын лӱметым чаплем,</para>
  <para style="q1" vid="PSA 137:2">вет сӧрымӧ мутетым Тый шке лӱмет гай кугум ыштенат.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Кунам Тыйым ӱжын кумалынам – мыйым колынат,</para>
  <para style="q1" vid="PSA 137:3">кумылем нӧлтен, чонемлан вийым пуэнат.<verse eid="PSA 137:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Господь, ойлымо мутетым колын,</para>
  <para style="q1" vid="PSA 137:4">Тыйым мландымбалысе кугыжа-влак чаплат,<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />пашат-влакым моктен мурат,</para>
  <para style="q1" vid="PSA 137:5">вет Господьын чапше пеш кугу.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Господь кӱшнӧ,</para>
  <para style="q1" vid="PSA 137:6">но ӱлыкшемдыме еҥым Тудо ужеш,</para>
  <para style="q1" vid="PSA 137:6">кугешныше айдемым умбачынак пала.<verse eid="PSA 137:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />Коштам гынат мый лӱдыкшӧ коклаште,</para>
  <para style="q1" vid="PSA 137:7">илышемым Тый саклен шогет.</para>
  <para style="q1" vid="PSA 137:7">Тушман-влакемын шыдышт ваштареш шке кидетым шуялтет,</para>
  <para style="q1" vid="PSA 137:7">да мыйым утара Тыйын пурла кидет.<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Господь шукта мылам сӧрымӧ мутшым!</para>
  <para style="q1" vid="PSA 137:8">Тыйын порылыкет, Господь, курымеш –</para>
  <para style="q1" vid="PSA 137:8">ит кай коден шке кидетын пашажым.<verse eid="PSA 137:8" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="cl">138 ПСАЛОМ</para>
  <para style="d">Хор вуйлатышылан. Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />Господь, Тый мыйым тергенат да мыйым палет.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Тый палет, кунам мый шинчам да кунам кынелам,</para>
  <para style="q1" vid="PSA 138:2">умбачынак Тый шонымем палет.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Ошкылам мый але канем –</para>
  <para style="q1" vid="PSA 138:3">Тый мыйым ужат,</para>
  <para style="q1" vid="PSA 138:3">чыла коштмо корнем пале Тыланет.<verse eid="PSA 138:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Уке эше мут йылмыштем –</para>
  <para style="q1" vid="PSA 138:4">Тый тудым палет.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Шеҥгечат да ончычат Тый мыйым авырет,</para>
  <para style="q1" vid="PSA 138:5">кидетым пыштенат мыйын ӱмбакем.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Чыла Тый палет – мылам тиде ӧрыктарыше,</para>
  <para style="q1" vid="PSA 138:6">мыйын ушем тидым авалтен ок керт.<verse eid="PSA 138:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Куш каем мый Тыйын Шӱлышет деч,</para>
  <para style="q1" vid="PSA 138:7">Тыйын чуриет деч куш куржам?<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />Кӱзем гын каваш, улат Тый тушто,</para>
  <para style="q1" vid="PSA 138:8">вес тӱняш волен, шкаланем вакшышым шарем гын,</para>
  <para style="q2" vid="PSA 138:8">туштат Тый улат.<verse eid="PSA 138:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 138:9" />Ӱжаран шулдырешыже чоҥештен кӱзен,</para>
  <para style="q1" vid="PSA 138:9">тӱҥалам гын илаш теҥыз вес могырышто –<verse eid="PSA 138:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 138:10" />туштат Тый мыйым вӱден наҥгает,</para>
  <para style="q1" vid="PSA 138:10">пурла кидет мыйым куча.<verse eid="PSA 138:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 138:11" />Кеч каласем: «Тек мыйым пычкемыш петыра</para>
  <para style="q1" vid="PSA 138:11">да йырем улшо волгыдо йӱдыш савырна», –<verse eid="PSA 138:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 138:12" />пычкемышат Тылат пычкемыш ок лий:</para>
  <para style="q1" vid="PSA 138:12">йӱдшӧ кече гай волгыдо лиеш,</para>
  <para style="q1" vid="PSA 138:12">пычкемыш волгыдо гай волгалтеш.<verse eid="PSA 138:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 138:13" />Ыштенат Тый мыйын кӧргем,</para>
  <para style="q1" vid="PSA 138:13">ава мӱшкырыштӧ мыйым куэнат.<verse eid="PSA 138:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 138:14" />Тыйым моктем – ӧрыктарышын Тый мыйым ыштенат!</para>
  <para style="q1" vid="PSA 138:14">Ӧрыктарыше улыт Тыйын пашат-влак,</para>
  <para style="q1" vid="PSA 138:14">мыйын чонем тидым сайын пала.<verse eid="PSA 138:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 138:15" />Койдымо лийын огытыл Тылат луэм-влак,</para>
  <para style="q1" vid="PSA 138:15">кунам мый шолып ышталтынам,</para>
  <para style="q1" vid="PSA 138:15">ава мӱшкырыштӧ<note caller="*" style="f"><char style="fr" closed="false">138:15 </char><char style="ft" closed="false">«Ава мӱшкырыштӧ» – Еврей йылмыште: ’мланде кӧргыштӧ’.</char></note> устан ышталтынам.<verse eid="PSA 138:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 138:16" />Иланымем годымак Тыйын шинчат мыйым ужын.</para>
  <para style="q1" vid="PSA 138:16">Илышаш кечем-влак Тыйын книгаштет возымо лийыныт,</para>
  <para style="q1" vid="PSA 138:16">кунам эше ик кечымат илен омыл.<verse eid="PSA 138:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 138:17" />Могай кӱкшӧ улыт мыланем Тыйын шонымашет-влак, Юмем –</para>
  <para style="q1" vid="PSA 138:17">мыняр шуко нуно улыт!<verse eid="PSA 138:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 138:18" />Тӱҥалам гын нуным шотлаш –</para>
  <para style="q1" vid="PSA 138:18">улыт нуно ошма пырче дечат шукырак...</para>
  <para style="q1" vid="PSA 138:18">Помыжалтам – мый эшеат Тый денет улам!<verse eid="PSA 138:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 138:19" />О Юмем, пытарет ыле гын осал еҥ-влакым!</para>
  <para style="q1" vid="PSA 138:19">Кораҥза мый дечем, вӱрым йоктарыше-шамыч!<verse eid="PSA 138:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 138:20" />Тыйын нергенет нуно осалым ойлат,</para>
  <para style="q1" vid="PSA 138:20">тушманет-влак кӱлеш-оккӱлым шонкалат.<verse eid="PSA 138:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 138:21" />Тыйым ужмышудымо-влакым, Господь,</para>
  <para style="q2" vid="PSA 138:21">мыйын ужмем ок шу,</para>
  <para style="q1" vid="PSA 138:21">Тыйын ваштареш шогалше-влак деч мый йырнем.<verse eid="PSA 138:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 138:22" />Ужмышудымаш дене темынам мый нунын деке,</para>
  <para style="q1" vid="PSA 138:22">тушман улыт нуно мыланем!<verse eid="PSA 138:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 138:23" />Терге мыйым, Юмем – пален нал шӱмем,</para>
  <para style="q1" vid="PSA 138:23">шымле мыйым – пален нал шонымем.<verse eid="PSA 138:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 138:24" />Ончал, уда корнышто омыл дыр?</para>
  <para style="q1" vid="PSA 138:24">Курымаш корныш мыйым виктаре!<verse eid="PSA 138:24" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="cl">139 ПСАЛОМ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 139:1" />Хор вуйлатышылан. Давидын псаломжо.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Утаре мыйым, Господь, осал еҥ деч,</para>
  <para style="q1" vid="PSA 139:2">шыгыремдылше айдеме деч мыйым арале.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Шонат нуно шӱмыштышт осалым,</para>
  <para style="q1" vid="PSA 139:3">кажне кечын келшыдымашым ылыжтен шогат.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Кишкын гай пӱсӧ нунын йылмышт,</para>
  <para style="q1" vid="PSA 139:4">шемгишкын аярже – нунын йылмыштышт.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Арале мыйым, Господь, осал еҥын кидше деч,</para>
  <para style="q1" vid="PSA 139:5">сакле мыйым шыгыремдыше-влак деч,</para>
  <para style="q1" vid="PSA 139:5">йолем шӱртньыкташ шонен пыштыше-шамыч деч.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Кугешныше-влак мылам оптыш ден шӧргам шынденыт,</para>
  <para style="q1" vid="PSA 139:6">шупшыныт вапшым мыйын корныштем,</para>
  <para style="q1" vid="PSA 139:6">лӧдым шынденыт нуно мыланем.<verse eid="PSA 139:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Каласем Господьлан:</para>
  <para style="q1" vid="PSA 139:7">«Улат Тый мыйын Юмем,</para>
  <para style="q1" vid="PSA 139:7">Господь, мыйын кумалмемым кол!»<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Господь, мыйын Юмем, виян Утарышем,</para>
  <para style="q1" vid="PSA 139:8">сӧй кечын аралет Тый мыйын вуем.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Ит пу, Господь, осал еҥын шонымыжлан шукталташ,</para>
  <para style="q1" vid="PSA 139:9">тудын шонен пыштымыжлан ит пу шукталташ –</para>
  <para style="q1" vid="PSA 139:9">тек тудо кугешнаш ок тӱҥал.<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />Мыйым авырыше-влакын умшашт гыч лекше осал шомак-влак</para>
  <para style="q2" vid="PSA 139:10">тек шке вуй ӱмбакыштак толыт,<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />йӱлышӧ шӱй-влак тек ӱмбакышт велыт,</para>
  <para style="q1" vid="PSA 139:11">кудалтыме лийыт тек тулыш, келге вынемыш –</para>
  <para style="q1" vid="PSA 139:11">ынышт лек нуно тушеч нигунам.<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />Тек осал йылман айдеме мланде ӱмбалне пеҥгыдын ок шого,</para>
  <para style="q1" vid="PSA 139:12">тек шыгыремдылше еҥым ойго поктен кая да пытара.<verse eid="PSA 139:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Палем, йорло еҥлан Господь чын судым ышта,</para>
  <para style="q1" vid="PSA 139:13">незер-влакым Тудо пыдалын налеш.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Чын ыштыше-влак Тыйын лӱметым моктат,</para>
  <para style="q1" vid="PSA 139:14">яндар чонан-влак Тыйын чуриет ончылно илаш тӱҥалыт.<verse eid="PSA 139:14" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="cl">140 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Господь, Тыйым сӧрвален йодам –</para>
  <para style="q1" vid="PSA 140:1">мый декем вашке,</para>
  <para style="q1" vid="PSA 140:1">кумалмемым кол, кунам Тыйым ӱжам!<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />Тек кумалмем тамлыпушан шикш семын</para>
  <para style="q2" vid="PSA 140:2">Тыйын чурий ончыкет кӱза,</para>
  <para style="q1" vid="PSA 140:2">тек кидым нӧлтал кумалмем кас надыр семын лиеш.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Мыйын умшамлан, Господь, оролым шогалте,</para>
  <para style="q1" vid="PSA 140:3">умшамын омсажым эскере.<verse eid="PSA 140:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />Ит пу шӱмемлан осал могырыш тайнаш,</para>
  <para style="q1" vid="PSA 140:4">ит пу мылам осалланыше-влак дене пырля сулыкым ышташ,</para>
  <para style="q1" vid="PSA 140:4">нунын тамле сийыштым кочкаш.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Тек мыйым чын ыштыше еҥ наказатла –</para>
  <para style="q2" vid="PSA 140:5">мылам тиде порылык,</para>
  <para style="q1" vid="PSA 140:5">тек мыйым шылтала – тиде эн сай елей,</para>
  <para style="q1" vid="PSA 140:5">мый тидлан тореш ом лий.</para>
  <para style="q1" vid="PSA 140:5">Мыйын кумалмем – осал еҥ-влакын пашашт ваштареш.<verse eid="PSA 140:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Тура кӱ сер гыч вуйлатышышт кудалтыме лийыт,</para>
  <para style="q1" vid="PSA 140:6">тунам чылан умылат: мутем-влак лийыныт лыжга.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />Мемнам пуйто мландым куралыт, тырмалат –</para>
  <para style="q1" vid="PSA 140:7">вес тӱнян умшашкыже шалатен кышкеныт лу-влакнам.<note caller="*" style="f"><char style="fr" closed="false">140:5-7 </char><char style="ft" closed="false">Еврей текстыште нине стих-влакын мом ончыктымыштым умылаш неле.</char></note><verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />Но Тый декет, Господь Юмем, ончалтышем савырем –</para>
  <para style="q1" vid="PSA 140:8">Тылат инанем, аралтыш деч посна мыйым ит кодо!<verse eid="PSA 140:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Мылам шындыме оптышла деч,</para>
  <para style="q2" vid="PSA 140:9">осал еҥ-влакын лӧдышт деч мыйым арале.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Вапшышкышт нуно тек шке логалыт,</para>
  <para style="q1" vid="PSA 140:10">а мый воктечышт эртен каем.<verse eid="PSA 140:10" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="cl">141 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо. Тудын курыкпомышто лиймыж годым кумалмыже.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />Кугу йӱкын Господьым сӧрвален ӱжам,</para>
  <para style="q1" vid="PSA 141:1">кугу йӱкын мый Господьлан кумалам.<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />Тудын ончылно вуйшиймашем йоктарем,</para>
  <para style="q1" vid="PSA 141:2">Тудлан мый шке ойгем почам.<verse eid="PSA 141:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Чонем мыйын улнен,</para>
  <para style="q1" vid="PSA 141:3">но Тый палет илыш корнем.</para>
  <para style="q1" vid="PSA 141:3">Мыйын коштмо корныштем</para>
  <para style="q2" vid="PSA 141:3">нуно мылам лӧдым шынденыт.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Ончем пурла велыш да ужам:</para>
  <para style="q1" vid="PSA 141:4">мый ом кӱл нигӧлан.</para>
  <para style="q1" vid="PSA 141:4">Уке мылам шылын куржмо вер,</para>
  <para style="q1" vid="PSA 141:4">нигӧ мыйын верч ок тургыжлане.<verse eid="PSA 141:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Господь, мый Тыйым сӧрвален ӱжам, тыге ойлем:</para>
  <para style="q1" vid="PSA 141:5">«Тый шылын куржмо верем,</para>
  <para style="q1" vid="PSA 141:5">илыше-влакын мландыштышт мыйын ужашем улат».<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Кол мыйын ӱжын кычкырымем,</para>
  <para style="q1" vid="PSA 141:6">вет ӱнарем йӧршеш пытен.</para>
  <para style="q1" vid="PSA 141:6">Утаре мыйым поктылшем-влак дечын –</para>
  <para style="q1" vid="PSA 141:6">улыт нуно мый дечем виянрак.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Лук казамат гыч мыйын чонем,</para>
  <para style="q1" vid="PSA 141:7">тунам мый Тыйын лӱметым моктем.</para>
  <para style="q1" vid="PSA 141:7">Кунам Тый мылам порылыкым ончыктет,</para>
  <para style="q1" vid="PSA 141:7">йырем чын ыштыше-влак погынат.<verse eid="PSA 141:7" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="cl">142 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо. [Давидым Авессалом эргыже поктен кайыме годым возымо.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Господь, кол мыйын кумалмем!</para>
  <para style="q1" vid="PSA 142:1">Ӱшанле улметлан кӧра колышт сӧрвалыме мутем,</para>
  <para style="q1" vid="PSA 142:1">шке чынлыкет почеш мылам вашеште!<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Шке тарзет ваштареш судым ит тӱҥал –</para>
  <para style="q1" vid="PSA 142:2">чыныш ок лек Тыйын ончылнет иктат.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Тушман покта мыйын чонем,</para>
  <para style="q1" vid="PSA 142:3">мландыш тошкен мыйын илышем –</para>
  <para style="q1" vid="PSA 142:3">тудо мыйым пычкемыш верыш шӱка,</para>
  <para style="q1" vid="PSA 142:3">мый шукертак колышо еҥ гай лийынам.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Ӱнарем йӧршеш пытен,</para>
  <para style="q1" vid="PSA 142:4">мый тӱҥгылген шогалынам.<verse eid="PSA 142:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Шарналтем ожнысо жапым,</para>
  <para style="q1" vid="PSA 142:5">Тыйын пашат-влак нерген шонкалем,</para>
  <para style="q1" vid="PSA 142:5">кидетын чыла мом ыштымыж нерген шонем.<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Тый декет кидемым шуялтем.</para>
  <para style="q1" vid="PSA 142:6">Кузе кошкышо мланде йӱрым вуча,</para>
  <para style="q1" vid="PSA 142:6">туге мый Тый дечет полышым вучем.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Господь, вашке, мыланем вашеште!</para>
  <para style="q1" vid="PSA 142:7">Чонемже мыйын улнен –</para>
  <para style="q1" vid="PSA 142:7">ит шылте чуриетым мый дечем,</para>
  <para style="q1" vid="PSA 142:7">уке гын шӱгарыш волышо еҥ гай лиям.<verse eid="PSA 142:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 142:8" />Эр эрденак пу мылам порылыкет нерген колаш,</para>
  <para style="q1" vid="PSA 142:8">вет мый Тылат инанен илем.</para>
  <para style="q1" vid="PSA 142:8">Кайышаш корным мылам ончыкто, [Господь,]</para>
  <para style="q1" vid="PSA 142:8">Тый декет мый шке чонем кондем.<verse eid="PSA 142:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 142:9" />Господь, тушман-влакем деч утаре,</para>
  <para style="q1" vid="PSA 142:9">Тый гына улат мылам аралтыш.<verse eid="PSA 142:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 142:10" />Туныкто мыйым Тыйын шоныметым шукташ,</para>
  <para style="q1" vid="PSA 142:10">вет Тый мыйын Юмем улат.</para>
  <para style="q1" vid="PSA 142:10">Тек мыйым поро Шӱлышет тӧр корно дене наҥгая.<verse eid="PSA 142:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 142:11" />Господь, шке лӱметлан кӧра мыйым иландаре,</para>
  <para style="q1" vid="PSA 142:11">шке чынлыкетлан кӧра чонем туткар деч утаре.<verse eid="PSA 142:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 142:12" />Ӱшанле Тый улат – тушман-влакем пытаре,</para>
  <para style="q1" vid="PSA 142:12">мыйым шыгыремдылше-шамычым чылаштым кошарте,</para>
  <para style="q1" vid="PSA 142:12">вет мый Тыйын тарзет улам.<verse eid="PSA 142:12" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="cl">143 ПСАЛОМ</para>
  <para style="d">Давидын псаломжо. [Голиаф нерген.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />Моктымо лийже Господь, мыйын кӱ курыкем –</para>
  <para style="q1" vid="PSA 143:1">Тудо кидемым кредалаш,</para>
  <para style="q2" vid="PSA 143:1">парням саргуралым кучаш туныкта.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />Тудо – мылам порым ыштыше, мыйым аралыше,</para>
  <para style="q1" vid="PSA 143:2">Тудо – шылын куржмо верем, Утарышем, авыртышем,</para>
  <para style="q1" vid="PSA 143:2">Тудлан мый инанен илем.</para>
  <para style="q1" vid="PSA 143:2">Тудо калыкем мыйын кид йымакем пуа.<verse eid="PSA 143:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Господь, мо тугай айдеме?</para>
  <para style="q1" vid="PSA 143:3">А Тый тудым шотыш налат.</para>
  <para style="q1" vid="PSA 143:3">Але айдеме эрге?</para>
  <para style="q1" vid="PSA 143:3">А Тый тудын нерген шонет.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Айдеме – шӱлалтыш дене иктак,</para>
  <para style="q1" vid="PSA 143:4">тудын кечыже-влак ӱмыл гай йомыт.<verse eid="PSA 143:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Господь, пӱгыртӧ пылпомышет да воло,</para>
  <para style="q1" vid="PSA 143:5">курык-влак деке тӱкнӧ – тӱҥалыт нуно шикшаш.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Колто волгенчым да тушман-влакетым шалате,</para>
  <para style="q1" vid="PSA 143:6">колто шке пикшетым, нуным чактаре.<verse eid="PSA 143:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />Шуялте шке кидетым кӱшыч да лук мыйым,</para>
  <para style="q1" vid="PSA 143:7">кугу вӱд деч, йот калыкын кидше деч утаре.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Умшашт нунын ойла ондалчыкым,</para>
  <para style="q1" vid="PSA 143:8">кидым нӧлтен товатлымышт шояк.<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Юмем, у мурым Тыланет мурем,</para>
  <para style="q1" vid="PSA 143:9">мурем Тылат лу кылан кӱсле дене,<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />вет Тый кугыжа-влаклан сеҥымашым пуэт,</para>
  <para style="q1" vid="PSA 143:10">осал керде деч Давид тарзетым утарет.<verse eid="PSA 143:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Утаре мыйым, йот калыкын кидше деч нал арален –</para>
  <para style="q1" vid="PSA 143:11">умшашт нунын ондалчыкым ойла,</para>
  <para style="q1" vid="PSA 143:11">кидым нӧлтен товатлымышт шояк.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Тек лийыт эргына-влак одарланыше самырык кушкыл гай,</para>
  <para style="q1" vid="PSA 143:12">ӱдырна-влак – кӱ полатысе чаткатан ыштыме колонно гай.<verse eid="PSA 143:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 143:13" />Клатна-влак лийышт темше,</para>
  <para style="q1" vid="PSA 143:13">ток лийже тӱрлӧ шурно.</para>
  <para style="q1" vid="PSA 143:13">Шорыкна-влак тӱлаҥышт тӱжем дене,</para>
  <para style="q1" vid="PSA 143:13">шотлен пытарыдымын шукемышт кӱтымӧ верыште.<verse eid="PSA 143:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 143:14" />Тек ушкална-влак тӱлывуян лийыт,</para>
  <para style="q1" vid="PSA 143:14">нунын дене эҥгек ынже лий, презым лугыч ынышт кудалте,</para>
  <para style="q1" vid="PSA 143:14">ойгырен кычкырымаш уремлаштына ынже шокто.<verse eid="PSA 143:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 143:15" />Пиалан тудо калык, кӧ тыге ила!</para>
  <para style="q1" vid="PSA 143:15">Пиалан тудо калык, кӧн Юмыжо улеш Господь!<verse eid="PSA 143:15" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="cl">144 ПСАЛОМ</para>
  <para style="d">Давидын моктымо псаломжо.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Мыйын Юмем, мыйын Кугыжам,</para>
  <para style="q1" vid="PSA 144:1">мый Тыйым чапландарем,</para>
  <para style="q1" vid="PSA 144:1">курым-курымеш лӱметым моктем!<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Кажне кечын мый Тыйым моктем,</para>
  <para style="q1" vid="PSA 144:2">лӱметым курым-курымеш чаплем.<verse eid="PSA 144:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />Господь кӱдыратле, моктымашым сулышо,</para>
  <para style="q1" vid="PSA 144:3">Тудын кугулыкшым шымлен пытараш ок лий!<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Тукым гыч тукымыш тӱҥалыт Тыйын пашатым мокташ,</para>
  <para style="q1" vid="PSA 144:4">Тыйын куатет нерген каласкалаш.<verse eid="PSA 144:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />Тыйын кугулыкетын кӱдыратле чапше нерген,</para>
  <para style="q2" vid="PSA 144:5">Тыйын ӧрыктарыше пашат-влак нерген мый шонкалем.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Каласкалаш тӱҥалыт лӱдмашан пашатын куатше нерген,</para>
  <para style="q1" vid="PSA 144:6">ойлаш мый тӱҥалам Тыйын кугулыкет нерген.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Тыйын кугу порылыкетым шарнаш тӱҥалыт,</para>
  <para style="q1" vid="PSA 144:7">Тыйын чынлыкет нерген йывыртен мурат.<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />Господь – поро да чаманыше,</para>
  <para style="q1" vid="PSA 144:8">кужун чытыше да шуко порылыкан.<verse eid="PSA 144:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Господь чыла дек поро,</para>
  <para style="q1" vid="PSA 144:9">чыла шке ыштымыжым Тудо чамана.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Чапла тек Тыйым, Господь, чыла ыштымет,</para>
  <para style="q1" vid="PSA 144:10">ӱшанле-влакет тек Тыйым моктат!<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Тек нуно кугыжанышетын чапше нерген ойлат,</para>
  <para style="q1" vid="PSA 144:11">Тыйын вий-куатет нерген каласкалат.<verse eid="PSA 144:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Куатетым да кугыжанышетын кӱдыратле чапшым</para>
  <para style="q2" vid="PSA 144:12">тек айдеме эрге-влак палат.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Тыйын кугыжанышет курымаш,</para>
  <para style="q1" vid="PSA 144:13">Тыйын озаланымет – тукым гыч тукымыш.</para>
  <para style="q1" vid="PSA 144:13">[Чыла шке мутшылан Господь ӱшанле,</para>
  <para style="q1" vid="PSA 144:13">чыла шке пашаштыже Тудо святой.]<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />Лунчыргышо-влаклан Господь полша,</para>
  <para style="q1" vid="PSA 144:14">пӱгыртымӧ-влакым Тудо чылаштым нӧлталеш.<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Чылаштын шинчашт Тыйын ӱмбакет ӱшан дене ончат –</para>
  <para style="q1" vid="PSA 144:15">Тый нунылан кочкышым шке жапыштыже пуэт.<verse eid="PSA 144:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 144:16" />Чаманыде пуышо кидет дене</para>
  <para style="q2" vid="PSA 144:16">чыла чонаным уло кумылын пукшет.<verse eid="PSA 144:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 144:17" />Чыла шке корныштыжо Господь чын,</para>
  <para style="q1" vid="PSA 144:17">чыла пашаштыже Тудо поро.<verse eid="PSA 144:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 144:18" />Тудым сӧрвален ӱжшӧ-влак деке,</para>
  <para style="q2" vid="PSA 144:18">Тудым чын дене ӱжшӧ-влак деке Господь лишыл.<verse eid="PSA 144:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 144:19" />Тудын деч лӱдшӧ-влакын шонымыштым Тудо шукта,</para>
  <para style="q1" vid="PSA 144:19">полышым йодын кычкырымыштым колеш да нуным утара.<verse eid="PSA 144:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 144:20" />Тудым йӧратыше-влакым Господь чылаштым арала,</para>
  <para style="q1" vid="PSA 144:20">а чыла осал еҥым Тудо пытара.<verse eid="PSA 144:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 144:21" />Тек умшам чапландара Господьым,</para>
  <para style="q1" vid="PSA 144:21">кажне илыше Тудын святой лӱмжым тек курым-курымеш мокта!<verse eid="PSA 144:21" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="cl">145 ПСАЛОМ</para>
  <para style="d">Аллилуия. [Аггей ден Захарийын псаломышт.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Чонем, Господьым мокто!<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Илыме чыла кечыштем мый Господьым чаплем,</para>
  <para style="q1" vid="PSA 145:2">ӱмырем мучко шке Юмем моктен мурем.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />Ида ӱшане тӧра-влаклан, айдеме эрге-влаклан –</para>
  <para style="q1" vid="PSA 145:3">огыт керт нуно утарен.<verse eid="PSA 145:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Кунам лектеш айдемын шӱлышыжӧ,</para>
  <para style="q1" vid="PSA 145:4">тудо угыч мланде пуракыш савырна –</para>
  <para style="q1" vid="PSA 145:4">тиде кечын тудын чыла шонымашыже пыта.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Пиалан тудо, кӧлан Иаковын Юмыжо полша,</para>
  <para style="q1" vid="PSA 145:5">кӧ шке Господь Юмыжлан инанен ила.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Тудыжо кавам, мландым, теҥызым</para>
  <para style="q2" vid="PSA 145:6">да тушто чыла мо улым ыштен.</para>
  <para style="q1" vid="PSA 145:6">Курымешлан Тудо ӱшанле –<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />пызырналтшылан чын судым ышта,</para>
  <para style="q1" vid="PSA 145:7">шужышылан кочкышым пуа.</para>
  <para style="q1" vid="PSA 145:7">Господь петырымаште улшо-влаклан эрыкым пуа,<verse eid="PSA 145:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />Господь сокыр-шамычын шинчаштым почеш,</para>
  <para style="q1" vid="PSA 145:8">Господь пӱгыртымӧ-влакым нӧлталеш,</para>
  <para style="q1" vid="PSA 145:8">Господь чын ыштыше-шамычым йӧрата.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />Господь йотъеҥым арален шога,</para>
  <para style="q1" vid="PSA 145:9">тулык йоча ден тулык ӱдырамашлан полша,</para>
  <para style="q1" vid="PSA 145:9">а осал еҥ-влакым корныштышт йомын коштыкта.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />Господь курымеш кугыжаланаш тӱҥалеш.</para>
  <para style="q1" vid="PSA 145:10">Сион, тукым гыч тукымыш Тудо тыйын Юмет!</para>
  <para style="q1" vid="PSA 145:10">Аллилуия!<verse eid="PSA 145:10" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="cl">146 ПСАЛОМ</para>
  <para style="d">Аллилуия.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Моктыза Господьым!</para>
  <para style="q1" vid="PSA 146:1">Могай сай мемнан Юмынам моктен мураш!</para>
  <para style="q1" vid="PSA 146:1">Тиде чесле, Тудым чаплаш ямле!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Господь Иерусалимым чоҥа,</para>
  <para style="q1" vid="PSA 146:2">шалатен колтымо Израиль калыкшым Тудо пога.<verse eid="PSA 146:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Господь сусыргышо шӱм-чонан-влакым паремда,</para>
  <para style="q1" vid="PSA 146:3">нунын сусырыштым пидеш.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Тудо шӱдыр-влакын чотыштым пала,</para>
  <para style="q1" vid="PSA 146:4">кажныжым лӱмжӧ дене ӱжеш.<verse eid="PSA 146:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Мемнан Господьна кӱдыратле, куатше Тудын кугу,</para>
  <para style="q1" vid="PSA 146:5">уш-акылжым висаш ок лий.<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />Пызырналт илыше еҥым Господь кӱшкӧ нӧлталеш,</para>
  <para style="q1" vid="PSA 146:6">а осал еҥым сӱмырен кудалта.<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />Господьлан тауштен мурыза,</para>
  <para style="q1" vid="PSA 146:7">кӱсле йӱк почеш мемнан Юмылан мурыза!<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />Кавам Тудо пыл дене леведеш</para>
  <para style="q1" vid="PSA 146:8">да мландышке йӱрым колта,</para>
  <para style="q1" vid="PSA 146:8">шочыкта курыклаште шудым,</para>
  <para style="q1" vid="PSA 146:8">[еҥ-шамычлан кочкаш шурным кушта].<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />Вольыклан пуа Тудо кочкышым,</para>
  <para style="q1" vid="PSA 146:9">шужен кычкырыше курныж игымат пукша.<verse eid="PSA 146:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />Ок куане Тудо имньын вийжылан,</para>
  <para style="q1" vid="PSA 146:10">айдемын писе йолжылан –<verse eid="PSA 146:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 146:11" />Господьлан Тудын деч лӱдшӧ еҥ-влак,</para>
  <para style="q2" vid="PSA 146:11">Тудын порылыкшылан инанен илыше-влак келшат.<verse eid="PSA 146:11" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="cl">147 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Иерусалим, Господьым мокто,</para>
  <para style="q1" vid="PSA 147:1">Сион, шке Юметым чапландаре!<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />Капка тӱкылтышетым Тудо пеҥгыдемда,</para>
  <para style="q1" vid="PSA 147:2">калыкетын эргыж-влакым суапландара.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Тыйын мландетлан тынысым пуа,</para>
  <para style="q1" vid="PSA 147:3">эн сай шыдаҥым тыланет пукша.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />Шке мутшым колта мланде ӱмбаке,</para>
  <para style="q1" vid="PSA 147:4">вашке миен шуэш Тудын кӱштымашыже.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />Пуйто ош межым Тудо лумым шара,</para>
  <para style="q1" vid="PSA 147:5">пӧршым пуйто ломыжым йоктара,<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />кинде катыш семын шке шолемжым кышка.</para>
  <para style="q1" vid="PSA 147:6">Тудын йӱштыжым кӧ чыта?<verse eid="PSA 147:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Колта шке шомакшым – чылажат шула,</para>
  <para style="q1" vid="PSA 147:7">пуалыкта шке мардежшылан – да вӱд йога.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Господь увертара шке шомакшым Иаковлан,</para>
  <para style="q1" vid="PSA 147:8">пунчал ден уставшым – Израильлан.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Нимогай вес калыклан Тудо тыгайым ыштен огыл,</para>
  <para style="q1" vid="PSA 147:9">Тудын уставшым нуно огыт пале.</para>
  <para style="q1" vid="PSA 147:9">Аллилуия!<verse eid="PSA 147:9" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="cl">148 ПСАЛОМ</para>
  <para style="d">[Аллилуия.]</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Моктыза Господьым пылпомыш гыч,</para>
  <para style="q1" vid="PSA 148:1">моктыза Тудым кава кӱкшытыштӧ!<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Господьын чыла Суксыжо, Тудым моктыза!</para>
  <para style="q1" vid="PSA 148:2">Тудын кавасе чыла сарзывийже, Господьым моктыза!<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Моктыза Тудым, кече ден тылзе!</para>
  <para style="q1" vid="PSA 148:3">Моктыза Тудым, чолгыжшо шӱдыр-влак!<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Моктыза Тудым, эн кӱшыл кава-влак,</para>
  <para style="q1" vid="PSA 148:4">кава деч кӱшнӧ улшо вӱд-влак!<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Тек моктат Господьын лӱмжым,</para>
  <para style="q1" vid="PSA 148:5">вет Тудо [каласен – нуно ыштыме лийыныт,]</para>
  <para style="q1" vid="PSA 148:5">кӱштен, да нуно шочыныт.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />Курым-курымешлан нуным вераҥден,</para>
  <para style="q1" vid="PSA 148:6">пудырташ лийдыме пунчалым пеҥгыдемден.<verse eid="PSA 148:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Моктыза Господьым, мландымбалне улшо-влак,</para>
  <para style="q1" vid="PSA 148:7">теҥыз янлык ден вӱд келгыт-влак,<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />тул ден шолем, лум ден тӱтыра,</para>
  <para style="q1" vid="PSA 148:8">Тудын кӱштымыжым шуктышо кугу мардеж,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />курык да чыла кӱкшака,</para>
  <para style="q1" vid="PSA 148:9">саскам пуышо пушеҥге ден кедр-влак,<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />янлык ден тӱрлӧ вольык,</para>
  <para style="q1" vid="PSA 148:10">шулдыран кайык ден тыгыде чонан-влак,<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />мландысе кугыжа ден калык-влак,</para>
  <para style="q1" vid="PSA 148:11">вуйлатыше ден судья-шамыч,<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />рвезе ден ӱдыр-влак,</para>
  <para style="q1" vid="PSA 148:12">шоҥгыеҥ ден самырык-шамыч!<verse eid="PSA 148:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Тек нуно чыланат Господьын лӱмжым моктат,</para>
  <para style="q1" vid="PSA 148:13">вет Тудын гына лӱмжӧ кугу да кӱдыратле,</para>
  <para style="q1" vid="PSA 148:13">Тудын чапше – мланде ден кава дечат кӱшнӧ.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Шке калыкшын тӱкыжым,</para>
  <para style="q1" vid="PSA 148:14">шке ӱшанле-влакшын – Израиль эрге-влакын,</para>
  <para style="q1" vid="PSA 148:14">Тудын дек лишке улшо калыкын –</para>
  <para style="q2" vid="PSA 148:14">чапыштым Тудо нӧлталын.</para>
  <para style="q1" vid="PSA 148:14">Аллилуия!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="cl">149 ПСАЛОМ</para>
  <para style="d">Аллилуия!</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Мурыза Господьлан у мурым,</para>
  <para style="q1" vid="PSA 149:1">Тудлан ӱшанле-влакын погынымаштышт чапмурым.<verse eid="PSA 149:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Куаныже Израиль шке Ыштышыжлан,</para>
  <para style="q1" vid="PSA 149:2">Сионын эргыж-влак шке Кугыжаштлан куанышт.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Мурен-куштен, Тудын лӱмжым моктышт,</para>
  <para style="q1" vid="PSA 149:3">тимпан ден кӱсле йӱк почеш Тудлан мурышт.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Вет Господь шке калыкше дек поро кумылан,</para>
  <para style="q1" vid="PSA 149:4">ӱҥышӧ-влакым Тудо утара, нунын чапыштым нӧлта.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Тудлан ӱшанле-влак чапланен йывыртышт,</para>
  <para style="q1" vid="PSA 149:5">шке малыме верыштышт куанышт.<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Юмым чаплымаш лийже нунын йылмыштышт,</para>
  <para style="q1" vid="PSA 149:6">кидыштышт – кок могырымат пӱсемдыме керде:<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />калык-влаклан ӱчым шукташ,</para>
  <para style="q1" vid="PSA 149:7">тукым-шамычлан мутым кучыкташ,<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />нунын кугыжаштым кепшылыш налаш,</para>
  <para style="q1" vid="PSA 149:8">тӧрашт-влакым кӱртньӧ шинчыр дене шинчырлаш,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />возен палемдыме судым нунылан ышташ.</para>
  <para style="q1" vid="PSA 149:9">Тудын чыла ӱшанле еҥжылан тиде чапым конда.</para>
  <para style="q1" vid="PSA 149:9">Аллилуия!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="cl">150 ПСАЛОМ</para>
  <para style="d">Аллилуия!</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Моктыза Юмым Тудын святой верыштыже,</para>
  <para style="q1" vid="PSA 150:1">каваште, Тудын куатшын верыштыже, Юмым моктыза.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Моктыза Тудым вий-куатшылан,</para>
  <para style="q1" vid="PSA 150:2">кӱдыратле улмыжлан Тудым моктыза.<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Моктыза Тудым пуч йӱк дене,</para>
  <para style="q1" vid="PSA 150:3">арфе да кӱсле дене Тудым моктыза.<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Моктыза Тудым тимпаным шоктен да куштен,</para>
  <para style="q1" vid="PSA 150:4">кылан семӱзгар да шиялтыш дене Тудым моктыза.<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Моктыза Тудым йоҥго йӱкан кимвал дене,</para>
  <para style="q1" vid="PSA 150:5">кугу йӱкан кимвал дене Тудым моктыза.<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Кӧ ила да шӱла, тек Господьым мокта!</para>
  <para style="q1" vid="PSA 150:6">Аллилуия!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
  <chapter number="151" style="c" sid="PSA 151" />
  <para style="cl">151 ПСАЛОМ</para>
  <para style="d">[Давидын псаломжо. Голиаф дене кучедалмеке возымо.<note caller="*" style="f"><char style="ft" closed="false">Еврей текстыште тиде псалом уке. Тудым грек текст гыч кусарыме.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 151:1" />Изам-влак коклаште мый эн изи,</para>
  <para style="q2" vid="PSA 151:1">ачамын пӧртыштыжӧ эн самырык лийынам,</para>
  <para style="q1" vid="PSA 151:1">ачамын шорыкшо-влакым мый кӱтенам.<verse eid="PSA 151:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 151:2" />Кидем шиялтышым ыштен,</para>
  <para style="q1" vid="PSA 151:2">парням-влак кӱслем оҥареныт.<note caller="*" style="f"><char style="fr" closed="false">151:2 </char><char style="ft" closed="false">Кӱслем оҥараш – настраивать гусли.</char></note><verse eid="PSA 151:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 151:3" />Кӧ мыйын Господемлан тидым увертара? –</para>
  <para style="q1" vid="PSA 151:3">Господь Шке, Тудо Шке мыйым колын.<verse eid="PSA 151:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 151:4" />Шке уверзыжым Тудо колтен,</para>
  <para style="q1" vid="PSA 151:4">ачамын шорык кӱтӱж деч мыйым налын,</para>
  <para style="q1" vid="PSA 151:4">шке елейже дене шӱрен палемден.<verse eid="PSA 151:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 151:5" />Мотор, кугу капан лийыныт изам-влак,</para>
  <para style="q1" vid="PSA 151:5">но Господь иктыжымат ойырен налын огыл.<verse eid="PSA 151:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 151:6" />Йот тукым еҥ ваштареш мый кредалаш лектынам,</para>
  <para style="q1" vid="PSA 151:6">шояк юмыж-влакын лӱмышт дене тудо мыйым карген.<verse eid="PSA 151:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 151:7" />Но, шупшын налын кердыжым,</para>
  <para style="q1" vid="PSA 151:7">мый вуйжым руал ойыренам,</para>
  <para style="q1" vid="PSA 151:7">Израиль эрге-влак ӱмбач намысым кораҥденам.]<verse eid="PSA 151:7" /></para>
  <chapter eid="PSA 151" />
</usx>