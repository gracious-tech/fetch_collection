<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">Kharam: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">1 Thessalonia</para>
  <para style="toc1">THESSALONIA Mi-ngaidiang Paul Inkhat Changna Chemajia</para>
  <para style="toc2">1 Thessalonia</para>
  <para style="toc3">1 Thes</para>
  <para style="mt1">THESSALONIA</para>
  <para style="mt2">Mi-ngaidiang Paul Inkhat Changna Chemajia</para>
  <para style="imt1">Chonglamsaat</para>
  <para style="ip">
    <char style="bk">Mansakhet Thessalonia mi ngai diangnga chemajia hi</char> Tirton Paul imajia eii (1:1). Hiwahi Paul in imajia Bible suungnga larik inkhat hongka-eii mansakhet chemajia lei-echa halli hiwahi Christa inneisuo kum 51 pheiwei khanna imajia eii. Ama'n hiwa amajiapha Corinthia-ah aleiom. Hiwa chemajia hi Paul in woinihuuina Pathian chuon sina ah ikeithei Thessalonica ah kaom koisuok sik-ah eii (Chuon 17:1-10). Chuontho larik khan hintia aril khachu koisuok hi Jihudi lekkhat li Greek katamkhat in ibool eii.</para>
  <para style="ip">Paul in koisuok keithei suonuk Thessalonica ah kasoot ah leiom matormak khawajarra ama'n hiwa chemajia hi nuk-ah khanna kaom kangamna ngai malung masoknasik ama'n imasuo eii. Hiwa chemajia hin chongmun katamtak khat-um Christian ringkhuo jarra mipui minchuna katamtak incheel. Paul in Christa woini huuina ajuonasik jarra lekkhat enna iril ang. Thessalonia koisuok ah kaom kangamna ngai'n hiwa chongmuntak hin malungkaluut lei-ete. Paul in Christa woini huuina ajuosik hi Pathian malung kamintai ringkhuo ah ringnasik masokna inkhat angnga aleineiman (5:6-8).</para>
  <para style="iot">Asuungnga kaom Chong</para>
  <para style="io1">1. Paul in hiwa chemajia hi koisuok don li inmanisik Pathian minpaak ah aphut <char style="ior">(<ref loc="1TH 1:1-10">1:1-10</ref>) </char></para>
  <para style="io1">2. Halli ama'n ama chuon jarra khat-um Timothy in iheichoi chong ngai jarra arilcheen <char style="ior">(<ref loc="1TH 2:1-3:13">2:1–3:13</ref>) </char></para>
  <para style="io1">3. Anuoiya Christian ringkhuo warra ringnasik ah Jisu woini huuina ajuonasik jarra minchuna anei <char style="ior">(<ref loc="1TH 4:1-5:15">4:1–5:15</ref>) </char></para>
  <para style="io1">4. Paul in woikhat koisuok kha minpaak-ah halli koisuok rakip in chemajia hi teelnasik ah inmanidiang nina aneiya aminhek <char style="ior">(<ref loc="1TH 5:16-28">5:16-28</ref>) </char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Paul le Silas khat-um Timothy in,</para>
  <para style="p" vid="1TH 1:1">Pa Pathian khat-um Pumi Jisu Christa ta ka-eii Thessalonia koisuok mi ngaidiang:</para>
  <para style="p" vid="1TH 1:1">Riangwai khat-um malungkadai kha ningta erase. <char style="rq"><ref loc="ACT 17:1">Chuon 17:1</ref></char><verse eid="1TH 1:1" /></para>
  <para style="s1">Thessalonia ngai Ngamna Khat-um Inringkhuo</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Keini'n Pathian kinnina rakip-ah nangni kinnangaidon, halli pha rakip ah nangni ngai rakipsik Pathian kinminpaak. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Ajarchu eini Pathian khat-um Nipa maikuungnga nangni inngamna kha chuonna ningtho, nangni minriangna khan chuon ranak-ah ningtho, halli Nipumi Jisu Christa diang ningngamna kacheet kha keini'n kinngaidon. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />Ulenai ngai, nangni Pathian in naminriangnga ama sik-ah nangni inakadang kha keini'n kinjet. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />Ajarchu keini'n nangnidiang Chong Kahoi kinheichoi kha, chongbit emak, takkha ranakle inruoiya Ratha Inthiang khat-um khawa akadik puikatung malungthuulna kha-um eii. Keini'n nangnile niom suomlai khan nangni thanasik, angtho thoa kin-omme tikha nangni'n ningjet.<verse eid="1TH 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 1:6" />Nangni'n Poongna akatamtak ningdei innum, Ratha Inthiangnga inphut roknachong akajuo kha ningmujei: nangni'n keini khat-um Pumi omchan kha ningjuijei. <char style="rq"><ref loc="ACT 17:5-9">Chuon 17:5-9</ref></char><verse eid="1TH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 1:7" />Khawa jarra nangni'n Macedonia khat-um Achaia ah kaom akangamna rakipdiang minkhina inkhat kha ning-ejei. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Ajarchu nangni diangnga inphut ah Pumi jarra chong kha Macedonia le Achaia rampumpui inthangbit emak, takkha Pathian ningngamna jar kha-um amun rakip atungjei. Khawa jarra khawa kheella eini'n rilsik arei iteii ommakjei. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Nangnidiang kinhonglai ningnaleidon, halli akatuun le akaringchak Pathian sepa thonasik ah, kutbool pathian ngai ningmathaanna jar, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />halli akajuosik Pathian lunghongna ah inphut nakasanpa, Pathian in kathiya inphut iminring Asapa Jisu kha marwaanna inphut akajuosik ningngaak kha mi rakip in inriljei.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s1">Thessalonia ah Paul Chuontho</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Ulenai ngai, keini'n nangnidiang kinhong kha anemna kaboi emak tikha nangnitak in ningjet.<verse eid="1TH 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 2:2" />Thessalonica ah nangnidiang kinhongma Philippi ah kasetak le jakna kaomtak ah keini innatho kha nangni'n ningjet. Khawa khan naka-en zootmak khatuk intam innum, Pathian diangnga inphut Chong Kahoi nangni diangnga karilsik ah eini Pathian in malung ngarna analeipeii. <char style="rq"><ref loc="ACT 16:19-24">Chuon 16:19-24</ref>; <ref loc="ACT 17:1-9">17:1-9</ref></char><verse eid="1TH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 2:3" />Ajarchu keini'n nangnidiang kinril chonghi akadikmak, emakli inthiangmak malungroonna, tu-inkhat diang um palaak kintho emak. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />Khawa rathuulla, Pathian in keinidiang inamintho zootkha apha rakip ah keini'n kinril, ajarchu ama'n keini chong natansuoa Chong Kahoi karil sik-ah rahoikasuok anamin-ejei. Keini'n miring malung mintainasik ratokmung, takkha kinmalung ka-ensui Pathian malung tainasik kha kinril kha eii. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Keini'n minpaak inleem chongril le inruoiya, emakli phamraikase chong ngai kamakhu keini nangnidiang kinhong emak tihi nangni'n katha ah ningjet, Pathian in keini sakhi eii! <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Nangni chungnga keini Christa tirton kin-ena ranak kinnei innum, tu-inkhat diangnga inphut, nangni diangnga inphut emakli aleiilak diangnga inphut innaminpaak nasik ratokmung, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />keini'n Christa tirton ngai kin-eya nangnidiang chong kinnapemator takkha nu inkhat in asa ngai imarit angnga, keini'n ningkarra kinomlai khannum malung inniam kha kinlei eii. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Ajarchu nangni kinnaminriang jarra Pathian diangnga inphut Chong Kahoi khabit eleiya, keini ringkhuo hi-um napesik kin-insuuk eii, ajarchu nangni kha keini maritkhet ngaikha ninghong ejei. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Ulenai ngai, nangni'n keini angtho thoa chuon kintho halli poongna kindei kha inthiangnga leingaidon ningte! Keini'n Pathian Chong Kahoi kha nangnidiang kinrilpha nangni tu-inkhat um naminpoong maknasik ah suun li zaan chuon kinleitho.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />Kangamna nangni ngaidiang keini omchan kha inthiang, atuun halli kachok ommak tihi nangni'n keini sakhi ning-eii, halli Pathian um eii. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Pa ngai'n insa ngaidiang omchan kathatak intho kha angnga keini'n nangni rakip diangnga omchan katha kintho kha nangni'n ningjet. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Anakakoipa Pathian ama rengram le alurna tum kha munasik ah, halli Pathian malung taina khawa ka-ang ringkhuo khan ningring nasik ah, keini'n nangni kinnamasok, kinnamatheemtai halli nathopiru tia nina kinnanei.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Hanna hiwa aleiilak jarra hin, keini'n apha rakip ah Pathian kha kinminpaak chak. Tichu keini'n Pathian chong kinheichoi hi nangni'n ningjet li chonghi miring ngai diangnga inphut emak takkha Pathian chongtak eii tia nangni'n ningleiralaang, khawakha akatuuntak kha eii. Akangamna nangni karra Pathian in chuon kha itho eii.<verse eid="1TH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 2:14" />Ulenai ngai, Judea ah kaom Pathian koisuok ngaidiang, Christa Jisu mi ka-e ngai diangnga omchan kasuok khale in-ang rip-ah nangnidiang um akasuok eii. Tichu inmani'n Jihudi ngai diangnga inphut poongraalna inmu angnga, nangni um ningrammi ngaidiangnga inphut poongraalna in-angrip kha ningmu eii. <char style="rq"><ref loc="ACT 17:5">Chuon 17:5</ref></char><verse eid="1TH 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 2:15" />Pumi Jisu li ama chongkachoi ngai kaleithat Jihudi mi ngaikhan keini um innaminpoong. Inmani'n angtuk mi rakip kha inlei-inhalpuime! Pathian malungkha angtuk inleiminhoipi makme! <char style="rq"><ref loc="ACT 9:23">Chuon 9:23</ref>,<ref loc="ACT 9:29">29</ref>; <ref loc="ACT 13:45">13:45</ref>,<ref loc="ACT 13:50">50</ref>; <ref loc="ACT 14:2">14:2</ref>,<ref loc="ACT 14:5">5</ref>,<ref loc="ACT 14:19">19</ref>; <ref loc="ACT 17:5">17:5</ref>,<ref loc="ACT 17:13">13</ref>; <ref loc="ACT 18:12">18:12</ref></char><verse eid="1TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 2:16" />Zaatlop ngaidiang sanminringna heikachoi sik chong kinwarilsik kha-um inmani'n leizootmu. Inmani'n apha rakip ah intho manu ngaikha hin-inthoa pui-inmintungjei. Halli tuunchu ahekna ah Pathian raangna kha inchungnga ajuotungjei.<verse eid="1TH 2:16" /></para>
  <para style="s1">Paul in Inmani inlet-ah phasik Imanuom</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Ulenai ngai, keinisik achu, nangni diangnga inphut phabong khat ni-inthenpha, keini malungngaidon nachu ka-emak, takkha taksa bit-ah keini'n nangni kha angtuk kinnamu zootme halli woikhat namunasik angtuk ranak kinsongme! <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Nangnidiang hongkir nooksik hi keini'n kinmanuom. Kei kapumtak in inlet inlet-ah hongsik kalei-insuuk, takkha Seitan in kinlam analeikhanjei. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Nipumi Jisu ajuopha ama maikuungnga, kinraal matorna jarra kin in-orna, kinrokna khat-um kin-inngamna kha nangni jarra eii, nangni hi aleiilak ngaineek ah akatasam emakchu. <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Inthiangtak-ah, keini in-orna li roknachu nangni ning eii.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Ajarchu ajuohekna-ah, keini'n kasoot deimator khaimungnga, keini innibit Athenna omsik hi kinminthajei. <char style="rq"><ref loc="ACT 17:15">Chuon 17:15</ref></char><verse eid="1TH 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 3:2" />Halli Christa jarra Chong Kahoi kinrilla keinile Pathian sik-ah kinchuon thopui eini ulenai Timothy kha kinheitirjei. Ama hi nangni inngamna tiang kanaminngarsik khat-um anakasansik kinheitir eii, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />Kha e-inchu hiwa poongraalna hin ajar eya nangni tuteii in nuktiang kirnutunjei. Hiwa ka-ang poongraal deisik hi einisik ah Pathian lungdou eii ti ningtheinuoa ningjet. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Keini'n phabong khat kinnaleiompui laikhan, eini innaminpoongsik eii tia apha matiang kinnaleirilpi kha, nangni'n kathatak-ah ningjet khawatak kha juokasuok ejei. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Khawa jarra kei'n kasoottak deimator khaimongnga, Timothy kha kei'n kaheitir ejei. Seitan in nangni kha naleimatheem jeite, halli nichuontho kha-um anemna kaboi esikbe tia kachi jarra kei'n nangni inngamna jetnasik ah ama hi kaheitirjei!<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />Tuunchu Timothy aheikirjei, nangni ning-inngamna li ning-inriangna jarra chongkahoi ngaikha keinidiang aheichoijei. keini'n nangni kinnamuzoot angnga nangni'n um keini naleimuzoot ningte apha rakip khan katha ah ningnangaidon tia keinidiang um ajuoriljei. <char style="rq"><ref loc="ACT 18:5">Chuon 18:5</ref></char><verse eid="1TH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 3:7" />Khawa jarra ulenai ngai, keini poongna le raalna rakip khan nangni jarra kinmalungnga ratharokna kinnei. Kinratha roknahi ning-inngamna jarra eii. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Ajarchu nangni'n ningringkhuo ah Pumi le inchunna kacheet-ah ningngir jarra keini tuun inthiangnga kinlaring. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Khawa jarra tuunchu keini'n nangni jarra eini Pathian kha minpaak matorna kinneijei. Nangni jarra Pathian maikuungnga rokna kinnei jarra ama kinminpaak. <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Keini'n nangni kha ningpumtak ah inmupui nasik khat-um angme nangni ngamna khan arei kaom rakip kinnape matornasik, suun li zaan amadiang kinmalung pumpuiya kinnichak-ah kinleiom.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Keini'n nangnidiang kinhongnasik lamkha, eini Pumi Jisu khat-um eini Pathian le Nipa amatak in naboolpi kha etarase. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Keini'n nangni kinnaminriang angnga, nangni khat li khat sik halli mi rakipsik ningminriangna kha kheel kheella insoonnasik Pumi'n inaboolpi erase. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Eini Pumi Jisu ami ngai rakiple inruoiya ajuopha, eini Pathian khat-um Nipa maikuungnga nangni inthiang le puikatung enasik hinthoa ama'n nangni naminngarsik eii.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s1">Pathian Malung Kamintai Ringkhuo Inkhat</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Ajuohekna ah ulenai ngai, nangni'n keini diangnga inphut angtho-thoa Pathian malung kamintai ringkhuo ah ringnasik ah ning-inchu angnga. Adik, hiwahi, nangni'n hiwa ringkhuo lam hin ninglaring, tuunchu nangni'n Pumi Jisu ramingnga kheella thonasik ah keini'n nina khat-um masokna kinnanei. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Ajarchu Pumi Jisu ranak khan nangni kinnaminchuna ngaikha nangni'n ningjet. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Nangni inthiangsik khat-um zool-inthaiya inphut pum-inthiang inthiang sik hi Pathian imanuom kha eii. <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />Inkanei pasal nangni rakip in ningnumei le inthiang khat-um kaya kaomma karing ning-inchu sik eii, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />Pathian kajetmak zaatlop ngai'n taksa imanuom lamma inring kha emaru. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />Hiwa jarra, nangni tu inkhat innum Christian inkhat diang akatuunmak thomarasu emakli inmani chungnga nemna leimarasu. Khawa katho ngaikha Pumi'n arachaaksik eii tihi matiang khan keini'n kinleiriljei halli keini'n nangnidiang kanatak-ah chongpena kinaleineijei. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Pathian in eini omchan inthiangmak ah kaom sik-ah inakoi emak, takkha inthiang sik-ah inakoi eii. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Khawa jarra tu e-innum hiwa minchuna kajuimak mi khan miring minchuna ijuimak emak, takkha ama Ratha Inthiang nakapeii Pathian minchuna ijuimak eii.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Nangni inkhat li inkhat inriang nasik jarra majiasik arei ommakjei. Ajarchu nangni inkhat li inkhat angtho-thoa inriang sikme tihi nangni ningpumtak diang Pathian in anaminchu suojei. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Macedonia ah kangamna rakip diang nangni'n hika-ang inthiang omchan katha ningthojei. Khawa jarra ulenai ngai kakheel doomma omchan katha ningthosik hi kinamasok eii. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />Matiangnga kinnaleirilpi angnga, ringkhuo kahoiya omnasik, ningchuon ningchuon inngaidonru halli ningtheinuoa ringnasik inthoru. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />Hinthoa nangni'n akangamna makngai diangnga inphut kayana ningmusik eii khat-um nangnisik ah angme arei kaom kha tu inkhat diang-um inngaimak kha ning esik eii.<verse eid="1TH 4:12" /></para>
  <para style="s1">Pumi Juona sik</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Takkha ulenai ngai inngamna kaneimak ngai angnga ninmalung minpoong maknasik, akathi ngai jarra inthiang kha nangni'n ningjetsik hi keini'n kinmanuom. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Jisu hi athijei halli aringnook jei tihi eini'n ningamna, khawa jarra ama kangamna-ah akathi ngaikha Jisu le inruoiya Pathian in aruoisik eii tihi ningamna eii.<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />Ajarchu tuunna angme keini'n kinnaminchu hi Pumi minchuna kha eii: Pumi ajuoni, aleikaringnga kaom eini'n, aleikathi ngai neek-ah ma-sanumin. <char style="rq"><ref loc="1CO 15:51">1 Cor 15:51</ref>,<ref loc="1CO 15:52">52</ref></char><verse eid="1TH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 4:16" />Ajarchu Pumi apumtak Marwaanna inphut oong rasale, marwaan tirton kaliankhetpa rasa khat-um Pathian tampaloi rasale inruoiya ajuochumsik eii. Halli Christa kangamna-ah aleikathi ngaikha ma-insa-ah aminringsik eii, <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />khawapha takkhan eini aleikaringseng in intuupnita inmanile inruoiya suumphai chungnga Pumi inmupui nasik lairalak ah nikalsik ejei. Halli Pumi le inruoiya hektik neileiya niomsuom sik ejei. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Khawa jarra hiwa chong ngai hin nangni inkhat li inkhat malung insoknaru.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s1">Pumi Juona sik Inringchak</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Ulenai ngai, apha khat-um kumli tha ngai jarra angtikme hiwa ngai kasuoksik nangnidiang heimajiasik rangaimakjei.<verse eid="1TH 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 5:2" />Ajarchu inruup inkhat in zaanna iheiwa angnga Pumi Nikhuo kha ajuotungsik eii tihi nangni'n inthiangnga ningjet. <char style="rq"><ref loc="MAT 24:43">Matt 24:43</ref>; <ref loc="LUK 12:39">Luk 12:39</ref>; <ref loc="2PE 3:10">2 Pet 3:10</ref></char><verse eid="1TH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 5:3" />Mi ngai'n, “Angrakip adaijei khat-um chisik ommak jei,” inti pha, jetlei-theileiya inmangna kha inmani chungnga ajuosik eii. Nai kaneisik numeisa inkhat chungnga jetlei-theileiya naiha kana kahong angnga Pumi Nikhuo kha-um ajuosik eii, halli khawa kha inmani'n inlit matornunu. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Takkha ulenai ngai, nangnichu akaziingnga kaom emakchu jei, inruup khan nangni naminlai angnga khawa Nikhuo khan nangni naminlai marase. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Ajarchu nangni rakip suunta ka-eii, war mi ngaikha ning-ejei. Eini zaan mi emakmi emakli akaziingta emakmi. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Khawa jarra, aleiilak ngai angnga zaalkhai mui; eini harchakrui halli inringchakrui. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Zaan phakhan mi ngai'n inzaal; halli ju-inrui mi ngaikhan Zaankhan in-inrui.<verse eid="1TH 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 5:8" />Takkha eini suun mi ni-eii, halli eini ni-inringchak sik eii. minriang li ingamna hi eini'n phou nimin-esik eii, halli sanminringna inngamna kha raallukhu nimin-esik eii. <char style="rq"><ref loc="ISA 59:17">Isa 59:17</ref>; <ref loc="EPH 6:13-17">Eph 6:13-17</ref></char><verse eid="1TH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 5:9" />Pathian in eini hi ama raangna kha kamusik-ah inakadang emak, takkha eini Nipumi Jisu Christa jarra sanminringna kamusik ah inakadang ejei, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Ama ajuopha, eini nileithi emakli nileiring innum, amale inruoiya niring suomnasik ah ama'n einisik anathipi jei. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Khawa jarra nangni'n tuunna ningtho angnga, inkhat li inkhat insanru halli inkhat li inkhat malung insokru.<verse eid="1TH 5:11" /></para>
  <para style="s1">Ahekna Minchuna li Minpaakna chong ngai</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Ulenai ngai, Christian ringkhuo tiang nangni karra chuon katho ngai, nangni kanaminchu khat-um lamkakei ngaikha akatha ah khoya thoru tia nangnidiang nina kinheinei. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />Inmani'n khawa chuon intho jarra minriangna le inruoiya kheella inmani kha khoya thoru. nangni karra akadai omrase.<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />Ulenai ngai, keini'n nangni masokna kinheinei, akadool ngaikha rakookru, akachi ngaikha malung minngarpiru, akasuol ngaikha sanru, mirakip le kadeiraat eru. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Tu inkhat innum akathamak kha akathamak khan mi inkhat diang maletkir marase, takkha apha rakip-ah mi rakip diang halli inkhat li inkhat diang katha thonasik entokru.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />Apha rakip ah rokru, <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />inchat omleiya niru, <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />angrakip-ah minpaakru. Hiwahi Christa Jisu diang nangni sik-ah Pathian lungdou kha eii.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Ratha Inthiang kha minnuor maru; <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Pathian chongkachoi ngai chong ngaikha ralaangmak thomaru. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Takkha chong rakip ngaikha enminru: akatha kha kacheet-ah mahuumru <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />halli akathamak rakip ngaikha mathaanru.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Kadai kanape Pathian ama khan, nangni kha angrakip-ah naminthiang rase, halli eini Nipumi Jisu Christa ajuopha khan. Ningratha, ningringphuuk, khat-um ningtaksa pumpui kha inthiangnga nadarase, <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Nangni kanakoipa kha ngamna kaom ejarra, ama'n khawakha anathopisik eii.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Ulenai ngai, keinisik um nanipiru.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Inthiang inzoople inruoiya kangamna rakip khoya inthoru.<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />Hiwa chemajia hi kangamna rakip diang teelpinasik kei'n Pumi thomatorna ranak khan nangni masokna kaheinei.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Nipumi Jisu Christa riangwai khan nangni kha naompui rase.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>