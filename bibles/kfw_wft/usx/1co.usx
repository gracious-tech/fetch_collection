<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">Kharam: Bible Translation 1st Edition.</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">1 Corinthia</para>
  <para style="toc1">CORINTHIA Mi-ngaidiang Paul Inkhat Changna Chemajia</para>
  <para style="toc2">1 Corinthia</para>
  <para style="toc3">1 Cor</para>
  <para style="mt1">CORINTHIA</para>
  <para style="mt2">Mi-ngaidiang Paul Inkhat Changna Chemajia</para>
  <para style="imt1">Chonglamsaat</para>
  <para style="ip">
    <char style="bk">1 Corinthia larik hi Jisu Christa inneisuo kum soomra-nga leira-nga thengnga tirton Paul in imajia eii (1:1). </char> Hiwa larik hi Corinthia koisuok diang Paul in larik inni amajiana karra mansakhet kha eii. Paul in Ephesus ah aleiomlai khan hiwa larik hi imajia eii, ama'n Macedonia tiang asina lamma Corinth hi aluutmadet imajia larik eii (16:5-9).</para>
  <para style="ip">Hiwa larik hi Paul in Corinthia koisuok suungnga miring lekkhat ngai'n nunchan kadikmak chuon intho khawa ngai khachu koisuok suungnga inkhoithen khat-um zool-inthai chuon ngai jarra ajet jarra imajia eii. Corinth khuopui hi zool-inthai chuonna araming kasi khuopui alei eii, halli koisuok suungnga um hiwa chuon ngai kasuok hi inlei-intongpui.</para>
  <para style="ip">1 Corinthia larik hi inriang jarra iril akalokkhet arup inchen (13).</para>
  <para style="iot">Asuungnga kaom Chong</para>
  <para style="io1">1. Paul in Corinthia mi ngai donna khat-um inmani jarra Pathian minpaakna <char style="ior">(<ref loc="1CO 1:1-9">1:1-9</ref>)</char></para>
  <para style="io1">2. Hiwa thengnga Paul in Corinthia koisuok suungnga kasuok inkhoithen jarra amajia <char style="ior">(<ref loc="1CO 1:10-4:21">1:10–4:21</ref>)</char></para>
  <para style="io1">3. Hiwa thengnga Paul in zool-inthai khat-um miring inkhat in miring inkhat kha chongtanna munna iruoi jarra amajia <char style="ior">(<ref loc="1CO 5-6">5–6</ref>)</char></para>
  <para style="io1">4. Hiwa thengnga Paul in moiruoi, kut-ah inbool ramil diang phurpeii, mipui chubei, Ratha kutchoi khat-um hongring nookna jarra amajia <char style="ior">(<ref loc="1CO 7-15">7–15</ref>)</char></para>
  <para style="io1">5. Paul in inthosik kasuok chuon khat-um apumtak jarra amajia-ah minhekna anei <char style="ior">(<ref loc="1CO 16">16</ref>)</char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Pathian lungdou nuoiya Christa Jisu tirton sik-ah ikoi, Paul khat-um einile unai ka eii Sosthenes in,<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Corinthna kaom Pathian koisuok ngaidiang, Jisu Christa diangnga inthiangjei, halli amun rakip-ah eini khat-um inmani Pumi ka-eii, Pumi Jisu Christa ramingnga chubei katho sik-ah ikoi rakip ngaidiang: <char style="rq"><ref loc="ACT 18:1">Chuon 18:1</ref></char><verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Riangwai khat-um kadai kha nipa Pathian khat-um Pumi Jisu Christa in nangnidiang innapeii erase.<verse eid="1CO 1:3" /></para>
  <para style="s1">Christa diangnga inphut Rawaan</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Christa Jisu diangnga inphut Pathian rawaan kha nangnidiang nape jarra, kei'n nangni sik-ah apha rakip-ah Pathian kaminpaakchak, <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Ama diangnga inphut, chongrilla khat-um singna theina le inruoiya angrakip-ah nangni'n ning-inchongjei. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Christa jarra sakhi kha-um nangni karra arajung cheetjei. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Nangni'n eini Pumi Jisu Christa inlarsik kha ningngaak le inruoiya nangni'n Pathian kutchoi kamusik iteii inngamsamna ommakjei; <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />khachu eini Pumi Jisu Christa nikhuoni khan nangni iteii ningthosial ommak nasik, ama'n nangni kha ahekna katung kacheet-ah anamin-ngirsik eii. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Asapa Jisu Christa eini Pumi, khale inchun sik-ah kanakoi Pathian amakha ngamna kaom eii.<verse eid="1CO 1:9" /></para>
  <para style="s1">Koisuok Suungnga Inkhoithen</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Ule nai ngai, eini Pumi Jisu Christa ramingnga nangni rakipdiang kei'n kanati, khachu nangni karra inkhoithen ommaknasik, takkha malung khat-um chongtan inkhat bit-ah ningom nasik-ah inchunru khat-um inzootnaru. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Ajarchu ule nai ngai, Chloe insuungkhur mi ngai'n nangni karra insuol inseiina om iti chongkha keidiang inhongmintungjei,<verse eid="1CO 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 1:12" />Kei itizoot chu hi-eii, khachu “Keichu Paul mi ka eii,” “Keichu Apollos mi ka eii,” “Keichu Cephas mi ka eii,” “Keichu Christa mi ka eii” nangni rakip in ningti. <char style="rq"><ref loc="ACT 18:24">Chuon 18:24</ref></char><verse eid="1CO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13" />Christa inkhoithen nabe?<note caller="+" style="f"><char style="fr" closed="false">1:13. </char><char style="fq" closed="false">Christa inkhoithen nabe? </char><char style="ft" closed="false">manuscript lekkhat inchu hintia injia </char><char style="fqa" closed="false">Christa khoithen thamak.</char></note> Paul kha nangni sik-ah cross-ah inthat abe? emakli Paul ramingnga nangni'n baptize ningtho abe?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />Kei'n Crispus li Gaius elekleiya nangni tuteii-um baptize kinaleimintho makkha kei'n Pathian kaminpaak.<verse eid="1CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 1:15" />Khawa jarra nangni tuteii innum kei ramingnga baptize kintho eii titheinutun. <char style="rq"><ref loc="ACT 18:8">Chuon 18:8</ref>; <ref loc="ACT 19:29">Chuon 19:29</ref>; <ref loc="ROM 16:23">Rom 16:23</ref></char><verse eid="1CO 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 1:16" />(Adik, kei'n Stephanas khat-um ama insuungkhur chu baptize kamintho, takkha leiilaakchu kei'n baptize kaminthobe tikha kei'n ngaidon matormongjei.) <char style="rq"><ref loc="1CO 16:15">1 Cor 16:15</ref></char><verse eid="1CO 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 1:17" />Ajarchu Christa in kei baptize kamintho sik-ah najuotir kha emong takkha Christa in cross-ah ithikha anemna kaboi emaknasik, Pathian chongkahoi kha miring lungsing lungwarra elekleiya akaril sik-ah najuotir kha ka-eii.<verse eid="1CO 1:17" /></para>
  <para style="s1">Christa hi Pathian Ranak khat-um Lungsing lungwar kha eii</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Cross-ah Christa thina thurchi kha akamangngai sik-achu chongriam eii, takkha sanminringna kamujei eini sik-achu Pathian ranak eii.<verse eid="1CO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 1:19" />Ajarchu hintia injiajei,</para>
  <para style="q1" vid="1CO 1:19">“Kei'n akasingngai lungsing lungwar kha kaminmangsik eii,</para>
  <para style="q2" vid="1CO 1:19">halli kathei ngai jetna kha kei'n nemna minomnuning.” <char style="rq"><ref loc="ISA 29:14">Isa 29:14</ref></char><verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />Akasing mikha hun ommejei? dan karu kha hun ommejei? hiwa khangnga murruolsiak kathopa kha hun ommejei? Pathian'n manmasituol lungsing lungwar kha aka-am iminchang emak abe? <char style="rq"><ref loc="JOB 12:17">Job 12:17</ref>; <ref loc="ISA 19:12">Isa 19:12</ref>; <ref loc="ISA 33:18">33:18</ref>; <ref loc="ISA 44:25">Isa 44:25</ref></char><verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />Pathian lungsing lungwar dungjui achu, manmasituol lungsing lungwar kha'n Pathian kha injet emak, takkha chongriam eii inti keini iril chongkhan Pathian malung tai, halli ka-ngamna mi ngaikha Pathian'n sansik a-ngaidon. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Jihudi ngai'n inlak chuon inmanuom halli Greek mi ngai'n lungsing lungwar in-entok, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />takkha keinichu Jihudi ngaidiang ka-ook khat-um zaatlop ngaidiang chongriam ka eii, Christa in cross-ah ithi jarra kinril. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Takkha Jihudi li Greek inchun tia ikoi ngaisik achu, Christa hi Pathian ranak khat-um Pathian lungsing lungwar kha eii. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Ajarchu Pathian mona kha manmasi lungsing lungwar neek-ah singwiai, khat-um Pathian ngarmakna kha manmasi ngai ngarna neek-ah ngarwiai.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Ule nai ngai, Pathian in nangni anakoi nakha ngaidonru; nangni katamtak manmasi singna theina kanei emakchu, nangni katamtak thomatorna ranak kanei emakchu, nangni katamtak kalok-kalian emakchu; <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />takkha Pathian'n manmasituolla aka-am ngaikha akasing ngai minjaknasik akadang, Pathian'n manmasituolla kajeimak ngaikha kangarngai minjaknasik akadang. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Hinthoa manmasituolla insaangkhet in-eii tia inngaidon ngaikha minmangnasik, manmasituolla iteii emu tia inngaidon mi ngaikha Pathian in akadangjei, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />hiwahi tuteii innum Pathian maikuungnga in-or ommak nasik eii. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Pathian hi Christa Jisu diang nangni ringna kha eii, Pathian in Christa kha eini lungsing lungwar, eini dikna, eini inthiangna khat-um eini namasuona kha min-ejei;<verse eid="1CO 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 1:31" />Khawa jarra, hintia injiajei, “In-or miring khan, Pumi diang in-or rase.” <char style="rq"><ref loc="JER 9:24">Jer 9:24</ref></char><verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s1">Cross-ah Inthat Christa jarra Chongpui</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Ule nai ngai, kei'n nangnidiang kaheiwa laikhan, Pathian jarra sakhi kha<note caller="+" style="f"><char style="fr" closed="false">2:1. </char><char style="fq" closed="false">chong inthuuk </char><char style="ft" closed="false">manuscript lekkhat inchu hintia injia </char><char style="fqa" closed="false">Pathian jarra sakhi.</char></note> kei'n chong inthuuk khat-um manmasi lungsing lungwar chongnga nangnidiang rilmong. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Ajarchu kei'n nangnile kaom suungseng Jisu Christa khat-um cross-ah athina jarra elekleiya kei'n iteii jetzootmong.<verse eid="1CO 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 2:3" />khawa jarra kei'n nangnidiang kaheiwa laikhan kei'n ranak kaboi, kachi khat-um intuul le inruoiya kaheiwa; <char style="rq"><ref loc="ACT 18:9">Chuon 18:9</ref></char><verse eid="1CO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 2:4" />halli kei chongril khat-um chongpui ngaikha inthuuk khat-um manmasi lungsing lungwar chongnga rilmong, takkha Pathian Ratha ranak nuoiya kaleiril, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />ajarchu nangni ngamna kha manmasi lungsing lungwarra elekleiya takkha Pathian ranak dungjuiya enasik eii.<verse eid="1CO 2:5" /></para>
  <para style="s1">Pathian Lungsing lungwar</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Ratha lamtiang kachangjei inmani ngaidiang chu keini'n lungsing lungwar chongnga kinril, takkha akalamangsik hiwa khangnga waikaroon ngai khat-um hiwa khangnga lungsing lungwar dungjuiya emak. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Takkha Pathian'n manmasituol abool ma-ah eini lurna lianna sik-ah i-ngaidonjei mit-ah nimumak inthuuk Pathian lungsing lungwar dungjuiya kinril eii. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Hiwa khangnga waikaroon tuteii innum hiwahi leijetmu; inmani'n inleijet inchu, inmani'n akalur Pumi kha cross-ah leithatnunu.<verse eid="1CO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 2:9" />Takkha, hintia lei-injiajei,</para>
  <para style="q1" vid="1CO 2:9">“Tuteii mit-in inlamumak, tuteii kuor-in inlajetmak,</para>
  <para style="q2" vid="1CO 2:9">manmasi tuteii malung innun i-ngaidonmak,</para>
  <para style="q2" vid="1CO 2:9">kha Pathian'n ama kaminriang ngaisik-ah aminsuuk pijei.” <char style="rq"><ref loc="ISA 64:4">Isa 64:4</ref></char><verse eid="1CO 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10" />Takkha<note caller="+" style="f"><char style="fr" closed="false">2:10. </char><char style="ft" closed="false">Takkha; </char><char style="ft" closed="false">manuscript lekkhat inchu hintia injia </char><char style="fq" closed="false">ajarchu.</char></note> Pathian'n Ratha diangnga inphut einidiang hiwa ngaihi amalar ajarchu Ratha khan angrakip entok, Pathian inthuukna kha-um entok. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Miring ratha khan ama i-ngaidon rakip kha ijet angnga, Pathian Ratha bitkhan Pathian i-ngaidon kha ajet. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Eini'n niralaangjei Ratha hi manmasituol ratha kha emak takkha Pathian diangnga kajuo Ratha kha eii, hiwahi Pathian in einidiang inapejei rakip ngaihi nijet mintung nasik eii.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Manmasi naminchu lungsing lungwar khan keini'n rilmung, takkha Ratha naminchuna chong ngaikhan Ratha kamujei mi ngaidiang ratha lamtiang kadikkha kinril.<note caller="+" style="f"><char style="fr" closed="false">2:13. </char><char style="ft" closed="false">Ratha kaneijei miring ngaidiang; </char><char style="ft" closed="false">emakli </char><char style="fqa" closed="false">Ratha'n inapeii chong ngaikhan.</char></note> <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Ratha kaneimak mi ngaikha'n Pathian Ratha diangnga inphut kajuo kutchoi ngaikha mumatormu, khawa jarra inmani sik achu kutchoi ngaikha nemna ommak, ajarchu kutchoi ngaikha Ratha kamu ngai inbit jetmatorna innei. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Ratha kanei miring kha'n angrakip chungnga chongtan, takkha ama chu manmasi tuteii chongtan nuoiya ommak.<verse eid="1CO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 2:16" />Pathian chong inthiang khan ati,</para>
  <para style="q1" vid="1CO 2:16">“Tume Pumi malung kha kajet?</para>
  <para style="q2" vid="1CO 2:16">Tume ama kaminchu mator?”</para>
  <para style="m" vid="1CO 2:16">Takkha einichu Christa malung kha niroon. <char style="rq"><ref loc="ISA 40:13">Isa 40:13</ref></char><verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">Pathian Suokngai</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Ule nai ngai, kei'n nangnidiang Ratha kasip mi ngaidiang kiril angnga rilnuning, takkha taksa mi ngaidiang inril angnga, Christa diang kaladoong naipang ngaidiang kiril angnga rilkate.<verse eid="1CO 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 3:2" />Kei'n nangni burumma nawaimong ranutuiya nangni kanawai; ajarchu khawa sik-ah nangni la-insuukmakchu; tuun katung nangni'n la-insuukmakchu, <char style="rq"><ref loc="HEB 5:12">Heb 5:12</ref>,<ref loc="HEB 5:13">13</ref></char><verse eid="1CO 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 3:3" />Nangni tuunkatung taksa mi ningla-eii. Ajarchu nangni suungnga in-enzootmakchu khat-um ning-insuol, tuunkatung taksa miring omchan angnga ningla omchei, hiwa jarra nangni taksa mi emak chuwabe?<verse eid="1CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 3:4" />Ajarchu miring khat-in ati, “Kei Paul mi ka-eii,” leiilaak-in, “Kei Apollos mi ka-eii,” nangni taksa mi la-emak chuwabe? <char style="rq"><ref loc="1CO 1:12">1 Cor 1:12</ref></char><verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Tume Apollos? Tume Paul? Pathian suok kin eii, nangni'n inmani diangnga inphut ngamna ningmu. Eini rakip in Pumi'n thoru tia inapeii chuon dungjuiya nitho eii. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Kei'n aru kawor, Apollos in tui sou, takkha Pathian eii kaminmoongnga kaminlokchu. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Khawa jarra akaling khat-um tuikasou inmani kha iteii emu, takkha kaminmoongnga kaminlok Pathian khakeeng arei ka-echu. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Akaling khat-um tuikasou inmani innikha in-angrip, inchuontho dungjuiya inmani'n inthoman inchangsik eii. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Eini ngaihi Pathian chuon kathosuom mi ngaikha ni eii; nangni ngaihi Pathian leimun khat-um Pathian inn ning-eii.</para>
  <para style="p" vid="1CO 3:9">... <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />Keidiang inapeii Pathian rawaan dungjuiya, inn kasak kathei angnga kei'n innmunkha kadeeng, halli miring inkhat in khawa chungnga inn asak, khawa chungnga kasak mi rakip in katha-ah sakrasu. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Kaleiomjei innmunkha Jisu Christa eii, halli tuteii innum leiilaak inmun inkhat deengtheinuni. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Tuun miring inkhat tak-in inn munkha soonna, dangka, lungman katam, thing, na-i khat-um saponna adeeng inchu <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />inchuontho inchuontho ngaikha indangsik eii; ajarchu Christa Nikhuo nikhan amalarsik eii, ajarchu mirakip chuontho ngaikha mei-in alamalarsik eii. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Tu ka-ang miring khan innmun makheiya isak kha mei-in kaangmak inchu, ama'n achuonthoman achangsik eii. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Takkha achuontho kha akaang inchu, ama'n amangsik eii; ama apumtakchu aringsik eii, takkha mei machuon makheiya iheisuok angnga aringsik eii.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Nangnihi Pathian Biak-inn ning-eii khat-um Pathian Ratha'n nangni suungnga om tihi nangni'n ningjetbo? <char style="rq"><ref loc="1CO 6:19">1 Cor 6:19</ref>; <ref loc="2CO 6:16">2 Cor 6:16</ref></char><verse eid="1CO 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 3:17" />Pathian Biak-inn kaminmang ama kha, Pathian innum aminmangsik eii. Ajarchu Pathian Biak-inn chu inthiang kha eii, halli khawa Biak-inn kha nangni ning-eii.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Tuteii innum apumtak lamleiitiang inkeiruoi marase. Nangni karra hiwa khang hinchu akasing ka eii tia angaidon inchu, ama kha'n akasing ahong enasik aka-am kha emasa rase. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Hiwa manmasituol lungsing lungwar hichu Pathian mit enna nemna kaboi kha eii. Ajarchu hintia injiajei, “Ama'n akasing ngaikha inmani singna theina ngaikhan asur,” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />khale inruoiya, “Pumi'n akasing mi ngai i-ngaidon kha lailam eii tikha ajet.” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Khawa jarra, tuteii miring innum manmasi singna theina khan in-or marase. Ajarchu ang rakip nangnita ejei, <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Paul, Apollos, Cephas, hiwa manmasituol, thina li ringna, tuun khat-um akahongsik, hiwa rakip ngaihi nangnita ejei; <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />halli nangni Christa mi ning-eii, halli Christa hi Pathian mi eii.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s1">Christa Tirton ngai</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />keini ngaihi Christa suokngai khat-um Pathian dikna inthuuk kaminchusik chuonmi ngaikha kin-eii tia nangni'n nangaidonru. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Suok ngaidiang arei ka-e khachu inmani karu ngaidiang huoikajuo esik hi eii. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Keidiang nangni'n chong ningtan khat-um manmasi singna theina-ah chong ningtan kha kei iteii ngaidonmong. Kei kapumtak innum chong intanmong. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Kei kapumtak tuunmakna kha iteii jetmong, takkha khawa kha'n kei iteii kajetmak miring kha namin-emak. Pumi eii kei chungnga chongkatanchu. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Khawa jarra apha heitungmaklai chong tanmaru, Pumi kajuo ngaakru. Ama'n ziingna-ah inthup ngaikha war khan akeisuosik eii halli miring malung ngaikha amalarsik eii. Halli mi rakip in ama chuontho dungjuiya Pathian minpaakna kha inmusik eii.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Ule nai ngai, hiwa-ngai rakip hi kei kapumtak khat-um Apollos in nangni nemnasik kinjuikha ejei, “Dan kha rakaanmaru” tia lei-injia kha ningjetnasik. Nangni'n miring inkhat jarra in-or maru halli miring inkhat kha enzootmak thomaru. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Tume miring leiilaak neek-ah nangni kanaminlok? Ning inei rakip Pathian inapeii emak abe? kha e-inchu ningnei ngaikha kutchoi emak angnga angjarra ninglok orme?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Ningmanuom rakip nangni'n ningneijei! Nangni ning-inchongjei! keini reng kin-emak innum nangni chu rengngai ning-angjei! keini-um nangnile reng enasik nangni'n reng ning-etak kha kei'n kamanuom! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Mipui maikuungnga thatsik-ah inpejei mi angnga, Pathian'n ahekna phamtaang siamruoi itihi einidiang inape kha eii tia kei'n kalei; ajarchu manmasituol, marwaan tirton khat-um mi rakip mit-en nakha eini ni-ejei. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Christa sikbit eini aka-am kha ni-eii, takkha Christa diang nangni akasing kha ning-eii. Keinichu nemmung, takkha nangnichu ningngar. Keinichu innamatir, takkha nangnichu khoya innatho. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Hiwapha takhin keini'n wonkachaam khat-um tuikaraal; puonchet puonwai kinkahak; keini innawuok; khat-um kin-inn kinlei ommak.<verse eid="1CO 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 4:12" />Keini'n kinkut tak-ah chuon kangar kha kintho, keinidiang khomaak innasaam phakhan, keini'n rawaan kinpeii, keini innawuokli innaminpoong phakhan, keini'n kapoongkha kindei, <char style="rq"><ref loc="ACT 18:3">Chuon 18:3</ref></char><verse eid="1CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 4:13" />keini innarilse phakhan, keini'n chongkadaiya kinmasang. Tuunkatung nuoipilchung akachok reiina khat-um manmasituolla nemna kaboi ngaikha kin eii.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Kei'n hiwahi nangni naminjak nasik kimajia emak, takkha kei'n kiminriang kasa-ngai angnga naminchu nasik kei'n kimajia kha eii. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Christa diang lising soom kanakeiruoi sik-ah ningnei innum, Pa khachu inkhatbit ningnei. Chongkahoi kaheichoiya Christa Jisu diang ningpa kha ka ejei.<verse eid="1CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 4:16" />Kei'n nangnidiang kanati, khachu, kei omchan juiru. <char style="rq"><ref loc="1CO 11:1">1 Cor 11:1</ref>; <ref loc="PHP 3:17">Phil 3:17</ref></char><verse eid="1CO 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 4:17" />Hiwasik jarra kei'n kiminriang khat-um Pumi diang ki-ngamna kasapa Timothy tak nangnidiang kajuotir, kei'n koisuok rakip-ah inmani ngaidiang kaminchu laikhan, kei'n Christa Jisu diang angtho thoa kaomme tikha ama'n nangnidiang narilpite.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Kei'n nangnidiang kaheiwanook maksik angnga, nangni karra miring lekkhatchu ninglok-or. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Takkha Pumi lungdou e-inchu kei'n innottheiya nangnidiang kaheiwa nooksik eii, halli hiwa kalok-or inmani ngai chongril khabit emak-ah khat-um inranak kha kei'n entokkata kajetsik eii. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Ajarchu Pathian rengram khachu chongbit khan emak takkha ranak kha eii. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Kei'n nangnidiang sungmol choiya juoningbo emakli minriang khat-um ratha kadaiya juoningbo? Hume ningmanuom?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s1">Koisuok suungnga Nunchan Kadikmak</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Nangni karra zool-inthai chuonkatho omjei iti chonghi keidiang hongtungjei, Pathian kajetmak mi ngai diang-um kasuokmak; khachu pasal inkhat in apa numei kha azaalpui. <char style="rq"><ref loc="DEU 22:30">Innidan 22:30</ref></char><verse eid="1CO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 5:2" />Halli nangni'n ninglalok-or! Ningmalungnga kahoimak-in sipsik suokmak abe? hiwa katho miringkha ning-inchunna makheiya ningpuutsik kha eii. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Kataksa nangnile ommak innum, kei karathachu nangnile aom, halli kei-um hiwa suungnga kiom eii tia kaleiya hiwa katho ama chungnga kei'n eini Pumi Jisu ramingnga chong katansuojei. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Kei karatha kha'n Pumi Jisu ranak khale inruoiya nangnile aom, halli nangni'n ning-intuup phakhan, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />nangni'n khawa miring pakha Seitan diang ataksa thinasik peru, tichu ama ratha kha Pumi Nikhuo nikhan sanminringna amunasik eii.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Nangni ninglok orkha dikmak. Chol lekteii-in cholkhol rakip aminpuor maneii tihi nangni jetmakchube? <char style="rq"><ref loc="GAL 5:9">Gal 5:9</ref></char><verse eid="1CO 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 5:7" />Nangni'n chol inchelmak akathar cholpi ning-enasik, akamaruo chol kha khairu. Ajarchu Christa, eini Rakaanna kahoi keelngamteii kha inthatjei. <char style="rq"><ref loc="EXO 12:5">Suok 12:5</ref></char><verse eid="1CO 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 5:8" />Rakaanna kahoi kha eini'n thotui, cholmaruo ah inbool waipool khan thomui ajarchu khawa kha manu khat-um inthiangmak kha eii, takkha inthiang khat-um akadik chol inchelmak waipool khan thotui. <char style="rq"><ref loc="EXO 13:7">Suok 13:7</ref>; <ref loc="DEU 16:3">Innidan 16:3</ref></char><verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Zool-inthai mi ngai khale inlopmaru tia kei larik khan nangnidiang kamajia; <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Kei'n hiwa manmasituolla zool-inthai, phaamrai kase, inruup, emakli ramil chubei katho ngai katina emak. Hiwa ngai katina e-inchu nangni manmasituol makheiya ningsuoksik eii. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Takkha Pathian kajet kin eii intili zool-inthai, phaamrai kase, ramil chubei katho, mikarilsiat, jukinrui khat-um inruup katho inmani ngaile inlopmak nasik kei'n nangnidiang kimajia eii. Khawa ka-ang mi ngai khale kabak suomsik-um in-ongsuom maru.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Kei'n koisuok ka-emak mi ngaidiang chong katansik suok-abe? Koisuok suungnga kaom mi ngaikha emak abe nangni'n chong ningtansik kasuok?<verse eid="1CO 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 5:13" />Pathian'n tuolmi ngaikha chong atansik eii. “Kathamak miring kha ningkar makheiya puutru.” <char style="rq"><ref loc="DEU 13:5">Innidan 13:5</ref>; <ref loc="DEU 17:7">17:7</ref></char><verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s1">Christian Ule nai suungnga Inseiina Chongtan</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Ningkarra miring inkhatli inkhat inseiina om-inchu, inthiang koisuok ngaidiang silekleiya Pathian kajetmak mi ngai chontan nasik ningruoisikbe? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Inthiang koisuok ngai'n manmasituol kha chong intansik eii tihi nangni jetmak chube? nangni'n manmasituolhi chong ningtansik e-inle, angjarra akasiinteii chongtan hi-um ningtho theimakme? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Marwaan tirton ngai-um eini'n chong nitansik eii tihi nangni'n jetmakchube? Hiwa ringkhuo suungnga kasuok chuon ngaihi kei'n kheella chong katansik suokmak abe! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Khawa ka-ang chongngaikha hongsuok jei-inle, angsik-ah nangni'n inmani ngaikha koisuok in irawatmak mi ngaidiang ningruoime? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Kei'n hiwahi nangni naminjak nasik kiti eii. Nangni inchunna karra miring inkhat bitchu koisuok karra kasuok chuon ngaihi chong katansik lungsing lungwar kanei leiom ningte, <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Khawa khachu thomakchuli, Christian miring inkhat in christian miringkhat kha chongtansik ningruoi, halli khawakha Pathian kajetmakngai maikuungnga eii!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Nangni karra dan dungjuiya chongtansik kasuok katung inseiina kasuok khan nangnikha inthiangnga ningpurjei tikha indang, khaneek ale kadikmak ning-ekha thawiai makniabe? khaneek ale kadikmak lamma nangni nakeiruoi kha thawiai makniabe? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Khawa rathuulla, nangni'n ningpum tak-in maleisei khat-um inruup chuon ningtho, halli khawakha ning-u ningnai ngai chungnga ningtho eii. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Nunchan kadikmak mikha'n Pathian rengram mununi tihi nangni jetmak chube? ningpumtak kha maleisei khan intormaru; zoolkajong, ramil chubei katho, zool-inthai, Pasal li pasal zool-inthai, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />inruup, phaamrai kase, mikarilsiat, jukinrui khat-um phur insut inmani ngaihi Pathian rengram luutnunu. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Nangni lekkhatchu inmani ngai ka-ang ninglei-eii. Takkha nangnichu manu-ah inphut narasujei, naminthiangjei, Pumi Jisu Christa ramingnga eini Pathian Ratha khan nangni Pathian le naminjomjei.<verse eid="1CO 6:11" /></para>
  <para style="s1">Zool-inthai Nunchan</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />Mi inkhat in ticha “Angrakip kei'n thocha,” takkha angrakip kha keidiang katha emak. “Angrakip kha kei'n thocha,” takkha angrakip ngai suokchu enuning. <char style="rq"><ref loc="1CO 10:23">1 Cor 10:23</ref></char><verse eid="1CO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 6:13" />Mi inkhat in ticha “Bu hi wonsik eii halli won hi busik eii” takkha Pathian'n inni reella aminmangsik eii. Taksa hi zool-inthai nasik emak, takkha Pumi sik eii, halli Pumi hi taksa sik eii. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Pathian'n Pumi kha kathi makheiya aminring halli eini-um ama ranak-ah kathi makheiya anaminringsik eii.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Nangni ningpum ningtaksa ngaihi Christa taksa ning-eii tihi nangni jetmak chube? Kei'n Christa taksa hi kaleili zool-inthai mi kamin esikbe? Supmin eii min-enuning!<verse eid="1CO 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 6:16" />Zool-inthai numeisanu khale injomjei ama kha zool-inthai numeisanu khale taksa pumkhatbit in eii tihi nangni jetmakchube? Ajarchu, hintia injiajei, “Inmani innikha taksa pumkhatbit in-esik eii.” <char style="rq"><ref loc="GEN 2:24">Inphut 2:24</ref></char><verse eid="1CO 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 6:17" />Takkha Pumi khale injom ama khachu Pumi khale ratha inkhatbit in-eii.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Zool-inthai chuonna inphut taandenru. Miring inkhat in manu leiilaak itho-ngai khachu apum takdiang manu itho emak; takkha zool-inthai chuonkatho miring kha'n apum takdiang manu itho kha eii.<verse eid="1CO 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 6:19" />Ningtaksa hi nangni diangnga kaom Pathian makheiya ningmu Ratha Inthiang Biak-inn kha ning-eii tihi nangni'n jetmak chube? Nangnihi nangnita emakchu; <char style="rq"><ref loc="1CO 3:16">1 Cor 3:16</ref>; <ref loc="2CO 6:16">2 Cor 6:16</ref></char><verse eid="1CO 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 6:20" />nangni chu aman apeya inaracho kha ning ejei. Khawa jarra ningtaksa pumpuiya Pathian minpaakru.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s1">Moikaruoi jarra Rakelna</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Tuun, nangni'n keidiang ningjuomajia chongjarra khachu hi eii.</para>
  <para style="p" vid="1CO 7:1">Pasal khan inn kaneimak hi akatha kha eii. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Takkha zool-inthai thonasik intheemna omjarra, pasal rakip in innumei innumei ompuirasu, khat-um numeisa rakip in inruothar inruothar diang omrasu. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Arouthar kha'n ompui sangram thosik chuon anumei imanuomkha mintung rase, in-angrip-ah anumei innum aruothar diang mintung rase. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Anumei khan ataksa pumpui kha ata emak takkha aruothar ta eii, in-angrip-ah aruothar khan ataksa pumpui kha ata emak takkha anumei ta eii. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Inkhat-in inkhatdiang inzootmakna ommarase, ning-inniya inzootna nuoiya aphakhat Pathian diang kanisik-ah ning-inthen elekleiya; ajarchu napum imanuom chuonkhan seitan kha'n namatheem maknasik heikirrit inlang juo-inchunritru.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Kei'n hiwahi nangni sik-ah nemna omcha katia kiti eii, chongpeii khachu emak. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Kei'n nangni rakip kei kanamin angzoot. Takkha Pathian inape inlak kutchoi kha mi rakip in nineihet, inkhat in hiwa kutchoi khat-um leiilaak-in khawa kutchoi.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Inn kalaneimak khat-um chuulmei ngaidiang kei'n kati. Kei itho angnga nangni'n inn neilekleiya ningomkha akatha eii. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Takkha inpum imanuomkha indei maneiimak inchu, inmani ngaikhan inn neirasu, ajarchu inpum imanuom chuonkhan omdan injetmak neek-achu inn inneikha athawiai.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Inn kaneijei mi ngaidiang kei'n chong kanapeii, kei chongpeii emak takkha Pumi chongpeii kha eii, khachu anumei kha'n aruothar inthenpui theinuni, <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />takkha inthenpui suokngai inchu, ama kha'n inn neilekleiya omrase emak inle aruothar khale inzootnaritse inlang omsuomrit rasu; halli aruothar kha'n anumei kha inthenpui theinuni.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Aleiilaak rakip ngaidiang Pumi iti emak-ah kei'n kati, christian pasal inkhat in Pathian kajetmak numeisa inkhat aneijei inchu halli numeisanu kha'n amale kaomsik-ah azoot inchu, pasal kha'n anumei kha inthenpui theinuni. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Pathian kajet numeisa inkhat tak-in Pathian kajetmak ruothar aneijei inchu, halli aruothar kha'n amale kaomsik eii ati inchu, anumei kha'n arouthar kha inthenpui theinuni. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Ajarchu Pathian kajetmak aruothar kha anumei diangnga inphut inthiangkha ejei, khat-um Pathian kajetmak anumei kha aruothar diangnga inphut inthiangkha ejei. Khawa emak inchu nangni sangai kha inthiangnunu, takkha hiwa ejei inchu inmani inthiangkha in-ejei. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Takkha Pathian kajetmak anumei emakli aruothar kha'n inthen inmanuom inchu, khawakha erase; khawa ka-ang chuon ngai inchu Pathian kajet anumei khat-um aruothar kha khit-in damak, ajarchu Pathian'n einichu kadaiya kaomsik-ah innakoi kha ni-eii. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Anumei, nang in naruothar kasanringsik tihi angtho tholi najetsikme? Aruothar, nang in nanumei kasanringsik tihi angtho tholi najetsikme?<verse eid="1CO 7:16" /></para>
  <para style="s1">Pathian Nakoina khan nangni'n Ringru</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Nangni rakip Pathian'n anakoilaiya ningleiom ringkhuo khan omcheiru, halli Pumi'n nangnidiang inapeii ringkhuo khan nangni rakip in ringru. Hiwahi koisuok rakip-ah kipeii kei sinadan kha eii. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Tu miring me ama kha akoimaklai wun intansuojei? wun intanna bikha ama'n minmangnasik thomarase. Tu miring me ama kha akoimaklai wun inlatanmak? ama'n wun tannasik thomarase. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Wun intan kha'n i-emak, wun intanmak kha'n i-emak, takkha Pathian chongpeii kajui khakeeng arei ka-eii. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Miring rakip Pathian'n ama ama akoilaiya inleiom omchan khan omrasu. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Nang in suok na-elai Pathian'n nakoibe? iteii ngaidonmaro; takkha nang suok emaknasik lam namu inchu, khawakha thoro. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Ajarchu suok elai Pumi'n inkoijei ama kha Pumi'n imasuojei mikha ejei; khawa khale in-angrip-ah Pumi'n akoilai suok ka-emak ama kha Christa suok eii. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Pathian kha'n nangni aman teella innaracho ning-ejei; mi ngaisuok hong-ekhaimaru. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Ule naingai, nang nang anakoilaiya omchan khan, nangni'n Pathian le inruoiya omru.<verse eid="1CO 7:24" /></para>
  <para style="s1">Inn Kalaneimak khat-um Chuulmei ngai jarra Rakelna</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Tuun, inn kalaneimak ngai jarra, kei'n Pumi chongpekha neimong, takkha Pumi riangwai nuoiya ngamna kacha kei i-ngaidon kha kei'n kiril kha eii.<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />Tuun tuunna poongna hi'n ajar eya, nangni'n tuunna ningom angnga ningomkha thate tia kei'n ka-ngaidon. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Nang numei naneibejei? nanumei inthenpuisik thomaro. Nang inn laneimak chebe? numei neisik entokmaro. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Takkha inn naneijei inchu, nangdiang manu ommak, halli inthiang numeisa kha'n inn aneijei inchu ama'n manu thomak. Takkha inn kaneijei inmani'n taksa-ah poongna katamtak intongpuisik eii, halli kei'n nangni kanasansik eii.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Ule naingai, kei i-ngaidon khachu hi eii, aphakha tam ommakjei; tuun makheiya inphut inn kaneijei mi ngaikha'n inn kaneimak ang-inlang omru; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />kachap-ah kaomngai'n kachapmak angnga, karok ngai'n karokmak angnga, karacho ngai'n iteii kaneimak angnga, <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />halli manmasituolle inlop mi ngai'n manmasituol injetmak angnga omrasu. Ajarchu hiwa manmasituol hi alaheksik eii.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Nangni'n malung kapoong omlekleiya ning-omkha kei'n kamanuom. Inn kalaneimak pasal kha'n angtho tholia Pumi minroksikme tia Pumi chuon angaidonna amalung minluut; <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />takkha inn kaneijei pasal kha'n anumei kha angtho tholia taksa imanuom lamma minroksikme tia angaidonna amalung aminluut, <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />khawa jarra ama ama imanuomkha inkhoithen. Halli inn kalaneimak numeisa li inthiang nungaak kha'n Pumi chuonna apum khat-um aratha kha angtho tholia minthiang sikme tia amalung aminluut; takkha inn kaneijei numeisa kha'n angtho tholia taksa imanuom lamma aruothar minhoisikme tia angaidonna amalung aminluut.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Kei'n hiwahi nangni nemnasik-ah kiti kha eii, nangni chungnga kana-ook ommaknasik, takkha nangni'n akadik lamma malung inkhatbit-ah Pumi diang ningomnasik kei'n kiti kha eii.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Miring inkhat in aneisik-ah inbiak numeisanu diang omchan kadikmak kathojei tia angaidon inchu, halli ama taksa imanuomkha deimaneii mak-ah khat-um athosik suok-inchu inmani'n inneitrasu, halli ama imanuomkha thorase. Khawakha manu emak. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Takkha amalungnga angirphit-ah, khat-um taksa imanuomkha adei maneiiya, khat-um amalung suungnga inbiakjei numeisanu kha laneinuning ati inchu, ama'n kathadoom kha atho. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Nungaak inthiang khale moi karuoi ama kha'n akatha chuonkha atho, takkha inn kaneimak ama kha'n akathadoom chuonkha atho.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Anumei kha aruothar ringlai sengchu ama diang inkhit kha eii. Aruothar thijei inchu, numeisanu kha'n Pathian kajet pasal kha e-inchu ineizoottak pasal kha neicha. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Takkha kei i-ngaidon dungjui achu ama'n inn neileiya i-omkha athawiaisik eii. Halli kei'n Pathian Ratha kha kanei tia ka-ngaidon.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s1">Raikhuo diang Inpeii Bak-in jarra Rakelna</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Tuun, raikhuo ramil diang nipeii bak-in jarra:</para>
  <para style="p" vid="1CO 8:1">Eini rakip in “Jetmator nakha nineiwiak” tihi eini'n nijet. Jetmatorna kha'n anamin-or, takkha minriang kha'n anaminsoon. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Tu ka-ang miring in angmekhat kajetjei ati-inchu, ama'n ajetsik kasuokkha lajetmak. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Takkha miring inkhat in Pathian aminriang inchu, ama kha Pathian'n ajet.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Khawa angnga, raikhuo ramil diang inpeii bakphur baksik jarra, eini'n nijet “Raikhuo ramil kha iteii emak,” “Takkha inkhatbit Pathian kha elekleiya aleiilaak ommu.” <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Pathian ngai intihi marwaan emakli nuoipil chungnga inleiom suok-innum hiwa ka-ang “pathian” ngai khat-um “Wai karoon katamtak,” inleiom innum <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />eini sik-achu Pathian Inkhatbit eii, Pa Pathian, angrakip hong-inphutna khat-um ama sik-ah eini'n niring, halli Pumi inkhatbit eii, Jisu Christa, ama diangnga inphut angrakip injir khat-um ama diangnga inphut eini'n niring.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Takkha miring rakip in hiwahi jetmu. Miring lekkhatchu khawa laiya raikhuo ramil chubei inleitho kha inngaidon cheiya tuun katung khawa bakphur inbak phakhan raikhuo bu eii inlaticheiya ngaidontung mu, halli bakphur kha'n inmani aminchok. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Bakphur khan eini Pathian le naminjommak; bakphur nibakmakli eini'n akadikmak emakmi, bakphur nibakli eini'n akadikdoom emakmi.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Nangni'n bak-in kacha bakphur ngaikhan ngamna kasuol mi ngaikha manu-ah inchulmak nasik achu inringchakru. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Tu ka-ang malung kasuol hiwa jarra kajet miring inkhat in dooi thona munna nang in nibakkha anamu inle, hiwa hi'n ama kha-um raikhuo diang nipeii bakphur hi baksik nimasok khat-um ranak nipe emak-abe? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Halle hiwa malung kasuol ule nai, ama sik-um Christa in ithipijei amahi nang ijet khan ama kha naminmang. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Hin natho-ah nang in ule nai ngaidiang kathamak natho khat-um inngamna kasuol kha naminmang inchu, Christa diang manu natho. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Khawa jarra, kibak bakphur khan ule naingai manu kamintho inchu, inmani ngaikha kaminmang maknasik, kei'n meii sup-ei einuningjei.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s1">Tirton Chuon</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Kei innamasuojei mi emong ngabe? Kei tirton emong ngabe? Kei'n Jisu eini Pumi kha mumong ngabe? nangni ngaihi kei'n Pumi choun kathoman emakchu abe? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Kei'n aleiilaak mi ngaidiang tirton ka-emak innum, kei nangnidiang chu ka eii; ajarchu nangni ngaihi kei'n Pumi tirton ka-ena jetnabi indeeng ngaikha ning-eii.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Hiwahi kei chungnga chong katansik ngaidiang kei in-ookna kha eii. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Kei'n kibakzoot khat-um ki-inzoot khan kalungdou ommak abe? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Tirton leiilaak ngai, Pumi ule naingai khat-um Cephas itho angnga kei'n Christian ka-eii kanumei inruoipui li sinasik kalungdou ommak abe? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Emakli Barnabas li keibit kin ebe eini ringnasik-ah chuon kathosik? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Apum tak-in abak a-insik akeisuoli raalmi ka eii hi tu ommame? Tume theibombil tholi theibom kara kabakmak? tume keelngam rahooi doolli keelngam ranutui ka-inmak?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Hiwahi kei'n manmasi ranak dungjuiya kirilbe? Sina dan khan hiwajek iti emak abe?<verse eid="1CO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 9:9" />Ajarchu Moses dan khan hintia lei-injiajei, “Saang ningmintouchul saraatchal kha amur khuopmaru.” Saraatchal sikbit abe Pathian'n i-ngaidon kha? <char style="rq"><ref loc="DEU 25:4">Innidan 25:4</ref>; <ref loc="1TI 5:18">1 Tim 5:18</ref></char><verse eid="1CO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 9:10" />Ama'n iril rakip hi eini sik-ah emak abe? Eini sik-ah lei-injia kha eii, ajarchu leikakhuoi khat-um leikarakhool inmani inni'n tum inchangsuomsik eii intia ngamna dungjuiya chuon inthosik eii.<verse eid="1CO 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 9:11" />Keini'n ratha lamtiang aru nangnidiang kinworli, taksa nemnasikbit nangni diang makheiya kinrakhool inle, khawa kha tihei mak-abe? <char style="rq"><ref loc="ROM 15:27">Rom 15:27</ref></char><verse eid="1CO 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 9:12" />Aleiilaak mi ngai'n nangni chungnga inchangsik om-inchu, keini'n khawa neek-ah kalok kinchangsik emak abe?</para>
  <para style="p" vid="1CO 9:12">takkha hiwa ranak hi keini'n la-inliingnamung, khawa rathuulla, keini'n angrakip-ah Christa chongpui kha ka-ook ommaknasik-ah kinladei.<verse eid="1CO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 9:13" />Biak-inn khan chuon katho mi ngai'n Biak-inn makheiya bak-in inchang tihi nangni'n jetmak chube, halli maichaam inn khan chuon katho ngai'n inhongpeii kutchoi ngaikhan inmani'n intum inlei tihi nangni'n jetmakchube? <char style="rq"><ref loc="DEU 18:1">Innidan 18:1</ref></char><verse eid="1CO 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 9:14" />Khawale in-ang rip-ah, Pumi'n chong apeii khachu Pathian chongpui karil ngai'n Pathian chongpui khan inringsik eii. <char style="rq"><ref loc="MAT 10:10">Matt 10:10</ref>; <ref loc="LUK 10:7">Luk 10:7</ref></char><verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Takkha hiwa ka-ang ranak ngaihi kei'n iteii inliingnamong, khat-um khawa ngaikha kachangnasik-ah kei'n hiwahi kimajia kha-um emak. Miring inkhat in kei in-orna hi lailam amin-esik neekchu kathiram keisik-ah athawiai. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Ajarchu kei'n Pathian chongpui karil innum, kei'n in-or nuning, ajarchu kei'n thomak kachamak kei kachuon kha eii. Angtuk chikaomme, Pathian chongkahoi kha karilmak inchu! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Kei kalungdouwa hiwahi katho inchu, kei kathoman om; takkha kei kalungdouwa emak inchu, Pathian in keidiang thosik-ah innapeii chuon kha kitho eii. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Halle kei kathoman kha angme? Hiwa hi eii: Pathian chongpui kei'n karil phakhan aman kaboiya karilsik eii, Pathian chongpui kha kei lungdouwa inliingnanuning.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Kei tuteii suok ka-emak innum, miring katamtak mator nasik-ah kei kapumtak in mirakip suok ka eii. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Jihudi ngai matornasik-ah Jihudi mi ngaidiang kei Jihudi ka eii, dan nuoiya kaom ngaidiang kei kapumtak dan nuoiya kaom ka-emak innum, dan nuoiya kaom inmani matornasik-ah kei-um dan nuoiya kiom angnga kaom. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Dan kaneimak mi ngai matornasik bit-ah, dan kaboi mi ngaidiang kei-um dan kaneimak ka-ang, (Pathian dan kha kei juimong kiti emak; takkha Christa dan nuoiya kei kaom). <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kasuol mi matornasik-ah, kasuol mi ngaidiang kei-um kasuol ka eii. Kei'n miring lekkhat matornasik bit-ah, ekatha angrakip kha kei'n mi rakipdiang ka-ejei.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />Pathian chongkahoi khan rawaan kamunasik bit-ah hiwa rakip hi kei'n Pathian chongkahoi sikbit-ah kitho kha eii. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Kataan insiak nakhan kataansik mi rakip in intaan, takkha miring inkhat bit-in tum achangsik eii tihi nangni'n jetmakchube? khantia tum ningchang nasik-ah nangni'n taanru. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Kataansik mi rakip in katha tak-ah inpum inbool. Inmani'n kalamangsik ataanman renglukhu changnasik-ah intho kha eii, takkha einichu kamangmaksik renglukhu changnasik eii. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Khawa jarra atungnasik mun jetleiya kataan ngai angnga kei'n taanmong, insuk mi kha'n arouk isuk angnga keichu sukmong. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Kei'n mi leiilaak ngaidiang karilsuo phakhan, kapumtak hi taanman kachang sik-ah rahoi suoknasik, kei kapum hi insurna nuoiya kada.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s1">Israel Thurchi makheiya Inrimna apeii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Ule naingai, nipi nipu rakip ngaikha ziingkhum khan aleimakhu halli inmani rakip in Tuipui Kasen (Red Sea) kha inrakaanna inleisi tihi kei'n nangni kanaminjet tharzoot. <char style="rq"><ref loc="EXO 13:21">Suok 13:21</ref>,<ref loc="EXO 13:22">22</ref>; <ref loc="EXO 14:22-29">Suok 14:22-29</ref></char><verse eid="1CO 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 10:2" />Inmani rakip kha Moses nukkajui in-eya ziingkhum nuoiya khat-um tuipui suungnga baptize inleitho,<verse eid="1CO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 10:3" />halli inmani rakip in in-angrip rathabu kha inleibak <char style="rq"><ref loc="EXO 16:35">Suok 16:35</ref></char><verse eid="1CO 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 10:4" />halli inmani rakip in in-angrip rathatui kha inlei-in; ajarchu inmani kajuichak rathalungpui makheiya kasuok tuikha inlei-in, halli khawa Lungpui kha Christa alei-eii. <char style="rq"><ref loc="EXO 17:6">Suok 17:6</ref>; <ref loc="NUM 20:11">Teelna 20:11</ref></char><verse eid="1CO 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 10:5" />Kha e-innum inmani katam takdiang Pathian'n amalung leitaimak; khawa jarra inmani kaluong ngaikha neelramma lei-inworchen. <char style="rq"><ref loc="NUM 14:29">Teelna 14:29</ref>,<ref loc="NUM 14:30">30</ref></char><verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Tuun, inmani'n kathamak inleitho angnga kathamak nimanuom maknasik, hiwa ngaihi'n eini sik-ah minkhina kha eii. <char style="rq"><ref loc="NUM 11:4">Teelna 11:4</ref></char><verse eid="1CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 10:7" />Ramil chubei katho emaru, inmani lekkhat in inleitho angnga; hintia lei-injiajei, “Mi ngaikha'n kabak ka-in sik-ah inlei-in-ong khat-um Pathian kajetmak laamsiam katho sik-ah inhong ngir.” <char style="rq"><ref loc="EXO 32:6">Suok 32:6</ref></char><verse eid="1CO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 10:8" />Inmani lekkhat in inleitho angnga, eini'n zool-inthai kakhopmak chuon thomui, halli nisokhat bit-ah inmani lising soomni leithum inleithi. <char style="rq"><ref loc="NUM 25:1-8">Teelna 25:1-8</ref></char><verse eid="1CO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 10:9" />Inmani lekkhat ngai'n inleitho angnga, eini'n Pumi<note caller="+" style="f"><char style="fr" closed="false">10:9. </char><char style="fq" closed="false">Pumi; </char><char style="ft" closed="false">Manuscript lekkhat inchu </char><char style="fqa" closed="false">Christa.</char></note> kha deiimui, ajarchu inmani ngaikhan inleideii jarra maruul ngai'n inleimachukthat. <char style="rq"><ref loc="NUM 21:5">Teelna 21:5</ref>,<ref loc="NUM 21:6">6</ref></char><verse eid="1CO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 10:10" />Inmani lekkhat ngai'n inmur katam angnga einichu mintammui, ajarchu inmani ngaikha kaminmang Marwaan Tirton kha'n aleiminmang. <char style="rq"><ref loc="NUM 16:41-49">Teelna 16:41-49</ref></char><verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Hiwa ngaihi inmani diangchu inrimnasik kaleisuok kha eii takkha eini sik-achu inchuna sik-ah lei-injia kha eii. Ajarchu eini khanghi huui tungnasik aphakha naijei.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />Khawa jarra, kacheet-ah kinngirjei kati nangni'n ningpurmak nasik-ah inringru. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Miring diang kaheiwajol matheemna ngaikha elekleiya matheemna leiilaak in nangni nalamapurmak. Pathian chu ngamna kaom kha eii, halli ama'n nangni deimatormaksik chungtiang matheemna napenuni, takkha matheemna khale inruoiya suoknasik khat-um deimatornasik lam kha-um anapeii.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Khawa jarra, minriang kaom ule naingai, ramil chubei katho kha dataru. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Kei'n akasing mi ngaidiang kiril eii; kei iril chonghi nangni'n chong tanru.<verse eid="1CO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 10:16" />Niminpaak rawaan rabing khan Christa thisen kha eini-um tum nichang emak abe? waipool nikatheer khan eini-um Christa taksa kha tum nichang emak abe? <char style="rq"><ref loc="MAT 26:26-28">Matt 26:26-28</ref>; <ref loc="MRK 14:22-24">Mk 14:22-24</ref>; <ref loc="LUK 22:19">Luk 22:19</ref>,<ref loc="LUK 22:20">20</ref></char><verse eid="1CO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 10:17" />Ajarchu waipool inkhatbit om, eini nitamthei innum taksa inkhatbit ni eii, ajarchu eini rakip in waipool inkhatbit khan tum nichangsuom.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Israel mi ngaikha ngaidonru; kutchoi inhongpeii bakphur akabak inmani ngai'n maichaam innkhan tum inchangsuom emak abe? <char style="rq"><ref loc="LEV 7:6">Levi 7:6</ref></char><verse eid="1CO 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 10:19" />Ang katiname halle? Ramil diang inhongpeii bakphur khabe angmekhat ka-eii, emakli ramil khabe angmekhat ka-eii?<verse eid="1CO 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 10:20" />Emak, Pathian kajetmak ngai'n inhongpeii bakphur ngaikha raikhuo ngaidiang inhongpe eii, Pathian diang inhongpeii emak. Kei'n raikhuo ngai khale nangni'n ning-inlop kha manuommong. <char style="rq"><ref loc="DEU 32:17">Innidan 32:17</ref></char><verse eid="1CO 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 10:21" />Nangni'n Pumi rabing khanli raikhuo ngai rabingkhan insuom theinutun. Nangni'n Pumi khamtuol makheiya khat-um raikhuo ngai khamtuol makheiya baksuom theinutun.<verse eid="1CO 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 10:22" />Eini'n Pumi kha kheella minraangnasik nithobe? Eini Pumi neek-ah ni-ngarbe? <char style="rq"><ref loc="DEU 32:21">Innidan 32:21</ref></char><verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />Nangni'n ningti, “Angrakip kei'n thocha,” takkha angrakip kha katha emak. “Angrakip kha kei'n thocha,” takkha angrakip kha nemna ommak. <char style="rq"><ref loc="1CO 6:12">1 Cor 6:12</ref></char><verse eid="1CO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 10:24" />Tuteii miring innum ama hoinasik entok marase, takkha leiilaak ngai thanasik entokrase.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Meii juorna-ah injuorrei meiikha namalungnga kachok kamang thellekleiya khat-um iteii rakellekleiya eiro.<verse eid="1CO 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 10:26" />Ajarchu “Nuoipil khat-um nuoipil chungnga kaom rakip Pumi takha eii.” <char style="rq"><ref loc="1CO 6:12">1 Cor 6:12</ref></char><verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Pathian kajetmak miring inkhat in bukabak anakoi inchu, halli nang in nasizoot-ah nasi inchu, namaikuungnga indoonrei kha nang in namalungnga iteii ngaidon lekleiya khat-um iteii rakellekleiya bakro. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Takkha miring inkhat in nangdiang “Hiwa bak-in hi raikhuo ramil diang inpeii bakphur eii” ati inchu, ama malungnga i-ngaidon khat-um ama sik en-inlang nang in bakphur kha bakmaro. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Nang namalungnga kachok kamang ni-ngaidon jarra emak takkha ama malung sik-ah eii.</para>
  <para style="p" vid="1CO 10:29">Halle angjarra miring inkhat in amalungnga kachok kamang eii tia i-ngaidon khan kei thokacha kha angsiya kathamakme? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Kei'n Pathian diang kaniya kibak e-inle, angjarra bak-in sik-ah Pathian kiminpaak kha mipui ngai'n kei innarilseme?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Khawa jarra, nangni'n ningbak innum ning-in innum, emakli ning itho rakip-ah, Pathian lurnasik-ah angrakip thowiakru. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Jihudi ngai, Greek mi ngai emakli Pathian koisuok ngai insuinasik thomaru, <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Kei'n kachuon thona rakip-ah mi rakip malung mintainasik kitho angnga, kei kapum nemnasik thomong takkha inmani ngai'n ringna inmunasik kei'n mi rakip thanasik katho.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Kei'n Christa omchan kijui angnga, kei omchan juiru. <char style="rq"><ref loc="1CO 4:16">1 Cor 4:16</ref>; <ref loc="PHP 3:17">Phil 3:17</ref></char><verse eid="1CO 11:1" /></para>
  <para style="s1">Pathian Chubei nitho pha-ah Lu khumsik</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Nangni'n kei ningna ngaidon khat-um kei'n nangni diang kinaleidapi minchuna kha ningjui jarra kei'n nangni kanaminpaak. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Takkha kei'n nangnidiang kanaminjetzoot, khachu pasal rakip lukha Christa eii, numeisa lukha pasal eii, halli Christa lukha Pathian eii. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Alu khumma Pathian kani khat-um Pathian chong karil pasal rakip kha Christa khoya thomu, <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />takkha alu khumleiya Pathian kani khat-um Pathian chongkaril numeisa kha alu khoya thomak; alu epkol khale in-ang. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Numeisa kha'n alu khummak inchu, ama'n alu epkollen rase; takkha numeisa khan alu epkol kha jakna kaom e-inchu, ama'n alu khumrase.<verse eid="1CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 11:7" />Takkha pasal kha'n alu khumsik suokmak, ajarchu pasal kha Pathian ramil khat-um Pathian lurna kha eii, takkha numeisa khachu pasal lurna kha eii. <char style="rq"><ref loc="GEN 1:26">Inphut 1:26</ref>,<ref loc="GEN 1:27">27</ref></char><verse eid="1CO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 11:8" />Ajarchu pasal kha numeisa makheiya ibool emak, takkha numeisa kha pasal makheiya ibool eii.<verse eid="1CO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 11:9" />Pasal kha numeisa sik-ah ileibool emak takkha numeisa kha pasal sik-ah ileibool eii. <char style="rq"><ref loc="GEN 2:18-23">Inphut 2:18-23</ref></char><verse eid="1CO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 11:10" />Khawa jarra numeisa kha'n marwaan tirton ngai'n alu chungnga chungkanung inlaom ti jetnasik alukhum khan malarrase. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Pumi diang, manmasi ringkhuo-ah numeisa omleiya pasal ommak, khat-um pasal omleiya numeisa ommak; <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Numeisa kha'n pasal diangnga inphut ihongsuok angnga, pasal kha-um numeisa diangnga inphut injuonei kha eii. Takkha angrakip Pathian diangnga inphut kasuok kha eii.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Nangni ningpum ningpumma chong intanru; numeisa kha'n alu khumlekleiya Pathian innihi athabe? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Pasal kha'n asam minsei inchu ama sik-achu jakna kaom eii tia angaiya naminchu emak abe? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Takkha numeisa kha'n asam sei-inchu, khawa kha ama lurna eii, ajarchu asamkha alu khumnasik ama diang ipeii kha eii. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Tu ka-ang in hiwahi zootmuwa inseiizoot innum, keini khat-um Pathian koisuok ngai sengchu hiwa ka-emak aleiilaak tholi Pathian chubei thonasik ommak.<verse eid="1CO 11:16" /></para>
  <para style="s1">Pumi Zaansaak Minsuuk</para>
  <para style="r">(<ref loc="MAT 26:26-29">Matt 26:26-29</ref>; <ref loc="MRK 14:22-25">Mk 14:22-25</ref>; <ref loc="LUK 22:14-20">Luk 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Anuoiya minchuna hinchu, kei'n nangni naminpaakmong, ajarchu nangni'n ninghei intuup-hi ahongthanasik emak takkha kheella athamaknasik kha eii. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Mansakhet-ah, nangni'n koisuok inkhat-ah ninghei intuup phakhan, nangni karra malung inruolmakchu tikha kei'n kajet; halli kei'n lei-ete tia ngamna kanei, <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />inthiangnga Pathian diang kaom inmani ngaikha indangnasik, suoilekleiya nangni karra malung inruolmakna omsik eii. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Nangni'n ninghei inchun phakhan, nangni'n ningbak kha Pumi zaansaak minsuuk kha emak. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Baksik achu, ningraya-ah mi ngai ngaaklekleiya kabaksik ningsi, mi lekkhatchu inwon chaampi, aleiilaak ngai'n ju inkinrui. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Angme! nangni'n ningbak ning-in nasik ning-inn ommak abe? Emakli Pathian koisuok ningdeiibe khat-um baksik kaneimak mi ngai ningminjakbe? Angme kei'n nangnidiang katisik? Hiwa jarra kei'n nangni kanaminpaak sikbe? Emak, kei'n naminpaaknuning.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Ajarchu nangni diang kinaminchu ngaikha kei'n Pumi diangnga inphut kimu eii, khachu Pumi Jisu, ama injuornasik zaankhan, waipool lekkhat aleiya, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />Pathian diang aleini, ama'n aleikatherra aleiti, “Hiwahi nangni sik-ah kei kataksa kha eii; hiwahi kei na-ngaidon inlang thoru.”<verse eid="1CO 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 11:25" />Khale in-angrip-ah, inbak suoli ama'n rabing kha aleiya aleiti, “Hiwa rabinghi kei thisenna akathar inzootna kha eii, nangni'n ning-in rachamma kei na-ngaidon inlang inru.” <char style="rq"><ref loc="EXO 24:8">Suok 24:8</ref>; <ref loc="JER 31:31-34">Jer 31:31-34</ref>; <ref loc="EXO 24:6-8">Suok 24:6-8</ref></char><verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Nangni'n hiwa waipool ningbak khat-um rabinghi ning-in rachamma, ama juomak laiseng nangni'n Pumi ithikha ningrilmalar kha eii, <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Khawasik jarra, tu ka-ang miring kha'n waipool khat-um rabing kha rahoi suokleiya abak a-in inchu, ama'n Pumi taksa khat-um thisen chungnga manu katho esik eii. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Miring apumtak kha'n inngaidonse inlang, halli ama'n waipool khat-um rabing kha bakrase khat-um inrase. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Tu ka-ang miring kha'n Pumi taksa kha ngaidon tunglekleiya abak a-in inchu, ama'n apumtak chungnga chongtannasik ibak i-in eii. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Khawa jarra eii, nangni katam tak-in ningdammak khat-um ningna, halli lekkhat in ningthijei. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Takkha eini nipum tak-in kadik-ah chong nileitan inchu, eini chungnga chongtan omnuni. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Eini'n manmasituol khale inruoiya nithimak nasik, Pumi'n eini chungnga chong anatanna, eini thanasik anarachaak.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Khawasik bit-ah, ule naingai, nangni'n kabak sik-ah ninghei intuup phakhan, inkhatli inkhat inngaakru. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Awon kacham miring kha'n, innkhan bak rase, ajarchu nangni ninghei intuup phakhan chongtan sikkha emaknasik. Aleiilaak chuon ngai khachu kei'n nangnidiang kaheiwa phakhan minthiar takte.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s1">Ratha Inthiang diangnga inphut Kutchoi ngai</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Tuun, Ratha lamtiang kutchoi ngai jarra, ule naingai,</para>
  <para style="p" vid="1CO 12:1">nangni'n inthiangnga ningjet kha kamanuom. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Nangni'n Pathian ningjetmaklai, karingmak ramil ngaidiang chubei thonasik-ah lamleiitiang katamlang naleikeiruoi. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Khawa jarra kei'n nangni kanaminjetzoot khachu, Pathian Ratha in inruoipui tuteii miring kha'n “Jisu diang khomaak saamnuni!” khat-um Ratha Inthiang in inruoipui miring khan elekleiya “Jisu hi Pumi eii” tinuni.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Kutchoi katamtak om, takkha Ratha chu inkhatbit eii; <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />halli phamtang chu atam, takkha Pumi chu inkhatbit eii; <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />chuonlam chu atam, takkha Pathian inkhatbit khan inchuon inchuonlam kha mi rakipdiang apeii. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Mi rakip thanasik Ratha khan mirakip diang inlar. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Ratha khan miring inkhat diang lungsing lungwar chongkha apeii, khawa Ratha takkhan aleiilaak miring inkhatdiang jetna theina kha apeii. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Inkhatbit ka eii khat-um in-angrip Ratha khan miring inkhatdiang ngamna apeii, khat-um aleiilaak miring inkhatdiang mindam matorna kutchoi apeii. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Ratha khan miring inkhatdiang chuon inlak thomatorna, aleiilaak miringdiang akahongsik rilmatorna, aleiilaak miringdiang ratha ngai thenmatorna, aleiilaak miringdiang inliak chong rilmatorna, halli aleiilaak midiang inliak chongngai maletmatorna apeii.<verse eid="1CO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 12:11" />Hiwa ngai rakip hi inkhatbit khat-um in-angrip Ratha khan itho kha eii; mi rakip diang ama'n ipezoot alak alak kutchoi kha apeii. <char style="rq"><ref loc="ROM 12:6-8">Rom 12:6-8</ref></char><verse eid="1CO 12:11" /></para>
  <para style="s1">Pum inkhat, Saram katamtak</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Pum chu inkhatbit eii takkha saram katamtak in-om, halli saram katamtak khan pum inkhatbit inbool angnga, Christa diang-um eii. <char style="rq"><ref loc="ROM 12:4">Rom 12:4</ref>,<ref loc="ROM 12:5">5</ref></char><verse eid="1CO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 12:13" />Ajarchu Jihudi erase Greek erase, emakli suok khat-um suok ka-emak erase, Ratha inkhatbit khan eini rakip pum inkhatbit enasik-ah baptize anamintho; halli eini rakip Ratha inkhatbit diangnga inphut namin-injei.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Pum kha saram khatbit emak takkha saram katamtak eii. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Keii khan “Keichu kut ki-emak keengnga keichu pum emong” ti-inchu, khawa khan ama kha pum e-emakjei emak. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Halli kuor khan “Keichu mit ki-emak keengnga, keichu pum emong” ti-inchu, khawa khan ama kha pum emongjei titheinuni. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Taksa pumpui mitbit e-inle, hunme nira-ngainasik? Taksa pumpui kuorbit e-inle, hunme arim nimanim nasik? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Takkha pumma kaom saram rakip kha in-omnasik munna ama lungdou nuoiya abool. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Saram ngai rakip in-angrip inle, pum khaleii hun omsikme? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Takkha tuunchu, saram intam innum pum khachu inkhatbit eii.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Khawa jarra, mit khan kut diang, “Nangchu keisik-ah iteii narei ommak titheinuni,” khat-um lu khan keii diang “Nangchu keisik-ah iteii narei ommak titheinuni.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Eini'n saram ngai karra kasuol ngaikha inchel lekleiya iteii thothei numin, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />halli saram ngai karra eini'n nirawat nongmak ngaikha eii eini'n katha doomma nibool; khat-um saram ngai karra enzoot kaommak ngaikha eii eini'n kalurra khoya nitho, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />akathajei saram ngaikha khoya thosik ommak, takkha Pathian in saram ngai rakip aminchun halli insam saram ngaikha kheeldoomma khoya thonasik apeii, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />ajarchu, pumkha inkhoithen ommaknasik, takkha saram rakip ngai'n khat-in inkhat sik-ah in-angrip ngaidon nasik eii. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Saram inkhat in apoongpha khan saram rakip in poongna innei; saram inkhat khoya inthopha khan, saram rakip ngai'n inroksuom.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Tuunchu nangni Christa taksapum kha ning eii, halli nangni rakip, khawa taksapumma kaom saram ngaikha ning eii.<verse eid="1CO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 12:28" />Halli koisuok suungnga Pathian in mansakhet-ah tirton ngaikha insangkhet-ah akadang, inni huuina-ah Pathian chongkachoi ngai, inthum huuina-ah ocha ngai, halli inlak chuonkatho ngai, halli kana kamindam mator ngai, mi kasan ngai, chuon karoon ngai, khat-um inliak chongkaril ngai. <char style="rq"><ref loc="EPH 4:11">Eph 4:11</ref></char><verse eid="1CO 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 12:29" />Mi rakip tirton in-ebe? Mi rakip Pathian chongkachoi in-ebe? Mi rakip ocha in-ebe? Mi rakip inlak chuon inthobe? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Mi rakip kana mindam matorna kutchoi inneibe? Mi rakip inliak chong inrilbe? Mi rakip in chong inmaletbe? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Takkha akathadoom kutchoi ngaikha nangni'n manuomru.</para>
  <para style="p" vid="1CO 12:31">Halli Kei'n akathakhet lamkha kanaminmusik eii.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s1">Minriang</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Kei'n manmasi khat-um marwaan tirton ngai chongnga karil innum, minriang kaneimak inchu, kei darkhuong rasa emakli sumsen kheeng rasa ka eii.<verse eid="1CO 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 13:2" />Kei'n Pathianchong rilsuok matorna ranak kanei innun, inphuumma kaom khat-um jetna theina rakip kajet innum, halli kei'n chingngai minthootnasik ngamna kha kanei innum, minriang kaneimak inchu, kei iteii emong. <char style="rq"><ref loc="MAT 17:20">Matt 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">Mk 11:23</ref></char><verse eid="1CO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 13:3" />Kei'n kinei rakip kapewiak innum, kapum meiya inhaalsik-ah<note caller="+" style="f"><char style="fr" closed="false">13:3. </char><char style="fq" closed="false">Inhaalsik-ah; </char><char style="ft" closed="false">Manuscripts lekkhat inchu </char><char style="fqa" closed="false">in-orpui nasik.</char></note> ka-inpesuok innum, minriang kaneimak inchu, keidiang iteii nemna ommak.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Minriang chu kadei karaat eii, minriang chu inriang kajet eii, minriang khan enhalmak, lok ormak khat-um in-ormak, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />kathamak-ah thomak, ama nemnasikbit entokmak, raangmak, kathamak ngaikha amalungnga ngaidonna damak; <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Minriang chu kathamak-ah rokmak, takkha akadik-ah arok. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Minriang in supmathan mathanmak, angrakip ngamna, angrakip ngaidon, angrakip adei.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Minriang hektik ommak; Pathian chongkachoi ngaichu inlaheksik eii, chong inliak rilmatorna kutchoi ngaikha alamangsik eii; jetna theina kha-um alaheksik eii. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Ajarchu eini jetnahi apum la-emak khat-um Pathian chongkha alek niril; <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />takkha puikatung aheiwa phakhan, alekkha alamangsik eii.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Kei'n naipang ka-elai, naipang angnga karil, naipang angnga ka-ngaidon, naipang imanuom angnga kamanuom, takkha kei'n upa kahong eii khanchu, kei'n naipang omchan ngaikha kamathaan. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Ajarchu tuun nimu hichu aziingna-ah meengsial ni in-en ka-ang eii, takkha meel li meel nila-inmusik eii. Tuunchu kei'n huui katungnga lajetmong, takkha kei huui katungnga inajet angnga kei'n huui katungnga kalajetsik eii.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Tuun ngamna, ngaidonna khat-um minriang hiwa inthumhi mangmu; takkha hiwa ngai karra akalok khetkha minriang hi eii.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s1">Ratha diangnga Kajuo Kutchoi ngai jarra</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Minriang lamkha juiru halli Ratha kutchoi ngai karra aru ka-ekhet ah Pathianchong karilsuok kutchoi kha malung kaluut-ah manuomru. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Ajarchu chong inliak karil ama khan mi ngaidiang iril emak takkha Pathian diang iril eii; ajarchu tuteii innum ama irilkha jetmaneiimu, takkha inthuuk chongkha Ratha-ah iril eii. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Takkha Pathianchong karilsuok ama khan mi ngaidiang iril eii, halli sanna, masokna khat-um matheemtaina apeii. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Chong inliak karil ama khan apumbit inbool, takkha Pathianchong karilsuok ama khan koisuok abool.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Nangni rakip in chong inliak ningril kha kei'n kamanuom, takkha Pathianchong karilsuok khadoom kei'n kanamin ezoot. Koisuok loknasik miring inkhat in chong inliak kha kamalet inommak inchu, Pathianchong karilsuok ama khan chong inliak karil kha neek-ah alok. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Ule naingai, kei'n Pathian chongmalar, jetna theina, Pathianchong emakli minchuna heichoi lekleiya tuun kei'n nangnidiang chong inliak karilla kaheiwa inle, kei nangni sik-ah ang kanemna omme?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Rasa kanei akaringmak phurra, theikhang emakli saraangdar e-innum inrasa inrasa kha inthiangnga insuokmak inle, angrasame tia tu-in jetniame? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Tampalooi khan arasatak suokmak inle, (rasakhat neipot inle) tu-in raalkatho sik-ah insuukniame? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Khawa angnga; nangni'n chong inliak ningril kha injetna chongnga inthiangnga ningril emak inle, nangni iti chongkha tu-in jetniame? Thikaraang diang ningril ka-ang esik eii. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Manmasituolla in-angmak chongyam om, halli chong rakip kha aratha kasuokmak ommak; <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />takkha kei'n chong ratha kha kajetmak inchu, khawa chong karil amadiangchu kei ramkhat mi ka eii, halli ama kha keisik-ah ramkhat mi eii. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Khawa angnga, nangni'n ratha lamtiang kutchoi ngaikha ningmanuom keengnga, koisuok kaminloksik kutchoi ngaikha munasik thoru.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Khawa jarra, chong inliak karil ama khan iril chongkha malet matornasik Pathian diang ranak anisik eii. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Ajarchu kei'n chong inliak-ah Pathian kani inchu, karatha in Pathian ini kha eii, takkha kamalungchu khawa khan ommak. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Halle angme kei'n kathosik? Kei'n ratha-ah Pathian kanisik eii halli kamalungnga um Pathian kanisik eii; ratha-ah laa kasaksik eii, halli kamalungnga um laa kasaksik eii. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Nang in naratha-ah Pathian naminpaak inle, akajetmak inmani ngaikhan angme nitikha jetlekleiya angtho tholia nang minpaakna khan “Amen” intisikme? Ajarchu inmani in nang itikha jetmatormu. <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Nang inchu katha-ah Pathian leiminpaak nate, takkha leiilaak sikbitchu nemna ommak.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Kei'n Pathian kaminpaak ajarchu nangni rakip neek-ah kei'n chong inliak karil; <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />takkha koisuok achu kei'n chong inliak lisingsoom kiril neek-ah kamalungnga minchuna chongramol ra-nga kiril kha athawiai.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Ule naingai, naipang angnga ngaidonkhai maru; kadikmak lamma naipang eru, takkha ka-ngaidon achu upa eru.<verse eid="1CO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 14:21" />Sinadan khan injiajei, “Pumi in ati,</para>
  <para style="q1" vid="1CO 14:21">Chong inliak karil mi ngaidiang inphut halli</para>
  <para style="q2" vid="1CO 14:21">Ramkhat makheiya kaheiwa mi ngai murra inphut</para>
  <para style="q1" vid="1CO 14:21">Kei'n kami ngaidiang karilsik eii,</para>
  <para style="q2" vid="1CO 14:21">takkha inmani ngai'n keidiang narangai nunu.” <char style="rq"><ref loc="ISA 28:11">Isa 28:11</ref>,<ref loc="ISA 28:12">12</ref></char><verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />Khawa angnga, chong inliak hi Pathian kajetngaisik emak takkha Pathian kajetmak ngaisik-ah jetnabi kha eii, halli Pathianchong karilsuok hichu Pathian kajetmak ngaisik emak takkha Pathian kajet ngaisik eii.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Khawa jarra, koisuok rakip in inhei-inchunli chong inliak-ah inrilwiak inle, mileiilaak khat-um Pathian kajetmak mi ngai inheiluut phakhan inmani'n nangni inweet ning-eii natimak nu-abe? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Takkha mi leiilaak khat-um Pathian kajetmak mi inheiluut phakhan nangni rakip in Pathianchong ningrilsuok inchu, kaheiluut ama kha manu karoon ka eii tia nangni'n ningminjet khat-um ning iril Pathianchong khan ama chungnga chong atansik eii, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />amalung suungnga kaom rakip ngaikha rillarta, halli ama khan inbokta “Inthiangnga Pathian nangnile om” tia Pathian chubei athosik eii.<verse eid="1CO 14:25" /></para>
  <para style="s1">Kalurra Pathian Chubei thonasik Dan</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Ule naingai, angme eini'n nitisik? Nangni'n ninghei intuup phakhan, nangni rakip in Pathian minpaakna laa, minchusik chong, Pathian diangnga chongmalar, chong inliak, emakli malet matorna ningnei. Angrakip hi koisuok loknasik ah thoru. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Tu ka-ang in chong inliak inril inchu, miring inni emakli katam khet-ah miring inthum in miringkhat thengnga miring khat-in rilrasu; halli miring inkhat in maletrase. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Takkha tuteii in kamaletsik inommak inchu, chong inliak karil ngaikhan koisuok-ah chongril lekleiya apumdiang khat-um Pathian diang rilchian rase. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Pathianchong karilsuok miring inni emakli miring inthum in rilrasu, halli leiilaak ngai'n inmani irilkha katha-ah chong tanrasu. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Halli in-ongnga kaom miring inkhatdiang Pathian chongkha juotung inchu, kaleiril masa ama kha'n irilkha darase. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Ajarchu mi rakip, inchu indikna khat-um masokna sik-ah nangni rakip in inkhat thengnga inkhat in Pathianchong ningril kha erase. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Pathian chongkachoi ngai ratha kha Pathianchong karilsuok ngai kutchungnga om. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Ajarchu Pathian diang inmak ommak takkha kadai Pathian kha eii.</para>
  <para style="p" vid="1CO 14:33">Pathian ikadang koisuok rakip achu, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />numeisa khan koisuok inchunna ah omchian rase. Ajarchu numeisa chongrilnasik pemu, sina dan kha'n iti angnga, inmani ngaikha nuoikanungnga omrasu. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Inmani'n injetzoot omngai suok-innum, inna inruothar ngaidiang rakelrasu. Ajarchu koisuok-ah numeisa in chongkarilhi jakna kaom eii.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Pathian chonghi nangni diangnga inphut kajuobe? Emakli nangni diangbitbe Pathian chong katung? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Pathian chongkachoi emakli Pathian kutchoi kanei ka-eii kati ama khan, kei'n nangnidiang kimajia chonghi Pumi chongpeii eii tia leirase. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Ama khan hiwahi ara-ngaimak inchu, ama diang-um ra-ngainunu.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Khawa jarra ule naingai, Pathianchong karilsuok sik-ah ningmalung kaluut-ah manuomru, halli chong inliak karil kha-um khaapmaru; <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />takkha angrakip kha katha-ah khat-um madoon kaomma nithosik eii.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s1">Christa Hongringna</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Tuun, ule naingai kei'n nangnidiang kileiriljei chongkahoi, nangni'n ningkeiluutjei halli khawakhan ningngirjei jarra kei'n minjettharna kaneizootrit. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Kei'n nangnidiang kiriljei chongkha nangni'n kacheet-ah ningmahuum inchu, hiwa chonghin nangni ringna ningmusik eii, kha emak inchu nangni ngamna kha nemna kaboi ejei.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Kei innum kimujei, akalok khetkha nangnidiang-um kinapeii kha ejei, khachu Pathian chong dungjuiya Christa kha eini manu sik-ah anathipi, <char style="rq"><ref loc="ISA 53:5-12">Isa 53:5-12</ref></char><verse eid="1CO 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 15:4" />halli ama kha thaanna inreiijei halli Pathian chong dungjuiya nithum huuina nikhuoni khan Christa kha ahongringnookjei, <char style="rq"><ref loc="PSA 16:8-10">Minpkla 16:8-10</ref>; <ref loc="MAT 12:40">Matt 12:40</ref>; <ref loc="ACT 2:24-32">Chuon 2:24-32</ref></char><verse eid="1CO 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 15:5" />halli Peter diang inlarjei khawa thengnga tirton soomleini diang ama'n inlarjei. <char style="rq"><ref loc="LUK 24:34">Luk 24:34</ref>; <ref loc="MAT 28:16-17">Matt 28:16-17</ref>; <ref loc="MRK 16:14">Mk 16:14</ref>; <ref loc="LUK 24:36">Luk 24:36</ref>; <ref loc="JHN 20:19">Jn 20:19</ref></char><verse eid="1CO 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 15:6" />Khawa thengnga ama'n ule nai miring raja ra-nga neek-ah katam diang munkhat-ah inlarjei, inmani ngai karra miring lekkhatchu inthijei innum akatamlang chu inringnga inlaom. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Khawa thengnga ama'n James diang, halli tirton rakip diang inlarjei.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />Ahekna-ah, nikhuo huuilekleiya injuonei naiteii<note caller="+" style="f"><char style="fr" closed="false">15:8. </char><char style="fq" closed="false">Nikhuo huuilekleiya injuonei; </char><char style="ft" closed="false">emakli </char><char style="fqa" closed="false">apha ka-emak-ah injuonei.</char></note> ka-ang keidiang um ama'n inlarjei. <char style="rq"><ref loc="ACT 9:3-6">Chuon 9:3-6</ref></char><verse eid="1CO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 15:9" />Ajarchu tirton rakip ngai karra kei akasiinkhet ka eii khat-um tirton tia koisik-um kei rahoi suokmong, ajarchu Pathian koisuok kha kei'n kaleiminpoong kaleiminraal. <char style="rq"><ref loc="ACT 8:3">Chuon 8:3</ref></char><verse eid="1CO 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 15:10" />Takkha tuun tuunna kei'n ki-ehi Pathian riangwai jarra eii, halli ama riangwai kha kei kachungnga lailamma mangmak. Kei tirton rakip neek-ah chuon kangar, chuon kangar kha kei emong, takkha kei diangnga kaom Pathian riangwai kha eii. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Kei'n ka-e innum inmani'n in-e innum, hinthoa keini'n Pathian chong kilrilsuok halli nangni innum ningngamnajei.<verse eid="1CO 15:11" /></para>
  <para style="s1">Akathi ngai Hongring nookna</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Christa kha kathi makheiya ahongringjei tia inrilsuok inle, angjarra nangni lekkhat in akathi ngai ringnunujei ningtime? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Akathi ngai hongring nooksik tihi ommak inchu, Christa kha-um lahongringmak; <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Christa kha lahongringmak inchu, eini irilsuok ngaihi nemna kaboi eii halli nangni ngamna kha-um nemna kaboi kha eii. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Khawa chungnga Pathian jarra akadikmak chongkarilsuok ni-esik ejei, ajarchu Pathian in Christa kha akathi makheiya inphut aminringjei tia eini'n nirilsuokjei, takkha akathi ngaikha ringnunujei tihi etak inchu, Pathian innum Christa kha minringmakjei. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Ajarchu kathi ngaikha inringmak inchu, Christa kha-um lahongringmak. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Halli Christa kha hongringmak inchu, nangni ngamna kha nemna kaboi eii, khat-um tuunkatung ningmanu roonkhan ningringnga ninglaom. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Halli Christa diangnga akathi ngai-um akamangkha in-ejei. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Hiwa ringkhuo sikbit eini'n Christa ni-ngamna e-inchu, miring rakip neek-ah minriang kaom ngaikha ni-ejei.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Takkha akathi ngai karra akara mansakhet Christa kha inthiangnga akathi makheiya aringjei. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Miring inkhat diangnga inphut kathi ajuo, miring inkhat diangnga inphut kathi ngaikha inringritsik eii. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Adam diangnga inphut mi rakip inthi angnga, Christa diangnga inphut mi rakip inringsik eii. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Takkha mi rakip ama ama pha-ah aminringsik eii: Christa in mansakhet-ah, halli ama diangnga kaom mi ngai'n Christa juonikhan inringsik eii. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Halli ahekna phakha aheiwasik ejei, Christa in waikaroon rakip, thomatorna kanei rakip khat-um ranak rakip ngaikha minmangta, halli rengram kha Apa Pathian diang apesik eii.<verse eid="1CO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 15:25" />Ama inhalpui mi rakip akeii nuoiya adamaklaiseng Christa in wai aroonsik eii. <char style="rq"><ref loc="PSA 110:1">Minpkla 110:1</ref></char><verse eid="1CO 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 15:26" />Ahekna khet-ah alaminmangsik inhalpui lakaom kha kathi hi eii.<verse eid="1CO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 15:27" />“Ajarchu Pathian in angrakip kha ama kenuoiya adajei.” Christa kenuoiya kadapi Pathian apum takchu “Angrakip” ama nuoiya adajei iti khan inchelmak itihi inthiangnga inlar. <char style="rq"><ref loc="PSA 8:6">Minpkla 8:6</ref></char><verse eid="1CO 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 15:28" />Angrakip kha Christa wairoon nuoiya in-om phakhan, Asapa apum tak-um ama wairoon nuoiya angrakip kadapi Pathian nuoiya aomsik eii; halli Pathian in angrakip chungnga wai aroonsik eii.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Akathi ngaikha inringmaksik e-inle, akathi ngai sik-ah baptize katho ngaileii angme inthosik? Angjarra mi ngai'n kathi ngaisik-ah baptize inthopime? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Angsiya keini'n kinpoong nasik ah phadan rakip kinthosik eyabe? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Ule naingai, nangni chungnga eini Pumi Christa Jisu diangnga inphut kimu in-orna khan hiwahi namilrilsuok, khachu kei nisuo rakip kathi!<verse eid="1CO 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 15:32" />Miring i-ngaidon dungjuiya kei in Ephesia ah ramsa ngaile kin-inbuol e-inle, kei ang kanemna omme? Akathi ngai inringmaksik e-inchu, “Eini'n bakrui inrui, ajarchu ziingnga nithisik eii.” <char style="rq"><ref loc="ISA 22:13">Isa 22:13</ref></char><verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Lamleiitiang inkeiruoimaru: “Sap kathamak khan nunchan katha kha aminmang.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Singtheiya ngaidon inlang, halli manu thokhaimaru. Hiwahi nangni naminjak nasik kiti eii ajarchu nangni lekkhatchu Pathian jetmakchu.<verse eid="1CO 15:34" /></para>
  <para style="s1">Akathi makheiya Ahongkaring Taksa jarra</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Takkha mi lekkhat in “Angtho tholi akathijei kha aminringsikme? Angkachang taksa-ah inhongring sikme?” tia narakel inte. <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Aka-am ngai! nangni'n ningwor aru kha athimaklaiseng hongmoongmak. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Nangni'n aru ningwor phakhan, ahong ka-esik akuungkha lingmakchu, takkha saang kuungsik erase emakli leiilaak kuung erase aru kha eii ningwor. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Takkha Pathian in alungdou nuoiya akuung kha apeii, halli muchiru rakip diang ama ama kuungkha apeii.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Taksa rakip kha in-angmu: manmasi ngai'n taksa khat, sa ngai'n taksa khat, wa ngai'n taksa khat, halli nga ngai'n taksa khat in-eii.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Lairalak-ah taksa ngai inom khat-um nuoipil chungnga taksa ngai inom; marwaanna kaom taksa ngai kul ra-ang khat eii, halli nuoipil chungnga kaom taksa ngai kul ra-ang in khat eii. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Kani kul ra-ang khat eii, tha kul ra-ang in khat eii, arsi ngai kul ra-ang in khat erit; halli arsi inkhatli arsi inkhat kul ra-ang kha in-angmu.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Akathi ngai hongkaringsik kha-um khawa ka-ang eii. Inphuum taksa kha kathi eii, kathimak sik-ah minring. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Khoya omlekleiya wor, kul ra-angle inruoiya minring; ranak kaboiya wor, ranak kangarra minring, <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />miring taksa-ah wor, ratha taksa-ah minring. Miring taksa om-inchu, ratha taksa um om.<verse eid="1CO 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45" />Hintia injiajei: “Manmasi mansakhet Adam kha akaring miring kha eii,” ahekna Adam kha ringna kapeii ratha kha eii. <char style="rq"><ref loc="GEN 2:7">Inphut 2:7</ref></char><verse eid="1CO 15:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1CO 15:46" />Ratha kha ma-insa emak takkha taksa kha ma-insa eii, halli khawa thengnga ratha kha eii. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Manmasi mansakhet kha dialdook-ah inbool nuoipilchung mi eii; inni huuina miring kha marwaan makheiya eii. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Nuoipilchung mi ka-eseng neipilla inbool miringpa ka-ang in-eii; halli marwaan mi ngaiseng marwaan makheiya kajuo miringpa ka-ang in-eii. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Dialdook-ah inbool mipa ramil eini'n nilei angnga, marwaan makheiya mipa ramil kha eini'n nileisik kha eii.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Ule naingai, hiwahi kei'n nangnidiang kanati: taksa li thisen khan Pathian rengram mutheinuni, kathisik khan kathimaksik khan luuttheinunu.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Ra-ngairu, inthuuk chong kei'n nangnidiang rilkate. Eini rakip in thinumin, takkha eini rakip ni-inthuulsik eii, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />innottheiya, mit machim inkhat-ah, ahekna tampalooi rasa juoneini khan, ajarchu tampalooi kha rasa juoneisik eii, halli akathi ngaikha kathimak sik-ah inhongringsik eii, halli eini'n ni-inthuulsik eii. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Ajarchu kamangsik kha kamangmaksik-ah halli kathisik kha kathimak sik-ah inthuulsik eii.<verse eid="1CO 15:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54" />Kamangsik kha kamangmak sik-ah halli kathisik kha kathimak sik-ah inthuuljei inchu, “Kathi kha matorjei; matorna kha huui tungjei.” tia injia-ah kaom Pathian chongkha kadik-ah hongtungsik kha ejei: <char style="rq"><ref loc="ISA 25:8">Isa 25:8</ref></char><verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“E kathi, nang matorna kha hume?</para>
  <para style="q1" vid="1CO 15:55">E thina, nang natur kha hun ommejei?” <char style="rq"><ref loc="ISA 25:8">Isa 25:8</ref></char><verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />Thina tur khachu manu eii, halli manu ranak khachu Dan kha eii. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Takkha eini Pumi Jisu Christa diangnga inphut matorna kanapeii Pathian kha minpaakrui.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Khawa jarra kinaminriang ule naingai, Pumi chuonsik bit-ah chuon ngarru, kacheet-ah ngirru, purmaru, ajarchu Pumi sik-ah nichuontho kha nemna kaboi emak tihi nangni'n ningjet.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s1">Pathian Ka-ngamna Sara ngai sik-ah Kutchoi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Tuun, Pathian mi ngai sik-ah sialrathai jarra, kei'n Galatia-ah kaom koisuok ngaidiang thoru kileiti angnga, nangni innum thoru. <char style="rq"><ref loc="ROM 15:25">Rom 15:25</ref>,<ref loc="ROM 15:26">26</ref></char><verse eid="1CO 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 16:2" />Khuoserni rakip nangni'n sial lekkhat ning ilou makheiya ningkhoithenli mintuupningta ningreiisik kha eii, ajarchu kei'n kaheiwa phakhan sialrathai ommaknasik eii. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Kei'n kaheitungli, chonglamsaat chemajia kha nangni'n ningzoot mi ngaidiang pekata, Jerusalemma nangni kutchoi kathaksik kaminsisik eii. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Kei um simak kathamak omngai suok-inchu, inmani'n keile insisik eii.<verse eid="1CO 16:4" /></para>
  <para style="s1">Paul I-ngaidon</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Kei'n Macedonia karakaan suoli nangnidiang kaheiwasik eii, ajarchu kei'n Macedonia ramsuungnga kasisik eii. <char style="rq"><ref loc="ACT 19:21">Chuon 19:21</ref></char><verse eid="1CO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 16:6" />Kei'n kasinasik rakip-ah nangni'n ningnasan nasik, kei apha bongkhat, emakli phalbitha seng nangnile kaomsik eii. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Kei'n kasina lamma kaheiluutli nangni kinamu kha kei'n manuommong; Pumi izoot e-inchu, aphakhat nangnile kiomsuom kha kamanuom.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Takkha Pentecost heitungmak laisengchu kei Ephesia ah kaomsik eii, <char style="rq"><ref loc="LEV 23:15-21">Levi 23:15-21</ref>; <ref loc="DEU 16:9-11">Innidan 16:9-11</ref>; <ref loc="ACT 19:8-10">Chuon 19:8-10</ref></char><verse eid="1CO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 16:9" />ajarchu kei kana-enzootmak mi katamtak inom innum, chuon kalok thonasik kot kalok inkhat kei sik-ah inlongnga om.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Timothy aheiwa inchu, nangni karra kahoiya omnasik nangni'n katha-ah donru, ajarchu kei angnga Pumi chuon katho miring inkhat eii. <char style="rq"><ref loc="1CO 4:17">1 Cor 4:17</ref></char><verse eid="1CO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 16:11" />Tuteii innum ama kha donmak thomaru. Ama'n kahoi kadaiya kei kadiang hongnasik ah nangni'n lam leikeiru, ajarchu ule nai ngaile inruoiya ama'n ihongkha kei'n kangaak.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Takkha eini ule nai Apollos chu, leiilaak ule naingai khale nangni diang heiwanasik ah kei'n ranak-ah kamasok. Takkha tuun tuunchu ama'n heiwasik tia la-ngaidonmak<note caller="+" style="f"><char style="fr" closed="false">16:12. </char><char style="fq" closed="false">tuun tuunchu ama'n heiwasik tia la-ngaidonmak; </char><char style="fqa" closed="false">Pathian lungdou takkha la-emak</char></note>, ama'n atongpha khan heiwate.<verse eid="1CO 16:12" /></para>
  <para style="s1">Insuona Chong</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Inringchakru, ngamna khan kacheet-ah ngirru, pasal suokru, ranak ngarru. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Angrakip minriang le inruoiya thoru.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Ule naingai, Stephanas khat-um ama insuungkhur in-eii Achaia-ah mansakhet ah Christian ka eii tihi nangni'n ningjet, halli inmani ngai'n Pathian ikadang mi ngai sepa katho sik-ah inpesuok. <char style="rq"><ref loc="1CO 1:16">1 Cor 1:16</ref></char><verse eid="1CO 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 16:16" />Inmani ka-angngai khat-um inmanile chuonkatho suomngai nuk juiru tia kei'n nangnidiang kiti eii.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Stephanas, Fortunatus khat-um Achaicus ngai'n inheiwa jarra kei'n karok, ajarchu nangni'n ningsili insam ngaikha inmani'n inmintungnookjei <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />halli inmani'n nangni naminrok angnga kei karatha inminrok. Hiwa ka-ang mi ngaihi manilmaru.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Asia ramsuungnga kaom koisuok ngai'n nangnidiang minpaakna chong innahongpeii. Aquila li Priscilla, khat-um in-inn na kaom koisuok ngaile inruoiya Pumi ramingnga nangnidiang minpaakna innahongpeii. <char style="rq"><ref loc="ACT 18:2">Chuon 18:2</ref></char><verse eid="1CO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 16:20" />Ule nai rakip ngai'n minpaakna chong innahongpeii.</para>
  <para style="p" vid="1CO 16:20">Inthiang inzoople inruoiya inkhatli inkhat inpaakru.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Paul kei'n kakut tak-ah hiwa minpaakna chonghi kimajia eii.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Tu ka-ang mi khan Pumi aminriangmak inchu, ama chungnga khomaak omrase.</para>
  <para style="p" vid="1CO 16:22">
    <char style="tl">Marana tha</char>–Pumi juotro.<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Pumi Jisu riangwai kha nangni chungnga omrase.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />Christa Jisu diangnga inphut kei minriangna kha nangni rakip diang omrase. Amen.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>