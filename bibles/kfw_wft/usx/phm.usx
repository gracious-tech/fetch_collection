<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">Kharam: Bible Translation 1st Edition.</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">Philemon</para>
  <para style="toc1">PHILEMON Diang Paul Chemajia</para>
  <para style="toc2">Philemon</para>
  <para style="toc3">Philem</para>
  <para style="mt1">PHILEMON</para>
  <para style="mt2">Diang Paul Chemajia</para>
  <para style="imt1">Chonglamsaat</para>
  <para style="ip">Philemon larik hi tirton Paul imajia eii (1:1). Hiwa larik amajia phahin Paul hi mikhumna ah aleiom, khawa jarra hiwa larik hi Rome makheiya imajia lei-ete tia inlei. Paul in Rome mikhumna ah omlai e-inchu hiwa larik hi Colossia larik amajiana kum khale in-ang rip-ah Jisu Christa inneisuo thengnga kum soomruk leikhat pheiwei imajia eii.</para>
  <para style="ip">Paul in hiwa chemajia hi Philemon inti miring inkhatdiang imajia eii. Philemon hi Colosea koisuok mi eii halli suok inkhat kadoon miring inkhat eii. Paul in hiwa larik hin Philemon diang naphur maruup ah kataanjei asuok Onesimus kha rachaak maknasik-ah imajia eii. Rome ngai sinadan dungjuiya Philemon in Onesimus hi athat innum dan koimak. Takkha Paul in Philemon diang Onesimus hi Christian ule nai inkhat-ah ralaangro halli Paul le chuon kathosuom sik-ah nazootpiro tia Philemon diang imatheemle inruoiya masokna anei (1:13-14).</para>
  <para style="iot">Asuungnga kaom Chong</para>
  <para style="io1">1. Paul in Philemon diang minpaakna chong pena anei <char style="ior">(<ref loc="PHM 1:1-3">1:1-3</ref>)</char></para>
  <para style="io1">2. Paul in Onesimus rathuulla Philemon diang Onesimus hi christian ulenai inkhat-ah ralaangro tia majiana anei <char style="ior">(<ref loc="PHM 1:4-21">1:4-21</ref>)</char></para>
  <para style="io1">3. Paul in Philemon iminpaakle inruoiya nisuokhat najuopha kate tia majiana anei <char style="ior">(<ref loc="PHM 1:22-25">1:22-25</ref>)</char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Paul, Christa Jisu sik-ah mikhumna ah kaom khat-um einile ulenai ka-eii Timothy inmani inni'n,</para>
  <para style="p" vid="PHM 1:1">einile sap ka-eii khat-um nichuon thopui Philemon diang,<verse eid="PHM 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHM 1:2"/>halli ninainu Apphia diang khat-um einile raalmi ka-eii Archippus, han nang inna inchun koisuok ngaidiang: <char style="rq"><ref loc="COL 4:17">Col 4:17</ref></char><verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Nipa Pathian khat-um Pumi Jisu Christa in nangnidiang riangwai li kadai kha inapeii erase.<verse eid="PHM 1:3"/></para>
  <para style="s1">Philemon Ngamna li Minriang</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>Philemon, Kei'n Pathian kaniracham, kei'n nang sik-ah kani halli Pathian kha kaminpaak. <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>Ajarchu Pathian mi ngai rakip niminriang khat-um Pumi Jisu ningamna kha kei'n kajet. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>Eini'n Christa diangnga nimu akatha phur rakip ngaihi inmani'n injetwiak nasik ranak-ah nang ngamna kha narilnasik-ah kei'n Pathian diang kani. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Minriang kaom Philemon, nang minriangna khan keidiang rokna angjet khat-um masokna kamujei, ajarchu nang in Pathian mi ngai malungkha naminrokjei.<verse eid="PHM 1:7"/></para>
  <para style="s1">Onesimus sik-ah Ngaidam Nina</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Hiwasik jarra kei'n ranak kaneiya thosik kasuok hi thoro tiya Christa diang ulenai inkhat-ah chongpeii napethei eii. <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>Takkha Paul kei'n, Christa Jisu sik-ah chuonkatho, halli tuun Christa Jisu sik-ah mikhumna ah kaom ka-e innum,<note caller="+" style="f"><char style="fr" closed="false">1:9: </char><char style="fq" closed="false">Christa Jisu sik-ah chuonkatho, halli tuun Christa Jisu sik-ah mikhumna ah kaom; </char><char style="ft" closed="false">emakli </char><char style="fqa" closed="false">upa ka-eii, han Christa Jisu sik-ah tuun tuun mikhumna ah kaom.</char></note> minriang jarra, kei'n nangdiang ngaidam kinani eii.<verse eid="PHM 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PHM 1:10"/>Kei'n mikhumna ah kaompha Christa diang kasapa kimin ejei Onesimus rathuulla kei'n nangdiang ngaidam kinani eii. <char style="rq"><ref loc="COL 4:9">Col 4:9</ref></char><verse eid="PHM 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PHM 1:11"/>Aphakhat ama hi nangdiang nemna kaboi alei-eii, takkha tuunchu ama hi nang sik-um kei sik-um nemna kaomkha<note caller="+" style="f"><char style="fr" closed="false">1:11: </char><char style="ft" closed="false">Greek chongnga Onesimus tinachu “Nemna kaom.”</char></note> ejei.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>Kamalung ka-ejei Onesimus hi nangdiang kei'n inlet-ah kiheitirnook ejei. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>Kei'n chongkahoi jarra mikhumna ah kaomlaiseng kei kanasan sik-ah ama hi kakoolla nang rathuulla kadazoot. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>Takkha nang izoot omlekleiya kei'n iteii thonuning, nazootmak pumma nitho elekleiya; khawa rathuulla nang in nazootli napum tak-in karok-ah nithokha kamanuom.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>Onesimus apha bongkhat nangdiangnga inphut isikha apha rakip-ah nangdiang kaom enasik bit-ah kasuok kha eii. <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>Onesimus suok enunijei, takkha suok neek-ah katha kha eii. Christa diang minriang kaom unai kha ejei. Kei'n ama hi kaminriang takkha nang indoom ama hi suok inkhat-ah khat-um Pumi diang ulenai inkhat-ah naminriang doomsik eii.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Nang in keihi nachuon thopui inkhat-ah nanalei inchu, nang in kei nanadonsik angnga ama hi donthar nookro. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>Ama'n nangdiang kadikmak khat-um intuol om-inchu keidiang na-ep ro. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Paul kei'n kakut tak-ah kimajia kha eii: kei'n kanathuulsik eii. Takkha nang ringkhuo ah keidiang ni-intuol hichu kei'n rilnuningjei. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>Minriang kaom suopui, Pumi sik-ah hiwahi nathopi inlang Christa diang kamalung naminrokpiro.<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>Kei'n kimajiale inruoiya kana-ngamna, khachu kei itihi nang in thonate tia kingamnabit elekleiya nang in kheella thonate tia kalei. <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>Hile inruoiya kei omnasik-ah nang inna omna mun inkhat leiboolro ajarchu kei'n nangni koolla juonasik nangni'n Pathian ningni kha namasangjeiti tia kangamna.<verse eid="PHM 1:22"/></para>
  <para style="s1">Ahekna Chong</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>Christa Jisu sik-ah keile mikhumna ah kaomsuom Epaphras in minpaakna chong anahongminchoi <char style="rq"><ref loc="COL 1:7">Col 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char><verse eid="PHM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PHM 1:24"/>halli khale in-ang rip-ah kachuon thopui Mark, Aristarchus, Demas khat-um Luke inmani innum minpaakna chong innahongminchoi. <char style="rq"><ref loc="ACT 12:12">Chuon 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="ACT 19:29">19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">Col 4:10</ref>,<ref loc="COL 4:14">14</ref>; <ref loc="2TI 4:10">2 Tim 4:10</ref>,<ref loc="2TI 4:11">11</ref></char><verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>Pumi Jisu Christa riangwai kha nangni rakip chungnga kaom kha erase.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
