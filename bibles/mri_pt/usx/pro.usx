<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">pro.txt Māori macronized text, extracted 16-05-06</book>
  <para style="h">Whakatauki</para>
  <para style="toc3">Wtki</para>
  <para style="mt2">Ko ngā</para>
  <para style="mt1">Whakatauki</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Ko ngā whakatauki a Horomona tama a Rāwiri, kīngi o Īharaira.<verse eid="PRO 1:1" /></para>
  <para style="s">Te Painga o ngā Whakatauki</para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />E mōhiotia ai te whakaaro nui, te ako,</para>
  <para style="q2" vid="PRO 1:2">e kitea ai ngā kupu o te mātauranga,<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />e riro mai ai te ako a te ngākau mahara,</para>
  <para style="q2" vid="PRO 1:3">te tika, te whakawā, te mea anō e rite ana.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Hei hoatu i te ngākau tūpato ki ngā kūware,</para>
  <para style="q2" vid="PRO 1:4">i te mātauranga, i te ngārahu pai ki te taitamariki.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Kia whakarongo ai te tangata whakaaro nui, kia nui ake ai tōna mōhio;</para>
  <para style="q2" vid="PRO 1:5">kia whiwhi ai te tangata tūpato ki ngā whakaaro mōhio;<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />e mōhio ai ia ki te whakatauki, ki te kupu whakarite,</para>
  <para style="q2" vid="PRO 1:6">ki ngā kupu a ngā whakaaro nui, ki ā rātou kōrero whakapeka.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Ko te wehi ki a Ihowā te tīmatanga o te mātauranga;</para>
  <para style="q2" vid="PRO 1:7">e whakahāwea ana te whakaarokore ki te whakaaro nui, ki te ako.<verse eid="PRO 1:7" /></para>
  <para style="b" />
  <para style="s">He Tohutohu ki ngā Taiohi</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Whakarongo, e tāku tama, ki te ako a tōu pāpā,</para>
  <para style="q2" vid="PRO 1:8">kaua hoki e whakarērea te ture a tōu whaea;<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />ka waiho hoki ēnā hei pare ātaahua mō tōu mātenga,</para>
  <para style="q2" vid="PRO 1:9">hei mekameka whakapaipai mō tōu kakī.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />E tāku tama, ki te whakawaia koe e te hunga hara,</para>
  <para style="q2" vid="PRO 1:10">kaua e whakaae.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Ki te mea rātou, “Tātou ka haere, ka whakapapa atu, ka whakaheke toto;</para>
  <para style="q2" vid="PRO 1:11">kia whanga puku tātou, he mea takekore, mō te tangata harakore;<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />horomia oratia rātou e tātou, pērātia me tā te rua tūpāpaku;</para>
  <para style="q2" vid="PRO 1:12">ka riro tinana rātou, ka pērā me te hunga e heke atu ana ki te poka.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Ka kitea e tātou ngā taonga utu nui katoa;</para>
  <para style="q2" vid="PRO 1:13">ka whakakīia ō tātou whare ki tā tātou e pāhua ai.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Makā mai tōu wāhi ki roto ki tō mātou;</para>
  <para style="q2" vid="PRO 1:14">kia kotahi te pūtea mā tātou katoa” –<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />e tāku tama, kaua e haere tahi i te ara me rātou,</para>
  <para style="q2" vid="PRO 1:15">kaiponuhia tōu waewae i tō rātou huarahi;<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />e rere ana hoki ō rātou waewae ki te kino,</para>
  <para style="q2" vid="PRO 1:16">e hohoro ana rātou ki te whakaheke toto.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />He maumau hoki te hora o te kupenga</para>
  <para style="q2" vid="PRO 1:17">ki te tirohanga a tētahi manu;<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />ko rātou, he whakaheke i ō rātou toto anō i whakapapa ai rātou;</para>
  <para style="q2" vid="PRO 1:18">he whakamate i a rātou anō i piri ai rātou.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Ka pēnā ngā huarahi o te hunga apo taonga;</para>
  <para style="q2" vid="PRO 1:19">ko te ora anō o ōna rangatira e tangohia.<verse eid="PRO 1:19" /></para>
  <para style="b" />
  <para style="s">Te Karanga o te Whakaaronui</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />E hāmama ana te whakaaro nui i te huarahi;</para>
  <para style="q2" vid="PRO 1:20">e puaki ana tōna reo i ngā waharoa.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />E karanga ana ia i te tino wāhi whakaminenga;</para>
  <para style="q2" vid="PRO 1:21">i te wāhi tuwhera o ngā kūwaha, i roto i te pā, e puaki ana āna kupu:<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“E te hunga kūware, kia pēhea ake te roa</para>
  <para style="q2" vid="PRO 1:22">o tō koutou aroha ki te kūwaretanga?</para>
  <para style="q1" vid="PRO 1:22">O te hiahia rānei o te hunga whakahī</para>
  <para style="q2" vid="PRO 1:22">ki tō rātou whakahī?</para>
  <para style="q2" vid="PRO 1:22">O te whakakino rānei a te hunga wairangi ki te mātauranga?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Tahuri mai ki tāku ako;</para>
  <para style="q1" vid="PRO 1:23">nā, ka ringihia e ahau tōku wairua ki a koutou,</para>
  <para style="q2" vid="PRO 1:23">ka whakaaturia āku kupu ki a koutou.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />I karanga atu hoki ahau, heoi kīhai koutou i pai mai;</para>
  <para style="q2" vid="PRO 1:24">i totoro atu tōku ringa, ā, kīhai tētahi i whai whakaaro mai;<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />heoi, whakakāhoretia iho e koutou tōku whakaaro katoa,</para>
  <para style="q2" vid="PRO 1:25">kīhai hoki i aro ki tāku ako.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Mō reira ka kata ahau i te rā o tō koutou aituā;</para>
  <para style="q2" vid="PRO 1:26">ka tāwai ina pā te pāwera ki a koutou;<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />ina tae mai tō koutou pāwera ānō he tūpuhi,</para>
  <para style="q2" vid="PRO 1:27">ā, ka pā mai tō koutou aituā ānō he paroro;</para>
  <para style="q2" vid="PRO 1:27">ina tae mai te pōuri me te ngākau mamae ki a koutou.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />“Ko reira rātou karanga ai ki ahau, ā, e kore ahau e whakahoki kupu atu;</para>
  <para style="q2" vid="PRO 1:28">ka rapu nui rātou i ahau, otiia e kore ahau e kitea e rātou.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Mō rātou i kino ki te mātauranga;</para>
  <para style="q2" vid="PRO 1:29">kīhai hoki i whiriwhiria e rātou te wehi ki a Ihowā;<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />kīhai i aro mai ki ōku whakaaro;</para>
  <para style="q2" vid="PRO 1:30">whakahāwea ana rātou ki tāku kupu riri katoa,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />nā reira ka kai rātou i ngā hua o tō rātou nei ara,</para>
  <para style="q2" vid="PRO 1:31">ka whakakīia anō hoki ki ngā mea i titoa e rātou.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Ko te tahuritanga atu hoki o ngā kūware hei patu i a rātou;</para>
  <para style="q2" vid="PRO 1:32">ko te ngākau warea anō hoki o ngā wairangi hei huna i a rātou.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Ko te tangata ia e rongo ana ki ahau,</para>
  <para style="q2" vid="PRO 1:33">ka au tōna noho, ka ātea hoki i te wehi ki te kino.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">Ngā Huanga o te Whakaaronui</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />E tāku tama, ki te tango koe i āku kupu,</para>
  <para style="q2" vid="PRO 2:1">ki te huna i āku whakahau ki roto ki a koe,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />ā, ka tahuri tōu taringa ki te whakaaro nui,</para>
  <para style="q2" vid="PRO 2:2">ka anga anō tōu ngākau ki te mātauranga;<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />āe rā, ki te mea ka kārangarangatia e koe te mātauranga,</para>
  <para style="q2" vid="PRO 2:3">ā, ka puaki tōu reo ki te ngākau mōhio;<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />ki te rapua hoki ia e koe ānō he hiriwa,</para>
  <para style="q2" vid="PRO 2:4">ki te kimihia ānō he taonga huna –<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />ko reira koe mātau ai ki te wehi o Ihowā,</para>
  <para style="q2" vid="PRO 2:5">kite ai i te mōhio ki te Atua.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Mā Ihowā hoki e hōmai te whakaaro nui;</para>
  <para style="q2" vid="PRO 2:6">nō tōna māngai te mātauranga me te ngākau mōhio.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />E rongoātia ana e ia te whakaaro nui mā te hunga tika;</para>
  <para style="q2" vid="PRO 2:7">he whakangungu rākau ia mō te hunga he tapatahi nei te haere,<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />kia tiakina ai e ia ngā ara o te whakawā,</para>
  <para style="q2" vid="PRO 2:8">kia tohungia ai te ara o tāna hunga tapu.<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Ko reira koe mōhio ai ki te tika, ki te whakawā, ki te mea anō e rite ana,</para>
  <para style="q2" vid="PRO 2:9">āe rā, ki ngā ara pai katoa.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Ka uru hoki te whakaaro nui ki roto ki tōu ngākau,</para>
  <para style="q2" vid="PRO 2:10">ā, ka reka te mātauranga ki tōu wairua;<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />ka ai te ngārahu pai hei tiaki i a koe,</para>
  <para style="q2" vid="PRO 2:11">te ngākau mōhio hei pupuri i a koe;<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />hei kukume mai i a koe i te ara o te kino,</para>
  <para style="q2" vid="PRO 2:12">i te tangata e puta kē ana āna kōrero;<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />i te hunga e whakarere nei i ngā ara o te tika,</para>
  <para style="q2" vid="PRO 2:13">e haere ana i ngā ara o te pōuri;<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />e koa ana, i a rātou e mahi ana i te kino,</para>
  <para style="q2" vid="PRO 2:14">e hari ana ki ngā tikanga parori kē o te kino;<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />he ara kōpikopiko ō rātou,</para>
  <para style="q2" vid="PRO 2:15">he whanokē rātou i ō rātou huarahi;<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />hei whakaora i a koe i te wahine tauhou,</para>
  <para style="q2" vid="PRO 2:16">i te wahine tauhou e whakapati nei ki āna kupu.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Kua whakarērea nei e ia te hoa o tōna tamāhinetanga,</para>
  <para style="q2" vid="PRO 2:17">kua wareware ki te kawenata o tōna Atua.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />E heke atu ana hoki tōna whare ki te mate,</para>
  <para style="q2" vid="PRO 2:18">ōna ara ki ngā tūpāpaku.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Ko te hunga katoa e haere atu ana ki a ia e kore e hoki mai;</para>
  <para style="q2" vid="PRO 2:19">e kore anō e mau i a rātou ngā ara o te ora.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Ā, ka haere koe i ngā ara o ngā tāngata pai,</para>
  <para style="q2" vid="PRO 2:20">ka mau anō ki ngā ara o te hunga tika.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Ka noho hoki te hunga tika ki te whenua;</para>
  <para style="q2" vid="PRO 2:21">ka mau te hunga ngākau tapatahi ki reira.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Ka hātepea atu ia te hunga kino i runga i te whenua,</para>
  <para style="q2" vid="PRO 2:22">ka hūtia atu i reira te hunga he kōpeka tā rātou mahi.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">Me Whakawhirinaki ki a Ihowā</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />E tāku tama, kei wareware ki tāku ture;</para>
  <para style="q2" vid="PRO 3:1">kia puritia hoki āku whakahau e tōu ngākau.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Kātahi ka nui ake ngā rā roa mōu,</para>
  <para style="q2" vid="PRO 3:2">ngā tau e ora ai, me te āta noho.<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Kei whakarērea koe e te atawhai, e te pono;</para>
  <para style="q2" vid="PRO 3:3">heia ki tōu kakī;</para>
  <para style="q2" vid="PRO 3:3">tuhituhia iho ko tōu ngākau ānō hei papa.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Pēnei ka whiwhi koe ki te atawhai,</para>
  <para style="q2" vid="PRO 3:4">ki te mātauranga pai i te aroaro o te Atua, o te tangata.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Whakapaua tōu ngākau ki te whakawhirinaki ki a Ihowā,</para>
  <para style="q2" vid="PRO 3:5">kaua hoki e okioki ki tōu mātauranga ake.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />I ōu ara katoa whakaaro ki a ia,</para>
  <para style="q2" vid="PRO 3:6">ā, māna e whakatika ōu huarahi.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Kei whakaaro ki a koe he mōhio koe;</para>
  <para style="q2" vid="PRO 3:7">e wehi ki a Ihowā, kia mawehe i te kino;<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />hei ora tēnā ki tōu pito,</para>
  <para style="q2" vid="PRO 3:8">hei mākūkū ki ōu wheua.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Kia whai korōria a Ihowā i ōu rawa,</para>
  <para style="q2" vid="PRO 3:9">i ngā mātāmua anō hoki o āu hua katoa;<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />ā, ka kī āu toa i ngā mea maha,</para>
  <para style="q2" vid="PRO 3:10">ka pakaru anō hoki āu rua wāina i te wāina.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />E tāku tama, kaua e whakahāwea ki tā Ihowā papaki;</para>
  <para style="q2" vid="PRO 3:11">kei ngākaukore anō koe ina ākona e ia.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Ka ākona hoki e Ihowā tāna e aroha ai,</para>
  <para style="q2" vid="PRO 3:12">ka pērā tāna me tā te matua ki te tamaiti</para>
  <para style="q2" vid="PRO 3:12">e matenuitia ana e ia.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="s">Te Rahinga Tūturu</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Ka hari te tangata kua kitea nei e ia te whakaaro nui,</para>
  <para style="q2" vid="PRO 3:13">me te tangata anō kua whiwhi ki te mātauranga,<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />pai atu hoki te hokohoko o tērā i tō te hiriwa e hokohokona nei,</para>
  <para style="q2" vid="PRO 3:14">ōna hua i te kōura parakore.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Nui atu ōna utu i o ngā rupi;</para>
  <para style="q2" vid="PRO 3:15">e kore anō hoki ngā mea katoa e minaminatia e koe e rite ki a ia.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Kei tōna ringa matau ngā rā roa;</para>
  <para style="q2" vid="PRO 3:16">kei tōna mauī ngā taonga me te korōria.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Ko ōna ara he ara āhuareka,</para>
  <para style="q2" vid="PRO 3:17">ko ōna ara katoa he rangimārie.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />He rākau ia nō te ora ki te hunga e ū ana ki a ia;</para>
  <para style="q2" vid="PRO 3:18">ka hari te tangata e pupuri ana i a ia.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="s">Te Pūtakenga Tapu o te Whakaaronui</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Nā te whakaaro nui o Ihowā i whakatūria ai e ia te whenua;</para>
  <para style="q2" vid="PRO 3:19">nā tōna mōhio tāna whakapūmautanga i ngā rangi.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />He mōhio nōna i pakaru ai ngā rire,</para>
  <para style="q2" vid="PRO 3:20">i māturuturu ai te tōmairangi o ngā kapua.<verse eid="PRO 3:20" /></para>
  <para style="s">Te Maru Tūturu</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />E tāku tama, kei kotiti kē ēnā i ōu kanohi:</para>
  <para style="q2" vid="PRO 3:21">puritia te whakaaro nui me te ngārahu pai,<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />kei ēnā he oranga mō tōu wairua,</para>
  <para style="q2" vid="PRO 3:22">he whakapaipai mō tōu kakī.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Pēnei ka haere koe i tōu ara, tē ai he wehi,</para>
  <para style="q2" vid="PRO 3:23">e kore anō tōu waewae e tūtuki.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Ka takoto koe, e kore e wehi,</para>
  <para style="q2" vid="PRO 3:24">inā, ka takoto koe, ka reka anō tāu moe.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Kaua e wehi i te mataku huaki tata,</para>
  <para style="q2" vid="PRO 3:25">i te whakangaromanga rānei o te hunga kino ina pā mai.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Ko Ihowā hoki hei okiokinga mōu,</para>
  <para style="q2" vid="PRO 3:26">ā, māna e tiaki tōu waewae kei mau.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Kaua e kaiponuhia te pai ki te hunga i tika nei mā rātou,</para>
  <para style="q2" vid="PRO 3:27">i ngā wā e taea ai e tōu ringa.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Kaua e mea ki tōu hoa, “Haere, ka hoki mai ai,</para>
  <para style="q2" vid="PRO 3:28">ā, āpōpō ka hoatu e ahau,”</para>
  <para style="q2" vid="PRO 3:28">i te mea kei a koe anō te mea e takoto ana.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Kei whakatakoto i te kino mō tōu hoa,</para>
  <para style="q2" vid="PRO 3:29">kei te noho hū noa nā hoki ia i tōu taha.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Kei ngangau pokanoa ki te tangata,</para>
  <para style="q2" vid="PRO 3:30">ki te mea kāhore āna mahi kino ki a koe.<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Kei hae ki te tangata nanakia,</para>
  <para style="q2" vid="PRO 3:31">kaua hoki e whiriwhiria tētahi o ōna ara.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />He mea whakarihariha hoki te whanokē ki a Ihowā;</para>
  <para style="q2" vid="PRO 3:32">kei te hunga tika ia tōna whakaaro ngaro.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />He kanga nā Ihowā kei roto i te whare o te tangata kino,</para>
  <para style="q2" vid="PRO 3:33">he mea manaaki ia nāna te nohoanga o te hunga tika.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />He pono ka whakahī ia ki te hunga whakahī,</para>
  <para style="q2" vid="PRO 3:34">ka puta ia tōna atawhai ki te hunga whakaiti.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Ka whiwhi te hunga whakaaro nui ki te korōria;</para>
  <para style="q2" vid="PRO 3:35">he whakamā ia te whakanui o ngā wairangi.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">He Tohutohu a-Mātua</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Whakarongo, e āku tamariki, ki te whakaako a te matua,</para>
  <para style="q2" vid="PRO 4:1">tahuri mai hoki kia mātauria ai ngā whakaaro mōhio.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />He pai hoki te kupu mōhio ka hoatu nei e ahau ki a koutou,</para>
  <para style="q2" vid="PRO 4:2">kaua tāku ture e whakarērea.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />He tama anō hoki ahau ki tōku pāpā,</para>
  <para style="q2" vid="PRO 4:3">ā, he ngāwari, he mea kotahi e matenuitia ana e tōku whaea,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />i whakaako anō ia i ahau, i mea ki ahau,</para>
  <para style="q1" vid="PRO 4:4">“Puritia āku kupu e tōu ngākau;</para>
  <para style="q2" vid="PRO 4:4">kia mau ki āku whakahau, ā, e ora koe.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Whāia mōu te whakaaro nui, whāia mōu te mātauranga;</para>
  <para style="q2" vid="PRO 4:5">kaua e wareware ki tērā,</para>
  <para style="q2" vid="PRO 4:5">kaua hoki e neke atu i ngā kupu a tōku māngai.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Kaua ia e whakarērea, ā, māna koe e tiaki;</para>
  <para style="q2" vid="PRO 4:6">arohaina ia, ā, māna koe e mau ai.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Ko te whakaaro nui te tino mea:</para>
  <para style="q2" vid="PRO 4:7">Nō reira whāia mōu te whakaaro nui,</para>
  <para style="q2" vid="PRO 4:7">ā, i ōu whiwhinga katoa, kia whiwhi koe ki te mātauranga.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Whakanuia ia, ā, māna koe ka kake ai;</para>
  <para style="q2" vid="PRO 4:8">ka whakahōnore ia i a koe ki te awhitia e koe.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Ka hōmai e ia he pare ātaahua ki tōu māhunga,</para>
  <para style="q2" vid="PRO 4:9">ka pōtaea anō koe e ia ki te karauna whakapaipai.”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="s">Kia Mau ki te Ara Tika</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Whakarongo, e tāku tama, maharatia āku kupu,</para>
  <para style="q2" vid="PRO 4:10">ā, he maha ngā tau e ora ai koe.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />He mea whakaako koe nāku ki te ara o te whakaaro nui;</para>
  <para style="q2" vid="PRO 4:11">he mea ārahi koe nāku i ngā ara o te tika.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Ka haere koe, e kore ōu takahanga e whakakikītia mai;</para>
  <para style="q2" vid="PRO 4:12">ki te rere koe, e kore koe e tūtuki.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Kia mau ki te ako, kaua e tukua atu;</para>
  <para style="q2" vid="PRO 4:13">matapoporetia iho, ko tōu oranga hoki ia.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Kaua e haere i te ara o te hunga kino,</para>
  <para style="q2" vid="PRO 4:14">kaua hoki e takahia te huarahi o te hunga hē.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Anga kē ake; kaua e tika nā reira;</para>
  <para style="q2" vid="PRO 4:15">peka ake i taua ara, haere tonu atu.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />E kore hoki rātou e moe ki te kore e oti tētahi mahi hē mā rātou;</para>
  <para style="q2" vid="PRO 4:16">riro rawa tō rātou moe, ki te kāhore tētahi tangata e hinga i a rātou.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Nō te kino hoki te taro e kainga ana e rātou,</para>
  <para style="q2" vid="PRO 4:17">nō te nanakia te wāina e inumia ana e rātou.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Ko te huarahi ia o te hunga tika, koia anō kei te mārama e whiti ana,</para>
  <para style="q2" vid="PRO 4:18">ā, ka neke haere tonu ake tōna mārama, ā taea noatia te tino rā.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Ko te ara o te hunga kino, me he pōuri,</para>
  <para style="q2" vid="PRO 4:19">e kore rātou e mōhio ki te mea i tūtuki ai rātou.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />E tāku tama, tahuri ki āku kupu;</para>
  <para style="q2" vid="PRO 4:20">anga mai tōu taringa ki āku kōrero.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Kei kotiti kē ēnei i ōu kanohi;</para>
  <para style="q2" vid="PRO 4:21">puritia i waenganui o tōu ngākau.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />He oranga ēnei mō te hunga e kitea ai,</para>
  <para style="q2" vid="PRO 4:22">he rongoā mō ō rātou kikokiko katoa.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Kia pau ōu mahara ki te tiaki i tōu ngākau,</para>
  <para style="q2" vid="PRO 4:23">nō reira hoki ngā putanga o te ora.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Whakarērea te māngai whanokē,</para>
  <para style="q2" vid="PRO 4:24">kia matara rawa i a koe ngā ngutu tutū.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Kia hāngai tonu te titiro whakamua a ōu kanohi,</para>
  <para style="q2" vid="PRO 4:25">kia titiro ōu kamo ki mua tonu i a koe.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Whakatikaia te huarahi o ōu waewae,</para>
  <para style="q2" vid="PRO 4:26">kia ū anō hoki ōu ara katoa.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Kaua e peka ki matau, ki mauī;</para>
  <para style="q2" vid="PRO 4:27">kia anga kē tōu waewae i te kino.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">He Whakatūpato kei Pūremu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />E tāku tama, tahuri ki ōku whakaaro nui;</para>
  <para style="q2" vid="PRO 5:1">kia anga tōu taringa ki tōku mātauranga,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />kia ū ai koe ki te ngārahu pai,</para>
  <para style="q2" vid="PRO 5:2">mau ai te mātauranga i ōu ngutu.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Ko ngā ngutu hoki o te wahine kē, kei te māturuturunga iho o te honikoma,</para>
  <para style="q2" vid="PRO 5:3">ngāwari iho tōna māngai i te hinu;<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />he kawa rawa hoki tōna mutunga i te taru kawa,</para>
  <para style="q2" vid="PRO 5:4">he koi, ānō he hoari matarua.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Ko ōna waewae e heke ana ki te mate;</para>
  <para style="q2" vid="PRO 5:5">mau pū te rēinga i ōna takahanga.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Heoi, kāhore i kitea e ia te ara tōtika ki te ora;</para>
  <para style="q2" vid="PRO 5:6">he kotiti kē ōna ara, ā, kāhore ia i tē mātau.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Nā reira, e āku tamariki, whakarongo mai ki ahau,</para>
  <para style="q2" vid="PRO 5:7">kei mahue hoki ngā kupu a tōku māngai.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Kia matara tōu ara i a ia,</para>
  <para style="q2" vid="PRO 5:8">kaua hoki e tata ki te tatau o tōna whare;<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />kei hoatu tōu hōnore ki ngā tāngata kē,</para>
  <para style="q2" vid="PRO 5:9">ōu tau ki te hunga nanakia.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Kei mākona ngā tāngata kē i tōu kaha,</para>
  <para style="q2" vid="PRO 5:10">kei riro ōu māuiui ki te whare o te tangata kē;<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />ā, ka tangi koe i tōu whakamutunga,</para>
  <para style="q2" vid="PRO 5:11">ina poto ōu kikokiko me tōu tinana,<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />ā, ka mea, “Kātae tōku kino ki te ako;</para>
  <para style="q2" vid="PRO 5:12">kātae te māuiui o tōku ngākau ki te tohutohu!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Kīhai hoki ahau i whakarongo ki te reo o ōku kaiwhakaako,</para>
  <para style="q2" vid="PRO 5:13">kīhai tōku taringa i anga ki te hunga e tohutohu ana i ahau.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Wāhi iti kei ngā kino katoa ahau</para>
  <para style="q2" vid="PRO 5:14">i waenganui o te whakaminenga, o te huihui.”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Inumia he wai i roto i tāu ake rua,</para>
  <para style="q2" vid="PRO 5:15">me ngā wai rere anō i roto i tāu ake poka.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Kia tohatoha noa atu koia āu puna wai,</para>
  <para style="q2" vid="PRO 5:16">ngā awa wai i ngā huarahi?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Waiho ēnā māu anake,</para>
  <para style="q2" vid="PRO 5:17">kauaka mā koutou tahi ko ngā tāngata kē.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Kia manaakitia tāu puna wai;</para>
  <para style="q2" vid="PRO 5:18">kia koa anō koe ki te wahine o tōu taitamarikitanga.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Kia rite ia ki taua mea āhuareka, ki te hāta,</para>
  <para style="q2" vid="PRO 5:19">ki te mea ātaahua ki te anaterope.</para>
  <para style="q1" vid="PRO 5:19">Kia mākona koe i ōna ū i ngā wā katoa,</para>
  <para style="q2" vid="PRO 5:19">kia matenuitia tonutia e koe tōna aroha.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />He aha oti koe, e tāku tama, ka matenui ai ki te wahine kē,</para>
  <para style="q2" vid="PRO 5:20">i awhi ai i te uma o te wahine kē?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Kei mua hoki i ngā kanohi o Ihowā ngā ara o te tangata,</para>
  <para style="q2" vid="PRO 5:21">ā, e meinga ana e ia kia papatairite ōna ara katoa.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Ko ōna kino anō hei hopu i te tangata kino,</para>
  <para style="q2" vid="PRO 5:22">hei taura ōna hara e mau ai ia.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Ka mate ia, he mea kīhai i whakaakona,</para>
  <para style="q2" vid="PRO 5:23">ka pōhēhē i te nui o tōna wairangi.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">He Whakatūpato Anō</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />E tāku tama, ki te mea ko tāu hei whakakapi mō tā tōu hoa,</para>
  <para style="q2" vid="PRO 6:1">ki te mea kua papaki tōu ringa mō te tangata kē,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />kua oti koe te māhanga e ngā kupu a tōu māngai,</para>
  <para style="q2" vid="PRO 6:2">kua mau koe i ngā kupu a tōu māngai.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Meinga tēnei ināianei, e tāku tama, kia ora ai koe,</para>
  <para style="q2" vid="PRO 6:3">he mea hoki kua taka koe ki roto ki te ringa o tōu hoa:</para>
  <para style="q2" vid="PRO 6:3">haere, whakaiti i a koe, ā, ka tohe ki tōu hoa.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Kei tukua iho te moe ki ōu kanohi;</para>
  <para style="q2" vid="PRO 6:4">kei tunewha ōu kamo.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Whakaora i a koe ānō he anaterope i roto i te ringa o te kaiwhai,</para>
  <para style="q2" vid="PRO 6:5">ānō he manu i roto i te ringa o te kaihopu.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Haere ki te pōpokorua, e te tangata māngere,</para>
  <para style="q2" vid="PRO 6:6">mātakitakina iho ōna ara, kia nui ai ōu whakaaro.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Kāhore nei ōna kaitohutohu,</para>
  <para style="q2" vid="PRO 6:7">ōna kaitirotiro, ōna rangatira,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />heoi, e mahi kai ana māna i te raumati,</para>
  <para style="q2" vid="PRO 6:8">e kohikohi ana i te kai māna i te kotinga wīti.<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Kia pēhea ake te roa o tāu takoto, e te tangata māngere?</para>
  <para style="q2" vid="PRO 6:9">Āhea koe maranga ai i tāu moe?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Kia iti ake nei te wāhi e parangia ai, kia iti ake nei te moe,</para>
  <para style="q2" vid="PRO 6:10">kia iti ake te kōtuinga o ngā ringa i a koe e takoto nā;<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />nā, ka rite ki te kaipāhua te putanga mai o te mūhore ki a koe,</para>
  <para style="q2" vid="PRO 6:11">tōu rawakore, ānō he tangata he patu nei tāna.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Ko te tangata kāhore ōna painga, ko te tangata hara,</para>
  <para style="q2" vid="PRO 6:12">e hāereere ana me te māngai tū kē;<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />e whakakini ana ōna kanohi, e kōrero ana ōna waewae,</para>
  <para style="q2" vid="PRO 6:13">e tuhi ana ōna maihao;<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />kei roto te whanokē i tōna ngākau,</para>
  <para style="q2" vid="PRO 6:14">e whakatakoto ana ia i te kino i ngā wā katoa;</para>
  <para style="q2" vid="PRO 6:14">e rui ana ia i te ngangare.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Mō reira ka huaki tata te aituā ki a ia;</para>
  <para style="q2" vid="PRO 6:15">e kore e aha ka whatia ia, tē taea te rongoā.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />E ono ngā mea e kino ana ki a Ihowā;</para>
  <para style="q2" vid="PRO 6:16">āe rā, e whitu ngā mea e whakariharihangia ana e ia:<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />ko te kanohi whakakake, ko te arero teka,</para>
  <para style="q2" vid="PRO 6:17">ko ngā ringa whakaheke i te toto harakore,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />he ngākau e whakatakoto ana i ngā whakaaro kikino,</para>
  <para style="q2" vid="PRO 6:18">he waewae e hohoro ana te rere ki te hīanga,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />he kaiwhakaatu teka e kōrero teka ana,</para>
  <para style="q2" vid="PRO 6:19">ko te tangata hoki e rui ana i te ngangare</para>
  <para style="q2" vid="PRO 6:19">ki waenganui i ngā tuākana, i ngā tēina.<verse eid="PRO 6:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />E tāku tama, puritia te whakahau a tōu pāpā,</para>
  <para style="q2" vid="PRO 6:20">kaua hoki e whakarērea te ture a tōu whaea.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Kia mau tonu te tākai ki tōu ngākau,</para>
  <para style="q2" vid="PRO 6:21">heia ki tōu kakī.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Ko tōu kaiārahi anō tērā ina haere koe;</para>
  <para style="q2" vid="PRO 6:22">māna koe e tiaki ina takoto koe;</para>
  <para style="q2" vid="PRO 6:22">ka kōrero mai anō ki a koe, ina ara koe.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />He rama hoki te whakahau, ā, he mārama te ture;</para>
  <para style="q2" vid="PRO 6:23">ko ngā riringa hoki, e whakaako ana, he ara ki te ora.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Hei tiaki i a koe kei hē i te wahine kino,</para>
  <para style="q2" vid="PRO 6:24">i te whakapati a te arero o te wahine kē.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Kei hiahia koe ki tōna ātaahua i roto i tōu ngākau;</para>
  <para style="q2" vid="PRO 6:25">kei mau anō koe i ōna kamo.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Ko te tukunga iho o te tangata he wāhi taro, he mea mō te wahine kairau;</para>
  <para style="q2" vid="PRO 6:26">ko tā te wahine pūremu e whai ana ko te wairua utu nui.<verse eid="PRO 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />E taea rānei e te tangata te tango i te ahi ki roto ki tōna uma,</para>
  <para style="q2" vid="PRO 6:27">ā, e kore ōna kākahu e wera?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />E taea rānei e tētahi te haere i runga i ngā waro ratarata,</para>
  <para style="q2" vid="PRO 6:28">ā, e kore ōna waewae e hunua?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Ka pērā anō te tangata e haere ana ki te wahine a tōna hoa;</para>
  <para style="q2" vid="PRO 6:29">e kore e kore ka whiua te tangata e pā ana ki a ia.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />E kore e whakahāweatia e te tangata te tāhae,</para>
  <para style="q2" vid="PRO 6:30">ki te tāhaetia e ia he mea e mākona ai tōna wairua ina hiakai ia.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Otiia ki te kitea ia, kia takiwhitu āna e whakautu ai;</para>
  <para style="q2" vid="PRO 6:31">me hōmai e ia ngā rawa katoa o tōna whare.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Ko te tangata e pūremu ana ki te wahine, kāhore ōna mōhio;</para>
  <para style="q2" vid="PRO 6:32">ko te tangata e pērā ana, kei te whakangaro ia i tōna wairua.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />He kaiākiko, he whakamā te wāhi mōna;</para>
  <para style="q2" vid="PRO 6:33">e kore anō tōna ingoa kino e horoia atu.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />He riri nui hoki nā te tangata te hae;</para>
  <para style="q2" vid="PRO 6:34">e kore anō e tohungia e ia i te rā rapu utu.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />E kore ia e manako ki tētahi utu;</para>
  <para style="q2" vid="PRO 6:35">e kore hoki e tatū tōna ngākau, ahakoa he nui āu hākari e tāpae ai.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s">Ngā Maneatanga Hē o te Pūremu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />E tāku tama, puritia āku kupu,</para>
  <para style="q2" vid="PRO 7:1">hunā āku whakahau ki roto ki a koe.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Puritia āku whakahau, ā, ka ora;</para>
  <para style="q2" vid="PRO 7:2">tāku ture, ānō ko te whatupango o tōu kanohi.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Herea ki ōu maihao;</para>
  <para style="q2" vid="PRO 7:3">tuhituhia, ko tōu ngākau ānō hei papa.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Kī atu ki te whakaaro nui, “He tuahine koe nōku,”</para>
  <para style="q2" vid="PRO 7:4">kīia hoki te mātauranga ko tōu whanaunga wahine.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Kia ai ēnei hei tiaki i a koe kei hē i te wahine kē,</para>
  <para style="q2" vid="PRO 7:5">i te wahine kē, he kōrero whakapati nei āna.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />I titiro atu hoki ahau i te matapihi o tōku whare</para>
  <para style="q2" vid="PRO 7:6">i roto i tōku whakakahokaho,<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />ā, i mātakitaki ahau i roto i ngā kūware,</para>
  <para style="q2" vid="PRO 7:7">i kite i roto i ngā taitama,</para>
  <para style="q2" vid="PRO 7:7">i tētahi tamaiti kāhore rawa he whakaaro,<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />e haere ana i te ara i te wāhi tata e piko atu ai ki a ia,</para>
  <para style="q2" vid="PRO 7:8">ā, haere ana ia i te ara ki tōna whare,<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />i te kākarauritanga, i te ahiahi o te rā,</para>
  <para style="q2" vid="PRO 7:9">i te titiwhatanga o te pō, i te pōuri kerekere.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Nā, kua tūtaki tētahi wahine ki a ia,</para>
  <para style="q2" vid="PRO 7:10">he kākahu pūremu tōna, he ngākau hīanga.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />He māngai korokī tōna, he tohetohe;</para>
  <para style="q2" vid="PRO 7:11">ko ōna waewae, kāhore e tau ki tōna whare;<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />ināianei kei ngā ara ia, inamata kei ngā waharoa,</para>
  <para style="q2" vid="PRO 7:12">e tauwhanga ana i ngā kokinga katoa.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Koia i hopukia ai ia e ia, kei te kihi i a ia,</para>
  <para style="q2" vid="PRO 7:13">ā, ka mea atu ki a ia, me te whakatoi anō i tōna mata:<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“He patunga mō te pai kei ahau;</para>
  <para style="q2" vid="PRO 7:14">nō tēnei rā nei ahau i whakamana ai i āku kupu taurangi;<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />koia ahau i haere mai ai ki te whakatau i a koe,</para>
  <para style="q2" vid="PRO 7:15">ki te āta rapu i tōu mata, ā, ka kitea nei koe e ahau.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Ko tōku moenga kua horahia e ahau,</para>
  <para style="q2" vid="PRO 7:16">whakapaipai rawa ki te kaitaka,</para>
  <para style="q2" vid="PRO 7:16">ki ngā kākahu purepure nō te rīnena o Īhipa.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Kua ruia e ahau tōku moenga ki ngā mea whakakakara,</para>
  <para style="q2" vid="PRO 7:17">ki te maira, ki te aroe, ki te hinamona.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Haere mai, kia whaowhina tāua ki te aroha, ā ao noa;</para>
  <para style="q2" vid="PRO 7:18">kia ora ō tāua ngākau i te aroha.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Kāhore hoki tāku tāne i te whare;</para>
  <para style="q2" vid="PRO 7:19">kua riro ia, he haere tawhiti.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />I maua atu e ia he pūtea moni i tōna ringa;</para>
  <para style="q2" vid="PRO 7:20">ka hoki mai anō ia i te kōwhititanga o te marama.”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />He maha nō āna kōrero whakawai, riro ana ia i a ia ki tāna;</para>
  <para style="q2" vid="PRO 7:21">nā te whakapati a ōna ngutu ka kūmea atu ia e ia.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Haere tonu ia i muri i a ia,</para>
  <para style="q2" vid="PRO 7:22">ānō he kau e haere ana kia patua,</para>
  <para style="q1" vid="PRO 7:22">he kūware rānei e haere ana ki ngā rākau here waewae e whiua ai te hē,<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />ā, tū noa te tao ki tōna ate puta rawa.</para>
  <para style="q1" vid="PRO 7:23">Rite tonu ia ki te manu e hohoro ana ki te māhanga,</para>
  <para style="q2" vid="PRO 7:23">tē mōhio he matenga tērā mōna.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Nō reira, e āku tamariki, whakarongo ki ahau,</para>
  <para style="q2" vid="PRO 7:24">maharatia ngā kupu a tōku māngai.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Kei peau kē tōu ngākau ki ōna ara,</para>
  <para style="q2" vid="PRO 7:25">kei kotiti kē ki ōna huarahi.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />He tokomaha hoki ngā tāngata i tū, i hinga i a ia,</para>
  <para style="q2" vid="PRO 7:26">āe rā, he ope nui rawa tāna i patu ai.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />He huarahi tōna whare ki te rēinga,</para>
  <para style="q2" vid="PRO 7:27">e anga ana ki raro ki ngā rūma o te mate.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">Te Karanga o te Whakaaronui</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />He teka ianei kei te karanga te whakaaro nui,</para>
  <para style="q2" vid="PRO 8:1">e puaki ana anō te reo o te mātauranga?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />I runga i ngā wāhi tiketike tōna tūranga,</para>
  <para style="q2" vid="PRO 8:2">i te ara i te tūtakitanga o ngā huarahi;<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />hāmama ana ia i te taha o ngā kūwaha,</para>
  <para style="q2" vid="PRO 8:3">i te ngutu o te pā, i te tomokanga atu i ngā tatau:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“Ki a koutou, e ngā tāngata, tāku karanga;</para>
  <para style="q2" vid="PRO 8:4">ki ngā tama anō a te tangata tōku reo.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />E ngā kūware, kia mātau koutou ki te ngārahu tūpato;</para>
  <para style="q2" vid="PRO 8:5">e ngā wairangi, kia mōhio te ngākau.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Whakarongo mai, ka kōrerotia hoki e ahau ngā mea pai rawa;</para>
  <para style="q2" vid="PRO 8:6">ko tā ōku ngutu e whakapuaki ai ko ngā mea e rite ana.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />He pono hoki te kōrero a tōku māngai;</para>
  <para style="q2" vid="PRO 8:7">he mea whakarihariha anō te kino ki ōku ngutu.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Kei runga i te tika ngā kupu katoa a tōku māngai;</para>
  <para style="q2" vid="PRO 8:8">kāhore he whakapeka, he whanokē rānei, i roto.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Ko ēnei katoa he mārama ki te tangata e mātau ana,</para>
  <para style="q2" vid="PRO 8:9">he tika ki te hunga i kitea ai te mōhio.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Manakohia mai tāku ako, kaua te hiriwa;</para>
  <para style="q2" vid="PRO 8:10">ko te mātauranga, nui atu i te kōura pai rawa.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Pai atu hoki te whakaaro nui i ngā rupi;</para>
  <para style="q2" vid="PRO 8:11">e kore hoki ngā mea katoa e minaminatia nei e tau hei whakarite mōna.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />“Kua meinga e ahau, e te whakaaro nui, ko te ngārahu pai hei nohoanga mōku,</para>
  <para style="q2" vid="PRO 8:12">e kitea ana e ahau te mōhio me te āta whakaaro.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Ko te wehi ki a Ihowā koia tēnā ko te kino ki te hē.</para>
  <para style="q1" vid="PRO 8:13">E kino ana ahau ki te whakapehapeha, ki te whakakake,</para>
  <para style="q2" vid="PRO 8:13">ki te ara hē, ki te māngai whanokē.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Ko te whakaaro tika, ko te whakaaro nui, nāku;</para>
  <para style="q2" vid="PRO 8:14">ko ahau te mātauranga, kei ahau te kaha.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Nāku ngā kīngi i kīngi ai,</para>
  <para style="q2" vid="PRO 8:15">nāku ngā rangatira i whakatakoto ai i te tika.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Nāku i whai rangatiratanga ai ngā rangatira,</para>
  <para style="q2" vid="PRO 8:16">ngā tāngata nunui, arā ngā kaiwhakawā katoa o te whenua.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />E arohaina ana e ahau te hunga e aroha ana ki ahau;</para>
  <para style="q2" vid="PRO 8:17">ko te hunga hoki e āta rapu ana i ahau, e kite rātou i ahau.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />He taonga, he korōria kei ahau,</para>
  <para style="q2" vid="PRO 8:18">āe rā, he rawa mau tonu, he tika.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Pai atu ōku hua i te kōura, āe rā, i te kōura parakore;</para>
  <para style="q2" vid="PRO 8:19">ko ngā mea e puta ana i ahau, pai atu i te hiriwa kōwhiri.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Kei ngā ara o te tika ahau e haere ana,</para>
  <para style="q2" vid="PRO 8:20">kei waenganui i ngā huarahi o te whakawā;<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />kia meinga ai e ahau te hunga e aroha ana ki ahau kia whiwhi ki te rawa,</para>
  <para style="q2" vid="PRO 8:21">kia whakakīia ai e ahau ā rātou takotoranga taonga.”<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="s">Te Pūtakenga mai o te Whakaaronui</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />“I a Ihowā ahau, nō te tīmatanga rā anō o ōna ara,</para>
  <para style="q2" vid="PRO 8:22">nō mua atu i āna mahi o neherā.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Nōnamata riro ahau i whakaritea ai,</para>
  <para style="q2" vid="PRO 8:23">nō te tīmatanga, nō mua atu i te whenua.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />I te mea kāhore anō ngā rire, kua whānau ahau;</para>
  <para style="q2" vid="PRO 8:24">i te mea kīanō he puna whai wai.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Nō mua atu i te whakaūnga o ngā maunga,</para>
  <para style="q2" vid="PRO 8:25">nō mua i ngā pukepuke tōku whānautanga;<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />i te mea kāhore anō i hangā noatia e ia te whenua, me ngā pārae,</para>
  <para style="q2" vid="PRO 8:26">me te tīmatanga o te puehu o te ao.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />I tāna whakatūranga i ngā rangi, i reira anō ahau;</para>
  <para style="q2" vid="PRO 8:27">i tāna whakaritenga i te awhi mō te mata o te rire;<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />i tāna whakapūmautanga i ngā rangi i runga;</para>
  <para style="q2" vid="PRO 8:28">i te totōtanga o ngā puna o te rire;<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />i tāna rohenga mai i te moana,</para>
  <para style="q2" vid="PRO 8:29">kei takahia tāna kupu e ngā wai;</para>
  <para style="q1" vid="PRO 8:29">i tāna waitohutanga i ngā tūranga o te whenua,<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />i reira ahau i tōna taha, he tohunga ki ngā mahi;</para>
  <para style="q1" vid="PRO 8:30">he ahau nōna i ia rā, i ia rā,</para>
  <para style="q2" vid="PRO 8:30">e koa ana i ngā wā katoa i tōna aroaro;<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />e koa ana ki tāna ao,</para>
  <para style="q2" vid="PRO 8:31">ā, ko tāku i āhuareka ai ko ngā tama a te tangata.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />“Nō reira, e āku tamariki, whakarongo mai ki ahau;</para>
  <para style="q2" vid="PRO 8:32">ka hari hoki te hunga e pupuri ana i ōku ara.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Whakarongo mai ki te ako, kia whai whakaaro ai koutou;</para>
  <para style="q2" vid="PRO 8:33">kaua hoki e paopaongia.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Ka hari te tangata e whakarongo ana ki ahau,</para>
  <para style="q2" vid="PRO 8:34">e tatari ana i ōku tatau i tēnei rā, i tēnei rā,</para>
  <para style="q2" vid="PRO 8:34">e whanga ana i ngā pou o ōku kūwaha.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Ko te tangata hoki e kite ana i ahau, e kite ana i te ora,</para>
  <para style="q2" vid="PRO 8:35">ka whiwhi anō ia ki tā Ihowā manako mai.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Ko te tangata ia e hara ana ki ahau, he mahi nanakia tāna ki tōna wairua ake;</para>
  <para style="q2" vid="PRO 8:36">ko te hunga katoa e kino ana ki ahau, e aroha ana ki te mate.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">Te Tono a Wahine Whakaaronui</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Kua oti i te whakaaro nui tētahi whare mōna te hanga,</para>
  <para style="q2" vid="PRO 9:1">e whitu ngā pou kua oti te tārai e ia.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Kua oti āna kararehe te patu e ia, whakananu rawa tāna wāina;</para>
  <para style="q2" vid="PRO 9:2">kua oti anō tāna tēpu te whakapai.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Kua ungā e ia āna kōtiro, e karanga ana ia</para>
  <para style="q2" vid="PRO 9:3">i runga i ngā wāhi tiketike rawa o te pā.<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />“Ki te mea he kūware tētahi, me peka mai ia ki konei!”</para>
  <para style="q2" vid="PRO 9:4">Ko te tangata maharakore, ko tāna kupu tēnei ki a ia,<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />“Haere mai, kainga tāku taro,</para>
  <para style="q2" vid="PRO 9:5">inumia hoki te wāina kua oti nei te whakananu e ahau.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Kāti rā, e te hunga kūware, kia ora ai koutou;</para>
  <para style="q2" vid="PRO 9:6">haere hoki i te ara o te mātauranga.”<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="s">Te Tangata Whakaaronui me te Tangata Whakahīhī</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Ko ia e papaki ana i te tangata whakahīhī, ka whakamā;</para>
  <para style="q2" vid="PRO 9:7">ā, ko ia e riri ana i te tangata kino, ka piri mai he hē ki a ia.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Kaua e rīria te tangata whakahī, kei kino ia ki a koe;</para>
  <para style="q2" vid="PRO 9:8">rīria ko te tangata whakaaro nui, ā, ka aroha ia ki a koe.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Hoatu te mōhio ki te tangata whakaaro nui, ā, ka neke ake ōna whakaaro;</para>
  <para style="q2" vid="PRO 9:9">whakaakona te tangata tika, ā, ka nui ake tōna mōhio.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Ko te tīmatanga o te whakaaro nui ko te wehi ki a Ihowā;</para>
  <para style="q2" vid="PRO 9:10">ko te mātauranga, ko te mōhio ki te Mea Tapu.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Māku hoki ka maha ai ōu rā,</para>
  <para style="q2" vid="PRO 9:11">māku ka neke ake ai ngā tau e ora ai koe.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Ki te nui ōu whakaaro, mōu anō ōu whakaaro nui;</para>
  <para style="q2" vid="PRO 9:12">ki te whakahī koe, māu anake tāu pīkaunga.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="s">He Tono a Wahine Kūware</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Ko te wahine wairangi, he māngai nui ia;</para>
  <para style="q2" vid="PRO 9:13">he kūware ia, kāhore ōna mōhio ki te aha, ki te aha.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Noho ana ia i te kūwaha o tōna whare</para>
  <para style="q2" vid="PRO 9:14">i runga i te nohoanga i ngā wāhi tiketike o te pā;<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />kia karanga atu ai ia ki ngā tāngata e haere ana i te ara,</para>
  <para style="q2" vid="PRO 9:15">e mārō tonu ana ō rātou huarahi,<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />“Ko te kūware, peka mai ki konei!”</para>
  <para style="q2" vid="PRO 9:16">Tēnā ko te tangata whakaarokore,</para>
  <para style="q2" vid="PRO 9:16">ko tāna kupu tēnei ki a ia,<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />“He reka te wai tāhae,</para>
  <para style="q2" vid="PRO 9:17">ā, he āhuareka te taro kai huna.”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Tē mōhio ia kei reira ngā tūpāpaku;</para>
  <para style="q2" vid="PRO 9:18">kei te rēinga riro ana i karanga ai.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">Te Kohinga Tuatahi a ngā Whakatauki a Horomona</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Ko ngā whakatauki a Horomona.</para>
  <para style="b" vid="PRO 10:1" />
  <para style="q1" vid="PRO 10:1">He tama whakaaro nui, ka koa te pāpā;</para>
  <para style="q2" vid="PRO 10:1">tēnā he tama kūware, he utanga nui mō tōna whaea.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Kāhore he rawa o ngā taonga o te kino;</para>
  <para style="q2" vid="PRO 10:2">mā te tika ia te oranga ake i te mate.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />E kore a Ihowā e tuku i te wairua o te tangata tika kia hemokai;</para>
  <para style="q2" vid="PRO 10:3">ka panā atu ia e ia te hiahia o te hunga kino.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />He rawakore te tukunga iho o te ringa ngehe;</para>
  <para style="q2" vid="PRO 10:4">mā te ringa kakama ia ka hua te taonga.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />He kohi raumati tā tama ngākau mahara;</para>
  <para style="q2" vid="PRO 10:5">he whakamā ia te rawa a tama moe ngahuru.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />He manaaki kei te tumuaki o te tangata tika;</para>
  <para style="q2" vid="PRO 10:6">he ārita ia kei te waha o te tangata kino, taupoki ai.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Ka manaakitia te maharatanga ki te tangata tika;</para>
  <para style="q2" vid="PRO 10:7">ka pirau ia te ingoa o te hunga kino.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />He ngākau whakaaro, ka tahuritia te whakahau;</para>
  <para style="q2" vid="PRO 10:8">he ngutu wairangi, ka hinga.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Ko te tangata haere tika, e haere ora ana;</para>
  <para style="q2" vid="PRO 10:9">ko te tangata parori kē ōna ara, ka mōhiotia ia.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Mā te whakakini o te kanohi ka puta ai te pōuri;</para>
  <para style="q2" vid="PRO 10:10">ko te ngutu wairangi ia, ka hinga.<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />He puna ora te māngai o te tangata tika;</para>
  <para style="q2" vid="PRO 10:11">tēnā ko te māngai o te hunga kino,</para>
  <para style="q2" vid="PRO 10:11">ka taupokina tērā e te mahi nanakia.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Ko tō te mauāhara he whakaoho i ngā totohe;</para>
  <para style="q2" vid="PRO 10:12">ko tō te aroha he hīpoki i ngā hē katoa.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />E kitea te whakaaro nui ki ngā ngutu o te tangata mātau;</para>
  <para style="q2" vid="PRO 10:13">ko te rākau ia te mea mō te tuarā o te ngākaukore.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Rongoā ai te hunga whakaaro nui i te mātauranga;</para>
  <para style="q2" vid="PRO 10:14">he whakangaromanga ia kei te hori tonu, te māngai o te wairangi.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Ko ōna rawa te pā kaha o te tangata taonga;</para>
  <para style="q2" vid="PRO 10:15">tēnā ko te hunga kore taonga, hei whakangaromanga tō rātou rawakore.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Ko te mahi a te tangata tika e ahu ana ki te ora;</para>
  <para style="q2" vid="PRO 10:16">ko ngā hua o te kino ki te hara.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Kei te ara ki te ora te tangata e pupuri ana i te kupu ako;</para>
  <para style="q2" vid="PRO 10:17">ko te tangata ia e kore e pai kia rīria tōna hē, ka kotiti kē.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Ko te tangata e huna ana i te mauāhara he ngutu teka;</para>
  <para style="q2" vid="PRO 10:18">ā, he kūware te tangata e whakapuaki ana i te ngautuarā.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />E kore ngā kupu maha e hapa i te kino;</para>
  <para style="q2" vid="PRO 10:19">he mahara nui ia te tangata he ngutu kokopi nei ōna.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />He hiriwa pai rawa te arero o te tangata tika;</para>
  <para style="q2" vid="PRO 10:20">ko te ngākau o te hunga kino, he hauwarea rawa.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />He tokomaha e whāngaia ana e ngā ngutu o te tangata tika;</para>
  <para style="q2" vid="PRO 10:21">ka mate ia te hunga kūware, he kore nō te ngākau mahara.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Ka hua te taonga i tā Ihowā manaaki;</para>
  <para style="q2" vid="PRO 10:22">kāhore hoki e kīnakitia e ia ki te pōuri.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Hei tākaro mā te wairangi te mahi hē;</para>
  <para style="q2" vid="PRO 10:23">mā te tangata mātau ia ko te whakaaro nui.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Ko tā te tangata kino i wehi ai ka tae anō ki a ia;</para>
  <para style="q2" vid="PRO 10:24">ā, ko tā te hunga tika i hiahia ai, ka hōmai.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Pahure rawa ake te tūkauati kua kore te hunga kino;</para>
  <para style="q2" vid="PRO 10:25">tēnā ko te tangata tika he tūranga pūmau tērā.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />He winika ki ngā niho, he paowa ki ngā kanohi;</para>
  <para style="q2" vid="PRO 10:26">koia anō te māngere ki ōna kaiunga.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Ko te wehi ki a Ihowā e whakaroa ana i ngā rā;</para>
  <para style="q2" vid="PRO 10:27">ka whakapotoa mai ia ngā tau o te hunga kino.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Tūmanako atu te hunga tika, koa iho;</para>
  <para style="q2" vid="PRO 10:28">tūmanako atu te hunga kino, ngaro iho.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />He kaha mō te tangata tika tā Ihowā ara;</para>
  <para style="q2" vid="PRO 10:29">he whakangaromanga ia mō ngā kaimahi i te kino.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />E kore te tangata tika e whakangāueuetia ā ake ake;</para>
  <para style="q2" vid="PRO 10:30">e kore ia e nohoia e te hunga kino te whenua.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Ko te māngai o te tangata tika hua ana te whakaaro nui;</para>
  <para style="q2" vid="PRO 10:31">ka tapahia ia te arero whanokē.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />E mōhio ana ngā ngutu o te tangata tika ki ngā mea ka manakohia;</para>
  <para style="q2" vid="PRO 10:32">he whanokē ia e whakapuakina ana e te māngai o te hunga kino.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />He mea whakarihariha ki a Ihowā te pāuna hē;</para>
  <para style="q2" vid="PRO 11:1">engari te taimaha tika tāna i pai ai.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Ka tae te whakapehapeha, ka tae anō te whakamā;</para>
  <para style="q2" vid="PRO 11:2">kei te hunga whakaiti ia te whakaaro nui.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Ko tō rātou ngākau tapatahi hei ārahi i te hunga tika;</para>
  <para style="q2" vid="PRO 11:3">ka ai anō ko te whanokē ia o te hunga poka kē hei whakangaro mō rātou.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />E kore te taonga e whai mana i te rā o te riri;</para>
  <para style="q2" vid="PRO 11:4">kei te tika ia he oranga ake i te mate.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Mā te tika o te ngākau tapatahi ka tika ai tōna ara;</para>
  <para style="q2" vid="PRO 11:5">ka hinga ia te tangata kino i runga i tōna kino.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Mā te tika o te hunga tika ka mawhiti ai rātou;</para>
  <para style="q2" vid="PRO 11:6">ka mau ia ngā poka kē i runga i tō rātou kino.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />I te matenga o te tangata kino, kore iho āna mea i tūmanako atu ai;</para>
  <para style="q2" vid="PRO 11:7">kāhore noa iho he tūmanakohanga mā te hunga hē.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Ka mawhiti te tangata tika i roto i te raru,</para>
  <para style="q2" vid="PRO 11:8">ā, ka riro te tangata kino hei whakakapi mō tōna tūranga.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Hei huna mō tōna hoa te māngai o te tangata whakapono kore;</para>
  <para style="q2" vid="PRO 11:9">nā, mā te mōhio te hunga tika ka mawhiti ai.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Ka pai te hunga tika, ka hari te pā;</para>
  <para style="q2" vid="PRO 11:10">ka whakangaromia te hunga kino, ka tangi te umere.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Mā te manaaki o te hunga tika ka kake ai te pā;</para>
  <para style="q2" vid="PRO 11:11">ka pakaru ia i te māngai o te hunga kino.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Ko te tangata e whakahāwea ana ki tōna hoa he maharakore;</para>
  <para style="q2" vid="PRO 11:12">tēnā ko te tangata mātau, whakarongo puku ana.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Ko te tangata haere, ka kawekawe kōrero e whāki ana i ngā mea ngaro;</para>
  <para style="q2" vid="PRO 11:13">ko te tangata i te wairua pono, e hīpoki ana i te kōrero.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Ki te kāhore he mōhio hei ārahi, ka hinga te iwi;</para>
  <para style="q2" vid="PRO 11:14">he ora ia kei ngā kaiwhakatakoto whakaaro tokomaha.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Ko te tangata ko tāna nei hei whakakapi mō tā te tangata kē, ka mamae;</para>
  <para style="q2" vid="PRO 11:15">kei te ora ia te tangata e kino ana ki te tikanga whakakapi tūranga.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Ka mau te korōria i te wahine tikanga pai;</para>
  <para style="q2" vid="PRO 11:16">ka mau hoki te taonga i ngā tāngata taikaha.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />He atawhai i tōna wairua tā te tangata atawhai;</para>
  <para style="q2" vid="PRO 11:17">ā, he whakararu i ōna kikokiko tā te tangata nanakia.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Ko te mahi a te tangata kino e utua ana ki te teka;</para>
  <para style="q2" vid="PRO 11:18">ko te utu ia mō te kaiwhakatakoto i te tika, ū rawa.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Ko te tangata ū ki te tika, ka whiwhi ki te ora;</para>
  <para style="q2" vid="PRO 11:19">ā, ko te tangata e whai ana i te kino e mea ana i te mate mōna.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Ko tā Ihowā e whakarihariha ai he ngākau whanokē;</para>
  <para style="q2" vid="PRO 11:20">ko tāna e āhuareka ai ko te hunga e tika ana tō rātou ara.<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Ahakoa awhi ngā ringa ki a rāua,</para>
  <para style="q2" vid="PRO 11:21">e kore te tangata kino e waiho kia kore e whiua;</para>
  <para style="q2" vid="PRO 11:21">ka mawhiti ia te uri o te hunga tika.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Rite tonu ki te whakakai kōura i te ihu o te poaka</para>
  <para style="q2" vid="PRO 11:22">te wahine ātaahua kāhore nei ōna ngārahu pai.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Ko tā te hunga tika e minamina ai, ko te pai anake;</para>
  <para style="q2" vid="PRO 11:23">ko te tūmanako ia a te hunga kino, ko te riri.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Tērā tētahi kei te rui, ā, tāpiritia mai ana anō;</para>
  <para style="q2" vid="PRO 11:24">tērā tētahi kei te kaiponu i te mea e tika ana,</para>
  <para style="q2" vid="PRO 11:24">heoi rawakore noa iho.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Ko te wairua ohaoha ka mōmona;</para>
  <para style="q2" vid="PRO 11:25">ko te tangata e whakamākūkū ana, ka whakamākūkūria anō ia.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Ko te tangata e kaiponu ana i te wīti, ka kangā tērā e te nuinga;</para>
  <para style="q2" vid="PRO 11:26">ka tau ia te manaaki ki runga ki te māhunga o te tangata e hoko atu ana.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Ko te tangata e āta rapu ana i te pai, e rapu ana i te whakapai;</para>
  <para style="q2" vid="PRO 11:27">ko te tangata ia e rapu ana i te hē, ka tae tērā ki a ia.<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Ko te tangata e whakawhirinaki ana ki ōna taonga, ka taka;</para>
  <para style="q2" vid="PRO 11:28">nā, ko te hunga tika ka rite tō rātou tupu ki tō te rau matomato.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Ko te tangata e whakararu ana i tōna whare, he hau te taonga e whakarērea iho mōna;</para>
  <para style="q2" vid="PRO 11:29">hei pononga anō te kūware mā te ngākau whakaaro nui.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Ko ngā hua o te tangata tika he rākau nō te ora;</para>
  <para style="q2" vid="PRO 11:30">ka hopu wairua anō te tangata whakaaro tika.<verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Nanā, he utu anō tō te tangata tika i runga i te whenua;</para>
  <para style="q2" vid="PRO 11:31">nui atu ia tō te tangata kino rāua ko te tangata hara.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Ko te tangata e aroha ana ki te kupu ako e aroha ana ki te mātauranga;</para>
  <para style="q2" vid="PRO 12:1">nā, ko te tangata e kore e pai kia rīria tōna hē, he pōauau tērā.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Ko te tangata pai ka whiwhi ki tā Ihowā whakapai;</para>
  <para style="q2" vid="PRO 12:2">otiia ka whakahēngia e ia te tangata ngārahu kino.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />E kore tā te tangata e ū i te kino;</para>
  <para style="q2" vid="PRO 12:3">nā, ko te pakiaka o te hunga tika, e kore tērā e whakakorikoria.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />He wahine e ū ana tōna pai, hei karauna tērā ki tāna tāne;</para>
  <para style="q2" vid="PRO 12:4">tēnā ko te wahine i whakamā ai ia, hei pirau tērā i roto i ōna wheua.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Ko ngā whakaaro o te hunga tika he tika;</para>
  <para style="q2" vid="PRO 12:5">ko ngā whakaaro ia o te hunga kino he tinihanga.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Ko ngā kupu a te hunga kino e mea ana kia tauwhanga i te toto;</para>
  <para style="q2" vid="PRO 12:6">mā te māngai ia o te hunga tika rātou ka ora ai.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Ka hurihia iho te hunga kino, ā, kore iho;</para>
  <para style="q2" vid="PRO 12:7">ko te whare ia o te hunga tika ka tū tonu.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Ka rite ki tōna ngārahu te whakamoemiti mō te tangata;</para>
  <para style="q2" vid="PRO 12:8">ko te ngākau parori kē ia ka whakahāweatia.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Ko te tangata e whakahāweatia ana, he pononga nei tāna,</para>
  <para style="q2" vid="PRO 12:9">pai ake ia i te tangata e whakanui ana i a ia anō, ā, kāhore āna kai.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Ko te tangata tika e whakaaro ana ia ki te ora o tāna kararehe;</para>
  <para style="q2" vid="PRO 12:10">he nanakia ia ngā mahi atawhai a te hunga kino.<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Ko te tangata e mahi ana i tōna oneone ka mākona ia i te taro;</para>
  <para style="q2" vid="PRO 12:11">tēnā ko te tangata e whai ana i te hunga tekateka noa, kāhore ōna ngākau mahara.<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Ko tā te tangata kino e minamina ai ko te kupenga a te hunga kino;</para>
  <para style="q2" vid="PRO 12:12">e whai hua ana ia te pakiaka o te hunga tika.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Ka mau te tangata kino i te pokanga kētanga o ōna ngutu;</para>
  <para style="q2" vid="PRO 12:13">ka puta mai ia te tangata tika i roto i te raru.<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Mā ngā hua o tōna māngai ka mākona ai te tangata i te pai;</para>
  <para style="q2" vid="PRO 12:14">ka riro mai anō i te tangata ngā utu o tā ōna ringa.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />He tika tonu ki ōna kanohi ake te ara o te kūware;</para>
  <para style="q2" vid="PRO 12:15">e whakarongo ana ia te tangata whakaaro nui ki te kupu whakatūpato.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Ko te kūware, e mōhiotia wawetia ana tōna riri;</para>
  <para style="q2" vid="PRO 12:16">e hīpokina ana ia te whakamā e te tangata ngārahu tūpato.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Ko tā te tangata kōrero pono he whakapuaki i te tika;</para>
  <para style="q2" vid="PRO 12:17">ko tā te kaiwhakaatu teka ia he tinihanga.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />He tangata anō ko āna kōrero maka noa, me te mea ko ngā werohanga a te hoari;</para>
  <para style="q2" vid="PRO 12:18">he rongoā ia te arero o te hunga whakaaro nui.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Ka ū tonu te ngutu pono ā ake ake;</para>
  <para style="q2" vid="PRO 12:19">mō nāianei kau ia te arero teka.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />He tinihanga kei roto i te ngākau o ngā kaitito i te kino;</para>
  <para style="q2" vid="PRO 12:20">he koa ia tō ngā kaiwhakatakoto kōrero e mau ai te rongo.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />E kore tētahi kino e pā ki te tangata tika;</para>
  <para style="q2" vid="PRO 12:21">engari te hunga kino ka kī i te kino.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />He mea whakarihariha ki a Ihowā ngā ngutu teka;</para>
  <para style="q2" vid="PRO 12:22">ko tāna e āhuareka ai ko ngā kaimahi i te pono.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Hīpoki ai te tangata tūpato i te mātauranga;</para>
  <para style="q2" vid="PRO 12:23">e karanga nui ana ia te ngākau o ngā kūware i te kūwaretanga.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Mō te ringa o ngā uaua te kīngitanga;</para>
  <para style="q2" vid="PRO 12:24">hei hōmai takoha ia te māngere.<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Mā te pōuri i roto i te ngākau o te tangata e piko ai ia;</para>
  <para style="q2" vid="PRO 12:25">mā te kupu pai ia ka mārama ai.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Hira ake te tangata tika i tōna hoa;</para>
  <para style="q2" vid="PRO 12:26">te hunga kino ia ka whakapōhēhētia e tō rātou ara anō.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Kāhore te tangata māngere e tunu i tāna mea i hopu ai;</para>
  <para style="q2" vid="PRO 12:27">mā te tangata uaua ia te taonga utu nui a ngā tāngata.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />He ora kei te ara o te tika;</para>
  <para style="q2" vid="PRO 12:28">kāhore hoki he mate i tōna ara.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Ko te tama whakaaro nui ka rongo ki tā tōna pāpā ako;</para>
  <para style="q2" vid="PRO 13:1">ko te tangata whakahī ia e kore e rongo ki te riri.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />E kai te tangata i te pai i te hua o tōna māngai;</para>
  <para style="q2" vid="PRO 13:2">ka kai ia te wairua o te hunga whanokē i te tutū.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Ko te tangata e tiaki ana i tōna māngai e pupuri ana i tōna ora;</para>
  <para style="q2" vid="PRO 13:3">ko te tangata ia e hāmama nui ana ōna ngutu, ko te whakangaromanga mōna.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />E hiahia ana te wairua o te tangata māngere, ā, kāhore he mea māna;</para>
  <para style="q2" vid="PRO 13:4">ka meinga ia kia mōmona te wairua o te hunga uaua.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />E kino ana te tangata tika ki te kōrero teka;</para>
  <para style="q2" vid="PRO 13:5">he mea whakarihariha ia te tangata kino, ā, whakamā noa iho.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Ko te tika hei kaitiaki mō te tangata e tapatahi ana te ara;</para>
  <para style="q2" vid="PRO 13:6">ka whakatakā anō te tangata kino e te hara.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Tērā tētahi kei te āmene taonga mōna, heoi kāhore rawa he mea i a ia;</para>
  <para style="q2" vid="PRO 13:7">tērā tētahi kei te whakarawakore i a ia, heoi nui atu ōna rawa.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Ko ngā utu mō te tangata kia ora, ko ōna rawa;</para>
  <para style="q2" vid="PRO 13:8">tēnā ko te rawakore, e kore e rongo i te riri.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />E koa ana te mārama o te hunga tika;</para>
  <para style="q2" vid="PRO 13:9">ka keto ia te rama o te hunga kino.<verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />He totohe anake i ahu mai i te whakapehapeha;</para>
  <para style="q2" vid="PRO 13:10">he whakaaro nui ia kei te hunga i ngā kupu tika.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Ko ngā taonga i puta mai i te whakamanamana ka iti haere;</para>
  <para style="q2" vid="PRO 13:11">ko tā te tangata i whakaemi ai, he mea mahi, ka tupu haere.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />He manako tāringa roa, he patu ngākau;</para>
  <para style="q2" vid="PRO 13:12">ka tae te koronga, ko te rākau ia o te ora.<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Ko te tangata e whakahāwea ana ki te kupu, ka ngaro i a ia anō;</para>
  <para style="q2" vid="PRO 13:13">ko te tangata ia e wehi ana i te whakahau, ka whiwhi ki te utu.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Ko te ture o te hunga whakaaro nui, he puna nō te ora,</para>
  <para style="q2" vid="PRO 13:14">e puta ai i ngā reti o te mate.<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Ko tō te ngārahu pai he hōmai atawhai;</para>
  <para style="q2" vid="PRO 13:15">he taikaha ia te ara o te hunga nanakia.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />He mahi mōhio tā te tangata tūpato;</para>
  <para style="q2" vid="PRO 13:16">ko tā te wairangi he hora i te kūwaretanga.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Ka hinga te karere kino ki te kino;</para>
  <para style="q2" vid="PRO 13:17">ko te karere pono ia, ānō he rongoā.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Ko te tangata kāhore e pai ki te papaki, māna te rawakore, te whakamā;</para>
  <para style="q2" vid="PRO 13:18">engari ko te tangata e whai mahara ana ki te ako, ka whakahōnoretia.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Ko te hiahia kua rite, he reka ki te wairua;</para>
  <para style="q2" vid="PRO 13:19">he whakarihariha ia ki ngā kūware te whakarere i te kino.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Haere i te taha o te hunga whakaaro nui, ā, ka whai whakaaro koe;</para>
  <para style="q2" vid="PRO 13:20">ko te takahoa ia o ngā kūware, ka mamae.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Ka whai te kino i te hunga hara;</para>
  <para style="q2" vid="PRO 13:21">ko te utu ia ki te hunga tika, he pai.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />He whakarerenga iho tā te tangata pai mō ngā tamariki a ngā tamariki;</para>
  <para style="q2" vid="PRO 13:22">kei te rongoā mō te tangata tika ngā taonga o te tangata hara.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />He nui te kai kei te ngakinga a ngā rawakore;</para>
  <para style="q2" vid="PRO 13:23">tērā ia te mea e ngaro ana i te kore o te tikanga pai.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Ko te tangata e kaiponu ana i tāna whiu, e kino ana ia ki tāna tama;</para>
  <para style="q2" vid="PRO 13:24">ko te tangata ia e aroha ana ki a ia, ka papaki wawe i a ia.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Kai ana te tangata tika, mākona ana tōna wairua;</para>
  <para style="q2" vid="PRO 13:25">ka hapa ia te kōpū o te tangata kino.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Ko tā te wahine whakaaro nui he hanga i tōna whare;</para>
  <para style="q2" vid="PRO 14:1">ko tā te wahine wairangi, ko ōna ringa hei wāhi iho.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Ko te tangata e haere ana i runga i tōna tika, e wehi ana i a Ihowā;</para>
  <para style="q2" vid="PRO 14:2">ko te tangata he parori kē ōna ara e whakahāwea ana ki a ia.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Kei te māngai o te wairangi he patu whakapehapeha;</para>
  <para style="q2" vid="PRO 14:3">mā ngā ngutu ia o te hunga whakaaro nui rātou ka ora ai.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Ki te kāhore he kau, ka mā te takotoranga kai;</para>
  <para style="q2" vid="PRO 14:4">mā te kaha ia o te kau ka nui ai ngā hua.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />E kore te kaiwhakaatu pono e teka;</para>
  <para style="q2" vid="PRO 14:5">ka puaki ia te teka i te kaiwhakaatu teka.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />E rapu ana te tangata whakahī i te whakaaro nui, heoi kāhore e kitea e ia;</para>
  <para style="q2" vid="PRO 14:6">ki te tangata mātau ia he māmā noa te mātauranga.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Haere atu ki te aroaro o te kūware,</para>
  <para style="q2" vid="PRO 14:7">ina kāhore e kitea e koe he ngutu mātau ōna.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Ko te whakaaro nui o te tangata tūpato, he mātau ki tōna ara;</para>
  <para style="q2" vid="PRO 14:8">ko te wairangi o ngā kūware, he tinihanga.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Ko tā ngā wairangi he kata ki te hē;</para>
  <para style="q2" vid="PRO 14:9">nā, kei te hunga tika te whakaaro pai.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />E mōhio ana te ngākau ki tōna ake mamae,</para>
  <para style="q2" vid="PRO 14:10">e kore anō hoki tōna koa e pikitia e te tangata kē.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Ka whakangaromia te whare o te hunga kino;</para>
  <para style="q2" vid="PRO 14:11">ka tupu ia te tēneti o te hunga tika.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />He huarahi anō tērā e tika ana ki tā te tangata titiro,</para>
  <para style="q2" vid="PRO 14:12">ko tōna mutunga ia ko ngā huarahi ki te mate.<verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Ahakoa e kata ana, e mamae ana te ngākau;</para>
  <para style="q2" vid="PRO 14:13">ā, ko te mutunga o te koa, he pōuri.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Ko te tangata i te ngākau tahuri kē, ka mākona i ōna ara ake;</para>
  <para style="q2" vid="PRO 14:14">ā, ko te tangata pai ka mākona i tāna ake anō.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Ko tā te kūware he whakapono ki ngā kupu katoa;</para>
  <para style="q2" vid="PRO 14:15">tēnā ko te tangata tūpato, ka āta titiro ki tāna hīkoi.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />E wehi ana te tangata whakaaro nui, ka neke atu i te kino;</para>
  <para style="q2" vid="PRO 14:16">ko te kūware ia ka whakahī, ka tohe.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Ko te tangata riri wawe ka mahi i te wairangi;</para>
  <para style="q2" vid="PRO 14:17">ka kinongia anō hoki te tangata i ngā rauhanga kino.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />He wairangi te whakarerenga iho mō ngā kūware;</para>
  <para style="q2" vid="PRO 14:18">ko te tangata tūpato ia ka karaunatia ki te mātauranga.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />E piko ana te hunga kino ki te aroaro o te hunga pai;</para>
  <para style="q2" vid="PRO 14:19">ā, ko te hunga hē ki ngā kūwaha o te tangata tika.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />E kinongia ana te rawakore e tōna hoa ake nei anō;</para>
  <para style="q2" vid="PRO 14:20">he tokomaha ia ngā tāngata e aroha ana ki te tangata taonga.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Ko te tangata e whakahāwea ana ki tōna hoa, e hara ana;</para>
  <para style="q2" vid="PRO 14:21">ko te tangata ia e atawhai ana ki ngā rawakore, ka hari.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />He teka ianei e kotiti kē ana ngā kaiwhakatakoto i te kino?</para>
  <para style="q2" vid="PRO 14:22">He atawhai ia, he pono, kei ngā kaihanga i te pai.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />He hua tō ngā māuiuitanga katoa;</para>
  <para style="q2" vid="PRO 14:23">tēnā ko te kōrero o ngā ngutu e ahu ana ki te rawakore.<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Hei karauna mō ngā whakaaro nui ō rātou taonga;</para>
  <para style="q2" vid="PRO 14:24">ko te wairangi ia o ngā kūware, he wairangi kau.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Ka ora ngā wairua i te kaiwhakaatu pono;</para>
  <para style="q2" vid="PRO 14:25">ko te tangata kōrero teka ia e mea ana kia tinihanga.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Ū tonu, kaha tonu te whakaaro ina wehi ki a Ihowā;</para>
  <para style="q2" vid="PRO 14:26">ka whai rerenga atu anō hoki āna tamariki.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />He puna ora te wehi ki a Ihowā,</para>
  <para style="q2" vid="PRO 14:27">e mahue ai ngā reti o te mate.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Mā te nui o te iwi ka whai hōnore ai te kīngi;</para>
  <para style="q2" vid="PRO 14:28">mā te kore o te iwi ka taka ai te rangatira.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />He mātauranga nui tō te tangata manawanui;</para>
  <para style="q2" vid="PRO 14:29">ko te tangata riri wawe ia, e whakaneke ake ana ia i te wairangi.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />He ora ki ngā kikokiko te ngākau ora;</para>
  <para style="q2" vid="PRO 14:30">ko te hae ia, he pirau ki ngā wheua.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Ko te tangata e tūkino ana i te ware, he tāwai tāna ki tōna Kaihanga;</para>
  <para style="q2" vid="PRO 14:31">ko te tangata ia e atawhai ana i te rawakore, e whakahōnore ana i a ia.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />E uakina iho ana te tangata kino i runga i tōna hē;</para>
  <para style="q2" vid="PRO 14:32">ko te tangata tika ia ka whai tūmanakohanga i tōna matenga.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Ka noho te whakaaro nui ki te ngākau o te tangata mātau;</para>
  <para style="q2" vid="PRO 14:33">engari ko te mea kei te wāhi ki roto o ngā kūware e whakaaturia ana.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Mā te tika ka kake ai te iwi;</para>
  <para style="q2" vid="PRO 14:34">mā te hara ia ka ingoa kino ai ngā iwi.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Ka manako te kīngi ki te pononga mahara;</para>
  <para style="q2" vid="PRO 14:35">ā, ka riri ki te tangata i takea ai te whakamā.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Mā te kupu ngāwari e kaupare te riri;</para>
  <para style="q2" vid="PRO 15:1">mā te kupu taimaha ia e whakaoho te riri.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Ko te arero o te tangata whakaaro nui e whakahua tika ana i te mātauranga;</para>
  <para style="q2" vid="PRO 15:2">e whakapuaki ana ia te māngai o ngā kūware i te wairangi.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Kei ngā wāhi katoa ngā kanohi o Ihowā,</para>
  <para style="q2" vid="PRO 15:3">e titiro ana ki te hunga kino, ki te hunga pai.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Ko te arero reka he rākau nō te ora;</para>
  <para style="q2" vid="PRO 15:4">tēnā ki te whanokē a roto he wāwāhi wairua.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />E whakahāwea ana te wairangi ki te papaki a tōna pāpā;</para>
  <para style="q2" vid="PRO 15:5">ko te tangata ia e mahara ana ki te ako ka mōhio ki te tūpato.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />He nui te taonga kei te whare o te tangata tika;</para>
  <para style="q2" vid="PRO 15:6">he raruraru ia kei roto i ngā mea hua ki te tangata kino.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />E ruia ana te mātauranga e ngā ngutu o ngā whakaaro nui;</para>
  <para style="q2" vid="PRO 15:7">kāhore ia he pēnā a te ngākau o ngā kūware.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />He mea whakarihariha ki a Ihowā te whakahere a te hunga kino;</para>
  <para style="q2" vid="PRO 15:8">engari, e manako ana ia ki te īnoi a te hunga tika.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />He mea whakarihariha ki a Ihowā te huarahi o te tangata kino;</para>
  <para style="q2" vid="PRO 15:9">ko te tangata ia e whai ana i te tika tāna e aroha ai.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />He kino te papaki ki te tangata e whakarere ana i te ara;</para>
  <para style="q2" vid="PRO 15:10">ā, ko te tangata e kino ana ki te ako, ka mate.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Kei te aroaro o Ihowā te rēinga me te whakangaromanga;</para>
  <para style="q2" vid="PRO 15:11">engari rawa hoki ngā ngākau o ngā tama a te tangata.<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />E kore te tangata whakahī e aroha ki te kaipapaki;</para>
  <para style="q2" vid="PRO 15:12">e kore hoki e haere ki te hunga whakaaro nui.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Mā te koa o te ngākau ka pai ai te mata;</para>
  <para style="q2" vid="PRO 15:13">mā te pōuri ia o te ngākau ka marū ai te wairua.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />E rapu ana te ngākau mōhio i te mātauranga;</para>
  <para style="q2" vid="PRO 15:14">ko te kūware ia tā te māngai o ngā wairangi e kai ai.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />He kino ngā rā katoa o te hunga pōuri;</para>
  <para style="q2" vid="PRO 15:15">he hākari tonu tā te tangata i te ngākau mārama.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />He pai kē te iti i kīnakitia ki te wehi ki a Ihowā,</para>
  <para style="q2" vid="PRO 15:16">i te nui taonga i kīnakitia ki te raruraru.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />He pai ake te tina pūwhā ko te aroha hei kīnaki,</para>
  <para style="q2" vid="PRO 15:17">i te kau whāngai e kīnakitia ana ki te mauāhara.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />He whakaoho tautohe tā te tangata pukuriri;</para>
  <para style="q2" vid="PRO 15:18">he pēhi pakanga ia tā te tangata manawanui.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Ko te ara o te tangata māngere, ānō he taiepa tātarāmoa;</para>
  <para style="q2" vid="PRO 15:19">he ara nui ia tō te tangata tika.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />He tama whakaaro nui, ka koa te pāpā;</para>
  <para style="q2" vid="PRO 15:20">tēnā ko te tama kūware, he whakahāwea ki tōna whaea.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Ki te tangata maharakore he mea whakahari te wairangi;</para>
  <para style="q2" vid="PRO 15:21">he tika ia te haere a te tangata mātau.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Ki te kāhore he rūnanga, ka pororaru ngā tikanga;</para>
  <para style="q2" vid="PRO 15:22">mā te tokomaha ia o ngā kaiwhakatakoto whakaaro ka mau ai.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Kei tā tōna māngai i whakahoki ai he koa mō te tangata;</para>
  <para style="q2" vid="PRO 15:23">ko te kupu i te wā i tika ai, ānō te pai!<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Ki te tangata whakaaro nui e ahu whakarunga ana te ara ki te ora,</para>
  <para style="q2" vid="PRO 15:24">he mea kia mahue ai i a ia te rēinga o raro.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Ka hūtia ake e Ihowā te whare o te tangata whakakake;</para>
  <para style="q2" vid="PRO 15:25">engari ka whakapūmautia e ia te rohe o te pouaru.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />He mea whakarihariha ki a Ihowā ngā whakaaro nanakia;</para>
  <para style="q2" vid="PRO 15:26">he mea kohakore ia ngā kupu āhuareka.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Ko te tangata apo taonga, raruraru ana i a ia tōna whare;</para>
  <para style="q2" vid="PRO 15:27">ka ora ia te tangata e kino ana ki ngā mea hōmai noa.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Ko te ngākau o te tangata tika e āta whakaaro ana ki te kupu hei whakahokinga;</para>
  <para style="q2" vid="PRO 15:28">ko te māngai ia o te tangata kino e tāhoro ana i ngā mea kikino.<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />E matara ana a Ihowā i te hunga kino;</para>
  <para style="q2" vid="PRO 15:29">otiia e rongo ana ia ki te īnoi a te hunga tika.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Mā te mārama o ngā kanohi ka koa ai te ngākau;</para>
  <para style="q2" vid="PRO 15:30">ā, mā te rongo pai ka mōmona ai ngā wheua.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Ko te taringa e whakarongo ana ki te whakatūpato e ora ai,</para>
  <para style="q2" vid="PRO 15:31">ka noho i waenga i te hunga whakaaro nui.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Ko te tangata e whakakāhore ana ki te papaki, e whakahāwea ana ki tōna wairua;</para>
  <para style="q2" vid="PRO 15:32">engari ko te tangata e rongo ana ki te ako, ka whiwhi ki te ngākau mahara.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Ko te wehi ki a Ihowā te ako o te whakaaro nui;</para>
  <para style="q2" vid="PRO 15:33">ko te ngākau whakaiti hoki e haere ana i mua i te hōnore.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Ko ngā whakatakataka a te ngākau nā te tangata;</para>
  <para style="q2" vid="PRO 16:1">engari, ko te kupu whakahoki a te arero nā Ihowā.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Ko ngā ara katoa o te tangata he mā ki ōna ake kanohi;</para>
  <para style="q2" vid="PRO 16:2">ko Ihowā ia ki te pāuna i ngā wairua.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Utaina āu mahi ki runga ki a Ihowā,</para>
  <para style="q2" vid="PRO 16:3">ā, ka whakapūmautia ōu whakaaro.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />He mea hanga nā Ihowā ngā mea katoa mō tōna tutukitanga, mō tōna;</para>
  <para style="q2" vid="PRO 16:4">āe rā, ko te tangata kino hoki mō te rā o te kino.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />He mea whakarihariha nā Ihowā te hunga ngākau whakakake katoa;</para>
  <para style="q2" vid="PRO 16:5">ahakoa pupuri te ringa ki te ringa, e kore ia e kore te whiua.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Ko te mahi tohu tangata me te pono hei pure mō te kino;</para>
  <para style="q2" vid="PRO 16:6">mā te wehi hoki ki a Ihowā ka mawehe atu ai te tangata i te kino.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Ki te pai a Ihowā ki ngā ara o te tangata,</para>
  <para style="q2" vid="PRO 16:7">ka meinga e ia ōna hoariri nei anō kia mau te rongo ki a ia.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />He pai ake te mea iti i runga i te tika,</para>
  <para style="q2" vid="PRO 16:8">i ngā hua maha ki te kāhore he tika.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Ko te ngākau o te tangata hei whakaaro i tōna ara;</para>
  <para style="q2" vid="PRO 16:9">ko Ihowā ia hei whakatika i tōna hīkoi.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />He kupu atua kei ngā ngutu o te kīngi;</para>
  <para style="q2" vid="PRO 16:10">e kore tōna māngai e poka kē ina whakawā.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Ko te taimaha tika, ko te pāuna tika, nā Ihowā;</para>
  <para style="q2" vid="PRO 16:11">he mahi nāna ngā kōhatu katoa o te pūtea.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />He mea whakarihariha ki ngā kīngi te mahi i te kino;</para>
  <para style="q2" vid="PRO 16:12">nā te tika hoki i ū ai te torōna.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />He mea āhuareka ki ngā kīngi ngā ngutu tika;</para>
  <para style="q2" vid="PRO 16:13">e aroha ana hoki rātou ki te tangata e kōrero tika ana.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Ko te riri o te kīngi ānō he karere mō te mate;</para>
  <para style="q2" vid="PRO 16:14">engari ka whakamārietia e te tangata whakaaro nui.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />He ora kei te mārama o te mata o te kīngi;</para>
  <para style="q2" vid="PRO 16:15">ā, ko tana manako he rite ki te kapua o tō muri ua.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Ko te whiwhi ki te whakaaro nui, ānō te pai!</para>
  <para style="q2" vid="PRO 16:16">Pai atu i te whiwhi ki te kōura;</para>
  <para style="q2" vid="PRO 16:16">ko te whiwhi hoki ki te mātauranga te mea e hiahiatia nuitia atu i te hiriwa.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Ko te huanui o te hunga tika he mawehe atu i te kino,</para>
  <para style="q2" vid="PRO 16:17">ko te tangata e whai whakaaro ana ki tōna ara, ka mau tōna wairua.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Haere ai te whakakake i mua o te whakangaromanga,</para>
  <para style="q2" vid="PRO 16:18">te wairua whakapehapeha i mua i te hinganga.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Ko te ngākau whakaiti i waenga i te hunga rawakore,</para>
  <para style="q2" vid="PRO 16:19">pai atu i te uru ki te tūwhanga taonga a te hunga whakakake.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Ko te tangata e tahuri ana ki te kupu, ka kite i te pai;</para>
  <para style="q2" vid="PRO 16:20">ā, ko te tangata e whakawhirinaki ana ki a Ihowā, ka hari.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Ka kīia te whakaaro nui he mātau;</para>
  <para style="q2" vid="PRO 16:21">mā te reka hoki o ngā ngutu ka neke ai te mōhio.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Ko te mātauranga te puna o te ora mō te tangata i whiwhi ki tērā;</para>
  <para style="q2" vid="PRO 16:22">ko te ako ia mō te hunga wairangi ko tō rātou wairangi anō.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Mā te ngākau o te tangata whakaaro nui e tohutohu tōna māngai,</para>
  <para style="q2" vid="PRO 16:23">e āpiti hoki he kupu mōhio ki ōna ngutu.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Ko ngā kupu matareka ānō kei te honikoma,</para>
  <para style="q2" vid="PRO 16:24">he reka ki te wairua, he rongoā ki ngā wheua.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Tērā he ara e tika ana ki te titiro a te tangata;</para>
  <para style="q2" vid="PRO 16:25">ko tōna mutunga ia ko ngā ara ki te mate.<verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Ko te hiahia o te tangata e mahi ana, e mahi ana mōna;</para>
  <para style="q2" vid="PRO 16:26">nō te mea e akiakina ana ia e tōna māngai.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />E whakatakoto ana te tangata tikangakore i te kino,</para>
  <para style="q2" vid="PRO 16:27">ā, kei ōna ngutu ānō he ahi e kā ana.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Ko tā te tangata whanokē he tītaritari i te raruraru;</para>
  <para style="q2" vid="PRO 16:28">ko tā te tangata kawekawe kōrero he wehewehe i ngā hoa tupu.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Whakawai ai te tangata nanakia i tōna hoa,</para>
  <para style="q2" vid="PRO 16:29">kawe ai i a ia ki te huarahi kāhore i pai.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Ko te tangata e whakamoe ana i ōna kanohi, e mea ana kia whakaaroa ai e ia ngā mea whanokē;</para>
  <para style="q2" vid="PRO 16:30">ko te tangata e kokopi ana i ōna ngutu e whakatutuki ana i te kino.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />He karauna korōria te māhunga hina,</para>
  <para style="q2" vid="PRO 16:31">e ka kitea i runga i te ara o te tika.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Engari rawa te tangata manawanui i te tangata kaha,</para>
  <para style="q2" vid="PRO 16:32">te tangata e pēhia ana e ia tōna wairua i te tangata i horo ai te pā.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />E makā ana te rota ki roto ki te kokorutanga o te kākahu;</para>
  <para style="q2" vid="PRO 16:33">kei a Ihowā ia te tikanga katoa.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Ko te maramara kai, ko te mea maroke me te āta noho hei kīnaki,</para>
  <para style="q2" vid="PRO 17:1">pai atu i te whare kī i ngā hākari a te ngangare.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Hei rangatira te pononga mahara mō te tama i whakamā ai;</para>
  <para style="q2" vid="PRO 17:2">ka whai wāhi anō ia i roto i tō ngā tēina.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Ko te oko tahu para mō te hiriwa, ko te oumu mō te kōura;</para>
  <para style="q2" vid="PRO 17:3">ko Ihowā ia hei whakamātau mō ngā ngākau.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Ko te kaimahi i te hē ka tahuri ki tā te ngutu kino;</para>
  <para style="q2" vid="PRO 17:4">ā, ka whai taringa te teka ki tā te arero whanokē.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Ko te taunu ki te rawakore he tāwai ki tōna Kaihanga;</para>
  <para style="q2" vid="PRO 17:5">ko te tangata e koa ana ki ngā aituā, e kore e kore te whiua.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Hei karauna mō ngā koroheke ngā tamariki a ngā tamariki;</para>
  <para style="q2" vid="PRO 17:6">nā, ko te korōria o ngā tamariki ko ō rātou mātua.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />E kore te reo rangatira e tau ki te kūware;</para>
  <para style="q2" vid="PRO 17:7">hore rawa anō hoki te ngutu teka ki te rangatira.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Ko te tangata i te mea hōmai noa, he kōhatu whakapaipai tērā ki tāna titiro;</para>
  <para style="q2" vid="PRO 17:8">tōna tahuritanga ake ki hea, ki hea, ka whiwhi ki te pai.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Ko te tangata e hīpoki ana i te hē, e whai ana i te aroha;</para>
  <para style="q2" vid="PRO 17:9">tēnā ko te tangata kōrerorero, e wehewehe ana i ngā hoa tupu.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Ko te ngotonga o te kupu riri ki roto ki te tangata mātau,</para>
  <para style="q2" vid="PRO 17:10">nui atu i tō ngā whiu kotahi rau ki roto ki te whakaarokore.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />He whakakeke kau tā te tangata kino e whai ai;</para>
  <para style="q2" vid="PRO 17:11">nō reira ka tukua atu he karere nanakia ki a ia.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Kia tūtaki ki te tangata te pea kua tangohia āna kūao;</para>
  <para style="q2" vid="PRO 17:12">pai atu i te whakaarokore i a ia e wairangi ana.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Ko te tangata e hōmai ana i te kino hei utu mō te pai,</para>
  <para style="q2" vid="PRO 17:13">e kore te kino e neke atu i tōna whare.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Ko te tīmatanga o te totohe i rite ki te tangata e tuku ana i te wai kia rere;</para>
  <para style="q2" vid="PRO 17:14">nā reira waiho atu te totohe i te mea kīanō i oho te ngangare.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Ko te tangata e whakatika ana i tā te tangata kino,</para>
  <para style="q2" vid="PRO 17:15">me ia e whakahē ana i tā te tangata tika,</para>
  <para style="q2" vid="PRO 17:15">he rite tahi taua rua, he mea whakarihariha ki a Ihowā.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Hei aha te utu i te ringa o te kūware,</para>
  <para style="q2" vid="PRO 17:16">hei hoko i te whakaaro nui, kāhore nei hoki ōna mātauranga?<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />E aroha ana te hoa i ngā wā katoa;</para>
  <para style="q2" vid="PRO 17:17">nā, ko te teina, ko te tuakana, i whānau tērā mō ngā aituā.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Ko tā te tangata ngākaukore he papaki ringa;</para>
  <para style="q2" vid="PRO 17:18">kua waiho hei whakakapi tūranga i te aroaro o tōna hoa.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Ko te tangata e aroha ana ki te ngangare e aroha ana ki te kino;</para>
  <para style="q2" vid="PRO 17:19">ko te tangata e whakarewa ana i tōna kūwaha e rapu ana i te whakangaromanga.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Ko te ngākau parori kē e kore e kite i te pai;</para>
  <para style="q2" vid="PRO 17:20">ko te tangata he whanokē tōna arero ka taka ki te kino.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Ka whānau he whakaarokore mā tētahi tangata, hei whakapōuri tērā mōna;</para>
  <para style="q2" vid="PRO 17:21">e kore anō hoki e koa te pāpā o te pōauau.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />He rongoā pai te ngākau koa;</para>
  <para style="q2" vid="PRO 17:22">ki te marū ia te wairua, ka maroke ngā wheua.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />E tango ana te tangata kino i te mea whakapati i te uma,</para>
  <para style="q2" vid="PRO 17:23">hei whakapeau kē i ngā ara o te whakarite whakawā.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Kei te aroaro o te tangata mātau ngā whakaaro nui;</para>
  <para style="q2" vid="PRO 17:24">kei ngā pito ia o te whenua ngā kanohi o te whakaarokore.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Ko te tamaiti whakaarokore he mea whakapōuri i tōna pāpā,</para>
  <para style="q2" vid="PRO 17:25">he mea whakakawa i te ngākau o tōna whaea.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Ehara anō hoki i te mea pai kia whiua te tangata tika,</para>
  <para style="q2" vid="PRO 17:26">kia patua rānei ngā rangatira mō te tika.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />He mātauranga tō te tangata e tohu ana i āna kupu;</para>
  <para style="q2" vid="PRO 17:27">ā, he whakaaro tō te tangata i te wairua manawanui.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Ko te wairangi nei anō, ki te whakarongo puku, ka kīia he whakaaro nui;</para>
  <para style="q2" vid="PRO 17:28">ki te kokopi ōna ngutu, ka kīia ia he tūpato.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Ko te tangata tū kē, e whai ana i tā tōna ake hiahia,</para>
  <para style="q2" vid="PRO 18:1">e ngangau ana ki ngā whakaaro tōtika katoa.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Kāhore o te whakaarokore āhuareka ki te mātauranga;</para>
  <para style="q2" vid="PRO 18:2">engari kia whakakitea e ia tōna ngākau.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />I te taenga mai o te tangata kino ka tae mai anō te whakahāwea,</para>
  <para style="q2" vid="PRO 18:3">me te tāwai hei hoa mō te whakamā.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />He wai hōhonu ngā kupu a te māngai o te tangata;</para>
  <para style="q2" vid="PRO 18:4">he awa e rere ana te puna o te whakaaro nui.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Ehara i te mea pai te whakapai ki te kanohi o te tangata kino,</para>
  <para style="q2" vid="PRO 18:5">te whakapeau kē rānei i tā te tangata tika ina whakawā.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />E uru ana ngā ngutu o te whakaarokore ki te totohe,</para>
  <para style="q2" vid="PRO 18:6">e karanga ana tōna māngai ki ngā whiu.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Hei huna anō mōna te māngai o te whakaarokore;</para>
  <para style="q2" vid="PRO 18:7">ā, ko ōna ngutu hei rore mō tōna wairua.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Ānō he kai reka ngā kupu a te kawe kōrero;</para>
  <para style="q2" vid="PRO 18:8">tae tonu iho ki ngā wāhi o roto rawa o te kōpū.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Ko te tangata anō hoki e māngere ana ki tāna mahi,</para>
  <para style="q2" vid="PRO 18:9">hei teina ia ki te tangata maumau.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Hei pourewa kaha te ingoa o Ihowā;</para>
  <para style="q2" vid="PRO 18:10">rere ana te tangata tika ki reira, ā, ora ake.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Ko ngā rawa o te tangata taonga hei pā kaha mōna,</para>
  <para style="q2" vid="PRO 18:11">hei pā tiketike ki tōna whakaaro.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />I mua ake o te whakangaromanga ka whakakake te ngākau o te tangata;</para>
  <para style="q2" vid="PRO 18:12">i mua ake anō hoki o te hōnore ko te ngākau pāpaku.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Ko te tangata e whakahoki kupu ana i te mea kāhore anō ia i rongo noa,</para>
  <para style="q2" vid="PRO 18:13">he mahi wairangi tērā nāna, he hanga whakamā.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />E whakamanawanui te wairua o te tangata ki tōna mate;</para>
  <para style="q2" vid="PRO 18:14">tēnā ko te wairua marū, ko wai e kaha ki tērā?<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Ka whiwhi te ngākau o te tangata mātau ki te mōhio;</para>
  <para style="q2" vid="PRO 18:15">e rapu ana hoki te taringa o ngā whakaaro nui ki te mōhio.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Mā te mea tuku noa a te tangata ka wātea ai he wāhi mōna,</para>
  <para style="q2" vid="PRO 18:16">ka kawea hoki ia e tērā ki te aroaro o ngā tāngata nunui.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Ko te tangata nāna te kupu tuatahi i te whakawā me te mea kei a ia te tika;</para>
  <para style="q2" vid="PRO 18:17">nā, ka haere mai tōna hoa, kei te rapu i te tikanga o tāna.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Mā te rota e mutu ai ngā tautohe,</para>
  <para style="q2" vid="PRO 18:18">ā, ko tērā hei tauārai i waenganui o te hunga kaha.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Ko te tuakana, teina rānei, i whakatakariritia, pakeke atu i te pā kaha;</para>
  <para style="q2" vid="PRO 18:19">ā, ko aua tū ngangare me he tūtaki tatau nō te whare rangatira.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Ka kī te kōpū o te tangata i ngā hua o tōna māngai,</para>
  <para style="q2" vid="PRO 18:20">ka mākona ia i ngā hua o ōna ngutu.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Ko te mate, ko te ora kei te arero;</para>
  <para style="q2" vid="PRO 18:21">ko te hunga e aroha ana ki tērā ka kai i ōna hua.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Ko te tangata kua kite i te wahine māna,</para>
  <para style="q2" vid="PRO 18:22">kua kite i te mea pai, kua whiwhi hoki ki tā Ihowā whakapai.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />He īnoi tā te rawakore hanga he taikaha ia</para>
  <para style="q2" vid="PRO 18:23">te whakahoki a te tangata taonga.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Ko te tangata tini ngā hoa aroha e whai ana i te hē mōna;</para>
  <para style="q2" vid="PRO 18:24">tērā anō ia te hoa aroha, nui atu i tō te tuakana, i tō te teina, tōna piri mai.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />He pai kē te rawakore e haere ana i runga i tōna tapatahi,</para>
  <para style="q2" vid="PRO 19:1">i te ngutu whanokē, i te whakaarokore.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Nā, ehara hoki i te mea pai kia kaua he mātauranga mō te wairua;</para>
  <para style="q2" vid="PRO 19:2">ā, ko te tangata e hohoro ana ōna waewae, ka hara.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />E whakaparoritia ana te ara o te tangata e tōna wairangi;</para>
  <para style="q2" vid="PRO 19:3">e amuamu ana hoki tōna ngākau ki a Ihowā.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Mā te rawa ka tokomaha atu ai ngā hoa aroha;</para>
  <para style="q2" vid="PRO 19:4">e wehea atu ana ia, te rawakore i tōna hoa aroha.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />E kore te kaiwhakapae teka e whakaharakoretia;</para>
  <para style="q2" vid="PRO 19:5">e kore hoki e mawhiti te tangata kōrero teka.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />He tokomaha e whai kia manakohia e te tangata ringa mahora;</para>
  <para style="q2" vid="PRO 19:6">he hoa aroha hoki ngā tāngata katoa nō te tangata e hōmai mea ana.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />E kino ana ngā tēina katoa o te rawakore ki a ia;</para>
  <para style="q2" vid="PRO 19:7">nā, nui kē atu te mataratanga atu o ōna hoa i a ia!</para>
  <para style="q1" vid="PRO 19:7">Whai noa āna kupu i a rātou,</para>
  <para style="q2" vid="PRO 19:7">heoi kua riro rātou.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Ko te tangata e mea ana ki te whakaaro nui mōna, e aroha ana ki tōna wairua ake;</para>
  <para style="q2" vid="PRO 19:8">ko te tangata e pupuri ana i te mātauranga, ka tūtaki ki te pai.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />E kore te kaiwhakapae teka e whakaharakoretia;</para>
  <para style="q2" vid="PRO 19:9">ka hunā hoki te tangata kōrero teka.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />E kore e tau te noho rangatira ki te whakaarokore;</para>
  <para style="q2" vid="PRO 19:10">he makere rawa te noho ko te pononga hei rangatira mō ngā rangatira.<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Ko te ngārahu tūpato ka pupuri i tōna riri;</para>
  <para style="q2" vid="PRO 19:11">ā, hei whakakorōria mōna te whakarere noa iho i te hē.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Ko te riri o te kīngi rite tonu ki te hāmama o te raiona;</para>
  <para style="q2" vid="PRO 19:12">ko tana manako ia ānō he tōmairangi i runga i te tarutaru.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />He aituā mō tōna pāpā te tamaiti whakaarokore;</para>
  <para style="q2" vid="PRO 19:13">ā, ko ngā ngangare a te wahine, me te māturuturu pūputu tonu.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />He whare, he taonga i tuku iho i ngā mātua;</para>
  <para style="q2" vid="PRO 19:14">ko te hoa wahine mahara i a Ihowā.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Mā te māngere e mea kia moe i te moe reka;</para>
  <para style="q2" vid="PRO 19:15">ka matekai hoki te wairua o te rōrā.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Ko te tangata e pupuri ana i te whakahau e pupuri ana i tōna wairua;</para>
  <para style="q2" vid="PRO 19:16">engari, ko te tangata kore whakaaro ki ōna ara ka mate.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Ko te tangata e ohaoha ana ki te rawakore e whakatārewa moni ana ki a Ihowā,</para>
  <para style="q2" vid="PRO 19:17">ā, ka utua ki a ia tāna mahi atawhai.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Pākia tāu tama, i te mea kua whai manakohanga;</para>
  <para style="q2" vid="PRO 19:18">kaua hoki tōu ngākau e whai tonu i te whakangaromanga mōna.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Ko te tangata riri nui māna e waha tōna hē;</para>
  <para style="q2" vid="PRO 19:19">ki te whakaora hoki koe i a ia, ka waiho tonu tēnā hei mahi māu.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Whakarongo ki te kupu tohutohu, tahuri mai hoki ki te ako,</para>
  <para style="q2" vid="PRO 19:20">kia whai whakaaro ai koe i tōu mutunga iho.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />He maha ngā whakaaro i roto i te ngākau o te tangata;</para>
  <para style="q2" vid="PRO 19:21">e tū tonu ana ia tā Ihowā tikanga.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Ko te hiahia o te tangata te aronga o tana atawhai;</para>
  <para style="q2" vid="PRO 19:22">engari te rawakore i te tangata teka.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Ko te wehi ki a Ihowā te ara ki te ora;</para>
  <para style="q2" vid="PRO 19:23">ā, ko te tangata kei a ia tērā, ka noho mākona;</para>
  <para style="q2" vid="PRO 19:23">e kore tētahi hē e pā ki a ia.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />E kuhua ana e te māngere tōna ringa ki te rīhi,</para>
  <para style="q2" vid="PRO 19:24">e kore rawa nei e whakahokia e ia ki tōna māngai.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Pākia te tangata whakahī, ā, ka tūpato ngā kūware;</para>
  <para style="q2" vid="PRO 19:25">ākona hoki te tangata mahara, ā, ka mōhio ia ki te mātauranga.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Ko te tangata e pāhua ana i tōna pāpā, e pei atu ana hoki i tōna whaea,</para>
  <para style="q2" vid="PRO 19:26">he tama ia e whakamā ai, e ingoa kino ai hoki.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Kāti, e tāku tama, te whakarongo ki te ako</para>
  <para style="q2" vid="PRO 19:27">hei mea kau e kotiti atu ai i ngā kupu o te mātauranga.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />E whakahī ana te kaiwhakaatu hē ki te whakawā;</para>
  <para style="q2" vid="PRO 19:28">e horomia ana hoki te kino e te māngai o te hunga kino.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Kua rite he whakawā mō ngā whakahī,</para>
  <para style="q2" vid="PRO 19:29">he whiu mō te tuarā o ngā whakaarokore.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Ko tā te wāina he whakahī, ko tā te wai kaha he ngangau;</para>
  <para style="q2" vid="PRO 20:1">ā, ko te hunga katoa e whakapōhēhētia ana e tērā, kāhore ō rātou whakaaro nui.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Ānō he raiona e hāmama ana te wehi o te kīngi;</para>
  <para style="q2" vid="PRO 20:2">ko te tangata e whakaoho ana i a ia kia riri, e hara ana ki tōna wairua ake.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />He whakahōnore mō te tangata te noho wātea mai i te ngangare;</para>
  <para style="q2" vid="PRO 20:3">engari ko ngā wairangi he kōwhetewhete tonu.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Kāhore te māngere e parau, he mea ki te hōtoke;</para>
  <para style="q2" vid="PRO 20:4">nō reira ka pākiki kai māna i te kotinga wīti, ā, kāhore e whiwhi.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />He wai hōhonu te whakaaro i roto i te ngākau o te tangata;</para>
  <para style="q2" vid="PRO 20:5">e utuhia anō ia e te tangata mātau.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Ko tā te tini o te tangata he kauwhau i tōna atawhai ake;</para>
  <para style="q2" vid="PRO 20:6">ko wai ia e kite i te tangata pono?<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Ko te tangata tika, e haere ana i runga i tōna tapatahi,</para>
  <para style="q2" vid="PRO 20:7">ka manaakitia āna tamariki i muri i a ia.<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Ko te kīngi e noho ana i runga i te torōna whakawā,</para>
  <para style="q2" vid="PRO 20:8">tītaritaria ana e ōna kanohi ngā hē katoa.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Ko wai e mea, “Kua mā i ahau tōku ngākau,</para>
  <para style="q2" vid="PRO 20:9">kua tahia atu ōku hara”?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Ko ngā pāuna huhua, ko ngā mēhua huhua,</para>
  <para style="q2" vid="PRO 20:10">he rite tahi taua rua, he mea whakarihariha anake ki a Ihowā.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />He tamariki nei anō ka mōhiotia ki āna hanga,</para>
  <para style="q2" vid="PRO 20:11">he mā rānei, he tika rānei tāna mahi.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Ko te taringa rongo, ko te kanohi titiro,</para>
  <para style="q2" vid="PRO 20:12">nā Ihowā rāua ngātahi i hanga.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Kaua e matenuitia te moe, kei rawakoretia koe;</para>
  <para style="q2" vid="PRO 20:13">titiro ōu kanohi, ā, ka mākona koe i te taro.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />“Ehara ehara,” e ai tā te kaihoko;</para>
  <para style="q2" vid="PRO 20:14">tōna haerenga atu ia, kei te whakamanamana.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />He kōura tēnā me te tini o te rupi;</para>
  <para style="q2" vid="PRO 20:15">engari he taonga utu nui ngā ngutu o te mātauranga.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Tangohia te kākahu o te kaiwhakakapi mō te tangata kē;</para>
  <para style="q2" vid="PRO 20:16">puritia hoki te tangata i taunahatia hei whakakapi mō ngā tāngata kē.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />He reka ki te tangata te taro o te teka;</para>
  <para style="q2" vid="PRO 20:17">muri iho ka kī tōna māngai i te kirikiri.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Mā te rūnanga ka ū ai ngā whakaaro;</para>
  <para style="q2" vid="PRO 20:18">kia pai hoki te ngārahu ina anga ki te whawhai.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Ko te tangata e kōpikopiko ana ki te kawekawe kōrero, ka whākina e ia ngā kōrero ngaro;</para>
  <para style="q2" vid="PRO 20:19">nā reira kaua e raweke atu ki te tangata ngutu hāmama.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Ko te tangata e kanga ana i tōna pāpā, i tōna whaea,</para>
  <para style="q2" vid="PRO 20:20">ka tineia tōna rama i roto i te pōuri kerekere.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />I te tīmatanga e hohoro mai pea te taonga;</para>
  <para style="q2" vid="PRO 20:21">e kore ia tōna mutunga e whakapaingia.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Kaua e mea, “Ka utua e ahau te kino”;</para>
  <para style="q2" vid="PRO 20:22">tāria tā Ihowā, ā, kei a ia he oranga mōu.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />He mea whakarihariha ki a Ihowā ngā taimaha rerekē;</para>
  <para style="q2" vid="PRO 20:23">ā, e kore hoki te pāuna tinihanga e pai.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Nā Ihowā ngā hāereerenga o te tangata;</para>
  <para style="q2" vid="PRO 20:24">nā, mā te aha te tangata ka mātau ai ki tōna ara?<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Hei rore ki te tangata te oho noa ake ki te mea, “He tapu!”</para>
  <para style="q2" vid="PRO 20:25">ā, i muri i ngā kī taurangi, kia uiui.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Ka tītaritaria e te kīngi whakaaro nui te hunga kino,</para>
  <para style="q2" vid="PRO 20:26">ā, ka hurihia hoki e ia te wīra patu wīti ki runga ki a rātou.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />He rama nā Ihowā te manawa o te tangata,</para>
  <para style="q2" vid="PRO 20:27">e rapu ana i ngā mea katoa i roto rawa i te kōpū.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Hei kaitiaki mō te kīngi te atawhai me te pono;</para>
  <para style="q2" vid="PRO 20:28">e tautokona ake ana hoki tōna torōna e te atawhai.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Ko te korōria o ngā taitama ko tō rātou kaha;</para>
  <para style="q2" vid="PRO 20:29">ā, ko te ātaahua o ngā kaumātua ko te upoko hina.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />E tahia atu ana te kino e ngā kārawarawa o te patunga;</para>
  <para style="q2" vid="PRO 20:30">ā, e tae rawa ana ngā whiu ki ngā wāhi o roto rawa o te kōpū.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Kei roto te ngākau o te kīngi i te ringa o Ihowā ānō he awa rerenga wai;</para>
  <para style="q2" vid="PRO 21:1">e whakaangahia ana e ia ki ngā wāhi katoa e pai ai ia.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Ko ngā ara katoa o te tangata, tika kau ki ōna kanohi ake;</para>
  <para style="q2" vid="PRO 21:2">ko Ihowā ia hei pāuna i ngā ngākau.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Ko te mahi i te tika, i te whakawā,</para>
  <para style="q2" vid="PRO 21:3">ki tā Ihowā, pai atu i te patunga tapu.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />He kanohi whakakake, he ngākau whakapehapeha,</para>
  <para style="q2" vid="PRO 21:4">ā, ko te rama hoki o te hunga kino, he hara kau.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Ko ngā whakaaro o te tangata uaua e ahu anake ana ki te hua o te taonga;</para>
  <para style="q2" vid="PRO 21:5">ko te hunga tākare katoa ia e whawhai kau ana ki te mūhore.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />E rite ana tā te arero teka āmi i te taonga ki te mamaoa e āia noatia ana;</para>
  <para style="q2" vid="PRO 21:6">ko te hunga e rapu ana i ērā e rapu ana i te mate.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Mā te pāhua a te hunga kino e tahi atu rātou;</para>
  <para style="q2" vid="PRO 21:7">mō rātou kāhore e pai ki te whakawā.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />He ara tino kōpikopiko tō te tangata e waha ana i te hara;</para>
  <para style="q2" vid="PRO 21:8">tēnā ko te tangata mā, he tika tāna mahi.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />He pai kē te noho i te kokonga o te tuanui,</para>
  <para style="q2" vid="PRO 21:9">i te noho tahi me te wahine ngangare i roto i te whare māhorahora.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Ko tā te wairua o te tangata kino he hiahia ki te kino;</para>
  <para style="q2" vid="PRO 21:10">e kore ōna kanohi e manako ki tōna hoa.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Ki te whiua te tangata whakahī, ka whai whakaaro te kūware;</para>
  <para style="q2" vid="PRO 21:11">ā, ki te whakaakona te tangata whakaaro nui, ka whiwhi ia ki te mātauranga.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Ka āta whakaaroa e te tangata tika te whare o te tangata kino;</para>
  <para style="q2" vid="PRO 21:12">te pēheatanga e whakatakā ai te hunga kino ki te mate mō rātou.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Ko te tangata e puru ana i ōna taringa ki te karanga a te rawakore,</para>
  <para style="q2" vid="PRO 21:13">tērā hoki ia e karanga, heoi e kore e whakarangona.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Mā te mea hōmai puku ka mārie ai te riri,</para>
  <para style="q2" vid="PRO 21:14">mā te moni whakapati hoki i roto i te uma ka mārie ai te āritarita kaha.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />He mahi koa nā te tangata tika te whakawā;</para>
  <para style="q2" vid="PRO 21:15">mō ngā kaimahi ia i te kino, ko te whakangaromanga.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Ko te tangata e kotiti kē ana i te huarahi o te mahara,</para>
  <para style="q2" vid="PRO 21:16">ka noho ia i te whakaminenga o ngā tūpāpaku.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Ko te tangata matenui ki ngā āhuareka, ka rawakore;</para>
  <para style="q2" vid="PRO 21:17">ā, ko te tangata e matenui ana ki te wāina, ki te hinu, e kore e whai taonga.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Hei utu te tangata kino mō te tangata tika;</para>
  <para style="q2" vid="PRO 21:18">ā, ka haere mai te tangata kōpeka hei whakakapi mō te tangata tū tika.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />He pai kē te noho i te koraha,</para>
  <para style="q2" vid="PRO 21:19">i te noho tahi me te wahine tohetohe, wahine pukukino.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Kei te nohoanga o te tangata whakaaro nui te taonga mōmōhanga me te hinu;</para>
  <para style="q2" vid="PRO 21:20">heoi maumauria ake e te wairangi.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Ko te tangata e whai ana i te tika, i te atawhai,</para>
  <para style="q2" vid="PRO 21:21">ka whiwhi ki te ora, ki te tika, ki te hōnore.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Ka pikitia e te tangata whakaaro nui te pā o ngā mārohirohi,</para>
  <para style="q2" vid="PRO 21:22">ka taka hoki i a ia te kaha i whakawhirinaki ai rātou.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ko te tangata e tiaki ana i tōna māngai,</para>
  <para style="q2" vid="PRO 21:23">i tōna arero, e tiaki ana i tōna wairua kei raru.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Ko te tangata whakakake, whakapehapeha, ko te tangata whakahī tōna ingoa,</para>
  <para style="q2" vid="PRO 21:24">e mahi ana ia i runga i te whakahirahira o tōna whakamanamana.<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Ka mate te tangata māngere i tōna hiahia anō;</para>
  <para style="q2" vid="PRO 21:25">e kore hoki ōna ringa e pai ki te mahi.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Tērā te hanga he kaiapo tonu ā pau noa te rā;</para>
  <para style="q2" vid="PRO 21:26">ko tā te tangata tika ia he hōmai, kāhore hoki āna kaiponu.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />He mea whakarihariha te whakahere a te tangata kino;</para>
  <para style="q2" vid="PRO 21:27">tērā noa ake ina hē te whakaaro i kawea mai ai e ia.<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Ka mate te kaiwhakaatu teka;</para>
  <para style="q2" vid="PRO 21:28">nā, ko te tangata whakarongo, ka kōrero, kāhore he kaiwhakahē.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Ka whakamārō te tangata kino i tōna mata;</para>
  <para style="q2" vid="PRO 21:29">tēnā ko te tangata tika, ka whakapai i ōna ara.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />I tō Ihowā aroaro kāhore he whakaaro nui,</para>
  <para style="q2" vid="PRO 21:30">kāhore he mātauranga, kāhore he kupu mōhio, e tū.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Kua rite noa ake he hōiho mō te rā o te whawhai;</para>
  <para style="q2" vid="PRO 21:31">kei a Ihowā ia te whakaoranga.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Engari te ingoa pai e whiriwhiria rawatia i ngā taonga nui,</para>
  <para style="q2" vid="PRO 22:1">me te manakohanga aroha i te hiriwa, i te kōura.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Ka tūtataki te tangata taonga rāua ko te rawakore;</para>
  <para style="q2" vid="PRO 22:2">ko Ihowā te kaihanga ō rātou katoa.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Ko te tangata tūpato, ka kitea atu e ia te hē, ka huna i a ia;</para>
  <para style="q2" vid="PRO 22:3">ko ngā kūware, haere tonu atu, mamae tonu atu.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Ko te hua o te māhaki, ā, ko te wehi ki a Ihowā,</para>
  <para style="q2" vid="PRO 22:4">he taonga, he hōnore, he ora.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />He tātarāmoa, he māhanga kei te ara o te whanokē;</para>
  <para style="q2" vid="PRO 22:5">ko te tangata ia e tiaki ana i tōna wairua, ka matara atu i ēnā.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Whakatupuria ake te tamaiti i te ara e haere ai ia,</para>
  <para style="q2" vid="PRO 22:6">ā, ka kaumātua, e kore e mahue i a ia.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />E whakatakoto tikanga ana te tangata taonga mō ngā rawakore;</para>
  <para style="q2" vid="PRO 22:7">ā, ko te tangata i te nama, hei pononga ia mā te tangata nāna i whakatārewa mai.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Ko te kairui o te kino, ka kokoti i te hē;</para>
  <para style="q2" vid="PRO 22:8">ā, ka kāhore noa iho te patu o tōna riri.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Ko te kanohi ohaoha, ka manaakitia tērā;</para>
  <para style="q2" vid="PRO 22:9">e hoatu ana hoki e ia tētahi wāhi o tāna taro mā te rawakore.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Peia atu te tangata whakahī, ā, ka riro te ngangare;</para>
  <para style="q2" vid="PRO 22:10">ka mutu anō hoki te totohe me te whakahāwea.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Ko te tangata e matenui ana ki te ngākau mā,</para>
  <para style="q2" vid="PRO 22:11">ko te kīngi he hoa mōna, mō te āhuareka o ōna ngutu.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Mā ngā kanohi o Ihowā e tiaki te tangata whai mātauranga,</para>
  <para style="q2" vid="PRO 22:12">e whakatakā ana hoki e ia ngā kupu a te tangata kōpeka.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />E mea ana te māngere, “He raiona kei waho;</para>
  <para style="q2" vid="PRO 22:13">ka whakamatea ahau ki ngā huarahi!”<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />He poka hōhonu te māngai o ngā wāhine kē;</para>
  <para style="q2" vid="PRO 22:14">ka taka ki roto tā Ihowā tangata e whakarihariha ai.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Paihere rawa te wairangi ki roto ki te ngākau o te tamaiti,</para>
  <para style="q2" vid="PRO 22:15">otiia, mā te rākau o te whiu e pei kia matara atu i a ia.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Ko te tangata e tūkino ana i te rawakore kia maha atu ai he taonga māna,</para>
  <para style="q2" vid="PRO 22:16">me te tangata hoki e hoatu mea ana ki te tangata taonga,</para>
  <para style="q2" vid="PRO 22:16">ka tutuki rāua ki te mūhore kau.<verse eid="PRO 22:16" /></para>
  <para style="s">He Whakatauki a te Hunga Whakaaronui</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Anga mai tōu taringa, whakarongo mai hoki ki ngā kupu a te hunga whakaaro nui,</para>
  <para style="q2" vid="PRO 22:17">kia tahuri mai hoki tōu ngākau ki tōku mātauranga.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />He mea āhuareka hoki, mehemea ka puritia e koe i roto i tōu kōpū,</para>
  <para style="q2" vid="PRO 22:18">ki te ū ngātahi rāua ki runga ki ōu ngutu.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Kia okioki ai koe ki a Ihowā,</para>
  <para style="q2" vid="PRO 22:19">koia i whakakitea ai e ahau aua mea ki a koe i tēnei rā – ki a koe nā anō.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />He teka ianei hira rawa ngā mea kua tuhituhia atu nei e ahau ki a koe,</para>
  <para style="q2" vid="PRO 22:20">he kupu ako, he kupu mōhio;<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />kia mōhio ai koe ki te tūturutanga o ngā kupu o te pono,</para>
  <para style="q2" vid="PRO 22:21">kia whakahokia ai e koe he kupu pono</para>
  <para style="q2" vid="PRO 22:21">ki te hunga e ngare ana i a koe?<verse eid="PRO 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Kaua e pāhuatia te rawakore, nō te mea he rawakore ia,</para>
  <para style="q2" vid="PRO 22:22">kaua hoki e whakatupuria kinotia te tangata iti i te kūwaha.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Nō te mea ka tohea e Ihowā tā rātou tohe,</para>
  <para style="q2" vid="PRO 22:23">ka pāhuatia anō hoki e ia te wairua o te hunga e pāhua ana i a rātou.<verse eid="PRO 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Kaua e whakahoa ki te tangata pukuriri;</para>
  <para style="q2" vid="PRO 22:24">kei haere tahi hoki koe i te tangata āritarita;<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />kei ākona e koe ōna ara,</para>
  <para style="q2" vid="PRO 22:25">ā, ka riro i a koe he māhanga mō tōu wairua.<verse eid="PRO 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Kei uru koe ki roto ki te hunga papaki ringa,</para>
  <para style="q2" vid="PRO 22:26">ki ngā kaiwhakakapi tūranga rānei mō te moni tārewa;<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />ki te kāhore āu mea hei utu,</para>
  <para style="q2" vid="PRO 22:27">hei aha i tangohia ai e ia tōu moenga i raro i a koe?<verse eid="PRO 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Kaua e whakanekehia atu te rohe tawhito</para>
  <para style="q2" vid="PRO 22:28">i whakatakotoria e ōu mātua.<verse eid="PRO 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Kei te kite rānei koe i tētahi tangata e uaua ana ki tāna mahi?</para>
  <para style="q2" vid="PRO 22:29">Ka tū ia ki te aroaro o ngā kīngi;</para>
  <para style="q2" vid="PRO 22:29">e kore ia e tū ki te aroaro o ngā ware.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Ki te noho tahi kōrua ko te rangatira ki te kai,</para>
  <para style="q2" vid="PRO 23:1">āta whakaaroa mārietia tērā i tōu aroaro;<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />whakapākia he māripi ki tōu korokoro,</para>
  <para style="q2" vid="PRO 23:2">ki te mea he tangata kakai koe.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Kaua e hiahia ki āna mea reka;</para>
  <para style="q2" vid="PRO 23:3">he kai tinihanga hoki ērā.<verse eid="PRO 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Kaua e tāruke ki te mea taonga;</para>
  <para style="q2" vid="PRO 23:4">kāti tāu mea ki tōu mātauranga.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />E anga mai rānei ōu kanohi ki taua mea korekore nei?</para>
  <para style="q2" vid="PRO 23:5">He pono hoki ka whai parirau te taonga,</para>
  <para style="q2" vid="PRO 23:5">koia ānō kei te ēkara, rere ana whaka te rangi.<verse eid="PRO 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Kaua e kainga te kai a te tangata kanohi kino,</para>
  <para style="q2" vid="PRO 23:6">kei minamina hoki koe ki āna mea reka.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Ko tāna hoki e mea ai i roto i a ia, pērā tonu ia,</para>
  <para style="q2" vid="PRO 23:7">“E kai, e inu!” koia tāna kupu ki a koe;</para>
  <para style="q2" vid="PRO 23:7">kāhore ia ōna ngākau ki a koe.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Ko te kongakonga i kainga e koe, ka ruakina e koe,</para>
  <para style="q2" vid="PRO 23:8">ka maumauria anō hoki āu kupu reka.<verse eid="PRO 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Kaua e kōrero ki ngā taringa o te kūware;</para>
  <para style="q2" vid="PRO 23:9">ka whakahāwea hoki ia ki te whakaaro nui o āu kupu.<verse eid="PRO 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Kei whakanekehia e koe te rohe tawhito;</para>
  <para style="q2" vid="PRO 23:10">kei haere koe ki ngā māra a te pani;<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />nō te mea he kaha tō rātou kaiwhakaora;</para>
  <para style="q2" vid="PRO 23:11">ka tohea e ia tā rātou tohe ki a koe.<verse eid="PRO 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Anga atu tōu ngākau ki te ako,</para>
  <para style="q2" vid="PRO 23:12">me ōu taringa ki ngā kupu o te mātauranga.<verse eid="PRO 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Kaua e tohungia te whiu ki te tamaiti;</para>
  <para style="q2" vid="PRO 23:13">ki te patua hoki ia e koe ki te rākau, e kore ia e mate.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Tātātia ia e koe ki te rākau,</para>
  <para style="q2" vid="PRO 23:14">ā, ka whakaorangia e koe tōna wairua i te rēinga.<verse eid="PRO 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />E tāku tama, ki te whakaaro nui tōu ngākau,</para>
  <para style="q2" vid="PRO 23:15">ka koa hoki tōku ngākau, āe rā, tōku nei anō;<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />āe rā, ka hari ōku whatumanawa,</para>
  <para style="q2" vid="PRO 23:16">ina kōrero ōu ngutu i ngā mea tika.<verse eid="PRO 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Kei hae tōu ngākau ki te hunga hara;</para>
  <para style="q2" vid="PRO 23:17">engari kia wehi koe ki a Ihowā, ā pau noa te rā.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />He pono hoki tērā ānō he whakautu;</para>
  <para style="q2" vid="PRO 23:18">e kore anō hoki tāu i tūmanako ai e hātepea atu.<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Whakarongo rā, e tāku tama, kia whai whakaaro hoki koe,</para>
  <para style="q2" vid="PRO 23:19">ā, whakatikaia tōu ngākau i te ara.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Kei uru ki te hunga kakai wāina;</para>
  <para style="q2" vid="PRO 23:20">ki te hunga pukukai kikokiko;<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />nō te mea ka tutuki tahi te tangata inuinu rāua ko te tangata kakai ki te rawakore;</para>
  <para style="q2" vid="PRO 23:21">he tawhetawhe hoki te kākahu a te momoe mō te tangata.<verse eid="PRO 23:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Whakarongo ki tōu pāpā nāna koe;</para>
  <para style="q2" vid="PRO 23:22">kaua hoki e whakahāwea ki tōu whaea ina rūruhi ia.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Hokona te pono, kaua hoki e whakawhitiwhitia;</para>
  <para style="q2" vid="PRO 23:23">āe rā, te whakaaro nui, te ako hoki, me te mātauranga.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Nui atu hoki te koa o te pāpā o te tangata tika;</para>
  <para style="q2" vid="PRO 23:24">ā, ko te tangata e whānau he tama whakaaro nui māna, ka hari ia ki a ia.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Kia hari tōu pāpā rāua ko tōu whaea,</para>
  <para style="q2" vid="PRO 23:25">inā, kia koa te wahine i whānau ai koe.<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />E tāku tama, hōmai tōu ngākau ki ahau,</para>
  <para style="q2" vid="PRO 23:26">kia manako anō hoki ōu kanohi ki āku ara.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Nō te mea he rua hōhonu te wahine kairau;</para>
  <para style="q2" vid="PRO 23:27">he poka kūiti te wahine kē.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Āe rā, ka whanga ia ānō he kaipāhua,</para>
  <para style="q2" vid="PRO 23:28">ā, ka whakatokomahatia e ia ngā tāngata poka kē.<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Ko wai e auē? Ko wai e tangi?</para>
  <para style="q2" vid="PRO 23:29">Ko wai e totohe? Ko wai e ngangautia?</para>
  <para style="q1" vid="PRO 23:29">Ko wai e marū, he mea takekore?</para>
  <para style="q2" vid="PRO 23:29">Ko wai e whero tonu ōna kanohi?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Ko te hunga e noho roa ana ki te wāina;</para>
  <para style="q2" vid="PRO 23:30">ko te hunga e haere ana ki te rapu i te wāina whakaranu.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Kaua e titiro ki te wāina i te mea e whero ana,</para>
  <para style="q2" vid="PRO 23:31">ina puta tōna kara i roto i te kapu,</para>
  <para style="q2" vid="PRO 23:31">ina mania tōna heke.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Tōna tukunga iho ānō he nākahi e ngau ana,</para>
  <para style="q2" vid="PRO 23:32">koia anō kei te wero a te neke.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />E kite hoki ōu kanohi i ngā mea rerekē,</para>
  <para style="q2" vid="PRO 23:33">ā, ka puta he kupu rerekē i tōu ngākau.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Āe rā, ka rite koe ki te tangata e takoto ana i waenga moana,</para>
  <para style="q2" vid="PRO 23:34">ki te tangata rānei e takoto ana i te tihi o te rewa.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Ā, ka mea koe, “Patua ana ahau e rātou, ā, kīhai ahau i mamae;</para>
  <para style="q2" vid="PRO 23:35">tātātia ana ahau e rātou, ā, kīhai ahau i mōhio.</para>
  <para style="q1" vid="PRO 23:35">Āhea ahau ara ake ai?</para>
  <para style="q2" vid="PRO 23:35">Ka rapua anō e ahau.”<verse eid="PRO 23:35" /></para>
  <para style="b" />
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Kei hae koe ki te hunga kino,</para>
  <para style="q2" vid="PRO 24:1">kaua hoki e hiahia hei hoa mō rātou.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Ko tā tō rātou ngākau hoki e whakaaro ai, he tūkino,</para>
  <para style="q2" vid="PRO 24:2">ko tā ō rātou ngutu e kōrero ai, he whanokē.<verse eid="PRO 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Mā te whakaaro nui ka hangā ai te whare,</para>
  <para style="q2" vid="PRO 24:3">ā, mā te mātauranga ka ū ai.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Mā te mōhio hoki ka kī ai ngā rūma</para>
  <para style="q2" vid="PRO 24:4">i ngā taonga utu nui katoa, i ngā mea āhuareka.<verse eid="PRO 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />He kaha te tangata whakaaro nui;</para>
  <para style="q2" vid="PRO 24:5">āe, e whakanuia ana e te tangata mōhio te kaha.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Nā, kia pai te ngārahu ina anga koe ki te whawhai;</para>
  <para style="q2" vid="PRO 24:6">kei te tokomaha hoki o ngā kaiwhakatakoto whakaaro te ora.<verse eid="PRO 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />He tiketike rawa te whakaaro nui mō te wairangi;</para>
  <para style="q2" vid="PRO 24:7">e kore e kuihi tōna māngai i te kūwaha.<verse eid="PRO 24:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Ko te tangata e whakaaro ana ki te kino,</para>
  <para style="q2" vid="PRO 24:8">ka kīia he whanokē.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />He hara te whakaaro wairangi;</para>
  <para style="q2" vid="PRO 24:9">he mea whakarihariha anō ki te tangata te tangata whakahī.<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Ki te ngoikore koe i te rā o te hē,</para>
  <para style="q2" vid="PRO 24:10">he iti tōu kaha.<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Whakaorangia te hunga e kawea atu ana ki te mate,</para>
  <para style="q2" vid="PRO 24:11">ā, puritia mai hoki e koe te hunga e meatia ana kia whakamatea.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Ki te mea koe, “Nanā, kīhai tēnei i mōhiotia e mātou”;</para>
  <para style="q2" vid="PRO 24:12">kāhore ianei te kaipāuna ngākau i te whakaaro ki tērā?</para>
  <para style="q1" vid="PRO 24:12">Ā, ko te kaitiaki o tōu wairua, kāhore rānei ia e mōhio,</para>
  <para style="q2" vid="PRO 24:12">e kore rānei e hōmai e ia ki te tangata kia rite ki tāna mahi?<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Kainga, e tāku tama, te honi, he pai hoki;</para>
  <para style="q2" vid="PRO 24:13">me te honikoma, he mea reka hoki ki tōu māngai.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Ka mōhio ai koe ki te whakaaro nui, he mea ki tōu wairua;</para>
  <para style="q2" vid="PRO 24:14">ki te kitea e koe, he tukunga iho anō tōna, e kore hoki tāu i tūmanako ai e hātepea.<verse eid="PRO 24:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Kaua, e te tangata kino, e whanga ki te nohoanga o te tangata tika;</para>
  <para style="q2" vid="PRO 24:15">kei tūkino koe ki tōna takotoranga.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />E hinga ana hoki te tangata tika, e whitu hinganga, ka ara ake anō;</para>
  <para style="q2" vid="PRO 24:16">ka whakatakā ia te hunga kino e te hē.<verse eid="PRO 24:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Kaua e harakoa ki te hinga tōu hoariri,</para>
  <para style="q2" vid="PRO 24:17">kaua hoki tōu ngākau e hari ina taka ia;<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />kei kite a Ihowā, ā, ka hē ki tāna titiro,</para>
  <para style="q2" vid="PRO 24:18">ā, ka tahuri atu tōna riri i a ia.<verse eid="PRO 24:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Kei mamae koe, he mea mō ngā kaimahi i te kino,</para>
  <para style="q2" vid="PRO 24:19">kei hae hoki ki te hunga kino.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Kāhore hoki he mutunga pai ki te tangata kino;</para>
  <para style="q2" vid="PRO 24:20">ka keto hoki te rama a te hunga kino.<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />E tāku tama, e wehi ki a Ihowā, ki te kīngi hoki;</para>
  <para style="q2" vid="PRO 24:21">ā, kaua e whakauru noa atu ki te hunga e mea ana ki te whakaputa kē.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Nō te mea ka puta tata te aituā mō rātou;</para>
  <para style="q2" vid="PRO 24:22">ā, ko wai ka mōhio ki te whakangaromanga ō rāua tokorua?<verse eid="PRO 24:22" /></para>
  <para style="b" />
  <para style="s">Ētahi atu Whakatauki Whakaaronui</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />He whakatauki anō hoki ēnei nā te hunga whakaaro nui:</para>
  <para style="b" vid="PRO 24:23" />
  <para style="q1" vid="PRO 24:23">Ehara i te mea pai kia whakaaro ki te kanohi tāngata ina whakawā.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Ko te tangata e mea ana ki te tangata kino, “He tika koe,”</para>
  <para style="q2" vid="PRO 24:24">ka kanga ngā iwi ki a ia, ka whakarihariha ngā tauiwi ki a ia.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Otiia ka koa ngā ngākau o te hunga e rīria ai tōna hē,</para>
  <para style="q2" vid="PRO 24:25">ka tau iho anō hoki te manaaki pai ki runga ki a rātou.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Ka kihia e ia ngā ngutu e whakahoki ana</para>
  <para style="q2" vid="PRO 24:26">i ngā kupu tika.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Meinga kia takoto pai tāu mahi i waho,</para>
  <para style="q2" vid="PRO 24:27">kia rite hoki hei meatanga māu i te māra;</para>
  <para style="q2" vid="PRO 24:27">muri iho ka hanga i tōu whare.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Kaua koe e tū hei kaiwhakaatu hē mō tōu hoa, i te mea kāhore he take;</para>
  <para style="q2" vid="PRO 24:28">ā, kaua e tinihanga ki ōu ngutu.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Kaua e kī, “Ka meatia anō e ahau ki a ia tāna i mea ai ki ahau;</para>
  <para style="q2" vid="PRO 24:29">ka rite ki tā te tangata mahi tāku e whakahoki ai ki a ia.”<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />I haere ahau i te taha o te māra a te māngere,</para>
  <para style="q2" vid="PRO 24:30">i te taha hoki o te māra wāina a te tangata kāhore ōna mahara;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />nā, kua tupuria katoatia e te tātarāmoa,</para>
  <para style="q2" vid="PRO 24:31">kapi tonu te mata o te māra i te ongaonga,</para>
  <para style="q2" vid="PRO 24:31">ā, ko tō reira taiepa kōhatu kua oti te wāhi.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Kātahi ahau ka titiro, ka āta whakaaroaro;</para>
  <para style="q2" vid="PRO 24:32">ka kite ahau, ā, ka hopu mai hei ako mōku.<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Kia iti ake nei te wāhi e parangia ai, kia iti ake nei te moe,</para>
  <para style="q2" vid="PRO 24:33">kia iti ake te kōtuituitanga o ngā ringa ka moe ai.<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Ka pērā te haerenga mai o tōu mūhore ānō he kaipāhua;</para>
  <para style="q2" vid="PRO 24:34">o tōu rawakore hoki ānō he tangata mau patu.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">He Whakatauki anō nā Horomona</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />He whakatauki anō ēnei nā Horomona, he mea tuhi e ngā tāngata a Hetekia kīngi o Hūrā.<verse eid="PRO 25:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Ko tō te Atua whakakorōria, he huna mea;</para>
  <para style="q2" vid="PRO 25:2">ko tō ngā kīngi whakakorōria he rapu mea.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Ko te rangi mō te tiketike, ko te whenua mō te hōhonu,</para>
  <para style="q2" vid="PRO 25:3">ā, ko te ngākau o ngā kīngi, tē taea te rapu.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Tahia atu te para i te hiriwa,</para>
  <para style="q2" vid="PRO 25:4">ā, ka puta mai he oko mā te kaitahi para;<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />tangohia atu te tangata kino i te aroaro o te kīngi,</para>
  <para style="q2" vid="PRO 25:5">ā, ka ū tōna torōna i runga i te tika.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Kei whakaputa i a koe ki mua i te aroaro o te kīngi,</para>
  <para style="q2" vid="PRO 25:6">kei tū hoki ki te wāhi o ngā metararahi.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />He pai kē hoki kia kīia mai ki a koe, “Haere mai ki runga nei,”</para>
  <para style="q2" vid="PRO 25:7">i te mea kia whakahokia iho koe ki raro i te aroaro o te rangatira.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">I kitea nei e ōu kanohi<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />kei hohoro te haere ki te ngangare,</para>
  <para style="q1" vid="PRO 25:8">kei kore e kitea e koe tāu e mea ai i tōna mutunga iho,</para>
  <para style="q2" vid="PRO 25:8">ina meinga koe e tōu hoa kia whakamā.<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Tohea tāu tohe ki tōu hoa tonu,</para>
  <para style="q2" vid="PRO 25:9">ā, kaua e whākina te mea huna a tētahi:<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />kei kohukohutia koe e te tangata i rongo,</para>
  <para style="q2" vid="PRO 25:10">ā, kore ake tōu ingoa kino e tahuri atu.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />He kupu i tika te kōrero,</para>
  <para style="q2" vid="PRO 25:11">ko tōna rite kei ngā āporo kōura i roto i ngā kete hiriwa.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />He pērā i te whakakai kōura, i te whakapaipai kōura parakore</para>
  <para style="q2" vid="PRO 25:12">koia anō te ako a te whakaaro nui ki te taringa rongo.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Rite tonu ki te mātao o te hukarere i te kotinga wīti</para>
  <para style="q2" vid="PRO 25:13">te karere pono ki ōna kaingare;</para>
  <para style="q2" vid="PRO 25:13">ka ora hoki i a ia te ngākau o ōna ariki.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />He pērā i ngā kapua me te hau uakore,</para>
  <para style="q2" vid="PRO 25:14">koia anō te rite o te tangata e whakamanamana ana ki āna hākari horihori.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Mā te roa e whakamanawanui ana ka whakaae mai ai te kīngi,</para>
  <para style="q2" vid="PRO 25:15">ā, mā te arero ngāwari ka mangungu ai te wheua.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Kua kitea e koe he honi, kainga ko te wāhi e mākona ai koe;</para>
  <para style="q2" vid="PRO 25:16">kei kī rawa koe i taua mea, ka ruakina e koe.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Kia takitahi tōu waewae ki te whare o tōu hoa;</para>
  <para style="q2" vid="PRO 25:17">kei hōhā ia ki a koe, ā, ka kino ki a koe.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Ko te tangata e whakaatu teka ana mō tōna hoa,</para>
  <para style="q2" vid="PRO 25:18">he patu ia, he hoari, ā, he pere koi.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Ko te whakawhirinaki ki te tangata tinihanga i te wā o te raru,</para>
  <para style="q2" vid="PRO 25:19">e rite ana ki te niho whati, ki te waewae kua takoki.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Ko te tangata e waiata ana ki te ngākau pōuri,</para>
  <para style="q2" vid="PRO 25:20">e rite ana ki te tangata e whakarere ana i te kākahu i te rangi māeke,</para>
  <para style="q2" vid="PRO 25:20">ki te winika hoki i runga i te hōura.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Ki te matekai tōu hoariri whāngaia ki te taro;</para>
  <para style="q2" vid="PRO 25:21">ki te matewai whakainumia ki te wai;<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />ka pūrangatia hoki e koe he waro kāpura ki tōna māhunga,</para>
  <para style="q2" vid="PRO 25:22">ā, ka utua tāu e Ihowā.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />E mauria ana mai e te hauraro he ua;</para>
  <para style="q2" vid="PRO 25:23">e pērātia ana hoki e te arero ngautuarā, he kanohi pukuriri.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />He pai kē te noho i te kokonga o te tuanui,</para>
  <para style="q2" vid="PRO 25:24">i te noho tahi me te wahine ngangare i roto i te whare māhorahora.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />He rongo pai nō te whenua tawhiti,</para>
  <para style="q2" vid="PRO 25:25">tōna rite kei ngā wai mātao ki te wairua matewai.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Me te manawa-whenua i takatakahia, me te puna i whakaparuparutia,</para>
  <para style="q2" vid="PRO 25:26">koia anō te tangata tika e hinga ana i te aroaro o te tangata kino.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Ehara i te mea pai te kai nui i te honi;</para>
  <para style="q2" vid="PRO 25:27">waihoki ko ā te tangata rapu i tō rātou ake korōria ehara i te korōria.<verse eid="PRO 25:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />Ko te tangata e kore nei e pēhi i tōna wairua,</para>
  <para style="q2" vid="PRO 25:28">e rite ana ki te pā kua pakaru, kāhore ōna taiepa.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />He pērā i te hukarere i te raumati, i te ua hoki i te kotinga wīti,</para>
  <para style="q2" vid="PRO 26:1">te kore e tau o te hōnore mō te wairangi.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />He pērā i te manu e rererere noa ana, i te warou i ōna rerenga</para>
  <para style="q2" vid="PRO 26:2">te kanga pokanoa; e kore e whakatau.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />He whiu mō te hōiho, he paraire mō te kāihe,</para>
  <para style="q2" vid="PRO 26:3">ā, he rākau mō te tuarā o ngā wairangi.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Kei rite ki tōna whakaarokore tāu whakautu ki te wairangi,</para>
  <para style="q2" vid="PRO 26:4">kei rite hoki a koe nā ki a ia.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Kia rite ki tōna whakaarokore tāu whakautu ki te wairangi,</para>
  <para style="q2" vid="PRO 26:5">kei mea ia he whakaaro nui ia.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Ko te tangata e tuku kōrero ana mā te ringa o te wairangi,</para>
  <para style="q2" vid="PRO 26:6">e tapahi ana i ōna waewae anō, e inumia ana hoki te hē.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />E tautau noa ana ngā waewae o te kopa;</para>
  <para style="q2" vid="PRO 26:7">he pērā hoki te whakatauki i te māngai o te wairangi.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Ko te takai mea whakapaipai i roto i te pūranga kōhatu,</para>
  <para style="q2" vid="PRO 26:8">ko tōna rite kei te tangata e whakakorōria ana i te wairangi.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />E rite ana ki te tātarāmoa e wero nei i te ringa o te haurangi,</para>
  <para style="q2" vid="PRO 26:9">koia anō te whakatauki i te māngai o ngā wairangi.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Ka rite ki te kaikōpere i tū ai te katoa,</para>
  <para style="q2" vid="PRO 26:10">te tangata e utu ana i te wairangi</para>
  <para style="q2" vid="PRO 26:10">me te tangata hoki e utu ana i ngā tira haere.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Ka rite ki te kurī e hoki nei ki tōna ruaki,</para>
  <para style="q2" vid="PRO 26:11">te wairangi e tuarua ana i tōna pōauau.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Ka kite koe i te tangata e mea ana ki a ia he whakaaro nui?</para>
  <para style="q2" vid="PRO 26:12">Ki tā te whakaaro tērā e rahi ake tā te wairangi i tāna.<verse eid="PRO 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />E kī ana te māngere, “He raiona kei te ara;</para>
  <para style="q2" vid="PRO 26:13">he raiona kei ngā waharoa.”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />He pērā i te tatau e tāhurihuri rā i runga i ōna īnihi,</para>
  <para style="q2" vid="PRO 26:14">koia anō te māngere i runga i tōna moenga.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />E kuhua ana e te māngere tōna ringa ki te rīhi;</para>
  <para style="q2" vid="PRO 26:15">he mahi ngenge rawa ki a ia te whakahoki mai ki tōna māngai.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />He nui kē ake te whakaaro nui o te māngere, ki tāna nei whakaaro,</para>
  <para style="q2" vid="PRO 26:16">i tō ngā tāngata tokowhitu e whakaatu ana i te tikanga.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Ko te tangata e haere atu ana, e pokanoa ana ki te whawhai ehara nei i a ia,</para>
  <para style="q2" vid="PRO 26:17">ko tōna rite kei te tangata e hopu ana i te kurī ki ōna taringa.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Rite tonu ki te haurangi e makamaka ana i ngā mea mura,</para>
  <para style="q2" vid="PRO 26:18">i ngā pere, i te mate,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />te tangata e tinihanga ana ki tōna hoa,</para>
  <para style="q2" vid="PRO 26:19">e mea ana, “He teka ianei he tākaro tāku?”<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Ki te kāhore he wahie, ka mate te ahi;</para>
  <para style="q2" vid="PRO 26:20">ki te kore hoki he tangata kawekawe kōrero, ka mutu te ngangare.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />He waro ki ngā ngārahu wera, he wahie ki te ahi;</para>
  <para style="q2" vid="PRO 26:21">he pērā te tangata totohe ki te tahu i te ngangare.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />He rite ngā kupu a te kaikawekawe kōrero ki te maramara reka,</para>
  <para style="q2" vid="PRO 26:22">tae tonu iho ki ngā wāhi o roto rawa o te kōpū.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />He ngutu pukā me te ngākau kino,</para>
  <para style="q2" vid="PRO 26:23">ko te rite kei te oko oneone i whakakikoruatia ki te para hiriwa.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Ko te tangata mauāhara e whakaware ana ki ōna ngutu,</para>
  <para style="q2" vid="PRO 26:24">otiia e rongoātia ana e ia te tinihanga ki roto ki a ia;<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />ki te pai tōna reo, kaua e whakapono ki a ia;</para>
  <para style="q2" vid="PRO 26:25">e whitu hoki ngā mea whakarihariha kei roto i tōna ngākau.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Ahakoa hīpoki tōna mauāhara i a ia ki te tinihanga,</para>
  <para style="q2" vid="PRO 26:26">ka whakakitea nuitia tōna kino ki te aroaro o te whakaminenga.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Ko te tangata e keri ana i te rua, ka taka anō ki roto;</para>
  <para style="q2" vid="PRO 26:27">ā, ko te tangata e huri ana i te kōhatu, ka hoki mai anō ki runga ki a ia.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />E kino ana te arero teka ki āna i kuru ai,</para>
  <para style="q2" vid="PRO 26:28">ā, ko tā te māngai whakapati, he mahi kia ngaro.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Kei whakamanamana koe ki te rā āpōpō;</para>
  <para style="q2" vid="PRO 27:1">kāhore hoki koe e mōhio ko te aha e puta mai i roto i te rā.<verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Mā tētahi atu tangata te whakamoemiti mōu, kaua mā tōu māngai ake;</para>
  <para style="q2" vid="PRO 27:2">mā te tangata kē, kaua mā ōu ngutu ake.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />He taimaha te kōhatu, he taimaha anō te kirikiri;</para>
  <para style="q2" vid="PRO 27:3">he taimaha atu ia i ā rāua tahi te pukuriri o te wairangi.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />He mea nanakia te riri, he rūtaki te āritarita;</para>
  <para style="q2" vid="PRO 27:4">ko wai ia e tū i mua i te hae?<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />He pai kē te riri matanui</para>
  <para style="q2" vid="PRO 27:5">i te aroha huna.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Ko ngā patu a te hoa aroha he mea nā te pono;</para>
  <para style="q2" vid="PRO 27:6">ko ngā kihi ia a te hoariri auau rawa.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />E ngaruru ana te wairua mākona ki te honikoma;</para>
  <para style="q2" vid="PRO 27:7">engari ki te wairua hiakai, reka kau ngā mea kawa katoa.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Rite tonu ki te manu e ātiutiu noa atu ana i tōna kōhanga</para>
  <para style="q2" vid="PRO 27:8">te tangata e ātiutiu noa atu ana i tōna wāhi.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />He whakahari ngākau te hinu me te whakakakara;</para>
  <para style="q2" vid="PRO 27:9">he pērā anō ngā āhuareka o tō te tangata hoa aroha</para>
  <para style="q2" vid="PRO 27:9">i ahu mai i ngā tikanga mateoha i whakatakotoria e tōna ngākau.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Ko tōu hoa aroha ake, ā, ko te hoa hoki o tōu pāpā, kaua e whakarērea;</para>
  <para style="q2" vid="PRO 27:10">kaua hoki e haere ki te whare o tōu tuakana i te rā e mate ai koe.</para>
  <para style="q1" vid="PRO 27:10">He pai kē hoki te hoa e tata ana</para>
  <para style="q2" vid="PRO 27:10">i te tuakana i tawhiti.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />E tāku tama, kia whakaaro nui, kia koa ai tōku ngākau,</para>
  <para style="q2" vid="PRO 27:11">kia whakahoki kupu ai hoki ahau ki te hunga e tāwai ana ki ahau.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />E kite atu ana te tangata tūpato i te hē, ā, ka huna i a ia;</para>
  <para style="q2" vid="PRO 27:12">tēnā ko te kūware, haere tonu atu, mamae tonu atu.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Tangohia te kākahu o te kaiwhakakapi mō te tangata kē;</para>
  <para style="q2" vid="PRO 27:13">tōna taunaha anō hoki mō tā te wahine kē.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Ko te tangata e maranga ana i te atatū,</para>
  <para style="q2" vid="PRO 27:14">he nui hoki tōna reo ki te manaaki i tōna hoa,</para>
  <para style="q2" vid="PRO 27:14">ka kīia tāna he kanga.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />He māturuturu e pūputu tonu ana i te rā nui te ua,</para>
  <para style="q2" vid="PRO 27:15">he wahine ngangare, rite tonu rāua;<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />ko te tangata e mea ana ki te pēhi i a ia,</para>
  <para style="q2" vid="PRO 27:16">e mea ana ki te pēhi i te hau, ā, ka tūtaki tōna ringa matau ki te hinu.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Ko te rino hei whakakoi mō te rino;</para>
  <para style="q2" vid="PRO 27:17">waihoki ko te tangata anō hei whakakoi i te mata o tōna hoa.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Ko te kaitiaki o te piki, ka kai i ōna hua;</para>
  <para style="q2" vid="PRO 27:18">ka whakahōnoretia te tangata e whakaaro ana ki tōna rangatira.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />He pērā i te wai, tiro atu, tiro mai he kanohi,</para>
  <para style="q2" vid="PRO 27:19">ka pēnā anō tō te tangata ngākau ki te tangata.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Ko te rēinga, ko te whakangaromanga, e kore e mākona;</para>
  <para style="q2" vid="PRO 27:20">e kore anō hoki e mākona ngā kanohi o te tangata.<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Ko te oko tahu para mō te hiriwa, ko te oumu mō te kōura;</para>
  <para style="q2" vid="PRO 27:21">ā, ko te whakanui i a ia, hei whakamātautau mō te tangata.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Ahakoa i tukua e koe te wairangi ki te tuki i roto i te kumete</para>
  <para style="q2" vid="PRO 27:22">i waenga i ngā wīti pēpē,</para>
  <para style="q2" vid="PRO 27:22">e kore tōna whakaarokore e riro.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Kia anga nui koa kia mōhio ki te āhua o āu hipi,</para>
  <para style="q2" vid="PRO 27:23">ā, kia pai te tiaki i āu kāhui kau;<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />e kore hoki te taonga e mau tonu;</para>
  <para style="q2" vid="PRO 27:24">e mau ianei te karauna ki ngā whakatupuranga katoa?<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Kua whāiti te hei, e kitea ana te tupu hou,</para>
  <para style="q2" vid="PRO 27:25">ā, e kohikohia ana ngā otaota o ngā maunga.<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />Hei mea kākahu mōu ngā reme,</para>
  <para style="q2" vid="PRO 27:26">ā, ko ngā koati hei utu mō te māra.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Ā tērā te waiū koati, he nui noa atu hei kai māu,</para>
  <para style="q2" vid="PRO 27:27">hei kai hoki mā tōu whare,</para>
  <para style="q2" vid="PRO 27:27">hei oranga anō hoki mō āu kōtiro.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />E rere ana te hunga kino i te mea kāhore he kaiwhai;</para>
  <para style="q2" vid="PRO 28:1">ko te tangata tika anō ia, ānō he raiona te māia.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />He hē nō tētahi whenua</para>
  <para style="q2" vid="PRO 28:2">i tokomaha ai ōna rangatira;</para>
  <para style="q1" vid="PRO 28:2">nā, kia ai he tangata e mahara ana, e mātau ana,</para>
  <para style="q2" vid="PRO 28:2">ka mau roa ai tōna āhua.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Ko te tangata rawakore e tūkino ana i ngā ware,</para>
  <para style="q2" vid="PRO 28:3">ko tōna rite kei te ua tā e kore ai te kai.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Ko te hunga e whakarere ana i te ture,</para>
  <para style="q2" vid="PRO 28:4">he whakamoemiti tā rātou ki te tangata kino;</para>
  <para style="q2" vid="PRO 28:4">ko tā ngā kaipupuri ia o te ture he ngangare ki a rātou.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />E kore te hunga kino e mōhio ki te whakawā:</para>
  <para style="q2" vid="PRO 28:5">ko te hunga ia e rapu ana i a Ihowā, ka mōhio rātou ki ngā mea katoa.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />He pai kē te rawakore e haere ana i runga i tōna tapatahi,</para>
  <para style="q2" vid="PRO 28:6">i te tangata he parori kē ōna ara, ahakoa he whai taonga ia.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Ko te tangata e pupuri ana i te ture, he tamaiti mōhio ia;</para>
  <para style="q2" vid="PRO 28:7">engari ko te tangata whakahoa ki te hunga kakai,</para>
  <para style="q2" vid="PRO 28:7">ka whakamā tōna pāpā i a ia.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Ko te tangata e whakanui ana i ōna rawa ki te moni whakatupu, ki te whakapiki utu,</para>
  <para style="q2" vid="PRO 28:8">e kohia ana e ia ērā mā te tangata e atawhaitia ai te rawakore.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Ko te tangata e tahuri kē ana tōna taringa,</para>
  <para style="q2" vid="PRO 28:9">ā, kāhore e rongo ki te ture, ko tāna īnoi nei ānō he mea whakarihariha.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Ko te tangata i meinga ai te hunga tika,</para>
  <para style="q2" vid="PRO 28:10">kia kotiti kē ki te ara hē, ka taka a ia anō ki tāna ake poka;</para>
  <para style="q2" vid="PRO 28:10">ka whiwhi ia te hunga ngākau tapatahi ki te pai.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Ki te whakaaro a te tangata taonga he nui tōna whakaaro mōhio;</para>
  <para style="q2" vid="PRO 28:11">otiia e rapua ana tāna e te rawakore whai whakaaro.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Nui atu te ātaahua, ina koa te hunga tika;</para>
  <para style="q2" vid="PRO 28:12">engari ki te ara te hunga kino, ka huna ngā tāngata i a rātou.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Ko te tangata e hīpoki ana i ōna hē, e kore tāna e kake;</para>
  <para style="q2" vid="PRO 28:13">ko te tangata ia e whāki ana, ā, e whakarere ana, ka tohungia.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Ka hari te tangata e wehi tonu ana;</para>
  <para style="q2" vid="PRO 28:14">ko te tangata ia e whakapakeke ana i tōna ngākau, ka taka ki te kino.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />E rite ana ki te raiona e hāmama ana, ki te pea e kōpikopiko ana,</para>
  <para style="q2" vid="PRO 28:15">te tangata kino e kīngi ana ki te iwi rawakore.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Ko te rangatira kore whakaaro he nui anō tāna tūkino;</para>
  <para style="q2" vid="PRO 28:16">ko te tangata ia e kino ana ki te apo ka roa ōna rā.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Ko te tangata e waha ana i te toto o te tangata,</para>
  <para style="q2" vid="PRO 28:17">ka rere ia ki roto ki te rua;</para>
  <para style="q2" vid="PRO 28:17">kaua tētahi e pupuri i a ia.<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Ko te tangata he tapatahi nei te haere, ka ora;</para>
  <para style="q2" vid="PRO 28:18">ko te tangata ia he parori kē ōna ara, hinga tonu iho.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Ko te tangata e ngaki ana i tōna oneone, ka mākona i te taro;</para>
  <para style="q2" vid="PRO 28:19">ko te tangata ia e whai ana i te hunga wairangi, ka whiwhi nui ki te rawakore.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Ko te tangata pono, ka nui ngā manaaki mōna;</para>
  <para style="q2" vid="PRO 28:20">ko te tangata ia e hīkaka ana ki te mea taonga, e kore ia e kore te whiwhi i te hē.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Ko te whakapai kanohi ehara i te mea pai –</para>
  <para style="q2" vid="PRO 28:21">ehara anō hoki i te mea pai kia hē te tangata mō te kongakonga taro.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Ko te tangata he kino tōna kanohi e tākare tonu ana ki te taonga;</para>
  <para style="q2" vid="PRO 28:22">kāhore hoki ia e whakaaro ka tae mai te kore o te rawa ki a ia.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Ko te tangata i rīria ai te hē o tētahi, ka nui atu te manako ki a ia i muri iho,</para>
  <para style="q2" vid="PRO 28:23">i te manako ki te tangata i whakapati nei tōna arero.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Ko te tangata e pāhua ana i tōna pāpā, i tōna whaea,</para>
  <para style="q2" vid="PRO 28:24">ā, e kī ana, “Ehara i te hē,”</para>
  <para style="q2" vid="PRO 28:24">he hoa ia nō te kaiwhakangaro.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Ko tā te tangata ngākau apo he whakapātari pakanga;</para>
  <para style="q2" vid="PRO 28:25">ko te tangata ia e okioki ana ki a Ihowā ka tetere.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />He kūware te tangata e whakawhirinaki ana ki tōna ake ngākau;</para>
  <para style="q2" vid="PRO 28:26">ko te tangata ia e haere ana i runga i te whakaaro nui, ka mawhiti.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Ko te tangata e hoatu ana ki te rawakore, e kore ia e hapa;</para>
  <para style="q2" vid="PRO 28:27">ko te tangata ia e kaupare ana i ōna kanohi, ka maha ngā kanga mōna.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Ka ara te hunga kino, ka huna ngā tāngata i a rātou;</para>
  <para style="q2" vid="PRO 28:28">nā, ki te ngaro rātou, ka tupu te hunga tika.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Ko te tangata he maha nei ngā riringa i tōna hē, ā, ka whakapakeke i tōna kakī</para>
  <para style="q2" vid="PRO 29:1">ka whatia ohoreretia ia – tē taea te rongoā.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Ka whakanuia te hunga tika, ka koa te iwi;</para>
  <para style="q2" vid="PRO 29:2">ka kīngi te tangata kino, ka auē te iwi.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Ko te tangata e matenui ana ki te whakaaro nui e whakahari ana i tōna pāpā;</para>
  <para style="q2" vid="PRO 29:3">ko te tangata ia e piri ana ki ngā wāhine kairau, he maumau taonga tāna.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Mā te whakawā a te kīngi e mau ai te whenua;</para>
  <para style="q2" vid="PRO 29:4">ka whakatakā ia e te tangata e tango ana i ngā mea hōmai noa.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ko te tangata e whakapati ana ki tōna hoa,</para>
  <para style="q2" vid="PRO 29:5">e whakatakoto kupenga ana mō ōna waewae.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />He rore kei roto i te hē o te tangata kino;</para>
  <para style="q2" vid="PRO 29:6">ko te tangata tika ia he waiata tāna, he koa.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />E mahara ana te tangata tika ki te take a te rawakore;</para>
  <para style="q2" vid="PRO 29:7">kāhore o te tangata kino whakaaro kia mōhiotia e ia.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Mā ngā tāngata whakahī e tahu te pā kia mura;</para>
  <para style="q2" vid="PRO 29:8">ko tā te hunga whakaaro nui ia he whakatahuri atu i te riri.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Ki te totohe te tangata whakaaro nui ki te tangata wairangi,</para>
  <para style="q2" vid="PRO 29:9">ahakoa riri ia, kata rānei, kāhore he tānga.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />E mauāhara ana te tangata whakaheke toto ki te tangata i te ngākau tapatahi;</para>
  <para style="q2" vid="PRO 29:10">tēnā ko te hunga tika, ka whai rātou kia whakaorangia ia.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />E puakina ana e te wairangi tōna riri katoa ki waho;</para>
  <para style="q2" vid="PRO 29:11">e puritia mai ana ia e te tangata whakaaro nui, e pēhia ana.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Ki te whakarongo te rangatira ki te teka,</para>
  <para style="q2" vid="PRO 29:12">he kino katoa āna tāngata.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />E tūtaki ana te rawakore rāua ko te kaitūkino ki a rāua;</para>
  <para style="q2" vid="PRO 29:13">ko Ihowā te kaiwhakamārama o ngā kanohi ō rāua tokorua.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Ko te kīngi e pono ana tāna whakawā mō ngā rawakore,</para>
  <para style="q2" vid="PRO 29:14">ka whakapūmautia tōna torōna ake ake.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Ko te whiu, ko te riri i te hē, he mea hōmai ērā i te whakaaro nui;</para>
  <para style="q2" vid="PRO 29:15">tēnā ko te tamaiti mahue noa, ka whakamā a ia tōna whaea.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Ka tokomaha te hunga kino, ka nui te hē;</para>
  <para style="q2" vid="PRO 29:16">ka kite ia te hunga tika i tō rātou hinganga.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Pākia tāu tama, ā, ka whai okiokinga koe i a ia;</para>
  <para style="q2" vid="PRO 29:17">āe rā, he āhuareka tāna e hōmai ai ki tōu wairua.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Ki te kāhore he whakakitenga, ka kore te iwi e tūpato;</para>
  <para style="q2" vid="PRO 29:18">ko te kaipupuri ia i te ture, ka hari ia.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Ehara te kupu i te papaki mō te pononga;</para>
  <para style="q2" vid="PRO 29:19">ahakoa hoki ia mātau, e kore ia e rongo.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Ka kite rānei koe i te tangata kaikā ki te kōrero?</para>
  <para style="q2" vid="PRO 29:20">Engari, te wairangi ka tōtika ake i a ia.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Ko te tangata e penapena ana i tāna pononga mai o te tamarikitanga,</para>
  <para style="q2" vid="PRO 29:21">ka waiho ia e ia i te mutunga hei tama tupu.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />He whakaoho whawhai tā te tangata pukuriri;</para>
  <para style="q2" vid="PRO 29:22">he nui rawa hoki te hē o te tangata āritarita.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Ka whakaititia iho te tangata e tōna whakapehapeha;</para>
  <para style="q2" vid="PRO 29:23">ka whai hōnore ia te tangata ngākau pāpaku.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Ko te tangata e whakauru ana ki tā te tāhae, e kino ana ki tōna ake wairua;</para>
  <para style="q2" vid="PRO 29:24">e rongo ana ia i te kanga, kāhore e kīkī.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />He rore e hōmai ana e te wehi ki te tangata;</para>
  <para style="q2" vid="PRO 29:25">ko te tangata ia e whakawhirinaki ana ki a Ihowā ka mawhiti.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />He tokomaha e whai ana kia paingia e te rangatira;</para>
  <para style="q2" vid="PRO 29:26">otiia i ahu mai i a Ihowā te whakawā mō te tangata.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />He mea whakarihariha ki te hunga tika te tangata whakahaere hē;</para>
  <para style="q2" vid="PRO 29:27">ā, he mea whakarihariha hoki ki te tangata kino te tangata he tika tōna ara.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">Ngā Whakatauki a Akuru</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Ko ngā kupu a Akuru tama a Iakehe; ko te poropititanga.</para>
  <para style="q1" vid="PRO 30:1">I kōrero taua tangata ki a Itiere,</para>
  <para style="q2" vid="PRO 30:1">ki a Itiere rāua ko Ukara:<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />He pono ko ahau te mea pōauau rawa o ngā tāngata,</para>
  <para style="q2" vid="PRO 30:2">kāhore hoki he mātauranga tangata i roto i ahau.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Kīhai hoki ahau i whakaakona ki te whakaaro nui,</para>
  <para style="q2" vid="PRO 30:3">kīhai anō i mōhio ki te Mea Tapu.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Ko wai kua piki atu ki te rangi, ā, heke mai ai anō?</para>
  <para style="q2" vid="PRO 30:4">Ko wai kua pūpū i te hau ki roto ki ōna ringa?</para>
  <para style="q1" vid="PRO 30:4">Nā wai i takai ngā wai ki roto ki tōna kākahu?</para>
  <para style="q2" vid="PRO 30:4">Nā wai i whakapūmau ngā pito katoa o te whenua?</para>
  <para style="q1" vid="PRO 30:4">Ko wai tōna ingoa,</para>
  <para style="q2" vid="PRO 30:4">ā, ko wai hoki te ingoa o tāna tama?</para>
  <para style="q2" vid="PRO 30:4">Ki te mōhiotia e koe!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Ko ngā kupu katoa a te Atua he mea whakamātau;</para>
  <para style="q2" vid="PRO 30:5">he whakangungu rākau ia ki te hunga katoa e whakawhirinaki ana ki a ia.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Kaua e tāpiritia ētahi kupu ki āna,</para>
  <para style="q2" vid="PRO 30:6">kei rīria e ia tōu hē, ā, ka kitea koe he tangata kōrero teka.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />E rua ngā mea kua īnoia e ahau i a koe;</para>
  <para style="q2" vid="PRO 30:7">kaua ēnā e kaiponuhia i ahau i mua i tōku matenga:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Whakamataratia atu i ahau te horihori me te kōrero teka;</para>
  <para style="q2" vid="PRO 30:8">kaua e hōmai te rawakore ki ahau, te taonga rānei;</para>
  <para style="q2" vid="PRO 30:8">whāngaia ahau ki te kai e rite ana māku.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Kei mākona ahau, ā, ka whakakāhore ki a koe,</para>
  <para style="q2" vid="PRO 30:9">ka mea, “Ko wai a Ihowā?”</para>
  <para style="q1" vid="PRO 30:9">Kei rawakore rānei ahau, ā, ka whānako,</para>
  <para style="q2" vid="PRO 30:9">ka whakahua noa hoki i te ingoa o tōku Atua.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Kaua e kōrerotia te pononga ki tōna ariki,</para>
  <para style="q2" vid="PRO 30:10">kei kanga ia i a koe, ā, ko koe e hē.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Tērā te whakatupuranga, he kanga tā rātou i tō rātou pāpā,</para>
  <para style="q2" vid="PRO 30:11">kāhore hoki e manaaki i tō rātou whaea.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Tērā te whakatupuranga, he mā ki tā rātou nā titiro,</para>
  <para style="q2" vid="PRO 30:12">otirā kāhore anō kia horoia atu tō rātou paru.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Tērā te whakatupuranga, nā, te whakakake o ō rātou kanohi.</para>
  <para style="q2" vid="PRO 30:13">Kua whakarewaina ake hoki ō rātou kamo!<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Tērā te whakatupuranga, ko ō rātou niho ānō he hoari,</para>
  <para style="q2" vid="PRO 30:14">ko ō rātou niho pūrākau ānō he māripi,</para>
  <para style="q1" vid="PRO 30:14">hei horo i te hunga iti i runga i te whenua,</para>
  <para style="q2" vid="PRO 30:14">i ngā rawakore hoki i roto i ngā tāngata.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />E rua ngā tamāhine a te ngata,</para>
  <para style="q2" vid="PRO 30:15">ko tā rāua karanga, “Hōmai, hōmai.”</para>
  <para style="q1" vid="PRO 30:15">E toru ngā mea e kore rawa e mākona,</para>
  <para style="q2" vid="PRO 30:15">āe rā, e whā ngā mea e kore e kī, “Kāti”:<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />ko te rua tūpāpaku; ko te kōpū pakoko;</para>
  <para style="q2" vid="PRO 30:16">ko te whenua kīhai i pukuwaitia,</para>
  <para style="q2" vid="PRO 30:16">ā, ko te ahi e kore nei e kī, “Kāti!”<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Ko te kanohi e whakahī ana ki te pāpā,</para>
  <para style="q2" vid="PRO 30:17">e whakahāwea ana ki te whakarongo ki tōna whaea,</para>
  <para style="q1" vid="PRO 30:17">mā ngā raweni o te awaawa ia e tīkaro,</para>
  <para style="q2" vid="PRO 30:17">ā, mā ngā pī ēkara e kai.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />E toru ngā mea he whakamīharo rawa, e kore e taea e ahau,</para>
  <para style="q2" vid="PRO 30:18">āe rā, e whā kāhore e mōhiotia e ahau:<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />ko te huarahi o te ēkara i te rangi;</para>
  <para style="q2" vid="PRO 30:19">ko te huarahi o te nākahi i runga i te kāmaka;</para>
  <para style="q1" vid="PRO 30:19">ko te huarahi o te kaipuke i waenga moana;</para>
  <para style="q2" vid="PRO 30:19">ā, ko te huarahi o te tangata ki te kōtiro.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />He pērā anō te huarahi o te wahine pūremu:</para>
  <para style="q2" vid="PRO 30:20">ka kai ia, ā, ka horoi i tōna māngai,</para>
  <para style="q2" vid="PRO 30:20">ā, ka kī, “Kāhore āku mahi hē.”<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />E toru ngā mea e korikori ai te whenua;</para>
  <para style="q2" vid="PRO 30:21">ā, e whā, he mea e kore e manawanuitia e ia:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />ko te pononga ina whakakīngitia ia;</para>
  <para style="q2" vid="PRO 30:22">ko te wairangi hoki ina mākona i te taro;<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />ko te wahine whakarihariha ina whiwhi i te tāne;</para>
  <para style="q2" vid="PRO 30:23">ā, ko te pononga wahine ina tuku iho māna ngā mea a tōna rangatira.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />E whā ngā mea ririki i runga i te whenua,</para>
  <para style="q2" vid="PRO 30:24">he nui noa atu ia ngā whakaaro:<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />ko ngā pōpokorua ehara i te iwi kaha,</para>
  <para style="q2" vid="PRO 30:25">heoi e mea ana i te kai mā rātou i te raumati;<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />ko ngā koni, he iwi ngoikore,</para>
  <para style="q2" vid="PRO 30:26">heoi e hanga ana i ō rātou whare ki te kāmaka;<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />ko ngā māwhitiwhiti, kāhore ō rātou kīngi,</para>
  <para style="q2" vid="PRO 30:27">heoi haere rōpū ana rātou katoa;<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />ko te mokomoko, ko ōna peke hei pupuri māna;</para>
  <para style="q2" vid="PRO 30:28">otiia kei roto ia i ngā whare kīngi.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />E toru ngā mea, he tau tā rātou hīkoi,</para>
  <para style="q2" vid="PRO 30:29">āe rā, e whā he huatau ki te haere:<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />ko te raiona, ko te mea kaha rawa o ngā kararehe,</para>
  <para style="q2" vid="PRO 30:30">e kore nei e tahuri mai i te aroaro o tētahi;<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />ko te kurī horo; ko te koati toa anō hoki;</para>
  <para style="q2" vid="PRO 30:31">ā, ko te kīngi, kāhore nei tētahi e maranga ake ki a ia.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Ki te mea he mahi kūware tau i a koe i whakaneke ake ai i a koe,</para>
  <para style="q2" vid="PRO 30:32">ki te mea rānei i whakaaro kino koe,</para>
  <para style="q2" vid="PRO 30:32">kōpania tōu ringa ki tōu māngai.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />He pono hoki ki te hurihia te waiū ka puta mai he pata,</para>
  <para style="q2" vid="PRO 30:33">ā, ki te kōwiria te ihu ka puta mai he toto;</para>
  <para style="q2" vid="PRO 30:33">waihoki ki te ākina te riri ka puta he whawhai.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">He Tohutohu ki tētahi Kīngi</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Ko ngā kupu a Kīngi Remuera; ko te poropititanga i whakaakona ai ia e tōna whaea:<verse eid="PRO 31:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />He aha, e tāku tama? He aha, e te tama a tōku kōpū?</para>
  <para style="q2" vid="PRO 31:2">Ā, he aha, e te tama a āku kupu taurangi?<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Kaua e hoatu tōu kaha ki ngā wāhine,</para>
  <para style="q2" vid="PRO 31:3">ōu ara hoki ki te mea whakangaro o ngā kīngi.<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Ehara mā ngā kīngi, e Remuera,</para>
  <para style="q2" vid="PRO 31:4">ehara mā ngā kīngi te inu wāina;</para>
  <para style="q2" vid="PRO 31:4">ehara hoki mā ngā rangatira te mea, “Kei hea he wai kaha?”<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Kei inu rātou, ā, ka wareware ki te ture,</para>
  <para style="q2" vid="PRO 31:5">ā, ka whakapeau kē i te whakawā o te tangata e tūkinotia ana.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Hoatu he wai kaha mā te tangata e tata ana te marere,</para>
  <para style="q2" vid="PRO 31:6">he wāina hoki ki ngā wairua pōuri;<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />tukua ia kia inu, kia wareware ai ki tōna rawakore,</para>
  <para style="q2" vid="PRO 31:7">ā, kore ake he mahara ki ōna mate.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Kia puaki tōu māngai mō te wahangū,</para>
  <para style="q2" vid="PRO 31:8">i te whakawākanga o te hunga katoa kua waiho mō te mate.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Kia puaki tōu māngai, whakaritea te whakawā i runga i te tika,</para>
  <para style="q2" vid="PRO 31:9">tohea te tohe a te ware, a te rawakore.<verse eid="PRO 31:9" /></para>
  <para style="b" />
  <para style="s">Te Wahine Pai Tōna Āhua</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Ko wai e kite i te wahine e ū ana tōna pai?</para>
  <para style="q2" vid="PRO 31:10">Ko tōna utu hoki kei runga noa atu i tō ngā rupi.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Ka whakapono te ngākau o tāna tāne ki a ia,</para>
  <para style="q2" vid="PRO 31:11">ā, kāhore ōna hapanga i te taonga.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />He pai tāna e mea ai ki a ia, kāhore hoki he kino,</para>
  <para style="q2" vid="PRO 31:12">i ngā rā katoa e ora ai ia.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />E kimi ana ia i te huruhuru hipi, i te muka,</para>
  <para style="q2" vid="PRO 31:13">ā, ka ngākau nui te mahi a ōna ringa.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Ko tōna rite kei ngā kaipuke o ngā kaihokohoko;</para>
  <para style="q2" vid="PRO 31:14">e mauria mai ana e ia tāna kai i tawhiti.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />E maranga ana hoki ia i te mea e pō tonu ana,</para>
  <para style="q2" vid="PRO 31:15">ā, hoatu ana e ia he kai mā tōna whare,</para>
  <para style="q2" vid="PRO 31:15">he mahi hoki e rite ana mā āna kōtiro.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />E whakaaroaro ana ia ki tētahi māra, ā, ka hokona e ia;</para>
  <para style="q2" vid="PRO 31:16">whakatōkia ana e ia he māra wāina, he hua nā ōna ringa.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />E whītiki ana ia i tōna hope ki te kaha,</para>
  <para style="q2" vid="PRO 31:17">e mea ana i ōna tākakau kia pakari.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Ka kite ia he pai tāna i hokohoko ai;</para>
  <para style="q2" vid="PRO 31:18">e kore tāna rama e mate i te pō.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Ka totoro atu ōna ringa ki te mea tākai miro,</para>
  <para style="q2" vid="PRO 31:19">ka pupuri ōna ringa ki te pou muka.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Ka wherahia tōna ringa ki te ware;</para>
  <para style="q2" vid="PRO 31:20">āe rā, ka totoro atu ōna ringa ki te rawakore.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />E kore ia e wehi i te hukarere mō tōna whare;</para>
  <para style="q2" vid="PRO 31:21">nō te mea kua kākahuria tōna whare katoa ki te ngangana.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Oti ake i a ia te whatuwhatu he whāriki mōna;</para>
  <para style="q2" vid="PRO 31:22">he rīnena pai, he pāpura ōna kākahu.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />E mōhiotia ana tāna tāne i ngā kūwaha,</para>
  <para style="q2" vid="PRO 31:23">ina noho tahi ia ki ngā kaumātua o te whenua.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />E hangā ana e ia he rīnena pai, ā, hokona atu ana;</para>
  <para style="q2" vid="PRO 31:24">e hoatu ana e ia he whītiki ki ngā kaihoko.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />He kaha, he hōnore ōna kākahu;</para>
  <para style="q2" vid="PRO 31:25">ā, e kata ana ia ki ngā rā ō muri atu.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />He nui ōna whakaaro ina puaki tōna māngai;</para>
  <para style="q2" vid="PRO 31:26">kei tōna arero te ture o te atawhai.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Ka āta tirohia e ia ngā ara o tōna whare,</para>
  <para style="q2" vid="PRO 31:27">e kore anō ia e kai i te taro o te māngere.<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />Ka whakatika āna tamariki, ā, he kupu manaaki tā rātou mōna;</para>
  <para style="q2" vid="PRO 31:28">tāna tāne hoki, ka whakamoemiti anō ia ki a ia, ka mea:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“He tokomaha ngā tamāhine i ū te pai o tā rātou mahi,</para>
  <para style="q2" vid="PRO 31:29">otiia, hira ake tāu i ā rātou katoa.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />He mea teka noa te manako, he mea horihori te ātaahua;</para>
  <para style="q2" vid="PRO 31:30">tēnā ko te wahine e wehi ana i a Ihowā, ko ia e whakamoemititia.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Hoatu ki a ia o ngā hua o ōna ringa;</para>
  <para style="q2" vid="PRO 31:31">ā, mā āna mahi ia e whakamoemiti i ngā kūwaha.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>