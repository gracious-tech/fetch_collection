<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">sng.txt Māori macronized text, extracted 16-05-06</book>
  <para style="h">Waiata a Horomona</para>
  <para style="toc3">Waih</para>
  <para style="mt2">Ko te</para>
  <para style="mt1">Waiata a Horomona</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Ko te waiata o ngā waiata, ko tā Horomona.<verse eid="SNG 1:1" /></para>
  <para style="s">He Pai atu te Aroha i te Wāina</para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Kia kihia ahau e ia ki ngā kihi a tōna māngai!</para>
  <para style="q1" vid="SNG 1:2">He pai atu hoki tōu aroha i te wāina.<verse eid="SNG 1:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="SNG 1:3" />He kakara pai tō ōu hinu;</para>
  <para style="q1" vid="SNG 1:3">ko tōu ingoa ānō he hinu kua oti te riringi;</para>
  <para style="q2" vid="SNG 1:3">nā reira i aroha ai ngā wāhina ki a koe.<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Kūmea ahau; ka rere atu mātou, ka whai i a koe;</para>
  <para style="q2" vid="SNG 1:4">kua oti ahau te kawe e te kīngi ki ōna rūma.</para>
  <para style="sp" vid="SNG 1:4">Ngā Hoa</para>
  <para style="q1" vid="SNG 1:4">Ka koa mātou, ka hari ki a koe;</para>
  <para style="q2" vid="SNG 1:4">engari tōu aroha i te wāina hei maharatanga atu mā mātou.</para>
  <para style="q2" vid="SNG 1:4">E tika ana tō rātou aroha ki a koe!<verse eid="SNG 1:4" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />He mangu ahau, otiia he ātaahua anō,</para>
  <para style="q2" vid="SNG 1:5">e ngā tamāhine o Hiruhārama,</para>
  <para style="q1" vid="SNG 1:5">rite tonu anō ki ngā tēneti o Kerara,</para>
  <para style="q2" vid="SNG 1:5">ki ngā kākahu tauārai o Horomona.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />Kaua e titiro mai ki ahau, nō te mea he parauri ahau,</para>
  <para style="q2" vid="SNG 1:6">nō te mea kua tahuna ahau e te rā.</para>
  <para style="q1" vid="SNG 1:6">I riri ngā tama a tōku whaea ki ahau,</para>
  <para style="q2" vid="SNG 1:6">meinga ana ahau e rātou hei kaitiaki mō ngā māra wāina;</para>
  <para style="q2" vid="SNG 1:6">ko tāku māra ia, ko tāku ake, kīhai i tiakina e ahau.<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />Whakaaturia mai ki ahau, e tā tōku wairua e aroha nei,</para>
  <para style="q2" vid="SNG 1:7">ko hea koe whāngai ai,</para>
  <para style="q2" vid="SNG 1:7">ko hea koe mea ai i tāu kāhui kia takoto i te poutūmārōtanga.</para>
  <para style="q1" vid="SNG 1:7">Kia rite ahau hei aha ki te māhunga taupoki</para>
  <para style="q2" vid="SNG 1:7">i te taha o ngā kāhui a ōu hoa?<verse eid="SNG 1:7" /></para>
  <para style="sp">Ngā Hoa</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />Ki te kore koe e mōhio,</para>
  <para style="q2" vid="SNG 1:8">e te mea ātaahua rawa o ngā wāhine,</para>
  <para style="q1" vid="SNG 1:8">haere atu i runga i ngā takahanga o ngā hipi,</para>
  <para style="q2" vid="SNG 1:8">ka whāngai i āu kūao koati</para>
  <para style="q2" vid="SNG 1:8">i te taha o ngā nohoanga o ngā hēpara.<verse eid="SNG 1:8" /></para>
  <para style="s">Te Kōrerorero a te Tāne me te Wahine me ngā Hoa</para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />Kua whakaritea koe e ahau, e tāku e aroha nei,</para>
  <para style="q2" vid="SNG 1:9">ki tētahi o ngā hōiho o ngā hāriata o Parao.<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />He ātaahua ōu pāpāringa i ngā whiri o ngā makawe,</para>
  <para style="q2" vid="SNG 1:10">tōu kakī i ngā tautau o ngā mea whakapaipai.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />Ka hangā e mātou ētahi mekameka kōura mōu,</para>
  <para style="q2" vid="SNG 1:11">he mea tia ki te hiriwa.<verse eid="SNG 1:11" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />I te kīngi e noho ana i tōna tēpu,</para>
  <para style="q2" vid="SNG 1:12">ka puta te kakara o tōku nara.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Ko te rite ki ahau o tāku e aroha nei kei te paihere maira,</para>
  <para style="q2" vid="SNG 1:13">e takoto nei i waenganui i ōku ū.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />He tautau hena ki ahau tāku e aroha nei,</para>
  <para style="q2" vid="SNG 1:14">i ngā māra wāina o Enekeri.<verse eid="SNG 1:14" /></para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />Nanā, he ātaahua koe, e tāku e aroha nei;</para>
  <para style="q2" vid="SNG 1:15">nanā, he purotu koe;</para>
  <para style="q2" vid="SNG 1:15">ko ōu kanohi kei te kūkupa.<verse eid="SNG 1:15" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Nanā, he ātaahua koe, e tāku kaingākau,</para>
  <para style="q2" vid="SNG 1:16">āe rā, he āhuareka.</para>
  <para style="q1" vid="SNG 1:16">Matomato tonu anō hoki tō tāua moenga;<verse eid="SNG 1:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="SNG 1:17" />he hīta ngā kurupae o tō tāua whare,</para>
  <para style="q2" vid="SNG 1:17">he kauri ngā heke.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />He puāwai ahau nō Harono,</para>
  <para style="q2" vid="SNG 2:1">he rengarenga nō ngā awaawa.<verse eid="SNG 2:1" /></para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />He rengarenga i roto i ngā tātarāmoa,</para>
  <para style="q2" vid="SNG 2:2">ko tāku e aroha nei i waenga i ngā tamāhine.<verse eid="SNG 2:2" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />Kei te āporo i roto i ngā rākau o te ngahere</para>
  <para style="q2" vid="SNG 2:3">te rite o tāku kaingākau i roto i ngā taitamariki.</para>
  <para style="q1" vid="SNG 2:3">Āhuareka ana tāku noho iho i raro i tōna taumarumarutanga,</para>
  <para style="q2" vid="SNG 2:3">ā, he reka āna hua ki tōku ngao.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />I kawea ahau e ia ki te whare hākari,</para>
  <para style="q2" vid="SNG 2:4">ā, ko tōna kara i runga i ahau he aroha.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Whakakahangia ake ahau ki te karepe whakamaroke,</para>
  <para style="q2" vid="SNG 2:5">whakahauorangia ahau ki te āporo;</para>
  <para style="q2" vid="SNG 2:5">e mate ana hoki ahau i te aroha.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Kei raro i tōku māhunga tōna mauī,</para>
  <para style="q2" vid="SNG 2:6">e awhi ana tōna matau i ahau.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />He kī tēnei nāku ki a koutou, e ngā tamāhine o Hiruhārama,</para>
  <para style="q2" vid="SNG 2:7">i te aroaro anō o ngā anaterope, o ngā hāta o te pārae:</para>
  <para style="q1" vid="SNG 2:7">kaua e whakaohokia, kaua e whakaarahia tāku e aroha nei,</para>
  <para style="q2" vid="SNG 2:7">ā kia pai rā anō ia.<verse eid="SNG 2:7" /></para>
  <para style="s">Kua Pahemo te Hōtoke</para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Ko te reo rā o tāku e aroha nei!</para>
  <para style="q2" vid="SNG 2:8">Nanā, te haere mai nei ia,</para>
  <para style="q1" vid="SNG 2:8">e tūpekepeke ana i runga i ngā maunga,</para>
  <para style="q2" vid="SNG 2:8">e mokowhiti ana i runga i ngā pukepuke.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Rite tonu tāku e aroha nei ki te anaterope,</para>
  <para style="q2" vid="SNG 2:9">ki te kūao hāta rānei.</para>
  <para style="q1" vid="SNG 2:9">Tēnei ia te tū mai nei</para>
  <para style="q2" vid="SNG 2:9">i muri o tō mātou taiepa,</para>
  <para style="q1" vid="SNG 2:9">e mātakitaki mai ana i ngā matapihi,</para>
  <para style="q2" vid="SNG 2:9">e whakaata mai ana rā roto i te mea rīpekapeka.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />I kōrero mai tāku e aroha nei, i mea mai ki ahau:</para>
  <para style="q1" vid="SNG 2:10">“E ara, e tāku ipo, e tāku mea ātaahua,</para>
  <para style="q2" vid="SNG 2:10">ka haere mai.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Nanā, kua pahemo te hōtoke,</para>
  <para style="q2" vid="SNG 2:11">kua mutu te ua, kua kore.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Kua puta ngā puāwai ki te whenua;</para>
  <para style="q2" vid="SNG 2:12">kua tata te wā e korihi ai ngā manu,</para>
  <para style="q1" vid="SNG 2:12">ā, e rangona ana te reo o te kūkupa</para>
  <para style="q2" vid="SNG 2:12">ki tō tātou whenua.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Kua kōpuku ngā hua hou o te piki,</para>
  <para style="q2" vid="SNG 2:13">kua puaka ngā wāina, e kakara mai nei.</para>
  <para style="q1" vid="SNG 2:13">Maranga, e tōku hoa, e tāku mea ātaahua,</para>
  <para style="q2" vid="SNG 2:13">haere mai hoki.”<verse eid="SNG 2:13" /></para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />E tāku kūkupa i roto i ngā kapiti o te kāmaka,</para>
  <para style="q2" vid="SNG 2:14">i te wāhi ngaro o te pikitanga,</para>
  <para style="q1" vid="SNG 2:14">kia kite ahau i tōu āhua, kia rongo ahau i tōu reo;</para>
  <para style="q2" vid="SNG 2:14">he reka hoki tōu reo, he ātaahua tōu mata.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />Hopukia mai mā tāua ngā pokiha,</para>
  <para style="q2" vid="SNG 2:15">ngā pokiha ririki</para>
  <para style="q1" vid="SNG 2:15">e takakino nei i ā tāua māra wāina;</para>
  <para style="q2" vid="SNG 2:15">kua puāwai hoki ā tāua wāina.<verse eid="SNG 2:15" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Nāku tāku kaingākau, nāna hoki ahau;</para>
  <para style="q2" vid="SNG 2:16">kei waenga ia i ngā rengarenga e whāngai ana i tāna kāhui.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />I te mea kīanō i mātao te rā,</para>
  <para style="q2" vid="SNG 2:17">ā, kīanō i rere noa ngā ātārangi,</para>
  <para style="q1" vid="SNG 2:17">tahuri mai, e tāku e aroha nei,</para>
  <para style="q2" vid="SNG 2:17">kia rite koe ki te anaterope,</para>
  <para style="q1" vid="SNG 2:17">ki te kūao hāta,</para>
  <para style="q2" vid="SNG 2:17">i ngā maunga o Pētere.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="s">Te Moemoeā o te Aroha</para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />I te pō, i runga i tōku moenga,</para>
  <para style="q2" vid="SNG 3:1">i rapua e ahau tā tōku wairua i aroha ai;</para>
  <para style="q2" vid="SNG 3:1">i rapua e ahau, heoi kīhai i kitea.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Ka mea ahau, “Ka whakatika ahau āianei, ka kōpikopiko i roto i te pā,</para>
  <para style="q2" vid="SNG 3:2">i ngā huarahi, i ngā waharoa,</para>
  <para style="q1" vid="SNG 3:2">ka rapu i tā tōku wairua i aroha ai.”</para>
  <para style="q2" vid="SNG 3:2">Rapua ana ia e ahau, heoi kīhai i kitea.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />I tūtaki ki ahau ngā kaitiaki</para>
  <para style="q2" vid="SNG 3:3">e kōpikopiko nei i roto i te pā.</para>
  <para style="q1" vid="SNG 3:3">“Anō rā ko ahau ki a rātou,</para>
  <para style="q2" vid="SNG 3:3">i kite rānei koutou i tā tōku wairua e aroha nei?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Pahemo kau atu rātou,</para>
  <para style="q2" vid="SNG 3:4">kua tūtaki ahau ki tā tōku wairua e aroha nei.</para>
  <para style="q1" vid="SNG 3:4">Kei te pupuri ahau i a ia, kīhai hoki ia i tukua atu e ahau,</para>
  <para style="q2" vid="SNG 3:4">ā kawea noatia atu ia e ahau ki te whare o tōku whaea,</para>
  <para style="q2" vid="SNG 3:4">ki te rūma o te wahine i whānau ai ahau.<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />He kī tēnei nāku ki a koutou, e ngā tamāhine o Hiruhārama,</para>
  <para style="q2" vid="SNG 3:5">i te aroaro o ngā anaterope, o ngā hāta o te pārae:</para>
  <para style="q1" vid="SNG 3:5">kaua e whakaoho, kaua e whakaara i tāku e aroha nei,</para>
  <para style="q2" vid="SNG 3:5">kia pai rā anō ia.<verse eid="SNG 3:5" /></para>
  <para style="s">Te Whakatata mai o te Tāne me ōna Hoa</para>
  <para style="sp">Ngā Hoa</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Ko wai tēnei e whakaputa mai nei i te koraha,</para>
  <para style="q2" vid="SNG 3:6">ānō ko ngā pou paowa,</para>
  <para style="q1" vid="SNG 3:6">kakara tonu i te maira, i te parakihe,</para>
  <para style="q2" vid="SNG 3:6">i ngā puehu katoa a te kaihoko?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Nanā, ko te amo o Horomona;</para>
  <para style="q2" vid="SNG 3:7">e toru tekau ngā tāngata mārohirohi i tētahi taha,</para>
  <para style="q2" vid="SNG 3:7">i tētahi taha, nō ngā mārohirohi o Īharaira.<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />He hunga mau hoari rātou katoa,</para>
  <para style="q2" vid="SNG 3:8">he mea whakaako ki te whawhai;</para>
  <para style="q1" vid="SNG 3:8">kei tōna hūwhā anō te hoari a tēnei, a tēnei,</para>
  <para style="q2" vid="SNG 3:8">i te wehi hoki i te pō.<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />I hangā e Kīngi Horomona he amo mōna,</para>
  <para style="q2" vid="SNG 3:9">nō Repanōna te rākau.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Ko ōna pou i hangā e ia ki te hiriwa,</para>
  <para style="q2" vid="SNG 3:10">he kōura a raro, he pāpura tōna nohoanga,</para>
  <para style="q1" vid="SNG 3:10">he mea whāriki a waenganui ki te aroha,</para>
  <para style="q2" vid="SNG 3:10">nō ngā tamāhine o Hiruhārama.<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />Haere, e ngā tamāhine o Hiona,</para>
  <para style="q2" vid="SNG 3:11">ka mātakitaki i a Kīngi Horomona,</para>
  <para style="q1" vid="SNG 3:11">me te karauna anō i karaunatia ai ia e tōna whaea</para>
  <para style="q2" vid="SNG 3:11">i te rā o tōna mārenatanga,</para>
  <para style="q2" vid="SNG 3:11">i te rā hoki i koa ai tōna ngākau.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="s">Te Ātaahua Hoki o te Wāhine Mārena</para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />Nanā, he ātaahua koe, e tōku hoa;</para>
  <para style="q2" vid="SNG 4:1">nanā, he ātaahua koe!</para>
  <para style="q1" vid="SNG 4:1">Nō ngā kūkupa ōu kanohi</para>
  <para style="q2" vid="SNG 4:1">i muri i tōu ārai.</para>
  <para style="q1" vid="SNG 4:1">Ko ōu makawe, koia anō kei te kāhui koati e takoto</para>
  <para style="q2" vid="SNG 4:1">haere ana i te taha o Maunga Kireara.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />Ko ōu niho, ānō he kāhui hipi uha</para>
  <para style="q2" vid="SNG 4:2">kātahi tonu ka oti te kutikuti,</para>
  <para style="q2" vid="SNG 4:2">i haere mai i te horoi;</para>
  <para style="q1" vid="SNG 4:2">rite katoa rātou i te māhanga,</para>
  <para style="q2" vid="SNG 4:2">kāhore hoki he mea pakoro i roto i a rātou.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Ko ōu ngutu, ānō he aho ngangana,</para>
  <para style="q2" vid="SNG 4:3">āhuareka ana tōu māngai.</para>
  <para style="q1" vid="SNG 4:3">Rite tonu ki tētahi wāhi o te pamekaranete</para>
  <para style="q2" vid="SNG 4:3">ōu rahirahinga i muri i tōu ārai.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />Rite tonu tōu kakī ki te Pourewa o Rāwiri,</para>
  <para style="q2" vid="SNG 4:4">he mea i hangā hei iringa mō ngā patu,</para>
  <para style="q1" vid="SNG 4:4">kei reira nei ngā whakangungu rākau kotahi mano e iri ana,</para>
  <para style="q2" vid="SNG 4:4">ko ngā whakapuru tao katoa a te hunga mārohirohi.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />Ko ōu ū e rua rite tonu ki ngā kūao e rua,</para>
  <para style="q2" vid="SNG 4:5">he māhanga nā ngā anaterope,</para>
  <para style="q2" vid="SNG 4:5">e kai ana i waenga i ngā rengarenga.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />I te mea kīanō i mātao noa te rā,</para>
  <para style="q2" vid="SNG 4:6">ā, kīanō i rere noa ngā ātārangi,</para>
  <para style="q1" vid="SNG 4:6">ka haere ahau ki te maunga maira,</para>
  <para style="q2" vid="SNG 4:6">ki te pukepuke parakihe.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />He ātaahua katoa koe, e tōku hoa;</para>
  <para style="q2" vid="SNG 4:7">kāhore hoki ōu koha.<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Tāua ka haere atu i Repanōna, e tōku hoa,</para>
  <para style="q2" vid="SNG 4:8">tāua atu i Repanōna.</para>
  <para style="q1" vid="SNG 4:8">Mātakitaki ai i te tihi o Amana,</para>
  <para style="q2" vid="SNG 4:8">i te tihi o Heniri rāua ko Heremona,</para>
  <para style="q1" vid="SNG 4:8">i te nohoanga o ngā raiona,</para>
  <para style="q2" vid="SNG 4:8">i ngā maunga o ngā reparo.<verse eid="SNG 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Riro pū tōku ngākau i a koe, e tōku tuahine, e tōku hoa;</para>
  <para style="q2" vid="SNG 4:9">riro pū tōku ngākau i tētahi o ōu kanohi,</para>
  <para style="q2" vid="SNG 4:9">i tētahi o ngā mekameka whakapaipai o tōu kakī.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />Anō te ātaahua o tōu aroha, e tōku tuahine, e tōku hoa,</para>
  <para style="q2" vid="SNG 4:10">Anō te pai o tōu aroha, nui atu i te wāina!</para>
  <para style="q2" vid="SNG 4:10">Ko te kakara hoki o ōu hinu, nui atu i ngā kīnaki kakara katoa.<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />He honi kei ōu ngutu, e tōku hoa, e māturuturu ana;</para>
  <para style="q2" vid="SNG 4:11">he honi, he waiū kei raro i tōu arero;</para>
  <para style="q1" vid="SNG 4:11">ko te kakara hoki o ōu kākahu,</para>
  <para style="q2" vid="SNG 4:11">koia anō kei te kakara o Repanōna!<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />He kāri kua oti te tūtaki tōku tuahine, tōku hoa;</para>
  <para style="q2" vid="SNG 4:12">he manawa-whenua kua oti te pāpuni, he puna kua oti te hīri.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Ko ngā mea e wana ana i a koe he kāri pamekaranete,</para>
  <para style="q2" vid="SNG 4:13">he pai whakarere ngā hua;</para>
  <para style="q2" vid="SNG 4:13">he hena, he rākau nara,<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />he nara, he hapirone, he karamu, he hinamona,</para>
  <para style="q2" vid="SNG 4:14">me ngā rākau parakihe katoa;</para>
  <para style="q1" vid="SNG 4:14">he maira, he aroe,</para>
  <para style="q2" vid="SNG 4:14">me ngā mea nui katoa o ngā kīnaki kakara.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />He puna koe nō ngā kāri, he poka wai ora,</para>
  <para style="q2" vid="SNG 4:15">he awa totō mai hoki nō Repanōna.<verse eid="SNG 4:15" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />E ara, e te hauraro;</para>
  <para style="q2" vid="SNG 4:16">haere mai hoki, e te tonga!</para>
  <para style="q1" vid="SNG 4:16">Pupuhi mai ki tāku kāri,</para>
  <para style="q2" vid="SNG 4:16">kia rere ai ngā kīnaki kakara ki waho.</para>
  <para style="q1" vid="SNG 4:16">Tukua tāku e aroha nei kia haere mai ki tāna kāri,</para>
  <para style="q2" vid="SNG 4:16">ki te kai i āna hua pai.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />Kua tae mai ahau ki tāku kāri, e tōku tuahine, e tōku hoa;</para>
  <para style="q2" vid="SNG 5:1">kua oti tāku maira me tāku kīnaki kakara te kohi,</para>
  <para style="q2" vid="SNG 5:1">kua kainga e ahau tāku honikoma me tāku honi;</para>
  <para style="q2" vid="SNG 5:1">kua inumia e ahau tāku wāina me tāku waiū.</para>
  <para style="sp" vid="SNG 5:1">Ngā Hoa</para>
  <para style="q1" vid="SNG 5:1">E kai, e ōku hoa; e inu,</para>
  <para style="q2" vid="SNG 5:1">inā, kia nui te inu, e tāku e aroha nei.<verse eid="SNG 5:1" /></para>
  <para style="s">He Moemoeā anō</para>
  <para style="sp">Te Wahine</para>
  <para style="p">
    <verse number="2" style="v" sid="SNG 5:2" />I te moe ahau, ko tōku ngākau ia i te oho.</para>
  <para style="q1" vid="SNG 5:2">Ko te reo tēnei o tāku e aroha nei e pātuki ana,</para>
  <para style="q2" vid="SNG 5:2">e mea ana, “Te tatau ki ahau, e tōku tuahine, e tōku hoa,</para>
  <para style="q2" vid="SNG 5:2">e tāku kūkupa, e tāku mea pokekore;</para>
  <para style="q1" vid="SNG 5:2">kī tonu hoki tōku māhunga i te tōmairangi,</para>
  <para style="q2" vid="SNG 5:2">ōku makawe anō hoki i ngā kōpata o te pō.”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Kua oti tōku koti te unu e ahau;</para>
  <para style="q2" vid="SNG 5:3">me pēhea e kākahuria ai anō?</para>
  <para style="q1" vid="SNG 5:3">Kua oti ōku waewae te horoi;</para>
  <para style="q2" vid="SNG 5:3">kia whakaparua anō koia e ahau?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />I kuhua mai tōna ringa e tāku e aroha nei i te kōhao o te tatau,</para>
  <para style="q2" vid="SNG 5:4">ā, oho ana tōku manawa mōna.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />I ara atu ahau ki te uaki i te tatau ki tāku i aroha ai;</para>
  <para style="q2" vid="SNG 5:5">māturuturu ana te maira i ōku ringa,</para>
  <para style="q1" vid="SNG 5:5">te maira waiwai i ōku maihao</para>
  <para style="q2" vid="SNG 5:5">ki ngā puritanga o te tūtaki.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Uakina ana e ahau ki tāku i aroha ai;</para>
  <para style="q2" vid="SNG 5:6">heoi kua maunu atu tāku i aroha ai, ā, kua riro.</para>
  <para style="q1" vid="SNG 5:6">Tōku wairua riro pū i tāna kupu.</para>
  <para style="q1" vid="SNG 5:6">I rapu ahau i a ia, heoi kīhai i kitea;</para>
  <para style="q2" vid="SNG 5:6">i karangatia atu ia e ahau, kīhai anō ia i whakahoki kupu mai.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />I tūtaki ki ahau ngā kaitiaki e kōpikopiko nei i te pā;</para>
  <para style="q2" vid="SNG 5:7">patua ana ahau e rātou, mamae ana ahau i a rātou;</para>
  <para style="q1" vid="SNG 5:7">tangohia ana tōku hīpoki i ahau</para>
  <para style="q2" vid="SNG 5:7">e ngā kaitiaki o ngā taiepa.<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />He kī atu tēnei nāku ki a koutou, e ngā tamāhine o Hiruhārama,</para>
  <para style="q2" vid="SNG 5:8">ki te tūtaki koutou ki tāku e aroha nei,</para>
  <para style="q1" vid="SNG 5:8">kī atu ki a ia:</para>
  <para style="q2" vid="SNG 5:8">“E mate ana ahau i te aroha.”<verse eid="SNG 5:8" /></para>
  <para style="s">Te Whakawhiti Kōrero a ngā Hoa me te Wahine Mārena</para>
  <para style="sp">Ngā Hoa</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />E te wahine ātaahua rawa o ngā wāhine,</para>
  <para style="q2" vid="SNG 5:9">he aha te nuinga ake o tāu i aroha ai i tētahi atu e arohaina ana?</para>
  <para style="q1" vid="SNG 5:9">He aha te nuinga ake o tāu i aroha ai i tētahi atu e arohaina ana,</para>
  <para style="q2" vid="SNG 5:9">i pēnā ai tāu kī mai ki a mātou?<verse eid="SNG 5:9" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />He mā tāku i aroha ai, he kiri wherowhero,</para>
  <para style="q2" vid="SNG 5:10">ko te mea nui rawa o ngā mano kotahi tekau.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Ko tōna māhunga kei te tino kōura, he mea parakore,</para>
  <para style="q2" vid="SNG 5:11">ko ōna makawe he māwhatu,</para>
  <para style="q2" vid="SNG 5:11">ā, mangu tonu, ānō he raweni.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Ko ōna kanohi kei o ngā kūkupa</para>
  <para style="q2" vid="SNG 5:12">i te taha o ngā awa wai,</para>
  <para style="q1" vid="SNG 5:12">he mea horoi ki te waiū,</para>
  <para style="q2" vid="SNG 5:12">pai rawa te whakanoho.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Ko ōna pāpāringa, ānō he tupuranga kīnaki kakara,</para>
  <para style="q2" vid="SNG 5:13">ānō he rārangi tarutaru reka.</para>
  <para style="q1" vid="SNG 5:13">Ko ōna ngutu, me te mea he rengarenga</para>
  <para style="q2" vid="SNG 5:13">e whakamāturu iho ana i te wai maira.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Ko ōna ringa, ānō he mōwhiti kōura</para>
  <para style="q2" vid="SNG 5:14">i whakanohoia he perira ki roto.</para>
  <para style="q1" vid="SNG 5:14">Ko tōna tinana, kei te rei pai rawa,</para>
  <para style="q2" vid="SNG 5:14">he mea whakakikorua ki te hāpira.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Ko ōna waewae, rite tonu ki te pou mapere,</para>
  <para style="q2" vid="SNG 5:15">he mea whakatū ki ngā tūranga kōura pai rawa.</para>
  <para style="q1" vid="SNG 5:15">Ko tōna āhua koia anō kei Repanōna,</para>
  <para style="q2" vid="SNG 5:15">me te hīta te tino pai rawa.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Ko tōna māngai he tino reka;</para>
  <para style="q2" vid="SNG 5:16">āe rā, he āhuareka katoa ia.</para>
  <para style="q1" vid="SNG 5:16">Ko tāku tēnei i aroha ai, ko tōku hoa anō tēnei,</para>
  <para style="q2" vid="SNG 5:16">e ngā tamāhine o Hiruhārama.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Ngā Hoa</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />Kua riro ki hea tāu e aroha nā,</para>
  <para style="q2" vid="SNG 6:1">e te wahine ātaahua rawa o ngā wāhine?</para>
  <para style="q1" vid="SNG 6:1">I anga ki hea tāu e aroha nā,</para>
  <para style="q2" vid="SNG 6:1">kia rapu tahi ai mātou me koe?<verse eid="SNG 6:1" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />Kua riro tāku e aroha nei ki raro, ki tāna kāri,</para>
  <para style="q2" vid="SNG 6:2">ki ngā tupuranga o ngā kīnaki kakara,</para>
  <para style="q1" vid="SNG 6:2">ki ngā kāri kai ai,</para>
  <para style="q2" vid="SNG 6:2">ki te kato i ngā rengarenga.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Nā tāku e aroha nei ahau, ā, nāku tāku e aroha nei;</para>
  <para style="q2" vid="SNG 6:3">kei ngā rengarenga ia e whāngai ana i tāna kāhui.<verse eid="SNG 6:3" /></para>
  <para style="s">Te Ātaahua Whakaharahara o te Wahine Mārena</para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />He ātaahua koe, e tōku hoa he pērā me Tirita;</para>
  <para style="q2" vid="SNG 6:4">he āhuareka koe, pērā me Hiruhārama,</para>
  <para style="q2" vid="SNG 6:4">he whakamataku pērā me te taua e tare ana ngā kara.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Tahuri atu ōu kanohi i ahau,</para>
  <para style="q2" vid="SNG 6:5">ka riro hoki ahau i a rāua.</para>
  <para style="q1" vid="SNG 6:5">Ko ōu makawe koia anō kei te kāhui koati</para>
  <para style="q2" vid="SNG 6:5">e takoto ana i te taha o Kireara.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Ko ōu niho ānō he kāhui hipi uha</para>
  <para style="q2" vid="SNG 6:6">e haere mai ana i te horoi,</para>
  <para style="q1" vid="SNG 6:6">rite katoa i te māhanga,</para>
  <para style="q2" vid="SNG 6:6">kāhore hoki he pakoro i roto i a rātou.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Rite tonu ki tētahi wāhi o te pamekaranete ōu rahirahinga</para>
  <para style="q2" vid="SNG 6:7">i muri i tōu ārai.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />E ono tekau ēnei kuīni, e waru tekau ngā wāhine iti,</para>
  <para style="q2" vid="SNG 6:8">me ngā wāhina e kore e taea te tatau.<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />Ko tāku kūkupa, ko tāku mea pokekore, he mea kotahi noa;</para>
  <para style="q2" vid="SNG 6:9">ko ia anake tā tōna whaea;</para>
  <para style="q2" vid="SNG 6:9">ko ia te mea i paingia rawatia e te wahine i whānau ai ia.</para>
  <para style="q1" vid="SNG 6:9">I kite ngā tamāhine i a ia, kei te manaaki i a ia;</para>
  <para style="q2" vid="SNG 6:9">āe rā, ko ngā kuīni me ngā wāhine iti,</para>
  <para style="q2" vid="SNG 6:9">whakamoemiti ana rātou ki a ia.<verse eid="SNG 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />“Ko wai tēnei e mātakitaki mai nei, ānō ko te ata,</para>
  <para style="q2" vid="SNG 6:10">ātaahua tonu ānō ko te marama, mārama rawa, koia anō kei te rā,</para>
  <para style="q2" vid="SNG 6:10">whakawehi rawa, me te mea he taua e tare ana ngā kara?”<verse eid="SNG 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />I haere atu ahau ki te kāri nati,</para>
  <para style="q2" vid="SNG 6:11">kia kite i ngā taru matomato o te awaawa;</para>
  <para style="q1" vid="SNG 6:11">kia kite e tupu ana rānei te wāina,</para>
  <para style="q2" vid="SNG 6:11">e kōpuku ana rānei ngā pamekaranete.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Mōhio rawa ake ahau kua meinga ahau e tōku wairua kia tau</para>
  <para style="q2" vid="SNG 6:12">ki waenga ki ngā hāriata o tōku iwi rangatira.<verse eid="SNG 6:12" /></para>
  <para style="sp">Ngā Hoa</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Hoki mai, hoki mai, e te Hurami!</para>
  <para style="q2" vid="SNG 6:13">Hoki mai, hoki mai, kia mātakitaki ai mātou ki a koe.</para>
  <para style="sp" vid="SNG 6:13">Te Tāne</para>
  <para style="q1" vid="SNG 6:13">He aha tā koutou e titiro ai ki te Hurami,</para>
  <para style="q2" vid="SNG 6:13">me te mea ko te haka o Mahanaima?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="s">He Whakapuaki Whakanui</para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />Anō te ātaahua o ōu waewae i roto i ōu hū,</para>
  <para style="q2" vid="SNG 7:1">e te tamāhine a te rangatira!</para>
  <para style="q1" vid="SNG 7:1">Ko ngā hononga o ōu hūhā, koia anō kei o ngā peara,</para>
  <para style="q2" vid="SNG 7:1">he mea hanga nā ngā ringa o te kaimahi mōhio.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Ko tōu pito, koia anō kei te oko porotaka,</para>
  <para style="q2" vid="SNG 7:2">kīhai i hapa i te wāina whakaranu;</para>
  <para style="q1" vid="SNG 7:2">ko tōu kōpū, ānō he pūranga wīti</para>
  <para style="q2" vid="SNG 7:2">kua oti te karapoti ki ngā rengarenga.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />Nō ōu ū e rua, ānō ko ngā kūao e rua,</para>
  <para style="q2" vid="SNG 7:3">he māhanga nā te anaterope.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Ko tōu kakī ānō he pourewa rei.</para>
  <para style="q1" vid="SNG 7:4">Ko ōu kanohi, ānō ko ngā roto wai i Hehepona,</para>
  <para style="q2" vid="SNG 7:4">i te Kūwaha o Peterapimi.</para>
  <para style="q1" vid="SNG 7:4">Ko tōu ihu, ānō ko te Pourewa o Repanōna,</para>
  <para style="q2" vid="SNG 7:4">e titiro atu nei ki Ramahiku.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Ko tōu māhunga, i runga i a koe rite tonu ki Karamere,</para>
  <para style="q2" vid="SNG 7:5">ā, ko te makawe o tōu māhunga, ki te pāpura;</para>
  <para style="q2" vid="SNG 7:5">e mau herehere ana te kīngi i roto i ōna uru.<verse eid="SNG 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Anō te ātaahua, anō te pai ōu,</para>
  <para style="q2" vid="SNG 7:6">e te mea e arohaina ana, āhuareka tonu!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Rite tonu koe ki te nīkau i a koe e tū nei,</para>
  <para style="q2" vid="SNG 7:7">ā, ko ōu ū ki ngā tautau karepe.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />I mea ahau, “Ka pikitia e ahau te nīkau,</para>
  <para style="q2" vid="SNG 7:8">ka hopukia atu e ahau ōna manga.”</para>
  <para style="q1" vid="SNG 7:8">Kia rite ōu ū ki ngā tautau o te wāina,</para>
  <para style="q2" vid="SNG 7:8">te kakara o tōu hā ki te āporo;<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />ā, ko tōu māngai kia rite ki te wāina tino pai</para>
  <para style="q2" vid="SNG 7:9">e mania nei tāna heke mā tāku e aroha nei,</para>
  <para style="q2" vid="SNG 7:9">e rere ana nā ngā ngutu o te hunga e moe ana.<verse eid="SNG 7:9" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />Kei tāku e aroha nei ahau;</para>
  <para style="q2" vid="SNG 7:10">ko ahau anō tāna e hiahia ai.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Haere mai, e tāku e aroha nei,</para>
  <para style="q2" vid="SNG 7:11">tāua ka haere ki te pārae,</para>
  <para style="q2" vid="SNG 7:11">ka moe tāua ki ngā pā ririki.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Kia moata tō tāua maranga ki ngā māra wāina;</para>
  <para style="q2" vid="SNG 7:12">kia kite ai, e tupu ana rānei te wāina,</para>
  <para style="q1" vid="SNG 7:12">kua puta rānei te karepe hou,</para>
  <para style="q2" vid="SNG 7:12">e kōpuku ana rānei ngā pamekaranete.</para>
  <para style="q1" vid="SNG 7:12">Ko reira hoatu ai e ahau tōku aroha ki a koe.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />Kei te patu te kakara o ngā manitareki,</para>
  <para style="q2" vid="SNG 7:13">kei ō tāua kūwaha anō ngā momo hua papai katoa,</para>
  <para style="q1" vid="SNG 7:13">ngā mea hou, ngā mea tawhito,</para>
  <para style="q2" vid="SNG 7:13">he mea rongoā nāku māu, e tāku e aroha nei.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />Auē me i rite koe ki tōku tungāne</para>
  <para style="q2" vid="SNG 8:1">i ngote nei i ngā ū o tōku whaea!</para>
  <para style="q1" vid="SNG 8:1">Ka kite ahau i a koe i waho, ka kihia koe e ahau,</para>
  <para style="q2" vid="SNG 8:1">āe, e kore tētahi e whakahāwea ki ahau.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />Ka aratakina koe e ahau,</para>
  <para style="q2" vid="SNG 8:2">ka kawea ki te whare o tōku whaea,</para>
  <para style="q2" vid="SNG 8:2">ko ia anō hei whakaako i ahau.</para>
  <para style="q1" vid="SNG 8:2">Ka whakainumia koe e ahau ki te wāina whakaranu,</para>
  <para style="q2" vid="SNG 8:2">ki te wai o tāku pamekaranete.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Ko tōna mauī ki raro i tōku mātenga,</para>
  <para style="q2" vid="SNG 8:3">ko tōna matau ki te awhi i ahau!<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />He kī atu tēnei nāku ki a koutou, e ngā tamāhine o Hiruhārama,</para>
  <para style="q2" vid="SNG 8:4">kaua e whakaohokia, kaua e whakaarahia tāku e aroha nei,</para>
  <para style="q2" vid="SNG 8:4">kia pai rā anō ia!<verse eid="SNG 8:4" /></para>
  <para style="s">Te Hokinga Mai</para>
  <para style="sp">Ngā Hoa</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Ko wai tēnei e haere mai nei i te koraha</para>
  <para style="q2" vid="SNG 8:5">e taupuhipuhi nei ki tāna i aroha ai?</para>
  <para style="sp" vid="SNG 8:5">Te Wahine</para>
  <para style="q1" vid="SNG 8:5">Nāku koe i whakaara ake i raro i te āporo;</para>
  <para style="q2" vid="SNG 8:5">ko te wāhi tēnā i puta mai ai koe i roto i tōu whaea;</para>
  <para style="q2" vid="SNG 8:5">i puta mai anō koe i reira i roto i te wahine i whānau ai koe.<verse eid="SNG 8:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Waiho ahau hei hīri ki tōu ngākau,</para>
  <para style="q2" vid="SNG 8:6">hei hīri ki tōu ringa;</para>
  <para style="q1" vid="SNG 8:6">rite tahi hoki ki tō te mate te kaha o te aroha;</para>
  <para style="q2" vid="SNG 8:6">nanakia tonu te hae, ānō ko te urupā,</para>
  <para style="q1" vid="SNG 8:6">ko ōna hiko, he hiko ahi,</para>
  <para style="q2" vid="SNG 8:6">he mura pū nā Ihowā.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Nui te wai, e kore te aroha e taea te tinei,</para>
  <para style="q2" vid="SNG 8:7">e kore anō e ngaro i ngā awa.</para>
  <para style="q1" vid="SNG 8:7">Ahakoa i hoatu e te tangata</para>
  <para style="q2" vid="SNG 8:7">ngā rawa katoa o tōna whare mō te aroha,</para>
  <para style="q2" vid="SNG 8:7">ka whakahāweatia rawatia.<verse eid="SNG 8:7" /></para>
  <para style="sp">Ngā Hoa</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />He teina nohinohi tō mātou,</para>
  <para style="q2" vid="SNG 8:8">kāhore hoki ōna ū.</para>
  <para style="q1" vid="SNG 8:8">Me pēhea mātou ki tō mātou teina</para>
  <para style="q2" vid="SNG 8:8">i te rā e kōrerotia ai ia?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Ki te mea he taiepa ia,</para>
  <para style="q2" vid="SNG 8:9">ka hangā e tātou he pourewa ki runga ki a ia, he mea hiriwa.</para>
  <para style="q1" vid="SNG 8:9">Ki te mea he tatau ia,</para>
  <para style="q2" vid="SNG 8:9">ka whakakōpakina ia e tātou ki ngā papa hīta.<verse eid="SNG 8:9" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />He taiepa ahau,</para>
  <para style="q2" vid="SNG 8:10">ko ōku ū, ānō ko ōna pourewa;</para>
  <para style="q1" vid="SNG 8:10">nō reira, ki tāna titiro mai,</para>
  <para style="q2" vid="SNG 8:10">i rite ahau ki tētahi kua kite i te āta noho.<verse eid="SNG 8:10" /></para>
  <para style="sp">Te Tāne</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />He māra wāina tā Horomona i Paara-Hamono,</para>
  <para style="q2" vid="SNG 8:11">tukua atu ana e ia te māra ki ngā kaitiaki;</para>
  <para style="q1" vid="SNG 8:11">kotahi mano ngā hiriwa hei kawenga mai mā tēnei,</para>
  <para style="q2" vid="SNG 8:11">mā tēnei hei utu mō ōna hua.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />Ko tāku māra, ko tāku ake, kei tōku aroaro;</para>
  <para style="q2" vid="SNG 8:12">māu, e Horomona, te kotahi mano,</para>
  <para style="q2" vid="SNG 8:12">ā, mā ngā kaitiaki o ōna hua e rua rau.<verse eid="SNG 8:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />E koe e noho nei i ngā kāri,</para>
  <para style="q2" vid="SNG 8:13">e whakarongo ana ngā hoa ki tōu reo;</para>
  <para style="q2" vid="SNG 8:13">meinga kia rongo ahau.<verse eid="SNG 8:13" /></para>
  <para style="sp">Te Wahine</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />Kia hohoro, e tāku e aroha nei,</para>
  <para style="q2" vid="SNG 8:14">kia rite koe ki te anaterope,</para>
  <para style="q1" vid="SNG 8:14">ki te kūao hāta rānei</para>
  <para style="q2" vid="SNG 8:14">i runga i ngā maunga kīnaki kakara!<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>