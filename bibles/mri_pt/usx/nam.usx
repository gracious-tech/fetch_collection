<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">nam.txt Māori macronized text, extracted 16-05-06</book>
  <para style="h">Nahumu</para>
  <para style="toc3">Nahu</para>
  <para style="mt2">Ko te Pukapuka a</para>
  <para style="mt1">Nahumu</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Ko te poropititanga mō Ninewe. Ko te pukapuka o te kite a Nahumu Erekohi.<verse eid="NAM 1:1" /></para>
  <para style="s">Te Riri o Ihowā ki a Ninewe</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />He Atua hae a Ihowā, he rapu utu;</para>
  <para style="q2" vid="NAM 1:2">he rapu utu a Ihowā, ā, kī tonu i te riri;</para>
  <para style="q1" vid="NAM 1:2">e rapu utu ana a Ihowā i ōna hoariri,</para>
  <para style="q2" vid="NAM 1:2">ā, e rongoātia ana e ia he riri mō ōna hoariri.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />He pūhoi a Ihowā ki te riri, he nui tōna kaha,</para>
  <para style="q2" vid="NAM 1:3">e kore rawa e whakaharakoretia e ia te tangata hara.</para>
  <para style="b" vid="NAM 1:3" />
  <para style="q1" vid="NAM 1:3">Ko tō Ihowā ara kei te tūkauati, kei te paroro,</para>
  <para style="q2" vid="NAM 1:3">ko ngā kapua te puehu o ōna waewae.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />E rīria ana e ia te moana, ā, meinga ana kia maroke,</para>
  <para style="q2" vid="NAM 1:4">ā, whakamaroketia ana ngā awa katoa.</para>
  <para style="q1" vid="NAM 1:4">E ngohe ana a Pahana, me Karamere,</para>
  <para style="q2" vid="NAM 1:4">ā, kahakore noa iho te puāwai o Repanōna.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Wiri ana ngā maunga i a ia,</para>
  <para style="q2" vid="NAM 1:5">rewa ana ngā pukepuke;</para>
  <para style="q1" vid="NAM 1:5">huamo ake ana te whenua i tōna aroaro,</para>
  <para style="q2" vid="NAM 1:5">āe rā, te ao, me ngā tāngata katoa e noho ana i reira.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Ko wai e kaha ki te tū i mua i tōna āritarita?</para>
  <para style="q2" vid="NAM 1:6">Ko wai e kaha ki te whakatika, ina mura tōna riri;</para>
  <para style="q1" vid="NAM 1:6">ko te ringihanga mai o tōna weriweri, ānō he ahi;</para>
  <para style="q2" vid="NAM 1:6">ko ngā kāmaka wāhia iho e ia.<verse eid="NAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />He pai a Ihowā,</para>
  <para style="q2" vid="NAM 1:7">he pā kaha i te rā o te raru;</para>
  <para style="q1" vid="NAM 1:7">e mōhio ana hoki ia ki te hunga</para>
  <para style="q2" vid="NAM 1:7">e whakawhirinaki ana ki a ia.<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />Otiia ka mōtī tō reira wāhi i tāna waipuke e ngawhā ana;</para>
  <para style="q2" vid="NAM 1:8">ka whāia anō e ia ōna hoariri ki roto ki te pōuri.<verse eid="NAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Ko te aha tā koutou e whakaaro nā ki a Ihowā?</para>
  <para style="q2" vid="NAM 1:9">Ka mōtī rawa i a ia;</para>
  <para style="q2" vid="NAM 1:9">e kore e tuaruatia te putanga ake o te aituā.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Nō te mea, ahakoa rite rātou ki te tātarāmoa e whiwhi ana,</para>
  <para style="q2" vid="NAM 1:10">ahakoa ki ngā kōpū anō nā tā rātou wāina,</para>
  <para style="q2" vid="NAM 1:10">ka tino pau rātou, ānō he kakau wīti kua maroke.<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />Kua puta mai i roto i a koe</para>
  <para style="q2" vid="NAM 1:11">tētahi e whakaaro ana i te hē mō Ihowā,</para>
  <para style="q2" vid="NAM 1:11">he kaiwhakatakoto i te whakaaro kino.<verse eid="NAM 1:11" /></para>
  <para style="s">He Rongo Pai mō Hūrā</para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />Ko te kupu tēnei a Ihowā,</para>
  <para style="q1" vid="NAM 1:12">“Ahakoa tino kaha rātou, ahakoa tini,</para>
  <para style="q2" vid="NAM 1:12">heoi ka tapahia rātou, ka pahemo ia.</para>
  <para style="q1" vid="NAM 1:12">Ahakoa i whiua koe e ahau,</para>
  <para style="q2" vid="NAM 1:12">e kore koe e whiua e ahau ā muri ake nei.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Nā, ākuanei ahau wāhi ai i tāna ioka i runga i a koe,</para>
  <para style="q2" vid="NAM 1:13">momotu ai i ōu here.”<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />He whakahau hoki tā Ihowā mōu, arā:</para>
  <para style="q2" vid="NAM 1:14">“Kia kaua e whakatōkia tētahi o tōu ingoa ā muri ake nei;</para>
  <para style="q1" vid="NAM 1:14">ka hātepea atu e ahau te whakapakoko tārai</para>
  <para style="q2" vid="NAM 1:14">me te whakapakoko whakarewa i roto i te whare o ōu atua.</para>
  <para style="q1" vid="NAM 1:14">Ka hangā e ahau he urupā mōu; nō te mea he kino koe.”<verse eid="NAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />Nanā, kei runga i ngā maunga ngā waewae</para>
  <para style="q2" vid="NAM 1:15">o te kaikawe mai i te kōrero pai,</para>
  <para style="q2" vid="NAM 1:15">o te kaikauwhau i te rongo mau!</para>
  <para style="q1" vid="NAM 1:15">Mahia āu hākari, e Hūrā,</para>
  <para style="q2" vid="NAM 1:15">whakamanā āu kupu taurangi;</para>
  <para style="q1" vid="NAM 1:15">nō te mea heoi anō haeretanga atu o te tangata kino nā waenga i a koe;</para>
  <para style="q2" vid="NAM 1:15">kua hātepea rawatia atu ia.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">Te Urupatu o te Pā Kino</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />Kua tae ake te kaiwāwāhi ki tōu aroaro.</para>
  <para style="q2" vid="NAM 2:1">Tiakina te pā,</para>
  <para style="q2" vid="NAM 2:1">tūteia te ara,</para>
  <para style="q1" vid="NAM 2:1">kia kaha tōu hope,</para>
  <para style="q2" vid="NAM 2:1">kia ū rawa tōu kaha.<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />Nō te mea ka whakahokia mai e Ihowā te korōria o Hākopa,</para>
  <para style="q2" vid="NAM 2:2">me te korōria o Īharaira;</para>
  <para style="q1" vid="NAM 2:2">kua takoto kau hoki rātou i ngā kaiwhakatakoto kau,</para>
  <para style="q2" vid="NAM 2:2">kua hē anō ā rātou manga wāina i a rātou.<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Kua oti te whakangungu rākau a āna mārohirohi te whakawhero,</para>
  <para style="q2" vid="NAM 2:3">he ngangana te kākahu o ngā māia.</para>
  <para style="q1" vid="NAM 2:3">Kei te rino e kanapa ana te rite o ngā hāriata</para>
  <para style="q2" vid="NAM 2:3">i te rā e takatū ai ia,</para>
  <para style="q2" vid="NAM 2:3">ā, ko ngā tao wiri rawa.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Ngana tonu ngā hāriata i ngā ara,</para>
  <para style="q2" vid="NAM 2:4">taututetute ana ki a rātou anō i ngā waharoa;</para>
  <para style="q1" vid="NAM 2:4">ko tō rātou āhua ānō he roherohe,</para>
  <para style="q2" vid="NAM 2:4">e rere ana me he uira.<verse eid="NAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Ka mahara ia ki āna metararahi;</para>
  <para style="q2" vid="NAM 2:5">ka tapatu rātou i a rātou e haere ana;</para>
  <para style="q1" vid="NAM 2:5">ka hohoro rātou ki tō reira taiepa,</para>
  <para style="q2" vid="NAM 2:5">ā, ka rite te ārai.<verse eid="NAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />Ka whakatuwheratia ngā kūwaha o ngā awa,</para>
  <para style="q2" vid="NAM 2:6">ka papahoro te whare kīngi.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />Nā, kua tū tahanga a Huhapa, kua maua atu ia,</para>
  <para style="q2" vid="NAM 2:7">ā, ka tangi āna pononga wāhine,</para>
  <para style="q1" vid="NAM 2:7">ko te reo koia anō kei tō te kūkupa,</para>
  <para style="q2" vid="NAM 2:7">ko ō rātou uma hei timipera mā rātou.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Ko Ninewe ia, ko tōna rite mai onamata, kei te puna wai.</para>
  <para style="q2" vid="NAM 2:8">Heoi, ka tahuti rātou;</para>
  <para style="q1" vid="NAM 2:8">ka karanga, “E tū, e tū!”</para>
  <para style="q2" vid="NAM 2:8">Heoi, e kore tētahi e titiro whakamuri.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />Pāhuatia te hiriwa,</para>
  <para style="q2" vid="NAM 2:9">pāhuatia te kōura;</para>
  <para style="q1" vid="NAM 2:9">kāhore hoki he mutunga o ngā rawa,</para>
  <para style="q2" vid="NAM 2:9">o te korōria i roto i ngā taonga āhuareka katoa.<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />Kua takoto kau ia, kāhore āna mea, mōtī rawa!</para>
  <para style="q2" vid="NAM 2:10">Harotu kau te ngākau, kei te āki anō ngā turi ki a rāua,</para>
  <para style="q1" vid="NAM 2:10">he nui te mamae kei ngā hope katoa,</para>
  <para style="q2" vid="NAM 2:10">kua kōmā ngā mata o rātou katoa.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Kei hea te nohoanga o ngā raiona,</para>
  <para style="q2" vid="NAM 2:11">te wāhi kai a ngā kūao raiona,</para>
  <para style="q1" vid="NAM 2:11">te wāhi i hāereere ai te raiona, me te raiona kātua,</para>
  <para style="q2" vid="NAM 2:11">me te kūao raiona, tē ai he kaiwhakawehi?<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />I haehaea mai e te raiona he mea e mākona ai āna kūao,</para>
  <para style="q2" vid="NAM 2:12">nōtia ana e ia te kakī hei mea mā āna raiona uha,</para>
  <para style="q1" vid="NAM 2:12">whakakīia ana e ia ōna rua ki te kai,</para>
  <para style="q2" vid="NAM 2:12">ōna nohoanga hoki ki te mea i haehaea.<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />“Nanā, hei hoariri tēnei ahau mōu,”</para>
  <para style="q2" vid="NAM 2:13">e ai tā Ihowā o ngā mano,</para>
  <para style="q1" vid="NAM 2:13">“ka tahuna anō e ahau ana hāriata i roto i te paowa,</para>
  <para style="q2" vid="NAM 2:13">ka pau āu kūao raiona i te hoari.</para>
  <para style="q1" vid="NAM 2:13">Ka kore i ahau he haehaenga māu i runga i te whenua,</para>
  <para style="q2" vid="NAM 2:13">e kore anō te reo o āu karere e rangona ā muri ake nei.”<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">Ka Tata te Turaki</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Auē te mate mō te pā toto!</para>
  <para style="q2" vid="NAM 3:1">Kua kī katoa i te teka, i te pāhua –</para>
  <para style="q2" vid="NAM 3:1">kāhore e mutu te muru taonga!<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Ko te haruru o te whiu,</para>
  <para style="q2" vid="NAM 3:2">ko te ngaehe o ngā wīra e kekē ana;</para>
  <para style="q1" vid="NAM 3:2">ko ngā hōiho e takatakahi ana,</para>
  <para style="q2" vid="NAM 3:2">ko ngā hāriata e tarapekepeke ana.<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Ko ngā kaieke hōiho e ekeeke ana,</para>
  <para style="q2" vid="NAM 3:3">ko te wheriko o te hoari,</para>
  <para style="q1" vid="NAM 3:3">ko te kanapa o te tao;</para>
  <para style="q2" vid="NAM 3:3">ko te tini o te tūpāpaku,</para>
  <para style="q2" vid="NAM 3:3">me te pūranga nui o ngā tinana mate –</para>
  <para style="q1" vid="NAM 3:3">ā, kāhore he mutunga o ngā tinana;</para>
  <para style="q2" vid="NAM 3:3">tūtuki ana te waewae ki ō rātou tinana.<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />He maha hoki nō ngā kairautanga o te wahine ātaahua i kairau nei;</para>
  <para style="q2" vid="NAM 3:4">ko te rangatira nei ia o ngā mākutu,</para>
  <para style="q1" vid="NAM 3:4">e hoko nei i ngā iwi ki āna kairautanga,</para>
  <para style="q2" vid="NAM 3:4">i ngā hapū anō ki āna mahi mākutu.<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />“Nanā, hei hoariri tēnei ahau mōu,”</para>
  <para style="q2" vid="NAM 3:5">e ai tā Ihowā o ngā mano,</para>
  <para style="q2" vid="NAM 3:5">“ka hurahia anō e ahau ngā remu o tōu ki tōu aroaro;</para>
  <para style="q1" vid="NAM 3:5">ka whakakite anō ahau i a koe e noho tahanga ana ki ngā iwi,</para>
  <para style="q2" vid="NAM 3:5">me tōu whakamā ki ngā kīngitanga.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Ā, ka makā e ahau he mea whakarihariha ki runga ki a koe,</para>
  <para style="q2" vid="NAM 3:6">ka whakaititia koe e ahau,</para>
  <para style="q2" vid="NAM 3:6">ka meinga hei tirohanga atu.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Nā, ko te hunga katoa e kite ana i a koe</para>
  <para style="q2" vid="NAM 3:7">ka rere atu i a koe, ā, ka mea,</para>
  <para style="q1" vid="NAM 3:7">‘Kua ururuatia a Ninewe; ko wai hei tangi ki a ia?’</para>
  <para style="q2" vid="NAM 3:7">Me rapu e ahau ki hea he kaiwhakamārie mōu?”<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />He pai ake rānei koe i Noamono,</para>
  <para style="q2" vid="NAM 3:8">i tū nei i roto i ngā awa,</para>
  <para style="q1" vid="NAM 3:8">he mea karapoti e ngā wai,</para>
  <para style="q2" vid="NAM 3:8">ko tōna pekerangi ko te moana,</para>
  <para style="q2" vid="NAM 3:8">nō te moana anō tōna taiepa?<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Ko tōna kaha ko Etiopia,</para>
  <para style="q2" vid="NAM 3:9">ko Īhipa, kāhore hoki he mutunga;</para>
  <para style="q2" vid="NAM 3:9">he āwhina nōu a Putu, a Rūpimi.<verse eid="NAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Heoi, kua whakaraua atu ia,</para>
  <para style="q2" vid="NAM 3:10">kua riro hei pārau.</para>
  <para style="q1" vid="NAM 3:10">Ko āna kōhungahunga tāia iho</para>
  <para style="q2" vid="NAM 3:10">i te ahunga mai o ngā ara katoa,</para>
  <para style="q2" vid="NAM 3:10">mongamonga noa,</para>
  <para style="q1" vid="NAM 3:10">i maka rota rātou mō ōna tāngata nunui,</para>
  <para style="q2" vid="NAM 3:10">ko ōna tāngata rarahi katoa</para>
  <para style="q2" vid="NAM 3:10">here rawa ki te mekameka.<verse eid="NAM 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Tērā anō koe ka haurangi,</para>
  <para style="q2" vid="NAM 3:11">ka huna koe;</para>
  <para style="q1" vid="NAM 3:11">ā, ka rapu koe</para>
  <para style="q2" vid="NAM 3:11">he wāhi kaha i te wehi o te hoariri.<verse eid="NAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Ko ōu pā taiepa katoa ka rite ki te piki</para>
  <para style="q2" vid="NAM 3:12">he hua mātāmua nei ōna –</para>
  <para style="q1" vid="NAM 3:12">ki te rurerurea, ka taka</para>
  <para style="q2" vid="NAM 3:12">ki roto ki te māngai o te tangata e kai ana.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Nanā, he wāhine ōu tāngata</para>
  <para style="q2" vid="NAM 3:13">i waenganui i a koe.</para>
  <para style="q1" vid="NAM 3:13">Ko ngā kūwaha o tōu whenua</para>
  <para style="q2" vid="NAM 3:13">tuwhera pū ki ōu hoariri;</para>
  <para style="q2" vid="NAM 3:13">ka pau ōu tūtaki i te ahi.<verse eid="NAM 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Utuhia he wai mōu mō te whakapaenga,</para>
  <para style="q2" vid="NAM 3:14">whakakahangia ōu pā taiepa;</para>
  <para style="q1" vid="NAM 3:14">haere ki te mahi paru,</para>
  <para style="q2" vid="NAM 3:14">takatakahia te mea pokepoke,</para>
  <para style="q2" vid="NAM 3:14">kia ū te tahunga pereki.<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Ka pau koe i te ahi i reira,</para>
  <para style="q2" vid="NAM 3:15">ka hātepea atu koe e te hoari,</para>
  <para style="q2" vid="NAM 3:15">ko tāna kai i a koe ka rite ki tā te tātarakihi.</para>
  <para style="q1" vid="NAM 3:15">Whakaraneatia koe, kia rite ki te tātarakihi,</para>
  <para style="q2" vid="NAM 3:15">whakaraneatia koe, kia rite ki te māwhitiwhiti.<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Ko āu kaihokohoko</para>
  <para style="q2" vid="NAM 3:16">whakatokomahatia ake e koe i ngā whetū o te rangi.</para>
  <para style="q2" vid="NAM 3:16">Ko tā te tātarakihi he pāhua, ā, rere ana.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Ko ōu tāngata i te pōtae kīngi,</para>
  <para style="q2" vid="NAM 3:17">ko tō rātou rite kei te māwhitiwhiti,</para>
  <para style="q1" vid="NAM 3:17">ko ōu rangatira rite tonu ki ngā pōkai māwhitiwhiti</para>
  <para style="q2" vid="NAM 3:17">e noho nei i ngā taiepa</para>
  <para style="q1" vid="NAM 3:17">i te rā māeke i te whitinga o te rā ka rere rātou,</para>
  <para style="q2" vid="NAM 3:17">kāhore hoki e mōhiotia tō rātou wāhi, kei hea rā?<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />Kei te moe āu hēpara,</para>
  <para style="q2" vid="NAM 3:18">e te kīngi o Ahiria;</para>
  <para style="q2" vid="NAM 3:18">ko āu metararahi kei te takoto.</para>
  <para style="q1" vid="NAM 3:18">Kua marara atu tōu iwi ki runga ki ngā maunga,</para>
  <para style="q2" vid="NAM 3:18">kāhore hoki he kaihuihui.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Kāhore he whakamāhunga i tōu pakaru;</para>
  <para style="q2" vid="NAM 3:19">he mamae rawa tōu marūtanga.</para>
  <para style="q1" vid="NAM 3:19">Ko te hunga katoa e rongo ana i te rongo ki a koe,</para>
  <para style="q2" vid="NAM 3:19">ka papaki ō rātou ringa ki a koe.</para>
  <para style="q1" vid="NAM 3:19">I kore hoki ki a wai</para>
  <para style="q2" vid="NAM 3:19">te pānga tonutanga o tōu kino.<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>