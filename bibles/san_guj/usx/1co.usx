<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1CO" style="id">Sanskrit Bible (NT) in Gujarati Script (સત્યવેદઃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Corinthians</para>
  <para style="toc1">૧ કરિન્થિનઃ પત્રં</para>
  <para style="toc2">૧ કરિન્થિનઃ</para>
  <para style="toc3">૧ કરિન્થિનઃ</para>
  <para style="mt1">૧ કરિન્થિનઃ પત્રં</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>યાવન્તઃ પવિત્રા લોકાઃ સ્વેષામ્ અસ્માકઞ્ચ વસતિસ્થાનેષ્વસ્માકં પ્રભો ર્યીશોઃ ખ્રીષ્ટસ્ય નામ્ના પ્રાર્થયન્તે તૈઃ સહાહૂતાનાં ખ્રીષ્ટેન યીશુના પવિત્રીકૃતાનાં લોકાનાં ય ઈશ્વરીયધર્મ્મસમાજઃ કરિન્થનગરે વિદ્યતે</para>
  <para style="p">
    <verse number="2" style="v"/>તં પ્રતીશ્વરસ્યેચ્છયાહૂતો યીશુખ્રીષ્ટસ્ય પ્રેરિતઃ પૌલઃ સોસ્થિનિનામા ભ્રાતા ચ પત્રં લિખતિ|</para>
  <para style="p">
    <verse number="3" style="v"/>અસ્માકં પિત્રેશ્વરેણ પ્રભુના યીશુખ્રીષ્ટેન ચ પ્રસાદઃ શાન્તિશ્ચ યુષ્મભ્યં દીયતાં|</para>
  <para style="p">
    <verse number="4" style="v"/>ઈશ્વરો યીશુખ્રીષ્ટેન યુષ્માન્ પ્રતિ પ્રસાદં પ્રકાશિતવાન્, તસ્માદહં યુષ્મન્નિમિત્તં સર્વ્વદા મદીયેશ્વરં ધન્યં વદામિ|</para>
  <para style="p">
    <verse number="5" style="v"/>ખ્રીષ્ટસમ્બન્ધીયં સાક્ષ્યં યુષ્માકં મધ્યે યેન પ્રકારેણ સપ્રમાણમ્ અભવત્</para>
  <para style="p">
    <verse number="6" style="v"/>તેન યૂયં ખ્રીષ્ટાત્ સર્વ્વવિધવક્તૃતાજ્ઞાનાદીનિ સર્વ્વધનાનિ લબ્ધવન્તઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>તતોઽસ્મત્પ્રભો ર્યીશુખ્રીષ્ટસ્ય પુનરાગમનં પ્રતીક્ષમાણાનાં યુષ્માકં કસ્યાપિ વરસ્યાભાવો ન ભવતિ|</para>
  <para style="p">
    <verse number="8" style="v"/>અપરમ્ અસ્માકં પ્રભો ર્યીશુખ્રીષ્ટસ્ય દિવસે યૂયં યન્નિર્દ્દોષા ભવેત તદર્થં સએવ યાવદન્તં યુષ્માન્ સુસ્થિરાન્ કરિષ્યતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>ય ઈશ્વરઃ સ્વપુત્રસ્યાસ્મત્પ્રભો ર્યીશુખ્રીષ્ટસ્યાંશિનઃ કર્ત્તું યુષ્માન્ આહૂતવાન્ સ વિશ્વસનીયઃ|</para>
  <para style="p">
    <verse number="10" style="v"/>હે ભ્રાતરઃ, અસ્માકં પ્રભુયીશુખ્રીષ્ટસ્ય નામ્ના યુષ્માન્ વિનયેઽહં સર્વ્વૈ ર્યુષ્માભિરેકરૂપાણિ વાક્યાનિ કથ્યન્તાં યુષ્મન્મધ્યે ભિન્નસઙ્ઘાતા ન ભવન્તુ મનોવિચારયોરૈક્યેન યુષ્માકં સિદ્ધત્વં ભવતુ|</para>
  <para style="p">
    <verse number="11" style="v"/>હે મમ ભ્રાતરો યુષ્મન્મધ્યે વિવાદા જાતા ઇતિ વાર્ત્તામહં ક્લોય્યાઃ પરિજનૈ ર્જ્ઞાપિતઃ|</para>
  <para style="p">
    <verse number="12" style="v"/>મમાભિપ્રેતમિદં યુષ્માકં કશ્ચિત્ કશ્ચિદ્ વદતિ પૌલસ્ય શિષ્યોઽહમ્ આપલ્લોઃ શિષ્યોઽહં કૈફાઃ શિષ્યોઽહં ખ્રીષ્ટસ્ય શિષ્યોઽહમિતિ ચ|</para>
  <para style="p">
    <verse number="13" style="v"/>ખ્રીષ્ટસ્ય કિં વિભેદઃ કૃતઃ? પૌલઃ કિં યુષ્મત્કૃતે ક્રુશે હતઃ? પૌલસ્ય નામ્ના વા યૂયં કિં મજ્જિતાઃ?</para>
  <para style="p">
    <verse number="14" style="v"/>ક્રિષ્પગાયૌ વિના યુષ્માકં મધ્યેઽન્યઃ કોઽપિ મયા ન મજ્જિત ઇતિ હેતોરહમ્ ઈશ્વરં ધન્યં વદામિ|</para>
  <para style="p">
    <verse number="15" style="v"/>એતેન મમ નામ્ના માનવા મયા મજ્જિતા ઇતિ વક્તું કેનાપિ ન શક્યતે|</para>
  <para style="p">
    <verse number="16" style="v"/>અપરં સ્તિફાનસ્ય પરિજના મયા મજ્જિતાસ્તદન્યઃ કશ્ચિદ્ યન્મયા મજ્જિતસ્તદહં ન વેદ્મિ|</para>
  <para style="p">
    <verse number="17" style="v"/>ખ્રીષ્ટેનાહં મજ્જનાર્થં ન પ્રેરિતઃ કિન્તુ સુસંવાદસ્ય પ્રચારાર્થમેવ; સોઽપિ વાક્પટુતયા મયા ન પ્રચારિતવ્યઃ, યતસ્તથા પ્રચારિતે ખ્રીષ્ટસ્ય ક્રુશે મૃત્યુઃ ફલહીનો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="18" style="v"/>યતો હેતો ર્યે વિનશ્યન્તિ તે તાં ક્રુશસ્ય વાર્ત્તાં પ્રલાપમિવ મન્યન્તે કિઞ્ચ પરિત્રાણં લભમાનેષ્વસ્માસુ સા ઈશ્વરીયશક્તિસ્વરૂપા|</para>
  <para style="p">
    <verse number="19" style="v"/>તસ્માદિત્થં લિખિતમાસ્તે, જ્ઞાનવતાન્તુ યત્ જ્ઞાનં તન્મયા નાશયિષ્યતે| વિલોપયિષ્યતે તદ્વદ્ બુદ્ધિ ર્બદ્ધિમતાં મયા||</para>
  <para style="p">
    <verse number="20" style="v"/>જ્ઞાની કુત્ર? શાસ્ત્રી વા કુત્ર? ઇહલોકસ્ય વિચારતત્પરો વા કુત્ર? ઇહલોકસ્ય જ્ઞાનં કિમીશ્વરેણ મોહીકૃતં નહિ?</para>
  <para style="p">
    <verse number="21" style="v"/>ઈશ્વરસ્ય જ્ઞાનાદ્ ઇહલોકસ્ય માનવાઃ સ્વજ્ઞાનેનેશ્વરસ્ય તત્ત્વબોધં ન પ્રાપ્તવન્તસ્તસ્માદ્ ઈશ્વરઃ પ્રચારરૂપિણા પ્રલાપેન વિશ્વાસિનઃ પરિત્રાતું રોચિતવાન્|</para>
  <para style="p">
    <verse number="22" style="v"/>યિહૂદીયલોકા લક્ષણાનિ દિદૃક્ષન્તિ ભિન્નદેશીયલોકાસ્તુ વિદ્યાં મૃગયન્તે,</para>
  <para style="p">
    <verse number="23" style="v"/>વયઞ્ચ ક્રુશે હતં ખ્રીષ્ટં પ્રચારયામઃ| તસ્ય પ્રચારો યિહૂદીયૈ ર્વિઘ્ન ઇવ ભિન્નદેશીયૈશ્ચ પ્રલાપ ઇવ મન્યતે,</para>
  <para style="p">
    <verse number="24" style="v"/>કિન્તુ યિહૂદીયાનાં ભિન્નદેશીયાનાઞ્ચ મધ્યે યે આહૂતાસ્તેષુ સ ખ્રીષ્ટ ઈશ્વરીયશક્તિરિવેશ્વરીયજ્ઞાનમિવ ચ પ્રકાશતે|</para>
  <para style="p">
    <verse number="25" style="v"/>યત ઈશ્વરે યઃ પ્રલાપ આરોપ્યતે સ માનવાતિરિક્તં જ્ઞાનમેવ યચ્ચ દૌર્બ્બલ્યમ્ ઈશ્વર આરોપ્યતે તત્ માનવાતિરિક્તં બલમેવ|</para>
  <para style="p">
    <verse number="26" style="v"/>હે ભ્રાતરઃ, આહૂતયુષ્મદ્ગણો યષ્માભિરાલોક્યતાં તન્મધ્યે સાંસારિકજ્ઞાનેન જ્ઞાનવન્તઃ પરાક્રમિણો વા કુલીના વા બહવો ન વિદ્યન્તે|</para>
  <para style="p">
    <verse number="27" style="v"/>યત ઈશ્વરો જ્ઞાનવતસ્ત્રપયિતું મૂર્ખલોકાન્ રોચિતવાન્ બલાનિ ચ ત્રપયિતુમ્ ઈશ્વરો દુર્બ્બલાન્ રોચિતવાન્|</para>
  <para style="p">
    <verse number="28" style="v"/>તથા વર્ત્તમાનલોકાન્ સંસ્થિતિભ્રષ્ટાન્ કર્ત્તુમ્ ઈશ્વરો જગતોઽપકૃષ્ટાન્ હેયાન્ અવર્ત્તમાનાંશ્ચાભિરોચિતવાન્|</para>
  <para style="p">
    <verse number="29" style="v"/>તત ઈશ્વરસ્ય સાક્ષાત્ કેનાપ્યાત્મશ્લાઘા ન કર્ત્તવ્યા|</para>
  <para style="p">
    <verse number="30" style="v"/>યૂયઞ્ચ તસ્માત્ ખ્રીષ્ટે યીશૌ સંસ્થિતિં પ્રાપ્તવન્તઃ સ ઈશ્વરાદ્ યુષ્માકં જ્ઞાનં પુણ્યં પવિત્રત્વં મુક્તિશ્ચ જાતા|</para>
  <para style="p">
    <verse number="31" style="v"/>અતએવ યદ્વદ્ લિખિતમાસ્તે તદ્વત્, યઃ કશ્ચિત્ શ્લાઘમાનઃ સ્યાત્ શ્લાઘતાં પ્રભુના સ હિ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે ભ્રાતરો યુષ્મત્સમીપે મમાગમનકાલેઽહં વક્તૃતાયા વિદ્યાયા વા નૈપુણ્યેનેશ્વરસ્ય સાક્ષ્યં પ્રચારિતવાન્ તન્નહિ;</para>
  <para style="p">
    <verse number="2" style="v"/>યતો યીશુખ્રીષ્ટં તસ્ય ક્રુશે હતત્વઞ્ચ વિના નાન્યત્ કિમપિ યુષ્મન્મધ્યે જ્ઞાપયિતું વિહિતં બુદ્ધવાન્|</para>
  <para style="p">
    <verse number="3" style="v"/>અપરઞ્ચાતીવ દૌર્બ્બલ્યભીતિકમ્પયુક્તો યુષ્માભિઃ સાર્દ્ધમાસં|</para>
  <para style="p">
    <verse number="4" style="v"/>અપરં યુષ્માકં વિશ્વાસો યત્ માનુષિકજ્ઞાનસ્ય ફલં ન ભવેત્ કિન્ત્વીશ્વરીયશક્તેઃ ફલં ભવેત્,</para>
  <para style="p">
    <verse number="5" style="v"/>તદર્થં મમ વક્તૃતા મદીયપ્રચારશ્ચ માનુષિકજ્ઞાનસ્ય મધુરવાક્યસમ્બલિતૌ નાસ્તાં કિન્ત્વાત્મનઃ શક્તેશ્ચ પ્રમાણયુક્તાવાસ્તાં|</para>
  <para style="p">
    <verse number="6" style="v"/>વયં જ્ઞાનં ભાષામહે તચ્ચ સિદ્ધલોકૈ ર્જ્ઞાનમિવ મન્યતે, તદિહલોકસ્ય જ્ઞાનં નહિ, ઇહલોકસ્ય નશ્વરાણામ્ અધિપતીનાં વા જ્ઞાનં નહિ;</para>
  <para style="p">
    <verse number="7" style="v"/>કિન્તુ કાલાવસ્થાયાઃ પૂર્વ્વસ્માદ્ યત્ જ્ઞાનમ્ અસ્માકં વિભવાર્થમ્ ઈશ્વરેણ નિશ્ચિત્ય પ્રચ્છન્નં તન્નિગૂઢમ્ ઈશ્વરીયજ્ઞાનં પ્રભાષામહે|</para>
  <para style="p">
    <verse number="8" style="v"/>ઇહલોકસ્યાધિપતીનાં કેનાપિ તત્ જ્ઞાનં ન લબ્ધં, લબ્ધે સતિ તે પ્રભાવવિશિષ્ટં પ્રભું ક્રુશે નાહનિષ્યન્|</para>
  <para style="p">
    <verse number="9" style="v"/>તદ્વલ્લિખિતમાસ્તે, નેત્રેણ ક્કાપિ નો દૃષ્ટં કર્ણેનાપિ ચ ન શ્રુતં| મનોમધ્યે તુ કસ્યાપિ ન પ્રવિષ્ટં કદાપિ યત્| ઈશ્વરે પ્રીયમાણાનાં કૃતે તત્ તેન સઞ્ચિતં|</para>
  <para style="p">
    <verse number="10" style="v"/>અપરમીશ્વરઃ સ્વાત્મના તદસ્માકં સાક્ષાત્ પ્રાકાશયત્; યત આત્મા સર્વ્વમેવાનુસન્ધત્તે તેન ચેશ્વરસ્ય મર્મ્મતત્ત્વમપિ બુધ્યતે|</para>
  <para style="p">
    <verse number="11" style="v"/>મનુજસ્યાન્તઃસ્થમાત્માનં વિના કેન મનુજેન તસ્ય મનુજસ્ય તત્ત્વં બુધ્યતે? તદ્વદીશ્વરસ્યાત્માનં વિના કેનાપીશ્વરસ્ય તત્ત્વં ન બુધ્યતે|</para>
  <para style="p">
    <verse number="12" style="v"/>વયઞ્ચેહલોકસ્યાત્માનં લબ્ધવન્તસ્તન્નહિ કિન્ત્વીશ્વરસ્યૈવાત્માનં લબ્ધવન્તઃ, તતો હેતોરીશ્વરેણ સ્વપ્રસાદાદ્ અસ્મભ્યં યદ્ યદ્ દત્તં તત્સર્વ્વમ્ અસ્માભિ ર્જ્ઞાતું શક્યતે|</para>
  <para style="p">
    <verse number="13" style="v"/>તચ્ચાસ્માભિ ર્માનુષિકજ્ઞાનસ્ય વાક્યાનિ શિક્ષિત્વા કથ્યત ઇતિ નહિ કિન્ત્વાત્મતો વાક્યાનિ શિક્ષિત્વાત્મિકૈ ર્વાક્યૈરાત્મિકં ભાવં પ્રકાશયદ્ભિઃ કથ્યતે|</para>
  <para style="p">
    <verse number="14" style="v"/>પ્રાણી મનુષ્ય ઈશ્વરીયાત્મનઃ શિક્ષાં ન ગૃહ્લાતિ યત આત્મિકવિચારેણ સા વિચાર્ય્યેતિ હેતોઃ સ તાં પ્રલાપમિવ મન્યતે બોદ્ધુઞ્ચ ન શક્નોતિ|</para>
  <para style="p">
    <verse number="15" style="v"/>આત્મિકો માનવઃ સર્વ્વાણિ વિચારયતિ કિન્તુ સ્વયં કેનાપિ ન વિચાર્ય્યતે|</para>
  <para style="p">
    <verse number="16" style="v"/>યત ઈશ્વરસ્ય મનો જ્ઞાત્વા તમુપદેષ્ટું કઃ શક્નોતિ? કિન્તુ ખ્રીષ્ટસ્ય મનોઽસ્માભિ ર્લબ્ધં|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે ભ્રાતરઃ, અહમાત્મિકૈરિવ યુષ્માભિઃ સમં સમ્ભાષિતું નાશક્નવં કિન્તુ શારીરિકાચારિભિઃ ખ્રીષ્ટધર્મ્મે શિશુતુલ્યૈશ્ચ જનૈરિવ યુષ્માભિઃ સહ સમભાષે|</para>
  <para style="p">
    <verse number="2" style="v"/>યુષ્માન્ કઠિનભક્ષ્યં ન ભોજયન્ દુગ્ધમ્ અપાયયં યતો યૂયં ભક્ષ્યં ગ્રહીતું તદા નાશક્નુત ઇદાનીમપિ ન શક્નુથ, યતો હેતોરધુનાપિ શારીરિકાચારિણ આધ્વે|</para>
  <para style="p">
    <verse number="3" style="v"/>યુષ્મન્મધ્યે માત્સર્ય્યવિવાદભેદા ભવન્તિ તતઃ કિં શારીરિકાચારિણો નાધ્વે માનુષિકમાર્ગેણ ચ ન ચરથ?</para>
  <para style="p">
    <verse number="4" style="v"/>પૌલસ્યાહમિત્યાપલ્લોરહમિતિ વા યદ્વાક્યં યુષ્માકં કૈશ્ચિત્ કૈશ્ચિત્ કથ્યતે તસ્માદ્ યૂયં શારીરિકાચારિણ ન ભવથ?</para>
  <para style="p">
    <verse number="5" style="v"/>પૌલઃ કઃ? આપલ્લો ર્વા કઃ? તૌ પરિચારકમાત્રૌ તયોરેકૈકસ્મૈ ચ પ્રભુ ર્યાદૃક્ ફલમદદાત્ તદ્વત્ તયોર્દ્વારા યૂયં વિશ્વાસિનો જાતાઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>અહં રોપિતવાન્ આપલ્લોશ્ચ નિષિક્તવાન્ ઈશ્વરશ્ચાવર્દ્ધયત્|</para>
  <para style="p">
    <verse number="7" style="v"/>અતો રોપયિતૃસેક્તારાવસારૌ વર્દ્ધયિતેશ્વર એવ સારઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>રોપયિતૃસેક્તારૌ ચ સમૌ તયોરેકૈકશ્ચ સ્વશ્રમયોગ્યં સ્વવેતનં લપ્સ્યતે|</para>
  <para style="p">
    <verse number="9" style="v"/>આવામીશ્વરેણ સહ કર્મ્મકારિણૌ, ઈશ્વરસ્ય યત્ ક્ષેત્રમ્ ઈશ્વરસ્ય યા નિર્મ્મિતિઃ સા યૂયમેવ|</para>
  <para style="p">
    <verse number="10" style="v"/>ઈશ્વરસ્ય પ્રસાદાત્ મયા યત્ પદં લબ્ધં તસ્માત્ જ્ઞાનિના ગૃહકારિણેવ મયા ભિત્તિમૂલં સ્થાપિતં તદુપરિ ચાન્યેન નિચીયતે| કિન્તુ યેન યન્નિચીયતે તત્ તેન વિવિચ્યતાં|</para>
  <para style="p">
    <verse number="11" style="v"/>યતો યીશુખ્રીષ્ટરૂપં યદ્ ભિત્તિમૂલં સ્થાપિતં તદન્યત્ કિમપિ ભિત્તિમૂલં સ્થાપયિતું કેનાપિ ન શક્યતે|</para>
  <para style="p">
    <verse number="12" style="v"/>એતદ્ભિત્તિમૂલસ્યોપરિ યદિ કેચિત્ સ્વર્ણરૂપ્યમણિકાષ્ઠતૃણનલાન્ નિચિન્વન્તિ,</para>
  <para style="p">
    <verse number="13" style="v"/>તર્હ્યેકૈકસ્ય કર્મ્મ પ્રકાશિષ્યતે યતઃ સ દિવસસ્તત્ પ્રકાશયિષ્યતિ| યતો હતોસ્તન દિવસેન વહ્નિમયેનોદેતવ્યં તત એકૈકસ્ય કર્મ્મ કીદૃશમેતસ્ય પરીક્ષા બહ્નિના ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="14" style="v"/>યસ્ય નિચયનરૂપં કર્મ્મ સ્થાસ્નુ ભવિષ્યતિ સ વેતનં લપ્સ્યતે|</para>
  <para style="p">
    <verse number="15" style="v"/>યસ્ય ચ કર્મ્મ ધક્ષ્યતે તસ્ય ક્ષતિ ર્ભવિષ્યતિ કિન્તુ વહ્ને ર્નિર્ગતજન ઇવ સ સ્વયં પરિત્રાણં પ્રાપ્સ્યતિ|</para>
  <para style="p">
    <verse number="16" style="v"/>યૂયમ્ ઈશ્વરસ્ય મન્દિરં યુષ્મન્મધ્યે ચેશ્વરસ્યાત્મા નિવસતીતિ કિં ન જાનીથ?</para>
  <para style="p">
    <verse number="17" style="v"/>ઈશ્વરસ્ય મન્દિરં યેન વિનાશ્યતે સોઽપીશ્વરેણ વિનાશયિષ્યતે યત ઈશ્વરસ્ય મન્દિરં પવિત્રમેવ યૂયં તુ તન્મન્દિરમ્ આધ્વે|</para>
  <para style="p">
    <verse number="18" style="v"/>કોપિ સ્વં ન વઞ્ચયતાં| યુષ્માકં કશ્ચન ચેદિહલોકસ્ય જ્ઞાનેન જ્ઞાનવાનહમિતિ બુધ્યતે તર્હિ સ યત્ જ્ઞાની ભવેત્ તદર્થં મૂઢો ભવતુ|</para>
  <para style="p">
    <verse number="19" style="v"/>યસ્માદિહલોકસ્ય જ્ઞાનમ્ ઈશ્વરસ્ય સાક્ષાત્ મૂઢત્વમેવ| એતસ્મિન્ લિખિતમપ્યાસ્તે, તીક્ષ્ણા યા જ્ઞાનિનાં બુદ્ધિસ્તયા તાન્ ધરતીશ્વરઃ|</para>
  <para style="p">
    <verse number="20" style="v"/>પુનશ્ચ| જ્ઞાનિનાં કલ્પના વેત્તિ પરમેશો નિરર્થકાઃ|</para>
  <para style="p">
    <verse number="21" style="v"/>અતએવ કોઽપિ મનુજૈરાત્માનં ન શ્લાઘતાં યતઃ સર્વ્વાણિ યુષ્માકમેવ,</para>
  <para style="p">
    <verse number="22" style="v"/>પૌલ વા આપલ્લો ર્વા કૈફા વા જગદ્ વા જીવનં વા મરણં વા વર્ત્તમાનં વા ભવિષ્યદ્વા સર્વ્વાણ્યેવ યુષ્માકં,</para>
  <para style="p">
    <verse number="23" style="v"/>યૂયઞ્ચ ખ્રીષ્ટસ્ય, ખ્રીષ્ટશ્ચેશ્વરસ્ય|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>લોકા અસ્માન્ ખ્રીષ્ટસ્ય પરિચારકાન્ ઈશ્વરસ્ય નિગૂઠવાક્યધનસ્યાધ્યક્ષાંશ્ચ મન્યન્તાં|</para>
  <para style="p">
    <verse number="2" style="v"/>કિઞ્ચ ધનાધ્યક્ષેણ વિશ્વસનીયેન ભવિતવ્યમેતદેવ લોકૈ ર્યાચ્યતે|</para>
  <para style="p">
    <verse number="3" style="v"/>અતો વિચારયદ્ભિ ર્યુષ્માભિરન્યૈઃ કૈશ્ચિન્ મનુજૈ ર્વા મમ પરીક્ષણં મયાતીવ લઘુ મન્યતે ઽહમપ્યાત્માનં ન વિચારયામિ|</para>
  <para style="p">
    <verse number="4" style="v"/>મયા કિમપ્યપરાદ્ધમિત્યહં ન વેદ્મિ કિન્ત્વેતેન મમ નિરપરાધત્વં ન નિશ્ચીયતે પ્રભુરેવ મમ વિચારયિતાસ્તિ|</para>
  <para style="p">
    <verse number="5" style="v"/>અત ઉપયુક્તસમયાત્ પૂર્વ્વમ્ અર્થતઃ પ્રભોરાગમનાત્ પૂર્વ્વં યુષ્માભિ ર્વિચારો ન ક્રિયતાં| પ્રભુરાગત્ય તિમિરેણ પ્રચ્છન્નાનિ સર્વ્વાણિ દીપયિષ્યતિ મનસાં મન્ત્રણાશ્ચ પ્રકાશયિષ્યતિ તસ્મિન્ સમય ઈશ્વરાદ્ એકૈકસ્ય પ્રશંસા ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="6" style="v"/>હે ભ્રાતરઃ સર્વ્વાણ્યેતાનિ મયાત્માનમ્ આપલ્લવઞ્ચોદ્દિશ્ય કથિતાનિ તસ્યૈતત્ કારણં યુયં યથા શાસ્ત્રીયવિધિમતિક્રમ્ય માનવમ્ અતીવ નાદરિષ્યધ્બ ઈત્થઞ્ચૈકેન વૈપરીત્યાદ્ અપરેણ ન શ્લાઘિષ્યધ્બ એતાદૃશીં શિક્ષામાવયોર્દૃષ્ટાન્તાત્ લપ્સ્યધ્વે|</para>
  <para style="p">
    <verse number="7" style="v"/>અપરાત્ કસ્ત્વાં વિશેષયતિ? તુભ્યં યન્ન દત્ત તાદૃશં કિં ધારયસિ? અદત્તેનેવ દત્તેન વસ્તુના કુતઃ શ્લાઘસે?</para>
  <para style="p">
    <verse number="8" style="v"/>ઇદાનીમેવ યૂયં કિં તૃપ્તા લબ્ધધના વા? અસ્માસ્વવિદ્યમાનેષુ યૂયં કિં રાજત્વપદં પ્રાપ્તાઃ? યુષ્માકં રાજત્વં મયાભિલષિતં યતસ્તેન યુષ્માભિઃ સહ વયમપિ રાજ્યાંશિનો ભવિષ્યામઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>પ્રેરિતા વયં શેષા હન્તવ્યાશ્ચેવેશ્વરેણ નિદર્શિતાઃ| યતો વયં સર્વ્વલોકાનામ્ અર્થતઃ સ્વર્ગીયદૂતાનાં માનવાનાઞ્ચ કૌતુકાસ્પદાનિ જાતાઃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ખ્રીષ્ટસ્ય કૃતે વયં મૂઢાઃ કિન્તુ યૂયં ખ્રીષ્ટેન જ્ઞાનિનઃ, વયં દુર્બ્બલા યૂયઞ્ચ સબલાઃ, યૂયં સમ્માનિતા વયઞ્ચાપમાનિતાઃ|</para>
  <para style="p">
    <verse number="11" style="v"/>વયમદ્યાપિ ક્ષુધાર્ત્તાસ્તૃષ્ણાર્ત્તા વસ્ત્રહીનાસ્તાડિતા આશ્રમરહિતાશ્ચ સન્તઃ</para>
  <para style="p">
    <verse number="12" style="v"/>કર્મ્મણિ સ્વકરાન્ વ્યાપારયન્તશ્ચ દુઃખૈઃ કાલં યાપયામઃ| ગર્હિતૈરસ્માભિરાશીઃ કથ્યતે દૂરીકૃતૈઃ સહ્યતે નિન્દિતૈઃ પ્રસાદ્યતે|</para>
  <para style="p">
    <verse number="13" style="v"/>વયમદ્યાપિ જગતઃ સમ્માર્જનીયોગ્યા અવકરા ઇવ સર્વ્વૈ ર્મન્યામહે|</para>
  <para style="p">
    <verse number="14" style="v"/>યુષ્માન્ ત્રપયિતુમહમેતાનિ લિખામીતિ નહિ કિન્તુ પ્રિયાત્મજાનિવ યુષ્માન્ પ્રબોધયામિ|</para>
  <para style="p">
    <verse number="15" style="v"/>યતઃ ખ્રીષ્ટધર્મ્મે યદ્યપિ યુષ્માકં દશસહસ્રાણિ વિનેતારો ભવન્તિ તથાપિ બહવો જનકા ન ભવન્તિ યતોઽહમેવ સુસંવાદેન યીશુખ્રીષ્ટે યુષ્માન્ અજનયં|</para>
  <para style="p">
    <verse number="16" style="v"/>અતો યુષ્માન્ વિનયેઽહં યૂયં મદનુગામિનો ભવત|</para>
  <para style="p">
    <verse number="17" style="v"/>ઇત્યર્થં સર્વ્વેષુ ધર્મ્મસમાજેષુ સર્વ્વત્ર ખ્રીષ્ટધર્મ્મયોગ્યા યે વિધયો મયોપદિશ્યન્તે તાન્ યો યુષ્માન્ સ્મારયિષ્યત્યેવમ્ભૂતં પ્રભોઃ કૃતે પ્રિયં વિશ્વાસિનઞ્ચ મદીયતનયં તીમથિયં યુષ્માકં સમીપં પ્રેષિતવાનહં|</para>
  <para style="p">
    <verse number="18" style="v"/>અપરમહં યુષ્માકં સમીપં ન ગમિષ્યામીતિ બુદ્ધ્વા યુષ્માકં કિયન્તો લોકા ગર્વ્વન્તિ|</para>
  <para style="p">
    <verse number="19" style="v"/>કિન્તુ યદિ પ્રભેરિચ્છા ભવતિ તર્હ્યહમવિલમ્બં યુષ્મત્સમીપમુપસ્થાય તેષાં દર્પધ્માતાનાં લોકાનાં વાચં જ્ઞાસ્યામીતિ નહિ સામર્થ્યમેવ જ્ઞાસ્યામિ|</para>
  <para style="p">
    <verse number="20" style="v"/>યસ્માદીશ્વરસ્ય રાજત્વં વાગ્યુક્તં નહિ કિન્તુ સામર્થ્યયુક્તં|</para>
  <para style="p">
    <verse number="21" style="v"/>યુષ્માકં કા વાઞ્છા? યુષ્મત્સમીપે મયા કિં દણ્ડપાણિના ગન્તવ્યમુત પ્રેમનમ્રતાત્મયુક્તેન વા?</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરં યુષ્માકં મધ્યે વ્યભિચારો વિદ્યતે સ ચ વ્યભિચારસ્તાદૃશો યદ્ દેવપૂજકાનાં મધ્યેઽપિ તત્તુલ્યો ન વિદ્યતે ફલતો યુષ્માકમેકો જનો વિમાતૃગમનં કૃરુત ઇતિ વાર્ત્તા સર્વ્વત્ર વ્યાપ્તા|</para>
  <para style="p">
    <verse number="2" style="v"/>તથાચ યૂયં દર્પધ્માતા આધ્બે, તત્ કર્મ્મ યેન કૃતં સ યથા યુષ્મન્મધ્યાદ્ દૂરીક્રિયતે તથા શોકો યુષ્માભિ ર્ન ક્રિયતે કિમ્ એતત્?</para>
  <para style="p">
    <verse number="3" style="v"/>અવિદ્યમાને મદીયશરીરે મમાત્મા યુષ્મન્મધ્યે વિદ્યતે અતોઽહં વિદ્યમાન ઇવ તત્કર્મ્મકારિણો વિચારં નિશ્ચિતવાન્,</para>
  <para style="p">
    <verse number="4" style="v"/>અસ્મત્પ્રભો ર્યીશુખ્રીષ્ટસ્ય નામ્ના યુષ્માકં મદીયાત્મનશ્ચ મિલને જાતે ઽસ્મત્પ્રભો ર્યીશુખ્રીષ્ટસ્ય શક્તેઃ સાહાય્યેન</para>
  <para style="p">
    <verse number="5" style="v"/>સ નરઃ શરીરનાશાર્થમસ્માભિઃ શયતાનો હસ્તે સમર્પયિતવ્યસ્તતોઽસ્માકં પ્રભો ર્યીશો ર્દિવસે તસ્યાત્મા રક્ષાં ગન્તું શક્ષ્યતિ|</para>
  <para style="p">
    <verse number="6" style="v"/>યુષ્માકં દર્પો ન ભદ્રાય યૂયં કિમેતન્ન જાનીથ, યથા, વિકારઃ કૃત્સ્નશક્તૂનાં સ્વલ્પકિણ્વેન જાયતે|</para>
  <para style="p">
    <verse number="7" style="v"/>યૂયં યત્ નવીનશક્તુસ્વરૂપા ભવેત તદર્થં પુરાતનં કિણ્વમ્ અવમાર્જ્જત યતો યુષ્માભિઃ કિણ્વશૂન્યૈ ર્ભવિતવ્યં| અપરમ્ અસ્માકં નિસ્તારોત્સવીયમેષશાવકો યઃ ખ્રીષ્ટઃ સોઽસ્મદર્થં બલીકૃતો ઽભવત્|</para>
  <para style="p">
    <verse number="8" style="v"/>અતઃ પુરાતનકિણ્વેનાર્થતો દુષ્ટતાજિઘાંસારૂપેણ કિણ્વેન તન્નહિ કિન્તુ સારલ્યસત્યત્વરૂપયા કિણ્વશૂન્યતયાસ્માભિરુત્સવઃ કર્ત્તવ્યઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>વ્યાભિચારિણાં સંસર્ગો યુષ્માભિ ર્વિહાતવ્ય ઇતિ મયા પત્રે લિખિતં|</para>
  <para style="p">
    <verse number="10" style="v"/>કિન્ત્વૈહિકલોકાનાં મધ્યે યે વ્યભિચારિણો લોભિન ઉપદ્રાવિણો દેવપૂજકા વા તેષાં સંસર્ગઃ સર્વ્વથા વિહાતવ્ય ઇતિ નહિ, વિહાતવ્યે સતિ યુષ્માભિ ર્જગતો નિર્ગન્તવ્યમેવ|</para>
  <para style="p">
    <verse number="11" style="v"/>કિન્તુ ભ્રાતૃત્વેન વિખ્યાતઃ કશ્ચિજ્જનો યદિ વ્યભિચારી લોભી દેવપૂજકો નિન્દકો મદ્યપ ઉપદ્રાવી વા ભવેત્ તર્હિ તાદૃશેન માનવેન સહ ભોજનપાનેઽપિ યુષ્માભિ ર્ન કર્ત્તવ્યે ઇત્યધુના મયા લિખિતં|</para>
  <para style="p">
    <verse number="12" style="v"/>સમાજબહિઃસ્થિતાનાં લોકાનાં વિચારકરણે મમ કોઽધિકારઃ? કિન્તુ તદન્તર્ગતાનાં વિચારણં યુષ્માભિઃ કિં ન કર્ત્તવ્યં ભવેત્?</para>
  <para style="p">
    <verse number="13" style="v"/>બહિઃસ્થાનાં તુ વિચાર ઈશ્વરેણ કારિષ્યતે| અતો યુષ્માભિઃ સ પાતકી સ્વમધ્યાદ્ બહિષ્ક્રિયતાં|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>યુષ્માકમેકસ્ય જનસ્યાપરેણ સહ વિવાદે જાતે સ પવિત્રલોકૈ ર્વિચારમકારયન્ કિમ્ અધાર્મ્મિકલોકૈ ર્વિચારયિતું પ્રોત્સહતે?</para>
  <para style="p">
    <verse number="2" style="v"/>જગતોઽપિ વિચારણં પવિત્રલોકૈઃ કારિષ્યત એતદ્ યૂયં કિં ન જાનીથ? અતો જગદ્ યદિ યુષ્માભિ ર્વિચારયિતવ્યં તર્હિ ક્ષુદ્રતમવિચારેષુ યૂયં કિમસમર્થાઃ?</para>
  <para style="p">
    <verse number="3" style="v"/>દૂતા અપ્યસ્માભિ ર્વિચારયિષ્યન્ત ઇતિ કિં ન જાનીથ? અત ઐહિકવિષયાઃ કિમ્ અસ્માભિ ર્ન વિચારયિતવ્યા ભવેયુઃ?</para>
  <para style="p">
    <verse number="4" style="v"/>ઐહિકવિષયસ્ય વિચારે યુષ્માભિઃ કર્ત્તવ્યે યે લોકાઃ સમિતૌ ક્ષુદ્રતમાસ્ત એવ નિયુજ્યન્તાં|</para>
  <para style="p">
    <verse number="5" style="v"/>અહં યુષ્માન્ ત્રપયિતુમિચ્છન્ વદામિ યૃષ્મન્મધ્યે કિમેકોઽપિ મનુષ્યસ્તાદૃગ્ બુદ્ધિમાન્નહિ યો ભ્રાતૃવિવાદવિચારણે સમર્થઃ સ્યાત્?</para>
  <para style="p">
    <verse number="6" style="v"/>કિઞ્ચૈકો ભ્રાતા ભ્રાત્રાન્યેન કિમવિશ્વાસિનાં વિચારકાણાં સાક્ષાદ્ વિવદતે? યષ્મન્મધ્યે વિવાદા વિદ્યન્ત એતદપિ યુષ્માકં દોષઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>યૂયં કુતોઽન્યાયસહનં ક્ષતિસહનં વા શ્રેયો ન મન્યધ્વે?</para>
  <para style="p">
    <verse number="8" style="v"/>કિન્તુ યૂયમપિ ભ્રાતૃનેવ પ્રત્યન્યાયં ક્ષતિઞ્ચ કુરુથ કિમેતત્?</para>
  <para style="p">
    <verse number="9" style="v"/>ઈશ્વરસ્ય રાજ્યેઽન્યાયકારિણાં લોકાનામધિકારો નાસ્ત્યેતદ્ યૂયં કિં ન જાનીથ? મા વઞ્ચ્યધ્વં, યે વ્યભિચારિણો દેવાર્ચ્ચિનઃ પારદારિકાઃ સ્ત્રીવદાચારિણઃ પુંમૈથુનકારિણસ્તસ્કરા</para>
  <para style="p">
    <verse number="10" style="v"/>લોભિનો મદ્યપા નિન્દકા ઉપદ્રાવિણો વા ત ઈશ્વરસ્ય રાજ્યભાગિનો ન ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="11" style="v"/>યૂયઞ્ચૈવંવિધા લોકા આસ્ત કિન્તુ પ્રભો ર્યીશો ર્નામ્નાસ્મદીશ્વરસ્યાત્મના ચ યૂયં પ્રક્ષાલિતાઃ પાવિતાઃ સપુણ્યીકૃતાશ્ચ|</para>
  <para style="p">
    <verse number="12" style="v"/>મદર્થં સર્વ્વં દ્રવ્યમ્ અપ્રતિષિદ્ધં કિન્તુ ન સર્વ્વં હિતજનકં| મદર્થં સર્વ્વમપ્રતિષિદ્ધં તથાપ્યહં કસ્યાપિ દ્રવ્યસ્ય વશીકૃતો ન ભવિષ્યામિ|</para>
  <para style="p">
    <verse number="13" style="v"/>ઉદરાય ભક્ષ્યાણિ ભક્ષ્યેભ્યશ્ચોદરં, કિન્તુ ભક્ષ્યોદરે ઈશ્વરેણ નાશયિષ્યેતે; અપરં દેહો ન વ્યભિચારાય કિન્તુ પ્રભવે પ્રભુશ્ચ દેહાય|</para>
  <para style="p">
    <verse number="14" style="v"/>યશ્ચેશ્વરઃ પ્રભુમુત્થાપિતવાન્ સ સ્વશક્ત્યાસ્માનપ્યુત્થાપયિષ્યતિ|</para>
  <para style="p">
    <verse number="15" style="v"/>યુષ્માકં યાનિ શરીરાણિ તાનિ ખ્રીષ્ટસ્યાઙ્ગાનીતિ કિં યૂયં ન જાનીથ? અતઃ ખ્રીષ્ટસ્ય યાન્યઙ્ગાનિ તાનિ મયાપહૃત્ય વેશ્યાયા અઙ્ગાનિ કિં કારિષ્યન્તે? તન્ન ભવતુ|</para>
  <para style="p">
    <verse number="16" style="v"/>યઃ કશ્ચિદ્ વેશ્યાયામ્ આસજ્યતે સ તયા સહૈકદેહો ભવતિ કિં યૂયમેતન્ન જાનીથ? યતો લિખિતમાસ્તે, યથા, તૌ દ્વૌ જનાવેકાઙ્ગૌ ભવિષ્યતઃ|</para>
  <para style="p">
    <verse number="17" style="v"/>માનવા યાન્યન્યાનિ કલુષાણિ કુર્વ્વતે તાનિ વપુ ર્ન સમાવિશન્તિ કિન્તુ વ્યભિચારિણા સ્વવિગ્રહસ્ય વિરુદ્ધં કલ્મષં ક્રિયતે|</para>
  <para style="p">
    <verse number="18" style="v"/>માનવા યાન્યન્યાનિ કલુષાણિ કુર્વ્વતે તાનિ વપુ ર્ન સમાવિશન્તિ કિન્તુ વ્યભિચારિણા સ્વવિગ્રહસ્ય વિરુદ્ધં કલ્મષં ક્રિયતે|</para>
  <para style="p">
    <verse number="19" style="v"/>યુષ્માકં યાનિ વપૂંસિ તાનિ યુષ્મદન્તઃસ્થિતસ્યેશ્વરાલ્લબ્ધસ્ય પવિત્રસ્યાત્મનો મન્દિરાણિ યૂયઞ્ચ સ્વેષાં સ્વામિનો નાધ્વે કિમેતદ્ યુષ્માભિ ર્ન જ્ઞાયતે?</para>
  <para style="p">
    <verse number="20" style="v"/>યૂયં મૂલ્યેન ક્રીતા અતો વપુર્મનોભ્યામ્ ઈશ્વરો યુષ્માભિઃ પૂજ્યતાં યત ઈશ્વર એવ તયોઃ સ્વામી|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરઞ્ચ યુષ્માભિ ર્માં પ્રતિ યત્ પત્રમલેખિ તસ્યોત્તરમેતત્, યોષિતોઽસ્પર્શનં મનુજસ્ય વરં;</para>
  <para style="p">
    <verse number="2" style="v"/>કિન્તુ વ્યભિચારભયાદ્ એકૈકસ્ય પુંસઃ સ્વકીયભાર્ય્યા ભવતુ તદ્વદ્ એકૈકસ્યા યોષિતો ઽપિ સ્વકીયભર્ત્તા ભવતુ|</para>
  <para style="p">
    <verse number="3" style="v"/>ભાર્ય્યાયૈ ભર્ત્રા યદ્યદ્ વિતરણીયં તદ્ વિતીર્ય્યતાં તદ્વદ્ ભર્ત્રેઽપિ ભાર્ય્યયા વિતરણીયં વિતીર્ય્યતાં|</para>
  <para style="p">
    <verse number="4" style="v"/>ભાર્ય્યાયાઃ સ્વદેહે સ્વત્વં નાસ્તિ ભર્ત્તુરેવ, તદ્વદ્ ભર્ત્તુરપિ સ્વદેહે સ્વત્વં નાસ્તિ ભાર્ય્યાયા એવ|</para>
  <para style="p">
    <verse number="5" style="v"/>ઉપોષણપ્રાર્થનયોઃ સેવનાર્થમ્ એકમન્ત્રણાનાં યુષ્માકં કિયત્કાલં યાવદ્ યા પૃથક્સ્થિતિ ર્ભવતિ તદન્યો વિચ્છેદો યુષ્મન્મધ્યે ન ભવતુ, તતઃ પરમ્ ઇન્દ્રિયાણામ્ અધૈર્ય્યાત્ શયતાન્ યદ્ યુષ્માન્ પરીક્ષાં ન નયેત્ તદર્થં પુનરેકત્ર મિલત|</para>
  <para style="p">
    <verse number="6" style="v"/>એતદ્ આદેશતો નહિ કિન્ત્વનુજ્ઞાત એવ મયા કથ્યતે,</para>
  <para style="p">
    <verse number="7" style="v"/>યતો મમાવસ્થેવ સર્વ્વમાનવાનામવસ્થા ભવત્વિતિ મમ વાઞ્છા કિન્ત્વીશ્વરાદ્ એકેનૈકો વરોઽન્યેન ચાન્યો વર ઇત્થમેકૈકેન સ્વકીયવરો લબ્ધઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>અપરમ્ અકૃતવિવાહાન્ વિધવાશ્ચ પ્રતિ મમૈતન્નિવેદનં મમેવ તેષામવસ્થિતિ ર્ભદ્રા;</para>
  <para style="p">
    <verse number="9" style="v"/>કિઞ્ચ યદિ તૈરિન્દ્રિયાણિ નિયન્તું ન શક્યન્તે તર્હિ વિવાહઃ ક્રિયતાં યતઃ કામદહનાદ્ વ્યૂઢત્વં ભદ્રં|</para>
  <para style="p">
    <verse number="10" style="v"/>યે ચ કૃતવિવાહાસ્તે મયા નહિ પ્રભુનૈવૈતદ્ આજ્ઞાપ્યન્તે|</para>
  <para style="p">
    <verse number="11" style="v"/>ભાર્ય્યા ભર્ત્તૃતઃ પૃથક્ ન ભવતુ| યદિ વા પૃથગ્ભૂતા સ્યાત્ તર્હિ નિર્વિવાહા તિષ્ઠતુ સ્વીયપતિના વા સન્દધાતુ ભર્ત્તાપિ ભાર્ય્યાં ન ત્યજતુ|</para>
  <para style="p">
    <verse number="12" style="v"/>ઇતરાન્ જનાન્ પ્રતિ પ્રભુ ર્ન બ્રવીતિ કિન્ત્વહં બ્રવીમિ; કસ્યચિદ્ ભ્રાતુર્યોષિદ્ અવિશ્વાસિની સત્યપિ યદિ તેન સહવાસે તુષ્યતિ તર્હિ સા તેન ન ત્યજ્યતાં|</para>
  <para style="p">
    <verse number="13" style="v"/>તદ્વત્ કસ્યાશ્ચિદ્ યોષિતઃ પતિરવિશ્વાસી સન્નપિ યદિ તયા સહવાસે તુષ્યતિ તર્હિ સ તયા ન ત્યજ્યતાં|</para>
  <para style="p">
    <verse number="14" style="v"/>યતોઽવિશ્વાસી ભર્ત્તા ભાર્ય્યયા પવિત્રીભૂતઃ, તદ્વદવિશ્વાસિની ભાર્ય્યા ભર્ત્રા પવિત્રીભૂતા; નોચેદ્ યુષ્માકમપત્યાન્યશુચીન્યભવિષ્યન્ કિન્ત્વધુના તાનિ પવિત્રાણિ સન્તિ|</para>
  <para style="p">
    <verse number="15" style="v"/>અવિશ્વાસી જનો યદિ વા પૃથગ્ ભવતિ તર્હિ પૃથગ્ ભવતુ; એતેન ભ્રાતા ભગિની વા ન નિબધ્યતે તથાપિ વયમીશ્વરેણ શાન્તયે સમાહૂતાઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>હે નારિ તવ ભર્ત્તુઃ પરિત્રાણં ત્વત્તો ભવિષ્યતિ ન વેતિ ત્વયા કિં જ્ઞાયતે? હે નર તવ જાયાયાઃ પરિત્રાણં ત્વત્તેा ભવિષ્યતિ ન વેતિ ત્વયા કિં જ્ઞાયતે?</para>
  <para style="p">
    <verse number="17" style="v"/>એકૈકો જનઃ પરમેશ્વરાલ્લબ્ધં યદ્ ભજતે યસ્યાઞ્ચાવસ્થાયામ્ ઈશ્વરેણાહ્વાયિ તદનુસારેણૈવાચરતુ તદહં સર્વ્વસમાજસ્થાન્ આદિશામિ|</para>
  <para style="p">
    <verse number="18" style="v"/>છિન્નત્વગ્ ભૃત્વા ય આહૂતઃ સ પ્રકૃષ્ટત્વક્ ન ભવતુ, તદ્વદ્ અછિન્નત્વગ્ ભૂત્વા ય આહૂતઃ સ છિન્નત્વક્ ન ભવતુ|</para>
  <para style="p">
    <verse number="19" style="v"/>ત્વક્છેદઃ સારો નહિ તદ્વદત્વક્છેદોઽપિ સારો નહિ કિન્ત્વીશ્વરસ્યાજ્ઞાનાં પાલનમેવ|</para>
  <para style="p">
    <verse number="20" style="v"/>યો જનો યસ્યામવસ્થાયામાહ્વાયિ સ તસ્યામેવાવતિષ્ઠતાં|</para>
  <para style="p">
    <verse number="21" style="v"/>દાસઃ સન્ ત્વં કિમાહૂતોઽસિ? તન્મા ચિન્તય, તથાચ યદિ સ્વતન્ત્રો ભવિતું શક્નુયાસ્તર્હિ તદેવ વૃણુ|</para>
  <para style="p">
    <verse number="22" style="v"/>યતઃ પ્રભુનાહૂતો યો દાસઃ સ પ્રભો ર્મોચિતજનઃ| તદ્વદ્ તેનાહૂતઃ સ્વતન્ત્રો જનોઽપિ ખ્રીષ્ટસ્ય દાસ એવ|</para>
  <para style="p">
    <verse number="23" style="v"/>યૂયં મૂલ્યેન ક્રીતા અતો હેતો ર્માનવાનાં દાસા મા ભવત|</para>
  <para style="p">
    <verse number="24" style="v"/>હે ભ્રાતરો યસ્યામવસ્થાયાં યસ્યાહ્વાનમભવત્ તયા સ ઈશ્વરસ્ય સાક્ષાત્ તિષ્ઠતુ|</para>
  <para style="p">
    <verse number="25" style="v"/>અપરમ્ અકૃતવિવાહાન્ જનાન્ પ્રતિ પ્રભોઃ કોઽપ્યાદેશો મયા ન લબ્ધઃ કિન્તુ પ્રભોરનુકમ્પયા વિશ્વાસ્યો ભૂતોઽહં યદ્ ભદ્રં મન્યે તદ્ વદામિ|</para>
  <para style="p">
    <verse number="26" style="v"/>વર્ત્તમાનાત્ ક્લેશસમયાત્ મનુષ્યસ્યાનૂઢત્વં ભદ્રમિતિ મયા બુધ્યતે|</para>
  <para style="p">
    <verse number="27" style="v"/>ત્વં કિં યોષિતિ નિબદ્ધોઽસિ તર્હિ મોચનં પ્રાપ્તું મા યતસ્વ| કિં વા યોષિતો મુક્તોઽસિ? તર્હિ જાયાં મા ગવેષય|</para>
  <para style="p">
    <verse number="28" style="v"/>વિવાહં કુર્વ્વતા ત્વયા કિમપિ નાપારાધ્યતે તદ્વદ્ વ્યૂહ્યમાનયા યુવત્યાપિ કિમપિ નાપરાધ્યતે તથાચ તાદૃશૌ દ્વૌ જનૌ શારીરિકં ક્લેશં લપ્સ્યેતે કિન્તુ યુષ્માન્ પ્રતિ મમ કરુણા વિદ્યતે|</para>
  <para style="p">
    <verse number="29" style="v"/>હે ભ્રાતરોઽહમિદં બ્રવીમિ, ઇતઃ પરં સમયોઽતીવ સંક્ષિપ્તઃ,</para>
  <para style="p">
    <verse number="30" style="v"/>અતઃ કૃતદારૈરકૃતદારૈરિવ રુદદ્ભિશ્ચારુદદ્ભિરિવ સાનન્દૈશ્ચ નિરાનન્દૈરિવ ક્રેતૃભિશ્ચાભાગિભિરિવાચરિતવ્યં</para>
  <para style="p">
    <verse number="31" style="v"/>યે ચ સંસારે ચરન્તિ તૈ ર્નાતિચરિતવ્યં યત ઇહલેाકસ્ય કૌતુકો વિચલતિ|</para>
  <para style="p">
    <verse number="32" style="v"/>કિન્તુ યૂયં યન્નિશ્ચિન્તા ભવેતેતિ મમ વાઞ્છા| અકૃતવિવાહો જનો યથા પ્રભું પરિતોષયેત્ તથા પ્રભું ચિન્તયતિ,</para>
  <para style="p">
    <verse number="33" style="v"/>કિન્તુ કૃતવિવાહો જનો યથા ભાર્ય્યાં પરિતોષયેત્ તથા સંસારં ચિન્તયતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>તદ્વદ્ ઊઢયોષિતો ઽનૂઢા વિશિષ્યતે| યાનૂઢા સા યથા કાયમનસોઃ પવિત્રા ભવેત્ તથા પ્રભું ચિન્તયતિ યા ચોઢા સા યથા ભર્ત્તારં પરિતોષયેત્ તથા સંસારં ચિન્તયતિ|</para>
  <para style="p">
    <verse number="35" style="v"/>અહં યદ્ યુષ્માન્ મૃગબન્ધિન્યા પરિક્ષિપેયં તદર્થં નહિ કિન્તુ યૂયં યદનિન્દિતા ભૂત્વા પ્રભોઃ સેવનેઽબાધમ્ આસક્તા ભવેત તદર્થમેતાનિ સર્વ્વાણિ યુષ્માકં હિતાય મયા કથ્યન્તે|</para>
  <para style="p">
    <verse number="36" style="v"/>કસ્યચિત્ કન્યાયાં યૌવનપ્રાપ્તાયાં યદિ સ તસ્યા અનૂઢત્વં નિન્દનીયં વિવાહશ્ચ સાધયિતવ્ય ઇતિ મન્યતે તર્હિ યથાભિલાષં કરોતુ, એતેન કિમપિ નાપરાત્સ્યતિ વિવાહઃ ક્રિયતાં|</para>
  <para style="p">
    <verse number="37" style="v"/>કિન્તુ દુઃખેનાક્લિષ્ટઃ કશ્ચિત્ પિતા યદિ સ્થિરમનોગતઃ સ્વમનોઽભિલાષસાધને સમર્થશ્ચ સ્યાત્ મમ કન્યા મયા રક્ષિતવ્યેતિ મનસિ નિશ્ચિનોતિ ચ તર્હિ સ ભદ્રં કર્મ્મ કરોતિ|</para>
  <para style="p">
    <verse number="38" style="v"/>અતો યો વિવાહં કરોતિ સ ભદ્રં કર્મ્મ કરોતિ યશ્ચ વિવાહં ન કરોતિ સ ભદ્રતરં કર્મ્મ કરોતિ|</para>
  <para style="p">
    <verse number="39" style="v"/>યાવત્કાલં પતિ ર્જીવતિ તાવદ્ ભાર્ય્યા વ્યવસ્થયા નિબદ્ધા તિષ્ઠતિ કિન્તુ પત્યૌ મહાનિદ્રાં ગતે સા મુક્તીભૂય યમભિલષતિ તેન સહ તસ્યા વિવાહો ભવિતું શક્નોતિ, કિન્ત્વેતત્ કેવલં પ્રભુભક્તાનાં મધ્યે|</para>
  <para style="p">
    <verse number="40" style="v"/>તથાચ સા યદિ નિષ્પતિકા તિષ્ઠતિ તર્હિ તસ્યાઃ ક્ષેમં ભવિષ્યતીતિ મમ ભાવઃ| અપરમ્ ઈશ્વરસ્યાત્મા મમાપ્યન્ત ર્વિદ્યત ઇતિ મયા બુધ્યતે|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>દેવપ્રસાદે સર્વ્વેષામ્ અસ્માકં જ્ઞાનમાસ્તે તદ્વયં વિદ્મઃ| તથાપિ જ્ઞાનં ગર્વ્વં જનયતિ કિન્તુ પ્રેમતો નિષ્ઠા જાયતે|</para>
  <para style="p">
    <verse number="2" style="v"/>અતઃ કશ્ચન યદિ મન્યતે મમ જ્ઞાનમાસ્ત ઇતિ તર્હિ તેન યાદૃશં જ્ઞાનં ચેષ્ટિતવ્યં તાદૃશં કિમપિ જ્ઞાનમદ્યાપિ ન લબ્ધં|</para>
  <para style="p">
    <verse number="3" style="v"/>કિન્તુ ય ઈશ્વરે પ્રીયતે સ ઈશ્વરેણાપિ જ્ઞાયતે|</para>
  <para style="p">
    <verse number="4" style="v"/>દેવતાબલિપ્રસાદભક્ષણે વયમિદં વિદ્મો યત્ જગન્મધ્યે કોઽપિ દેવો ન વિદ્યતે, એકશ્ચેશ્વરો દ્વિતીયો નાસ્તીતિ|</para>
  <para style="p">
    <verse number="5" style="v"/>સ્વર્ગે પૃથિવ્યાં વા યદ્યપિ કેષુચિદ્ ઈશ્વર ઇતિ નામારોપ્યતે તાદૃશાશ્ચ બહવ ઈશ્વરા બહવશ્ચ પ્રભવો વિદ્યન્તે</para>
  <para style="p">
    <verse number="6" style="v"/>તથાપ્યસ્માકમદ્વિતીય ઈશ્વરઃ સ પિતા યસ્માત્ સર્વ્વેષાં યદર્થઞ્ચાસ્માકં સૃષ્ટિ ર્જાતા, અસ્માકઞ્ચાદ્વિતીયઃ પ્રભુઃ સ યીશુઃ ખ્રીષ્ટો યેન સર્વ્વવસ્તૂનાં યેનાસ્માકમપિ સૃષ્ટિઃ કૃતા|</para>
  <para style="p">
    <verse number="7" style="v"/>અધિકન્તુ જ્ઞાનં સર્વ્વેષાં નાસ્તિ યતઃ કેચિદદ્યાપિ દેવતાં સમ્મન્ય દેવપ્રસાદમિવ તદ્ ભક્ષ્યં ભુઞ્જતે તેન દુર્બ્બલતયા તેષાં સ્વાન્તાનિ મલીમસાનિ ભવન્તિ|</para>
  <para style="p">
    <verse number="8" style="v"/>કિન્તુ ભક્ષ્યદ્રવ્યાદ્ વયમ્ ઈશ્વરેણ ગ્રાહ્યા ભવામસ્તન્નહિ યતો ભુઙ્ક્ત્વા વયમુત્કૃષ્ટા ન ભવામસ્તદ્વદભુઙ્ક્ત્વાપ્યપકૃષ્ટા ન ભવામઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>અતો યુષ્માકં યા ક્ષમતા સા દુર્બ્બલાનામ્ ઉન્માથસ્વરૂપા યન્ન ભવેત્ તદર્થં સાવધાના ભવત|</para>
  <para style="p">
    <verse number="10" style="v"/>યતો જ્ઞાનવિશિષ્ટસ્ત્વં યદિ દેવાલયે ઉપવિષ્ટઃ કેનાપિ દૃશ્યસે તર્હિ તસ્ય દુર્બ્બલસ્ય મનસિ કિં પ્રસાદભક્ષણ ઉત્સાહો ન જનિષ્યતે?</para>
  <para style="p">
    <verse number="11" style="v"/>તથા સતિ યસ્ય કૃતે ખ્રીષ્ટો મમાર તવ સ દુર્બ્બલો ભ્રાતા તવ જ્ઞાનાત્ કિં ન વિનંક્ષ્યતિ?</para>
  <para style="p">
    <verse number="12" style="v"/>ઇત્યનેન પ્રકારેણ ભ્રાતૃણાં વિરુદ્ધમ્ અપરાધ્યદ્ભિસ્તેષાં દુર્બ્બલાનિ મનાંસિ વ્યાઘાતયદ્ભિશ્ચ યુષ્માભિઃ ખ્રીષ્ટસ્ય વૈપરીત્યેનાપરાધ્યતે|</para>
  <para style="p">
    <verse number="13" style="v"/>અતો હેતોઃ પિશિતાશનં યદિ મમ ભ્રાતુ ર્વિઘ્નસ્વરૂપં ભવેત્ તર્હ્યહં યત્ સ્વભ્રાતુ ર્વિઘ્નજનકો ન ભવેયં તદર્થં યાવજ્જીવનં પિશિતં ન ભોક્ષ્યે|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અહં કિમ્ એકઃ પ્રેરિતો નાસ્મિ? કિમહં સ્વતન્ત્રો નાસ્મિ? અસ્માકં પ્રભુ ર્યીશુઃ ખ્રીષ્ટઃ કિં મયા નાદર્શિ? યૂયમપિ કિં પ્રભુના મદીયશ્રમફલસ્વરૂપા ન ભવથ?</para>
  <para style="p">
    <verse number="2" style="v"/>અન્યલોકાનાં કૃતે યદ્યપ્યહં પ્રેરિતો ન ભવેયં તથાચ યુષ્મત્કૃતે પ્રેરિતોઽસ્મિ યતઃ પ્રભુના મમ પ્રેરિતત્વપદસ્ય મુદ્રાસ્વરૂપા યૂયમેવાધ્વે|</para>
  <para style="p">
    <verse number="3" style="v"/>યે લોકા મયિ દોષમારોપયન્તિ તાન્ પ્રતિ મમ પ્રત્યુત્તરમેતત્|</para>
  <para style="p">
    <verse number="4" style="v"/>ભોજનપાનયોઃ કિમસ્માકં ક્ષમતા નાસ્તિ?</para>
  <para style="p">
    <verse number="5" style="v"/>અન્યે પ્રેરિતાઃ પ્રભો ર્ભ્રાતરૌ કૈફાશ્ચ યત્ કુર્વ્વન્તિ તદ્વત્ કાઞ્ચિત્ ધર્મ્મભગિનીં વ્યૂહ્ય તયા સાર્દ્ધં પર્ય્યટિતું વયં કિં ન શક્નુમઃ?</para>
  <para style="p">
    <verse number="6" style="v"/>સાંસારિકશ્રમસ્ય પરિત્યાગાત્ કિં કેવલમહં બર્ણબ્બાશ્ચ નિવારિતૌ?</para>
  <para style="p">
    <verse number="7" style="v"/>નિજધનવ્યયેન કઃ સંગ્રામં કરોતિ? કો વા દ્રાક્ષાક્ષેત્રં કૃત્વા તત્ફલાનિ ન ભુઙ્ક્તે? કો વા પશુવ્રજં પાલયન્ તત્પયો ન પિવતિ?</para>
  <para style="p">
    <verse number="8" style="v"/>કિમહં કેવલાં માનુષિકાં વાચં વદામિ? વ્યવસ્થાયાં કિમેતાદૃશં વચનં ન વિદ્યતે?</para>
  <para style="p">
    <verse number="9" style="v"/>મૂસાવ્યવસ્થાગ્રન્થે લિખિતમાસ્તે, ત્વં શસ્યમર્દ્દકવૃષસ્યાસ્યં ન ભંત્સ્યસીતિ| ઈશ્વરેણ બલીવર્દ્દાનામેવ ચિન્તા કિં ક્રિયતે?</para>
  <para style="p">
    <verse number="10" style="v"/>કિં વા સર્વ્વથાસ્માકં કૃતે તદ્વચનં તેનોક્તં? અસ્માકમેવ કૃતે તલ્લિખિતં| યઃ ક્ષેત્રં કર્ષતિ તેન પ્રત્યાશાયુક્તેન કર્ષ્ટવ્યં, યશ્ચ શસ્યાનિ મર્દ્દયતિ તેન લાભપ્રત્યાશાયુક્તેન મર્દ્દિતવ્યં|</para>
  <para style="p">
    <verse number="11" style="v"/>યુષ્મત્કૃતેઽસ્માભિઃ પારત્રિકાણિ બીજાનિ રોપિતાનિ, અતો યુષ્માકમૈહિકફલાનાં વયમ્ અંશિનો ભવિષ્યામઃ કિમેતત્ મહત્ કર્મ્મ?</para>
  <para style="p">
    <verse number="12" style="v"/>યુષ્માસુ યોઽધિકારસ્તસ્ય ભાગિનો યદ્યન્યે ભવેયુસ્તર્હ્યસ્માભિસ્તતોઽધિકં કિં તસ્ય ભાગિભિ ર્ન ભવિતવ્યં? અધિકન્તુ વયં તેનાધિકારેણ ન વ્યવહૃતવન્તઃ કિન્તુ ખ્રીષ્ટીયસુસંવાદસ્ય કોઽપિ વ્યાઘાતોઽસ્માભિર્યન્ન જાયેત તદર્થં સર્વ્વં સહામહે|</para>
  <para style="p">
    <verse number="13" style="v"/>અપરં યે પવિત્રવસ્તૂનાં પરિચર્ય્યાં કુર્વ્વન્તિ તે પવિત્રવસ્તુતો ભક્ષ્યાણિ લભન્તે, યે ચ વેદ્યાઃ પરિચર્ય્યાં કુર્વ્વન્તિ તે વેદિસ્થવસ્તૂનામ્ અંશિનો ભવન્ત્યેતદ્ યૂયં કિં ન વિદ?</para>
  <para style="p">
    <verse number="14" style="v"/>તદ્વદ્ યે સુસંવાદં ઘોષયન્તિ તૈઃ સુસંવાદેન જીવિતવ્યમિતિ પ્રભુનાદિષ્ટં|</para>
  <para style="p">
    <verse number="15" style="v"/>અહમેતેષાં સર્વ્વેષાં કિમપિ નાશ્રિતવાન્ માં પ્રતિ તદનુસારાત્ આચરિતવ્યમિત્યાશયેનાપિ પત્રમિદં મયા ન લિખ્યતે યતઃ કેનાપિ જનેન મમ યશસો મુધાકરણાત્ મમ મરણં વરં|</para>
  <para style="p">
    <verse number="16" style="v"/>સુસંવાદઘેષણાત્ મમ યશો ન જાયતે યતસ્તદ્ઘોષણં મમાવશ્યકં યદ્યહં સુસંવાદં ન ઘોષયેયં તર્હિ માં ધિક્|</para>
  <para style="p">
    <verse number="17" style="v"/>ઇચ્છુકેન તત્ કુર્વ્વતા મયા ફલં લપ્સ્યતે કિન્ત્વનિચ્છુકેઽપિ મયિ તત્કર્મ્મણો ભારોઽર્પિતોઽસ્તિ|</para>
  <para style="p">
    <verse number="18" style="v"/>એતેન મયા લભ્યં ફલં કિં? સુસંવાદેન મમ યોઽધિકાર આસ્તે તં યદભદ્રભાવેન નાચરેયં તદર્થં સુસંવાદઘોષણસમયે તસ્ય ખ્રીષ્ટીયસુસંવાદસ્ય નિર્વ્યયીકરણમેવ મમ ફલં|</para>
  <para style="p">
    <verse number="19" style="v"/>સર્વ્વેષામ્ અનાયત્તોઽહં યદ્ ભૂરિશો લોકાન્ પ્રતિપદ્યે તદર્થં સર્વ્વેષાં દાસત્વમઙ્ગીકૃતવાન્|</para>
  <para style="p">
    <verse number="20" style="v"/>યિહૂદીયાન્ યત્ પ્રતિપદ્યે તદર્થં યિહૂદીયાનાં કૃતે યિહૂદીયઇવાભવં| યે ચ વ્યવસ્થાયત્તાસ્તાન્ યત્ પ્રતિપદ્યે તદર્થં વ્યવસ્થાનાયત્તો યોઽહં સોઽહં વ્યવસ્થાયત્તાનાં કૃતે વ્યવસ્થાયત્તઇવાભવં|</para>
  <para style="p">
    <verse number="21" style="v"/>યે ચાલબ્ધવ્યવસ્થાસ્તાન્ યત્ પ્રતિપદ્યે તદર્થમ્ ઈશ્વરસ્ય સાક્ષાદ્ અલબ્ધવ્યવસ્થો ન ભૂત્વા ખ્રીષ્ટેન લબ્ધવ્યવસ્થો યોઽહં સોઽહમ્ અલબ્ધવ્યવસ્થાનાં કૃતેઽલબ્ધવ્યવસ્થ ઇવાભવં|</para>
  <para style="p">
    <verse number="22" style="v"/>દુર્બ્બલાન્ યત્ પ્રતિપદ્યે તદર્થમહં દુર્બ્બલાનાં કૃતે દુર્બ્બલઇવાભવં| ઇત્થં કેનાપિ પ્રકારેણ કતિપયા લોકા યન્મયા પરિત્રાણં પ્રાપ્નુયુસ્તદર્થં યો યાદૃશ આસીત્ તસ્ય કૃતે ઽહં તાદૃશઇવાભવં|</para>
  <para style="p">
    <verse number="23" style="v"/>ઇદૃશ આચારઃ સુસંવાદાર્થં મયા ક્રિયતે યતોઽહં તસ્ય ફલાનાં સહભાગી ભવિતુમિચ્છામિ|</para>
  <para style="p">
    <verse number="24" style="v"/>પણ્યલાભાર્થં યે ધાવન્તિ ધાવતાં તેષાં સર્વ્વેષાં કેવલ એકઃ પણ્યં લભતે યુષ્માભિઃ કિમેતન્ન જ્ઞાયતે? અતો યૂયં યથા પણ્યં લપ્સ્યધ્વે તથૈવ ધાવત|</para>
  <para style="p">
    <verse number="25" style="v"/>મલ્લા અપિ સર્વ્વભોગે પરિમિતભોગિનો ભવન્તિ તે તુ મ્લાનાં સ્રજં લિપ્સન્તે કિન્તુ વયમ્ અમ્લાનાં લિપ્સામહે|</para>
  <para style="p">
    <verse number="26" style="v"/>તસ્માદ્ અહમપિ ધાવામિ કિન્તુ લક્ષ્યમનુદ્દિશ્ય ધાવામિ તન્નહિ| અહં મલ્લઇવ યુધ્યામિ ચ કિન્તુ છાયામાઘાતયન્નિવ યુધ્યામિ તન્નહિ|</para>
  <para style="p">
    <verse number="27" style="v"/>ઇતરાન્ પ્રતિ સુસંવાદં ઘોષયિત્વાહં યત્ સ્વયમગ્રાહ્યો ન ભવામિ તદર્થં દેહમ્ આહન્મિ વશીકુર્વ્વે ચ|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે ભ્રાતરઃ, અસ્મત્પિતૃપુરુષાનધિ યૂયં યદજ્ઞાતા ન તિષ્ઠતેતિ મમ વાઞ્છા, તે સર્વ્વે મેઘાધઃસ્થિતા બભૂવુઃ સર્વ્વે સમુદ્રમધ્યેન વવ્રજુઃ,</para>
  <para style="p">
    <verse number="2" style="v"/>સર્વ્વે મૂસામુદ્દિશ્ય મેઘસમુદ્રયો ર્મજ્જિતા બભૂવુઃ</para>
  <para style="p">
    <verse number="3" style="v"/>સર્વ્વ એકમ્ આત્મિકં ભક્ષ્યં બુભુજિર એકમ્ આત્મિકં પેયં પપુશ્ચ</para>
  <para style="p">
    <verse number="4" style="v"/>યતસ્તેઽનુચરત આત્મિકાદ્ અચલાત્ લબ્ધં તોયં પપુઃ સોઽચલઃ ખ્રીષ્ટએવ|</para>
  <para style="p">
    <verse number="5" style="v"/>તથા સત્યપિ તેષાં મધ્યેઽધિકેષુ લોકેષ્વીશ્વરો ન સન્તુતોષેતિ હેતોસ્તે પ્રન્તરે નિપાતિતાઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>એતસ્મિન્ તે ઽસ્માકં નિદર્શનસ્વરૂપા બભૂવુઃ; અતસ્તે યથા કુત્સિતાભિલાષિણો બભૂવુરસ્માભિસ્તથા કુત્સિતાભિલાષિભિ ર્ન ભવિતવ્યં|</para>
  <para style="p">
    <verse number="7" style="v"/>લિખિતમાસ્તે, લોકા ભોક્તું પાતુઞ્ચોપવિવિશુસ્તતઃ ક્રીડિતુમુત્થિતા ઇતયનેન પ્રકારેણ તેષાં કૈશ્ચિદ્ યદ્વદ્ દેવપૂજા કૃતા યુષ્માભિસ્તદ્વત્ ન ક્રિયતાં|</para>
  <para style="p">
    <verse number="8" style="v"/>અપરં તેષાં કૈશ્ચિદ્ યદ્વદ્ વ્યભિચારઃ કૃતસ્તેન ચૈકસ્મિન્ દિને ત્રયોવિંશતિસહસ્રાણિ લોકા નિપાતિતાસ્તદ્વદ્ અસ્માભિ ર્વ્યભિચારો ન કર્ત્તવ્યઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>તેષાં કેચિદ્ યદ્વત્ ખ્રીષ્ટં પરીક્ષિતવન્તસ્તસ્માદ્ ભુજઙ્ગૈ ર્નષ્ટાશ્ચ તદ્વદ્ અસ્માભિઃ ખ્રીષ્ટો ન પરીક્ષિતવ્યઃ|</para>
  <para style="p">
    <verse number="10" style="v"/>તેષાં કેચિદ્ યથા વાક્કલહં કૃતવન્તસ્તત્કારણાત્ હન્ત્રા વિનાશિતાશ્ચ યુષ્માભિસ્તદ્વદ્ વાક્કલહો ન ક્રિયતાં|</para>
  <para style="p">
    <verse number="11" style="v"/>તાન્ પ્રતિ યાન્યેતાનિ જઘટિરે તાન્યસ્માકં નિદર્શનાનિ જગતઃ શેષયુગે વર્ત્તમાનાનામ્ અસ્માકં શિક્ષાર્થં લિખિતાનિ ચ બભૂવુઃ|</para>
  <para style="p">
    <verse number="12" style="v"/>અતએવ યઃ કશ્ચિદ્ સુસ્થિરંમન્યઃ સ યન્ન પતેત્ તત્ર સાવધાનો ભવતુ|</para>
  <para style="p">
    <verse number="13" style="v"/>માનુષિકપરીક્ષાતિરિક્તા કાપિ પરીક્ષા યુષ્માન્ નાક્રામત્, ઈશ્વરશ્ચ વિશ્વાસ્યઃ સોઽતિશક્ત્યાં પરીક્ષાયાં પતનાત્ યુષ્માન્ રક્ષિષ્યતિ, પરીક્ષા ચ યદ્ યુષ્માભિઃ સોઢું શક્યતે તદર્થં તયા સહ નિસ્તારસ્ય પન્થાનં નિરૂપયિષ્યતિ|</para>
  <para style="p">
    <verse number="14" style="v"/>હે પ્રિયભ્રાતરઃ, દેવપૂજાતો દૂરમ્ અપસરત|</para>
  <para style="p">
    <verse number="15" style="v"/>અહં યુષ્માન્ વિજ્ઞાન્ મત્વા પ્રભાષે મયા યત્ કથ્યતે તદ્ યુષ્માભિ ર્વિવિચ્યતાં|</para>
  <para style="p">
    <verse number="16" style="v"/>યદ્ ધન્યવાદપાત્રમ્ અસ્માભિ ર્ધન્યં ગદ્યતે તત્ કિં ખ્રીષ્ટસ્ય શોણિતસ્ય સહભાગિત્વં નહિ? યશ્ચ પૂપોઽસ્માભિ ર્ભજ્યતે સ કિં ખ્રીષ્ટસ્ય વપુષઃ સહભાગિત્વં નહિ?</para>
  <para style="p">
    <verse number="17" style="v"/>વયં બહવઃ સન્તોઽપ્યેકપૂપસ્વરૂપા એકવપુઃસ્વરૂપાશ્ચ ભવામઃ, યતો વયં સર્વ્વ એકપૂપસ્ય સહભાગિનઃ|</para>
  <para style="p">
    <verse number="18" style="v"/>યૂયં શારીરિકમ્ ઇસ્રાયેલીયવંશં નિરીક્ષધ્વં| યે બલીનાં માંસાનિ ભુઞ્જતે તે કિં યજ્ઞવેદ્યાઃ સહભાગિનો ન ભવન્તિ?</para>
  <para style="p">
    <verse number="19" style="v"/>ઇત્યનેન મયા કિં કથ્યતે? દેવતા વાસ્તવિકી દેવતાયૈ બલિદાનં વા વાસ્તવિકં કિં ભવેત્?</para>
  <para style="p">
    <verse number="20" style="v"/>તન્નહિ કિન્તુ ભિન્નજાતિભિ ર્યે બલયો દીયન્તે ત ઈશ્વરાય તન્નહિ ભૂતેભ્યએવ દીયન્તે તસ્માદ્ યૂયં યદ્ ભૂતાનાં સહભાગિનો ભવથેત્યહં નાભિલષામિ|</para>
  <para style="p">
    <verse number="21" style="v"/>પ્રભોઃ કંસેન ભૂતાનામપિ કંસેન પાનં યુષ્માભિરસાધ્યં; યૂયં પ્રભો ર્ભોજ્યસ્ય ભૂતાનામપિ ભોજ્યસ્ય સહભાગિનો ભવિતું ન શક્નુથ|</para>
  <para style="p">
    <verse number="22" style="v"/>વયં કિં પ્રભું સ્પર્દ્ધિષ્યામહે? વયં કિં તસ્માદ્ બલવન્તઃ?</para>
  <para style="p">
    <verse number="23" style="v"/>માં પ્રતિ સર્વ્વં કર્મ્માપ્રતિષિદ્ધં કિન્તુ ન સર્વ્વં હિતજનકં સર્વ્વમ્ અપ્રતિષિદ્ધં કિન્તુ ન સર્વ્વં નિષ્ઠાજનકં|</para>
  <para style="p">
    <verse number="24" style="v"/>આત્મહિતઃ કેનાપિ ન ચેષ્ટિતવ્યઃ કિન્તુ સર્વ્વૈઃ પરહિતશ્ચેષ્ટિતવ્યઃ|</para>
  <para style="p">
    <verse number="25" style="v"/>આપણે યત્ ક્રય્યં તદ્ યુષ્માભિઃ સંવેદસ્યાર્થં કિમપિ ન પૃષ્ટ્વા ભુજ્યતાં</para>
  <para style="p">
    <verse number="26" style="v"/>યતઃ પૃથિવી તન્મધ્યસ્થઞ્ચ સર્વ્વં પરમેશ્વરસ્ય|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરમ્ અવિશ્વાસિલોકાનાં કેનચિત્ નિમન્ત્રિતા યૂયં યદિ તત્ર જિગમિષથ તર્હિ તેન યદ્ યદ્ ઉપસ્થાપ્યતે તદ્ યુષ્માભિઃ સંવેદસ્યાર્થં કિમપિ ન પૃષ્ટ્વા ભુજ્યતાં|</para>
  <para style="p">
    <verse number="28" style="v"/>કિન્તુ તત્ર યદિ કશ્ચિદ્ યુષ્માન્ વદેત્ ભક્ષ્યમેતદ્ દેવતાયાઃ પ્રસાદ ઇતિ તર્હિ તસ્ય જ્ઞાપયિતુરનુરોધાત્ સંવેદસ્યાર્થઞ્ચ તદ્ યુષ્માભિ ર્ન ભોક્તવ્યં| પૃથિવી તન્મધ્યસ્થઞ્ચ સર્વ્વં પરમેશ્વરસ્ય,</para>
  <para style="p">
    <verse number="29" style="v"/>સત્યમેતત્, કિન્તુ મયા યઃ સંવેદો નિર્દ્દિશ્યતે સ તવ નહિ પરસ્યૈવ|</para>
  <para style="p">
    <verse number="30" style="v"/>અનુગ્રહપાત્રેણ મયા ધન્યવાદં કૃત્વા યદ્ ભુજ્યતે તત્કારણાદ્ અહં કુતો નિન્દિષ્યે?</para>
  <para style="p">
    <verse number="31" style="v"/>તસ્માદ્ ભોજનં પાનમ્ અન્યદ્વા કર્મ્મ કુર્વ્વદ્ભિ ર્યુષ્માભિઃ સર્વ્વમેવેશ્વરસ્ય મહિમ્નઃ પ્રકાશાર્થં ક્રિયતાં|</para>
  <para style="p">
    <verse number="32" style="v"/>યિહૂદીયાનાં ભિન્નજાતીયાનામ્ ઈશ્વરસ્ય સમાજસ્ય વા વિઘ્નજનકૈ ર્યુષ્માભિ ર્ન ભવિતવ્યં|</para>
  <para style="p">
    <verse number="33" style="v"/>અહમપ્યાત્મહિતમ્ અચેષ્ટમાનો બહૂનાં પરિત્રાણાર્થં તેષાં હિતં ચેષ્ટમાનઃ સર્વ્વવિષયે સર્વ્વેષાં તુષ્ટિકરો ભવામીત્યનેનાહં યદ્વત્ ખ્રીષ્ટસ્યાનુગામી તદ્વદ્ યૂયં મમાનુગામિનો ભવત|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે ભ્રાતરઃ, યૂયં સર્વ્વસ્મિન્ કાર્ય્યે માં સ્મરથ મયા ચ યાદૃગુપદિષ્ટાસ્તાદૃગાચરથૈતત્કારણાત્ મયા પ્રશંસનીયા આધ્બે|</para>
  <para style="p">
    <verse number="2" style="v"/>તથાપિ મમૈષા વાઞ્છા યદ્ યૂયમિદમ્ અવગતા ભવથ,</para>
  <para style="p">
    <verse number="3" style="v"/>એકૈકસ્ય પુરુષસ્યોત્તમાઙ્ગસ્વરૂપઃ ખ્રીષ્ટઃ, યોષિતશ્ચોત્તમાઙ્ગસ્વરૂપઃ પુમાન્, ખ્રીષ્ટસ્ય ચોત્તમાઙ્ગસ્વરૂપ ઈશ્વરઃ|</para>
  <para style="p">
    <verse number="4" style="v"/>અપરમ્ આચ્છાદિતોત્તમાઙ્ગેન યેન પુંસા પ્રાર્થના ક્રિયત ઈશ્વરીયવાણી કથ્યતે વા તેન સ્વીયોત્તમાઙ્ગમ્ અવજ્ઞાયતે|</para>
  <para style="p">
    <verse number="5" style="v"/>અનાચ્છાદિતોત્તમાઙ્ગયા યયા યોષિતા ચ પ્રાર્થના ક્રિયત ઈશ્વરીયવાણી કથ્યતે વા તયાપિ સ્વીયોત્તમાઙ્ગમ્ અવજ્ઞાયતે યતઃ સા મુણ્ડિતશિરઃસદૃશા|</para>
  <para style="p">
    <verse number="6" style="v"/>અનાચ્છાદિતમસ્તકા યા યોષિત્ તસ્યાઃ શિરઃ મુણ્ડનીયમેવ કિન્તુ યોષિતઃ કેશચ્છેદનં શિરોમુણ્ડનં વા યદિ લજ્જાજનકં ભવેત્ તર્હિ તયા સ્વશિર આચ્છાદ્યતાં|</para>
  <para style="p">
    <verse number="7" style="v"/>પુમાન્ ઈશ્વરસ્ય પ્રતિમૂર્ત્તિઃ પ્રતિતેજઃસ્વરૂપશ્ચ તસ્માત્ તેન શિરો નાચ્છાદનીયં કિન્તુ સીમન્તિની પુંસઃ પ્રતિબિમ્બસ્વરૂપા|</para>
  <para style="p">
    <verse number="8" style="v"/>યતો યોષાતઃ પુમાન્ નોદપાદિ કિન્તુ પુંસો યોષિદ્ ઉદપાદિ|</para>
  <para style="p">
    <verse number="9" style="v"/>અધિકન્તુ યોષિતઃ કૃતે પુંસઃ સૃષ્ટિ ર્ન બભૂવ કિન્તુ પુંસઃ કૃતે યોષિતઃ સૃષ્ટિ ર્બભૂવ|</para>
  <para style="p">
    <verse number="10" style="v"/>ઇતિ હેતો ર્દૂતાનામ્ આદરાદ્ યોષિતા શિરસ્યધીનતાસૂચકમ્ આવરણં ધર્ત્તવ્યં|</para>
  <para style="p">
    <verse number="11" style="v"/>તથાપિ પ્રભો ર્વિધિના પુમાંસં વિના યોષિન્ન જાયતે યોષિતઞ્ચ વિના પુમાન્ ન જાયતે|</para>
  <para style="p">
    <verse number="12" style="v"/>યતો યથા પુંસો યોષિદ્ ઉદપાદિ તથા યોષિતઃ પુમાન્ જાયતે, સર્વ્વવસ્તૂનિ ચેશ્વરાદ્ ઉત્પદ્યન્તે|</para>
  <para style="p">
    <verse number="13" style="v"/>યુષ્માભિરેવૈતદ્ વિવિચ્યતાં, અનાવૃતયા યોષિતા પ્રાર્થનં કિં સુદૃશ્યં ભવેત્?</para>
  <para style="p">
    <verse number="14" style="v"/>પુરુષસ્ય દીર્ઘકેશત્વં તસ્ય લજ્જાજનકં, કિન્તુ યોષિતો દીર્ઘકેશત્વં તસ્યા ગૌરવજનકં</para>
  <para style="p">
    <verse number="15" style="v"/>યત આચ્છાદનાય તસ્યૈ કેશા દત્તા ઇતિ કિં યુષ્માભિઃ સ્વભાવતો ન શિક્ષ્યતે?</para>
  <para style="p">
    <verse number="16" style="v"/>અત્ર યદિ કશ્ચિદ્ વિવદિતુમ્ ઇચ્છેત્ તર્હ્યસ્માકમ્ ઈશ્વરીયસમિતીનાઞ્ચ તાદૃશી રીતિ ર્ન વિદ્યતે|</para>
  <para style="p">
    <verse number="17" style="v"/>યુષ્માભિ ર્ન ભદ્રાય કિન્તુ કુત્સિતાય સમાગમ્યતે તસ્માદ્ એતાનિ ભાષમાણેન મયા યૂયં ન પ્રશંસનીયાઃ|</para>
  <para style="p">
    <verse number="18" style="v"/>પ્રથમતઃ સમિતૌ સમાગતાનાં યુષ્માકં મધ્યે ભેદાઃ સન્તીતિ વાર્ત્તા મયા શ્રૂયતે તન્મધ્યે કિઞ્ચિત્ સત્યં મન્યતે ચ|</para>
  <para style="p">
    <verse number="19" style="v"/>યતો હેતો ર્યુષ્મન્મધ્યે યે પરીક્ષિતાસ્તે યત્ પ્રકાશ્યન્તે તદર્થં ભેદૈ ર્ભવિતવ્યમેવ|</para>
  <para style="p">
    <verse number="20" style="v"/>એકત્ર સમાગતૈ ર્યુષ્માભિઃ પ્રભાવં ભેाજ્યં ભુજ્યત ઇતિ નહિ;</para>
  <para style="p">
    <verse number="21" style="v"/>યતો ભોજનકાલે યુષ્માકમેકૈકેન સ્વકીયં ભક્ષ્યં તૂર્ણં ગ્રસ્યતે તસ્માદ્ એકો જનો બુભુક્ષિતસ્તિષ્ઠતિ, અન્યશ્ચ પરિતૃપ્તો ભવતિ|</para>
  <para style="p">
    <verse number="22" style="v"/>ભોજનપાનાર્થં યુષ્માકં કિં વેશ્માનિ ન સન્તિ? યુષ્માભિ ર્વા કિમ્ ઈશ્વરસ્ય સમિતિં તુચ્છીકૃત્ય દીના લોકા અવજ્ઞાયન્તે? ઇત્યનેન મયા કિં વક્તવ્યં? યૂયં કિં મયા પ્રશંસનીયાઃ? એતસ્મિન્ યૂયં ન પ્રશંસનીયાઃ|</para>
  <para style="p">
    <verse number="23" style="v"/>પ્રભુતો ય ઉપદેશો મયા લબ્ધો યુષ્માસુ સમર્પિતશ્ચ સ એષઃ|</para>
  <para style="p">
    <verse number="24" style="v"/>પરકરસમર્પણક્ષપાયાં પ્રભુ ર્યીશુઃ પૂપમાદાયેશ્વરં ધન્યં વ્યાહૃત્ય તં ભઙ્ક્ત્વા ભાષિતવાન્ યુષ્માભિરેતદ્ ગૃહ્યતાં ભુજ્યતાઞ્ચ તદ્ યુષ્મત્કૃતે ભગ્નં મમ શરીરં; મમ સ્મરણાર્થં યુષ્માભિરેતત્ ક્રિયતાં|</para>
  <para style="p">
    <verse number="25" style="v"/>પુનશ્ચ ભેજનાત્ પરં તથૈવ કંસમ્ આદાય તેનોક્તં કંસોઽયં મમ શોણિતેન સ્થાપિતો નૂતનનિયમઃ; યતિવારં યુષ્માભિરેતત્ પીયતે તતિવારં મમ સ્મરણાર્થં પીયતાં|</para>
  <para style="p">
    <verse number="26" style="v"/>યતિવારં યુષ્માભિરેષ પૂપો ભુજ્યતે ભાજનેનાનેન પીયતે ચ તતિવારં પ્રભોરાગમનં યાવત્ તસ્ય મૃત્યુઃ પ્રકાશ્યતે|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરઞ્ચ યઃ કશ્ચિદ્ અયોગ્યત્વેન પ્રભોરિમં પૂપમ્ અશ્નાતિ તસ્યાનેન ભાજનેન પિવતિ ચ સ પ્રભોઃ કાયરુધિરયો ર્દણ્ડદાયી ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="28" style="v"/>તસ્માત્ માનવેનાગ્ર આત્માન પરીક્ષ્ય પશ્ચાદ્ એષ પૂપો ભુજ્યતાં કંસેનાનેન ચ પીયતાં|</para>
  <para style="p">
    <verse number="29" style="v"/>યેન ચાનર્હત્વેન ભુજ્યતે પીયતે ચ પ્રભોઃ કાયમ્ અવિમૃશતા તેન દણ્ડપ્રાપ્તયે ભુજ્યતે પીયતે ચ|</para>
  <para style="p">
    <verse number="30" style="v"/>એતત્કારણાદ્ યુષ્માકં ભૂરિશો લોકા દુર્બ્બલા રોગિણશ્ચ સન્તિ બહવશ્ચ મહાનિદ્રાં ગતાઃ|</para>
  <para style="p">
    <verse number="31" style="v"/>અસ્માભિ ર્યદ્યાત્મવિચારોઽકારિષ્યત તર્હિ દણ્ડો નાલપ્સ્યત;</para>
  <para style="p">
    <verse number="32" style="v"/>કિન્તુ યદાસ્માકં વિચારો ભવતિ તદા વયં જગતો જનૈઃ સમં યદ્ દણ્ડં ન લભામહે તદર્થં પ્રભુના શાસ્તિં ભુંજ્મહે|</para>
  <para style="p">
    <verse number="33" style="v"/>હે મમ ભ્રાતરઃ, ભોજનાર્થં મિલિતાનાં યુષ્માકમ્ એકેનેતરોઽનુગૃહ્યતાં|</para>
  <para style="p">
    <verse number="34" style="v"/>યશ્ચ બુભુક્ષિતઃ સ સ્વગૃહે ભુઙ્ક્તાં| દણ્ડપ્રાપ્તયે યુષ્માભિ ર્ન સમાગમ્યતાં| એતદ્ભિન્નં યદ્ આદેષ્ટવ્યં તદ્ યુષ્મત્સમીપાગમનકાલે મયાદેક્ષ્યતે|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે ભ્રાતરઃ, યૂયં યદ્ આત્મિકાન્ દાયાન્ અનવગતાસ્તિષ્ઠથ તદહં નાભિલષામિ|</para>
  <para style="p">
    <verse number="2" style="v"/>પૂર્વ્વં ભિન્નજાતીયા યૂયં યદ્વદ્ વિનીતાસ્તદ્વદ્ અવાક્પ્રતિમાનામ્ અનુગામિન આધ્બમ્ ઇતિ જાનીથ|</para>
  <para style="p">
    <verse number="3" style="v"/>ઇતિ હેતોરહં યુષ્મભ્યં નિવેદયામિ, ઈશ્વરસ્યાત્મના ભાષમાણઃ કોઽપિ યીશું શપ્ત ઇતિ ન વ્યાહરતિ, પુનશ્ચ પવિત્રેણાત્મના વિનીતં વિનાન્યઃ કોઽપિ યીશું પ્રભુરિતિ વ્યાહર્ત્તું ન શક્નોતિ|</para>
  <para style="p">
    <verse number="4" style="v"/>દાયા બહુવિધાઃ કિન્ત્વેક આત્મા</para>
  <para style="p">
    <verse number="5" style="v"/>પરિચર્ય્યાશ્ચ બહુવિધાઃ કિન્ત્વેકઃ પ્રભુઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>સાધનાનિ બહુવિધાનિ કિન્તુ સર્વ્વેષુ સર્વ્વસાધક ઈશ્વર એકઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>એકૈકસ્મૈ તસ્યાત્મનો દર્શનં પરહિતાર્થં દીયતે|</para>
  <para style="p">
    <verse number="8" style="v"/>એકસ્મૈ તેનાત્મના જ્ઞાનવાક્યં દીયતે, અન્યસ્મૈ તેનૈવાત્મનાદિષ્ટં વિદ્યાવાક્યમ્,</para>
  <para style="p">
    <verse number="9" style="v"/>અન્યસ્મૈ તેનૈવાત્મના વિશ્વાસઃ, અન્યસ્મૈ તેનૈવાત્મના સ્વાસ્થ્યદાનશક્તિઃ,</para>
  <para style="p">
    <verse number="10" style="v"/>અન્યસ્મૈ દુઃસાધ્યસાધનશક્તિરન્યસ્મૈ ચેશ્વરીયાદેશઃ, અન્યસ્મૈ ચાતિમાનુષિકસ્યાદેશસ્ય વિચારસામર્થ્યમ્, અન્યસ્મૈ પરભાષાભાષણશક્તિરન્યસ્મૈ ચ ભાષાર્થભાષણસામર્યં દીયતે|</para>
  <para style="p">
    <verse number="11" style="v"/>એકેનાદ્વિતીયેનાત્મના યથાભિલાષમ્ એકૈકસ્મૈ જનાયૈકૈકં દાનં વિતરતા તાનિ સર્વ્વાણિ સાધ્યન્તે|</para>
  <para style="p">
    <verse number="12" style="v"/>દેહ એકઃ સન્નપિ યદ્વદ્ બહ્વઙ્ગયુક્તો ભવતિ, તસ્યૈકસ્ય વપુષો ઽઙ્ગાનાં બહુત્વેન યદ્વદ્ એકં વપુ ર્ભવતિ, તદ્વત્ ખ્રીષ્ટઃ|</para>
  <para style="p">
    <verse number="13" style="v"/>યતો હેતો ર્યિહૂદિભિન્નજાતીયદાસસ્વતન્ત્રા વયં સર્વ્વે મજ્જનેનૈકેનાત્મનૈકદેહીકૃતાઃ સર્વ્વે ચૈકાત્મભુક્તા અભવામ|</para>
  <para style="p">
    <verse number="14" style="v"/>એકેનાઙ્ગેન વપુ ર્ન ભવતિ કિન્તુ બહુભિઃ|</para>
  <para style="p">
    <verse number="15" style="v"/>તત્ર ચરણં યદિ વદેત્ નાહં હસ્તસ્તસ્માત્ શરીરસ્ય ભાગો નાસ્મીતિ તર્હ્યનેન શરીરાત્ તસ્ય વિયોગો ન ભવતિ|</para>
  <para style="p">
    <verse number="16" style="v"/>શ્રોત્રં વા યદિ વદેત્ નાહં નયનં તસ્માત્ શરીરસ્યાંશો નાસ્મીતિ તર્હ્યનેન શરીરાત્ તસ્ય વિયોગો ન ભવતિ|</para>
  <para style="p">
    <verse number="17" style="v"/>કૃત્સ્નં શરીરં યદિ દર્શનેન્દ્રિયં ભવેત્ તર્હિ શ્રવણેન્દ્રિયં કુત્ર સ્થાસ્યતિ? તત્ કૃત્સ્નં યદિ વા શ્રવણેન્દ્રિયં ભવેત્ તર્હિ ઘ્રણેન્દ્રિયં કુત્ર સ્થાસ્યતિ?</para>
  <para style="p">
    <verse number="18" style="v"/>કિન્ત્વિદાનીમ્ ઈશ્વરેણ યથાભિલષિતં તથૈવાઙ્ગપ્રત્યઙ્ગાનામ્ એકૈકં શરીરે સ્થાપિતં|</para>
  <para style="p">
    <verse number="19" style="v"/>તત્ કૃત્સ્નં યદ્યેકાઙ્ગરૂપિ ભવેત્ તર્હિ શરીરે કુત્ર સ્થાસ્યતિ?</para>
  <para style="p">
    <verse number="20" style="v"/>તસ્માદ્ અઙ્ગાનિ બહૂનિ સન્તિ શરીરં ત્વેકમેવ|</para>
  <para style="p">
    <verse number="21" style="v"/>અતએવ ત્વયા મમ પ્રયોજનં નાસ્તીતિ વાચં પાણિં વદિતું નયનં ન શક્નોતિ, તથા યુવાભ્યાં મમ પ્રયોજનં નાસ્તીતિ મૂર્દ્ધા ચરણૌ વદિતું ન શક્નોતિઃ;</para>
  <para style="p">
    <verse number="22" style="v"/>વસ્તુતસ્તુ વિગ્રહસ્ય યાન્યઙ્ગાન્યસ્માભિ ર્દુર્બ્બલાનિ બુધ્યન્તે તાન્યેવ સપ્રયોજનાનિ સન્તિ|</para>
  <para style="p">
    <verse number="23" style="v"/>યાનિ ચ શરીરમધ્યેઽવમન્યાનિ બુધ્યતે તાન્યસ્માભિરધિકં શોભ્યન્તે| યાનિ ચ કુદૃશ્યાનિ તાનિ સુદૃશ્યતરાણિ ક્રિયન્તે</para>
  <para style="p">
    <verse number="24" style="v"/>કિન્તુ યાનિ સ્વયં સુદૃશ્યાનિ તેષાં શોભનમ્ નિષ્પ્રયોજનં|</para>
  <para style="p">
    <verse number="25" style="v"/>શરીરમધ્યે યદ્ ભેદો ન ભવેત્ કિન્તુ સર્વ્વાણ્યઙ્ગાનિ યદ્ ઐક્યભાવેન સર્વ્વેષાં હિતં ચિન્તયન્તિ તદર્થમ્ ઈશ્વરેણાપ્રધાનમ્ આદરણીયં કૃત્વા શરીરં વિરચિતં|</para>
  <para style="p">
    <verse number="26" style="v"/>તસ્માદ્ એકસ્યાઙ્ગસ્ય પીડાયાં જાતાયાં સર્વ્વાણ્યઙ્ગાનિ તેન સહ પીડ્યન્તે, એકસ્ય સમાદરે જાતે ચ સર્વ્વાણિ તેન સહ સંહૃષ્યન્તિ|</para>
  <para style="p">
    <verse number="27" style="v"/>યૂયઞ્ચ ખ્રીષ્ટસ્ય શરીરં, યુષ્માકમ્ એકૈકશ્ચ તસ્યૈકૈકમ્ અઙ્ગં|</para>
  <para style="p">
    <verse number="28" style="v"/>કેચિત્ કેચિત્ સમિતાવીશ્વરેણ પ્રથમતઃ પ્રેરિતા દ્વિતીયત ઈશ્વરીયાદેશવક્તારસ્તૃતીયત ઉપદેષ્ટારો નિયુક્તાઃ, તતઃ પરં કેભ્યોઽપિ ચિત્રકાર્ય્યસાધનસામર્થ્યમ્ અનામયકરણશક્તિરુપકૃતૌ લોકશાસને વા નૈપુણ્યં નાનાભાષાભાષણસામર્થ્યં વા તેન વ્યતારિ|</para>
  <para style="p">
    <verse number="29" style="v"/>સર્વ્વે કિં પ્રેરિતાઃ? સર્વ્વે કિમ્ ઈશ્વરીયાદેશવક્તારઃ? સર્વ્વે કિમ્ ઉપદેષ્ટારઃ? સર્વ્વે કિં ચિત્રકાર્ય્યસાધકાઃ?</para>
  <para style="p">
    <verse number="30" style="v"/>સર્વ્વે કિમ્ અનામયકરણશક્તિયુક્તાઃ? સર્વ્વે કિં પરભાષાવાદિનઃ? સર્વ્વે વા કિં પરભાષાર્થપ્રકાશકાઃ?</para>
  <para style="p">
    <verse number="31" style="v"/>યૂયં શ્રેષ્ઠદાયાન્ લબ્ધું યતધ્વં| અનેન યૂયં મયા સર્વ્વોત્તમમાર્ગં દર્શયિતવ્યાઃ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>મર્ત્યસ્વર્ગીયાણાં ભાષા ભાષમાણોઽહં યદિ પ્રેમહીનો ભવેયં તર્હિ વાદકતાલસ્વરૂપો નિનાદકારિભેરીસ્વરૂપશ્ચ ભવામિ|</para>
  <para style="p">
    <verse number="2" style="v"/>અપરઞ્ચ યદ્યહમ્ ઈશ્વરીયાદેશાઢ્યઃ સ્યાં સર્વ્વાણિ ગુપ્તવાક્યાનિ સર્વ્વવિદ્યાઞ્ચ જાનીયાં પૂર્ણવિશ્વાસઃ સન્ શૈલાન્ સ્થાનાન્તરીકર્ત્તું શક્નુયાઞ્ચ કિન્તુ યદિ પ્રેમહીનો ભવેયં તર્હ્યગણનીય એવ ભવામિ|</para>
  <para style="p">
    <verse number="3" style="v"/>અપરં યદ્યહમ્ અન્નદાનેન સર્વ્વસ્વં ત્યજેયં દાહનાય સ્વશરીરં સમર્પયેયઞ્ચ કિન્તુ યદિ પ્રેમહીનો ભવેયં તર્હિ તત્સર્વ્વં મદર્થં નિષ્ફલં ભવતિ|</para>
  <para style="p">
    <verse number="4" style="v"/>પ્રેમ ચિરસહિષ્ણુ હિતૈષિ ચ, પ્રેમ નિર્દ્વેષમ્ અશઠં નિર્ગર્વ્વઞ્ચ|</para>
  <para style="p">
    <verse number="5" style="v"/>અપરં તત્ કુત્સિતં નાચરતિ, આત્મચેષ્ટાં ન કુરુતે સહસા ન ક્રુધ્યતિ પરાનિષ્ટં ન ચિન્તયતિ,</para>
  <para style="p">
    <verse number="6" style="v"/>અધર્મ્મે ન તુષ્યતિ સત્ય એવ સન્તુષ્યતિ|</para>
  <para style="p">
    <verse number="7" style="v"/>તત્ સર્વ્વં તિતિક્ષતે સર્વ્વત્ર વિશ્વસિતિ સર્વ્વત્ર ભદ્રં પ્રતીક્ષતે સર્વ્વં સહતે ચ|</para>
  <para style="p">
    <verse number="8" style="v"/>પ્રેમ્નો લોપઃ કદાપિ ન ભવિષ્યતિ, ઈશ્વરીયાદેશકથનં લોપ્સ્યતે પરભાષાભાષણં નિવર્ત્તિષ્યતે જ્ઞાનમપિ લોપં યાસ્યતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>યતોઽસ્માકં જ્ઞાનં ખણ્ડમાત્રમ્ ઈશ્વરીયાદેશકથનમપિ ખણ્ડમાત્રં|</para>
  <para style="p">
    <verse number="10" style="v"/>કિન્ત્વસ્માસુ સિદ્ધતાં ગતેષુ તાનિ ખણ્ડમાત્રાણિ લોપં યાસ્યન્તે|</para>
  <para style="p">
    <verse number="11" style="v"/>બાલ્યકાલેઽહં બાલ ઇવાભાષે બાલ ઇવાચિન્તયઞ્ચ કિન્તુ યૌવને જાતે તત્સર્વ્વં બાલ્યાચરણં પરિત્યક્તવાન્|</para>
  <para style="p">
    <verse number="12" style="v"/>ઇદાનીમ્ અભ્રમધ્યેનાસ્પષ્ટં દર્શનમ્ અસ્માભિ ર્લભ્યતે કિન્તુ તદા સાક્ષાત્ દર્શનં લપ્સ્યતે| અધુના મમ જ્ઞાનમ્ અલ્પિષ્ઠં કિન્તુ તદાહં યથાવગમ્યસ્તથૈવાવગતો ભવિષ્યામિ|</para>
  <para style="p">
    <verse number="13" style="v"/>ઇદાનીં પ્રત્યયઃ પ્રત્યાશા પ્રેમ ચ ત્રીણ્યેતાનિ તિષ્ઠન્તિ તેષાં મધ્યે ચ પ્રેમ શ્રેષ્ઠં|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>યૂયં પ્રેમાચરણે પ્રયતધ્વમ્ આત્મિકાન્ દાયાનપિ વિશેષત ઈશ્વરીયાદેશકથનસામર્થ્યં પ્રાપ્તું ચેષ્ટધ્વં|</para>
  <para style="p">
    <verse number="2" style="v"/>યો જનઃ પરભાષાં ભાષતે સ માનુષાન્ ન સમ્ભાષતે કિન્ત્વીશ્વરમેવ યતઃ કેનાપિ કિમપિ ન બુધ્યતે સ ચાત્મના નિગૂઢવાક્યાનિ કથયતિ;</para>
  <para style="p">
    <verse number="3" style="v"/>કિન્તુ યો જન ઈશ્વરીયાદેશં કથયતિ સ પરેષાં નિષ્ઠાયૈ હિતોપદેશાય સાન્ત્વનાયૈ ચ ભાષતે|</para>
  <para style="p">
    <verse number="4" style="v"/>પરભાષાવાદ્યાત્મન એવ નિષ્ઠાં જનયતિ કિન્ત્વીશ્વરીયાદેશવાદી સમિતે ર્નિષ્ઠાં જનયતિ|</para>
  <para style="p">
    <verse number="5" style="v"/>યુષ્માકં સર્વ્વેષાં પરભાષાભાષણમ્ ઇચ્છામ્યહં કિન્ત્વીશ્વરીયાદેશકથનમ્ અધિકમપીચ્છામિ| યતઃ સમિતે ર્નિષ્ઠાયૈ યેન સ્વવાક્યાનામ્ અર્થો ન ક્રિયતે તસ્માત્ પરભાષાવાદિત ઈશ્વરીયાદેશવાદી શ્રેયાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>હે ભ્રાતરઃ, ઇદાનીં મયા યદિ યુષ્મત્સમીપં ગમ્યતે તર્હીશ્વરીયદર્શનસ્ય જ્ઞાનસ્ય વેશ્વરીયાદેશસ્ય વા શિક્ષાયા વા વાક્યાનિ ન ભાષિત્વા પરભાષાં ભાષમાણેન મયા યૂયં કિમુપકારિષ્યધ્વે?</para>
  <para style="p">
    <verse number="7" style="v"/>અપરં વંશીવલ્લક્યાદિષુ નિષ્પ્રાણિષુ વાદ્યયન્ત્રેષુ વાદિતેષુ યદિ ક્કણા ન વિશિષ્યન્તે તર્હિ કિં વાદ્યં કિં વા ગાનં ભવતિ તત્ કેન બોદ્ધું શક્યતે?</para>
  <para style="p">
    <verse number="8" style="v"/>અપરં રણતૂર્ય્યા નિસ્વણો યદ્યવ્યક્તો ભવેત્ તર્હિ યુદ્ધાય કઃ સજ્જિષ્યતે?</para>
  <para style="p">
    <verse number="9" style="v"/>તદ્વત્ જિહ્વાભિ ર્યદિ સુગમ્યા વાક્ યુષ્માભિ ર્ન ગદ્યેત તર્હિ યદ્ ગદ્યતે તત્ કેન ભોત્સ્યતે? વસ્તુતો યૂયં દિગાલાપિન ઇવ ભવિષ્યથ|</para>
  <para style="p">
    <verse number="10" style="v"/>જગતિ કતિપ્રકારા ઉક્તયો વિદ્યન્તે? તાસામેકાપિ નિરર્થિકા નહિ;</para>
  <para style="p">
    <verse number="11" style="v"/>કિન્તૂક્તેરર્થો યદિ મયા ન બુધ્યતે તર્હ્યહં વક્ત્રા મ્લેચ્છ ઇવ મંસ્યે વક્તાપિ મયા મ્લેચ્છ ઇવ મંસ્યતે|</para>
  <para style="p">
    <verse number="12" style="v"/>તસ્માદ્ આત્મિકદાયલિપ્સવો યૂયં સમિતે ર્નિષ્ઠાર્થં પ્રાપ્તબહુવરા ભવિતું યતધ્વં,</para>
  <para style="p">
    <verse number="13" style="v"/>અતએવ પરભાષાવાદી યદ્ અર્થકરોઽપિ ભવેત્ તત્ પ્રાર્થયતાં|</para>
  <para style="p">
    <verse number="14" style="v"/>યદ્યહં પરભાષયા પ્રર્થનાં કુર્ય્યાં તર્હિ મદીય આત્મા પ્રાર્થયતે, કિન્તુ મમ બુદ્ધિ ર્નિષ્ફલા તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="15" style="v"/>ઇત્યનેન કિં કરણીયં? અહમ્ આત્મના પ્રાર્થયિષ્યે બુદ્ધ્યાપિ પ્રાર્થયિષ્યે; અપરં આત્મના ગાસ્યામિ બુદ્ધ્યાપિ ગાસ્યામિ|</para>
  <para style="p">
    <verse number="16" style="v"/>ત્વં યદાત્મના ધન્યવાદં કરોષિ તદા યદ્ વદસિ તદ્ યદિ શિષ્યેનેવોપસ્થિતેન જનેન ન બુદ્ધ્યતે તર્હિ તવ ધન્યવાદસ્યાન્તે તથાસ્ત્વિતિ તેન વક્તં કથં શક્યતે?</para>
  <para style="p">
    <verse number="17" style="v"/>ત્વં સમ્યગ્ ઈશ્વરં ધન્યં વદસીતિ સત્યં તથાપિ તત્ર પરસ્ય નિષ્ઠા ન ભવતિ|</para>
  <para style="p">
    <verse number="18" style="v"/>યુષ્માકં સર્વ્વેભ્યોઽહં પરભાષાભાષણે સમર્થોઽસ્મીતિ કારણાદ્ ઈશ્વરં ધન્યં વદામિ;</para>
  <para style="p">
    <verse number="19" style="v"/>તથાપિ સમિતૌ પરોપદેશાર્થં મયા કથિતાનિ પઞ્ચ વાક્યાનિ વરં ન ચ લક્ષં પરભાષીયાનિ વાક્યાનિ|</para>
  <para style="p">
    <verse number="20" style="v"/>હે ભ્રાતરઃ,યૂયં બુદ્ધ્યા બાલકાઇવ મા ભૂત પરન્તુ દુષ્ટતયા શિશવઇવ ભૂત્વા બુદ્ધ્યા સિદ્ધા ભવત|</para>
  <para style="p">
    <verse number="21" style="v"/>શાસ્ત્ર ઇદં લિખિતમાસ્તે, યથા, ઇત્યવોચત્ પરેશોઽહમ્ આભાષિષ્ય ઇમાન્ જનાન્| ભાષાભિઃ પરકીયાભિ ર્વક્ત્રૈશ્ચ પરદેશિભિઃ| તથા મયા કૃતેઽપીમે ન ગ્રહીષ્યન્તિ મદ્વચઃ||</para>
  <para style="p">
    <verse number="22" style="v"/>અતએવ તત્ પરભાષાભાષણં અવિશ્ચાસિનઃ પ્રતિ ચિહ્નરૂપં ભવતિ ન ચ વિશ્વાસિનઃ પ્રતિ; કિન્ત્વીશ્વરીયાદેશકથનં નાવિશ્વાસિનઃ પ્રતિ તદ્ વિશ્વાસિનઃ પ્રત્યેવ|</para>
  <para style="p">
    <verse number="23" style="v"/>સમિતિભુક્તેષુ સર્વ્વેષુ એકસ્મિન્ સ્થાને મિલિત્વા પરભાષાં ભાષમાણેષુ યદિ જ્ઞાનાકાઙ્ક્ષિણોઽવિશ્વાસિનો વા તત્રાગચ્છેયુસ્તર્હિ યુષ્માન્ ઉન્મત્તાન્ કિં ન વદિષ્યન્તિ?</para>
  <para style="p">
    <verse number="24" style="v"/>કિન્તુ સર્વ્વેષ્વીશ્વરીયાદેશં પ્રકાશયત્સુ યદ્યવિશ્વાસી જ્ઞાનાકાઙ્ક્ષી વા કશ્ચિત્ તત્રાગચ્છતિ તર્હિ સર્વ્વૈરેવ તસ્ય પાપજ્ઞાનં પરીક્ષા ચ જાયતે,</para>
  <para style="p">
    <verse number="25" style="v"/>તતસ્તસ્યાન્તઃકરણસ્ય ગુપ્તકલ્પનાસુ વ્યક્તીભૂતાસુ સોઽધોમુખઃ પતન્ ઈશ્વરમારાધ્ય યુષ્મન્મધ્ય ઈશ્વરો વિદ્યતે ઇતિ સત્યં કથામેતાં કથયિષ્યતિ|</para>
  <para style="p">
    <verse number="26" style="v"/>હે ભ્રાતરઃ, સમ્મિલિતાનાં યુષ્માકમ્ એકેન ગીતમ્ અન્યેનોપદેશોઽન્યેન પરભાષાન્યેન ઐશ્વરિકદર્શનમ્ અન્યેનાર્થબોધકં વાક્યં લભ્યતે કિમેતત્? સર્વ્વમેવ પરનિષ્ઠાર્થં યુષ્માભિઃ ક્રિયતાં|</para>
  <para style="p">
    <verse number="27" style="v"/>યદિ કશ્ચિદ્ ભાષાન્તરં વિવક્ષતિ તર્હ્યેકસ્મિન્ દિને દ્વિજનેન ત્રિજનેન વા પરભાाષા કથ્યતાં તદધિકૈર્ન કથ્યતાં તૈરપિ પર્ય્યાયાનુસારાત્ કથ્યતાં, એકેન ચ તદર્થો બોધ્યતાં|</para>
  <para style="p">
    <verse number="28" style="v"/>કિન્ત્વર્થાભિધાયકઃ કોઽપિ યદિ ન વિદ્યતે તર્હિ સ સમિતૌ વાચંયમઃ સ્થિત્વેશ્વરાયાત્મને ચ કથાં કથયતુ|</para>
  <para style="p">
    <verse number="29" style="v"/>અપરં દ્વૌ ત્રયો વેશ્વરીયાદેશવક્તારઃ સ્વં સ્વમાદેશં કથયન્તુ તદન્યે ચ તં વિચારયન્તુ|</para>
  <para style="p">
    <verse number="30" style="v"/>કિન્તુ તત્રાપરેણ કેનચિત્ જનેનેશ્વરીયાદેશે લબ્ધે પ્રથમેન કથનાત્ નિવર્ત્તિતવ્યં|</para>
  <para style="p">
    <verse number="31" style="v"/>સર્વ્વે યત્ શિક્ષાં સાન્ત્વનાઞ્ચ લભન્તે તદર્થં યૂયં સર્વ્વે પર્ય્યાયેણેશ્વરીયાદેશં કથયિતું શક્નુથ|</para>
  <para style="p">
    <verse number="32" style="v"/>ઈશ્વરીયાદેશવક્તૃણાં મનાંસિ તેષામ્ અધીનાનિ ભવન્તિ|</para>
  <para style="p">
    <verse number="33" style="v"/>યત ઈશ્વરઃ કુશાસનજનકો નહિ સુશાસનજનક એવેતિ પવિત્રલોકાનાં સર્વ્વસમિતિષુ પ્રકાશતે|</para>
  <para style="p">
    <verse number="34" style="v"/>અપરઞ્ચ યુષ્માકં વનિતાઃ સમિતિષુ તૂષ્ણીમ્ભૂતાસ્તિષ્ઠન્તુ યતઃ શાસ્ત્રલિખિતેન વિધિના તાઃ કથાપ્રચારણાત્ નિવારિતાસ્તાભિ ર્નિઘ્રાભિ ર્ભવિતવ્યં|</para>
  <para style="p">
    <verse number="35" style="v"/>અતસ્તા યદિ કિમપિ જિજ્ઞાસન્તે તર્હિ ગેહેષુ પતીન્ પૃચ્છન્તુ યતઃ સમિતિમધ્યે યોષિતાં કથાકથનં નિન્દનીયં|</para>
  <para style="p">
    <verse number="36" style="v"/>ઐશ્વરં વચઃ કિં યુષ્મત્તો નિરગમત? કેવલં યુષ્માન્ વા તત્ કિમ્ ઉપાગતં?</para>
  <para style="p">
    <verse number="37" style="v"/>યઃ કશ્ચિદ્ આત્માનમ્ ઈશ્વરીયાદેશવક્તારમ્ આત્મનાવિષ્ટં વા મન્યતે સ યુષ્માન્ પ્રતિ મયા યદ્ યત્ લિખ્યતે તત્પ્રભુનાજ્ઞાપિતમ્ ઈત્યુરરી કરોતુ|</para>
  <para style="p">
    <verse number="38" style="v"/>કિન્તુ યઃ કશ્ચિત્ અજ્ઞો ભવતિ સોઽજ્ઞ એવ તિષ્ઠતુ|</para>
  <para style="p">
    <verse number="39" style="v"/>અતએવ હે ભ્રાતરઃ, યૂયમ્ ઈશ્વરીયાદેશકથનસામર્થ્યં લબ્ધું યતધ્વં પરભાષાભાષણમપિ યુષ્માભિ ર્ન નિવાર્ય્યતાં|</para>
  <para style="p">
    <verse number="40" style="v"/>સર્વ્વકર્મ્માણિ ચ વિધ્યનુસારતઃ સુપરિપાટ્યા ક્રિયન્તાં|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે ભ્રાતરઃ, યઃ સુસંવાદો મયા યુષ્મત્સમીપે નિવેદિતો યૂયઞ્ચ યં ગૃહીતવન્ત આશ્રિતવન્તશ્ચ તં પુન ર્યુષ્માન્ વિજ્ઞાપયામિ|</para>
  <para style="p">
    <verse number="2" style="v"/>યુષ્માકં વિશ્વાસો યદિ વિતથો ન ભવેત્ તર્હિ સુસંવાદયુક્તાનિ મમ વાક્યાનિ સ્મરતાં યુષ્માકં તેન સુસંવાદેન પરિત્રાણં જાયતે|</para>
  <para style="p">
    <verse number="3" style="v"/>યતોઽહં યદ્ યત્ જ્ઞાપિતસ્તદનુસારાત્ યુષ્માસુ મુખ્યાં યાં શિક્ષાં સમાર્પયં સેયં, શાસ્ત્રાનુસારાત્ ખ્રીષ્ટોઽસ્માકં પાપમોચનાર્થં પ્રાણાન્ ત્યક્તવાન્,</para>
  <para style="p">
    <verse number="4" style="v"/>શ્મશાને સ્થાપિતશ્ચ તૃતીયદિને શાસ્ત્રાનુસારાત્ પુનરુત્થાપિતઃ|</para>
  <para style="p">
    <verse number="5" style="v"/>સ ચાગ્રે કૈફૈ તતઃ પરં દ્વાદશશિષ્યેભ્યો દર્શનં દત્તવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>તતઃ પરં પઞ્ચશતાધિકસંખ્યકેભ્યો ભ્રાતૃભ્યો યુગપદ્ દર્શનં દત્તવાન્ તેષાં કેચિત્ મહાનિદ્રાં ગતા બહુતરાશ્ચાદ્યાપિ વર્ત્તન્તે|</para>
  <para style="p">
    <verse number="7" style="v"/>તદનન્તરં યાકૂબાય તત્પશ્ચાત્ સર્વ્વેભ્યઃ પ્રેરિતેભ્યો દર્શનં દત્તવાન્|</para>
  <para style="p">
    <verse number="8" style="v"/>સર્વ્વશેષેઽકાલજાતતુલ્યો યોઽહં, સોઽહમપિ તસ્ય દર્શનં પ્રાપ્તવાન્|</para>
  <para style="p">
    <verse number="9" style="v"/>ઈશ્વરસ્ય સમિતિં પ્રતિ દૌરાત્મ્યાચરણાદ્ અહં પ્રેરિતનામ ધર્ત્તુમ્ અયોગ્યસ્તસ્માત્ પ્રેરિતાનાં મધ્યે ક્ષુદ્રતમશ્ચાસ્મિ|</para>
  <para style="p">
    <verse number="10" style="v"/>યાદૃશોઽસ્મિ તાદૃશ ઈશ્વરસ્યાનુગ્રહેણૈવાસ્મિ; અપરં માં પ્રતિ તસ્યાનુગ્રહો નિષ્ફલો નાભવત્, અન્યેભ્યઃ સર્વ્વેભ્યો મયાધિકઃ શ્રમઃ કૃતઃ, કિન્તુ સ મયા કૃતસ્તન્નહિ મત્સહકારિણેશ્વરસ્યાનુગ્રહેણૈવ|</para>
  <para style="p">
    <verse number="11" style="v"/>અતએવ મયા ભવેત્ તૈ ર્વા ભવેત્ અસ્માભિસ્તાદૃશી વાર્ત્તા ઘોષ્યતે સૈવ ચ યુષ્માભિ ર્વિશ્વાસેન ગૃહીતા|</para>
  <para style="p">
    <verse number="12" style="v"/>મૃત્યુદશાતઃ ખ્રીષ્ટ ઉત્થાપિત ઇતિ વાર્ત્તા યદિ તમધિ ઘોષ્યતે તર્હિ મૃતલોકાનામ્ ઉત્થિતિ ર્નાસ્તીતિ વાગ્ યુષ્માકં મધ્યે કૈશ્ચિત્ કુતઃ કથ્યતે?</para>
  <para style="p">
    <verse number="13" style="v"/>મૃતાનામ્ ઉત્થિતિ ર્યદિ ન ભવેત્ તર્હિ ખ્રીષ્ટોઽપિ નોત્થાપિતઃ</para>
  <para style="p">
    <verse number="14" style="v"/>ખ્રીષ્ટશ્ચ યદ્યનુત્થાપિતઃ સ્યાત્ તર્હ્યસ્માકં ઘોષણં વિતથં યુષ્માકં વિશ્વાસોઽપિ વિતથઃ|</para>
  <para style="p">
    <verse number="15" style="v"/>વયઞ્ચેશ્વરસ્ય મૃષાસાક્ષિણો ભવામઃ, યતઃ ખ્રીષ્ટ સ્તેનોત્થાપિતઃ ઇતિ સાક્ષ્યમ્ અસ્માભિરીશ્વરમધિ દત્તં કિન્તુ મૃતાનામુત્થિતિ ર્યદિ ન ભવેત્ તર્હિ સ તેન નોત્થાપિતઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>યતો મૃતાનામુત્થિતિ ર્યતિ ન ભવેત્ તર્હિ ખ્રીષ્ટોઽપ્યુત્થાપિતત્વં ન ગતઃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ખ્રીષ્ટસ્ય યદ્યનુત્થાપિતઃ સ્યાત્ તર્હિ યુષ્માકં વિશ્વાસો વિતથઃ, યૂયમ્ અદ્યાપિ સ્વપાપેષુ મગ્નાસ્તિષ્ઠથ|</para>
  <para style="p">
    <verse number="18" style="v"/>અપરં ખ્રીષ્ટાશ્રિતા યે માનવા મહાનિદ્રાં ગતાસ્તેઽપિ નાશં ગતાઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>ખ્રીષ્ટો યદિ કેવલમિહલોકે ઽસ્માકં પ્રત્યાશાભૂમિઃ સ્યાત્ તર્હિ સર્વ્વમર્ત્યેભ્યો વયમેવ દુર્ભાગ્યાઃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ઇદાનીં ખ્રીષ્ટો મૃત્યુદશાત ઉત્થાપિતો મહાનિદ્રાગતાનાં મધ્યે પ્રથમફલસ્વરૂપો જાતશ્ચ|</para>
  <para style="p">
    <verse number="21" style="v"/>યતો યદ્વત્ માનુષદ્વારા મૃત્યુઃ પ્રાદુર્ભૂતસ્તદ્વત્ માનુષદ્વારા મૃતાનાં પુનરુત્થિતિરપિ પ્રદુર્ભૂતા|</para>
  <para style="p">
    <verse number="22" style="v"/>આદમા યથા સર્વ્વે મરણાધીના જાતાસ્તથા ખ્રીષ્ટેન સર્વ્વે જીવયિષ્યન્તે|</para>
  <para style="p">
    <verse number="23" style="v"/>કિન્ત્વેકૈકેન જનેન નિજે નિજે પર્ય્યાય ઉત્થાતવ્યં પ્રથમતઃ પ્રથમજાતફલસ્વરૂપેન ખ્રીષ્ટેન, દ્વિતીયતસ્તસ્યાગમનસમયે ખ્રીષ્ટસ્ય લોકૈઃ|</para>
  <para style="p">
    <verse number="24" style="v"/>તતઃ પરમ્ અન્તો ભવિષ્યતિ તદાનીં સ સર્વ્વં શાસનમ્ અધિપતિત્વં પરાક્રમઞ્ચ લુપ્ત્વા સ્વપિતરીશ્વરે રાજત્વં સમર્પયિષ્યતિ|</para>
  <para style="p">
    <verse number="25" style="v"/>યતઃ ખ્રીષ્ટસ્ય રિપવઃ સર્વ્વે યાવત્ તેન સ્વપાદયોરધો ન નિપાતયિષ્યન્તે તાવત્ તેનૈવ રાજત્વં કર્ત્તવ્યં|</para>
  <para style="p">
    <verse number="26" style="v"/>તેન વિજેતવ્યો યઃ શેષરિપુઃ સ મૃત્યુરેવ|</para>
  <para style="p">
    <verse number="27" style="v"/>લિખિતમાસ્તે સર્વ્વાણિ તસ્ય પાદયો ર્વશીકૃતાનિ| કિન્તુ સર્વ્વાણ્યેવ તસ્ય વશીકૃતાનીત્યુક્તે સતિ સર્વ્વાણિ યેન તસ્ય વશીકૃતાનિ સ સ્વયં તસ્ય વશીભૂતો ન જાત ઇતિ વ્યક્તં|</para>
  <para style="p">
    <verse number="28" style="v"/>સર્વ્વેષુ તસ્ય વશીભૂતેષુ સર્વ્વાણિ યેન પુત્રસ્ય વશીકૃતાનિ સ્વયં પુત્રોઽપિ તસ્ય વશીભૂતો ભવિષ્યતિ તત ઈશ્વરઃ સર્વ્વેષુ સર્વ્વ એવ ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="29" style="v"/>અપરં પરેતલોકાનાં વિનિમયેન યે મજ્જ્યન્તે તૈઃ કિં લપ્સ્યતે? યેષાં પરેતલોકાનામ્ ઉત્થિતિઃ કેનાપિ પ્રકારેણ ન ભવિષ્યતિ તેષાં વિનિમયેન કુતો મજ્જનમપિ તૈરઙ્ગીક્રિયતે?</para>
  <para style="p">
    <verse number="30" style="v"/>વયમપિ કુતઃ પ્રતિદણ્ડં પ્રાણભીતિમ્ અઙ્ગીકુર્મ્મહે?</para>
  <para style="p">
    <verse number="31" style="v"/>અસ્મત્પ્રભુના યીશુખ્રીષ્ટેન યુષ્મત્તો મમ યા શ્લાઘાસ્તે તસ્યાઃ શપથં કૃત્વા કથયામિ દિને દિનેઽહં મૃત્યું ગચ્છામિ|</para>
  <para style="p">
    <verse number="32" style="v"/>ઇફિષનગરે વન્યપશુભિઃ સાર્દ્ધં યદિ લૌકિકભાવાત્ મયા યુદ્ધં કૃતં તર્હિ તેન મમ કો લાભઃ? મૃતાનામ્ ઉત્થિતિ ર્યદિ ન ભવેત્ તર્હિ, કુર્મ્મો ભોજનપાનેઽદ્ય શ્વસ્તુ મૃત્યુ ર્ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="33" style="v"/>ઇત્યનેન ધર્મ્માત્ મા ભ્રંશધ્વં| કુસંસર્ગેણ લોકાનાં સદાચારો વિનશ્યતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>યૂયં યથોચિતં સચૈતન્યાસ્તિષ્ઠત, પાપં મા કુરુધ્વં, યતો યુષ્માકં મધ્ય ઈશ્વરીયજ્ઞાનહીનાઃ કેઽપિ વિદ્યન્તે યુષ્માકં ત્રપાયૈ મયેદં ગદ્યતે|</para>
  <para style="p">
    <verse number="35" style="v"/>અપરં મૃતલોકાઃ કથમ્ ઉત્થાસ્યન્તિ? કીદૃશં વા શરીરં લબ્ધ્વા પુનરેષ્યન્તીતિ વાક્યં કશ્ચિત્ પ્રક્ષ્યતિ|</para>
  <para style="p">
    <verse number="36" style="v"/>હે અજ્ઞ ત્વયા યદ્ બીજમ્ ઉપ્યતે તદ્ યદિ ન મ્રિયેત તર્હિ ન જીવયિષ્યતે|</para>
  <para style="p">
    <verse number="37" style="v"/>યયા મૂર્ત્ત્યા નિર્ગન્તવ્યં સા ત્વયા નોપ્યતે કિન્તુ શુષ્કં બીજમેવ; તચ્ચ ગોધૂમાદીનાં કિમપિ બીજં ભવિતું શક્નોતિ|</para>
  <para style="p">
    <verse number="38" style="v"/>ઈશ્વરેણેવ યથાભિલાષં તસ્મૈ મૂર્ત્તિ ર્દીયતે, એકૈકસ્મૈ બીજાય સ્વા સ્વા મૂર્ત્તિરેવ દીયતે|</para>
  <para style="p">
    <verse number="39" style="v"/>સર્વ્વાણિ પલલાનિ નૈકવિધાનિ સન્તિ, મનુષ્યપશુપક્ષિમત્સ્યાદીનાં ભિન્નરૂપાણિ પલલાનિ સન્તિ|</para>
  <para style="p">
    <verse number="40" style="v"/>અપરં સ્વર્ગીયા મૂર્ત્તયઃ પાર્થિવા મૂર્ત્તયશ્ચ વિદ્યન્તે કિન્તુ સ્વર્ગીયાનામ્ એકરૂપં તેજઃ પાર્થિવાનાઞ્ચ તદન્યરૂપં તેજોઽસ્તિ|</para>
  <para style="p">
    <verse number="41" style="v"/>સૂર્ય્યસ્ય તેજ એકવિધં ચન્દ્રસ્ય તેજસ્તદન્યવિધં તારાણાઞ્ચ તેજોઽન્યવિધં, તારાણાં મધ્યેઽપિ તેજસસ્તારતમ્યં વિદ્યતે|</para>
  <para style="p">
    <verse number="42" style="v"/>તત્ર લિખિતમાસ્તે યથા, ‘આદિપુરુષ આદમ્ જીવત્પ્રાણી બભૂવ,’ કિન્ત્વન્તિમ આદમ્ (ખ્રીષ્ટો) જીવનદાયક આત્મા બભૂવ|</para>
  <para style="p">
    <verse number="43" style="v"/>યદ્ ઉપ્યતે તત્ તુચ્છં યચ્ચોત્થાસ્યતિ તદ્ ગૌરવાન્વિતં; યદ્ ઉપ્યતે તન્નિર્બ્બલં યચ્ચોત્થાસ્યતિ તત્ શક્તિયુક્તં|</para>
  <para style="p">
    <verse number="44" style="v"/>યત્ શરીરમ્ ઉપ્યતે તત્ પ્રાણાનાં સદ્મ, યચ્ચ શરીરમ્ ઉત્થાસ્યતિ તદ્ આત્મનઃ સદ્મ| પ્રાણસદ્મસ્વરૂપં શરીરં વિદ્યતે, આત્મસદ્મસ્વરૂપમપિ શરીરં વિદ્યતે|</para>
  <para style="p">
    <verse number="45" style="v"/>તત્ર લિખિતમાસ્તે યથા, આદિપુરુષ આદમ્ જીવત્પ્રાણી બભૂવ, કિન્ત્વન્તિમ આદમ્ (ખ્રીષ્ટો) જીવનદાયક આત્મા બભૂવ|</para>
  <para style="p">
    <verse number="46" style="v"/>આત્મસદ્મ ન પ્રથમં કિન્તુ પ્રાણસદ્મૈવ તત્પશ્ચાદ્ આત્મસદ્મ|</para>
  <para style="p">
    <verse number="47" style="v"/>આદ્યઃ પુરુષે મૃદ ઉત્પન્નત્વાત્ મૃણ્મયો દ્વિતીયશ્ચ પુરુષઃ સ્વર્ગાદ્ આગતઃ પ્રભુઃ|</para>
  <para style="p">
    <verse number="48" style="v"/>મૃણ્મયો યાદૃશ આસીત્ મૃણ્મયાઃ સર્વ્વે તાદૃશા ભવન્તિ સ્વર્ગીયશ્ચ યાદૃશોઽસ્તિ સ્વર્ગીયાઃ સર્વ્વે તાદૃશા ભવન્તિ|</para>
  <para style="p">
    <verse number="49" style="v"/>મૃણ્મયસ્ય રૂપં યદ્વદ્ અસ્માભિ ર્ધારિતં તદ્વત્ સ્વર્ગીયસ્ય રૂપમપિ ધારયિષ્યતે|</para>
  <para style="p">
    <verse number="50" style="v"/>હે ભ્રાતરઃ, યુષ્માન્ પ્રતિ વ્યાહરામિ, ઈશ્વરસ્ય રાજ્યે રક્તમાંસયોરધિકારો ભવિતું ન શક્નોતિ, અક્ષયત્વે ચ ક્ષયસ્યાધિકારો ન ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="51" style="v"/>પશ્યતાહં યુષ્મભ્યં નિગૂઢાં કથાં નિવેદયામિ|</para>
  <para style="p">
    <verse number="52" style="v"/>સર્વ્વૈરસ્માભિ ર્મહાનિદ્રા ન ગમિષ્યતે કિન્ત્વન્તિમદિને તૂર્ય્યાં વાદિતાયામ્ એકસ્મિન્ વિપલે નિમિષૈકમધ્યે સર્વ્વૈ રૂપાન્તરં ગમિષ્યતે, યતસ્તૂરી વાદિષ્યતે, મૃતલોકાશ્ચાક્ષયીભૂતા ઉત્થાસ્યન્તિ વયઞ્ચ રૂપાન્તરં ગમિષ્યામઃ|</para>
  <para style="p">
    <verse number="53" style="v"/>યતઃ ક્ષયણીયેનૈતેન શરીરેણાક્ષયત્વં પરિહિતવ્યં, મરણાધીનેનૈતેન દેહેન ચામરત્વં પરિહિતવ્યં|</para>
  <para style="p">
    <verse number="54" style="v"/>એતસ્મિન્ ક્ષયણીયે શરીરે ઽક્ષયત્વં ગતે, એતસ્મન્ મરણાધીને દેહે ચામરત્વં ગતે શાસ્ત્રે લિખિતં વચનમિદં સેત્સ્યતિ, યથા, જયેન ગ્રસ્યતે મૃત્યુઃ|</para>
  <para style="p">
    <verse number="55" style="v"/>મૃત્યો તે કણ્ટકં કુત્ર પરલોક જયઃ ક્ક તે||</para>
  <para style="p">
    <verse number="56" style="v"/>મૃત્યોઃ કણ્ટકં પાપમેવ પાપસ્ય ચ બલં વ્યવસ્થા|</para>
  <para style="p">
    <verse number="57" style="v"/>ઈશ્વરશ્ચ ધન્યો ભવતુ યતઃ સોઽસ્માકં પ્રભુના યીશુખ્રીષ્ટેનાસ્માન્ જયયુક્તાન્ વિધાપયતિ|</para>
  <para style="p">
    <verse number="58" style="v"/>અતો હે મમ પ્રિયભ્રાતરઃ; યૂયં સુસ્થિરા નિશ્ચલાશ્ચ ભવત પ્રભોઃ સેવાયાં યુષ્માકં પરિશ્રમો નિષ્ફલો ન ભવિષ્યતીતિ જ્ઞાત્વા પ્રભોઃ કાર્ય્યે સદા તત્પરા ભવત|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>પવિત્રલોકાનાં કૃતે યોઽર્થસંગ્રહસ્તમધિ ગાલાતીયદેશસ્ય સમાજા મયા યદ્ આદિષ્ટાસ્તદ્ યુષ્માભિરપિ ક્રિયતાં|</para>
  <para style="p">
    <verse number="2" style="v"/>મમાગમનકાલે યદ્ અર્થસંગ્રહો ન ભવેત્ તન્નિમિત્તં યુષ્માકમેકૈકેન સ્વસમ્પદાનુસારાત્ સઞ્ચયં કૃત્વા સપ્તાહસ્ય પ્રથમદિવસે સ્વસમીપે કિઞ્ચિત્ નિક્ષિપ્યતાં|</para>
  <para style="p">
    <verse number="3" style="v"/>તતો મમાગમનસમયે યૂયં યાનેવ વિશ્વાસ્યા ઇતિ વેદિષ્યથ તેભ્યોઽહં પત્રાણિ દત્ત્વા યુષ્માકં તદ્દાનસ્ય યિરૂશાલમં નયનાર્થં તાન્ પ્રેષયિષ્યામિ|</para>
  <para style="p">
    <verse number="4" style="v"/>કિન્તુ યદિ તત્ર મમાપિ ગમનમ્ ઉચિતં ભવેત્ તર્હિ તે મયા સહ યાસ્યન્તિ|</para>
  <para style="p">
    <verse number="5" style="v"/>સામ્પ્રતં માકિદનિયાદેશમહં પર્ય્યટામિ તં પર્ય્યટ્ય યુષ્મત્સમીપમ્ આગમિષ્યામિ|</para>
  <para style="p">
    <verse number="6" style="v"/>અનન્તરં કિં જાનામિ યુષ્મત્સન્નિધિમ્ અવસ્થાસ્યે શીતકાલમપિ યાપયિષ્યામિ ચ પશ્ચાત્ મમ યત્ સ્થાનં ગન્તવ્યં તત્રૈવ યુષ્માભિરહં પ્રેરયિતવ્યઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>યતોઽહં યાત્રાકાલે ક્ષણમાત્રં યુષ્માન્ દ્રષ્ટું નેચ્છામિ કિન્તુ પ્રભુ ર્યદ્યનુજાનીયાત્ તર્હિ કિઞ્ચિદ્ દીર્ઘકાલં યુષ્મત્સમીપે પ્રવસ્તુમ્ ઇચ્છામિ|</para>
  <para style="p">
    <verse number="8" style="v"/>તથાપિ નિસ્તારોત્સવાત્ પરં પઞ્ચાશત્તમદિનં યાવદ્ ઇફિષપુર્ય્યાં સ્થાસ્યામિ|</para>
  <para style="p">
    <verse number="9" style="v"/>યસ્માદ્ અત્ર કાર્ય્યસાધનાર્થં મમાન્તિકે બૃહદ્ દ્વારં મુક્તં બહવો વિપક્ષા અપિ વિદ્યન્તે|</para>
  <para style="p">
    <verse number="10" style="v"/>તિમથિ ર્યદિ યુષ્માકં સમીપમ્ આગચ્છેત્ તર્હિ યેન નિર્ભયં યુષ્મન્મધ્યે વર્ત્તેત તત્ર યુષ્માભિ ર્મનો નિધીયતાં યસ્માદ્ અહં યાદૃક્ સોઽપિ તાદૃક્ પ્રભોઃ કર્મ્મણે યતતે|</para>
  <para style="p">
    <verse number="11" style="v"/>કોઽપિ તં પ્રત્યનાદરં ન કરોતુ કિન્તુ સ મમાન્તિકં યદ્ આગન્તું શક્નુયાત્ તદર્થં યુષ્માભિઃ સકુશલં પ્રેષ્યતાં| ભ્રાતૃભિઃ સાર્દ્ધમહં તં પ્રતીક્ષે|</para>
  <para style="p">
    <verse number="12" style="v"/>આપલ્લું ભ્રાતરમધ્યહં નિવેદયામિ ભ્રાતૃભિઃ સાકં સોઽપિ યદ્ યુષ્માકં સમીપં વ્રજેત્ તદર્થં મયા સ પુનઃ પુનર્યાચિતઃ કિન્ત્વિદાનીં ગમનં સર્વ્વથા તસ્મૈ નારોચત, ઇતઃપરં સુસમયં પ્રાપ્ય સ ગમિષ્યતિ|</para>
  <para style="p">
    <verse number="13" style="v"/>યૂયં જાગૃત વિશ્વાસે સુસ્થિરા ભવત પૌરુષં પ્રકાશયત બલવન્તો ભવત|</para>
  <para style="p">
    <verse number="14" style="v"/>યુષ્માભિઃ સર્વ્વાણિ કર્મ્માણિ પ્રેમ્ના નિષ્પાદ્યન્તાં|</para>
  <para style="p">
    <verse number="15" style="v"/>હે ભ્રાતરઃ, અહં યુષ્માન્ ઇદમ્ અભિયાચે સ્તિફાનસ્ય પરિજના આખાયાદેશસ્ય પ્રથમજાતફલસ્વરૂપાઃ, પવિત્રલોકાનાં પરિચર્ય્યાયૈ ચ ત આત્મનો ન્યવેદયન્ ઇતિ યુષ્માભિ ર્જ્ઞાયતે|</para>
  <para style="p">
    <verse number="16" style="v"/>અતો યૂયમપિ તાદૃશલોકાનામ્ અસ્મત્સહાયાનાં શ્રમકારિણાઞ્ચ સર્વ્વેષાં વશ્યા ભવત|</para>
  <para style="p">
    <verse number="17" style="v"/>સ્તિફાનઃ ફર્ત્તૂનાત આખાયિકશ્ચ યદ્ અત્રાગમન્ તેનાહમ્ આનન્દામિ યતો યુષ્માભિર્યત્ ન્યૂનિતં તત્ તૈઃ સમ્પૂરિતં|</para>
  <para style="p">
    <verse number="18" style="v"/>તૈ ર્યુષ્માકં મમ ચ મનાંસ્યાપ્યાયિતાનિ| તસ્માત્ તાદૃશા લોકા યુષ્માભિઃ સમ્મન્તવ્યાઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>યુષ્મભ્યમ્ આશિયાદેશસ્થસમાજાનાં નમસ્કૃતિમ્ આક્કિલપ્રિસ્કિલ્લયોસ્તન્મણ્ડપસ્થસમિતેશ્ચ બહુનમસ્કૃતિં પ્રજાનીત|</para>
  <para style="p">
    <verse number="20" style="v"/>સર્વ્વે ભ્રાતરો યુષ્માન્ નમસ્કુર્વ્વન્તે| યૂયં પવિત્રચુમ્બનેન મિથો નમત|</para>
  <para style="p">
    <verse number="21" style="v"/>પૌલોઽહં સ્વકરલિખિતં નમસ્કૃતિં યુષ્માન્ વેદયે|</para>
  <para style="p">
    <verse number="22" style="v"/>યદિ કશ્ચિદ્ યીશુખ્રીષ્ટે ન પ્રીયતે તર્હિ સ શાપગ્રસ્તો ભવેત્ પ્રભુરાયાતિ|</para>
  <para style="p">
    <verse number="23" style="v"/>અસ્માકં પ્રભો ર્યીશુખ્રીષ્ટસ્યાનુગ્રહો યુષ્માન્ પ્રતિ ભૂયાત્|</para>
  <para style="p">
    <verse number="24" style="v"/>ખ્રીષ્ટં યીશુમ્ આશ્રિતાન્ યુષ્માન્ પ્રતિ મમ પ્રેમ તિષ્ઠતુ| ઇતિ||</para>
</usx>
