<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Sanskrit Bible (NT) in Gujarati Script (સત્યવેદઃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Luke</para>
  <para style="toc1">લૂકલિખિતઃ સુસંવાદઃ</para>
  <para style="toc2">લૂકઃ</para>
  <para style="toc3">લૂકઃ</para>
  <para style="mt1">લૂકલિખિતઃ સુસંવાદઃ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>પ્રથમતો યે સાક્ષિણો વાક્યપ્રચારકાશ્ચાસન્ તેઽસ્માકં મધ્યે યદ્યત્ સપ્રમાણં વાક્યમર્પયન્તિ સ્મ</para>
  <para style="p">
    <verse number="2" style="v"/>તદનુસારતોઽન્યેપિ બહવસ્તદ્વૃત્તાન્તં રચયિતું પ્રવૃત્તાઃ|</para>
  <para style="p">
    <verse number="3" style="v"/>અતએવ હે મહામહિમથિયફિલ્ ત્વં યા યાઃ કથા અશિક્ષ્યથાસ્તાસાં દૃઢપ્રમાણાનિ યથા પ્રાપ્નોષિ</para>
  <para style="p">
    <verse number="4" style="v"/>તદર્થં પ્રથમમારભ્ય તાનિ સર્વ્વાણિ જ્ઞાત્વાહમપિ અનુક્રમાત્ સર્વ્વવૃત્તાન્તાન્ તુભ્યં લેખિતું મતિમકાર્ષમ્|</para>
  <para style="p">
    <verse number="5" style="v"/>યિહૂદાદેશીયહેરોદ્નામકે રાજત્વં કુર્વ્વતિ અબીયયાજકસ્ય પર્ય્યાયાધિકારી સિખરિયનામક એકો યાજકો હારોણવંશોદ્ભવા ઇલીશેવાખ્યા</para>
  <para style="p">
    <verse number="6" style="v"/>તસ્ય જાયા દ્વાવિમૌ નિર્દોષૌ પ્રભોઃ સર્વ્વાજ્ઞા વ્યવસ્થાશ્ચ સંમન્ય ઈશ્વરદૃષ્ટૌ ધાર્મ્મિકાવાસ્તામ્|</para>
  <para style="p">
    <verse number="7" style="v"/>તયોઃ સન્તાન એકોપિ નાસીત્, યત ઇલીશેવા બન્ધ્યા તૌ દ્વાવેવ વૃદ્ધાવભવતામ્|</para>
  <para style="p">
    <verse number="8" style="v"/>યદા સ્વપર્ય્યાનુક્રમેણ સિખરિય ઈશ્વાસ્ય સમક્ષં યાજકીયં કર્મ્મ કરોતિ</para>
  <para style="p">
    <verse number="9" style="v"/>તદા યજ્ઞસ્ય દિનપરિપાય્યા પરમેશ્વરસ્ય મન્દિરે પ્રવેશકાલે ધૂપજ્વાલનં કર્મ્મ તસ્ય કરણીયમાસીત્|</para>
  <para style="p">
    <verse number="10" style="v"/>તદ્ધૂપજ્વાલનકાલે લોકનિવહે પ્રાર્થનાં કર્તું બહિસ્તિષ્ઠતિ</para>
  <para style="p">
    <verse number="11" style="v"/>સતિ સિખરિયો યસ્યાં વેદ્યાં ધૂપં જ્વાલયતિ તદ્દક્ષિણપાર્શ્વે પરમેશ્વરસ્ય દૂત એક ઉપસ્થિતો દર્શનં દદૌ|</para>
  <para style="p">
    <verse number="12" style="v"/>તં દૃષ્ટ્વા સિખરિય ઉદ્વિવિજે શશઙ્કે ચ|</para>
  <para style="p">
    <verse number="13" style="v"/>તદા સ દૂતસ્તં બભાષે હે સિખરિય મા ભૈસ્તવ પ્રાર્થના ગ્રાહ્યા જાતા તવ ભાર્ય્યા ઇલીશેવા પુત્રં પ્રસોષ્યતે તસ્ય નામ યોेહન્ ઇતિ કરિષ્યસિ|</para>
  <para style="p">
    <verse number="14" style="v"/>કિઞ્ચ ત્વં સાનન્દઃ સહર્ષશ્ચ ભવિષ્યસિ તસ્ય જન્મનિ બહવ આનન્દિષ્યન્તિ ચ|</para>
  <para style="p">
    <verse number="15" style="v"/>યતો હેતોઃ સ પરમેશ્વરસ્ય ગોચરે મહાન્ ભવિષ્યતિ તથા દ્રાક્ષારસં સુરાં વા કિમપિ ન પાસ્યતિ, અપરં જન્મારભ્ય પવિત્રેણાત્મના પરિપૂર્ણઃ</para>
  <para style="p">
    <verse number="16" style="v"/>સન્ ઇસ્રાયેલ્વંશીયાન્ અનેકાન્ પ્રભોઃ પરમેશ્વરસ્ય માર્ગમાનેષ્યતિ|</para>
  <para style="p">
    <verse number="17" style="v"/>સન્તાનાન્ પ્રતિ પિતૃણાં મનાંસિ ધર્મ્મજ્ઞાનં પ્રત્યનાજ્ઞાગ્રાહિણશ્ચ પરાવર્ત્તયિતું, પ્રભોઃ પરમેશ્વરસ્ય સેવાર્થમ્ એકાં સજ્જિતજાતિં વિધાતુઞ્ચ સ એલિયરૂપાત્મશક્તિપ્રાપ્તસ્તસ્યાગ્રે ગમિષ્યતિ|</para>
  <para style="p">
    <verse number="18" style="v"/>તદા સિખરિયો દૂતમવાદીત્ કથમેતદ્ વેત્સ્યામિ? યતોહં વૃદ્ધો મમ ભાર્ય્યા ચ વૃદ્ધા|</para>
  <para style="p">
    <verse number="19" style="v"/>તતો દૂતઃ પ્રત્યુવાચ પશ્યેશ્વરસ્ય સાક્ષાદ્વર્ત્તી જિબ્રાયેલ્નામા દૂતોહં ત્વયા સહ કથાં ગદિતું તુભ્યમિમાં શુભવાર્ત્તાં દાતુઞ્ચ પ્રેષિતઃ|</para>
  <para style="p">
    <verse number="20" style="v"/>કિન્તુ મદીયં વાક્યં કાલે ફલિષ્યતિ તત્ ત્વયા ન પ્રતીતમ્ અતઃ કારણાદ્ યાવદેવ તાનિ ન સેત્સ્યન્તિ તાવત્ ત્વં વક્તુંમશક્તો મૂકો ભવ|</para>
  <para style="p">
    <verse number="21" style="v"/>તદાનીં યે યે લોકાઃ સિખરિયમપૈક્ષન્ત તે મધ્યેમન્દિરં તસ્ય બહુવિલમ્બાદ્ આશ્ચર્ય્યં મેનિરે|</para>
  <para style="p">
    <verse number="22" style="v"/>સ બહિરાગતો યદા કિમપિ વાક્યં વક્તુમશક્તઃ સઙ્કેતં કૃત્વા નિઃશબ્દસ્તસ્યૌ તદા મધ્યેમન્દિરં કસ્યચિદ્ દર્શનં તેન પ્રાપ્તમ્ ઇતિ સર્વ્વે બુબુધિરે|</para>
  <para style="p">
    <verse number="23" style="v"/>અનન્તરં તસ્ય સેવનપર્ય્યાયે સમ્પૂર્ણે સતિ સ નિજગેહં જગામ|</para>
  <para style="p">
    <verse number="24" style="v"/>કતિપયદિનેષુ ગતેષુ તસ્ય ભાર્ય્યા ઇલીશેવા ગર્બ્ભવતી બભૂવ</para>
  <para style="p">
    <verse number="25" style="v"/>પશ્ચાત્ સા પઞ્ચમાસાન્ સંગોપ્યાકથયત્ લોકાનાં સમક્ષં મમાપમાનં ખણ્ડયિતું પરમેશ્વરો મયિ દૃષ્ટિં પાતયિત્વા કર્મ્મેદૃશં કૃતવાન્|</para>
  <para style="p">
    <verse number="26" style="v"/>અપરઞ્ચ તસ્યા ગર્બ્ભસ્ય ષષ્ઠે માસે જાતે ગાલીલ્પ્રદેશીયનાસરત્પુરે</para>
  <para style="p">
    <verse number="27" style="v"/>દાયૂદો વંશીયાય યૂષફ્નામ્ને પુરુષાય યા મરિયમ્નામકુમારી વાગ્દત્તાસીત્ તસ્યાઃ સમીપં જિબ્રાયેલ્ દૂત ઈશ્વરેણ પ્રહિતઃ|</para>
  <para style="p">
    <verse number="28" style="v"/>સ ગત્વા જગાદ હે ઈશ્વરાનુગૃહીતકન્યે તવ શુભં ભૂયાત્ પ્રભુઃ પરમેશ્વરસ્તવ સહાયોસ્તિ નારીણાં મધ્યે ત્વમેવ ધન્યા|</para>
  <para style="p">
    <verse number="29" style="v"/>તદાનીં સા તં દૃષ્ટ્વા તસ્ય વાક્યત ઉદ્વિજ્ય કીદૃશં ભાષણમિદમ્ ઇતિ મનસા ચિન્તયામાસ|</para>
  <para style="p">
    <verse number="30" style="v"/>તતો દૂતોઽવદત્ હે મરિયમ્ ભયં માકાર્ષીઃ, ત્વયિ પરમેશ્વરસ્યાનુગ્રહોસ્તિ|</para>
  <para style="p">
    <verse number="31" style="v"/>પશ્ય ત્વં ગર્બ્ભં ધૃત્વા પુત્રં પ્રસોષ્યસે તસ્ય નામ યીશુરિતિ કરિષ્યસિ|</para>
  <para style="p">
    <verse number="32" style="v"/>સ મહાન્ ભવિષ્યતિ તથા સર્વ્વેભ્યઃ શ્રેષ્ઠસ્ય પુત્ર ઇતિ ખ્યાસ્યતિ; અપરં પ્રભુઃ પરમેશ્વરસ્તસ્ય પિતુર્દાયૂદઃ સિંહાસનં તસ્મૈ દાસ્યતિ;</para>
  <para style="p">
    <verse number="33" style="v"/>તથા સ યાકૂબો વંશોપરિ સર્વ્વદા રાજત્વં કરિષ્યતિ, તસ્ય રાજત્વસ્યાન્તો ન ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>તદા મરિયમ્ તં દૂતં બભાષે નાહં પુરુષસઙ્ગં કરોમિ તર્હિ કથમેતત્ સમ્ભવિષ્યતિ?</para>
  <para style="p">
    <verse number="35" style="v"/>તતો દૂતોઽકથયત્ પવિત્ર આત્મા ત્વામાશ્રાયિષ્યતિ તથા સર્વ્વશ્રેષ્ઠસ્ય શક્તિસ્તવોપરિ છાયાં કરિષ્યતિ તતો હેતોસ્તવ ગર્બ્ભાદ્ યઃ પવિત્રબાલકો જનિષ્યતે સ ઈશ્વરપુત્ર ઇતિ ખ્યાતિં પ્રાપ્સ્યતિ|</para>
  <para style="p">
    <verse number="36" style="v"/>અપરઞ્ચ પશ્ય તવ જ્ઞાતિરિલીશેવા યાં સર્વ્વે બન્ધ્યામવદન્ ઇદાનીં સા વાર્દ્ધક્યે સન્તાનમેકં ગર્બ્ભેઽધારયત્ તસ્ય ષષ્ઠમાસોભૂત્|</para>
  <para style="p">
    <verse number="37" style="v"/>કિમપિ કર્મ્મ નાસાધ્યમ્ ઈશ્વરસ્ય|</para>
  <para style="p">
    <verse number="38" style="v"/>તદા મરિયમ્ જગાદ, પશ્ય પ્રભેરહં દાસી મહ્યં તવ વાક્યાનુસારેણ સર્વ્વમેતદ્ ઘટતામ્; અનનતરં દૂતસ્તસ્યાઃ સમીપાત્ પ્રતસ્થે|</para>
  <para style="p">
    <verse number="39" style="v"/>અથ કતિપયદિનાત્ પરં મરિયમ્ તસ્માત્ પર્વ્વતમયપ્રદેશીયયિહૂદાયા નગરમેકં શીઘ્રં ગત્વા</para>
  <para style="p">
    <verse number="40" style="v"/>સિખરિયયાજકસ્ય ગૃહં પ્રવિશ્ય તસ્ય જાયામ્ ઇલીશેવાં સમ્બોધ્યાવદત્|</para>
  <para style="p">
    <verse number="41" style="v"/>તતો મરિયમઃ સમ્બોધનવાક્યે ઇલીશેવાયાઃ કર્ણયોઃ પ્રવિષ્ટમાત્રે સતિ તસ્યા ગર્બ્ભસ્થબાલકો નનર્ત્ત| તત ઇલીશેવા પવિત્રેણાત્મના પરિપૂર્ણા સતી</para>
  <para style="p">
    <verse number="42" style="v"/>પ્રોચ્ચૈર્ગદિતુમારેભે, યોષિતાં મધ્યે ત્વમેવ ધન્યા, તવ ગર્બ્ભસ્થઃ શિશુશ્ચ ધન્યઃ|</para>
  <para style="p">
    <verse number="43" style="v"/>ત્વં પ્રભોર્માતા, મમ નિવેશને ત્વયા ચરણાવર્પિતૌ, મમાદ્ય સૌભાગ્યમેતત્|</para>
  <para style="p">
    <verse number="44" style="v"/>પશ્ય તવ વાક્યે મમ કર્ણયોઃ પ્રવિષ્ટમાત્રે સતિ મમોદરસ્થઃ શિશુરાનન્દાન્ નનર્ત્ત|</para>
  <para style="p">
    <verse number="45" style="v"/>યા સ્ત્રી વ્યશ્વસીત્ સા ધન્યા, યતો હેતોસ્તાં પ્રતિ પરમેશ્વરોક્તં વાક્યં સર્વ્વં સિદ્ધં ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="46" style="v"/>તદાનીં મરિયમ્ જગાદ| ધન્યવાદં પરેશસ્ય કરોતિ મામકં મનઃ|</para>
  <para style="p">
    <verse number="47" style="v"/>મમાત્મા તારકેશે ચ સમુલ્લાસં પ્રગચ્છતિ|</para>
  <para style="p">
    <verse number="48" style="v"/>અકરોત્ સ પ્રભુ ર્દુષ્ટિં સ્વદાસ્યા દુર્ગતિં પ્રતિ| પશ્યાદ્યારભ્ય માં ધન્યાં વક્ષ્યન્તિ પુરુષાઃ સદા|</para>
  <para style="p">
    <verse number="49" style="v"/>યઃ સર્વ્વશક્તિમાન્ યસ્ય નામાપિ ચ પવિત્રકં| સ એવ સુમહત્કર્મ્મ કૃતવાન્ મન્નિમિત્તકં|</para>
  <para style="p">
    <verse number="50" style="v"/>યે બિભ્યતિ જનાસ્તસ્માત્ તેષાં સન્તાનપંક્તિષુ| અનુકમ્પા તદીયા ચ સર્વ્વદૈવ સુતિષ્ઠતિ|</para>
  <para style="p">
    <verse number="51" style="v"/>સ્વબાહુબલતસ્તેન પ્રાકાશ્યત પરાક્રમઃ| મનઃકુમન્ત્રણાસાર્દ્ધં વિકીર્ય્યન્તેઽભિમાનિનઃ|</para>
  <para style="p">
    <verse number="52" style="v"/>સિંહાસનગતાલ્લોકાન્ બલિનશ્ચાવરોહ્ય સઃ| પદેષૂચ્ચેષુ લોકાંસ્તુ ક્ષુદ્રાન્ સંસ્થાપયત્યપિ|</para>
  <para style="p">
    <verse number="53" style="v"/>ક્ષુધિતાન્ માનવાન્ દ્રવ્યૈરુત્તમૈઃ પરિતર્પ્ય સઃ| સકલાન્ ધનિનો લોકાન્ વિસૃજેદ્ રિક્તહસ્તકાન્|</para>
  <para style="p">
    <verse number="54" style="v"/>ઇબ્રાહીમિ ચ તદ્વંશે યા દયાસ્તિ સદૈવ તાં| સ્મૃત્વા પુરા પિતૃણાં નો યથા સાક્ષાત્ પ્રતિશ્રુતં|</para>
  <para style="p">
    <verse number="55" style="v"/>ઇસ્રાયેલ્સેવકસ્તેન તથોપક્રિયતે સ્વયં||</para>
  <para style="p">
    <verse number="56" style="v"/>અનન્તરં મરિયમ્ પ્રાયેણ માસત્રયમ્ ઇલીશેવયા સહોષિત્વા વ્યાઘુય્ય નિજનિવેશનં યયૌ|</para>
  <para style="p">
    <verse number="57" style="v"/>તદનન્તરમ્ ઇલીશેવાયાઃ પ્રસવકાલ ઉપસ્થિતે સતિ સા પુત્રં પ્રાસોષ્ટ|</para>
  <para style="p">
    <verse number="58" style="v"/>તતઃ પરમેશ્વરસ્તસ્યાં મહાનુગ્રહં કૃતવાન્ એતત્ શ્રુત્વા સમીપવાસિનઃ કુટુમ્બાશ્ચાગત્ય તયા સહ મુમુદિરે|</para>
  <para style="p">
    <verse number="59" style="v"/>તથાષ્ટમે દિને તે બાલકસ્ય ત્વચં છેત્તુમ્ એત્ય તસ્ય પિતૃનામાનુરૂપં તન્નામ સિખરિય ઇતિ કર્ત્તુમીષુઃ|</para>
  <para style="p">
    <verse number="60" style="v"/>કિન્તુ તસ્ય માતાકથયત્ તન્ન, નામાસ્ય યોહન્ ઇતિ કર્ત્તવ્યમ્|</para>
  <para style="p">
    <verse number="61" style="v"/>તદા તે વ્યાહરન્ તવ વંશમધ્યે નામેદૃશં કસ્યાપિ નાસ્તિ|</para>
  <para style="p">
    <verse number="62" style="v"/>તતઃ પરં તસ્ય પિતરં સિખરિયં પ્રતિ સઙ્કેત્ય પપ્રચ્છુઃ શિશોઃ કિં નામ કારિષ્યતે?</para>
  <para style="p">
    <verse number="63" style="v"/>તતઃ સ ફલકમેકં યાચિત્વા લિલેખ તસ્ય નામ યોહન્ ભવિષ્યતિ| તસ્માત્ સર્વ્વે આશ્ચર્ય્યં મેનિરે|</para>
  <para style="p">
    <verse number="64" style="v"/>તત્ક્ષણં સિખરિયસ્ય જિહ્વાજાડ્યેઽપગતે સ મુખં વ્યાદાય સ્પષ્ટવર્ણમુચ્ચાર્ય્ય ઈશ્વરસ્ય ગુણાનુવાદં ચકાર|</para>
  <para style="p">
    <verse number="65" style="v"/>તસ્માચ્ચતુર્દિક્સ્થાઃ સમીપવાસિલોકા ભીતા એવમેતાઃ સર્વ્વાઃ કથા યિહૂદાયાઃ પર્વ્વતમયપ્રદેશસ્ય સર્વ્વત્ર પ્રચારિતાઃ|</para>
  <para style="p">
    <verse number="66" style="v"/>તસ્માત્ શ્રોતારો મનઃસુ સ્થાપયિત્વા કથયામ્બભૂવુઃ કીદૃશોયં બાલો ભવિષ્યતિ? અથ પરમેશ્વરસ્તસ્ય સહાયોભૂત્|</para>
  <para style="p">
    <verse number="67" style="v"/>તદા યોહનઃ પિતા સિખરિયઃ પવિત્રેણાત્મના પરિપૂર્ણઃ સન્ એતાદૃશં ભવિષ્યદ્વાક્યં કથયામાસ|</para>
  <para style="p">
    <verse number="68" style="v"/>ઇસ્રાયેલઃ પ્રભુ ર્યસ્તુ સ ધન્યઃ પરમેશ્વરઃ| અનુગૃહ્ય નિજાલ્લોકાન્ સ એવ પરિમોચયેત્|</para>
  <para style="p">
    <verse number="69" style="v"/>વિપક્ષજનહસ્તેભ્યો યથા મોચ્યામહે વયં| યાવજ્જીવઞ્ચ ધર્મ્મેણ સારલ્યેન ચ નિર્ભયાઃ|</para>
  <para style="p">
    <verse number="70" style="v"/>સેવામહૈ તમેવૈકમ્ એતત્કારણમેવ ચ| સ્વકીયં સુપવિત્રઞ્ચ સંસ્મૃત્ય નિયમં સદા|</para>
  <para style="p">
    <verse number="71" style="v"/>કૃપયા પુરુષાન્ પૂર્વ્વાન્ નિકષાર્થાત્તુ નઃ પિતુઃ| ઇબ્રાહીમઃ સમીપે યં શપથં કૃતવાન્ પુરા|</para>
  <para style="p">
    <verse number="72" style="v"/>તમેવ સફલં કર્ત્તં તથા શત્રુગણસ્ય ચ| ઋृતીયાકારિણશ્ચૈવ કરેભ્યો રક્ષણાય નઃ|</para>
  <para style="p">
    <verse number="73" style="v"/>સૃષ્ટેઃ પ્રથમતઃ સ્વીયૈઃ પવિત્રૈ ર્ભાવિવાદિભિઃ|</para>
  <para style="p">
    <verse number="74" style="v"/>યથોક્તવાન્ તથા સ્વસ્ય દાયૂદઃ સેવકસ્ય તુ|</para>
  <para style="p">
    <verse number="75" style="v"/>વંશે ત્રાતારમેકં સ સમુત્પાદિતવાન્ સ્વયમ્|</para>
  <para style="p">
    <verse number="76" style="v"/>અતો હે બાલક ત્વન્તુ સર્વ્વેભ્યઃ શ્રેષ્ઠ એવ યઃ| તસ્યૈવ ભાવિવાદીતિ પ્રવિખ્યાતો ભવિષ્યસિ| અસ્માકં ચરણાન્ ક્ષેમે માર્ગે ચાલયિતું સદા| એવં ધ્વાન્તેઽર્થતો મૃત્યોશ્છાયાયાં યે તુ માનવાઃ|</para>
  <para style="p">
    <verse number="77" style="v"/>ઉપવિષ્ટાસ્તુ તાનેવ પ્રકાશયિતુમેવ હિ| કૃત્વા મહાનુકમ્પાં હિ યામેવ પરમેશ્વરઃ|</para>
  <para style="p">
    <verse number="78" style="v"/>ઊર્દ્વ્વાત્ સૂર્ય્યમુદાય્યૈવાસ્મભ્યં પ્રાદાત્તુ દર્શનં| તયાનુકમ્પયા સ્વસ્ય લોકાનાં પાપમોચને|</para>
  <para style="p">
    <verse number="79" style="v"/>પરિત્રાણસ્ય તેભ્યો હિ જ્ઞાનવિશ્રાણનાય ચ| પ્રભો ર્માર્ગં પરિષ્કર્ત્તું તસ્યાગ્રાયી ભવિષ્યસિ||</para>
  <para style="p">
    <verse number="80" style="v"/>અથ બાલકઃ શરીરેણ બુદ્ધ્યા ચ વર્દ્ધિતુમારેભે; અપરઞ્ચ સ ઇસ્રાયેલો વંશીયલોકાનાં સમીપે યાવન્ન પ્રકટીભૂતસ્તાસ્તાવત્ પ્રાન્તરે ન્યવસત્|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરઞ્ચ તસ્મિન્ કાલે રાજ્યસ્ય સર્વ્વેષાં લોકાનાં નામાનિ લેખયિતુમ્ અગસ્તકૈસર આજ્ઞાપયામાસ|</para>
  <para style="p">
    <verse number="2" style="v"/>તદનુસારેણ કુરીણિયનામનિ સુરિયાદેશસ્ય શાસકે સતિ નામલેખનં પ્રારેભે|</para>
  <para style="p">
    <verse number="3" style="v"/>અતો હેતો ર્નામ લેખિતું સર્વ્વે જનાઃ સ્વીયં સ્વીયં નગરં જગ્મુઃ|</para>
  <para style="p">
    <verse number="4" style="v"/>તદાનીં યૂષફ્ નામ લેખિતું વાગ્દત્તયા સ્વભાર્ય્યયા ગર્બ્ભવત્યા મરિયમા સહ સ્વયં દાયૂદઃ સજાતિવંશ ઇતિ કારણાદ્ ગાલીલ્પ્રદેશસ્ય નાસરત્નગરાદ્</para>
  <para style="p">
    <verse number="5" style="v"/>યિહૂદાપ્રદેશસ્ય બૈત્લેહમાખ્યં દાયૂદ્નગરં જગામ|</para>
  <para style="p">
    <verse number="6" style="v"/>અન્યચ્ચ તત્ર સ્થાને તયોસ્તિષ્ઠતોઃ સતો ર્મરિયમઃ પ્રસૂતિકાલ ઉપસ્થિતે</para>
  <para style="p">
    <verse number="7" style="v"/>સા તં પ્રથમસુતં પ્રાસોષ્ટ કિન્તુ તસ્મિન્ વાસગૃહે સ્થાનાભાવાદ્ બાલકં વસ્ત્રેણ વેષ્ટયિત્વા ગોશાલાયાં સ્થાપયામાસ|</para>
  <para style="p">
    <verse number="8" style="v"/>અનન્તરં યે કિયન્તો મેષપાલકાઃ સ્વમેષવ્રજરક્ષાયૈ તત્પ્રદેશે સ્થિત્વા રજન્યાં પ્રાન્તરે પ્રહરિણઃ કર્મ્મ કુર્વ્વન્તિ,</para>
  <para style="p">
    <verse number="9" style="v"/>તેષાં સમીપં પરમેશ્વરસ્ય દૂત આગત્યોપતસ્થૌ; તદા ચતુષ્પાર્શ્વે પરમેશ્વરસ્ય તેજસઃ પ્રકાશિતત્વાત્ તેઽતિશશઙ્કિરે|</para>
  <para style="p">
    <verse number="10" style="v"/>તદા સ દૂત ઉવાચ મા ભૈષ્ટ પશ્યતાદ્ય દાયૂદઃ પુરે યુષ્મન્નિમિત્તં ત્રાતા પ્રભુઃ ખ્રીષ્ટોઽજનિષ્ટ,</para>
  <para style="p">
    <verse number="11" style="v"/>સર્વ્વેષાં લોકાનાં મહાનન્દજનકમ્ ઇમં મઙ્ગલવૃત્તાન્તં યુષ્માન્ જ્ઞાપયામિ|</para>
  <para style="p">
    <verse number="12" style="v"/>યૂયં (તત્સ્થાનં ગત્વા) વસ્ત્રવેષ્ટિતં તં બાલકં ગોશાલાયાં શયનં દ્રક્ષ્યથ યુષ્માન્ પ્રતીદં ચિહ્નં ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="13" style="v"/>દૂત ઇમાં કથાં કથિતવતિ તત્રાકસ્માત્ સ્વર્ગીયાઃ પૃતના આગત્ય કથામ્ ઇમાં કથયિત્વેશ્વરસ્ય ગુણાનન્વવાદિષુઃ, યથા,</para>
  <para style="p">
    <verse number="14" style="v"/>સર્વ્વોર્દ્વ્વસ્થૈરીશ્વરસ્ય મહિમા સમ્પ્રકાશ્યતાં| શાન્તિર્ભૂયાત્ પૃથિવ્યાસ્તુ સન્તોષશ્ચ નરાન્ પ્રતિ||</para>
  <para style="p">
    <verse number="15" style="v"/>તતઃ પરં તેષાં સન્નિધે ર્દૂતગણે સ્વર્ગં ગતે મેષપાલકાઃ પરસ્પરમ્ અવેચન્ આગચ્છત પ્રભુઃ પરમેશ્વરો યાં ઘટનાં જ્ઞાપિતવાન્ તસ્યા યાથર્યં જ્ઞાતું વયમધુના બૈત્લેહમ્પુરં યામઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>પશ્ચાત્ તે તૂર્ણં વ્રજિત્વા મરિયમં યૂષફં ગોશાલાયાં શયનં બાલકઞ્ચ દદૃશુઃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ઇત્થં દૃષ્ટ્વા બાલકસ્યાર્થે પ્રોક્તાં સર્વ્વકથાં તે પ્રાચારયાઞ્ચક્રુઃ|</para>
  <para style="p">
    <verse number="18" style="v"/>તતો યે લોકા મેષરક્ષકાણાં વદનેભ્યસ્તાં વાર્ત્તાં શુશ્રુવુસ્તે મહાશ્ચર્ય્યં મેનિરે|</para>
  <para style="p">
    <verse number="19" style="v"/>કિન્તુ મરિયમ્ એતત્સર્વ્વઘટનાનાં તાત્પર્ય્યં વિવિચ્ય મનસિ સ્થાપયામાસ|</para>
  <para style="p">
    <verse number="20" style="v"/>તત્પશ્ચાદ્ દૂતવિજ્ઞપ્તાનુરૂપં શ્રુત્વા દૃષ્ટ્વા ચ મેષપાલકા ઈશ્વરસ્ય ગુણાનુવાદં ધન્યવાદઞ્ચ કુર્વ્વાણાઃ પરાવૃત્ય યયુઃ|</para>
  <para style="p">
    <verse number="21" style="v"/>અથ બાલકસ્ય ત્વક્છેદનકાલેઽષ્ટમદિવસે સમુપસ્થિતે તસ્ય ગર્બ્ભસ્થિતેઃ પુર્વ્વં સ્વર્ગીયદૂતો યથાજ્ઞાપયત્ તદનુરૂપં તે તન્નામધેયં યીશુરિતિ ચક્રિરે|</para>
  <para style="p">
    <verse number="22" style="v"/>તતઃ પરં મૂસાલિખિતવ્યવસ્થાયા અનુસારેણ મરિયમઃ શુચિત્વકાલ ઉપસ્થિતે,</para>
  <para style="p">
    <verse number="23" style="v"/>"પ્રથમજઃ સર્વ્વઃ પુરુષસન્તાનઃ પરમેશ્વરે સમર્પ્યતાં," ઇતિ પરમેશ્વરસ્ય વ્યવસ્થયા</para>
  <para style="p">
    <verse number="24" style="v"/>યીશું પરમેશ્વરે સમર્પયિતુમ્ શાસ્ત્રીયવિધ્યુક્તં કપોતદ્વયં પારાવતશાવકદ્વયં વા બલિં દાતું તે તં ગૃહીત્વા યિરૂશાલમમ્ આયયુઃ|</para>
  <para style="p">
    <verse number="25" style="v"/>યિરૂશાલમ્પુરનિવાસી શિમિયોન્નામા ધાર્મ્મિક એક આસીત્ સ ઇસ્રાયેલઃ સાન્ત્વનામપેક્ષ્ય તસ્થૌ કિઞ્ચ પવિત્ર આત્મા તસ્મિન્નાવિર્ભૂતઃ|</para>
  <para style="p">
    <verse number="26" style="v"/>અપરં પ્રભુણા પરમેશ્વરેણાભિષિક્તે ત્રાતરિ ત્વયા ન દૃષ્ટે ત્વં ન મરિષ્યસીતિ વાક્યં પવિત્રેણ આત્મના તસ્મ પ્રાકથ્યત|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરઞ્ચ યદા યીશોઃ પિતા માતા ચ તદર્થં વ્યવસ્થાનુરૂપં કર્મ્મ કર્ત્તું તં મન્દિરમ્ આનિન્યતુસ્તદા</para>
  <para style="p">
    <verse number="28" style="v"/>શિમિયોન્ આત્મન આકર્ષણેન મન્દિરમાગત્ય તં ક્રોડે નિધાય ઈશ્વરસ્ય ધન્યવાદં કૃત્વા કથયામાસ, યથા,</para>
  <para style="p">
    <verse number="29" style="v"/>હે પ્રભો તવ દાસોયં નિજવાક્યાનુસારતઃ| ઇદાનીન્તુ સકલ્યાણો ભવતા સંવિસૃજ્યતામ્|</para>
  <para style="p">
    <verse number="30" style="v"/>યતઃ સકલદેશસ્ય દીપ્તયે દીપ્તિરૂપકં|</para>
  <para style="p">
    <verse number="31" style="v"/>ઇસ્રાયેલીયલોકસ્ય મહાગૌરવરૂપકં|</para>
  <para style="p">
    <verse number="32" style="v"/>યં ત્રાયકં જનાનાન્તુ સમ્મુખે ત્વમજીજનઃ| સએવ વિદ્યતેઽસ્માકં ધ્રવં નયનનગોચરે||</para>
  <para style="p">
    <verse number="33" style="v"/>તદાનીં તેનોક્તા એતાઃ સકલાઃ કથાઃ શ્રુત્વા તસ્ય માતા યૂષફ્ ચ વિસ્મયં મેનાતે|</para>
  <para style="p">
    <verse number="34" style="v"/>તતઃ પરં શિમિયોન્ તેભ્ય આશિષં દત્ત્વા તન્માતરં મરિયમમ્ ઉવાચ, પશ્ય ઇસ્રાયેલો વંશમધ્યે બહૂનાં પાતનાયોત્થાપનાય ચ તથા વિરોધપાત્રં ભવિતું, બહૂનાં ગુપ્તમનોગતાનાં પ્રકટીકરણાય બાલકોયં નિયુક્તોસ્તિ|</para>
  <para style="p">
    <verse number="35" style="v"/>તસ્માત્ તવાપિ પ્રાણાઃ શૂલેન વ્યત્સ્યન્તે|</para>
  <para style="p">
    <verse number="36" style="v"/>અપરઞ્ચ આશેરસ્ય વંશીયફિનૂયેલો દુહિતા હન્નાખ્યા અતિજરતી ભવિષ્યદ્વાદિન્યેકા યા વિવાહાત્ પરં સપ્ત વત્સરાન્ પત્યા સહ ન્યવસત્ તતો વિધવા ભૂત્વા ચતુરશીતિવર્ષવયઃપર્ય્યનતં</para>
  <para style="p">
    <verse number="37" style="v"/>મન્દિરે સ્થિત્વા પ્રાર્થનોપવાસૈર્દિવાનિશમ્ ઈશ્વરમ્ અસેવત સાપિ સ્ત્રી તસ્મિન્ સમયે મન્દિરમાગત્ય</para>
  <para style="p">
    <verse number="38" style="v"/>પરમેશ્વરસ્ય ધન્યવાદં ચકાર, યિરૂશાલમ્પુરવાસિનો યાવન્તો લોકા મુક્તિમપેક્ષ્ય સ્થિતાસ્તાન્ યીશોર્વૃત્તાન્તં જ્ઞાપયામાસ|</para>
  <para style="p">
    <verse number="39" style="v"/>ઇત્થં પરમેશ્વરસ્ય વ્યવસ્થાનુસારેણ સર્વ્વેષુ કર્મ્મસુ કૃતેષુ તૌ પુનશ્ચ ગાલીલો નાસરત્નામકં નિજનગરં પ્રતસ્થાતે|</para>
  <para style="p">
    <verse number="40" style="v"/>તત્પશ્ચાદ્ બાલકઃ શરીરેણ વૃદ્ધિમેત્ય જ્ઞાનેન પરિપૂર્ણ આત્મના શક્તિમાંશ્ચ ભવિતુમારેભે તથા તસ્મિન્ ઈશ્વરાનુગ્રહો બભૂવ|</para>
  <para style="p">
    <verse number="41" style="v"/>તસ્ય પિતા માતા ચ પ્રતિવર્ષં નિસ્તારોત્સવસમયે યિરૂશાલમમ્ અગચ્છતામ્|</para>
  <para style="p">
    <verse number="42" style="v"/>અપરઞ્ચ યીશૌ દ્વાદશવર્ષવયસ્કે સતિ તૌ પર્વ્વસમયસ્ય રીત્યનુસારેણ યિરૂશાલમં ગત્વા</para>
  <para style="p">
    <verse number="43" style="v"/>પાર્વ્વણં સમ્પાદ્ય પુનરપિ વ્યાઘુય્ય યાતઃ કિન્તુ યીશુર્બાલકો યિરૂશાલમિ તિષ્ઠતિ| યૂષફ્ તન્માતા ચ તદ્ અવિદિત્વા</para>
  <para style="p">
    <verse number="44" style="v"/>સ સઙ્ગિભિઃ સહ વિદ્યત એતચ્ચ બુદ્વ્વા દિનૈકગમ્યમાર્ગં જગ્મતુઃ| કિન્તુ શેષે જ્ઞાતિબન્ધૂનાં સમીપે મૃગયિત્વા તદુદ્દેेશમપ્રાપ્ય</para>
  <para style="p">
    <verse number="45" style="v"/>તૌ પુનરપિ યિરૂશાલમમ્ પરાવૃત્યાગત્ય તં મૃગયાઞ્ચક્રતુઃ|</para>
  <para style="p">
    <verse number="46" style="v"/>અથ દિનત્રયાત્ પરં પણ્ડિતાનાં મધ્યે તેષાં કથાઃ શૃણ્વન્ તત્ત્વં પૃચ્છંશ્ચ મન્દિરે સમુપવિષ્ટઃ સ તાભ્યાં દૃષ્ટઃ|</para>
  <para style="p">
    <verse number="47" style="v"/>તદા તસ્ય બુદ્ધ્યા પ્રત્યુત્તરૈશ્ચ સર્વ્વે શ્રોતારો વિસ્મયમાપદ્યન્તે|</para>
  <para style="p">
    <verse number="48" style="v"/>તાદૃશં દૃષ્ટ્વા તસ્ય જનકો જનની ચ ચમચ્ચક્રતુઃ કિઞ્ચ તસ્ય માતા તમવદત્, હે પુત્ર, કથમાવાં પ્રતીત્થં સમાચરસ્ત્વમ્? પશ્ય તવ પિતાહઞ્ચ શોકાકુલૌ સન્તૌ ત્વામન્વિચ્છાવઃ સ્મ|</para>
  <para style="p">
    <verse number="49" style="v"/>તતઃ સોવદત્ કુતો મામ્ અન્વૈચ્છતં? પિતુર્ગૃહે મયા સ્થાતવ્યમ્ એતત્ કિં યુવાભ્યાં ન જ્ઞાયતે?</para>
  <para style="p">
    <verse number="50" style="v"/>કિન્તુ તૌ તસ્યૈતદ્વાક્યસ્ય તાત્પર્ય્યં બોદ્ધું નાશક્નુતાં|</para>
  <para style="p">
    <verse number="51" style="v"/>તતઃ પરં સ તાભ્યાં સહ નાસરતં ગત્વા તયોર્વશીભૂતસ્તસ્થૌ કિન્તુ સર્વ્વા એતાઃ કથાસ્તસ્ય માતા મનસિ સ્થાપયામાસ|</para>
  <para style="p">
    <verse number="52" style="v"/>અથ યીશો ર્બુદ્ધિઃ શરીરઞ્ચ તથા તસ્મિન્ ઈશ્વરસ્ય માનવાનાઞ્ચાનુગ્રહો વર્દ્ધિતુમ્ આરેભે|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અનન્તરં તિબિરિયકૈસરસ્ય રાજત્વસ્ય પઞ્ચદશે વત્સરે સતિ યદા પન્તીયપીલાતો યિહૂદાદેશાધિપતિ ર્હેરોદ્ તુ ગાલીલ્પ્રદેશસ્ય રાજા ફિલિપનામા તસ્ય ભ્રાતા તુ યિતૂરિયાયાસ્ત્રાખોનીતિયાપ્રદેશસ્ય ચ રાજાસીત્ લુષાનીયનામા અવિલીનીદેશસ્ય રાજાસીત્</para>
  <para style="p">
    <verse number="2" style="v"/>હાનન્ કિયફાશ્ચેમૌ પ્રધાનયાજાકાવાસ્તાં તદાનીં સિખરિયસ્ય પુત્રાય યોહને મધ્યેપ્રાન્તરમ્ ઈશ્વરસ્ય વાક્યે પ્રકાશિતે સતિ</para>
  <para style="p">
    <verse number="3" style="v"/>સ યર્દ્દન ઉભયતટપ્રદેશાન્ સમેત્ય પાપમોચનાર્થં મનઃપરાવર્ત્તનસ્ય ચિહ્નરૂપં યન્મજ્જનં તદીયાઃ કથાઃ સર્વ્વત્ર પ્રચારયિતુમારેભે|</para>
  <para style="p">
    <verse number="4" style="v"/>યિશયિયભવિષ્યદ્વક્તૃગ્રન્થે યાદૃશી લિપિરાસ્તે યથા, પરમેશસ્ય પન્થાનં પરિષ્કુરુત સર્વ્વતઃ| તસ્ય રાજપથઞ્ચૈવ સમાનં કુરુતાધુના|</para>
  <para style="p">
    <verse number="5" style="v"/>કારિષ્યન્તે સમુચ્છ્રાયાઃ સકલા નિમ્નભૂમયઃ| કારિષ્યન્તે નતાઃ સર્વ્વે પર્વ્વતાશ્ચોપપર્વ્વતાઃ| કારિષ્યન્તે ચ યા વક્રાસ્તાઃ સર્વ્વાઃ સરલા ભુવઃ| કારિષ્યન્તે સમાનાસ્તા યા ઉચ્ચનીચભૂમયઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ઈશ્વરેણ કૃતં ત્રાણં દ્રક્ષ્યન્તિ સર્વ્વમાનવાઃ| ઇત્યેતત્ પ્રાન્તરે વાક્યં વદતઃ કસ્યચિદ્ રવઃ||</para>
  <para style="p">
    <verse number="7" style="v"/>યે યે લોકા મજ્જનાર્થં બહિરાયયુસ્તાન્ સોવદત્ રે રે સર્પવંશા આગામિનઃ કોપાત્ પલાયિતું યુષ્માન્ કશ્ચેતયામાસ?</para>
  <para style="p">
    <verse number="8" style="v"/>તસ્માદ્ ઇબ્રાહીમ્ અસ્માકં પિતા કથામીદૃશીં મનોભિ ર્ન કથયિત્વા યૂયં મનઃપરિવર્ત્તનયોગ્યં ફલં ફલત; યુષ્માનહં યથાર્થં વદામિ પાષાણેભ્ય એતેભ્ય ઈશ્વર ઇબ્રાહીમઃ સન્તાનોત્પાદને સમર્થઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>અપરઞ્ચ તરુમૂલેઽધુનાપિ પરશુઃ સંલગ્નોસ્તિ યસ્તરુરુત્તમં ફલં ન ફલતિ સ છિદ્યતેઽગ્નૌ નિક્ષિપ્યતે ચ|</para>
  <para style="p">
    <verse number="10" style="v"/>તદાનીં લોકાસ્તં પપ્રચ્છુસ્તર્હિ કિં કર્ત્તવ્યમસ્માભિઃ?</para>
  <para style="p">
    <verse number="11" style="v"/>તતઃ સોવાદીત્ યસ્ય દ્વે વસને વિદ્યેતે સ વસ્ત્રહીનાયૈકં વિતરતુ કિંઞ્ચ યસ્ય ખાદ્યદ્રવ્યં વિદ્યતે સોપિ તથૈવ કરોતુ|</para>
  <para style="p">
    <verse number="12" style="v"/>તતઃ પરં કરસઞ્ચાયિનો મજ્જનાર્થમ્ આગત્ય પપ્રચ્છુઃ હે ગુરો કિં કર્ત્તવ્યમસ્માભિઃ?</para>
  <para style="p">
    <verse number="13" style="v"/>તતઃ સોકથયત્ નિરૂપિતાદધિકં ન ગૃહ્લિત|</para>
  <para style="p">
    <verse number="14" style="v"/>અનન્તરં સેનાગણ એત્ય પપ્રચ્છ કિમસ્માભિ ર્વા કર્ત્તવ્યમ્? તતઃ સોભિદધે કસ્ય કામપિ હાનિં મા કાર્ષ્ટ તથા મૃષાપવાદં મા કુરુત નિજવેતનેન ચ સન્તુષ્ય તિષ્ઠત|</para>
  <para style="p">
    <verse number="15" style="v"/>અપરઞ્ચ લોકા અપેક્ષયા સ્થિત્વા સર્વ્વેપીતિ મનોભિ ર્વિતર્કયાઞ્ચક્રુઃ, યોહનયમ્ અભિષિક્તસ્ત્રાતા ન વેતિ?</para>
  <para style="p">
    <verse number="16" style="v"/>તદા યોહન્ સર્વ્વાન્ વ્યાજહાર, જલેઽહં યુષ્માન્ મજ્જયામિ સત્યં કિન્તુ યસ્ય પાદુકાબન્ધનં મોચયિતુમપિ ન યોગ્યોસ્મિ તાદૃશ એકો મત્તો ગુરુતરઃ પુમાન્ એતિ, સ યુષ્માન્ વહ્નિરૂપે પવિત્ર આત્મનિ મજ્જયિષ્યતિ|</para>
  <para style="p">
    <verse number="17" style="v"/>અપરઞ્ચ તસ્ય હસ્તે શૂર્પ આસ્તે સ સ્વશસ્યાનિ શુદ્ધરૂપં પ્રસ્ફોટ્ય ગોધૂમાન્ સર્વ્વાન્ ભાણ્ડાગારે સંગ્રહીષ્યતિ કિન્તુ બૂષાણિ સર્વ્વાણ્યનિર્વ્વાણવહ્નિના દાહયિષ્યતિ|</para>
  <para style="p">
    <verse number="18" style="v"/>યોહન્ ઉપદેશેનેત્થં નાનાકથા લોકાનાં સમક્ષં પ્રચારયામાસ|</para>
  <para style="p">
    <verse number="19" style="v"/>અપરઞ્ચ હેરોદ્ રાજા ફિલિપ્નામ્નઃ સહોદરસ્ય ભાર્ય્યાં હેરોદિયામધિ તથાન્યાનિ યાનિ યાનિ કુકર્મ્માણિ કૃતવાન્ તદધિ ચ</para>
  <para style="p">
    <verse number="20" style="v"/>યોહના તિરસ્કૃતો ભૂત્વા કારાગારે તસ્ય બન્ધનાદ્ અપરમપિ કુકર્મ્મ ચકાર|</para>
  <para style="p">
    <verse number="21" style="v"/>ઇતઃ પૂર્વ્વં યસ્મિન્ સમયે સર્વ્વે યોહના મજ્જિતાસ્તદાનીં યીશુરપ્યાગત્ય મજ્જિતઃ|</para>
  <para style="p">
    <verse number="22" style="v"/>તદનન્તરં તેન પ્રાર્થિતે મેઘદ્વારં મુક્તં તસ્માચ્ચ પવિત્ર આત્મા મૂર્ત્તિમાન્ ભૂત્વા કપોતવત્ તદુપર્ય્યવરુરોહ; તદા ત્વં મમ પ્રિયઃ પુત્રસ્ત્વયિ મમ પરમઃ સન્તોષ ઇત્યાકાશવાણી બભૂવ|</para>
  <para style="p">
    <verse number="23" style="v"/>તદાનીં યીશુઃ પ્રાયેણ ત્રિંશદ્વર્ષવયસ્ક આસીત્| લૌકિકજ્ઞાને તુ સ યૂષફઃ પુત્રઃ,</para>
  <para style="p">
    <verse number="24" style="v"/>યૂષફ્ એલેઃ પુત્રઃ, એલિર્મત્તતઃ પુત્રઃ, મત્તત્ લેવેઃ પુત્રઃ, લેવિ ર્મલ્કેઃ પુત્રઃ, મલ્કિર્યાન્નસ્ય પુત્રઃ; યાન્નો યૂષફઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="25" style="v"/>યૂષફ્ મત્તથિયસ્ય પુત્રઃ, મત્તથિય આમોસઃ પુત્રઃ, આમોસ્ નહૂમઃ પુત્રઃ, નહૂમ્ ઇષ્લેઃ પુત્રઃ ઇષ્લિર્નગેઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="26" style="v"/>નગિર્માટઃ પુત્રઃ, માટ્ મત્તથિયસ્ય પુત્રઃ, મત્તથિયઃ શિમિયેઃ પુત્રઃ, શિમિયિર્યૂષફઃ પુત્રઃ, યૂષફ્ યિહૂદાઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="27" style="v"/>યિહૂદા યોહાનાઃ પુત્રઃ, યોહાના રીષાઃ પુત્રઃ, રીષાઃ સિરુબ્બાબિલઃ પુત્રઃ, સિરુબ્બાબિલ્ શલ્તીયેલઃ પુત્રઃ, શલ્તીયેલ્ નેરેઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="28" style="v"/>નેરિર્મલ્કેઃ પુત્રઃ, મલ્કિઃ અદ્યઃ પુત્રઃ, અદ્દી કોષમઃ પુત્રઃ, કોષમ્ ઇલ્મોદદઃ પુત્રઃ, ઇલ્મોદદ્ એરઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="29" style="v"/>એર્ યોશેઃ પુત્રઃ, યોશિઃ ઇલીયેષરઃ પુત્રઃ, ઇલીયેષર્ યોરીમઃ પુત્રઃ, યોરીમ્ મત્તતઃ પુત્રઃ, મત્તત લેવેઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="30" style="v"/>લેવિઃ શિમિયોનઃ પુત્રઃ, શિમિયોન્ યિહૂદાઃ પુત્રઃ, યિહૂદા યૂષુફઃ પુત્રઃ, યૂષુફ્ યોનનઃ પુત્રઃ, યાનન્ ઇલીયાકીમઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ઇલિયાકીમ્ઃ મિલેયાઃ પુત્રઃ, મિલેયા મૈનનઃ પુત્રઃ, મૈનન્ મત્તત્તસ્ય પુત્રઃ, મત્તત્તો નાથનઃ પુત્રઃ, નાથન્ દાયૂદઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="32" style="v"/>દાયૂદ્ યિશયઃ પુત્રઃ, યિશય ઓબેદઃ પુત્ર, ઓબેદ્ બોયસઃ પુત્રઃ, બોયસ્ સલ્મોનઃ પુત્રઃ, સલ્મોન્ નહશોનઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="33" style="v"/>નહશોન્ અમ્મીનાદબઃ પુત્રઃ, અમ્મીનાદબ્ અરામઃ પુત્રઃ, અરામ્ હિષ્રોણઃ પુત્રઃ, હિષ્રોણ્ પેરસઃ પુત્રઃ, પેરસ્ યિહૂદાઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="34" style="v"/>યિહૂદા યાકૂબઃ પુત્રઃ, યાકૂબ્ ઇસ્હાકઃ પુત્રઃ, ઇસ્હાક્ ઇબ્રાહીમઃ પુત્રઃ, ઇબ્રાહીમ્ તેરહઃ પુત્રઃ, તેરહ્ નાહોરઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="35" style="v"/>નાહોર્ સિરુગઃ પુત્રઃ, સિરુગ્ રિય્વઃ પુત્રઃ, રિયૂઃ પેલગઃ પુત્રઃ, પેલગ્ એવરઃ પુત્રઃ, એવર્ શેલહઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="36" style="v"/>શેલહ્ કૈનનઃ પુત્રઃ, કૈનન્ અર્ફક્ષદઃ પુત્રઃ, અર્ફક્ષદ્ શામઃ પુત્રઃ, શામ્ નોહઃ પુત્રઃ, નોહો લેમકઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="37" style="v"/>લેમક્ મિથૂશેલહઃ પુત્રઃ, મિથૂશેલહ્ હનોકઃ પુત્રઃ, હનોક્ યેરદઃ પુત્રઃ, યેરદ્ મહલલેલઃ પુત્રઃ, મહલલેલ્ કૈનનઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="38" style="v"/>કૈનન્ ઇનોશઃ પુત્રઃ, ઇનોશ્ શેતઃ પુત્રઃ, શેત્ આદમઃ પુત્ર, આદમ્ ઈશ્વરસ્ય પુત્રઃ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તતઃ પરં યીશુઃ પવિત્રેણાત્મના પૂર્ણઃ સન્ યર્દ્દનનદ્યાઃ પરાવૃત્યાત્મના પ્રાન્તરં નીતઃ સન્ ચત્વારિંશદ્દિનાનિ યાવત્ શૈતાના પરીક્ષિતોઽભૂત્,</para>
  <para style="p">
    <verse number="2" style="v"/>કિઞ્ચ તાનિ સર્વ્વદિનાનિ ભોજનં વિના સ્થિતત્વાત્ કાલે પૂર્ણે સ ક્ષુધિતવાન્|</para>
  <para style="p">
    <verse number="3" style="v"/>તતઃ શૈતાનાગત્ય તમવદત્ ત્વં ચેદીશ્વરસ્ય પુત્રસ્તર્હિ પ્રસ્તરાનેતાન્ આજ્ઞયા પૂપાન્ કુરુ|</para>
  <para style="p">
    <verse number="4" style="v"/>તદા યીશુરુવાચ, લિપિરીદૃશી વિદ્યતે મનુજઃ કેવલેન પૂપેન ન જીવતિ કિન્ત્વીશ્વરસ્ય સર્વ્વાભિરાજ્ઞાભિ ર્જીવતિ|</para>
  <para style="p">
    <verse number="5" style="v"/>તદા શૈતાન્ તમુચ્ચં પર્વ્વતં નીત્વા નિમિષૈકમધ્યે જગતઃ સર્વ્વરાજ્યાનિ દર્શિતવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>પશ્ચાત્ તમવાદીત્ સર્વ્વમ્ એતદ્ વિભવં પ્રતાપઞ્ચ તુભ્યં દાસ્યામિ તન્ મયિ સમર્પિતમાસ્તે યં પ્રતિ મમેચ્છા જાયતે તસ્મૈ દાતું શક્નોમિ,</para>
  <para style="p">
    <verse number="7" style="v"/>ત્વં ચેન્માં ભજસે તર્હિ સર્વ્વમેતત્ તવૈવ ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="8" style="v"/>તદા યીશુસ્તં પ્રત્યુક્તવાન્ દૂરી ભવ શૈતાન્ લિપિરાસ્તે, નિજં પ્રભું પરમેશ્વરં ભજસ્વ કેવલં તમેવ સેવસ્વ ચ|</para>
  <para style="p">
    <verse number="9" style="v"/>અથ શૈતાન્ તં યિરૂશાલમં નીત્વા મન્દિરસ્ય ચૂડાયા ઉપરિ સમુપવેશ્ય જગાદ ત્વં ચેદીશ્વરસ્ય પુત્રસ્તર્હિ સ્થાનાદિતો લમ્ફિત્વાધઃ</para>
  <para style="p">
    <verse number="10" style="v"/>પત યતો લિપિરાસ્તે, આજ્ઞાપયિષ્યતિ સ્વીયાન્ દૂતાન્ સ પરમેશ્વરઃ|</para>
  <para style="p">
    <verse number="11" style="v"/>રક્ષિતું સર્વ્વમાર્ગે ત્વાં તેન ત્વચ્ચરણે યથા| ન લગેત્ પ્રસ્તરાઘાતસ્ત્વાં ધરિષ્યન્તિ તે તથા|</para>
  <para style="p">
    <verse number="12" style="v"/>તદા યીશુના પ્રત્યુક્તમ્ ઇદમપ્યુક્તમસ્તિ ત્વં સ્વપ્રભું પરેશં મા પરીક્ષસ્વ|</para>
  <para style="p">
    <verse number="13" style="v"/>પશ્ચાત્ શૈતાન્ સર્વ્વપરીક્ષાં સમાપ્ય ક્ષણાત્તં ત્યક્ત્વા યયૌ|</para>
  <para style="p">
    <verse number="14" style="v"/>તદા યીશુરાત્મપ્રભાવાત્ પુનર્ગાલીલ્પ્રદેશં ગતસ્તદા તત્સુખ્યાતિશ્ચતુર્દિશં વ્યાનશે|</para>
  <para style="p">
    <verse number="15" style="v"/>સ તેષાં ભજનગૃહેષુ ઉપદિશ્ય સર્વ્વૈઃ પ્રશંસિતો બભૂવ|</para>
  <para style="p">
    <verse number="16" style="v"/>અથ સ સ્વપાલનસ્થાનં નાસરત્પુરમેત્ય વિશ્રામવારે સ્વાચારાદ્ ભજનગેહં પ્રવિશ્ય પઠિતુમુત્તસ્થૌ|</para>
  <para style="p">
    <verse number="17" style="v"/>તતો યિશયિયભવિષ્યદ્વાદિનઃ પુસ્તકે તસ્ય કરદત્તે સતિ સ તત્ પુસ્તકં વિસ્તાર્ય્ય યત્ર વક્ષ્યમાણાનિ વચનાનિ સન્તિ તત્ સ્થાનં પ્રાપ્ય પપાઠ|</para>
  <para style="p">
    <verse number="18" style="v"/>આત્મા તુ પરમેશસ્ય મદીયોપરિ વિદ્યતે| દરિદ્રેષુ સુસંવાદં વક્તું માં સોભિષિક્તવાન્| ભગ્નાન્તઃ કરણાલ્લોકાન્ સુસ્વસ્થાન્ કર્ત્તુમેવ ચ| બન્દીકૃતેષુ લોકેષુ મુક્તે ર્ઘોષયિતું વચઃ| નેત્રાણિ દાતુમન્ધેભ્યસ્ત્રાતું બદ્ધજનાનપિ|</para>
  <para style="p">
    <verse number="19" style="v"/>પરેશાનુગ્રહે કાલં પ્રચારયિતુમેવ ચ| સર્વ્વૈતત્કરણાર્થાય મામેવ પ્રહિણોતિ સઃ||</para>
  <para style="p">
    <verse number="20" style="v"/>તતઃ પુસ્તકં બદ્વ્વા પરિચારકસ્ય હસ્તે સમર્પ્ય ચાસને સમુપવિષ્ટઃ, તતો ભજનગૃહે યાવન્તો લોકા આસન્ તે સર્વ્વેઽનન્યદૃષ્ટ્યા તં વિલુલોકિરે|</para>
  <para style="p">
    <verse number="21" style="v"/>અનન્તરમ્ અદ્યૈતાનિ સર્વ્વાણિ લિખિતવચનાનિ યુષ્માકં મધ્યે સિદ્ધાનિ સ ઇમાં કથાં તેભ્યઃ કથયિતુમારેભે|</para>
  <para style="p">
    <verse number="22" style="v"/>તતઃ સર્વ્વે તસ્મિન્ અન્વરજ્યન્ત, કિઞ્ચ તસ્ય મુખાન્નિર્ગતાભિરનુગ્રહસ્ય કથાભિશ્ચમત્કૃત્ય કથયામાસુઃ કિમયં યૂષફઃ પુત્રો ન?</para>
  <para style="p">
    <verse number="23" style="v"/>તદા સોઽવાદીદ્ હે ચિકિત્સક સ્વમેવ સ્વસ્થં કુરુ કફર્નાહૂમિ યદ્યત્ કૃતવાન્ તદશ્રૌષ્મ તાઃ સર્વાઃ ક્રિયા અત્ર સ્વદેશે કુરુ કથામેતાં યૂયમેવાવશ્યં માં વદિષ્યથ|</para>
  <para style="p">
    <verse number="24" style="v"/>પુનઃ સોવાદીદ્ યુષ્માનહં યથાર્થં વદામિ, કોપિ ભવિષ્યદ્વાદી સ્વદેશે સત્કારં ન પ્રાપ્નોતિ|</para>
  <para style="p">
    <verse number="25" style="v"/>અપરઞ્ચ યથાર્થં વચ્મિ, એલિયસ્ય જીવનકાલે યદા સાર્દ્ધત્રિતયવર્ષાણિ યાવત્ જલદપ્રતિબન્ધાત્ સર્વ્વસ્મિન્ દેશે મહાદુર્ભિક્ષમ્ અજનિષ્ટ તદાનીમ્ ઇસ્રાયેલો દેશસ્ય મધ્યે બહ્વ્યો વિધવા આસન્,</para>
  <para style="p">
    <verse number="26" style="v"/>કિન્તુ સીદોન્પ્રદેશીયસારિફત્પુરનિવાસિનીમ્ એકાં વિધવાં વિના કસ્યાશ્ચિદપિ સમીપે એલિયઃ પ્રેરિતો નાભૂત્|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરઞ્ચ ઇલીશાયભવિષ્યદ્વાદિવિદ્યમાનતાકાલે ઇસ્રાયેલ્દેશે બહવઃ કુષ્ઠિન આસન્ કિન્તુ સુરીયદેશીયં નામાન્કુષ્ઠિનં વિના કોપ્યન્યઃ પરિષ્કૃતો નાભૂત્|</para>
  <para style="p">
    <verse number="28" style="v"/>ઇમાં કથાં શ્રુત્વા ભજનગેહસ્થિતા લોકાઃ સક્રોધમ્ ઉત્થાય</para>
  <para style="p">
    <verse number="29" style="v"/>નગરાત્તં બહિષ્કૃત્ય યસ્ય શિખરિણ ઉપરિ તેષાં નગરં સ્થાપિતમાસ્તે તસ્માન્નિક્ષેપ્તું તસ્ય શિખરં તં નિન્યુઃ</para>
  <para style="p">
    <verse number="30" style="v"/>કિન્તુ સ તેષાં મધ્યાદપસૃત્ય સ્થાનાન્તરં જગામ|</para>
  <para style="p">
    <verse number="31" style="v"/>તતઃ પરં યીશુર્ગાલીલ્પ્રદેશીયકફર્નાહૂમ્નગર ઉપસ્થાય વિશ્રામવારે લોકાનુપદેષ્ટુમ્ આરબ્ધવાન્|</para>
  <para style="p">
    <verse number="32" style="v"/>તદુપદેશાત્ સર્વ્વે ચમચ્ચક્રુ ર્યતસ્તસ્ય કથા ગુરુતરા આસન્|</para>
  <para style="p">
    <verse number="33" style="v"/>તદાનીં તદ્ભજનગેહસ્થિતોઽમેધ્યભૂતગ્રસ્ત એકો જન ઉચ્ચૈઃ કથયામાસ,</para>
  <para style="p">
    <verse number="34" style="v"/>હે નાસરતીયયીશોઽસ્માન્ ત્યજ, ત્વયા સહાસ્માકં કઃ સમ્બન્ધઃ? કિમસ્માન્ વિનાશયિતુમાયાસિ? ત્વમીશ્વરસ્ય પવિત્રો જન એતદહં જાનામિ|</para>
  <para style="p">
    <verse number="35" style="v"/>તદા યીશુસ્તં તર્જયિત્વાવદત્ મૌની ભવ ઇતો બહિર્ભવ; તતઃ સોમેધ્યભૂતસ્તં મધ્યસ્થાને પાતયિત્વા કિઞ્ચિદપ્યહિંસિત્વા તસ્માદ્ બહિર્ગતવાન્|</para>
  <para style="p">
    <verse number="36" style="v"/>તતઃ સર્વ્વે લોકાશ્ચમત્કૃત્ય પરસ્પરં વક્તુમારેભિરે કોયં ચમત્કારઃ| એષ પ્રભાવેણ પરાક્રમેણ ચામેધ્યભૂતાન્ આજ્ઞાપયતિ તેનૈવ તે બહિર્ગચ્છન્તિ|</para>
  <para style="p">
    <verse number="37" style="v"/>અનન્તરં ચતુર્દિક્સ્થદેશાન્ તસ્ય સુખ્યાતિર્વ્યાપ્નોત્|</para>
  <para style="p">
    <verse number="38" style="v"/>તદનન્તરં સ ભજનગેહાદ્ બહિરાગત્ય શિમોનો નિવેશનં પ્રવિવેશ તદા તસ્ય શ્વશ્રૂર્જ્વરેણાત્યન્તં પીડિતાસીત્ શિષ્યાસ્તદર્થં તસ્મિન્ વિનયં ચક્રુઃ|</para>
  <para style="p">
    <verse number="39" style="v"/>તતઃ સ તસ્યાઃ સમીપે સ્થિત્વા જ્વરં તર્જયામાસ તેનૈવ તાં જ્વરોઽત્યાક્ષીત્ તતઃ સા તત્ક્ષણમ્ ઉત્થાય તાન્ સિષેવે|</para>
  <para style="p">
    <verse number="40" style="v"/>અથ સૂર્ય્યાસ્તકાલે સ્વેષાં યે યે જના નાનારોગૈઃ પીડિતા આસન્ લોકાસ્તાન્ યીશોઃ સમીપમ્ આનિન્યુઃ, તદા સ એકૈકસ્ય ગાત્રે કરમર્પયિત્વા તાનરોગાન્ ચકાર|</para>
  <para style="p">
    <verse number="41" style="v"/>તતો ભૂતા બહુભ્યો નિર્ગત્ય ચીત્શબ્દં કૃત્વા ચ બભાષિરે ત્વમીશ્વરસ્ય પુત્રોઽભિષિક્તત્રાતા; કિન્તુ સોભિષિક્તત્રાતેતિ તે વિવિદુરેતસ્માત્ કારણાત્ તાન્ તર્જયિત્વા તદ્વક્તું નિષિષેધ|</para>
  <para style="p">
    <verse number="42" style="v"/>અપરઞ્ચ પ્રભાતે સતિ સ વિજનસ્થાનં પ્રતસ્થે પશ્ચાત્ જનાસ્તમન્વિચ્છન્તસ્તન્નિકટં ગત્વા સ્થાનાન્તરગમનાર્થં તમન્વરુન્ધન્|</para>
  <para style="p">
    <verse number="43" style="v"/>કિન્તુ સ તાન્ જગાદ, ઈશ્વરીયરાજ્યસ્ય સુસંવાદં પ્રચારયિતુમ્ અન્યાનિ પુરાણ્યપિ મયા યાતવ્યાનિ યતસ્તદર્થમેવ પ્રેરિતોહં|</para>
  <para style="p">
    <verse number="44" style="v"/>અથ ગાલીલો ભજનગેહેષુ સ ઉપદિદેશ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અનન્તરં યીશુરેકદા ગિનેષરથ્દસ્ય તીર ઉત્તિષ્ઠતિ, તદા લોકા ઈશ્વરીયકથાં શ્રોતું તદુપરિ પ્રપતિતાઃ|</para>
  <para style="p">
    <verse number="2" style="v"/>તદાનીં સ હ્દસ્ય તીરસમીપે નૌદ્વયં દદર્શ કિઞ્ચ મત્સ્યોપજીવિનો નાવં વિહાય જાલં પ્રક્ષાલયન્તિ|</para>
  <para style="p">
    <verse number="3" style="v"/>તતસ્તયોર્દ્વયો ર્મધ્યે શિમોનો નાવમારુહ્ય તીરાત્ કિઞ્ચિદ્દૂરં યાતું તસ્મિન્ વિનયં કૃત્વા નૌકાયામુપવિશ્ય લોકાન્ પ્રોપદિષ્ટવાન્|</para>
  <para style="p">
    <verse number="4" style="v"/>પશ્ચાત્ તં પ્રસ્તાવં સમાપ્ય સ શિમોનં વ્યાજહાર, ગભીરં જલં ગત્વા મત્સ્યાન્ ધર્ત્તું જાલં નિક્ષિપ|</para>
  <para style="p">
    <verse number="5" style="v"/>તતઃ શિમોન બભાષે, હે ગુરો યદ્યપિ વયં કૃત્સ્નાં યામિનીં પરિશ્રમ્ય મત્સ્યૈકમપિ ન પ્રાપ્તાસ્તથાપિ ભવતો નિદેશતો જાલં ક્ષિપામઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>અથ જાલે ક્ષિપ્તે બહુમત્સ્યપતનાદ્ આનાયઃ પ્રચ્છિન્નઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>તસ્માદ્ ઉપકર્ત્તુમ્ અન્યનૌસ્થાન્ સઙ્ગિન આયાતુમ્ ઇઙ્ગિતેન સમાહ્વયન્ તતસ્ત આગત્ય મત્સ્યૈ ર્નૌદ્વયં પ્રપૂરયામાસુ ર્યૈ ર્નૌદ્વયં પ્રમગ્નમ્|</para>
  <para style="p">
    <verse number="8" style="v"/>તદા શિમોન્પિતરસ્તદ્ વિલોક્ય યીશોશ્ચરણયોઃ પતિત્વા, હે પ્રભોહં પાપી નરો મમ નિકટાદ્ ભવાન્ યાતુ, ઇતિ કથિતવાન્|</para>
  <para style="p">
    <verse number="9" style="v"/>યતો જાલે પતિતાનાં મત્સ્યાનાં યૂથાત્ શિમોન્ તત્સઙ્ગિનશ્ચ ચમત્કૃતવન્તઃ; શિમોનઃ સહકારિણૌ સિવદેઃ પુત્રૌ યાકૂબ્ યોહન્ ચેમૌ તાદૃશૌ બભૂવતુઃ|</para>
  <para style="p">
    <verse number="10" style="v"/>તદા યીશુઃ શિમોનં જગાદ મા ભૈષીરદ્યારભ્ય ત્વં મનુષ્યધરો ભવિષ્યસિ|</para>
  <para style="p">
    <verse number="11" style="v"/>અનન્તરં સર્વ્વાસુ નૌસુ તીરમ્ આનીતાસુ તે સર્વ્વાન્ પરિત્યજ્ય તસ્ય પશ્ચાદ્ગામિનો બભૂવુઃ|</para>
  <para style="p">
    <verse number="12" style="v"/>તતઃ પરં યીશૌ કસ્મિંશ્ચિત્ પુરે તિષ્ઠતિ જન એકઃ સર્વ્વાઙ્ગકુષ્ઠસ્તં વિલોક્ય તસ્ય સમીપે ન્યુબ્જઃ પતિત્વા સવિનયં વક્તુમારેભે, હે પ્રભો યદિ ભવાનિચ્છતિ તર્હિ માં પરિષ્કર્ત્તું શક્નોતિ|</para>
  <para style="p">
    <verse number="13" style="v"/>તદાનીં સ પાણિં પ્રસાર્ય્ય તદઙ્ગં સ્પૃશન્ બભાષે ત્વં પરિષ્ક્રિયસ્વેતિ મમેચ્છાસ્તિ તતસ્તત્ક્ષણં સ કુષ્ઠાત્ મુક્તઃ|</para>
  <para style="p">
    <verse number="14" style="v"/>પશ્ચાત્ સ તમાજ્ઞાપયામાસ કથામિમાં કસ્મૈચિદ્ અકથયિત્વા યાજકસ્ય સમીપઞ્ચ ગત્વા સ્વં દર્શય, લોકેભ્યો નિજપરિષ્કૃતત્વસ્ય પ્રમાણદાનાય મૂસાજ્ઞાનુસારેણ દ્રવ્યમુત્મૃજસ્વ ચ|</para>
  <para style="p">
    <verse number="15" style="v"/>તથાપિ યીશોઃ સુખ્યાતિ ર્બહુ વ્યાપ્તુમારેભે કિઞ્ચ તસ્ય કથાં શ્રોતું સ્વીયરોગેભ્યો મોક્તુઞ્ચ લોકા આજગ્મુઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>અથ સ પ્રાન્તરં ગત્વા પ્રાર્થયાઞ્ચક્રે|</para>
  <para style="p">
    <verse number="17" style="v"/>અપરઞ્ચ એકદા યીશુરુપદિશતિ, એતર્હિ ગાલીલ્યિહૂદાપ્રદેશયોઃ સર્વ્વનગરેભ્યો યિરૂશાલમશ્ચ કિયન્તઃ ફિરૂશિલોકા વ્યવસ્થાપકાશ્ચ સમાગત્ય તદન્તિકે સમુપવિવિશુઃ, તસ્મિન્ કાલે લોકાનામારોગ્યકારણાત્ પ્રભોઃ પ્રભાવઃ પ્રચકાશે|</para>
  <para style="p">
    <verse number="18" style="v"/>પશ્ચાત્ કિયન્તો લોકા એકં પક્ષાઘાતિનં ખટ્વાયાં નિધાય યીશોઃ સમીપમાનેતું સમ્મુખે સ્થાપયિતુઞ્ચ વ્યાપ્રિયન્ત|</para>
  <para style="p">
    <verse number="19" style="v"/>કિન્તુ બહુજનનિવહસમ્વાધાત્ ન શક્નુવન્તો ગૃહોપરિ ગત્વા ગૃહપૃષ્ઠં ખનિત્વા તં પક્ષાઘાતિનં સખટ્વં ગૃહમધ્યે યીશોઃ સમ્મુખે ઽવરોહયામાસુઃ|</para>
  <para style="p">
    <verse number="20" style="v"/>તદા યીશુસ્તેષામ્ ઈદૃશં વિશ્વાસં વિલોક્ય તં પક્ષાઘાતિનં વ્યાજહાર, હે માનવ તવ પાપમક્ષમ્યત|</para>
  <para style="p">
    <verse number="21" style="v"/>તસ્માદ્ અધ્યાપકાઃ ફિરૂશિનશ્ચ ચિત્તૈરિત્થં પ્રચિન્તિતવન્તઃ, એષ જન ઈશ્વરં નિન્દતિ કોયં? કેવલમીશ્વરં વિના પાપં ક્ષન્તું કઃ શક્નોતિ?</para>
  <para style="p">
    <verse number="22" style="v"/>તદા યીશુસ્તેષામ્ ઇત્થં ચિન્તનં વિદિત્વા તેભ્યોકથયદ્ યૂયં મનોભિઃ કુતો વિતર્કયથ?</para>
  <para style="p">
    <verse number="23" style="v"/>તવ પાપક્ષમા જાતા યદ્વા ત્વમુત્થાય વ્રજ એતયો ર્મધ્યે કા કથા સુકથ્યા?</para>
  <para style="p">
    <verse number="24" style="v"/>કિન્તુ પૃથિવ્યાં પાપં ક્ષન્તું માનવસુતસ્ય સામર્થ્યમસ્તીતિ યથા યૂયં જ્ઞાતું શક્નુથ તદર્થં (સ તં પક્ષાઘાતિનં જગાદ) ઉત્તિષ્ઠ સ્વશય્યાં ગૃહીત્વા ગૃહં યાહીતિ ત્વામાદિશામિ|</para>
  <para style="p">
    <verse number="25" style="v"/>તસ્માત્ સ તત્ક્ષણમ્ ઉત્થાય સર્વ્વેષાં સાક્ષાત્ નિજશયનીયં ગૃહીત્વા ઈશ્વરં ધન્યં વદન્ નિજનિવેશનં યયૌ|</para>
  <para style="p">
    <verse number="26" style="v"/>તસ્માત્ સર્વ્વે વિસ્મય પ્રાપ્તા મનઃસુ ભીતાશ્ચ વયમદ્યાસમ્ભવકાર્ય્યાણ્યદર્શામ ઇત્યુક્ત્વા પરમેશ્વરં ધન્યં પ્રોદિતાઃ|</para>
  <para style="p">
    <verse number="27" style="v"/>તતઃ પરં બહિર્ગચ્છન્ કરસઞ્ચયસ્થાને લેવિનામાનં કરસઞ્ચાયકં દૃષ્ટ્વા યીશુસ્તમભિદધે મમ પશ્ચાદેહિ|</para>
  <para style="p">
    <verse number="28" style="v"/>તસ્માત્ સ તત્ક્ષણાત્ સર્વ્વં પરિત્યજ્ય તસ્ય પશ્ચાદિયાય|</para>
  <para style="p">
    <verse number="29" style="v"/>અનન્તરં લેવિ ર્નિજગૃહે તદર્થં મહાભોજ્યં ચકાર, તદા તૈઃ સહાનેકે કરસઞ્ચાયિનસ્તદન્યલોકાશ્ચ ભોક્તુમુપવિવિશુઃ|</para>
  <para style="p">
    <verse number="30" style="v"/>તસ્માત્ કારણાત્ ચણ્ડાલાનાં પાપિલોકાનાઞ્ચ સઙ્ગે યૂયં કુતો ભંગ્ધ્વે પિવથ ચેતિ કથાં કથયિત્વા ફિરૂશિનોઽધ્યાપકાશ્ચ તસ્ય શિષ્યૈઃ સહ વાગ્યુદ્ધં કર્ત્તુમારેભિરે|</para>
  <para style="p">
    <verse number="31" style="v"/>તસ્માદ્ યીશુસ્તાન્ પ્રત્યવોચદ્ અરોગલોકાનાં ચિકિત્સકેન પ્રયોજનં નાસ્તિ કિન્તુ સરોગાણામેવ|</para>
  <para style="p">
    <verse number="32" style="v"/>અહં ધાર્મ્મિકાન્ આહ્વાતું નાગતોસ્મિ કિન્તુ મનઃ પરાવર્ત્તયિતું પાપિન એવ|</para>
  <para style="p">
    <verse number="33" style="v"/>તતસ્તે પ્રોચુઃ, યોહનઃ ફિરૂશિનાઞ્ચ શિષ્યા વારંવારમ્ ઉપવસન્તિ પ્રાર્થયન્તે ચ કિન્તુ તવ શિષ્યાઃ કુતો ભુઞ્જતે પિવન્તિ ચ?</para>
  <para style="p">
    <verse number="34" style="v"/>તદા સ તાનાચખ્યૌ વરે સઙ્ગે તિષ્ઠતિ વરસ્ય સખિગણં કિમુપવાસયિતું શક્નુથ?</para>
  <para style="p">
    <verse number="35" style="v"/>કિન્તુ યદા તેષાં નિકટાદ્ વરો નેષ્યતે તદા તે સમુપવત્સ્યન્તિ|</para>
  <para style="p">
    <verse number="36" style="v"/>સોપરમપિ દૃષ્ટાન્તં કથયામ્બભૂવ પુરાતનવસ્ત્રે કોપિ નુતનવસ્ત્રં ન સીવ્યતિ યતસ્તેન સેવનેન જીર્ણવસ્ત્રં છિદ્યતે, નૂતનપુરાતનવસ્ત્રયો ર્મેલઞ્ચ ન ભવતિ|</para>
  <para style="p">
    <verse number="37" style="v"/>પુરાતન્યાં કુત્વાં કોપિ નુતનં દ્રાક્ષારસં ન નિદધાતિ, યતો નવીનદ્રાક્ષારસસ્ય તેજસા પુરાતની કુતૂ ર્વિદીર્ય્યતે તતો દ્રાક્ષારસઃ પતતિ કુતૂશ્ચ નશ્યતિ|</para>
  <para style="p">
    <verse number="38" style="v"/>તતો હેતો ર્નૂતન્યાં કુત્વાં નવીનદ્રાક્ષારસઃ નિધાતવ્યસ્તેનોભયસ્ય રક્ષા ભવતિ|</para>
  <para style="p">
    <verse number="39" style="v"/>અપરઞ્ચ પુરાતનં દ્રાક્ષારસં પીત્વા કોપિ નૂતનં ન વાઞ્છતિ, યતઃ સ વક્તિ નૂતનાત્ પુરાતનમ્ પ્રશસ્તમ્|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અચરઞ્ચ પર્વ્વણો દ્વિતીયદિનાત્ પરં પ્રથમવિશ્રામવારે શસ્યક્ષેત્રેણ યીશોર્ગમનકાલે તસ્ય શિષ્યાઃ કણિશં છિત્ત્વા કરેષુ મર્દ્દયિત્વા ખાદિતુમારેભિરે|</para>
  <para style="p">
    <verse number="2" style="v"/>તસ્માત્ કિયન્તઃ ફિરૂશિનસ્તાનવદન્ વિશ્રામવારે યત્ કર્મ્મ ન કર્ત્તવ્યં તત્ કુતઃ કુરુથ?</para>
  <para style="p">
    <verse number="3" style="v"/>યીશુઃ પ્રત્યુવાચ દાયૂદ્ તસ્ય સઙ્ગિનશ્ચ ક્ષુધાર્ત્તાઃ કિં ચક્રુઃ સ કથમ્ ઈશ્વરસ્ય મન્દિરં પ્રવિશ્ય</para>
  <para style="p">
    <verse number="4" style="v"/>યે દર્શનીયાઃ પૂપા યાજકાન્ વિનાન્યસ્ય કસ્યાપ્યભોજનીયાસ્તાનાનીય સ્વયં બુભજે સઙ્ગિભ્યોપિ દદૌ તત્ કિં યુષ્માભિઃ કદાપિ નાપાઠિ?</para>
  <para style="p">
    <verse number="5" style="v"/>પશ્ચાત્ સ તાનવદત્ મનુજસુતો વિશ્રામવારસ્યાપિ પ્રભુ ર્ભવતિ|</para>
  <para style="p">
    <verse number="6" style="v"/>અનન્તરમ્ અન્યવિશ્રામવારે સ ભજનગેહં પ્રવિશ્ય સમુપદિશતિ| તદા તત્સ્થાને શુષ્કદક્ષિણકર એકઃ પુમાન્ ઉપતસ્થિવાન્|</para>
  <para style="p">
    <verse number="7" style="v"/>તસ્માદ્ અધ્યાપકાઃ ફિરૂશિનશ્ચ તસ્મિન્ દોષમારોપયિતું સ વિશ્રામવારે તસ્ય સ્વાસ્થ્યં કરોતિ નવેતિ પ્રતીક્ષિતુમારેભિરે|</para>
  <para style="p">
    <verse number="8" style="v"/>તદા યીશુસ્તેષાં ચિન્તાં વિદિત્વા તં શુષ્કકરં પુમાંસં પ્રોવાચ, ત્વમુત્થાય મધ્યસ્થાને તિષ્ઠ|</para>
  <para style="p">
    <verse number="9" style="v"/>તસ્માત્ તસ્મિન્ ઉત્થિતવતિ યીશુસ્તાન્ વ્યાજહાર, યુષ્માન્ ઇમાં કથાં પૃચ્છામિ, વિશ્રામવારે હિતમ્ અહિતં વા, પ્રાણરક્ષણં પ્રાણનાશનં વા, એતેષાં કિં કર્મ્મકરણીયમ્?</para>
  <para style="p">
    <verse number="10" style="v"/>પશ્ચાત્ ચતુર્દિક્ષુ સર્વ્વાન્ વિલોક્ય તં માનવં બભાષે, નિજકરં પ્રસારય; તતસ્તેન તથા કૃત ઇતરકરવત્ તસ્ય હસ્તઃ સ્વસ્થોભવત્|</para>
  <para style="p">
    <verse number="11" style="v"/>તસ્માત્ તે પ્રચણ્ડકોપાન્વિતા યીશું કિં કરિષ્યન્તીતિ પરસ્પરં પ્રમન્ત્રિતાઃ|</para>
  <para style="p">
    <verse number="12" style="v"/>તતઃ પરં સ પર્વ્વતમારુહ્યેશ્વરમુદ્દિશ્ય પ્રાર્થયમાનઃ કૃત્સ્નાં રાત્રિં યાપિતવાન્|</para>
  <para style="p">
    <verse number="13" style="v"/>અથ દિને સતિ સ સર્વ્વાન્ શિષ્યાન્ આહૂતવાન્ તેષાં મધ્યે</para>
  <para style="p">
    <verse number="14" style="v"/>પિતરનામ્ના ખ્યાતઃ શિમોન્ તસ્ય ભ્રાતા આન્દ્રિયશ્ચ યાકૂબ્ યોહન્ ચ ફિલિપ્ બર્થલમયશ્ચ</para>
  <para style="p">
    <verse number="15" style="v"/>મથિઃ થોમા આલ્ફીયસ્ય પુત્રો યાકૂબ્ જ્વલન્તનામ્ના ખ્યાતઃ શિમોન્</para>
  <para style="p">
    <verse number="16" style="v"/>ચ યાકૂબો ભ્રાતા યિહૂદાશ્ચ તં યઃ પરકરેષુ સમર્પયિષ્યતિ સ ઈષ્કરીયોતીયયિહૂદાશ્ચૈતાન્ દ્વાદશ જનાન્ મનોનીતાન્ કૃત્વા સ જગ્રાહ તથા પ્રેરિત ઇતિ તેષાં નામ ચકાર|</para>
  <para style="p">
    <verse number="17" style="v"/>તતઃ પરં સ તૈઃ સહ પર્વ્વતાદવરુહ્ય ઉપત્યકાયાં તસ્થૌ તતસ્તસ્ય શિષ્યસઙ્ઘો યિહૂદાદેશાદ્ યિરૂશાલમશ્ચ સોરઃ સીદોનશ્ચ જલધે રોધસો જનનિહાશ્ચ એત્ય તસ્ય કથાશ્રવણાર્થં રોગમુક્ત્યર્થઞ્ચ તસ્ય સમીપે તસ્થુઃ|</para>
  <para style="p">
    <verse number="18" style="v"/>અમેધ્યભૂતગ્રસ્તાશ્ચ તન્નિકટમાગત્ય સ્વાસ્થ્યં પ્રાપુઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>સર્વ્વેષાં સ્વાસ્થ્યકરણપ્રભાવસ્ય પ્રકાશિતત્વાત્ સર્વ્વે લોકા એત્ય તં સ્પ્રષ્ટું યેતિરે|</para>
  <para style="p">
    <verse number="20" style="v"/>પશ્ચાત્ સ શિષ્યાન્ પ્રતિ દૃષ્ટિં કુત્વા જગાદ, હે દરિદ્રા યૂયં ધન્યા યત ઈશ્વરીયે રાજ્યે વોઽધિકારોસ્તિ|</para>
  <para style="p">
    <verse number="21" style="v"/>હે અધુના ક્ષુધિતલોકા યૂયં ધન્યા યતો યૂયં તર્પ્સ્યથ; હે ઇહ રોદિનો જના યૂયં ધન્યા યતો યૂયં હસિષ્યથ|</para>
  <para style="p">
    <verse number="22" style="v"/>યદા લોકા મનુષ્યસૂનો ર્નામહેતો ર્યુષ્માન્ ઋृતીયિષ્યન્તે પૃથક્ કૃત્વા નિન્દિષ્યન્તિ, અધમાનિવ યુષ્માન્ સ્વસમીપાદ્ દૂરીકરિષ્યન્તિ ચ તદા યૂયં ધન્યાઃ|</para>
  <para style="p">
    <verse number="23" style="v"/>સ્વર્ગે યુષ્માકં યથેષ્ટં ફલં ભવિષ્યતિ, એતદર્થં તસ્મિન્ દિને પ્રોલ્લસત આનન્દેન નૃત્યત ચ, તેષાં પૂર્વ્વપુરુષાશ્ચ ભવિષ્યદ્વાદિનઃ પ્રતિ તથૈવ વ્યવાહરન્|</para>
  <para style="p">
    <verse number="24" style="v"/>કિન્તુ હા હા ધનવન્તો યૂયં સુખં પ્રાપ્નુત| હન્ત પરિતૃપ્તા યૂયં ક્ષુધિતા ભવિષ્યથ;</para>
  <para style="p">
    <verse number="25" style="v"/>ઇહ હસન્તો યૂયં વત યુષ્માભિઃ શોચિતવ્યં રોદિતવ્યઞ્ચ|</para>
  <para style="p">
    <verse number="26" style="v"/>સર્વ્વૈલાકૈ ર્યુષ્માકં સુખ્યાતૌ કૃતાયાં યુષ્માકં દુર્ગતિ ર્ભવિષ્યતિ યુષ્માકં પૂર્વ્વપુરુષા મૃષાભવિષ્યદ્વાદિનઃ પ્રતિ તદ્વત્ કૃતવન્તઃ|</para>
  <para style="p">
    <verse number="27" style="v"/>હે શ્રોતારો યુષ્મભ્યમહં કથયામિ, યૂયં શત્રુષુ પ્રીયધ્વં યે ચ યુષ્માન્ દ્વિષન્તિ તેષામપિ હિતં કુરુત|</para>
  <para style="p">
    <verse number="28" style="v"/>યે ચ યુષ્માન્ શપન્તિ તેભ્ય આશિષં દત્ત યે ચ યુષ્માન્ અવમન્યન્તે તેષાં મઙ્ગલં પ્રાર્થયધ્વં|</para>
  <para style="p">
    <verse number="29" style="v"/>યદિ કશ્ચિત્ તવ કપોલે ચપેટાઘાતં કરોતિ તર્હિ તં પ્રતિ કપોલમ્ અન્યં પરાવર્ત્ત્ય સમ્મુખીકુરુ પુનશ્ચ યદિ કશ્ચિત્ તવ ગાત્રીયવસ્ત્રં હરતિ તર્હિ તં પરિધેયવસ્ત્રમ્ અપિ ગ્રહીતું મા વારય|</para>
  <para style="p">
    <verse number="30" style="v"/>યસ્ત્વાં યાચતે તસ્મૈ દેહિ, યશ્ચ તવ સમ્પત્તિં હરતિ તં મા યાચસ્વ|</para>
  <para style="p">
    <verse number="31" style="v"/>પરેભ્યઃ સ્વાન્ પ્રતિ યથાચરણમ્ અપેક્ષધ્વે પરાન્ પ્રતિ યૂયમપિ તથાચરત|</para>
  <para style="p">
    <verse number="32" style="v"/>યે જના યુષ્માસુ પ્રીયન્તે કેવલં તેષુ પ્રીયમાણેષુ યુષ્માકં કિં ફલં? પાપિલોકા અપિ સ્વેષુ પ્રીયમાણેષુ પ્રીયન્તે|</para>
  <para style="p">
    <verse number="33" style="v"/>યદિ હિતકારિણ એવ હિતં કુરુથ તર્હિ યુષ્માકં કિં ફલં? પાપિલોકા અપિ તથા કુર્વ્વન્તિ|</para>
  <para style="p">
    <verse number="34" style="v"/>યેભ્ય ઋણપરિશોધસ્ય પ્રાપ્તિપ્રત્યાશાસ્તે કેવલં તેષુ ઋણે સમર્પિતે યુષ્માકં કિં ફલં? પુનઃ પ્રાપ્ત્યાશયા પાપીલોકા અપિ પાપિજનેષુ ઋણમ્ અર્પયન્તિ|</para>
  <para style="p">
    <verse number="35" style="v"/>અતો યૂયં રિપુષ્વપિ પ્રીયધ્વં, પરહિતં કુરુત ચ; પુનઃ પ્રાપ્ત્યાશાં ત્યક્ત્વા ઋણમર્પયત, તથા કૃતે યુષ્માકં મહાફલં ભવિષ્યતિ, યૂયઞ્ચ સર્વ્વપ્રધાનસ્ય સન્તાના ઇતિ ખ્યાતિં પ્રાપ્સ્યથ, યતો યુષ્માકં પિતા કૃતઘ્નાનાં દુર્વ્ટત્તાનાઞ્ચ હિતમાચરતિ|</para>
  <para style="p">
    <verse number="36" style="v"/>અત એવ સ યથા દયાલુ ર્યૂયમપિ તાદૃશા દયાલવો ભવત|</para>
  <para style="p">
    <verse number="37" style="v"/>અપરઞ્ચ પરાન્ દોષિણો મા કુરુત તસ્માદ્ યૂયં દોષીકૃતા ન ભવિષ્યથ; અદણ્ડ્યાન્ મા દણ્ડયત તસ્માદ્ યૂયમપિ દણ્ડં ન પ્રાપ્સ્યથ; પરેષાં દોષાન્ ક્ષમધ્વં તસ્માદ્ યુષ્માકમપિ દોષાઃ ક્ષમિષ્યન્તે|</para>
  <para style="p">
    <verse number="38" style="v"/>દાનાનિદત્ત તસ્માદ્ યૂયં દાનાનિ પ્રાપ્સ્યથ, વરઞ્ચ લોકાઃ પરિમાણપાત્રં પ્રદલય્ય સઞ્ચાલ્ય પ્રોઞ્ચાલ્ય પરિપૂર્ય્ય યુષ્માકં ક્રોડેષુ સમર્પયિષ્યન્તિ; યૂયં યેન પરિમાણેન પરિમાથ તેનૈવ પરિમાણેન યુષ્મત્કૃતે પરિમાસ્યતે|</para>
  <para style="p">
    <verse number="39" style="v"/>અથ સ તેભ્યો દૃષ્ટાન્તકથામકથયત્, અન્ધો જનઃ કિમન્ધં પન્થાનં દર્શયિતું શક્નોતિ? તસ્માદ્ ઉભાવપિ કિં ગર્ત્તે ન પતિષ્યતઃ?</para>
  <para style="p">
    <verse number="40" style="v"/>ગુરોઃ શિષ્યો ન શ્રેષ્ઠઃ કિન્તુ શિષ્યે સિદ્ધે સતિ સ ગુરુતુલ્યો ભવિતું શક્નોતિ|</para>
  <para style="p">
    <verse number="41" style="v"/>અપરઞ્ચ ત્વં સ્વચક્ષુुષિ નાસામ્ અદૃષ્ટ્વા તવ ભ્રાતુશ્ચક્ષુષિ યત્તૃણમસ્તિ તદેવ કુતઃ પશ્યમિ?</para>
  <para style="p">
    <verse number="42" style="v"/>સ્વચક્ષુષિ યા નાસા વિદ્યતે તામ્ અજ્ઞાત્વા, ભ્રાતસ્તવ નેત્રાત્ તૃણં બહિઃ કરોમીતિ વાક્યં ભ્રાતરં કથં વક્તું શક્નોષિ? હે કપટિન્ પૂર્વ્વં સ્વનયનાત્ નાસાં બહિઃ કુરુ તતો ભ્રાતુશ્ચક્ષુષસ્તૃણં બહિઃ કર્ત્તું સુદૃષ્ટિં પ્રાપ્સ્યસિ|</para>
  <para style="p">
    <verse number="43" style="v"/>અન્યઞ્ચ ઉત્તમસ્તરુઃ કદાપિ ફલમનુત્તમં ન ફલતિ, અનુત્તમતરુશ્ચ ફલમુત્તમં ન ફલતિ કારણાદતઃ ફલૈસ્તરવો જ્ઞાયન્તે|</para>
  <para style="p">
    <verse number="44" style="v"/>કણ્ટકિપાદપાત્ કોપિ ઉડુમ્બરફલાનિ ન પાતયતિ તથા શૃગાલકોલિવૃક્ષાદપિ કોપિ દ્રાક્ષાફલં ન પાતયતિ|</para>
  <para style="p">
    <verse number="45" style="v"/>તદ્વત્ સાધુલોકોઽન્તઃકરણરૂપાત્ સુભાણ્ડાગારાદ્ ઉત્તમાનિ દ્રવ્યાણિ બહિઃ કરોતિ, દુષ્ટો લોકશ્ચાન્તઃકરણરૂપાત્ કુભાણ્ડાગારાત્ કુત્સિતાનિ દ્રવ્યાણિ નિર્ગમયતિ યતોઽન્તઃકરણાનાં પૂર્ણભાવાનુરૂપાણિ વચાંસિ મુખાન્નિર્ગચ્છન્તિ|</para>
  <para style="p">
    <verse number="46" style="v"/>અપરઞ્ચ મમાજ્ઞાનુરૂપં નાચરિત્વા કુતો માં પ્રભો પ્રભો ઇતિ વદથ?</para>
  <para style="p">
    <verse number="47" style="v"/>યઃ કશ્ચિન્ મમ નિકટમ્ આગત્ય મમ કથા નિશમ્ય તદનુરૂપં કર્મ્મ કરોતિ સ કસ્ય સદૃશો ભવતિ તદહં યુષ્માન્ જ્ઞાाપયામિ|</para>
  <para style="p">
    <verse number="48" style="v"/>યો જનો ગભીરં ખનિત્વા પાષાણસ્થલે ભિત્તિં નિર્મ્માય સ્વગૃહં રચયતિ તેન સહ તસ્યોપમા ભવતિ; યત આપ્લાવિજલમેત્ય તસ્ય મૂલે વેગેન વહદપિ તદ્ગેહં લાડયિતું ન શક્નોતિ યતસ્તસ્ય ભિત્તિઃ પાષાણોપરિ તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="49" style="v"/>કિન્તુ યઃ કશ્ચિન્ મમ કથાઃ શ્રુત્વા તદનુરૂપં નાચરતિ સ ભિત્તિં વિના મૃृદુપરિ ગૃહનિર્મ્માત્રા સમાનો ભવતિ; યત આપ્લાવિજલમાગત્ય વેગેન યદા વહતિ તદા તદ્ગૃહં પતતિ તસ્ય મહત્ પતનં જાયતે|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તતઃ પરં સ લોકાનાં કર્ણગોચરે તાન્ સર્વ્વાન્ ઉપદેશાન્ સમાપ્ય યદા કફર્નાહૂમ્પુરં પ્રવિશતિ</para>
  <para style="p">
    <verse number="2" style="v"/>તદા શતસેનાપતેઃ પ્રિયદાસ એકો મૃતકલ્પઃ પીડિત આસીત્|</para>
  <para style="p">
    <verse number="3" style="v"/>અતઃ સેનાપતિ ર્યીશો ર્વાર્ત્તાં નિશમ્ય દાસસ્યારોગ્યકરણાય તસ્યાગમનાર્થં વિનયકરણાય યિહૂદીયાન્ કિયતઃ પ્રાચઃ પ્રેષયામાસ|</para>
  <para style="p">
    <verse number="4" style="v"/>તે યીશોરન્તિકં ગત્વા વિનયાતિશયં વક્તુમારેભિરે, સ સેનાપતિ ર્ભવતોનુગ્રહં પ્રાપ્તુમ્ અર્હતિ|</para>
  <para style="p">
    <verse number="5" style="v"/>યતઃ સોસ્મજ્જાતીયેષુ લોકેષુ પ્રીયતે તથાસ્મત્કૃતે ભજનગેહં નિર્મ્મિતવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>તસ્માદ્ યીશુસ્તૈઃ સહ ગત્વા નિવેશનસ્ય સમીપં પ્રાપ, તદા સ શતસેનાપતિ ર્વક્ષ્યમાણવાક્યં તં વક્તું બન્ધૂન્ પ્રાહિણોત્| હે પ્રભો સ્વયં શ્રમો ન કર્ત્તવ્યો યદ્ ભવતા મદ્ગેહમધ્યે પાદાર્પણં ક્રિયેત તદપ્યહં નાર્હામિ,</para>
  <para style="p">
    <verse number="7" style="v"/>કિઞ્ચાહં ભવત્સમીપં યાતુમપિ નાત્માનં યોગ્યં બુદ્ધવાન્, તતો ભવાન્ વાક્યમાત્રં વદતુ તેનૈવ મમ દાસઃ સ્વસ્થો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="8" style="v"/>યસ્માદ્ અહં પરાધીનોપિ મમાધીના યાઃ સેનાઃ સન્તિ તાસામ્ એકજનં પ્રતિ યાહીતિ મયા પ્રોક્તે સ યાતિ; તદન્યં પ્રતિ આયાહીતિ પ્રોક્તે સ આયાતિ; તથા નિજદાસં પ્રતિ એતત્ કુર્વ્વિતિ પ્રોક્તે સ તદેવ કરોતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>યીશુરિદં વાક્યં શ્રુત્વા વિસ્મયં યયૌ, મુખં પરાવર્ત્ય પશ્ચાદ્વર્ત્તિનો લોકાન્ બભાષે ચ, યુષ્માનહં વદામિ ઇસ્રાયેલો વંશમધ્યેપિ વિશ્વાસમીદૃશં ન પ્રાપ્નવં|</para>
  <para style="p">
    <verse number="10" style="v"/>તતસ્તે પ્રેષિતા ગૃહં ગત્વા તં પીડિતં દાસં સ્વસ્થં દદૃશુઃ|</para>
  <para style="p">
    <verse number="11" style="v"/>પરેઽહનિ સ નાયીનાખ્યં નગરં જગામ તસ્યાનેકે શિષ્યા અન્યે ચ લોકાસ્તેન સાર્દ્ધં યયુઃ|</para>
  <para style="p">
    <verse number="12" style="v"/>તેષુ તન્નગરસ્ય દ્વારસન્નિધિં પ્રાપ્તેષુ કિયન્તો લોકા એકં મૃતમનુજં વહન્તો નગરસ્ય બહિર્યાન્તિ, સ તન્માતુરેકપુત્રસ્તન્માતા ચ વિધવા; તયા સાર્દ્ધં તન્નગરીયા બહવો લોકા આસન્|</para>
  <para style="p">
    <verse number="13" style="v"/>પ્રભુસ્તાં વિલોક્ય સાનુકમ્પઃ કથયામાસ, મા રોદીઃ| સ સમીપમિત્વા ખટ્વાં પસ્પર્શ તસ્માદ્ વાહકાઃ સ્થગિતાસ્તમ્યુઃ;</para>
  <para style="p">
    <verse number="14" style="v"/>તદા સ ઉવાચ હે યુવમનુષ્ય ત્વમુત્તિષ્ઠ, ત્વામહમ્ આજ્ઞાપયામિ|</para>
  <para style="p">
    <verse number="15" style="v"/>તસ્માત્ સ મૃતો જનસ્તત્ક્ષણમુત્થાય કથાં પ્રકથિતઃ; તતો યીશુસ્તસ્ય માતરિ તં સમર્પયામાસ|</para>
  <para style="p">
    <verse number="16" style="v"/>તસ્માત્ સર્વ્વે લોકાઃ શશઙ્કિરે; એકો મહાભવિષ્યદ્વાદી મધ્યેઽસ્માકમ્ સમુદૈત્, ઈશ્વરશ્ચ સ્વલોકાનન્વગૃહ્લાત્ કથામિમાં કથયિત્વા ઈશ્વરં ધન્યં જગદુઃ|</para>
  <para style="p">
    <verse number="17" style="v"/>તતઃ પરં સમસ્તં યિહૂદાદેશં તસ્ય ચતુર્દિક્સ્થદેશઞ્ચ તસ્યૈતત્કીર્ત્તિ ર્વ્યાનશે|</para>
  <para style="p">
    <verse number="18" style="v"/>તતઃ પરં યોહનઃ શિષ્યેષુ તં તદ્વૃત્તાન્તં જ્ઞાપિતવત્સુ</para>
  <para style="p">
    <verse number="19" style="v"/>સ સ્વશિષ્યાણાં દ્વૌ જનાવાહૂય યીશું પ્રતિ વક્ષ્યમાણં વાક્યં વક્તું પ્રેષયામાસ, યસ્યાગમનમ્ અપેક્ષ્ય તિષ્ઠામો વયં કિં સ એવ જનસ્ત્વં? કિં વયમન્યમપેક્ષ્ય સ્થાસ્યામઃ?</para>
  <para style="p">
    <verse number="20" style="v"/>પશ્ચાત્તૌ માનવૌ ગત્વા કથયામાસતુઃ, યસ્યાગમનમ્ અપેક્ષ્ય તિષ્ઠામો વયં, કિં સએવ જનસ્ત્વં? કિં વયમન્યમપેક્ષ્ય સ્થાસ્યામઃ? કથામિમાં તુભ્યં કથયિતું યોહન્ મજ્જક આવાં પ્રેષિતવાન્|</para>
  <para style="p">
    <verse number="21" style="v"/>તસ્મિન્ દણ્ડે યીશૂરોગિણો મહાવ્યાધિમતો દુષ્ટભૂતગ્રસ્તાંશ્ચ બહૂન્ સ્વસ્થાન્ કૃત્વા, અનેકાન્ધેભ્યશ્ચક્ષુંષિ દત્ત્વા પ્રત્યુવાચ,</para>
  <para style="p">
    <verse number="22" style="v"/>યુવાં વ્રજતમ્ અન્ધા નેત્રાણિ ખઞ્જાશ્ચરણાનિ ચ પ્રાપ્નુવન્તિ, કુષ્ઠિનઃ પરિષ્ક્રિયન્તે, બધિરાઃ શ્રવણાનિ મૃતાશ્ચ જીવનાનિ પ્રાપ્નુવન્તિ, દરિદ્રાણાં સમીપેષુ સુસંવાદઃ પ્રચાર્ય્યતે, યં પ્રતિ વિઘ્નસ્વરૂપોહં ન ભવામિ સ ધન્યઃ,</para>
  <para style="p">
    <verse number="23" style="v"/>એતાનિ યાનિ પશ્યથઃ શૃણુથશ્ચ તાનિ યોહનં જ્ઞાપયતમ્|</para>
  <para style="p">
    <verse number="24" style="v"/>તયો ર્દૂતયો ર્ગતયોઃ સતો ર્યોહનિ સ લોકાન્ વક્તુમુપચક્રમે, યૂયં મધ્યેપ્રાન્તરં કિં દ્રષ્ટું નિરગમત? કિં વાયુના કમ્પિતં નડં?</para>
  <para style="p">
    <verse number="25" style="v"/>યૂયં કિં દ્રષ્ટું નિરગમત? કિં સૂક્ષ્મવસ્ત્રપરિધાયિનં કમપિ નરં? કિન્તુ યે સૂક્ષ્મમૃદુવસ્ત્રાણિ પરિદધતિ સૂત્તમાનિ દ્રવ્યાણિ ભુઞ્જતે ચ તે રાજધાનીષુ તિષ્ઠન્તિ|</para>
  <para style="p">
    <verse number="26" style="v"/>તર્હિ યૂયં કિં દ્રષ્ટું નિરગમત? કિમેકં ભવિષ્યદ્વાદિનં? તદેવ સત્યં કિન્તુ સ પુમાન્ ભવિષ્યદ્વાદિનોપિ શ્રેષ્ઠ ઇત્યહં યુષ્માન્ વદામિ;</para>
  <para style="p">
    <verse number="27" style="v"/>પશ્ય સ્વકીયદૂતન્તુ તવાગ્ર પ્રેષયામ્યહં| ગત્વા ત્વદીયમાર્ગન્તુ સ હિ પરિષ્કરિષ્યતિ| યદર્થે લિપિરિયમ્ આસ્તે સ એવ યોહન્|</para>
  <para style="p">
    <verse number="28" style="v"/>અતો યુષ્માનહં વદામિ સ્ત્રિયા ગર્બ્ભજાતાનાં ભવિષ્યદ્વાદિનાં મધ્યે યોહનો મજ્જકાત્ શ્રેષ્ઠઃ કોપિ નાસ્તિ, તત્રાપિ ઈશ્વરસ્ય રાજ્યે યઃ સર્વ્વસ્માત્ ક્ષુદ્રઃ સ યોહનોપિ શ્રેષ્ઠઃ|</para>
  <para style="p">
    <verse number="29" style="v"/>અપરઞ્ચ સર્વ્વે લોકાઃ કરમઞ્ચાયિનશ્ચ તસ્ય વાક્યાનિ શ્રુત્વા યોહના મજ્જનેન મજ્જિતાઃ પરમેશ્વરં નિર્દોષં મેનિરે|</para>
  <para style="p">
    <verse number="30" style="v"/>કિન્તુ ફિરૂશિનો વ્યવસ્થાપકાશ્ચ તેન ન મજ્જિતાઃ સ્વાન્ પ્રતીશ્વરસ્યોપદેશં નિષ્ફલમ્ અકુર્વ્વન્|</para>
  <para style="p">
    <verse number="31" style="v"/>અથ પ્રભુઃ કથયામાસ, ઇદાનીન્તનજનાન્ કેનોપમામિ? તે કસ્ય સદૃશાઃ?</para>
  <para style="p">
    <verse number="32" style="v"/>યે બાલકા વિપણ્યામ્ ઉપવિશ્ય પરસ્પરમ્ આહૂય વાક્યમિદં વદન્તિ, વયં યુષ્માકં નિકટે વંશીરવાદિષ્મ, કિન્તુ યૂયં નાનર્ત્તિષ્ટ, વયં યુષ્માકં નિકટ અરોદિષ્મ, કિન્તુ યુયં ન વ્યલપિષ્ટ, બાલકૈરેતાદૃશૈસ્તેષામ્ ઉપમા ભવતિ|</para>
  <para style="p">
    <verse number="33" style="v"/>યતો યોહન્ મજ્જક આગત્ય પૂપં નાખાદત્ દ્રાક્ષારસઞ્ચ નાપિવત્ તસ્માદ્ યૂયં વદથ, ભૂતગ્રસ્તોયમ્|</para>
  <para style="p">
    <verse number="34" style="v"/>તતઃ પરં માનવસુત આગત્યાખાદદપિવઞ્ચ તસ્માદ્ યૂયં વદથ, ખાદકઃ સુરાપશ્ચાણ્ડાલપાપિનાં બન્ધુરેકો જનો દૃશ્યતામ્|</para>
  <para style="p">
    <verse number="35" style="v"/>કિન્તુ જ્ઞાનિનો જ્ઞાનં નિર્દોષં વિદુઃ|</para>
  <para style="p">
    <verse number="36" style="v"/>પશ્ચાદેકઃ ફિરૂશી યીશું ભોજનાય ન્યમન્ત્રયત્ તતઃ સ તસ્ય ગૃહં ગત્વા ભોક્તુમુપવિષ્ટઃ|</para>
  <para style="p">
    <verse number="37" style="v"/>એતર્હિ તત્ફિરૂશિનો ગૃહે યીશુ ર્ભેક્તુમ્ ઉપાવેક્ષીત્ તચ્છ્રુત્વા તન્નગરવાસિની કાપિ દુષ્ટા નારી પાણ્ડરપ્રસ્તરસ્ય સમ્પુટકે સુગન્ધિતૈલમ્ આનીય</para>
  <para style="p">
    <verse number="38" style="v"/>તસ્ય પશ્ચાત્ પાદયોઃ સન્નિધૌ તસ્યૌ રુદતી ચ નેત્રામ્બુભિસ્તસ્ય ચરણૌ પ્રક્ષાલ્ય નિજકચૈરમાર્ક્ષીત્, તતસ્તસ્ય ચરણૌ ચુમ્બિત્વા તેન સુગન્ધિતૈલેન મમર્દ|</para>
  <para style="p">
    <verse number="39" style="v"/>તસ્માત્ સ નિમન્ત્રયિતા ફિરૂશી મનસા ચિન્તયામાસ, યદ્યયં ભવિષ્યદ્વાદી ભવેત્ તર્હિ એનં સ્પૃશતિ યા સ્ત્રી સા કા કીદૃશી ચેતિ જ્ઞાતું શક્નુયાત્ યતઃ સા દુષ્ટા|</para>
  <para style="p">
    <verse number="40" style="v"/>તદા યાશુસ્તં જગાદ, હે શિમોન્ ત્વાં પ્રતિ મમ કિઞ્ચિદ્ વક્તવ્યમસ્તિ; તસ્માત્ સ બભાષે, હે ગુરો તદ્ વદતુ|</para>
  <para style="p">
    <verse number="41" style="v"/>એકોત્તમર્ણસ્ય દ્વાવધમર્ણાવાસ્તાં, તયોરેકઃ પઞ્ચશતાનિ મુદ્રાપાદાન્ અપરશ્ચ પઞ્ચાશત્ મુદ્રાપાદાન્ ધારયામાસ|</para>
  <para style="p">
    <verse number="42" style="v"/>તદનન્તરં તયોઃ શોધ્યાભાવાત્ સ ઉત્તમર્ણસ્તયો રૃણે ચક્ષમે; તસ્માત્ તયોર્દ્વયોઃ કસ્તસ્મિન્ પ્રેષ્યતે બહુ? તદ્ બ્રૂહિ|</para>
  <para style="p">
    <verse number="43" style="v"/>શિમોન્ પ્રત્યુવાચ, મયા બુધ્યતે યસ્યાધિકમ્ ઋણં ચક્ષમે સ ઇતિ; તતો યીશુસ્તં વ્યાજહાર, ત્વં યથાર્થં વ્યચારયઃ|</para>
  <para style="p">
    <verse number="44" style="v"/>અથ તાં નારીં પ્રતિ વ્યાઘુઠ્ય શિમોનમવોચત્, સ્ત્રીમિમાં પશ્યસિ? તવ ગૃહે મય્યાગતે ત્વં પાદપ્રક્ષાલનાર્થં જલં નાદાઃ કિન્તુ યોષિદેષા નયનજલૈ ર્મમ પાદૌ પ્રક્ષાલ્ય કેશૈરમાર્ક્ષીત્|</para>
  <para style="p">
    <verse number="45" style="v"/>ત્વં માં નાચુમ્બીઃ કિન્તુ યોષિદેષા સ્વીયાગમનાદારભ્ય મદીયપાદૌ ચુમ્બિતું ન વ્યરંસ્ત|</para>
  <para style="p">
    <verse number="46" style="v"/>ત્વઞ્ચ મદીયોત્તમાઙ્ગે કિઞ્ચિદપિ તૈલં નામર્દીઃ કિન્તુ યોષિદેષા મમ ચરણૌ સુગન્ધિતૈલેનામર્દ્દીત્|</para>
  <para style="p">
    <verse number="47" style="v"/>અતસ્ત્વાં વ્યાહરામિ, એતસ્યા બહુ પાપમક્ષમ્યત તતો બહુ પ્રીયતે કિન્તુ યસ્યાલ્પપાપં ક્ષમ્યતે સોલ્પં પ્રીયતે|</para>
  <para style="p">
    <verse number="48" style="v"/>તતઃ પરં સ તાં બભાષે, ત્વદીયં પાપમક્ષમ્યત|</para>
  <para style="p">
    <verse number="49" style="v"/>તદા તેન સાર્દ્ધં યે ભોક્તુમ્ ઉપવિવિશુસ્તે પરસ્પરં વક્તુમારેભિરે, અયં પાપં ક્ષમતે ક એષઃ?</para>
  <para style="p">
    <verse number="50" style="v"/>કિન્તુ સ તાં નારીં જગાદ, તવ વિશ્વાસસ્ત્વાં પર્ય્યત્રાસ્ત ત્વં ક્ષેમેણ વ્રજ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરઞ્ચ યીશુ ર્દ્વાદશભિઃ શિષ્યૈઃ સાર્દ્ધં નાનાનગરેષુ નાનાગ્રામેષુ ચ ગચ્છન્ ઇશ્વરીયરાજત્વસ્ય સુસંવાદં પ્રચારયિતું પ્રારેભે|</para>
  <para style="p">
    <verse number="2" style="v"/>તદા યસ્યાઃ સપ્ત ભૂતા નિરગચ્છન્ સા મગ્દલીનીતિ વિખ્યાતા મરિયમ્ હેરોદ્રાજસ્ય ગૃહાધિપતેઃ હોષે ર્ભાર્ય્યા યોહના શૂશાના</para>
  <para style="p">
    <verse number="3" style="v"/>પ્રભૃતયો યા બહ્વ્યઃ સ્ત્રિયઃ દુષ્ટભૂતેભ્યો રોગેભ્યશ્ચ મુક્તાઃ સત્યો નિજવિભૂતી ર્વ્યયિત્વા તમસેવન્ત, તાઃ સર્વ્વાસ્તેન સાર્દ્ધમ્ આસન્|</para>
  <para style="p">
    <verse number="4" style="v"/>અનન્તરં નાનાનગરેભ્યો બહવો લોકા આગત્ય તસ્ય સમીપેઽમિલન્, તદા સ તેભ્ય એકાં દૃષ્ટાન્તકથાં કથયામાસ| એકઃ કૃષીબલો બીજાનિ વપ્તું બહિર્જગામ,</para>
  <para style="p">
    <verse number="5" style="v"/>તતો વપનકાલે કતિપયાનિ બીજાનિ માર્ગપાર્શ્વે પેતુઃ, તતસ્તાનિ પદતલૈ ર્દલિતાનિ પક્ષિભિ ર્ભક્ષિતાનિ ચ|</para>
  <para style="p">
    <verse number="6" style="v"/>કતિપયાનિ બીજાનિ પાષાણસ્થલે પતિતાનિ યદ્યપિ તાન્યઙ્કુરિતાનિ તથાપિ રસાભાવાત્ શુશુષુઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>કતિપયાનિ બીજાનિ કણ્ટકિવનમધ્યે પતિતાનિ તતઃ કણ્ટકિવનાનિ સંવૃદ્ધ્ય તાનિ જગ્રસુઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>તદન્યાનિ કતિપયબીજાનિ ચ ભૂમ્યામુત્તમાયાં પેતુસ્તતસ્તાન્યઙ્કુરયિત્વા શતગુણાનિ ફલાનિ ફેલુઃ| સ ઇમા કથાં કથયિત્વા પ્રોચ્ચૈઃ પ્રોવાચ, યસ્ય શ્રોતું શ્રોત્રે સ્તઃ સ શૃણોતુ|</para>
  <para style="p">
    <verse number="9" style="v"/>તતઃ પરં શિષ્યાસ્તં પપ્રચ્છુરસ્ય દૃષ્ટાન્તસ્ય કિં તાત્પર્ય્યં?</para>
  <para style="p">
    <verse number="10" style="v"/>તતઃ સ વ્યાજહાર, ઈશ્વરીયરાજ્યસ્ય ગુહ્યાનિ જ્ઞાતું યુષ્મભ્યમધિકારો દીયતે કિન્ત્વન્યે યથા દૃષ્ટ્વાપિ ન પશ્યન્તિ શ્રુત્વાપિ મ બુધ્યન્તે ચ તદર્થં તેષાં પુરસ્તાત્ તાઃ સર્વ્વાઃ કથા દૃષ્ટાન્તેન કથ્યન્તે|</para>
  <para style="p">
    <verse number="11" style="v"/>દૃષ્ટાન્તસ્યાસ્યાભિપ્રાયઃ, ઈશ્વરીયકથા બીજસ્વરૂપા|</para>
  <para style="p">
    <verse number="12" style="v"/>યે કથામાત્રં શૃણ્વન્તિ કિન્તુ પશ્ચાદ્ વિશ્વસ્ય યથા પરિત્રાણં ન પ્રાપ્નુવન્તિ તદાશયેન શૈતાનેત્ય હૃદયાતૃ તાં કથામ્ અપહરતિ ત એવ માર્ગપાર્શ્વસ્થભૂમિસ્વરૂપાઃ|</para>
  <para style="p">
    <verse number="13" style="v"/>યે કથં શ્રુત્વા સાનન્દં ગૃહ્લન્તિ કિન્ત્વબદ્ધમૂલત્વાત્ સ્વલ્પકાલમાત્રં પ્રતીત્ય પરીક્ષાકાલે ભ્રશ્યન્તિ તએવ પાષાણભૂમિસ્વરૂપાઃ|</para>
  <para style="p">
    <verse number="14" style="v"/>યે કથાં શ્રુત્વા યાન્તિ વિષયચિન્તાયાં ધનલોભેન એेહિકસુખે ચ મજ્જન્ત ઉપયુક્તફલાનિ ન ફલન્તિ ત એવોપ્તબીજકણ્ટકિભૂસ્વરૂપાઃ|</para>
  <para style="p">
    <verse number="15" style="v"/>કિન્તુ યે શ્રુત્વા સરલૈઃ શુદ્ધૈશ્ચાન્તઃકરણૈઃ કથાં ગૃહ્લન્તિ ધૈર્ય્યમ્ અવલમ્બ્ય ફલાન્યુત્પાદયન્તિ ચ ત એવોત્તમમૃત્સ્વરૂપાઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>અપરઞ્ચ પ્રદીપં પ્રજ્વાલ્ય કોપિ પાત્રેણ નાચ્છાદયતિ તથા ખટ્વાધોપિ ન સ્થાપયતિ, કિન્તુ દીપાધારોપર્ય્યેવ સ્થાપયતિ, તસ્માત્ પ્રવેશકા દીપ્તિં પશ્યન્તિ|</para>
  <para style="p">
    <verse number="17" style="v"/>યન્ન પ્રકાશયિષ્યતે તાદૃગ્ અપ્રકાશિતં વસ્તુ કિમપિ નાસ્તિ યચ્ચ ન સુવ્યક્તં પ્રચારયિષ્યતે તાદૃગ્ ગૃપ્તં વસ્તુ કિમપિ નાસ્તિ|</para>
  <para style="p">
    <verse number="18" style="v"/>અતો યૂયં કેન પ્રકારેણ શૃણુથ તત્ર સાવધાના ભવત, યસ્ય સમીપે બર્દ્ધતે તસ્મૈ પુનર્દાસ્યતે કિન્તુ યસ્યાશ્રયે ન બર્દ્ધતે તસ્ય યદ્યદસ્તિ તદપિ તસ્માત્ નેષ્યતે|</para>
  <para style="p">
    <verse number="19" style="v"/>અપરઞ્ચ યીશો ર્માતા ભ્રાતરશ્ચ તસ્ય સમીપં જિગમિષવઃ</para>
  <para style="p">
    <verse number="20" style="v"/>કિન્તુ જનતાસમ્બાધાત્ તત્સન્નિધિં પ્રાપ્તું ન શેકુઃ| તત્પશ્ચાત્ તવ માતા ભ્રાતરશ્ચ ત્વાં સાક્ષાત્ ચિકીર્ષન્તો બહિસ્તિષ્ઠનતીતિ વાર્ત્તાયાં તસ્મૈ કથિતાયાં</para>
  <para style="p">
    <verse number="21" style="v"/>સ પ્રત્યુવાચ; યે જના ઈશ્વરસ્ય કથાં શ્રુત્વા તદનુરૂપમાચરન્તિ તએવ મમ માતા ભ્રાતરશ્ચ|</para>
  <para style="p">
    <verse number="22" style="v"/>અનન્તરં એકદા યીશુઃ શિષ્યૈઃ સાર્દ્ધં નાવમારુહ્ય જગાદ, આયાત વયં હ્રદસ્ય પારં યામઃ, તતસ્તે જગ્મુઃ|</para>
  <para style="p">
    <verse number="23" style="v"/>તેષુ નૌકાં વાહયત્સુ સ નિદદ્રૌ;</para>
  <para style="p">
    <verse number="24" style="v"/>અથાકસ્માત્ પ્રબલઝઞ્ભ્શગમાદ્ હ્રદે નૌકાયાં તરઙ્ગૈરાચ્છન્નાયાં વિપત્ તાન્ જગ્રાસ| તસ્માદ્ યીશોરન્તિકં ગત્વા હે ગુરો હે ગુરો પ્રાણા નો યાન્તીતિ ગદિત્વા તં જાગરયામ્બભૂવુઃ| તદા સ ઉત્થાય વાયું તરઙ્ગાંશ્ચ તર્જયામાસ તસ્માદુભૌ નિવૃત્ય સ્થિરૌ બભૂવતુઃ|</para>
  <para style="p">
    <verse number="25" style="v"/>સ તાન્ બભાષે યુષ્માકં વિશ્વાસઃ ક? તસ્માત્તે ભીતા વિસ્મિતાશ્ચ પરસ્પરં જગદુઃ, અહો કીદૃગયં મનુજઃ પવનં પાનીયઞ્ચાદિશતિ તદુભયં તદાદેશં વહતિ|</para>
  <para style="p">
    <verse number="26" style="v"/>તતઃ પરં ગાલીલ્પ્રદેશસ્ય સમ્મુખસ્થગિદેરીયપ્રદેશે નૌકાયાં લગન્ત્યાં તટેઽવરોહમાવાદ્</para>
  <para style="p">
    <verse number="27" style="v"/>બહુતિથકાલં ભૂતગ્રસ્ત એકો માનુષઃ પુરાદાગત્ય તં સાક્ષાચ્ચકાર| સ મનુષો વાસો ન પરિદધત્ ગૃહે ચ ન વસન્ કેવલં શ્મશાનમ્ અધ્યુવાસ|</para>
  <para style="p">
    <verse number="28" style="v"/>સ યીશું દૃષ્ટ્વૈવ ચીચ્છબ્દં ચકાર તસ્ય સમ્મુખે પતિત્વા પ્રોચ્ચૈર્જગાદ ચ, હે સર્વ્વપ્રધાનેશ્વરસ્ય પુત્ર, મયા સહ તવ કઃ સમ્બન્ધઃ? ત્વયિ વિનયં કરોમિ માં મા યાતય|</para>
  <para style="p">
    <verse number="29" style="v"/>યતઃ સ તં માનુષં ત્યક્ત્વા યાતુમ્ અમેધ્યભૂતમ્ આદિદેશ; સ ભૂતસ્તં માનુષમ્ અસકૃદ્ દધાર તસ્માલ્લોકાઃ શૃઙ્ખલેન નિગડેન ચ બબન્ધુઃ; સ તદ્ ભંક્ત્વા ભૂતવશત્વાત્ મધ્યેપ્રાન્તરં યયૌ|</para>
  <para style="p">
    <verse number="30" style="v"/>અનન્તરં યીશુસ્તં પપ્રચ્છ તવ કિન્નામ? સ ઉવાચ, મમ નામ બાહિનો યતો બહવો ભૂતાસ્તમાશિશ્રિયુઃ|</para>
  <para style="p">
    <verse number="31" style="v"/>અથ ભૂતા વિનયેન જગદુઃ, ગભીરં ગર્ત્તં ગન્તું માજ્ઞાપયાસ્માન્|</para>
  <para style="p">
    <verse number="32" style="v"/>તદા પર્વ્વતોપરિ વરાહવ્રજશ્ચરતિ તસ્માદ્ ભૂતા વિનયેન પ્રોચુઃ, અમું વરાહવ્રજમ્ આશ્રયિતુમ્ અસ્માન્ અનુજાનીહિ; તતઃ સોનુજજ્ઞૌ|</para>
  <para style="p">
    <verse number="33" style="v"/>તતઃ પરં ભૂતાસ્તં માનુષં વિહાય વરાહવ્રજમ્ આશિશ્રિયુઃ વરાહવ્રજાશ્ચ તત્ક્ષણાત્ કટકેન ધાવન્તો હ્રદે પ્રાણાન્ વિજૃહુઃ|</para>
  <para style="p">
    <verse number="34" style="v"/>તદ્ દૃષ્ટ્વા શૂકરરક્ષકાઃ પલાયમાના નગરં ગ્રામઞ્ચ ગત્વા તત્સર્વ્વવૃત્તાન્તં કથયામાસુઃ|</para>
  <para style="p">
    <verse number="35" style="v"/>તતઃ કિં વૃત્તમ્ એતદ્દર્શનાર્થં લોકા નિર્ગત્ય યીશોઃ સમીપં યયુઃ, તં માનુષં ત્યક્તભૂતં પરિહિતવસ્ત્રં સ્વસ્થમાનુષવદ્ યીશોશ્ચરણસન્નિધૌ સૂપવિશન્તં વિલોક્ય બિભ્યુઃ|</para>
  <para style="p">
    <verse number="36" style="v"/>યે લોકાસ્તસ્ય ભૂતગ્રસ્તસ્ય સ્વાસ્થ્યકરણં દદૃશુસ્તે તેભ્યઃ સર્વ્વવૃત્તાન્તં કથયામાસુઃ|</para>
  <para style="p">
    <verse number="37" style="v"/>તદનન્તરં તસ્ય ગિદેરીયપ્રદેશસ્ય ચતુર્દિક્સ્થા બહવો જના અતિત્રસ્તા વિનયેન તં જગદુઃ, ભવાન્ અસ્માકં નિકટાદ્ વ્રજતુ તસ્માત્ સ નાવમારુહ્ય તતો વ્યાઘુટ્ય જગામ|</para>
  <para style="p">
    <verse number="38" style="v"/>તદાનીં ત્યક્તભૂતમનુજસ્તેન સહ સ્થાતું પ્રાર્થયાઞ્ચક્રે</para>
  <para style="p">
    <verse number="39" style="v"/>કિન્તુ તદર્થમ્ ઈશ્વરઃ કીદૃઙ્મહાકર્મ્મ કૃતવાન્ ઇતિ નિવેશનં ગત્વા વિજ્ઞાપય, યીશુઃ કથામેતાં કથયિત્વા તં વિસસર્જ| તતઃ સ વ્રજિત્વા યીશુસ્તદર્થં યન્મહાકર્મ્મ ચકાર તત્ પુરસ્ય સર્વ્વત્ર પ્રકાશયિતું પ્રારેભે|</para>
  <para style="p">
    <verse number="40" style="v"/>અથ યીશૌ પરાવૃત્યાગતે લોકાસ્તં આદરેણ જગૃહુ ર્યસ્માત્તે સર્વ્વે તમપેક્ષાઞ્ચક્રિરે|</para>
  <para style="p">
    <verse number="41" style="v"/>તદનન્તરં યાયીર્નામ્નો ભજનગેહસ્યૈકોધિપ આગત્ય યીશોશ્ચરણયોઃ પતિત્વા સ્વનિવેશનાગમનાર્થં તસ્મિન્ વિનયં ચકાર,</para>
  <para style="p">
    <verse number="42" style="v"/>યતસ્તસ્ય દ્વાદશવર્ષવયસ્કા કન્યૈકાસીત્ સા મૃતકલ્પાભવત્| તતસ્તસ્ય ગમનકાલે માર્ગે લોકાનાં મહાન્ સમાગમો બભૂવ|</para>
  <para style="p">
    <verse number="43" style="v"/>દ્વાદશવર્ષાણિ પ્રદરરોગગ્રસ્તા નાના વૈદ્યૈશ્ચિકિત્સિતા સર્વ્વસ્વં વ્યયિત્વાપિ સ્વાસ્થ્યં ન પ્રાપ્તા યા યોષિત્ સા યીશોઃ પશ્ચાદાગત્ય તસ્ય વસ્ત્રગ્રન્થિં પસ્પર્શ|</para>
  <para style="p">
    <verse number="44" style="v"/>તસ્માત્ તત્ક્ષણાત્ તસ્યા રક્તસ્રાવો રુદ્ધઃ|</para>
  <para style="p">
    <verse number="45" style="v"/>તદાનીં યીશુરવદત્ કેનાહં સ્પૃષ્ટઃ? તતોઽનેકૈરનઙ્ગીકૃતે પિતરસ્તસ્ય સઙ્ગિનશ્ચાવદન્, હે ગુરો લોકા નિકટસ્થાઃ સન્તસ્તવ દેહે ઘર્ષયન્તિ, તથાપિ કેનાહં સ્પૃષ્ટઇતિ ભવાન્ કુતઃ પૃચ્છતિ?</para>
  <para style="p">
    <verse number="46" style="v"/>યીશુઃ કથયામાસ, કેનાપ્યહં સ્પૃષ્ટો, યતો મત્તઃ શક્તિ ર્નિર્ગતેતિ મયા નિશ્ચિતમજ્ઞાયિ|</para>
  <para style="p">
    <verse number="47" style="v"/>તદા સા નારી સ્વયં ન ગુપ્તેતિ વિદિત્વા કમ્પમાના સતી તસ્ય સમ્મુખે પપાત; યેન નિમિત્તેન તં પસ્પર્શ સ્પર્શમાત્રાચ્ચ યેન પ્રકારેણ સ્વસ્થાભવત્ તત્ સર્વ્વં તસ્ય સાક્ષાદાચખ્યૌ|</para>
  <para style="p">
    <verse number="48" style="v"/>તતઃ સ તાં જગાદ હે કન્યે સુસ્થિરા ભવ, તવ વિશ્વાસસ્ત્વાં સ્વસ્થામ્ અકાર્ષીત્ ત્વં ક્ષેમેણ યાહિ|</para>
  <para style="p">
    <verse number="49" style="v"/>યીશોરેતદ્વાક્યવદનકાલે તસ્યાધિપતે ર્નિવેશનાત્ કશ્ચિલ્લોક આગત્ય તં બભાષે, તવ કન્યા મૃતા ગુરું મા ક્લિશાન|</para>
  <para style="p">
    <verse number="50" style="v"/>કિન્તુ યીશુસ્તદાકર્ણ્યાધિપતિં વ્યાજહાર, મા ભૈષીઃ કેવલં વિશ્વસિહિ તસ્માત્ સા જીવિષ્યતિ|</para>
  <para style="p">
    <verse number="51" style="v"/>અથ તસ્ય નિવેશને પ્રાપ્તે સ પિતરં યોહનં યાકૂબઞ્ચ કન્યાયા માતરં પિતરઞ્ચ વિના, અન્યં કઞ્ચન પ્રવેષ્ટું વારયામાસ|</para>
  <para style="p">
    <verse number="52" style="v"/>અપરઞ્ચ યે રુદન્તિ વિલપન્તિ ચ તાન્ સર્વ્વાન્ જનાન્ ઉવાચ, યૂયં મા રોદિષ્ટ કન્યા ન મૃતા નિદ્રાતિ|</para>
  <para style="p">
    <verse number="53" style="v"/>કિન્તુ સા નિશ્ચિતં મૃતેતિ જ્ઞાત્વા તે તમુપજહસુઃ|</para>
  <para style="p">
    <verse number="54" style="v"/>પશ્ચાત્ સ સર્વ્વાન્ બહિઃ કૃત્વા કન્યાયાઃ કરૌ ધૃત્વાજુહુવે, હે કન્યે ત્વમુત્તિષ્ઠ,</para>
  <para style="p">
    <verse number="55" style="v"/>તસ્માત્ તસ્યાઃ પ્રાણેષુ પુનરાગતેષુ સા તત્ક્ષણાદ્ ઉત્તસ્યૌ| તદાનીં તસ્યૈ કિઞ્ચિદ્ ભક્ષ્યં દાતુમ્ આદિદેશ|</para>
  <para style="p">
    <verse number="56" style="v"/>તતસ્તસ્યાઃ પિતરૌ વિસ્મયં ગતૌ કિન્તુ સ તાવાદિદેશ ઘટનાયા એતસ્યાઃ કથાં કસ્મૈચિદપિ મા કથયતં|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તતઃ પરં સ દ્વાદશશિષ્યાનાહૂય ભૂતાન્ ત્યાજયિતું રોગાન્ પ્રતિકર્ત્તુઞ્ચ તેભ્યઃ શક્તિમાધિપત્યઞ્ચ દદૌ|</para>
  <para style="p">
    <verse number="2" style="v"/>અપરઞ્ચ ઈશ્વરીયરાજ્યસ્ય સુસંવાદં પ્રકાશયિતુમ્ રોગિણામારોગ્યં કર્ત્તુઞ્ચ પ્રેરણકાલે તાન્ જગાદ|</para>
  <para style="p">
    <verse number="3" style="v"/>યાત્રાર્થં યષ્ટિ ર્વસ્ત્રપુટકં ભક્ષ્યં મુદ્રા દ્વિતીયવસ્ત્રમ્, એષાં કિમપિ મા ગૃહ્લીત|</para>
  <para style="p">
    <verse number="4" style="v"/>યૂયઞ્ચ યન્નિવેશનં પ્રવિશથ નગરત્યાગપર્ય્યનતં તન્નિવેશને તિષ્ઠત|</para>
  <para style="p">
    <verse number="5" style="v"/>તત્ર યદિ કસ્યચિત્ પુરસ્ય લોકા યુષ્માકમાતિથ્યં ન કુર્વ્વન્તિ તર્હિ તસ્માન્નગરાદ્ ગમનકાલે તેષાં વિરુદ્ધં સાક્ષ્યાર્થં યુષ્માકં પદધૂલીઃ સમ્પાતયત|</para>
  <para style="p">
    <verse number="6" style="v"/>અથ તે પ્રસ્થાય સર્વ્વત્ર સુસંવાદં પ્રચારયિતું પીડિતાન્ સ્વસ્થાન્ કર્ત્તુઞ્ચ ગ્રામેષુ ભ્રમિતું પ્રારેભિરે|</para>
  <para style="p">
    <verse number="7" style="v"/>એતર્હિ હેરોદ્ રાજા યીશોઃ સર્વ્વકર્મ્મણાં વાર્ત્તાં શ્રુત્વા ભૃશમુદ્વિવિજે</para>
  <para style="p">
    <verse number="8" style="v"/>યતઃ કેચિદૂચુર્યોહન્ શ્મશાનાદુદતિષ્ઠત્| કેચિદૂચુઃ, એલિયો દર્શનં દત્તવાન્; એવમન્યલોકા ઊચુઃ પૂર્વ્વીયઃ કશ્ચિદ્ ભવિષ્યદ્વાદી સમુત્થિતઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>કિન્તુ હેરોદુવાચ યોહનઃ શિરોઽહમછિનદમ્ ઇદાનીં યસ્યેદૃક્કર્મ્મણાં વાર્ત્તાં પ્રાપ્નોમિ સ કઃ? અથ સ તં દ્રષ્ટુમ્ ઐચ્છત્|</para>
  <para style="p">
    <verse number="10" style="v"/>અનન્તરં પ્રેરિતાઃ પ્રત્યાગત્ય યાનિ યાનિ કર્મ્માણિ ચક્રુસ્તાનિ યીશવે કથયામાસુઃ તતઃ સ તાન્ બૈત્સૈદાનામકનગરસ્ય વિજનં સ્થાનં નીત્વા ગુપ્તં જગામ|</para>
  <para style="p">
    <verse number="11" style="v"/>પશ્ચાલ્ લોકાસ્તદ્ વિદિત્વા તસ્ય પશ્ચાદ્ યયુઃ; તતઃ સ તાન્ નયન્ ઈશ્વરીયરાજ્યસ્ય પ્રસઙ્ગમુક્તવાન્, યેષાં ચિકિત્સયા પ્રયોજનમ્ આસીત્ તાન્ સ્વસ્થાન્ ચકાર ચ|</para>
  <para style="p">
    <verse number="12" style="v"/>અપરઞ્ચ દિવાવસન્ને સતિ દ્વાદશશિષ્યા યીશોરન્તિકમ્ એત્ય કથયામાસુઃ, વયમત્ર પ્રાન્તરસ્થાને તિષ્ઠામઃ, તતો નગરાણિ ગ્રામાણિ ગત્વા વાસસ્થાનાનિ પ્રાપ્ય ભક્ષ્યદ્રવ્યાણિ ક્રેતું જનનિવહં ભવાન્ વિસૃજતુ|</para>
  <para style="p">
    <verse number="13" style="v"/>તદા સ ઉવાચ, યૂયમેવ તાન્ ભેજયધ્વં; તતસ્તે પ્રોચુરસ્માકં નિકટે કેવલં પઞ્ચ પૂપા દ્વૌ મત્સ્યૌ ચ વિદ્યન્તે, અતએવ સ્થાનાન્તરમ્ ઇત્વા નિમિત્તમેતેષાં ભક્ષ્યદ્રવ્યેષુ ન ક્રીતેષુ ન ભવતિ|</para>
  <para style="p">
    <verse number="14" style="v"/>તત્ર પ્રાયેણ પઞ્ચસહસ્રાણિ પુરુષા આસન્|</para>
  <para style="p">
    <verse number="15" style="v"/>તદા સ શિષ્યાન્ જગાદ પઞ્ચાશત્ પઞ્ચાશજ્જનૈઃ પંક્તીકૃત્ય તાનુપવેશયત, તસ્માત્ તે તદનુસારેણ સર્વ્વલોકાનુપવેશયાપાસુઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>તતઃ સ તાન્ પઞ્ચ પૂપાન્ મીનદ્વયઞ્ચ ગૃહીત્વા સ્વર્ગં વિલોક્યેશ્વરગુણાન્ કીર્ત્તયાઞ્ચક્રે ભઙ્ક્તા ચ લોકેભ્યઃ પરિવેષણાર્થં શિષ્યેષુ સમર્પયામ્બભૂવ|</para>
  <para style="p">
    <verse number="17" style="v"/>તતઃ સર્વ્વે ભુક્ત્વા તૃપ્તિં ગતા અવશિષ્ટાનાઞ્ચ દ્વાદશ ડલ્લકાન્ સંજગૃહુઃ|</para>
  <para style="p">
    <verse number="18" style="v"/>અથૈકદા નિર્જને શિષ્યૈઃ સહ પ્રાર્થનાકાલે તાન્ પપ્રચ્છ, લોકા માં કં વદન્તિ?</para>
  <para style="p">
    <verse number="19" style="v"/>તતસ્તે પ્રાચુઃ, ત્વાં યોહન્મજ્જકં વદન્તિ; કેચિત્ ત્વામ્ એલિયં વદન્તિ, પૂર્વ્વકાલિકઃ કશ્ચિદ્ ભવિષ્યદ્વાદી શ્મશાનાદ્ ઉદતિષ્ઠદ્ ઇત્યપિ કેચિદ્ વદન્તિ|</para>
  <para style="p">
    <verse number="20" style="v"/>તદા સ ઉવાચ, યૂયં માં કં વદથ? તતઃ પિતર ઉક્તવાન્ ત્વમ્ ઈશ્વરાભિષિક્તઃ પુરુષઃ|</para>
  <para style="p">
    <verse number="21" style="v"/>તદા સ તાન્ દૃઢમાદિદેશ, કથામેતાં કસ્મૈચિદપિ મા કથયત|</para>
  <para style="p">
    <verse number="22" style="v"/>સ પુનરુવાચ, મનુષ્યપુત્રેણ વહુયાતના ભોક્તવ્યાઃ પ્રાચીનલોકૈઃ પ્રધાનયાજકૈરધ્યાપકૈશ્ચ સોવજ્ઞાય હન્તવ્યઃ કિન્તુ તૃતીયદિવસે શ્મશાનાત્ તેનોત્થાતવ્યમ્|</para>
  <para style="p">
    <verse number="23" style="v"/>અપરં સ સર્વ્વાનુવાચ, કશ્ચિદ્ યદિ મમ પશ્ચાદ્ ગન્તું વાઞ્છતિ તર્હિ સ સ્વં દામ્યતુ, દિને દિને ક્રુશં ગૃહીત્વા ચ મમ પશ્ચાદાગચ્છતુ|</para>
  <para style="p">
    <verse number="24" style="v"/>યતો યઃ કશ્ચિત્ સ્વપ્રાણાન્ રિરક્ષિષતિ સ તાન્ હારયિષ્યતિ, યઃ કશ્ચિન્ મદર્થં પ્રાણાન્ હારયિષ્યતિ સ તાન્ રક્ષિષ્યતિ|</para>
  <para style="p">
    <verse number="25" style="v"/>કશ્ચિદ્ યદિ સર્વ્વં જગત્ પ્રાપ્નોતિ કિન્તુ સ્વપ્રાણાન્ હારયતિ સ્વયં વિનશ્યતિ ચ તર્હિ તસ્ય કો લાભઃ?</para>
  <para style="p">
    <verse number="26" style="v"/>પુન ર્યઃ કશ્ચિન્ માં મમ વાક્યં વા લજ્જાસ્પદં જાનાતિ મનુષ્યપુત્રો યદા સ્વસ્ય પિતુશ્ચ પવિત્રાણાં દૂતાનાઞ્ચ તેજોભિઃ પરિવેષ્ટિત આગમિષ્યતિ તદા સોપિ તં લજ્જાસ્પદં જ્ઞાસ્યતિ|</para>
  <para style="p">
    <verse number="27" style="v"/>કિન્તુ યુષ્માનહં યથાર્થં વદામિ, ઈશ્વરીયરાજત્વં ન દૃષ્ટવા મૃત્યું નાસ્વાદિષ્યન્તે, એતાદૃશાઃ કિયન્તો લોકા અત્ર સ્થનેઽપિ દણ્ડાયમાનાઃ સન્તિ|</para>
  <para style="p">
    <verse number="28" style="v"/>એતદાખ્યાનકથનાત્ પરં પ્રાયેણાષ્ટસુ દિનેષુ ગતેષુ સ પિતરં યોહનં યાકૂબઞ્ચ ગૃહીત્વા પ્રાર્થયિતું પર્વ્વતમેકં સમારુરોહ|</para>
  <para style="p">
    <verse number="29" style="v"/>અથ તસ્ય પ્રાર્થનકાલે તસ્ય મુખાકૃતિરન્યરૂપા જાતા, તદીયં વસ્ત્રમુજ્જ્વલશુક્લં જાતં|</para>
  <para style="p">
    <verse number="30" style="v"/>અપરઞ્ચ મૂસા એલિયશ્ચોભૌ તેજસ્વિનૌ દૃષ્ટૌ</para>
  <para style="p">
    <verse number="31" style="v"/>તૌ તેન યિરૂશાલમ્પુરે યો મૃત્યુઃ સાધિષ્યતે તદીયાં કથાં તેન સાર્દ્ધં કથયિતુમ્ આરેભાતે|</para>
  <para style="p">
    <verse number="32" style="v"/>તદા પિતરાદયઃ સ્વસ્ય સઙ્ગિનો નિદ્રયાકૃષ્ટા આસન્ કિન્તુ જાગરિત્વા તસ્ય તેજસ્તેન સાર્દ્ધમ્ ઉત્તિષ્ઠન્તૌ જનૌ ચ દદૃશુઃ|</para>
  <para style="p">
    <verse number="33" style="v"/>અથ તયોરુભયો ર્ગમનકાલે પિતરો યીશું બભાષે, હે ગુરોઽસ્માકં સ્થાનેઽસ્મિન્ સ્થિતિઃ શુભા, તત એકા ત્વદર્થા, એકા મૂસાર્થા, એકા એલિયાર્થા, ઇતિ તિસ્રઃ કુટ્યોસ્માભિ ર્નિર્મ્મીયન્તાં, ઇમાં કથાં સ ન વિવિચ્ય કથયામાસ|</para>
  <para style="p">
    <verse number="34" style="v"/>અપરઞ્ચ તદ્વાક્યવદનકાલે પયોદ એક આગત્ય તેષામુપરિ છાયાં ચકાર, તતસ્તન્મધ્યે તયોઃ પ્રવેશાત્ તે શશઙ્કિરે|</para>
  <para style="p">
    <verse number="35" style="v"/>તદા તસ્માત્ પયોદાદ્ ઇયમાકાશીયા વાણી નિર્જગામ, મમાયં પ્રિયઃ પુત્ર એતસ્ય કથાયાં મનો નિધત્ત|</para>
  <para style="p">
    <verse number="36" style="v"/>ઇતિ શબ્દે જાતે તે યીશુમેકાકિનં દદૃશુઃ કિન્તુ તે તદાનીં તસ્ય દર્શનસ્ય વાચમેકામપિ નોક્ત્વા મનઃસુ સ્થાપયામાસુઃ|</para>
  <para style="p">
    <verse number="37" style="v"/>પરેઽહનિ તેષુ તસ્માચ્છૈલાદ્ અવરૂઢેષુ તં સાક્ષાત્ કર્ત્તું બહવો લોકા આજગ્મુઃ|</para>
  <para style="p">
    <verse number="38" style="v"/>તેષાં મધ્યાદ્ એકો જન ઉચ્ચૈરુવાચ, હે ગુરો અહં વિનયં કરોમિ મમ પુત્રં પ્રતિ કૃપાદૃષ્ટિં કરોતુ, મમ સ એવૈકઃ પુત્રઃ|</para>
  <para style="p">
    <verse number="39" style="v"/>ભૂતેન ધૃતઃ સન્ સં પ્રસભં ચીચ્છબ્દં કરોતિ તન્મુખાત્ ફેણા નિર્ગચ્છન્તિ ચ, ભૂત ઇત્થં વિદાર્ય્ય ક્લિષ્ટ્વા પ્રાયશસ્તં ન ત્યજતિ|</para>
  <para style="p">
    <verse number="40" style="v"/>તસ્માત્ તં ભૂતં ત્યાજયિતું તવ શિષ્યસમીપે ન્યવેદયં કિન્તુ તે ન શેકુઃ|</para>
  <para style="p">
    <verse number="41" style="v"/>તદા યીશુરવાદીત્, રે આવિશ્વાસિન્ વિપથગામિન્ વંશ કતિકાલાન્ યુષ્માભિઃ સહ સ્થાસ્યામ્યહં યુષ્માકમ્ આચરણાનિ ચ સહિષ્યે? તવ પુત્રમિહાનય|</para>
  <para style="p">
    <verse number="42" style="v"/>તતસ્તસ્મિન્નાગતમાત્રે ભૂતસ્તં ભૂમૌ પાતયિત્વા વિદદાર; તદા યીશુસ્તમમેધ્યં ભૂતં તર્જયિત્વા બાલકં સ્વસ્થં કૃત્વા તસ્ય પિતરિ સમર્પયામાસ|</para>
  <para style="p">
    <verse number="43" style="v"/>ઈશ્વરસ્ય મહાશક્તિમ્ ઇમાં વિલોક્ય સર્વ્વે ચમચ્ચક્રુઃ; ઇત્થં યીશોઃ સર્વ્વાભિઃ ક્રિયાભિઃ સર્વ્વૈર્લોકૈરાશ્ચર્ય્યે મન્યમાને સતિ સ શિષ્યાન્ બભાષે,</para>
  <para style="p">
    <verse number="44" style="v"/>કથેયં યુષ્માકં કર્ણેષુ પ્રવિશતુ, મનુષ્યપુત્રો મનુષ્યાણાં કરેષુ સમર્પયિષ્યતે|</para>
  <para style="p">
    <verse number="45" style="v"/>કિન્તુ તે તાં કથાં ન બુબુધિરે, સ્પષ્ટત્વાભાવાત્ તસ્યા અભિપ્રાયસ્તેષાં બોધગમ્યો ન બભૂવ; તસ્યા આશયઃ ક ઇત્યપિ તે ભયાત્ પ્રષ્ટું ન શેકુઃ|</para>
  <para style="p">
    <verse number="46" style="v"/>તદનન્તરં તેષાં મધ્યે કઃ શ્રેષ્ઠઃ કથામેતાં ગૃહીત્વા તે મિથો વિવાદં ચક્રુઃ|</para>
  <para style="p">
    <verse number="47" style="v"/>તતો યીશુસ્તેષાં મનોભિપ્રાયં વિદિત્વા બાલકમેકં ગૃહીત્વા સ્વસ્ય નિકટે સ્થાપયિત્વા તાન્ જગાદ,</para>
  <para style="p">
    <verse number="48" style="v"/>યો જનો મમ નામ્નાસ્ય બાલાસ્યાતિથ્યં વિદધાતિ સ મમાતિથ્યં વિદધાતિ, યશ્ચ મમાતિથ્યં વિદધાતિ સ મમ પ્રેરકસ્યાતિથ્યં વિદધાતિ, યુષ્માકં મધ્યેયઃ સ્વં સર્વ્વસ્માત્ ક્ષુદ્રં જાનીતે સ એવ શ્રેષ્ઠો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="49" style="v"/>અપરઞ્ચ યોહન્ વ્યાજહાર હે પ્રભેा તવ નામ્ના ભૂતાન્ ત્યાજયન્તં માનુષમ્ એકં દૃષ્ટવન્તો વયં, કિન્ત્વસ્માકમ્ અપશ્ચાદ્ ગામિત્વાત્ તં ન્યષેધામ્| તદાનીં યીશુરુવાચ,</para>
  <para style="p">
    <verse number="50" style="v"/>તં મા નિષેધત, યતો યો જનોસ્માકં ન વિપક્ષઃ સ એવાસ્માકં સપક્ષો ભવતિ|</para>
  <para style="p">
    <verse number="51" style="v"/>અનન્તરં તસ્યારોહણસમય ઉપસ્થિતે સ સ્થિરચેતા યિરૂશાલમં પ્રતિ યાત્રાં કર્ત્તું નિશ્ચિત્યાગ્રે દૂતાન્ પ્રેષયામાસ|</para>
  <para style="p">
    <verse number="52" style="v"/>તસ્માત્ તે ગત્વા તસ્ય પ્રયોજનીયદ્રવ્યાણિ સંગ્રહીતું શોમિરોણીયાનાં ગ્રામં પ્રવિવિશુઃ|</para>
  <para style="p">
    <verse number="53" style="v"/>કિન્તુ સ યિરૂશાલમં નગરં યાતિ તતો હેતો ર્લોકાસ્તસ્યાતિથ્યં ન ચક્રુઃ|</para>
  <para style="p">
    <verse number="54" style="v"/>અતએવ યાકૂબ્યોહનૌ તસ્ય શિષ્યૌ તદ્ દૃષ્ટ્વા જગદતુઃ, હે પ્રભો એલિયો યથા ચકાર તથા વયમપિ કિં ગગણાદ્ આગન્તુમ્ એતાન્ ભસ્મીકર્ત્તુઞ્ચ વહ્નિમાજ્ઞાપયામઃ? ભવાન્ કિમિચ્છતિ?</para>
  <para style="p">
    <verse number="55" style="v"/>કિન્તુ સ મુખં પરાવર્ત્ય તાન્ તર્જયિત્વા ગદિતવાન્ યુષ્માકં મનોભાવઃ કઃ, ઇતિ યૂયં ન જાનીથ|</para>
  <para style="p">
    <verse number="56" style="v"/>મનુજસુતો મનુજાનાં પ્રાણાન્ નાશયિતું નાગચ્છત્, કિન્તુ રક્ષિતુમ્ આગચ્છત્| પશ્ચાદ્ ઇતરગ્રામં તે યયુઃ|</para>
  <para style="p">
    <verse number="57" style="v"/>તદનન્તરં પથિ ગમનકાલે જન એકસ્તં બભાષે, હે પ્રભો ભવાન્ યત્ર યાતિ ભવતા સહાહમપિ તત્ર યાસ્યામિ|</para>
  <para style="p">
    <verse number="58" style="v"/>તદાનીં યીશુસ્તમુવાચ, ગોમાયૂનાં ગર્ત્તા આસતે, વિહાયસીયવિહગાाનાં નીડાનિ ચ સન્તિ, કિન્તુ માનવતનયસ્ય શિરઃ સ્થાપયિતું સ્થાનં નાસ્તિ|</para>
  <para style="p">
    <verse number="59" style="v"/>તતઃ પરં સ ઇતરજનં જગાદ, ત્વં મમ પશ્ચાદ્ એહિ; તતઃ સ ઉવાચ, હે પ્રભો પૂર્વ્વં પિતરં શ્મશાને સ્થાપયિતું મામાદિશતુ|</para>
  <para style="p">
    <verse number="60" style="v"/>તદા યીશુરુવાચ, મૃતા મૃતાન્ શ્મશાને સ્થાપયન્તુ કિન્તુ ત્વં ગત્વેશ્વરીયરાજ્યસ્ય કથાં પ્રચારય|</para>
  <para style="p">
    <verse number="61" style="v"/>તતોન્યઃ કથયામાસ, હે પ્રભો મયાપિ ભવતઃ પશ્ચાદ્ ગંસ્યતે, કિન્તુ પૂર્વ્વં મમ નિવેશનસ્ય પરિજનાનામ્ અનુમતિં ગ્રહીતુમ્ અહમાદિશ્યૈ ભવતા|</para>
  <para style="p">
    <verse number="62" style="v"/>તદાનીં યીશુસ્તં પ્રોક્તવાન્, યો જનો લાઙ્ગલે કરમર્પયિત્વા પશ્ચાત્ પશ્યતિ સ ઈશ્વરીયરાજ્યં નાર્હતિ|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તતઃ પરં પ્રભુરપરાન્ સપ્તતિશિષ્યાન્ નિયુજ્ય સ્વયં યાનિ નગરાણિ યાનિ સ્થાનાનિ ચ ગમિષ્યતિ તાનિ નગરાણિ તાનિ સ્થાનાનિ ચ પ્રતિ દ્વૌ દ્વૌ જનૌ પ્રહિતવાન્|</para>
  <para style="p">
    <verse number="2" style="v"/>તેભ્યઃ કથયામાસ ચ શસ્યાનિ બહૂનીતિ સત્યં કિન્તુ છેદકા અલ્પે; તસ્માદ્ધેતોઃ શસ્યક્ષેત્રે છેદકાન્ અપરાનપિ પ્રેષયિતું ક્ષેત્રસ્વામિનં પ્રાર્થયધ્વં|</para>
  <para style="p">
    <verse number="3" style="v"/>યૂયં યાત, પશ્યત, વૃકાણાં મધ્યે મેષશાવકાનિવ યુષ્માન્ પ્રહિણોમિ|</para>
  <para style="p">
    <verse number="4" style="v"/>યૂયં ક્ષુદ્રં મહદ્ વા વસનસમ્પુટકં પાદુકાશ્ચ મા ગૃહ્લીત, માર્ગમધ્યે કમપિ મા નમત ચ|</para>
  <para style="p">
    <verse number="5" style="v"/>અપરઞ્ચ યૂયં યદ્ યત્ નિવેશનં પ્રવિશથ તત્ર નિવેશનસ્યાસ્ય મઙ્ગલં ભૂયાદિતિ વાક્યં પ્રથમં વદત|</para>
  <para style="p">
    <verse number="6" style="v"/>તસ્માત્ તસ્મિન્ નિવેશને યદિ મઙ્ગલપાત્રં સ્થાસ્યતિ તર્હિ તન્મઙ્ગલં તસ્ય ભવિષ્યતિ, નોચેત્ યુષ્માન્ પ્રતિ પરાવર્ત્તિષ્યતે|</para>
  <para style="p">
    <verse number="7" style="v"/>અપરઞ્ચ તે યત્કિઞ્ચિદ્ દાસ્યન્તિ તદેવ ભુક્ત્વા પીત્વા તસ્મિન્નિવેશને સ્થાસ્યથ; યતઃ કર્મ્મકારી જનો ભૃતિમ્ અર્હતિ; ગૃહાદ્ ગૃહં મા યાસ્યથ|</para>
  <para style="p">
    <verse number="8" style="v"/>અન્યચ્ચ યુષ્માસુ કિમપિ નગરં પ્રવિષ્ટેષુ લોકા યદિ યુષ્માકમ્ આતિથ્યં કરિષ્યન્તિ, તર્હિ યત્ ખાદ્યમ્ ઉપસ્થાસ્યન્તિ તદેવ ખાદિષ્યથ|</para>
  <para style="p">
    <verse number="9" style="v"/>તન્નગરસ્થાન્ રોગિણઃ સ્વસ્થાન્ કરિષ્યથ, ઈશ્વરીયં રાજ્યં યુષ્માકમ્ અન્તિકમ્ આગમત્ કથામેતાઞ્ચ પ્રચારયિષ્યથ|</para>
  <para style="p">
    <verse number="10" style="v"/>કિન્તુ કિમપિ પુરં યુષ્માસુ પ્રવિષ્ટેષુ લોકા યદિ યુષ્માકમ્ આતિથ્યં ન કરિષ્યન્તિ, તર્હિ તસ્ય નગરસ્ય પન્થાનં ગત્વા કથામેતાં વદિષ્યથ,</para>
  <para style="p">
    <verse number="11" style="v"/>યુષ્માકં નગરીયા યા ધૂલ્યોઽસ્માસુ સમલગન્ તા અપિ યુષ્માકં પ્રાતિકૂલ્યેન સાક્ષ્યાર્થં સમ્પાતયામઃ; તથાપીશ્વરરાજ્યં યુષ્માકં સમીપમ્ આગતમ્ ઇતિ નિશ્ચિતં જાનીત|</para>
  <para style="p">
    <verse number="12" style="v"/>અહં યુષ્મભ્યં યથાર્થં કથયામિ, વિચારદિને તસ્ય નગરસ્ય દશાતઃ સિદોમો દશા સહ્યા ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="13" style="v"/>હા હા કોરાસીન્ નગર, હા હા બૈત્સૈદાનગર યુવયોર્મધ્યે યાદૃશાનિ આશ્ચર્ય્યાણિ કર્મ્માણ્યક્રિયન્ત, તાનિ કર્મ્માણિ યદિ સોરસીદોનો ર્નગરયોરકારિષ્યન્ત, તદા ઇતો બહુદિનપૂર્વ્વં તન્નિવાસિનઃ શણવસ્ત્રાણિ પરિધાય ગાત્રેષુ ભસ્મ વિલિપ્ય સમુપવિશ્ય સમખેત્સ્યન્ત|</para>
  <para style="p">
    <verse number="14" style="v"/>અતો વિચારદિવસે યુષ્માકં દશાતઃ સોરસીદોન્નિવાસિનાં દશા સહ્યા ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="15" style="v"/>હે કફર્નાહૂમ્, ત્વં સ્વર્ગં યાવદ્ ઉન્નતા કિન્તુ નરકં યાવત્ ન્યગ્ભવિષ્યસિ|</para>
  <para style="p">
    <verse number="16" style="v"/>યો જનો યુષ્માકં વાક્યં ગૃહ્લાતિ સ મમૈવ વાક્યં ગૃહ્લાતિ; કિઞ્ચ યો જનો યુષ્માકમ્ અવજ્ઞાં કરોતિ સ મમૈવાવજ્ઞાં કરોતિ; યો જનો મમાવજ્ઞાં કરોતિ ચ સ મત્પ્રેરકસ્યૈવાવજ્ઞાં કરોતિ|</para>
  <para style="p">
    <verse number="17" style="v"/>અથ તે સપ્તતિશિષ્યા આનન્દેન પ્રત્યાગત્ય કથયામાસુઃ, હે પ્રભો ભવતો નામ્ના ભૂતા અપ્યસ્માકં વશીભવન્તિ|</para>
  <para style="p">
    <verse number="18" style="v"/>તદાનીં સ તાન્ જગાદ, વિદ્યુતમિવ સ્વર્ગાત્ પતન્તં શૈતાનમ્ અદર્શમ્|</para>
  <para style="p">
    <verse number="19" style="v"/>પશ્યત સર્પાન્ વૃશ્ચિકાન્ રિપોઃ સર્વ્વપરાક્રમાંશ્ચ પદતલૈ ર્દલયિતું યુષ્મભ્યં શક્તિં દદામિ તસ્માદ્ યુષ્માકં કાપિ હાનિ ર્ન ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="20" style="v"/>ભૂતા યુષ્માકં વશીભવન્તિ, એતન્નિમિત્તત્ મા સમુલ્લસત, સ્વર્ગે યુષ્માકં નામાનિ લિખિતાનિ સન્તીતિ નિમિત્તં સમુલ્લસત|</para>
  <para style="p">
    <verse number="21" style="v"/>તદ્ઘટિકાયાં યીશુ ર્મનસિ જાતાહ્લાદઃ કથયામાસ હે સ્વર્ગપૃથિવ્યોરેકાધિપતે પિતસ્ત્વં જ્ઞાનવતાં વિદુષાઞ્ચ લોકાનાં પુરસ્તાત્ સર્વ્વમેતદ્ અપ્રકાશ્ય બાલકાનાં પુરસ્તાત્ પ્રાકાશય એતસ્માદ્ધેતોસ્ત્વાં ધન્યં વદામિ, હે પિતરિત્થં ભવતુ યદ્ એતદેવ તવ ગોચર ઉત્તમમ્|</para>
  <para style="p">
    <verse number="22" style="v"/>પિત્રા સર્વ્વાણિ મયિ સમર્પિતાનિ પિતરં વિના કોપિ પુત્રં ન જાનાતિ કિઞ્ચ પુત્રં વિના યસ્મૈ જનાય પુત્રસ્તં પ્રકાશિતવાન્ તઞ્ચ વિના કોપિ પિતરં ન જાનાતિ|</para>
  <para style="p">
    <verse number="23" style="v"/>તપઃ પરં સ શિષ્યાન્ પ્રતિ પરાવૃત્ય ગુપ્તં જગાદ, યૂયમેતાનિ સર્વ્વાણિ પશ્યથ તતો યુષ્માકં ચક્ષૂંષિ ધન્યાનિ|</para>
  <para style="p">
    <verse number="24" style="v"/>યુષ્માનહં વદામિ, યૂયં યાનિ સર્વ્વાણિ પશ્યથ તાનિ બહવો ભવિષ્યદ્વાદિનો ભૂપતયશ્ચ દ્રષ્ટુમિચ્છન્તોપિ દ્રષ્ટું ન પ્રાપ્નુવન્, યુષ્માભિ ર્યા યાઃ કથાશ્ચ શ્રૂયન્તે તાઃ શ્રોતુમિચ્છન્તોપિ શ્રોતું નાલભન્ત|</para>
  <para style="p">
    <verse number="25" style="v"/>અનન્તરમ્ એકો વ્યવસ્થાપક ઉત્થાય તં પરીક્ષિતું પપ્રચ્છ, હે ઉપદેશક અનન્તાયુષઃ પ્રાપ્તયે મયા કિં કરણીયં?</para>
  <para style="p">
    <verse number="26" style="v"/>યીશુઃ પ્રત્યુવાચ, અત્રાર્થે વ્યવસ્થાયાં કિં લિખિતમસ્તિ? ત્વં કીદૃક્ પઠસિ?</para>
  <para style="p">
    <verse number="27" style="v"/>તતઃ સોવદત્, ત્વં સર્વ્વાન્તઃકરણૈઃ સર્વ્વપ્રાણૈઃ સર્વ્વશક્તિભિઃ સર્વ્વચિત્તૈશ્ચ પ્રભૌ પરમેશ્વરે પ્રેમ કુરુ, સમીપવાસિનિ સ્વવત્ પ્રેમ કુરુ ચ|</para>
  <para style="p">
    <verse number="28" style="v"/>તદા સ કથયામાસ, ત્વં યથાર્થં પ્રત્યવોચઃ, ઇત્થમ્ આચર તેનૈવ જીવિષ્યસિ|</para>
  <para style="p">
    <verse number="29" style="v"/>કિન્તુ સ જનઃ સ્વં નિર્દ્દોષં જ્ઞાપયિતું યીશું પપ્રચ્છ, મમ સમીપવાસી કઃ? તતો યીશુઃ પ્રત્યુવાચ,</para>
  <para style="p">
    <verse number="30" style="v"/>એકો જનો યિરૂશાલમ્પુરાદ્ યિરીહોપુરં યાતિ, એતર્હિ દસ્યૂનાં કરેષુ પતિતે તે તસ્ય વસ્ત્રાદિકં હૃતવન્તઃ તમાહત્ય મૃતપ્રાયં કૃત્વા ત્યક્ત્વા યયુઃ|</para>
  <para style="p">
    <verse number="31" style="v"/>અકસ્માદ્ એકો યાજકસ્તેન માર્ગેણ ગચ્છન્ તં દૃષ્ટ્વા માર્ગાન્યપાર્શ્વેન જગામ|</para>
  <para style="p">
    <verse number="32" style="v"/>ઇત્થમ્ એકો લેવીયસ્તત્સ્થાનં પ્રાપ્ય તસ્યાન્તિકં ગત્વા તં વિલોક્યાન્યેન પાર્શ્વેન જગામ|</para>
  <para style="p">
    <verse number="33" style="v"/>કિન્ત્વેકઃ શોમિરોણીયો ગચ્છન્ તત્સ્થાનં પ્રાપ્ય તં દૃષ્ટ્વાદયત|</para>
  <para style="p">
    <verse number="34" style="v"/>તસ્યાન્તિકં ગત્વા તસ્ય ક્ષતેષુ તૈલં દ્રાક્ષારસઞ્ચ પ્રક્ષિપ્ય ક્ષતાનિ બદ્ધ્વા નિજવાહનોપરિ તમુપવેશ્ય પ્રવાસીયગૃહમ્ આનીય તં સિષેવે|</para>
  <para style="p">
    <verse number="35" style="v"/>પરસ્મિન્ દિવસે નિજગમનકાલે દ્વૌ મુદ્રાપાદૌ તદ્ગૃહસ્વામિને દત્ત્વાવદત્ જનમેનં સેવસ્વ તત્ર યોઽધિકો વ્યયો ભવિષ્યતિ તમહં પુનરાગમનકાલે પરિશોત્સ્યામિ|</para>
  <para style="p">
    <verse number="36" style="v"/>એષાં ત્રયાણાં મધ્યે તસ્ય દસ્યુહસ્તપતિતસ્ય જનસ્ય સમીપવાસી કઃ? ત્વયા કિં બુધ્યતે?</para>
  <para style="p">
    <verse number="37" style="v"/>તતઃ સ વ્યવસ્થાપકઃ કથયામાસ યસ્તસ્મિન્ દયાં ચકાર| તદા યીશુઃ કથયામાસ ત્વમપિ ગત્વા તથાચર|</para>
  <para style="p">
    <verse number="38" style="v"/>તતઃ પરં તે ગચ્છન્ત એકં ગ્રામં પ્રવિવિશુઃ; તદા મર્થાનામા સ્ત્રી સ્વગૃહે તસ્યાતિથ્યં ચકાર|</para>
  <para style="p">
    <verse number="39" style="v"/>તસ્માત્ મરિયમ્ નામધેયા તસ્યા ભગિની યીશોઃ પદસમીપ ઉવવિશ્ય તસ્યોપદેશકથાં શ્રોતુમારેભે|</para>
  <para style="p">
    <verse number="40" style="v"/>કિન્તુ મર્થા નાનાપરિચર્ય્યાયાં વ્યગ્રા બભૂવ તસ્માદ્ધેતોસ્તસ્ય સમીપમાગત્ય બભાષે; હે પ્રભો મમ ભગિની કેવલં મમોપરિ સર્વ્વકર્મ્મણાં ભારમ્ અર્પિતવતી તત્ર ભવતા કિઞ્ચિદપિ ન મનો નિધીયતે કિમ્? મમ સાહાય્યં કર્ત્તું ભવાન્ તામાદિશતુ|</para>
  <para style="p">
    <verse number="41" style="v"/>તતો યીશુઃ પ્રત્યુવાચ હે મર્થે હે મર્થે, ત્વં નાનાકાર્ય્યેષુ ચિન્તિતવતી વ્યગ્રા ચાસિ,</para>
  <para style="p">
    <verse number="42" style="v"/>કિન્તુ પ્રયોજનીયમ્ એકમાત્રમ્ આસ્તે| અપરઞ્ચ યમુત્તમં ભાગં કોપિ હર્ત્તું ન શક્નોતિ સએવ મરિયમા વૃતઃ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અનન્તરં સ કસ્મિંશ્ચિત્ સ્થાને પ્રાર્થયત તત્સમાપ્તૌ સત્યાં તસ્યૈકઃ શિષ્યસ્તં જગાદ હે પ્રભો યોહન્ યથા સ્વશિષ્યાન્ પ્રાર્થયિતુમ્ ઉપદિષ્ટવાન્ તથા ભવાનપ્યસ્માન્ ઉપદિશતુ|</para>
  <para style="p">
    <verse number="2" style="v"/>તસ્માત્ સ કથયામાસ, પ્રાર્થનકાલે યૂયમ્ ઇત્થં કથયધ્વં, હે અસ્માકં સ્વર્ગસ્થપિતસ્તવ નામ પૂજ્યં ભવતુ; તવ રાજત્વં ભવતુ; સ્વર્ગે યથા તથા પૃથિવ્યામપિ તવેચ્છયા સર્વ્વં ભવતુ|</para>
  <para style="p">
    <verse number="3" style="v"/>પ્રત્યહમ્ અસ્માકં પ્રયોજનીયં ભોજ્યં દેહિ|</para>
  <para style="p">
    <verse number="4" style="v"/>યથા વયં સર્વ્વાન્ અપરાધિનઃ ક્ષમામહે તથા ત્વમપિ પાપાન્યસ્માકં ક્ષમસ્વ| અસ્માન્ પરીક્ષાં માનય કિન્તુ પાપાત્મનો રક્ષ|</para>
  <para style="p">
    <verse number="5" style="v"/>પશ્ચાત્ સોપરમપિ કથિતવાન્ યદિ યુષ્માકં કસ્યચિદ્ બન્ધુસ્તિષ્ઠતિ નિશીથે ચ તસ્ય સમીપં સ ગત્વા વદતિ,</para>
  <para style="p">
    <verse number="6" style="v"/>હે બન્ધો પથિક એકો બન્ધુ ર્મમ નિવેશનમ્ આયાતઃ કિન્તુ તસ્યાતિથ્યં કર્ત્તું મમાન્તિકે કિમપિ નાસ્તિ, અતએવ પૂપત્રયં મહ્યમ્ ઋણં દેહિ;</para>
  <para style="p">
    <verse number="7" style="v"/>તદા સ યદિ ગૃહમધ્યાત્ પ્રતિવદતિ માં મા ક્લિશાન, ઇદાનીં દ્વારં રુદ્ધં શયને મયા સહ બાલકાશ્ચ તિષ્ઠન્તિ તુભ્યં દાતુમ્ ઉત્થાતું ન શક્નોમિ,</para>
  <para style="p">
    <verse number="8" style="v"/>તર્હિ યુષ્માનહં વદામિ, સ યદિ મિત્રતયા તસ્મૈ કિમપિ દાતું નોત્તિષ્ઠતિ તથાપિ વારં વારં પ્રાર્થનાત ઉત્થાપિતઃ સન્ યસ્મિન્ તસ્ય પ્રયોજનં તદેવ દાસ્યતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>અતઃ કારણાત્ કથયામિ, યાચધ્વં તતો યુષ્મભ્યં દાસ્યતે, મૃગયધ્વં તત ઉદ્દેશં પ્રાપ્સ્યથ, દ્વારમ્ આહત તતો યુષ્મભ્યં દ્વારં મોક્ષ્યતે|</para>
  <para style="p">
    <verse number="10" style="v"/>યો યાચતે સ પ્રાપ્નોતિ, યો મૃગયતે સ એવોદ્દેશં પ્રાપ્નોતિ, યો દ્વારમ્ આહન્તિ તદર્થં દ્વારં મોચ્યતે|</para>
  <para style="p">
    <verse number="11" style="v"/>પુત્રેણ પૂપે યાચિતે તસ્મૈ પાષાણં દદાતિ વા મત્સ્યે યાચિતે તસ્મૈ સર્પં દદાતિ</para>
  <para style="p">
    <verse number="12" style="v"/>વા અણ્ડે યાચિતે તસ્મૈ વૃશ્ચિકં દદાતિ યુષ્માકં મધ્યે ક એતાદૃશઃ પિતાસ્તે?</para>
  <para style="p">
    <verse number="13" style="v"/>તસ્માદેવ યૂયમભદ્રા અપિ યદિ સ્વસ્વબાલકેભ્ય ઉત્તમાનિ દ્રવ્યાણિ દાતું જાનીથ તર્હ્યસ્માકં સ્વર્ગસ્થઃ પિતા નિજયાચકેભ્યઃ કિં પવિત્રમ્ આત્માનં ન દાસ્યતિ?</para>
  <para style="p">
    <verse number="14" style="v"/>અનન્તરં યીશુના કસ્માચ્ચિદ્ એકસ્મિન્ મૂકભૂતે ત્યાજિતે સતિ સ ભૂતત્યક્તો માનુષો વાક્યં વક્તુમ્ આરેભે; તતો લોકાઃ સકલા આશ્ચર્ય્યં મેનિરે|</para>
  <para style="p">
    <verse number="15" style="v"/>કિન્તુ તેષાં કેચિદૂચુ ર્જનોયં બાલસિબૂબા અર્થાદ્ ભૂતરાજેન ભૂતાન્ ત્યાજયતિ|</para>
  <para style="p">
    <verse number="16" style="v"/>તં પરીક્ષિતું કેચિદ્ આકાશીયમ્ એકં ચિહ્નં દર્શયિતું તં પ્રાર્થયાઞ્ચક્રિરે|</para>
  <para style="p">
    <verse number="17" style="v"/>તદા સ તેષાં મનઃકલ્પનાં જ્ઞાત્વા કથયામાસ, કસ્યચિદ્ રાજ્યસ્ય લોકા યદિ પરસ્પરં વિરુન્ધન્તિ તર્હિ તદ્ રાજ્યમ્ નશ્યતિ; કેચિદ્ ગૃહસ્થા યદિ પરસ્પરં વિરુન્ધન્તિ તર્હિ તેપિ નશ્યન્તિ|</para>
  <para style="p">
    <verse number="18" style="v"/>તથૈવ શૈતાનપિ સ્વલોકાન્ યદિ વિરુણદ્ધિ તદા તસ્ય રાજ્યં કથં સ્થાસ્યતિ? બાલસિબૂબાહં ભૂતાન્ ત્યાજયામિ યૂયમિતિ વદથ|</para>
  <para style="p">
    <verse number="19" style="v"/>યદ્યહં બાલસિબૂબા ભૂતાન્ ત્યાજયામિ તર્હિ યુષ્માકં સન્તાનાઃ કેન ત્યાજયન્તિ? તસ્માત્ તએવ કથાયા એતસ્યા વિચારયિતારો ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="20" style="v"/>કિન્તુ યદ્યહમ્ ઈશ્વરસ્ય પરાક્રમેણ ભૂતાન્ ત્યાજયામિ તર્હિ યુષ્માકં નિકટમ્ ઈશ્વરસ્ય રાજ્યમવશ્યમ્ ઉપતિષ્ઠતિ|</para>
  <para style="p">
    <verse number="21" style="v"/>બલવાન્ પુમાન્ સુસજ્જમાનો યતિકાલં નિજાટ્ટાલિકાં રક્ષતિ તતિકાલં તસ્ય દ્રવ્યં નિરુપદ્રવં તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="22" style="v"/>કિન્તુ તસ્માદ્ અધિકબલઃ કશ્ચિદાગત્ય યદિ તં જયતિ તર્હિ યેષુ શસ્ત્રાસ્ત્રેષુ તસ્ય વિશ્વાસ આસીત્ તાનિ સર્વ્વાણિ હૃત્વા તસ્ય દ્રવ્યાણિ ગૃહ્લાતિ|</para>
  <para style="p">
    <verse number="23" style="v"/>અતઃ કારણાદ્ યો મમ સપક્ષો ન સ વિપક્ષઃ, યો મયા સહ ન સંગૃહ્લાતિ સ વિકિરતિ|</para>
  <para style="p">
    <verse number="24" style="v"/>અપરઞ્ચ અમેધ્યભૂતો માનુષસ્યાન્તર્નિર્ગત્ય શુષ્કસ્થાને ભ્રાન્ત્વા વિશ્રામં મૃગયતે કિન્તુ ન પ્રાપ્ય વદતિ મમ યસ્માદ્ ગૃહાદ્ આગતોહં પુનસ્તદ્ ગૃહં પરાવૃત્ય યામિ|</para>
  <para style="p">
    <verse number="25" style="v"/>તતો ગત્વા તદ્ ગૃહં માર્જિતં શોભિતઞ્ચ દૃષ્ટ્વા</para>
  <para style="p">
    <verse number="26" style="v"/>તત્ક્ષણમ્ અપગત્ય સ્વસ્માદપિ દુર્મ્મતીન્ અપરાન્ સપ્તભૂતાન્ સહાનયતિ તે ચ તદ્ગૃહં પવિશ્ય નિવસન્તિ| તસ્માત્ તસ્ય મનુષ્યસ્ય પ્રથમદશાતઃ શેષદશા દુઃખતરા ભવતિ|</para>
  <para style="p">
    <verse number="27" style="v"/>અસ્યાઃ કથાયાઃ કથનકાલે જનતામધ્યસ્થા કાચિન્નારી તમુચ્ચૈઃસ્વરં પ્રોવાચ, યા યોષિત્ ત્વાં ગર્બ્ભેઽધારયત્ સ્તન્યમપાયયચ્ચ સૈવ ધન્યા|</para>
  <para style="p">
    <verse number="28" style="v"/>કિન્તુ સોકથયત્ યે પરમેશ્વરસ્ય કથાં શ્રુત્વા તદનુરૂપમ્ આચરન્તિ તએવ ધન્યાઃ|</para>
  <para style="p">
    <verse number="29" style="v"/>તતઃ પરં તસ્યાન્તિકે બહુલોકાનાં સમાગમે જાતે સ વક્તુમારેભે, આધુનિકા દુષ્ટલોકાશ્ચિહ્નં દ્રષ્ટુમિચ્છન્તિ કિન્તુ યૂનસ્ભવિષ્યદ્વાદિનશ્ચિહ્નં વિનાન્યત્ કિઞ્ચિચ્ચિહ્નં તાન્ ન દર્શયિષ્યતે|</para>
  <para style="p">
    <verse number="30" style="v"/>યૂનસ્ તુ યથા નીનિવીયલોકાનાં સમીપે ચિહ્નરૂપોભવત્ તથા વિદ્યમાનલોકાનામ્ એષાં સમીપે મનુષ્યપુત્રોપિ ચિહ્નરૂપો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="31" style="v"/>વિચારસમયે ઇદાનીન્તનલોકાનાં પ્રાતિકૂલ્યેન દક્ષિણદેશીયા રાજ્ઞી પ્રોત્થાય તાન્ દોષિણઃ કરિષ્યતિ, યતઃ સા રાજ્ઞી સુલેમાન ઉપદેશકથાં શ્રોતું પૃથિવ્યાઃ સીમાત આગચ્છત્ કિન્તુ પશ્યત સુલેમાનોપિ ગુરુતર એકો જનોઽસ્મિન્ સ્થાને વિદ્યતે|</para>
  <para style="p">
    <verse number="32" style="v"/>અપરઞ્ચ વિચારસમયે નીનિવીયલોકા અપિ વર્ત્તમાનકાલિકાનાં લોકાનાં વૈપરીત્યેન પ્રોત્થાય તાન્ દોષિણઃ કરિષ્યન્તિ, યતો હેતોસ્તે યૂનસો વાક્યાત્ ચિત્તાનિ પરિવર્ત્તયામાસુઃ કિન્તુ પશ્યત યૂનસોતિગુરુતર એકો જનોઽસ્મિન્ સ્થાને વિદ્યતે|</para>
  <para style="p">
    <verse number="33" style="v"/>પ્રદીપં પ્રજ્વાલ્ય દ્રોણસ્યાધઃ કુત્રાપિ ગુપ્તસ્થાને વા કોપિ ન સ્થાપયતિ કિન્તુ ગૃહપ્રવેશિભ્યો દીપ્તિં દાતં દીપાધારોપર્ય્યેવ સ્થાપયતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>દેહસ્ય પ્રદીપશ્ચક્ષુસ્તસ્માદેવ ચક્ષુ ર્યદિ પ્રસન્નં ભવતિ તર્હિ તવ સર્વ્વશરીરં દીપ્તિમદ્ ભવિષ્યતિ કિન્તુ ચક્ષુ ર્યદિ મલીમસં તિષ્ઠતિ તર્હિ સર્વ્વશરીરં સાન્ધકારં સ્થાસ્યતિ|</para>
  <para style="p">
    <verse number="35" style="v"/>અસ્માત્ કારણાત્ તવાન્તઃસ્થં જ્યોતિ ર્યથાન્ધકારમયં ન ભવતિ તદર્થે સાવધાનો ભવ|</para>
  <para style="p">
    <verse number="36" style="v"/>યતઃ શરીરસ્ય કુત્રાપ્યંશે સાન્ધકારે ન જાતે સર્વ્વં યદિ દીપ્તિમત્ તિષ્ઠતિ તર્હિ તુભ્યં દીપ્તિદાયિપ્રોજ્જ્વલન્ પ્રદીપ ઇવ તવ સવર્વશરીરં દીપ્તિમદ્ ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="37" style="v"/>એતત્કથાયાઃ કથનકાલે ફિરુશ્યેકો ભેજનાય તં નિમન્ત્રયામાસ, તતઃ સ ગત્વા ભોક્તુમ્ ઉપવિવેશ|</para>
  <para style="p">
    <verse number="38" style="v"/>કિન્તુ ભોજનાત્ પૂર્વ્વં નામાઙ્ક્ષીત્ એતદ્ દૃષ્ટ્વા સ ફિરુશ્યાશ્ચર્ય્યં મેને|</para>
  <para style="p">
    <verse number="39" style="v"/>તદા પ્રભુસ્તં પ્રોવાચ યૂયં ફિરૂશિલોકાઃ પાનપાત્રાણાં ભોજનપાત્રાણાઞ્ચ બહિઃ પરિષ્કુરુથ કિન્તુ યુષ્માકમન્ત ર્દૌરાત્મ્યૈ ર્દુષ્ક્રિયાભિશ્ચ પરિપૂર્ણં તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="40" style="v"/>હે સર્વ્વે નિર્બોધા યો બહિઃ સસર્જ સ એવ કિમન્ત ર્ન સસર્જ?</para>
  <para style="p">
    <verse number="41" style="v"/>તત એવ યુષ્માભિરન્તઃકરણં (ઈશ્વરાય) નિવેદ્યતાં તસ્મિન્ કૃતે યુષ્માકં સર્વ્વાણિ શુચિતાં યાસ્યન્તિ|</para>
  <para style="p">
    <verse number="42" style="v"/>કિન્તુ હન્ત ફિરૂશિગણા યૂયં ન્યાયમ્ ઈશ્વરે પ્રેમ ચ પરિત્યજ્ય પોદિનાયા અરુદાદીનાં સર્વ્વેષાં શાકાનાઞ્ચ દશમાંશાન્ દત્થ કિન્તુ પ્રથમં પાલયિત્વા શેષસ્યાલઙ્ઘનં યુષ્માકમ્ ઉચિતમાસીત્|</para>
  <para style="p">
    <verse number="43" style="v"/>હા હા ફિરૂશિનો યૂયં ભજનગેહે પ્રોચ્ચાસને આપણેષુ ચ નમસ્કારેષુ પ્રીયધ્વે|</para>
  <para style="p">
    <verse number="44" style="v"/>વત કપટિનોઽધ્યાપકાઃ ફિરૂશિનશ્ચ લોકાયત્ શ્મશાનમ્ અનુપલભ્ય તદુપરિ ગચ્છન્તિ યૂયમ્ તાદૃગપ્રકાશિતશ્મશાનવાદ્ ભવથ|</para>
  <para style="p">
    <verse number="45" style="v"/>તદાનીં વ્યવસ્થાપકાનામ્ એકા યીશુમવદત્, હે ઉપદેશક વાક્યેનેદૃશેનાસ્માસ્વપિ દોષમ્ આરોપયસિ|</para>
  <para style="p">
    <verse number="46" style="v"/>તતઃ સ ઉવાચ, હા હા વ્યવસ્થાપકા યૂયમ્ માનુષાણામ્ ઉપરિ દુઃસહ્યાન્ ભારાન્ ન્યસ્યથ કિન્તુ સ્વયમ્ એકાઙ્ગુुલ્યાપિ તાન્ ભારાન્ ન સ્પૃશથ|</para>
  <para style="p">
    <verse number="47" style="v"/>હન્ત યુષ્માકં પૂર્વ્વપુરુષા યાન્ ભવિષ્યદ્વાદિનોઽવધિષુસ્તેષાં શ્મશાનાનિ યૂયં નિર્મ્માથ|</para>
  <para style="p">
    <verse number="48" style="v"/>તેનૈવ યૂયં સ્વપૂર્વ્વપુરુષાણાં કર્મ્માણિ સંમન્યધ્વે તદેવ સપ્રમાણં કુરુથ ચ, યતસ્તે તાનવધિષુઃ યૂયં તેષાં શ્મશાનાનિ નિર્મ્માથ|</para>
  <para style="p">
    <verse number="49" style="v"/>અતએવ ઈશ્વરસ્ય શાસ્ત્રે પ્રોક્તમસ્તિ તેષામન્તિકે ભવિષ્યદ્વાદિનઃ પ્રેરિતાંશ્ચ પ્રેષયિષ્યામિ તતસ્તે તેષાં કાંશ્ચન હનિષ્યન્તિ કાંશ્ચન તાડશ્ષ્યિન્તિ|</para>
  <para style="p">
    <verse number="50" style="v"/>એતસ્માત્ કારણાત્ હાબિલઃ શોણિતપાતમારભ્ય મન્દિરયજ્ઞવેદ્યો ર્મધ્યે હતસ્ય સિખરિયસ્ય રક્તપાતપર્ય્યન્તં</para>
  <para style="p">
    <verse number="51" style="v"/>જગતઃ સૃષ્ટિમારભ્ય પૃથિવ્યાં ભવિષ્યદ્વાદિનાં યતિરક્તપાતા જાતાસ્તતીનામ્ અપરાધદણ્ડા એષાં વર્ત્તમાનલોકાનાં ભવિષ્યન્તિ, યુષ્માનહં નિશ્ચિતં વદામિ સર્વ્વે દણ્ડા વંશસ્યાસ્ય ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="52" style="v"/>હા હા વ્યવસ્થપકા યૂયં જ્ઞાનસ્ય કુઞ્ચિકાં હૃત્વા સ્વયં ન પ્રવિષ્ટા યે પ્રવેષ્ટુઞ્ચ પ્રયાસિનસ્તાનપિ પ્રવેષ્ટું વારિતવન્તઃ|</para>
  <para style="p">
    <verse number="53" style="v"/>ઇત્થં કથાકથનાદ્ અધ્યાપકાઃ ફિરૂશિનશ્ચ સતર્કાઃ</para>
  <para style="p">
    <verse number="54" style="v"/>સન્તસ્તમપવદિતું તસ્ય કથાયા દોષં ધર્ત્તમિચ્છન્તો નાનાખ્યાનકથનાય તં પ્રવર્ત્તયિતું કોપયિતુઞ્ચ પ્રારેભિરે|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તદાનીં લોકાઃ સહસ્રં સહસ્રમ્ આગત્ય સમુપસ્થિતાસ્તત એકૈકો ઽન્યેષામુપરિ પતિતુમ્ ઉપચક્રમે; તદા યીશુઃ શિષ્યાન્ બભાષે, યૂયં ફિરૂશિનાં કિણ્વરૂપકાપટ્યે વિશેષેણ સાવધાનાસ્તિષ્ઠત|</para>
  <para style="p">
    <verse number="2" style="v"/>યતો યન્ન પ્રકાશયિષ્યતે તદાચ્છન્નં વસ્તુ કિમપિ નાસ્તિ; તથા યન્ન જ્ઞાસ્યતે તદ્ ગુપ્તં વસ્તુ કિમપિ નાસ્તિ|</para>
  <para style="p">
    <verse number="3" style="v"/>અન્ધકારે તિષ્ઠનતો યાઃ કથા અકથયત તાઃ સર્વ્વાઃ કથા દીપ્તૌ શ્રોષ્યન્તે નિર્જને કર્ણે ચ યદકથયત ગૃહપૃષ્ઠાત્ તત્ પ્રચારયિષ્યતે|</para>
  <para style="p">
    <verse number="4" style="v"/>હે બન્ધવો યુષ્માનહં વદામિ, યે શરીરસ્ય નાશં વિના કિમપ્યપરં કર્ત્તું ન શક્રુવન્તિ તેભ્યો મા ભૈષ્ટ|</para>
  <para style="p">
    <verse number="5" style="v"/>તર્હિ કસ્માદ્ ભેતવ્યમ્ ઇત્યહં વદામિ, યઃ શરીરં નાશયિત્વા નરકં નિક્ષેપ્તું શક્નોતિ તસ્માદેવ ભયં કુરુત, પુનરપિ વદામિ તસ્માદેવ ભયં કુરુત|</para>
  <para style="p">
    <verse number="6" style="v"/>પઞ્ચ ચટકપક્ષિણઃ કિં દ્વાભ્યાં તામ્રખણ્ડાભ્યાં ન વિક્રીયન્તે? તથાપીશ્વરસ્તેષામ્ એકમપિ ન વિસ્મરતિ|</para>
  <para style="p">
    <verse number="7" style="v"/>યુષ્માકં શિરઃકેશા અપિ ગણિતાઃ સન્તિ તસ્માત્ મા વિભીત બહુચટકપક્ષિભ્યોપિ યૂયં બહુમૂલ્યાઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>અપરં યુષ્મભ્યં કથયામિ યઃ કશ્ચિન્ માનુષાણાં સાક્ષાન્ માં સ્વીકરોતિ મનુષ્યપુત્ર ઈશ્વરદૂતાનાં સાક્ષાત્ તં સ્વીકરિષ્યતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>કિન્તુ યઃ કશ્ચિન્માનુષાણાં સાક્ષાન્મામ્ અસ્વીકરોતિ તમ્ ઈશ્વરસ્ય દૂતાનાં સાક્ષાદ્ અહમ્ અસ્વીકરિષ્યામિ|</para>
  <para style="p">
    <verse number="10" style="v"/>અન્યચ્ચ યઃ કશ્ચિન્ મનુજસુતસ્ય નિન્દાભાવેન કાઞ્ચિત્ કથાં કથયતિ તસ્ય તત્પાપસ્ય મોચનં ભવિષ્યતિ કિન્તુ યદિ કશ્ચિત્ પવિત્રમ્ આત્માનં નિન્દતિ તર્હિ તસ્ય તત્પાપસ્ય મોચનં ન ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="11" style="v"/>યદા લોકા યુષ્માન્ ભજનગેહં વિચારકર્તૃરાજ્યકર્તૃણાં સમ્મુખઞ્ચ નેષ્યન્તિ તદા કેન પ્રકારેણ કિમુત્તરં વદિષ્યથ કિં કથયિષ્યથ ચેત્યત્ર મા ચિન્તયત;</para>
  <para style="p">
    <verse number="12" style="v"/>યતો યુષ્માભિર્યદ્ યદ્ વક્તવ્યં તત્ તસ્મિન્ સમયએવ પવિત્ર આત્મા યુષ્માન્ શિક્ષયિષ્યતિ|</para>
  <para style="p">
    <verse number="13" style="v"/>તતઃ પરં જનતામધ્યસ્થઃ કશ્ચિજ્જનસ્તં જગાદ હે ગુરો મયા સહ પૈતૃકં ધનં વિભક્તું મમ ભ્રાતરમાજ્ઞાપયતુ ભવાન્|</para>
  <para style="p">
    <verse number="14" style="v"/>કિન્તુ સ તમવદત્ હે મનુષ્ય યુવયો ર્વિચારં વિભાગઞ્ચ કર્ત્તું માં કો નિયુક્તવાન્?</para>
  <para style="p">
    <verse number="15" style="v"/>અનન્તરં સ લોકાનવદત્ લોભે સાવધાનાઃ સતર્કાશ્ચ તિષ્ઠત, યતો બહુસમ્પત્તિપ્રાપ્ત્યા મનુષ્યસ્યાયુ ર્ન ભવતિ|</para>
  <para style="p">
    <verse number="16" style="v"/>પશ્ચાદ્ દૃષ્ટાન્તકથામુત્થાપ્ય કથયામાસ, એકસ્ય ધનિનો ભૂમૌ બહૂનિ શસ્યાનિ જાતાનિ|</para>
  <para style="p">
    <verse number="17" style="v"/>તતઃ સ મનસા ચિન્તયિત્વા કથયામ્બભૂવ મમૈતાનિ સમુત્પન્નાનિ દ્રવ્યાણિ સ્થાપયિતું સ્થાનં નાસ્તિ કિં કરિષ્યામિ?</para>
  <para style="p">
    <verse number="18" style="v"/>તતોવદદ્ ઇત્થં કરિષ્યામિ, મમ સર્વ્વભાણ્ડાગારાણિ ભઙ્ક્ત્વા બૃહદ્ભાણ્ડાગારાણિ નિર્મ્માય તન્મધ્યે સર્વ્વફલાનિ દ્રવ્યાણિ ચ સ્થાપયિષ્યામિ|</para>
  <para style="p">
    <verse number="19" style="v"/>અપરં નિજમનો વદિષ્યામિ, હે મનો બહુવત્સરાર્થં નાનાદ્રવ્યાણિ સઞ્ચિતાનિ સન્તિ વિશ્રામં કુરુ ભુક્ત્વા પીત્વા કૌતુકઞ્ચ કુરુ| કિન્ત્વીશ્વરસ્તમ્ અવદત્,</para>
  <para style="p">
    <verse number="20" style="v"/>રે નિર્બોધ અદ્ય રાત્રૌ તવ પ્રાણાસ્ત્વત્તો નેષ્યન્તે તત એતાનિ યાનિ દ્રવ્યાણિ ત્વયાસાદિતાનિ તાનિ કસ્ય ભવિષ્યન્તિ?</para>
  <para style="p">
    <verse number="21" style="v"/>અતએવ યઃ કશ્ચિદ્ ઈશ્વરસ્ય સમીપે ધનસઞ્ચયમકૃત્વા કેવલં સ્વનિકટે સઞ્ચયં કરોતિ સોપિ તાદૃશઃ|</para>
  <para style="p">
    <verse number="22" style="v"/>અથ સ શિષ્યેભ્યઃ કથયામાસ, યુષ્માનહં વદામિ, કિં ખાદિષ્યામઃ? કિં પરિધાસ્યામઃ? ઇત્યુક્ત્વા જીવનસ્ય શરીરસ્ય ચાર્થં ચિન્તાં મા કાર્ષ્ટ|</para>
  <para style="p">
    <verse number="23" style="v"/>ભક્ષ્યાજ્જીવનં ભૂષણાચ્છરીરઞ્ચ શ્રેષ્ઠં ભવતિ|</para>
  <para style="p">
    <verse number="24" style="v"/>કાકપક્ષિણાં કાર્ય્યં વિચારયત, તે ન વપન્તિ શસ્યાનિ ચ ન છિન્દન્તિ, તેષાં ભાણ્ડાગારાણિ ન સન્તિ કોષાશ્ચ ન સન્તિ, તથાપીશ્વરસ્તેભ્યો ભક્ષ્યાણિ દદાતિ, યૂયં પક્ષિભ્યઃ શ્રેષ્ઠતરા ન કિં?</para>
  <para style="p">
    <verse number="25" style="v"/>અપરઞ્ચ ભાવયિત્વા નિજાયુષઃ ક્ષણમાત્રં વર્દ્ધયિતું શક્નોતિ, એતાદૃશો લાકો યુષ્માકં મધ્યે કોસ્તિ?</para>
  <para style="p">
    <verse number="26" style="v"/>અતએવ ક્ષુદ્રં કાર્ય્યં સાધયિતુમ્ અસમર્થા યૂયમ્ અન્યસ્મિન્ કાર્ય્યે કુતો ભાવયથ?</para>
  <para style="p">
    <verse number="27" style="v"/>અન્યચ્ચ કામ્પિલપુષ્પં કથં વર્દ્ધતે તદાપિ વિચારયત, તત્ કઞ્ચન શ્રમં ન કરોતિ તન્તૂંશ્ચ ન જનયતિ કિન્તુ યુષ્મભ્યં યથાર્થં કથયામિ સુલેમાન્ બહ્વૈશ્વર્ય્યાન્વિતોપિ પુષ્પસ્યાસ્ય સદૃશો વિભૂષિતો નાસીત્|</para>
  <para style="p">
    <verse number="28" style="v"/>અદ્ય ક્ષેત્રે વર્ત્તમાનં શ્વશ્ચૂલ્લ્યાં ક્ષેપ્સ્યમાનં યત્ તૃણં, તસ્મૈ યદીશ્વર ઇત્થં ભૂષયતિ તર્હિ હે અલ્પપ્રત્યયિનો યુષ્માન કિં ન પરિધાપયિષ્યતિ?</para>
  <para style="p">
    <verse number="29" style="v"/>અતએવ કિં ખાદિષ્યામઃ? કિં પરિધાસ્યામઃ? એતદર્થં મા ચેષ્ટધ્વં મા સંદિગ્ધ્વઞ્ચ|</para>
  <para style="p">
    <verse number="30" style="v"/>જગતો દેવાર્ચ્ચકા એતાનિ સર્વ્વાણિ ચેષ્ટનતે; એષુ વસ્તુષુ યુષ્માકં પ્રયોજનમાસ્તે ઇતિ યુષ્માકં પિતા જાનાતિ|</para>
  <para style="p">
    <verse number="31" style="v"/>અતએવેશ્વરસ્ય રાજ્યાર્થં સચેષ્ટા ભવત તથા કૃતે સર્વ્વાણ્યેતાનિ દ્રવ્યાણિ યુષ્મભ્યં પ્રદાયિષ્યન્તે|</para>
  <para style="p">
    <verse number="32" style="v"/>હે ક્ષુદ્રમેષવ્રજ યૂયં મા ભૈષ્ટ યુષ્મભ્યં રાજ્યં દાતું યુષ્માકં પિતુઃ સમ્મતિરસ્તિ|</para>
  <para style="p">
    <verse number="33" style="v"/>અતએવ યુષ્માકં યા યા સમ્પત્તિરસ્તિ તાં તાં વિક્રીય વિતરત, યત્ સ્થાનં ચૌરા નાગચ્છન્તિ, કીટાશ્ચ ન ક્ષાયયન્તિ તાદૃશે સ્વર્ગે નિજાર્થમ્ અજરે સમ્પુટકે ઽક્ષયં ધનં સઞ્ચિનુત ચ;</para>
  <para style="p">
    <verse number="34" style="v"/>યતો યત્ર યુષ્માકં ધનં વર્ત્તતે તત્રેવ યુષ્માકં મનઃ|</para>
  <para style="p">
    <verse number="35" style="v"/>અપરઞ્ચ યૂયં પ્રદીપં જ્વાલયિત્વા બદ્ધકટયસ્તિષ્ઠત;</para>
  <para style="p">
    <verse number="36" style="v"/>પ્રભુ ર્વિવાહાદાગત્ય યદૈવ દ્વારમાહન્તિ તદૈવ દ્વારં મોચયિતું યથા ભૃત્યા અપેક્ષ્ય તિષ્ઠન્તિ તથા યૂયમપિ તિષ્ઠત|</para>
  <para style="p">
    <verse number="37" style="v"/>યતઃ પ્રભુરાગત્ય યાન્ દાસાન્ સચેતનાન્ તિષ્ઠતો દ્રક્ષ્યતિ તએવ ધન્યાઃ; અહં યુષ્માન્ યથાર્થં વદામિ પ્રભુસ્તાન્ ભોજનાર્થમ્ ઉપવેશ્ય સ્વયં બદ્ધકટિઃ સમીપમેત્ય પરિવેષયિષ્યતિ|</para>
  <para style="p">
    <verse number="38" style="v"/>યદિ દ્વિતીયે તૃતીયે વા પ્રહરે સમાગત્ય તથૈવ પશ્યતિ, તર્હિ તએવ દાસા ધન્યાઃ|</para>
  <para style="p">
    <verse number="39" style="v"/>અપરઞ્ચ કસ્મિન્ ક્ષણે ચૌરા આગમિષ્યન્તિ ઇતિ યદિ ગૃહપતિ ર્જ્ઞાતું શક્નોતિ તદાવશ્યં જાગ્રન્ નિજગૃહે સન્ધિં કર્ત્તયિતું વારયતિ યૂયમેતદ્ વિત્ત|</para>
  <para style="p">
    <verse number="40" style="v"/>અતએવ યૂયમપિ સજ્જમાનાસ્તિષ્ઠત યતો યસ્મિન્ ક્ષણે તં નાપ્રેક્ષધ્વે તસ્મિન્નેવ ક્ષણે મનુષ્યપુત્ર આગમિષ્યતિ|</para>
  <para style="p">
    <verse number="41" style="v"/>તદા પિતરઃ પપ્રચ્છ, હે પ્રભો ભવાન્ કિમસ્માન્ ઉદ્દિશ્ય કિં સર્વ્વાન્ ઉદ્દિશ્ય દૃષ્ટાન્તકથામિમાં વદતિ?</para>
  <para style="p">
    <verse number="42" style="v"/>તતઃ પ્રભુઃ પ્રોવાચ, પ્રભુઃ સમુચિતકાલે નિજપરિવારાર્થં ભોજ્યપરિવેષણાય યં તત્પદે નિયોક્ષ્યતિ તાદૃશો વિશ્વાસ્યો બોદ્ધા કર્મ્માધીશઃ કોસ્તિ?</para>
  <para style="p">
    <verse number="43" style="v"/>પ્રભુરાગત્ય યમ્ એતાદૃશે કર્મ્મણિ પ્રવૃત્તં દ્રક્ષ્યતિ સએવ દાસો ધન્યઃ|</para>
  <para style="p">
    <verse number="44" style="v"/>અહં યુષ્માન્ યથાર્થં વદામિ સ તં નિજસર્વ્વસ્વસ્યાધિપતિં કરિષ્યતિ|</para>
  <para style="p">
    <verse number="45" style="v"/>કિન્તુ પ્રભુર્વિલમ્બેનાગમિષ્યતિ, ઇતિ વિચિન્ત્ય સ દાસો યદિ તદન્યદાસીદાસાન્ પ્રહર્ત્તુમ્ ભોક્તું પાતું મદિતુઞ્ચ પ્રારભતે,</para>
  <para style="p">
    <verse number="46" style="v"/>તર્હિ યદા પ્રભું નાપેક્ષિષ્યતે યસ્મિન્ ક્ષણે સોઽચેતનશ્ચ સ્થાસ્યતિ તસ્મિન્નેવ ક્ષણે તસ્ય પ્રભુરાગત્ય તં પદભ્રષ્ટં કૃત્વા વિશ્વાસહીનૈઃ સહ તસ્ય અંશં નિરૂપયિષ્યતિ|</para>
  <para style="p">
    <verse number="47" style="v"/>યો દાસઃ પ્રભેाરાજ્ઞાં જ્ઞાત્વાપિ સજ્જિતો ન તિષ્ઠતિ તદાજ્ઞાનુસારેણ ચ કાર્ય્યં ન કરોતિ સોનેકાન્ પ્રહારાન્ પ્રાપ્સ્યતિ;</para>
  <para style="p">
    <verse number="48" style="v"/>કિન્તુ યો જનોઽજ્ઞાત્વા પ્રહારાર્હં કર્મ્મ કરોતિ સોલ્પપ્રહારાન્ પ્રાપ્સ્યતિ| યતો યસ્મૈ બાહુલ્યેન દત્તં તસ્માદેવ બાહુલ્યેન ગ્રહીષ્યતે, માનુષા યસ્ય નિકટે બહુ સમર્પયન્તિ તસ્માદ્ બહુ યાચન્તે|</para>
  <para style="p">
    <verse number="49" style="v"/>અહં પૃથિવ્યામ્ અનૈક્યરૂપં વહ્નિ નિક્ષેપ્તુમ્ આગતોસ્મિ, સ ચેદ્ ઇદાનીમેવ પ્રજ્વલતિ તત્ર મમ કા ચિન્તા?</para>
  <para style="p">
    <verse number="50" style="v"/>કિન્તુ યેન મજ્જનેનાહં મગ્નો ભવિષ્યામિ યાવત્કાલં તસ્ય સિદ્ધિ ર્ન ભવિષ્યતિ તાવદહં કતિકષ્ટં પ્રાપ્સ્યામિ|</para>
  <para style="p">
    <verse number="51" style="v"/>મેલનં કર્ત્તું જગદ્ આગતોસ્મિ યૂયં કિમિત્થં બોધધ્વે? યુષ્માન્ વદામિ ન તથા, કિન્ત્વહં મેલનાભાવં કર્ત્તુંમ્ આગતોસ્મિ|</para>
  <para style="p">
    <verse number="52" style="v"/>યસ્માદેતત્કાલમારભ્ય એકત્રસ્થપરિજનાનાં મધ્યે પઞ્ચજનાઃ પૃથગ્ ભૂત્વા ત્રયો જના દ્વયોર્જનયોઃ પ્રતિકૂલા દ્વૌ જનૌ ચ ત્રયાણાં જનાનાં પ્રતિકૂલૌ ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="53" style="v"/>પિતા પુત્રસ્ય વિપક્ષઃ પુત્રશ્ચ પિતુ ર્વિપક્ષો ભવિષ્યતિ માતા કન્યાયા વિપક્ષા કન્યા ચ માતુ ર્વિપક્ષા ભવિષ્યતિ, તથા શ્વશ્રૂર્બધ્વા વિપક્ષા બધૂશ્ચ શ્વશ્ર્વા વિપક્ષા ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="54" style="v"/>સ લોકેભ્યોપરમપિ કથયામાસ, પશ્ચિમદિશિ મેઘોદ્ગમં દૃષ્ટ્વા યૂયં હઠાદ્ વદથ વૃષ્ટિ ર્ભવિષ્યતિ તતસ્તથૈવ જાયતે|</para>
  <para style="p">
    <verse number="55" style="v"/>અપરં દક્ષિણતો વાયૌ વાતિ સતિ વદથ નિદાઘો ભવિષ્યતિ તતઃ સોપિ જાયતે|</para>
  <para style="p">
    <verse number="56" style="v"/>રે રે કપટિન આકાશસ્ય ભૂમ્યાશ્ચ લક્ષણં બોદ્ધું શક્નુથ,</para>
  <para style="p">
    <verse number="57" style="v"/>કિન્તુ કાલસ્યાસ્ય લક્ષણં કુતો બોદ્ધું ન શક્નુથ? યૂયઞ્ચ સ્વયં કુતો ન ન્યાષ્યં વિચારયથ?</para>
  <para style="p">
    <verse number="58" style="v"/>અપરઞ્ચ વિવાદિના સાર્દ્ધં વિચારયિતુઃ સમીપં ગચ્છન્ પથિ તસ્માદુદ્ધારં પ્રાપ્તું યતસ્વ નોચેત્ સ ત્વાં ધૃત્વા વિચારયિતુઃ સમીપં નયતિ| વિચારયિતા યદિ ત્વાં પ્રહર્ત્તુઃ સમીપં સમર્પયતિ પ્રહર્ત્તા ત્વાં કારાયાં બધ્નાતિ</para>
  <para style="p">
    <verse number="59" style="v"/>તર્હિ ત્વામહં વદામિ ત્વયા નિઃશેષં કપર્દકેષુ ન પરિશોધિતેષુ ત્વં તતો મુક્તિં પ્રાપ્તું ન શક્ષ્યસિ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરઞ્ચ પીલાતો યેષાં ગાલીલીયાનાં રક્તાનિ બલીનાં રક્તૈઃ સહામિશ્રયત્ તેષાં ગાલીલીયાનાં વૃત્તાન્તં કતિપયજના ઉપસ્થાપ્ય યીશવે કથયામાસુઃ|</para>
  <para style="p">
    <verse number="2" style="v"/>તતઃ સ પ્રત્યુવાચ તેષાં લોકાનામ્ એતાદૃશી દુર્ગતિ ર્ઘટિતા તત્કારણાદ્ યૂયં કિમન્યેભ્યો ગાલીલીયેભ્યોપ્યધિકપાપિનસ્તાન્ બોધધ્વે?</para>
  <para style="p">
    <verse number="3" style="v"/>યુષ્માનહં વદામિ તથા ન કિન્તુ મનઃસુ ન પરાવર્ત્તિતેષુ યૂયમપિ તથા નંક્ષ્યથ|</para>
  <para style="p">
    <verse number="4" style="v"/>અપરઞ્ચ શીલોહનામ્ન ઉચ્ચગૃહસ્ય પતનાદ્ યેઽષ્ટાદશજના મૃતાસ્તે યિરૂશાલમિ નિવાસિસર્વ્વલોકેભ્યોઽધિકાપરાધિનઃ કિં યૂયમિત્યં બોધધ્વે?</para>
  <para style="p">
    <verse number="5" style="v"/>યુષ્માનહં વદામિ તથા ન કિન્તુ મનઃસુ ન પરિવર્ત્તિતેષુ યૂયમપિ તથા નંક્ષ્યથ|</para>
  <para style="p">
    <verse number="6" style="v"/>અનન્તરં સ ઇમાં દૃષ્ટાન્તકથામકથયદ્ એકો જનો દ્રાક્ષાક્ષેત્રમધ્ય એકમુડુમ્બરવૃક્ષં રોપિતવાન્| પશ્ચાત્ સ આગત્ય તસ્મિન્ ફલાનિ ગવેષયામાસ,</para>
  <para style="p">
    <verse number="7" style="v"/>કિન્તુ ફલાપ્રાપ્તેઃ કારણાદ્ ઉદ્યાનકારં ભૃત્યં જગાદ, પશ્ય વત્સરત્રયં યાવદાગત્ય એતસ્મિન્નુડુમ્બરતરૌ ક્ષલાન્યન્વિચ્છામિ, કિન્તુ નૈકમપિ પ્રપ્નોમિ તરુરયં કુતો વૃથા સ્થાનં વ્યાપ્ય તિષ્ઠતિ? એનં છિન્ધિ|</para>
  <para style="p">
    <verse number="8" style="v"/>તતો ભૃત્યઃ પ્રત્યુવાચ, હે પ્રભો પુનર્વર્ષમેકં સ્થાતુમ્ આદિશ; એતસ્ય મૂલસ્ય ચતુર્દિક્ષુ ખનિત્વાહમ્ આલવાલં સ્થાપયામિ|</para>
  <para style="p">
    <verse number="9" style="v"/>તતઃ ફલિતું શક્નોતિ યદિ ન ફલતિ તર્હિ પશ્ચાત્ છેત્સ્યસિ|</para>
  <para style="p">
    <verse number="10" style="v"/>અથ વિશ્રામવારે ભજનગેહે યીશુરુપદિશતિ</para>
  <para style="p">
    <verse number="11" style="v"/>તસ્મિત્ સમયે ભૂતગ્રસ્તત્વાત્ કુબ્જીભૂયાષ્ટાદશવર્ષાણિ યાવત્ કેનાપ્યુપાયેન ઋજુ ર્ભવિતું ન શક્નોતિ યા દુર્બ્બલા સ્ત્રી,</para>
  <para style="p">
    <verse number="12" style="v"/>તાં તત્રોપસ્થિતાં વિલોક્ય યીશુસ્તામાહૂય કથિતવાન્ હે નારિ તવ દૌર્બ્બલ્યાત્ ત્વં મુક્તા ભવ|</para>
  <para style="p">
    <verse number="13" style="v"/>તતઃ પરં તસ્યા ગાત્રે હસ્તાર્પણમાત્રાત્ સા ઋજુર્ભૂત્વેશ્વરસ્ય ધન્યવાદં કર્ત્તુમારેભે|</para>
  <para style="p">
    <verse number="14" style="v"/>કિન્તુ વિશ્રામવારે યીશુના તસ્યાઃ સ્વાસ્થ્યકરણાદ્ ભજનગેહસ્યાધિપતિઃ પ્રકુપ્ય લોકાન્ ઉવાચ, ષટ્સુ દિનેષુ લોકૈઃ કર્મ્મ કર્ત્તવ્યં તસ્માદ્ધેતોઃ સ્વાસ્થ્યાર્થં તેષુ દિનેષુ આગચ્છત, વિશ્રામવારે માગચ્છત|</para>
  <para style="p">
    <verse number="15" style="v"/>તદા પભુઃ પ્રત્યુવાચ રે કપટિનો યુષ્માકમ્ એકૈકો જનો વિશ્રામવારે સ્વીયં સ્વીયં વૃષભં ગર્દભં વા બન્ધનાન્મોચયિત્વા જલં પાયયિતું કિં ન નયતિ?</para>
  <para style="p">
    <verse number="16" style="v"/>તર્હ્યાષ્ટાદશવત્સરાન્ યાવત્ શૈતાના બદ્ધા ઇબ્રાહીમઃ સન્તતિરિયં નારી કિં વિશ્રામવારે ન મોચયિતવ્યા?</para>
  <para style="p">
    <verse number="17" style="v"/>એષુ વાક્યેષુ કથિતેષુ તસ્ય વિપક્ષાઃ સલજ્જા જાતાઃ કિન્તુ તેન કૃતસર્વ્વમહાકર્મ્મકારણાત્ લોકનિવહઃ સાનન્દોઽભવત્|</para>
  <para style="p">
    <verse number="18" style="v"/>અનન્તરં સોવદદ્ ઈશ્વરસ્ય રાજ્યં કસ્ય સદૃશં? કેન તદુપમાસ્યામિ?</para>
  <para style="p">
    <verse number="19" style="v"/>યત્ સર્ષપબીજં ગૃહીત્વા કશ્ચિજ્જન ઉદ્યાન ઉપ્તવાન્ તદ્ બીજમઙ્કુરિતં સત્ મહાવૃક્ષોઽજાયત, તતસ્તસ્ય શાખાસુ વિહાયસીયવિહગા આગત્ય ન્યૂષુઃ, તદ્રાજ્યં તાદૃશેન સર્ષપબીજેન તુલ્યં|</para>
  <para style="p">
    <verse number="20" style="v"/>પુનઃ કથયામાસ, ઈશ્વરસ્ય રાજ્યં કસ્ય સદૃશં વદિષ્યામિ? યત્ કિણ્વં કાચિત્ સ્ત્રી ગૃહીત્વા દ્રોણત્રયપરિમિતગોધૂમચૂર્ણેષુ સ્થાપયામાસ,</para>
  <para style="p">
    <verse number="21" style="v"/>તતઃ ક્રમેણ તત્ સર્વ્વગોધૂમચૂર્ણં વ્યાપ્નોતિ, તસ્ય કિણ્વસ્ય તુલ્યમ્ ઈશ્વરસ્ય રાજ્યં|</para>
  <para style="p">
    <verse number="22" style="v"/>તતઃ સ યિરૂશાલમ્નગરં પ્રતિ યાત્રાં કૃત્વા નગરે નગરે ગ્રામે ગ્રામે સમુપદિશન્ જગામ|</para>
  <para style="p">
    <verse number="23" style="v"/>તદા કશ્ચિજ્જનસ્તં પપ્રચ્છ, હે પ્રભો કિં કેવલમ્ અલ્પે લોકાઃ પરિત્રાસ્યન્તે?</para>
  <para style="p">
    <verse number="24" style="v"/>તતઃ સ લોકાન્ ઉવાચ, સંકીર્ણદ્વારેણ પ્રવેષ્ટું યતઘ્વં, યતોહં યુષ્માન્ વદામિ, બહવઃ પ્રવેષ્ટું ચેષ્ટિષ્યન્તે કિન્તુ ન શક્ષ્યન્તિ|</para>
  <para style="p">
    <verse number="25" style="v"/>ગૃહપતિનોત્થાય દ્વારે રુદ્ધે સતિ યદિ યૂયં બહિઃ સ્થિત્વા દ્વારમાહત્ય વદથ, હે પ્રભો હે પ્રભો અસ્મત્કારણાદ્ દ્વારં મોચયતુ, તતઃ સ ઇતિ પ્રતિવક્ષ્યતિ, યૂયં કુત્રત્યા લોકા ઇત્યહં ન જાનામિ|</para>
  <para style="p">
    <verse number="26" style="v"/>તદા યૂયં વદિષ્યથ, તવ સાક્ષાદ્ વયં ભેाજનં પાનઞ્ચ કૃતવન્તઃ, ત્વઞ્ચાસ્માકં નગરસ્ય પથિ સમુપદિષ્ટવાન્|</para>
  <para style="p">
    <verse number="27" style="v"/>કિન્તુ સ વક્ષ્યતિ, યુષ્માનહં વદામિ, યૂયં કુત્રત્યા લોકા ઇત્યહં ન જાનામિ; હે દુરાચારિણો યૂયં મત્તો દૂરીભવત|</para>
  <para style="p">
    <verse number="28" style="v"/>તદા ઇબ્રાહીમં ઇસ્હાકં યાકૂબઞ્ચ સર્વ્વભવિષ્યદ્વાદિનશ્ચ ઈશ્વરસ્ય રાજ્યં પ્રાપ્તાન્ સ્વાંશ્ચ બહિષ્કૃતાન્ દૃષ્ટ્વા યૂયં રોદનં દન્તૈર્દન્તઘર્ષણઞ્ચ કરિષ્યથ|</para>
  <para style="p">
    <verse number="29" style="v"/>અપરઞ્ચ પૂર્વ્વપશ્ચિમદક્ષિણોત્તરદિગ્ભ્યો લોકા આગત્ય ઈશ્વરસ્ય રાજ્યે નિવત્સ્યન્તિ|</para>
  <para style="p">
    <verse number="30" style="v"/>પશ્યતેત્થં શેષીયા લોકા અગ્રા ભવિષ્યન્તિ, અગ્રીયા લોકાશ્ચ શેષા ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="31" style="v"/>અપરઞ્ચ તસ્મિન્ દિને કિયન્તઃ ફિરૂશિન આગત્ય યીશું પ્રોચુઃ, બહિર્ગચ્છ, સ્થાનાદસ્માત્ પ્રસ્થાનં કુરુ, હેરોદ્ ત્વાં જિઘાંસતિ|</para>
  <para style="p">
    <verse number="32" style="v"/>તતઃ સ પ્રત્યવોચત્ પશ્યતાદ્ય શ્વશ્ચ ભૂતાન્ વિહાપ્ય રોગિણોઽરોગિણઃ કૃત્વા તૃતીયેહ્નિ સેત્સ્યામિ, કથામેતાં યૂયમિત્વા તં ભૂરિમાયં વદત|</para>
  <para style="p">
    <verse number="33" style="v"/>તત્રાપ્યદ્ય શ્વઃ પરશ્વશ્ચ મયા ગમનાગમને કર્ત્તવ્યે, યતો હેતો ર્યિરૂશાલમો બહિઃ કુત્રાપિ કોપિ ભવિષ્યદ્વાદી ન ઘાનિષ્યતે|</para>
  <para style="p">
    <verse number="34" style="v"/>હે યિરૂશાલમ્ હે યિરૂશાલમ્ ત્વં ભવિષ્યદ્વાદિનો હંસિ તવાન્તિકે પ્રેરિતાન્ પ્રસ્તરૈર્મારયસિ ચ, યથા કુક્કુટી નિજપક્ષાધઃ સ્વશાવકાન્ સંગૃહ્લાતિ, તથાહમપિ તવ શિશૂન્ સંગ્રહીતું કતિવારાન્ ઐચ્છં કિન્તુ ત્વં નૈચ્છઃ|</para>
  <para style="p">
    <verse number="35" style="v"/>પશ્યત યુષ્માકં વાસસ્થાનાનિ પ્રોચ્છિદ્યમાનાનિ પરિત્યક્તાનિ ચ ભવિષ્યન્તિ; યુષ્માનહં યથાર્થં વદામિ, યઃ પ્રભો ર્નામ્નાગચ્છતિ સ ધન્ય ઇતિ વાચં યાવત્કાલં ન વદિષ્યથ, તાવત્કાલં યૂયં માં ન દ્રક્ષ્યથ|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અનન્તરં વિશ્રામવારે યીશૌ પ્રધાનસ્ય ફિરૂશિનો ગૃહે ભોક્તું ગતવતિ તે તં વીક્ષિતુમ્ આરેભિરે|</para>
  <para style="p">
    <verse number="2" style="v"/>તદા જલોદરી તસ્ય સમ્મુખે સ્થિતઃ|</para>
  <para style="p">
    <verse number="3" style="v"/>તતઃ સ વ્યવસ્થાપકાન્ ફિરૂશિનશ્ચ પપ્રચ્છ, વિશ્રામવારે સ્વાસ્થ્યં કર્ત્તવ્યં ન વા? તતસ્તે કિમપિ ન પ્રત્યૂચુઃ|</para>
  <para style="p">
    <verse number="4" style="v"/>તદા સ તં રોગિણં સ્વસ્થં કૃત્વા વિસસર્જ;</para>
  <para style="p">
    <verse number="5" style="v"/>તાનુવાચ ચ યુષ્માકં કસ્યચિદ્ ગર્દ્દભો વૃષભો વા ચેદ્ ગર્ત્તે પતતિ તર્હિ વિશ્રામવારે તત્ક્ષણં સ કિં તં નોત્થાપયિષ્યતિ?</para>
  <para style="p">
    <verse number="6" style="v"/>તતસ્તે કથાયા એતસ્યાઃ કિમપિ પ્રતિવક્તું ન શેકુઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>અપરઞ્ચ પ્રધાનસ્થાનમનોનીતત્વકરણં વિલોક્ય સ નિમન્ત્રિતાન્ એતદુપદેશકથાં જગાદ,</para>
  <para style="p">
    <verse number="8" style="v"/>ત્વં વિવાહાદિભોજ્યેષુ નિમન્ત્રિતઃ સન્ પ્રધાનસ્થાને મોપાવેક્ષીઃ| ત્વત્તો ગૌરવાન્વિતનિમન્ત્રિતજન આયાતે</para>
  <para style="p">
    <verse number="9" style="v"/>નિમન્ત્રયિતાગત્ય મનુષ્યાયૈતસ્મૈ સ્થાનં દેહીતિ વાક્યં ચેદ્ વક્ષ્યતિ તર્હિ ત્વં સઙ્કુચિતો ભૂત્વા સ્થાન ઇતરસ્મિન્ ઉપવેષ્ટુમ્ ઉદ્યંસ્યસિ|</para>
  <para style="p">
    <verse number="10" style="v"/>અસ્માત્ કારણાદેવ ત્વં નિમન્ત્રિતો ગત્વાઽપ્રધાનસ્થાન ઉપવિશ, તતો નિમન્ત્રયિતાગત્ય વદિષ્યતિ, હે બન્ધો પ્રોચ્ચસ્થાનં ગત્વોપવિશ, તથા સતિ ભોજનોપવિષ્ટાનાં સકલાનાં સાક્ષાત્ ત્વં માન્યો ભવિષ્યસિ|</para>
  <para style="p">
    <verse number="11" style="v"/>યઃ કશ્ચિત્ સ્વમુન્નમયતિ સ નમયિષ્યતે, કિન્તુ યઃ કશ્ચિત્ સ્વં નમયતિ સ ઉન્નમયિષ્યતે|</para>
  <para style="p">
    <verse number="12" style="v"/>તદા સ નિમન્ત્રયિતારં જનમપિ જગાદ, મધ્યાહ્ને રાત્રૌ વા ભોજ્યે કૃતે નિજબન્ધુગણો વા ભ્રાતૃृગણો વા જ્ઞાતિગણો વા ધનિગણો વા સમીપવાસિગણો વા એતાન્ ન નિમન્ત્રય, તથા કૃતે ચેત્ તે ત્વાં નિમન્ત્રયિષ્યન્તિ, તર્હિ પરિશોધો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="13" style="v"/>કિન્તુ યદા ભેજ્યં કરોષિ તદા દરિદ્રશુષ્કકરખઞ્જાન્ધાન્ નિમન્ત્રય,</para>
  <para style="p">
    <verse number="14" style="v"/>તત આશિષં લપ્સ્યસે, તેષુ પરિશોધં કર્ત્તુમશક્નુવત્સુ શ્મશાનાદ્ધાર્મ્મિકાનામુત્થાનકાલે ત્વં ફલાં લપ્સ્યસે|</para>
  <para style="p">
    <verse number="15" style="v"/>અનન્તરં તાં કથાં નિશમ્ય ભોજનોપવિષ્ટઃ કશ્ચિત્ કથયામાસ, યો જન ઈશ્વરસ્ય રાજ્યે ભોક્તું લપ્સ્યતે સએવ ધન્યઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>તતઃ સ ઉવાચ, કશ્ચિત્ જનો રાત્રૌ ભેाજ્યં કૃત્વા બહૂન્ નિમન્ત્રયામાસ|</para>
  <para style="p">
    <verse number="17" style="v"/>તતો ભોજનસમયે નિમન્ત્રિતલોકાન્ આહ્વાતું દાસદ્વારા કથયામાસ, ખદ્યદ્રવ્યાણિ સર્વ્વાણિ સમાસાદિતાનિ સન્તિ, યૂયમાગચ્છત|</para>
  <para style="p">
    <verse number="18" style="v"/>કિન્તુ તે સર્વ્વ એકૈકં છલં કૃત્વા ક્ષમાં પ્રાર્થયાઞ્ચક્રિરે| પ્રથમો જનઃ કથયામાસ, ક્ષેત્રમેકં ક્રીતવાનહં તદેવ દ્રષ્ટું મયા ગન્તવ્યમ્, અતએવ માં ક્ષન્તું તં નિવેદય|</para>
  <para style="p">
    <verse number="19" style="v"/>અન્યો જનઃ કથયામાસ, દશવૃષાનહં ક્રીતવાન્ તાન્ પરીક્ષિતું યામિ તસ્માદેવ માં ક્ષન્તું તં નિવેદય|</para>
  <para style="p">
    <verse number="20" style="v"/>અપરઃ કથયામાસ, વ્યૂઢવાનહં તસ્માત્ કારણાદ્ યાતું ન શક્નોમિ|</para>
  <para style="p">
    <verse number="21" style="v"/>પશ્ચાત્ સ દાસો ગત્વા નિજપ્રભોઃ સાક્ષાત્ સર્વ્વવૃત્તાન્તં નિવેદયામાસ, તતોસૌ ગૃહપતિઃ કુપિત્વા સ્વદાસં વ્યાજહાર, ત્વં સત્વરં નગરસ્ય સન્નિવેશાન્ માર્ગાંશ્ચ ગત્વા દરિદ્રશુષ્કકરખઞ્જાન્ધાન્ અત્રાનય|</para>
  <para style="p">
    <verse number="22" style="v"/>તતો દાસોઽવદત્, હે પ્રભો ભવત આજ્ઞાનુસારેણાક્રિયત તથાપિ સ્થાનમસ્તિ|</para>
  <para style="p">
    <verse number="23" style="v"/>તદા પ્રભુઃ પુન ર્દાસાયાકથયત્, રાજપથાન્ વૃક્ષમૂલાનિ ચ યાત્વા મદીયગૃહપૂરણાર્થં લોકાનાગન્તું પ્રવર્ત્તય|</para>
  <para style="p">
    <verse number="24" style="v"/>અહં યુષ્મભ્યં કથયામિ, પૂર્વ્વનિમન્ત્રિતાનમેકોપિ મમાસ્ય રાત્રિભોજ્યસ્યાસ્વાદં ન પ્રાપ્સ્યતિ|</para>
  <para style="p">
    <verse number="25" style="v"/>અનન્તરં બહુષુ લોકેષુ યીશોઃ પશ્ચાદ્ વ્રજિતેષુ સત્સુ સ વ્યાઘુટ્ય તેભ્યઃ કથયામાસ,</para>
  <para style="p">
    <verse number="26" style="v"/>યઃ કશ્ચિન્ મમ સમીપમ્ આગત્ય સ્વસ્ય માતા પિતા પત્ની સન્તાના ભ્રાતરો ભગિમ્યો નિજપ્રાણાશ્ચ, એતેભ્યઃ સર્વ્વેભ્યો મય્યધિકં પ્રેમ ન કરોતિ, સ મમ શિષ્યો ભવિતું ન શક્ષ્યતિ|</para>
  <para style="p">
    <verse number="27" style="v"/>યઃ કશ્ચિત્ સ્વીયં ક્રુશં વહન્ મમ પશ્ચાન્ન ગચ્છતિ, સોપિ મમ શિષ્યો ભવિતું ન શક્ષ્યતિ|</para>
  <para style="p">
    <verse number="28" style="v"/>દુર્ગનિર્મ્માણે કતિવ્યયો ભવિષ્યતિ, તથા તસ્ય સમાપ્તિકરણાર્થં સમ્પત્તિરસ્તિ ન વા, પ્રથમમુપવિશ્ય એતન્ન ગણયતિ, યુષ્માકં મધ્ય એતાદૃશઃ કોસ્તિ?</para>
  <para style="p">
    <verse number="29" style="v"/>નોચેદ્ ભિત્તિં કૃત્વા શેષે યદિ સમાપયિતું ન શક્ષ્યતિ,</para>
  <para style="p">
    <verse number="30" style="v"/>તર્હિ માનુષોયં નિચેતુમ્ આરભત સમાપયિતું નાશક્નોત્, ઇતિ વ્યાહૃત્ય સર્વ્વે તમુપહસિષ્યન્તિ|</para>
  <para style="p">
    <verse number="31" style="v"/>અપરઞ્ચ ભિન્નભૂપતિના સહ યુદ્ધં કર્ત્તુમ્ ઉદ્યમ્ય દશસહસ્રાણિ સૈન્યાનિ ગૃહીત્વા વિંશતિસહસ્રેઃ સૈન્યૈઃ સહિતસ્ય સમીપવાસિનઃ સમ્મુખં યાતું શક્ષ્યામિ ન વેતિ પ્રથમં ઉપવિશ્ય ન વિચારયતિ એતાદૃશો ભૂમિપતિઃ કઃ?</para>
  <para style="p">
    <verse number="32" style="v"/>યદિ ન શક્નોતિ તર્હિ રિપાવતિદૂરે તિષ્ઠતિ સતિ નિજદૂતં પ્રેષ્ય સન્ધિં કર્ત્તું પ્રાર્થયેત|</para>
  <para style="p">
    <verse number="33" style="v"/>તદ્વદ્ યુષ્માકં મધ્યે યઃ કશ્ચિન્ મદર્થં સર્વ્વસ્વં હાતું ન શક્નોતિ સ મમ શિષ્યો ભવિતું ન શક્ષ્યતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>લવણમ્ ઉત્તમમ્ ઇતિ સત્યં, કિન્તુ યદિ લવણસ્ય લવણત્વમ્ અપગચ્છતિ તર્હિ તત્ કથં સ્વાદુયુક્તં ભવિષ્યતિ?</para>
  <para style="p">
    <verse number="35" style="v"/>તદ ભૂમ્યર્થમ્ આલવાલરાશ્યર્થમપિ ભદ્રં ન ભવતિ; લોકાસ્તદ્ બહિઃ ક્ષિપન્તિ| યસ્ય શ્રોતું શ્રોત્રે સ્તઃ સ શૃણોતુ|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તદા કરસઞ્ચાયિનઃ પાપિનશ્ચ લોકા ઉપદેશ્કથાં શ્રોતું યીશોઃ સમીપમ્ આગચ્છન્|</para>
  <para style="p">
    <verse number="2" style="v"/>તતઃ ફિરૂશિન ઉપાધ્યાયાશ્ચ વિવદમાનાઃ કથયામાસુઃ એષ માનુષઃ પાપિભિઃ સહ પ્રણયં કૃત્વા તૈઃ સાર્દ્ધં ભુંક્તે|</para>
  <para style="p">
    <verse number="3" style="v"/>તદા સ તેભ્ય ઇમાં દૃષ્ટાન્તકથાં કથિતવાન્,</para>
  <para style="p">
    <verse number="4" style="v"/>કસ્યચિત્ શતમેષેષુ તિષ્ઠત્મુ તેષામેકં સ યદિ હારયતિ તર્હિ મધ્યેપ્રાન્તરમ્ એકોનશતમેષાન્ વિહાય હારિતમેષસ્ય ઉદ્દેશપ્રાપ્તિપર્ય્યનતં ન ગવેષયતિ, એતાદૃશો લોકો યુષ્માકં મધ્યે ક આસ્તે?</para>
  <para style="p">
    <verse number="5" style="v"/>તસ્યોદ્દેશં પ્રાપ્ય હૃષ્ટમનાસ્તં સ્કન્ધે નિધાય સ્વસ્થાનમ્ આનીય બન્ધુબાન્ધવસમીપવાસિન આહૂય વક્તિ,</para>
  <para style="p">
    <verse number="6" style="v"/>હારિતં મેષં પ્રાપ્તોહમ્ અતો હેતો ર્મયા સાર્દ્ધમ્ આનન્દત|</para>
  <para style="p">
    <verse number="7" style="v"/>તદ્વદહં યુષ્માન્ વદામિ, યેષાં મનઃપરાવર્ત્તનસ્ય પ્રયોજનં નાસ્તિ, તાદૃશૈકોનશતધાર્મ્મિકકારણાદ્ ય આનન્દસ્તસ્માદ્ એકસ્ય મનઃપરિવર્ત્તિનઃ પાપિનઃ કારણાત્ સ્વર્ગે ઽધિકાનન્દો જાયતે|</para>
  <para style="p">
    <verse number="8" style="v"/>અપરઞ્ચ દશાનાં રૂપ્યખણ્ડાનામ્ એકખણ્ડે હારિતે પ્રદીપં પ્રજ્વાલ્ય ગૃહં સમ્માર્જ્ય તસ્ય પ્રાપ્તિં યાવદ્ યત્નેન ન ગવેષયતિ, એતાદૃશી યોષિત્ કાસ્તે?</para>
  <para style="p">
    <verse number="9" style="v"/>પ્રાપ્તે સતિ બન્ધુબાન્ધવસમીપવાસિનીરાહૂય કથયતિ, હારિતં રૂપ્યખણ્ડં પ્રાપ્તાહં તસ્માદેવ મયા સાર્દ્ધમ્ આનન્દત|</para>
  <para style="p">
    <verse number="10" style="v"/>તદ્વદહં યુષ્માન્ વ્યાહરામિ, એકેન પાપિના મનસિ પરિવર્ત્તિતે, ઈશ્વરસ્ય દૂતાનાં મધ્યેપ્યાનન્દો જાયતે|</para>
  <para style="p">
    <verse number="11" style="v"/>અપરઞ્ચ સ કથયામાસ, કસ્યચિદ્ દ્વૌ પુત્રાવાસ્તાં,</para>
  <para style="p">
    <verse number="12" style="v"/>તયોઃ કનિષ્ઠઃ પુત્રઃ પિત્રે કથયામાસ, હે પિતસ્તવ સમ્પત્ત્યા યમંશં પ્રાપ્સ્યામ્યહં વિભજ્ય તં દેહિ, તતઃ પિતા નિજાં સમ્પત્તિં વિભજ્ય તાભ્યાં દદૌ|</para>
  <para style="p">
    <verse number="13" style="v"/>કતિપયાત્ કાલાત્ પરં સ કનિષ્ઠપુત્રઃ સમસ્તં ધનં સંગૃહ્ય દૂરદેશં ગત્વા દુષ્ટાચરણેન સર્વ્વાં સમ્પત્તિં નાશયામાસ|</para>
  <para style="p">
    <verse number="14" style="v"/>તસ્ય સર્વ્વધને વ્યયં ગતે તદ્દેશે મહાદુર્ભિક્ષં બભૂવ, તતસ્તસ્ય દૈન્યદશા ભવિતુમ્ આરેભે|</para>
  <para style="p">
    <verse number="15" style="v"/>તતઃ પરં સ ગત્વા તદ્દેશીયં ગૃહસ્થમેકમ્ આશ્રયત; તતઃ સતં શૂકરવ્રજં ચારયિતું પ્રાન્તરં પ્રેષયામાસ|</para>
  <para style="p">
    <verse number="16" style="v"/>કેનાપિ તસ્મૈ ભક્ષ્યાદાનાત્ સ શૂકરફલવલ્કલેન પિચિણ્ડપૂરણાં વવાઞ્છ|</para>
  <para style="p">
    <verse number="17" style="v"/>શેષે સ મનસિ ચેતનાં પ્રાપ્ય કથયામાસ, હા મમ પિતુઃ સમીપે કતિ કતિ વેતનભુજો દાસા યથેષ્ટં તતોધિકઞ્ચ ભક્ષ્યં પ્રાપ્નુવન્તિ કિન્ત્વહં ક્ષુધા મુમૂર્ષુઃ|</para>
  <para style="p">
    <verse number="18" style="v"/>અહમુત્થાય પિતુઃ સમીપં ગત્વા કથામેતાં વદિષ્યામિ, હે પિતર્ ઈશ્વરસ્ય તવ ચ વિરુદ્ધં પાપમકરવમ્</para>
  <para style="p">
    <verse number="19" style="v"/>તવ પુત્રઇતિ વિખ્યાતો ભવિતું ન યોગ્યોસ્મિ ચ, માં તવ વૈતનિકં દાસં કૃત્વા સ્થાપય|</para>
  <para style="p">
    <verse number="20" style="v"/>પશ્ચાત્ સ ઉત્થાય પિતુઃ સમીપં જગામ; તતસ્તસ્ય પિતાતિદૂરે તં નિરીક્ષ્ય દયાઞ્ચક્રે, ધાવિત્વા તસ્ય કણ્ઠં ગૃહીત્વા તં ચુચુમ્બ ચ|</para>
  <para style="p">
    <verse number="21" style="v"/>તદા પુત્ર ઉવાચ, હે પિતર્ ઈશ્વરસ્ય તવ ચ વિરુદ્ધં પાપમકરવં, તવ પુત્રઇતિ વિખ્યાતો ભવિતું ન યોગ્યોસ્મિ ચ|</para>
  <para style="p">
    <verse number="22" style="v"/>કિન્તુ તસ્ય પિતા નિજદાસાન્ આદિદેશ, સર્વ્વોત્તમવસ્ત્રાણ્યાનીય પરિધાપયતૈનં હસ્તે ચાઙ્ગુરીયકમ્ અર્પયત પાદયોશ્ચોપાનહૌ સમર્પયત;</para>
  <para style="p">
    <verse number="23" style="v"/>પુષ્ટં ગોવત્સમ્ આનીય મારયત ચ તં ભુક્ત્વા વયમ્ આનન્દામ|</para>
  <para style="p">
    <verse number="24" style="v"/>યતો મમ પુત્રોયમ્ અમ્રિયત પુનરજીવીદ્ હારિતશ્ચ લબ્ધોભૂત્ તતસ્ત આનન્દિતુમ્ આરેભિરે|</para>
  <para style="p">
    <verse number="25" style="v"/>તત્કાલે તસ્ય જ્યેષ્ઠઃ પુત્રઃ ક્ષેત્ર આસીત્| અથ સ નિવેશનસ્ય નિકટં આગચ્છન્ નૃત્યાનાં વાદ્યાનાઞ્ચ શબ્દં શ્રુત્વા</para>
  <para style="p">
    <verse number="26" style="v"/>દાસાનામ્ એકમ્ આહૂય પપ્રચ્છ, કિં કારણમસ્ય?</para>
  <para style="p">
    <verse number="27" style="v"/>તતઃ સોવાદીત્, તવ ભ્રાતાગમત્, તવ તાતશ્ચ તં સુશરીરં પ્રાપ્ય પુષ્ટં ગોવત્સં મારિતવાન્|</para>
  <para style="p">
    <verse number="28" style="v"/>તતઃ સ પ્રકુપ્ય નિવેશનાન્તઃ પ્રવેષ્ટું ન સમ્મેને; તતસ્તસ્ય પિતા બહિરાગત્ય તં સાધયામાસ|</para>
  <para style="p">
    <verse number="29" style="v"/>તતઃ સ પિતરં પ્રત્યુવાચ, પશ્ય તવ કાઞ્ચિદપ્યાજ્ઞાં ન વિલંઘ્ય બહૂન્ વત્સરાન્ અહં ત્વાં સેવે તથાપિ મિત્રૈઃ સાર્દ્ધમ્ ઉત્સવં કર્ત્તું કદાપિ છાગમેકમપિ મહ્યં નાદદાઃ;</para>
  <para style="p">
    <verse number="30" style="v"/>કિન્તુ તવ યઃ પુત્રો વેશ્યાગમનાદિભિસ્તવ સમ્પત્તિમ્ અપવ્યયિતવાન્ તસ્મિન્નાગતમાત્રે તસ્યૈવ નિમિત્તં પુષ્ટં ગોવત્સં મારિતવાન્|</para>
  <para style="p">
    <verse number="31" style="v"/>તદા તસ્ય પિતાવોચત્, હે પુત્ર ત્વં સર્વ્વદા મયા સહાસિ તસ્માન્ મમ યદ્યદાસ્તે તત્સર્વ્વં તવ|</para>
  <para style="p">
    <verse number="32" style="v"/>કિન્તુ તવાયં ભ્રાતા મૃતઃ પુનરજીવીદ્ હારિતશ્ચ ભૂત્વા પ્રાપ્તોભૂત્, એતસ્માત્ કારણાદ્ ઉત્સવાનન્દૌ કર્ત્તુમ્ ઉચિતમસ્માકમ્|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરઞ્ચ યીશુઃ શિષ્યેભ્યોન્યામેકાં કથાં કથયામાસ કસ્યચિદ્ ધનવતો મનુષ્યસ્ય ગૃહકાર્ય્યાધીશે સમ્પત્તેરપવ્યયેઽપવાદિતે સતિ</para>
  <para style="p">
    <verse number="2" style="v"/>તસ્ય પ્રભુસ્તમ્ આહૂય જગાદ, ત્વયિ યામિમાં કથાં શૃણોમિ સા કીદૃશી? ત્વં ગૃહકાર્ય્યાધીશકર્મ્મણો ગણનાં દર્શય ગૃહકાર્ય્યાધીશપદે ત્વં ન સ્થાસ્યસિ|</para>
  <para style="p">
    <verse number="3" style="v"/>તદા સ ગૃહકાર્ય્યાધીશો મનસા ચિન્તયામાસ, પ્રભુ ર્યદિ માં ગૃહકાર્ય્યાધીશપદાદ્ ભ્રંશયતિ તર્હિ કિં કરિષ્યેઽહં? મૃદં ખનિતું મમ શક્તિ ર્નાસ્તિ ભિક્ષિતુઞ્ચ લજ્જિષ્યેઽહં|</para>
  <para style="p">
    <verse number="4" style="v"/>અતએવ મયિ ગૃહકાર્ય્યાધીશપદાત્ ચ્યુતે સતિ યથા લોકા મહ્યમ્ આશ્રયં દાસ્યન્તિ તદર્થં યત્કર્મ્મ મયા કરણીયં તન્ નિર્ણીયતે|</para>
  <para style="p">
    <verse number="5" style="v"/>પશ્ચાત્ સ સ્વપ્રભોરેકૈકમ્ અધમર્ણમ્ આહૂય પ્રથમં પપ્રચ્છ, ત્વત્તો મે પ્રભુણા કતિ પ્રાપ્યમ્?</para>
  <para style="p">
    <verse number="6" style="v"/>તતઃ સ ઉવાચ, એકશતાઢકતૈલાનિ; તદા ગૃહકાર્ય્યાધીશઃ પ્રોવાચ, તવ પત્રમાનીય શીઘ્રમુપવિશ્ય તત્ર પઞ્ચાશતં લિખ|</para>
  <para style="p">
    <verse number="7" style="v"/>પશ્ચાદન્યમેકં પપ્રચ્છ, ત્વત્તો મે પ્રભુણા કતિ પ્રાપ્યમ્? તતઃ સોવાદીદ્ એકશતાઢકગોધૂમાઃ; તદા સ કથયામાસ, તવ પત્રમાનીય અશીતિં લિખ|</para>
  <para style="p">
    <verse number="8" style="v"/>તેનૈવ પ્રભુસ્તમયથાર્થકૃતમ્ અધીશં તદ્બુદ્ધિનૈપુણ્યાત્ પ્રશશંસ; ઇત્થં દીપ્તિરૂપસન્તાનેભ્ય એતત્સંસારસ્ય સન્તાના વર્ત્તમાનકાલેઽધિકબુદ્ધિમન્તો ભવન્તિ|</para>
  <para style="p">
    <verse number="9" style="v"/>અતો વદામિ યૂયમપ્યયથાર્થેન ધનેન મિત્રાણિ લભધ્વં તતો યુષ્માસુ પદભ્રષ્ટેષ્વપિ તાનિ ચિરકાલમ્ આશ્રયં દાસ્યન્તિ|</para>
  <para style="p">
    <verse number="10" style="v"/>યઃ કશ્ચિત્ ક્ષુદ્રે કાર્ય્યે વિશ્વાસ્યો ભવતિ સ મહતિ કાર્ય્યેપિ વિશ્વાસ્યો ભવતિ, કિન્તુ યઃ કશ્ચિત્ ક્ષુદ્રે કાર્ય્યેઽવિશ્વાસ્યો ભવતિ સ મહતિ કાર્ય્યેપ્યવિશ્વાસ્યો ભવતિ|</para>
  <para style="p">
    <verse number="11" style="v"/>અતએવ અયથાર્થેન ધનેન યદિ યૂયમવિશ્વાસ્યા જાતાસ્તર્હિ સત્યં ધનં યુષ્માકં કરેષુ કઃ સમર્પયિષ્યતિ?</para>
  <para style="p">
    <verse number="12" style="v"/>યદિ ચ પરધનેન યૂયમ્ અવિશ્વાસ્યા ભવથ તર્હિ યુષ્માકં સ્વકીયધનં યુષ્મભ્યં કો દાસ્યતિ?</para>
  <para style="p">
    <verse number="13" style="v"/>કોપિ દાસ ઉભૌ પ્રભૂ સેવિતું ન શક્નોતિ, યત એકસ્મિન્ પ્રીયમાણોઽન્યસ્મિન્નપ્રીયતે યદ્વા એકં જનં સમાદૃત્ય તદન્યં તુચ્છીકરોતિ તદ્વદ્ યૂયમપિ ધનેશ્વરૌ સેવિતું ન શક્નુથ|</para>
  <para style="p">
    <verse number="14" style="v"/>તદૈતાઃ સર્વ્વાઃ કથાઃ શ્રુત્વા લોભિફિરૂશિનસ્તમુપજહસુઃ|</para>
  <para style="p">
    <verse number="15" style="v"/>તતઃ સ ઉવાચ, યૂયં મનુષ્યાણાં નિકટે સ્વાન્ નિર્દોષાન્ દર્શયથ કિન્તુ યુષ્માકમ્ અન્તઃકરણાનીશ્વરો જાનાતિ, યત્ મનુષ્યાણામ્ અતિ પ્રશંસ્યં તદ્ ઈશ્વરસ્ય ઘૃણ્યં|</para>
  <para style="p">
    <verse number="16" style="v"/>યોહન આગમનપર્ય્યનતં યુષ્માકં સમીપે વ્યવસ્થાભવિષ્યદ્વાદિનાં લેખનાનિ ચાસન્ તતઃ પ્રભૃતિ ઈશ્વરરાજ્યસ્ય સુસંવાદઃ પ્રચરતિ, એકૈકો લોકસ્તન્મધ્યં યત્નેન પ્રવિશતિ ચ|</para>
  <para style="p">
    <verse number="17" style="v"/>વરં નભસઃ પૃથિવ્યાશ્ચ લોપો ભવિષ્યતિ તથાપિ વ્યવસ્થાયા એકબિન્દોરપિ લોપો ન ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="18" style="v"/>યઃ કશ્ચિત્ સ્વીયાં ભાર્ય્યાં વિહાય સ્ત્રિયમન્યાં વિવહતિ સ પરદારાન્ ગચ્છતિ, યશ્ચ તા ત્યક્તાં નારીં વિવહતિ સોપિ પરદારાન ગચ્છતિ|</para>
  <para style="p">
    <verse number="19" style="v"/>એકો ધની મનુષ્યઃ શુક્લાનિ સૂક્ષ્માણિ વસ્ત્રાણિ પર્ય્યદધાત્ પ્રતિદિનં પરિતોષરૂપેણાભુંક્તાપિવચ્ચ|</para>
  <para style="p">
    <verse number="20" style="v"/>સર્વ્વાઙ્ગે ક્ષતયુક્ત ઇલિયાસરનામા કશ્ચિદ્ દરિદ્રસ્તસ્ય ધનવતો ભોજનપાત્રાત્ પતિતમ્ ઉચ્છિષ્ટં ભોક્તું વાઞ્છન્ તસ્ય દ્વારે પતિત્વાતિષ્ઠત્;</para>
  <para style="p">
    <verse number="21" style="v"/>અથ શ્વાન આગત્ય તસ્ય ક્ષતાન્યલિહન્|</para>
  <para style="p">
    <verse number="22" style="v"/>કિયત્કાલાત્પરં સ દરિદ્રઃ પ્રાણાન્ જહૌ; તતઃ સ્વર્ગીયદૂતાસ્તં નીત્વા ઇબ્રાહીમઃ ક્રોડ ઉપવેશયામાસુઃ|</para>
  <para style="p">
    <verse number="23" style="v"/>પશ્ચાત્ સ ધનવાનપિ મમાર, તં શ્મશાને સ્થાપયામાસુશ્ચ; કિન્તુ પરલોકે સ વેદનાકુલઃ સન્ ઊર્દ્ધ્વાં નિરીક્ષ્ય બહુદૂરાદ્ ઇબ્રાહીમં તત્ક્રોડ ઇલિયાસરઞ્ચ વિલોક્ય રુવન્નુવાચ;</para>
  <para style="p">
    <verse number="24" style="v"/>હે પિતર્ ઇબ્રાહીમ્ અનુગૃહ્ય અઙ્ગુલ્યગ્રભાગં જલે મજ્જયિત્વા મમ જિહ્વાં શીતલાં કર્ત્તુમ્ ઇલિયાસરં પ્રેરય, યતો વહ્નિશિખાતોહં વ્યથિતોસ્મિ|</para>
  <para style="p">
    <verse number="25" style="v"/>તદા ઇબ્રાહીમ્ બભાષે, હે પુત્ર ત્વં જીવન્ સમ્પદં પ્રાપ્તવાન્ ઇલિયાસરસ્તુ વિપદં પ્રાપ્તવાન્ એતત્ સ્મર, કિન્તુ સમ્પ્રતિ તસ્ય સુખં તવ ચ દુઃખં ભવતિ|</para>
  <para style="p">
    <verse number="26" style="v"/>અપરમપિ યુષ્માકમ્ અસ્માકઞ્ચ સ્થાનયો ર્મધ્યે મહદ્વિચ્છેદોઽસ્તિ તત એતત્સ્થાનસ્ય લોકાસ્તત્ સ્થાનં યાતું યદ્વા તત્સ્થાનસ્ય લોકા એતત્ સ્થાનમાયાતું ન શક્નુવન્તિ|</para>
  <para style="p">
    <verse number="27" style="v"/>તદા સ ઉક્તવાન્, હે પિતસ્તર્હિ ત્વાં નિવેદયામિ મમ પિતુ ર્ગેહે યે મમ પઞ્ચ ભ્રાતરઃ સન્તિ</para>
  <para style="p">
    <verse number="28" style="v"/>તે યથૈતદ્ યાતનાસ્થાનં નાયાસ્યન્તિ તથા મન્ત્રણાં દાતું તેષાં સમીપમ્ ઇલિયાસરં પ્રેરય|</para>
  <para style="p">
    <verse number="29" style="v"/>તત ઇબ્રાહીમ્ ઉવાચ, મૂસાભવિષ્યદ્વાદિનાઞ્ચ પુસ્તકાનિ તેષાં નિકટે સન્તિ તે તદ્વચનાનિ મન્યન્તાં|</para>
  <para style="p">
    <verse number="30" style="v"/>તદા સ નિવેદયામાસ, હે પિતર્ ઇબ્રાહીમ્ ન તથા, કિન્તુ યદિ મૃતલોકાનાં કશ્ચિત્ તેષાં સમીપં યાતિ તર્હિ તે મનાંસિ વ્યાઘોટયિષ્યન્તિ|</para>
  <para style="p">
    <verse number="31" style="v"/>તત ઇબ્રાહીમ્ જગાદ, તે યદિ મૂસાભવિષ્યદ્વાદિનાઞ્ચ વચનાનિ ન મન્યન્તે તર્હિ મૃતલોકાનાં કસ્મિંશ્ચિદ્ ઉત્થિતેપિ તે તસ્ય મન્ત્રણાં ન મંસ્યન્તે|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ઇતઃ પરં યીશુઃ શિષ્યાન્ ઉવાચ, વિઘ્નૈરવશ્યમ્ આગન્તવ્યં કિન્તુ વિઘ્ના યેન ઘટિષ્યન્તે તસ્ય દુર્ગતિ ર્ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="2" style="v"/>એતેષાં ક્ષુદ્રપ્રાણિનામ્ એકસ્યાપિ વિઘ્નજનનાત્ કણ્ઠબદ્ધપેષણીકસ્ય તસ્ય સાગરાગાધજલે મજ્જનં ભદ્રં|</para>
  <para style="p">
    <verse number="3" style="v"/>યૂયં સ્વેષુ સાવધાનાસ્તિષ્ઠત; તવ ભ્રાતા યદિ તવ કિઞ્ચિદ્ અપરાધ્યતિ તર્હિ તં તર્જય, તેન યદિ મનઃ પરિવર્ત્તયતિ તર્હિ તં ક્ષમસ્વ|</para>
  <para style="p">
    <verse number="4" style="v"/>પુનરેકદિનમધ્યે યદિ સ તવ સપ્તકૃત્વોઽપરાધ્યતિ કિન્તુ સપ્તકૃત્વ આગત્ય મનઃ પરિવર્ત્ય મયાપરાદ્ધમ્ ઇતિ વદતિ તર્હિ તં ક્ષમસ્વ|</para>
  <para style="p">
    <verse number="5" style="v"/>તદા પ્રેરિતાઃ પ્રભુમ્ અવદન્ અસ્માકં વિશ્વાસં વર્દ્ધય|</para>
  <para style="p">
    <verse number="6" style="v"/>પ્રભુરુવાચ, યદિ યુષ્માકં સર્ષપૈકપ્રમાણો વિશ્વાસોસ્તિ તર્હિ ત્વં સમૂલમુત્પાટિતો ભૂત્વા સમુદ્રે રોપિતો ભવ કથાયામ્ એતસ્યામ્ એતદુડુમ્બરાય કથિતાયાં સ યુષ્માકમાજ્ઞાવહો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="7" style="v"/>અપરં સ્વદાસે હલં વાહયિત્વા વા પશૂન્ ચારયિત્વા ક્ષેત્રાદ્ આગતે સતિ તં વદતિ, એહિ ભોક્તુમુપવિશ, યુષ્માકમ્ એતાદૃશઃ કોસ્તિ?</para>
  <para style="p">
    <verse number="8" style="v"/>વરઞ્ચ પૂર્વ્વં મમ ખાદ્યમાસાદ્ય યાવદ્ ભુઞ્જે પિવામિ ચ તાવદ્ બદ્ધકટિઃ પરિચર પશ્ચાત્ ત્વમપિ ભોક્ષ્યસે પાસ્યસિ ચ કથામીદૃશીં કિં ન વક્ષ્યતિ?</para>
  <para style="p">
    <verse number="9" style="v"/>તેન દાસેન પ્રભોરાજ્ઞાનુરૂપે કર્મ્મણિ કૃતે પ્રભુઃ કિં તસ્મિન્ બાધિતો જાતઃ? નેત્થં બુધ્યતે મયા|</para>
  <para style="p">
    <verse number="10" style="v"/>ઇત્થં નિરૂપિતેષુ સર્વ્વકર્મ્મસુ કૃતેષુ સત્મુ યૂયમપીદં વાક્યં વદથ, વયમ્ અનુપકારિણો દાસા અસ્માભિર્યદ્યત્કર્ત્તવ્યં તન્માત્રમેવ કૃતં|</para>
  <para style="p">
    <verse number="11" style="v"/>સ યિરૂશાલમિ યાત્રાં કુર્વ્વન્ શોમિરોણ્ગાલીલ્પ્રદેશમધ્યેન ગચ્છતિ,</para>
  <para style="p">
    <verse number="12" style="v"/>એતર્હિ કુત્રચિદ્ ગ્રામે પ્રવેશમાત્રે દશકુષ્ઠિનસ્તં સાક્ષાત્ કૃત્વા</para>
  <para style="p">
    <verse number="13" style="v"/>દૂરે તિષ્ઠનત ઉચ્ચૈ ર્વક્તુમારેભિરે, હે પ્રભો યીશો દયસ્વાસ્માન્|</para>
  <para style="p">
    <verse number="14" style="v"/>તતઃ સ તાન્ દૃષ્ટ્વા જગાદ, યૂયં યાજકાનાં સમીપે સ્વાન્ દર્શયત, તતસ્તે ગચ્છન્તો રોગાત્ પરિષ્કૃતાઃ|</para>
  <para style="p">
    <verse number="15" style="v"/>તદા તેષામેકઃ સ્વં સ્વસ્થં દૃષ્ટ્વા પ્રોચ્ચૈરીશ્વરં ધન્યં વદન્ વ્યાઘુટ્યાયાતો યીશો ર્ગુણાનનુવદન્ તચ્ચરણાધોભૂમૌ પપાત;</para>
  <para style="p">
    <verse number="16" style="v"/>સ ચાસીત્ શોમિરોણી|</para>
  <para style="p">
    <verse number="17" style="v"/>તદા યીશુરવદત્, દશજનાઃ કિં ન પરિષ્કૃતાઃ? તહ્યન્યે નવજનાઃ કુત્ર?</para>
  <para style="p">
    <verse number="18" style="v"/>ઈશ્વરં ધન્યં વદન્તમ્ એનં વિદેશિનં વિના કોપ્યન્યો ન પ્રાપ્યત|</para>
  <para style="p">
    <verse number="19" style="v"/>તદા સ તમુવાચ, ત્વમુત્થાય યાહિ વિશ્વાસસ્તે ત્વાં સ્વસ્થં કૃતવાન્|</para>
  <para style="p">
    <verse number="20" style="v"/>અથ કદેશ્વરસ્ય રાજત્વં ભવિષ્યતીતિ ફિરૂશિભિઃ પૃષ્ટે સ પ્રત્યુવાચ, ઈશ્વરસ્ય રાજત્વમ્ ઐશ્વર્ય્યદર્શનેન ન ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="21" style="v"/>અત એતસ્મિન્ પશ્ય તસ્મિન્ વા પશ્ય, ઇતિ વાક્યં લોકા વક્તું ન શક્ષ્યન્તિ, ઈશ્વરસ્ય રાજત્વં યુષ્માકમ્ અન્તરેવાસ્તે|</para>
  <para style="p">
    <verse number="22" style="v"/>તતઃ સ શિષ્યાન્ જગાદ, યદા યુષ્માભિ ર્મનુજસુતસ્ય દિનમેકં દ્રષ્ટુમ્ વાઞ્છિષ્યતે કિન્તુ ન દર્શિષ્યતે, ઈદૃક્કાલ આયાતિ|</para>
  <para style="p">
    <verse number="23" style="v"/>તદાત્ર પશ્ય વા તત્ર પશ્યેતિ વાક્યં લોકા વક્ષ્યન્તિ, કિન્તુ તેષાં પશ્ચાત્ મા યાત, માનુગચ્છત ચ|</para>
  <para style="p">
    <verse number="24" style="v"/>યતસ્તડિદ્ યથાકાશૈકદિશ્યુદિય તદન્યામપિ દિશં વ્યાપ્ય પ્રકાશતે તદ્વત્ નિજદિને મનુજસૂનુઃ પ્રકાશિષ્યતે|</para>
  <para style="p">
    <verse number="25" style="v"/>કિન્તુ તત્પૂર્વ્વં તેનાનેકાનિ દુઃખાનિ ભોક્તવ્યાન્યેતદ્વર્ત્તમાનલોકૈશ્ચ સોઽવજ્ઞાતવ્યઃ|</para>
  <para style="p">
    <verse number="26" style="v"/>નોહસ્ય વિદ્યમાનકાલે યથાભવત્ મનુષ્યસૂનોઃ કાલેપિ તથા ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="27" style="v"/>યાવત્કાલં નોહો મહાપોતં નારોહદ્ આપ્લાવિવાર્ય્યેત્ય સર્વ્વં નાનાશયચ્ચ તાવત્કાલં યથા લોકા અભુઞ્જતાપિવન્ વ્યવહન્ વ્યવાહયંશ્ચ;</para>
  <para style="p">
    <verse number="28" style="v"/>ઇત્થં લોટો વર્ત્તમાનકાલેપિ યથા લોકા ભોજનપાનક્રયવિક્રયરોપણગૃહનિર્મ્માણકર્મ્મસુ પ્રાવર્ત્તન્ત,</para>
  <para style="p">
    <verse number="29" style="v"/>કિન્તુ યદા લોટ્ સિદોમો નિર્જગામ તદા નભસઃ સગન્ધકાગ્નિવૃષ્ટિ ર્ભૂત્વા સર્વ્વં વ્યનાશયત્</para>
  <para style="p">
    <verse number="30" style="v"/>તદ્વન્ માનવપુત્રપ્રકાશદિનેપિ ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="31" style="v"/>તદા યદિ કશ્ચિદ્ ગૃહોપરિ તિષ્ઠતિ તર્હિ સ ગૃહમધ્યાત્ કિમપિ દ્રવ્યમાનેતુમ્ અવરુહ્ય નૈતુ; યશ્ચ ક્ષેત્રે તિષ્ઠતિ સોપિ વ્યાઘુટ્ય નાયાતુ|</para>
  <para style="p">
    <verse number="32" style="v"/>લોટઃ પત્નીં સ્મરત|</para>
  <para style="p">
    <verse number="33" style="v"/>યઃ પ્રાણાન્ રક્ષિતું ચેષ્ટિષ્યતે સ પ્રાણાન્ હારયિષ્યતિ યસ્તુ પ્રાણાન્ હારયિષ્યતિ સએવ પ્રાણાન્ રક્ષિષ્યતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>યુષ્માનહં વચ્મિ તસ્યાં રાત્રૌ શય્યૈકગતયો ર્લોકયોરેકો ધારિષ્યતે પરસ્ત્યક્ષ્યતે|</para>
  <para style="p">
    <verse number="35" style="v"/>સ્ત્રિયૌ યુગપત્ પેષણીં વ્યાવર્ત્તયિષ્યતસ્તયોરેકા ધારિષ્યતે પરાત્યક્ષ્યતે|</para>
  <para style="p">
    <verse number="36" style="v"/>પુરુષૌ ક્ષેત્રે સ્થાસ્યતસ્તયોરેકો ધારિષ્યતે પરસ્ત્યક્ષ્યતે|</para>
  <para style="p">
    <verse number="37" style="v"/>તદા તે પપ્રચ્છુઃ, હે પ્રભો કુત્રેત્થં ભવિષ્યતિ? તતઃ સ ઉવાચ, યત્ર શવસ્તિષ્ઠતિ તત્ર ગૃધ્રા મિલન્તિ|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરઞ્ચ લોકૈરક્લાન્તૈ ર્નિરન્તરં પ્રાર્થયિતવ્યમ્ ઇત્યાશયેન યીશુના દૃષ્ટાન્ત એકઃ કથિતઃ|</para>
  <para style="p">
    <verse number="2" style="v"/>કુત્રચિન્નગરે કશ્ચિત્ પ્રાડ્વિવાક આસીત્ સ ઈશ્વરાન્નાબિભેત્ માનુષાંશ્ચ નામન્યત|</para>
  <para style="p">
    <verse number="3" style="v"/>અથ તત્પુરવાસિની કાચિદ્વિધવા તત્સમીપમેત્ય વિવાદિના સહ મમ વિવાદં પરિષ્કુર્વ્વિતિ નિવેદયામાસ|</para>
  <para style="p">
    <verse number="4" style="v"/>તતઃ સ પ્રાડ્વિવાકઃ કિયદ્દિનાનિ ન તદઙ્ગીકૃતવાન્ પશ્ચાચ્ચિત્તે ચિન્તયામાસ, યદ્યપીશ્વરાન્ન બિભેમિ મનુષ્યાનપિ ન મન્યે</para>
  <para style="p">
    <verse number="5" style="v"/>તથાપ્યેષા વિધવા માં ક્લિશ્નાતિ તસ્માદસ્યા વિવાદં પરિષ્કરિષ્યામિ નોચેત્ સા સદાગત્ય માં વ્યગ્રં કરિષ્યતિ|</para>
  <para style="p">
    <verse number="6" style="v"/>પશ્ચાત્ પ્રભુરવદદ્ અસાવન્યાયપ્રાડ્વિવાકો યદાહ તત્ર મનો નિધધ્વં|</para>
  <para style="p">
    <verse number="7" style="v"/>ઈશ્વરસ્ય યે ઽભિરુચિતલોકા દિવાનિશં પ્રાર્થયન્તે સ બહુદિનાનિ વિલમ્બ્યાપિ તેષાં વિવાદાન્ કિં ન પરિષ્કરિષ્યતિ?</para>
  <para style="p">
    <verse number="8" style="v"/>યુષ્માનહં વદામિ ત્વરયા પરિષ્કરિષ્યતિ, કિન્તુ યદા મનુષ્યપુત્ર આગમિષ્યતિ તદા પૃથિવ્યાં કિમીદૃશં વિશ્વાસં પ્રાપ્સ્યતિ?</para>
  <para style="p">
    <verse number="9" style="v"/>યે સ્વાન્ ધાર્મ્મિકાન્ જ્ઞાત્વા પરાન્ તુચ્છીકુર્વ્વન્તિ એતાદૃગ્ભ્યઃ, કિયદ્ભ્ય ઇમં દૃષ્ટાન્તં કથયામાસ|</para>
  <para style="p">
    <verse number="10" style="v"/>એકઃ ફિરૂશ્યપરઃ કરસઞ્ચાયી દ્વાવિમૌ પ્રાર્થયિતું મન્દિરં ગતૌ|</para>
  <para style="p">
    <verse number="11" style="v"/>તતોઽસૌ ફિરૂશ્યેકપાર્શ્વે તિષ્ઠન્ હે ઈશ્વર અહમન્યલોકવત્ લોઠયિતાન્યાયી પારદારિકશ્ચ ન ભવામિ અસ્ય કરસઞ્ચાયિનસ્તુલ્યશ્ચ ન, તસ્માત્ત્વાં ધન્યં વદામિ|</para>
  <para style="p">
    <verse number="12" style="v"/>સપ્તસુ દિનેષુ દિનદ્વયમુપવસામિ સર્વ્વસમ્પત્તે ર્દશમાંશં દદામિ ચ, એતત્કથાં કથયન્ પ્રાર્થયામાસ|</para>
  <para style="p">
    <verse number="13" style="v"/>કિન્તુ સ કરસઞ્ચાયિ દૂરે તિષ્ઠન્ સ્વર્ગં દ્રષ્ટું નેચ્છન્ વક્ષસિ કરાઘાતં કુર્વ્વન્ હે ઈશ્વર પાપિષ્ઠં માં દયસ્વ, ઇત્થં પ્રાર્થયામાસ|</para>
  <para style="p">
    <verse number="14" style="v"/>યુષ્માનહં વદામિ, તયોર્દ્વયો ર્મધ્યે કેવલઃ કરસઞ્ચાયી પુણ્યવત્ત્વેન ગણિતો નિજગૃહં જગામ, યતો યઃ કશ્ચિત્ સ્વમુન્નમયતિ સ નામયિષ્યતે કિન્તુ યઃ કશ્ચિત્ સ્વં નમયતિ સ ઉન્નમયિષ્યતે|</para>
  <para style="p">
    <verse number="15" style="v"/>અથ શિશૂનાં ગાત્રસ્પર્શાર્થં લોકાસ્તાન્ તસ્ય સમીપમાનિન્યુઃ શિષ્યાસ્તદ્ દૃષ્ટ્વાનેતૃન્ તર્જયામાસુઃ,</para>
  <para style="p">
    <verse number="16" style="v"/>કિન્તુ યીશુસ્તાનાહૂય જગાદ, મન્નિકટમ્ આગન્તું શિશૂન્ અનુજાનીધ્વં તાંશ્ચ મા વારયત; યત ઈશ્વરરાજ્યાધિકારિણ એષાં સદૃશાઃ|</para>
  <para style="p">
    <verse number="17" style="v"/>અહં યુષ્માન્ યથાર્થં વદામિ, યો જનઃ શિશોઃ સદૃશો ભૂત્વા ઈશ્વરરાજ્યં ન ગૃહ્લાતિ સ કેનાપિ પ્રકારેણ તત્ પ્રવેષ્ટું ન શક્નોતિ|</para>
  <para style="p">
    <verse number="18" style="v"/>અપરમ્ એકોધિપતિસ્તં પપ્રચ્છ, હે પરમગુરો, અનન્તાયુષઃ પ્રાપ્તયે મયા કિં કર્ત્તવ્યં?</para>
  <para style="p">
    <verse number="19" style="v"/>યીશુરુવાચ, માં કુતઃ પરમં વદસિ? ઈશ્વરં વિના કોપિ પરમો ન ભવતિ|</para>
  <para style="p">
    <verse number="20" style="v"/>પરદારાન્ મા ગચ્છ, નરં મા જહિ, મા ચોરય, મિથ્યાસાક્ષ્યં મા દેહિ, માતરં પિતરઞ્ચ સંમન્યસ્વ, એતા યા આજ્ઞાઃ સન્તિ તાસ્ત્વં જાનાસિ|</para>
  <para style="p">
    <verse number="21" style="v"/>તદા સ ઉવાચ, બાલ્યકાલાત્ સર્વ્વા એતા આચરામિ|</para>
  <para style="p">
    <verse number="22" style="v"/>ઇતિ કથાં શ્રુત્વા યીશુસ્તમવદત્, તથાપિ તવૈકં કર્મ્મ ન્યૂનમાસ્તે, નિજં સર્વ્વસ્વં વિક્રીય દરિદ્રેભ્યો વિતર, તસ્માત્ સ્વર્ગે ધનં પ્રાપ્સ્યસિ; તત આગત્ય મમાનુગામી ભવ|</para>
  <para style="p">
    <verse number="23" style="v"/>કિન્ત્વેતાં કથાં શ્રુત્વા સોધિપતિઃ શુશોચ, યતસ્તસ્ય બહુધનમાસીત્|</para>
  <para style="p">
    <verse number="24" style="v"/>તદા યીશુસ્તમતિશોકાન્વિતં દૃષ્ટ્વા જગાદ, ધનવતામ્ ઈશ્વરરાજ્યપ્રવેશઃ કીદૃગ્ દુષ્કરઃ|</para>
  <para style="p">
    <verse number="25" style="v"/>ઈશ્વરરાજ્યે ધનિનઃ પ્રવેશાત્ સૂચેશ્છિદ્રેણ મહાઙ્ગસ્ય ગમનાગમને સુકરે|</para>
  <para style="p">
    <verse number="26" style="v"/>શ્રોતારઃ પપ્રચ્છુસ્તર્હિ કેન પરિત્રાણં પ્રાપ્સ્યતે?</para>
  <para style="p">
    <verse number="27" style="v"/>સ ઉક્તવાન્, યન્ માનુષેણાશક્યં તદ્ ઈશ્વરેણ શક્યં|</para>
  <para style="p">
    <verse number="28" style="v"/>તદા પિતર ઉવાચ, પશ્ય વયં સર્વ્વસ્વં પરિત્યજ્ય તવ પશ્ચાદ્ગામિનોઽભવામ|</para>
  <para style="p">
    <verse number="29" style="v"/>તતઃ સ ઉવાચ, યુષ્માનહં યથાર્થં વદામિ, ઈશ્વરરાજ્યાર્થં ગૃહં પિતરૌ ભ્રાતૃગણં જાયાં સન્તાનાંશ્ચ ત્યક્તવા</para>
  <para style="p">
    <verse number="30" style="v"/>ઇહ કાલે તતોઽધિકં પરકાલે ઽનન્તાયુશ્ચ ન પ્રાપ્સ્યતિ લોક ઈદૃશઃ કોપિ નાસ્તિ|</para>
  <para style="p">
    <verse number="31" style="v"/>અનન્તરં સ દ્વાદશશિષ્યાનાહૂય બભાષે, પશ્યત વયં યિરૂશાલમ્નગરં યામઃ, તસ્માત્ મનુષ્યપુત્રે ભવિષ્યદ્વાદિભિરુક્તં યદસ્તિ તદનુરૂપં તં પ્રતિ ઘટિષ્યતે;</para>
  <para style="p">
    <verse number="32" style="v"/>વસ્તુતસ્તુ સોઽન્યદેશીયાનાં હસ્તેષુ સમર્પયિષ્યતે, તે તમુપહસિષ્યન્તિ, અન્યાયમાચરિષ્યન્તિ તદ્વપુષિ નિષ્ઠીવં નિક્ષેપ્સ્યન્તિ, કશાભિઃ પ્રહૃત્ય તં હનિષ્યન્તિ ચ,</para>
  <para style="p">
    <verse number="33" style="v"/>કિન્તુ તૃતીયદિને સ શ્મશાનાદ્ ઉત્થાસ્યતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>એતસ્યાઃ કથાયા અભિપ્રાયં કિઞ્ચિદપિ તે બોદ્ધું ન શેકુઃ તેષાં નિકટેઽસ્પષ્ટતવાત્ તસ્યૈતાસાં કથાનામ્ આશયં તે જ્ઞાતું ન શેકુશ્ચ|</para>
  <para style="p">
    <verse number="35" style="v"/>અથ તસ્મિન્ યિરીહોઃ પુરસ્યાન્તિકં પ્રાપ્તે કશ્ચિદન્ધઃ પથઃ પાર્શ્વ ઉપવિશ્ય ભિક્ષામ્ અકરોત્</para>
  <para style="p">
    <verse number="36" style="v"/>સ લોકસમૂહસ્ય ગમનશબ્દં શ્રુત્વા તત્કારણં પૃષ્ટવાન્|</para>
  <para style="p">
    <verse number="37" style="v"/>નાસરતીયયીશુર્યાતીતિ લોકૈરુક્તે સ ઉચ્ચૈર્વક્તુમારેભે,</para>
  <para style="p">
    <verse number="38" style="v"/>હે દાયૂદઃ સન્તાન યીશો માં દયસ્વ|</para>
  <para style="p">
    <verse number="39" style="v"/>તતોગ્રગામિનસ્તં મૌની તિષ્ઠેતિ તર્જયામાસુઃ કિન્તુ સ પુનારુવન્ ઉવાચ, હે દાયૂદઃ સન્તાન માં દયસ્વ|</para>
  <para style="p">
    <verse number="40" style="v"/>તદા યીશુઃ સ્થગિતો ભૂત્વા સ્વાન્તિકે તમાનેતુમ્ આદિદેશ|</para>
  <para style="p">
    <verse number="41" style="v"/>તતઃ સ તસ્યાન્તિકમ્ આગમત્, તદા સ તં પપ્રચ્છ, ત્વં કિમિચ્છસિ? ત્વદર્થમહં કિં કરિષ્યામિ? સ ઉક્તવાન્, હે પ્રભોઽહં દ્રષ્ટું લભૈ|</para>
  <para style="p">
    <verse number="42" style="v"/>તદા યીશુરુવાચ, દૃષ્ટિશક્તિં ગૃહાણ તવ પ્રત્યયસ્ત્વાં સ્વસ્થં કૃતવાન્|</para>
  <para style="p">
    <verse number="43" style="v"/>તતસ્તત્ક્ષણાત્ તસ્ય ચક્ષુષી પ્રસન્ને; તસ્માત્ સ ઈશ્વરં ધન્યં વદન્ તત્પશ્ચાદ્ યયૌ, તદાલોક્ય સર્વ્વે લોકા ઈશ્વરં પ્રશંસિતુમ્ આરેભિરે|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>યદા યીશુ ર્યિરીહોપુરં પ્રવિશ્ય તન્મધ્યેન ગચ્છંસ્તદા</para>
  <para style="p">
    <verse number="2" style="v"/>સક્કેયનામા કરસઞ્ચાયિનાં પ્રધાનો ધનવાનેકો</para>
  <para style="p">
    <verse number="3" style="v"/>યીશુઃ કીદૃગિતિ દ્રષ્ટું ચેષ્ટિતવાન્ કિન્તુ ખર્વ્વત્વાલ્લોકસંઘમધ્યે તદ્દર્શનમપ્રાપ્ય</para>
  <para style="p">
    <verse number="4" style="v"/>યેન પથા સ યાસ્યતિ તત્પથેઽગ્રે ધાવિત્વા તં દ્રષ્ટુમ્ ઉડુમ્બરતરુમારુરોહ|</para>
  <para style="p">
    <verse number="5" style="v"/>પશ્ચાદ્ યીશુસ્તત્સ્થાનમ્ ઇત્વા ઊર્દ્ધ્વં વિલોક્ય તં દૃષ્ટ્વાવાદીત્, હે સક્કેય ત્વં શીઘ્રમવરોહ મયાદ્ય ત્વદ્ગેહે વસ્તવ્યં|</para>
  <para style="p">
    <verse number="6" style="v"/>તતઃ સ શીઘ્રમવરુહ્ય સાહ્લાદં તં જગ્રાહ|</para>
  <para style="p">
    <verse number="7" style="v"/>તદ્ દૃષ્ટ્વા સર્વ્વે વિવદમાના વક્તુમારેભિરે, સોતિથિત્વેન દુષ્ટલોકગૃહં ગચ્છતિ|</para>
  <para style="p">
    <verse number="8" style="v"/>કિન્તુ સક્કેયો દણ્ડાયમાનો વક્તુમારેભે, હે પ્રભો પશ્ય મમ યા સમ્પત્તિરસ્તિ તદર્દ્ધં દરિદ્રેભ્યો દદે, અપરમ્ અન્યાયં કૃત્વા કસ્માદપિ યદિ કદાપિ કિઞ્ચિત્ મયા ગૃહીતં તર્હિ તચ્ચતુર્ગુણં દદામિ|</para>
  <para style="p">
    <verse number="9" style="v"/>તદા યીશુસ્તમુક્તવાન્ અયમપિ ઇબ્રાહીમઃ સન્તાનોઽતઃ કારણાદ્ અદ્યાસ્ય ગૃહે ત્રાણમુપસ્થિતં|</para>
  <para style="p">
    <verse number="10" style="v"/>યદ્ હારિતં તત્ મૃગયિતું રક્ષિતુઞ્ચ મનુષ્યપુત્ર આગતવાન્|</para>
  <para style="p">
    <verse number="11" style="v"/>અથ સ યિરૂશાલમઃ સમીપ ઉપાતિષ્ઠદ્ ઈશ્વરરાજત્વસ્યાનુષ્ઠાનં તદૈવ ભવિષ્યતીતિ લોકૈરન્વભૂયત, તસ્માત્ સ શ્રોતૃભ્યઃ પુનર્દૃષ્ટાન્તકથામ્ ઉત્થાપ્ય કથયામાસ|</para>
  <para style="p">
    <verse number="12" style="v"/>કોપિ મહાલ્લોકો નિજાર્થં રાજત્વપદં ગૃહીત્વા પુનરાગન્તું દૂરદેશં જગામ|</para>
  <para style="p">
    <verse number="13" style="v"/>યાત્રાકાલે નિજાન્ દશદાસાન્ આહૂય દશસ્વર્ણમુદ્રા દત્ત્વા મમાગમનપર્ય્યન્તં વાણિજ્યં કુરુતેત્યાદિદેશ|</para>
  <para style="p">
    <verse number="14" style="v"/>કિન્તુ તસ્ય પ્રજાસ્તમવજ્ઞાય મનુષ્યમેનમ્ અસ્માકમુપરિ રાજત્વં ન કારયિવ્યામ ઇમાં વાર્ત્તાં તન્નિકટે પ્રેરયામાસુઃ|</para>
  <para style="p">
    <verse number="15" style="v"/>અથ સ રાજત્વપદં પ્રાપ્યાગતવાન્ એકૈકો જનો બાણિજ્યેન કિં લબ્ધવાન્ ઇતિ જ્ઞાતું યેષુ દાસેષુ મુદ્રા અર્પયત્ તાન્ આહૂયાનેતુમ્ આદિદેશ|</para>
  <para style="p">
    <verse number="16" style="v"/>તદા પ્રથમ આગત્ય કથિતવાન્, હે પ્રભો તવ તયૈકયા મુદ્રયા દશમુદ્રા લબ્ધાઃ|</para>
  <para style="p">
    <verse number="17" style="v"/>તતઃ સ ઉવાચ ત્વમુત્તમો દાસઃ સ્વલ્પેન વિશ્વાસ્યો જાત ઇતઃ કારણાત્ ત્વં દશનગરાણામ્ અધિપો ભવ|</para>
  <para style="p">
    <verse number="18" style="v"/>દ્વિતીય આગત્ય કથિતવાન્, હે પ્રભો તવૈકયા મુદ્રયા પઞ્ચમુદ્રા લબ્ધાઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>તતઃ સ ઉવાચ, ત્વં પઞ્ચાનાં નગરાણામધિપતિ ર્ભવ|</para>
  <para style="p">
    <verse number="20" style="v"/>તતોન્ય આગત્ય કથયામાસ, હે પ્રભો પશ્ય તવ યા મુદ્રા અહં વસ્ત્રે બદ્ધ્વાસ્થાપયં સેયં|</para>
  <para style="p">
    <verse number="21" style="v"/>ત્વં કૃપણો યન્નાસ્થાપયસ્તદપિ ગૃહ્લાસિ, યન્નાવપસ્તદેવ ચ છિનત્સિ તતોહં ત્વત્તો ભીતઃ|</para>
  <para style="p">
    <verse number="22" style="v"/>તદા સ જગાદ, રે દુષ્ટદાસ તવ વાક્યેન ત્વાં દોષિણં કરિષ્યામિ, યદહં નાસ્થાપયં તદેવ ગૃહ્લામિ, યદહં નાવપઞ્ચ તદેવ છિનદ્મિ, એતાદૃશઃ કૃપણોહમિતિ યદિ ત્વં જાનાસિ,</para>
  <para style="p">
    <verse number="23" style="v"/>તર્હિ મમ મુદ્રા બણિજાં નિકટે કુતો નાસ્થાપયઃ? તયા કૃતેઽહમ્ આગત્ય કુસીદેન સાર્દ્ધં નિજમુદ્રા અપ્રાપ્સ્યમ્|</para>
  <para style="p">
    <verse number="24" style="v"/>પશ્ચાત્ સ સમીપસ્થાન્ જનાન્ આજ્ઞાપયત્ અસ્માત્ મુદ્રા આનીય યસ્ય દશમુદ્રાઃ સન્તિ તસ્મૈ દત્ત|</para>
  <para style="p">
    <verse number="25" style="v"/>તે પ્રોચુઃ પ્રભોઽસ્ય દશમુદ્રાઃ સન્તિ|</para>
  <para style="p">
    <verse number="26" style="v"/>યુષ્માનહં વદામિ યસ્યાશ્રયે વદ્ધતે ઽધિકં તસ્મૈ દાયિષ્યતે, કિન્તુ યસ્યાશ્રયે ન વર્દ્ધતે તસ્ય યદ્યદસ્તિ તદપિ તસ્માન્ નાયિષ્યતે|</para>
  <para style="p">
    <verse number="27" style="v"/>કિન્તુ મમાધિપતિત્વસ્ય વશત્વે સ્થાતુમ્ અસમ્મન્યમાના યે મમ રિપવસ્તાનાનીય મમ સમક્ષં સંહરત|</para>
  <para style="p">
    <verse number="28" style="v"/>ઇત્યુપદેશકથાં કથયિત્વા સોગ્રગઃ સન્ યિરૂશાલમપુરં યયૌ|</para>
  <para style="p">
    <verse number="29" style="v"/>તતો બૈત્ફગીબૈથનીયાગ્રામયોઃ સમીપે જૈતુનાદ્રેરન્તિકમ્ ઇત્વા શિષ્યદ્વયમ્ ઇત્યુક્ત્વા પ્રેષયામાસ,</para>
  <para style="p">
    <verse number="30" style="v"/>યુવામમું સમ્મુખસ્થગ્રામં પ્રવિશ્યૈવ યં કોપિ માનુષઃ કદાપિ નારોહત્ તં ગર્દ્દભશાવકં બદ્ધં દ્રક્ષ્યથસ્તં મોચયિત્વાનયતં|</para>
  <para style="p">
    <verse number="31" style="v"/>તત્ર કુતો મોચયથઃ? ઇતિ ચેત્ કોપિ વક્ષ્યતિ તર્હિ વક્ષ્યથઃ પ્રભેाરત્ર પ્રયોજનમ્ આસ્તે|</para>
  <para style="p">
    <verse number="32" style="v"/>તદા તૌ પ્રરિતૌ ગત્વા તત્કથાाનુસારેણ સર્વ્વં પ્રાપ્તૌ|</para>
  <para style="p">
    <verse number="33" style="v"/>ગર્દભશાવકમોચનકાલે તત્વામિન ઊચુઃ, ગર્દભશાવકં કુતો મોચયથઃ?</para>
  <para style="p">
    <verse number="34" style="v"/>તાવૂચતુઃ પ્રભોરત્ર પ્રયોજનમ્ આસ્તે|</para>
  <para style="p">
    <verse number="35" style="v"/>પશ્ચાત્ તૌ તં ગર્દભશાવકં યીશોરન્તિકમાનીય તત્પૃષ્ઠે નિજવસનાનિ પાતયિત્વા તદુપરિ યીશુમારોહયામાસતુઃ|</para>
  <para style="p">
    <verse number="36" style="v"/>અથ યાત્રાકાલે લોકાઃ પથિ સ્વવસ્ત્રાણિ પાતયિતુમ્ આરેભિરે|</para>
  <para style="p">
    <verse number="37" style="v"/>અપરં જૈતુનાદ્રેરુપત્યકામ્ ઇત્વા શિષ્યસંઘઃ પૂર્વ્વદૃષ્ટાનિ મહાકર્મ્માણિ સ્મૃત્વા,</para>
  <para style="p">
    <verse number="38" style="v"/>યો રાજા પ્રભો ર્નામ્નાયાતિ સ ધન્યઃ સ્વર્ગે કુશલં સર્વ્વોચ્ચે જયધ્વનિ ર્ભવતુ, કથામેતાં કથયિત્વા સાનન્દમ્ ઉચૈરીશ્વરં ધન્યં વક્તુમારેભે|</para>
  <para style="p">
    <verse number="39" style="v"/>તદા લોકારણ્યમધ્યસ્થાઃ કિયન્તઃ ફિરૂશિનસ્તત્ શ્રુત્વા યીશું પ્રોચુઃ, હે ઉપદેશક સ્વશિષ્યાન્ તર્જય|</para>
  <para style="p">
    <verse number="40" style="v"/>સ ઉવાચ, યુષ્માનહં વદામિ યદ્યમી નીરવાસ્તિષ્ઠન્તિ તર્હિ પાષાણા ઉચૈઃ કથાઃ કથયિષ્યન્તિ|</para>
  <para style="p">
    <verse number="41" style="v"/>પશ્ચાત્ તત્પુરાન્તિકમેત્ય તદવલોક્ય સાશ્રુપાતં જગાદ,</para>
  <para style="p">
    <verse number="42" style="v"/>હા હા ચેત્ ત્વમગ્રેઽજ્ઞાસ્યથાઃ, તવાસ્મિન્નેવ દિને વા યદિ સ્વમઙ્ગલમ્ ઉપાલપ્સ્યથાઃ, તર્હ્યુત્તમમ્ અભવિષ્યત્, કિન્તુ ક્ષણેસ્મિન્ તત્તવ દૃષ્ટેરગોચરમ્ ભવતિ|</para>
  <para style="p">
    <verse number="43" style="v"/>ત્વં સ્વત્રાણકાલે ન મનો ન્યધત્થા ઇતિ હેતો ર્યત્કાલે તવ રિપવસ્ત્વાં ચતુર્દિક્ષુ પ્રાચીરેણ વેષ્ટયિત્વા રોત્સ્યન્તિ</para>
  <para style="p">
    <verse number="44" style="v"/>બાલકૈઃ સાર્દ્ધં ભૂમિસાત્ કરિષ્યન્તિ ચ ત્વન્મધ્યે પાષાણૈકોપિ પાષાણોપરિ ન સ્થાસ્યતિ ચ, કાલ ઈદૃશ ઉપસ્થાસ્યતિ|</para>
  <para style="p">
    <verse number="45" style="v"/>અથ મધ્યેમન્દિરં પ્રવિશ્ય તત્રત્યાન્ ક્રયિવિક્રયિણો બહિષ્કુર્વ્વન્</para>
  <para style="p">
    <verse number="46" style="v"/>અવદત્ મદ્ગૃહં પ્રાર્થનાગૃહમિતિ લિપિરાસ્તે કિન્તુ યૂયં તદેવ ચૈરાણાં ગહ્વરં કુરુથ|</para>
  <para style="p">
    <verse number="47" style="v"/>પશ્ચાત્ સ પ્રત્યહં મધ્યેમન્દિરમ્ ઉપદિદેશ; તતઃ પ્રધાનયાજકા અધ્યાપકાઃ પ્રાચીનાશ્ચ તં નાશયિતું ચિચેષ્ટિરે;</para>
  <para style="p">
    <verse number="48" style="v"/>કિન્તુ તદુપદેશે સર્વ્વે લોકા નિવિષ્ટચિત્તાઃ સ્થિતાસ્તસ્માત્ તે તત્કર્ત્તું નાવકાશં પ્રાપુઃ|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અથૈકદા યીશુ ર્મનિદરે સુસંવાદં પ્રચારયન્ લોકાનુપદિશતિ, એતર્હિ પ્રધાનયાજકા અધ્યાપકાઃ પ્રાઞ્ચશ્ચ તન્નિકટમાગત્ય પપ્રચ્છુઃ</para>
  <para style="p">
    <verse number="2" style="v"/>કયાજ્ઞયા ત્વં કર્મ્માણ્યેતાનિ કરોષિ? કો વા ત્વામાજ્ઞાપયત્? તદસ્માન્ વદ|</para>
  <para style="p">
    <verse number="3" style="v"/>સ પ્રત્યુવાચ, તર્હિ યુષ્માનપિ કથામેકાં પૃચ્છામિ તસ્યોત્તરં વદત|</para>
  <para style="p">
    <verse number="4" style="v"/>યોહનો મજ્જનમ્ ઈશ્વરસ્ય માનુષાણાં વાજ્ઞાતો જાતં?</para>
  <para style="p">
    <verse number="5" style="v"/>તતસ્તે મિથો વિવિચ્ય જગદુઃ, યદીશ્વરસ્ય વદામસ્તર્હિ તં કુતો ન પ્રત્યૈત સ ઇતિ વક્ષ્યતિ|</para>
  <para style="p">
    <verse number="6" style="v"/>યદિ મનુષ્યસ્યેતિ વદામસ્તર્હિ સર્વ્વે લોકા અસ્માન્ પાષાણૈ ર્હનિષ્યન્તિ યતો યોહન્ ભવિષ્યદ્વાદીતિ સર્વ્વે દૃઢં જાનન્તિ|</para>
  <para style="p">
    <verse number="7" style="v"/>અતએવ તે પ્રત્યૂચુઃ કસ્યાજ્ઞયા જાતમ્ ઇતિ વક્તું ન શક્નુમઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>તદા યીશુરવદત્ તર્હિ કયાજ્ઞયા કર્મ્માણ્યેતાતિ કરોમીતિ ચ યુષ્માન્ ન વક્ષ્યામિ|</para>
  <para style="p">
    <verse number="9" style="v"/>અથ લોકાનાં સાક્ષાત્ સ ઇમાં દૃષ્ટાન્તકથાં વક્તુમારેભે, કશ્ચિદ્ દ્રાક્ષાક્ષેત્રં કૃત્વા તત્ ક્ષેત્રં કૃષીવલાનાં હસ્તેષુ સમર્પ્ય બહુકાલાર્થં દૂરદેશં જગામ|</para>
  <para style="p">
    <verse number="10" style="v"/>અથ ફલકાલે ફલાનિ ગ્રહીતુ કૃષીવલાનાં સમીપે દાસં પ્રાહિણોત્ કિન્તુ કૃષીવલાસ્તં પ્રહૃત્ય રિક્તહસ્તં વિસસર્જુઃ|</para>
  <para style="p">
    <verse number="11" style="v"/>તતઃ સોધિપતિઃ પુનરન્યં દાસં પ્રેષયામાસ, તે તમપિ પ્રહૃત્ય કુવ્યવહૃત્ય રિક્તહસ્તં વિસસૃજુઃ|</para>
  <para style="p">
    <verse number="12" style="v"/>તતઃ સ તૃતીયવારમ્ અન્યં પ્રાહિણોત્ તે તમપિ ક્ષતાઙ્ગં કૃત્વા બહિ ર્નિચિક્ષિપુઃ|</para>
  <para style="p">
    <verse number="13" style="v"/>તદા ક્ષેત્રપતિ ર્વિચારયામાસ, મમેદાનીં કિં કર્ત્તવ્યં? મમ પ્રિયે પુત્રે પ્રહિતે તે તમવશ્યં દૃષ્ટ્વા સમાદરિષ્યન્તે|</para>
  <para style="p">
    <verse number="14" style="v"/>કિન્તુ કૃષીવલાસ્તં નિરીક્ષ્ય પરસ્પરં વિવિચ્ય પ્રોચુઃ, અયમુત્તરાધિકારી આગચ્છતૈનં હન્મસ્તતોધિકારોસ્માકં ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="15" style="v"/>તતસ્તે તં ક્ષેત્રાદ્ બહિ ર્નિપાત્ય જઘ્નુસ્તસ્માત્ સ ક્ષેત્રપતિસ્તાન્ પ્રતિ કિં કરિષ્યતિ?</para>
  <para style="p">
    <verse number="16" style="v"/>સ આગત્ય તાન્ કૃષીવલાન્ હત્વા પરેષાં હસ્તેષુ તત્ક્ષેત્રં સમર્પયિષ્યતિ; ઇતિ કથાં શ્રુત્વા તે ઽવદન્ એતાદૃશી ઘટના ન ભવતુ|</para>
  <para style="p">
    <verse number="17" style="v"/>કિન્તુ યીશુસ્તાનવલોક્ય જગાદ, તર્હિ, સ્થપતયઃ કરિષ્યન્તિ ગ્રાવાણં યન્તુ તુચ્છકં| પ્રધાનપ્રસ્તરઃ કોણે સ એવ હિ ભવિષ્યતિ| એતસ્ય શાસ્ત્રીયવચનસ્ય કિં તાત્પર્ય્યં?</para>
  <para style="p">
    <verse number="18" style="v"/>અપરં તત્પાષાણોપરિ યઃ પતિષ્યતિ સ ભંક્ષ્યતે કિન્તુ યસ્યોપરિ સ પાષાણઃ પતિષ્યતિ સ તેન ધૂલિવચ્ ચૂર્ણીભવિષ્યતિ|</para>
  <para style="p">
    <verse number="19" style="v"/>સોસ્માકં વિરુદ્ધં દૃષ્ટાન્તમિમં કથિતવાન્ ઇતિ જ્ઞાત્વા પ્રધાનયાજકા અધ્યાપકાશ્ચ તદૈવ તં ધર્તું વવાઞ્છુઃ કિન્તુ લોકેભ્યો બિભ્યુઃ|</para>
  <para style="p">
    <verse number="20" style="v"/>અતએવ તં પ્રતિ સતર્કાઃ સન્તઃ કથં તદ્વાક્યદોષં ધૃત્વા તં દેશાધિપસ્ય સાધુવેશધારિણશ્ચરાન્ તસ્ય સમીપે પ્રેષયામાસુઃ|</para>
  <para style="p">
    <verse number="21" style="v"/>તદા તે તં પપ્રચ્છુઃ, હે ઉપદેશક ભવાન્ યથાર્થં કથયન્ ઉપદિશતિ, કમપ્યનપેક્ષ્ય સત્યત્વેનૈશ્વરં માર્ગમુપદિશતિ, વયમેતજ્જાનીમઃ|</para>
  <para style="p">
    <verse number="22" style="v"/>કૈસરરાજાય કરોસ્માભિ ર્દેયો ન વા?</para>
  <para style="p">
    <verse number="23" style="v"/>સ તેષાં વઞ્ચનં જ્ઞાત્વાવદત્ કુતો માં પરીક્ષધ્વે? માં મુદ્રામેકં દર્શયત|</para>
  <para style="p">
    <verse number="24" style="v"/>ઇહ લિખિતા મૂર્તિરિયં નામ ચ કસ્ય? તેઽવદન્ કૈસરસ્ય|</para>
  <para style="p">
    <verse number="25" style="v"/>તદા સ ઉવાચ, તર્હિ કૈસરસ્ય દ્રવ્યં કૈસરાય દત્ત; ઈશ્વરસ્ય તુ દ્રવ્યમીશ્વરાય દત્ત|</para>
  <para style="p">
    <verse number="26" style="v"/>તસ્માલ્લોકાનાં સાક્ષાત્ તત્કથાયાઃ કમપિ દોષં ધર્તુમપ્રાપ્ય તે તસ્યોત્તરાદ્ આશ્ચર્ય્યં મન્યમાના મૌનિનસ્તસ્થુઃ|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરઞ્ચ શ્મશાનાદુત્થાનાનઙ્ગીકારિણાં સિદૂકિનાં કિયન્તો જના આગત્ય તં પપ્રચ્છુઃ,</para>
  <para style="p">
    <verse number="28" style="v"/>હે ઉપદેશક શાસ્ત્રે મૂસા અસ્માન્ પ્રતીતિ લિલેખ યસ્ય ભ્રાતા ભાર્ય્યાયાં સત્યાં નિઃસન્તાનો મ્રિયતે સ તજ્જાયાં વિવહ્ય તદ્વંશમ્ ઉત્પાદયિષ્યતિ|</para>
  <para style="p">
    <verse number="29" style="v"/>તથાચ કેચિત્ સપ્ત ભ્રાતર આસન્ તેષાં જ્યેષ્ઠો ભ્રાતા વિવહ્ય નિરપત્યઃ પ્રાણાન્ જહૌ|</para>
  <para style="p">
    <verse number="30" style="v"/>અથ દ્વિતીયસ્તસ્ય જાયાં વિવહ્ય નિરપત્યઃ સન્ મમાર| તૃતીયશ્ચ તામેવ વ્યુવાહ;</para>
  <para style="p">
    <verse number="31" style="v"/>ઇત્થં સપ્ત ભ્રાતરસ્તામેવ વિવહ્ય નિરપત્યાઃ સન્તો મમ્રુઃ|</para>
  <para style="p">
    <verse number="32" style="v"/>શેષે સા સ્ત્રી ચ મમાર|</para>
  <para style="p">
    <verse number="33" style="v"/>અતએવ શ્મશાનાદુત્થાનકાલે તેષાં સપ્તજનાનાં કસ્ય સા ભાર્ય્યા ભવિષ્યતિ? યતઃ સા તેષાં સપ્તાનામેવ ભાર્ય્યાસીત્|</para>
  <para style="p">
    <verse number="34" style="v"/>તદા યીશુઃ પ્રત્યુવાચ, એતસ્ય જગતો લોકા વિવહન્તિ વાગ્દત્તાશ્ચ ભવન્તિ</para>
  <para style="p">
    <verse number="35" style="v"/>કિન્તુ યે તજ્જગત્પ્રાપ્તિયોગ્યત્વેન ગણિતાં ભવિષ્યન્તિ શ્મશાનાચ્ચોત્થાસ્યન્તિ તે ન વિવહન્તિ વાગ્દત્તાશ્ચ ન ભવન્તિ,</para>
  <para style="p">
    <verse number="36" style="v"/>તે પુન ર્ન મ્રિયન્તે કિન્તુ શ્મશાનાદુત્થાપિતાઃ સન્ત ઈશ્વરસ્ય સન્તાનાઃ સ્વર્ગીયદૂતાનાં સદૃશાશ્ચ ભવન્તિ|</para>
  <para style="p">
    <verse number="37" style="v"/>અધિકન્તુ મૂસાઃ સ્તમ્બોપાખ્યાને પરમેશ્વર ઈબ્રાહીમ ઈશ્વર ઇસ્હાક ઈશ્વરો યાકૂબશ્ચેશ્વર ઇત્યુક્ત્વા મૃતાનાં શ્મશાનાદ્ ઉત્થાનસ્ય પ્રમાણં લિલેખ|</para>
  <para style="p">
    <verse number="38" style="v"/>અતએવ ય ઈશ્વરઃ સ મૃતાનાં પ્રભુ ર્ન કિન્તુ જીવતામેવ પ્રભુઃ, તન્નિકટે સર્વ્વે જીવન્તઃ સન્તિ|</para>
  <para style="p">
    <verse number="39" style="v"/>ઇતિ શ્રુત્વા કિયન્તોધ્યાપકા ઊચુઃ, હે ઉપદેશક ભવાન્ ભદ્રં પ્રત્યુક્તવાન્|</para>
  <para style="p">
    <verse number="40" style="v"/>ઇતઃ પરં તં કિમપિ પ્રષ્ટં તેષાં પ્રગલ્ભતા નાભૂત્|</para>
  <para style="p">
    <verse number="41" style="v"/>પશ્ચાત્ સ તાન્ ઉવાચ, યઃ ખ્રીષ્ટઃ સ દાયૂદઃ સન્તાન એતાં કથાં લોકાઃ કથં કથયન્તિ?</para>
  <para style="p">
    <verse number="42" style="v"/>યતઃ મમ પ્રભુમિદં વાક્યમવદત્ પરમેશ્વરઃ| તવ શત્રૂનહં યાવત્ પાદપીઠં કરોમિ ન| તાવત્ કાલં મદીયે ત્વં દક્ષપાર્શ્વ ઉપાવિશ|</para>
  <para style="p">
    <verse number="43" style="v"/>ઇતિ કથાં દાયૂદ્ સ્વયં ગીતગ્રન્થેઽવદત્|</para>
  <para style="p">
    <verse number="44" style="v"/>અતએવ યદિ દાયૂદ્ તં પ્રભું વદતિ, તર્હિ સ કથં તસ્ય સન્તાનો ભવતિ?</para>
  <para style="p">
    <verse number="45" style="v"/>પશ્ચાદ્ યીશુઃ સર્વ્વજનાનાં કર્ણગોચરે શિષ્યાનુવાચ,</para>
  <para style="p">
    <verse number="46" style="v"/>યેઽધ્યાપકા દીર્ઘપરિચ્છદં પરિધાય ભ્રમન્તિ, હટ્ટાપણયો ર્નમસ્કારે ભજનગેહસ્ય પ્રોચ્ચાસને ભોજનગૃહસ્ય પ્રધાનસ્થાને ચ પ્રીયન્તે</para>
  <para style="p">
    <verse number="47" style="v"/>વિધવાનાં સર્વ્વસ્વં ગ્રસિત્વા છલેન દીર્ઘકાલં પ્રાર્થયન્તે ચ તેષુ સાવધાના ભવત, તેષામુગ્રદણ્ડો ભવિષ્યતિ|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અથ ધનિલોકા ભાણ્ડાગારે ધનં નિક્ષિપન્તિ સ તદેવ પશ્યતિ,</para>
  <para style="p">
    <verse number="2" style="v"/>એતર્હિ કાચિદ્દીના વિધવા પણદ્વયં નિક્ષિપતિ તદ્ દદર્શ|</para>
  <para style="p">
    <verse number="3" style="v"/>તતો યીશુરુવાચ યુષ્માનહં યથાર્થં વદામિ, દરિદ્રેયં વિધવા સર્વ્વેભ્યોધિકં ન્યક્ષેપ્સીત્,</para>
  <para style="p">
    <verse number="4" style="v"/>યતોન્યે સ્વપ્રાજ્યધનેભ્ય ઈશ્વરાય કિઞ્ચિત્ ન્યક્ષેપ્સુઃ, કિન્તુ દરિદ્રેયં વિધવા દિનયાપનાર્થં સ્વસ્ય યત્ કિઞ્ચિત્ સ્થિતં તત્ સર્વ્વં ન્યક્ષેપ્સીત્|</para>
  <para style="p">
    <verse number="5" style="v"/>અપરઞ્ચ ઉત્તમપ્રસ્તરૈરુત્સૃષ્ટવ્યૈશ્ચ મન્દિરં સુશોભતેતરાં કૈશ્ચિદિત્યુક્તે સ પ્રત્યુવાચ</para>
  <para style="p">
    <verse number="6" style="v"/>યૂયં યદિદં નિચયનં પશ્યથ, અસ્ય પાષાણૈકોપ્યન્યપાષાણોપરિ ન સ્થાસ્યતિ, સર્વ્વે ભૂસાદ્ભવિષ્યન્તિ કાલોયમાયાતિ|</para>
  <para style="p">
    <verse number="7" style="v"/>તદા તે પપ્રચ્છુઃ, હે ગુરો ઘટનેદૃશી કદા ભવિષ્યતિ? ઘટનાયા એતસ્યસશ્ચિહ્નં વા કિં ભવિષ્યતિ?</para>
  <para style="p">
    <verse number="8" style="v"/>તદા સ જગાદ, સાવધાના ભવત યથા યુષ્માકં ભ્રમં કોપિ ન જનયતિ, ખીષ્ટોહમિત્યુક્ત્વા મમ નામ્રા બહવ ઉપસ્થાસ્યન્તિ સ કાલઃ પ્રાયેણોપસ્થિતઃ, તેષાં પશ્ચાન્મા ગચ્છત|</para>
  <para style="p">
    <verse number="9" style="v"/>યુદ્ધસ્યોપપ્લવસ્ય ચ વાર્ત્તાં શ્રુત્વા મા શઙ્કધ્વં, યતઃ પ્રથમમ્ એતા ઘટના અવશ્યં ભવિષ્યન્તિ કિન્તુ નાપાતે યુગાન્તો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="10" style="v"/>અપરઞ્ચ કથયામાસ, તદા દેશસ્ય વિપક્ષત્વેન દેશો રાજ્યસ્ય વિપક્ષત્વેન રાજ્યમ્ ઉત્થાસ્યતિ,</para>
  <para style="p">
    <verse number="11" style="v"/>નાનાસ્થાનેષુ મહાભૂકમ્પો દુર્ભિક્ષં મારી ચ ભવિષ્યન્તિ, તથા વ્યોમમણ્ડલસ્ય ભયઙ્કરદર્શનાન્યશ્ચર્ય્યલક્ષણાનિ ચ પ્રકાશયિષ્યન્તે|</para>
  <para style="p">
    <verse number="12" style="v"/>કિન્તુ સર્વ્વાસામેતાસાં ઘટનાનાં પૂર્વ્વં લોકા યુષ્માન્ ધૃત્વા તાડયિષ્યન્તિ, ભજનાલયે કારાયાઞ્ચ સમર્પયિષ્યન્તિ મમ નામકારણાદ્ યુષ્માન્ ભૂપાનાં શાસકાનાઞ્ચ સમ્મુખં નેષ્યન્તિ ચ|</para>
  <para style="p">
    <verse number="13" style="v"/>સાક્ષ્યાર્થમ્ એતાનિ યુષ્માન્ પ્રતિ ઘટિષ્યન્તે|</para>
  <para style="p">
    <verse number="14" style="v"/>તદા કિમુત્તરં વક્તવ્યમ્ એતત્ ન ચિન્તયિષ્યામ ઇતિ મનઃસુ નિશ્ચિતનુત|</para>
  <para style="p">
    <verse number="15" style="v"/>વિપક્ષા યસ્માત્ કિમપ્યુત્તરમ્ આપત્તિઞ્ચ કર્ત્તું ન શક્ષ્યન્તિ તાદૃશં વાક્પટુત્વં જ્ઞાનઞ્ચ યુષ્મભ્યં દાસ્યામિ|</para>
  <para style="p">
    <verse number="16" style="v"/>કિઞ્ચ યૂયં પિત્રા માત્રા ભ્રાત્રા બન્ધુના જ્ઞાત્યા કુટુમ્બેન ચ પરકરેષુ સમર્પયિષ્યધ્વે; તતસ્તે યુષ્માકં કઞ્ચન કઞ્ચન ઘાતયિષ્યન્તિ|</para>
  <para style="p">
    <verse number="17" style="v"/>મમ નામ્નઃ કારણાત્ સર્વ્વૈ ર્મનુષ્યૈ ર્યૂયમ્ ઋતીયિષ્યધ્વે|</para>
  <para style="p">
    <verse number="18" style="v"/>કિન્તુ યુષ્માકં શિરઃકેશૈકોપિ ન વિનંક્ષ્યતિ,</para>
  <para style="p">
    <verse number="19" style="v"/>તસ્માદેવ ધૈર્ય્યમવલમ્બ્ય સ્વસ્વપ્રાણાન્ રક્ષત|</para>
  <para style="p">
    <verse number="20" style="v"/>અપરઞ્ચ યિરૂશાલમ્પુરં સૈન્યવેષ્ટિતં વિલોક્ય તસ્યોચ્છિન્નતાયાઃ સમયઃ સમીપ ઇત્યવગમિષ્યથ|</para>
  <para style="p">
    <verse number="21" style="v"/>તદા યિહૂદાદેશસ્થા લોકાઃ પર્વ્વતં પલાયન્તાં, યે ચ નગરે તિષ્ઠન્તિ તે દેશાન્તરં પલાયન્તા, યે ચ ગ્રામે તિષ્ઠન્તિ તે નગરં ન પ્રવિશન્તુ,</para>
  <para style="p">
    <verse number="22" style="v"/>યતસ્તદા સમુચિતદણ્ડનાય ધર્મ્મપુસ્તકે યાનિ સર્વ્વાણિ લિખિતાનિ તાનિ સફલાનિ ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="23" style="v"/>કિન્તુ યા યાસ્તદા ગર્ભવત્યઃ સ્તન્યદાવ્યશ્ચ તામાં દુર્ગતિ ર્ભવિષ્યતિ, યત એતાલ્લોકાન્ પ્રતિ કોપો દેશે ચ વિષમદુર્ગતિ ર્ઘટિષ્યતે|</para>
  <para style="p">
    <verse number="24" style="v"/>વસ્તુતસ્તુ તે ખઙ્ગધારપરિવ્વઙ્ગં લપ્સ્યન્તે બદ્ધાઃ સન્તઃ સર્વ્વદેશેષુ નાયિષ્યન્તે ચ કિઞ્ચાન્યદેશીયાનાં સમયોપસ્થિતિપર્ય્યન્તં યિરૂશાલમ્પુરં તૈઃ પદતલૈ ર્દલયિષ્યતે|</para>
  <para style="p">
    <verse number="25" style="v"/>સૂર્ય્યચન્દ્રનક્ષત્રેષુ લક્ષણાદિ ભવિષ્યન્તિ, ભુવિ સર્વ્વદેશીયાનાં દુઃખં ચિન્તા ચ સિન્ધૌ વીચીનાં તર્જનં ગર્જનઞ્ચ ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="26" style="v"/>ભૂભૌ ભાવિઘટનાં ચિન્તયિત્વા મનુજા ભિયામૃતકલ્પા ભવિષ્યન્તિ, યતો વ્યોમમણ્ડલે તેજસ્વિનો દોલાયમાના ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="27" style="v"/>તદા પરાક્રમેણા મહાતેજસા ચ મેઘારૂઢં મનુષ્યપુત્રમ્ આયાન્તં દ્રક્ષ્યન્તિ|</para>
  <para style="p">
    <verse number="28" style="v"/>કિન્ત્વેતાસાં ઘટનાનામારમ્ભે સતિ યૂયં મસ્તકાન્યુત્તોલ્ય ઊર્દધ્વં દ્રક્ષ્યથ, યતો યુષ્માકં મુક્તેઃ કાલઃ સવિધો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="29" style="v"/>તતસ્તેનૈતદૃષ્ટાન્તકથા કથિતા, પશ્યત ઉડુમ્બરાદિવૃક્ષાણાં</para>
  <para style="p">
    <verse number="30" style="v"/>નવીનપત્રાણિ જાતાનીતિ દૃષ્ટ્વા નિદાવકાલ ઉપસ્થિત ઇતિ યથા યૂયં જ્ઞાતું શક્નુથ,</para>
  <para style="p">
    <verse number="31" style="v"/>તથા સર્વ્વાસામાસાં ઘટનાનામ્ આરમ્ભે દૃષ્ટે સતીશ્વરસ્ય રાજત્વં નિકટમ્ ઇત્યપિ જ્ઞાસ્યથ|</para>
  <para style="p">
    <verse number="32" style="v"/>યુષ્માનહં યથાર્થં વદામિ, વિદ્યમાનલોકાનામેષાં ગમનાત્ પૂર્વ્વમ્ એતાનિ ઘટિષ્યન્તે|</para>
  <para style="p">
    <verse number="33" style="v"/>નભોભુવોર્લોપો ભવિષ્યતિ મમ વાક્ તુ કદાપિ લુપ્તા ન ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="34" style="v"/>અતએવ વિષમાશનેન પાનેન ચ સાંમારિકચિન્તાભિશ્ચ યુષ્માકં ચિત્તેષુ મત્તેષુ તદ્દિનમ્ અકસ્માદ્ યુષ્માન્ પ્રતિ યથા નોપતિષ્ઠતિ તદર્થં સ્વેષુ સાવધાનાસ્તિષ્ઠત|</para>
  <para style="p">
    <verse number="35" style="v"/>પૃથિવીસ્થસર્વ્વલોકાન્ પ્રતિ તદ્દિનમ્ ઉન્માથ ઇવ ઉપસ્થાસ્યતિ|</para>
  <para style="p">
    <verse number="36" style="v"/>યથા યૂયમ્ એતદ્ભાવિઘટના ઉત્તર્ત્તું મનુજસુતસ્ય સમ્મુખે સંસ્થાતુઞ્ચ યોગ્યા ભવથ કારણાદસ્માત્ સાવધાનાઃ સન્તો નિરન્તરં પ્રાર્થયધ્વં|</para>
  <para style="p">
    <verse number="37" style="v"/>અપરઞ્ચ સ દિવા મન્દિર ઉપદિશ્ય રાચૈ જૈતુનાદ્રિં ગત્વાતિષ્ઠત્|</para>
  <para style="p">
    <verse number="38" style="v"/>તતઃ પ્રત્યૂષે લાકાસ્તત્કથાં શ્રોતું મન્દિરે તદન્તિકમ્ આગચ્છન્|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરઞ્ચ કિણ્વશૂન્યપૂપોત્સવસ્ય કાલ ઉપસ્થિતે</para>
  <para style="p">
    <verse number="2" style="v"/>પ્રધાનયાજકા અધ્યાયકાશ્ચ યથા તં હન્તું શક્નુવન્તિ તથોપાયામ્ અચેષ્ટન્ત કિન્તુ લોકેભ્યો બિભ્યુઃ|</para>
  <para style="p">
    <verse number="3" style="v"/>એતસ્તિન્ સમયે દ્વાદશશિષ્યેષુ ગણિત ઈષ્કરિયોતીયરૂઢિમાન્ યો યિહૂદાસ્તસ્યાન્તઃકરણં શૈતાનાશ્રિતત્વાત્</para>
  <para style="p">
    <verse number="4" style="v"/>સ ગત્વા યથા યીશું તેષાં કરેષુ સમર્પયિતું શક્નોતિ તથા મન્ત્રણાં પ્રધાનયાજકૈઃ સેનાપતિભિશ્ચ સહ ચકાર|</para>
  <para style="p">
    <verse number="5" style="v"/>તેન તે તુષ્ટાસ્તસ્મૈ મુદ્રાં દાતું પણં ચક્રુઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>તતઃ સોઙ્ગીકૃત્ય યથા લોકાનામગોચરે તં પરકરેષુ સમર્પયિતું શક્નોતિ તથાવકાશં ચેષ્ટિતુમારેભે|</para>
  <para style="p">
    <verse number="7" style="v"/>અથ કિણ્વશૂન્યપૂપોત્મવદિને, અર્થાત્ યસ્મિન્ દિને નિસ્તારોત્સવસ્ય મેષો હન્તવ્યસ્તસ્મિન્ દિને</para>
  <para style="p">
    <verse number="8" style="v"/>યીશુઃ પિતરં યોહનઞ્ચાહૂય જગાદ, યુવાં ગત્વાસ્માકં ભોજનાર્થં નિસ્તારોત્સવસ્ય દ્રવ્યાણ્યાસાદયતં|</para>
  <para style="p">
    <verse number="9" style="v"/>તદા તૌ પપ્રચ્છતુઃ કુચાસાદયાવો ભવતઃ કેચ્છા?</para>
  <para style="p">
    <verse number="10" style="v"/>તદા સોવાદીત્, નગરે પ્રવિષ્ટે કશ્ચિજ્જલકુમ્ભમાદાય યુવાં સાક્ષાત્ કરિષ્યતિ સ યન્નિવેશનં પ્રવિશતિ યુવામપિ તન્નિવેશનં તત્પશ્ચાદિત્વા નિવેશનપતિમ્ ઇતિ વાક્યં વદતં,</para>
  <para style="p">
    <verse number="11" style="v"/>યત્રાહં નિસ્તારોત્સવસ્ય ભોજ્યં શિષ્યૈઃ સાર્દ્ધં ભોક્તું શક્નોમિ સાતિથિશાલાा કુત્ર? કથામિમાં પ્રભુસ્ત્વાં પૃચ્છતિ|</para>
  <para style="p">
    <verse number="12" style="v"/>તતઃ સ જનો દ્વિતીયપ્રકોષ્ઠીયમ્ એકં શસ્તં કોષ્ઠં દર્શયિષ્યતિ તત્ર ભોજ્યમાસાદયતં|</para>
  <para style="p">
    <verse number="13" style="v"/>તતસ્તૌ ગત્વા તદ્વાક્યાનુસારેણ સર્વ્વં દૃષ્દ્વા તત્ર નિસ્તારોત્સવીયં ભોજ્યમાસાદયામાસતુઃ|</para>
  <para style="p">
    <verse number="14" style="v"/>અથ કાલ ઉપસ્થિતે યીશુ ર્દ્વાદશભિઃ પ્રેરિતૈઃ સહ ભોક્તુમુપવિશ્ય કથિતવાન્</para>
  <para style="p">
    <verse number="15" style="v"/>મમ દુઃખભોગાત્ પૂર્વ્વં યુભાભિઃ સહ નિસ્તારોત્સવસ્યૈતસ્ય ભોજ્યં ભોક્તું મયાતિવાઞ્છા કૃતા|</para>
  <para style="p">
    <verse number="16" style="v"/>યુષ્માન્ વદામિ, યાવત્કાલમ્ ઈશ્વરરાજ્યે ભોજનં ન કરિષ્યે તાવત્કાલમ્ ઇદં ન ભોક્ષ્યે|</para>
  <para style="p">
    <verse number="17" style="v"/>તદા સ પાનપાત્રમાદાય ઈશ્વરસ્ય ગુણાન્ કીર્ત્તયિત્વા તેભ્યો દત્વાવદત્, ઇદં ગૃહ્લીત યૂયં વિભજ્ય પિવત|</para>
  <para style="p">
    <verse number="18" style="v"/>યુષ્માન્ વદામિ યાવત્કાલમ્ ઈશ્વરરાજત્વસ્ય સંસ્થાપનં ન ભવતિ તાવદ્ દ્રાક્ષાફલરસં ન પાસ્યામિ|</para>
  <para style="p">
    <verse number="19" style="v"/>તતઃ પૂપં ગૃહીત્વા ઈશ્વરગુણાન્ કીર્ત્તયિત્વા ભઙ્ક્તા તેભ્યો દત્વાવદત્, યુષ્મદર્થં સમર્પિતં યન્મમ વપુસ્તદિદં, એતત્ કર્મ્મ મમ સ્મરણાર્થં કુરુધ્વં|</para>
  <para style="p">
    <verse number="20" style="v"/>અથ ભોજનાન્તે તાદૃશં પાત્રં ગૃહીત્વાવદત્, યુષ્મત્કૃતે પાતિતં યન્મમ રક્તં તેન નિર્ણીતનવનિયમરૂપં પાનપાત્રમિદં|</para>
  <para style="p">
    <verse number="21" style="v"/>પશ્યત યો માં પરકરેષુ સમર્પયિષ્યતિ સ મયા સહ ભોજનાસન ઉપવિશતિ|</para>
  <para style="p">
    <verse number="22" style="v"/>યથા નિરૂપિતમાસ્તે તદનુસારેણા મનુષ્યપુुત્રસ્ય ગતિ ર્ભવિષ્યતિ કિન્તુ યસ્તં પરકરેષુ સમર્પયિષ્યતિ તસ્ય સન્તાપો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="23" style="v"/>તદા તેષાં કો જન એતત્ કર્મ્મ કરિષ્યતિ તત્ તે પરસ્પરં પ્રષ્ટુમારેભિરે|</para>
  <para style="p">
    <verse number="24" style="v"/>અપરં તેષાં કો જનઃ શ્રેષ્ઠત્વેન ગણયિષ્યતે, અત્રાર્થે તેષાં વિવાદોભવત્|</para>
  <para style="p">
    <verse number="25" style="v"/>અસ્માત્ કારણાત્ સોવદત્, અન્યદેશીયાનાં રાજાનઃ પ્રજાનામુપરિ પ્રભુત્વં કુર્વ્વન્તિ દારુણશાસનં કૃત્વાપિ તે ભૂપતિત્વેન વિખ્યાતા ભવન્તિ ચ|</para>
  <para style="p">
    <verse number="26" style="v"/>કિન્તુ યુષ્માકં તથા ન ભવિષ્યતિ, યો યુષ્માકં શ્રેષ્ઠો ભવિષ્યતિ સ કનિષ્ઠવદ્ ભવતુ, યશ્ચ મુખ્યો ભવિષ્યતિ સ સેવકવદ્ભવતુ|</para>
  <para style="p">
    <verse number="27" style="v"/>ભોજનોપવિષ્ટપરિચારકયોઃ કઃ શ્રેષ્ઠઃ? યો ભોજનાયોપવિશતિ સ કિં શ્રેષ્ઠો ન ભવતિ? કિન્તુ યુષ્માકં મધ્યેઽહં પરિચારકઇવાસ્મિ|</para>
  <para style="p">
    <verse number="28" style="v"/>અપરઞ્ચ યુયં મમ પરીક્ષાકાલે પ્રથમમારભ્ય મયા સહ સ્થિતા</para>
  <para style="p">
    <verse number="29" style="v"/>એતત્કારણાત્ પિત્રા યથા મદર્થં રાજ્યમેકં નિરૂપિતં તથાહમપિ યુષ્મદર્થં રાજ્યં નિરૂપયામિ|</para>
  <para style="p">
    <verse number="30" style="v"/>તસ્માન્ મમ રાજ્યે ભોજનાસને ચ ભોજનપાને કરિષ્યધ્વે સિંહાસનેષૂપવિશ્ય ચેસ્રાયેલીયાનાં દ્વાદશવંશાનાં વિચારં કરિષ્યધ્વે|</para>
  <para style="p">
    <verse number="31" style="v"/>અપરં પ્રભુરુવાચ, હે શિમોન્ પશ્ય તિતઉના ધાન્યાનીવ યુષ્માન્ શૈતાન્ ચાલયિતુમ્ ઐચ્છત્,</para>
  <para style="p">
    <verse number="32" style="v"/>કિન્તુ તવ વિશ્વાસસ્ય લોપો યથા ન ભવતિ એતત્ ત્વદર્થં પ્રાર્થિતં મયા, ત્વન્મનસિ પરિવર્ત્તિતે ચ ભ્રાતૃણાં મનાંસિ સ્થિરીકુરુ|</para>
  <para style="p">
    <verse number="33" style="v"/>તદા સોવદત્, હે પ્રભોહં ત્વયા સાર્દ્ધં કારાં મૃતિઞ્ચ યાતું મજ્જિતોસ્મિ|</para>
  <para style="p">
    <verse number="34" style="v"/>તતઃ સ ઉવાચ, હે પિતર ત્વાં વદામિ, અદ્ય કુક્કુટરવાત્ પૂર્વ્વં ત્વં મત્પરિચયં વારત્રયમ્ અપહ્વોષ્યસે|</para>
  <para style="p">
    <verse number="35" style="v"/>અપરં સ પપ્રચ્છ, યદા મુદ્રાસમ્પુટં ખાદ્યપાત્રં પાદુકાઞ્ચ વિના યુષ્માન્ પ્રાહિણવં તદા યુષ્માકં કસ્યાપિ ન્યૂનતાસીત્? તે પ્રોચુઃ કસ્યાપિ ન|</para>
  <para style="p">
    <verse number="36" style="v"/>તદા સોવદત્ કિન્ત્વિદાનીં મુદ્રાસમ્પુટં ખાદ્યપાત્રં વા યસ્યાસ્તિ તેન તદ્ગ્રહીતવ્યં, યસ્ય ચ કૃપાણોे નાસ્તિ તેન સ્વવસ્ત્રં વિક્રીય સ ક્રેતવ્યઃ|</para>
  <para style="p">
    <verse number="37" style="v"/>યતો યુષ્માનહં વદામિ, અપરાધિજનૈઃ સાર્દ્ધં ગણિતઃ સ ભવિષ્યતિ| ઇદં યચ્છાસ્ત્રીયં વચનં લિખિતમસ્તિ તન્મયિ ફલિષ્યતિ યતો મમ સમ્બન્ધીયં સર્વ્વં સેત્સ્યતિ|</para>
  <para style="p">
    <verse number="38" style="v"/>તદા તે પ્રોચુઃ પ્રભો પશ્ય ઇમૌ કૃપાણૌ| તતઃ સોવદદ્ એતૌ યથેષ્ટૌ|</para>
  <para style="p">
    <verse number="39" style="v"/>અથ સ તસ્માદ્વહિ ર્ગત્વા સ્વાચારાનુસારેણ જૈતુનનામાદ્રિં જગામ શિષ્યાશ્ચ તત્પશ્ચાદ્ યયુઃ|</para>
  <para style="p">
    <verse number="40" style="v"/>તત્રોપસ્થાય સ તાનુવાચ, યથા પરીક્ષાયાં ન પતથ તદર્થં પ્રાર્થયધ્વં|</para>
  <para style="p">
    <verse number="41" style="v"/>પશ્ચાત્ સ તસ્માદ્ એકશરક્ષેપાદ્ બહિ ર્ગત્વા જાનુની પાતયિત્વા એતત્ પ્રાર્થયાઞ્ચક્રે,</para>
  <para style="p">
    <verse number="42" style="v"/>હે પિત ર્યદિ ભવાન્ સમ્મન્યતે તર્હિ કંસમેનં મમાન્તિકાદ્ દૂરય કિન્તુ મદિચ્છાનુરૂપં ન ત્વદિચ્છાનુરૂપં ભવતુ|</para>
  <para style="p">
    <verse number="43" style="v"/>તદા તસ્મૈ શક્તિં દાતું સ્વર્ગીયદૂતો દર્શનં દદૌ|</para>
  <para style="p">
    <verse number="44" style="v"/>પશ્ચાત્ સોત્યન્તં યાતનયા વ્યાકુલો ભૂત્વા પુનર્દૃઢં પ્રાર્થયાઞ્ચક્રે, તસ્માદ્ બૃહચ્છોણિતબિન્દવ ઇવ તસ્ય સ્વેદબિન્દવઃ પૃથિવ્યાં પતિતુમારેભિરે|</para>
  <para style="p">
    <verse number="45" style="v"/>અથ પ્રાર્થનાત ઉત્થાય શિષ્યાણાં સમીપમેત્ય તાન્ મનોદુઃખિનો નિદ્રિતાન્ દૃષ્ટ્વાવદત્</para>
  <para style="p">
    <verse number="46" style="v"/>કુતો નિદ્રાથ? પરીક્ષાયામ્ અપતનાર્થં પ્રર્થયધ્વં|</para>
  <para style="p">
    <verse number="47" style="v"/>એતત્કથાયાઃ કથનકાલે દ્વાદશશિષ્યાણાં મધ્યે ગણિતો યિહૂદાનામા જનતાસહિતસ્તેષામ્ અગ્રે ચલિત્વા યીશોશ્ચુમ્બનાર્થં તદન્તિકમ્ આયયૌ|</para>
  <para style="p">
    <verse number="48" style="v"/>તદા યીશુરુવાચ, હે યિહૂદા કિં ચુમ્બનેન મનુષ્યપુત્રં પરકરેષુ સમર્પયસિ?</para>
  <para style="p">
    <verse number="49" style="v"/>તદા યદ્યદ્ ઘટિષ્યતે તદનુમાય સઙ્ગિભિરુક્તં, હે પ્રભો વયં કિ ખઙ્ગેન ઘાતયિષ્યામઃ?</para>
  <para style="p">
    <verse number="50" style="v"/>તત એકઃ કરવાલેનાહત્ય પ્રધાનયાજકસ્ય દાસસ્ય દક્ષિણં કર્ણં ચિચ્છેદ|</para>
  <para style="p">
    <verse number="51" style="v"/>અધૂના નિવર્ત્તસ્વ ઇત્યુક્ત્વા યીશુસ્તસ્ય શ્રુતિં સ્પૃષ્ટ્વા સ્વસ્યં ચકાર|</para>
  <para style="p">
    <verse number="52" style="v"/>પશ્ચાદ્ યીશુઃ સમીપસ્થાન્ પ્રધાનયાજકાન્ મન્દિરસ્ય સેનાપતીન્ પ્રાચીનાંશ્ચ જગાદ, યૂયં કૃપાણાન્ યષ્ટીંશ્ચ ગૃહીત્વા માં કિં ચોરં ધર્ત્તુમાયાતાઃ?</para>
  <para style="p">
    <verse number="53" style="v"/>યદાહં યુષ્માભિઃ સહ પ્રતિદિનં મન્દિરેઽતિષ્ઠં તદા માં ધર્ત્તં ન પ્રવૃત્તાઃ, કિન્ત્વિદાનીં યુષ્માકં સમયોન્ધકારસ્ય ચાધિપત્યમસ્તિ|</para>
  <para style="p">
    <verse number="54" style="v"/>અથ તે તં ધૃત્વા મહાયાજકસ્ય નિવેશનં નિન્યુઃ| તતઃ પિતરો દૂરે દૂરે પશ્ચાદિત્વા</para>
  <para style="p">
    <verse number="55" style="v"/>બૃહત્કોષ્ઠસ્ય મધ્યે યત્રાગ્નિં જ્વાલયિત્વા લોકાઃ સમેત્યોપવિષ્ટાસ્તત્ર તૈઃ સાર્દ્ધમ્ ઉપવિવેશ|</para>
  <para style="p">
    <verse number="56" style="v"/>અથ વહ્નિસન્નિધૌ સમુપવેશકાલે કાચિદ્દાસી મનો નિવિશ્ય તં નિરીક્ષ્યાવદત્ પુમાનયં તસ્ય સઙ્ગેઽસ્થાત્|</para>
  <para style="p">
    <verse number="57" style="v"/>કિન્તુ સ તદ્ અપહ્નુત્યાવાદીત્ હે નારિ તમહં ન પરિચિનોમિ|</para>
  <para style="p">
    <verse number="58" style="v"/>ક્ષણાન્તરેઽન્યજનસ્તં દૃષ્ટ્વાબ્રવીત્ ત્વમપિ તેષાં નિકરસ્યૈકજનોસિ| પિતરઃ પ્રત્યુવાચ હે નર નાહમસ્મિ|</para>
  <para style="p">
    <verse number="59" style="v"/>તતઃ સાર્દ્ધદણ્ડદ્વયાત્ પરં પુનરન્યો જનો નિશ્ચિત્ય બભાષે, એષ તસ્ય સઙ્ગીતિ સત્યં યતોયં ગાલીલીયો લોકઃ|</para>
  <para style="p">
    <verse number="60" style="v"/>તદા પિતર ઉવાચ હે નર ત્વં યદ્ વદમિ તદહં બોદ્ધું ન શક્નોમિ, ઇતિ વાક્યે કથિતમાત્રે કુક્કુટો રુરાવ|</para>
  <para style="p">
    <verse number="61" style="v"/>તદા પ્રભુણા વ્યાધુટ્ય પિતરે નિરીક્ષિતે કૃકવાકુરવાત્ પૂર્વ્વં માં ત્રિરપહ્નોષ્યસે ઇતિ પૂર્વ્વોક્તં તસ્ય વાક્યં પિતરઃ સ્મૃત્વા</para>
  <para style="p">
    <verse number="62" style="v"/>બહિર્ગત્વા મહાખેદેન ચક્રન્દ|</para>
  <para style="p">
    <verse number="63" style="v"/>તદા યૈ ર્યીશુર્ધૃતસ્તે તમુપહસ્ય પ્રહર્ત્તુમારેભિરે|</para>
  <para style="p">
    <verse number="64" style="v"/>વસ્ત્રેણ તસ્ય દૃશૌ બદ્ધ્વા કપોલે ચપેટાઘાતં કૃત્વા પપ્રચ્છુઃ, કસ્તે કપોલે ચપેટાઘાતં કૃતવાન? ગણયિત્વા તદ્ વદ|</para>
  <para style="p">
    <verse number="65" style="v"/>તદન્યત્ તદ્વિરુદ્ધં બહુનિન્દાવાક્યં વક્તુમારેભિરે|</para>
  <para style="p">
    <verse number="66" style="v"/>અથ પ્રભાતે સતિ લોકપ્રાઞ્ચઃ પ્રધાનયાજકા અધ્યાપકાશ્ચ સભાં કૃત્વા મધ્યેસભં યીશુમાનીય પપ્રચ્છુઃ, ત્વમ્ અભિષિકતોસિ ન વાસ્માન્ વદ|</para>
  <para style="p">
    <verse number="67" style="v"/>સ પ્રત્યુવાચ, મયા તસ્મિન્નુક્તેઽપિ યૂયં ન વિશ્વસિષ્યથ|</para>
  <para style="p">
    <verse number="68" style="v"/>કસ્મિંશ્ચિદ્વાક્યે યુષ્માન્ પૃષ્ટેઽપિ માં ન તદુત્તરં વક્ષ્યથ ન માં ત્યક્ષ્યથ ચ|</para>
  <para style="p">
    <verse number="69" style="v"/>કિન્ત્વિતઃ પરં મનુજસુતઃ સર્વ્વશક્તિમત ઈશ્વરસ્ય દક્ષિણે પાર્શ્વે સમુપવેક્ષ્યતિ|</para>
  <para style="p">
    <verse number="70" style="v"/>તતસ્તે પપ્રચ્છુઃ, ર્તિહ ત્વમીશ્વરસ્ય પુત્રઃ? સ કથયામાસ, યૂયં યથાર્થં વદથ સ એવાહં|</para>
  <para style="p">
    <verse number="71" style="v"/>તદા તે સર્વ્વે કથયામાસુઃ, ર્તિહ સાક્ષ્યેઽન્સસ્મિન્ અસ્માકં કિં પ્રયોજનં? અસ્ય સ્વમુખાદેવ સાક્ષ્યં પ્રાપ્તમ્|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તતઃ સભાસ્થાઃ સર્વ્વલોકા ઉત્થાય તં પીલાતસમ્મુખં નીત્વાપ્રોદ્ય વક્તુમારેભિરે,</para>
  <para style="p">
    <verse number="2" style="v"/>સ્વમભિષિક્તં રાજાનં વદન્તં કૈમરરાજાય કરદાનં નિષેધન્તં રાજ્યવિપર્ય્યયં કુર્ત્તું પ્રવર્ત્તમાનમ્ એન પ્રાપ્તા વયં|</para>
  <para style="p">
    <verse number="3" style="v"/>તદા પીલાતસ્તં પૃષ્ટવાન્ ત્વં કિં યિહૂદીયાનાં રાજા? સ પ્રત્યુવાચ ત્વં સત્યમુક્તવાન્|</para>
  <para style="p">
    <verse number="4" style="v"/>તદા પીલાતઃ પ્રધાનયાજકાદિલોકાન્ જગાદ્, અહમેતસ્ય કમપ્યપરાધં નાપ્તવાન્|</para>
  <para style="p">
    <verse number="5" style="v"/>તતસ્તે પુનઃ સાહમિનો ભૂત્વાવદન્, એષ ગાલીલ એતત્સ્થાનપર્ય્યન્તે સર્વ્વસ્મિન્ યિહૂદાદેશે સર્વ્વાલ્લોકાનુપદિશ્ય કુપ્રવૃત્તિં ગ્રાહીતવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>તદા પીલાતો ગાલીલપ્રદેશસ્ય નામ શ્રુત્વા પપ્રચ્છ, કિમયં ગાલીલીયો લોકઃ?</para>
  <para style="p">
    <verse number="7" style="v"/>તતઃ સ ગાલીલ્પ્રદેશીયહેરોદ્રાજસ્ય તદા સ્થિતેસ્તસ્ય સમીપે યીશું પ્રેષયામાસ|</para>
  <para style="p">
    <verse number="8" style="v"/>તદા હેરોદ્ યીશું વિલોક્ય સન્તુતોષ, યતઃ સ તસ્ય બહુવૃત્તાન્તશ્રવણાત્ તસ્ય કિઞિ्ચદાશ્ચર્ય્યકર્મ્મ પશ્યતિ ઇત્યાશાં કૃત્વા બહુકાલમારભ્ય તં દ્રષ્ટું પ્રયાસં કૃતવાન્|</para>
  <para style="p">
    <verse number="9" style="v"/>તસ્માત્ તં બહુકથાઃ પપ્રચ્છ કિન્તુ સ તસ્ય કસ્યાપિ વાક્યસ્ય પ્રત્યુત્તરં નોવાચ|</para>
  <para style="p">
    <verse number="10" style="v"/>અથ પ્રધાનયાજકા અધ્યાપકાશ્ચ પ્રોત્તિષ્ઠન્તઃ સાહસેન તમપવદિતું પ્રારેભિરે|</para>
  <para style="p">
    <verse number="11" style="v"/>હેરોદ્ તસ્ય સેનાગણશ્ચ તમવજ્ઞાય ઉપહાસત્વેન રાજવસ્ત્રં પરિધાપ્ય પુનઃ પીલાતં પ્રતિ તં પ્રાહિણોત્|</para>
  <para style="p">
    <verse number="12" style="v"/>પૂર્વ્વં હેરોદ્પીલાતયોઃ પરસ્પરં વૈરભાવ આસીત્ કિન્તુ તદ્દિને દ્વયો ર્મેલનં જાતમ્|</para>
  <para style="p">
    <verse number="13" style="v"/>પશ્ચાત્ પીલાતઃ પ્રધાનયાજકાન્ શાસકાન્ લોકાંશ્ચ યુગપદાહૂય બભાષે,</para>
  <para style="p">
    <verse number="14" style="v"/>રાજ્યવિપર્ય્યયકારકોયમ્ ઇત્યુક્ત્વા મનુષ્યમેનં મમ નિકટમાનૈષ્ટ કિન્તુ પશ્યત યુષ્માકં સમક્ષમ્ અસ્ય વિચારં કૃત્વાપિ પ્રોક્તાપવાદાનુરૂપેણાસ્ય કોપ્યપરાધઃ સપ્રમાણો ન જાતઃ,</para>
  <para style="p">
    <verse number="15" style="v"/>યૂયઞ્ચ હેરોદઃ સન્નિધૌ પ્રેષિતા મયા તત્રાસ્ય કોપ્યપરાધસ્તેનાપિ ન પ્રાપ્તઃ| પશ્યતાનેન વધહેेતુકં કિમપિ નાપરાદ્ધં|</para>
  <para style="p">
    <verse number="16" style="v"/>તસ્માદેનં તાડયિત્વા વિહાસ્યામિ|</para>
  <para style="p">
    <verse number="17" style="v"/>તત્રોત્સવે તેષામેકો મોચયિતવ્યઃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ઇતિ હેતોસ્તે પ્રોચ્ચૈરેકદા પ્રોચુઃ, એનં દૂરીકૃત્ય બરબ્બાનામાનં મોચય|</para>
  <para style="p">
    <verse number="19" style="v"/>સ બરબ્બા નગર ઉપપ્લવવધાપરાધાભ્યાં કારાયાં બદ્ધ આસીત્|</para>
  <para style="p">
    <verse number="20" style="v"/>કિન્તુ પીલાતો યીશું મોચયિતું વાઞ્છન્ પુનસ્તાનુવાચ|</para>
  <para style="p">
    <verse number="21" style="v"/>તથાપ્યેનં ક્રુશે વ્યધ ક્રુશે વ્યધેતિ વદન્તસ્તે રુરુવુઃ|</para>
  <para style="p">
    <verse number="22" style="v"/>તતઃ સ તૃતીયવારં જગાદ કુતઃ? સ કિં કર્મ્મ કૃતવાન્? નાહમસ્ય કમપિ વધાપરાધં પ્રાપ્તઃ કેવલં તાડયિત્વામું ત્યજામિ|</para>
  <para style="p">
    <verse number="23" style="v"/>તથાપિ તે પુનરેનં ક્રુશે વ્યધ ઇત્યુક્ત્વા પ્રોચ્ચૈર્દૃઢં પ્રાર્થયાઞ્ચક્રિરે;</para>
  <para style="p">
    <verse number="24" style="v"/>તતઃ પ્રધાનયાજકાદીનાં કલરવે પ્રબલે સતિ તેષાં પ્રાર્થનારૂપં કર્ત્તું પીલાત આદિદેશ|</para>
  <para style="p">
    <verse number="25" style="v"/>રાજદ્રોહવધયોરપરાધેન કારાસ્થં યં જનં તે યયાચિરે તં મોચયિત્વા યીશું તેષામિચ્છાયાં સમાર્પયત્|</para>
  <para style="p">
    <verse number="26" style="v"/>અથ તે યીશું ગૃહીત્વા યાન્તિ, એતર્હિ ગ્રામાદાગતં શિમોનનામાનં કુરીણીયં જનં ધૃત્વા યીશોઃ પશ્ચાન્નેતું તસ્ય સ્કન્ધે ક્રુશમર્પયામાસુઃ|</para>
  <para style="p">
    <verse number="27" style="v"/>તતો લોाકારણ્યમધ્યે બહુસ્ત્રિયો રુદત્યો વિલપન્ત્યશ્ચ યીશોઃ પશ્ચાદ્ યયુઃ|</para>
  <para style="p">
    <verse number="28" style="v"/>કિન્તુ સ વ્યાઘુટ્ય તા ઉવાચ, હે યિરૂશાલમો નાર્ય્યો યુયં મદર્થં ન રુદિત્વા સ્વાર્થં સ્વાપત્યાર્થઞ્ચ રુદિતિ;</para>
  <para style="p">
    <verse number="29" style="v"/>પશ્યત યઃ કદાપિ ગર્ભવત્યો નાભવન્ સ્તન્યઞ્ચ નાપાયયન્ તાદૃશી ર્વન્ધ્યા યદા ધન્યા વક્ષ્યન્તિ સ કાલ આયાતિ|</para>
  <para style="p">
    <verse number="30" style="v"/>તદા હે શૈલા અસ્માકમુપરિ પતત, હે ઉપશૈલા અસ્માનાચ્છાદયત કથામીદૃશીં લોકા વક્ષ્યન્તિ|</para>
  <para style="p">
    <verse number="31" style="v"/>યતઃ સતેજસિ શાખિનિ ચેદેતદ્ ઘટતે તર્હિ શુષ્કશાખિનિ કિં ન ઘટિષ્યતે?</para>
  <para style="p">
    <verse number="32" style="v"/>તદા તે હન્તું દ્વાવપરાધિનૌ તેન સાર્દ્ધં નિન્યુઃ|</para>
  <para style="p">
    <verse number="33" style="v"/>અપરં શિરઃકપાલનામકસ્થાનં પ્રાપ્ય તં ક્રુશે વિવિધુઃ; તદ્દ્વયોરપરાધિનોરેકં તસ્ય દક્ષિણો તદન્યં વામે ક્રુશે વિવિધુઃ|</para>
  <para style="p">
    <verse number="34" style="v"/>તદા યીશુરકથયત્, હે પિતરેતાન્ ક્ષમસ્વ યત એતે યત્ કર્મ્મ કુર્વ્વન્તિ તન્ ન વિદુઃ; પશ્ચાત્તે ગુટિકાપાતં કૃત્વા તસ્ય વસ્ત્રાણિ વિભજ્ય જગૃહુઃ|</para>
  <para style="p">
    <verse number="35" style="v"/>તત્ર લોકસંઘસ્તિષ્ઠન્ દદર્શ; તે તેષાં શાસકાશ્ચ તમુપહસ્ય જગદુઃ, એષ ઇતરાન્ રક્ષિતવાન્ યદીશ્વરેણાભિરુચિતો ઽભિષિક્તસ્ત્રાતા ભવતિ તર્હિ સ્વમધુના રક્ષતુ|</para>
  <para style="p">
    <verse number="36" style="v"/>તદન્યઃ સેનાગણા એત્ય તસ્મૈ અમ્લરસં દત્વા પરિહસ્ય પ્રોવાચ,</para>
  <para style="p">
    <verse number="37" style="v"/>ચેત્ત્વં યિહૂદીયાનાં રાજાસિ તર્હિ સ્વં રક્ષ|</para>
  <para style="p">
    <verse number="38" style="v"/>યિહૂદીયાનાં રાજેતિ વાક્યં યૂનાનીયરોમીયેબ્રીયાક્ષરૈ ર્લિખિતં તચ્છિરસ ઊર્દ્ધ્વેઽસ્થાપ્યત|</para>
  <para style="p">
    <verse number="39" style="v"/>તદોભયપાર્શ્વયો ર્વિદ્ધૌ યાવપરાધિનૌ તયોરેકસ્તં વિનિન્દ્ય બભાષે, ચેત્ત્વમ્ અભિષિક્તોસિ તર્હિ સ્વમાવાઞ્ચ રક્ષ|</para>
  <para style="p">
    <verse number="40" style="v"/>કિન્ત્વન્યસ્તં તર્જયિત્વાવદત્, ઈશ્વરાત્તવ કિઞ્ચિદપિ ભયં નાસ્તિ કિં? ત્વમપિ સમાનદણ્ડોસિ,</para>
  <para style="p">
    <verse number="41" style="v"/>યોગ્યપાત્રે આવાં સ્વસ્વકર્મ્મણાં સમુચિતફલં પ્રાપ્નુવઃ કિન્ત્વનેન કિમપિ નાપરાદ્ધં|</para>
  <para style="p">
    <verse number="42" style="v"/>અથ સ યીશું જગાદ હે પ્રભે ભવાન્ સ્વરાજ્યપ્રવેશકાલે માં સ્મરતુ|</para>
  <para style="p">
    <verse number="43" style="v"/>તદા યીશુઃ કથિતવાન્ ત્વાં યથાર્થં વદામિ ત્વમદ્યૈવ મયા સાર્દ્ધં પરલોકસ્ય સુખસ્થાનં પ્રાપ્સ્યસિ|</para>
  <para style="p">
    <verse number="44" style="v"/>અપરઞ્ચ દ્વિતીયયામાત્ તૃતીયયામપર્ય્યન્તં રવેસ્તેજસોન્તર્હિતત્વાત્ સર્વ્વદેશોઽન્ધકારેણાવૃતો</para>
  <para style="p">
    <verse number="45" style="v"/>મન્દિરસ્ય યવનિકા ચ છિદ્યમાના દ્વિધા બભૂવ|</para>
  <para style="p">
    <verse number="46" style="v"/>તતો યીશુરુચ્ચૈરુવાચ, હે પિત ર્મમાત્માનં તવ કરે સમર્પયે, ઇત્યુક્ત્વા સ પ્રાણાન્ જહૌ|</para>
  <para style="p">
    <verse number="47" style="v"/>તદૈતા ઘટના દૃષ્ટ્વા શતસેનાપતિરીશ્વરં ધન્યમુક્ત્વા કથિતવાન્ અયં નિતાન્તં સાધુમનુષ્ય આસીત્|</para>
  <para style="p">
    <verse number="48" style="v"/>અથ યાવન્તો લોકા દ્રષ્ટુમ્ આગતાસ્તે તા ઘટના દૃષ્ટ્વા વક્ષઃસુ કરાઘાતં કૃત્વા વ્યાચુટ્ય ગતાઃ|</para>
  <para style="p">
    <verse number="49" style="v"/>યીશો ર્જ્ઞાતયો યા યા યોષિતશ્ચ ગાલીલસ્તેન સાર્દ્ધમાયાતાસ્તા અપિ દૂરે સ્થિત્વા તત્ સર્વ્વં દદૃશુઃ|</para>
  <para style="p">
    <verse number="50" style="v"/>તદા યિહૂદીયાનાં મન્ત્રણાં ક્રિયાઞ્ચાસમ્મન્યમાન ઈશ્વરસ્ય રાજત્વમ્ અપેક્ષમાણો</para>
  <para style="p">
    <verse number="51" style="v"/>યિહૂદિદેશીયો ઽરિમથીયનગરીયો યૂષફ્નામા મન્ત્રી ભદ્રો ધાર્મ્મિકશ્ચ પુમાન્</para>
  <para style="p">
    <verse number="52" style="v"/>પીલાતાન્તિકં ગત્વા યીશો ર્દેહં યયાચે|</para>
  <para style="p">
    <verse number="53" style="v"/>પશ્ચાદ્ વપુરવરોહ્ય વાસસા સંવેષ્ટ્ય યત્ર કોપિ માનુષો નાસ્થાપ્યત તસ્મિન્ શૈલે સ્વાતે શ્મશાને તદસ્થાપયત્|</para>
  <para style="p">
    <verse number="54" style="v"/>તદ્દિનમાયોજનીયં દિનં વિશ્રામવારશ્ચ સમીપઃ|</para>
  <para style="p">
    <verse number="55" style="v"/>અપરં યીશુના સાર્દ્ધં ગાલીલ આગતા યોષિતઃ પશ્ચાદિત્વા શ્મશાને તત્ર યથા વપુઃ સ્થાપિતં તચ્ચ દૃષ્ટ્વા</para>
  <para style="p">
    <verse number="56" style="v"/>વ્યાઘુટ્ય સુગન્ધિદ્રવ્યતૈલાનિ કૃત્વા વિધિવદ્ વિશ્રામવારે વિશ્રામં ચક્રુઃ|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અથ સપ્તાહપ્રથમદિનેઽતિપ્રત્યૂષે તા યોષિતઃ સમ્પાદિતં સુગન્ધિદ્રવ્યં ગૃહીત્વા તદન્યાભિઃ કિયતીભિઃ સ્ત્રીભિઃ સહ શ્મશાનં યયુઃ|</para>
  <para style="p">
    <verse number="2" style="v"/>કિન્તુ શ્મશાનદ્વારાત્ પાષાણમપસારિતં દૃષ્ટ્વા</para>
  <para style="p">
    <verse number="3" style="v"/>તાઃ પ્રવિશ્ય પ્રભો ર્દેહમપ્રાપ્ય</para>
  <para style="p">
    <verse number="4" style="v"/>વ્યાકુલા ભવન્તિ એતર્હિ તેજોમયવસ્ત્રાન્વિતૌ દ્વૌ પુરુષૌ તાસાં સમીપે સમુપસ્થિતૌ</para>
  <para style="p">
    <verse number="5" style="v"/>તસ્માત્તાઃ શઙ્કાયુક્તા ભૂમાવધોમુખ્યસ્યસ્થુઃ| તદા તૌ તા ઊચતુ ર્મૃતાનાં મધ્યે જીવન્તં કુતો મૃગયથ?</para>
  <para style="p">
    <verse number="6" style="v"/>સોત્ર નાસ્તિ સ ઉદસ્થાત્|</para>
  <para style="p">
    <verse number="7" style="v"/>પાપિનાં કરેષુ સમર્પિતેન ક્રુશે હતેન ચ મનુષ્યપુત્રેણ તૃતીયદિવસે શ્મશાનાદુત્થાતવ્યમ્ ઇતિ કથાં સ ગલીલિ તિષ્ઠન્ યુષ્મભ્યં કથિતવાન્ તાં સ્મરત|</para>
  <para style="p">
    <verse number="8" style="v"/>તદા તસ્ય સા કથા તાસાં મનઃસુ જાતા|</para>
  <para style="p">
    <verse number="9" style="v"/>અનન્તરં શ્મશાનાદ્ ગત્વા તા એકાદશશિષ્યાદિભ્યઃ સર્વ્વેભ્યસ્તાં વાર્ત્તાં કથયામાસુઃ|</para>
  <para style="p">
    <verse number="10" style="v"/>મગ્દલીનીમરિયમ્, યોહના, યાકૂબો માતા મરિયમ્ તદન્યાઃ સઙ્ગિન્યો યોષિતશ્ચ પ્રેરિતેભ્ય એતાઃ સર્વ્વા વાર્ત્તાઃ કથયામાસુઃ</para>
  <para style="p">
    <verse number="11" style="v"/>કિન્તુ તાસાં કથામ્ અનર્થકાખ્યાનમાત્રં બુદ્ધ્વા કોપિ ન પ્રત્યૈત્|</para>
  <para style="p">
    <verse number="12" style="v"/>તદા પિતર ઉત્થાય શ્મશાનાન્તિકં દધાવ, તત્ર ચ પ્રહ્વો ભૂત્વા પાર્શ્વૈકસ્થાપિતં કેવલં વસ્ત્રં દદર્શ; તસ્માદાશ્ચર્ય્યં મન્યમાનો યદઘટત તન્મનસિ વિચારયન્ પ્રતસ્થે|</para>
  <para style="p">
    <verse number="13" style="v"/>તસ્મિન્નેવ દિને દ્વૌ શિય્યૌ યિરૂશાલમશ્ચતુષ્ક્રોશાન્તરિતમ્ ઇમ્માયુગ્રામં ગચ્છન્તૌ</para>
  <para style="p">
    <verse number="14" style="v"/>તાસાં ઘટનાનાં કથામકથયતાં</para>
  <para style="p">
    <verse number="15" style="v"/>તયોરાલાપવિચારયોઃ કાલે યીશુરાગત્ય તાભ્યાં સહ જગામ</para>
  <para style="p">
    <verse number="16" style="v"/>કિન્તુ યથા તૌ તં ન પરિચિનુતસ્તદર્થં તયો ર્દૃષ્ટિઃ સંરુદ્ધા|</para>
  <para style="p">
    <verse number="17" style="v"/>સ તૌ પૃષ્ટવાન્ યુવાં વિષણ્ણૌ કિં વિચારયન્તૌ ગચ્છથઃ?</para>
  <para style="p">
    <verse number="18" style="v"/>તતસ્તયોઃ ક્લિયપાનામા પ્રત્યુવાચ યિરૂશાલમપુરેઽધુના યાન્યઘટન્ત ત્વં કેવલવિદેશી કિં તદ્વૃત્તાન્તં ન જાનાસિ?</para>
  <para style="p">
    <verse number="19" style="v"/>સ પપ્રચ્છ કા ઘટનાઃ? તદા તૌ વક્તુમારેભાતે યીશુનામા યો નાસરતીયો ભવિષ્યદ્વાદી ઈશ્વરસ્ય માનુષાણાઞ્ચ સાક્ષાત્ વાક્યે કર્મ્મણિ ચ શક્તિમાનાસીત્</para>
  <para style="p">
    <verse number="20" style="v"/>તમ્ અસ્માકં પ્રધાનયાજકા વિચારકાશ્ચ કેનાપિ પ્રકારેણ ક્રુશે વિદ્ધ્વા તસ્ય પ્રાણાનનાશયન્ તદીયા ઘટનાઃ;</para>
  <para style="p">
    <verse number="21" style="v"/>કિન્તુ ય ઇસ્રાયેલીયલોકાન્ ઉદ્ધારયિષ્યતિ સ એવાયમ્ ઇત્યાશાસ્માભિઃ કૃતા| તદ્યથા તથાસ્તુ તસ્યા ઘટનાયા અદ્ય દિનત્રયં ગતં|</para>
  <para style="p">
    <verse number="22" style="v"/>અધિકન્ત્વસ્માકં સઙ્ગિનીનાં કિયત્સ્ત્રીણાં મુખેભ્યોઽસમ્ભવવાક્યમિદં શ્રુતં;</para>
  <para style="p">
    <verse number="23" style="v"/>તાઃ પ્રત્યૂષે શ્મશાનં ગત્વા તત્ર તસ્ય દેહમ્ અપ્રાપ્ય વ્યાઘુટ્યેત્વા પ્રોક્તવત્યઃ સ્વર્ગીસદૂતૌ દૃષ્ટાવસ્માભિસ્તૌ ચાવાદિષ્ટાં સ જીવિતવાન્|</para>
  <para style="p">
    <verse number="24" style="v"/>તતોસ્માકં કૈશ્ચિત્ શ્મશાનમગમ્યત તેઽપિ સ્ત્રીણાં વાક્યાનુરૂપં દૃષ્ટવન્તઃ કિન્તુ તં નાપશ્યન્|</para>
  <para style="p">
    <verse number="25" style="v"/>તદા સ તાવુવાચ, હે અબોધૌ હે ભવિષ્યદ્વાદિભિરુક્તવાક્યં પ્રત્યેતું વિલમ્બમાનૌ;</para>
  <para style="p">
    <verse number="26" style="v"/>એતત્સર્વ્વદુઃખં ભુક્ત્વા સ્વભૂતિપ્રાપ્તિઃ કિં ખ્રીષ્ટસ્ય ન ન્યાય્યા?</para>
  <para style="p">
    <verse number="27" style="v"/>તતઃ સ મૂસાગ્રન્થમારભ્ય સર્વ્વભવિષ્યદ્વાદિનાં સર્વ્વશાસ્ત્રે સ્વસ્મિન્ લિખિતાખ્યાનાભિપ્રાયં બોધયામાસ|</para>
  <para style="p">
    <verse number="28" style="v"/>અથ ગમ્યગ્રામાભ્યર્ણં પ્રાપ્ય તેનાગ્રે ગમનલક્ષણે દર્શિતે</para>
  <para style="p">
    <verse number="29" style="v"/>તૌ સાધયિત્વાવદતાં સહાવાભ્યાં તિષ્ઠ દિને ગતે સતિ રાત્રિરભૂત્; તતઃ સ તાભ્યાં સાર્દ્ધં સ્થાતું ગૃહં યયૌ|</para>
  <para style="p">
    <verse number="30" style="v"/>પશ્ચાદ્ભોજનોપવેશકાલે સ પૂપં ગૃહીત્વા ઈશ્વરગુણાન્ જગાદ તઞ્ચ ભંક્ત્વા તાભ્યાં દદૌ|</para>
  <para style="p">
    <verse number="31" style="v"/>તદા તયો ર્દૃષ્ટૌ પ્રસન્નાયાં તં પ્રત્યભિજ્ઞતુઃ કિન્તુ સ તયોઃ સાક્ષાદન્તર્દધે|</para>
  <para style="p">
    <verse number="32" style="v"/>તતસ્તૌ મિથોભિધાતુમ્ આરબ્ધવન્તૌ ગમનકાલે યદા કથામકથયત્ શાસ્ત્રાર્થઞ્ચબોધયત્ તદાવયો ર્બુદ્ધિઃ કિં ન પ્રાજ્વલત્?</para>
  <para style="p">
    <verse number="33" style="v"/>તૌ તત્ક્ષણાદુત્થાય યિરૂશાલમપુરં પ્રત્યાયયતુઃ, તત્સ્થાને શિષ્યાણામ્ એકાદશાનાં સઙ્ગિનાઞ્ચ દર્શનં જાતં|</para>
  <para style="p">
    <verse number="34" style="v"/>તે પ્રોચુઃ પ્રભુરુદતિષ્ઠદ્ ઇતિ સત્યં શિમોને દર્શનમદાચ્ચ|</para>
  <para style="p">
    <verse number="35" style="v"/>તતઃ પથઃ સર્વ્વઘટનાયાઃ પૂપભઞ્જનેન તત્પરિચયસ્ય ચ સર્વ્વવૃત્તાન્તં તૌ વક્તુમારેભાતે|</para>
  <para style="p">
    <verse number="36" style="v"/>ઇત્થં તે પરસ્પરં વદન્તિ તત્કાલે યીશુઃ સ્વયં તેષાં મધ્ય પ્રોત્થય યુષ્માકં કલ્યાણં ભૂયાદ્ ઇત્યુવાચ,</para>
  <para style="p">
    <verse number="37" style="v"/>કિન્તુ ભૂતં પશ્યામ ઇત્યનુમાય તે સમુદ્વિવિજિરે ત્રેષુશ્ચ|</para>
  <para style="p">
    <verse number="38" style="v"/>સ ઉવાચ, કુતો દુઃખિતા ભવથ? યુષ્માકં મનઃસુ સન્દેહ ઉદેતિ ચ કુતઃ?</para>
  <para style="p">
    <verse number="39" style="v"/>એષોહં, મમ કરૌ પશ્યત વરં સ્પૃષ્ટ્વા પશ્યત, મમ યાદૃશાનિ પશ્યથ તાદૃશાનિ ભૂતસ્ય માંસાસ્થીનિ ન સન્તિ|</para>
  <para style="p">
    <verse number="40" style="v"/>ઇત્યુક્ત્વા સ હસ્તપાદાન્ દર્શયામાસ|</para>
  <para style="p">
    <verse number="41" style="v"/>તેઽસમ્ભવં જ્ઞાત્વા સાનન્દા ન પ્રત્યયન્| તતઃ સ તાન્ પપ્રચ્છ, અત્ર યુષ્માકં સમીપે ખાદ્યં કિઞ્ચિદસ્તિ?</para>
  <para style="p">
    <verse number="42" style="v"/>તતસ્તે કિયદ્દગ્ધમત્સ્યં મધુ ચ દદુઃ</para>
  <para style="p">
    <verse number="43" style="v"/>સ તદાદાય તેષાં સાક્ષાદ્ બુભુજે</para>
  <para style="p">
    <verse number="44" style="v"/>કથયામાસ ચ મૂસાવ્યવસ્થાયાં ભવિષ્યદ્વાદિનાં ગ્રન્થેષુ ગીતપુસ્તકે ચ મયિ યાનિ સર્વ્વાણિ વચનાનિ લિખિતાનિ તદનુરૂપાણિ ઘટિષ્યન્તે યુષ્માભિઃ સાર્દ્ધં સ્થિત્વાહં યદેતદ્વાક્યમ્ અવદં તદિદાનીં પ્રત્યક્ષમભૂત્|</para>
  <para style="p">
    <verse number="45" style="v"/>અથ તેભ્યઃ શાસ્ત્રબોધાધિકારં દત્વાવદત્,</para>
  <para style="p">
    <verse number="46" style="v"/>ખ્રીષ્ટેનેત્થં મૃતિયાતના ભોક્તવ્યા તૃતીયદિને ચ શ્મશાનાદુત્થાતવ્યઞ્ચેતિ લિપિરસ્તિ;</para>
  <para style="p">
    <verse number="47" style="v"/>તન્નામ્ના યિરૂશાલમમારભ્ય સર્વ્વદેશે મનઃપરાવર્ત્તનસ્ય પાપમોચનસ્ય ચ સુસંવાદઃ પ્રચારયિતવ્યઃ,</para>
  <para style="p">
    <verse number="48" style="v"/>એષુ સર્વ્વેષુ યૂયં સાક્ષિણઃ|</para>
  <para style="p">
    <verse number="49" style="v"/>અપરઞ્ચ પશ્યત પિત્રા યત્ પ્રતિજ્ઞાતં તત્ પ્રેષયિષ્યામિ, અતએવ યાવત્કાલં યૂયં સ્વર્ગીયાં શક્તિં ન પ્રાપ્સ્યથ તાવત્કાલં યિરૂશાલમ્નગરે તિષ્ઠત|</para>
  <para style="p">
    <verse number="50" style="v"/>અથ સ તાન્ બૈથનીયાપર્ય્યન્તં નીત્વા હસ્તાવુત્તોલ્ય આશિષ વક્તુમારેભે</para>
  <para style="p">
    <verse number="51" style="v"/>આશિષં વદન્નેવ ચ તેભ્યઃ પૃથગ્ ભૂત્વા સ્વર્ગાય નીતોઽભવત્|</para>
  <para style="p">
    <verse number="52" style="v"/>તદા તે તં ભજમાના મહાનન્દેન યિરૂશાલમં પ્રત્યાજગ્મુઃ|</para>
  <para style="p">
    <verse number="53" style="v"/>તતો નિરન્તરં મન્દિરે તિષ્ઠન્ત ઈશ્વરસ્ય પ્રશંસાં ધન્યવાદઞ્ચ કર્ત્તમ્ આરેભિરે| ઇતિ||</para>
</usx>
