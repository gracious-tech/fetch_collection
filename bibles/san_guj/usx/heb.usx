<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="HEB" style="id">Sanskrit Bible (NT) in Gujarati Script (સત્યવેદઃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Hebrews</para>
  <para style="toc1">ઇબ્રિણઃ પત્રં</para>
  <para style="toc2">ઇબ્રિણઃ</para>
  <para style="toc3">ઇબ્રિણઃ</para>
  <para style="mt1">ઇબ્રિણઃ પત્રં</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>પુરા ય ઈશ્વરો ભવિષ્યદ્વાદિભિઃ પિતૃલોકેભ્યો નાનાસમયે નાનાપ્રકારં કથિતવાન્</para>
  <para style="p">
    <verse number="2" style="v"/>સ એતસ્મિન્ શેષકાલે નિજપુત્રેણાસ્મભ્યં કથિતવાન્| સ તં પુત્રં સર્વ્વાધિકારિણં કૃતવાન્ તેનૈવ ચ સર્વ્વજગન્તિ સૃષ્ટવાન્|</para>
  <para style="p">
    <verse number="3" style="v"/>સ પુત્રસ્તસ્ય પ્રભાવસ્ય પ્રતિબિમ્બસ્તસ્ય તત્ત્વસ્ય મૂર્ત્તિશ્ચાસ્તિ સ્વીયશક્તિવાક્યેન સર્વ્વં ધત્તે ચ સ્વપ્રાણૈરસ્માકં પાપમાર્જ્જનં કૃત્વા ઊર્દ્ધ્વસ્થાને મહામહિમ્નો દક્ષિણપાર્શ્વે સમુપવિષ્ટવાન્|</para>
  <para style="p">
    <verse number="4" style="v"/>દિવ્યદૂતગણાદ્ યથા સ વિશિષ્ટનામ્નો ઽધિકારી જાતસ્તથા તેભ્યોઽપિ શ્રેષ્ઠો જાતઃ|</para>
  <para style="p">
    <verse number="5" style="v"/>યતો દૂતાનાં મધ્યે કદાચિદીશ્વરેણેદં ક ઉક્તઃ? યથા, "મદીયતનયો ઽસિ ત્વમ્ અદ્યૈવ જનિતો મયા| " પુનશ્ચ "અહં તસ્ય પિતા ભવિષ્યામિ સ ચ મમ પુત્રો ભવિષ્યતિ| "</para>
  <para style="p">
    <verse number="6" style="v"/>અપરં જગતિ સ્વકીયાદ્વિતીયપુત્રસ્ય પુનરાનયનકાલે તેનોક્તં, યથા, "ઈશ્વરસ્ય સકલૈ ર્દૂતૈરેષ એવ પ્રણમ્યતાં| "</para>
  <para style="p">
    <verse number="7" style="v"/>દૂતાન્ અધિ તેનેદમ્ ઉક્તં, યથા, "સ કરોતિ નિજાન્ દૂતાન્ ગન્ધવાહસ્વરૂપકાન્| વહ્નિશિખાસ્વરૂપાંશ્ચ કરોતિ નિજસેવકાન્|| "</para>
  <para style="p">
    <verse number="8" style="v"/>કિન્તુ પુત્રમુદ્દિશ્ય તેનોક્તં, યથા, "હે ઈશ્વર સદા સ્થાયિ તવ સિંહાસનં ભવેત્| યાથાર્થ્યસ્ય ભવેદ્દણ્ડો રાજદણ્ડસ્ત્વદીયકઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>પુણ્યે પ્રેમ કરોષિ ત્વં કિઞ્ચાધર્મ્મમ્ ઋતીયસે| તસ્માદ્ ય ઈશ ઈશસ્તે સ તે મિત્રગણાદપિ| અધિકાહ્લાદતૈલેન સેચનં કૃતવાન્ તવ|| "</para>
  <para style="p">
    <verse number="10" style="v"/>પુનશ્ચ, યથા, "હે પ્રભો પૃથિવીમૂલમ્ આદૌ સંસ્થાપિતં ત્વયા| તથા ત્વદીયહસ્તેન કૃતં ગગનમણ્ડલં|</para>
  <para style="p">
    <verse number="11" style="v"/>ઇમે વિનંક્ષ્યતસ્ત્વન્તુ નિત્યમેવાવતિષ્ઠસે| ઇદન્તુ સકલં વિશ્વં સંજરિષ્યતિ વસ્ત્રવત્|</para>
  <para style="p">
    <verse number="12" style="v"/>સઙ્કોચિતં ત્વયા તત્તુ વસ્ત્રવત્ પરિવર્ત્સ્યતે| ત્વન્તુ નિત્યં સ એવાસી ર્નિરન્તાસ્તવ વત્સરાઃ|| "</para>
  <para style="p">
    <verse number="13" style="v"/>અપરં દૂતાનાં મધ્યે કઃ કદાચિદીશ્વરેણેદમુક્તઃ? યથા, "તવારીન્ પાદપીઠં તે યાવન્નહિ કરોમ્યહં| મમ દક્ષિણદિગ્ભાગે તાવત્ ત્વં સમુપાવિશ|| "</para>
  <para style="p">
    <verse number="14" style="v"/>યે પરિત્રાણસ્યાધિકારિણો ભવિષ્યન્તિ તેષાં પરિચર્ય્યાર્થં પ્રેષ્યમાણાઃ સેવનકારિણ આત્માનઃ કિં તે સર્વ્વે દૂતા નહિ?</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અતો વયં યદ્ ભ્રમસ્રોતસા નાપનીયામહે તદર્થમસ્માભિ ર્યદ્યદ્ અશ્રાવિ તસ્મિન્ મનાંસિ નિધાતવ્યાનિ|</para>
  <para style="p">
    <verse number="2" style="v"/>યતો હેતો દૂતૈઃ કથિતં વાક્યં યદ્યમોઘમ્ અભવદ્ યદિ ચ તલ્લઙ્ઘનકારિણે તસ્યાગ્રાહકાય ચ સર્વ્વસ્મૈ સમુચિતં દણ્ડમ્ અદીયત,</para>
  <para style="p">
    <verse number="3" style="v"/>તર્હ્યસ્માભિસ્તાદૃશં મહાપરિત્રાણમ્ અવજ્ઞાય કથં રક્ષા પ્રાપ્સ્યતે, યત્ પ્રથમતઃ પ્રભુના પ્રોક્તં તતોઽસ્માન્ યાવત્ તસ્ય શ્રોતૃભિઃ સ્થિરીકૃતં,</para>
  <para style="p">
    <verse number="4" style="v"/>અપરં લક્ષણૈરદ્ભુતકર્મ્મભિ ર્વિવિધશક્તિપ્રકાશેન નિજેચ્છાતઃ પવિત્રસ્યાત્મનો વિભાગેન ચ યદ્ ઈશ્વરેણ પ્રમાણીકૃતમ્ અભૂત્|</para>
  <para style="p">
    <verse number="5" style="v"/>વયં તુ યસ્ય ભાવિરાજ્યસ્ય કથાં કથયામઃ, તત્ તેન્ દિવ્યદૂતાનામ્ અધીનીકૃતમિતિ નહિ|</para>
  <para style="p">
    <verse number="6" style="v"/>કિન્તુ કુત્રાપિ કશ્ચિત્ પ્રમાણમ્ ઈદૃશં દત્તવાન્, યથા, "કિં વસ્તુ માનવો યત્ સ નિત્યં સંસ્મર્ય્યતે ત્વયા| કિં વા માનવસન્તાનો યત્ સ આલોચ્યતે ત્વયા|</para>
  <para style="p">
    <verse number="7" style="v"/>દિવ્યદતગણેભ્યઃ સ કિઞ્ચિન્ ન્યૂનઃ કૃતસ્ત્વયા| તેજોગૌરવરૂપેણ કિરીટેન વિભૂષિતઃ| સૃષ્ટં યત્ તે કરાભ્યાં સ તત્પ્રભુત્વે નિયોજિતઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ચરણાધશ્ચ તસ્યૈવ ત્વયા સર્વ્વં વશીકૃતં|| " તેન સર્વ્વં યસ્ય વશીકૃતં તસ્યાવશીભૂતં કિમપિ નાવશેષિતં કિન્ત્વધુનાપિ વયં સર્વ્વાણિ તસ્ય વશીભૂતાનિ ન પશ્યામઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>તથાપિ દિવ્યદૂતગણેભ્યો યઃ કિઞ્ચિન્ ન્યૂનીકૃતોઽભવત્ તં યીશું મૃત્યુભોગહેતોસ્તેજોગૌરવરૂપેણ કિરીટેન વિભૂષિતં પશ્યામઃ, યત ઈશ્વરસ્યાનુગ્રહાત્ સ સર્વ્વેષાં કૃતે મૃત્યુમ્ અસ્વદત|</para>
  <para style="p">
    <verse number="10" style="v"/>અપરઞ્ચ યસ્મૈ યેન ચ કૃત્સ્નં વસ્તુ સૃષ્ટં વિદ્યતે બહુસન્તાનાનાં વિભવાયાનયનકાલે તેષાં પરિત્રાણાગ્રસરસ્ય દુઃખભોગેન સિદ્ધીકરણમપિ તસ્યોપયુક્તમ્ અભવત્|</para>
  <para style="p">
    <verse number="11" style="v"/>યતઃ પાવકઃ પૂયમાનાશ્ચ સર્વ્વે એકસ્માદેવોત્પન્ના ભવન્તિ, ઇતિ હેતોઃ સ તાન્ ભ્રાતૃન્ વદિતું ન લજ્જતે|</para>
  <para style="p">
    <verse number="12" style="v"/>તેન સ ઉક્તવાન્, યથા, "દ્યોતયિષ્યામિ તે નામ ભ્રાતૃણાં મધ્યતો મમ| પરન્તુ સમિતે ર્મધ્યે કરિષ્યે તે પ્રશંસનં|| "</para>
  <para style="p">
    <verse number="13" style="v"/>પુનરપિ, યથા, "તસ્મિન્ વિશ્વસ્ય સ્થાતાહં| " પુનરપિ, યથા, "પશ્યાહમ્ અપત્યાનિ ચ દત્તાનિ મહ્યમ્ ઈશ્વરાત્| "</para>
  <para style="p">
    <verse number="14" style="v"/>તેષામ્ અપત્યાનાં રુધિરપલલવિશિષ્ટત્વાત્ સોઽપિ તદ્વત્ તદ્વિશિષ્ટોઽભૂત્ તસ્યાભિપ્રાયોઽયં યત્ સ મૃત્યુબલાધિકારિણં શયતાનં મૃત્યુના બલહીનં કુર્ય્યાત્</para>
  <para style="p">
    <verse number="15" style="v"/>યે ચ મૃત્યુભયાદ્ યાવજ્જીવનં દાસત્વસ્ય નિઘ્ના આસન્ તાન્ ઉદ્ધારયેત્|</para>
  <para style="p">
    <verse number="16" style="v"/>સ દૂતાનામ્ ઉપકારી ન ભવતિ કિન્ત્વિબ્રાહીમો વંશસ્યૈવોપકારી ભવતી|</para>
  <para style="p">
    <verse number="17" style="v"/>અતો હેતોઃ સ યથા કૃપાવાન્ પ્રજાનાં પાપશોધનાર્થમ્ ઈશ્વરોદ્દેશ્યવિષયે વિશ્વાસ્યો મહાયાજકો ભવેત્ તદર્થં સર્વ્વવિષયે સ્વભ્રાતૃણાં સદૃશીભવનં તસ્યોચિતમ્ આસીત્|</para>
  <para style="p">
    <verse number="18" style="v"/>યતઃ સ સ્વયં પરીક્ષાં ગત્વા યં દુઃખભોગમ્ અવગતસ્તેન પરીક્ષાક્રાન્તાન્ ઉપકર્ત્તું શક્નોતિ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે સ્વર્ગીયસ્યાહ્વાનસ્ય સહભાગિનઃ પવિત્રભ્રાતરઃ, અસ્માકં ધર્મ્મપ્રતિજ્ઞાયા દૂતોઽગ્રસરશ્ચ યો યીશુસ્તમ્ આલોચધ્વં|</para>
  <para style="p">
    <verse number="2" style="v"/>મૂસા યદ્વત્ તસ્ય સર્વ્વપરિવારમધ્યે વિશ્વાસ્ય આસીત્, તદ્વત્ અયમપિ સ્વનિયોજકસ્ય સમીપે વિશ્વાસ્યો ભવતિ|</para>
  <para style="p">
    <verse number="3" style="v"/>પરિવારાચ્ચ યદ્વત્ તત્સ્થાપયિતુરધિકં ગૌરવં ભવતિ તદ્વત્ મૂસસોઽયં બહુતરગૌરવસ્ય યોગ્યો ભવતિ|</para>
  <para style="p">
    <verse number="4" style="v"/>એકૈકસ્ય નિવેશનસ્ય પરિજનાનાં સ્થાપયિતા કશ્ચિદ્ વિદ્યતે યશ્ચ સર્વ્વસ્થાપયિતા સ ઈશ્વર એવ|</para>
  <para style="p">
    <verse number="5" style="v"/>મૂસાશ્ચ વક્ષ્યમાણાનાં સાક્ષી ભૃત્ય ઇવ તસ્ય સર્વ્વપરિજનમધ્યે વિશ્વાસ્યોઽભવત્ કિન્તુ ખ્રીષ્ટસ્તસ્ય પરિજનાનામધ્યક્ષ ઇવ|</para>
  <para style="p">
    <verse number="6" style="v"/>વયં તુ યદિ વિશ્વાસસ્યોત્સાહં શ્લાઘનઞ્ચ શેષં યાવદ્ ધારયામસ્તર્હિ તસ્ય પરિજના ભવામઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>અતો હેતોઃ પવિત્રેણાત્મના યદ્વત્ કથિતં, તદ્વત્, "અદ્ય યૂયં કથાં તસ્ય યદિ સંશ્રોતુમિચ્છથ|</para>
  <para style="p">
    <verse number="8" style="v"/>તર્હિ પુરા પરીક્ષાયા દિને પ્રાન્તરમધ્યતઃ| મદાજ્ઞાનિગ્રહસ્થાને યુષ્માભિસ્તુ કૃતં યથા| તથા મા કુરુતેદાનીં કઠિનાનિ મનાંસિ વઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>યુષ્માકં પિતરસ્તત્ર મત્પરીક્ષામ્ અકુર્વ્વત| કુર્વ્વદ્ભિ ર્મેઽનુસન્ધાનં તૈરદૃશ્યન્ત મત્ક્રિયાઃ| ચત્વારિંશત્સમા યાવત્ ક્રુદ્ધ્વાહન્તુ તદન્વયે|</para>
  <para style="p">
    <verse number="10" style="v"/>અવાદિષમ્ ઇમે લોકા ભ્રાન્તાન્તઃકરણાઃ સદા| મામકીનાનિ વર્ત્માનિ પરિજાનન્તિ નો ઇમે|</para>
  <para style="p">
    <verse number="11" style="v"/>ઇતિ હેતોરહં કોપાત્ શપથં કૃતવાન્ ઇમં| પ્રેવેક્ષ્યતે જનૈરેતૈ ર્ન વિશ્રામસ્થલં મમ|| "</para>
  <para style="p">
    <verse number="12" style="v"/>હે ભ્રાતરઃ સાવધાના ભવત, અમરેશ્વરાત્ નિવર્ત્તકો યોઽવિશ્વાસસ્તદ્યુક્તં દુષ્ટાન્તઃકરણં યુષ્માકં કસ્યાપિ ન ભવતુ|</para>
  <para style="p">
    <verse number="13" style="v"/>કિન્તુ યાવદ્ અદ્યનામા સમયો વિદ્યતે તાવદ્ યુષ્મન્મધ્યે કોઽપિ પાપસ્ય વઞ્ચનયા યત્ કઠોરીકૃતો ન ભવેત્ તદર્થં પ્રતિદિનં પરસ્પરમ્ ઉપદિશત|</para>
  <para style="p">
    <verse number="14" style="v"/>યતો વયં ખ્રીષ્ટસ્યાંશિનો જાતાઃ કિન્તુ પ્રથમવિશ્વાસસ્ય દૃઢત્વમ્ અસ્માભિઃ શેષં યાવદ્ અમોઘં ધારયિતવ્યં|</para>
  <para style="p">
    <verse number="15" style="v"/>અદ્ય યૂયં કથાં તસ્ય યદિ સંશ્રોતુમિચ્છથ, તર્હ્યાજ્ઞાલઙ્ઘનસ્થાને યુષ્માભિસ્તુ કૃતં યથા, તથા મા કુરુતેદાનીં કઠિનાનિ મનાંસિ વ ઇતિ તેન યદુક્તં,</para>
  <para style="p">
    <verse number="16" style="v"/>તદનુસારાદ્ યે શ્રુત્વા તસ્ય કથાં ન ગૃહીતવન્તસ્તે કે? કિં મૂસસા મિસરદેશાદ્ આગતાઃ સર્વ્વે લોકા નહિ?</para>
  <para style="p">
    <verse number="17" style="v"/>કેભ્યો વા સ ચત્વારિંશદ્વર્ષાણિ યાવદ્ અક્રુધ્યત્? પાપં કુર્વ્વતાં યેષાં કુણપાઃ પ્રાન્તરે ઽપતન્ કિં તેભ્યો નહિ?</para>
  <para style="p">
    <verse number="18" style="v"/>પ્રવેક્ષ્યતે જનૈરેતૈ ર્ન વિશ્રામસ્થલં મમેતિ શપથઃ કેષાં વિરુદ્ધં તેનાકારિ? કિમ્ અવિશ્વાસિનાં વિરુદ્ધં નહિ?</para>
  <para style="p">
    <verse number="19" style="v"/>અતસ્તે તત્ સ્થાનં પ્રવેષ્ટુમ્ અવિશ્વાસાત્ નાશક્નુવન્ ઇતિ વયં વીક્ષામહે|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અપરં તદ્વિશ્રામપ્રાપ્તેઃ પ્રતિજ્ઞા યદિ તિષ્ઠતિ તર્હ્યસ્માકં કશ્ચિત્ ચેત્ તસ્યાઃ ફલેન વઞ્ચિતો ભવેત્ વયમ્ એતસ્માદ્ બિભીમઃ|</para>
  <para style="p">
    <verse number="2" style="v"/>યતો ઽસ્માકં સમીપે યદ્વત્ તદ્વત્ તેષાં સમીપેઽપિ સુસંવાદઃ પ્રચારિતો ઽભવત્ કિન્તુ તૈઃ શ્રુતં વાક્યં તાન્ પ્રતિ નિષ્ફલમ્ અભવત્, યતસ્તે શ્રોતારો વિશ્વાસેન સાર્દ્ધં તન્નામિશ્રયન્|</para>
  <para style="p">
    <verse number="3" style="v"/>તદ્ વિશ્રામસ્થાનં વિશ્વાસિભિરસ્માભિઃ પ્રવિશ્યતે યતસ્તેનોક્તં, "અહં કોપાત્ શપથં કૃતવાન્ ઇમં, પ્રવેક્ષ્યતે જનૈરેતૈ ર્ન વિશ્રામસ્થલં મમ| " કિન્તુ તસ્ય કર્મ્માણિ જગતઃ સૃષ્ટિકાલાત્ સમાપ્તાનિ સન્તિ|</para>
  <para style="p">
    <verse number="4" style="v"/>યતઃ કસ્મિંશ્ચિત્ સ્થાને સપ્તમં દિનમધિ તેનેદમ્ ઉક્તં, યથા, "ઈશ્વરઃ સપ્તમે દિને સ્વકૃતેભ્યઃ સર્વ્વકર્મ્મભ્યો વિશશ્રામ| "</para>
  <para style="p">
    <verse number="5" style="v"/>કિન્ત્વેતસ્મિન્ સ્થાને પુનસ્તેનોચ્યતે, યથા, "પ્રવેક્ષ્યતે જનૈરેતૈ ર્ન વિશ્રામસ્થલં મમ| "</para>
  <para style="p">
    <verse number="6" style="v"/>ફલતસ્તત્ સ્થાનં કૈશ્ચિત્ પ્રવેષ્ટવ્યં કિન્તુ યે પુરા સુસંવાદં શ્રુતવન્તસ્તૈરવિશ્વાસાત્ તન્ન પ્રવિષ્ટમ્,</para>
  <para style="p">
    <verse number="7" style="v"/>ઇતિ હેતોઃ સ પુનરદ્યનામકં દિનં નિરૂપ્ય દીર્ઘકાલે ગતેઽપિ પૂર્વ્વોક્તાં વાચં દાયૂદા કથયતિ, યથા, "અદ્ય યૂયં કથાં તસ્ય યદિ સંશ્રોતુમિચ્છથ, તર્હિ મા કુરુતેદાનીં કઠિનાનિ મનાંસિ વઃ| "</para>
  <para style="p">
    <verse number="8" style="v"/>અપરં યિહોશૂયો યદિ તાન્ વ્યશ્રામયિષ્યત્ તર્હિ તતઃ પરમ્ અપરસ્ય દિનસ્ય વાગ્ ઈશ્વરેણ નાકથયિષ્યત|</para>
  <para style="p">
    <verse number="9" style="v"/>અત ઈશ્વરસ્ય પ્રજાભિઃ કર્ત્તવ્ય એકો વિશ્રામસ્તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="10" style="v"/>અપરમ્ ઈશ્વરો યદ્વત્ સ્વકૃતકર્મ્મભ્યો વિશશ્રામ તદ્વત્ તસ્ય વિશ્રામસ્થાનં પ્રવિષ્ટો જનોઽપિ સ્વકૃતકર્મ્મભ્યો વિશ્રામ્યતિ|</para>
  <para style="p">
    <verse number="11" style="v"/>અતો વયં તદ્ વિશ્રામસ્થાનં પ્રવેષ્ટું યતામહૈ, તદવિશ્વાસોદાહરણેન કોઽપિ ન પતતુ|</para>
  <para style="p">
    <verse number="12" style="v"/>ઈશ્વરસ્ય વાદોઽમરઃ પ્રભાવવિશિષ્ટશ્ચ સર્વ્વસ્માદ્ દ્વિધારખઙ્ગાદપિ તીક્ષ્ણઃ, અપરં પ્રાણાત્મનો ર્ગ્રન્થિમજ્જયોશ્ચ પરિભેદાય વિચ્છેદકારી મનસશ્ચ સઙ્કલ્પાનામ્ અભિપ્રેતાનાઞ્ચ વિચારકઃ|</para>
  <para style="p">
    <verse number="13" style="v"/>અપરં યસ્ય સમીપે સ્વીયા સ્વીયા કથાસ્માભિઃ કથયિતવ્યા તસ્યાગોચરઃ કોઽપિ પ્રાણી નાસ્તિ તસ્ય દૃષ્ટૌ સર્વ્વમેવાનાવૃતં પ્રકાશિતઞ્ચાસ્તે|</para>
  <para style="p">
    <verse number="14" style="v"/>અપરં ય ઉચ્ચતમં સ્વર્ગં પ્રવિષ્ટ એતાદૃશ એકો વ્યક્તિરર્થત ઈશ્વરસ્ય પુત્રો યીશુરસ્માકં મહાયાજકોઽસ્તિ, અતો હેતો ર્વયં ધર્મ્મપ્રતિજ્ઞાં દૃઢમ્ આલમ્બામહૈ|</para>
  <para style="p">
    <verse number="15" style="v"/>અસ્માકં યો મહાયાજકો ઽસ્તિ સોઽસ્માકં દુઃખૈ ર્દુઃખિતો ભવિતુમ્ અશક્તો નહિ કિન્તુ પાપં વિના સર્વ્વવિષયે વયમિવ પરીક્ષિતઃ|</para>
  <para style="p">
    <verse number="16" style="v"/>અતએવ કૃપાં ગ્રહીતું પ્રયોજનીયોપકારાર્થમ્ અનુગ્રહં પ્રાપ્તુઞ્ચ વયમ્ ઉત્સાહેનાનુગ્રહસિંહાસનસ્ય સમીપં યામઃ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>યઃ કશ્ચિત્ મહાયાજકો ભવતિ સ માનવાનાં મધ્યાત્ નીતઃ સન્ માનવાનાં કૃત ઈશ્વરોદ્દેશ્યવિષયેઽર્થત ઉપહારાણાં પાપાર્થકબલીનાઞ્ચ દાન નિયુજ્યતે|</para>
  <para style="p">
    <verse number="2" style="v"/>સ ચાજ્ઞાનાં ભ્રાન્તાનાઞ્ચ લોકાનાં દુઃખેન દુઃખી ભવિતું શક્નોતિ, યતો હેતોઃ સ સ્વયમપિ દૌર્બ્બલ્યવેષ્ટિતો ભવતિ|</para>
  <para style="p">
    <verse number="3" style="v"/>એતસ્માત્ કારણાચ્ચ યદ્વત્ લોકાનાં કૃતે તદ્વદ્ આત્મકૃતેઽપિ પાપાર્થકબલિદાનં તેન કર્ત્તવ્યં|</para>
  <para style="p">
    <verse number="4" style="v"/>સ ઘોચ્ચપદઃ સ્વેચ્છાતઃ કેનાપિ ન ગૃહ્યતે કિન્તુ હારોણ ઇવ ય ઈશ્વરેણાહૂયતે તેનૈવ ગૃહ્યતે|</para>
  <para style="p">
    <verse number="5" style="v"/>એવમ્પ્રકારેણ ખ્રીષ્ટોઽપિ મહાયાજકત્વં ગ્રહીતું સ્વીયગૌરવં સ્વયં ન કૃતવાન્, કિન્તુ "મદીયતનયોઽસિ ત્વમ્ અદ્યૈવ જનિતો મયેતિ" વાચં યસ્તં ભાષિતવાન્ સ એવ તસ્ય ગૌરવં કૃતવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>તદ્વદ્ અન્યગીતેઽપીદમુક્તં, ત્વં મલ્કીષેદકઃ શ્રેણ્યાં યાજકોઽસિ સદાતનઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>સ ચ દેહવાસકાલે બહુક્રન્દનેનાશ્રુપાતેન ચ મૃત્યુત ઉદ્ધરણે સમર્થસ્ય પિતુઃ સમીપે પુનઃ પુનર્વિનતિં પ્રર્થનાઞ્ચ કૃત્વા તત્ફલરૂપિણીં શઙ્કાતો રક્ષાં પ્રાપ્ય ચ</para>
  <para style="p">
    <verse number="8" style="v"/>યદ્યપિ પુત્રોઽભવત્ તથાપિ યૈરક્લિશ્યત તૈરાજ્ઞાગ્રહણમ્ અશિક્ષત|</para>
  <para style="p">
    <verse number="9" style="v"/>ઇત્થં સિદ્ધીભૂય નિજાજ્ઞાગ્રાહિણાં સર્વ્વેષામ્ અનન્તપરિત્રાણસ્ય કારણસ્વરૂપો ઽભવત્|</para>
  <para style="p">
    <verse number="10" style="v"/>તસ્માત્ સ મલ્કીષેદકઃ શ્રેણીભુક્તો મહાયાજક ઈશ્વરેણાખ્યાતઃ|</para>
  <para style="p">
    <verse number="11" style="v"/>તમધ્યસ્માકં બહુકથાઃ કથયિતવ્યાઃ કિન્તુ તાઃ સ્તબ્ધકર્ણૈ ર્યુષ્માભિ ર્દુર્ગમ્યાઃ|</para>
  <para style="p">
    <verse number="12" style="v"/>યતો યૂયં યદ્યપિ સમયસ્ય દીર્ઘત્વાત્ શિક્ષકા ભવિતુમ્ અશક્ષ્યત તથાપીશ્વરસ્ય વાક્યાનાં યા પ્રથમા વર્ણમાલા તામધિ શિક્ષાપ્રાપ્તિ ર્યુષ્માકં પુનરાવશ્યકા ભવતિ, તથા કઠિનદ્રવ્યે નહિ કિન્તુ દુગ્ધે યુષ્માકં પ્રયોજનમ્ આસ્તે|</para>
  <para style="p">
    <verse number="13" style="v"/>યો દુગ્ધપાયી સ શિશુરેવેતિકારણાત્ ધર્મ્મવાક્યે તત્પરો નાસ્તિ|</para>
  <para style="p">
    <verse number="14" style="v"/>કિન્તુ સદસદ્વિચારે યેષાં ચેતાંસિ વ્યવહારેણ શિક્ષિતાનિ તાદૃશાનાં સિદ્ધલોકાનાં કઠોરદ્રવ્યેષુ પ્રયોજનમસ્તિ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>વયં મૃતિજનકકર્મ્મભ્યો મનઃપરાવર્ત્તનમ્ ઈશ્વરે વિશ્વાસો મજ્જનશિક્ષણં હસ્તાર્પણં મૃતલોકાનામ્ ઉત્થાનમ્</para>
  <para style="p">
    <verse number="2" style="v"/>અનન્તકાલસ્થાયિવિચારાજ્ઞા ચૈતૈઃ પુનર્ભિત્તિમૂલં ન સ્થાપયન્તઃ ખ્રીષ્ટવિષયકં પ્રથમોપદેશં પશ્ચાત્કૃત્ય સિદ્ધિં યાવદ્ અગ્રસરા ભવામ|</para>
  <para style="p">
    <verse number="3" style="v"/>ઈશ્વરસ્યાનુમત્યા ચ તદ્ અસ્માભિઃ કારિષ્યતે|</para>
  <para style="p">
    <verse number="4" style="v"/>ય એકકૃત્વો દીપ્તિમયા ભૂત્વા સ્વર્ગીયવરરસમ્ આસ્વદિતવન્તઃ પવિત્રસ્યાત્મનોઽંશિનો જાતા</para>
  <para style="p">
    <verse number="5" style="v"/>ઈશ્વરસ્ય સુવાક્યં ભાવિકાલસ્ય શક્તિઞ્ચાસ્વદિતવન્તશ્ચ તે ભ્રષ્ટ્વા યદિ</para>
  <para style="p">
    <verse number="6" style="v"/>સ્વમનોભિરીશ્વરસ્ય પુત્રં પુનઃ ક્રુશે ઘ્નન્તિ લજ્જાસ્પદં કુર્વ્વતે ચ તર્હિ મનઃપરાવર્ત્તનાય પુનસ્તાન્ નવીનીકર્ત્તું કોઽપિ ન શક્નોતિ|</para>
  <para style="p">
    <verse number="7" style="v"/>યતો યા ભૂમિઃ સ્વોપરિ ભૂયઃ પતિતં વૃષ્ટિં પિવતી તત્ફલાધિકારિણાં નિમિત્તમ્ ઇષ્ટાનિ શાકાદીન્યુત્પાદયતિ સા ઈશ્વરાદ્ આશિષં પ્રાપ્તા|</para>
  <para style="p">
    <verse number="8" style="v"/>કિન્તુ યા ભૂમિ ર્ગોક્ષુરકણ્ટકવૃક્ષાન્ ઉત્પાદયતિ સા ન ગ્રાહ્યા શાપાર્હા ચ શેષે તસ્યા દાહો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>હે પ્રિયતમાઃ, યદ્યપિ વયમ્ એતાદૃશં વાક્યં ભાષામહે તથાપિ યૂયં તત ઉત્કૃષ્ટાઃ પરિત્રાણપથસ્ય પથિકાશ્ચાધ્વ ઇતિ વિશ્વસામઃ|</para>
  <para style="p">
    <verse number="10" style="v"/>યતો યુષ્માભિઃ પવિત્રલોકાનાં ય ઉપકારો ઽકારિ ક્રિયતે ચ તેનેશ્વરસ્ય નામ્ને પ્રકાશિતં પ્રેમ શ્રમઞ્ચ વિસ્મર્ત્તુમ્ ઈશ્વરોઽન્યાયકારી ન ભવતિ|</para>
  <para style="p">
    <verse number="11" style="v"/>અપરં યુષ્માકમ્ એકૈકો જનો યત્ પ્રત્યાશાપૂરણાર્થં શેષં યાવત્ તમેવ યત્નં પ્રકાશયેદિત્યહમ્ ઇચ્છામિ|</para>
  <para style="p">
    <verse number="12" style="v"/>અતઃ શિથિલા ન ભવત કિન્તુ યે વિશ્વાસેન સહિષ્ણુતયા ચ પ્રતિજ્ઞાનાં ફલાધિકારિણો જાતાસ્તેષામ્ અનુગામિનો ભવત|</para>
  <para style="p">
    <verse number="13" style="v"/>ઈશ્વરો યદા ઇબ્રાહીમે પ્રત્યજાનાત્ તદા શ્રેષ્ઠસ્ય કસ્યાપ્યપરસ્ય નામ્ના શપથં કર્ત્તું નાશક્નોત્, અતો હેતોઃ સ્વનામ્ના શપથં કૃત્વા તેનોક્તં યથા,</para>
  <para style="p">
    <verse number="14" style="v"/>"સત્યમ્ અહં ત્વામ્ આશિષં ગદિષ્યામિ તવાન્વયં વર્દ્ધયિષ્યામિ ચ| "</para>
  <para style="p">
    <verse number="15" style="v"/>અનેન પ્રકારેણ સ સહિષ્ણુતાં વિધાય તસ્યાઃ પ્રત્યાશાયાઃ ફલં લબ્ધવાન્|</para>
  <para style="p">
    <verse number="16" style="v"/>અથ માનવાઃ શ્રેષ્ઠસ્ય કસ્યચિત્ નામ્ના શપન્તે, શપથશ્ચ પ્રમાણાર્થં તેષાં સર્વ્વવિવાદાન્તકો ભવતિ|</para>
  <para style="p">
    <verse number="17" style="v"/>ઇત્યસ્મિન્ ઈશ્વરઃ પ્રતિજ્ઞાયાઃ ફલાધિકારિણઃ સ્વીયમન્ત્રણાયા અમોઘતાં બાહુલ્યતો દર્શયિતુમિચ્છન્ શપથેન સ્વપ્રતિજ્ઞાં સ્થિરીકૃતવાન્|</para>
  <para style="p">
    <verse number="18" style="v"/>અતએવ યસ્મિન્ અનૃતકથનમ્ ઈશ્વરસ્ય ન સાધ્યં તાદૃશેનાચલેન વિષયદ્વયેન સમ્મુખસ્થરક્ષાસ્થલસ્ય પ્રાપ્તયે પલાયિતાનામ્ અસ્માકં સુદૃઢા સાન્ત્વના જાયતે|</para>
  <para style="p">
    <verse number="19" style="v"/>સા પ્રત્યાશાસ્માકં મનોનૌકાયા અચલો લઙ્ગરો ભૂત્વા વિચ્છેદકવસ્ત્રસ્યાભ્યન્તરં પ્રવિષ્ટા|</para>
  <para style="p">
    <verse number="20" style="v"/>તત્રૈવાસ્માકમ્ અગ્રસરો યીશુઃ પ્રવિશ્ય મલ્કીષેદકઃ શ્રેણ્યાં નિત્યસ્થાયી યાજકોઽભવત્|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>શાલમસ્ય રાજા સર્વ્વોપરિસ્થસ્યેશ્વરસ્ય યાજકશ્ચ સન્ યો નૃપતીનાં મારણાત્ પ્રત્યાગતમ્ ઇબ્રાહીમં સાક્ષાત્કૃત્યાશિષં ગદિતવાન્,</para>
  <para style="p">
    <verse number="2" style="v"/>યસ્મૈ ચેબ્રાહીમ્ સર્વ્વદ્રવ્યાણાં દશમાંશં દત્તવાન્ સ મલ્કીષેદક્ સ્વનામ્નોઽર્થેન પ્રથમતો ધર્મ્મરાજઃ પશ્ચાત્ શાલમસ્ય રાજાર્થતઃ શાન્તિરાજો ભવતિ|</para>
  <para style="p">
    <verse number="3" style="v"/>અપરં તસ્ય પિતા માતા વંશસ્ય નિર્ણય આયુષ આરમ્ભો જીવનસ્ય શેષશ્ચૈતેષામ્ અભાવો ભવતિ, ઇત્થં સ ઈશ્વરપુત્રસ્ય સદૃશીકૃતઃ, સ ત્વનન્તકાલં યાવદ્ યાજકસ્તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="4" style="v"/>અતએવાસ્માકં પૂર્વ્વપુરુષ ઇબ્રાહીમ્ યસ્મૈ લુઠિતદ્રવ્યાણાં દશમાંશં દત્તવાન્ સ કીદૃક્ મહાન્ તદ્ આલોચયત|</para>
  <para style="p">
    <verse number="5" style="v"/>યાજકત્વપ્રાપ્તા લેવેઃ સન્તાના વ્યવસ્થાનુસારેણ લોકેભ્યોઽર્થત ઇબ્રાહીમો જાતેભ્યઃ સ્વીયભ્રાતૃભ્યો દશમાંશગ્રહણસ્યાદેશં લબ્ધવન્તઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>કિન્ત્વસૌ યદ્યપિ તેષાં વંશાત્ નોત્પન્નસ્તથાપીબ્રાહીમો દશમાંશં ગૃહીતવાન્ પ્રતિજ્ઞાનામ્ અધિકારિણમ્ આશિષં ગદિતવાંશ્ચ|</para>
  <para style="p">
    <verse number="7" style="v"/>અપરં યઃ શ્રેયાન્ સ ક્ષુદ્રતરાયાશિષં દદાતીત્યત્ર કોઽપિ સન્દેહો નાસ્તિ|</para>
  <para style="p">
    <verse number="8" style="v"/>અપરમ્ ઇદાનીં યે દશમાંશં ગૃહ્લન્તિ તે મૃત્યોરધીના માનવાઃ કિન્તુ તદાનીં યો ગૃહીતવાન્ સ જીવતીતિપ્રમાણપ્રાપ્તઃ|</para>
  <para style="p">
    <verse number="9" style="v"/>અપરં દશમાંશગ્રાહી લેવિરપીબ્રાહીમ્દ્વારા દશમાંશં દત્તવાન્ એતદપિ કથયિતું શક્યતે|</para>
  <para style="p">
    <verse number="10" style="v"/>યતો યદા મલ્કીષેદક્ તસ્ય પિતરં સાક્ષાત્ કૃતવાન્ તદાનીં સ લેવિઃ પિતુરુરસ્યાસીત્|</para>
  <para style="p">
    <verse number="11" style="v"/>અપરં યસ્ય સમ્બન્ધે લોકા વ્યવસ્થાં લબ્ધવન્તસ્તેન લેવીયયાજકવર્ગેણ યદિ સિદ્ધિઃ સમભવિષ્યત્ તર્હિ હારોણસ્ય શ્રેણ્યા મધ્યાદ્ યાજકં ન નિરૂપ્યેશ્વરેણ મલ્કીષેદકઃ શ્રેણ્યા મધ્યાદ્ અપરસ્યૈકસ્ય યાજકસ્યોત્થાપનં કુત આવશ્યકમ્ અભવિષ્યત્?</para>
  <para style="p">
    <verse number="12" style="v"/>યતો યાજકવર્ગસ્ય વિનિમયેન સુતરાં વ્યવસ્થાયા અપિ વિનિમયો જાયતે|</para>
  <para style="p">
    <verse number="13" style="v"/>અપરઞ્ચ તદ્ વાક્યં યસ્યોદ્દેશ્યં સોઽપરેણ વંશેન સંયુક્તાઽસ્તિ તસ્ય વંશસ્ય ચ કોઽપિ કદાપિ વેદ્યાઃ કર્મ્મ ન કૃતવાન્|</para>
  <para style="p">
    <verse number="14" style="v"/>વસ્તુતસ્તુ યં વંશમધિ મૂસા યાજકત્વસ્યૈકાં કથામપિ ન કથિતવાન્ તસ્મિન્ યિહૂદાવંશેઽસ્માકં પ્રભુ ર્જન્મ ગૃહીતવાન્ ઇતિ સુસ્પષ્ટં|</para>
  <para style="p">
    <verse number="15" style="v"/>તસ્ય સ્પષ્ટતરમ્ અપરં પ્રમાણમિદં યત્ મલ્કીષેદકઃ સાદૃશ્યવતાપરેણ તાદૃશેન યાજકેનોદેતવ્યં,</para>
  <para style="p">
    <verse number="16" style="v"/>યસ્ય નિરૂપણં શરીરસમ્બન્ધીયવિધિયુક્તયા વ્યવસ્થાયા ન ભવતિ કિન્ત્વક્ષયજીવનયુક્તયા શક્ત્યા ભવતિ|</para>
  <para style="p">
    <verse number="17" style="v"/>યત ઈશ્વર ઇદં સાક્ષ્યં દત્તવાન્, યથા, "ત્વં મક્લીષેદકઃ શ્રેણ્યાં યાજકોઽસિ સદાતનઃ| "</para>
  <para style="p">
    <verse number="18" style="v"/>અનેનાગ્રવર્ત્તિનો વિધે દુર્બ્બલતાયા નિષ્ફલતાયાશ્ચ હેતોરર્થતો વ્યવસ્થયા કિમપિ સિદ્ધં ન જાતમિતિહેતોસ્તસ્ય લોપો ભવતિ|</para>
  <para style="p">
    <verse number="19" style="v"/>યયા ચ વયમ્ ઈશ્વરસ્ય નિકટવર્ત્તિનો ભવામ એતાદૃશી શ્રેષ્ઠપ્રત્યાશા સંસ્થાપ્યતે|</para>
  <para style="p">
    <verse number="20" style="v"/>અપરં યીશુઃ શપથં વિના ન નિયુક્તસ્તસ્માદપિ સ શ્રેષ્ઠનિયમસ્ય મધ્યસ્થો જાતઃ|</para>
  <para style="p">
    <verse number="21" style="v"/>યતસ્તે શપથં વિના યાજકા જાતાઃ કિન્ત્વસૌ શપથેન જાતઃ યતઃ સ ઇદમુક્તઃ, યથા,</para>
  <para style="p">
    <verse number="22" style="v"/>"પરમેશ ઇદં શેપે ન ચ તસ્માન્નિવર્ત્સ્યતે| ત્વં મલ્કીષેદકઃ શ્રેણ્યાં યાજકોઽસિ સદાતનઃ| "</para>
  <para style="p">
    <verse number="23" style="v"/>તે ચ બહવો યાજકા અભવન્ યતસ્તે મૃત્યુના નિત્યસ્થાયિત્વાત્ નિવારિતાઃ,</para>
  <para style="p">
    <verse number="24" style="v"/>કિન્ત્વસાવનન્તકાલં યાવત્ તિષ્ઠતિ તસ્માત્ તસ્ય યાજકત્વં ન પરિવર્ત્તનીયં|</para>
  <para style="p">
    <verse number="25" style="v"/>તતો હેતો ર્યે માનવાસ્તેનેશ્વરસ્ય સન્નિધિં ગચ્છન્તિ તાન્ સ શેષં યાવત્ પરિત્રાતું શક્નોતિ યતસ્તેષાં કૃતે પ્રાર્થનાં કર્ત્તું સ સતતં જીવતિ|</para>
  <para style="p">
    <verse number="26" style="v"/>અપરમ્ અસ્માકં તાદૃશમહાયાજકસ્ય પ્રયોજનમાસીદ્ યઃ પવિત્રો ઽહિંસકો નિષ્કલઙ્કઃ પાપિભ્યો ભિન્નઃ સ્વર્ગાદપ્યુચ્ચીકૃતશ્ચ સ્યાત્|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરં મહાયાજકાનાં યથા તથા તસ્ય પ્રતિદિનં પ્રથમં સ્વપાપાનાં કૃતે તતઃ પરં લોકાનાં પાપાનાં કૃતે બલિદાનસ્ય પ્રયોજનં નાસ્તિ યત આત્મબલિદાનં કૃત્વા તદ્ એકકૃત્વસ્તેન સમ્પાદિતં|</para>
  <para style="p">
    <verse number="28" style="v"/>યતો વ્યવસ્થયા યે મહાયાજકા નિરૂપ્યન્તે તે દૌર્બ્બલ્યયુક્તા માનવાઃ કિન્તુ વ્યવસ્થાતઃ પરં શપથયુક્તેન વાક્યેન યો મહાયાજકો નિરૂપિતઃ સો ઽનન્તકાલાર્થં સિદ્ધઃ પુત્ર એવ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>કથ્યમાનાનાં વાક્યાનાં સારોઽયમ્ અસ્માકમ્ એતાદૃશ એકો મહાયાજકોઽસ્તિ યઃ સ્વર્ગે મહામહિમ્નઃ સિંહાસનસ્ય દક્ષિણપાર્શ્વો સમુપવિષ્ટવાન્</para>
  <para style="p">
    <verse number="2" style="v"/>યચ્ચ દૂષ્યં ન મનુજૈઃ કિન્ત્વીશ્વરેણ સ્થાપિતં તસ્ય સત્યદૂષ્યસ્ય પવિત્રવસ્તૂનાઞ્ચ સેવકઃ સ ભવતિ|</para>
  <para style="p">
    <verse number="3" style="v"/>યત એકૈકો મહાયાજકો નૈવેદ્યાનાં બલીનાઞ્ચ દાને નિયુજ્યતે, અતો હેતોરેતસ્યાપિ કિઞ્ચિદ્ ઉત્સર્જનીયં વિદ્યત ઇત્યાવશ્યકં|</para>
  <para style="p">
    <verse number="4" style="v"/>કિઞ્ચ સ યદિ પૃથિવ્યામ્ અસ્થાસ્યત્ તર્હિ યાજકો નાભવિષ્યત્, યતો યે વ્યવસ્થાનુસારાત્ નૈવેદ્યાનિ દદત્યેતાદૃશા યાજકા વિદ્યન્તે|</para>
  <para style="p">
    <verse number="5" style="v"/>તે તુ સ્વર્ગીયવસ્તૂનાં દૃષ્ટાન્તેન છાયયા ચ સેવામનુતિષ્ઠન્તિ યતો મૂસસિ દૂષ્યં સાધયિતુમ્ ઉદ્યતે સતીશ્વરસ્તદેવ તમાદિષ્ટવાન્ ફલતઃ સ તમુક્તવાન્, યથા, "અવધેહિ ગિરૌ ત્વાં યદ્યન્નિદર્શનં દર્શિતં તદ્વત્ સર્વ્વાણિ ત્વયા ક્રિયન્તાં| "</para>
  <para style="p">
    <verse number="6" style="v"/>કિન્ત્વિદાનીમ્ અસૌ તસ્માત્ શ્રેષ્ઠં સેવકપદં પ્રાપ્તવાન્ યતઃ સ શ્રેષ્ઠપ્રતિજ્ઞાભિઃ સ્થાપિતસ્ય શ્રેષ્ઠનિયમસ્ય મધ્યસ્થોઽભવત્|</para>
  <para style="p">
    <verse number="7" style="v"/>સ પ્રથમો નિયમો યદિ નિર્દ્દોષોઽભવિષ્યત તર્હિ દ્વિતીયસ્ય નિયમસ્ય કિમપિ પ્રયોજનં નાભવિષ્યત્|</para>
  <para style="p">
    <verse number="8" style="v"/>કિન્તુ સ દોષમારોપયન્ તેભ્યઃ કથયતિ, યથા, "પરમેશ્વર ઇદં ભાષતે પશ્ય યસ્મિન્ સમયેઽહમ્ ઇસ્રાયેલવંશેન યિહૂદાવંશેન ચ સાર્દ્ધમ્ એકં નવીનં નિયમં સ્થિરીકરિષ્યામ્યેતાદૃશઃ સમય આયાતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>પરમેશ્વરોઽપરમપિ કથયતિ તેષાં પૂર્વ્વપુરુષાણાં મિસરદેશાદ્ આનયનાર્થં યસ્મિન્ દિનેઽહં તેષાં કરં ધૃત્વા તૈઃ સહ નિયમં સ્થિરીકૃતવાન્ તદ્દિનસ્ય નિયમાનુસારેણ નહિ યતસ્તૈ ર્મમ નિયમે લઙ્ઘિતેઽહં તાન્ પ્રતિ ચિન્તાં નાકરવં|</para>
  <para style="p">
    <verse number="10" style="v"/>કિન્તુ પરમેશ્વરઃ કથયતિ તદ્દિનાત્ પરમહં ઇસ્રાયેલવંશીયૈઃ સાર્દ્ધમ્ ઇમં નિયમં સ્થિરીકરિષ્યામિ, તેષાં ચિત્તે મમ વિધીન્ સ્થાપયિષ્યામિ તેષાં હૃત્પત્રે ચ તાન્ લેખિષ્યામિ, અપરમહં તેષામ્ ઈશ્વરો ભવિષ્યામિ તે ચ મમ લોકા ભવિષ્યન્તિ|</para>
  <para style="p">
    <verse number="11" style="v"/>અપરં ત્વં પરમેશ્વરં જાનીહીતિવાક્યેન તેષામેકૈકો જનઃ સ્વં સ્વં સમીપવાસિનં ભ્રાતરઞ્ચ પુન ર્ન શિક્ષયિષ્યતિ યત આક્ષુદ્રાત્ મહાન્તં યાવત્ સર્વ્વે માં જ્ઞાસ્યન્તિ|</para>
  <para style="p">
    <verse number="12" style="v"/>યતો હેતોરહં તેષામ્ અધર્મ્માન્ ક્ષમિષ્યે તેષાં પાપાન્યપરાધાંશ્ચ પુનઃ કદાપિ ન સ્મરિષ્યામિ| "</para>
  <para style="p">
    <verse number="13" style="v"/>અનેન તં નિયમં નૂતનં ગદિત્વા સ પ્રથમં નિયમં પુરાતનીકૃતવાન્; યચ્ચ પુરાતનં જીર્ણાઞ્ચ જાતં તસ્ય લોપો નિકટો ઽભવત્|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>સ પ્રથમો નિયમ આરાધનાયા વિવિધરીતિભિરૈહિકપવિત્રસ્થાનેન ચ વિશિષ્ટ આસીત્|</para>
  <para style="p">
    <verse number="2" style="v"/>યતો દૂષ્યમેકં નિરમીયત તસ્ય પ્રથમકોષ્ઠસ્ય નામ પવિત્રસ્થાનમિત્યાસીત્ તત્ર દીપવૃક્ષો ભોજનાસનં દર્શનીયપૂપાનાં શ્રેણી ચાસીત્|</para>
  <para style="p">
    <verse number="3" style="v"/>તત્પશ્ચાદ્ દ્વિતીયાયાસ્તિરષ્કરિણ્યા અભ્યન્તરે ઽતિપવિત્રસ્થાનમિતિનામકં કોષ્ઠમાસીત્,</para>
  <para style="p">
    <verse number="4" style="v"/>તત્ર ચ સુવર્ણમયો ધૂપાધારઃ પરિતઃ સુવર્ણમણ્ડિતા નિયમમઞ્જૂષા ચાસીત્ તન્મધ્યે માન્નાયાઃ સુવર્ણઘટો હારોણસ્ય મઞ્જરિતદણ્ડસ્તક્ષિતૌ નિયમપ્રસ્તરૌ,</para>
  <para style="p">
    <verse number="5" style="v"/>તદુપરિ ચ કરુણાસને છાયાકારિણૌ તેજોમયૌ કિરૂબાવાસ્તામ્, એતેષાં વિશેષવૃત્તાન્તકથનાય નાયં સમયઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>એતેષ્વીદૃક્ નિર્મ્મિતેષુ યાજકા ઈશ્વરસેવામ્ અનુતિષ્ઠનતો દૂષ્યસ્ય પ્રથમકોષ્ઠં નિત્યં પ્રવિશન્તિ|</para>
  <para style="p">
    <verse number="7" style="v"/>કિન્તુ દ્વિતીયં કોષ્ઠં પ્રતિવર્ષમ્ એકકૃત્વ એકાકિના મહાયાજકેન પ્રવિશ્યતે કિન્ત્વાત્મનિમિત્તં લોકાનામ્ અજ્ઞાનકૃતપાપાનાઞ્ચ નિમિત્તમ્ ઉત્સર્જ્જનીયં રુધિરમ્ અનાદાય તેન ન પ્રવિશ્યતે|</para>
  <para style="p">
    <verse number="8" style="v"/>ઇત્યનેન પવિત્ર આત્મા યત્ જ્ઞાપયતિ તદિદં તત્ પ્રથમં દૂષ્યં યાવત્ તિષ્ઠતિ તાવત્ મહાપવિત્રસ્થાનગામી પન્થા અપ્રકાશિતસ્તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>તચ્ચ દૂષ્યં વર્ત્તમાનસમયસ્ય દૃષ્ટાન્તઃ, યતો હેતોઃ સામ્પ્રતં સંશોધનકાલં યાવદ્ યન્નિરૂપિતં તદનુસારાત્ સેવાકારિણો માનસિકસિદ્ધિકરણેઽસમર્થાભિઃ</para>
  <para style="p">
    <verse number="10" style="v"/>કેવલં ખાદ્યપેયેષુ વિવિધમજ્જનેષુ ચ શારીરિકરીતિભિ ર્યુક્તાનિ નૈવેદ્યાનિ બલિદાનાનિ ચ ભવન્તિ|</para>
  <para style="p">
    <verse number="11" style="v"/>અપરં ભાવિમઙ્ગલાનાં મહાયાજકઃ ખ્રીષ્ટ ઉપસ્થાયાહસ્તનિર્મ્મિતેનાર્થત એતત્સૃષ્ટે ર્બહિર્ભૂતેન શ્રેષ્ઠેન સિદ્ધેન ચ દૂષ્યેણ ગત્વા</para>
  <para style="p">
    <verse number="12" style="v"/>છાગાનાં ગોવત્સાનાં વા રુધિરમ્ અનાદાય સ્વીયરુધિરમ્ આદાયૈકકૃત્વ એવ મહાપવિત્રસ્થાનં પ્રવિશ્યાનન્તકાલિકાં મુક્તિં પ્રાપ્તવાન્|</para>
  <para style="p">
    <verse number="13" style="v"/>વૃષછાગાનાં રુધિરેણ ગવીભસ્મનઃ પ્રક્ષેપેણ ચ યદ્યશુચિલોકાઃ શારીરિશુચિત્વાય પૂયન્તે,</para>
  <para style="p">
    <verse number="14" style="v"/>તર્હિ કિં મન્યધ્વે યઃ સદાતનેનાત્મના નિષ્કલઙ્કબલિમિવ સ્વમેવેશ્વરાય દત્તવાન્, તસ્ય ખ્રીષ્ટસ્ય રુધિરેણ યુષ્માકં મનાંસ્યમરેશ્વરસ્ય સેવાયૈ કિં મૃત્યુજનકેભ્યઃ કર્મ્મભ્યો ન પવિત્રીકારિષ્યન્તે?</para>
  <para style="p">
    <verse number="15" style="v"/>સ નૂતનનિયમસ્ય મધ્યસ્થોઽભવત્ તસ્યાભિપ્રાયોઽયં યત્ પ્રથમનિયમલઙ્ઘનરૂપપાપેભ્યો મૃત્યુના મુક્તૌ જાતાયામ્ આહૂતલોકા અનન્તકાલીયસમ્પદઃ પ્રતિજ્ઞાફલં લભેરન્|</para>
  <para style="p">
    <verse number="16" style="v"/>યત્ર નિયમો ભવતિ તત્ર નિયમસાધકસ્ય બલે ર્મૃત્યુના ભવિતવ્યં|</para>
  <para style="p">
    <verse number="17" style="v"/>યતો હતેન બલિના નિયમઃ સ્થિરીભવતિ કિન્તુ નિયમસાધકો બલિ ર્યાવત્ જીવતિ તાવત્ નિયમો નિરર્થકસ્તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="18" style="v"/>તસ્માત્ સ પૂર્વ્વનિયમોઽપિ રુધિરપાતં વિના ન સાધિતઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>ફલતઃ સર્વ્વલોકાન્ પ્રતિ વ્યવસ્થાનુસારેણ સર્વ્વા આજ્ઞાઃ કથયિત્વા મૂસા જલેન સિન્દૂરવર્ણલોમ્ના એષોવતૃણેન ચ સાર્દ્ધં ગોવત્સાનાં છાગાનાઞ્ચ રુધિરં ગૃહીત્વા ગ્રન્થે સર્વ્વલોકેષુ ચ પ્રક્ષિપ્ય બભાષે,</para>
  <para style="p">
    <verse number="20" style="v"/>યુષ્માન્ અધીશ્વરો યં નિયમં નિરૂપિતવાન્ તસ્ય રુધિરમેતત્|</para>
  <para style="p">
    <verse number="21" style="v"/>તદ્વત્ સ દૂષ્યેઽપિ સેવાર્થકેષુ સર્વ્વપાત્રેષુ ચ રુધિરં પ્રક્ષિપ્તવાન્|</para>
  <para style="p">
    <verse number="22" style="v"/>અપરં વ્યવસ્થાનુસારેણ પ્રાયશઃ સર્વ્વાણિ રુધિરેણ પરિષ્ક્રિયન્તે રુધિરપાતં વિના પાપમોચનં ન ભવતિ ચ|</para>
  <para style="p">
    <verse number="23" style="v"/>અપરં યાનિ સ્વર્ગીયવસ્તૂનાં દૃષ્ટાન્તાસ્તેષામ્ એતૈઃ પાવનમ્ આવશ્યકમ્ આસીત્ કિન્તુ સાક્ષાત્ સ્વર્ગીયવસ્તૂનામ્ એતેભ્યઃ શ્રેષ્ઠેै ર્બલિદાનૈઃ પાવનમાવશ્યકં|</para>
  <para style="p">
    <verse number="24" style="v"/>યતઃ ખ્રીષ્ટઃ સત્યપવિત્રસ્થાનસ્ય દૃષ્ટાન્તરૂપં હસ્તકૃતં પવિત્રસ્થાનં ન પ્રવિષ્ટવાન્ કિન્ત્વસ્મન્નિમિત્તમ્ ઇદાનીમ્ ઈશ્વરસ્ય સાક્ષાદ્ ઉપસ્થાતું સ્વર્ગમેવ પ્રવિષ્ટઃ|</para>
  <para style="p">
    <verse number="25" style="v"/>યથા ચ મહાયાજકઃ પ્રતિવર્ષં પરશોણિતમાદાય મહાપવિત્રસ્થાનં પ્રવિશતિ તથા ખ્રીષ્ટેન પુનઃ પુનરાત્મોત્સર્ગો ન કર્ત્તવ્યઃ,</para>
  <para style="p">
    <verse number="26" style="v"/>કર્ત્તવ્યે સતિ જગતઃ સૃષ્ટિકાલમારભ્ય બહુવારં તસ્ય મૃત્યુભોગ આવશ્યકોઽભવત્; કિન્ત્વિદાનીં સ આત્મોત્સર્ગેણ પાપનાશાર્થમ્ એકકૃત્વો જગતઃ શેષકાલે પ્રચકાશે|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરં યથા માનુષસ્યૈકકૃત્વો મરણં તત્ પશ્ચાદ્ વિચારો નિરૂપિતોઽસ્તિ,</para>
  <para style="p">
    <verse number="28" style="v"/>તદ્વત્ ખ્રીષ્ટોઽપિ બહૂનાં પાપવહનાર્થં બલિરૂપેણૈકકૃત્વ ઉત્સસૃજે, અપરં દ્વિતીયવારં પાપાદ્ ભિન્નઃ સન્ યે તં પ્રતીક્ષન્તે તેષાં પરિત્રાણાર્થં દર્શનં દાસ્યતિ|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>વ્યવસ્થા ભવિષ્યન્મઙ્ગલાનાં છાયાસ્વરૂપા ન ચ વસ્તૂનાં મૂર્ત્તિસ્વરૂપા તતો હેતો ર્નિત્યં દીયમાનૈરેકવિધૈ ર્વાર્ષિકબલિભિઃ શરણાગતલોકાન્ સિદ્ધાન્ કર્ત્તું કદાપિ ન શક્નોતિ|</para>
  <para style="p">
    <verse number="2" style="v"/>યદ્યશક્ષ્યત્ તર્હિ તેષાં બલીનાં દાનં કિં ન ન્યવર્ત્તિષ્યત? યતઃ સેવાકારિષ્વેકકૃત્વઃ પવિત્રીભૂતેષુ તેષાં કોઽપિ પાપબોધઃ પુન ર્નાભવિષ્યત્|</para>
  <para style="p">
    <verse number="3" style="v"/>કિન્તુ તૈ ર્બલિદાનૈઃ પ્રતિવત્સરં પાપાનાં સ્મારણં જાયતે|</para>
  <para style="p">
    <verse number="4" style="v"/>યતો વૃષાણાં છાગાનાં વા રુધિરેણ પાપમોચનં ન સમ્ભવતિ|</para>
  <para style="p">
    <verse number="5" style="v"/>એતત્કારણાત્ ખ્રીષ્ટેન જગત્ પ્રવિશ્યેદમ્ ઉચ્યતે, યથા, "નેષ્ટ્વા બલિં ન નૈવેદ્યં દેહો મે નિર્મ્મિતસ્ત્વયા|</para>
  <para style="p">
    <verse number="6" style="v"/>ન ચ ત્વં બલિભિ ર્હવ્યૈઃ પાપઘ્નૈ ર્વા પ્રતુષ્યસિ|</para>
  <para style="p">
    <verse number="7" style="v"/>અવાદિષં તદૈવાહં પશ્ય કુર્વ્વે સમાગમં| ધર્મ્મગ્રન્થસ્ય સર્ગે મે વિદ્યતે લિખિતા કથા| ઈશ મનોઽભિલાષસ્તે મયા સમ્પૂરયિષ્યતે| "</para>
  <para style="p">
    <verse number="8" style="v"/>ઇત્યસ્મિન્ પ્રથમતો યેષાં દાનં વ્યવસ્થાનુસારાદ્ ભવતિ તાન્યધિ તેનેદમુક્તં યથા, બલિનૈવેદ્યહવ્યાનિ પાપઘ્નઞ્ચોપચારકં, નેમાનિ વાઞ્છસિ ત્વં હિ ન ચૈતેષુ પ્રતુષ્યસીતિ|</para>
  <para style="p">
    <verse number="9" style="v"/>તતઃ પરં તેનોક્તં યથા, "પશ્ય મનોઽભિલાષં તે કર્ત્તું કુર્વ્વે સમાગમં;" દ્વિતીયમ્ એતદ્ વાક્યં સ્થિરીકર્ત્તું સ પ્રથમં લુમ્પતિ|</para>
  <para style="p">
    <verse number="10" style="v"/>તેન મનોઽભિલાષેણ ચ વયં યીશુખ્રીષ્ટસ્યૈકકૃત્વઃ સ્વશરીરોત્સર્ગાત્ પવિત્રીકૃતા અભવામ|</para>
  <para style="p">
    <verse number="11" style="v"/>અપરમ્ એકૈકો યાજકઃ પ્રતિદિનમ્ ઉપાસનાં કુર્વ્વન્ યૈશ્ચ પાપાનિ નાશયિતું કદાપિ ન શક્યન્તે તાદૃશાન્ એકરૂપાન્ બલીન્ પુનઃ પુનરુત્સૃજન્ તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="12" style="v"/>કિન્ત્વસૌ પાપનાશકમ્ એકં બલિં દત્વાનન્તકાલાર્થમ્ ઈશ્વરસ્ય દક્ષિણ ઉપવિશ્ય</para>
  <para style="p">
    <verse number="13" style="v"/>યાવત્ તસ્ય શત્રવસ્તસ્ય પાદપીઠં ન ભવન્તિ તાવત્ પ્રતીક્ષમાણસ્તિષ્ઠતિ|</para>
  <para style="p">
    <verse number="14" style="v"/>યત એકેન બલિદાનેન સોઽનન્તકાલાર્થં પૂયમાનાન્ લોકાન્ સાધિતવાન્|</para>
  <para style="p">
    <verse number="15" style="v"/>એતસ્મિન્ પવિત્ર આત્માપ્યસ્માકં પક્ષે પ્રમાણયતિ</para>
  <para style="p">
    <verse number="16" style="v"/>"યતો હેતોસ્તદ્દિનાત્ પરમ્ અહં તૈઃ સાર્દ્ધમ્ ઇમં નિયમં સ્થિરીકરિષ્યામીતિ પ્રથમત ઉક્ત્વા પરમેશ્વરેણેદં કથિતં, તેષાં ચિત્તે મમ વિધીન્ સ્થાપયિષ્યામિ તેષાં મનઃસુ ચ તાન્ લેખિષ્યામિ ચ,</para>
  <para style="p">
    <verse number="17" style="v"/>અપરઞ્ચ તેષાં પાપાન્યપરાધાંશ્ચ પુનઃ કદાપિ ન સ્મારિષ્યામિ| "</para>
  <para style="p">
    <verse number="18" style="v"/>કિન્તુ યત્ર પાપમોચનં ભવતિ તત્ર પાપાર્થકબલિદાનં પુન ર્ન ભવતિ|</para>
  <para style="p">
    <verse number="19" style="v"/>અતો હે ભ્રાતરઃ, યીશો રુધિરેણ પવિત્રસ્થાનપ્રવેશાયાસ્માકમ્ ઉત્સાહો ભવતિ,</para>
  <para style="p">
    <verse number="20" style="v"/>યતઃ સોઽસ્મદર્થં તિરસ્કરિણ્યાર્થતઃ સ્વશરીરેણ નવીનં જીવનયુક્તઞ્ચૈકં પન્થાનં નિર્મ્મિતવાન્,</para>
  <para style="p">
    <verse number="21" style="v"/>અપરઞ્ચેશ્વરીયપરિવારસ્યાધ્યક્ષ એકો મહાયાજકોઽસ્માકમસ્તિ|</para>
  <para style="p">
    <verse number="22" style="v"/>અતો હેતોરસ્માભિઃ સરલાન્તઃકરણૈ ર્દૃઢવિશ્વાસૈઃ પાપબોધાત્ પ્રક્ષાલિતમનોભિ ર્નિર્મ્મલજલે સ્નાતશરીરૈશ્ચેશ્વરમ્ ઉપાગત્ય પ્રત્યાશાયાઃ પ્રતિજ્ઞા નિશ્ચલા ધારયિતવ્યા|</para>
  <para style="p">
    <verse number="23" style="v"/>યતો યસ્તામ્ અઙ્ગીકૃતવાન્ સ વિશ્વસનીયઃ|</para>
  <para style="p">
    <verse number="24" style="v"/>અપરં પ્રેમ્નિ સત્ક્રિયાસુ ચૈકૈકસ્યોત્સાહવૃદ્ધ્યર્થમ્ અસ્માભિઃ પરસ્પરં મન્ત્રયિતવ્યં|</para>
  <para style="p">
    <verse number="25" style="v"/>અપરં કતિપયલોકા યથા કુર્વ્વન્તિ તથાસ્માભિઃ સભાકરણં ન પરિત્યક્તવ્યં પરસ્પરમ્ ઉપદેષ્ટવ્યઞ્ચ યતસ્તત્ મહાદિનમ્ ઉત્તરોત્તરં નિકટવર્ત્તિ ભવતીતિ યુષ્માભિ ર્દૃશ્યતે|</para>
  <para style="p">
    <verse number="26" style="v"/>સત્યમતસ્ય જ્ઞાનપ્રાપ્તેઃ પરં યદિ વયં સ્વંચ્છયા પાપાચારં કુર્મ્મસ્તર્હિ પાપાનાં કૃતે ઽન્યત્ કિમપિ બલિદાનં નાવશિષ્યતે</para>
  <para style="p">
    <verse number="27" style="v"/>કિન્તુ વિચારસ્ય ભયાનકા પ્રતીક્ષા રિપુનાશકાનલસ્ય તાપશ્ચાવશિષ્યતે|</para>
  <para style="p">
    <verse number="28" style="v"/>યઃ કશ્ચિત્ મૂસસો વ્યવસ્થામ્ અવમન્યતે સ દયાં વિના દ્વયોસ્તિસૃણાં વા સાક્ષિણાં પ્રમાણેન હન્યતે,</para>
  <para style="p">
    <verse number="29" style="v"/>તસ્માત્ કિં બુધ્યધ્વે યો જન ઈશ્વરસ્ય પુત્રમ્ અવજાનાતિ યેન ચ પવિત્રીકૃતો ઽભવત્ તત્ નિયમસ્ય રુધિરમ્ અપવિત્રં જાનાતિ, અનુગ્રહકરમ્ આત્માનમ્ અપમન્યતે ચ, સ કિયન્મહાઘોરતરદણ્ડસ્ય યોગ્યો ભવિષ્યતિ?</para>
  <para style="p">
    <verse number="30" style="v"/>યતઃ પરમેશ્વરઃ કથયતિ, "દાનં ફલસ્ય મત્કર્મ્મ સૂચિતં પ્રદદામ્યહં| " પુનરપિ, "તદા વિચારયિષ્યન્તે પરેશેન નિજાઃ પ્રજાઃ| " ઇદં યઃ કથિતવાન્ તં વયં જાનીમઃ|</para>
  <para style="p">
    <verse number="31" style="v"/>અમરેશ્વરસ્ય કરયોઃ પતનં મહાભયાનકં|</para>
  <para style="p">
    <verse number="32" style="v"/>હે ભ્રાતરઃ, પૂર્વ્વદિનાનિ સ્મરત યતસ્તદાનીં યૂયં દીપ્તિં પ્રાપ્ય બહુદુર્ગતિરૂપં સંગ્રામં સહમાના એકતો નિન્દાક્લેશૈઃ કૌતુકીકૃતા અભવત,</para>
  <para style="p">
    <verse number="33" style="v"/>અન્યતશ્ચ તદ્ભોગિનાં સમાંશિનો ઽભવત|</para>
  <para style="p">
    <verse number="34" style="v"/>યૂયં મમ બન્ધનસ્ય દુઃખેન દુઃખિનો ઽભવત, યુષ્માકમ્ ઉત્તમા નિત્યા ચ સમ્પત્તિઃ સ્વર્ગે વિદ્યત ઇતિ જ્ઞાત્વા સાનન્દં સર્વ્વસ્વસ્યાપહરણમ્ અસહધ્વઞ્ચ|</para>
  <para style="p">
    <verse number="35" style="v"/>અતએવ મહાપુરસ્કારયુક્તં યુષ્માકમ્ ઉત્સાહં ન પરિત્યજત|</para>
  <para style="p">
    <verse number="36" style="v"/>યતો યૂયં યેનેશ્વરસ્યેચ્છાં પાલયિત્વા પ્રતિજ્ઞાયાઃ ફલં લભધ્વં તદર્થં યુષ્માભિ ર્ધૈર્ય્યાવલમ્બનં કર્ત્તવ્યં|</para>
  <para style="p">
    <verse number="37" style="v"/>યેનાગન્તવ્યં સ સ્વલ્પકાલાત્ પરમ્ આગમિષ્યતિ ન ચ વિલમ્બિષ્યતે|</para>
  <para style="p">
    <verse number="38" style="v"/>"પુણ્યવાન્ જનો વિશ્વાસેન જીવિષ્યતિ કિન્તુ યદિ નિવર્ત્તતે તર્હિ મમ મનસ્તસ્મિન્ ન તોષં યાસ્યતિ| "</para>
  <para style="p">
    <verse number="39" style="v"/>કિન્તુ વયં વિનાશજનિકાં ધર્મ્માત્ નિવૃત્તિં ન કુર્વ્વાણા આત્મનઃ પરિત્રાણાય વિશ્વાસં કુર્વ્વામહેे|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>વિશ્વાસ આશંસિતાનાં નિશ્ચયઃ, અદૃશ્યાનાં વિષયાણાં દર્શનં ભવતિ|</para>
  <para style="p">
    <verse number="2" style="v"/>તેન વિશ્વાસેન પ્રાઞ્ચો લોકાઃ પ્રામાણ્યં પ્રાપ્તવન્તઃ|</para>
  <para style="p">
    <verse number="3" style="v"/>અપરમ્ ઈશ્વરસ્ય વાક્યેન જગન્ત્યસૃજ્યન્ત, દૃષ્ટવસ્તૂનિ ચ પ્રત્યક્ષવસ્તુભ્યો નોદપદ્યન્તૈતદ્ વયં વિશ્વાસેન બુધ્યામહે|</para>
  <para style="p">
    <verse number="4" style="v"/>વિશ્વાસેન હાબિલ્ ઈશ્વરમુદ્દિશ્ય કાબિલઃ શ્રેષ્ઠં બલિદાનં કૃતવાન્ તસ્માચ્ચેશ્વરેણ તસ્ય દાનાન્યધિ પ્રમાણે દત્તે સ ધાર્મ્મિક ઇત્યસ્ય પ્રમાણં લબ્ધવાન્ તેન વિશ્વાસેન ચ સ મૃતઃ સન્ અદ્યાપિ ભાષતે|</para>
  <para style="p">
    <verse number="5" style="v"/>વિશ્વાસેન હનોક્ યથા મૃત્યું ન પશ્યેત્ તથા લોકાન્તરં નીતઃ, તસ્યોદ્દેશશ્ચ કેનાપિ ન પ્રાપિ યત ઈશ્વરસ્તં લોકાન્તરં નીતવાન્, તત્પ્રમાણમિદં તસ્ય લોકાન્તરીકરણાત્ પૂર્વ્વં સ ઈશ્વરાય રોચિતવાન્ ઇતિ પ્રમાણં પ્રાપ્તવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>કિન્તુ વિશ્વાસં વિના કોઽપીશ્વરાય રોચિતું ન શક્નોતિ યત ઈશ્વરોઽસ્તિ સ્વાન્વેષિલોકેભ્યઃ પુરસ્કારં દદાતિ ચેતિકથાયામ્ ઈશ્વરશરણાગતૈ ર્વિશ્વસિતવ્યં|</para>
  <para style="p">
    <verse number="7" style="v"/>અપરં તદાનીં યાન્યદૃશ્યાન્યાસન્ તાનીશ્વરેણાદિષ્ટઃ સન્ નોહો વિશ્વાસેન ભીત્વા સ્વપરિજનાનાં રક્ષાર્થં પોતં નિર્મ્મિતવાન્ તેન ચ જગજ્જનાનાં દોષાન્ દર્શિતવાન્ વિશ્વાસાત્ લભ્યસ્ય પુણ્યસ્યાધિકારી બભૂવ ચ|</para>
  <para style="p">
    <verse number="8" style="v"/>વિશ્વાસેનેબ્રાહીમ્ આહૂતઃ સન્ આજ્ઞાં ગૃહીત્વા યસ્ય સ્થાનસ્યાધિકારસ્તેન પ્રાપ્તવ્યસ્તત્ સ્થાનં પ્રસ્થિતવાન્ કિન્તુ પ્રસ્થાનસમયે ક્ક યામીતિ નાજાનાત્|</para>
  <para style="p">
    <verse number="9" style="v"/>વિશ્વાસેન સ પ્રતિજ્ઞાતે દેશે પરદેશવત્ પ્રવસન્ તસ્યાઃ પ્રતિજ્ઞાયાઃ સમાનાંશિભ્યામ્ ઇસ્હાકા યાકૂબા ચ સહ દૂષ્યવાસ્યભવત્|</para>
  <para style="p">
    <verse number="10" style="v"/>યસ્માત્ સ ઈશ્વરેણ નિર્મ્મિતં સ્થાપિતઞ્ચ ભિત્તિમૂલયુક્તં નગરં પ્રત્યૈક્ષત|</para>
  <para style="p">
    <verse number="11" style="v"/>અપરઞ્ચ વિશ્વાસેન સારા વયોતિક્રાન્તા સન્ત્યપિ ગર્ભધારણાય શક્તિં પ્રાપ્ય પુત્રવત્યભવત્, યતઃ સા પ્રતિજ્ઞાકારિણં વિશ્વાસ્યમ્ અમન્યત|</para>
  <para style="p">
    <verse number="12" style="v"/>તતો હેતો ર્મૃતકલ્પાદ્ એકસ્માત્ જનાદ્ આકાશીયનક્ષત્રાણીવ ગણનાતીતાઃ સમુદ્રતીરસ્થસિકતા ઇવ ચાસંખ્યા લોકા ઉત્પેદિરે|</para>
  <para style="p">
    <verse number="13" style="v"/>એતે સર્વ્વે પ્રતિજ્ઞાયાઃ ફલાન્યપ્રાપ્ય કેવલં દૂરાત્ તાનિ નિરીક્ષ્ય વન્દિત્વા ચ, પૃથિવ્યાં વયં વિદેશિનઃ પ્રવાસિનશ્ચાસ્મહ ઇતિ સ્વીકૃત્ય વિશ્વાસેન પ્રાણાન્ તત્યજુઃ|</para>
  <para style="p">
    <verse number="14" style="v"/>યે તુ જના ઇત્થં કથયન્તિ તૈઃ પૈતૃકદેશો ઽસ્માભિરન્વિષ્યત ઇતિ પ્રકાશ્યતે|</para>
  <para style="p">
    <verse number="15" style="v"/>તે યસ્માદ્ દેશાત્ નિર્ગતાસ્તં યદ્યસ્મરિષ્યન્ તર્હિ પરાવર્ત્તનાય સમયમ્ અલપ્સ્યન્ત|</para>
  <para style="p">
    <verse number="16" style="v"/>કિન્તુ તે સર્વ્વોત્કૃષ્ટમ્ અર્થતઃ સ્વર્ગીયં દેશમ્ આકાઙ્ક્ષન્તિ તસ્માદ્ ઈશ્વરસ્તાનધિ ન લજ્જમાનસ્તેષામ્ ઈશ્વર ઇતિ નામ ગૃહીતવાન્ યતઃ સ તેષાં કૃતે નગરમેકં સંસ્થાપિતવાન્|</para>
  <para style="p">
    <verse number="17" style="v"/>અપરમ્ ઇબ્રાહીમઃ પરીક્ષાયાં જાતાયાં સ વિશ્વાસેનેસ્હાકમ્ ઉત્સસર્જ,</para>
  <para style="p">
    <verse number="18" style="v"/>વસ્તુત ઇસ્હાકિ તવ વંશો વિખ્યાસ્યત ઇતિ વાગ્ યમધિ કથિતા તમ્ અદ્વિતીયં પુત્રં પ્રતિજ્ઞાપ્રાપ્તઃ સ ઉત્સસર્જ|</para>
  <para style="p">
    <verse number="19" style="v"/>યત ઈશ્વરો મૃતાનપ્યુત્થાપયિતું શક્નોતીતિ સ મેને તસ્માત્ સ ઉપમારૂપં તં લેભે|</para>
  <para style="p">
    <verse number="20" style="v"/>અપરમ્ ઇસ્હાક્ વિશ્વાસેન યાકૂબ્ એષાવે ચ ભાવિવિષયાનધ્યાશિષં દદૌ|</para>
  <para style="p">
    <verse number="21" style="v"/>અપરં યાકૂબ્ મરણકાલે વિશ્વાસેન યૂષફઃ પુત્રયોરેકૈકસ્મૈ જનાયાશિષં દદૌ યષ્ટ્યા અગ્રભાગે સમાલમ્બ્ય પ્રણનામ ચ|</para>
  <para style="p">
    <verse number="22" style="v"/>અપરં યૂષફ્ ચરમકાલે વિશ્વાસેનેસ્રાયેલ્વંશીયાનાં મિસરદેશાદ્ બહિર્ગમનસ્ય વાચં જગાદ નિજાસ્થીનિ ચાધિ સમાદિદેશ|</para>
  <para style="p">
    <verse number="23" style="v"/>નવજાતો મૂસાશ્ચ વિશ્વાસાત્ ત્રાीન્ માસાન્ સ્વપિતૃભ્યામ્ અગોપ્યત યતસ્તૌ સ્વશિશું પરમસુન્દરં દૃષ્ટવન્તૌ રાજાજ્ઞાઞ્ચ ન શઙ્કિતવન્તૌ|</para>
  <para style="p">
    <verse number="24" style="v"/>અપરં વયઃપ્રાપ્તો મૂસા વિશ્વાસાત્ ફિરૌણો દૌહિત્ર ઇતિ નામ નાઙ્ગીચકાર|</para>
  <para style="p">
    <verse number="25" style="v"/>યતઃ સ ક્ષણિકાત્ પાપજસુખભોગાદ્ ઈશ્વરસ્ય પ્રજાભિઃ સાર્દ્ધં દુઃખભોગં વવ્રે|</para>
  <para style="p">
    <verse number="26" style="v"/>તથા મિસરદેશીયનિધિભ્યઃ ખ્રીષ્ટનિમિત્તાં નિન્દાં મહતીં સમ્પત્તિં મેને યતો હેતોઃ સ પુરસ્કારદાનમ્ અપૈક્ષત|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરં સ વિશ્વાસેન રાજ્ઞઃ ક્રોધાત્ ન ભીત્વા મિસરદેશં પરિતત્યાજ, યતસ્તેનાદૃશ્યં વીક્ષમાણેનેવ ધૈર્ય્યમ્ આલમ્બિ|</para>
  <para style="p">
    <verse number="28" style="v"/>અપરં પ્રથમજાતાનાં હન્તા યત્ સ્વીયલોકાન્ ન સ્પૃશેત્ તદર્થં સ વિશ્વાસેન નિસ્તારપર્વ્વીયબલિચ્છેદનં રુધિરસેચનઞ્ચાનુષ્ઠિતાવાન્|</para>
  <para style="p">
    <verse number="29" style="v"/>અપરં તે વિશ્વાસાત્ સ્થલેનેવ સૂફ્સાગરેણ જગ્મુઃ કિન્તુ મિસ્રીયલોકાસ્તત્ કર્ત્તુમ્ ઉપક્રમ્ય તોયેષુ મમજ્જુઃ|</para>
  <para style="p">
    <verse number="30" style="v"/>અપરઞ્ચ વિશ્વાસાત્ તૈઃ સપ્તાહં યાવદ્ યિરીહોઃ પ્રાચીરસ્ય પ્રદક્ષિણે કૃતે તત્ નિપપાત|</para>
  <para style="p">
    <verse number="31" style="v"/>વિશ્વાસાદ્ રાહબ્નામિકા વેશ્યાપિ પ્રીત્યા ચારાન્ અનુગૃહ્યાવિશ્વાસિભિઃ સાર્દ્ધં ન વિનનાશ|</para>
  <para style="p">
    <verse number="32" style="v"/>અધિકં કિં કથયિષ્યામિ? ગિદિયોનો બારકઃ શિમ્શોનો યિપ્તહો દાયૂદ્ શિમૂયેલો ભવિષ્યદ્વાદિનશ્ચૈતેષાં વૃત્તાન્તકથનાય મમ સમયાભાવો ભવિષ્યતિ|</para>
  <para style="p">
    <verse number="33" style="v"/>વિશ્વાસાત્ તે રાજ્યાનિ વશીકૃતવન્તો ધર્મ્મકર્મ્માણિ સાધિતવન્તઃ પ્રતિજ્ઞાનાં ફલં લબ્ધવન્તઃ સિંહાનાં મુખાનિ રુદ્ધવન્તો</para>
  <para style="p">
    <verse number="34" style="v"/>વહ્નેર્દાહં નિર્વ્વાપિતવન્તઃ ખઙ્ગધારાદ્ રક્ષાં પ્રાપ્તવન્તો દૌર્બ્બલ્યે સબલીકૃતા યુદ્ધે પરાક્રમિણો જાતાઃ પરેષાં સૈન્યાનિ દવયિતવન્તશ્ચ|</para>
  <para style="p">
    <verse number="35" style="v"/>યોષિતઃ પુનરુત્થાનેન મૃતાન્ આત્મજાન્ લેભિરેे, અપરે ચ શ્રેષ્ઠોત્થાનસ્ય પ્રાપ્તેરાશયા રક્ષામ્ અગૃહીત્વા તાડનેન મૃતવન્તઃ|</para>
  <para style="p">
    <verse number="36" style="v"/>અપરે તિરસ્કારૈઃ કશાભિ ર્બન્ધનૈઃ કારયા ચ પરીક્ષિતાઃ|</para>
  <para style="p">
    <verse number="37" style="v"/>બહવશ્ચ પ્રસ્તરાઘાતૈ ર્હતાઃ કરપત્રૈ ર્વા વિદીર્ણા યન્ત્રૈ ર્વા ક્લિષ્ટાઃ ખઙ્ગધારૈ ર્વા વ્યાપાદિતાઃ| તે મેષાણાં છાગાનાં વા ચર્મ્માણિ પરિધાય દીનાઃ પીડિતા દુઃખાર્ત્તાશ્ચાભ્રામ્યન્|</para>
  <para style="p">
    <verse number="38" style="v"/>સંસારો યેષામ્ અયોગ્યસ્તે નિર્જનસ્થાનેષુ પર્વ્વતેષુ ગહ્વરેષુ પૃથિવ્યાશ્છિદ્રેષુ ચ પર્ય્યટન્|</para>
  <para style="p">
    <verse number="39" style="v"/>એતૈઃ સર્વ્વૈ ર્વિશ્વાસાત્ પ્રમાણં પ્રાપિ કિન્તુ પ્રતિજ્ઞાયાઃ ફલં ન પ્રાપિ|</para>
  <para style="p">
    <verse number="40" style="v"/>યતસ્તે યથાસ્માન્ વિના સિદ્ધા ન ભવેયુસ્તથૈવેશ્વરેણાસ્માકં કૃતે શ્રેષ્ઠતરં કિમપિ નિર્દિદિશે|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અતો હેતોરેતાવત્સાક્ષિમેઘૈ ર્વેષ્ટિતાઃ સન્તો વયમપિ સર્વ્વભારમ્ આશુબાધકં પાપઞ્ચ નિક્ષિપ્યાસ્માકં ગમનાય નિરૂપિતે માર્ગે ધૈર્ય્યેણ ધાવામ|</para>
  <para style="p">
    <verse number="2" style="v"/>યશ્ચાસ્માકં વિશ્વાસસ્યાગ્રેસરઃ સિદ્ધિકર્ત્તા ચાસ્તિ તં યીશું વીક્ષામહૈ યતઃ સ સ્વસમ્મુખસ્થિતાનન્દસ્ય પ્રાપ્ત્યર્થમ્ અપમાનં તુચ્છીકૃત્ય ક્રુશસ્ય યાતનાં સોઢવાન્ ઈશ્વરીયસિંહાસનસ્ય દક્ષિણપાર્શ્વે સમુપવિષ્ટવાંશ્ચ|</para>
  <para style="p">
    <verse number="3" style="v"/>યઃ પાપિભિઃ સ્વવિરુદ્ધમ્ એતાદૃશં વૈપરીત્યં સોઢવાન્ તમ્ આલોચયત તેન યૂયં સ્વમનઃસુ શ્રાન્તાઃ ક્લાન્તાશ્ચ ન ભવિષ્યથ|</para>
  <para style="p">
    <verse number="4" style="v"/>યૂયં પાપેન સહ યુધ્યન્તોઽદ્યાપિ શોણિતવ્યયપર્ય્યન્તં પ્રતિરોધં નાકુરુત|</para>
  <para style="p">
    <verse number="5" style="v"/>તથા ચ પુત્રાન્ પ્રતીવ યુષ્માન્ પ્રતિ ય ઉપદેશ ઉક્તસ્તં કિં વિસ્મૃતવન્તઃ? "પરેશેન કૃતાં શાસ્તિં હે મત્પુત્ર ન તુચ્છય| તેન સંભર્ત્સિતશ્ચાપિ નૈવ ક્લામ્ય કદાચન|</para>
  <para style="p">
    <verse number="6" style="v"/>પરેશઃ પ્રીયતે યસ્મિન્ તસ્મૈ શાસ્તિં દદાતિ યત્| યન્તુ પુત્રં સ ગૃહ્લાતિ તમેવ પ્રહરત્યપિ| "</para>
  <para style="p">
    <verse number="7" style="v"/>યદિ યૂયં શાસ્તિં સહધ્વં તર્હીશ્વરઃ પુત્રૈરિવ યુષ્માભિઃ સાર્દ્ધં વ્યવહરતિ યતઃ પિતા યસ્મૈ શાસ્તિં ન દદાતિ તાદૃશઃ પુત્રઃ કઃ?</para>
  <para style="p">
    <verse number="8" style="v"/>સર્વ્વે યસ્યાઃ શાસ્તેરંશિનો ભવન્તિ સા યદિ યુષ્માકં ન ભવતિ તર્હિ યૂયમ્ આત્મજા ન કિન્તુ જારજા આધ્વે|</para>
  <para style="p">
    <verse number="9" style="v"/>અપરમ્ અસ્માકં શારીરિકજન્મદાતારોઽસ્માકં શાસ્તિકારિણોઽભવન્ તે ચાસ્માભિઃ સમ્માનિતાસ્તસ્માદ્ ય આત્મનાં જનયિતા વયં કિં તતોઽધિકં તસ્ય વશીભૂય ન જીવિષ્યામઃ?</para>
  <para style="p">
    <verse number="10" style="v"/>તે ત્વલ્પદિનાનિ યાવત્ સ્વમનોઽમતાનુસારેણ શાસ્તિં કૃતવન્તઃ કિન્ત્વેષોઽસ્માકં હિતાય તસ્ય પવિત્રતાયા અંશિત્વાય ચાસ્માન્ શાસ્તિ|</para>
  <para style="p">
    <verse number="11" style="v"/>શાસ્તિશ્ચ વર્ત્તમાનસમયે કેનાપિ નાનન્દજનિકા કિન્તુ શોકજનિકૈવ મન્યતે તથાપિ યે તયા વિનીયન્તે તેભ્યઃ સા પશ્ચાત્ શાન્તિયુક્તં ધર્મ્મફલં દદાતિ|</para>
  <para style="p">
    <verse number="12" style="v"/>અતએવ યૂયં શિથિલાન્ હસ્તાન્ દુર્બ્બલાનિ જાનૂનિ ચ સબલાનિ કુરુધ્વં|</para>
  <para style="p">
    <verse number="13" style="v"/>યથા ચ દુર્બ્બલસ્ય સન્ધિસ્થાનં ન ભજ્યેત સ્વસ્થં તિષ્ઠેત્ તથા સ્વચરણાર્થં સરલં માર્ગં નિર્મ્માત|</para>
  <para style="p">
    <verse number="14" style="v"/>અપરઞ્ચ સર્વ્વૈઃ સાર્થમ્ એेક્યભાવં યચ્ચ વિના પરમેશ્વરસ્ય દર્શનં કેનાપિ ન લપ્સ્યતે તત્ પવિત્રત્વં ચેષ્ટધ્વં|</para>
  <para style="p">
    <verse number="15" style="v"/>યથા કશ્ચિદ્ ઈશ્વરસ્યાનુગ્રહાત્ ન પતેત્, યથા ચ તિક્તતાયા મૂલં પ્રરુહ્ય બાધાજનકં ન ભવેત્ તેન ચ બહવોઽપવિત્રા ન ભવેયુઃ,</para>
  <para style="p">
    <verse number="16" style="v"/>યથા ચ કશ્ચિત્ લમ્પટો વા એકકૃત્વ આહારાર્થં સ્વીયજ્યેષ્ઠાધિકારવિક્રેતા ય એષૌસ્તદ્વદ્ અધર્મ્માચારી ન ભવેત્ તથા સાવધાના ભવત|</para>
  <para style="p">
    <verse number="17" style="v"/>યતઃ સ એષૌઃ પશ્ચાદ્ આશીર્વ્વાદાધિકારી ભવિતુમ્ ઇચ્છન્નપિ નાનુગૃહીત ઇતિ યૂયં જાનીથ, સ ચાશ્રુપાતેન મત્યન્તરં પ્રાર્થયમાનોઽપિ તદુપાયં ન લેભે|</para>
  <para style="p">
    <verse number="18" style="v"/>અપરઞ્ચ સ્પૃશ્યઃ પર્વ્વતઃ પ્રજ્વલિતો વહ્નિઃ કૃષ્ણાવર્ણો મેઘો ઽન્ધકારો ઝઞ્ભ્શ તૂરીવાદ્યં વાક્યાનાં શબ્દશ્ચ નૈતેષાં સન્નિધૌ યૂયમ્ આગતાઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>તં શબ્દં શ્રુત્વા શ્રોતારસ્તાદૃશં સમ્ભાષણં યત્ પુન ર્ન જાયતે તત્ પ્રાર્થિતવન્તઃ|</para>
  <para style="p">
    <verse number="20" style="v"/>યતઃ પશુરપિ યદિ ધરાધરં સ્પૃશતિ તર્હિ સ પાષાણાઘાતૈ ર્હન્તવ્ય ઇત્યાદેશં સોઢું તે નાશક્નુવન્|</para>
  <para style="p">
    <verse number="21" style="v"/>તચ્ચ દર્શનમ્ એવં ભયાનકં યત્ મૂસસોક્તં ભીતસ્ત્રાસયુક્તશ્ચાસ્મીતિ|</para>
  <para style="p">
    <verse number="22" style="v"/>કિન્તુ સીયોન્પર્વ્વતો ઽમરેશ્વરસ્ય નગરં સ્વર્ગસ્થયિરૂશાલમમ્ અયુતાનિ દિવ્યદૂતાઃ</para>
  <para style="p">
    <verse number="23" style="v"/>સ્વર્ગે લિખિતાનાં પ્રથમજાતાનામ્ ઉત્સવઃ સમિતિશ્ચ સર્વ્વેષાં વિચારાધિપતિરીશ્વરઃ સિદ્ધીકૃતધાર્મ્મિકાનામ્ આત્માનો</para>
  <para style="p">
    <verse number="24" style="v"/>નૂતનનિયમસ્ય મધ્યસ્થો યીશુઃ, અપરં હાબિલો રક્તાત્ શ્રેયઃ પ્રચારકં પ્રોક્ષણસ્ય રક્તઞ્ચૈતેષાં સન્નિધૌ યૂયમ્ આગતાઃ|</para>
  <para style="p">
    <verse number="25" style="v"/>સાવધાના ભવત તં વક્તારં નાવજાનીત યતો હેતોઃ પૃથિવીસ્થિતઃ સ વક્તા યૈરવજ્ઞાતસ્તૈ ર્યદિ રક્ષા નાપ્રાપિ તર્હિ સ્વર્ગીયવક્તુઃ પરાઙ્મુખીભૂયાસ્માભિઃ કથં રક્ષા પ્રાપ્સ્યતે?</para>
  <para style="p">
    <verse number="26" style="v"/>તદા તસ્ય રવાત્ પૃથિવી કમ્પિતા કિન્ત્વિદાનીં તેનેદં પ્રતિજ્ઞાતં યથા, "અહં પુનરેકકૃત્વઃ પૃથિવીં કમ્પયિષ્યામિ કેવલં તન્નહિ ગગનમપિ કમ્પયિષ્યામિ| "</para>
  <para style="p">
    <verse number="27" style="v"/>સ એકકૃત્વઃ શબ્દો નિશ્ચલવિષયાણાં સ્થિતયે નિર્મ્મિતાનામિવ ચઞ્ચલવસ્તૂનાં સ્થાનાન્તરીકરણં પ્રકાશયતિ|</para>
  <para style="p">
    <verse number="28" style="v"/>અતએવ નિશ્ચલરાજ્યપ્રાપ્તૈરસ્માભિઃ સોઽનુગ્રહ આલમ્બિતવ્યો યેન વયં સાદરં સભયઞ્ચ તુષ્ટિજનકરૂપેણેશ્વરં સેવિતું શક્નુયામ|</para>
  <para style="p">
    <verse number="29" style="v"/>યતોઽસ્માકમ્ ઈશ્વરઃ સંહારકો વહ્નિઃ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ભ્રાતૃષુ પ્રેમ તિષ્ઠતુ| અતિથિસેવા યુષ્માભિ ર્ન વિસ્મર્ય્યતાં</para>
  <para style="p">
    <verse number="2" style="v"/>યતસ્તયા પ્રચ્છન્નરૂપેણ દિવ્યદૂતાઃ કેષાઞ્ચિદ્ અતિથયોઽભવન્|</para>
  <para style="p">
    <verse number="3" style="v"/>બન્દિનઃ સહબન્દિભિરિવ દુઃખિનશ્ચ દેહવાસિભિરિવ યુષ્માભિઃ સ્મર્ય્યન્તાં|</para>
  <para style="p">
    <verse number="4" style="v"/>વિવાહઃ સર્વ્વેષાં સમીપે સમ્માનિતવ્યસ્તદીયશય્યા ચ શુચિઃ કિન્તુ વેશ્યાગામિનઃ પારદારિકાશ્ચેશ્વરેણ દણ્ડયિષ્યન્તે|</para>
  <para style="p">
    <verse number="5" style="v"/>યૂયમ્ આચારે નિર્લોભા ભવત વિદ્યમાનવિષયે સન્તુષ્યત ચ યસ્માદ્ ઈશ્વર એવેદં કથિતવાન્, યથા, "ત્વાં ન ત્યક્ષ્યામિ ન ત્વાં હાસ્યામિ| "</para>
  <para style="p">
    <verse number="6" style="v"/>અતએવ વયમ્ ઉત્સાહેનેદં કથયિતું શક્નુમઃ, "મત્પક્ષે પરમેશોઽસ્તિ ન ભેષ્યામિ કદાચન| યસ્માત્ માં પ્રતિ કિં કર્ત્તું માનવઃ પારયિષ્યતિ|| "</para>
  <para style="p">
    <verse number="7" style="v"/>યુષ્માકં યે નાયકા યુષ્મભ્યમ્ ઈશ્વરસ્ય વાક્યં કથિતવન્તસ્તે યુષ્માભિઃ સ્મર્ય્યન્તાં તેષામ્ આચારસ્ય પરિણામમ્ આલોચ્ય યુષ્માભિસ્તેષાં વિશ્વાસોઽનુક્રિયતાં|</para>
  <para style="p">
    <verse number="8" style="v"/>યીશુઃ ખ્રીષ્ટઃ શ્વોઽદ્ય સદા ચ સ એવાસ્તે|</para>
  <para style="p">
    <verse number="9" style="v"/>યૂયં નાનાવિધનૂતનશિક્ષાભિ ર્ન પરિવર્ત્તધ્વં યતોઽનુગ્રહેણાન્તઃકરણસ્ય સુસ્થિરીભવનં ક્ષેમં ન ચ ખાદ્યદ્રવ્યૈઃ| યતસ્તદાચારિણસ્તૈ ર્નોપકૃતાઃ|</para>
  <para style="p">
    <verse number="10" style="v"/>યે દષ્યસ્ય સેવાં કુર્વ્વન્તિ તે યસ્યા દ્રવ્યભોજનસ્યાનધિકારિણસ્તાદૃશી યજ્ઞવેદિરસ્માકમ્ આસ્તે|</para>
  <para style="p">
    <verse number="11" style="v"/>યતો યેષાં પશૂનાં શોણિતં પાપનાશાય મહાયાજકેન મહાપવિત્રસ્થાનસ્યાભ્યન્તરં નીયતે તેષાં શરીરાણિ શિબિરાદ્ બહિ ર્દહ્યન્તે|</para>
  <para style="p">
    <verse number="12" style="v"/>તસ્માદ્ યીશુરપિ યત્ સ્વરુધિરેણ પ્રજાઃ પવિત્રીકુર્ય્યાત્ તદર્થં નગરદ્વારસ્ય બહિ ર્મૃતિં ભુક્તવાન્|</para>
  <para style="p">
    <verse number="13" style="v"/>અતો હેતોરસ્માભિરપિ તસ્યાપમાનં સહમાનૈઃ શિબિરાદ્ બહિસ્તસ્ય સમીપં ગન્તવ્યં|</para>
  <para style="p">
    <verse number="14" style="v"/>યતો ઽત્રાસ્માકં સ્થાયિ નગરં ન વિદ્યતે કિન્તુ ભાવિ નગરમ્ અસ્માભિરન્વિષ્યતે|</para>
  <para style="p">
    <verse number="15" style="v"/>અતએવ યીશુનાસ્માભિ ર્નિત્યં પ્રશંસારૂપો બલિરર્થતસ્તસ્ય નામાઙ્ગીકુર્વ્વતામ્ ઓષ્ઠાધરાણાં ફલમ્ ઈશ્વરાય દાતવ્યં|</para>
  <para style="p">
    <verse number="16" style="v"/>અપરઞ્ચ પરોપકારો દાનઞ્ચ યુષ્માભિ ર્ન વિસ્મર્ય્યતાં યતસ્તાદૃશં બલિદાનમ્ ઈશ્વરાય રોચતે|</para>
  <para style="p">
    <verse number="17" style="v"/>યૂયં સ્વનાયકાનામ્ આજ્ઞાગ્રાહિણો વશ્યાશ્ચ ભવત યતો યૈરુપનિધિઃ પ્રતિદાતવ્યસ્તાદૃશા લોકા ઇવ તે યુષ્મદીયાત્મનાં રક્ષણાર્થં જાગ્રતિ, અતસ્તે યથા સાનન્દાસ્તત્ કુર્ય્યુ ર્ન ચ સાર્ત્તસ્વરા અત્ર યતધ્વં યતસ્તેષામ્ આર્ત્તસ્વરો યુષ્માકમ્ ઇષ્ટજનકો ન ભવેત્|</para>
  <para style="p">
    <verse number="18" style="v"/>અપરઞ્ચ યૂયમ્ અસ્મન્નિમિત્તિં પ્રાર્થનાં કુરુત યતો વયમ્ ઉત્તમમનોવિશિષ્ટાઃ સર્વ્વત્ર સદાચારં કર્ત્તુમ્ ઇચ્છુકાશ્ચ ભવામ ઇતિ નિશ્ચિતં જાનીમઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>વિશેષતોઽહં યથા ત્વરયા યુષ્મભ્યં પુન ર્દીયે તદર્થં પ્રાર્થનાયૈ યુષ્માન્ અધિકં વિનયે|</para>
  <para style="p">
    <verse number="20" style="v"/>અનન્તનિયમસ્ય રુધિરેણ વિશિષ્ટો મહાન્ મેષપાલકો યેન મૃતગણમધ્યાત્ પુનરાનાયિ સ શાન્તિદાયક ઈશ્વરો</para>
  <para style="p">
    <verse number="21" style="v"/>નિજાભિમતસાધનાય સર્વ્વસ્મિન્ સત્કર્મ્મણિ યુષ્માન્ સિદ્ધાન્ કરોતુ, તસ્ય દૃષ્ટૌ ચ યદ્યત્ તુષ્ટિજનકં તદેવ યુષ્માકં મધ્યે યીશુના ખ્રીષ્ટેન સાધયતુ| તસ્મૈ મહિમા સર્વ્વદા ભૂયાત્| આમેન્|</para>
  <para style="p">
    <verse number="22" style="v"/>હે ભ્રાતરઃ, વિનયેઽહં યૂયમ્ ઇદમ્ ઉપદેશવાક્યં સહધ્વં યતોઽહં સંક્ષેપેણ યુષ્માન્ પ્રતિ લિખિતવાન્|</para>
  <para style="p">
    <verse number="23" style="v"/>અસ્માકં ભ્રાતા તીમથિયો મુક્તોઽભવદ્ ઇતિ જાનીત, સ ચ યદિ ત્વરયા સમાગચ્છતિ તર્હિ તેન સાર્દ્ધંમ્ અહં યુષ્માન્ સાક્ષાત્ કરિષ્યામિ|</para>
  <para style="p">
    <verse number="24" style="v"/>યુષ્માકં સર્વ્વાન્ નાયકાન્ પવિત્રલોકાંશ્ચ નમસ્કુરુત| અપરમ્ ઇતાલિયાદેશીયાનાં નમસ્કારં જ્ઞાસ્યથ|</para>
  <para style="p">
    <verse number="25" style="v"/>અનુગ્રહો યુષ્માકં સર્વ્વેષાં સહાયો ભૂયાત્| આમેન્|</para>
</usx>
