<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in Gujarati Script (સત્યવેદઃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">ફિલોમોનં પત્રં</para>
  <para style="toc2">ફિલોમોનઃ</para>
  <para style="toc3">ફિલોમોનઃ</para>
  <para style="mt1">ફિલોમોનં પત્રં</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ખ્રીષ્ટસ્ય યીશો ર્બન્દિદાસઃ પૌલસ્તીથિયનામા ભ્રાતા ચ પ્રિયં સહકારિણં ફિલીમોનં</para>
  <para style="p">
    <verse number="2" style="v"/>પ્રિયામ્ આપ્પિયાં સહસેનામ્ આર્ખિપ્પં ફિલીમોનસ્ય ગૃહે સ્થિતાં સમિતિઞ્ચ પ્રતિ પત્રં લિખતઃ|</para>
  <para style="p">
    <verse number="3" style="v"/>અસ્માકં તાત ઈશ્વરઃ પ્રભુ ર્યીશુખ્રીષ્ટશ્ચ યુષ્માન્ પ્રતિ શાન્તિમ્ અનુગ્રહઞ્ચ ક્રિયાસ્તાં|</para>
  <para style="p">
    <verse number="4" style="v"/>પ્રભું યીશું પ્રતિ સર્વ્વાન્ પવિત્રલોકાન્ પ્રતિ ચ તવ પ્રેમવિશ્વાસયો ર્વૃત્તાન્તં નિશમ્યાહં</para>
  <para style="p">
    <verse number="5" style="v"/>પ્રાર્થનાસમયે તવ નામોચ્ચારયન્ નિરન્તરં મમેશ્વરં ધન્યં વદામિ|</para>
  <para style="p">
    <verse number="6" style="v"/>અસ્માસુ યદ્યત્ સૌજન્યં વિદ્યતે તત્ સર્વ્વં ખ્રીષ્ટં યીશું યત્ પ્રતિ ભવતીતિ જ્ઞાનાય તવ વિશ્વાસમૂલિકા દાનશીલતા યત્ સફલા ભવેત્ તદહમ્ ઇચ્છામિ|</para>
  <para style="p">
    <verse number="7" style="v"/>હે ભ્રાતઃ, ત્વયા પવિત્રલોકાનાં પ્રાણ આપ્યાયિતા અભવન્ એતસ્માત્ તવ પ્રેમ્નાસ્માકં મહાન્ આનન્દઃ સાન્ત્વના ચ જાતઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ત્વયા યત્ કર્ત્તવ્યં તત્ ત્વામ્ આજ્ઞાપયિતું યદ્યપ્યહં ખ્રીષ્ટેનાતીવોત્સુકો ભવેયં તથાપિ વૃદ્ધ</para>
  <para style="p">
    <verse number="9" style="v"/>ઇદાનીં યીશુખ્રીષ્ટસ્ય બન્દિદાસશ્ચૈવમ્ભૂતો યઃ પૌલઃ સોઽહં ત્વાં વિનેતું વરં મન્યે|</para>
  <para style="p">
    <verse number="10" style="v"/>અતઃ શૃઙ્ખલબદ્ધોઽહં યમજનયં તં મદીયતનયમ્ ઓનીષિમમ્ અધિ ત્વાં વિનયે|</para>
  <para style="p">
    <verse number="11" style="v"/>સ પૂર્વ્વં તવાનુપકારક આસીત્ કિન્ત્વિદાનીં તવ મમ ચોપકારી ભવતિ|</para>
  <para style="p">
    <verse number="12" style="v"/>તમેવાહં તવ સમીપં પ્રેષયામિ, અતો મદીયપ્રાણસ્વરૂપઃ સ ત્વયાનુગૃહ્યતાં|</para>
  <para style="p">
    <verse number="13" style="v"/>સુસંવાદસ્ય કૃતે શૃઙ્ખલબદ્ધોઽહં પરિચારકમિવ તં સ્વસન્નિધૌ વર્ત્તયિતુમ્ ઐચ્છં|</para>
  <para style="p">
    <verse number="14" style="v"/>કિન્તુ તવ સૌજન્યં યદ્ બલેન ન ભૂત્વા સ્વેચ્છાયાઃ ફલં ભવેત્ તદર્થં તવ સમ્મતિં વિના કિમપિ કર્ત્તવ્યં નામન્યે|</para>
  <para style="p">
    <verse number="15" style="v"/>કો જાનાતિ ક્ષણકાલાર્થં ત્વત્તસ્તસ્ય વિચ્છેદોઽભવદ્ એતસ્યાયમ્ અભિપ્રાયો યત્ ત્વમ્ અનન્તકાલાર્થં તં લપ્સ્યસે</para>
  <para style="p">
    <verse number="16" style="v"/>પુન ર્દાસમિવ લપ્સ્યસે તન્નહિ કિન્તુ દાસાત્ શ્રેષ્ઠં મમ પ્રિયં તવ ચ શારીરિકસમ્બન્ધાત્ પ્રભુસમ્બન્ધાચ્ચ તતોઽધિકં પ્રિયં ભ્રાતરમિવ|</para>
  <para style="p">
    <verse number="17" style="v"/>અતો હેતો ર્યદિ માં સહભાગિનં જાનાસિ તર્હિ મામિવ તમનુગૃહાણ|</para>
  <para style="p">
    <verse number="18" style="v"/>તેન યદિ તવ કિમપ્યપરાદ્ધં તુભ્યં કિમપિ ધાર્ય્યતે વા તર્હિ તત્ મમેતિ વિદિત્વા ગણય|</para>
  <para style="p">
    <verse number="19" style="v"/>અહં તત્ પરિશોત્સ્યામિ, એતત્ પૌલોઽહં સ્વહસ્તેન લિખામિ, યતસ્ત્વં સ્વપ્રાણાન્ અપિ મહ્યં ધારયસિ તદ્ વક્તું નેચ્છામિ|</para>
  <para style="p">
    <verse number="20" style="v"/>ભો ભ્રાતઃ, પ્રભોઃ કૃતે મમ વાઞ્છાં પૂરય ખ્રીષ્ટસ્ય કૃતે મમ પ્રાણાન્ આપ્યાયય|</para>
  <para style="p">
    <verse number="21" style="v"/>તવાજ્ઞાગ્રાહિત્વે વિશ્વસ્ય મયા એતત્ લિખ્યતે મયા યદુચ્યતે તતોઽધિકં ત્વયા કારિષ્યત ઇતિ જાનામિ|</para>
  <para style="p">
    <verse number="22" style="v"/>તત્કરણસમયે મદર્થમપિ વાસગૃહં ત્વયા સજ્જીક્રિયતાં યતો યુષ્માકં પ્રાર્થનાનાં ફલરૂપો વર ઇવાહં યુષ્મભ્યં દાયિષ્યે મમેતિ પ્રત્યાશા જાયતે|</para>
  <para style="p">
    <verse number="23" style="v"/>ખ્રીષ્ટસ્ય યીશાઃ કૃતે મયા સહ બન્દિરિપાફ્રા</para>
  <para style="p">
    <verse number="24" style="v"/>મમ સહકારિણો માર્ક આરિષ્ટાર્ખો દીમા લૂકશ્ચ ત્વાં નમસ્કારં વેદયન્તિ|</para>
  <para style="p">
    <verse number="25" style="v"/>અસ્માકં પ્રભો ર્યીશુખ્રીષ્ટસ્યાનુગ્રહો યુષ્માકમ્ આત્મના સહ ભૂયાત્| આમેન્|</para>
</usx>
