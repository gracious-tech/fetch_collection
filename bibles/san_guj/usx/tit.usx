<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="TIT" style="id">Sanskrit Bible (NT) in Gujarati Script (સત્યવેદઃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Titus</para>
  <para style="toc1">તીતં પત્રં</para>
  <para style="toc2">તીતઃ</para>
  <para style="toc3">તીતઃ</para>
  <para style="mt1">તીતં પત્રં</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અનન્તજીવનસ્યાશાતો જાતાયા ઈશ્વરભક્તે ર્યોગ્યસ્ય સત્યમતસ્ય યત્ તત્વજ્ઞાનં યશ્ચ વિશ્વાસ ઈશ્વરસ્યાભિરુચિતલોકૈ ર્લભ્યતે તદર્થં</para>
  <para style="p">
    <verse number="2" style="v"/>યીશુખ્રીષ્ટસ્ય પ્રેરિત ઈશ્વરસ્ય દાસઃ પૌલોઽહં સાધારણવિશ્વાસાત્ મમ પ્રકૃતં ધર્મ્મપુત્રં તીતં પ્રતિ લિખમિ|</para>
  <para style="p">
    <verse number="3" style="v"/>નિષ્કપટ ઈશ્વર આદિકાલાત્ પૂર્વ્વં તત્ જીવનં પ્રતિજ્ઞાતવાન્ સ્વનિરૂપિતસમયે ચ ઘોષણયા તત્ પ્રકાશિતવાન્|</para>
  <para style="p">
    <verse number="4" style="v"/>મમ ત્રાતુરીશ્વરસ્યાજ્ઞયા ચ તસ્ય ઘોષણં મયિ સમર્પિતમ્ અભૂત્| અસ્માકં તાત ઈશ્વરઃ પરિત્રાતા પ્રભુ ર્યીશુખ્રીષ્ટશ્ચ તુભ્યમ્ અનુગ્રહં દયાં શાન્તિઞ્ચ વિતરતુ|</para>
  <para style="p">
    <verse number="5" style="v"/>ત્વં યદ્ અસમ્પૂર્ણકાર્ય્યાણિ સમ્પૂરયે ર્મદીયાદેશાચ્ચ પ્રતિનગરં પ્રાચીનગણાન્ નિયોજયેસ્તદર્થમહં ત્વાં ક્રીત્યુપદ્વીપે સ્થાપયિત્વા ગતવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>તસ્માદ્ યો નરો ઽનિન્દિત એકસ્યા યોષિતઃ સ્વામી વિશ્વાસિનામ્ અપચયસ્યાવાધ્યત્વસ્ય વા દોષેણાલિપ્તાનાઞ્ચ સન્તાનાનાં જનકો ભવતિ સ એવ યોગ્યઃ|</para>
  <para style="p">
    <verse number="7" style="v"/>યતો હેતોરદ્યક્ષેણેશ્વરસ્ય ગૃહાદ્યક્ષેણેવાનિન્દનીયેન ભવિતવ્યં| તેન સ્વેચ્છાચારિણા ક્રોધિના પાનાસક્તેન પ્રહારકેણ લોભિના વા ન ભવિતવ્યં</para>
  <para style="p">
    <verse number="8" style="v"/>કિન્ત્વતિથિસેવકેન સલ્લોકાનુરાગિણા વિનીતેન ન્યાય્યેન ધાર્મ્મિકેણ જિતેન્દ્રિયેણ ચ ભવિતવ્યં,</para>
  <para style="p">
    <verse number="9" style="v"/>ઉપદેશે ચ વિશ્વસ્તં વાક્યં તેન ધારિતવ્યં યતઃ સ યદ્ યથાર્થેનોપદેશેન લોકાન્ વિનેતું વિઘ્નકારિણશ્ચ નિરુત્તરાન્ કર્ત્તું શક્નુયાત્ તદ્ આવશ્યકં|</para>
  <para style="p">
    <verse number="10" style="v"/>યતસ્તે બહવો ઽવાધ્યા અનર્થકવાક્યવાદિનઃ પ્રવઞ્ચકાશ્ચ સન્તિ વિશેષતશ્છિન્નત્વચાં મધ્યે કેચિત્ તાદૃશા લોકાઃ સન્તિ|</para>
  <para style="p">
    <verse number="11" style="v"/>તેષાઞ્ચ વાગ્રોધ આવશ્યકો યતસ્તે કુત્સિતલાભસ્યાશયાનુચિતાનિ વાક્યાનિ શિક્ષયન્તો નિખિલપરિવારાણાં સુમતિં નાશયન્તિ|</para>
  <para style="p">
    <verse number="12" style="v"/>તેષાં સ્વદેશીય એકો ભવિષ્યદ્વાદી વચનમિદમુક્તવાન્, યથા, ક્રીતીયમાનવાઃ સર્વ્વે સદા કાપટ્યવાદિનઃ| હિંસ્રજન્તુસમાનાસ્તે ઽલસાશ્ચોદરભારતઃ||</para>
  <para style="p">
    <verse number="13" style="v"/>સાક્ષ્યમેતત્ તથ્યં, અતોे હેતોસ્ત્વં તાન્ ગાઢં ભર્ત્સય તે ચ યથા વિશ્વાસે સ્વસ્થા ભવેયુ</para>
  <para style="p">
    <verse number="14" style="v"/>ર્યિહૂદીયોપાખ્યાનેષુ સત્યમતભ્રષ્ટાનાં માનવાનામ્ આજ્ઞાસુ ચ મનાંસિ ન નિવેશયેયુસ્તથાદિશ|</para>
  <para style="p">
    <verse number="15" style="v"/>શુચીનાં કૃતે સર્વ્વાણ્યેવ શુચીનિ ભવન્તિ કિન્તુ કલઙ્કિતાનામ્ અવિશ્વાસિનાઞ્ચ કૃતે શુચિ કિમપિ ન ભવતિ યતસ્તેષાં બુદ્ધયઃ સંવેદાશ્ચ કલઙ્કિતાઃ સન્તિ|</para>
  <para style="p">
    <verse number="16" style="v"/>ઈશ્વરસ્ય જ્ઞાનં તે પ્રતિજાનન્તિ કિન્તુ કર્મ્મભિસ્તદ્ અનઙ્ગીકુર્વ્વતે યતસ્તે ગર્હિતા અનાજ્ઞાગ્રાહિણઃ સર્વ્વસત્કર્મ્મણશ્ચાયોગ્યાઃ સન્તિ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>યથાર્થસ્યોપદેશસ્ય વાક્યાનિ ત્વયા કથ્યન્તાં</para>
  <para style="p">
    <verse number="2" style="v"/>વિશેષતઃ પ્રાચીનલોકા યથા પ્રબુદ્ધા ધીરા વિનીતા વિશ્વાસે પ્રેમ્નિ સહિષ્ણુતાયાઞ્ચ સ્વસ્થા ભવેયુસ્તદ્વત્</para>
  <para style="p">
    <verse number="3" style="v"/>પ્રાચીનયોષિતોઽપિ યથા ધર્મ્મયોગ્યમ્ આચારં કુર્ય્યુઃ પરનિન્દકા બહુમદ્યપાનસ્ય નિઘ્નાશ્ચ ન ભવેયુઃ</para>
  <para style="p">
    <verse number="4" style="v"/>કિન્તુ સુશિક્ષાકારિણ્યઃ સત્ય ઈશ્વરસ્ય વાક્યં યત્ ન નિન્દ્યેત તદર્થં યુવતીઃ સુશીલતામ્ અર્થતઃ પતિસ્નેહમ્ અપત્યસ્નેહં</para>
  <para style="p">
    <verse number="5" style="v"/>વિનીતિં શુચિત્વં ગૃહિણીત્વં સૌજન્યં સ્વામિનિઘ્નઞ્ચાદિશેયુસ્તથા ત્વયા કથ્યતાં|</para>
  <para style="p">
    <verse number="6" style="v"/>તદ્વદ્ યૂનોઽપિ વિનીતયે પ્રબોધય|</para>
  <para style="p">
    <verse number="7" style="v"/>ત્વઞ્ચ સર્વ્વવિષયે સ્વં સત્કર્મ્મણાં દૃષ્ટાન્તં દર્શય શિક્ષાયાઞ્ચાવિકૃતત્વં ધીરતાં યથાર્થં</para>
  <para style="p">
    <verse number="8" style="v"/>નિર્દ્દોષઞ્ચ વાક્યં પ્રકાશય તેન વિપક્ષો યુષ્માકમ્ અપવાદસ્ય કિમપિ છિદ્રં ન પ્રાપ્ય ત્રપિષ્યતે|</para>
  <para style="p">
    <verse number="9" style="v"/>દાસાશ્ચ યત્ સ્વપ્રભૂનાં નિઘ્નાઃ સર્વ્વવિષયે તુષ્ટિજનકાશ્ચ ભવેયુઃ પ્રત્યુત્તરં ન કુર્ય્યુઃ</para>
  <para style="p">
    <verse number="10" style="v"/>કિમપિ નાપહરેયુઃ કિન્તુ પૂર્ણાં સુવિશ્વસ્તતાં પ્રકાશયેયુરિતિ તાન્ આદિશ| યત એવમ્પ્રકારેણાસ્મકં ત્રાતુરીશ્વરસ્ય શિક્ષા સર્વ્વવિષયે તૈ ર્ભૂષિતવ્યા|</para>
  <para style="p">
    <verse number="11" style="v"/>યતો હેતોસ્ત્રાણાજનક ઈશ્વરસ્યાનુગ્રહઃ સર્વ્વાન્ માનવાન્ પ્રત્યુદિતવાન્</para>
  <para style="p">
    <verse number="12" style="v"/>સ ચાસ્માન્ ઇદં શિક્ષ્યતિ યદ્ વયમ્ અધર્મ્મં સાંસારિકાભિલાષાંશ્ચાનઙ્ગીકૃત્ય વિનીતત્વેન ન્યાયેનેશ્વરભક્ત્યા ચેહલોકે આયુ ર્યાપયામઃ,</para>
  <para style="p">
    <verse number="13" style="v"/>પરમસુખસ્યાશામ્ અર્થતો ઽસ્માકં મહત ઈશ્વરસ્ય ત્રાણકર્ત્તુ ર્યીશુખ્રીષ્ટસ્ય પ્રભાવસ્યોદયં પ્રતીક્ષામહે|</para>
  <para style="p">
    <verse number="14" style="v"/>યતઃ સ યથાસ્માન્ સર્વ્વસ્માદ્ અધર્મ્માત્ મોચયિત્વા નિજાધિકારસ્વરૂપં સત્કર્મ્મસૂત્સુકમ્ એકં પ્રજાવર્ગં પાવયેત્ તદર્થમ્ અસ્માકં કૃતે આત્મદાનં કૃતવાન્|</para>
  <para style="p">
    <verse number="15" style="v"/>એતાનિ ભાષસ્વ પૂર્ણસામર્થ્યેન ચાદિશ પ્રબોધય ચ, કોઽપિ ત્વાં નાવમન્યતાં|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>તે યથા દેશાધિપાનાં શાસકાનાઞ્ચ નિઘ્ના આજ્ઞાગ્રાહિણ્શ્ચ સર્વ્વસ્મૈ સત્કર્મ્મણે સુસજ્જાશ્ચ ભવેયુઃ</para>
  <para style="p">
    <verse number="2" style="v"/>કમપિ ન નિન્દેયુ ર્નિવ્વિરોધિનઃ ક્ષાન્તાશ્ચ ભવેયુઃ સર્વ્વાન્ પ્રતિ ચ પૂર્ણં મૃદુત્વં પ્રકાશયેયુશ્ચેતિ તાન્ આદિશ|</para>
  <para style="p">
    <verse number="3" style="v"/>યતઃ પૂર્વ્વં વયમપિ નિર્બ્બોધા અનાજ્ઞાગ્રાહિણો ભ્રાન્તા નાનાભિલાષાણાં સુખાનાઞ્ચ દાસેયા દુષ્ટત્વેર્ષ્યાચારિણો ઘૃણિતાઃ પરસ્પરં દ્વેષિણશ્ચાભવામઃ|</para>
  <para style="p">
    <verse number="4" style="v"/>કિન્ત્વસ્માકં ત્રાતુરીશ્વરસ્ય યા દયા મર્ત્ત્યાનાં પ્રતિ ચ યા પ્રીતિસ્તસ્યાઃ પ્રાદુર્ભાવે જાતે</para>
  <para style="p">
    <verse number="5" style="v"/>વયમ્ આત્મકૃતેભ્યો ધર્મ્મકર્મ્મભ્યસ્તન્નહિ કિન્તુ તસ્ય કૃપાતઃ પુનર્જન્મરૂપેણ પ્રક્ષાલનેન પ્રવિત્રસ્યાત્મનો નૂતનીકરણેન ચ તસ્માત્ પરિત્રાણાં પ્રાપ્તાઃ</para>
  <para style="p">
    <verse number="6" style="v"/>સ ચાસ્માકં ત્રાત્રા યીશુખ્રીષ્ટેનાસ્મદુપરિ તમ્ આત્માનં પ્રચુરત્વેન વૃષ્ટવાન્|</para>
  <para style="p">
    <verse number="7" style="v"/>ઇત્થં વયં તસ્યાનુગ્રહેણ સપુણ્યીભૂય પ્રત્યાશયાનન્તજીવનસ્યાધિકારિણો જાતાઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>વાક્યમેતદ્ વિશ્વસનીયમ્ અતો હેતોરીશ્વરે યે વિશ્વસિતવન્તસ્તે યથા સત્કર્મ્માણ્યનુતિષ્ઠેયુસ્તથા તાન્ દૃઢમ્ આજ્ઞાપયેતિ મમાભિમતં| તાન્યેવોત્તમાનિ માનવેભ્યઃ ફલદાનિ ચ ભવન્તિ|</para>
  <para style="p">
    <verse number="9" style="v"/>મૂઢેભ્યઃ પ્રશ્નવંશાવલિવિવાદેભ્યો વ્યવસ્થાયા વિતણ્ડાભ્યશ્ચ નિવર્ત્તસ્વ યતસ્તા નિષ્ફલા અનર્થકાશ્ચ ભવન્તિ|</para>
  <para style="p">
    <verse number="10" style="v"/>યો જનો બિભિત્સુસ્તમ્ એકવારં દ્વિર્વ્વા પ્રબોધ્ય દૂરીકુરુ,</para>
  <para style="p">
    <verse number="11" style="v"/>યતસ્તાદૃશો જનો વિપથગામી પાપિષ્ઠ આત્મદોષકશ્ચ ભવતીતિ ત્વયા જ્ઞાયતાં|</para>
  <para style="p">
    <verse number="12" style="v"/>યદાહમ્ આર્ત્તિમાં તુખિકં વા તવ સમીપં પ્રેષયિષ્યામિ તદા ત્વં નીકપલૌ મમ સમીપમ્ આગન્તું યતસ્વ યતસ્તત્રૈવાહં શીતકાલં યાપયિતું મતિમ્ અકાર્ષં|</para>
  <para style="p">
    <verse number="13" style="v"/>વ્યવસ્થાપકઃ સીના આપલ્લુશ્ચૈતયોઃ કસ્યાપ્યભાવો યન્ન ભવેત્ તદર્થં તૌ યત્નેન ત્વયા વિસૃજ્યેતાં|</para>
  <para style="p">
    <verse number="14" style="v"/>અપરમ્ અસ્મદીયલોકા યન્નિષ્ફલા ન ભવેયુસ્તદર્થં પ્રયોજનીયોપકારાયા સત્કર્મ્માણ્યનુષ્ઠાતું શિક્ષન્તાં|</para>
  <para style="p">
    <verse number="15" style="v"/>મમ સઙ્ગિનઃ સવ્વે ત્વાં નમસ્કુર્વ્વતે| યે વિશ્વાસાદ્ અસ્માસુ પ્રીયન્તે તાન્ નમસ્કુરુ; સર્વ્વેષુ યુષ્માસ્વનુગ્રહો ભૂયાત્| આમેન્|</para>
</usx>
