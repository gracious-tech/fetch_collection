<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="EPH" style="id">Sanskrit Bible (NT) in Gujarati Script (સત્યવેદઃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Ephesians</para>
  <para style="toc1">ઇફિષિણઃ પત્રં</para>
  <para style="toc2">ઇફિષિણઃ</para>
  <para style="toc3">ઇફિષિણઃ</para>
  <para style="mt1">ઇફિષિણઃ પત્રં</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ઈશ્વરસ્યેચ્છયા યીશુખ્રીષ્ટસ્ય પ્રેરિતઃ પૌલ ઇફિષનગરસ્થાન્ પવિત્રાન્ ખ્રીષ્ટયીશૌ વિશ્વાસિનો લોકાન્ પ્રતિ પત્રં લિખતિ|</para>
  <para style="p">
    <verse number="2" style="v"/>અસ્માકં તાતસ્યેશ્વરસ્ય પ્રભો ર્યીશુખ્રીષ્ટસ્ય ચાનુગ્રહઃ શાન્તિશ્ચ યુષ્માસુ વર્ત્તતાં|</para>
  <para style="p">
    <verse number="3" style="v"/>અસ્માકં પ્રભો ર્યીશોઃ ખ્રીષ્ટસ્ય તાત ઈશ્વરો ધન્યો ભવતુ; યતઃ સ ખ્રીષ્ટેનાસ્મભ્યં સર્વ્વમ્ આધ્યાત્મિકં સ્વર્ગીયવરં દત્તવાન્|</para>
  <para style="p">
    <verse number="4" style="v"/>વયં યત્ તસ્ય સમક્ષં પ્રેમ્ના પવિત્રા નિષ્કલઙ્કાશ્ચ ભવામસ્તદર્થં સ જગતઃ સૃષ્ટે પૂર્વ્વં તેનાસ્માન્ અભિરોચિતવાન્, નિજાભિલષિતાનુરોધાચ્ચ</para>
  <para style="p">
    <verse number="5" style="v"/>યીશુના ખ્રીષ્ટેન સ્વસ્ય નિમિત્તં પુત્રત્વપદેઽસ્માન્ સ્વકીયાનુગ્રહસ્ય મહત્ત્વસ્ય પ્રશંસાર્થં પૂર્વ્વં નિયુક્તવાન્|</para>
  <para style="p">
    <verse number="6" style="v"/>તસ્માદ્ અનુગ્રહાત્ સ યેન પ્રિયતમેન પુત્રેણાસ્માન્ અનુગૃહીતવાન્,</para>
  <para style="p">
    <verse number="7" style="v"/>વયં તસ્ય શોણિતેન મુક્તિમ્ અર્થતઃ પાપક્ષમાં લબ્ધવન્તઃ|</para>
  <para style="p">
    <verse number="8" style="v"/>તસ્ય ય ઈદૃશોઽનુગ્રહનિધિસ્તસ્માત્ સોઽસ્મભ્યં સર્વ્વવિધં જ્ઞાનં બુદ્ધિઞ્ચ બાહુલ્યરૂપેણ વિતરિતવાન્|</para>
  <para style="p">
    <verse number="9" style="v"/>સ્વર્ગપૃથિવ્યો ર્યદ્યદ્ વિદ્યતે તત્સર્વ્વં સ ખ્રીષ્ટે સંગ્રહીષ્યતીતિ હિતૈષિણા</para>
  <para style="p">
    <verse number="10" style="v"/>તેન કૃતો યો મનોરથઃ સમ્પૂર્ણતાં ગતવત્સુ સમયેષુ સાધયિતવ્યસ્તમધિ સ સ્વકીયાભિલાષસ્ય નિગૂઢં ભાવમ્ અસ્માન્ જ્ઞાપિતવાન્|</para>
  <para style="p">
    <verse number="11" style="v"/>પૂર્વ્વં ખ્રીષ્ટે વિશ્વાસિનો યે વયમ્ અસ્મત્તો યત્ તસ્ય મહિમ્નઃ પ્રશંસા જાયતે,</para>
  <para style="p">
    <verse number="12" style="v"/>તદર્થં યઃ સ્વકીયેચ્છાયાઃ મન્ત્રણાતઃ સર્વ્વાણિ સાધયતિ તસ્ય મનોરથાદ્ વયં ખ્રીષ્ટેન પૂર્વ્વં નિરૂપિતાઃ સન્તોઽધિકારિણો જાતાઃ|</para>
  <para style="p">
    <verse number="13" style="v"/>યૂયમપિ સત્યં વાક્યમ્ અર્થતો યુષ્મત્પરિત્રાણસ્ય સુસંવાદં નિશમ્ય તસ્મિન્નેવ ખ્રીષ્ટે વિશ્વસિતવન્તઃ પ્રતિજ્ઞાતેન પવિત્રેણાત્મના મુદ્રયેવાઙ્કિતાશ્ચ|</para>
  <para style="p">
    <verse number="14" style="v"/>યતસ્તસ્ય મહિમ્નઃ પ્રકાશાય તેન ક્રીતાનાં લોકાનાં મુક્તિ ર્યાવન્ન ભવિષ્યતિ તાવત્ સ આત્માસ્માકમ્ અધિકારિત્વસ્ય સત્યઙ્કારસ્ય પણસ્વરૂપો ભવતિ|</para>
  <para style="p">
    <verse number="15" style="v"/>પ્રભૌ યીશૌ યુષ્માકં વિશ્વાસઃ સર્વ્વેષુ પવિત્રલોકેષુ પ્રેમ ચાસ્ત ઇતિ વાર્ત્તાં શ્રુત્વાહમપિ</para>
  <para style="p">
    <verse number="16" style="v"/>યુષ્માનધિ નિરન્તરમ્ ઈશ્વરં ધન્યં વદન્ પ્રાર્થનાસમયે ચ યુષ્માન્ સ્મરન્ વરમિમં યાચામિ|</para>
  <para style="p">
    <verse number="17" style="v"/>અસ્માકં પ્રભો ર્યીશુખ્રીષ્ટસ્ય તાતો યઃ પ્રભાવાકર ઈશ્વરઃ સ સ્વકીયતત્ત્વજ્ઞાનાય યુષ્મભ્યં જ્ઞાનજનકમ્ પ્રકાશિતવાક્યબોધકઞ્ચાત્માનં દેયાત્|</para>
  <para style="p">
    <verse number="18" style="v"/>યુષ્માકં જ્ઞાનચક્ષૂંષિ ચ દીપ્તિયુક્તાનિ કૃત્વા તસ્યાહ્વાનં કીદૃશ્યા પ્રત્યાશયા સમ્બલિતં પવિત્રલોકાનાં મધ્યે તેન દત્તોઽધિકારઃ કીદૃશઃ પ્રભાવનિધિ ર્વિશ્વાસિષુ ચાસ્માસુ પ્રકાશમાનસ્ય</para>
  <para style="p">
    <verse number="19" style="v"/>તદીયમહાપરાક્રમસ્ય મહત્વં કીદૃગ્ અનુપમં તત્ સર્વ્વં યુષ્માન્ જ્ઞાપયતુ|</para>
  <para style="p">
    <verse number="20" style="v"/>યતઃ સ યસ્યાઃ શક્તેઃ પ્રબલતાં ખ્રીષ્ટે પ્રકાશયન્ મૃતગણમધ્યાત્ તમ્ ઉત્થાપિતવાન્,</para>
  <para style="p">
    <verse number="21" style="v"/>અધિપતિત્વપદં શાસનપદં પરાક્રમો રાજત્વઞ્ચેતિનામાનિ યાવન્તિ પદાનીહ લોકે પરલોકે ચ વિદ્યન્તે તેષાં સર્વ્વેષામ્ ઊર્દ્ધ્વે સ્વર્ગે નિજદક્ષિણપાર્શ્વે તમ્ ઉપવેશિતવાન્,</para>
  <para style="p">
    <verse number="22" style="v"/>સર્વ્વાણિ તસ્ય ચરણયોરધો નિહિતવાન્ યા સમિતિસ્તસ્ય શરીરં સર્વ્વત્ર સર્વ્વેષાં પૂરયિતુઃ પૂરકઞ્ચ ભવતિ તં તસ્યા મૂર્દ્ધાનં કૃત્વા</para>
  <para style="p">
    <verse number="23" style="v"/>સર્વ્વેષામ્ ઉપર્ય્યુપરિ નિયુક્તવાંશ્ચ સૈવ શક્તિરસ્માસ્વપિ તેન પ્રકાશ્યતે|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>પુરા યૂયમ્ અપરાધૈઃ પાપૈશ્ચ મૃતાઃ સન્તસ્તાન્યાચરન્ત ઇહલોકસ્ય સંસારાનુસારેણાકાશરાજ્યસ્યાધિપતિમ્</para>
  <para style="p">
    <verse number="2" style="v"/>અર્થતઃ સામ્પ્રતમ્ આજ્ઞાલઙ્ઘિવંશેષુ કર્મ્મકારિણમ્ આત્માનમ્ અન્વવ્રજત|</para>
  <para style="p">
    <verse number="3" style="v"/>તેષાં મધ્યે સર્વ્વે વયમપિ પૂર્વ્વં શરીરસ્ય મનસ્કામનાયાઞ્ચેહાં સાધયન્તઃ સ્વશરીરસ્યાભિલાષાન્ આચરામ સર્વ્વેઽન્ય ઇવ ચ સ્વભાવતઃ ક્રોધભજનાન્યભવામ|</para>
  <para style="p">
    <verse number="4" style="v"/>કિન્તુ કરુણાનિધિરીશ્વરો યેન મહાપ્રેમ્નાસ્માન્ દયિતવાન્</para>
  <para style="p">
    <verse number="5" style="v"/>તસ્ય સ્વપ્રેમ્નો બાહુલ્યાદ્ અપરાધૈ ર્મૃતાનપ્યસ્માન્ ખ્રીષ્ટેન સહ જીવિતવાન્ યતોઽનુગ્રહાદ્ યૂયં પરિત્રાણં પ્રાપ્તાઃ|</para>
  <para style="p">
    <verse number="6" style="v"/>સ ચ ખ્રીષ્ટેન યીશુનાસ્માન્ તેન સાર્દ્ધમ્ ઉત્થાપિતવાન્ સ્વર્ગ ઉપવેશિતવાંશ્ચ|</para>
  <para style="p">
    <verse number="7" style="v"/>ઇત્થં સ ખ્રીષ્ટેન યીશુનાસ્માન્ પ્રતિ સ્વહિતૈષિતયા ભાવિયુગેષુ સ્વકીયાનુગ્રહસ્યાનુપમં નિધિં પ્રકાશયિતુમ્ ઇચ્છતિ|</para>
  <para style="p">
    <verse number="8" style="v"/>યૂયમ્ અનુગ્રહાદ્ વિશ્વાસેન પરિત્રાણં પ્રાપ્તાઃ, તચ્ચ યુષ્મન્મૂલકં નહિ કિન્ત્વીશ્વરસ્યૈવ દાનં,</para>
  <para style="p">
    <verse number="9" style="v"/>તત્ કર્મ્મણાં ફલમ્ અપિ નહિ, અતઃ કેનાપિ ન શ્લાઘિતવ્યં|</para>
  <para style="p">
    <verse number="10" style="v"/>યતો વયં તસ્ય કાર્ય્યં પ્રાગ્ ઈશ્વરેણ નિરૂપિતાભિઃ સત્ક્રિયાભિઃ કાલયાપનાય ખ્રીષ્ટે યીશૌ તેન મૃષ્ટાશ્ચ|</para>
  <para style="p">
    <verse number="11" style="v"/>પુરા જન્મના ભિન્નજાતીયા હસ્તકૃતં ત્વક્છેદં પ્રાપ્તૈ ર્લોકૈશ્ચાચ્છિન્નત્વચ ઇતિનામ્ના ખ્યાતા યે યૂયં તૈ ર્યુષ્માભિરિદં સ્મર્ત્તવ્યં</para>
  <para style="p">
    <verse number="12" style="v"/>યત્ તસ્મિન્ સમયે યૂયં ખ્રીષ્ટાદ્ ભિન્ના ઇસ્રાયેલલોકાનાં સહવાસાદ્ દૂરસ્થાઃ પ્રતિજ્ઞાસમ્બલિતનિયમાનાં બહિઃ સ્થિતાઃ સન્તો નિરાશા નિરીશ્વરાશ્ચ જગત્યાધ્વમ્ ઇતિ|</para>
  <para style="p">
    <verse number="13" style="v"/>કિન્ત્વધુના ખ્રીષ્ટે યીશાવાશ્રયં પ્રાપ્ય પુરા દૂરવર્ત્તિનો યૂયં ખ્રીષ્ટસ્ય શોણિતેન નિકટવર્ત્તિનોઽભવત|</para>
  <para style="p">
    <verse number="14" style="v"/>યતઃ સ એવાસ્માકં સન્ધિઃ સ દ્વયમ્ એકીકૃતવાન્ શત્રુતારૂપિણીં મધ્યવર્ત્તિનીં પ્રભેદકભિત્તિં ભગ્નવાન્ દણ્ડાજ્ઞાયુક્તં વિધિશાસ્ત્રં સ્વશરીરેણ લુપ્તવાંશ્ચ|</para>
  <para style="p">
    <verse number="15" style="v"/>યતઃ સ સન્ધિં વિધાય તૌ દ્વૌ સ્વસ્મિન્ એકં નુતનં માનવં કર્ત્તું</para>
  <para style="p">
    <verse number="16" style="v"/>સ્વકીયક્રુશે શત્રુતાં નિહત્ય તેનૈવૈકસ્મિન્ શરીરે તયો ર્દ્વયોરીશ્વરેણ સન્ધિં કારયિતું નિશ્ચતવાન્|</para>
  <para style="p">
    <verse number="17" style="v"/>સ ચાગત્ય દૂરવર્ત્તિનો યુષ્માન્ નિકટવર્ત્તિનો ઽસ્માંશ્ચ સન્ધે ર્મઙ્ગલવાર્ત્તાં જ્ઞાપિતવાન્|</para>
  <para style="p">
    <verse number="18" style="v"/>યતસ્તસ્માદ્ ઉભયપક્ષીયા વયમ્ એકેનાત્મના પિતુઃ સમીપં ગમનાય સામર્થ્યં પ્રાપ્તવન્તઃ|</para>
  <para style="p">
    <verse number="19" style="v"/>અત ઇદાનીં યૂયમ્ અસમ્પર્કીયા વિદેશિનશ્ચ ન તિષ્ઠનતઃ પવિત્રલોકૈઃ સહવાસિન ઈશ્વરસ્ય વેશ્મવાસિનશ્ચાધ્વે|</para>
  <para style="p">
    <verse number="20" style="v"/>અપરં પ્રેરિતા ભવિષ્યદ્વાદિનશ્ચ યત્ર ભિત્તિમૂલસ્વરૂપાસ્તત્ર યૂયં તસ્મિન્ મૂલે નિચીયધ્વે તત્ર ચ સ્વયં યીશુઃ ખ્રીષ્ટઃ પ્રધાનઃ કોણસ્થપ્રસ્તરઃ|</para>
  <para style="p">
    <verse number="21" style="v"/>તેન કૃત્સ્ના નિર્મ્મિતિઃ સંગ્રથ્યમાના પ્રભોઃ પવિત્રં મન્દિરં ભવિતું વર્દ્ધતે|</para>
  <para style="p">
    <verse number="22" style="v"/>યૂયમપિ તત્ર સંગ્રથ્યમાના આત્મનેશ્વરસ્ય વાસસ્થાનં ભવથ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અતો હેતો ર્ભિન્નજાતીયાનાં યુષ્માકં નિમિત્તં યીશુખ્રીષ્ટસ્ય બન્દી યઃ સોઽહં પૌલો બ્રવીમિ|</para>
  <para style="p">
    <verse number="2" style="v"/>યુષ્મદર્થમ્ ઈશ્વરેણ મહ્યં દત્તસ્ય વરસ્ય નિયમઃ કીદૃશસ્તદ્ યુષ્માભિરશ્રાવીતિ મન્યે|</para>
  <para style="p">
    <verse number="3" style="v"/>અર્થતઃ પૂર્વ્વં મયા સંક્ષેપેણ યથા લિખિતં તથાહં પ્રકાશિતવાક્યેનેશ્વરસ્ય નિગૂઢં ભાવં જ્ઞાપિતોઽભવં|</para>
  <para style="p">
    <verse number="4" style="v"/>અતો યુષ્માભિસ્તત્ પઠિત્વા ખ્રીષ્ટમધિ તસ્મિન્નિગૂઢે ભાવે મમ જ્ઞાનં કીદૃશં તદ્ ભોત્સ્યતે|</para>
  <para style="p">
    <verse number="5" style="v"/>પૂર્વ્વયુગેષુ માનવસન્તાનાસ્તં જ્ઞાપિતા નાસન્ કિન્ત્વધુના સ ભાવસ્તસ્ય પવિત્રાન્ પ્રેરિતાન્ ભવિષ્યદ્વાદિનશ્ચ પ્રત્યાત્મના પ્રકાશિતોઽભવત્;</para>
  <para style="p">
    <verse number="6" style="v"/>અર્થત ઈશ્વરસ્ય શક્તેઃ પ્રકાશાત્ તસ્યાનુગ્રહેણ યો વરો મહ્યમ્ અદાયિ તેનાહં યસ્ય સુસંવાદસ્ય પરિચારકોઽભવં,</para>
  <para style="p">
    <verse number="7" style="v"/>તદ્વારા ખ્રીષ્ટેન ભિન્નજાતીયા અન્યૈઃ સાર્દ્ધમ્ એકાધિકારા એકશરીરા એકસ્યાઃ પ્રતિજ્ઞાયા અંશિનશ્ચ ભવિષ્યન્તીતિ|</para>
  <para style="p">
    <verse number="8" style="v"/>સર્વ્વેષાં પવિત્રલોકાનાં ક્ષુદ્રતમાય મહ્યં વરોઽયમ્ અદાયિ યદ્ ભિન્નજાતીયાનાં મધ્યે બોધાગયસ્ય ગુણનિધેઃ ખ્રીષ્ટસ્ય મઙ્ગલવાર્ત્તાં પ્રચારયામિ,</para>
  <para style="p">
    <verse number="9" style="v"/>કાલાવસ્થાતઃ પૂર્વ્વસ્માચ્ચ યો નિગૂઢભાવ ઈશ્વરે ગુપ્ત આસીત્ તદીયનિયમં સર્વ્વાન્ જ્ઞાપયામિ|</para>
  <para style="p">
    <verse number="10" style="v"/>યત ઈશ્વરસ્ય નાનારૂપં જ્ઞાનં યત્ સામ્પ્રતં સમિત્યા સ્વર્ગે પ્રાધાન્યપરાક્રમયુક્તાનાં દૂતાનાં નિકટે પ્રકાશ્યતે તદર્થં સ યીશુના ખ્રીષ્ટેન સર્વ્વાણિ સૃષ્ટવાન્|</para>
  <para style="p">
    <verse number="11" style="v"/>યતો વયં યસ્મિન્ વિશ્વસ્ય દૃઢભક્ત્યા નિર્ભયતામ્ ઈશ્વરસ્ય સમાગમે સામર્થ્યઞ્ચ</para>
  <para style="p">
    <verse number="12" style="v"/>પ્રાપ્તવન્તસ્તમસ્માકં પ્રભું યીશું ખ્રીષ્ટમધિ સ કાલાવસ્થાયાઃ પૂર્વ્વં તં મનોરથં કૃતવાન્|</para>
  <para style="p">
    <verse number="13" style="v"/>અતોઽહં યુષ્મન્નિમિત્તં દુઃખભોગેન ક્લાન્તિં યન્ન ગચ્છામીતિ પ્રાર્થયે યતસ્તદેવ યુષ્માકં ગૌરવં|</para>
  <para style="p">
    <verse number="14" style="v"/>અતો હેતોઃ સ્વર્ગપૃથિવ્યોઃ સ્થિતઃ કૃત્સ્નો વંશો યસ્ય નામ્ના વિખ્યાતસ્તમ્</para>
  <para style="p">
    <verse number="15" style="v"/>અસ્મત્પ્રભો ર્યીશુખ્રીષ્ટસ્ય પિતરમુદ્દિશ્યાહં જાનુની પાતયિત્વા તસ્ય પ્રભાવનિધિતો વરમિમં પ્રાર્થયે|</para>
  <para style="p">
    <verse number="16" style="v"/>તસ્યાત્મના યુષ્માકમ્ આન્તરિકપુરુષસ્ય શક્તે ર્વૃદ્ધિઃ ક્રિયતાં|</para>
  <para style="p">
    <verse number="17" style="v"/>ખ્રીષ્ટસ્તુ વિશ્વાસેન યુષ્માકં હૃદયેષુ નિવસતુ| પ્રેમણિ યુષ્માકં બદ્ધમૂલત્વં સુસ્થિરત્વઞ્ચ ભવતુ|</para>
  <para style="p">
    <verse number="18" style="v"/>ઇત્થં પ્રસ્થતાયા દીર્ઘતાયા ગભીરતાયા ઉચ્ચતાયાશ્ચ બોધાય સર્વ્વૈઃ પવિત્રલોકૈઃ પ્રાપ્યં સામર્થ્યં યુષ્માભિ ર્લભ્યતાં,</para>
  <para style="p">
    <verse number="19" style="v"/>જ્ઞાનાતિરિક્તં ખ્રીષ્ટસ્ય પ્રેમ જ્ઞાયતામ્ ઈશ્વરસ્ય સમ્પૂર્ણવૃદ્ધિપર્ય્યન્તં યુષ્માકં વૃદ્ધિ ર્ભવતુ ચ|</para>
  <para style="p">
    <verse number="20" style="v"/>અસ્માકમ્ અન્તરે યા શક્તિઃ પ્રકાશતે તયા સર્વ્વાતિરિક્તં કર્મ્મ કુર્વ્વન્ અસ્માકં પ્રાર્થનાં કલ્પનાઞ્ચાતિક્રમિતું યઃ શક્નોતિ</para>
  <para style="p">
    <verse number="21" style="v"/>ખ્રીષ્ટયીશુના સમિતે ર્મધ્યે સર્વ્વેષુ યુગેષુ તસ્ય ધન્યવાદો ભવતુ| ઇતિ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અતો બન્દિરહં પ્રભો ર્નામ્ના યુષ્માન્ વિનયે યૂયં યેનાહ્વાનેનાહૂતાસ્તદુપયુક્તરૂપેણ</para>
  <para style="p">
    <verse number="2" style="v"/>સર્વ્વથા નમ્રતાં મૃદુતાં તિતિક્ષાં પરસ્પરં પ્રમ્ના સહિષ્ણુતાઞ્ચાચરત|</para>
  <para style="p">
    <verse number="3" style="v"/>પ્રણયબન્ધનેન ચાત્મન એैક્યં રક્ષિતું યતધ્વં|</para>
  <para style="p">
    <verse number="4" style="v"/>યૂયમ્ એકશરીરા એકાત્માનશ્ચ તદ્વદ્ આહ્વાનેન યૂયમ્ એકપ્રત્યાશાપ્રાપ્તયે સમાહૂતાઃ|</para>
  <para style="p">
    <verse number="5" style="v"/>યુષ્માકમ્ એકઃ પ્રભુરેકો વિશ્વાસ એકં મજ્જનં, સર્વ્વેષાં તાતઃ</para>
  <para style="p">
    <verse number="6" style="v"/>સર્વ્વોપરિસ્થઃ સર્વ્વવ્યાપી સર્વ્વેષાં યુષ્માકં મધ્યવર્ત્તી ચૈક ઈશ્વર આસ્તે|</para>
  <para style="p">
    <verse number="7" style="v"/>કિન્તુ ખ્રીષ્ટસ્ય દાનપરિમાણાનુસારાદ્ અસ્માકમ્ એકૈકસ્મૈ વિશેષો વરોઽદાયિ|</para>
  <para style="p">
    <verse number="8" style="v"/>યથા લિખિતમ્ આસ્તે, "ઊર્દ્ધ્વમ્ આરુહ્ય જેતૃન્ સ વિજિત્ય બન્દિનોઽકરોત્| તતઃ સ મનુજેભ્યોઽપિ સ્વીયાન્ વ્યશ્રાણયદ્ વરાન્|| "</para>
  <para style="p">
    <verse number="9" style="v"/>ઊર્દ્ધ્વમ્ આરુહ્યેતિવાક્યસ્યાયમર્થઃ સ પૂર્વ્વં પૃથિવીરૂપં સર્વ્વાધઃસ્થિતં સ્થાનમ્ અવતીર્ણવાન્;</para>
  <para style="p">
    <verse number="10" style="v"/>યશ્ચાવતીર્ણવાન્ સ એવ સ્વર્ગાણામ્ ઉપર્ય્યુપર્ય્યારૂઢવાન્ યતઃ સર્વ્વાણિ તેન પૂરયિતવ્યાનિ|</para>
  <para style="p">
    <verse number="11" style="v"/>સ એવ ચ કાંશ્ચન પ્રેરિતાન્ અપરાન્ ભવિષ્યદ્વાદિનોઽપરાન્ સુસંવાદપ્રચારકાન્ અપરાન્ પાલકાન્ ઉપદેશકાંશ્ચ નિયુક્તવાન્|</para>
  <para style="p">
    <verse number="12" style="v"/>યાવદ્ વયં સર્વ્વે વિશ્વાસસ્યેશ્વરપુત્રવિષયકસ્ય તત્ત્વજ્ઞાનસ્ય ચૈક્યં સમ્પૂર્ણં પુરુષર્થઞ્ચાર્થતઃ ખ્રીષ્ટસ્ય સમ્પૂર્ણપરિમાણસ્ય સમં પરિમાણં ન પ્રાપ્નુમસ્તાવત્</para>
  <para style="p">
    <verse number="13" style="v"/>સ પરિચર્ય્યાકર્મ્મસાધનાય ખ્રીષ્ટસ્ય શરીરસ્ય નિષ્ઠાયૈ ચ પવિત્રલોકાનાં સિદ્ધતાયાસ્તાદૃશમ્ ઉપાયં નિશ્ચિતવાન્|</para>
  <para style="p">
    <verse number="14" style="v"/>અતએવ માનુષાણાં ચાતુરીતો ભ્રમકધૂર્ત્તતાયાશ્છલાચ્ચ જાતેન સર્વ્વેણ શિક્ષાવાયુના વયં યદ્ બાલકા ઇવ દોલાયમાના ન ભ્રામ્યામ ઇત્યસ્માભિ ર્યતિતવ્યં,</para>
  <para style="p">
    <verse number="15" style="v"/>પ્રેમ્ના સત્યતામ્ આચરદ્ભિઃ સર્વ્વવિષયે ખ્રીષ્ટમ્ ઉદ્દિશ્ય વર્દ્ધિતવ્યઞ્ચ, યતઃ સ મૂર્દ્ધા,</para>
  <para style="p">
    <verse number="16" style="v"/>તસ્માચ્ચૈકૈકસ્યાઙ્ગસ્ય સ્વસ્વપરિમાણાનુસારેણ સાહાય્યકરણાદ્ ઉપકારકૈઃ સર્વ્વૈઃ સન્ધિભિઃ કૃત્સ્નસ્ય શરીરસ્ય સંયોગે સમ્મિલને ચ જાતે પ્રેમ્ના નિષ્ઠાં લભમાનં કૃત્સ્નં શરીરં વૃદ્ધિં પ્રાપ્નોતિ|</para>
  <para style="p">
    <verse number="17" style="v"/>યુષ્માન્ અહં પ્રભુનેદં બ્રવીમ્યાદિશામિ ચ, અન્યે ભિન્નજાતીયા ઇવ યૂયં પૂન ર્માચરત|</para>
  <para style="p">
    <verse number="18" style="v"/>યતસ્તે સ્વમનોમાયામ્ આચરન્ત્યાન્તરિકાજ્ઞાનાત્ માનસિકકાઠિન્યાચ્ચ તિમિરાવૃતબુદ્ધય ઈશ્વરીયજીવનસ્ય બગીર્ભૂતાશ્ચ ભવન્તિ,</para>
  <para style="p">
    <verse number="19" style="v"/>સ્વાન્ ચૈતન્યશૂન્યાન્ કૃત્વા ચ લોભેન સર્વ્વવિધાશૌચાચરણાય લમ્પટતાયાં સ્વાન્ સમર્પિતવન્તઃ|</para>
  <para style="p">
    <verse number="20" style="v"/>કિન્તુ યૂયં ખ્રીષ્ટં ન તાદૃશં પરિચિતવન્તઃ,</para>
  <para style="p">
    <verse number="21" style="v"/>યતો યૂયં તં શ્રુતવન્તો યા સત્યા શિક્ષા યીશુતો લભ્યા તદનુસારાત્ તદીયોપદેશં પ્રાપ્તવન્તશ્ચેતિ મન્યે|</para>
  <para style="p">
    <verse number="22" style="v"/>તસ્માત્ પૂર્વ્વકાલિકાચારકારી યઃ પુરાતનપુરુષો માયાભિલાષૈ ર્નશ્યતિ તં ત્યક્ત્વા યુષ્માભિ ર્માનસિકભાવો નૂતનીકર્ત્તવ્યઃ,</para>
  <para style="p">
    <verse number="23" style="v"/>યો નવપુરુષ ઈશ્વરાનુરૂપેણ પુણ્યેન સત્યતાસહિતેન</para>
  <para style="p">
    <verse number="24" style="v"/>ધાર્મ્મિકત્વેન ચ સૃષ્ટઃ સ એવ પરિધાતવ્યશ્ચ|</para>
  <para style="p">
    <verse number="25" style="v"/>અતો યૂયં સર્વ્વે મિથ્યાકથનં પરિત્યજ્ય સમીપવાસિભિઃ સહ સત્યાલાપં કુરુત યતો વયં પરસ્પરમ્ અઙ્ગપ્રત્યઙ્ગા ભવામઃ|</para>
  <para style="p">
    <verse number="26" style="v"/>અપરં ક્રોધે જાતે પાપં મા કુરુધ્વમ્, અશાન્તે યુષ્માકં રોષેસૂર્ય્યોઽસ્તં ન ગચ્છતુ|</para>
  <para style="p">
    <verse number="27" style="v"/>અપરં શયતાને સ્થાનં મા દત્ત|</para>
  <para style="p">
    <verse number="28" style="v"/>ચોરઃ પુનશ્ચૈર્ય્યં ન કરોતુ કિન્તુ દીનાય દાને સામર્થ્યં યજ્જાયતે તદર્થં સ્વકરાભ્યાં સદ્વૃત્ત્યા પરિશ્રમં કરોતુ|</para>
  <para style="p">
    <verse number="29" style="v"/>અપરં યુષ્માકં વદનેભ્યઃ કોઽપિ કદાલાપો ન નિર્ગચ્છતુ, કિન્તુ યેન શ્રોતુરુપકારો જાયતે તાદૃશઃ પ્રયોજનીયનિષ્ઠાયૈ ફલદાયક આલાપો યુષ્માકં ભવતુ|</para>
  <para style="p">
    <verse number="30" style="v"/>અપરઞ્ચ યૂયં મુક્તિદિનપર્ય્યન્તમ્ ઈશ્વરસ્ય યેન પવિત્રેણાત્મના મુદ્રયાઙ્કિતા અભવત તં શોકાન્વિતં મા કુરુત|</para>
  <para style="p">
    <verse number="31" style="v"/>અપરં કટુવાક્યં રોષઃ કોષઃ કલહો નિન્દા સર્વ્વવિધદ્વેષશ્ચૈતાનિ યુષ્માકં મધ્યાદ્ દૂરીભવન્તુ|</para>
  <para style="p">
    <verse number="32" style="v"/>યૂયં પરસ્પરં હિતૈષિણઃ કોમલાન્તઃકરણાશ્ચ ભવત| અપરમ્ ઈશ્વરઃ ખ્રીષ્ટેન યદ્વદ્ યુષ્માકં દોષાન્ ક્ષમિતવાન્ તદ્વદ્ યૂયમપિ પરસ્પરં ક્ષમધ્વં|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>અતો યૂયં પ્રિયબાલકા ઇવેશ્વરસ્યાનુકારિણો ભવત,</para>
  <para style="p">
    <verse number="2" style="v"/>ખ્રીષ્ટ ઇવ પ્રેમાચારં કુરુત ચ, યતઃ સોઽસ્માસુ પ્રેમ કૃતવાન્ અસ્માકં વિનિમયેન ચાત્મનિવેદનં કૃત્વા ગ્રાહ્યસુગન્ધાર્થકમ્ ઉપહારં બલિઞ્ચેશ્વરાચ દત્તવાન્|</para>
  <para style="p">
    <verse number="3" style="v"/>કિન્તુ વેશ્યાગમનં સર્વ્વવિધાશૌચક્રિયા લોભશ્ચૈતેષામ્ ઉચ્ચારણમપિ યુષ્માકં મધ્યે ન ભવતુ, એતદેવ પવિત્રલોકાનામ્ ઉચિતં|</para>
  <para style="p">
    <verse number="4" style="v"/>અપરં કુત્સિતાલાપઃ પ્રલાપઃ શ્લેષોક્તિશ્ચ ન ભવતુ યત એતાન્યનુચિતાનિ કિન્ત્વીશ્વરસ્ય ધન્યવાદો ભવતુ|</para>
  <para style="p">
    <verse number="5" style="v"/>વેશ્યાગામ્યશૌચાચારી દેવપૂજક ઇવ ગણ્યો લોભી ચૈતેષાં કોષિ ખ્રીષ્ટસ્ય રાજ્યેઽર્થત ઈશ્વરસ્ય રાજ્યે કમપ્યધિકારં ન પ્રાપ્સ્યતીતિ યુષ્માભિઃ સમ્યક્ જ્ઞાયતાં|</para>
  <para style="p">
    <verse number="6" style="v"/>અનર્થકવાક્યેન કોઽપિ યુષ્માન્ ન વઞ્ચયતુ યતસ્તાદૃગાચારહેતોરનાજ્ઞાગ્રાહિષુ લોકેષ્વીશ્વરસ્ય કોપો વર્ત્તતે|</para>
  <para style="p">
    <verse number="7" style="v"/>તસ્માદ્ યૂયં તૈઃ સહભાગિનો ન ભવત|</para>
  <para style="p">
    <verse number="8" style="v"/>પૂર્વ્વં યૂયમ્ અન્ધકારસ્વરૂપા આધ્વં કિન્ત્વિદાનીં પ્રભુના દીપ્તિસ્વરૂપા ભવથ તસ્માદ્ દીપ્તેઃ સન્તાના ઇવ સમાચરત|</para>
  <para style="p">
    <verse number="9" style="v"/>દીપ્તે ર્યત્ ફલં તત્ સર્વ્વવિધહિતૈષિતાયાં ધર્મ્મે સત્યાલાપે ચ પ્રકાશતે|</para>
  <para style="p">
    <verse number="10" style="v"/>પ્રભવે યદ્ રોચતે તત્ પરીક્ષધ્વં|</para>
  <para style="p">
    <verse number="11" style="v"/>યૂયં તિમિરસ્ય વિફલકર્મ્મણામ્ અંશિનો ન ભૂત્વા તેષાં દોષિત્વં પ્રકાશયત|</para>
  <para style="p">
    <verse number="12" style="v"/>યતસ્તે લોકા રહમિ યદ્ યદ્ આચરન્તિ તદુચ્ચારણમ્ અપિ લજ્જાજનકં|</para>
  <para style="p">
    <verse number="13" style="v"/>યતો દીપ્ત્યા યદ્ યત્ પ્રકાશ્યતે તત્ તયા ચકાસ્યતે યચ્ચ ચકાસ્તિ તદ્ દીપ્તિસ્વરૂપં ભવતિ|</para>
  <para style="p">
    <verse number="14" style="v"/>એતત્કારણાદ્ ઉક્તમ્ આસ્તે, "હે નિદ્રિત પ્રબુધ્યસ્વ મૃતેભ્યશ્ચોત્થિતિં કુરુ| તત્કૃતે સૂર્ય્યવત્ ખ્રીષ્ટઃ સ્વયં ત્વાં દ્યોતયિષ્યતિ| "</para>
  <para style="p">
    <verse number="15" style="v"/>અતઃ સાવધાના ભવત, અજ્ઞાના ઇવ માચરત કિન્તુ જ્ઞાનિન ઇવ સતર્કમ્ આચરત|</para>
  <para style="p">
    <verse number="16" style="v"/>સમયં બહુમૂલ્યં ગણયધ્વં યતઃ કાલા અભદ્રાઃ|</para>
  <para style="p">
    <verse number="17" style="v"/>તસ્માદ્ યૂયમ્ અજ્ઞાના ન ભવત કિન્તુ પ્રભોરભિમતં કિં તદવગતા ભવત|</para>
  <para style="p">
    <verse number="18" style="v"/>સર્વ્વનાશજનકેન સુરાપાનેન મત્તા મા ભવત કિન્ત્વાત્મના પૂર્ય્યધ્વં|</para>
  <para style="p">
    <verse number="19" style="v"/>અપરં ગીતૈ ર્ગાનૈઃ પારમાર્થિકકીર્ત્તનૈશ્ચ પરસ્પરમ્ આલપન્તો મનસા સાર્દ્ધં પ્રભુમ્ ઉદ્દિશ્ય ગાયત વાદયત ચ|</para>
  <para style="p">
    <verse number="20" style="v"/>સર્વ્વદા સર્વ્વવિષયેઽસ્મત્પ્રભો યીશોઃ ખ્રીષ્ટસ્ય નામ્ના તાતમ્ ઈશ્વરં ધન્યં વદત|</para>
  <para style="p">
    <verse number="21" style="v"/>યૂયમ્ ઈશ્વરાદ્ ભીતાઃ સન્ત અન્યેઽપરેષાં વશીભૂતા ભવત|</para>
  <para style="p">
    <verse number="22" style="v"/>હે યોષિતઃ, યૂયં યથા પ્રભોસ્તથા સ્વસ્વસ્વામિનો વશઙ્ગતા ભવત|</para>
  <para style="p">
    <verse number="23" style="v"/>યતઃ ખ્રીષ્ટો યદ્વત્ સમિતે ર્મૂર્દ્ધા શરીરસ્ય ત્રાતા ચ ભવતિ તદ્વત્ સ્વામી યોષિતો મૂર્દ્ધા|</para>
  <para style="p">
    <verse number="24" style="v"/>અતઃ સમિતિ ર્યદ્વત્ ખ્રીષ્ટસ્ય વશીભૂતા તદ્વદ્ યોષિદ્ભિરપિ સ્વસ્વસ્વામિનો વશતા સ્વીકર્ત્તવ્યા|</para>
  <para style="p">
    <verse number="25" style="v"/>અપરઞ્ચ હે પુરુષાઃ, યૂયં ખ્રીષ્ટ ઇવ સ્વસ્વયોષિત્સુ પ્રીયધ્વં|</para>
  <para style="p">
    <verse number="26" style="v"/>સ ખ્રીષ્ટોઽપિ સમિતૌ પ્રીતવાન્ તસ્યાઃ કૃતે ચ સ્વપ્રાણાન્ ત્યક્તવાન્ યતઃ સ વાક્યે જલમજ્જનેન તાં પરિષ્કૃત્ય પાવયિતુમ્</para>
  <para style="p">
    <verse number="27" style="v"/>અપરં તિલકવલ્યાદિવિહીનાં પવિત્રાં નિષ્કલઙ્કાઞ્ચ તાં સમિતિં તેજસ્વિનીં કૃત્વા સ્વહસ્તે સમર્પયિતુઞ્ચાભિલષિતવાન્|</para>
  <para style="p">
    <verse number="28" style="v"/>તસ્માત્ સ્વતનુવત્ સ્વયોષિતિ પ્રેમકરણં પુરુષસ્યોચિતં, યેન સ્વયોષિતિ પ્રેમ ક્રિયતે તેનાત્મપ્રેમ ક્રિયતે|</para>
  <para style="p">
    <verse number="29" style="v"/>કોઽપિ કદાપિ ન સ્વકીયાં તનુમ્ ઋતીયિતવાન્ કિન્તુ સર્વ્વે તાં વિભ્રતિ પુષ્ણન્તિ ચ| ખ્રીષ્ટોઽપિ સમિતિં પ્રતિ તદેવ કરોતિ,</para>
  <para style="p">
    <verse number="30" style="v"/>યતો વયં તસ્ય શરીરસ્યાઙ્ગાનિ માંસાસ્થીનિ ચ ભવામઃ|</para>
  <para style="p">
    <verse number="31" style="v"/>એતદર્થં માનવઃ સ્વમાતાપિતરોै પરિત્યજ્ય સ્વભાર્ય્યાયામ્ આસંક્ષ્યતિ તૌ દ્વૌ જનાવેકાઙ્ગૌ ભવિષ્યતઃ|</para>
  <para style="p">
    <verse number="32" style="v"/>એતન્નિગૂઢવાક્યં ગુરુતરં મયા ચ ખ્રીષ્ટસમિતી અધિ તદ્ ઉચ્યતે|</para>
  <para style="p">
    <verse number="33" style="v"/>અતએવ યુષ્માકમ્ એકૈકો જન આત્મવત્ સ્વયોષિતિ પ્રીયતાં ભાર્ય્યાપિ સ્વામિનં સમાદર્ત્તું યતતાં|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>હે બાલકાઃ, યૂયં પ્રભુમ્ ઉદ્દિશ્ય પિત્રોરાજ્ઞાગ્રાહિણો ભવત યતસ્તત્ ન્યાય્યં|</para>
  <para style="p">
    <verse number="2" style="v"/>ત્વં નિજપિતરં માતરઞ્ચ સમ્મન્યસ્વેતિ યો વિધિઃ સ પ્રતિજ્ઞાયુક્તઃ પ્રથમો વિધિઃ</para>
  <para style="p">
    <verse number="3" style="v"/>ફલતસ્તસ્માત્ તવ કલ્યાણં દેશે ચ દીર્ઘકાલમ્ આયુ ર્ભવિષ્યતીતિ|</para>
  <para style="p">
    <verse number="4" style="v"/>અપરં હે પિતરઃ, યૂયં સ્વબાલકાન્ મા રોષયત કિન્તુ પ્રભો ર્વિનીત્યાદેશાભ્યાં તાન્ વિનયત|</para>
  <para style="p">
    <verse number="5" style="v"/>હે દાસાઃ, યૂયં ખ્રીષ્ટમ્ ઉદ્દિશ્ય સભયાઃ કમ્પાન્વિતાશ્ચ ભૂત્વા સરલાન્તઃકરણૈરૈહિકપ્રભૂનામ્ આજ્ઞાગ્રાહિણો ભવત|</para>
  <para style="p">
    <verse number="6" style="v"/>દૃષ્ટિગોચરીયપરિચર્ય્યયા માનુષેભ્યો રોચિતું મા યતધ્વં કિન્તુ ખ્રીષ્ટસ્ય દાસા ઇવ નિવિષ્ટમનોભિરીશ્ચરસ્યેચ્છાં સાધયત|</para>
  <para style="p">
    <verse number="7" style="v"/>માનવાન્ અનુદ્દિશ્ય પ્રભુમેવોદ્દિશ્ય સદ્ભાવેન દાસ્યકર્મ્મ કુરુધ્વં|</para>
  <para style="p">
    <verse number="8" style="v"/>દાસમુક્તયો ર્યેન યત્ સત્કર્મ્મ ક્રિયતે તેન તસ્ય ફલં પ્રભુતો લપ્સ્યત ઇતિ જાનીત ચ|</para>
  <para style="p">
    <verse number="9" style="v"/>અપરં હે પ્રભવઃ, યુષ્માભિ ર્ભર્ત્સનં વિહાય તાન્ પ્રતિ ન્યાય્યાચરણં ક્રિયતાં યશ્ચ કસ્યાપિ પક્ષપાતં ન કરોતિ યુષ્માકમપિ તાદૃશ એકઃ પ્રભુઃ સ્વર્ગે વિદ્યત ઇતિ જ્ઞાયતાં|</para>
  <para style="p">
    <verse number="10" style="v"/>અધિકન્તુ હે ભ્રાતરઃ, યૂયં પ્રભુના તસ્ય વિક્રમયુક્તશક્ત્યા ચ બલવન્તો ભવત|</para>
  <para style="p">
    <verse number="11" style="v"/>યૂયં યત્ શયતાનશ્છલાનિ નિવારયિતું શક્નુથ તદર્થમ્ ઈશ્વરીયસુસજ્જાં પરિધદ્ધ્વં|</para>
  <para style="p">
    <verse number="12" style="v"/>યતઃ કેવલં રક્તમાંસાભ્યામ્ ઇતિ નહિ કિન્તુ કર્તૃત્વપરાક્રમયુક્તૈસ્તિમિરરાજ્યસ્યેહલોકસ્યાધિપતિભિઃ સ્વર્ગોદ્ભવૈ ર્દુષ્ટાત્મભિરેવ સાર્દ્ધમ્ અસ્માભિ ર્યુદ્ધં ક્રિયતે|</para>
  <para style="p">
    <verse number="13" style="v"/>અતો હેતો ર્યૂયં યયા સંકુेલે દિનેઽવસ્થાતું સર્વ્વાણિ પરાજિત્ય દૃઢાઃ સ્થાતુઞ્ચ શક્ષ્યથ તામ્ ઈશ્વરીયસુસજ્જાં ગૃહ્લીત|</para>
  <para style="p">
    <verse number="14" style="v"/>વસ્તુતસ્તુ સત્યત્વેન શૃઙ્ખલેન કટિં બદ્ધ્વા પુણ્યેન વર્મ્મણા વક્ષ આચ્છાદ્ય</para>
  <para style="p">
    <verse number="15" style="v"/>શાન્તેઃ સુવાર્ત્તયા જાતમ્ ઉત્સાહં પાદુકાયુગલં પદે સમર્પ્ય તિષ્ઠત|</para>
  <para style="p">
    <verse number="16" style="v"/>યેન ચ દુષ્ટાત્મનોઽગ્નિબાણાન્ સર્વ્વાન્ નિર્વ્વાપયિતું શક્ષ્યથ તાદૃશં સર્વ્વાચ્છાદકં ફલકં વિશ્વાસં ધારયત|</para>
  <para style="p">
    <verse number="17" style="v"/>શિરસ્ત્રં પરિત્રાણમ્ આત્મનઃ ખઙ્ગઞ્ચેશ્વરસ્ય વાક્યં ધારયત|</para>
  <para style="p">
    <verse number="18" style="v"/>સર્વ્વસમયે સર્વ્વયાચનેન સર્વ્વપ્રાર્થનેન ચાત્મના પ્રાર્થનાં કુરુધ્વં તદર્થં દૃઢાકાઙ્ક્ષયા જાગ્રતઃ સર્વ્વેષાં પવિત્રલોકાનાં કૃતે સદા પ્રાર્થનાં કુરુધ્વં|</para>
  <para style="p">
    <verse number="19" style="v"/>અહઞ્ચ યસ્ય સુસંવાદસ્ય શૃઙ્ખલબદ્ધઃ પ્રચારકદૂતોઽસ્મિ તમ્ ઉપયુક્તેનોત્સાહેન પ્રચારયિતું યથા શક્નુયાં</para>
  <para style="p">
    <verse number="20" style="v"/>તથા નિર્ભયેન સ્વરેણોત્સાહેન ચ સુસંવાદસ્ય નિગૂઢવાક્યપ્રચારાય વક્તૃाતા યત્ મહ્યં દીયતે તદર્થં મમાપિ કૃતે પ્રાર્થનાં કુરુધ્વં|</para>
  <para style="p">
    <verse number="21" style="v"/>અપરં મમ યાવસ્થાસ્તિ યચ્ચ મયા ક્રિયતે તત્ સર્વ્વં યદ્ યુષ્માભિ ર્જ્ઞાયતે તદર્થં પ્રભુના પ્રિયભ્રાતા વિશ્વાસ્યઃ પરિચારકશ્ચ તુખિકો યુષ્માન્ તત્ જ્ઞાપયિષ્યતિ|</para>
  <para style="p">
    <verse number="22" style="v"/>યૂયં યદ્ અસ્માકમ્ અવસ્થાં જાનીથ યુષ્માકં મનાંસિ ચ યત્ સાન્ત્વનાં લભન્તે તદર્થમેવાહં યુષ્માકં સન્નિધિં તં પ્રેષિતવાન|</para>
  <para style="p">
    <verse number="23" style="v"/>અપરમ્ ઈશ્વરઃ પ્રભુ ર્યીશુખ્રીષ્ટશ્ચ સર્વ્વેભ્યો ભ્રાતૃભ્યઃ શાન્તિં વિશ્વાસસહિતં પ્રેમ ચ દેયાત્|</para>
  <para style="p">
    <verse number="24" style="v"/>યે કેચિત્ પ્રભૌ યીશુખ્રીષ્ટેઽક્ષયં પ્રેમ કુર્વ્વન્તિ તાન્ પ્રતિ પ્રસાદો ભૂયાત્| તથાસ્તુ|</para>
</usx>
