<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Biblica® Vaba kasutusega Uus Testament, Pühakiri kaasaegses eesti keeles™</book>
  <para style="h">Matteuse evangeelium</para>
  <para style="toc1">Matteuse evangeelium</para>
  <para style="toc2">Matteuse</para>
  <para style="toc3">Mt</para>
  <para style="mt1">Matteuse evangeelium</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">Jeesuse Messia põlvnemine</para>
  <para style="li4">
    <verse number="1" style="v" sid="MAT 1:1"/>Jeesuse Messia, Aabrahami poja,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Sõna „poeg“ ei tähista Piiblis ainult otsest järglast, vaid kasutatakse laiemalt järeltulija tähenduses.</char></note> Taaveti poja sugupuu:<verse eid="MAT 1:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2"/>Aabrahamile sündis Iisak,</para>
  <para style="li1" vid="MAT 1:2">Iisakile sündis Jaakob,</para>
  <para style="li1" vid="MAT 1:2">Jaakobile sündisid Juuda ja tema vennad.<verse eid="MAT 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3"/>Juudale sündisid Taamariga Perets ja Serah,</para>
  <para style="li1" vid="MAT 1:3">Peretsile sündis Hesron,</para>
  <para style="li1" vid="MAT 1:3">Hesronile sündis Aram,<verse eid="MAT 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4"/>Aramile sündis Amminadab,</para>
  <para style="li1" vid="MAT 1:4">Amminadabile sündis Nahson,</para>
  <para style="li1" vid="MAT 1:4">Nahsonile sündis Salma,<verse eid="MAT 1:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5"/>Salmale sündis Raahabiga Boas,</para>
  <para style="li1" vid="MAT 1:5">Boasele sündis Rutiga Oobed,</para>
  <para style="li1" vid="MAT 1:5">Oobedile sündis Iisai,<verse eid="MAT 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6"/>Iisaile sündis kuningas Taavet.</para>
  <para style="b" vid="MAT 1:6"/>
  <para style="li1" vid="MAT 1:6">Taavetile sündis Uurija naisega Saalomon,<verse eid="MAT 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7"/>Saalomonile sündis Rehabeam,</para>
  <para style="li1" vid="MAT 1:7">Rehabeamile sündis Abija,</para>
  <para style="li1" vid="MAT 1:7">Abijale sündis Aasa,<verse eid="MAT 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8"/>Aasale sündis Joosafat,</para>
  <para style="li1" vid="MAT 1:8">Joosafatile sündis Jooram,</para>
  <para style="li1" vid="MAT 1:8">Jooramile sündis Ussija,<verse eid="MAT 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9"/>Ussijale sündis Jootam,</para>
  <para style="li1" vid="MAT 1:9">Jootamile sündis Aahas,</para>
  <para style="li1" vid="MAT 1:9">Aahasele sündis Hiskija,<verse eid="MAT 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10"/>Hiskijale sündis Manasse,</para>
  <para style="li1" vid="MAT 1:10">Manassele sündis Aamon,</para>
  <para style="li1" vid="MAT 1:10">Aamonile sündis Joosija,<verse eid="MAT 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11"/>Joosijale sündisid Jekonja ja tema vennad Paabeli vangipõlve ajal.<verse eid="MAT 1:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="MAT 1:12"/>Pärast Paabeli vangipõlve</para>
  <para style="li1" vid="MAT 1:12">sündis Jekonjale Sealtiel,</para>
  <para style="li1" vid="MAT 1:12">Sealtielile sündis Serubbaabel,<verse eid="MAT 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13"/>Serubbaabelile sündis Abihuud,</para>
  <para style="li1" vid="MAT 1:13">Abihuudile sündis Eljakim,</para>
  <para style="li1" vid="MAT 1:13">Eljakimile sündis Assur,<verse eid="MAT 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14"/>Assurile sündis Saadok,</para>
  <para style="li1" vid="MAT 1:14">Saadokile sündis Ahhim,</para>
  <para style="li1" vid="MAT 1:14">Ahhimile sündis Elihuud,<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>Elihuudile sündis Eleasar,</para>
  <para style="li1" vid="MAT 1:15">Eleasarile sündis Mattan,</para>
  <para style="li1" vid="MAT 1:15">Mattanile sündis Jaakob.<verse eid="MAT 1:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16"/>Jaakobile sündis Maarja mees Joosep ja Maarjast sündis Jeesus, keda hüütakse Messiaks.<verse eid="MAT 1:16"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="17" style="v" sid="MAT 1:17"/>Seega on Aabrahamist Taavetini kokku neliteist sugupõlve, Taavetist Paabeli vangipõlveni neliteist sugupõlve ja Paabeli vangipõlvest Messiani neliteist sugupõlve.<verse eid="MAT 1:17"/></para>
  <para style="s1">Jeesuse, Messia, sündimine</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Ent Jeesuse, Messia, sündimisega oli nõnda. Tema ema Maarja oli kihlatud Joosepiga, kuid enne abiellumist ja kokkusaamist selgus, et ta on lapseootel Pühast Vaimust. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Joosep oli õiglane mees ega tahtnud Maarjat avalikult häbistada, seepärast otsustas ta temast vaikselt lahutada. <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>Aga kui ta seda mõtet kaalus, ilmus talle unenäos Issanda ingel, kes ütles:</para>
  <para style="p" vid="MAT 1:20">„Joosep, Taaveti poeg, ära karda Maarjat naiseks võtta! Laps tema ihus on eostunud Pühast Vaimust. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Maarja sünnitab poja, kellele sina paned nimeks Jeesus,<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Nimi </char><char style="fq" closed="false">Jeesus </char><char style="ft" closed="false">tuleb heebrea keelsest <char style="tl">Yeshua</char>, mille juur tähendab päästet, kuid täisnimi tähendab „Issand päästab“.</char></note> sest tema päästab oma rahva nende pattudest.“<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>See kõik sündis, et läheks täide, mis Issand oli öelnud prohveti suu läbi: <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>„Pange tähele, neitsi jääb lapseootele ja sünnitab poja, ning talle pannakse nimeks Immanuel“ – mis tähendab „Jumal on meiega“.<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Kui Joosep unest ärkas, tegi ta nii, nagu Issanda ingel oli käskinud. Ta võttis Maarja endale naiseks ja viis ta koju, <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>kuid ei puutunud temasse, kuni poeg oli sündinud. Ja ta pani temale nimeks Jeesus.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Hommikumaa tarkade külaskäik</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Pärast Jeesuse sündimist Petlemmas Juudamaal, kuningas Heroodese valitsusajal, saabusid hommikumaalt pärit tähetargad Jeruusalemma.<verse eid="MAT 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 2:2"/>„Kus on see laps, kes sündis juutide kuningaks?“ küsisid nad. „Me nägime ta tähte tõusmas ja tulime teda kummardama.“<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Seda kuuldes läks kuningas Heroodes ärevile ja kogu Jeruusalemm koos temaga. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Ta kutsus kokku kõik juutide ülempreestrid ja kirjatundjad ning päris nende käest, kus Messias pidi sündima. <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>Need vastasid talle:</para>
  <para style="p" vid="MAT 2:5">„Juudamaa linnas Petlemmas, sest nõnda on prohvet kirjutanud:<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>„Sina, Petlemm Juudamaal,</para>
  <para style="q2" vid="MAT 2:6">ei ole vähim Juuda valitsejate seas,</para>
  <para style="q1" vid="MAT 2:6">sest sinust võrsub Valitseja,</para>
  <para style="q2" vid="MAT 2:6">kes mu rahvast Iisraeli karjatseb.“ “<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Siis kutsus Heroodes tähetargad salaja enda juurde ja uuris neilt välja aja, millal täht oli paistma hakanud. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Seejärel läkitas ta nad Petlemma, öeldes: „Minge ja otsige last. Kui te ta leiate, siis teatage mulle, et minagi võiksin minna teda kummardama!“<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Tähetargad kuulasid kuninga ära ja asusid teele. Ja ennäe, täht, mille tõusu nad olid jälginud, juhatas neid, kuni jäi seisma selle paiga kohal, kus asus laps. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Seda nähes rõõmustasid tähetargad väga. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Nad astusid majja ja nägid last koos tema ema Maarjaga ning kummardusid ta ette maha. Siis avasid nad oma varalaekad ja andsid talle kinke: kulda, viirukit ja mürri. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Ja saanud unenäos Jumalalt hoiatuse, et nad ei läheks enam Heroodese juurde, pöördusid nad teist teed pidi tagasi oma maale.<verse eid="MAT 2:12"/></para>
  <para style="s1">Põgenemine Egiptusesse</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Kui tähetargad olid lahkunud, ilmus Issanda ingel unenäos Joosepile ja ütles:</para>
  <para style="p" vid="MAT 2:13">„Tõuse üles, võta kaasa laps ja tema ema! Põgene Egiptusesse ja ole seal, kuni ma sulle ütlen; sest Heroodes hakkab otsima last, et teda hukata.“<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>Joosep tõusis, võttis kaasa lapse ja tema ema ning põgenes öösel Egiptusesse. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Seal viibis ta Heroodese surmani, et läheks täide, mida Issand oli öelnud prohveti kaudu: „Ma kutsusin oma poja Egiptusest.“<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Kui Heroodes nägi, et tähetargad olid teda petnud, sattus ta suurde raevu. Ta andis käsu hukata kõik poisslapsed Petlemmas ja kogu selle ümbruses: kaheaastased ja alla selle, vastavalt ajale, mille ta oli tähetarkadelt välja uurinud. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Nii läks täide, mis oli öeldud prohvet Jeremija suu läbi:<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>„Raamas on kuulda häält,</para>
  <para style="q2" vid="MAT 2:18">rohket nuttu ja hala.</para>
  <para style="q1" vid="MAT 2:18">Raahel nutab taga lapsi</para>
  <para style="q2" vid="MAT 2:18">ega lase end lohutada,</para>
  <para style="q2" vid="MAT 2:18">sest neid ei ole enam.“<verse eid="MAT 2:18"/></para>
  <para style="s1">Joosep asub perega elama Naatsaretti</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Ent pärast Heroodese surma ilmus Issanda ingel Egiptuses viibivale Joosepile unenäos <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>ja ütles:</para>
  <para style="p" vid="MAT 2:20">„Tõuse üles, võta kaasa laps ja tema ema ning mine Iisraelimaale! Need, kes lapse elu kallale kippusid, on nüüd surnud!“<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>Joosep võttis lapse ja tema ema ning läks Iisraelimaale. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Aga kui ta kuulis, et Arhelaos valitseb Juudamaad kuningana oma isa Heroodese asemel, kartis ta sinna minna. Ja saanud Jumalalt unenäos hoiatuse, suundus ta Galilea aladele <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ning asus elama Naatsareti linna. Nii läks täide, mis oli öeldud prohvetite suu läbi:</para>
  <para style="q1" vid="MAT 2:23">„Teda hüütakse Naatsaretlaseks.“<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Ristija Johannese kuulutus</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Neil päevil tuli Ristija Johannes, kes kuulutas Juuda kõrbes <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>ja ütles: „Parandage meelt, sest taevariik on lähedal!“ <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Temast rääkiski prohvet Jesaja:</para>
  <para style="q1" vid="MAT 3:3">„Hüüdja hääl on kõrbes:</para>
  <para style="q1" vid="MAT 3:3">„Valmistage Issandale tee,</para>
  <para style="q2" vid="MAT 3:3">tehke tasaseks tema teerajad!“ “<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Johannesel olid seljas kaamelikarvadest rõivad ja nahkvöö vööl, aga toiduks olid tal rohutirtsud ja metsmesi. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Siis läks Jeruusalemma, kogu Juudamaa ja Jordani ümbruskonna rahvas tema juurde. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Nad tunnistasid üles oma patud ja ta ristis nad Jordani jões.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Aga kui ta nägi, kui palju varisere ja sadusere<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Saduserid oli juudi preesterkonna aristokraatlik usulis-poliitiline rühmitus, kes juhtis templiteenistust, tunnistas Toorat, kuid mitte suulist pärimust, ei uskunud igavest elu. Variserid oli juutide Teise Templi aegne religioosne rühmitus, mis pidas tähtsaks nii Toora kui suulise pärimuse täpset järgimist. Usukommetes täitsid täpselt rabide käske (käsuõpetus) ja saduseride korraldusi.</char></note> tema juurde ristimisele tuli, ütles ta neile:</para>
  <para style="p" vid="MAT 3:7">„Rästikute sugu! Kes teile andis märku põgeneda saabuva viha eest? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Seepärast kandke meeleparandusele kohast vilja <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>ja ärge mõtelge endamisi: „Meie isa on Aabraham!“ Sest ma ütlen teile, Jumal võib nendest kividest äratada lapsi Aabrahamile. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Kirves on juba pandud puude juurte külge. Iga puu, mis ei kanna head vilja, raiutakse maha ja visatakse tulle.<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>Mina ristin teid veega meeleparanduseks, aga kes tuleb pärast mind, on minust vägevam. Mina pole väärt tema sandaalegi lahti siduma. Tema ristib teid Püha Vaimu ja tulega. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Tal on tuulamiskühvel käes ja ta teeb puhtaks oma rehealuse. Ta kogub nisu aita, aga aganad ta põletab ära kustumatu tulega.“<verse eid="MAT 3:12"/></para>
  <para style="s1">Johannes ristib Jeesuse</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Sel ajal saabus Jeesus Galileast Jordani äärde, et Johannes teda ristiks. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Johannes püüdis keelduda, öeldes:</para>
  <para style="p" vid="MAT 3:14">„Mul on vaja, et sina mind ristiksid, aga sina tuled hoopis minu juurde!“<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Jeesus aga vastas talle: „Las praegu olla nii! Nõnda on meil kohane täita kõike, mis on õige!“ Siis Johannes andis talle järele.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Kui Jeesus oli ristitud, väljus ta kohe veest, ja ennäe, taevas avanes ning ta nägi Jumala Vaimu otsekui tuvi alla laskumas ja tema peale tulemas. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Ning taevast kostis hääl: „See on minu armas Poeg, kelle üle mul on hea meel!“<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">Jeesust kiusatakse kõrbes</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Siis juhtis Vaim Jeesuse kõrbe kuradi<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Kreeka sõna </char><char style="fqa" closed="false">diabolos </char><char style="ft" closed="false">tähendab laimajat, süüdistajat.</char></note> kiusata. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Kui ta oli nelikümmend päeva ja nelikümmend ööd paastunud, tuli talle nälg. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Talle lähenes kiusaja ning ütles: „Kui sa oled Jumala Poeg, siis käsi sellel kivil siin muutuda leivaks!“<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Jeesus vastas: „Kirjutatud on: „Inimene ei ela üksnes leivast, vaid igast sõnast, mis lähtub Jumala suust.“ “<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Siis viis kurat ta pühasse linna, pani seisma templi katusele <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>ja ütles: „Kui sa oled Jumala Poeg, siis kukuta end siit alla! Sest kirjutatud on:</para>
  <para style="q1" vid="MAT 4:6">„Sinu pärast annab ta oma inglitele käsu</para>
  <para style="q2" vid="MAT 4:6">ja nemad kannavad sind kätel,</para>
  <para style="q2" vid="MAT 4:6">et sa oma jalga vastu kivi ei lööks.“ “<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Jeesus vastas talle: „Samuti on kirjutatud: „Ära pane Issandat, oma Jumalat, proovile!“ “<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Veel võttis kurat ta kaasa väga kõrge mäe otsa ja näitas talle kõiki maailma kuningriike ja nende hiilgust. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>„Need kõik ma annan sulle,“ ütles ta, „kui sa ainult maha langed ja mind ülistad.“<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Siis ütles Jeesus talle: „Hoia minust eemale, saatan!<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Heebrea sõna </char><char style="fqa" closed="false">satan </char><char style="ft" closed="false">tähendab mässajat, vastuhakkajat.</char></note> Kirjutatud on: „Kummarda Issandat, oma Jumalat, ja teeni ainult teda!“ “<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Siis jättis kurat ta rahule. Seejärel tulid tema juurde inglid ja teenisid teda.<verse eid="MAT 4:11"/></para>
  <para style="s1">Jeesus alustab tööd</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Kui Jeesus kuulis, et Johannes on kinni võetud, läks ta tagasi Galileasse. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Ta lahkus Naatsaretist ja asus elama Kapernauma, mis on järve ääres Sebuloni ja Naftali aladel. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>Nõnda läks täide, mis oli öeldud prohvet Jesaja suu läbi:<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>„Sebulonimaa ja Naftalimaa,</para>
  <para style="q2" vid="MAT 4:15">teel mere äärde, piki Jordanit,</para>
  <para style="q2" vid="MAT 4:15">rahvaste Galilea,<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>rahvas, kes elab pimeduses,</para>
  <para style="q2" vid="MAT 4:16">on suurt valgust näinud;</para>
  <para style="q1" vid="MAT 4:16">neile, kes on elanud surma varjus,</para>
  <para style="q2" vid="MAT 4:16">on koitnud valgus.“<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Sellest ajast peale hakkas Jeesus kuulutama: „Parandage meelt, sest taevariik on lähedal!“<verse eid="MAT 4:17"/></para>
  <para style="s1">Jeesus kutsub esimesed jüngrid</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Kõndides Galilea mere rannal, nägi Jeesus kaht venda, Siimonit, hüüdnimega Peetrus, ja tema venda Andreast võrku merre heitmas, sest nad olid kalurid. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Jeesus ütles neile: „Järgnege mulle ja ma teen teist inimestepüüdjad!“ <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Nad jätsid kohe oma võrgud ja järgnesid talle.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Sealt edasi minnes nägi ta veel kaht venda, Sebedeuse poega Jaakobust ja tema venda Johannest koos isaga paadis võrke parandamas. Jeesus kutsus ka neid. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Kohe jätsid nad paadi ja isa maha ning järgnesid talle.<verse eid="MAT 4:22"/></para>
  <para style="s1">Jeesus tervendab haigeid</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Ja Jeesus rändas ringi kogu Galileas, õpetas sünagoogides, kuulutas evangeeliumi Kuningriigist ning tervendas rahvast igasugustest haigustest ja hädadest. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Kuuldus temast levis kogu Süürias ning tema juurde toodi kõik, kes kannatasid mitmesuguste haiguste ja valude käes, kurjadest vaimudest vaevatuid, langetõbiseid ja halvatuid – ning tema tegi nad terveks. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Ja Jeesuse kannul käis suur rahvahulk Galileast, Dekapolisest, Jeruusalemmast, Juudamaalt ja Jordani tagant.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Mäejutlus</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Kui Jeesus nägi rahvahulka, läks ta üles mäele, ja kui ta oli maha istunud, tulid jüngrid tema juurde. <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Ta hakkas neid õpetama:<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>„Õnnistatud on vaimust vaesed,</para>
  <para style="q2" vid="MAT 5:3">sest nende päralt on taevariik.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Õnnistatud on kurvad,</para>
  <para style="q2" vid="MAT 5:4">sest neid lohutatakse.<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Õnnistatud on tasased,</para>
  <para style="q2" vid="MAT 5:5">sest nemad pärivad maa.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Õnnistatud on need, kellel on nälg ja janu õiguse järele,</para>
  <para style="q2" vid="MAT 5:6">sest nad saavad külluslikult.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Õnnistatud on halastajad,</para>
  <para style="q2" vid="MAT 5:7">sest nende peale halastatakse.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Õnnistatud on puhtad südamelt,</para>
  <para style="q2" vid="MAT 5:8">sest nemad näevad Jumalat.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Õnnistatud on rahutegijad,</para>
  <para style="q2" vid="MAT 5:9">sest neid hüütakse Jumala lasteks.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Õnnistatud on need, keda õiguse pärast taga kiusatakse,</para>
  <para style="q2" vid="MAT 5:10">sest nende päralt on taevariik.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>Õnnistatud olete teie, kui teid minu pärast teotatakse, taga kiusatakse ja teie kohta kõiksugu kurje asju valetatakse. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Rõõmutsege ja hõisake, sest teie tasu on suur taevas! Samal viisil on taga kiusatud ka prohveteid enne teid.<verse eid="MAT 5:12"/></para>
  <para style="s1">Sool ja valgus</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>Teie olete maa sool. Aga kui sool kaotab maitse, kuidas teha seda soolaseks? See ei kõlba enam millekski ja visatakse välja inimeste tallata.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>Teie olete maailma valgus. Linn, mis on mäe otsas, ei jää märkamatuks. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Samuti ei süüta keegi lampi, et panna see vaka alla, vaid ikka lambijalale; siis särab see kõigile majasolijatele. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Nõnda paistku teiegi valgus inimestele, et nad näeksid teie häid tegusid ja kiidaksid teie Isa, kes on taevas.<verse eid="MAT 5:16"/></para>
  <para style="s1">Moosese Seaduse täitmine</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>Ärge arvake, et ma olen tulnud Seadust või Prohveteid<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">St kogu heebrea Pühakirja.</char></note> tühistama – ma ei ole tulnud neid tühistama, vaid täide viima! <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Tõesti, ma ütlen teile, enne kaovad taevas ja maa, aga Seadusest ei kao ükski täht ega kriips, enne kui kõik on sündinud. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Seepärast, kes vähimatki käsusõnadest rikub ja õpetab teisi sama tegema, seda hüütakse vähimaks taevariigis; aga kes neid täidab ja õpetab, seda hüütakse suureks taevariigis. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Ma ütlen teile, kui teie pole kirjatundjatest ja variseridest õigemad, siis te ei pääse taevariiki.<verse eid="MAT 5:20"/></para>
  <para style="s1">Vihkamisest ja mõrvast</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>Te olete kuulnud, et muistsele põlvele on öeldud: „Sa ei tohi tappa! Ja igaüks, kes tapab, peab minema kohtu alla.“<verse eid="MAT 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 5:22"/>Kuid mina ütlen teile, et igaüks, kes oma venna peale viha kannab, peab minema kohtu alla. Aga kes oma vennale ütleb: „Tühine!“, peab minema ülemkohtu alla, ja kes ütleb: „Loll!“, peab minema põrgutulle.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>Seepärast, kui sa oma anni ohvrialtarile tood ja seal sulle meenub, et su vennal on midagi sinu vastu, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>siis jäta oma ohver altari ette ja mine lepi enne ära oma vennaga. Alles siis tule ja too oma ohvriand.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>Ole järeleandlik oma vastasega, kes sind kohtusse viib. Lepi temaga ära, kuni te veel teel olete, et ta ei annaks sind kohtuniku kätte ja kohtunik kohtuteenri kätte ja sind ei heidetaks vangi! <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Tõesti, ma ütlen sulle, sa ei pääse sealt enne, kuni sa oled tagasi maksnud viimsegi veeringu.<verse eid="MAT 5:26"/></para>
  <para style="s1">Abielurikkumisest</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>Te olete kuulnud, et on öeldud „Sa ei tohi abielu rikkuda!“ <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Kuid mina ütlen teile, et igaüks, kes võõrast naist vaatab teda himustades, on oma südames temaga juba abielu rikkunud. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Kui aga su parem silm ahvatleb sind patule, siis võta see välja ja viska ära. Sul on parem kaotada üks ihuliige kui olla terve ihuga heidetud põrgusse. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Ja kui su parem käsi ahvatleb sind patule, siis raiu see küljest ja viska ära, sest sul on parem kaotada üks ihuliige kui minna terve ihuga põrgusse.<verse eid="MAT 5:30"/></para>
  <para style="s1">Abielulahutusest</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>Öeldud on: „Kes oma naisest lahutab, andku talle lahutustunnistus!“ <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Kuid mina ütlen teile, et igaüks, kes lahutab oma naisest muul põhjusel kui abielurikkumine, teeb temast abielurikkuja. Ja kes abiellub lahutatud naisega, rikub abielu.<verse eid="MAT 5:32"/></para>
  <para style="s1">Vannete andmisest</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>Samuti olete kuulnud, et muistsele põlvele on öeldud: „Ära murra oma vandetõotusi, vaid täida oma lubadused Issandale!“ <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Kuid mina ütlen teile, et te ei vannuks üldse: ei taeva nimel, sest see on Jumala troon; <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>ega maa nimel, sest see on tema jalgealune järg; ega Jeruusalemma nimel, sest see on suure Kuninga linn! <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Ära vannu ka oma pea nimel, sest ise ei saa ühtegi juuksekarva mustaks või valgeks teha. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Teie „jah“ olgu „jah“ ja teie „ei“ olgu „ei“. Kõik, mis sellele lisatakse, on kurjast.<verse eid="MAT 5:37"/></para>
  <para style="s1">Silm silma vastu</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>Te olete kuulnud, et on öeldud: „Silm silma ja hammas hamba vastu!“ <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Kuid mina ütlen teile, ärge hakake vastu inimesele, kes teile kurja teeb! Kui keegi lööb sind paremale põsele, keera ka vasak tema poole! <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Ja sellele, kes tahab sind kohtusse kaevata ja su särgi võtta, anna ka kuub! <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Ja kui keegi sunnib sind käima ühe miili, mine temaga kaks! <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Anna, kui sinult palutakse, ja ära keeldu, kui sinult tahetakse laenata!<verse eid="MAT 5:42"/></para>
  <para style="s1">Vaenlase armastamisest</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>Te olete kuulnud, et on öeldud: „Armasta oma ligimest ja vihka oma vaenlast!“ <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Kuid mina ütlen teile, armastage oma vaenlasi ja palvetage nende eest, kes teid taga kiusavad. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Siis te olete tõesti oma taevase Isa lapsed; sest tema laseb oma päikesel tõusta nii kurjade kui heade üle ning vihma sadada ühtviisi õiglaste ja ülekohtuste peale. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Sest kui te armastate neid, kes teid armastavad, mis tasu te siis ootate? Eks maksukogujad tee ju sama? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Ja kui te ainult oma sõpru lahkelt tervitate, mis selles erilist on? Eks paganadki tee sedasama? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Seepärast olge täiuslikud, nagu teie taevane Isa on täiuslik!<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Andmisest</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>Vaadake, et te oma häid tegusid ei teeks inimestele näitamise pärast, muidu ei ole teil tasu oma Isalt, kes on taevas!<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>Kui sa nüüd annad neile, kel puudus, siis ära kuuluta sellest pasunahüüuga, nagu silmakirjatsejad teevad sünagoogides ja tänavail, et inimesed neid kiidaksid. Tõesti, ma ütlen teile, neil on oma tasu juba käes! <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Aga kui sina annad, ärgu su vasak käsi teadku, mida su parem käsi teeb! <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>Jäägu su heategu salajasse, ja su Isa, kes näeb salajasse, tasub sulle.<verse eid="MAT 6:4"/></para>
  <para style="s1">Palvetamisest</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>Ja kui te palvetate, siis ärge olge nagu silmakirjatsejad, kes armastavad palvetada sünagoogides ja tänavanurkadel, et olla inimestele nähtavad! Tõesti, ma ütlen teile, neil on oma tasu juba käes! <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Aga kui sina palvetad, siis mine oma kambrisse, sule uks ja palveta oma Isa poole salajas. Ja sinu Isa, kes näeb salajasse, tasub sulle!<verse eid="MAT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7"/>Palvetades ärge lobisege nagu paganad, kes arvavad, et neid võetakse kuulda nende sõnarohkuse tõttu. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Ärge saage nende sarnaseks! Teie Isa ju teab, mida te vajate, enne kui te temalt palute.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>Palvetage siis nõnda:</para>
  <para style="q1" vid="MAT 6:9">Meie Isa, kes sa oled taevas!</para>
  <para style="q2" vid="MAT 6:9">Pühitsetud olgu sinu nimi!<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>Sinu riik tulgu,</para>
  <para style="q1" vid="MAT 6:10">sinu tahtmine sündigu</para>
  <para style="q2" vid="MAT 6:10">nagu taevas, nõnda ka maa peal!<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Meie igapäevast leiba anna meile tänapäev!<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Ja anna meile andeks meie võlad,</para>
  <para style="q2" vid="MAT 6:12">nagu meiegi andeks anname oma võlglastele!<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Ja ära saada meid kiusatusse,</para>
  <para style="q2" vid="MAT 6:13">vaid päästa meid ära kurjast!</para>
  <para style="q1" vid="MAT 6:13">Sest sinu päralt on riik ja vägi ja au igavesti. Aamen.<verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>Sest kui te annate teistele andeks nende eksimused, siis annab ka teie Isa, kes on taevas, teile andeks. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Kui te aga ei anna teistele andeks, siis ei anna ka teie Isa teie eksimusi teile andeks.<verse eid="MAT 6:15"/></para>
  <para style="s1">Paastumisest</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>Kui te paastute, siis ärge olge mornid nagu silmakirjatsejad, kes teevad sellise näo, et inimestele oleks nähtav nende paastumine. Tõesti, ma ütlen teile, neil on oma tasu juba käes! <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Aga kui sina paastud, siis korrasta oma juuksed ja pese nägu, <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>et su paastumine ei oleks nähtav inimestele, vaid su Isale, kes on varjatud. Ja su Isa, kes näeb varjatutki, tasub sulle avalikult!<verse eid="MAT 6:18"/></para>
  <para style="s1">Varandus taevas</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>Ärge koguge endale varandust maa peale, kus koi ja rooste seda hävitavad ja kuhu vargad sisse murravad ja varastavad! <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Koguge endile varandust taevasse, kus koi ega rooste seda ei hävita ja kuhu vargad sisse ei murra ega varasta. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Sest kus on su varandus, seal on ka su süda!<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>Silm on ihu lamp. Kui su silm on hea, on su ihu täidetud valgusega. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Aga kui su silm on kuri, on su ihu täidetud pimedusega. Kui valgus sinu sees on pime, kui suur on siis pimedus?<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>Keegi ei saa teenida kahte isandat, sest ta kas vihkab üht ja armastab teist või kiindub ühesse ja jälestab teist. Teiegi ei saa teenida korraga Jumalat ja mammonat.<verse eid="MAT 6:24"/></para>
  <para style="s1">Ärge muretsege</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>Seepärast ma ütlen teile, ärge muretsege oma elu pärast, mida süüa või juua, ega ihu pärast, mida selga panna! Eks elu ole enam kui toit ja ihu enam kui rõivad? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Vaadake linde taevas! Nad ei külva ega lõika ega kogu aita saaki, ning teie taevane Isa toidab neid. Kui palju enam väärt nendest olete teie! <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Aga kes teie seast suudaks muretsemisega ennast ühe küünragi pikemaks teha? <verse eid="MAT 6:27"/><verse number="28" style="v" sid="MAT 6:28"/>Ja miks te muretsete riiete pärast? Pange tähele, kuidas kasvavad lilled aasal! Nad ei näe vaeva ketramisega, <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>kuid ma ütlen teile, et isegi Saalomon kogu oma hiilguses ei olnud riietatud nii nagu igaüks neist. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Kui aga Jumal riietab rohu väljal nii, mis täna on siin ja homme heidetakse tulle, kui palju enam ta riietab siis teid, te nõdrausulised!<verse eid="MAT 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31"/>Ärge siis enam muretsege, öeldes: „Mida me sööme?“ või „Mida me joome?“ või „Mida me selga paneme?“ <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Selle pärast muretsevad paganad. Teie taevane Isa teab ju, et te seda kõike vajate. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Aga otsige esmalt Jumala riiki ja tema õigust, siis seda kõike antakse teile pealegi! <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Ärge siis muretsege homse pärast, sest homme muretseb ise enda eest. Igale päevale piisab oma vaevast.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Kohtumõistmisest teiste üle</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>Ärge mõistke kohut, et teie üle ei mõistetaks kohut! <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Sest samamoodi, nagu teie teiste üle kohut mõistate, mõistetakse kohut teiegi üle, ja nõnda nagu teie teistele mõõdate, mõõdetakse teile. <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>Miks sa näed pindu oma venna silmas, aga palki enda silmas ei märka? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Või kuidas sa võid oma vennale öelda: „Lase ma tõmban pinnu sinu silmast välja!“ ja sul endal on silmas palk? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Silmakirjatseja, tõmba esmalt palk oma silmast välja, ja siis sa näed ka pindu oma venna silmast välja tõmmata!<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>Ärge andke koertele seda, mis on püha, ärge heitke oma pärleid sigade ette! Et nad neid ei tallaks jalgade alla ega pöörduks tagasi ja teid tükkideks ei rebiks!<verse eid="MAT 7:6"/></para>
  <para style="s1">Küsige, otsige, koputage</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>Küsige, ja teile antakse; otsige, ja te leiate; koputage uksele, ja teile avatakse! <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Igaüks, kes palub, see saab; kes otsib, see leiab; ja kes koputab, sellele avatakse.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>Kas teie seas on kedagi, kes annaks oma pojale kivi, kui poeg palub temalt leiba? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Või annaks mao, kui poeg palub temalt kala? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Kui nüüd teie, kes te olete kurjad, oskate anda häid ande oma lastele, kui palju enam teie Isa taevas annab häid asju neile, kes teda paluvad! <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Kõike siis, mida te iganes tahate, et inimesed teile teeksid, tehke ka neile! See ongi Seaduse ja Prohvetite sõnumi sisu.<verse eid="MAT 7:12"/></para>
  <para style="s1">Kitsas ja lai värav</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>Minge sisse kitsast väravast, sest lai on värav ja avar on tee, mis viib hukatusse, ja palju on neid, kes sealtkaudu lähevad. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Kuid väike on värav ja kitsas on tee, mis viib ellu, ja vähe on neid, kes selle leiavad.<verse eid="MAT 7:14"/></para>
  <para style="s1">Õiged ja valed prohvetid</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>Hoiduge valeprohvetitest, kes tulevad teie juurde lambanahas, aga tegelikult on nad aplad hundid. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Te tunnete nad ära nende viljast. Ei korjata ju viinamarju kibuvitstest ega viigimarju ohakaist? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Nii kannab siis iga hea puu head vilja, aga halb puu halba vilja. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Hea puu ei saa kanda halba vilja ega halb puu kanda head vilja. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Iga puu, mis ei kanna head vilja, raiutakse maha ja visatakse tulle. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Seega te tunnete nad ära nende viljast!<verse eid="MAT 7:20"/></para>
  <para style="s1">Õiged ja valed jüngrid</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>Mitte igaüks, kes mulle ütleb: „Issand, Issand!“, ei saa taevariiki. Saab vaid see, kes teeb mu Isa tahtmist, kes on taevas. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Paljud ütlevad mulle sel päeval: „Issand, Issand, kas me ei ole sinu nimel prohveteerinud ega ajanud sinu nimel välja kurje vaime ega teinud sinu nimel palju imesid?“ <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Siis ma tunnistan neile: „Ma ei ole teid kunagi tundnud. Minge ära, te ülekohtutegijad!“<verse eid="MAT 7:23"/></para>
  <para style="s1">Arukad ja rumalad ehitajad</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>Seepärast igaüks, kes neid mu sõnu kuuleb ja nende järgi teeb, on kui arukas mees, kes ehitas oma maja kaljule. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Kui sadas paduvihma, tõusid marutuul ja tulvavesi ning langesid selle maja peale, siis see ei varisenud, sest see oli rajatud kaljule. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Ent igaüks, kes neid mu sõnu kuuleb, aga nende järgi ei tee, on võrreldav rumala mehega, kes ehitas oma maja liivale. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Kui sadas paduvihma, tõusid marutuul ja tulvavesi ning langesid maja peale, siis see varises ja selle häving oli suur.“<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Kui Jeesus need kõned lõpetas, oli rahvas tema õpetusest vapustatud, <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>sest ta õpetas nagu see, kellel on meelevald, aga mitte nagu kirjatundjad.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Jeesus tervendab pidalitõbise</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Kui Jeesus tuli mäelt alla, järgnes talle suur rahvahulk. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Tema juurde astus pidalitõbine, põlvitas ta ette ja ütles: „Issand, kui sa tahad, siis sa võid mu puhtaks teha!“<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>Jeesus sirutas käe, puudutas teda ja ütles: „Ma tahan, saa puhtaks!“ Ja mees sai otsekohe pidalitõvest puhtaks. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Siis ütles Jeesus talle: „Vaata, et sa sellest kellelegi ei räägi, vaid mine näita ennast preestrile ja vii neile tunnistuseks ohvriand, nagu Mooses on käskinud!“<verse eid="MAT 8:4"/></para>
  <para style="s1">Sadakonna ülema usk</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Kui Jeesus jõudis Kapernauma, tuli ta juurde sadakonna ülem ja palus abi: <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>„Issand, mu teener lebab kodus halvatuna suurtes piinades!“<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>„Kas ma pean tulema ja ta terveks tegema?“ küsis Jeesus.<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>„Issand,“ vastas sadakonna ülem talle, „ma ei ole väärt, et sina minu katuse alla tuleksid. Anna vaid käsk ja mu teener paraneb! <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Mina ise olen ju samuti võimu alla seatud ja minule alluvad sõdurid. Kui ma ütlen ühele neist: „Mine!“, siis ta läheb. Ma ütlen teisele: „Tule!“ ja ta tuleb. Ma ütlen oma teenrile: „Tee seda!“ ja ta teeb.“<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Seda kuuldes Jeesus imestas ja ütles neile, kes ta järel käisid: „Tõesti, ma ütlen teile, sellist usku ei ole ma leidnud Iisraelis veel kellelgi. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Ma ütlen teile, et paljud tulevad idast ja läänest ning istuvad taevariigis pidulauda koos Aabrahami, Iisaki ja Jaakobiga. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Kuningriigi sünnijärgsed alamad aga heidetakse välja pimedusse, kus on ulgumine ja hammaste kiristamine.“<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Nüüd ütles Jeesus sadakonna ülemale: „Mine! Sündigu sulle nõnda, nagu sa oled uskunud!“ Ülema teener sai samal tunnil terveks.<verse eid="MAT 8:13"/></para>
  <para style="s1">Tervendamised Peetruse kodus</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Kui Jeesus jõudis Peetruse majja, nägi ta tema ämma voodis lebamas palavikus. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Jeesus võttis naisel käest kinni, ja palavik lahkus temast, ning ta tõusis üles ja kattis talle laua.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>Õhtu saabudes toodi Jeesuse juurde palju kurjadest vaimudest vaevatuid, ja ta ajas neist vaimud välja sõnaga ning tegi terveks kõik haiged. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Nii läks täide, mis oli öeldud prohvet Jesaja suu läbi:</para>
  <para style="q1" vid="MAT 8:17">„Ta võttis enese peale meie haigused</para>
  <para style="q2" vid="MAT 8:17">ja kandis meie tõved.“<verse eid="MAT 8:17"/></para>
  <para style="s1">Jeesusele järgnemise hind</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Nähes rahvahulka enda ümber, käskis Jeesus sõita järve teisele kaldale. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Üks kirjatundja astus tema juurde ja ütles: „Õpetaja, ma järgnen sulle, kuhu sa iganes lähed!“<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Jeesus vastas talle: „Rebastel on urud ja lindudel pesad, aga Inimese Pojal ei ole, kuhu oma pead panna.“<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Üks teine jünger ütles Jeesusele: „Issand, luba mul esmalt minna isa matma!“<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Jeesus ütles talle: „Järgne mulle, las surnud matta ise oma surnuid!“<verse eid="MAT 8:22"/></para>
  <para style="s1">Jeesus vaigistab tormi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Siis astus Jeesus paati ja ta jüngrid järgnesid talle. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Äkki tõusis järvel suur torm, nii et lained lõid üle paadi; Jeesus aga magas. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Jüngrid tulid tema juurde ja äratasid ta üles, hüüdes: „Issand, päästa meid, me upume!“<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>„Teie nõdrausulised, miks te nii hirmul olete?“ vastas Jeesus. Siis tõusis ta üles, sõitles tuult ja laineid ning kõik jäi täiesti vaikseks.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Inimesed aga imestasid, öeldes: „Mis mees see küll on, et isegi tuul ja lained talle kuuletuvad?“<verse eid="MAT 8:27"/></para>
  <para style="s1">Jeesus vabastab kaks meest kurjadest vaimudest</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Kui Jeesus jõudis teisele kaldale gerasalaste maale, tulid talle vastu kaks hauakoopaist väljunud kurjast vaimust vaevatud meest, kes olid nii vägivaldsed, et keegi ei julgenud seda teed käia. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Need karjusid: „Mis on sul meiega asja, Jumala Poeg? Kas sa oled tulnud meid piinama enne määratud aega?“<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Aga eemal oli suur seakari söömas. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Kurjad vaimud anusid Jeesust: „Kui sa meid välja ajad, siis saada meid selle seakarja sisse!“<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>„Minge!“ ütles Jeesus neile. Need tulid välja ja läksid sigadesse. Ja ennäe, kogu kari tormas järsakult järve ja uppus! <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Karjased aga põgenesid, läksid linna ja rääkisid kõigest, ka sellest, mis oli juhtunud kurjast vaimust vaevatud meestega. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Ja kogu linnarahvas tuli Jeesusele vastu. Teda nähes palusid nad, et ta nende aladelt lahkuks.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">Jeesus annab halvatule andeks ja tervendab ta</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Jeesus astus paati, sõitis teisele poole järve ja läks oma kodulinna. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Seal toodi tema juurde halvatu, kes lamas oma magamisasemel. Nähes nende usku, ütles Jeesus halvatule: „Ole julge, poeg! Sinu patud on sulle andeks antud!“<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>Siis mõned kirjatundjad mõtlesid endamisi: „See mees teotab Jumalat!“<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Jeesus aga, teades nende mõtteid, küsis neilt: „Miks te mõtlete kurja oma südames? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Kumb on kergem, kas öelda „Sinu patud on andeks antud“ või „Tõuse üles ja kõnni“? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Aga teadke, et Inimese Pojal on meelevald patte andeks anda maa peal.“ Ja ta ütles halvatule: „Tõuse üles, võta oma ase ja mine koju!“ <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Ning mees tõusis ja läks koju. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Seda nähes oli rahvas hämmastuses ja nad ülistasid Jumalat, kes on andnud inimestele sellise meelevalla.<verse eid="MAT 9:8"/></para>
  <para style="s1">Matteuse kutsumine</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Sealt edasi minnes nägi Jeesus meest nimega Matteus maksukoguja pingil istumas ning ütles talle: „Järgne mulle!“ Ja ta tõusis ja järgnes talle.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Kui siis Jeesus istus lauas tema kodus, tuli sinna palju maksukogujaid ja patuseid ning sõid koos Jeesuse ja tema jüngritega. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Seda nähes küsisid variserid tema jüngritelt: „Miks teie õpetaja sööb koos maksukogujate ja patustega?“<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Seda kuuldes ütles Jeesus: „Arsti ei vaja terved, vaid haiged. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Minge ja õppige, mida tähendab „Ma soovin halastust, mitte ohvrit“. Mina ei ole tulnud kutsuma õigeid, vaid patuseid.“<verse eid="MAT 9:13"/></para>
  <para style="s1">Paastumise küsimus</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Siis tulid Johannese jüngrid Jeesuse juurde ja küsisid: „Miks meie ja variserid paastume, aga sinu jüngrid ei paastu?“<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Jeesus vastas neile: „Ei sobi pulmalistel leinata ajal, kui peigmees on nendega. Ent tuleb aeg, mil peigmees neilt ära võetakse, küll nad siis paastuvad.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>Keegi ei paika vanutamata riidetükiga vana kuube. Säärane paik rebeneks küljest ja käristaks augu veel suuremaks. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Samuti ei valata värsket veini vanadesse nahklähkritesse, muidu lähkrid lõhkevad, vein voolab maha ja lähkreid ei saa enam kasutada. Värske vein valatakse uutesse lähkritesse, siis säilivad mõlemad.“<verse eid="MAT 9:17"/></para>
  <para style="s1">Surnud tüdruk ja haige naine</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Kui ta seda neile rääkis, tuli tema juurde sünagoogi ülem, põlvitas ta ette ja ütles: „Just praegu suri mu tütar, aga tule, pane oma käsi ta peale, siis ta ärkab ellu!“ <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>Jeesus tõusis ja järgnes talle koos oma jüngritega.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Ja näe, üks naine, kes oli kannatanud verejooksu juba kaksteist aastat, lähenes Jeesusele selja tagant ja puudutas ta kuue serva, <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>öeldes endamisi: „Kui ma võiksin puudutada kasvõi tema kuube, siis ma saaksin terveks!“<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Jeesus aga pöördus ümber, nägi teda ja ütles: „Ole julge, tütar! Sinu usk on sind terveks teinud!“ Ja sellest tunnist alates oli naine terve.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Kui nüüd Jeesus jõudis sünagoogi ülema majja ning nägi flöödimängijaid ja häälekat rahvahulka, <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>ütles ta: „Minge ära! Tüdruk ei ole surnud, vaid magab!“ Aga nad naersid tema üle. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Ent kui rahvahulk oli välja aetud, astus Jeesus tuppa, võttis tüdruku käest kinni ja ta ärkas üles. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Ja kuuldus sellest levis kogu ümbruskonnas.<verse eid="MAT 9:26"/></para>
  <para style="s1">Jeesus tervendab pimedad ja tumma</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Kui Jeesus läks sealt edasi, järgnesid talle kaks pimedat, kes hüüdsid: „Taaveti Poeg, halasta meie peale!“<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Kui Jeesus oli majja astunud, tulid pimedad tema juurde ja ta küsis neilt: „Kas te usute, et ma suudan seda teha?“</para>
  <para style="p" vid="MAT 9:28">„Jah, Issand,“ vastasid nad talle.<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Siis Jeesus puudutas nende silmi ja ütles: „Teile sündigu teie usku mööda!“<verse eid="MAT 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30"/>Ja nende silmad avanesid. Nüüd Jeesus hoiatas neid karmilt: „Vaadake, et keegi sellest teada ei saa!“ <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Nemad aga läksid ja rääkisid sellest terves ümbruskonnas.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Kui nad olid lahkunud, siis toodi tema juurde tumm mees, kes oli kurjast vaimust vaevatud. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Jeesus ajas kurja vaimu välja ja tumm hakkas rääkima. „Sellist asja pole Iisraelis veel nähtud!“ imestas rahvas.<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Variserid aga ütlesid: „Ta ajab kurje vaime välja kurjade vaimude valitseja abil!“<verse eid="MAT 9:34"/></para>
  <para style="s1">Töötegijaid on vähe</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Ja Jeesus käis läbi kõik linnad ja külad, õpetades sünagoogides, kuulutas evangeeliumi Kuningriigist ning tervendas igasugustest haigustest ja hädadest. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Rahvahulki nähes tundis ta neile kaasa, sest nad olid rõhutud ja räsitud nagu lambad, kellel pole karjast. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Siis ta ütles oma jüngritele: „Lõikus on suur, aga töötegijaid on vähe. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Seepärast paluge lõikuse Issandat, et ta saadaks töötegijaid välja oma lõikusele!“<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">Jeesus läkitab kaksteist apostlit</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Jeesus kutsus oma kaksteist jüngrit enda juurde ja andis neile meelevalla rüvedaid vaime välja ajada ning parandada kõiki haigusi ja hädasid.<verse eid="MAT 10:1"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="2" style="v" sid="MAT 10:2"/>Nende kaheteistkümne apostli nimed olid:</para>
  <para style="b" vid="MAT 10:2"/>
  <para style="li1" vid="MAT 10:2">kõigepealt Siimon, keda hüüti Peetruseks, ja tema vend Andreas,</para>
  <para style="li1" vid="MAT 10:2">siis Sebedeuse poeg Jaakobus ja tema vend Johannes,<verse eid="MAT 10:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3"/>Filippus ja Bartolomeus,</para>
  <para style="li1" vid="MAT 10:3">Toomas ja maksukoguja Matteus,</para>
  <para style="li1" vid="MAT 10:3">Alfeuse poeg Jaakobus ja Taddeus,<verse eid="MAT 10:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4"/>Siimon Kaanalane ja Juudas Iskariot – Jeesuse äraandja.<verse eid="MAT 10:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Jeesus läkitas välja need kaksteist, juhendades neid nõnda: „Ärge minge teiste rahvaste sekka ega astuge ühessegi samaarlaste linna. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Vaid minge kadunud lammaste, Iisraeli rahva juurde! <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Minnes kuulutage: „Taevariik on lähedal!“ <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Tehke terveks haiged, äratage üles surnud, tehke puhtaks pidalitõbised, ajage välja kurjad vaimud! Ilma olete saanud, ilma ka andke!<verse eid="MAT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9"/>Ärge võtke kaasa kuld-, hõbe- ega vaskraha oma vöö vahele, <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ei reisipauna ega teist särki ega jalatseid ega keppi. Sest töötegija on oma ülalpidamist väärt! <verse eid="MAT 10:10"/><verse number="11" style="v" sid="MAT 10:11"/>Kui te lähete mõnda külasse või linna, siis kuulake järele, kes on selles paigas väärt teid võõrustama, ja tema juurde jääge, kuni te lahkute. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Majja sisenedes tervitage seda! <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Ja kui maja on seda väärt, jätke oma rahu selle peale, aga kui ei ole, tulgu teie rahu tagasi teie juurde. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Aga kui keegi teid vastu ei võta ja teie sõnumit ei kuula, siis sellest kodust või linnast lahkudes raputage maha selle koha tolmgi oma jalgadelt. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Tõesti, ma ütlen teile, isegi Soodomal ja Gomorral läheb kohtupäeval kergemini kui sellel linnal.<verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>Ma saadan teid otsekui lambaid huntide sekka. Olge siis arukad nagu maod ja süütud kui tuvid! <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>Olge valvsad inimeste suhtes, sest nad annavad teid kohtute kätte ja lasevad piitsutada sünagoogides. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Minu pärast viiakse teid valitsejate ja kuningate ette, et te saaksite neile ja rahvastele tunnistada.<verse eid="MAT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 10:19"/>Kui nad teid kinni võtavad, siis ärge muretsege, mida või kuidas rääkida. Sel tunnil antakse teile see, mida öelda, <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>sest te ei räägi ise, vaid teie Isa Vaim kõneleb teie kaudu. <verse eid="MAT 10:20"/><verse number="21" style="v" sid="MAT 10:21"/>Vend saadab surma venna ja isa lapse ning lapsed tõusevad vanemate vastu ja lasevad nad surmata. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Minu nime pärast olete te kõigi poolt vihatud, ent kes peab vastu lõpuni, see pääseb. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Kui teid ühes linnas taga kiusatakse, põgenege teise! Tõesti, ma ütlen teile, te ei jõua Iisraeli linnu läbi käia, enne kui Inimese Poeg tuleb.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>Jünger ei ole üle õpetajast ega teener parem oma isandast. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Jünger olgu rahul, kui ta käsi käib nagu tema õpetajal, ja teener olgu rahul, kui ta käsi käib nagu isandal. Kui nad juba peremeest nimetasid Peltsebuliks, kui palju enam siis tema pereliikmeid!<verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>Seepärast ärge kartke neid! Midagi ei ole varjatut, mida ei paljastataks, ega salajast, mis teatavaks ei saaks. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Mida mina räägin teile pimedas, ütelge valges, ja mida te kuulete kõrva sosistatavat, kuulutage katustelt! <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Ärge kartke neid, kes ihu tapavad, aga hinge tappa ei suuda. Pigem kartke teda, kes võib nii hinge kui ka ihu põrgus hukata! <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Eks kaks varblast müüda ühe penni eest? Ometi ükski neist ei lange maha ilma teie Isa loata. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Ent teie juuksekarvadki on kõik ära loetud. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Ärge siis kartke, te olete rohkem väärt kui palju varblasi.<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>Igaüht nüüd, kes mind tunnistab inimeste ees, teda tunnistan ka mina oma Isa ees, kes on taevas. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Aga seda, kes salgab mind inimeste ees, salgan minagi oma Isa ees, kes on taevas.<verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>Ärge arvake, et ma olen tulnud rahu tooma maa peale! Ma ei tulnud tooma rahu, vaid mõõka! <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Ma tulin pöörama</para>
  <para style="q1" vid="MAT 10:35">„meest tema isa vastu,</para>
  <para style="q2" vid="MAT 10:35">tütart tema ema vastu</para>
  <para style="q1" vid="MAT 10:35">ja miniat tema ämma vastu.<verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>Ja mehe vaenlaseks saavad tema pereliikmed“.<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>Kes isa või ema armastab rohkem kui mind, ei ole mind väärt. Kes poega või tütart armastab rohkem kui mind, ei ole mind väärt. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Ja kes ei võta oma risti ega järgne mulle, ei ole mind väärt. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Kes oma elu hoiab, kaotab selle, ja kes oma elu kaotab minu pärast, leiab selle.<verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>Kes teid vastu võtab, võtab vastu minu, ja kes minu vastu võtab, võtab vastu selle, kes minu saatis. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Kes prohveti vastu võtab kui prohveti, saab prohveti tasu, ja kes õiglase mehe vastu võtab, sest ta on õiglane, saab õiglase inimese tasu. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Kes iganes pakub kruusitäie jahedat vett ühele neist väikestest, kes on minu jünger – tõesti, ma ütlen teile, ta ei jää oma tasust ilma.“<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">Jeesus ja Ristija Johannes</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Kui Jeesus oli lõpetanud juhiste jagamise oma kaheteistkümnele jüngrile, läks ta sealt edasi õpetama ja kuulutama Galilea linnadesse.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Kui nüüd Johannes vanglas olles kuulis Messia tegudest, saatis ta kaks oma jüngritest <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>temalt küsima: „Kas sina oled see, kes pidi tulema, või me peame ootama kedagi teist?“<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Jeesus vastas neile: „Minge ja teatage Johannesele, mida te kuulete ja näete: <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>pimedad saavad nägijaks, jalust vigased kõnnivad, pidalitõbised saavad puhtaks, kurdid kuulevad, surnud tõusevad üles, vaestele kuulutatakse evangeeliumi. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Õnnistatud on igaüks, kes minu pärast ei pahanda.“<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Kui Johannese jüngrid olid lahkunud, hakkas Jeesus rahvale temast rääkima:</para>
  <para style="p" vid="MAT 11:7">„Mida te käisite kõrbes vaatamas? Kas tuules kõikuvat kõrt? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Või mida te tahtsite välja minnes näha? Kas peenetes rõivastes meest? Need, kes kannavad peeneid rõivaid, on kuningakodades. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Mida te siis tahtsite näha? Kas prohvetit? Jah, ma ütlen teile, palju enam kui prohvetit! <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Tema on see, kellest on kirjutatud:</para>
  <para style="q1" vid="MAT 11:10">„Vaata, ma saadan sinu ees oma saadiku,</para>
  <para style="q2" vid="MAT 11:10">kes valmistab sinu tee su ees!“<verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>Tõesti, ma ütlen teile, naisest sündinute seast ei ole tõusnud esile kedagi suuremat kui Ristija Johannes, ent kõige pisemgi taevariigis on temast suurem. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Ristija Johannese päevist tänini rünnatakse taevariiki ja ründajad kisuvad selle endale. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Kogu Seadus ja Prohvetid on ette kuulutanud Johanneseni, <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ja kui teada tahate, siis tema ongi Eelija, kes pidi tulema. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Kellel kõrvad on, see kuulgu!<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>Aga millega ma võrdleksin praegust sugupõlve? Nad on nagu lapsed, kes turuplatsil istuvad ja vastastikku hüüavad:<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>„Meie mängisime teile vilepilli,</para>
  <para style="q2" vid="MAT 11:17">aga teie ei tantsinud!</para>
  <para style="q1" vid="MAT 11:17">Meie itkesime kurvalt,</para>
  <para style="q2" vid="MAT 11:17">aga teie ei leinanud!“<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>Sest Johannes tuli, ei söönud ega joonud, ja nad ütlevad: „Tal on kuri vaim!“ <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Inimese Poeg tuli ning sööb ja joob, ja siis te ütlete: „Vaadake, see inimene on õgard ja joodik, maksukogujate ja patuste sõber!“ Ometi tunnistatakse tarkus õigeks tema tegudest.“<verse eid="MAT 11:19"/></para>
  <para style="s1">Hädakuulutus patustele linnadele</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Siis hakkas Jeesus sõitlema linnu, kus oli tehtud enamus ta imetegudest, sest nad ei parandanud meelt: <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>„Häda sulle, Korasin! Häda sulle, Betsaida! Kui Tüüroses ja Siidonis oleksid sündinud need imeteod, mis teie juures sündisid, siis oleksid nad ammugi kotiriides ja tuhas meelt parandanud. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Tõepoolest, ma ütlen teile, Tüürosel ja Siidonil läheb kohtupäeval kergemini kui teil. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Ja sina, Kapernaum, kas sind peaks ülendatama taevani? Sa langed alla põrgupõhja! Sest kui Soodomas oleksid sündinud imeteod, mis sündisid sinus, siis oleks ta püsinud tänase päevani. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Tõepoolest, ma ütlen teile, Soodomal läheb kohtupäeval kergemini kui sinul.“<verse eid="MAT 11:24"/></para>
  <para style="s1">Isa on ilmunud Pojas</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Selsamal tunnil ütles Jeesus veel: „Ma ülistan sind, Isa, taeva ja maa Issand, et sa selle oled pannud varjule tarkade ja arusaajate eest, kuid ilmutanud lapsemeelsetele! <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Jah, Isa, nõnda on see olnud sulle meelepärane.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>Kõik on mu Isa andnud minu kätte. Keegi ei tunne Poega peale Isa, ja keegi ei tunne Isa peale Poja ja nende, kellele Poeg soovib teda ilmutada.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>Tulge minu juurde, kõik kurnatud ja koormatud, ja mina annan teile hingamise! <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Võtke kanda minu ike ja õppige minult, sest mina olen tasane ja südamelt alandlik; siis te leiate rahu oma hingele; <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>sest minu ike on hea ja minu koorem on kerge!“<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Jeesus on hingamispäeva Issand</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Selsamal ajal läks Jeesus hingamispäeval läbi viljapõldude. Ent ta jüngrid olid näljased ja hakkasid noppima viljapäid ning sööma. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Kui variserid seda nägid, ütlesid nad Jeesusele: „Vaata, sinu jüngrid teevad seda, mida ei tohi teha hingamispäeval!“<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Jeesus vastas: „Kas te ei ole lugenud, mida tegi Taavet, kui temal ja ta kaaslastel oli nälg? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Ta läks Jumala kotta ja sõi ära ohvrileivad, mida ei olnud luba süüa ei temal ega ta kaaslastel, vaid ainult preestritel. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Või kas te pole lugenud Seadusest, et preestrid rikuvad templis hingamispäeva kohuseid täites hingamispäeva, kuid on ometi süüta? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Kuid ma ütlen teile, siin on keegi, kes on suurem kui tempel! <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>Kui te mõistaksite, mida tähendab „Ma soovin halastust, mitte ohvrit“, siis te ei oleks mõistnud hukka süütuid. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Sest Inimese Poeg on hingamispäeva Issand!“<verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Sealt edasi minnes astus Jeesus ühte nende sünagoogi. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Seal oli mees, kelle käsi oli kärbunud. Otsides põhjust Jeesust süüdistada, küsisid nad temalt: „Kas hingamispäeval tohib tervendada?“<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>Jeesus vastas neile: „Kui kellelgi teie seast oleks üksainuke lammas ja see kukuks hingamispäeval auku, eks ta võtaks temast kinni ja tõmbaks ta välja? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Ent kui palju on lambast väärtuslikum inimene! Seepärast on hingamispäeval lubatud teha head.“<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Siis ta ütles mehele: „Siruta välja oma käsi!“ Ta sirutas käe ja see sai terveks nagu teinegi. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Variserid aga läksid välja nõu pidama, kuidas Jeesust tappa.<verse eid="MAT 12:14"/></para>
  <para style="s1">Jeesus – Jumala valitud sulane</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Kui Jeesus sai sellest teada, lahkus ta sealt. Ja paljud järgnesid talle ning ta tervendas kõik nende haiged, <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>keelates neil rääkimast, kes ta on. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Nõnda, et läheks täide prohvet Jesaja suu läbi öeldu:<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>„See on mu sulane, mu valitu,</para>
  <para style="q2" vid="MAT 12:18">mu armastatu, mu hinge rõõm.</para>
  <para style="q1" vid="MAT 12:18">Ma panen oma Vaimu tema peale</para>
  <para style="q2" vid="MAT 12:18">ja ta kuulutab rahvaste üle õigust.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>Ta ei riidle ega karju,</para>
  <para style="q2" vid="MAT 12:19">ka ei kuulda tänaval ta häält.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Rudjutud roogu ei murra ta katki,</para>
  <para style="q2" vid="MAT 12:20">hõõguvat tahti ei kustuta ära,</para>
  <para style="q1" vid="MAT 12:20">kuni viib õiguse võidule.<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>Tema nime peale loodavad rahvad.“<verse eid="MAT 12:21"/></para>
  <para style="s1">Jeesus ja Peltsebul</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Siis toodi tema juurde kurjast vaimust vaevatu, pime ja tumm mees, ning Jeesus tegi ta terveks, nii et ta rääkis ja nägi jälle. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Kogu rahvas aga küsis hämmastunult: „Kas tema ehk ongi Taaveti Poeg?“<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Kui variserid seda kuulsid, ütlesid nad: „See mees ei aja kurje vaime välja muidu kui kurjade vaimude valitseja Peltsebuli abiga.“<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>Jeesus aga, teades nende mõtteid, kostis neile: „Ükski riik, mis on omavahel tülis lõhenenud, ei jää püsima. Ükski linn või kodu, mis on omavahel riius, ei jää püsima. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Kui saatan ajab välja saatana, on ta iseendaga tülis. Kuidas saab tema riik siis püsida? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Kui mina peaksin kurje vaime välja ajama Peltsebuli abil, kelle abil siis teie kasvandikud neid välja ajavad? Seepärast mõistku nemad kohut teie üle! <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Aga kui mina ajan Jumala Vaimuga kurje vaime välja, siis on Jumala riik saabunud teie juurde.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>Või kuidas saab keegi tungida vägimehe majja ta asju röövima, kui ta esmalt vägimeest ei seo kinni? Alles siis saab ta tema maja röövida.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>Kes ei ole minuga, on minu vastu, ja kes ei kogu minuga, pillub laiali. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Seepärast ma ütlen teile, et inimestele antakse andeks igasugune patt ja pühaduseteotus, aga Püha Vaimu teotamist ei anta andeks. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Kui keegi ütleb midagi Inimese Poja vastu, antakse see talle andeks, aga kui keegi ütleb midagi Püha Vaimu vastu, ei andestata talle ei käesoleval ega tulevasel ajastul.<verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>Tehke puu heaks, siis on ta vili hea, või tehke puu halvaks, ja ta vili on halb; sest puud tuntakse tema viljast. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Rästikute sugu, kuidas te saaksitegi rääkida head, kui te olete kurjad? Sest suu räägib seda, mida süda on täis. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Hea inimene toob südame heast tagavarast välja head, ja kuri inimene toob kurjast tagavarast välja kurja. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Aga ma ütlen teile, et inimesed peavad kohtupäeval aru andma igast tühjast sõnast, mida nad on rääkinud; <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>sest su sõnadest mõistetakse sind õigeks ja su sõnadest mõistetakse sind süüdi.“<verse eid="MAT 12:37"/></para>
  <para style="s1">Joona tunnustäht</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Siis mõned kirjatundjad ja variserid ütlesid talle: „Õpetaja, me tahame sinult näha tunnustähte!“<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Jeesus vastas: „See kuri ja abielurikkuja sugupõlv nõuab tunnustähte, aga talle ei anta muud kui prohvet Joona tunnustäht. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Nii nagu Joona viibis kolm päeva ja kolm ööd hiidkala kõhus, nõnda peab ka Inimese Poeg olema maapõues kolm päeva ja kolm ööd. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Niineve mehed astuvad kohtupäeval üles selle sugupõlve vastu ja mõistavad ta süüdi, sest nemad parandasid meelt Joona kuulutuse peale, aga siin on nüüd üks, kes on suurem kui Joona. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Lõunamaa kuninganna tõuseb kohtupäeval üles selle sugupõlve vastu ja mõistab ta süüdi, sest tema tuli maailma otsast kuulama Saalomoni tarkust, ja nüüd on siin keegi suurem kui Saalomon!<verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>Kui rüve vaim väljub inimesest, hulgub ta põuastes paikades ja otsib hingamist, kuid ei leia seda. <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>Siis ta ütleb: „Ma pöördun tagasi oma majja, kust ma välja tulin.“ Ja tulles leiab ta selle tühja olevat ning puhtaks pühitud ja ehitud. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Siis võtab ta kaasa veel seitse vaimu, kes on kurjemad kui ta ise, ning asub sinna elama. Ja selle inimese hilisem olukord läheb halvemaks kui varasem. Samuti on lugu selle kurja sugupõlvega!“<verse eid="MAT 12:45"/></para>
  <para style="s1">Jeesuse ema ja vennad</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Kui Jeesus alles rahvale kõneles, seisid ta ema ja vennad eemal, soovides temaga rääkida. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Jeesusele öeldi: „Su ema ja vennad seisavad seal ja tahavad sinuga rääkida!“<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Jeesus aga vastas ütlejale: „Kes on mu ema ja kes on mu vennad?“ <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Ja sirutades käed oma jüngrite poole, ütles ta: „Näe, siin on minu ema ja minu vennad! <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Sest kes iganes teeb minu taevase Isa tahtmist, see on mu vend ja õde ja ema.“<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Tähendamissõna külvajast</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Samal päeval läks Jeesus majast välja ja istus mere äärde. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Tema juurde kogunes nii suur rahvahulk, et ta pidi astuma paati ja istuma seal, samal ajal kui rahvas seisis kaldal. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Ja ta rääkis neile palju asju tähendamissõnadega, öeldes: „Põllumees läks välja külvama. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Kui ta külvas, kukkus osa seemet teeveerele ning linnud tulid ja nokkisid selle. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Osa kukkus kivisele pinnale, kus ei olnud palju mulda, ja tärkas kohe, sest muld ei olnud sügav. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Ent kui päike tõusis ja kõrvetas, kuivasid taimed ära, sest neil ei olnud juurt. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Ja osa seemet kukkus ohakate sekka ning ohakad sirgusid ja lämmatasid selle. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Aga osa seemet kukkus heasse mulda ja kandis vilja – mõni sada, mõni kuuskümmend ja mõni kolmkümmend korda rohkem kui külvati. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Kellel kõrvad on, see kuulgu!“<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>„Miks sa räägid neile tähendamissõnadega?“ tulid jüngrid Jeesuselt küsima.<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Jeesus vastas: „Teile on antud teada taevariigi saladusi, neile aga ei ole. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Kellel on, sellele antakse rohkem, ja tal on küllaga; aga kellel ei ole, sellelt võetakse ära seegi, mis tal on. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Sellepärast räägin ma neile tähendamissõnadega:</para>
  <para style="q1" vid="MAT 13:13">„Kuigi nad vaatavad, nad ei näe;</para>
  <para style="q2" vid="MAT 13:13">kuigi nad kuulevad, nad ei mõista.“<verse eid="MAT 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14"/>Nende kohta läheb tõesti täide prohvet Jesaja ettekuulutus:</para>
  <para style="q1" vid="MAT 13:14">„Te küll kuulate, aga ei mõista,</para>
  <para style="q2" vid="MAT 13:14">te küll vaatate, aga ei näe.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Selle rahva süda on kalestunud</para>
  <para style="q2" vid="MAT 13:15">ja nende kõrvakuulmine on nüri</para>
  <para style="q2" vid="MAT 13:15">ja nad on sulgenud oma silmad.</para>
  <para style="q1" vid="MAT 13:15">Muidu nad näeksid oma silmadega</para>
  <para style="q2" vid="MAT 13:15">ja kuuleksid oma kõrvadega</para>
  <para style="q2" vid="MAT 13:15">ja mõistaksid südamega</para>
  <para style="q1" vid="MAT 13:15">ning pöörduksid, ja ma teeksin nad terveks.“<verse eid="MAT 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16"/>Aga õnnistatud on teie silmad, et need näevad, ja teie kõrvad, et need kuulevad. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Tõesti, ma ütlen teile, paljud prohvetid ja õiged on igatsenud näha seda, mida teie näete, ega ole näinud, ja kuulda, mida teie kuulete, ega ole kuulnud.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>Kuulake, kuidas mõista tähendamissõna külvajast! <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Igaühe juurde, kes sõnumit Kuningriigist kuuleb, kuid ei mõista, tuleb kurat ja röövib külvatu ta südamest. See on seeme, mis teeveerele külvati. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Seeme, mis kivisele maale külvati, on inimene, kes sõna kuuleb ja selle kohe rõõmuga vastu võtab. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Aga kuna tal endas ei ole juurt, püsib ta lühikest aega. Kui teda tabab mure või tagakius, langeb ta kiiresti ära. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Ohakaisse külvatud seeme on inimene, kes sõnumit küll kuuleb, ent ajaliku elu mured ja rikkuse petlik võlu lämmatavad selle ja see jääb viljatuks. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Heasse mulda külvatud seeme on aga inimene, kes sõnumit kuuleb ja mõistab. Tema on see, kes vilja kannab ja saaki annab: kes sada, kes kuuskümmend, kes kolmkümmend korda rohkem kui külvati.“<verse eid="MAT 13:23"/></para>
  <para style="s1">Tähendamissõna raiheinast</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Ta rääkis neile veel teise tähendamissõna: „Taevariik on kui mees, kes külvas oma põllule head seemet. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Aga kui kõik magasid, tuli ta vaenlane, külvas raiheina nisuseemne sekka ja läks minema. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Kui oras võrsus ja looma hakkas, ilmus ka raihein nähtavale. <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/>Peremehe sulased tulid nüüd tema juurde ja küsisid:</para>
  <para style="p" vid="MAT 13:27">„Isand, eks sa külvanud ju oma põllule head seemet. Kust siis tuli sinna raihein?“<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>Tema aga vastas neile:</para>
  <para style="p" vid="MAT 13:28">„See on vaenlase töö.“</para>
  <para style="p" vid="MAT 13:28">„Kas sa tahad, et me läheme ja need välja korjame?“ küsisid sulased.<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>„Ei,“ vastas peremees, „sest raiheina korjates te kisuksite üles ka nisu. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Las mõlemad kasvavad lõikuseni ja siis ma ütlen lõikajaile: korjake esmalt raihein, siduge kimpu põletamiseks, vili aga koguge mu aita!“ “<verse eid="MAT 13:30"/></para>
  <para style="s1">Tähendamissõna sinepiseemnest ja juuretisest</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Ta rääkis neile veel ühe tähendamissõna: „Taevariik on kui sinepiseeme, mille mees võttis ja külvas oma põllule. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Kuigi see on väikseim kõigist seemneist, kasvab aiataimedest suurimaks ja sirgub puuks, mille okstele tulevad linnud ja teevad pesa.“<verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Ta rääkis neile veel ühe tähendamissõna: „Taevariik on kui juuretis, mille naine võttis ja segas umbes kolmekümne kilogrammi jahu sekka, kuni kogu taigen läks hapnema.“<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Seda kõike rääkis Jeesus rahvale tähendamissõnades, ja tähendamissõnu kasutamata ei rääkinud ta neile midagi. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Nõnda läks täide, mis on öeldud prohveti suu läbi:</para>
  <para style="q1" vid="MAT 13:35">„Ma hakkan kõnelema tähendamissõnadega,</para>
  <para style="q2" vid="MAT 13:35">ütlen välja asju, mis on varjatud maailma loomisest peale.“<verse eid="MAT 13:35"/></para>
  <para style="s1">Jeesus seletab tähendamissõna raiheinast</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Siis saatis Jeesus rahva minema ja tuli koju. Jüngrid tulid tema juurde ja ütlesid:</para>
  <para style="p" vid="MAT 13:36">„Seleta meile tähendamissõna raiheinast põllul!“<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>Jeesus vastas: „Hea seemne külvaja on Inimese Poeg. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Põld on maailm, hea seeme tähistab kuningriigi inimesi. Raihein on kurjad inimesed, <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ja vaenlane, kes neid külvab, on kurat. Lõikusaeg on ajastu lõpp, lõikajad on inglid.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>Nõnda nagu raihein korjatakse ja tules põletatakse, nii on ka selle ajastu lõpul. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Inimese Poeg läkitab oma inglid, kes korjavad tema Kuningriigist kõik, mis põhjustab pattu ja kes teevad kurja <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>ja heidavad need põlevasse ahju; seal on ulgumine ja hammaste kiristamine. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Siis säravad õiged otsekui päike oma Isa Kuningriigis. Kellel kõrvad on, see kuulgu!<verse eid="MAT 13:43"/></para>
  <para style="s1">Tähendamissõna peidetud aardest ja kallist pärlist</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>Taevariik on kui põllumaasse peidetud aare, mille inimene leidis. Ta peitis selle jälle ning läks ja müüs rõõmuga maha kõik, mis tal oli, ning ostis selle põllu.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>Veel on taevariik kui kaupmees, kes otsis ilusaid pärleid. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Kui ta oli leidnud ühe eriti hinnalise pärli, läks ta ja müüs ära kõik, mis tal oli, ning ostis endale selle.<verse eid="MAT 13:46"/></para>
  <para style="s1">Tähendamissõna noodast</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>Veel on taevariik kui noot, mis heideti järve ja püüdis mitmesuguseid kalu. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Kui noot sai täis, tõmbasid kalurid selle kaldale, istusid maha ja kogusid head kalad korvidesse, halvad aga viskasid ära. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Nõnda on ka selle ajastu lõpul: inglid tulevad ja eraldavad õelad õigete keskelt <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ning heidavad nad põlevasse ahju; seal on ulgumine ja hammaste kiristamine.<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>Kas te saite aru sellest kõigest?“ küsis Jeesus.</para>
  <para style="p" vid="MAT 13:51">„Jah,“ vastasid nad.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Ja ta ütles neile: „Seepärast on iga kirjatundja, kellest on saanud taevariigi jünger, kui majaperemees, kes toob oma varakambrist välja uusi ja vanu aardeid.“<verse eid="MAT 13:52"/></para>
  <para style="s1">Jeesus hüljatakse kodukohas</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Kui Jeesus oli need tähendamissõnad lõpetanud, lahkust ta sealt. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Ta läks oma kodulinna ja õpetas sealses sünagoogis, nii et inimesed küsisid hämmastunult: „Kust on saanud see mees säärase tarkuse ja imelise väe? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Eks ta ole see puusepa poeg? Eks ta ema nimi ole Maarja ning ta vennad Jaakobus, Joosep, Siimon ja Juudas? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Ja eks ta õed ela kõik siin meie juures? Kust ta siis kõik selle on saanud?“ <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Ja nad said tema peale vihaseks.</para>
  <para style="p" vid="MAT 13:57">Jeesus aga ütles neile: „Kuskil ei peeta prohvetist nii vähe lugu kui tema kodukohas ja ta oma majas!“<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>Ja ta ei teinud seal kuigi palju imetegusid nende uskmatuse tõttu.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Ristija Johannese surm</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Sel ajal jõudsid nelivürst Heroodese<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Heroodes Suure poeg Heroodes Antipas.</char></note> kõrvu kuuldused Jeesusest. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>„See on Ristija Johannes,“ ütles ta oma kaaskondlastele. „Tema on üles äratatud surnuist, seepärast ongi tal vägi neid imesid teha.“<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>Heroodes oli ju Johannese kinni võtnud, aheldanud ja vangi pannud oma venna Filippuse naise Heroodiase pärast, <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>sest Johannes oli talle öelnud: „Sul pole õigust teda omada!“ <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Heroodes oleks tahtnud Johannest tappa, kuid kartis rahvast, kes pidas Johannest prohvetiks.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>Aga kui peeti Heroodese sünnipäeva, tantsis Heroodiase tütar nende ees ja see meeldis Heroodesele. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Ta tõotas tüdrukule anda, mida ta iganes palub. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Tüdruk aga ütles oma ema õhutusel:<note caller="+" style="f"><char style="fr" closed="false">14:8 </char><char style="ft" closed="false">Heroodiase tütre (pärimuse järgi oli ta nimi Saloome) vanus võis olla 12 kuni 20 aastat.</char></note> „Anna mulle siinsamas kandikul Ristija Johannese pea!“ <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Kuningas kurvastas, kuid piduliste kuuldes antud vande pärast käskis ta soovi täita <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ja laskis Johannesel vanglas pea maha raiuda. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Pea toodi kandikul ja anti tüdrukule, kes viis selle oma emale. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Siis tulid Johannese jüngrid, võtsid ta surnukeha ja matsid maha ning läksid ja teatasid sellest Jeesusele.<verse eid="MAT 14:12"/></para>
  <para style="s1">Viie tuhande mehe söötmine</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Kui Jeesus sai sellest kuulda, lahkus ta paadiga kõrvalisse paika, et olla omaette. Sellest kuuldes järgnes rahvas talle jalgsi linnadest. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Kui Jeesus astus paadist kaldale ja nägi suurt rahvahulka, hakkas tal neist kahju; ja ta tegi terveks nende haiged.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Õhtu hakul tulid jüngrid tema juurde ja ütlesid: „See paik on üksildane ja aeg juba hiline. Saada rahvas minema, et nad läheksid küladesse endale süüa ostma!“<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>„Neil pole tarvis ära minna,“ vastas Jeesus. „Andke teie neile süüa!“<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>„Meil pole siin rohkem kui viis leiba ja kaks kala,“ kostsid jüngrid.<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>„Tooge need siia minu kätte!“ ütles Jeesus. <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Ta käskis rahval istuda rohule, võttis need viis leiba ja kaks kala, vaatas üles taevasse, õnnistas ja murdis ning ulatas jüngritele, need aga omakorda rahvale. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Kõik sõid ja said söönuks ning ülejäänud palukesi korjati kaksteist korvitäit. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Sööjaid oli seal ligi viis tuhat meest, arvestamata naisi ja lapsi.<verse eid="MAT 14:21"/></para>
  <para style="s1">Jeesus kõnnib vee peal</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Ja Jeesus saatis kohe jüngrid paati, et nad enne teda teisele kaldale läheksid, sellal kui tema rahval minna laseb. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Saatnud rahva ära, läks ta üles mäele üksipäini palvetama. Hilisõhtul oli ta seal üksinda. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Paat aga oli juba kaldast kaugel lainete pillutada vastutuule pärast.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>Neljanda öövalvekorra ajal<note caller="+" style="f"><char style="fr" closed="false">14:25 </char><char style="ft" closed="false">See on kella kolme ja kuue vahel hommikul.</char></note> tuli Jeesus nende suunas järve peal kõndides. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Aga Jeesust järve peal kõndimas nähes ütlesid jüngrid kohkunult: „See on vaim!“ ja kisendasid hirmust.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Jeesus aga kõnetas neid: „Olge julged, see olen mina! Ärge kartke!“<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Peetrus vastas talle: „Issand, kui see oled sina, siis käsi mul vee peal sinu juurde tulla!“<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>„Tule!“ ütles Jeesus.</para>
  <para style="p" vid="MAT 14:29">Peetrus astus paadist välja, kõndis vee peal ja tuli Jeesuse poole. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Kuid tuule tugevust nähes lõi ta kartma ning hüüdis vajuma hakates: „Issand, päästa mind!“<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Jeesus sirutas kohe käe, võttis temast kinni ja ütles talle: „Miks sa kahtlesid, sa nõdrausuline?“<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Ja kui nad astusid paati, rauges tuul. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Paadisolijad aga ülistasid Jeesust, öeldes: „Tõesti, sina oled Jumala Poeg!“<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Kui nad olid ületanud järve, tulid nad maale Genneesaretis. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Ja kui selle paiga mehed Jeesuse ära tundsid, läkitasid nad sõna kogu ümbruskonda ja tema juurde toodi kõik haiged. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Need anusid teda, et nad saaksid puudutada kasvõi tema kuuepalistust. Ja kes iganes teda puudutasid, said terveks.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Puhas ja ebapuhas</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Siis tulid mõned variserid ja kirjatundjad Jeruusalemmast Jeesuse juurde ning küsisid: <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>„Miks sinu jüngrid astuvad üle esivanemate pärimusest? Nad ei pese enne sööki käsi.“<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Jeesus vastas neile: „Miks te ise astute üle Jumala käsust oma pärimuse pärast? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Jumal on ju öelnud: „Austa oma isa ja ema!“ ning „Kes oma isa või ema neab, peab surema.“ <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Kuid teie ütlete, et kui keegi ütleb oma isale või emale: „Selle toetuse, mis sa pidid minu käest saama, ma annan ohvrianniks Jumalale,“ <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>siis ta ei pea oma isa austama. Te olete teinud Jumala sõna tühjaks oma pärimusega! <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Te silmakirjatsejad, eks ole prohvet Jesaja õigesti kuulutanud teie kohta:<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>„See rahvas austab mind oma huultega,</para>
  <para style="q2" vid="MAT 15:8">nende süda on aga minust kaugel.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>Ilmaaegu nad teenivad mind,</para>
  <para style="q2" vid="MAT 15:9">õpetades õpetusi, mis on vaid inimeste reeglid.“ “<verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Ja Jeesus kutsus rahva enda juurde ning ütles: „Kuulge ja mõistke! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Inimest ei rüveta mitte see, mis suust sisse läheb, vaid see, mis suust välja tuleb – see rüvetab inimest.“<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Siis jüngrid tulid tema juurde ja ütlesid:</para>
  <para style="p" vid="MAT 15:12">„Kas sa tead, et variserid vihastasid, kui nad seda kuulsid?“<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Jeesus aga vastas neile: „Iga taim, mida minu taevane Isa pole istutanud, juuritakse välja. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Laske neil olla! Nad on pimedate pimedad teejuhid. Kui pime juhib pimedat, kukuvad mõlemad auku.“<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>„Seleta meile seda tähendamissõna!“ palus Peetrus.<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>„Kas ka teie veel ei mõista?“ küsis Jeesus. <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>„Kas te ei saa aru, et kõik, mis suust sisse läheb, liigub edasi kõhtu ja heidetakse taas välja? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Aga mis suust väljub, tuleb südamest ja see rüvetab inimest. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Sest südamest lähtub kurje mõtteid – mõrva, abielurikkumist, hoorust, vargust, valetunnistusi ja laimu. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Need rüvetavad inimest, aga pesemata kätega söömine ei rüveta.“<verse eid="MAT 15:20"/></para>
  <para style="s1">Kaanani naise usk</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Ja Jeesus lahkus sealt ning läks Tüürose ja Siidoni aladele. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Üks neist paigust pärit Kaanani naine tuli ja hüüdis: „Issand, Taaveti Poeg, halasta minu peale! Mu tütar vaevleb rängalt kurja vaimu käes!“<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Kuid Jeesus ei vastanud sõnagi. Siis jüngrid astusid tema juurde ja palusid teda: „Saada ta minema, sest ta karjub meie kannul!“<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Jeesus vastas: „Mind on läkitatud üksnes Iisraeli rahva kadunud lammaste juurde.“ <verse eid="MAT 15:24"/><verse number="25" style="v" sid="MAT 15:25"/>Ent naine tuli ja põlvitas Jeesuse ette, öeldes: „Issand, aita mind!“<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>„Ei sobi võtta laste leiba ja visata koertele,“ kostis Jeesus.<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>„Jah, Issand,“ ütles naine, „ometi söövad koerad raasukesi, mis nende isandate laualt pudenevad.“<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>„Naine, sinu usk on suur!“ vastas Jeesus, „Sündigu sulle, nagu sa soovid!“ Ja tema tütar sai terveks samal tunnil.<verse eid="MAT 15:28"/></para>
  <para style="s1">Jeesus toidab neli tuhat meest</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Jeesus lahkus sealt ja jõudis Galilea mere äärde. Ta läks üles mäele ja istus maha. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Tema juurde tuli palju rahvast, tuues kaasa halvatuid, pimedaid, vigaseid, tummi ja palju teisi. Nad panid haiged Jeesuse jalge ette ja ta tegi nad terveks, <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>nõnda et inimesed imestasid, nähes tummi rääkimas, vigaseid tervena, halvatuid kõndimas ja pimedaid nägemas. Ning nad ülistasid Iisraeli Jumalat.<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Jeesus aga kutsus oma jüngrid enese juurde ja ütles: „Mul on rahvast kahju. Nad on juba kolm päeva minu juures olnud ja neil pole midagi süüa. Ma ei taha neid näljastena ära saata, muidu võivad nad teel nõrkeda.“<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>„Kust me saaksime siin inimtühjas kohas leiba nii suure rahvahulga toitmiseks?“ küsisid jüngrid.<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>„Mitu leiba teil on?“ küsis Jeesus neilt.</para>
  <para style="p" vid="MAT 15:34">„Seitse. Ja mõned kalakesed ka,“ vastasid nad.<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>Siis käskis Jeesus rahval maha istuda, <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>võttis seitse leiba ja kalad, tänas, murdis need ja ulatas jüngritele, jüngrid andsid aga rahvale. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Kõik sõid ja said söönuks ning ülejäänud palukesi koguti kokku seitse korvitäit. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Sööjaid oli seal neli tuhat meest, arvestamata naisi ja lapsi. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Ja kui Jeesus oli rahva minema saatnud, astus ta paati ja suundus Magdala alale.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">Jeesuselt nõutakse taas tunnustähte</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Variserid ja saduserid tulid Jeesuse juurde kiuslike küsimustega ning nõudsid, et ta näitaks neile tunnustähte taevast.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Ta vastas neile: „Õhtul te ütlete: „Ilus ilm tuleb, sest taevas on punane.“ <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Ja varahommikul: „Kisub tormile, sest taevas on punane ja pilves.“ Taeva ilmeid te oskate küll eristada, aga ajamärke näha ei suuda! <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>See kuri ja abielurikkuja sugupõlv nõuab tunnustähte, aga talle ei anta muud kui prohvet Joona tunnustäht.“ Ja Jeesus jättis nad sinna ja lahkus.<verse eid="MAT 16:4"/></para>
  <para style="s1">Hoiatus variseride ja saduseride õpetuse eest</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Kui nad läksid üle järve, unustasid jüngrid leiba kaasa võtta. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>„Vaadake ette!“ ütles Jeesus neile. „Hoiduge variseride ja saduseride juuretisest!“<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>Nad arutasid seda omavahel ja ütlesid: „Ta räägib sellest, et me ei võtnud leiba kaasa!“<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Jeesus ütles seda märgates: „Te nõdrausulised, miks te tülitsete omavahel, et te leiba kaasa ei võtnud? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Kas te ikka veel ei mõista? Kas te ei mäleta neid viit leiba viiele tuhandele ja mitu korvitäit te kogusite, <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>ega neid seitset leiba neljale tuhandele ja mitu korvitäit te siis kogusite? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Kuidas te siis ei mõista, et ma ei rääkinud teile leivast? Kuid hoiduge variseride ja saduseride juuretisest.“ <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Siis said jüngrid aru, et ta oli käskinud neil hoiduda mitte leiva juuretisest, vaid variseride ja saduseride õpetusest.<verse eid="MAT 16:12"/></para>
  <para style="s1">Peetrus tunnistab Jeesuse Messiaks</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Kui siis Jeesus tuli Filippuse Kaisarea aladele, küsis Jeesus oma jüngritelt:</para>
  <para style="p" vid="MAT 16:13">„Kelle ütlevad inimesed Inimese Poja olevat?“<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Jüngrid vastasid: „Mõned ütlevad Ristija Johannese, mõned Eelija, mõned Jeremija või ühe prohveteist.“<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>„Aga teie? Kelle teie ütlete mind olevat?“ küsis Jeesus.<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>„Sina oled Messias, elava Jumala Poeg!“ vastas Siimon Peetrus.<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Jeesus vastas: „Sa oled õnnistatud, Siimon, Joona Poeg! Sest seda ei ole avaldanud sulle inimene, vaid minu Isa, kes on taevas. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Ja mina ütlen sulle, sina oled Peetrus ja sellele kaljule ma ehitan oma koguduse, ning põrgu väravad ei pea teda. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Ma annan sulle taevariigi võtmed; ja mis iganes sa seod maa peal, seotakse ka taevas, ja mida iganes sa lahti päästad maa peal, päästetakse lahti ka taevas.“ <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Siis Jeesus keelas jüngreid, et nad kellelegi ei ütleks, et tema on Messias.<verse eid="MAT 16:20"/></para>
  <para style="s1">Jeesus räägib oma surmast</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Sellest ajast peale hakkas Jeesus oma jüngritele selgitama, et ta peab minema Jeruusalemma ja palju kannatama rahvavanemate, ülempreestrite ja kirjatundjate käes; et ta tapetakse ning kolmandal päeval äratatakse üles.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Kuid Peetrus viis ta kõrvale ja hakkas teda noomima: „Ei iialgi, Issand! Ärgu seda sulle mitte kunagi sündigu!“<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Jeesus aga pöördus tema poole ja ütles: „Tagane minust, saatan! Sa oled mulle takistuseks, sest sa ei mõtle Jumala, vaid inimese viisil.“<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>„Kui keegi tahab käia minu järel,“ ütles Jeesus oma jüngritele, „siis salaku ta end maha, võtku oma rist ja järgnegu mulle! <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Sest kes tahab päästa oma elu, kaotab selle, aga kes kaotab oma elu minu pärast, leiab selle. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Sest mis kasu on inimesel, kui ta võidaks terve maailma, oma hingele teeks aga kahju? Või mis oleks inimesel anda oma hinge eest? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Sest Inimese Poeg tuleb Isa auhiilguses oma inglite saatel ja siis ta tasub igaühele tema tegude järgi.<verse eid="MAT 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28"/>Tõesti, ma ütlen teile, siin seisavad mõned, kes ei maitse surma enne, kui näevad Inimese Poega oma Kuningriigis tulemas.“<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Jeesuse muutmine</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Kuue päeva pärast võttis Jeesus endaga kaasa Peetruse, Jaakobuse ja tema venna Johannese ning viis nad üles kõrgele mäele. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Seal Jeesus muudeti nende nähes. Ta pale säras otsekui päike ja ta riided said valgeks otsekui valgus. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Siis Mooses ja Eelija ilmusid neile ja rääkisid Jeesusega.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Peetrus ütles Jeesusele: „Issand, siin on meil hea olla! Kui sa soovid, siis ma teen siia kolm telki: sulle ühe, Moosesele ühe ja Eelijale ühe.“<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Kui ta alles rääkis, siis helendav pilv kattis neid ja pilvest kostis hääl:</para>
  <para style="p" vid="MAT 17:5">„See on minu armas Poeg, kellest mul on hea meel. Teda kuulake!“<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Seda kuuldes langesid jüngrid hirmunult silmini maha; <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>aga Jeesus astus nende juurde, puudutas neid ja ütles: „Tõuske üles, ärge kartke!“ <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Kui nad siis pilgu tõstsid, ei näinud nad kedagi muud kui ainult Jeesust.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Mäelt alla laskudes keelas Jeesus neid: „Ärge rääkige sellest nägemusest kellelegi, enne kui Inimese Poeg on üles tõusnud surnuist!“<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>„Miks siis kirjatundjad ütlevad, et enne peab tulema Eelija?“ küsisid jüngrid temalt.<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>„Eelija tuleb tõepoolest ja seab kõik korda,“ vastas Jeesus. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>„Aga ma ütlen teile, Eelija on juba tulnud, ent nad ei ole teda ära tundnud, vaid on temale teinud, mida nad tahtsid. Niisamuti peab ka Inimese Poeg kannatama nende käes.“ <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>Siis jüngrid said aru, et ta rääkis neile Ristija Johannesest.<verse eid="MAT 17:13"/></para>
  <para style="s1">Kurjast vaimust vaevatud poisi tervendamine</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Kui nad rahva juurde jõudsid, lähenes Jeesusele üks mees, põlvitas ta ette <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>ja ütles: „Issand, halasta mu poja peale! Ta on langetõbine ja vaevleb hirmsasti. Ta kukub sageli tulle ja sageli vette! <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Ma tõin ta sinu jüngrite juurde, aga nemad ei suutnud teda tervendada.“<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>„Oh uskmatu ja rikutud sugupõlv,“ vastas Jeesus, „kui kaua ma pean teie juures olema? Kui kaua ma pean teiega kannatama? Tooge ta minu juurde!“ <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Ja Jeesus sõitles kurja vaimu, nii et see läks poisist välja ja samal tunnil sai poiss terveks.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Kui nad siis olid omaette, astusid jüngrid Jeesuse juurde ja ütlesid: „Miks meie ei suutnud seda kurja vaimu välja ajada?“<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>„Sest teil on nii vähe usku!“ vastas Jeesus. „Tõesti, ma ütlen teile, kui teil oleks usku kasvõi sinepiseemne jagu, siis võiksite öelda sellele mäele: „Mine siit sinna!“, ja ta läheb. Miski ei oleks teile siis võimatu. <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>See sugu ei lähe muidu välja kui aga palve ja paastumisega.“<verse eid="MAT 17:21"/></para>
  <para style="s1">Jeesus räägib teist korda oma surmast</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Kui nad Galileas kokku said, ütles Jeesus neile: „Inimese Poeg antakse ära inimeste kätte <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ja nad tapavad tema ning kolmandal päeval äratatakse ta üles.“ Ja jüngrid kurvastasid väga.<verse eid="MAT 17:23"/></para>
  <para style="s1">Jeesus maksab templimaksu</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Aga kui Jeesus ja jüngrid Kapernauma jõudsid, tulid Peetruse juurde templimaksu kogujad ja küsisid: „Kas teie Õpetaja templimaksu ei maksa?“<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>„Maksab küll,“ vastas ta.</para>
  <para style="p" vid="MAT 17:25">Kui Peetrus majja tuli, alustas Jeesus juttu: „Mis sa arvad, Siimon, kelle käest võtavad maailma kuningad tolli ja maksu? Kas oma lastelt või võõrastelt?“<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>„Võõrastelt,“ vastas Peetrus.</para>
  <para style="p" vid="MAT 17:26">„Järelikult on lapsed sellest vabad,“ ütles Jeesus. <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>„Aga et me neid ei pahandaks, mine järvele, viska õng vette ja tõmba välja esimene kala, mis otsa tuleb. Ja kui sa tema suu avad, leiad hõberaha.<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="ft" closed="false">Kreeka k <char style="tl">stateer</char>. Stateer võrdus nelja drahmiga. Templimaks oli kaks drahmi.</char></note> Anna see maksuks minu ja teie eest!“<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Kes on suurim taevariigis?</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Sel ajal tulid jüngrid Jeesuse juurde ja küsisid: „Kes on siis suurim taevariigis?“<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>Jeesus kutsus enda juurde ühe lapse, pani nende keskele seisma <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>ja ütles: „Tõesti, ma ütlen teile, kui te ei pöördu ega saa selliseks nagu lapsed, ei pääse te taevariiki! <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Kes nüüd iseennast alandab nagu see laps, see ongi suurim taevariigis. <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Ja kes iganes ühe niisuguse lapse võtab vastu minu nimel, see võtab vastu minu.<verse eid="MAT 18:5"/></para>
  <para style="s1">Patule ahvatlemisest</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>Kes iganes ahvatleb patule ühe neist väikestest, kes minusse usuvad, sellele oleks parem, et veskikivi talle kaela seotaks ja ta uputataks mere sügavusse. <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>Häda maailmale ahvatluste pärast! On küll paratamatu, et ahvatlused tulevad, kuid häda sellele, kelle kaudu need tulevad. <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Aga kui su käsi või jalg sunnib sind pattu tegema, raiu see ära ja viska minema! Sul on parem minna käteta või jalutuna ellu kui kahe käe ja kahe jalaga olla visatud igavesse tulle. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Ja kui su silm ahvatleb sind patule, kisu see välja ja viska minema! Sul on parem ühe silmaga minna ellu kui kahe silmaga olla visatud põrgutulle.<verse eid="MAT 18:9"/></para>
  <para style="s1">Tähendamissõna eksinud lambast</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>Vaadake, et te ühtki neist pisikestest ei põlgaks! Sest ma ütlen teile, et nende inglid taevas näevad alati minu taevase Isa palet. <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>Sest Inimese Poeg on tulnud päästma kadunut.<verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>Mis teie arvate: kui kellelgi on sada lammast ja üks neist ära eksib, eks ta jäta need üheksakümmend üheksa mägedesse ja lähe otsima eksinut? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Ja kui ta selle üles leiab, siis tõesti, ma ütlen teile, ta rõõmustab tema üle rohkem kui nende üheksakümne üheksa üle, kes ei olnud eksinud. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Samuti ei taha teie taevane Isa, et ükski neist pisikestest hukkuks.<verse eid="MAT 18:14"/></para>
  <para style="s1">Patustava venna kohtlemisest</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>Kui su vend teeb pattu, siis mine ja noomi teda nelja silma all. Kui ta sind kuulab, siis oled oma venna tagasi võitnud. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Aga kui ta sind ei kuula, siis võta enesega veel üks või kaks inimest, sest iga asi tuleb kinnitada kahe või kolme tunnistaja ütlusega. <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Aga kui ta ka neid ei kuula, siis räägi kogudusele. Ja kui ta isegi koguduse sõna ei kuula, siis olgu ta sinu jaoks nagu pagan või maksukoguja!<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>Tõesti, ma ütlen teile, mis te iganes kinni seote maa peal, on seotud ka taevas, ja mis te iganes lahti päästate maa peal, on päästetud lahti ka taevas.<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>Tõesti, taas ma ütlen teile, kui maa peal on kaks teie seast ühel meelel mingi asja suhtes, mida nad iganes paluvad, siis minu Isa, kes on taevas, annab selle neile. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Sest kus kaks või kolm on minu nimel koos, seal olen mina nende keskel.“<verse eid="MAT 18:20"/></para>
  <para style="s1">Tähendamissõna armutust sulasest</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Siis Peetrus astus tema juurde ja ütles: „Issand, mitu korda ma peaksin oma vennale andestama, kui ta mu vastu patustab? Kas kuni seitse korda?“<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Jeesus vastas: „Ma ütlen sulle, mitte seitse, vaid seitsekümmend korda seitse.<verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>Seepärast on taevariik kuninga sarnane, kes otsustas oma sulastega arved korda seada. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Kui ta sellega algust tegi, toodi ta ette üks, kes võlgnes talle kümme tuhat talenti.<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">Üks talent oli võrdne tavainimese kahekümne aasta teenistuse eest saadud palgaga. Nt kuningas Heroodese aastatulu olevat olnud vaid 900 talenti.</char></note> <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Et tal seda maksta ei olnud, käskis isand müüa maha tema, ta naise, lapsed ja kogu ta vara, ning tasuda sellega.<note caller="+" style="f"><char style="fr" closed="false">18:25 </char><char style="ft" closed="false">Keskmise orja hind oli tollal 500–2000 päevapalka, seega ei saa kuningas oma raha kaugeltki tagasi.</char></note><verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>Sulane aga langes põlvili ta ette ja anus: „Kannata veel minuga ja ma maksan sulle kõik tagasi!“ <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Isandal hakkas temast hale, ta laskis ta vabaks ja kustutas ta võla.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>Aga kui see sulane oli välja läinud, leidis ta ühe kaassulase, kes võlgnes talle sada teenarit<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="ft" closed="false">Üks teenar oli töölise keskmine päevapalk.</char></note>. Ta haaras temast kinni, hakkas teda kägistama ja ütles: „Maksa ära, mis sa mulle võlgned!“<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>Siis see sulane langes tema jalge ette maha ja anus: „Kannata veel minuga ja ma maksan sulle tagasi!“<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>Tema aga ei olnud nõus, vaid laskis ta heita vanglasse, kuni ta oma võla tasub. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Kui teised sulased nägid, mis sündis, olid nad väga nördinud ning rääkisid isandale kõik ära.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>Siis kutsus isand mehe enese juurde ja ütles talle: „Sina nurjatu! Mina kustutasin kogu sinu võla, sest sa anusid mind. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Eks siis sinagi pidanud halastama oma kaassulase peale, nõnda nagu mina sinu peale halastasin?“ <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Ja ta isand vihastas ning andis ta vangivalvurite kätte piinata, kuni ta tasub kogu oma võla.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>Nõnda teeb ka minu taevane Isa teiega, kui teie kogu südamest ei anna andeks oma vennale.“<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Abielulahutusest</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Kui Jeesus oli need kõned lõpetanud, lahkus ta Galileast ja tuli Juudamaa alale teisele poole Jordanit. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Talle järgnes suur rahvahulk, ja ta tegi neid seal terveks.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Jeesuse juurde tuli varisere, kes küsisid temalt kiusliku mõttega: „Kas mehel on luba lahutada oma naisest ükskõik mis põhjusel?“<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>„Kas te ei ole lugenud,“ vastas Jeesus, „et alguses „tegi Looja nad meheks ja naiseks?“ <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>ning ütles: „Seepärast jätab mees maha oma isa ja ema ning hoiab oma naise poole ja need kaks saavad üheks.“ <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Siis nad ei ole enam kaks, vaid üks liha. Mis nüüd Jumal on ühte pannud, seda ärgu inimene lahutagu!“<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>„Miks siis Mooses on käskinud mehel lahutustunnistus anda, et naine minema saata?“ küsisid nad.<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>„Teie kõva südame pärast lubas Mooses teil naise endast lahutada,“ ütles Jeesus, „aga alguses ei olnud see nõnda. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Mina ütlen teile, et igaüks, kes lahutab oma naisest muul põhjusel kui abielurikkumine ja võtab teise, rikub abielu ja kes abiellub lahutatud naisega, rikub abielu.“<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>„Kui abielus on selline olukord mehe ja naise vahel, siis on parem mitte abielluda,“ arvasid jüngrid.<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>„Mitte igaüks ei suuda leppida sellega, mida ma nüüd ütlen,“ vastas Jeesus, „vaid üksnes need, kellele see on antud: <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>on kohitsetuid, kes on sellised emaüsast saadik, ja on neid, kes on inimeste poolt kohitsetud, ja on neid, kes elavad justkui kohitsetud taevariigi pärast. Kes suudab sellega leppida, see leppigu!“<verse eid="MAT 19:12"/></para>
  <para style="s1">Jeesus õnnistab lapsi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Siis toodi Jeesuse juurde lapsi, et ta paneks oma käed nende peale ja palvetaks; jüngrid aga tõrelesid toojatega.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>Aga Jeesus ütles: „Laske lapsed minu juurde tulla, ärge keelake neid! Sest selliste päralt on taevariik.“ <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Ja kui ta oli neile käed peale pannud, läks ta sealt ära.<verse eid="MAT 19:15"/></para>
  <para style="s1">Rikas mees ja Jumala riik</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Kord tuli tema juurde mees ja küsis: „Õpetaja, mis head ma pean tegema, et saada igavest elu?“<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>Jeesus ütles talle: „Miks sa minult pärid hea kohta? On vaid üks, kes on hea. Kui tahad ellu pääseda, siis pea kinni käskudest.“<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>„Millistest?“ küsis noormees.</para>
  <para style="p" vid="MAT 19:18">Jeesus vastas: „Ära tapa, ära riku abielu, ära varasta, ära anna valetunnistust, <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>austa oma isa ja ema ning armasta oma ligimest nagu iseennast!“<verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>„Seda kõike ma olen pidanud,“ vastas noormees. „Mis mul veel puudub?“<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>„Kui sa tahad olla täiuslik,“ ütles Jeesus, „siis müü ära kõik, mis sul on, ja jaga vaestele, ja sul on siis aare taevas, ning tule, järgne mulle!“<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Aga kui noormees neid sõnu kuulis, lahkus ta kurvana, sest tal oli palju vara.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Jeesus aga ütles oma jüngritele: „Tõesti, ma ütlen teile, rikkal on raske pääseda taevariiki. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Taas ma ütlen teile, et hõlpsam on kaamelil minna läbi nõelasilma kui rikkal minna Jumala riiki.“<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Seda kuuldes jüngrid kohkusid väga. „Kes siis üldse võib saada päästetud?“ küsisid nad.<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Jeesus vaatas neile otsa ja ütles: „Inimestel ongi see võimatu, kuid Jumalal on kõik võimalik!“<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Siis vastas Peetrus: „Vaata, meie oleme jätnud kõik maha ja järgnenud sulle. Mis me sellest nüüd saame?“<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>Jeesus ütles neile: „Tõesti, ma ütlen teile, et teie, kes te olete mind järginud, uuestisündimises, kui Inimese Poeg istub oma auhiilguse troonile, istute ka ise kaheteistkümnele troonile ja mõistate kohut kaheteistkümne Iisraeli suguharu üle! <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Ja igaüks, kes on jätnud maha majad või vennad või õed või isa või ema või lapsed või põllud minu pärast, saab nad tagasi sajakordselt ning pärib igavese elu. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Ent paljud esimesed jäävad viimasteks ja viimased saavad esimesteks.“<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Tähendamissõna töölistest viinamäel</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>„Taevariik on kui peremees, kes läks hommikul vara värbama töölisi oma viinamäele. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Kui ta oli nendega päevapalgaks kokku leppinud ühe teenari<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Üks teenar oligi töölise keskmine päevapalk.</char></note>, läkitas ta nad viinamäele.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>Kolmanda tunni<note caller="+" style="f"><char style="fr" closed="false">20:3 </char><char style="ft" closed="false">See on kell üheksa hommikul. Tunde loeti päikesetõusust, mis oli kella kuue ajal. Nii on kuues tund keskpäev, üheksas tund kell kolm pärast lõunat ja üheteistkümnes tund kell viis õhtul.</char></note> paiku läks ta välja ja nägi turuplatsil teisi jõude seismas.<verse eid="MAT 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 20:4"/>„Minge teiegi viinamäele!“ ütles ta neile. „Ma annan teile õiglase tasu!“ <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Ja nad läksid.</para>
  <para style="p" vid="MAT 20:5">Kuuendal ja üheksandal tunnil toimis peremees samamoodi. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Aga kui ta üheteistkümnendal tunnil välja läks, leidis ta veel töölisi seismas ja ütles neilegi: „Miks teie siin kogu päeva ilma tööta seisate?“<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>„Meid ei ole keegi palganud,“ vastasid nad.</para>
  <para style="p" vid="MAT 20:7">„Minge ka teie tööle mu viinamäele!“ käskis peremees.<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>Kui õhtu kätte jõudis, ütles viinamäe isand töödejuhatajale: „Kutsu töölised ja maksa neile välja palk, alustades viimastest ja lõpetades esimestega!“<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>Need, kes olid üheteistkümnendal tunnil palgatud, tulid ning said igaüks ühe teenari. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Aga kui tuli esimeste kord, arvasid nemad, et nad saavad rohkem, aga nemadki said igaüks ühe teenari. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Ja nad nurisesid peremehe üle: <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>„Need viimased tegid ainult ühe tunni tööd, ent sina oled nad teinud võrdseks meiega, kes me talusime päeva raskust ja palavust!“<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>Peremees aga vastas ühele neist: „Sõber, ma ei tee sulle ülekohut! Kas sa ei leppinud minuga kokku ühe teenari peale? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Võta oma palk ja mine! Ja kui ma tahan maksta sellele viimasele sama palju kui sulle, <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>kas ma ei tohi toimida oma varaga, nagu soovin? Või oled sa kade, et mina olen helde?“<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>Nõnda saavad viimased esimesteks ja esimesed jäävad viimasteks. Sest paljud on kutsutud, aga vähesed on valitud.“<verse eid="MAT 20:16"/></para>
  <para style="s1">Jeesus räägib kolmandat korda oma surmast</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Kui Jeesus läks üles Jeruusalemma, viis ta kaksteist jüngrit kõrvale ja ütles neile: <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>„Me läheme üles Jeruusalemma ja Inimese Poeg antakse ülempreestrite ja kirjatundjate kätte. Need mõistavad ta surma <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ja annavad tema uskmatute kätte mõnitada, piitsutada ja risti lüüa. Aga kolmandal päeval ta äratatakse üles.“<verse eid="MAT 20:19"/></para>
  <para style="s1">Ema soov</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Siis astus Sebedeuse poegade ema koos oma poegadega Jeesuse juurde ning kummardas ta ette, et temalt midagi paluda.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>„Mida sa soovid?“ küsis Jeesus.</para>
  <para style="p" vid="MAT 20:21">„Luba, et need mu kaks poega istuvad sinu Kuningriigis üks su paremal ja teine vasakul käel!“ ütles ta.<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>„Teie ei tea, mida te palute,“ vastas Jeesus. „Kas te suudate juua karikast, mida minul tuleb juua?“</para>
  <para style="p" vid="MAT 20:22">„Suudame küll!“ vastasid nad.<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>„Tõepoolest te joote minu karikast,“ ütles Jeesus, „kuid kohta mu paremal ja vasakul käel ei saa ma teile anda. See kuulub neile, kellele mu Isa on selle valmistanud.“<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Kui ülejäänud kümme sellest kuulsid, said nad pahaseks nende kahe venna peale. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Ent Jeesus kutsus nad enese juurde ja ütles: „Te teate, et uskmatute valitsejad peremehetsevad nende üle ja võimukandjad kasutavad nende kallal jõudu. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Kuid nõnda ärgu olgu see teie seas, vaid kes iganes teie seas tahab saada suureks, olgu teie teenija, <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ning kes iganes teie seas tahab olla esimene, olgu teie sulane – <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>nii nagu Inimese Poeg ei tulnud, et lasta ennast teenida, vaid et ise teenida ja anda oma elu lunastuseks paljude eest!“<verse eid="MAT 20:28"/></para>
  <para style="s1">Jeesus annab nägemise kahele pimedale</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Kui Jeesus ja jüngrid olid Jeerikost lahkumas, järgnes neile suur rahvahulk. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Kaks pimedat istusid tee ääres ja kui nad kuulsid, et Jeesus läheb mööda, hüüdsid nad: „Halasta meie peale, Issand, Taaveti Poeg!“<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Rahvas hurjutas neid, et nad vait jääksid, aga nemad kisendasid seda kõvemini: „Halasta meie peale, Issand, Taaveti Poeg!“<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Jeesus jäi seisma, kutsus nad lähemale ja küsis: „Mida te tahate, et ma teile teeksin?“<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>„Issand, et meie silmad avaneksid!“ ütlesid pimedad.<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>Jeesusel hakkas neist kahju ja ta puudutas nende silmi. Ja kohe nad nägid ning järgnesid talle.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Jeesus siseneb Jeruusalemma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Kui nad jõudsid Jeruusalemma lähedale ja tulid Betfage juurde Õlimäel, läkitas Jeesus kaks jüngrit <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>ja ütles: „Minge külla, mis on teie ees, ja kohe te leiate seal kinniseotud eesli koos säluga. Siduge nad lahti ja tooge mulle! <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Kui keegi teile midagi ütleb, siis vastake, et Issand vajab neid ja ta läkitab nad peatselt tagasi.“<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Aga see on sündinud, et läheks täide, mida on öeldud prohveti suu läbi:<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>„Teatage Siioni tütrele:</para>
  <para style="q2" vid="MAT 21:5">„Vaata, su kuningas tuleb sinu juurde,</para>
  <para style="q1" vid="MAT 21:5">alandlikult eesli seljas,</para>
  <para style="q2" vid="MAT 21:5">veolooma poja, sälu seljas.“ “<verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Jüngrid läksid ja tegid, nagu Jeesus oli juhatanud. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Nad tõid eesli ja sälu, katsid nad oma kuubedega ning Jeesus istus sinna. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Väga suur rahvahulk aga laotas oma rõivad tee peale, teised lõikasid oksi puudelt ja laotasid tee peale. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Aga rahvahulgad, kes kõndisid Jeesuse eel ja järel, hüüdsid:</para>
  <para style="q1" vid="MAT 21:9">„Hoosanna<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Heebrea väljend <char style="tl">hošianna</char> </char><char style="ft" closed="false">tähendas algselt „Päästa!“ või „Aita!“, hiljem kasutati seda ülistavas tähenduses.</char></note> Taaveti Pojale!“</para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">„Õnnistatud olgu, kes tuleb Issanda nimel!“</para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">„Hoosanna kõrgeimas taevas!“<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Kui Jeesus Jeruusalemma jõudis, läks kogu linn elevile. „Kes see on?“ küsisid nad.<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>„Tema on prohvet Jeesus Naatsaretist Galileas!“ vastas rahvahulk.<verse eid="MAT 21:11"/></para>
  <para style="s1">Jeesus templis</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Jeesus aga läks templisse, ajas välja kõik, kes ostsid ja müüsid seal ning lükkas kummuli rahavahetajate lauad ja tuvimüüjate pingid. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Ta ütles neile: „Kirjutatud on: „Minu koda hüütagu palvekojaks,“ aga teie olete teinud selle röövlikoopaks!“<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Templis tuli Jeesuse juurde pimedaid ja jalutuid ja ta tegi nad terveks. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Kui ülempreestrid ja kirjatundjad nägid Jeesuse imetegusid ning lapsi, kes templis hüüdsid: „Hoosanna Taaveti Pojale!“, siis nad said vihaseks <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>ja küsisid temalt: „Kas sa kuuled, mida need lapsed ütlevad?“</para>
  <para style="p" vid="MAT 21:16">„Jah,“ vastas Jeesus. „Kas te pole kunagi lugenud:</para>
  <para style="q1" vid="MAT 21:16">„väikelaste ja imikute suust</para>
  <para style="q2" vid="MAT 21:16">sina, Issand, lased kõlada kiitust“?“<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Ja jättes nad sinnapaika, läks ta linnast välja Betaaniasse ja ööbis seal.<verse eid="MAT 21:17"/></para>
  <para style="s1">Jeesus neab viigipuu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Varahommikul linna tagasi pöördudes tundis Jeesus nälga, <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ja nähes viigipuud tee ääres, läks ta selle juurde. Ent leidmata sealt midagi peale lehtede, ütles ta viigipuule: „Ära iialgi enam kanna vilja!“ Ja viigipuu kuivas otsekohe ära.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Kui jüngrid seda nägid, küsisid nad imestades: „Kuidas see viigipuu nii kiiresti ära kuivas?“<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Aga Jeesus vastas: „Tõesti, ma ütlen teile, kui teil on usku ja te ei kahtle, siis te ei tee üksnes nii nagu mina viigipuuga, vaid ütlete sellele mäele: „Tõuse paigast ja lange merre!“, ja see sünnib. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Kui te usute, siis te saate kõike, mida te palves küsite!“<verse eid="MAT 21:22"/></para>
  <para style="s1">Jeesuselt päritakse aru meelevalla kohta</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Jeesus tuli templisse, ja kui ta hakkas õpetama, astusid ülempreestrid ja rahvavanemad tema juurde ja küsisid: „Millise meelevallaga sa seda kõike teed? Ja kes on sulle andnud selle meelevalla?“<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Aga Jeesus vastas neile: „Ka mina küsin teilt midagi. Kui te mulle vastate, ütlen minagi teile, millise meelevallaga ma seda teen. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>Kust pärines Johannese ristimine: kas taevast või inimestest?“</para>
  <para style="p" vid="MAT 21:25">„Kui me ütleme, et taevast,“ arutasid nad omavahel, „küsib ta meilt: „Miks te siis ei uskunud teda?“ <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Kui me aga ütleme, et inimestest, siis tuleb meil karta rahvast, sest kõik peavad Johannest prohvetiks.“<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Ja nad vastasid Jeesusele: „Me ei tea!“</para>
  <para style="p" vid="MAT 21:27">Tema vastas omakorda: „Ega minagi ütle teile, millise meelevallaga ma seda teen.<verse eid="MAT 21:27"/></para>
  <para style="s1">Tähendamissõna kahest pojast</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>Aga mis te sellest arvate? Ühel mehel oli kaks poega. Ta läks esimese juurde ja ütles: „Poeg, mine täna tööle viinamäele!“<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>„Ma ei lähe,“ vastas ta, aga hiljem muutis ta meelt ja läks.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>Isa läks teise poja juurde ja ütles talle sedasama.</para>
  <para style="p" vid="MAT 21:30">„Ma lähen, isand,“ vastas poeg, kuid ta ei läinud.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>Kumb neist kahest täitis isa tahet?“</para>
  <para style="p" vid="MAT 21:31">„Esimene,“ vastasid nad.</para>
  <para style="p" vid="MAT 21:31">„Tõesti, ma ütlen teile,“ ütles Jeesus, „maksukogujad ja hoorad pääsevad enne teid Jumala riiki!<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">Konteksti põhjal tuleks seda mõista: </char><char style="fq" closed="false">„Maksukogujad ja hoorad pääsevad </char><char style="ft" closed="false">Jumala riiki, aga teie mitte!“</char></note> <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Sest Johannes tuli teie juurde õiguse teed näitama, aga teie ei uskunud teda, kuid maksukogujad ja hoorad uskusid. Ja ehk te küll seda nägite, ei parandanud te meelt ega uskunud teda.<verse eid="MAT 21:32"/></para>
  <para style="s1">Tähendamissõna viinamäe rentnikest</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>Kuulake veel ühte tähendamissõna. Oli kord mees, kes istutas viinamäe. Ta piiras selle aiaga, õõnestas kaljusse surutõrre ja ehitas valvetorni. Siis ta andis viinamäe rentnike kätte ja reisis ära. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Kui saagiaeg kätte jõudis, saatis ta sulaseid rentnike juurde oma saagiosa vastu võtma.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>Aga rentnikud võtsid ta sulased kinni – ühte nad peksid, teise tapsid, kolmanda viskasid kividega surnuks. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Nüüd saatis peremees teised sulased, rohkem kui eelmisel korral, aga rentnikud tegid nendega samamoodi. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Viimaks ta läkitas nende juurde oma poja. „Minu poega nad austavad!“ mõtles ta.<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>Kuid rentnikud rääkisid poega nähes omavahel: „Tema ongi pärija. Lähme, tapame ta ära, siis saame ta pärandi endale!“ <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Nad võtsid ta kinni, viskasid viinamäelt välja ja tapsid ära.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>Kui nüüd viinamäe isand tuleb, mida ta teeb nende rentnikega?“<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>„Ta hukkab need kurjad kurjal kombel,“ ütlesid nad, „ja annab viinamäe teiste rentnike kätte, kes tasuvad ta saagiosa õigel ajal.“<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>„Kas te ei ole kunagi lugenud Pühakirjast,“ ütles Jeesus neile,</para>
  <para style="q1" vid="MAT 21:42">„ „Kivi, mille ehitajad pidasid kõlbmatuks,</para>
  <para style="q2" vid="MAT 21:42">on saanud nurgakiviks.</para>
  <para style="q1" vid="MAT 21:42">See tuli Issandalt</para>
  <para style="q2" vid="MAT 21:42">ja on imeline meie silmis.“<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>Seepärast ma ütlen teile, Jumala riik võetakse teie käest ära ja antakse rahvale, kes selle vilja kannab. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Kes selle kivi peale kukub, kukub end puruks, ja kelle peale see kivi langeb, selle see purustab.“<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Kui ülempreestrid ja variserid seda Jeesuse tähendamissõna kuulsid, mõistsid nad, et ta räägib seda nende kohta. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Ja nad otsisid võimalust teda kinni võtta, kuid kartsid rahvahulka, sest need pidasid Jeesust prohvetiks.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Tähendamissõna kuningapoja pulmadest</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Jeesus rääkis neile veel tähendamissõnades ja ütles: <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>„Taevariik on kui kuningas, kes korraldas oma pojale pulmapeo. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Ta läkitas oma sulased juba kutsutuid pulmapeole paluma, aga nemad keeldusid.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>Taas ta läkitas teisi sulaseid ja käskis kutsutuile öelda: „Ma olen pidusöögi valmistanud. Mu härjad ja nuumvasikad on tapetud ja kõik on valmis. Tulge pulma!“<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>Nemad aga ei teinud sellest väljagi ja läksid, kes põllule, kes äriasju ajama. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Mõned aga võtsid sulased kinni, mõnitasid neid jõhkralt ja tapsid nad ära. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Kuningas sai väga vihaseks. Ta saatis oma sõjaväe, hukkas need mõrtsukad ja põletas maha nende linna.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>Siis ta ütles oma sulastele: „Pulmapidu on ette valmistatud, aga kutsutud ei olnud väärt tulema. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Seepärast minge tänavanurkadele ja kutsuge pulma, keda te iganes leiate!“ <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Ja sulased läksid välja teedele ja tõid kokku kõik, keda leidsid, nii häid kui halbu, ning pulmasaal sai täis külalisi.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>Aga kui kuningas astus sisse külalisi vaatama, märkas ta meest, kellel ei olnud pulmariideid seljas. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>„Sõber,“ ütles ta temale, „kuidas sina oled tulnud siia ilma pulmariieteta?“ See aga ei suutnud midagi vastata.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>Siis kuningas ütles oma teenritele:</para>
  <para style="p" vid="MAT 22:13">„Siduge kinni tema jalad ja käed ning visake ta välja pimedusse, kus on ulgumine ja hammaste kiristamine!“<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>Sest paljud on kutsutud, aga vähesed valitud.“<verse eid="MAT 22:14"/></para>
  <para style="s1">Maksu maksmisest keisrile</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Siis variserid läksid ja pidasid nõu, kuidas Jeesus tema sõnadest lõksu püüda. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Nad läkitasid ta juurde oma jüngreid koos heroodeslastega. „Õpetaja,“ ütlesid nad, „me teame, et sina oled aus ja otsekohene ning õpetad Jumala teed tões ega lase end mõjutada kellestki, sest sa ei tee inimestel vahet. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Seepärast ütle meile oma arvamus. Kas on õige maksta keisrile maksu või mitte?“<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Kuid Jeesus, teades nende alatust, ütles: „Miks te mind kiusate, silmakirjatsejad? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Näidake mulle maksumünti!“ Nad tõid talle teenari, <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>ja ta küsis neilt: „Kelle pilt ja nimi sellel on?“<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>„Keisri,“ vastasid nad.</para>
  <para style="p" vid="MAT 22:21">Siis Jeesus ütles neile: „Andke siis keisrile, mis kuulub keisrile, ja Jumalale, mis kuulub Jumalale!“<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Seda kuuldes nad hämmastusid, jätsid ta rahule ja lahkusid.<verse eid="MAT 22:22"/></para>
  <para style="s1">Abielust ja surnute ülestõusmisest</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Samal päeval tulid Jeesuse juurde saduserid, kes eitavad surnuist ülestõusmist, ja küsisid temalt: <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>„Õpetaja, Mooses on meile öelnud, et kui mees sureb lapsi saamata, siis peab tema vend abielluma lesega ja talle järglasi kasvatama. <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Meie hulgas oli seitse venda. Esimene võttis naise ja suri. Kuna tal ei olnud järglasi, jättis ta naise oma vennale. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Samuti juhtus teise ja kolmandaga, kuni kõik seitse venda olid surnud. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Kõige viimasena suri naine. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Kui nüüd tuleb ülestõusmine, kelle naine neist seitsmest ta siis on? Ta on ju olnud abielus nende kõikidega.“<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Jeesus vastas neile: „Te eksite, kuna ei tunne Pühakirja ega Jumala väge. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Ülestõusmises ei võeta naisi ega minda mehele, vaid ollakse nagu inglid taevas. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Aga mis puutub surnute ülestõusmisse – kas te ei ole lugenud, mida Jumal teile on rääkinud: <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>„Mina olen Aabrahami Jumal ja Iisaki Jumal ja Jaakobi Jumal!“ Jumal ei ole surnute, vaid elavate Jumal.“<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Seda kuuldes rahvas hämmastus tema õpetusest.<verse eid="MAT 22:33"/></para>
  <para style="s1">Suurim käsk</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Kui variserid kuulsid, et Jeesus oli sulgenud saduseridel suu, kogunesid nad sinna <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>ning üks kirjatundja nende seast küsis Jeesuselt teda proovile pannes: <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>„Õpetaja, milline käsk Seaduses on suurim?“<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>Jeesus vastas: „ „Armasta Issandat, oma Jumalat, kogu oma südamest, kogu oma hingest ja kogu oma mõistusest!“ <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>See on suurim ja ülim käsk. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Ja teine on selle sarnane: „Armasta oma ligimest nagu iseennast!“ <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Neis kahes käsus on koos kogu Seadus ja Prohvetid.“<verse eid="MAT 22:40"/></para>
  <para style="s1">Kelle poeg on Messias?</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Pöördudes kokku tulnud variseride poole, küsis Jeesus neilt: <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>„Mida te arvate Messia kohta: kelle poeg ta on?“</para>
  <para style="p" vid="MAT 22:42">„Taaveti poeg,“ vastasid nad.<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>„Miks siis Taavet nimetab teda Pühas Vaimus rääkides Issandaks?“ küsis Jeesus. „Ta ütleb ju:<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>„Issand ütles minu Issandale:</para>
  <para style="q2" vid="MAT 22:44">„Istu mu paremale käele,</para>
  <para style="q1" vid="MAT 22:44">kuni ma panen sinu vaenlased</para>
  <para style="q2" vid="MAT 22:44">su jalge alla.“ “<verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Kui nüüd Taavet hüüab teda Issandaks, kuidas ta siis on tema poeg?“ <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Ja ükski ei suutnud Jeesusele vastata sõnagi ning keegi ei söandanud sellest päevast alates temalt midagi rohkem küsida.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Hoiatus silmakirjalikkuse eest</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Jeesus rääkis rahvale ja oma jüngritele: <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>„Moosese asemele on ennast pannud kirjatundjad ja variserid,“ ütles ta. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>„Kõike nüüd, mis nad iganes teile ütlevad, seda tehke ja pidage, aga nende tegude järgi ärge tehke, sest nad ütlevad küll, aga ise ei tee. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Nad seovad kokku raskeid koormaid ja panevad neid inimeste õlgadele, aga ise ei taha sõrmeotsagagi neid liigutada.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>Kõiki oma tegusid teevad nad selleks, et inimesed neid vaataksid. Nad teevad oma palvevööd laiemaks ja ääretutid oma rüüdel suuremaks. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Nad armastavad aukohti pidulauas ja esimesi istmeid sünagoogides, <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>tervitusi turuplatsidel ja inimeste suust austavat nimetust „rabi“<note caller="+" style="f"><char style="fr" closed="false">23:7 </char><char style="ft" closed="false">Arameakeelset tiitlit <char style="tl">rabbi</char> ehk „mu auväärne“ kasutati õpetajate poole pöördumisel.</char></note>.<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>Teie ärge laske endid hüüda rabiks, sest teil on ainult üks Õpetaja ja teie kõik olete vennad. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Ja ärge hüüdke kedagi siin maa peal isaks, sest ainult üks on teie Isa, kes on taevas. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Samuti ärge laske end hüüda juhatajaks, sest ainult üks on teie Juhataja – Messias! <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Aga suurim teie seast olgu teie teenija! <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Sest kes ennast ise ülendab, seda alandatakse, ja kes ennast ise alandab, seda ülendatakse!<verse eid="MAT 23:12"/></para>
  <para style="s1">Seitse häda kirjatundjatele ja variseridele</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>Kuid häda teile, kirjatundjad ja variserid, te silmakirjatsejad, et te lukustate taevariigi ukse inimeste eest! Ise te ei lähe sinna sisse ega lase sisse ka neid, kes tahavad minna.<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>Häda teile, kirjatundjad ja variserid, te silmakirjatsejad, et te neelate alla lesknaiste majad ja silmakirjaks venitate palvetused pikaks! Seda rängem on teie kohtuotsus.<verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>Häda teile, kirjatundjad ja variserid, te silmakirjatsejad! Te käite läbi mered ja maad, et pöörata ühtainustki oma usku. Ja kui see teil korda läheb, siis te teete temast kaks korda hullema põrgu lapse kui te ise olete!<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>Häda teile, pimedad teejuhid, kes ütlete: „Kes iganes vannub templi juures, selle vanne ei loe midagi. Aga kes iganes vannub templi kulla juures, siis tuleb vannet pidada.“ <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Te pimedad narrid! Kumb on tähtsam – kas kuld või tempel, mis kulla pühitseb? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Te ütlete: „Kes iganes vannub altari juures, selle vanne ei loe midagi. Aga kes iganes vannub altaril oleva ohvri juures, see on kohustatud vannet täitma.“ <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Te pimedad! Kumb siis on tähtsam: kas ohvriand või altar, mis ohvrianni pühitseb? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Seepärast, kes vannub altari juures, vannub nii altari kui kõige juures, mis on altaril, <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ja kes vannub templi juures, vannub nii templi kui ka tema juures, kes templis elab, <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ja kes vannub taeva juures, vannub nii Jumala trooni kui troonil istuja juures.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>Häda teile, kirjatundjad ja variserid, te silmakirjatsejad! Te maksate kümnist mündist, tillist ja köömnest, kuid jätate kõrvale kaalukama osa Seaduses – õigluse, halastuse ja ustavuse. Seda oleksite pidanud täitma ja ülejäänut mitte unarusse jätma! <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Te pimedad teejuhid, te sõelute välja sääsed, kuid kaamelid neelate alla!<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>Häda teile, kirjatundjad ja variserid, te silmakirjatsejad! Te puhastate karika ja vaagna väljastpoolt, aga seest on need täis ahnust ja isekust. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Pime variser! Puhasta esmalt karika sisemus, et see ka väljast saaks puhtaks!<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>Häda teile, kirjatundjad ja variserid, te silmakirjatsejad! Te olete nagu lubjatud hauad, mis paistavad väljastpoolt kenad, aga seestpoolt on täis surnuluid ja kõike roojast. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Nõnda paistate ka teie inimestele õigetena, aga seestpoolt olete täis silmakirjatsemist ja ülekohut.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>Häda teile, kirjatundjad ja variserid, te silmakirjatsejad! Te ehitate prohvetitele haudu ja kaunistate õigete mälestusmärke. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>Te ütlete: „Kui meie oleksime elanud oma esiisade päevil, siis meie küll ei oleks koos nendega prohvetite verd valanud.“ <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Nõnda te tunnistate ise eneste kohta, et olete prohvetite tapjate lapsed. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Täitke siis teiegi oma esiisade patu mõõt!<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>Te ussid! Te rästikute sugu! Kuidas te võiksite põgeneda ära karistuse eest põrgus? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Seepärast ma läkitan teie juurde prohveteid ja tarku ja õpetajaid. Mõned neist te tapate ja lööte risti, teisi te piitsutate oma sünagoogides ja jälitate linnast linna. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Et teie peale tuleks kõik õigete veri, mis on valatud maa peal alates õige Aabeli verest kuni Berekja poja Sakarja vereni, kelle te tapsite templi ja altari vahel. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Tõesti, ma ütlen teile, see kõik tuleb selle sugupõlve peale!<verse eid="MAT 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>Jeruusalemm, Jeruusalemm, kes sa tapad prohveteid ja viskad kividega surnuks sinu juurde läkitatuid! Kui sageli olen ma soovinud su lapsed kokku koguda, otsekui kana kogub oma pojad tiibade alla, kuid teie ei ole tahtnud! <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Pange tähele, teie maja jäetakse teile tühjana! <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Sest mina ütlen teile, teie ei näe mind nüüdsest enam, kuni te ütlete: „Õnnistatud olgu, kes tuleb Issanda nimel!“ “<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Templi hävitamisest ja lõpuaja tähistest</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Jeesus väljus templist ja sammus edasi. Jüngrid aga astusid tema juurde, et talle templi hooneid näidata. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>„Eks te näe seda kõike?“ küsis Jeesus. „Tõesti, ma ütlen teile, ei jäeta siin kivi kivi peale, mida maha ei kistaks!“<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Kui Jeesus istus Õlimäel, astusid jüngrid tema juurde ja küsisid omavahel olles: „Ütle meile, millal see kõik tuleb ja mis on sinu tulemise ja selle ajastu lõpu tunnustäht?“ <verse eid="MAT 24:3"/><verse number="4" style="v" sid="MAT 24:4"/>Jeesus vastas neile: „Vaadake, et keegi teid ei eksitaks! <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Sest paljud tulevad minu nimel, öeldes: „Mina olen Messias!“ ja eksitavad paljusid. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Aga kui te kuulete sõdadest ja kuulujutte sõjast, siis ärge heituge. Sest need asjad peavad sündima, kuid see ei ole veel lõpp. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Sest rahvas tõuseb rahva vastu ja kuningriik kuningriigi vastu ning paljudes paikades on maavärinaid ja näljahäda. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>See kõik on aga sünnitusvalude algus.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>Siis antakse teid viletsusse ja teid tapetakse ja te saate kõigi rahvaste vihaaluseks minu nime pärast. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Sellel ajal taganevad paljud usust ning reedavad ja vihkavad üksteist. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Palju valeprohveteid tõuseb esile ja need eksitavad paljusid. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Ja et ülekohus kasvab, jahtub paljude armastus. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Aga kes peab vastu lõpuni, see pääseb. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Ja seda Kuningriigi evangeeliumi kuulutatakse kogu maailmas, tunnistuseks kõigile rahvastele, ja siis saabub lõpp.<verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>Kui te siis näete pühas paigas seismas hävituse koletist, millest on rääkinud prohvet Taaniel – et lugeja mõistaks! –, <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>siis need, kes on Juudamaal, põgenegu mägedesse. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Kes on katusel, ärgu tulgu alla oma majast midagi võtma, <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ja kes on põllul, ärgu pöördugu tagasi võtma oma kuube! <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Häda neile, kes on lapseootel, ja neile, kes imetavad sellel ajal! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Palvetage, et teie põgenemine ei juhtuks talvel ega hingamispäeval! <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Sest siis on nii suur ahistus, mille sarnast pole olnud maailma algusest kuni praeguse ajani ega tule enam iial.<verse eid="MAT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22"/>Ja kui neid päevi ei lühendataks, siis ei pääseks ükski. Kuid Jumala valitute pärast lühendatakse neid päevi. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>Kui siis keegi teile ütleb: „Näe, Messias on siin!“ või „Ta on seal!“, siis ärge uskuge! <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Sest tõuseb valemessiaid ja valeprohveteid ja need teevad suuri tunnustähti ja imesid, et eksitada, kui võimalik, isegi valituid. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Vaata, mina olen teid ette hoiatanud!<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>Kui keegi teile siis ütleb: „Ta on seal, kõrbes!“, ärge siis minge välja; või: „Ta on siin, salakambris!“, siis ärge uskuge! <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Sest otsekui välk sähvatab idast ja paistab läände, nõnda on Inimese Poja tulemine. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Kus iganes on korjus, sinna kogunevad raisakotkad.<verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>Kohe pärast selle aja viletsust</para>
  <para style="q1" vid="MAT 24:29">„pimeneb päike</para>
  <para style="q2" vid="MAT 24:29">ja kuu ei anna oma valgust,</para>
  <para style="q1" vid="MAT 24:29">tähed kukuvad taevast</para>
  <para style="q2" vid="MAT 24:29">ja taeva vägesid kõigutatakse“.<verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>Siis saab nähtavaks Inimese Poja tunnustäht taevas; ja siis tõstavad hädakisa maa peal kõik rahvad, kui nad näevad Inimese Poega tulemas taeva pilvede peal väe ja suure kirkusega. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Ja tema läkitab oma inglid valju pasunahäälega ja need koguvad kokku tema valitud nelja tuule poolt, igast taevakaarest.<verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>Ent õppige viigipuult! Kui selle okstele tärkavad võrsed ja ajavad lehti, siis te teate, et suvi on lähedal. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Nõnda ka teie, kui te näete kõike seda sündimas, siis teadke, et tema on lähedal, ukselävel. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Tõesti, ma ütlen teile, see sugupõlv ei kao, kuni kõik see on sündinud. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Taevas ja maa kaovad, kuid minu sõnad ei kao iial.<verse eid="MAT 24:35"/></para>
  <para style="s1">Päev ja tund pole teada</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>Ent seda päeva ja tundi ei tea keegi, ei inglid taevas ega Poeg, vaid Isa üksi. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Sest nii nagu olid Noa päevad, nii on ka Inimese Poja tulemine. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Neil päevil enne veeuputust inimesed sõid ja jõid, võtsid naisi ja läksid mehele selle päevani, mil Noa läks laeva. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Nad ei teadnud midagi, enne kui tuli veeuputus ja võttis nad kõik ära. Nõnda on ka Inimese Poja tulemine. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Siis on kaks põllul – üks võetakse vastu ja teine jäetakse maha. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Kaks naist on veskil jahvatamas – üks võetakse vastu ja teine jäetakse maha.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>Seepärast valvake, sest teie ei tea, mis tunnil teie Issand tuleb! <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Küllap te mõistate, et kui peremees teaks, millisel öötunnil varas tuleb, siis ta valvaks ega laseks oma majja sisse murda. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Seepärast olge ka teie valmis, sest Inimese Poeg tuleb tunnil, mil te ei arvagi!<verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>Kes siis on ustav ja arukas sulane, kelle ta isand on seadnud oma majapidamise üle teenijatele õigel ajal toitu andma? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Õnnistatud on sulane, kelle ta isand tulles leiab nõnda tegevat! <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Tõesti, ma ütlen teile, ta annab tema hoolde kogu oma vara. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Aga kui sulane on halb ja mõtleb: „Mu isanda tulek viibib,“ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ning hakkab peksma kaassulaseid, sööma ja jooma koos purjutajatega, <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>siis selle sulase isand tuleb päeval, mil ta ei oota, ja tunnil, mida ta ei tea. <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>Ta raiub sulase tükkideks ja annab talle sama koha silmakirjatsejatega seal, kus on ulgumine ja hammaste kiristamine.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Tähendamissõna kümnest neitsist</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>Siis on taevariik kui kümme neitsit, kes võtsid oma lambid ja läksid peigmehele vastu. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Viis neist olid rumalad ja viis arukad. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Rumalad võtsid kaasa küll lambid, kuid ei võtnud õli. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Arukad võtsid aga lampidele lisaks kaasa õlianumad. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Kui peigmehe tulek viibis, jäid nad kõik uniseks ja uinusid magama.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>Keskööl aga kõlas hüüd: „Peigmees tuleb! Minge talle vastu!“<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>Siis ärkasid kõik need neitsid ja hakkasid lampe kohendama. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Ja rumalad ütlesid arukatele: „Andke meile osa oma õlist, sest meie lambid kustuvad!“<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>Kuid arukad vastasid: „Ei mingil juhul! Sellest ei jätku meile ja teile! Minge parem kaupmeeste juurde ja ostke enestele ise!“<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>Ent kui nad olid teel õli ostma, tuli peigmees, ja kes olid valmis, sisenesid temaga pulmamajja, ja uks suleti.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>Hiljem tulid ka need teised neitsid ja ütlesid: „Isand, isand, ava meile!“<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>Tema aga vastas neile: „Tõesti, ma ütlen teile, ma ei tunne teid.“<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>Seepärast valvake, sest te ei tea seda päeva ega tundi!<verse eid="MAT 25:13"/></para>
  <para style="s1">Tähendamissõna talentidest</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>Ja jälle, taevariik on kui mees, kes pidi minema reisile. Ta kutsus oma sulased ja usaldas vara nende hoolde. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Ühele ta andis viis talenti, teisele kaks ja kolmandale ühe,<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Vastavalt kolmkümmend tuhat, kaksteist tuhat ja kuus tuhat teenarit. Üks teenar oli töölise keskmine päevapalk. Seega võrdus üks talent 20 aasta teenistusega.</char></note> igaühele tema suutlikkust mööda, ning reisis ära.<verse eid="MAT 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 25:16"/>Kohe läks see, kes oli saanud viis talenti, paigutas need ärisse ja teenis veel viis talenti. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Nõndasamuti ka kaks talenti saanu sai teist kaks juurde. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Aga kes oli saanud ühe, läks ja kaevas maasse augu ning peitis ära oma isanda raha.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>Pika aja pärast tuli nende sulaste isand tagasi ja päris neilt aru. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Tema ette astus see, kes oli saanud viis talenti, lisas sellele veel viis talenti ja ütles: „Isand, sa usaldasid mulle viis talenti. Vaata, ma olen teeninud teist viis talenti!“<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>Isand ütles talle: „Hästi tehtud, sa tubli ja ustav sulane! Sa oled olnud ustav pisku üle, ma panen su palju üle. Tule sisse ja saa osa oma isanda rõõmust!“<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>Tuli ka see, kes oli saanud kaks talenti, ja ütles: „Isand, sa usaldasid mulle kaks talenti. Vaata, ma olen teeninud veel kaks!“<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>Isand ütles tallegi: „Hästi tehtud, sa tubli ja ustav sulane! Sa oled olnud ustav pisku üle, ma panen su palju üle. Tule sisse ja saa osa oma isanda rõõmust!“<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>Tuli ka see, kes oli saanud ühe talendi. Ta ütles: „Isand, ma tean, et sa oled vali mees. Sa lõikad sealt, kuhu sa ei ole külvanud, ja kogud sealt, kuhu sa ei ole seemet puistanud. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Ma kartsin, läksin ja peitsin sinu talendi maa sisse. Vaata, siin on sinu oma!“<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>Tema isand aga vastas talle: „Sa halb ja laisk sulane! Sa teadsid, et ma lõikan sealt, kuhu ma ei ole külvanud, ja kogun sealt, kuhu ma ei ole seemet puistanud! <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Siis sa oleksid pidanud mu raha panema panka, ja tulles ma oleksin saanud selle tagasi kasuga.<verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>Seepärast võtke nüüd tema käest talent ära ja andke sellele, kellel on kümme talenti! <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Sest igaühele, kellel on, antakse, ja tal on rohkem kui küllalt, kellel aga ei ole, selle käest võetakse ära seegi, mis tal on. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Ja see vääritu sulane visake välja pimedusse! Seal on ulgumine ja hammaste kiristamine.“<verse eid="MAT 25:30"/></para>
  <para style="s1">Sikud ja lambad</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>Aga kui Inimese Poeg tuleb oma auhiilguses kõigi inglite saatel, siis ta istub oma auhiilguse troonile. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Ja tema ette kogutakse kõik rahvad ja ta eraldab nad üksteisest, nagu karjane eraldab lambad sikkudest, <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ja seab lambad oma paremale, sikud aga vasakule käele.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>Siis ütleb Kuningas neile, kes on ta paremal käel: „Tulge teie, keda mu Isa on õnnistanud! Võtke vastu oma pärand, Kuningriik, mis teile on valmis pandud maailma loomisest peale! <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Sest mul oli nälg ja te andsite mulle süüa; mul oli janu ja te andsite mulle juua; ma olin võõras ja te võtsite mu vastu; <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ma olin alasti ja te riietasite mind; ma olin haige ja te tulite mind vaatama; ma olin vangis ja te tulite minu juurde.“<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>Siis küsivad õiged temalt: „Issand, millal me nägime sind näljasena ja toitsime sind, või janusena ja jootsime sind? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Millal me nägime sind võõrana ja võtsime sind vastu, või alasti ja riietasime sind? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Millal me nägime sind haigena või vangis ja külastasime sind?“<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>Ja kuningas vastab neile: „Tõesti, ma ütlen teile, mida te iganes olete teinud kellele tahes mu kõige pisematest vendadest, seda te olete teinud mulle!“<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>Siis ütleb ta neile, kes on ta vasakul käel: „Minge ära minu juurest, te neetud, igavesse tulle, mis on pandud valmis kuradile ja tema inglitele! <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Sest mul oli nälg ja te ei andnud mulle süüa; mul oli janu ja te ei andnud mulle juua; <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ma olin võõras ja te ei võtnud mind vastu; ma olin alasti ja te ei riietanud mind; ma olin haige ja vangis ja te ei tulnud mind vaatama.“<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>Siis küsivad temalt ka nemad: „Issand, millal me nägime sind näljasena või janusena või võõrana või alasti või haigena või vangis, ega aidanud sind?“<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>Siis ta vastab neile: „Tõesti, ma ütlen teile, mida te iganes olete jätnud tegemata kellele tahes mu kõige pisematest vendadest, seda te olete jätnud tegemata minulegi.“<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>Ja need lähevad igavesse karistusse, õiged aga igavesse ellu.“<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">Vandenõu Jeesuse tapmiseks</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Kui Jeesus oli kõik need kõned lõpetanud, ütles ta oma jüngritele: <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>„Te teate, et kahe päeva pärast on paasapüha ja Inimese Poeg antakse ära risti lüüa.“<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Siis kogunesid ülempreestrid ja rahvavanemad ülempreester Kaifase paleesse <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>ja pidasid nõu Jeesus kavalusega kinni võtta ja ära tappa. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>Ent nad arutasid: „Mitte pidustuste ajal, et rahvas ei hakkaks mässama.“<verse eid="MAT 26:5"/></para>
  <para style="s1">Jeesuse võidmine Betaanias</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Aga kui Jeesus istus Betaanias pidalitõbise Siimoni kodus, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>astus ta juurde naine, kellel oli alabasternõu ülihinnalise lõhnasalviga, ja valas selle temale pähe, kui ta oli laua ääres.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Kui jüngrid nägid seda, said nad pahaseks ja ütlesid: „Milleks küll see raiskamine? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Selle salvi oleks võinud müüa kalli hinna eest ja raha jagada vaestele.“<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Jeesus märkas seda ja ütles neile: „Miks te tülitate seda naist? Ta on teinud minu heaks kauni teo. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Vaeseid on teie juures alati, mind aga ei ole teil alati. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Sest seda salvi minu ihu peale kallates tegi tema seda minu matuseks. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Tõesti, ma ütlen teile, kus iganes kogu maailmas seda evangeeliumi kuulutatakse, kõneldakse ka tema mälestuseks sellest, mis ta on teinud.“<verse eid="MAT 26:13"/></para>
  <para style="s1">Juudas nõustub Jeesuse ära andma</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Siis läks Juudas Iskariot, üks neist kaheteistkümnest, ülempreestrite juurde <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>ja küsis: „Mis te mulle maksate, kui ma Jeesuse teie kätte annan?“ Nad lugesid talle kolmkümmend hõberaha, <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>ja sellest alates otsis Juudas sobivat võimalust Jeesuse äraandmiseks.<verse eid="MAT 26:16"/></para>
  <para style="s1">Jeesuse viimane paasasöök</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Aga hapnemata leibade püha esimesel päeval astusid jüngrid Jeesuse juurde ja küsisid: „Kus sa tahad, et me sulle paasasöögi ette valmistaksime?“<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>„Minge linna selle-ja-selle juurde,“ vastas Jeesus, „ja öelge talle, et õpetaja saadab sõna: „Minu aeg on lähedal, sinu juures ma pean paasasöögi oma jüngritega!“ “ <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>Jüngrid tegid nõnda, nagu Jeesus oli neid juhendanud, ja valmistasid paasasöögi.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Õhtu saabudes istus Jeesus lauda koos oma kaheteistkümne jüngriga, <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>ja kui nad juba sõid, ütles ta: „Tõesti, ma ütlen teile, üks teie seast annab mu ära!“<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Ja nad said väga kurvaks ning hakkasid talle üksteise järel ütlema: „Ega sa mind ei mõtle, Issand?“<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Jeesus vastas neile: „See, kes on pannud käe minuga samasse kaussi, annab mu ära. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Inimese Poeg läheb küll ära, nõnda nagu tema kohta on kirjutatud, aga häda sellele inimesele, kes Inimese Poja ära annab! Talle oleks parem, kui ta ei oleks sündinud!“<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Siis küsis ka äraandja Juudas: „Ega sa mind ei mõtle, rabi?“</para>
  <para style="p" vid="MAT 26:25">„Need on sinu sõnad,“ vastas Jeesus.<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Ja kui nad sõid, võttis Jeesus leiva, õnnistas, murdis, ulatas jüngritele ja ütles: „Võtke, sööge! See on minu ihu!“<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Siis ta võttis karika, tänas ja ulatas neile, öeldes: „Jooge kõik selle seest! <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Sest see on minu lepinguveri, mis valatakse paljude eest pattude andeksandmiseks! <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Aga ma ütlen teile: mina ei joo siitpeale sellest viinapuu viljast kuni päevani, mil ma joon koos teiega uut oma Isa Kuningriigis.“<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Ja kui nad olid laulnud kiituslaulu, läksid nad välja Õlimäele.<verse eid="MAT 26:30"/></para>
  <para style="s1">Jeesus kuulutab ette, et Peetrus ta salgab</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Siis Jeesus ütles neile: „Te kõik hülgate minu täna öösel, sest kirjutatud on:</para>
  <para style="q1" vid="MAT 26:31">„Ma löön karjast</para>
  <para style="q2" vid="MAT 26:31">ja karja lambad pillutatakse laiali.“<verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>Kuid pärast oma ülesäratamist lähen ma teie ees Galileasse.“<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Peetrus vastas talle: „Kui ka kõik sind hülgavad, ei hülga mina sind iialgi!“<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>„Tõesti, ma ütlen sulle,“ vastas Jeesus, „täna öösel veel enne kukelaulu salgad sina mind kolm korda!“<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>„Isegi kui ma peaksin koos sinuga surema, mina ei salga sind iial!“ ütles Peetrus. Samamoodi ütlesid ka kõik teised jüngrid.<verse eid="MAT 26:35"/></para>
  <para style="s1">Jeesus palvetab Ketsemani aias</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Siis Jeesus tuli koos jüngritega paika, mida hüütakse Ketsemaniks, ja ütles neile: „Istuge siin, kuni ma lähen sinna ja palvetan!“ <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Ta võttis enesega kaasa Peetruse ja kaks Sebedeuse poega ning teda haaras sügav kurbus ja ahastus. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Siis ta ütles neile: „Mu hing on väga kurb surmani, jääge siia ja valvake koos minuga!“<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Ja ta läks pisut eemale, langes silmili maha ja palvetas: „Minu Isa, kui see on võimalik, siis mingu see karikas minust mööda! Ometi ärgu sündigu nõnda, nagu mina tahan, vaid nagu tahad sina!“<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Siis Jeesus tuli tagasi jüngrite juurde ja leidis nad magamast. „Kas te ei suutnud ainsatki tundi koos minuga valvata?“ küsis ta Peetruselt. <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>„Valvake ja palvetage, et te ei satuks kiusatusse! Vaim on küll valmis, aga liha on nõder.“<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Ta läks teist korda eemale ja palvetas: „Minu Isa, kui see karikas ei saa minust mööda minna nii, et ma sellest ei joo, siis sündigu sinu tahtmine!“<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Kui ta tuli tagasi, leidis ta jüngrid taas magamast, sest nende silmalaud olid unest rasked. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Ta jättis nad sinna, läks veel kord ära ja palvetas kolmandat korda, öeldes uuesti needsamad sõnad.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>Siis Jeesus tuli tagasi jüngrite juurde ja ütles neile: „Teie aina magate ja puhkate! Vaata, tund on tulnud ja Inimese Poeg antakse patuste kätte! <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Tõuske üles, lähme! Mu äraandja on lähedal!“<verse eid="MAT 26:46"/></para>
  <para style="s1">Jeesus vahistatakse</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Kui Jeesus alles rääkis, jõudis sinna Juudas, üks tema kaheteistkümnest jüngrist. Temaga oli kaasas suur hulk mehi mõõkade ja nuiadega, saadetud ülempreestrite ja rahvavanemate poolt. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Aga tema äraandja oli andnud neile märgi: „Tema on see, keda ma suudlen; võtke ta kinni!“ <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Ja otsekohe astus Juudas Jeesuse juurde ja ütles: „Tervitus sulle, rabi!“ ning suudles teda.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Jeesus ütles talle: „Tee seda, milleks sa tulid, sõber.“</para>
  <para style="p" vid="MAT 26:50">Siis teised astusid samuti ligi, haarasid Jeesusest kinni ja vahistasid ta. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Aga üks Jeesuse kaaslastest tõmbas tupest oma mõõga ja lõi ülempreestri sulast, raiudes ära ta kõrva.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>„Pista oma mõõk tuppe tagasi!“ käskis Jeesus. „Sest kõik, kes mõõga tõmbavad, mõõga läbi hukkuvad! <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Kas sa arvad, et ma ei või oma Isa appi hüüda, ja ta saadaks mulle kohe rohkem kui kaksteist leegioni ingleid? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Aga kuidas siis saaks täide minna Pühakirja ettekuulutus, et see nii peab sündima?“<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Selsamal tunnil ütles Jeesus rahvahulgale: „Kas ma juhin mässu, et te olete tulnud mõõkade ja nuiadega mind kinni võtma? Ma olen päevast päeva istunud templis ja õpetanud, ja te ei ole mind kinni võtnud. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Aga see kõik on sündinud, et prohvetite kirjad läheksid täide.“ Siis jätsid kõik jüngrid ta maha ja põgenesid.<verse eid="MAT 26:56"/></para>
  <para style="s1">Jeesus Suurkohtu ees</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Aga Jeesuse vangistajad viisid ta ülempreester Kaifase ette, kuhu olid kogunenud kirjatundjad ja rahvavanemad. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Peetrus järgnes talle eemalt kuni ülempreestri õueni, läks sinna sisse ja istus valvurite juurde, et näha, kuidas asi lõpeb.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Aga ülempreestrid ja terve Suurkohus otsisid valetunnistust Jeesuse vastu, et teda surma mõista, <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>kuid ei leidnud, ehkki paljud tulid valetunnistust andma.</para>
  <para style="p" vid="MAT 26:60">Lõpuks astusid ette kaks, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>kes väitsid: „Tema on öelnud: „Ma võin Jumala templi lammutada ja kolme päevaga üles ehitada.“ “<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Siis ülempreester tõusis püsti ja ütles Jeesusele: „Kas sa ei vasta midagi selle kohta, mida nad sinu vastu tunnistavad?“ <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>Kuid Jeesus vaikis.</para>
  <para style="p" vid="MAT 26:63">Siis ülempreester ütles talle: „Ma vannutan sind elava Jumala juures, ütle meile, kas sina oled Messias, Jumala Poeg?“<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>„Need on sinu sõnad,“ vastas Jeesus. „Ometi ma ütlen teile:</para>
  <para style="q1" vid="MAT 26:64">siitpeale te näete Inimese Poega</para>
  <para style="q2" vid="MAT 26:64">istumas Kõigeväelise paremal käel</para>
  <para style="q2" vid="MAT 26:64">ja tulemas taeva pilvede peal.“<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Siis ülempreester käristas oma riided lõhki ja ütles: „Ta on teotanud pühadust! Mis tunnistajaid meil veel on vaja! Nüüd te olete ise kuulnud pühaduseteotust! <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Mis teie arvate?“</para>
  <para style="p" vid="MAT 26:66">„Tema on surma väärt!“ vastasid nad.<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Siis nad sülitasid talle näkku ja peksid teda rusikatega, aga mõned lõid lahtise käega, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>öeldes: „Prohveteeri meile, Messias, kes sind praegu lõi?“<verse eid="MAT 26:68"/></para>
  <para style="s1">Peetrus salgab Jeesuse</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Peetrus istus aga siseõues. Seal astus tema juurde üks teenijatüdruk ja ütles: „Ka sina olid Galilea Jeesusega!“<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Kuid Peetrus salgas kõikide ees: „Ma ei tea, millest sa räägid!“<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Kui ta läks aga värava poole, nägi teda teine teenijatüdruk ja ütles seal teistele: „See mees oli koos Naatsareti Jeesusega.“<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Taas salgas Peetrus vandega: „Ma ei tunne seda inimest!“<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Pisut hiljem astusid mõned sealviibijad tema juurde ja ütlesid:</para>
  <para style="p" vid="MAT 26:73">„Tõesti, ka sina oled üks nende hulgast, sest su kõneviis paljastab sind.“<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Seepeale hakkas Peetrus sajatama ja vanduma: „Ma ei tunne seda meest!“</para>
  <para style="p" vid="MAT 26:74">Ja kohe kires kukk <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>ning Peetrusele meenusid Jeesuse sõnad: „Veel enne kui kukk kireb, salgad sina mind kolm korda.“ Ta läks välja ja nuttis kibedasti.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">Juudas poob end üles</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Koidikul võtsid kõik ülempreestrid ja rahvavanemad vastu otsuse, et Jeesus tuleb surmata. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Nad sidusid ta kinni, viisid ära ja andsid maavalitseja Pilaatuse kätte.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Kui nüüd tema äraandja Juudas nägi, et Jeesus oli mõistetud süüdi, kahetses ta ja viis need kolmkümmend hõbeseeklit ülempreestritele ja vanematele tagasi. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>„Ma olen teinud pattu,“ ütles ta, „sest ma andsin ära süütu vere.“</para>
  <para style="p" vid="MAT 27:4">„Mis meil sellest?“ vastasid nemad. „See on su oma asi.“<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Juudas viskas raha templisse maha ja läks ära. Siis ta läks ja poos end üles.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Ülempreestrid aga võtsid raha üles ja ütlesid: „Seaduse järgi ei tohi seda templikassasse panna, sest see on vere hind.“ <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Nii nad otsustasid kasutada seda raha pottsepa põllu ostmiseks võõraste matmispaigaks. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Seepärast hüütakse seda põldu Verepõlluks tänaseni. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Nii läks täide, mis prohvet Jeremija suu läbi on öeldud: „Nad võtsid kolmkümmend hõberaha, hinna, mille vääriliseks Iisraeli lapsed ta olid hinnanud, <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ja maksid selle pottsepa põllu eest, nii nagu Issand mind oli käskinud.“<verse eid="MAT 27:10"/></para>
  <para style="s1">Jeesus Pilaatuse ees</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Jeesus aga seisis maavalitseja ees. „Kas sina oled juutide kuningas?“ küsis maavalitseja temalt.</para>
  <para style="p" vid="MAT 27:11">„Need on sinu sõnad,“ vastas Jeesus.<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Ent kui ülempreestrid ja rahvavanemad teda süüdistasid, ei vastanud ta midagi. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Siis küsis Pilaatus temalt: „Kas sa ei kuule, mida kõike nad sinu vastu tunnistavad?“ <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Ent Pilaatuse suureks imestuseks ei vastanud Jeesus enam sõnagi.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Maavalitsejal oli kombeks paasapühade ajal vabastada üks vang, keda rahvas soovis. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Tookord oli vangis kurikuulus mees nimega Jeesus Barabas. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Kui siis rahvas oli kogunenud, küsis Pilaatus neilt:</para>
  <para style="p" vid="MAT 27:17">„Kumma te tahate, et ma lasen teile vabaks: Jeesus Barabase või Jeesuse, keda hüütakse Messiaks?“ <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Sest ta teadis, et nad olid Jeesuse kadeduse pärast tema kätte andnud.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Aga kui Pilaatus istus kohtujärjel, saatis ta naine temale sõna: „Ärgu olgu sul midagi tegemist selle süütu mehega, sest ma olen täna öösel und nähes tema pärast rängalt kannatanud!“<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Kuid ülempreestrid ja rahvavanemad keelitasid rahvast, et nad nõuaksid Barabast, Jeesuse aga laseksid hukata.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Siis maavalitseja küsis neilt veel kord: „Kumma neist kahest te tahate, et ma vabaks laseksin?“</para>
  <para style="p" vid="MAT 27:21">„Barabase!“ vastasid nad.<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>„Mida ma siis teen Jeesusega, keda hüütakse Messiaks?“ küsis Pilaatus. „Löö ta risti!“ hüüdsid kõik.<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>„Mispärast? Mis kurja ta on teinud?“ küsis Pilaatus.</para>
  <para style="p" vid="MAT 27:23">Nemad aga karjusid veel enam: „Löö ta risti!“<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Kui Pilaatus nägi, et ta midagi ei saavuta, vaid rahva rahutus üha kasvas, võttis ta vett, pesi rahva ees oma käed ja ütles: „Mina olen süütu selle mehe verest! See on teie vastutus!“<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Ja kogu rahvas kostis talle: „Tema veri tulgu meie ja meie laste peale!“<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Siis Pilaatus vabastas neile Barabase, Jeesust aga laskis piitsutada ja andis ta sõdurite kätte risti lüüa.<verse eid="MAT 27:26"/></para>
  <para style="s1">Sõdurid mõnitavad Jeesust</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Siis viisid maavalitseja sõdurid Jeesuse pretooriumisse ja kogusid tema ümber terve väesalga. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Nad kiskusid ära ta riided ja panid talle selga punase mantli. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Ja nad punusid kibuvitstest pärja, surusid talle pähe ning andsid kätte pillirookepi. Siis põlvitasid nad tema ette maha ja mõnitasid teda: „Tervitus, juutide kuningas!“ <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Nad sülitasid ta peale, võtsid pillirookepi ja peksid teda pähe. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Ja kui nad olid teda küllalt mõnitanud, võtsid nad tal mantli seljast, panid ta oma riided selga tagasi ja viisid ta ära ristilöömiseks.<verse eid="MAT 27:31"/></para>
  <para style="s1">Jeesuse ristilöömine</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Välja minnes kohtasid nad Küreene meest nimega Siimon. Nad sundisid teda kandma Jeesuse risti. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>Ja kui nad jõudsid paika nimega Kolgata (mis tähendab Pealuu koht), <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>pakkusid nad Jeesusele sapiga segatud veini. Kui ta oli seda maitsnud, keeldus ta joomast. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Aga kui nad tema olid risti löönud, jagasid nad liisku heites ta riided omavahel <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>ja istusid sinna teda valvama. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Ta pea kohale kinnitati silt tema süüga:</para>
  <para style="pc" vid="MAT 27:37">
    <char style="sc">See on Jeesus, juutide kuningas.</char><verse eid="MAT 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38"/>Siis nad lõid koos Jeesusega risti kaks kurjategijat, üks temast paremale ja teine vasakule käele. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Möödakäijad aga pilkasid teda päid vangutades: <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>„Noh, templi lammutaja ja kolme päevaga üles ehitaja! Päästa nüüd iseennast! Kui sa oled Jumala Poeg, siis astu ristilt alla!“ <verse eid="MAT 27:40"/><verse number="41" style="v" sid="MAT 27:41"/>Samamoodi pilkasid teda ka ülempreestrid koos kirjatundjate ja vanematega: <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>„Teisi on ta päästnud, aga iseennast ei suuda ta päästa. Ta on ju Iisraeli kuningas! Astugu nüüd ristilt alla ja me usume temasse! <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Ta on lootnud Jumala peale. Las Jumal ta nüüd päästab, kui ta teda tahab, ta ju ütleb, et ta on Jumala Poeg.“ <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Samamoodi pilkasid teda ka koos temaga risti löödud kurjategijad.<verse eid="MAT 27:44"/></para>
  <para style="s1">Jeesuse surm</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Kuuendal tunnil<note caller="+" style="f"><char style="fr" closed="false">27:45 </char><char style="fqa" closed="false">Kuues tund </char><char style="ft" closed="false">on keskpäev.</char></note> langes pimedus üle kogu maa ja kestis üheksanda tunnini<note caller="+" style="f"><char style="fr" closed="false">27:45 </char><char style="fqa" closed="false">Üheksas tund </char><char style="ft" closed="false">on kell kolm pärastlõunal.</char></note>. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Üheksandal tunnil kisendas Jeesus valju häälega: „<char style="tl">Elii, elii, lemaa sabahtani?</char>“ – see tähendab „Mu Jumal, mu Jumal, miks sa mu maha jätsid?“<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Aga mõned sealseisjatest ütlesid seda kuuldes: „Ta hüüab Eelijat!“<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Ja kohe jooksis üks nendest ja tõi hapu veiniga<note caller="+" style="f"><char style="fr" closed="false">27:48 </char><char style="ft" closed="false">Arvatavasti hapu veini, veiniäädika ja vee segu, mis oli tavapärane sõdurite jook.</char></note> immutatud käsna, pistis selle kepi otsa ja andis Jeesusele juua. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Teised aga ütlesid: „Aitab küll! Saame näha, kas Eelija tuleb teda päästma!“<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Aga Jeesus kisendas jälle suure häälega ja heitis hinge.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>Siis rebenes templi eesriie ülalt alla kaheks, maapind rappus, kaljud lõhenesid <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ja hauad läksid lahti. Ja ärkas üles palju magama uinunud pühade ihusid <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>ja need tulid hauakambritest välja ja läksid pärast tema surnuist ülesäratamist pühasse linna, kus paljud neid nägid.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>Kui sadakonna ülem ja need, kes Jeesust koos temaga valvasid, nägid maavärinat ja kõike, mis sündis, lõid nad väga kartma. „Tõepoolest, see mees oli Jumala Poeg!“ ütlesid nad.<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Aga seal oli toimuvat eemalt vaatamas palju naisi. Nad olid järgnenud Jeesusele Galileast alates ja hoolitsenud tema eest. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Nende seas olid Maarja Magdaleena ja Jaakobuse ja Joosepi ema Maarja ning Sebedeuse poegade ema.<verse eid="MAT 27:56"/></para>
  <para style="s1">Jeesuse matmine</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Õhtu hakul tuli Arimaatiast rikas mees nimega Joosep, kes oli samuti Jeesuse jünger. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Tema läks Pilaatuse juurde ja palus ta käest Jeesuse surnukeha, ning Pilaatus käskis selle temale anda. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Joosep võttis surnukeha, mähkis selle puhtasse linariidesse <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ja pani oma uude kaljusse raiutud hauakambrisse. Siis veeretas ta haua sissekäigu ette suure kivi ja läks minema. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Aga Maarja Magdaleena ja teine Maarja istusid seal haua vastas.<verse eid="MAT 27:61"/></para>
  <para style="s1">Valve Jeesuse haual</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Järgmisel päeval, pärast pühade ettevalmistuspäeva, tulid ülempreestrid ja variserid üheskoos Pilaatuse juurde. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>„Isand,“ ütlesid nad, „meil on meeles, et see eksitaja ütles, kui ta alles elas: „Mind äratatakse kolme päeva pärast üles!“ <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Seepärast käsi hoida tema hauda kuni kolmanda päevani kindlalt suletuna, et jüngrid ei tuleks ja teda ära ei varastaks ega ütleks rahvale, et ta on üles äratatud. Siis oleks see viimane pettus hullem kui esimene.“<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>„Võtke valvesalk,“ ütles Pilaatus neile, „minge ning pidage valvet, nii kindlalt kui oskate!“ <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Nemad läksid ja võtsid haua valve alla, pannes kivi pitseriga kinni ja seades sinna valvurid.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Jeesus on üles tõusnud!</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Pärast hingamispäeva, nädala esimese päeva koidikul, tulid Maarja Magdaleena ja teine Maarja hauda vaatama.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Äkki sündis võimas maavärin, sest üks Issanda ingel laskus taevast alla, tuli haua juurde ja veeretas kivi eest ja istus selle peale. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Aga ta nägu oli nagu välk ja ta rõivad valged nagu lumi. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Ning hirmust tema ees valvurid vabisesid ja langesid maha nagu surnud.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Aga ingel pöördus naiste poole ja ütles: „Teie ärge kartke! Ma tean, et te otsite ristilöödud Jeesust. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Teda ei ole siin; ta on üles äratatud, nõnda nagu ta ütles. Tulge, vaadake kohta, kus ta lamas, <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ja minge ruttu, öelge tema jüngritele, et ta on üles äratatud surnuist ja läheb teie ees Galileasse. Seal te saate teda näha. Pidage meeles, ma olen seda teile öelnud!“<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Naised lahkusid haua juurest ehmunult ja suure rõõmuga ja jooksid rutuga viima jüngritele teadet. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Korraga tuli Jeesus ise neile vastu ja ütles: „Olge tervitatud!“ Nad astusid tema juurde, haarasid ta jalge ümbert kinni ja kummardasid teda. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>Jeesus ütles neile: „Ärge kartke! Minge, teatage mu vendadele, et nad läheksid Galileasse! Seal nad saavad mind näha.“<verse eid="MAT 28:10"/></para>
  <para style="s1">Kuulujutt tühjast hauast</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Kui naised olid juba teel, tulid mõned valvesalgast linna ja teatasid ülempreestritele kõik, mis oli sündinud. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Ja ülempreestrid tulid koos vanematega kokku ja võtsid nõuks anda sõduritele palju raha <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>ja ütlesid neile: „Te peate ütlema, et Jeesuse jüngrid tulid öösel ja varastasid tema ära, sellal kui teie magasite. <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Ja kui see lugu peaks maavalitseja kõrvu jõudma, siis me rahustame teda, nii et teil pole tarvis muretseda.“ <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Sõdurid võtsid raha vastu ja tegid, nagu neid oli õpetatud. Ning see jutt on levinud juutide seas tänase päevani.<verse eid="MAT 28:15"/></para>
  <para style="s1">Jeesus annab jüngritele misjonikäsu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Üksteist jüngrit läksid aga Galileasse sinna mäele, kuhu Jeesus neid oli käskinud minna. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Ja kui nad teda nägid, kummardasid nad teda, aga mõned kahtlesid. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>Siis Jeesus astus nende juurde ja rääkis nendega: „Minu kätte on antud kõik meelevald taevas ja maa peal. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Minge siis ja tehke jüngriteks kõik rahvad, ristides neid Isa ja Poja ja Püha Vaimu nimel <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>ja õpetades neid järgima kõike, mida mina teid olen käskinud! Pidage meeles, et mina olen iga päev koos teiega kuni selle ajastu lõpuni!“<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
