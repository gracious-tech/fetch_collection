<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- HUNGWARHEA</book>
  <para style="toc1">Ibraniyawa</para>
  <para style="toc2">Ibraniyawa</para>
  <para style="toc3">Ibraniyawa</para>
  <para style="mt">Ibraniyawa</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Hwinsu u cibai icwa yoba pa Yesu Kristi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Na haya hana ha ali Hwinsu u ea cikarigo na haca̱ca̱ ahaci pa acubago Hwinsu tun huni na hayina dinya, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />ama na hun ihogu bu i cikarigo na gaci pa Bwa bu bware Yesu, buna buba i tibai pa Bwa buba, Bube busan Magaji u tibai. pa Bwa bu bware hinda Hwinsu uba i cinge na zaro na ina iyiwa na suwa waba. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Bwa buni hinda bube busa cingero na izangacu i Hwinsu hinda i nyaga na Hwinsu. pa koce buba bu kumgage i tibai na tibai pa cikarigo ci bware hinda buyiwa nga̱ Hwinsu. una uza kuce nga̱ bware bu ce guzagi ciri, kwa bware na madala na wa cuga u Hwinsu buna buza izangacu ka̱mu.<verse eid="HEB 1:3" /></para>
  <para style="s">Yesu Bwa bu Hwinsu bu zake acuma Hwinsu na Izangacu</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Hwinsu u uga Bwa bu woba bu zake acuma Hwinsu na kuce nga̱ ize ina Hwinsu ibu pan bware i zake ina yaba cilabe. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Hwinsu wa hyinwo acuma uba,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Busa Bwa bumui;</para>
  <para style="q2" vid="HEB 1:5">nawuya nasa Buca̱ abuhin.&gt;&gt;</para>
  <para style="m" vid="HEB 1:5">Ko hinda Hwinsu wui tabo hin na acuma,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Ni sa Buca̱ abuya,</para>
  <para style="q2" vid="HEB 1:5">hinda bui sana Bwa abumui.&gt;&gt;<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Ama nga̱ Hwinsu uba gimbaga cuma Bwa buba suwa doone, u hin,</para>
  <para style="q1" vid="HEB 1:6">&lt;&lt;Ka̱mu acuma Hwinsu a pa̱ Bwa bu ba cilabe.&gt;&gt;<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Ama na cikarigo ci acuma Hwinsu u hin,</para>
  <para style="q1" vid="HEB 1:7">&lt;&lt;Hwinsu usa̱ acuma uba asa̱ nga̱ mupyala,</para>
  <para style="q2" vid="HEB 1:7">muna yiwa na eagya unwa ibwana nga̱ a̱re a ala.&gt;&gt;<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />Ama zwama Bwa bu Hwinsu u hin,</para>
  <para style="q1" vid="HEB 1:8">&lt;&lt;Cigwama ci Hwinsu ciza ihogu,</para>
  <para style="q2" vid="HEB 1:8">Bui ea cigwama na burya̠.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Bu ka̱ri i burya̠ hinda bu wonje eewo;</para>
  <para style="q2" vid="HEB 1:9">Ube usa̱ Hwinsu, uba bu tanga goo bu curi a'usa a ibwana nebui</para>
  <para style="q2" vid="HEB 1:9">nabu hala goo manube ma wanwo.&gt;&gt;<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Hinda u hin,</para>
  <para style="q1" vid="HEB 1:10">&lt;&lt;Na jigu, Goo, Buca̱ bu yaba, gabuya bu i ema i doone,</para>
  <para style="q2" vid="HEB 1:10">zaro hinda usa ibwana i wa nubui.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />I ka̱mu iza yanakana, ama goo bu za ihogu; Ka̱mu waba ai unge a nyaga nga̱ hazuzu.<verse eid="HEB 1:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="HEB 1:12" />
  </para>
  <para style="q1" vid="HEB 1:12">Bui naji unwa nga̱ cilapo,</para>
  <para style="q2" vid="HEB 1:12">ai sake unwa nga̱ hazunga</para>
  <para style="q1" vid="HEB 1:12">Ama goo aza bu saka buyiwa nga̱ goo buyiwa,</para>
  <para style="q2" vid="HEB 1:12">ama goo buza onge.&gt;&gt;<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Hwinsu wa tabuwa hin na acuma a bware,</para>
  <para style="q2" vid="HEB 1:13">&lt;&lt;Madale na wa cuga numui</para>
  <para style="q1" vid="HEB 1:13">kwa na san aco na ai ka̱ruwo</para>
  <para style="q2" vid="HEB 1:13">Utaka u buna nubuya.&gt;&gt;<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Bamba asa acuma Hwinsu? Abe as a̱huru ana a lagana Hwinsu, Hwinsu u cuma ga zwam a banga aco na ai re gajo u icagagu.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Icagagu i Hwinsu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Zwama haruni u kamaci, gaci tani soo nuce na kuce, pa Hwinsu na iri na gaci hoge, zwama cita silta. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Cicuma cina Hwinsu uba cuma pa acuma Hwinsu kurwo pa gaci usa kamahinda, hinda ka̱mu buna bu wonje ce ko nabiya bui iwo ina cicuma ciniya ci hin, bui hyan hukunci una u kamaci. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Zwama haruni, niya gaci ci sirya si ci curi iri uni icagagu? Hwinsu na icwa uba tun na jigu uba zwame hinda aco na hugi cikarigo ciniya a tane soo na ciba hinda aco na hoge a yaje ana isi i kamahinda. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Hwinsu hinda u jidane sheda uba zata sheda pa aco na eagu alama, na ibwana i mamaki, na i labe iri iri, na ipanganu i a̱huru a burya̠ nga̱ Hwinsu uba ginbo.<verse eid="HEB 2:4" /></para>
  <para style="s">Yesu asa yina u icagagu</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Hwinsu u tanuwa acuma a i cugwama pa zamani ana ayiwa na kurwo- na doone una u gaci yiwa na ea cikarigo caba. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Ama na haruni, nga̱ cikarigo ci Hwinsu ciba hin,</para>
  <para style="q1" vid="HEB 2:6">&lt;&lt;Biya usa buma buna goo bui ma dame na buba,</para>
  <para style="q2" vid="HEB 2:6">Bwa bu buwama, hal goo bui ma dami na buba?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Bu tana bo na lokaci cimu ime na acuma Hwinsu;</para>
  <para style="q2" vid="HEB 2:7">bu pan bo cilabe na izangacu,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />hinda bu tane tibe pa wa u buwama a aza ina aba ta pwanuwa buma koce na babuba.&gt;&gt;</para>
  <para style="m" vid="HEB 2:8">Hwinsu u pan buco bu i cigwama pa i ka̱mu. Ko, baniya ci hyanuwo buma buba i cigwama pa i ka̱mu. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Ama ina gaci yiwa na hyan Yesu, buna aba misi Bware a tana bo ime na acuma Hwinsu, Ama baniya a pa bware izangacu na cilabe zwama bu so wahala u u'o. A i haruni zwama i burya̠ i Hwinsu bu kwaji zwama aco ka̱mu.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Hwinsu ube u ia̠ i ka̱mu, zwama i ka̱mu iba i yana, bu kole saawo dinyiya pa izangacu, zwama haruni, u gyamaci bu tana Yesu a so wahala, bu sinji cugwama ci burya̠. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Zwama bube yanse ne guzagu aco pa ciri, na aco na aba guzagu ana za ciri asa Buca buika.bube sa Yesu wa huguwa mu'inya bu uga aco na ahun a bware. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Yesu a hin na Hwinsu,</para>
  <para style="q1" vid="HEB 2:12">&lt;&lt;Na zwamana aco nimui ina aba ai ia̠;</para>
  <para style="q2" vid="HEB 2:12">na haisa aco dinyiya na ia̠ azuga a eza nibui.&gt;&gt;<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Hinda,</para>
  <para style="q1" vid="HEB 2:13">&lt;&lt;Ni tan iyajo numui pa ba.&gt;&gt;</para>
  <para style="m" vid="HEB 2:13">Hinda bu hin,</para>
  <para style="q1" vid="HEB 2:13">&lt;&lt;Gyamui abuna, na saawo sina Hwinsu bu ni pan.&gt;&gt;<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />saawo si Hwinsu asa awama ana aza munigwa na mahya, Yesu asa haruni zwama u'o u bware a hone buna buza koce u'o, uba ui huzi kuce bugwama bu eewo, buna buzi kuce pa u'o. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />Hinda bu pasingi aco na iwasa u'o ana pare, hal ma iwasa ni i ringyano san agyama na haya hab ka̱mu. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Harbuni sa acuma Hwinsu uba na bangan azwaga a Ibrahim. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Zwama haruni u ea na burya̠ a ringe nga̱ aco buba ahun a bware na tiwamaba yina, zwama buba san bu kamahinda hinda bulabe bulabe bu yama na ibwana i Hwinsu, zwama a habe magwata̱ ma aco. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Nga̱ bware na icwa i buba bu so wahala na gwaji, Yesu i jube banga aco na yiwa na gwadag.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Yesu a zaki Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Ahun numui aco cu'a na aco cware alaganu, ana Hwinsu uba uga, tana soo nuhin pa Jesus, ana Hwinsu uba cuma asa bulabe bu labe iyajo soo nuciya. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Yesu a i ka̱mu ina Hwinsu uba ginbage, nga Musa uba i ka̱mu ina Hwinsu uba gimbage na u i. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Buco buna bu i ima buzaki ima na daraja. Harbuni hinda u kamaci a pan Yesu cilabe na Musa. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Tinba yaba aza buna bu ma buma buba, ama Hwinsu bube bu i tibai. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Musa u i dala a burya̠ pa yaba Hwinsu, hinda u i sheda ina Hwinsu i ea na haya hana ha yiwa na korwo. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Ama Kristi a ea ina Hwinsu hin a ea. Gaci cisa aco bware si ci ali na koce u soo nuci, hinda ciyiwa na tana soo pa ina gaci ginbago ci hin.<verse eid="HEB 3:6" /></para>
  <para style="s">Uhunpacu wa aco Hwinsu</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Zwama haruni, nga̱ a̱huru a burya̠ aba hin,</para>
  <para style="q1" vid="HEB 3:7">&lt;&lt;Si bu hoge bicwaro bi Hwinsu nawuya,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />Ta ia̠ nagu hacobe nga̱ hacaca ahahi haba i nagu hacobe pa Hwinsu, nga̠ aba ia̠gi Hwinsu tawaye na hillo,</para>
  <para style="q2" vid="HEB 3:8">hun na aba gwaji Hwinsu.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Hinda hacaca hani gwaji, Hwinsu u hin, a hyan ina Gya na ia̠gi na haya kope nasi nga̱ hab na gwaji.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Ube san gya na hacigage soo na azwaga a jigu,</para>
  <para style="q2" vid="HEB 3:10">kwa gya na hin, &lt;&lt;Hasuwa hahin aza hana ha ea ina gya na genbo,</para>
  <para style="q2" vid="HEB 3:10">hinda a wonje lagan ina gya na hin a ia̠.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Kwa gya na hacigaga soo hal na macune,</para>
  <para style="q2" vid="HEB 3:11">&lt;Aza ese cinge ci hupacu cina ci gya na ka̱ri pan ga a hupaci.&gt; &gt;&gt;<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Ahun nimui, i daki aza buna soo u eewo na nagu u itano soo hal icuru i lagano. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Ama u gyamaci ga̱hi i karpapi sicwa asihin tunbuhun. i ea ampani na ti hamba hon ana ga̱hi i za zwama ga̱hi &lt;&lt;Nawuya&gt;&gt; , i ese ciri. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Gaci cisa aco na ayiwa na Kristi si ci yinsa na kuce na itano i soo niciya tun na jigu hal kurwo baniya.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Ina cikarigo ci Hwinsu ciba hin:</para>
  <para style="q1" vid="HEB 3:15">&lt;&lt;Nawuya, si i huge bini bicwaro,</para>
  <para style="q2" vid="HEB 3:15">Ta ia̠ nagu hugago numa nga̱ hacaca a̱hahin a i</para>
  <para style="q2" vid="HEB 3:15">hun na aba i tawaye na Hwinsu.&gt;&gt;<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Abambani ana a hugi bicwaro bi Hwinsu hinda a ia̱gi Hwinsu tawaye? Ka̱mu aco na Musa uba silacume na Masar. <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Abambani ana Hwinsu uba macuni zwama ba ana aza ise cinge ci alkawali hal haya kupe nasi? Ai abe asa aco na a i magwata̱, ana a kwadagi na hill. <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Bambani ana Hwinsu uba i kucuna naba ana aza ese ihupcu ibuba cimu? Ai abe asa aco na a wanji i ina Hwinsu uba ka̱ri. <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Zwama haruni ci hyan zwama nagu u itano soo ube san ai panuwa ese hugo wui hupaco.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Zwama haruni, nga ieso ihuga i hupaco u sa kamahinda, ci masikai zwama ata hyan buna buza i pwan ese. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Nga gaci hugi cikarigo ciniya ci burya̠ nga̱ aba ma a hugi; a hoge ama ci eaguwo ga ampani, zwama ai cewa na itano soo. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Ama gaci buna ci tane soo ga̱ci ci ese uhunpacu ci tada a̱hunda mabutaryaga na numa Hwinsu cina hin,</para>
  <para style="q1" vid="HEB 4:3">&lt;&lt;Kwa gya na hacigaga soo na i kucuna ana,</para>
  <para style="q2" vid="HEB 4:3">&lt;Aza ese ihugu i hupacu numui sam.&gt; &gt;&gt;</para>
  <para style="m" vid="HEB 4:3">Hwinsu u hin haruni zwama bu rigan bo hogu ea doone. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Zwama azai huga na a rubuci cikarigo ci Hwinsu a i cikarigo zwama hun tandarya na doone: &lt;&lt;Hinda na hun tandarya Hwinsu u hupaci na ka̱mu ibwana i bware.&gt;&gt; <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Hal baniya a gope rubuta, aza ise ihuga i uhupacu numui.&gt;&gt; <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Aco na a huge noma ni na jigu aza ese zwama ai eaguwo ina Hwinsu uba ka̱ri. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Hinda Hwinsu u jidane eag hun i hupaco, hinda lokaci niya usa, nawuya.&gt;&gt; Hwinsu u zwama acibago Dauda na haya dinya, nga̱ cikarigo ci Hwinsu ciba hin tun na jigu,</para>
  <para style="q1" vid="HEB 4:7">&lt;&lt;Nawuya si i hugi bicwaro bi Hwinsu nawuya,</para>
  <para style="q2" vid="HEB 4:7">ita gundana hacube nuhin.&gt;&gt;<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Si Yoshuwa a pan aco Hwinsu ihupacu ni, Hwinsu uza gupakan ea cikarigo zwama acagiya hun ihupacu una u yiwa na kurya. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Uni u cibe hal baniya aza hon i hupacu musaman ana ayiwa na kure zwama Hwinsu. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Zwama ka̱mu buna bu ese ihugu i hupacu i Hwinsu u hupacu zwama ibwana i bware, nga̱ Hwinsu ma uba hupacu huna bware bu hogi eagu doone. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Zwama haruni ci i kokari ci ise yaba ihupaco yaba Hwinsu, ci ta yada ci wonje i ese a̱nga̱ aco na wonje i lagana bware. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />Zwama cikarigo ci Hwinsu ci sa a̱huru na kuce, ci hwaci kasankari, ci gunji ka̱mu na a̱huru na, a yiwa na gunji buco hal ese-suwa buco, gunji sakanin suwa na a̱huru na unpu na ha bini. halma a daki ina buco buyiwa na ea na soo. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Aza ina iyiwa na cisunyi ina Hwinsu uza daki. Ka̱mu i yiwa na sarari pa hisa Hwinsu, buna gaci ci pan bo i na gaci yi ka̱mu.<verse eid="HEB 4:13" /></para>
  <para style="s">Yesu asa bulabe bulabe</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Baniya nga̱ gaci zi bulabe bulabe buna bu ese cigwama ci Hwinsu, Yesu Bwa bu Hwinsu, ga̱ci yinsa na burya̠ ci kumbe ina ga̱ci yaje niba. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Zwama Bulabe Bulabe abuci bu sa buco buna buza i hugi yama nuciya zwama nagu kuce nuciya, ai bube busa buna aba gwaji ka̱mu iri yina nga̱ aba-gwaji gaci, sa ama bware bu eawo magwata̱ <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Zwama haruni ci hin kuce u suwa, ci kurya ciyabu na dala cigwama ci Hwinsu, wato ihugo Hwinsu, zwama gaci ce hin yama, hinda ci hin i burya̠ una ui ci taimaka huna ga̠ci gimbaga.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Aco a tanga ka̱mu alabe alabe aco cware hinda a tanaga aco na ai san madadi maba pa Hwinsu, a pan sadaka zwama a curi magwata̱ maba. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Zwama bware ma buzi magwata na hayina dinya hinda bware busa buco bui pan aco na azi nagu ui cidako na aco na ai laganuwa yina a burya̠. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Ube u san bube ma bui i sadaka zwama eewo bware, hinda na eewo aco. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Aza buna bui pwan zanga cilab na pa ibe buba; kwa Hwinsubu ugan bo, inga uba ugan Haruna.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Na haruni, Kristi ma bui zanguwa icwa i bware ma bwe zanguwa icwa i buba bu sana bulabe bulabe. ama, Hwinsu u hin na buba,</para>
  <para style="q1" vid="HEB 5:5">&lt;&lt;Goo busa bwa bumui;</para>
  <para style="q2" vid="HEB 5:5">Nawuya nisa Buca abubui.&gt;&gt;<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Hinda bu hin na cyagiye huga,</para>
  <para style="q1" vid="HEB 5:6">&lt;&lt;Bui sana bulabe bulabe hal ihogu,</para>
  <para style="q2" vid="HEB 5:6">nga̱ Melkizedek. <verse eid="HEB 5:6" /><verse number="7" style="v" sid="HEB 5:7" />Hun na Yesu bu yiwa na doone bu cuta ahunda̠ na hinda na i une Hwinsu na cidaro ci kuce, Gamba bui caga bo pa u'o. zwama bware na i ka̱mu ina Hwinsu uba ka̱ri, hinda Hwinsu u ce ahunda̱ a buba. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Ko nga̱ Yesu aba san Bwa bu Hwinsu, bu i ina Hwinsu uba ka̱ri zwam ipano wahala ina bware buba so. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Nga̱ Hwinsu uba san bware bulabe bulabe bu nagu cirya, bware bu si yina ui cagagu ana aza ihogu pa aco na a laga umurni u bware. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Hinda Hwinsu uba sa bware bu sa bulabe bulabe nga̱ Melcizedek.<verse eid="HEB 5:10" /></para>
  <para style="s">inumu i hacube zwama itano soo</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Ci zi i dinya ina gaci ka̱ri hin zwama cikarigo cina, ama uza na sauki gaci cibu cibe pa ga̱hi ama iza daki. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Izi mohon dinya kafi ga̱hi i san hawalami , ama hal ka baniya i yiwa na ginbo cagiya walami bu cibe cikarigo ci Hwinsu. I jubuwa na ere mare, ama hal ka baniya i yiwa na so mosubo. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Ka̱mu buna bu maisi mosubo mare busa bwa bu nuya, hinda bui dakuwo icibagu ui nagu magwata. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Ama mare mas ma aco labe, ana a daki na icibagu eewo na i burya̠.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Zwama haruni ci yaje, cire gaba na cibagana ina gaci hoge na jigo, ina ci cibage game na Kristi Yesu zwama gaci sana aco siji na daku. Ube u san hal ka baniya ci siwa na cibago ina gaci hoge na jigu kamahinda pa Hwinsu , na cibago I curiwo eagu eewo ina I kula pa u'o. <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />Na cibago zwama baptisma, na tangano unu burya̠ siwa na cibago yasingago aco na kwadago, na huna Hwinsu uba ui eag hukunci ana aza ihogu. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />. Cureji ci re na tani suwa pa Hwinsu.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Zwama aco na a curi ilagan cingero u sana majidana iringage atuba. Zwama ataba ca daji uzaro a̱ha̱hi rabo waba na suwa wa a̱huru Hwinsu. <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />. A tabo hoge laco wa daji Hwinsu wato cikariggo ciba na haya hana ayiwa na kurya. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />. Ka̱mu na haruni ama marege kacuta na iyajo yaba! Aza nama ajidana ringagaga a curaji ia̠ga eewo, zwama ajidana jukana Bwa bu Hwinsu, ayiwa nabiya na pangana bware mu'eba sana a cinsunyi. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Cinge cina ci sila aba si hyani tonoho, siyiwa si cikaba sici nabura pa aco na akabage cikaba, a ciniya cina si pa mamata ma burya̠ dinyiya. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Ama si cinge ci pangana mapucipuci ma burya̠ humbe na kware, ci za ampani. Iru cinge ci Hwinsu tana unwa unu eewo na hagu aba ca cume ca ulah. <verse eid="HEB 6:8" /><verse number="9" style="v" sid="HEB 6:9" />Ahun naci alagano cina ci gaci ka̠ri na kamahinda ko na haruni ciyiwa na ia̠ga cikarigiwo ci yaji na ga̱hi-hinda na ibwana i kamahinda i ga̱hi una ui pan icagagu. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Hwinsu usa u kamahinda, uza na ma'inga na ibwana i burya̠ ina ga̠hi i, na maka̠la̠ ina ga̠hi cibe bo na ga̠hi na taimako aco nagu ciri, nga̠ ga̠hi na ea har ka baniya. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Ci ginba ga̠hi i mahaguza eagu ibwana i burya̠ hal kuro ihogu, zama ga̠hi ihan ina ga̠hi tana soo zwam waba. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Ci ka̠ruwo ga̠hi ita sana aco nagu eago ibwana, ama nyaga inga aco na ai hyan gajo kicuna ku Hwinsu zwama itano soo a̠ na hakuri waba.<verse eid="HEB 6:12" /></para>
  <para style="s">Alkawali a Hwinsu a yiwa</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Hun na Hwinsu uba eagi Ibrahim alkawali, zwama aza buna bu zake Hwinsu ea kucuna na ize i bware. kwadi bu i na ize i buba, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Hwinsu u hin na Abraham, &lt;&lt;Ni bu tan unu burya̠, hinda na sana azwaga ahabui dinyiya.&gt;&gt; <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Ibrahim bu lata suwa na hakuri kwa bware na hyan ina Hwinsu uba i bo alkawali. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Aco ayiwa na i kucuna na ina zake ga na kuce, hinda kucuna kuna aba i ui kulaga masasa mab pa ihogu. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Hwinsu hinda bu sinji kucuna ku bware zwama aco na buba eagyaga alkawali a daki busa Hwinsu ana aza masake manup ma bware; kwa buba na sinji alkawali a bware na kucuna. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />To, aza i barya ina za masaka, ana Hwinsu uza ea cibya, ina hinda isa i na i ci labta soo pa gaci, <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Hinda itano soo nuci isa i kamahinda i yiwa na ci pan tabaci ci yinsa na soo nuci, sa na ihugo i wasa ko na hasoo harya. Ibe i ese dinyiya na suwa u labule u iginga i Cigwama ci Hwinsu. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Yesu hinda abe asa buco bu jigo buna bu rwage ikore zwama gaci hinda a san bulabe bu iginga hal ihogu, nga̱ Melkizedek.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Bulabe Mlkizedek</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Melkizedek masase busa bugwama bu Salem, hinda masa bulabe bu Hwinsu buna bu zake tiganba. Nga̱ Ibrahim iba na giwo pa gasa ina i bware buba i nasara na mugwamgwam mu nasi, Melkizadek bu bangi bware na tana bware unu burya̠, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />hinda Ibrahim bu pa bware zaka u tibe. na jigu, ma'ana ma ize i melkizedek usa &lt;&lt;Bugwama bu yins burya̠.&gt;&gt; Hinda bube busa Salem, una uyiwa na nupi &lt;&lt;Bugwama budala a burya̠.&gt;&gt; <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Melkizedek hinda buza buca ko amaci, ko usali, Buza jigu u haya ko ihogu i a̱huru, Inga Bwa bu Hwinsu bware busa bulabe bu Iginga hal ihogu. <verse eid="HEB 7:3" /><verse number="4" style="v" sid="HEB 7:4" />Byana iri muso u buco buni: Hal Ibrahim buna busa hacaca a ha Israila bu pan bo ha sadak una u bware bu hin na gasa. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Na icibago i Musa Ka̱mu azwaga a Lawi ana asa alabe a iginga ayiwa na cyag sadak pa wa u aco wata pa sia'osa, Ka̱mu na haruni asa azwaga a Ibrahim. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Aman Melkizedek buna bu usali u bware ui sa uinka na ha Lawi, hinda bu cyag sadak pa wa u Ibrahim, hinda bu tana Ibrahim unu u burya̠ buna aba egyi kucuna. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Ko na shaka buna bweywa na tana unu u burya̠ bu zaki buna buyiwa na cyag na labe. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Ha piristi hana ha cyag u sadaka asa aco cwre ana a kwadag, ayiwa na cyaga ha sadaka pa wa aco, ama na zwama u Melkizedek, buna bu cyag u sadaka pa Ibrahim, a pan sheda u bware busa buna buza kwadag hal hal hal, <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Hal hinda ai pan hin bo Lawi na icwa iboba, buna bu azwaga a bware abe na cyag sadaka, bware bu pan sadak u buba pa wa u Ibrahim. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Zwama na hona Melkizedek uba bangi Ibrahim, ai matuwa Lawi, ama bu yiwa na ikanga i buba<verse eid="HEB 7:10" /></para>
  <para style="s">Yesu asa Bulabe bu iginga nga iba gyamaci</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Baniya nga halabe a iginga una u azwaga a Lawi u kurya na icibagu u Musa una aba pan Isra'ila. Wasa a hin ana ibwana i alabe alabe ana a sizwaga a Lawi ui pan dala a usinju, ai aza Hwinsu uza cumakana acagiya Bulabe bu iginga, na bulabe bu iginga buna bu i daidai na Melkizedek maimako Lawi na Haruna. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Zwama si a masaki alabe a iginga usa dole a saki icibago. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Buna ayiwa na zwaman cikarigo cina zwama buba, wata Bugwama doone, bu sirya daga azwaga a daban, hinda aza ko na buco bweka buna bu isirya pa azwaga a buba buna bu i ibwana. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Ina i yiwa na nupi, Buca abuco bu sirya pa azwaga a Yahuda una Musa bui tabuwa ea cikarigo ciba zwama bulabe bu iginga. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Hinda cikarigo cini ga̠ci ci bu zwaman cizawa na cisunyi si acagiya alabe buna buyiwa inga Melkizadek buzawa na cisunyi. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Yesu hinda bu sana Bulabe bu iginga sa zwama na igyamacu i iganga kafin Buba sana bu nga̠ aco doone ama zwama a̱huru ana aza ihogu. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Cikarigowo na ci Hwinsu hyan:</para>
  <para style="q1" vid="HEB 7:17">&lt;&lt;Gabuya busa Bulabe bu iginga buna buza ihogu, na stari u melkizedek.&gt;&gt;<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />A curi iciba jigu na wa gula zwama uza kuce na nagu ui ampani i uba. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(Zwama icibago i Musa uza jube sana ihya u sinji), ama baniya a i acagiya itano soo una ui ci kulaa pa Hwinsu.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Hwinsu u tabaci ini pa kucuna kuba! Hwinsu wa iwo haruni pa acagiya alabe iginga, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Ama Yesu bu sana Bulabe bu iginga na kucuna inga Hwinsu uba hyin naba:</para>
  <para style="q1" vid="HEB 7:21">&lt;&lt;Hwinsu u rigano i kucuna</para>
  <para style="q2" vid="HEB 7:21">hinda uza i sake suwaba:</para>
  <para style="q1" vid="HEB 7:21">&lt;Guwo bui san bulabe bu iginga una uza ihogu.&gt; &gt;&gt;<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Zwama kucuna ku Hwinsu Yesu uba sana Buco bu kimgana aco na Hwinsu. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />Alabe ajigu a musa zwama u'o uza na curiga eag ibwana; <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Zwama Yesu ui eag cigwama na bulabe cina ciza ihogu. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Zwama haruni buzi kuce cagagu aco baniya na tunohun kanmu buna bu kurya ciyabu na Hwinsu, zwama buyiwa hal abadan hinda bu i roko madadi waba.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Yesu asa Bulabe bu iginga gaci gimbo-zwama busa bu nagu u ciri, hinda buza nagu kamahinda, nagu ciri, a zaciga bware na aco magwata̱, hinda a pan bware izangacu na cigwama ci Hwinsu. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Bware bwe nyaganuwa na acagiya alabe a iginga, bware bu za bukata u i sadaka tunohun, zwama acagiya alabe ayiwa na eag haruni zwama a guzagi ciri maba kapi aba pan sadaka zwama iguzagu i ciri aco. Yesu bu pan icwa yaba so uinka. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Zwama na icibago i Musa ai zaciga buco buinka na ciri; Ama kucuna ku Hwinsu ub i, wa kurya nga Musa wa riganu ci icibago, ama na kucuna aba san bware buna bu sinji hinda buza ihigu.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Yesu asa bulabe bulabe</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Manupa ma cikarigo aciya cisa zi bulabe bulabe bu iginga ina iyiwa na wa cuga u na cigwama ci Hwinsu cina ciza ihogu na zaro, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Bulabe bu iginga ini iyiwa na eag ibwana i Hwinsi na ihuga ina iza ciri, na tenti u kamahinda una Hwinsu na icwa yoba uba i sa buma.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Ti bumba bulabe sa tanga bo zwama i pano i sadaka u umoga, hinda bulabe bulabe buba ma bui hyan ina buba bui pan sadaka. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Si bu yiwa na doone buza isana bulabe bu iginga ko cimu, si azi acagiya alabe a iginga ana ai cutan-ipanganu na icibagu i Musa <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Piristi aniya ayiwa na eag ibwana i Hwinsu na ihuga ina iza ciri una u nyaga na ina aba yiwa na cigwama ci Hwinsu Zwama huna Musa uba ui eag okaba u a̱hunda a Hwinsu, ube usayiwa na sana buco cik suwa aco bu sana bulabe bu iginga zwama buba pan ipangano-dinya na sadaka, zwama habuni u sana dole pa Bulabe bu iginga nuciya bu hyan ina uba ui cutayiwa na sana buco cik suwa aco bu sana bulabe bu iginga zwama buba pan ipangano-dinyiya na sadaka, zwama habuni u sana dole pa Bulabe bu iginga nuciya bu hyan ina uba ui cutan a numi hacube ha Musa an huna uba ka̱ri ia̠ga Hwinsu yaba ahunda, bu tabaci bu i tiba inga aba cibai na i'ogo i labe.&gt;&gt; <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ama baniya a pan Yesu ibwana i bulabe bu iginga ina i zake yaba, una Yesu ube usana buco buna buyiwa na usa Hwinsu na uwuma. Nga̱ kucuna kuna Hwinsu ube ili tsakanini bware na aco uba usa u burya̠, zwama usa na kucuna ku ina gyamace. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Si kucuna ku jigu wasa hacigaguwa, aza saka eaga kucuna lagiyo. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Ama Hwinsu u hyan magwata̠ ma aco kwa uba na hin,</para>
  <para style="q1" vid="HEB 8:8">&lt;&lt;Hun u yiwa na kurwo, Hwinsu u hin,</para>
  <para style="q2" vid="HEB 8:8">lokaci una gya ni eag hinda kucuna</para>
  <para style="q1" vid="HEB 8:8">ni yaba a aco Isara'ila</para>
  <para style="q2" vid="HEB 8:8">hinda na yaba u Yahuda.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Uza sanakana inga kucuna</para>
  <para style="q2" vid="HEB 8:9">una gya na eag na jigu na hacaca nubuya</para>
  <para style="q1" vid="HEB 8:9">huna gya na zangiga na wa</para>
  <para style="q2" vid="HEB 8:9">zwama gya silacume ga daga cinge ci Masar,</para>
  <para style="q1" vid="HEB 8:9">zwama ai laganuwa kucuna numuya,</para>
  <para style="q2" vid="HEB 8:9">hinda kwa gya na pana ga kacutu,</para>
  <para style="q4" vid="HEB 8:9">Hwinsu u hyin.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Hwinsu hin, kucuna kuna gya ni ea na aco Isra'ila</para>
  <para style="q2" vid="HEB 8:10">ni ihogu i ini, Hwinsu u hyin.</para>
  <para style="q1" vid="HEB 8:10">Ni tana icibago numui na suwa wab</para>
  <para style="q2" vid="HEB 8:10">hinda gya rubuci unwa na soo wab.</para>
  <para style="q1" vid="HEB 8:10">Nisana Hwinsu u waba,</para>
  <para style="q2" vid="HEB 8:10">Hinda ai sana aco numui.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Aza buna bu cibago buco buna bu yiwa ciyabo naba,</para>
  <para style="q2" vid="HEB 8:11">ko hinda buco bu cibe buhun abuba, zwama,</para>
  <para style="q1" vid="HEB 8:11">ai daki Hwinsu,</para>
  <para style="q2" vid="HEB 8:11">ai rwaga na nuya pa labe.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Zwama na curgagya ga magwata̱ maba</para>
  <para style="q2" vid="HEB 8:12">hinda na za na mabutaryagya na magwata maba hinda.&gt;&gt;<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Nga Hwinsu uba i kucagiya kucuna, Hwinsu kwa buba na maisi kuna ku jigu kusanya ku gose; kuna ku gose kuza isanakan na kuce.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Ipaganu Hwinsu cilabe na zaro na doone</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Baniya kucuna ku jigu uza dokoki na ipanganu Hwinsu cilabe kanmu na ihuga ina iza ciri na doone uni. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />A ea uzak, una uza ukaba una u jigu aza ina aba sa jukai Acibalbal, na Tebur na Burodi una aba sa cuta Hwinsu; una aba ogo ihuga ina iza ciri. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Na kacuta labule a lagi aza uzako una aba ogo ihuga ina iza ciri. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />na ukaba uni uza amama an aba ia̠gi na zinariya apayi aba cubagu tulare ula na akwati a alkawali an aba kubtaga na zinariya. Ini birya a eagi ga na zinariya, na suwa aza agungu Haruna ana ayiwa na putage habunba na hatare harya han aba hinlage cikarigo ci Musa na soo. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Zata u akwati aza mukwacukwacu muna muza hababu hana ha cibe cizangacu ci Hwinsu, una u pan uhuruhuru ihuga ina aba ogo ihuga ina i zangi alhaki a magwata. Ama baniya ciza i pwana i ea cikarigo dala-dala na cikarigo ciniyo. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />Harbuna aba shiri ini, alabe sa kore usala u ijapu tunhonba na uzaka, aba na eaga ibwana yaba. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Ama bulabe bu labe bube busa bu ese ukaba u suwa, hinda sa ese ihuga ini uikan na uya. Bui zangi mahya man buba bui cuta Hwinsu zwama magwata ma buba na man ma aco aba ea na nagu u cidaka. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Harbuni ahuru a Hwinsu aba sa cibe na yina na ese ihuga ina i zake na nagu ciri ai sa gojewa sa ukaba u jigu sa u sa yinsa. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Uni usa kwatanci u hon una gaci ci yiwa, una u cibe na i pano hasadaka han aba panga ui jubuwa i san suwa u buna bu yiwa pan Hwinsu cilabe u sinji. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Nga̱ uba sa cikarigo ci ire mare na ciso na lago u iguzagu dinya. Ini ka̱mu isa doka ui ijapu-kwa hinda Hwinsu u silacume i ipu.<verse eid="HEB 9:10" /></para>
  <para style="s">Wahala una u Yesu aba soo zwama i zangu magwata maci</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Ama Kristi a rigyano a kurwa nga̠ bulabe bu iginga bu burya̠ bu hinda bu ia̠ ina i yiwa a pini, hinda bu ese ukaba ina i zake na moso sa buco bube bu ma na siwa, ui nyaganuwa na i doone una. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Nga̠ Kristi aba ese ukaba uni iso uikan pa ihuga ina i zake na nagu ciri; bui esewa na mahyan ma na Biya Ina zwama bu cuta sadaka, kwa di, Bware bu zangi mahyan ma buba zwama bu ci hyangiyo icagago ina iza ihogu. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Nga icibago i Musa ciba hin, mahya ma Muyaya na man ma Ina na mucwa mu Munana muna aba hunkacumi musa mu ringe aco ana za ciri ama ringiya nagu u ciri na ikanga. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Sa uni usa kamahinda, beya gaci ci hin na mahya ma Kristi, ana pa a̱huru ana aza ihogu a cuta icwa yaba sadaka pa Hwinsu. Mahyan ma Bware ma ci guzaga hasuwa a haci ci san na nagu ciri nga̱ gaci ci curya al'ada an ai jidanuwa ihya hinda ai ci kula pa u'o, zwama ci laga Hwinsu una wa kwadago. <verse eid="HEB 9:14" /><verse number="15" style="v" sid="HEB 9:15" />Ube u san Kristi abe ai yinsana na usa wa aco na Hwinsu na alkawali a pu, zwama aco Hwinsu uba uga a ce akawali an a za ihogu an aba eagi alkawali aba-uni ai ea zwama aza u'o una aba iri una ui san a curi buco daje pa iwo na bua ea tun lokaci u alkawali a jigu aba na ibwana. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Sa buco bu i alkawali a gajo u buba, u kamace bu cibe na lalai buna bua ea alkawali bu kwajo, <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />zwama alkawali a u'o ai jidanuwa ihya; zwama ai pangana on sa buco bui kwajuwo. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Ube u san alkawali a jigu ai jidano wahya kwa na mahya. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Na jigu, nga Musa uba zwama aco cikarigo nga ciba yiwa na icibago i Musa, u zangi mahya ma alaki na Muyanyan, a hitagi na miya kwa na zangi cihinji ci sane ci hatami kwa na basan mahya zata utakada u cikarego ci Musa na zata na aco kanmu. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Bu hin, &lt;&lt;Mahya man ma cibe alkawali una u Hwinsu uba hyen na laga.&gt;&gt; <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Harbuni hinda, Musa uba basinga mahya na ukaba na icwana ka̠mu ina aba ea ampani na ba pa i ipano i Hwinsu cilabe. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Kamahinda, icibago i Musa sa guzagi tibai na mahya, hinda ai curigagya aco magwata kawai sa a jigi mahya. <verse eid="HEB 9:22" /><verse number="23" style="v" sid="HEB 9:23" />Ini isa dole a ia̠ harbuni zwama i guzagi, ama i zaro i ginbo i guzagu ina i zake haruni gama. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Zwama Kristi a kuruwa ihuga ina iza ciri ina buwama bube bu ma ana nya̠ga na buna bu kamahinda; Bware bu ese zaro, zwama bu kore pa Hwinsu zwama ga̠ci. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Bulabe bu labe bu hayahudawa busa bu ese ihuga ina i zake na nagu ciri tunba uya na mahya ma muyaya, ama Kristi ai esowa zwama a pan icwa ya ba dinya. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Si wa sa harbuni Kristi ai hoge wahala tunba hon buni, tun hon na aba ea doone. Ama baniya bu sere cikan zwama bu zangaci magwata̱ pa i pano i icwa yaba a hone Bware. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Nga tiganba bui kwaji ci ikan, hinda ban na uni kwa shara'a si Hwinsu, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />harbuni hinda Kristi a cuta icwa yaba sadaka ci kan zwama bu zangi magwata̱ ma aco dinyiya; hinda bui maringe korwo u lagi, sa zwama bu hone magwata̱ aco ama a kuleya icagago aco na ginbo Bware.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">Kristi a pa icwa yaba sadaka zwama aco ka̱mu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Icibago i Musa usa kwatanci u ina gyamace hana hayiwa na gaba-una ui sawa u burya̠. Zwama haruni ube sa burya̠ mu aco na ka burya̠ kure ciyabu na Hwinsu ai sinjuwa zwama sadaka zwama a guzagi ciri maba pa aco na ka̠ri pan Hwinsu izangaci. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Sa aco ni yiwa ni pan Hwinsu cilabe si lalle a guzagiga pa magwata̱ maba, aza hugi munnya hinda aza panakana sadaka. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />ama hasadaka hani haba iri usa buturagu i magwata̱ tuhumba uyah, <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />zwama mahin ma icuri bina na mahin ma muyaya maza ipwana guzaga magwata̱.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Zwama haruni, inga Kristi uba kanro u kure na doone, bware bu hin na Hwinsu:</para>
  <para style="q1" vid="HEB 10:5">&lt;&lt;Bwa ka̱ruwo ipangano sadaka u daje,</para>
  <para style="q2" vid="HEB 10:5">ama bu kimga ikanga zwama gyamui;<verse eid="HEB 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 10:6" />na ipanganu i sadaka na iguzagu i magwata̱</para>
  <para style="q2" vid="HEB 10:6">bwa hugaguwa laco.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Kwa gya na hin, na &lt;Gyamuya buna- na ginbo ea ibwana nebo Hwinsu-inga aba rubuci na cikarigo-ci Hwinsu-</para>
  <para style="q2" vid="HEB 10:7">Na kurya zwama gya eag ibwana nubuya oh Hwinsu.&gt; &gt;&gt;<verse eid="HEB 10:7" /></para>
  <para style="m" />
  <para style="q2">
    <verse number="8" style="v" sid="HEB 10:8" />Na jigu bu hin, &lt;&lt;Sadaka na ipanganu, na sadaka mana aba na tana ula na, usadaka u ciguzagu u magwata̱ sam Bwa ka̱ruwo&gt;&gt; (ka̱mu na ama icibago i Musa u ka̱ri ini ka̱mu. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Kwa buba na hyin, &lt;&lt;Gyamuya buna, Na kurya zwama gya i ina goo bu kari gya eag.&gt;&gt; Bu tanga bu jigu bu sana buna bu lagi. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Zwama Yesu aba i ina Hwinsu uba hin ana a eagi, gaci sana aco nagu ciri zwama sadaka una Kristi uba pan ikanga yaba u sadaka mana maza ihogu ma aco ka̱mu.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Tun nahun bulabe bu hayahudawa bu pan sadaka;ama sadaka uni uza i zanga magwata̱. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Ama nga Kristi uba pan sadaka ma ikanga yaba mana ma yiwa hal ihogu zwama magwata̱ ma aco kwa buba na madale na wa cuga u Hwinsu na izangacu. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Bware buyiwa na a̱pe a tana a'usa a bware ana a i ka̱ruwo bwa imiya na buna bware zwama buba punjiga, <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Zwama sadaka uni uinka Bware bu san aco na aba ai guzagu ga a sanya aco nagu ciri mana maza ihogu. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Zwama a̱huru a burya̠ a i sheda nuci. Na jigu u hin:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />Hwinsu u hin, &lt;&lt;Una usa kucuna mana ma gya na ba</para>
  <para style="q2" vid="HEB 10:16">na haya han ha yiwa na koro.</para>
  <para style="q1" vid="HEB 10:16">Ni tana icibago numuya na soo wab</para>
  <para style="q2" vid="HEB 10:16">hinda na rubuci na soo wab.&gt;&gt;<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Kwa bware na hin:</para>
  <para style="q1" vid="HEB 10:17">&lt;&lt;magwat mab na dala ciri maba</para>
  <para style="q2" vid="HEB 10:17">Na za mabutiryagya hal ihogu.&gt;&gt;<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Si a curgagya buco magwata̱ maba uza na gimbo u sadaka.<verse eid="HEB 10:18" /></para>
  <para style="s">Ci kure ciyabu na Hwinsu</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Zwama haruni, hun namui alagano Hwinsu, ciza iyajo ana ci ise ihuga ina i zake na nagu ciri zwama u'o u Yesu, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Yesu hinda bube bu ci gunja yina, yina u a̱huru ana aza ihogu, zwama labule u iginga, wato ikanga ibuba, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Hinda ciza Bulabe bu iginga buna buyiwa na cigwama ci aco Hwinsu, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Zwama haruni ci kurya ciyabu na Hwinsu na soo u kamahinda na isinju itano soo ko ni iwasa ci kurya pa Hwinsu na suwa mana aba guzagu pa wumba̱ magwata̱ na ikanga mana aba guzagu na miya ma burya̠. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Ci yisa na itano soo na koce nuciya, zwama buna bu gaci tani soo busa buco bu sinji cikarigo ciba. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Ci byanija sicwa asici zwama gaci ci pan sicwa asici kuce hinda ci cebe maka̠la̠ ci i ibwana i burya̠. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Ci ta curya itanagano i alagano Hwinsu inga acagiya aba curya ama ci i cikarigo ci pangano koce musama bani nga̱ uringuwo u Bugwama Yesu u yabta.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Aza sadaka si ci i magwata̱ na idakago nuci nga̠ ga̠ci ci hyan idakagu i kamahinda. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Ama na haruni, kwa di a̱pe na iwasa i gunju hukunci na ula mana ma sungola dinya mana mai hogu re aco na ai ka̱ruwo Hwinsu. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Ka̱mu buna bu wunje icibago i Musa ai hune bo ko yama si di a hyin aco barya ko tato a pan sheda. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Ka̱mu buna bu yagage Bwa bu Hwinsu hinda bu yagage mahyin mana buba jigi zwama ci san na nagu ciri nuci bu i zargi u a̱huru a burya̠ na i burya̠ Hwinsu! umba hukunci i yiwa na tsammani ugyamaci a gunji buco buni? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Zwama ci daki buna bu hin, &lt;&lt;Na ma cupa, gya hinda ni ma cupa.&gt;&gt; hinda bu gupa hin, Bugwama bu doone bui gunji hukunci u aco Bware.&gt;&gt; <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Uza iwasa buco bu ise wa Hwinsu. <verse eid="HEB 10:31" /><verse number="32" style="v" sid="HEB 10:32" />Mabuturyagya hunna ganhi hyan ihyanagu cigero u Hwinsu, i yisa na kuce, iyiwa na darya na sungoro ama i sanuwa ga̱hin maginje. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Icagiya hun ayiwa nibu pangan wahala na hisa aco hinda na panganu wahala ni sinu si aco; icagiya hun i yiwa na ia̱ga dala na aco na yiwa na so iri sungorwo ni. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Zwama i cuta yama pa aco na yiwa na yaba ci'incu hinda i cuta soo cine huna aba cagaga icwana nihi zwama i daki ana izi malaki ma burya̠ mana maza ihogu.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />Zwama haruni ita kwamana itano soo nihi zwama ui kulagaga daje. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />U kamaci ga̱hi hinsa na kuce, zwama na haruni ga̱hi i ea ina Hwinsu uba ka̱nri, bayan haruni i ca ina aba ia̠gya ga alkawali. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Zwama cikarigo ci Hwinsu ci hin,</para>
  <para style="q1" vid="HEB 10:37">&lt;&lt;Sa na isonu, Bube buna bu yiwa na kure bui kure hinda buza hacigaga lokaci.<verse eid="HEB 10:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="HEB 10:38" />Ama aco numui a nagu ciri ai hyan a̱huru ana aza ihogu zwama itano soo iba.</para>
  <para style="q1" vid="HEB 10:38">Ama si a maringe kacuta,</para>
  <para style="q2" vid="HEB 10:38">Na za hogi laco na buba.&gt;&gt;<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Ama gaci ci sa nga̠ aco na maringe kacuta a kwaji, ama aco na aza itano soo hinda ai cagaga ga.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Itano soo</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Bane, Itano i soo i sa ina go bu daki na i ea, i yajo na ina go bui hyanuwo. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Pa itano i soo aco jigu Hwinsu uba yabe ga. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Pa itano i soo gaci daki na doone Hwinsu ube u eagi, na ina gaci hyanagu na ina gaci ci hyanuwo. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />Itano i soo ibe i san Habila a pan Hwinsu sadaka u burya̠ una u zake u Kayinu gama. Zwama itano i soo a rubi bware busa buco bu burya̠ , zwama Hwinsu u yaje na daje u bware. Zwama itano i soo ko nga̱ Habila hab kwaji ama ayiwa na eaga cikarigo. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Itano i soo i Enok ibe i san bware bui kwajuwo, a zangaci bware kurwo u zaro pa Hwinsu. Cikarigo ci Hwinsu ci hn, kapi a zangi bware kurwo u zaro bu ea ina Hwinsu u yaje na bware. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Aza buna bui Hwinsu uba ui hoge laco na buba sa buza itano i soo, zwama buna bu ginbo i kure pa Hwinsu dole bu daki na Hwinsu u yiwa hinda ui pan bo daje aco na ginbage own. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Zwama itano i soo Nuhu, nga̱ Hwinsu uba numi bware hacube na ina i eaga na mohon muna mu yiwa na korwo ina bware buba bui hyanuwo. Bware bu yaje na cikarigo ci Hwinsu kwa na eaga Jirigi u miya una buba bui ese na saawo si buba zwama a ma cagage. doone ka̱mu u yaje na bware hinda Nuhu a sa buco buna bu gaje i burya̠ zwama itano i soo. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />Zwama itano i soo Ibrahim, iba laga cikarigo ci Hwinsu nga̱ uba uga bware kurwo u cinge cina ci Hwinsu ia̠gi bware alkawali na ui pan bware, bware bu curi cinge ci buba kurwo ihuga ina buba bui dakuwo. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Zwama itano i soo bware bu madale nga unyagata na cinge; bu madale na Hazako nga Ishaku na Yakub, an ce alkawali ana a nyaga na an a bware. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Zwama Ibrahim i a̱pan i'ogo ina Hwinsu uba mage bware, ina Hwinsu ube hinda usa u ma gya. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Itano i suwa ibe i san Ibrahim, mace bwa ko inga iba i onge- na Isera iba ma i za pwana i mace bwa- ama bu yaje na Hwinsu hal u sinji alkawali u ba. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Ko nga̱ uba sa Ibrahim i kwaji, pa buco buni buika a hin sizwaga dinya nga̱ muginga mu zaro, nga̱ hega ha wo una bui pwanuwa irutaga. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />Na itano i soo aco ni ka̱mu aba kwaji. Ai cewa ini ka̱mu na Hwinsu uba ea alkawali; a biskai gya ahwayi cimere aba ce. A yaje na asa hanyagata na aco cinge ciyi. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Aco na zwame haruni a cibe na a yiwa na ginbo u cinge caba. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />A curiwo tunane u cinge caba a curi, ai hyan damaab a maringe. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Maimako, a yanse na ginbo u cinge cina ci gyamace-cina zaro. Ban na haruni Hwinsu u za na hoge muyan aba ai ugan na usa waba, zwama u kimgano i'ogo i labe ini iyiwa ni zaro. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Usa zwama itano i suwa Ibrahim ibazangi bwa bwe ba Ishaku sadaka nga̱ Hwinsu uba gwaji bware. Ibrahim ibe Hwinsu uba eagi alkawali, ama kanmu na haruni bware bu ea shiri zwama bu pa bwa bu bware sadaka. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />ko nga̱ Hwinsu uba hin na bware, &lt;&lt;Pa Ishaku gya gya ni pan azwaga dinya.&gt;&gt; <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Ibrahin a tunane na Hwinsu ui pwan asenga Ishaku pa aco a kwajo-kamahinda ma u cebe na Ibrahim i ce Ishaku pa aco kwajo. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Zwama itano i suwa Ishaku i ia̠gi saawo si bware Yakub na Isuwa alkawali itano i uno u burya̠ na haya han ha yiwa na korwo. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Itano i soo, ibe i sa Yakub a tane saawo sa Yusuf uno u burya̠, kapi bware kwaji, Bware bu ma sidige a agungu a bware bu pa Hwinsu cilabe. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Zwama itano i soo Yusuf, nga̱ bware buba ka̱ri i kwaji, bu ea cikarigo ci wansengewa u aco Israila na Masar, hal bu zwama ga nga̱ aba ai eaga na ha'unpa ha bware. <verse eid="HEB 11:22" /><verse number="23" style="v" sid="HEB 11:23" />Zwama itano i soo ube u sa hacaca ha Musa hab swin bware hal pyana bitato nga̱ aba mace bware, zwama a hyan nga̱ bui sa bu kanmuiyo inga aba hyan bu gyamace, hinda ai huguwa iwasa i cikarigo ci bugwama. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Pa itano i soo Musa, nga bware buba monse,bu wonje a uga bo bwa bu bwa bu cu'a bu pir'auna. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Bu tanga bu hoge a shungule bo zwama Hwinsu na una buba bui hoge lacu u magwata̱ na lokaci cimu. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Zwama bu tane haisapa daje una u yiwa na koro bu hin wahala una aba pan bware zwama Kristi u zake izana na Masar. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Itano i soo ibe i san Musa uba curi Masar, sa tare na ihogo iwasa i ubobo soo u bugwama; bu i suwa zwama bu hyan buna aza buna bu pa i ihyan bo. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />zwama itano i soo Musa urwage ea lago ui kacikago hal buba hin a basga mahyan na mu'iba, nga̱ acuma a Hwinsu aba za i hone saawo si jigu sa Israila. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Itano i soo ibe isan saawo sa Israila siba kace uwo u sane nga aba ea cihano na cinge cina ci hoye; ama nga̱ Hamasarawa aba ka̱ri ea inga aba ea, miyah ma kubta ga ka̱mu. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Itano i suwabe i san habwaga ha i'ogo i Yeriko hab hene nga̱ aco Israila aba rigi i'og hal moho utandarya. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Itano i soo ibe i san Akaruwa Rahab, aba cagage an aco na a wonje i lagana cikarigo ci Hwinsu, zwama a ce aco na a kore i ringaga i'og. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />Baiya gya na jidana i hin? Ali na ea cikarigo ci Gidiyon, na Barak, na Samsin, na Yefta, na Dauda, na Samaila na Acuma, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Zwama itano i suwa a ea gasa na cigwama ka̱mu ama a ea nasara, a ea ina isa burya̠, a ce ina Hwinsu uba ea alkawali; a kubta uno u Sizaki, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />a hone ula una u yiwa na gariga, a nyage ihono na kasakari; ai hugo koce ama a hin koce; a a̱nce musoja mu cinge ci hanyagata. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Zwama itano i soo si'a si ce sare siba sina aba hunage ama a ma renge nga ai kwajuwo. acagiya a wonje a curi ga, a kwaji zwama wahala zwama a tanga a masinge ga yina ana a zake gama. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />A same cage aco na i supagu na sigungu, acage hinda a pare ga kwa na tana na ukaba u ci'incu. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />A bwage ga na hatare; a cabi ga cirya na zarto; a hone ga na kasakari. A hina cihano na hataka ha Hadwumaga na han ha Muyaya, a ma dale na nagu, na wahala na maya. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Hal ma doone ui jubuwa a ma dale noba. A a̱nge na cinge cina hoye na mu'ogo na habanda na hahanbi na cinge, a nyaga nga̱ aco munda mu gasa <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />Uni ka̱mu Hwinsu u pan ga u sa seda iyabo yaba zwama itano i soo waba, ka̱mu na haruni aza buna bu ce ina Hwinsu uba eagi ga alkawali. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Zwama Hwinsu u ci eagi shiri u ina zake na gama ina uba ginbo a kole pa isinju sa tare na gaci.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Hwinsu buca a buci</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Zwama haruni, nga gaci za hasheda hana ha ci ringo gaci dinya, ci zaciga kanmu ina za ci curi na ka̱mu magwata̱ mana ci kumgage na-kuce ga ci i munda itano isoo muna aba tana na sinu. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Ci i haruna na itano haisa pa Yesu, ana itanu soo nuci isa pa buba na buna bui ci sinji itano suwa niciya. Zwama wa̱wo mana aba tan pa bware bu so wahala na u'o mucu, bu ringya i mun'inya ma sana ko na ihya, bani hinda bu yiwa na dala na wa cuga na cigwama ci Hwinsu. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Mabuturyagya na buco buni buna buba so wahala bu ka̱ruwo aco na ai ka̱ruwo bo nga aco magwata̱ a cibe bo, zwama ita dama hinda ita zaciga soo nuhin. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Na kokari i curiwo magwata̱, bui si iwo ina gangi i silacume hasoo na jigu mahya nibui. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Ko hinda i ma'inga na cikarigo ci panu ikuce mana Hwinsu uba i na ga̱hin inga soo siba:</para>
  <para style="q1" vid="HEB 12:5">&lt;&lt;Bwa bumui, ita zanga icibago Hwinsu sa na kuce,</para>
  <para style="q2" vid="HEB 12:5">hinda ta zaciga soo nibui si Hwinsu uba cibaga.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Zwama Hwinsu iyiwa na pana horo pa aco na buba ka̱ri,</para>
  <para style="q2" vid="HEB 12:6">hinda bu pan ka̱mu buna buba yiwa na ugan bwa buba.&gt;&gt;<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Yinsa na kuce na so wahala, Hwinsu na poro; nga̱ saawo si bo, gamba bu za bwa buna buba pan bo horo? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Si ai bu panuwa horo hinda tigamba yiwa na ca horo, nga̱ saawo si Hwinsu si yiwa n ma'ana ai sawa saawo si Hwinsu ama ana aza Buca. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Nga gaci yiwa na pangan buco abuci na doone buna yiwa na ci pangan horo. Ashe, ciza iyajo na Buco bu a̱huru abuci, zwama ga̱ci hin a̱huru ana aza ihogu. <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Buca abuco buyiwa na ci pangana horo na lokaci cimu hinda a hyan u gyamaci; ama Hwinsu yiwa na ci pangana horo, zwama gaci hyan rabo niciya na nagu ciri. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Na suwa u horwo ci yiwa na hugi sungoro sa laco ama si ci hogi ci hyan daje u horo ana ai ci pan ga ikimgano dala burya̠.<verse eid="HEB 12:11" /></para>
  <para style="s">Inumu hacube na Umurni</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Zwama haruni, dandaje wa nuhin man ma nube ana aza kuce. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />&lt;&lt;Danda hayina zwama habuna nuhin,&gt;&gt; zwama aco na asa hagunu na ana azi mahuna na buna zwama ata hina ama a hyan kuci. <verse eid="HEB 12:13" /><verse number="14" style="v" sid="HEB 12:14" />Eag kokari ganhini dala burya̠ natigamba na dala a nagu cirya; zwama aza buna bui hyan Hwinsu kwa busa buco bu nagu cirya. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Ea kula na sicwa asihin zwama ata hyan buna b ringya kacutu zwama buta nagi i burya̠ Hwinsu, ia̱ kula zwama ata hyan buna bui nyaga nga̱ imata i'oana ai lacumuwa hinda na sana mahuna na imataiba. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Ia̱ kula zwama ata hyan ciki nuhin buna bui ea magwata ma cidan ko hinda na dala a ciri hal bu sana nga̱ Isuwa, buna bu sangi gajo waba kanmu mana ma bwa bu labe bu yaba zwama imat inka ma mare. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Na jigu, nga̱ ga̱hi daki, hun na bu ka̱ri ce gajo u unu u burya̠ u buco buba, kwa aba na wonje bware. Bware bwa hinwo zarapi mana ma buba bui kinga magwata ma bware, ka̱mu na haruni bu byange unu u burya̠ u buba na maisa. <verse eid="HEB 12:17" /><verse number="18" style="v" sid="HEB 12:18" />Ya kurya i'ogo i Sinai ana ga̱hi pa danga hinda na re ula; ko ihugu i ci'incu, koyiru sila nga̱ ha Isra'ila aba i na i'ogo i sinai. <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />Zwama a huge bicwaro bi inigwa na laco na bicwaro bi wasa dinyiya hal ma a une Hwinsu ana uta ia̠kana cikarigo na ba hinda zwama a hugi wasa dinya, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />zwama aza pana kana yinsan na kuce na umurni ana hyin, &lt;&lt;Si nama dangi i'ogo ini, ai hune unwa na atare dole.&gt;&gt; <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Ihuga ni hinda i sinji na wasa dinyiya hal Musa bu huge wasa bu hin na Hwinsu, Na yiya na huge wasa dinyiya.&gt;&gt; <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Ama i kurya̱ pa i'ogo i Sinai i Labe, na i'ogo i Hwinsu uba yiwa na acuma a Hwinsu dubu mana ma hal ihogu, i kurya̱ Urshalima . <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />I kurya̱ pa itanaganu i alagano Hwinsu ana asa saawo si cware, ana a rubuci ize yaba na yaba cigwama ci Hwinsu. I kurya̱ pa Hwinsu buna busa bu igundagu i cikarigo ci aco ka̱mu, na a̱huru aco na asa aco nagu ciri. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />I kurya pa Yesu, buna bu cibe acagiya kucuna madadi Hwinsu na aco bware ka̱mu namahin mace mana aba hala mana ayiwa na ia̠g cikarigo ci burya̠ mana ma zake mahya ma Habila.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Masikai, zwama ita wanje buna bu i cikarigo. I daki ana aco na wanje Buco buna bu nume ga hacube na doone na aza, icago hal ma gaci, si ci pan kucutu nuci pa Buna bu i cikarigo daga zaro? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Hunni bicwaro san iwasa bi san doone hal mabicari ka̱mu na jimui kanwui ama hal zaro. <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Cikarigo cini cisa, &lt;&lt;so uinka̠ hinda&gt;&gt; u cibe ana ai zwama ina za ma juma i yinsan.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Zwama haruni, nga̠ ga̱ci yiwa na ce Cigwama cina ciza i jumui, u gyamaci ga̠ci gojo Hwinsu hinda ci i ina Hwinsu uba ka̱ri na ipanganu i cilabe cina ci gyamaci na dandaro i ikanga na wasa. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Zwama Hwinsu nuciya usa ula una ui re i ka̱mu.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Inga aba ea hugya Hwinsu laco</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Kunba je na maka̠la̠nga nga̱ alagano a Yesu. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />I ma buturyagi na eagya hanyagata iri burya̠ na yaba nihin, zwama aza aco na a eagi acuma Hwinsu i burya̠ na yaba ya ba na nagu u cidaka. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />ima buturyagya na aco na aba pare na ukaba u cu'incu, zanga je nga̱ i yiwa tare na ba, mabutaryage na aco na yiwa na so wahala nga̱ ga̱hi i yiwa na so wahala. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Cigya ci 'bu'a na bware na ihuga i malabo ci sa na nagu u ciri, cigya ci sa ina aba ai pan cilabe, Sare na si'a a pa sicwa saba cilabe, zwama Hwinsu ui ia̠gya aco ibwana i cidana shara'a na aco ciri. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Mirhya je pa maka̠la̠ ma musare hinda ea hankuri na ina go bu za, Hwinsu u hin,</para>
  <para style="q1" vid="HEB 13:5">&lt;&lt;Na za na bu cure;</para>
  <para style="q2" vid="HEB 13:5">na za na bu gipa</para>
  <para style="q2" vid="HEB 13:5">ko cimu.&gt;&gt; <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Ube u san sa tare na shaka, ci hin,</para>
  <para style="q1" vid="HEB 13:6">&lt;&lt;Hwinsu usa bubanganu a bumui;</para>
  <para style="q2" vid="HEB 13:6">na za ihoge iwasa. Beya buco buba bui na ia̠gya?&gt;&gt;<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ita ma ingana na alabe nahin an ai cibage cikarigo ci Hwinsu. Byana je cihano ci iri dala cina aba ia̠ na nga̱ aba kwaji, lagana je iri itano i soo waba i laga. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yesu Kristi aza u sako uho nawuya na una uza ihogu. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Ita yada hanyagata ha icibago ui zangaci hasuwa hahin pa yina a burya̠ . U kamace ci hin koce u soo pa yama i Hwinsu, sa ilagano zwama u mare, una u za ampani pa aco na a ryago mare. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Alabe labe an a yiwa muginga mu Hayahudawa aza re ina aba pan sadaka amama a iginga Hwinsu. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Bulabe bu labe bu hayahudawa busa bu kore na mahya ma hamuga na ihuga ina i zake na nagu ciri zwama bu cuta sadaka zwama magwata, ama hakanga hab a hunkacumi na ijapu ihuga i tanaganu. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Harbuni hinda Kristi a kwaji na ijapu i i'ogo zwama buba ci san aco nagu ciri na mahya ma bware. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Zwama haruni, ci sere, na ijapu ihuga i tanaganu, ci hoge muya muna mu bware buba so. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Zwama ci za i'ogo na cinge, ina i sa i dala ana a za ihogu ama ci yiwa na byangana i'ogo ina i yiwa na korwo. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Curya baniya, ci hina i pangana sadaka u i zangacu korwo pa Hwinsu na iziya i Kristi una ga̱ci ci pa na sunbi nici ina i zwamage na Kristi asa Hwinsu. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Ita ma'ingana na ia̠gu i burya̠ korwo pa cagiya aco, zwama iri sadaka una Hwinsu uba ginbo buni. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />Lagana je aco na kumgage mudalo mu labe hinda cuta sicwa a sihin ibwana yaba. Abe yiwa na a̱pe nuhin gita na hwinsu zwama ai pan Hwinsu iri ibwana ina aba ai ia̠gi. Sa i laga ga ai hoge laco u ibwana yaba hal a ia̠ na soo u cene, sa i ia̠ wo harbuni, ai ia̠ga ibwana ini na soo u hacigage, uni uza na i taimaka. <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />Ci ia̱gi je ahunda̱. Ci daki ha soo a haci hai damuwa zwama magwata̱ hya, ina ga̱ci ginbo ci ia̱ ina kamaci tuhonba. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Hinda na yiwa na i una na koce i ia̱ ahunda̱ korwo pa Hwinsu nga̱ gya na maringya a pahin sa na i sanu.<verse eid="HEB 13:19" /></para>
  <para style="s">Ahunda̱</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Hwinsu u wasinsege Yesu Buca a buci pa aco a kwaji, an asa buhubanu bu labe bu hatami hana na mahya ma haba, man alkawali ana aza ihogu aba gunda,<verse eid="HEB 13:20" /></para>
  <para style="s">Cikarigo ci kundaga</para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 13:21" />Hwinsu u dala a burya̠ ui pan tebai burya̠ ina ga̠hi ginbo nga ga̠hi i ina uba ginbo i ia̱, u san u ea ina ga̱ci ginbo na ga̱ci zwama iziya i Kristi Yesu, hinda izangacu na cilabe ci san ci Kristi ina iza ihogu! Harbuni. <verse eid="HEB 13:21" /><verse number="22" style="v" sid="HEB 13:22" />Ahun namui, na yiwa na ona i labte soo na icibago nimui, zwama u wasika una gya na rubuci ui zangaruwo. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Na ginbo i daki na buhun a buci Timotia silacumo bware na ukaba u ci'incu. Sa bware bu za i sana bui kore, na laga bware zwama i hyan. <verse eid="HEB 13:23" /><verse number="24" style="v" sid="HEB 13:24" />Bunga ka̠mu aco labe nahin na aco Hwinsu. Alagano na yiwa na Italiya ai bungago. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />I burya̠ i Hwinsu i yan na ga̠hi ka̠mu.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>