<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Alkitab Bahasa Ambai</book>
  <para style="h">Kaiwo Riwangsoai</para>
  <para style="toc3">Kaiw.</para>
  <para style="toc2">Kaiwo Riwangsoai</para>
  <para style="toc1">Kaiwo Riwangsoai na Salomoi</para>
  <para style="mt1">Kaiwo Riwangsoai na Salomoi</para>
  <para style="is">Kaiwo Dedung</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">Kaiwo riwangsoai neo awiweai finina</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Kaiwo riwangsoai na Dauti antung Salomoi, mananu Israeli finina.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1Raj. 4:32</ref>.</char></note><verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Kaiwo riwangsoai ninai we fiata inontarai ambori sewai, tuti ambori sobu aunau,</para>
  <para style="q2" vid="PRO 1:2">kontaio tefu kaiwo werorongfo.<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Kaiwo riwangsoai ninai we esobu aunau ambori esawai,</para>
  <para style="q2" vid="PRO 1:3">tuti eminohi na mai, etoarahangnai tuti ewarami mai.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Na kaiwo riwangsoai ninai kontai, dohong inontarai mano wiro deitawang turura kahafoi ambori nungkamiei wewu tofong,</para>
  <para style="q2" vid="PRO 1:4">tuti inontarai sowaworuafoi ambori enetituai kariri neo maifo tuti deitawangnafo werorong.<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Na kaiwo yiwangsoi ninai, inontarai mano sewai kawurua we deitawang kariri ne maifoi ambori sewai nariai aha,</para>
  <para style="q2" vid="PRO 1:5">tuti inontarai mano tefu kaiwo werorongfo ambori sobu wiwiaingfo aha.<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />Na tonanane ambori deitawangno kaiwo riwangsoai, tuti kaiwo deinawi kaririai,</para>
  <para style="q2" vid="PRO 1:6">kontaio kaiwo aunau tuti netaweai na inontarai mano sewai.<verse eid="PRO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Roaso Yahwei tuti omi wei mani, reantenang we inontarai ewaitawang werorongfo,</para>
  <para style="q2" vid="PRO 1:7">wape inontarai mano webonggoifoi enerireu kaiwo aunaufo tuti awaifo.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Ayb. 28:28</ref>; Mzr. 111:10; <ref loc="PRO 9:10">Kaiw. 9:10</ref>.</char></note><verse eid="PRO 1:7" /></para>
  <para style="s">Kaiwo aunau we arikang waworu nesa</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Nehu arikang ne wau, bohong kariri kaiwo aunauo nemu dai deunauane,</para>
  <para style="q2" vid="PRO 1:8">tuti wiro kobu taramu we fio inamuai deinauaifo fanai.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Weo une kaiwo aunaufo mani toyario sapewi mampofa na numukamieiwai,</para>
  <para style="q2" vid="PRO 1:9">tuti toyario raori denteng na ramukanangwa.<verse eid="PRO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Nehu arikang ne wau, masino inontarai mano emaya we enari sasarifo ewawori wau we nari karira mani,</para>
  <para style="q2" vid="PRO 1:10">wiro roriasa fanai.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Masino emadu eteyo, “Ro ria amea, tatadiwa tuti tatamang we inontarai mano dana ninaifa ambori tawarami rikaoi.</para>
  <para style="q2" vid="PRO 1:11">Roma tatuati na katai adiwa we tawarami rikao inontarai mano dohong sarawa kahafoi, manta we tafaraise teraifa.<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Bento etarangte tatongsa, toyario raimeri songsa,</para>
  <para style="q2" vid="PRO 1:12">ene tarai denteng tuti sentenangfoi te, tatongsa toyari mano ebiari to kamirei fafo foi.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Tata ambori taha ene fianggeng wewonongfo,</para>
  <para style="q2" vid="PRO 1:13">ambori tane munune sefang na fio tatawarafo.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Roma ro ria amea kobi nemu ondene,</para>
  <para style="q2" vid="PRO 1:14">ambori fi tahamananawane tatatorai mai we mansiari-mansiari na tata.”<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Nehu arikang ne wau, wiro awemuwa daria inontarai tonana fosa fanai!</para>
  <para style="q2" vid="PRO 1:15">Ro waroi weru sa.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Weo eawemifo mito we neo karirafo,</para>
  <para style="q2" vid="PRO 1:16">tuti esahera we ewarami rika.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Romu mandoni dino waitepari tipari,</para>
  <para style="q2" vid="PRO 1:17">masino deti mano dapa waiteparifoi?<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Wape inontarai eharira fosa etapa waiteparifo etamang we ewarami rika mantaungsa,</para>
  <para style="q2" vid="PRO 1:18">tuti ene waiteparifo na mamunggasai miung bera mantaungsa.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Tonanaifa, inontarai mano sera we ra na niari neo karirafo mani,</para>
  <para style="q2" vid="PRO 1:19">ambori biaitai na mantauni nuaninufoi.<verse eid="PRO 1:19" /></para>
  <para style="s">Kaiwo aunau kariri awaifoi sahufo</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Awaifoi sahu na rawafui fiabai na rangfo,</para>
  <para style="q2" vid="PRO 1:20">tuti na katai inontarai bitoya efanduhisa nayafo, bibe deisaha ne kaiwofo.<note caller="-" style="x"><char style="xo" closed="false">1:20-21 </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">Kaiw. 8:1-3</ref>.</char></note><verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />I sahu na rahutu baba bendari borongfo,</para>
  <para style="q2" vid="PRO 1:21">tuti na katai mirising i medu deyo,<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“Inontarai mano wiro meteitawang turura kaha ne meaine!</para>
  <para style="q2" vid="PRO 1:22">Memaya we menayai mewebonggoi toninai pampangne?</para>
  <para style="q1" vid="PRO 1:22">Kidoni wori inontarai mano menemirirewa ne mea, mefotou menemirirewa ne,</para>
  <para style="q2" vid="PRO 1:22">tuti inontarai mano wiro memaya we aunau mea kahai, meteiaya we mewaitawangnai werorongfo ne?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Metaramio yau masino isua mea!</para>
  <para style="q1" vid="PRO 1:23">Yau ambori yeisaha enehurorongnei we mea,</para>
  <para style="q2" vid="PRO 1:23">tuti yeyo yeinau nehu yeitawangnai werorongne we mea.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Meteiaya yau na kutu isahu mea,</para>
  <para style="q2" vid="PRO 1:24">tuti wiro inontarai manei miaya we detioa kaha, na kutu isi warahune we mea,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />kontai, wiro metato nehu kaiwo aunau ne kaha,</para>
  <para style="q2" vid="PRO 1:25">tuti isua mea mani, meteiayarai.<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Ampefe nani kiai, yau ambori imiri na kutu karirafo da we mea,</para>
  <para style="q2" vid="PRO 1:26">yau ambori yeikahera mea na kutu mataifo dawi mea,<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />na kutu mataifo da ma dawi mea toyari dedukai,</para>
  <para style="q2" vid="PRO 1:27">tuti dadirafo wasau mea toyari aninau,</para>
  <para style="q2" vid="PRO 1:27">na kutu dadira marabafo watawang mea mambiriu paria.<verse eid="PRO 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />Na kutu nanafo mea ambori mesahu we yau, wape yau wiro iroa we mea kaha.</para>
  <para style="q2" vid="PRO 1:28">Mea ambori mesera we yau towana-tonina, wape wiro mesobu yau kaha.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Wefianie? Weo mea wiro memaya we mewaitawang werorongfo kaha,</para>
  <para style="q2" vid="PRO 1:29">tuti mea wiro meroaso Yahwei tuti mesomi wei kaha.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Mea wiro memaya we metaramio nehu kaiwo aunau ne kaha,</para>
  <para style="q2" vid="PRO 1:30">tuti isua mea mani meteiayarai.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Nanai wedaya, mea ambori metang aibong na fi menari ne,</para>
  <para style="q2" vid="PRO 1:31">tuti mea memamosi na fi karira metamane.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Inontarai mano wiro deitawang turura kahafoi ambori mireha, weo wiro miaya we tarao yau kaha,</para>
  <para style="q2" vid="PRO 1:32">tuti inontarai mano wiro miaya we aunauwi kahafoi ambori mingganggung, weo wiro dohong kariria kaha.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Wape mandoni dino tarao yau mani, i ambori darang na mai,</para>
  <para style="q2" vid="PRO 1:33">i ambori kiaharai weru dadira marabafo.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Fi bengno wobuai na awaifoi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Nehu kaisung ne wau, masino taramuo nehu kaiwo yeunauane,</para>
  <para style="q2" vid="PRO 2:1">tuti aromuo nehu kaiwo aunau we waune,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />taramu sauarai ambori wobu awaifo,</para>
  <para style="q2" vid="PRO 2:2">tuti ruraifa ambori numukamiei wewu tofong,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />tuti masino rurai we boitawangnai,</para>
  <para style="q2" vid="PRO 2:3">tuti wahu we numikamiei wewu tofongfo,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />tuti masino era we nani kiai toyari erawe peraki nei,</para>
  <para style="q2" vid="PRO 2:4">tuti awi fi nanai toyari awi fi minohi tutirai arayai watai,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />ampefe na tonanafo wau ambori boitawang kariri todoni roaso Yahwei tuti omi wei</para>
  <para style="q2" vid="PRO 2:5">tuti wau ambori boitawang werorongfo kariri mandoni dino Allai.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Weo Yahwei andino Dohong awaifo,</para>
  <para style="q2" vid="PRO 2:6">tuti na Borongfo dariai fio aitawangnai werorongfo tuti numikamiei wewu tofongfo.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />I derara neo bengfo we inontarai mano mesifoi,</para>
  <para style="q2" vid="PRO 2:7">tuti we foti we deitawang wedua inontarai mano warang maifoi,<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />I deitawang wedua inontarai mano doarahanai we inontarai siai,</para>
  <para style="q2" vid="PRO 2:8">tuti Dewawu inontarai mano eroaso I.<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Masino taramuo nehu kaiwo yeunauane, wau ambori boitawang kariri fianai aino maifo, oarahanafo,</para>
  <para style="q2" vid="PRO 2:9">warami maifo, tuti kariri todonie minohi arang na maifo.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Weo awaifo ambori suayai to enemurorongwai</para>
  <para style="q2" vid="PRO 2:10">tuti waitawangnai werorongfo ambori dohong numuaninuwai mirising.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Nemitituai kariri neo maifo ambori dewawu wau,</para>
  <para style="q2" vid="PRO 2:11">tuti numukamiei wewu tofongfo ambori deitawang wau.<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Ambori kosau weru rang bo kerirafoi,</para>
  <para style="q2" vid="PRO 2:12">tuti weru mano emadu mani etatofa fosa,<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />weru mano era na rang mimoyafoi aha,</para>
  <para style="q2" vid="PRO 2:13">tuti era to rang memantitifoi,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />weru mano emirising we enari neo karirafo,</para>
  <para style="q2" vid="PRO 2:14">efaraise we etatofa inontaraifo,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />weru mano era na rang tehikapa</para>
  <para style="q2" vid="PRO 2:15">tuti mano era sarawai.<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Kontai ambori wau kaharai weru wiwing dirufoi,</para>
  <para style="q2" vid="PRO 2:16">tuti weru wiwing mano ne mang kawurua wape yurai we kia enemurorongwai na ne kaiwo waworifo,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />i mani wiwing da weru ne mangfoi,</para>
  <para style="q2" vid="PRO 2:17">tuti aroporo ne kaiwo arerai ria ne mang mano urohong kaiwo arerai na Allai arongfo.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Tarai, ne munufoi deisui tuti wioru,</para>
  <para style="q2" vid="PRO 2:18">rangbo da to ne munufoi mani rangbo da to raimeri.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Mano era kiai wei fosa wiro etaraberasa kaha,</para>
  <para style="q2" vid="PRO 2:19">tuti wiro esobu rangbo dohong arangfoi kaha.<verse eid="PRO 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Ampefe wau ro riatai na rang inontarai bengfoi,</para>
  <para style="q2" vid="PRO 2:20">tuti ro pampang na rang inontarai mesifoi.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Weo inontarai mano warang mai ambori niayai na mai na ne kahofafo,</para>
  <para style="q2" vid="PRO 2:21">tuti inontarai mano mesifoi ambori niayai pampang na wana,<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />wape inontarai eharira ambori eworu weru kahofafo,</para>
  <para style="q2" vid="PRO 2:22">tuti inontarai mano wiro roasoi kaha, niayai pampang na wana kaha.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Moang na awaifoi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Nehu kaisungne wau, wiro aromuporo nehu kaiwo aunau ne fanai,</para>
  <para style="q2" vid="PRO 3:1">tuti enemurorongwai dewawu nehu kaiwo ohong kaririane,<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />weo na ne tonanane, nemu fuinane ambori dawaroi, donio wau munohi barang wairoi,</para>
  <para style="q2" vid="PRO 3:2">kontai wau ambori munohi na mai.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Dohonao enemuwawuwa tuti enemurorong pepayawai unai weru waufe!</para>
  <para style="q2" vid="PRO 3:3">Tata suru we raori na ramukanangwai tuti woi suru na enemurorongwai.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Ampefe Allai tuti inontarai nesa ambori etato wau na euremi reafo,</para>
  <para style="q2" vid="PRO 3:4">tuti emirising we wau.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LUK 2:52">Luk. 2:52</ref>. </char></note><verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Roaso Yahwei na enemurorongwai sentenang,</para>
  <para style="q2" vid="PRO 3:5">tuti wiro boparanding mantaung wau boitawangnafo fanai.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />ButangNi we wiwiaing wau tuti Da foni wau,</para>
  <para style="q2" vid="PRO 3:6">ambori Deinawi rangbo mimoyafoi we wau.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Dohonao boparanding nemu awaine fanai,</para>
  <para style="q2" vid="PRO 3:7">wape roaso Yahwei tuti womi wei terai, tuti wiro nari karira fanai.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rm. 12:16</ref>. </char></note><verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Weo fi nanai ambori niari nemu taraiwai denteng,</para>
  <para style="q2" vid="PRO 3:8">tuti niari nemu neinane mutubaru.<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Fiai Yahwei na nemu ra wai</para>
  <para style="q2" vid="PRO 3:9">tuti nemu fitantanang, ne tarai ka fafongwa bohongnai Wei,<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />ambori nemu katai fanduhi fiang naifoi Sonia sefang,</para>
  <para style="q2" vid="PRO 3:10">tuti nemu babeu angguriwa nukuruwai sefangna tiwowu.<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Nehu kaisung ne wau, wiro morira kaiwo uarai na Yahwei fanai,</para>
  <para style="q2" vid="PRO 3:11">tuti wiro kosou fanai, masino Dohong aiboi we wau weo nari sarawaifa.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JOB 5:17">Ayb. 5:17</ref>. </char></note><note caller="-" style="x"><char style="xo" closed="false">3:11-12 </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">Ibr. 12:5-6</ref>.</char></note><verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Weo Yahwei sua inontarai mano enewawutifoi,</para>
  <para style="q2" vid="PRO 3:12">toyari wawa mang manei sua ne kaisung mano eneoifoi.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 3:19">Why. 3:19</ref>.</char></note><verse eid="PRO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Inontarai mano sobu awaifo tuti nunggamiei wewu tofong mani,</para>
  <para style="q2" vid="PRO 3:13">ambori sobu neo maifo.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Weo fio mahikai inontarai sobuafo nani kiai, fuba sewa weru peraki sobuafo,</para>
  <para style="q2" vid="PRO 3:14">tuti ne harga dadai sewa weru emasi sobuafo kontai.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Awaifo ne harga dadai sewa weru kamiei ne harga dedainei,</para>
  <para style="q2" vid="PRO 3:15">tuti fi kiaio maya weane wiro weai masi kariria kaha.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Fuinao barang wairoine mani, na warang domoyafoi,</para>
  <para style="q2" vid="PRO 3:16">ra bitoya tuti inontarai esomi we wau mani, na warang doweifo.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Rangbo dohongni foi niari nemirorong piraise,</para>
  <para style="q2" vid="PRO 3:17">rang kiaio dohongni foi mani dohong arang na mai.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />I mani toyari aio sifu dohong arang we mano erukepangni,</para>
  <para style="q2" vid="PRO 3:18">tuti mandoni dino yutawangnia mitu mani, ambori sobu mai.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Na awaifo, Yahwei Niari nunei kawuru ampa,</para>
  <para style="q2" vid="PRO 3:19">na Ne enetituai kariri neo maifo, I niari rora faisi,<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />na Ne deitawang werorongfo, Niari mereha ureng na kahofa rorongfo tibau tuti deda,</para>
  <para style="q2" vid="PRO 3:20">tuti kafafe na rora faisi dohong randamang sawai to nunei.<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Nehu kaisungne wau, borara nemitituai kariri neo maifo tuti titua kariri neo bengfo,</para>
  <para style="q2" vid="PRO 3:21">ambori wiro unai weru wau fanai,<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />weo uru ambori unari numuaninuwai darang,</para>
  <para style="q2" vid="PRO 3:22">tuti ambori unari nemu barangwa mahikai paria toyari raori denteng na ramukanangwai.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Ainanaya wau ambori ro na rang arangbo dentengfoi,</para>
  <para style="q2" vid="PRO 3:23">tuti awemuwa wiro sodai kaha.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Na kutu wau benafo, wau ambori wiro mutai kaha,</para>
  <para style="q2" vid="PRO 3:24">wape wau ambori benawa woo.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Wiro mutai we fi tantuma toyari dobarai da ma soru waufo fanai,</para>
  <para style="q2" vid="PRO 3:25">tuti na tantuma miung inontarai eharira fosa.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Weo Yahwei dino katai we rutawangnai naine,</para>
  <para style="q2" vid="PRO 3:26">tuti I wiro sua awemuwa waitepari kerirafoi tipari kaha.<verse eid="PRO 3:26" /></para>
  <para style="s">Kaiwo aunau we nari bengfo</para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Wiro morira we nari neo bengfo we inontarai mano da ma dutang wau we fatari,</para>
  <para style="q2" vid="PRO 3:27">mae wau mani wemambiriu we nari fi nana.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Masino inontarai manei da ma dutang we fiai ria wau mani, dohona boyo, “Wau roa, aha wori yohongnai ki,”</para>
  <para style="q2" vid="PRO 3:28">wape fio dutang weafo watai ria waune.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Wiro tang neo karirafo we nemu munu warareng nesa fanai,</para>
  <para style="q2" vid="PRO 3:29">weo eroaso wau, na kutu enayai kefang waufo.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Wiro modu kohera inontarai fanai,</para>
  <para style="q2" vid="PRO 3:30">masino wiro niari karira we wau kaha.<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Wiro enemurorong kerira we inontarai mano enari karirafo fanai,</para>
  <para style="q2" vid="PRO 3:31">wiro ro ria ene rangfoi fanai.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Weo inontarai mano enari karirafo Yahwei enerireusa,</para>
  <para style="q2" vid="PRO 3:32">wape I firao inontarai mano ewarami maifosa.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Yahwei ne deikangganiafo nayai na inontarai mano kerirafoi ne munu rorongfo,</para>
  <para style="q2" vid="PRO 3:33">wape Ne moangfo nayai na inontarai emasi fosa ene munu rorongfo.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Masino Sobu inontarai mano deikanggani inontarai siaifoi mani, Deikanggani inontaraifoi kontai,</para>
  <para style="q2" vid="PRO 3:34">wape I ambori enewawu inontarai mano enerorong tewawafoi.<note caller="-" style="x"><char style="xo" closed="false">3:34 </char><char style="xt" closed="false"><ref loc="JAS 4:6">Yak. 4:6</ref>; <ref loc="1PE 5:5">1Ptr. 5:5</ref>. </char></note><verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Inontarai mano sewaifoi ambori wonongfo beng,</para>
  <para style="q2" vid="PRO 3:35">wape inontarai mano wiro miaya we aunauwi kahafoi, ambori sobu mamaya.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Aunau we era we awaifo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Nehu kaisung ne mea, metarami sauao kaiwo aunauo mene dai deinauai we metohong kaririai,</para>
  <para style="q2" vid="PRO 4:1">tuti metarami sauarai ambori mewaitawangnai,<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />weo yeunau mea na aunau bengne,</para>
  <para style="q2" vid="PRO 4:2">ampefe wiro metawing nehu kaiwo aunau ne fanai.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Weo na kutu iwe arikang inayai na nehu dai nemufoi,</para>
  <para style="q2" vid="PRO 4:3">tuti na kutu ikatuifo nehu ai enewawu yau paria, weo imeiri yau teraifa.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Nehu dai deunau yau deyo, “Nehu kaiwone mani todoni kontaio sahara mutu na enemurorongwai,</para>
  <para style="q2" vid="PRO 4:4">rutawangnaia mutu nehu kaiwo ohong kaririane ambori munohi barangna mai.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Wobu awaifo kontai tofu kaiwo werorongfo,</para>
  <para style="q2" vid="PRO 4:5">tuti wiro aromuporoha fanai, kontai wiro bari weru nehu kaiwo na borohune fanai.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Wiro tawing awaifoi fanai, ambori dewawu wau,</para>
  <para style="q2" vid="PRO 4:6">enemuwawuti tuti i ambori deitawang wedua wau.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Awaifo mani, fio reantenangno rurai we wobuaifa,</para>
  <para style="q2" vid="PRO 4:7">tuti wau rurai we fieai mani, tofu kaiwo werorongfo.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Wau womi we awaifoi, tuti i ambori somi we wau,</para>
  <para style="q2" vid="PRO 4:8">masino faungnaia mutu mani, i ambori niari inontarai etato wau.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />I ambori sata sapewi mampofa denteng paria na numukamiei wai,</para>
  <para style="q2" vid="PRO 4:9">tuti sapewi denteng paria ambori dohongni we wau.”<verse eid="PRO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Nehu kaisungne wau, taramuo nehu kaiwo aunaune tuti rutawangnai,</para>
  <para style="q2" vid="PRO 4:10">ambori nemu fuina barangne wairoi.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Yeunau rang awaifoi we wau,</para>
  <para style="q2" vid="PRO 4:11">tuti iwiwiaing wau na rangbo mimoyanei.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Na kutu ro na rangfoi, wau ro na mai wiro fieai wedua wau kaha,</para>
  <para style="q2" vid="PRO 4:12">na kutu wau mutofo, wau wiro wodai kaha.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Wau ru kaiwo aunaufo, wiro morira fanai,</para>
  <para style="q2" vid="PRO 4:13">wau boitawangni, weo andino niari wau barangne.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Wiro ro na rang inontarai eharira fosa fanai,</para>
  <para style="q2" vid="PRO 4:14">tuti wiro ro ri<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Ro waroi weru rangbo nani, ro riati kaha,</para>
  <para style="q2" vid="PRO 4:15">ro waroi weru ea, ka rang siai.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Weo inontarai eharirafosa wiro etena kaha, masino wiro enari karirafo kaharai,</para>
  <para style="q2" vid="PRO 4:16">euremi wiro mamong kaha, masino wiro enari inontarai siai esodai karirafo kaha.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Enari karirafo mani toyari roti etangfo</para>
  <para style="q2" vid="PRO 4:17">tuti enari mamunafo mani toyari angguri etunungfo.<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Wape inontarai emasi fosa mani ene rangfoi sambewarai toyari ahafoi fiorarisi,</para>
  <para style="q2" vid="PRO 4:18">wofoi dautai sambewarai tuti sambewarai aha paria rahida rabuang.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Tuti inontarai eharira, ene rangfoi toyario diru mamantiti,</para>
  <para style="q2" vid="PRO 4:19">ea eserawawera fio wedaya esodairafo.<verse eid="PRO 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Nehu arikangne wau, taramu sua nehu kaiwone,</para>
  <para style="q2" vid="PRO 4:20">tuti fobera taramuwa kefang we kaiwo imadurai nina.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Dohonao nehu kaiwone kai nayai woiroi weru uremune fe,</para>
  <para style="q2" vid="PRO 4:21">boraratai na enemurorongwai.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Weo nanai aino dohong arang we mano esobui,</para>
  <para style="q2" vid="PRO 4:22">tuti nanai aino dohong beng we enetaraifoi.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Wau boitawang enemurorongwai sewa weru boitawang fi siai,</para>
  <para style="q2" vid="PRO 4:23">weo fi kiaio enemutituaiti tuti naririnei mani dariai na enemurorongwai.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Kobi boromu beingsengwa,</para>
  <para style="q2" vid="PRO 4:24">boromurawa totofawa mani kobioai waroi weru wau.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Uremuwa boti mimoya to fong we neo maifo,</para>
  <para style="q2" vid="PRO 4:25">tuti boti na uremu kamiaiwa papayai we neo maifo.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Wau ro na rangbo denteng,</para>
  <para style="q2" vid="PRO 4:26">ambori rangbo ro naiwai mimoya.<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="HEB 12:13">Ibr. 12:13</ref>.</char></note><verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Wiro ro to boriei weru rang dentengnei fanai,</para>
  <para style="q2" vid="PRO 4:27">awemuwa todoni kontaio da waroi weru fi karirane.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Kaiwo aunau kariri ohong we wiwing siai fanai</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Nehu kaisung ne wau, taramuo nehu awaine,</para>
  <para style="q2" vid="PRO 5:1">fobera taramuwa we enemutituai kariri neo maio yeinauwane.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Ambori wau rutawangno nemitituai kariri neo maifo,</para>
  <para style="q2" vid="PRO 5:2">tuti boromurawa wai derara fio aitawangnai werorongfo.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Weo wiwing dirufoi da ma wewori enemurorongwai, bororawafo mani mamisi toyari aniwa ne maing,</para>
  <para style="q2" vid="PRO 5:3">tuti borong rorong yaifo mani sararebatai sewa weru maning,<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />wape i ambori pirandima toyario neopi,</para>
  <para style="q2" vid="PRO 5:4">tuti i reisa toyari umbe reisa kurubong reisa reng.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Awengfo da kia wau to mararehafoi,</para>
  <para style="q2" vid="PRO 5:5">awengfo wiwiaing wau to raimeri.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Wiro da to rangbo ra nai to arangfoi kaha,</para>
  <para style="q2" vid="PRO 5:6">wiro deitawangna kaha na kutu i da na rangbo sarawafoi.<verse eid="PRO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Ampefe nehu kaisung ne mea, metaramio yau,</para>
  <para style="q2" vid="PRO 5:7">wiro mera waroi weru fianai aino imadurai we mea na borohune fanai.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Ro waroi weru wiwingfoi,</para>
  <para style="q2" vid="PRO 5:8">tuti wiro rokefang to ne rahutu borongfo fanai.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Dohonao wonomu bengwa naife, weo bohong nemu taraio wekateiwai we wiwing diru fosa,</para>
  <para style="q2" vid="PRO 5:9">tuti nemu fuina barangne futuayai na inontarai mano enewawu kahai warangfo,<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />tuti nemu ra wai dohonao inontarai siai etangnife,</para>
  <para style="q2" vid="PRO 5:10">fi rurai weane dohonao suayai to inontarai mano boroangni kaha ne munufoi fe.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Ampefe na kutu munohi barang wereafo mani,</para>
  <para style="q2" vid="PRO 5:11">wau ambori botuwa masino fimaninang dang nemu taraiwaia kiai.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Mayeai modu boyo, “Ah, iwebonggoi paria, wefiane fafongpa enehurireu kaiwo aunaune,</para>
  <para style="q2" vid="PRO 5:12">tuti enehurorongnei deiai kaiwo uarane?<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Wefianie wiro itarahuo nehu mantainau nesa,</para>
  <para style="q2" vid="PRO 5:13">tuti tarahune wiro kefang we inontarai mano etaunau yau?<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Adareti itawai to dadira fubafo</para>
  <para style="q2" vid="PRO 5:14">tuti nuhuruainso imamaya na inontarai bitoya euremi reafo.”<verse eid="PRO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Ampefe bangpi na nemu rewangguaiwai terai,</para>
  <para style="q2" vid="PRO 5:15">tuti bunung mereha na nemu nofiwai terai.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Beng kahai masino nemu merehawai tibata na rangfoi,</para>
  <para style="q2" vid="PRO 5:16">wiro bohong nemu mayanawa we wiwing siai fanai.<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Bento ampefe nani we mantaung wau terai,</para>
  <para style="q2" vid="PRO 5:17">wiro we inontarai siai kaha.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Kadono nemu wiwing wai we mereha urengno kia mirising,</para>
  <para style="q2" vid="PRO 5:18">tuti murarising ria wiwing mano rauti na kutu wekateifa,<verse eid="PRO 5:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PRO 5:19" />netarai toyari rusa wiwing tuti kambing ureng bohi paria,</para>
  <para style="q1" vid="PRO 5:19">kadono ne taraifoi dohong wau furaise pampang,</para>
  <para style="q2" vid="PRO 5:19">tuti ne mayanafo dohong enemurorong sawai wei pampang.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Nehu kaisungne wau, wefianie bohong we wiwing dirufoi?</para>
  <para style="q2" vid="PRO 5:20">Tuti wefianie bohong we faung wiwing mano wiro nemu wiwing kaha ne taraifoi?<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Weo Yahwei deti inontarai ene koangfoi kiai,</para>
  <para style="q2" vid="PRO 5:21">tuti inontarai ene rangno era naifoi kiai, I deti sauarai.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Fi karirao inontarai kerirafoi niarifo mani, finanai ambori tefu bera mantaungni,</para>
  <para style="q2" vid="PRO 5:22">tuti i ambori suayai to waitepari sasario mantauni niarifo.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />I ambori mireha weo wiro tarao kaiwo aunaune kaha,</para>
  <para style="q2" vid="PRO 5:23">tuti ne bonggoi fiabai paria nani dino ambori kiari to rangbo kerirafoi.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Kaiwo aunau siai</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Nehu kaisung ne wau, masino inontarai manei kia fieai, tuti roa kawurua we bai kutu fio kiafo,</para>
  <para style="q2" vid="PRO 6:1">tuti bohong kaiwo arerai ria mano dohongnafoi,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />wau wobu waitepari na mantaung wau nemu kaiwone,</para>
  <para style="q2" vid="PRO 6:2">tuti nemu kaiwo arerane tefu wau,<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />wau tawai kawurua, to mano dohong fi foi ne mambiriufo.</para>
  <para style="q2" vid="PRO 6:3">Nehu kaisung ne wau, nari toninai we kaharai weru inontarai nani ne mambiriufo,</para>
  <para style="q2" vid="PRO 6:3">ro weia, nari enemurorong tewawa tuti butangni we sawing wau weru nemu kaiwo arerai riatifo.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Wiro nemuboru paria uremu mamong fanai,</para>
  <para style="q2" vid="PRO 6:4">tuti wiro kuhu uremurawa fanai,<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />wape wukahera tawing mantaung wau toyari rusa mano mito weru waiteparifoi,</para>
  <para style="q2" vid="PRO 6:5">tuti toyari romuo sifo weru inontarai mano tefurifoi.<verse eid="PRO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Inontarai mano uremu marira ne wau, ro we ananafoi,</para>
  <para style="q2" vid="PRO 6:6">boti sauao fianai aino niarifo, ambori wowai.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Masino anananei wiro ne mano wenunggamiei manei kaha,</para>
  <para style="q2" vid="PRO 6:7">ete mano dohong kaiwo parenta ete mananu fuba manei kaha,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />i da sera we fiang we deraratai na kutu wemunudangfo,</para>
  <para style="q2" vid="PRO 6:8">tuti da ria ne maniwowiri fosa, efanduhi fiang na kutu inontarai eteting fianangfoi.<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Inontarai mano uremu marirane wau, bena pampangne?</para>
  <para style="q2" vid="PRO 6:9">kidoni wori boa weru bena ne?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Boyo, “Ah, yena kuteai akawuruwo, urehu mamong,</para>
  <para style="q2" vid="PRO 6:10">iminohi ikafa warahu tuti yena kuteai terai.”<note caller="-" style="x"><char style="xo" closed="false">6:10-11 </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">Kaiw. 24:33-34</ref>.</char></note><verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />Na kutu benafo, na tantuma nemu pari fi, toyari inontarai kerira da kawuru ma kia nemu fianggengfoi kiai,</para>
  <para style="q2" vid="PRO 6:11">tuti nemu fianggeng demoyara kaha, toyari inontarai mano na ne fi mamunafo dewa nemu fianggengfoi kiai weru wau.<verse eid="PRO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Inontarai kerira mano wiro wefia kahafoi,</para>
  <para style="q2" vid="PRO 6:12">i mani da towana toninai na borongfo wiro medu tarai kaha,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />i mani tetofa na mei ureng,</para>
  <para style="q2" vid="PRO 6:13">tuti fiobabera awengfo tuti warakikehafo,<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />enerorongfoi mani soni na kaiwo tatofa, neo enetituaitai pampang we niari karirafo,</para>
  <para style="q2" vid="PRO 6:14">tuti andino wedaya inontarai emamuna.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Ampefe na tantuma ambori sodai mararehafoi,</para>
  <para style="q2" vid="PRO 6:15">na ahera i ambori tikai tuti mingganggung wiro weai nayai ahang kaha.<verse eid="PRO 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Fi karira wonang aino Yahwei enerireuane,</para>
  <para style="q2" vid="PRO 6:16">wape kontai fi karira itu aino Yahwei enerorong wiro miaya kahai paria mani,<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />uremi tewafoi, taperemi tatofafoi,</para>
  <para style="q2" vid="PRO 6:17">warangmi rika we inontarai mano wiro dohong sarawa kaha,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />enemirorongno enemitituai fi karirafo,</para>
  <para style="q2" vid="PRO 6:18">awemifo mito ahera we neo karirafo,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />inontarai mano wiro medu mai kariri fio detioafo kaha,</para>
  <para style="q2" vid="PRO 6:19">tuti mano wedaya ne doroi fosa emung wawerasa.<verse eid="PRO 6:19" /></para>
  <para style="s">Kaiwo aunau kariri ohong we wiwingno ne mang kawuru ampa</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Nehu kaisung ne wau, boitawang fianai aino tamamu demi wau weafo,</para>
  <para style="q2" vid="PRO 6:20">tuti wiro tawing fianai aino inamu deunau wau weafo fanai.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Wora fio etaunauane na enemurorongwai pampang,</para>
  <para style="q2" vid="PRO 6:21">tuti tatarai we raori na ramukanangwai.<verse eid="PRO 6:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PRO 6:22" />Kaiwo aunaufo wiwiaing wau na kutu ro fo,</para>
  <para style="q2" vid="PRO 6:22">na kutu benafo deitawang wau,</para>
  <para style="q2" vid="PRO 6:22">na kutu boafo i ambori medu ria wau.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Weo kaiwo ohong kaririane mani toyario padamarami, tuti kaiwo aunaufo mani toyario dansairai,</para>
  <para style="q2" vid="PRO 6:23">kaiwo uarafo mani rangbo dohong arangfoi,<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />demang wedua wau weru wiwingno eharira fosa,</para>
  <para style="q2" vid="PRO 6:24">tuti weru wiwingno wiro nemu wiwing kaha, mano borong mamisi we wau foi.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Wiro enemurorong sawai we ureng bohifo fanai,</para>
  <para style="q2" vid="PRO 6:25">tuti dohonao mei ureng we wau mani maya weife.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Weo wiwing dirufoi</para>
  <para style="q2" vid="PRO 6:26">baiti na fiang rewangguai bei,</para>
  <para style="q2" vid="PRO 6:26">wape bena ria inontarai manei ne wiwingfoi mani baiti na numuaninuwai.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Netarai toyario inontarai manei kia adia na ne ansungfoi mani,</para>
  <para style="q2" vid="PRO 6:27">adia dangso ne ansungfo<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />ete masino da sau adia karaisengfoi mani,</para>
  <para style="q2" vid="PRO 6:28">dangso rarapu awerengfo.<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Tonanai kontai, ambori dariai we inontarai mano dena ria inontarai siai manei ne wiwingfoi,</para>
  <para style="q2" vid="PRO 6:29">inontarai mandoni dino niari tonana mani i wiro kiaharai weru aiboifo kaha.<verse eid="PRO 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Masino inontarai wewisi tuti kiamanana fiang mani,</para>
  <para style="q2" vid="PRO 6:30">inontarai enemirireuwie?<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Weo masino inontarai etafuri, todoni kontaio biai riwangnai beitu kiparai na fio kiamananawa fo.</para>
  <para style="q2" vid="PRO 6:31">Nanai wedaya ne ra minohitutirafo kai, todoni kontaio dohongnai we biaitaifa.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Mandoni dino dena ria inontarai manei ne wiwingfoi mani, inontarai nani wiro enetituai kariri neo maifo kaha,</para>
  <para style="q2" vid="PRO 6:32">inontarai mano niari tonananei niari karira we mantauni.<verse eid="PRO 6:32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="PRO 6:33" />I ambori sobu kahai tuti enemirireuwi,</para>
  <para style="q2" vid="PRO 6:33">mamayafo ambori nayai riati we fitawafa.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Weo wiwingfoi ne mangfoi ureng mutu, donio kesou fuba paria,</para>
  <para style="q2" vid="PRO 6:34">tuti na rahida biai ne kesoufo mani, enewawu bereri paria.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />I wiro miaya we fiea kaha, tuti masino waworiri na fikahutu fuba,</para>
  <para style="q2" vid="PRO 6:35">i wiro fiotou kesoufo kaha.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Nehu kaisungne waune, rukepang nehu kaiwoaririne,</para>
  <para style="q2" vid="PRO 7:1">tuti borara fianai aino yemi wau we narine, na enemurorongwai.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Rukepang fianai aino yemi wau we narine ambori barang,</para>
  <para style="q2" vid="PRO 7:2">boitawang nehu kaiwo aunaune toyario boitawang uremu kamieiwa suru.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Wora nehu kaiwone kai na waramu kikehawa,</para>
  <para style="q2" vid="PRO 7:3">tuti woi na enemurorongwai.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Modu we awaifoi boyo, “Rorohuwing diwau!”</para>
  <para style="q2" vid="PRO 7:4">tuti modu we waitawangnafoi boyo, “Nehu munurorong diwau”.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Ambori ureitawang wau weru wiwing dirufoi,</para>
  <para style="q2" vid="PRO 7:5">tuti weru wiwingno wiro nemu wiwing dine kaha, mano wewori enemurorongwai.<verse eid="PRO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Na diru bei,</para>
  <para style="q2" vid="PRO 7:6">yeti to boriei na wonggang kaititairuhifo na nehu munufoi,<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />na arikang esowaworuai mano wiro ewaitawang turura kaha fosa mani,</para>
  <para style="q2" vid="PRO 7:7">yeti bariboai mano wiro enetituai kariri neo mai kahafoi manei niayai rahangsa,<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />i da kutu rangfoi,</para>
  <para style="q2" vid="PRO 7:8">da to katai wiwing dirufoi minohi nayafo,<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />na kutu ramindena, rerai we diru,</para>
  <para style="q2" vid="PRO 7:9">na diru mamantitifo.<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Mayeai yeti wiwing manei da ma kenggung bariboaifoi,</para>
  <para style="q2" vid="PRO 7:10">wiwingfoi sata ansung wiwing diru tuti enerorongfoi siangging paria,<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />i mani wiwingno da funomaifa tuti dapawaifa,</para>
  <para style="q2" vid="PRO 7:11">awengfo wiro fanahang kaha na munufo,<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />katu mani da na rangrausi, tuti katu mani da na katai inontarai efau nayafo,</para>
  <para style="q2" vid="PRO 7:12">da wa niayai na rang reafo demang we mang.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Ainanaya wiwingfoi fiaung bariboaifoi tuti niunahi,</para>
  <para style="q2" vid="PRO 7:13">na wiro mimaya kahai, medu wei deyo,<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“Rahida nini yohong korbani nunumi,</para>
  <para style="q2" vid="PRO 7:14">ampefe ibai nehu kaiwo arerai we Yahwei kawuru ampa. Sea tarai feai watai na nehu munufoi we turang.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Nanai aino ira to boriei isera we wau,</para>
  <para style="q2" vid="PRO 7:15">nina mani isobu wau ampa, ampefe roma turawa turampi.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Yau imainenang nehu fata yenanaifoi,</para>
  <para style="q2" vid="PRO 7:16">na ireu kiamantatowarai na Mesiri.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Tuti nehu fata yenanaifoi ikafari kawurua</para>
  <para style="q2" vid="PRO 7:17">na muri, gaharu tuti ai mamisio nunsai mamporifo. <figure style="fig" file="HK00118C.TIF" size="col" ref="7:17">Ai muri</figure><verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Ampefe roma turena ruhiai awao aha bua,</para>
  <para style="q2" vid="PRO 7:18">tuti tuwe andeisei ruhiai.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Weo nehu mangnei wiro minohi na mununei kaha,</para>
  <para style="q2" vid="PRO 7:19">dontai to katai wairoi,<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />kia doi aderi bei,</para>
  <para style="q2" vid="PRO 7:20">rerai we embai nei kiai wori arahi daraberahi ki.”<verse eid="PRO 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />I wewori bariboaifoi na kaiwo wawori,</para>
  <para style="q2" vid="PRO 7:21">tuti yurai we weworiri na kaiwo mamisi.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Na tantuma bariboaifoi da riati,</para>
  <para style="q2" vid="PRO 7:22">toyari sapio kari to katai mungnifo,</para>
  <para style="q1" vid="PRO 7:22">tuti toyari inontarai webonggoio ewora awengfo na wai besi we sobu aiboifo,<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />donio wiro deitawana kaha we atofoi defaiti enerorongfoi,</para>
  <para style="q1" vid="PRO 7:23">i netarai toyari romu sifo ahera to waiteparifo,</para>
  <para style="q2" vid="PRO 7:23">tuti wiro niruainso karirafo kaha.<verse eid="PRO 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Ampefe nehu kaisung ne mea, metaramio yau,</para>
  <para style="q2" vid="PRO 7:24">tuti metarami sauao kaiwo imadurai na borohune.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Dohonao enemurorongwai daria wiwingfoi ne rang foife,</para>
  <para style="q2" vid="PRO 7:25">tuti dohonao kia wau roriati na ne rang kerirafoife.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Weo wiwing nini kawurua wedaya inontarai bitoya etawai tuti eharira,</para>
  <para style="q2" vid="PRO 7:26">tuti kawurua wedaya mang bitoya paria emarareha.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Ra to ne munufoi mani ra to raimeri,</para>
  <para style="q2" vid="PRO 7:27">ra to rorong mararehafoi.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Awaifoi sahu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Metaramioae? awaifoi sahu,</para>
  <para style="q2" vid="PRO 8:1">tuti nemitituai kariri neo maifo, sahu na rahuwafui fiabai, metaramioie?<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">Kaiw. 1:20-21</ref>. </char></note><verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Doa na katai dadaifo na rang deraungfo,</para>
  <para style="q2" vid="PRO 8:2">tuti na rangfo boriruhifo.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Na bendari borongfo, na rahutu baba dereungfo,</para>
  <para style="q2" vid="PRO 8:3">na rang uainaifoi, i sahu na rawafui fiabai deyo,<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“Inontarai ne mea, we mea yau isahu,</para>
  <para style="q2" vid="PRO 8:4">we inontarai ne mea kiai na nunei yohong rahuwafuinei.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Inontarai mano wiro meteitawang turura kahane meaine! Mesobu aunau ambori menumikamiei wewu tofong,</para>
  <para style="q2" vid="PRO 8:5">inontarai mano wiro memaya we aunau mea kahane meaine! Metafu kaiwo werorongne na menemirorongwai.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Metaramima, weo yau ambori yeisaha kaiwo werorongno mahikai paria,</para>
  <para style="q2" vid="PRO 8:6">tuti ambori ifai borohu kariri kaiwo wetaraine.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Weo taperehunei medu kaiwo tarai,</para>
  <para style="q2" vid="PRO 8:7">tuti karirafo mani borohurawanei enerireuwaifa.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Kaiwo imadurane kai mani wetarai,</para>
  <para style="q2" vid="PRO 8:8">wiro weai sayewa kaha.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Kaiwo nani kiai wetarai we mano nunggamiei wewu tofongfoi,</para>
  <para style="q2" vid="PRO 8:9">mimoya we inontarai mano deitawangnai werorongfoi.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Taramuo nehu aunaune, weo mehikai sewa weru perakinei,</para>
  <para style="q2" vid="PRO 8:10">tuti waitawangnai werorongfo mehikai sewa weru emasi keisorinei.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Taramuo Awaine yau weo iweharga sewa weru kamiei ne harga dedainei,</para>
  <para style="q2" vid="PRO 8:11">fianai aino inontarai enemioafo mani, wiro weai masi kariria kaha.<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Yau mani, Awaifoi di yau, inayai ruhiai ria numikamiei wewu tofongfoi,</para>
  <para style="q2" vid="PRO 8:12">nehu waitawangnai werorongfo tuti nemitituai kariri neo maifo.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Roaso Yahwei tuti omi wei mani, enemirireu neo karirafo,</para>
  <para style="q1" vid="PRO 8:13">yau enehurireu tewanei, nemirorong dedainei, koang keriranei,</para>
  <para style="q2" vid="PRO 8:13">tuti boromi sefangna tatofanei.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Na yau mani wobu aunau tuti titua kariri neo bengfo,</para>
  <para style="q2" vid="PRO 8:14">yau mani waitawangnafo di yau, tuti na yau mani wobu mambiriufo.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Yauno yohong mananu nesa eweparentane,</para>
  <para style="q2" vid="PRO 8:15">tuti mambaiseng nesa ehutu kaiwo na etoa rahangnai.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Yauno yohong mambiriu we baba nesa eru parentane,</para>
  <para style="q2" vid="PRO 8:16">tuti mano ewe wafonia nesa kiai tuti mano ehutu kaiwo fosa kiai, na nunei.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Yau enehuo inontarai mano eneo yau,</para>
  <para style="q2" vid="PRO 8:17">tuti mano yurai serawe yau ambori sobu yau ki.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Imainenang fianggeng bitoya tuti omifo,</para>
  <para style="q2" vid="PRO 8:18">kontai rao wataia papayai tuti oarahangnai.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Neo yohongnane mani mahikai sewa weru emasi keisorinei,</para>
  <para style="q2" vid="PRO 8:19">tuti fianai aino wobuai na yau mani mahikai sewa weru perakio mehikainei.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Yau ira na rangbo da to mesifoi,</para>
  <para style="q2" vid="PRO 8:20">yau ira na rangbo da to oarahangnafoi.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Yau yohong inontarai mano enemiwawu yaufo ene ra bitoya,</para>
  <para style="q2" vid="PRO 8:21">tuti isoni ene munu rorongfo sefang na ra.<verse eid="PRO 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />Yahwei niari yau kawuru ampa na reantenang na Ne fio yune,</para>
  <para style="q2" vid="PRO 8:22">we ne fio Niari reantenang na fafongpa.<note caller="-" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="REV 3:14">Why. 3:14</ref>. </char></note><verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Niari yau na fafongpa kawurua,</para>
  <para style="q2" vid="PRO 8:23">na reantenangno, wiro nunei kaharai.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Na kutu wiro rawanang kehabifoi kaharai,</para>
  <para style="q2" vid="PRO 8:24">tuti wiro mereha ureng feai kaharai, itaubaunuhu kawurua.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Wiro Niari uaifo doatira kaharai</para>
  <para style="q2" vid="PRO 8:25">tuti wiwoifo kaharai mae, itaubaunuhu kawurua,<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />na kutu wiro Niari nunei tuti kahofa wiarora kaharai,</para>
  <para style="q2" vid="PRO 8:26">ete kangganang kahofao reantenangfoi.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Na kutu Yahwei meinenang rorafaisi, yau inayai na wana,</para>
  <para style="q2" vid="PRO 8:27">na kutu Yabang rora amawawa na rawanang kehabi nuwowongfo.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Na kutu Dohong katai we kafafe na rorafaisi,</para>
  <para style="q2" vid="PRO 8:28">tuti mereha ureng na rawanang kehabi duwi na mambiriu, yau inayai na wana kawurua.<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />Na kutu Yahwei dohong mereha rawanang rausi werea nayafo,</para>
  <para style="q2" vid="PRO 8:29">ambori wiro merehafoi dauroainai to rei kaha,</para>
  <para style="q1" vid="PRO 8:29">tuti na kutu Kiutu nunei amangnei,<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />inayai kontai Riati we Ne arikang enewawuti,</para>
  <para style="q1" vid="PRO 8:30">rahida neungne iwe mararising Wei,</para>
  <para style="q2" vid="PRO 8:30">tuti ifaraise pampang na Arongfo.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Yau imei na Ne nunei nuwowongfo</para>
  <para style="q2" vid="PRO 8:31">tuti imirising yeti inontarai mano enayai na rorongne.<verse eid="PRO 8:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />Nanai wedaya mani, arikang ne mea metaramio yau,</para>
  <para style="q2" vid="PRO 8:32">weo mesobu maifo mano mera na nehu rangnei.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Metaramio aunaune, ambori menemitituai kariri neo maifo,</para>
  <para style="q2" vid="PRO 8:33">dohonao wiro metohong kariria kahafe.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Inontarai mano tarao yau mani sobu neo maifo,</para>
  <para style="q2" vid="PRO 8:34">mano na rahida neungne demang na nehu rahutunei,</para>
  <para style="q2" vid="PRO 8:34">mano deitawang na nehu diri rahutu fiabainei.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Weo mandoni dino sobu yau mani, ambori minohi darang na mai,</para>
  <para style="q2" vid="PRO 8:35">tuti Yahwei eneoi.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Wape mandoni dino wiro sobu yau kaha mani, mantauni sobu dadirafo,</para>
  <para style="q2" vid="PRO 8:36">inontarai mano menemirireu yau mani, meteyo memarareha.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Awaifoi tuti bonggoifoi urohong noti</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Awaifoi mantauni biaung ne munufoi kawurua,</para>
  <para style="q2" vid="PRO 9:1">tuti yuai ne diri warabong itufo doatiraifa.<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">Diri warabong itu ninai mani doari na munu antung rofongfoi. </char></note><figure style="fig" file="LB00248C.TIF" size="span" ref="9:1">Diri warabong</figure><verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Kiutu fiahungfoi kia ne taraifoi, soni kaharifui to anggurifo,</para>
  <para style="q2" vid="PRO 9:2">tuti meinenang fiangfo na mejafoi.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Na katai dadai na bendarifo,</para>
  <para style="q2" vid="PRO 9:3">mangfata wiwing fosa, demisa esahu eteyo,<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />“Mandoni dino wiro deitawang turura kaha mani, da toninai ma!”</para>
  <para style="q2" vid="PRO 9:4">Tuti we inontarai mano wiro enetituai kariri neo mai kahafoi, deyo,<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />“Mera to ninai ma, metang nehu fiangne,</para>
  <para style="q2" vid="PRO 9:5">tuti metunung angguri yohong kaharifui oinei!”<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Mehabi bonggoiwa, ambori metarang na mai,</para>
  <para style="q2" vid="PRO 9:6">tuti mera na rangbo dohong mea mewaitawangnafo.<verse eid="PRO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Mandoni dino deunau inontarai mano deikanggani inontarai siaifo mani, mantauni sobu aikangganiafo kontai,</para>
  <para style="q2" vid="PRO 9:7">tuti mantei dino sua inontarai kerirafoi na mambiriu mani, sobu dadirafo.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Wiro wua inontarai mano deikanggani inontarai siai fanai, ambori wiro enerireu wau kaha,</para>
  <para style="q2" vid="PRO 9:8">wua inontarai sewaifoi na mambiriu, ambori enewawu wau.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Bounau inontarai mano sewaifoi, ambori sewai sewa aha,</para>
  <para style="q2" vid="PRO 9:9">bounau inontarai mano mesifoi, ambori deitawangnai werorongfo fuba aha.<verse eid="PRO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Roaso Yahwei tuti omi wei mani, reantenang we obu awaifo,</para>
  <para style="q2" vid="PRO 9:10">tuti aroangso Mano Dedai Mirarebanafoi mani, we obu waitawangnai werorongfo.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Ayb. 28:28</ref>; Mzm. 111:10; <ref loc="PRO 1:7">Kaiw. 1:7</ref>. </char></note><verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Yauno iwedaya nemu fuinane da waroi,</para>
  <para style="q2" vid="PRO 9:11">tuti nemu fuina ro oane mani yohongnai aha.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Masino wowai mani, mantaung wau obu awaifo,</para>
  <para style="q2" vid="PRO 9:12">masino enemurireuwi mani, mantaung wauno wobu dadirafo.<verse eid="PRO 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Inontarai mano wiro miaya we aunawi kahafoi mani, netarai toyario wiwingno borong beinseng,</para>
  <para style="q2" vid="PRO 9:13">wiro deitawang fi fuba kaha tuti wiro mimaya kaha.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Minohi na ne munufoi na rahutu borongfo,</para>
  <para style="q2" vid="PRO 9:14">na katai dadai na bendarifoi,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />tuti inontarai mano era na rangfoi,</para>
  <para style="q2" vid="PRO 9:15">mano era mimoya na rangfoi, sahu wesa deyo,<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />“Mandoni dino wiro deitawang turura kaha mani, da toninai ma.”</para>
  <para style="q2" vid="PRO 9:16">Tuti we inontarai mano wiro enetituai kariri neo mai kahanei mani, medu deyo,<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />“Mereha kamananainei mani memisi,</para>
  <para style="q2" vid="PRO 9:17">tuti fiangno angwaworainei mani miaing sewa.”<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">Kaiwo riwangsoai nina mani, medu kariri ena ria wiwing siai ete mang siai. </char></note><verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Wape inontarai fosa eserawawerahai weo eraweia mani, ambori emarareha na wanaifa,</para>
  <para style="q2" vid="PRO 9:18">tuti inontarai mano sahusa eramafo, esuai to raimeri kawurua.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Kaiwo riawangsoaio fanduhiai na Salomoi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1" />Kaiwo riwangsoai na Salomoi finina.</para>
  <para style="q1" vid="PRO 10:1">Arikang mano sewaifoi mani, dohongno tamanai firaise,</para>
  <para style="q2" vid="PRO 10:1">wape arikang mano wiro miaya we aunauwi kahafoi mani, kia karira we inanaifa.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Ra obui na nari neo karirafo mani wiro wefia kaha,</para>
  <para style="q2" vid="PRO 10:2">wape neo maifo mani, sawing inontarai weru mararehafoi.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Yahwei wiro sawing inontarai mesinei wewisi kaha,</para>
  <para style="q2" vid="PRO 10:3">wape fio inontarai kerirafoi dawi weafo mani, wiro Yoa wea kaha.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Inontarai mano warang mararung kaha, wiro ne fia kaha,</para>
  <para style="q2" vid="PRO 10:4">wape inontarai mano warang mayafoi, ambori ne ra bitoya.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Inontarai mano enetituai kariri neo maifo mani, wiro wemunudang kaharai mae fianduhi fianangfoi kawurua,</para>
  <para style="q2" vid="PRO 10:5">wape mandoni dino dena na kutu eting fianangfoi mani, dohong mamaya mantauni.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Inontarai mesifoi mani sobu moangfo bitoya,</para>
  <para style="q2" vid="PRO 10:6">inontarai kerirafoi medu kaiwo mahikaifo, wape enetituai karirafo na enerorongfoi.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Watai we fiaiririai kariri inontarai mesifoi mani, kia moang we inontarai mano earomioifoi,</para>
  <para style="q2" vid="PRO 10:7">wape inontarai mano kerirafoi wonongfo nai.<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Mandoni dino sewai mani, dohong kariri kaiwo aunaufo,</para>
  <para style="q2" vid="PRO 10:8">wape mandoni dino webonggoi na medufo mani ambori sawaifa.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Mandoni dino ne koang denteng mani, ne rangfo mai,</para>
  <para style="q2" vid="PRO 10:9">wape mandoni dino ne rangfo takahapa mani, ambori waitawangnaifa.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Mandoni dino tetofa na mei ureng mani wedaya karirafo,</para>
  <para style="q2" vid="PRO 10:10">mandoni dino webonggoi na medufo mani, ambori sawaifa.<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Inontarai mesifoi medu kaiwo maifo mani, toyari mereha dohong arang,</para>
  <para style="q2" vid="PRO 10:11">inontarai kerirafoi medu kaiwo mahikaifo, wape enetituai karirafo na enerorongfoi.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Nemirireu inontarai mani wedaya mamuna,</para>
  <para style="q2" vid="PRO 10:12">wape nemiwawu inontarai mani, oyai ne sarawane kai.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JAS 5:20">Yak. 5:20</ref>; <ref loc="1PE 4:8">1Ptr. 4:8</ref>.</char></note><verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Na inontarai mano tefu kaiwo werorongfoi mani, tasobu awai na fi medurafo,</para>
  <para style="q2" vid="PRO 10:13">wape aitatohi reafoi demang we inontarai mano wiro enetituai kariri neo mai kahafoi kuruinafoi.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Inontarai mano sewaifoi mani, derara neo waitawangnai werorongfo ambori sobu dadira fanai,</para>
  <para style="q2" vid="PRO 10:14">wape inontarai webonggoifoi borongfo mani, kia karira wei.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Ra foi mani toyari wore bendari mitubarufoi we demang wedua inontarai mano ne ra bitoyafoi,</para>
  <para style="q2" vid="PRO 10:15">wape nemi pari fi mani dohong karira we mano ne pari fi foi.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Fio inontarai mesifoi sobuafo mani arangfoi,</para>
  <para style="q2" vid="PRO 10:16">wape fio inontarai kerirafoi sobuafo mani sasarifoi.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Mandoni dino tarao aunaune mani, da to rang arangfoi,</para>
  <para style="q2" vid="PRO 10:17">wape mandoni dino wiro tarao kaiwo uarafo kaha mani, da to rang kerirafoi.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Mandoni dino dediwa enemirireufo, tetofa na bororawafoi,</para>
  <para style="q2" vid="PRO 10:18">mandoni dino deibaberaha mani, inontarai nani wiro miaya we aunauwi kaha.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Madu bitoya mani, ambori madu sarawaifa,</para>
  <para style="q2" vid="PRO 10:19">wape mandoni dino yutawang bororawanei mani, enetituai kariri neo maifo.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Inontarai mesinei taperengfoi mani, toyari peraki ne harga dedai,</para>
  <para style="q2" vid="PRO 10:20">wape inontarai kerirafoi ne enetituaitafo mani, wiro wefia kaha.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Inontarai mesifoi bororawafoi mani, dohong moang we inontarai bitoya,</para>
  <para style="q2" vid="PRO 10:21">wape inontarai webonggoifoi mireha, weo wiro enetituai kariri neo maifo kaha.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Moang na Yahwei aino dohong ra bitoya ne,</para>
  <para style="q2" vid="PRO 10:22">rurai fuba kontaio wiro ambori wobu weai ahang kaha.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Inontarai mano wiro miaya we aunauwi kahafoi mani, piraise we niari karirafo,</para>
  <para style="q2" vid="PRO 10:23">wape inontarai mano niari kariri awaifo mani, nunggamiei wewu tofong.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Fianai aino inontarai kerirafoi mitaitafo mani, fi nanai aino ambori sobuaifa,</para>
  <para style="q2" vid="PRO 10:24">wape fio inontarai mesifoi dohong weafo mani, ambori sobuaifa.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Masino dadirafo toyario dobarai siayai mani, inontarai kerirafoi wioru,</para>
  <para style="q2" vid="PRO 10:25">wape inontarai mesifoi mani doara pepayai we fitawafa.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Wiro bomi inontarai ureng marirafoi we yu fi fanai,</para>
  <para style="q2" vid="PRO 10:26">weo netarai toyario cuka niari deremi sisasa tuti riraung dohong uremi sasora.<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Roaso Yahwei tuti omi wei mani, ambori arang wairoi,</para>
  <para style="q2" vid="PRO 10:27">wape inontarai kerirafoi ne fuina darangfo mani, wiro wairoi kaha.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Fio inontarai mesifoi enetawanafo mani, ambori dohongni mirising,</para>
  <para style="q2" vid="PRO 10:28">wape inontarai kerirafoi fio enetawanafo mani, wiro we fiea kaha.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Yahwei ne rangfoi mani dewawu inontarai mano mesifoi,</para>
  <para style="q2" vid="PRO 10:29">wape kia karira we inontarai mano niari karirafoi.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Inontarai mesifoi ambori niayaia pepayai na ne kahofa weririafo,</para>
  <para style="q2" vid="PRO 10:30">wape inontarai kerirafoi wiro niayaia pepaya na kahofafo kaha.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Na inontarai mesifoi borongfoi mani, medu kaiwo awaifo,</para>
  <para style="q2" vid="PRO 10:31">wape inontarai mano tapereng sobaurafo mani ambori kutui.<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Inontarai mesifoi bororawafo deitawang fio dohong mirisingfo,</para>
  <para style="q2" vid="PRO 10:32">wape inontarai kerirafoi borongfo mani, manta deitawangno tetofafo teraifa.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Inontarai mano titua fi maraba tuti sayayai na warang mai kaha mani, Yahwei enerireuwi paria,</para>
  <para style="q2" vid="PRO 11:1">wape I firaise we inontarai mano titua fi na mai.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Masino tewafo da ma mani, mamayafo kontai ambori da ma,</para>
  <para style="q2" vid="PRO 11:2">wape awaifo mani, nayai ria inontarai mano enerorong tewawafoi.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Inontarai mesifoi ne kaiwo maifo deduni,</para>
  <para style="q2" vid="PRO 11:3">wape inontarai mano roasoi kahafoi, wonongfo karira na fi niarifo.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Na rahida bo Allai kiutu kaiwo we inontarainei, fi kiaio minohi tutirafo wiro wefieai wei kaha,</para>
  <para style="q2" vid="PRO 11:4">wape darang na niari neo maifo mani, ambori sawini weru mararehafoi.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Inontarai mesifoi ne rangfo mani mai kariri dohongnafo,</para>
  <para style="q2" vid="PRO 11:5">wape inontarai kerirafoi fio mantauni niarifo wedayari sawaifa.<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Inontarai mano warang maifoi, fio niari maifo wedayari kiaharai weru neo karirafo,</para>
  <para style="q2" vid="PRO 11:6">wape inontarai mano wiro roasoi kahafoi, fi karirao miaya weafo mani, tefu bera mantaungni.<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Masino inontarai kerirafoi mireha mani, enetawanafo naiya kaia,</para>
  <para style="q2" vid="PRO 11:7">tuti mambiriu minohitutirafo wefiea kaha.<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Inontarai mesifoi kiaharai weru dadirafo,</para>
  <para style="q2" vid="PRO 11:8">wape mano kerirafoi sobu dadirafo pampang.<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Inontarai kerirafoi borongfo ming ne doroisa,</para>
  <para style="q2" vid="PRO 11:9">wape inontarai mesifoi na ne deitawangnai werorongfo kiaharai weru dadirafo.<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Masino inontarai mesifoi sobu neo mahikaifo pampang mani, bendarifo mirising tantenang,</para>
  <para style="q2" vid="PRO 11:10">tuti masino inontarai kerirafoi mireha mani, ehue weo efaraise fefe.<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Moangfo nayai na inontarai mano warang maifoi we biaung bendarifoi wewu tofong,</para>
  <para style="q2" vid="PRO 11:11">wape inontarai kerirafoi borongfo dohong bendarifoi misuhi.<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Mandoni dino enerireu ne doroifoi mani, wiro enetituai kariri neo maifo kaha,</para>
  <para style="q2" vid="PRO 11:12">wape inontarai mano nunggamiei wewu tofongfoi mani minohi nemboru.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Mandoni dino miaya we deiriri fi karira kariri inontarai siai mani, wiro yutawang kaiwo adiwarafo kaha,</para>
  <para style="q2" vid="PRO 11:13">wape mandoni dino enerorong pepayai mani, dediwa kaiwo adiwarafo.<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Masino mananufoi wiro sewai kaha mani, kaiwasafoi wiro sobu mai kaha,</para>
  <para style="q2" vid="PRO 11:14">wape masino mantainau efau mani, kaiwasafoi minohi na mai.<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Mandoni dino dererai we biai kutu inontarai siai manei ne fi kiafo mani, i ambori sobu karirafo,</para>
  <para style="q2" vid="PRO 11:15">wape mandoni dino enerireu netonanafo mani minohi na mai.<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Wiwing mano enerorong dentengfoi mani, wonongfo beng,</para>
  <para style="q2" vid="PRO 11:16">wape mano warangansumafoi mani, sobu ra bitoya terai.<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Inontarai mano enewawu fubafoi mani, niari neo mahikaifo we mantauni,</para>
  <para style="q2" vid="PRO 11:17">wape inontarai mano memuna biriufoi mani, niari ne karirafo we mantauni.<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Inontarai kerirafoi ne fi sobuai fubafo mani, wefiea kaha,</para>
  <para style="q2" vid="PRO 11:18">wape mandoni dino sanang fio bengfo mani, ne fio sobuafo wiro nai kaha.<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Mandoni dino niari kariri fio maifo pampang mani, ne fuinao daoafo wairoi,</para>
  <para style="q2" vid="PRO 11:19">wape mandoni dino dawi ne karirafo pampang mani, da to mararehafoi.<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Mandoni dino enerorongfoi seru mani, Yahwei enerireuwi,</para>
  <para style="q2" vid="PRO 11:20">wape Firaise we inontarai mano da na rang mesifoi.<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Tarai, inontarai kerirafoi, wiro kiaharai weru aiboifo kaha,</para>
  <para style="q2" vid="PRO 11:21">wape inontarai mano mesifoi ne ririafoi mani, ekaharai weru aiboifo.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Wiwingno ureng bohi wiro deitawang turura kahafoi,</para>
  <para style="q2" vid="PRO 11:22">netarai toyari fio marandinai na taramine sawai na fiai ubongfoi.<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Inontarai mesifoi fio enetawanafo mani, kia mahikai,</para>
  <para style="q2" vid="PRO 11:23">wape inontarai kerirafoi fio enetawanafo mani, dohong inontarai siai ehasouwi.<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Manei deto ne rafoi, wape ne rafoi bitoya aha,</para>
  <para style="q2" vid="PRO 11:24">manei wiro deto ne rafoi funoma kaha, wape ne pari fi pampang.<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Mandoni dino dohong fianggeng bitoya mani, mantauni ambori sobu fianggeng bitoya aha,</para>
  <para style="q1" vid="PRO 11:25">mandoni dino dohong mereha we inontarai manei dunung mani, mantauni kontai inontarai siai etohong mereha we dunung.<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Mandoni dino derara potangfoi we dewayani na kutu ne harga dedaifo mani, inontarai ambori eteikanggani,</para>
  <para style="q2" vid="PRO 11:26">wape mandoni dino dewayang potangfoi we inontarai ewori mani, ambori efiai.<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Mandoni dino yurai na mambiriu we niari bengfo mani, ambori inontarai efaraiseri,</para>
  <para style="q2" vid="PRO 11:27">wape mandoni dino dawi neo karirafo mani, ambori sodai karirafo.<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Mandoni dino yoasoai weo ne rafoi ambori deitawanifo mani, ambori sobu karirafo,</para>
  <para style="q2" vid="PRO 11:28">wape inontarai mesifoi ambori sifu toyari aireraung weworu.<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Mandoni dino niari sarawai na ne munurorongfo mani, ambori tefu wanangbafoi,</para>
  <para style="q2" vid="PRO 11:29">inontarai webonggoifoi ambori we woming we inontarai mano sewaifoi.<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Fianai aino inontarai mesifoi niarifo mani, ambori dohong arang we inontarai siai,</para>
  <para style="q2" vid="PRO 11:30">tuti mandoni dino sewai mani, kia inontarai enemirorongfoi.<verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Masino inontarai mano mesifoi sobu fiembaitai na nunei,</para>
  <para style="q2" vid="PRO 11:31">tonanai kontai we inontarai kerirafoi tuti inontarai wesasarifoi, usobu aiboifo.<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1Ptr. 4:18</ref>. </char></note><verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Mandoni dino eneo waitawangnai werorongfo mani, i kontai miaya we sobu kaiwo aunaufo</para>
  <para style="q2" vid="PRO 12:1">wape mandoni dino enerireu kaiwo uarafo mani, webonggoi.<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Inontarai dentengfoi Yahwei eneoi,</para>
  <para style="q2" vid="PRO 12:2">wape inontarai mano sang neo karirafo mani, Dohong aiboi wei.<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Inontarai wiro doara pepaya kaha weo niari karirafo,</para>
  <para style="q2" vid="PRO 12:3">wape inontarai mesifoi mani wenewara mitu wiro minihingna kaha.<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Wiwing mano sewaifoi mani we sapewi mampofa we ne mangfoi,</para>
  <para style="q2" vid="PRO 12:4">wape mano niari mamayafoi mani toyari maninangno niari ne mangfoi neina piro.<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Inontarai mesifoi fio samafo mani, doa rahangnai,</para>
  <para style="q2" vid="PRO 12:5">inontarai kerirafoi miaya we tetofa.<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Kaiwo inontarai kerirafoi medurafo mani, miung inontarai siai,</para>
  <para style="q2" vid="PRO 12:6">wape inontarai warang maifoi borongfo mani, sawing inontarai weru ne karirafo.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Inontarai kerirafoi sawai, donio wioru,</para>
  <para style="q2" vid="PRO 12:7">wape inontarai mesifoi ne munurorongfo mani, nayai pampang.<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Inontarai mano enetituai kariri neo maifo ambori efiai,</para>
  <para style="q2" vid="PRO 12:8">wape inontarai mano enetituai bonggoifo ambori enemirireuwi.<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Neo mahikai sewa mani, tawe inontarai batang, wape tarufi we mantaung tata,</para>
  <para style="q2" vid="PRO 12:9">weru inontarai mano niariri fiabai, wape ne fiang wiro demoyara kaha.<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Inontarai mesifoi deitawang saua ne fiahung fosa etarangfo,</para>
  <para style="q2" vid="PRO 12:10">wape inontarai kerirafoi niari kanggani fiahung fosa.<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Mandoni dino niari romi mani, ambori memosi na fiang,</para>
  <para style="q2" vid="PRO 12:11">wape mandoni dino enerorong sopuayai mani, wiro enetituai kariri neo maifo kaha.<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Inontarai kerirafoi enerorong sawai we inontarai mano wiro warang mai kahai, ne fio dewarafo,</para>
  <para style="q2" vid="PRO 12:12">wape inontarai mesifoi netarai toyario aio wenewa tuti webong.<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Inontarai kerirafoi sobu dadirafo na kaiwo karira medurai na mantauni borongfo,</para>
  <para style="q2" vid="PRO 12:13">wape inontarai mesifoi kiaharai weru dadirafo.<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Inontarai mano medu maifoi, ambori darang na mai,</para>
  <para style="q2" vid="PRO 12:14">tuti inontarai mano yu fi na maifoi, ambori sobu fio mahikaifo na fio niari nanai.<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Inontarai webonggoifoi mantauni deitarahio ne rangfoi mimoya,</para>
  <para style="q2" vid="PRO 12:15">wape mandoni dino tarao aunau mani, sewai.<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Na kutu inontarai webonggoifoi kesou mani, deinawi ne kasoufo ahera,</para>
  <para style="q2" vid="PRO 12:16">wape mano nungkamiei wewu tofongfoi mani, wiro deto enemirirewifo kaha.<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Mandoni dino medu kaiwo tarai kariri fio detioafo mani, doarahanai,</para>
  <para style="q2" vid="PRO 12:17">wape mano wiro medu mai kariri fio detioafo kaha mani, tetofa.<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Kaiwo karirao dariai na boromine mani, niari fari toyari umbe disang,</para>
  <para style="q2" vid="PRO 12:18">wape inontarai mano sewaifoi, taperengfoi mani netarai toyario rawang dohong beng we mano meninangfoi.<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Boromirawao madu maifo mani, ambori nayai pampang we fitawafa,</para>
  <para style="q2" vid="PRO 12:19">wape taperemi tatofanei mani, manta ararafanai terai.<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Tatofanei mani niayai na inontarai mano etang neo karirafo,</para>
  <para style="q2" vid="PRO 12:20">wape inontarai mano deunau inontarai siai we etarang na mahikai mani, ambori sobu maifo.<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Inontarai mano mesifoi wiro sodai neo karira fea kaha,</para>
  <para style="q2" vid="PRO 12:21">wape inontarai mano kerirafoi ambori sodai ne karirafo pampang.<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Inontarai mano bororawa tetofa mani Yahwei enerireuwi,</para>
  <para style="q2" vid="PRO 12:22">wape inontarai mano enerorong pepayai we medu kaiwo bengfo mani, Piraise wei.<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Inontarai mano nungkamiei wewu tofongfoi dediwa ne deitawangnai werorongfo,</para>
  <para style="q2" vid="PRO 12:23">wape inontarai mano wiro miaya we aunauwi kahafoi sahu tuti ne bonggoifo.<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Inontarai ureng mayafoi warangfo wedayari weinontarai fuba,</para>
  <para style="q2" vid="PRO 12:24">wape inontarai ureng mariranei ambori we woming.<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Aromikuayai we rahida da ma wana mani, wedaya inontarai enerorongfoi mirua,</para>
  <para style="q2" vid="PRO 12:25">wape kaiwo bengfo mani niari nemirorong firaise.<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Inontarai mesifoi wiwiaing ne maniwowirifoi na mai,</para>
  <para style="q2" vid="PRO 12:26">wape inontarai kerirafoi wiwiaing to rang kerirafoi.<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Inontarai ureng marirafoi wiro sobu fio dohong weafo kaha,</para>
  <para style="q2" vid="PRO 12:27">wape inontarai ureng mayafoi ambori sobu ra.<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Na rangbo mesifoi obu arangfo,</para>
  <para style="q2" vid="PRO 12:28">wape rangbo kerirafoi da to mararehafoi.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Arikang mano sewaifoi mani, taradidau tamang ne aunaufo,</para>
  <para style="q2" vid="PRO 13:1">wape inontarai mano firaise we enerireuwai mani, wiro miaya we tarao uarafo kaha.<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Inontarai mano dentengfoi ambori sobu fi bengfo na kaiwo medurafo,</para>
  <para style="q2" vid="PRO 13:2">wape inontarai mano wiro roasoi kahafoi, miaya we niari karirafo.<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Mandoni dino enetituai akawuru wori medu ki, i deitawang nuaninufoi,</para>
  <para style="q2" vid="PRO 13:3">wape mandoni dino borong fiabai mani, sodai neo karirafo.<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Mano ureng marirafoi dohong we fi bitoya, wape wiro sobu fiea kaha,</para>
  <para style="q2" vid="PRO 13:4">wape mano ureng mayafoi sobu fi bitoya.<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Inontarai mano mesifoi enerireu tatofafo,</para>
  <para style="q2" vid="PRO 13:5">wape inontarai mano kerirafoi dohong mamaya tuti dohong karira we mantauni.<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Fi mahikaio inontarai mesifoi niarifo mani, ambori deitawang weduari,</para>
  <para style="q2" vid="PRO 13:6">wape inontarai wesasarifoi ambori mingganggung na fi karira niarifo.<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Manei niariri we inontarai ne ra bitoya, wape wiro ne fiea kaha,</para>
  <para style="q2" vid="PRO 13:7">manei kontai niari fearai we ne pari fi, wape ne rafoi bitoya.<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Inontarai mano ne ra bitoyafoi mani, biai kutu nuaninufoi,</para>
  <para style="q2" vid="PRO 13:8">wape mano ne pari fi foi, wiro tarao manei memuna wei kaha.<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Inontarai mesifoi ne sambewarafo mani dansairai paria,</para>
  <para style="q2" vid="PRO 13:9">wape inontarai mano kerirafoi ne padamarangfoi fefe.<figure style="fig" file="HK00151C.TIF" size="col" ref="13:9">Padamarang (pelita)</figure><verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Na tewafo mani, mamunafoi dariai,</para>
  <para style="q2" vid="PRO 13:10">wape mano etaramio kaiwo aunaufo mani, awaifo nayai riasa.<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Ra inontarai sobui aherafoi, ambori niai fantintamai,</para>
  <para style="q2" vid="PRO 13:11">wape mandoni dino fianduhi rafoi maididahi pampang mani, ambori ne rafoi fiabai aha.<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Inontarai manei ambori enerorong fituayai, masino wiro sobu fio enetawanafo kaharai,</para>
  <para style="q2" vid="PRO 13:12">wape na kutu fi dohong weafo sobuaifa mani, enerorongfoi mirising.<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Mandoni dino enerireu kaiwo sariatine mani, i ambori sobu dadirafo,</para>
  <para style="q2" vid="PRO 13:13">wape mandoni dino dohong kariri kaiwo ohong kaririafo mani, ambori sobu neo bengfo.<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Inontarai mano sewaifoi mani, ne aunaufo dohong arang,</para>
  <para style="q2" vid="PRO 13:14">donio inontarai ekaharai weru waitepari mararehafoi.<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Inontarai mano enetituai kariri neo maifoi ambori dohong inontarai siai efaraise,</para>
  <para style="q2" vid="PRO 13:15">wape inontarai mano wiro roasoi kahafoi, ne rangfoi ambori dohong dadira.<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Inontarai mano nungkamiei wewu tofongfoi, ambori dohong kariri ne fio deitawangnai werorongfo,</para>
  <para style="q2" vid="PRO 13:16">wape inontarai mano wiro miaya we aunauwi kahafoi, deinawi ne bonggoifo.<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Ami mangfata mano kerirafoi mani wedaya i tuti inontarai siai esobu dadirafo,</para>
  <para style="q2" vid="PRO 13:17">wape ami mangfata enerorong pepayafoi mani kia bengfo, toyari inontarai mano denteng weru meninangfo.<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Nemi pari fi tuti mamayafo ambori da we inontarai mano wiro tarao kaiwo aunaufo kaha,</para>
  <para style="q2" vid="PRO 13:18">wape mandoni dino tarao kaiwo uarafo mani etatori.<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Inontarai enerorong firaise na kutu sobu fio dohong weafo,</para>
  <para style="q2" vid="PRO 13:19">wape inontarai wiro miaya we aunauwi kahafoi firaise we niari karirafo pampang.<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Mandoni dino firao inontarai mano sewaifoi mani, ambori sewai aha,</para>
  <para style="q2" vid="PRO 13:20">wape mandoni dino firao inontarai mano wiro miaya we aunauwi kahafoi mani, ambori sobu karirafo.<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Fio karirafo dawi inontarai mano wesasarifoi,</para>
  <para style="q2" vid="PRO 13:21">wape inontarai mesifoi ambori sobu fiembaitafo.<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Inontarai mano dentengfoi, fi minohi tutirafo dohongnai watai ria ne ririafoi kiai,</para>
  <para style="q2" vid="PRO 13:22">wape ra inontarai sasarifoi ararati we inontarai mesinei.<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Inontarai mano ne pari fifoi, ne kahofafo mani, dohong fiang bitoya,</para>
  <para style="q2" vid="PRO 13:23">wape weai nai, weo wiro oarahana fea kaha.<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Mandoni dino wiro yu aitatohi kaha mani, enerireu ne arikangfoi,</para>
  <para style="q2" vid="PRO 13:24">wape mandoni dino enewawu ne arikangfoi mani, dohong aiboi wei, na kutu niari sarawafo.<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Inontarai mano mesifoi dampia memosi,</para>
  <para style="q2" vid="PRO 13:25">wape inontarai mano kerirafoi wewisi pampang.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Wiwing mano sewaifoi biaung ne munurorongfo,</para>
  <para style="q2" vid="PRO 14:1">wape mano webonggoifoi meiria misuhi na mantauni warangfo.<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Mandoni dino da na warang maifo mani, ambori yoaso Yahwei tuti somi wei,</para>
  <para style="q2" vid="PRO 14:2">wape inontarai mano ne rang kerirafoi, enerireu I.<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Inontarai mano webonggoi borongfo mani wedaya, aiboifoi wiatai na kurungfoi,</para>
  <para style="q2" vid="PRO 14:3">wape inontarai mano sewaifoi, bororawafoi dewawuti.<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Inontarai mano ureng mariranei miaya we dehung sapi kaha, weo nana mani yuai ne fi dampi nai foi pampang,</para>
  <para style="q2" vid="PRO 14:4">wape na sapi ne mambiriufo inontarai ambori esobu fiang.<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Inontarai mano enerorong pepayafoi wiro sofa kaha, medu mai kariri fio detioafo na mano ehutu kaiwo fosa,</para>
  <para style="q2" vid="PRO 14:5">wape inontarai mano wiro medu mai kariri fio detioafo kaha mani, tetofa.<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Inontarai mano enerireuwafoi, yurai we sobu awaifo, wiro sobua kaha,</para>
  <para style="q2" vid="PRO 14:6">wape inontarai mano nunggamiei wewu tofongfoi mani, mawa deitawang werorongfo.<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Nayai waroi weru inontarai mano wiro miaya we aunauwi kahafoi,</para>
  <para style="q2" vid="PRO 14:7">weo aitawangnai werorongfo wiro wobuai na bororawafoi kaha.<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Inontarai mano nungkamiei wewu tofongfoi mani, ne awai tuti deitawang todonie da na maifo,</para>
  <para style="q2" vid="PRO 14:8">wape inontarai mano wiro miaya we aunauwi kahafoi, sobu tatofa na ne bonggoifo.<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Inontarai webonggoi mano enerireu korbani nunuminei mani, wiro miaya we aiyai ne sasarinei kaha,</para>
  <para style="q2" vid="PRO 14:9">wape inontarai warang maifoi, yurai we sobu neo bengfo.<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Enerorong fituayanei, mantauni andino deitawang terine,</para>
  <para style="q2" vid="PRO 14:10">tuti inontarai siai kontai wiro deitawang enerorongfoi mirisingfo kaha.<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Munu inontarai kerirafoi ambori misuhi,</para>
  <para style="q2" vid="PRO 14:11">wape munu inontarai warang maifoi ambori doaria pepayai.<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Rangno inontarai eteitarahio mimoya,</para>
  <para style="q2" vid="PRO 14:12">wape reafo da to mararehafoi.<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">Kaiw. 16:25</ref>. </char></note><verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Na marari rorongfo tarahio obu enemirorongno sai,</para>
  <para style="q2" vid="PRO 14:13">tuti faraisefo tarahio obuai na enemirorong fituayai.<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Inontarai mano daraberahi weru bengfo to neo karirafo, i ambori memosi na fio karirafo,</para>
  <para style="q2" vid="PRO 14:14">tuti inontarai mano dentengfoi, i ambori memosi na fio bengfo.<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Inontarai mano wiro deitawang turura kahafoi, mawa we yoaso fi kiaio taraoafo,</para>
  <para style="q2" vid="PRO 14:15">wape inontarai mano nungkamiei wewu tofongfoi, deitawang da fo.<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Inontarai mano sewaifoi, denansiau tuti da waroi weru karirafo,</para>
  <para style="q2" vid="PRO 14:16">wape inontarai mano wiro miaya we aunauwi kahafoi, tewa tuti niruainso darang na mai ampa.<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Mandoni dino ne rika wiwu ahera mani, webonggoi,</para>
  <para style="q2" vid="PRO 14:17">wape inontarai mano enetituai kariri neo maifo, sawani.<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Inontarai mano wiro deitawang turura kahafoi, sobu fi weriria bonggoifo,</para>
  <para style="q2" vid="PRO 14:18">wape inontarai mano nungkamiei wewu tofongfoi mani, sata sapewi mampofa waitawangnai werorongfo.<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Inontarai kerirafoi somi we inontarai dentengfoi,</para>
  <para style="q2" vid="PRO 14:19">inontarai kerirafoi doari na rahutu borong inontarai mesifoi, dutangnai we fiatari.<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Inontarai mano ne pari fi foi, ne pari maniwowiri,</para>
  <para style="q2" vid="PRO 14:20">wape inontarai mano ne ra bitoyafoi ne maniwowirifoi bitoya.<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Mandoni dino enerireu inontarai siai mani, niari sasari,</para>
  <para style="q2" vid="PRO 14:21">wape mano sobu maifo mani, inontarai mano enewawu inontaraio sobu dadirafoi.<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Mandoni dino enetituaitai tuti sang fi karira fo mani, da na rangbo ra sarawafoi</para>
  <para style="q2" vid="PRO 14:22">wape inontarai mano enetituaitai tuti sang fi bengfo mani, sobu nemiwawufo tuti papayafo.<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Masino inontarai mano yufi na mambiriu mani, sobuarai,</para>
  <para style="q2" vid="PRO 14:23">wape madu funong kaiwo mani, wiro obu fiea kaha.<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Inontarai sewaifoi sobu ra bitoya na fiembaitafo,</para>
  <para style="q2" vid="PRO 14:24">wape fiembaitai we inontarai mano wiro miaya we aunawi kahafoi mani, ne bonggoifo.<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Inontarai mano enerorong pepayafoi medu kariri fio detioafo mani, sawing inontarai weru mararehafoi,</para>
  <para style="q2" vid="PRO 14:25">wape mandoni dino wiro medu mai kariri fio detioafo kaha mani, wiro roasoi kaha.<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Inontarai mano eroaso Yahwei tuti esomi wei mani, eminohi etarang na mai,</para>
  <para style="q2" vid="PRO 14:26">kontaio Yahwei deitawang wedua ene arikang nesa.<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Roaso Yahwei tuti omi wei mani, obu arangfo,</para>
  <para style="q2" vid="PRO 14:27">donio inontarai ekaharai weru waitepari mararehafoi.<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Mananufoi wonongfo beng, masino weparenta inontarai bitoya,</para>
  <para style="q2" vid="PRO 14:28">wape inontarai bereri mani, mananufoi wiro ne mambiriu fea kaha.<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Inontarai mano sawani mani, enetituai kariri neo maifo fuba,</para>
  <para style="q2" vid="PRO 14:29">wape mandoni dino sikera we kesou mani, deinawi ne webonggoifo.<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Enemirorong finahang mani dohong tane tarai denteng,</para>
  <para style="q2" vid="PRO 14:30">wape enemirorong piraha mani piro we tane neina ne.<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Mandoni dino niari kanggani inontarai mano finahangfoi mani, enerireu mano Niaririfoi,</para>
  <para style="q2" vid="PRO 14:31">wape mandoni dino enewawu inontarai mano ne pari fi mani, fiai mano Niaririfoi.<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Inontarai kerirafoi mingganggung na fi karira mantauni niarifo,</para>
  <para style="q2" vid="PRO 14:32">wape inontarai mesifoi sobu awawu, weo enerorongfoi mesi fefe.<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Awaifo nayai na inontarai mano tefu kaiwo werorongfo,</para>
  <para style="q2" vid="PRO 14:33">wape inontarai mano wiro miaya we aunauwi kahafoi, wiro deitawang kariri awaifoi kaha.<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Nari fio maifo mani ambori dohong kaiwasafoi fiabai,</para>
  <para style="q2" vid="PRO 14:34">wape sasarifoi dohong mamaya we kaiwasafoi.<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Mananufoi miaya we mangfata mano enetituai kariri neo maifo,</para>
  <para style="q2" vid="PRO 14:35">wape ne kasoufo wasau inontarai mano niari mamayafoi.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Roa we inontarai mano kesoufoi na kaiwo fanahang ambori ne kasoufo bia,</para>
  <para style="q2" vid="PRO 15:1">wape madu na kaiwo raisa mani dohong ne kasoufo dautai aha.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Na inontarai sewai taperengfoi, dariai kaiwo waitawangnai werorongno kia nemirorongfoi, ambori ewaitawangnaifa,</para>
  <para style="q2" vid="PRO 15:2">wape mano wiro miaya we aunawi kahafoi, borongfo sefangna kaiwo bonggoifo.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Yahwei urengfo nayai na katainei kiai,</para>
  <para style="q2" vid="PRO 15:3">Deitawang inontarai mano kerirafoi tuti inontarai mano dentengfoi.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Taperemi finahang mani toyario ai dohong arang,</para>
  <para style="q2" vid="PRO 15:4">wape taperemi tatofanei dohong nemirorong pirahai.<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Inontarai mano webonggoifoi deiaya tamang ne aunaufo,</para>
  <para style="q2" vid="PRO 15:5">wape mandoni dino dohong kariri kaiwo uarafo nana mani, inontarai mano nungkamiei wewu tofong dine.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Na munu inontarai mesifoi mani ra bitoya,</para>
  <para style="q2" vid="PRO 15:6">wape fio inontarai kerirafoi sobuafo mani kia karirafo.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Inontarai sewaifoi bororawafoi mani, medu kaiwo waitawangnai werorongfo,</para>
  <para style="q2" vid="PRO 15:7">wape inontarai mano wiro miaya we aunawi kahafoi, wiro niari tonana kaha.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Yahwei enerireu inontarai kerirafoi ne korbani niunumifoi,</para>
  <para style="q2" vid="PRO 15:8">wape nadi inontarai warang maifoi mani, dohong Enerorong firaise.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Inontarai eharira ene rangfoi, Yahwei enerireuwi,</para>
  <para style="q2" vid="PRO 15:9">wape mandoni dino yurai na mambiriu we niari maifo mani, Yahwei enewawuti.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Inontarai mano da weru rang mesifoi mani, ambori sobu aiboi maraba,</para>
  <para style="q2" vid="PRO 15:10">tuti mandoni dino enerireu kaiwo uarafo mani, ambori mireha.<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Yahwei deti bau katai inontarai mararehafoi,</para>
  <para style="q2" vid="PRO 15:11">sewa pari aha mani, Deitawangno inontarainei kiai enemirorongnei.<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Inontarai mano enerireuwafoi mani, miaya we inontarai manei suari kaha,</para>
  <para style="q2" vid="PRO 15:12">wiro miaya we da to inontarai mano sewaifoi we sobu aunau kaha.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Nemirorongno firaisenei mani, dohong uremi mararising,</para>
  <para style="q2" vid="PRO 15:13">wape nemirorongno fituayanei mani, kiraikobu mirisingne.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Inontarai mano enetituaitai ahera we tefu kaiwo werorongfo mani, yurai pampang we sobu waitawangnai werorongfo,</para>
  <para style="q2" vid="PRO 15:14">wape inontarai mano wiro miaya we aunawi kahafoi mani, yurai we soni borongfo na bonggoifo.<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Inontarai mano sobu dadirafoi mani, wiro minohi darang na mai kaha,</para>
  <para style="q2" vid="PRO 15:15">masino sobu dadira wape enerorong firaise pampang, toyari niari muniara.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Inontarai manei ne fianggeng fuba kaha, wape yoaso Yahwei tuti somi wei, mahikai sewa weru</para>
  <para style="q2" vid="PRO 15:16">inontarai mano ne fianggeng bitoya, wape arokuayaifa.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Bang raung rewanggoai bei ria inontarai mano enewawu wau mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 15:17">bang andowa tarai miaing ria inontarai mano enerireu wau.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Inontarai mano kesou ahera mani, wedaya mamuna,</para>
  <para style="q2" vid="PRO 15:18">wape mano sawaninei mani, dohong enemirorong deunanang.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Inontarai ureng mariranei ne rangfoi mani, toyari rangno sefang na ababo,</para>
  <para style="q2" vid="PRO 15:19">wape inontarai mano warang mainei ne rangfoi mirarebanaifa.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Arikang mano sewaifoi mani, dohong tamang firaise,</para>
  <para style="q2" vid="PRO 15:20">wape mano wiro miaya we aunawi kaha mani, enerireu inana.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Bonggoifo mani, mano wiro enetituai kariri neo mai kahafoi firaise weai,</para>
  <para style="q2" vid="PRO 15:21">wape mano nunggamiei wewu tofongfoi mani, da na rang mimoyafoi.<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Fianai aino inontarai etamafo wiro esobuai kaha, masino wiro etaramio mano etohong aunau fosa kaha,</para>
  <para style="q2" vid="PRO 15:22">wape fi etamafo esobuai na mai, masino etaramio mano etohong aunau fosa.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Inontarai manei firaise na kutu yoa na mai we mano dutanifoi,</para>
  <para style="q2" vid="PRO 15:23">tuti sewa aha mani, masino medufo tete ne rahidafo.<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Rang inontarai mano enetituai kariri neo maifoi mani, da to arang waroifoi,</para>
  <para style="q2" vid="PRO 15:24">ambori wairoi weru raimeri.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Inontarai mano tewa ne munufoi Yahwei sotawi,</para>
  <para style="q2" vid="PRO 15:25">wape Deitawang wedua wiwingna ne ruareafoi.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Yahwei enerireu fio inontarai kerira samafo,</para>
  <para style="q2" vid="PRO 15:26">wape inontarai mano medu kaiwo manangfo mani, mahikai paria.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Mandoni dino yurai we sobu fianggeng na sofa inontarai siai mani, wedaya ne munurorong sobu dadira,</para>
  <para style="q2" vid="PRO 15:27">wape mandoni dino enerireu fikahutufo mani, ambori darang na mai.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Inontarai mano mesifoi mani, enetituai kaiwofo akawuru wori medu ki,</para>
  <para style="q2" vid="PRO 15:28">wape inontarai kerirafoi mani, na borongfo kaiwo karirafo dariai ahera.<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Yahwei niayai waroi weru inontarai mano keriranei,</para>
  <para style="q2" vid="PRO 15:29">wape Tarao inontarai mesi ne nadinei.<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Uremi kaiwewa dohong nemirorong mirising,</para>
  <para style="q2" vid="PRO 15:30">tuti kaiwo bengfo dohong andeisei numianinu nei.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Inontarai mano tarao kaiwo uarafo mani, ambori kiari to arangno bengfo,</para>
  <para style="q2" vid="PRO 15:31">i kontai ambori we inontarai sewai.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Mandoni dino eneaya aunaufo mani, niari dadira we mantauni,</para>
  <para style="q2" vid="PRO 15:32">wape mandoni dino tarao uarafo mani, enetituai kariri neo maifo.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Roaso Yahwei tuti omi wei mani, aunauo kia awai fine,</para>
  <para style="q2" vid="PRO 15:33">tuti nemirorong tewawa mani, wedaya wonongmi beng.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Inontarai enetituaitai na enerorong fio de medurafo,</para>
  <para style="q2" vid="PRO 16:1">wape taperengfoi medu fio Yahwei eneoafo.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Inontarai eteitarahio era na rangbo dohong arang maifoi,</para>
  <para style="q2" vid="PRO 16:2">wape Yahwei dino titua kariri nemirorongnei denteng ete bererie.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Bohong fio nariwa kai we Yahwei,</para>
  <para style="q2" vid="PRO 16:3">ambori fio tamawa wobuaifa.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Yahwei niari fianggengnei kiai kariri neo Enetituaitafo,</para>
  <para style="q2" vid="PRO 16:4">kontai Meinenang rahida we dohong aiboi we inontarai kerirafoi.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Inontarai mano tewafoi Yahwei enerireuwi paria,</para>
  <para style="q2" vid="PRO 16:5">tarai, inontarai nani wiro kiaharai weru aiboifo kaha.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Enemurorongwai pepayai tuti enemuwawu Yahwei mani, ambori Deyai nemu sarawane.</para>
  <para style="q2" vid="PRO 16:6">Roaso Yahwei tuti womi wei mani, wau wiro nari ne karirane fanai.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Masino Yahwei Miaya we manei ne rangfo mani,</para>
  <para style="q2" vid="PRO 16:7">Niari inontarai nani ne aitetafoi wiro ukasou uru ahang kaha.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Inontarai mano ne pari fi, wape niari neo bengfo mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 16:8">inontarai mano ne ra bitoya, wape warang mai kaha.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Inontarai nesa enemitituai kariri rang ambori eranaifoi,</para>
  <para style="q2" vid="PRO 16:9">wape Yahwei dino Deinawi rang bodoni dino eranaine.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Na mananu borongfo medu kaiwo kutuai na Allai,</para>
  <para style="q2" vid="PRO 16:10">masino kiutu kaiwo mani, wiro dohong sarawa kaha.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Titua maraba tuti sayayai na mai mani, Yahwei miaya wea,</para>
  <para style="q2" vid="PRO 16:11">Andino niari kamieinei kiai we titua maraba tuti sayayai na awayang fine.<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Mananu nei enerireu inontarai mano niari karirafo,</para>
  <para style="q2" vid="PRO 16:12">weo ne parentafo ambori papayai, masino inontarai enari neo maifo.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Kaiwo maifo dariai na boromio dohong mananu nei mirising,</para>
  <para style="q2" vid="PRO 16:13">tuti enewawu inontarai mano medu antufoi.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Masino mananunei kesou fuba mani, wedaya inontarai sobu aiboi mararehafo,</para>
  <para style="q2" vid="PRO 16:14">wape mano sewaifoi sona mananufoi enerorongfoi.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Mananu ureng mararising mani, wedaya inontarai etarang,</para>
  <para style="q2" vid="PRO 16:15">tuti ne bengfo mani, toyari kafafe dohong metang we fitatangne.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Obu awai mani mahikai sewa weru obu masinei,</para>
  <para style="q2" vid="PRO 16:16">tuti iriai we tafu kaiwo werorongfo mani, mahikai sewa weru perakinei.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Inontarai mano warang mai nei mani, da waroi weru rang kerirafoi,</para>
  <para style="q2" vid="PRO 16:17">mandoni dino deitawang ne rangfoi mani, dewawu mantauni nuaninufoi.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Tewa paria nei mani, wedaya wobu karirafo,</para>
  <para style="q2" vid="PRO 16:18">tuti wau ambori tawai, masino enemurorong dedai.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Arang na nemirorong tewawa ria inontarai mano ne pari fifoi mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 16:19">ra ria inontarai mano etawa tuti obu fieai na fio etawarafo.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Inontarai mano enetituai nari kaiwo aunauwai weifo mani, ambori sobu mai,</para>
  <para style="q2" vid="PRO 16:20">tuti inontarai mano yoaso Yahwei, ambori sobu maifo.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Inontarai mano tefu kaiwo werorongfo mani, ahui we inontarai sewai,</para>
  <para style="q2" vid="PRO 16:21">tuti medu na mai mani, ne kaiwofo eroasoai.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Nemitituai kariri neo maifo mani, toyari mereha dohong arang we inontarai mano sewaifoi,</para>
  <para style="q2" vid="PRO 16:22">wape inontarai webonggoifoi mani, sobu aiboi na mantauni ne bonggoifo.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Inontarai sewaifoi mani, enetituai kariri neo maifo akawuru wori medu ki,</para>
  <para style="q2" vid="PRO 16:23">tuti fianai aino medurafo mani eroasoi.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Kaiwo manangfo mani toyari aniwa nemaing,</para>
  <para style="q2" vid="PRO 16:24">mamisi we nemirorongnei tuti we rawang we neinane.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Inontaraifoi deitarahio ne rangfoi mimoya,</para>
  <para style="q2" vid="PRO 16:25">wape reafo da we mararehafoi.<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="PRO 14:12">Kaiw. 14:12</ref>.</char></note><verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Inontarai mano wewisifoi, yu fi na mambiriu ambori dampi ki,</para>
  <para style="q2" vid="PRO 16:26">weo enengfoi wiarora ampefe denggewari we yu fi.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Inontarai kerirafoi yurai pampang sera we rang we niari karirafo we inontarai siai,</para>
  <para style="q2" vid="PRO 16:27">tuti kaiwo dariai na borongfo mani toyari adia niunung inontarai siai.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Inontarai mano tetofanei mani, wedaya mamuna,</para>
  <para style="q2" vid="PRO 16:28">tuti mano deiriri funong inontarai mani, niari maniwowiri uwe boyarifo suru ukatate suru.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Inontarai mano warangansumafoi wewori tuti tetofa ne maniwowirifoi we niari sarawaifa,</para>
  <para style="q2" vid="PRO 16:29">tuti kiari to rang kerirafoi<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Mandoni dino tetofa na mei urengfo mani, sang neo karirafo,</para>
  <para style="q2" vid="PRO 16:30">mandoni dino miri bororawa mani, niari neo karirafo kawuru ampa.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Numi baibua mani we sapewi mampofa denteng paria,</para>
  <para style="q2" vid="PRO 16:31">inontarai mano da na rang mesifoi, ambori sobui.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Inontarai mano sawanifoi mani, denteng sewa weru mano wemambiriu sewafoi,</para>
  <para style="q2" vid="PRO 16:32">inontarai mano wiro kesou ahera kahafoi mani, wemambiriu sewa weru inontarai mano dewa aitetafosa ene bendarifo.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Inontarai eteitarahio ehabi onde mani deinawi we ehutu kaiwofo,</para>
  <para style="q2" vid="PRO 16:33">wape kaiwo kutuai na ondefoi mani, da na Yahwei terai.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Ang taung terai wape arang na mai, mahikai sewa weru</para>
  <para style="q2" vid="PRO 17:1">ang andowa tarai miaing wape munufoi sefang na mamuna.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Womingno enetituai kariri neo maifoi, ambori weparenta sau inontarai mano yu fi weifoi ne arikang dohong mamayafoi,</para>
  <para style="q2" vid="PRO 17:2">woming nini kontai ambori yiwang arikangfoi we sobu fi weriria, kariri arikang siai fosa.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Emasi tuti perakinei mani, titua we suru na adiafoi ambori ukaisori,</para>
  <para style="q2" vid="PRO 17:3">wape Yahwei dino titua inontarai enemirorongfoi ne.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Inontarai mano niari karirafoi dohong kariri kaiwo na boromi karirafoi,</para>
  <para style="q2" vid="PRO 17:4">inontarai tetofafoi mani, tarao te boromi tatofafo.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Mandoni dino deikanggani inontarai mano ne pari fi foi mani, enerireu Yahwei mano niaririfoi,</para>
  <para style="q2" vid="PRO 17:5">mandoni dino firaise na kutu inontarai siai sobu dadirafo mani, wiro kiaharai weru aiboifo kaha.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Mano enumi baibua fosa etaparanding ene tafuisa,</para>
  <para style="q2" vid="PRO 17:6">tuti arikang fosa etaparanding ene wawafo suru.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Inontarai mano webonggoinei wiro mei we medu kaiwo bengne kaha,</para>
  <para style="q2" vid="PRO 17:7">sewa aha mani inontarai mano atorinei wiro mei we medu kaiwo tatofa kaha.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Inontarai manei enetituaitai dohong fikahutufo, toyari kamiei ne harga dedaifoi,</para>
  <para style="q2" vid="PRO 17:8">yoasoai we fikahutufo niariri ambori sobu fio enerorong dohong weafo.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Masino boyai nemu maniwowiri ne sarawane mani, enemuwawuti,</para>
  <para style="q2" vid="PRO 17:9">wape modu kewawe ne sarawafo mani, nari nemu maniwowirifoi ambori mukatate muru.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Inontarai mano nunggamiei wewu tofongfoi sobu aunau bitoya na kaiwo uarai rabuang bei.</para>
  <para style="q2" vid="PRO 17:10">Inontarai mano wiro miaya we aunawi kahafoi ohong aiboi piaring wei, wape ne bonggoifo nayai pampang.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Inontarai eharira fosa erurai pampang we etapa mano wenunggamieifoi,</para>
  <para style="q2" vid="PRO 17:11">wape mano wenunggamieifoi ambori demi inontarai mano ureng mamangfoi dohong aiboi wesa.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Kanggung andowa memuna mano ne arikang niai mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 17:12">kanggung inontarai mano wiro miaya we aunawi kahafoi, na kutu niari fio bonggoifo.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Mandoni dino dohong bera inontarai siai ne bengfo na neo karirafo mani,</para>
  <para style="q2" vid="PRO 17:13">karirafo ambori nayai pampang na ne munurorongfo.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Inontarai mano de memunafoi mani, netarai toyario fai merehafoi deda pampang,</para>
  <para style="q2" vid="PRO 17:14">ampefe fotou madune ambori wiro mamuna fea kaha.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Inontarai mano kiutu kaiwo we sawing inontarai kerirafoi tuti inontarai mano dohong aiboi we inontarai mano mesifoi,</para>
  <para style="q2" vid="PRO 17:15">uru mani Yahwei enerireu suru.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />We fianie doi na inontarai mano wiro miaya we aunawi kaha warangfo? We wiori awaifo ne?</para>
  <para style="q2" vid="PRO 17:16">Wefiea kaha, weo wiro enetituai maifo kaha.<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Maniwowiri dentengfoi mani, enewawu tata pampang na rahida neungne,</para>
  <para style="q2" vid="PRO 17:17">tuti doroifoi mani demang we fiata tata pampang na kutu tasobu dadirafo.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Inontarai mano dererai we biai kutu ne maniwowirifoi ne fio kia ria inontarai siaifoi,</para>
  <para style="q2" vid="PRO 17:18">i mani wiro enetituai kariri neo maifo kaha.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Mandoni dino miaya serawe kaiwo mani niari sarawaifa,</para>
  <para style="q2" vid="PRO 17:19">tonanai kontai we inontarai mano tewafoi miaya we deinawi ne fianggeng mahikaifo mani, ambori sobu dadirafo.<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Inontarai mano enerorong serufoi mani, wiro sobu mai kaha,</para>
  <para style="q2" vid="PRO 17:20">tuti inontarai mano tapereng sobaurafoi mani, ambori sawai to karira rorongfo.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Mandoni dino ne arikangfoi wiro miaya we aunawi kaha mani, enerorong fituayai,</para>
  <para style="q2" vid="PRO 17:21">tuti arikang mano webonggoifoi ne dai enerorong firaise kaha.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Nemirorongno firaisenei toyari rawangno niari tane tarai denteng weru maninangfoi,</para>
  <para style="q2" vid="PRO 17:22">wape nemirorongno fituayanei mani niari neina fanahang.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Mandoni dino na mamunggasai sobu doi baikutuai</para>
  <para style="q2" vid="PRO 17:23">we medu kiutu kaiwo na wiro doarahana kaha mani, inontarai kerira dine.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Inontarai mano tefu kaiwo werorongfo deti terai we awaifo,</para>
  <para style="q2" vid="PRO 17:24">wape inontarai mano wiro miaya we aunawi kahafoi enetituaifo wiro papaya kaha.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Arikang mano wiro miaya we aunawi kahafoi niari ne dai enerorong pirahai,</para>
  <para style="q2" vid="PRO 17:25">tuti dohong inanai enerorong fituayai.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Wiro beng kaha, masino inontarai mano wiro dohong sarawa kahafoi biai fiwai,</para>
  <para style="q2" vid="PRO 17:26">kontaio mano wenunggamiei tuti warang maifoi sobu aiboi mani wiro beng kaha.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Inontarai mano deitawangnai werorongfoi wiro medu funoma kaha,</para>
  <para style="q2" vid="PRO 17:27">inontarai mano nemboru enetituai kaiwo medurafo mani nungkamiei wewu tofong.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Na kutu inontarai webonggoifoi nemboru mani, inontarai siai eteitarahio i mani inontarai sewai dine,</para>
  <para style="q2" vid="PRO 17:28">tuti na kutu medu kahafo mani, inontarai siai eteitarahio i mani nunggamiei wewu tofong.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Inontarai mano wiro miaya we firao inontarai siai kaha mani, enetituai mantauni terai,</para>
  <para style="q2" vid="PRO 18:1">i kontai dapa inontarai siai mano enemitituaitai kariri neo bengfo.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Inontarai mano wiro miaya we aunawi kahafoi mani, wiro miaya we nungkamiei wewu tofong kaha,</para>
  <para style="q2" vid="PRO 18:2">i mani miaya we inontarai siai etaramioi terai.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Masino nari karirafo mani, inontarai ambori enemirireu wau,</para>
  <para style="q2" vid="PRO 18:3">tuti masino nari mamaya mani, inontarai ambori eteikanggani wau.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Kaiwo awaine mani toyari rawanang kehabi tuti waya deda,</para>
  <para style="q2" vid="PRO 18:4">kaiwo ninai werorong tuti dohong andeisei we inontarai mano taraoafoi.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Beng kahai, masino kutu kaiwo mani tau we inontarai kerira foi,</para>
  <para style="q2" vid="PRO 18:5">tuti ohong aiboi we inontarai mesi foi.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Inontarai mano wiro miaya we aunawi kaha foi bororawafoi mani wedaya mamuna,</para>
  <para style="q2" vid="PRO 18:6">tuti borongfoi medu funomai mani sera we daiboi.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Inontarai mano wiro miaya we aunawi kahafoi mingganggung na kaiwo medurafo,</para>
  <para style="q2" vid="PRO 18:7">tuti ne kaiwofo tipabera mantauni.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Airiri funong inontarai mani toyari fiang maing,</para>
  <para style="q2" vid="PRO 18:8">ampefe inontarai emaya we etongnaifa.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Inontarai mano ureng marira we yufi mani netarai toyario</para>
  <para style="q2" vid="PRO 18:9">inontarai mano mei fianggengfo.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Yahwei mani netarai toyari katai mitubaru we adiwanai,</para>
  <para style="q2" vid="PRO 18:10">na wana inontarai mesifoi mitoa niayai na mai.<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Rafoi mani toyari wore bendari mitubarufoi we inontarai mano ne ra bitoyafoi,</para>
  <para style="q2" vid="PRO 18:11">tuti deitarahio netarai toyari wore kamiei dedai we deitawang weduari.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Inontarai tewafoi ambori mingganggung,</para>
  <para style="q2" vid="PRO 18:12">wape inontarai mano enerorong tewawafoi ambori fiai.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Inontarai mano yoa na ahera wiro tarao nari kaiwofoa kai kaharai,</para>
  <para style="q2" vid="PRO 18:13">i mani webonggoi tuti dohong mamaya mantauni.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Nemirorong mirisingnei mani, niari inontarai wemambiriu we sodua ne dadirafo,</para>
  <para style="q2" vid="PRO 18:14">wape nemirorong fituayanei, mandoni dino wemambiriune?<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Inontarai mano nungkamiei wewu tofongfoi mani, miaya we sobu waitawangnai werorongfo pampang,</para>
  <para style="q2" vid="PRO 18:15">tuti inontarai mano sewaifoi tarangfo sera we fi nanaifa.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Ohong fieai we inontarai mani ambori dohong rang we wau,</para>
  <para style="q2" vid="PRO 18:16">tuti fio ohongnai nanai ambori kia wau we wobu inontarai baba fosa.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Na kutu madu kutu kaiwofo mani, inontarai mano medu fafongfoi ambori ewaitarahio andino medu antune,</para>
  <para style="q2" vid="PRO 18:17">masino inontarai manei wiro medu dapa ne kaiwo medurafo kaharai.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Kabi onde<note caller="+" style="f"><char style="fr" closed="false" /><char style="ft" closed="false">Kabi onde mani koang inontarai Yahudi enari na fafongpa. We inontarai Ambai tane koang na fafongpa mani taru ramang. </char></note> we fotou inontarai mano emamuna fosa,</para>
  <para style="q2" vid="PRO 18:18">tuti kutu kaiwo we mandoni dino niari sarawafo, na inontarai mano ewemambiriu fosa.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Wobu nemu doroi terai mano nari enerorongfoi piraha foi mani, dadira sewa weru wobu bendari ne wore mitubaru,</para>
  <para style="q2" vid="PRO 18:19">tuti mamunafo kiatate inontarai, toyari ai teba na rahutu uai to bendarifo.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Toyari enemi memosi na fiang,</para>
  <para style="q2" vid="PRO 18:20">tonanai kontai inontarai ambori sobu bengfo na kaiwo bengno medurafo.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Mureha tuti barangfo mani taperemunei dino sanane,</para>
  <para style="q2" vid="PRO 18:21">mandoni dino medu biriu mani, ambori sobu dadirafo na kaiwo medurafo.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Masino wobu wiwing dentengfoi mani wobu mahikaifo,</para>
  <para style="q2" vid="PRO 18:22">tuti i mani moangno Yahwei dohongni we wau.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Inontarai mano ne pari fifoi medu dutang we enemiwawuti,</para>
  <para style="q2" vid="PRO 18:23">wape inontarai mano ne ra bitoyafoi yoa wei na kaiwo tapapa.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Maniwowiri manei wedaya wobu karirafo,</para>
  <para style="q2" vid="PRO 18:24">wape maniwowiri siai manei denteng sewa weru nemu doroi terafoi.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Inontarai mano ne pari fi wape ne koangfoi mirarebanai mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 19:1">inontarai mano sofa biriu tuti wiro miaya we aunawi kaha.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Na kutu inontarai manei niari fieai na ahera, wape serawawera nari toafo mani, nanai wiro beng kaha,</para>
  <para style="q2" vid="PRO 19:2">inontarai mano sikahera we niari fieai, ambori niari sarawaifa.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Inontarai manei ne darangfo karira paria weo ne bonggoi niarifo,</para>
  <para style="q2" vid="PRO 19:3">wape kesou Yahwei.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Inontarai mano ne ra bitoya mani, ne maniwowirifosa efau,</para>
  <para style="q2" vid="PRO 19:4">wape inontarai mano ne pari fi foi mani, ne maniwowiri fosa era werui.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Inontarai mano wiro medu mai kariri fio detioafo kaha mani, wiro kiaharai weru aiboifo kaha,</para>
  <para style="q2" vid="PRO 19:5">tuti inontarai mano medu funong kaiwo na tetofa mani, wiro sawini weru aiboifo kaha.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Inontarai bitoya erurai we eha inontarai mano warang mutu kahai enerorongfoi,</para>
  <para style="q2" vid="PRO 19:6">inontarai fosa emaya we ewemaniwowiri ria inontarai mano dohong fi pampang fo.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Inontarai mano ne pari fi foi ne doroi fosa enemirireuwi,</para>
  <para style="q2" vid="PRO 19:7">kontai ne maniwowiri fosa era waroi werui.</para>
  <para style="q1" vid="PRO 19:7">I dawisa, dutangsa pampang we efatari</para>
  <para style="q2" vid="PRO 19:7">wape wiro emaya we ewati kariri kaha.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Mandoni dino taraie enewawu mantauni mani, yurai ambori nemitituai kariri neo maifo nayai riati,</para>
  <para style="q2" vid="PRO 19:8">tuti ambori sobu fio bengfo, masino nungkamiei wewu tofongfo nayai riati pampang.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Inontarai mano wiro medu mai kariri fio detioafo kaha mani, wiro kiaharai weru aiboifo kaha,</para>
  <para style="q2" vid="PRO 19:9">tuti inontarai mano medu funong kaiwo na tetofa mani, ambori mireha.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Wiro beng kahai we inontarai mano wiro miaya we aunawi kahai darang na mai, toyari inontarai mano ne ra bitoyafoi,</para>
  <para style="q2" vid="PRO 19:10">tuti neo karira pari mani, womingfoi weparenta sau inontarai mano yu parentafoi.<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Inontarai mano enetituai kariri neo maifo mani, wiro kesou ahera kaha,</para>
  <para style="q2" vid="PRO 19:11">tuti inontaraifoi esomi wei, weo deiyai inontarai ene sarawaifa.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Mananufoi kesou mani toyari singa weworu bibe,</para>
  <para style="q2" vid="PRO 19:12">wape ne bengfo mani toyari randamang bia sau ninoifo.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Arikang mano wiro miaya we aunawi kahafoi mani, wedaya ne dai sobu karirafo,</para>
  <para style="q2" vid="PRO 19:13">tuti wiwing mano memuna pampangfoi mani toyari metangno singsuang na fiotoura kaha.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Munu tuti rafoi mani fi weriria na wawafo suru,</para>
  <para style="q2" vid="PRO 19:14">wape wiwing mano enetituai kariri neo maifo mani na Yahwei terai.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Uremi marirafo mani, niari inontaraifoi dena pampang,</para>
  <para style="q2" vid="PRO 19:15">tuti inontarai mano wiro miaya we yu fi kahafoi mani, ambori wewisi.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Mandoni dino dohong kariri Yahwei ne kaiwo ohong kaririafo mani, dewawu mantauni nuaninufoi,</para>
  <para style="q2" vid="PRO 19:16">wape mandoni dino enerireu kaiwo nana mani, ambori mireha.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Mandoni dino enewawu inontarai mano ne pari fi foi mani, toyari dohong fieai we Yahwei,</para>
  <para style="q2" vid="PRO 19:17">tuti ambori Yahwei biai berahai we fio niari kawurua nanai.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Bohong aiboi we nemu arikangwai na kutu ketuifo,</para>
  <para style="q2" vid="PRO 19:18">wape dohongnao mantaung wauno wedayari sobu karirafo fe.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Inontarai mano kesou aherafoi mani, tawingni ambori mantauni sodua aiboi kariri fio niarifo,</para>
  <para style="q2" vid="PRO 19:19">masino fatari webeyari mani, wau ambori fatari aha.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Taramuo kaiwo aunaufo tuti bomang we kaiwo uarafo,</para>
  <para style="q2" vid="PRO 19:20">ambori wau weinontarai wowai na rahida fui.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Inontaraifosa etang fi bitoya na enemirorongfoi we enari,</para>
  <para style="q2" vid="PRO 19:21">wape Yahwei ne enetituaifo terai aino Niarine.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Inontarai mano enerorong dentengfoi mani, inontarai siai emirising wei.</para>
  <para style="q2" vid="PRO 19:22">Ne pari fi mani, mahikai sewa weru sofa biriufoi.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Inontarai mano yoaso Yahwei tuti somi wei mani, ambori minohi darang na mai,</para>
  <para style="q2" vid="PRO 19:23">tuti inontaraifoi dena na mai na diru, wiro sobu karira kaha.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Inontarai mano ureng marirafoi sa warangfo rarang rewangguaifoi,</para>
  <para style="q2" vid="PRO 19:24">wape wiro miaya we yuai warangfo to borongfo kaha.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Inontarai mano wiro deitawang turura kahafoi, masino deti inontarai mano deikangganiafoi sobu aiboifo mani, arahio nungkamiei wewu tofong.</para>
  <para style="q2" vid="PRO 19:25">Inontarai mano tefu kaiwo werorongfo masino uari mani, ambori deitawang werorongfo sewa aha.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Arikang mano bioi tamangna ete data inanafoi mani,</para>
  <para style="q2" vid="PRO 19:26">niari karira tuti dohong mamaya mauntauni.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Nehu kaisung ne wau, masino wiro taramuo nehu kaiwo aunaune kaha mani,</para>
  <para style="q2" vid="PRO 19:27">wau ambori wiro nari kariri kaiwo dohong wau boitawang werorongfo kaha.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Inontarai mano wiro medu mai kariri fio detiafo kaha mani, enerireu kaiwo ohong kaririafo.</para>
  <para style="q2" vid="PRO 19:28">Nari karirafo mani toyari fiang maing, ampefe inontarai mano kerirafoi mirising we niari.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Yahwei meinenang aiboi kawuru ampa we inontarai mano deikangganiafoi,</para>
  <para style="q2" vid="PRO 19:29">tuti aiwitang reafoi demang kawurua we inontarai mano wiro miaya we aunawi kahafoi kuruinafoi.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Anggurinei wedaya inontarai enemirireu, ye memunanei dohong inontarai emamuna,</para>
  <para style="q2" vid="PRO 20:1">mano metunung tuti memayeru mani wiro mesawai pari kaha.<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Mananufoi kesou mani toyario singa weworu bibe,</para>
  <para style="q2" vid="PRO 20:2">mandoni dino niariri kesou mani mantaungni sobu karirafo.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Inontarai manei atori, masino sawani wiro miaya we medu funong kaiwo kaha,</para>
  <para style="q2" vid="PRO 20:3">wape inontarai webonggoifoi ne kasoufo dariai ahera.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Inontarai mano ureng mariranei wiro niari romi na kutu tanang fitantanangfo kaha,</para>
  <para style="q2" vid="PRO 20:4">donio na kutu eting fitantanangfoi mani wiro sobu fiea kaha.<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Fi inontarai etamai na enemirorongfoi we enarifo mani, toyari fio watai na kamirei merehao berorong,</para>
  <para style="q2" vid="PRO 20:5">wape inontarai mano nungkamiei wewu tofongfoi mani deitawang fi nanaifa.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Inontarai bitoya etafubera mantaungsa we ansaino enemiwawune,</para>
  <para style="q2" vid="PRO 20:6">wape inontarai mano tarai enerorong pepayafoi, wiro mawa we obu kaha.<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Inontarai mesifoi mani ne koangfoi denteng,</para>
  <para style="q2" vid="PRO 20:7">ne arikang fosa ambori esobu mai.<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Na kutu mananufoi kiutu kaiwo we inontarai mani,</para>
  <para style="q2" vid="PRO 20:8">fi kerirafoi kiai deti baurai.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Wiro inontarai manei medu na mai deyo, “Enehurorongfi mirarebanai kawuru ampa,</para>
  <para style="q2" vid="PRO 20:9">tuti wiro nehu sasari feai ahang kaha.”<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Inontarai mano titua tuti dutu fi na wiro warang mai kaha mani,</para>
  <para style="q2" vid="PRO 20:10">Yahwei enerireuwi paria.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Inontarai manei, masino ketui wape aroangni na fi niarifo,</para>
  <para style="q2" vid="PRO 20:11">ne koangfoi denteng tuti warang mai ete bererie.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Yahwei niari taramine ambori taramioai,</para>
  <para style="q2" vid="PRO 20:12">tuti Niari uremine ambori wati.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Wiro bena pampang fanai, ambori wiro weinontarai mano ne pari fi kaha,</para>
  <para style="q2" vid="PRO 20:13">boabari wau rufi, ambori bampia momosi.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Inontarai mano wiori fianggengfoi medu fafiarai we mano dewayangfoi, deyo, “Ah, nemu fio bowayangnane wiro beng kaha! Ne harga dadai kareraifa!”</para>
  <para style="q2" vid="PRO 20:14">Wape mantauni fiai berahi, masino wiori fianggengfo na harga tawawa.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Masino emasi tuti kamiei ne harga dedai bitoya,</para>
  <para style="q2" vid="PRO 20:15">wape fio ne harga dadai sewa mani boromirawao medu kaiwo waitawangnai werorongfo.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Masino inontarai mano dererai we biai kutu inontarai siai manei ne fi kiafo mani, ka inontarai nani ne fio ne harga dadaifo,</para>
  <para style="q2" vid="PRO 20:16">tuti rutawangnaifa pariao inontarai mano dererafoi biaitai awao kai.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Fiangno wobui na totofa, bangni mani miaing paria,</para>
  <para style="q2" vid="PRO 20:17">wape rerai we kai mani wiro miaing kaha, toyario bangno ninuaing.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Fianai aino inontarai etamafo ambori esobuai na mai, masino etaramio mano etohong aunau fosa,</para>
  <para style="q2" vid="PRO 20:18">ampefe wobu wiwiaing akawuruwori momuna ki.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Mandoni dino deiriri funong inontarai mani, i kontai deiriri fio adiwarafo,</para>
  <para style="q2" vid="PRO 20:19">weo nanai aino wiro furao inontarai mano borong beingsengfoi fanai.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Mandoni dino deikanggani ne dai ete ne ai mani,</para>
  <para style="q2" vid="PRO 20:20">ne darangfo werea toyario padamarang fefe na diru mamantitifo.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Fi weririao ka ahera na kutu wiro ne rahida mai we wobua kaharai,</para>
  <para style="q2" vid="PRO 20:21">fi nanai rahida fui wiro kia moang we wau kaha.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Wiro bohong bera neo karirane na karirafo fanai,</para>
  <para style="q2" vid="PRO 20:22">bomang we Yahwei, I ambori fiata wau ki.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Inontarai mano titua fi maraba tuti sayayai na wiro warang mai kaha mani, Yahwei enerireuwi paria,</para>
  <para style="q2" vid="PRO 20:23">tuti I wiro firaise kahai we inontarai mano titua fi na sofa foi.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Inontarai ene wawua eraoane mani Yahwei dino samane,</para>
  <para style="q2" vid="PRO 20:24">nanai aino inontarai nesa wiro ewaitawang fio ambori esodairai na etarangfo kaha.<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Masino inontarai manei miaya we dohong korbani we Yahwei mani, enetituai nariai akawuruwori dererai ki,</para>
  <para style="q2" vid="PRO 20:25">weo bereri mani, ambori sobu dadirafo.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Mananu mano sewai mani, deroangno inontarai mandoni dino kerirane,</para>
  <para style="q2" vid="PRO 20:26">tuti dohong aiboi maraba wei na wiro enewawu kaha.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Inontarai nuaninunei mani toyari padamarangno Yahwei dohongni wei,</para>
  <para style="q2" vid="PRO 20:27">donio inontarainei deitawangnai kai na mantaungni enerorongfoi.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Mananu mano enewawu tuti enerorong pepayai we inontarai nei kia, i ambori niari mananufoi darang na mai,</para>
  <para style="q2" vid="PRO 20:28">tuti enewawufo ambori niariri yu parentafo papayaifa.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Fio niari inontarai efiai bariboaifoi mani, ne mambiriufo,</para>
  <para style="q2" vid="PRO 20:29">tuti fio niari inontarai etato wawafoi mani, fi bitoya sodairai na darangfo.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Inontarai mano niari karirafoi boia wekahai mani, ambori yiwang ne koang kerirao niaririfoi,</para>
  <para style="q2" vid="PRO 20:30">tuti bohong aiboi wei mani, ambori ruairurang fi karira na enerorongfoi.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Yahwei warangfo yu mananu enerorongfoi, netarai toyario I sang waya dedafoi,</para>
  <para style="q2" vid="PRO 21:1">tuti Dohongni deda todoni kontai kariri Eneoafo.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Inontarai eteitarahio fio enemitituaitai we enarifo mani mai ampa,</para>
  <para style="q2" vid="PRO 21:2">wape Yahwei dino titua kariri enemirorongfoine.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Nari bengfo tuti oarahanafo mani Yahwei enoa sewa weru</para>
  <para style="q2" vid="PRO 21:3">korbanio nunumi Weifoi.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Inontarai eharira fosa mani, enumikamiei fiabai tuti enemirorong tewa,</para>
  <para style="q2" vid="PRO 21:4">fi beru ninai kiasa to karirafo.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Inontarai mano ureng maya tuti enetituai saua fianai aino yu fo, ambori sobu fianggeng bitoya,</para>
  <para style="q2" vid="PRO 21:5">wape inontarai mano yu fi ahera funomafoi mani, ambori wiro sobu fianggeng bitoya kaha.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Ra wobu na taperemu tetofa mani,</para>
  <para style="q2" vid="PRO 21:6">ambori niai toyari riraung tuti rafoi ambori kia wau to mararehafoi.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Fi karirao inontarai eharira enarifo mani, ambori dohong kanggani we mantaunsa,</para>
  <para style="q2" vid="PRO 21:7">weo wiro emaya we etoarahangnai kaha.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Inontarai mano niari sarawafoi mani ne rangfo tahikapa,</para>
  <para style="q2" vid="PRO 21:8">wape inontarai mano wiro niari sarawa kahafoi ne rangfo mimoya.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Mesiri wau nayai na munu borieifo mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 21:9">munohi ria wiwing mano memuna biriufoi.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Inontarai kerirafoi mani enerorongfoi miaya we niari karirafo pampang,</para>
  <para style="q2" vid="PRO 21:10">tuti wiro enewawu inontarai siai kaha.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Na kutu wau bohong aiboi we mano deikanggani inontarai siaifo mani, inontarai mano wiro deitawang turura kahafoi deti finanai ambori sewai.</para>
  <para style="q2" vid="PRO 21:11">Na kutu inontarai mano sewaifoi bohong aunau wei mani, ambori deitawangnai werorong.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Allai Mano Doarahanai Deti saua fi kiaio inontarai kerirafoi niari na munu rorongfo,</para>
  <para style="q2" vid="PRO 21:12">tuti Kia inontarai kerirafoi to dadirafo.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Mandoni dino kiobu tarangfo weru inontarai mano ne pari fi foi sahu we fiatarifo mani,</para>
  <para style="q2" vid="PRO 21:13">wiro sobu fiea kaha, masino mantauni sahu we fatari.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Masino inontarai manei kesou wau mani, bohong fikahutuwa na mamunggasai ambori fafe ne kasoufo,</para>
  <para style="q2" vid="PRO 21:14">tuti masino bohong fikahutufo na wiro inontarai siai detioa kaha mani, ambori sona enerorong meninggapoifoi.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Oarahanafo mani wedaya inontarai mesifoi mirising,</para>
  <para style="q2" vid="PRO 21:15">wape inontarai mano niari karirafoi mani mitai.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Inontarai mano da weru rangno nemitituai kariri neo maifo mani,</para>
  <para style="q2" vid="PRO 21:16">ambori fiotourai na raimeri.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Inontarai mano darang na mei funong doi pampang na mirising mani, ambori ne fianggengfo naia kai,</para>
  <para style="q2" vid="PRO 21:17">inontarai mano mirising we muniarao fiang tuti fiunung bitoyafo mani, ambori ne pari fi.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Inontarai mano kerirafoi mantauni ambori sobu aiboi neo miaya we inontarai mesifoi sobuaifa,</para>
  <para style="q2" vid="PRO 21:18">tuti inontarai mano wiro roasoi kahafoi mani, mantauni ambori sodai dadirafo we riwang inontarai mano warang maifoi.<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Nayai na katai wiarora minanofoi mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 21:19">minohi ria wiwing mano kesou biriu tuti memunafoi.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Inontarai sewai ne munufoi mani, derara maningno ne harga dedai tuti ra,</para>
  <para style="q2" vid="PRO 21:20">wape inontarai mano wiro miaya we aunauwi kahafoi mani, mei funong ne fianggengfoi kiai.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Mandoni dino yurai we niari maifo tuti enewawu inontarai siai mani,</para>
  <para style="q2" vid="PRO 21:21">ambori minohi na mai, wonongfo beng tuti inontarai siai etoarahangnai wei.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Inontarai sewaifoi mani, ne mambiriu we dau roaing wore kamiei bendario afaimamuna ewaitawangnifoi,</para>
  <para style="q2" vid="PRO 21:22">tuti sota wore kamiei bendario inontarai bitoya eteitarahio weduasa.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Mandoni dino deitawang wedua borongfoi tuti taperengno medua naifoi mani,</para>
  <para style="q2" vid="PRO 21:23">ambori deitawang wedua mantauni weru dadirafo.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Inontarai mano miaya we deikangganiafoi mani, tewa tuti deitarahio andino denteng sewa weru inontarai siaine,</para>
  <para style="q2" vid="PRO 21:24">tuti niari fifiani kontai na ne tewao wiro werea kaha.<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Inontarai mano ureng marira we yu fi mani, ne fio miaya weafo aino ambori dohongni mireha.</para>
  <para style="q2" vid="PRO 21:25">weo wiro miaya we warangfo yu fi kaha.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Rahidafoi sentenang mani, enetituai pampang fianai aino miaya weafo terai,</para>
  <para style="q2" vid="PRO 21:26">wape inontarai mesifoi mani, dohong fi we inontarai siai pampang.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Yahwei enerireu inontarai kerirafoi ne korbanio niunumifoi,</para>
  <para style="q2" vid="PRO 21:27">sewa aha mani dohong korbani nunumi na sang neo karirafo.<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Inontarai mano wiro medu mai kariri fio detiofo kaha, na mano ehutu kaiwo fosa mani ambori sobu aiboifo,</para>
  <para style="q2" vid="PRO 21:28">wape inontarai mano warang maifoi, fio taraoafo mani, wiro fiotouo medu kariria kaha.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Inontarai mano kerirafoi niari fafiarai deitawangnai kai, tuti deinawi netarai we andino dentengne,</para>
  <para style="q2" vid="PRO 21:29">wape inontarai mano warang maifoi mani, enetituai nariai akawuruwori niari ki.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Nemu awai, numukamiei wewu tofong,</para>
  <para style="q2" vid="PRO 21:30">tuti nemu mambiriu we enemutituaitai na mai, nani kiai wiro wefia kaha na Yahwei urengfo.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Na rahida mamunafoi, afai mamuna fosa emainenang kudafo we emamuna nayai,</para>
  <para style="q2" vid="PRO 21:31">wape Yahwei dino Niarisa etahatawang ene aitetafosa ne.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Wonongmi bengne mani, mahikai sewa weru nemu ra bitoya,</para>
  <para style="q2" vid="PRO 22:1">inontarai siai etato wau mani, mahikai sewa weru peraki tuti emasinei.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Inontarai mano ne ra bitoya tuti mano ne parifoi mani umasi,</para>
  <para style="q2" vid="PRO 22:2">Yahwei Dino niari suru ne.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Inontarai mano nungkamiei wewu tofongfoi mani ambori dediwa, masino deti karirafo da wei ma,</para>
  <para style="q2" vid="PRO 22:3">wape inontarai mano wiro deitawang turura kahafoi da pampang, ampefe sobu karirafo.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Inontarai mano enerorong tewawa, yoaso Yahwei tuti somi wei mani,</para>
  <para style="q2" vid="PRO 22:4">ambori ne ra bitoya, wonongfo beng tuti darang na mai.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Inontarai kerirafoi mani, ne rangfoi sefangna ababo tuti waitepari,</para>
  <para style="q2" vid="PRO 22:5">ampefe mandoni dino miaya we kiaharai weru dadirafo mani, wiro da ria inontarai nani ne rangfoi fanai.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Bounau arikang nesa we etiri rang mesifoi,</para>
  <para style="q2" vid="PRO 22:6">ambori paria eweinongkutung mani, wiro era weru rang nani kaha.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Inontarai mano ne ra bitoyafoi weparenta sau inontarai mano ne pari fifoi,</para>
  <para style="q2" vid="PRO 22:7">tuti inontarai mano kia fianggengno wiro biaita kaharai mani, inontarai mano dohong fianggeng weifoi wemambiriu sauwi.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Inontarai mano sanang neo karirafo mani, ambori deting neo karirafo kontai,</para>
  <para style="q2" vid="PRO 22:8">tuti ne mambiriu we sahawatawang inontarai siaifo ambori werea.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Inontarai mano enerorong dentengfoi ambori sobu moang na Yahwei,</para>
  <para style="q2" vid="PRO 22:9">weo deto ne fiangfo we inontarai mano ne pari fifoi.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Ata inontarai mano enerireuwafoi, ambori mamunafo nai,</para>
  <para style="q2" vid="PRO 22:10">tuti fotou madu kahera wawerahai tuti kaiwo enemirireuwafo.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Inontarai mano miaya we enerorongfoi mirarebanai,</para>
  <para style="q2" vid="PRO 22:11">tuti medu kaiwo bengfo mani, i ambori wemaniwowiri we mananufoi.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Yahwei urengfo nayai na inontarai mano medu waitawangnai werorongfo ambori nai fanai,</para>
  <para style="q2" vid="PRO 22:12">wape I deiaya inontarai mano miaya we tetofafo.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Inontarai mano ureng marirafoi niayai na munufo terai,</para>
  <para style="q2" vid="PRO 22:13">medu deyo, “Singa manei niayai na borieifo, dohonao kiri yau na rang rabungfe.”<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Wiwing dirufoi borongfo mani toyario kamirei berorong,</para>
  <para style="q2" vid="PRO 22:14">inontarai mano Yahwei kesouwi foi ambori saurarang kamireifoi.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Bonggoifo tataha na arikang fosa enemirorongfoi,</para>
  <para style="q2" vid="PRO 22:15">wape aitatohi reafoi we aunausa ambori tawingsa weru ene bonggoifo.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Masino tahatawang inontarai mano ne pari fifoi ambori nemu ra bitoya,</para>
  <para style="q2" vid="PRO 22:16">ete bohong fikahutu we inontarai mano ne ra bitoyafoi, nana mani mantaung wauno ambori weinontarai mano ne pari fi.<verse eid="PRO 22:16" /></para>
  <para style="s">Kaiwo riwangsoai piareia sura na inontarai mano esawaifo</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Taramu sauao kaiwo riwangsoai ninai na inontarai mano esawai,</para>
  <para style="q2" vid="PRO 22:17">boti sauao nehu iwaitawangnai werorongno yeunauwai we waune.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Wau ambori furaise we kaiwo ninai, boraratai na enemurorongwai,</para>
  <para style="q2" vid="PRO 22:18">ambori moinenang we boisaharai we inontarai siai.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Yeunau fininai kai we wau na kutu ninai,</para>
  <para style="q2" vid="PRO 22:19">ambori roaso Yahwei.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Yau kawurua itoi kaiwo riwangsoai piareia sura ninai,</para>
  <para style="q2" vid="PRO 22:20">neo werorongfo mani kaiwo aunau tuti waitawangnai werorongno bengfo.<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Kaiwo ninai ambori dohong wau boitawangno maifo tuti tarai antufo,</para>
  <para style="q2" vid="PRO 22:21">tuti kontai ambori boisaharai na mai we inontarai mano demi wau foi.<verse eid="PRO 22:21" /></para>
  <para style="s">Kaiwo riwangsoai reantenang na inontarai sewai</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Wiro bowa inontarai ne pari fifoi fanai, weo finahang fefe,</para>
  <para style="q2" vid="PRO 22:22">tuti na kutu inontaraifoi doa medu sawatutiri na inontarai mano ehutukaiwofosa earomifo mani, wiro tahatawangni fanai.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Weo Yahwei sawatutu ne kaiwofo,</para>
  <para style="q2" vid="PRO 22:23">tuti kia inontarai mano dewarifoi nuanifoi.<verse eid="PRO 22:23" /></para>
  <para style="s">Kaiwo riwangsoai weberu na inontarai sewai</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Wiro furao inontarai mano ne rika menikapoifoi fanai,</para>
  <para style="q2" vid="PRO 22:24">wiro furao inontarai mano kesou biriufoi fanai,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />ambori wiro nemu tarai toyari i kaha,</para>
  <para style="q2" vid="PRO 22:25">tuti wiro bapa waitepari we mantaung wau kaha.<verse eid="PRO 22:25" /></para>
  <para style="s">Kaiwo riwangsoai webetoru na inontarai sewai</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Wiro borerai we inontarai siai</para>
  <para style="q2" vid="PRO 22:26">we bai kutu ne fio kiafo fanai.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Weo masino wiro bai fio kiafo kaha mani, ambori eha nemu fianggengwa kai,</para>
  <para style="q2" vid="PRO 22:27">tuti nemu fata benanaiwai.<verse eid="PRO 22:27" /></para>
  <para style="s">Kaiwo riwangsoai webea na inontarai sewai</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Wiro ka ruareafoi weru kahofa mamo,</para>
  <para style="q2" vid="PRO 22:28">neo kawurua wereng fosa etohongni wiatai na fafongpa fanai.<verse eid="PRO 22:28" /></para>
  <para style="s">Kaiwo riwangsoai webering na inontarai sewai</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Boti mano sewai na yu fifo manei kawuru ampane?</para>
  <para style="q2" vid="PRO 22:29">I ambori yufi fiata mananu fosa, wiro fiata inontarai batang fosa kaha.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s">Kaiwo riwangsoai webewonang na inontarai sewai</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Masino munohi bampi ria inontarai fuba manei mani,</para>
  <para style="q2" vid="PRO 23:1">botisaua fiangno watai na aromuwa.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Masino maya we bang fiang bitoya mani,</para>
  <para style="q2" vid="PRO 23:2">tawang enemurorongwai!<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Wiro enemuo ne fiangno maingfo fanai,</para>
  <para style="q2" vid="PRO 23:3">weo tarahio tetofa wau na fiang nanai.<verse eid="PRO 23:3" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai webeitu na inontarai sewai</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Wiro rurai ru fi na mambiriu we obu fianggeng bitoya fanai,</para>
  <para style="q2" vid="PRO 23:4">masino tofu kaiwo werorongfo mani fotouraia.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Arahio boti fianggengfoi mae, wanang fifua kiaia,</para>
  <para style="q2" vid="PRO 23:5">weo na tantuma fianggengfoi wewarapema,</para>
  <para style="q2" vid="PRO 23:5">tuti sifo to rorafaisi toyario romu enoi.<verse eid="PRO 23:5" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai weindeatoru na inontarai sewai</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Wiro bang fiangno inontarai mano warang mutufoi dohongnai we waufoi fanai,</para>
  <para style="q2" vid="PRO 23:6">wiro enemuo ne fiangno maingfo fanai.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Weo fiang bangwa mani detorai kawurua na enerorongfoi.</para>
  <para style="q2" vid="PRO 23:7">Medu we wau deyo, “Ro ma bangpi tuti bunung,”</para>
  <para style="q2" vid="PRO 23:7">wape enerorongfoi mani wiro mesi kariri kaiwo medurafo kaha.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Ampefe boyo momuta fiangno bang kawuru ampo,</para>
  <para style="q2" vid="PRO 23:8">tuti wau botuwa weo modu kaiwo beng wei kawurua.<verse eid="PRO 23:8" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai weindeata na inontarai sewai</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Wiro modu na inontarai mano wiro miaya we aunawi kahafoi tarangfo fanai,</para>
  <para style="q2" vid="PRO 23:9">weo i ambori enerireu nemu kaiwo awaiwa.<verse eid="PRO 23:9" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesura na inontarai sewai</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Wiro ka ruareafoi weru kahofao kawurua watai na fafongpa fanai,</para>
  <para style="q2" vid="PRO 23:10">tuti wiro bowa arikang awatafosa ene kahofafo fanai.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Weo Yahwei, ene Mamparirifoi mani Wemambiriu,</para>
  <para style="q2" vid="PRO 23:11">Andino sawatutusa we dapa wau.<verse eid="PRO 23:11" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya boyari na inontarai sewai</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Boitawang sauao aunau ninai,</para>
  <para style="q2" vid="PRO 23:12">tuti taramu sauao kaiwo ambori niari wau boitawangnai werorongfo.<verse eid="PRO 23:12" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya boru na inontarai sewai</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Wiro mutai we bounau nemu arikangfoi fanai,</para>
  <para style="q2" vid="PRO 23:13">i wiro mireha kaha masino boi na aiboifoi.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Wau boi na aiboifoi,</para>
  <para style="q2" vid="PRO 23:14">donio wau tawingni weru raimeri.<verse eid="PRO 23:14" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya botoru na inontarai sewai</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Nehu arikang ne wau, masino enemurorongwai sewai mani,</para>
  <para style="q2" vid="PRO 23:15">enehurorongnei kontai mirising.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Nuhuaninunei mirising,</para>
  <para style="q2" vid="PRO 23:16">masino boromurawawai medu kaiwo maifo.<verse eid="PRO 23:16" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya boa na inontarai sewai</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Wiro enemurorong kerira we fio inontarai mano ewe sasari fosa enengfo fanai,</para>
  <para style="q2" vid="PRO 23:17">wape roaso Yahwei tuti womi wei pampang.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Weo wau ambori barang na mai na rahida fui,</para>
  <para style="q2" vid="PRO 23:18">tuti fio enemutawangnafo ambori wobuaifa.<verse eid="PRO 23:18" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya ring na inontarai sewai</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Nehu arikangne wau, taramu nehu aunaune ambori wowai,</para>
  <para style="q2" vid="PRO 23:19">ro na rangno mesifoi.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Wiro furao inontarai mano emayeru pampang fosa,</para>
  <para style="q2" vid="PRO 23:20">tuti mano etananggoing andowa tarai fanai.<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Weo mano dunung biriufoi tuti mano denanggoingfoi ambori une pari fi,</para>
  <para style="q2" vid="PRO 23:21">tuti uwatai urena terai, donio utata ansung masiabufo.<verse eid="PRO 23:21" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya wonang na inontarai sewai</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Taramuo tamamuai mano dawing waunei,</para>
  <para style="q2" vid="PRO 23:22">tuti wiro enemurireu inamuai na kutu we wiwing kutungfo fanai.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Wori ne maifo tuti wiro bowayangna fanai,</para>
  <para style="q2" vid="PRO 23:23">tonanai kontai we awaifo, aunaufo tuti tafu kaiwo werorongfo<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Arikang mano mesifoi mani ne dai ambori firaise,</para>
  <para style="q2" vid="PRO 23:24">tuti dai mano ne arikangfosa esawai mani ambori mirarising.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Kadono wau we arikang tonana, ambori tamamuai tuti inamuai ufaraise,</para>
  <para style="q2" vid="PRO 23:25">kadono bohong mararising we wiwing mano dawing waunei.<verse eid="PRO 23:25" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya itu na inontarai sewai</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Nehu arikang ne wau, taramu saua fi kiaio imadurai ninai,</para>
  <para style="q2" vid="PRO 23:26">tuti kadono uremuwa deti nehu yarangne toane ambori nari kaririaifa.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Weo wiwing dirufoi mani, netarai toyario kamirei berorongfoi,</para>
  <para style="q2" vid="PRO 23:27">tuti wiwing mano wiro mei kaha mani, netarai toyario kamirei mereha dedira ambori dohong wau tawaifa.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Kontaio, i mani netarai toyario inontarai kerira mano dediwa tuti tefu wau,</para>
  <para style="q2" vid="PRO 23:28">i kontaio wewori mang bitoya we wiro erutawang ene kaiwo arerai ria ene wiwingfosa kaha.<verse eid="PRO 23:28" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wesuraya indeatoru na inontarai sewai</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Mandoni dino deisaharai? Mandoni dino arohuayai?</para>
  <para style="q2" vid="PRO 23:29">Mandoni dino memuna? Mandoni weansarai?</para>
  <para style="q2" vid="PRO 23:29">Mandoni dino sobu kahai na wiro fiea kaha? Mandoni dino ureng barika?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Ea mani inontarai mano eminohi etunung angguri bitoya paria diru rabuang,</para>
  <para style="q2" vid="PRO 23:30">erama tuti erawa eserawe anggurio indomifoi we etunumi.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Wiro mewati we anggurifoi fanai, masino berika tuti denteng,</para>
  <para style="q2" vid="PRO 23:31">tuti wewa na nofi rorongfo,</para>
  <para style="q2" vid="PRO 23:31">deda suayai na miaing paria.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Wape mayeai kiri wau toyario tawai,</para>
  <para style="q2" vid="PRO 23:32">tuti birari ne memufoi toyari tawai memunafoi.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Ambori uremu wa boti fianggeng tantuma,</para>
  <para style="q2" vid="PRO 23:33">tuti enemurorongwai modu funong kaiwo beng kaha.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Wau nemu tarai toyari inontarai mano niayai na andeisa rorong na rawanangrau,</para>
  <para style="q2" vid="PRO 23:34">toyari inontarai niayai na aisiang kapari.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Wau ambori modu boyo, “Inontarai eboi yau, wape yau wiro nuhuruaingso ipiraha kaha.</para>
  <para style="q2" vid="PRO 23:35">Inontarai eboi yau wape wiro yeitawang fiea kaha.</para>
  <para style="q1" vid="PRO 23:35">Masino urehu tawasa aha mani,</para>
  <para style="q2" vid="PRO 23:35">iserawe anggur aha.”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s">Kaiwo riwangsoai wesuraya indeata na inontarai sewai</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Wiro enemurorong kerira we inontarai mano eharira fosa ene fifo fanai,</para>
  <para style="q2" vid="PRO 24:1">wiro maya we wemaniwowiri riasa fanai.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Weo manta enemitituaitai we etahatawang inontarai siai,</para>
  <para style="q2" vid="PRO 24:2">tuti eboromi rawafo manta emadu we todoni enari inontarai siai esobu dadirafo.<verse eid="PRO 24:2" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiarei na inontarai sewai</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Munufoi baungni na awaifo,</para>
  <para style="q2" vid="PRO 24:3">na nemitituai kariri neo maifo mani munufoi doa pepayai,<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />tuti na nemu boitawangnai werorongfo</para>
  <para style="q2" vid="PRO 24:4">wau ambori woni fianggeng mahikai tuti ne harga dadai nemu munufoi ne rorongfo.<verse eid="PRO 24:4" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia boyari na inontarai sewai</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Inontarai mano sewaifo mani wemambiriu,</para>
  <para style="q2" vid="PRO 24:5">i mani wemambiriu sewa weru inontarai mano ne mambiriu we niari fi na maifoi.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Nanai aino wobu wiwiaing akawuruwori momuna ki,</para>
  <para style="q2" vid="PRO 24:6">tuti ambori wobu wawoafo, masino taramuo aunau na mantainau bitoya.<verse eid="PRO 24:6" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia boru na inontarai sewai</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Inontarai mano webonggoifoi dadira we deitawang kaiwo awaifo,</para>
  <para style="q2" vid="PRO 24:7">tuti wiro fiobai borong we medu fio beng we inontarai na kutu fianduhi riasafo.<verse eid="PRO 24:7" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia botoru na inontarai sewai</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Mandoni dino enetituai kariri neo karirafo pampang mani,</para>
  <para style="q2" vid="PRO 24:8">inontarai ambori esahui we mano tetofa biriu dine.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Fi kiaio inontarai webonggoifoi samafo mani kia sasari,</para>
  <para style="q2" vid="PRO 24:9">tuti inontarai mano deikaherawa mani ambori inontarai enemirirewi.<verse eid="PRO 24:9" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia boa na inontarai sewai</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Masino wiro murising kaha na kutu dadirafo mani,</para>
  <para style="q2" vid="PRO 24:10">wiro nemu mambiriuwa fea kaha.<verse eid="PRO 24:10" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia ring na inontarai sewai</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Masino eha inontarai mano wiro dohong sarawa kaha manei we emuni mani, tawing inontarai nani,</para>
  <para style="q2" vid="PRO 24:11">inontarai mano sobu aiboi mararehafoi masino wiro dohong sarawa kahafoi mani, wiro tuati mireha fanai.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Wiro modu fafiarai boyo, “Wiro yeroanso inontarai nani kaha!”</para>
  <para style="q2" vid="PRO 24:12">Boitarahio Allai wiro deitawang fi kiaio nariri nani kahae?</para>
  <para style="q1" vid="PRO 24:12">Boitarahio wiro Deti kariri wau tuti wiro Deitawang fio enemutituaitawa kahae?</para>
  <para style="q2" vid="PRO 24:12">Wiro tonana kaha, I ambori dohong berahai kariri fio nari kawuruampo.<verse eid="PRO 24:12" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia wonang na inontarai sewai</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Nehu kaisung ne wau, bang aniwa ne maing weo denteng we wau,</para>
  <para style="q2" vid="PRO 24:13">tuti aniwa ne maingnei memisi we boromuwai.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Tonanai kontai awainei mani, denteng we nemu barangfo,</para>
  <para style="q2" vid="PRO 24:14">masino nemu awai mani, ambori wobu neo bengfo na rahida bo da ahama wani ki,</para>
  <para style="q2" vid="PRO 24:14">tuti fio enemutawangnafo ambori wobuaifa.<verse eid="PRO 24:14" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia itu na inontarai sewai</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Wiro nari toyario inontarai kerira mano sang neo karirafo we kiamanana inontarai mesifoi ne munufoi,</para>
  <para style="q2" vid="PRO 24:15">wiro tota ne katai niayai naifoi fanai.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Weo masino inontarai mesifoi sawai we beitu, ambori doari aha,</para>
  <para style="q2" vid="PRO 24:16">wape masino inontarai kerirafoi saurarang neo karirafo mani, wiro doari ahang kaha.<verse eid="PRO 24:16" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia indeatoru na inontarai sewai</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Wiro furaise fanai masino nemu aitetafoi sawaifa,</para>
  <para style="q2" vid="PRO 24:17">wiro enemurorong mirising fanai masino sobu karirafo,<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />ambori Yahwei wiro deti wau mani weinontarai karira tuti enerireu fio nariwa paria,</para>
  <para style="q2" vid="PRO 24:18">tuti wiro Dohong aiboi we nemu aitetafoi kaha.<verse eid="PRO 24:18" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia indeata na inontarai sewai</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Wiro kasou weo inontaraio enari karirafo fanai,</para>
  <para style="q2" vid="PRO 24:19">ete wiro enemurorong kerira we inontarai mano eharira fosa fanai.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Weo wiro mahikai feai we inontarai eharira nesa na rahida bo da ahama wani kaha,</para>
  <para style="q2" vid="PRO 24:20">inontarai eharira fosa mani ambori enetarai toyario padamarang fefe.<verse eid="PRO 24:20" /></para>
  <para style="b" />
  <para style="s">Kaiwo riwangsoai wepiareia sura na inontarai sewai</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Nehu arikang ne wau, roaso Yahwei tuti womi wei tuti mananufoi,</para>
  <para style="q2" vid="PRO 24:21">wiro kontai ria inontarai mano etapa surufo fanai.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Weo unari neo karirafo na tantuma,</para>
  <para style="q2" vid="PRO 24:22">tuti wiro inontarai manei deitawangna kaha, aiboi fianai aino ambori urohongnai we inontarai mano etapa surufo.<verse eid="PRO 24:22" /></para>
  <para style="s">Kaiwo nemitituai kariri neo maio siai fea</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />Kaiwo siai na inontarai mano sewaifoi sonina.</para>
  <para style="q2" vid="PRO 24:23">Masino wiro boarahana kaha mae tauwe manei, nana mani wiro beng kaha.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Ampefe masino modu we inontarai kerirafoi weo wiro niari sarawa kaha,</para>
  <para style="q2" vid="PRO 24:24">nana mani inontarai fosa ambori eteikanggani wau, tuti kaiwasa fosa enemirireu wau.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Wape masino bohong aiboi we inontarai mano dohong sarawafoi mani, inontarai ambori esomi we wau,</para>
  <para style="q2" vid="PRO 24:25">tuti wau ambori wobu moang.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Ampefe kutu kaiwo mani modu na mai, nari inontarai enemirorong mirising toyario faung nemu maniwowiri,</para>
  <para style="q2" vid="PRO 24:26">ambori enemuwawuti.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Nari romi tuti tanang fiang akawuruwo,</para>
  <para style="q2" vid="PRO 24:27">paria nemu fi ru na wanaifa kai,</para>
  <para style="q2" vid="PRO 24:27">mayeai baung nemu munufoi.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Wiro modu funong inontarai siai fanai weo niari sarawaifa, masino wiro boti tera kaha,</para>
  <para style="q2" vid="PRO 24:28">tuti wiro kaiwo tatofafo dariai na boromuwa kariri i fanai.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Wiro modu boyo, “Deikanggani yau kawuru ampa, ampefe yau kontai imeikanggani aha.</para>
  <para style="q2" vid="PRO 24:29">Yau ambori yohong berahai wei aha, toyari fio niari we yaufo.”<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Na rabuang bo ira na romi inontarai ureng marirafoi</para>
  <para style="q2" vid="PRO 24:30">kontai romi angguri inontarai mano wiro enetituai kariri neo mai kahafoi,<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />yeti romifoi kawurua sifuo ninoi weababo,</para>
  <para style="q2" vid="PRO 24:31">ne kahofafo mani ninoi sa funomafoi tebung weduarai,</para>
  <para style="q2" vid="PRO 24:31">tuti ne worefoi miru kawuru ampa.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Yeti sauaraifa tuti enehutituaitai kaririaifa,</para>
  <para style="q2" vid="PRO 24:32">tuti isobu aunau na fio yetioai ninaifa.<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Masino imadu yeyo, “Ah, yena kuteai akawuruwo, urehu mamong,</para>
  <para style="q2" vid="PRO 24:33">iminohi ikafa warahu tuti yena kuteai terai.”<note caller="-" style="x"><char style="xo" closed="false">24:33-34 </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">Kaiw. 6:10-11</ref>.</char></note><verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Na kutu yenafo, na tantuma nehu pari fi, toyari inontarai kerira da kawuru ma kia nehu fianggengfoi kiai,</para>
  <para style="q2" vid="PRO 24:34">tuti nehu fianggeng demoyara kaha, toyari inontarai mano na nefi mamunafo dewa nehu fianggengfoi kiai weru yau.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Salomoi ne kaiwo riwangsoai siai fea aha</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Kaiwo awai feai aha na mananu Salomoi, neo Hiskiai mananu Yehudai ne mano eru fi weifoi etoi riwangnai aha finina.<verse eid="PRO 25:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Inontarai nesa efiai Allai, weo niari fiea mani Dediwarai werusa,</para>
  <para style="q2" vid="PRO 25:2">wape inontarai nesa efiai mananu nesa weo kaiwo dadirafo mani eteisaharai kasau.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Toyari rora faisi ne dedaifo tuti nunei ne berorongfo,</para>
  <para style="q2" vid="PRO 25:3">tonanai kontai wiro tawaitawang mananufoi fio enetituaitafo kaha.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Ufirurang rarikafoi weru perakifoi,</para>
  <para style="q2" vid="PRO 25:4">ambori mano niari perakifoi, niari fio mahikai sewa fea.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Tonanai kontai mantainau eharira fosa wiro tuasa etohong aunau karirafo we mananufoi fanai,</para>
  <para style="q2" vid="PRO 25:5">ambori mananufoi ne parentafo papayai na kutu niari neo maifo.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Wiro ruai enemurorongwai na mananu arongfo fanai,</para>
  <para style="q2" vid="PRO 25:6">ete wiro nari wau nemutarai toyario inontarai fiabai na kutu boari ria inontarai baba fosa fanai.<note caller="-" style="x"><char style="xo" closed="false">25:6-7 </char><char style="xt" closed="false"><ref loc="LUK 14:8-10">Luk. 14:8-10</ref>. </char></note><verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Weo mananufoi demi wau munohi na katai inontarai baba fosa mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 25:7">dohong mamaya wau na earomifo.<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />Masino boti inontarai siai manei niari fiea mani, wiro wukahera ro we inontarai mano kiutu kaiwofo we boisaha fianai aino botioafo tuti bonggewa inontarai nani fanai.</para>
  <para style="q2" vid="PRO 25:8">Dohonao mumayafe, masino inontarai siai manei deinawiai weo wauno wiro modu mai kahafe,</para>
  <para style="q2" vid="PRO 25:8">fianai aino nari ahane?<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Masino nemu maniwowiri manei mukasou muru mani, mumadu ruhiai na muru terai,</para>
  <para style="q2" vid="PRO 25:9">tuti dohonao boisaharai we inontarai fau fosa kariri ne kaiwo adiwarafo fe,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />ambori wiro enerireu wau kaha, na kutu taraoai we wau modurifo,</para>
  <para style="q2" vid="PRO 25:10">tuti wiro deiriri karirafo we wau kaha.<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Kaiwo inontarai manei medurai tete ne rahidafo mani,</para>
  <para style="q2" vid="PRO 25:11">toyari aibong emasi na rewanggoai peraki.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Kaiwo uarai na inontarai mano sewaifoi mani ne harga dedai, toyari emasi keisori tuti fimarandinai emasi</para>
  <para style="q2" vid="PRO 25:12">we inontarai mano tarangfo miaya we taraoaifa.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Toyari mereha denunanang dohong wawasa na kutu wemunudangfo,</para>
  <para style="q2" vid="PRO 25:13">tonanai kontai we mangfata mano enerorong pepayafoi,</para>
  <para style="q2" vid="PRO 25:13">i dohong faraise we inontarai mano yufi weifoi na kutu demifo.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Kafafe tuti wanang unayane, wape metang bereri,</para>
  <para style="q2" vid="PRO 25:14">tonanai kontai we inontarai mano dererai we dohong fikahutufo, wape wiro dohongna kaha.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Masino enemurorongwai tawani mani, nari inontarai mano wemambiriufoi yoaso wau,</para>
  <para style="q2" vid="PRO 25:15">tuti masino taperemuwai medu na kaiwo fanahang mani, inontarai mano nungkamiei mitubarufoi nariria wiro dapa wau kaha.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Masino wobu aniwa ne maing mani, wiro bang fuba karera fanai,</para>
  <para style="q2" vid="PRO 25:16">dohonao momosi paria tuti mayeai mani momutafe.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Wiro ro pampang to nemu maniwowiri ne munufoi fanai,</para>
  <para style="q2" vid="PRO 25:17">dohonao deuwau tuti wiro miaya we wau kahafe.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Masino modu wiro mai kariri nemu maniwowirifoi we inontarai mano kiutu kaiwofoi mani,</para>
  <para style="q2" vid="PRO 25:18">nemutarai toyario aiboi, umbe sondu tuti ato reisao miungni.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Enemutawang inontarai mano wiro roasoi kahafoi we fiata wau na kutu obu dadirafo mani,</para>
  <para style="q2" vid="PRO 25:19">nana mani netarai toyario mama fiang na deremu bereri tuti ro na awemu pirahai.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Rohi rarung faraise we inontarai mano enerorong fituayai mani,</para>
  <para style="q2" vid="PRO 25:20">toyari bisu ne ansungfo na kutu daunanangfo,</para>
  <para style="q2" vid="PRO 25:20">tuti wari cuka to ne kahaifoi.<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Masino inontarai mano enerireu waufoi wewisi mani, bohong fiang feai dang,</para>
  <para style="q2" vid="PRO 25:21">tuti masino arong tataha mani, bohong mereha feai dunung.<note caller="-" style="x"><char style="xo" closed="false">25:21-22 </char><char style="xt" closed="false"><ref loc="ROM 12:20">Rm. 12:20</ref>.</char></note><verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Weo na tonanane mani, wau nariria deitawangnai we dohong sarawaifa tuti mimaya,</para>
  <para style="q2" vid="PRO 25:22">tuti Yahwei ambori dohong bera nemu bengwa.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Toyari kafafe memantiti wedaya metang,</para>
  <para style="q2" vid="PRO 25:23">tonanai kontai taperemio deiriri fi adiwarafo we inontarai bitoyafoi mani, wedaya inontaraifoi kesou.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Mesiri wau nayai na munu borieifo mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 25:24">munohi ria wiwing mano memuna biriufoi.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Toyari mereha deunanang we inontarai mano arong tatahanei,</para>
  <para style="q2" vid="PRO 25:25">tonanai kontai taramio kaiwo mahikaifo da na katai wairoifo ma.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Inontarai mesi mano enerorong finahang tuti suang we inontarai kerira mano sahatawanifoi,</para>
  <para style="q2" vid="PRO 25:26">i mani netarai toyario inontarai mano niari rarika we mereha urengno mirarebanafoi.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Bang aniwa ne maing bitoya karera mani, nanai wiro beng kaha,</para>
  <para style="q2" vid="PRO 25:27">tuti rurai we wobu kaiwo fiai bitoya mani, nanai kontai wiro beng kaha.<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Inontarai mano mantauni wiro sawani na ne kasoufo kaha mani,</para>
  <para style="q2" vid="PRO 25:28">netarai toyari bendario wiro ne pari wore dariweduari.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Toyari kawari na wemunudangfo tuti metang na kutu eting fitantanangfo,</para>
  <para style="q2" vid="PRO 26:1">tonanai kontai inontarai mano wiro miaya we aunawi kahafoi, wiro mei we omi wei kaha.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Toyari romu sinsumiri tuti romu anggadi baya usifo towana-tonina tuti wiro uminohi na kahofafo kaha,</para>
  <para style="q2" vid="PRO 26:2">tonanai kontai kaiwo kangganifo wiro tete inontarai mano wiro dohong sarawa kahafoi.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Kudanei mani rubati tuti keledainei mani rabiti na wai na rahanangfoi,</para>
  <para style="q2" vid="PRO 26:3">tonanai kontai inontarai mano wiro miaya we aunawi kahafoi mani boi kurungfoi na aiboi.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Wiro roa we inontarai mano wiro miaya we aunawi kahafoi, toyari ne kaiwo bonggoi medurafo fanai,</para>
  <para style="q2" vid="PRO 26:4">ambori wiro nemutarai kariri kaha.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Roa we inontarai mano wiro miaya we aunawi kahafoi kariri ne bonggoifo,</para>
  <para style="q2" vid="PRO 26:5">ambori dohonao deitarahio mantauni sewaine.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Mandoni dino demi inontarai mano wiro miaya we aunawi kahafoi we deisaha kaiwo arera mani,</para>
  <para style="q2" vid="PRO 26:6">toyario ferangkutu mantauni awengfoi tuti dunung fi memu.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Toyari inontarai mano fiaya, ne aweng wape fananahang wiro wefia kaha,</para>
  <para style="q2" vid="PRO 26:7">tonanai kontai inontarai mano wiro miaya we aunawi kahafoi medu kaiwo riwangsoafo.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Womi we inontarai mano wiro miaya we aunawi kahafoi mani wiro wefia kaha,</para>
  <para style="q2" vid="PRO 26:8">netarai toyario kamieifoi kepang na kartafelifoi ampefe wiro defai kaha.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Inontarai mano wiro miaya we aunawi kahafoi medu kaiwo riwangsoafo mani wiro wefia kaha,</para>
  <para style="q2" vid="PRO 26:9">netarai toyari inontarai mano meyeru fiating ababo disang warangfoi.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Mandoni dino demi inontarai mano wiro miaya we aunawi kahafoi tuti inontarai aisei mano dama tuti dawaha we uru fi mani, i ambori niari inontarai bitoya esobu dadira,</para>
  <para style="q2" vid="PRO 26:10">netarai toyari inontarai mano dana funomai tuti inontarai bitoya ewe kahai.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Inontarai mano wiro miaya we aunawi kahafoi niari ne bonggoifo pampang,</para>
  <para style="q2" vid="PRO 26:11">toyari fiawera daraberahi dang ne mamutafoi aha.<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="2PE 2:22">2Ptr. 2:22</ref>. </char></note><verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Boti inontarai mano deitarahio mantauni sewai,</para>
  <para style="q2" vid="PRO 26:12">bounauwi mani dadira sewa weru bounau inontarai mano wiro miaya we aunawi kahafoi.<verse eid="PRO 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Inontarai mano ureng marirafoi niayai na munufo terai,</para>
  <para style="q2" vid="PRO 26:13">medu deyo, “Singa manei niayai na borieifo, dohonao kiri yau na rang rabuangfe.”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Toyari rahutu dari na ne engselifoi,</para>
  <para style="q2" vid="PRO 26:14">tonanai kontai inontarai mano ureng marirafoi bebariri na fata dena naifoi.<verse eid="PRO 26:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PRO 26:15" />Inontarai mano ureng marirafoi sa warangfo rarang rewangguaifoi,</para>
  <para style="q2" vid="PRO 26:15">wape wiro miaya we yuai warangfo to borongfo kaha.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Inontarai mano ureng marirafoi deitarahio mantauni dino sewai sewa weru</para>
  <para style="q2" vid="PRO 26:16">inontarai ituo itoroa na maifo.<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Inontarai mano kiontai ria inontarai siai ne mamunafoi mani,</para>
  <para style="q2" vid="PRO 26:17">netarai toyario inontarai mano tefu fiawera da funomai tarandaungfoi.<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Toyari inontarai wefiauwou dana</para>
  <para style="q2" vid="PRO 26:18">ato denggararu tuti ming inontarai,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />tonanai kontai inontarai mano tetofa inontarai siai,</para>
  <para style="q2" vid="PRO 26:19">tuti medu deyo, “Manta imei teraifa.”<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Masino aimasa kai mani, adia fafe,</para>
  <para style="q2" vid="PRO 26:20">masino inontarai mano deiriri funong inontarai bereri mani, mamunafoi fiotourai.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Toyari ke niari karaiseng denggararu tuti aimasa niari adia denggararu,</para>
  <para style="q2" vid="PRO 26:21">tonanai kontai inontarai mano serawe kaiwo mani niari adia mamunafoi denggararu.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Airiri funong inontarai mani toyari fiang maing,</para>
  <para style="q2" vid="PRO 26:22">ampefe inontarai emaya we etongnaifa.<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Toyari babeu kahofao tiabau tofarai tabuni na peraki ambori denteng,</para>
  <para style="q2" vid="PRO 26:23">tonanai kontai madu kaiwo mamisi wape nemirorong kerira.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Inontarai mano enerireuafoi medu kaiwo mamisi,</para>
  <para style="q2" vid="PRO 26:24">wape sang neo karirafo na enerorongfoi.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Masino ne kaiwofo fanahang mani, wiro roasoi fanai,</para>
  <para style="q2" vid="PRO 26:25">weo enerorongfoi sefangna karirafo.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Masino dediwa enerirewafo na tetofa,</para>
  <para style="q2" vid="PRO 26:26">wape inontaraifoi kiai ambori ewati fi karira niarifo.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Mandoni dino sirai kamirei we inontarai siai mani, mantauni ambori saukahari,</para>
  <para style="q2" vid="PRO 26:27">tuti mandoni dino dedoi kamiei we wiatawang inontarai siai mani, kamieifoi ambori daraberahi wiatawangni aha.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Mandoni dino tetofa inontarai siai mani, enerireu inontarai nani,</para>
  <para style="q2" vid="PRO 26:28">tuti kaiwo sefangna tatofa mani kia karirafo.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Wiro boi aromu we fio nari na rahida fui fanai,</para>
  <para style="q2" vid="PRO 27:1">weo wiro boitawang fio ambori dariai na rahida da ahamafoi kaha.<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">Yak. 4:13-16</ref>. </char></note><verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Wiro boromuwa fiai bera mantaung wau fanai, kadono inontarai siai efiai wau,</para>
  <para style="q2" vid="PRO 27:2">kontaio kadono inontarai manei deiriri kariri nemu bengfo mani, wiro boromurawanei deiriria fanai.<verse eid="PRO 27:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 27:3" />Kamieinei mani miraba tuti ninuaingnei kontaio ne maraba,</para>
  <para style="q2" vid="PRO 27:3">wape neo maraba sewa fi beru nina mani, nemirorong pirahai we fio inontarai webonggoi niarifo.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Inontarai mano enerorong meninggapoi tuti minsangsoang mani wiro enewawu kaha,</para>
  <para style="q2" vid="PRO 27:4">wape mang mano enerorong pirahafoi mani ureng mamang sewa, mandoni dino yutawangni?<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Uari parai mani mahikai sewa weru</para>
  <para style="q2" vid="PRO 27:5">enemuwawuti wape nemuborututu ne sarawafo.<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Maniwowiri manei bioi wau we neo bengfo,</para>
  <para style="q2" vid="PRO 27:6">wape inontarai mano enerireu waufoi, tetofa wau na niuna wau bitoya paria.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Inontarai mano memosinei, wiro miaya we dang aniwa ne maingnei kaha,</para>
  <para style="q2" vid="PRO 27:7">wape inontarai mano wewisinei mani, fi kiaio pirandimanei niruainsoi memisi.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Inontarai mano dontai waroi weru ne munufoi tuti serawawera da to doni,</para>
  <para style="q2" vid="PRO 27:8">i mani netarai toyari romu sifo weru ne aisanggingfoi.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Maning saituni tuti fi nunsai mamporifo niari nemirorong firaise,</para>
  <para style="q2" vid="PRO 27:9">tonanai kontai maniwowiri dentengfoi ne kaiwo aunauo bengfo.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Wiro aromuporo nemu maniwowirinei tuti nemu dai ne maniwowirifoi fanai.</para>
  <para style="q2" vid="PRO 27:10">Na kutu wobu dadirafo mani, wiro ro to nemu doroi ne munufoi fanai.</para>
  <para style="q1" vid="PRO 27:10">Ro we nemu munu wararengfosa mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 27:10">ro we nemu doroi niayai waroifoi.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Nehu kaisungne wau, kadono wowai, nari enehurorongnei firaise,</para>
  <para style="q2" vid="PRO 27:11">ambori imadu we inontarai mano eteiwe yau fosa aha.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Masino inontarai mano nungkamiei wewu tofongfoi deti karirafo mani, dediwa netarai,</para>
  <para style="q2" vid="PRO 27:12">wape inontarai mano wiro deitawangna turura kahafoi da pari, donio sobu karirafo.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Masino inontarai mano dererai we biai kutu inontarai siai manei ne fi kiafo mani, ka inontarai mano dohong kaiwo arerai nani ne fio harga dadaifo,</para>
  <para style="q2" vid="PRO 27:13">tuti rutawangnaifa, paria biaitai kai.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Mandoni dino kamiai kutung dohong mahikai we ne munu warareng fosa na rawafui fiabai mani,</para>
  <para style="q2" vid="PRO 27:14">inontarai mano etaramioa fosa enumiruainso fi nanai we aikangganiai wiro moang kaha.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Wiwing mano memuna biriufoi mani,</para>
  <para style="q2" vid="PRO 27:15">netarai toyario mereha deda pampang na antaraung miti na kutu wemetangfo.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Dadira we wua wiwingno memuna biriufoi we fiotourai, nana mani netarai toyario rutawangno wanangba,</para>
  <para style="q2" vid="PRO 27:16">tuti toyario rukanggung maning.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Besi kika besinei reisa,</para>
  <para style="q2" vid="PRO 27:17">tonanai kontai inontarai nesa etaunau wawerasa ambori esawai.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Mandoni dino derara ai urungnei mani, ambori dang bongnei,</para>
  <para style="q2" vid="PRO 27:18">tuti mandoni dino deitawang ne mano yu fi weifoi mani, ambori detori.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Toyari inontarai manei deti to merehafoi, tuti merehafoi deinawi urengfo,</para>
  <para style="q2" vid="PRO 27:19">tonanai kontai inontarai enerorongnei deinawi bera mantauni.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Raimeri wiro fiotou song inontarai marareha kaha,</para>
  <para style="q2" vid="PRO 27:20">tonanai kontai toyari inontarai nesa, fio enemioafo mani wiro efotou we etawi wea kaha.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Emasi tuti perakinei rang suru na adiafoi ambori aroang suru na ukaisorifo,</para>
  <para style="q2" vid="PRO 27:21">tonanai kontai inontaraifoi ambori tataroangni weo i mani inontarai netarai toyari fiani na kutu tafiaifo.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Masino boi inontarai webonggoifoi toyario tuta pa nei,</para>
  <para style="q2" vid="PRO 27:22">ne webonggoifo wiro nai werui kaha.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Boitawang nemu kambing tuti domba nesa, ebeng ete bererie,</para>
  <para style="q2" vid="PRO 27:23">bohung sua nemu fiahung nesa.<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />Weo ranei mani wiro wiatai we fitawafa kaha,</para>
  <para style="q2" vid="PRO 27:24">tuti sapewi mananunei wiro pepayai we ne riria bia we riria kaha.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Ferang kahutu ninoinei we fiahung fosa ene fiang, ambori rerori weworufoi dariai aha,</para>
  <para style="q2" vid="PRO 27:25">tuti ninoi na wiwoi wetarareifo fanduhi tuti ararati,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />ambori nemu domba antung nesa enumiwawurufo we nemu ansung,</para>
  <para style="q2" vid="PRO 27:26">tuti kambing mang fosa bowayangsa, ambori doifo we wori kahofa.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Ambori nemu ui na kambing wiwing fosa, we wau tuti nemu munurorongfo ene fiang kontai,</para>
  <para style="q2" vid="PRO 27:27">tuti nemu mangfata wiwing fosa ambori etarang na mai.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Inontarai kerirafoi mito, masino wiro manei dawi kaha,</para>
  <para style="q2" vid="PRO 28:1">wape inontarai mesifoi niruainso mai toyari singa antung.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Masino raifoi emung wawerasa pampang mani, mano ewenunggamiei fosa riwangsa pampang,</para>
  <para style="q2" vid="PRO 28:2">tuti masino mano yu parentafoi nungkamiei wewu tofong, tuti deitawang werorongfo mani, raifoi ambori enari kariri kaiwo ohong kaririafo.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Inontarai mano ne pari fi manei sahatawang inontarai mano enepari fi fosa,</para>
  <para style="q2" vid="PRO 28:3">inontarai nani netarai toyario metangparao dohong romifoi kerira tuti wiro wetarai kaha.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Inontarai mano wiro niari kariri kaiwo ohong kaririane kaha mani, sawai we inontarai eharira fosa,</para>
  <para style="q2" vid="PRO 28:4">wape inontarai mano niari kariri kaiwo ohong kaririane mani, dapa inontarai eharira fosa.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Inontarai kerirafoi mani, wiro deitawang kariri oarahangnane kaha,</para>
  <para style="q2" vid="PRO 28:5">wape inontarai mano serawe Yahwei mani, deitawangno fianggengnei kiai.<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Inontarai mano ne pari fi wape ne koangfoi mirarebanai mani, mahikai sewa weru</para>
  <para style="q2" vid="PRO 28:6">inontarai mano ne ra bitoya wape sofa biriu.<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Inontarai mano dohong kariri kaiwo ohong kaririane, i mani arikangno deitawang kariri neo maifo,</para>
  <para style="q2" vid="PRO 28:7">wape inontaraio firao inontarai mano wiro eteitawang mamaya kaha mani, arikang nani dohong mamaya ne dai.<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Masino fanduhi ra bitoya na bohong doi we inontarai siai, tuti butani we dohong beraha mani fau sewa,</para>
  <para style="q2" vid="PRO 28:8">ampefe nemu rawai ambori sawai to inontarai mano enemiwawu fosa ewaramifo, ambori etatori we efata inontarai mano ene pari fi fosa.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Mandoni dino tarangfo wiro miaya we tarao kaiwo ohong kaririafo kaha mani,</para>
  <para style="q2" vid="PRO 28:9">Allai kontaio wiro miaya we tarao ne nadifoi kaha.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Mandoni dino wedaya inontarai warang mainei niari fio karirafo mani,</para>
  <para style="q2" vid="PRO 28:10">mantauni ambori sawai rarang kamirei siraifoi, weo niari inontarai siai sawai fefe,</para>
  <para style="q2" vid="PRO 28:10">wape inontarai mano mesifoi ambori sobu mahikai.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Inontarai ne ra bitoyafoi deitarahio mantauni sewaine,</para>
  <para style="q2" vid="PRO 28:11">wape inontarai ne pari fi mano tefu kaiwo werorongfo deitawangnai weo inontaraio ne ra bitoyafoi, wiro sewai kaha.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Masino inontarai mesifoi wenunggamiei mani, inontarai bitoya efayai,</para>
  <para style="q2" vid="PRO 28:12">wape masino inontarai kerirafoi sobu mambiriu mani, inontarai etadiwa ene tarai.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Mandoni dino na mamunggasai dediwa ne sarawafo mani, wiro sobu mai kaha,</para>
  <para style="q2" vid="PRO 28:13">wape mandoni dino deisaharai tuti fiotou niari sarawafo mani, Allai ambori enewawuti.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Inontarai mano yoaso Yahwei tuti somi wei pampang mani, sobu maifo,</para>
  <para style="q2" vid="PRO 28:14">wape inontarai mano enerorong mitubarunei ambori sawai to karira rorongfo.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Toyari singa deroa ete andowa memuna dawi inontarai,</para>
  <para style="q2" vid="PRO 28:15">tonanai kontai mano wenunggamei kerirafoi sahatawang inontarai mano ene pari fi fosa.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Inontarai wenunggamiei mano wiro enetituai kariri neo maifo kaha mani, sahatawang inontarai siai fosa,</para>
  <para style="q2" vid="PRO 28:16">wape mano enerireu fi fuba obuai na tofa inontarai siai mani, ne fuina wairoi.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Inontarai mano warang rika inontarai siai mani,</para>
  <para style="q2" vid="PRO 28:17">wiro finahang kaha weo enetituai inontarai etawi pampang paria suai to kamirei fafofoi.</para>
  <para style="q2" vid="PRO 28:17">Wiro fatari fanai, tawingnia!<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Mandoni dino niari fifiani kontai na warang mai mani, ambori sobu maifo,</para>
  <para style="q2" vid="PRO 28:18">wape mandoni dino wiro warang mai kaha mani, ambori sawaifa.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Mandoni dino niari romi mani, ambori memosi na fiang,</para>
  <para style="q2" vid="PRO 28:19">wape mandoni dino enerorong sopuayai mani, ambori memosi na ne pari fifo.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Inontarai mano warang mai mani, ambori sobu moang bitoya,</para>
  <para style="q2" vid="PRO 28:20">wape inontarai mano miaya sikera we ne ra bitoyafoi mani, wiro kiaharai weru aiboifo kaha.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Masino inontarai manei wiro doarahana kaha wape sau we manei, nana mani wiro beng kaha,</para>
  <para style="q2" vid="PRO 28:21">wape inontarai manei miaya we niari sarawai tonanaifa mani, manta we sobu roti aburung bei teraifa.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Inontarai mano warang mutufoi sikahera dawi ra,</para>
  <para style="q2" vid="PRO 28:22">tuti wiro deitawangnai weo i ambori ahera sawai na wiro ne fia kahafo.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Mandoni dino sua inontarai siai mani, ambori etatori sewa weru</para>
  <para style="q2" vid="PRO 28:23">inontarai mano manta medu kaiwo mamisi we yuai inontarai siai dedai teraifa.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Mandoni dino tetofa tuti dewa tamanai tuti inanai we kia une fianggengfo,</para>
  <para style="q2" vid="PRO 28:24">tuti deitarahio wiro sarawa kaha,</para>
  <para style="q2" vid="PRO 28:24">i mani netarai toyario inontarai kerirafoi mano memuna paria.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Inontarai mano miaya we ne fianggeng bitoya tuti enetituai mantauni terai mani, ambori wedaya mamuna,</para>
  <para style="q2" vid="PRO 28:25">wape mandoni dino yoaso Yahwei mani, ne fianggeng bitoya.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Mandoni dino deparandini mani, wiro miaya we aunauwi kaha,</para>
  <para style="q2" vid="PRO 28:26">wape mandoni dino darang na sewai mani, ambori kiaharai weru dadirafo.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Mandoni dino dohong fieai we inontarai mano ne pari fifoi, wiro neta fiea kaha,</para>
  <para style="q2" vid="PRO 28:27">wape kangganifo ambori da we inontarai mano kiuhu urengfo na wiro deti kariri inontarai mano ene pari fi fosa kaha.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Masino inontarai mano eharira fosa esobu mambiriu we eweparenta mani, inontarai bitoya etadiwa enetarai weo ematai fefe,</para>
  <para style="q2" vid="PRO 28:28">wape masino inontarai mano eharira fosa wiro ene mambiriu fea kaha mani, inontarai emasi fosa ambori eweparenta aha.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Mandoni dino nungkamiei mitubaru, masino uari pampang kawurua,</para>
  <para style="q2" vid="PRO 29:1">na ahera i ambori tikai tuti mingganggung wiro weai nayai ahang kaha.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Masino inontarai emasi fosa eru parenta mani raifoi firaise,</para>
  <para style="q2" vid="PRO 29:2">wape masino inontarai eharira fosa eru parenta mani raifoi arohuayai.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Arikang mano miaya we sewaifoi mani, niari ne dai firaise,</para>
  <para style="q2" vid="PRO 29:3">wape mandoni dino firao wiwing dirufoi mani, mei rafoi awao kiai.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Kaiwasafoi ambori etarang na mai, masino mananufoi weparenta na doarahangnai,</para>
  <para style="q2" vid="PRO 29:4">wape masino fianduhi doi pajaki bitoyafoi mani, ambori niari kaiwasafoi misuhi.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Inontarai mano medu kaiwo mamisi we yuai inontarai siai, ambori sobu fianai aino miaya weafo,</para>
  <para style="q2" vid="PRO 29:5">i mani dapa aitepari we inontarai siai awengfo.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Inontarai mano kerirafoi mani, ne sasarifoi ambori tipabera mantauni,</para>
  <para style="q2" vid="PRO 29:6">wape inontarai mesifoi ambori firaise tuti mirising.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Inontarai mesifoi mani, miaya we doarahanai we inontarai mano ne pari fi foi,</para>
  <para style="q2" vid="PRO 29:7">wape inontarai kerirafoi wiro deitawangnai werorong kariri fi nana kaha.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Inontarai mano deikangganiafoi mani, niari inontarai na bendarifoi ene kasoufo dautai,</para>
  <para style="q2" vid="PRO 29:8">wape inontarai mano sewaifoi mani, niari ene kasoufo bia.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Masino inontarai mano sewaifoi memuna we inontarai mano webonggoifoi mani,</para>
  <para style="q2" vid="PRO 29:9">inontarai mano webonggoifoi ambori kesou tuti mirari kiayati pampang, donio mamunggasawai bereri.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Inontarai mano arong tataha we rikafoi enerireu inontarai enerorong dentengfoi,</para>
  <para style="q2" vid="PRO 29:10">wape inontarai mano warang maifoi dino waitawang weduari weru inontarai mano arong tataha we rikafoi.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Inontarai mano wiro miaya we aunauwi kahafoi deinawi ne kasaufo kai,</para>
  <para style="q2" vid="PRO 29:11">wape inontarai mano sewaifo mantauni wedaya ne kasoufo bia.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Masino mano wenunggameinei yoaso kaiwo tatofanei mani,</para>
  <para style="q2" vid="PRO 29:12">ne arombawahi fosa enari karira.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Inontarai mano ne pari fi foi tuti mano sahatawanifoi umai,</para>
  <para style="q2" vid="PRO 29:13">nanai aino Yahwei niari uremifo we uwati.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Masino mananu mano kiutu kaiwo we inontarai ne pari fi foi na doarahangnai mani,</para>
  <para style="q2" vid="PRO 29:14">yu parentafo ambori papayai na darangfo.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Aitatohi reafo tuti kaiwo uarafo mani, niari arikangfoi sewai,</para>
  <para style="q2" vid="PRO 29:15">wape arikang mano tuatifoi ambori dohong mamaya inanaifa.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Masino inontarai eharira fosa efau aha mani, sarawafo bitoya kontai,</para>
  <para style="q2" vid="PRO 29:16">wape inontarai mesifoi ambori deti etawafo.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Bounau nemu arikangwai, ambori dohong enemurorongwai finahang,</para>
  <para style="q2" vid="PRO 29:17">tuti kia mirising we wau.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Masino Allai wiro wiwiaing kaha mani, kaiwasafoi seiwou funomai.</para>
  <para style="q2" vid="PRO 29:18">Inontarai mano niari kariri kaiwo ohong kaririane mani sobu mai.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Wiro bounau nemu womingnei na modu tera fanai,</para>
  <para style="q2" vid="PRO 29:19">weo masino tefu kaiwo werorongfo, wape wiro miaya we niari kariria kaha.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Boti inontarai mano medu ahera na wiro enetituai naria kahafoi,</para>
  <para style="q2" vid="PRO 29:20">bounau i mani dadira sewa weru bounau inontarai mano wiro miaya we aunawi kahafoi.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Masino bohong nemu fianggeng feai we nemu womingfoi kariri miaya weafo na kutu wekateifa mani,</para>
  <para style="q2" vid="PRO 29:21">na rahida fui wori weinontarai mano nunggamiei mitubaru.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Inontarai mano kesou biriufoi wedaya mamuna,</para>
  <para style="q2" vid="PRO 29:22">tuti inontarai mano enerorong meninggapoi aherafoi mani, niari sarawai bitoya.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Inontarai mano tewafoi, ambori sobu mamaya,</para>
  <para style="q2" vid="PRO 29:23">wape inontarai mano enerorong tewawafoi, ambori sobu fayai.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Mandoni dino fiata mananapifoi mani, ambori mantauni sobu dadirafo,</para>
  <para style="q2" vid="PRO 29:24">weo i dererai kawurua we deisaha neo maifo, wape wiro niari kariria kaha.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Mutai inontarai mani, toyari waitepari tipa wau,</para>
  <para style="q2" vid="PRO 29:25">wape roaso Yahwei mani, ambori Deitawang wedua wau.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Inontarai bitoya erurai we mano yu parentafoi enerorong sawai wesa,</para>
  <para style="q2" vid="PRO 29:26">wape Yahwei terai, Andino kiutu kaiwo we ea na doarahangnai.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Inontarai mano mesifoi wiro miaya kaha we inontarai mano kerirafoi,</para>
  <para style="q2" vid="PRO 29:27">tuti inontarai mano kerirafoi enerireu inontarai mano ne rang mimoyafoi.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">Kaiwo awai na Aguri</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 30:1" />Yakei antungno Aguri ne kaiwo arera finina.</para>
  <para style="q1" vid="PRO 30:1">Sahu deyo, “Oh Alla,</para>
  <para style="q2" vid="PRO 30:1">yau imurua paria, nehu mambiriu fea kaha.”<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Weo yau iwebonggoi sewa weru inontarai siai,</para>
  <para style="q2" vid="PRO 30:2">yau mani inontaraio wiro itafu kaiwo werorongfo kaha.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Kontai wiro isobu aunau kariri awai kaha,</para>
  <para style="q2" vid="PRO 30:3">donio wiro yeitawang kariri Mano Dedai Mirarebanafoi kaha.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Mandoni dino kawurua dautai to waidani mayeai bia ahamane?</para>
  <para style="q2" vid="PRO 30:4">Mandoni dino kawurua yu kanggung wanangfoi na warangne?</para>
  <para style="q1" vid="PRO 30:4">Mandoni dino kawurua sensang mereha na ireune?</para>
  <para style="q2" vid="PRO 30:4">Mandoni dino kawurua kiutu nunei ne ruareane kai?</para>
  <para style="q1" vid="PRO 30:4">Andidoni, wonong fidoni tuti antungfoi wonong fidoni?</para>
  <para style="q2" vid="PRO 30:4">Masino boitawangna mani, boisaharaifa!<verse eid="PRO 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Allai Ne kaiwo sariatine kai mani wetarai.</para>
  <para style="q2" vid="PRO 30:5">I mani wefoti we inontarai mano etadiwa na I.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Wiro riwang Ne kaiwo sariatine fanai,</para>
  <para style="q2" vid="PRO 30:6">ambori wiro Sua wau kaha tuti Deinawiai weo wau totofa kaha.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Oh Yahweh, yutang we fi beru na Wau,</para>
  <para style="q2" vid="PRO 30:7">wiro Boiayara fanai na wiro imereha kaharai amani,<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Fata yau ambori kaiwo wiro antu kahai tuti tatofafo wiro nayai na yau kaha.</para>
  <para style="q2" vid="PRO 30:8">Wiro nari yau iwe inontarai mano ne pari fi fanai, ete inontarai mano ne ra bitoya fanai.</para>
  <para style="q2" vid="PRO 30:8">Bento ampefe bohong fiangno demoyarai we isobuafo terai.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Ambori masino imamosi mani, wiro ifafora Wau kaha,</para>
  <para style="q2" vid="PRO 30:9">tuti wiro imadu yeyo, “Ah, Yahwei mani mandoni Dine?”</para>
  <para style="q1" vid="PRO 30:9">Ete, masino nehu pari fi mani, ikamananapi</para>
  <para style="q2" vid="PRO 30:9">tuti inari Wonomune karira.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Wiro boiriri funong woming manei we ne mano yufi weifoi fanai,</para>
  <para style="q2" vid="PRO 30:10">ambori wiro womingfoi deikanggani wau kaha tuti wau wiro wobu dadira kaha.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Inontarai manea eteikanggani etamamifoi,</para>
  <para style="q2" vid="PRO 30:11">tuti wiro emoang einamifoi kaha.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Inontarai manea eteitarahio mantaungsa emararebanaifa</para>
  <para style="q2" vid="PRO 30:12">wape taraie, ewerarika paria na Allai arongfo.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Inontarai manea eteitarahio eaino ebeng sewane,</para>
  <para style="q2" vid="PRO 30:13">tuti inontarai siai wiro ewe fiea kahai paria.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Inontarai manea ederemifo mani wesondu,</para>
  <para style="q2" vid="PRO 30:14">ederemi warangfo mani wenoi,</para>
  <para style="q1" vid="PRO 30:14">enetarai toyario andowa memuna ehiri,</para>
  <para style="q2" vid="PRO 30:14">ea mani inontarai mano etahatawang inontarai efanahang fosa tuti etawa inontarai mano ene pari fifo ene fianggengfo.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Kikairinei ne kamitung mandu.</para>
  <para style="q2" vid="PRO 30:15">Manei wonong fino, “Ohongni we yau!” tuti manei aha mani wonong fino, “Ohongni we yau!”</para>
  <para style="q1" vid="PRO 30:15">Fi betoru aino maya weai pampangne,</para>
  <para style="q2" vid="PRO 30:15">ete fi bea aino wiro demoyara kahane amani,<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />raimerio wewisi we mararehafoi,</para>
  <para style="q2" vid="PRO 30:16">wiwingno eneng kirawahi miaya we ne arikang,</para>
  <para style="q1" vid="PRO 30:16">kahofa sarahiai demang we mereha,</para>
  <para style="q2" vid="PRO 30:16">tuti adia denggararu pampang niunung towana tonina.<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Inontarai mano deibabera tamanaifa,</para>
  <para style="q2" vid="PRO 30:17">tuti wiro miaya we tarao inana kahafoi,</para>
  <para style="q2" vid="PRO 30:17">ambori romu rawei so fating urengfo</para>
  <para style="q2" vid="PRO 30:17">tuti romu enoi antung dang ne taraifoi.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Fi betoru aino dadira we yau,</para>
  <para style="q2" vid="PRO 30:18">tuti fi bea aino wiro yeitawangna kaha amani,<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />todoni fino romu enoi sifo dadai paria,</para>
  <para style="q2" vid="PRO 30:19">todoni fino tawainei da na manapahang wowongfo,</para>
  <para style="q1" vid="PRO 30:19">todoni fino kaparinei defai na rawanang kehabi rausi,</para>
  <para style="q2" vid="PRO 30:19">tuti todoni fino mangnei tuti wiwing uwe mayana wawera suru.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Wiwing mano wiro enerorong pepayai we ne mangfoi kahai, fio niarifo mani toyario,</para>
  <para style="q2" vid="PRO 30:20">dampia kawurua mani yuai borongfo,</para>
  <para style="q1" vid="PRO 30:20">toyari nanai kontai, dawa dena ria mang siai kawurua, mayeai medu deyo, “Yau wiro inari karira fea kaha.”<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Fi betoru aino niari inontarai nesa na nunei erirora,</para>
  <para style="q2" vid="PRO 30:21">ete fi bea aino niari ea wiro erutawangna kaha amani,<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />woming manei masino wemananu,</para>
  <para style="q2" vid="PRO 30:22">inontarai mano wiro miaya we aunawi kahafoi masino sobu fiangno miaya weafo kai,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />masino wiwing manei inontarai wiro emirising wei kaha, wape sobu mang manei we ne mang,</para>
  <para style="q2" vid="PRO 30:23">tuti masino mangfata wiwing manei yiwang wiwing mano yufi weifoi.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Andowa katui mana na nunei,</para>
  <para style="q2" vid="PRO 30:24">wape esawai amani,<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />anana nesa mani wiro ewemambiriu kaha,</para>
  <para style="q2" vid="PRO 30:25">wape emainenang fiangfo na kutu wemunudangfo.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Pelanduki nesa kontai efanahang,</para>
  <para style="q2" vid="PRO 30:26">wape enari ene munufoi na wiwoi kamiei.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Mansonggeri nesa mani ene pari mananu,</para>
  <para style="q2" vid="PRO 30:27">wape etangsa na mai.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Kafetaininei mani tofuri na waramune,</para>
  <para style="q2" vid="PRO 30:28">wape ea kontai enayai na munu mananufoi.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Andowa mantoru itora na mambiriu,</para>
  <para style="q2" vid="PRO 30:29">ete, fi bea aino era na mambiriu amani,<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />singa mangnei andino wemambiriu paria, sewa weru andowanei kiaine,</para>
  <para style="q2" vid="PRO 30:30">wiro mitai fiea kaha.<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />Manggohei mang mano da yuai rahanangfoi, ete kambing mangnei,</para>
  <para style="q2" vid="PRO 30:31">tuti mananu manei wenungkamiei we ne afai mamuna enayai riatifoi.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Masino na nemu bonggoiwa ruai nemu taraiwai dedai tuti tang neo karirafo mani,</para>
  <para style="q2" vid="PRO 30:32">fotourai tuti enemutituai kariri fio nariwa!<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Weo, masino uifoi indomi pampang mani, mantegafoi dariai,</para>
  <para style="q2" vid="PRO 30:33">tuti masino boi manei ubongfoi mani, rikafoi dariai,</para>
  <para style="q2" vid="PRO 30:33">tuti masino nari inontarai manei kesou mani, wedaya mamunafoi.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">Kaiwo aunau we mananu Lemueli</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Mananu Lemueli, kaiwo inang deunauai wei finina.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Nehu arikangne wau, nehu arikang terane wau,</para>
  <para style="q2" vid="PRO 31:2">arikangno yawingni, weo Allai yoa we nehu nadi nei.</para>
  <para style="q2" vid="PRO 31:2">Taramu sauao nehu kaiwo aunaune.<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Wiro bohong nemu mambiriuwa kai we bawi wiwing nesa fanai,</para>
  <para style="q2" vid="PRO 31:3">tuti wiro furao wiwing mano enari mananu nesa esobu karirafo fanai.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Aromuoaifa Lemuele!</para>
  <para style="q2" vid="PRO 31:4">Beng kahai we mananunei dunung angguri,</para>
  <para style="q2" vid="PRO 31:4">ete inontarai babafosa emaya we ye memunafo.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Dohonao na etunungfo earomiporo fianai aino ehutuaiampo,</para>
  <para style="q2" vid="PRO 31:5">tuti wiro esawatutu inontarai mano ene pari fi fosa kaha.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Ohong ye mamunafo we inontarai mano adareti mireha,</para>
  <para style="q2" vid="PRO 31:6">tuti anggurifo we inontarai mano enerorong fituayafoi.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Bento dunungna ambori aroporo fi karirao sodairafo,</para>
  <para style="q2" vid="PRO 31:7">tuti wiro aro ne dadirafo ahang kaha.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Fai boromuwa modu wawatuti inontarai mano wiro ne mambiriu fea kahai we mantauni medu sawatutiri.</para>
  <para style="q2" vid="PRO 31:8">Boitawang wedua inontarai mano efanahang fosa.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Fai boromuwai we kutu kaiwo na boarahangnai</para>
  <para style="q2" vid="PRO 31:9">tuti nari fi nanai we wawatuti inontarai mano tahatawangsa tuti mano ene pari fi fosa.<verse eid="PRO 31:9" /></para>
  <para style="s">Kaiwo fiai we wiwing mano dentengfoi</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Wiwing mano dentengfoi mandoni dino sobui ne?</para>
  <para style="q2" vid="PRO 31:10">I mani ne harga dedai sewa weru kamiei ne harga dedainei.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Ne mangfoi yoaso teri,</para>
  <para style="q2" vid="PRO 31:11">ampefe ne mangfoi wiro neta fiea kaha.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Niari bengfo pampang we ne mangfoi tuti wiro niari karira fea kaha</para>
  <para style="q2" vid="PRO 31:12">na kutu minohi darangfo.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />I niari ansung we maninggapoifo tuti danunangfo,</para>
  <para style="q2" vid="PRO 31:13">tuti miaya we niari fi nanai na warangfo.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />I netarai toyario kapario kia fianggeng na wairoi ma,</para>
  <para style="q2" vid="PRO 31:14">i kia fiangfo ma.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Aharorong mani doa kawurua,</para>
  <para style="q2" vid="PRO 31:15">meinenang fiang we ne munurorongfo,</para>
  <para style="q2" vid="PRO 31:15">tuti deto we mangfata wiwingfosa ene fi erufo.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Kawurua enetituai nariaifa, mayeai wiori kahofao miaya weafo,</para>
  <para style="q2" vid="PRO 31:16">tuti niari romi angguri na doi sobuai na yufi fo.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />I meinenang netaraifoi</para>
  <para style="q2" vid="PRO 31:17">i mani wiwingno yufi mambiriu dine.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Deitawanai weo fio niarifo mani ambori dohong fianggeng bitoya wei,</para>
  <para style="q2" vid="PRO 31:18">ampefe ne padamarangfoi denggararu pampang na dirufo we yufi.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Warangfo watai na banang fuifoi,</para>
  <para style="q2" vid="PRO 31:19">warakikehafo we dari banangfo.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Warangfo we fiata inontarai mano tahatawanifoi,</para>
  <para style="q2" vid="PRO 31:20">tuti suba warangfo we inontarai mano ne pari fi foi.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Na kutu daunanangfo da ma mani wiro arokuaya kaha,</para>
  <para style="q2" vid="PRO 31:21">weo meinenang ansung manikaponi kawurua we nemunurorong fosa.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Mantauni niari ireu tabung fatafoi we mantauni,</para>
  <para style="q2" vid="PRO 31:22">tuti ne ansungfo mani na ireu finahang neo harga dedai.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Ne mangfoi mani wewonong na inontarai mano ewewafoniai na bendarifoi,</para>
  <para style="q2" vid="PRO 31:23">donio minohi riasa na katai efanduhisa naifoi.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />I niari ansung tuti waikapuru</para>
  <para style="q2" vid="PRO 31:24">mayeai dewayangnai we mantawayang fosa.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />I wemambiriu tuti inontarai etatori,</para>
  <para style="q1" vid="PRO 31:25">wiro arokuayai we rahida bo da ahamawani kaha.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />I medu na sewai,</para>
  <para style="q2" vid="PRO 31:26">tuti dohong aunau na kaiwo fanahang.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />I deitawang ne munurorongfo na mai,</para>
  <para style="q2" vid="PRO 31:27">uremi marirane mani wiro nayai na i kaha.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Ne arikang fosa etatori,</para>
  <para style="q2" vid="PRO 31:28">tuti ne mangfoi fiai deyo,<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“Wiwing bitoya enari bengfo,</para>
  <para style="q2" vid="PRO 31:29">wape wauno bonteng sewa werusa ne.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Uremi bengne mani tatofa tuti uremi bohine mani ambori nai,</para>
  <para style="q2" vid="PRO 31:30">wape wiwing mano yoaso Yahwei tuti somi wei mani inontarainei kiai efiai.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Ohong fiembaitai wei kariri fio kawurua niari na warangfo,</para>
  <para style="q2" vid="PRO 31:31">fiai i na inontarai bitoya earomifo weo fio niari kawuru ampo.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>