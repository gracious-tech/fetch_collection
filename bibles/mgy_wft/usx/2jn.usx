<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Mbunga Bible Version</book>
  <para style="h">2Yohana</para>
  <para style="toc3">2Yoh</para>
  <para style="toc2">2Yohana</para>
  <para style="toc1">Lihamba lya ivili lya Yohana</para>
  <para style="mt2">Lihamba lya ivili lya</para>
  <para style="mt1">Yohana</para>
  <para style="imt">Ulongulelo wa Yohana</para>
  <para style="ip">Lihamba lya ivili lya mndumindiumi Yohana liyandikilwi paghati gha machuva gha itisini badili gha kuhova kwa Kilisito. Yohana akotoho kujihighilisa mweni yiwa ni myandika wa lihamba hai, badili ghaki anguikema mweni ni mgogolo kilongosi. Mavulo yala yayandikiliwi kulihamba hali yangulandana nesu na yala gha Habali Maha gha Yohana. Hai inguvikwa lipala na vila kuvika mkasu wa amuli zya Yesu kupalana na angulandanisa kumpala Yesu kwa kukovekela amuli ghaki kusula gha Yohana 1:5-6, na Habali Maha gha Yohana 15:9-10. Ingukwinilwa yiwa Yohana ndiwa ayandikili Habali Maha gha Yohana, pamonga na mahamba itatu zya Lihamba lya mtumbulo gha Yohana na Lihamba lya ivili gha Yohana na Lihamba lya itatu gha Yohana lipindi awelili haku Efesu.</para>
  <para style="ip">Yohana awayandikili lihamba hali kwa mhaghulwa mdala, pamonga na wana ghaki wavile ni lipinga lya weni kumkwinila Kilisito. Angulandanisa hali na lipinga lya wandu weni kumkwinila Kilisito yiwa ni mdala angumkwinila Kilisito. Hinu angulongela hali kwa wakwinila wogha. Lukasini lwa Yohana kuyandika lihamba hai angupala kuwagangamalisa lipinga lya wandu wamkwinila Kilisito na kuwakalipila kwa wavula wa uhwangi.</para>
  <para style="iot">Gha Mghati</para>
  <para style="io">Yohana angutumbula lihamba lyaki anguwayandikila wandu ghani na kuwajambusa wapokela kusula gha Yohana 1:1-3</para>
  <para style="io">Kangi angulitila moyu wandu wangumkwinila Kilisito wakoli amuli ngulu kusula gha Yohana 1:4-6</para>
  <para style="io">Hinu anguwakalipila wakali kutali na wavulwa wa uhwangi kusula gha Yohana 1:7-11</para>
  <para style="io">Mwihu Yonana anguyomola lihamba lyaki kwa kuwataula wala wapokela lihamba lyaki.</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Nenga mgogolo kilongosi,</para>
  <para style="p" vid="2JN 1:1">ningukuyandikia wenga nyongu uhaghuliwi na Sapanga pamonga na wana ghako niwapala kiuchakaka. Ng'ogha nenga weka ghangu, mweni kuwapala. Na waghangi wogha weni kuumanya hula uchakaka, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />kwaikiva uchakaka ungulikala na twenga machuwa hyogha.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Umaha na ulungwana na kuponga zinguhuma kwa Sapanga Tati na kwa Yesu kilisito mwana, ziwela pamonga na twenga kuuchakaka na upalu.<verse eid="2JN 1:3" /></para>
  <para style="s">Uchakaka na upalu</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Nihekelili nesu panihyoghanili amonga gha wana ghako wangulikala kuuchakaka, handa vila tupokelili laghilo kwa Tati. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Hinaa nyongu, ng'ogha yiwa ningukuyandikila laghilo lya hyonu, ila hilahila tuwela nayu kuhuma mtumbulo patumkwinila Kilisito yiwa tupalane. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Haku ndiwa kupalana, yiwa tuyendileli na kukovikela laghilo lyaki, hayi ndiwa laghilo lyaki handa vila myughanili kuhumila mtumbulo yiwa tuyendileli kupalana.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Walulunganya watangala wahumila kumlima wogha, wandu wamjumila ng'ogha yiwa Yesu Kilisito kahika kukihigha, mundu alongile hagha ni mlulunganyi na angumngingama Kilisito. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Hinu mlikali mihu wenibaha, ili mkotoho kuyaghamisa lihengu lyogha mgholile kukumtumikila Sapanga, bali mpokeli hupo itimila.<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />Mundu yoyosi mweni kukola ng'ogha na kuyendelela kumuvulo gha kilisito, ila kayaleka, mweni kammanya ng'ogha Sapanga. Ila yoyosi mweni kulikala kumavulo kana Tati na Mwana. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Hinu, handa mundu akahika kwa mwenga akotoho kuwayeghela mavulo hagha, mkotoho kumkalibisa ukaya kwa mwenga, wala mkotoho kumjambusa handa mkwinila. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Yoyosi kanamjambusa mundu hayu, kawela pamonga na mweni kumatendu ghaki mahakata.<verse eid="2JN 1:11" /></para>
  <para style="s">Milaghilo gha kuyomolela</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Niwela na mighalu itangala gha kuwalongela, ila nipala ng'ogha kuwayandikila mlihamba, badili ghaki nalitumaini kuwahikila na kulongela na mwenga ndunda ndunda ili luheku lwa twenga litimili.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Wana wa mhacha ghako yula ahaghulilwi na Sapanga haku niwela wangukujambusa.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>