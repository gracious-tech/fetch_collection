<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Mbunga Bible Version</book>
  <para style="h">3Yohana</para>
  <para style="toc3">3Yoh</para>
  <para style="toc2">3Yohana</para>
  <para style="toc1">Lihamba lya itatu lya Yohana</para>
  <para style="mt2">Lihamba lya itatu lya</para>
  <para style="mt1">Yohana</para>
  <para style="imt">Ulongulelo wa Yohana</para>
  <para style="ip">Lihamba lya itatu lya Yohana liyandikilwi na Mndumindumi Yohana kweni lichuva lya itisini badili gha kuweleka kwa Kilisito. Yohana kangulangiha ng'ogha yiwa mweni ndiwa myandika wa lihamba hali, badili ghaki anguikema mweni ni kilongosi mgogolo kusula gha Yohana 1:1. angughola nagha Handa aigholile kulihamba lya ivili gha Yohana kusula gha 1:1. Ingukwinilwa yiwa Yohana ndiwa mweni kuyandika Habali Maha gha Yohana na lihamba lya mtumbulo mbaka lya itatu Lihamba lya mtumbulo gha Yohana na Lihamba lya ivili gha Yohana na Lihamba lya itatu gha Yohana lipindi awelili haku Efesu.</para>
  <para style="ip">Yohana amyandikili lihamba hali Gayo mundu mwenikuwela angumkwinila Kilisito. Kamlonelela Gayo handa ghanja ghaki na kumlaghila awapokeli maha walongo weni kumkwinila Kilisito wenikuwela na mwanja kummbwani ghao.</para>
  <para style="iot">Gha Mghati</para>
  <para style="io">Yohana angutambulisa lihamba lyaki lya itatu lya Yohana kusula gha 1:1</para>
  <para style="io">Hinu angumtaya moyu Gayo na kumlaghila awapokeli maha walongo weni kumkwinila Kilisito kusula gha Yohana 1: 2-8</para>
  <para style="io">Kangi angulongelela kunani gha wandu waivili Deotulefe na Demeteleo kusula gha 1:9-12</para>
  <para style="io">Mwihu anguhyomolela lihamba lyaki kusula gha 1:13-14</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Nenga mgogolu kilongosi,</para>
  <para style="p" vid="3JN 1:1">ningukuyandikila wenga ghanja ghangu Gayo, ningukupala kiuchakaka.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Ghanja ghangu, ningukuyupila kwa Saapanga uyendeleli maha kumighalu ghako hyogha, ningukutakila ukomu kumhigha ghako kunu ukiyendelela maha kuumonga ghako na Sapanga. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Nihekelela nesu walongo mayaghani pawahika baha, wakalola uchakaka ghako kunani gha chakaka, hina, wenga machuwa hyogha ungulama kuuchakaka. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Kwahela mghalu ungunihekelesa kupiti kuhyoghanila vila wana ghangu wangulikala kuchakaka.<verse eid="3JN 1:4" /></para>
  <para style="s">Yohana angumsifila Gayo</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Mpalwa wa nenga, wenga uwela ng'ogha na ukambenga lipindi lyogha paunguwatumikila walongo wakwinila, na hata kwa wahenja pamonga na yiwa unguwamanya ng'ogha, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />weni walilongela lipinga lya weni kumkwinila Kilisito lya baha ghala wayahyoghanila na kuyalola kukovekelana na upalo ghako, chondi uwatangi wayendeleli na mwanja ghao kwa vila ingumhekelesa Sapanga. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Mwanja hau wanguyenda ni gha kumtumikila Kilisito. Wapokela ng'ogha mtanga wowosi kwa wandu wamkwinila ng'ogha Kilisito. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Hinu twenga weni kumkwinila Kilisito tungupalwa kuwatanga wandu handa hagha, ili na twenga tugholi pamonga na weni lihengu lya kutangasa chakaka.<verse eid="3JN 1:8" /></para>
  <para style="s">Deotelefe na Demetilio</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Niliyandikila lipinga lya wandu weni kumkwinila Kilisito lihamba, ila Deotelefe mweni kihelehele handa ndiwa mkulu ghao kangupala ng'ogha kunihyoghanila. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Panitehika nitelongela na mweni kuulongolo gha lipinga lya weni kumkwinila Kilisito mighalu hyogha anguighola. Angutungonga na kutulongelela milando mihakata, ila ng'ogha hagha weka, hilahila angulema kuwapokela na kuwapokela wandu weni kukwinila pawawela na mwanja wa kuhika haku. Na anguwalemesa wandu waghangi wenikupala kuwapekela wahenja na anguyesa hata kuwawinga wala weni kuyesa kuwapokela wahenja.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Ghanja ghangu, ukutoho kukovekela mlandano mhakata, ila mlandano wa maha. Kila yula mweni kughola ghamaha ni wa Sapanga, ila yula mweni kughola mahakata kangummanya ng'ogha Sapanga.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Kila mundu kangumsifila Demeteleo kwa ghala maheli angughola, matendu ghaki yeni yanguilongela yiwa mweni ni mundu maheli, twenga hilahila tungumlongelela maheli, na wenga ungumanya yiwa kila tungukilongela ni chakaka.<verse eid="3JN 1:12" /></para>
  <para style="s">Majambusu gha kuhyomelela</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Niwela na mighalu mitangala gha kuwalongela, ila ningupala ng'ogha kuwayandikila mlihamba. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Niwela na litumaini kukutyangila lipindi lya pabehi. na tutewesa kulikala pamonga na kulongela ndunda ndunda.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Ningukuyupila kwa Sapanga akupeghi kulikala kwa kuponga,</para>
  <para style="p" vid="3JN 1:15">waghanja ghako wa baha Efesu wangukujambusa. Na wenga wajambusi waghanja wa twenga weni kuwela haku kwa lihina lyaki.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>