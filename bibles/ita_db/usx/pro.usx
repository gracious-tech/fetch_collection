  <para style="h">PROVERBI</para>
  <para style="toc1">IL LIBRO DEI PROVERBI DI SALOMONE</para>
  <para style="toc2">PROVERBI</para>
  <para style="toc3">Prov.</para>
  <para style="mt2">IL LIBRO DEI</para>
  <para style="mt1">PROVERBI DI SALOMONE</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s1">Introduzione generale</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 1:1"/>I PROVERBI di Salomone, figliuolo di Davide,</para>
  <para style="q" vid="PRO 1:1">Re d'Israele<note caller="*" style="x"><char style="xo" closed="false">1.1 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 Re. 4.32</ref>. <ref loc="ECC 12:11">Eccl. 12.11</ref>.</char></note>;<verse eid="PRO 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2"/>Per conoscere sapienza ed ammaestramento,</para>
  <para style="q" vid="PRO 1:2">Per intendere i detti di senno;<verse eid="PRO 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3"/>Per ricevere ammaestramento di buon senno,</para>
  <para style="q" vid="PRO 1:3">Di giustizia, di giudicio e di dirittura;<verse eid="PRO 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4"/>Per dare avvedimento a' semplici.</para>
  <para style="q" vid="PRO 1:4">
    <char style="add">E</char> conoscenza, ed accorgimento a' fanciulli.<verse eid="PRO 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5"/>Il savio <char style="add">li</char> udirà, e <char style="add">ne</char> accrescerà la <char style="add">sua</char> scienza<note caller="*" style="x"><char style="xo" closed="false">1.5 </char><char style="xk" closed="false">scienza </char><char style="xt" closed="false"><ref loc="PRO 9:9">Prov. 9.9</ref>.</char></note>;</para>
  <para style="q" vid="PRO 1:5">E l'<char style="add">uomo</char> intendente <char style="add">ne</char> acquisterà buoni consigli, e governo;<verse eid="PRO 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6"/>Per comprender le sentenze ed i bei motti,</para>
  <para style="q" vid="PRO 1:6">Le parole de' savi ed i lor detti oscuri.<verse eid="PRO 1:6"/></para>
  <para style="s1">Non ti lasciar sedurre dai peccatori</para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7"/>IL timor del Signore <char style="add">è</char> il capo della scienza<note caller="*" style="x"><char style="xo" closed="false">1.7 </char><char style="xk" closed="false">scienza </char><char style="xt" closed="false"><ref loc="JOB 28:28">Giob. 28.28</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 1:7">
    <char style="add">Ma</char> gli stolti sprezzano la sapienza e l'ammaestramento.<verse eid="PRO 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8"/>Ascolta, figliuol mio l'ammaestramento di tuo padre<note caller="*" style="x"><char style="xo" closed="false">1.8 </char><char style="xk" closed="false">padre </char><char style="xt" closed="false"><ref loc="PRO 4:1">Prov. 4.1</ref>; <ref loc="PRO 6:20">6.20</ref>. <ref loc="EPH 6:1">Efes. 6.1</ref>,<ref loc="EPH 6:2">2</ref>.</char></note>;</para>
  <para style="q" vid="PRO 1:8">E non lasciar l'insegnamento di tua madre;<verse eid="PRO 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9"/>Perciocchè saranno un fregio grazioso al tuo capo,</para>
  <para style="q" vid="PRO 1:9">E collane al tuo collo.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10"/>Figliuol mio, se i peccatori ti vogliono sedurre,</para>
  <para style="q" vid="PRO 1:10">Non acconsentir <char style="add">loro</char><note caller="*" style="x"><char style="xo" closed="false">1.10 </char><char style="xk" closed="false"><char style="add">loro</char> </char><char style="xt" closed="false"><ref loc="GEN 39:7">Gen. 39.7</ref> ecc. <ref loc="EPH 5:11">Efes. 5.11</ref>.</char></note>.<verse eid="PRO 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11"/>Se dicono: Vieni con noi, poniamo agguati al sangue,</para>
  <para style="q" vid="PRO 1:11">Insidiamo di nascosto l'innocente impunitamente;<verse eid="PRO 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12"/>Tranghiottiamoli tutti vivi, come il sepolcro;</para>
  <para style="q" vid="PRO 1:12">E tutti intieri, a guisa di quelli che scendono nella fossa;<verse eid="PRO 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13"/>Noi troveremo ogni <char style="add">sorte di</char> preziosi beni,</para>
  <para style="q" vid="PRO 1:13">Noi empieremo le nostre case di spoglie;<verse eid="PRO 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14"/>Tu trarrai la tua sorte con noi;</para>
  <para style="q" vid="PRO 1:14">Fra noi <char style="add">non</char> vi sarà <char style="add">che</char> una sola borsa;<verse eid="PRO 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15"/>Figliuol mio, non inviarti con loro<note caller="*" style="x"><char style="xo" closed="false">1.15 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sal. 1.1</ref>. <ref loc="PRO 4:14">Prov. 4.14</ref>.</char></note>;</para>
  <para style="q" vid="PRO 1:15">Rattieni il tuo piè dal lor sentiero.<verse eid="PRO 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16"/>Perciocchè i lor piedi corrono al male,</para>
  <para style="q" vid="PRO 1:16">E si affrettano a spandere il sangue<note caller="*" style="x"><char style="xo" closed="false">1.16 </char><char style="xk" closed="false">sangue </char><char style="xt" closed="false"><ref loc="ISA 59:7">Is. 59.7</ref>. <ref loc="ROM 3:15">Rom. 3.15</ref>.</char></note>.<verse eid="PRO 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17"/>Perciocchè invano si tende la rete</para>
  <para style="q" vid="PRO 1:17">Dinanzi agli occhi d'ogni uccello;<verse eid="PRO 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18"/>Ma essi pongono agguati al lor <char style="add">proprio</char> sangue,</para>
  <para style="q" vid="PRO 1:18">Ed insidiano nascosamente l'anima loro.<verse eid="PRO 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19"/>Tali <char style="add">sono</char> i sentieri d'ogni uomo dato all'avarizia<note caller="*" style="x"><char style="xo" closed="false">1.19 </char><char style="xk" closed="false">avarizia </char><char style="xt" closed="false"><ref loc="PRO 15:27">Prov. 15.27</ref>. <ref loc="1TI 6:9">1 Tim. 6.9</ref>,<ref loc="1TI 6:10">10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 1:19">Ella coglie l'anima di coloro in cui ella si trova.<verse eid="PRO 1:19"/></para>
  <para style="s1">Invito ed esortazione della Sapienza</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20"/>LA somma Sapienza grida di fuori;</para>
  <para style="q" vid="PRO 1:20">Ella fa sentir la sua voce per le piazze<note caller="*" style="x"><char style="xo" closed="false">1.20 </char><char style="xk" closed="false">piazze </char><char style="xt" closed="false"><ref loc="PRO 8:1">Prov. 8.1</ref> ecc.; <ref loc="PRO 9:3">9.3</ref> ecc. <ref loc="JHN 7:37">Giov. 7.37</ref> ecc.</char></note>;<verse eid="PRO 1:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21"/>Ella grida in capo de' luoghi delle turbe;</para>
  <para style="q" vid="PRO 1:21">Ella pronunzia i suoi ragionamenti nell'entrate delle porte, nella città,<verse eid="PRO 1:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22"/>
    <char style="add">Dicendo:</char> Infino a quando, o scempi, amerete la scempietà?</para>
  <para style="q" vid="PRO 1:22">Ed <char style="add">infino a quando</char> gli schernitori prenderanno piacere in ischernire,</para>
  <para style="q" vid="PRO 1:22">Ed i pazzi avranno in odio la scienza?<verse eid="PRO 1:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23"/>Convertitevi alla mia riprensione;</para>
  <para style="q" vid="PRO 1:23">Ecco, io vi sgorgherò lo spirito mio<note caller="*" style="x"><char style="xo" closed="false">1.23 </char><char style="xk" closed="false">mio </char><char style="xt" closed="false"><ref loc="JOL 2:28">Gioel. 2.28</ref>.</char></note>;</para>
  <para style="q" vid="PRO 1:23">Io vi farò assapere le mie parole.<verse eid="PRO 1:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24"/>Perciocchè io ho gridato, e voi avete ricusato <char style="add">di ascoltare</char>;</para>
  <para style="q" vid="PRO 1:24">Io ho distesa la mano, e niuno ha porto attenzione;<verse eid="PRO 1:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25"/>Ed avete lasciato ogni mio consiglio<note caller="*" style="x"><char style="xo" closed="false">1.25 </char><char style="xk" closed="false">consiglio </char><char style="xt" closed="false"><ref loc="LUK 7:30">Luc. 7.30</ref>.</char></note>,</para>
  <para style="q" vid="PRO 1:25">E non avete gradita la mia correzione;<verse eid="PRO 1:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26"/>Io altresì riderò della vostra calamità;</para>
  <para style="q" vid="PRO 1:26">Io mi farò beffe, quando il vostro spavento sarà venuto;<verse eid="PRO 1:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27"/>Quando il vostro spavento sarà venuto, a guisa di ruina,</para>
  <para style="q" vid="PRO 1:27">E la vostra calamità sarà giunta, a guisa di turbo;</para>
  <para style="q" vid="PRO 1:27">Quando angoscia e distretta vi sarà sopraggiunta.<verse eid="PRO 1:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28"/>Allora essi grideranno a me, ma io non risponderò<note caller="*" style="x"><char style="xo" closed="false">1.28 </char><char style="xk" closed="false">risponderò </char><char style="xt" closed="false"><ref loc="JOB 27:9">Giob. 27.9</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 1:28">Mi ricercheranno sollecitamente, ma non mi troveranno;<verse eid="PRO 1:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29"/>Perciocchè hanno odiata la scienza,</para>
  <para style="q" vid="PRO 1:29">E non hanno eletto il timor del Signore;<verse eid="PRO 1:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30"/>E non hanno gradito il mio consiglio,</para>
  <para style="q" vid="PRO 1:30">
    <char style="add">Ed</char> hanno disdegnata ogni mia correzione.<verse eid="PRO 1:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31"/>Perciò mangeranno del frutto delle lor vie<note caller="*" style="x"><char style="xo" closed="false">1.31 </char><char style="xk" closed="false">vie </char><char style="xt" closed="false"><ref loc="JOB 4:8">Giob. 4.8</ref>. <ref loc="PRO 22:8">Prov. 22.8</ref>.</char></note>,</para>
  <para style="q" vid="PRO 1:31">E saranno saziati de' lor consigli.<verse eid="PRO 1:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32"/>Perciocchè lo sviamento degli scempi li uccide,</para>
  <para style="q" vid="PRO 1:32">E l'error degli stolti li fa perire.<verse eid="PRO 1:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33"/>Ma chi mi ascolta abiterà in sicurtà<note caller="*" style="x"><char style="xo" closed="false">1.33 </char><char style="xk" closed="false">sicurtà </char><char style="xt" closed="false"><ref loc="PSA 25:12">Sal. 25.12</ref>,<ref loc="PSA 25:13">13</ref>; <ref loc="PSA 112:7">112.7</ref>.</char></note>,</para>
  <para style="q" vid="PRO 1:33">E viverà in riposo, fuor di spavento di male.<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Eccellenza e vantaggi della Sapienza</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1"/>FIGLIUOL mio, se tu ricevi i miei detti,</para>
  <para style="q" vid="PRO 2:1">E riponi appo te i miei comandamenti,<verse eid="PRO 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2"/>Rendendo il tuo orecchio attento alla Sapienza;</para>
  <para style="q" vid="PRO 2:2">
    <char style="add">Se</char> tu inchini il tuo cuore all'intendimento,<verse eid="PRO 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3"/>E se tu chiami la prudenza,</para>
  <para style="q" vid="PRO 2:3">
    <char style="add">E</char> dài fuori la tua voce all'intendimento;<verse eid="PRO 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4"/>Se tu la cerchi come l'argento,</para>
  <para style="q" vid="PRO 2:4">E l'investighi come i tesori<note caller="*" style="x"><char style="xo" closed="false">2.4 </char><char style="xk" closed="false">tesori </char><char style="xt" closed="false"><ref loc="PRO 3:14">Prov. 3.14</ref>. <ref loc="MAT 13:44">Mat. 13.44</ref> ecc.</char></note>;<verse eid="PRO 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5"/>Allora tu intenderai il timor del Signore,</para>
  <para style="q" vid="PRO 2:5">E troverai la conoscenza di Dio.<verse eid="PRO 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6"/>Perciocchè il Signore dà la sapienza<note caller="*" style="x"><char style="xo" closed="false">2.6 </char><char style="xk" closed="false">sapienza </char><char style="xt" closed="false"><ref loc="1KI 3:9">1 Re. 3.9</ref>,<ref loc="1KI 3:12">12</ref>. <ref loc="JAS 1:5">Giac. 1.5</ref>.</char></note>;</para>
  <para style="q" vid="PRO 2:6">Dalla sua bocca <char style="add">procede</char> la scienza e l'intendimento.<verse eid="PRO 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7"/>Egli riserba la ragione a' diritti;</para>
  <para style="q" vid="PRO 2:7">
    <char style="add">Egli è</char> lo scudo di quelli che camminano in integrità<note caller="*" style="x"><char style="xo" closed="false">2.7 </char><char style="xk" closed="false">integrità </char><char style="xt" closed="false"><ref loc="PSA 84:11">Sal. 84.11</ref>. <ref loc="PRO 30:5">Prov. 30.5</ref>.</char></note>;<verse eid="PRO 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8"/>Per guardare i sentieri di dirittura,</para>
  <para style="q" vid="PRO 2:8">E custodire la via de' suoi santi.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9"/>Allora tu intenderai giustizia, giudicio,</para>
  <para style="q" vid="PRO 2:9">E dirittura, <char style="add">ed</char> ogni buon sentiero.<verse eid="PRO 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10"/>Quando la sapienza sarà entrata nel cuor tuo,</para>
  <para style="q" vid="PRO 2:10">E la scienza sarà dilettevole all'anima tua;<verse eid="PRO 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11"/>L'avvedimento ti preserverà,</para>
  <para style="q" vid="PRO 2:11">La prudenza ti guarderà;<verse eid="PRO 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12"/>Per liberarti dalla via malvagia,</para>
  <para style="q" vid="PRO 2:12">Dagli uomini che parlano di cose perverse;<verse eid="PRO 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13"/>I quali lasciano i sentieri della dirittura,</para>
  <para style="q" vid="PRO 2:13">Per camminar per le vie delle tenebre<note caller="*" style="x"><char style="xo" closed="false">2.13 </char><char style="xk" closed="false">tenebre </char><char style="xt" closed="false"><ref loc="JHN 3:19">Giov. 3.19</ref>,<ref loc="JHN 3:20">20</ref>.</char></note>;<verse eid="PRO 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14"/>I quali si rallegrano di far male<note caller="*" style="x"><char style="xo" closed="false">2.14 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="PRO 10:23">Prov. 10.23</ref>. <ref loc="ROM 1:32">Rom. 1.32</ref>.</char></note>,</para>
  <para style="q" vid="PRO 2:14">
    <char style="add">E</char> festeggiano nelle perversità di malizia;<verse eid="PRO 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15"/>I quali <char style="add">son</char> torti nelle lor vie,</para>
  <para style="q" vid="PRO 2:15">E traviati ne' lor sentieri.<verse eid="PRO 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16"/>Per iscamparti <char style="add">ancora</char> dalla donna straniera<note caller="*" style="x"><char style="xo" closed="false">2.16 </char><char style="xk" closed="false">straniera </char><char style="xt" closed="false"><ref loc="PRO 5:3">Prov. 5.3</ref> </char><char style="xta" closed="false">ecc., 20; </char><char style="xt" closed="false"><ref loc="PRO 6:24">6.24</ref> ecc.; <ref loc="PRO 7:5">7.5</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 2:16">Dalla forestiera <char style="add">che</char> parla vezzosamente;<verse eid="PRO 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17"/>La quale ha abbandonato il conduttor della sua giovanezza<note caller="*" style="x"><char style="xo" closed="false">2.17 </char><char style="xk" closed="false">giovanezza </char><char style="xt" closed="false"><ref loc="JER 3:4">Ger. 3.4</ref>.</char></note>,</para>
  <para style="q" vid="PRO 2:17">Ed ha dimenticato il patto del suo Dio.<verse eid="PRO 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18"/>Conciossiachè la casa di essa dichini alla morte<note caller="*" style="x"><char style="xo" closed="false">2.18 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="PRO 7:27">Prov. 7.27</ref>.</char></note>,</para>
  <para style="q" vid="PRO 2:18">Ed i suoi sentieri a' morti.<verse eid="PRO 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19"/>Niuno di coloro ch'entrano da essa non ne ritorna,</para>
  <para style="q" vid="PRO 2:19">E non riprende i sentieri della vita.<verse eid="PRO 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20"/>Acciocchè <char style="add">ancora</char> tu cammini per la via de' buoni,</para>
  <para style="q" vid="PRO 2:20">Ed osservi i sentieri de' giusti.<verse eid="PRO 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21"/>Perciocchè gli <char style="add">uomini</char> diritti abiteranno la terra<note caller="*" style="x"><char style="xo" closed="false">2.21 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 37:28">Sal. 37.28</ref>,<ref loc="PSA 37:29">29</ref>. <ref loc="PRO 10:30">Prov. 10.30</ref>.</char></note>,</para>
  <para style="q" vid="PRO 2:21">E gli <char style="add">uomini</char> intieri rimarranno in essa.<verse eid="PRO 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22"/>Ma gli empi saranno sterminati dalla terra,</para>
  <para style="q" vid="PRO 2:22">E i disleali ne saranno divelti.<verse eid="PRO 2:22"/></para>
  <para style="b"/>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1"/>Figliuol mio, non dimenticare il mio insegnamento;</para>
  <para style="q" vid="PRO 3:1">E il cuor tuo guardi i miei comandamenti;<verse eid="PRO 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2"/>Perchè ti aggiungeranno lunghezza di giorni,</para>
  <para style="q" vid="PRO 3:2">Ed anni di vita, e prosperità<note caller="*" style="x"><char style="xo" closed="false">3.2 </char><char style="xk" closed="false">prosperità </char><char style="xt" closed="false"><ref loc="PSA 119:165">Sal. 119.165</ref>.</char></note>.<verse eid="PRO 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3"/>Benignità e verità non ti abbandoneranno;</para>
  <para style="q" vid="PRO 3:3">Legateli in su la gola<note caller="*" style="x"><char style="xo" closed="false">3.3 </char><char style="xk" closed="false">gola </char><char style="xt" closed="false"><ref loc="DEU 6:8">Deut. 6.8</ref>; <ref loc="DEU 11:18">11.18</ref>.</char></note>, scrivili in su la tavola del tuo cuore;<verse eid="PRO 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4"/>E tu troverai grazia e buon senno</para>
  <para style="q" vid="PRO 3:4">Appo Iddio, ed appo gli uomini<note caller="*" style="x"><char style="xo" closed="false">3.4 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 Sam. 2.26</ref>. <ref loc="LUK 2:52">Luc. 2.52</ref>.</char></note>.<verse eid="PRO 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5"/>Confidati nel Signore con tutto il tuo cuore<note caller="*" style="x"><char style="xo" closed="false">3.5 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 3:5">E non appoggiarti in su la tua prudenza.<verse eid="PRO 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6"/>Riconoscilo in tutte le tue vie,</para>
  <para style="q" vid="PRO 3:6">Ed egli addirizzerà i tuoi sentieri<note caller="*" style="x"><char style="xo" closed="false">3.6 </char><char style="xk" closed="false">sentieri </char><char style="xt" closed="false"><ref loc="1CH 28:9">1 Cron. 28.9</ref>. <ref loc="JER 10:23">Ger. 10.23</ref>.</char></note>.<verse eid="PRO 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7"/>Non reputarti savio appo te stesso<note caller="*" style="x"><char style="xo" closed="false">3.7 </char><char style="xk" closed="false">stesso </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rom. 12.16</ref>.</char></note>;</para>
  <para style="q" vid="PRO 3:7">Temi il Signore, e ritratti dal male<note caller="*" style="x"><char style="xo" closed="false">3.7 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="JOB 1:1">Giob. 1.1</ref>; <ref loc="JOB 28:28">28.28</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8"/>
    <char style="add">Ciò</char> sarà una medicina al tuo bellico,</para>
  <para style="q" vid="PRO 3:8">Ed un inaffiamento alle tue ossa.<verse eid="PRO 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9"/>Onora il Signore con le tue facoltà,</para>
  <para style="q" vid="PRO 3:9">E con le primizie d'ogni tua rendita<note caller="*" style="x"><char style="xo" closed="false">3.9 </char><char style="xk" closed="false">rendita </char><char style="xt" closed="false"><ref loc="EXO 22:29">Esod. 22.29</ref> </char><char style="xta" closed="false">e rif.</char></note>;<verse eid="PRO 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10"/>Ed i tuoi granai saran ripieni di beni in ogni abbondanza,</para>
  <para style="q" vid="PRO 3:10">E le tue tina traboccheranno di mosto.<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11"/>Figliuol mio, non disdegnar la correzione del Signore<note caller="*" style="x"><char style="xo" closed="false">3.11 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="JOB 5:17">Giob. 5.17</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 3:11">E non ti rincresca il suo gastigamento;<verse eid="PRO 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12"/>Perciocchè il Signore gastiga chi egli ama;</para>
  <para style="q" vid="PRO 3:12">Anzi come un padre il figliuolo <char style="add">ch</char>'egli gradisce<note caller="*" style="x"><char style="xo" closed="false">3.12 </char><char style="xk" closed="false">gradisce </char><char style="xt" closed="false"><ref loc="DEU 8:5">Deut. 8.5</ref>. <ref loc="1CO 11:32">1 Cor. 11.32</ref>.</char></note>.<verse eid="PRO 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13"/>Beato l'uomo che ha trovata sapienza<note caller="*" style="x"><char style="xo" closed="false">3.13 </char><char style="xk" closed="false">sapienza </char><char style="xt" closed="false"><ref loc="PRO 8:34">Prov. 8.34</ref>,<ref loc="PRO 8:35">35</ref>.</char></note>,</para>
  <para style="q" vid="PRO 3:13">E l'uomo che ha ottenuto intendimento.<verse eid="PRO 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14"/>Perciocchè il traffico di essa <char style="add">è</char> migliore che il traffico dell'argento,</para>
  <para style="q" vid="PRO 3:14">E la sua rendita <char style="add">è migliore</char> che l'oro<note caller="*" style="x"><char style="xo" closed="false">3.14 </char><char style="xk" closed="false">oro </char><char style="xt" closed="false"><ref loc="JOB 28:12-19">Giob. 28.12-19</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15"/>Ella <char style="add">è</char> più preziosa che le perle<note caller="*" style="x"><char style="xo" closed="false">3.15 </char><char style="xk" closed="false">perle </char><char style="xt" closed="false"><ref loc="MAT 13:44-46">Mat. 13.44-46</ref>.</char></note>;</para>
  <para style="q" vid="PRO 3:15">E tutto ciò che tu hai di più caro non la pareggia.<verse eid="PRO 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16"/>Lunghezza di giorni è alla sua destra;</para>
  <para style="q" vid="PRO 3:16">Ricchezza e gloria alla sua sinistra<note caller="*" style="x"><char style="xo" closed="false">3.16 </char><char style="xk" closed="false">sinistra </char><char style="xt" closed="false"><ref loc="1TI 4:8">1 Tim. 4.8</ref>.</char></note>.<verse eid="PRO 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17"/>Le sue vie <char style="add">son</char> vie dilettevoli,</para>
  <para style="q" vid="PRO 3:17">E tutti i suoi sentieri <char style="add">sono</char> pace<note caller="*" style="x"><char style="xo" closed="false">3.17 </char><char style="xk" closed="false">pace </char><char style="xt" closed="false"><ref loc="MAT 11:28-30">Mat. 11.28-30</ref>.</char></note>.<verse eid="PRO 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18"/>Ella <char style="add">è</char> un albero di vita<note caller="*" style="x"><char style="xo" closed="false">3.18 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="GEN 2:9">Gen. 2.9</ref>. <ref loc="REV 2:7">Apoc. 2.7</ref>.</char></note> a quelli che si appigliano ad essa;</para>
  <para style="q" vid="PRO 3:18">E beati coloro che la ritengono.<verse eid="PRO 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19"/>Il Signore ha fondata la terra con sapienza;</para>
  <para style="q" vid="PRO 3:19">Egli ha stabiliti i cieli con intendimento<note caller="*" style="x"><char style="xo" closed="false">3.19 </char><char style="xk" closed="false">intendimento </char><char style="xt" closed="false"><ref loc="PSA 136:5">Sal. 136.5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20"/>Per lo suo conoscimento gli abissi furono fessi,</para>
  <para style="q" vid="PRO 3:20">E l'aria stilla la rugiada.<verse eid="PRO 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21"/>Figliuol mio, non dipartansi giammai <char style="add">queste cose</char> dagli occhi tuoi;</para>
  <para style="q" vid="PRO 3:21">Guarda la ragione e l'avvedimento;<verse eid="PRO 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22"/>E quelle saranno vita all'anima tua<note caller="*" style="x"><char style="xo" closed="false">3.22 </char><char style="xk" closed="false">tua </char><char style="xt" closed="false"><ref loc="DEU 32:47">Deut. 32.47</ref>.</char></note>,</para>
  <para style="q" vid="PRO 3:22">E grazia alla tua gola.<verse eid="PRO 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23"/>Allora camminerai sicuramente per la tua via,</para>
  <para style="q" vid="PRO 3:23">Ed il tuo piè non incapperà<note caller="*" style="x"><char style="xo" closed="false">3.23 </char><char style="xk" closed="false">incapperà </char><char style="xt" closed="false"><ref loc="PSA 37:24">Sal. 37.24</ref>; <ref loc="PSA 91:11">91.11</ref>,<ref loc="PSA 91:12">12</ref>. <ref loc="PRO 10:9">Prov. 10.9</ref>.</char></note>.<verse eid="PRO 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24"/>Quando tu giacerai, non avrai spavento;</para>
  <para style="q" vid="PRO 3:24">E <char style="add">quando</char> tu ti riposerai, il tuo sonno sarà dolce<note caller="*" style="x"><char style="xo" closed="false">3.24 </char><char style="xk" closed="false">dolce </char><char style="xt" closed="false"><ref loc="LEV 26:6">Lev. 26.6</ref>. <ref loc="PSA 3:5">Sal. 3.5</ref>; <ref loc="PSA 4:8">4.8</ref>.</char></note>.<verse eid="PRO 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25"/>Tu non temerai di subito spavento,</para>
  <para style="q" vid="PRO 3:25">Nè della ruina degli empi, quando ella avverrà.<verse eid="PRO 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26"/>Perciocchè il Signore sarà al tuo fianco,</para>
  <para style="q" vid="PRO 3:26">E guarderà il tuo piè, che non sia preso<note caller="*" style="x"><char style="xo" closed="false">3.26 </char><char style="xk" closed="false">preso </char><char style="xt" closed="false"><ref loc="1SA 2:9">1 Sam. 2.9</ref>.</char></note>.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27"/>Non negare il bene a quelli a cui è dovuto<note caller="*" style="x"><char style="xo" closed="false">3.27 </char><char style="xk" closed="false">dovuto </char><char style="xt" closed="false"><ref loc="ROM 13:7">Rom. 13.7</ref>. <ref loc="GAL 6:10">Gal. 6.10</ref>.</char></note>,</para>
  <para style="q" vid="PRO 3:27">Quando è in tuo potere di far<char style="add">lo</char>.<verse eid="PRO 3:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28"/>Non dire al tuo prossimo: Va', e torna,</para>
  <para style="q" vid="PRO 3:28">E domani te <char style="add">lo</char> darò<note caller="*" style="x"><char style="xo" closed="false">3.28 </char><char style="xk" closed="false">darò </char><char style="xt" closed="false"><ref loc="LEV 19:13">Lev. 19.13</ref>. <ref loc="DEU 24:15">Deut. 24.15</ref>.</char></note>, se tu <char style="add">l</char>'hai appo te.<verse eid="PRO 3:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29"/>Non macchinare alcun male contro al tuo prossimo</para>
  <para style="q" vid="PRO 3:29">Che abita in sicurtà teco.<verse eid="PRO 3:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30"/>Non litigar con alcuno senza cagione<note caller="*" style="x"><char style="xo" closed="false">3.30 </char><char style="xk" closed="false">cagione </char><char style="xt" closed="false"><ref loc="ROM 12:18">Rom. 12.18</ref>.</char></note>,</para>
  <para style="q" vid="PRO 3:30">S'egli non ti ha fatto alcun torto.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31"/>Non portare invidia all'uomo violento<note caller="*" style="x"><char style="xo" closed="false">3.31 </char><char style="xk" closed="false">violento </char><char style="xt" closed="false"><ref loc="PSA 37:1">Sal. 37.1</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 3:31">E non eleggere alcuna delle sue vie.<verse eid="PRO 3:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32"/>Perciocchè l'<char style="add">uomo</char> perverso <char style="add">è</char> cosa abbominevole al Signore;</para>
  <para style="q" vid="PRO 3:32">Ma <char style="add">egli comunica</char> il suo consiglio con gli <char style="add">uomini</char> diritti<note caller="*" style="x"><char style="xo" closed="false">3.32 </char><char style="xk" closed="false">diritti </char><char style="xt" closed="false"><ref loc="PSA 25:14">Sal. 25.14</ref>.</char></note>.<verse eid="PRO 3:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33"/>La maledizione del Signore <char style="add">è</char> nella casa dell'empio<note caller="*" style="x"><char style="xo" closed="false">3.33 </char><char style="xk" closed="false">empio </char><char style="xt" closed="false"><ref loc="LEV 26:14">Lev. 26.14</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 3:33">Ma egli benedirà la stanza de' giusti.<verse eid="PRO 3:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34"/>Se egli schernisce gli schernitori,</para>
  <para style="q" vid="PRO 3:34">Dà altresì grazia agli umili<note caller="*" style="x"><char style="xo" closed="false">3.34 </char><char style="xk" closed="false">umili </char><char style="xt" closed="false"><ref loc="JAS 4:6">Giac. 4.6</ref>. <ref loc="1PE 5:5">1 Piet. 5.5</ref>.</char></note>.<verse eid="PRO 3:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35"/>I savi possederanno la gloria;</para>
  <para style="q" vid="PRO 3:35">Ma gli stolti se ne portano ignominia.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Esortazione ad acquistar la Sapienza e ad allontanarsi dalle vie dei peccatori</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1"/>FIGLIUOLI, ascoltate l'ammaestramento del padre;</para>
  <para style="q" vid="PRO 4:1">E siate attenti, per conoscer la prudenza.<verse eid="PRO 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2"/>Perciocchè io vi ho data buona dottrina,</para>
  <para style="q" vid="PRO 4:2">Non lasciate la mia legge.<verse eid="PRO 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3"/>Perciocchè io ancora sono stato figliuol di mio padre,</para>
  <para style="q" vid="PRO 4:3">Tenero, ed unico appresso mia madre<note caller="*" style="x"><char style="xo" closed="false">4.3 </char><char style="xk" closed="false">madre </char><char style="xt" closed="false"><ref loc="1CH 22:5">1 Cron. 22.5</ref>; <ref loc="1CH 29:1">29.1</ref>.</char></note>.<verse eid="PRO 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4"/>Ed esso mi ammaestrava<note caller="*" style="x"><char style="xo" closed="false">4.4 </char><char style="xk" closed="false">ammaestrava </char><char style="xt" closed="false"><ref loc="1CH 28:9">1 Cron. 28.9</ref>. <ref loc="EPH 6:4">Efes. 6.4</ref>.</char></note>, e mi diceva:</para>
  <para style="q" vid="PRO 4:4">Il tuo cuore ritenga le mie parole;</para>
  <para style="q" vid="PRO 4:4">Osserva i miei comandamenti, e tu viverai<note caller="*" style="x"><char style="xo" closed="false">4.4 </char><char style="xk" closed="false">viverai </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lev. 18.5</ref>. <ref loc="ISA 55:3">Is. 55.3</ref>.</char></note>.<verse eid="PRO 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5"/>Acquista sapienza, acquista prudenza;</para>
  <para style="q" vid="PRO 4:5">Non dimenticare i detti della mia bocca, e non rivolgertene indietro.<verse eid="PRO 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6"/>Non abbandonar la <char style="add">sapienza</char>, ed ella ti preserverà;</para>
  <para style="q" vid="PRO 4:6">Amala, ed ella ti guarderà.<verse eid="PRO 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7"/>La sapienza <char style="add">è</char> la principal cosa<note caller="*" style="x"><char style="xo" closed="false">4.7 </char><char style="xk" closed="false">cosa </char><char style="xt" closed="false"><ref loc="MAT 13:44">Mat. 13.44</ref> ecc. <ref loc="LUK 10:42">Luc. 10.42</ref>.</char></note>; acquista la sapienza;</para>
  <para style="q" vid="PRO 4:7">Ed al prezzo di tutti i tuoi beni, acquista la prudenza.<verse eid="PRO 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8"/>Esaltala, ed ella ti innalzerà;</para>
  <para style="q" vid="PRO 4:8">Ella ti glorificherà, quando tu l'avrai abbracciata.<verse eid="PRO 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9"/>Ella ti metterà in sul capo un fregio di grazia;</para>
  <para style="q" vid="PRO 4:9">
    <char style="add">E</char> ti darà una corona d'ornamento.<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10"/>Ascolta, figliuol mio, e ricevi i miei detti;</para>
  <para style="q" vid="PRO 4:10">Ed anni di vita ti saranno moltiplicati.<verse eid="PRO 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11"/>Io ti ho ammaestrato nella via della sapienza;</para>
  <para style="q" vid="PRO 4:11">Io ti ho inviato ne' sentieri della dirittura.<verse eid="PRO 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12"/>Quando tu camminerai, i tuoi passi non saran ristretti<note caller="*" style="x"><char style="xo" closed="false">4.12 </char><char style="xk" closed="false">ristretti </char><char style="xt" closed="false"><ref loc="PSA 91:11">Sal. 91.11</ref>,<ref loc="PSA 91:12">12</ref>.</char></note>;</para>
  <para style="q" vid="PRO 4:12">E se tu corri, tu non incapperai.<verse eid="PRO 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13"/>Attienti all'ammaestramento, non lasciar<char style="add">lo</char>;</para>
  <para style="q" vid="PRO 4:13">Guardalo, perciocchè esso <char style="add">è</char> la tua vita.<verse eid="PRO 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14"/>Non entrare nel sentiero degli empi;</para>
  <para style="q" vid="PRO 4:14">E non camminar per la via de' malvagi<note caller="*" style="x"><char style="xo" closed="false">4.14 </char><char style="xk" closed="false">malvagi </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sal. 1.1</ref>. <ref loc="PRO 1:10">Prov. 1.10</ref>,<ref loc="PRO 1:15">15</ref>.</char></note>.<verse eid="PRO 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15"/>Schifala, non passar per essa;</para>
  <para style="q" vid="PRO 4:15">Stornatene, e passa oltre.<verse eid="PRO 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16"/>Perciocchè essi non possono dormire, se non hanno fatto qualche male<note caller="*" style="x"><char style="xo" closed="false">4.16 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="PSA 35:4">Sal. 35.4</ref>. <ref loc="ISA 57:20">Is. 57.20</ref>.</char></note>;</para>
  <para style="q" vid="PRO 4:16">E il sonno s'invola loro, se non hanno fatto cader qualcuno.<verse eid="PRO 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17"/>Conciossiachè mangino il pane dell'empietà,</para>
  <para style="q" vid="PRO 4:17">E bevano il vino delle violenze.<verse eid="PRO 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18"/>Ma il sentiero de' giusti <char style="add">è</char> come la luce che spunta<note caller="*" style="x"><char style="xo" closed="false">4.18 </char><char style="xk" closed="false">spunta </char><char style="xt" closed="false"><ref loc="MAT 5:14">Mat. 5.14</ref>,<ref loc="MAT 5:15">15</ref>; <ref loc="MAT 13:43">13.43</ref>. <ref loc="PHP 2:15">Fil. 2.15</ref>.</char></note>,</para>
  <para style="q" vid="PRO 4:18">La quale va vie più risplendendo, finchè sia chiaro giorno.<verse eid="PRO 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19"/>La via degli empi <char style="add">è</char> come una caligine;</para>
  <para style="q" vid="PRO 4:19">Essi non sanno in che incappano<note caller="*" style="x"><char style="xo" closed="false">4.19 </char><char style="xk" closed="false">incappano </char><char style="xt" closed="false"><ref loc="JOB 18:5">Giob. 18.5</ref>,<ref loc="JOB 18:6">6</ref>. <ref loc="JHN 12:35">Giov. 12.35</ref>.</char></note>.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20"/>Figliuol mio, attendi alle mie parole;</para>
  <para style="q" vid="PRO 4:20">Inchina l'orecchio tuo a' miei detti.<verse eid="PRO 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21"/>Non dipartansi quelli <char style="add">giammai</char> dagli occhi tuoi;</para>
  <para style="q" vid="PRO 4:21">Guardali in mezzo del tuo cuore;<verse eid="PRO 4:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22"/>Perciocchè son vita a quelli che li trovano<note caller="*" style="x"><char style="xo" closed="false">4.22 </char><char style="xk" closed="false">trovano </char><char style="xt" closed="false"><ref loc="DEU 32:47">Deut. 32.47</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 4:22">E sanità a tutta la lor carne.<verse eid="PRO 4:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23"/>Sopra ogni guardia, guarda il tuo cuore;</para>
  <para style="q" vid="PRO 4:23">Perciocchè da esso procede la vita<note caller="*" style="x"><char style="xo" closed="false">4.23 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12.34</ref>,<ref loc="MAT 12:35">35</ref>.</char></note>.<verse eid="PRO 4:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24"/>Rimuovi da te la perversità della bocca,</para>
  <para style="q" vid="PRO 4:24">Ed allontana da te la perversità delle labbra.<verse eid="PRO 4:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25"/>Gli occhi tuoi riguardino diritto davanti <char style="add">a te</char>,</para>
  <para style="q" vid="PRO 4:25">E le tue palpebre dirizzino la lor mira dinanzi a te.<verse eid="PRO 4:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26"/>Considera attentamente il sentiero de' tuoi piedi,</para>
  <para style="q" vid="PRO 4:26">E sieno addirizzate tutte le tue vie.<verse eid="PRO 4:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27"/>Non dichinar nè a destra, nè a sinistra<note caller="*" style="x"><char style="xo" closed="false">4.27 </char><char style="xk" closed="false">sinistra </char><char style="xt" closed="false"><ref loc="JOS 1:7">Gios. 1.7</ref>.</char></note>;</para>
  <para style="q" vid="PRO 4:27">Rimuovi il tuo piè dal male<note caller="*" style="x"><char style="xo" closed="false">4.27 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="ISA 1:16">Is. 1.16</ref>,<ref loc="ISA 1:17">17</ref>. <ref loc="ROM 12:9">Rom. 12.9</ref>.</char></note>.<verse eid="PRO 4:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1"/>Figliuol mio, attendi alla mia sapienza,</para>
  <para style="q" vid="PRO 5:1">Inchina il tuo orecchio al mio intendimento;<verse eid="PRO 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2"/>Acciocchè tu osservi gli avvedimenti,</para>
  <para style="q" vid="PRO 5:2">E che le tue labbra conservino la scienza.<verse eid="PRO 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3"/>Perciocchè le labbra della <char style="add">donna</char> straniera stillano favi di miele<note caller="*" style="x"><char style="xo" closed="false">5.3 </char><char style="xk" closed="false">miele </char><char style="xt" closed="false"><ref loc="PRO 2:16">Prov. 2.16</ref> </char><char style="xta" closed="false">e rif.</char></note>.</para>
  <para style="q" vid="PRO 5:3">E il suo palato <char style="add">è</char> più dolce che olio;<verse eid="PRO 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4"/>Ma il fine di essa <char style="add">è</char> amaro come assenzio<note caller="*" style="x"><char style="xo" closed="false">5.4 </char><char style="xk" closed="false">assenzio </char><char style="xt" closed="false"><ref loc="ECC 7:26">Eccl. 7.26</ref>.</char></note>,</para>
  <para style="q" vid="PRO 5:4">Acuto come una spada a due tagli.<verse eid="PRO 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5"/>I suoi piedi scendono alla morte;</para>
  <para style="q" vid="PRO 5:5">I suoi passi fanno capo all'inferno.<verse eid="PRO 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6"/>I suoi sentieri sono vaganti, senza che essa sappia ove va,</para>
  <para style="q" vid="PRO 5:6">Perchè non considera attentamente la via della vita.<verse eid="PRO 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7"/>Ora dunque, figliuoli, ascoltatemi,</para>
  <para style="q" vid="PRO 5:7">E non vi dipartite da' detti della mia bocca.<verse eid="PRO 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8"/>Allontana la tua via da essa,</para>
  <para style="q" vid="PRO 5:8">E non accostarti all'uscio della sua casa;<verse eid="PRO 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9"/>Che talora tu non dia il tuo onore agli stranieri,</para>
  <para style="q" vid="PRO 5:9">E gli anni tuoi al crudele;<verse eid="PRO 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10"/>Che talora i forestieri non si sazino delle tue facoltà;</para>
  <para style="q" vid="PRO 5:10">E che le tue fatiche <char style="add">non vadano</char> nella casa dello strano<note caller="*" style="x"><char style="xo" closed="false">5.10 </char><char style="xk" closed="false">strano </char><char style="xt" closed="false"><ref loc="PRO 29:3">Prov. 29.3</ref>.</char></note>;<verse eid="PRO 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11"/>
    <char style="add">E che tu non</char> gema alla fine,</para>
  <para style="q" vid="PRO 5:11">Quando la tua carne ed il tuo corpo saranno consumati;<verse eid="PRO 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12"/>E non dica: Come ebbi io in odio l'ammaestramento?</para>
  <para style="q" vid="PRO 5:12">E come rigettò il mio cuore la correzione<note caller="*" style="x"><char style="xo" closed="false">5.12 </char><char style="xk" closed="false">correzione </char><char style="xt" closed="false"><ref loc="PRO 12:1">Prov. 12.1</ref>.</char></note>?<verse eid="PRO 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13"/>E <char style="add">come</char> non ascoltai la voce di quelli che mi ammaestravano,</para>
  <para style="q" vid="PRO 5:13">E non inchinai il mio orecchio a quelli che m'insegnavano?<verse eid="PRO 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14"/>Quasi che sono stato in ogni male,</para>
  <para style="q" vid="PRO 5:14">In mezzo della raunanza e della congregazione.<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15"/>Bevi delle acque della tua cisterna<note caller="*" style="x"><char style="xo" closed="false">5.15 </char><char style="xk" closed="false">cisterna </char><char style="xt" closed="false"><ref loc="PRO 9:17">Prov. 9.17</ref>. <ref loc="SNG 4:12">Cant. 4.12</ref>.</char></note>,</para>
  <para style="q" vid="PRO 5:15">E de' ruscelli di mezzo della tua fonte.<verse eid="PRO 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16"/>Spandansi le tue fonti fuori,</para>
  <para style="q" vid="PRO 5:16">Ed i ruscelli delle <char style="add">tue</char> acque per le piazze<note caller="*" style="x"><char style="xo" closed="false">5.16 </char><char style="xk" closed="false">piazze </char><char style="xt" closed="false"><ref loc="ZEC 8:5">Zac. 8.5</ref>.</char></note>.<verse eid="PRO 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17"/>Sieno <char style="add">quelle acque</char> a te solo,</para>
  <para style="q" vid="PRO 5:17">E a niuno strano teco.<verse eid="PRO 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18"/>Sia la tua fonte benedetta;</para>
  <para style="q" vid="PRO 5:18">E rallegrati della moglie della tua giovanezza<note caller="*" style="x"><char style="xo" closed="false">5.18 </char><char style="xk" closed="false">giovanezza </char><char style="xt" closed="false"><ref loc="DEU 24:5">Deut. 24.5</ref>.</char></note>.<verse eid="PRO 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19"/>
    <char style="add">Siati ella</char> una cerva amorosa, ed una cavriuola graziosa;</para>
  <para style="q" vid="PRO 5:19">Inebbrinti le sue mammelle in ogni tempo;</para>
  <para style="q" vid="PRO 5:19">Sii del continuo invaghito del suo amore.<verse eid="PRO 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20"/>E perchè, figliuol mio, t'invaghiresti della straniera,</para>
  <para style="q" vid="PRO 5:20">Ed abbracceresti il seno della forestiera<note caller="*" style="x"><char style="xo" closed="false">5.20 </char><char style="xk" closed="false">forestiera </char><char style="xt" closed="false"><ref loc="PRO 2:16">Prov. 2.16</ref> </char><char style="xta" closed="false">e rif.</char></note>?<verse eid="PRO 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21"/>Conciossiachè le vie dell'uomo <char style="add">sieno</char> davanti agli occhi del Signore<note caller="*" style="x"><char style="xo" closed="false">5.21 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="2CH 16:9">2 Cron. 16.9</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 5:21">E ch'egli consideri tutti i suoi sentieri.<verse eid="PRO 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22"/>Le iniquità dell'empio lo prenderanno,</para>
  <para style="q" vid="PRO 5:22">Ed egli sarà ritenuto con le funi del suo peccato<note caller="*" style="x"><char style="xo" closed="false">5.22 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23"/>Egli morrà per mancamento di correzione;</para>
  <para style="q" vid="PRO 5:23">E andrà errando per la molta sua pazzia.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Ammonimenti contro il far sicurtà, e contro la pigrizia e la menzogna</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1"/>FIGLIUOL mio, se tu hai fatta sicurtà al tuo prossimo,</para>
  <para style="q" vid="PRO 6:1">
    <char style="add">Se</char> tu hai toccata la mano allo strano<note caller="*" style="x"><char style="xo" closed="false">6.1 </char><char style="xk" closed="false">strano </char><char style="xt" closed="false"><ref loc="PRO 11:15">Prov. 11.15</ref>; <ref loc="PRO 17:18">17.18</ref>; <ref loc="PRO 20:16">20.16</ref>; <ref loc="PRO 22:26">22.26</ref>; <ref loc="PRO 27:13">27.13</ref>.</char></note>,<verse eid="PRO 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2"/>Tu sei allacciato con le parole della tua bocca,</para>
  <para style="q" vid="PRO 6:2">Tu sei preso con le parole della tua bocca.<verse eid="PRO 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3"/>Ora fa' questo, figliuol mio, e riscuotiti;</para>
  <para style="q" vid="PRO 6:3">Poichè tu sei caduto in man del tuo prossimo,</para>
  <para style="q" vid="PRO 6:3">Va', gittati a' piedi de' tuoi amici, e sollecitali.<verse eid="PRO 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4"/>Non lasciar dormire gli occhi tuoi,</para>
  <para style="q" vid="PRO 6:4">Nè sonnecchiar le tue palpebre.<verse eid="PRO 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5"/>Riscuotiti, come un cavriuolo di mano <char style="add">del cacciatore</char>,</para>
  <para style="q" vid="PRO 6:5">E come un uccello di mano dell'uccellatore.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6"/>Va', pigro, alla formica<note caller="*" style="x"><char style="xo" closed="false">6.6 </char><char style="xk" closed="false">formica </char><char style="xt" closed="false"><ref loc="JOB 12:7">Giob. 12.7</ref>. <ref loc="PRO 30:24">Prov. 30.24</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 6:6">Riguarda le sue vie, e diventa savio;<verse eid="PRO 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7"/>Conciossiachè ella non abbia nè capitano,</para>
  <para style="q" vid="PRO 6:7">Nè magistrato, nè signore;<verse eid="PRO 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8"/>
    <char style="add">E pure</char> ella apparecchia nella state il suo cibo,</para>
  <para style="q" vid="PRO 6:8">
    <char style="add">E</char> raduna nella ricolta il suo mangiare.<verse eid="PRO 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9"/>Infino a quando, o pigro, giacerai?</para>
  <para style="q" vid="PRO 6:9">Quando ti desterai dal tuo sonno<note caller="*" style="x"><char style="xo" closed="false">6.9 </char><char style="xk" closed="false">sonno </char><char style="xt" closed="false"><ref loc="PRO 24:33">Prov. 24.33</ref>,<ref loc="PRO 24:34">34</ref>.</char></note>?<verse eid="PRO 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10"/>Dormendo un poco, sonnecchiando un poco,</para>
  <para style="q" vid="PRO 6:10">Piegando un poco le braccia per riposare;<verse eid="PRO 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11"/>La tua povertà verrà come un viandante,</para>
  <para style="q" vid="PRO 6:11">E la tua necessità come uno scudiere<note caller="*" style="x"><char style="xo" closed="false">6.11 </char><char style="xk" closed="false">scudiere </char><char style="xt" closed="false"><ref loc="PRO 10:4">Prov. 10.4</ref>; <ref loc="PRO 13:4">13.4</ref>; <ref loc="PRO 19:15">19.15</ref>,<ref loc="PRO 19:24">24</ref>; <ref loc="PRO 20:4">20.4</ref>.</char></note>.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12"/>L'uomo scellerato, l'uomo da nulla,</para>
  <para style="q" vid="PRO 6:12">Procede con perversità di bocca.<verse eid="PRO 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13"/>Egli ammicca con gli occhi, parla co' piedi,</para>
  <para style="q" vid="PRO 6:13">Accenna con le dita<note caller="*" style="x"><char style="xo" closed="false">6.13 </char><char style="xk" closed="false">dita </char><char style="xt" closed="false"><ref loc="ROM 6:13">Rom. 6.13</ref>,<ref loc="ROM 6:19">19</ref>.</char></note>;<verse eid="PRO 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14"/>Egli ha delle perversità nel suo cuore,</para>
  <para style="q" vid="PRO 6:14">Egli macchina del male in ogni tempo;</para>
  <para style="q" vid="PRO 6:14">Egli commette contese.<verse eid="PRO 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15"/>Perciò in un momento verrà la sua ruina;</para>
  <para style="q" vid="PRO 6:15">Egli di subito sarà fiaccato, senza rimedio.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16"/>Il Signore odia queste sei cose;</para>
  <para style="q" vid="PRO 6:16">Anzi <char style="add">queste</char> sette <char style="add">son</char> cosa abbominevole all'anima sua;<verse eid="PRO 6:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17"/>Gli occhi altieri<note caller="*" style="x"><char style="xo" closed="false">6.17 </char><char style="xk" closed="false">altieri </char><char style="xt" closed="false"><ref loc="PSA 18:26">Sal. 18.26</ref>; <ref loc="PSA 101:5">101.5</ref>.</char></note>, la lingua bugiarda<note caller="*" style="x"><char style="xo" closed="false">6.17 </char><char style="xk" closed="false">bugiarda </char><char style="xt" closed="false"><ref loc="PSA 120:2">Sal. 120.2</ref>,<ref loc="PSA 120:3">3</ref>. <ref loc="PRO 12:22">Prov. 12.22</ref>.</char></note>,</para>
  <para style="q" vid="PRO 6:17">E la mani che spandono il sangue innocente<note caller="*" style="x"><char style="xo" closed="false">6.17 </char><char style="xk" closed="false">innocente </char><char style="xt" closed="false"><ref loc="ISA 1:15">Is. 1.15</ref>.</char></note>,<verse eid="PRO 6:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18"/>Il cuore che divisa pensieri d'iniquità<note caller="*" style="x"><char style="xo" closed="false">6.18 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="GEN 6:5">Gen. 6.5</ref>,<ref loc="GEN 6:6">6</ref>.</char></note>,</para>
  <para style="q" vid="PRO 6:18">I piedi che si affrettano per correre al male<note caller="*" style="x"><char style="xo" closed="false">6.18 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="ISA 59:7">Is. 59.7</ref>. <ref loc="ROM 3:15">Rom. 3.15</ref>.</char></note>,<verse eid="PRO 6:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19"/>Il falso testimonio che sbocca menzogne<note caller="*" style="x"><char style="xo" closed="false">6.19 </char><char style="xk" closed="false">menzogne </char><char style="xt" closed="false"><ref loc="PRO 19:5">Prov. 19.5</ref>,<ref loc="PRO 19:9">9</ref>.</char></note>,</para>
  <para style="q" vid="PRO 6:19">E colui che commette contese tra fratelli.<verse eid="PRO 6:19"/></para>
  <para style="s1">Il giovane ammonito contro la donna adultera</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20"/>FIGLIUOL mio, guarda il comandamento di tuo padre,</para>
  <para style="q" vid="PRO 6:20">E non lasciar l'insegnamento di tua madre<note caller="*" style="x"><char style="xo" closed="false">6.20 </char><char style="xk" closed="false">madre </char><char style="xt" closed="false"><ref loc="PRO 1:8">Prov. 1.8</ref>. <ref loc="EPH 6:1">Efes. 6.1</ref>.</char></note>;<verse eid="PRO 6:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21"/>Tienli del continuo legati in sul tuo cuore,</para>
  <para style="q" vid="PRO 6:21">
    <char style="add">Ed</char> avvinti in su la tua gola<note caller="*" style="x"><char style="xo" closed="false">6.21 </char><char style="xk" closed="false">gola </char><char style="xt" closed="false"><ref loc="PRO 3:3">Prov. 3.3</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 6:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22"/>Quando tu camminerai, quello ti guiderà;</para>
  <para style="q" vid="PRO 6:22">Quando tu giacerai, farà la guardia intorno a te;</para>
  <para style="q" vid="PRO 6:22">E quando tu ti risveglierai, ragionerà teco<note caller="*" style="x"><char style="xo" closed="false">6.22 </char><char style="xk" closed="false">teco </char><char style="xt" closed="false"><ref loc="PRO 3:23">Prov. 3.23</ref>,<ref loc="PRO 3:24">24</ref> </char><char style="xta" closed="false">e rif.</char></note>;<verse eid="PRO 6:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23"/>Perciocchè il comandamento <char style="add">è</char> una lampana,</para>
  <para style="q" vid="PRO 6:23">E l'insegnamento <char style="add">è</char> una luce<note caller="*" style="x"><char style="xo" closed="false">6.23 </char><char style="xk" closed="false">luce </char><char style="xt" closed="false"><ref loc="PSA 19:8-11">Sal. 19.8-11</ref>; <ref loc="PSA 119:105">119.105</ref>.</char></note>,</para>
  <para style="q" vid="PRO 6:23">E le correzioni di disciplina <char style="add">son</char> la via della vita;<verse eid="PRO 6:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24"/>Per guardarti dalla femmina malvagia<note caller="*" style="x"><char style="xo" closed="false">6.24 </char><char style="xk" closed="false">malvagia </char><char style="xt" closed="false"><ref loc="PRO 2:16">Prov. 2.16</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 6:24">Dalle lusinghe della lingua della straniera.<verse eid="PRO 6:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25"/>Non invaghirti nel tuo cuore della sua bellezza<note caller="*" style="x"><char style="xo" closed="false">6.25 </char><char style="xk" closed="false">bellezza </char><char style="xt" closed="false"><ref loc="MAT 5:28">Mat. 5.28</ref>.</char></note>;</para>
  <para style="q" vid="PRO 6:25">E non prendati ella con le sue palpebre.<verse eid="PRO 6:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26"/>Perciocchè per una donna meretrice <char style="add">si viene</char> fino ad un pezzo di pane<note caller="*" style="x"><char style="xo" closed="false">6.26 </char><char style="xk" closed="false">pane </char><char style="xt" closed="false"><ref loc="PRO 29:3">Prov. 29.3</ref>.</char></note>;</para>
  <para style="q" vid="PRO 6:26">E la donna vaga d'uomini va a caccia dietro alle anime preziose<note caller="*" style="x"><char style="xo" closed="false">6.26 </char><char style="xk" closed="false">preziose </char><char style="xt" closed="false"><ref loc="EZK 13:18">Ezec. 13.18</ref>.</char></note>.<verse eid="PRO 6:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27"/>Alcuno prenderà egli del fuoco in seno,</para>
  <para style="q" vid="PRO 6:27">Senza che i suoi vestimenti ne sieno arsi?<verse eid="PRO 6:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28"/>Alcuno camminerà egli sopra le brace,</para>
  <para style="q" vid="PRO 6:28">Senza bruciarsi i piedi?<verse eid="PRO 6:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29"/>Così <char style="add">avviene</char> a chi entra dalla moglie del suo prossimo;</para>
  <para style="q" vid="PRO 6:29">Chiunque la tocca non sarà innocente.<verse eid="PRO 6:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30"/>Ei non si scusa il ladro, quando egli ruba</para>
  <para style="q" vid="PRO 6:30">Per saziarsi, avendo fame;<verse eid="PRO 6:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31"/>Anzi, <char style="add">se</char> è colto, restituisce <char style="add">il furto</char> a sette doppi<note caller="*" style="x"><char style="xo" closed="false">6.31 </char><char style="xk" closed="false">doppi </char><char style="xt" closed="false"><ref loc="EXO 22:1">Esod. 22.1</ref>,<ref loc="EXO 22:4">4</ref>.</char></note>,</para>
  <para style="q" vid="PRO 6:31">Egli dà tutta la sostanza di casa sua.<verse eid="PRO 6:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32"/>Chi commette adulterio con una donna <char style="add">è</char> scemo di senno<note caller="*" style="x"><char style="xo" closed="false">6.32 </char><char style="xk" closed="false">senno </char><char style="xt" closed="false"><ref loc="PRO 7:6">Prov. 7.6</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 6:32">Chi vuol perder l'anima sua faccia tal cosa.<verse eid="PRO 6:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33"/>Egli troverà ferite ed ignominia;</para>
  <para style="q" vid="PRO 6:33">E il suo vituperio non sarà <char style="add">giammai</char> cancellato.<verse eid="PRO 6:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34"/>Perciocchè la gelosia <char style="add">è</char> un furor dell'uomo<note caller="*" style="x"><char style="xo" closed="false">6.34 </char><char style="xk" closed="false">uomo </char><char style="xt" closed="false"><ref loc="PRO 27:4">Prov. 27.4</ref>. <ref loc="SNG 8:6">Cant. 8.6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 6:34">Ed egli non risparmierà nel giorno della vendetta<note caller="*" style="x"><char style="xo" closed="false">6.34 </char><char style="xk" closed="false">vendetta </char><char style="xt" closed="false"><ref loc="LEV 20:10">Lev. 20.10</ref>.</char></note>.<verse eid="PRO 6:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35"/>Egli non avrà riguardo ad alcun riscatto;</para>
  <para style="q" vid="PRO 6:35">Ed avvegnachè tu moltiplichi i presenti, non però li accetterà.<verse eid="PRO 6:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1"/>Figliuol mio, guarda i miei detti,</para>
  <para style="q" vid="PRO 7:1">E riponi appo te i miei comandamenti.<verse eid="PRO 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2"/>Guarda i miei comandamenti, e tu viverai<note caller="*" style="x"><char style="xo" closed="false">7.2 </char><char style="xk" closed="false">viverai </char><char style="xt" closed="false"><ref loc="PRO 4:4">Prov. 4.4</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 7:2">E <char style="add">guarda</char> il mio insegnamento, come la pupilla degli occhi tuoi.<verse eid="PRO 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3"/>Legateli alle dita,</para>
  <para style="q" vid="PRO 7:3">Scrivili in su la tavola del tuo cuore<note caller="*" style="x"><char style="xo" closed="false">7.3 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PRO 3:3">Prov. 3.3</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4"/>Di' alla sapienza: Tu <char style="add">sei</char> mia sorella;</para>
  <para style="q" vid="PRO 7:4">E chiama la prudenza <char style="add">tua</char> parente;<verse eid="PRO 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5"/>Acciocchè esse ti guardino dalla donna straniera,</para>
  <para style="q" vid="PRO 7:5">Dalla forestiera che parla vezzosamente<note caller="*" style="x"><char style="xo" closed="false">7.5 </char><char style="xk" closed="false">vezzosamente </char><char style="xt" closed="false"><ref loc="PRO 2:16">Prov. 2.16</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6"/>Perciocchè io riguardava <char style="add">una volta</char> per la finestra della mia casa,</para>
  <para style="q" vid="PRO 7:6">Per li miei cancelli;<verse eid="PRO 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7"/>E vidi tra gli scempi,</para>
  <para style="q" vid="PRO 7:7">
    <char style="add">E</char> scorsi tra i fanciulli, un giovanetto scemo di senno<note caller="*" style="x"><char style="xo" closed="false">7.7 </char><char style="xk" closed="false">senno </char><char style="xt" closed="false"><ref loc="PRO 6:32">Prov. 6.32</ref>.</char></note>;<verse eid="PRO 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8"/>Il qual passava per la strada, presso al cantone <char style="add">della casa</char> d'una tal donna;</para>
  <para style="q" vid="PRO 7:8">E camminava traendo alla casa di essa;<verse eid="PRO 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9"/>In su la sera, in sul vespro del dì<note caller="*" style="x"><char style="xo" closed="false">7.9 </char><char style="xk" closed="false">dì </char><char style="xt" closed="false"><ref loc="JOB 24:15">Giob. 24.15</ref>.</char></note>.</para>
  <para style="q" vid="PRO 7:9">In su l'imbrunire ed oscurar della notte;<verse eid="PRO 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10"/>Ed ecco, una donna gli <char style="add">venne</char> incontro,</para>
  <para style="q" vid="PRO 7:10">In assetto da meretrice, e cauta d'animo;<verse eid="PRO 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11"/>Strepitosa, e sviata;</para>
  <para style="q" vid="PRO 7:11">I cui piedi non si fermavano in casa<note caller="*" style="x"><char style="xo" closed="false">7.11 </char><char style="xk" closed="false">casa </char><char style="xt" closed="false"><ref loc="1TI 5:13">1 Tim. 5.13</ref>. <ref loc="TIT 2:4">Tit. 2.4</ref>,<ref loc="TIT 2:5">5</ref>.</char></note>;<verse eid="PRO 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12"/>Essendo ora fuori, or per le piazze;</para>
  <para style="q" vid="PRO 7:12">E stando agli agguati presso ad ogni cantone<note caller="*" style="x"><char style="xo" closed="false">7.12 </char><char style="xk" closed="false">cantone </char><char style="xt" closed="false"><ref loc="PRO 23:27">Prov. 23.27</ref>,<ref loc="PRO 23:28">28</ref>.</char></note>.<verse eid="PRO 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13"/>Ed essa lo prese, e lo baciò,</para>
  <para style="q" vid="PRO 7:13">E sfacciatamente gli disse:<verse eid="PRO 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14"/>Io avea sopra me <char style="add">il voto di</char> sacrificii da render grazie;</para>
  <para style="q" vid="PRO 7:14">Oggi ho pagati i miei voti.<verse eid="PRO 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15"/>Però ti sono uscita incontro,</para>
  <para style="q" vid="PRO 7:15">Per cercarti, e ti ho trovato.<verse eid="PRO 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16"/>Io ho acconcio il mio letto con capoletti</para>
  <para style="q" vid="PRO 7:16">Di lavoro figurato a cordicelle <char style="add">di fil</char> di Egitto.<verse eid="PRO 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17"/>Io ho profumato il mio letto</para>
  <para style="q" vid="PRO 7:17">Con mirra, con aloe, e con cinnamomo.<verse eid="PRO 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18"/>Vieni, inebbriamoci d'amori infino alla mattina,</para>
  <para style="q" vid="PRO 7:18">Sollaziamoci in amorosi piaceri.<verse eid="PRO 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19"/>Perciocchè il marito non <char style="add">è</char> in casa sua;</para>
  <para style="q" vid="PRO 7:19">Egli è andato in viaggio lontano;<verse eid="PRO 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20"/>Egli ha preso in mano un sacchetto di danari;</para>
  <para style="q" vid="PRO 7:20">Egli ritornerà a casa sua a nuova luna.<verse eid="PRO 7:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21"/>Ella lo piegò con le molte sue lusinghe<note caller="*" style="x"><char style="xo" closed="false">7.21 </char><char style="xk" closed="false">lusinghe </char><char style="xt" closed="false"><ref loc="PRO 5:3">Prov. 5.3</ref>.</char></note>,</para>
  <para style="q" vid="PRO 7:21">E lo sospinse con la dolcezza delle sue labbra.<verse eid="PRO 7:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22"/>
    <char style="add">Ed</char> egli andò dietro a lei subitamente,</para>
  <para style="q" vid="PRO 7:22">Come il bue viene al macello,</para>
  <para style="q" vid="PRO 7:22">E come i ceppi <char style="add">son</char> per gastigamento dello stolto;<verse eid="PRO 7:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23"/>Come l'uccello si affretta al laccio,</para>
  <para style="q" vid="PRO 7:23">Senza sapere che è contro alla vita sua<note caller="*" style="x"><char style="xo" closed="false">7.23 </char><char style="xk" closed="false">sua </char><char style="xt" closed="false"><ref loc="ECC 9:12">Eccl. 9.12</ref>.</char></note>,</para>
  <para style="q" vid="PRO 7:23">Finchè la saetta gli trafigga il fegato.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24"/>Ora dunque, figliuoli, ascoltatemi,</para>
  <para style="q" vid="PRO 7:24">Ed attendete a' detti della mia bocca.<verse eid="PRO 7:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25"/>Il cuor tuo non dichini alle vie d'una tal donna;</para>
  <para style="q" vid="PRO 7:25">Non isviarti ne' suoi sentieri.<verse eid="PRO 7:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26"/>Perciocchè ella ne ha fatti cader molti uccisi;</para>
  <para style="q" vid="PRO 7:26">E pur tutti coloro ch'ella ha morti <char style="add">eran</char> possenti<note caller="*" style="x"><char style="xo" closed="false">7.26 </char><char style="xk" closed="false">possenti </char><char style="xt" closed="false"><ref loc="JDG 16:1">Giud. 16.1</ref> ecc. <ref loc="NEH 13:26">Neem. 13.26</ref>.</char></note>.<verse eid="PRO 7:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27"/>La sua casa <char style="add">è</char> la via dell'inferno<note caller="*" style="x"><char style="xo" closed="false">7.27 </char><char style="xk" closed="false">inferno </char><char style="xt" closed="false"><ref loc="PRO 2:18">Prov. 2.18</ref>; <ref loc="PRO 5:5">5.5</ref>; <ref loc="PRO 9:18">9.18</ref>.</char></note>,</para>
  <para style="q" vid="PRO 7:27">Che scende a' più interni luoghi della morte.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">L'eccellenza e la chiarezza dei precetti della Sapienza</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1"/>LA Sapienza non grida ella<note caller="*" style="x"><char style="xo" closed="false">8.1 </char><char style="xk" closed="false">ella </char><char style="xt" closed="false"><ref loc="PRO 1:20">Prov. 1.20</ref> e rif.; <ref loc="PRO 9:3">9.3</ref>.</char></note>?</para>
  <para style="q" vid="PRO 8:1">E la Prudenza non dà ella fuori la sua voce?<verse eid="PRO 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2"/>Ella sta in piè in capo de' luoghi elevati, in su la via,</para>
  <para style="q" vid="PRO 8:2">Ne' crocicchi.<verse eid="PRO 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3"/>Ella grida presso alle porte, alla bocca della città,</para>
  <para style="q" vid="PRO 8:3">All'entrata degli usci <char style="add">delle case</char>,<verse eid="PRO 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4"/>
    <char style="add">Dicendo</char>: Io grido a voi, o uomini principali;</para>
  <para style="q" vid="PRO 8:4">E la mia voce <char style="add">s'indirizza</char> ancora al volgo.<verse eid="PRO 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5"/>Semplici, intendete <char style="add">che cosa sia</char> avvedimento;</para>
  <para style="q" vid="PRO 8:5">E <char style="add">voi</char> stolti, intendete <char style="add">che cosa sia</char> buon senno.<verse eid="PRO 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6"/>Ascoltate; perciocchè io proporrò cose eccellenti;</para>
  <para style="q" vid="PRO 8:6">L'aprir delle mie labbra <char style="add">sarà</char> di cose diritte.<verse eid="PRO 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7"/>Conciossiachè il mio palato ragionerà di verità;</para>
  <para style="q" vid="PRO 8:7">Ma l'empietà <char style="add">è</char> ciò che le mie labbra abbominano.<verse eid="PRO 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8"/>Tutti i detti della mia bocca <char style="add">son</char> con giustizia;</para>
  <para style="q" vid="PRO 8:8">In essi non <char style="add">vi è</char> nulla di torto o di perverso.<verse eid="PRO 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9"/>Essi tutti <char style="add">son</char> diritti agl'intendenti,</para>
  <para style="q" vid="PRO 8:9">E bene addirizzati a coloro che hanno trovata la scienza.<verse eid="PRO 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10"/>Ricevete il mio ammaestramento, e non dell'argento;</para>
  <para style="q" vid="PRO 8:10">E scienza, anzi che oro eletto.<verse eid="PRO 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11"/>Perciocchè la sapienza <char style="add">è</char> migliore che le perle;</para>
  <para style="q" vid="PRO 8:11">E tutte le cose le più care non l'agguagliano<note caller="*" style="x"><char style="xo" closed="false">8.11 </char><char style="xk" closed="false">agguagliano </char><char style="xt" closed="false"><ref loc="PRO 3:14">Prov. 3.14</ref>,<ref loc="PRO 3:15">15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12"/>Io, la Sapienza, abito nell'avvedimento,</para>
  <para style="q" vid="PRO 8:12">E trovo la conoscenza de' buoni avvisi.<verse eid="PRO 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13"/>Il timor del Signore <char style="add">è</char> odiare il male<note caller="*" style="x"><char style="xo" closed="false">8.13 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="PSA 97:10">Sal. 97.10</ref>. <ref loc="PRO 16:6">Prov. 16.6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 8:13">Io odio la superbia, e l'alterezza, e la via della malvagità,</para>
  <para style="q" vid="PRO 8:13">E la bocca perversa.<verse eid="PRO 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14"/>A me <char style="add">appartiene</char> il consiglio<note caller="*" style="x"><char style="xo" closed="false">8.14 </char><char style="xk" closed="false">consiglio </char><char style="xt" closed="false"><ref loc="ISA 9:5">Is. 9.5</ref>.</char></note> e la buona ragione;</para>
  <para style="q" vid="PRO 8:14">Io <char style="add">son</char> la prudenza; a me <char style="add">appartiene</char> la forza<note caller="*" style="x"><char style="xo" closed="false">8.14 </char><char style="xk" closed="false">forza </char><char style="xt" closed="false"><ref loc="ECC 7:19">Eccl. 7.19</ref>.</char></note>.<verse eid="PRO 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15"/>Per me regnano i re<note caller="*" style="x"><char style="xo" closed="false">8.15 </char><char style="xk" closed="false">re </char><char style="xt" closed="false"><ref loc="DAN 2:21">Dan. 2.21</ref>. <ref loc="ROM 13:1-7">Rom. 13.1-7</ref>.</char></note>,</para>
  <para style="q" vid="PRO 8:15">Ed i rettori fanno statuti di giustizia.<verse eid="PRO 8:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16"/>Per me signoreggiano i signori,</para>
  <para style="q" vid="PRO 8:16">Ed i principi, <char style="add">e</char> tutti i giudici della terra.<verse eid="PRO 8:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17"/>Io amo quelli che mi amano<note caller="*" style="x"><char style="xo" closed="false">8.17 </char><char style="xk" closed="false">amano </char><char style="xt" closed="false"><ref loc="JHN 14:21">Giov. 14.21</ref>.</char></note>;</para>
  <para style="q" vid="PRO 8:17">E quelli che mi cercano mi troveranno<note caller="*" style="x"><char style="xo" closed="false">8.17 </char><char style="xk" closed="false">troveranno </char><char style="xt" closed="false"><ref loc="JAS 1:5">Giac. 1.5</ref>.</char></note>.<verse eid="PRO 8:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18"/>Ricchezze e gloria <char style="add">son</char> meco;</para>
  <para style="q" vid="PRO 8:18">Beni permanenti e giustizia<note caller="*" style="x"><char style="xo" closed="false">8.18 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PRO 3:16">Prov. 3.16</ref> e rif. <ref loc="MAT 6:33">Mat. 6.33</ref>.</char></note>.<verse eid="PRO 8:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19"/>Il mio frutto <char style="add">è</char> migliore che oro, anzi che oro finissimo;</para>
  <para style="q" vid="PRO 8:19">E la mia rendita <char style="add">migliore</char> che argento eletto<note caller="*" style="x"><char style="xo" closed="false">8.19 </char><char style="xk" closed="false">eletto </char><char style="xt" closed="false"><ref loc="PRO 3:14">Prov. 3.14</ref> e rif. <ref loc="EPH 3:8">Efes. 3.8</ref>. <ref loc="REV 3:18">Apoc. 3.18</ref>.</char></note>.<verse eid="PRO 8:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20"/>Io cammino per la via della giustizia,</para>
  <para style="q" vid="PRO 8:20">In mezzo de' sentieri della dirittura;<verse eid="PRO 8:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21"/>Per fare eredare il <char style="add">vero</char> essere a quelli che mi amano,</para>
  <para style="q" vid="PRO 8:21">Ed empiere i lor tesori.<verse eid="PRO 8:21"/></para>
  <para style="s1">La Sapienza è da ogni eternità</para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22"/>IL Signore mi possedeva al principio della sua via<note caller="*" style="x"><char style="xo" closed="false">8.22 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="GEN 1:1">Gen. 1.1</ref> ecc. <ref loc="JHN 1:1-3">Giov. 1.1-3</ref>.</char></note>,</para>
  <para style="q" vid="PRO 8:22">Avanti le sue opere, ab eterno.<verse eid="PRO 8:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23"/>Io sono stata costituita in principato ab eterno,</para>
  <para style="q" vid="PRO 8:23">Dal principio, avanti che la terra fosse<note caller="*" style="x"><char style="xo" closed="false">8.23 </char><char style="xk" closed="false">fosse </char><char style="xt" closed="false"><ref loc="PSA 2:6">Sal. 2.6</ref>. <ref loc="JHN 17:5">Giov. 17.5</ref>.</char></note>.<verse eid="PRO 8:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24"/>Avanti che <char style="add">fossero</char> abissi,</para>
  <para style="q" vid="PRO 8:24">Nè fonti, nè gorghi d'acque, io fui prodotta.<verse eid="PRO 8:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25"/>Io fui prodotta innanzi che i monti fossero profondati<note caller="*" style="x"><char style="xo" closed="false">8.25 </char><char style="xk" closed="false">profondati </char><char style="xt" closed="false"><ref loc="PSA 90:2">Sal. 90.2</ref>.</char></note>,</para>
  <para style="q" vid="PRO 8:25">Avanti i colli;<verse eid="PRO 8:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26"/>Mentre egli non avea <char style="add">ancora</char> fatta la terra, nè le campagne,</para>
  <para style="q" vid="PRO 8:26">Nè la sommità del terreno del mondo.<verse eid="PRO 8:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27"/>Quando egli ordinava i cieli, io v'<char style="add">era</char>;</para>
  <para style="q" vid="PRO 8:27">Quando egli disegnava il giro sopra la superficie dell'abisso;<verse eid="PRO 8:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28"/>Quando egli fermava il cielo disopra;</para>
  <para style="q" vid="PRO 8:28">Quando egli fortificava le fonti dell'abisso;<verse eid="PRO 8:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29"/>Quando egli poneva il suo termine al mare<note caller="*" style="x"><char style="xo" closed="false">8.29 </char><char style="xk" closed="false">mare </char><char style="xt" closed="false"><ref loc="GEN 1:9">Gen. 1.9</ref>,<ref loc="GEN 1:10">10</ref>.</char></note>,</para>
  <para style="q" vid="PRO 8:29">Talchè le acque non possono trapassare il suo comandamento;</para>
  <para style="q" vid="PRO 8:29">Quando egli poneva i fondamenti della terra;<verse eid="PRO 8:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30"/>Ed era appo lui<note caller="*" style="x"><char style="xo" closed="false">8.30 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="JHN 1:1">Giov. 1.1</ref>,<ref loc="JHN 1:2">2</ref>,<ref loc="JHN 1:18">18</ref>.</char></note> <char style="add">come</char> un allievo,</para>
  <para style="q" vid="PRO 8:30">Ed era le <char style="add">sue</char> delizie tuttodì<note caller="*" style="x"><char style="xo" closed="false">8.30 </char><char style="xk" closed="false">tuttodì </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat. 3.17</ref>. <ref loc="COL 1:13">Col. 1.13</ref>.</char></note>;</para>
  <para style="q" vid="PRO 8:30">Io mi sollazzava in ogni tempo nel suo cospetto.<verse eid="PRO 8:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31"/>Io mi sollazzo nella parte abitata della sua terra;</para>
  <para style="q" vid="PRO 8:31">Ed i miei diletti <char style="add">sono</char> co' figliuoli degli uomini.<verse eid="PRO 8:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32"/>Ora dunque, figliuoli, ascoltatemi:</para>
  <para style="q" vid="PRO 8:32">Beati <char style="add">coloro che</char> osservano le mie vie<note caller="*" style="x"><char style="xo" closed="false">8.32 </char><char style="xk" closed="false">vie </char><char style="xt" closed="false"><ref loc="PSA 119:1">Sal. 119.1</ref>,<ref loc="PSA 119:2">2</ref>. <ref loc="LUK 11:28">Luc. 11.28</ref>.</char></note>.<verse eid="PRO 8:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33"/>Ascoltate l'ammaestramento, e diventate savi,</para>
  <para style="q" vid="PRO 8:33">E non <char style="add">lo</char> schifate.<verse eid="PRO 8:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34"/>Beato l'uomo che mi ascolta<note caller="*" style="x"><char style="xo" closed="false">8.34 </char><char style="xk" closed="false">ascolta </char><char style="xt" closed="false"><ref loc="PRO 3:13">Prov. 3.13</ref>,<ref loc="PRO 3:18">18</ref>. <ref loc="MAT 17:5">Mat. 17.5</ref>.</char></note>,</para>
  <para style="q" vid="PRO 8:34">Per vegliar tuttodì presso a' miei usci;</para>
  <para style="q" vid="PRO 8:34">Per istare a guardia agli stipiti delle mie porte.<verse eid="PRO 8:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35"/>Perciocchè chi mi trova trova la vita,</para>
  <para style="q" vid="PRO 8:35">Ed ottiene benevolenza dal Signore.<verse eid="PRO 8:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36"/>Ma chi pecca contro a me fa ingiuria all'anima sua;</para>
  <para style="q" vid="PRO 8:36">Tutti quelli che mi odiano amano la morte.<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Il convito della Sapienza. — La follia degli stolti</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1"/>LA somma Sapienza ha edificata la sua casa<note caller="*" style="x"><char style="xo" closed="false">9.1 </char><char style="xk" closed="false">casa </char><char style="xt" closed="false"><ref loc="EPH 2:20-22">Efes. 2.20-22</ref>. <ref loc="1PE 2:5">1 Piet. 2.5</ref>.</char></note>,</para>
  <para style="q" vid="PRO 9:1">Ella ha tagliate le sue colonne <char style="add">in numero di</char> sette;<verse eid="PRO 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2"/>Ella ha ammazzati i suoi animali, ha temperato il suo vino.</para>
  <para style="q" vid="PRO 9:2">Ed anche ha apparecchiata la sua mensa<note caller="*" style="x"><char style="xo" closed="false">9.2 </char><char style="xk" closed="false">mensa </char><char style="xt" closed="false"><ref loc="MAT 22:1">Mat. 22.1</ref> ecc. <ref loc="LUK 14:16">Luc. 14.16</ref> ecc.</char></note>.<verse eid="PRO 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3"/>Ella ha mandate le sue serventi a gridare<note caller="*" style="x"><char style="xo" closed="false">9.3 </char><char style="xk" closed="false">gridare </char><char style="xt" closed="false"><ref loc="ROM 10:15">Rom. 10.15</ref>.</char></note></para>
  <para style="q" vid="PRO 9:3">D'in su i poggiuoli degli alti luoghi della città:<verse eid="PRO 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4"/>Chi <char style="add">è</char> scempio? riducasi qua<note caller="*" style="x"><char style="xo" closed="false">9.4 </char><char style="xk" closed="false">qua </char><char style="xt" closed="false"><ref loc="MAT 11:25">Mat. 11.25</ref>.</char></note>.</para>
  <para style="q" vid="PRO 9:4">E a dire a quelli che sono scemi di senno:<verse eid="PRO 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5"/>Venite, mangiate del mio pane<note caller="*" style="x"><char style="xo" closed="false">9.5 </char><char style="xk" closed="false">pane </char><char style="xt" closed="false"><ref loc="ISA 55:1">Is. 55.1</ref>. <ref loc="JHN 6:27">Giov. 6.27</ref>.</char></note>,</para>
  <para style="q" vid="PRO 9:5">E bevete del vino <char style="add">che</char> io ho temperato.<verse eid="PRO 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6"/>Lasciate le scempietà, e voi viverete;</para>
  <para style="q" vid="PRO 9:6">E camminate per la via della prudenza.<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7"/>Chi corregge lo schernitore <char style="add">ne</char> riceve vituperio;</para>
  <para style="q" vid="PRO 9:7">E chi riprende l'empio <char style="add">ne riceve</char> macchia.<verse eid="PRO 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8"/>Non riprender lo schernitore,</para>
  <para style="q" vid="PRO 9:8">Che talora egli non ti odii<note caller="*" style="x"><char style="xo" closed="false">9.8 </char><char style="xk" closed="false">odii </char><char style="xt" closed="false"><ref loc="MAT 7:6">Mat. 7.6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 9:8">Riprendi il savio, ed egli ti amerà<note caller="*" style="x"><char style="xo" closed="false">9.8 </char><char style="xk" closed="false">amerà </char><char style="xt" closed="false"><ref loc="PSA 141:5">Sal. 141.5</ref>.</char></note>.<verse eid="PRO 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9"/>Insegna al savio, ed egli diventerà più savio;</para>
  <para style="q" vid="PRO 9:9">Ammaestra il giusto, ed egli crescerà in dottrina<note caller="*" style="x"><char style="xo" closed="false">9.9 </char><char style="xk" closed="false">dottrina </char><char style="xt" closed="false"><ref loc="PRO 1:5">Prov. 1.5</ref>. <ref loc="MAT 13:12">Mat. 13.12</ref>.</char></note>.<verse eid="PRO 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10"/>Il principio della sapienza <char style="add">è</char> il timor del Signore<note caller="*" style="x"><char style="xo" closed="false">9.10 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="JOB 28:28">Giob. 28.28</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 9:10">E la scienza de' santi <char style="add">è</char> la prudenza.<verse eid="PRO 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11"/>Perciocchè per me ti saranno moltiplicati i giorni,</para>
  <para style="q" vid="PRO 9:11">E ti saranno aggiunti anni di vita<note caller="*" style="x"><char style="xo" closed="false">9.11 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PRO 3:2">Prov. 3.2</ref>,<ref loc="PRO 3:16">16</ref>; <ref loc="PRO 10:27">10.27</ref>.</char></note>.<verse eid="PRO 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12"/>Se sei savio, sarai savio per te<note caller="*" style="x"><char style="xo" closed="false">9.12 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="JOB 28:28">Giob. 28.28</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 9:12">Se <char style="add">altresì</char> sei schernitore, tu solo <char style="add">ne</char> porterai <char style="add">la pena</char><note caller="*" style="x"><char style="xo" closed="false">9.12 </char><char style="xk" closed="false"><char style="add">pena</char> </char><char style="xt" closed="false"><ref loc="GAL 6:5">Gal. 6.5</ref>.</char></note>.<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13"/>La donna stolta<note caller="*" style="x"><char style="xo" closed="false">9.13 </char><char style="xk" closed="false">stolta </char><char style="xt" closed="false"><ref loc="PRO 7:7">Prov. 7.7</ref> ecc.</char></note>, strepitosa,</para>
  <para style="q" vid="PRO 9:13">Scempia, e che non ha alcuno intendimento,<verse eid="PRO 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14"/>Siede anch'essa all'entrata della sua casa,</para>
  <para style="q" vid="PRO 9:14">In seggio, ne' luoghi elevati della città.<verse eid="PRO 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15"/>Per gridare a coloro che passano per la via,</para>
  <para style="q" vid="PRO 9:15">Che vanno a dirittura a lor cammino:<verse eid="PRO 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16"/>Chi <char style="add">è</char> scempio? riducasi qua.</para>
  <para style="q" vid="PRO 9:16">E se vi <char style="add">è</char> alcuno scemo di senno, gli dice:<verse eid="PRO 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17"/>Le acque rubate<note caller="*" style="x"><char style="xo" closed="false">9.17 </char><char style="xk" closed="false">rubate </char><char style="xt" closed="false"><ref loc="PRO 5:15">Prov. 5.15</ref>.</char></note> son dolci,</para>
  <para style="q" vid="PRO 9:17">E il pane <char style="add">preso</char> di nascosto è dilettevole<note caller="*" style="x"><char style="xo" closed="false">9.17 </char><char style="xk" closed="false">dilettevole </char><char style="xt" closed="false"><ref loc="PRO 20:17">Prov. 20.17</ref>.</char></note>.<verse eid="PRO 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18"/>Ed egli non sa che là <char style="add">sono</char> i morti<note caller="*" style="x"><char style="xo" closed="false">9.18 </char><char style="xk" closed="false">morti </char><char style="xt" closed="false"><ref loc="PRO 2:18">Prov. 2.18</ref>; <ref loc="PRO 7:27">7.27</ref>.</char></note>;</para>
  <para style="q" vid="PRO 9:18">
    <char style="add">E che</char> quelli ch'ella ha convitati <char style="add">son</char> nel fondo dell'inferno.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">Proverbi sopra varii soggetti</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 10:1"/>LE sentenze di Salomone<note caller="*" style="x"><char style="xo" closed="false">10.1 </char><char style="xk" closed="false">Salomone </char><char style="xt" closed="false"><ref loc="PRO 1:1">Prov. 1.1</ref>; <ref loc="PRO 25:1">25.1</ref>.</char></note>.</para>
  <para style="b" vid="PRO 10:1"/>
  <para style="q" vid="PRO 10:1">Il figliuol savio rallegra il padre<note caller="*" style="x"><char style="xo" closed="false">10.1 </char><char style="xk" closed="false">padre </char><char style="xt" closed="false"><ref loc="PRO 15:20">Prov. 15.20</ref>; <ref loc="PRO 17:21">17.21</ref>,<ref loc="PRO 17:25">25</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:1">Ma il figliuolo solto <char style="add">è</char> il cordoglio di sua madre.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2"/>I tesori d'empietà non giovano<note caller="*" style="x"><char style="xo" closed="false">10.2 </char><char style="xk" closed="false">giovano </char><char style="xt" closed="false"><ref loc="PSA 49:6">Sal. 49.6</ref> ecc. <ref loc="LUK 12:19">Luc. 12.19</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 10:2">Ma la giustizia riscuote da morte.<verse eid="PRO 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3"/>Il Signore non lascerà aver fame all'anima del giusto<note caller="*" style="x"><char style="xo" closed="false">10.3 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="PSA 34:9">Sal. 34.9</ref>,<ref loc="PSA 34:10">10</ref>; <ref loc="PSA 37:25">37.25</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:3">Ma egli sovverte la sostanza degli empi.<verse eid="PRO 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4"/>La man rimessa fa impoverire<note caller="*" style="x"><char style="xo" closed="false">10.4 </char><char style="xk" closed="false">impoverire </char><char style="xt" closed="false"><ref loc="PRO 12:24">Prov. 12.24</ref>; <ref loc="PRO 19:15">19.15</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:4">Ma la mano de' diligenti arricchisce<note caller="*" style="x"><char style="xo" closed="false">10.4 </char><char style="xk" closed="false">arricchisce </char><char style="xt" closed="false"><ref loc="PRO 13:4">Prov. 13.4</ref>; <ref loc="PRO 21:5">21.5</ref>.</char></note>.<verse eid="PRO 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5"/>Chi raccoglie nella state <char style="add">è</char> un figliuolo avveduto;</para>
  <para style="q" vid="PRO 10:5">
    <char style="add">Ma</char> chi dorme nella ricolta <char style="add">è</char> un figliuolo che fa vituperio.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6"/>Benedizioni <char style="add">sono</char> sopra il capo del giusto;</para>
  <para style="q" vid="PRO 10:6">Ma la violenza coprirà la bocca degli empi.<verse eid="PRO 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7"/>La memoria del giusto <char style="add">è</char> in benedizione;</para>
  <para style="q" vid="PRO 10:7">Ma il nome degli empi marcirà.<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8"/>Il savio di cuore riceve i comandamenti;</para>
  <para style="q" vid="PRO 10:8">Ma lo stolto di labbra andrà in precipizio.<verse eid="PRO 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9"/>Chi cammina in integrità cammina in sicurtà<note caller="*" style="x"><char style="xo" closed="false">10.9 </char><char style="xk" closed="false">sicurtà </char><char style="xt" closed="false"><ref loc="PRO 28:18">Prov. 28.18</ref>. <ref loc="ISA 33:15">Is. 33.15</ref>,<ref loc="ISA 33:16">16</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:9">Ma chi perverte le sue vie sarà fiaccato.<verse eid="PRO 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10"/>Chi ammicca con l'occhio reca molestia;</para>
  <para style="q" vid="PRO 10:10">Ma lo stolto di labbra andrà in precipizio.<verse eid="PRO 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11"/>La bocca del giusto <char style="add">è</char> una fonte viva<note caller="*" style="x"><char style="xo" closed="false">10.11 </char><char style="xk" closed="false">viva </char><char style="xt" closed="false"><ref loc="PRO 13:14">Prov. 13.14</ref>; <ref loc="PRO 18:4">18.4</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:11">Ma la violenza coprirà la bocca degli empi.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12"/>L'odio muove contese;</para>
  <para style="q" vid="PRO 10:12">Ma la carità ricopre ogni misfatto<note caller="*" style="x"><char style="xo" closed="false">10.12 </char><char style="xk" closed="false">misfatto </char><char style="xt" closed="false"><ref loc="1CO 13:4">1 Cor. 13.4</ref>,<ref loc="1CO 13:7">7</ref>. <ref loc="1PE 4:8">1 Piet. 4.8</ref>.</char></note>.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13"/>La sapienza si trova nelle labbra dell'intendente;</para>
  <para style="q" vid="PRO 10:13">Ma il bastone <char style="add">è</char> per lo dosso di chi <char style="add">è</char> scemo di senno<note caller="*" style="x"><char style="xo" closed="false">10.13 </char><char style="xk" closed="false">senno </char><char style="xt" closed="false"><ref loc="PRO 19:29">Prov. 19.29</ref>; <ref loc="PRO 26:3">26.3</ref>.</char></note>.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14"/>I savi ripongono <char style="add">appo loro</char> la scienza;</para>
  <para style="q" vid="PRO 10:14">Ma la bocca dello stolto <char style="add">è</char> una ruina vicina<note caller="*" style="x"><char style="xo" closed="false">10.14 </char><char style="xk" closed="false">vicina </char><char style="xt" closed="false"><ref loc="PRO 13:3">Prov. 13.3</ref>; <ref loc="PRO 18:7">18.7</ref>; <ref loc="PRO 21:23">21.23</ref>.</char></note>.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15"/>Le facoltà del ricco <char style="add">son</char> la sua forte città<note caller="*" style="x"><char style="xo" closed="false">10.15 </char><char style="xk" closed="false">città </char><char style="xt" closed="false"><ref loc="PRO 18:11">Prov. 18.11</ref>. <ref loc="1TI 6:17">1 Tim. 6.17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:15">
    <char style="add">Ma</char> la povertà de' bisognosi <char style="add">è</char> il loro spavento.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16"/>Le opere de' giusti <char style="add">sono</char> a vita;</para>
  <para style="q" vid="PRO 10:16">
    <char style="add">Ma</char> quello che l'empio produce <char style="add">è</char> a peccato.<verse eid="PRO 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17"/>Chi osserva l'ammaestramento <char style="add">è</char> un cammino a vita<note caller="*" style="x"><char style="xo" closed="false">10.17 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PRO 6:23">Prov. 6.23</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:17">Ma chi lascia la correzione fa traviare.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18"/>Chi copre l'odio <char style="add">è uomo di</char> labbra bugiarde;</para>
  <para style="q" vid="PRO 10:18">E chi sbocca infamia <char style="add">è</char> stolto.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19"/>In moltitudine di parole non manca misfatto<note caller="*" style="x"><char style="xo" closed="false">10.19 </char><char style="xk" closed="false">misfatto </char><char style="xt" closed="false"><ref loc="ECC 5:2">Eccl. 5.2</ref>,<ref loc="ECC 5:3">3</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:19">Ma chi rattiene le sue labbra <char style="add">è</char> prudente<note caller="*" style="x"><char style="xo" closed="false">10.19 </char><char style="xk" closed="false">prudente </char><char style="xt" closed="false"><ref loc="PRO 17:27">Prov. 17.27</ref>. <ref loc="JAS 3:2">Giac. 3.2</ref>.</char></note>.<verse eid="PRO 10:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20"/>La lingua del giusto <char style="add">è</char> argento eletto;</para>
  <para style="q" vid="PRO 10:20">
    <char style="add">Ma</char> il cuor degli empi <char style="add">è</char> ben poca cosa.<verse eid="PRO 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21"/>Le labbra del giusto pascono molti;</para>
  <para style="q" vid="PRO 10:21">Ma gli stolti muoiono per mancamento di senno.<verse eid="PRO 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22"/>La benedizione del Signore <char style="add">è</char> quella che arricchisce<note caller="*" style="x"><char style="xo" closed="false">10.22 </char><char style="xk" closed="false">arricchisce </char><char style="xt" closed="false"><ref loc="GEN 24:35">Gen. 24.35</ref>; <ref loc="GEN 26:12">26.12</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:22">E la fatica non le sopraggiugne nulla<note caller="*" style="x"><char style="xo" closed="false">10.22 </char><char style="xk" closed="false">nulla </char><char style="xt" closed="false"><ref loc="PSA 127:2">Sal. 127.2</ref>.</char></note>.<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23"/>Il commettere scelleratezza <char style="add">è</char> allo stolto come uno scherzare<note caller="*" style="x"><char style="xo" closed="false">10.23 </char><char style="xk" closed="false">scherzare </char><char style="xt" closed="false"><ref loc="PRO 2:14">Prov. 2.14</ref>; <ref loc="PRO 14:9">14.9</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:23">Così <char style="add">è</char> la sapienza all'uomo d'intendimento.<verse eid="PRO 10:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24"/>Egli avverrà all'empio ciò ch'egli teme;</para>
  <para style="q" vid="PRO 10:24">Ma <char style="add">Iddio</char> darà a' giusti ciò che desiderano<note caller="*" style="x"><char style="xo" closed="false">10.24 </char><char style="xk" closed="false">desiderano </char><char style="xt" closed="false"><ref loc="MAT 5:6">Mat. 5.6</ref>. <ref loc="1JN 5:14">1 Giov. 5.14</ref>,<ref loc="1JN 5:15">15</ref>.</char></note>.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25"/>Come il turbo passa via <char style="add">di subito</char>, così l'empio non <char style="add">è più</char><note caller="*" style="x"><char style="xo" closed="false">10.25 </char><char style="xk" closed="false"><char style="add">più</char> </char><char style="xt" closed="false"><ref loc="PSA 37:9">Sal. 37.9</ref>,<ref loc="PSA 37:10">10</ref>,<ref loc="PSA 37:35">35</ref>,<ref loc="PSA 37:36">36</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:25">Ma il giusto <char style="add">è</char> un fondamento perpetuo<note caller="*" style="x"><char style="xo" closed="false">10.25 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"><ref loc="MAT 7:24">Mat. 7.24</ref>,<ref loc="MAT 7:25">25</ref>.</char></note>.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26"/>Quale <char style="add">è</char> l'aceto a' denti, e il fumo agli occhi,</para>
  <para style="q" vid="PRO 10:26">Tale <char style="add">è</char> il pigro a quelli che lo mandano.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27"/>Il timor del Signore accresce i giorni<note caller="*" style="x"><char style="xo" closed="false">10.27 </char><char style="xk" closed="false">giorni </char><char style="xt" closed="false"><ref loc="PRO 9:11">Prov. 9.11</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 10:27">Ma gli anni degli empi saranno scorciati.<verse eid="PRO 10:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28"/>L'aspettar de' giusti <char style="add">è</char> letizia;</para>
  <para style="q" vid="PRO 10:28">Ma la speranza degli empi perirà<note caller="*" style="x"><char style="xo" closed="false">10.28 </char><char style="xk" closed="false">perirà </char><char style="xt" closed="false"><ref loc="PSA 112:10">Sal. 112.10</ref>. <ref loc="PRO 11:7">Prov. 11.7</ref>.</char></note>.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29"/>La via del Signore <char style="add">è</char> una fortezza all'<char style="add">uomo</char> intiero;</para>
  <para style="q" vid="PRO 10:29">Ma <char style="add">ella è</char> spavento agli operatori d'iniquità.<verse eid="PRO 10:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30"/>Il giusto non sarà giammai in eterno scrollato<note caller="*" style="x"><char style="xo" closed="false">10.30 </char><char style="xk" closed="false">scrollato </char><char style="xt" closed="false"><ref loc="PSA 37:22">Sal. 37.22</ref>,<ref loc="PSA 37:28">28</ref>,<ref loc="PSA 37:29">29</ref>; <ref loc="PSA 125:1">125.1</ref>.</char></note>;</para>
  <para style="q" vid="PRO 10:30">Ma gli empi non abiteranno la terra.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31"/>La bocca del giusto produce sapienza;</para>
  <para style="q" vid="PRO 10:31">Ma la lingua perversa sarà troncata.<verse eid="PRO 10:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32"/>Le labbra del giusto conoscono ciò che <char style="add">è</char> gradevole;</para>
  <para style="q" vid="PRO 10:32">Ma la bocca dell'empio <char style="add">non è altro che</char> perversità.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1"/>Le bilance false <char style="add">sono</char> cosa abbominevole al Signore<note caller="*" style="x"><char style="xo" closed="false">11.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="LEV 19:35">Lev. 19.35</ref>,<ref loc="LEV 19:36">36</ref>. <ref loc="DEU 25:13-16">Deut. 25.13-16</ref>. <ref loc="PRO 20:10">Prov. 20.10</ref>,<ref loc="PRO 20:23">23</ref>.</char></note>;</para>
  <para style="q" vid="PRO 11:1">Ma il peso giusto gli <char style="add">è</char> cosa grata.<verse eid="PRO 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2"/>Venuta la superbia, viene l'ignominia<note caller="*" style="x"><char style="xo" closed="false">11.2 </char><char style="xk" closed="false">ignominia </char><char style="xt" closed="false"><ref loc="PRO 15:33">Prov. 15.33</ref>; <ref loc="PRO 16:18">16.18</ref>; <ref loc="PRO 18:12">18.12</ref>. <ref loc="DAN 4:30">Dan. 4.30</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 11:2">Ma la sapienza <char style="add">è</char> con gli umili.<verse eid="PRO 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3"/>L'integrità degli <char style="add">uomini</char> diritti li conduce;</para>
  <para style="q" vid="PRO 11:3">Ma la perversità de' disleali di distrugge<note caller="*" style="x"><char style="xo" closed="false">11.3 </char><char style="xk" closed="false">distrugge </char><char style="xt" closed="false"><ref loc="PRO 13:6">Prov. 13.6</ref>; <ref loc="PRO 22:12">22.12</ref>.</char></note>.<verse eid="PRO 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4"/>Le ricchezze non gioveranno al giorno dell'indegnazione<note caller="*" style="x"><char style="xo" closed="false">11.4 </char><char style="xk" closed="false">indegnazione </char><char style="xt" closed="false"><ref loc="PRO 10:2">Prov. 10.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 11:4">Ma la giustizia riscoterà da morte<note caller="*" style="x"><char style="xo" closed="false">11.4 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="GEN 7:1">Gen. 7.1</ref>.</char></note>.<verse eid="PRO 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5"/>La giustizia dell'<char style="add">uomo</char> intiero addirizza la via di esso;</para>
  <para style="q" vid="PRO 11:5">Ma l'empio caderà per la sua empietà.<verse eid="PRO 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6"/>La giustizia degli <char style="add">uomini</char> diritti li riscoterà;</para>
  <para style="q" vid="PRO 11:6">Ma i disleali saranno presi per la lor propria malizia<note caller="*" style="x"><char style="xo" closed="false">11.6 </char><char style="xk" closed="false">malizia </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7"/>Quando l'uomo empio muore, la sua aspettazione perisce<note caller="*" style="x"><char style="xo" closed="false">11.7 </char><char style="xk" closed="false">perisce </char><char style="xt" closed="false"><ref loc="PRO 10:28">Prov. 10.28</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 11:7">E la speranza <char style="add">ch'egli aveva concepita</char> delle <char style="add">sue</char> forze è perduta.<verse eid="PRO 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8"/>Il giusto è tratto fuor di distretta;</para>
  <para style="q" vid="PRO 11:8">Ma l'empio viene in luogo suo<note caller="*" style="x"><char style="xo" closed="false">11.8 </char><char style="xk" closed="false">suo </char><char style="xt" closed="false"><ref loc="PRO 21:18">Prov. 21.18</ref>.</char></note>.<verse eid="PRO 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9"/>L'ipocrito corrompe il suo prossimo con la <char style="add">sua</char> bocca;</para>
  <para style="q" vid="PRO 11:9">Ma i giusti <char style="add">ne</char> son liberati per conoscimento.<verse eid="PRO 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10"/>La città festeggia del bene de' giusti;</para>
  <para style="q" vid="PRO 11:10">Ma <char style="add">vi è</char> giubilo quando gli empi periscono<note caller="*" style="x"><char style="xo" closed="false">11.10 </char><char style="xk" closed="false">periscono </char><char style="xt" closed="false"><ref loc="EST 8:15">Est. 8.15</ref>. <ref loc="PRO 28:12">Prov. 28.12</ref>,<ref loc="PRO 28:28">28</ref>.</char></note>.<verse eid="PRO 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11"/>La città è innalzata per la benedizione degli <char style="add">uomini</char> diritti;</para>
  <para style="q" vid="PRO 11:11">Ma è sovvertita per la bocca degli empi.<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12"/>Chi sprezza il suo prossimo <char style="add">è</char> privo di senno;</para>
  <para style="q" vid="PRO 11:12">Ma l'uomo prudente tace.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13"/>Colui che va sparlando palesa il segreto<note caller="*" style="x"><char style="xo" closed="false">11.13 </char><char style="xk" closed="false">segreto </char><char style="xt" closed="false"><ref loc="LEV 19:16">Lev. 19.16</ref>.</char></note>;</para>
  <para style="q" vid="PRO 11:13">Ma chi è leale di spirito cela la cosa.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14"/>Il popolo cade in ruina dove non <char style="add">son</char> consigli;</para>
  <para style="q" vid="PRO 11:14">Ma <char style="add">vi è</char> salute in moltitudine di consiglieri<note caller="*" style="x"><char style="xo" closed="false">11.14 </char><char style="xk" closed="false">consiglieri </char><char style="xt" closed="false"><ref loc="1KI 12:1">1 Re. 12.1</ref> ecc. <ref loc="PRO 15:22">Prov. 15.22</ref>.</char></note>.<verse eid="PRO 11:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15"/>L'uomo certamente sofferirà del male, se fa sicurtà per lo strano<note caller="*" style="x"><char style="xo" closed="false">11.15 </char><char style="xk" closed="false">strano </char><char style="xt" closed="false"><ref loc="PRO 6:1">Prov. 6.1</ref> </char><char style="xta" closed="false">ecc. e rif.</char></note>;</para>
  <para style="q" vid="PRO 11:15">Ma chi odia i mallevadori <char style="add">è</char> sicuro.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16"/>La donna graziosa otterrà gloria<note caller="*" style="x"><char style="xo" closed="false">11.16 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="PRO 31:30">Prov. 31.30</ref>.</char></note>,</para>
  <para style="q" vid="PRO 11:16">Come i possenti ottengono ricchezze.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17"/>L'uomo benigno fa bene a sè stesso<note caller="*" style="x"><char style="xo" closed="false">11.17 </char><char style="xk" closed="false">stesso </char><char style="xt" closed="false"><ref loc="MAT 5:7">Mat. 5.7</ref>; <ref loc="MAT 25:34">25.34</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 11:17">Ma il crudele conturba la sua <char style="add">propria</char> carne.<verse eid="PRO 11:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18"/>L'empio fa un'opera fallace;</para>
  <para style="q" vid="PRO 11:18">Ma <char style="add">vi è</char> un premio sicuro per colui che semina giustizia<note caller="*" style="x"><char style="xo" closed="false">11.18 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="HOS 10:12">Os. 10.12</ref>. <ref loc="GAL 6:7">Gal. 6.7</ref>,<ref loc="GAL 6:8">8</ref>. <ref loc="JAS 3:18">Giac. 3.18</ref>.</char></note>.<verse eid="PRO 11:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19"/>Così <char style="add">è</char> la giustizia a vita,</para>
  <para style="q" vid="PRO 11:19">Come chi procaccia il male lo procaccia alla sua morte.<verse eid="PRO 11:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20"/>I perversi di cuore <char style="add">sono</char> un abbominio al Signore;</para>
  <para style="q" vid="PRO 11:20">Ma quelli che sono intieri di via <char style="add">son</char> ciò che gli è grato.<verse eid="PRO 11:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21"/>Il malvagio d'ora in ora non resterà impunito<note caller="*" style="x"><char style="xo" closed="false">11.21 </char><char style="xk" closed="false">impunito </char><char style="xt" closed="false"><ref loc="PRO 12:7">Prov. 12.7</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 11:21">Ma la progenie de' giusti scamperà.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22"/>Una donna bella, ma scema di senno,</para>
  <para style="q" vid="PRO 11:22">
    <char style="add">È</char> un monile d'oro nel grifo d'un porco.<verse eid="PRO 11:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23"/>Il desiderio de' giusti non <char style="add">è</char> altro che bene;</para>
  <para style="q" vid="PRO 11:23">
    <char style="add">Ma</char> la speranza degli empi <char style="add">è</char> indegnazione<note caller="*" style="x"><char style="xo" closed="false">11.23 </char><char style="xk" closed="false">indegnazione </char><char style="xt" closed="false"><ref loc="ROM 2:8">Rom. 2.8</ref>,<ref loc="ROM 2:9">9</ref>.</char></note>.<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24"/>Vi è tale che spande, e pur vie più diventa ricco<note caller="*" style="x"><char style="xo" closed="false">11.24 </char><char style="xk" closed="false">ricco </char><char style="xt" closed="false"><ref loc="PSA 37:21">Sal. 37.21</ref>; <ref loc="PSA 112:9">112.9</ref>.</char></note>;</para>
  <para style="q" vid="PRO 11:24">E tale che risparmia oltre al diritto, e <char style="add">pur</char> ne diventa sempre più povero.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25"/>La persona liberale sarà ingrassata<note caller="*" style="x"><char style="xo" closed="false">11.25 </char><char style="xk" closed="false">ingrassata </char><char style="xt" closed="false"><ref loc="2CO 9:6-10">2 Cor. 9.6-10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 11:25">E chi annaffia sarà anch'esso annaffiato<note caller="*" style="x"><char style="xo" closed="false">11.25 </char><char style="xk" closed="false">annaffiato </char><char style="xt" closed="false"><ref loc="MAT 5:7">Mat. 5.7</ref>.</char></note>.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26"/>Il popolo maledirà chi serra il grano<note caller="*" style="x"><char style="xo" closed="false">11.26 </char><char style="xk" closed="false">grano </char><char style="xt" closed="false"><ref loc="AMO 8:5">Am. 8.5</ref>,<ref loc="AMO 8:6">6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 11:26">Ma benedizione <char style="add">sarà</char> sopra il capo di chi <char style="add">lo</char> vende<note caller="*" style="x"><char style="xo" closed="false">11.26 </char><char style="xk" closed="false">vende </char><char style="xt" closed="false"><ref loc="GEN 42:6">Gen. 42.6</ref>.</char></note>.<verse eid="PRO 11:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27"/>Chi cerca il bene procaccia benevolenza;</para>
  <para style="q" vid="PRO 11:27">Ma il male avverrà a chi lo cerca<note caller="*" style="x"><char style="xo" closed="false">11.27 </char><char style="xk" closed="false">cerca </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28"/>Chi si confida nelle sue ricchezze caderà<note caller="*" style="x"><char style="xo" closed="false">11.28 </char><char style="xk" closed="false">caderà </char><char style="xt" closed="false"><ref loc="MRK 10:24">Mar. 10.24</ref>. <ref loc="1TI 6:17">1 Tim. 6.17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 11:28">Ma i giusti germoglieranno a guisa di frondi<note caller="*" style="x"><char style="xo" closed="false">11.28 </char><char style="xk" closed="false">frondi </char><char style="xt" closed="false"><ref loc="PSA 1:3">Sal. 1.3</ref>; <ref loc="PSA 52:8">52.8</ref>; <ref loc="PSA 92:12-14">92.12-14</ref>. <ref loc="JER 17:8">Ger. 17.8</ref>.</char></note>.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29"/>Chi dissipa la sua casa possederà del vento;</para>
  <para style="q" vid="PRO 11:29">E lo stolto <char style="add">sarà</char> servo a chi è savio di cuore.<verse eid="PRO 11:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30"/>Il frutto del giusto <char style="add">è</char> un albero di vita;</para>
  <para style="q" vid="PRO 11:30">E il savio prende le anime<note caller="*" style="x"><char style="xo" closed="false">11.30 </char><char style="xk" closed="false">anime </char><char style="xt" closed="false"><ref loc="DAN 12:3">Dan. 12.3</ref>. <ref loc="1CO 9:19-22">1 Cor. 9.19-22</ref>. <ref loc="JAS 5:20">Giac. 5.20</ref>.</char></note>.<verse eid="PRO 11:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31"/>Ecco, il giusto riceve la sua retribuzione in terra;</para>
  <para style="q" vid="PRO 11:31">Quanto più <char style="add">la riceverà</char> l'empio e il peccatore<note caller="*" style="x"><char style="xo" closed="false">11.31 </char><char style="xk" closed="false">peccatore </char><char style="xt" closed="false"><ref loc="1PE 4:17">1 Piet. 4.17</ref>,<ref loc="1PE 4:18">18</ref>.</char></note>?<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1"/>Chi ama la correzione ama la scienza;</para>
  <para style="q" vid="PRO 12:1">Ma chi odia la riprensione <char style="add">è</char> insensato<note caller="*" style="x"><char style="xo" closed="false">12.1 </char><char style="xk" closed="false">insensato </char><char style="xt" closed="false"><ref loc="PRO 15:10">Prov. 15.10</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 12:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2"/>L'uomo da bene ottiene benevolenza dal Signore;</para>
  <para style="q" vid="PRO 12:2">Ma egli condannerà l'uomo malizioso.<verse eid="PRO 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3"/>L'uomo non sarà stabilito per empietà;</para>
  <para style="q" vid="PRO 12:3">E la radice de' giusti non sarà smossa.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4"/>La donna di valore <char style="add">è</char> la corona del suo marito<note caller="*" style="x"><char style="xo" closed="false">12.4 </char><char style="xk" closed="false">marito </char><char style="xt" closed="false"><ref loc="PRO 18:22">Prov. 18.22</ref>; <ref loc="PRO 31:23">31.23</ref>. <ref loc="1CO 11:7">1 Cor. 11.7</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:4">Ma quella che reca vituperio gli <char style="add">è</char> come un tarlo nelle ossa.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5"/>I pensieri de' giusti <char style="add">son</char> dirittura;</para>
  <para style="q" vid="PRO 12:5">
    <char style="add">Ma</char> i consigli degli empi <char style="add">son</char> frode.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6"/>La parole degli empi <char style="add">tendono</char> ad insidiare al sangue;</para>
  <para style="q" vid="PRO 12:6">Ma la bocca degli <char style="add">uomini</char> diritti li riscoterà.<verse eid="PRO 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7"/>In un voltar degli empi, essi non <char style="add">saranno più</char><note caller="*" style="x"><char style="xo" closed="false">12.7 </char><char style="xk" closed="false"><char style="add">più</char> </char><char style="xt" closed="false"><ref loc="PSA 37:35">Sal. 37.35</ref>,<ref loc="PSA 37:36">36</ref>. <ref loc="PRO 11:21">Prov. 11.21</ref>. <ref loc="MAT 7:24-27">Mat. 7.24-27</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:7">Ma la casa de' giusti starà in piè.<verse eid="PRO 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8"/>L'uomo sarà lodato secondo il suo senno;</para>
  <para style="q" vid="PRO 12:8">Ma chi è stravolto d'animo sarà in isprezzo<note caller="*" style="x"><char style="xo" closed="false">12.8 </char><char style="xk" closed="false">isprezzo </char><char style="xt" closed="false"><ref loc="1SA 25:17">1 Sam. 25.17</ref>.</char></note>.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9"/>Meglio <char style="add">è</char> colui del quale non si fa stima, e pure ha un servitore,</para>
  <para style="q" vid="PRO 12:9">Che colui che fa il borioso, ed ha mancamento di pane<note caller="*" style="x"><char style="xo" closed="false">12.9 </char><char style="xk" closed="false">pane </char><char style="xt" closed="false"><ref loc="PRO 13:7">Prov. 13.7</ref>.</char></note>.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10"/>
    <char style="add">L'uomo</char> giusto ha cura della vita della sua bestia<note caller="*" style="x"><char style="xo" closed="false">12.10 </char><char style="xk" closed="false">bestia </char><char style="xt" closed="false"><ref loc="DEU 25:4">Deut. 25.4</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:10">Ma le viscere degli empi <char style="add">son</char> crudeli.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11"/>Chi lavora la sua terra sarà saziato di pane<note caller="*" style="x"><char style="xo" closed="false">12.11 </char><char style="xk" closed="false">pane </char><char style="xt" closed="false"><ref loc="GEN 3:19">Gen. 3.19</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:11">Ma chi va dietro agli uomini oziosi <char style="add">è</char> scemo d'intelletto.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12"/>L'empio appetisce la rete de' malvagi<note caller="*" style="x"><char style="xo" closed="false">12.12 </char><char style="xk" closed="false">malvagi </char><char style="xt" closed="false"><ref loc="PSA 10:8-10">Sal. 10.8-10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:12">Ma la radice de' giusti mette fuori.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13"/>Il laccio del malvagio <char style="add">è</char> nella dislealtà delle labbra<note caller="*" style="x"><char style="xo" closed="false">12.13 </char><char style="xk" closed="false">labbra </char><char style="xt" closed="false"><ref loc="PRO 18:7">Prov. 18.7</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 12:13">Ma il giusto uscirà di distretta<note caller="*" style="x"><char style="xo" closed="false">12.13 </char><char style="xk" closed="false">distretta </char><char style="xt" closed="false"><ref loc="2PE 2:9">2 Piet. 2.9</ref>.</char></note>.<verse eid="PRO 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14"/>L'uomo sarà saziato di beni per lo frutto della <char style="add">sua</char> bocca;</para>
  <para style="q" vid="PRO 12:14">E <char style="add">Dio</char> renderà all'uomo la retribuzione <char style="add">dell'opere</char> delle sue mani<note caller="*" style="x"><char style="xo" closed="false">12.14 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="ISA 3:10">Is. 3.10</ref>,<ref loc="ISA 3:11">11</ref>.</char></note>.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15"/>La via dello stolto <char style="add">è</char> diritta al suo parere<note caller="*" style="x"><char style="xo" closed="false">12.15 </char><char style="xk" closed="false">parere </char><char style="xt" closed="false"><ref loc="PRO 3:7">Prov. 3.7</ref>; <ref loc="PRO 14:12">14.12</ref>; <ref loc="PRO 16:2">16.2</ref>,<ref loc="PRO 16:25">25</ref>; <ref loc="PRO 21:2">21.2</ref>; <ref loc="PRO 26:12">26.12</ref>. <ref loc="LUK 18:11">Luc. 18.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:15">Ma chi ascolta consiglio <char style="add">è</char> savio.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16"/>Il cruccio dello stolto è conosciuto lo stesso giorno<note caller="*" style="x"><char style="xo" closed="false">12.16 </char><char style="xk" closed="false">giorno </char><char style="xt" closed="false"><ref loc="PRO 29:11">Prov. 29.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:16">Ma l'avveduto copre il vituperio.<verse eid="PRO 12:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17"/>Chi parla verità rapporta il giusto<note caller="*" style="x"><char style="xo" closed="false">12.17 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="PRO 14:5">Prov. 14.5</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:17">Ma il falso testimonio <char style="add">rapporta</char> frode.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18"/>Ei vi è tale che pronunzia <char style="add">parole</char> simile a coltellate;</para>
  <para style="q" vid="PRO 12:18">Ma la lingua de' savi <char style="add">è</char> medicina.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19"/>Il labbro verace sarà stabile in perpetuo;</para>
  <para style="q" vid="PRO 12:19">Ma la lingua bugiarda <char style="add">sarà sol</char> per un momento<note caller="*" style="x"><char style="xo" closed="false">12.19 </char><char style="xk" closed="false">momento </char><char style="xt" closed="false"><ref loc="PSA 52:4">Sal. 52.4</ref>,<ref loc="PSA 52:5">5</ref>. <ref loc="PRO 19:9">Prov. 19.9</ref>.</char></note>.<verse eid="PRO 12:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20"/>Inganno <char style="add">è</char> nel cuor di coloro che macchinano del male;</para>
  <para style="q" vid="PRO 12:20">Ma <char style="add">vi è</char> allegrezza per quelli che consigliano pace.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21"/>Niuna molestia avverrà al giusto<note caller="*" style="x"><char style="xo" closed="false">12.21 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="PSA 91:10">Sal. 91.10</ref> ecc.</char></note>;</para>
  <para style="q" vid="PRO 12:21">Ma gli empi saranno ripieni di male.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22"/>Le labbra bugiarde <char style="add">son</char> cosa abbominevole al Signore<note caller="*" style="x"><char style="xo" closed="false">12.22 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 6:16">Prov. 6.16</ref>,<ref loc="PRO 6:17">17</ref>. <ref loc="REV 22:15">Apoc. 22.15</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:22">Ma coloro che operano in verità son graditi da lui.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23"/>L'uomo avveduto copre la scienza;</para>
  <para style="q" vid="PRO 12:23">Ma il cuor degli stolti pubblica la follia<note caller="*" style="x"><char style="xo" closed="false">12.23 </char><char style="xk" closed="false">follia </char><char style="xt" closed="false"><ref loc="PRO 10:14">Prov. 10.14</ref>; <ref loc="PRO 13:16">13.16</ref>; <ref loc="PRO 15:2">15.2</ref>.</char></note>.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24"/>La mano de' diligenti signoreggerà;</para>
  <para style="q" vid="PRO 12:24">Ma la pigra sarà tributaria<note caller="*" style="x"><char style="xo" closed="false">12.24 </char><char style="xk" closed="false">tributaria </char><char style="xt" closed="false"><ref loc="PRO 10:4">Prov. 10.4</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25"/>Il cordoglio nel cuor dell'uomo l'abbatte<note caller="*" style="x"><char style="xo" closed="false">12.25 </char><char style="xk" closed="false">abbatte </char><char style="xt" closed="false"><ref loc="PRO 15:13">Prov. 15.13</ref>; <ref loc="PRO 17:22">17.22</ref>.</char></note>;</para>
  <para style="q" vid="PRO 12:25">Ma la buona parola lo rallegra<note caller="*" style="x"><char style="xo" closed="false">12.25 </char><char style="xk" closed="false">rallegra </char><char style="xt" closed="false"><ref loc="ISA 50:4">Is. 50.4</ref>.</char></note>.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26"/>Il giusto abbonda <char style="add">in beni</char> più che il suo prossimo;</para>
  <para style="q" vid="PRO 12:26">Ma la via degli empi li fa andare errando.<verse eid="PRO 12:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27"/>Il pigro non arrostisce la sua cacciagione;</para>
  <para style="q" vid="PRO 12:27">Ma i beni dell'uomo diligente <char style="add">sono</char> preziosi.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28"/>Nella via della giustizia <char style="add">vi è</char> vita;</para>
  <para style="q" vid="PRO 12:28">E <char style="add">nel</char> cammino de' <char style="add">suoi</char> sentieri non <char style="add">vi è</char> morte.<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1"/>Il figliuol savio <char style="add">ascolta</char> l'ammaestramento di suo padre;</para>
  <para style="q" vid="PRO 13:1">Ma lo schernitore non ascolta riprensione<note caller="*" style="x"><char style="xo" closed="false">13.1 </char><char style="xk" closed="false">riprensione </char><char style="xt" closed="false"><ref loc="1SA 2:25">1 Sam. 2.25</ref>.</char></note>.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2"/>L'uomo mangerà del bene del frutto delle sue labbra<note caller="*" style="x"><char style="xo" closed="false">13.2 </char><char style="xk" closed="false">labbra </char><char style="xt" closed="false"><ref loc="PRO 12:14">Prov. 12.14</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 13:2">Ma l'anima degli scellerati <char style="add">mangerà del frutto di</char> violenza.<verse eid="PRO 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3"/>Chi guarda la sua bocca preserva l'anima sua<note caller="*" style="x"><char style="xo" closed="false">13.3 </char><char style="xk" closed="false">sua </char><char style="xt" closed="false"><ref loc="PSA 39:1">Sal. 39.1</ref>; <ref loc="PSA 141:3">141.3</ref>. <ref loc="JAS 3:2">Giac. 3.2</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:3">
    <char style="add">Ma</char> ruina <char style="add">avverrà</char> a chi apre disordinatamente le sue labbra.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4"/>L'anima del pigro appetisce, e non <char style="add">ha</char> nulla;</para>
  <para style="q" vid="PRO 13:4">Ma l'anima de' diligenti sarà ingrassata<note caller="*" style="x"><char style="xo" closed="false">13.4 </char><char style="xk" closed="false">ingrassata </char><char style="xt" closed="false"><ref loc="PRO 10:4">Prov. 10.4</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5"/>Il giusto odia la parola bugiarda;</para>
  <para style="q" vid="PRO 13:5">Ma l'empio si rende puzzolente ed infame.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6"/>La giustizia guarda colui che <char style="add">è</char> intiero di via;</para>
  <para style="q" vid="PRO 13:6">Ma l'empietà sovverte il peccatore<note caller="*" style="x"><char style="xo" closed="false">13.6 </char><char style="xk" closed="false">peccatore </char><char style="xt" closed="false"><ref loc="PRO 11:3">Prov. 11.3</ref>,<ref loc="PRO 11:5">5</ref>,<ref loc="PRO 11:6">6</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7"/>Vi è tale che si fa ricco, e non <char style="add">ha</char> nulla;</para>
  <para style="q" vid="PRO 13:7">Tale <char style="add">altresì</char> che si fa povero, ed ha di gran facoltà.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8"/>Le ricchezze dell'uomo <char style="add">sono</char> il riscatto della sua vita;</para>
  <para style="q" vid="PRO 13:8">Ma il povero non ode alcuna minaccia.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9"/>La luce de' giusti sarà lieta;</para>
  <para style="q" vid="PRO 13:9">Ma la lampana degli empi sarà spenta<note caller="*" style="x"><char style="xo" closed="false">13.9 </char><char style="xk" closed="false">spenta </char><char style="xt" closed="false"><ref loc="JOB 18:5">Giob. 18.5</ref>,<ref loc="JOB 18:6">6</ref>.</char></note>.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10"/>Per orgoglio non si produce altro che contese;</para>
  <para style="q" vid="PRO 13:10">Ma la sapienza <char style="add">è</char> con quelli che si consigliano.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11"/>Le ricchezze <char style="add">procedenti</char> da vanità scemeranno<note caller="*" style="x"><char style="xo" closed="false">13.11 </char><char style="xk" closed="false">scemeranno </char><char style="xt" closed="false"><ref loc="PRO 20:21">Prov. 20.21</ref>; <ref loc="PRO 28:20">28.20</ref>,<ref loc="PRO 28:22">22</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:11">Ma chi raduna con la mano <char style="add">le</char> accrescerà.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12"/>La speranza prolungata fa languire il cuore;</para>
  <para style="q" vid="PRO 13:12">Ma il desiderio adempiuto <char style="add">è</char> un albero di vita<note caller="*" style="x"><char style="xo" closed="false">13.12 </char><char style="xk" closed="false">vita </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 19">19</ref>.</char></note>.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13"/>Chi sprezza la parola andrà in perdizione<note caller="*" style="x"><char style="xo" closed="false">13.13 </char><char style="xk" closed="false">perdizione </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 Cron. 36.16</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:13">Ma chi riverisce il comandamento riceverà retribuzione.<verse eid="PRO 13:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14"/>L'insegnamento di un savio <char style="add">è</char> una fonte di vita<note caller="*" style="x"><char style="xo" closed="false">13.14 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PRO 10:11">Prov. 10.11</ref>; <ref loc="PRO 16:22">16.22</ref>.</char></note>,</para>
  <para style="q" vid="PRO 13:14">Per ritrarsi da' lacci della morte.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15"/>Buon senno reca grazia;</para>
  <para style="q" vid="PRO 13:15">Ma il procedere de' perfidi <char style="add">è</char> duro.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16"/>L' <char style="add">uomo</char> avveduto fa ogni cosa con conoscimento;</para>
  <para style="q" vid="PRO 13:16">Ma il pazzo spande follia.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17"/>Il messo malvagio caderà in male;</para>
  <para style="q" vid="PRO 13:17">Ma l'ambasciator fedele reca sanità<note caller="*" style="x"><char style="xo" closed="false">13.17 </char><char style="xk" closed="false">sanità </char><char style="xt" closed="false"><ref loc="PRO 25:13">Prov. 25.13</ref>.</char></note>.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18"/>Povertà ed ignominia <char style="add">avverranno</char> a chi schifa la correzione;</para>
  <para style="q" vid="PRO 13:18">Ma chi osserva la riprensione sarà onorato<note caller="*" style="x"><char style="xo" closed="false">13.18 </char><char style="xk" closed="false">onorato </char><char style="xt" closed="false"><ref loc="PRO 15:5">Prov. 15.5</ref>,<ref loc="PRO 15:31">31</ref>,<ref loc="PRO 15:32">32</ref>.</char></note>.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19"/>Il desiderio adempiuto è cosa soave all'anima<note caller="*" style="x"><char style="xo" closed="false">13.19 </char><char style="xk" closed="false">anima </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 12">12</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:19">Ed agli stolti <char style="add">è</char> cosa abbominevole lo stornarsi dal male.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20"/>Chi va co' savi diventerà savio;</para>
  <para style="q" vid="PRO 13:20">Ma il compagno degli stolti diventerà malvagio.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21"/>Il male perseguita i peccatori<note caller="*" style="x"><char style="xo" closed="false">13.21 </char><char style="xk" closed="false">peccatori </char><char style="xt" closed="false"><ref loc="PSA 32:10">Sal. 32.10</ref>. <ref loc="PRO 11:19">Prov. 11.19</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:21">Ma <char style="add">Iddio</char> renderà il bene a' giusti.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22"/>L'uomo da bene lascerà la <char style="add">sua</char> eredità a' figliuoli de' figliuoli<note caller="*" style="x"><char style="xo" closed="false">13.22 </char><char style="xk" closed="false">figliuoli </char><char style="xt" closed="false"><ref loc="PSA 37:25">Sal. 37.25</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:22">Ma le facoltà del peccatore <char style="add">son</char> riserbate al giusto<note caller="*" style="x"><char style="xo" closed="false">13.22 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="JOB 27:13-17">Giob. 27.13-17</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23"/>Il campo lavorato de' poveri <char style="add">produce</char> abbondanza di cibo<note caller="*" style="x"><char style="xo" closed="false">13.23 </char><char style="xk" closed="false">cibo </char><char style="xt" closed="false"><ref loc="PRO 12:11">Prov. 12.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:23">Ma vi è tale che è consumato per mancamento di buon governo.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24"/>Chi risparmia la sua verga odia il suo figliuolo;</para>
  <para style="q" vid="PRO 13:24">Ma chi l'ama gli procura correzione per tempo<note caller="*" style="x"><char style="xo" closed="false">13.24 </char><char style="xk" closed="false">tempo </char><char style="xt" closed="false"><ref loc="PRO 19:18">Prov. 19.18</ref>; <ref loc="PRO 22:15">22.15</ref>; <ref loc="PRO 23:13">23.13</ref>,<ref loc="PRO 23:14">14</ref>; <ref loc="PRO 29:15">29.15</ref>,<ref loc="PRO 29:17">17</ref>.</char></note>.<verse eid="PRO 13:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25"/>Il giusto mangerà a sazietà dell'anima sua<note caller="*" style="x"><char style="xo" closed="false">13.25 </char><char style="xk" closed="false">sua </char><char style="xt" closed="false"><ref loc="PSA 34:10">Sal. 34.10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 13:25">Ma il ventre degli empi avrà mancamento.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1"/>Le donne savie edificano le lor case<note caller="*" style="x"><char style="xo" closed="false">14.1 </char><char style="xk" closed="false">case </char><char style="xt" closed="false"><ref loc="RUT 4:11">Rut 4.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:1">Ma la stolta la sovverte con le sue mani.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2"/>Chi cammina nella sua dirittura riverisce il Signore;</para>
  <para style="q" vid="PRO 14:2">Ma chi è stravolto nelle sue vie lo sprezza.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3"/>Nella bocca dello stolto <char style="add">è</char> la bacchetta dell'alterezza;</para>
  <para style="q" vid="PRO 14:3">Ma le labbra de' savi li guardano.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4"/>Dove non <char style="add">son</char> buoi, il granaio <char style="add">è</char> vuoto;</para>
  <para style="q" vid="PRO 14:4">Ma l'abbondanza della ricolta <char style="add">è</char> per la forza del bue.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5"/>Il testimonio verace non mente;</para>
  <para style="q" vid="PRO 14:5">Ma il falso testimonio sbocca bugie<note caller="*" style="x"><char style="xo" closed="false">14.5 </char><char style="xk" closed="false">bugie </char><char style="xt" closed="false"><ref loc="EXO 23:1">Esod. 23.1</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6"/>Lo schernitore cerca la sapienza, e non <char style="add">la trova</char> punto<note caller="*" style="x"><char style="xo" closed="false">14.6 </char><char style="xk" closed="false">punto </char><char style="xt" closed="false"><ref loc="PRO 24:7">Prov. 24.7</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:6">Ma la scienza agevolmente <char style="add">si acquista</char> dall'<char style="add">uomo</char> intendente.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7"/>Vattene via d'innanzi all'uomo stolto,</para>
  <para style="q" vid="PRO 14:7">E <char style="add">d'innanzi a colui, nel quale</char> non avrai conosciute labbra di scienza.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8"/>La sapienza dell'uomo <char style="add">è</char> di considerar la sua via;</para>
  <para style="q" vid="PRO 14:8">Ma la follia degli stolti <char style="add">è</char> inganno.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9"/>Gli stolti si fanno beffe del <char style="add">commetter</char> misfatto<note caller="*" style="x"><char style="xo" closed="false">14.9 </char><char style="xk" closed="false">misfatto </char><char style="xt" closed="false"><ref loc="PRO 10:23">Prov. 10.23</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 14:9">Ma fra gli <char style="add">uomini</char> diritti <char style="add">è</char> la benevolenza.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10"/>Il cuore di ciascuno conosce l'amaritudine dell'anima sua;</para>
  <para style="q" vid="PRO 14:10">Ed altresì alcuno strano non è mescolato nella sua allegrezza.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11"/>La casa degli empi sarà distrutta;</para>
  <para style="q" vid="PRO 14:11">Ma il tabernacolo degli <char style="add">uomini</char> diritti fiorirà.<verse eid="PRO 14:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12"/>Vi è tal via che pare diritta all'uomo<note caller="*" style="x"><char style="xo" closed="false">14.12 </char><char style="xk" closed="false">uomo </char><char style="xt" closed="false"><ref loc="PRO 12:15">Prov. 12.15</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 14:12">Il fine della quale <char style="add">son</char> le vie della morte<note caller="*" style="x"><char style="xo" closed="false">14.12 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="ROM 6:21">Rom. 6.21</ref>.</char></note>.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13"/>Come di <char style="add">troppo</char> ridere duole il cuore,</para>
  <para style="q" vid="PRO 14:13">Così la fine dell'allegrezza <char style="add">è</char> dolore<note caller="*" style="x"><char style="xo" closed="false">14.13 </char><char style="xk" closed="false">dolore </char><char style="xt" closed="false"><ref loc="ECC 2:2">Eccl. 2.2</ref>; <ref loc="ECC 7:3">7.3</ref>.</char></note>.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14"/>Chi è sviato di cuore sarà saziato delle sue vie<note caller="*" style="x"><char style="xo" closed="false">14.14 </char><char style="xk" closed="false">vie </char><char style="xt" closed="false"><ref loc="PRO 1:31">Prov. 1.31</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:14">E più ch'esso <char style="add">lo sarà</char> l'uomo da bene delle sue.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15"/>Lo scempio crede ogni cosa;</para>
  <para style="q" vid="PRO 14:15">Ma l'avveduto considera i suoi passi.<verse eid="PRO 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16"/>Il savio teme<note caller="*" style="x"><char style="xo" closed="false">14.16 </char><char style="xk" closed="false">teme </char><char style="xt" closed="false"><ref loc="PRO 22:3">Prov. 22.3</ref>; <ref loc="PRO 27:12">27.12</ref>.</char></note>, e si ritrae dal male<note caller="*" style="x"><char style="xo" closed="false">14.16 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="JOB 28:28">Giob. 28.28</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 14:16">Ma lo stolto trascorre, e si tien sicuro.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17"/>Chi è pronto all'ira<note caller="*" style="x"><char style="xo" closed="false">14.17 </char><char style="xk" closed="false">ira </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 29">29</ref> </char><char style="xta" closed="false">e rif.</char></note> commette follia;</para>
  <para style="q" vid="PRO 14:17">E l'uomo malizioso è odiato.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18"/>Gli scempi erederanno la stoltizia;</para>
  <para style="q" vid="PRO 14:18">Ma i prudenti coroneranno <char style="add">il lor capo</char> di scienza.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19"/>I malvagi saranno abbassati davanti a' buoni;</para>
  <para style="q" vid="PRO 14:19">E gli empi <char style="add">saranno</char> alle porte del giusto.<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20"/>Il povero è odiato eziandio dal suo prossimo<note caller="*" style="x"><char style="xo" closed="false">14.20 </char><char style="xk" closed="false">prossimo </char><char style="xt" closed="false"><ref loc="PRO 19:7">Prov. 19.7</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:20">Ma molti son gli amici del ricco.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21"/>Chi sprezza il suo prossimo pecca<note caller="*" style="x"><char style="xo" closed="false">14.21 </char><char style="xk" closed="false">precca </char><char style="xt" closed="false"><ref loc="PRO 11:12">Prov. 11.12</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:21">Ma beato chi ha pietà de' poveri<note caller="*" style="x"><char style="xo" closed="false">14.21 </char><char style="xk" closed="false">poveri </char><char style="xt" closed="false"><ref loc="PSA 41:1">Sal. 41.1</ref>; <ref loc="PSA 112:9">112.9</ref>.</char></note>.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22"/>Quelli che macchinano del male non sono eglino traviati?</para>
  <para style="q" vid="PRO 14:22">Ma benignità e verità <char style="add">sarà usata inverso</char> coloro che pensano del bene.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23"/>In ogni fatica vi è del profitto;</para>
  <para style="q" vid="PRO 14:23">Ma il parlar delle labbra <char style="add">torna</char> solo in inopia.<verse eid="PRO 14:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24"/>Le ricchezze de' savi <char style="add">sono</char> la lor corona;</para>
  <para style="q" vid="PRO 14:24">
    <char style="add">Ma</char> la follia degli stolti <char style="add">è sempre</char> follia.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25"/>Il testimonio verace libera le anime;</para>
  <para style="q" vid="PRO 14:25">Ma il falso sbocca bugie<note caller="*" style="x"><char style="xo" closed="false">14.25 </char><char style="xk" closed="false">bugie </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 5">5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26"/>Nel timor del Signore vi è confidanza fortissima;</para>
  <para style="q" vid="PRO 14:26">E vi sarà un ricetto per li figliuoli di colui <char style="add">che teme Iddio</char>.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27"/>Il timor del Signore <char style="add">è</char> una fonte di vita,</para>
  <para style="q" vid="PRO 14:27">Per ritrarsi da' lacci della morte.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28"/>La magnificenza del re <char style="add">è</char> nella moltitudine del popolo<note caller="*" style="x"><char style="xo" closed="false">14.28 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="1KI 4:20">1 Re. 4.20</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:28">Ma la ruina del principe <char style="add">è</char> nel mancamento della gente.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29"/>Chi è lento all'ira <char style="add">è</char> di gran prudenza<note caller="*" style="x"><char style="xo" closed="false">14.29 </char><char style="xk" closed="false">prudenza </char><char style="xt" closed="false"><ref loc="PRO 16:32">Prov. 16.32</ref>. <ref loc="JAS 1:19">Giac. 1.19</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:29">Ma chi è pronto al cruccio eccita la follia.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30"/>Il cuor sano <char style="add">è</char> la vita delle carni;</para>
  <para style="q" vid="PRO 14:30">Ma l'invidia <char style="add">è</char> il tarlo delle ossa.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31"/>Chi oppressa il povero<note caller="*" style="x"><char style="xo" closed="false">14.31 </char><char style="xk" closed="false">povero </char><char style="xt" closed="false"><ref loc="PRO 17:5">Prov. 17.5</ref>. <ref loc="MAT 25:40">Mat. 25.40</ref> ecc.</char></note> fa onta a colui che l'ha fatto<note caller="*" style="x"><char style="xo" closed="false">14.31 </char><char style="xk" closed="false">fatto </char><char style="xt" closed="false"><ref loc="JOB 31:15">Giob. 31.15</ref>,<ref loc="JOB 31:16">16</ref>. <ref loc="PRO 22:2">Prov. 22.2</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:31">Ma chi ha pietà del bisognoso l'onora.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32"/>L'empio sarà traboccato per la sua malvagità;</para>
  <para style="q" vid="PRO 14:32">Ma il giusto spera <char style="add">eziandio</char> nella sua morte<note caller="*" style="x"><char style="xo" closed="false">14.32 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="JOB 19:25">Giob. 19.25</ref>,<ref loc="JOB 19:26">26</ref>. <ref loc="PSA 23:4">Sal. 23.4</ref>. <ref loc="2CO 5:8">2 Cor. 5.8</ref>. <ref loc="2TI 4:18">2 Tim. 4.18</ref>.</char></note>.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33"/>La sapienza riposa nel cuore dell'<char style="add">uomo</char> intendente,</para>
  <para style="q" vid="PRO 14:33">Ed è riconosciuta in mezzo degli stolti.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34"/>La giustizia innalza la nazione;</para>
  <para style="q" vid="PRO 14:34">Ma il peccato <char style="add">è</char> il vituperio de' popoli.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35"/>Il favor del re <char style="add">è</char> verso il servitore intendente<note caller="*" style="x"><char style="xo" closed="false">14.35 </char><char style="xk" closed="false">intendente </char><char style="xt" closed="false"><ref loc="MAT 24:45-47">Mat. 24.45-47</ref>.</char></note>;</para>
  <para style="q" vid="PRO 14:35">Ma la sua indegnazione <char style="add">è</char> contro a quello che reca vituperio.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1"/>La risposta dolce acqueta il cruccio<note caller="*" style="x"><char style="xo" closed="false">15.1 </char><char style="xk" closed="false">cruccio </char><char style="xt" closed="false"><ref loc="JDG 8:1">Giud. 8.1</ref> ecc. <ref loc="PRO 25:15">Prov. 25.15</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:1">Ma la parola molesta fa montar l'ira<note caller="*" style="x"><char style="xo" closed="false">15.1 </char><char style="xk" closed="false">ira </char><char style="xt" closed="false"><ref loc="1SA 25:10">1 Sam. 25.10</ref> ecc. <ref loc="1KI 12:13">1 Re. 12.13</ref> ecc.</char></note>.<verse eid="PRO 15:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2"/>La scienza adorna la lingua de' savi;</para>
  <para style="q" vid="PRO 15:2">Ma la bocca degli stolti sgorga follia.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3"/>Gli occhi del Signore <char style="add">sono</char> in ogni luogo;</para>
  <para style="q" vid="PRO 15:3">Riguardando i malvagi ed i buoni<note caller="*" style="x"><char style="xo" closed="false">15.3 </char><char style="xk" closed="false">buoni </char><char style="xt" closed="false"><ref loc="2CH 16:9">2 Cron. 16.9</ref> e rif. <ref loc="HEB 4:13">Ebr. 4.13</ref>.</char></note>.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4"/>La medicina della lingua <char style="add">è</char> un albero di vita;</para>
  <para style="q" vid="PRO 15:4">Ma la sovversione <char style="add">che avviene</char> per essa <char style="add">è simile ad</char> un fracasso <char style="add">fatto</char> dal vento.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5"/>Lo stolto disdegna la correzion di suo padre;</para>
  <para style="q" vid="PRO 15:5">Ma chi osserva la riprensione diventerà avveduto<note caller="*" style="x"><char style="xo" closed="false">15.5 </char><char style="xk" closed="false">avveduto </char><char style="xt" closed="false"><ref loc="PRO 13:18">Prov. 13.18</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6"/>Nella casa del giusto <char style="add">vi sono</char> di gran facoltà;</para>
  <para style="q" vid="PRO 15:6">Ma <char style="add">vi è</char> dissipazione nell'entrate dell'empio.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7"/>Le labbra de' savi spandono scienza;</para>
  <para style="q" vid="PRO 15:7">Ma non <char style="add">fa già</char> così il cuor degli stolti<note caller="*" style="x"><char style="xo" closed="false">15.7 </char><char style="xk" closed="false">stolti </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat. 12.34</ref>.</char></note>.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8"/>Il sacrificio degli empi <char style="add">è</char> cosa abbominevole al Signore<note caller="*" style="x"><char style="xo" closed="false">15.8 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 21:27">Prov. 21.27</ref>; <ref loc="PRO 28:9">28.9</ref>. <ref loc="ISA 1:11">Is. 1.11</ref>,<ref loc="ISA 1:15">15</ref>; <ref loc="ISA 61:8">61.8</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:8">Ma l'orazione degli <char style="add">uomini</char> diritti gli <char style="add">è</char> cosa grata.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9"/>La via dell'empio <char style="add">è</char> cosa abbominevole al Signore;</para>
  <para style="q" vid="PRO 15:9">Ma egli ama chi procaccia giustizia<note caller="*" style="x"><char style="xo" closed="false">15.9 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PRO 21:21">Prov. 21.21</ref>. <ref loc="1TI 6:11">1 Tim. 6.11</ref>.</char></note>.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10"/>La correzione <char style="add">è</char> spiacevole a chi lascia la <char style="add">diritta</char> via<note caller="*" style="x"><char style="xo" closed="false">15.10 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="1KI 22:8">1 Re. 22.8</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:10">Chi odia la riprensione morrà<note caller="*" style="x"><char style="xo" closed="false">15.10 </char><char style="xk" closed="false">morrà </char><char style="xt" closed="false"><ref loc="PRO 5:12">Prov. 5.12</ref>; <ref loc="PRO 10:17">10.17</ref>.</char></note>.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11"/>L'inferno e il luogo della perdizione <char style="add">son</char> davanti al Signore<note caller="*" style="x"><char style="xo" closed="false">15.11 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="JOB 26:6">Giob. 26.6</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 15:11">Quanto più i cuori de' figliuoli degli uomini<note caller="*" style="x"><char style="xo" closed="false">15.11 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="2CH 6:30">2 Cron. 6.30</ref> </char><char style="xta" closed="false">e rif.</char></note>!<verse eid="PRO 15:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12"/>Lo schernitore non ama che altri lo riprenda,</para>
  <para style="q" vid="PRO 15:12">
    <char style="add">E</char> non va a' savi<note caller="*" style="x"><char style="xo" closed="false">15.12 </char><char style="xk" closed="false">savi </char><char style="xt" closed="false"><ref loc="2TI 4:3">2 Tim. 4.3</ref>.</char></note>.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13"/>Il cuore allegro abbellisce la faccia;</para>
  <para style="q" vid="PRO 15:13">Ma per lo cordoglio lo spirito è abbattuto<note caller="*" style="x"><char style="xo" closed="false">15.13 </char><char style="xk" closed="false">abbattuto </char><char style="xt" closed="false"><ref loc="PRO 17:22">Prov. 17.22</ref>.</char></note>.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14"/>Il cuor dell'<char style="add">uomo</char> intendente cerca la scienza;</para>
  <para style="q" vid="PRO 15:14">Ma la bocca degli stolti si pasce di follia.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15"/>Tutti i giorni dell'afflitto <char style="add">son</char> cattivi;</para>
  <para style="q" vid="PRO 15:15">Ma chi è allegro di cuore <char style="add">è come in</char> un convito perpetuo.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16"/>Meglio <char style="add">vale</char> poco col timor del Signore,</para>
  <para style="q" vid="PRO 15:16">Che gran tesoro con turbamento<note caller="*" style="x"><char style="xo" closed="false">15.16 </char><char style="xk" closed="false">turbamento </char><char style="xt" closed="false"><ref loc="PSA 37:16">Sal. 37.16</ref>. <ref loc="PRO 16:8">Prov. 16.8</ref>. <ref loc="ECC 4:6">Eccl. 4.6</ref>. <ref loc="1TI 6:6">1 Tim. 6.6</ref>.</char></note>.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17"/>Meglio <char style="add">vale</char> un pasto d'erbe, ove <char style="add">sia</char> amore,</para>
  <para style="q" vid="PRO 15:17">Che di bue ingrassato, ove <char style="add">sia</char> odio<note caller="*" style="x"><char style="xo" closed="false">15.17 </char><char style="xk" closed="false">odio </char><char style="xt" closed="false"><ref loc="PRO 17:1">Prov. 17.1</ref>.</char></note>.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18"/>L'uomo iracondo muove contese<note caller="*" style="x"><char style="xo" closed="false">15.18 </char><char style="xk" closed="false">contese </char><char style="xt" closed="false"><ref loc="PRO 26:21">Prov. 26.21</ref>; <ref loc="PRO 29:22">29.22</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:18">Ma chi è lento all'ira acqueta le risse.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19"/>La via del pigro <char style="add">è</char> come una siepe di spine;</para>
  <para style="q" vid="PRO 15:19">Ma la via degli <char style="add">uomini</char> diritti <char style="add">è</char> elevata.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20"/>Il figliuol savio rallegra il padre<note caller="*" style="x"><char style="xo" closed="false">15.20 </char><char style="xk" closed="false">padre </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 15:20">Ma l'uomo stolto sprezza sua madre.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21"/>La follia <char style="add">è</char> allegrezza al<char style="add">l'uomo</char> scemo di senno<note caller="*" style="x"><char style="xo" closed="false">15.21 </char><char style="xk" closed="false">senno </char><char style="xt" closed="false"><ref loc="PRO 10:23">Prov. 10.23</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:21">Ma l'uomo intendente cammina dirittamente<note caller="*" style="x"><char style="xo" closed="false">15.21 </char><char style="xk" closed="false">dirittamente </char><char style="xt" closed="false"><ref loc="EPH 5:15">Efes. 5.15</ref>.</char></note>.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22"/>I disegni son renduti vani dove non <char style="add">è</char> consiglio<note caller="*" style="x"><char style="xo" closed="false">15.22 </char><char style="xk" closed="false">consiglio </char><char style="xt" closed="false"><ref loc="PRO 11:14">Prov. 11.14</ref>; <ref loc="PRO 20:18">20.18</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:22">Ma sono stabili dove <char style="add">è</char> moltitudine di consiglieri.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23"/>L'uomo riceve allegrezza della risposta della sua bocca;</para>
  <para style="q" vid="PRO 15:23">E quant'<char style="add">è</char> buona una parola <char style="add">detta</char> al suo tempo<note caller="*" style="x"><char style="xo" closed="false">15.23 </char><char style="xk" closed="false">tempo </char><char style="xt" closed="false"><ref loc="PRO 25:11">Prov. 25.11</ref>. <ref loc="ISA 50:4">Is. 50.4</ref>.</char></note>!<verse eid="PRO 15:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24"/>La via della vita <char style="add">va</char> in su all'uomo intendente<note caller="*" style="x"><char style="xo" closed="false">15.24 </char><char style="xk" closed="false">intendente </char><char style="xt" closed="false"><ref loc="PHP 3:20">Fil. 3.20</ref>. <ref loc="COL 3:1">Col. 3.1</ref>,<ref loc="COL 3:2">2</ref>.</char></note>,</para>
  <para style="q" vid="PRO 15:24">Per ritrarsi dall'inferno <char style="add">che è</char> a basso.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25"/>Il Signore spianta la casa de' superbi<note caller="*" style="x"><char style="xo" closed="false">15.25 </char><char style="xk" closed="false">superbi </char><char style="xt" closed="false"><ref loc="PRO 12:7">Prov. 12.7</ref>; <ref loc="PRO 14:11">14.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:25">Ma stabilisce il confine della vedova<note caller="*" style="x"><char style="xo" closed="false">15.25 </char><char style="xk" closed="false">vedova </char><char style="xt" closed="false"><ref loc="PSA 68:5">Sal. 68.5</ref>; <ref loc="PSA 146:9">146.9</ref>.</char></note>.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26"/>I pensieri malvagi <char style="add">son</char> cosa abbominevole al Signore<note caller="*" style="x"><char style="xo" closed="false">15.26 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 6:16-18">Prov. 6.16-18</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:26">Ma i detti <char style="add">che gli son</char> piacevoli <char style="add">sono</char> i puri.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27"/>Chi è dato a cupidigia dissipa la sua casa<note caller="*" style="x"><char style="xo" closed="false">15.27 </char><char style="xk" closed="false">casa </char><char style="xt" closed="false"><ref loc="ISA 5:8">Is. 5.8</ref>. <ref loc="JER 17:11">Ger. 17.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:27">Ma chi odia i presenti viverà.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28"/>Il cuor del giusto medita <char style="add">ciò che ha</char> da rispondere<note caller="*" style="x"><char style="xo" closed="false">15.28 </char><char style="xk" closed="false">rispondere </char><char style="xt" closed="false"><ref loc="1PE 3:15">1 Piet. 3.15</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:28">Ma la bocca degli empi sgorga cose malvage.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29"/>Il Signore <char style="add">è</char> lontano dagli empi<note caller="*" style="x"><char style="xo" closed="false">15.29 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="PSA 34:16">Sal. 34.16</ref>.</char></note>;</para>
  <para style="q" vid="PRO 15:29">Ma egli esaudisce l'orazione de' giusti<note caller="*" style="x"><char style="xo" closed="false">15.29 </char><char style="xk" closed="false">giusti </char><char style="xt" closed="false"><ref loc="PSA 145:18">Sal. 145.18</ref>,<ref loc="PSA 145:19">19</ref>. <ref loc="JHN 9:31">Giov. 9.31</ref>.</char></note>.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30"/>La luce degli occhi rallegra il cuore;</para>
  <para style="q" vid="PRO 15:30">La buona novella ingrassa le ossa<note caller="*" style="x"><char style="xo" closed="false">15.30 </char><char style="xk" closed="false">ossa </char><char style="xt" closed="false"><ref loc="PRO 25:25">Prov. 25.25</ref>.</char></note>.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31"/>L'orecchio che ascolta la riprensione della vita</para>
  <para style="q" vid="PRO 15:31">Dimorerà per mezzo i savi<note caller="*" style="x"><char style="xo" closed="false">15.31 </char><char style="xk" closed="false">savi </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 5">5</ref>. <ref loc="PRO 25:12">Prov. 25.12</ref>.</char></note>.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32"/>Chi schifa la correzione disdegna l'anima sua;</para>
  <para style="q" vid="PRO 15:32">Ma chi ascolta la riprensione acquista senno.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33"/>Il timor del Signore <char style="add">è</char> ammaestramento di sapienza<note caller="*" style="x"><char style="xo" closed="false">15.33 </char><char style="xk" closed="false">sapienza </char><char style="xt" closed="false"><ref loc="PRO 1:7">Prov. 1.7</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 15:33">E l'umiltà <char style="add">va</char> davanti alla gloria<note caller="*" style="x"><char style="xo" closed="false">15.33 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="PRO 18:12">Prov. 18.12</ref>; <ref loc="PRO 29:23">29.23</ref>.</char></note>.<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1"/>Le disposizioni dell'animo <char style="add">son</char> dell'uomo<note caller="*" style="x"><char style="xo" closed="false">16.1 </char><char style="xk" closed="false">uomo </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 9">9</ref>. <ref loc="PRO 19:21">Prov. 19.21</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:1">Ma la risposta della lingua <char style="add">è</char> dal Signore<note caller="*" style="x"><char style="xo" closed="false">16.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="MAT 10:19">Mat. 10.19</ref>,<ref loc="MAT 10:20">20</ref>.</char></note>.<verse eid="PRO 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2"/>Tutte le vie dell'uomo gli paiono pure<note caller="*" style="x"><char style="xo" closed="false">16.2 </char><char style="xk" closed="false">pure </char><char style="xt" closed="false"><ref loc="PRO 12:15">Prov. 12.15</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 16:2">Ma il Signore pesa gli spiriti<note caller="*" style="x"><char style="xo" closed="false">16.2 </char><char style="xk" closed="false">spiriti </char><char style="xt" closed="false"><ref loc="1SA 16:7">1 Sam. 16.7</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3"/>Rimetti le tue opere nel Signore<note caller="*" style="x"><char style="xo" closed="false">16.3 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 37:5">Sal. 37.5</ref> e rif. <ref loc="LUK 12:22">Luc. 12.22</ref> ecc. <ref loc="PHP 4:6">Fil. 4.6</ref>.</char></note>,</para>
  <para style="q" vid="PRO 16:3">E i tuoi pensieri saranno stabiliti.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4"/>Il Signore ha fatto ogni cosa per sè stesso<note caller="*" style="x"><char style="xo" closed="false">16.4 </char><char style="xk" closed="false">stesso </char><char style="xt" closed="false"><ref loc="ISA 43:7">Is. 43.7</ref>. <ref loc="ROM 11:36">Rom. 11.36</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:4">Eziandio l'empio per lo giorno del male<note caller="*" style="x"><char style="xo" closed="false">16.4 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="ROM 9:22">Rom. 9.22</ref>.</char></note>.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5"/>Chiunque è altiero d'animo <char style="add">è</char> abbominevole al Signore<note caller="*" style="x"><char style="xo" closed="false">16.5 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 6:16">Prov. 6.16</ref>,<ref loc="PRO 6:17">17</ref> e rif.; <ref loc="PRO 8:13">8.13</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:5">D'ora in ora egli non resterà impunito<note caller="*" style="x"><char style="xo" closed="false">16.5 </char><char style="xk" closed="false">impunito </char><char style="xt" closed="false"><ref loc="PRO 11:21">Prov. 11.21</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6"/>L'iniquità sarà purgata con benignità, e <char style="add">con</char> verità<note caller="*" style="x"><char style="xo" closed="false">16.6 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="DAN 4:27">Dan. 4.27</ref>. <ref loc="LUK 11:41">Luc. 11.41</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:6">E per lo timor del Signore l'uomo si ritrae dal male<note caller="*" style="x"><char style="xo" closed="false">16.6 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="JOB 28:28">Giob. 28.28</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7"/>Quando il Signore gradisce le vie dell'uomo,</para>
  <para style="q" vid="PRO 16:7">Pacifica con lui eziandio i suoi nemici.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8"/>Meglio <char style="add">vale</char> poco con giustizia,</para>
  <para style="q" vid="PRO 16:8">Che grandi entrate senza dirittura<note caller="*" style="x"><char style="xo" closed="false">16.8 </char><char style="xk" closed="false">dirittura </char><char style="xt" closed="false"><ref loc="PRO 15:16">Prov. 15.16</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9"/>Il cuor dell'uomo delibera della sua via<note caller="*" style="x"><char style="xo" closed="false">16.9 </char><char style="xk" closed="false">via </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 1">1</ref>. <ref loc="PRO 19:21">Prov. 19.21</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:9">Ma il Signore dirizza i suoi passi<note caller="*" style="x"><char style="xo" closed="false">16.9 </char><char style="xk" closed="false">passi </char><char style="xt" closed="false"><ref loc="PSA 37:23">Sal. 37.23</ref>,<ref loc="PSA 37:24">24</ref>. <ref loc="PRO 20:24">Prov. 20.24</ref>. <ref loc="JER 10:23">Ger. 10.23</ref>.</char></note>.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10"/>Indovinamento <char style="add">è</char> nelle labbra del re;</para>
  <para style="q" vid="PRO 16:10">La sua bocca non falla nel giudicio<note caller="*" style="x"><char style="xo" closed="false">16.10 </char><char style="xk" closed="false">giudicio </char><char style="xt" closed="false"><ref loc="1KI 3:28">1 Re. 3.28</ref>.</char></note>.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11"/>La stadera, e le bilance giuste <char style="add">son</char> del Signore<note caller="*" style="x"><char style="xo" closed="false">16.11 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 11:1">Prov. 11.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 16:11">Tutti i pesi del sacchetto <char style="add">son</char> sua opera.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12"/>Operare empiamente <char style="add">è</char> abbominevole ai re;</para>
  <para style="q" vid="PRO 16:12">Perciocchè il trono sarà stabilito per giustizia<note caller="*" style="x"><char style="xo" closed="false">16.12 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PRO 25:5">Prov. 25.5</ref>; <ref loc="PRO 29:14">29.14</ref>.</char></note>.<verse eid="PRO 16:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13"/>Le labbra giuste <char style="add">son</char> quelle che i re gradiscono;</para>
  <para style="q" vid="PRO 16:13">Ed essi amano chi parla dirittamente.<verse eid="PRO 16:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14"/>L'ira del re <char style="add">son</char> messi di morte<note caller="*" style="x"><char style="xo" closed="false">16.14 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="PRO 19:12">Prov. 19.12</ref>; <ref loc="PRO 20:2">20.2</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:14">Ma l'uomo savio la placherà<note caller="*" style="x"><char style="xo" closed="false">16.14 </char><char style="xk" closed="false">placherà </char><char style="xt" closed="false"><ref loc="PRO 25:15">Prov. 25.15</ref>.</char></note>.<verse eid="PRO 16:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15"/>Nella chiarezza della faccia del re <char style="add">vi è</char> vita;</para>
  <para style="q" vid="PRO 16:15">E la sua benevolenza <char style="add">è</char> come la nuvola della pioggia della stagione della ricolta.<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16"/>Quant'<char style="add">è</char> egli cosa migliore acquistar sapienza che oro!</para>
  <para style="q" vid="PRO 16:16">E <char style="add">quant'è</char> egli cosa più eccellente acquistar prudenza che argento<note caller="*" style="x"><char style="xo" closed="false">16.16 </char><char style="xk" closed="false">argento </char><char style="xt" closed="false"><ref loc="PRO 8:11">Prov. 8.11</ref>,<ref loc="PRO 8:19">19</ref> </char><char style="xta" closed="false">e rif.</char></note>!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17"/>La strada degli <char style="add">uomini</char> diritti <char style="add">è</char> di stornarsi dal male;</para>
  <para style="q" vid="PRO 16:17">Chi osserva la sua via guarda l'anima sua.<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18"/>La superbia <char style="add">viene</char> davanti alla ruina<note caller="*" style="x"><char style="xo" closed="false">16.18 </char><char style="xk" closed="false">ruina </char><char style="xt" closed="false"><ref loc="PRO 11:2">Prov. 11.2</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 16:18">E l'alterezza dello spirito davanti alla caduta.<verse eid="PRO 16:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19"/>Meglio <char style="add">è</char> essere umile di spirito co' mansueti<note caller="*" style="x"><char style="xo" closed="false">16.19 </char><char style="xk" closed="false">mansueti </char><char style="xt" closed="false"><ref loc="PSA 34:18">Sal. 34.18</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 16:19">Che spartir le spoglie con gli altieri.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20"/>Chi è intendente nella parola troverà bene;</para>
  <para style="q" vid="PRO 16:20">E beato chi si confida nel Signore<note caller="*" style="x"><char style="xo" closed="false">16.20 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21"/>Il savio di cuore sarà chiamato intendente;</para>
  <para style="q" vid="PRO 16:21">E la dolcezza delle labbra aggiugnerà dottrina.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22"/>Il senno <char style="add">è</char> una fonte di vita in coloro che ne son dotati;</para>
  <para style="q" vid="PRO 16:22">Ma l'ammaestramento degli stolti <char style="add">è</char> stoltizia.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23"/>Il cuor del<char style="add">l'uomo</char> savio rende avveduta la sua bocca<note caller="*" style="x"><char style="xo" closed="false">16.23 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="PSA 37:30">Sal. 37.30</ref>. <ref loc="MAT 12:34">Mat. 12.34</ref>,<ref loc="MAT 12:35">35</ref>.</char></note>,</para>
  <para style="q" vid="PRO 16:23">E aggiunge dottrina alle sue labbra.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24"/>I detti soavi <char style="add">sono</char> un favo di miele,</para>
  <para style="q" vid="PRO 16:24">Dolcezza all'anima, e medicina alle ossa.<verse eid="PRO 16:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25"/>Vi è tal via che pare diritta all'uomo,</para>
  <para style="q" vid="PRO 16:25">Il fine della quale <char style="add">son</char> le vie della morte<note caller="*" style="x"><char style="xo" closed="false">16.25 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="PRO 14:12">Prov. 14.12</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26"/>L'anima di chi si affatica si affatica per lui stesso;</para>
  <para style="q" vid="PRO 16:26">Perciocchè la sua bocca lo preme<note caller="*" style="x"><char style="xo" closed="false">16.26 </char><char style="xk" closed="false">preme </char><char style="xt" closed="false"><ref loc="ECC 6:7">Eccl. 6.7</ref>.</char></note>.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27"/>L'uomo scellerato apparecchia del male;</para>
  <para style="q" vid="PRO 16:27">E in su le sue labbra <char style="add">vi è</char> come un fuoco ardente<note caller="*" style="x"><char style="xo" closed="false">16.27 </char><char style="xk" closed="false">ardente </char><char style="xt" closed="false"><ref loc="JAS 3:6">Giac. 3.6</ref>.</char></note>.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28"/>L'uomo perverso commette contese<note caller="*" style="x"><char style="xo" closed="false">16.28 </char><char style="xk" closed="false">contese </char><char style="xt" closed="false"><ref loc="PRO 6:14">Prov. 6.14</ref>; <ref loc="PRO 20:21">20.21</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:28">E chi va sparlando disunisce gli amici<note caller="*" style="x"><char style="xo" closed="false">16.28 </char><char style="xk" closed="false">amici </char><char style="xt" closed="false"><ref loc="PRO 17:9">Prov. 17.9</ref>.</char></note>.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29"/>L'uomo violento seduce il suo compagno<note caller="*" style="x"><char style="xo" closed="false">16.29 </char><char style="xk" closed="false">compagno </char><char style="xt" closed="false"><ref loc="PRO 1:10">Prov. 1.10</ref>. </char><char style="xta" closed="false">ecc.</char></note>,</para>
  <para style="q" vid="PRO 16:29">E lo conduce per una via <char style="add">che</char> non <char style="add">è</char> buona.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30"/>Chi chiude gli occhi macchinando perversità,</para>
  <para style="q" vid="PRO 16:30">Dimena le labbra <char style="add">quando</char> ha compiuto il male.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31"/>La canutezza <char style="add">è</char> una corona gloriosa<note caller="*" style="x"><char style="xo" closed="false">16.31 </char><char style="xk" closed="false">gloriosa </char><char style="xt" closed="false"><ref loc="PRO 20:29">Prov. 20.29</ref>.</char></note>;</para>
  <para style="q" vid="PRO 16:31">Ella si troverà nella via della giustizia.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32"/>Meglio vale chi è lento all'ira, che il forte;</para>
  <para style="q" vid="PRO 16:32">E <char style="add">meglio vale</char> chi signoreggia il suo cruccio, che un prenditor di città<note caller="*" style="x"><char style="xo" closed="false">16.32 </char><char style="xk" closed="false">città </char><char style="xt" closed="false"><ref loc="PRO 14:29">Prov. 14.29</ref> e rif.; <ref loc="PRO 19:11">19.11</ref>.</char></note>.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33"/>La sorte è gittata nel grembo;</para>
  <para style="q" vid="PRO 16:33">Ma dal Signore <char style="add">procede</char> tutto il giudicio di essa.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1"/>Migliore <char style="add">è</char> un boccon di <char style="add">pane</char> secco, con quiete,</para>
  <para style="q" vid="PRO 17:1">Che una casa piena di animali ammazzati, con rissa<note caller="*" style="x"><char style="xo" closed="false">17.1 </char><char style="xk" closed="false">rissa </char><char style="xt" closed="false"><ref loc="PRO 15:17">Prov. 15.17</ref>.</char></note>.<verse eid="PRO 17:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2"/>Il servitore intendente signoreggerà sopra il figliuolo che reca vituperio,</para>
  <para style="q" vid="PRO 17:2">E spartirà l'eredità tra i fratelli.<verse eid="PRO 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3"/>La coppella <char style="add">è</char> per l'argento, e il fornello per l'oro;</para>
  <para style="q" vid="PRO 17:3">Ma il Signore prova i cuori<note caller="*" style="x"><char style="xo" closed="false">17.3 </char><char style="xk" closed="false">cuori </char><char style="xt" closed="false"><ref loc="PSA 26:2">Sal. 26.2</ref> e rif. <ref loc="JER 17:10">Ger. 17.10</ref>.</char></note>.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4"/>L'uomo maligno presta gli orecchi alle labbra inique;</para>
  <para style="q" vid="PRO 17:4">E l'ingannatore ascolta la lingua maliziosa.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5"/>Chi beffa il povero fa onta a colui che l'ha fatto<note caller="*" style="x"><char style="xo" closed="false">17.5 </char><char style="xk" closed="false">fatto </char><char style="xt" closed="false"><ref loc="PRO 14:31">Prov. 14.31</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 17:5">Chi si rallegra della calamità <char style="add">altrui</char> non resterà impunito<note caller="*" style="x"><char style="xo" closed="false">17.5 </char><char style="xk" closed="false">impunito </char><char style="xt" closed="false"><ref loc="PRO 24:17">Prov. 24.17</ref>.</char></note>.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6"/>I figliuoli de' figliuoli <char style="add">son</char> la corona de' vecchi<note caller="*" style="x"><char style="xo" closed="false">17.6 </char><char style="xk" closed="false">vecchi </char><char style="xt" closed="false"><ref loc="PSA 127:3">Sal. 127.3</ref>,<ref loc="PSA 127:4">4</ref>; <ref loc="PSA 128:3">128.3</ref>.</char></note>;</para>
  <para style="q" vid="PRO 17:6">E i padri <char style="add">son</char> la gloria de' figliuoli.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7"/>Il parlar magnifico non è decevole all'uomo da nulla;</para>
  <para style="q" vid="PRO 17:7">Quanto meno al principe il labbro falso!<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8"/>Il presente <char style="add">è</char>, appo chi è dato a ricever presenti, una gioia graziosa<note caller="*" style="x"><char style="xo" closed="false">17.8 </char><char style="xk" closed="false">graziosa </char><char style="xt" closed="false"><ref loc="PRO 18:16">Prov. 18.16</ref>; <ref loc="PRO 19:6">19.6</ref>; <ref loc="PRO 21:14">21.14</ref>.</char></note>;</para>
  <para style="q" vid="PRO 17:8">Dovunque si volge produce effetto.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9"/>Chi copre il fallo procaccia amicizia<note caller="*" style="x"><char style="xo" closed="false">17.9 </char><char style="xk" closed="false">amicizia </char><char style="xt" closed="false"><ref loc="PRO 10:12">Prov. 10.12</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 17:9">Ma chi <char style="add">lo</char> ridice disunisce gli amici.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10"/>La riprensione scende <char style="add">più addentro</char> nell'<char style="add">uomo</char> intendente,</para>
  <para style="q" vid="PRO 17:10">Che cento percosse date allo stolto.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11"/>Il malvagio non cerca altro che ribellione;</para>
  <para style="q" vid="PRO 17:11">Ma l'angelo crudele sarà mandato contro a lui.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12"/>Scontrisi pure in un uomo un'orsa, a cui sieno stati tolti i suoi figli,</para>
  <para style="q" vid="PRO 17:12">Anzi che un pazzo nella sua pazzia.<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13"/>Il male non si dipartirà giammai dalla casa</para>
  <para style="q" vid="PRO 17:13">Di chi rende il mal per lo bene<note caller="*" style="x"><char style="xo" closed="false">17.13 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="MAT 5:39">Mat. 5.39</ref> ecc. <ref loc="ROM 12:17">Rom. 12.17</ref>. <ref loc="1TH 5:15">1 Tess. 5.15</ref>. <ref loc="1PE 3:9">1 Piet. 3.9</ref>.</char></note>.<verse eid="PRO 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14"/>Chi comincia la contesa <char style="add">è come</char> chi dà apritura alle acque;</para>
  <para style="q" vid="PRO 17:14">Però avanti che si venga alle contumelie, lascia la questione<note caller="*" style="x"><char style="xo" closed="false">17.14 </char><char style="xk" closed="false">questione </char><char style="xt" closed="false"><ref loc="PRO 20:3">Prov. 20.3</ref>. <ref loc="1TH 4:11">1 Tess. 4.11</ref>.</char></note>.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15"/>Chi assolve il reo, e chi condanna il giusto,</para>
  <para style="q" vid="PRO 17:15">
    <char style="add">Sono</char> amendue ugualmente abbominevoli al Signore<note caller="*" style="x"><char style="xo" closed="false">17.15 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="EXO 23:7">Esod. 23.7</ref> e rif. <ref loc="PRO 24:24">Prov. 24.24</ref>. <ref loc="ISA 5:23">Is. 5.23</ref>.</char></note>.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16"/>A che <char style="add">serve</char> il prezzo in mano allo stolto,</para>
  <para style="q" vid="PRO 17:16">Da comperar sapienza, poichè egli non <char style="add">ha</char> alcun senno?<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17"/>L'amico ama in ogni tempo,</para>
  <para style="q" vid="PRO 17:17">E il fratello nasce per l'afflizione<note caller="*" style="x"><char style="xo" closed="false">17.17 </char><char style="xk" closed="false">afflizione </char><char style="xt" closed="false"><ref loc="RUT 1:16">Rut 1.16</ref>. <ref loc="PRO 18:24">Prov. 18.24</ref>.</char></note>.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18"/>L'uomo scemo di senno tocca la mano,</para>
  <para style="q" vid="PRO 17:18">
    <char style="add">E</char> fa sicurtà al suo prossimo<note caller="*" style="x"><char style="xo" closed="false">17.18 </char><char style="xk" closed="false">prossimo </char><char style="xt" closed="false"><ref loc="PRO 6:1">Prov. 6.1</ref> </char><char style="xta" closed="false">ecc. e rif.</char></note>.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19"/>Chi ama contesa ama misfatto;</para>
  <para style="q" vid="PRO 17:19">Chi alza la sua porta cerca ruina<note caller="*" style="x"><char style="xo" closed="false">17.19 </char><char style="xk" closed="false">ruina </char><char style="xt" closed="false"><ref loc="PRO 16:18">Prov. 16.18</ref>; <ref loc="PRO 29:23">29.23</ref>.</char></note>.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20"/>L' <char style="add">uomo</char> perverso di cuore non troverà il bene;</para>
  <para style="q" vid="PRO 17:20">E l'<char style="add">uomo</char> stravolto nel suo parlare<note caller="*" style="x"><char style="xo" closed="false">17.20 </char><char style="xk" closed="false">parlare </char><char style="xt" closed="false"><ref loc="JAS 3:8">Giac. 3.8</ref>.</char></note> caderà nel male.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21"/>Chi genera un pazzo <char style="add">lo genera</char> a suo cordoglio;</para>
  <para style="q" vid="PRO 17:21">E il padre dello stolto non si rallegrerà<note caller="*" style="x"><char style="xo" closed="false">17.21 </char><char style="xk" closed="false">rallegrerà </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref>; <ref loc="PRO 19:13">19.13</ref>; </char><char style="xta" closed="false">ver. 25.</char></note>.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22"/>Il cuore allegro giova, <char style="add">come</char> una medicina<note caller="*" style="x"><char style="xo" closed="false">17.22 </char><char style="xk" closed="false">medicina </char><char style="xt" closed="false"><ref loc="PRO 12:25">Prov. 12.25</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 17:22">Ma lo spirito afflitto secca le ossa.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23"/>L'empio prende il presente dal seno<note caller="*" style="x"><char style="xo" closed="false">17.23 </char><char style="xk" closed="false">seno </char><char style="xt" closed="false"><ref loc="EXO 23:8">Esod. 23.8</ref>. <ref loc="PRO 21:14">Prov. 21.14</ref>.</char></note>,</para>
  <para style="q" vid="PRO 17:23">Per pervertir le vie del giudicio.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24"/>La sapienza <char style="add">è</char> nel cospetto dell'intendente<note caller="*" style="x"><char style="xo" closed="false">17.24 </char><char style="xk" closed="false">intendente </char><char style="xt" closed="false"><ref loc="PRO 14:6">Prov. 14.6</ref>. <ref loc="ECC 2:14">Eccl. 2.14</ref>; <ref loc="ECC 8:1">8.1</ref>.</char></note>;</para>
  <para style="q" vid="PRO 17:24">Ma gli occhi dello stolto <char style="add">riguardano</char> alle estremità della terra.<verse eid="PRO 17:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25"/>Il figliuolo stolto <char style="add">è</char> sdegno a suo padre<note caller="*" style="x"><char style="xo" closed="false">17.25 </char><char style="xk" closed="false">padre </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 17:25">Ed amaritudine a colei che l'ha partorito.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26"/>Egli non <char style="add">è</char> bene di condannare il giusto<note caller="*" style="x"><char style="xo" closed="false">17.26 </char><char style="xk" closed="false">giusto </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 15">15</ref>. <ref loc="PRO 18:5">Prov. 18.5</ref>.</char></note>, non pure ad ammenda,</para>
  <para style="q" vid="PRO 17:26">
    <char style="add">Nè</char> che i principi battano <char style="add">alcuno</char> per dirittura.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27"/>Chi rattiene i suoi detti <char style="add">è</char> dotato di conoscimento<note caller="*" style="x"><char style="xo" closed="false">17.27 </char><char style="xk" closed="false">conoscimento </char><char style="xt" closed="false"><ref loc="JAS 1:19">Giac. 1.19</ref>.</char></note>;</para>
  <para style="q" vid="PRO 17:27">
    <char style="add">E</char> chi <char style="add">è di</char> spirito riservato <char style="add">è</char> uomo intendente.<verse eid="PRO 17:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28"/>Lo stolto stesso è reputato savio, quando si tace;</para>
  <para style="q" vid="PRO 17:28">
    <char style="add">E</char> prudente, quando tiene le labbra chiuse<note caller="*" style="x"><char style="xo" closed="false">17.28 </char><char style="xk" closed="false">chiuse </char><char style="xt" closed="false"><ref loc="JOB 13:5">Giob. 13.5</ref>.</char></note>.<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1"/>Colui che si separa cerca le sue cupidità,</para>
  <para style="q" vid="PRO 18:1">E schernisce ogni legge e ragione.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2"/>Lo stolto non si diletta nella prudenza,</para>
  <para style="q" vid="PRO 18:2">Ma in ciò che il cuor suo si manifesti<note caller="*" style="x"><char style="xo" closed="false">18.2 </char><char style="xk" closed="false">manifesti </char><char style="xt" closed="false"><ref loc="ECC 10:3">Eccl. 10.3</ref>.</char></note>.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3"/>Quando viene un empio, viene anche lo sprezzo,</para>
  <para style="q" vid="PRO 18:3">E il vituperio con ignominia.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4"/>Le parole della bocca dell'uomo eccellente sono acque profonde<note caller="*" style="x"><char style="xo" closed="false">18.4 </char><char style="xk" closed="false">profonde </char><char style="xt" closed="false"><ref loc="PRO 10:11">Prov. 10.11</ref>. <ref loc="JHN 7:38">Giov. 7.38</ref>.</char></note>;</para>
  <para style="q" vid="PRO 18:4">La fonte di sapienza <char style="add">è</char> un torrente che sgorga.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5"/>Egli non <char style="add">è</char> bene d'aver riguardo alla qualità dell'empio,</para>
  <para style="q" vid="PRO 18:5">Per far torto al giusto nel giudicio<note caller="*" style="x"><char style="xo" closed="false">18.5 </char><char style="xk" closed="false">giudicio </char><char style="xt" closed="false"><ref loc="LEV 19:15">Lev. 19.15</ref>. <ref loc="DEU 1:17">Deut. 1.17</ref>.</char></note>.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6"/>Le labbra dello stolto entrano in contesa,</para>
  <para style="q" vid="PRO 18:6">E la sua bocca chiama le percosse<note caller="*" style="x"><char style="xo" closed="false">18.6 </char><char style="xk" closed="false">percosse </char><char style="xt" closed="false"><ref loc="PRO 19:29">Prov. 19.29</ref>.</char></note>.<verse eid="PRO 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7"/>La bocca dello stolto <char style="add">è</char> la sua ruina,</para>
  <para style="q" vid="PRO 18:7">E le sue labbra <char style="add">sono</char> il laccio dell'anima sua<note caller="*" style="x"><char style="xo" closed="false">18.7 </char><char style="xk" closed="false">sua </char><char style="xt" closed="false"><ref loc="PRO 10:14">Prov. 10.14</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8"/>Le parole di chi va bisbigliando paiono lusinghevoli;</para>
  <para style="q" vid="PRO 18:8">Ma scendono fin nell'interiora del ventre<note caller="*" style="x"><char style="xo" closed="false">18.8 </char><char style="xk" closed="false">ventre </char><char style="xt" closed="false"><ref loc="PRO 12:18">Prov. 12.18</ref>; <ref loc="PRO 26:22">26.22</ref>.</char></note>.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9"/>Chi si porta rimessamente nel suo lavoro,</para>
  <para style="q" vid="PRO 18:9">
    <char style="add">È</char> fratello dell'uomo dissipatore.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10"/>Il Nome del Signore <char style="add">è</char> una forte torre<note caller="*" style="x"><char style="xo" closed="false">18.10 </char><char style="xk" closed="false">torre </char><char style="xt" closed="false"><ref loc="PSA 18:1">Sal. 18.1</ref>,<ref loc="PSA 18:2">2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 18:10">Il giusto vi ricorrerà, e sarà in salvo in luogo elevato.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11"/>I beni del ricco <char style="add">son</char> la sua città di fortezza,</para>
  <para style="q" vid="PRO 18:11">E come un alto muro alla sua immaginazione<note caller="*" style="x"><char style="xo" closed="false">18.11 </char><char style="xk" closed="false">immaginazione </char><char style="xt" closed="false"><ref loc="PRO 10:15">Prov. 10.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12"/>Il cuor dell'uomo s'innalza avanti la ruina<note caller="*" style="x"><char style="xo" closed="false">18.12 </char><char style="xk" closed="false">ruina </char><char style="xt" closed="false"><ref loc="PRO 11:2">Prov. 11.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 18:12">Ma l'umiltà <char style="add">va</char> davanti alla gloria.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13"/>Chi fa risposta prima che abbia udito,</para>
  <para style="q" vid="PRO 18:13">Ciò gli <char style="add">è</char> pazzia e vituperio<note caller="*" style="x"><char style="xo" closed="false">18.13 </char><char style="xk" closed="false">vituperio </char><char style="xt" closed="false"><ref loc="JHN 7:51">Giov. 7.51</ref>.</char></note>.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14"/>Lo spirito dell'uomo sostiene l'infermità di esso;</para>
  <para style="q" vid="PRO 18:14">Ma chi solleverà lo spirito afflitto?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15"/>Il cuor dell'<char style="add">uomo</char> intendente acquista scienza;</para>
  <para style="q" vid="PRO 18:15">E l'orecchio de' savi cerca conoscimento.<verse eid="PRO 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16"/>Il presente dell'uomo gli fa far largo,</para>
  <para style="q" vid="PRO 18:16">E lo conduce davanti a' grandi<note caller="*" style="x"><char style="xo" closed="false">18.16 </char><char style="xk" closed="false">grandi </char><char style="xt" closed="false"><ref loc="GEN 32:20">Gen. 32.20</ref>. <ref loc="1SA 25:27">1 Sam. 25.27</ref>. <ref loc="PRO 17:8">Prov. 17.8</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17"/>Chi <char style="add">è</char> il primo a <char style="add">piatir</char> la sua causa ha ragione;</para>
  <para style="q" vid="PRO 18:17">Ma il suo compagno vien <char style="add">poi</char>, ed esamina quello <char style="add">ch'egli ha detto</char>.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18"/>La sorte fa cessar le liti,</para>
  <para style="q" vid="PRO 18:18">E fa gli spartimenti fra i potenti.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19"/>Il fratello offeso <char style="add">è più inespugnabile</char> che una forte città;</para>
  <para style="q" vid="PRO 18:19">E le contese <char style="add">tra fratelli son</char> come le sbarre di un palazzo.<verse eid="PRO 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20"/>Il ventre dell'uomo sarà saziato del frutto della sua bocca<note caller="*" style="x"><char style="xo" closed="false">18.20 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="PRO 12:14">Prov. 12.14</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 18:20">Egli sarà saziato della rendita delle sue labbra.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21"/>Morte e vita <char style="add">sono</char> in poter della lingua<note caller="*" style="x"><char style="xo" closed="false">18.21 </char><char style="xk" closed="false">lingua </char><char style="xt" closed="false"><ref loc="MAT 12:37">Mat. 12.37</ref>.</char></note>;</para>
  <para style="q" vid="PRO 18:21">E chi l'ama mangerà del frutto di essa.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22"/>Chi ha trovata moglie ha trovata una buona cosa<note caller="*" style="x"><char style="xo" closed="false">18.22 </char><char style="xk" closed="false">cosa </char><char style="xt" closed="false"><ref loc="GEN 2:18">Gen. 2.18</ref>. <ref loc="PRO 12:4">Prov. 12.4</ref>; <ref loc="PRO 19:14">19.14</ref>; <ref loc="PRO 31:10-31">31.10-31</ref>.</char></note>,</para>
  <para style="q" vid="PRO 18:22">Ed ha ottenuto favor del Signore.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23"/>Il povero parla supplichevolmente;</para>
  <para style="q" vid="PRO 18:23">Ma il ricco risponde duramente<note caller="*" style="x"><char style="xo" closed="false">18.23 </char><char style="xk" closed="false">duramente </char><char style="xt" closed="false"><ref loc="JAS 2:3">Giac. 2.3</ref>.</char></note>.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24"/>Un uomo che ha degli amici deve portarsi da amico<note caller="*" style="x"><char style="xo" closed="false">18.24 </char><char style="xk" closed="false">amico </char><char style="xt" closed="false"><ref loc="PRO 17:17">Prov. 17.17</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 18:24">E vi è tale amico, che è più congiunto che un fratello.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1"/>Il povero, che cammina nella sua integrità,</para>
  <para style="q" vid="PRO 19:1">Val meglio che il perverso di labbra, il quale <char style="add">è</char> stolto<note caller="*" style="x"><char style="xo" closed="false">19.1 </char><char style="xk" closed="false">stolto </char><char style="xt" closed="false"><ref loc="PRO 28:6">Prov. 28.6</ref>.</char></note>.<verse eid="PRO 19:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2"/>Come chi è frettoloso di piedi incappa;</para>
  <para style="q" vid="PRO 19:2">Così non <char style="add">vi è</char> alcun bene, quando l'anima è senza conoscimento.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3"/>La stoltizia dell'uomo perverte la via di esso;</para>
  <para style="q" vid="PRO 19:3">E pure il suo cuore dispetta contro al Signore.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4"/>Le ricchezze aggiungono amici in gran numero;</para>
  <para style="q" vid="PRO 19:4">Ma il misero è separato dal suo intimo amico<note caller="*" style="x"><char style="xo" closed="false">19.4 </char><char style="xk" closed="false">amico </char><char style="xt" closed="false"><ref loc="PRO 14:20">Prov. 14.20</ref>.</char></note>.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5"/>Il falso testimonio non resterà impunito<note caller="*" style="x"><char style="xo" closed="false">19.5 </char><char style="xk" closed="false">impunito </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 9">9</ref>. <ref loc="EXO 23:1">Esod. 23.1</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 19:5">E chi sbocca menzogne non iscamperà.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6"/>Molti riveriscono il principe;</para>
  <para style="q" vid="PRO 19:6">Ma ognuno <char style="add">è</char> amico del donatore<note caller="*" style="x"><char style="xo" closed="false">19.6 </char><char style="xk" closed="false">donatore </char><char style="xt" closed="false"><ref loc="PRO 17:8">Prov. 17.8</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7"/>Tutti i fratelli del povero l'odiano;</para>
  <para style="q" vid="PRO 19:7">Quanto più si dilungheranno i suoi amici da lui!</para>
  <para style="q" vid="PRO 19:7">Egli <char style="add">con</char> parole <char style="add">li</char> supplica, ma essi se ne vanno.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8"/>Chi acquista senno ama l'anima sua;</para>
  <para style="q" vid="PRO 19:8">Chi osserva l'intendimento troverà del bene.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9"/>Il falso testimonio non resterà impunito<note caller="*" style="x"><char style="xo" closed="false">19.9 </char><char style="xk" closed="false">impunito </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 5">5</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 19:9">E chi sbocca menzogne perirà.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10"/>I diletti non si convengono allo stolto;</para>
  <para style="q" vid="PRO 19:10">Quanto meno <char style="add">conviensi</char> al servo signoreggiar sopra i principi<note caller="*" style="x"><char style="xo" closed="false">19.10 </char><char style="xk" closed="false">principi </char><char style="xt" closed="false"><ref loc="PRO 30:22">Prov. 30.22</ref>. <ref loc="ECC 10:5-7">Eccl. 10.5-7</ref>.</char></note>!<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11"/>Il senno dell'uomo rallenta l'ira di esso<note caller="*" style="x"><char style="xo" closed="false">19.11 </char><char style="xk" closed="false">esso </char><char style="xt" closed="false"><ref loc="PRO 14:29">Prov. 14.29</ref>. <ref loc="JAS 1:19">Giac. 1.19</ref>.</char></note>;</para>
  <para style="q" vid="PRO 19:11">E la sua gloria <char style="add">è</char> di passar sopra le offese<note caller="*" style="x"><char style="xo" closed="false">19.11 </char><char style="xk" closed="false">offese </char><char style="xt" closed="false"><ref loc="PRO 16:32">Prov. 16.32</ref>.</char></note>.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12"/>L'indegnazione del re <char style="add">è</char> come il ruggito del leoncello<note caller="*" style="x"><char style="xo" closed="false">19.12 </char><char style="xk" closed="false">leoncello </char><char style="xt" closed="false"><ref loc="PRO 16:14">Prov. 16.14</ref>,<ref loc="PRO 16:15">15</ref>; <ref loc="PRO 20:2">20.2</ref>.</char></note>;</para>
  <para style="q" vid="PRO 19:12">Ma il suo favore <char style="add">è</char> come la rugiada sopra l'erba.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13"/>Il figliuolo stolto <char style="add">è</char> una grande sciagura a suo padre<note caller="*" style="x"><char style="xo" closed="false">19.13 </char><char style="xk" closed="false">padre </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 19:13">E le risse della moglie <char style="add">sono</char> un gocciolar continuo<note caller="*" style="x"><char style="xo" closed="false">19.13 </char><char style="xk" closed="false">continuo </char><char style="xt" closed="false"><ref loc="PRO 21:9">Prov. 21.9</ref>,<ref loc="PRO 21:19">19</ref>; <ref loc="PRO 27:15">27.15</ref>.</char></note>.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14"/>Casa e sostanza <char style="add">sono</char> l'eredità de' padri<note caller="*" style="x"><char style="xo" closed="false">19.14 </char><char style="xk" closed="false">padri </char><char style="xt" closed="false"><ref loc="2CO 12:14">2 Cor. 12.14</ref>.</char></note>;</para>
  <para style="q" vid="PRO 19:14">Ma dal Signore <char style="add">viene</char> la moglie prudente<note caller="*" style="x"><char style="xo" closed="false">19.14 </char><char style="xk" closed="false">prudente </char><char style="xt" closed="false"><ref loc="PRO 18:22">Prov. 18.22</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15"/>La pigrizia fa cadere in profondo sonno<note caller="*" style="x"><char style="xo" closed="false">19.15 </char><char style="xk" closed="false">sonno </char><char style="xt" closed="false"><ref loc="PRO 6:9">Prov. 6.9</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 19:15">E la persona negligente avrà fame<note caller="*" style="x"><char style="xo" closed="false">19.15 </char><char style="xk" closed="false">fame </char><char style="xt" closed="false"><ref loc="PRO 10:4">Prov. 10.4</ref>; <ref loc="PRO 20:13">20.13</ref>; <ref loc="PRO 23:21">23.21</ref>.</char></note>.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16"/>Chi osserva il comandamento guarda l'anima sua<note caller="*" style="x"><char style="xo" closed="false">19.16 </char><char style="xk" closed="false">sua </char><char style="xt" closed="false"><ref loc="LUK 10:28">Luc. 10.28</ref>; <ref loc="LUK 11:28">11.28</ref>.</char></note>;</para>
  <para style="q" vid="PRO 19:16">
    <char style="add">Ma</char> chi trascura le sue vie morrà.<verse eid="PRO 19:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17"/>Chi dona al povero presta al Signore;</para>
  <para style="q" vid="PRO 19:17">Ed <char style="add">egli</char> gli farà la sua retribuzione<note caller="*" style="x"><char style="xo" closed="false">19.17 </char><char style="xk" closed="false">retribuzione </char><char style="xt" closed="false"><ref loc="DEU 15:7-10">Deut. 15.7-10</ref>. <ref loc="PRO 28:27">Prov. 28.27</ref>. <ref loc="ECC 11:1">Eccl. 11.1</ref>. <ref loc="MAT 10:42">Mat. 10.42</ref>; <ref loc="MAT 25:32-40">25.32-40</ref>. <ref loc="2CO 9:6-8">2 Cor. 9.6-8</ref>. <ref loc="HEB 6:10">Ebr. 6.10</ref>.</char></note>.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18"/>Gastiga il tuo figliuolo<note caller="*" style="x"><char style="xo" closed="false">19.18 </char><char style="xk" closed="false">figliuolo </char><char style="xt" closed="false"><ref loc="PRO 13:24">Prov. 13.24</ref> </char><char style="xta" closed="false">e rif.</char></note>, mentre vi è ancora della speranza;</para>
  <para style="q" vid="PRO 19:18">Ma non imprender già di ucciderlo.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19"/>Chi <char style="add">è</char> grandemente iracondo <char style="add">ne</char> porterà la pena;</para>
  <para style="q" vid="PRO 19:19">Che se tu <char style="add">lo</char> scampi, tu lo renderai vie più <char style="add">iracondo</char>.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20"/>Ascolta consiglio, e ricevi correzione,</para>
  <para style="q" vid="PRO 19:20">Acciocchè tu diventi savio alla fine.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21"/>
    <char style="add">Vi sono</char> molti pensieri nel cuor dell'uomo;</para>
  <para style="q" vid="PRO 19:21">Ma il consiglio del Signore <char style="add">è</char> quello che sarà stabile<note caller="*" style="x"><char style="xo" closed="false">19.21 </char><char style="xk" closed="false">stabile </char><char style="xt" closed="false"><ref loc="JOB 23:13">Giob. 23.13</ref>. <ref loc="PSA 33:10">Sal. 33.10</ref>,<ref loc="PSA 33:11">11</ref>. <ref loc="PRO 21:30">Prov. 21.30</ref>. <ref loc="ISA 46:10">Is. 46.10</ref>,<ref loc="ISA 46:11">11</ref>. <ref loc="ACT 5:39">Fat. 5.39</ref>. <ref loc="HEB 6:17">Ebr. 6.17</ref>,<ref loc="HEB 6:18">18</ref>.</char></note>.<verse eid="PRO 19:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22"/>La benignità dell'uomo <char style="add">è</char> il suo ornamento;</para>
  <para style="q" vid="PRO 19:22">E meglio vale il povero, che l'uomo bugiardo.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23"/>Il timor del Signore <char style="add">è</char> a vita;</para>
  <para style="q" vid="PRO 19:23">
    <char style="add">E chi lo teme</char> passerà la notte sazio, <char style="add">e</char> non sarà visitato da alcun male<note caller="*" style="x"><char style="xo" closed="false">19.23 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="PSA 25:12">Sal. 25.12</ref>,<ref loc="PSA 25:13">13</ref>. <ref loc="1TI 4:8">1 Tim. 4.8</ref>.</char></note>.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24"/>Il pigro nasconde la mano nel seno,</para>
  <para style="q" vid="PRO 19:24">E non la ritrae fuori, non pure <char style="add">per recarsela</char> alla bocca<note caller="*" style="x"><char style="xo" closed="false">19.24 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="PRO 15:19">Prov. 15.19</ref>; <ref loc="PRO 26:13">26.13</ref>,<ref loc="PRO 26:15">15</ref>.</char></note>.<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25"/>Percuoti lo schernitore, e il semplice ne diventerà avveduto<note caller="*" style="x"><char style="xo" closed="false">19.25 </char><char style="xk" closed="false">avvenduto </char><char style="xt" closed="false"><ref loc="PRO 21:11">Prov. 21.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 19:25">E se tu correggi l'<char style="add">uomo</char> intendente, egli intenderà la scienza<note caller="*" style="x"><char style="xo" closed="false">19.25 </char><char style="xk" closed="false">scienza </char><char style="xt" closed="false"><ref loc="PSA 141:5">Sal. 141.5</ref>. <ref loc="PRO 9:8">Prov. 9.8</ref>.</char></note>.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26"/>Il figliuolo che fa vergogna e vituperio,</para>
  <para style="q" vid="PRO 19:26">Ruina il padre, <char style="add">e</char> scaccia la madre.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27"/>Figliuol mio, ascoltando l'ammaestramento,</para>
  <para style="q" vid="PRO 19:27">Rimanti di deviare da' detti di scienza.<verse eid="PRO 19:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28"/>Il testimonio scellerato schernisce la dirittura;</para>
  <para style="q" vid="PRO 19:28">E la bocca degli empi trangugia l'iniquità.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29"/>I giudicii sono apparecchiati agli schernitori,</para>
  <para style="q" vid="PRO 19:29">E le percosse al dosso degli stolti<note caller="*" style="x"><char style="xo" closed="false">19.29 </char><char style="xk" closed="false">stolti </char><char style="xt" closed="false"><ref loc="PRO 10:13">Prov. 10.13</ref>; <ref loc="PRO 26:3">26.3</ref>.</char></note>.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1"/>Il vino <char style="add">è</char> schernitore, e la cervogia <char style="add">è</char> tumultuante;</para>
  <para style="q" vid="PRO 20:1">E chiunque ne è vago non è savio<note caller="*" style="x"><char style="xo" closed="false">20.1 </char><char style="xk" closed="false">savio </char><char style="xt" closed="false"><ref loc="GEN 9:21">Gen. 9.21</ref>. <ref loc="PRO 23:29-32">Prov. 23.29-32</ref>. <ref loc="ISA 28:7">Is. 28.7</ref>. <ref loc="EPH 5:18">Efes. 5.18</ref>.</char></note>.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2"/>Il terrore del re <char style="add">è</char> come il ruggito del leoncello<note caller="*" style="x"><char style="xo" closed="false">20.2 </char><char style="xk" closed="false">leoncello </char><char style="xt" closed="false"><ref loc="PRO 16:14">Prov. 16.14</ref>; <ref loc="PRO 19:12">19.12</ref>.</char></note>;</para>
  <para style="q" vid="PRO 20:2">Chi lo provoca ad indegnazione pecca <char style="add">contro a</char> sè stesso.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3"/>
    <char style="add">Egli è</char> gloria all'uomo di rimanersi di contesa<note caller="*" style="x"><char style="xo" closed="false">20.3 </char><char style="xk" closed="false">contesa </char><char style="xt" closed="false"><ref loc="PRO 17:14">Prov. 17.14</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 20:3">Ma chiunque è stolto si fa schernire.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4"/>Il pigro non ara per cagion del freddo<note caller="*" style="x"><char style="xo" closed="false">20.4 </char><char style="xk" closed="false">freddo </char><char style="xt" closed="false"><ref loc="PRO 19:24">Prov. 19.24</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 20:4">
    <char style="add">E poi</char> nella ricolta va accattando, e <char style="add">non trova</char> nulla<note caller="*" style="x"><char style="xo" closed="false">20.4 </char><char style="xk" closed="false">nulla </char><char style="xt" closed="false"><ref loc="PRO 6:10">Prov. 6.10</ref>,<ref loc="PRO 6:11">11</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5"/>Il consiglio nel cuor dell'uomo <char style="add">è</char> un'acqua profonda<note caller="*" style="x"><char style="xo" closed="false">20.5 </char><char style="xk" closed="false">profonda </char><char style="xt" closed="false"><ref loc="PRO 18:4">Prov. 18.4</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 20:5">E l'uomo intendente l'attignerà.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6"/>Il più degli uomini predicano ciascuno la sua benignità<note caller="*" style="x"><char style="xo" closed="false">20.6 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="PRO 25:14">Prov. 25.14</ref>. <ref loc="MAT 6:2">Mat. 6.2</ref>.</char></note>;</para>
  <para style="q" vid="PRO 20:6">Ma chi troverà un uomo verace?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7"/>I figliuoli del giusto, che cammina nella sua integrità,</para>
  <para style="q" vid="PRO 20:7">
    <char style="add">Saranno</char> beati dopo di lui<note caller="*" style="x"><char style="xo" closed="false">20.7 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="PSA 37:26">Sal. 37.26</ref>; <ref loc="PSA 112:2">112.2</ref>.</char></note>.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8"/>Il re, sedendo sopra il trono del giudicio,</para>
  <para style="q" vid="PRO 20:8">Dissipa ogni male con gli occhi suoi.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9"/>Chi può dire: Io ho purgato il mio cuore,</para>
  <para style="q" vid="PRO 20:9">Io son netto del mio peccato<note caller="*" style="x"><char style="xo" closed="false">20.9 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="1KI 8:46">1 Re. 8.46</ref> e rif. <ref loc="ROM 3:9">Rom. 3.9</ref>.</char></note>?<verse eid="PRO 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10"/>Doppio peso, e doppio staio,</para>
  <para style="q" vid="PRO 20:10">
    <char style="add">Sono</char> amendue cosa abbominevole al Signore<note caller="*" style="x"><char style="xo" closed="false">20.10 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 11:1">Prov. 11.1</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11"/>Fin da fanciullo <char style="add">l'uomo</char> è riconosciuto da' suoi atti<note caller="*" style="x"><char style="xo" closed="false">20.11 </char><char style="xk" closed="false">atti </char><char style="xt" closed="false"><ref loc="MAT 7:16">Mat. 7.16</ref>.</char></note>,</para>
  <para style="q" vid="PRO 20:11">Se egli <char style="add">sarà</char> puro, e se le sue opere <char style="add">saranno</char> diritte.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12"/>Il Signore ha fatte amendue queste cose:</para>
  <para style="q" vid="PRO 20:12">E l'orecchio che ode, e l'occhio che vede<note caller="*" style="x"><char style="xo" closed="false">20.12 </char><char style="xk" closed="false">vede </char><char style="xt" closed="false"><ref loc="EXO 4:11">Esod. 4.11</ref>. <ref loc="PSA 94:9">Sal. 94.9</ref>.</char></note>.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13"/>Non amare il sonno, che tu non impoverisca<note caller="*" style="x"><char style="xo" closed="false">20.13 </char><char style="xk" closed="false">impoverisca </char><char style="xt" closed="false"><ref loc="PRO 6:9">Prov. 6.9</ref> e rif. <ref loc="ROM 12:11">Rom. 12.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 20:13">Tieni gli occhi aperti, <char style="add">e</char> sarai saziato di pane.<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14"/>Chi compera dice: <char style="add">Egli è</char> cattivo, <char style="add">egli è</char> cattivo;</para>
  <para style="q" vid="PRO 20:14">Ma quando se n'è andato, allora si vanta.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15"/>Vi è dell'oro, e delle perle assai;</para>
  <para style="q" vid="PRO 20:15">Ma le labbra di scienza <char style="add">sono</char> un vaso prezioso<note caller="*" style="x"><char style="xo" closed="false">20.15 </char><char style="xk" closed="false">prezioso </char><char style="xt" closed="false"><ref loc="PRO 3:14">Prov. 3.14</ref>,<ref loc="PRO 3:15">15</ref> e rif.; <ref loc="PRO 8:11">8.11</ref>.</char></note>.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16"/>Prendi pure il vestimento di chi ha fatta sicurtà per lo strano<note caller="*" style="x"><char style="xo" closed="false">20.16 </char><char style="xk" closed="false">strano </char><char style="xt" closed="false"><ref loc="PRO 6:1">Prov. 6.1</ref> </char><char style="xta" closed="false">ecc. e rif.</char></note>;</para>
  <para style="q" vid="PRO 20:16">Prendi pegno da lui per gli stranieri.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17"/>Il pane acquistato con frode è soave all'uomo<note caller="*" style="x"><char style="xo" closed="false">20.17 </char><char style="xk" closed="false">uomo </char><char style="xt" closed="false"><ref loc="PRO 9:17">Prov. 9.17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 20:17">Ma poi la sua bocca si trova piena di ghiaia.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18"/>I disegni son renduti stabili con consiglio;</para>
  <para style="q" vid="PRO 20:18">Fa' dunque la guerra con prudenti deliberazioni<note caller="*" style="x"><char style="xo" closed="false">20.18 </char><char style="xk" closed="false">deliberazioni </char><char style="xt" closed="false"><ref loc="LUK 14:31">Luc. 14.31</ref>.</char></note>.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19"/>Chi va sparlando palesa il segreto<note caller="*" style="x"><char style="xo" closed="false">20.19 </char><char style="xk" closed="false">segreto </char><char style="xt" closed="false"><ref loc="PRO 11:13">Prov. 11.13</ref> </char><char style="xta" closed="false">e rif.</char></note>:</para>
  <para style="q" vid="PRO 20:19">Non rimescolarti adunque con chi è allettante di labbra.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20"/>La lampana di chi maledice suo padre, o sua madre,</para>
  <para style="q" vid="PRO 20:20">Sarà spenta nelle più oscure tenebre<note caller="*" style="x"><char style="xo" closed="false">20.20 </char><char style="xk" closed="false">tenebre </char><char style="xt" closed="false"><ref loc="LEV 20:9">Lev. 20.9</ref>. <ref loc="MAT 15:4">Mat. 15.4</ref>.</char></note>.<verse eid="PRO 20:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21"/>L'eredità acquistata di subito da principio<note caller="*" style="x"><char style="xo" closed="false">20.21 </char><char style="xk" closed="false">principio </char><char style="xt" closed="false"><ref loc="PRO 28:20">Prov. 28.20</ref>.</char></note></para>
  <para style="q" vid="PRO 20:21">Non sarà benedetta alla fine.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22"/>Non dire: Io renderò il male<note caller="*" style="x"><char style="xo" closed="false">20.22 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="DEU 32:35">Deut. 32.35</ref> e rif. <ref loc="MAT 5:39-41">Mat. 5.39-41</ref>. <ref loc="ROM 12:17-19">Rom. 12.17-19</ref>. <ref loc="1TH 5:13">1 Tess. 5.13</ref>. <ref loc="1PE 3:8">1 Piet. 3.8</ref>,<ref loc="1PE 3:9">9</ref>.</char></note>;</para>
  <para style="q" vid="PRO 20:22">Aspetta il Signore, ed egli ti salverà.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23"/>Doppio peso <char style="add">è</char> cosa abbominevole al Signore<note caller="*" style="x"><char style="xo" closed="false">20.23 </char><char style="xk" closed="false">Signore </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 10">10</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 20:23">E le bilance fallaci non <char style="add">sono</char> buone.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24"/>I passi dell'uomo <char style="add">sono</char> dal Signore<note caller="*" style="x"><char style="xo" closed="false">20.24 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 16:9">Prov. 16.9</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 20:24">E come intenderà l'uomo la sua via?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25"/>Dire inconsideratamente: <char style="add">Questa è</char> cosa sacra;</para>
  <para style="q" vid="PRO 20:25">E riflettere dopo aver fatti i voti, è un laccio all'uomo.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26"/>Il re savio dissipa gli empi,</para>
  <para style="q" vid="PRO 20:26">E rimena la ruota sopra loro.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27"/>L'anima dell'uomo <char style="add">è</char> una lampana del Signore,</para>
  <para style="q" vid="PRO 20:27">Che investiga tutti i segreti nascondimenti del ventre.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28"/>Benignità e verità guardano il re;</para>
  <para style="q" vid="PRO 20:28">Ed egli ferma il suo trono per benignità<note caller="*" style="x"><char style="xo" closed="false">20.28 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="PRO 29:14">Prov. 29.14</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29"/>La forza de' giovani <char style="add">è</char> la lor gloria;</para>
  <para style="q" vid="PRO 20:29">E l'onor de' vecchi <char style="add">è</char> la canutezza<note caller="*" style="x"><char style="xo" closed="false">20.29 </char><char style="xk" closed="false">canutezza </char><char style="xt" closed="false"><ref loc="PRO 16:31">Prov. 16.31</ref>.</char></note>.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30"/>I lividori delle battiture, e le percosse che penetrano addentro nel ventre</para>
  <para style="q" vid="PRO 20:30">
    <char style="add">Sono</char> una lisciatura nel malvagio.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1"/>Il cuor del re <char style="add">è</char> nella mano del Signore come ruscelli di acque;</para>
  <para style="q" vid="PRO 21:1">Egli lo piega a tutto ciò che gli piace<note caller="*" style="x"><char style="xo" closed="false">21.1 </char><char style="xk" closed="false">piace </char><char style="xt" closed="false"><ref loc="EZR 6:12">Esd. 6.12</ref>.</char></note>.<verse eid="PRO 21:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2"/>Tutte le vie dell'uomo gli paiono diritte<note caller="*" style="x"><char style="xo" closed="false">21.2 </char><char style="xk" closed="false">diritte </char><char style="xt" closed="false"><ref loc="PRO 16:2">Prov. 16.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 21:2">Ma il Signore pesa i cuori.<verse eid="PRO 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3"/>Far giustizia e giudicio</para>
  <para style="q" vid="PRO 21:3">
    <char style="add">È</char> cosa più gradita dal Signore, che sacrificio<note caller="*" style="x"><char style="xo" closed="false">21.3 </char><char style="xk" closed="false">sacrificio </char><char style="xt" closed="false"><ref loc="1SA 15:22">1 Sam. 15.22</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4"/>Gli occhi altieri, e il cuor gonfio,</para>
  <para style="q" vid="PRO 21:4">
    <char style="add">Che son</char> la lampana degli empi, <char style="add">son</char> peccato<note caller="*" style="x"><char style="xo" closed="false">21.4 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="PRO 6:16">Prov. 6.16</ref>,<ref loc="PRO 6:17">17</ref>.</char></note>.<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5"/>I pensieri dell'<char style="add">uomo</char> diligente <char style="add">producono</char> di certo abbondanza;</para>
  <para style="q" vid="PRO 21:5">Ma l'uomo disavveduto <char style="add">cade</char> senza fallo in necessità.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6"/>Il far tesori con lingua di falsità <char style="add">è</char> una cosa vana<note caller="*" style="x"><char style="xo" closed="false">21.6 </char><char style="xk" closed="false">vana </char><char style="xt" closed="false"><ref loc="PRO 10:2">Prov. 10.2</ref>; <ref loc="PRO 13:11">13.11</ref>; <ref loc="PRO 20:21">20.21</ref>.</char></note>,</para>
  <para style="q" vid="PRO 21:6">Sospinta <char style="add">in qua ed in là; e si appartiene</char> a quelli che cercan la morte.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7"/>Il predar degli empi li trarrà in giù;</para>
  <para style="q" vid="PRO 21:7">Perciocchè hanno rifiutato di far ciò che <char style="add">è</char> diritto.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8"/>La via stravolta dell'uomo <char style="add">è</char> anche strana;</para>
  <para style="q" vid="PRO 21:8">Ma l'opera di chi <char style="add">è</char> puro <char style="add">è</char> diritta.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9"/>Meglio <char style="add">è</char> abitare sopra un canto di un tetto,</para>
  <para style="q" vid="PRO 21:9">Che <char style="add">con</char> una moglie rissosa in casa comune<note caller="*" style="x"><char style="xo" closed="false">21.9 </char><char style="xk" closed="false">comune </char><char style="xt" closed="false"><ref loc="PRO 19:13">Prov. 19.13</ref> e rif.; <ref loc="PRO 27:15">27.15</ref>.</char></note>.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10"/>L'anima dell'empio desidera il male;</para>
  <para style="q" vid="PRO 21:10">Il suo amico stesso non trova pietà appo lui.<verse eid="PRO 21:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11"/>Quando lo schernitore è gastigato, il semplice <char style="add">ne</char> diventa savio;</para>
  <para style="q" vid="PRO 21:11">E quando si ammonisce il savio, egli apprende scienza<note caller="*" style="x"><char style="xo" closed="false">21.11 </char><char style="xk" closed="false">scienza </char><char style="xt" closed="false"><ref loc="PRO 19:25">Prov. 19.25</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12"/>Il giusto considera la casa dell'empio<note caller="*" style="x"><char style="xo" closed="false">21.12 </char><char style="xk" closed="false">empio </char><char style="xt" closed="false"><ref loc="PSA 37:35">Sal. 37.35</ref>,<ref loc="PSA 37:36">36</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 21:12">Ella trabocca l'empio nel male.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13"/>Chi tura l'orecchio, per non udire il grido del misero,</para>
  <para style="q" vid="PRO 21:13">Griderà anch'egli, e non sarà esaudito<note caller="*" style="x"><char style="xo" closed="false">21.13 </char><char style="xk" closed="false">esaudito </char><char style="xt" closed="false"><ref loc="MAT 7:2">Mat. 7.2</ref>; <ref loc="MAT 18:30-34">18.30-34</ref>. <ref loc="JAS 2:13">Giac. 2.13</ref>.</char></note>.<verse eid="PRO 21:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14"/>Il presente <char style="add">dato</char> di nascosto acqueta l'ira;</para>
  <para style="q" vid="PRO 21:14">E il dono <char style="add">porto</char> nel seno <char style="add">acqueta</char> il forte cruccio<note caller="*" style="x"><char style="xo" closed="false">21.14 </char><char style="xk" closed="false">cruccio </char><char style="xt" closed="false"><ref loc="PRO 17:8">Prov. 17.8</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15"/>Il far ciò che è diritto <char style="add">è</char> letizia al giusto;</para>
  <para style="q" vid="PRO 21:15">Ma <char style="add">è</char> uno spavento agli operatori d'iniquità.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16"/>L'uomo che devia dal cammino del buon senno</para>
  <para style="q" vid="PRO 21:16">Riposerà in compagnia de' morti.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17"/>L'uomo che ama godere <char style="add">sarà</char> bisognoso;</para>
  <para style="q" vid="PRO 21:17">Chi ama il vino e l'olio non arricchirà.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18"/>L'empio <char style="add">sarà per</char> riscatto del giusto;</para>
  <para style="q" vid="PRO 21:18">E il disleale <char style="add">sarà</char> in iscambio degli <char style="add">uomini</char> diritti<note caller="*" style="x"><char style="xo" closed="false">21.18 </char><char style="xk" closed="false">diritti </char><char style="xt" closed="false"><ref loc="PRO 11:8">Prov. 11.8</ref>. <ref loc="ISA 43:3">Is. 43.3</ref>,<ref loc="ISA 43:4">4</ref>.</char></note>.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19"/>Meglio <char style="add">è</char> abitare in terra deserta,</para>
  <para style="q" vid="PRO 21:19">Che <char style="add">con</char> una moglie rissosa e stizzosa<note caller="*" style="x"><char style="xo" closed="false">21.19 </char><char style="xk" closed="false">stizzosa </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 9">9</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20"/>Nell'abitacolo del savio <char style="add">vi è</char> un tesoro di cose rare, e d'olii <char style="add">preziosi</char><note caller="*" style="x"><char style="xo" closed="false">21.20 </char><char style="xk" closed="false"><char style="add">preziosi</char> </char><char style="xt" closed="false"><ref loc="PSA 112:3">Sal. 112.3</ref>. <ref loc="MAT 25:3">Mat. 25.3</ref>,<ref loc="MAT 25:4">4</ref>.</char></note>;</para>
  <para style="q" vid="PRO 21:20">Ma l'uomo stolto dissipa <char style="add">tutto</char> ciò.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21"/>Chi va dietro a giustizia e benignità</para>
  <para style="q" vid="PRO 21:21">Troverà vita, giustizia<note caller="*" style="x"><char style="xo" closed="false">21.21 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="MAT 5:6">Mat. 5.6</ref>.</char></note>, e gloria.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22"/>Il savio sale nella città de' valenti,</para>
  <para style="q" vid="PRO 21:22">Ed abbatte la forza di essa<note caller="*" style="x"><char style="xo" closed="false">21.22 </char><char style="xk" closed="false">essa </char><char style="xt" closed="false"><ref loc="ECC 9:14">Eccl. 9.14</ref> ecc.</char></note>.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23"/>Chi guarda la sua bocca e la sua lingua</para>
  <para style="q" vid="PRO 21:23">Guarda l'anima sua d'afflizioni<note caller="*" style="x"><char style="xo" closed="false">21.23 </char><char style="xk" closed="false">afflizioni </char><char style="xt" closed="false"><ref loc="PRO 13:3">Prov. 13.3</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24"/>Il nome del superbo presuntuoso <char style="add">è:</char> schernitore;</para>
  <para style="q" vid="PRO 21:24">Egli fa <char style="add">ogni cosa</char> con furor di superbia.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25"/>Il desiderio del pigro l'uccide<note caller="*" style="x"><char style="xo" closed="false">21.25 </char><char style="xk" closed="false">uccide </char><char style="xt" closed="false"><ref loc="PRO 13:4">Prov. 13.4</ref>.</char></note>;</para>
  <para style="q" vid="PRO 21:25">Perciocchè le sue mani rifiutano di lavorare.<verse eid="PRO 21:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26"/>
    <char style="add">L'uomo dato a</char> cupidigia appetisce tuttodì;</para>
  <para style="q" vid="PRO 21:26">Ma il giusto dona, e non risparmia<note caller="*" style="x"><char style="xo" closed="false">21.26 </char><char style="xk" closed="false">risparmia </char><char style="xt" closed="false"><ref loc="PSA 37:26">Sal. 37.26</ref>; <ref loc="PSA 112:4">112.4</ref>,<ref loc="PSA 112:5">5</ref>.</char></note>.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27"/>Il sacrificio degli empi <char style="add">è</char> cosa abbominevole<note caller="*" style="x"><char style="xo" closed="false">21.27 </char><char style="xk" closed="false">abbominevole </char><char style="xt" closed="false"><ref loc="PRO 15:8">Prov. 15.8</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 21:27">Quanto più se l'offeriscono con scelleratezza!<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28"/>Il testimonio mendace perirà<note caller="*" style="x"><char style="xo" closed="false">21.28 </char><char style="xk" closed="false">perirà </char><char style="xt" closed="false"><ref loc="PRO 19:5">Prov. 19.5</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 21:28">Ma l'uomo che ascolta parlerà in perpetuo<note caller="*" style="x"><char style="xo" closed="false">21.28 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"><ref loc="PRO 12:19">Prov. 12.19</ref>.</char></note>.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29"/>L'uomo empio si rende sfacciato;</para>
  <para style="q" vid="PRO 21:29">Ma l'<char style="add">uomo</char> diritto addirizza le sue vie.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30"/>Non <char style="add">vi è</char> sapienza, nè prudenza,</para>
  <para style="q" vid="PRO 21:30">Nè consiglio, incontro al Signore<note caller="*" style="x"><char style="xo" closed="false">21.30 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="ISA 8:9">Is. 8.9</ref>,<ref loc="ISA 8:10">10</ref>. <ref loc="ACT 5:39">Fat. 5.39</ref>.</char></note>.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31"/>Il cavallo è apparecchiato per lo giorno della battaglia;</para>
  <para style="q" vid="PRO 21:31">Ma il salvare <char style="add">appartiene</char> al Signore<note caller="*" style="x"><char style="xo" closed="false">21.31 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 20:7">Sal. 20.7</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1"/>La fama <char style="add">è</char> più a pregiare che grandi ricchezze<note caller="*" style="x"><char style="xo" closed="false">22.1 </char><char style="xk" closed="false">ricchezze </char><char style="xt" closed="false"><ref loc="ECC 7:1">Eccl. 7.1</ref>.</char></note>;</para>
  <para style="q" vid="PRO 22:1">E la buona grazia più che argento, e che oro.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2"/>Il ricco e il povero si scontrano l'un l'altro;</para>
  <para style="q" vid="PRO 22:2">Il Signore <char style="add">è</char> quello che li ha fatti tutti.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3"/>L' <char style="add">uomo</char> avveduto vede il male, e si nasconde<note caller="*" style="x"><char style="xo" closed="false">22.3 </char><char style="xk" closed="false">nasconde </char><char style="xt" closed="false"><ref loc="PRO 14:16">Prov. 14.16</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 22:3">Ma gli scempi passano oltre, e ne portano pena.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4"/>Il premio della mansuetudine <char style="add">e</char> del timor del Signore</para>
  <para style="q" vid="PRO 22:4">
    <char style="add">È</char> ricchezze, e gloria, e vita<note caller="*" style="x"><char style="xo" closed="false">22.4 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PSA 112:3">Sal. 112.3</ref>. <ref loc="MAT 6:33">Mat. 6.33</ref>.</char></note>.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5"/>Spine <char style="add">e</char> lacci <char style="add">son</char> nella via del<char style="add">l'uomo</char> perverso;</para>
  <para style="q" vid="PRO 22:5">Chi guarda l'anima sua sarà lungi da queste cose.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6"/>Ammaestra il fanciullo, secondo la via ch'egli ha da tenere<note caller="*" style="x"><char style="xo" closed="false">22.6 </char><char style="xk" closed="false">tenere </char><char style="xt" closed="false"><ref loc="EPH 6:4">Efes. 6.4</ref>. <ref loc="2TI 3:15">2 Tim. 3.15</ref>.</char></note>;</para>
  <para style="q" vid="PRO 22:6">Egli non si dipartirà da essa, non pur quando sarà diventato vecchio.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7"/>Il ricco signoreggia sopra i poveri<note caller="*" style="x"><char style="xo" closed="false">22.7 </char><char style="xk" closed="false">poveri </char><char style="xt" closed="false"><ref loc="JAS 2:1-6">Giac. 2.1-6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 22:7">E chi prende in prestanza <char style="add">è</char> servo del prestatore.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8"/>Chi semina iniquità mieterà vanità<note caller="*" style="x"><char style="xo" closed="false">22.8 </char><char style="xk" closed="false">venità </char><char style="xt" closed="false"><ref loc="JOB 4:8">Giob. 4.8</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 22:8">E la verga della sua indegnazione verrà meno.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9"/>
    <char style="add">L'uomo che è</char> d'occhio benigno sarà benedetto;</para>
  <para style="q" vid="PRO 22:9">Perciocchè egli ha dato del suo pane al povero<note caller="*" style="x"><char style="xo" closed="false">22.9 </char><char style="xk" closed="false">povero </char><char style="xt" closed="false"><ref loc="PRO 19:17">Prov. 19.17</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10"/>Caccia lo schernitore, e le contese usciranno fuori<note caller="*" style="x"><char style="xo" closed="false">22.10 </char><char style="xk" closed="false">fuori </char><char style="xt" closed="false"><ref loc="GEN 21:9">Gen. 21.9</ref>,<ref loc="GEN 21:10">10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 22:10">E le liti, ed i vituperi cesseranno.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11"/>Chi ama la purità del cuore</para>
  <para style="q" vid="PRO 22:11">Avrà il re per amico, per la grazia delle sue labbra.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12"/>Gli occhi del Signore guardano <char style="add">l'uomo dotato di</char> conoscimento;</para>
  <para style="q" vid="PRO 22:12">Ma egli sovverte i fatti del disleale.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13"/>Il pigro dice: Il leone <char style="add">è</char> fuori<note caller="*" style="x"><char style="xo" closed="false">22.13 </char><char style="xk" closed="false">fuori </char><char style="xt" closed="false"><ref loc="PRO 26:13">Prov. 26.13</ref>.</char></note>;</para>
  <para style="q" vid="PRO 22:13">Io sarei ucciso per le campagne.<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14"/>La bocca delle <char style="add">donne</char> straniere<note caller="*" style="x"><char style="xo" closed="false">22.14 </char><char style="xk" closed="false">straniere </char><char style="xt" closed="false"><ref loc="PRO 2:16">Prov. 2.16</ref> </char><char style="xta" closed="false">e rif.</char></note> <char style="add">è</char> una fossa profonda;</para>
  <para style="q" vid="PRO 22:14">Colui contro a cui il Signore è indegnato vi caderà dentro<note caller="*" style="x"><char style="xo" closed="false">22.14 </char><char style="xk" closed="false">dentro </char><char style="xt" closed="false"><ref loc="ECC 7:26">Eccl. 7.26</ref>.</char></note>.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15"/>La follia <char style="add">è</char> attaccata al cuor del fanciullo;</para>
  <para style="q" vid="PRO 22:15">La verga della correzione la dilungherà da lui<note caller="*" style="x"><char style="xo" closed="false">22.15 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="PRO 13:24">Prov. 13.24</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16"/>Chi fa torto al povero, per accrescere il suo,</para>
  <para style="q" vid="PRO 22:16">E chi dona al ricco, di certo <char style="add">caderà</char> in inopia.<verse eid="PRO 22:16"/></para>
  <para style="s1">Brevi discorsi morali dei Savi su varii soggetti</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17"/>INCHINA il tuo orecchio, ed ascolta le parole de' Savi,</para>
  <para style="q" vid="PRO 22:17">E reca il tuo cuore alla dottrina.<verse eid="PRO 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18"/>Perciocchè <char style="add">ti sarà</char> cosa soave, se tu le guardi nel tuo cuore,</para>
  <para style="q" vid="PRO 22:18">E <char style="add">se</char> tutte insieme sono adattate in su le tue labbra.<verse eid="PRO 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19"/>Io te <char style="add">le</char> ho pur fatte assapere,</para>
  <para style="q" vid="PRO 22:19">Acciocchè la tua confidanza sia nel Signore.<verse eid="PRO 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20"/>Non ti ho io scritto cose eccellenti</para>
  <para style="q" vid="PRO 22:20">In consigli e in dottrina<note caller="*" style="x"><char style="xo" closed="false">22.20 </char><char style="xk" closed="false">dottrina </char><char style="xt" closed="false"><ref loc="PRO 8:6">Prov. 8.6</ref> ecc.</char></note>?<verse eid="PRO 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21"/>Per farti conoscere la certezza delle parole di verità;</para>
  <para style="q" vid="PRO 22:21">Acciocchè tu possa rispondere parole di verità a quelli che ti manderanno.<verse eid="PRO 22:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22"/>Non predare il povero, perchè egli <char style="add">è</char> povero<note caller="*" style="x"><char style="xo" closed="false">22.22 </char><char style="xk" closed="false">povero </char><char style="xt" closed="false"><ref loc="EXO 23:6">Esod. 23.6</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 22:22">E non oppressar l'afflitto nella porta;<verse eid="PRO 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23"/>Perciocchè il Signore difenderà la causa loro,</para>
  <para style="q" vid="PRO 22:23">Ed involerà l'anima di coloro che li avranno involati<note caller="*" style="x"><char style="xo" closed="false">22.23 </char><char style="xk" closed="false">involati </char><char style="xt" closed="false"><ref loc="PRO 23:11">Prov. 23.11</ref>.</char></note>.<verse eid="PRO 22:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24"/>Non accompagnarti con l'uomo collerico;</para>
  <para style="q" vid="PRO 22:24">E non andar con l'uomo iracondo;<verse eid="PRO 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25"/>Che talora tu non impari i suoi costumi,</para>
  <para style="q" vid="PRO 22:25">E non prenda un laccio all'anima tua.<verse eid="PRO 22:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26"/>Non esser di quelli che percuotono nella palma della mano,</para>
  <para style="q" vid="PRO 22:26">
    <char style="add">Nè</char> di quelli che fanno sicurtà per debiti<note caller="*" style="x"><char style="xo" closed="false">22.26 </char><char style="xk" closed="false">debiti </char><char style="xt" closed="false"><ref loc="PRO 6:1">Prov. 6.1</ref> </char><char style="xta" closed="false">e. rif.</char></note>.<verse eid="PRO 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27"/>Per qual cagione, se tu non avessi da pagare,</para>
  <para style="q" vid="PRO 22:27">Ti si torrebbe egli il letto di sotto<note caller="*" style="x"><char style="xo" closed="false">22.27 </char><char style="xk" closed="false">sotto </char><char style="xt" closed="false"><ref loc="PRO 20:16">Prov. 20.16</ref>.</char></note>?<verse eid="PRO 22:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28"/>Non rimuovere il termine antico,</para>
  <para style="q" vid="PRO 22:28">Che i tuoi padri hanno posto<note caller="*" style="x"><char style="xo" closed="false">22.28 </char><char style="xk" closed="false">posto </char><char style="xt" closed="false"><ref loc="DEU 19:14">Deut. 19.14</ref>; <ref loc="DEU 27:17">27.17</ref>. <ref loc="PRO 23:10">Prov. 23.10</ref>.</char></note>.<verse eid="PRO 22:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29"/>Hai tu mai veduto un uomo spedito nelle sue faccende?</para>
  <para style="q" vid="PRO 22:29">Un tale comparirà nel cospetto del re,</para>
  <para style="q" vid="PRO 22:29">
    <char style="add">E</char> non comparirà davanti a gente bassa.<verse eid="PRO 22:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1"/>Quando tu sederai <char style="add">a tavola</char> con alcun signore,</para>
  <para style="q" vid="PRO 23:1">Per mangiar con lui,</para>
  <para style="q" vid="PRO 23:1">Considera attentamente quello che <char style="add">sarà</char> dinanzi a te;<verse eid="PRO 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2"/>
    <char style="add">Altrimenti</char>, se tu <char style="add">sei</char> ingordo,</para>
  <para style="q" vid="PRO 23:2">Tu ti metterai un coltello alla gola.<verse eid="PRO 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3"/>Non appetire le sue delizie;</para>
  <para style="q" vid="PRO 23:3">Perciocchè sono un cibo fallace.<verse eid="PRO 23:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4"/>Non affaticarti per arricchire<note caller="*" style="x"><char style="xo" closed="false">23.4 </char><char style="xk" closed="false">arricchire </char><char style="xt" closed="false"><ref loc="PRO 28:20">Prov. 28.20</ref>. <ref loc="1TI 6:9">1 Tim. 6.9</ref>,<ref loc="1TI 6:10">10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 23:4">Rimanti della tua prudenza<note caller="*" style="x"><char style="xo" closed="false">23.4 </char><char style="xk" closed="false">prudenza </char><char style="xt" closed="false"><ref loc="PRO 3:5">Prov. 3.5</ref>. <ref loc="ROM 12:16">Rom. 12.16</ref>.</char></note>.<verse eid="PRO 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5"/>In un batter d'occhio <char style="add">le ricchezze</char> non <char style="add">sono più</char>;</para>
  <para style="q" vid="PRO 23:5">Perciocchè ad un tratto si fanno delle ale;</para>
  <para style="q" vid="PRO 23:5">
    <char style="add">E sono</char> come un'aquila, che se ne vola in aria.<verse eid="PRO 23:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6"/>Non mangiare il pan dell'uomo che è d'occhio maligno<note caller="*" style="x"><char style="xo" closed="false">23.6 </char><char style="xk" closed="false">maligno </char><char style="xt" closed="false"><ref loc="PSA 141:4">Sal. 141.4</ref>.</char></note>,</para>
  <para style="q" vid="PRO 23:6">E non appetire le sue delizie.<verse eid="PRO 23:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7"/>Perciocchè, come egli è villano nell'anima sua,</para>
  <para style="q" vid="PRO 23:7">Così egli ti dirà: Mangia, e bevi;</para>
  <para style="q" vid="PRO 23:7">Ma il cuor son non <char style="add">sarà</char> teco.<verse eid="PRO 23:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8"/>Tu vomiterai il boccone <char style="add">che ne</char> avrai mangiato,</para>
  <para style="q" vid="PRO 23:8">Ed avrai perduti i tuoi ragionamenti piacevoli.<verse eid="PRO 23:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9"/>Non parlare in presenza dello stolto;</para>
  <para style="q" vid="PRO 23:9">Perciocchè egli sprezzerà il senno de' tuoi ragionamenti<note caller="*" style="x"><char style="xo" closed="false">23.9 </char><char style="xk" closed="false">ragionamenti </char><char style="xt" closed="false"><ref loc="PRO 9:8">Prov. 9.8</ref>. <ref loc="MAT 7:6">Mat. 7.6</ref>.</char></note>.<verse eid="PRO 23:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10"/>Non rimuovere il termine antico<note caller="*" style="x"><char style="xo" closed="false">23.10 </char><char style="xk" closed="false">antico </char><char style="xt" closed="false"><ref loc="PRO 22:28">Prov. 22.28</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 23:10">E non entrare ne' campi degli orfani.<verse eid="PRO 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11"/>Perciocchè il lor riscotitore <char style="add">è</char> potente;</para>
  <para style="q" vid="PRO 23:11">Egli difenderà la causa loro contro a te<note caller="*" style="x"><char style="xo" closed="false">23.11 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PRO 22:23">Prov. 22.23</ref>.</char></note>.<verse eid="PRO 23:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12"/>Porgi il tuo cuore all'ammaestramento,</para>
  <para style="q" vid="PRO 23:12">E le tue orecchie a' detti della scienza.<verse eid="PRO 23:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13"/>Non risparmiare la correzione al fanciullo<note caller="*" style="x"><char style="xo" closed="false">23.13 </char><char style="xk" closed="false">fanciullo </char><char style="xt" closed="false"><ref loc="PRO 13:24">Prov. 13.24</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 23:13">Benchè tu lo batti con la verga, non <char style="add">però</char> morrà.<verse eid="PRO 23:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14"/>Tu lo batterai con la verga,</para>
  <para style="q" vid="PRO 23:14">E libererai l'anima sua dall'inferno<note caller="*" style="x"><char style="xo" closed="false">23.14 </char><char style="xk" closed="false">inferno </char><char style="xt" closed="false"><ref loc="1CO 5:5">1 Cor. 5.5</ref>.</char></note>.<verse eid="PRO 23:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15"/>Figliuol mio, se il tuo cuore è savio,</para>
  <para style="q" vid="PRO 23:15">Il mio cuore altresì se ne rallegrerà<note caller="*" style="x"><char style="xo" closed="false">23.15 </char><char style="xk" closed="false">rallegrerà </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 23:24">23.24</ref>,<ref loc="PRO 23:25">25</ref>. <ref loc="PRO 10:1">Prov. 10.1</ref>; <ref loc="PRO 29:3">29.3</ref>.</char></note>.<verse eid="PRO 23:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16"/>E le mie reni gioiranno,</para>
  <para style="q" vid="PRO 23:16">Quando le tue labbra parleranno cose diritte.<verse eid="PRO 23:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17"/>Il cuor tuo non porti invidia a' peccatori<note caller="*" style="x"><char style="xo" closed="false">23.17 </char><char style="xk" closed="false">peccatori </char><char style="xt" closed="false"><ref loc="PSA 37:1">Sal. 37.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 23:17">Anzi <char style="add">attienti</char> sempre al timore del Signore.<verse eid="PRO 23:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18"/>Perciocchè, se vi è premio,</para>
  <para style="q" vid="PRO 23:18">La tua speranza non sarà troncata.<verse eid="PRO 23:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19"/>Ascolta, figliuol mio, e sii savio;</para>
  <para style="q" vid="PRO 23:19">E addirizza il tuo cuore nella <char style="add">diritta</char> via<note caller="*" style="x"><char style="xo" closed="false">23.19 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="PRO 4:23">Prov. 4.23</ref>.</char></note>.<verse eid="PRO 23:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20"/>Non esser de' bevitori di vino<note caller="*" style="x"><char style="xo" closed="false">23.20 </char><char style="xk" closed="false">vino </char><char style="xt" closed="false"><ref loc="PRO 20:1">Prov. 20.1</ref> e rif. <ref loc="ISA 5:22">Is. 5.22</ref>. <ref loc="LUK 21:34">Luc. 21.34</ref>. <ref loc="ROM 13:13">Rom. 13.13</ref>.</char></note>;</para>
  <para style="q" vid="PRO 23:20">
    <char style="add">Nè</char> de' ghiotti mangiatori di carne.<verse eid="PRO 23:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21"/>Perciocchè l'ubbriaco ed il ghiotto impoveriranno<note caller="*" style="x"><char style="xo" closed="false">23.21 </char><char style="xk" closed="false">impoveriranno </char><char style="xt" closed="false"><ref loc="PRO 19:15">Prov. 19.15</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 23:21">Ed il sonnecchiare farà vestire stracci.<verse eid="PRO 23:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22"/>Ubbidisci a tuo padre<note caller="*" style="x"><char style="xo" closed="false">23.22 </char><char style="xk" closed="false">padre </char><char style="xt" closed="false"><ref loc="PRO 1:8">Prov. 1.8</ref> </char><char style="xta" closed="false">e rif.</char></note>, il qual ti ha generato;</para>
  <para style="q" vid="PRO 23:22">E non isprezzar tua madre, quando sarà divenuta vecchia.<verse eid="PRO 23:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23"/>Compera verità<note caller="*" style="x"><char style="xo" closed="false">23.23 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="PRO 4:5">Prov. 4.5</ref>,<ref loc="PRO 4:7">7</ref>. <ref loc="MAT 13:44-46">Mat. 13.44-46</ref>.</char></note>, e non vender<char style="add">la</char>,</para>
  <para style="q" vid="PRO 23:23">
    <char style="add">Compera</char> sapienza, ammaestramento, ed intendimento.<verse eid="PRO 23:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24"/>Il padre del giusto gioirà grandemente<note caller="*" style="x"><char style="xo" closed="false">23.24 </char><char style="xk" closed="false">grandemente </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 23:24">E chi avrà generato un savio, ne avrà allegrezza.<verse eid="PRO 23:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25"/>
    <char style="add">Fa</char>' che tuo padre e tua madre si rallegrino;</para>
  <para style="q" vid="PRO 23:25">E che quella che ti ha partorito gioisca.<verse eid="PRO 23:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26"/>Figliuol mio, recami il tuo cuore,</para>
  <para style="q" vid="PRO 23:26">E gli occhi tuoi guardino le mie vie.<verse eid="PRO 23:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27"/>Perciocchè la meretrice <char style="add">è</char> una fossa profonda,</para>
  <para style="q" vid="PRO 23:27">E la straniera un pozzo stretto<note caller="*" style="x"><char style="xo" closed="false">23.27 </char><char style="xk" closed="false">stretto </char><char style="xt" closed="false"><ref loc="PRO 22:14">Prov. 22.14</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 23:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28"/>Ed anche ella sta agli agguati, come un ladrone<note caller="*" style="x"><char style="xo" closed="false">23.28 </char><char style="xk" closed="false">ladrone </char><char style="xt" closed="false"><ref loc="PRO 7:12">Prov. 7.12</ref>. <ref loc="ECC 7:26">Eccl. 7.26</ref>.</char></note>;</para>
  <para style="q" vid="PRO 23:28">Ed accresce <char style="add">il numero de</char>'malfattori fra gli uomini.<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29"/>A cui <char style="add">avvengono</char> i guai? a cui i lai?</para>
  <para style="q" vid="PRO 23:29">A cui le contese? a cui i rammarichi?</para>
  <para style="q" vid="PRO 23:29">A cui le battiture senza cagione? a cui il rossore degli occhi?<verse eid="PRO 23:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30"/>A quelli che si fermano lungamente appresso il vino;</para>
  <para style="q" vid="PRO 23:30">A quelli che vanno cercando da mescere<note caller="*" style="x"><char style="xo" closed="false">23.30 </char><char style="xk" closed="false">mescere </char><char style="xt" closed="false"><ref loc="PRO 20:1">Prov. 20.1</ref> e rif. <ref loc="ISA 5:11">Is. 5.11</ref>,<ref loc="ISA 5:12">12</ref>.</char></note>.<verse eid="PRO 23:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31"/>Non riguardare il vino, quando rosseggia,</para>
  <para style="q" vid="PRO 23:31">Quando sfavilla nella coppa,</para>
  <para style="q" vid="PRO 23:31">
    <char style="add">E</char> cammina diritto.<verse eid="PRO 23:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32"/>Egli morderà alla fine come il serpente,</para>
  <para style="q" vid="PRO 23:32">E pungerà come l'aspido.<verse eid="PRO 23:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33"/>
    <char style="add">Allora</char> gli occhi tuoi vedranno cose strane,</para>
  <para style="q" vid="PRO 23:33">E il tuo cuore parlerà cose stravolte.<verse eid="PRO 23:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34"/>E tu sarai come chi giace in mezzo al mare,</para>
  <para style="q" vid="PRO 23:34">E come chi dorme in su la cima dell'albero della nave.<verse eid="PRO 23:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35"/>
    <char style="add">Tu dirai:</char> Altri mi ha battuto, ed io non ne ho sentita la doglia;</para>
  <para style="q" vid="PRO 23:35">Altri mi ha pesto, <char style="add">ed</char> io non me ne sono avveduto<note caller="*" style="x"><char style="xo" closed="false">23.35 </char><char style="xk" closed="false">avveduto </char><char style="xt" closed="false"><ref loc="EPH 4:19">Efes. 4.19</ref>.</char></note>;</para>
  <para style="q" vid="PRO 23:35">Quando mi risveglierò? io tornerò a cercarlo ancora<note caller="*" style="x"><char style="xo" closed="false">23.35 </char><char style="xk" closed="false">ancora </char><char style="xt" closed="false"><ref loc="DEU 29:19">Deut. 29.19</ref>. <ref loc="ISA 56:12">Is. 56.12</ref>.</char></note>.<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1"/>Non portare invidia agli uomini malvagi<note caller="*" style="x"><char style="xo" closed="false">24.1 </char><char style="xk" closed="false">malvagi </char><char style="xt" closed="false"><ref loc="PSA 37:1">Sal. 37.1</ref> ecc.</char></note>,</para>
  <para style="q" vid="PRO 24:1">E non desiderare di esser con loro<note caller="*" style="x"><char style="xo" closed="false">24.1 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PRO 1:15">Prov. 1.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2"/>Perciocchè il cuor loro macchina rapina,</para>
  <para style="q" vid="PRO 24:2">E le lor labbra parlano d'iniquità.<verse eid="PRO 24:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3"/>La casa sarà edificata per sapienza,</para>
  <para style="q" vid="PRO 24:3">E sarà stabilita per prudenza.<verse eid="PRO 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4"/>E per conoscimento le camere saranno ripiene</para>
  <para style="q" vid="PRO 24:4">Di beni preziosi e dilettevoli, d'ogni maniera.<verse eid="PRO 24:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5"/>L'uomo savio <char style="add">è</char> forte<note caller="*" style="x"><char style="xo" closed="false">24.5 </char><char style="xk" closed="false">forte </char><char style="xt" closed="false"><ref loc="PRO 21:22">Prov. 21.22</ref>. <ref loc="ECC 9:16">Eccl. 9.16</ref>.</char></note>;</para>
  <para style="q" vid="PRO 24:5">E l'uomo intendente è possente di forza.<verse eid="PRO 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6"/>Perciocchè con prudenti consigli tu farai la guerra<note caller="*" style="x"><char style="xo" closed="false">24.6 </char><char style="xk" closed="false">guerra </char><char style="xt" closed="false"><ref loc="PRO 11:14">Prov. 11.14</ref> e rif. <ref loc="LUK 14:31">Luc. 14.31</ref>.</char></note>;</para>
  <para style="q" vid="PRO 24:6">E la salute <char style="add">è posta</char> in moltitudine di consiglieri.<verse eid="PRO 24:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7"/>Le sapienze <char style="add">son</char> troppo alte per lo stolto<note caller="*" style="x"><char style="xo" closed="false">24.7 </char><char style="xk" closed="false">stolto </char><char style="xt" closed="false"><ref loc="PRO 14:6">Prov. 14.6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 24:7">Egli non aprirà la bocca nella porta.<verse eid="PRO 24:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8"/>Chi divisa far male</para>
  <para style="q" vid="PRO 24:8">Sarà chiamato uomo malizioso.<verse eid="PRO 24:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9"/>Il pensiero di stoltizia <char style="add">è</char> peccato;</para>
  <para style="q" vid="PRO 24:9">E lo schernitore <char style="add">è</char> l'abbominio degli uomini.<verse eid="PRO 24:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10"/>
    <char style="add">Se</char> tu ti rallenti nel giorno della distretta,</para>
  <para style="q" vid="PRO 24:10">Le tue forze <char style="add">saranno</char> corte.<verse eid="PRO 24:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11"/>Se tu ti rattieni dal riscuoter quelli che son tratti alla morte<note caller="*" style="x"><char style="xo" closed="false">24.11 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="PSA 82:4">Sal. 82.4</ref>. <ref loc="1JN 3:16">1 Giov. 3.16</ref>.</char></note>,</para>
  <para style="q" vid="PRO 24:11">E quelli che stanno in forse di essere uccisi,<verse eid="PRO 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12"/>Dicendo: Ecco noi non ne sappiamo nulla;</para>
  <para style="q" vid="PRO 24:12">Colui che pesa i cuori non <char style="add">vi</char> porrà egli mente?</para>
  <para style="q" vid="PRO 24:12">E il guardiano dell'anima tua <char style="add">non</char> lo conoscerà egli,</para>
  <para style="q" vid="PRO 24:12">E non renderà egli a ciascuno secondo le sue opere<note caller="*" style="x"><char style="xo" closed="false">24.12 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="JOB 34:11">Giob. 34.11</ref> </char><char style="xta" closed="false">e rif.</char></note>?<verse eid="PRO 24:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13"/>Figliuol mio, mangia pure del miele;</para>
  <para style="q" vid="PRO 24:13">Perciocchè <char style="add">egli è</char> buono;</para>
  <para style="q" vid="PRO 24:13">E del favo <char style="add">del miele, che è</char> dolce al tuo palato;<verse eid="PRO 24:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14"/>Tal <char style="add">sarà</char> la conoscenza della sapienza all'anima tua,</para>
  <para style="q" vid="PRO 24:14">Quando tu l'avrai trovata<note caller="*" style="x"><char style="xo" closed="false">24.14 </char><char style="xk" closed="false">trovata </char><char style="xt" closed="false"><ref loc="PSA 19:10">Sal. 19.10</ref>; <ref loc="PSA 119:103">119.103</ref>.</char></note>; e vi sarà premio,</para>
  <para style="q" vid="PRO 24:14">E la tua speranza non sarà troncata.<verse eid="PRO 24:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15"/>O empio, non insidiar l'abitacolo del giusto,</para>
  <para style="q" vid="PRO 24:15">Non guastare il suo ricetto.<verse eid="PRO 24:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16"/>Perciocchè il giusto cade sette volte, e si rileva<note caller="*" style="x"><char style="xo" closed="false">24.16 </char><char style="xk" closed="false">rileva </char><char style="xt" closed="false"><ref loc="PSA 37:24">Sal. 37.24</ref>. <ref loc="MIC 7:8">Mic. 7.8</ref>.</char></note>;</para>
  <para style="q" vid="PRO 24:16">Ma gli empi ruinano nel male<note caller="*" style="x"><char style="xo" closed="false">24.16 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="EST 7:10">Est. 7.10</ref>. <ref loc="REV 18:21">Apoc. 18.21</ref>.</char></note>.<verse eid="PRO 24:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17"/>Non rallegrarti, quando il tuo nemico sarà caduto<note caller="*" style="x"><char style="xo" closed="false">24.17 </char><char style="xk" closed="false">caduto </char><char style="xt" closed="false"><ref loc="PRO 17:5">Prov. 17.5</ref>. <ref loc="OBA 1:12">Abd. 12</ref>.</char></note>;</para>
  <para style="q" vid="PRO 24:17">E quando egli sarà ruinato, il cuor tuo non <char style="add">ne</char> gioisca;<verse eid="PRO 24:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18"/>Che talora il Signore nol vegga, e che <char style="add">ciò</char> non gli dispiaccia,</para>
  <para style="q" vid="PRO 24:18">E ch'egli non istorni l'ira sua d'addosso a lui.<verse eid="PRO 24:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19"/>Non adirarti per li maligni;</para>
  <para style="q" vid="PRO 24:19">Non portare invidia agli empi<note caller="*" style="x"><char style="xo" closed="false">24.19 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="PSA 37:1">Sal. 37.1</ref> ecc.</char></note>.<verse eid="PRO 24:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20"/>Perciocchè non vi sarà premio alcuno per lo malvagio<note caller="*" style="x"><char style="xo" closed="false">24.20 </char><char style="xk" closed="false">malvagio </char><char style="xt" closed="false"><ref loc="PSA 11:6">Sal. 11.6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 24:20">La lampana degli empi sarà spenta<note caller="*" style="x"><char style="xo" closed="false">24.20 </char><char style="xk" closed="false">spenta </char><char style="xt" closed="false"><ref loc="JOB 18:5">Giob. 18.5</ref>,<ref loc="JOB 18:6">6</ref>; <ref loc="JOB 21:17">21.17</ref>.</char></note>.<verse eid="PRO 24:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21"/>Figliuol mio, temi il Signore e il re<note caller="*" style="x"><char style="xo" closed="false">24.21 </char><char style="xk" closed="false">re </char><char style="xt" closed="false"><ref loc="ROM 13:7">Rom. 13.7</ref>. <ref loc="1PE 2:17">1 Piet. 2.17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 24:21">Non rimescolarti co' rapportatori.<verse eid="PRO 24:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22"/>Perciocchè in un momento sorgerà la loro calamità;</para>
  <para style="q" vid="PRO 24:22">E chi conosce la ruina <char style="add">procedente</char> d'amendue loro?<verse eid="PRO 24:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23"/>Queste cose ancora <char style="add">son</char> per li Savi.</para>
  <para style="b" vid="PRO 24:23"/>
  <para style="q" vid="PRO 24:23">Ei non <char style="add">è</char> bene di aver riguardo alla qualità delle persone in giudicio<note caller="*" style="x"><char style="xo" closed="false">24.23 </char><char style="xk" closed="false">giudicio </char><char style="xt" closed="false"><ref loc="PRO 18:5">Prov. 18.5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 24:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24"/>I popoli malediranno, <char style="add">e</char> le nazioni esecreranno</para>
  <para style="q" vid="PRO 24:24">Colui che dice all'empio: Tu <char style="add">sei</char> giusto<note caller="*" style="x"><char style="xo" closed="false">24.24 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="PRO 17:15">Prov. 17.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 24:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25"/>Ma quelli che lo gastigano saranno grati;</para>
  <para style="q" vid="PRO 24:25">E benedizione di bene verrà sopra loro.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26"/>Chi risponde parole diritte</para>
  <para style="q" vid="PRO 24:26">Bacia le labbra.<verse eid="PRO 24:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27"/>Ordina le tue faccende fuori,</para>
  <para style="q" vid="PRO 24:27">E mettile in assetto ne' tuoi campi;</para>
  <para style="q" vid="PRO 24:27">E poi edificherai la tua casa<note caller="*" style="x"><char style="xo" closed="false">24.27 </char><char style="xk" closed="false">casa </char><char style="xt" closed="false"><ref loc="LUK 14:28-30">Luc. 14.28-30</ref>.</char></note>.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28"/>Non essere testimonio contro al tuo prossimo senza cagione;</para>
  <para style="q" vid="PRO 24:28">E vorresti tu subornare alcuno con le tue labbra<note caller="*" style="x"><char style="xo" closed="false">24.28 </char><char style="xk" closed="false">labbra </char><char style="xt" closed="false"><ref loc="EPH 4:25">Efes. 4.25</ref>.</char></note>?<verse eid="PRO 24:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29"/>Non dire: Come egli ha fatto a me, così farò a lui;</para>
  <para style="q" vid="PRO 24:29">Io renderò a costui secondo l'opera sua<note caller="*" style="x"><char style="xo" closed="false">24.29 </char><char style="xk" closed="false">sua </char><char style="xt" closed="false"><ref loc="PRO 20:22">Prov. 20.22</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 24:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30"/>Io passai <char style="add">già</char> presso al campo del pigro,</para>
  <para style="q" vid="PRO 24:30">E presso alla vigna dell'uomo scemo di senno;<verse eid="PRO 24:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31"/>Ed ecco, <char style="add">amendue</char> erano tutti montati in ortiche,</para>
  <para style="q" vid="PRO 24:31">I cardi ne aveano coperto il disopra,</para>
  <para style="q" vid="PRO 24:31">E la lor chiusura di pietre era ruinata.<verse eid="PRO 24:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32"/>Ed io, riguardando <char style="add">ciò, vi</char> posi mente;</para>
  <para style="q" vid="PRO 24:32">Veduto<char style="add">lo, ne</char> presi ammaestramento.<verse eid="PRO 24:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33"/>Dormendo un poco<note caller="*" style="x"><char style="xo" closed="false">24.33 </char><char style="xk" closed="false">poco </char><char style="xt" closed="false"><ref loc="PRO 6:9">Prov. 6.9</ref> ecc.</char></note>, sonnecchiando un poco,</para>
  <para style="q" vid="PRO 24:33">Piegando un poco le mani per riposare;<verse eid="PRO 24:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34"/>La tua povertà verrà <char style="add">come</char> un viandante,</para>
  <para style="q" vid="PRO 24:34">E la tua inopia come uno scudiere.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">Altre sentenze di Salomone, raccolte al tempo di Ezechia</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>QUESTE ancora <char style="add">son</char> sentenze di Salomone<note caller="*" style="x"><char style="xo" closed="false">25.1 </char><char style="xk" closed="false">Salomone </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 Re. 4.32</ref>. <ref loc="PRO 1:1">Prov. 1.1</ref>; <ref loc="PRO 10:1">10.1</ref>.</char></note>, le quali gli uomini di Ezechia, re di Giuda, raccolsero.<verse eid="PRO 25:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2"/>La gloria di Dio <char style="add">è</char> di celar la cosa<note caller="*" style="x"><char style="xo" closed="false">25.2 </char><char style="xk" closed="false">cosa </char><char style="xt" closed="false"><ref loc="DEU 29:29">Deut. 29.29</ref>. <ref loc="ROM 11:33">Rom. 11.33</ref>.</char></note>;</para>
  <para style="q" vid="PRO 25:2">Ma la gloria dei re <char style="add">è</char> d'investigare la cosa<note caller="*" style="x"><char style="xo" closed="false">25.2 </char><char style="xk" closed="false">cosa </char><char style="xt" closed="false"><ref loc="JOB 29:16">Giob. 29.16</ref>.</char></note>.<verse eid="PRO 25:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3"/>L'altezza del cielo, e la profondità della terra,</para>
  <para style="q" vid="PRO 25:3">E il cuor dei re, non si possono investigare.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4"/>Togli le schiume dell'argento,</para>
  <para style="q" vid="PRO 25:4">E ne riuscirà un vaso all'orafo<note caller="*" style="x"><char style="xo" closed="false">25.4 </char><char style="xk" closed="false">orafo </char><char style="xt" closed="false"><ref loc="2TI 2:21">2 Tim. 2.21</ref>.</char></note>.<verse eid="PRO 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5"/>Rimuovi l'empio d'innanzi al re,</para>
  <para style="q" vid="PRO 25:5">E il trono di esso sarà stabilito con giustizia<note caller="*" style="x"><char style="xo" closed="false">25.5 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PRO 16:12">Prov. 16.12</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6"/>Non fare il vanaglorioso in presenza del re,</para>
  <para style="q" vid="PRO 25:6">E non istar nel luogo de' grandi;<verse eid="PRO 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7"/>Perciocchè val maglio che ti si dica: Sali qua<note caller="*" style="x"><char style="xo" closed="false">25.7 </char><char style="xk" closed="false">qua </char><char style="xt" closed="false"><ref loc="LUK 14:8-11">Luc. 14.8-11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 25:7">Che se tu fossi abbassato davanti al principe,</para>
  <para style="q" vid="PRO 25:7">Che gli occhi tuoi hanno veduto.<verse eid="PRO 25:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8"/>Non uscir subitamente alla contesa<note caller="*" style="x"><char style="xo" closed="false">25.8 </char><char style="xk" closed="false">contesa </char><char style="xt" closed="false"><ref loc="PRO 17:14">Prov. 17.14</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 25:8">Che talora alla fin d'essa tu non faccia qualche cosa,</para>
  <para style="q" vid="PRO 25:8">Quando il tuo prossimo ti avrà fatta vergogna.<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9"/>Dibatti la tua lite col tuo prossimo<note caller="*" style="x"><char style="xo" closed="false">25.9 </char><char style="xk" closed="false">prossimo </char><char style="xt" closed="false"><ref loc="MAT 5:25">Mat. 5.25</ref>,<ref loc="MAT 5:26">26</ref>; <ref loc="MAT 18:15">18.15</ref>.</char></note>;</para>
  <para style="q" vid="PRO 25:9">Ma non palesare il segreto di un altro;<verse eid="PRO 25:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10"/>Che talora chi ti ode non ti vituperi,</para>
  <para style="q" vid="PRO 25:10">E che la tua infamia non possa essere riparata.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11"/>La parola detta in modi convenevoli</para>
  <para style="q" vid="PRO 25:11">
    <char style="add">È</char> simile a pomi d'oro tra figure d'argento<note caller="*" style="x"><char style="xo" closed="false">25.11 </char><char style="xk" closed="false">argento </char><char style="xt" closed="false"><ref loc="PRO 15:23">Prov. 15.23</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 25:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12"/>Il savio riprenditore ad un orecchio ubbidiente</para>
  <para style="q" vid="PRO 25:12">
    <char style="add">È</char> un monile d'oro, ed un ornamento d'oro finissimo.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13"/>Il messo fedele <char style="add">è</char>, a quelli che lo mandano,</para>
  <para style="q" vid="PRO 25:13">Come il fresco della neve in giorno di ricolta;</para>
  <para style="q" vid="PRO 25:13">E ristora l'anima de' suoi padroni<note caller="*" style="x"><char style="xo" closed="false">25.13 </char><char style="xk" closed="false">padroni </char><char style="xt" closed="false"><ref loc="PRO 13:17">Prov. 13.17</ref>.</char></note>.<verse eid="PRO 25:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14"/>L'uomo che si gloria falsamente di liberalità<note caller="*" style="x"><char style="xo" closed="false">25.14 </char><char style="xk" closed="false">liberalità </char><char style="xt" closed="false"><ref loc="PRO 20:6">Prov. 20.6</ref>.</char></note></para>
  <para style="q" vid="PRO 25:14">
    <char style="add">È simile</char> alle nuvole, ed al vento senza pioggia.<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15"/>Il principe si piega con sofferenza<note caller="*" style="x"><char style="xo" closed="false">25.15 </char><char style="xk" closed="false">sofferenza </char><char style="xt" closed="false"><ref loc="GEN 32:3">Gen. 32.3</ref> ecc. <ref loc="1SA 25:24">1 Sam. 25.24</ref> ecc. <ref loc="PRO 15:1">Prov. 15.1</ref>; <ref loc="PRO 16:14">16.14</ref>.</char></note>,</para>
  <para style="q" vid="PRO 25:15">E la lingua dolce rompe le ossa.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16"/>
    <char style="add">Se</char> tu trovi del miele, mangia<char style="add">ne</char> quanto ti basta;</para>
  <para style="q" vid="PRO 25:16">Che talora, se tu te ne satolli, tu nol vomiti fuori.<verse eid="PRO 25:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17"/>Metti di rado il piè in casa del tuo prossimo;</para>
  <para style="q" vid="PRO 25:17">Che talora egli non si sazii di te, e ti odii.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18"/>Un uomo che dice falsa testimonianza contro al suo prossimo</para>
  <para style="q" vid="PRO 25:18">
    <char style="add">È come</char> un martello, una spada, ed una saetta acuta.<verse eid="PRO 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19"/>La confidanza che si pone nel disleale <char style="add">è</char>, in giorno di afflizione,</para>
  <para style="q" vid="PRO 25:19">Un dente rotto, ed un piè dislogato.<verse eid="PRO 25:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20"/>Chi canta canzoni presso di un cuor dolente<note caller="*" style="x"><char style="xo" closed="false">25.20 </char><char style="xk" closed="false">dolente </char><char style="xt" closed="false"><ref loc="DAN 6:18">Dan. 6.18</ref>. <ref loc="ROM 12:15">Rom. 12.15</ref>.</char></note></para>
  <para style="q" vid="PRO 25:20">
    <char style="add">È come</char> chi <char style="add">si</char> toglie la vesta <char style="add">d'addosso</char> in giorno di freddo,</para>
  <para style="q" vid="PRO 25:20">
    <char style="add">E come</char> l'aceto sopra il nitro.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21"/>Se colui che ti odia ha fame, dagli da mangiar del pane;</para>
  <para style="q" vid="PRO 25:21">E se ha sete, dagli da bere dell'acqua<note caller="*" style="x"><char style="xo" closed="false">25.21 </char><char style="xk" closed="false">acqua </char><char style="xt" closed="false"><ref loc="EXO 23:4">Esod. 23.4</ref>,<ref loc="EXO 23:5">5</ref>. <ref loc="2KI 6:22">2 Re. 6.22</ref>,<ref loc="2KI 6:23">23</ref>. <ref loc="2CH 28:15">2 Cron. 28.15</ref>. <ref loc="MAT 5:44">Mat. 5.44</ref>,<ref loc="MAT 5:45">45</ref>. <ref loc="ROM 12:20">Rom. 12.20</ref>,<ref loc="ROM 12:21">21</ref>.</char></note>;<verse eid="PRO 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22"/>Perciocchè <char style="add">così</char> tu gli metterai delle brace in su la testa;</para>
  <para style="q" vid="PRO 25:22">E il Signore te <char style="add">ne</char> farà la retribuzione.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23"/>Il vento settentrionale dissipa la pioggia;</para>
  <para style="q" vid="PRO 25:23">E il viso sdegnoso la lingua <char style="add">che sparla</char> di nascosto.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24"/>Meglio <char style="add">vale</char> abitare sopra il canto di un tetto,</para>
  <para style="q" vid="PRO 25:24">Che <char style="add">con</char> una moglie rissosa in casa comune<note caller="*" style="x"><char style="xo" closed="false">25.24 </char><char style="xk" closed="false">comune </char><char style="xt" closed="false"><ref loc="PRO 19:13">Prov. 19.13</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25"/>Una buona novella di lontan paese</para>
  <para style="q" vid="PRO 25:25">
    <char style="add">È come</char> acqua fresca alla persona stanca ed assetata<note caller="*" style="x"><char style="xo" closed="false">25.25 </char><char style="xk" closed="false">assetata </char><char style="xt" closed="false"><ref loc="PRO 15:30">Prov. 15.30</ref>.</char></note>.<verse eid="PRO 25:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26"/>Il giusto che vacilla davanti all'empio,</para>
  <para style="q" vid="PRO 25:26">
    <char style="add">È</char> una fonte calpestata, ed una vena d'acque guasta.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27"/>Il mangiar troppo miele non <char style="add">è</char> bene,</para>
  <para style="q" vid="PRO 25:27">E l'investigar <char style="add">colui che è</char> la gloria degli <char style="add">uomini è</char> cosa gloriosa.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28"/>L'uomo, il cui animo non ha ritegno alcuno<note caller="*" style="x"><char style="xo" closed="false">25.28 </char><char style="xk" closed="false">alcuno </char><char style="xt" closed="false"><ref loc="PRO 16:32">Prov. 16.32</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 25:28">
    <char style="add">È</char> una città sfasciata, senza mura.<verse eid="PRO 25:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1"/>Come la neve <char style="add">non si conviene</char> alla state,</para>
  <para style="q" vid="PRO 26:1">Nè la pioggia al tempo della ricolta<note caller="*" style="x"><char style="xo" closed="false">26.1 </char><char style="xk" closed="false">ricolta </char><char style="xt" closed="false"><ref loc="1SA 12:17">1 Sam. 12.17</ref>.</char></note>,</para>
  <para style="q" vid="PRO 26:1">Così la gloria non si conviene allo stolto.<verse eid="PRO 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2"/>Come il passero vaga, e la rondinella vola,</para>
  <para style="q" vid="PRO 26:2">Così la maledizione <char style="add">data</char> senza cagione non avverrà<note caller="*" style="x"><char style="xo" closed="false">26.2 </char><char style="xk" closed="false">avverrà </char><char style="xt" closed="false"><ref loc="NUM 23:8">Num. 23.8</ref>. <ref loc="DEU 23:5">Deut. 23.5</ref>.</char></note>.<verse eid="PRO 26:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3"/>La sferza al cavallo, ed il capestro all'asino,</para>
  <para style="q" vid="PRO 26:3">E il bastone al dosso degli stolti<note caller="*" style="x"><char style="xo" closed="false">26.3 </char><char style="xk" closed="false">stolti </char><char style="xt" closed="false"><ref loc="PRO 10:13">Prov. 10.13</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 26:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4"/>Non rispondere allo stolto secondo la sua follia;</para>
  <para style="q" vid="PRO 26:4">Che talora anche tu non gli sii agguagliato.<verse eid="PRO 26:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5"/>Rispondi allo stolto, come si conviene alla sua follia<note caller="*" style="x"><char style="xo" closed="false">26.5 </char><char style="xk" closed="false">follia </char><char style="xt" closed="false"><ref loc="MAT 16:1-4">Mat. 16.1-4</ref>; <ref loc="MAT 21:23-27">21.23-27</ref>.</char></note>;</para>
  <para style="q" vid="PRO 26:5">Che talora non gli paia d'esser savio.<verse eid="PRO 26:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6"/>Chi <char style="add">si</char> taglia i piedi <char style="add">ne</char> beve l'ingiuria;</para>
  <para style="q" vid="PRO 26:6">Così avviene a chi manda a far de' messi per uno stolto.<verse eid="PRO 26:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7"/>Lo zoppo zoppica delle sue due gambe;</para>
  <para style="q" vid="PRO 26:7">Così <char style="add">fa</char> la sentenza nella bocca degli stolti.<verse eid="PRO 26:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8"/>Chi dà gloria allo stolto</para>
  <para style="q" vid="PRO 26:8">
    <char style="add">Fa</char> come <char style="add">chi gittasse</char> una pietra preziosa in un mucchio di sassi.<verse eid="PRO 26:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9"/>La sentenza nella bocca degli stolti</para>
  <para style="q" vid="PRO 26:9">
    <char style="add">È come</char> una spina, che sia caduta in mano ad un ebbro.<verse eid="PRO 26:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10"/>I grandi tormentano ognuno,</para>
  <para style="q" vid="PRO 26:10">E prezzolano stolti, e salariano passanti.<verse eid="PRO 26:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11"/>Come il cane ritorna al suo vomito<note caller="*" style="x"><char style="xo" closed="false">26.11 </char><char style="xk" closed="false">vomito </char><char style="xt" closed="false"><ref loc="2PE 2:22">2 Piet. 2.22</ref>.</char></note>,</para>
  <para style="q" vid="PRO 26:11">
    <char style="add">Così</char> lo stolto reitera la sua follia<note caller="*" style="x"><char style="xo" closed="false">26.11 </char><char style="xk" closed="false">follia </char><char style="xt" closed="false"><ref loc="EXO 8:15">Esod. 8.15</ref>.</char></note>.<verse eid="PRO 26:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12"/>Hai tu veduto un uomo che si reputi savio<note caller="*" style="x"><char style="xo" closed="false">26.12 </char><char style="xk" closed="false">savio </char><char style="xt" closed="false"><ref loc="LUK 18:11">Luc. 18.11</ref> ecc. <ref loc="ROM 12:16">Rom. 12.16</ref>.</char></note>?</para>
  <para style="q" vid="PRO 26:12">
    <char style="add">Vi è</char> maggiore speranza d'uno stolto che di lui.<verse eid="PRO 26:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13"/>Il pigro dice: Il leopardo <char style="add">è</char> in su la strada,</para>
  <para style="q" vid="PRO 26:13">Il leone <char style="add">è</char> per le campagne<note caller="*" style="x"><char style="xo" closed="false">26.13 </char><char style="xk" closed="false">campagne </char><char style="xt" closed="false"><ref loc="PRO 22:13">Prov. 22.13</ref>.</char></note>.<verse eid="PRO 26:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14"/>
    <char style="add">Come</char> l'uscio si volge sopra i suoi arpioni,</para>
  <para style="q" vid="PRO 26:14">Così <char style="add">si volge</char> il pigro sopra il suo letto.<verse eid="PRO 26:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15"/>Il pigro nasconde la mano nel seno;</para>
  <para style="q" vid="PRO 26:15">Egli dura fatica a trarla fuori <char style="add">per recarsela</char> alla bocca<note caller="*" style="x"><char style="xo" closed="false">26.15 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="PRO 19:24">Prov. 19.24</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 26:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16"/>Al pigro par di esser savio,</para>
  <para style="q" vid="PRO 26:16">Più che sette che dànno risposte di prudenza.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17"/>Colui che passando trascorre in ira per una questione che non gli <char style="add">tocca</char>,</para>
  <para style="q" vid="PRO 26:17">
    <char style="add">È come</char> chi afferra un cane per gli orecchi.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18"/>Quale <char style="add">è</char> colui che, infingendosi di scherzare, avventa razzi,</para>
  <para style="q" vid="PRO 26:18">Saette, e cose mortifere;<verse eid="PRO 26:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19"/>Tale <char style="add">è</char> colui <char style="add">che</char> inganna il suo prossimo,</para>
  <para style="q" vid="PRO 26:19">E dice: Non ischerzo io<note caller="*" style="x"><char style="xo" closed="false">26.19 </char><char style="xk" closed="false">io </char><char style="xt" closed="false"><ref loc="EPH 5:4">Efes. 5.4</ref>.</char></note>?<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20"/>Il fuoco si spegne, quando mancano legne;</para>
  <para style="q" vid="PRO 26:20">Così le contese si acquetano, quando non vi <char style="add">son</char> rapportatori.<verse eid="PRO 26:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21"/>Il carbone <char style="add">è</char> per <char style="add">far</char> brace, e le legne per <char style="add">far</char> fuoco;</para>
  <para style="q" vid="PRO 26:21">E l'uomo rissoso per accender contese<note caller="*" style="x"><char style="xo" closed="false">26.21 </char><char style="xk" closed="false">contese </char><char style="xt" closed="false"><ref loc="PRO 15:18">Prov. 15.18</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 26:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22"/>Le parole del rapportatore paiono lusinghevoli;</para>
  <para style="q" vid="PRO 26:22">Ma scendono fin dentro al ventre.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23"/>Le labbra ardenti, e il cuor malvagio,</para>
  <para style="q" vid="PRO 26:23">
    <char style="add">Son come</char> schiuma d'argento impiastrata sopra un testo.<verse eid="PRO 26:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24"/>Chi odia s'infinge nel suo parlare,</para>
  <para style="q" vid="PRO 26:24">Ma cova la frode nel suo interiore;<verse eid="PRO 26:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25"/>Quando egli parlerà di una voce graziosa, non fidartici;</para>
  <para style="q" vid="PRO 26:25">Perciocch<char style="add">è</char> egli ha sette scelleratezze nel cuore.<verse eid="PRO 26:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26"/>L'odio si copre con inganno;</para>
  <para style="q" vid="PRO 26:26">
    <char style="add">Ma</char> la sua malignità sarà palesata in piena raunanza.<verse eid="PRO 26:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27"/>Chi cava una fossa caderà in essa;</para>
  <para style="q" vid="PRO 26:27">E se alcuno rotola una pietra ad alto, ella gli tornerà addosso<note caller="*" style="x"><char style="xo" closed="false">26.27 </char><char style="xk" closed="false">addosso </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 26:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28"/>La lingua bugiarda odia quelli ch'ella ha fiaccati;</para>
  <para style="q" vid="PRO 26:28">E la bocca lusinghiera produce ruina.<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1"/>Non gloriarti del giorno di domani;</para>
  <para style="q" vid="PRO 27:1">Perciocchè tu non sai ciò che il giorno partorirà<note caller="*" style="x"><char style="xo" closed="false">27.1 </char><char style="xk" closed="false">partorirà </char><char style="xt" closed="false"><ref loc="LUK 12:19">Luc. 12.19</ref>,<ref loc="LUK 12:20">20</ref>. <ref loc="JAS 4:13">Giac. 4.13</ref> ecc.</char></note>.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2"/>Loditi lo strano, e non la tua propria bocca<note caller="*" style="x"><char style="xo" closed="false">27.2 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="2CO 10:12">2 Cor. 10.12</ref>; <ref loc="2CO 12:11">12.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 27:2">Lo straniero, e non le tue proprie labbra.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3"/>Le pietre <char style="add">son</char> pesanti, e la rena <char style="add">è</char> grave;</para>
  <para style="q" vid="PRO 27:3">Ma l'ira dello stolto <char style="add">è</char> più pesante che amendue quelle cose<note caller="*" style="x"><char style="xo" closed="false">27.3 </char><char style="xk" closed="false">cose </char><char style="xt" closed="false"><ref loc="PRO 17:12">Prov. 17.12</ref>.</char></note>.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4"/>La collera <char style="add">è</char> una cosa crudele, e l'ira una cosa strabocchevole;</para>
  <para style="q" vid="PRO 27:4">E chi potrà durar davanti alla gelosia<note caller="*" style="x"><char style="xo" closed="false">27.4 </char><char style="xk" closed="false">gelosia </char><char style="xt" closed="false"><ref loc="1JN 3:12">1 Giov. 3.12</ref>.</char></note>?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5"/>Meglio vale riprensione palese<note caller="*" style="x"><char style="xo" closed="false">27.5 </char><char style="xk" closed="false">palese </char><char style="xt" closed="false"><ref loc="PRO 28:23">Prov. 28.23</ref>. <ref loc="GAL 2:14">Gal. 2.14</ref>.</char></note>,</para>
  <para style="q" vid="PRO 27:5">Che amore occulto.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6"/>Le ferite di chi ama <char style="add">son</char> leali<note caller="*" style="x"><char style="xo" closed="false">27.6 </char><char style="xk" closed="false">leali </char><char style="xt" closed="false"><ref loc="PSA 141:5">Sal. 141.5</ref>.</char></note>;</para>
  <para style="q" vid="PRO 27:6">Ma i baci di chi odia <char style="add">sono</char> simulati.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7"/>La persona satolla calca il favo <char style="add">del miele</char>;</para>
  <para style="q" vid="PRO 27:7">Ma alla persona affamata ogni cosa amara <char style="add">è</char> dolce.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8"/>Quale <char style="add">è</char> l'uccelletto, che va ramingo fuor del suo nido,</para>
  <para style="q" vid="PRO 27:8">Tale <char style="add">è</char> l'uomo che va vagando fuor del suo luogo.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9"/>L'olio odorifero <char style="add">e</char> il profumo rallegrano il cuore;</para>
  <para style="q" vid="PRO 27:9">Così <char style="add">fa</char> la dolcezza dell'amico dell'uomo per consiglio cordiale.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10"/>Non lasciare il tuo amico, nè l'amico di tuo padre;</para>
  <para style="q" vid="PRO 27:10">E non entrare in casa del tuo fratello nel giorno della tua calamità;</para>
  <para style="q" vid="PRO 27:10">Meglio <char style="add">vale</char> un vicino presso<note caller="*" style="x"><char style="xo" closed="false">27.10 </char><char style="xk" closed="false">presso </char><char style="xt" closed="false"><ref loc="PRO 17:17">Prov. 17.17</ref> </char><char style="xta" closed="false">e rif.</char></note>, che un fratello lontano.<verse eid="PRO 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11"/>Figliuol mio, sii savio, e rallegra il mio cuore<note caller="*" style="x"><char style="xo" closed="false">27.11 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref>; <ref loc="PRO 23:15">23.15</ref>,<ref loc="PRO 23:24">24</ref>.</char></note>;</para>
  <para style="q" vid="PRO 27:11">Ed io avrò che rispondere a colui che mi farà vituperio<note caller="*" style="x"><char style="xo" closed="false">27.11 </char><char style="xk" closed="false">vituperio </char><char style="xt" closed="false"><ref loc="PSA 127:5">Sal. 127.5</ref>.</char></note>.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12"/>L' <char style="add">uomo</char> avveduto, veggendo il male, si nasconde<note caller="*" style="x"><char style="xo" closed="false">27.12 </char><char style="xk" closed="false">nasconde </char><char style="xt" closed="false"><ref loc="PRO 22:3">Prov. 22.3</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 27:12">
    <char style="add">Ma</char> gli scempi passano oltre, e ne portano la pena.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13"/>Prendi pure il vestimento di chi ha fatta sicurtà per lo strano;</para>
  <para style="q" vid="PRO 27:13">E prendi pegno da lui per la straniera<note caller="*" style="x"><char style="xo" closed="false">27.13 </char><char style="xk" closed="false">straniera </char><char style="xt" closed="false"><ref loc="EXO 22:26">Esod. 22.26</ref>. <ref loc="PRO 20:16">Prov. 20.16</ref>.</char></note>.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14"/>Chi benedice il suo prossimo ad alta voce,</para>
  <para style="q" vid="PRO 27:14">Levandosi la mattina a buon'ora,</para>
  <para style="q" vid="PRO 27:14">
    <char style="add">Ciò</char> gli sarà reputato in maledizione.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15"/>Un gocciolar continuo in giorno di gran pioggia,</para>
  <para style="q" vid="PRO 27:15">E una donna rissosa, è tutt'uno<note caller="*" style="x"><char style="xo" closed="false">27.15 </char><char style="xk" closed="false">uno </char><char style="xt" closed="false"><ref loc="PRO 19:13">Prov. 19.13</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 27:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16"/>Chi vuol tenerla serrata, pubblica di <char style="add">voler</char> serrar del vento,</para>
  <para style="q" vid="PRO 27:16">E dell'olio nella sua man destra.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17"/>Il ferro si pulisce col ferro;</para>
  <para style="q" vid="PRO 27:17">Così l'uomo pulisce la faccia del suo prossimo.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18"/>Chi guarda il fico ne mangia il frutto<note caller="*" style="x"><char style="xo" closed="false">27.18 </char><char style="xk" closed="false">frutto </char><char style="xt" closed="false"><ref loc="1CO 9:7">1 Cor. 9.7</ref>,<ref loc="1CO 9:13">13</ref>.</char></note>;</para>
  <para style="q" vid="PRO 27:18">Così chi guarda il suo signore sarà onorato.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19"/>Come l'acqua <char style="add">rappresenta</char> la faccia alla faccia;</para>
  <para style="q" vid="PRO 27:19">Così il cuor dell'uomo <char style="add">rappresenta l'uomo</char> all'uomo.<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20"/>Il sepolcro, e il luogo della perdizione, non son giammai satolli<note caller="*" style="x"><char style="xo" closed="false">27.20 </char><char style="xk" closed="false">satolli </char><char style="xt" closed="false"><ref loc="PRO 30:16">Prov. 30.16</ref>. <ref loc="HAB 2:5">Abac. 2.5</ref>.</char></note>;</para>
  <para style="q" vid="PRO 27:20">Così anche giammai non si saziano gli occhi dell'uomo<note caller="*" style="x"><char style="xo" closed="false">27.20 </char><char style="xk" closed="false">uomo </char><char style="xt" closed="false"><ref loc="ECC 1:8">Eccl. 1.8</ref>; <ref loc="ECC 4:8">4.8</ref>; <ref loc="ECC 6:7">6.7</ref>.</char></note>.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21"/>La coppella <char style="add">è</char> per l'argento, e il fornello per l'oro<note caller="*" style="x"><char style="xo" closed="false">27.21 </char><char style="xk" closed="false">oro </char><char style="xt" closed="false"><ref loc="PRO 17:3">Prov. 17.3</ref>.</char></note>;</para>
  <para style="q" vid="PRO 27:21">Ma l'uomo <char style="add">è provato</char> per la bocca che lo loda<note caller="*" style="x"><char style="xo" closed="false">27.21 </char><char style="xk" closed="false">loda </char><char style="xt" closed="false"><ref loc="LUK 6:26">Luc. 6.26</ref>.</char></note>.<verse eid="PRO 27:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22"/>Avvegnachè tu pestassi lo stolto in un mortaio,</para>
  <para style="q" vid="PRO 27:22">Col pestello, per mezzo del grano infranto,</para>
  <para style="q" vid="PRO 27:22">La sua follia non si dipartirebbe però da lui<note caller="*" style="x"><char style="xo" closed="false">27.22 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="ISA 1:5">Is. 1.5</ref>. <ref loc="JER 5:3">Ger. 5.3</ref>.</char></note>.<verse eid="PRO 27:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23"/>Abbi diligentemente cura delle tue pecore,</para>
  <para style="q" vid="PRO 27:23">Metti il cuor tuo alle mandre.<verse eid="PRO 27:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24"/>Perciocchè i tesori non <char style="add">durano</char> in perpetuo;</para>
  <para style="q" vid="PRO 27:24">E la corona <char style="add">è ella</char> per ogni età?<verse eid="PRO 27:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25"/>Il fieno nasce, e l'erbaggio spunta,</para>
  <para style="q" vid="PRO 27:25">E le erbe de' monti son raccolte<note caller="*" style="x"><char style="xo" closed="false">27.25 </char><char style="xk" closed="false">raccolte </char><char style="xt" closed="false"><ref loc="GEN 1:11">Gen. 1.11</ref>. <ref loc="PSA 104:14">Sal. 104.14</ref>.</char></note>.<verse eid="PRO 27:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26"/>Gli agnelli <char style="add">son</char> per lo tuo vestire,</para>
  <para style="q" vid="PRO 27:26">E i becchi <char style="add">sono</char> il prezzo di un campo.<verse eid="PRO 27:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27"/>E l'abbondanza del latte delle capre è per tuo cibo,</para>
  <para style="q" vid="PRO 27:27">
    <char style="add">E</char> per cibo di casa tua,</para>
  <para style="q" vid="PRO 27:27">E per lo vitto delle tue serventi.<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1"/>Gli empi fuggono, senza che alcuno li perseguiti<note caller="*" style="x"><char style="xo" closed="false">28.1 </char><char style="xk" closed="false">perseguiti </char><char style="xt" closed="false"><ref loc="LEV 26:17">Lev. 26.17</ref>,<ref loc="LEV 26:36">36</ref>. <ref loc="PSA 53:5">Sal. 53.5</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:1">Ma i giusti stanno sicuri, come un leoncello.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2"/>
    <char style="add">Come</char> il paese, per li suoi misfatti, cangia spesso di principe<note caller="*" style="x"><char style="xo" closed="false">28.2 </char><char style="xk" closed="false">principe </char><char style="xt" closed="false"><ref loc="1KI 16:8-28">1 Re. 16.8-28</ref>. <ref loc="2KI 15:8-15">2 Re. 15.8-15</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:2">Così, per amor degli uomini savi ed intendenti,</para>
  <para style="q" vid="PRO 28:2">
    <char style="add">Il principe</char> vive lungamente.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3"/>L'uomo povero, che oppressa i miseri<note caller="*" style="x"><char style="xo" closed="false">28.3 </char><char style="xk" closed="false">miseri </char><char style="xt" closed="false"><ref loc="MAT 18:28">Mat. 18.28</ref> ecc.</char></note>,</para>
  <para style="q" vid="PRO 28:3">
    <char style="add">È come</char> una pioggia strabocchevole, che fa che non vi è del pane.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4"/>Coloro che lasciano la Legge lodano gli empi<note caller="*" style="x"><char style="xo" closed="false">28.4 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="PSA 10:3">Sal. 10.3</ref>. <ref loc="ROM 1:32">Rom. 1.32</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:4">Ma coloro che la guardano fanno loro la guerra<note caller="*" style="x"><char style="xo" closed="false">28.4 </char><char style="xk" closed="false">guerra </char><char style="xt" closed="false"><ref loc="1KI 18:18">1 Re. 18.18</ref>,<ref loc="1KI 18:21">21</ref>. <ref loc="MAT 3:7">Mat. 3.7</ref>; <ref loc="MAT 14:4">14.4</ref>. <ref loc="EPH 5:11">Efes. 5.11</ref>.</char></note>.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5"/>Gli uomini dati al male non intendono la dirittura;</para>
  <para style="q" vid="PRO 28:5">Ma quelli che cercano il Signore intendono ogni cosa<note caller="*" style="x"><char style="xo" closed="false">28.5 </char><char style="xk" closed="false">cosa </char><char style="xt" closed="false"><ref loc="JHN 7:17">Giov. 7.17</ref>. <ref loc="1CO 2:14">1 Cor. 2.14</ref>,<ref loc="1CO 2:15">15</ref>. <ref loc="1JN 2:20">1 Giov. 2.20</ref>,<ref loc="1JN 2:27">27</ref>.</char></note>.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6"/>Meglio <char style="add">vale</char> il povero che cammina nella sua integrità,</para>
  <para style="q" vid="PRO 28:6">Che il perverso <char style="add">che cammina</char> per due vie, benchè egli <char style="add">sia</char> ricco<note caller="*" style="x"><char style="xo" closed="false">28.6 </char><char style="xk" closed="false">ricco </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 18">18</ref>. <ref loc="PRO 19:1">Prov. 19.1</ref>.</char></note>.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7"/>Chi guarda la Legge <char style="add">è</char> figliuolo intendente;</para>
  <para style="q" vid="PRO 28:7">Ma chi è compagno de' ghiottoni fa vergogna a suo padre.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8"/>Chi accresce i suoi beni con usura e con interesse,</para>
  <para style="q" vid="PRO 28:8">Li aduna per colui che dona a' poveri<note caller="*" style="x"><char style="xo" closed="false">28.8 </char><char style="xk" closed="false">poveri </char><char style="xt" closed="false"><ref loc="JOB 27:13-17">Giob. 27.13-17</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9"/>Chi rivolge indietro l'orecchio, per non udir la Legge,</para>
  <para style="q" vid="PRO 28:9">La sua orazione altresì <char style="add">sarà</char> in abbominio<note caller="*" style="x"><char style="xo" closed="false">28.9 </char><char style="xk" closed="false">abbominio </char><char style="xt" closed="false"><ref loc="PRO 15:8">Prov. 15.8</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10"/>Chi travia gli <char style="add">uomini</char> diritti per via cattiva.</para>
  <para style="q" vid="PRO 28:10">Caderà egli stesso nella sua fossa<note caller="*" style="x"><char style="xo" closed="false">28.10 </char><char style="xk" closed="false">fossa </char><char style="xt" closed="false"><ref loc="PRO 26:27">Prov. 26.27</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 28:10">Ma gli <char style="add">uomini</char> intieri erederanno il bene<note caller="*" style="x"><char style="xo" closed="false">28.10 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="MAT 6:33">Mat. 6.33</ref>.</char></note>.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11"/>Il ricco si reputa savio;</para>
  <para style="q" vid="PRO 28:11">Ma il povero intendente l'esamina.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12"/>Quando i giusti trionfano, la gloria <char style="add">è</char> grande;</para>
  <para style="q" vid="PRO 28:12">Ma quando gli empi sorgono, gli uomini son ricercati<note caller="*" style="x"><char style="xo" closed="false">28.12 </char><char style="xk" closed="false">ricercati </char><char style="xt" closed="false"><ref loc="PRO 11:10">Prov. 11.10</ref> e rif.; <ref loc="PRO 29:2">29.2</ref>.</char></note>.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13"/>Chi copre i suoi misfatti non prospererà;</para>
  <para style="q" vid="PRO 28:13">Ma chi <char style="add">li</char> confessa, e <char style="add">li</char> lascia, otterrà misericordia<note caller="*" style="x"><char style="xo" closed="false">28.13 </char><char style="xk" closed="false">misericordia </char><char style="xt" closed="false"><ref loc="PSA 32:3">Sal. 32.3</ref>,<ref loc="PSA 32:5">5</ref>. <ref loc="1JN 1:8-10">1 Giov. 1.8-10</ref>.</char></note>.<verse eid="PRO 28:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14"/>Beato l'uomo che si spaventa del continuo<note caller="*" style="x"><char style="xo" closed="false">28.14 </char><char style="xk" closed="false">continuo </char><char style="xt" closed="false"><ref loc="PSA 16:8">Sal. 16.8</ref>. <ref loc="PRO 23:17">Prov. 23.17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:14">Ma chi indura il suo cuore caderà nel male<note caller="*" style="x"><char style="xo" closed="false">28.14 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="ROM 2:5">Rom. 2.5</ref>; <ref loc="ROM 11:20">11.20</ref>.</char></note>.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15"/>Un signore empio, <char style="add">che signoreggia</char> sopra un popolo povero<note caller="*" style="x"><char style="xo" closed="false">28.15 </char><char style="xk" closed="false">povero </char><char style="xt" closed="false"><ref loc="EXO 1:14">Esod. 1.14</ref> ecc. <ref loc="MAT 2:16">Mat. 2.16</ref>.</char></note>,</para>
  <para style="q" vid="PRO 28:15">
    <char style="add">È</char> un leon ruggente, ed un orso affamato.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16"/>Un rettore privo di ogni prudenza fa anche molte storsioni;</para>
  <para style="q" vid="PRO 28:16">
    <char style="add">Ma</char> quel che odia l'avarizia prolungherà i <char style="add">suoi</char> giorni.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17"/>L'uomo che fa violenza nel sangue alle persone,</para>
  <para style="q" vid="PRO 28:17">Fuggirà fino alla fossa, e niuno lo potrà sostenere<note caller="*" style="x"><char style="xo" closed="false">28.17 </char><char style="xk" closed="false">sostenere </char><char style="xt" closed="false"><ref loc="GEN 9:6">Gen. 9.6</ref>. <ref loc="EXO 21:14">Esod. 21.14</ref>.</char></note>.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18"/>Chi cammina in integrità sarà salvo<note caller="*" style="x"><char style="xo" closed="false">28.18 </char><char style="xk" closed="false">salvo </char><char style="xt" closed="false"><ref loc="PRO 10:9">Prov. 10.9</ref>,<ref loc="PRO 10:25">25</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 28:18">Ma il perverso, <char style="add">che cammina</char> per due vie, caderà in un tratto.<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19"/>Chi lavora la sua terra sarà saziato di pane<note caller="*" style="x"><char style="xo" closed="false">28.19 </char><char style="xk" closed="false">pane </char><char style="xt" closed="false"><ref loc="PRO 12:11">Prov. 12.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:19">Ma chi va dietro agli uomini da nulla sarà saziato di povertà.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20"/>L'uomo leale <char style="add">avrà</char> molte benedizioni;</para>
  <para style="q" vid="PRO 28:20">Ma chi si affretta di arricchire non sarà tenuto innocente<note caller="*" style="x"><char style="xo" closed="false">28.20 </char><char style="xk" closed="false">innocente </char><char style="xt" closed="false"><ref loc="PRO 13:11">Prov. 13.11</ref> e rif. <ref loc="1TI 6:9">1 Tim. 6.9</ref>.</char></note>.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21"/>
    <char style="add">Egli</char> non <char style="add">è</char> bene di aver riguardo alla qualità delle persone<note caller="*" style="x"><char style="xo" closed="false">28.21 </char><char style="xk" closed="false">persone </char><char style="xt" closed="false"><ref loc="PRO 18:5">Prov. 18.5</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 28:21">E per un boccon di pane l'uomo commette misfatto.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22"/>Chi si affretta di arricchire <char style="add">è</char> uomo d'occhio maligno,</para>
  <para style="q" vid="PRO 28:22">E non sa che povertà gli avverrà.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23"/>Chi riprende alcuno <char style="add">ne</char> avrà in fine maggior grazia</para>
  <para style="q" vid="PRO 28:23">Che chi lo lusinga con la lingua<note caller="*" style="x"><char style="xo" closed="false">28.23 </char><char style="xk" closed="false">lingua </char><char style="xt" closed="false"><ref loc="PRO 27:5">Prov. 27.5</ref>,<ref loc="PRO 27:6">6</ref> e rif.; <ref loc="PRO 29:5">29.5</ref>.</char></note>.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24"/>Chi ruba suo padre e sua madre,</para>
  <para style="q" vid="PRO 28:24">E dice: Non <char style="add">vi è</char> misfatto alcuno,</para>
  <para style="q" vid="PRO 28:24">
    <char style="add">È</char> compagno del ladrone.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25"/>Chi ha l'animo gonfio muove contese<note caller="*" style="x"><char style="xo" closed="false">28.25 </char><char style="xk" closed="false">contese </char><char style="xt" closed="false"><ref loc="PRO 13:10">Prov. 13.10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:25">Ma chi si confida nel Signore sarà ingrassato<note caller="*" style="x"><char style="xo" closed="false">28.25 </char><char style="xk" closed="false">ingrassato </char><char style="xt" closed="false"><ref loc="1TI 6:6">1 Tim. 6.6</ref>.</char></note>.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26"/>Chi si confida nel suo cuore è stolto<note caller="*" style="x"><char style="xo" closed="false">28.26 </char><char style="xk" closed="false">stolto </char><char style="xt" closed="false"><ref loc="JER 17:9">Ger. 17.9</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:26">Ma chi cammina in sapienza scamperà.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27"/>Chi dona al povero non <char style="add">avrà</char> alcun bisogno<note caller="*" style="x"><char style="xo" closed="false">28.27 </char><char style="xk" closed="false">bisogno </char><char style="xt" closed="false"><ref loc="PRO 19:17">Prov. 19.17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 28:27">Ma chi nasconde gli occhi <char style="add">da esso</char> avrà molte maledizioni<note caller="*" style="x"><char style="xo" closed="false">28.27 </char><char style="xk" closed="false">maledizioni </char><char style="xt" closed="false"><ref loc="PRO 29:7">Prov. 29.7</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28"/>Quando gli empi sorgono, gli uomini si nascondono<note caller="*" style="x"><char style="xo" closed="false">28.28 </char><char style="xk" closed="false">nascondono </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 12">12</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 28:28">Ma quando periscono, i giusti moltiplicano.<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1"/>L'uomo, il quale, essendo spesso ripreso, indura il suo collo,</para>
  <para style="q" vid="PRO 29:1">Di subito sarà fiaccato, senza rimedio<note caller="*" style="x"><char style="xo" closed="false">29.1 </char><char style="xk" closed="false">rimedio </char><char style="xt" closed="false"><ref loc="1SA 2:25">1 Sam. 2.25</ref>. <ref loc="2CH 36:16">2 Cron. 36.16</ref>. <ref loc="PRO 1:24-27">Prov. 1.24-27</ref>.</char></note>.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2"/>Quando i giusti sono aggranditi, il popolo si rallegra;</para>
  <para style="q" vid="PRO 29:2">Ma quando gli empi signoreggiano, il popolo geme<note caller="*" style="x"><char style="xo" closed="false">29.2 </char><char style="xk" closed="false">geme </char><char style="xt" closed="false"><ref loc="PRO 28:12">Prov. 28.12</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3"/>L'uomo, che ama sapienza, rallegra suo padre<note caller="*" style="x"><char style="xo" closed="false">29.3 </char><char style="xk" closed="false">padre </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 29:3">Ma il compagno delle meretrici dissipa i <char style="add">suoi</char> beni<note caller="*" style="x"><char style="xo" closed="false">29.3 </char><char style="xk" closed="false">beni </char><char style="xt" closed="false"><ref loc="PRO 5:9">Prov. 5.9</ref>,<ref loc="PRO 5:10">10</ref>; <ref loc="PRO 6:26">6.26</ref>. <ref loc="LUK 15:13">Luc. 15.13</ref> ecc.</char></note>.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4"/>Il re mantiene il paese con dirittura;</para>
  <para style="q" vid="PRO 29:4">Ma chi è dato a' presenti lo distrugge.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5"/>L'uomo che lusinga il suo prossimo,</para>
  <para style="q" vid="PRO 29:5">Tende una rete davanti a' passi di esso<note caller="*" style="x"><char style="xo" closed="false">29.5 </char><char style="xk" closed="false">esso </char><char style="xt" closed="false"><ref loc="PRO 28:23">Prov. 28.23</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6"/>Nel misfatto dell'uomo malvagio <char style="add">vi è</char> un laccio;</para>
  <para style="q" vid="PRO 29:6">Ma il giusto canterà, e si rallegrerà.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7"/>Il giusto prende conoscenza della causa de' miseri<note caller="*" style="x"><char style="xo" closed="false">29.7 </char><char style="xk" closed="false">miseri </char><char style="xt" closed="false"><ref loc="JOB 29:16">Giob. 29.16</ref>. <ref loc="PSA 41:1">Sal. 41.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 29:7">
    <char style="add">Ma</char> l'empio non intende alcun conoscimento.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8"/>Gli uomini schernitori allacciano la città<note caller="*" style="x"><char style="xo" closed="false">29.8 </char><char style="xk" closed="false">città </char><char style="xt" closed="false"><ref loc="PRO 11:11">Prov. 11.11</ref>.</char></note>;</para>
  <para style="q" vid="PRO 29:8">Ma i savi stornano l'ira.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9"/>L'uomo savio che litiga con un uomo stolto,</para>
  <para style="q" vid="PRO 29:9">Or si adira, or ride, e non <char style="add">ha</char> alcuna requie.<verse eid="PRO 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10"/>Gli uomini di sangue odiano l'<char style="add">uomo</char> intiero<note caller="*" style="x"><char style="xo" closed="false">29.10 </char><char style="xk" closed="false">intiero </char><char style="xt" closed="false"><ref loc="GEN 4:5-8">Gen. 4.5-8</ref>. <ref loc="1JN 3:12">1 Giov. 3.12</ref>.</char></note>;</para>
  <para style="q" vid="PRO 29:10">Ma gli <char style="add">uomini</char> diritti hanno cura della vita di esso.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11"/>Lo stolto sfoga tutta la sua ira;</para>
  <para style="q" vid="PRO 29:11">Ma il savio <char style="add">la</char> racqueta <char style="add">e la rattiene</char> indietro.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12"/>Tutti i ministri del principe,</para>
  <para style="q" vid="PRO 29:12">Che attende a parole di menzogna, <char style="add">sono</char> empi.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13"/>Il povero e l'usuraio si scontrano l'un l'altro<note caller="*" style="x"><char style="xo" closed="false">29.13 </char><char style="xk" closed="false">altro </char><char style="xt" closed="false"><ref loc="PRO 22:2">Prov. 22.2</ref>.</char></note>;</para>
  <para style="q" vid="PRO 29:13">Il Signore <char style="add">è</char> quello che allumina gli occhi di amendue<note caller="*" style="x"><char style="xo" closed="false">29.13 </char><char style="xk" closed="false">amendue </char><char style="xt" closed="false"><ref loc="MAT 5:45">Mat. 5.45</ref>.</char></note>.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14"/>Il trono del re, che fa ragione a' miseri in verità<note caller="*" style="x"><char style="xo" closed="false">29.14 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="PSA 72:2">Sal. 72.2</ref> ecc. <ref loc="PRO 20:28">Prov. 20.28</ref>.</char></note>,</para>
  <para style="q" vid="PRO 29:14">Sarà stabilito in perpetuo.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15"/>La verga e la correzione dànno sapienza<note caller="*" style="x"><char style="xo" closed="false">29.15 </char><char style="xk" closed="false">sapienza </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 17">17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 29:15">Ma il fanciullo lasciato in abbandono fa vergogna a sua madre<note caller="*" style="x"><char style="xo" closed="false">29.15 </char><char style="xk" closed="false">madre </char><char style="xt" closed="false"><ref loc="PRO 10:1">Prov. 10.1</ref>; <ref loc="PRO 17:25">17.25</ref>.</char></note>.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16"/>Quando gli empi crescono, cresce il misfatto;</para>
  <para style="q" vid="PRO 29:16">Ma i giusti vedranno la ruina di quelli<note caller="*" style="x"><char style="xo" closed="false">29.16 </char><char style="xk" closed="false">quelli </char><char style="xt" closed="false"><ref loc="PSA 37:36">Sal. 37.36</ref>; <ref loc="PSA 91:8">91.8</ref>; <ref loc="PSA 92:11">92.11</ref>.</char></note>.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17"/>Gastiga il tuo figliuolo<note caller="*" style="x"><char style="xo" closed="false">29.17 </char><char style="xk" closed="false">figliuolo </char><char style="xt" closed="false"><ref loc="PRO 13:24">Prov. 13.24</ref> </char><char style="xta" closed="false">e rif.</char></note>, e tu ne sarai in riposo;</para>
  <para style="q" vid="PRO 29:17">Ed egli darà di gran diletti all'anima tua.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18"/>Quando non <char style="add">vi è</char> visione<note caller="*" style="x"><char style="xo" closed="false">29.18 </char><char style="xk" closed="false">visione </char><char style="xt" closed="false"><ref loc="1SA 3:1">1 Sam. 3.1</ref>. <ref loc="AMO 8:11">Am. 8.11</ref>,<ref loc="AMO 8:12">12</ref>.</char></note>, il popolo è dissipato;</para>
  <para style="q" vid="PRO 29:18">Ma beato chi guarda la Legge<note caller="*" style="x"><char style="xo" closed="false">29.18 </char><char style="xk" closed="false">Legge </char><char style="xt" closed="false"><ref loc="JHN 13:17">Giov. 13.17</ref>. <ref loc="JAS 1:25">Giac. 1.25</ref>.</char></note>.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19"/>Il servo non si corregge con parole;</para>
  <para style="q" vid="PRO 29:19">Benchè intenda, non però risponderà.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20"/>Hai tu <char style="add">mai</char> veduto un uomo precipitoso nel suo parlare?</para>
  <para style="q" vid="PRO 29:20">
    <char style="add">Vi è</char> maggiore speranza d'uno stolto che di lui<note caller="*" style="x"><char style="xo" closed="false">29.20 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="PRO 26:12">Prov. 26.12</ref>.</char></note>.<verse eid="PRO 29:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21"/>Se alcuno alleva delicatamente da fanciullo il suo servo,</para>
  <para style="q" vid="PRO 29:21">Quello sarà figliuolo alla fine.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22"/>L'uomo iracondo muove contese<note caller="*" style="x"><char style="xo" closed="false">29.22 </char><char style="xk" closed="false">contese </char><char style="xt" closed="false"><ref loc="PRO 15:18">Prov. 15.18</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PRO 29:22">E l'uomo collerico <char style="add">commette</char> molti misfatti.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23"/>L'alterezza dell'uomo l'abbassa<note caller="*" style="x"><char style="xo" closed="false">29.23 </char><char style="xk" closed="false">abbassa </char><char style="xt" closed="false"><ref loc="JOB 22:29">Giob. 22.29</ref> e rif. <ref loc="PRO 15:33">Prov. 15.33</ref>; <ref loc="PRO 18:12">18.12</ref>. <ref loc="DAN 4:30">Dan. 4.30</ref> ecc. <ref loc="MAT 23:12">Mat. 23.12</ref>. <ref loc="LUK 18:14">Luc. 18.14</ref>. <ref loc="ACT 12:23">Fat. 12.23</ref>.</char></note>;</para>
  <para style="q" vid="PRO 29:23">Ma chi è umile di spirito otterrà gloria.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24"/>Chi partisce col ladro odia l'anima sua;</para>
  <para style="q" vid="PRO 29:24">Egli udirà l'esecrazione, e non però manifesterà <char style="add">il fatto</char><note caller="*" style="x"><char style="xo" closed="false">29.24 </char><char style="xk" closed="false"><char style="add">fatto</char> </char><char style="xt" closed="false"><ref loc="LEV 5:1">Lev. 5.1</ref>. <ref loc="JDG 17:2">Giud. 17.2</ref>.</char></note>.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25"/>Lo spavento dell'uomo <char style="add">gli</char> mette un laccio<note caller="*" style="x"><char style="xo" closed="false">29.25 </char><char style="xk" closed="false">laccio </char><char style="xt" closed="false"><ref loc="GEN 12:12">Gen. 12.12</ref> ecc.; <ref loc="GEN 20:2">20.2</ref>,<ref loc="GEN 20:12">12</ref>. <ref loc="JHN 12:43">Giov. 12.43</ref>.</char></note>;</para>
  <para style="q" vid="PRO 29:25">Ma chi si confida nel Signore<note caller="*" style="x"><char style="xo" closed="false">29.25 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note> sarà levato ad alto in salvo.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26"/>Molti cercano la faccia di colui che signoreggia<note caller="*" style="x"><char style="xo" closed="false">29.26 </char><char style="xk" closed="false">signoreggia </char><char style="xt" closed="false"><ref loc="PRO 19:6">Prov. 19.6</ref>.</char></note>;</para>
  <para style="q" vid="PRO 29:26">Ma dal Signore <char style="add">procede</char> il giudicio di ciascuno.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27"/>L'uomo iniquo <char style="add">è</char> l'abbominio de' giusti;</para>
  <para style="q" vid="PRO 29:27">E l'uomo che cammina dirittamente <char style="add">è</char> l'abbominio dell'empio.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">Le parole di Agur</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Le parole di Agur, figliuolo d'Iache; il sermone profetico che quell'uomo pronunziò ad Itiel; ad Itiel, e ad Ucal.<verse eid="PRO 30:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2"/>CERTO io <char style="add">son</char> troppo idiota, per esser gran personaggio;</para>
  <para style="q" vid="PRO 30:2">E non ho pur l'intendimento d'un uomo volgare;<verse eid="PRO 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3"/>E non ho imparata sapienza;</para>
  <para style="q" vid="PRO 30:3">Ma io so la scienza de' santi<note caller="*" style="x"><char style="xo" closed="false">30.3 </char><char style="xk" closed="false">santi </char><char style="xt" closed="false"><ref loc="PRO 9:10">Prov. 9.10</ref>.</char></note>.<verse eid="PRO 30:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4"/>Chi è salito in cielo, e <char style="add">n'è</char> disceso<note caller="*" style="x"><char style="xo" closed="false">30.4 </char><char style="xk" closed="false">disceso </char><char style="xt" closed="false"><ref loc="JHN 3:13">Giov. 3.13</ref>.</char></note>?</para>
  <para style="q" vid="PRO 30:4">Chi ha raccolto il vento nelle sue pugna<note caller="*" style="x"><char style="xo" closed="false">30.4 </char><char style="xk" closed="false">pugna </char><char style="xt" closed="false"><ref loc="JOB 38:4">Giob. 38.4</ref> ecc. <ref loc="PSA 104:3">Sal. 104.3</ref> ecc. <ref loc="ISA 40:12">Is. 40.12</ref> ecc.</char></note>?</para>
  <para style="q" vid="PRO 30:4">Chi ha serrate le acque nella sua vesta?</para>
  <para style="q" vid="PRO 30:4">Chi ha posti tutti i confini della terra?</para>
  <para style="q" vid="PRO 30:4">Quale <char style="add">è</char> il suo nome, o quale <char style="add">è</char> il nome del suo figliuolo,</para>
  <para style="q" vid="PRO 30:4">Se tu <char style="add">il</char> sai<note caller="*" style="x"><char style="xo" closed="false">30.4 </char><char style="xk" closed="false">sai </char><char style="xt" closed="false"><ref loc="REV 19:12">Apoc. 19.12</ref>.</char></note>?<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5"/>Ogni parola di Dio <char style="add">è</char> purgata col fuoco<note caller="*" style="x"><char style="xo" closed="false">30.5 </char><char style="xk" closed="false">fuoco </char><char style="xt" closed="false"><ref loc="PSA 12:6">Sal. 12.6</ref>; <ref loc="PSA 18:29">18.29</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PRO 30:5">Egli <char style="add">è</char> scudo a coloro che sperano in lui<note caller="*" style="x"><char style="xo" closed="false">30.5 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="PSA 84:11">Sal. 84.11</ref> e rif.; <ref loc="PSA 115:9-11">115.9-11</ref>.</char></note>.<verse eid="PRO 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6"/>Non aggiungere alle sue parole<note caller="*" style="x"><char style="xo" closed="false">30.6 </char><char style="xk" closed="false">parole </char><char style="xt" closed="false"><ref loc="DEU 4:2">Deut. 4.2</ref>. <ref loc="REV 22:18">Apoc. 22.18</ref>,<ref loc="REV 22:19">19</ref>.</char></note>;</para>
  <para style="q" vid="PRO 30:6">Che talora egli non ti arguisca, e che tu non sii trovato bugiardo.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7"/>Io ti ho chieste due cose, <char style="add">o Dio</char>;</para>
  <para style="q" vid="PRO 30:7">Non rifiutarme<char style="add">le</char> avanti che io muoia:<verse eid="PRO 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8"/>Allontana da me vanità e parole di bugia;</para>
  <para style="q" vid="PRO 30:8">Non mandarmi povertà, nè ricchezze;</para>
  <para style="q" vid="PRO 30:8">Cibami del mio pane quotidiano<note caller="*" style="x"><char style="xo" closed="false">30.8 </char><char style="xk" closed="false">quotidiano </char><char style="xt" closed="false"><ref loc="MAT 6:11">Mat. 6.11</ref>.</char></note>;<verse eid="PRO 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9"/>Che talora io non mi satolli, <char style="add">e ti</char> rinneghi,</para>
  <para style="q" vid="PRO 30:9">E dica: Chi <char style="add">è</char> il Signore<note caller="*" style="x"><char style="xo" closed="false">30.9 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="DEU 8:12-17">Deut. 8.12-17</ref>; <ref loc="DEU 32:15">32.15</ref>. <ref loc="NEH 9:25">Neem. 9.25</ref>,<ref loc="NEH 9:26">26</ref>. <ref loc="HOS 13:6">Os. 13.6</ref>.</char></note>?</para>
  <para style="q" vid="PRO 30:9">Che talora altresì io non impoverisca, e rubi,</para>
  <para style="q" vid="PRO 30:9">Ed usi indegnamente il Nome dell'Iddio mio<note caller="*" style="x"><char style="xo" closed="false">30.9 </char><char style="xk" closed="false">mio </char><char style="xt" closed="false"><ref loc="PRO 29:24">Prov. 29.24</ref>.</char></note>.<verse eid="PRO 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10"/>Non dir male del servo appo il suo padrone;</para>
  <para style="q" vid="PRO 30:10">Che talora egli non ti maledica, e tu ti renda colpevole.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11"/>
    <char style="add">Vi è</char> una generazione <char style="add">d'uomini che</char> maledice suo padre<note caller="*" style="x"><char style="xo" closed="false">30.11 </char><char style="xk" closed="false">padre </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PRO 17">17</ref>. <ref loc="EXO 21:17">Esod. 21.17</ref>.</char></note>;</para>
  <para style="q" vid="PRO 30:11">E non benedice sua madre.<verse eid="PRO 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12"/>
    <char style="add">Vi è</char> una generazione <char style="add">d'uomini che</char> si reputa netta,</para>
  <para style="q" vid="PRO 30:12">E non è lavata della sua lordura<note caller="*" style="x"><char style="xo" closed="false">30.12 </char><char style="xk" closed="false">lordura </char><char style="xt" closed="false"><ref loc="PRO 16:2">Prov. 16.2</ref> e rif. <ref loc="LUK 18:11">Luc. 18.11</ref>.</char></note>.<verse eid="PRO 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13"/>
    <char style="add">Vi è</char> una generazione <char style="add">d'uomini</char> che ha gli occhi grandemente elevati<note caller="*" style="x"><char style="xo" closed="false">30.13 </char><char style="xk" closed="false">elevati </char><char style="xt" closed="false"><ref loc="PSA 131:1">Sal. 131.1</ref>. <ref loc="PRO 6:16">Prov. 6.16</ref>,<ref loc="PRO 6:17">17</ref>.</char></note>,</para>
  <para style="q" vid="PRO 30:13">E le palpebre alzate.<verse eid="PRO 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14"/>
    <char style="add">Vi è</char> una generazione <char style="add">d'uomini</char> i cui denti <char style="add">sono</char> spade,</para>
  <para style="q" vid="PRO 30:14">Ed i mascellari coltelli,</para>
  <para style="q" vid="PRO 30:14">Per divorare i poveri d'in su la terra,</para>
  <para style="q" vid="PRO 30:14">Ed i bisognosi d'infra gli uomini<note caller="*" style="x"><char style="xo" closed="false">30.14 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="PSA 14:4">Sal. 14.4</ref>.</char></note>.<verse eid="PRO 30:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15"/>La mignatta ha due figliuole, <char style="add">che dicono:</char> Apporta, apporta.</para>
  <para style="q" vid="PRO 30:15">Queste tre cose non si saziano giammai;</para>
  <para style="q" vid="PRO 30:15">
    <char style="add">Anzi queste</char> quattro non dicono <char style="add">giammai:</char> Basta!<verse eid="PRO 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16"/>Il sepolcro<note caller="*" style="x"><char style="xo" closed="false">30.16 </char><char style="xk" closed="false">sepolcro </char><char style="xt" closed="false"><ref loc="PRO 27:20">Prov. 27.20</ref>. <ref loc="HAB 2:5">Abac. 2.5</ref>.</char></note>, la matrice sterile<note caller="*" style="x"><char style="xo" closed="false">30.16 </char><char style="xk" closed="false">sterile </char><char style="xt" closed="false"><ref loc="GEN 30:1">Gen. 30.1</ref>.</char></note>,</para>
  <para style="q" vid="PRO 30:16">La terra <char style="add">che</char> non si sazia <char style="add">giammai</char> d'acqua,</para>
  <para style="q" vid="PRO 30:16">E il fuoco, <char style="add">che giammai</char> non dice: Basta!<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17"/>I corvi del torrente trarranno,</para>
  <para style="q" vid="PRO 30:17">E i figli dell'aquila mangeranno gli occhi</para>
  <para style="q" vid="PRO 30:17">Di chi beffa suo padre,</para>
  <para style="q" vid="PRO 30:17">E sprezza di ubbidire a sua madre<note caller="*" style="x"><char style="xo" closed="false">30.17 </char><char style="xk" closed="false">madre </char><char style="xt" closed="false"><ref loc="GEN 9:22">Gen. 9.22</ref>. <ref loc="LEV 20:9">Lev. 20.9</ref>. <ref loc="PRO 20:20">Prov. 20.20</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18"/>Queste tre cose mi sono occulte;</para>
  <para style="q" vid="PRO 30:18">
    <char style="add">Anzi</char>, io non conosco <char style="add">queste</char> quattro:<verse eid="PRO 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19"/>La traccia dell'aquila nell'aria,</para>
  <para style="q" vid="PRO 30:19">La traccia del serpente sopra il sasso,</para>
  <para style="q" vid="PRO 30:19">La traccia della nave in mezzo del mare,</para>
  <para style="q" vid="PRO 30:19">La traccia dell'uomo nella giovane.<verse eid="PRO 30:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20"/>Tale <char style="add">è</char> il procedere della donna adultera;</para>
  <para style="q" vid="PRO 30:20">Ella mangia, e si frega la bocca,</para>
  <para style="q" vid="PRO 30:20">E dice: Io non ho commessa alcuna iniquità.<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21"/>Per tre cose la terra trema;</para>
  <para style="q" vid="PRO 30:21">Anzi per quattro, <char style="add">ch</char>'ella non può comportare:<verse eid="PRO 30:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22"/>Per lo servo, quando regna<note caller="*" style="x"><char style="xo" closed="false">30.22 </char><char style="xk" closed="false">regna </char><char style="xt" closed="false"><ref loc="PRO 19:10">Prov. 19.10</ref>.</char></note>;</para>
  <para style="q" vid="PRO 30:22">E <char style="add">per</char> l'uomo stolto, quando è satollo di pane;<verse eid="PRO 30:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23"/>Per la <char style="add">donna</char> odiosa, quando si marita;</para>
  <para style="q" vid="PRO 30:23">E <char style="add">per</char> la serva, quando è erede della sua padrona.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24"/>Queste quattro cose <char style="add">son</char> delle più piccole della terra,</para>
  <para style="q" vid="PRO 30:24">E pur <char style="add">son</char> savie, <char style="add">e</char> molto avvedute:<verse eid="PRO 30:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25"/>Le formiche<note caller="*" style="x"><char style="xo" closed="false">30.25 </char><char style="xk" closed="false">formiche </char><char style="xt" closed="false"><ref loc="PRO 6:6">Prov. 6.6</ref> ecc.</char></note>, <char style="add">che sono</char> un popolo senza forze,</para>
  <para style="q" vid="PRO 30:25">E pure apparecchiano di state il lor cibo;<verse eid="PRO 30:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26"/>I conigli, <char style="add">che sono</char> un popolo senza potenza,</para>
  <para style="q" vid="PRO 30:26">E pur fanno i lor ricetti nelle roccie;<verse eid="PRO 30:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27"/>Le locuste, <char style="add">che</char> non hanno re,</para>
  <para style="q" vid="PRO 30:27">E pure escono fuori tutte a stormo, divise per ischiere;<verse eid="PRO 30:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28"/>Il ramarro, <char style="add">che</char> si aggrappa con le mani,</para>
  <para style="q" vid="PRO 30:28">Ed è ne' palazzi dei re.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29"/>Queste tre cose hanno un bel passo;</para>
  <para style="q" vid="PRO 30:29">Anzi queste quattro hanno una bella andatura:<verse eid="PRO 30:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30"/>Il leone, la più forte delle bestie,</para>
  <para style="q" vid="PRO 30:30">Che non si volge indietro per tema di alcuno;<verse eid="PRO 30:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31"/>Il gallo compresso di fianchi, e il becco,</para>
  <para style="q" vid="PRO 30:31">E il re, appresso al quale niuno <char style="add">può</char> levare <char style="add">il capo</char>.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32"/>Se tu hai fatto qualche follia, innalzandoti;</para>
  <para style="q" vid="PRO 30:32">Ovvero, se hai divisato alcun male, <char style="add">mettiti</char> la mano in su la bocca<note caller="*" style="x"><char style="xo" closed="false">30.32 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="JOB 39:37">Giob. 39.37</ref>.</char></note>.<verse eid="PRO 30:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33"/>Perciocchè, <char style="add">come</char> chi rimena il latte <char style="add">ne</char> fa uscir del burro;</para>
  <para style="q" vid="PRO 30:33">E chi stringe il naso, <char style="add">ne</char> fa uscir del sangue;</para>
  <para style="q" vid="PRO 30:33">Così ancora chi preme l'ira <char style="add">ne</char> fa uscir contesa.<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">Ammaestramenti della madre del re Lemuel a suo figlio. — La donna di valore</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Le parole del re Lemuel; il sermone profetico, col quale sua madre l'ammaestrò.<verse eid="PRO 31:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2"/>CHE, figliuol mio? Che, figliuolo del seno mio<note caller="*" style="x"><char style="xo" closed="false">31.2 </char><char style="xk" closed="false">mio </char><char style="xt" closed="false"><ref loc="ISA 49:15">Is. 49.15</ref>.</char></note>?</para>
  <para style="q" vid="PRO 31:2">E che, figliuolo de' miei voti?<verse eid="PRO 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3"/>Non dar la tua forza alle donne,</para>
  <para style="q" vid="PRO 31:3">Nè i tuoi costumi <char style="add">a ciò che è</char> per distruggere i re<note caller="*" style="x"><char style="xo" closed="false">31.3 </char><char style="xk" closed="false">re </char><char style="xt" closed="false"><ref loc="DEU 17:17">Deut. 17.17</ref>. <ref loc="1KI 11:1">1 Re. 11.1</ref> ecc. <ref loc="PRO 7:26">Prov. 7.26</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4"/>Ei non <char style="add">si conviene</char> ai re, o Lemuel,</para>
  <para style="q" vid="PRO 31:4">Ei non si conviene ai re d'esser bevitori di vino,</para>
  <para style="q" vid="PRO 31:4">Nè a' principi <char style="add">d'esser bevitori</char> di cervogia<note caller="*" style="x"><char style="xo" closed="false">31.4 </char><char style="xk" closed="false">cervogia </char><char style="xt" closed="false"><ref loc="ECC 10:17">Eccl. 10.17</ref>.</char></note>;<verse eid="PRO 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5"/>Che talora eglino, avendo bevuto, non dimentichino gli statuti,</para>
  <para style="q" vid="PRO 31:5">E non pervertano il diritto di qualunque povero afflitto.<verse eid="PRO 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6"/>Date la cervogia al miserabile,</para>
  <para style="q" vid="PRO 31:6">E il vino a quelli che sono in amaritudine d'animo<note caller="*" style="x"><char style="xo" closed="false">31.6 </char><char style="xk" closed="false">animo </char><char style="xt" closed="false"><ref loc="PSA 104:15">Sal. 104.15</ref>.</char></note>;<verse eid="PRO 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7"/>
    <char style="add">Acciocchè</char> bevano, e dimentichino la lor miseria,</para>
  <para style="q" vid="PRO 31:7">E non si ricordino più de' lor travagli.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8"/>Apri la tua bocca per lo mutolo<note caller="*" style="x"><char style="xo" closed="false">31.8 </char><char style="xk" closed="false">mutolo </char><char style="xt" closed="false"><ref loc="JOB 29:15">Giob. 29.15</ref>,<ref loc="JOB 29:16">16</ref>.</char></note>,</para>
  <para style="q" vid="PRO 31:8">Per <char style="add">mantenere</char> la ragion di tutti quelli che sono in pericolo di perire<note caller="*" style="x"><char style="xo" closed="false">31.8 </char><char style="xk" closed="false">perire </char><char style="xt" closed="false"><ref loc="1SA 19:4">1 Sam. 19.4</ref>. <ref loc="EST 4:16">Est. 4.16</ref>.</char></note>.<verse eid="PRO 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9"/>Apri la tua bocca; giudica giustamente<note caller="*" style="x"><char style="xo" closed="false">31.9 </char><char style="xk" closed="false">giustamente </char><char style="xt" closed="false"><ref loc="LEV 19:15">Lev. 19.15</ref>. <ref loc="DEU 1:16">Deut. 1.16</ref>.</char></note>;</para>
  <para style="q" vid="PRO 31:9">Fa' diritto al povero ed al bisognoso<note caller="*" style="x"><char style="xo" closed="false">31.9 </char><char style="xk" closed="false">bisognoso </char><char style="xt" closed="false"><ref loc="ISA 1:17">Is. 1.17</ref>. <ref loc="JER 22:16">Ger. 22.16</ref>.</char></note>.<verse eid="PRO 31:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10"/>Chi troverà una donna di valore<note caller="*" style="x"><char style="xo" closed="false">31.10 </char><char style="xk" closed="false">valore </char><char style="xt" closed="false"><ref loc="PRO 12:4">Prov. 12.4</ref> e rif.; <ref loc="PRO 19:14">19.14</ref>.</char></note>?</para>
  <para style="q" vid="PRO 31:10">Il prezzo di essa avanza di gran lunga <char style="add">quello del</char>le perle.<verse eid="PRO 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11"/>Il cuor del suo marito si fida in lei;</para>
  <para style="q" vid="PRO 31:11">Ed egli non avrà giammai mancamento di veste.<verse eid="PRO 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12"/>Ella gli fa del bene, e non del male,</para>
  <para style="q" vid="PRO 31:12">Tutto il tempo della sua vita.<verse eid="PRO 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13"/>Ella cerca della lana e del lino,</para>
  <para style="q" vid="PRO 31:13">E lavora delle sue mani con diletto.<verse eid="PRO 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14"/>Ella è come le navi de' mercatanti:</para>
  <para style="q" vid="PRO 31:14">Ella fa venire il suo pane da lungi.<verse eid="PRO 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15"/>Ella si leva, mentre <char style="add">è</char> ancora notte<note caller="*" style="x"><char style="xo" closed="false">31.15 </char><char style="xk" closed="false">notte </char><char style="xt" closed="false"><ref loc="PRO 20:13">Prov. 20.13</ref>. <ref loc="ROM 12:11">Rom. 12.11</ref>.</char></note>,</para>
  <para style="q" vid="PRO 31:15">E dà il cibo alla sua famiglia,</para>
  <para style="q" vid="PRO 31:15">Ed ordina alle sue serventi il lor lavoro.<verse eid="PRO 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16"/>Ella considera un campo, e l'acquista;</para>
  <para style="q" vid="PRO 31:16">Ella pianta una vigna del frutto delle sue mani.<verse eid="PRO 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17"/>Ella si cinge i lombi di forza,</para>
  <para style="q" vid="PRO 31:17">E fortifica le sue braccia.<verse eid="PRO 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18"/>Perciocchè il suo traffico <char style="add">è</char> buono, ella <char style="add">lo</char> gusta;</para>
  <para style="q" vid="PRO 31:18">La sua lampana non si spegne di notte.<verse eid="PRO 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19"/>Ella mette la mano al fuso,</para>
  <para style="q" vid="PRO 31:19">E le sue palme impugnano la conocchia.<verse eid="PRO 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20"/>Ella allarga la mano all'afflitto,</para>
  <para style="q" vid="PRO 31:20">E porge le mani al bisognoso<note caller="*" style="x"><char style="xo" closed="false">31.20 </char><char style="xk" closed="false">bisognoso </char><char style="xt" closed="false"><ref loc="EPH 4:28">Efes. 4.28</ref>. <ref loc="HEB 13:16">Ebr. 13.16</ref>.</char></note>.<verse eid="PRO 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21"/>Ella non teme della neve per la sua famiglia;</para>
  <para style="q" vid="PRO 31:21">Perciocchè tutta la sua famiglia è vestita a doppio.<verse eid="PRO 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22"/>Ella si fa de' capoletti;</para>
  <para style="q" vid="PRO 31:22">Fin lino, e porpora <char style="add">sono</char> il suo vestire.<verse eid="PRO 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23"/>Il suo marito <char style="add">è</char> conosciuto nelle porte,</para>
  <para style="q" vid="PRO 31:23">Quando egli siede con gli anziani del paese<note caller="*" style="x"><char style="xo" closed="false">31.23 </char><char style="xk" closed="false">paese </char><char style="xt" closed="false"><ref loc="PRO 12:4">Prov. 12.4</ref>.</char></note>.<verse eid="PRO 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24"/>Ella fa de' veli, e <char style="add">li</char> vende;</para>
  <para style="q" vid="PRO 31:24">E delle cinture, <char style="add">le quali</char> ella dà a' mercatanti.<verse eid="PRO 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25"/>Ella è vestita di gloria e d'onore;</para>
  <para style="q" vid="PRO 31:25">E ride del giorno a venire.<verse eid="PRO 31:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26"/>Ella apre la bocca con sapienza,</para>
  <para style="q" vid="PRO 31:26">E la legge della benignità <char style="add">è</char> sopra la sua lingua.<verse eid="PRO 31:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27"/>Ella considera gli andamenti della sua casa,</para>
  <para style="q" vid="PRO 31:27">E non mangia il pan di pigrizia.<verse eid="PRO 31:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28"/>I suoi figliuoli si levano, e la predicano beata,</para>
  <para style="q" vid="PRO 31:28">Il suo marito <char style="add">anch'egli</char>, e la loda;<verse eid="PRO 31:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29"/>
    <char style="add">Dicendo:</char> Molte donne si son portate valorosamente;</para>
  <para style="q" vid="PRO 31:29">Ma tu le sopravanzi tutte.<verse eid="PRO 31:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30"/>La grazia <char style="add">è</char> cosa fallace, e la bellezza <char style="add">è</char> cosa vana;</para>
  <para style="q" vid="PRO 31:30">
    <char style="add">Ma</char> la donna <char style="add">che ha</char> il timor del Signore <char style="add">sarà</char> quella che sarà lodata<note caller="*" style="x"><char style="xo" closed="false">31.30 </char><char style="xk" closed="false">lodata </char><char style="xt" closed="false"><ref loc="PRO 11:16">Prov. 11.16</ref>.</char></note>.<verse eid="PRO 31:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31"/>Datele del frutto delle sue mani;</para>
  <para style="q" vid="PRO 31:31">E lodinla le sue opere nelle porte.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
