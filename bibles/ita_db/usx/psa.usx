  <para style="h">SALMI</para>
  <para style="toc1">IL LIBRO DE' SALMI</para>
  <para style="toc2">SALMI</para>
  <para style="toc3">Sal.</para>
  <para style="mt1">IL LIBRO DE' SALMI</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="cl">SALMO I</para>
  <para style="s1">Felicità dei giusti; castigo degli empi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1"/>BEATO l'uomo che non è camminato nel consiglio degli empi<note caller="*" style="x"><char style="xo" closed="false">1.1 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="PRO 4:14">Prov. 4.14</ref>,<ref loc="PRO 4:15">15</ref>.</char></note>,</para>
  <para style="q" vid="PSA 1:1">E non si è fermato nella via de' peccatori,</para>
  <para style="q" vid="PSA 1:1">E non è seduto nella sedia degli schernitori<note caller="*" style="x"><char style="xo" closed="false">1.1 </char><char style="xk" closed="false">schernitori </char><char style="xt" closed="false"><ref loc="PSA 26:4">Sal. 26.4</ref>. <ref loc="JER 15:17">Ger. 15.17</ref>.</char></note>.<verse eid="PSA 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2"/>Anzi il cui diletto <char style="add">è</char> nella Legge del Signore<note caller="*" style="x"><char style="xo" closed="false">1.2 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 119:35">Sal. 119.35</ref>,<ref loc="PSA 119:47">47</ref>,<ref loc="PSA 119:92">92</ref>.</char></note>,</para>
  <para style="q" vid="PSA 1:2">E medita in essa giorno e notte<note caller="*" style="x"><char style="xo" closed="false">1.2 </char><char style="xk" closed="false">notte </char><char style="xt" closed="false"><ref loc="JOS 1:8">Gios. 1.8</ref>. <ref loc="PSA 119:97">Sal. 119.97</ref>.</char></note>.<verse eid="PSA 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3"/>Egli sarà come un albero piantato presso a ruscelli d'acque,</para>
  <para style="q" vid="PSA 1:3">Il quale rende il suo frutto nella sua stagione,</para>
  <para style="q" vid="PSA 1:3">E le cui frondi non appassano;</para>
  <para style="q" vid="PSA 1:3">E tutto quello ch'egli farà, prospererà<note caller="*" style="x"><char style="xo" closed="false">1.3 </char><char style="xk" closed="false">prospererà </char><char style="xt" closed="false"><ref loc="GEN 39:3">Gen. 39.3</ref>,<ref loc="GEN 39:23">23</ref>. <ref loc="ISA 3:10">Is. 3.10</ref>.</char></note>.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4"/>Così non <char style="add">saranno</char> già gli empi;</para>
  <para style="q" vid="PSA 1:4">Anzi <char style="add">saranno</char> come pula sospinta dal vento.<verse eid="PSA 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5"/>Perciò gli empi non istaranno ritti nel giudicio,</para>
  <para style="q" vid="PSA 1:5">Nè i peccatori nella raunanza de' giusti.<verse eid="PSA 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6"/>Perciocchè il Signore conosce la via de' giusti<note caller="*" style="x"><char style="xo" closed="false">1.6 </char><char style="xk" closed="false">giusti </char><char style="xt" closed="false"><ref loc="JHN 10:14">Giov. 10.14</ref>. <ref loc="2TI 2:19">2 Tim. 2.19</ref>.</char></note>;</para>
  <para style="q" vid="PSA 1:6">Ma la via degli empi perirà.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">SALMO II</para>
  <para style="s1">Lotte e vittoria del Messia</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1"/>PERCHÈ tumultuano le genti,</para>
  <para style="q" vid="PSA 2:1">E mormorano i popoli cose vane<note caller="*" style="x"><char style="xo" closed="false">2.1 </char><char style="xk" closed="false">vane </char><char style="xt" closed="false"><ref loc="PSA 46:6">Sal. 46.6</ref>. <ref loc="ACT 4:25">Fat. 4.25</ref>,<ref loc="ACT 4:26">26</ref>.</char></note>?<verse eid="PSA 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2"/>I re della terra si ritrovano,</para>
  <para style="q" vid="PSA 2:2">Ed i principi consigliano insieme,</para>
  <para style="q" vid="PSA 2:2">Contro al Signore, e contro al suo Unto<note caller="*" style="x"><char style="xo" closed="false">2.2 </char><char style="xk" closed="false">Unto </char><char style="xt" closed="false"><ref loc="PSA 45:7">Sal. 45.7</ref>. <ref loc="JHN 1:41">Giov. 1.41</ref>.</char></note>;<verse eid="PSA 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3"/>
    <char style="add">Dicendo:</char> Rompiamo i lor legami,</para>
  <para style="q" vid="PSA 2:3">E gettiam via da noi le lor funi<note caller="*" style="x"><char style="xo" closed="false">2.3 </char><char style="xk" closed="false">funi </char><char style="xt" closed="false"><ref loc="LUK 19:14">Luc. 19.14</ref>.</char></note>.<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4"/>Colui che siede ne' cieli<note caller="*" style="x"><char style="xo" closed="false">2.4 </char><char style="xk" closed="false">cieli </char><char style="xt" closed="false"><ref loc="ISA 40:22">Is. 40.22</ref>.</char></note> <char style="add">ne</char> riderà;</para>
  <para style="q" vid="PSA 2:4">Il Signore si befferà di loro<note caller="*" style="x"><char style="xo" closed="false">2.4 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PSA 37:13">Sal. 37.13</ref>. <ref loc="PRO 1:26">Prov. 1.26</ref>.</char></note>.<verse eid="PSA 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5"/>Allora parlerà loro nella sua ira,</para>
  <para style="q" vid="PSA 2:5">E li renderà smarriti nel suo cruccio acceso;<verse eid="PSA 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6"/>
    <char style="add">E dirà:</char> Pur nondimeno ho io consacrato il mio Re</para>
  <para style="q" vid="PSA 2:6">Sopra Sion, monte della mia santità<note caller="*" style="x"><char style="xo" closed="false">2.6 </char><char style="xk" closed="false">santità </char><char style="xt" closed="false"><ref loc="2SA 5:7">2 Sam. 5.7</ref>.</char></note>.<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7"/>Io spiegherò il decreto;</para>
  <para style="q" vid="PSA 2:7">Il Signore mi ha detto: Tu <char style="add">sei</char> il mio figliuolo<note caller="*" style="x"><char style="xo" closed="false">2.7 </char><char style="xk" closed="false">figliuolo </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat. 3.17</ref>; <ref loc="MAT 14:33">14.33</ref>. <ref loc="ACT 13:33">Fat. 13.33</ref>. <ref loc="HEB 1:5">Ebr. 1.5</ref>; <ref loc="HEB 5:5">5.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 2:7">Oggi io t'ho generato.<verse eid="PSA 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8"/>Chiedimi, ed io ti darò <char style="add">per</char> eredità le genti,</para>
  <para style="q" vid="PSA 2:8">Ed i confini della terra <char style="add">per</char> tua possessione<note caller="*" style="x"><char style="xo" closed="false">2.8 </char><char style="xk" closed="false">possessione </char><char style="xt" closed="false"><ref loc="PSA 22:27">Sal. 22.27</ref>,<ref loc="PSA 22:28">28</ref>; <ref loc="PSA 72:8">72.8</ref>. <ref loc="DAN 7:13">Dan. 7.13</ref>,<ref loc="DAN 7:14">14</ref>. <ref loc="JHN 17:4">Giov. 17.4</ref>,<ref loc="JHN 17:5">5</ref>.</char></note>.<verse eid="PSA 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9"/>Tu le fiaccherai con una verga di ferro;</para>
  <para style="q" vid="PSA 2:9">Tu le triterai come un testo di vasellaio<note caller="*" style="x"><char style="xo" closed="false">2.9 </char><char style="xk" closed="false">vasellaio </char><char style="xt" closed="false"><ref loc="REV 2:27">Apoc. 2.27</ref>; <ref loc="REV 12:5">12.5</ref>; <ref loc="REV 19:15">19.15</ref>.</char></note>.<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10"/>Ora dunque, o re, siate savi;</para>
  <para style="q" vid="PSA 2:10">Giudici della terra, ricevete correzione.<verse eid="PSA 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11"/>Servite al Signore con timore,</para>
  <para style="q" vid="PSA 2:11">E gioite con tremore<note caller="*" style="x"><char style="xo" closed="false">2.11 </char><char style="xk" closed="false">tremore </char><char style="xt" closed="false"><ref loc="PHP 2:12">Fil. 2.12</ref>. <ref loc="HEB 12:28">Ebr. 12.28</ref>.</char></note>.<verse eid="PSA 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12"/>Baciate il figliuolo<note caller="*" style="x"><char style="xo" closed="false">2.12 </char><char style="xk" closed="false">figliuolo </char><char style="xt" closed="false"><ref loc="GEN 41:40">Gen. 41.40</ref>. <ref loc="JHN 5:23">Giov. 5.23</ref>.</char></note>, che talora egli non si adiri,</para>
  <para style="q" vid="PSA 2:12">E che voi non periate <char style="add">nella vostra</char> via,</para>
  <para style="q" vid="PSA 2:12">Quando l'ira sua si sarà pure un poco accesa<note caller="*" style="x"><char style="xo" closed="false">2.12 </char><char style="xk" closed="false">accesa </char><char style="xt" closed="false"><ref loc="REV 6:16">Apoc. 6.16</ref>,<ref loc="REV 6:17">17</ref>.</char></note>.</para>
  <para style="q" vid="PSA 2:12">Beati tutti coloro che si confidano in lui<note caller="*" style="x"><char style="xo" closed="false">2.12 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="PSA 34:8">Sal. 34.8</ref>. <ref loc="JER 17:7">Ger. 17.7</ref>. <ref loc="ROM 9:33">Rom. 9.33</ref>; <ref loc="ROM 10:11">10.11</ref>. <ref loc="1PE 2:6">1 Piet. 2.6</ref>.</char></note>.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">SALMO III</para>
  <para style="s1">Fiducia in Dio nell'avversità</para>
  <para style="d">Salmo di Davide, <char style="add">composto</char> quando egli fuggì per cagione d'Absalom, suo figliuolo<note caller="*" style="x"><char style="xo" closed="false">3.0 </char><char style="xk" closed="false">figliuolo </char><char style="xt" closed="false"><ref loc="2SA 15:14-17">2 Sam. 15.14-17</ref>,<ref loc="2SA 15:29">29</ref>.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1"/>O SIGNORE, in quanto gran numero sono i miei nemici!</para>
  <para style="q" vid="PSA 3:1">Molti si levano contro a me<note caller="*" style="x"><char style="xo" closed="false">3.1 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="2SA 15:12">2 Sam. 15.12</ref>; <ref loc="2SA 16:15">16.15</ref>.</char></note>.<verse eid="PSA 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2"/>Molti dicono dell'anima mia:</para>
  <para style="q" vid="PSA 3:2">Non <char style="add">v</char>'è salute alcuna appo Iddio per lui<note caller="*" style="x"><char style="xo" closed="false">3.2 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="2SA 16:8">2 Sam. 16.8</ref>. <ref loc="PSA 71:11">Sal. 71.11</ref>.</char></note>. <char style="qs">(Sela</char><note caller="+" style="f"><char style="fr" closed="false">3.2 </char><char style="fq" closed="false">Sela </char><char style="ft" closed="false">cioè: </char><char style="fk" closed="false">pausa .</char></note><char style="qs">.)</char><verse eid="PSA 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3"/>Ma, Signore, tu <char style="add">sei</char> uno scudo d'intorno a me<note caller="*" style="x"><char style="xo" closed="false">3.3 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="GEN 15:1">Gen. 15.1</ref>. <ref loc="PSA 28:7">Sal. 28.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 3:3">
    <char style="add">Tu sei</char> la mia gloria, e quel che mi sollevi il capo.<verse eid="PSA 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4"/>Io ho colla mia voce gridato al Signore,</para>
  <para style="q" vid="PSA 3:4">Ed egli mi ha risposto dal monte della sua santità<note caller="*" style="x"><char style="xo" closed="false">3.4 </char><char style="xk" closed="false">santità </char><char style="xt" closed="false"><ref loc="PSA 34:4-6">Sal. 34.4-6</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5"/>Io mi son coricato, e ho dormito;</para>
  <para style="q" vid="PSA 3:5">Poi mi son risvegliato<note caller="*" style="x"><char style="xo" closed="false">3.5 </char><char style="xk" closed="false">risvegliato </char><char style="xt" closed="false"><ref loc="LEV 26:6">Lev. 26.6</ref>. <ref loc="JOB 11:19">Giob. 11.19</ref>. <ref loc="PSA 4:8">Sal. 4.8</ref>. <ref loc="PRO 3:24">Prov. 3.24</ref>.</char></note>; perciocchè il Signore mi sostiene.<verse eid="PSA 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6"/>Io non temerei<note caller="*" style="x"><char style="xo" closed="false">3.6 </char><char style="xk" closed="false">temerei </char><char style="xt" closed="false"><ref loc="PSA 23:4">Sal. 23.4</ref>; <ref loc="PSA 27:3">27.3</ref>.</char></note> di migliaia di popolo,</para>
  <para style="q" vid="PSA 3:6">Quando si fossero accampate contro a me d'ogn'intorno.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7"/>Levati, Signore; salvami, Dio mio;</para>
  <para style="q" vid="PSA 3:7">Perciochè tu hai percossa la mascella di tutti i miei nemici;</para>
  <para style="q" vid="PSA 3:7">Tu hai rotti i denti degli empi.<verse eid="PSA 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8"/>Il salvare <char style="add">appartiene</char> al Signore<note caller="*" style="x"><char style="xo" closed="false">3.8 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 21:31">Prov. 21.31</ref>. <ref loc="ISA 43:11">Is. 43.11</ref>. <ref loc="JER 3:23">Ger. 3.23</ref>. <ref loc="HOS 13:14">Os. 13.14</ref>. <ref loc="JON 2:10">Gion. 2.10</ref>. <ref loc="REV 7:10">Apoc. 7.10</ref>; <ref loc="REV 19:1">19.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 3:8">La tua benedizione <char style="add">è</char> sopra il tuo popolo. <char style="qs">(Sela.)</char><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">SALMO IV</para>
  <para style="s1">Preghiera a Dio nella distretta</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici, in su Neghinot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1"/>QUANDO io grido, rispondimi, o Dio della mia giustizia;</para>
  <para style="q" vid="PSA 4:1">Quando io sono stato distretto, tu mi hai messo in largo;</para>
  <para style="q" vid="PSA 4:1">Abbi pietà di me, ed esaudisci la mia orazione.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2"/>O uomini principali, infino a quando <char style="add">sarà</char> la mia gloria in vituperio?</para>
  <para style="q" vid="PSA 4:2">
    <char style="add">Infino a quando</char> amerete vanità,</para>
  <para style="q" vid="PSA 4:2">
    <char style="add">E</char> andrete dietro a menzogna? <char style="qs">(Sela.)</char><verse eid="PSA 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3"/>Or sappiate che il Signore si ha eletto un pietoso<note caller="*" style="x"><char style="xo" closed="false">4.3 </char><char style="xk" closed="false">pietoso </char><char style="xt" closed="false"><ref loc="2TI 2:19">2 Tim. 2.19</ref>. <ref loc="2PE 2:9">2 Piet. 2.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 4:3">Il Signore <char style="add">mi</char> esaudirà quando io griderò a lui.<verse eid="PSA 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4"/>Tremate, e non peccate<note caller="*" style="x"><char style="xo" closed="false">4.4 </char><char style="xk" closed="false">peccate </char><char style="xt" closed="false"><ref loc="EPH 4:26">Efes. 4.26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 4:4">Ragionate nel cuor vostro, sopra i vostri letti, e restate<note caller="*" style="x"><char style="xo" closed="false">4.4 </char><char style="xk" closed="false">restate </char><char style="xt" closed="false"><ref loc="PSA 77:6">Sal. 77.6</ref>. <ref loc="2CO 13:5">2 Cor. 13.5</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5"/>Sacrificate sacrificii di giustizia<note caller="*" style="x"><char style="xo" closed="false">4.5 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 50:14">Sal. 50.14</ref>; <ref loc="PSA 51:17">51.17</ref>,<ref loc="PSA 51:19">19</ref>.</char></note>,</para>
  <para style="q" vid="PSA 4:5">E confidatevi nel Signore<note caller="*" style="x"><char style="xo" closed="false">4.5 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6"/>Molti dicono: Chi ci farà veder del bene?</para>
  <para style="q" vid="PSA 4:6">O Signore, alza la luce del tuo volto sopra noi<note caller="*" style="x"><char style="xo" closed="false">4.6 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="NUM 6:26">Num. 6.26</ref>. <ref loc="PSA 119:135">Sal. 119.135</ref>.</char></note>.<verse eid="PSA 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7"/>Tu mi hai data maggiore allegrezza nel cuore, che <char style="add">non hanno quelli</char></para>
  <para style="q" vid="PSA 4:7">Nel tempo <char style="add">che</char> il lor frumento, e il lor mosto è moltiplicato.<verse eid="PSA 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8"/>Io mi coricherò in pace, ed <char style="add">in pace</char> ancora dormirò<note caller="*" style="x"><char style="xo" closed="false">4.8 </char><char style="xk" closed="false">dormirò </char><char style="xt" closed="false"><ref loc="PSA 3:5">Sal. 3.5</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 4:8">Perciocchè tu solo, Signore, mi fai abitare sicuramente<note caller="*" style="x"><char style="xo" closed="false">4.8 </char><char style="xk" closed="false">sicuramente </char><char style="xt" closed="false"><ref loc="LEV 25:18">Lev. 25.18</ref>,<ref loc="LEV 25:19">19</ref>. <ref loc="DEU 12:10">Deut. 12.10</ref>.</char></note>.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">SALMO V</para>
  <para style="s1">Mali che sovrastano i malvagi: benedizioni riservate ai giusti</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici, in su Nehilot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1"/>PORGI l'orecchio alle mie parole, o Signore;</para>
  <para style="q" vid="PSA 5:1">Intendi la mia meditazione.<verse eid="PSA 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2"/>Re mio, e Dio mio, attendi alla voce del mio grido;</para>
  <para style="q" vid="PSA 5:2">Perciocchè io t'indirizzo la mia orazione<note caller="*" style="x"><char style="xo" closed="false">5.2 </char><char style="xk" closed="false">orazione </char><char style="xt" closed="false"><ref loc="PSA 65:2">Sal. 65.2</ref>.</char></note>.<verse eid="PSA 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3"/>Signore, ascolta da mattina la mia voce;</para>
  <para style="q" vid="PSA 5:3">Da mattina io ti spiego <char style="add">i miei desii</char>, e sto aspettando.<verse eid="PSA 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4"/>Perciocchè tu non <char style="add">sei</char> un Dio che prenda piacere nell'empietà;</para>
  <para style="q" vid="PSA 5:4">Il malvagio non può dimorar teco.<verse eid="PSA 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5"/>Gl'insensati non possono comparir davanti agli occhi tuoi;</para>
  <para style="q" vid="PSA 5:5">Tu odii tutti gli operatori d'iniquità<note caller="*" style="x"><char style="xo" closed="false">5.5 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="HAB 1:13">Abac. 1.13</ref>.</char></note>.<verse eid="PSA 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6"/>Tu farai perire tutti quelli che parlano con menzogna;</para>
  <para style="q" vid="PSA 5:6">Il Signore abbomina l'uomo di sangue e di frode<note caller="*" style="x"><char style="xo" closed="false">5.6 </char><char style="xk" closed="false">frode </char><char style="xt" closed="false"><ref loc="PSA 55:23">Sal. 55.23</ref>. <ref loc="REV 21:8">Apoc. 21.8</ref>.</char></note>.<verse eid="PSA 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7"/>Ma io, per la grandezza della tua benignità, entrerò nella tua Casa,</para>
  <para style="q" vid="PSA 5:7">E adorerò verso il Tempio della tua santità<note caller="*" style="x"><char style="xo" closed="false">5.7 </char><char style="xk" closed="false">santità </char><char style="xt" closed="false"><ref loc="1KI 8:29">1 Re. 8.29</ref>,<ref loc="1KI 8:30">30</ref>,<ref loc="1KI 8:35">35</ref>,<ref loc="1KI 8:38">38</ref>,<ref loc="1KI 8:39">39</ref>.</char></note>, nel tuo timore.<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8"/>Signore, guidami per la tua giustizia, per cagion de' miei insidiatori;</para>
  <para style="q" vid="PSA 5:8">Addirizza davanti a me la tua via<note caller="*" style="x"><char style="xo" closed="false">5.8 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="PSA 25:4">Sal. 25.4</ref>,<ref loc="PSA 25:5">5</ref>; <ref loc="PSA 27:11">27.11</ref>.</char></note>.<verse eid="PSA 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9"/>Perciocchè nella bocca loro non <char style="add">v'è</char> dirittura alcuna;</para>
  <para style="q" vid="PSA 5:9">L'interior loro <char style="add">non è altro che</char> malizie;</para>
  <para style="q" vid="PSA 5:9">La lor gola <char style="add">è</char> un sepolcro aperto<note caller="*" style="x"><char style="xo" closed="false">5.9 </char><char style="xk" closed="false">aperto </char><char style="xt" closed="false"><ref loc="LUK 11:44">Luc. 11.44</ref>. <ref loc="ROM 3:13">Rom. 3.13</ref>.</char></note>,</para>
  <para style="q" vid="PSA 5:9">Lusingano colla lor lingua<note caller="*" style="x"><char style="xo" closed="false">5.9 </char><char style="xk" closed="false">lingua </char><char style="xt" closed="false"><ref loc="PSA 62:4">Sal. 62.4</ref>.</char></note>.<verse eid="PSA 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10"/>Condannali, o Dio;</para>
  <para style="q" vid="PSA 5:10">Scadano da' lor consigli<note caller="*" style="x"><char style="xo" closed="false">5.10 </char><char style="xk" closed="false">consigli </char><char style="xt" closed="false"><ref loc="2SA 15:31">2 Sam. 15.31</ref>; <ref loc="2SA 17:14">17.14</ref>,<ref loc="2SA 17:23">23</ref>.</char></note>;</para>
  <para style="q" vid="PSA 5:10">Scacciali per la moltitudine de' lor misfatti;</para>
  <para style="q" vid="PSA 5:10">Perciocchè si son ribellati contro a te.<verse eid="PSA 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11"/>E rallegrinsi tutti quelli che si confidano in te,</para>
  <para style="q" vid="PSA 5:11">
    <char style="add">E</char> cantino in eterno, e sii lor protettore;</para>
  <para style="q" vid="PSA 5:11">E festeggino in te</para>
  <para style="q" vid="PSA 5:11">Quelli che amano il tuo Nome<note caller="*" style="x"><char style="xo" closed="false">5.11 </char><char style="xk" closed="false">Nome </char><char style="xt" closed="false"><ref loc="ISA 65:13">Is. 65.13</ref>.</char></note>.<verse eid="PSA 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12"/>Perciocchè tu, Signore, benedirai il giusto;</para>
  <para style="q" vid="PSA 5:12">Tu l'intornierai di benevolenza, come d'uno scudo.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">SALMO VI</para>
  <para style="s1">Davide ricorre alla misericordia di Dio per ottener perdono e liberazione</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici, in Neghinot, sopra Seminit</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1"/>SIGNORE, non correggermi nella tua ira,</para>
  <para style="q" vid="PSA 6:1">E non gastigarmi nel tuo cruccio<note caller="*" style="x"><char style="xo" closed="false">6.1 </char><char style="xk" closed="false">cruccio </char><char style="xt" closed="false"><ref loc="PSA 38:1">Sal. 38.1</ref>. <ref loc="JER 10:24">Ger. 10.24</ref>; <ref loc="JER 30:11">30.11</ref>; <ref loc="JER 46:28">46.28</ref>.</char></note>.<verse eid="PSA 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2"/>Abbi pietà di me, o Signore; perciocchè io <char style="add">son</char> tutto fiacco;</para>
  <para style="q" vid="PSA 6:2">Sanami, Signore<note caller="*" style="x"><char style="xo" closed="false">6.2 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 41:4">Sal. 41.4</ref>. <ref loc="HOS 6:1">Os. 6.1</ref>.</char></note>; perciocchè le mie ossa son tutte smarrite.<verse eid="PSA 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3"/>L'anima mia eziandio è grandemente smarrita;</para>
  <para style="q" vid="PSA 6:3">E tu, Signore, infino a quando?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4"/>Rivolgiti, o Signore; riscuoti l'anima mia;</para>
  <para style="q" vid="PSA 6:4">Salvami, per amor della tua benignità.<verse eid="PSA 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5"/>Perciocchè nella morte non <char style="add">v'è</char> memoria di te<note caller="*" style="x"><char style="xo" closed="false">6.5 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 30:9">Sal. 30.9</ref>; <ref loc="PSA 88:11">88.11</ref>; <ref loc="PSA 115:17">115.17</ref>; <ref loc="PSA 118:16">118.16</ref>. <ref loc="ISA 38:18">Is. 38.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 6:5">Chi ti celebrerà nel sepolcro?<verse eid="PSA 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6"/>Io mi affanno ne' miei sospiri;</para>
  <para style="q" vid="PSA 6:6">Io allago tutta notte il mio letto,</para>
  <para style="q" vid="PSA 6:6">E bagno la mia lettiera colle mie lagrime.<verse eid="PSA 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7"/>L' occhio mio è consumato di fastidio<note caller="*" style="x"><char style="xo" closed="false">6.7 </char><char style="xk" closed="false">fastidio </char><char style="xt" closed="false"><ref loc="JOB 17:7">Giob. 17.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 6:7">Egli è invecchiato per cagione di tutti i miei nemici.<verse eid="PSA 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8"/>Ritraetevi da me, <char style="add">voi</char> tutti operatori d'iniquità<note caller="*" style="x"><char style="xo" closed="false">6.8 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 119:115">Sal. 119.115</ref>. <ref loc="MAT 7:23">Mat. 7.23</ref>; <ref loc="MAT 25:41">25.41</ref>. <ref loc="LUK 13:27">Luc. 13.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 6:8">Perciocchè il Signore ha udita la voce del mio pianto.<verse eid="PSA 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9"/>Il Signore ha udita la mia supplicazione;</para>
  <para style="q" vid="PSA 6:9">Il Signore ha accettata la mia orazione.<verse eid="PSA 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10"/>Tutti i miei nemici sieno confusi, e grandemente smarriti;</para>
  <para style="q" vid="PSA 6:10">Voltin le spalle, e sieno svergognati in un momento.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">SALMO VII</para>
  <para style="s1">Attorniato da molti nemici, Davide confida in Dio, e protesta della propria innocenza</para>
  <para style="d">Siggaion di Davide, il quale egli cantò al Signore, sopra le parole di Cus Beniaminita</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1"/>SIGNORE Iddio mio, io mi confido in te;</para>
  <para style="q" vid="PSA 7:1">Salvami da tutti quelli che mi perseguitano, e riscuotimi<note caller="*" style="x"><char style="xo" closed="false">7.1 </char><char style="xk" closed="false">riscuotimi </char><char style="xt" closed="false"><ref loc="PSA 31:15">Sal. 31.15</ref>.</char></note>;<verse eid="PSA 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2"/>Che talora <char style="add">il mio nemico</char> non rapisca l'anima mia come un leone;</para>
  <para style="q" vid="PSA 7:2">E <char style="add">non la</char> laceri, senza che <char style="add">vi sia</char> alcuno che <char style="add">mi</char> riscuota.<verse eid="PSA 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3"/>Signore Iddio mio, se ho fatto questo<note caller="*" style="x"><char style="xo" closed="false">7.3 </char><char style="xk" closed="false">questo </char><char style="xt" closed="false"><ref loc="2SA 16:7">2 Sam. 16.7</ref>,<ref loc="2SA 16:8">8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 7:3">Se vi è perversità nelle mie mani<note caller="*" style="x"><char style="xo" closed="false">7.3 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="1SA 24:11">1 Sam. 24.11</ref>,<ref loc="1SA 24:12">12</ref>.</char></note>;<verse eid="PSA 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4"/>Se ho renduto mal <char style="add">per bene</char> a chi viveva in pace meco</para>
  <para style="q" vid="PSA 7:4">(<char style="add">Io</char>, che ho riscosso colui che mi era nemico senza cagione<note caller="*" style="x"><char style="xo" closed="false">7.4 </char><char style="xk" closed="false">cagione </char><char style="xt" closed="false"><ref loc="1SA 24:7">1 Sam. 24.7</ref>; <ref loc="1SA 26:9">26.9</ref>.</char></note>),<verse eid="PSA 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5"/>Perseguiti pure il nemico l'anima mia, e <char style="add">l</char>'aggiunga,</para>
  <para style="q" vid="PSA 7:5">E calpesti la vita mia, <char style="add">mettendola</char> per terra;</para>
  <para style="q" vid="PSA 7:5">E stanzi la mia gloria nella polvere. <char style="qs">(Sela.)</char><verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6"/>Levati, Signore, nell'ira tua;</para>
  <para style="q" vid="PSA 7:6">Innalzati contro a' furori de' miei nemici,</para>
  <para style="q" vid="PSA 7:6">E destati in mio favore; tu hai ordinato il giudicio.<verse eid="PSA 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7"/>E circonditi la raunanza de' popoli;</para>
  <para style="q" vid="PSA 7:7">E torna poi in luogo elevato di sopra ad essa.<verse eid="PSA 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8"/>Il Signore giudicherà i popoli;</para>
  <para style="q" vid="PSA 7:8">Signore, giudicami;</para>
  <para style="q" vid="PSA 7:8">
    <char style="add">Giudica</char> di me secondo la mia giustizia, e la mia integrità<note caller="*" style="x"><char style="xo" closed="false">7.8 </char><char style="xk" closed="false">integrità </char><char style="xt" closed="false"><ref loc="PSA 18:19">Sal. 18.19</ref>; <ref loc="PSA 35:24">35.24</ref>.</char></note>.<verse eid="PSA 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9"/>Deh! venga meno la malvagità de' malvagi,</para>
  <para style="q" vid="PSA 7:9">E stabilisci l'<char style="add">uomo</char> giusto;</para>
  <para style="q" vid="PSA 7:9">Conciossiachè <char style="add">tu sii</char> l'Iddio giusto, che provi i cuori e le reni<note caller="*" style="x"><char style="xo" closed="false">7.9 </char><char style="xk" closed="false">reni </char><char style="xt" closed="false"><ref loc="1SA 16:7">1 Sam. 16.7</ref>. <ref loc="1CH 28:9">1 Cron. 28.9</ref>. <ref loc="PSA 139:1">Sal. 139.1</ref> ecc. <ref loc="REV 2:23">Apoc. 2.23</ref>.</char></note>.<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10"/>Il mio scudo <char style="add">è</char> in Dio,</para>
  <para style="q" vid="PSA 7:10">Che salva quelli che son diritti di cuore.<verse eid="PSA 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11"/>Iddio <char style="add">è</char> giusto giudice,</para>
  <para style="q" vid="PSA 7:11">E un Dio che si adira ogni giorno.<verse eid="PSA 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12"/>Se <char style="add">il mio nemico</char> non si converte, egli aguzzerà la sua spada;</para>
  <para style="q" vid="PSA 7:12">
    <char style="add">Già</char> ha teso l'arco suo, e l'ha preparato.<verse eid="PSA 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13"/>Egli ha apparecchiate arme mortali;</para>
  <para style="q" vid="PSA 7:13">Egli adopererà le sue saette contro agli ardenti persecutori.<verse eid="PSA 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14"/>Ecco, <char style="add">il mio nemico</char> partorisce iniquità<note caller="*" style="x"><char style="xo" closed="false">7.14 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="JOB 15:35">Giob. 15.35</ref>. <ref loc="JAS 1:15">Giac. 1.15</ref>.</char></note>;</para>
  <para style="q" vid="PSA 7:14">Egli ha conceputo affanno, e partorirà inganno.<verse eid="PSA 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15"/>Egli ha cavata una fossa, e l'ha affondata;</para>
  <para style="q" vid="PSA 7:15">Ma egli stesso è caduto nella fossa <char style="add">ch'egli</char> ha fatta<note caller="*" style="x"><char style="xo" closed="false">7.15 </char><char style="xk" closed="false">fatta </char><char style="xt" closed="false"><ref loc="EST 7:10">Est. 7.10</ref>. <ref loc="JOB 4:8">Giob. 4.8</ref>. <ref loc="PSA 9:15">Sal. 9.15</ref>. <ref loc="PRO 5:22">Prov. 5.22</ref>; <ref loc="PRO 26:27">26.27</ref>. <ref loc="ECC 10:8">Eccl. 10.8</ref>.</char></note>.<verse eid="PSA 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16"/>Il travaglio ch'egli dà <char style="add">altrui</char> gli ritornerà sopra la testa,</para>
  <para style="q" vid="PSA 7:16">E la sua violenza gli scenderà sopra la sommità del capo<note caller="*" style="x"><char style="xo" closed="false">7.16 </char><char style="xk" closed="false">capo </char><char style="xt" closed="false"><ref loc="1KI 2:32">1 Re. 2.32</ref>. <ref loc="EST 9:25">Est. 9.25</ref>.</char></note>.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17"/>Io loderò il Signore, secondo la sua giustizia;</para>
  <para style="q" vid="PSA 7:17">E salmeggerò il Nome del Signore Altissimo.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">SALMO VIII</para>
  <para style="s1">Dio glorificato per le sue opere e per la sua bontà inverso l'uomo</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Ghittit</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1"/>QUANT' <char style="add">è</char> magnifico il nome tuo per tutta la terra,</para>
  <para style="q" vid="PSA 8:1">O Signore, Signor nostro,</para>
  <para style="q" vid="PSA 8:1">Che hai posta la tua maestà sopra i cieli!<verse eid="PSA 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2"/>Per la bocca de' piccoli fanciulli, e di quelli che poppano,</para>
  <para style="q" vid="PSA 8:2">Tu hai fondata la tua gloria<note caller="*" style="x"><char style="xo" closed="false">8.2 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="MAT 11:25">Mat. 11.25</ref>; <ref loc="MAT 21:16">21.16</ref>. <ref loc="1CO 1:27">1 Cor. 1.27</ref>.</char></note>, per cagione de' tuoi nemici,</para>
  <para style="q" vid="PSA 8:2">Per far restare il nemico e il vendicatore.<verse eid="PSA 8:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3"/>Quando io veggo i tuoi cieli, <char style="add">che sono</char> opera delle tue dita;</para>
  <para style="q" vid="PSA 8:3">La luna e le stelle che tu hai disposte<note caller="*" style="x"><char style="xo" closed="false">8.3 </char><char style="xk" closed="false">disposte </char><char style="xt" closed="false"><ref loc="PSA 111:2">Sal. 111.2</ref>.</char></note>;<verse eid="PSA 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4"/>
    <char style="add">Io dico:</char> Che cosa <char style="add">è</char> l'uomo, che tu ne abbi memoria<note caller="*" style="x"><char style="xo" closed="false">8.4 </char><char style="xk" closed="false">memoria </char><char style="xt" closed="false"><ref loc="JOB 7:17">Giob. 7.17</ref>. <ref loc="PSA 144:3">Sal. 144.3</ref>.</char></note>?</para>
  <para style="q" vid="PSA 8:4">E <char style="add">che cosa è</char> il figliuolo dell'uomo, che tu ne prenda cura?<verse eid="PSA 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5"/>E che tu l'abbi fatto poco minor degli Angeli,</para>
  <para style="q" vid="PSA 8:5">E l'abbi coronato di gloria e d'onore?<verse eid="PSA 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6"/>E che tu lo faccia signoreggiare sopra le opere delle tue mani<note caller="*" style="x"><char style="xo" closed="false">8.6 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="GEN 1:26">Gen. 1.26</ref>,<ref loc="GEN 1:28">28</ref>.</char></note>,</para>
  <para style="q" vid="PSA 8:6">
    <char style="add">Ed</char> abbi posto ogni cosa sotto i suoi piedi<note caller="*" style="x"><char style="xo" closed="false">8.6 </char><char style="xk" closed="false">piedi </char><char style="xt" closed="false"><ref loc="1CO 15:27">1 Cor. 15.27</ref>. <ref loc="HEB 2:6-8">Ebr. 2.6-8</ref>.</char></note>?<verse eid="PSA 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7"/>Pecore e buoi tutti quanti,</para>
  <para style="q" vid="PSA 8:7">Ed anche le fiere della campagna,<verse eid="PSA 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8"/>Gli uccelli del cielo, e i pesci del mare,</para>
  <para style="q" vid="PSA 8:8">Che guizzano per li sentieri del mare.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9"/>O Signore, Signor nostro,</para>
  <para style="q" vid="PSA 8:9">Quanto <char style="add">è</char> magnifico il Nome tuo in tutta la terra!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">SALMO IX</para>
  <para style="s1">Ringraziamenti per una grande liberazione</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici sopra Almut-labben</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1"/>IO celebrerò, o Signore, con tutto il mio cuore;</para>
  <para style="q" vid="PSA 9:1">Io narrerò tutte le tue maraviglie.<verse eid="PSA 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2"/>Io mi rallegrerò, e festeggerò in te;</para>
  <para style="q" vid="PSA 9:2">Io salmeggerò il tuo Nome, o Altissimo;<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3"/>Perciocchè i miei nemici hanno volte le spalle;</para>
  <para style="q" vid="PSA 9:3">Son caduti, e periti d'innanzi alla tua faccia.<verse eid="PSA 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4"/>Conciossiachè tu mi abbi fatta ragione e diritto;</para>
  <para style="q" vid="PSA 9:4">Tu ti sei posto a sedere sopra il trono, <char style="add">come</char> giusto giudice.<verse eid="PSA 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5"/>Tu hai sgridate le nazioni, tu hai distrutto l'empio,</para>
  <para style="q" vid="PSA 9:5">Tu hai cancellato il loro nome in sempiterno<note caller="*" style="x"><char style="xo" closed="false">9.5 </char><char style="xk" closed="false">sempiterno </char><char style="xt" closed="false"><ref loc="PRO 10:7">Prov. 10.7</ref>.</char></note>.<verse eid="PSA 9:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6"/>O nemico, le desolazioni sono finite in perpetuo,</para>
  <para style="q" vid="PSA 9:6">E tu hai disfatte le città.</para>
  <para style="q" vid="PSA 9:6">È pur perita la memoria di esse.<verse eid="PSA 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7"/>Ma il Signore siede in eterno<note caller="*" style="x"><char style="xo" closed="false">9.7 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 102:12">Sal. 102.12</ref>,<ref loc="PSA 102:26">26</ref>. <ref loc="HEB 1:11">Ebr. 1.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 9:7">Egli ha fermato il suo trono per <char style="add">far</char> giudicio.<verse eid="PSA 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8"/>Ed egli giudicherà il mondo in giustizia<note caller="*" style="x"><char style="xo" closed="false">9.8 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 58:11">Sal. 58.11</ref>; <ref loc="PSA 96:13">96.13</ref>; <ref loc="PSA 98:9">98.9</ref>.</char></note>,</para>
  <para style="q" vid="PSA 9:8">Egli renderà giudicio a' popoli in dirittura.<verse eid="PSA 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9"/>E il Signore sarà un alto ricetto al misero;</para>
  <para style="q" vid="PSA 9:9">Un alto ricetto a' tempi <char style="add">ch'egli sarà</char> in distretta<note caller="*" style="x"><char style="xo" closed="false">9.9 </char><char style="xk" closed="false">distretta </char><char style="xt" closed="false"><ref loc="PSA 32:7">Sal. 32.7</ref>; <ref loc="PSA 37:39">37.39</ref>; <ref loc="PSA 46:1">46.1</ref>; <ref loc="PSA 91:2">91.2</ref>.</char></note>.<verse eid="PSA 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10"/>Laonde, o Signore, quelli che conoscono il Nome<note caller="*" style="x"><char style="xo" closed="false">9.10 </char><char style="xk" closed="false">Nome </char><char style="xt" closed="false"><ref loc="PSA 91:14">Sal. 91.14</ref>.</char></note> tuo si confideranno in te;</para>
  <para style="q" vid="PSA 9:10">Perciocchè tu non abbandoni quelli che ti cercano.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11"/>Salmeggiate al Signore che abita in Sion;</para>
  <para style="q" vid="PSA 9:11">Raccontate fra i popoli i suoi fatti.<verse eid="PSA 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12"/>Perciocchè egli ridomanda ragione del sangue<note caller="*" style="x"><char style="xo" closed="false">9.12 </char><char style="xk" closed="false">sangue </char><char style="xt" closed="false"><ref loc="GEN 9:5">Gen. 9.5</ref>. <ref loc="1KI 21:17">1 Re. 21.17</ref> ecc.</char></note>, egli se ne ricorda;</para>
  <para style="q" vid="PSA 9:12">Egli non dimentica il grido de' poveri afflitti.<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13"/>Abbi pietà di me, o Signore,</para>
  <para style="q" vid="PSA 9:13">Tu che mi tiri in alto dalle porte della morte,</para>
  <para style="q" vid="PSA 9:13">Vedi l'afflizione <char style="add">che io soffero</char> da quelli che m'odiano;<verse eid="PSA 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14"/>Acciocchè io racconti tutte le tue lodi</para>
  <para style="q" vid="PSA 9:14">Nelle porte della figliuola di Sion,</para>
  <para style="q" vid="PSA 9:14">
    <char style="add">E</char> festeggi della tua liberazione<note caller="*" style="x"><char style="xo" closed="false">9.14 </char><char style="xk" closed="false">liberazione </char><char style="xt" closed="false"><ref loc="PSA 13:5">Sal. 13.5</ref>; <ref loc="PSA 20:5">20.5</ref>; <ref loc="PSA 35:9">35.9</ref>.</char></note>.<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15"/>Le genti sono state affondate nella fossa che avevano fatta;</para>
  <para style="q" vid="PSA 9:15">Il lor piè è stato preso nella rete che avevano nascosta<note caller="*" style="x"><char style="xo" closed="false">9.15 </char><char style="xk" closed="false">nascosta </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16"/>Il Signore è stato conosciuto <char style="add">per</char> lo giudicio ch'egli ha fatto<note caller="*" style="x"><char style="xo" closed="false">9.16 </char><char style="xk" closed="false">fatto </char><char style="xt" closed="false"><ref loc="EXO 7:5">Esod. 7.5</ref>; <ref loc="EXO 14:4">14.4</ref>,<ref loc="EXO 14:10">10</ref>,<ref loc="EXO 14:31">31</ref>.</char></note>;</para>
  <para style="q" vid="PSA 9:16">L'empio è stato allacciato per l'opera delle sue proprie mani. <char style="qs">(Higgaion</char><note caller="+" style="f"><char style="fr" closed="false">9.16 </char><char style="fq" closed="false">Higgaion </char><char style="ft" closed="false">cioè: </char><char style="fk" closed="false">meditazione .</char></note><char style="qs">; Sela.)</char><verse eid="PSA 9:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17"/>Gli empi, tutte le genti <char style="add">che</char> dimenticano Iddio,</para>
  <para style="q" vid="PSA 9:17">Andranno in volta nell'inferno.<verse eid="PSA 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18"/>Perciocchè il povero non sarà dimenticato in sempiterno<note caller="*" style="x"><char style="xo" closed="false">9.18 </char><char style="xk" closed="false">sempiterno </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PSA 12">12</ref>. <ref loc="PSA 12:5">Sal. 12.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 9:18">La speranza de' poveri non perirà in perpetuo.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19"/>Levati, o Signore; non <char style="add">lasciar</char> che l'uomo si rinforzi;</para>
  <para style="q" vid="PSA 9:19">Sieno giudicate le genti davanti alla tua faccia.<verse eid="PSA 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20"/>Signore, metti spavento in loro;</para>
  <para style="q" vid="PSA 9:20">
    <char style="add">Fa</char>' che le genti conoscano, che <char style="add">non sono altro che</char> uomini. <char style="qs">(Sela.)</char><verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">SALMO X</para>
  <para style="s1">Audacia dei persecutori; ricorso a Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1"/>O SIGNORE, perchè te ne stai lontano?</para>
  <para style="q" vid="PSA 10:1">
    <char style="add">Perchè</char> ti nascondi a' tempi <char style="add">che siamo</char> in distretta?<verse eid="PSA 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2"/>L'empio colla sua superbia persegue il povero afflitto;</para>
  <para style="q" vid="PSA 10:2">
    <char style="add">Ma</char> saranno presi nelle macchinazioni che hanno fatte<note caller="*" style="x"><char style="xo" closed="false">10.2 </char><char style="xk" closed="false">fatte </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3"/>Perciocchè l'empio si gloria de' desiderii dell'anima sua;</para>
  <para style="q" vid="PSA 10:3">E benedice l'avaro<note caller="*" style="x"><char style="xo" closed="false">10.3 </char><char style="xk" closed="false">avaro </char><char style="xt" closed="false"><ref loc="PRO 28:4">Prov. 28.4</ref>. <ref loc="ROM 1:32">Rom. 1.32</ref>.</char></note>, <char style="add">e</char> dispetta il Signore.<verse eid="PSA 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4"/>L'empio, secondo l'alterezza del suo volto, non si cura <char style="add">di nulla</char>;</para>
  <para style="q" vid="PSA 10:4">Tutti i suoi pensieri <char style="add">sono, che</char> non <char style="add">vi è</char> Dio<note caller="*" style="x"><char style="xo" closed="false">10.4 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="PSA 14:1">Sal. 14.1</ref>; <ref loc="PSA 53:1">53.1</ref>.</char></note>.<verse eid="PSA 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5"/>Le sue vie son profane in ogni tempo;</para>
  <para style="q" vid="PSA 10:5">I tuoi giudicii gli sono una cosa troppo alta, <char style="add">per averli</char> davanti a sè<note caller="*" style="x"><char style="xo" closed="false">10.5 </char><char style="xk" closed="false">sè </char><char style="xt" closed="false"><ref loc="PRO 24:7">Prov. 24.7</ref>. <ref loc="ISA 26:11">Is. 26.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 10:5">Egli soffia contro a tutti i suoi nemici.<verse eid="PSA 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6"/>Egli dice nel suo cuore: Io non sarò <char style="add">giammai</char> smosso<note caller="*" style="x"><char style="xo" closed="false">10.6 </char><char style="xk" closed="false">smosso </char><char style="xt" closed="false"><ref loc="ECC 8:11">Eccl. 8.11</ref>. <ref loc="ISA 56:12">Is. 56.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 10:6">
    <char style="add">Egli dice</char>, che in veruna età non caderà in alcun male<note caller="*" style="x"><char style="xo" closed="false">10.6 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="REV 18:7">Apoc. 18.7</ref>.</char></note>.<verse eid="PSA 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7"/>La sua bocca è piena di esecrazione, e di frodi, e d'inganno<note caller="*" style="x"><char style="xo" closed="false">10.7 </char><char style="xk" closed="false">inganno </char><char style="xt" closed="false"><ref loc="PSA 12:2">Sal. 12.2</ref>. <ref loc="ROM 3:14">Rom. 3.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 10:7">Sotto la lingua sua <char style="add">vi è</char> perversità ed iniquità.<verse eid="PSA 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8"/>Egli sta negli agguati per le ville;</para>
  <para style="q" vid="PSA 10:8">Egli uccide l'innocente in luoghi nascosti;</para>
  <para style="q" vid="PSA 10:8">I suoi occhi spiano il povero.<verse eid="PSA 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9"/>Egli insidia il povero nel <char style="add">suo</char> nascondimento,</para>
  <para style="q" vid="PSA 10:9">Come il leone nella sua spelonca;</para>
  <para style="q" vid="PSA 10:9">Egli l'insidia per predarlo;</para>
  <para style="q" vid="PSA 10:9">Egli preda il povero, traendolo nella sua rete.<verse eid="PSA 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10"/>Egli se ne sta quatto e chino;</para>
  <para style="q" vid="PSA 10:10">E molti poveri caggiono nelle sue unghie.<verse eid="PSA 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11"/>Egli dice nel cuor suo: Iddio l'ha dimenticato;</para>
  <para style="q" vid="PSA 10:11">Egli ha nascosta la sua faccia, egli giammai non lo vedrà<note caller="*" style="x"><char style="xo" closed="false">10.11 </char><char style="xk" closed="false">vedrà </char><char style="xt" closed="false"><ref loc="PSA 73:11">Sal. 73.11</ref>. <ref loc="EZK 8:12">Ezec. 8.12</ref>; <ref loc="EZK 9:9">9.9</ref>.</char></note>.<verse eid="PSA 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12"/>Levati, Signore; o Dio, alza la tua mano;</para>
  <para style="q" vid="PSA 10:12">Non dimenticare i poveri afflitti.<verse eid="PSA 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13"/>Perchè l'empio dispetta egli Iddio?</para>
  <para style="q" vid="PSA 10:13">
    <char style="add">Perchè</char> dice <char style="add">egli</char> nel cuor suo, <char style="add">che</char> tu non <char style="add">ne</char> ridomanderai ragione<note caller="*" style="x"><char style="xo" closed="false">10.13 </char><char style="xk" closed="false">ragione </char><char style="xt" closed="false"><ref loc="PSA 9:12">Sal. 9.12</ref>.</char></note>?<verse eid="PSA 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14"/>Tu <char style="add">l</char>'hai pur veduto; perciocchè tu riguardi l'oltraggio e il dispetto,</para>
  <para style="q" vid="PSA 10:14">Per prendere <char style="add">il fatto</char> in mano.</para>
  <para style="q" vid="PSA 10:14">Il povero si rimette in te<note caller="*" style="x"><char style="xo" closed="false">10.14 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="2TI 1:12">2 Tim. 1.12</ref>. <ref loc="1PE 4:19">1 Piet. 4.19</ref>.</char></note>;</para>
  <para style="q" vid="PSA 10:14">Tu sei l'aiutatore dell'orfano<note caller="*" style="x"><char style="xo" closed="false">10.14 </char><char style="xk" closed="false">orfano </char><char style="xt" closed="false"><ref loc="PSA 68:5">Sal. 68.5</ref>. <ref loc="HOS 14:3">Os. 14.3</ref>.</char></note>.<verse eid="PSA 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15"/>Fiacca il braccio dell'empio;</para>
  <para style="q" vid="PSA 10:15">E <char style="add">poi, se</char> tu ricerchi l'empietà del malvagio, non la troverai <char style="add">più</char>.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16"/>Il Signore <char style="add">è</char> re in sempiterno<note caller="*" style="x"><char style="xo" closed="false">10.16 </char><char style="xk" closed="false">sempiterno </char><char style="xt" closed="false"><ref loc="PSA 145:13">Sal. 145.13</ref>. <ref loc="JER 10:10">Ger. 10.10</ref>. <ref loc="LAM 5:19">Lam. 5.19</ref>. <ref loc="1TI 1:17">1 Tim. 1.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 10:16">Le genti son perite dalla sua terra.<verse eid="PSA 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17"/>O Signore, tu esaudisci il desiderio degli umili;</para>
  <para style="q" vid="PSA 10:17">Tu raffermi il cuor loro, le tue orecchie sono attente a loro;<verse eid="PSA 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18"/>Per far ragione all'orfano e al povero<note caller="*" style="x"><char style="xo" closed="false">10.18 </char><char style="xk" closed="false">povero </char><char style="xt" closed="false"><ref loc="PSA 82:3">Sal. 82.3</ref>. <ref loc="ISA 11:4">Is. 11.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 10:18">Acciocchè l'uomo di terra non continui più ad usar violenza.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">SALMO XI</para>
  <para style="s1">Dio salva i suoi, e punisce gli empi</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1"/>IO mi confido nel Signore<note caller="*" style="x"><char style="xo" closed="false">11.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> e rif.; <ref loc="PSA 56:11">56.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 11:1">Come dite voi all'anima mia:</para>
  <para style="q" vid="PSA 11:1">Fuggite al vostro monte, <char style="add">come</char> un uccelletto<note caller="*" style="x"><char style="xo" closed="false">11.1 </char><char style="xk" closed="false">uccelletto </char><char style="xt" closed="false"><ref loc="1SA 26:19">1 Sam. 26.19</ref>,<ref loc="1SA 26:20">20</ref>.</char></note>?<verse eid="PSA 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2"/>Certo, ecco gli empi hanno teso l'arco,</para>
  <para style="q" vid="PSA 11:2">Hanno accoccate le lor saette in su la corda,</para>
  <para style="q" vid="PSA 11:2">Per tirar<char style="add">le</char> contro a' diritti di cuore, in luogo scuro<note caller="*" style="x"><char style="xo" closed="false">11.2 </char><char style="xk" closed="false">scuro </char><char style="xt" closed="false"><ref loc="PSA 64:3">Sal. 64.3</ref>,<ref loc="PSA 64:4">4</ref>.</char></note>.<verse eid="PSA 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3"/>Quando i fondamenti son ruinati,</para>
  <para style="q" vid="PSA 11:3">Che ha fatto il giusto?<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4"/>Il Signore <char style="add">è</char> nel Tempio della sua santità;</para>
  <para style="q" vid="PSA 11:4">Il trono del Signore <char style="add">è</char> ne' cieli<note caller="*" style="x"><char style="xo" closed="false">11.4 </char><char style="xk" closed="false">cieli </char><char style="xt" closed="false"><ref loc="ISA 66:1">Is. 66.1</ref>. <ref loc="MAT 5:34">Mat. 5.34</ref>; <ref loc="MAT 23:22">23.22</ref>. <ref loc="ACT 7:49">Fat. 7.49</ref>. <ref loc="REV 4:2">Apoc. 4.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 11:4">I suoi occhi veggono,</para>
  <para style="q" vid="PSA 11:4">Le sue palpebre esaminano i figliuoli degli uomini<note caller="*" style="x"><char style="xo" closed="false">11.4 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="PSA 33:13">Sal. 33.13</ref>; <ref loc="PSA 34:15">34.15</ref>,<ref loc="PSA 34:16">16</ref>.</char></note>.<verse eid="PSA 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5"/>Il Signore esamina il giusto<note caller="*" style="x"><char style="xo" closed="false">11.5 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="GEN 22:1">Gen. 22.1</ref>. <ref loc="JAS 1:12">Giac. 1.12</ref>.</char></note>, e l'empio;</para>
  <para style="q" vid="PSA 11:5">E l'anima sua odia colui che ama la violenza.<verse eid="PSA 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6"/>Egli farà piovere in su gli empi</para>
  <para style="q" vid="PSA 11:6">Brace, e fuoco, e solfo<note caller="*" style="x"><char style="xo" closed="false">11.6 </char><char style="xk" closed="false">solfo </char><char style="xt" closed="false"><ref loc="GEN 19:24">Gen. 19.24</ref>. <ref loc="EZK 38:22">Ezec. 38.22</ref>.</char></note>,</para>
  <para style="q" vid="PSA 11:6">E vento tempestoso, per la porzione del lor calice.<verse eid="PSA 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7"/>Perciocchè il Signore <char style="add">è</char> giusto; egli ama la giustizia;</para>
  <para style="q" vid="PSA 11:7">La sua faccia riguarda l'<char style="add">uomo</char> diritto<note caller="*" style="x"><char style="xo" closed="false">11.7 </char><char style="xk" closed="false">diritto </char><char style="xt" closed="false"><ref loc="JOB 36:7">Giob. 36.7</ref>. <ref loc="PSA 33:18">Sal. 33.18</ref>; <ref loc="PSA 34:15">34.15</ref>. <ref loc="1PE 3:12">1 Piet. 3.12</ref>.</char></note>.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">SALMO XII</para>
  <para style="s1">Menzogne degli uomini; veracità di Dio</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Seminit</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1"/>SALVA, Signore; perciocchè gli <char style="add">uomini</char> pii son venuti meno,</para>
  <para style="q" vid="PSA 12:1">Ed i veraci son mancati fra i figliuoli degli uomini<note caller="*" style="x"><char style="xo" closed="false">12.1 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="ISA 57:1">Is. 57.1</ref>. <ref loc="MIC 7:2">Mic. 7.2</ref>.</char></note>.<verse eid="PSA 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2"/>Ciascuno parla con menzogna col suo prossimo<note caller="*" style="x"><char style="xo" closed="false">12.2 </char><char style="xk" closed="false">prossimo </char><char style="xt" closed="false"><ref loc="PSA 10:7">Sal. 10.7</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 12:2">Con labbra lusinghiere;</para>
  <para style="q" vid="PSA 12:2">Parlano <char style="add">con</char> un cuor doppio<note caller="*" style="x"><char style="xo" closed="false">12.2 </char><char style="xk" closed="false">doppio </char><char style="xt" closed="false"><ref loc="JER 9:8">Ger. 9.8</ref>. <ref loc="ROM 16:18">Rom. 16.18</ref>.</char></note>.<verse eid="PSA 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3"/>Il Signore ricida tutte le labbra lusinghiere,</para>
  <para style="q" vid="PSA 12:3">La lingua che parla altieramente;<verse eid="PSA 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4"/>
    <char style="add">Di coloro</char> che dicono: Noi sarem padroni colle nostre lingue;</para>
  <para style="q" vid="PSA 12:4">Le nostre labbra <char style="add">sono</char> appo noi;</para>
  <para style="q" vid="PSA 12:4">Chi <char style="add">è</char> signore sopra noi?<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5"/>Per la desolazione de' poveri afflitti, per le strida de' bisognosi,</para>
  <para style="q" vid="PSA 12:5">Ora mi leverò<note caller="*" style="x"><char style="xo" closed="false">12.5 </char><char style="xk" closed="false">leverò </char><char style="xt" closed="false"><ref loc="EXO 3:7">Esod. 3.7</ref>,<ref loc="EXO 3:8">8</ref>.</char></note>, dice il Signore;</para>
  <para style="q" vid="PSA 12:5">Io metterò in salvo <char style="add">quelli</char> contro a cui <char style="add">coloro</char> parlano audacemente.<verse eid="PSA 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6"/>Le parole del Signore <char style="add">son</char> parole pure,</para>
  <para style="q" vid="PSA 12:6">Argento affinato nel fornello di terra,</para>
  <para style="q" vid="PSA 12:6">Purgato per sette volte<note caller="*" style="x"><char style="xo" closed="false">12.6 </char><char style="xk" closed="false">volte </char><char style="xt" closed="false"><ref loc="2SA 22:31">2 Sam. 22.31</ref>. <ref loc="PSA 19:8">Sal. 19.8</ref>; <ref loc="PSA 119:140">119.140</ref>. <ref loc="PRO 30:5">Prov. 30.5</ref>.</char></note>.<verse eid="PSA 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7"/>Tu, Signore, guarda coloro;</para>
  <para style="q" vid="PSA 12:7">Preservali da questa generazione in perpetuo.<verse eid="PSA 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8"/>Gli empi vanno attorno,</para>
  <para style="q" vid="PSA 12:8">Quando i più vili d'infra i figliuoli degli uomini sono innalzati.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">SALMO XIII</para>
  <para style="s1">Ricorso a Dio nella più estrema angoscia; giuliva fiducia in lui</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1"/>INFINO a quando, o Signore? mi dimenticherai tu in perpetuo?</para>
  <para style="q" vid="PSA 13:1">Infino a quando nasconderai la tua faccia da me<note caller="*" style="x"><char style="xo" closed="false">13.1 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="JOB 13:24">Giob. 13.24</ref>. <ref loc="ISA 59:2">Is. 59.2</ref>.</char></note>?<verse eid="PSA 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2"/>Infino a quando non farò altro tuttodì che consigliar nell'animo,</para>
  <para style="q" vid="PSA 13:2">Ed affannarmi nel cuore?</para>
  <para style="q" vid="PSA 13:2">Infino a quando s'innalzerà il mio nemico sopra me?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3"/>Riguarda, rispondimi, Signore Iddio mio;</para>
  <para style="q" vid="PSA 13:3">Illumina gli occhi miei,</para>
  <para style="q" vid="PSA 13:3">Che talora io non dorma <char style="add">il sonno del</char>la morte;<verse eid="PSA 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4"/>Che il mio nemico non dica: Io l'ho vinto;</para>
  <para style="q" vid="PSA 13:4">E che i miei nemici <char style="add">non</char> festeggino, se io caggio.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5"/>Ora, quant'è a me, io mi confido nella tua benignità;</para>
  <para style="q" vid="PSA 13:5">Il mio cuore giubilerà nella tua liberazione;<verse eid="PSA 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6"/>Io canterò al Signore, perciocchè egli mi avrà fatta la mia retribuzione.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">SALMO XIV</para>
  <para style="r">(Sal. 53)</para>
  <para style="s1">Estrema depravazione di quelli che negano Iddio</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1"/>LO stolto ha detto nel suo cuore: Non <char style="add">vi è</char> Dio<note caller="*" style="x"><char style="xo" closed="false">14.1 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="PSA 10:4">Sal. 10.4</ref>.</char></note>.</para>
  <para style="q" vid="PSA 14:1">Si son corrotti, son divenuti abbominevoli nelle <char style="add">loro</char> opere;</para>
  <para style="q" vid="PSA 14:1">Non <char style="add">vi è</char> alcuno che faccia bene<note caller="*" style="x"><char style="xo" closed="false">14.1 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="GEN 6:11">Gen. 6.11</ref>,<ref loc="GEN 6:12">12</ref>. <ref loc="ROM 3:10">Rom. 3.10</ref> ecc.</char></note>.<verse eid="PSA 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2"/>Il Signore ha riguardato dal cielo in su i figliuoli degli uomini<note caller="*" style="x"><char style="xo" closed="false">14.2 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="PSA 11:4">Sal. 11.4</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 14:2">Per veder se vi fosse alcuno che avesse intelletto,</para>
  <para style="q" vid="PSA 14:2">Che cercasse Iddio.<verse eid="PSA 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3"/>Tutti son guasti, tutti quanti son divenuti puzzolenti<note caller="*" style="x"><char style="xo" closed="false">14.3 </char><char style="xk" closed="false">puzzolenti </char><char style="xt" closed="false"><ref loc="JOB 14:4">Giob. 14.4</ref>; <ref loc="JOB 15:14-16">15.14-16</ref>.</char></note>;</para>
  <para style="q" vid="PSA 14:3">Non <char style="add">vi è</char> alcuno che faccia bene,</para>
  <para style="q" vid="PSA 14:3">Non pur uno.<verse eid="PSA 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4"/>Tutti questi operatori d'iniquità son essi senza intelletto?</para>
  <para style="q" vid="PSA 14:4">Essi mangiano il mio popolo<note caller="*" style="x"><char style="xo" closed="false">14.4 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="PRO 30:14">Prov. 30.14</ref>.</char></note>, <char style="add">come</char> se mangiassero del pane,</para>
  <para style="q" vid="PSA 14:4">
    <char style="add">E</char> non invocano il Signore.<verse eid="PSA 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5"/>Là saranno spaventati di <char style="add">grande</char> spavento<note caller="*" style="x"><char style="xo" closed="false">14.5 </char><char style="xk" closed="false">spavento </char><char style="xt" closed="false"><ref loc="ZEP 1:14">Sof. 1.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 14:5">Perciocchè Iddio <char style="add">è</char> colla gente giusta.<verse eid="PSA 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6"/>Fate voi onta al consiglio del povero afflitto,</para>
  <para style="q" vid="PSA 14:6">Perciocchè il Signore <char style="add">è</char> la sua confidanza<note caller="*" style="x"><char style="xo" closed="false">14.6 </char><char style="xk" closed="false">confidanza </char><char style="xt" closed="false"><ref loc="PSA 9:9">Sal. 9.9</ref>; <ref loc="PSA 142:5">142.5</ref>.</char></note>?<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7"/>Oh! venga pur da Sion la salute d'Israele<note caller="*" style="x"><char style="xo" closed="false">14.7 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="ROM 11:26">Rom. 11.26</ref>.</char></note>!</para>
  <para style="q" vid="PSA 14:7">Quando il Signore ritrarrà di cattività il suo popolo,</para>
  <para style="q" vid="PSA 14:7">Giacobbe festeggerà, Israele si rallegrerà<note caller="*" style="x"><char style="xo" closed="false">14.7 </char><char style="xk" closed="false">rallegrerà </char><char style="xt" closed="false"><ref loc="PSA 126:1">Sal. 126.1</ref>.</char></note>.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">SALMO XV</para>
  <para style="s1">Il vero cittadino del cielo</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1"/>O SIGNORE, chi dimorerà nel tuo tabernacolo<note caller="*" style="x"><char style="xo" closed="false">15.1 </char><char style="xk" closed="false">tabernacolo </char><char style="xt" closed="false"><ref loc="PSA 24:3">Sal. 24.3</ref> ecc.</char></note>?</para>
  <para style="q" vid="PSA 15:1">Chi abiterà nel monte della tua santità?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2"/>Colui che cammina in integrità, e fa ciò che è giusto<note caller="*" style="x"><char style="xo" closed="false">15.2 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="PSA 106:3">Sal. 106.3</ref>. <ref loc="ISA 33:15">Is. 33.15</ref>.</char></note>,</para>
  <para style="q" vid="PSA 15:2">E parla il vero di cuore<note caller="*" style="x"><char style="xo" closed="false">15.2 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="JHN 1:47">Giov. 1.47</ref>. <ref loc="EPH 4:25">Efes. 4.25</ref>.</char></note>;<verse eid="PSA 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3"/>Che non dice male colla sua lingua<note caller="*" style="x"><char style="xo" closed="false">15.3 </char><char style="xk" closed="false">lingua </char><char style="xt" closed="false"><ref loc="LEV 19:16">Lev. 19.16</ref>. <ref loc="PSA 34:13">Sal. 34.13</ref>.</char></note>,</para>
  <para style="q" vid="PSA 15:3">
    <char style="add">E</char> non fa male alcuno al suo compagno,</para>
  <para style="q" vid="PSA 15:3">E non leva alcun vituperio contro al suo prossimo<note caller="*" style="x"><char style="xo" closed="false">15.3 </char><char style="xk" closed="false">prossimo </char><char style="xt" closed="false"><ref loc="EXO 23:1">Esod. 23.1</ref>.</char></note>;<verse eid="PSA 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4"/>Appo cui è sprezzato chi deve esser riprovato<note caller="*" style="x"><char style="xo" closed="false">15.4 </char><char style="xk" closed="false">riprovato </char><char style="xt" closed="false"><ref loc="EST 3:2">Est. 3.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 15:4">E che onora quelli che temono il Signore;</para>
  <para style="q" vid="PSA 15:4">
    <char style="add">E il quale, se</char> ha giurato alcuna cosa,</para>
  <para style="q" vid="PSA 15:4">
    <char style="add">Benchè sia</char> a <char style="add">suo</char> danno, non però la ritratta<note caller="*" style="x"><char style="xo" closed="false">15.4 </char><char style="xk" closed="false">ritratta </char><char style="xt" closed="false"><ref loc="JDG 11:35">Giud. 11.35</ref>.</char></note>;<verse eid="PSA 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5"/>
    <char style="add">Il quale</char> non dà i suoi danari ad usura<note caller="*" style="x"><char style="xo" closed="false">15.5 </char><char style="xk" closed="false">usura </char><char style="xt" closed="false"><ref loc="EXO 22:25">Esod. 22.25</ref> </char><char style="xta" closed="false">e rif.</char></note>.</para>
  <para style="q" vid="PSA 15:5">E non prende presenti contro all'innocente<note caller="*" style="x"><char style="xo" closed="false">15.5 </char><char style="xk" closed="false">innocente </char><char style="xt" closed="false"><ref loc="EXO 23:8">Esod. 23.8</ref> </char><char style="xta" closed="false">e rif.</char></note>.</para>
  <para style="q" vid="PSA 15:5">Chi fa queste cose non sarà giammai smosso<note caller="*" style="x"><char style="xo" closed="false">15.5 </char><char style="xk" closed="false">smosso </char><char style="xt" closed="false"><ref loc="2PE 1:10">2 Piet. 1.10</ref>.</char></note>.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">SALMO XVI</para>
  <para style="s1">Confidanza e felicità del credente. Certezza della vita eterna</para>
  <para style="d">Orazione di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1"/>GUARDAMI, o Dio; perciocchè io mi confido in te<note caller="*" style="x"><char style="xo" closed="false">16.1 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 25:20">Sal. 25.20</ref>.</char></note>.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2"/>Io ho detto all'Eterno: Tu <char style="add">sei</char> il mio Signore;</para>
  <para style="q" vid="PSA 16:2">Io non ho bene all'infuori di te.<verse eid="PSA 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3"/>Tutta la mia affezione <char style="add">è</char> inverso i santi che sono in terra,</para>
  <para style="q" vid="PSA 16:3">E <char style="add">inverso</char> gli <char style="add">uomini</char> onorati.<verse eid="PSA 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4"/>I tormenti di coloro che corrono <char style="add">dietro ad</char> altri <char style="add">dii</char>, saran moltiplicati;</para>
  <para style="q" vid="PSA 16:4">Io non farò le loro offerte da spandere, <char style="add">che son</char> di sangue;</para>
  <para style="q" vid="PSA 16:4">E non mi recherò nelle labbra i nomi loro<note caller="*" style="x"><char style="xo" closed="false">16.4 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="EXO 23:13">Esod. 23.13</ref>. <ref loc="JOS 23:7">Gios. 23.7</ref>.</char></note>.<verse eid="PSA 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5"/>Il Signore <char style="add">è</char> la porzione della mia parte<note caller="*" style="x"><char style="xo" closed="false">16.5 </char><char style="xk" closed="false">parte </char><char style="xt" closed="false"><ref loc="DEU 32:9">Deut. 32.9</ref>. <ref loc="LUK 10:42">Luc. 10.42</ref>.</char></note>, e il mio calice;</para>
  <para style="q" vid="PSA 16:5">Tu, <char style="add">Signore</char>, mantieni quello che mi <char style="add">è</char> scaduto in sorte.<verse eid="PSA 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6"/>La sorte mi <char style="add">è</char> scaduta in <char style="add">luoghi</char> dilettevoli<note caller="*" style="x"><char style="xo" closed="false">16.6 </char><char style="xk" closed="false">dilettevoli </char><char style="xt" closed="false"><ref loc="PSA 105:11">Sal. 105.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 16:6">Una bella eredità mi è pur toccata.<verse eid="PSA 16:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7"/>Io benedirò il Signore, il qual mi consiglia;</para>
  <para style="q" vid="PSA 16:7">Eziandio le notti le mie reni mi ammaestrano.<verse eid="PSA 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8"/>Io ho sempre posto il Signore davanti agli occhi miei<note caller="*" style="x"><char style="xo" closed="false">16.8 </char><char style="xk" closed="false">miei </char><char style="xt" closed="false"><ref loc="ACT 2:25">Fat. 2.25</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 16:8">Perciocchè egli <char style="add">è</char> alla mia destra<note caller="*" style="x"><char style="xo" closed="false">16.8 </char><char style="xk" closed="false">destra </char><char style="xt" closed="false"><ref loc="PSA 73:23">Sal. 73.23</ref>; <ref loc="PSA 121:5">121.5</ref>.</char></note>, io non sarò giammai smosso.<verse eid="PSA 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9"/>Perciò il mio cuore si rallegra, e la mia lingua festeggia;</para>
  <para style="q" vid="PSA 16:9">Anzi pur la mia carne abiterà in sicurtà.<verse eid="PSA 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10"/>Perciocchè tu non lascerai l'anima mia nel sepolcro<note caller="*" style="x"><char style="xo" closed="false">16.10 </char><char style="xk" closed="false">sepolcro </char><char style="xt" closed="false"><ref loc="PSA 49:14">Sal. 49.14</ref>,<ref loc="PSA 49:15">15</ref>. <ref loc="1CO 15:55">1 Cor. 15.55</ref>.</char></note>,</para>
  <para style="q" vid="PSA 16:10">
    <char style="add">E</char> non permetterai che il tuo Santo<note caller="*" style="x"><char style="xo" closed="false">16.10 </char><char style="xk" closed="false">Santo </char><char style="xt" closed="false"><ref loc="PSA 89:19">Sal. 89.19</ref>. <ref loc="MRK 1:24">Mar. 1.24</ref>.</char></note> senta la corruzione della fossa<note caller="*" style="x"><char style="xo" closed="false">16.10 </char><char style="xk" closed="false">fossa </char><char style="xt" closed="false"><ref loc="ACT 2:27">Fat. 2.27</ref>,<ref loc="ACT 2:31">31</ref>; <ref loc="ACT 13:35">13.35</ref> ecc.</char></note>.<verse eid="PSA 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11"/>Tu mi mostrerai il sentier della vita<note caller="*" style="x"><char style="xo" closed="false">16.11 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="MAT 7:14">Mat. 7.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 16:11">Sazietà d'ogni gioia <char style="add">è</char> col tuo volto<note caller="*" style="x"><char style="xo" closed="false">16.11 </char><char style="xk" closed="false">volto </char><char style="xt" closed="false"><ref loc="PSA 17:15">Sal. 17.15</ref>. <ref loc="MAT 5:8">Mat. 5.8</ref>. <ref loc="1CO 13:12">1 Cor. 13.12</ref>. <ref loc="1JN 3:2">1 Giov. 3.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 16:11">Ogni diletto <char style="add">è</char> nella tua destra in sempiterno.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">SALMO XVII</para>
  <para style="s1">Davide domanda di esser liberato dai suoi nemici, fidando nella propria innocenza e nella giustizia di Dio</para>
  <para style="d">Mictam di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1"/>O SIGNORE, ascolta la giustizia, attendi al mio grido,</para>
  <para style="q" vid="PSA 17:1">Porgi l'orecchio alla mia orazione, <char style="add">che io ti fo</char> senza labbra di frode.<verse eid="PSA 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2"/>Proceda il mio giudicio dalla tua presenza;</para>
  <para style="q" vid="PSA 17:2">Gli occhi tuoi veggano le diritture.<verse eid="PSA 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3"/>Tu hai provato il mio cuore, tu <char style="add">l</char>'hai visitato di notte;</para>
  <para style="q" vid="PSA 17:3">Tu mi hai messo al cimento, e non hai trovato <char style="add">nulla</char><note caller="*" style="x"><char style="xo" closed="false">17.3 </char><char style="xk" closed="false"><char style="add">nulla</char> </char><char style="xt" closed="false"><ref loc="JOB 23:10">Giob. 23.10</ref>. <ref loc="1PE 1:7">1 Piet. 1.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 17:3">La mia bocca non trapassa il mio pensiero.<verse eid="PSA 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4"/>Nelle opere degli uomini, per la parola della tue labbra,</para>
  <para style="q" vid="PSA 17:4">Io mi son guardato dalle vie de' violenti.<verse eid="PSA 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5"/>Sostieni i miei passi ne' tuoi sentieri<note caller="*" style="x"><char style="xo" closed="false">17.5 </char><char style="xk" closed="false">sentieri </char><char style="xt" closed="false"><ref loc="PSA 119:133">Sal. 119.133</ref>. <ref loc="PRO 5:21">Prov. 5.21</ref>.</char></note>,</para>
  <para style="q" vid="PSA 17:5">Acciocchè i miei piedi non vacillino.<verse eid="PSA 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6"/>Io t'invoco, o Dio, perciocchè tu mi esaudisci<note caller="*" style="x"><char style="xo" closed="false">17.6 </char><char style="xk" closed="false">esaudisci </char><char style="xt" closed="false"><ref loc="PSA 116:2">Sal. 116.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 17:6">Inchina a me il tuo orecchio, ascolta le mie parole.<verse eid="PSA 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7"/>Dimostra maravigliose le tue benignità,</para>
  <para style="q" vid="PSA 17:7">O tu, che, con la tua destra, salvi quelli che si confidano <char style="add">in te</char>,</para>
  <para style="q" vid="PSA 17:7">Da quelli che si levano <char style="add">contro a loro</char>.<verse eid="PSA 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8"/>Guardami come la pupilla dell'occhio<note caller="*" style="x"><char style="xo" closed="false">17.8 </char><char style="xk" closed="false">occhio </char><char style="xt" closed="false"><ref loc="DEU 32:10">Deut. 32.10</ref>. <ref loc="ZEC 2:8">Zac. 2.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 17:8">Nascondimi sotto l'ombra delle tue ale<note caller="*" style="x"><char style="xo" closed="false">17.8 </char><char style="xk" closed="false">ale </char><char style="xt" closed="false"><ref loc="RUT 2:12">Rut 2.12</ref>. <ref loc="PSA 36:7">Sal. 36.7</ref>; <ref loc="PSA 57:1">57.1</ref>; <ref loc="PSA 91:1">91.1</ref>,<ref loc="PSA 91:4">4</ref>. <ref loc="MAT 23:37">Mat. 23.37</ref>.</char></note>,<verse eid="PSA 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9"/>D'innanzi agli empi che mi disertano;</para>
  <para style="q" vid="PSA 17:9">E <char style="add">d'innanzi</char> a' miei mortali nemici <char style="add">che</char> mi circondano.<verse eid="PSA 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10"/>Son tutti massicci di grasso<note caller="*" style="x"><char style="xo" closed="false">17.10 </char><char style="xk" closed="false">grasso </char><char style="xt" closed="false"><ref loc="DEU 32:15">Deut. 32.15</ref>. <ref loc="JOB 15:27">Giob. 15.27</ref>.</char></note>,</para>
  <para style="q" vid="PSA 17:10">Parlano altieramente colla lor bocca.<verse eid="PSA 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11"/>Ora c'intorniano, <char style="add">seguitandoci</char> alla traccia;</para>
  <para style="q" vid="PSA 17:11">Mirano con gli occhi, per atterrar<char style="add">ci</char><note caller="*" style="x"><char style="xo" closed="false">17.11 </char><char style="xk" closed="false">atterrar<char style="add">ci</char> </char><char style="xt" closed="false"><ref loc="1SA 23:26">1 Sam. 23.26</ref>. <ref loc="PSA 10:8-10">Sal. 10.8-10</ref>.</char></note>;<verse eid="PSA 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12"/>Somigliano un leone che brama di lacerare;</para>
  <para style="q" vid="PSA 17:12">E un leoncello che dimora in nascondimenti.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13"/>Levati, o Signore, va' loro incontro per affrontarli; abbattili;</para>
  <para style="q" vid="PSA 17:13">Riscuoti l'anima mia dall'empio <char style="add">col</char>la tua spada;<verse eid="PSA 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14"/>O Signore, <char style="add">riscuotila col</char>la tua mano dagli uomini, dagli uomini del mondo,</para>
  <para style="q" vid="PSA 17:14">La cui parte <char style="add">è</char> in <char style="add">questa</char> vita<note caller="*" style="x"><char style="xo" closed="false">17.14 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="LUK 16:25">Luc. 16.25</ref>. <ref loc="JAS 5:5">Giac. 5.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 17:14">E il cui ventre tu empi delle tue conserve;</para>
  <para style="q" vid="PSA 17:14">Onde i <char style="add">lor</char> figliuoli son saziati,</para>
  <para style="q" vid="PSA 17:14">E lasciano il lor rimanente a' lor piccoli fanciulli.<verse eid="PSA 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15"/>Quant'<char style="add">è</char> a me, per giustizia vedrò la tua faccia<note caller="*" style="x"><char style="xo" closed="false">17.15 </char><char style="xk" closed="false">faccia </char><char style="xt" closed="false"><ref loc="1JN 3:2">1 Giov. 3.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 17:15">Io sarò saziato della tua sembianza, quando io mi risveglierò<note caller="*" style="x"><char style="xo" closed="false">17.15 </char><char style="xk" closed="false">risveglierò </char><char style="xt" closed="false"><ref loc="PSA 4:6-8">Sal. 4.6-8</ref>; <ref loc="PSA 16:11">16.11</ref>; <ref loc="PSA 65:4">65.4</ref>.</char></note>.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">SALMO XVIII</para>
  <para style="r">(2 Sam. cap. <ref loc="PSA 22">22</ref>)</para>
  <para style="s1">Cantico di lode a Dio per le liberazioni ricevute</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide, servitor del Signore, il qual pronunziò le parole di questo cantico al Signore, nel giorno che il Signore l'ebbe riscosso dalla mano di tutti i suoi nemici, e dalla mano di Saulle; <char style="add">dato</char> al Capo de' Musici. Egli adunque disse:</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1"/>O SIGNORE, mia forza, io ti amerò affettuosamente<note caller="*" style="x"><char style="xo" closed="false">18.1 </char><char style="xk" closed="false">affettuosamente </char><char style="xt" closed="false"><ref loc="PSA 116:1">Sal. 116.1</ref>.</char></note>.</para>
  <para style="q" vid="PSA 18:1">Il Signore <char style="add">è</char> la mia rocca<note caller="*" style="x"><char style="xo" closed="false">18.1 </char><char style="xk" closed="false">rocca </char><char style="xt" closed="false"><ref loc="DEU 32:4">Deut. 32.4</ref>. <ref loc="PSA 19:14">Sal. 19.14</ref>; <ref loc="PSA 73:26">73.26</ref>; <ref loc="PSA 144:1">144.1</ref>,<ref loc="PSA 144:2">2</ref>.</char></note>, e la mia fortezza, e il mio liberatore,</para>
  <para style="q" vid="PSA 18:1">Il mio Dio, la mia rupe; io spererò in lui<note caller="*" style="x"><char style="xo" closed="false">18.1 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="HEB 2:13">Ebr. 2.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:1">Il mio scudo<note caller="*" style="x"><char style="xo" closed="false">18.1 </char><char style="xk" closed="false">scudo </char><char style="xt" closed="false"><ref loc="GEN 15:1">Gen. 15.1</ref> </char><char style="xta" closed="false">e rif.</char></note>, e il corno della mia salute<note caller="*" style="x"><char style="xo" closed="false">18.1 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="LUK 1:69">Luc. 1.69</ref>.</char></note>, il mio alto ricetto<note caller="*" style="x"><char style="xo" closed="false">18.1 </char><char style="xk" closed="false">ricetto </char><char style="xt" closed="false"><ref loc="PSA 9:9">Sal. 9.9</ref>; <ref loc="PSA 14:6">14.6</ref>. <ref loc="PRO 18:10">Prov. 18.10</ref>.</char></note>.<verse eid="PSA 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2"/>Io invocai il Signore, a cui si deve ogni lode;</para>
  <para style="q" vid="PSA 18:2">E fui salvato da' miei nemici.<verse eid="PSA 18:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3"/>Doglie di morte mi avevano circondato<note caller="*" style="x"><char style="xo" closed="false">18.3 </char><char style="xk" closed="false">circondato </char><char style="xt" closed="false"><ref loc="PSA 116:3">Sal. 116.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 18:3">E torrenti di scellerati mi avevano spaventato.<verse eid="PSA 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4"/>Legami di sepolcro mi avevano intorniato,</para>
  <para style="q" vid="PSA 18:4">Lacci di morte mi avevano incontrato.<verse eid="PSA 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5"/>Nella mia distretta io invocai il Signore,</para>
  <para style="q" vid="PSA 18:5">E gridai all'Iddio mio;</para>
  <para style="q" vid="PSA 18:5">
    <char style="add">Ed</char> egli udì la mia voce dal suo Tempio,</para>
  <para style="q" vid="PSA 18:5">E il mio grido pervenne davanti a lui a' suoi orecchi.<verse eid="PSA 18:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6"/>Allora la terra fu scossa, e tremò<note caller="*" style="x"><char style="xo" closed="false">18.6 </char><char style="xk" closed="false">tremò </char><char style="xt" closed="false"><ref loc="ACT 4:31">Fat. 4.31</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:6">E i fondamenti de' monti furono smossi</para>
  <para style="q" vid="PSA 18:6">E scrollati; perciocchè egli era acceso nell'ira.<verse eid="PSA 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7"/>Un fumo gli saliva per le nari,</para>
  <para style="q" vid="PSA 18:7">Ed un fuoco consumante per la bocca;</para>
  <para style="q" vid="PSA 18:7">Da lui procedevano brace accese.<verse eid="PSA 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8"/>Ed egli abbassò i cieli, e discese;</para>
  <para style="q" vid="PSA 18:8">E <char style="add">vi era</char> una caligine sotto a' suoi piedi<note caller="*" style="x"><char style="xo" closed="false">18.8 </char><char style="xk" closed="false">piedi </char><char style="xt" closed="false"><ref loc="PSA 144:5">Sal. 144.5</ref>.</char></note>.<verse eid="PSA 18:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9"/>E cavalcava sopra Cherubini<note caller="*" style="x"><char style="xo" closed="false">18.9 </char><char style="xk" closed="false">Cherubini </char><char style="xt" closed="false"><ref loc="PSA 99:1">Sal. 99.1</ref>.</char></note>, e volava;</para>
  <para style="q" vid="PSA 18:9">Ed era portato a volo sopra l'ale del vento<note caller="*" style="x"><char style="xo" closed="false">18.9 </char><char style="xk" closed="false">vento </char><char style="xt" closed="false"><ref loc="PSA 104:3">Sal. 104.3</ref>.</char></note>.<verse eid="PSA 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10"/>Egli aveva poste delle tenebre <char style="add">per</char> suo nascondimento;</para>
  <para style="q" vid="PSA 18:10">
    <char style="add">Egli avea</char> d'intorno a sè il suo padiglione,</para>
  <para style="q" vid="PSA 18:10">Oscurità d'acque, nubi dell'aria.<verse eid="PSA 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11"/>Le sue nubi si dileguarono per lo splendore <char style="add">che scoppiava</char> davanti a lui,</para>
  <para style="q" vid="PSA 18:11">Con gragnuola e brace accese.<verse eid="PSA 18:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12"/>E il Signore tuonò nel cielo,</para>
  <para style="q" vid="PSA 18:12">E l'Altissimo diede fuori la sua voce<note caller="*" style="x"><char style="xo" closed="false">18.12 </char><char style="xk" closed="false">voce </char><char style="xt" closed="false"><ref loc="PSA 29:3">Sal. 29.3</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 18:12">Con gragnuola e brace accese.<verse eid="PSA 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13"/>Ed avventò le sue saette, e disperse coloro<note caller="*" style="x"><char style="xo" closed="false">18.13 </char><char style="xk" closed="false">coloro </char><char style="xt" closed="false"><ref loc="JOS 10:10">Gios. 10.10</ref>,<ref loc="JOS 10:11">11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:13">Egli lanciò folgori, e li mise in rotta.<verse eid="PSA 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14"/>E per lo tuo sgridare, o Signore,</para>
  <para style="q" vid="PSA 18:14">
    <char style="add">E</char> per lo soffiar del vento delle tue nari,</para>
  <para style="q" vid="PSA 18:14">I canali delle acque apparvero<note caller="*" style="x"><char style="xo" closed="false">18.14 </char><char style="xk" closed="false">apparvero </char><char style="xt" closed="false"><ref loc="EXO 15:8">Esod. 15.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 18:14">E i fondamenti del mondo furono scoperti.<verse eid="PSA 18:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15"/>Egli da alto distese <char style="add">la mano e</char> mi prese,</para>
  <para style="q" vid="PSA 18:15">
    <char style="add">E</char> mi trasse, fuori di grandi acque.<verse eid="PSA 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16"/>Egli mi riscosse dal mio potente nemico,</para>
  <para style="q" vid="PSA 18:16">E da quelli che mi odiavano; perciocchè erano più forti di <char style="add">me</char>.<verse eid="PSA 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17"/>Essi erano venuti incontro a me nel giorno della mia calamità;</para>
  <para style="q" vid="PSA 18:17">Ma il Signore fu il mio sostegno;<verse eid="PSA 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18"/>E mi trasse fuori al largo;</para>
  <para style="q" vid="PSA 18:18">Egli mi liberò, perciocchè egli mi gradisce.<verse eid="PSA 18:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19"/>Il Signore mi ha fatta retribuzione secondo la mia giustizia<note caller="*" style="x"><char style="xo" closed="false">18.19 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="1SA 24:19">1 Sam. 24.19</ref>; <ref loc="1SA 26:23">26.23</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:19">Egli mi ha renduto secondo la purità delle mie mani;<verse eid="PSA 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20"/>Perciocchè io ho osservate le vie del Signore,</para>
  <para style="q" vid="PSA 18:20">E non mi sono empiamente rivolto dall'Iddio mio;<verse eid="PSA 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21"/>Perciocchè io ho tenute davanti a me tutte le sue leggi,</para>
  <para style="q" vid="PSA 18:21">E non ho rimossi d'innanzi a me i suoi statuti.<verse eid="PSA 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22"/>E sono stato intiero inverso lui,</para>
  <para style="q" vid="PSA 18:22">E mi son guardato dalla mia iniquità.<verse eid="PSA 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23"/>E il Signore mi ha renduto secondo la mia giustizia,</para>
  <para style="q" vid="PSA 18:23">Secondo la purità delle mie mani nel suo cospetto.<verse eid="PSA 18:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24"/>Tu ti mostri pietoso inverso l'<char style="add">uomo</char> pio<note caller="*" style="x"><char style="xo" closed="false">18.24 </char><char style="xk" closed="false">pio </char><char style="xt" closed="false"><ref loc="1KI 8:32">1 Re. 8.32</ref>.</char></note>,</para>
  <para style="q" vid="PSA 18:24">Intiero inverso l'uomo intiero.<verse eid="PSA 18:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25"/>Tu ti mostri puro col puro,</para>
  <para style="q" vid="PSA 18:25">E procedi ritrosamente col perverso<note caller="*" style="x"><char style="xo" closed="false">18.25 </char><char style="xk" closed="false">perverso </char><char style="xt" closed="false"><ref loc="LEV 26:23">Lev. 26.23</ref>,<ref loc="LEV 26:24">24</ref>,<ref loc="LEV 26:27">27</ref>,<ref loc="LEV 26:28">28</ref>. <ref loc="PRO 3:31">Prov. 3.31</ref>.</char></note>;<verse eid="PSA 18:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26"/>Perciocchè tu sei quel che salvi la gente afflitta,</para>
  <para style="q" vid="PSA 18:26">Ed abbassi gli occhi altieri;<verse eid="PSA 18:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27"/>Perciocchè tu sei quel che fai risplendere la mia lampana;</para>
  <para style="q" vid="PSA 18:27">Il Signore Iddio mio allumina le mie tenebre;<verse eid="PSA 18:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28"/>Perciocchè per la tua virtù io rompo tutta una schiera;</para>
  <para style="q" vid="PSA 18:28">E per la virtù dell'Iddio mio salgo sopra il muro.<verse eid="PSA 18:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29"/>La via di Dio <char style="add">è</char> intiera<note caller="*" style="x"><char style="xo" closed="false">18.29 </char><char style="xk" closed="false">intiera </char><char style="xt" closed="false"><ref loc="DEU 32:4">Deut. 32.4</ref>. <ref loc="REV 15:3">Apoc. 15.3</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:29">La parola del Signore <char style="add">è</char> purgata col fuoco<note caller="*" style="x"><char style="xo" closed="false">18.29 </char><char style="xk" closed="false">fuoco </char><char style="xt" closed="false"><ref loc="PSA 12:6">Sal. 12.6</ref>; <ref loc="PSA 119:140">119.140</ref>. <ref loc="PRO 30:5">Prov. 30.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:29">Egli <char style="add">è</char> lo scudo di tutti coloro che sperano in lui.<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30"/>Perciocchè chi <char style="add">è</char> Dio, fuor che il Signore<note caller="*" style="x"><char style="xo" closed="false">18.30 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="1SA 2:2">1 Sam. 2.2</ref>. <ref loc="ISA 45:5">Is. 45.5</ref>.</char></note>?</para>
  <para style="q" vid="PSA 18:30">E chi <char style="add">è</char> Rocca, fuor che l'Iddio nostro?<verse eid="PSA 18:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31"/>Iddio <char style="add">è</char> quel che mi cinge di prodezza,</para>
  <para style="q" vid="PSA 18:31">E che ha appianata la mia via.<verse eid="PSA 18:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32"/>Egli rende i miei piedi simili a quelli delle cerve,</para>
  <para style="q" vid="PSA 18:32">E mi fa star ritto in su i miei alti luoghi.<verse eid="PSA 18:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33"/>Egli ammaestra le mie mani alla battaglia;</para>
  <para style="q" vid="PSA 18:33">E colle mie braccia un arco di rame è rotto<note caller="*" style="x"><char style="xo" closed="false">18.33 </char><char style="xk" closed="false">rotto </char><char style="xt" closed="false"><ref loc="PSA 144:1">Sal. 144.1</ref>.</char></note>.<verse eid="PSA 18:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34"/>Tu mi hai ancora dato lo scudo della tua salvezza;</para>
  <para style="q" vid="PSA 18:34">E la tua destra mi ha sostenuto,</para>
  <para style="q" vid="PSA 18:34">E la tua benignità mi ha accresciuto.<verse eid="PSA 18:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35"/>Tu hai allargati i miei passi sotto di me;</para>
  <para style="q" vid="PSA 18:35">E le mie calcagna non son vacillate.<verse eid="PSA 18:35"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36"/>Io ho perseguitati i miei nemici, e li ho aggiunti;</para>
  <para style="q" vid="PSA 18:36">E non me ne son tornato <char style="add">indietro</char>, finchè non li abbia distrutti.<verse eid="PSA 18:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37"/>Io li ho rotti, e non son potuti risorgere;</para>
  <para style="q" vid="PSA 18:37">Mi son caduti sotto i piedi.<verse eid="PSA 18:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38"/>E tu mi hai cinto di prodezza per la guerra;</para>
  <para style="q" vid="PSA 18:38">
    <char style="add">Ed</char> hai abbattuti sotto di me quelli che si levavano contro a me.<verse eid="PSA 18:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39"/>Ed hai fatto voltar le spalle a' miei nemici davanti a me<note caller="*" style="x"><char style="xo" closed="false">18.39 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="EXO 23:27">Esod. 23.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:39">Ed io ho distrutti quelli che mi odiavano.<verse eid="PSA 18:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40"/>Essi gridarono, ma non <char style="add">vi fu</char> chi <char style="add">li</char> salvasse;</para>
  <para style="q" vid="PSA 18:40">
    <char style="add">Gridarono</char> al Signore, ma egli non rispose loro<note caller="*" style="x"><char style="xo" closed="false">18.40 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PRO 1:28">Prov. 1.28</ref>. <ref loc="ISA 1:15">Is. 1.15</ref>. <ref loc="MIC 3:4">Mic. 3.4</ref>. <ref loc="ZEC 7:13">Zac. 7.13</ref>.</char></note>.<verse eid="PSA 18:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41"/>Ed io li ho tritati, come polvere esposta al vento;</para>
  <para style="q" vid="PSA 18:41">Io li ho spazzati via, come il fango delle strade.<verse eid="PSA 18:41"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42"/>Tu mi hai scampato dalle brighe del popolo<note caller="*" style="x"><char style="xo" closed="false">18.42 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="2SA 2:8-10">2 Sam. 2.8-10</ref>; <ref loc="2SA 3:1">3.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:42">Tu mi hai costituito capo di nazioni<note caller="*" style="x"><char style="xo" closed="false">18.42 </char><char style="xk" closed="false">nazioni </char><char style="xt" closed="false"><ref loc="2SA 8:1-14">2 Sam. 8.1-14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 18:42">Il popolo <char style="add">che</char> io non conosceva mi è stato sottoposto<note caller="*" style="x"><char style="xo" closed="false">18.42 </char><char style="xk" closed="false">sottoposto </char><char style="xt" closed="false"><ref loc="ISA 55:5">Is. 55.5</ref>.</char></note>.<verse eid="PSA 18:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43"/>Al solo udir degli orecchi si son ridotti sotto la mia ubbidienza;</para>
  <para style="q" vid="PSA 18:43">Gli stranieri si sono infinti inverso me<note caller="*" style="x"><char style="xo" closed="false">18.43 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="DEU 33:29">Deut. 33.29</ref>.</char></note>.<verse eid="PSA 18:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44"/>Gli stranieri son divenuti fiacchi,</para>
  <para style="q" vid="PSA 18:44">Ed hanno tremato di paura, fin dentro a' lor ripari.<verse eid="PSA 18:44"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45"/>Viva il Signore, e benedetta <char style="add">sia</char> la mia Rocca;</para>
  <para style="q" vid="PSA 18:45">E sia esaltato l'Iddio della mia salute;<verse eid="PSA 18:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46"/>Iddio che mi dà <char style="add">il modo di far le mie</char> vendette,</para>
  <para style="q" vid="PSA 18:46">E <char style="add">che</char> mi sottomette i popoli.<verse eid="PSA 18:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47"/>Che mi scampa da' miei nemici,</para>
  <para style="q" vid="PSA 18:47">Ed anche mi solleva d'infra quelli che mi assaltano,</para>
  <para style="q" vid="PSA 18:47">
    <char style="add">E</char> mi riscuote dall'uomo violento.<verse eid="PSA 18:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48"/>Perciò, o Signore, io ti celebrerò fra le genti,</para>
  <para style="q" vid="PSA 18:48">E salmeggerò al tuo Nome<note caller="*" style="x"><char style="xo" closed="false">18.48 </char><char style="xk" closed="false">Nome </char><char style="xt" closed="false"><ref loc="ROM 15:9">Rom. 15.9</ref>.</char></note>;<verse eid="PSA 18:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49"/>Il quale rende magnifiche le vittorie del suo re,</para>
  <para style="q" vid="PSA 18:49">Ed usa benignità inverso Davide suo unto,</para>
  <para style="q" vid="PSA 18:49">E inverso la sua progenie in perpetuo<note caller="*" style="x"><char style="xo" closed="false">18.49 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"><ref loc="2SA 7:13">2 Sam. 7.13</ref>.</char></note>.<verse eid="PSA 18:49"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">SALMO XIX</para>
  <para style="s1">Eccellenza del creato e della Legge</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1"/>I CIELI raccontano la gloria di Dio<note caller="*" style="x"><char style="xo" closed="false">19.1 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="ISA 40:22">Is. 40.22</ref>. <ref loc="ROM 1:19">Rom. 1.19</ref>,<ref loc="ROM 1:20">20</ref>.</char></note>;</para>
  <para style="q" vid="PSA 19:1">E la distesa annunzia l'opera delle sue mani.<verse eid="PSA 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2"/>Un giorno dietro all'altro quelli sgorgano parole;</para>
  <para style="q" vid="PSA 19:2">Una notte dietro all'altra dichiarano scienza.<verse eid="PSA 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3"/>Non <char style="add">hanno</char> favella, nè parole;</para>
  <para style="q" vid="PSA 19:3">La lor voce non si ode;<verse eid="PSA 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4"/>Ma la lor linea esce fuori per tutta la terra,</para>
  <para style="q" vid="PSA 19:4">E le lor parole <char style="add">vanno</char> infino all'estremità del mondo<note caller="*" style="x"><char style="xo" closed="false">19.4 </char><char style="xk" closed="false">monto </char><char style="xt" closed="false"><ref loc="ROM 10:18">Rom. 10.18</ref>.</char></note>.</para>
  <para style="q" vid="PSA 19:4">
    <char style="add">Iddio</char> ha posto in essi un tabernacolo al sole;<verse eid="PSA 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5"/>Ed egli esce fuori, come uno sposo dalla sua camera di nozze;</para>
  <para style="q" vid="PSA 19:5">Egli gioisce, come un <char style="add">uomo</char> prode a correr l'aringo.<verse eid="PSA 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6"/>La sua uscita <char style="add">è</char> da una estremità de' cieli,</para>
  <para style="q" vid="PSA 19:6">E il suo giro <char style="add">arriva</char> infino all'<char style="add">altra</char> estremità;</para>
  <para style="q" vid="PSA 19:6">E niente è nascosto al suo calore.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7"/>La Legge del Signore <char style="add">è</char> perfetta, ella ristora l'anima;</para>
  <para style="q" vid="PSA 19:7">La testimonianza del Signore <char style="add">è</char> verace<note caller="*" style="x"><char style="xo" closed="false">19.7 </char><char style="xk" closed="false">verace </char><char style="xt" closed="false"><ref loc="PSA 111:7">Sal. 111.7</ref>; <ref loc="PSA 119:138">119.138</ref>.</char></note>, <char style="add">e</char> rende savio il semplice.<verse eid="PSA 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8"/>Gli statuti del Signore <char style="add">son</char> diritti, <char style="add">e</char> rallegrano il cuore;</para>
  <para style="q" vid="PSA 19:8">Il comandamento del Signore <char style="add">è</char> puro<note caller="*" style="x"><char style="xo" closed="false">19.8 </char><char style="xk" closed="false">puro </char><char style="xt" closed="false"><ref loc="PSA 12:6">Sal. 12.6</ref> </char><char style="xta" closed="false">e rif.</char></note>, ed illumina gli occhi.<verse eid="PSA 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9"/>Il timor del Signore <char style="add">è</char> puro, <char style="add">e</char> dimora in eterno;</para>
  <para style="q" vid="PSA 19:9">I giudicii del Signore <char style="add">son</char> verità, tutti quanti son giusti;<verse eid="PSA 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10"/>
    <char style="add">Sono</char> più desiderabili che oro, anzi più che gran quantità d'oro finissimo<note caller="*" style="x"><char style="xo" closed="false">19.10 </char><char style="xk" closed="false">finissimo </char><char style="xt" closed="false"><ref loc="PSA 119:72">Sal. 119.72</ref>,<ref loc="PSA 119:127">127</ref>. <ref loc="PRO 8:10">Prov. 8.10</ref>,<ref loc="PRO 8:11">11</ref>,<ref loc="PRO 8:19">19</ref>.</char></note>;</para>
  <para style="q" vid="PSA 19:10">E più dolci che miele, anzi che quello che stilla da' favi<note caller="*" style="x"><char style="xo" closed="false">19.10 </char><char style="xk" closed="false">favi </char><char style="xt" closed="false"><ref loc="PSA 119:103">Sal. 119.103</ref>.</char></note>.<verse eid="PSA 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11"/>Il tuo servitore è eziandio avvisato per essi<note caller="*" style="x"><char style="xo" closed="false">19.11 </char><char style="xk" closed="false">essi </char><char style="xt" closed="false"><ref loc="EXO 18:20">Esod. 18.20</ref>.</char></note>;</para>
  <para style="q" vid="PSA 19:11">
    <char style="add">Vi è</char> gran mercede in osservarli<note caller="*" style="x"><char style="xo" closed="false">19.11 </char><char style="xk" closed="false">osservarli </char><char style="xt" closed="false"><ref loc="PRO 29:18">Prov. 29.18</ref>.</char></note>.<verse eid="PSA 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12"/>Chi conosce i <char style="add">suoi</char> errori<note caller="*" style="x"><char style="xo" closed="false">19.12 </char><char style="xk" closed="false">errori </char><char style="xt" closed="false"><ref loc="JOB 13:23">Giob. 13.23</ref>. <ref loc="PSA 40:12">Sal. 40.12</ref>.</char></note>?</para>
  <para style="q" vid="PSA 19:12">Purgami di quelli che <char style="add">mi</char> sono occulti<note caller="*" style="x"><char style="xo" closed="false">19.12 </char><char style="xk" closed="false">occulti </char><char style="xt" closed="false"><ref loc="PSA 90:8">Sal. 90.8</ref>.</char></note>.<verse eid="PSA 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13"/>Rattieni eziandio il tuo servitore dalle superbie,</para>
  <para style="q" vid="PSA 19:13">E <char style="add">fa</char>'che non signoreggino in me<note caller="*" style="x"><char style="xo" closed="false">19.13 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="ROM 6:12-14">Rom. 6.12-14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 19:13">Allora io sarò intiero, e purgato di gran misfatto.<verse eid="PSA 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14"/>Sieno grate nel tuo cospetto le parole della mia bocca,</para>
  <para style="q" vid="PSA 19:14">E la meditazione del cuor mio,</para>
  <para style="q" vid="PSA 19:14">O Signore, mia Rocca<note caller="*" style="x"><char style="xo" closed="false">19.14 </char><char style="xk" closed="false">Rocca </char><char style="xt" closed="false"><ref loc="PSA 18:1">Sal. 18.1</ref> </char><char style="xta" closed="false">e rif.</char></note>, e mio Redentore<note caller="*" style="x"><char style="xo" closed="false">19.14 </char><char style="xk" closed="false">Redentore </char><char style="xt" closed="false"><ref loc="ISA 47:4">Is. 47.4</ref>. <ref loc="1TH 1:10">1 Tess. 1.10</ref>.</char></note>.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">SALMO XX</para>
  <para style="s1">Preghiera pel re in guerra</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1"/>IL Signore ti risponda nel giorno che tu sarai in distretta;</para>
  <para style="q" vid="PSA 20:1">Leviti ad alto in salvo il Nome dell'Iddio di Giacobbe<note caller="*" style="x"><char style="xo" closed="false">20.1 </char><char style="xk" closed="false">Giacobbe </char><char style="xt" closed="false"><ref loc="PRO 18:10">Prov. 18.10</ref>.</char></note>;<verse eid="PSA 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2"/>Manditi soccorso dal Santuario,</para>
  <para style="q" vid="PSA 20:2">E sostengati da Sion;<verse eid="PSA 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3"/>Ricordisi di tutte le tue offerte,</para>
  <para style="q" vid="PSA 20:3">E riduca in cenere il tuo olocausto. <char style="qs">(Sela.)</char><verse eid="PSA 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4"/>Diati <char style="add">ciò che è</char> secondo il cuor tuo,</para>
  <para style="q" vid="PSA 20:4">E adempia ogni tuo consiglio.<verse eid="PSA 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5"/>Noi canteremo di allegrezza per la tua vittoria,</para>
  <para style="q" vid="PSA 20:5">Ed alzeremo bandiere nel Nome dell'Iddio nostro<note caller="*" style="x"><char style="xo" closed="false">20.5 </char><char style="xk" closed="false">nostro </char><char style="xt" closed="false"><ref loc="EXO 17:15">Esod. 17.15</ref>. <ref loc="PSA 60:4">Sal. 60.4</ref>.</char></note>.</para>
  <para style="q" vid="PSA 20:5">Il Signore adempia tutte le tue domande.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6"/>Ora so, che il Signore ha salvato il suo unto<note caller="*" style="x"><char style="xo" closed="false">20.6 </char><char style="xk" closed="false">unto </char><char style="xt" closed="false"><ref loc="PSA 2:2">Sal. 2.2</ref>; <ref loc="PSA 18:49">18.49</ref>.</char></note>;</para>
  <para style="q" vid="PSA 20:6">Egli gli risponderà dal cielo della sua santità;</para>
  <para style="q" vid="PSA 20:6">La vittoria della sua destra <char style="add">è</char> con gran potenza.<verse eid="PSA 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7"/>Gli uni <char style="add">si fidano</char> in carri, e gli altri in cavalli<note caller="*" style="x"><char style="xo" closed="false">20.7 </char><char style="xk" closed="false">cavalli </char><char style="xt" closed="false"><ref loc="PSA 33:16">Sal. 33.16</ref>,<ref loc="PSA 33:17">17</ref>. <ref loc="PRO 21:31">Prov. 21.31</ref>. <ref loc="ISA 31:1">Is. 31.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 20:7">Ma noi ricorderemo il Nome del Signore Iddio nostro<note caller="*" style="x"><char style="xo" closed="false">20.7 </char><char style="xk" closed="false">nostro </char><char style="xt" closed="false"><ref loc="2CH 32:8">2 Cron. 32.8</ref>.</char></note>.<verse eid="PSA 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8"/>Quelli sono andati in giù, e son caduti;</para>
  <para style="q" vid="PSA 20:8">Ma noi siamo restati in piè, e ci siam rizzati.<verse eid="PSA 20:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9"/>Salva, Signore;</para>
  <para style="q" vid="PSA 20:9">Rispondaci il re nel giorno che noi grideremo.<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">SALMO XXI</para>
  <para style="s1">Ringraziamento per la vittoria</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1"/>SIGNORE, il re si rallegrerà nella tua forza;</para>
  <para style="q" vid="PSA 21:1">E quanto festeggerà egli grandemente della tua vittoria<note caller="*" style="x"><char style="xo" closed="false">21.1 </char><char style="xk" closed="false">vittoria </char><char style="xt" closed="false"><ref loc="PSA 20:5">Sal. 20.5</ref> ecc.</char></note>!<verse eid="PSA 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2"/>Tu gli hai dato il desio del suo cuore,</para>
  <para style="q" vid="PSA 21:2">E non <char style="add">gli</char> hai rifiutato quel ch'egli ha pronunziato colle sue labbra. <char style="qs">(Sela.)</char><verse eid="PSA 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3"/>Perciocchè tu gli sei venuto incontro con benedizioni di beni;</para>
  <para style="q" vid="PSA 21:3">Tu gli hai posta in sul capo una corona d'oro finissimo<note caller="*" style="x"><char style="xo" closed="false">21.3 </char><char style="xk" closed="false">finissimo </char><char style="xt" closed="false"><ref loc="2SA 12:30">2 Sam. 12.30</ref>.</char></note>.<verse eid="PSA 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4"/>Egli ti aveva chiesta vita.</para>
  <para style="q" vid="PSA 21:4">
    <char style="add">E</char> tu gli hai dato lunghezza di giorni in perpetuo<note caller="*" style="x"><char style="xo" closed="false">21.4 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"><ref loc="2SA 7:19">2 Sam. 7.19</ref>.</char></note>.<verse eid="PSA 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5"/>La sua gloria <char style="add">è</char> grande per la tua vittoria;</para>
  <para style="q" vid="PSA 21:5">Tu hai messa sopra lui maestà e magnificenza;<verse eid="PSA 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6"/>Perciocchè tu l'hai posto <char style="add">in</char> benedizioni in perpetuo;</para>
  <para style="q" vid="PSA 21:6">Tu l'hai rallegrato di letizia col tuo volto<note caller="*" style="x"><char style="xo" closed="false">21.6 </char><char style="xk" closed="false">volto </char><char style="xt" closed="false"><ref loc="PSA 16:11">Sal. 16.11</ref>; <ref loc="PSA 45:7">45.7</ref>. <ref loc="ACT 2:28">Fat. 2.28</ref>.</char></note>.<verse eid="PSA 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 21:7"/>Perciocchè il re si confida nel Signore,</para>
  <para style="q" vid="PSA 21:7">E nella benignità dell'Altissimo, egli non sarà <char style="add">giammai</char> smosso.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8"/>La tua mano troverà tutti i tuoi nemici;</para>
  <para style="q" vid="PSA 21:8">La tua destra troverà quelli che t'odiano.<verse eid="PSA 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9"/>Tu li renderai simili ad un forno ardente,</para>
  <para style="q" vid="PSA 21:9">Al tempo della tua ira;</para>
  <para style="q" vid="PSA 21:9">Il Signore li abisserà nel suo cruccio,</para>
  <para style="q" vid="PSA 21:9">E il fuoco li divorerà.<verse eid="PSA 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10"/>Tu farai perire il frutto loro d'in sulla terra,</para>
  <para style="q" vid="PSA 21:10">E la lor progenie d'infra i figliuoli degli uomini;<verse eid="PSA 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11"/>Perciocchè hanno ordito del male contro a te,</para>
  <para style="q" vid="PSA 21:11">Ed hanno divisata una malizia, <char style="add">della quale però</char> non potranno <char style="add">venire a capo</char><note caller="*" style="x"><char style="xo" closed="false">21.11 </char><char style="xk" closed="false">capo </char><char style="xt" closed="false"><ref loc="PSA 2:1">Sal. 2.1</ref>.</char></note>.<verse eid="PSA 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12"/>Perciocchè tu li metterai per tuo bersaglio;</para>
  <para style="q" vid="PSA 21:12">Tu tirerai diritto colle corde <char style="add">de</char>'tuoi <char style="add">archi</char> contro alla lor faccia.<verse eid="PSA 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13"/>Innalzati, Signore, colla tua forza;</para>
  <para style="q" vid="PSA 21:13">Noi canteremo, e salmeggeremo la tua potenza.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">SALMO XXII</para>
  <para style="s1">Il Messia sofferente, poi trionfante</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Aielet-hassahar</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1"/>DIO mio, Dio mio, perchè mi hai lasciato<note caller="*" style="x"><char style="xo" closed="false">22.1 </char><char style="xk" closed="false">lasciato </char><char style="xt" closed="false"><ref loc="MAT 27:46">Mat. 27.46</ref>. <ref loc="MRK 15:34">Mar. 15.34</ref>.</char></note>?</para>
  <para style="q" vid="PSA 22:1">
    <char style="add">Perchè stai</char> lontano dalla mia salute, <char style="add">e dalle</char> parole del mio ruggire<note caller="*" style="x"><char style="xo" closed="false">22.1 </char><char style="xk" closed="false">ruggire </char><char style="xt" closed="false"><ref loc="HEB 5:7">Ebr. 5.7</ref>.</char></note>?<verse eid="PSA 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2"/>O Dio mio, io grido di giorno, e tu non rispondi;</para>
  <para style="q" vid="PSA 22:2">Di notte ancora, e non ho posa alcuna.<verse eid="PSA 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3"/>E pur tu <char style="add">sei</char> il Santo,</para>
  <para style="q" vid="PSA 22:3">Il Permanente, le lodi d'Israele.<verse eid="PSA 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4"/>I nostri padri si son confidati in te;</para>
  <para style="q" vid="PSA 22:4">Si son confidati <char style="add">in te</char>, e tu li hai liberati<note caller="*" style="x"><char style="xo" closed="false">22.4 </char><char style="xk" closed="false">liberati </char><char style="xt" closed="false"><ref loc="JDG 3:9">Giud. 3.9</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5"/>Gridarono a te, e furon liberati;</para>
  <para style="q" vid="PSA 22:5">In te si confidarono, e non furon confusi<note caller="*" style="x"><char style="xo" closed="false">22.5 </char><char style="xk" closed="false">confusi </char><char style="xt" closed="false"><ref loc="ROM 9:33">Rom. 9.33</ref>.</char></note>.<verse eid="PSA 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6"/>Ma io <char style="add">sono</char> un verme, e non un uomo;</para>
  <para style="q" vid="PSA 22:6">Il vituperio degli uomini, e lo sprezzato fra il popolo<note caller="*" style="x"><char style="xo" closed="false">22.6 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="ISA 49:7">Is. 49.7</ref>; <ref loc="ISA 53:3">53.3</ref>.</char></note>.<verse eid="PSA 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7"/>Chiunque mi vede, si beffa di me<note caller="*" style="x"><char style="xo" closed="false">22.7 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="MAT 27:39-44">Mat. 27.39-44</ref>. <ref loc="MRK 15:29-32">Mar. 15.29-32</ref>. <ref loc="LUK 23:35">Luc. 23.35</ref>,<ref loc="LUK 23:36">36</ref>.</char></note>,</para>
  <para style="q" vid="PSA 22:7">
    <char style="add">Mi</char> stende il labbro, <char style="add">e</char> scuote il capo;<verse eid="PSA 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8"/>
    <char style="add">Dicendo:</char> Egli si rimette nel Signore; liberilo dunque;</para>
  <para style="q" vid="PSA 22:8">Riscuotalo, poichè egli lo gradisce<note caller="*" style="x"><char style="xo" closed="false">22.8 </char><char style="xk" closed="false">gradisce </char><char style="xt" closed="false"><ref loc="PSA 91:14">Sal. 91.14</ref>.</char></note>.<verse eid="PSA 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9"/>Certo, tu <char style="add">sei quel</char> che mi hai tratto fuor del seno;</para>
  <para style="q" vid="PSA 22:9">Tu mi hai affidato <char style="add">da che io era</char> alle mammelle di mia madre.<verse eid="PSA 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10"/>Io fui gettato sopra te dalla matrice;</para>
  <para style="q" vid="PSA 22:10">Tu <char style="add">sei</char> il mio Dio fin dal seno di mia madre.<verse eid="PSA 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11"/>Non allontanarti da me; perciocchè l'angoscia <char style="add">è</char> vicina,</para>
  <para style="q" vid="PSA 22:11">E non <char style="add">vi è</char> alcuno che <char style="add">mi</char> aiuti.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12"/>Grandi tori mi hanno circondato;</para>
  <para style="q" vid="PSA 22:12">Possenti tori di Basan mi hanno intorniato;<verse eid="PSA 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13"/>Hanno aperta la lor gola contro a me,</para>
  <para style="q" vid="PSA 22:13">
    <char style="add">Come</char> un leone rapace e ruggente.<verse eid="PSA 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14"/>Io mi scolo come acqua,</para>
  <para style="q" vid="PSA 22:14">E tutte le mie ossa si scommettono;</para>
  <para style="q" vid="PSA 22:14">Il mio cuore è come cera,</para>
  <para style="q" vid="PSA 22:14">
    <char style="add">E</char> si strugge nel mezzo delle mie interiora.<verse eid="PSA 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15"/>Il mio vigore è asciutto come un testo<note caller="*" style="x"><char style="xo" closed="false">22.15 </char><char style="xk" closed="false">testo </char><char style="xt" closed="false"><ref loc="PRO 17:22">Prov. 17.22</ref>.</char></note>,</para>
  <para style="q" vid="PSA 22:15">E la mia lingua è attaccata alla mia gola<note caller="*" style="x"><char style="xo" closed="false">22.15 </char><char style="xk" closed="false">gola </char><char style="xt" closed="false"><ref loc="JHN 19:28">Giov. 19.28</ref>.</char></note>;</para>
  <para style="q" vid="PSA 22:15">Tu mi hai posto nella polvere della morte.<verse eid="PSA 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16"/>Perciocchè cani mi hanno circondato;</para>
  <para style="q" vid="PSA 22:16">Uno stuolo di maligni mi ha intorniato;</para>
  <para style="q" vid="PSA 22:16">Essi mi hanno forate le mani ed i piedi<note caller="*" style="x"><char style="xo" closed="false">22.16 </char><char style="xk" closed="false">piedi </char><char style="xt" closed="false"><ref loc="LUK 23:33">Luc. 23.33</ref>. <ref loc="JHN 19:37">Giov. 19.37</ref>; <ref loc="JHN 20:25">20.25</ref>.</char></note>.<verse eid="PSA 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17"/>Io posso contar tutte le mie ossa;</para>
  <para style="q" vid="PSA 22:17">Essi mi riguardano, <char style="add">e</char> mi considerano<note caller="*" style="x"><char style="xo" closed="false">22.17 </char><char style="xk" closed="false">considerano </char><char style="xt" closed="false"><ref loc="LUK 23:27">Luc. 23.27</ref>,<ref loc="LUK 23:35">35</ref>.</char></note>.<verse eid="PSA 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18"/>Si spartiscono fra loro i miei vestimenti,</para>
  <para style="q" vid="PSA 22:18">E tranno la sorte sopra la mia vesta<note caller="*" style="x"><char style="xo" closed="false">22.18 </char><char style="xk" closed="false">vesta </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat. 27.35</ref>. <ref loc="LUK 23:34">Luc. 23.34</ref>. <ref loc="JHN 19:23">Giov. 19.23</ref>,<ref loc="JHN 19:24">24</ref>.</char></note>.<verse eid="PSA 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19"/>Tu dunque, Signore, non allontanarti;</para>
  <para style="q" vid="PSA 22:19">
    <char style="add">Tu che sei la</char> mia forza, affrettati a soccorrermi.<verse eid="PSA 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20"/>Riscuoti l'anima mia dalla spada,</para>
  <para style="q" vid="PSA 22:20">L'unica mia dalla branca del cane.<verse eid="PSA 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21"/>Salvami dalla gola del leone<note caller="*" style="x"><char style="xo" closed="false">22.21 </char><char style="xk" closed="false">leone </char><char style="xt" closed="false"><ref loc="2TI 4:17">2 Tim. 4.17</ref>.</char></note>,</para>
  <para style="q" vid="PSA 22:21">Ed esaudiscimi, <char style="add">liberandomi</char> dalle corna de' liocorni.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22"/>Io racconterò il tuo Nome a' miei fratelli<note caller="*" style="x"><char style="xo" closed="false">22.22 </char><char style="xk" closed="false">fratelli </char><char style="xt" closed="false"><ref loc="ROM 8:29">Rom. 8.29</ref>. <ref loc="HEB 2:12">Ebr. 2.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 22:22">Io ti loderò in mezzo della raunanza.<verse eid="PSA 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23"/>
    <char style="add">Voi</char> che temete il Signore, lodatelo;</para>
  <para style="q" vid="PSA 22:23">Glorificatelo <char style="add">voi</char>, tutta la progenie di Giacobbe;</para>
  <para style="q" vid="PSA 22:23">E <char style="add">voi</char> tutta la generazione d'Israele, abbiate timor di lui.<verse eid="PSA 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24"/>Perciocchè egli non ha sprezzata, nè disdegnata l'afflizione dell'afflitto;</para>
  <para style="q" vid="PSA 22:24">E non ha nascosta la sua faccia da lui;</para>
  <para style="q" vid="PSA 22:24">E quando ha gridato a lui, l'ha esaudito<note caller="*" style="x"><char style="xo" closed="false">22.24 </char><char style="xk" closed="false">esaudito </char><char style="xt" closed="false"><ref loc="HEB 5:7">Ebr. 5.7</ref>.</char></note>.<verse eid="PSA 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25"/>Da te <char style="add">io ho</char> l'argomento della mia lode in grande raunanza<note caller="*" style="x"><char style="xo" closed="false">22.25 </char><char style="xk" closed="false">raunanza </char><char style="xt" closed="false"><ref loc="PSA 35:18">Sal. 35.18</ref>; <ref loc="PSA 40:9">40.9</ref>,<ref loc="PSA 40:10">10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 22:25">Io adempirò i miei voti<note caller="*" style="x"><char style="xo" closed="false">22.25 </char><char style="xk" closed="false">voti </char><char style="xt" closed="false"><ref loc="ECC 5:4">Eccl. 5.4</ref>.</char></note> in presenza di quelli che ti temono.<verse eid="PSA 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26"/>I mansueti mangeranno, e saranno saziati<note caller="*" style="x"><char style="xo" closed="false">22.26 </char><char style="xk" closed="false">saziati </char><char style="xt" closed="false"><ref loc="JHN 6:51">Giov. 6.51</ref>.</char></note>;</para>
  <para style="q" vid="PSA 22:26">Que' che cercano il Signore lo loderanno;</para>
  <para style="q" vid="PSA 22:26">Il vostro cuore viverà in perpetuo.<verse eid="PSA 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27"/>Tutte le estremità della terra ne avranno memoria,</para>
  <para style="q" vid="PSA 22:27">E si convertiranno al Signore<note caller="*" style="x"><char style="xo" closed="false">22.27 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 2:8">Sal. 2.8</ref>. <ref loc="ISA 49:6">Is. 49.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 22:27">E tutte le nazioni delle genti adoreranno nel suo cospetto.<verse eid="PSA 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28"/>Perciocchè al Signore <char style="add">appartiene</char> il regno<note caller="*" style="x"><char style="xo" closed="false">22.28 </char><char style="xk" closed="false">regno </char><char style="xt" closed="false"><ref loc="ZEC 14:9">Zac. 14.9</ref>. <ref loc="MAT 6:13">Mat. 6.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 22:28">Ed <char style="add">egli è quel</char> che signoreggia sopra le genti.<verse eid="PSA 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29"/>Tutti i grassi della terra mangeranno ed adoreranno;</para>
  <para style="q" vid="PSA 22:29">
    <char style="add">Parimente</char> tutti quelli che scendono nella polvere,</para>
  <para style="q" vid="PSA 22:29">E che non possono mantenersi in vita, s'inchineranno davanti a lui<note caller="*" style="x"><char style="xo" closed="false">22.29 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="ISA 26:19">Is. 26.19</ref>. <ref loc="PHP 2:10">Fil. 2.10</ref>,<ref loc="PHP 2:11">11</ref>.</char></note>.<verse eid="PSA 22:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30"/>La <char style="add">lor</char> posterità gli servirà;</para>
  <para style="q" vid="PSA 22:30">Ella sarà annoverata per generazione al Signore.<verse eid="PSA 22:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31"/>Essi verranno, ed annunzieranno la sua giustizia<note caller="*" style="x"><char style="xo" closed="false">22.31 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 78:6">Sal. 78.6</ref>; <ref loc="PSA 86:9">86.9</ref>; <ref loc="PSA 102:18">102.18</ref>. <ref loc="ISA 60:3">Is. 60.3</ref>. <ref loc="ROM 3:21">Rom. 3.21</ref>,<ref loc="ROM 3:22">22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 22:31">
    <char style="add">Ed</char> alla gente che ha da nascere ciò ch'egli avrà operato.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">SALMO XXIII</para>
  <para style="s1">Felicità e sicurezza di chi ha Dio per suo pastore</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1"/>IL Signore <char style="add">è</char> il mio pastore<note caller="*" style="x"><char style="xo" closed="false">23.1 </char><char style="xk" closed="false">pastore </char><char style="xt" closed="false"><ref loc="ISA 40:11">Is. 40.11</ref>. <ref loc="EZK 34:11">Ezec. 34.11</ref> ecc.; <ref loc="EZK 23">23</ref> ecc. <ref loc="JHN 10:11">Giov. 10.11</ref>. <ref loc="1PE 2:25">1 Piet. 2.25</ref>. <ref loc="REV 7:16">Apoc. 7.16</ref>.</char></note>: nulla mi mancherà<note caller="*" style="x"><char style="xo" closed="false">23.1 </char><char style="xk" closed="false">mancherà </char><char style="xt" closed="false"><ref loc="PHP 4:19">Fil. 4.19</ref>.</char></note>.<verse eid="PSA 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2"/>Egli mi fa giacere in paschi erbosi<note caller="*" style="x"><char style="xo" closed="false">23.2 </char><char style="xk" closed="false">erbosi </char><char style="xt" closed="false"><ref loc="EZK 34:14">Ezec. 34.14</ref>,<ref loc="EZK 34:15">15</ref>.</char></note>,</para>
  <para style="q" vid="PSA 23:2">Mi guida lungo le acque chete<note caller="*" style="x"><char style="xo" closed="false">23.2 </char><char style="xk" closed="false">chete </char><char style="xt" closed="false"><ref loc="ISA 49:10">Is. 49.10</ref>. <ref loc="REV 7:16">Apoc. 7.16</ref>.</char></note>.<verse eid="PSA 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3"/>Egli mi ristora l'anima;</para>
  <para style="q" vid="PSA 23:3">Egli mi conduce per sentieri di giustizia<note caller="*" style="x"><char style="xo" closed="false">23.3 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 5:8">Sal. 5.8</ref>; <ref loc="PSA 143:10">143.10</ref>. <ref loc="PRO 8:20">Prov. 8.20</ref>.</char></note>,</para>
  <para style="q" vid="PSA 23:3">Per amor del suo Nome.<verse eid="PSA 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4"/>Avvegnachè io camminassi nella valle dell'ombra della morte,</para>
  <para style="q" vid="PSA 23:4">Io non temerei male <char style="add">alcuno</char><note caller="*" style="x"><char style="xo" closed="false">23.4 </char><char style="xk" closed="false"><char style="add">alcuno</char> </char><char style="xt" closed="false"><ref loc="PSA 3:6">Sal. 3.6</ref>; <ref loc="PSA 27:1">27.1</ref>,<ref loc="PSA 27:3">3</ref>; <ref loc="PSA 118:6">118.6</ref>.</char></note>; perciocchè tu <char style="add">sei</char> meco<note caller="*" style="x"><char style="xo" closed="false">23.4 </char><char style="xk" closed="false">meco </char><char style="xt" closed="false"><ref loc="ISA 43:2">Is. 43.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 23:4">La tua bacchetta, e la tua verga mi consolano.<verse eid="PSA 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5"/>Tu apparecchi davanti a me la mensa<note caller="*" style="x"><char style="xo" closed="false">23.5 </char><char style="xk" closed="false">mensa </char><char style="xt" closed="false"><ref loc="PSA 78:19">Sal. 78.19</ref>; <ref loc="PSA 104:15">104.15</ref>.</char></note>, al cospetto de' miei nemici;</para>
  <para style="q" vid="PSA 23:5">Tu ungi il mio capo con olio<note caller="*" style="x"><char style="xo" closed="false">23.5 </char><char style="xk" closed="false">olio </char><char style="xt" closed="false"><ref loc="PSA 133:2">Sal. 133.2</ref>. <ref loc="ECC 9:8">Eccl. 9.8</ref>. <ref loc="MAT 6:17">Mat. 6.17</ref>. <ref loc="LUK 7:46">Luc. 7.46</ref>.</char></note>; la mia coppa trabocca.<verse eid="PSA 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6"/>Per certo, beni e benignità mi accompagneranno</para>
  <para style="q" vid="PSA 23:6">Tutti i giorni della mia vita;</para>
  <para style="q" vid="PSA 23:6">Ed io abiterò nella Casa del Signore</para>
  <para style="q" vid="PSA 23:6">Per lunghi giorni.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">SALMO XXIV</para>
  <para style="s1">Il dominio universale di Dio. — Chi è degno di salire al santuario di lui? — Il Re di gloria</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1"/>AL Signore <char style="add">appartiene</char> la terra, e tutto quello che <char style="add">è</char> in essa;</para>
  <para style="q" vid="PSA 24:1">Il mondo, ed i suoi abitanti<note caller="*" style="x"><char style="xo" closed="false">24.1 </char><char style="xk" closed="false">abitanti </char><char style="xt" closed="false"><ref loc="DEU 10:14">Deut. 10.14</ref>. <ref loc="JOB 41:11">Giob. 41.11</ref>. <ref loc="1CO 10:26">1 Cor. 10.26</ref>.</char></note>.<verse eid="PSA 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2"/>Perciocchè egli l'ha fondata sopra i mari<note caller="*" style="x"><char style="xo" closed="false">24.2 </char><char style="xk" closed="false">mari </char><char style="xt" closed="false"><ref loc="GEN 1:9">Gen. 1.9</ref>. <ref loc="2PE 3:5">2 Piet. 3.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 24:2">E l'ha fermata sopra i fiumi.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3"/>Chi salirà al monte del Signore<note caller="*" style="x"><char style="xo" closed="false">24.3 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 15:1">Sal. 15.1</ref> ecc.</char></note>?</para>
  <para style="q" vid="PSA 24:3">E chi starà nel luogo suo santo?<verse eid="PSA 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4"/>L' <char style="add">uomo</char> innocente di mani<note caller="*" style="x"><char style="xo" closed="false">24.4 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="PSA 26:6">Sal. 26.6</ref>. <ref loc="ISA 33:15">Is. 33.15</ref>,<ref loc="ISA 33:16">16</ref>. <ref loc="1TI 2:8">1 Tim. 2.8</ref>.</char></note>, e puro di cuore<note caller="*" style="x"><char style="xo" closed="false">24.4 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PSA 73:1">Sal. 73.1</ref>. <ref loc="MAT 5:8">Mat. 5.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 24:4">Il qual non eleva l'animo a vanità, e non giura con frode<note caller="*" style="x"><char style="xo" closed="false">24.4 </char><char style="xk" closed="false">frode </char><char style="xt" closed="false"><ref loc="PSA 15:4">Sal. 15.4</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5"/>Un tale riceverà benedizione dal Signore,</para>
  <para style="q" vid="PSA 24:5">E giustizia dall'Iddio della sua salute.<verse eid="PSA 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6"/>Tale <char style="add">è</char> la generazione di quelli che lo ricercano;</para>
  <para style="q" vid="PSA 24:6">
    <char style="add">Tale è</char> Giacobbe che cerca la tua faccia<note caller="*" style="x"><char style="xo" closed="false">24.6 </char><char style="xk" closed="false">faccia </char><char style="xt" closed="false"><ref loc="PSA 27:8">Sal. 27.8</ref>; <ref loc="PSA 105:4">105.4</ref>.</char></note>, <char style="add">o Dio</char>. <char style="qs">(Sela.)</char><verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7"/>O porte, alzate i vostri capi<note caller="*" style="x"><char style="xo" closed="false">24.7 </char><char style="xk" closed="false">capi </char><char style="xt" closed="false"><ref loc="PSA 118:19">Sal. 118.19</ref>,<ref loc="PSA 118:20">20</ref>. <ref loc="ISA 26:2">Is. 26.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 24:7">E <char style="add">voi</char>, porte eterne, alzatevi;</para>
  <para style="q" vid="PSA 24:7">E il Re di gloria<note caller="*" style="x"><char style="xo" closed="false">24.7 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="1CO 2:8">1 Cor. 2.8</ref>.</char></note> entrerà.<verse eid="PSA 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8"/>Chi <char style="add">è</char> questo Re di gloria?</para>
  <para style="q" vid="PSA 24:8">
    <char style="add">Egli è</char> il Signore forte e possente;</para>
  <para style="q" vid="PSA 24:8">Il Signore poderoso in battaglia.<verse eid="PSA 24:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9"/>O porte, alzate i vostri capi;</para>
  <para style="q" vid="PSA 24:9">Alzatevi, o porte eterne;</para>
  <para style="q" vid="PSA 24:9">E il Re di gloria entrerà.<verse eid="PSA 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10"/>Chi è questo Re di gloria?</para>
  <para style="q" vid="PSA 24:10">
    <char style="add">Egli è</char> il Signor degli eserciti;</para>
  <para style="q" vid="PSA 24:10">Esso <char style="add">è</char> il Re di gloria. <char style="qs">(Sela.)</char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">SALMO XXV</para>
  <para style="s1">Davide prega Dio di liberarlo dai suoi nemici e di perdonargli i suoi peccati</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1"/>O SIGNORE, io levo l'anima mia a te.<verse eid="PSA 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2"/>Dio mio, io mi confido in te; <char style="add">fa' che io</char> non sia confuso<note caller="*" style="x"><char style="xo" closed="false">25.2 </char><char style="xk" closed="false">confuso </char><char style="xt" closed="false"><ref loc="PSA 22:5">Sal. 22.5</ref>; <ref loc="PSA 31:1">31.1</ref>; <ref loc="PSA 34:8">34.8</ref>. <ref loc="ISA 28:16">Is. 28.16</ref>. <ref loc="ROM 10:11">Rom. 10.11</ref>.</char></note>,</para>
  <para style="q" vid="PSA 25:2">
    <char style="add">E</char> che i miei nemici non facciano festa di me.<verse eid="PSA 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3"/>Ed anche che niuno di quelli che sperano in te sia confuso;</para>
  <para style="q" vid="PSA 25:3">Sien confusi quelli che si portano dislealmente senza cagione.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4"/>Signore, fammi conoscere le tue vie;</para>
  <para style="q" vid="PSA 25:4">Insegnami i tuoi sentieri<note caller="*" style="x"><char style="xo" closed="false">25.4 </char><char style="xk" closed="false">sentieri </char><char style="xt" closed="false"><ref loc="EXO 33:13">Esod. 33.13</ref>. <ref loc="PSA 6:8">Sal. 6.8</ref>; <ref loc="PSA 27:11">27.11</ref>; <ref loc="PSA 86:11">86.11</ref>; <ref loc="PSA 143:8">143.8</ref>,<ref loc="PSA 143:10">10</ref>.</char></note>.<verse eid="PSA 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5"/>Inviami nella tua verità, ed ammaestrami;</para>
  <para style="q" vid="PSA 25:5">Perciocchè tu <char style="add">sei</char> l'Iddio della mia salute;</para>
  <para style="q" vid="PSA 25:5">Io ti attendo tuttodì.<verse eid="PSA 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6"/>Ricordati, Signore, delle tue compassioni, e delle tue benignità<note caller="*" style="x"><char style="xo" closed="false">25.6 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="PSA 103:17">Sal. 103.17</ref>; <ref loc="PSA 106:1">106.1</ref>; <ref loc="PSA 107:1">107.1</ref>. <ref loc="JER 33:11">Ger. 33.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 25:6">Perciocchè <char style="add">sono</char> ab eterno.<verse eid="PSA 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7"/>Non ridurti a memoria i peccati della mia giovanezza,</para>
  <para style="q" vid="PSA 25:7">Nè i miei misfatti;</para>
  <para style="q" vid="PSA 25:7">Secondo la tua benignità<note caller="*" style="x"><char style="xo" closed="false">25.7 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="PSA 51:1">Sal. 51.1</ref> ecc.</char></note>, ricordati di me,</para>
  <para style="q" vid="PSA 25:7">O Signore, per amore della tua bontà.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8"/>Il Signore <char style="add">è</char> buono e diritto;</para>
  <para style="q" vid="PSA 25:8">Perciò egli insegnerà la via a' peccatori.<verse eid="PSA 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9"/>Egli invierà i mansueti nella dirittura,</para>
  <para style="q" vid="PSA 25:9">Ed insegnerà la sua via agli umili.<verse eid="PSA 25:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10"/>Tutte le vie del Signore <char style="add">son</char> benignità e verità,</para>
  <para style="q" vid="PSA 25:10">Inverso quelli che guardano il suo patto e le sue testimonianze.<verse eid="PSA 25:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11"/>O Signore, per amor del tuo Nome,</para>
  <para style="q" vid="PSA 25:11">Perdonami la mia iniquità; perciocchè ella <char style="add">è</char> grande<note caller="*" style="x"><char style="xo" closed="false">25.11 </char><char style="xk" closed="false">grande </char><char style="xt" closed="false"><ref loc="ROM 5:20">Rom. 5.20</ref>.</char></note>.<verse eid="PSA 25:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12"/>Chi <char style="add">è</char> l'uomo che tema il Signore?</para>
  <para style="q" vid="PSA 25:12">Egli gl'insegnerà la via ch'egli deve eleggere<note caller="*" style="x"><char style="xo" closed="false">25.12 </char><char style="xk" closed="false">eleggere </char><char style="xt" closed="false"><ref loc="PSA 37:23">Sal. 37.23</ref>.</char></note>.<verse eid="PSA 25:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13"/>L'anima sua dimorerà per mezzo i beni<note caller="*" style="x"><char style="xo" closed="false">25.13 </char><char style="xk" closed="false">beni </char><char style="xt" closed="false"><ref loc="PRO 19:23">Prov. 19.23</ref>.</char></note>,</para>
  <para style="q" vid="PSA 25:13">E la sua progenie erederà la terra<note caller="*" style="x"><char style="xo" closed="false">25.13 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 37:11">Sal. 37.11</ref>,<ref loc="PSA 37:22">22</ref>,<ref loc="PSA 37:29">29</ref>.</char></note>.<verse eid="PSA 25:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14"/>Il Signore dà a conoscere il suo consiglio ed il suo patto<note caller="*" style="x"><char style="xo" closed="false">25.14 </char><char style="xk" closed="false">patto </char><char style="xt" closed="false"><ref loc="JHN 7:17">Giov. 7.17</ref>; <ref loc="JHN 15:15">15.15</ref>.</char></note></para>
  <para style="q" vid="PSA 25:14">A quelli che lo temono<note caller="*" style="x"><char style="xo" closed="false">25.14 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="2CH 20:11">2 Cron. 20.11</ref>. <ref loc="PSA 121:1">Sal. 121.1</ref>,<ref loc="PSA 121:2">2</ref>.</char></note>.<verse eid="PSA 25:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15"/>I miei occhi <char style="add">son</char> del continuo verso il Signore;</para>
  <para style="q" vid="PSA 25:15">Perciocchè egli trarrà i miei piedi della rete.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16"/>Riguarda a me, ed abbi pietà di me;</para>
  <para style="q" vid="PSA 25:16">Perciocchè io <char style="add">son</char> solo ed afflitto.<verse eid="PSA 25:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17"/>Le angosce del mio cuore si sono aumentate;</para>
  <para style="q" vid="PSA 25:17">Trammi delle mie distrette.<verse eid="PSA 25:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18"/>Vedi la mia afflizione ed il mio affanno;</para>
  <para style="q" vid="PSA 25:18">E perdonami tutti i miei peccati.<verse eid="PSA 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19"/>Vedi i miei nemici; perciocchè son molti,</para>
  <para style="q" vid="PSA 25:19">E mi odiano d'un odio <char style="add">pieno</char> di violenza.<verse eid="PSA 25:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20"/>Guarda l'anima mia, e riscuotimi;</para>
  <para style="q" vid="PSA 25:20">
    <char style="add">Fa' che</char> io non sia confuso; perciocchè io mi confido in te.<verse eid="PSA 25:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21"/>L'integrità e la dirittura mi guardino;</para>
  <para style="q" vid="PSA 25:21">Perciocchè io ho sperato in te.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22"/>O Dio, riscuoti Israele da tutte le sue tribolazioni.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">SALMO XXVI</para>
  <para style="s1">Davide ricorre a Dio fidando nella propria integrità</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1"/>GIUDICIAMI, Signore<note caller="*" style="x"><char style="xo" closed="false">26.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 7:8">Sal. 7.8</ref>; <ref loc="PSA 43:1">43.1</ref>.</char></note>; perciocchè io son camminato nella mia integrità<note caller="*" style="x"><char style="xo" closed="false">26.1 </char><char style="xk" closed="false">integrità </char><char style="xt" closed="false"><ref loc="2KI 20:3">2 Re. 20.3</ref>. <ref loc="PRO 20:7">Prov. 20.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 26:1">E mi son confidato nel Signore<note caller="*" style="x"><char style="xo" closed="false">26.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> e rif. <ref loc="PRO 29:25">Prov. 29.25</ref>.</char></note>; io non sarò smosso.<verse eid="PSA 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2"/>Provami, Signore, e sperimentami;</para>
  <para style="q" vid="PSA 26:2">Metti al cimento le mie reni ed il mio cuore<note caller="*" style="x"><char style="xo" closed="false">26.2 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PSA 17:3">Sal. 17.3</ref>; <ref loc="PSA 139:23">139.23</ref>.</char></note>.<verse eid="PSA 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3"/>Perciocchè <char style="add">io ho</char> davanti agli occhi la tua benignità,</para>
  <para style="q" vid="PSA 26:3">E son camminato nella tua verità.<verse eid="PSA 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4"/>Io non son seduto con uomini bugiardi,</para>
  <para style="q" vid="PSA 26:4">E non sono andato co' dissimulati<note caller="*" style="x"><char style="xo" closed="false">26.4 </char><char style="xk" closed="false">dissimulati </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sal. 1.1</ref>. <ref loc="JER 15:17">Ger. 15.17</ref>.</char></note>.<verse eid="PSA 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5"/>Io odio la raunanza de' maligni,</para>
  <para style="q" vid="PSA 26:5">E non son seduto con gli empi.<verse eid="PSA 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6"/>Io lavo le mie mani nell'innocenza,</para>
  <para style="q" vid="PSA 26:6">E circuisco il tuo Altare, o Signore<note caller="*" style="x"><char style="xo" closed="false">26.6 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="EXO 30:19">Esod. 30.19</ref> ecc. <ref loc="1TI 2:8">1 Tim. 2.8</ref>.</char></note>;<verse eid="PSA 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7"/>Facendo risonar voce di lode,</para>
  <para style="q" vid="PSA 26:7">E raccontando tutte le tue maraviglie.<verse eid="PSA 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8"/>O Signore, io amo l'abitacolo della tua Casa<note caller="*" style="x"><char style="xo" closed="false">26.8 </char><char style="xk" closed="false">Casa </char><char style="xt" closed="false"><ref loc="PSA 27:4">Sal. 27.4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 26:8">E il luogo del tabernacolo della tua gloria.<verse eid="PSA 26:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9"/>Non metter l'anima mia in un fascio co' peccatori,</para>
  <para style="q" vid="PSA 26:9">Nè la mia vita con gli uomini di sangue;<verse eid="PSA 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10"/>Nelle cui mani <char style="add">è</char> scelleratezza,</para>
  <para style="q" vid="PSA 26:10">E la cui destra è piena di presenti<note caller="*" style="x"><char style="xo" closed="false">26.10 </char><char style="xk" closed="false">presenti </char><char style="xt" closed="false"><ref loc="EXO 23:8">Esod. 23.8</ref>. <ref loc="1SA 8:3">1 Sam. 8.3</ref>.</char></note>.<verse eid="PSA 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11"/>Ma io camminerò nella mia integrità;</para>
  <para style="q" vid="PSA 26:11">Riscuotimi, ed abbi pietà di me.<verse eid="PSA 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12"/>Il mio piè sta fermo e ritto in luogo piano<note caller="*" style="x"><char style="xo" closed="false">26.12 </char><char style="xk" closed="false">piano </char><char style="xt" closed="false"><ref loc="PSA 27:11">Sal. 27.11</ref>; <ref loc="PSA 40:2">40.2</ref>.</char></note>.</para>
  <para style="q" vid="PSA 26:12">Io benedirò il Signore nelle raunanze.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">SALMO XXVII</para>
  <para style="s1">Fiducia in Dio; ardente brama della sua presenza</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1"/>IL Signore <char style="add">è</char> la mia luce<note caller="*" style="x"><char style="xo" closed="false">27.1 </char><char style="xk" closed="false">luce </char><char style="xt" closed="false"><ref loc="PSA 84:11">Sal. 84.11</ref>. <ref loc="ISA 60:19">Is. 60.19</ref>,<ref loc="ISA 60:20">20</ref>.</char></note> e la mia salute<note caller="*" style="x"><char style="xo" closed="false">27.1 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="EXO 15:2">Esod. 15.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 27:1">Di chi temerò?</para>
  <para style="q" vid="PSA 27:1">Il Signore <char style="add">è</char> la forza della mia vita<note caller="*" style="x"><char style="xo" closed="false">27.1 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PSA 62:5">Sal. 62.5</ref>,<ref loc="PSA 62:6">6</ref>; <ref loc="PSA 118:14">118.14</ref>,<ref loc="PSA 118:21">21</ref>.</char></note>;</para>
  <para style="q" vid="PSA 27:1">Di chi avrò paura?<verse eid="PSA 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2"/>Quando i maligni mi hanno assalito per divorar la mia carne,</para>
  <para style="q" vid="PSA 27:2">Eglino stessi, i miei nemici ed avversari, son traboccati e caduti.<verse eid="PSA 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3"/>Avvegnachè <char style="add">tutto</char> un campo si accampasse contro a me,</para>
  <para style="q" vid="PSA 27:3">Il mio cuore non avrebbe però paura;</para>
  <para style="q" vid="PSA 27:3">Benchè una battaglia si levasse contro a me,</para>
  <para style="q" vid="PSA 27:3">Io avrei confidanza in questo.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4"/>Io ho chiesta una cosa al Signore, quella procaccerò:</para>
  <para style="q" vid="PSA 27:4">Che io dimori nella Casa del Signore tutti i giorni della mia vita<note caller="*" style="x"><char style="xo" closed="false">27.4 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PSA 26:8">Sal. 26.8</ref>; <ref loc="PSA 65:4">65.4</ref>; <ref loc="PSA 84:1">84.1</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 27:4">Per mirar la bellezza del Signore,</para>
  <para style="q" vid="PSA 27:4">E visitare il suo Tempio.<verse eid="PSA 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5"/>Perciocchè egli mi nasconderà nel suo tabernacolo,</para>
  <para style="q" vid="PSA 27:5">Nel giorno dell'avversità;</para>
  <para style="q" vid="PSA 27:5">Egli mi occulterà nel nascondimento del suo padiglione<note caller="*" style="x"><char style="xo" closed="false">27.5 </char><char style="xk" closed="false">padiglione </char><char style="xt" closed="false"><ref loc="PSA 91:1">Sal. 91.1</ref>. <ref loc="ISA 4:6">Is. 4.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 27:5">Egli mi leverà ad alto sopra una roccia<note caller="*" style="x"><char style="xo" closed="false">27.5 </char><char style="xk" closed="false">roccia </char><char style="xt" closed="false"><ref loc="PSA 40:2">Sal. 40.2</ref>.</char></note>.<verse eid="PSA 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6"/>Anzi pure ora il mio capo s'innalzerà sopra i miei nemici</para>
  <para style="q" vid="PSA 27:6">
    <char style="add">Che son</char> d'intorno a me;</para>
  <para style="q" vid="PSA 27:6">Ed io sacrificherò nel suo tabernacolo sacrificii con giubilo;</para>
  <para style="q" vid="PSA 27:6">Io canterò, e salmeggerò al Signore.<verse eid="PSA 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7"/>Signore, ascolta la mia voce, <char style="add">colla quale</char> io grido;</para>
  <para style="q" vid="PSA 27:7">Ed abbi pietà di me, e rispondimi.<verse eid="PSA 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8"/>Il mio cuore <char style="add">mi</char> dice da parte tua: Cercate la mia faccia.</para>
  <para style="q" vid="PSA 27:8">Io cerco la tua faccia, o Signore<note caller="*" style="x"><char style="xo" closed="false">27.8 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 24:6">Sal. 24.6</ref>; <ref loc="PSA 105:4">105.4</ref>.</char></note>.<verse eid="PSA 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9"/>Non nascondere il tuo volto da me,</para>
  <para style="q" vid="PSA 27:9">Non rigettare in ira il tuo servitore;</para>
  <para style="q" vid="PSA 27:9">Tu sei stato il mio aiuto; non lasciarmi, e non abbandonarmi,</para>
  <para style="q" vid="PSA 27:9">O Dio della mia salute.<verse eid="PSA 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10"/>Quantunque mio padre e mia madre mi avessero abbandonato,</para>
  <para style="q" vid="PSA 27:10">Pure il Signore mi accoglierà<note caller="*" style="x"><char style="xo" closed="false">27.10 </char><char style="xk" closed="false">accoglierà </char><char style="xt" closed="false"><ref loc="ISA 49:15">Is. 49.15</ref>.</char></note>.<verse eid="PSA 27:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11"/>O Signore, insegnami la tua via<note caller="*" style="x"><char style="xo" closed="false">27.11 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="PSA 25:4">Sal. 25.4</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 27:11">E giudami per un sentiero piano,</para>
  <para style="q" vid="PSA 27:11">Per cagione de' miei nemici.<verse eid="PSA 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12"/>Non darmi alle voglie de' miei nemici;</para>
  <para style="q" vid="PSA 27:12">Perciocchè son surti contro a me falsi testimoni<note caller="*" style="x"><char style="xo" closed="false">27.12 </char><char style="xk" closed="false">testimoni </char><char style="xt" closed="false"><ref loc="1SA 22:9">1 Sam. 22.9</ref>. <ref loc="MAT 26:60">Mat. 26.60</ref>.</char></note>,</para>
  <para style="q" vid="PSA 27:12">Ed uomini che audacemente parlano di violenza<note caller="*" style="x"><char style="xo" closed="false">27.12 </char><char style="xk" closed="false">violenza </char><char style="xt" closed="false"><ref loc="ACT 9:1">Fat. 9.1</ref>.</char></note>.<verse eid="PSA 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13"/>Oh! se non avessi creduto di vedere i beni del Signore,</para>
  <para style="q" vid="PSA 27:13">Nella terra de' viventi!<verse eid="PSA 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14"/>Attendi il Signore<note caller="*" style="x"><char style="xo" closed="false">27.14 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="ISA 25:9">Is. 25.9</ref>. <ref loc="HAB 2:3">Abac. 2.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 27:14">Fortificati; ed egli conforterà il tuo cuore;</para>
  <para style="q" vid="PSA 27:14">Spera pur nel Signore.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">SALMO XXVIII</para>
  <para style="s1">Preghiera per esser liberato; ringraziamento per la ottenuta liberazione</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1"/>IO grido a te, Signore;</para>
  <para style="q" vid="PSA 28:1">Rocca mia<note caller="*" style="x"><char style="xo" closed="false">28.1 </char><char style="xk" closed="false">mia </char><char style="xt" closed="false"><ref loc="PSA 18:1">Sal. 18.1</ref> </char><char style="xta" closed="false">e rif.</char></note>, non tacere, senza rispondermi;</para>
  <para style="q" vid="PSA 28:1">Che talora, <char style="add">se</char> tu ti taci,</para>
  <para style="q" vid="PSA 28:1">Io non sia renduto simile a quelli che scendono nella fossa.<verse eid="PSA 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2"/>Ascolta la voce delle mie supplicazioni, mentre io grido a te,</para>
  <para style="q" vid="PSA 28:2">Mentre io levo le mani verso l'oracolo della tua santità<note caller="*" style="x"><char style="xo" closed="false">28.2 </char><char style="xk" closed="false">santità </char><char style="xt" closed="false"><ref loc="1KI 8:28">1 Re. 8.28</ref>,<ref loc="1KI 8:29">29</ref>.</char></note>.<verse eid="PSA 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3"/>Non istrascinarmi con gli empi<note caller="*" style="x"><char style="xo" closed="false">28.3 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 26:9">Sal. 26.9</ref>; <ref loc="PSA 55:21">55.21</ref>.</char></note>, e con gli operatori d'iniquità,</para>
  <para style="q" vid="PSA 28:3">I quali parlano di pace co' lor prossimi,</para>
  <para style="q" vid="PSA 28:3">Ma hanno della malizia nel cuore<note caller="*" style="x"><char style="xo" closed="false">28.3 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="JER 9:8">Ger. 9.8</ref>.</char></note>.<verse eid="PSA 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4"/>Rendi loro secondo le loro opere, e secondo le malvagità de' lor fatti<note caller="*" style="x"><char style="xo" closed="false">28.4 </char><char style="xk" closed="false">fatti </char><char style="xt" closed="false"><ref loc="2TI 4:14">2 Tim. 4.14</ref>. <ref loc="REV 18:6">Apoc. 18.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 28:4">Rendi loro secondo le opere delle lor mani;</para>
  <para style="q" vid="PSA 28:4">Da' loro la lor retribuzione.<verse eid="PSA 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5"/>Perciocchè non considerano i fatti del Signore,</para>
  <para style="q" vid="PSA 28:5">Nè l'opere delle sue mani,</para>
  <para style="q" vid="PSA 28:5">Egli li distruggerà, e non li edificherà.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6"/>Benedetto <char style="add">sia</char> il Signore;</para>
  <para style="q" vid="PSA 28:6">Perciocchè egli ha udita la voce delle mie supplicazioni.<verse eid="PSA 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7"/>Il Signore <char style="add">è</char> la mia forza ed il mio scudo<note caller="*" style="x"><char style="xo" closed="false">28.7 </char><char style="xk" closed="false">scudo </char><char style="xt" closed="false"><ref loc="PSA 18:1">Sal. 18.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 28:7">In lui si è confidato il mio cuore, ed io sono stato soccorso;</para>
  <para style="q" vid="PSA 28:7">Onde il mio cuore festeggia</para>
  <para style="q" vid="PSA 28:7">Ed io lo celebrerò co' miei cantici.<verse eid="PSA 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8"/>Il Signore <char style="add">è</char> la forza del suo popolo,</para>
  <para style="q" vid="PSA 28:8">Ed è la fortezza delle salvazioni del suo unto.<verse eid="PSA 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9"/>Salva il tuo popolo, e benedici la tua eredità;</para>
  <para style="q" vid="PSA 28:9">E pascili, e innalzali in perpetuo.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">SALMO XXIX</para>
  <para style="s1">Invito a lodar la maestà di Dio</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1"/>DATE al Signore, o figliuoli de' potenti,</para>
  <para style="q" vid="PSA 29:1">Date al Signore gloria e forza<note caller="*" style="x"><char style="xo" closed="false">29.1 </char><char style="xk" closed="false">forza </char><char style="xt" closed="false"><ref loc="1CH 16:28">1 Cron. 16.28</ref>,<ref loc="1CH 16:29">29</ref>. <ref loc="PSA 96:7-9">Sal. 96.7-9</ref>.</char></note>.<verse eid="PSA 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2"/>Date al Signore la gloria <char style="add">dovuta</char> al suo Nome;</para>
  <para style="q" vid="PSA 29:2">Adorate il Signore nel magnifico santuario.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3"/>La voce del Signore <char style="add">è</char> sopra le acque;</para>
  <para style="q" vid="PSA 29:3">L'Iddio di gloria tuona<note caller="*" style="x"><char style="xo" closed="false">29.3 </char><char style="xk" closed="false">tuona </char><char style="xt" closed="false"><ref loc="JOB 37:4">Giob. 37.4</ref>,<ref loc="JOB 37:5">5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 29:3">Il Signore <char style="add">è</char> sopra le grandi acque.<verse eid="PSA 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4"/>La voce del Signore <char style="add">è</char> con potenza;</para>
  <para style="q" vid="PSA 29:4">La voce del Signore <char style="add">è</char> con magnificenza.<verse eid="PSA 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5"/>La voce del Signore rompe i cedri;</para>
  <para style="q" vid="PSA 29:5">E il Signore spezza i cedri del Libano;<verse eid="PSA 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6"/>E li fa saltellar come un vitello;</para>
  <para style="q" vid="PSA 29:6">Il Libano stesso, e Sirion<note caller="*" style="x"><char style="xo" closed="false">29.6 </char><char style="xk" closed="false">Sirion </char><char style="xt" closed="false"><ref loc="DEU 3:9">Deut. 3.9</ref>.</char></note>, come il figlio d'un liocorno.<verse eid="PSA 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7"/>La voce del Signore sparge, a giusa di schegge, fiamme di fuoco.<verse eid="PSA 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8"/>La voce del Signore fa tremare il deserto;</para>
  <para style="q" vid="PSA 29:8">Il Signore fa tremare il deserto di Cades.<verse eid="PSA 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9"/>La voce del Signore fa partorir le cerve,</para>
  <para style="q" vid="PSA 29:9">E sfronda le selve;</para>
  <para style="q" vid="PSA 29:9">Ma <char style="add">intanto</char> ciascuna predica <char style="add">la sua</char> gloria nel suo Tempio.<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10"/>Il Signore nel diluvio siede<note caller="*" style="x"><char style="xo" closed="false">29.10 </char><char style="xk" closed="false">siede </char><char style="xt" closed="false"><ref loc="GEN 6:17">Gen. 6.17</ref>. <ref loc="JOB 38:8">Giob. 38.8</ref>,<ref loc="JOB 38:25">25</ref>.</char></note>;</para>
  <para style="q" vid="PSA 29:10">Anzi il Signore siede re in eterno<note caller="*" style="x"><char style="xo" closed="false">29.10 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 10:16">Sal. 10.16</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11"/>Il Signore darà forza al suo popolo<note caller="*" style="x"><char style="xo" closed="false">29.11 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="PSA 28:8">Sal. 28.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 29:11">Il Signore benedirà il suo popolo in pace.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">SALMO XXX</para>
  <para style="s1">L'ira di Dio è sol per un momento; la sua benignità è in eterno</para>
  <para style="d">Salmo di canto di Davide, sopra la dedicazione della <char style="add">sua</char> casa<note caller="*" style="x"><char style="xo" closed="false">30.0 </char><char style="xk" closed="false">casa. </char><char style="xt" closed="false"><ref loc="DEU 20:5">Deut. 20.5</ref>. <ref loc="2SA 6:20">2 Sam. 6.20</ref>.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1"/>SIGNORE, io ti esalterò; perciocchè tu mi hai tratto ad alto,</para>
  <para style="q" vid="PSA 30:1">E non hai rallegrati di me i miei nemici.<verse eid="PSA 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2"/>Signore Iddio mio,</para>
  <para style="q" vid="PSA 30:2">Io ho gridato a te, e tu mi hai sanato<note caller="*" style="x"><char style="xo" closed="false">30.2 </char><char style="xk" closed="false">sanato </char><char style="xt" closed="false"><ref loc="PSA 6:2">Sal. 6.2</ref>; <ref loc="PSA 103:3">103.3</ref>.</char></note>.<verse eid="PSA 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3"/>Signore, tu hai fatta salir l'anima mia fuor del sepolcro;</para>
  <para style="q" vid="PSA 30:3">Tu mi hai salvata la vita, acciocchè io non iscendessi nella fossa.<verse eid="PSA 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4"/>Salmeggite al Signore <char style="add">voi</char> suoi santi;</para>
  <para style="q" vid="PSA 30:4">E celebrate la memoria della sua santità.<verse eid="PSA 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5"/>Perciocchè l'ira sua <char style="add">dura</char> solo un momento<note caller="*" style="x"><char style="xo" closed="false">30.5 </char><char style="xk" closed="false">momento </char><char style="xt" closed="false"><ref loc="PSA 103:9">Sal. 103.9</ref>. <ref loc="ISA 54:7">Is. 54.7</ref>,<ref loc="ISA 54:8">8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 30:5">Ma la sua benevolenza <char style="add">dura tutta</char> una vita;</para>
  <para style="q" vid="PSA 30:5">La sera appo noi alberga il pianto,</para>
  <para style="q" vid="PSA 30:5">Ma la mattina <char style="add">vi è</char> giubilo<note caller="*" style="x"><char style="xo" closed="false">30.5 </char><char style="xk" closed="false">giubilo </char><char style="xt" closed="false"><ref loc="PSA 126:5">Sal. 126.5</ref>. <ref loc="2CO 4:17">2 Cor. 4.17</ref>.</char></note>.<verse eid="PSA 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6"/>Quant'è a me, nella mia quiete, io diceva:</para>
  <para style="q" vid="PSA 30:6">Io non sarò giammai smosso<note caller="*" style="x"><char style="xo" closed="false">30.6 </char><char style="xk" closed="false">smosso </char><char style="xt" closed="false"><ref loc="JOB 29:18">Giob. 29.18</ref>. <ref loc="PSA 10:6">Sal. 10.6</ref>.</char></note>.<verse eid="PSA 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7"/>Signore, tu avevi, per lo tuo favore, stanziata la fortezza nel mio monte;</para>
  <para style="q" vid="PSA 30:7">
    <char style="add">Ma tosto che</char> tu hai nascosta la tua faccia, io sono stato smarrito<note caller="*" style="x"><char style="xo" closed="false">30.7 </char><char style="xk" closed="false">smarrito </char><char style="xt" closed="false"><ref loc="DEU 31:17">Deut. 31.17</ref>. <ref loc="PSA 104:29">Sal. 104.29</ref>.</char></note>.<verse eid="PSA 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8"/>Io ho gridato a te, Signore,</para>
  <para style="q" vid="PSA 30:8">Ed ho supplicato al Signore,<verse eid="PSA 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9"/>
    <char style="add">Dicendo:</char> Che utilità <char style="add">avrai</char> nel mio sangue,</para>
  <para style="q" vid="PSA 30:9">Se io scendo nella fossa?</para>
  <para style="q" vid="PSA 30:9">La polvere ti celebrerà ella?</para>
  <para style="q" vid="PSA 30:9">Predicherà ella la tua verità<note caller="*" style="x"><char style="xo" closed="false">30.9 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="PSA 6:5">Sal. 6.5</ref> </char><char style="xta" closed="false">e rif.</char></note>?<verse eid="PSA 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10"/>Ascolta, Signore, ed abbi pietà di me;</para>
  <para style="q" vid="PSA 30:10">Signore, siimi in aiuto.<verse eid="PSA 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11"/>Tu hai mutato il mio duolo in festa<note caller="*" style="x"><char style="xo" closed="false">30.11 </char><char style="xk" closed="false">festa </char><char style="xt" closed="false"><ref loc="2SA 6:14">2 Sam. 6.14</ref>. <ref loc="ISA 61:3">Is. 61.3</ref>.</char></note>;</para>
  <para style="q" vid="PSA 30:11">Tu hai sciolto il mio cilicio, e mi hai cinto di allegrezza;<verse eid="PSA 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12"/>Acciocchè la <char style="add">mia</char> gloria ti salmeggi, e non si taccia.</para>
  <para style="q" vid="PSA 30:12">Signore Iddio mio, io ti celebrerò in eterno.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">SALMO XXXI</para>
  <para style="s1">Davide prega Dio di liberarlo, lo loda per la sua bontà; ed esorta tutti a confidare in Lui</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1"/>SIGNORE, io mi son confidato in te;</para>
  <para style="q" vid="PSA 31:1">
    <char style="add">Fa'</char> che io non sia giammai confuso<note caller="*" style="x"><char style="xo" closed="false">31.1 </char><char style="xk" closed="false">confuso </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 31:1">Liberami per la tua giustizia.<verse eid="PSA 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2"/>Inchina a me il tuo orecchio, affrettati a liberarmi;</para>
  <para style="q" vid="PSA 31:2">Siimi una rocca forte, e un luogo di fortezza,</para>
  <para style="q" vid="PSA 31:2">Per salvarmi.<verse eid="PSA 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3"/>Perciocchè tu <char style="add">sei</char> la mia rocca<note caller="*" style="x"><char style="xo" closed="false">31.3 </char><char style="xk" closed="false">fortezza </char><char style="xt" closed="false"><ref loc="PSA 18:2">Sal. 18.2</ref> </char><char style="xta" closed="false">e rif.</char></note> e la mia fortezza;</para>
  <para style="q" vid="PSA 31:3">E, per amor del tuo Nome, guidami, e conducimi.<verse eid="PSA 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4"/>Trammi fuor della rete che mi <char style="add">è</char> stata tesa di nascosto;</para>
  <para style="q" vid="PSA 31:4">Poichè tu <char style="add">sei</char> la mia fortezza.<verse eid="PSA 31:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5"/>Io rimetto il mio spirito nelle tue mani<note caller="*" style="x"><char style="xo" closed="false">31.5 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="LUK 23:46">Luc. 23.46</ref>. <ref loc="ACT 7:59">Fat. 7.59</ref>.</char></note>;</para>
  <para style="q" vid="PSA 31:5">Tu mi hai riscattato, o Signore Iddio di verità<note caller="*" style="x"><char style="xo" closed="false">31.5 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="DEU 32:4">Deut. 32.4</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6"/>Io odio quelli che attendono alle vanità di menzogna;</para>
  <para style="q" vid="PSA 31:6">Ma io mi confido nel Signore.<verse eid="PSA 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7"/>Io festeggerò, e mi rallegrerò della tua benignità;</para>
  <para style="q" vid="PSA 31:7">Perciocchè tu avrai veduta la mia afflizione,</para>
  <para style="q" vid="PSA 31:7">Ed avrai presa conoscenza delle tribolazioni dell'anima mia<note caller="*" style="x"><char style="xo" closed="false">31.7 </char><char style="xk" closed="false">mia </char><char style="xt" closed="false"><ref loc="PSA 1:6">Sal. 1.6</ref>. <ref loc="JHN 10:27">Giov. 10.27</ref>.</char></note>;<verse eid="PSA 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8"/>E non mi avrai messo in mano del nemico<note caller="*" style="x"><char style="xo" closed="false">31.8 </char><char style="xk" closed="false">nemico </char><char style="xt" closed="false"><ref loc="1SA 17:46">1 Sam. 17.46</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 31:8">Ed avrai fatto star ritti i miei piedi al largo.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9"/>Abbi mercè di me, Signore; perciocchè io sono in distretta;</para>
  <para style="q" vid="PSA 31:9">L'occhio mio, l'anima mia, e il ventre mio, son consumati di cordoglio.<verse eid="PSA 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10"/>Perciocchè la mia vita si vien meno di noia,</para>
  <para style="q" vid="PSA 31:10">Ed i miei anni di sospirare;</para>
  <para style="q" vid="PSA 31:10">Le mie forze sono scadute per le mie pene,</para>
  <para style="q" vid="PSA 31:10">E le mie ossa son consumate.<verse eid="PSA 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11"/>Per cagione di tutti i miei nemici, io sono stato in gran vituperio<note caller="*" style="x"><char style="xo" closed="false">31.11 </char><char style="xk" closed="false">vituperio </char><char style="xt" closed="false"><ref loc="ISA 53:3">Is. 53.3</ref>.</char></note></para>
  <para style="q" vid="PSA 31:11">Eziandio a' miei vicini, e in ispavento a' miei conoscenti<note caller="*" style="x"><char style="xo" closed="false">31.11 </char><char style="xk" closed="false">conoscenti </char><char style="xt" closed="false"><ref loc="JOB 19:13">Giob. 19.13</ref>. <ref loc="PSA 38:11">Sal. 38.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 31:11">Quelli che mi veggono fuori se ne fuggono lontano da me.<verse eid="PSA 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12"/>Io sono stato dimenticato dal cuor <char style="add">loro</char> come un morto;</para>
  <para style="q" vid="PSA 31:12">Io son simile ad un vaso perduto.<verse eid="PSA 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13"/>Perciocchè io ho udito il vituperio di molti;</para>
  <para style="q" vid="PSA 31:13">Spavento <char style="add">è</char> d'ogn'intorno,</para>
  <para style="q" vid="PSA 31:13">Mentre prendono insieme consiglio contro a me,</para>
  <para style="q" vid="PSA 31:13">
    <char style="add">E</char> macchinano di tormi la vita<note caller="*" style="x"><char style="xo" closed="false">31.13 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="MAT 27:1">Mat. 27.1</ref>.</char></note>.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14"/>Ma io, o Signore, mi confido in te;</para>
  <para style="q" vid="PSA 31:14">Io ho detto: Tu <char style="add">sei</char> l'Iddio mio.<verse eid="PSA 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15"/>I miei tempi <char style="add">son</char> nella tua mano;</para>
  <para style="q" vid="PSA 31:15">Riscuotimi dalla mano de' miei nemici, e da quelli che mi perseguitano.<verse eid="PSA 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16"/>Fa' risplendere il tuo volto<note caller="*" style="x"><char style="xo" closed="false">31.16 </char><char style="xk" closed="false">volto </char><char style="xt" closed="false"><ref loc="NUM 6:25">Num. 6.25</ref>,<ref loc="NUM 6:26">26</ref> </char><char style="xta" closed="false">e rif.</char></note> sopra il tuo servitore;</para>
  <para style="q" vid="PSA 31:16">Salvami per la tua benignità.<verse eid="PSA 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17"/>O Signore, <char style="add">fa</char>' che io non sia confuso; perciocchè io t'invoco;</para>
  <para style="q" vid="PSA 31:17">Sieno confusi gli empi;</para>
  <para style="q" vid="PSA 31:17">Abbian la bocca turata, e <char style="add">sieno posti</char> nel sepolcro.<verse eid="PSA 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18"/>Ammutoliscano le labbra bugiarde,</para>
  <para style="q" vid="PSA 31:18">Le quali parlano duramente contro al giusto,</para>
  <para style="q" vid="PSA 31:18">Con alterezza, e con isprezzo.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19"/>Quanto grandi <char style="add">sono</char> i tuoi beni</para>
  <para style="q" vid="PSA 31:19">Che tu hai riposti a quelli che ti temono<note caller="*" style="x"><char style="xo" closed="false">31.19 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="ISA 64:4">Is. 64.4</ref>. <ref loc="1CO 2:9">1 Cor. 2.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 31:19">
    <char style="add">E</char> che tu fai in presenza de' figliuoli degli uomini,</para>
  <para style="q" vid="PSA 31:19">Inverso quelli che si confidano in te!<verse eid="PSA 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20"/>Tu li nascondi, nel nascondimento della tua faccia,</para>
  <para style="q" vid="PSA 31:20">Dalle superbie degli uomini;</para>
  <para style="q" vid="PSA 31:20">Tu li occulti in un tabernacolo, <char style="add">lungi</char> dalle brighe delle lingue.<verse eid="PSA 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21"/>Benedetto <char style="add">sia</char> il Signore;</para>
  <para style="q" vid="PSA 31:21">Perciocchè egli ha renduta ammirabile la sua benignità inverso me,</para>
  <para style="q" vid="PSA 31:21">
    <char style="add">Come se io fossi stato</char> in una città di fortezza.<verse eid="PSA 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22"/>Ora, quant'è a me, nel mio smarrimento, dissi:</para>
  <para style="q" vid="PSA 31:22">Io son riciso d'innanzi al tuo cospetto<note caller="*" style="x"><char style="xo" closed="false">31.22 </char><char style="xk" closed="false">cospetto </char><char style="xt" closed="false"><ref loc="ISA 38:10">Is. 38.10</ref> ecc.</char></note></para>
  <para style="q" vid="PSA 31:22">Ma pur tu hai udita la voce delle mie supplicazioni,</para>
  <para style="q" vid="PSA 31:22">Quando io ho gridato a te<note caller="*" style="x"><char style="xo" closed="false">31.22 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 140:6">Sal. 140.6</ref>; <ref loc="PSA 145:19">145.19</ref>.</char></note>.<verse eid="PSA 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23"/>Amate il Signore, <char style="add">voi</char> suoi santi tutti; Il Signore guarda i fedeli,</para>
  <para style="q" vid="PSA 31:23">E rende la retribuzione a colmo a quelli che procedono alteramente.<verse eid="PSA 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24"/>Confortatevi, voi tutti che sperate nel Signore;</para>
  <para style="q" vid="PSA 31:24">Ed egli fortificherà il vostro cuore.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">SALMO XXXII</para>
  <para style="s1">Felicità di chi ha ottenuto il perdono. Invito al pentimento</para>
  <para style="d">Maschil di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1"/>BEATO colui la cui trasgressione è rimessa<note caller="*" style="x"><char style="xo" closed="false">32.1 </char><char style="xk" closed="false">rimessa </char><char style="xt" closed="false"><ref loc="PSA 85:2">Sal. 85.2</ref>. <ref loc="ROM 4:6-8">Rom. 4.6-8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 32:1">E il cui peccato è coperto!<verse eid="PSA 32:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2"/>Beato l'uomo a cui il Signore non imputa iniquità<note caller="*" style="x"><char style="xo" closed="false">32.2 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="2CO 5:19">2 Cor. 5.19</ref>.</char></note>,</para>
  <para style="q" vid="PSA 32:2">E nel cui spirito non <char style="add">vi è</char> frode alcuna<note caller="*" style="x"><char style="xo" closed="false">32.2 </char><char style="xk" closed="false">alcuna </char><char style="xt" closed="false"><ref loc="JHN 1:47">Giov. 1.47</ref>.</char></note>!<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3"/>Mentre io mi son taciuto, le mie ossa si sono invecchiate,</para>
  <para style="q" vid="PSA 32:3">Nel mio ruggire di tutto dì.<verse eid="PSA 32:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4"/>Perciocchè giorno e notte la tua mano era aggravata sopra me,</para>
  <para style="q" vid="PSA 32:4">L'umor mio era divenuto simile ad arsure di state. <char style="qs">(Sela.)</char><verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5"/>Io ti ho dichiarato il mio peccato<note caller="*" style="x"><char style="xo" closed="false">32.5 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="PSA 51:3">Sal. 51.3</ref>.</char></note>, non ho coperta la mia iniquità,</para>
  <para style="q" vid="PSA 32:5">Io ho detto: Io confesserò le mie trasgressioni al Signore;</para>
  <para style="q" vid="PSA 32:5">E tu hai rimessa l'iniquità del mio peccato<note caller="*" style="x"><char style="xo" closed="false">32.5 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="PRO 28:13">Prov. 28.13</ref>. <ref loc="MRK 2:7">Mar. 2.7</ref>. <ref loc="LUK 15:18">Luc. 15.18</ref>,<ref loc="LUK 15:21">21</ref> ecc. <ref loc="1JN 1:9">1 Giov. 1.9</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6"/>Perciò<note caller="*" style="x"><char style="xo" closed="false">32.6 </char><char style="xk" closed="false">Perciò </char><char style="xt" closed="false"><ref loc="1TI 1:16">1 Tim. 1.16</ref>.</char></note> ogni <char style="add">uomo</char> pio ti farà orazione</para>
  <para style="q" vid="PSA 32:6">Nel tempo che <char style="add">tu</char> puoi esser trovato<note caller="*" style="x"><char style="xo" closed="false">32.6 </char><char style="xk" closed="false">trovato </char><char style="xt" closed="false"><ref loc="ISA 55:6">Is. 55.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 32:6">Nel <char style="add">tempo</char> di diluvio di grandi acque, esse non pur perverranno a lui.<verse eid="PSA 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7"/>Tu <char style="add">sei</char> il mio ricetto<note caller="*" style="x"><char style="xo" closed="false">32.7 </char><char style="xk" closed="false">ricetto </char><char style="xt" closed="false"><ref loc="PSA 27:5">Sal. 27.5</ref> </char><char style="xta" closed="false">e rif.</char></note>, tu mi guarderai di distretta,</para>
  <para style="q" vid="PSA 32:7">Tu mi circonderai di canti di liberazione. <char style="qs">(Sela.)</char><verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8"/>Io voglio ammaestrarti ed insegnarti la via,</para>
  <para style="q" vid="PSA 32:8">Per la quale devi camminare;</para>
  <para style="q" vid="PSA 32:8">E consigliarti, <char style="add">avendo</char> l'occhio sopra te.<verse eid="PSA 32:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9"/>Non siate come il cavallo, <char style="add">nè</char> come il mulo<note caller="*" style="x"><char style="xo" closed="false">32.9 </char><char style="xk" closed="false">mulo </char><char style="xt" closed="false"><ref loc="PRO 26:3">Prov. 26.3</ref>. <ref loc="JAS 3:3">Giac. 3.3</ref>.</char></note>, <char style="add">che sono</char> senza intelletto;</para>
  <para style="q" vid="PSA 32:9">La cui bocca conviene frenare con morso e con freno,</para>
  <para style="q" vid="PSA 32:9">
    <char style="add">Altrimente</char> non si accosterebbero a te.<verse eid="PSA 32:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10"/>Molti dolori <char style="add">avverranno</char> all'empio<note caller="*" style="x"><char style="xo" closed="false">32.10 </char><char style="xk" closed="false">empio </char><char style="xt" closed="false"><ref loc="PRO 13:21">Prov. 13.21</ref>. <ref loc="ROM 2:9">Rom. 2.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 32:10">Ma benignità intornierà colui che si confida nel Signore.<verse eid="PSA 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11"/>Rallegratevi nel Signore, e fate festa, o giusti;</para>
  <para style="q" vid="PSA 32:11">E giubilate, <char style="add">voi tutti che siete</char> diritti di cuore.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">SALMO XXXIII</para>
  <para style="s1">Giubilo del credente nella contemplazione di Dio e delle opere di Lui</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1"/>VOI giusti, giubilate nel Signore;</para>
  <para style="q" vid="PSA 33:1">La lode <char style="add">è</char> decevole agli <char style="add">uomini</char> diritti.<verse eid="PSA 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2"/>Celebrate il Signore colla cetera;</para>
  <para style="q" vid="PSA 33:2">Salmeggiategli col saltero <char style="add">e col</char> decacordo.<verse eid="PSA 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3"/>Cantategli un nuovo cantico<note caller="*" style="x"><char style="xo" closed="false">33.3 </char><char style="xk" closed="false">cantico </char><char style="xt" closed="false"><ref loc="ISA 42:10">Is. 42.10</ref>. <ref loc="REV 5:9">Apoc. 5.9</ref>; <ref loc="REV 14:3">14.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 33:3">Sonate maestrevolmente con giubilo.<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4"/>Perciocchè la parola del Signore è diritta;</para>
  <para style="q" vid="PSA 33:4">E tutte le sue opere <char style="add">son fatte</char> con verità.<verse eid="PSA 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5"/>Egli ama la giustizia e la dirittura;</para>
  <para style="q" vid="PSA 33:5">La terra è piena della benignità del Signore.<verse eid="PSA 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6"/>I cieli sono stati fatti per la parola del Signore<note caller="*" style="x"><char style="xo" closed="false">33.6 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="GEN 1:6">Gen. 1.6</ref>,<ref loc="GEN 1:7">7</ref>. <ref loc="JHN 1:3">Giov. 1.3</ref>. <ref loc="HEB 11:3">Ebr. 11.3</ref>. <ref loc="2PE 3:5">2 Piet. 3.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 33:6">E tutto il loro esercito per lo soffio della sua bocca.<verse eid="PSA 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7"/>Egli ha adunate le acque del mare come <char style="add">in</char> un mucchio<note caller="*" style="x"><char style="xo" closed="false">33.7 </char><char style="xk" closed="false">mucchio </char><char style="xt" closed="false"><ref loc="EXO 15:8">Esod. 15.8</ref>. <ref loc="JOS 3:13">Gios. 3.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 33:7">Egli ha riposti gli abissi <char style="add">come</char> in tesori<note caller="*" style="x"><char style="xo" closed="false">33.7 </char><char style="xk" closed="false">tesori </char><char style="xt" closed="false"><ref loc="GEN 1:9">Gen. 1.9</ref>. <ref loc="JOB 26:10">Giob. 26.10</ref>; <ref loc="JOB 38:8">38.8</ref>.</char></note>.<verse eid="PSA 33:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8"/>Tutta la terra tema del Signore;</para>
  <para style="q" vid="PSA 33:8">Abbianne spavento tutti gli abitanti del mondo.<verse eid="PSA 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9"/>Perciocchè egli disse <char style="add">la parola</char>, e <char style="add">la cosa</char> fu<note caller="*" style="x"><char style="xo" closed="false">33.9 </char><char style="xk" closed="false">fu </char><char style="xt" closed="false"><ref loc="GEN 1:3">Gen. 1.3</ref>. <ref loc="PSA 148:5">Sal. 148.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 33:9">Egli comandò, e <char style="add">la cosa</char> surse.<verse eid="PSA 33:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10"/>Il Signore dissipa il consiglio delle genti,</para>
  <para style="q" vid="PSA 33:10">Ed annulla i pensieri de' popoli<note caller="*" style="x"><char style="xo" closed="false">33.10 </char><char style="xk" closed="false">popoli </char><char style="xt" closed="false"><ref loc="ISA 8:10">Is. 8.10</ref>; <ref loc="ISA 19:3">19.3</ref>. <ref loc="LUK 1:51">Luc. 1.51</ref>.</char></note>.<verse eid="PSA 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11"/>Il consiglio del Signore dimora in eterno<note caller="*" style="x"><char style="xo" closed="false">33.11 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PRO 19:21">Prov. 19.21</ref>. <ref loc="ISA 46:10">Is. 46.10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 33:11">I pensieri del suo cuore <char style="add">dimorano</char> per ogni età.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12"/>Beata la gente di cui il Signore <char style="add">è</char> l'Iddio;</para>
  <para style="q" vid="PSA 33:12">
    <char style="add">Beato</char> il popolo, <char style="add">il quale</char> egli ha eletto per sua eredità<note caller="*" style="x"><char style="xo" closed="false">33.12 </char><char style="xk" closed="false">eredità </char><char style="xt" closed="false"><ref loc="EXO 19:5">Esod. 19.5</ref>. <ref loc="1PE 2:9">1 Piet. 2.9</ref>.</char></note>.<verse eid="PSA 33:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13"/>Il Signore riguarda dal cielo,</para>
  <para style="q" vid="PSA 33:13">Egli vede tutti i figliuoli degli uomini<note caller="*" style="x"><char style="xo" closed="false">33.13 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="PSA 11:4">Sal. 11.4</ref>; <ref loc="PSA 14:2">14.2</ref>. <ref loc="PRO 15:3">Prov. 15.3</ref>.</char></note>.<verse eid="PSA 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14"/>Egli mira, dalla stanza del suo seggio<note caller="*" style="x"><char style="xo" closed="false">33.14 </char><char style="xk" closed="false">seggio </char><char style="xt" closed="false"><ref loc="1KI 8:39">1 Re. 8.39</ref>,<ref loc="1KI 8:43">43</ref>,<ref loc="1KI 8:49">49</ref>. <ref loc="JHN 14:2">Giov. 14.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 33:14">Tutti gli abitanti della terra.<verse eid="PSA 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15"/>
    <char style="add">Egli è quel</char> che ha formato il cuor di essi tutti,</para>
  <para style="q" vid="PSA 33:15">Che considera tutte le loro opere<note caller="*" style="x"><char style="xo" closed="false">33.15 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="JOB 34:21">Giob. 34.21</ref>. <ref loc="JER 32:19">Ger. 32.19</ref>.</char></note>.<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16"/>Il re non è salvato per grandezza di esercito;</para>
  <para style="q" vid="PSA 33:16">L' <char style="add">uomo</char> prode non iscampa per grandezza di forza.<verse eid="PSA 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17"/>Il cavallo <char style="add">è</char> cosa fallace per salvare<note caller="*" style="x"><char style="xo" closed="false">33.17 </char><char style="xk" closed="false">salvare </char><char style="xt" closed="false"><ref loc="PSA 20:7">Sal. 20.7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 33:17">E non può liberare colla grandezza della sua possa.<verse eid="PSA 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18"/>Ecco, l'occhio del Signore <char style="add">è</char> inverso quelli che lo temono<note caller="*" style="x"><char style="xo" closed="false">33.18 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="JOB 36:7">Giob. 36.7</ref>. <ref loc="1PE 3:12">1 Piet. 3.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 33:18">Inverso quelli che sperano nella sua benignità;<verse eid="PSA 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19"/>Per riscuoter l'anima loro dalla morte<note caller="*" style="x"><char style="xo" closed="false">33.19 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="ACT 12:11">Fat. 12.11</ref>.</char></note>,</para>
  <para style="q" vid="PSA 33:19">E per conservarli in vita in <char style="add">tempo di</char> fame.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20"/>L'anima nostra attende il Signore<note caller="*" style="x"><char style="xo" closed="false">33.20 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 62:1">Sal. 62.1</ref>,<ref loc="PSA 62:5">5</ref>; <ref loc="PSA 130:6">130.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 33:20">Egli <char style="add">è</char> il nostro aiuto, e il nostro scudo<note caller="*" style="x"><char style="xo" closed="false">33.20 </char><char style="xk" closed="false">scudo </char><char style="xt" closed="false"><ref loc="DEU 33:29">Deut. 33.29</ref>. <ref loc="PSA 115:9-11">Sal. 115.9-11</ref>.</char></note>.<verse eid="PSA 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21"/>Certo, il nostro cuore si rallegrerà in lui<note caller="*" style="x"><char style="xo" closed="false">33.21 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="JHN 16:22">Giov. 16.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 33:21">Perciocchè noi ci siam confidati nel Nome della sua santità.<verse eid="PSA 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22"/>La tua benignità, o Signore, sia sopra noi,</para>
  <para style="q" vid="PSA 33:22">Siccome noi abbiamo sperato in te.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">SALMO XXXIV</para>
  <para style="s1">Il Salmista loda Iddio per avere esaudito le sue preghiere, ed esorta tutti a temerlo ed a fidare in lui</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide, intorno a ciò ch'egli si contraffece davanti ad Abimelec; onde esso lo cacciò via, ed egli se ne andò<note caller="*" style="x"><char style="xo" closed="false">34.0 </char><char style="xk" closed="false">andò </char><char style="xt" closed="false"><ref loc="1SA 21:11-15">1 Sam. 21.11-15</ref>.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1"/>IO benedirò il Signore in ogni tempo<note caller="*" style="x"><char style="xo" closed="false">34.1 </char><char style="xk" closed="false">tempo </char><char style="xt" closed="false"><ref loc="EPH 5:20">Efes. 5.20</ref>. <ref loc="1TH 5:18">1 Tess. 5.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 34:1">La sua lode <char style="add">sarà</char> sempre nella mia bocca.<verse eid="PSA 34:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2"/>L'anima mia si glorierà nel Signore<note caller="*" style="x"><char style="xo" closed="false">34.2 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="JER 9:24">Ger. 9.24</ref>. <ref loc="1CO 1:31">1 Cor. 1.31</ref>.</char></note>;</para>
  <para style="q" vid="PSA 34:2">Gli umili l'udiranno, e si rallegreranno.<verse eid="PSA 34:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3"/>Magnificate meco il Signore<note caller="*" style="x"><char style="xo" closed="false">34.3 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="LUK 1:46">Luc. 1.46</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 34:3">Ed esaltiamo <char style="add">tutti</char> insieme il suo Nome.<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4"/>Io ho cercato il Signore, ed egli mi ha risposto,</para>
  <para style="q" vid="PSA 34:4">E mi ha liberato da tutti i miei spaventi<note caller="*" style="x"><char style="xo" closed="false">34.4 </char><char style="xk" closed="false">spaventi </char><char style="xt" closed="false"><ref loc="2CH 15:2">2 Cron. 15.2</ref>. <ref loc="MAT 7:7">Mat. 7.7</ref>.</char></note>.<verse eid="PSA 34:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5"/>Quelli che hanno riguardato a lui sono stati illuminati,</para>
  <para style="q" vid="PSA 34:5">E le lor facce non sono state svergognate.<verse eid="PSA 34:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6"/>Questo povero afflitto ha gridato, e il Signore l'ha esaudito,</para>
  <para style="q" vid="PSA 34:6">E l'ha salvato da tutte le sue distrette.<verse eid="PSA 34:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7"/>Gli Angeli del Signore sono accampati intorno a quelli che lo temono<note caller="*" style="x"><char style="xo" closed="false">34.7 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="GEN 32:1">Gen. 32.1</ref>,<ref loc="GEN 32:2">2</ref>. <ref loc="2KI 6:17">2 Re. 6.17</ref>. <ref loc="DAN 6:22">Dan. 6.22</ref>. <ref loc="HEB 1:14">Ebr. 1.14</ref>.</char></note>,</para>
  <para style="q" vid="PSA 34:7">E li liberano.<verse eid="PSA 34:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8"/>Gustate, e vedete quanto il Signore <char style="add">è</char> buono<note caller="*" style="x"><char style="xo" closed="false">34.8 </char><char style="xk" closed="false">buono </char><char style="xt" closed="false"><ref loc="1PE 2:3">1 Piet. 2.3</ref>.</char></note>;</para>
  <para style="q" vid="PSA 34:8">Beato l'uomo <char style="add">che</char> spera in lui.<verse eid="PSA 34:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9"/>Temete il Signore, <char style="add">voi</char> suoi santi;</para>
  <para style="q" vid="PSA 34:9">Poichè nulla manca a quelli che lo temono.<verse eid="PSA 34:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10"/>I leoncelli soffrono necessità e fame;</para>
  <para style="q" vid="PSA 34:10">Ma quelli che cercano il Signore non hanno mancamento di alcun bene.<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11"/>Venite, figliuoli, ascoltatemi;</para>
  <para style="q" vid="PSA 34:11">Io v'insegnerò il timor del Signore<note caller="*" style="x"><char style="xo" closed="false">34.11 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 32:8">Sal. 32.8</ref>.</char></note>.<verse eid="PSA 34:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12"/>Quale <char style="add">è</char> l'uomo che abbia voglia di vivere,</para>
  <para style="q" vid="PSA 34:12">Che ami <char style="add">lunghezza di</char> giorni per veder del bene<note caller="*" style="x"><char style="xo" closed="false">34.12 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1 Piet. 3.10-12</ref>.</char></note>?<verse eid="PSA 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13"/>Guarda la tua lingua dal male,</para>
  <para style="q" vid="PSA 34:13">E le tue labbra da parlar frode<note caller="*" style="x"><char style="xo" closed="false">34.13 </char><char style="xk" closed="false">frode </char><char style="xt" closed="false"><ref loc="JAS 1:26">Giac. 1.26</ref>. <ref loc="1PE 2:22">1 Piet. 2.22</ref>. <ref loc="REV 14:5">Apoc. 14.5</ref>.</char></note>.<verse eid="PSA 34:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14"/>Ritratti dal male, e fa' il bene<note caller="*" style="x"><char style="xo" closed="false">34.14 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="JOB 28:28">Giob. 28.28</ref>. <ref loc="ISA 1:16">Is. 1.16</ref>,<ref loc="ISA 1:17">17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 34:14">Cerca la pace, e procacciala<note caller="*" style="x"><char style="xo" closed="false">34.14 </char><char style="xk" closed="false">procacciala </char><char style="xt" closed="false"><ref loc="ROM 12:18">Rom. 12.18</ref>. <ref loc="HEB 12:14">Ebr. 12.14</ref>.</char></note>.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15"/>Gli occhi del Signore <char style="add">son</char> verso i giusti<note caller="*" style="x"><char style="xo" closed="false">34.15 </char><char style="xk" closed="false">giusti </char><char style="xt" closed="false"><ref loc="PSA 33:18">Sal. 33.18</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 34:15">E le sue orecchie <char style="add">sono attente</char> al grido loro<note caller="*" style="x"><char style="xo" closed="false">34.15 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="JHN 9:31">Giov. 9.31</ref>.</char></note>.<verse eid="PSA 34:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16"/>La faccia del Signore <char style="add">è</char> contro a quelli che fanno male,</para>
  <para style="q" vid="PSA 34:16">Per isterminare la lor memoria d'in su la terra.<verse eid="PSA 34:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17"/>
    <char style="add">I giusti</char> gridano, e il Signore <char style="add">li</char> esaudisce,</para>
  <para style="q" vid="PSA 34:17">E li libera da tutte le lor distrette.<verse eid="PSA 34:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18"/>Il Signore <char style="add">è</char> presso di quelli che hanno il cuor rotto,</para>
  <para style="q" vid="PSA 34:18">E salva quelli che hanno lo spirito contrito<note caller="*" style="x"><char style="xo" closed="false">34.18 </char><char style="xk" closed="false">contrito </char><char style="xt" closed="false"><ref loc="PSA 57:1-7">Sal. 57.1-7</ref>. <ref loc="ISA 57:15">Is. 57.15</ref>; <ref loc="ISA 61:1">61.1</ref>; <ref loc="ISA 66:2">66.2</ref>. <ref loc="MAT 5:3">Mat. 5.3</ref>.</char></note>.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19"/>Molte <char style="add">son</char> le afflizioni del giusto;</para>
  <para style="q" vid="PSA 34:19">Ma il Signore lo libererà da tutte<note caller="*" style="x"><char style="xo" closed="false">34.19 </char><char style="xk" closed="false">tutte </char><char style="xt" closed="false"><ref loc="2TI 3:11">2 Tim. 3.11</ref>,<ref loc="2TI 3:12">12</ref>.</char></note>.<verse eid="PSA 34:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20"/>Egli guarda tutte le ossa di esso:</para>
  <para style="q" vid="PSA 34:20">E niuno ne può esser rotto<note caller="*" style="x"><char style="xo" closed="false">34.20 </char><char style="xk" closed="false">rotto </char><char style="xt" closed="false"><ref loc="JHN 19:36">Giov. 19.36</ref>.</char></note>.<verse eid="PSA 34:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21"/>La malvagità farà morire il malvagio<note caller="*" style="x"><char style="xo" closed="false">34.21 </char><char style="xk" closed="false">malvagio </char><char style="xt" closed="false"><ref loc="PSA 94:23">Sal. 94.23</ref>.</char></note>,</para>
  <para style="q" vid="PSA 34:21">E quelli che odiano il giusto saran distrutti.<verse eid="PSA 34:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22"/>Il Signore riscatta l'anima de' suoi servitori<note caller="*" style="x"><char style="xo" closed="false">34.22 </char><char style="xk" closed="false">servitori </char><char style="xt" closed="false"><ref loc="PSA 71:23">Sal. 71.23</ref>; <ref loc="PSA 103:4">103.4</ref>,<ref loc="PSA 103:5">5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 34:22">E niuno di quelli che sperano in lui sarà distrutto.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">SALMO XXXV</para>
  <para style="s1">Preghiera per la punizione dei malvagi; descrizione della loro empietà; preghiera e ringraziamento per la liberazione</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1"/>O SIGNORE, contendi con quelli che contendono meco;</para>
  <para style="q" vid="PSA 35:1">Guerreggia con quelli che guerreggiano meco.<verse eid="PSA 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2"/>Prendi lo scudo e la targa<note caller="*" style="x"><char style="xo" closed="false">35.2 </char><char style="xk" closed="false">targa </char><char style="xt" closed="false"><ref loc="PSA 5:12">Sal. 5.12</ref>; <ref loc="PSA 91:4">91.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 35:2">E levati in mio aiuto.<verse eid="PSA 35:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3"/>E trai fuori la lancia, e serra il passo a quelli che mi perseguitano;</para>
  <para style="q" vid="PSA 35:3">Di' all'anima mia: Io <char style="add">son</char> la tua salute.<verse eid="PSA 35:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4"/>Sien confusi e svergognati quelli che cercano l'anima mia;</para>
  <para style="q" vid="PSA 35:4">Voltin le spalle, e sieno svergognati</para>
  <para style="q" vid="PSA 35:4">Quelli che macchinano del male contro a me.<verse eid="PSA 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5"/>Sien come pula al vento<note caller="*" style="x"><char style="xo" closed="false">35.5 </char><char style="xk" closed="false">vento </char><char style="xt" closed="false"><ref loc="PSA 1:4">Sal. 1.4</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 35:5">E caccili l'Angelo del Signore.<verse eid="PSA 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6"/>Sia la via loro <char style="add">tutta</char> tenebre, e sdruccioli;</para>
  <para style="q" vid="PSA 35:6">E perseguali l'Angelo del Signore.<verse eid="PSA 35:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7"/>Perciocchè senza cagione hanno fatta una fossa nascosta,</para>
  <para style="q" vid="PSA 35:7">Per <char style="add">tendervi</char> la lor rete;</para>
  <para style="q" vid="PSA 35:7">Senza cagione l'hanno cavata all'anima mia.<verse eid="PSA 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8"/>Venga loro una sprovveduta ruina<note caller="*" style="x"><char style="xo" closed="false">35.8 </char><char style="xk" closed="false">ruina </char><char style="xt" closed="false"><ref loc="1TH 5:3">1 Tess. 5.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 35:8">E sieno presi colla lor propria rete che hanno tesa di nascosto,</para>
  <para style="q" vid="PSA 35:8">
    <char style="add">E</char> cadano nella ruina che mi hanno apparecchiata.<verse eid="PSA 35:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9"/>Allora l'anima mia festeggerà nel Signore,</para>
  <para style="q" vid="PSA 35:9">
    <char style="add">E</char> si rallegrerà nella sua salute<note caller="*" style="x"><char style="xo" closed="false">35.9 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="PSA 13:5">Sal. 13.5</ref>. <ref loc="LUK 1:47">Luc. 1.47</ref>.</char></note>.<verse eid="PSA 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10"/>Tutte le ossa mie diranno: O Signore, chi <char style="add">è</char> pari a te,</para>
  <para style="q" vid="PSA 35:10">Che riscuoti il povero afflitto da chi <char style="add">è</char> più forte di lui;</para>
  <para style="q" vid="PSA 35:10">Il povero afflitto, e il bisognoso, da chi lo spoglia?<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11"/>Falsi testimoni si levano<note caller="*" style="x"><char style="xo" closed="false">35.11 </char><char style="xk" closed="false">levano </char><char style="xt" closed="false"><ref loc="PSA 27:12">Sal. 27.12</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 35:11">Mi domandano <char style="add">cose</char>, delle quali non so nulla.<verse eid="PSA 35:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12"/>Mi rendono male per bene<note caller="*" style="x"><char style="xo" closed="false">35.12 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="JER 18:20">Ger. 18.20</ref>. <ref loc="JHN 10:32">Giov. 10.32</ref>.</char></note>;</para>
  <para style="q" vid="PSA 35:12">Rendono sconforto all'anima mia.<verse eid="PSA 35:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13"/>E pure io, quando essi erano infermi, mi vestiva d'un cilicio.</para>
  <para style="q" vid="PSA 35:13">Ed affliggeva l'anima mia col digiuno,</para>
  <para style="q" vid="PSA 35:13">E la mia orazione mi ritornava in seno<note caller="*" style="x"><char style="xo" closed="false">35.13 </char><char style="xk" closed="false">seno </char><char style="xt" closed="false"><ref loc="MAT 10:13">Mat. 10.13</ref>. <ref loc="LUK 10:6">Luc. 10.6</ref>.</char></note>.<verse eid="PSA 35:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14"/>Io andava attorno, come <char style="add">se fosse stato per</char> un mio amico, ovver fratello;</para>
  <para style="q" vid="PSA 35:14">Io andava chino, e vestito a bruno,</para>
  <para style="q" vid="PSA 35:14">Come uno che faccia cordoglio di sua madre.<verse eid="PSA 35:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15"/>Ma quando io son zoppicato, essi se ne son rallegrati,</para>
  <para style="q" vid="PSA 35:15">E si sono adunati insieme;</para>
  <para style="q" vid="PSA 35:15">Gente da nulla si è adunata contro a me, senza che io lo sapessi;</para>
  <para style="q" vid="PSA 35:15">
    <char style="add">Mi</char> hanno lacerato, senza mai restare;<verse eid="PSA 35:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16"/>Insieme con profani beffatori giocolari,</para>
  <para style="q" vid="PSA 35:16">Digrignando i denti contro di me.<verse eid="PSA 35:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17"/>O Signore, infino a quando vedrai <char style="add">queste cose?</char></para>
  <para style="q" vid="PSA 35:17">Ritrai l'anima mia dalle ruine loro,</para>
  <para style="q" vid="PSA 35:17">L'unica mia d'infra i leoncelli.<verse eid="PSA 35:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18"/>Io ti celebrerò in gran raunanza;</para>
  <para style="q" vid="PSA 35:18">Io ti loderò in mezzo d'un gran popolo.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19"/>Non rallegrinsi di me quelli che mi son nemici a torto;</para>
  <para style="q" vid="PSA 35:19">Non ammicchino con gli occhi quelli che mi odiano senza cagione<note caller="*" style="x"><char style="xo" closed="false">35.19 </char><char style="xk" closed="false">cagione </char><char style="xt" closed="false"><ref loc="JHN 15:25">Giov. 15.25</ref>.</char></note>.<verse eid="PSA 35:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20"/>Perciocchè non parlano <char style="add">giammai</char> di pace;</para>
  <para style="q" vid="PSA 35:20">Anzi macchinano frodi contro a' pacifici della terra.<verse eid="PSA 35:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21"/>Ed allargano la lor bocca contro a me,</para>
  <para style="q" vid="PSA 35:21">E dicono: Eia, Eia! l'occhio nostro ha pur veduto <char style="add">quello che desideravamo</char>.<verse eid="PSA 35:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22"/>O Signore, tu hai vedute <char style="add">queste cose</char>; non tacere;</para>
  <para style="q" vid="PSA 35:22">O Signore, non allontanarti da me.<verse eid="PSA 35:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23"/>Risvegliati, e destati, per <char style="add">far</char>mi ragione;</para>
  <para style="q" vid="PSA 35:23">Dio mio, e Signor mio, <char style="add">risvegliati</char> per difendere la mia causa.<verse eid="PSA 35:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24"/>O Signore Iddio mio, giudicami secondo la tua giustizia<note caller="*" style="x"><char style="xo" closed="false">35.24 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="2TH 1:6">2 Tess. 1.6</ref>.</char></note>,</para>
  <para style="q" vid="PSA 35:24">E <char style="add">fa</char>' ch'essi non si rallegrino di me;<verse eid="PSA 35:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25"/>
    <char style="add">E</char> non dicano nel cuor loro: Ehi! anima nostra;</para>
  <para style="q" vid="PSA 35:25">
    <char style="add">E</char> non dicano: Noi l'abbiamo trangugiato.<verse eid="PSA 35:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26"/>Sieno svergognati e confusi tutti quanti</para>
  <para style="q" vid="PSA 35:26">Quelli che si rallegrano del mio male;</para>
  <para style="q" vid="PSA 35:26">Sieno vestiti di vergogna e di vituperio</para>
  <para style="q" vid="PSA 35:26">Quelli che si magnificano contro a me.<verse eid="PSA 35:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27"/>Cantino, e rallegrinsi</para>
  <para style="q" vid="PSA 35:27">Quelli che hanno buona affezione alla mia giustizia<note caller="*" style="x"><char style="xo" closed="false">35.27 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="ROM 12:15">Rom. 12.15</ref>. <ref loc="1CO 12:26">1 Cor. 12.26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 35:27">E dicano del continuo: Magnificato sia il Signore,</para>
  <para style="q" vid="PSA 35:27">Che vuole la pace del suo servitore.<verse eid="PSA 35:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28"/>E la mia lingua risonerà la tua giustizia</para>
  <para style="q" vid="PSA 35:28">
    <char style="add">E</char> la tua laude, tuttodì<note caller="*" style="x"><char style="xo" closed="false">35.28 </char><char style="xk" closed="false">tuttodì </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sal. 50.15</ref>; <ref loc="PSA 51:14">51.14</ref>; <ref loc="PSA 71:24">71.24</ref>.</char></note>.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">SALMO XXXVI</para>
  <para style="s1">Estrema malizia degli empi; ricorso a Dio giusto e benigno, perchè salvi i suoi</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide, servitor del Signore, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1"/>IL misfatto dell'empio mi dice dentro al cuore,</para>
  <para style="q" vid="PSA 36:1">
    <char style="add">Ch'egli</char> non <char style="add">ha</char> timore alcuno di Dio davanti agli occhi<note caller="*" style="x"><char style="xo" closed="false">36.1 </char><char style="xk" closed="false">occhi </char><char style="xt" closed="false"><ref loc="ROM 3:18">Rom. 3.18</ref>.</char></note>.<verse eid="PSA 36:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2"/>Perciocchè egli si lusinga appo sè stesso<note caller="*" style="x"><char style="xo" closed="false">36.2 </char><char style="xk" closed="false">stesso </char><char style="xt" closed="false"><ref loc="DEU 29:19">Deut. 29.19</ref>.</char></note>,</para>
  <para style="q" vid="PSA 36:2">Per venire a capo della sua iniquità, <char style="add">che è pur</char> da odiare.<verse eid="PSA 36:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3"/>Le parole della sua bocca <char style="add">sono</char> iniquità e frode;</para>
  <para style="q" vid="PSA 36:3">Egli non ha più intelletto da far bene.<verse eid="PSA 36:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4"/>Egli divisa iniquità sopra il suo letto;</para>
  <para style="q" vid="PSA 36:4">Egli si ferma nella via <char style="add">che</char> non <char style="add">è</char> buona,</para>
  <para style="q" vid="PSA 36:4">Egli non abborre il male.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5"/>O Signore, la tua benignità <char style="add">arriva</char> infino al cielo,</para>
  <para style="q" vid="PSA 36:5">
    <char style="add">E</char> la tua verità infino alle nuvole.<verse eid="PSA 36:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6"/>La tua giustizia <char style="add">è</char> simile a monti altissimi;</para>
  <para style="q" vid="PSA 36:6">I tuoi giudicii <char style="add">sono</char> un grande abisso<note caller="*" style="x"><char style="xo" closed="false">36.6 </char><char style="xk" closed="false">abisso </char><char style="xt" closed="false"><ref loc="JOB 11:8">Giob. 11.8</ref>. <ref loc="ROM 11:33">Rom. 11.33</ref>.</char></note>.</para>
  <para style="q" vid="PSA 36:6">O Signore, tu conservi uomini e bestie.<verse eid="PSA 36:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7"/>O Dio, quanto preziosa <char style="add">è</char> la tua benignità!</para>
  <para style="q" vid="PSA 36:7">Perciò i figliuoli degli uomini si riducono sotto l'ombra delle tue ale<note caller="*" style="x"><char style="xo" closed="false">36.7 </char><char style="xk" closed="false">ale </char><char style="xt" closed="false"><ref loc="RUT 2:12">Rut 2.12</ref>. <ref loc="PSA 91:4">Sal. 91.4</ref>.</char></note>;<verse eid="PSA 36:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8"/>Son saziati del grasso della tua Casa;</para>
  <para style="q" vid="PSA 36:8">Tu li abbeveri del torrente delle tue delizie<note caller="*" style="x"><char style="xo" closed="false">36.8 </char><char style="xk" closed="false">delizie </char><char style="xt" closed="false"><ref loc="PSA 16:11">Sal. 16.11</ref>. <ref loc="REV 22:1">Apoc. 22.1</ref>.</char></note>.<verse eid="PSA 36:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9"/>Perciocchè appo te <char style="add">è</char> la fonte della vita<note caller="*" style="x"><char style="xo" closed="false">36.9 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="JER 2:13">Ger. 2.13</ref>. <ref loc="JHN 4:10">Giov. 4.10</ref>,<ref loc="JHN 4:14">14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 36:9">E per la tua luce noi veggiamo la luce<note caller="*" style="x"><char style="xo" closed="false">36.9 </char><char style="xk" closed="false">luce </char><char style="xt" closed="false"><ref loc="ACT 26:18">Fat. 26.18</ref>. <ref loc="1PE 2:9">1 Piet. 2.9</ref>.</char></note>.<verse eid="PSA 36:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10"/>Stendi la tua benignità inverso quelli che ti conoscono,</para>
  <para style="q" vid="PSA 36:10">E la tua giustizia inverso quelli che son diritti di cuore.<verse eid="PSA 36:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11"/>Non vengami addosso il piè del superbo;</para>
  <para style="q" vid="PSA 36:11">E la mano degli empi non mi smuova.<verse eid="PSA 36:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12"/>
    <char style="add">Ecco</char> là, gli operatori d'iniquità son caduti;</para>
  <para style="q" vid="PSA 36:12">Sono stati sospinti, e non son potuti risorgere.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">SALMO XXXVII</para>
  <para style="s1">Il peccatore, benchè prosperi, non deve essere invidiato; in ultimo, saran felici solo i giusti</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1"/>NON crucciarti per cagion de' maligni;</para>
  <para style="q" vid="PSA 37:1">Non portare invidia a quelli che operano perversamente<note caller="*" style="x"><char style="xo" closed="false">37.1 </char><char style="xk" closed="false">perversamente </char><char style="xt" closed="false"><ref loc="PSA 73:3">Sal. 73.3</ref> ecc. <ref loc="PRO 23:17">Prov. 23.17</ref>; <ref loc="PRO 24:1">24.1</ref>,<ref loc="PRO 24:19">19</ref>.</char></note>;<verse eid="PSA 37:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2"/>Perciocchè saran di subito ricisi come fieno,</para>
  <para style="q" vid="PSA 37:2">E si appasseranno come erbetta verde.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3"/>Confidati nel Signore<note caller="*" style="x"><char style="xo" closed="false">37.3 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>, e fa' bene;</para>
  <para style="q" vid="PSA 37:3">Tu abiterai nella terra, e <char style="add">vi</char> pasturerai <char style="add">in</char> confidanza.<verse eid="PSA 37:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4"/>E prendi il tuo diletto nel Signore,</para>
  <para style="q" vid="PSA 37:4">Ed egli ti darà le domande del tuo cuore<note caller="*" style="x"><char style="xo" closed="false">37.4 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="MAT 7:7-11">Mat. 7.7-11</ref>.</char></note>.<verse eid="PSA 37:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5"/>Rimetti la tua via nel Signore;</para>
  <para style="q" vid="PSA 37:5">E confidati in lui, ed egli farà <char style="add">ciò che bisogna</char><note caller="*" style="x"><char style="xo" closed="false">37.5 </char><char style="xk" closed="false"><char style="add">bisogna</char> </char><char style="xt" closed="false"><ref loc="PSA 40:17">Sal. 40.17</ref>; <ref loc="PSA 55:21">55.21</ref>. <ref loc="MAT 6:25">Mat. 6.25</ref> ecc. <ref loc="1PE 5:7">1 Piet. 5.7</ref>.</char></note>;<verse eid="PSA 37:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6"/>E produrrà fuori la tua giustizia, come la luce;</para>
  <para style="q" vid="PSA 37:6">E la tua dirittura, come il mezzodì.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7"/>Attendi il Signore in silenzio<note caller="*" style="x"><char style="xo" closed="false">37.7 </char><char style="xk" closed="false">silenzio </char><char style="xt" closed="false"><ref loc="ISA 30:15">Is. 30.15</ref>. <ref loc="LAM 3:26">Lam. 3.26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:7">Non crucciarti per colui che prospera nella sua via<note caller="*" style="x"><char style="xo" closed="false">37.7 </char><char style="xk" closed="false">via </char><char style="xta" closed="false">Vers. 1 e rif. </char><char style="xt" closed="false"><ref loc="JER 12:1">Ger. 12.1</ref>.</char></note>,</para>
  <para style="q" vid="PSA 37:7">Per l'uomo che opera scelleratezza.<verse eid="PSA 37:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8"/>Rimanti dell'ira, e lascia il cruccio;</para>
  <para style="q" vid="PSA 37:8">Non isdegnarti, sì veramente, che tu venga a far male<note caller="*" style="x"><char style="xo" closed="false">37.8 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="EPH 4:26">Efes. 4.26</ref>.</char></note>.<verse eid="PSA 37:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9"/>Perciocchè i maligni saranno sterminati<note caller="*" style="x"><char style="xo" closed="false">37.9 </char><char style="xk" closed="false">sterminati </char><char style="xt" closed="false"><ref loc="JOB 27:13">Giob. 27.13</ref>,<ref loc="JOB 27:14">14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:9">Ma coloro che sperano nel Signore possederanno la terra<note caller="*" style="x"><char style="xo" closed="false">37.9 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"/><char style="xta" closed="false">Ver. </char><char style="xt" closed="false">37.5,11,22,29. Is. 57.13.</char></note>.<verse eid="PSA 37:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10"/>Fra breve spazio l'empio non <char style="add">sarà più</char>;</para>
  <para style="q" vid="PSA 37:10">E <char style="add">se</char> tu poni mente al suo luogo, egli non <char style="add">vi sarà più</char>.<verse eid="PSA 37:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11"/>Ma i mansueti possederanno la terra<note caller="*" style="x"><char style="xo" closed="false">37.11 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="MAT 5:5">Mat. 5.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 37:11">E gioiranno in gran pace.<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12"/>L'empio fa delle macchinazioni contro al giusto,</para>
  <para style="q" vid="PSA 37:12">E digrigna i denti contro a lui.<verse eid="PSA 37:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13"/>Il Signore si riderà di lui;</para>
  <para style="q" vid="PSA 37:13">Perciocchè egli vede che il suo giorno viene.<verse eid="PSA 37:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14"/>Gli empi hanno tratta la spada,</para>
  <para style="q" vid="PSA 37:14">Ed hanno teso il loro arco,</para>
  <para style="q" vid="PSA 37:14">Per abbattere il povero afflitto ed il bisognoso;</para>
  <para style="q" vid="PSA 37:14">Per ammazzar quelli che camminano dirittamente.<verse eid="PSA 37:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15"/>La loro spada entrerà loro nel cuore,</para>
  <para style="q" vid="PSA 37:15">E gli archi loro saranno rotti.<verse eid="PSA 37:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16"/>Meglio <char style="add">vale</char> il poco del giusto,</para>
  <para style="q" vid="PSA 37:16">Che l'abbondanza di molti empi<note caller="*" style="x"><char style="xo" closed="false">37.16 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="PRO 15:16">Prov. 15.16</ref>. <ref loc="1TI 6:6">1 Tim. 6.6</ref>.</char></note>.<verse eid="PSA 37:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17"/>Perciocchè le braccia degli empi saranno rotte;</para>
  <para style="q" vid="PSA 37:17">Ma il Signore sostiene i giusti.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18"/>Il Signore conosce i giorni<note caller="*" style="x"><char style="xo" closed="false">37.18 </char><char style="xk" closed="false">giorni </char><char style="xt" closed="false"><ref loc="PSA 1:6">Sal. 1.6</ref>; <ref loc="PSA 31:7">31.7</ref>.</char></note> degli <char style="add">uomini</char> intieri;</para>
  <para style="q" vid="PSA 37:18">E la loro eredità <char style="add">sarà</char> in eterno<note caller="*" style="x"><char style="xo" closed="false">37.18 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="ISA 60:21">Is. 60.21</ref>.</char></note>.<verse eid="PSA 37:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19"/>Essi non saran confusi nel tempo dell'avversità;</para>
  <para style="q" vid="PSA 37:19">
    <char style="add">E</char> saranno saziati nel tempo della fame.<verse eid="PSA 37:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20"/>Ma gli empi periranno;</para>
  <para style="q" vid="PSA 37:20">Ed i nemici del Signore, come grasso d'agnelli,</para>
  <para style="q" vid="PSA 37:20">Saranno consumati, e andranno in fumo.<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21"/>L'empio prende in prestanza, e non rende;</para>
  <para style="q" vid="PSA 37:21">Ma il giusto largisce, e dona<note caller="*" style="x"><char style="xo" closed="false">37.21 </char><char style="xk" closed="false">dona </char><char style="xt" closed="false"><ref loc="PSA 112:5">Sal. 112.5</ref>,<ref loc="PSA 112:9">9</ref>.</char></note>.<verse eid="PSA 37:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22"/>Perciocchè i benedetti dal Signore erederanno la terra;</para>
  <para style="q" vid="PSA 37:22">Ma i maledetti da lui saranno sterminati.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23"/>I passi dell'uomo, la cui via il Signore gradisce,</para>
  <para style="q" vid="PSA 37:23">Son da lui addirizzati<note caller="*" style="x"><char style="xo" closed="false">37.23 </char><char style="xk" closed="false">addirizzati </char><char style="xt" closed="false"><ref loc="1SA 2:9">1 Sam. 2.9</ref>. <ref loc="PRO 16:9">Prov. 16.9</ref>.</char></note>.<verse eid="PSA 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24"/>Se cade, non è però atterrato<note caller="*" style="x"><char style="xo" closed="false">37.24 </char><char style="xk" closed="false">atterrato </char><char style="xt" closed="false"><ref loc="PSA 91:12">Sal. 91.12</ref>. <ref loc="PRO 24:16">Prov. 24.16</ref>. <ref loc="2CO 4:9">2 Cor. 4.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:24">Perciocchè il Signore gli sostiene la mano.<verse eid="PSA 37:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25"/>Io sono stato fanciullo, e sono eziandio divenuto vecchio,</para>
  <para style="q" vid="PSA 37:25">E non ho veduto il giusto abbandonato,</para>
  <para style="q" vid="PSA 37:25">Nè la sua progenie accattare il pane<note caller="*" style="x"><char style="xo" closed="false">37.25 </char><char style="xk" closed="false">pane </char><char style="xt" closed="false"><ref loc="PSA 112:2">Sal. 112.2</ref>.</char></note>.<verse eid="PSA 37:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26"/>Egli tuttodì dona e presta<note caller="*" style="x"><char style="xo" closed="false">37.26 </char><char style="xk" closed="false">presta </char><char style="xt" closed="false"><ref loc="DEU 15:8">Deut. 15.8</ref>,<ref loc="DEU 15:10">10</ref>. <ref loc="PSA 112:5">Sal. 112.5</ref>,<ref loc="PSA 112:9">9</ref>. <ref loc="MAT 5:42">Mat. 5.42</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:26">E la sua progenie <char style="add">è</char> in benedizione.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27"/>Ritratti dal male, e fa' il bene<note caller="*" style="x"><char style="xo" closed="false">37.27 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="PSA 34:14">Sal. 34.14</ref>. <ref loc="ISA 1:16">Is. 1.16</ref>,<ref loc="ISA 1:17">17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:27">E tu sarai stanziato in eterno.<verse eid="PSA 37:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28"/>Perciocchè il Signore ama la dirittura,</para>
  <para style="q" vid="PSA 37:28">E non abbandonerà i suoi santi;</para>
  <para style="q" vid="PSA 37:28">Essi saranno conservati in eterno;</para>
  <para style="q" vid="PSA 37:28">Ma la progenie degli empi sarà sterminata.<verse eid="PSA 37:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29"/>I giusti erederanno la terra;</para>
  <para style="q" vid="PSA 37:29">Ed abiteranno in perpetuo sopra essa.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30"/>La bocca del giusto risuona sapienza<note caller="*" style="x"><char style="xo" closed="false">37.30 </char><char style="xk" closed="false">sapienza </char><char style="xt" closed="false"><ref loc="MAT 12:35">Mat. 12.35</ref>.</char></note>,</para>
  <para style="q" vid="PSA 37:30">E la sua lingua pronunzia dirittura.<verse eid="PSA 37:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31"/>La Legge dell'Iddio suo <char style="add">è</char> nel suo cuore<note caller="*" style="x"><char style="xo" closed="false">37.31 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="DEU 6:6">Deut. 6.6</ref>. <ref loc="PSA 40:8">Sal. 40.8</ref>; <ref loc="PSA 119:11">119.11</ref>,<ref loc="PSA 119:98">98</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:31">I suoi passi non vacilleranno.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32"/>L'empio spia il giusto,</para>
  <para style="q" vid="PSA 37:32">E cerca di ucciderlo.<verse eid="PSA 37:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33"/>Il Signore non glielo lascerà nelle mani<note caller="*" style="x"><char style="xo" closed="false">37.33 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="2PE 2:9">2 Piet. 2.9</ref>.</char></note>,</para>
  <para style="q" vid="PSA 37:33">E non permetterà che sia condannato, quando sarà giudicato.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34"/>Aspetta il Signore<note caller="*" style="x"><char style="xo" closed="false">37.34 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PRO 20:22">Prov. 20.22</ref>.</char></note>, e guarda la sua via,</para>
  <para style="q" vid="PSA 37:34">Ed egli t'innalzerà, acciocchè tu eredi la terra;</para>
  <para style="q" vid="PSA 37:34">Quando gli empi saranno sterminati, tu lo vedrai.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35"/>Io ho veduto l'empio possente<note caller="*" style="x"><char style="xo" closed="false">37.35 </char><char style="xk" closed="false">possente </char><char style="xt" closed="false"><ref loc="JOB 5:3">Giob. 5.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 37:35">E che si distendeva come un verde lauro;<verse eid="PSA 37:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36"/>Ma egli è passato via<note caller="*" style="x"><char style="xo" closed="false">37.36 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="JOB 20:5">Giob. 20.5</ref> ecc. <ref loc="PSA 73:18-20">Sal. 73.18-20</ref>.</char></note>; ed ecco, egli non <char style="add">è più</char>;</para>
  <para style="q" vid="PSA 37:36">Ed io l'ho cercato, e non si è ritrovato.<verse eid="PSA 37:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37"/>Guarda l'integrità, e riguarda alla dirittura;</para>
  <para style="q" vid="PSA 37:37">Perciocchè <char style="add">vi è</char> mercede per l'uomo di pace<note caller="*" style="x"><char style="xo" closed="false">37.37 </char><char style="xk" closed="false">pace </char><char style="xt" closed="false"><ref loc="ISA 32:17">Is. 32.17</ref>; <ref loc="ISA 57:2">57.2</ref>.</char></note>.<verse eid="PSA 37:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38"/>Ma i trasgressori saranno distrutti tutti quanti;</para>
  <para style="q" vid="PSA 37:38">Ogni mercede è ricisa agli empi.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39"/>Ma la salute de' giusti <char style="add">è</char> dal Signore<note caller="*" style="x"><char style="xo" closed="false">37.39 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 3:8">Sal. 3.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:39">Egli <char style="add">è</char> la lor fortezza nel tempo dell'afflizione<note caller="*" style="x"><char style="xo" closed="false">37.39 </char><char style="xk" closed="false">afflizione </char><char style="xt" closed="false"><ref loc="PSA 9:9">Sal. 9.9</ref>.</char></note>;<verse eid="PSA 37:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40"/>Ed il Signore li aiuta e li libera<note caller="*" style="x"><char style="xo" closed="false">37.40 </char><char style="xk" closed="false">libera </char><char style="xt" closed="false"><ref loc="ISA 31:5">Is. 31.5</ref>. <ref loc="ACT 12:11">Fat. 12.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 37:40">Li libera dagli empi, e li salva;</para>
  <para style="q" vid="PSA 37:40">Perciocchè hanno sperato in lui<note caller="*" style="x"><char style="xo" closed="false">37.40 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="DAN 3:17">Dan. 3.17</ref>,<ref loc="DAN 3:28">28</ref>; <ref loc="DAN 6:23">6.23</ref>.</char></note>.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">SALMO XXXVIII</para>
  <para style="s1">Dolore e pentimento per il peccato commesso. Ricorso a Dio per ottener perdono e salvezza</para>
  <para style="d">Salmo di Davide, da rammemorare</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1"/>SIGNORE, non correggermi nella tua indegnazione<note caller="*" style="x"><char style="xo" closed="false">38.1 </char><char style="xk" closed="false">indegnazione </char><char style="xt" closed="false"><ref loc="PSA 6:1">Sal. 6.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 38:1">E <char style="add">non</char> castigarmi nel tuo cruccio.<verse eid="PSA 38:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2"/>Perciocchè le tue saette son discese in me,</para>
  <para style="q" vid="PSA 38:2">E la tua mano mi si è calata addosso.<verse eid="PSA 38:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3"/>Egli non <char style="add">vi è</char> nulla di sano nella mia carne<note caller="*" style="x"><char style="xo" closed="false">38.3 </char><char style="xk" closed="false">carne </char><char style="xt" closed="false"><ref loc="ISA 1:6">Is. 1.6</ref>.</char></note>, per cagione della tua ira;</para>
  <para style="q" vid="PSA 38:3">Le mie ossa non hanno requie alcuna, per cagion del mio peccato.<verse eid="PSA 38:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4"/>Perciocchè le mie iniquità trapassano il mio capo<note caller="*" style="x"><char style="xo" closed="false">38.4 </char><char style="xk" closed="false">capo </char><char style="xt" closed="false"><ref loc="EZR 9:6">Esd. 9.6</ref>. <ref loc="PSA 40:12">Sal. 40.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 38:4">
    <char style="add">Sono</char> a guisa di grave peso, son pesanti più che io non posso portare<note caller="*" style="x"><char style="xo" closed="false">38.4 </char><char style="xk" closed="false">portare </char><char style="xt" closed="false"><ref loc="MAT 11:28">Mat. 11.28</ref>.</char></note>.<verse eid="PSA 38:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5"/>Le mie posteme putono, e colano,</para>
  <para style="q" vid="PSA 38:5">Per la mia follia.<verse eid="PSA 38:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6"/>Io son tutto travolto e piegato;</para>
  <para style="q" vid="PSA 38:6">Io vo attorno tuttodì vestito a bruno;<verse eid="PSA 38:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7"/>Perciocchè i miei fianchi son pieni d'infiammagione;</para>
  <para style="q" vid="PSA 38:7">E non <char style="add">vi è</char> nulla di sano nella mia carne.<verse eid="PSA 38:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8"/>Io son tutto fiacco e trito;</para>
  <para style="q" vid="PSA 38:8">Io ruggisco per il fremito del mio cuore.<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9"/>Signore, ogni mio desiderio <char style="add">è</char> nel tuo cospetto;</para>
  <para style="q" vid="PSA 38:9">Ed i miei sospiri non ti sono occulti.<verse eid="PSA 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10"/>Il mio cuore è agitato, la mia forza mi lascia;</para>
  <para style="q" vid="PSA 38:10">La luce stessa de' miei occhi non <char style="add">è più</char> appo me<note caller="*" style="x"><char style="xo" closed="false">38.10 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="PRO 15:30">Prov. 15.30</ref>.</char></note>.<verse eid="PSA 38:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11"/>I miei amici ed i miei compagni se ne stanno di rincontro alla mia piaga<note caller="*" style="x"><char style="xo" closed="false">38.11 </char><char style="xk" closed="false">piaga </char><char style="xt" closed="false"><ref loc="LUK 10:31">Luc. 10.31</ref>,<ref loc="LUK 10:32">32</ref>.</char></note>;</para>
  <para style="q" vid="PSA 38:11">Ed i miei prossimi si fermano da lungi<note caller="*" style="x"><char style="xo" closed="false">38.11 </char><char style="xk" closed="false">lungi </char><char style="xt" closed="false"><ref loc="MRK 15:40">Mar. 15.40</ref>. <ref loc="LUK 23:49">Luc. 23.49</ref>.</char></note>.<verse eid="PSA 38:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12"/>E questi che cercano l'anima mia <char style="add">mi</char> tendono delle reti;</para>
  <para style="q" vid="PSA 38:12">E quelli che procacciano il mio male parlano di malizie,</para>
  <para style="q" vid="PSA 38:12">E ragionano di frodi tuttodì<note caller="*" style="x"><char style="xo" closed="false">38.12 </char><char style="xk" closed="false">tuttodì </char><char style="xt" closed="false"><ref loc="2SA 16:7">2 Sam. 16.7</ref> ecc.; <ref loc="2SA 17:1-3">17.1-3</ref>.</char></note>.<verse eid="PSA 38:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13"/>Ma io, come <char style="add">se fossi</char> sordo, non ascolto;</para>
  <para style="q" vid="PSA 38:13">E <char style="add">son</char> come un mutolo che non apre la bocca<note caller="*" style="x"><char style="xo" closed="false">38.13 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="2SA 16:10">2 Sam. 16.10</ref>.</char></note>.<verse eid="PSA 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14"/>E son come un uomo che non ode;</para>
  <para style="q" vid="PSA 38:14">E <char style="add">come uno</char> che non ha replica alcuna in bocca.<verse eid="PSA 38:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15"/>Perciocchè, o Signore, io ti aspetto,</para>
  <para style="q" vid="PSA 38:15">Tu risponderai, o Signore Iddio mio.<verse eid="PSA 38:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16"/>Perciocchè io ho detto: <char style="add">Fa</char>' che non si rallegrino di me;</para>
  <para style="q" vid="PSA 38:16">Quando il mio piè vacilla, essi s'innalzano contro a me.<verse eid="PSA 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17"/>Mentre son tutto presto a cadere,</para>
  <para style="q" vid="PSA 38:17">E la mia doglia <char style="add">è</char> davanti a me del continuo;<verse eid="PSA 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18"/>Mentre io dichiaro la mia iniquità<note caller="*" style="x"><char style="xo" closed="false">38.18 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 32:5">Sal. 32.5</ref>. <ref loc="PRO 28:13">Prov. 28.13</ref>.</char></note>,</para>
  <para style="q" vid="PSA 38:18">
    <char style="add">E</char> sono angosciato per lo mio peccato<note caller="*" style="x"><char style="xo" closed="false">38.18 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="2CO 7:9">2 Cor. 7.9</ref>,<ref loc="2CO 7:10">10</ref>.</char></note>;<verse eid="PSA 38:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19"/>I miei nemici vivono, e si fortificano;</para>
  <para style="q" vid="PSA 38:19">E quelli che mi odiano a torto s'ingrandiscono.<verse eid="PSA 38:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20"/>Quelli, <char style="add">dico</char>, che mi rendono mal per bene;</para>
  <para style="q" vid="PSA 38:20">Che mi sono avversari, in iscambio di ciò che ho <char style="add">loro</char> procacciato del bene.<verse eid="PSA 38:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21"/>Signore, non abbandonarmi;</para>
  <para style="q" vid="PSA 38:21">Dio mio, non allontanarti da me.<verse eid="PSA 38:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22"/>Affrettati al mio aiuto,</para>
  <para style="q" vid="PSA 38:22">O Signore, mia salute<note caller="*" style="x"><char style="xo" closed="false">38.22 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="PSA 27:1">Sal. 27.1</ref>. <ref loc="ISA 12:2">Is. 12.2</ref>.</char></note>.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">SALMO XXXIX</para>
  <para style="s1">Viglianza sui propri pensieri. La brevità della vita, il rispetto ai giudicii di Dio e la preghiera son freni all'impazienza</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> a Iedutun, Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1"/>IO aveva detto: Io prenderò guardia alle mie vie,</para>
  <para style="q" vid="PSA 39:1">Che io non pecchi colla mia lingua;</para>
  <para style="q" vid="PSA 39:1">Io guarderò la mia bocca con un frenello<note caller="*" style="x"><char style="xo" closed="false">39.1 </char><char style="xk" closed="false">frenello </char><char style="xt" closed="false"><ref loc="PSA 141:3">Sal. 141.3</ref>. <ref loc="JAS 3:2">Giac. 3.2</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 39:1">Mentre l'empio <char style="add">sarà</char> davanti a me<note caller="*" style="x"><char style="xo" closed="false">39.1 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="COL 4:5">Col. 4.5</ref>.</char></note>.<verse eid="PSA 39:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2"/>Io sono stato mutolo e cheto;</para>
  <para style="q" vid="PSA 39:2">Ho <char style="add">eziandio</char> taciuto il bene;</para>
  <para style="q" vid="PSA 39:2">Ma la mia doglia si è inasprita.<verse eid="PSA 39:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3"/>Il mio cuore si è riscaldato dentro di me<note caller="*" style="x"><char style="xo" closed="false">39.3 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="JER 20:9">Ger. 20.9</ref>. <ref loc="LUK 24:32">Luc. 24.32</ref>.</char></note>;</para>
  <para style="q" vid="PSA 39:3">Un fuoco si è acceso, mentre io ravvolgeva <char style="add">questo</char> nell'animo mio;</para>
  <para style="q" vid="PSA 39:3">
    <char style="add">Onde</char> io ho parlato colla mia lingua, <char style="add">dicendo:</char><verse eid="PSA 39:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4"/>O Signore, fammi conoscere il mio fine,</para>
  <para style="q" vid="PSA 39:4">E quale è il termine de' miei dì<note caller="*" style="x"><char style="xo" closed="false">39.4 </char><char style="xk" closed="false">dì </char><char style="xt" closed="false"><ref loc="PSA 90:12">Sal. 90.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 39:4">
    <char style="add">Fa' ch</char>'io sappia quanto io ho da vivere <char style="add">ancora</char> in questo mondo.<verse eid="PSA 39:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5"/>Ecco tu hai ridotti i miei dì alla misura di un palmo,</para>
  <para style="q" vid="PSA 39:5">E il tempo della mia vita <char style="add">è</char> come niente appo te<note caller="*" style="x"><char style="xo" closed="false">39.5 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 90:4">Sal. 90.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 39:5">Certo, ogni uomo, quantunque sia in piè, <char style="add">è</char> tutta vanità. <char style="qs">(Sela.)</char><verse eid="PSA 39:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6"/>Certo l'uomo va e viene in figura<note caller="*" style="x"><char style="xo" closed="false">39.6 </char><char style="xk" closed="false">figura </char><char style="xt" closed="false"><ref loc="1CO 7:31">1 Cor. 7.31</ref>. <ref loc="JAS 4:14">Giac. 4.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 39:6">Certo in vano si travagliano tutti,</para>
  <para style="q" vid="PSA 39:6">
    <char style="add">E</char> adunano <char style="add">de' beni</char> senza sapere chi li raccorrà<note caller="*" style="x"><char style="xo" closed="false">39.6 </char><char style="xk" closed="false">raccorrà </char><char style="xt" closed="false"><ref loc="ECC 2:21">Eccl. 2.21</ref>. <ref loc="LUK 12:20">Luc. 12.20</ref>,<ref loc="LUK 12:21">21</ref>.</char></note>.<verse eid="PSA 39:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7"/>Ma ora, Signore, che aspetto io?</para>
  <para style="q" vid="PSA 39:7">La mia speranza è in te.<verse eid="PSA 39:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8"/>Liberami da tutti i miei misfatti;</para>
  <para style="q" vid="PSA 39:8">Non farmi essere il vituperio dello stolto.<verse eid="PSA 39:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9"/>Io ammutolisco, io non aprirò la bocca<note caller="*" style="x"><char style="xo" closed="false">39.9 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="LEV 10:3">Lev. 10.3</ref>. <ref loc="JOB 39:36-38">Giob. 39.36-38</ref>.</char></note>;</para>
  <para style="q" vid="PSA 39:9">Perciocchè tu hai fatto <char style="add">questo</char><note caller="*" style="x"><char style="xo" closed="false">39.9 </char><char style="xk" closed="false"><char style="add">questo</char> </char><char style="xt" closed="false"><ref loc="2SA 16:10">2 Sam. 16.10</ref>. <ref loc="JOB 2:10">Giob. 2.10</ref>.</char></note>.<verse eid="PSA 39:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10"/>Toglimi d'addosso la tua piaga;</para>
  <para style="q" vid="PSA 39:10">Io mi vengo meno, per la guerra che tu <char style="add">mi</char> fai colla tua mano.<verse eid="PSA 39:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11"/>Se tu castighi alcuno con castigamenti d'iniquità,</para>
  <para style="q" vid="PSA 39:11">Tu fai struggere tutto ciò che vi è di bello e d'eccellente in lui,</para>
  <para style="q" vid="PSA 39:11">Come una tignuola; certo, ogni uomo <char style="add">è</char> vanità. <char style="qs">(Sela.)</char><verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12"/>Signore, ascolta la mia orazione, e porgi l'orecchio al mio grido,</para>
  <para style="q" vid="PSA 39:12">E non esser sordo alle mie lagrime;</para>
  <para style="q" vid="PSA 39:12">Perciocchè io <char style="add">son</char> forestiere appo te,</para>
  <para style="q" vid="PSA 39:12">
    <char style="add">Ed</char> avveniticcio<note caller="*" style="x"><char style="xo" closed="false">39.12 </char><char style="xk" closed="false">avveniticcio </char><char style="xt" closed="false"><ref loc="LEV 25:23">Lev. 25.23</ref>. <ref loc="1CH 29:15">1 Cron. 29.15</ref>. <ref loc="2CO 5:6">2 Cor. 5.6</ref>. <ref loc="HEB 11:13">Ebr. 11.13</ref>.</char></note>, come tutti i miei padri.<verse eid="PSA 39:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13"/>Cessati da me, acciocchè io mi rinforzi,</para>
  <para style="q" vid="PSA 39:13">Innanzi che io me ne vada, e non <char style="add">sia più</char>.<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">SALMO XL</para>
  <para style="s1">Chi aspetta con pazienza sarà liberato. Ubbidienza val meglio che sacrificio. Preghiera per ottener liberazione</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1"/>IO ho lungamente e pazientemente aspettato il Signore<note caller="*" style="x"><char style="xo" closed="false">40.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 27:14">Sal. 27.14</ref>; <ref loc="PSA 37:7">37.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 40:1">Ed egli si è inchinato a me, ed ha ascoltato il mio grido;<verse eid="PSA 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2"/>E mi ha tratto fuor di una fossa ruinosa,</para>
  <para style="q" vid="PSA 40:2">Di un fango pantanoso;</para>
  <para style="q" vid="PSA 40:2">Ed ha rizzati i miei piedi sopra una roccia,</para>
  <para style="q" vid="PSA 40:2">
    <char style="add">Ed</char> ha fermati i miei passi.<verse eid="PSA 40:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3"/>Ed ha messo nella mia bocca un nuovo cantico</para>
  <para style="q" vid="PSA 40:3">
    <char style="add">Per</char> lode dell'Iddio nostro;</para>
  <para style="q" vid="PSA 40:3">Molti vedranno <char style="add">questo</char>, e temeranno,</para>
  <para style="q" vid="PSA 40:3">E si confideranno nel Signore.<verse eid="PSA 40:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4"/>Beato l'uomo che ha posto il Signore <char style="add">per</char> sua confidanza;</para>
  <para style="q" vid="PSA 40:4">E non riguarda a' possenti superbi,</para>
  <para style="q" vid="PSA 40:4">Nè a quelli che si rivolgono dietro a menzogna.<verse eid="PSA 40:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5"/>Signore Iddio mio, tu fai grandi le tue maraviglie;</para>
  <para style="q" vid="PSA 40:5">E i tuoi pensieri inverso noi</para>
  <para style="q" vid="PSA 40:5">Non ponno per alcuna maniera esserti spiegati per ordine<note caller="*" style="x"><char style="xo" closed="false">40.5 </char><char style="xk" closed="false">ordine </char><char style="xt" closed="false"><ref loc="EXO 15:11">Esod. 15.11</ref>. <ref loc="JOB 5:9">Giob. 5.9</ref>. <ref loc="PSA 139:6">Sal. 139.6</ref>,<ref loc="PSA 139:17">17</ref>. <ref loc="ISA 55:8">Is. 55.8</ref>,<ref loc="ISA 55:9">9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 40:5">
    <char style="add">Se</char> io imprendo di narrar<char style="add">li</char> e di parlar<char style="add">ne</char>,</para>
  <para style="q" vid="PSA 40:5">Son tanti che io non posso annoverarli.<verse eid="PSA 40:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6"/>Tu non prendi piacere in sacrificio, nè in offerta<note caller="*" style="x"><char style="xo" closed="false">40.6 </char><char style="xk" closed="false">offerta </char><char style="xt" closed="false"><ref loc="1SA 15:22">1 Sam. 15.22</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 40:6">Tu mi hai forate le orecchie;</para>
  <para style="q" vid="PSA 40:6">Tu non hai chiesto, olocausto, nè sacrificio per lo peccato.<verse eid="PSA 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7"/>Allora io ho detto: Eccomi venuto;</para>
  <para style="q" vid="PSA 40:7">Egli è scritto di me nel volume del Libro<note caller="*" style="x"><char style="xo" closed="false">40.7 </char><char style="xk" closed="false">Libro </char><char style="xt" closed="false"><ref loc="LUK 24:44">Luc. 24.44</ref>.</char></note>.<verse eid="PSA 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8"/>Dio mio, io prendo piacere in far la tua volontà<note caller="*" style="x"><char style="xo" closed="false">40.8 </char><char style="xk" closed="false">volontà </char><char style="xt" closed="false"><ref loc="PSA 119:16">Sal. 119.16</ref>,<ref loc="PSA 119:24">24</ref>,<ref loc="PSA 119:47">47</ref>,<ref loc="PSA 119:92">92</ref>; <ref loc="PSA 143:10">143.10</ref>. <ref loc="JHN 4:34">Giov. 4.34</ref>. <ref loc="ROM 7:22">Rom. 7.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 40:8">E la tua Legge <char style="add">è</char> nel mezzo delle mie interiora<note caller="*" style="x"><char style="xo" closed="false">40.8 </char><char style="xk" closed="false">interiora </char><char style="xt" closed="false"><ref loc="PSA 37:31">Sal. 37.31</ref>. <ref loc="JER 31:33">Ger. 31.33</ref>. <ref loc="2CO 3:3">2 Cor. 3.3</ref>.</char></note>.<verse eid="PSA 40:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9"/>Io ho predicata la <char style="add">tua</char> giustizia in gran raunanza;</para>
  <para style="q" vid="PSA 40:9">Ecco io non ho rattenute le mie labbra; Tu <char style="add">lo</char> sai, Signore.<verse eid="PSA 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10"/>Io non ho nascosta la tua giustizia dentro al mio cuore;</para>
  <para style="q" vid="PSA 40:10">Io ho narrata la tua verità e la tua salute;</para>
  <para style="q" vid="PSA 40:10">Io non ho celata la tua benignità, nè la tua verità,</para>
  <para style="q" vid="PSA 40:10">In gran raunanza<note caller="*" style="x"><char style="xo" closed="false">40.10 </char><char style="xk" closed="false">raunanza </char><char style="xt" closed="false"><ref loc="PSA 22:25">Sal. 22.25</ref>. <ref loc="ACT 20:20">Fat. 20.20</ref>,<ref loc="ACT 20:27">27</ref>.</char></note>.<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11"/>Tu, Signore, non rattenere inverso me le tue compassioni;</para>
  <para style="q" vid="PSA 40:11">Guardinmi del continuo la tua benignità e la tua verità<note caller="*" style="x"><char style="xo" closed="false">40.11 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="PSA 43:3">Sal. 43.3</ref>. <ref loc="PRO 20:28">Prov. 20.28</ref>.</char></note>.<verse eid="PSA 40:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12"/>Perciocchè mali innumerabili mi hanno circondato;</para>
  <para style="q" vid="PSA 40:12">Le mie iniquità mi hanno giunto,</para>
  <para style="q" vid="PSA 40:12">E pur non <char style="add">le</char> posso vedere;</para>
  <para style="q" vid="PSA 40:12">Sono in maggior numero che i capelli del mio capo<note caller="*" style="x"><char style="xo" closed="false">40.12 </char><char style="xk" closed="false">capo </char><char style="xt" closed="false"><ref loc="PSA 38:4">Sal. 38.4</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 40:12">Onde il cuor mi vien meno.<verse eid="PSA 40:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13"/>Piacciati, Signore, liberarmi<note caller="*" style="x"><char style="xo" closed="false">40.13 </char><char style="xk" closed="false">liberarmi </char><char style="xt" closed="false"><ref loc="PSA 70:1">Sal. 70.1</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 40:13">Signore, affrettati in mio aiuto.<verse eid="PSA 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14"/>Quelli che cercano l'anima mia, per farla perire,</para>
  <para style="q" vid="PSA 40:14">Sieno confusi, e svergognati tutti quanti;</para>
  <para style="q" vid="PSA 40:14">Quelli che prendono piacere nel mio male,</para>
  <para style="q" vid="PSA 40:14">Voltino le spalle, e sieno svergognati.<verse eid="PSA 40:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15"/>Quelli che mi dicono: Eia, eia!</para>
  <para style="q" vid="PSA 40:15">Sieno distrutti, per ricompensa del vituperio che mi fanno.<verse eid="PSA 40:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16"/>Rallegrinsi, e gioiscano in te tutti quelli chi ti cercano;</para>
  <para style="q" vid="PSA 40:16">Quelli che amano la tua salute dicano del continuo:</para>
  <para style="q" vid="PSA 40:16">Magnificato sia il Signore<note caller="*" style="x"><char style="xo" closed="false">40.16 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 35:27">Sal. 35.27</ref>.</char></note>.<verse eid="PSA 40:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17"/>Quanto è a me, io <char style="add">son</char> povero, e bisognoso;</para>
  <para style="q" vid="PSA 40:17">
    <char style="add">Ma pure</char> il Signore ha cura di me<note caller="*" style="x"><char style="xo" closed="false">40.17 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="PSA 70:5">Sal. 70.5</ref>. <ref loc="1PE 5:7">1 Piet. 5.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 40:17">Tu <char style="add">sei</char> il mio aiuto e il mio liberatore;</para>
  <para style="q" vid="PSA 40:17">O Dio mio, non tardare.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">SALMO XLI</para>
  <para style="s1">Dio ha cura dei poveri. Davide si lagna della malvagità dei suoi nemici e ricorre a Dio per esserne liberato</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1"/>BEATO colui che si porta saviamente inverso il povero e misero<note caller="*" style="x"><char style="xo" closed="false">41.1 </char><char style="xk" closed="false">misero </char><char style="xt" closed="false"><ref loc="PRO 14:21">Prov. 14.21</ref>. <ref loc="MAT 5:7">Mat. 5.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 41:1">Il Signore lo libererà nel giorno dell'avversità.<verse eid="PSA 41:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2"/>Il Signore lo guarderà, e lo manterrà in vita;</para>
  <para style="q" vid="PSA 41:2">Egli sarà reso beato in terra;</para>
  <para style="q" vid="PSA 41:2">E tu non lo darai, <char style="add">o Dio</char>, alla voglia de' suoi nemici.<verse eid="PSA 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3"/>Il Signore lo sosterrà, quando sarà nel letto d'infermità;</para>
  <para style="q" vid="PSA 41:3">Quando sarà in malattia, tu gli rivolterai tutto il suo letto.<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4"/>Io ho detto: Signore, abbi pietà di me;</para>
  <para style="q" vid="PSA 41:4">Sana l'anima mia; perciocchè io ho peccato contro a te.<verse eid="PSA 41:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5"/>I miei nemici tengono malvagi ragionamenti di me, <char style="add">dicendo:</char></para>
  <para style="q" vid="PSA 41:5">Quando morrà egli mai? e quando sarà perito il suo nome?<verse eid="PSA 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6"/>E se <char style="add">alcun di loro</char> viene a veder<char style="add">mi</char>, parla con menzogna<note caller="*" style="x"><char style="xo" closed="false">41.6 </char><char style="xk" closed="false">menzogna </char><char style="xt" closed="false"><ref loc="PRO 26:24-26">Prov. 26.24-26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 41:6">Il suo cuore accoglie iniquità;</para>
  <para style="q" vid="PSA 41:6">
    <char style="add">E quando</char> egli è uscito fuori, ne ragiona.<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7"/>Tutti quelli che mi odiano bisbigliano insieme contro a me;</para>
  <para style="q" vid="PSA 41:7">Pensano del male di me;<verse eid="PSA 41:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8"/>
    <char style="add">Dicendo:</char> Alcun maligno male gli è attaccato addosso;</para>
  <para style="q" vid="PSA 41:8">Egli non si rileverà <char style="add">giammai del male</char> onde egli giace.<verse eid="PSA 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9"/>Eziandio l'uomo col quale io viveva in buona pace,</para>
  <para style="q" vid="PSA 41:9">Sul quale io mi confidava, che mangiava il mio pane,</para>
  <para style="q" vid="PSA 41:9">Ha alzato il calcagno contro a me<note caller="*" style="x"><char style="xo" closed="false">41.9 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="2SA 15:12">2 Sam. 15.12</ref>. <ref loc="JHN 13:18">Giov. 13.18</ref>. <ref loc="ACT 1:16">Fat. 1.16</ref>.</char></note>.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10"/>Ma tu, Signore, abbi pietà di me, e rilevami;</para>
  <para style="q" vid="PSA 41:10">Ed io farò loro la lor retribuzione.<verse eid="PSA 41:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11"/>Da questo conosco che tu mi gradisci,</para>
  <para style="q" vid="PSA 41:11">Che il mio nemico non trionfa di me.<verse eid="PSA 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12"/>Anzi tu mi hai sostenuto nella mia integrità,</para>
  <para style="q" vid="PSA 41:12">E mi hai stabilito nel tuo cospetto in perpetuo.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13"/>Benedetto <char style="add">sia</char> il Signore, l'Iddio d'Israele,</para>
  <para style="q" vid="PSA 41:13">Da un secolo infino all'<char style="add">altro</char> secolo. Amen, Amen.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="cl">SALMO XLII</para>
  <para style="s1">Il Salmista bramoso di servire Iddio nel Tempio</para>
  <para style="d">Maschil de' figliuoli di Core, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1"/>COME il cervo agogna i rivi dell'acque,</para>
  <para style="q" vid="PSA 42:1">Così l'anima mia agogna te, o Dio.<verse eid="PSA 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2"/>L'anima mia è assetata di Dio, dell'Iddio vivente<note caller="*" style="x"><char style="xo" closed="false">42.2 </char><char style="xk" closed="false">vivente </char><char style="xt" closed="false"><ref loc="PSA 63:1">Sal. 63.1</ref>; <ref loc="PSA 84">84</ref>. <ref loc="JHN 7:37">Giov. 7.37</ref>.</char></note>.</para>
  <para style="q" vid="PSA 42:2">Quando verrò, e comparirò io nel cospetto di Dio?<verse eid="PSA 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3"/>Le mie lagrime sono il mio cibo giorno e notte,</para>
  <para style="q" vid="PSA 42:3">Mentre mi è detto tuttodì: Dove <char style="add">è</char> il tuo Dio?<verse eid="PSA 42:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4"/>Io mi verso addosso l'anima mia</para>
  <para style="q" vid="PSA 42:4">
    <char style="add">Quando</char> mi riduco in memoria queste cose;</para>
  <para style="q" vid="PSA 42:4">Che io passava in ischiera,</para>
  <para style="q" vid="PSA 42:4">E camminava con essa infino alla Casa di Dio,</para>
  <para style="q" vid="PSA 42:4">Con voce di canto e di lode, la moltitudine facendo festa.<verse eid="PSA 42:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5"/>Anima mia, perchè ti abbatti, e ti commovi in me?</para>
  <para style="q" vid="PSA 42:5">Aspetta Iddio; perciocchè ancora lo celebrerò;</para>
  <para style="q" vid="PSA 42:5">Il suo aspetto <char style="add">è</char> compiuta salvezza.<verse eid="PSA 42:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6"/>O Dio mio, l'anima mia si abbatte in me;</para>
  <para style="q" vid="PSA 42:6">Perciò mi ricordo di te dal paese del Giordano<note caller="*" style="x"><char style="xo" closed="false">42.6 </char><char style="xk" closed="false">Giordano </char><char style="xt" closed="false"><ref loc="2SA 17:22">2 Sam. 17.22</ref>,<ref loc="2SA 17:24">24</ref>.</char></note>,</para>
  <para style="q" vid="PSA 42:6">E <char style="add">da' monti di</char> Hermon, dal monte Misar.<verse eid="PSA 42:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7"/>Un abisso chiama l'<char style="add">altro</char> abisso, al suon de' tuoi canali<note caller="*" style="x"><char style="xo" closed="false">42.7 </char><char style="xk" closed="false">canali </char><char style="xt" closed="false"><ref loc="JER 4:20">Ger. 4.20</ref>. <ref loc="EZK 7:26">Ezec. 7.26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 42:7">Tutti i tuoi flutti e le tue onde mi son passate addosso<note caller="*" style="x"><char style="xo" closed="false">42.7 </char><char style="xk" closed="false">addosso </char><char style="xt" closed="false"><ref loc="PSA 88:7">Sal. 88.7</ref>. <ref loc="JON 2:4">Gion. 2.4</ref>.</char></note>.<verse eid="PSA 42:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8"/>Il Signore di giorno manderà la sua benignità,</para>
  <para style="q" vid="PSA 42:8">E di notte io avrò appo me i suoi cantici,</para>
  <para style="q" vid="PSA 42:8">
    <char style="add">Ed</char> orazione all'Iddio della mia vita.<verse eid="PSA 42:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9"/>Io dirò a Dio, mia Rocca: Perchè mi hai tu dimenticato?</para>
  <para style="q" vid="PSA 42:9">Perchè vo io attorno vestito a bruno,</para>
  <para style="q" vid="PSA 42:9">Per l'oppression del nemico?<verse eid="PSA 42:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10"/>I miei nemici mi fanno onta, trafiggendomi fino all'ossa,</para>
  <para style="q" vid="PSA 42:10">Mentre mi dicono tuttodì: Dove <char style="add">è</char> il tuo Dio?<verse eid="PSA 42:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11"/>Anima mia, perchè ti abbatti, e perchè ti commovi in me?</para>
  <para style="q" vid="PSA 42:11">Aspetta Iddio; perciocchè ancora lo celebrerò;</para>
  <para style="q" vid="PSA 42:11">
    <char style="add">Egli è</char> la compiuta salvezza della mia faccia, e il mio Dio.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">SALMO XLIII</para>
  <para style="s1">Preghiera del Salmista per essere ricondotto nel santuario</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1"/>O DIO, fammi ragione, e dibatti la mia lite<note caller="*" style="x"><char style="xo" closed="false">43.1 </char><char style="xk" closed="false">lite </char><char style="xt" closed="false"><ref loc="1SA 24:16">1 Sam. 24.16</ref>.</char></note>;</para>
  <para style="q" vid="PSA 43:1">Liberami dalla gente spietata, dall'uomo frodolente ed iniquo.<verse eid="PSA 43:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2"/>Perciocchè tu <char style="add">sei</char> l'Iddio della mia fortezza<note caller="*" style="x"><char style="xo" closed="false">43.2 </char><char style="xk" closed="false">fortezza </char><char style="xt" closed="false"><ref loc="PSA 28:7">Sal. 28.7</ref>.</char></note>; perchè mi hai scacciato?</para>
  <para style="q" vid="PSA 43:2">Perchè vo io attorno vestito a bruno,</para>
  <para style="q" vid="PSA 43:2">Per l'oppression del nemico?<verse eid="PSA 43:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3"/>Manda la tua luce, e la tua verità<note caller="*" style="x"><char style="xo" closed="false">43.3 </char><char style="xk" closed="false">giudinmi </char><char style="xt" closed="false"><ref loc="PSA 40:11">Sal. 40.11</ref> </char><char style="xta" closed="false">e rif.</char></note>; giudinmi esse,</para>
  <para style="q" vid="PSA 43:3">
    <char style="add">Ed</char> introducanmi al monte della tua santità, e ne' tuoi tabernacoli.<verse eid="PSA 43:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4"/>Allora verrò all'Altare di Dio, all'Iddio dell'allegrezza del mio giubilo;</para>
  <para style="q" vid="PSA 43:4">E ti celebrerò colla cetera, o Dio, Dio mio.<verse eid="PSA 43:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5"/>Perchè ti abbatti, anima mia? e perchè ti commovi in me?</para>
  <para style="q" vid="PSA 43:5">Aspetta Iddio; perciocchè ancora lo celebrerò;</para>
  <para style="q" vid="PSA 43:5">
    <char style="add">Egli è</char> la compiuta salvezza della mia faccia, e il mio Dio.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">SALMO XLIV</para>
  <para style="s1">Il popolo di Dio, memore dei passati favori, prega per esser liberato dai suoi mali presenti</para>
  <para style="d">Maschil, <char style="add">dato</char> al Capo de' Musici, de' figliuoli di Core</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1"/>O DIO, noi abbiamo udite colle nostre orecchie,</para>
  <para style="q" vid="PSA 44:1">I nostri padri ci hanno raccontate<note caller="*" style="x"><char style="xo" closed="false">44.1 </char><char style="xk" closed="false">raccontate </char><char style="xt" closed="false"><ref loc="EXO 12:26">Esod. 12.26</ref>,<ref loc="EXO 12:27">27</ref>. <ref loc="JDG 6:13">Giud. 6.13</ref>. <ref loc="PSA 78:3">Sal. 78.3</ref> ecc.</char></note></para>
  <para style="q" vid="PSA 44:1">Le opere <char style="add">che</char> tu operasti a' dì loro,</para>
  <para style="q" vid="PSA 44:1">A' dì antichi.<verse eid="PSA 44:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2"/>Tu, <char style="add">col</char>la tua mano, scacciasti le genti, e piantasti i nostri padri<note caller="*" style="x"><char style="xo" closed="false">44.2 </char><char style="xk" closed="false">padri </char><char style="xt" closed="false"><ref loc="EXO 15:17">Esod. 15.17</ref>. <ref loc="DEU 7:1">Deut. 7.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 44:2">Tu disertasti le nazioni, e propagginasti i <char style="add">nostri padri</char>.<verse eid="PSA 44:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3"/>Perciocchè essi non conquistarono il paese colla loro spada,</para>
  <para style="q" vid="PSA 44:3">E il braccio loro non li salvò;</para>
  <para style="q" vid="PSA 44:3">Anzi la tua destra, e il tuo braccio, e la luce del tuo volto<note caller="*" style="x"><char style="xo" closed="false">44.3 </char><char style="xk" closed="false">volto </char><char style="xt" closed="false"><ref loc="DEU 8:17">Deut. 8.17</ref> ecc. <ref loc="JOS 24:12">Gios. 24.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 44:3">Perciocchè tu li gradivi<note caller="*" style="x"><char style="xo" closed="false">44.3 </char><char style="xk" closed="false">gradivi </char><char style="xt" closed="false"><ref loc="DEU 4:37">Deut. 4.37</ref>,<ref loc="DEU 4:38">38</ref>; <ref loc="DEU 7:6-8">7.6-8</ref>; <ref loc="DEU 10:15">10.15</ref>.</char></note>.<verse eid="PSA 44:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4"/>Tu, o Dio, <char style="add">sei</char> lo stesso mio Re;</para>
  <para style="q" vid="PSA 44:4">Ordina le salvazioni di Giacobbe.<verse eid="PSA 44:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5"/>Per te noi cozzeremo i nostri nemici;</para>
  <para style="q" vid="PSA 44:5">Nel tuo Nome noi calpesteremo coloro che si levano contro a noi.<verse eid="PSA 44:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6"/>Perciocchè io non mi confido nel mio arco,</para>
  <para style="q" vid="PSA 44:6">E la mia spada non mi salverà<note caller="*" style="x"><char style="xo" closed="false">44.6 </char><char style="xk" closed="false">salverà </char><char style="xt" closed="false"><ref loc="1SA 17:47">1 Sam. 17.47</ref>. <ref loc="PSA 33:16">Sal. 33.16</ref>.</char></note>.<verse eid="PSA 44:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7"/>Anzi tu ci salverai da' nostri nemici,</para>
  <para style="q" vid="PSA 44:7">E renderai confusi quelli che ci odiano.<verse eid="PSA 44:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8"/>Noi ci glorieremo tuttodì in Dio<note caller="*" style="x"><char style="xo" closed="false">44.8 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="JER 9:24">Ger. 9.24</ref>. <ref loc="ROM 2:17">Rom. 2.17</ref>.</char></note>,</para>
  <para style="q" vid="PSA 44:8">E celebreremo il tuo Nome in perpetuo. <char style="qs">(Sela.)</char><verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9"/>E pure tu ci hai scacciati<note caller="*" style="x"><char style="xo" closed="false">44.9 </char><char style="xk" closed="false">scacciati </char><char style="xt" closed="false"><ref loc="1CH 28:9">1 Cron. 28.9</ref>. <ref loc="PSA 89:38">Sal. 89.38</ref> ecc.</char></note>, e ci hai svergognati;</para>
  <para style="q" vid="PSA 44:9">E non esci <char style="add">più</char> co' nostri eserciti.<verse eid="PSA 44:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10"/>Tu ci hai fatto voltar le spalle dinanzi al nemico<note caller="*" style="x"><char style="xo" closed="false">44.10 </char><char style="xk" closed="false">nemico </char><char style="xt" closed="false"><ref loc="LEV 26:17">Lev. 26.17</ref>. <ref loc="JOS 7:8">Gios. 7.8</ref>,<ref loc="JOS 7:12">12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 44:10">E quelli che ci odiano <char style="add">ci</char> hanno predati.<verse eid="PSA 44:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11"/>Tu ci hai ridotti ad esser come pecore da mangiare<note caller="*" style="x"><char style="xo" closed="false">44.11 </char><char style="xk" closed="false">mangiare </char><char style="xt" closed="false"><ref loc="ROM 8:36">Rom. 8.36</ref>.</char></note>;</para>
  <para style="q" vid="PSA 44:11">E ci hai dispersi fra le genti<note caller="*" style="x"><char style="xo" closed="false">44.11 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="DEU 4:27">Deut. 4.27</ref>; <ref loc="DEU 28:64">28.64</ref>.</char></note>.<verse eid="PSA 44:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12"/>Tu hai venduto il tuo popolo senza danari<note caller="*" style="x"><char style="xo" closed="false">44.12 </char><char style="xk" closed="false">danari </char><char style="xt" closed="false"><ref loc="DEU 32:30">Deut. 32.30</ref>. <ref loc="JER 15:13">Ger. 15.13</ref>.</char></note>,</para>
  <para style="q" vid="PSA 44:12">E non hai fatto alcuno avanzo de' lor prezzi.<verse eid="PSA 44:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13"/>Tu ci hai posti <char style="add">in</char> vituperio appresso i nostri vicini,</para>
  <para style="q" vid="PSA 44:13">
    <char style="add">In</char> beffa, e <char style="add">in</char> ischerno a <char style="add">quelli che stanno</char> d'intorno a noi<note caller="*" style="x"><char style="xo" closed="false">44.13 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="DEU 28:37">Deut. 28.37</ref>. <ref loc="JER 24:9">Ger. 24.9</ref>.</char></note>.<verse eid="PSA 44:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14"/>Tu ci hai messi ad essere proverbiati fra le genti,</para>
  <para style="q" vid="PSA 44:14">Ed hai fatto che ci è scosso il capo contro fra i popoli.<verse eid="PSA 44:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15"/>Il mio vituperio <char style="add">è</char> tuttodì davanti a me,</para>
  <para style="q" vid="PSA 44:15">E la vergogna della mia faccia mi ha coperto,<verse eid="PSA 44:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16"/>Per la voce del vituperatore e dell'oltraggiatore;</para>
  <para style="q" vid="PSA 44:16">Per cagione del nemico e del vendicatore.<verse eid="PSA 44:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17"/>Tutto questo ci è avvenuto, e non però ti abbiamo dimenticato,</para>
  <para style="q" vid="PSA 44:17">E non ci siam portati dislealmente contro al tuo patto.<verse eid="PSA 44:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18"/>Il cuor nostro non si è rivolto indietro,</para>
  <para style="q" vid="PSA 44:18">E i nostri passi <char style="add">non</char> si sono sviati da' tuoi sentieri;<verse eid="PSA 44:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19"/>Quantunque tu ci abbi tritati, <char style="add">e messi</char> in luogo di sciacalli;</para>
  <para style="q" vid="PSA 44:19">E ci abbi coperti d'ombra di morte.<verse eid="PSA 44:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20"/>Se noi avessimo dimenticato il Nome dell'Iddio nostro,</para>
  <para style="q" vid="PSA 44:20">Ed avessimo stese le mani ad alcun dio strano,<verse eid="PSA 44:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21"/>Iddio non ne farebbe egli inchiesta?</para>
  <para style="q" vid="PSA 44:21">Conciossiachè egli conosca i segreti del cuore<note caller="*" style="x"><char style="xo" closed="false">44.21 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PSA 139:1">Sal. 139.1</ref>. <ref loc="JER 17:10">Ger. 17.10</ref>.</char></note>.<verse eid="PSA 44:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22"/>Anzi, per cagion tua siamo uccisi tuttodì,</para>
  <para style="q" vid="PSA 44:22">Siam reputati come pecore da macello<note caller="*" style="x"><char style="xo" closed="false">44.22 </char><char style="xk" closed="false">macello </char><char style="xt" closed="false"><ref loc="ROM 8:36">Rom. 8.36</ref>.</char></note>.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23"/>Risvegliati; perchè dormi, Signore?</para>
  <para style="q" vid="PSA 44:23">Destati, non iscacciar<char style="add">ci</char> in perpetuo<note caller="*" style="x"><char style="xo" closed="false">44.23 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"/><char style="xta" closed="false">Ver. </char><char style="xt" closed="false">44.9 </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 44:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24"/>Perchè nascondi la tua faccia?</para>
  <para style="q" vid="PSA 44:24">
    <char style="add">Perchè</char> dimentichi la nostra afflizione e la nostra oppressione?<verse eid="PSA 44:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25"/>Conciossiachè la nostra anima sia abbassata fin nella polvere,</para>
  <para style="q" vid="PSA 44:25">
    <char style="add">E</char> il nostro ventre sia attaccato alla terra.<verse eid="PSA 44:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26"/>Levati <char style="add">in</char> nostro aiuto,</para>
  <para style="q" vid="PSA 44:26">E riscuotici, per amor della tua benignità.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">SALMO XLV</para>
  <para style="s1">Descrizione profetica della unione spirituale di Cristo e della Chiesa</para>
  <para style="d">Maschil, cantico d'amori, <char style="add">dato</char> al Capo de' Musici, de' figliuoli di Core, sopra Sosannim</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1"/>IL mio cuore sgorga un buon ragionamento;</para>
  <para style="q" vid="PSA 45:1">Io recito al Re le mie opere;</para>
  <para style="q" vid="PSA 45:1">La mia lingua <char style="add">sarà come</char> la penna di un veloce scrittore.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2"/>Tu sei più bello che <char style="add">alcuno de</char>' figliuoli degli uomini;</para>
  <para style="q" vid="PSA 45:2">Grazia è sparsa sulle tue labbra<note caller="*" style="x"><char style="xo" closed="false">45.2 </char><char style="xk" closed="false">labbra </char><char style="xt" closed="false"><ref loc="LUK 4:22">Luc. 4.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 45:2">Perciò Iddio ti ha benedetto in eterno.<verse eid="PSA 45:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3"/>O prode<note caller="*" style="x"><char style="xo" closed="false">45.3 </char><char style="xk" closed="false">prode </char><char style="xt" closed="false"><ref loc="ISA 9:5">Is. 9.5</ref>,<ref loc="ISA 9:6">6</ref>.</char></note>, cingiti la tua spada<note caller="*" style="x"><char style="xo" closed="false">45.3 </char><char style="xk" closed="false">spada </char><char style="xt" closed="false"><ref loc="HEB 4:12">Ebr. 4.12</ref>. <ref loc="REV 19:15">Apoc. 19.15</ref>.</char></note> al fianco,</para>
  <para style="q" vid="PSA 45:3">
    <char style="add">Che è</char> la tua gloria, e la tua magnificenza;<verse eid="PSA 45:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4"/>E prospera <char style="add">nel</char>la tua gloria,</para>
  <para style="q" vid="PSA 45:4">Cavalca in su la parola di verità, e di mansuetudine, <char style="add">e</char> di giustizia;</para>
  <para style="q" vid="PSA 45:4">E la tua destra ti farà vedere <char style="add">opere</char> tremende.<verse eid="PSA 45:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5"/>Le tue saette <char style="add">sono</char> acute;</para>
  <para style="q" vid="PSA 45:5">I popoli caderanno sotto a te;</para>
  <para style="q" vid="PSA 45:5">
    <char style="add">Esse entreranno</char> nel cuor de' nemici del Re.<verse eid="PSA 45:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6"/>O Dio, il tuo trono <char style="add">è</char> in sempiterno;</para>
  <para style="q" vid="PSA 45:6">Lo scettro del tuo regno <char style="add">è</char> uno scettro di dirittura<note caller="*" style="x"><char style="xo" closed="false">45.6 </char><char style="xk" closed="false">dirittura </char><char style="xt" closed="false"><ref loc="PSA 110:2">Sal. 110.2</ref>. <ref loc="HEB 1:8">Ebr. 1.8</ref>,<ref loc="HEB 1:9">9</ref>.</char></note>.<verse eid="PSA 45:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7"/>Tu hai amata la giustizia, ed hai odiata l'empietà<note caller="*" style="x"><char style="xo" closed="false">45.7 </char><char style="xk" closed="false">empietà </char><char style="xt" closed="false"><ref loc="PSA 11:7">Sal. 11.7</ref>; <ref loc="PSA 33:5">33.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 45:7">Perciò Iddio, l'Iddio tuo, ti ha unto<note caller="*" style="x"><char style="xo" closed="false">45.7 </char><char style="xk" closed="false">unto </char><char style="xt" closed="false"><ref loc="ISA 61:1">Is. 61.1</ref>.</char></note>.</para>
  <para style="q" vid="PSA 45:7">D'olio di letizia sopra i tuoi consorti.<verse eid="PSA 45:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8"/>Tutti i tuoi vestimenti <char style="add">son</char> mirra, aloe, <char style="add">e</char> cassia<note caller="*" style="x"><char style="xo" closed="false">45.8 </char><char style="xk" closed="false">cassia </char><char style="xt" closed="false"><ref loc="SNG 1:3">Cant. 1.3</ref>. <ref loc="JHN 19:39">Giov. 19.39</ref>.</char></note>,</para>
  <para style="q" vid="PSA 45:8">
    <char style="add">Che spandono il loro odore</char> da' palazzi d'avorio,</para>
  <para style="q" vid="PSA 45:8">
    <char style="add">Dal luogo ove</char> ti è dato diletto.<verse eid="PSA 45:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9"/>Figliuole di re <char style="add">sono</char> fra i tuoi onori;</para>
  <para style="q" vid="PSA 45:9">La Sposa <char style="add">è</char> alla tua man destra<note caller="*" style="x"><char style="xo" closed="false">45.9 </char><char style="xk" closed="false">destra </char><char style="xt" closed="false"><ref loc="1KI 2:19">1 Re. 2.19</ref>. <ref loc="MAT 25:33">Mat. 25.33</ref>,<ref loc="MAT 25:34">34</ref>.</char></note>, <char style="add">adorna</char> d'oro di Ofir.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10"/>Ascolta, fanciulla, e riguarda, e porgi l'orecchio;</para>
  <para style="q" vid="PSA 45:10">E dimentica il tuo popolo, e la casa di tuo padre;<verse eid="PSA 45:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11"/>E il Re porrà amore alla tua bellezza;</para>
  <para style="q" vid="PSA 45:11">Adoralo adunque, perciocchè egli <char style="add">è</char> il tuo Signore<note caller="*" style="x"><char style="xo" closed="false">45.11 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 95:6">Sal. 95.6</ref>. <ref loc="ISA 54:5">Is. 54.5</ref>.</char></note>.<verse eid="PSA 45:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12"/>E la figliuola di Tiro,</para>
  <para style="q" vid="PSA 45:12">
    <char style="add">E</char> i ricchi fra i popoli ti supplicheranno con presenti<note caller="*" style="x"><char style="xo" closed="false">45.12 </char><char style="xk" closed="false">presenti </char><char style="xt" closed="false"><ref loc="ISA 60:3">Is. 60.3</ref> ecc. <ref loc="MAT 2:11">Mat. 2.11</ref>.</char></note>.<verse eid="PSA 45:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13"/>La figliuola del Re <char style="add">è</char> tutta gloriosa dentro<note caller="*" style="x"><char style="xo" closed="false">45.13 </char><char style="xk" closed="false">dentro </char><char style="xt" closed="false"><ref loc="REV 19:7">Apoc. 19.7</ref>,<ref loc="REV 19:8">8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 45:13">La sua vesta <char style="add">è</char> tutta trapunta d'oro.<verse eid="PSA 45:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14"/>Ella sarà condotta al Re in <char style="add">vesti</char> ricamate<note caller="*" style="x"><char style="xo" closed="false">45.14 </char><char style="xk" closed="false">ricamate </char><char style="xt" closed="false"><ref loc="2SA 13:18">2 Sam. 13.18</ref>.</char></note>,</para>
  <para style="q" vid="PSA 45:14">Avendo dietro a sè le vergini sue compagne,</para>
  <para style="q" vid="PSA 45:14">Che ti saranno <char style="add">eziandio</char> addotte, <char style="add">o Re</char>.<verse eid="PSA 45:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15"/>Ti saranno condotte con letizia, e con gioia;</para>
  <para style="q" vid="PSA 45:15">
    <char style="add">Ed</char> entreranno nel palazzo del Re.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16"/>I tuoi figliuoli saranno in luogo de' tuoi padri;</para>
  <para style="q" vid="PSA 45:16">Tu li costituirai principi per tutta la terra<note caller="*" style="x"><char style="xo" closed="false">45.16 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="1PE 2:9">1 Piet. 2.9</ref>. <ref loc="REV 1:6">Apoc. 1.6</ref>; <ref loc="REV 5:10">5.10</ref>.</char></note>.<verse eid="PSA 45:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17"/>Io pubblicherò la memoria del tuo Nome, per ogni età<note caller="*" style="x"><char style="xo" closed="false">45.17 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="MAT 1:11">Mat. 1.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 45:17">Perciò, ti celebreranno i popoli in sempiterno.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">SALMO XLVI</para>
  <para style="s1">Completa fiducia di quelli che credono in Dio</para>
  <para style="d">Cantico, <char style="add">dato</char> al Capo de' Musici, de' figliuoli di Core, sopra Alamot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1"/>IDDIO <char style="add">è</char> nostro ricetto, e forza<note caller="*" style="x"><char style="xo" closed="false">46.1 </char><char style="xk" closed="false">forza </char><char style="xt" closed="false"><ref loc="PSA 62:7">Sal. 62.7</ref>,<ref loc="PSA 62:8">8</ref>; <ref loc="PSA 91:2">91.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 46:1">
    <char style="add">Ed</char> aiuto prontissimo nelle distrette<note caller="*" style="x"><char style="xo" closed="false">46.1 </char><char style="xk" closed="false">distrette </char><char style="xt" closed="false"><ref loc="DEU 4:7">Deut. 4.7</ref>. <ref loc="PSA 145:18">Sal. 145.18</ref>.</char></note>.<verse eid="PSA 46:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2"/>Perciò noi non temeremo, quantunque la terra si tramutasse di luogo,</para>
  <para style="q" vid="PSA 46:2">E i monti smossi <char style="add">fosser sospinti</char> in mezzo del mare;<verse eid="PSA 46:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3"/>
    <char style="add">E</char> le acque di esso romoreggiassero, <char style="add">e</char> s'intorbidassero<note caller="*" style="x"><char style="xo" closed="false">46.3 </char><char style="xk" closed="false">intorbidassero </char><char style="xt" closed="false"><ref loc="PSA 93:3">Sal. 93.3</ref>,<ref loc="PSA 93:4">4</ref>. <ref loc="MAT 7:25">Mat. 7.25</ref>.</char></note>;</para>
  <para style="q" vid="PSA 46:3">
    <char style="add">E</char> i monti fossero scrollati dall'alterezza di esso. <char style="qs">(Sela.)</char><verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4"/>Il fiume, i ruscelli di Dio rallegreranno la sua Città.</para>
  <para style="q" vid="PSA 46:4">Il <char style="add">luogo</char> santo degli abitacoli dell'Altissimo.<verse eid="PSA 46:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5"/>Iddio <char style="add">è</char> nel mezzo di lei<note caller="*" style="x"><char style="xo" closed="false">46.5 </char><char style="xk" closed="false">lei </char><char style="xt" closed="false"><ref loc="DEU 23:14">Deut. 23.14</ref>. <ref loc="ISA 12:6">Is. 12.6</ref>.</char></note>, ella non sarà smossa;</para>
  <para style="q" vid="PSA 46:5">Iddio la soccorrerà allo schiarir della mattina.<verse eid="PSA 46:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6"/>Le genti romoreggiarono, i regni si commossero<note caller="*" style="x"><char style="xo" closed="false">46.6 </char><char style="xk" closed="false">commossero </char><char style="xt" closed="false"><ref loc="PSA 2:1">Sal. 2.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 46:6">Egli diede fuori la sua voce, la terra si strusse.<verse eid="PSA 46:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7"/>Il Signore degli eserciti <char style="add">è</char> con noi;</para>
  <para style="q" vid="PSA 46:7">L'Iddio di Giacobbe <char style="add">è</char> il nostro alto ricetto. <char style="qs">(Sela.)</char><verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8"/>Venite, mirate i fatti del Signore;</para>
  <para style="q" vid="PSA 46:8">Come egli ha operate cose stupende nella terra.<verse eid="PSA 46:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9"/>Egli ha fatte restar le guerre<note caller="*" style="x"><char style="xo" closed="false">46.9 </char><char style="xk" closed="false">guerre </char><char style="xt" closed="false"><ref loc="ISA 2:4">Is. 2.4</ref>. <ref loc="EZK 39:9">Ezec. 39.9</ref>.</char></note> infino all'estremità della terra;</para>
  <para style="q" vid="PSA 46:9">Egli ha rotti gli archi, e messe in pezzi le lance,</para>
  <para style="q" vid="PSA 46:9">
    <char style="add">Ed</char> arsi i carri col fuoco.<verse eid="PSA 46:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10"/>Restate, e conoscete che io <char style="add">son</char> Dio;</para>
  <para style="q" vid="PSA 46:10">Io sarò esaltato fra le genti,</para>
  <para style="q" vid="PSA 46:10">Io sarò esaltato nella terra.<verse eid="PSA 46:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11"/>Il Signore degli eserciti <char style="add">è</char> con noi;</para>
  <para style="q" vid="PSA 46:11">L'Iddio di Giacobbe <char style="add">è</char> il nostro alto ricetto. <char style="qs">(Sela.)</char><verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">SALMO XLVII</para>
  <para style="s1">Il trionfo del regno di Dio</para>
  <para style="d">Salmo, <char style="add">dato</char> al Capo de' Musici, de' figliuoli di Core</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1"/>BATTETEVI a palme<note caller="*" style="x"><char style="xo" closed="false">47.1 </char><char style="xk" closed="false">palme </char><char style="xt" closed="false"><ref loc="ISA 55:12">Is. 55.12</ref>.</char></note>, o popoli tutti;</para>
  <para style="q" vid="PSA 47:1">Giubilate a Dio con voce di trionfo.<verse eid="PSA 47:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2"/>Perciocchè il Signore <char style="add">è</char> l'Altissimo, il Tremendo<note caller="*" style="x"><char style="xo" closed="false">47.2 </char><char style="xk" closed="false">Tremendo </char><char style="xt" closed="false"><ref loc="DEU 7:21">Deut. 7.21</ref>. <ref loc="NEH 1:5">Neem. 1.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 47:2">Gran Re sopra tutta la terra.<verse eid="PSA 47:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3"/>Egli ridurrà i popoli sotto noi,</para>
  <para style="q" vid="PSA 47:3">E la nazioni sotto i nostri piedi.<verse eid="PSA 47:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4"/>Egli ci ha scelta la nostra eredità<note caller="*" style="x"><char style="xo" closed="false">47.4 </char><char style="xk" closed="false">eredità </char><char style="xt" closed="false"><ref loc="1PE 1:4">1 Piet. 1.4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 47:4">La gloria di Giacobbe, il quale egli ama. <char style="qs">(Sela.)</char><verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5"/>Iddio è salito con giubilo,</para>
  <para style="q" vid="PSA 47:5">Il Signore <char style="add">è salito</char> con suono di trombe.<verse eid="PSA 47:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6"/>Salmeggiate a Dio, salmeggiate;</para>
  <para style="q" vid="PSA 47:6">Salmeggiate al Re nostro, salmeggiate.<verse eid="PSA 47:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7"/>Perciocchè Iddio <char style="add">è</char> Re di tutta la terra<note caller="*" style="x"><char style="xo" closed="false">47.7 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="ZEC 14:9">Zac. 14.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 47:7">Salmeggiate maestrevolmente<note caller="*" style="x"><char style="xo" closed="false">47.7 </char><char style="xk" closed="false">maestrevolmente </char><char style="xt" closed="false"><ref loc="1CO 14:15">1 Cor. 14.15</ref>,<ref loc="1CO 14:16">16</ref>.</char></note><verse eid="PSA 47:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8"/>Iddio regna sopra le genti<note caller="*" style="x"><char style="xo" closed="false">47.8 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="1CH 16:31">1 Cron. 16.31</ref>. <ref loc="PSA 22:28">Sal. 22.28</ref>; <ref loc="PSA 96:10">96.10</ref>; <ref loc="PSA 97:1">97.1</ref>. <ref loc="REV 19:6">Apoc. 19.6</ref>.</char></note>:</para>
  <para style="q" vid="PSA 47:8">Iddio siede sopra il trono della sua santità.<verse eid="PSA 47:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9"/>I principi de' popoli si son raunati insieme;</para>
  <para style="q" vid="PSA 47:9">Il popolo dell'Iddio d'Abrahamo<note caller="*" style="x"><char style="xo" closed="false">47.9 </char><char style="xk" closed="false">Abrahamo </char><char style="xt" closed="false"><ref loc="ROM 4:11">Rom. 4.11</ref>,<ref loc="ROM 4:12">12</ref>.</char></note>,</para>
  <para style="q" vid="PSA 47:9">Perciocchè a Dio <char style="add">appartengono</char> gli scudi della terra;</para>
  <para style="q" vid="PSA 47:9">Egli è grandemente esaltato.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">SALMO XLVIII</para>
  <para style="s1">Bellezza e privilegi di Gerusalemme</para>
  <para style="d">Cantico di Salmo, de' figliuoli di Core</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1"/>IL Signore <char style="add">è</char> grande, e molto glorioso</para>
  <para style="q" vid="PSA 48:1">Nella Città dell'Iddio nostro, <char style="add">nel</char> monte della sua santità<note caller="*" style="x"><char style="xo" closed="false">48.1 </char><char style="xk" closed="false">santità </char><char style="xt" closed="false"><ref loc="ISA 2:2">Is. 2.2</ref>,<ref loc="ISA 2:3">3</ref>. <ref loc="MIC 4:1">Mic. 4.1</ref> ecc.</char></note>.<verse eid="PSA 48:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2"/>Il monte di Sion, il fondo verso il Settentrione,</para>
  <para style="q" vid="PSA 48:2">La Città del gran Re<note caller="*" style="x"><char style="xo" closed="false">48.2 </char><char style="xk" closed="false">Re </char><char style="xt" closed="false"><ref loc="MAT 5:35">Mat. 5.35</ref>.</char></note></para>
  <para style="q" vid="PSA 48:2">
    <char style="add">È in</char> bella contrada, <char style="add">è</char> la gioia di tutta la terra<note caller="*" style="x"><char style="xo" closed="false">48.2 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="LAM 2:15">Lam. 2.15</ref>. <ref loc="EZK 20:6">Ezec. 20.6</ref>.</char></note>.<verse eid="PSA 48:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3"/>Iddio <char style="add">è</char> riconosciuto ne' palazzi di essa, per alta fortezza.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4"/>Perciocchè ecco, i re si erano adunati,</para>
  <para style="q" vid="PSA 48:4">Ed erano tutti insieme passati oltre<note caller="*" style="x"><char style="xo" closed="false">48.4 </char><char style="xk" closed="false">oltre </char><char style="xt" closed="false"><ref loc="2SA 10:6-19">2 Sam. 10.6-19</ref>.</char></note>.<verse eid="PSA 48:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5"/>Come prima <char style="add">la</char> videro, furono attoniti,</para>
  <para style="q" vid="PSA 48:5">Si smarrirono, si affrettarono <char style="add">a fuggire</char>.<verse eid="PSA 48:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6"/>Tremore li colse quivi;</para>
  <para style="q" vid="PSA 48:6">Doglia, come di donna che partorisce.<verse eid="PSA 48:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7"/>
    <char style="add">Furono rotti come</char> per lo vento orientale</para>
  <para style="q" vid="PSA 48:7">
    <char style="add">Che</char> rompe le navi di Tarsis.<verse eid="PSA 48:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8"/>Come avevamo udito, così abbiam veduto,</para>
  <para style="q" vid="PSA 48:8">Nella Città del Signor degli eserciti,</para>
  <para style="q" vid="PSA 48:8">Nella Città dell'Iddio nostro;</para>
  <para style="q" vid="PSA 48:8">Iddio la stabilirà in perpetuo<note caller="*" style="x"><char style="xo" closed="false">48.8 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false">Ver. 1 </char><char style="xta" closed="false">e rif.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9"/>O Dio, noi abbiamo, chetamente aspettata la tua benignità</para>
  <para style="q" vid="PSA 48:9">Dentro al tuo Tempio.<verse eid="PSA 48:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10"/>O Dio, quale <char style="add">è</char> il tuo Nome,</para>
  <para style="q" vid="PSA 48:10">Tale <char style="add">è</char> la tua lode, infino all'estremità della terra<note caller="*" style="x"><char style="xo" closed="false">48.10 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 113:3">Sal. 113.3</ref>. <ref loc="MAL 1:11">Mal. 1.11</ref>,<ref loc="MAL 1:14">14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 48:10">La tua destra è piena di giustizia.<verse eid="PSA 48:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11"/>Il monte di Sion si rallegrerà,</para>
  <para style="q" vid="PSA 48:11">Le figliuole di Giuda festeggeranno, per li tuoi giudicii<note caller="*" style="x"><char style="xo" closed="false">48.11 </char><char style="xk" closed="false">giudicii </char><char style="xt" closed="false"><ref loc="PSA 97:8">Sal. 97.8</ref>.</char></note>.<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12"/>Circuite Sion, e andate attorno a lei,</para>
  <para style="q" vid="PSA 48:12">Contate le sue torri.<verse eid="PSA 48:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13"/>Ponete mente alle bastie,</para>
  <para style="q" vid="PSA 48:13">Mirate l'altezza de' suoi palazzi;</para>
  <para style="q" vid="PSA 48:13">Acciocchè <char style="add">lo</char> raccontiate all'età a venire.<verse eid="PSA 48:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14"/>Perciocchè questo Dio <char style="add">è</char> il nostro Dio in sempiterno;</para>
  <para style="q" vid="PSA 48:14">Egli ci giuderà infino alla morte<note caller="*" style="x"><char style="xo" closed="false">48.14 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="ISA 58:11">Is. 58.11</ref>.</char></note>.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">SALMO XLIX</para>
  <para style="s1">Vanità dei beni terreni; Dio solo salva dalla morte</para>
  <para style="d">Salmo, <char style="add">dato</char> al Capo de' Musici, de' figliuoli di Core</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1"/>UDITE questo, popoli tutti;</para>
  <para style="q" vid="PSA 49:1">Porgete gli orecchi, <char style="add">voi</char> tutti gli abitanti del mondo;<verse eid="PSA 49:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2"/>E plebei, e nobili,</para>
  <para style="q" vid="PSA 49:2">E ricchi, e bisognosi tutti insieme.<verse eid="PSA 49:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3"/>La mia bocca proferirà <char style="add">cose di</char> gran sapienza;</para>
  <para style="q" vid="PSA 49:3">E il ragionamento del mio cuore <char style="add">sarà</char> di cose di grande intendimento.<verse eid="PSA 49:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4"/>Io inchinerò il mio orecchio alle sentenze;</para>
  <para style="q" vid="PSA 49:4">Io spiegherò sopra la cetera i miei detti notevoli.<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5"/>Perchè temerò ne' gioni dell'avversità</para>
  <para style="q" vid="PSA 49:5">
    <char style="add">Quando</char> l'iniquità che mi è alle calcagna m'intornierà?<verse eid="PSA 49:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6"/>
    <char style="add">Ve ne son molti</char> che si confidano ne' lor beni,</para>
  <para style="q" vid="PSA 49:6">E si gloriano della grandezza delle lor ricchezze<note caller="*" style="x"><char style="xo" closed="false">49.6 </char><char style="xk" closed="false">ricchezze </char><char style="xt" closed="false"><ref loc="MRK 10:24">Mar. 10.24</ref>. <ref loc="1TI 6:17">1 Tim. 6.17</ref>.</char></note>.<verse eid="PSA 49:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7"/>Niuno però può riscuotere il suo fratello,</para>
  <para style="q" vid="PSA 49:7">Nè dare a Dio il prezzo del suo riscatto<note caller="*" style="x"><char style="xo" closed="false">49.7 </char><char style="xk" closed="false">riscatto </char><char style="xt" closed="false"><ref loc="MAT 16:26">Mat. 16.26</ref>; <ref loc="MAT 25:9">25.9</ref>.</char></note>.<verse eid="PSA 49:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8"/>E il riscatto della lor <char style="add">propria</char> anima non può trovarsi<note caller="*" style="x"><char style="xo" closed="false">49.8 </char><char style="xk" closed="false">trovarsi </char><char style="xt" closed="false"><ref loc="JOB 33:24">Giob. 33.24</ref>.</char></note>,</para>
  <para style="q" vid="PSA 49:8">E il <char style="add">modo ne</char> mancherà in perpetuo;<verse eid="PSA 49:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9"/>Per fare che continuino a vivere in perpetuo,</para>
  <para style="q" vid="PSA 49:9">
    <char style="add">E</char> che non veggano la fossa<note caller="*" style="x"><char style="xo" closed="false">49.9 </char><char style="xk" closed="false">fossa </char><char style="xt" closed="false"><ref loc="PSA 89:48">Sal. 89.48</ref>.</char></note>;<verse eid="PSA 49:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10"/>Conciossiachè veggano <char style="add">che</char> i savi muoiono,</para>
  <para style="q" vid="PSA 49:10">
    <char style="add">E che</char> parimente i pazzi, e gli stolti periscono,</para>
  <para style="q" vid="PSA 49:10">E lasciano i lor beni ad altri<note caller="*" style="x"><char style="xo" closed="false">49.10 </char><char style="xk" closed="false">altri </char><char style="xt" closed="false"><ref loc="PSA 39:6">Sal. 39.6</ref>. <ref loc="ECC 2:18">Eccl. 2.18</ref>,<ref loc="ECC 2:21">21</ref>.</char></note>.<verse eid="PSA 49:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11"/>Il loro intimo <char style="add">pensiero è che</char> le lor case <char style="add">dimoreranno</char> in eterno,</para>
  <para style="q" vid="PSA 49:11">
    <char style="add">E che</char> le loro abitazioni <char style="add">dureranno</char> per ogni età;</para>
  <para style="q" vid="PSA 49:11">Impongono i nomi loro a delle terre<note caller="*" style="x"><char style="xo" closed="false">49.11 </char><char style="xk" closed="false">terre </char><char style="xt" closed="false"><ref loc="GEN 4:17">Gen. 4.17</ref>.</char></note>.<verse eid="PSA 49:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12"/>E pur l'uomo <char style="add">che è</char> in onore non <char style="add">vi</char> dimora <char style="add">sempre</char><note caller="*" style="x"><char style="xo" closed="false">49.12 </char><char style="xk" closed="false"><char style="add">sempre</char> </char><char style="xt" closed="false"><ref loc="PSA 39:5">Sal. 39.5</ref>; <ref loc="PSA 82:7">82.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 49:12">
    <char style="add">Anzi</char> è renduto simile alle bestie <char style="add">che</char> periscono.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13"/>Questa lor via <char style="add">è</char> loro una pazzia<note caller="*" style="x"><char style="xo" closed="false">49.13 </char><char style="xk" closed="false">pazzia </char><char style="xt" closed="false"><ref loc="LUK 12:20">Luc. 12.20</ref>.</char></note>;</para>
  <para style="q" vid="PSA 49:13">E pure i lor discendenti si compiacciono a seguire i lor precetti. <char style="qs">(Sela.)</char><verse eid="PSA 49:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14"/>Saranno posti sotterra, come pecore;</para>
  <para style="q" vid="PSA 49:14">La morte li pasturerà;</para>
  <para style="q" vid="PSA 49:14">E gli <char style="add">uomini</char> diritti signoreggeranno sopra loro in quella mattina<note caller="*" style="x"><char style="xo" closed="false">49.14 </char><char style="xk" closed="false">mattina </char><char style="xt" closed="false"><ref loc="DAN 7:22">Dan. 7.22</ref>. <ref loc="LUK 22:30">Luc. 22.30</ref>. <ref loc="1CO 6:2">1 Cor. 6.2</ref>. <ref loc="REV 20:4">Apoc. 20.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 49:14">E il sepolcro consumerà la lor bella apparenza,</para>
  <para style="q" vid="PSA 49:14">
    <char style="add">Che sarà portata via</char> dal suo abitacolo.<verse eid="PSA 49:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15"/>Ma Iddio riscuoterà l'anima mia dal sepolcro<note caller="*" style="x"><char style="xo" closed="false">49.15 </char><char style="xk" closed="false">sepolcro </char><char style="xt" closed="false"><ref loc="HOS 13:14">Os. 13.14</ref>.</char></note>;<verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16"/>Non temere, quando alcuno sarà arricchito,</para>
  <para style="q" vid="PSA 49:16">Quando la gloria della sua casa sarà accresciuta.<verse eid="PSA 49:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17"/>Perciocchè, quando egli morrà non torrà <char style="add">seco</char> nulla;</para>
  <para style="q" vid="PSA 49:17">La sua gloria non gli scenderà dietro.<verse eid="PSA 49:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18"/>Benchè egli abbia benedetta l'anima sua in vita sua<note caller="*" style="x"><char style="xo" closed="false">49.18 </char><char style="xk" closed="false">sua </char><char style="xt" closed="false"><ref loc="LUK 12:19">Luc. 12.19</ref>.</char></note>;</para>
  <para style="q" vid="PSA 49:18">E <char style="add">tali</char> ti lodino, se tu ti dài piacere, e buon tempo;<verse eid="PSA 49:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19"/>Quella verrà <char style="add">là ove è</char> la generazion de' suoi padri;</para>
  <para style="q" vid="PSA 49:19">Giammai in eterno non vedranno la luce.<verse eid="PSA 49:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20"/>L'uomo <char style="add">che è</char> in istato onorevole, e non ha intelletto,</para>
  <para style="q" vid="PSA 49:20">È simile alle bestie <char style="add">che</char> periscono.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">SALMO L</para>
  <para style="s1">Iddio giudicherà il mondo. Egli vuole ubbidienza e non sacrificio</para>
  <para style="d">Salmo di Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1"/>IL Signore, l'Iddio degl'iddii, ha parlato, ed ha gridato alla terra,</para>
  <para style="q" vid="PSA 50:1">Dal sol Levante, infino al Ponente.<verse eid="PSA 50:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2"/>Iddio è apparito in gloria,</para>
  <para style="q" vid="PSA 50:2">Da Sion, <char style="add">luogo di</char> compiuta bellezza.<verse eid="PSA 50:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3"/>L'Iddio nostro verrà, e non se ne starà cheto;</para>
  <para style="q" vid="PSA 50:3">Egli avrà davanti a sè un fuoco divorante<note caller="*" style="x"><char style="xo" closed="false">50.3 </char><char style="xk" closed="false">divorante </char><char style="xt" closed="false"><ref loc="PSA 97:3">Sal. 97.3</ref>. <ref loc="DAN 7:10">Dan. 7.10</ref>.</char></note>,</para>
  <para style="q" vid="PSA 50:3">E d'intorno a sè una forte tempesta.<verse eid="PSA 50:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4"/>Egli griderà da alto al cielo,</para>
  <para style="q" vid="PSA 50:4">Ed alla terra, per giudicare il suo popolo<note caller="*" style="x"><char style="xo" closed="false">50.4 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="ISA 1:2">Is. 1.2</ref>. <ref loc="MIC 6:1">Mic. 6.1</ref>,<ref loc="MIC 6:2">2</ref>.</char></note>;<verse eid="PSA 50:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5"/>
    <char style="add">E dirà:</char> Adunatemi i miei santi,</para>
  <para style="q" vid="PSA 50:5">I quali han fatto meco patto<note caller="*" style="x"><char style="xo" closed="false">50.5 </char><char style="xk" closed="false">patto </char><char style="xt" closed="false"><ref loc="EXO 24:7">Esod. 24.7</ref>.</char></note> con sacrificio.<verse eid="PSA 50:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6"/>E i cieli racconteranno la sua giustizia;</para>
  <para style="q" vid="PSA 50:6">Perciocchè egli <char style="add">è</char> Iddio Giudice. <char style="qs">(Sela.)</char><verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7"/>Ascolta, popol mio, ed io parlerò;</para>
  <para style="q" vid="PSA 50:7">
    <char style="add">Ascolta</char>, Israele, ed io ti farò le mie protestazioni.</para>
  <para style="q" vid="PSA 50:7">Io <char style="add">sono</char> Iddio, l'Iddio tuo<note caller="*" style="x"><char style="xo" closed="false">50.7 </char><char style="xk" closed="false">tuo </char><char style="xt" closed="false"><ref loc="EXO 20:2">Esod. 20.2</ref>.</char></note>.<verse eid="PSA 50:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8"/>Io non ti riprenderò per li tuoi sacrificii<note caller="*" style="x"><char style="xo" closed="false">50.8 </char><char style="xk" closed="false">sacrificii </char><char style="xt" closed="false"><ref loc="1SA 15:22">1 Sam. 15.22</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 50:8">Nè per li tuoi olocausti che mi <char style="add">sono</char> continuamente presentati.<verse eid="PSA 50:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9"/>Io non prenderò giovenchi dalla tua casa,</para>
  <para style="q" vid="PSA 50:9">
    <char style="add">Nè</char> becchi dalle tue mandre.<verse eid="PSA 50:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10"/>Perciocchè mie <char style="add">sono</char> tutte le bestie delle selve;</para>
  <para style="q" vid="PSA 50:10">
    <char style="add">Mio è</char> tutto il bestiame <char style="add">che è</char> in mille monti.<verse eid="PSA 50:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11"/>Io conosco tutti gli uccelli de' monti;</para>
  <para style="q" vid="PSA 50:11">E le fiere della campagna <char style="add">sono</char> a mio comando.<verse eid="PSA 50:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12"/>Se io avessi fame, io non te lo direi;</para>
  <para style="q" vid="PSA 50:12">Perciocchè il mondo, e tutto quello ch'è in esso, <char style="add">è</char> mio<note caller="*" style="x"><char style="xo" closed="false">50.12 </char><char style="xk" closed="false">mio </char><char style="xt" closed="false"><ref loc="DEU 10:14">Deut. 10.14</ref>. <ref loc="PSA 24:1">Sal. 24.1</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 50:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13"/>Mangio io carne di tori,</para>
  <para style="q" vid="PSA 50:13">O bevo io sangue di becchi?<verse eid="PSA 50:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14"/>Sacrifica lode a Dio<note caller="*" style="x"><char style="xo" closed="false">50.14 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="HOS 14:2">Os. 14.2</ref>. <ref loc="ROM 12:1">Rom. 12.1</ref>.</char></note>,</para>
  <para style="q" vid="PSA 50:14">E paga all'Altissimo i tuoi voti<note caller="*" style="x"><char style="xo" closed="false">50.14 </char><char style="xk" closed="false">voti </char><char style="xt" closed="false"><ref loc="DEU 23:21">Deut. 23.21</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 50:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15"/>E invocami nel giorno della distretta,</para>
  <para style="q" vid="PSA 50:15">Ed io te <char style="add">ne</char> trarrò fuori<note caller="*" style="x"><char style="xo" closed="false">50.15 </char><char style="xk" closed="false">fuori </char><char style="xt" closed="false"><ref loc="PSA 81:7">Sal. 81.7</ref>; <ref loc="PSA 91:14">91.14</ref>,<ref loc="PSA 91:15">15</ref>; <ref loc="PSA 107:6">107.6</ref>.</char></note>, e tu mi glorificherai.<verse eid="PSA 50:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16"/>Ma all'empio Iddio ha detto:</para>
  <para style="q" vid="PSA 50:16">Che hai tu da far a raccontare i miei statuti,</para>
  <para style="q" vid="PSA 50:16">Ed a recarti il mio patto in bocca?<verse eid="PSA 50:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17"/>Conciossiachè tu odii correzione<note caller="*" style="x"><char style="xo" closed="false">50.17 </char><char style="xk" closed="false">correzione </char><char style="xt" closed="false"><ref loc="ROM 2:21">Rom. 2.21</ref>,<ref loc="ROM 2:22">22</ref>.</char></note>,</para>
  <para style="q" vid="PSA 50:17">E getti dietro a te le mie parole.<verse eid="PSA 50:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18"/>Se tu vedi un ladro, tu prendi piacere d'essere in sua compagnia;</para>
  <para style="q" vid="PSA 50:18">E la tua parte <char style="add">è</char> con gli adulteri<note caller="*" style="x"><char style="xo" closed="false">50.18 </char><char style="xk" closed="false">adulteri </char><char style="xt" closed="false"><ref loc="ROM 1:29">Rom. 1.29</ref>. <ref loc="1TI 5:22">1 Tim. 5.22</ref>.</char></note>.<verse eid="PSA 50:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19"/>Tu metti la tua bocca al male,</para>
  <para style="q" vid="PSA 50:19">E la tua lingua congegna frode.<verse eid="PSA 50:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20"/>Tu siedi, <char style="add">e</char> parli contro al tuo fratello,</para>
  <para style="q" vid="PSA 50:20">
    <char style="add">E</char> metti biasimo sopra il figliuol di tua madre.<verse eid="PSA 50:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21"/>Tu hai fatte queste cose, ed io mi sono taciuto;</para>
  <para style="q" vid="PSA 50:21">
    <char style="add">E</char> tu hai pensato, che del tutto io era simile a te<note caller="*" style="x"><char style="xo" closed="false">50.21 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="ECC 8:11">Eccl. 8.11</ref>,<ref loc="ECC 8:12">12</ref>. <ref loc="ISA 26:10">Is. 26.10</ref>; <ref loc="ISA 57:11">57.11</ref>. <ref loc="ROM 2:4">Rom. 2.4</ref>.</char></note>.</para>
  <para style="q" vid="PSA 50:21">Io ti arguirò, e te <char style="add">le</char> spiegherò in su gli occhi<note caller="*" style="x"><char style="xo" closed="false">50.21 </char><char style="xk" closed="false">occhi </char><char style="xt" closed="false"><ref loc="PSA 90:8">Sal. 90.8</ref>.</char></note>.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22"/>Deh! intendete questo, <char style="add">voi</char> che dimenticate Iddio;</para>
  <para style="q" vid="PSA 50:22">Che talora io non rapisca, e non <char style="add">vi sia</char> alcuno che riscuota.<verse eid="PSA 50:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23"/>Chi sacrifica lode mi glorifica<note caller="*" style="x"><char style="xo" closed="false">50.23 </char><char style="xk" closed="false">glorifica </char><char style="xt" closed="false"><ref loc="ROM 12:1">Rom. 12.1</ref>.</char></note>,</para>
  <para style="q" vid="PSA 50:23">E chi addirizza la <char style="add">sua</char> via,</para>
  <para style="q" vid="PSA 50:23">Io gli mostrerò la salute di Dio<note caller="*" style="x"><char style="xo" closed="false">50.23 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="GAL 6:16">Gal. 6.16</ref>.</char></note>.<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">SALMO LI</para>
  <para style="s1">Davide confessa il suo peccato, supplicando Iddio di perdonarlo e di cambiare il suo cuore</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici; intorno a ciò che il profeta Natan venne a lui, dopo ch'egli fu entrato da Bet-seba<note caller="*" style="x"><char style="xo" closed="false">51.0 </char><char style="xk" closed="false">Bet-seba </char><char style="xt" closed="false"><ref loc="2SA 11:1-4">2 Sam. 11.1-4</ref>; <ref loc="2SA 12:1">12.1</ref> ecc.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1"/>ABBI pietà di me, o Dio, secondo la tua benignità;</para>
  <para style="q" vid="PSA 51:1">Secondo la moltitudine delle tue compassioni, cancella i miei misfatti<note caller="*" style="x"><char style="xo" closed="false">51.1 </char><char style="xk" closed="false">misfatti </char><char style="xt" closed="false"><ref loc="ISA 43:25">Is. 43.25</ref>; <ref loc="ISA 44:22">44.22</ref>. <ref loc="ACT 3:19">Fat. 3.19</ref>. <ref loc="COL 2:14">Col. 2.14</ref>.</char></note>.<verse eid="PSA 51:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2"/>Lavami molto e molto della mia iniquità,</para>
  <para style="q" vid="PSA 51:2">E nettami del mio peccato<note caller="*" style="x"><char style="xo" closed="false">51.2 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="HEB 9:14">Ebr. 9.14</ref>. <ref loc="1JN 1:7">1 Giov. 1.7</ref>,<ref loc="1JN 1:9">9</ref>. <ref loc="REV 1:5">Apoc. 1.5</ref>.</char></note>.<verse eid="PSA 51:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3"/>Perciocchè io conosco i miei misfatti,</para>
  <para style="q" vid="PSA 51:3">E il mio peccato <char style="add">è</char> del continuo davanti a me<note caller="*" style="x"><char style="xo" closed="false">51.3 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="PSA 32:5">Sal. 32.5</ref>; <ref loc="PSA 38:18">38.18</ref>.</char></note>.<verse eid="PSA 51:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4"/>Io ho peccato contro a te solo,</para>
  <para style="q" vid="PSA 51:4">Ed ho fatto quello che ti dispiace<note caller="*" style="x"><char style="xo" closed="false">51.4 </char><char style="xk" closed="false">dispiace </char><char style="xt" closed="false"><ref loc="GEN 20:6">Gen. 20.6</ref>; <ref loc="GEN 39:9">39.9</ref>. <ref loc="2SA 12:13">2 Sam. 12.13</ref>. <ref loc="LUK 15:21">Luc. 15.21</ref>.</char></note>;</para>
  <para style="q" vid="PSA 51:4">
    <char style="add">Io lo confesso</char>, acciocchè tu sii riconosciuto giusto nelle tue parole,</para>
  <para style="q" vid="PSA 51:4">
    <char style="add">E</char> puro ne' tuoi guidicii<note caller="*" style="x"><char style="xo" closed="false">51.4 </char><char style="xk" closed="false">giudicii </char><char style="xt" closed="false"><ref loc="ROM 3:4">Rom. 3.4</ref>.</char></note>.<verse eid="PSA 51:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5"/>Ecco, io sono stato formato in iniquità<note caller="*" style="x"><char style="xo" closed="false">51.5 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="JHN 3:6">Giov. 3.6</ref>. <ref loc="ROM 5:12-19">Rom. 5.12-19</ref>. <ref loc="EPH 2:3">Efes. 2.3</ref>.</char></note>;</para>
  <para style="q" vid="PSA 51:5">E la madre mia mi ha conceputo in peccato<note caller="*" style="x"><char style="xo" closed="false">51.5 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="JOB 14:4">Giob. 14.4</ref>. <ref loc="PSA 58:3">Sal. 58.3</ref>.</char></note>.<verse eid="PSA 51:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6"/>Ecco, ti è piaciuto insegnarmi verità nell'interiore,</para>
  <para style="q" vid="PSA 51:6">E sapienza nel di dentro<note caller="*" style="x"><char style="xo" closed="false">51.6 </char><char style="xk" closed="false">dentro </char><char style="xt" closed="false"><ref loc="JOB 38:36">Giob. 38.36</ref>.</char></note>.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7"/>Purgami con isopo<note caller="*" style="x"><char style="xo" closed="false">51.7 </char><char style="xk" closed="false">isopo </char><char style="xt" closed="false"><ref loc="EXO 12:22">Esod. 12.22</ref>. <ref loc="LEV 14:4">Lev. 14.4</ref>,<ref loc="LEV 14:6">6</ref>,<ref loc="LEV 14:49">49</ref>. <ref loc="NUM 19:18">Num. 19.18</ref>. <ref loc="HEB 9:19">Ebr. 9.19</ref>.</char></note>, e sarò netto;</para>
  <para style="q" vid="PSA 51:7">Lavami, e sarò più bianco che neve<note caller="*" style="x"><char style="xo" closed="false">51.7 </char><char style="xk" closed="false">neve </char><char style="xt" closed="false"><ref loc="ISA 1:18">Is. 1.18</ref>.</char></note>.<verse eid="PSA 51:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8"/>Fammi udire gioia ed allegrezza;</para>
  <para style="q" vid="PSA 51:8">
    <char style="add">Fa' che</char> le ossa che tu hai tritate, festeggino<note caller="*" style="x"><char style="xo" closed="false">51.8 </char><char style="xk" closed="false">festeggino </char><char style="xt" closed="false"><ref loc="MAT 5:4">Mat. 5.4</ref>.</char></note>.<verse eid="PSA 51:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9"/>Nascondi la tua faccia da' miei peccati<note caller="*" style="x"><char style="xo" closed="false">51.9 </char><char style="xk" closed="false">peccati </char><char style="xt" closed="false"><ref loc="JER 16:17">Ger. 16.17</ref>.</char></note>,</para>
  <para style="q" vid="PSA 51:9">E cancella tutte le mie iniquità.<verse eid="PSA 51:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10"/>O Dio, crea in me un cuor puro<note caller="*" style="x"><char style="xo" closed="false">51.10 </char><char style="xk" closed="false">puro </char><char style="xt" closed="false"><ref loc="ACT 15:9">Fat. 15.9</ref>. <ref loc="EPH 2:10">Efes. 2.10</ref>.</char></note>,</para>
  <para style="q" vid="PSA 51:10">E rinnovella dentro di me uno spirito diritto.<verse eid="PSA 51:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11"/>Non rigettarmi dalla tua faccia<note caller="*" style="x"><char style="xo" closed="false">51.11 </char><char style="xk" closed="false">faccia </char><char style="xt" closed="false"><ref loc="GEN 4:14">Gen. 4.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 51:11">E non togliermi lo Spirito tuo santo<note caller="*" style="x"><char style="xo" closed="false">51.11 </char><char style="xk" closed="false">santo </char><char style="xt" closed="false"><ref loc="ROM 8:9">Rom. 8.9</ref>. <ref loc="EPH 4:30">Efes. 4.30</ref>.</char></note>.<verse eid="PSA 51:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12"/>Rendimi l'allegrezza della tua salute;</para>
  <para style="q" vid="PSA 51:12">E <char style="add">fa' che</char> lo Spirito volontario mi sostenga<note caller="*" style="x"><char style="xo" closed="false">51.12 </char><char style="xk" closed="false">sostenga </char><char style="xt" closed="false"><ref loc="2CO 3:17">2 Cor. 3.17</ref>.</char></note>.<verse eid="PSA 51:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13"/>Io insegnerò le tue vie a' trasgressori;</para>
  <para style="q" vid="PSA 51:13">E i peccatori si convertiranno a te.<verse eid="PSA 51:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14"/>Liberami dal sangue<note caller="*" style="x"><char style="xo" closed="false">51.14 </char><char style="xk" closed="false">sangue </char><char style="xt" closed="false"><ref loc="2SA 11:17">2 Sam. 11.17</ref>; <ref loc="2SA 12:9">12.9</ref>.</char></note>, o Dio, Dio della mia salute;</para>
  <para style="q" vid="PSA 51:14">La mia lingua canterà con giubilo la tua giustizia.<verse eid="PSA 51:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15"/>Signore, aprimi le labbra;</para>
  <para style="q" vid="PSA 51:15">E la mia bocca racconterà la tua lode.<verse eid="PSA 51:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16"/>Perciocchè tu non prendi piacere in sacrificio<note caller="*" style="x"><char style="xo" closed="false">51.16 </char><char style="xk" closed="false">sacrificio </char><char style="xt" closed="false"><ref loc="1SA 15:22">1 Sam. 15.22</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 51:16">Altrimenti io l'avrei offerto;</para>
  <para style="q" vid="PSA 51:16">Tu non gradisci olocausto.<verse eid="PSA 51:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17"/>I sacrificii di Dio <char style="add">sono</char> lo spirito rotto;</para>
  <para style="q" vid="PSA 51:17">O Dio, tu non isprezzi il cuor rotto e contrito<note caller="*" style="x"><char style="xo" closed="false">51.17 </char><char style="xk" closed="false">contrito </char><char style="xt" closed="false"><ref loc="PSA 34:18">Sal. 34.18</ref>. <ref loc="ISA 57:15">Is. 57.15</ref>; <ref loc="ISA 66:2">66.2</ref>.</char></note>.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18"/>Fa' del bene a Sion per la tua benevolenza;</para>
  <para style="q" vid="PSA 51:18">Edifica le mura di Gerusalemme<note caller="*" style="x"><char style="xo" closed="false">51.18 </char><char style="xk" closed="false">Gerusalemme </char><char style="xt" closed="false"><ref loc="PSA 69:35">Sal. 69.35</ref>,<ref loc="PSA 69:36">36</ref>; <ref loc="PSA 122:6">122.6</ref>; <ref loc="PSA 147:2">147.2</ref>.</char></note>.<verse eid="PSA 51:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19"/>Allora prenderai piacere in sacrificii di giustizia<note caller="*" style="x"><char style="xo" closed="false">51.19 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 4:5">Sal. 4.5</ref>. <ref loc="MAL 3:3">Mal. 3.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 51:19">In olocausti, e in offerte da ardere interamente;</para>
  <para style="q" vid="PSA 51:19">Allora si offeriranno giovenchi sul tuo Altare.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">SALMO LII</para>
  <para style="s1">Davide predice la rovina dell'empio e si affida in Dio</para>
  <para style="d">Maschil di Davide, <char style="add">dato</char> al Capo de' Musici; intorno a ciò che Doeg Idumeo era venuto a rapportare a Saulle che Davide era entrato in casa di Ahimelec<note caller="*" style="x"><char style="xo" closed="false">52.0 </char><char style="xk" closed="false">Ahimelec </char><char style="xt" closed="false"><ref loc="1SA 21:7">1 Sam. 21.7</ref>; <ref loc="1SA 22:9">22.9</ref> ecc.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1"/>O POSSENTE <char style="add">uomo</char>, perchè ti glorii del male?</para>
  <para style="q" vid="PSA 52:1">La benignità del Signore <char style="add">dura</char> sempre.<verse eid="PSA 52:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2"/>La tua lingua divisa malizie;</para>
  <para style="q" vid="PSA 52:2">
    <char style="add">Ella è</char> come un rasoio affilato, <char style="add">o tu</char>, operatore d'inganni.<verse eid="PSA 52:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3"/>Tu hai amato il male più che il bene;</para>
  <para style="q" vid="PSA 52:3">La menzogna più che il parlare dirittamente.<verse eid="PSA 52:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4"/>Tu hai amate tutte le parole di ruina,</para>
  <para style="q" vid="PSA 52:4">O lingua frodolente.<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5"/>Iddio altresì ti distruggerà in eterno;</para>
  <para style="q" vid="PSA 52:5">Egli ti atterrerà, e ti divellerà dal <char style="add">tuo</char> tabernacolo,</para>
  <para style="q" vid="PSA 52:5">E ti diradicherà dalla terra de' viventi<note caller="*" style="x"><char style="xo" closed="false">52.5 </char><char style="xk" closed="false">viventi </char><char style="xt" closed="false"><ref loc="PRO 2:22">Prov. 2.22</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 52:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6"/>E i giusti lo vedranno, e temeranno;</para>
  <para style="q" vid="PSA 52:6">E si rideranno di lui, <char style="add">dicendo:</char><verse eid="PSA 52:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7"/>Ecco l'uomo <char style="add">che</char> non aveva posto Iddio <char style="add">per</char> sua fortezza;</para>
  <para style="q" vid="PSA 52:7">Anzi si confidava nella grandezza delle sue ricchezze<note caller="*" style="x"><char style="xo" closed="false">52.7 </char><char style="xk" closed="false">ricchezze </char><char style="xt" closed="false"><ref loc="MRK 10:24">Mar. 10.24</ref>. <ref loc="LUK 12:20">Luc. 12.20</ref>.</char></note>,</para>
  <para style="q" vid="PSA 52:7">E si fortificava nella sua malizia.<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8"/>Ma io <char style="add">sarò</char> come un ulivo verdeggiante nella Casa di Dio<note caller="*" style="x"><char style="xo" closed="false">52.8 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="PSA 92:12">Sal. 92.12</ref> ecc. <ref loc="HOS 14:6">Os. 14.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 52:8">Io mi confido nella benignità di Dio in sempiterno.<verse eid="PSA 52:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9"/>
    <char style="add">O Signore</char>, io ti celebrerò in eterno; perciocchè tu avrai operato;</para>
  <para style="q" vid="PSA 52:9">E spererò nel tuo Nome, perciocchè <char style="add">è</char> buono,</para>
  <para style="q" vid="PSA 52:9">
    <char style="add">Ed è</char> presente a' tuoi santi.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">SALMO LIII</para>
  <para style="r">(Sal. 14 e rif)</para>
  <para style="s1">Estrema depravazione di quelli che negano Iddio</para>
  <para style="d">Maschil di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Mahalat</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1"/>LO stolto ha detto nel suo cuore: Non <char style="add">vi è</char> Dio.</para>
  <para style="q" vid="PSA 53:1">Si son corrotti, e resi abbominevoli <char style="add">in</char> perversità;</para>
  <para style="q" vid="PSA 53:1">Non <char style="add">vi è</char> niuno che faccia bene.<verse eid="PSA 53:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2"/>Iddio ha riguardato dal cielo sopra i figliuoli degli uomini.</para>
  <para style="q" vid="PSA 53:2">Per vedere se vi fosse alcuno che avesse intelletto,</para>
  <para style="q" vid="PSA 53:2">Che cercasse Iddio<note caller="*" style="x"><char style="xo" closed="false">53.2 </char><char style="xk" closed="false">Iddio </char><char style="xt" closed="false"><ref loc="2CH 15:2">2 Cron. 15.2</ref>.</char></note>.<verse eid="PSA 53:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3"/>Tutti son corrotti, tutti son divenuti puzzolenti;</para>
  <para style="q" vid="PSA 53:3">Non <char style="add">vi è</char> niuno che faccia bene,</para>
  <para style="q" vid="PSA 53:3">Non pur uno.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4"/>Non hanno essi alcuno intendimento, questi operatori d'iniquità,</para>
  <para style="q" vid="PSA 53:4">Che mangiano il mio popolo, <char style="add">come se</char> mangiassero del pane,</para>
  <para style="q" vid="PSA 53:4">
    <char style="add">E</char> non invocano Iddio?<verse eid="PSA 53:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5"/>Là saranno spaventati di <char style="add">grande</char> spavento<note caller="*" style="x"><char style="xo" closed="false">53.5 </char><char style="xk" closed="false">spavento </char><char style="xt" closed="false"><ref loc="PRO 28:1">Prov. 28.1</ref>.</char></note>,</para>
  <para style="q" vid="PSA 53:5">
    <char style="add">Ove però</char> non sarà <char style="add">cagion di</char> spavento;</para>
  <para style="q" vid="PSA 53:5">Perciocchè il Signore dissipa le ossa di coloro</para>
  <para style="q" vid="PSA 53:5">Che si accampano contro a te, <char style="add">o Sion</char>;</para>
  <para style="q" vid="PSA 53:5">Tu li hai svergognati; perciocchè Iddio li sdegna.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6"/>Oh! vengano pur da Sion le salvazioni d'Israele!</para>
  <para style="q" vid="PSA 53:6">Quando Iddio trarrà di cattività il suo popolo,</para>
  <para style="q" vid="PSA 53:6">Giacobbe festeggerà, Israele si rallegrerà.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">SALMO LIV</para>
  <para style="s1">Preghiera di Davide per esser liberato</para>
  <para style="d">Maschil di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Neghinot. Intorno a ciò che gli Zifei vennero a dire a Saulle: Davide non si nasconde egli appresso di noi<note caller="*" style="x"><char style="xo" closed="false">54.0 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="1SA 23:19">1 Sam. 23.19</ref>; <ref loc="1SA 26:1">26.1</ref>.</char></note>?</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1"/>O DIO, salvami per lo tuo Nome,</para>
  <para style="q" vid="PSA 54:1">E fammi ragione per la tua potenza.<verse eid="PSA 54:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2"/>O Dio, ascolta la mia orazione;</para>
  <para style="q" vid="PSA 54:2">Porgi gli orecchi alle parole della mia bocca.<verse eid="PSA 54:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3"/>Perciocchè degli <char style="add">uomini</char> stranieri si son levati contro a me;</para>
  <para style="q" vid="PSA 54:3">E degli <char style="add">uomini</char> violenti cercano l'anima mia,</para>
  <para style="q" vid="PSA 54:3">
    <char style="add">I quali</char> non pongono Iddio davanti agli occhi loro. <char style="qs">(Sela.)</char><verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4"/>Ecco, Iddio <char style="add">è</char> il mio aiutatore;</para>
  <para style="q" vid="PSA 54:4">Il Signore <char style="add">è</char> fra quelli che sostengono l'anima mia.<verse eid="PSA 54:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5"/>Egli renderà il male a' miei nemici.</para>
  <para style="q" vid="PSA 54:5">Distruggili per la tua verità.<verse eid="PSA 54:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6"/>Io ti farò sacrificio d'<char style="add">animo</char> volonteroso;</para>
  <para style="q" vid="PSA 54:6">Signore, io celebrerò il tuo Nome, perciocchè <char style="add">è</char> buono.<verse eid="PSA 54:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7"/>Perciocchè esso mi ha tratto fuori d'ogni distretta;</para>
  <para style="q" vid="PSA 54:7">E l'occhio mio ha veduto ne' miei nemici <char style="add">ciò che io desiderava</char>.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">SALMO LV</para>
  <para style="s1">Davide si lagna della malvagità dei suoi nemici, persevera nell'orazione, e si rimette in Dio</para>
  <para style="d">Maschil di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Neghinot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1"/>O DIO, porgi l'orecchio alla mia orazione;</para>
  <para style="q" vid="PSA 55:1">E non nasconderti dalla mia supplicazione.<verse eid="PSA 55:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2"/>Attendi a me, e rispondimi;</para>
  <para style="q" vid="PSA 55:2">Io mi lagno nella mia orazione, e romoreggio;<verse eid="PSA 55:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3"/>Per lo gridar del nemico, per l'oppressione dell'empio;</para>
  <para style="q" vid="PSA 55:3">Perciocchè essi mi traboccano addosso delle calamità,</para>
  <para style="q" vid="PSA 55:3">E mi nimicano con ira<note caller="*" style="x"><char style="xo" closed="false">55.3 </char><char style="xk" closed="false">ira </char><char style="xt" closed="false"><ref loc="2SA 16:7">2 Sam. 16.7</ref>,<ref loc="2SA 16:8">8</ref>; <ref loc="2SA 19:19">19.19</ref>.</char></note>.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4"/>Il mio cuore è angosciato dentro di me;</para>
  <para style="q" vid="PSA 55:4">E spaventi mortali mi sono caduti addosso<note caller="*" style="x"><char style="xo" closed="false">55.4 </char><char style="xk" closed="false">addosso </char><char style="xt" closed="false"><ref loc="PSA 116:3">Sal. 116.3</ref>.</char></note>.<verse eid="PSA 55:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5"/>Paura e tremito mi è sopraggiunto;</para>
  <para style="q" vid="PSA 55:5">E terrore mi ha coperto.<verse eid="PSA 55:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6"/>Onde io ho detto: Oh! avessi io delle ale, come le colombe!</para>
  <para style="q" vid="PSA 55:6">Io me ne volerei, e mi riparerei <char style="add">in alcun luogo</char>.<verse eid="PSA 55:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7"/>Ecco, io me ne fuggirei lontano;</para>
  <para style="q" vid="PSA 55:7">Io dimorerei nel deserto. <char style="qs">(Sela.)</char><verse eid="PSA 55:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8"/>Io mi affretterei di scampare</para>
  <para style="q" vid="PSA 55:8">Dal vento impetuoso <char style="add">e</char> dal turbo.<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9"/>Disperdi<char style="add">li</char>, Signore; dividi le lor lingue;</para>
  <para style="q" vid="PSA 55:9">Perciocchè io ho vedute violenze e risse nella città.<verse eid="PSA 55:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10"/>Essa n'è circondata d'intorno alle sue mura, giorno e notte;</para>
  <para style="q" vid="PSA 55:10">E in mezzo ad essa <char style="add">vi è</char> iniquità ed ingiuria.<verse eid="PSA 55:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11"/>Dentro di essa non <char style="add">vi è altro che</char> malizie;</para>
  <para style="q" vid="PSA 55:11">Frodi ed inganni non si muovono dalle sue piazze.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12"/>Perciocchè non <char style="add">è stato</char> un mio nemico <char style="add">che</char> mi ha fatto vituperio;</para>
  <para style="q" vid="PSA 55:12">Altrimenti, io l'avrei comportato;</para>
  <para style="q" vid="PSA 55:12">Non <char style="add">è stato</char> uno che mi avesse in odio <char style="add">che</char> si è levato contro a me;</para>
  <para style="q" vid="PSA 55:12">Altrimenti, io mi sarei nascosto da lui.<verse eid="PSA 55:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13"/>Anzi, <char style="add">sei stato</char> tu, <char style="add">ch'eri</char>, secondo la mia estimazione,</para>
  <para style="q" vid="PSA 55:13">Il mio conduttore, ed il mio famigliare<note caller="*" style="x"><char style="xo" closed="false">55.13 </char><char style="xk" closed="false">famigliare </char><char style="xt" closed="false"><ref loc="2SA 15:12">2 Sam. 15.12</ref>; <ref loc="2SA 16:23">16.23</ref>.</char></note>.<verse eid="PSA 55:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14"/>Che comunicavamo dolcemente insieme i <char style="add">nostri</char> segreti,</para>
  <para style="q" vid="PSA 55:14">
    <char style="add">E</char> andavamo di compagnia nella Casa di Dio.<verse eid="PSA 55:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15"/>Metta loro la morte la mano addosso,</para>
  <para style="q" vid="PSA 55:15">Scendano sotterra tutti vivi<note caller="*" style="x"><char style="xo" closed="false">55.15 </char><char style="xk" closed="false">vivi </char><char style="xt" closed="false"><ref loc="NUM 16:30">Num. 16.30</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 55:15">Perciocchè nel mezzo di loro, nelle lor dimore, <char style="add">non vi è altro che</char> malvagità.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16"/>Quant'è a me, io griderò a Dio,</para>
  <para style="q" vid="PSA 55:16">E il Signore mi salverà.<verse eid="PSA 55:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17"/>La sera, la mattina, e in sul mezzodì, io orerò<note caller="*" style="x"><char style="xo" closed="false">55.17 </char><char style="xk" closed="false">orerò </char><char style="xt" closed="false"><ref loc="DAN 6:10">Dan. 6.10</ref>. <ref loc="LUK 18:1">Luc. 18.1</ref>. <ref loc="ACT 3:1">Fat. 3.1</ref>; <ref loc="ACT 10:3">10.3</ref>,<ref loc="ACT 10:9">9</ref>,<ref loc="ACT 10:30">30</ref>. <ref loc="1TH 5:17">1 Tess. 5.17</ref>.</char></note> e romoreggerò;</para>
  <para style="q" vid="PSA 55:17">Ed egli udirà la mia voce.<verse eid="PSA 55:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18"/>Egli riscuoterà l'anima mia dall'assalto che mi è dato,</para>
  <para style="q" vid="PSA 55:18">
    <char style="add">E la metterà</char> in pace;</para>
  <para style="q" vid="PSA 55:18">Perciocchè essi son contro a me in gran numero<note caller="*" style="x"><char style="xo" closed="false">55.18 </char><char style="xk" closed="false">numero </char><char style="xt" closed="false"><ref loc="2KI 6:16">2 Re. 6.16</ref>. <ref loc="2CH 32:7">2 Cron. 32.7</ref>,<ref loc="2CH 32:8">8</ref>.</char></note>.<verse eid="PSA 55:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19"/>Iddio <char style="add">mi</char> udirà, e li abbatterà;</para>
  <para style="q" vid="PSA 55:19">Egli, <char style="add">dico</char>, che dimora in ogni eternità<note caller="*" style="x"><char style="xo" closed="false">55.19 </char><char style="xk" closed="false">eternità </char><char style="xt" closed="false"><ref loc="DEU 33:27">Deut. 33.27</ref>.</char></note>; <char style="qs">(Sela.)</char></para>
  <para style="q" vid="PSA 55:19">Perciocchè giammai non si mutano,</para>
  <para style="q" vid="PSA 55:19">E non temono Iddio.<verse eid="PSA 55:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20"/>Hanno messa la mano addosso a quelli che vivevano in buona pace con loro;</para>
  <para style="q" vid="PSA 55:20">Hanno rotto il lor patto.<verse eid="PSA 55:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21"/>Le lor bocche son più dolci che burro;</para>
  <para style="q" vid="PSA 55:21">Ma <char style="add">ne</char>'cuori loro <char style="add">vi è</char> guerra;</para>
  <para style="q" vid="PSA 55:21">Le lor parole son più morbide che olio,</para>
  <para style="q" vid="PSA 55:21">Ma son tante coltellate.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22"/>Rimetti nel Signore il tuo peso, ed egli ti sosterrà<note caller="*" style="x"><char style="xo" closed="false">55.22 </char><char style="xk" closed="false">sosterrà </char><char style="xt" closed="false"><ref loc="PSA 37:5">Sal. 37.5</ref>. <ref loc="MAT 6:25">Mat. 6.25</ref> ecc. <ref loc="1PE 5:7">1 Piet. 5.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 55:22">Egli non permetterà giammai che il giusto caggia.<verse eid="PSA 55:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23"/>Ma tu, o Dio, farai scender coloro nel pozzo della perdizione;</para>
  <para style="q" vid="PSA 55:23">Gli uomini di sangue e di frode</para>
  <para style="q" vid="PSA 55:23">Non compieranno a mezzo i giorni loro<note caller="*" style="x"><char style="xo" closed="false">55.23 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PRO 10:27">Prov. 10.27</ref>. <ref loc="ECC 7:17">Eccl. 7.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 55:23">Ma io mi confiderò in te.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">SALMO LVI</para>
  <para style="s1">Davide prega Dio di salvarlo dai suoi nemici, e già lo loda per la concessa liberazione</para>
  <para style="d">Mictam di Davide, intorno a ciò che i Filistei lo presero in Gat;<note caller="*" style="x"><char style="xo" closed="false">56.0 </char><char style="xk" closed="false">Gat; </char><char style="xt" closed="false"><ref loc="1SA 21:10">1 Sam. 21.10</ref> ecc.</char></note> <char style="add">dato</char> al Capo dei Musici, in su Ionat-elem-rehochim</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1"/>ABBI pietà di me, o Dio;</para>
  <para style="q" vid="PSA 56:1">Perciocchè gli uomini a gola aperta sono dietro a me;</para>
  <para style="q" vid="PSA 56:1">
    <char style="add">I miei</char> assalitori mi stringono tuttodì.<verse eid="PSA 56:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2"/>I miei nemici son dietro a me a gola aperta tuttodì;</para>
  <para style="q" vid="PSA 56:2">Perciocchè gran numero di gente mi assale da alto.<verse eid="PSA 56:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3"/>Nel giorno <char style="add">che</char> io temerò,</para>
  <para style="q" vid="PSA 56:3">Io mi confiderò in te<note caller="*" style="x"><char style="xo" closed="false">56.3 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 56:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4"/>Coll'<char style="add">aiuto di</char> Dio, io loderò la sua parola;</para>
  <para style="q" vid="PSA 56:4">Io mi confido in Dio,</para>
  <para style="q" vid="PSA 56:4">Io non temerò cosa che mi possa far la carne<note caller="*" style="x"><char style="xo" closed="false">56.4 </char><char style="xk" closed="false">carne </char><char style="xt" closed="false"><ref loc="PSA 118:6">Sal. 118.6</ref> ecc. <ref loc="ISA 51:12">Is. 51.12</ref>,<ref loc="ISA 51:13">13</ref>. <ref loc="HEB 13:6">Ebr. 13.6</ref>.</char></note>.<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5"/>Tuttodì fanno dolorose le mie parole;</para>
  <para style="q" vid="PSA 56:5">Tutti i lor pensieri <char style="add">son</char> contro a me a male.<verse eid="PSA 56:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6"/>Si radunano insieme, stanno in agguato; spiano le mie pedate,</para>
  <para style="q" vid="PSA 56:6">Come aspettando <char style="add">di coglier</char> l'anima mia.<verse eid="PSA 56:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7"/>In vano <char style="add">sarebbe</char> il salvar loro <char style="add">la vita</char>;</para>
  <para style="q" vid="PSA 56:7">O Dio, trabocca i popoli nella <char style="add">tua</char> ira.<verse eid="PSA 56:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8"/>Tu hai contate le mie fughe;</para>
  <para style="q" vid="PSA 56:8">Riponi le mie lagrime ne' tuoi barili;</para>
  <para style="q" vid="PSA 56:8">Non <char style="add">sono elleno</char> nel tuo registro?<verse eid="PSA 56:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9"/>Allora i miei nemici volteranno le spalle, nel giorno che io griderò;</para>
  <para style="q" vid="PSA 56:9">Questo so io, che Iddio <char style="add">è</char> per me<note caller="*" style="x"><char style="xo" closed="false">56.9 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="ROM 8:31">Rom. 8.31</ref>.</char></note>.<verse eid="PSA 56:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10"/>Con <char style="add">l'aiuto di</char> Dio, io loderò la <char style="add">sua</char> parola;</para>
  <para style="q" vid="PSA 56:10">Con <char style="add">l'aiuto del</char> Signore, io loderò la <char style="add">sua</char> parola.<verse eid="PSA 56:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11"/>Io mi confido in Dio;</para>
  <para style="q" vid="PSA 56:11">Io non temerò cosa che mi possa far l'uomo<note caller="*" style="x"><char style="xo" closed="false">56.11 </char><char style="xk" closed="false">uomo </char><char style="xt" closed="false">Ver. 4 </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12"/>
    <char style="add">Io ho</char> sopra me i voti che io ti ho fatti, o Dio;</para>
  <para style="q" vid="PSA 56:12">Io ti renderò lodi.<verse eid="PSA 56:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13"/>Conciossiachè tu abbi riscossa l'anima mia dalla morte<note caller="*" style="x"><char style="xo" closed="false">56.13 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="PSA 49:15">Sal. 49.15</ref>; <ref loc="PSA 103:4">103.4</ref>; <ref loc="PSA 116:8">116.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 56:13">Non <char style="add">hai tu guardati</char> i miei piedi di ruina,</para>
  <para style="q" vid="PSA 56:13">Acciocchè io cammini nel cospetto di Dio nella luce de' viventi?<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">SALMO LVII</para>
  <para style="s1">Davide chiede soccorso contro ai suoi nemici e loda il Signore</para>
  <para style="d">Mictam di Davide, intorno a ciò ch'egli se ne fuggì nella spelonca, d'innanzi a Saulle<note caller="*" style="x"><char style="xo" closed="false">57.0 </char><char style="xk" closed="false">Saulle </char><char style="xt" closed="false"><ref loc="1SA 22:1">1 Sam. 22.1</ref>; <ref loc="1SA 24:1">24.1</ref> ecc.</char></note>; <char style="add">dato</char> al Capo de' Musici, <char style="add">sopra</char> Al-tashet</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1"/>ABBI pietà di me, o Dio; abbi pietà di me;</para>
  <para style="q" vid="PSA 57:1">Perciocchè l'anima mia si confida in te<note caller="*" style="x"><char style="xo" closed="false">57.1 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 57:1">Ed io ho la mia speranza nell'ombra delle tue ale<note caller="*" style="x"><char style="xo" closed="false">57.1 </char><char style="xk" closed="false">ale </char><char style="xt" closed="false"><ref loc="PSA 17:8">Sal. 17.8</ref>; <ref loc="PSA 63:7">63.7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 57:1">Finchè sieno passate le calamità.<verse eid="PSA 57:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2"/>Io griderò all'Iddio altissimo;</para>
  <para style="q" vid="PSA 57:2">A Dio che dà compimento a' fatti miei<note caller="*" style="x"><char style="xo" closed="false">57.2 </char><char style="xk" closed="false">miei </char><char style="xt" closed="false"><ref loc="PSA 138:8">Sal. 138.8</ref>.</char></note>.<verse eid="PSA 57:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3"/>Egli manderà dal cielo a salvarmi;</para>
  <para style="q" vid="PSA 57:3">Egli renderà confuso colui ch'è dietro a me a gola aperta. <char style="qs">(Sela.)</char></para>
  <para style="q" vid="PSA 57:3">Iddio manderà la sua benignità, e la sua verità<note caller="*" style="x"><char style="xo" closed="false">57.3 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="PSA 40:11">Sal. 40.11</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 57:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4"/>L'anima mia <char style="add">è</char> in mezzo a' leoni;</para>
  <para style="q" vid="PSA 57:4">Io giaccio <char style="add">fra</char> uomini incendiari,</para>
  <para style="q" vid="PSA 57:4">I cui denti <char style="add">son</char> lance, e saette,</para>
  <para style="q" vid="PSA 57:4">E la cui lingua <char style="add">è</char> spada acuta.<verse eid="PSA 57:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5"/>Innalzati, o Dio, sopra i cieli;</para>
  <para style="q" vid="PSA 57:5">
    <char style="add">Innalzisi</char> la tua gloria sopra tutta la terra.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6"/>Essi avevano apparecchiata una rete a' miei passi,</para>
  <para style="q" vid="PSA 57:6">
    <char style="add">Già</char> tiravano a basso l'anima mia;</para>
  <para style="q" vid="PSA 57:6">Avevano cavata una fossa davanti a me;</para>
  <para style="q" vid="PSA 57:6">
    <char style="add">Ma</char> essi vi sono caduti dentro<note caller="*" style="x"><char style="xo" closed="false">57.6 </char><char style="xk" closed="false">dentro </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref> </char><char style="xta" closed="false">e rif.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 57:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7"/>Il mio cuore è disposto<note caller="*" style="x"><char style="xo" closed="false">57.7 </char><char style="xk" closed="false">disposto </char><char style="xt" closed="false"><ref loc="PSA 108:1">Sal. 108.1</ref> ecc.</char></note>, o Dio; il mio cuore è disposto;</para>
  <para style="q" vid="PSA 57:7">Io canterò, e salmeggerò.<verse eid="PSA 57:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8"/>Gloria mia, destati; destati, saltero, e cetera;</para>
  <para style="q" vid="PSA 57:8">Io mi risveglierò all'alba.<verse eid="PSA 57:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9"/>Io ti celebrerò, o Signore, fra i popoli;</para>
  <para style="q" vid="PSA 57:9">Io ti salmeggerò fra le nazioni;<verse eid="PSA 57:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10"/>Perciocchè la tua benignità <char style="add">è</char> grande infino al cielo,</para>
  <para style="q" vid="PSA 57:10">E la tua verità infino alle nuvole<note caller="*" style="x"><char style="xo" closed="false">57.10 </char><char style="xk" closed="false">nuvole </char><char style="xt" closed="false"><ref loc="PSA 36:5">Sal. 36.5</ref>; <ref loc="PSA 103:11">103.11</ref>; <ref loc="PSA 108:4">108.4</ref>.</char></note>.<verse eid="PSA 57:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11"/>Innalzati, o Dio, sopra i cieli;</para>
  <para style="q" vid="PSA 57:11">
    <char style="add">Innalzisi</char> la tua gloria sopra tutta la terra.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">SALMO LVIII</para>
  <para style="s1">Le frodi dei malvagi. Dio li punirà e salverà il giusto</para>
  <para style="d">Mictam di Davide, <char style="add">dato</char> al Capo de' Musici, <char style="add">sopra</char> Al-tashet</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1"/>DI vero, parlate voi giustamente?</para>
  <para style="q" vid="PSA 58:1">Giudicate voi dirittamente, o figliuoli di uomini?<verse eid="PSA 58:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2"/>Anzi voi fabbricate perversità nel cuor vostro;</para>
  <para style="q" vid="PSA 58:2">Voi bilanciate la violenza delle vostre mani<note caller="*" style="x"><char style="xo" closed="false">58.2 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="PSA 94:20">Sal. 94.20</ref>. <ref loc="ISA 10:1">Is. 10.1</ref>.</char></note> in terra.<verse eid="PSA 58:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3"/>
    <char style="add">Questi</char> empi sono stati alienati fin dalla matrice;</para>
  <para style="q" vid="PSA 58:3">
    <char style="add">Questi</char> parlatori di menzogna sono stati sviati fin dal seno <char style="add">della madre</char><note caller="*" style="x"><char style="xo" closed="false">58.3 </char><char style="xk" closed="false"><char style="add">madre</char> </char><char style="xt" closed="false"><ref loc="PSA 51:5">Sal. 51.5</ref> e rif. <ref loc="ISA 48:8">Is. 48.8</ref>.</char></note>.<verse eid="PSA 58:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4"/>Hanno del veleno simile al veleno del serpente;</para>
  <para style="q" vid="PSA 58:4">
    <char style="add">Sono</char> come l'aspido sordo, che si tura le orecchie;<verse eid="PSA 58:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5"/>Il qual non ascolta la voce degl'incantatori<note caller="*" style="x"><char style="xo" closed="false">58.5 </char><char style="xk" closed="false">incantatori </char><char style="xt" closed="false"><ref loc="ECC 10:11">Eccl. 10.11</ref>. <ref loc="JER 8:17">Ger. 8.17</ref>.</char></note>,</para>
  <para style="q" vid="PSA 58:5">
    <char style="add">Nè</char> di chi è saputo in fare incantagioni.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6"/>O Dio, stritola loro i denti nella lor bocca;</para>
  <para style="q" vid="PSA 58:6">O Signore, rompi i mascellari de' leoncelli.<verse eid="PSA 58:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7"/>Struggansi come acque, e vadansene via;</para>
  <para style="q" vid="PSA 58:7">Tiri <char style="add">Iddio</char> le sue saette, e in uno stante sieno ricisi.<verse eid="PSA 58:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8"/>Trapassino, come una lumaca <char style="add">che</char> si disfa;</para>
  <para style="q" vid="PSA 58:8">
    <char style="add">Come</char> l'abortivo di una donna, non veggano il sole.<verse eid="PSA 58:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9"/>Avanti che le vostre pignatte sentano <char style="add">il fuoco</char> del pruno,</para>
  <para style="q" vid="PSA 58:9">Porti via la bufera il verde ed il secco<note caller="*" style="x"><char style="xo" closed="false">58.9 </char><char style="xk" closed="false">secco </char><char style="xt" closed="false"><ref loc="PRO 10:25">Prov. 10.25</ref>.</char></note>.<verse eid="PSA 58:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10"/>Il giusto si rallegrerà, quando avrà veduta la vendetta;</para>
  <para style="q" vid="PSA 58:10">Egli bagnerà i suoi piedi nel sangue dell'empio.<verse eid="PSA 58:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11"/>E ciascuno dirà: Certo egli vi è frutto pel giusto;</para>
  <para style="q" vid="PSA 58:11">
    <char style="add">Vi è</char> pure un Dio giudice in terra.<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">SALMO LIX</para>
  <para style="s1">Davide prega Dio che lo liberi, e protesta della sua innocenza</para>
  <para style="d">Mictam di Davide, intorno a ciò che Saulle mandò a guardar la <char style="add">sua</char> casa, per ucciderlo<note caller="*" style="x"><char style="xo" closed="false">59.0 </char><char style="xk" closed="false">ucciderlo </char><char style="xt" closed="false"><ref loc="1SA 19:11">1 Sam. 19.11</ref> ecc.</char></note>; <char style="add">dato</char> al Capo de' Musici, <char style="add">sopra</char> Al-tashet</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1"/>DIO mio, riscuotimi da' miei nemici;</para>
  <para style="q" vid="PSA 59:1">Levami ad alto d'infra quelli che si levano contro a me.<verse eid="PSA 59:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2"/>Riscuotimi dagli operatori d'iniquità,</para>
  <para style="q" vid="PSA 59:2">E salvami dagli uomini di sangue.<verse eid="PSA 59:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3"/>Perciocchè, ecco, han posti agguati all'anima mia;</para>
  <para style="q" vid="PSA 59:3">
    <char style="add">Uomini</char> possenti si son raunati contro a me;</para>
  <para style="q" vid="PSA 59:3">Senza <char style="add">che vi sia</char> in me, nè misfatto, nè peccato, o Signore.<verse eid="PSA 59:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4"/>Benchè, non <char style="add">vi sia</char> iniquità <char style="add">in me</char><note caller="*" style="x"><char style="xo" closed="false">59.4 </char><char style="xk" closed="false"><char style="add">me</char> </char><char style="xt" closed="false"><ref loc="1SA 24:11">1 Sam. 24.11</ref>.</char></note>, pur corrono, e si apparecchiano;</para>
  <para style="q" vid="PSA 59:4">Destati per venire ad incontrarmi, e vedi.<verse eid="PSA 59:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5"/>Tu, dico, Signore Iddio degli eserciti, Dio d'Israele,</para>
  <para style="q" vid="PSA 59:5">Risvegliati per visitar tutte le genti;</para>
  <para style="q" vid="PSA 59:5">Non far grazia a tutti quelli che perfidamente operano iniquità. <char style="qs">(Sela.)</char><verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6"/>La sera vanno e vengono; romoreggiano come cani,</para>
  <para style="q" vid="PSA 59:6">E circuiscono la città.<verse eid="PSA 59:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7"/>Ecco, sgorgano <char style="add">parole</char> colla lor bocca;</para>
  <para style="q" vid="PSA 59:7">Hanno de' coltelli nelle lor labbra; perciocchè <char style="add">dicono:</char> Chi <char style="add">ci</char> ode<note caller="*" style="x"><char style="xo" closed="false">59.7 </char><char style="xk" closed="false">ode </char><char style="xt" closed="false"><ref loc="PSA 10:11">Sal. 10.11</ref>; <ref loc="PSA 94:7">94.7</ref> ecc.</char></note>?<verse eid="PSA 59:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8"/>Ma tu, Signore, ti riderai di loro;</para>
  <para style="q" vid="PSA 59:8">Tu ti befferai di tutte le genti<note caller="*" style="x"><char style="xo" closed="false">59.8 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="PSA 2:4">Sal. 2.4</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 59:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9"/>Io mi guarderò dalla lor forza, <char style="add">riducendomi</char> a te;</para>
  <para style="q" vid="PSA 59:9">Perciocchè tu, o Dio, <char style="add">sei</char> il mio alto ricetto.<verse eid="PSA 59:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10"/>L'Iddio mio benigno mi verrà ad incontrare;</para>
  <para style="q" vid="PSA 59:10">Iddio mi farà veder ne' miei nemici <char style="add">quello che io desidero</char>.<verse eid="PSA 59:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11"/>Non ucciderli già; che talora il mio popolo non lo dimentichi;</para>
  <para style="q" vid="PSA 59:11">Falli, per la tua potenza, andar vagando<note caller="*" style="x"><char style="xo" closed="false">59.11 </char><char style="xk" closed="false">vagando </char><char style="xt" closed="false"><ref loc="GEN 4:12-15">Gen. 4.12-15</ref>. <ref loc="NUM 32:13">Num. 32.13</ref>.</char></note>; ed abbattili,</para>
  <para style="q" vid="PSA 59:11">O Signore, scudo nostro;<verse eid="PSA 59:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12"/>
    <char style="add">Per</char> lo peccato della lor bocca, <char style="add">per</char> le parole delle lor labbra<note caller="*" style="x"><char style="xo" closed="false">59.12 </char><char style="xk" closed="false">labbra </char><char style="xt" closed="false"><ref loc="PRO 12:13">Prov. 12.13</ref>; <ref loc="PRO 18:7">18.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 59:12">E sieno colti per l'orgoglio loro,</para>
  <para style="q" vid="PSA 59:12">E <char style="add">perciocchè</char> tengono ragionamenti di esecrazioni e di menzogne.<verse eid="PSA 59:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13"/>Distruggi<char style="add">li</char> nel <char style="add">tuo</char> furore; distruggi<char style="add">li</char> sì che non <char style="add">sieno più</char>;</para>
  <para style="q" vid="PSA 59:13">E sappiano, che Iddio signoreggia in Giacobbe,</para>
  <para style="q" vid="PSA 59:13">
    <char style="add">Anzi</char> fino alle estremità della terra. <char style="qs">(Sela.)</char><verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14"/>Vadano pure, e vengano la sera; romoreggino come cani,</para>
  <para style="q" vid="PSA 59:14">E circuiscano la città.<verse eid="PSA 59:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15"/>Andranno tapinando per <char style="add">trovar da</char> mangiare;</para>
  <para style="q" vid="PSA 59:15">Avvegnachè non sieno sazii, pur passeranno <char style="add">così</char> la notte.<verse eid="PSA 59:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16"/>Ma io canterò la tua potenza,</para>
  <para style="q" vid="PSA 59:16">E la mattina loderò ad alta voce la tua benignità;</para>
  <para style="q" vid="PSA 59:16">Perciocchè tu mi sei stato alto ricetto</para>
  <para style="q" vid="PSA 59:16">E rifugio, nel giorno che sono stato distretto.<verse eid="PSA 59:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17"/>O mia forza<note caller="*" style="x"><char style="xo" closed="false">59.17 </char><char style="xk" closed="false">forza </char><char style="xt" closed="false"><ref loc="PSA 18:1">Sal. 18.1</ref> </char><char style="xta" closed="false">e rif.</char></note>, io ti salmeggerò;</para>
  <para style="q" vid="PSA 59:17">Perciocchè Iddio <char style="add">è</char> il mio alto ricetto, l'Iddio mio benigno.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">SALMO LX</para>
  <para style="s1">Inno di ringraziamento per varie vittorie</para>
  <para style="d">Mictam di Davide, da insegnare; <char style="add">dato</char> al Capo de' Musici, sopra Susan-edut; intorno a ciò ch'egli diede il guasto alla Siria di Mesopotamia, ed alla Siria di Soba; e che Ioab, ritornando, sconfisse gl'Idumei nella valle del Sale, <char style="add">in numero di</char> dodici mila<note caller="*" style="x"><char style="xo" closed="false">60.0 </char><char style="xk" closed="false">mila </char><char style="xt" closed="false"><ref loc="2SA 8:1">2 Sam. 8.1</ref> ecc.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1"/>O DIO, tu ci hai scacciati, tu ci hai dissipati,</para>
  <para style="q" vid="PSA 60:1">Tu ti sei adirato; <char style="add">e poi</char>, tu ti sei rivolto a noi.<verse eid="PSA 60:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2"/>Tu hai scrollata la terra, e l'hai schiantata;</para>
  <para style="q" vid="PSA 60:2">Ristora le sue rotture<note caller="*" style="x"><char style="xo" closed="false">60.2 </char><char style="xk" closed="false">rotture </char><char style="xt" closed="false"><ref loc="2CH 7:14">2 Cron. 7.14</ref>.</char></note>; perciocchè è smossa.<verse eid="PSA 60:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3"/>Tu hai fatte sentire al tuo popolo cose dure;</para>
  <para style="q" vid="PSA 60:3">Tu ci hai dato a bere del vino di stordimento<note caller="*" style="x"><char style="xo" closed="false">60.3 </char><char style="xk" closed="false">stordimento </char><char style="xt" closed="false"><ref loc="ISA 51:17">Is. 51.17</ref>,<ref loc="ISA 51:22">22</ref>.</char></note>.<verse eid="PSA 60:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4"/>
    <char style="add">Ma ora</char>, tu hai dato a quelli che ti temono una bandiera,</para>
  <para style="q" vid="PSA 60:4">Per alzarla, per amor della <char style="add">tua</char> verità. <char style="qs">(Sela.)</char><verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5"/>Acciocchè la tua diletta gente sia liberata<note caller="*" style="x"><char style="xo" closed="false">60.5 </char><char style="xk" closed="false">liberata </char><char style="xt" closed="false"><ref loc="PSA 108:6">Sal. 108.6</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 60:5">Salva<char style="add">mi col</char>la tua destra, e rispondimi.<verse eid="PSA 60:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6"/>Iddio ha parlato per la sua santità: Io trionferò,</para>
  <para style="q" vid="PSA 60:6">Io spartirò Sichem, e misurerò la valle di Succot.<verse eid="PSA 60:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7"/>Mio <char style="add">è</char> Galaad, e mio <char style="add">è</char> Manasse,</para>
  <para style="q" vid="PSA 60:7">Ed Efraim <char style="add">è</char> la forza del mio capo;</para>
  <para style="q" vid="PSA 60:7">Giuda <char style="add">è</char> il mio legislatore<note caller="*" style="x"><char style="xo" closed="false">60.7 </char><char style="xk" closed="false">legislatore </char><char style="xt" closed="false"><ref loc="GEN 49:10">Gen. 49.10</ref> </char><char style="xta" closed="false">e rif.</char></note>;<verse eid="PSA 60:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8"/>Moab <char style="add">è</char> la caldaia del mio lavatoio<note caller="*" style="x"><char style="xo" closed="false">60.8 </char><char style="xk" closed="false">lavatoio </char><char style="xt" closed="false"><ref loc="2SA 8:2">2 Sam. 8.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 60:8">Io getterò le mie scarpe sopra Edom<note caller="*" style="x"><char style="xo" closed="false">60.8 </char><char style="xk" closed="false">Edom </char><char style="xt" closed="false"><ref loc="2SA 8:14">2 Sam. 8.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 60:8">O Palestina, fammi delle acclamazioni<note caller="*" style="x"><char style="xo" closed="false">60.8 </char><char style="xk" closed="false">acclamazioni </char><char style="xt" closed="false"><ref loc="2SA 8:1">2 Sam. 8.1</ref>.</char></note>.<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9"/>Chi mi condurrà nella città della fortezza?</para>
  <para style="q" vid="PSA 60:9">Chi mi menerà fino in Edom<note caller="*" style="x"><char style="xo" closed="false">60.9 </char><char style="xk" closed="false">Edom </char><char style="xt" closed="false"><ref loc="2SA 12:26">2 Sam. 12.26</ref>.</char></note>?<verse eid="PSA 60:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10"/>Non <char style="add">sarai desso</char> tu, o Dio, <char style="add">che</char> ci avevi scacciati?</para>
  <para style="q" vid="PSA 60:10">E non uscivi <char style="add">più</char> fuori, o Dio, co' nostri eserciti?<verse eid="PSA 60:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11"/>Dacci aiuto, <char style="add">per uscir</char> di distretta;</para>
  <para style="q" vid="PSA 60:11">Perciocchè il soccorso degli uomini <char style="add">è</char> vanità<note caller="*" style="x"><char style="xo" closed="false">60.11 </char><char style="xk" closed="false">vanità </char><char style="xt" closed="false"><ref loc="PSA 118:8">Sal. 118.8</ref>; <ref loc="PSA 146:3">146.3</ref>.</char></note>.<verse eid="PSA 60:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12"/>In Dio noi faremo prodezze<note caller="*" style="x"><char style="xo" closed="false">60.12 </char><char style="xk" closed="false">prodezze </char><char style="xt" closed="false"><ref loc="NUM 24:18">Num. 24.18</ref>. <ref loc="1CH 19:13">1 Cron. 19.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 60:12">Ed egli calpesterà i nostri nemici.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">SALMO LXI</para>
  <para style="s1">Davide si rifugia in Dio</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Neghinot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1"/>O DIO, ascolta il mio grido;</para>
  <para style="q" vid="PSA 61:1">Attendi alla mia orazione.<verse eid="PSA 61:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2"/>Io grido a te dall'estremità della terra, mentre il mio cuore spasima;</para>
  <para style="q" vid="PSA 61:2">Conducimi in su la rocca, che è troppo alta da salirvi da me.<verse eid="PSA 61:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3"/>Perciocchè tu mi sei stato un ricetto,</para>
  <para style="q" vid="PSA 61:3">Una torre di fortezza<note caller="*" style="x"><char style="xo" closed="false">61.3 </char><char style="xk" closed="false">fortezza </char><char style="xt" closed="false"><ref loc="PRO 18:10">Prov. 18.10</ref>.</char></note> d'innanzi al nemico.<verse eid="PSA 61:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4"/>Io dimorerò nel tuo tabernacolo <char style="add">per molti</char> secoli<note caller="*" style="x"><char style="xo" closed="false">61.4 </char><char style="xk" closed="false">secoli </char><char style="xt" closed="false"><ref loc="PSA 27:4">Sal. 27.4</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 61:4">Io mi riparerò nel nascondimento delle tue ale<note caller="*" style="x"><char style="xo" closed="false">61.4 </char><char style="xk" closed="false">ale </char><char style="xt" closed="false"><ref loc="PSA 17:8">Sal. 17.8</ref>; <ref loc="PSA 57:1">57.1</ref>; <ref loc="PSA 91:4">91.4</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 61:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5"/>Perciocchè tu, o Dio, hai esauditi i miei voti;</para>
  <para style="q" vid="PSA 61:5">Tu mi hai data l'eredità di quelli che temono il tuo Nome.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6"/>Aggiungi giorni sopra giorni al re<note caller="*" style="x"><char style="xo" closed="false">61.6 </char><char style="xk" closed="false">re </char><char style="xt" closed="false"><ref loc="PSA 21:4">Sal. 21.4</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 61:6">
    <char style="add">Sieno</char> gli anni suoi a guisa di molte età.<verse eid="PSA 61:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7"/>Dimori in perpetuo nel cospetto di Dio;</para>
  <para style="q" vid="PSA 61:7">Ordina benignità e verità <char style="add">che</char> lo guardino<note caller="*" style="x"><char style="xo" closed="false">61.7 </char><char style="xk" closed="false">guardino </char><char style="xt" closed="false"><ref loc="PSA 40:11">Sal. 40.11</ref>. <ref loc="PRO 20:28">Prov. 20.28</ref>.</char></note>.<verse eid="PSA 61:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8"/>Così salmeggerò il tuo Nome in perpetuo,</para>
  <para style="q" vid="PSA 61:8">Per adempiere ogni giorno i miei voti<note caller="*" style="x"><char style="xo" closed="false">61.8 </char><char style="xk" closed="false">voti </char><char style="xt" closed="false"><ref loc="PSA 50:14">Sal. 50.14</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">SALMO LXII</para>
  <para style="s1">Esortazione a fidare in Dio solo</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici, sopra <char style="add">i figliuoli di</char> Iedutun</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1"/>L'ANIMA mia si acqueta in Dio solo;</para>
  <para style="q" vid="PSA 62:1">Da lui <char style="add">procede</char> la mia salute.<verse eid="PSA 62:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2"/>Egli solo <char style="add">è</char> la mia rocca e la mia salvezza,</para>
  <para style="q" vid="PSA 62:2">Il mio alto ricetto; io non sarò giammai grandemente smosso<note caller="*" style="x"><char style="xo" closed="false">62.2 </char><char style="xk" closed="false">smosso </char><char style="xt" closed="false"><ref loc="PSA 37:24">Sal. 37.24</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 62:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3"/>Infino a quando vi avventerete sopra un uomo?</para>
  <para style="q" vid="PSA 62:3">
    <char style="add">Voi stessi</char> sarete uccisi tutti quanti;</para>
  <para style="q" vid="PSA 62:3">
    <char style="add">E sarete</char> simili ad una parete chinata,</para>
  <para style="q" vid="PSA 62:3">
    <char style="add">E ad</char> un muricciuolo sospinto.<verse eid="PSA 62:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4"/>Essi non consigliano d'altro che di sospinger giù <char style="add">quest'uomo</char> dalla sua altezza;</para>
  <para style="q" vid="PSA 62:4">Prendono piacere in menzogna;</para>
  <para style="q" vid="PSA 62:4">Benedicono colla lor bocca,</para>
  <para style="q" vid="PSA 62:4">Ma maledicono nel loro interiore. <char style="qs">(Sela.)</char><verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5"/>Anima mia, acquetati in Dio solo;</para>
  <para style="q" vid="PSA 62:5">Perciocchè la mia speranza <char style="add">pende</char> da lui.<verse eid="PSA 62:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6"/>Egli solo <char style="add">è</char> la mia rocca e la mia salvezza;</para>
  <para style="q" vid="PSA 62:6">Egli <char style="add">è</char> il mio alto ricetto, io non sarò giammai smosso.<verse eid="PSA 62:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7"/>In Dio <char style="add">è</char> la mia salvezza e la mia gloria;</para>
  <para style="q" vid="PSA 62:7">In Dio <char style="add">è</char> la mia forte rocca, il mio ricetto.<verse eid="PSA 62:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8"/>Confidatevi in lui, o popolo, in ogni tempo<note caller="*" style="x"><char style="xo" closed="false">62.8 </char><char style="xk" closed="false">tempo </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 62:8">Spandete i vostri cuori nel suo cospetto;</para>
  <para style="q" vid="PSA 62:8">Iddio <char style="add">è</char> la nostra speranza. <char style="qs">(Sela.)</char><verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9"/>Gli uomini volgari non <char style="add">sono</char> altro che vanità,</para>
  <para style="q" vid="PSA 62:9">E i nobili <char style="add">altro che</char> menzogna;</para>
  <para style="q" vid="PSA 62:9">
    <char style="add">Se fosser messi</char> in bilance,</para>
  <para style="q" vid="PSA 62:9">Tutti insieme sarebbero pi<char style="add">ù</char> leggieri che la vanità stessa<note caller="*" style="x"><char style="xo" closed="false">62.9 </char><char style="xk" closed="false">stessa </char><char style="xt" closed="false"><ref loc="PSA 39:5">Sal. 39.5</ref>,<ref loc="PSA 39:11">11</ref>. <ref loc="ISA 40:15">Is. 40.15</ref>,<ref loc="ISA 40:17">17</ref>.</char></note>.<verse eid="PSA 62:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10"/>Non vi confidate in oppressione,</para>
  <para style="q" vid="PSA 62:10">Nè in rapina; non datevi alla vanità;</para>
  <para style="q" vid="PSA 62:10">Se le ricchezze abbondano,</para>
  <para style="q" vid="PSA 62:10">Non <char style="add">vi</char> mettete il cuore<note caller="*" style="x"><char style="xo" closed="false">62.10 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="LUK 12:15">Luc. 12.15</ref>. <ref loc="1TI 6:17">1 Tim. 6.17</ref>.</char></note>.<verse eid="PSA 62:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11"/>Iddio ha parlato una volta,</para>
  <para style="q" vid="PSA 62:11">E due volte ho udito lo stesso<note caller="*" style="x"><char style="xo" closed="false">62.11 </char><char style="xk" closed="false">stesso </char><char style="xt" closed="false"><ref loc="JOB 33:14">Giob. 33.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 62:11">Che ogni forza <char style="add">appartiene</char> a Dio<note caller="*" style="x"><char style="xo" closed="false">62.11 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="REV 19:1">Apoc. 19.1</ref>.</char></note>;<verse eid="PSA 62:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12"/>E che a te, Signore, <char style="add">appartiene</char> la benignità<note caller="*" style="x"><char style="xo" closed="false">62.12 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="PSA 103:8">Sal. 103.8</ref>. <ref loc="DAN 9:9">Dan. 9.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 62:12">Perciocchè tu renderai la retribuzione a ciascuno secondo le sue opere<note caller="*" style="x"><char style="xo" closed="false">62.12 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="JOB 34:11">Giob. 34.11</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">SALMO LXIII</para>
  <para style="s1">Davide brama la presenza di Dio</para>
  <para style="d">Salmo di Davide, <char style="add">composto</char> quando egli era nel deserto di Giuda<note caller="*" style="x"><char style="xo" closed="false">63.0 </char><char style="xk" closed="false">Giuda </char><char style="xt" closed="false"><ref loc="1SA 22:5">1 Sam. 22.5</ref>; <ref loc="1SA 23:1">23.1</ref> ecc.; <ref loc="1SA 24:1">24.1</ref> ecc.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1"/>O DIO, tu <char style="add">sei</char> l'Iddio mio, io ti cerco;</para>
  <para style="q" vid="PSA 63:1">L'anima mia è assetata di te<note caller="*" style="x"><char style="xo" closed="false">63.1 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 42:2">Sal. 42.2</ref>; <ref loc="PSA 84:2">84.2</ref>.</char></note>; la mia carne ti brama</para>
  <para style="q" vid="PSA 63:1">In terra arida ed asciutta, senz'acqua.<verse eid="PSA 63:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2"/>Così ti ho io mirato nel santuario,</para>
  <para style="q" vid="PSA 63:2">Riguardando la tua forza, e la tua gloria<note caller="*" style="x"><char style="xo" closed="false">63.2 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="1CH 16:11">1 Cron. 16.11</ref>. <ref loc="PSA 27:4">Sal. 27.4</ref>.</char></note>.<verse eid="PSA 63:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3"/>Perciocchè la tua benignità <char style="add">è</char> cosa buona più che la vita<note caller="*" style="x"><char style="xo" closed="false">63.3 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PSA 30:5">Sal. 30.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 63:3">Le mie labbra ti loderanno.<verse eid="PSA 63:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4"/>Così ti benedirò in vita mia<note caller="*" style="x"><char style="xo" closed="false">63.4 </char><char style="xk" closed="false">mia </char><char style="xt" closed="false"><ref loc="PSA 104:33">Sal. 104.33</ref>; <ref loc="PSA 146:2">146.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 63:4">Io alzerò le mie mani nel tuo Nome.<verse eid="PSA 63:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5"/>L'anima mia è saziata come di grasso e di midolla;</para>
  <para style="q" vid="PSA 63:5">E la mia bocca ti loderà con labbra giubilanti.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6"/>Quando io mi ricordo di te sul mio letto.</para>
  <para style="q" vid="PSA 63:6">Io medito di te nelle veglie della notte.<verse eid="PSA 63:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7"/>Perciocchè tu mi sei stato <char style="add">in</char> aiuto,</para>
  <para style="q" vid="PSA 63:7">Io giubilo all'ombra delle tue ale.<verse eid="PSA 63:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8"/>L'anima mia è attaccata dietro a te;</para>
  <para style="q" vid="PSA 63:8">La tua destra mi sostiene.<verse eid="PSA 63:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9"/>Ma quelli che cercano l'anima mia, per disertarla,</para>
  <para style="q" vid="PSA 63:9">Entreranno nelle più basse parti della terra.<verse eid="PSA 63:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10"/>Saranno atterrati per la spada;</para>
  <para style="q" vid="PSA 63:10">Saranno la parte delle volpi.<verse eid="PSA 63:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11"/>Ma il re si rallegrerà in Dio;</para>
  <para style="q" vid="PSA 63:11">Chiunque giura per lui<note caller="*" style="x"><char style="xo" closed="false">63.11 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="DEU 6:13">Deut. 6.13</ref>. <ref loc="ISA 45:23">Is. 45.23</ref>.</char></note>, si glorierà;</para>
  <para style="q" vid="PSA 63:11">Perciocchè la bocca di quelli che parlano falsamente sarà turata.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">SALMO LXIV</para>
  <para style="s1">Davide domanda e spera liberazione</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1"/>O DIO, ascolta la mia voce, mentre io <char style="add">fo</char> la mia orazione;</para>
  <para style="q" vid="PSA 64:1">Guarda la vita mia dallo spavento del nemico.<verse eid="PSA 64:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2"/>Nascondimi dal consiglio de' maligni,</para>
  <para style="q" vid="PSA 64:2">
    <char style="add">E</char> dalla turba degli operatori d'iniquità;<verse eid="PSA 64:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3"/>I quali hanno aguzzata la lor lingua come una spada;</para>
  <para style="q" vid="PSA 64:3">
    <char style="add">E in luogo di</char> saette, hanno tratte parole amare;<verse eid="PSA 64:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4"/>Per saettar l'<char style="add">uomo</char> intiero in luoghi nascosti;</para>
  <para style="q" vid="PSA 64:4">Di subito improvviso lo saettano, e non hanno timore alcuno.<verse eid="PSA 64:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5"/>Fermano fra loro pensieri malvagi;</para>
  <para style="q" vid="PSA 64:5">Divisano di tender di nascosto lacci,</para>
  <para style="q" vid="PSA 64:5">Dicono: Chi li vedrà<note caller="*" style="x"><char style="xo" closed="false">64.5 </char><char style="xk" closed="false">vedrà </char><char style="xt" closed="false"><ref loc="PSA 10:11">Sal. 10.11</ref>; <ref loc="PSA 59:7">59.7</ref>. <ref loc="PRO 1:11">Prov. 1.11</ref>.</char></note>?<verse eid="PSA 64:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6"/>Investigano malizie; ricercano tutto ciò che si può investigare;</para>
  <para style="q" vid="PSA 64:6">E <char style="add">quanto può</char> l'interior dell'uomo, ed un cuor cupo.<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7"/>Ma Iddio li saetterà;</para>
  <para style="q" vid="PSA 64:7">Le lor ferite saranno <char style="add">come di</char> saetta subitanea.<verse eid="PSA 64:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8"/>E le lor lingue saranno traboccate sopra loro<note caller="*" style="x"><char style="xo" closed="false">64.8 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PRO 12:13">Prov. 12.13</ref>; <ref loc="PRO 18:7">18.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 64:8">Chiunque li vedrà fuggirà.<verse eid="PSA 64:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9"/>E tutti gli uomini temeranno,</para>
  <para style="q" vid="PSA 64:9">E racconteranno l'opera di Dio;</para>
  <para style="q" vid="PSA 64:9">E considereranno quello ch'egli avrà fatto.<verse eid="PSA 64:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10"/>Il giusto si rallegrerà nel Signore, e spererà in lui;</para>
  <para style="q" vid="PSA 64:10">E tutti quelli che son diritti di cuore, si glorieranno.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">SALMO LXV</para>
  <para style="s1">Lodi e ringraziamenti per i beni ricevuti</para>
  <para style="d">Salmo di cantico di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1"/>O DIO, lode ti aspetta in Sion;</para>
  <para style="q" vid="PSA 65:1">E <char style="add">quivi</char> ti saran pagati i voti.<verse eid="PSA 65:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2"/>
    <char style="add">O tu</char> ch'esaudisci i preghi,</para>
  <para style="q" vid="PSA 65:2">Ogni carne verrà a te.<verse eid="PSA 65:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3"/>Cose inique mi avevano sopraffatto;</para>
  <para style="q" vid="PSA 65:3">Ma tu purghi le nostre trasgressioni<note caller="*" style="x"><char style="xo" closed="false">65.3 </char><char style="xk" closed="false">trasgressioni </char><char style="xt" closed="false"><ref loc="PSA 51:2">Sal. 51.2</ref>; <ref loc="PSA 79:9">79.9</ref>. <ref loc="HEB 9:14">Ebr. 9.14</ref>. <ref loc="1JN 1:7">1 Giov. 1.7</ref>,<ref loc="1JN 1:9">9</ref>.</char></note>.<verse eid="PSA 65:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4"/>Beato colui che tu avrai eletto<note caller="*" style="x"><char style="xo" closed="false">65.4 </char><char style="xk" closed="false">eletto </char><char style="xt" closed="false"><ref loc="PSA 4:3">Sal. 4.3</ref>; <ref loc="PSA 33:12">33.12</ref>; <ref loc="PSA 36:8">36.8</ref>.</char></note>, ed avrai fatto accostare <char style="add">a te</char>.</para>
  <para style="q" vid="PSA 65:4">
    <char style="add">Acciocchè</char> abiti ne' tuoi cortili!</para>
  <para style="q" vid="PSA 65:4">Noi saremo saziati de' beni della tua Casa,</para>
  <para style="q" vid="PSA 65:4">Delle cose sante del tuo Tempio.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5"/>O Dio della nostra salute,</para>
  <para style="q" vid="PSA 65:5">Confidanza di tutte le estremità le più lontane della terra e del mare,</para>
  <para style="q" vid="PSA 65:5">Rispondici, per la <char style="add">tua</char> giustizia, <char style="add">in</char> maniere tremende.<verse eid="PSA 65:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6"/>Esso, colla sua potenza, ferma i monti;</para>
  <para style="q" vid="PSA 65:6">Egli è cinto di forza.<verse eid="PSA 65:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7"/>Egli acqueta il romor de' mari, lo strepito delle sue onde<note caller="*" style="x"><char style="xo" closed="false">65.7 </char><char style="xk" closed="false">onde </char><char style="xt" closed="false"><ref loc="PSA 89:9">Sal. 89.9</ref>; <ref loc="PSA 107:29">107.29</ref>. <ref loc="MAT 8:26">Mat. 8.26</ref>.</char></note>,</para>
  <para style="q" vid="PSA 65:7">E il tumulto de' popoli<note caller="*" style="x"><char style="xo" closed="false">65.7 </char><char style="xk" closed="false">popoli </char><char style="xt" closed="false"><ref loc="ISA 17:12">Is. 17.12</ref>,<ref loc="ISA 17:13">13</ref>.</char></note>.<verse eid="PSA 65:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8"/>Onde quelli che abitano nella estremità <char style="add">della terra</char> temono de' tuoi miracoli:</para>
  <para style="q" vid="PSA 65:8">Tu fai giubilare i luoghi, onde esce la mattina e la sera.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9"/>Tu visiti la terra, e l'abbeveri<note caller="*" style="x"><char style="xo" closed="false">65.9 </char><char style="xk" closed="false">abbeveri </char><char style="xt" closed="false"><ref loc="PSA 104:13">Sal. 104.13</ref>. <ref loc="JER 5:24">Ger. 5.24</ref>.</char></note>;</para>
  <para style="q" vid="PSA 65:9">Tu l'arricchisci grandemente;</para>
  <para style="q" vid="PSA 65:9">I ruscelli di Dio <char style="add">son</char> pieni d'acqua;</para>
  <para style="q" vid="PSA 65:9">Tu apparecchi agli uomini il lor frumento, dopo che tu l'hai così preparata.<verse eid="PSA 65:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10"/>Tu adacqui le sue porche; tu pareggi i suoi solchi;</para>
  <para style="q" vid="PSA 65:10">Tu la stempri colle stille della tua pioggia; tu benedici i suoi germogli;<verse eid="PSA 65:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11"/>Tu coroni de' tuoi beni l'annata;</para>
  <para style="q" vid="PSA 65:11">E le tue orbite stillano grasso.<verse eid="PSA 65:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12"/>Le mandrie del deserto stillano;</para>
  <para style="q" vid="PSA 65:12">E i colli son cinti di gioia.<verse eid="PSA 65:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13"/>Le pianure son rivestite di gregge,</para>
  <para style="q" vid="PSA 65:13">E le valli coperte di biade<note caller="*" style="x"><char style="xo" closed="false">65.13 </char><char style="xk" closed="false">biade </char><char style="xt" closed="false"><ref loc="ISA 55:10-12">Is. 55.10-12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 65:13">Dànno voci di allegrezza, ed anche cantano.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">SALMO LXVI</para>
  <para style="s1">Iddio lodato per le sue grandi opere</para>
  <para style="d">Cantico di salmo, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1"/>DATE voci di allegrezza a Dio,</para>
  <para style="q" vid="PSA 66:1">
    <char style="add">Voi</char> tutti <char style="add">gli abitanti del</char>la terra;<verse eid="PSA 66:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2"/>Salmeggiate la gloria del suo Nome;</para>
  <para style="q" vid="PSA 66:2">Rendete la sua lode gloriosa.<verse eid="PSA 66:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3"/>Dite a Dio: O quanto <char style="add">son</char> tremende le tue opere<note caller="*" style="x"><char style="xo" closed="false">66.3 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="REV 15:3">Apoc. 15.3</ref>.</char></note>!</para>
  <para style="q" vid="PSA 66:3">Per la grandezza della tua forza, i tuoi nemici ti s'infingono.<verse eid="PSA 66:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4"/>Tutta la terra ti adora<note caller="*" style="x"><char style="xo" closed="false">66.4 </char><char style="xk" closed="false">adora </char><char style="xt" closed="false"><ref loc="PSA 22:27">Sal. 22.27</ref>; <ref loc="PSA 67:4">67.4</ref>; <ref loc="PSA 86:9">86.9</ref>.</char></note>, e ti salmeggia;</para>
  <para style="q" vid="PSA 66:4">Salmeggia il tuo Nome. <char style="qs">(Sela.)</char><verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5"/>Venite, e vedete i fatti di Dio;</para>
  <para style="q" vid="PSA 66:5">
    <char style="add">Egli è</char> tremendo <char style="add">in</char> opere, sopra i figliuoli degli uomini.<verse eid="PSA 66:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6"/>Egli convertì <char style="add">già</char> il mare in asciutto;</para>
  <para style="q" vid="PSA 66:6">
    <char style="add">Il suo popolo</char> passò il fiume a piè<note caller="*" style="x"><char style="xo" closed="false">66.6 </char><char style="xk" closed="false">piè </char><char style="xt" closed="false"><ref loc="EXO 14:21">Esod. 14.21</ref>. <ref loc="JOS 3:14-17">Gios. 3.14-17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 66:6">Quivi noi ci rallegrammo in lui.<verse eid="PSA 66:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7"/>Egli, colla sua potenza, signoreggia in eterno;</para>
  <para style="q" vid="PSA 66:7">I suoi occhi riguardano le genti<note caller="*" style="x"><char style="xo" closed="false">66.7 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="PSA 11:4">Sal. 11.4</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 66:7">I ribelli non s'innalzeranno. <char style="qs">(Sela.)</char><verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8"/>
    <char style="add">Voi</char> popoli, benedite il nostro Dio;</para>
  <para style="q" vid="PSA 66:8">E fate risonare il suono della sua lode.<verse eid="PSA 66:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9"/>
    <char style="add">Egli è quel</char> che ha rimessa in vita l'anima nostra;</para>
  <para style="q" vid="PSA 66:9">E non ha permesso che i nostri piedi cadessero<note caller="*" style="x"><char style="xo" closed="false">66.9 </char><char style="xk" closed="false">cadessero </char><char style="xt" closed="false"><ref loc="PSA 121:3">Sal. 121.3</ref>.</char></note>.<verse eid="PSA 66:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10"/>Perciocchè, o Dio, tu ci hai provati;</para>
  <para style="q" vid="PSA 66:10">Tu ci hai posti al cimento<note caller="*" style="x"><char style="xo" closed="false">66.10 </char><char style="xk" closed="false">cimento </char><char style="xt" closed="false"><ref loc="PSA 17:3">Sal. 17.3</ref>. <ref loc="ISA 48:10">Is. 48.10</ref>. <ref loc="ZEC 13:9">Zac. 13.9</ref>. <ref loc="1PE 1:6">1 Piet. 1.6</ref>,<ref loc="1PE 1:7">7</ref>.</char></note>, come si pone l'argento.<verse eid="PSA 66:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11"/>Tu ci avevi fatti entrar nella rete;</para>
  <para style="q" vid="PSA 66:11">Tu avevi posto uno strettoio a' nostri lombi.<verse eid="PSA 66:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12"/>Tu avevi fatto cavalcar gli uomini in sul nostro capo;</para>
  <para style="q" vid="PSA 66:12">Eravamo entrati nel fuoco e nell'acqua<note caller="*" style="x"><char style="xo" closed="false">66.12 </char><char style="xk" closed="false">acqua </char><char style="xt" closed="false"><ref loc="ISA 43:2">Is. 43.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 66:12">Ma tu ci hai tratti fuori in <char style="add">luogo di</char> refrigerio.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13"/>Io entrerò nella tua Casa con olocausti;</para>
  <para style="q" vid="PSA 66:13">Io ti pagherò i miei voti<note caller="*" style="x"><char style="xo" closed="false">66.13 </char><char style="xk" closed="false">voti </char><char style="xt" closed="false"><ref loc="ECC 5:4">Eccl. 5.4</ref>.</char></note>;<verse eid="PSA 66:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14"/>I quali le mie labbra han proferiti,</para>
  <para style="q" vid="PSA 66:14">E la mia bocca ha pronunziati, mentre io era distretto.<verse eid="PSA 66:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15"/>Io ti offerirò olocausti di <char style="add">bestie</char> grasse,</para>
  <para style="q" vid="PSA 66:15">Con profumo di montoni;</para>
  <para style="q" vid="PSA 66:15">Io sacrificherò buoi e becchi. <char style="qs">(Sela.)</char><verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16"/>Venite, <char style="add">voi</char> tutti che temete Iddio, <char style="add">ed</char> udite;</para>
  <para style="q" vid="PSA 66:16">Io <char style="add">vi</char> racconterò quello ch'egli ha fatto all'anima mia<note caller="*" style="x"><char style="xo" closed="false">66.16 </char><char style="xk" closed="false">mia </char><char style="xt" closed="false"><ref loc="PSA 34:11">Sal. 34.11</ref>.</char></note>.<verse eid="PSA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 66:17"/>Io gridai a lui colla mia bocca,</para>
  <para style="q" vid="PSA 66:17">Ed egli fu esaltato sotto la mia lingua.<verse eid="PSA 66:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18"/>Se io avessi mirato ad alcuna iniquità nel mio cuore,</para>
  <para style="q" vid="PSA 66:18">Il Signore non <char style="add">mi</char> avrebbe ascoltato<note caller="*" style="x"><char style="xo" closed="false">66.18 </char><char style="xk" closed="false">ascoltato </char><char style="xt" closed="false"><ref loc="PRO 15:29">Prov. 15.29</ref>; <ref loc="PRO 28:9">28.9</ref>. <ref loc="ISA 1:15">Is. 1.15</ref>. <ref loc="JHN 9:31">Giov. 9.31</ref>. <ref loc="JAS 4:3">Giac. 4.3</ref>.</char></note>;<verse eid="PSA 66:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19"/>Ma certo Iddio mi ha ascoltato,</para>
  <para style="q" vid="PSA 66:19">Egli ha atteso alla voce della mia orazione.<verse eid="PSA 66:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20"/>Benedetto <char style="add">sia</char> Iddio</para>
  <para style="q" vid="PSA 66:20">Che non ha rigettata la mia orazione,</para>
  <para style="q" vid="PSA 66:20">Nè <char style="add">ritratta</char> da me la sua benignità.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">SALMO LXVII</para>
  <para style="s1">Il regno di Dio si estenderà per tutta la terra</para>
  <para style="d">Salmo di cantico, <char style="add">dato</char> al Capo de' Musici, sopra Neghinot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1"/>IDDIO abbia mercè di noi, e ci benedica;</para>
  <para style="q" vid="PSA 67:1">
    <char style="add">Iddio</char> faccia risplendere il suo volto verso noi<note caller="*" style="x"><char style="xo" closed="false">67.1 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="NUM 6:25">Num. 6.25</ref> </char><char style="xta" closed="false">e rif.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 67:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2"/>Acciocchè la tua via si conosca in terra,</para>
  <para style="q" vid="PSA 67:2">
    <char style="add">E</char> la tua salute fra tutte le genti<note caller="*" style="x"><char style="xo" closed="false">67.2 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="LUK 2:30">Luc. 2.30</ref>,<ref loc="LUK 2:31">31</ref>. <ref loc="TIT 2:11">Tit. 2.11</ref>.</char></note>.<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3"/>I popoli ti celebreranno, o Dio;</para>
  <para style="q" vid="PSA 67:3">I popoli tutti quanti ti celebreranno.<verse eid="PSA 67:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4"/>Le nazioni si rallegreranno, e giubileranno;</para>
  <para style="q" vid="PSA 67:4">Perciocchè tu giudicherai i popoli dirittamente,</para>
  <para style="q" vid="PSA 67:4">E condurrai le nazioni nella terra. <char style="qs">(Sela.)</char><verse eid="PSA 67:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5"/>I popoli ti celebreranno, o Dio;</para>
  <para style="q" vid="PSA 67:5">I popoli tutti quanti ti celebreranno.<verse eid="PSA 67:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6"/>La terra produrrà il suo frutto<note caller="*" style="x"><char style="xo" closed="false">67.6 </char><char style="xk" closed="false">frutto </char><char style="xt" closed="false"><ref loc="LEV 26:4">Lev. 26.4</ref>. <ref loc="EZK 34:27">Ezec. 34.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 67:6">Iddio, l'Iddio nostro ci benedirà.<verse eid="PSA 67:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7"/>Iddio ci benedirà;</para>
  <para style="q" vid="PSA 67:7">E tutte le estremità della terra lo temeranno.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">SALMO LXVIII</para>
  <para style="s1">Lodi e ringraziamenti all'Iddio liberatore</para>
  <para style="d">Salmo di cantico di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1"/>LEVISI Iddio<note caller="*" style="x"><char style="xo" closed="false">68.1 </char><char style="xk" closed="false">Iddio </char><char style="xt" closed="false"><ref loc="NUM 10:35">Num. 10.35</ref>. <ref loc="ISA 33:3">Is. 33.3</ref>.</char></note>, e i suoi nemici saranno dispersi;</para>
  <para style="q" vid="PSA 68:1">E quelli che l'odiano fuggiranno d'innanzi al suo cospetto.<verse eid="PSA 68:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2"/>Tu li dissiperai come si dissipa il fumo<note caller="*" style="x"><char style="xo" closed="false">68.2 </char><char style="xk" closed="false">fumo </char><char style="xt" closed="false"><ref loc="ISA 9:18">Is. 9.18</ref>. <ref loc="HOS 13:3">Os. 13.3</ref>.</char></note>;</para>
  <para style="q" vid="PSA 68:2">Gli empi periranno per la presenza di Dio,</para>
  <para style="q" vid="PSA 68:2">Come la cera è strutta per lo fuoco.<verse eid="PSA 68:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3"/>Ma i giusti si rallegreranno<note caller="*" style="x"><char style="xo" closed="false">68.3 </char><char style="xk" closed="false">rallegreranno </char><char style="xt" closed="false"><ref loc="PSA 32:11">Sal. 32.11</ref>; <ref loc="PSA 64:10">64.10</ref>.</char></note>, <char style="add">e</char> trionferanno nel cospetto di Dio;</para>
  <para style="q" vid="PSA 68:3">E gioiranno con letizia.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4"/>Cantate a Dio, salmeggiate il suo Nome,</para>
  <para style="q" vid="PSA 68:4">Rilevate le strade a colui che cavalca per luoghi deserti;</para>
  <para style="q" vid="PSA 68:4">Egli si chiama per nome: Il Signore; e festeggiate davanti a lui.<verse eid="PSA 68:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5"/>
    <char style="add">Egli è</char> il padre degli orfani, e il giudice delle vedove<note caller="*" style="x"><char style="xo" closed="false">68.5 </char><char style="xk" closed="false">vedove </char><char style="xt" closed="false"><ref loc="PSA 10:14">Sal. 10.14</ref>,<ref loc="PSA 10:18">18</ref>; <ref loc="PSA 146:9">146.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 68:5">Iddio nell'abitacolo della sua santità;<verse eid="PSA 68:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6"/>Iddio, che fa abitare in famiglia quelli ch'erano soli<note caller="*" style="x"><char style="xo" closed="false">68.6 </char><char style="xk" closed="false">soli </char><char style="xt" closed="false"><ref loc="1SA 2:5">1 Sam. 2.5</ref>. <ref loc="PSA 113:9">Sal. 113.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 68:6">Che trae fuori quelli ch'erano prigioni ne' ceppi<note caller="*" style="x"><char style="xo" closed="false">68.6 </char><char style="xk" closed="false">ceppi </char><char style="xt" closed="false"><ref loc="PSA 146:7">Sal. 146.7</ref>. <ref loc="ACT 12:5">Fat. 12.5</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 68:6">Ma <char style="add">fa' che</char> i ribelli dimorano in terra deserta<note caller="*" style="x"><char style="xo" closed="false">68.6 </char><char style="xk" closed="false">deserta </char><char style="xt" closed="false"><ref loc="PSA 107:34">Sal. 107.34</ref>,<ref loc="PSA 107:40">40</ref>.</char></note>.<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7"/>O Dio, quando tu uscisti davanti al tuo popolo,</para>
  <para style="q" vid="PSA 68:7">Quando tu camminasti per lo deserto<note caller="*" style="x"><char style="xo" closed="false">68.7 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="EXO 13:21">Esod. 13.21</ref>.</char></note>; <char style="qs">(Sela.)</char><verse eid="PSA 68:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8"/>La terra tremò, i cieli eziandio gocciolarono, per la presenza di Dio;</para>
  <para style="q" vid="PSA 68:8">Sinai stesso, per la presenza di Dio, dell'Iddio d'Israele<note caller="*" style="x"><char style="xo" closed="false">68.8 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="EXO 19:16">Esod. 19.16</ref>,<ref loc="EXO 19:18">18</ref>. <ref loc="JDG 5:4">Giud. 5.4</ref>,<ref loc="JDG 5:5">5</ref>. <ref loc="ISA 64:1">Is. 64.1</ref> ecc.</char></note>.<verse eid="PSA 68:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9"/>O Dio, tu spandi la pioggia delle liberalità sopra la tua eredità;</para>
  <para style="q" vid="PSA 68:9">E, quando è travagliata, tu la ristori.<verse eid="PSA 68:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10"/>In essa dimora il tuo stuolo;</para>
  <para style="q" vid="PSA 68:10">O Dio, per la tua bontà, tu <char style="add">l</char>'hai apparecchiata per i poveri afflitti<note caller="*" style="x"><char style="xo" closed="false">68.10 </char><char style="xk" closed="false">afflitti </char><char style="xt" closed="false"><ref loc="DEU 26:5-9">Deut. 26.5-9</ref>. <ref loc="PSA 65:9">Sal. 65.9</ref>.</char></note>.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11"/>Il Signore ha dato materia di parlare;</para>
  <para style="q" vid="PSA 68:11">Quelle che hanno recate le buone novelle, sono state una grande schiera.<verse eid="PSA 68:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12"/>Fuggiti, fuggiti se ne sono i re degli eserciti<note caller="*" style="x"><char style="xo" closed="false">68.12 </char><char style="xk" closed="false">eserciti </char><char style="xt" closed="false"><ref loc="NUM 31:8">Num. 31.8</ref>,<ref loc="NUM 31:9">9</ref>. <ref loc="JOS 10:16">Gios. 10.16</ref>.</char></note>;</para>
  <para style="q" vid="PSA 68:12">E quelle che dimoravano in casa hanno spartite le spoglie.<verse eid="PSA 68:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13"/>Quando giacerete in mezzo agli ovili,</para>
  <para style="q" vid="PSA 68:13">
    <char style="add">Sarete come</char> le ale di una colomba, coperta d'argento,</para>
  <para style="q" vid="PSA 68:13">Le cui penne son gialle d'oro.<verse eid="PSA 68:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14"/>Dopo che l'Onnipotente ebbe dispersi i re in quella<note caller="*" style="x"><char style="xo" closed="false">68.14 </char><char style="xk" closed="false">quella </char><char style="xt" closed="false"><ref loc="NUM 21:3">Num. 21.3</ref>. <ref loc="JOS 10:10">Gios. 10.10</ref>; <ref loc="JOS 12:1">12.1</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 68:14">
    <char style="add">La terra fu come quando</char> è nevicato in Salmon.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15"/>O monte di Dio, o monte di Basan,</para>
  <para style="q" vid="PSA 68:15">O monte di <char style="add">molti</char> gioghi, o monte di Basan!<verse eid="PSA 68:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16"/>Perchè saltellate voi, o monti di <char style="add">molti</char> gioghi?</para>
  <para style="q" vid="PSA 68:16">Iddio desidera questo monte per sua stanza<note caller="*" style="x"><char style="xo" closed="false">68.16 </char><char style="xk" closed="false">stanza </char><char style="xt" closed="false"><ref loc="1KI 9:3">1 Re. 9.3</ref>. <ref loc="PSA 132:13">Sal. 132.13</ref>,<ref loc="PSA 132:14">14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 68:16">Anzi il Signore abiterà <char style="add">quivi</char> in perpetuo.<verse eid="PSA 68:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17"/>La cavalleria di Dio <char style="add">cammina</char> a doppie decine di migliaia<note caller="*" style="x"><char style="xo" closed="false">68.17 </char><char style="xk" closed="false">migliaia </char><char style="xt" closed="false"><ref loc="DEU 33:2">Deut. 33.2</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 68:17">A doppie migliaia;</para>
  <para style="q" vid="PSA 68:17">Il Signore <char style="add">è</char> fra essi; Sinai <char style="add">è</char> nel santuario.<verse eid="PSA 68:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18"/>Tu sei salito in alto<note caller="*" style="x"><char style="xo" closed="false">68.18 </char><char style="xk" closed="false">alto </char><char style="xt" closed="false"><ref loc="ACT 1:9">Fat. 1.9</ref>. <ref loc="EPH 4:8">Efes. 4.8</ref>.</char></note>, tu ne hai menato in cattività numero di prigioni;</para>
  <para style="q" vid="PSA 68:18">Tu hai presi doni d'infra gli uomini,</para>
  <para style="q" vid="PSA 68:18">Eziandio ribelli<note caller="*" style="x"><char style="xo" closed="false">68.18 </char><char style="xk" closed="false">ribelli </char><char style="xt" closed="false"><ref loc="1TI 1:13">1 Tim. 1.13</ref>.</char></note>, per far <char style="add">ora</char> una ferma dimora, o Signore Iddio.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19"/>Benedetto <char style="add">sia</char> il Signore, <char style="add">il quale</char> ogni giorno ci colma <char style="add">di beni</char>;</para>
  <para style="q" vid="PSA 68:19">
    <char style="add">Egli è</char> l'Iddio della nostra salute. <char style="qs">(Sela.)</char><verse eid="PSA 68:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20"/>Iddio <char style="add">è</char> l'Iddio nostro, per salvarci;</para>
  <para style="q" vid="PSA 68:20">Ed al Signore Iddio <char style="add">appartengono</char> le uscite della morte<note caller="*" style="x"><char style="xo" closed="false">68.20 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="DEU 32:39">Deut. 32.39</ref>. <ref loc="REV 1:18">Apoc. 1.18</ref>.</char></note>.<verse eid="PSA 68:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21"/>Certo Iddio trafiggerà il capo de' suoi nemici.</para>
  <para style="q" vid="PSA 68:21">La sommità del capo irsuto di chi cammina ne' suoi peccati.<verse eid="PSA 68:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22"/>Il Signore ha detto: Io <char style="add">ti</char> trarrò di Basan<note caller="*" style="x"><char style="xo" closed="false">68.22 </char><char style="xk" closed="false">Basan </char><char style="xt" closed="false"><ref loc="NUM 21:33">Num. 21.33</ref>.</char></note>,</para>
  <para style="q" vid="PSA 68:22">
    <char style="add">Ti</char> trarrò dal fondo del mare<note caller="*" style="x"><char style="xo" closed="false">68.22 </char><char style="xk" closed="false">mare </char><char style="xt" closed="false"><ref loc="EXO 14:22">Esod. 14.22</ref> ecc.</char></note>;<verse eid="PSA 68:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23"/>Acciocchè il tuo piè, <char style="add">e</char> la lingua de' tuoi cani</para>
  <para style="q" vid="PSA 68:23">Si affondi nel sangue de' nemici, e del <char style="add">capo stesso</char>.<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24"/>O Dio, le tue andature si son vedute;</para>
  <para style="q" vid="PSA 68:24">Le andature dell'Iddio, <char style="add">e</char> Re mio, nel <char style="add">luogo</char> santo.<verse eid="PSA 68:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25"/>Cantori andavano innanzi, e sonatori dietro<note caller="*" style="x"><char style="xo" closed="false">68.25 </char><char style="xk" closed="false">dietro </char><char style="xt" closed="false"><ref loc="1CH 13:8">1 Cron. 13.8</ref>; <ref loc="1CH 15:16">15.16</ref>.</char></note>;</para>
  <para style="q" vid="PSA 68:25">E nel mezzo vergini che sonavano tamburi, <char style="add">dicendo:</char><verse eid="PSA 68:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26"/>Benedite Iddio nelle raunanze;</para>
  <para style="q" vid="PSA 68:26">
    <char style="add">Benedite</char> il Signore, <char style="add">voi che siete</char> della fonte d'Israele.<verse eid="PSA 68:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27"/>Ivi <char style="add">era</char> il piccolo Beniamino<note caller="*" style="x"><char style="xo" closed="false">68.27 </char><char style="xk" closed="false">Beniamino </char><char style="xt" closed="false"><ref loc="1SA 9:21">1 Sam. 9.21</ref>.</char></note>, che ha signoreggiato sopra essi;</para>
  <para style="q" vid="PSA 68:27">I capi di Giuda, colle loro schiere;</para>
  <para style="q" vid="PSA 68:27">I capi di Zabulon, i capi di Neftali.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28"/>L'Iddio tuo ha ordinata la tua fortezza;</para>
  <para style="q" vid="PSA 68:28">Rinforza, o Dio, ciò che tu hai operato inverso noi.<verse eid="PSA 68:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29"/>Rinforzalo dal tuo Tempio, di sopra a Gerusalemme;</para>
  <para style="q" vid="PSA 68:29">
    <char style="add">Fa' che</char> i re ti portino presenti<note caller="*" style="x"><char style="xo" closed="false">68.29 </char><char style="xk" closed="false">presenti </char><char style="xt" closed="false"><ref loc="1KI 10:10">1 Re. 10.10</ref>,<ref loc="1KI 10:24">24</ref>,<ref loc="1KI 10:25">25</ref>. <ref loc="2CH 32:23">2 Cron. 32.23</ref>.</char></note>.<verse eid="PSA 68:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30"/>Disperdi le fiere delle giuncaie,</para>
  <para style="q" vid="PSA 68:30">La raunanza de' possenti tori, e i giovenchi d'infra i popoli,</para>
  <para style="q" vid="PSA 68:30">I quali si prostrano con monete d'argento;</para>
  <para style="q" vid="PSA 68:30">Dissipa i popoli <char style="add">che</char> si dilettano in guerre.<verse eid="PSA 68:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31"/>Vengano gran signori di Egitto<note caller="*" style="x"><char style="xo" closed="false">68.31 </char><char style="xk" closed="false">Egitto </char><char style="xt" closed="false"><ref loc="ISA 19:19">Is. 19.19</ref>,<ref loc="ISA 19:21">21</ref>; <ref loc="ISA 45:14">45.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 68:31">Accorrano gli Etiopi a Dio<note caller="*" style="x"><char style="xo" closed="false">68.31 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="ZEP 3:10">Sof. 3.10</ref>. <ref loc="ACT 8:27">Fat. 8.27</ref>.</char></note>, colle mani <char style="add">piene</char>.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32"/>O regni della terra, cantate a Dio;</para>
  <para style="q" vid="PSA 68:32">Salmeggiate al Signore; <char style="qs">(Sela.)</char><verse eid="PSA 68:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33"/>A colui che cavalca sopra i cieli de' cieli eterni;</para>
  <para style="q" vid="PSA 68:33">Ecco, egli tuona potentemente colla sua voce<note caller="*" style="x"><char style="xo" closed="false">68.33 </char><char style="xk" closed="false">voce </char><char style="xt" closed="false"><ref loc="PSA 29:3">Sal. 29.3</ref> ecc.</char></note>.<verse eid="PSA 68:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34"/>Date gloria a Dio;</para>
  <para style="q" vid="PSA 68:34">La sua magnificenza <char style="add">è</char> sopra Israele, e la sua gloria ne' cieli.<verse eid="PSA 68:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35"/>O Dio, <char style="add">tu sei</char> tremendo da' tuoi santuari;</para>
  <para style="q" vid="PSA 68:35">L'Iddio d'Israele è quel che dà valore e forze al popolo.</para>
  <para style="q" vid="PSA 68:35">Benedetto <char style="add">sia</char> Iddio.<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">SALMO LXIX</para>
  <para style="s1">Estreme sofferenze di Davide, raffiguranti quelle del Messia</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide, <char style="add">dato</char> al Capo de' Musici, sopra Sosannim</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1"/>SALVAMI, o Dio;</para>
  <para style="q" vid="PSA 69:1">Perciocchè le acque son pervenute infino all'anima.<verse eid="PSA 69:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2"/>Io sono affondato in un profondo pantano<note caller="*" style="x"><char style="xo" closed="false">69.2 </char><char style="xk" closed="false">pantano </char><char style="xt" closed="false"><ref loc="PSA 40:2">Sal. 40.2</ref>. <ref loc="JON 2:4">Gion. 2.4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 69:2">Ove non <char style="add">vi è luogo</char> da fermare <char style="add">il piè</char>;</para>
  <para style="q" vid="PSA 69:2">Io son giunto alle profondità dell'acqua, e la corrente m'inonda.<verse eid="PSA 69:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3"/>Io sono stanco di gridare<note caller="*" style="x"><char style="xo" closed="false">69.3 </char><char style="xk" closed="false">gridare </char><char style="xt" closed="false"><ref loc="PSA 6:6">Sal. 6.6</ref>.</char></note>, io ho la gola asciutta;</para>
  <para style="q" vid="PSA 69:3">Gli occhi mi son venuti meno, aspettando l'Iddio mio.<verse eid="PSA 69:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4"/>Quelli che mi odiano senza cagione</para>
  <para style="q" vid="PSA 69:4">Sono in maggior numero che i capelli del mio capo;</para>
  <para style="q" vid="PSA 69:4">Quelli che mi disertano, <char style="add">e</char> che mi sono nemici a torto<note caller="*" style="x"><char style="xo" closed="false">69.4 </char><char style="xk" closed="false">torto </char><char style="xt" closed="false"><ref loc="JHN 15:24">Giov. 15.24</ref>,<ref loc="JHN 15:25">25</ref>.</char></note>, si fortificano;</para>
  <para style="q" vid="PSA 69:4">Ecco là, io ho renduto ciò che non aveva rapito.<verse eid="PSA 69:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5"/>O Dio, tu conosci la mia follia;</para>
  <para style="q" vid="PSA 69:5">E le mie colpe non ti sono occulte.<verse eid="PSA 69:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6"/>O Signore, Dio degli eserciti,</para>
  <para style="q" vid="PSA 69:6">Quelli che sperano in te non sieno confusi per cagion di me;</para>
  <para style="q" vid="PSA 69:6">Quelli che ti cercano non sieno svergognati per me,</para>
  <para style="q" vid="PSA 69:6">O Dio d'Israele.<verse eid="PSA 69:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7"/>Perciocchè per l'amor di te io soffro vituperio;</para>
  <para style="q" vid="PSA 69:7">Vergogna mi ha coperta la faccia.<verse eid="PSA 69:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8"/>Io son divenuto strano a' miei fratelli,</para>
  <para style="q" vid="PSA 69:8">E forestiere a' figliuoli di mia madre<note caller="*" style="x"><char style="xo" closed="false">69.8 </char><char style="xk" closed="false">madre </char><char style="xt" closed="false"><ref loc="ISA 53:3">Is. 53.3</ref>. <ref loc="JHN 1:11">Giov. 1.11</ref>; <ref loc="JHN 7:5">7.5</ref>.</char></note>.<verse eid="PSA 69:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9"/>Perciocchè lo zelo della tua Casa mi ha roso<note caller="*" style="x"><char style="xo" closed="false">69.9 </char><char style="xk" closed="false">roso </char><char style="xt" closed="false"><ref loc="PSA 119:139">Sal. 119.139</ref>. <ref loc="JHN 2:17">Giov. 2.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:9">E i vituperii di quelli che ti fanno vituperio mi caggiono addosso<note caller="*" style="x"><char style="xo" closed="false">69.9 </char><char style="xk" closed="false">addosso </char><char style="xt" closed="false"><ref loc="PSA 89:50">Sal. 89.50</ref>,<ref loc="PSA 89:51">51</ref>. <ref loc="ROM 15:3">Rom. 15.3</ref>.</char></note>.<verse eid="PSA 69:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10"/>Io ho pianto, <char style="add">affliggendo</char> l'anima mia col digiuno;</para>
  <para style="q" vid="PSA 69:10">Ma <char style="add">ciò</char> mi è tornato in grande obbrobrio.<verse eid="PSA 69:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11"/>Ancora ho fatto d'un sacco il mio vestimento;</para>
  <para style="q" vid="PSA 69:11">Ma son loro stato in proverbio<note caller="*" style="x"><char style="xo" closed="false">69.11 </char><char style="xk" closed="false">proverbio </char><char style="xt" closed="false"><ref loc="1KI 9:7">1 Re. 9.7</ref>. <ref loc="JER 24:9">Ger. 24.9</ref>.</char></note>.<verse eid="PSA 69:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12"/>Quelli che seggono nella porta ragionano di me;</para>
  <para style="q" vid="PSA 69:12">E le canzoni de' bevitori di cervogia <char style="add">ne</char> parlano.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13"/>Ma quant'è a me, o Signore, la mia orazione <char style="add">s'indirizza</char> a te;</para>
  <para style="q" vid="PSA 69:13">
    <char style="add">Egli vi è</char> un tempo di benevolenza<note caller="*" style="x"><char style="xo" closed="false">69.13 </char><char style="xk" closed="false">benevolenza </char><char style="xt" closed="false"><ref loc="ISA 49:8">Is. 49.8</ref>; <ref loc="ISA 55:6">55.6</ref>. <ref loc="2CO 6:2">2 Cor. 6.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:13">O Dio, per la grandezza della tua benignità,</para>
  <para style="q" vid="PSA 69:13">E per la verità della tua salute, rispondimi.<verse eid="PSA 69:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14"/>Tirami fuor del pantano, che io non vi affondi,</para>
  <para style="q" vid="PSA 69:14">
    <char style="add">E</char> che io sia riscosso da quelli che mi hanno in odio,</para>
  <para style="q" vid="PSA 69:14">Dalle profondità delle acque;<verse eid="PSA 69:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15"/>Che la corrente delle acque non m'inondi,</para>
  <para style="q" vid="PSA 69:15">E che il gorgo non mi tranghiotta,</para>
  <para style="q" vid="PSA 69:15">E che il pozzo non turi sopra me la sua bocca<note caller="*" style="x"><char style="xo" closed="false">69.15 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="NUM 16:33">Num. 16.33</ref>.</char></note>.<verse eid="PSA 69:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16"/>Rispondimi, o Signore; perciocchè la tua benignità <char style="add">è</char> buona<note caller="*" style="x"><char style="xo" closed="false">69.16 </char><char style="xk" closed="false">buona </char><char style="xt" closed="false"><ref loc="PSA 63:3">Sal. 63.3</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 69:16">Secondo la grandezza delle tue compassioni riguarda verso me.<verse eid="PSA 69:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17"/>E non nascondere il tuo volto dal tuo servo<note caller="*" style="x"><char style="xo" closed="false">69.17 </char><char style="xk" closed="false">servo </char><char style="xt" closed="false"><ref loc="PSA 27:9">Sal. 27.9</ref>; <ref loc="PSA 102:2">102.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:17">Perciocchè io son distretto; affrettati, rispondimi.<verse eid="PSA 69:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18"/>Accostati all'anima mia, riscattala;</para>
  <para style="q" vid="PSA 69:18">Riscuotimi, per cagion de' miei nemici.<verse eid="PSA 69:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19"/>Tu conosci il vituperio, l'onta, e la vergogna che mi è fatta<note caller="*" style="x"><char style="xo" closed="false">69.19 </char><char style="xk" closed="false">fatta </char><char style="xt" closed="false"><ref loc="PSA 22:6">Sal. 22.6</ref>,<ref loc="PSA 22:7">7</ref>. <ref loc="ISA 53:3">Is. 53.3</ref>. <ref loc="MAT 27:29">Mat. 27.29</ref>. <ref loc="HEB 12:2">Ebr. 12.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:19">Tutti i miei nemici <char style="add">son</char> davanti a te.<verse eid="PSA 69:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20"/>Il vituperio mi ha rotto il cuore, e io son tutto dolente;</para>
  <para style="q" vid="PSA 69:20">Ed ho aspettato che alcuno si condolesse meco, ma non <char style="add">vi è stato</char> alcuno;</para>
  <para style="q" vid="PSA 69:20">Ed <char style="add">ho aspettati</char> de' consolatori, ma non <char style="add">ne</char> ho trovati<note caller="*" style="x"><char style="xo" closed="false">69.20 </char><char style="xk" closed="false">trovati </char><char style="xt" closed="false"><ref loc="PSA 142:4">Sal. 142.4</ref>. <ref loc="MAT 26:37">Mat. 26.37</ref> ecc.</char></note>.<verse eid="PSA 69:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21"/>Hanno, oltre a ciò, messo del veleno nella mia vivanda;</para>
  <para style="q" vid="PSA 69:21">E, nella mia sete, mi hanno dato a bere dell'aceto<note caller="*" style="x"><char style="xo" closed="false">69.21 </char><char style="xk" closed="false">aceto </char><char style="xt" closed="false"><ref loc="MAT 27:34">Mat. 27.34</ref>,<ref loc="MAT 27:48">48</ref>.</char></note>.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22"/>Sia la lor mensa un laccio <char style="add">teso</char> davanti a loro;</para>
  <para style="q" vid="PSA 69:22">E le lor prosperità <char style="add">sieno loro</char> una trappola<note caller="*" style="x"><char style="xo" closed="false">69.22 </char><char style="xk" closed="false">trappola </char><char style="xt" closed="false"><ref loc="PSA 35:4">Sal. 35.4</ref> ecc.; <ref loc="PSA 109:6">109.6</ref> ecc. <ref loc="ROM 11:9">Rom. 11.9</ref>,<ref loc="ROM 11:10">10</ref>.</char></note>.<verse eid="PSA 69:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23"/>Gli occhi loro sieno oscurati, sì che non possano vedere<note caller="*" style="x"><char style="xo" closed="false">69.23 </char><char style="xk" closed="false">vedere </char><char style="xt" closed="false"><ref loc="ISA 6:9">Is. 6.9</ref>,<ref loc="ISA 6:10">10</ref>. <ref loc="2CO 3:14">2 Cor. 3.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:23">E fa' loro del continuo vacillare i lombi.<verse eid="PSA 69:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24"/>Spandi l'ira tua sopra loro,</para>
  <para style="q" vid="PSA 69:24">E colgali l'ardor del tuo cruccio<note caller="*" style="x"><char style="xo" closed="false">69.24 </char><char style="xk" closed="false">cruccio </char><char style="xt" closed="false"><ref loc="1TH 2:16">1 Tess. 2.16</ref>.</char></note>.<verse eid="PSA 69:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25"/>Sieno desolati i lor palazzi;</para>
  <para style="q" vid="PSA 69:25">Ne' lor tabernacoli non vi sia alcuno abitatore<note caller="*" style="x"><char style="xo" closed="false">69.25 </char><char style="xk" closed="false">abitatore </char><char style="xt" closed="false"><ref loc="MAT 23:38">Mat. 23.38</ref>. <ref loc="ACT 1:20">Fat. 1.20</ref>.</char></note>.<verse eid="PSA 69:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26"/>Perciocchè hanno perseguitato colui che tu hai percosso<note caller="*" style="x"><char style="xo" closed="false">69.26 </char><char style="xk" closed="false">percosso </char><char style="xt" closed="false"><ref loc="ISA 53:3">Is. 53.3</ref>,<ref loc="ISA 53:4">4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 69:26">E fatte le lor favole del dolore di coloro che tu hai feriti.<verse eid="PSA 69:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27"/>Aggiugni loro iniquità sopra iniquità<note caller="*" style="x"><char style="xo" closed="false">69.27 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="ROM 1:28">Rom. 1.28</ref>,<ref loc="ROM 1:29">29</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:27">E non abbiano giammai entrata alla tua giustizia.<verse eid="PSA 69:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28"/>Sieno cancellati dal libro della vita<note caller="*" style="x"><char style="xo" closed="false">69.28 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="EXO 32:32">Esod. 32.32</ref>. <ref loc="PHP 4:3">Fil. 4.3</ref>. <ref loc="REV 3:5">Apoc. 3.5</ref>; <ref loc="REV 13:8">13.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:28">E non sieno scritti co' giusti<note caller="*" style="x"><char style="xo" closed="false">69.28 </char><char style="xk" closed="false">giusti </char><char style="xt" closed="false"><ref loc="LUK 10:20">Luc. 10.20</ref>. <ref loc="HEB 12:23">Ebr. 12.23</ref>.</char></note>.<verse eid="PSA 69:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29"/>Ora, quant'è a me, io <char style="add">sono</char> afflitto e addolorato;</para>
  <para style="q" vid="PSA 69:29">La tua salute, o Dio, mi levi ad alto.<verse eid="PSA 69:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30"/>Io loderò il Nome di Dio con cantici,</para>
  <para style="q" vid="PSA 69:30">E lo magnificherò con lode.<verse eid="PSA 69:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31"/>E <char style="add">ciò</char> sarà più accettevole al Signore, che bue,</para>
  <para style="q" vid="PSA 69:31">
    <char style="add">Che</char> giovenco con corna ed unghie<note caller="*" style="x"><char style="xo" closed="false">69.31 </char><char style="xk" closed="false">unghie </char><char style="xt" closed="false"><ref loc="PSA 50:13">Sal. 50.13</ref>,<ref loc="PSA 50:14">14</ref>,<ref loc="PSA 50:23">23</ref>.</char></note>.<verse eid="PSA 69:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32"/>I mansueti, vedendo <char style="add">ciò</char>, si rallegreranno;</para>
  <para style="q" vid="PSA 69:32">Ed il cuor vostro viverà, <char style="add">o voi</char> che cercate Iddio.<verse eid="PSA 69:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33"/>Perciocchè il Signore esaudisce i bisognosi,</para>
  <para style="q" vid="PSA 69:33">E non isprezza i suoi prigioni<note caller="*" style="x"><char style="xo" closed="false">69.33 </char><char style="xk" closed="false">prigioni </char><char style="xt" closed="false"><ref loc="PSA 68:6">Sal. 68.6</ref>. <ref loc="EPH 3:1">Efes. 3.1</ref>.</char></note>.<verse eid="PSA 69:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34"/>Lodinlo i cieli e la terra<note caller="*" style="x"><char style="xo" closed="false">69.34 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="ISA 44:23">Is. 44.23</ref>; <ref loc="ISA 49:13">49.13</ref>; <ref loc="ISA 55:12">55.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 69:34">I mari, e tutto ciò che in essi guizza.<verse eid="PSA 69:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35"/>Perciocchè Iddio salverà Sion, ed edificherà le città di Giuda;</para>
  <para style="q" vid="PSA 69:35">E <char style="add">coloro</char> vi abiteranno, e possederanno Sion per eredità.<verse eid="PSA 69:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36"/>E la progenie de' suoi servitori l'erederà;</para>
  <para style="q" vid="PSA 69:36">E quelli che amano il suo Nome abiteranno in essa.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">SALMO LXX</para>
  <para style="s1">Davide chiede aiuto al Signore</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide, da rammemorare; <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1"/>O DIO, <char style="add">affrettati</char> a liberarmi<note caller="*" style="x"><char style="xo" closed="false">70.1 </char><char style="xk" closed="false">liberarmi </char><char style="xt" closed="false"><ref loc="PSA 40:13">Sal. 40.13</ref> ecc.; <ref loc="PSA 71:12">71.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 70:1">O Signore, affrettati in mio aiuto.<verse eid="PSA 70:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2"/>Quelli che cercano l'anima mia sien confusi e svergognati;</para>
  <para style="q" vid="PSA 70:2">Quelli che prendono piacere nel mio male voltin le spalle,</para>
  <para style="q" vid="PSA 70:2">E sieno svergognati.<verse eid="PSA 70:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3"/>Quelli che dicono: Eia, eia!</para>
  <para style="q" vid="PSA 70:3">Voltin le spalle, per ricompensa del vituperio che mi fanno.<verse eid="PSA 70:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4"/>Rallegrinsi, e gioiscano in te</para>
  <para style="q" vid="PSA 70:4">Tutti quelli che ti cercano;</para>
  <para style="q" vid="PSA 70:4">E quelli che amano la tua salute</para>
  <para style="q" vid="PSA 70:4">Dicano del continuo: Magnificato sia Iddio.<verse eid="PSA 70:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5"/>Ora, quant'è a me, io son povero e bisognoso;</para>
  <para style="q" vid="PSA 70:5">O Dio, affrettati <char style="add">a venire</char> a me;</para>
  <para style="q" vid="PSA 70:5">Tu <char style="add">sei</char> il mio aiuto, ed il mio liberatore;</para>
  <para style="q" vid="PSA 70:5">O Signore, non tardare.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">SALMO LXXI</para>
  <para style="s1">Davide si affida a Dio, domandandogli liberazione dai suoi nemici e protezione fino alla vecchiaia; per il che già glorifica il Signore</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1"/>SIGNORE, io mi son confidato in te<note caller="*" style="x"><char style="xo" closed="false">71.1 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> e rif.; <ref loc="PSA 31:1">31.1</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 71:1">
    <char style="add">Fa' ch</char>'io non sia giammai confuso.<verse eid="PSA 71:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2"/>Riscuotimi, e liberami, per la tua giustizia;</para>
  <para style="q" vid="PSA 71:2">Inchina a me il tuo orecchio, e salvami.<verse eid="PSA 71:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3"/>Siimi una rocca di dimora,</para>
  <para style="q" vid="PSA 71:3">Nella quale io entri sempre;</para>
  <para style="q" vid="PSA 71:3">Tu hai ordinata la mia salute;</para>
  <para style="q" vid="PSA 71:3">Perciocchè tu <char style="add">sei</char> la mia rupe e la mia fortezza.<verse eid="PSA 71:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4"/>O Dio mio, liberami dalla man dell'empio,</para>
  <para style="q" vid="PSA 71:4">Dalla mano del perverso e del violento.<verse eid="PSA 71:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5"/>Perciocchè tu <char style="add">sei</char> la mia speranza<note caller="*" style="x"><char style="xo" closed="false">71.5 </char><char style="xk" closed="false">speranza </char><char style="xt" closed="false"><ref loc="JER 17:7">Ger. 17.7</ref>,<ref loc="JER 17:17">17</ref>. <ref loc="1TI 1:1">1 Tim. 1.1</ref>.</char></note>, o Signore Iddio;</para>
  <para style="q" vid="PSA 71:5">La mia confidanza fin dalla mia fanciullezza.<verse eid="PSA 71:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6"/>Tu sei stato il mio sostegno fin dal seno <char style="add">di mia madre</char><note caller="*" style="x"><char style="xo" closed="false">71.6 </char><char style="xk" closed="false">madre </char><char style="xt" closed="false"><ref loc="PSA 22:9">Sal. 22.9</ref>,<ref loc="PSA 22:10">10</ref>. <ref loc="ISA 46:3">Is. 46.3</ref>.</char></note>;</para>
  <para style="q" vid="PSA 71:6">Tu <char style="add">sei</char> quel che mi hai tratto fuori delle interiora di essa;</para>
  <para style="q" vid="PSA 71:6">Per te ho avuto del continuo di che lodarti.<verse eid="PSA 71:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7"/>Io sono stato a molti come un mostro<note caller="*" style="x"><char style="xo" closed="false">71.7 </char><char style="xk" closed="false">mostro </char><char style="xt" closed="false"><ref loc="1CO 4:9">1 Cor. 4.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 71:7">Ma tu <char style="add">sei</char> il mio forte ricetto.<verse eid="PSA 71:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8"/>Sia la mia bocca ripiena della tua lode,</para>
  <para style="q" vid="PSA 71:8">
    <char style="add">E</char> della tua gloria tuttodì.<verse eid="PSA 71:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9"/>Non rigettarmi al tempo della vecchiezza;</para>
  <para style="q" vid="PSA 71:9">Ora, che le forze mi mancano, non abbandonarmi.<verse eid="PSA 71:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10"/>Perciocchè i miei nemici tengono ragionamenti contro a me,</para>
  <para style="q" vid="PSA 71:10">E quelli che spiano l'anima mia prendono insieme consiglio<note caller="*" style="x"><char style="xo" closed="false">71.10 </char><char style="xk" closed="false">consiglio </char><char style="xt" closed="false"><ref loc="2SA 17:1">2 Sam. 17.1</ref>. <ref loc="MAT 27:1">Mat. 27.1</ref>.</char></note>.<verse eid="PSA 71:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11"/>Dicendo: Iddio l'ha abbandonato;</para>
  <para style="q" vid="PSA 71:11">Perseguitate<char style="add">lo</char>, e prendetelo; perciocchè non <char style="add">vi è</char> alcuno che <char style="add">lo</char> riscuota.<verse eid="PSA 71:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12"/>O Dio, non allontanarti da me<note caller="*" style="x"><char style="xo" closed="false">71.12 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="PSA 22:11">Sal. 22.11</ref>,<ref loc="PSA 22:19">19</ref>; <ref loc="PSA 38:21">38.21</ref>,<ref loc="PSA 38:22">22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 71:12">Dio mio, affrettati in mio aiuto.<verse eid="PSA 71:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13"/>Sieno confusi, <char style="add">e</char> vengano meno gli avversari dell'anima mia;</para>
  <para style="q" vid="PSA 71:13">Quelli che procacciano il mio male sieno coperti di onta e di vituperio.<verse eid="PSA 71:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14"/>Ma io spererò del continuo,</para>
  <para style="q" vid="PSA 71:14">E sopraggiungerò <char style="add">ancora altre</char> lodi a tutte le tue.<verse eid="PSA 71:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15"/>La mia bocca racconterà tuttodì la tua giustizia, <char style="add">e</char> la tua salute;</para>
  <para style="q" vid="PSA 71:15">Bench<char style="add">è</char> io non <char style="add">ne</char> sappia il gran numero<note caller="*" style="x"><char style="xo" closed="false">71.15 </char><char style="xk" closed="false">numero </char><char style="xt" closed="false"><ref loc="PSA 40:5">Sal. 40.5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 71:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16"/>Io entrerò nelle prodezze del Signore Iddio;</para>
  <para style="q" vid="PSA 71:16">Io ricorderò la giustizia di te solo.<verse eid="PSA 71:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17"/>O Dio, tu mi hai ammaestrato dalla mia fanciullezza;</para>
  <para style="q" vid="PSA 71:17">Ed io, infino ad ora, ho annunziate le tue maraviglie.<verse eid="PSA 71:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18"/>Non abbandonarmi ancora, o Dio, fino alla vecchiezza, anzi <char style="add">fino</char> alla canutezza;</para>
  <para style="q" vid="PSA 71:18">Finchè io abbia annunziato il tuo braccio a <char style="add">questa</char> generazione,</para>
  <para style="q" vid="PSA 71:18">
    <char style="add">E</char> la tua potenza a tutti quelli <char style="add">che</char> verranno <char style="add">appresso</char>.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19"/>E la tua giustizia, o Dio, <char style="add">esalterò</char> sommamente:</para>
  <para style="q" vid="PSA 71:19">Perciocchè tu hai fatte <char style="add">cose</char> grandi<note caller="*" style="x"><char style="xo" closed="false">71.19 </char><char style="xk" closed="false">grandi </char><char style="xt" closed="false"><ref loc="PSA 126:2">Sal. 126.2</ref>. <ref loc="LUK 1:49">Luc. 1.49</ref>.</char></note>. O Dio, chi <char style="add">è</char> pari a te<note caller="*" style="x"><char style="xo" closed="false">71.19 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="EXO 15:11">Esod. 15.11</ref> </char><char style="xta" closed="false">e rif.</char></note>?<verse eid="PSA 71:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20"/>Perciocchè, avendomi fatto sentir molte tribolazioni e mali,</para>
  <para style="q" vid="PSA 71:20">Tu mi hai di nuovo resa la vita<note caller="*" style="x"><char style="xo" closed="false">71.20 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="HOS 6:1">Os. 6.1</ref>,<ref loc="HOS 6:2">2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 71:20">E mi hai di nuovo tratto fuor degli abissi della terra.<verse eid="PSA 71:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21"/>Tu hai accresciuta la mia grandezza,</para>
  <para style="q" vid="PSA 71:21">E ti sei rivolto, <char style="add">e</char> mi hai consolato.<verse eid="PSA 71:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22"/>Io altresì, collo strumento del saltero, celebrerò te,</para>
  <para style="q" vid="PSA 71:22">
    <char style="add">E</char> la tua verità, o Dio mio;</para>
  <para style="q" vid="PSA 71:22">Io ti salmeggerò colla cetera, o Santo d'Israele.<verse eid="PSA 71:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23"/>Le mie labbra giubileranno, quando io ti salmeggerò;</para>
  <para style="q" vid="PSA 71:23">E insieme l'anima mia, la quale tu hai riscattata<note caller="*" style="x"><char style="xo" closed="false">71.23 </char><char style="xk" closed="false">riscattata </char><char style="xt" closed="false"><ref loc="PSA 34:22">Sal. 34.22</ref>; <ref loc="PSA 103:2-4">103.2-4</ref>.</char></note>.<verse eid="PSA 71:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24"/>La mia lingua ancora ragionerà tuttodì della tua giustizia;</para>
  <para style="q" vid="PSA 71:24">Perciocchè sono stati svergognati, perchè sono stati confusi quelli che procacciavano il mio male.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">SALMO LXXII</para>
  <para style="s1">Il regno giusto e glorioso di Salomone, tipo del regno eterno del Messia</para>
  <para style="d">Per Salomone</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1"/>O DIO, da' i tuoi giudicii al re,</para>
  <para style="q" vid="PSA 72:1">E la tua giustizia al figliuolo del re<note caller="*" style="x"><char style="xo" closed="false">72.1 </char><char style="xk" closed="false">re </char><char style="xt" closed="false"><ref loc="1CH 22:12">1 Cron. 22.12</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 72:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2"/>Ed egli giudicherà il tuo popolo in giustizia,</para>
  <para style="q" vid="PSA 72:2">Ed i tuoi poveri afflitti in dirittura<note caller="*" style="x"><char style="xo" closed="false">72.2 </char><char style="xk" closed="false">dirittura </char><char style="xt" closed="false"><ref loc="ISA 11:2-4">Is. 11.2-4</ref>; <ref loc="ISA 32:1">32.1</ref>.</char></note>.<verse eid="PSA 72:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3"/>I monti produrranno pace al popolo;</para>
  <para style="q" vid="PSA 72:3">E i colli <char style="add">saranno pieni</char> di giustizia<note caller="*" style="x"><char style="xo" closed="false">72.3 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 85:10">Sal. 85.10</ref>. <ref loc="ISA 32:17">Is. 32.17</ref>,<ref loc="ISA 32:18">18</ref>; <ref loc="ISA 52:7">52.7</ref>.</char></note>.<verse eid="PSA 72:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4"/>Egli farà ragione a' poveri afflitti d'infra il popolo;</para>
  <para style="q" vid="PSA 72:4">Egli salverà i figliuoli del misero,</para>
  <para style="q" vid="PSA 72:4">E fiaccherà l'oppressore.<verse eid="PSA 72:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5"/>Essi ti temeranno per ogni età,</para>
  <para style="q" vid="PSA 72:5">Mentre dureranno il sole e la luna.<verse eid="PSA 72:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6"/>Egli scenderà come pioggia sopra erba segata;</para>
  <para style="q" vid="PSA 72:6">Come pioggia minuta che adacqua la terra<note caller="*" style="x"><char style="xo" closed="false">72.6 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="2SA 23:4">2 Sam. 23.4</ref>. <ref loc="HOS 6:3">Os. 6.3</ref>.</char></note>.<verse eid="PSA 72:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7"/>Il giusto fiorirà a' dì d'esso,</para>
  <para style="q" vid="PSA 72:7">E <char style="add">vi sarà</char> abbondanza di pace, finchè non <char style="add">vi sia</char> più luna<note caller="*" style="x"><char style="xo" closed="false">72.7 </char><char style="xk" closed="false">luna </char><char style="xt" closed="false"><ref loc="ISA 2:4">Is. 2.4</ref>. <ref loc="DAN 2:44">Dan. 2.44</ref>. <ref loc="LUK 1:33">Luc. 1.33</ref>.</char></note>.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8"/>Ed egli signoreggerà da un mare all'altro,</para>
  <para style="q" vid="PSA 72:8">E dal fiume fino alle estremità della terra<note caller="*" style="x"><char style="xo" closed="false">72.8 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="EXO 23:31">Esod. 23.31</ref>. <ref loc="1KI 4:21">1 Re. 4.21</ref>,<ref loc="1KI 4:24">24</ref>. <ref loc="PSA 2:8">Sal. 2.8</ref>.</char></note>.<verse eid="PSA 72:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9"/>Quelli che abitano ne' deserti s'inchineranno davanti a lui,</para>
  <para style="q" vid="PSA 72:9">Ed i suoi nemici leccheranno la polvere<note caller="*" style="x"><char style="xo" closed="false">72.9 </char><char style="xk" closed="false">polvere </char><char style="xt" closed="false"><ref loc="ISA 49:23">Is. 49.23</ref>. <ref loc="MIC 7:17">Mic. 7.17</ref>.</char></note>.<verse eid="PSA 72:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10"/>I re di Tarsis e delle isole <char style="add">gli</char> pagheranno tributo;</para>
  <para style="q" vid="PSA 72:10">I re di Etiopia e di Arabia <char style="add">gli</char> porteranno doni<note caller="*" style="x"><char style="xo" closed="false">72.10 </char><char style="xk" closed="false">doni </char><char style="xt" closed="false"><ref loc="2CH 9:21">2 Cron. 9.21</ref>. <ref loc="ISA 49:7">Is. 49.7</ref>; <ref loc="ISA 60:6">60.6</ref>,<ref loc="ISA 60:9">9</ref>.</char></note>.<verse eid="PSA 72:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11"/>E tutti i re l'adoreranno,</para>
  <para style="q" vid="PSA 72:11">Tutte le nazioni gli serviranno<note caller="*" style="x"><char style="xo" closed="false">72.11 </char><char style="xk" closed="false">serviranno </char><char style="xt" closed="false"><ref loc="ISA 49:22">Is. 49.22</ref>,<ref loc="ISA 49:23">23</ref>.</char></note>.<verse eid="PSA 72:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12"/>Perciocchè egli libererà il bisognoso che grida,</para>
  <para style="q" vid="PSA 72:12">E il povero afflitto, e <char style="add">colui che</char> non <char style="add">ha</char> alcuno che lo aiuti.<verse eid="PSA 72:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13"/>Egli avrà compassione del misero e del bisognoso,</para>
  <para style="q" vid="PSA 72:13">E salverà le persone de' poveri.<verse eid="PSA 72:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14"/>Egli riscoterà la vita loro da frode e da violenza;</para>
  <para style="q" vid="PSA 72:14">E il sangue loro sarà prezioso davanti a lui<note caller="*" style="x"><char style="xo" closed="false">72.14 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="PSA 116:15">Sal. 116.15</ref>.</char></note>.<verse eid="PSA 72:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15"/>Così egli viverà, ed <char style="add">altri</char> gli darà dell'oro di Etiopia;</para>
  <para style="q" vid="PSA 72:15">E pregherà per lui del continuo, e tuttodì lo benedirà.<verse eid="PSA 72:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16"/>Essendo seminata in terra, sulla sommità de' monti, pure una menata di frumento,</para>
  <para style="q" vid="PSA 72:16">Quello ch'essa produrrà farà romore come il Libano;</para>
  <para style="q" vid="PSA 72:16">E <char style="add">gli abitanti</char> delle città fioriranno come l'erba della terra<note caller="*" style="x"><char style="xo" closed="false">72.16 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="1KI 4:20">1 Re. 4.20</ref>.</char></note>.<verse eid="PSA 72:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17"/>Il suo nome durerà in eterno,</para>
  <para style="q" vid="PSA 72:17">Il suo nome sarà perpetuato di generazione in generazione,</para>
  <para style="q" vid="PSA 72:17">Mentre vi sarà sole;</para>
  <para style="q" vid="PSA 72:17">E tutte le nazioni saranno benedette in lui<note caller="*" style="x"><char style="xo" closed="false">72.17 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="GEN 12:3">Gen. 12.3</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 72:17">
    <char style="add">E</char> lo celebreranno beato.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18"/>Benedetto <char style="add">sia</char> il Signore Iddio, l'Iddio d'Israele,</para>
  <para style="q" vid="PSA 72:18">Il qual solo fa maraviglie<note caller="*" style="x"><char style="xo" closed="false">72.18 </char><char style="xk" closed="false">maraviglie </char><char style="xt" closed="false"><ref loc="EXO 15:11">Esod. 15.11</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 72:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19"/>Benedetto <char style="add">sia</char> ancora eternamente il Nome suo glorioso;</para>
  <para style="q" vid="PSA 72:19">E sia tutta la terra ripiena della sua gloria<note caller="*" style="x"><char style="xo" closed="false">72.19 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="NUM 14:21">Num. 14.21</ref>. <ref loc="ZEC 14:9">Zac. 14.9</ref>.</char></note>. Amen, Amen.<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20"/>
    <char style="add">Qui</char> finiscono le orazioni di Davide, figliuolo d'Isai.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="cl">SALMO LXXIII</para>
  <para style="s1">La prosperità degli empi fa dubitare della giustizia di Dio; ma la considerazione della loro fine ci riconduce a Lui</para>
  <para style="d">Salmo di Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1"/>CERTAMENTE Iddio <char style="add">è</char> buono ad Israele<note caller="*" style="x"><char style="xo" closed="false">73.1 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="JHN 1:47">Giov. 1.47</ref>. <ref loc="ROM 9:6">Rom. 9.6</ref>.</char></note>,</para>
  <para style="q" vid="PSA 73:1">A <char style="add">quelli che son</char> puri di cuore<note caller="*" style="x"><char style="xo" closed="false">73.1 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PSA 24:4">Sal. 24.4</ref>.</char></note>.<verse eid="PSA 73:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2"/>Ora, quant'è a me, quasi che incapparono i miei piedi;</para>
  <para style="q" vid="PSA 73:2">Come nulla <char style="add">mancò</char> che i miei passi non isdrucciolassero.<verse eid="PSA 73:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3"/>Perciocchè io portava invidia agl'insensati,</para>
  <para style="q" vid="PSA 73:3">Veggendo la prosperità degli empi<note caller="*" style="x"><char style="xo" closed="false">73.3 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="JOB 21:7">Giob. 21.7</ref>. <ref loc="PSA 37:1">Sal. 37.1</ref>. <ref loc="PRO 23:17">Prov. 23.17</ref>. <ref loc="JER 12:1">Ger. 12.1</ref>.</char></note>.<verse eid="PSA 73:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4"/>Perciocchè non <char style="add">vi sono</char> alcuni legami alla lor morte;</para>
  <para style="q" vid="PSA 73:4">E la lor forza <char style="add">è</char> prosperosa.<verse eid="PSA 73:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5"/>
    <char style="add">Quando</char> gli <char style="add">altri</char> uomini <char style="add">sono</char> in travagli, essi non <char style="add">vi son</char> punto;</para>
  <para style="q" vid="PSA 73:5">E non ricevono battiture col rimanente degli uomini.<verse eid="PSA 73:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6"/>Perciò, la superbia li cinge a giusa di collana;</para>
  <para style="q" vid="PSA 73:6">La violenza li involge <char style="add">come</char> un vestimento.<verse eid="PSA 73:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7"/>Gli occhi escono loro fuori per lo grasso;</para>
  <para style="q" vid="PSA 73:7">Avanzano le immaginazioni del cuor <char style="add">loro</char>.<verse eid="PSA 73:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8"/>Son dissoluti<note caller="*" style="x"><char style="xo" closed="false">73.8 </char><char style="xk" closed="false">dissoluti </char><char style="xt" closed="false"><ref loc="PSA 53:1">Sal. 53.1</ref> ecc.</char></note>, e per malizia ragionano di oppressare;</para>
  <para style="q" vid="PSA 73:8">Parlano da alto.<verse eid="PSA 73:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9"/>Mettono la lor bocca dentro al cielo,</para>
  <para style="q" vid="PSA 73:9">E la lor lingua passeggia per la terra.<verse eid="PSA 73:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10"/>Perciò, il popolo di Dio riviene a questo,</para>
  <para style="q" vid="PSA 73:10">
    <char style="add">Veggendo che</char> l'acqua gli è spremuta a bere a pien <char style="add">calice</char>,<verse eid="PSA 73:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11"/>E dice: Come <char style="add">può essere che</char> Iddio sappia <char style="add">ogni cosa</char>,</para>
  <para style="q" vid="PSA 73:11">E che vi sia conoscimento nell'Altissimo?<verse eid="PSA 73:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12"/>Ecco, costoro <char style="add">son</char> empi, e pur godono pace e tranquillità in perpetuo;</para>
  <para style="q" vid="PSA 73:12">Ed accrescono le <char style="add">lor</char> facoltà.<verse eid="PSA 73:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13"/>Indarno <char style="add">adunque</char> in vero ho nettato il mio cuore<note caller="*" style="x"><char style="xo" closed="false">73.13 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="JOB 21:15">Giob. 21.15</ref>; <ref loc="JOB 34:9">34.9</ref>; <ref loc="JOB 35:3">35.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 73:13">Ed ho lavate le mie mani nell'innocenza.<verse eid="PSA 73:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14"/>Poichè son battuto tuttodì,</para>
  <para style="q" vid="PSA 73:14">Ed ogni mattina il mio gastigamento <char style="add">si rinnuova</char>.<verse eid="PSA 73:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15"/>Se io dico: Io ragionerò così;</para>
  <para style="q" vid="PSA 73:15">Ecco, io son disleale inverso la generazione de' tuoi figliuoli.<verse eid="PSA 73:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16"/>Io ho adunque pensato di <char style="add">volere</char> intender questo;</para>
  <para style="q" vid="PSA 73:16">Ma <char style="add">la cosa</char> mi è parsa molto molesta.<verse eid="PSA 73:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17"/>Infino a tanto che sono entrato ne' santuari di Dio<note caller="*" style="x"><char style="xo" closed="false">73.17 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="PSA 77:13">Sal. 77.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 73:17">
    <char style="add">Ed</char> ho considerato il fine di coloro<note caller="*" style="x"><char style="xo" closed="false">73.17 </char><char style="xk" closed="false">coloro </char><char style="xt" closed="false"><ref loc="PSA 37:38">Sal. 37.38</ref>.</char></note>.<verse eid="PSA 73:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18"/>Certo, tu li metti in isdruccioli;</para>
  <para style="q" vid="PSA 73:18">Tu li trabocchi in ruine.<verse eid="PSA 73:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19"/>Come sono eglino stati distrutti in un momento!</para>
  <para style="q" vid="PSA 73:19">
    <char style="add">Come</char> son venuti meno, e sono stati consumati per casi spaventevoli!<verse eid="PSA 73:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20"/>
    <char style="add">Son</char> come un sogno<note caller="*" style="x"><char style="xo" closed="false">73.20 </char><char style="xk" closed="false">sogno </char><char style="xt" closed="false"><ref loc="JOB 20:8">Giob. 20.8</ref>. <ref loc="PSA 90:5">Sal. 90.5</ref>.</char></note>, dopo che <char style="add">l'uomo</char> si è destato;</para>
  <para style="q" vid="PSA 73:20">O Signore, quando tu <char style="add">ti</char> risveglierai, tu sprezzerai la lor vana apparenza.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21"/>Quando il mio cuore era inacerbito,</para>
  <para style="q" vid="PSA 73:21">Ed io era punto nelle reni;<verse eid="PSA 73:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22"/>Io <char style="add">era</char> insensato, e non aveva conoscimento;</para>
  <para style="q" vid="PSA 73:22">Io era inverso te <char style="add">simile</char> alle bestie.<verse eid="PSA 73:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23"/>Ma pure io sono stato del continuo teco;</para>
  <para style="q" vid="PSA 73:23">Tu mi hai preso per la man destra.<verse eid="PSA 73:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24"/>Tu mi condurrai per lo tuo consiglio<note caller="*" style="x"><char style="xo" closed="false">73.24 </char><char style="xk" closed="false">consiglio </char><char style="xt" closed="false"><ref loc="PSA 32:8">Sal. 32.8</ref>. <ref loc="ISA 58:8">Is. 58.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 73:24">E poi mi riceverai <char style="add">in</char> gloria;<verse eid="PSA 73:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25"/>Chi <char style="add">è</char> per me in cielo, <char style="add">fuor che te?</char></para>
  <para style="q" vid="PSA 73:25">Io non voglio <char style="add">altri</char> che te in terra<note caller="*" style="x"><char style="xo" closed="false">73.25 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PHP 3:8">Fil. 3.8</ref>.</char></note>.<verse eid="PSA 73:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26"/>La mia carne ed il mio cuore erano venuti meno:</para>
  <para style="q" vid="PSA 73:26">
    <char style="add">Ma</char> Iddio <char style="add">è</char> la rocca del mio cuore, e la mia parte in eterno<note caller="*" style="x"><char style="xo" closed="false">73.26 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 16:5">Sal. 16.5</ref>; <ref loc="PSA 119:57">119.57</ref>.</char></note>.<verse eid="PSA 73:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27"/>Perciocchè, ecco, quelli che si allontanano da te periranno<note caller="*" style="x"><char style="xo" closed="false">73.27 </char><char style="xk" closed="false">periranno </char><char style="xt" closed="false"><ref loc="PSA 119:155">Sal. 119.155</ref>.</char></note>;</para>
  <para style="q" vid="PSA 73:27">Tu distruggerai ogni uomo che fornica<char style="add">ndo si svia</char> da te<note caller="*" style="x"><char style="xo" closed="false">73.27 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="JAS 4:4">Giac. 4.4</ref>.</char></note>.<verse eid="PSA 73:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28"/>Ma quant'è a me, egli mi <char style="add">è</char> buono di accostarmi a Dio<note caller="*" style="x"><char style="xo" closed="false">73.28 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="HEB 10:22">Ebr. 10.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 73:28">Io ho posta nel Signore Iddio la mia confidanza,</para>
  <para style="q" vid="PSA 73:28">Per raccontar tutte le opere sue.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">SALMO LXXIV</para>
  <para style="s1">Il Santuario desolato. Dio supplicato di ricordarsi del suo Patto</para>
  <para style="d">Maschil di Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1"/>O DIO, perchè <char style="add">ci</char> hai scacciati in perpetuo?</para>
  <para style="q" vid="PSA 74:1">
    <char style="add">Perchè</char> fuma l'ira tua contro alla greggia del tuo pasco?<verse eid="PSA 74:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2"/>Ricordati della tua raunanza, <char style="add">la quale</char> tu acquistasti anticamente;</para>
  <para style="q" vid="PSA 74:2">Della tribù della tua eredità <char style="add">che</char> tu riscotesti<note caller="*" style="x"><char style="xo" closed="false">74.2 </char><char style="xk" closed="false">riscotesti </char><char style="xt" closed="false"><ref loc="DEU 9:29">Deut. 9.29</ref>; <ref loc="DEU 32:9">32.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 74:2">Del monte di Sion, nel quale tu abitasti.<verse eid="PSA 74:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3"/>Muovi i passi verso le ruine perpetue<note caller="*" style="x"><char style="xo" closed="false">74.3 </char><char style="xk" closed="false">perpetue </char><char style="xt" closed="false"><ref loc="ISA 61:4">Is. 61.4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 74:3">
    <char style="add">Verso</char> tutto il male <char style="add">che</char> i nemici han fatto nel <char style="add">luogo</char> santo.<verse eid="PSA 74:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4"/>I tuoi nemici han ruggito in mezzo del tuo Tempio;</para>
  <para style="q" vid="PSA 74:4">
    <char style="add">Vi</char> hanno poste le loro insegne <char style="add">per</char> segnali<note caller="*" style="x"><char style="xo" closed="false">74.4 </char><char style="xk" closed="false">segnali </char><char style="xt" closed="false"><ref loc="MAT 24:15">Mat. 24.15</ref>.</char></note>.<verse eid="PSA 74:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5"/>
    <char style="add">Ciò</char> sarà noto; come chi, <char style="add">levando</char> ad alto delle scuri,</para>
  <para style="q" vid="PSA 74:5">Le avventa contro a un cespo di legne;<verse eid="PSA 74:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6"/>Così ora hanno essi, con iscuri e martelli,</para>
  <para style="q" vid="PSA 74:6">Fracassati tutti quanti gl'intagli di quello<note caller="*" style="x"><char style="xo" closed="false">74.6 </char><char style="xk" closed="false">quello </char><char style="xt" closed="false"><ref loc="1KI 6:18">1 Re. 6.18</ref>,<ref loc="1KI 6:29">29</ref>,<ref loc="1KI 6:32">32</ref>,<ref loc="1KI 6:35">35</ref>.</char></note>.<verse eid="PSA 74:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7"/>Hanno messi a fuoco e fiamma i tuoi santuari<note caller="*" style="x"><char style="xo" closed="false">74.7 </char><char style="xk" closed="false">santuari </char><char style="xt" closed="false"><ref loc="2KI 25:9">2 Re. 25.9</ref>.</char></note>,</para>
  <para style="q" vid="PSA 74:7">Hanno profanato il tabernacolo del tuo Nome, <char style="add">gettandolo</char> per terra.<verse eid="PSA 74:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8"/>Hanno detto nel cuor loro: Prediamoli tutti quanti;</para>
  <para style="q" vid="PSA 74:8">Hanno arsi tutti i luoghi delle raunanze di Dio in terra<note caller="*" style="x"><char style="xo" closed="false">74.8 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 83:4">Sal. 83.4</ref>.</char></note>.<verse eid="PSA 74:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9"/>Noi non veggiam <char style="add">più</char> i nostri segni;</para>
  <para style="q" vid="PSA 74:9">Non <char style="add">vi è</char> più profeta<note caller="*" style="x"><char style="xo" closed="false">74.9 </char><char style="xk" closed="false">profeta </char><char style="xt" closed="false"><ref loc="1SA 3:1">1 Sam. 3.1</ref>. <ref loc="AMO 8:11">Am. 8.11</ref>.</char></note>,</para>
  <para style="q" vid="PSA 74:9">E non abbiam con noi alcuno che sappia infino a quando.<verse eid="PSA 74:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10"/>Infino a quando, o Dio, oltraggerà l'avversario?</para>
  <para style="q" vid="PSA 74:10">Il nemico dispetterà egli il tuo Nome in perpetuo?<verse eid="PSA 74:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11"/>Perchè ritiri la tua mano e la tua destra?</para>
  <para style="q" vid="PSA 74:11">Non lasciare ch'ella ti dimori più dentro al seno.<verse eid="PSA 74:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12"/>Ora Iddio già ab antico <char style="add">è</char> il mio Re<note caller="*" style="x"><char style="xo" closed="false">74.12 </char><char style="xk" closed="false">Re </char><char style="xt" closed="false"><ref loc="PSA 44:4">Sal. 44.4</ref>.</char></note>.</para>
  <para style="q" vid="PSA 74:12">Il quale opera salvazioni in mezzo della terra.<verse eid="PSA 74:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13"/>Tu, colla tua forza, spartisti il mare<note caller="*" style="x"><char style="xo" closed="false">74.13 </char><char style="xk" closed="false">mare </char><char style="xt" closed="false"><ref loc="EXO 14:21">Esod. 14.21</ref>. <ref loc="ISA 51:9">Is. 51.9</ref>,<ref loc="ISA 51:10">10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 74:13">Tu rompesti le teste delle balene nelle acque.<verse eid="PSA 74:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14"/>Tu fiaccasti i capi del leviatan<note caller="*" style="x"><char style="xo" closed="false">74.14 </char><char style="xk" closed="false">leviatan </char><char style="xt" closed="false"><ref loc="JOB 41:1">Giob. 41.1</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 74:14">E li desti per pasto al popolo de' deserti.<verse eid="PSA 74:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15"/>Tu facesti scoppiar fonti e torrenti<note caller="*" style="x"><char style="xo" closed="false">74.15 </char><char style="xk" closed="false">torrenti </char><char style="xt" closed="false"><ref loc="EXO 17:5">Esod. 17.5</ref>,<ref loc="EXO 17:6">6</ref>. <ref loc="NUM 20:11">Num. 20.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 74:15">Tu seccasti fiumi grossi<note caller="*" style="x"><char style="xo" closed="false">74.15 </char><char style="xk" closed="false">grossi </char><char style="xt" closed="false"><ref loc="JOS 3:13">Gios. 3.13</ref> ecc.</char></note>.<verse eid="PSA 74:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16"/>Tuo <char style="add">è</char> il giorno, tua eziandio <char style="add">è</char> la notte;</para>
  <para style="q" vid="PSA 74:16">Tu hai ordinata la luna e il sole<note caller="*" style="x"><char style="xo" closed="false">74.16 </char><char style="xk" closed="false">sole </char><char style="xt" closed="false"><ref loc="GEN 1:14">Gen. 1.14</ref> ecc.</char></note>.<verse eid="PSA 74:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17"/>Tu hai posti tutti i termini della terra<note caller="*" style="x"><char style="xo" closed="false">74.17 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="ACT 17:26">Fat. 17.26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 74:17">Tu hai formata la state ed il verno<note caller="*" style="x"><char style="xo" closed="false">74.17 </char><char style="xk" closed="false">verno </char><char style="xt" closed="false"><ref loc="GEN 8:22">Gen. 8.22</ref>.</char></note>.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18"/>Ricordati di questo: che il nemico ha oltraggiato il Signore<note caller="*" style="x"><char style="xo" closed="false">74.18 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="REV 16:19">Apoc. 16.19</ref>; <ref loc="REV 18:5">18.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 74:18">E che il popolo stolto ha dispettato il tuo Nome.<verse eid="PSA 74:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19"/>Non dare alle fiere la vita della tua tortola;</para>
  <para style="q" vid="PSA 74:19">Non dimenticare in perpetuo la raunanza de' tuoi poveri afflitti.<verse eid="PSA 74:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20"/>Riguarda al Patto<note caller="*" style="x"><char style="xo" closed="false">74.20 </char><char style="xk" closed="false">Patto </char><char style="xt" closed="false"><ref loc="GEN 17:7">Gen. 17.7</ref>,<ref loc="GEN 17:8">8</ref> e rif. <ref loc="LEV 26:44">Lev. 26.44</ref>,<ref loc="LEV 26:45">45</ref>. <ref loc="PSA 106:45">Sal. 106.45</ref>. <ref loc="JER 33:20">Ger. 33.20</ref>,<ref loc="JER 33:21">21</ref>.</char></note>,</para>
  <para style="q" vid="PSA 74:20">Perciocchè i luoghi tenebrosi della terra sono ripieni di ricetti di violenza.<verse eid="PSA 74:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21"/>Non ritornisene il misero indietro svergognato;</para>
  <para style="q" vid="PSA 74:21">
    <char style="add">Fa' che</char> il povero afflitto e il bisognoso lodino il tuo Nome.<verse eid="PSA 74:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22"/>Levati, o Dio, dibatti la tua lite;</para>
  <para style="q" vid="PSA 74:22">Ricordati dell'oltraggio che ti è fatto tuttodì dallo stolto.<verse eid="PSA 74:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23"/>Non dimenticar le grida de' tuoi nemici;</para>
  <para style="q" vid="PSA 74:23">Lo strepito di quelli che si levano contro a te sale del continuo <char style="add">al cielo</char>.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">SALMO LXXX</para>
  <para style="s1">Il Salmista loda Iddio e promette di fare osservare la giustizia</para>
  <para style="d">Salmo di cantico di Asaf, <char style="add">dato</char> al Capo de' Musici, <char style="add">sopra</char> Al-tashet</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1"/>NOI ti celebriamo, noi ti celebriamo, o Dio;</para>
  <para style="q" vid="PSA 75:1">Perciocchè il tuo Nome <char style="add">è</char> vicino;</para>
  <para style="q" vid="PSA 75:1">L'uomo racconta le tue maraviglie.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2"/>Al tempo che avrò fissato,</para>
  <para style="q" vid="PSA 75:2">Io giudicherò dirittamente.<verse eid="PSA 75:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3"/>Il paese e tutti i suoi abitanti si struggevano;</para>
  <para style="q" vid="PSA 75:3">
    <char style="add">Ma</char> io ho rizzate le sue colonne<note caller="*" style="x"><char style="xo" closed="false">75.3 </char><char style="xk" closed="false">colonne </char><char style="xt" closed="false"><ref loc="1SA 2:8">1 Sam. 2.8</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 75:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4"/>Io ho detto agl'insensati: Non siate insensati;</para>
  <para style="q" vid="PSA 75:4">Ed agli empi: Non alzate il corno;<verse eid="PSA 75:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5"/>Non levate il vostro corno ad alto;</para>
  <para style="q" vid="PSA 75:5">
    <char style="add">E non</char> parlate col collo indurato.<verse eid="PSA 75:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6"/>Perciocchè nè di Levante, nè di Ponente,</para>
  <para style="q" vid="PSA 75:6">Nè dal deserto, <char style="add">viene</char> l'esaltamento.<verse eid="PSA 75:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7"/>Ma Iddio <char style="add">è</char> quel che giudica<note caller="*" style="x"><char style="xo" closed="false">75.7 </char><char style="xk" closed="false">giudica </char><char style="xt" closed="false"><ref loc="PSA 50:6">Sal. 50.6</ref>; <ref loc="PSA 58:11">58.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 75:7">Egli abbassa l'uno, ed innalza l'altro<note caller="*" style="x"><char style="xo" closed="false">75.7 </char><char style="xk" closed="false">altro </char><char style="xt" closed="false"><ref loc="1SA 2:7">1 Sam. 2.7</ref>. <ref loc="DAN 2:21">Dan. 2.21</ref>.</char></note>.<verse eid="PSA 75:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8"/>Perciocchè il Signore ha in mano una coppa,</para>
  <para style="q" vid="PSA 75:8">Il cui vino <char style="add">è</char> torbido;</para>
  <para style="q" vid="PSA 75:8">Ella <char style="add">è</char> piena di mistione, ed egli ne mesce;</para>
  <para style="q" vid="PSA 75:8">Certamente tutti gli empi della terra ne succeranno <char style="add">e</char> berranno le fecce<note caller="*" style="x"><char style="xo" closed="false">75.8 </char><char style="xk" closed="false">fecce </char><char style="xt" closed="false"><ref loc="JOB 21:20">Giob. 21.20</ref>. <ref loc="PSA 60:3">Sal. 60.3</ref>. <ref loc="JER 25:15">Ger. 25.15</ref>. <ref loc="REV 14:10">Apoc. 14.10</ref>; <ref loc="REV 16:19">16.19</ref>.</char></note>.<verse eid="PSA 75:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9"/>Ora, quant'è a me, io predicherò <char style="add">queste cose</char> in perpetuo,</para>
  <para style="q" vid="PSA 75:9">Io salmeggerò all'Iddio di Giacobbe.<verse eid="PSA 75:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10"/>E mozzerò tutte le corna degli empi;</para>
  <para style="q" vid="PSA 75:10">E <char style="add">farò che</char> le corna de' giusti saranno alzate.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">SALMO LXXVI</para>
  <para style="s1">Maestà e potenza di Dio</para>
  <para style="d">Salmo di cantico di Asaf, <char style="add">dato</char> al Capo de' Musici, sopra Neghinot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1"/>IDDIO <char style="add">è</char> conosciuto in Giuda<note caller="*" style="x"><char style="xo" closed="false">76.1 </char><char style="xk" closed="false">Giuda </char><char style="xt" closed="false"><ref loc="PSA 48:1">Sal. 48.1</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 76:1">Il suo Nome <char style="add">è</char> grande in Israele.<verse eid="PSA 76:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2"/>E il suo tabernacolo è in Salem,</para>
  <para style="q" vid="PSA 76:2">E la sua stanza in Sion.<verse eid="PSA 76:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3"/>Quivi ha rotte saette,</para>
  <para style="q" vid="PSA 76:3">Archi, scudi, e spade, ed arnesi da guerra. <char style="qs">(Sela.)</char><verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4"/>Tu <char style="add">sei</char> illustre, potente,</para>
  <para style="q" vid="PSA 76:4">Più che i monti dei predatori.<verse eid="PSA 76:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5"/>I magnanimi sono stati spogliati,</para>
  <para style="q" vid="PSA 76:5">Hanno dormito il sonno loro;</para>
  <para style="q" vid="PSA 76:5">E niuno di <char style="add">quegli</char> uomini prodi ha saputo trovar le sue mani.<verse eid="PSA 76:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6"/>O Dio di Giacobbe,</para>
  <para style="q" vid="PSA 76:6">E carri e cavalli sono stati stupefatti per lo tuo sgridare<note caller="*" style="x"><char style="xo" closed="false">76.6 </char><char style="xk" closed="false">sgridare </char><char style="xt" closed="false"><ref loc="EXO 15:1">Esod. 15.1</ref>,<ref loc="EXO 15:21">21</ref>.</char></note>.<verse eid="PSA 76:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7"/>Tu <char style="add">sei</char> tremendo<note caller="*" style="x"><char style="xo" closed="false">76.7 </char><char style="xk" closed="false">temendo </char><char style="xt" closed="false"><ref loc="PSA 47:2">Sal. 47.2</ref>.</char></note>; tu, <char style="add">dico</char>;</para>
  <para style="q" vid="PSA 76:7">E chi durerà davanti a te, dacchè tu ti adiri?<verse eid="PSA 76:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8"/>Tu bandisti giudicio dal cielo<note caller="*" style="x"><char style="xo" closed="false">76.8 </char><char style="xk" closed="false">cielo </char><char style="xt" closed="false"><ref loc="PSA 75:7">Sal. 75.7</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 76:8">La terra temette, e stette cheta.<verse eid="PSA 76:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9"/>Quando Iddio si levò per <char style="add">far</char> giudicio,</para>
  <para style="q" vid="PSA 76:9">Per salvar tutti i mansueti della terra. <char style="qs">(Sela.)</char><verse eid="PSA 76:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10"/>Certamente l'ira degli uomini ti acquista lode<note caller="*" style="x"><char style="xo" closed="false">76.10 </char><char style="xk" closed="false">lode </char><char style="xt" closed="false"><ref loc="EXO 9:16">Esod. 9.16</ref>; <ref loc="EXO 18:11">18.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 76:10">Tu ti cingerai del rimanente dell'ire.<verse eid="PSA 76:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11"/>Fate voti al Signore Iddio vostro, e adempieteli<note caller="*" style="x"><char style="xo" closed="false">76.11 </char><char style="xk" closed="false">adempieteli </char><char style="xt" closed="false"><ref loc="PSA 50:14">Sal. 50.14</ref>. <ref loc="ECC 5:4-6">Eccl. 5.4-6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 76:11">Tutti quelli <char style="add">che sono</char> d'intorno a lui portino doni al Tremendo.<verse eid="PSA 76:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12"/>Egli vendemmia lo spirito de' principi;</para>
  <para style="q" vid="PSA 76:12">
    <char style="add">Egli è</char> tremendo ai re della terra.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">SALMO LXXVII</para>
  <para style="s1">Lotte interne del Salmista. Egli riprende animo, considerando le opere grandi e misericordiose di Dio</para>
  <para style="d">Salmo di Asaf, <char style="add">dato</char> al Capo de' Musici, de' figliuoli di Iedutun</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1"/>LA mia voce <char style="add">s'indirizza</char> a Dio, ed io grido;</para>
  <para style="q" vid="PSA 77:1">La mia voce <char style="add">s'indirizza</char> a Dio, acciocchè egli mi porga l'orecchio.<verse eid="PSA 77:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2"/>Nel giorno della mia distretta, io ho cercato il Signore<note caller="*" style="x"><char style="xo" closed="false">77.2 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sal. 50.15</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 77:2">Le mie mani sono state sparse qua e là di notte,</para>
  <para style="q" vid="PSA 77:2">E non hanno avuta posa alcuna;</para>
  <para style="q" vid="PSA 77:2">L'anima mia ha rifiutato d'essere consolata.<verse eid="PSA 77:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3"/>Io mi ricordo di Dio, e romoreggio;</para>
  <para style="q" vid="PSA 77:3">Io mi lamento, e il mio spirito è angosciato. <char style="qs">(Sela.)</char><verse eid="PSA 77:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4"/>Tu hai ritenuti gli occhi miei <char style="add">in continue</char> vegghie;</para>
  <para style="q" vid="PSA 77:4">Io son tutto attonito, e non posso parlare.<verse eid="PSA 77:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5"/>Io ripenso a' giorni antichi,</para>
  <para style="q" vid="PSA 77:5">Agli anni da lungo tempo passati.<verse eid="PSA 77:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6"/>Io mi ricordo come <char style="add">già</char> io sonava;</para>
  <para style="q" vid="PSA 77:6">Io medito nel mio cuore di notte,</para>
  <para style="q" vid="PSA 77:6">E lo spirito mio va investigando.<verse eid="PSA 77:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7"/>Il Signore <char style="add">mi</char> rigetterà egli in perpetuo?</para>
  <para style="q" vid="PSA 77:7">E non <char style="add">mi</char> gradirà egli <char style="add">giammai</char> più?<verse eid="PSA 77:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8"/>È la sua benignità venuta meno per sempre mai?</para>
  <para style="q" vid="PSA 77:8">È la <char style="add">sua</char> parola mancata per ogni età<note caller="*" style="x"><char style="xo" closed="false">77.8 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="ROM 9:6">Rom. 9.6</ref>.</char></note>?<verse eid="PSA 77:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9"/>Iddio ha egli dimenticato di aver pietà<note caller="*" style="x"><char style="xo" closed="false">77.9 </char><char style="xk" closed="false">pietà </char><char style="xt" closed="false"><ref loc="ISA 49:15">Is. 49.15</ref>.</char></note>?</para>
  <para style="q" vid="PSA 77:9">Ha egli serrate per ira le sue compassioni? <char style="qs">(Sela.)</char><verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10"/>Io ho adunque detto: Se io son fiacco,</para>
  <para style="q" vid="PSA 77:10">Egli è perchè la destra dell'Altissimo è mutata.<verse eid="PSA 77:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11"/>Io mi rammemoro le opere del Signore;</para>
  <para style="q" vid="PSA 77:11">Perciocchè io mi riduco a memoria le tue maraviglie antiche;<verse eid="PSA 77:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12"/>E medito tutti i tuoi fatti,</para>
  <para style="q" vid="PSA 77:12">E ragiono delle tue operazioni.<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13"/>O Dio, le tue vie <char style="add">si veggono</char> nel Santuario<note caller="*" style="x"><char style="xo" closed="false">77.13 </char><char style="xk" closed="false">Santuario </char><char style="xt" closed="false"><ref loc="PSA 73:17">Sal. 73.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 77:13">Chi <char style="add">è</char> dio grande, come Iddio<note caller="*" style="x"><char style="xo" closed="false">77.13 </char><char style="xk" closed="false">Iddio </char><char style="xt" closed="false"><ref loc="EXO 15:11">Esod. 15.11</ref> </char><char style="xta" closed="false">e rif.</char></note>?<verse eid="PSA 77:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14"/>Tu <char style="add">sei</char> l'Iddio che fai maraviglie;</para>
  <para style="q" vid="PSA 77:14">Tu hai fatta conoscere la tua forza fra i popoli.<verse eid="PSA 77:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15"/>Tu hai, col tuo braccio, riscosso il tuo popolo<note caller="*" style="x"><char style="xo" closed="false">77.15 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="EXO 6:6">Esod. 6.6</ref>. <ref loc="DEU 9:29">Deut. 9.29</ref>.</char></note>;</para>
  <para style="q" vid="PSA 77:15">I figliuoli di Giacobbe e di Giuseppe. <char style="qs">(Sela.)</char><verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16"/>Le acque ti videro, o Dio;</para>
  <para style="q" vid="PSA 77:16">Le acque ti videro, <char style="add">e</char> furono spaventate<note caller="*" style="x"><char style="xo" closed="false">77.16 </char><char style="xk" closed="false">spaventate </char><char style="xt" closed="false"><ref loc="EXO 14:21">Esod. 14.21</ref>. <ref loc="JOS 3:15">Gios. 3.15</ref>,<ref loc="JOS 3:16">16</ref>.</char></note>;</para>
  <para style="q" vid="PSA 77:16">Gli abissi eziandio tremarono.<verse eid="PSA 77:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17"/>Le nubi versarono diluvi d'acque;</para>
  <para style="q" vid="PSA 77:17">I cieli tuonarono;</para>
  <para style="q" vid="PSA 77:17">I tuoi strali eziandio andarono attorno.<verse eid="PSA 77:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18"/>Il suon de' tuoi tuoni <char style="add">fu</char> per lo giro <char style="add">del cielo</char>;</para>
  <para style="q" vid="PSA 77:18">I folgori alluminarono il mondo;</para>
  <para style="q" vid="PSA 77:18">La terra fu smossa, e tremò.<verse eid="PSA 77:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19"/>La tua via <char style="add">fu</char> per mezzo il mare,</para>
  <para style="q" vid="PSA 77:19">E il tuo sentiero per mezzo le grandi acque;</para>
  <para style="q" vid="PSA 77:19">E le tue pedate non furono riconosciute.<verse eid="PSA 77:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20"/>Tu conducesti il tuo popolo, come una greggia<note caller="*" style="x"><char style="xo" closed="false">77.20 </char><char style="xk" closed="false">greggia </char><char style="xt" closed="false"><ref loc="EXO 13:21">Esod. 13.21</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 77:20">Per man di Mosè e d'Aaronne.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">SALMO LXXVIII</para>
  <para style="s1">Liberazioni accordate da Dio ad Israele, che si ribella del continuo. Dio ha scelto Giuda e Davide per pascere il suo popolo</para>
  <para style="d">Maschil di Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1"/>ASCOLTA, o popol mio, la mia dottrina;</para>
  <para style="q" vid="PSA 78:1">Porgete gli orecchi alle parole della mia bocca.<verse eid="PSA 78:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2"/>Io aprirò la mia bocca in sentenza;</para>
  <para style="q" vid="PSA 78:2">Io sgorgherò detti notevoli <char style="add">di cose</char> antiche;<verse eid="PSA 78:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3"/>Le quali noi abbiamo udite, e sappiamo,</para>
  <para style="q" vid="PSA 78:3">E le quali i nostri padri ci han raccontate.<verse eid="PSA 78:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4"/>Noi non <char style="add">le</char> celeremo a' lor figliuoli, alla generazione a venire<note caller="*" style="x"><char style="xo" closed="false">78.4 </char><char style="xk" closed="false">venire </char><char style="xt" closed="false"><ref loc="DEU 4:9">Deut. 4.9</ref>; <ref loc="DEU 6:7">6.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:4">Noi racconteremo le lodi del Signore,</para>
  <para style="q" vid="PSA 78:4">E la sua forza, e le sue maraviglie ch'egli ha fatte<note caller="*" style="x"><char style="xo" closed="false">78.4 </char><char style="xk" closed="false">fatte </char><char style="xt" closed="false"><ref loc="EXO 12:26">Esod. 12.26</ref>,<ref loc="EXO 12:27">27</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 78:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5"/>Egli ha fermata la testimonianza in Giacobbe,</para>
  <para style="q" vid="PSA 78:5">Ed ha posta la Legge in Israele;</para>
  <para style="q" vid="PSA 78:5">Le quali egli comandò a' nostri padri di fare assapere a' lor figliuoli;<verse eid="PSA 78:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6"/>Acciocchè la generazione a venire, i figliuoli <char style="add">che</char> nascerebbero, <char style="add">le</char> sapessero,</para>
  <para style="q" vid="PSA 78:6">
    <char style="add">E</char> si mettessero a narrar<char style="add">le</char> a' lor figliuoli;<verse eid="PSA 78:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7"/>E ponessero in Dio la loro speranza,</para>
  <para style="q" vid="PSA 78:7">E non dimenticassero le opere di Dio.</para>
  <para style="q" vid="PSA 78:7">Ed osservassero i suoi comandamenti;<verse eid="PSA 78:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8"/>E non fossero come i lor padri,</para>
  <para style="q" vid="PSA 78:8">Generazione ritrosa e ribella<note caller="*" style="x"><char style="xo" closed="false">78.8 </char><char style="xk" closed="false">ribella </char><char style="xt" closed="false"><ref loc="EXO 32:9">Esod. 32.9</ref>. <ref loc="DEU 31:27">Deut. 31.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:8">Generazione che non dirizzò il cuor suo,</para>
  <para style="q" vid="PSA 78:8">Il cui spirito non <char style="add">fu</char> leale inverso Dio.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9"/>I figliuoli di Efraim, gente di guerra, <char style="add">buoni</char> arcieri,</para>
  <para style="q" vid="PSA 78:9">Voltarono le spalle al dì della battaglia.<verse eid="PSA 78:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10"/>Non avevano osservato il patto di Dio<note caller="*" style="x"><char style="xo" closed="false">78.10 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="2KI 17:15">2 Re. 17.15</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:10">Ed avevano ricusato di camminar nella sua Legge;<verse eid="PSA 78:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11"/>Ed avevano dimenticate le sue opere,</para>
  <para style="q" vid="PSA 78:11">E le maraviglie ch'egli aveva lor fatte vedere.<verse eid="PSA 78:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12"/>Egli aveva fatti miracoli in presenza de' padri loro,</para>
  <para style="q" vid="PSA 78:12">Nel paese di Egitto, nel territorio di Soan<note caller="*" style="x"><char style="xo" closed="false">78.12 </char><char style="xk" closed="false">Soan </char><char style="xt" closed="false">Esod. cap. 7—12.</char></note>.<verse eid="PSA 78:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13"/>Egli aveva fesso il mare, e li aveva fatti passare per mezzo<note caller="*" style="x"><char style="xo" closed="false">78.13 </char><char style="xk" closed="false">mezzo </char><char style="xt" closed="false"><ref loc="EXO 14:21">Esod. 14.21</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 78:13">Ed aveva fermate le acque come un mucchio.<verse eid="PSA 78:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14"/>E li aveva condotti di giorno colla nuvola,</para>
  <para style="q" vid="PSA 78:14">E tutta notte colla luce del fuoco<note caller="*" style="x"><char style="xo" closed="false">78.14 </char><char style="xk" closed="false">fuoco </char><char style="xt" closed="false"><ref loc="EXO 13:21">Esod. 13.21</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 78:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15"/>Egli aveva schiantate le rupi nel deserto,</para>
  <para style="q" vid="PSA 78:15">E li aveva copiosamente abbeverati, come di gorghi<note caller="*" style="x"><char style="xo" closed="false">78.15 </char><char style="xk" closed="false">gorghi </char><char style="xt" closed="false"><ref loc="EXO 17:6">Esod. 17.6</ref>. <ref loc="NUM 20:11">Num. 20.11</ref>.</char></note>;<verse eid="PSA 78:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16"/>Ed aveva fatto uscir de' ruscelli della roccia,</para>
  <para style="q" vid="PSA 78:16">E colare acque, a guisa di fiumi.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17"/>Ma essi continuarono a peccar contro a lui,</para>
  <para style="q" vid="PSA 78:17">Provocando l'Altissimo a sdegno nel deserto<note caller="*" style="x"><char style="xo" closed="false">78.17 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="DEU 9:22">Deut. 9.22</ref>. <ref loc="HEB 3:16">Ebr. 3.16</ref>.</char></note>;<verse eid="PSA 78:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18"/>E tentarono Iddio nel cuor loro,</para>
  <para style="q" vid="PSA 78:18">Chiedendo vivanda a lor voglia;<verse eid="PSA 78:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19"/>E parlarono contro a Dio<note caller="*" style="x"><char style="xo" closed="false">78.19 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="EXO 16:2">Esod. 16.2</ref>. <ref loc="NUM 11:4">Num. 11.4</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 78:19">
    <char style="add">E</char> dissero: Potrebbe Iddio</para>
  <para style="q" vid="PSA 78:19">Metterci tavola nel deserto?<verse eid="PSA 78:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20"/>Ecco, egli percosse la roccia, e ne colarono acque,</para>
  <para style="q" vid="PSA 78:20">E ne traboccarono torrenti;</para>
  <para style="q" vid="PSA 78:20">Potrebbe egli eziandio dar del pane,</para>
  <para style="q" vid="PSA 78:20">
    <char style="add">O</char> apparecchiar della carne al suo popolo?<verse eid="PSA 78:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21"/>Perciò, il Signore, avendoli uditi, si adirò fieramente<note caller="*" style="x"><char style="xo" closed="false">78.21 </char><char style="xk" closed="false">fieramente </char><char style="xt" closed="false"><ref loc="NUM 11:1">Num. 11.1</ref>,<ref loc="NUM 11:10">10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:21">Ed un fuoco si accese contro a Giacobbe,</para>
  <para style="q" vid="PSA 78:21">Ed anche l'ira <char style="add">gli</char> montò contro ad Israele;<verse eid="PSA 78:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22"/>Perciocchè non avevano creduto in Dio<note caller="*" style="x"><char style="xo" closed="false">78.22 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="HEB 3:18">Ebr. 3.18</ref>. <ref loc="JUD 1:5">Giuda 5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:22">E non si erano confidati nella sua salvazione;<verse eid="PSA 78:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23"/>E pure egli aveva comandato alle nuvole di sopra,</para>
  <para style="q" vid="PSA 78:23">Ed aveva aperte le porte del cielo;<verse eid="PSA 78:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24"/>Ed aveva fatta piovere sopra loro la manna da mangiare,</para>
  <para style="q" vid="PSA 78:24">Ed aveva loro dato del frumento del cielo<note caller="*" style="x"><char style="xo" closed="false">78.24 </char><char style="xk" closed="false">cielo </char><char style="xt" closed="false"><ref loc="EXO 16:4">Esod. 16.4</ref> </char><char style="xta" closed="false">ecc. e rif.</char></note>.<verse eid="PSA 78:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25"/>L'uomo mangiò del pane degli Angeli;</para>
  <para style="q" vid="PSA 78:25">Egli mandò loro della vivanda a sazietà.<verse eid="PSA 78:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26"/>Egli fece levar nel cielo il vento orientale,</para>
  <para style="q" vid="PSA 78:26">E per la sua forza addusse l'Austro;<verse eid="PSA 78:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27"/>E fece piover sopra loro della carne, a guisa di polvere;</para>
  <para style="q" vid="PSA 78:27">Ed uccelli, a giusa della rena del mare.<verse eid="PSA 78:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28"/>E <char style="add">li</char> fece cadere in mezzo al lor campo,</para>
  <para style="q" vid="PSA 78:28">D'intorno a' lor padiglioni.<verse eid="PSA 78:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29"/>Ed essi mangiarono, e furono grandemente satollati;</para>
  <para style="q" vid="PSA 78:29">E <char style="add">Iddio</char> fece lor venire ciò che desideravano<note caller="*" style="x"><char style="xo" closed="false">78.29 </char><char style="xk" closed="false">desideravano </char><char style="xt" closed="false"><ref loc="NUM 11:31">Num. 11.31</ref> ecc.</char></note>.<verse eid="PSA 78:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30"/>Essi non si erano <char style="add">ancora</char> stolti dalla lor cupidigia;</para>
  <para style="q" vid="PSA 78:30">
    <char style="add">Avevano</char> ancora il cibo loro nella bocca,<verse eid="PSA 78:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31"/>Quando l'ira montò a Dio contro a loro,</para>
  <para style="q" vid="PSA 78:31">Ed uccise i più grassi di loro,</para>
  <para style="q" vid="PSA 78:31">Ed abbattè la scelta d'Israele.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32"/>Con tutto ciò peccarono ancora<note caller="*" style="x"><char style="xo" closed="false">78.32 </char><char style="xk" closed="false">ancora </char><char style="xt" closed="false">Num. cap. 14,16,17.</char></note>,</para>
  <para style="q" vid="PSA 78:32">E non credettero alle sue maraviglie.<verse eid="PSA 78:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33"/>Laonde egli consumò i lor giorni in vanità,</para>
  <para style="q" vid="PSA 78:33">E gli anni loro in ispaventi<note caller="*" style="x"><char style="xo" closed="false">78.33 </char><char style="xk" closed="false">ispaventi </char><char style="xt" closed="false"><ref loc="NUM 14:29">Num. 14.29</ref>,<ref loc="NUM 14:35">35</ref>; <ref loc="NUM 26:63-65">26.63-65</ref>.</char></note>.<verse eid="PSA 78:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34"/>Quando egli li uccideva, essi lo richiedevano,</para>
  <para style="q" vid="PSA 78:34">E ricercavano di nuovo Iddio<note caller="*" style="x"><char style="xo" closed="false">78.34 </char><char style="xk" closed="false">Iddio </char><char style="xt" closed="false"><ref loc="HOS 5:15">Os. 5.15</ref>.</char></note>.<verse eid="PSA 78:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35"/>E si ricordavano che Iddio <char style="add">era</char> la lor Rocca<note caller="*" style="x"><char style="xo" closed="false">78.35 </char><char style="xk" closed="false">Rocca </char><char style="xt" closed="false"><ref loc="DEU 32:4">Deut. 32.4</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 78:35">E <char style="add">che</char> l'Iddio altissimo <char style="add">era</char> il lor Redentore<note caller="*" style="x"><char style="xo" closed="false">78.35 </char><char style="xk" closed="false">Redentore </char><char style="xt" closed="false"><ref loc="ISA 41:14">Is. 41.14</ref>; <ref loc="ISA 44:6">44.6</ref>; <ref loc="ISA 63:9">63.9</ref>.</char></note>.<verse eid="PSA 78:35"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36"/>Ma lo lusingavano colla lor bocca<note caller="*" style="x"><char style="xo" closed="false">78.36 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="EZK 33:31">Ezec. 33.31</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:36">E gli mentivano colla lor lingua;<verse eid="PSA 78:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37"/>E il cuor loro non <char style="add">era</char> diritto inverso lui,</para>
  <para style="q" vid="PSA 78:37">E non erano leali nel suo patto.<verse eid="PSA 78:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38"/>E pure egli, <char style="add">che è</char> pietoso<note caller="*" style="x"><char style="xo" closed="false">78.38 </char><char style="xk" closed="false">pietoso </char><char style="xt" closed="false"><ref loc="NUM 14:18">Num. 14.18</ref>,<ref loc="NUM 14:20">20</ref>. <ref loc="ISA 48:9">Is. 48.9</ref>.</char></note>, purgò la loro iniquità, e non li distrusse;</para>
  <para style="q" vid="PSA 78:38">E più e più volte racquetò l'ira sua, e non commosse tutto il suo cruccio<note caller="*" style="x"><char style="xo" closed="false">78.38 </char><char style="xk" closed="false">cruccio </char><char style="xt" closed="false"><ref loc="1KI 21:29">1 Re. 21.29</ref>.</char></note>;<verse eid="PSA 78:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39"/>E si ricordò ch'erano carne<note caller="*" style="x"><char style="xo" closed="false">78.39 </char><char style="xk" closed="false">carne </char><char style="xt" closed="false"><ref loc="PSA 103:14-16">Sal. 103.14-16</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:39">Un fiato che passa, e non ritorna<note caller="*" style="x"><char style="xo" closed="false">78.39 </char><char style="xk" closed="false">ritorna </char><char style="xt" closed="false"><ref loc="JOB 7:7">Giob. 7.7</ref>,<ref loc="JOB 7:16">16</ref>. <ref loc="JAS 4:14">Giac. 4.14</ref>.</char></note>.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40"/>Quante volte lo provocarono essi a sdegno nel deserto,</para>
  <para style="q" vid="PSA 78:40">
    <char style="add">E</char> lo contristarono nella solitudine<note caller="*" style="x"><char style="xo" closed="false">78.40 </char><char style="xk" closed="false">solitudine </char><char style="xt" closed="false"><ref loc="PSA 95:8-11">Sal. 95.8-11</ref>. <ref loc="ISA 63:10">Is. 63.10</ref>. <ref loc="EPH 4:30">Efes. 4.30</ref>. <ref loc="HEB 3:16">Ebr. 3.16</ref>,<ref loc="HEB 3:17">17</ref>.</char></note>!<verse eid="PSA 78:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41"/>E tornarono a tentare Iddio<note caller="*" style="x"><char style="xo" closed="false">78.41 </char><char style="xk" closed="false">Iddio </char><char style="xt" closed="false"><ref loc="NUM 14:22">Num. 14.22</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:41">E limitarono il Santo d'Israele<note caller="*" style="x"><char style="xo" closed="false">78.41 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false">Vers. 20.</char></note>.<verse eid="PSA 78:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42"/>Essi non si erano ricordati della sua mano,</para>
  <para style="q" vid="PSA 78:42">
    <char style="add">Nè</char> del giorno nel quale li aveva riscossi dal nemico.<verse eid="PSA 78:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43"/>(Come egli aveva eseguiti i suoi segni in Egitto,</para>
  <para style="q" vid="PSA 78:43">E i suoi miracoli nel territorio di Soan<note caller="*" style="x"><char style="xo" closed="false">78.43 </char><char style="xk" closed="false">Soan </char><char style="xt" closed="false">Vers. 12 </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 78:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44"/>Ed aveva cangiati i fiumi, e i rivi degli Egizi in sangue<note caller="*" style="x"><char style="xo" closed="false">78.44 </char><char style="xk" closed="false">sangue </char><char style="xt" closed="false"><ref loc="EXO 7:20">Esod. 7.20</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:44">
    <char style="add">Talchè</char> essi non <char style="add">ne</char> potevano bere.<verse eid="PSA 78:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45"/>
    <char style="add">Ed</char> aveva mandata contro a loro una mischia <char style="add">d'insetti</char> che li mangiarono;</para>
  <para style="q" vid="PSA 78:45">E rane, che li distrussero<note caller="*" style="x"><char style="xo" closed="false">78.45 </char><char style="xk" closed="false">distrussero </char><char style="xt" closed="false"><ref loc="EXO 8:6">Esod. 8.6</ref>,<ref loc="EXO 8:24">24</ref>.</char></note>.<verse eid="PSA 78:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46"/>Ed aveva dati i lor frutti a' bruchi,</para>
  <para style="q" vid="PSA 78:46">E le lor fatiche alle locuste<note caller="*" style="x"><char style="xo" closed="false">78.46 </char><char style="xk" closed="false">locuste </char><char style="xt" closed="false"><ref loc="EXO 10:13">Esod. 10.13</ref>,<ref loc="EXO 10:15">15</ref>.</char></note>.<verse eid="PSA 78:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47"/>Ed aveva guastate le lor vigne colla gragnuola<note caller="*" style="x"><char style="xo" closed="false">78.47 </char><char style="xk" closed="false">gragnuola </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">Esod. 9.23-25</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:47">E i lor sicomori colla tempesta.<verse eid="PSA 78:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48"/>Ed aveva dati alla grandine i lor bestiami,</para>
  <para style="q" vid="PSA 78:48">E le lor gregge a' folgori.<verse eid="PSA 78:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49"/>
    <char style="add">Ed</char> aveva mandato sopra loro l'ardore della sua ira,</para>
  <para style="q" vid="PSA 78:49">Indegnazione, cruccio e distretta;</para>
  <para style="q" vid="PSA 78:49">Una mandata d'angeli maligni.<verse eid="PSA 78:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50"/>
    <char style="add">Ed</char> aveva appianato il sentiero alla sua ira,</para>
  <para style="q" vid="PSA 78:50">
    <char style="add">E</char> non aveva scampata l'anima loro dalla morte,</para>
  <para style="q" vid="PSA 78:50">Ed aveva dato il lor bestiame alla mortalità.<verse eid="PSA 78:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51"/>Ed aveva percossi tutti i primogeniti in Egitto<note caller="*" style="x"><char style="xo" closed="false">78.51 </char><char style="xk" closed="false">Egitto </char><char style="xt" closed="false"><ref loc="EXO 12:29">Esod. 12.29</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:51">E le primizie della forza ne' tabernacoli di Cam.<verse eid="PSA 78:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52"/>E <char style="add">ne</char> aveva fatto partire il suo popolo, a guisa di pecore;</para>
  <para style="q" vid="PSA 78:52">E l'aveva condotto per lo deserto, come una mandra.<verse eid="PSA 78:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53"/>E l'aveva guidato sicuramente, senza spavento<note caller="*" style="x"><char style="xo" closed="false">78.53 </char><char style="xk" closed="false">spavento </char><char style="xt" closed="false"><ref loc="EXO 14:19">Esod. 14.19</ref>,<ref loc="EXO 14:20">20</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:53">E il mare aveva coperti i lor nemici<note caller="*" style="x"><char style="xo" closed="false">78.53 </char><char style="xk" closed="false">nemici </char><char style="xt" closed="false"><ref loc="EXO 14:27">Esod. 14.27</ref>,<ref loc="EXO 14:28">28</ref>; <ref loc="EXO 15:10">15.10</ref>.</char></note>.<verse eid="PSA 78:53"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54"/>Ed egli li aveva introdotti nella contrada della sua santità,</para>
  <para style="q" vid="PSA 78:54">Nel monte <char style="add">che</char> la sua destra ha conquistato<note caller="*" style="x"><char style="xo" closed="false">78.54 </char><char style="xk" closed="false">conquistato </char><char style="xt" closed="false"><ref loc="EXO 15:17">Esod. 15.17</ref>. <ref loc="PSA 44:3">Sal. 44.3</ref>.</char></note>.<verse eid="PSA 78:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55"/>Ed aveva scacciate le nazioni d'innanzi a loro,</para>
  <para style="q" vid="PSA 78:55">E le aveva fatte <char style="add">loro</char> scadere in sorte di eredità<note caller="*" style="x"><char style="xo" closed="false">78.55 </char><char style="xk" closed="false">eredità </char><char style="xt" closed="false"><ref loc="JOS 19:51">Gios. 19.51</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:55">Ed aveva stanziate le tribù d'Israele nelle loro stanze.)<verse eid="PSA 78:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56"/>Ed avevano tentato, e provocato a sdegno l'Iddio altissimo,</para>
  <para style="q" vid="PSA 78:56">E non avevano osservate le sue testimonianze<note caller="*" style="x"><char style="xo" closed="false">78.56 </char><char style="xk" closed="false">testimonianze </char><char style="xt" closed="false"><ref loc="JDG 2:11">Giud. 2.11</ref>,<ref loc="JDG 2:12">12</ref>.</char></note>.<verse eid="PSA 78:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57"/>Anzi si erano tratti indietro,</para>
  <para style="q" vid="PSA 78:57">E si erano portati dislealmente,</para>
  <para style="q" vid="PSA 78:57">Come i lor padri<note caller="*" style="x"><char style="xo" closed="false">78.57 </char><char style="xk" closed="false">padri </char><char style="xt" closed="false">Vers. 41. <ref loc="EZK 20:27">Ezec. 20.27</ref>,<ref loc="EZK 20:28">28</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:57">
    <char style="add">E</char> si erano rivolti come un arco fallace;<verse eid="PSA 78:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58"/>E l'avevano provocato ad ira co' loro alti luoghi<note caller="*" style="x"><char style="xo" closed="false">78.58 </char><char style="xk" closed="false">luoghi </char><char style="xt" closed="false"><ref loc="DEU 12:2">Deut. 12.2</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 78:58">E commosso a gelosia colle loro sculture.<verse eid="PSA 78:58"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59"/>Iddio aveva udite <char style="add">queste cose</char>, e se n'era gravemente adirato,</para>
  <para style="q" vid="PSA 78:59">Ed aveva grandemente disdegnato Israele.<verse eid="PSA 78:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60"/>Ed aveva abbandonato il tabernacolo di Silo<note caller="*" style="x"><char style="xo" closed="false">78.60 </char><char style="xk" closed="false">Silo </char><char style="xt" closed="false"><ref loc="1SA 4:11">1 Sam. 4.11</ref>. <ref loc="JER 7:12">Ger. 7.12</ref>,<ref loc="JER 7:14">14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:60">Il padiglione ch'egli aveva piantato per sua stanza fra gli uomini.<verse eid="PSA 78:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61"/>Ed aveva abbandonata la sua forza, <char style="add">ad esser menata</char> in cattività,</para>
  <para style="q" vid="PSA 78:61">E la sua gloria in man del nemico.<verse eid="PSA 78:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62"/>Ed aveva dato il suo popolo alla spada<note caller="*" style="x"><char style="xo" closed="false">78.62 </char><char style="xk" closed="false">spada </char><char style="xt" closed="false"><ref loc="1SA 4:10">1 Sam. 4.10</ref>.</char></note>,</para>
  <para style="q" vid="PSA 78:62">E si era gravemente adirato contro alla sua eredità.<verse eid="PSA 78:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63"/>Il fuoco aveva consumati i suoi giovani;</para>
  <para style="q" vid="PSA 78:63">E le sue vergini non erano state lodate<note caller="*" style="x"><char style="xo" closed="false">78.63 </char><char style="xk" closed="false">lodate </char><char style="xt" closed="false"><ref loc="JER 7:34">Ger. 7.34</ref>; <ref loc="JER 16:9">16.9</ref>; <ref loc="JER 25:10">25.10</ref>.</char></note>.<verse eid="PSA 78:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64"/>I suoi sacerdoti erano caduti per la spada<note caller="*" style="x"><char style="xo" closed="false">78.64 </char><char style="xk" closed="false">spada </char><char style="xt" closed="false"><ref loc="1SA 4:11">1 Sam. 4.11</ref>; <ref loc="1SA 22:18">22.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:64">E le sue vedove non avevano pianto.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65"/>Poi il Signore si risvegliò,</para>
  <para style="q" vid="PSA 78:65">Come uno che fosse stato addormentato;</para>
  <para style="q" vid="PSA 78:65">Come un <char style="add">uomo</char> prode, che dà gridi dopo il vino.<verse eid="PSA 78:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66"/>E percosse i suoi nemici da tergo,</para>
  <para style="q" vid="PSA 78:66">E mise loro addosso un eterno vituperio<note caller="*" style="x"><char style="xo" closed="false">78.66 </char><char style="xk" closed="false">vituperio </char><char style="xt" closed="false"><ref loc="1SA 5:6">1 Sam. 5.6</ref>,<ref loc="1SA 5:12">12</ref>; <ref loc="1SA 6:4">6.4</ref>.</char></note>.<verse eid="PSA 78:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67"/>Ed avendo riprovato il tabernacolo di Giuseppe,</para>
  <para style="q" vid="PSA 78:67">E non avendo eletta la tribù di Efraim;<verse eid="PSA 78:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68"/>Egli elesse la tribù di Giuda;</para>
  <para style="q" vid="PSA 78:68">Il monte di Sion, il quale egli ama<note caller="*" style="x"><char style="xo" closed="false">78.68 </char><char style="xk" closed="false">ama </char><char style="xt" closed="false"><ref loc="PSA 87:2">Sal. 87.2</ref>.</char></note>.<verse eid="PSA 78:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69"/>Ed edificò il suo santuario<note caller="*" style="x"><char style="xo" closed="false">78.69 </char><char style="xk" closed="false">santuario </char><char style="xt" closed="false">1 Re. cap. 6</char></note>, a guisa di <char style="add">palazzi</char> eccelsi;</para>
  <para style="q" vid="PSA 78:69">Come la terra <char style="add">ch</char>'egli ha fondata in perpetuo.<verse eid="PSA 78:69"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70"/>Ed elesse Davide, suo servitore,</para>
  <para style="q" vid="PSA 78:70">E lo prese dalle mandre delle pecore<note caller="*" style="x"><char style="xo" closed="false">78.70 </char><char style="xk" closed="false">pecore </char><char style="xt" closed="false"><ref loc="1SA 16:11">1 Sam. 16.11</ref>,<ref loc="1SA 16:12">12</ref>. <ref loc="2SA 7:8">2 Sam. 7.8</ref>.</char></note>.<verse eid="PSA 78:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71"/>Di dietro alle <char style="add">bestie</char> allattanti</para>
  <para style="q" vid="PSA 78:71">Egli lo condusse a pascer Giacobbe, suo popolo;</para>
  <para style="q" vid="PSA 78:71">Ed Israele sua eredità<note caller="*" style="x"><char style="xo" closed="false">78.71 </char><char style="xk" closed="false">eredità </char><char style="xt" closed="false"><ref loc="2SA 5:2">2 Sam. 5.2</ref>.</char></note>.<verse eid="PSA 78:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72"/>Ed egli li pasturò, secondo l'integrità del suo cuore<note caller="*" style="x"><char style="xo" closed="false">78.72 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="1KI 9:4">1 Re. 9.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 78:72">E li guidò, secondo il gran senno delle sue mani.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">SALMO LXXIX</para>
  <para style="s1">Desolazione di Gerusalemme; preghiera per ottener soccorso da Dio</para>
  <para style="d">Salmo di Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1"/>O DIO, le nazioni sono entrate nella tua eredità,</para>
  <para style="q" vid="PSA 79:1">Hanno contaminato il Tempio della tua santità,</para>
  <para style="q" vid="PSA 79:1">Hanno ridotta Gerusalemme in monti di ruine<note caller="*" style="x"><char style="xo" closed="false">79.1 </char><char style="xk" closed="false">ruine </char><char style="xt" closed="false"><ref loc="2KI 25:9">2 Re. 25.9</ref>,<ref loc="2KI 25:10">10</ref>. <ref loc="2CH 36:19">2 Cron. 36.19</ref>. <ref loc="PSA 74:2-7">Sal. 74.2-7</ref>. <ref loc="MIC 3:12">Mic. 3.12</ref>.</char></note>.<verse eid="PSA 79:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2"/>Hanno dati i corpi morti de' tuoi servitori</para>
  <para style="q" vid="PSA 79:2">Agli uccelli del cielo <char style="add">per</char> cibo;</para>
  <para style="q" vid="PSA 79:2">
    <char style="add">E</char> la carne de' tuoi santi alle fiere della terra<note caller="*" style="x"><char style="xo" closed="false">79.2 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="DEU 28:25">Deut. 28.25</ref>,<ref loc="DEU 28:26">26</ref>. <ref loc="JER 7:33">Ger. 7.33</ref>; <ref loc="JER 15:3">15.3</ref>; <ref loc="JER 19:7">19.7</ref>; <ref loc="JER 34:20">34.20</ref>.</char></note>.<verse eid="PSA 79:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3"/>Hanno sparso il sangue loro come acqua</para>
  <para style="q" vid="PSA 79:3">Intorno a Gerusalemme;</para>
  <para style="q" vid="PSA 79:3">E non <char style="add">vi è stato</char> alcuno che <char style="add">li</char> seppellisse<note caller="*" style="x"><char style="xo" closed="false">79.3 </char><char style="xk" closed="false">seppellisse </char><char style="xt" closed="false"><ref loc="JER 14:16">Ger. 14.16</ref>; <ref loc="JER 16:4">16.4</ref>.</char></note>.<verse eid="PSA 79:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4"/>Noi siamo stati in vituperio a' nostri vicini;</para>
  <para style="q" vid="PSA 79:4">In ischerno, e in derisione a quelli che <char style="add">stanno</char> d'intorno a noi<note caller="*" style="x"><char style="xo" closed="false">79.4 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="DAN 9:16">Dan. 9.16</ref>.</char></note>.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5"/>Infino a quando, Signore, sarai adirato?</para>
  <para style="q" vid="PSA 79:5">La tua gelosia arderà ella come un fuoco in perpetuo?<verse eid="PSA 79:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6"/>Spandi l'ira tua sopra le genti che non ti conoscono,</para>
  <para style="q" vid="PSA 79:6">E sopra i regni che non invocano il tuo Nome.<verse eid="PSA 79:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7"/>Perciocchè essi hanno divorato Giacobbe,</para>
  <para style="q" vid="PSA 79:7">Ed hanno desolata la sua stanza.<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8"/>Non ridurti a memoria contro a noi l'iniquità de' passati;</para>
  <para style="q" vid="PSA 79:8">Affrettati, venganci incontro le tue compassioni;</para>
  <para style="q" vid="PSA 79:8">Perciocchè noi siam grandemente miseri.<verse eid="PSA 79:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9"/>Soccorrici, o Dio della nostra salute, per amor della gloria del tuo Nome,</para>
  <para style="q" vid="PSA 79:9">E liberaci; e fa' il purgamento de' nostri peccati, per amor del tuo Nome<note caller="*" style="x"><char style="xo" closed="false">79.9 </char><char style="xk" closed="false">Nome </char><char style="xt" closed="false"><ref loc="JER 14:7">Ger. 14.7</ref>,<ref loc="JER 14:21">21</ref>.</char></note><verse eid="PSA 79:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10"/>Perchè direbbero le genti: Ove <char style="add">è</char> l'Iddio loro<note caller="*" style="x"><char style="xo" closed="false">79.10 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PSA 42:10">Sal. 42.10</ref>; <ref loc="PSA 115:2">115.2</ref>.</char></note>?</para>
  <para style="q" vid="PSA 79:10">
    <char style="add">Fa' che</char> sia conosciuta fra le genti, nel nostro cospetto,</para>
  <para style="q" vid="PSA 79:10">La vendetta del sangue sparso de' tuoi servitori.<verse eid="PSA 79:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11"/>Vengano davanti a te i gemiti de' prigioni;</para>
  <para style="q" vid="PSA 79:11">Secondo la grandezza del tuo braccio,</para>
  <para style="q" vid="PSA 79:11">Scampa quelli che son condannati a morte.<verse eid="PSA 79:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12"/>E rendi a' nostri vicini in seno, a sette doppi,</para>
  <para style="q" vid="PSA 79:12">Il vituperio che ti hanno fatto, o Signore.<verse eid="PSA 79:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13"/>E noi, tuo popolo, e greggia del tuo pasco<note caller="*" style="x"><char style="xo" closed="false">79.13 </char><char style="xk" closed="false">pasco </char><char style="xt" closed="false"><ref loc="PSA 74:1">Sal. 74.1</ref>; <ref loc="PSA 95:7">95.7</ref>; <ref loc="PSA 100:3">100.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 79:13">Ti celebreremo in perpetuo;</para>
  <para style="q" vid="PSA 79:13">
    <char style="add">E</char> racconteremo la tua lode per ogni età<note caller="*" style="x"><char style="xo" closed="false">79.13 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="ISA 43:21">Is. 43.21</ref>.</char></note>.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">SALMO LXXX</para>
  <para style="s1">Preghiera a Dio, affinchè liberi la sua vigna dai guastatori</para>
  <para style="d">Salmo di Asaf, <char style="add">dato</char> al Capo de' Musici sopra Sosannim-edut</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1"/>O PASTORE d'Israele, che guidi Giuseppe come una greggia,</para>
  <para style="q" vid="PSA 80:1">Porgi gli orecchi;</para>
  <para style="q" vid="PSA 80:1">Tu che siedi sopra i Cherubini<note caller="*" style="x"><char style="xo" closed="false">80.1 </char><char style="xk" closed="false">Cherubini </char><char style="xt" closed="false"><ref loc="EXO 25:20">Esod. 25.20</ref>,<ref loc="EXO 25:22">22</ref>.</char></note>,</para>
  <para style="q" vid="PSA 80:1">Apparisci in gloria.<verse eid="PSA 80:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2"/>Eccita la tua potenza davanti ad Efraim, ed a Beniamino, ed a Manasse<note caller="*" style="x"><char style="xo" closed="false">80.2 </char><char style="xk" closed="false">Manasse </char><char style="xt" closed="false"><ref loc="NUM 2:18-23">Num. 2.18-23</ref>.</char></note>;</para>
  <para style="q" vid="PSA 80:2">E vieni a nostra salute.<verse eid="PSA 80:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3"/>O Dio, ristoraci;</para>
  <para style="q" vid="PSA 80:3">E fa' risplendere il tuo volto<note caller="*" style="x"><char style="xo" closed="false">80.3 </char><char style="xk" closed="false">volto </char><char style="xt" closed="false"><ref loc="NUM 6:25">Num. 6.25</ref> </char><char style="xta" closed="false">e rif.</char></note>, e noi saremo salvati.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4"/>O Signore Iddio degli eserciti,</para>
  <para style="q" vid="PSA 80:4">Infino a quando fumerai tu contro all'orazione del tuo popolo?<verse eid="PSA 80:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5"/>Tu li hai cibati di pan di pianto,</para>
  <para style="q" vid="PSA 80:5">E li hai abbeverati di lagrime a larga misura.<verse eid="PSA 80:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6"/>Tu ci hai posti <char style="add">in</char> contesa co' nostri vicini;</para>
  <para style="q" vid="PSA 80:6">E i nostri nemici si fanno beffe <char style="add">di noi</char>.<verse eid="PSA 80:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7"/>O Dio degli eserciti, ristoraci;</para>
  <para style="q" vid="PSA 80:7">E fa' risplendere il tuo volto, e noi saremo salvati.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8"/>Tu avevi trasportata di Egitto una vigna<note caller="*" style="x"><char style="xo" closed="false">80.8 </char><char style="xk" closed="false">vigna </char><char style="xt" closed="false"><ref loc="ISA 5:1-7">Is. 5.1-7</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 80:8">Tu avevi cacciate le nazioni, e l'avevi piantata<note caller="*" style="x"><char style="xo" closed="false">80.8 </char><char style="xk" closed="false">piantata </char><char style="xt" closed="false"><ref loc="PSA 44:2">Sal. 44.2</ref>,<ref loc="PSA 44:3">3</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 80:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9"/>Tu avevi sgomberato davanti a lei <char style="add">il suo luogo</char><note caller="*" style="x"><char style="xo" closed="false">80.9 </char><char style="xk" closed="false"><char style="add">luogo</char> </char><char style="xt" closed="false"><ref loc="EXO 23:28">Esod. 23.28</ref>. <ref loc="JOS 24:12">Gios. 24.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 80:9">Ed avevi fatto ch'ella aveva messe radici, ed aveva empiuta la terra.<verse eid="PSA 80:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10"/>I monti erano coperti della sua ombra,</para>
  <para style="q" vid="PSA 80:10">E i suoi tralci <char style="add">erano come</char> cedri altissimi.<verse eid="PSA 80:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11"/>Aveva gettati i suoi rami infino al mare,</para>
  <para style="q" vid="PSA 80:11">E i suoi rampolli infino al fiume<note caller="*" style="x"><char style="xo" closed="false">80.11 </char><char style="xk" closed="false">fiume </char><char style="xt" closed="false"><ref loc="PSA 72:8">Sal. 72.8</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 80:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12"/>Perchè hai tu rotte le sue chiusure,</para>
  <para style="q" vid="PSA 80:12">Sì che tutti i passanti l'han vendemmiata?<verse eid="PSA 80:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13"/>I cinghiali l'hanno guastata,</para>
  <para style="q" vid="PSA 80:13">E le fiere della campagna l'hanno pascolata.<verse eid="PSA 80:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14"/>O Dio degli eserciti, rivolgiti, ti prego;</para>
  <para style="q" vid="PSA 80:14">Riguarda dal cielo, e vedi, e visita questa vigna.<verse eid="PSA 80:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15"/>E le piante che la tua destra aveva piantate,</para>
  <para style="q" vid="PSA 80:15">E le propaggini <char style="add">che</char> tu ti avevi fortificate.<verse eid="PSA 80:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16"/>
    <char style="add">Quella è</char> arsa col fuoco, ella è ricisa fino dal piè;</para>
  <para style="q" vid="PSA 80:16">
    <char style="add">Quelle</char> periscono per lo sgridar della tua faccia<note caller="*" style="x"><char style="xo" closed="false">80.16 </char><char style="xk" closed="false">faccia </char><char style="xt" closed="false"><ref loc="PSA 39:11">Sal. 39.11</ref>; <ref loc="PSA 76:7">76.7</ref>.</char></note>.<verse eid="PSA 80:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17"/>Sia la tua mano sopra l'uomo della tua destra,</para>
  <para style="q" vid="PSA 80:17">Sopra il figliuol dell'uomo <char style="add">che</char> tu ti avevi fortificato<note caller="*" style="x"><char style="xo" closed="false">80.17 </char><char style="xk" closed="false">fortificato </char><char style="xt" closed="false"><ref loc="PSA 89:21">Sal. 89.21</ref>. <ref loc="LUK 1:66">Luc. 1.66</ref>.</char></note>.<verse eid="PSA 80:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18"/>E noi non ci trarremo indietro da te;</para>
  <para style="q" vid="PSA 80:18">Mantienci in vita, e noi invocheremo il tuo Nome.<verse eid="PSA 80:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19"/>O Signore Iddio degli eserciti, ristoraci;</para>
  <para style="q" vid="PSA 80:19">Fa' risplendere il tuo volto, e noi saremo salvati.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">SALMO LXXXI</para>
  <para style="s1">Dio rimprovera Israele d'essere stato ingrato e ribelle</para>
  <para style="d">
    <char style="add">Salmo</char> di Asaf, <char style="add">dato</char> al Capo de' Musici, sopra Ghittit</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1"/>CANTATE lietamente a Dio nostra forza;</para>
  <para style="q" vid="PSA 81:1">Date grida di allegrezza all'Iddio di Giacobbe.<verse eid="PSA 81:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2"/>Prendete a salmeggiare, ed aggiugnete<char style="add">vi</char> il tamburo,</para>
  <para style="q" vid="PSA 81:2">La cetera dilettevole, col saltero.<verse eid="PSA 81:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3"/>Sonate colla tromba alle calendi,</para>
  <para style="q" vid="PSA 81:3">Nella nuova luna, al giorno della nostra festa.<verse eid="PSA 81:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4"/>Perciocchè questo <char style="add">è</char> uno statuto <char style="add">dato</char> ad Israele,</para>
  <para style="q" vid="PSA 81:4">Una legge dell'Iddio di Giacobbe<note caller="*" style="x"><char style="xo" closed="false">81.4 </char><char style="xk" closed="false">Giacobbe </char><char style="xt" closed="false"><ref loc="LEV 23:24">Lev. 23.24</ref>. <ref loc="NUM 10:10">Num. 10.10</ref>; <ref loc="NUM 29:1">29.1</ref>.</char></note>.<verse eid="PSA 81:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5"/>Egli lo costituì <char style="add">per</char> una testimonianza in Giuseppe,</para>
  <para style="q" vid="PSA 81:5">Dopo ch'egli fu uscito fuori contro al paese di Egitto;</para>
  <para style="q" vid="PSA 81:5">
    <char style="add">Allora che</char> io udii un linguaggio <char style="add">che</char> io non intendeva<note caller="*" style="x"><char style="xo" closed="false">81.5 </char><char style="xk" closed="false">intendeva </char><char style="xt" closed="false"><ref loc="PSA 114:1">Sal. 114.1</ref>.</char></note>.<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6"/>Io ho ritratte, <char style="add">dice Iddio</char>, le sue spalle da' pesi;</para>
  <para style="q" vid="PSA 81:6">Le sue mani si son dipartite dalle corbe<note caller="*" style="x"><char style="xo" closed="false">81.6 </char><char style="xk" closed="false">corbe </char><char style="xt" closed="false"><ref loc="EXO 1:14">Esod. 1.14</ref>.</char></note>.<verse eid="PSA 81:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7"/>
    <char style="add">O popol mio</char>, tu gridasti <char style="add">essendo</char> in distretta, ed io te <char style="add">ne</char> trassi fuori<note caller="*" style="x"><char style="xo" closed="false">81.7 </char><char style="xk" closed="false">fuori </char><char style="xt" closed="false"><ref loc="EXO 2:23">Esod. 2.23</ref>; <ref loc="EXO 14:10">14.10</ref>. <ref loc="PSA 50:15">Sal. 50.15</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 81:7">Io ti risposi, <char style="add">stando</char> nel nascondimento del tuono<note caller="*" style="x"><char style="xo" closed="false">81.7 </char><char style="xk" closed="false">tuono </char><char style="xt" closed="false"><ref loc="EXO 19:19">Esod. 19.19</ref>.</char></note>;</para>
  <para style="q" vid="PSA 81:7">Io ti provai alle acque di Meriba<note caller="*" style="x"><char style="xo" closed="false">81.7 </char><char style="xk" closed="false">Meriba </char><char style="xt" closed="false"><ref loc="EXO 17:6">Esod. 17.6</ref>,<ref loc="EXO 17:7">7</ref>. <ref loc="NUM 20:13">Num. 20.13</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 81:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8"/>Io <char style="add">ti dissi</char>: Ascolta, popol mio, ed io ti farò le mie protestazioni;</para>
  <para style="q" vid="PSA 81:8">O Israele, attendessi tu pure a me!<verse eid="PSA 81:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9"/>Non siavi fra te alcun dio strano,</para>
  <para style="q" vid="PSA 81:9">E non adorare alcun dio forestiere<note caller="*" style="x"><char style="xo" closed="false">81.9 </char><char style="xk" closed="false">forestiere </char><char style="xt" closed="false"><ref loc="EXO 20:3">Esod. 20.3</ref>,<ref loc="EXO 20:5">5</ref>.</char></note>.<verse eid="PSA 81:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10"/>Io <char style="add">sono</char> il Signore Iddio tuo, che ti ho tratto fuor del paese di Egitto<note caller="*" style="x"><char style="xo" closed="false">81.10 </char><char style="xk" closed="false">Egitto </char><char style="xt" closed="false"><ref loc="EXO 20:2">Esod. 20.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 81:10">Allarga pur la tua bocca, ed io l'empierò<note caller="*" style="x"><char style="xo" closed="false">81.10 </char><char style="xk" closed="false">empierò </char><char style="xt" closed="false"><ref loc="JHN 15:7">Giov. 15.7</ref>. <ref loc="EPH 3:20">Efes. 3.20</ref>.</char></note>.<verse eid="PSA 81:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11"/>Ma il mio popolo non ha atteso alla mia voce;</para>
  <para style="q" vid="PSA 81:11">Ed Israele non mi ha acconsentito<note caller="*" style="x"><char style="xo" closed="false">81.11 </char><char style="xk" closed="false">acconsentito </char><char style="xt" closed="false"><ref loc="EXO 32:1">Esod. 32.1</ref>. <ref loc="DEU 32:15">Deut. 32.15</ref>,<ref loc="DEU 32:18">18</ref>.</char></note>.<verse eid="PSA 81:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12"/>Onde io li ho abbandonati alla durezza del cuor loro;</para>
  <para style="q" vid="PSA 81:12">
    <char style="add">Acciocchè</char> camminino secondo i lor consigli<note caller="*" style="x"><char style="xo" closed="false">81.12 </char><char style="xk" closed="false">consigli </char><char style="xt" closed="false"><ref loc="ACT 14:16">Fat. 14.16</ref>. <ref loc="ROM 1:24">Rom. 1.24</ref>,<ref loc="ROM 1:26">26</ref>.</char></note>.<verse eid="PSA 81:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13"/>Oh! avesse pure ubbidito il mio popolo,</para>
  <para style="q" vid="PSA 81:13">
    <char style="add">E</char> fosse Israele camminato nelle mie vie<note caller="*" style="x"><char style="xo" closed="false">81.13 </char><char style="xk" closed="false">vie </char><char style="xt" closed="false"><ref loc="DEU 5:29">Deut. 5.29</ref>; <ref loc="DEU 10:12">10.12</ref>,<ref loc="DEU 10:13">13</ref>; <ref loc="DEU 32:29">32.29</ref>. <ref loc="ISA 48:18">Is. 48.18</ref>.</char></note>!<verse eid="PSA 81:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14"/>Io avrei in uno stante abbattuti i lor nemici,</para>
  <para style="q" vid="PSA 81:14">Ed avrei rivolta la mia mano contro a' loro avversari.<verse eid="PSA 81:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15"/>Quelli che odiano il Signore si sarebbero infinti inverso loro;</para>
  <para style="q" vid="PSA 81:15">E il tempo loro sarebbe durato in perpetuo.<verse eid="PSA 81:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16"/>E <char style="add">Iddio</char> li avrebbe cibati di grascia di frumento;</para>
  <para style="q" vid="PSA 81:16">E dalla roccia, <char style="add">dice egli</char>, io ti avrei satollato di miele.<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">SALMO LXXXII</para>
  <para style="s1">I giudici osservino la giustizia</para>
  <para style="d">Salmo di Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1"/>IDDIO è presente nella raunanza di Dio;</para>
  <para style="q" vid="PSA 82:1">Egli giudica nel mezzo degl'iddii<note caller="*" style="x"><char style="xo" closed="false">82.1 </char><char style="xk" closed="false">iddii </char><char style="xt" closed="false"><ref loc="2CH 19:5-7">2 Cron. 19.5-7</ref>. <ref loc="ECC 5:8">Eccl. 5.8</ref>.</char></note>.<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2"/>Infino a quando giudicherete voi ingiustamente,</para>
  <para style="q" vid="PSA 82:2">Ed avrete riguardo alla qualità delle persone degli empi<note caller="*" style="x"><char style="xo" closed="false">82.2 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="DEU 1:17">Deut. 1.17</ref>; <ref loc="DEU 10:17">10.17</ref>. <ref loc="PRO 18:5">Prov. 18.5</ref>.</char></note>? <char style="qs">(Sela.)</char><verse eid="PSA 82:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3"/>Fate ragione al misero ed all'orfano;</para>
  <para style="q" vid="PSA 82:3">Fate diritto all'afflitto ed al povero<note caller="*" style="x"><char style="xo" closed="false">82.3 </char><char style="xk" closed="false">povero </char><char style="xt" closed="false"><ref loc="PSA 41:1">Sal. 41.1</ref>. <ref loc="JER 22:3">Ger. 22.3</ref>.</char></note>.<verse eid="PSA 82:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4"/>Liberate il misero ed il bisognoso<note caller="*" style="x"><char style="xo" closed="false">82.4 </char><char style="xk" closed="false">bisognoso </char><char style="xt" closed="false"><ref loc="JOB 29:12">Giob. 29.12</ref>. <ref loc="PRO 24:11">Prov. 24.11</ref>,<ref loc="PRO 24:12">12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 82:4">Riscotete<char style="add">lo</char> dalla mano degli empi.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5"/>Essi non hanno alcun conoscimento, nè senno<note caller="*" style="x"><char style="xo" closed="false">82.5 </char><char style="xk" closed="false">senno </char><char style="xt" closed="false"><ref loc="JER 4:22">Ger. 4.22</ref>. <ref loc="MIC 3:1">Mic. 3.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 82:5">Camminano in tenebre<note caller="*" style="x"><char style="xo" closed="false">82.5 </char><char style="xk" closed="false">tenebre </char><char style="xt" closed="false"><ref loc="PRO 2:13">Prov. 2.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 82:5">Tutti i fondamenti della terra sono smossi.<verse eid="PSA 82:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6"/>Io ho detto: Voi <char style="add">siete</char> dii<note caller="*" style="x"><char style="xo" closed="false">82.6 </char><char style="xk" closed="false">dii </char><char style="xta" closed="false">Ver. </char><char style="xt" closed="false"><ref loc="JHN 10:34">Giov. 10.34</ref>.</char></note>;</para>
  <para style="q" vid="PSA 82:6">E tutti <char style="add">siete</char> figliuoli dell'Altissimo.<verse eid="PSA 82:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7"/>Tuttavolta voi morrete come un altro uomo,</para>
  <para style="q" vid="PSA 82:7">E caderete come qualunque <char style="add">altro</char> de' principi.<verse eid="PSA 82:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8"/>Levati, o Dio, giudica la terra;</para>
  <para style="q" vid="PSA 82:8">Perciocchè tu devi essere il possessore di tutte le genti<note caller="*" style="x"><char style="xo" closed="false">82.8 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="PSA 2:8">Sal. 2.8</ref>. <ref loc="REV 11:15">Apoc. 11.15</ref>.</char></note>.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">SALMO LXXXIII</para>
  <para style="s1">Le genti congiurate contro ad Israele. Preghiera a Dio perchè liberi il suo popolo</para>
  <para style="d">Cantico di Salmo di Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1"/>O DIO, non istartene cheto;</para>
  <para style="q" vid="PSA 83:1">Non tacere, e non riposarti, o Dio.<verse eid="PSA 83:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2"/>Perciocchè ecco, i tuoi nemici romoreggiano<note caller="*" style="x"><char style="xo" closed="false">83.2 </char><char style="xk" closed="false">romoreggiano </char><char style="xt" closed="false"><ref loc="PSA 2:1">Sal. 2.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 83:2">E quelli che ti odiano alzano il capo.<verse eid="PSA 83:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3"/>Hanno preso un cauto consiglio contro al tuo popolo,</para>
  <para style="q" vid="PSA 83:3">E si son consigliati contro a quelli che son nascosti appo te<note caller="*" style="x"><char style="xo" closed="false">83.3 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 27:5">Sal. 27.5</ref>; <ref loc="PSA 31:20">31.20</ref>.</char></note>.<verse eid="PSA 83:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4"/>Hanno detto: Venite, e distruggiamoli,</para>
  <para style="q" vid="PSA 83:4">Sì che non sieno più nazione<note caller="*" style="x"><char style="xo" closed="false">83.4 </char><char style="xk" closed="false">nazione </char><char style="xt" closed="false"><ref loc="EST 3:6">Est. 3.6</ref> ecc. <ref loc="JER 11:19">Ger. 11.19</ref>.</char></note>,</para>
  <para style="q" vid="PSA 83:4">E che il nome d'Israele non sia più ricordato.<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5"/>Perciocchè si son di pari consentimento consigliati insieme,</para>
  <para style="q" vid="PSA 83:5">
    <char style="add">Ed</char> han fatta lega contro a te.<verse eid="PSA 83:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6"/>Le tende di Edom, e gl'Ismaeliti;</para>
  <para style="q" vid="PSA 83:6">I Moabiti, e gli Hagareni<note caller="*" style="x"><char style="xo" closed="false">83.6 </char><char style="xk" closed="false">Hagareni </char><char style="xt" closed="false"><ref loc="2CH 20:1">2 Cron. 20.1</ref>,<ref loc="2CH 20:10">10</ref>,<ref loc="2CH 20:11">11</ref>.</char></note>;<verse eid="PSA 83:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7"/>I Ghebaliti, gli Ammoniti, e gli Amalechiti;</para>
  <para style="q" vid="PSA 83:7">I Filistei, insieme con gli abitanti di Tiro;<verse eid="PSA 83:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8"/>Gli Assiri eziandio si son congiunti con loro;</para>
  <para style="q" vid="PSA 83:8">Sono stati il braccio de' figliuoli di Lot. <char style="qs">(Sela.)</char><verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9"/>Fa' loro come <char style="add">tu facesti</char> a Madian<note caller="*" style="x"><char style="xo" closed="false">83.9 </char><char style="xk" closed="false">Madian </char><char style="xt" closed="false"><ref loc="NUM 31:7">Num. 31.7</ref>. <ref loc="JDG 7:22">Giud. 7.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 83:9">Come <char style="add">a</char> Sisera<note caller="*" style="x"><char style="xo" closed="false">83.9 </char><char style="xk" closed="false">Sisera </char><char style="xt" closed="false"><ref loc="JDG 4:15">Giud. 4.15</ref>,<ref loc="JDG 4:24">24</ref>; <ref loc="JDG 5:21">5.21</ref>.</char></note>, come <char style="add">a</char> Iabin, al torrente di Chison;<verse eid="PSA 83:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10"/>I <char style="add">quali</char> furono sconfitti in Endor,</para>
  <para style="q" vid="PSA 83:10">E furono <char style="add">per</char> letame alla terra.<verse eid="PSA 83:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11"/>Fa' che i lor principi sieno come Oreb e Zeeb;</para>
  <para style="q" vid="PSA 83:11">E tutti i lor signori come Zeba, e Salmunna<note caller="*" style="x"><char style="xo" closed="false">83.11 </char><char style="xk" closed="false">Salmunna </char><char style="xt" closed="false"><ref loc="JDG 7:25">Giud. 7.25</ref>; <ref loc="JDG 8:12">8.12</ref>,<ref loc="JDG 8:21">21</ref>.</char></note>;<verse eid="PSA 83:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12"/>Perciocchè hanno detto:</para>
  <para style="q" vid="PSA 83:12">Conquistiamoci gli abitacoli di Dio.<verse eid="PSA 83:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13"/>Dio mio, falli essere come una palla<note caller="*" style="x"><char style="xo" closed="false">83.13 </char><char style="xk" closed="false">palla </char><char style="xt" closed="false"><ref loc="ISA 17:13">Is. 17.13</ref>,<ref loc="ISA 17:14">14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 83:13">Come della stoppia al vento<note caller="*" style="x"><char style="xo" closed="false">83.13 </char><char style="xk" closed="false">vento </char><char style="xt" closed="false"><ref loc="PSA 1:4">Sal. 1.4</ref>; <ref loc="PSA 35:5">35.5</ref>.</char></note>.<verse eid="PSA 83:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14"/>Come il fuoco brucia un bosco,</para>
  <para style="q" vid="PSA 83:14">E come la fiamma divampa i monti.<verse eid="PSA 83:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15"/>Così perseguitali colla tua tempesta,</para>
  <para style="q" vid="PSA 83:15">E conturbali col tuo turbo.<verse eid="PSA 83:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16"/>Empi le lor facce di vituperio;</para>
  <para style="q" vid="PSA 83:16">E <char style="add">fa' che</char> cerchino il tuo Nome, o Signore.<verse eid="PSA 83:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17"/>Sieno svergognati, e conturbati in perpetuo;</para>
  <para style="q" vid="PSA 83:17">E sieno confusi, e periscano;<verse eid="PSA 83:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18"/>E conoscano che tu, il cui Nome è il Signore<note caller="*" style="x"><char style="xo" closed="false">83.18 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="EXO 6:3">Esod. 6.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 83:18">
    <char style="add">Sei</char> il solo Altissimo sopra tutta la terra<note caller="*" style="x"><char style="xo" closed="false">83.18 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 92:8">Sal. 92.8</ref>; <ref loc="PSA 97:9">97.9</ref>; <ref loc="PSA 113:4">113.4</ref>.</char></note>.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">SALMO LXXXIV</para>
  <para style="s1">Felice chi abita nel Santuario di Dio</para>
  <para style="d">Salmo de' figliuoli di Core, <char style="add">dato</char> al Capo de' Musici, sopra Ghittit</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1"/>OH quanto <char style="add">sono</char> amabili i tuoi tabernacoli,</para>
  <para style="q" vid="PSA 84:1">O Signor degli eserciti<note caller="*" style="x"><char style="xo" closed="false">84.1 </char><char style="xk" closed="false">eserciti </char><char style="xt" closed="false"><ref loc="PSA 27:4">Sal. 27.4</ref> </char><char style="xta" closed="false">e rif.</char></note>!<verse eid="PSA 84:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2"/>L'anima mia brama i cortili del Signore, e vien meno;</para>
  <para style="q" vid="PSA 84:2">Il mio cuore e la mia carne sclamano all'Iddio vivente<note caller="*" style="x"><char style="xo" closed="false">84.2 </char><char style="xk" closed="false">vivente </char><char style="xt" closed="false"><ref loc="PSA 42:1">Sal. 42.1</ref>,<ref loc="PSA 42:2">2</ref>; <ref loc="PSA 63:1">63.1</ref>; <ref loc="PSA 73:26">73.26</ref>; <ref loc="PSA 119:20">119.20</ref>.</char></note>.<verse eid="PSA 84:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3"/>Anche la passera si trova stanza,</para>
  <para style="q" vid="PSA 84:3">E la rondinella nido, ove posino i lor figli</para>
  <para style="q" vid="PSA 84:3">Presso a' tuoi altari, o Signor degli eserciti,</para>
  <para style="q" vid="PSA 84:3">Re mio, e Dio mio.<verse eid="PSA 84:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4"/>Beati coloro che abitano nella tua Casa<note caller="*" style="x"><char style="xo" closed="false">84.4 </char><char style="xk" closed="false">Casa </char><char style="xt" closed="false"><ref loc="PSA 65:4">Sal. 65.4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 84:4">
    <char style="add">E</char> ti lodano del continuo. <char style="qs">(Sela.)</char><verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5"/>Beato l'uomo che ha forza in te;</para>
  <para style="q" vid="PSA 84:5">
    <char style="add">E coloro</char> che hanno le <char style="add">tue</char> vie nel cuore;<verse eid="PSA 84:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6"/>
    <char style="add">I quali</char>, passando per la valle de' gelsi,</para>
  <para style="q" vid="PSA 84:6">La riducono in fonti,</para>
  <para style="q" vid="PSA 84:6">
    <char style="add">Ed</char> anche in pozze <char style="add">che</char> la pioggia empie.<verse eid="PSA 84:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7"/>Camminano di valore in valore<note caller="*" style="x"><char style="xo" closed="false">84.7 </char><char style="xk" closed="false">valore </char><char style="xt" closed="false"><ref loc="PRO 4:18">Prov. 4.18</ref>. <ref loc="ISA 40:31">Is. 40.31</ref>. <ref loc="JHN 1:16">Giov. 1.16</ref>. <ref loc="2CO 3:18">2 Cor. 3.18</ref>.</char></note>.</para>
  <para style="q" vid="PSA 84:7">
    <char style="add">Finchè</char> compariscano davanti a Dio in Sion<note caller="*" style="x"><char style="xo" closed="false">84.7 </char><char style="xk" closed="false">Sion </char><char style="xt" closed="false"><ref loc="DEU 16:16">Deut. 16.16</ref>. <ref loc="ZEC 14:16">Zac. 14.16</ref>.</char></note>.<verse eid="PSA 84:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8"/>O Signore Iddio degli eserciti, ascolta la mia orazione;</para>
  <para style="q" vid="PSA 84:8">Porgi l'orecchio, o Dio di Giacobbe. <char style="qs">(Sela.)</char><verse eid="PSA 84:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9"/>O Dio, scudo nostro<note caller="*" style="x"><char style="xo" closed="false">84.9 </char><char style="xk" closed="false">nostro </char><char style="xt" closed="false"><ref loc="GEN 15:1">Gen. 15.1</ref> </char><char style="xta" closed="false">e rif.</char></note>, vedi,</para>
  <para style="q" vid="PSA 84:9">E riguarda la faccia del tuo unto.<verse eid="PSA 84:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10"/>Perciocchè un giorno ne' tuoi cortili val meglio che mille <char style="add">altrove</char>;</para>
  <para style="q" vid="PSA 84:10">Io eleggerei anzi di essere alla soglia della Casa del mio Dio,</para>
  <para style="q" vid="PSA 84:10">Che di abitare ne' tabernacoli di empietà.<verse eid="PSA 84:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11"/>Perciocchè il Signore Iddio <char style="add">è</char> sole<note caller="*" style="x"><char style="xo" closed="false">84.11 </char><char style="xk" closed="false">sole </char><char style="xt" closed="false"><ref loc="ISA 60:19">Is. 60.19</ref>. <ref loc="MAL 4:2">Mal. 4.2</ref>.</char></note> e scudo<note caller="*" style="x"><char style="xo" closed="false">84.11 </char><char style="xk" closed="false">scudo </char><char style="xt" closed="false">Ver. 9 </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 84:11">Il Signore darà grazia e gloria;</para>
  <para style="q" vid="PSA 84:11">Egli non divieterà il bene<note caller="*" style="x"><char style="xo" closed="false">84.11 </char><char style="xk" closed="false">integrità </char><char style="xt" closed="false"><ref loc="PSA 34:9">Sal. 34.9</ref>,<ref loc="PSA 34:10">10</ref>.</char></note> a quelli che camminano in integrità.<verse eid="PSA 84:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12"/>O Signor degli eserciti,</para>
  <para style="q" vid="PSA 84:12">Beato l'uomo che si confida in te<note caller="*" style="x"><char style="xo" closed="false">84.12 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">SALMO LXXXV</para>
  <para style="s1">Fondandosi sulle passate liberazioni, il popolo di Dio domanda di venir liberato dalle afflizioni presenti</para>
  <para style="d">Salmo de' figliuoli di Core, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1"/>O SIGNORE, tu sei stato propizio alla tua terra;</para>
  <para style="q" vid="PSA 85:1">Tu hai ritratto Giacobbe di cattività<note caller="*" style="x"><char style="xo" closed="false">85.1 </char><char style="xk" closed="false">cattività </char><char style="xt" closed="false"><ref loc="EZR 2:1">Esd. 2.1</ref>. <ref loc="PSA 14:7">Sal. 14.7</ref>; <ref loc="PSA 126:1">126.1</ref>. <ref loc="JER 30:18">Ger. 30.18</ref>. <ref loc="EZK 39:25">Ezec. 39.25</ref>.</char></note>.<verse eid="PSA 85:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2"/>Tu hai rimessa al tuo popolo la sua iniquità<note caller="*" style="x"><char style="xo" closed="false">85.2 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 32:1">Sal. 32.1</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 85:2">Tu hai coperti tutti i lor peccati. <char style="qs">(Sela.)</char><verse eid="PSA 85:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3"/>Tu hai acquetato tutto il tuo cruccio;</para>
  <para style="q" vid="PSA 85:3">Tu ti sei stolto dall'ardore della tua ira.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4"/>Ristoraci, o Dio della nostra salute,</para>
  <para style="q" vid="PSA 85:4">E fa' cessar la tua indegnazione contro a noi<note caller="*" style="x"><char style="xo" closed="false">85.4 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="NEH 1:3-11">Neem. 1.3-11</ref>.</char></note>.<verse eid="PSA 85:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5"/>Sarai tu in perpetuo adirato contro a noi?</para>
  <para style="q" vid="PSA 85:5">Farai tu durar l'ira tua per ogni età?<verse eid="PSA 85:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6"/>Non tornerai tu a darci la vita<note caller="*" style="x"><char style="xo" closed="false">85.6 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PSA 90:13">Sal. 90.13</ref>. <ref loc="HAB 3:2">Abac. 3.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 85:6">Acciocchè il tuo popolo si rallegri in te?<verse eid="PSA 85:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7"/>O Signore, mostraci la tua benignità,</para>
  <para style="q" vid="PSA 85:7">E dacci la tua salute.<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8"/>Io ascolterò ciò che dirà il Signore Iddio;</para>
  <para style="q" vid="PSA 85:8">Certo egli parlerà di pace al suo popolo ed a' suoi santi<note caller="*" style="x"><char style="xo" closed="false">85.8 </char><char style="xk" closed="false">santi </char><char style="xt" closed="false"><ref loc="ZEC 9:10">Zac. 9.10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 85:8">E <char style="add">farà</char> ch'essi non ritorneranno più a follia<note caller="*" style="x"><char style="xo" closed="false">85.8 </char><char style="xk" closed="false">follia </char><char style="xt" closed="false"><ref loc="2PE 2:20">2 Piet. 2.20</ref>,<ref loc="2PE 2:21">21</ref>.</char></note>.<verse eid="PSA 85:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9"/>Certo, la sua salute <char style="add">è</char> vicina<note caller="*" style="x"><char style="xo" closed="false">85.9 </char><char style="xk" closed="false">vicina </char><char style="xt" closed="false"><ref loc="ISA 46:13">Is. 46.13</ref>.</char></note> a quelli che lo temono;</para>
  <para style="q" vid="PSA 85:9">La gloria abiterà nel nostro paese<note caller="*" style="x"><char style="xo" closed="false">85.9 </char><char style="xk" closed="false">paese </char><char style="xt" closed="false"><ref loc="ZEC 2:5">Zac. 2.5</ref>. <ref loc="JHN 1:14">Giov. 1.14</ref>.</char></note>.<verse eid="PSA 85:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10"/>Benignità e verità s'incontreranno insieme;</para>
  <para style="q" vid="PSA 85:10">Giustizia e pace si baceranno<note caller="*" style="x"><char style="xo" closed="false">85.10 </char><char style="xk" closed="false">baceranno </char><char style="xt" closed="false"><ref loc="PSA 40:11">Sal. 40.11</ref>; <ref loc="PSA 89:14">89.14</ref>. <ref loc="PRO 3:3">Prov. 3.3</ref>. <ref loc="ISA 32:17">Is. 32.17</ref>. <ref loc="LUK 2:14">Luc. 2.14</ref>.</char></note>.<verse eid="PSA 85:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11"/>Verità germoglierà dalla terra<note caller="*" style="x"><char style="xo" closed="false">85.11 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="ISA 45:8">Is. 45.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 85:11">E giustizia riguarderà dal cielo.<verse eid="PSA 85:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12"/>Il Signore eziandio darà il bene<note caller="*" style="x"><char style="xo" closed="false">85.12 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="PSA 84:11">Sal. 84.11</ref> e rif. <ref loc="JAS 1:17">Giac. 1.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 85:12">E la nostra terra produrrà il suo frutto.<verse eid="PSA 85:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13"/>Egli farà camminar davanti a sè la giustizia,</para>
  <para style="q" vid="PSA 85:13">E <char style="add">la</char> metterà nella via de' suoi passi.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">SALMO LXXXVI</para>
  <para style="s1">Davide implora con ardore il soccorso di Dio</para>
  <para style="d">Orazione di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1"/>O SIGNORE, inchina l'orecchio tuo, <char style="add">e</char> rispondimi;</para>
  <para style="q" vid="PSA 86:1">Perciocchè io <char style="add">sono</char> afflitto e misero<note caller="*" style="x"><char style="xo" closed="false">86.1 </char><char style="xk" closed="false">misero </char><char style="xt" closed="false"><ref loc="PSA 40:17">Sal. 40.17</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 86:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2"/>Guarda l'anima mia; perciocchè io mi studio a pietà;</para>
  <para style="q" vid="PSA 86:2">O tu, Dio mio, salva il tuo servitore che si confida in te<note caller="*" style="x"><char style="xo" closed="false">86.2 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> e rif. <ref loc="ISA 26:3">Is. 26.3</ref>.</char></note>.<verse eid="PSA 86:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3"/>O Signore, abbi pietà di me;</para>
  <para style="q" vid="PSA 86:3">Perciocchè io grido a te tuttodì.<verse eid="PSA 86:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4"/>Rallegra l'anima del tuo servitore;</para>
  <para style="q" vid="PSA 86:4">Perciocchè io levo l'anima mia a te, o Signore.<verse eid="PSA 86:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5"/>Perciocchè tu, Signore, <char style="add">sei</char> buono e perdonatore;</para>
  <para style="q" vid="PSA 86:5">E di gran benignità inverso tutti quelli che t'invocano<note caller="*" style="x"><char style="xo" closed="false">86.5 </char><char style="xk" closed="false">invocano </char><char style="xt" closed="false">Ver. 15 </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 86:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6"/>O Signore, porgi gli orecchi alla mia orazione;</para>
  <para style="q" vid="PSA 86:6">E attendi al grido delle mie supplicazioni.<verse eid="PSA 86:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7"/>Io t'invoco nel giorno della mia distretta<note caller="*" style="x"><char style="xo" closed="false">86.7 </char><char style="xk" closed="false">distretta </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sal. 50.15</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 86:7">Perciocchè tu mi risponderai.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8"/>Non <char style="add">vi è</char> niuno pari a te fra gl'iddii, o Signore<note caller="*" style="x"><char style="xo" closed="false">86.8 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="EXO 15:11">Esod. 15.11</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 86:8">E non <char style="add">vi sono</char> alcune opere pari alle tue<note caller="*" style="x"><char style="xo" closed="false">86.8 </char><char style="xk" closed="false">tue </char><char style="xt" closed="false"><ref loc="DEU 3:24">Deut. 3.24</ref>.</char></note>.<verse eid="PSA 86:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9"/>Tutte le genti le quali tu hai fatte, verranno,</para>
  <para style="q" vid="PSA 86:9">E adoreranno nel tuo cospetto, o Signore;</para>
  <para style="q" vid="PSA 86:9">E glorificheranno il tuo Nome<note caller="*" style="x"><char style="xo" closed="false">86.9 </char><char style="xk" closed="false">Nome </char><char style="xt" closed="false"><ref loc="REV 15:4">Apoc. 15.4</ref>.</char></note>.<verse eid="PSA 86:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10"/>Perciocchè tu <char style="add">sei</char> grande, e facitore di maraviglie;</para>
  <para style="q" vid="PSA 86:10">Tu solo <char style="add">sei</char> Dio<note caller="*" style="x"><char style="xo" closed="false">86.10 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="DEU 6:4">Deut. 6.4</ref> e rif. <ref loc="EPH 4:6">Efes. 4.6</ref>.</char></note>.<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11"/>O Signore, insegnami la tua via<note caller="*" style="x"><char style="xo" closed="false">86.11 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="PSA 25:4">Sal. 25.4</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 86:11">
    <char style="add">E fa' che</char> io cammini nella tua verità;</para>
  <para style="q" vid="PSA 86:11">Unisci il mio cuore al timor del tuo nome.<verse eid="PSA 86:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12"/>Io ti celebrerò, o Signore Iddio mio, con tutto il mio cuore;</para>
  <para style="q" vid="PSA 86:12">E glorificherò il tuo Nome in perpetuo.<verse eid="PSA 86:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13"/>Perciocchè la tua benignità <char style="add">è</char> grande sopra me;</para>
  <para style="q" vid="PSA 86:13">E tu hai riscossa l'anima mia dal fondo del sepolcro<note caller="*" style="x"><char style="xo" closed="false">86.13 </char><char style="xk" closed="false">sepolcro </char><char style="xt" closed="false"><ref loc="PSA 56:13">Sal. 56.13</ref>; <ref loc="PSA 116:8">116.8</ref>.</char></note>.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14"/>O Dio, <char style="add">uomini</char> superbi si son levati contro a me;</para>
  <para style="q" vid="PSA 86:14">Ed una raunanza di violenti,</para>
  <para style="q" vid="PSA 86:14">I quali non ti pongono davanti agli occhi loro,</para>
  <para style="q" vid="PSA 86:14">Cercano l'anima mia.<verse eid="PSA 86:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15"/>Ma tu, Signore, <char style="add">sei</char> l'Iddio misericordioso e pietoso,</para>
  <para style="q" vid="PSA 86:15">Lento all'ira, e di gran benignità e verità<note caller="*" style="x"><char style="xo" closed="false">86.15 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false">Vers. 5. <ref loc="EXO 34:6">Esod. 34.6</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 86:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16"/>Volgi la tua faccia verso me, ed abbi pietà di me;</para>
  <para style="q" vid="PSA 86:16">Da' la tua forza al tuo servitore,</para>
  <para style="q" vid="PSA 86:16">E salva il figliuolo della tua servente.<verse eid="PSA 86:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17"/>Opera inverso me qualche miracolo in bene,</para>
  <para style="q" vid="PSA 86:17">Sì che quelli che mi odiano lo veggano, e sieno confusi;</para>
  <para style="q" vid="PSA 86:17">Perciocchè tu, Signore, mi avrai aiutato, e mi avrai consolato.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">SALMO LXXXVII</para>
  <para style="s1">Dio prende il suo diletto in Sion ed ivi riunirà tutti i popoli</para>
  <para style="d">Salmo di Cantico de' figliuoli di Core</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1"/>LA fondazione del Signore<note caller="*" style="x"><char style="xo" closed="false">87.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="ISA 28:16">Is. 28.16</ref>.</char></note> <char style="add">è</char> ne' monti santi<note caller="*" style="x"><char style="xo" closed="false">87.1 </char><char style="xk" closed="false">santi </char><char style="xt" closed="false"><ref loc="PSA 48:1">Sal. 48.1</ref>; <ref loc="PSA 121:1">121.1</ref>. <ref loc="ISA 2:2">Is. 2.2</ref>,<ref loc="ISA 2:3">3</ref>.</char></note>.<verse eid="PSA 87:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2"/>Il Signore ama le porte di Sion,</para>
  <para style="q" vid="PSA 87:2">Sopra tutte le stanze di Giacobbe<note caller="*" style="x"><char style="xo" closed="false">87.2 </char><char style="xk" closed="false">Giacobbe </char><char style="xt" closed="false"><ref loc="PSA 78:67">Sal. 78.67</ref>,<ref loc="PSA 78:68">68</ref>.</char></note>.<verse eid="PSA 87:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3"/>O Città di Dio,</para>
  <para style="q" vid="PSA 87:3">Cose gloriose son dette di te<note caller="*" style="x"><char style="xo" closed="false">87.3 </char><char style="xk" closed="false">te </char><char style="xt" closed="false">Is. cap. 60.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 87:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4"/>Io mentoverò, <char style="add">dice al Signore</char>, Rahab, e Babilonia,</para>
  <para style="q" vid="PSA 87:4">Fra quelli che mi conoscono<note caller="*" style="x"><char style="xo" closed="false">87.4 </char><char style="xk" closed="false">conoscono </char><char style="xt" closed="false"><ref loc="ISA 19:22-25">Is. 19.22-25</ref>. <ref loc="JHN 10:14">Giov. 10.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 87:4">Ecco, i Filistei ed i Tiri insieme con gli Etiopi,</para>
  <para style="q" vid="PSA 87:4">
    <char style="add">De' quali si dirà:</char> Costui è nato quivi.<verse eid="PSA 87:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5"/>E si dirà di Sion: Questi e quegli è nato in essa;</para>
  <para style="q" vid="PSA 87:5">E l'Altissimo stesso la stabilirà.<verse eid="PSA 87:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6"/>Il Signore, rassegnando i popoli, annovererà <char style="add">coloro</char>,</para>
  <para style="q" vid="PSA 87:6">
    <char style="add">Dicendo:</char> Un tale è nato quivi. <char style="qs">(Sela.)</char><verse eid="PSA 87:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7"/>E cantori, e suonatori,</para>
  <para style="q" vid="PSA 87:7">E tutte le mie fonti, <char style="add">saranno</char> in te.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">SALMO LXXXVIII</para>
  <para style="s1">Il Salmista si lamenta dei suoi grandi mali e supplica Iddio di liberarnelo</para>
  <para style="d">Maschil di Heman Ezrahita, <char style="add">che è</char> un cantico di salmo, <char style="add">dato</char> al Capo de' Musici, dei figliuoli di Core, per cantar<char style="add">lo</char> sopra Mahalat</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1"/>O SIGNORE Iddio della mia salute,</para>
  <para style="q" vid="PSA 88:1">Io grido di giorno <char style="add">e</char> di notte, nel tuo cospetto<note caller="*" style="x"><char style="xo" closed="false">88.1 </char><char style="xk" closed="false">cospetto </char><char style="xt" closed="false"><ref loc="PSA 22:2">Sal. 22.2</ref>. <ref loc="LUK 18:7">Luc. 18.7</ref>.</char></note>.<verse eid="PSA 88:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2"/>Venga la mia orazione in tua presenza;</para>
  <para style="q" vid="PSA 88:2">Inchina il tuo orecchio al mio grido.<verse eid="PSA 88:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3"/>Perciocchè l'anima mia è sazia di mali;</para>
  <para style="q" vid="PSA 88:3">E la mia vita è giunta infino al sepolcro<note caller="*" style="x"><char style="xo" closed="false">88.3 </char><char style="xk" closed="false">sepolcro </char><char style="xt" closed="false"><ref loc="PSA 16:10">Sal. 16.10</ref>.</char></note>.<verse eid="PSA 88:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4"/>Io son reputato del numero di quelli che scendono nella fossa;</para>
  <para style="q" vid="PSA 88:4">Io son simile ad un uomo <char style="add">che</char> non <char style="add">ha più</char> forza alcuna.<verse eid="PSA 88:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5"/>Io <char style="add">sono</char> spacciato fra i morti,</para>
  <para style="q" vid="PSA 88:5">Come gli uccisi che giacciono nella sepoltura,</para>
  <para style="q" vid="PSA 88:5">De' quali tu non ti ricordi più;</para>
  <para style="q" vid="PSA 88:5">E <char style="add">che</char> son ricisi dalla tua mano<note caller="*" style="x"><char style="xo" closed="false">88.5 </char><char style="xk" closed="false">mano </char><char style="xt" closed="false"><ref loc="ISA 53:8">Is. 53.8</ref>.</char></note>.<verse eid="PSA 88:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6"/>Tu mi hai posto in una fossa bassissima,</para>
  <para style="q" vid="PSA 88:6">In tenebre, in <char style="add">luoghi</char> profondi.<verse eid="PSA 88:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7"/>L'ira tua si è posata sopra me,</para>
  <para style="q" vid="PSA 88:7">E tu <char style="add">mi</char> hai abbattuto con tutti i tuoi flutti. <char style="qs">(Sela.)</char><verse eid="PSA 88:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8"/>Tu hai allontanati da me i miei conoscenti,</para>
  <para style="q" vid="PSA 88:8">Tu mi hai renduto loro grandemente abbominevole<note caller="*" style="x"><char style="xo" closed="false">88.8 </char><char style="xk" closed="false">abbominevole </char><char style="xt" closed="false"><ref loc="MAT 26:56">Mat. 26.56</ref>.</char></note>;</para>
  <para style="q" vid="PSA 88:8">
    <char style="add">Io son</char> serrato, e non posso uscire.<verse eid="PSA 88:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9"/>L'occhio mio è doglioso d'afflizione;</para>
  <para style="q" vid="PSA 88:9">O Signore, io grido a te tuttodì,</para>
  <para style="q" vid="PSA 88:9">Io spiego a te le palme delle mie mani.<verse eid="PSA 88:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10"/>Opererai tu alcuna maraviglia inverso i morti?</para>
  <para style="q" vid="PSA 88:10">I trapassati risorgeranno essi, per celebrarti<note caller="*" style="x"><char style="xo" closed="false">88.10 </char><char style="xk" closed="false">celebrarti </char><char style="xt" closed="false"><ref loc="PSA 6:5">Sal. 6.5</ref> </char><char style="xta" closed="false">e rif.</char></note>? <char style="qs">(Sela.)</char><verse eid="PSA 88:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11"/>La tua benignità si narrerà ella nel sepolcro?</para>
  <para style="q" vid="PSA 88:11">
    <char style="add">E</char> la tua verità nel <char style="add">luogo del</char>la perdizione?<verse eid="PSA 88:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12"/>Le tue maraviglie si conosceranno esse nelle tenebre?</para>
  <para style="q" vid="PSA 88:12">E la tua giustizia nella terra dell'obblio<note caller="*" style="x"><char style="xo" closed="false">88.12 </char><char style="xk" closed="false">obblio </char><char style="xt" closed="false"><ref loc="ECC 9:5">Eccl. 9.5</ref>.</char></note>?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13"/>Ora quant'è a me, o Signore, io grido a te;</para>
  <para style="q" vid="PSA 88:13">
    <char style="add">E</char> la mia orazione ti si fa incontro la mattina.<verse eid="PSA 88:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14"/>Perchè scacci, o Signore, l'anima mia?</para>
  <para style="q" vid="PSA 88:14">
    <char style="add">Perchè</char> nascondi il tuo volto da me?<verse eid="PSA 88:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15"/>Io <char style="add">son</char> povero, e vengo meno fin dalla <char style="add">mia</char> giovanezza;</para>
  <para style="q" vid="PSA 88:15">Io porto i tuoi spaventi, <char style="add">e</char> ne sto in forse<note caller="*" style="x"><char style="xo" closed="false">88.15 </char><char style="xk" closed="false">forse </char><char style="xt" closed="false"><ref loc="JOB 6:4">Giob. 6.4</ref>.</char></note>.<verse eid="PSA 88:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16"/>Le tue ire mi son passate addosso;</para>
  <para style="q" vid="PSA 88:16">I tuoi terrori mi hanno deserto;<verse eid="PSA 88:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17"/>Mi han circondato come acque tuttodì;</para>
  <para style="q" vid="PSA 88:17">Tutti quanti mi hanno intorniato.<verse eid="PSA 88:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18"/>Tu hai allontanati da me amici e compagni;</para>
  <para style="q" vid="PSA 88:18">I miei conoscenti <char style="add">son nascosti nelle</char> tenebre.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">SALMO LXXXIX</para>
  <para style="s1">Il patto di Dio con Davide ricordato, affinchè Dio liberi il suo popolo dai mali presenti</para>
  <para style="d">Maschil di Etan Ezrahita</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1"/>IO canterò in perpetuo le benignità del Signore;</para>
  <para style="q" vid="PSA 89:1">Io renderò colla mia bocca nota la tua verità per ogni età<note caller="*" style="x"><char style="xo" closed="false">89.1 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="PSA 36:5">Sal. 36.5</ref>.</char></note>.<verse eid="PSA 89:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2"/>Perciocchè io ho detto: La <char style="add">tua</char> benignità sarà stabile in eterno;</para>
  <para style="q" vid="PSA 89:2">Tu hai fermata la tua verità ne' cieli.<verse eid="PSA 89:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3"/>Io ho fatto, <char style="add">dice il Signore</char>, patto col mio eletto;</para>
  <para style="q" vid="PSA 89:3">Io ho giurato a Davide, mio servitore<note caller="*" style="x"><char style="xo" closed="false">89.3 </char><char style="xk" closed="false">servitore </char><char style="xt" closed="false"><ref loc="1SA 7:12">1 Sam. 7.12</ref> </char><char style="xta" closed="false">ecc. e rif.</char></note>, <char style="add">dicendo:</char><verse eid="PSA 89:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4"/>Io fonderò la tua progenie in eterno,</para>
  <para style="q" vid="PSA 89:4">Ed edificherò il tuo trono per ogni età<note caller="*" style="x"><char style="xo" closed="false">89.4 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="LUK 1:32">Luc. 1.32</ref>,<ref loc="LUK 1:33">33</ref>. <ref loc="JHN 12:34">Giov. 12.34</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5"/>I cieli parimente celebreranno le tue maraviglie, o Signore<note caller="*" style="x"><char style="xo" closed="false">89.5 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 19:2">Sal. 19.2</ref>. <ref loc="REV 7:10-12">Apoc. 7.10-12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 89:5">La tua verità eziandio <char style="add">sarà celebrata</char> nella raunanza de' santi.<verse eid="PSA 89:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6"/>Perciocchè, chi <char style="add">è</char> nel cielo <char style="add">che</char> pareggi il Signore;</para>
  <para style="q" vid="PSA 89:6">
    <char style="add">E che</char> possa essere assomigliato al Signore, fra i figliuoli de' possenti?<verse eid="PSA 89:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7"/>Iddio <char style="add">è</char> grandemente spaventevole nel consiglio de' santi,</para>
  <para style="q" vid="PSA 89:7">E tremendo sopra tutti quelli che <char style="add">sono</char> d'intorno a lui.<verse eid="PSA 89:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8"/>O Signore Iddio degli eserciti, chi <char style="add">è</char> potente Signore come <char style="add">sei</char> tu<note caller="*" style="x"><char style="xo" closed="false">89.8 </char><char style="xk" closed="false">tu </char><char style="xt" closed="false"><ref loc="EXO 15:11">Esod. 15.11</ref> </char><char style="xta" closed="false">e rif.</char></note>?</para>
  <para style="q" vid="PSA 89:8">Tu hai, oltre a ciò, intorno a te la tua verità.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9"/>Tu signoreggi sopra l'alterezza del mare;</para>
  <para style="q" vid="PSA 89:9">Quando le sue onde s'innalzano, tu l'acqueti<note caller="*" style="x"><char style="xo" closed="false">89.9 </char><char style="xk" closed="false">acqueti </char><char style="xt" closed="false"><ref loc="PSA 65:7">Sal. 65.7</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 89:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10"/>Tu hai fiaccato Rahab, a guisa d'uomo ferito a morte;</para>
  <para style="q" vid="PSA 89:10">Tu hai, col tuo possente braccio, dispersi i tuoi nemici<note caller="*" style="x"><char style="xo" closed="false">89.10 </char><char style="xk" closed="false">nemici </char><char style="xt" closed="false"><ref loc="EXO 14:26">Esod. 14.26</ref> ecc.</char></note>.<verse eid="PSA 89:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11"/>I cieli <char style="add">son</char> tuoi, tua eziandio <char style="add">è</char> la terra<note caller="*" style="x"><char style="xo" closed="false">89.11 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 24:1">Sal. 24.1</ref>,<ref loc="PSA 24:2">2</ref>; <ref loc="PSA 50:12">50.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 89:11">Tu hai fondato il mondo, e tutto ciò ch'è in esso.<verse eid="PSA 89:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12"/>Tu hai creato il Settentrione ed il Mezzodì;</para>
  <para style="q" vid="PSA 89:12">Tabor ed Hermon trionfano nel tuo Nome.<verse eid="PSA 89:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13"/>Tu hai un braccio forte;</para>
  <para style="q" vid="PSA 89:13">La tua mano è potente, la tua destra è esaltata.<verse eid="PSA 89:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14"/>Giustizia e giudicio <char style="add">son</char> la ferma base del tuo trono;</para>
  <para style="q" vid="PSA 89:14">Benignità e verità vanno davanti alla tua faccia.<verse eid="PSA 89:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15"/>Beato il popolo che sa che cosa è il giubilare;</para>
  <para style="q" vid="PSA 89:15">O Signore, essi cammineranno alla chiarezza della tua faccia;<verse eid="PSA 89:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16"/>Festeggeranno tuttodì nel tuo nome,</para>
  <para style="q" vid="PSA 89:16">E si esalteranno nella tua giustizia.<verse eid="PSA 89:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17"/>Perchè tu <char style="add">sei</char> la gloria della lor forza;</para>
  <para style="q" vid="PSA 89:17">E il nostro corno è alzato per lo tuo favore.<verse eid="PSA 89:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18"/>Perciocchè lo scudo nostro <char style="add">è</char> del Signore;</para>
  <para style="q" vid="PSA 89:18">E il Re nostro <char style="add">è</char> del Santo d'Israele.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19"/>Tu parlasti già in visione intorno al tuo Santo,</para>
  <para style="q" vid="PSA 89:19">E dicesti: Io ho posto l'aiuto intorno al possente;</para>
  <para style="q" vid="PSA 89:19">Io ho innalzato l'eletto d'infra il popolo.<verse eid="PSA 89:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20"/>Io ho trovato Davide, mio servitore;</para>
  <para style="q" vid="PSA 89:20">
    <char style="add">E</char> l'ho unto coll'olio mio santo<note caller="*" style="x"><char style="xo" closed="false">89.20 </char><char style="xk" closed="false">santo </char><char style="xt" closed="false"><ref loc="1SA 16:1">1 Sam. 16.1</ref> ecc. <ref loc="ACT 13:22">Fat. 13.22</ref>.</char></note>;<verse eid="PSA 89:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21"/>Col quale la mia mano sarà ferma;</para>
  <para style="q" vid="PSA 89:21">Il mio braccio eziandio lo fortificherà.<verse eid="PSA 89:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22"/>Il nemico non l'oppresserà<note caller="*" style="x"><char style="xo" closed="false">89.22 </char><char style="xk" closed="false">oppresserà </char><char style="xt" closed="false"><ref loc="2SA 7:9">2 Sam. 7.9</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 89:22">Ed il perverso non l'affliggerà.<verse eid="PSA 89:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23"/>Anzi io fiaccherò i suoi nemici, <char style="add">cacciandoli</char> d'innanzi a lui;</para>
  <para style="q" vid="PSA 89:23">E sconfiggerò quelli che l'odieranno.<verse eid="PSA 89:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24"/>E la mia verità, e la mia benignità, <char style="add">saranno</char> con lui<note caller="*" style="x"><char style="xo" closed="false">89.24 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="PSA 61:7">Sal. 61.7</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 89:24">Ed il suo corno sarà alzato nel mio nome;<verse eid="PSA 89:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25"/>E metterò la sua mano sopra il mare,</para>
  <para style="q" vid="PSA 89:25">E la sua destra sopra i fiumi.<verse eid="PSA 89:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26"/>Egli m'invocherà, <char style="add">dicendo:</char> Tu <char style="add">sei</char> mio Padre<note caller="*" style="x"><char style="xo" closed="false">89.26 </char><char style="xk" closed="false">Padre </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 Sam. 7.14</ref>.</char></note>,</para>
  <para style="q" vid="PSA 89:26">Il mio Dio, e la Rocca della mia salute<note caller="*" style="x"><char style="xo" closed="false">89.26 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="2SA 22:47">2 Sam. 22.47</ref>.</char></note>.<verse eid="PSA 89:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27"/>Io altresì lo costituirò il primogenito<note caller="*" style="x"><char style="xo" closed="false">89.27 </char><char style="xk" closed="false">primogenito </char><char style="xt" closed="false"><ref loc="PSA 2:7">Sal. 2.7</ref>. <ref loc="COL 1:15-18">Col. 1.15-18</ref>.</char></note>,</para>
  <para style="q" vid="PSA 89:27">Il più eccelso dei re della terra.<verse eid="PSA 89:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28"/>Io gli osserverò la mia benignità in perpetuo,</para>
  <para style="q" vid="PSA 89:28">Ed il mio patto <char style="add">sarà</char> leale inverso lui<note caller="*" style="x"><char style="xo" closed="false">89.28 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="ISA 55:3">Is. 55.3</ref>.</char></note>.<verse eid="PSA 89:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29"/>E renderò la sua progenie eterna,</para>
  <para style="q" vid="PSA 89:29">Ed il suo trono simile a' giorni del cielo<note caller="*" style="x"><char style="xo" closed="false">89.29 </char><char style="xk" closed="false">cielo </char><char style="xt" closed="false"><ref loc="ISA 9:6">Is. 9.6</ref>. <ref loc="JER 33:17">Ger. 33.17</ref>.</char></note>.<verse eid="PSA 89:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30"/>Se i suoi figliuoli abbandonano la mia Legge,</para>
  <para style="q" vid="PSA 89:30">E non camminano ne' miei ordinamenti;<verse eid="PSA 89:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31"/>Se violano i miei statuti,</para>
  <para style="q" vid="PSA 89:31">E non osservano i miei comandamenti;<verse eid="PSA 89:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32"/>Io visiterò il lor misfatto con verga<note caller="*" style="x"><char style="xo" closed="false">89.32 </char><char style="xk" closed="false">verga </char><char style="xt" closed="false"><ref loc="2SA 7:13">2 Sam. 7.13</ref>,<ref loc="2SA 7:14">14</ref>. <ref loc="1KI 11:31">1 Re. 11.31</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 89:32">E la loro iniquità con battiture;<verse eid="PSA 89:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33"/>
    <char style="add">Ma</char> non annullerò la mia benignità inverso lui,</para>
  <para style="q" vid="PSA 89:33">E non mentirò contro alla mia verità.<verse eid="PSA 89:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34"/>Io non violerò il mio patto,</para>
  <para style="q" vid="PSA 89:34">E non muterò quello che è uscito dalle mie labbra.<verse eid="PSA 89:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35"/>Io ho giurato una volta per la mia santità:</para>
  <para style="q" vid="PSA 89:35">Se io mento a Davide;<verse eid="PSA 89:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36"/>
    <char style="add">Che</char> la sua progenie sarà in eterno<note caller="*" style="x"><char style="xo" closed="false">89.36 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="2SA 7:16">2 Sam. 7.16</ref>. <ref loc="LUK 1:33">Luc. 1.33</ref>. <ref loc="JHN 12:34">Giov. 12.34</ref>.</char></note>,</para>
  <para style="q" vid="PSA 89:36">E che il suo trono <char style="add">sarà</char> come il sole nel mio cospetto;<verse eid="PSA 89:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37"/>Che sarà stabile in perpetuo, come la luna;</para>
  <para style="q" vid="PSA 89:37">E <char style="add">di ciò</char> vi è il testimonio fedele nel cielo. <char style="qs">(Sela.)</char><verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38"/>E pur tu <char style="add">l</char>'hai cacciato lungi <char style="add">da te</char>, e <char style="add">l</char>'hai disdegnato<note caller="*" style="x"><char style="xo" closed="false">89.38 </char><char style="xk" closed="false">disdegnato </char><char style="xt" closed="false"><ref loc="1CH 28:9">1 Cron. 28.9</ref>. <ref loc="PSA 44:9">Sal. 44.9</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 89:38">Tu ti sei gravemente adirato contro al tuo unto.<verse eid="PSA 89:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39"/>Tu hai annullato il patto fatto col tuo servitore;</para>
  <para style="q" vid="PSA 89:39">Tu hai contaminata la sua benda reale, <char style="add">gettendola</char> per terra.<verse eid="PSA 89:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40"/>Tu hai rotte tutte le sue chiusure;</para>
  <para style="q" vid="PSA 89:40">Tu hai messe in ruina le sue fortezze.<verse eid="PSA 89:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41"/>Tutti i passanti l'hanno predato;</para>
  <para style="q" vid="PSA 89:41">Egli è stato in vituperio a' suoi vicini.<verse eid="PSA 89:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42"/>Tu hai alzata la destra de' suoi avversari;</para>
  <para style="q" vid="PSA 89:42">Tu hai rallegrati tutti i suoi nemici.<verse eid="PSA 89:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43"/>Tu hai eziandio rintuzzato il taglio della sua spada,</para>
  <para style="q" vid="PSA 89:43">E non l'hai fatto star fermo in piè nella battaglia.<verse eid="PSA 89:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44"/>Tu l'hai spogliato del suo splendore,</para>
  <para style="q" vid="PSA 89:44">Ed hai traboccato in terra il suo trono.<verse eid="PSA 89:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45"/>Tu hai scorciati i giorni della sua giovanezza;</para>
  <para style="q" vid="PSA 89:45">Tu l'hai coperto di vergogna. <char style="qs">(Sela.)</char><verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46"/>Infino a quando, o Signore, ti nasconderai tu?</para>
  <para style="q" vid="PSA 89:46">
    <char style="add">Ed</char> arderà l'ira tua come un fuoco, in perpetuo?<verse eid="PSA 89:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47"/>Ricordati quanto poco tempo io ho da vivere nel mondo<note caller="*" style="x"><char style="xo" closed="false">89.47 </char><char style="xk" closed="false">mondo </char><char style="xt" closed="false"><ref loc="JOB 14:1">Giob. 14.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 89:47">Perchè avresti tu creati in vano tutti i figliuoli degli uomini?<verse eid="PSA 89:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48"/>Chi <char style="add">è</char> l'uomo <char style="add">che</char> viva, senza veder <char style="add">mai</char> la morte<note caller="*" style="x"><char style="xo" closed="false">89.48 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="HEB 11:5">Ebr. 11.5</ref>.</char></note>?</para>
  <para style="q" vid="PSA 89:48">Che scampi la sua vita di man del sepolcro? <char style="qs">(Sela.)</char><verse eid="PSA 89:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49"/>Ove <char style="add">sono</char>, o Signore, le tue benignità antiche,</para>
  <para style="q" vid="PSA 89:49">
    <char style="add">Le quali</char> tu giurasti a Davide<note caller="*" style="x"><char style="xo" closed="false">89.49 </char><char style="xk" closed="false">Davide </char><char style="xt" closed="false"><ref loc="2SA 7:15">2 Sam. 7.15</ref>. <ref loc="ISA 55:3">Is. 55.3</ref>.</char></note> per la tua verita?<verse eid="PSA 89:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50"/>Ricordati, o Signore, del vituperio fatto a' tuoi servitori,</para>
  <para style="q" vid="PSA 89:50">Di quello che io porto in seno;</para>
  <para style="q" vid="PSA 89:50">
    <char style="add">Del vituperio fattoci da</char> tutti i grandi popoli.<verse eid="PSA 89:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51"/>Conciossiachè i tuoi nemici abbiano vituperate, o Signore,</para>
  <para style="q" vid="PSA 89:51">Abbiano vituperate le vestigie del tuo unto.<verse eid="PSA 89:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52"/>Benedetto <char style="add">sia</char> il Signore in eterno<note caller="*" style="x"><char style="xo" closed="false">89.52 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 41:13">Sal. 41.13</ref>.</char></note>.</para>
  <para style="q" vid="PSA 89:52">Amen, Amen.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="cl">SALMO XC</para>
  <para style="s1">Fralezza dell'uomo. Provvidenza di Dio</para>
  <para style="d">Orazione di Mosè, uomo di Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1"/>O SIGNORE, tu ci sei stato un abitacolo</para>
  <para style="q" vid="PSA 90:1">In ogni età<note caller="*" style="x"><char style="xo" closed="false">90.1 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="DEU 33:27">Deut. 33.27</ref>.</char></note>.<verse eid="PSA 90:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2"/>Avanti che i monti fosser nati<note caller="*" style="x"><char style="xo" closed="false">90.2 </char><char style="xk" closed="false">nati </char><char style="xt" closed="false"><ref loc="PRO 8:23-26">Prov. 8.23-26</ref>.</char></note>,</para>
  <para style="q" vid="PSA 90:2">E che tu avessi formata la terra ed il mondo;</para>
  <para style="q" vid="PSA 90:2">Anzi ab eterno in eterno tu <char style="add">sei</char> Dio<note caller="*" style="x"><char style="xo" closed="false">90.2 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="JOB 36:26">Giob. 36.26</ref>.</char></note>.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3"/>Tu fai ritornar l'uomo in polvere,</para>
  <para style="q" vid="PSA 90:3">E dici: Ritornate, o figliuoli degli uomini<note caller="*" style="x"><char style="xo" closed="false">90.3 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="GEN 3:19">Gen. 3.19</ref>. <ref loc="ECC 12:9">Eccl. 12.9</ref>.</char></note>.<verse eid="PSA 90:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4"/>Perciocchè mille anni <char style="add">sono</char> appo te</para>
  <para style="q" vid="PSA 90:4">Come il giorno d'ieri, quando è passato<note caller="*" style="x"><char style="xo" closed="false">90.4 </char><char style="xk" closed="false">passato </char><char style="xt" closed="false"><ref loc="2PE 3:8">2 Piet. 3.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 90:4">O <char style="add">come</char> una vegghia nella notte.<verse eid="PSA 90:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5"/>Tu porti via gli <char style="add">uomini</char>, come per una piena d'acque;</para>
  <para style="q" vid="PSA 90:5">Essi <char style="add">non</char> sono <char style="add">altro che</char> un sogno<note caller="*" style="x"><char style="xo" closed="false">90.5 </char><char style="xk" closed="false">sogno </char><char style="xt" closed="false"><ref loc="PSA 73:20">Sal. 73.20</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 90:5">Son come l'erba che si rinnovella la mattina<note caller="*" style="x"><char style="xo" closed="false">90.5 </char><char style="xk" closed="false">mattina </char><char style="xt" closed="false"><ref loc="PSA 103:15">Sal. 103.15</ref> e rif. <ref loc="ISA 40:6">Is. 40.6</ref>.</char></note>.<verse eid="PSA 90:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6"/>La mattina ella fiorisce e si rinnovella;</para>
  <para style="q" vid="PSA 90:6">E la sera è segata e si secca<note caller="*" style="x"><char style="xo" closed="false">90.6 </char><char style="xk" closed="false">secca </char><char style="xt" closed="false"><ref loc="JOB 14:2">Giob. 14.2</ref>. <ref loc="PSA 92:7">Sal. 92.7</ref>.</char></note>.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7"/>Perciocchè noi veniam meno per la tua ira;</para>
  <para style="q" vid="PSA 90:7">E siam conturbati per lo tuo cruccio.<verse eid="PSA 90:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8"/>Tu metti davanti a te le nostre iniquità<note caller="*" style="x"><char style="xo" closed="false">90.8 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 50:21">Sal. 50.21</ref>. <ref loc="JER 16:17">Ger. 16.17</ref>.</char></note>,</para>
  <para style="q" vid="PSA 90:8">
    <char style="add">E</char> i nostri <char style="add">peccati</char> occulti alla luce della tua faccia<note caller="*" style="x"><char style="xo" closed="false">90.8 </char><char style="xk" closed="false">faccia </char><char style="xt" closed="false"><ref loc="PSA 19:12">Sal. 19.12</ref>.</char></note>.<verse eid="PSA 90:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9"/>Conciossiachè tutti i nostri giorni dichinino per la tua ira;</para>
  <para style="q" vid="PSA 90:9">Noi abbiam forniti gli anni nostri <char style="add">così presto</char> come una parola.<verse eid="PSA 90:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10"/>I giorni de' nostri anni, in alcuni <char style="add">non sono che</char> settant'anni;</para>
  <para style="q" vid="PSA 90:10">E <char style="add">in altri</char>, se ve ne sono di <char style="add">maggiori</char> forze, <char style="add">che</char> ottant'anni;</para>
  <para style="q" vid="PSA 90:10">Ed <char style="add">anche</char> il fiore di quelli <char style="add">non è altro che</char> travaglio e vanità;</para>
  <para style="q" vid="PSA 90:10">Perciocchè di subito è riciso, e noi ce ne voliam via.<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11"/>Chi conosce la forza della tua ira,</para>
  <para style="q" vid="PSA 90:11">E la tua indegnazione, secondo che devi esser temuto?<verse eid="PSA 90:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12"/>Insegna<char style="add">ci</char> adunque a contare i nostri dì<note caller="*" style="x"><char style="xo" closed="false">90.12 </char><char style="xk" closed="false">dì </char><char style="xt" closed="false"><ref loc="PSA 39:4">Sal. 39.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 90:12">Acciocchè acquistiamo un cuor savio.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13"/>Rivolgiti, Signore; infino a quando?</para>
  <para style="q" vid="PSA 90:13">E sii rappacificato inverso i tuoi servitori<note caller="*" style="x"><char style="xo" closed="false">90.13 </char><char style="xk" closed="false">servitori </char><char style="xt" closed="false"><ref loc="DEU 32:36">Deut. 32.36</ref>. <ref loc="PSA 135:14">Sal. 135.14</ref>.</char></note>.<verse eid="PSA 90:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14"/>Saziaci <char style="add">ogni</char> mattina della tua benignità;</para>
  <para style="q" vid="PSA 90:14">Acciocchè giubiliamo, e ci rallegriamo tutti i dì nostri<note caller="*" style="x"><char style="xo" closed="false">90.14 </char><char style="xk" closed="false">nostri </char><char style="xt" closed="false"><ref loc="PSA 85:6">Sal. 85.6</ref>.</char></note>.<verse eid="PSA 90:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15"/>Rallegraci, al par de' giorni che tu ci hai affliti;</para>
  <para style="q" vid="PSA 90:15">Degli anni che abbiamo sentito il male.<verse eid="PSA 90:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16"/>Apparisca l'opera tua verso i tuoi servitori<note caller="*" style="x"><char style="xo" closed="false">90.16 </char><char style="xk" closed="false">servitori </char><char style="xt" closed="false"><ref loc="PSA 92:4">Sal. 92.4</ref>. <ref loc="HAB 3:2">Abac. 3.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 90:16">E la tua gloria verso i lor figliuoli.<verse eid="PSA 90:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17"/>E sia il piacevole sguardo del Signore Iddio nostro sopra noi;</para>
  <para style="q" vid="PSA 90:17">E addirizza, <char style="add">o Signore</char>, sopra noi l'opera delle nostre mani<note caller="*" style="x"><char style="xo" closed="false">90.17 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="ISA 26:12">Is. 26.12</ref>.</char></note>.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">SALMO XCI</para>
  <para style="s1">Sicurezza di chi si rifugia in Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1"/>CHI dimora nel nascondimento dell'Altissimo,</para>
  <para style="q" vid="PSA 91:1">Alberga all'ombra dell'Onnipotente<note caller="*" style="x"><char style="xo" closed="false">91.1 </char><char style="xk" closed="false">Onnipotente </char><char style="xt" closed="false"><ref loc="PSA 17:8">Sal. 17.8</ref>; <ref loc="PSA 27:5">27.5</ref>; <ref loc="PSA 32:7">32.7</ref>; <ref loc="PSA 121:5">121.5</ref>.</char></note>.<verse eid="PSA 91:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2"/>Io dirò al Signore: <char style="add">Tu sei</char> il mio ricetto e la mia fortezza;</para>
  <para style="q" vid="PSA 91:2">Mio Dio, in cui mi confido.<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3"/>Certo egli ti riscoterà dal laccio dell'uccellatore<note caller="*" style="x"><char style="xo" closed="false">91.3 </char><char style="xk" closed="false">uccellatore </char><char style="xt" closed="false"><ref loc="PSA 124:7">Sal. 124.7</ref>. <ref loc="ACT 12:11">Fat. 12.11</ref>.</char></note>,</para>
  <para style="q" vid="PSA 91:3">Dalla pestilenza mortifera.<verse eid="PSA 91:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4"/>Egli ti farà riparo colle sue penne,</para>
  <para style="q" vid="PSA 91:4">E tu ti ridurrai in salvo sotto alle sue ale<note caller="*" style="x"><char style="xo" closed="false">91.4 </char><char style="xk" closed="false">ale </char><char style="xt" closed="false"><ref loc="PSA 17:8">Sal. 17.8</ref>. <ref loc="MAT 23:37">Mat. 23.37</ref>.</char></note>;</para>
  <para style="q" vid="PSA 91:4">La sua verità <char style="add">ti sarà</char> scudo e targa.<verse eid="PSA 91:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5"/>Tu non temerai di spavento notturno,</para>
  <para style="q" vid="PSA 91:5">
    <char style="add">Nè</char> di saetta volante di giorno<note caller="*" style="x"><char style="xo" closed="false">91.5 </char><char style="xk" closed="false">giorno </char><char style="xt" closed="false"><ref loc="PSA 121:6">Sal. 121.6</ref>. <ref loc="PRO 3:23">Prov. 3.23</ref>,<ref loc="PRO 3:24">24</ref>. <ref loc="ISA 43:2">Is. 43.2</ref>.</char></note>;<verse eid="PSA 91:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6"/>
    <char style="add">Nè</char> di pestilenza <char style="add">che</char> vada attorno nelle tenebre;</para>
  <para style="q" vid="PSA 91:6">
    <char style="add">Nè</char> di sterminio <char style="add">che</char> distrugga in <char style="add">pien</char> mezzodì.<verse eid="PSA 91:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7"/>Mille te <char style="add">ne</char> caderanno al lato <char style="add">manco</char>,</para>
  <para style="q" vid="PSA 91:7">E diecimila al destro;</para>
  <para style="q" vid="PSA 91:7">
    <char style="add">E pur quello</char> non ti aggiungerà.<verse eid="PSA 91:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8"/>Sol riguarderai con gli occhi,</para>
  <para style="q" vid="PSA 91:8">E vedrai la retribuzione degli empi,<verse eid="PSA 91:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9"/>Perciocchè, o Signore, tu <char style="add">sei</char> il mio ricetto;</para>
  <para style="q" vid="PSA 91:9">Tu hai costituito l'Altissimo <char style="add">per</char> tuo abitacolo<note caller="*" style="x"><char style="xo" closed="false">91.9 </char><char style="xk" closed="false">abitacolo </char><char style="xt" closed="false"><ref loc="PSA 71:3">Sal. 71.3</ref>; <ref loc="PSA 90:1">90.1</ref>.</char></note>.<verse eid="PSA 91:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10"/>Male alcuno non ti avverrà<note caller="*" style="x"><char style="xo" closed="false">91.10 </char><char style="xk" closed="false">avverrà </char><char style="xt" closed="false"><ref loc="JOB 5:19">Giob. 5.19</ref>. <ref loc="PRO 12:21">Prov. 12.21</ref>.</char></note>,</para>
  <para style="q" vid="PSA 91:10">E piaga alcuna non si accosterà al tuo tabernacolo.<verse eid="PSA 91:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11"/>Perciocchè egli comanderà a' suoi Angeli intorno a te,</para>
  <para style="q" vid="PSA 91:11">Che ti guardino in tutte le tue vie<note caller="*" style="x"><char style="xo" closed="false">91.11 </char><char style="xk" closed="false">vie </char><char style="xt" closed="false"><ref loc="PSA 34:7">Sal. 34.7</ref>. <ref loc="MAT 4:6">Mat. 4.6</ref>. <ref loc="LUK 4:10">Luc. 4.10</ref>,<ref loc="LUK 4:11">11</ref>. <ref loc="HEB 1:14">Ebr. 1.14</ref>.</char></note>.<verse eid="PSA 91:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12"/>Essi ti leveranno in palma di mano,</para>
  <para style="q" vid="PSA 91:12">Che talora il tuo piè non s'intoppi in alcuna pietra.<verse eid="PSA 91:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13"/>Tu camminerai sopra il leone, e sopra l'aspido<note caller="*" style="x"><char style="xo" closed="false">91.13 </char><char style="xk" closed="false">aspido </char><char style="xt" closed="false"><ref loc="LUK 10:19">Luc. 10.19</ref>.</char></note>;</para>
  <para style="q" vid="PSA 91:13">Tu calcherai il leoncello e il dragone.<verse eid="PSA 91:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14"/>Perciocchè egli ha posta in me tutta la sua affezione, <char style="add">dice il Signore</char>, io lo libererò;</para>
  <para style="q" vid="PSA 91:14">
    <char style="add">E</char> lo leverò ad alto, perchè egli conosce il mio Nome.<verse eid="PSA 91:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15"/>Egli m'invocherà, e io gli risponderò;</para>
  <para style="q" vid="PSA 91:15">Io <char style="add">sarò</char> con lui <char style="add">quando sarà</char> in distretta<note caller="*" style="x"><char style="xo" closed="false">91.15 </char><char style="xk" closed="false">distretta </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sal. 50.15</ref> e rif. <ref loc="ISA 43:2">Is. 43.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 91:15">Io lo riscoterò e lo glorificherò<note caller="*" style="x"><char style="xo" closed="false">91.15 </char><char style="xk" closed="false">glorificherò </char><char style="xt" closed="false"><ref loc="1SA 2:30">1 Sam. 2.30</ref>.</char></note>.<verse eid="PSA 91:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16"/>Io lo sazierò di lunga vita<note caller="*" style="x"><char style="xo" closed="false">91.16 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="DEU 6:2">Deut. 6.2</ref>. <ref loc="PRO 3:2">Prov. 3.2</ref>,<ref loc="PRO 3:16">16</ref>.</char></note>,</para>
  <para style="q" vid="PSA 91:16">E gli farò veder la mia salute.<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">SALMO XCII</para>
  <para style="s1">Il Signore lodato per le sue opere, per la sua giustizia e per la sua grazia</para>
  <para style="d">Salmo di cantico per il giorno del sabato</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1"/>EGLI <char style="add">è</char> una bella cosa di celebrare il Signore,</para>
  <para style="q" vid="PSA 92:1">E di salmeggiare al tuo Nome, o Altissimo<note caller="*" style="x"><char style="xo" closed="false">92.1 </char><char style="xk" closed="false">Altissimo </char><char style="xt" closed="false"><ref loc="PSA 147:1">Sal. 147.1</ref>.</char></note>;<verse eid="PSA 92:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2"/>Di predicare per <char style="add">ogni</char> mattina la tua benignità,</para>
  <para style="q" vid="PSA 92:2">E la tua verità <char style="add">tutte</char> le notti;<verse eid="PSA 92:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3"/>In sul decacordo, e in sul saltero;</para>
  <para style="q" vid="PSA 92:3">Con canto di voce, giunto alla cetera.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4"/>Perciocchè, o Signore, tu mi hai rallegrato colle tue opere<note caller="*" style="x"><char style="xo" closed="false">92.4 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="PSA 111:2">Sal. 111.2</ref>. <ref loc="REV 15:3">Apoc. 15.3</ref>.</char></note>;</para>
  <para style="q" vid="PSA 92:4">Io giubilo ne' fatti delle tue mani.<verse eid="PSA 92:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5"/>Quanto son grandi, o Signore, le tue opere<note caller="*" style="x"><char style="xo" closed="false">92.5 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false">Giob. cap. 38-41. <ref loc="PSA 40:5">Sal. 40.5</ref>.</char></note>!</para>
  <para style="q" vid="PSA 92:5">I tuoi pensamenti son grandemente profondi<note caller="*" style="x"><char style="xo" closed="false">92.5 </char><char style="xk" closed="false">profondi </char><char style="xt" closed="false"><ref loc="ISA 28:29">Is. 28.29</ref>. <ref loc="ROM 11:33">Rom. 11.33</ref>,<ref loc="ROM 11:34">34</ref>.</char></note>.<verse eid="PSA 92:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6"/>L'uomo stolto non conosce,</para>
  <para style="q" vid="PSA 92:6">E il pazzo non intende questo:<verse eid="PSA 92:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7"/>Che gli empi germogliano come l'erba,</para>
  <para style="q" vid="PSA 92:7">E che tutti gli operatori d'iniquità fioriscono,</para>
  <para style="q" vid="PSA 92:7">Per perire in eterno<note caller="*" style="x"><char style="xo" closed="false">92.7 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 37:1">Sal. 37.1</ref>,<ref loc="PSA 37:2">2</ref>,<ref loc="PSA 37:35-38">35-38</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8"/>Ma tu, o Signore,</para>
  <para style="q" vid="PSA 92:8">
    <char style="add">Sei</char> l'Eccelso in eterno.<verse eid="PSA 92:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9"/>Perciocchè, ecco, i tuoi nemici, o Signore;</para>
  <para style="q" vid="PSA 92:9">Perciocchè, ecco, i tuoi nemici periranno;</para>
  <para style="q" vid="PSA 92:9">E tutti gli operatori d'iniquità saranno dissipati<note caller="*" style="x"><char style="xo" closed="false">92.9 </char><char style="xk" closed="false">dissipati </char><char style="xt" closed="false"><ref loc="PSA 68:1">Sal. 68.1</ref> ecc.</char></note>.<verse eid="PSA 92:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10"/>Ma tu alzerai il mio corno, come <char style="add">quello di</char> un liocorno;</para>
  <para style="q" vid="PSA 92:10">Io sarò unto d'olio verdeggiante.<verse eid="PSA 92:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11"/>E l'occhio mio riguarderà i miei nemici;</para>
  <para style="q" vid="PSA 92:11">E le mie orecchie udiranno <char style="add">ciò che io desidero</char> de' maligni</para>
  <para style="q" vid="PSA 92:11">Che si levano contro a me.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12"/>Il giusto fiorirà come la palma,</para>
  <para style="q" vid="PSA 92:12">Crescerà come il cedro nel Libano<note caller="*" style="x"><char style="xo" closed="false">92.12 </char><char style="xk" closed="false">Libano </char><char style="xt" closed="false"><ref loc="PSA 52:8">Sal. 52.8</ref>. <ref loc="HOS 14:5">Os. 14.5</ref>,<ref loc="HOS 14:6">6</ref>.</char></note>.<verse eid="PSA 92:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13"/>Quelli che saran piantati nella Casa del Signore</para>
  <para style="q" vid="PSA 92:13">Fioriranno ne' cortili del nostro Dio.<verse eid="PSA 92:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14"/>Nell'estrema vecchiezza ancor frutteranno,</para>
  <para style="q" vid="PSA 92:14">E saranno prosperi e verdeggianti;<verse eid="PSA 92:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15"/>Per predicare che il Signore, la mia Rocca<note caller="*" style="x"><char style="xo" closed="false">92.15 </char><char style="xk" closed="false">Rocca </char><char style="xt" closed="false"><ref loc="DEU 32:4">Deut. 32.4</ref> </char><char style="xta" closed="false">e rif.</char></note>, <char style="add">è</char> diritto;</para>
  <para style="q" vid="PSA 92:15">E che non <char style="add">vi è</char> alcuna iniquità in lui<note caller="*" style="x"><char style="xo" closed="false">92.15 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="ROM 9:14">Rom. 9.14</ref>.</char></note>.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">SALMO XCIII</para>
  <para style="s1">Potenza e maestà del regno di Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1"/>IL Signore regna<note caller="*" style="x"><char style="xo" closed="false">93.1 </char><char style="xk" closed="false">regna </char><char style="xt" closed="false"><ref loc="PSA 96:10">Sal. 96.10</ref>; <ref loc="PSA 97:1">97.1</ref>; <ref loc="PSA 99:1">99.1</ref>. <ref loc="ISA 52:7">Is. 52.7</ref>. <ref loc="REV 19:6">Apoc. 19.6</ref>.</char></note>; egli è vestito di maestà;</para>
  <para style="q" vid="PSA 93:1">Il Signore è vestito e cinto di forza;</para>
  <para style="q" vid="PSA 93:1">Il mondo eziandio è stabilito, e non sarà <char style="add">giammai</char> smosso.<verse eid="PSA 93:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2"/>Il tuo trono <char style="add">è</char> fermo da tutta eternità<note caller="*" style="x"><char style="xo" closed="false">93.2 </char><char style="xk" closed="false">eternità </char><char style="xt" closed="false"><ref loc="PSA 45:6">Sal. 45.6</ref>. <ref loc="PRO 8:22">Prov. 8.22</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 93:2">Tu <char style="add">sei</char> ab eterno.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3"/>I fiumi hanno alzato, o Signore,</para>
  <para style="q" vid="PSA 93:3">I fiumi hanno alzato il lor suono;</para>
  <para style="q" vid="PSA 93:3">I fiumi hanno alzate le loro onde;<verse eid="PSA 93:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4"/>
    <char style="add">Ma</char> il Signore, <char style="add">che è</char> disopra,</para>
  <para style="q" vid="PSA 93:4">
    <char style="add">È</char> più potente che il suono delle grandi acque,</para>
  <para style="q" vid="PSA 93:4">Che le possenti onde del mare<note caller="*" style="x"><char style="xo" closed="false">93.4 </char><char style="xk" closed="false">mare </char><char style="xt" closed="false"><ref loc="PSA 65:7">Sal. 65.7</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5"/>Le tue testimonianze son sommamente veraci, o Signore;</para>
  <para style="q" vid="PSA 93:5">La santità è bella nella tua Casa in perpetuo.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">SALMO XCIV</para>
  <para style="s1">Appello alla giustizia di Dio contro i malvagi</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1"/>O SIGNORE Iddio delle vendette<note caller="*" style="x"><char style="xo" closed="false">94.1 </char><char style="xk" closed="false">vendette </char><char style="xt" closed="false"><ref loc="DEU 32:35">Deut. 32.35</ref>. <ref loc="NAM 1:2">Na. 1.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 94:1">O Dio delle vendette, apparisci in gloria.<verse eid="PSA 94:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2"/>Innalzati, o Giudice della terra<note caller="*" style="x"><char style="xo" closed="false">94.2 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="GEN 18:25">Gen. 18.25</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 94:2">Rendi la retribuzione ai superbi.<verse eid="PSA 94:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3"/>Infino a quando, o Signore,</para>
  <para style="q" vid="PSA 94:3">Infino a quando trionferanno gli empi?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4"/>
    <char style="add">Infino a quando</char> sgorgheranno parole dure?</para>
  <para style="q" vid="PSA 94:4">
    <char style="add">Infino a quando</char> si vanteranno tutti gli operatori d'iniquità?<verse eid="PSA 94:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5"/>Signore, essi tritano il tuo popolo,</para>
  <para style="q" vid="PSA 94:5">Ed affliggono la tua eredità;<verse eid="PSA 94:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6"/>Uccidono la vedova e il forestiere,</para>
  <para style="q" vid="PSA 94:6">Ed ammazzano gli orfani;<verse eid="PSA 94:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7"/>E dicono: Il Signore non <char style="add">ne</char> vede,</para>
  <para style="q" vid="PSA 94:7">E l'Iddio di Giacobbe non <char style="add">ne</char> intende <char style="add">nulla</char><note caller="*" style="x"><char style="xo" closed="false">94.7 </char><char style="xk" closed="false"><char style="add">nulla</char> </char><char style="xt" closed="false"><ref loc="PSA 10:11">Sal. 10.11</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8"/>O <char style="add">voi</char> i più stolti del popolo, intendete;</para>
  <para style="q" vid="PSA 94:8">E <char style="add">voi</char> pazzi, quando sarete savi?<verse eid="PSA 94:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9"/>Colui che ha piantata l'orecchia<note caller="*" style="x"><char style="xo" closed="false">94.9 </char><char style="xk" closed="false">orecchia </char><char style="xt" closed="false"><ref loc="EXO 4:11">Esod. 4.11</ref>. <ref loc="PRO 20:12">Prov. 20.12</ref>.</char></note> non udirebbe egli?</para>
  <para style="q" vid="PSA 94:9">Colui che ha formato l'occhio non riguarderebbe egli?<verse eid="PSA 94:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10"/>Colui che gastiga le genti,</para>
  <para style="q" vid="PSA 94:10">Che insegna il conoscimento agli uomini<note caller="*" style="x"><char style="xo" closed="false">94.10 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="JOB 35:11">Giob. 35.11</ref>.</char></note>, non correggerebbe egli?<verse eid="PSA 94:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11"/>Il Signore conosce i pensieri degli uomini<note caller="*" style="x"><char style="xo" closed="false">94.11 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="1CO 3:20">1 Cor. 3.20</ref>.</char></note>,</para>
  <para style="q" vid="PSA 94:11">
    <char style="add">E sa</char> che son vanità.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12"/>Beato l'uomo il qual tu correggi<note caller="*" style="x"><char style="xo" closed="false">94.12 </char><char style="xk" closed="false">correggi </char><char style="xt" closed="false"><ref loc="JOB 5:17">Giob. 5.17</ref>. <ref loc="PRO 3:11">Prov. 3.11</ref>. <ref loc="1CO 11:32">1 Cor. 11.32</ref>. <ref loc="HEB 12:5-11">Ebr. 12.5-11</ref>.</char></note>, Signore,</para>
  <para style="q" vid="PSA 94:12">Ed ammaestri per la tua Legge;<verse eid="PSA 94:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13"/>Per dargli riposo, <char style="add">liberandolo</char> da' giorni dell'avversità,</para>
  <para style="q" vid="PSA 94:13">Mentre è cavata la fossa all'empio.<verse eid="PSA 94:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14"/>Perciocchè il Signore non lascerà il suo popolo,</para>
  <para style="q" vid="PSA 94:14">E non abbandonerà la sua eredità<note caller="*" style="x"><char style="xo" closed="false">94.14 </char><char style="xk" closed="false">eredità </char><char style="xt" closed="false"><ref loc="1SA 12:22">1 Sam. 12.22</ref>. <ref loc="ROM 11:1">Rom. 11.1</ref>,<ref loc="ROM 11:2">2</ref>.</char></note>.<verse eid="PSA 94:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15"/>Perciocchè il giudicio ritornerà a giustizia,</para>
  <para style="q" vid="PSA 94:15">E dietro a lui <char style="add">saranno</char> tutti <char style="add">quelli che son</char> diritti di cuore.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16"/>Chi si leverà per me contro a' maligni?</para>
  <para style="q" vid="PSA 94:16">Chi si presenterà per me contro agli operatori d'iniquità?<verse eid="PSA 94:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17"/>Se il Signore non <char style="add">fosse stato</char> mio aiuto<note caller="*" style="x"><char style="xo" closed="false">94.17 </char><char style="xk" closed="false">aiuto </char><char style="xt" closed="false"><ref loc="PSA 124:1">Sal. 124.1</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 94:17">Per poco l'anima mia sarebbe stata stanziata nel silenzio.<verse eid="PSA 94:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18"/>Quando io ho detto: Il mio piè vacilla;</para>
  <para style="q" vid="PSA 94:18">La tua benignità, o Signore, mi ha sostenuto.<verse eid="PSA 94:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19"/>Quando <char style="add">io sono stato</char> in gran pensieri dentro di me,</para>
  <para style="q" vid="PSA 94:19">Le tue consolazioni han rallegrata l'anima mia.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20"/>Il seggio delle malizie che forma iniquità in luogo di statuti<note caller="*" style="x"><char style="xo" closed="false">94.20 </char><char style="xk" closed="false">statuti </char><char style="xt" closed="false"><ref loc="ISA 10:1">Is. 10.1</ref>.</char></note>,</para>
  <para style="q" vid="PSA 94:20">Potrebbe egli esserti congiunto?<verse eid="PSA 94:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21"/>Essi corrono a schiere contro all'anima del giusto,</para>
  <para style="q" vid="PSA 94:21">E condannano il sangue innocente<note caller="*" style="x"><char style="xo" closed="false">94.21 </char><char style="xk" closed="false">innocente </char><char style="xt" closed="false"><ref loc="PRO 17:15">Prov. 17.15</ref>. <ref loc="MAT 27:1">Mat. 27.1</ref> ecc.</char></note>.<verse eid="PSA 94:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22"/>Ma il Signore mi è in vece d'alto ricetto;</para>
  <para style="q" vid="PSA 94:22">E l'Iddio mio in vece di rocca di confidanza.<verse eid="PSA 94:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23"/>Ed egli farà lor tornare addosso la loro iniquità,</para>
  <para style="q" vid="PSA 94:23">E li distruggerà per la lor <char style="add">propria</char> malizia<note caller="*" style="x"><char style="xo" closed="false">94.23 </char><char style="xk" closed="false">malizia </char><char style="xt" closed="false"><ref loc="PSA 7:16">Sal. 7.16</ref> e rif. <ref loc="PRO 5:22">Prov. 5.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 94:23">Il Signore Iddio nostro li distruggerà.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">SALMO XCV</para>
  <para style="s1">Invito a lodare il Signore e ad ascoltare la sua voce</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1"/>VENITE, cantiamo lietamente al Signore;</para>
  <para style="q" vid="PSA 95:1">Giubiliamo alla Rocca della nostra salute<note caller="*" style="x"><char style="xo" closed="false">95.1 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="DEU 32:15">Deut. 32.15</ref>. <ref loc="2SA 22:47">2 Sam. 22.47</ref>.</char></note>.<verse eid="PSA 95:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2"/>Andiamogli incontro con lodi,</para>
  <para style="q" vid="PSA 95:2">Giubiliamogli con salmi.<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3"/>Perciocchè il Signore <char style="add">è</char> Dio grande,</para>
  <para style="q" vid="PSA 95:3">E Re grande sopra tutti gl'iddii.<verse eid="PSA 95:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4"/>Perciocchè egli tiene in mano le profondità della terra;</para>
  <para style="q" vid="PSA 95:4">E le altezze de' monti <char style="add">sono</char> sue.<verse eid="PSA 95:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5"/>Ed a lui <char style="add">appartiene</char> il mare, perchè egli l'ha fatto<note caller="*" style="x"><char style="xo" closed="false">95.5 </char><char style="xk" closed="false">fatto </char><char style="xt" closed="false"><ref loc="GEN 1:9">Gen. 1.9</ref>,<ref loc="GEN 1:10">10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 95:5">E l'asciutto, <char style="add">perchè</char> le sue mani <char style="add">l</char>'hanno formato.<verse eid="PSA 95:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6"/>Venite, adoriamo, ed inchiniamoci;</para>
  <para style="q" vid="PSA 95:6">Inginocchiamoci davanti al Signore che ci ha fatti<note caller="*" style="x"><char style="xo" closed="false">95.6 </char><char style="xk" closed="false">fatti </char><char style="xt" closed="false"><ref loc="1CO 6:20">1 Cor. 6.20</ref>.</char></note>.<verse eid="PSA 95:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7"/>Perciocchè egli <char style="add">è</char> il nostro Dio;</para>
  <para style="q" vid="PSA 95:7">E noi <char style="add">siamo</char> il popolo del suo pasco<note caller="*" style="x"><char style="xo" closed="false">95.7 </char><char style="xk" closed="false">pasco </char><char style="xt" closed="false"><ref loc="PSA 79:13">Sal. 79.13</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 95:7">E la greggia della sua condotta.<verse eid="PSA 95:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8"/>Oggi, se udite la sua voce<note caller="*" style="x"><char style="xo" closed="false">95.8 </char><char style="xk" closed="false">voce </char><char style="xt" closed="false"><ref loc="HEB 3:7">Ebr. 3.7</ref> ecc.; <ref loc="HEB 4:7">4.7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 95:8">Non indurate il vostro cuore, come <char style="add">in</char> Meriba;</para>
  <para style="q" vid="PSA 95:8">Come <char style="add">al</char> giorno di Massa, nel deserto<note caller="*" style="x"><char style="xo" closed="false">95.8 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="EXO 17:2-7">Esod. 17.2-7</ref>. <ref loc="NUM 20:2">Num. 20.2</ref> ecc.</char></note>;<verse eid="PSA 95:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9"/>Ove i padri vostri mi tentarono,</para>
  <para style="q" vid="PSA 95:9">Mi provarono<note caller="*" style="x"><char style="xo" closed="false">95.9 </char><char style="xk" closed="false">provarono </char><char style="xt" closed="false"><ref loc="PSA 78:18">Sal. 78.18</ref>,<ref loc="PSA 78:40">40</ref>,<ref loc="PSA 78:56">56</ref>. <ref loc="1CO 10:9">1 Cor. 10.9</ref>.</char></note>, ed anche videro le mie opere<note caller="*" style="x"><char style="xo" closed="false">95.9 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="NUM 14:22">Num. 14.22</ref> ecc.</char></note>.<verse eid="PSA 95:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10"/>Lo spazio di quarant'anni <char style="add">quella</char> generazione mi fu di noia;</para>
  <para style="q" vid="PSA 95:10">Onde io dissi: Costoro <char style="add">sono</char> un popolo sviato di cuore,</para>
  <para style="q" vid="PSA 95:10">E non conoscono le mie vie.<verse eid="PSA 95:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11"/>Perciò giurai nell'ira mia:</para>
  <para style="q" vid="PSA 95:11">Se entrano <char style="add">giammai</char> nel mio riposo<note caller="*" style="x"><char style="xo" closed="false">95.11 </char><char style="xk" closed="false">riposo </char><char style="xt" closed="false"><ref loc="HEB 3:10">Ebr. 3.10</ref>,<ref loc="HEB 3:11">11</ref>,<ref loc="HEB 3:17">17</ref>,<ref loc="HEB 3:18">18</ref>; <ref loc="HEB 4:3">4.3</ref>,<ref loc="HEB 4:5">5</ref>.</char></note>.<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">SALMO XCVI</para>
  <para style="s1">Tutta la terra lodi e tema il Signore</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1"/>CANTATE al Signore un nuovo cantico<note caller="*" style="x"><char style="xo" closed="false">96.1 </char><char style="xk" closed="false">cantico </char><char style="xt" closed="false"><ref loc="1CH 16:23-33">1 Cron. 16.23-33</ref>.</char></note>;</para>
  <para style="q" vid="PSA 96:1">Cantate, o <char style="add">abitanti di</char> tutta la terra, al Signore.<verse eid="PSA 96:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2"/>Cantate al Signore, benedite il suo Nome;</para>
  <para style="q" vid="PSA 96:2">Predicate di giorno in giorno la sua salute.<verse eid="PSA 96:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3"/>Raccontate fra le genti la sua gloria,</para>
  <para style="q" vid="PSA 96:3">E le sue maraviglie fra tutti i popoli.<verse eid="PSA 96:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4"/>Perciocchè il Signore <char style="add">è</char> grande<note caller="*" style="x"><char style="xo" closed="false">96.4 </char><char style="xk" closed="false">grande </char><char style="xt" closed="false"><ref loc="PSA 145:3">Sal. 145.3</ref>.</char></note>, e degno di sovrana lode;</para>
  <para style="q" vid="PSA 96:4">Egli <char style="add">è</char> tremendo sopra tutti gl'iddii.<verse eid="PSA 96:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5"/>Perciocchè tutti gl'iddii de' popoli <char style="add">sono</char> idoli<note caller="*" style="x"><char style="xo" closed="false">96.5 </char><char style="xk" closed="false">idoli </char><char style="xt" closed="false"><ref loc="JER 10:11">Ger. 10.11</ref>,<ref loc="JER 10:12">12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 96:5">Ma il Signore ha fatti i cieli<note caller="*" style="x"><char style="xo" closed="false">96.5 </char><char style="xk" closed="false">cieli </char><char style="xt" closed="false"><ref loc="ISA 42:5">Is. 42.5</ref>.</char></note>.<verse eid="PSA 96:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6"/>Maestà e magnificenza <char style="add">sono</char> davanti a lui;</para>
  <para style="q" vid="PSA 96:6">Forza e gloria <char style="add">sono</char> nel suo santuario.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7"/>Date al Signore, o generazioni de' popoli,</para>
  <para style="q" vid="PSA 96:7">Date al Signore gloria e forza.<verse eid="PSA 96:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8"/>Date al Signore la gloria <char style="add">dovuta</char> al suo Nome;</para>
  <para style="q" vid="PSA 96:8">Portategli offerte, e venite ne' suoi cortili.<verse eid="PSA 96:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9"/>Adorate il Signore nel magnifico santuario;</para>
  <para style="q" vid="PSA 96:9">Tremate, o <char style="add">abitanti di</char> tutta la terra, per la sua presenza.<verse eid="PSA 96:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10"/>Dite fra le genti: Il Signore regna<note caller="*" style="x"><char style="xo" closed="false">96.10 </char><char style="xk" closed="false">regna </char><char style="xt" closed="false"><ref loc="PSA 93:1">Sal. 93.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 96:10">Il mondo sarà pure stabilito, <char style="add">e</char> non sarà <char style="add">più</char> smosso;</para>
  <para style="q" vid="PSA 96:10">Egli giudicherà i popoli in dirittura.<verse eid="PSA 96:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11"/>Rallegrinsi i cieli, e gioisca la terra;</para>
  <para style="q" vid="PSA 96:11">Risuoni il mare, e quello ch'è in esso.<verse eid="PSA 96:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12"/>Festeggi la campagna, e tutto quello ch'è in essa<note caller="*" style="x"><char style="xo" closed="false">96.12 </char><char style="xk" closed="false">essa </char><char style="xt" closed="false"><ref loc="ISA 35:1">Is. 35.1</ref>.</char></note>.</para>
  <para style="q" vid="PSA 96:12">Allora tutti gli alberi delle selve daranno voci d'allegrezza,<verse eid="PSA 96:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13"/>Nel cospetto del Signore; perciocchè egli viene,</para>
  <para style="q" vid="PSA 96:13">Egli viene per giudicar la terra;</para>
  <para style="q" vid="PSA 96:13">Egli giudicherà il mondo in giustizia<note caller="*" style="x"><char style="xo" closed="false">96.13 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 67:4">Sal. 67.4</ref>. <ref loc="REV 19:11">Apoc. 19.11</ref>.</char></note>,</para>
  <para style="q" vid="PSA 96:13">Ed i popoli nella sua verità.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">SALMO XCVII</para>
  <para style="s1">Maestà del regno di Dio; gastigo degli empi; esortazione alla pietà ed alla gioia</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1"/>IL Signore regna<note caller="*" style="x"><char style="xo" closed="false">97.1 </char><char style="xk" closed="false">regna </char><char style="xt" closed="false"><ref loc="PSA 96:10">Sal. 96.10</ref> </char><char style="xta" closed="false">e rif.</char></note>: gioisca la terra;</para>
  <para style="q" vid="PSA 97:1">Rallegrinsi le grandi isole.<verse eid="PSA 97:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2"/>Nuvola e caligine <char style="add">sono</char> d'intorno a lui;</para>
  <para style="q" vid="PSA 97:2">Giustizia e giudicio <char style="add">sono</char> il fermo sostegno del suo trono.<verse eid="PSA 97:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3"/>Fuoco va davanti a lui<note caller="*" style="x"><char style="xo" closed="false">97.3 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="DAN 7:10">Dan. 7.10</ref>.</char></note>,</para>
  <para style="q" vid="PSA 97:3">E divampa i suoi nemici d'ogn'intorno.<verse eid="PSA 97:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4"/>I suoi folgori alluminano il mondo;</para>
  <para style="q" vid="PSA 97:4">La terra <char style="add">l</char>'ha veduto, ed ha tremato<note caller="*" style="x"><char style="xo" closed="false">97.4 </char><char style="xk" closed="false">tremato </char><char style="xt" closed="false"><ref loc="EXO 19:18">Esod. 19.18</ref>. <ref loc="PSA 104:32">Sal. 104.32</ref>.</char></note>.<verse eid="PSA 97:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5"/>I monti si struggono come cera per la presenza del Signore,</para>
  <para style="q" vid="PSA 97:5">Per la presenza del Signor di tutta la terra.<verse eid="PSA 97:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6"/>I cieli predicano la sua giustizia<note caller="*" style="x"><char style="xo" closed="false">97.6 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="PSA 19:1">Sal. 19.1</ref>; <ref loc="PSA 50:6">50.6</ref>.</char></note>,</para>
  <para style="q" vid="PSA 97:6">E tutti i popoli veggono la sua gloria.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7"/>Tutti quelli che servono alle sculture,</para>
  <para style="q" vid="PSA 97:7">Che si gloriano negl'idoli, sien confusi<note caller="*" style="x"><char style="xo" closed="false">97.7 </char><char style="xk" closed="false">confusi </char><char style="xt" closed="false"><ref loc="EXO 20:4">Esod. 20.4</ref>. <ref loc="DEU 27:15">Deut. 27.15</ref>.</char></note>, adoratelo, dii tutti.<verse eid="PSA 97:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8"/>Sion <char style="add">l</char>'ha udito, e se <char style="add">n'è</char> rallegrata;</para>
  <para style="q" vid="PSA 97:8">E le figliuole di Giuda hanno festeggiato</para>
  <para style="q" vid="PSA 97:8">Per li tuoi giudicii, o Signore.<verse eid="PSA 97:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9"/>Perciocchè tu <char style="add">sei</char> il Signore, l'Eccelso sopra tutta la terra;</para>
  <para style="q" vid="PSA 97:9">Tu sei grandemente innalzato sopra tutti gl'iddii.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10"/>
    <char style="add">Voi</char> che amate il Signore, odiate il male<note caller="*" style="x"><char style="xo" closed="false">97.10 </char><char style="xk" closed="false">male </char><char style="xt" closed="false"><ref loc="ROM 12:9">Rom. 12.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 97:10">Egli guarda le anime de' suoi santi;</para>
  <para style="q" vid="PSA 97:10">
    <char style="add">E</char> le riscuote di man degli empi<note caller="*" style="x"><char style="xo" closed="false">97.10 </char><char style="xk" closed="false">empi </char><char style="xt" closed="false"><ref loc="PSA 37:39">Sal. 37.39</ref>,<ref loc="PSA 37:40">40</ref>. <ref loc="DAN 3:28">Dan. 3.28</ref>; <ref loc="DAN 6:22">6.22</ref>,<ref loc="DAN 6:27">27</ref>. <ref loc="ACT 12:11">Fat. 12.11</ref>.</char></note>.<verse eid="PSA 97:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11"/>La luce <char style="add">è</char> seminata al giusto<note caller="*" style="x"><char style="xo" closed="false">97.11 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="PSA 112:4">Sal. 112.4</ref>. <ref loc="PRO 4:18">Prov. 4.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 97:11">E l'allegrezza a quelli che son diritti di cuore.<verse eid="PSA 97:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12"/>Rallegratevi, o giusti, nel Signore;</para>
  <para style="q" vid="PSA 97:12">E celebrate la memoria della sua santità.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">SALMO XCVIII</para>
  <para style="s1">Dio lodato per la proclamazione della salute</para>
  <para style="d">Salmo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1"/>CANTATE al Signore un nuovo cantico;</para>
  <para style="q" vid="PSA 98:1">Perciocchè egli ha fatte maraviglie<note caller="*" style="x"><char style="xo" closed="false">98.1 </char><char style="xk" closed="false">maraviglie </char><char style="xt" closed="false"><ref loc="EXO 15:11">Esod. 15.11</ref>. <ref loc="LUK 1:51">Luc. 1.51</ref>.</char></note>;</para>
  <para style="q" vid="PSA 98:1">La sua destra e il braccio della sua santità gli hanno acquistata salute.<verse eid="PSA 98:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2"/>Il Signore ha fatta conoscer la sua salute;</para>
  <para style="q" vid="PSA 98:2">Egli ha manifestata la sua giustizia nel cospetto delle genti<note caller="*" style="x"><char style="xo" closed="false">98.2 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="LUK 2:31">Luc. 2.31</ref>. <ref loc="ROM 3:25">Rom. 3.25</ref>,<ref loc="ROM 3:26">26</ref>.</char></note>.<verse eid="PSA 98:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3"/>Egli si è ricordato della sua benignità, e della sua verità,</para>
  <para style="q" vid="PSA 98:3">Verso la casa d'Israele<note caller="*" style="x"><char style="xo" closed="false">98.3 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="LUK 1:54">Luc. 1.54</ref>,<ref loc="LUK 1:55">55</ref>,<ref loc="LUK 1:72">72</ref>.</char></note>;</para>
  <para style="q" vid="PSA 98:3">Tutte le estremità della terra hanno veduta la salute del nostro Dio<note caller="*" style="x"><char style="xo" closed="false">98.3 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="ACT 13:46">Fat. 13.46</ref>,<ref loc="ACT 13:47">47</ref>; <ref loc="ACT 28:28">28.28</ref>.</char></note>.<verse eid="PSA 98:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4"/>
    <char style="add">O abitanti di</char> tutta la terra,</para>
  <para style="q" vid="PSA 98:4">Giubilate al Signore;</para>
  <para style="q" vid="PSA 98:4">Risonate, cantate, e salmeggiate.<verse eid="PSA 98:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5"/>Salmeggiate al Signore colla cetera.</para>
  <para style="q" vid="PSA 98:5">Colla cetera giunta alla voce di canto.<verse eid="PSA 98:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6"/>Date voci d'allegrezza con trombe, e suon di corno,</para>
  <para style="q" vid="PSA 98:6">Nel cospetto del Re, del Signore.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7"/>Rimbombi il mare, e ciò che è in esso;</para>
  <para style="q" vid="PSA 98:7">Il mondo, e i suoi abitanti.<verse eid="PSA 98:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8"/>Battansi i fiumi a palme;</para>
  <para style="q" vid="PSA 98:8">Cantino d'allegrezza tutti i monti.<verse eid="PSA 98:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9"/>Nel cospetto del Signore; perciocchè egli viene per giudicar la terra;</para>
  <para style="q" vid="PSA 98:9">Egli giudicherà il mondo in giustizia,</para>
  <para style="q" vid="PSA 98:9">E i popoli in dirittura.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">SALMO XCIX</para>
  <para style="s1">Grandezza del regno di Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1"/>IL Signore regna<note caller="*" style="x"><char style="xo" closed="false">99.1 </char><char style="xk" closed="false">regna </char><char style="xt" closed="false"><ref loc="PSA 93:1">Sal. 93.1</ref> </char><char style="xta" closed="false">e rif.</char></note>: temino i popoli;</para>
  <para style="q" vid="PSA 99:1">Colui che siede sopra i Cherubini<note caller="*" style="x"><char style="xo" closed="false">99.1 </char><char style="xk" closed="false">Cherubini </char><char style="xt" closed="false"><ref loc="EXO 25:22">Esod. 25.22</ref> </char><char style="xta" closed="false">e rif.</char></note> <char style="add">regna:</char> la terra tremi.<verse eid="PSA 99:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2"/>Il Signore è grande in Sion,</para>
  <para style="q" vid="PSA 99:2">Ed eccelso sopra tutti i popoli.<verse eid="PSA 99:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3"/>Essi celebreranno, <char style="add">o Signore</char>, il tuo Nome grande e tremendo<note caller="*" style="x"><char style="xo" closed="false">99.3 </char><char style="xk" closed="false">tremendo </char><char style="xt" closed="false"><ref loc="DEU 28:58">Deut. 28.58</ref>. <ref loc="REV 15:4">Apoc. 15.4</ref>.</char></note>.</para>
  <para style="q" vid="PSA 99:3">Esso <char style="add">è</char> santo.<verse eid="PSA 99:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4"/>E la forza del Re ama il giudicio<note caller="*" style="x"><char style="xo" closed="false">99.4 </char><char style="xk" closed="false">giudicio </char><char style="xt" closed="false"><ref loc="JOB 36:5-7">Giob. 36.5-7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 99:4">Tu hai stabilita la dirittura;</para>
  <para style="q" vid="PSA 99:4">Tu hai fatto giudicio, e giustizia in Giacobbe.<verse eid="PSA 99:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5"/>Esaltate il Signore Iddio nostro,</para>
  <para style="q" vid="PSA 99:5">E adorate davanti allo scannello de' suoi piedi.</para>
  <para style="q" vid="PSA 99:5">Egli <char style="add">è</char> santo<note caller="*" style="x"><char style="xo" closed="false">99.5 </char><char style="xk" closed="false">santo </char><char style="xt" closed="false"><ref loc="LEV 19:2">Lev. 19.2</ref>. <ref loc="JOS 24:19">Gios. 24.19</ref>.</char></note>.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6"/>Mosè ed Aaronne <char style="add">furono</char> fra i suoi sacerdoti;</para>
  <para style="q" vid="PSA 99:6">E Samuele fra quelli che invocarono il suo Nome.</para>
  <para style="q" vid="PSA 99:6">Essi invocarono il Signore, ed egli rispose loro<note caller="*" style="x"><char style="xo" closed="false">99.6 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="EXO 15:25">Esod. 15.25</ref>; <ref loc="EXO 17:11">17.11</ref>,<ref loc="EXO 17:12">12</ref>; <ref loc="EXO 32:31">32.31</ref> ecc. <ref loc="1SA 7:9">1 Sam. 7.9</ref>; <ref loc="1SA 12:18">12.18</ref>.</char></note>.<verse eid="PSA 99:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7"/>Egli parlò loro dalla colonna della nuvola<note caller="*" style="x"><char style="xo" closed="false">99.7 </char><char style="xk" closed="false">nuvola </char><char style="xt" closed="false"><ref loc="EXO 33:9">Esod. 33.9</ref>. <ref loc="NUM 12:5">Num. 12.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 99:7">Essi altresì osservarono le sue testimonianze,</para>
  <para style="q" vid="PSA 99:7">E gli statuti <char style="add">ch</char>'egli diede loro.<verse eid="PSA 99:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8"/>O Signore Iddio nostro, tu li esaudisti;</para>
  <para style="q" vid="PSA 99:8">Tu fosti loro un Dio perdonatore<note caller="*" style="x"><char style="xo" closed="false">99.8 </char><char style="xk" closed="false">perdonatore </char><char style="xt" closed="false"><ref loc="NUM 14:20">Num. 14.20</ref>.</char></note>;</para>
  <para style="q" vid="PSA 99:8">Ma <char style="add">altresì</char> vendicator de' lor fatti<note caller="*" style="x"><char style="xo" closed="false">99.8 </char><char style="xk" closed="false">fatti </char><char style="xt" closed="false"><ref loc="EXO 32:2">Esod. 32.2</ref> ecc. <ref loc="NUM 20:12">Num. 20.12</ref>,<ref loc="NUM 20:24">24</ref>.</char></note>.<verse eid="PSA 99:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9"/>Esaltate il Signore Iddio nostro,</para>
  <para style="q" vid="PSA 99:9">E adorate nel monte della sua santità;</para>
  <para style="q" vid="PSA 99:9">Perciocchè il Signore Iddio nostro <char style="add">è</char> santo.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">SALMO C</para>
  <para style="s1">Dio lodato da tutte le sue creature</para>
  <para style="d">Salmo di lode</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1"/>VOI tutti <char style="add">gli abitanti del</char>la terra,</para>
  <para style="q" vid="PSA 100:1">Giubilate al Signore.<verse eid="PSA 100:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2"/>Servite al Signore con allegrezza;</para>
  <para style="q" vid="PSA 100:2">Venite nel suo cospetto con canto.<verse eid="PSA 100:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3"/>Riconoscete che il Signore è Iddio;</para>
  <para style="q" vid="PSA 100:3">Egli è quel che ci ha fatti, e non noi stessi<note caller="*" style="x"><char style="xo" closed="false">100.3 </char><char style="xk" closed="false">stessi </char><char style="xt" closed="false"><ref loc="PSA 119:73">Sal. 119.73</ref>. <ref loc="EPH 2:10">Efes. 2.10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 100:3">
    <char style="add">Noi</char> suo popolo, e greggia del suo pasco<note caller="*" style="x"><char style="xo" closed="false">100.3 </char><char style="xk" closed="false">pasco </char><char style="xt" closed="false"><ref loc="PSA 95:7">Sal. 95.7</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 100:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4"/>Entrate nelle sue porte con ringraziamento,</para>
  <para style="q" vid="PSA 100:4">
    <char style="add">E</char> ne' suoi cortili con lode;</para>
  <para style="q" vid="PSA 100:4">Celebratelo, benedite il suo Nome.<verse eid="PSA 100:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5"/>Perciocchè il Signore <char style="add">è</char> buono; la sua benignità <char style="add">dura</char> in eterno<note caller="*" style="x"><char style="xo" closed="false">100.5 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 136:1">Sal. 136.1</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 100:5">E la sua verità per ogni età.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">SALMO CI</para>
  <para style="s1">Davide promette a Dio di camminare in integrità e di opporsi ai malvagi</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1"/>IO canterò <char style="add">un cantico</char> di benignità e di giudicio;</para>
  <para style="q" vid="PSA 101:1">Io te <char style="add">lo</char> salmeggerò, o Signore.<verse eid="PSA 101:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2"/>Io comporrò una maestrevol canzone intorno alla via intiera.</para>
  <para style="q" vid="PSA 101:2">Quando verrai a me?</para>
  <para style="q" vid="PSA 101:2">Io camminerò nell'integrità del mio cuore</para>
  <para style="q" vid="PSA 101:2">Dentro alla mia casa.<verse eid="PSA 101:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3"/>Io non mi proporrò davanti agli occhi cosa alcuna scellerata;</para>
  <para style="q" vid="PSA 101:3">Io odio i fatti<note caller="*" style="x"><char style="xo" closed="false">101.3 </char><char style="xk" closed="false">fatti </char><char style="xt" closed="false"><ref loc="PSA 97:10">Sal. 97.10</ref>.</char></note> degli sviati<note caller="*" style="x"><char style="xo" closed="false">101.3 </char><char style="xk" closed="false">sviati </char><char style="xt" closed="false"><ref loc="JOS 23:6">Gios. 23.6</ref>. <ref loc="1SA 12:20">1 Sam. 12.20</ref>,<ref loc="1SA 12:21">21</ref>.</char></note>;</para>
  <para style="q" vid="PSA 101:3">
    <char style="add">Niuno di essi</char> mi starà appresso.<verse eid="PSA 101:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4"/>Il cuor perverso si dipartirà da me;</para>
  <para style="q" vid="PSA 101:4">Io non conoscerò il malvagio<note caller="*" style="x"><char style="xo" closed="false">101.4 </char><char style="xk" closed="false">malvagio </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat. 7.23</ref>. <ref loc="2TI 2:19">2 Tim. 2.19</ref>.</char></note>.<verse eid="PSA 101:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5"/>Io sterminerò chi sparlerà in segreto contro al suo prossimo;</para>
  <para style="q" vid="PSA 101:5">Io non comporterò l'uomo con gli occhi altieri,</para>
  <para style="q" vid="PSA 101:5">E col cuor gonfio<note caller="*" style="x"><char style="xo" closed="false">101.5 </char><char style="xk" closed="false">gonfio </char><char style="xt" closed="false"><ref loc="PSA 18:26">Sal. 18.26</ref>. <ref loc="PRO 6:16">Prov. 6.16</ref>,<ref loc="PRO 6:17">17</ref>.</char></note>.<verse eid="PSA 101:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6"/>Io avrò l'occhio sugli uomini leali della terra</para>
  <para style="q" vid="PSA 101:6">A ciò che dimorino meco;</para>
  <para style="q" vid="PSA 101:6">Chi cammina per la via intiera mi servirà.<verse eid="PSA 101:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7"/>Chi usa frode nelle sue opere non abiterà dentro alla mia casa;</para>
  <para style="q" vid="PSA 101:7">Chi parla menzogne non sarà stabilito davanti agli occhi miei.<verse eid="PSA 101:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8"/>Ogni mattina io distruggerò tutti gli empi del paese;</para>
  <para style="q" vid="PSA 101:8">Per isterminar dalla Città del Signore</para>
  <para style="q" vid="PSA 101:8">Tutti gli operatori d'iniquità.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">SALMO CII</para>
  <para style="s1">Nella sua estrema afflizione, il Salmista ricorre a Dio affinchè ristabilisca il suo popolo, e riconduca la terra sotto alla sua ubbidienza</para>
  <para style="d">Orazione dell'afflitto, essendo angosciato, e spandendo il suo lamento davanti a Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1"/>SIGNORE, ascolta la mia orazione,</para>
  <para style="q" vid="PSA 102:1">E venga il mio grido infino a te.<verse eid="PSA 102:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2"/>Non nasconder la tua faccia da me<note caller="*" style="x"><char style="xo" closed="false">102.2 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="PSA 27:9">Sal. 27.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 102:2">Nel giorno che io sono in distretta, inchina a me il tuo orecchio;</para>
  <para style="q" vid="PSA 102:2">Nel giorno che io grido, affrettati a rispondermi.<verse eid="PSA 102:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3"/>Perciocchè i miei giorni son venuti meno come fumo<note caller="*" style="x"><char style="xo" closed="false">102.3 </char><char style="xk" closed="false">fumo </char><char style="xt" closed="false"><ref loc="JAS 4:14">Giac. 4.14</ref>.</char></note>,</para>
  <para style="q" vid="PSA 102:3">E le mie ossa sono arse come un tizzone.<verse eid="PSA 102:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4"/>Il mio cuore è stato percosso come erba,</para>
  <para style="q" vid="PSA 102:4">Ed è seccato;</para>
  <para style="q" vid="PSA 102:4">Perciocchè io ho dimenticato di mangiare il mio pane.<verse eid="PSA 102:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5"/>Le mie ossa sono attaccate alla mia carne,</para>
  <para style="q" vid="PSA 102:5">Per la voce de' miei gemiti.<verse eid="PSA 102:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6"/>Io son divenuto simile al pellicano del deserto;</para>
  <para style="q" vid="PSA 102:6">E son come il gufo delle solitudini.<verse eid="PSA 102:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7"/>Io vegghio, e sono</para>
  <para style="q" vid="PSA 102:7">Come il passero solitario sopra il tetto<note caller="*" style="x"><char style="xo" closed="false">102.7 </char><char style="xk" closed="false">tetto </char><char style="xt" closed="false"><ref loc="PSA 38:11">Sal. 38.11</ref>.</char></note>.</para>
  <para style="q" vid="PSA 102:7">I miei nemici mi fanno vituperio tuttodì;<verse eid="PSA 102:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8"/>Quelli che sono infuriati contro a me fanno delle esecrazioni di me<note caller="*" style="x"><char style="xo" closed="false">102.8 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="ACT 23:12">Fat. 23.12</ref>.</char></note>.<verse eid="PSA 102:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9"/>Perciocchè io ho mangiata la cenere come pane,</para>
  <para style="q" vid="PSA 102:9">Ed ho temperata la mia bevanda con lagrime.<verse eid="PSA 102:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10"/>Per la tua indegnazione, e per lo tuo cruccio;</para>
  <para style="q" vid="PSA 102:10">Perciocchè, avendomi levato ad alto, tu mi hai gettato <char style="add">a basso</char>.<verse eid="PSA 102:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11"/>I miei giorni <char style="add">son</char> come l'ombra che dichina<note caller="*" style="x"><char style="xo" closed="false">102.11 </char><char style="xk" closed="false">dichina </char><char style="xt" closed="false"><ref loc="JOB 14:2">Giob. 14.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 102:11">Ed io son secco come erba<note caller="*" style="x"><char style="xo" closed="false">102.11 </char><char style="xk" closed="false">erba </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">Is. 40.6-8</ref>. <ref loc="JAS 1:10">Giac. 1.10</ref>,<ref loc="JAS 1:11">11</ref>.</char></note>.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12"/>Ma tu, Signore, dimori in eterno<note caller="*" style="x"><char style="xo" closed="false">102.12 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 9:7">Sal. 9.7</ref>. <ref loc="LAM 5:19">Lam. 5.19</ref>.</char></note></para>
  <para style="q" vid="PSA 102:12">E la tua memoria <char style="add">è</char> per ogni età.<verse eid="PSA 102:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13"/>Tu ti leverai, tu avrai compassione di Sion;</para>
  <para style="q" vid="PSA 102:13">Perciocchè <char style="add">egli è</char> tempo di averne pietà;</para>
  <para style="q" vid="PSA 102:13">Perciocchè il termine è giunto<note caller="*" style="x"><char style="xo" closed="false">102.13 </char><char style="xk" closed="false">giunto </char><char style="xt" closed="false"><ref loc="ISA 40:2">Is. 40.2</ref>.</char></note>.<verse eid="PSA 102:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14"/>Imperocchè i tuoi servitori hanno affezione alle pietre di essa,</para>
  <para style="q" vid="PSA 102:14">Ed hanno pietà della sua polvere.<verse eid="PSA 102:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15"/>E le genti temeranno il Nome del Signore,</para>
  <para style="q" vid="PSA 102:15">E tutti i re della terra la tua gloria<note caller="*" style="x"><char style="xo" closed="false">102.15 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="ISA 60:3">Is. 60.3</ref>.</char></note>,<verse eid="PSA 102:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16"/>Quando il Signore avrà riedificata Sion,</para>
  <para style="q" vid="PSA 102:16">
    <char style="add">Quando</char> egli sarà apparito nella sua gloria,<verse eid="PSA 102:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17"/>Ed avrà volto lo sguardo all'orazione de' desolati<note caller="*" style="x"><char style="xo" closed="false">102.17 </char><char style="xk" closed="false">desolati </char><char style="xt" closed="false"><ref loc="NEH 1:6">Neem. 1.6</ref>,<ref loc="NEH 1:11">11</ref>; <ref loc="NEH 2:8">2.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 102:17">E non avrà sprezzata la lor preghiera.<verse eid="PSA 102:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18"/>Ciò sarà scritto all'età a venire<note caller="*" style="x"><char style="xo" closed="false">102.18 </char><char style="xk" closed="false">venire </char><char style="xt" closed="false"><ref loc="ROM 15:4">Rom. 15.4</ref>. <ref loc="1CO 10:11">1 Cor. 10.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 102:18">E il popolo che sarà creato loderà il Signore<note caller="*" style="x"><char style="xo" closed="false">102.18 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 22:31">Sal. 22.31</ref>. <ref loc="ISA 43:21">Is. 43.21</ref>.</char></note>.<verse eid="PSA 102:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19"/>Perciocchè egli avrà riguardato dall'alto luogo della sua santità;</para>
  <para style="q" vid="PSA 102:19">Perciocchè il Signore avrà mirato dal cielo verso la terra;<verse eid="PSA 102:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20"/>Per udire i gemiti de' prigioni<note caller="*" style="x"><char style="xo" closed="false">102.20 </char><char style="xk" closed="false">prigioni </char><char style="xt" closed="false"><ref loc="PSA 79:11">Sal. 79.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 102:20">Per isciogliere quelli ch'erano condannati a morte;<verse eid="PSA 102:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21"/>Acciocchè si narri in Sion il Nome del Signore,</para>
  <para style="q" vid="PSA 102:21">E la sua lode in Gerusalemme.<verse eid="PSA 102:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22"/>Quando i popoli e i regni saranno raunati insieme,</para>
  <para style="q" vid="PSA 102:22">Per servire al Signore.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23"/>Egli ha tra via abbattute le mie forze;</para>
  <para style="q" vid="PSA 102:23">Egli ha scorciati i miei giorni.<verse eid="PSA 102:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24"/>Io dirò: O Dio mio, non farmi trapassare al mezzo de' miei dì<note caller="*" style="x"><char style="xo" closed="false">102.24 </char><char style="xk" closed="false">dì </char><char style="xt" closed="false"><ref loc="ISA 38:10">Is. 38.10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 102:24">I tuoi anni <char style="add">durano</char> per ogni età<note caller="*" style="x"><char style="xo" closed="false">102.24 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="PSA 90:2">Sal. 90.2</ref>. <ref loc="HAB 1:12">Abac. 1.12</ref>.</char></note>.<verse eid="PSA 102:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25"/>Tu fondasti già la terra;</para>
  <para style="q" vid="PSA 102:25">E i cieli <char style="add">son</char> l'opera delle tue mani<note caller="*" style="x"><char style="xo" closed="false">102.25 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="GEN 1:1">Gen. 1.1</ref>; <ref loc="GEN 2:1">2.1</ref>. <ref loc="HEB 1:10-12">Ebr. 1.10-12</ref>.</char></note>;<verse eid="PSA 102:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26"/>Queste cose periranno, ma tu dimorerai;</para>
  <para style="q" vid="PSA 102:26">Ed esse invecchieranno tutte, come un vestimento;</para>
  <para style="q" vid="PSA 102:26">Tu le muterai come una vesta, e trapasseranno<note caller="*" style="x"><char style="xo" closed="false">102.26 </char><char style="xk" closed="false">trapasseranno </char><char style="xt" closed="false"><ref loc="ISA 34:4">Is. 34.4</ref>; <ref loc="ISA 51:6">51.6</ref>; <ref loc="ISA 65:17">65.17</ref>. <ref loc="MAT 24:35">Mat. 24.35</ref>. <ref loc="2PE 3:7">2 Piet. 3.7</ref>,<ref loc="2PE 3:10-12">10-12</ref>.</char></note>.<verse eid="PSA 102:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27"/>Ma tu <char style="add">sei sempre</char> lo stesso<note caller="*" style="x"><char style="xo" closed="false">102.27 </char><char style="xk" closed="false">stesso </char><char style="xt" closed="false"><ref loc="MAL 3:6">Mal. 3.6</ref>. <ref loc="HEB 13:8">Ebr. 13.8</ref>. <ref loc="JAS 1:17">Giac. 1.17</ref>.</char></note>,</para>
  <para style="q" vid="PSA 102:27">E gli anni tuoi non finiranno giammai.<verse eid="PSA 102:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28"/>I figliuoli de' tuoi servitori abiteranno,</para>
  <para style="q" vid="PSA 102:28">E la progenie loro sarà stabilita nel tuo cospetto.<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">SALMO CIII</para>
  <para style="s1">Invito a lodare Iddio per tutte le sue grazie</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1"/>BENEDICI, anima mia, il Signore<note caller="*" style="x"><char style="xo" closed="false">103.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 104:1">Sal. 104.1</ref>,<ref loc="PSA 104:35">35</ref>; <ref loc="PSA 146:1">146.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:1">E tutte le mie interiora <char style="add">benedite</char> il Nome suo santo.<verse eid="PSA 103:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2"/>Benedici, anima mia, il Signore,</para>
  <para style="q" vid="PSA 103:2">E non dimenticare alcuno dei suoi beneficii<note caller="*" style="x"><char style="xo" closed="false">103.2 </char><char style="xk" closed="false">beneficii </char><char style="xt" closed="false"><ref loc="DEU 6:12">Deut. 6.12</ref>; <ref loc="DEU 8:11">8.11</ref>.</char></note>.<verse eid="PSA 103:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3"/>
    <char style="add">Egli è quel</char> che <char style="add">ti</char> perdona tutte le tue iniquità<note caller="*" style="x"><char style="xo" closed="false">103.3 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 130:8">Sal. 130.8</ref>. <ref loc="MAT 9:2">Mat. 9.2</ref>,<ref loc="MAT 9:6">6</ref>. <ref loc="MRK 2:5">Mar. 2.5</ref>,<ref loc="MRK 2:10">10</ref>,<ref loc="MRK 2:11">11</ref>. <ref loc="LUK 7:47">Luc. 7.47</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:3">Che sana tutte le tue infermità<note caller="*" style="x"><char style="xo" closed="false">103.3 </char><char style="xk" closed="false">infermità </char><char style="xt" closed="false"><ref loc="EXO 15:26">Esod. 15.26</ref>. <ref loc="PSA 147:3">Sal. 147.3</ref>.</char></note>;<verse eid="PSA 103:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4"/>Che riscuote dalla fossa la tua vita<note caller="*" style="x"><char style="xo" closed="false">103.4 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PSA 34:22">Sal. 34.22</ref>; <ref loc="PSA 56:13">56.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:4">Che ti corona di benignità e di compassioni<note caller="*" style="x"><char style="xo" closed="false">103.4 </char><char style="xk" closed="false">compassioni </char><char style="xt" closed="false"><ref loc="PSA 5:12">Sal. 5.12</ref>.</char></note>;<verse eid="PSA 103:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5"/>Che sazia di beni la tua bocca;</para>
  <para style="q" vid="PSA 103:5">Che ti fa ringiovanire come l'aquila<note caller="*" style="x"><char style="xo" closed="false">103.5 </char><char style="xk" closed="false">acquila </char><char style="xt" closed="false"><ref loc="ISA 40:31">Is. 40.31</ref>.</char></note>.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6"/>Il Signore fa giustizia</para>
  <para style="q" vid="PSA 103:6">E ragione a tutti quelli che sono oppressati.<verse eid="PSA 103:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7"/>Egli ha fatte assapere a Mosè le sue vie,</para>
  <para style="q" vid="PSA 103:7">
    <char style="add">Ed</char> a' figliuoli d'Israele le sue opere.<verse eid="PSA 103:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8"/>Il Signore <char style="add">è</char> pietoso e clemente;</para>
  <para style="q" vid="PSA 103:8">Lento all'ira, e di gran benignità<note caller="*" style="x"><char style="xo" closed="false">103.8 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="EXO 34:6">Esod. 34.6</ref>,<ref loc="EXO 34:7">7</ref> e rif. <ref loc="NUM 14:18">Num. 14.18</ref>.</char></note>.<verse eid="PSA 103:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9"/>Egli non contende in eterno<note caller="*" style="x"><char style="xo" closed="false">103.9 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 30:5">Sal. 30.5</ref>. <ref loc="ISA 57:16">Is. 57.16</ref>. <ref loc="JER 3:5">Ger. 3.5</ref>. <ref loc="MIC 7:18">Mic. 7.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:9">E non serba <char style="add">l'ira</char> in perpetuo.<verse eid="PSA 103:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10"/>Egli non ci ha fatto secondo i nostri peccati<note caller="*" style="x"><char style="xo" closed="false">103.10 </char><char style="xk" closed="false">peccati </char><char style="xt" closed="false"><ref loc="EZR 9:13">Esd. 9.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:10">E non ci ha reso la retribuzione secondo le nostre iniquità.<verse eid="PSA 103:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11"/>Perciocchè, quanto sono alti i cieli sopra la terra,</para>
  <para style="q" vid="PSA 103:11">
    <char style="add">Tanto</char> è grande la sua benignità inverso quelli che lo temono<note caller="*" style="x"><char style="xo" closed="false">103.11 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="PSA 57:10">Sal. 57.10</ref>. <ref loc="EPH 3:18">Efes. 3.18</ref>,<ref loc="EPH 3:19">19</ref>.</char></note>.<verse eid="PSA 103:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12"/>Quant'è lontano il Levante dal Ponente,</para>
  <para style="q" vid="PSA 103:12">
    <char style="add">Tanto</char> ha egli allontanati da noi i nostri misfatti<note caller="*" style="x"><char style="xo" closed="false">103.12 </char><char style="xk" closed="false">misfatti </char><char style="xt" closed="false"><ref loc="ISA 38:17">Is. 38.17</ref>; <ref loc="ISA 43:25">43.25</ref>.</char></note>.<verse eid="PSA 103:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13"/>Come un padre è pietoso inverso i figliuoli,</para>
  <para style="q" vid="PSA 103:13">
    <char style="add">Così</char> è il Signore pietoso inverso quelli che lo temono<note caller="*" style="x"><char style="xo" closed="false">103.13 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="MAL 3:17">Mal. 3.17</ref>.</char></note>.<verse eid="PSA 103:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14"/>Perciocchè egli conosce la nostra natura;</para>
  <para style="q" vid="PSA 103:14">Egli si ricorda che noi <char style="add">siamo</char> polvere<note caller="*" style="x"><char style="xo" closed="false">103.14 </char><char style="xk" closed="false">polvere </char><char style="xt" closed="false"><ref loc="GEN 3:19">Gen. 3.19</ref>. <ref loc="PSA 78:38">Sal. 78.38</ref>,<ref loc="PSA 78:39">39</ref>.</char></note>.<verse eid="PSA 103:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15"/>I giorni dell'uomo <char style="add">son</char> come l'erba<note caller="*" style="x"><char style="xo" closed="false">103.15 </char><char style="xk" closed="false">erba </char><char style="xt" closed="false"><ref loc="PSA 90:5">Sal. 90.5</ref>,<ref loc="PSA 90:6">6</ref>. <ref loc="1PE 1:24">1 Piet. 1.24</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:15">Egli fiorisce come il fiore del campo<note caller="*" style="x"><char style="xo" closed="false">103.15 </char><char style="xk" closed="false">campo </char><char style="xt" closed="false"><ref loc="JOB 14:1">Giob. 14.1</ref> ecc. <ref loc="JAS 1:10">Giac. 1.10</ref>,<ref loc="JAS 1:11">11</ref> ecc.</char></note>.<verse eid="PSA 103:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16"/>
    <char style="add">Il quale</char>, se un vento gli passa sopra, non <char style="add">è</char> più;</para>
  <para style="q" vid="PSA 103:16">E il suo luogo non lo riconosce più.<verse eid="PSA 103:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17"/>Ma la benignità del Signore <char style="add">è</char> di secolo in secolo<note caller="*" style="x"><char style="xo" closed="false">103.17 </char><char style="xk" closed="false">secolo </char><char style="xt" closed="false"><ref loc="PSA 25:6">Sal. 25.6</ref>.</char></note></para>
  <para style="q" vid="PSA 103:17">Sopra quelli che lo temono;</para>
  <para style="q" vid="PSA 103:17">E la sua giustizia sopra i figliuoli de' figliuoli<note caller="*" style="x"><char style="xo" closed="false">103.17 </char><char style="xk" closed="false">figliuoli </char><char style="xt" closed="false"><ref loc="EXO 20:6">Esod. 20.6</ref>.</char></note>,<verse eid="PSA 103:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18"/>Di quelli che osservano il suo patto<note caller="*" style="x"><char style="xo" closed="false">103.18 </char><char style="xk" closed="false">patto </char><char style="xt" closed="false"><ref loc="DEU 7:9">Deut. 7.9</ref>.</char></note>,</para>
  <para style="q" vid="PSA 103:18">E che si ricordano de' suoi comandamenti, per metterli in opera.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19"/>Il Signore ha stabilito il suo trono ne' cieli<note caller="*" style="x"><char style="xo" closed="false">103.19 </char><char style="xk" closed="false">cieli </char><char style="xt" closed="false"><ref loc="PSA 11:4">Sal. 11.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:19">E il suo regno signoreggia per tutto<note caller="*" style="x"><char style="xo" closed="false">103.19 </char><char style="xk" closed="false">tutto </char><char style="xt" closed="false"><ref loc="PSA 47:2">Sal. 47.2</ref>. <ref loc="DAN 4:25">Dan. 4.25</ref>,<ref loc="DAN 4:34">34</ref>,<ref loc="DAN 4:35">35</ref>.</char></note>.<verse eid="PSA 103:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20"/>Benedite il Signore, <char style="add">voi</char> suoi Angeli<note caller="*" style="x"><char style="xo" closed="false">103.20 </char><char style="xk" closed="false">Angeli </char><char style="xt" closed="false"><ref loc="PSA 148:2">Sal. 148.2</ref>. <ref loc="LUK 2:13">Luc. 2.13</ref>.</char></note>,</para>
  <para style="q" vid="PSA 103:20">Possenti di forza, che fate ciò ch'egli dice,</para>
  <para style="q" vid="PSA 103:20">Ubbidendo alla voce della sua parola<note caller="*" style="x"><char style="xo" closed="false">103.20 </char><char style="xk" closed="false">parola </char><char style="xt" closed="false"><ref loc="MAT 6:10">Mat. 6.10</ref>. <ref loc="HEB 1:14">Ebr. 1.14</ref>.</char></note>.<verse eid="PSA 103:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21"/>Benedite il Signore, <char style="add">voi</char> tutti gli eserciti suoi<note caller="*" style="x"><char style="xo" closed="false">103.21 </char><char style="xk" closed="false">suoi </char><char style="xt" closed="false"><ref loc="GEN 32:2">Gen. 32.2</ref>. <ref loc="JOS 5:14">Gios. 5.14</ref>. <ref loc="PSA 68:17">Sal. 68.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 103:21">
    <char style="add">Voi</char> suoi ministri<note caller="*" style="x"><char style="xo" closed="false">103.21 </char><char style="xk" closed="false">ministri </char><char style="xt" closed="false"><ref loc="PSA 104:4">Sal. 104.4</ref> e rif. <ref loc="HEB 1:14">Ebr. 1.14</ref>.</char></note>, che fate ciò che gli piace.<verse eid="PSA 103:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22"/>Benedite il Signore, <char style="add">voi</char> tutte l'opere sue,</para>
  <para style="q" vid="PSA 103:22">In tutti i luoghi della sua signoria.</para>
  <para style="q" vid="PSA 103:22">Anima mia, benedici il Signore.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">SALMO CIV</para>
  <para style="s1">La gloria di Dio manifestata nella creazione e nella conservazione di tutte le cose</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1"/>BENEDICI, anima mia, il Signore<note caller="*" style="x"><char style="xo" closed="false">104.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 103:1">Sal. 103.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 104:1">O Signore Iddio mio, tu sei sommamente grande<note caller="*" style="x"><char style="xo" closed="false">104.1 </char><char style="xk" closed="false">grande </char><char style="xt" closed="false"><ref loc="2SA 7:22">2 Sam. 7.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 104:1">Tu sei vestito di gloria e di magnificenza.<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2"/>Egli si ammanta di luce come di una vesta;</para>
  <para style="q" vid="PSA 104:2">Egli tende il cielo come una cortina<note caller="*" style="x"><char style="xo" closed="false">104.2 </char><char style="xk" closed="false">cortina </char><char style="xt" closed="false"><ref loc="GEN 1:6-8">Gen. 1.6-8</ref>. <ref loc="ISA 40:22">Is. 40.22</ref>.</char></note>.<verse eid="PSA 104:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3"/>Egli fa i palchi delle sue sale nelle acque;</para>
  <para style="q" vid="PSA 104:3">Egli pone le nuvole <char style="add">per</char> suo carro:</para>
  <para style="q" vid="PSA 104:3">Egli passeggia sopra le ale del vento.<verse eid="PSA 104:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4"/>Egli fa i venti suoi Angeli,</para>
  <para style="q" vid="PSA 104:4">E il fuoco divampante suoi ministri<note caller="*" style="x"><char style="xo" closed="false">104.4 </char><char style="xk" closed="false">ministri </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 Re. 2.11</ref>; <ref loc="2KI 6:17">6.17</ref>. <ref loc="HEB 1:7">Ebr. 1.7</ref>.</char></note>.<verse eid="PSA 104:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5"/>Egli ha fondata la terra sulle sue basi<note caller="*" style="x"><char style="xo" closed="false">104.5 </char><char style="xk" closed="false">basi </char><char style="xt" closed="false"><ref loc="JOB 26:7">Giob. 26.7</ref>. <ref loc="PSA 24:2">Sal. 24.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 104:5">Giammai in perpetuo non sarà smossa.<verse eid="PSA 104:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6"/>Tu l'avevi <char style="add">già</char> coperta dell'abisso, come d'una vesta;</para>
  <para style="q" vid="PSA 104:6">Le acque si erano fermate sopra i monti<note caller="*" style="x"><char style="xo" closed="false">104.6 </char><char style="xk" closed="false">monti </char><char style="xt" closed="false"><ref loc="GEN 7:19">Gen. 7.19</ref>.</char></note>.<verse eid="PSA 104:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7"/>Esse fuggirono per lo tuo sgridare;</para>
  <para style="q" vid="PSA 104:7">Si affrettarono per la voce del tuo tuono;<verse eid="PSA 104:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8"/>Erano salite sopra i monti; <char style="add">ma</char> discesero nelle valli<note caller="*" style="x"><char style="xo" closed="false">104.8 </char><char style="xk" closed="false">valli </char><char style="xt" closed="false"><ref loc="GEN 8:5">Gen. 8.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 104:8">Al luogo che tu hai loro costituito.<verse eid="PSA 104:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9"/>Tu hai <char style="add">loro</char> posto un termine, il qual non trapasseranno<note caller="*" style="x"><char style="xo" closed="false">104.9 </char><char style="xk" closed="false">trapasseranno </char><char style="xt" closed="false"><ref loc="JOB 26:10">Giob. 26.10</ref>; <ref loc="JOB 38:10">38.10</ref>,<ref loc="JOB 38:11">11</ref>. <ref loc="JER 5:22">Ger. 5.22</ref>.</char></note>;</para>
  <para style="q" vid="PSA 104:9">
    <char style="add">E</char> non torneranno a coprir la terra<note caller="*" style="x"><char style="xo" closed="false">104.9 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="GEN 9:11-17">Gen. 9.11-17</ref>.</char></note>.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10"/>
    <char style="add">Egli è quel</char> che manda le fonti per le valli,</para>
  <para style="q" vid="PSA 104:10">Onde <char style="add">esse</char> corrono fra i monti;<verse eid="PSA 104:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11"/>Abbeverano tutte le bestie della campagna;</para>
  <para style="q" vid="PSA 104:11">Gli asini salvatichi spengono la lor sete <char style="add">con esse</char>.<verse eid="PSA 104:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12"/>Presso a quelle si riparano gli uccelli del cielo;</para>
  <para style="q" vid="PSA 104:12">Fanno sentir di mezzo alle frondi le <char style="add">lor</char> voci.<verse eid="PSA 104:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13"/>Egli adacqua i monti dalle sue stanze sovrane<note caller="*" style="x"><char style="xo" closed="false">104.13 </char><char style="xk" closed="false">sovrane </char><char style="xt" closed="false"><ref loc="PSA 65:9">Sal. 65.9</ref>,<ref loc="PSA 65:10">10</ref>; <ref loc="PSA 147:8">147.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 104:13">La terra è saziata del frutto delle sue opere<note caller="*" style="x"><char style="xo" closed="false">104.13 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="JER 10:13">Ger. 10.13</ref>; <ref loc="JER 14:22">14.22</ref>.</char></note>.<verse eid="PSA 104:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14"/>Egli fa germogliar l'erba per le bestie<note caller="*" style="x"><char style="xo" closed="false">104.14 </char><char style="xk" closed="false">bestie </char><char style="xt" closed="false"><ref loc="GEN 1:29">Gen. 1.29</ref>,<ref loc="GEN 1:30">30</ref>.</char></note>;</para>
  <para style="q" vid="PSA 104:14">E l'erbaggio per lo servigio dell'uomo,</para>
  <para style="q" vid="PSA 104:14">Facendo uscire della terra il pane.<verse eid="PSA 104:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15"/>Egli rallegra il cuor dell'uomo col vino<note caller="*" style="x"><char style="xo" closed="false">104.15 </char><char style="xk" closed="false">vino </char><char style="xt" closed="false"><ref loc="JDG 9:13">Giud. 9.13</ref>. <ref loc="PRO 13:6">Prov. 13.6</ref>,<ref loc="PRO 13:7">7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 104:15">Egli fa risplender la faccia coll'olio,</para>
  <para style="q" vid="PSA 104:15">E sostenta il cuor dell'uomo col pane<note caller="*" style="x"><char style="xo" closed="false">104.15 </char><char style="xk" closed="false">pane </char><char style="xt" closed="false"><ref loc="ACT 14:17">Fat. 14.17</ref>.</char></note>.<verse eid="PSA 104:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16"/>Gli alberi del Signore <char style="add">ne</char> son saziati;</para>
  <para style="q" vid="PSA 104:16">I cedri del Libano ch'egli ha piantati;<verse eid="PSA 104:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17"/>Dove gli uccelli si annidano;</para>
  <para style="q" vid="PSA 104:17">Gli abeti, <char style="add">che son</char> la stanza della cicogna.<verse eid="PSA 104:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18"/>Gli alti monti <char style="add">sono</char> per li cavriuoli;</para>
  <para style="q" vid="PSA 104:18">Le rocce <char style="add">sono</char> il ricetto de' conigli.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19"/>Egli ha fatta la luna per le stagioni<note caller="*" style="x"><char style="xo" closed="false">104.19 </char><char style="xk" closed="false">stagioni </char><char style="xt" closed="false"><ref loc="GEN 1:14">Gen. 1.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 104:19">Il sole conosce il suo occaso.<verse eid="PSA 104:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20"/>Tu mandi le tenebre<note caller="*" style="x"><char style="xo" closed="false">104.20 </char><char style="xk" closed="false">tenebre </char><char style="xt" closed="false"><ref loc="ISA 45:7">Is. 45.7</ref>.</char></note>, ed e' si fa notte,</para>
  <para style="q" vid="PSA 104:20">Nella quale tutte le fiere delle selve vanno attorno.<verse eid="PSA 104:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21"/>I leoncelli rugghiano dietro alla preda,</para>
  <para style="q" vid="PSA 104:21">E per chiedere a Dio il lor pasto.<verse eid="PSA 104:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22"/>
    <char style="add">Ma, tosto ch</char>'è levato il sole, si raccolgono,</para>
  <para style="q" vid="PSA 104:22">E giacciono ne' lor ricetti.<verse eid="PSA 104:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23"/>Allora l'uomo esce alla sua opera,</para>
  <para style="q" vid="PSA 104:23">Ed al suo lavoro<note caller="*" style="x"><char style="xo" closed="false">104.23 </char><char style="xk" closed="false">lavoro </char><char style="xt" closed="false"><ref loc="GEN 3:19">Gen. 3.19</ref>.</char></note>, infino alla sera.<verse eid="PSA 104:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24"/>Quanto grandi sono, o Signore, le tue opere!</para>
  <para style="q" vid="PSA 104:24">Tu le hai tutte fatte con sapienza;</para>
  <para style="q" vid="PSA 104:24">La terra è piena de' tuoi beni.<verse eid="PSA 104:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25"/>Ecco, il mar grande ed ampio:</para>
  <para style="q" vid="PSA 104:25">Quivi son rettili senza numero,</para>
  <para style="q" vid="PSA 104:25">Amimali piccoli e grandi.<verse eid="PSA 104:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26"/>Quivi nuotano le navi,</para>
  <para style="q" vid="PSA 104:26">E il Leviatan<note caller="*" style="x"><char style="xo" closed="false">104.26 </char><char style="xk" closed="false">Leviatan </char><char style="xt" closed="false"><ref loc="JOB 41:1">Giob. 41.1</ref> </char><char style="xta" closed="false">e rif.</char></note> che tu hai formato per ischerzare in esso.<verse eid="PSA 104:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27"/>Tutti <char style="add">gli animali</char> sperano in te,</para>
  <para style="q" vid="PSA 104:27">Che tu dii loro il lor cibo al suo tempo<note caller="*" style="x"><char style="xo" closed="false">104.27 </char><char style="xk" closed="false">tempo </char><char style="xt" closed="false"><ref loc="PSA 145:15">Sal. 145.15</ref>,<ref loc="PSA 145:16">16</ref>. <ref loc="ACT 14:17">Fat. 14.17</ref>.</char></note>.<verse eid="PSA 104:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28"/>
    <char style="add">Se</char> tu <char style="add">lo</char> dài loro, <char style="add">lo</char> ricolgono;</para>
  <para style="q" vid="PSA 104:28">
    <char style="add">Se</char> tu apri la tua mano, son saziati di beni.<verse eid="PSA 104:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29"/>
    <char style="add">Se</char> tu nascondi la tua faccia, sono smarriti;</para>
  <para style="q" vid="PSA 104:29">
    <char style="add">Se</char> tu ritiri il fiato loro<note caller="*" style="x"><char style="xo" closed="false">104.29 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="GEN 2:7">Gen. 2.7</ref>. <ref loc="ACT 17:25">Fat. 17.25</ref>,<ref loc="ACT 17:28">28</ref>.</char></note>, trapassano,</para>
  <para style="q" vid="PSA 104:29">E ritornano nella lor polvere<note caller="*" style="x"><char style="xo" closed="false">104.29 </char><char style="xk" closed="false">polvere </char><char style="xt" closed="false"><ref loc="JOB 34:14">Giob. 34.14</ref>,<ref loc="JOB 34:15">15</ref>. <ref loc="ECC 12:9">Eccl. 12.9</ref>.</char></note>.<verse eid="PSA 104:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30"/>
    <char style="add">Se</char> tu rimandi il tuo spirito son creati<note caller="*" style="x"><char style="xo" closed="false">104.30 </char><char style="xk" closed="false">creati </char><char style="xt" closed="false"><ref loc="ISA 32:15">Is. 32.15</ref>. <ref loc="EZK 37:9">Ezec. 37.9</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 104:30">E tu rinnuovi la faccia della terra.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31"/>Sia la gloria del Signore in eterno;</para>
  <para style="q" vid="PSA 104:31">Rallegrisi il Signore nelle sue opere<note caller="*" style="x"><char style="xo" closed="false">104.31 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="GEN 1:31">Gen. 1.31</ref>.</char></note>;<verse eid="PSA 104:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32"/>Il quale se riguarda verso la terra, ella trema;</para>
  <para style="q" vid="PSA 104:32">Se tocca i monti, essi fumano<note caller="*" style="x"><char style="xo" closed="false">104.32 </char><char style="xk" closed="false">fumano </char><char style="xt" closed="false"><ref loc="EXO 19:18">Esod. 19.18</ref>.</char></note>.<verse eid="PSA 104:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33"/>Io canterò al Signore, mentre viverò;</para>
  <para style="q" vid="PSA 104:33">Io salmeggerò all'Iddio mio, tanto che io durerò.<verse eid="PSA 104:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34"/>Il mio ragionamento gli sarà piacevole,</para>
  <para style="q" vid="PSA 104:34">Io mi rallegrerò nel Signore.<verse eid="PSA 104:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35"/>Vengano meno i peccatori d'in su la terra,</para>
  <para style="q" vid="PSA 104:35">E gli empi non sieno più.</para>
  <para style="q" vid="PSA 104:35">Anima mia, benedici il Signore.</para>
  <para style="q" vid="PSA 104:35">Alleluia.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">SALMO CV</para>
  <para style="s1">Dio lodato per aver mantenuto il suo patto coi patriarchi, per aver liberato Israele dall'Egitto, e per averlo condotto attraverso il deserto, fino in Canaan</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1"/>CELEBRATE il Signore; predicate il suo Nome;</para>
  <para style="q" vid="PSA 105:1">Fate assapere i suoi fatti fra i popoli<note caller="*" style="x"><char style="xo" closed="false">105.1 </char><char style="xk" closed="false">popoli </char><char style="xt" closed="false"><ref loc="1CH 16:7">1 Cron. 16.7</ref> ecc.</char></note>.<verse eid="PSA 105:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2"/>Cantategli, salmeggiategli,</para>
  <para style="q" vid="PSA 105:2">Ragionate di tutte le sue maraviglie.<verse eid="PSA 105:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3"/>Gloriatevi nel Nome della sua santità;</para>
  <para style="q" vid="PSA 105:3">Rallegrisi il cuor di coloro che cercano il Signore.<verse eid="PSA 105:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4"/>Cercate il Signore, e la sua forza;</para>
  <para style="q" vid="PSA 105:4">Cercate del continuo la sua faccia<note caller="*" style="x"><char style="xo" closed="false">105.4 </char><char style="xk" closed="false">faccia </char><char style="xt" closed="false"><ref loc="PSA 27:8">Sal. 27.8</ref>.</char></note>.<verse eid="PSA 105:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5"/>Ricordate le sue maraviglie ch'egli ha fatte;</para>
  <para style="q" vid="PSA 105:5">I suoi miracoli e i giudicii della sua bocca;<verse eid="PSA 105:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6"/>
    <char style="add">O voi</char>, progenie d'Abrahamo, suo servitore;</para>
  <para style="q" vid="PSA 105:6">Figliuoli di Giacobbe, suoi eletti.<verse eid="PSA 105:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7"/>Egli <char style="add">è</char> il Signore Iddio nostro;</para>
  <para style="q" vid="PSA 105:7">I suoi giudicii <char style="add">son</char> per tutta la terra.<verse eid="PSA 105:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8"/>Egli si ricorda in eterno del suo patto<note caller="*" style="x"><char style="xo" closed="false">105.8 </char><char style="xk" closed="false">patto </char><char style="xt" closed="false"><ref loc="LUK 1:72">Luc. 1.72</ref>.</char></note>,</para>
  <para style="q" vid="PSA 105:8">
    <char style="add">E</char> in mille generazioni della parola <char style="add">ch</char>'egli ha comandata;<verse eid="PSA 105:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9"/>
    <char style="add">Del suo patto</char>, ch'egli fece con Abrahamo<note caller="*" style="x"><char style="xo" closed="false">105.9 </char><char style="xk" closed="false">Abrahamo </char><char style="xt" closed="false"><ref loc="GEN 22:16">Gen. 22.16</ref>,<ref loc="GEN 22:17">17</ref>. <ref loc="HEB 6:17">Ebr. 6.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 105:9">E del suo giuramento, <char style="add">ch'egli fece</char> ad Isacco;<verse eid="PSA 105:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10"/>Il quale egli confermò a Giacobbe per istatuto,</para>
  <para style="q" vid="PSA 105:10">
    <char style="add">E</char> ad Israele <char style="add">per</char> patto eterno;<verse eid="PSA 105:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11"/>Dicendo: Io ti darò il paese di Canaan<note caller="*" style="x"><char style="xo" closed="false">105.11 </char><char style="xk" closed="false">Canaan </char><char style="xt" closed="false"><ref loc="GEN 13:15">Gen. 13.15</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 105:11">
    <char style="add">Per</char> sorte della vostra eredità.<verse eid="PSA 105:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12"/>Quantunque fosser ben poca gente,</para>
  <para style="q" vid="PSA 105:12">E forestieri in esso<note caller="*" style="x"><char style="xo" closed="false">105.12 </char><char style="xk" closed="false">esso </char><char style="xt" closed="false"><ref loc="DEU 7:7">Deut. 7.7</ref>; <ref loc="DEU 26:5">26.5</ref>. <ref loc="HEB 11:9">Ebr. 11.9</ref>.</char></note>.<verse eid="PSA 105:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13"/>E <char style="add">mentre</char> essi andavano da una gente ad un'<char style="add">altra</char>,</para>
  <para style="q" vid="PSA 105:13">Da un regno ad un altro popolo,<verse eid="PSA 105:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14"/>Egli non permise che alcuno li oppressasse<note caller="*" style="x"><char style="xo" closed="false">105.14 </char><char style="xk" closed="false">oppressasse </char><char style="xt" closed="false"><ref loc="GEN 35:5">Gen. 35.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 105:14">Anzi gastigò eziandio dei re per amor loro<note caller="*" style="x"><char style="xo" closed="false">105.14 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="GEN 12:17">Gen. 12.17</ref>; <ref loc="GEN 20:3">20.3</ref>,<ref loc="GEN 20:7">7</ref>.</char></note>,<verse eid="PSA 105:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15"/>
    <char style="add">E disse</char>: Non toccate i miei unti,</para>
  <para style="q" vid="PSA 105:15">E non fate alcun male a' miei profeti.<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16"/>Poi egli chiamò la fame sopra la terra<note caller="*" style="x"><char style="xo" closed="false">105.16 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="GEN 41:54">Gen. 41.54</ref>.</char></note>;</para>
  <para style="q" vid="PSA 105:16">
    <char style="add">E</char> ruppe tutto il sostegno del pane.<verse eid="PSA 105:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17"/>Egli aveva mandato dinanzi a loro un uomo,</para>
  <para style="q" vid="PSA 105:17">
    <char style="add">Cioè</char> Giuseppe<note caller="*" style="x"><char style="xo" closed="false">105.17 </char><char style="xk" closed="false">Giuseppe </char><char style="xt" closed="false"><ref loc="GEN 45:5">Gen. 45.5</ref>; <ref loc="GEN 50:20">50.20</ref>.</char></note>, <char style="add">che</char> fu venduto per servo<note caller="*" style="x"><char style="xo" closed="false">105.17 </char><char style="xk" closed="false">servo </char><char style="xt" closed="false"><ref loc="GEN 37:28">Gen. 37.28</ref>,<ref loc="GEN 37:36">36</ref>.</char></note>;<verse eid="PSA 105:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18"/>I cui piedi furono serrati ne' ceppi;</para>
  <para style="q" vid="PSA 105:18">La cui persona fu messa ne' ferri<note caller="*" style="x"><char style="xo" closed="false">105.18 </char><char style="xk" closed="false">ferri </char><char style="xt" closed="false"><ref loc="GEN 39:20">Gen. 39.20</ref>.</char></note>.<verse eid="PSA 105:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19"/>La parola del Signore lo tenne al cimento,</para>
  <para style="q" vid="PSA 105:19">Fino al tempo che venne ciò ch'egli aveva detto.<verse eid="PSA 105:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20"/>Allora il re mandò a farlo sciorre<note caller="*" style="x"><char style="xo" closed="false">105.20 </char><char style="xk" closed="false">sciorre </char><char style="xt" closed="false"><ref loc="GEN 41:14">Gen. 41.14</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 105:20">Il dominator di popoli <char style="add">mandò</char> a largheggiarlo.<verse eid="PSA 105:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21"/>Egli lo costituì padrone sopra la sua casa,</para>
  <para style="q" vid="PSA 105:21">E rettore sopra tutto il suo stato<note caller="*" style="x"><char style="xo" closed="false">105.21 </char><char style="xk" closed="false">stato </char><char style="xt" closed="false"><ref loc="GEN 41:40">Gen. 41.40</ref> ecc.</char></note>;<verse eid="PSA 105:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22"/>Per tenere a freno i suoi principi a suo senno;</para>
  <para style="q" vid="PSA 105:22">E per dare ammaestramento a' suoi anziani.<verse eid="PSA 105:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23"/>Poi Israele entrò in Egitto<note caller="*" style="x"><char style="xo" closed="false">105.23 </char><char style="xk" closed="false">Egitto </char><char style="xt" closed="false"><ref loc="GEN 46:6">Gen. 46.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 105:23">E Giacobbe dimorò come forestiere nel paese di Cam.<verse eid="PSA 105:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24"/>E <char style="add">Iddio</char> fece grandemente moltiplicare il suo popolo;</para>
  <para style="q" vid="PSA 105:24">E lo rendè più possente che i suoi nemici<note caller="*" style="x"><char style="xo" closed="false">105.24 </char><char style="xk" closed="false">nemici </char><char style="xt" closed="false"><ref loc="EXO 1:7">Esod. 1.7</ref>.</char></note>.<verse eid="PSA 105:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25"/>Egli rivolse il cuor loro a odiare il suo popolo,</para>
  <para style="q" vid="PSA 105:25">A macchinar frode contro a' suoi servitori.<verse eid="PSA 105:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26"/>Egli mandò Mosè, suo servitore;</para>
  <para style="q" vid="PSA 105:26">Ed Aaronne, il quale egli aveva eletto<note caller="*" style="x"><char style="xo" closed="false">105.26 </char><char style="xk" closed="false">eletto </char><char style="xt" closed="false"><ref loc="EXO 3:10">Esod. 3.10</ref>; <ref loc="EXO 4:12">4.12</ref> ecc.</char></note>.<verse eid="PSA 105:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27"/>Essi eseguirono fra loro i miracoli ch'egli aveva <char style="add">loro</char> detti,</para>
  <para style="q" vid="PSA 105:27">E i suoi prodigi nella terra di Cam<note caller="*" style="x"><char style="xo" closed="false">105.27 </char><char style="xk" closed="false">Cam </char><char style="xt" closed="false">Esod. cap. 7—12. <ref loc="PSA 78:43">Sal. 78.43</ref> ecc.</char></note>.<verse eid="PSA 105:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28"/>Egli mandò le tenebre, e fece oscurar <char style="add">l'aria</char>;</para>
  <para style="q" vid="PSA 105:28">Ed essi non furono ribelli alle sue parole.<verse eid="PSA 105:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29"/>Egli cangiò le acque loro in sangue,</para>
  <para style="q" vid="PSA 105:29">E fece morire il lor pesce.<verse eid="PSA 105:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30"/>La terra loro produsse rane,</para>
  <para style="q" vid="PSA 105:30">
    <char style="add">Ch'entrarono fin</char> nelle camere de' loro re.<verse eid="PSA 105:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31"/>Alla sua parola venne una mischia d'insetti,</para>
  <para style="q" vid="PSA 105:31">
    <char style="add">E</char> pidocchi in tutte le lor contrade.<verse eid="PSA 105:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32"/>Egli mutò le lor pioggie in gragnuola,</para>
  <para style="q" vid="PSA 105:32">E in fuoco divampante nel lor paese;<verse eid="PSA 105:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33"/>E percosse le lor vigne, e i lor fichi;</para>
  <para style="q" vid="PSA 105:33">E fracassò gli alberi della lor contrada.<verse eid="PSA 105:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34"/>Alla sua parola vennero locuste,</para>
  <para style="q" vid="PSA 105:34">E bruchi senza numero;<verse eid="PSA 105:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35"/>Che rosero tutta l'erba nel lor paese,</para>
  <para style="q" vid="PSA 105:35">E mangiarono il frutto della lor terra.<verse eid="PSA 105:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36"/>Poi egli percosse ogni primogenito nel lor paese<note caller="*" style="x"><char style="xo" closed="false">105.36 </char><char style="xk" closed="false">paese </char><char style="xt" closed="false"><ref loc="EXO 12:29">Esod. 12.29</ref>.</char></note>,</para>
  <para style="q" vid="PSA 105:36">Le primizie d'ogni lor forza.<verse eid="PSA 105:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37"/>E condusse fuori Israele con oro e con argento<note caller="*" style="x"><char style="xo" closed="false">105.37 </char><char style="xk" closed="false">argento </char><char style="xt" closed="false"><ref loc="EXO 12:35">Esod. 12.35</ref>,<ref loc="EXO 12:36">36</ref>.</char></note>;</para>
  <para style="q" vid="PSA 105:37">E non vi fu alcuno, fra le sue tribù, <char style="add">che fosse</char> fiacco.<verse eid="PSA 105:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38"/>Gli Egizi si rallegrarono della lor partita;</para>
  <para style="q" vid="PSA 105:38">Perciocchè lo spavento di essi era caduto sopra loro<note caller="*" style="x"><char style="xo" closed="false">105.38 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="EXO 12:33">Esod. 12.33</ref>.</char></note>.<verse eid="PSA 105:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39"/>Egli distese la nuvola, per coverta;</para>
  <para style="q" vid="PSA 105:39">Ed <char style="add">accese</char> un fuoco, per alluminar<char style="add">li</char> di notte<note caller="*" style="x"><char style="xo" closed="false">105.39 </char><char style="xk" closed="false">notte </char><char style="xt" closed="false"><ref loc="EXO 13:21">Esod. 13.21</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 105:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40"/>Alla lor richiesta egli addusse delle quaglie,</para>
  <para style="q" vid="PSA 105:40">E li saziò del pane del cielo<note caller="*" style="x"><char style="xo" closed="false">105.40 </char><char style="xk" closed="false">cielo </char><char style="xt" closed="false"><ref loc="EXO 16:12">Esod. 16.12</ref> ecc.</char></note>.<verse eid="PSA 105:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41"/>Egli aperse la roccia, e <char style="add">ne</char> colarono acque<note caller="*" style="x"><char style="xo" closed="false">105.41 </char><char style="xk" closed="false">acque </char><char style="xt" closed="false"><ref loc="EXO 17:6">Esod. 17.6</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 105:41">Rivi corsero per i luoghi aridi.<verse eid="PSA 105:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42"/>Perciocchè egli si ricordò della parola della sua santità,</para>
  <para style="q" vid="PSA 105:42">
    <char style="add">Detta</char> ad Abrahamo, suo servitore<note caller="*" style="x"><char style="xo" closed="false">105.42 </char><char style="xk" closed="false">servitore </char><char style="xt" closed="false"><ref loc="GEN 15:14">Gen. 15.14</ref>.</char></note>;<verse eid="PSA 105:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43"/>E trasse fuori il suo popolo con allegrezza,</para>
  <para style="q" vid="PSA 105:43">E i suoi eletti con giubilo;<verse eid="PSA 105:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44"/>E diede loro i paesi delle genti;</para>
  <para style="q" vid="PSA 105:44">Ed essi possedettero le fatiche de' popoli<note caller="*" style="x"><char style="xo" closed="false">105.44 </char><char style="xk" closed="false">popoli </char><char style="xt" closed="false"><ref loc="DEU 6:10">Deut. 6.10</ref>,<ref loc="DEU 6:11">11</ref>. <ref loc="JOS 13:7">Gios. 13.7</ref> ecc.</char></note>;<verse eid="PSA 105:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45"/>Acciocchè osservassero i suoi statuti,</para>
  <para style="q" vid="PSA 105:45">E guardassero le sue leggi<note caller="*" style="x"><char style="xo" closed="false">105.45 </char><char style="xk" closed="false">leggi </char><char style="xt" closed="false"><ref loc="DEU 4:1">Deut. 4.1</ref>,<ref loc="DEU 4:40">40</ref>; <ref loc="DEU 6:21-25">6.21-25</ref>.</char></note>.</para>
  <para style="q" vid="PSA 105:45">Alleluia.<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">SALMO CVI</para>
  <para style="s1">Dio lodato per aver sopportato il suo popolo, ad onta delle molteplici ribellioni di lui</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 106:1">Celebrate il Signore; perciocchè <char style="add">egli è</char> buono<note caller="*" style="x"><char style="xo" closed="false">106.1 </char><char style="xk" closed="false">buono </char><char style="xt" closed="false"><ref loc="MAT 19:17">Mat. 19.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 106:1">Perciocchè la sua benignità <char style="add">è</char> in eterno<note caller="*" style="x"><char style="xo" closed="false">106.1 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Cron. 16.34</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 106:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2"/>Chi potrà raccontar le potenze del Signore<note caller="*" style="x"><char style="xo" closed="false">106.2 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 40:5">Sal. 40.5</ref>.</char></note>?</para>
  <para style="q" vid="PSA 106:2">
    <char style="add">Chi</char> potrà pubblicar tutta la sua lode?<verse eid="PSA 106:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3"/>Beati coloro che osservano la dirittura,</para>
  <para style="q" vid="PSA 106:3">Che fanno ciò ch'è giusto in ogni tempo<note caller="*" style="x"><char style="xo" closed="false">106.3 </char><char style="xk" closed="false">tempo </char><char style="xt" closed="false"><ref loc="ACT 24:16">Fat. 24.16</ref>. <ref loc="GAL 6:9">Gal. 6.9</ref>.</char></note>.<verse eid="PSA 106:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4"/>Ricordati di me, o Signore,</para>
  <para style="q" vid="PSA 106:4">Secondo la <char style="add">tua</char> benevolenza verso il tuo popolo;</para>
  <para style="q" vid="PSA 106:4">Visitami colla tua salute;<verse eid="PSA 106:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5"/>Acciocchè io vegga il bene de' tuoi eletti,</para>
  <para style="q" vid="PSA 106:5">
    <char style="add">E</char> mi rallegri dell'allegrezza della tua gente,</para>
  <para style="q" vid="PSA 106:5">
    <char style="add">E</char> mi glorii colla tua eredità.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6"/>Noi, e i nostri padri, abbiam peccato,</para>
  <para style="q" vid="PSA 106:6">Abbiamo operato iniquamente ed empiamente<note caller="*" style="x"><char style="xo" closed="false">106.6 </char><char style="xk" closed="false">empiamente </char><char style="xt" closed="false"><ref loc="LEV 26:40">Lev. 26.40</ref>. <ref loc="DAN 9:5">Dan. 9.5</ref>,<ref loc="DAN 9:6">6</ref>.</char></note>.<verse eid="PSA 106:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7"/>I nostri padri in Egitto non considerarono le tue maraviglie,</para>
  <para style="q" vid="PSA 106:7">Non si ricordarono della grandezza delle tue benignità;</para>
  <para style="q" vid="PSA 106:7">E si ribellarono presso al mare, nel Mar rosso<note caller="*" style="x"><char style="xo" closed="false">106.7 </char><char style="xk" closed="false">rosso </char><char style="xt" closed="false"><ref loc="EXO 14:11">Esod. 14.11</ref> ecc.</char></note>.<verse eid="PSA 106:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8"/>Ma pure <char style="add">il Signore</char> li salvò per l'amor del suo Nome<note caller="*" style="x"><char style="xo" closed="false">106.8 </char><char style="xk" closed="false">Nome </char><char style="xt" closed="false"><ref loc="EZK 20:14">Ezec. 20.14</ref>.</char></note>,</para>
  <para style="q" vid="PSA 106:8">Per far nota la sua potenza<note caller="*" style="x"><char style="xo" closed="false">106.8 </char><char style="xk" closed="false">potenza </char><char style="xt" closed="false"><ref loc="EXO 9:16">Esod. 9.16</ref>.</char></note>;<verse eid="PSA 106:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9"/>E sgridò il Mar rosso, ed esso si seccò;</para>
  <para style="q" vid="PSA 106:9">E li fece camminar per gli abissi, come <char style="add">per</char> un deserto<note caller="*" style="x"><char style="xo" closed="false">106.9 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="EXO 14:21">Esod. 14.21</ref>,<ref loc="EXO 14:22">22</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 106:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10"/>E li salvò di man di coloro che li odiavano,</para>
  <para style="q" vid="PSA 106:10">E li riscosse di man del nemico.<verse eid="PSA 106:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11"/>E le acque copersero i lor nemici;</para>
  <para style="q" vid="PSA 106:11">E non ne scampò pure uno<verse eid="PSA 106:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12"/>Allora credettero alle sue parole;</para>
  <para style="q" vid="PSA 106:12">Cantarono la sua lode<note caller="*" style="x"><char style="xo" closed="false">106.12 </char><char style="xk" closed="false">lode </char><char style="xt" closed="false"><ref loc="EXO 14:31">Esod. 14.31</ref>; <ref loc="EXO 15:1">15.1</ref> ecc.</char></note>.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13"/>
    <char style="add">Ma</char> presto dimenticarono le sue opere<note caller="*" style="x"><char style="xo" closed="false">106.13 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="EXO 15:24">Esod. 15.24</ref>; <ref loc="EXO 16:2">16.2</ref>; <ref loc="EXO 17:2">17.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 106:13">Non aspettarono il suo consiglio;<verse eid="PSA 106:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14"/>E si accessero di cupidigia nel deserto<note caller="*" style="x"><char style="xo" closed="false">106.14 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="NUM 11:4">Num. 11.4</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 106:14">E tentarono Iddio nella solitudine.<verse eid="PSA 106:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15"/>Ed egli diede loro ciò che chiedevano<note caller="*" style="x"><char style="xo" closed="false">106.15 </char><char style="xk" closed="false">chiedevano </char><char style="xt" closed="false"><ref loc="NUM 11:31">Num. 11.31</ref>. <ref loc="PSA 78:29">Sal. 78.29</ref>.</char></note>;</para>
  <para style="q" vid="PSA 106:15">Ma mandò la magrezza nelle lor persone.<verse eid="PSA 106:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16"/>Oltre a ciò furono mossi d'invidia contro a Mosè<note caller="*" style="x"><char style="xo" closed="false">106.16 </char><char style="xk" closed="false">Mosè </char><char style="xt" closed="false"><ref loc="NUM 16:1">Num. 16.1</ref> ecc.</char></note>, nel campo;</para>
  <para style="q" vid="PSA 106:16">
    <char style="add">E</char> contro ad Aaronne, il Santo del Signore.<verse eid="PSA 106:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17"/>La terra si aperse, e tranghiottì Datan,</para>
  <para style="q" vid="PSA 106:17">E coperse il seguito di Abiram<note caller="*" style="x"><char style="xo" closed="false">106.17 </char><char style="xk" closed="false">Abiram </char><char style="xt" closed="false"><ref loc="NUM 16:31">Num. 16.31</ref> ecc.</char></note>.<verse eid="PSA 106:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18"/>E il fuoco arse la lor raunanza;</para>
  <para style="q" vid="PSA 106:18">La fiamma divampò gli empi.<verse eid="PSA 106:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19"/>Fecero un vitello in Horeb,</para>
  <para style="q" vid="PSA 106:19">E adorarono una statua di getto<note caller="*" style="x"><char style="xo" closed="false">106.19 </char><char style="xk" closed="false">getto </char><char style="xt" closed="false"><ref loc="EXO 32:1">Esod. 32.1</ref> ecc.</char></note>;<verse eid="PSA 106:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20"/>E mutarono la lor gloria</para>
  <para style="q" vid="PSA 106:20">In una somiglianza di bue che mangia l'erba<note caller="*" style="x"><char style="xo" closed="false">106.20 </char><char style="xk" closed="false">erba </char><char style="xt" closed="false"><ref loc="JER 2:11">Ger. 2.11</ref>. <ref loc="ROM 1:23">Rom. 1.23</ref>.</char></note>.<verse eid="PSA 106:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21"/>Dimenticarono Iddio, lor Salvatore,</para>
  <para style="q" vid="PSA 106:21">Il quale aveva fatte cose grandi in Egitto;<verse eid="PSA 106:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22"/>Cose maravigliose nel paese di Cam,</para>
  <para style="q" vid="PSA 106:22">Tremende al Mar rosso.<verse eid="PSA 106:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23"/>Onde egli disse di sterminarli;</para>
  <para style="q" vid="PSA 106:23">Se non che Mosè, suo eletto, si presentò alla rottura davanti a lui<note caller="*" style="x"><char style="xo" closed="false">106.23 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="EXO 32:9-14">Esod. 32.9-14</ref>,<ref loc="EXO 32:30-35">30-35</ref>.</char></note>,</para>
  <para style="q" vid="PSA 106:23">Per istornar l'ira sua che non distruggesse.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24"/>Disdegnarono ancora il paese desiderabile<note caller="*" style="x"><char style="xo" closed="false">106.24 </char><char style="xk" closed="false">desiderabile </char><char style="xt" closed="false"><ref loc="DEU 8:7">Deut. 8.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 106:24">Non credettero alla sua parola<note caller="*" style="x"><char style="xo" closed="false">106.24 </char><char style="xk" closed="false">parola </char><char style="xt" closed="false"><ref loc="DEU 9:23">Deut. 9.23</ref>. <ref loc="HEB 3:18">Ebr. 3.18</ref>.</char></note>.<verse eid="PSA 106:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25"/>E mormorarono ne' lor tabernacoli<note caller="*" style="x"><char style="xo" closed="false">106.25 </char><char style="xk" closed="false">tabernacoli </char><char style="xt" closed="false"><ref loc="NUM 14:2">Num. 14.2</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 106:25">Non attesero alla voce del Signore.<verse eid="PSA 106:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26"/>Onde egli alzò loro la mano,</para>
  <para style="q" vid="PSA 106:26">Che li farebbe cader nel deserto<note caller="*" style="x"><char style="xo" closed="false">106.26 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="NUM 14:28">Num. 14.28</ref> ecc. <ref loc="HEB 3:11">Ebr. 3.11</ref>.</char></note>;<verse eid="PSA 106:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27"/>E che farebbe cader la lor progenie fra le genti,</para>
  <para style="q" vid="PSA 106:27">E che li dispergerebbe per li paesi<note caller="*" style="x"><char style="xo" closed="false">106.27 </char><char style="xk" closed="false">paesi </char><char style="xt" closed="false"><ref loc="LEV 26:33">Lev. 26.33</ref>.</char></note>.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28"/>Oltre a ciò si congiunsero con Baal-peor<note caller="*" style="x"><char style="xo" closed="false">106.28 </char><char style="xk" closed="false">Baal-peor </char><char style="xt" closed="false"><ref loc="NUM 25:1-3">Num. 25.1-3</ref>; <ref loc="NUM 31:16">31.16</ref>. <ref loc="REV 2:14">Apoc. 2.14</ref>.</char></note>,</para>
  <para style="q" vid="PSA 106:28">E mangiarono de' sacrificii de' morti;<verse eid="PSA 106:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29"/>E dispettarono <char style="add">Iddio</char> co' lor fatti,</para>
  <para style="q" vid="PSA 106:29">Onde la piaga si avventò a loro.<verse eid="PSA 106:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30"/>Ma Finees si feve avanti<note caller="*" style="x"><char style="xo" closed="false">106.30 </char><char style="xk" closed="false">avanti </char><char style="xt" closed="false"><ref loc="NUM 25:7">Num. 25.7</ref> ecc.</char></note>, e fece giudicio;</para>
  <para style="q" vid="PSA 106:30">E la piaga fu arrestata.<verse eid="PSA 106:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31"/>E ciò gli fu reputato per giustizia<note caller="*" style="x"><char style="xo" closed="false">106.31 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="NUM 25:11">Num. 25.11</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 106:31">Per ogni età, in perpetuo.<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32"/>Provocarono ancora <char style="add">il Signore</char> ad ira presso alla acque di Meriba,</para>
  <para style="q" vid="PSA 106:32">Ed avvenne del male a Mosè per loro<note caller="*" style="x"><char style="xo" closed="false">106.32 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="NUM 20:3">Num. 20.3</ref> ecc. <ref loc="DEU 3:26">Deut. 3.26</ref>.</char></note>.<verse eid="PSA 106:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33"/>Perciocchè inasprirono il suo spirito;</para>
  <para style="q" vid="PSA 106:33">Onde egli parlò disavvedutamente colle sue labbra<note caller="*" style="x"><char style="xo" closed="false">106.33 </char><char style="xk" closed="false">labbra </char><char style="xt" closed="false"><ref loc="NUM 20:10">Num. 20.10</ref>.</char></note>.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34"/>Essi non distrussero i popoli,</para>
  <para style="q" vid="PSA 106:34">Che il Signore aveva lor detto<note caller="*" style="x"><char style="xo" closed="false">106.34 </char><char style="xk" closed="false">detto </char><char style="xt" closed="false"><ref loc="DEU 7:2">Deut. 7.2</ref>,<ref loc="DEU 7:16">16</ref>. <ref loc="JDG 1:21-34">Giud. 1.21-34</ref>.</char></note>;<verse eid="PSA 106:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35"/>Anzi si mescolarono fra le genti,</para>
  <para style="q" vid="PSA 106:35">Ed impararono le loro opere<note caller="*" style="x"><char style="xo" closed="false">106.35 </char><char style="xk" closed="false">opere </char><char style="xt" closed="false"><ref loc="JDG 3:5">Giud. 3.5</ref>,<ref loc="JDG 3:6">6</ref>. <ref loc="1CO 5:6">1 Cor. 5.6</ref>.</char></note>;<verse eid="PSA 106:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36"/>E servirono a' loro idoli<note caller="*" style="x"><char style="xo" closed="false">106.36 </char><char style="xk" closed="false">idoli </char><char style="xt" closed="false"><ref loc="JDG 2:12">Giud. 2.12</ref>,<ref loc="JDG 2:13">13</ref>; <ref loc="JDG 3:6">3.6</ref>,<ref loc="JDG 3:7">7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 106:36">E quelli furono loro per laccio<note caller="*" style="x"><char style="xo" closed="false">106.36 </char><char style="xk" closed="false">laccio </char><char style="xt" closed="false"><ref loc="EXO 23:33">Esod. 23.33</ref>. <ref loc="DEU 7:16">Deut. 7.16</ref>.</char></note>;<verse eid="PSA 106:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37"/>E sacrificarono i lor figluoli<note caller="*" style="x"><char style="xo" closed="false">106.37 </char><char style="xk" closed="false">figliuoli </char><char style="xt" closed="false"><ref loc="2KI 16:3">2 Re. 16.3</ref> </char><char style="xta" closed="false">e rif.</char></note>.</para>
  <para style="q" vid="PSA 106:37">E le lor figliuole a' demoni<note caller="*" style="x"><char style="xo" closed="false">106.37 </char><char style="xk" closed="false">demoni </char><char style="xt" closed="false"><ref loc="2CH 11:15">2 Cron. 11.15</ref>. <ref loc="1CO 10:20">1 Cor. 10.20</ref>.</char></note>;<verse eid="PSA 106:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38"/>E sparsero il sangue innocente,</para>
  <para style="q" vid="PSA 106:38">Il sangue de' lor figliuoli e delle lor figliuole,</para>
  <para style="q" vid="PSA 106:38">I quali sacrificarono agl'idoli di Canaan;</para>
  <para style="q" vid="PSA 106:38">E il paese fu contaminato di sangue.<verse eid="PSA 106:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39"/>Ed essi si contaminarono per le loro opere,</para>
  <para style="q" vid="PSA 106:39">E fornicarono per li lor fatti.<verse eid="PSA 106:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40"/>Onde l'ira del Signore si accese contro al suo popolo,</para>
  <para style="q" vid="PSA 106:40">Ed egli abbominò la sua eredità<note caller="*" style="x"><char style="xo" closed="false">106.40 </char><char style="xk" closed="false">eredità </char><char style="xt" closed="false"><ref loc="DEU 9:29">Deut. 9.29</ref>.</char></note>;<verse eid="PSA 106:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41"/>E li diede in man delle genti<note caller="*" style="x"><char style="xo" closed="false">106.41 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="JDG 2:14">Giud. 2.14</ref>. <ref loc="NEH 9:27">Neem. 9.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 106:41">E quelli che li odiavano signoreggiarono sopra loro.<verse eid="PSA 106:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42"/>E i lor nemici li oppressarono;</para>
  <para style="q" vid="PSA 106:42">Ed essi furono abbassati sotto alla lor mano.<verse eid="PSA 106:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43"/>Egli li riscosse molte volte<note caller="*" style="x"><char style="xo" closed="false">106.43 </char><char style="xk" closed="false">volte </char><char style="xt" closed="false"><ref loc="JDG 2:16">Giud. 2.16</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 106:43">Ma essi lo dispettarono co' lor consigli,</para>
  <para style="q" vid="PSA 106:43">Onde furono abbattuti per la loro iniquità.<verse eid="PSA 106:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44"/>E pure egli ha riguardato, quando <char style="add">sono stati</char> in distretta;</para>
  <para style="q" vid="PSA 106:44">Quando ha udito il lor grido<note caller="*" style="x"><char style="xo" closed="false">106.44 </char><char style="xk" closed="false">grido </char><char style="xt" closed="false"><ref loc="JDG 3:9">Giud. 3.9</ref>; <ref loc="JDG 4:3">4.3</ref> ecc.; <ref loc="JDG 6:7">6.7</ref> ecc.; <ref loc="JDG 10:10">10.10</ref> ecc.</char></note>;<verse eid="PSA 106:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45"/>E si è ricordato inverso loro del suo patto<note caller="*" style="x"><char style="xo" closed="false">106.45 </char><char style="xk" closed="false">patto </char><char style="xt" closed="false"><ref loc="LEV 26:41">Lev. 26.41</ref>,<ref loc="LEV 26:42">42</ref>.</char></note>,</para>
  <para style="q" vid="PSA 106:45">E si è pentito<note caller="*" style="x"><char style="xo" closed="false">106.45 </char><char style="xk" closed="false">pentito </char><char style="xt" closed="false"><ref loc="JDG 2:18">Giud. 2.18</ref> </char><char style="xta" closed="false">e rif.</char></note>, secondo la grandezza delle sue benignità<note caller="*" style="x"><char style="xo" closed="false">106.45 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="PSA 51:1">Sal. 51.1</ref>. <ref loc="LAM 3:32">Lam. 3.32</ref>.</char></note>.<verse eid="PSA 106:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46"/>Ed ha renduti loro pietosi</para>
  <para style="q" vid="PSA 106:46">Tutti quelli che li avevano menati in cattività<note caller="*" style="x"><char style="xo" closed="false">106.46 </char><char style="xk" closed="false">cattività </char><char style="xt" closed="false"><ref loc="EZR 9:9">Esd. 9.9</ref>. <ref loc="JER 42:11">Ger. 42.11</ref>,<ref loc="JER 42:12">12</ref>.</char></note>.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47"/>Salvaci, o Signore Iddio nostro,</para>
  <para style="q" vid="PSA 106:47">E raccoglici d'infra le genti;</para>
  <para style="q" vid="PSA 106:47">Acciocchè celebriamo il Nome della tua santità,</para>
  <para style="q" vid="PSA 106:47">
    <char style="add">E</char> ci gloriamo nella tua lode.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48"/>Benedetto <char style="add">sia</char> il Signore Iddio d'Israele di secolo in secolo.</para>
  <para style="q" vid="PSA 106:48">Or dica tutto il popolo: Amen. Alleluia.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="cl">SALMO CVII</para>
  <para style="s1">Bontà di Dio nel proteggere i viaggiatori, i prigioni, i malati, i marinari, e in genere tutti gli uomini</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1"/>CELEBRATE il Signore<note caller="*" style="x"><char style="xo" closed="false">107.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 106:1">Sal. 106.1</ref> </char><char style="xta" closed="false">e rif.</char></note>; perciocchè <char style="add">egli è</char> buono<note caller="*" style="x"><char style="xo" closed="false">107.1 </char><char style="xk" closed="false">buono </char><char style="xt" closed="false"><ref loc="PSA 119:68">Sal. 119.68</ref>. <ref loc="MAT 19:17">Mat. 19.17</ref>.</char></note>.</para>
  <para style="q" vid="PSA 107:1">Perciocchè la sua benignità <char style="add">dura</char> in eterno.<verse eid="PSA 107:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2"/>
    <char style="add">Così</char> dicano quelli che sono stati riscattati dal Signore,</para>
  <para style="q" vid="PSA 107:2">I quali egli ha riscossi di distretta.<verse eid="PSA 107:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3"/>E li ha raccolti da' <char style="add">diversi</char> paesi<note caller="*" style="x"><char style="xo" closed="false">107.3 </char><char style="xk" closed="false">paesi </char><char style="xt" closed="false"><ref loc="ISA 43:5">Is. 43.5</ref>,<ref loc="ISA 43:6">6</ref>. <ref loc="JER 29:14">Ger. 29.14</ref>; <ref loc="JER 31:10">31.10</ref>. <ref loc="EZK 39:27">Ezec. 39.27</ref>,<ref loc="EZK 39:28">28</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:3">Dal Levante e dal Ponente; dal Settentrione e dal mare.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4"/>Essi andavano errando per deserti, per cammini di solitudine;</para>
  <para style="q" vid="PSA 107:4">Non trovavano città abitata.<verse eid="PSA 107:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5"/>
    <char style="add">Erano</char> affamati ed assetati;</para>
  <para style="q" vid="PSA 107:5">L'anima loro spasimava in loro<note caller="*" style="x"><char style="xo" closed="false">107.5 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="DEU 32:10">Deut. 32.10</ref>.</char></note>.<verse eid="PSA 107:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6"/>Ma, avendo gridato al Signore, mentre erano in distretta<note caller="*" style="x"><char style="xo" closed="false">107.6 </char><char style="xk" closed="false">distretta </char><char style="xt" closed="false"><ref loc="PSA 50:15">Sal. 50.15</ref> e rif. <ref loc="HOS 5:15">Os. 5.15</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:6">Egli li ha tratti fuor delle loro angosce;<verse eid="PSA 107:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7"/>E li ha condotti per diritto cammino,</para>
  <para style="q" vid="PSA 107:7">Per andare in città abitata.<verse eid="PSA 107:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8"/>Celebrino <char style="add">adunque</char> appo il Signore la sua benignità,</para>
  <para style="q" vid="PSA 107:8">E le sue maraviglie appo i figliuoli degli uomini.<verse eid="PSA 107:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9"/>Perciocchè egli ha saziata l'anima assetata<note caller="*" style="x"><char style="xo" closed="false">107.9 </char><char style="xk" closed="false">assetata </char><char style="xt" closed="false"><ref loc="PSA 34:10">Sal. 34.10</ref>. <ref loc="LUK 1:53">Luc. 1.53</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:9">Ed ha empiuta di beni l'anima affamata.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10"/>
    <char style="add">Così dicano</char> quelli che dimoravano in tenebre ed in ombra di morte<note caller="*" style="x"><char style="xo" closed="false">107.10 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="ISA 42:7">Is. 42.7</ref>; <ref loc="ISA 49:9">49.9</ref>. <ref loc="LUK 1:79">Luc. 1.79</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:10">Prigioni, <char style="add">ritenuti</char> in afflizione, e ne' ferri.<verse eid="PSA 107:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11"/>Perciocchè erano stati ribelli alle parole del Signore<note caller="*" style="x"><char style="xo" closed="false">107.11 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="DEU 1:26">Deut. 1.26</ref>. <ref loc="PSA 106:7">Sal. 106.7</ref>,<ref loc="PSA 106:43">43</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:11">Ed avevano sprezzato il consiglio dell'Altissimo;<verse eid="PSA 107:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12"/>Onde egli aveva abbattuto il cuor loro con affanni,</para>
  <para style="q" vid="PSA 107:12">
    <char style="add">Ed</char> erano caduti; e non <char style="add">vi era</char> alcuno che <char style="add">li</char> soccorresse.<verse eid="PSA 107:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13"/>Ma, avendo gridato al Signore, mentre erano in distretta,</para>
  <para style="q" vid="PSA 107:13">Egli li ha salvati dalle loro angosce;<verse eid="PSA 107:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14"/>
    <char style="add">E</char> li ha tratti fuor delle tenebre, e dell'ombra della morte<note caller="*" style="x"><char style="xo" closed="false">107.14 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="ACT 12:7">Fat. 12.7</ref> ecc.; <ref loc="ACT 16:26">16.26</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 107:14">Ed ha rotti i lor legami.<verse eid="PSA 107:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15"/>Celebrino <char style="add">adunque</char> appo il Signore la sua benignità,</para>
  <para style="q" vid="PSA 107:15">E le sue maraviglie appo i figliuoli degli uomini.<verse eid="PSA 107:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16"/>Perciocchè egli ha rotte le porte di rame,</para>
  <para style="q" vid="PSA 107:16">Ed ha spezzate le sbarre di ferro.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17"/>
    <char style="add">Così dicano</char> gli stolti, <char style="add">ch</char>'erano afflitti per li lor misfatti,</para>
  <para style="q" vid="PSA 107:17">Ne' quali camminavano, e per le loro iniquità.<verse eid="PSA 107:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18"/>La cui anima abbominava ogni cibo;</para>
  <para style="q" vid="PSA 107:18">Ed erano giunti fino alle porte della morte.<verse eid="PSA 107:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19"/>Ma, avendo gridato al Signore, mentre erano in distretta,</para>
  <para style="q" vid="PSA 107:19">Egli li ha salvati dalle loro angosce.<verse eid="PSA 107:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20"/>Egli ha mandata la sua parola, e li ha sanati<note caller="*" style="x"><char style="xo" closed="false">107.20 </char><char style="xk" closed="false">sanati </char><char style="xt" closed="false"><ref loc="2KI 20:4">2 Re. 20.4</ref>,<ref loc="2KI 20:5">5</ref>. <ref loc="MAT 8:8">Mat. 8.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:20">E liberati dalle lor malattie mortali<note caller="*" style="x"><char style="xo" closed="false">107.20 </char><char style="xk" closed="false">mortali </char><char style="xt" closed="false"><ref loc="PSA 103:4">Sal. 103.4</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 107:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21"/>Celebrino <char style="add">adunque</char> appo il Signore la sua benignità,</para>
  <para style="q" vid="PSA 107:21">E le sue maraviglie appo i figliuoli degli uomini.<verse eid="PSA 107:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22"/>E sacrifichino sacrificii di lode<note caller="*" style="x"><char style="xo" closed="false">107.22 </char><char style="xk" closed="false">lode </char><char style="xt" closed="false"><ref loc="LEV 7:12">Lev. 7.12</ref>. <ref loc="HEB 13:15">Ebr. 13.15</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:22">E raccontino le sue opere con giubilo<note caller="*" style="x"><char style="xo" closed="false">107.22 </char><char style="xk" closed="false">giubilo </char><char style="xt" closed="false"><ref loc="PSA 9:11">Sal. 9.11</ref>; <ref loc="PSA 73:28">73.28</ref>; <ref loc="PSA 118:17">118.17</ref>.</char></note>.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23"/>
    <char style="add">Così dicano</char> quelli che scendono nel mare sopra navi,</para>
  <para style="q" vid="PSA 107:23">Che fanno traffico su per le grandi acque.<verse eid="PSA 107:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24"/>Essi veggono le opere del Signore,</para>
  <para style="q" vid="PSA 107:24">E le sue maraviglie nel profondo <char style="add">mare</char>.<verse eid="PSA 107:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25"/>Perciocchè, alla sua parola, egli fa levare il vento di tempesta<note caller="*" style="x"><char style="xo" closed="false">107.25 </char><char style="xk" closed="false">tempesta </char><char style="xt" closed="false"><ref loc="PSA 148:8">Sal. 148.8</ref>. <ref loc="JON 1:4">Gion. 1.4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:25">Il quale alza le onde di esso.<verse eid="PSA 107:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26"/>Salgono al cielo, <char style="add">poi</char> scendono agli abissi;</para>
  <para style="q" vid="PSA 107:26">L'anima loro si strugge di male.<verse eid="PSA 107:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27"/>Saltano, e traballano come un ebbro;</para>
  <para style="q" vid="PSA 107:27">E perdono tutto il lor senno.<verse eid="PSA 107:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28"/>Ma, gridando al Signore, mentre sono in distretta,</para>
  <para style="q" vid="PSA 107:28">Egli li trae fuor delle loro angosce.<verse eid="PSA 107:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29"/>Egli acqueta la tempesta,</para>
  <para style="q" vid="PSA 107:29">E le onde loro si fermano<note caller="*" style="x"><char style="xo" closed="false">107.29 </char><char style="xk" closed="false">fermano </char><char style="xt" closed="false"><ref loc="PSA 89:9">Sal. 89.9</ref>. <ref loc="MAT 8:26">Mat. 8.26</ref>.</char></note>.<verse eid="PSA 107:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30"/>Ed essi si rallegrano che sono acquetate;</para>
  <para style="q" vid="PSA 107:30">Ed egli li conduce al porto da loro desiderato.<verse eid="PSA 107:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31"/>Celebrino <char style="add">adunque</char> appo il Signore la sua benignità,</para>
  <para style="q" vid="PSA 107:31">E le sue maraviglie appo i figliuoli degli uomini.<verse eid="PSA 107:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32"/>Ed esaltinlo nella raunanza del popolo,</para>
  <para style="q" vid="PSA 107:32">E laudinlo nel concistoro degli anziani<note caller="*" style="x"><char style="xo" closed="false">107.32 </char><char style="xk" closed="false">anziani </char><char style="xt" closed="false"><ref loc="PSA 22:22">Sal. 22.22</ref> ecc.; <ref loc="PSA 111:1">111.1</ref>.</char></note>.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33"/>Egli riduce i fiumi in deserto<note caller="*" style="x"><char style="xo" closed="false">107.33 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Re. 17.1</ref>,<ref loc="1KI 17:7">7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:33">E le vene delle acque in luoghi aridi;<verse eid="PSA 107:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34"/>La terra fertile in salsuggine,</para>
  <para style="q" vid="PSA 107:34">Per la malvagità de' suoi abitanti<note caller="*" style="x"><char style="xo" closed="false">107.34 </char><char style="xk" closed="false">abitanti </char><char style="xt" closed="false"><ref loc="GEN 13:10">Gen. 13.10</ref>; <ref loc="GEN 19:25-28">19.25-28</ref>.</char></note>.<verse eid="PSA 107:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35"/>Egli riduce i deserti in guazzi d'acque.</para>
  <para style="q" vid="PSA 107:35">E la terra arida in vene d'acque<note caller="*" style="x"><char style="xo" closed="false">107.35 </char><char style="xk" closed="false">acque </char><char style="xt" closed="false"><ref loc="PSA 118:8">Sal. 118.8</ref>. <ref loc="ISA 41:18">Is. 41.18</ref>.</char></note>;<verse eid="PSA 107:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36"/>E fa quivi abitar gli affamati,</para>
  <para style="q" vid="PSA 107:36">I quali <char style="add">vi</char> fondano città da abitare.<verse eid="PSA 107:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37"/>E seminano campi, e piantano vigne,</para>
  <para style="q" vid="PSA 107:37">Che producono rendita di frutto.<verse eid="PSA 107:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38"/>Ed egli li benedice, e moltiplicano grandemente;</para>
  <para style="q" vid="PSA 107:38">Ed egli non iscema i lor bestiami.<verse eid="PSA 107:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39"/>Poi vengono al meno, e sono abbassati</para>
  <para style="q" vid="PSA 107:39">Per distretta, <char style="add">per</char> avversità, e <char style="add">per</char> affanni.<verse eid="PSA 107:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40"/>Egli spande lo sprezzo sopra i nobili,</para>
  <para style="q" vid="PSA 107:40">E li fa andare errando per luoghi deserti, <char style="add">ove</char> non <char style="add">vi è</char> via alcuna.<verse eid="PSA 107:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41"/>E innalza il bisognoso dalla miseria<note caller="*" style="x"><char style="xo" closed="false">107.41 </char><char style="xk" closed="false">miseria </char><char style="xt" closed="false"><ref loc="1SA 2:8">1 Sam. 2.8</ref>. <ref loc="PSA 113:7">Sal. 113.7</ref>,<ref loc="PSA 113:8">8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 107:41">E fa che le famiglie <char style="add">moltiplicano</char> a guisa di gregge.<verse eid="PSA 107:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42"/>Gli <char style="add">uomini</char> diritti, veggendo <char style="add">queste cose</char>, si rallegrano;</para>
  <para style="q" vid="PSA 107:42">Ma ogni iniquità si tura la bocca.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43"/>Chi <char style="add">è</char> savio? osservi queste cose,</para>
  <para style="q" vid="PSA 107:43">E consideri le benignità del Signore.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">SALMO CVIII</para>
  <para style="s1">Davide loda Iddio per le vittorie concessegli</para>
  <para style="d">Cantico di Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1"/>IL mio cuore è disposto, o Dio<note caller="*" style="x"><char style="xo" closed="false">108.1 </char><char style="xk" closed="false">Dio </char><char style="xt" closed="false"><ref loc="PSA 57:7-11">Sal. 57.7-11</ref>.</char></note>,</para>
  <para style="q" vid="PSA 108:1">Ed anche la mia gloria; io canterò, e salmeggerò.<verse eid="PSA 108:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2"/>Saltero, e cetera, destati;</para>
  <para style="q" vid="PSA 108:2">Io mi risveglierò all'alba.<verse eid="PSA 108:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3"/>Io ti celebrerò fra i popoli, o Signore,</para>
  <para style="q" vid="PSA 108:3">E ti salmeggerò fra le nazioni.<verse eid="PSA 108:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4"/>Perciocchè la tua benignità <char style="add">è</char> grande, disopra il cielo;</para>
  <para style="q" vid="PSA 108:4">E la tua verità <char style="add">aggiunge</char> infino alle nuvole.<verse eid="PSA 108:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5"/>Innalzati, o Dio, sopra i cieli;</para>
  <para style="q" vid="PSA 108:5">Ed <char style="add">innalzisi</char> la tua gloria sopra tutta le terra;<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6"/>Acciocchè i tuoi diletti sieno liberati<note caller="*" style="x"><char style="xo" closed="false">108.6 </char><char style="xk" closed="false">liberati </char><char style="xt" closed="false"><ref loc="PSA 60:5-12">Sal. 60.5-12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 108:6">Salva<char style="add">mi col</char>la tua destra, e rispondimi.<verse eid="PSA 108:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7"/>Iddio ha parlato per la sua santità; io trionferò,</para>
  <para style="q" vid="PSA 108:7">Io spartirò Sichem, e misurerò la valle di Succot.<verse eid="PSA 108:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8"/>Mio <char style="add">è</char> Galaad, mio <char style="add">è</char> Manasse;</para>
  <para style="q" vid="PSA 108:8">Ed Efraim <char style="add">è</char> la forza del mio capo;</para>
  <para style="q" vid="PSA 108:8">Giuda <char style="add">è</char> il mio legislatore<note caller="*" style="x"><char style="xo" closed="false">108.8 </char><char style="xk" closed="false">legislatore </char><char style="xt" closed="false"><ref loc="GEN 49:10">Gen. 49.10</ref>.</char></note>;<verse eid="PSA 108:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9"/>Moab <char style="add">è</char> la caldaia del mio lavatoio;</para>
  <para style="q" vid="PSA 108:9">Io getterò le mie scarpe sopra Edom;</para>
  <para style="q" vid="PSA 108:9">Io trionferò della Palestina con voci di allegrezza.<verse eid="PSA 108:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10"/>Chi mi condurrà nella città della fortezza?</para>
  <para style="q" vid="PSA 108:10">Chi mi menerà fino in Edom?<verse eid="PSA 108:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11"/>Non <char style="add">sarai desso tu</char>, o Dio, <char style="add">che</char> ci avevi scacciati,</para>
  <para style="q" vid="PSA 108:11">E non uscivi <char style="add">più</char> fuori, o Dio, co' nostri eserciti?<verse eid="PSA 108:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12"/>Dacci aiuto, <char style="add">per uscir</char> di distretta;</para>
  <para style="q" vid="PSA 108:12">Perciocchè il soccorso degli uomini <char style="add">è</char> vanità.<verse eid="PSA 108:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13"/>Col<char style="add">l'aiuto di</char> Dio noi faremo prodezze;</para>
  <para style="q" vid="PSA 108:13">Ed egli calpesterà i nostri nemici.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">SALMO CIX</para>
  <para style="s1">Davide prega Iddio di gastigare gl'iniqui, e di liberarlo dai loro tranelli</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1"/>O DIO della mia lode, non tacere;<verse eid="PSA 109:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2"/>Perciocchè la bocca dell'empio e la bocca di frode si sono aperte contro a me;</para>
  <para style="q" vid="PSA 109:2">Hanno parlato meco con lingua bugiarda;<verse eid="PSA 109:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3"/>E mi hanno assediato con parole d'odio;</para>
  <para style="q" vid="PSA 109:3">E mi hanno fatta guerra senza cagione<note caller="*" style="x"><char style="xo" closed="false">109.3 </char><char style="xk" closed="false">cagione </char><char style="xt" closed="false"><ref loc="JHN 15:25">Giov. 15.25</ref>.</char></note>.<verse eid="PSA 109:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4"/>In vece dell'amore che ho loro portato, mi sono stati avversari<note caller="*" style="x"><char style="xo" closed="false">109.4 </char><char style="xk" closed="false">avversari </char><char style="xt" closed="false"><ref loc="PSA 38:20">Sal. 38.20</ref>.</char></note>;</para>
  <para style="q" vid="PSA 109:4">Ed io <char style="add">ho loro renduta</char> preghiera.<verse eid="PSA 109:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5"/>Essi mi hanno renduto male per bene,</para>
  <para style="q" vid="PSA 109:5">E odio per lo mio amore.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6"/>Costituisci il maligno sopra lui;</para>
  <para style="q" vid="PSA 109:6">E fa' che Satana gli stia alla destra.<verse eid="PSA 109:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7"/>Quando sarà giudicato, esca condannato;</para>
  <para style="q" vid="PSA 109:7">E la sua preghiera <char style="add">gli</char> torni in peccato<note caller="*" style="x"><char style="xo" closed="false">109.7 </char><char style="xk" closed="false">peccato </char><char style="xt" closed="false"><ref loc="PRO 28:9">Prov. 28.9</ref>.</char></note>.<verse eid="PSA 109:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8"/>Sieno i suoi giorni pochi;</para>
  <para style="q" vid="PSA 109:8">Un altro prenda il suo ufficio<note caller="*" style="x"><char style="xo" closed="false">109.8 </char><char style="xk" closed="false">ufficio </char><char style="xt" closed="false"><ref loc="ACT 1:20">Fat. 1.20</ref>.</char></note>.<verse eid="PSA 109:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9"/>Sieno i suoi figliuoli orfani,</para>
  <para style="q" vid="PSA 109:9">E la sua moglie vedova.<verse eid="PSA 109:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10"/>E vadano i suoi figliuoli del continuo vagando;</para>
  <para style="q" vid="PSA 109:10">E mendichino, ed accattino, <char style="add">uscendo fuor</char> de' lor casolari.<verse eid="PSA 109:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11"/>L'usuraio tenda la rete a tutto ciò ch'egli ha;</para>
  <para style="q" vid="PSA 109:11">E rubino gli strani le sue fatiche.<verse eid="PSA 109:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12"/>Non siavi alcuno che stenda la <char style="add">sua</char> benignità inverso lui;</para>
  <para style="q" vid="PSA 109:12">E non vi sia chi abbia pietà de' suoi orfani.<verse eid="PSA 109:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13"/>Sieno distrutti i suoi discendenti;</para>
  <para style="q" vid="PSA 109:13">Sia cancellato il lor nome nella seconda generazione<note caller="*" style="x"><char style="xo" closed="false">109.13 </char><char style="xk" closed="false">generazione </char><char style="xt" closed="false"><ref loc="PSA 37:28">Sal. 37.28</ref>. <ref loc="PRO 10:7">Prov. 10.7</ref>.</char></note>.<verse eid="PSA 109:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14"/>Sia ricordata l'iniquità de' suoi padri appo il Signore<note caller="*" style="x"><char style="xo" closed="false">109.14 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="EXO 20:5">Esod. 20.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 109:14">E il peccato di sua madre non sia cancellato.<verse eid="PSA 109:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15"/>Sieno <char style="add">que' peccati</char> del continuo nel cospetto del Signore;</para>
  <para style="q" vid="PSA 109:15">E stermini egli d'in su la terra la memoria di essi<note caller="*" style="x"><char style="xo" closed="false">109.15 </char><char style="xk" closed="false">essi </char><char style="xt" closed="false"><ref loc="JOB 18:17">Giob. 18.17</ref>.</char></note>.<verse eid="PSA 109:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16"/>Perciocchè egli non si è ricordato d'usar benignità,</para>
  <para style="q" vid="PSA 109:16">Ed ha perseguitato l'uomo povero, ed afflitto,</para>
  <para style="q" vid="PSA 109:16">E tribolato di cuore, per uccider<char style="add">lo</char><note caller="*" style="x"><char style="xo" closed="false">109.16 </char><char style="xk" closed="false">uccider<char style="add">lo</char> </char><char style="xt" closed="false"><ref loc="PSA 34:18">Sal. 34.18</ref>.</char></note>.<verse eid="PSA 109:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17"/>Poichè egli ha amata la maledizione, vengagli;</para>
  <para style="q" vid="PSA 109:17">E <char style="add">poichè</char> non si è compiaciuto nella benedizione, allontanisi ella da lui.<verse eid="PSA 109:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18"/>E sia vestito di maledizione, come del suo manto;</para>
  <para style="q" vid="PSA 109:18">Ed entri quella come acqua nelle sue interiora,</para>
  <para style="q" vid="PSA 109:18">E come olio nelle sue ossa.<verse eid="PSA 109:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19"/>Siagli quella a guisa di vestimento, <char style="add">del quale</char> egli sia avvolto;</para>
  <para style="q" vid="PSA 109:19">Ed a guisa di cintura, della quale sempre sia cinto.<verse eid="PSA 109:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20"/>
    <char style="add">Tal</char> sia, da parte del Signore, la ricompensa de' miei avversari,</para>
  <para style="q" vid="PSA 109:20">E di quelli che parlano male contro all'anima mia.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21"/>Ma tu, o Signore Iddio, opera inverso me, per amor del tuo Nome;</para>
  <para style="q" vid="PSA 109:21">Liberami, perciocchè la tua benignità <char style="add">è</char> buona.<verse eid="PSA 109:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22"/>Perciocchè io sono afflitto, e povero;</para>
  <para style="q" vid="PSA 109:22">E il mio cuore è piagato dentro di me.<verse eid="PSA 109:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23"/>Io me ne vo, come l'ombra quando dichina<note caller="*" style="x"><char style="xo" closed="false">109.23 </char><char style="xk" closed="false">dichina </char><char style="xt" closed="false"><ref loc="JOB 14:2">Giob. 14.2</ref>. <ref loc="PSA 102:11">Sal. 102.11</ref>; <ref loc="PSA 144:4">144.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 109:23">Io sono agitato come una locusta.<verse eid="PSA 109:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24"/>Le mie ginocchia vacillano per li <char style="add">miei</char> digiuni<note caller="*" style="x"><char style="xo" closed="false">109.24 </char><char style="xk" closed="false">digiuni </char><char style="xt" closed="false"><ref loc="HEB 12:12">Ebr. 12.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 109:24">E la mia carne è dimagrata, e non ha <char style="add">più</char> grassezza alcuna.<verse eid="PSA 109:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25"/>Ed anche son loro in vituperio;</para>
  <para style="q" vid="PSA 109:25">
    <char style="add">Quando</char> mi veggono, scuotono la testa<note caller="*" style="x"><char style="xo" closed="false">109.25 </char><char style="xk" closed="false">testa </char><char style="xt" closed="false"><ref loc="PSA 22:6">Sal. 22.6</ref>,<ref loc="PSA 22:7">7</ref>. <ref loc="MAT 27:39">Mat. 27.39</ref>.</char></note>.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26"/>Aiutami, Signore Iddio mio;</para>
  <para style="q" vid="PSA 109:26">Salvami secondo la tua benignità.<verse eid="PSA 109:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27"/>E sappiano che questo <char style="add">è</char> la tua mano,</para>
  <para style="q" vid="PSA 109:27">
    <char style="add">E che</char> tu, Signore, hai fatto questo.<verse eid="PSA 109:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28"/>Essi malediranno, e tu benedirai<note caller="*" style="x"><char style="xo" closed="false">109.28 </char><char style="xk" closed="false">benedirai </char><char style="xt" closed="false"><ref loc="2SA 16:11">2 Sam. 16.11</ref>,<ref loc="2SA 16:12">12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 109:28">Si sono innalzati, ma saran confusi,</para>
  <para style="q" vid="PSA 109:28">Ed il tuo servitore si rallegrerà.<verse eid="PSA 109:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29"/>Sieno i miei avversari vestiti di vituperio,</para>
  <para style="q" vid="PSA 109:29">Ed avvolti della lor vergogna, come di un mantello.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30"/>Io celebrerò altamente il Signore colla mia bocca;</para>
  <para style="q" vid="PSA 109:30">E lo loderò in mezzo de' grandi.<verse eid="PSA 109:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31"/>Perciocchè egli sta alla destra del povero,</para>
  <para style="q" vid="PSA 109:31">Per salvar<char style="add">lo</char> da quelli che lo condannano a morte.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">SALMO CX</para>
  <para style="s1">Il regno, il sacerdozio e le conquiste del Messia</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1"/>IL Signore ha detto al mio Signore;</para>
  <para style="q" vid="PSA 110:1">Siedi alla mia destra<note caller="*" style="x"><char style="xo" closed="false">110.1 </char><char style="xk" closed="false">destra </char><char style="xt" closed="false"><ref loc="MAT 22:44">Mat. 22.44</ref>. <ref loc="MRK 12:36">Mar. 12.36</ref>. <ref loc="LUK 20:42">Luc. 20.42</ref>,<ref loc="LUK 20:43">43</ref>. <ref loc="ACT 2:34">Fat. 2.34</ref>. <ref loc="EPH 1:20">Efes. 1.20</ref>. <ref loc="COL 3:1">Col. 3.1</ref>. <ref loc="HEB 1:3">Ebr. 1.3</ref>,<ref loc="HEB 1:13">13</ref>; <ref loc="HEB 8:1">8.1</ref>; <ref loc="HEB 10:12">10.12</ref>; <ref loc="HEB 12:2">12.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 110:1">Infino a tanto che io abbia posti i tuoi nemici per iscannello de' tuoi piedi<note caller="*" style="x"><char style="xo" closed="false">110.1 </char><char style="xk" closed="false">piedi </char><char style="xt" closed="false"><ref loc="1CO 15:25">1 Cor. 15.25</ref>. <ref loc="HEB 2:7">Ebr. 2.7</ref>,<ref loc="HEB 2:8">8</ref>. <ref loc="1PE 3:22">1 Piet. 3.22</ref>.</char></note>.<verse eid="PSA 110:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2"/>Il Signore manderà fuor di Sion lo scettro della tua potenza,</para>
  <para style="q" vid="PSA 110:2">
    <char style="add">Dicendo:</char> Signoreggia in mezzo de' tuoi nemici.<verse eid="PSA 110:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3"/>Il tuo popolo <char style="add">sarà</char> tutto volenteroso,</para>
  <para style="q" vid="PSA 110:3">Nel giorno <char style="add">che tu rassegnerai</char> il tuo esercito, nel magnifico santuario;</para>
  <para style="q" vid="PSA 110:3">La rugiada della tua gioventù <char style="add">ti sarà prodotta</char> dalla matrice dell'alba.<verse eid="PSA 110:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4"/>Il Signore ha giurato, e non si pentirà<note caller="*" style="x"><char style="xo" closed="false">110.4 </char><char style="xk" closed="false">pentirà </char><char style="xt" closed="false"><ref loc="NUM 23:19">Num. 23.19</ref>.</char></note>:</para>
  <para style="q" vid="PSA 110:4">Tu <char style="add">sei</char> sacerdote in eterno,</para>
  <para style="q" vid="PSA 110:4">Secondo l'ordine di Melchisedec<note caller="*" style="x"><char style="xo" closed="false">110.4 </char><char style="xk" closed="false">Melchisedec </char><char style="xt" closed="false"><ref loc="GEN 14:18">Gen. 14.18</ref> ecc. <ref loc="HEB 5:6">Ebr. 5.6</ref>; <ref loc="HEB 6:20">6.20</ref>; <ref loc="HEB 7:15">7.15</ref> ecc.</char></note>.<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5"/>Il Signore <char style="add">sarà</char> alla tua destra.</para>
  <para style="q" vid="PSA 110:5">
    <char style="add">Questo mio Signore</char> trafiggerà i re nel giorno della sua ira<note caller="*" style="x"><char style="xo" closed="false">110.5 </char><char style="xk" closed="false">ira </char><char style="xt" closed="false"><ref loc="ROM 2:5">Rom. 2.5</ref>. <ref loc="REV 11:18">Apoc. 11.18</ref>.</char></note>.<verse eid="PSA 110:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6"/>Egli farà giudicio fra le genti, egli empierà <char style="add">ogni cosa</char> di corpi morti;</para>
  <para style="q" vid="PSA 110:6">Egli trafiggerà il capo <char style="add">che regna</char> sopra molti paesi.<verse eid="PSA 110:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7"/>Egli berrà del torrente tra via;</para>
  <para style="q" vid="PSA 110:7">E perciò alzerà il capo.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">SALMO CXI</para>
  <para style="s1">Dio lodato per le mirabili sue opere</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 111:1">Io celebrerò il Signore con tutto il cuore,</para>
  <para style="q" vid="PSA 111:1">Nel consiglio, e nella raunanza degli <char style="add">uomini</char> diritti.<verse eid="PSA 111:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2"/>Grandi <char style="add">son</char> le opere del Signore,</para>
  <para style="q" vid="PSA 111:2">Spiegate davanti a tutti quelli che si dilettano in esse<note caller="*" style="x"><char style="xo" closed="false">111.2 </char><char style="xk" closed="false">esse </char><char style="xt" closed="false">Giob. cap. 38-41. <ref loc="PSA 92:5">Sal. 92.5</ref>; <ref loc="PSA 143:5">143.5</ref>. <ref loc="REV 15:3">Apoc. 15.3</ref>.</char></note>.<verse eid="PSA 111:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3"/>Le sue opere <char style="add">son</char> gloria e magnificenza;</para>
  <para style="q" vid="PSA 111:3">E la sua giustizia dimora in eterno.<verse eid="PSA 111:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4"/>Egli ha rendute memorabili le sue maraviglie;</para>
  <para style="q" vid="PSA 111:4">Il Signore <char style="add">è</char> grazioso e pietoso<note caller="*" style="x"><char style="xo" closed="false">111.4 </char><char style="xk" closed="false">pietoso </char><char style="xt" closed="false"><ref loc="EXO 34:6">Esod. 34.6</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 111:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5"/>Egli dà da vivere a quelli che lo temono<note caller="*" style="x"><char style="xo" closed="false">111.5 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="MAT 6:25-34">Mat. 6.25-34</ref>.</char></note>;</para>
  <para style="q" vid="PSA 111:5">Egli si ricorda in eterno del suo patto.<verse eid="PSA 111:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6"/>Egli ha dichiarata al suo popolo la potenza delle sue opere,</para>
  <para style="q" vid="PSA 111:6">Dandogli l'eredità delle genti.<verse eid="PSA 111:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7"/>Le opere delle sue mani <char style="add">son</char> verità e dirittura;</para>
  <para style="q" vid="PSA 111:7">Tutti i suoi comandamenti <char style="add">son</char> veraci<note caller="*" style="x"><char style="xo" closed="false">111.7 </char><char style="xk" closed="false">veraci </char><char style="xt" closed="false"><ref loc="PSA 19:7">Sal. 19.7</ref>.</char></note>;<verse eid="PSA 111:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8"/>Stabili in sempiterno<note caller="*" style="x"><char style="xo" closed="false">111.8 </char><char style="xk" closed="false">sempiterno </char><char style="xt" closed="false"><ref loc="ISA 40:8">Is. 40.8</ref>. <ref loc="MAT 5:18">Mat. 5.18</ref>.</char></note>,</para>
  <para style="q" vid="PSA 111:8">Fatti con verità, e con dirittura.<verse eid="PSA 111:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9"/>Egli ha mandata la redenzione al suo popolo<note caller="*" style="x"><char style="xo" closed="false">111.9 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat. 1.21</ref>. <ref loc="LUK 1:68">Luc. 1.68</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 111:9">Egli ha ordinato il suo patto in eterno;</para>
  <para style="q" vid="PSA 111:9">Il suo Nome <char style="add">è</char> santo e tremendo.<verse eid="PSA 111:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10"/>Il principio della sapienza <char style="add">è</char> il timor del Signore<note caller="*" style="x"><char style="xo" closed="false">111.10 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="JOB 28:28">Giob. 28.28</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 111:10">Ogni <char style="add">uomo</char> che mette in opera i suoi comandamenti, ha buon senno<note caller="*" style="x"><char style="xo" closed="false">111.10 </char><char style="xk" closed="false">senno </char><char style="xt" closed="false"><ref loc="DEU 4:6">Deut. 4.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 111:10">La sua lode dimora in perpetuo.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">SALMO CXII</para>
  <para style="s1">Felicità di chi teme Iddio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1"/>ALLELUIA,</para>
  <para style="q" vid="PSA 112:1">Beato l'uomo<note caller="*" style="x"><char style="xo" closed="false">112.1 </char><char style="xk" closed="false">uomo </char><char style="xt" closed="false"><ref loc="PSA 1:1">Sal. 1.1</ref>,<ref loc="PSA 1:2">2</ref>; <ref loc="PSA 115:13">115.13</ref>; <ref loc="PSA 128:1">128.1</ref>.</char></note> che teme il Signore,</para>
  <para style="q" vid="PSA 112:1">
    <char style="add">E</char> si diletta sommamente ne' suoi comandamenti<note caller="*" style="x"><char style="xo" closed="false">112.1 </char><char style="xk" closed="false">comandamenti </char><char style="xt" closed="false"><ref loc="PSA 119:16">Sal. 119.16</ref>,<ref loc="PSA 119:35">35</ref>,<ref loc="PSA 119:47">47</ref>,<ref loc="PSA 119:70">70</ref>,<ref loc="PSA 119:143">143</ref>.</char></note>.<verse eid="PSA 112:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2"/>La sua progenie sarà possente in terra;</para>
  <para style="q" vid="PSA 112:2">La generazione degli <char style="add">uomini</char> diritti sarà benedetta<note caller="*" style="x"><char style="xo" closed="false">112.2 </char><char style="xk" closed="false">benedetta </char><char style="xt" closed="false"><ref loc="PSA 25:13">Sal. 25.13</ref>; <ref loc="PSA 37:25">37.25</ref>; <ref loc="PSA 102:28">102.28</ref>.</char></note>.<verse eid="PSA 112:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3"/>Facoltà e ricchezze <char style="add">son</char> nella sua casa<note caller="*" style="x"><char style="xo" closed="false">112.3 </char><char style="xk" closed="false">casa </char><char style="xt" closed="false"><ref loc="MAT 6:33">Mat. 6.33</ref>. <ref loc="MRK 10:30">Mar. 10.30</ref>. <ref loc="1TI 4:8">1 Tim. 4.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 112:3">E la sua giustizia dimora in perpetuo.<verse eid="PSA 112:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4"/>La luce si leva nelle tenebre a quelli che son diritti<note caller="*" style="x"><char style="xo" closed="false">112.4 </char><char style="xk" closed="false">diritti </char><char style="xt" closed="false"><ref loc="PSA 97:11">Sal. 97.11</ref> </char><char style="xta" closed="false">e rif.</char></note>.</para>
  <para style="q" vid="PSA 112:4">
    <char style="add">Un tale uomo è</char> pietoso, misericordioso, e giusto.<verse eid="PSA 112:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5"/>L'uomo da bene dona, e presta<note caller="*" style="x"><char style="xo" closed="false">112.5 </char><char style="xk" closed="false">presta </char><char style="xt" closed="false"><ref loc="LUK 6:35">Luc. 6.35</ref>.</char></note>;</para>
  <para style="q" vid="PSA 112:5">
    <char style="add">E</char> governa i fatti suoi con dirittura<note caller="*" style="x"><char style="xo" closed="false">112.5 </char><char style="xk" closed="false">dirittura </char><char style="xt" closed="false"><ref loc="EPH 5:15">Efes. 5.15</ref>. <ref loc="COL 4:4">Col. 4.4</ref>.</char></note>.<verse eid="PSA 112:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6"/>Certo egli non sarà giammai smosso;</para>
  <para style="q" vid="PSA 112:6">Il giusto sarà in memoria perpetua<note caller="*" style="x"><char style="xo" closed="false">112.6 </char><char style="xk" closed="false">perpetua </char><char style="xt" closed="false"><ref loc="PRO 10:7">Prov. 10.7</ref>.</char></note>.<verse eid="PSA 112:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7"/>Egli non temerà di mal grido<note caller="*" style="x"><char style="xo" closed="false">112.7 </char><char style="xk" closed="false">grido </char><char style="xt" closed="false"><ref loc="PRO 1:33">Prov. 1.33</ref>.</char></note>;</para>
  <para style="q" vid="PSA 112:7">Il suo cuore <char style="add">è</char> fermo, egli si confida nel Signore<note caller="*" style="x"><char style="xo" closed="false">112.7 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 112:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8"/>Il suo cuore <char style="add">è</char> bene appoggiato, egli non avrà paura alcuna,</para>
  <para style="q" vid="PSA 112:8">Finchè vegga ne' suoi nemici <char style="add">ciò ch'egli desidera</char>.<verse eid="PSA 112:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9"/>Egli ha sparso<note caller="*" style="x"><char style="xo" closed="false">112.9 </char><char style="xk" closed="false">sparso </char><char style="xt" closed="false"><ref loc="PRO 11:24">Prov. 11.24</ref>. <ref loc="MAT 5:42">Mat. 5.42</ref>.</char></note>, egli ha donato a' bisognosi<note caller="*" style="x"><char style="xo" closed="false">112.9 </char><char style="xk" closed="false">bisognosi </char><char style="xt" closed="false"><ref loc="2CO 9:9">2 Cor. 9.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 112:9">La sua giustizia dimora in perpetuo<note caller="*" style="x"><char style="xo" closed="false">112.9 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"><ref loc="DEU 24:13">Deut. 24.13</ref>.</char></note>,</para>
  <para style="q" vid="PSA 112:9">Il suo corno sarà alzato in gloria.<verse eid="PSA 112:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10"/>L'empio <char style="add">lo</char> vedrà, e dispetterà<note caller="*" style="x"><char style="xo" closed="false">112.10 </char><char style="xk" closed="false">dispetterà </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat. 8.12</ref>. <ref loc="LUK 13:28">Luc. 13.28</ref>.</char></note>;</para>
  <para style="q" vid="PSA 112:10">Egli digrignerà i denti, e si struggerà;</para>
  <para style="q" vid="PSA 112:10">Il desiderio degli empi perirà<note caller="*" style="x"><char style="xo" closed="false">112.10 </char><char style="xk" closed="false">perirà </char><char style="xt" closed="false"><ref loc="PRO 10:28">Prov. 10.28</ref>; <ref loc="PRO 11:7">11.7</ref>.</char></note>.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">SALMO CXIII</para>
  <para style="s1">Dio lodato per la sua grandezza e la sua bontà verso i poveri</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 113:1">Lodate, servitori del Signore,</para>
  <para style="q" vid="PSA 113:1">Lodate il Nome del Signore.<verse eid="PSA 113:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2"/>Sia benedetto il nome del Signore<note caller="*" style="x"><char style="xo" closed="false">113.2 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="JOB 1:21">Giob. 1.21</ref>. <ref loc="DAN 2:20">Dan. 2.20</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 113:2">Da ora in eterno.<verse eid="PSA 113:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3"/>Il nome del Signore è lodato</para>
  <para style="q" vid="PSA 113:3">Dal sol levante, infino al ponente<note caller="*" style="x"><char style="xo" closed="false">113.3 </char><char style="xk" closed="false">ponente </char><char style="xt" closed="false"><ref loc="ISA 59:19">Is. 59.19</ref>. <ref loc="MAL 1:11">Mal. 1.11</ref>.</char></note>.<verse eid="PSA 113:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4"/>Il Signore <char style="add">è</char> eccelso sopra tutte le nazioni,</para>
  <para style="q" vid="PSA 113:4">La sua gloria <char style="add">è</char> sopra i cieli.<verse eid="PSA 113:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5"/>Chi <char style="add">è</char> simile al Signore Iddio nostro,</para>
  <para style="q" vid="PSA 113:5">Il quale abita ne' luoghi altissimi?<verse eid="PSA 113:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6"/>Che riguarda abbasso</para>
  <para style="q" vid="PSA 113:6">In cielo ed in terra<note caller="*" style="x"><char style="xo" closed="false">113.6 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 11:4">Sal. 11.4</ref> e rif. <ref loc="ISA 57:15">Is. 57.15</ref>.</char></note>;<verse eid="PSA 113:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7"/>Che rileva il misero dalla polvere,</para>
  <para style="q" vid="PSA 113:7">
    <char style="add">Ed</char> innalza il povero dallo sterco<note caller="*" style="x"><char style="xo" closed="false">113.7 </char><char style="xk" closed="false">sterco </char><char style="xt" closed="false"><ref loc="1SA 2:5">1 Sam. 2.5</ref> </char><char style="xta" closed="false">ecc. e rif.</char></note>;<verse eid="PSA 113:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8"/>Per farlo sedere co' principi,</para>
  <para style="q" vid="PSA 113:8">Co' principi del suo popolo;<verse eid="PSA 113:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9"/>Che fa abitare in famiglia la donna sterile,</para>
  <para style="q" vid="PSA 113:9">
    <char style="add">Facendola</char> diventar lieta madre di figliuoli<note caller="*" style="x"><char style="xo" closed="false">113.9 </char><char style="xk" closed="false">figliuoli </char><char style="xt" closed="false"><ref loc="ISA 54:1">Is. 54.1</ref>. <ref loc="GAL 4:27">Gal. 4.27</ref>.</char></note>?</para>
  <para style="q" vid="PSA 113:9">Alleluia.<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">SALMO CXIV</para>
  <para style="s1">Il Salmista celebra il passo miracoloso del Mar rosso e del Giordano</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1"/>QUANDO Israele uscì di Egitto<note caller="*" style="x"><char style="xo" closed="false">114.1 </char><char style="xk" closed="false">Egitto </char><char style="xt" closed="false"><ref loc="EXO 13:3">Esod. 13.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 114:1">
    <char style="add">E</char> la casa di Giacobbe d'infra il popolo barbaro<note caller="*" style="x"><char style="xo" closed="false">114.1 </char><char style="xk" closed="false">barbaro </char><char style="xt" closed="false"><ref loc="PSA 81:5">Sal. 81.5</ref>.</char></note>;<verse eid="PSA 114:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2"/>Giuda fu consacrato al Signore,</para>
  <para style="q" vid="PSA 114:2">Israele <char style="add">divenne</char> suo dominio<note caller="*" style="x"><char style="xo" closed="false">114.2 </char><char style="xk" closed="false">dominio </char><char style="xt" closed="false"><ref loc="EXO 19:5">Esod. 19.5</ref>,<ref loc="EXO 19:6">6</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3"/>Il mare <char style="add">lo</char> vide, e fuggì;</para>
  <para style="q" vid="PSA 114:3">Il Giordano si rivolse a ritroso<note caller="*" style="x"><char style="xo" closed="false">114.3 </char><char style="xk" closed="false">ritroso </char><char style="xt" closed="false"><ref loc="EXO 14:21">Esod. 14.21</ref>. <ref loc="JOS 3:13-17">Gios. 3.13-17</ref>.</char></note>.<verse eid="PSA 114:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4"/>I monti saltarono come montoni,</para>
  <para style="q" vid="PSA 114:4">I colli come agnelli.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5"/>Che avesti, o mare, che tu fuggisti?</para>
  <para style="q" vid="PSA 114:5">
    <char style="add">E tu</char>, Giordano, che ti rivolgesti a ritroso?<verse eid="PSA 114:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6"/>
    <char style="add">E voi</char>, monti, <char style="add">che</char> saltaste come montoni;</para>
  <para style="q" vid="PSA 114:6">
    <char style="add">E voi</char>, colli, come agnelli?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7"/>Trema, o terra, per la presenza del Signore;</para>
  <para style="q" vid="PSA 114:7">Per la presenza dell'Iddio di Giacobbe;<verse eid="PSA 114:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8"/>Il quale mutò la roccia in guazzo d'acqua,</para>
  <para style="q" vid="PSA 114:8">Il macigno in fonte d'acqua<note caller="*" style="x"><char style="xo" closed="false">114.8 </char><char style="xk" closed="false">acqua </char><char style="xt" closed="false"><ref loc="EXO 17:6">Esod. 17.6</ref>. <ref loc="NUM 20:11">Num. 20.11</ref>.</char></note>.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">SALMO CXV</para>
  <para style="s1">La gloria del Signore e la vanità degli idoli. Esortazione a fidare in Dio solo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1"/>NON a noi, Signore, non a noi,</para>
  <para style="q" vid="PSA 115:1">Anzi al tuo Nome, da' gloria<note caller="*" style="x"><char style="xo" closed="false">115.1 </char><char style="xk" closed="false">gloria </char><char style="xt" closed="false"><ref loc="ISA 48:11">Is. 48.11</ref>. <ref loc="EZK 36:32">Ezec. 36.32</ref>.</char></note>,</para>
  <para style="q" vid="PSA 115:1">Per la tua benignità, e verità.<verse eid="PSA 115:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2"/>Perchè direbbero le genti:</para>
  <para style="q" vid="PSA 115:2">Dove <char style="add">è</char> ora l'Iddio loro<note caller="*" style="x"><char style="xo" closed="false">115.2 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="PSA 42:3">Sal. 42.3</ref>,<ref loc="PSA 42:10">10</ref>. <ref loc="JOL 2:17">Gioel. 2.17</ref>.</char></note>?<verse eid="PSA 115:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3"/>Or l'Iddio nostro <char style="add">è</char> pur ne' cieli</para>
  <para style="q" vid="PSA 115:3">
    <char style="add">E</char> fa tutto ciò che gli piace<note caller="*" style="x"><char style="xo" closed="false">115.3 </char><char style="xk" closed="false">piace </char><char style="xt" closed="false"><ref loc="PSA 135:6">Sal. 135.6</ref>. <ref loc="DAN 4:35">Dan. 4.35</ref>.</char></note>.<verse eid="PSA 115:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4"/>Gl'idoli di quelle <char style="add">sono</char> oro ed argento;</para>
  <para style="q" vid="PSA 115:4">Opera di mani d'uomini<note caller="*" style="x"><char style="xo" closed="false">115.4 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="DEU 4:28">Deut. 4.28</ref>. <ref loc="PSA 135:15-18">Sal. 135.15-18</ref>. <ref loc="ISA 44:10-20">Is. 44.10-20</ref>. <ref loc="JER 10:3">Ger. 10.3</ref> ecc. <ref loc="ACT 19:26">Fat. 19.26</ref>.</char></note>;<verse eid="PSA 115:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5"/>Hanno bocca, e non parlano<note caller="*" style="x"><char style="xo" closed="false">115.5 </char><char style="xk" closed="false">parlano </char><char style="xt" closed="false"><ref loc="ISA 46:6">Is. 46.6</ref>,<ref loc="ISA 46:7">7</ref>. <ref loc="HAB 2:18">Abac. 2.18</ref>,<ref loc="HAB 2:19">19</ref>.</char></note>;</para>
  <para style="q" vid="PSA 115:5">Hanno occhi, e non veggono;<verse eid="PSA 115:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6"/>Hanno orecchie, e non odono;</para>
  <para style="q" vid="PSA 115:6">Hanno naso, e non odorano;<verse eid="PSA 115:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7"/>Hanno mani, e non toccano;</para>
  <para style="q" vid="PSA 115:7">Hanno piedi, e non camminano;</para>
  <para style="q" vid="PSA 115:7">E non rendono alcun suono dalla lor gola.<verse eid="PSA 115:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8"/>Simili ad essi sieno quelli che li fanno;</para>
  <para style="q" vid="PSA 115:8">Chiunque si confida in essi<note caller="*" style="x"><char style="xo" closed="false">115.8 </char><char style="xk" closed="false">essi </char><char style="xt" closed="false"><ref loc="JON 2:9">Gion. 2.9</ref>.</char></note>.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9"/>O Israele, confidati nel Signore<note caller="*" style="x"><char style="xo" closed="false">115.9 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 115:9">Egli <char style="add">è</char> l'aiuto, e lo scudo di quelli <char style="add">che si confidano in lui</char><note caller="*" style="x"><char style="xo" closed="false">115.9 </char><char style="xk" closed="false">lui </char><char style="xt" closed="false"><ref loc="DEU 33:29">Deut. 33.29</ref>. <ref loc="PSA 33:20">Sal. 33.20</ref>. <ref loc="PRO 30:5">Prov. 30.5</ref>.</char></note>.<verse eid="PSA 115:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10"/>O casa d'Aaronne, confidatevi, nel Signore;</para>
  <para style="q" vid="PSA 115:10">Egli <char style="add">è</char> l'aiuto, e lo scudo di quelli <char style="add">che si confidano in lui</char>.<verse eid="PSA 115:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11"/>O <char style="add">voi</char> che temete il Signore, confidatevi in lui;</para>
  <para style="q" vid="PSA 115:11">Egli <char style="add">è</char> l'aiuto, e lo scudo di quelli <char style="add">che si confidano in lui</char>.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12"/>Il Signore si ricorda di noi; egli <char style="add">ci</char> benedirà;</para>
  <para style="q" vid="PSA 115:12">Egli benedirà la casa d'Israele;</para>
  <para style="q" vid="PSA 115:12">Egli benedirà la casa d'Aaronne.<verse eid="PSA 115:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13"/>Egli benedirà quelli che lo temono<note caller="*" style="x"><char style="xo" closed="false">115.13 </char><char style="xk" closed="false">temono </char><char style="xt" closed="false"><ref loc="PSA 128:1">Sal. 128.1</ref>,<ref loc="PSA 128:4">4</ref>.</char></note>,</para>
  <para style="q" vid="PSA 115:13">Piccoli e grandi.<verse eid="PSA 115:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14"/>Il Signore vi accrescerà <char style="add">le sue grazie</char>,</para>
  <para style="q" vid="PSA 115:14">A voi, ed a' vostri figliuoli.<verse eid="PSA 115:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15"/>Voi <char style="add">siete</char> benedetti dal Signore</para>
  <para style="q" vid="PSA 115:15">Che ha fatto il cielo e la terra.<verse eid="PSA 115:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16"/>Quant'è al cielo, il cielo <char style="add">è</char> per lo Signore;</para>
  <para style="q" vid="PSA 115:16">Ma egli ha data la terra a' figliuoli degli uomini.<verse eid="PSA 115:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17"/>I morti non loderanno già il Signore<note caller="*" style="x"><char style="xo" closed="false">115.17 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 6:5">Sal. 6.5</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 115:17">Nè alcun di quelli che scendono nel <char style="add">luogo del</char> silenzio.<verse eid="PSA 115:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18"/>Ma noi benediremo il Signore,</para>
  <para style="q" vid="PSA 115:18">Da ora in eterno<note caller="*" style="x"><char style="xo" closed="false">115.18 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 113:2">Sal. 113.2</ref> </char><char style="xta" closed="false">e rif.</char></note>.</para>
  <para style="q" vid="PSA 115:18">Alleluia.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">SALMO CXVI</para>
  <para style="s1">Amore e gratitudine a Dio per le sue liberazioni</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1"/>IO amo <char style="add">il Signore</char><note caller="*" style="x"><char style="xo" closed="false">116.1 </char><char style="xk" closed="false"><char style="add">Signore</char> </char><char style="xt" closed="false"><ref loc="PSA 18:1">Sal. 18.1</ref>.</char></note>; perciocchè egli ascolta</para>
  <para style="q" vid="PSA 116:1">La mia voce, <char style="add">e</char> le mie supplicazioni.<verse eid="PSA 116:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2"/>Poichè egli ha inchinato a me il suo orecchio,</para>
  <para style="q" vid="PSA 116:2">Io <char style="add">lo</char> invocherò tutti i giorni della mia vita.<verse eid="PSA 116:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3"/>I legami della morte mi avevano circondato<note caller="*" style="x"><char style="xo" closed="false">116.3 </char><char style="xk" closed="false">circondato </char><char style="xt" closed="false"><ref loc="PSA 18:4">Sal. 18.4</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 116:3">E le distrette del sepolcro mi avevano colto;</para>
  <para style="q" vid="PSA 116:3">Io aveva scontrata angoscia e cordoglio.<verse eid="PSA 116:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4"/>Ma io invocai il Nome del Signore,</para>
  <para style="q" vid="PSA 116:4">
    <char style="add">Dicendo:</char> Deh! Signore, libera l'anima mia.<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5"/>Il Signore <char style="add">è</char> pietoso<note caller="*" style="x"><char style="xo" closed="false">116.5 </char><char style="xk" closed="false">pietoso </char><char style="xt" closed="false"><ref loc="PSA 103:8">Sal. 103.8</ref> </char><char style="xta" closed="false">e rif.</char></note> e giusto<note caller="*" style="x"><char style="xo" closed="false">116.5 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="EZR 9:15">Esd. 9.15</ref>. <ref loc="PSA 145:17">Sal. 145.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 116:5">E il nostro Dio è misericordioso<note caller="*" style="x"><char style="xo" closed="false">116.5 </char><char style="xk" closed="false">misericordioso </char><char style="xt" closed="false"><ref loc="PSA 86:15">Sal. 86.15</ref>.</char></note>.<verse eid="PSA 116:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6"/>Il Signore guarda i semplici;</para>
  <para style="q" vid="PSA 116:6">Io era ridotto in misero stato,</para>
  <para style="q" vid="PSA 116:6">Ed egli mi ha salvato.<verse eid="PSA 116:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7"/>Ritorna, anima mia, al tuo riposo<note caller="*" style="x"><char style="xo" closed="false">116.7 </char><char style="xk" closed="false">riposo </char><char style="xt" closed="false"><ref loc="JER 6:16">Ger. 6.16</ref>. <ref loc="MAT 11:29">Mat. 11.29</ref>.</char></note>;</para>
  <para style="q" vid="PSA 116:7">Perciocchè il Signore ti ha fatta la tua retribuzione.<verse eid="PSA 116:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8"/>Poichè, <char style="add">o Signore</char>, tu hai ritratta l'anima mia da morte<note caller="*" style="x"><char style="xo" closed="false">116.8 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="PSA 56:13">Sal. 56.13</ref>; <ref loc="PSA 86:13">86.13</ref>.</char></note>,</para>
  <para style="q" vid="PSA 116:8">Gli occhi miei da lagrime,</para>
  <para style="q" vid="PSA 116:8">I miei piedi da caduta;<verse eid="PSA 116:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9"/>Io camminerò nel tuo cospetto</para>
  <para style="q" vid="PSA 116:9">Nella terra de' viventi.<verse eid="PSA 116:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10"/>Io ho creduto, <char style="add">e però</char> certo io parlerò<note caller="*" style="x"><char style="xo" closed="false">116.10 </char><char style="xk" closed="false">parlerò </char><char style="xt" closed="false"><ref loc="2CO 4:13">2 Cor. 4.13</ref>.</char></note>.</para>
  <para style="q" vid="PSA 116:10">Io era grandemente afflitto;<verse eid="PSA 116:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11"/>Io diceva nel mio smarrimento:</para>
  <para style="q" vid="PSA 116:11">Ogni uomo <char style="add">è</char> bugiardo<note caller="*" style="x"><char style="xo" closed="false">116.11 </char><char style="xk" closed="false">bugiardo </char><char style="xt" closed="false"><ref loc="PSA 62:9">Sal. 62.9</ref>. <ref loc="ROM 3:4">Rom. 3.4</ref>.</char></note>.<verse eid="PSA 116:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12"/>Che renderò io al Signore<note caller="*" style="x"><char style="xo" closed="false">116.12 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="DEU 32:6">Deut. 32.6</ref>. <ref loc="2CH 32:25">2 Cron. 32.25</ref>.</char></note>?</para>
  <para style="q" vid="PSA 116:12">Tutti i suoi beneficii <char style="add">son</char> sopra me.<verse eid="PSA 116:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13"/>Io prenderò il calice delle salvazioni,</para>
  <para style="q" vid="PSA 116:13">E predicherò il Nome del Signore.<verse eid="PSA 116:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14"/>Io pagherò i miei voti al Signore<note caller="*" style="x"><char style="xo" closed="false">116.14 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 22:25">Sal. 22.25</ref>. <ref loc="JON 2:10">Gion. 2.10</ref>.</char></note>,</para>
  <para style="q" vid="PSA 116:14">Ora in presenza di tutto il suo popolo.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15"/>La morte de' santi del Signore<note caller="*" style="x"><char style="xo" closed="false">116.15 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="NUM 23:10">Num. 23.10</ref>.</char></note></para>
  <para style="q" vid="PSA 116:15">
    <char style="add">È</char> preziosa nel suo cospetto.<verse eid="PSA 116:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16"/>Deh! Signore, <char style="add">esaudiscimi</char>; perciocchè io <char style="add">son</char> tuo servitore;</para>
  <para style="q" vid="PSA 116:16">Io <char style="add">son</char> tuo servitore, figliuolo della tua servente<note caller="*" style="x"><char style="xo" closed="false">116.16 </char><char style="xk" closed="false">servente </char><char style="xt" closed="false"><ref loc="2TI 1:5">2 Tim. 1.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 116:16">Tu hai sciolti i miei legami.<verse eid="PSA 116:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17"/>Io ti sacrificherò sacrificio di lode<note caller="*" style="x"><char style="xo" closed="false">116.17 </char><char style="xk" closed="false">lode </char><char style="xt" closed="false"><ref loc="PSA 107:22">Sal. 107.22</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 116:17">E predicherò il Nome del Signore.<verse eid="PSA 116:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18"/>Io pagherò i miei voti al Signore,</para>
  <para style="q" vid="PSA 116:18">Ora in presenza di tutto il suo popolo<note caller="*" style="x"><char style="xo" closed="false">116.18 </char><char style="xk" closed="false">popolo </char><char style="xta" closed="false">ver. </char><char style="xt" closed="false"><ref loc="PSA 14">14</ref>. </char><char style="xta" closed="false">e rif.</char></note>;<verse eid="PSA 116:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19"/>Ne' cortili della Casa del Signore,</para>
  <para style="q" vid="PSA 116:19">In mezzo di te, o Gerusalemme.</para>
  <para style="q" vid="PSA 116:19">Alleluia.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">SALMO CXVII</para>
  <para style="s1">Dio lodato per la sua bontà e la sua verità</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1"/>NAZIONI tutte, lodate il Signore<note caller="*" style="x"><char style="xo" closed="false">117.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="ROM 15:11">Rom. 15.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 117:1">Popoli tutti, celebratelo;<verse eid="PSA 117:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2"/>Perciocchè la sua benignità è grandissima sopra noi<note caller="*" style="x"><char style="xo" closed="false">117.2 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="PSA 103:11">Sal. 103.11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 117:2">E la sua verità <char style="add">è</char> in eterno.</para>
  <para style="q" vid="PSA 117:2">Alleluia.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">SALMO CXVIII</para>
  <para style="s1">Liberato da molti nemici, il Salmista ne loda e ne ringrazia Iddio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1"/>CELEBRATE il Signore; perciocchè <char style="add">egli è</char> buono,</para>
  <para style="q" vid="PSA 118:1">Perciocchè la sua benignità <char style="add">è</char> in eterno<note caller="*" style="x"><char style="xo" closed="false">118.1 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="PSA 106:1">Sal. 106.1</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 118:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2"/>Or dica Israele,</para>
  <para style="q" vid="PSA 118:2">Che la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 118:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3"/>Or dica la casa d'Aaronne,</para>
  <para style="q" vid="PSA 118:3">Che la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 118:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4"/>Or dicano quelli che temono il Signore,</para>
  <para style="q" vid="PSA 118:4">Che la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 118:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5"/>Essendo in distretta, io invocai il Signore<note caller="*" style="x"><char style="xo" closed="false">118.5 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 116:4">Sal. 116.4</ref>; <ref loc="PSA 120:1">120.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 118:5">E il Signore mi rispose, <char style="add">e mi mise</char> al largo.<verse eid="PSA 118:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6"/>Il Signore <char style="add">è</char> per me; io non temerò</para>
  <para style="q" vid="PSA 118:6">Ciò che mi possa far l'uomo<note caller="*" style="x"><char style="xo" closed="false">118.6 </char><char style="xk" closed="false">uomo </char><char style="xt" closed="false"><ref loc="PSA 27:1">Sal. 27.1</ref> ecc.; <ref loc="PSA 56:4">56.4</ref>,<ref loc="PSA 56:11">11</ref>; <ref loc="PSA 146:5">146.5</ref>. <ref loc="ISA 51:12">Is. 51.12</ref>. <ref loc="HEB 13:6">Ebr. 13.6</ref>.</char></note>.<verse eid="PSA 118:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7"/>Il Signore <char style="add">è</char> per me, fra quelli che mi soccorrono;</para>
  <para style="q" vid="PSA 118:7">E <char style="add">però</char> io vedrò <char style="add">ciò che io desidero</char> ne' miei nemici.<verse eid="PSA 118:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8"/>Meglio <char style="add">è</char> sperar nel Signore,</para>
  <para style="q" vid="PSA 118:8">Che confidarsi negli uomini<note caller="*" style="x"><char style="xo" closed="false">118.8 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="PSA 40:4">Sal. 40.4</ref>. <ref loc="JER 17:5-7">Ger. 17.5-7</ref>.</char></note>.<verse eid="PSA 118:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9"/>Meglio <char style="add">è</char> sperar nel Signore,</para>
  <para style="q" vid="PSA 118:9">Che confidarsi ne' principi<note caller="*" style="x"><char style="xo" closed="false">118.9 </char><char style="xk" closed="false">principi </char><char style="xt" closed="false"><ref loc="PSA 146:3">Sal. 146.3</ref>.</char></note>.<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10"/>Nazioni d'ogni parte mi avevano intorniato;</para>
  <para style="q" vid="PSA 118:10">Nel nome del Signore <char style="add">è avvenuto</char> che io le ho sconfitte.<verse eid="PSA 118:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11"/>Mi avevano circondato, ed anche accerchiao;</para>
  <para style="q" vid="PSA 118:11">Nel Nome del Signore <char style="add">è avvenuto</char> che io le ho sconfitte.<verse eid="PSA 118:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12"/>Mi avevano intorniato come api;</para>
  <para style="q" vid="PSA 118:12">
    <char style="add">Ma</char> sono state spente come fuoco di spine;</para>
  <para style="q" vid="PSA 118:12">Nel Nome del Signore <char style="add">è avvenuto</char> che io le ho sconfitte.<verse eid="PSA 118:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13"/>Tu mi avevi fieramente sospinto, <char style="add">o nemico</char>, per farmi cadere;</para>
  <para style="q" vid="PSA 118:13">Ma il Signore mi ha soccorso.<verse eid="PSA 118:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14"/>Il Signore <char style="add">è</char> la mia forza, ed il <char style="add">mio</char> cantico<note caller="*" style="x"><char style="xo" closed="false">118.14 </char><char style="xk" closed="false">cantico </char><char style="xt" closed="false"><ref loc="EXO 15:2">Esod. 15.2</ref>. <ref loc="ISA 12:2">Is. 12.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 118:14">E mi è stato in salute.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15"/>Voce di giubilo e di vittoria <char style="add">è</char> ne' tabernacoli de' giusti;</para>
  <para style="q" vid="PSA 118:15">La destra del Signore fa prodezze.<verse eid="PSA 118:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16"/>La destra del Signore è innalzata;</para>
  <para style="q" vid="PSA 118:16">La destra del Signore fa prodezze.<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17"/>Io non morrò, anzi viverò,</para>
  <para style="q" vid="PSA 118:17">E racconterò le opere del Signore<note caller="*" style="x"><char style="xo" closed="false">118.17 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 6:5">Sal. 6.5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 118:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18"/>Il Signore veramente mi ha gastigato;</para>
  <para style="q" vid="PSA 118:18">Ma non mi ha dato alla morte<note caller="*" style="x"><char style="xo" closed="false">118.18 </char><char style="xk" closed="false">morte </char><char style="xt" closed="false"><ref loc="2CO 6:9">2 Cor. 6.9</ref>.</char></note>.<verse eid="PSA 118:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19"/>Apritemi le porte di giustizia<note caller="*" style="x"><char style="xo" closed="false">118.19 </char><char style="xk" closed="false">giustizia </char><char style="xt" closed="false"><ref loc="ISA 26:2">Is. 26.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 118:19">Io entrerò per esse, <char style="add">e</char> celebrerò il Signore.<verse eid="PSA 118:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20"/>Questa <char style="add">è</char> la porta del Signore<note caller="*" style="x"><char style="xo" closed="false">118.20 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 24:7">Sal. 24.7</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 118:20">I giusti entreranno per essa<note caller="*" style="x"><char style="xo" closed="false">118.20 </char><char style="xk" closed="false">essa </char><char style="xt" closed="false"><ref loc="ISA 35:8">Is. 35.8</ref>. <ref loc="REV 21:27">Apoc. 21.27</ref>; <ref loc="REV 22:14">22.14</ref>,<ref loc="REV 22:15">15</ref>.</char></note>.<verse eid="PSA 118:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21"/>Io ti celebrerò; perciocchè tu mi hai risposto<note caller="*" style="x"><char style="xo" closed="false">118.21 </char><char style="xk" closed="false">risposto </char><char style="xt" closed="false"><ref loc="PSA 116:1">Sal. 116.1</ref>.</char></note>,</para>
  <para style="q" vid="PSA 118:21">E mi sei stato in salute.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22"/>La pietra <char style="add">che</char> gli edificatori avevano rigettata,</para>
  <para style="q" vid="PSA 118:22">E stata posta in capo del cantone<note caller="*" style="x"><char style="xo" closed="false">118.22 </char><char style="xk" closed="false">cantone </char><char style="xt" closed="false"><ref loc="ISA 28:16">Is. 28.16</ref>. <ref loc="MAT 21:42">Mat. 21.42</ref>. <ref loc="MRK 12:10">Mar. 12.10</ref>,<ref loc="MRK 12:11">11</ref>. <ref loc="LUK 20:17">Luc. 20.17</ref>. <ref loc="ACT 4:11">Fat. 4.11</ref>. <ref loc="EPH 2:20">Efes. 2.20</ref>. <ref loc="1PE 2:4">1 Piet. 2.4</ref>,<ref loc="1PE 2:7">7</ref>.</char></note>.<verse eid="PSA 118:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23"/>Questo è proceduto dal Signore;</para>
  <para style="q" vid="PSA 118:23">
    <char style="add">Ed</char> è cosa maravigliosa davanti agli occhi nostri.<verse eid="PSA 118:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24"/>Questo <char style="add">è</char> il giorno <char style="add">che</char> il Signore ha operato:</para>
  <para style="q" vid="PSA 118:24">Festeggiamo, e rallegriamoci in esso.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25"/>Deh! Signore, ora salva;</para>
  <para style="q" vid="PSA 118:25">Deh! Signore, ora prospera.<verse eid="PSA 118:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26"/>Benedetto <char style="add">sia</char> colui che viene nel Nome del Signore<note caller="*" style="x"><char style="xo" closed="false">118.26 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mat. 21.9</ref>; <ref loc="MAT 23:39">23.39</ref>. <ref loc="MRK 11:9">Mar. 11.9</ref>. <ref loc="LUK 19:38">Luc. 19.38</ref>.</char></note>;</para>
  <para style="q" vid="PSA 118:26">Noi vi benediciamo dalla Casa del Signore.<verse eid="PSA 118:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27"/>Il Signore <char style="add">è</char> Iddio, e ci ha fatta apparire una chiara luce<note caller="*" style="x"><char style="xo" closed="false">118.27 </char><char style="xk" closed="false">luce </char><char style="xt" closed="false"><ref loc="PSA 97:11">Sal. 97.11</ref> e rif. <ref loc="1PE 2:9">1 Piet. 2.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 118:27">Legate con funi <char style="add">l'ostia del</char>la solennità</para>
  <para style="q" vid="PSA 118:27">Alle corna dell'altare.<verse eid="PSA 118:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28"/>Tu <char style="add">sei</char> il mio Dio, io ti celebrerò;</para>
  <para style="q" vid="PSA 118:28">
    <char style="add">Tu sei</char> il mio Dio, io ti esalterò.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29"/>Celebrate il Signore; perciocchè <char style="add">egli è</char> buono,</para>
  <para style="q" vid="PSA 118:29">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">SALMO CXIX</para>
  <para style="s1">Eccellenza della Legge di Dio, e felicità di quelli che l'osservano</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1"/>BEATI coloro che sono intieri di via<note caller="*" style="x"><char style="xo" closed="false">119.1 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="GEN 17:1">Gen. 17.1</ref>. <ref loc="PRO 11:20">Prov. 11.20</ref>; <ref loc="PRO 13:6">13.6</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:1">Che camminano nella Legge del Signore<note caller="*" style="x"><char style="xo" closed="false">119.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 128:1">Sal. 128.1</ref>.</char></note>.<verse eid="PSA 119:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2"/>Beati coloro che guardano le sue testimonianze,</para>
  <para style="q" vid="PSA 119:2">Che lo cercano con tutto il cuore<note caller="*" style="x"><char style="xo" closed="false">119.2 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="2CH 15:2">2 Cron. 15.2</ref>.</char></note>;<verse eid="PSA 119:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3"/>
    <char style="add">I quali</char> eziandio non operano iniquità<note caller="*" style="x"><char style="xo" closed="false">119.3 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="1JN 3:9">1 Giov. 3.9</ref>; <ref loc="1JN 5:18">5.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:3">
    <char style="add">Anzi</char> camminano nelle sue vie.<verse eid="PSA 119:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4"/>Tu hai ordinato che i tuoi comandamenti</para>
  <para style="q" vid="PSA 119:4">Sieno strettamente osservati.<verse eid="PSA 119:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5"/>Oh! sieno pure addirizzate le mie vie,</para>
  <para style="q" vid="PSA 119:5">Per osservare i tuoi statuti<note caller="*" style="x"><char style="xo" closed="false">119.5 </char><char style="xk" closed="false">statuti </char><char style="xt" closed="false"><ref loc="JER 10:23">Ger. 10.23</ref>.</char></note>.<verse eid="PSA 119:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6"/>Allora io non sarò svergognato<note caller="*" style="x"><char style="xo" closed="false">119.6 </char><char style="xk" closed="false">svergognato </char><char style="xt" closed="false"><ref loc="JOB 22:26">Giob. 22.26</ref>. <ref loc="1JN 2:28">1 Giov. 2.28</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:6">Quando io riguarderò a tutti i tuoi comandamenti.<verse eid="PSA 119:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7"/>Io ti celebrerò con dirittura di cuore,</para>
  <para style="q" vid="PSA 119:7">Quando io avrò imparate le leggi della tua giustizia.<verse eid="PSA 119:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8"/>Io osserverò i tuoi statuti;</para>
  <para style="q" vid="PSA 119:8">Non abbandonarmi del tutto.<verse eid="PSA 119:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9"/>Come renderà il fanciullo la sua via pura<note caller="*" style="x"><char style="xo" closed="false">119.9 </char><char style="xk" closed="false">pura </char><char style="xt" closed="false"><ref loc="PSA 25:7">Sal. 25.7</ref>.</char></note>?</para>
  <para style="q" vid="PSA 119:9">Prendendo guardia <char style="add">ad essa</char> secondo la tua parola.<verse eid="PSA 119:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10"/>Io ti ho cercato con tutto il mio cuore<note caller="*" style="x"><char style="xo" closed="false">119.10 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="2CH 15:15">2 Cron. 15.15</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:10">Non lasciarmi deviar da' tuoi comandamenti.<verse eid="PSA 119:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11"/>Io ho riposta la tua parola nel mio cuore<note caller="*" style="x"><char style="xo" closed="false">119.11 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="PSA 37:31">Sal. 37.31</ref>. <ref loc="LUK 2:19">Luc. 2.19</ref>,<ref loc="LUK 2:51">51</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:11">Acciocchè io non pecchi contro a te.<verse eid="PSA 119:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12"/>Tu <char style="add">sei</char> benedetto, o Signore;</para>
  <para style="q" vid="PSA 119:12">Insegnami i tuoi statuti<note caller="*" style="x"><char style="xo" closed="false">119.12 </char><char style="xk" closed="false">statuti </char><char style="xt" closed="false"><ref loc="PSA 25:4">Sal. 25.4</ref>,<ref loc="PSA 25:8">8</ref>; <ref loc="PSA 27:11">27.11</ref>.</char></note>.<verse eid="PSA 119:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13"/>Io ho colle mie labbra raccontate</para>
  <para style="q" vid="PSA 119:13">Tutte le leggi della tua bocca.<verse eid="PSA 119:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14"/>Io gioisco nella via delle tue testimonianze,</para>
  <para style="q" vid="PSA 119:14">Come per tutte le ricchezze <char style="add">del mondo</char>.<verse eid="PSA 119:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15"/>Io ragiono de' tuoi comandamenti,</para>
  <para style="q" vid="PSA 119:15">E riguardo a' tuoi sentieri.<verse eid="PSA 119:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16"/>Io mi diletto ne' tuoi statuti<note caller="*" style="x"><char style="xo" closed="false">119.16 </char><char style="xk" closed="false">statuti </char><char style="xt" closed="false"><ref loc="PSA 1:2">Sal. 1.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:16">Io non dimenticherò le tue parole.<verse eid="PSA 119:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17"/>Fa' del bene al tuo servitore,</para>
  <para style="q" vid="PSA 119:17">Ed io viverò, ed osserverò la tua parola.<verse eid="PSA 119:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18"/>Apri gli occhi miei, ed io riguarderò</para>
  <para style="q" vid="PSA 119:18">Le maraviglie della tua Legge.<verse eid="PSA 119:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19"/>Io <char style="add">son</char> forestiere in terra<note caller="*" style="x"><char style="xo" closed="false">119.19 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="GEN 47:9">Gen. 47.9</ref>. <ref loc="1CH 29:15">1 Cron. 29.15</ref>. <ref loc="2CO 5:6">2 Cor. 5.6</ref>. <ref loc="HEB 11:13">Ebr. 11.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:19">Non nascondermi i tuoi comandamenti.<verse eid="PSA 119:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20"/>L'anima mia si stritola di affezione</para>
  <para style="q" vid="PSA 119:20">Alle tue leggi in ogni tempo<note caller="*" style="x"><char style="xo" closed="false">119.20 </char><char style="xk" closed="false">tempo </char><char style="xt" closed="false"><ref loc="PSA 42:1">Sal. 42.1</ref>,<ref loc="PSA 42:2">2</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 119:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21"/>Tu sgridi i superbi maledetti</para>
  <para style="q" vid="PSA 119:21">Che deviano da' tuoi comandamenti.<verse eid="PSA 119:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22"/>Togli d'addosso a me il vituperio e lo sprezzo;</para>
  <para style="q" vid="PSA 119:22">Perciocchè io ho guardate le tue testimonianze.<verse eid="PSA 119:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23"/>Eziandio, <char style="add">mentre</char> i principi sedevano, e ragionavano contro a me,</para>
  <para style="q" vid="PSA 119:23">Il tuo servitore ha meditato ne' tuoi statuti.<verse eid="PSA 119:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24"/>Ed anche le tue testimonianze <char style="add">sono</char> i miei diletti</para>
  <para style="q" vid="PSA 119:24">
    <char style="add">Ed</char> i miei consiglieri.<verse eid="PSA 119:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25"/>L'anima mia è attaccata alla polvere;</para>
  <para style="q" vid="PSA 119:25">Vivificami secondo la tua parola.<verse eid="PSA 119:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26"/>Io <char style="add">ti</char> ho narrate le mie vie, e tu mi hai risposto;</para>
  <para style="q" vid="PSA 119:26">Insegnami i tuoi statuti<note caller="*" style="x"><char style="xo" closed="false">119.26 </char><char style="xk" closed="false">statuti </char><char style="xt" closed="false"><ref loc="PSA 25:4">Sal. 25.4</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 119:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27"/>Fammi intender la via de' tuoi comandamenti,</para>
  <para style="q" vid="PSA 119:27">Ed io ragionerò delle tue maraviglie.<verse eid="PSA 119:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28"/>L'anima mia stilla di cordoglio;</para>
  <para style="q" vid="PSA 119:28">Sollevami secondo le tue parole.<verse eid="PSA 119:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29"/>Rimuovi da me la via della menzogna;</para>
  <para style="q" vid="PSA 119:29">E fammi dono della tua Legge.<verse eid="PSA 119:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30"/>Io ho scelta la via della verità;</para>
  <para style="q" vid="PSA 119:30">Io <char style="add">mi</char> son proposte le tue leggi.<verse eid="PSA 119:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31"/>Io mi son tenuto alle tue testimonianze;</para>
  <para style="q" vid="PSA 119:31">Signore, non lasciar che io sia confuso.<verse eid="PSA 119:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32"/>Correrò nella via de' tuoi comandamenti,</para>
  <para style="q" vid="PSA 119:32">Quando tu mi avrai allargato il cuore.<verse eid="PSA 119:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33"/>Insegnami, Signore, la via de' tuoi statuti;</para>
  <para style="q" vid="PSA 119:33">Ed io la guarderò <char style="add">infino</char> al fine<note caller="*" style="x"><char style="xo" closed="false">119.33 </char><char style="xk" closed="false">fine </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat. 10.22</ref>. <ref loc="HEB 3:6">Ebr. 3.6</ref>. <ref loc="REV 2:26">Apoc. 2.26</ref>.</char></note>.<verse eid="PSA 119:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34"/>Dammi intelletto<note caller="*" style="x"><char style="xo" closed="false">119.34 </char><char style="xk" closed="false">intelletto </char><char style="xt" closed="false"><ref loc="PRO 2:6">Prov. 2.6</ref>. <ref loc="JAS 1:5">Giac. 1.5</ref>.</char></note>, ed io guarderò la tua Legge;</para>
  <para style="q" vid="PSA 119:34">E l'osserverò con tutto il cuore.<verse eid="PSA 119:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35"/>Conducimi per lo sentiero de' tuoi comandamenti;</para>
  <para style="q" vid="PSA 119:35">Perciocchè io mi diletto in esso<note caller="*" style="x"><char style="xo" closed="false">119.35 </char><char style="xk" closed="false">esso </char><char style="xt" closed="false"><ref loc="PSA 1:2">Sal. 1.2</ref>; <ref loc="PSA 112:1">112.1</ref>.</char></note>.<verse eid="PSA 119:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36"/>Inchina il mio cuore alle tue testimonianze,</para>
  <para style="q" vid="PSA 119:36">E non a cupidigia<note caller="*" style="x"><char style="xo" closed="false">119.36 </char><char style="xk" closed="false">cupidigia </char><char style="xt" closed="false"><ref loc="LUK 12:15">Luc. 12.15</ref>. <ref loc="1TI 6:10">1 Tim. 6.10</ref>.</char></note>.<verse eid="PSA 119:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37"/>Storna gli occhi miei, che non riguardino a vanità;</para>
  <para style="q" vid="PSA 119:37">Vivificami nelle tue vie.<verse eid="PSA 119:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38"/>Attieni la tua parola al tuo servitore,</para>
  <para style="q" vid="PSA 119:38">Il quale <char style="add">è tutto</char> intento al tuo timore.<verse eid="PSA 119:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39"/>Rimuovi <char style="add">da me</char> il mio vituperio, del quale io temo;</para>
  <para style="q" vid="PSA 119:39">Perciocchè le tue leggi <char style="add">son</char> buone.<verse eid="PSA 119:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40"/>Ecco, io desidero affettuosamente i tuoi comandamenti;</para>
  <para style="q" vid="PSA 119:40">Vivificami nella tua giustizia.<verse eid="PSA 119:40"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41"/>Ed avvenganmi le tue benignità, o Signore;</para>
  <para style="q" vid="PSA 119:41">
    <char style="add">E</char> la tua salute, secondo la tua parola.<verse eid="PSA 119:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42"/>Ed io risponderò a colui che mi fa vituperio;</para>
  <para style="q" vid="PSA 119:42">Perciocchè io mi confido nella tua parola.<verse eid="PSA 119:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43"/>E non ritrarmi del tutto dalla bocca la parola della verità;</para>
  <para style="q" vid="PSA 119:43">Perciocchè io spero nelle tue leggi.<verse eid="PSA 119:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44"/>Ed io osserverò la tua Legge del continuo,</para>
  <para style="q" vid="PSA 119:44">In sempiterno.<verse eid="PSA 119:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45"/>E camminerò al largo;</para>
  <para style="q" vid="PSA 119:45">Perciocchè io ho ricercati i tuoi comandamenti.<verse eid="PSA 119:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46"/>E parlerò delle tue testimonianze davanti ai re<note caller="*" style="x"><char style="xo" closed="false">119.46 </char><char style="xk" closed="false">re </char><char style="xt" closed="false"><ref loc="MAT 10:18">Mat. 10.18</ref>,<ref loc="MAT 10:19">19</ref>. <ref loc="ACT 26:1">Fat. 26.1</ref>,<ref loc="ACT 26:2">2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:46">E non sarò svergognato.<verse eid="PSA 119:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47"/>E mi diletterò ne' tuoi comandamenti,</para>
  <para style="q" vid="PSA 119:47">I quali io amo.<verse eid="PSA 119:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48"/>Ed alzerò le palme delle mie mani a' tuoi comandamenti, i quali io amo;</para>
  <para style="q" vid="PSA 119:48">E mediterò ne' tuoi statuti.<verse eid="PSA 119:48"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49"/>Ricordati della parola <char style="add">detta</char> al tuo servitore,</para>
  <para style="q" vid="PSA 119:49">Sopra la quale tu mi hai fatto sperare.<verse eid="PSA 119:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50"/>Questa <char style="add">è</char> la mia consolazione nella mia afflizione,</para>
  <para style="q" vid="PSA 119:50">Che la tua parola mi ha vivificato.<verse eid="PSA 119:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51"/>I superbi mi hanno grandemente schernito;</para>
  <para style="q" vid="PSA 119:51">
    <char style="add">Ma</char> io non mi sono stornato dalla tua Legge.<verse eid="PSA 119:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52"/>Signore, io mi son ricordato de' tuoi giudicii ab antico;</para>
  <para style="q" vid="PSA 119:52">E mi son consolato.<verse eid="PSA 119:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53"/>Tremito mi occupa, per gli empi</para>
  <para style="q" vid="PSA 119:53">Che abbandonano la tua Legge<note caller="*" style="x"><char style="xo" closed="false">119.53 </char><char style="xk" closed="false">Legge </char><char style="xt" closed="false"><ref loc="EZR 9:1-3">Esd. 9.1-3</ref>.</char></note>.<verse eid="PSA 119:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54"/>I tuoi statuti sono stati i miei cantici</para>
  <para style="q" vid="PSA 119:54">Nella dimora de' miei pellegrinaggi.<verse eid="PSA 119:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55"/>O Signore, di notte io mi son ricordato del tuo Nome,</para>
  <para style="q" vid="PSA 119:55">Ed ho osservata la tua Legge.<verse eid="PSA 119:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56"/>Questo mi è avvenuto,</para>
  <para style="q" vid="PSA 119:56">Perciocchè io ho guardati i tuoi comandamenti.<verse eid="PSA 119:56"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57"/>Il Signore <char style="add">è</char> la mia parte<note caller="*" style="x"><char style="xo" closed="false">119.57 </char><char style="xk" closed="false">parte </char><char style="xt" closed="false"><ref loc="PSA 16:5">Sal. 16.5</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 119:57">Io ho detto di osservare le tue parole.<verse eid="PSA 119:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58"/>Io ti ho supplicato con tutto il cuore;</para>
  <para style="q" vid="PSA 119:58">Abbi pietà di me, secondo la tua parola.<verse eid="PSA 119:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59"/>Io ho fatta ragione delle mie vie<note caller="*" style="x"><char style="xo" closed="false">119.59 </char><char style="xk" closed="false">vie </char><char style="xt" closed="false"><ref loc="LUK 15:17">Luc. 15.17</ref>,<ref loc="LUK 15:18">18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:59">Ed ho rivolti i miei piedi alle tue testimonianze.<verse eid="PSA 119:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60"/>Io mi sono affrettato, e non mi sono indugiato</para>
  <para style="q" vid="PSA 119:60">D'osservare i tuoi comandamenti.<verse eid="PSA 119:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61"/>Schiere d'empi mi hanno predato;</para>
  <para style="q" vid="PSA 119:61">
    <char style="add">Ma però</char> non ho dimenticata la tua Legge.<verse eid="PSA 119:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62"/>Io mi levo a mezzanotte, per celebrarti<note caller="*" style="x"><char style="xo" closed="false">119.62 </char><char style="xk" closed="false">celebrarti </char><char style="xt" closed="false"><ref loc="ACT 16:25">Fat. 16.25</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:62">Per le leggi della tua giustizia.<verse eid="PSA 119:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63"/>Io <char style="add">son</char> compagno di tutti quelli che ti temono,</para>
  <para style="q" vid="PSA 119:63">Ed osservano i tuoi comandamenti.<verse eid="PSA 119:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64"/>Signore, la terra è piena della tua benignità;</para>
  <para style="q" vid="PSA 119:64">Insegnami i tuoi statuti.<verse eid="PSA 119:64"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65"/>Signore, tu hai usata beneficenza inverso il tuo servitore,</para>
  <para style="q" vid="PSA 119:65">Secondo la tua parola.<verse eid="PSA 119:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66"/>Insegnami buon senno ed intendimento;</para>
  <para style="q" vid="PSA 119:66">Perciocchè io credo a' tuoi comandamenti.<verse eid="PSA 119:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67"/>Avanti che io fossi afflitto, io andava errando<note caller="*" style="x"><char style="xo" closed="false">119.67 </char><char style="xk" closed="false">errando </char><char style="xt" closed="false"><ref loc="HEB 12:10">Ebr. 12.10</ref>,<ref loc="HEB 12:11">11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:67">Ma ora osservo la tua parola.<verse eid="PSA 119:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68"/>Tu <char style="add">sei</char> buono<note caller="*" style="x"><char style="xo" closed="false">119.68 </char><char style="xk" closed="false">buono </char><char style="xt" closed="false"><ref loc="PSA 106:1">Sal. 106.1</ref> </char><char style="xta" closed="false">e rif.</char></note> e benefattore;</para>
  <para style="q" vid="PSA 119:68">Insegnami i tuoi statuti.<verse eid="PSA 119:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69"/>I superbi hanno acconciate delle bugie contro a me;</para>
  <para style="q" vid="PSA 119:69">
    <char style="add">Ma</char> io con tutto il cuore guarderò i tuoi comandamenti.<verse eid="PSA 119:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70"/>Il cuor loro è condenso come grasso<note caller="*" style="x"><char style="xo" closed="false">119.70 </char><char style="xk" closed="false">grasso </char><char style="xt" closed="false"><ref loc="ISA 6:10">Is. 6.10</ref>. <ref loc="ACT 28:27">Fat. 28.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:70">
    <char style="add">Ma</char> io mi diletto nella tua Legge.<verse eid="PSA 119:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71"/>Egli <char style="add">è stato</char> buono per me, che io sono stato afflitto<note caller="*" style="x"><char style="xo" closed="false">119.71 </char><char style="xk" closed="false">afflitto </char><char style="xt" closed="false"><ref loc="HEB 12:10">Ebr. 12.10</ref>,<ref loc="HEB 12:11">11</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:71">Acciocchè io impari i tuoi statuti.<verse eid="PSA 119:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72"/>La Legge della tua bocca mi <char style="add">è</char> migliore</para>
  <para style="q" vid="PSA 119:72">Che le migliaia d'oro e d'argento<note caller="*" style="x"><char style="xo" closed="false">119.72 </char><char style="xk" closed="false">argento </char><char style="xt" closed="false"><ref loc="PSA 19:10">Sal. 19.10</ref>. <ref loc="PRO 8:10">Prov. 8.10</ref>,<ref loc="PRO 8:11">11</ref>.</char></note>.<verse eid="PSA 119:72"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73"/>Le tue mani mi hanno fatto e formato<note caller="*" style="x"><char style="xo" closed="false">119.73 </char><char style="xk" closed="false">formato </char><char style="xt" closed="false"><ref loc="PSA 100:3">Sal. 100.3</ref> e rif.; <ref loc="PSA 139:14">139.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:73">Dammi intelletto, ed io imparerò i tuoi comandamenti.<verse eid="PSA 119:73"/></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74"/>Quelli che ti temono mi vedranno, e si rallegreranno;</para>
  <para style="q" vid="PSA 119:74">Perciocchè io ho sperato nella tua parola.<verse eid="PSA 119:74"/></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75"/>O Signore, io so che i tuoi giudicii <char style="add">non sono altro che</char> giustizia;</para>
  <para style="q" vid="PSA 119:75">E <char style="add">che ciò che</char> mi hai afflitto <char style="add">è stato</char> fedeltà.<verse eid="PSA 119:75"/></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76"/>Deh! <char style="add">sia</char> la tua benignità per consolarmi,</para>
  <para style="q" vid="PSA 119:76">Secondo la tua parola, <char style="add">detta</char> al tuo servitore.<verse eid="PSA 119:76"/></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77"/>Avvenganmi le tue misericordie, acciocchè io viva;</para>
  <para style="p" vid="PSA 119:77">Perciocchè la tua Legge <char style="add">è</char> ogni mio diletto.<verse eid="PSA 119:77"/></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78"/>Sien confusi i superbi, perciocchè a torto mi sovvertono;</para>
  <para style="q" vid="PSA 119:78">
    <char style="add">Ma</char> io medito ne' tuoi comandamenti.<verse eid="PSA 119:78"/></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79"/>Rivolgansi a me quelli che ti temono.</para>
  <para style="q" vid="PSA 119:79">E quelli che conoscono le tue testimonianze.<verse eid="PSA 119:79"/></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80"/>Sia il mio cuore intiero ne' tuoi statuti;</para>
  <para style="q" vid="PSA 119:80">Acciocchè io non sia confuso.<verse eid="PSA 119:80"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81"/>L'anima mia vien meno dietro alla tua salute;</para>
  <para style="q" vid="PSA 119:81">Io spero nella tua parola.<verse eid="PSA 119:81"/></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82"/>Gli occhi miei vengono meno dietro alla tua parola,</para>
  <para style="q" vid="PSA 119:82">Dicendo: Quando mi consolerai tu?<verse eid="PSA 119:82"/></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83"/>Perciocchè io son divenuto come un otro al fumo;</para>
  <para style="q" vid="PSA 119:83">E <char style="add">pur</char> non ho dimenticati i tuoi statuti.<verse eid="PSA 119:83"/></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84"/>Quanti <char style="add">hanno da essere</char> i giorni del tuo servitore<note caller="*" style="x"><char style="xo" closed="false">119.84 </char><char style="xk" closed="false">servitore </char><char style="xt" closed="false"><ref loc="PSA 39:4">Sal. 39.4</ref>.</char></note>?</para>
  <para style="q" vid="PSA 119:84">Quando farai giudicio sopra quelli che mi perseguitano<note caller="*" style="x"><char style="xo" closed="false">119.84 </char><char style="xk" closed="false">perseguitano </char><char style="xt" closed="false"><ref loc="REV 6:10">Apoc. 6.10</ref>.</char></note>?<verse eid="PSA 119:84"/></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85"/>I superbi mi hanno cavate delle fosse<note caller="*" style="x"><char style="xo" closed="false">119.85 </char><char style="xk" closed="false">fosse </char><char style="xt" closed="false"><ref loc="PSA 35:7">Sal. 35.7</ref>,<ref loc="PSA 35:8">8</ref>. <ref loc="PRO 16:27">Prov. 16.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:85">Il che non <char style="add">è</char> secondo la tua Legge.<verse eid="PSA 119:85"/></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86"/>Tutti i tuoi comandamenti <char style="add">son</char> verità;</para>
  <para style="q" vid="PSA 119:86">Essi mi perseguitano a torto; soccorrimi.<verse eid="PSA 119:86"/></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87"/>Mi hanno pressochè distrutto ed atterrato;</para>
  <para style="q" vid="PSA 119:87">
    <char style="add">Ma</char> io non ho abbandonati i tuoi comandamenti.<verse eid="PSA 119:87"/></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88"/>Vivificami secondo la tua benignità,</para>
  <para style="q" vid="PSA 119:88">Ed io osserverò la testimonianza della tua bocca.<verse eid="PSA 119:88"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89"/>O Signore, la tua parola <char style="add">è</char> in eterno;</para>
  <para style="q" vid="PSA 119:89">Ella è stabile ne' cieli<note caller="*" style="x"><char style="xo" closed="false">119.89 </char><char style="xk" closed="false">cieli </char><char style="xt" closed="false"><ref loc="MAT 24:34">Mat. 24.34</ref>,<ref loc="MAT 24:35">35</ref>. <ref loc="1PE 1:25">1 Piet. 1.25</ref>.</char></note>.<verse eid="PSA 119:89"/></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90"/>La tua verità <char style="add">è</char> per ogni età;</para>
  <para style="q" vid="PSA 119:90">Tu hai stabilita la terra, ed ella sta ferma.<verse eid="PSA 119:90"/></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91"/>
    <char style="add">Il cielo e la terra</char> stanno anche oggi fermi, per li tuoi ordini<note caller="*" style="x"><char style="xo" closed="false">119.91 </char><char style="xk" closed="false">ordini </char><char style="xt" closed="false"><ref loc="JER 33:25">Ger. 33.25</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:91">Perciocchè ogni cosa <char style="add">è</char> al tuo servigio.<verse eid="PSA 119:91"/></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92"/>Se la tua Legge <char style="add">non fosse stata</char> ogni mio diletto,</para>
  <para style="q" vid="PSA 119:92">Io già sarei perito nella mia afflizione.<verse eid="PSA 119:92"/></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93"/>Giammai non dimenticherò i tuoi comandamenti;</para>
  <para style="q" vid="PSA 119:93">Perciocchè per essi tu mi hai vivificato.<verse eid="PSA 119:93"/></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94"/>Io <char style="add">son</char> tuo, salvami;</para>
  <para style="q" vid="PSA 119:94">Perciocchè io ho ricercati i tuoi comandamenti.<verse eid="PSA 119:94"/></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95"/>Gli empi mi hanno atteso, per farmi perire;</para>
  <para style="q" vid="PSA 119:95">
    <char style="add">Ma</char> io ho considerate le tue testimonianze.<verse eid="PSA 119:95"/></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96"/>Io ho veduto che tutte le cose le più perfette hanno fine;</para>
  <para style="q" vid="PSA 119:96">Ma il tuo comandamento <char style="add">è</char> d'una grandissima distesa<note caller="*" style="x"><char style="xo" closed="false">119.96 </char><char style="xk" closed="false">distesa </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mat. 5.18</ref>; <ref loc="MAT 24:35">24.35</ref>.</char></note>.<verse eid="PSA 119:96"/></para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97"/>Oh! quanto amo la tua Legge!</para>
  <para style="q" vid="PSA 119:97">Ella <char style="add">è</char> la mia meditazione di tutti i giorni<note caller="*" style="x"><char style="xo" closed="false">119.97 </char><char style="xk" closed="false">giorni </char><char style="xt" closed="false"><ref loc="PSA 1:2">Sal. 1.2</ref>.</char></note>.<verse eid="PSA 119:97"/></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98"/>
    <char style="add">Per</char> li tuoi comandamenti tu mi rendi più savio che i miei nemici<note caller="*" style="x"><char style="xo" closed="false">119.98 </char><char style="xk" closed="false">nemici </char><char style="xt" closed="false"><ref loc="DEU 4:6">Deut. 4.6</ref>,<ref loc="DEU 4:8">8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:98">Perciocchè <char style="add">quelli</char> in perpetuo <char style="add">sono</char> miei.<verse eid="PSA 119:98"/></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99"/>Io son più intendente che tutti i miei dottori;</para>
  <para style="q" vid="PSA 119:99">Perciocchè le tue testimonianze <char style="add">son</char> la mia meditazione<note caller="*" style="x"><char style="xo" closed="false">119.99 </char><char style="xk" closed="false">meditazione </char><char style="xt" closed="false"><ref loc="2TI 3:15">2 Tim. 3.15</ref>.</char></note>.<verse eid="PSA 119:99"/></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100"/>Io son più avveduto che i vecchi<note caller="*" style="x"><char style="xo" closed="false">119.100 </char><char style="xk" closed="false">vecchi </char><char style="xt" closed="false"><ref loc="JOB 32:7-9">Giob. 32.7-9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:100">Perciocchè io ho guardati i tuoi comandamenti.<verse eid="PSA 119:100"/></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101"/>Io ho rattenuti i miei piedi da ogni sentiero malvagio<note caller="*" style="x"><char style="xo" closed="false">119.101 </char><char style="xk" closed="false">malvagio </char><char style="xt" closed="false"><ref loc="PRO 1:15">Prov. 1.15</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:101">Acciocchè io osservi la tua parola.<verse eid="PSA 119:101"/></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102"/>Io non mi sono stornato dalle tue leggi;</para>
  <para style="q" vid="PSA 119:102">Perciocchè tu mi hai ammaestrato.<verse eid="PSA 119:102"/></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103"/>Oh! quanto son dolci le tue parole al mio palato<note caller="*" style="x"><char style="xo" closed="false">119.103 </char><char style="xk" closed="false">palato </char><char style="xt" closed="false"><ref loc="PSA 19:10">Sal. 19.10</ref>. <ref loc="PRO 8:11">Prov. 8.11</ref>.</char></note>!</para>
  <para style="q" vid="PSA 119:103">
    <char style="add">Son più dolci</char> che miele alla mia bocca.<verse eid="PSA 119:103"/></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104"/>Io son divenuto avveduto per li tuoi comandamenti;</para>
  <para style="q" vid="PSA 119:104">Perciò, odio ogni sentiero di falsità.<verse eid="PSA 119:104"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105"/>La tua parola <char style="add">è</char> una lampana al mio piè,</para>
  <para style="q" vid="PSA 119:105">Ed un lume al mio sentiero<note caller="*" style="x"><char style="xo" closed="false">119.105 </char><char style="xk" closed="false">sentiero </char><char style="xt" closed="false"><ref loc="PRO 6:23">Prov. 6.23</ref>.</char></note>.<verse eid="PSA 119:105"/></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106"/>Io ho giurato, e l'atterrò,</para>
  <para style="q" vid="PSA 119:106">Di osservare le leggi della tua giustizia.<verse eid="PSA 119:106"/></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107"/>Io son sommamente afflitto;</para>
  <para style="q" vid="PSA 119:107">O Signore, vivificami secondo la tua parola.<verse eid="PSA 119:107"/></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108"/>Deh! Signore, gradisci le offerte volontarie della mia bocca<note caller="*" style="x"><char style="xo" closed="false">119.108 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="HEB 13:15">Ebr. 13.15</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:108">Ed insegnami le tue leggi.<verse eid="PSA 119:108"/></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109"/>Io ho l'anima mia del continuo in palma di mano;</para>
  <para style="q" vid="PSA 119:109">E pur non ho dimenticata la tua Legge.<verse eid="PSA 119:109"/></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110"/>Gli empi mi hanno tesi de' lacci;</para>
  <para style="q" vid="PSA 119:110">E pur non mi sono sviato da' tuoi comandamenti.<verse eid="PSA 119:110"/></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111"/>Le tue testimonianze <char style="add">son</char> la mia eredità in perpetuo<note caller="*" style="x"><char style="xo" closed="false">119.111 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"><ref loc="DEU 33:4">Deut. 33.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:111">Perciocchè esse <char style="add">son</char> la letizia del mio cuore.<verse eid="PSA 119:111"/></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112"/>Io ho inchinato il mio cuore a mettere in opera i tuoi statuti,</para>
  <para style="q" vid="PSA 119:112">In perpetuo, infino al fine.<verse eid="PSA 119:112"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113"/>Io odio i discorsi;</para>
  <para style="q" vid="PSA 119:113">Ma amo la tua Legge.<verse eid="PSA 119:113"/></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114"/>Tu <char style="add">sei</char> il mio nascondimento<note caller="*" style="x"><char style="xo" closed="false">119.114 </char><char style="xk" closed="false">nascondimento </char><char style="xt" closed="false"><ref loc="PSA 32:7">Sal. 32.7</ref>; <ref loc="PSA 91:1">91.1</ref>.</char></note>, ed il mio scudo;</para>
  <para style="q" vid="PSA 119:114">Io spero nella tua parola.<verse eid="PSA 119:114"/></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115"/>Ritraetevi da me, maligni<note caller="*" style="x"><char style="xo" closed="false">119.115 </char><char style="xk" closed="false">maligni </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat. 7.23</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:115">Ed io guarderò i comandamenti del mio Dio.<verse eid="PSA 119:115"/></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116"/>Sostienmi, secondo la tua parola, ed io viverò;</para>
  <para style="q" vid="PSA 119:116">E non rendermi confuso della mia speranza<note caller="*" style="x"><char style="xo" closed="false">119.116 </char><char style="xk" closed="false">speranza </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> e rif. <ref loc="ROM 5:5">Rom. 5.5</ref>; <ref loc="ROM 9:33">9.33</ref>; <ref loc="ROM 10:11">10.11</ref>.</char></note>.<verse eid="PSA 119:116"/></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117"/>Confortami, ed io sarò salvato;</para>
  <para style="q" vid="PSA 119:117">E riguarderò del continuo a' tuoi statuti.<verse eid="PSA 119:117"/></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118"/>Tu calpesti tutti quelli che si sviano da' tuoi statuti;</para>
  <para style="q" vid="PSA 119:118">Perciocchè la lor frode <char style="add">è</char> una cosa falsa.<verse eid="PSA 119:118"/></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119"/>Tu riduci al niente tutti gli empi della terra, <char style="add">come</char> schiume;</para>
  <para style="q" vid="PSA 119:119">Perciò io amo le tue testimonianze.<verse eid="PSA 119:119"/></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120"/>La mia carne si raccapriccia tutta per lo spavento di te;</para>
  <para style="q" vid="PSA 119:120">Ed io temo de' tuoi giudicii.<verse eid="PSA 119:120"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121"/>Io ho fatto ciò che è diritto e giusto;</para>
  <para style="q" vid="PSA 119:121">Non abbandonarmi a quelli che mi oppressano.<verse eid="PSA 119:121"/></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122"/>Da' sicurtà per lo tuo servitore in bene<note caller="*" style="x"><char style="xo" closed="false">119.122 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="HEB 7:22">Ebr. 7.22</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:122">
    <char style="add">E</char> non <char style="add">lasciar</char> che i superbi mi oppressino.<verse eid="PSA 119:122"/></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123"/>Gli occhi miei vengono meno dietro alla tua salute,</para>
  <para style="q" vid="PSA 119:123">Ed alla parola della tua giustizia.<verse eid="PSA 119:123"/></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124"/>Opera inverso il tuo servitore secondo la tua benignità,</para>
  <para style="q" vid="PSA 119:124">Ed insegnami i tuoi statuti.<verse eid="PSA 119:124"/></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125"/>Io <char style="add">son</char> tuo servitore; dammi intelletto;</para>
  <para style="q" vid="PSA 119:125">Acciocchè io possa conoscere le tue testimonianze.<verse eid="PSA 119:125"/></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126"/>
    <char style="add">Egli è</char> tempo che il Signore operi;</para>
  <para style="q" vid="PSA 119:126">Essi hanno annullata la tua Legge.<verse eid="PSA 119:126"/></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127"/>Perciò io amo i tuoi comandamenti più che oro;</para>
  <para style="q" vid="PSA 119:127">Anzi più che oro finissimo<note caller="*" style="x"><char style="xo" closed="false">119.127 </char><char style="xk" closed="false">finissimo </char><char style="xt" closed="false"><ref loc="PSA 19:10">Sal. 19.10</ref>. <ref loc="PRO 8:11">Prov. 8.11</ref>.</char></note>.<verse eid="PSA 119:127"/></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128"/>Perciò approvo, come diritti, tutti i tuoi comandamenti intorno ad ogni cosa;</para>
  <para style="q" vid="PSA 119:128">
    <char style="add">Ed</char> odio ogni sentiero di menzogna.<verse eid="PSA 119:128"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129"/>Le tue testimonianze <char style="add">son</char> cose maravigliose;</para>
  <para style="q" vid="PSA 119:129">Perciò l'anima mia le ha guardate.<verse eid="PSA 119:129"/></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130"/>La dichiarazione delle tue parole allumina,</para>
  <para style="q" vid="PSA 119:130">
    <char style="add">E</char> dà intelletto a' semplici<note caller="*" style="x"><char style="xo" closed="false">119.130 </char><char style="xk" closed="false">semplici </char><char style="xt" closed="false"><ref loc="PSA 19:7">Sal. 19.7</ref>. <ref loc="PRO 1:4">Prov. 1.4</ref>.</char></note>.<verse eid="PSA 119:130"/></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131"/>Io ho aperta la bocca, ed ho ansato;</para>
  <para style="q" vid="PSA 119:131">Perciocchè io ho bramati i tuoi comandamenti.<verse eid="PSA 119:131"/></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132"/>Riguarda a me, ed abbi pietà di me,</para>
  <para style="q" vid="PSA 119:132">Secondo ch'è ragionevole <char style="add">di fare</char> inverso quelli che amano il tuo Nome<note caller="*" style="x"><char style="xo" closed="false">119.132 </char><char style="xk" closed="false">Nome </char><char style="xt" closed="false"><ref loc="2TH 1:6">2 Tess. 1.6</ref>,<ref loc="2TH 1:7">7</ref>.</char></note>.<verse eid="PSA 119:132"/></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133"/>Ferma i miei passi nella tua parola<note caller="*" style="x"><char style="xo" closed="false">119.133 </char><char style="xk" closed="false">parola </char><char style="xt" closed="false"><ref loc="PSA 17:5">Sal. 17.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:133">E non <char style="add">lasciare</char> che alcuna iniquità signoreggi sopra me<note caller="*" style="x"><char style="xo" closed="false">119.133 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="ROM 6:12">Rom. 6.12</ref> ecc.</char></note>.<verse eid="PSA 119:133"/></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134"/>Riscuotimi dall'oppressione degli uomini<note caller="*" style="x"><char style="xo" closed="false">119.134 </char><char style="xk" closed="false">uomini </char><char style="xt" closed="false"><ref loc="LUK 1:74">Luc. 1.74</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:134">Ed io osserverò i tuoi comandamenti.<verse eid="PSA 119:134"/></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135"/>Fa' rilucere il tuo volto sopra il tuo servitore<note caller="*" style="x"><char style="xo" closed="false">119.135 </char><char style="xk" closed="false">servitore </char><char style="xt" closed="false"><ref loc="NUM 6:25">Num. 6.25</ref>. <ref loc="PSA 4:6">Sal. 4.6</ref>.</char></note>;<verse eid="PSA 119:135"/></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136"/>Ed insegnami i tuoi statuti.</para>
  <para style="q" vid="PSA 119:136">Ruscelli d'acque mi scendono giù dagli occhi<note caller="*" style="x"><char style="xo" closed="false">119.136 </char><char style="xk" closed="false">occhi </char><char style="xt" closed="false"><ref loc="EZK 9:4">Ezec. 9.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:136">Perciocchè la tua Legge non è osservata.<verse eid="PSA 119:136"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137"/>O Signore, tu <char style="add">sei</char> giusto<note caller="*" style="x"><char style="xo" closed="false">119.137 </char><char style="xk" closed="false">giusto </char><char style="xt" closed="false"><ref loc="EZR 9:15">Esd. 9.15</ref>. <ref loc="JER 12:1">Ger. 12.1</ref>. <ref loc="DAN 9:7">Dan. 9.7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 119:137">E i tuoi giudicii <char style="add">son</char> diritti.<verse eid="PSA 119:137"/></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138"/>Tu hai strettamente comandata la giustizia,</para>
  <para style="q" vid="PSA 119:138">E la verità delle tue testimonianze<note caller="*" style="x"><char style="xo" closed="false">119.138 </char><char style="xk" closed="false">testimonianze </char><char style="xt" closed="false"><ref loc="PSA 19:7-9">Sal. 19.7-9</ref>.</char></note>.<verse eid="PSA 119:138"/></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139"/>Il mio zelo mi consuma<note caller="*" style="x"><char style="xo" closed="false">119.139 </char><char style="xk" closed="false">consuma </char><char style="xt" closed="false"><ref loc="PSA 69:9">Sal. 69.9</ref>. <ref loc="JHN 2:17">Giov. 2.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:139">Perciocchè i miei nemici hanno dimenticate le tue parole.<verse eid="PSA 119:139"/></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140"/>La tua parola <char style="add">è</char> sommamente purgata<note caller="*" style="x"><char style="xo" closed="false">119.140 </char><char style="xk" closed="false">purgata </char><char style="xt" closed="false"><ref loc="PSA 12:6">Sal. 12.6</ref>; <ref loc="PSA 18:29">18.29</ref>. <ref loc="PRO 30:5">Prov. 30.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:140">E però il tuo servitore l'ama.<verse eid="PSA 119:140"/></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141"/>Io <char style="add">son</char> piccolo e sprezzato;</para>
  <para style="q" vid="PSA 119:141">
    <char style="add">Ma però</char> non ho dimenticati i tuoi comandamenti.<verse eid="PSA 119:141"/></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142"/>La tua giustizia <char style="add">è</char> una giustizia eterna,</para>
  <para style="q" vid="PSA 119:142">E la tua Legge <char style="add">è</char> verità<note caller="*" style="x"><char style="xo" closed="false">119.142 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="PSA 19:9">Sal. 19.9</ref>. <ref loc="JHN 17:17">Giov. 17.17</ref>.</char></note>.<verse eid="PSA 119:142"/></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143"/>Tribolazione e distretta mi hanno colto;</para>
  <para style="q" vid="PSA 119:143">
    <char style="add">Ma</char> i tuoi comandamenti <char style="add">sono</char> i miei diletti.<verse eid="PSA 119:143"/></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144"/>Le tue testimonianze sono una giustizia eterna;</para>
  <para style="q" vid="PSA 119:144">Dammi intelletto, ed io viverò.<verse eid="PSA 119:144"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145"/>Io ho gridato con tutto il cuore; rispondimi, Signore;</para>
  <para style="q" vid="PSA 119:145">
    <char style="add">Ed</char> io guarderò i tuoi statuti.<verse eid="PSA 119:145"/></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146"/>Io ti ho invocato; salvami,</para>
  <para style="q" vid="PSA 119:146">Ed io osserverò le tue testimonianze.<verse eid="PSA 119:146"/></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147"/>Io mi son fatto avanti all'alba<note caller="*" style="x"><char style="xo" closed="false">119.147 </char><char style="xk" closed="false">alba </char><char style="xt" closed="false"><ref loc="PSA 5:3">Sal. 5.3</ref>; <ref loc="PSA 88:13">88.13</ref>.</char></note>, ed ho gridato;</para>
  <para style="q" vid="PSA 119:147">Io ho sperato nella tua parola.<verse eid="PSA 119:147"/></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148"/>Gli occhi miei prevengono le vigilie <char style="add">della notte</char>.</para>
  <para style="q" vid="PSA 119:148">Per meditar nella tua parola<note caller="*" style="x"><char style="xo" closed="false">119.148 </char><char style="xk" closed="false">parola </char><char style="xt" closed="false"><ref loc="PSA 63:1">Sal. 63.1</ref>,<ref loc="PSA 63:6">6</ref>.</char></note>.<verse eid="PSA 119:148"/></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149"/>Ascolta la mia voce, secondo la tua benignità;</para>
  <para style="q" vid="PSA 119:149">O Signore, vivificami, secondo che tu hai ordinato.<verse eid="PSA 119:149"/></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150"/>Quelli che vanno dietro a scelleratezza,</para>
  <para style="q" vid="PSA 119:150">E si sono allontanati dalla tua Legge, si sono accostati <char style="add">a me</char>.<verse eid="PSA 119:150"/></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151"/>O Signore, tu <char style="add">sei</char> vicino<note caller="*" style="x"><char style="xo" closed="false">119.151 </char><char style="xk" closed="false">vicino </char><char style="xt" closed="false"><ref loc="PSA 145:18">Sal. 145.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:151">E tutti i tuoi comandamenti <char style="add">son</char> verità.<verse eid="PSA 119:151"/></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152"/>Gran tempo è che io so <char style="add">questo</char> delle tue testimonianze,</para>
  <para style="q" vid="PSA 119:152">Che tu le hai stabilite in eterno<note caller="*" style="x"><char style="xo" closed="false">119.152 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="LUK 21:33">Luc. 21.33</ref>.</char></note>.<verse eid="PSA 119:152"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153"/>Riguarda alla mia afflizione, e tramme<char style="add">ne</char> fuori;</para>
  <para style="q" vid="PSA 119:153">Perciocchè io non ho dimenticata la tua Legge.<verse eid="PSA 119:153"/></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154"/>Dibatti la mia lite<note caller="*" style="x"><char style="xo" closed="false">119.154 </char><char style="xk" closed="false">lite </char><char style="xt" closed="false"><ref loc="1SA 24:16">1 Sam. 24.16</ref>. <ref loc="PSA 35:1">Sal. 35.1</ref>.</char></note>, e riscuotimi;</para>
  <para style="q" vid="PSA 119:154">Vivificami, secondo la tua parola.<verse eid="PSA 119:154"/></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155"/>La salute <char style="add">è</char> lungi dagli empi;</para>
  <para style="q" vid="PSA 119:155">Perciocchè non ricercano i tuoi statuti.<verse eid="PSA 119:155"/></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156"/>Le tue misericordie <char style="add">son</char> grandi, Signore<note caller="*" style="x"><char style="xo" closed="false">119.156 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="2SA 24:14">2 Sam. 24.14</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:156">Vivificami secondo ciò che hai ordinato.<verse eid="PSA 119:156"/></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157"/>I miei persecutori ed i miei nemici <char style="add">son</char> molti;</para>
  <para style="q" vid="PSA 119:157">
    <char style="add">Ma</char> io non mi sono deviato dalle tue testimonianze.<verse eid="PSA 119:157"/></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158"/>Io ho veduti i disleali, e ne ho sentita gran noia<note caller="*" style="x"><char style="xo" closed="false">119.158 </char><char style="xk" closed="false">noia </char><char style="xt" closed="false"><ref loc="PSA 139:21">Sal. 139.21</ref>. <ref loc="EZK 9:4">Ezec. 9.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:158">Perciocchè non osservano la tua parola.<verse eid="PSA 119:158"/></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159"/>Vedi quanto amo i tuoi comandamenti!</para>
  <para style="q" vid="PSA 119:159">Signore, vivificami, secondo la tua benignità.<verse eid="PSA 119:159"/></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160"/>La somma della tua parola <char style="add">è</char> verità;</para>
  <para style="q" vid="PSA 119:160">E tutte le leggi della tua giustizia <char style="add">sono</char> in eterno.<verse eid="PSA 119:160"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161"/>I principi m'hanno perseguitato senza cagione;</para>
  <para style="q" vid="PSA 119:161">Ma il mio cuore ha spavento della tua parola.<verse eid="PSA 119:161"/></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162"/>Io mi rallegro per la tua parola,</para>
  <para style="q" vid="PSA 119:162">Come una persona che avesse trovate grandi spoglie.<verse eid="PSA 119:162"/></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163"/>Io odio ed abbomino la menzogna;</para>
  <para style="q" vid="PSA 119:163">
    <char style="add">Ma</char> io amo la tua Legge.<verse eid="PSA 119:163"/></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164"/>Io ti lodo sette volte il dì,</para>
  <para style="q" vid="PSA 119:164">Per li giudicii della tua giustizia.<verse eid="PSA 119:164"/></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165"/>Quelli che amano la tua Legge godono di molta pace<note caller="*" style="x"><char style="xo" closed="false">119.165 </char><char style="xk" closed="false">pace </char><char style="xt" closed="false"><ref loc="PRO 3:1">Prov. 3.1</ref>,<ref loc="PRO 3:2">2</ref>. <ref loc="ISA 32:17">Is. 32.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:165">E non <char style="add">vi è</char> alcuno intoppo per loro.<verse eid="PSA 119:165"/></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166"/>Signore, io ho sperato nella tua salute<note caller="*" style="x"><char style="xo" closed="false">119.166 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="GEN 49:18">Gen. 49.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 119:166">Ed ho messi in opera i tuoi comandamenti.<verse eid="PSA 119:166"/></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167"/>L'anima mia ha osservate le tue testimonianze;</para>
  <para style="q" vid="PSA 119:167">Ed io le ho grandemente amate.<verse eid="PSA 119:167"/></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168"/>Io ho osservati i tuoi comandamenti, e le tue testimonianze;</para>
  <para style="q" vid="PSA 119:168">Perciocchè tutte le mie vie <char style="add">sono</char> nel tuo cospetto<note caller="*" style="x"><char style="xo" closed="false">119.168 </char><char style="xk" closed="false">cospetto </char><char style="xt" closed="false"><ref loc="PRO 5:21">Prov. 5.21</ref>.</char></note>.<verse eid="PSA 119:168"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169"/>Pervenga il mio grido al tuo cospetto, o Signore;</para>
  <para style="q" vid="PSA 119:169">Dammi intelletto, secondo la tua parola.<verse eid="PSA 119:169"/></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170"/>Venga la mia supplicazione in tua presenza;</para>
  <para style="q" vid="PSA 119:170">Riscuotimi, secondo la tua parola.<verse eid="PSA 119:170"/></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171"/>Le mie labbra sgorgheranno lode,</para>
  <para style="q" vid="PSA 119:171">Quando tu mi avrai insegnati i tuoi statuti.<verse eid="PSA 119:171"/></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172"/>La mia lingua ragionerà della tua parola;</para>
  <para style="q" vid="PSA 119:172">Perciocchè tutti i tuoi comandamenti <char style="add">son</char> giustizia.<verse eid="PSA 119:172"/></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173"/>Siami in aiuto la tua mano;</para>
  <para style="q" vid="PSA 119:173">Perciocchè io ho eletti i tuoi comandamenti<note caller="*" style="x"><char style="xo" closed="false">119.173 </char><char style="xk" closed="false">comandamenti </char><char style="xt" closed="false"><ref loc="LUK 10:42">Luc. 10.42</ref>.</char></note>.<verse eid="PSA 119:173"/></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174"/>Signore, io ho desiderata la tua salute;</para>
  <para style="q" vid="PSA 119:174">E la tua Legge <char style="add">è</char> ogni mio diletto.<verse eid="PSA 119:174"/></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175"/>Viva l'anima mia, ed ella ti loderà;</para>
  <para style="q" vid="PSA 119:175">E soccorranmi i tuoi ordinamenti.<verse eid="PSA 119:175"/></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176"/>Io vo errando, come una pecora smarrita<note caller="*" style="x"><char style="xo" closed="false">119.176 </char><char style="xk" closed="false">smarrita </char><char style="xt" closed="false"><ref loc="ISA 53:6">Is. 53.6</ref>. <ref loc="LUK 15:4">Luc. 15.4</ref> ecc. <ref loc="1PE 2:25">1 Piet. 2.25</ref>.</char></note>; cerca il tuo servitore;</para>
  <para style="q" vid="PSA 119:176">Perciocchè io non ho dimenticati i tuoi comandamenti.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">SALMO CXX</para>
  <para style="s1">Preghiera per venir liberato dalle frodi e dalle calunnie</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1"/>IO ho gridato al Signore<note caller="*" style="x"><char style="xo" closed="false">120.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 118:5">Sal. 118.5</ref>. <ref loc="JON 2:2">Gion. 2.2</ref> ecc.</char></note>, quando sono stato in distretta,</para>
  <para style="q" vid="PSA 120:1">Ed egli mi ha risposto.<verse eid="PSA 120:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2"/>O Signore, riscuoti l'anima mia dalle labbra bugiarde,</para>
  <para style="q" vid="PSA 120:2">E dalla lingua frodolente.<verse eid="PSA 120:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3"/>Che ti darà, e che ti aggiungerà</para>
  <para style="q" vid="PSA 120:3">La lingua frodolente?<verse eid="PSA 120:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4"/>
    <char style="add">Ella è simile a</char> saette acute, <char style="add">tratte</char> da un uomo prode;</para>
  <para style="q" vid="PSA 120:4">Ovvero anche a brace di ginepro.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5"/>Ahimè! che soggiorno in Mesec,</para>
  <para style="q" vid="PSA 120:5">
    <char style="add">E</char> dimoro presso alle tende di Chedar!<verse eid="PSA 120:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6"/>La mia persona è <char style="add">omai</char> assai dimorata</para>
  <para style="q" vid="PSA 120:6">Con quelli che odiano la pace.<verse eid="PSA 120:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7"/>Io <char style="add">sono uomo di</char> pace; ma, quando <char style="add">ne</char> parlo,</para>
  <para style="q" vid="PSA 120:7">Essi <char style="add">gridano</char> alla guerra.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">SALMO CXXI</para>
  <para style="s1">Dio è fedele guardiano del suo popolo</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1"/>IO alzo gli occhi a' monti<note caller="*" style="x"><char style="xo" closed="false">121.1 </char><char style="xk" closed="false">monti </char><char style="xt" closed="false"><ref loc="PSA 87:1">Sal. 87.1</ref>; <ref loc="PSA 123:1">123.1</ref>.</char></note>,</para>
  <para style="q" vid="PSA 121:1">
    <char style="add">Per vedere</char> onde mi verrà aiuto.<verse eid="PSA 121:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2"/>Il mio aiuto <char style="add">verrà</char> dal Signore</para>
  <para style="q" vid="PSA 121:2">Che ha fatto il cielo e la terra<note caller="*" style="x"><char style="xo" closed="false">121.2 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 124:8">Sal. 124.8</ref>.</char></note>.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3"/>Egli non permetterà che il tuo piè vacilli<note caller="*" style="x"><char style="xo" closed="false">121.3 </char><char style="xk" closed="false">vacilli </char><char style="xt" closed="false"><ref loc="1SA 2:9">1 Sam. 2.9</ref>. <ref loc="PRO 3:23">Prov. 3.23</ref>,<ref loc="PRO 3:26">26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 121:3">Il tuo Guardiano<note caller="*" style="x"><char style="xo" closed="false">121.3 </char><char style="xk" closed="false">Guardiano </char><char style="xt" closed="false"><ref loc="PSA 127:1">Sal. 127.1</ref>. <ref loc="ISA 27:3">Is. 27.3</ref>.</char></note> non sonnecchia.<verse eid="PSA 121:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4"/>Ecco, il Guardiano d'Israele</para>
  <para style="q" vid="PSA 121:4">Non sonnecchia, e non dorme.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5"/>Il Signore <char style="add">è</char> quel che ti guarda;</para>
  <para style="q" vid="PSA 121:5">Il Signore <char style="add">è</char> la tua ombra<note caller="*" style="x"><char style="xo" closed="false">121.5 </char><char style="xk" closed="false">ombra </char><char style="xt" closed="false"><ref loc="PSA 91:1">Sal. 91.1</ref>. <ref loc="ISA 25:4">Is. 25.4</ref>.</char></note>, <char style="add">egli è</char> alla tua man destra<note caller="*" style="x"><char style="xo" closed="false">121.5 </char><char style="xk" closed="false">destra </char><char style="xt" closed="false"><ref loc="PSA 16:8">Sal. 16.8</ref>; <ref loc="PSA 109:31">109.31</ref>.</char></note>.<verse eid="PSA 121:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6"/>Di giorno il sole non ti ferirà<note caller="*" style="x"><char style="xo" closed="false">121.6 </char><char style="xk" closed="false">ferirà </char><char style="xt" closed="false"><ref loc="ISA 49:10">Is. 49.10</ref>. <ref loc="REV 7:16">Apoc. 7.16</ref>.</char></note>,</para>
  <para style="q" vid="PSA 121:6">Nè la luna di notte.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7"/>Il Signore ti guarderà d'ogni male;</para>
  <para style="q" vid="PSA 121:7">Egli guarderà l'anima tua<note caller="*" style="x"><char style="xo" closed="false">121.7 </char><char style="xk" closed="false">tua </char><char style="xt" closed="false"><ref loc="PSA 97:10">Sal. 97.10</ref>; <ref loc="PSA 145:20">145.20</ref>.</char></note>.<verse eid="PSA 121:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8"/>Il Signore guarderà la tua uscita e la tua entrata,</para>
  <para style="q" vid="PSA 121:8">Da ora, e fino in eterno.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">SALMO CXXII</para>
  <para style="s1">Preghiera per la pace di Gerusalemme</para>
  <para style="d">Cantico di Maalot, di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1"/>IO mi son rallegrato di ciò che mi è stato detto:</para>
  <para style="q" vid="PSA 122:1">Andiamo alla Casa del Signore<note caller="*" style="x"><char style="xo" closed="false">122.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="ISA 2:3">Is. 2.3</ref>. <ref loc="ZEC 8:21">Zac. 8.21</ref>.</char></note>.<verse eid="PSA 122:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2"/>O Gerusalemme,</para>
  <para style="q" vid="PSA 122:2">I nostri piedi son fermi nelle tue porte.<verse eid="PSA 122:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3"/>Gerusalemme, che sei edificata</para>
  <para style="q" vid="PSA 122:3">Come una città che è ben congiunta insieme.<verse eid="PSA 122:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4"/>Là ove salgono le tribù, le tribù del Signore<note caller="*" style="x"><char style="xo" closed="false">122.4 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="EXO 23:17">Esod. 23.17</ref>. <ref loc="DEU 16:16">Deut. 16.16</ref>.</char></note>,</para>
  <para style="q" vid="PSA 122:4">Alla Testimonianza d'Israele<note caller="*" style="x"><char style="xo" closed="false">122.4 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="EXO 16:34">Esod. 16.34</ref>. <ref loc="PSA 81:5">Sal. 81.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 122:4">Per celebrare il Nome del Signore,<verse eid="PSA 122:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5"/>Perciocchè quivi son posti i seggi per lo giudicio<note caller="*" style="x"><char style="xo" closed="false">122.5 </char><char style="xk" closed="false">giudicio </char><char style="xt" closed="false"><ref loc="DEU 17:8">Deut. 17.8</ref>. <ref loc="2CH 19:8">2 Cron. 19.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 122:5">I seggi della Casa di Davide.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6"/>Richiedete la pace di Gerusalemme<note caller="*" style="x"><char style="xo" closed="false">122.6 </char><char style="xk" closed="false">Gerusalemme </char><char style="xt" closed="false"><ref loc="PSA 51:18">Sal. 51.18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 122:6">
    <char style="add">O Gerusalemme</char>, prosperino quelli che ti amano.<verse eid="PSA 122:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7"/>Pace sia nelle tue fortezze,</para>
  <para style="q" vid="PSA 122:7">E tranquillità ne' tuoi palazzi.<verse eid="PSA 122:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8"/>Per amor de' miei fratelli e de' miei prossimi,</para>
  <para style="q" vid="PSA 122:8">Io dirò ora: Pace <char style="add">sia</char> in te.<verse eid="PSA 122:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9"/>Per amor della Casa del Signore Iddio nostro,</para>
  <para style="q" vid="PSA 122:9">Io procaccerò il tuo bene<note caller="*" style="x"><char style="xo" closed="false">122.9 </char><char style="xk" closed="false">bene </char><char style="xt" closed="false"><ref loc="NEH 2:10">Neem. 2.10</ref>. <ref loc="EST 10:3">Est. 10.3</ref>.</char></note>.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">SALMO CXXIII</para>
  <para style="s1">Preghiera del fedele disprezzato</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1"/>IO alzo gli occhi miei a te<note caller="*" style="x"><char style="xo" closed="false">123.1 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 121:1">Sal. 121.1</ref>; <ref loc="PSA 141:8">141.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 123:1">Che abiti ne' cieli<note caller="*" style="x"><char style="xo" closed="false">123.1 </char><char style="xk" closed="false">cieli </char><char style="xt" closed="false"><ref loc="PSA 2:4">Sal. 2.4</ref>; <ref loc="PSA 11:4">11.4</ref>; <ref loc="PSA 115:3">115.3</ref>.</char></note>.<verse eid="PSA 123:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2"/>Ecco, come i servi <char style="add">hanno</char> gli occhi alla mano de' lor padroni;</para>
  <para style="q" vid="PSA 123:2">Come la serva <char style="add">ha</char> gli occhi alla mano della sua padrona,</para>
  <para style="q" vid="PSA 123:2">Così noi <char style="add">abbiamo</char> gli occhi nostri al Signore Iddio nostro,</para>
  <para style="q" vid="PSA 123:2">Infino a tanto ch'egli abbia pietà di noi.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3"/>Abbi pietà di noi, Signore, abbi pietà di noi;</para>
  <para style="q" vid="PSA 123:3">Perciocchè noi siamo molto sazii di disprezzo<note caller="*" style="x"><char style="xo" closed="false">123.3 </char><char style="xk" closed="false">disprezzo </char><char style="xt" closed="false"><ref loc="NEH 2:19">Neem. 2.19</ref>; <ref loc="NEH 4:4">4.4</ref>.</char></note>.<verse eid="PSA 123:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4"/>L'anima nostra è grandemente sazia</para>
  <para style="q" vid="PSA 123:4">Dello scherno degli <char style="add">uomini</char> agiati, dello sprezzo degli altieri.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">SALMO CXXIV</para>
  <para style="s1">Dio solo ha liberato il suo popolo</para>
  <para style="d">Cantico di Maalot, di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1"/>DICA pure ora Israele:</para>
  <para style="q" vid="PSA 124:1">Se non che il Signore fu per noi;<verse eid="PSA 124:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2"/>Se non che il Signore fu per noi,</para>
  <para style="q" vid="PSA 124:2">Quando gli uomini si levarono contro a noi;<verse eid="PSA 124:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3"/>Essi ci avrebbero tranghiottiti tutti vivi,</para>
  <para style="q" vid="PSA 124:3">Allora che l'ira loro ardeva contro a noi;<verse eid="PSA 124:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4"/>Allora le acque ci avrebbero inondati;</para>
  <para style="q" vid="PSA 124:4">Il torrente sarebbe passato sopra l'anima nostra;<verse eid="PSA 124:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5"/>Allora le acque gonfiate</para>
  <para style="q" vid="PSA 124:5">Sarebbero passate sopra l'anima nostra.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6"/>Benedetto <char style="add">sia</char> il Signore,</para>
  <para style="q" vid="PSA 124:6">Che non ci ha dati in preda a' lor denti.<verse eid="PSA 124:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7"/>L'anima nostra è scampata dal laccio degli uccellatori, come un uccelletto;</para>
  <para style="q" vid="PSA 124:7">Il laccio è stato rotto, e noi siamo scampati.<verse eid="PSA 124:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8"/>Il nostro aiuto <char style="add">è</char> nel Nome del Signore<note caller="*" style="x"><char style="xo" closed="false">124.8 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 121:2">Sal. 121.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 124:8">Che ha fatto il cielo e la terra<note caller="*" style="x"><char style="xo" closed="false">124.8 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="GEN 1:1">Gen. 1.1</ref>. <ref loc="PSA 134:3">Sal. 134.3</ref>.</char></note>.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">SALMO CXXV</para>
  <para style="s1">Sicurtà di chi fida in Dio</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1"/>QUELLI che si confidano nel Signore<note caller="*" style="x"><char style="xo" closed="false">125.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 125:1">
    <char style="add">Son</char> come il monte di Sion, <char style="add">il quale</char> non può essere smosso,</para>
  <para style="q" vid="PSA 125:1">E che dimora in perpetuo.<verse eid="PSA 125:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2"/>
    <char style="add">Come</char> Gerusalemme è intorniata di monti,</para>
  <para style="q" vid="PSA 125:2">Così il Signore <char style="add">è</char> intorno al suo popolo<note caller="*" style="x"><char style="xo" closed="false">125.2 </char><char style="xk" closed="false">popolo </char><char style="xt" closed="false"><ref loc="ZEC 2:5">Zac. 2.5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 125:2">Da ora in eterno.<verse eid="PSA 125:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3"/>Perciocchè la verga d'empietà non riposerà <char style="add">in perpetuo</char></para>
  <para style="q" vid="PSA 125:3">Sopra la sorte de' giusti;</para>
  <para style="q" vid="PSA 125:3">Acciocchè talora i giusti non mettano le lor mani ad alcuna iniquità.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4"/>O Signore, fa' bene a' buoni,</para>
  <para style="q" vid="PSA 125:4">Ed a quelli che son diritti ne' lor cuori.<verse eid="PSA 125:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5"/>Ma, quant'è a quelli che deviano dietro alle loro obliquità,</para>
  <para style="q" vid="PSA 125:5">Scaccili il Signore con gli operatori d'iniquità.</para>
  <para style="q" vid="PSA 125:5">Pace <char style="add">sia</char> sopra Israele<note caller="*" style="x"><char style="xo" closed="false">125.5 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="PSA 128:6">Sal. 128.6</ref>. <ref loc="GAL 6:16">Gal. 6.16</ref>.</char></note>.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">SALMO CXXVI</para>
  <para style="s1">Lode a Dio per aver ritratto il suo popolo dalla cattività</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1"/>QUANDO il Signore ritrasse Sion di cattività,</para>
  <para style="q" vid="PSA 126:1">Egli ci pareva di sognare<note caller="*" style="x"><char style="xo" closed="false">126.1 </char><char style="xk" closed="false">sognare </char><char style="xt" closed="false"><ref loc="PSA 53:6">Sal. 53.6</ref>; <ref loc="PSA 85:1">85.1</ref>.</char></note>.<verse eid="PSA 126:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2"/>Allora fu ripiena la nostra bocca di riso,</para>
  <para style="q" vid="PSA 126:2">E la nostra lingua di giubilo;</para>
  <para style="q" vid="PSA 126:2">Allora fu detto fra le nazioni:</para>
  <para style="q" vid="PSA 126:2">Il Signore ha fatte cose grandi inverso costoro.<verse eid="PSA 126:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3"/>Il Signore ha fatte cose grandi inverso noi;</para>
  <para style="q" vid="PSA 126:3">Noi siamo stati ripieni di letizia.<verse eid="PSA 126:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4"/>Signore, ritiraci di cattività;</para>
  <para style="q" vid="PSA 126:4">
    <char style="add">Il che sarà</char> come correnti rivi in terra meridionale<note caller="*" style="x"><char style="xo" closed="false">126.4 </char><char style="xk" closed="false">meridionale </char><char style="xt" closed="false"><ref loc="JDG 1:15">Giud. 1.15</ref>.</char></note>.<verse eid="PSA 126:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5"/>Quelli che seminano con lagrime,</para>
  <para style="q" vid="PSA 126:5">Mieteranno con canti<note caller="*" style="x"><char style="xo" closed="false">126.5 </char><char style="xk" closed="false">canti </char><char style="xt" closed="false"><ref loc="JER 31:9">Ger. 31.9</ref> ecc.</char></note>.<verse eid="PSA 126:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6"/>Ben vanno piangendo, mentre portano la semenza comprata a prezzo;</para>
  <para style="q" vid="PSA 126:6">
    <char style="add">Ma</char> certo torneranno con canti, portando i lor fasci.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">SALMO CXXVII</para>
  <para style="s1">La sicurezza, la prosperità e la prole vengono da Dio solo</para>
  <para style="d">Cantico di Maalot, di Salomone</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1"/>SE il Signore non edifica la casa,</para>
  <para style="q" vid="PSA 127:1">In vano vi si affaticano gli edificatori;</para>
  <para style="q" vid="PSA 127:1">Se il Signore non guarda la città<note caller="*" style="x"><char style="xo" closed="false">127.1 </char><char style="xk" closed="false">città </char><char style="xt" closed="false"><ref loc="PSA 121:3-5">Sal. 121.3-5</ref>.</char></note>,</para>
  <para style="q" vid="PSA 127:1">In vano vegghiano le guardie.<verse eid="PSA 127:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2"/>
    <char style="add">Voi</char> che vi levate la mattina a buon'ora, <char style="add">e</char> tardi vi posate,</para>
  <para style="q" vid="PSA 127:2">
    <char style="add">E</char> mangiate il pane di doglie<note caller="*" style="x"><char style="xo" closed="false">127.2 </char><char style="xk" closed="false">doglie </char><char style="xt" closed="false"><ref loc="GEN 3:17">Gen. 3.17</ref>,<ref loc="GEN 3:19">19</ref>.</char></note>, in vano <char style="add">il fate</char>;</para>
  <para style="q" vid="PSA 127:2">In luogo di ciò, Iddio dà il sonno a colui ch'egli ama.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3"/>Ecco, i figliuoli <char style="add">sono</char> una eredità del Signore<note caller="*" style="x"><char style="xo" closed="false">127.3 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="GEN 33:5">Gen. 33.5</ref>; <ref loc="GEN 48:4">48.4</ref>. <ref loc="JOS 24:3">Gios. 24.3</ref>,<ref loc="JOS 24:4">4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 127:3">Il frutto del ventre <char style="add">è</char> un premio.<verse eid="PSA 127:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4"/>Quali <char style="add">son</char> le saette in mano d'un valent'<char style="add">uomo</char>,</para>
  <para style="q" vid="PSA 127:4">Tali <char style="add">sono</char> i figliuoli in giovanezza.<verse eid="PSA 127:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5"/>Beato l'uomo che ne ha il suo turcasso pieno;</para>
  <para style="q" vid="PSA 127:5">
    <char style="add">Tali</char> non saranno confusi,</para>
  <para style="q" vid="PSA 127:5">Quando parleranno co' <char style="add">lor</char> nemici nella porta.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">SALMO CXXVIII</para>
  <para style="s1">Chi teme Iddio sarà benedetto nella sua famiglia</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1"/>BEATO chiunque teme il Signore<note caller="*" style="x"><char style="xo" closed="false">128.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 112:1">Sal. 112.1</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 128:1">
    <char style="add">E</char> cammina nelle sue vie<note caller="*" style="x"><char style="xo" closed="false">128.1 </char><char style="xk" closed="false">vie </char><char style="xt" closed="false"><ref loc="PSA 119:1">Sal. 119.1</ref>. <ref loc="PRO 8:32">Prov. 8.32</ref>.</char></note>.<verse eid="PSA 128:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2"/>Perciocchè tu mangerai della fatica delle tue mani<note caller="*" style="x"><char style="xo" closed="false">128.2 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="ISA 3:10">Is. 3.10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 128:2">Tu <char style="add">sarai</char> beato, ed egli ti <char style="add">sarà</char> bene.<verse eid="PSA 128:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3"/>La tua moglie <char style="add">sarà</char> dentro della tua casa</para>
  <para style="q" vid="PSA 128:3">Come una vigna fruttifera;</para>
  <para style="q" vid="PSA 128:3">I tuoi figliuoli <char style="add">saranno</char> d'intorno alla tua tavola,</para>
  <para style="q" vid="PSA 128:3">Come piante novelle di ulivi<note caller="*" style="x"><char style="xo" closed="false">128.3 </char><char style="xk" closed="false">ulivi </char><char style="xt" closed="false"><ref loc="PSA 144:12">Sal. 144.12</ref>.</char></note>.<verse eid="PSA 128:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4"/>Ecco, certamente così sarà benedetto</para>
  <para style="q" vid="PSA 128:4">L'uomo che teme il Signore.<verse eid="PSA 128:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5"/>Il Signore ti benedirà di Sion;</para>
  <para style="q" vid="PSA 128:5">E tu vedrai il bene di Gerusalemme</para>
  <para style="q" vid="PSA 128:5">Tutti i giorni della tua vita;<verse eid="PSA 128:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6"/>E vedrai i figliuoli de' tuoi figliuoli<note caller="*" style="x"><char style="xo" closed="false">128.6 </char><char style="xk" closed="false">figliuoli </char><char style="xt" closed="false"><ref loc="GEN 50:23">Gen. 50.23</ref>. <ref loc="JOB 42:16">Giob. 42.16</ref>.</char></note>.</para>
  <para style="q" vid="PSA 128:6">Pace <char style="add">sia</char> sopra Israele<note caller="*" style="x"><char style="xo" closed="false">128.6 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="PSA 125:5">Sal. 125.5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">SALMO CXXIX</para>
  <para style="s1">La chiesa perseguitata, ma non distrutta</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1"/>OR dica Israele:</para>
  <para style="q" vid="PSA 129:1">Mi hanno molte volte assalito dalla mia fanciullezza<note caller="*" style="x"><char style="xo" closed="false">129.1 </char><char style="xk" closed="false">fanciullezza </char><char style="xt" closed="false"><ref loc="HOS 11:1">Os. 11.1</ref>.</char></note>;<verse eid="PSA 129:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2"/>Mi hanno spesse volte assalito dalla mia fanciullezza;</para>
  <para style="q" vid="PSA 129:2">
    <char style="add">E pure</char> ancora non hanno potuto vincermi<note caller="*" style="x"><char style="xo" closed="false">129.2 </char><char style="xk" closed="false">vincermi </char><char style="xt" closed="false"><ref loc="2CO 4:8-10">2 Cor. 4.8-10</ref>.</char></note>.<verse eid="PSA 129:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3"/>Degli aratori hanno arato sopra il mio dosso;</para>
  <para style="q" vid="PSA 129:3">
    <char style="add">V</char>'hanno tirati i lor solchi.<verse eid="PSA 129:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4"/>Il Signore <char style="add">è</char> giusto;</para>
  <para style="q" vid="PSA 129:4">Egli ha tagliate le funi degli empi.<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5"/>Tutti quelli che odiano Sion</para>
  <para style="q" vid="PSA 129:5">Sieno confusi, e voltin le spalle.<verse eid="PSA 129:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6"/>Sieno come l'erba de' tetti,</para>
  <para style="q" vid="PSA 129:6">Che si secca avanti che sia tratta<note caller="*" style="x"><char style="xo" closed="false">129.6 </char><char style="xk" closed="false">tratta </char><char style="xt" closed="false"><ref loc="PSA 37:2">Sal. 37.2</ref>.</char></note>;<verse eid="PSA 129:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7"/>Della quale il mietitore non empie la sua mano,</para>
  <para style="q" vid="PSA 129:7">Nè il suo grembo colui che lega le manelle;<verse eid="PSA 129:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8"/>
    <char style="add">Per la quale</char> eziandio i passanti non dicono:</para>
  <para style="q" vid="PSA 129:8">La benedizione del Signore <char style="add">sia</char> sopra voi;</para>
  <para style="q" vid="PSA 129:8">Noi vi benediciamo nel Nome del Signore<note caller="*" style="x"><char style="xo" closed="false">129.8 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="RUT 2:4">Rut 2.4</ref>. <ref loc="PSA 118:26">Sal. 118.26</ref>.</char></note>.<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">SALMO CXXX</para>
  <para style="s1">Confessione dei peccati. Domanda di perdono</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1"/>SIGNORE, io grido a te di luoghi profondi<note caller="*" style="x"><char style="xo" closed="false">130.1 </char><char style="xk" closed="false">profondi </char><char style="xt" closed="false"><ref loc="JON 2:2">Gion. 2.2</ref>.</char></note>.<verse eid="PSA 130:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2"/>Signore, ascolta il mio grido;</para>
  <para style="q" vid="PSA 130:2">Sieno le tue orecchie attente</para>
  <para style="q" vid="PSA 130:2">Alla voce delle mie supplicazioni.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3"/>Signore, se tu poni mente alle iniquità,</para>
  <para style="q" vid="PSA 130:3">Chi potrà durare, o Signore<note caller="*" style="x"><char style="xo" closed="false">130.3 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 143:2">Sal. 143.2</ref>. <ref loc="ROM 3:20">Rom. 3.20</ref>,<ref loc="ROM 3:23">23</ref>,<ref loc="ROM 3:24">24</ref>.</char></note>?<verse eid="PSA 130:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4"/>Ma appo te <char style="add">vi è</char> perdono<note caller="*" style="x"><char style="xo" closed="false">130.4 </char><char style="xk" closed="false">perdono </char><char style="xt" closed="false"><ref loc="EXO 34:6">Esod. 34.6</ref>,<ref loc="EXO 34:7">7</ref> </char><char style="xta" closed="false">e rif.</char></note>,</para>
  <para style="q" vid="PSA 130:4">Acciocchè tu sii temuto<note caller="*" style="x"><char style="xo" closed="false">130.4 </char><char style="xk" closed="false">temuto </char><char style="xt" closed="false"><ref loc="1KI 8:39">1 Re. 8.39</ref>,<ref loc="1KI 8:40">40</ref>. <ref loc="PSA 2:11">Sal. 2.11</ref>. <ref loc="JER 33:8">Ger. 33.8</ref>,<ref loc="JER 33:9">9</ref>.</char></note>.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5"/>Io ho aspettato il Signore<note caller="*" style="x"><char style="xo" closed="false">130.5 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 40:1">Sal. 40.1</ref> e rif. <ref loc="ISA 8:17">Is. 8.17</ref>.</char></note>; l'anima mia <char style="add">l</char>'ha aspettato,</para>
  <para style="q" vid="PSA 130:5">Ed io ho sperato nella sua parola.<verse eid="PSA 130:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6"/>L'anima mia riguarda al Signore,</para>
  <para style="q" vid="PSA 130:6">Più che le guardie <char style="add">non riguardano</char> alla mattina,</para>
  <para style="q" vid="PSA 130:6">Stando a guardar <char style="add">quando verrà</char> la mattina.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7"/>Aspetti Israele il Signore;</para>
  <para style="q" vid="PSA 130:7">Perciocchè appo il Signore <char style="add">vi è</char> benignità,</para>
  <para style="q" vid="PSA 130:7">E molta redenzione<note caller="*" style="x"><char style="xo" closed="false">130.7 </char><char style="xk" closed="false">redenzione </char><char style="xt" closed="false"><ref loc="PSA 86:5">Sal. 86.5</ref>,<ref loc="PSA 86:15">15</ref>. <ref loc="ISA 55:7">Is. 55.7</ref>.</char></note>.<verse eid="PSA 130:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8"/>Ed egli riscatterà Israele</para>
  <para style="q" vid="PSA 130:8">Di tutte le sue iniquità<note caller="*" style="x"><char style="xo" closed="false">130.8 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 103:3">Sal. 103.3</ref>,<ref loc="PSA 103:4">4</ref>. <ref loc="MAT 1:21">Mat. 1.21</ref>.</char></note>.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">SALMO CXXXI</para>
  <para style="s1">Umiltà del Salmista</para>
  <para style="d">Cantico di Maalot, di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1"/>SIGNORE, il mio cuore non è elevato, e gli occhi miei non sono altieri;</para>
  <para style="q" vid="PSA 131:1">E non cammino in cose più grandi,</para>
  <para style="q" vid="PSA 131:1">E più ardue che a me non si conviene<note caller="*" style="x"><char style="xo" closed="false">131.1 </char><char style="xk" closed="false">conviene </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rom. 12.16</ref>.</char></note>,<verse eid="PSA 131:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2"/>Se non ho composta ed acchetata l'anima mia,</para>
  <para style="q" vid="PSA 131:2">A guisa di fanciullo novellamente spoppato appresso sua madre;</para>
  <para style="q" vid="PSA 131:2">
    <char style="add">Se</char> l'anima mia <char style="add">non è stata</char> in me,</para>
  <para style="q" vid="PSA 131:2">A guisa di fanciullo novellamente spoppato<note caller="*" style="x"><char style="xo" closed="false">131.2 </char><char style="xk" closed="false">spoppato </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat. 18.3</ref>. <ref loc="1CO 14:20">1 Cor. 14.20</ref>.</char></note>.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3"/>Israele speri nel Signore</para>
  <para style="q" vid="PSA 131:3">Da ora in eterno.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">SALMO CXXXII</para>
  <para style="s1">Zelo del Salmista per il Tempio e per l'Arca. Le promesse fatte da Dio a Davide</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1"/>RICORDATI, Signore, di Davide,</para>
  <para style="q" vid="PSA 132:1">E di tutte le sue afflizioni.<verse eid="PSA 132:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2"/>Come egli giurò al Signore,</para>
  <para style="q" vid="PSA 132:2">
    <char style="add">E</char> fece voto al Possente di Giacobbe, <char style="add">dicendo:</char><verse eid="PSA 132:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3"/>Se io entro nel tabernacolo della mia casa,</para>
  <para style="q" vid="PSA 132:3">Se salgo sopra la lettiera del mio letto;<verse eid="PSA 132:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4"/>Se do alcun sonno agli occhi miei,</para>
  <para style="q" vid="PSA 132:4">
    <char style="add">O</char> alcun sonnecchiare alle mie palpebre;<verse eid="PSA 132:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5"/>Infino a tanto che io abbia trovato un luogo al Signore,</para>
  <para style="q" vid="PSA 132:5">Degli abitacoli al Possente di Giacobbe<note caller="*" style="x"><char style="xo" closed="false">132.5 </char><char style="xk" closed="false">Giacobbe </char><char style="xt" closed="false"><ref loc="1CH 22:7">1 Cron. 22.7</ref>. <ref loc="ACT 7:46">Fat. 7.46</ref>.</char></note>.<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6"/>Ecco, noi abbiamo udito <char style="add">che l'Arca era stata</char> nella <char style="add">contrada</char> Efratea;</para>
  <para style="q" vid="PSA 132:6">
    <char style="add">Poi</char> la trovammo ne' campi di Iaar<note caller="*" style="x"><char style="xo" closed="false">132.6 </char><char style="xk" closed="false">Iaar </char><char style="xt" closed="false"><ref loc="1SA 7:1">1 Sam. 7.1</ref> ecc. <ref loc="1CH 13:5">1 Cron. 13.5</ref>.</char></note>.<verse eid="PSA 132:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7"/>Entriamo negli abitacoli del Signore;</para>
  <para style="q" vid="PSA 132:7">Adoriamo allo scannello de' suoi piedi.<verse eid="PSA 132:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8"/>Levati, Signore<note caller="*" style="x"><char style="xo" closed="false">132.8 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="NUM 10:35">Num. 10.35</ref>. <ref loc="2CH 6:41">2 Cron. 6.41</ref>,<ref loc="2CH 6:42">42</ref>.</char></note>;</para>
  <para style="q" vid="PSA 132:8">Tu, e l'Arca della tua forza, <char style="add">per entrar</char> nel tuo riposo.<verse eid="PSA 132:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9"/>I tuoi sacerdoti sieno rivestiti di giustizia,</para>
  <para style="q" vid="PSA 132:9">E giubilino i tuoi santi.<verse eid="PSA 132:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10"/>Per amor di Davide, tuo servitore,</para>
  <para style="q" vid="PSA 132:10">Non negare al tuo unto la sua richiesta.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11"/>Il Signore giurò verità a Davide<note caller="*" style="x"><char style="xo" closed="false">132.11 </char><char style="xk" closed="false">Davide </char><char style="xt" closed="false"><ref loc="PSA 89:3">Sal. 89.3</ref>,<ref loc="PSA 89:4">4</ref>,<ref loc="PSA 89:33">33</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 132:11">E non <char style="add">la</char> rivocherà, <char style="add">dicendo</char>:</para>
  <para style="q" vid="PSA 132:11">Io metterò sopra il tuo trono del frutto del tuo ventre<note caller="*" style="x"><char style="xo" closed="false">132.11 </char><char style="xk" closed="false">ventre </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 Sam. 7.12</ref>. <ref loc="LUK 1:69">Luc. 1.69</ref>. <ref loc="ACT 2:30">Fat. 2.30</ref>.</char></note>.<verse eid="PSA 132:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12"/>Se i tuoi figliuoli osservano il mio patto,</para>
  <para style="q" vid="PSA 132:12">E la mia testimonianza, che io insegnerò loro;</para>
  <para style="q" vid="PSA 132:12">
    <char style="add">Essi</char>, e i lor figliuoli in perpetuo,</para>
  <para style="q" vid="PSA 132:12">Sederanno sopra il tuo trono.<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13"/>Perciocchè il Signore ha eletta Sion;</para>
  <para style="q" vid="PSA 132:13">Egli l'ha gradita per sua stanza, dicendo:<verse eid="PSA 132:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14"/>Questo <char style="add">è</char> il mio riposo in perpetuo,</para>
  <para style="q" vid="PSA 132:14">Qui abiterò; perciocchè <char style="add">questo è il luogo che</char> io ho desiderato<note caller="*" style="x"><char style="xo" closed="false">132.14 </char><char style="xk" closed="false">desiderato </char><char style="xt" closed="false"><ref loc="PSA 68:16">Sal. 68.16</ref>; <ref loc="PSA 78:68">78.68</ref>,<ref loc="PSA 78:69">69</ref>.</char></note>.<verse eid="PSA 132:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15"/>Io benedirò largamente la sua vittuaglia;</para>
  <para style="q" vid="PSA 132:15">Io sazierò di pane i suoi poveri<note caller="*" style="x"><char style="xo" closed="false">132.15 </char><char style="xk" closed="false">poveri </char><char style="xt" closed="false"><ref loc="PSA 147:14">Sal. 147.14</ref>.</char></note>.<verse eid="PSA 132:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16"/>E vestirò i suoi sacerdoti <char style="add">di vesti</char> di liberazione;</para>
  <para style="q" vid="PSA 132:16">E i suoi santi giubileranno in gran letizia.<verse eid="PSA 132:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17"/>Quivi farò germogliare un corno a Davide<note caller="*" style="x"><char style="xo" closed="false">132.17 </char><char style="xk" closed="false">Davide </char><char style="xt" closed="false"><ref loc="LUK 1:69">Luc. 1.69</ref>.</char></note>;</para>
  <para style="q" vid="PSA 132:17">E terrò accesa una lampana al mio unto<note caller="*" style="x"><char style="xo" closed="false">132.17 </char><char style="xk" closed="false">unto </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 Re. 11.36</ref>; <ref loc="1KI 15:4">15.4</ref>. <ref loc="2KI 8:19">2 Re. 8.19</ref>. <ref loc="2CH 21:7">2 Cron. 21.7</ref>.</char></note>.<verse eid="PSA 132:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18"/>Io vestirò i suoi nemici di vergogna;</para>
  <para style="q" vid="PSA 132:18">E la sua benda reale fiorirà sopra lui.<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">SALMO CXXXIII</para>
  <para style="s1">Eccellenza dell'amor fraterno</para>
  <para style="d">Cantico di Maalot, di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1"/>ECCO, quant'<char style="add">è</char> buono, e quant'è piacevole,</para>
  <para style="q" vid="PSA 133:1">Che fratelli dimorino insieme<note caller="*" style="x"><char style="xo" closed="false">133.1 </char><char style="xk" closed="false">insieme </char><char style="xt" closed="false"><ref loc="GEN 13:8">Gen. 13.8</ref>. <ref loc="HEB 13:1">Ebr. 13.1</ref>.</char></note>!<verse eid="PSA 133:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2"/>
    <char style="add">Questo è</char> come l'olio eccellente<note caller="*" style="x"><char style="xo" closed="false">133.2 </char><char style="xk" closed="false">eccellente </char><char style="xt" closed="false"><ref loc="EXO 30:25">Esod. 30.25</ref>,<ref loc="EXO 30:30">30</ref>.</char></note>,</para>
  <para style="q" vid="PSA 133:2">
    <char style="add">Che è sparso</char> sopra il capo d'Aaronne<note caller="*" style="x"><char style="xo" closed="false">133.2 </char><char style="xk" closed="false">Aaronne </char><char style="xt" closed="false"><ref loc="EXO 29:7">Esod. 29.7</ref>. <ref loc="LEV 8:12">Lev. 8.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 133:2">Il quale gli scende in su la barba,</para>
  <para style="q" vid="PSA 133:2">
    <char style="add">E poi</char> cola infino al lembo de' suoi vestimenti.<verse eid="PSA 133:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3"/>Come la rugiada di Hermon,</para>
  <para style="q" vid="PSA 133:3">Che scende sopra i monti di Sion<note caller="*" style="x"><char style="xo" closed="false">133.3 </char><char style="xk" closed="false">Sion </char><char style="xt" closed="false"><ref loc="DEU 4:48">Deut. 4.48</ref>.</char></note>;</para>
  <para style="q" vid="PSA 133:3">Perciocchè il Signore ha ordinata quivi la benedizione,</para>
  <para style="q" vid="PSA 133:3">
    <char style="add">E</char> la vita in eterno.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">SALMO CXXXIV</para>
  <para style="s1">Esortazione a benedire il Signore</para>
  <para style="d">Cantico di Maalot</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1"/>ECCO, benedite il Signore, <char style="add">voi</char> tutti i servitori del Signore,</para>
  <para style="q" vid="PSA 134:1">Che state le notti nella Casa del Signore,<verse eid="PSA 134:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2"/>Alzate le vostre mani verso il santuario<note caller="*" style="x"><char style="xo" closed="false">134.2 </char><char style="xk" closed="false">santuario </char><char style="xt" closed="false"><ref loc="1TI 2:8">1 Tim. 2.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 134:2">E benedite il Signore.<verse eid="PSA 134:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3"/>Benedicati da Sion il Signore,</para>
  <para style="q" vid="PSA 134:3">Che ha fatto il cielo e la terra.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">SALMO CXXXV</para>
  <para style="s1">Dio lodato per la sua bontà, la sua potenza ed i suoi giudicii. — Vanità degl'idoli</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 135:1">Lodate il Nome del Signore;</para>
  <para style="q" vid="PSA 135:1">Lodate<char style="add">lo, voi</char> servitori del Signore;<verse eid="PSA 135:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2"/>Che state nella Casa del Signore<note caller="*" style="x"><char style="xo" closed="false">135.2 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="LUK 2:37">Luc. 2.37</ref>.</char></note>,</para>
  <para style="q" vid="PSA 135:2">Ne' cortili della Casa del nostro Dio.<verse eid="PSA 135:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3"/>Lodate il Signore; perciocchè il Signore <char style="add">è</char> buono;</para>
  <para style="q" vid="PSA 135:3">Salmeggiate al suo Nome, perciocchè <char style="add">è</char> amabile.<verse eid="PSA 135:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4"/>Conciossiachè il Signore si abbia eletto Giacobbe</para>
  <para style="q" vid="PSA 135:4">
    <char style="add">Ed</char> Israele per suo tesoro riposto<note caller="*" style="x"><char style="xo" closed="false">135.4 </char><char style="xk" closed="false">riposto </char><char style="xt" closed="false"><ref loc="EXO 19:5">Esod. 19.5</ref>,<ref loc="EXO 19:6">6</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5"/>Certo io conosco che il Signore <char style="add">è</char> grande,</para>
  <para style="q" vid="PSA 135:5">E che il nostro Signore <char style="add">è maggiore</char> di tutti gl'iddii.<verse eid="PSA 135:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6"/>Il Signore fa tutto ciò che gli piace</para>
  <para style="q" vid="PSA 135:6">In cielo ed in terra;</para>
  <para style="q" vid="PSA 135:6">Ne' mari, ed <char style="add">in</char> tutti gli abissi.<verse eid="PSA 135:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7"/>Egli fa salire i vapori dall'estremità dalle terra;</para>
  <para style="q" vid="PSA 135:7">Egli fa i lampi per la pioggia<note caller="*" style="x"><char style="xo" closed="false">135.7 </char><char style="xk" closed="false">pioggia </char><char style="xt" closed="false"><ref loc="JOB 38:24">Giob. 38.24</ref> ecc. <ref loc="JER 10:13">Ger. 10.13</ref>. <ref loc="ZEC 10:1">Zac. 10.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 135:7">Egli trae fuori il vento da' suoi tesori.<verse eid="PSA 135:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8"/>
    <char style="add">Egli è quel</char> che percosse i primogeniti di Egitto<note caller="*" style="x"><char style="xo" closed="false">135.8 </char><char style="xk" closed="false">Egitto </char><char style="xt" closed="false"><ref loc="EXO 12:12">Esod. 12.12</ref>,<ref loc="EXO 12:29">29</ref>.</char></note>,</para>
  <para style="q" vid="PSA 135:8">Così degli uomini, come degli animali.<verse eid="PSA 135:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9"/>Che mandò segni e prodigi, in mezzo di te, o Egitto<note caller="*" style="x"><char style="xo" closed="false">135.9 </char><char style="xk" closed="false">Egitto </char><char style="xt" closed="false">Esod. cap. 7-14.</char></note>;</para>
  <para style="q" vid="PSA 135:9">Sopra Faraone, e sopra tutti i suoi servitori.<verse eid="PSA 135:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10"/>Che percosse nazioni grandi,</para>
  <para style="q" vid="PSA 135:10">Ed uccise re potenti<note caller="*" style="x"><char style="xo" closed="false">135.10 </char><char style="xk" closed="false">potenti </char><char style="xt" closed="false"><ref loc="NUM 21:25">Num. 21.25</ref>,<ref loc="NUM 21:26">26</ref>,<ref loc="NUM 21:34">34</ref>,<ref loc="NUM 21:35">35</ref>.</char></note>;<verse eid="PSA 135:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11"/>Sihon, re degli Amorrei,</para>
  <para style="q" vid="PSA 135:11">E Og, re di Basan,</para>
  <para style="q" vid="PSA 135:11">E i re di tutti i regni di Canaan<note caller="*" style="x"><char style="xo" closed="false">135.11 </char><char style="xk" closed="false">Canaan </char><char style="xt" closed="false"><ref loc="JOS 12:7">Gios. 12.7</ref> ecc.</char></note>;<verse eid="PSA 135:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12"/>E diede i lor paesi per eredità,</para>
  <para style="q" vid="PSA 135:12">Per eredità ad Israele, suo popolo.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13"/>O Signore, il tuo Nome <char style="add">è</char> in eterno<note caller="*" style="x"><char style="xo" closed="false">135.13 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="EXO 3:15">Esod. 3.15</ref>. <ref loc="PSA 102:12">Sal. 102.12</ref>.</char></note>;</para>
  <para style="q" vid="PSA 135:13">O Signore, la memoria di te <char style="add">è</char> per ogni età.<verse eid="PSA 135:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14"/>Quando il Signore avrà fatti i suoi giudicii sopra il suo popolo,</para>
  <para style="q" vid="PSA 135:14">Egli si pentirà per amor de' suoi servitori<note caller="*" style="x"><char style="xo" closed="false">135.14 </char><char style="xk" closed="false">servitori </char><char style="xt" closed="false"><ref loc="DEU 32:36">Deut. 32.36</ref>.</char></note>.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15"/>Gl'idoli delle genti<note caller="*" style="x"><char style="xo" closed="false">135.15 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="PSA 115:4-8">Sal. 115.4-8</ref> </char><char style="xta" closed="false">e rif.</char></note> <char style="add">sono</char> argento ed oro,</para>
  <para style="q" vid="PSA 135:15">Opera di mani d'uomini;<verse eid="PSA 135:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16"/>Hanno bocca, e non parlano;</para>
  <para style="q" vid="PSA 135:16">Hanno occhi, e non veggono;<verse eid="PSA 135:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17"/>Hanno orecchi, e non odono;</para>
  <para style="q" vid="PSA 135:17">
    <char style="add">Ed</char> anche non hanno fiato alcuno nella lor bocca.<verse eid="PSA 135:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18"/>Simili ad essi sieno quelli che li fanno;</para>
  <para style="q" vid="PSA 135:18">Chiunque in essi si confida.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19"/>Casa d'Israele, benedite il Signore<note caller="*" style="x"><char style="xo" closed="false">135.19 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 115:9">Sal. 115.9</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 135:19">Casa d'Aaronne, benedite il Signore.<verse eid="PSA 135:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20"/>Casa di Levi, benedite il Signore;</para>
  <para style="q" vid="PSA 135:20">
    <char style="add">Voi</char> che temete il Signore, beneditelo.<verse eid="PSA 135:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21"/>Benedetto <char style="add">sia</char> da Sion il Signore,</para>
  <para style="q" vid="PSA 135:21">Che abita in Gerusalemme.</para>
  <para style="q" vid="PSA 135:21">Alleluia.<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">SALMO CXXXVI</para>
  <para style="s1">Dio lodato per le sue opere e perchè la sua benignità è in eterno</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1"/>CELEBRATE il Signore; perciocchè <char style="add">egli è</char> buono<note caller="*" style="x"><char style="xo" closed="false">136.1 </char><char style="xk" closed="false">buono </char><char style="xt" closed="false"><ref loc="PSA 106:1">Sal. 106.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 136:1">Perciocchè la sua benignità <char style="add">è</char> in eterno<note caller="*" style="x"><char style="xo" closed="false">136.1 </char><char style="xk" closed="false">eterno </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Cron. 16.34</ref>,<ref loc="1CH 16:41">41</ref>. <ref loc="2CH 20:21">2 Cron. 20.21</ref>.</char></note>.<verse eid="PSA 136:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2"/>Celebrate l'Iddio degl'iddii<note caller="*" style="x"><char style="xo" closed="false">136.2 </char><char style="xk" closed="false">iddii </char><char style="xt" closed="false"><ref loc="DEU 10:17">Deut. 10.17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:2">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3"/>Celebrate il Signore de' signori;</para>
  <para style="q" vid="PSA 136:3">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4"/>
    <char style="add">Celebrate</char> colui che solo fa maraviglie grandi;</para>
  <para style="q" vid="PSA 136:4">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5"/>Colui che ha fatti i cieli con intendimento<note caller="*" style="x"><char style="xo" closed="false">136.5 </char><char style="xk" closed="false">intendimento </char><char style="xt" closed="false"><ref loc="GEN 1:1">Gen. 1.1</ref> ecc. <ref loc="PRO 3:19">Prov. 3.19</ref>. <ref loc="JER 10:12">Ger. 10.12</ref>; <ref loc="JER 51:15">51.15</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:5">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6"/>Colui che ha distesa la terra sopra le acque<note caller="*" style="x"><char style="xo" closed="false">136.6 </char><char style="xk" closed="false">acque </char><char style="xt" closed="false"><ref loc="GEN 1:9">Gen. 1.9</ref>. <ref loc="PSA 24:2">Sal. 24.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:6">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7"/>Colui che fa fatti i gran luminari<note caller="*" style="x"><char style="xo" closed="false">136.7 </char><char style="xk" closed="false">luminari </char><char style="xt" closed="false"><ref loc="GEN 1:14">Gen. 1.14</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 136:7">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8"/>Il sole, per <char style="add">avere</char> il reggimento del giorno;</para>
  <para style="q" vid="PSA 136:8">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9"/>La luna e le stelle, per <char style="add">avere</char> i reggimenti della notte;</para>
  <para style="q" vid="PSA 136:9">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10"/>Colui che percosse gli Egizi ne' lor primogeniti<note caller="*" style="x"><char style="xo" closed="false">136.10 </char><char style="xk" closed="false">primogeniti </char><char style="xt" closed="false"><ref loc="EXO 12:29">Esod. 12.29</ref> ecc. <ref loc="PSA 135:8">Sal. 135.8</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:10">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11"/>E trasse fuori Israele del mezzo di loro<note caller="*" style="x"><char style="xo" closed="false">136.11 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="EXO 12:51">Esod. 12.51</ref>; <ref loc="EXO 13:3">13.3</ref>,<ref loc="EXO 13:17">17</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:11">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12"/>Con man potente, e con braccio steso;</para>
  <para style="q" vid="PSA 136:12">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13"/>Colui che spartì il Mar rosso in due<note caller="*" style="x"><char style="xo" closed="false">136.13 </char><char style="xk" closed="false">due </char><char style="xt" closed="false"><ref loc="EXO 14:21">Esod. 14.21</ref> ecc. <ref loc="PSA 78:13">Sal. 78.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:13">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14"/>E fece passare Israele per lo mezzo di esso;</para>
  <para style="q" vid="PSA 136:14">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15"/>E traboccò nel Mar rosso Faraone ed il suo esercito;</para>
  <para style="q" vid="PSA 136:15">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16"/>Colui che condusse il suo popolo per lo deserto<note caller="*" style="x"><char style="xo" closed="false">136.16 </char><char style="xk" closed="false">deserto </char><char style="xt" closed="false"><ref loc="DEU 8:15">Deut. 8.15</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:16">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17"/>Colui per percosse re grandi;</para>
  <para style="q" vid="PSA 136:17">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18"/>Ed uccise re potenti<note caller="*" style="x"><char style="xo" closed="false">136.18 </char><char style="xk" closed="false">potenti </char><char style="xt" closed="false"><ref loc="DEU 29:7">Deut. 29.7</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 136:18">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19"/>Sihon, re degli Amorrei<note caller="*" style="x"><char style="xo" closed="false">136.19 </char><char style="xk" closed="false">Amorrei </char><char style="xt" closed="false"><ref loc="NUM 21:21">Num. 21.21</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 136:19">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20"/>Ed Og, re di Basan;</para>
  <para style="q" vid="PSA 136:20">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21"/>E diede il lor paese in eredità<note caller="*" style="x"><char style="xo" closed="false">136.21 </char><char style="xk" closed="false">eredità </char><char style="xt" closed="false"><ref loc="JOS 12:1">Gios. 12.1</ref> ecc.</char></note>;</para>
  <para style="q" vid="PSA 136:21">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22"/>
    <char style="add">In</char> eredità ad Israele, suo servitore;</para>
  <para style="q" vid="PSA 136:22">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23"/>Il quale, quando siamo stati abbassati, si è ricordato di noi<note caller="*" style="x"><char style="xo" closed="false">136.23 </char><char style="xk" closed="false">noi </char><char style="xt" closed="false"><ref loc="DEU 32:36">Deut. 32.36</ref>. <ref loc="PSA 113:7">Sal. 113.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:23">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24"/>E ci ha riscossi da' nostri nemici;</para>
  <para style="q" vid="PSA 136:24">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25"/>Il quale dà il cibo ad ogni carne<note caller="*" style="x"><char style="xo" closed="false">136.25 </char><char style="xk" closed="false">carne </char><char style="xt" closed="false"><ref loc="PSA 104:27">Sal. 104.27</ref>; <ref loc="PSA 145:15">145.15</ref>; <ref loc="PSA 147:9">147.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 136:25">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26"/>Celebrate il Signore de' cieli;</para>
  <para style="q" vid="PSA 136:26">Perciocchè la sua benignità <char style="add">è</char> in eterno.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">SALMO CXXXVII</para>
  <para style="s1">Lamento d'Israele nella cattività</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1"/>ESSENDO presso alle fiumane di Babilonia,</para>
  <para style="q" vid="PSA 137:1">Dove noi sedevamo, ed anche piangevamo,</para>
  <para style="q" vid="PSA 137:1">Ricordandoci di Sion,<verse eid="PSA 137:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2"/>Noi avevamo appese le nostre cetere</para>
  <para style="q" vid="PSA 137:2">A' salci, in mezzo di essa.<verse eid="PSA 137:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3"/>Benchè quelli che ci avevano menati in cattività</para>
  <para style="q" vid="PSA 137:3">Ci richiedessero quivi che cantassimo;</para>
  <para style="q" vid="PSA 137:3">E quelli che ci facevano urlar piangendo<note caller="*" style="x"><char style="xo" closed="false">137.3 </char><char style="xk" closed="false">piangendo </char><char style="xt" closed="false"><ref loc="PSA 79:1">Sal. 79.1</ref> ecc.</char></note></para>
  <para style="q" vid="PSA 137:3">
    <char style="add">Ci richiedessero canzoni d</char>'allegrezza, <char style="add">dicendo:</char></para>
  <para style="q" vid="PSA 137:3">Cantateci delle canzoni di Sion;<verse eid="PSA 137:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4"/>Come avremmo noi cantate le canzoni del Signore</para>
  <para style="q" vid="PSA 137:4">In paese di stranieri<note caller="*" style="x"><char style="xo" closed="false">137.4 </char><char style="xk" closed="false">stranieri </char><char style="xt" closed="false"><ref loc="NEH 2:3">Neem. 2.3</ref>.</char></note>?<verse eid="PSA 137:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5"/>Se io ti dimentico, o Gerusalemme;</para>
  <para style="q" vid="PSA 137:5">
    <char style="add">Se</char> la mia destra <char style="add">ti</char> dimentica;<verse eid="PSA 137:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6"/>Resti attaccata la mia lingua al mio palato,</para>
  <para style="q" vid="PSA 137:6">Se io non mi ricordo di te;</para>
  <para style="q" vid="PSA 137:6">Se non metto Gerusalemme</para>
  <para style="q" vid="PSA 137:6">In capo d'<char style="add">ogni</char> mia allegrezza<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7"/>Ricordati, Signore, de' figliuoli di Edom<note caller="*" style="x"><char style="xo" closed="false">137.7 </char><char style="xk" closed="false">Edom </char><char style="xt" closed="false"><ref loc="JER 49:7">Ger. 49.7</ref> ecc. <ref loc="LAM 4:21">Lam. 4.21</ref>,<ref loc="LAM 4:22">22</ref>.</char></note>,</para>
  <para style="q" vid="PSA 137:7">I quali, nella giornata di Gerusalemme,</para>
  <para style="q" vid="PSA 137:7">Dicevano: Spianate, spianate,</para>
  <para style="q" vid="PSA 137:7">Fino a' fondamenti<note caller="*" style="x"><char style="xo" closed="false">137.7 </char><char style="xk" closed="false">fondamenti </char><char style="xt" closed="false"><ref loc="EZK 25:12">Ezec. 25.12</ref> ecc.; <ref loc="EZK 35:1">35.1</ref> ecc. <ref loc="AMO 1:11">Am. 1.11</ref>,<ref loc="AMO 1:12">12</ref>. <ref loc="OBA 1:8">Abd. 8</ref> ecc.</char></note>.<verse eid="PSA 137:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8"/>O figliuola di Babilonia, che devi esser distrutta<note caller="*" style="x"><char style="xo" closed="false">137.8 </char><char style="xk" closed="false">distrutta </char><char style="xt" closed="false"><ref loc="ISA 13:1-14:23">Is. 13.1—14.23</ref>; <ref loc="ISA 47:1-15">47.1-15</ref>. <ref loc="JER 25:12">Ger. 25.12</ref> ecc.; <ref loc="JER 50:1-46">50.1-46</ref>. <ref loc="REV 18:1">Apoc. 18.1</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 137:8">Beato chi ti farà la retribuzione</para>
  <para style="q" vid="PSA 137:8">Del male che tu ci hai fatto!<verse eid="PSA 137:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9"/>Beato chi piglierà i tuoi piccoli figliuoli,</para>
  <para style="q" vid="PSA 137:9">E li sbatterà al sasso.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">SALMO CXXXVIII</para>
  <para style="s1">Ringraziamento a Dio per la sua fedeltà. Tutti i re lo loderanno</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1"/>IO ti celebrerò con tutto il mio cuore;</para>
  <para style="q" vid="PSA 138:1">Io ti salmeggerò davanti agli Angeli.<verse eid="PSA 138:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2"/>Io adorerò verso il Tempio della tua santità<note caller="*" style="x"><char style="xo" closed="false">138.2 </char><char style="xk" closed="false">santità </char><char style="xt" closed="false"><ref loc="1KI 8:29">1 Re. 8.29</ref>,<ref loc="1KI 8:30">30</ref>.</char></note>,</para>
  <para style="q" vid="PSA 138:2">E celebrerò il tuo Nome, per la tua benignità, e per la tua verità;</para>
  <para style="q" vid="PSA 138:2">Perciocchè tu hai magnificata la tua parola, sopra ogni tua fama<note caller="*" style="x"><char style="xo" closed="false">138.2 </char><char style="xk" closed="false">fama </char><char style="xt" closed="false"><ref loc="ISA 42:21">Is. 42.21</ref>.</char></note>.<verse eid="PSA 138:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3"/>Nel giorno che io ho gridato, tu mi hai risposto;</para>
  <para style="q" vid="PSA 138:3">Tu mi hai accresciuto di forze nell'anima mia.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4"/>Tutti i re della terra ti celebreranno, Signore,</para>
  <para style="q" vid="PSA 138:4">Quando avranno udite le parole della tua bocca;<verse eid="PSA 138:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5"/>E canteranno delle vie del Signore;</para>
  <para style="q" vid="PSA 138:5">Conciossiachè grande <char style="add">sia</char> la gloria del Signore.<verse eid="PSA 138:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6"/>Perciocchè il Signore <char style="add">è</char> eccelso<note caller="*" style="x"><char style="xo" closed="false">138.6 </char><char style="xk" closed="false">eccelso </char><char style="xt" closed="false"><ref loc="PSA 113:5">Sal. 113.5</ref>,<ref loc="PSA 113:6">6</ref>. <ref loc="ISA 57:15">Is. 57.15</ref>.</char></note>, e riguarda le cose basse<note caller="*" style="x"><char style="xo" closed="false">138.6 </char><char style="xk" closed="false">basse </char><char style="xt" closed="false"><ref loc="JAS 4:6">Giac. 4.6</ref>. <ref loc="1PE 5:5">1 Piet. 5.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 138:6">E conosce da lungi l'altiero.<verse eid="PSA 138:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7"/>Se io cammino in mezzo di distretta, tu mi manterrai in vita<note caller="*" style="x"><char style="xo" closed="false">138.7 </char><char style="xk" closed="false">vita </char><char style="xt" closed="false"><ref loc="PSA 23:3">Sal. 23.3</ref>,<ref loc="PSA 23:4">4</ref>; <ref loc="PSA 71:20">71.20</ref>.</char></note>;</para>
  <para style="q" vid="PSA 138:7">Tu stenderai la mano sopra la faccia de' miei nemici,</para>
  <para style="q" vid="PSA 138:7">E la tua destra mi salverà.<verse eid="PSA 138:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8"/>Il Signore compierà <char style="add">l'opera sua</char> intorno a me<note caller="*" style="x"><char style="xo" closed="false">138.8 </char><char style="xk" closed="false">me </char><char style="xt" closed="false"><ref loc="PSA 57:2">Sal. 57.2</ref>. <ref loc="PHP 1:6">Fil. 1.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 138:8">O Signore, la tua benignità <char style="add">è</char> in eterno;</para>
  <para style="q" vid="PSA 138:8">Non lasciar le opere delle tue mani.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">SALMO CXXXIX</para>
  <para style="s1">Onnipresenza ed onniscienza di Dio</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1"/>SIGNORE, tu mi hai investigato, e tu <char style="add">mi</char> conosci<note caller="*" style="x"><char style="xo" closed="false">139.1 </char><char style="xk" closed="false">conosci </char><char style="xt" closed="false"><ref loc="PSA 17:3">Sal. 17.3</ref>; <ref loc="PSA 44:21">44.21</ref>. <ref loc="JER 12:3">Ger. 12.3</ref>.</char></note>.<verse eid="PSA 139:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2"/>Tu vedi quando mi seggo, e quando mi alzo<note caller="*" style="x"><char style="xo" closed="false">139.2 </char><char style="xk" closed="false">alzo </char><char style="xt" closed="false"><ref loc="2KI 19:27">2 Re. 19.27</ref>.</char></note>;</para>
  <para style="q" vid="PSA 139:2">Tu intendi da lungi il mio pensiero<note caller="*" style="x"><char style="xo" closed="false">139.2 </char><char style="xk" closed="false">pensiero </char><char style="xt" closed="false"><ref loc="MAT 9:4">Mat. 9.4</ref>. <ref loc="JHN 2:24">Giov. 2.24</ref>,<ref loc="JHN 2:25">25</ref>.</char></note>.<verse eid="PSA 139:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3"/>Tu aggiri i miei sentieri e il mio ricetto;</para>
  <para style="q" vid="PSA 139:3">E sei usato a tutte le mie vie.<verse eid="PSA 139:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4"/>Perciocchè non <char style="add">essendo ancora</char> la parola sopra la mia lingua,</para>
  <para style="q" vid="PSA 139:4">Ecco, Signore, tu sai già il tutto<note caller="*" style="x"><char style="xo" closed="false">139.4 </char><char style="xk" closed="false">tutto </char><char style="xt" closed="false"><ref loc="HEB 4:13">Ebr. 4.13</ref>.</char></note>.<verse eid="PSA 139:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5"/>Tu mi strigni dietro e davanti;</para>
  <para style="q" vid="PSA 139:5">E mi metti la mano addosso.<verse eid="PSA 139:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6"/>La <char style="add">tua</char> conoscenza <char style="add">è</char> tanto maravigliosa che io non posso sottrarmene;</para>
  <para style="q" vid="PSA 139:6">
    <char style="add">E tanto</char> eccelsa, che appo lei non posso nulla<note caller="*" style="x"><char style="xo" closed="false">139.6 </char><char style="xk" closed="false">nulla </char><char style="xt" closed="false"><ref loc="JOB 42:3">Giob. 42.3</ref> e rif. <ref loc="ROM 11:33">Rom. 11.33</ref>.</char></note>.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7"/>Dove me ne andrò d'innanzi al tuo Spirito?</para>
  <para style="q" vid="PSA 139:7">E dove me ne fuggirò dal tuo cospetto<note caller="*" style="x"><char style="xo" closed="false">139.7 </char><char style="xk" closed="false">cospetto </char><char style="xt" closed="false"><ref loc="JER 23:23">Ger. 23.23</ref>,<ref loc="JER 23:24">24</ref>. <ref loc="JON 1:3">Gion. 1.3</ref>.</char></note>?<verse eid="PSA 139:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8"/>Se io salgo in cielo, tu vi <char style="add">sei</char><note caller="*" style="x"><char style="xo" closed="false">139.8 </char><char style="xk" closed="false"><char style="add">sei</char> </char><char style="xt" closed="false"><ref loc="AMO 9:2-4">Am. 9.2-4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 139:8">E <char style="add">se</char> mi metto a giacere ne' luoghi bassi sotterra<note caller="*" style="x"><char style="xo" closed="false">139.8 </char><char style="xk" closed="false">sotterra </char><char style="xt" closed="false"><ref loc="JOB 26:6">Giob. 26.6</ref>. <ref loc="PRO 15:11">Prov. 15.11</ref>.</char></note>, eccoviti.<verse eid="PSA 139:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9"/>
    <char style="add">Se</char> prendo le ale dell'alba,</para>
  <para style="q" vid="PSA 139:9">E vo a dimorar nell'estremità del mare;<verse eid="PSA 139:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10"/>Anche quivi mi condurrà la tua mano,</para>
  <para style="q" vid="PSA 139:10">E la tua destra mi prenderà.<verse eid="PSA 139:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11"/>E <char style="add">se</char> dico: Certo, le tenebre mi appiatteranno,</para>
  <para style="q" vid="PSA 139:11">La notte <char style="add">sarà</char> luce d'intorno a me.<verse eid="PSA 139:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12"/>Le tenebre stesse non possono oscurarti nulla<note caller="*" style="x"><char style="xo" closed="false">139.12 </char><char style="xk" closed="false">nulla </char><char style="xt" closed="false"><ref loc="JOB 34:22">Giob. 34.22</ref>. <ref loc="DAN 2:22">Dan. 2.22</ref>. <ref loc="HEB 4:13">Ebr. 4.13</ref>.</char></note>;</para>
  <para style="q" vid="PSA 139:12">Anzi la notte <char style="add">ti</char> risplende come il giorno;</para>
  <para style="q" vid="PSA 139:12">E le tenebre e la luce <char style="add">ti son</char> tutt'uno.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13"/>Conciossiachè tu possegga le mie reni;</para>
  <para style="q" vid="PSA 139:13">Tu mi hai composto nel seno di mia madre.<verse eid="PSA 139:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14"/>Io ti celebrerò; perciocchè io sono stato maravigliosamente formato</para>
  <para style="q" vid="PSA 139:14">In maniere stupende;</para>
  <para style="q" vid="PSA 139:14">Le tue opere <char style="add">son</char> maravigliose,</para>
  <para style="q" vid="PSA 139:14">E l'anima mia <char style="add">lo</char> sa molto bene.<verse eid="PSA 139:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15"/>La fabbrica delle mie ossa non ti fu celata,</para>
  <para style="q" vid="PSA 139:15">Quando io fui fatto in occulto<note caller="*" style="x"><char style="xo" closed="false">139.15 </char><char style="xk" closed="false">occulto </char><char style="xt" closed="false"><ref loc="JOB 10:8">Giob. 10.8</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 139:15">
    <char style="add">E</char> lavorato nelle basse parti delle terra.<verse eid="PSA 139:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16"/>I tuoi occhi videro la massa informe del mio corpo;</para>
  <para style="q" vid="PSA 139:16">E tutte queste cose erano scritte nel tuo libro,</para>
  <para style="q" vid="PSA 139:16">Nel tempo che si formavano,</para>
  <para style="q" vid="PSA 139:16">Quando niuna di esse <char style="add">era ancora</char>.<verse eid="PSA 139:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17"/>Oh! quanto mi sono, o Dio, preziosi i tuoi pensamenti!</para>
  <para style="q" vid="PSA 139:17">Quanto son grandi le somme di essi<note caller="*" style="x"><char style="xo" closed="false">139.17 </char><char style="xk" closed="false">essi </char><char style="xt" closed="false"><ref loc="PSA 40:5">Sal. 40.5</ref> </char><char style="xta" closed="false">e rif.</char></note>!<verse eid="PSA 139:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18"/>Se io li voglio annoverare, sono in maggior numero che la rena;</para>
  <para style="q" vid="PSA 139:18">
    <char style="add">Quando</char> io mi risveglio, io <char style="add">sono</char> ancora teco.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19"/>Certo, o Dio, tu ucciderai l'empio<note caller="*" style="x"><char style="xo" closed="false">139.19 </char><char style="xk" closed="false">empio </char><char style="xt" closed="false"><ref loc="ISA 11:4">Is. 11.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 139:19">Perciò, uomini di sangue, dipartitevi da me.<verse eid="PSA 139:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20"/>Perciocchè i tuoi nemici ti hanno nominato a scelleratezza;</para>
  <para style="q" vid="PSA 139:20">Hanno preso <char style="add">in bocca</char> il tuo Nome in vano.<verse eid="PSA 139:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21"/>O Signore, non odio io quelli che t'odiano?</para>
  <para style="q" vid="PSA 139:21">E non mi accuoro io per quelli che si levano contro a te<note caller="*" style="x"><char style="xo" closed="false">139.21 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 119:158">Sal. 119.158</ref> </char><char style="xta" closed="false">e rif.</char></note>?<verse eid="PSA 139:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22"/>Io li odio d'un odio perfetto;</para>
  <para style="q" vid="PSA 139:22">Io li ho per nemici.<verse eid="PSA 139:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23"/>O Dio, investigami, e conosci il mio cuore<note caller="*" style="x"><char style="xo" closed="false">139.23 </char><char style="xk" closed="false">cuore </char><char style="xt" closed="false"><ref loc="JOB 31:6">Giob. 31.6</ref>. <ref loc="PSA 26:2">Sal. 26.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 139:23">Provami, e conosci i miei pensieri;<verse eid="PSA 139:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24"/>E vedi se <char style="add">vi è</char> in me alcuna via iniqua;</para>
  <para style="q" vid="PSA 139:24">E giudami per la via del mondo<note caller="*" style="x"><char style="xo" closed="false">139.24 </char><char style="xk" closed="false">mondo </char><char style="xt" closed="false"><ref loc="PSA 5:8">Sal. 5.8</ref>; <ref loc="PSA 143:10">143.10</ref>.</char></note>.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">SALMO CXL</para>
  <para style="s1">Preghiera per ottener liberazione da nemici potenti ed ingiusti</para>
  <para style="d">Salmo di Davide, <char style="add">dato</char> al Capo de' Musici</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1"/>RISCUOTIMI, o Signore, dall'uomo malvagio;</para>
  <para style="q" vid="PSA 140:1">Guardami dall'uomo violento;<verse eid="PSA 140:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2"/>I quali macchinano de' mali nel cuore,</para>
  <para style="q" vid="PSA 140:2">
    <char style="add">E</char> tuttodì muovono guerre.<verse eid="PSA 140:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3"/>Aguzzano la lor lingua come il serpente;</para>
  <para style="q" vid="PSA 140:3">Veleno d'aspido <char style="add">è</char> sotto alle lor labbra<note caller="*" style="x"><char style="xo" closed="false">140.3 </char><char style="xk" closed="false">labbra </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom. 3.13</ref>.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4"/>Preservami, o Signore, dalle mani dell'empio;</para>
  <para style="q" vid="PSA 140:4">Guardami dall'uomo violento;</para>
  <para style="q" vid="PSA 140:4">Che hanno macchinato di far cadere i miei piedi.<verse eid="PSA 140:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5"/>I superbi mi hanno nascosto un laccio, e delle funi;</para>
  <para style="q" vid="PSA 140:5">Mi hanno tesa una rete sul sentiero<note caller="*" style="x"><char style="xo" closed="false">140.5 </char><char style="xk" closed="false">sentiero </char><char style="xt" closed="false"><ref loc="PSA 9:15">Sal. 9.15</ref>; <ref loc="PSA 35:7">35.7</ref>; <ref loc="PSA 57:6">57.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 140:5">Mi hanno poste delle trappole. <char style="qs">(Sela.)</char><verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6"/>Io ho detto al Signore: Tu <char style="add">sei</char> il mio Dio;</para>
  <para style="q" vid="PSA 140:6">O Signore, porgi l'orecchio al grido delle mie supplicazioni.<verse eid="PSA 140:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7"/>O Signore Iddio, <char style="add">che sei</char> la forza della mia salute<note caller="*" style="x"><char style="xo" closed="false">140.7 </char><char style="xk" closed="false">salute </char><char style="xt" closed="false"><ref loc="PSA 28:8">Sal. 28.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 140:7">Tu hai coperto il mio capo nel giorno dell'armi;<verse eid="PSA 140:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8"/>O Signore, non concedere agli empi ciò che desiderano;</para>
  <para style="q" vid="PSA 140:8">Non dar compimento a' lor disegni, <char style="add">onde</char> s'innalzino. <char style="qs">(Sela.)</char><verse eid="PSA 140:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9"/>
    <char style="add">Fa</char>'che la perversità delle labbra</para>
  <para style="q" vid="PSA 140:9">Di coloro che m'intorniano copra loro la testa<note caller="*" style="x"><char style="xo" closed="false">140.9 </char><char style="xk" closed="false">testa </char><char style="xt" closed="false"><ref loc="PSA 7:16">Sal. 7.16</ref>. <ref loc="PRO 12:13">Prov. 12.13</ref>; <ref loc="PRO 18:7">18.7</ref>.</char></note>.<verse eid="PSA 140:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10"/>Caggiano loro addosso carboni accesi<note caller="*" style="x"><char style="xo" closed="false">140.10 </char><char style="xk" closed="false">accesi </char><char style="xt" closed="false"><ref loc="PSA 11:6">Sal. 11.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 140:10">Trabocchili <char style="add">Iddio</char> nel fuoco.</para>
  <para style="q" vid="PSA 140:10">In fosse profonde, <char style="add">onde</char> non possano risorgere.<verse eid="PSA 140:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11"/>Non sia l'uomo maldicente stabilito in terra;</para>
  <para style="q" vid="PSA 140:11">Il male cacci l'uomo violento in precipizii.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12"/>Io so che il Signore farà ragione all'afflitto,</para>
  <para style="q" vid="PSA 140:12">
    <char style="add">E</char> diritto a' poveri<note caller="*" style="x"><char style="xo" closed="false">140.12 </char><char style="xk" closed="false">poveri </char><char style="xt" closed="false"><ref loc="PSA 9:4">Sal. 9.4</ref>.</char></note>.<verse eid="PSA 140:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13"/>Certo, i giusti celebreranno il tuo Nome;</para>
  <para style="q" vid="PSA 140:13">Gli uomini diritti abiteranno appresso alla tua faccia.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">SALMO CXLI</para>
  <para style="s1">Preghiera per esser preservato dalle tentazioni</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1"/>O SIGNORE, io t'invoco; affrettati <char style="add">a rispondermi</char>;</para>
  <para style="q" vid="PSA 141:1">Porgi l'orecchio alla mia voce, mentre io grido a te.<verse eid="PSA 141:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2"/>La mia orazione sia addirizzata al tuo cospetto, <char style="add">come</char> l'incenso<note caller="*" style="x"><char style="xo" closed="false">141.2 </char><char style="xk" closed="false">incenso </char><char style="xt" closed="false"><ref loc="REV 5:8">Apoc. 5.8</ref>; <ref loc="REV 8:3">8.3</ref>,<ref loc="REV 8:4">4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 141:2">E il mio alzar delle mani <char style="add">come</char> l'offerta della sera.<verse eid="PSA 141:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3"/>O Signore, poni guardia alla mia bocca<note caller="*" style="x"><char style="xo" closed="false">141.3 </char><char style="xk" closed="false">bocca </char><char style="xt" closed="false"><ref loc="PSA 39:1">Sal. 39.1</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 141:3">Guarda l'uscio delle mie labbra.<verse eid="PSA 141:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4"/>Non lasciar che il mio cuore s'inchini a cosa alcuna malvagia,</para>
  <para style="q" vid="PSA 141:4">Per darmi a commettere opere empie,</para>
  <para style="q" vid="PSA 141:4">Con gli uomini operatori d'iniquità;</para>
  <para style="q" vid="PSA 141:4">E <char style="add">fa</char>' che io non mangi delle lor delizie<note caller="*" style="x"><char style="xo" closed="false">141.4 </char><char style="xk" closed="false">delizie </char><char style="xt" closed="false"><ref loc="PRO 23:6">Prov. 23.6</ref>.</char></note>.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5"/>Pestimi pure il giusto, <char style="add">ciò mi sarà</char> benignità;</para>
  <para style="q" vid="PSA 141:5">E riprendami, <char style="add">ciò mi sarà</char> olio eccellente,</para>
  <para style="q" vid="PSA 141:5">
    <char style="add">Il qual</char> non mi fiaccherà il capo;</para>
  <para style="q" vid="PSA 141:5">Anzi più ch'egli <char style="add">lo farà</char>, più pregherò <char style="add">per loro</char> nelle loro avversità<note caller="*" style="x"><char style="xo" closed="false">141.5 </char><char style="xk" closed="false">avversità </char><char style="xt" closed="false"><ref loc="PRO 9:8">Prov. 9.8</ref>; <ref loc="PRO 25:12">25.12</ref>. <ref loc="GAL 6:1">Gal. 6.1</ref>.</char></note>.<verse eid="PSA 141:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6"/>I rettori di costoro furono abbandonati dentro alla roccia,</para>
  <para style="q" vid="PSA 141:6">E pure udirono le mie parole ch'erano piacevoli<note caller="*" style="x"><char style="xo" closed="false">141.6 </char><char style="xk" closed="false">piacevoli </char><char style="xt" closed="false"><ref loc="1SA 24:9">1 Sam. 24.9</ref> ecc.</char></note>.<verse eid="PSA 141:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7"/>Le nostre ossa sono sparse su la bocca del sepolcro<note caller="*" style="x"><char style="xo" closed="false">141.7 </char><char style="xk" closed="false">sepolcro </char><char style="xt" closed="false"><ref loc="2CO 1:8">2 Cor. 1.8</ref>,<ref loc="2CO 1:9">9</ref>.</char></note>,</para>
  <para style="q" vid="PSA 141:7">Come <char style="add">quando</char> altri spezza, e schianta <char style="add">legne</char> per terra.<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8"/>Perciocchè, o Signore Iddio, gli occhi miei <char style="add">sono intenti</char> a te,</para>
  <para style="q" vid="PSA 141:8">
    <char style="add">Ed</char> io spero in te<note caller="*" style="x"><char style="xo" closed="false">141.8 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="2CH 30:12">2 Cron. 30.12</ref>. <ref loc="PSA 123:1">Sal. 123.1</ref>,<ref loc="PSA 123:2">2</ref>.</char></note>; non privar di riparo l'anima mia.<verse eid="PSA 141:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9"/>Guardami dal laccio <char style="add">che</char> mi è stato teso,</para>
  <para style="q" vid="PSA 141:9">
    <char style="add">Dal</char>le trappole degli operatori d'iniquità<note caller="*" style="x"><char style="xo" closed="false">141.9 </char><char style="xk" closed="false">iniquità </char><char style="xt" closed="false"><ref loc="PSA 140:5">Sal. 140.5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 141:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10"/>Caggiano gli empi nelle lor reti tutti quanti<note caller="*" style="x"><char style="xo" closed="false">141.10 </char><char style="xk" closed="false">quanti </char><char style="xt" closed="false"><ref loc="PSA 7:15">Sal. 7.15</ref>; <ref loc="PSA 35:8">35.8</ref>.</char></note>,</para>
  <para style="q" vid="PSA 141:10">Mentre io passerò oltre.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">SALMO CXLII</para>
  <para style="s1">Preghiera in pericolo estremo</para>
  <para style="d">Maschil di Davide; orazione <char style="add">ch'egli fece</char>, quando era nella spelonca<note caller="*" style="x"><char style="xo" closed="false">142.0 </char><char style="xk" closed="false">spelonca </char><char style="xt" closed="false"><ref loc="1SA 22:1">1 Sam. 22.1</ref>; <ref loc="1SA 24:1-4">24.1-4</ref>.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1"/>IO grido colla mia voce al Signore;</para>
  <para style="q" vid="PSA 142:1">Io supplico al Signore colla mia voce.<verse eid="PSA 142:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2"/>Io spando la mia orazione davanti a lui;</para>
  <para style="q" vid="PSA 142:2">Io racconto davanti a lui la mia tribolazione,<verse eid="PSA 142:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3"/>Mentre lo spirito mio spasima in me.</para>
  <para style="q" vid="PSA 142:3">Or tu, <char style="add">Signore</char>, conosci il mio sentiero.</para>
  <para style="q" vid="PSA 142:3">Essi mi hanno nascosto un laccio</para>
  <para style="q" vid="PSA 142:3">In su la via<note caller="*" style="x"><char style="xo" closed="false">142.3 </char><char style="xk" closed="false">via </char><char style="xt" closed="false"><ref loc="PSA 140:5">Sal. 140.5</ref> </char><char style="xta" closed="false">e rif.</char></note>, per la quale ho da camminare.<verse eid="PSA 142:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4"/>Io riguardo a destra, e miro;</para>
  <para style="q" vid="PSA 142:4">E non <char style="add">vi è</char> alcuno che mi riconosca;</para>
  <para style="q" vid="PSA 142:4">
    <char style="add">Ogni</char> rifugio è perduto per me;</para>
  <para style="q" vid="PSA 142:4">Non <char style="add">vi è</char> alcuno che abbia cura dell'anima mia.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5"/>O Signore, io grido a te;</para>
  <para style="q" vid="PSA 142:5">Io dico: Tu <char style="add">sei</char> il mio ricetto<note caller="*" style="x"><char style="xo" closed="false">142.5 </char><char style="xk" closed="false">ricetto </char><char style="xt" closed="false"><ref loc="PSA 46:1">Sal. 46.1</ref>; <ref loc="PSA 91:2">91.2</ref>.</char></note>,</para>
  <para style="q" vid="PSA 142:5">La mia parte<note caller="*" style="x"><char style="xo" closed="false">142.5 </char><char style="xk" closed="false">parte </char><char style="xt" closed="false"><ref loc="PSA 16:5">Sal. 16.5</ref>.</char></note> nella terra de' viventi.<verse eid="PSA 142:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6"/>Attendi al mio gridare;</para>
  <para style="q" vid="PSA 142:6">Perciocchè io son ridotto in molto misero stato;</para>
  <para style="q" vid="PSA 142:6">Riscuotimi da quelli che mi perseguitano;</para>
  <para style="q" vid="PSA 142:6">Perciocchè son più possenti di me.<verse eid="PSA 142:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7"/>Tira fuor di carcere l'anima mia,</para>
  <para style="q" vid="PSA 142:7">Acciocchè io celebri il tuo Nome;</para>
  <para style="q" vid="PSA 142:7">I giusti m'intonieranno,</para>
  <para style="q" vid="PSA 142:7">Quando tu mi avrai fatta la mia retribuzione.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">SALMO CXLIII</para>
  <para style="s1">Preghiera per ottener liberazione dai nemici</para>
  <para style="d">Salmo di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1"/>SIGNORE, ascolta la mia orazione,</para>
  <para style="q" vid="PSA 143:1">Porgi l'orecchio alle mie supplicazioni;</para>
  <para style="q" vid="PSA 143:1">Per la tua verità, <char style="add">e</char> per la tua giustizia, rispondimi.<verse eid="PSA 143:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2"/>E non venire a giudicio col tuo servitore;</para>
  <para style="q" vid="PSA 143:2">Perciocchè niun vivente sarà trovato giusto nel tuo cospetto<note caller="*" style="x"><char style="xo" closed="false">143.2 </char><char style="xk" closed="false">cospetto </char><char style="xt" closed="false"><ref loc="JOB 9:2">Giob. 9.2</ref>; <ref loc="JOB 15:14">15.14</ref>. <ref loc="PSA 130:3">Sal. 130.3</ref>. <ref loc="ECC 7:20">Eccl. 7.20</ref>. <ref loc="ROM 3:20">Rom. 3.20</ref>. <ref loc="GAL 2:16">Gal. 2.16</ref>.</char></note>.<verse eid="PSA 143:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3"/>Perciocchè il nemico perseguita l'anima mia;</para>
  <para style="q" vid="PSA 143:3">Egli ha fiaccata, ed atterrata la mia vita;</para>
  <para style="q" vid="PSA 143:3">Egli mi fa giacere in luoghi tenebrosi,</para>
  <para style="q" vid="PSA 143:3">Come quelli che son morti già da lungo tempo.<verse eid="PSA 143:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4"/>E lo spirito mio spasima in me;</para>
  <para style="q" vid="PSA 143:4">Il mio cuore è tutto smarrito dentro di me.<verse eid="PSA 143:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5"/>Io mi rammemoro i giorni antichi;</para>
  <para style="q" vid="PSA 143:5">Io medito tutti i tuoi fatti;</para>
  <para style="q" vid="PSA 143:5">Io ragiono delle opere delle tue mani<note caller="*" style="x"><char style="xo" closed="false">143.5 </char><char style="xk" closed="false">mani </char><char style="xt" closed="false"><ref loc="PSA 111:2">Sal. 111.2</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 143:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6"/>Io spiego a te le mie mani;</para>
  <para style="q" vid="PSA 143:6">L'anima mia <char style="add">è intenta</char> a te, come terra asciutta<note caller="*" style="x"><char style="xo" closed="false">143.6 </char><char style="xk" closed="false">asciutta </char><char style="xt" closed="false"><ref loc="PSA 42:1">Sal. 42.1</ref> </char><char style="xta" closed="false">e rif.</char></note>. <char style="qs">(Sela.)</char><verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7"/>Affrettati a rispondermi, Signore;</para>
  <para style="q" vid="PSA 143:7">Lo spirito mio vien meno;</para>
  <para style="q" vid="PSA 143:7">Non nasconder da me la tua faccia,</para>
  <para style="q" vid="PSA 143:7">Sì che io sia renduto simile a quelli che scendono nella fossa.<verse eid="PSA 143:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8"/>Fammi sentir la mattina la tua benignità,</para>
  <para style="q" vid="PSA 143:8">Perciocchè io mi confido in te<note caller="*" style="x"><char style="xo" closed="false">143.8 </char><char style="xk" closed="false">te </char><char style="xt" closed="false"><ref loc="PSA 25:2">Sal. 25.2</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 143:8">Fammi conoscer la via per la quale ho da camminare,</para>
  <para style="q" vid="PSA 143:8">Perciocchè io levo l'anima mia a te.<verse eid="PSA 143:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9"/>Signore, riscuotimi da' miei nemici;</para>
  <para style="q" vid="PSA 143:9">Io mi riduco a te per nascondermi.<verse eid="PSA 143:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10"/>Insegnami a far la tua volontà<note caller="*" style="x"><char style="xo" closed="false">143.10 </char><char style="xk" closed="false">volontà </char><char style="xt" closed="false"><ref loc="PSA 25:4">Sal. 25.4</ref>,<ref loc="PSA 25:5">5</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 143:10">Perciocchè tu <char style="add">sei</char> il mio Dio;</para>
  <para style="q" vid="PSA 143:10">Il tuo buono Spirito mi giudi<note caller="*" style="x"><char style="xo" closed="false">143.10 </char><char style="xk" closed="false">giudi </char><char style="xt" closed="false"><ref loc="NEH 9:20">Neem. 9.20</ref>. <ref loc="PSA 51:11">Sal. 51.11</ref>,<ref loc="PSA 51:12">12</ref>.</char></note> nella terra della dirittura.<verse eid="PSA 143:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11"/>O Signore, vivificami, per amor del tuo Nome;</para>
  <para style="q" vid="PSA 143:11">Tira fuor di distretta l'anima mia, per la tua giustizia.<verse eid="PSA 143:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12"/>E per la tua benignità, distruggi i miei nemici,</para>
  <para style="q" vid="PSA 143:12">E fa' perir tutti quelli che affliggono l'anima mia;</para>
  <para style="q" vid="PSA 143:12">Perciocchè io <char style="add">son</char> tuo servitore.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">SALMO CXLIV</para>
  <para style="s1">Ringraziamento per la protezione già avuta da Dio, e preghiera per ulteriori liberazioni</para>
  <para style="d">
    <char style="add">Salmo</char> di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1"/>BENEDETTO <char style="add">sia</char> il Signore, mia Rocca,</para>
  <para style="q" vid="PSA 144:1">Il quale ammaestra le mie mani alla battaglia,</para>
  <para style="q" vid="PSA 144:1">
    <char style="add">E</char> le mie dita alla guerra.<verse eid="PSA 144:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2"/>
    <char style="add">Egli</char> è la mia benignità e la mia fortezza;</para>
  <para style="q" vid="PSA 144:2">Il mio alto ricetto ed il mio liberatore;</para>
  <para style="q" vid="PSA 144:2">
    <char style="add">Egli è</char> il mio scudo, ed io mi confido in lui;</para>
  <para style="q" vid="PSA 144:2">
    <char style="add">Egli è</char> quello che abbatte i popoli sotto me.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3"/>O Signore, che cosa <char style="add">è</char> l'uomo, che tu ne abbi cura?</para>
  <para style="q" vid="PSA 144:3">
    <char style="add">Che cosa è</char> il figliuol dell'uomo, che tu ne faccia conto<note caller="*" style="x"><char style="xo" closed="false">144.3 </char><char style="xk" closed="false">conto </char><char style="xt" closed="false"><ref loc="PSA 8:4">Sal. 8.4</ref>. <ref loc="HEB 2:6">Ebr. 2.6</ref>.</char></note>?<verse eid="PSA 144:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4"/>L'uomo <char style="add">è</char> simile a vanità;</para>
  <para style="q" vid="PSA 144:4">I suoi giorni <char style="add">son</char> come l'ombra che passa<note caller="*" style="x"><char style="xo" closed="false">144.4 </char><char style="xk" closed="false">passa </char><char style="xt" closed="false"><ref loc="JOB 14:2">Giob. 14.2</ref>. <ref loc="PSA 39:5">Sal. 39.5</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5"/>Signore, abbassa i tuoi cieli, e scendi<note caller="*" style="x"><char style="xo" closed="false">144.5 </char><char style="xk" closed="false">scendi </char><char style="xt" closed="false"><ref loc="PSA 18:8">Sal. 18.8</ref> ecc. <ref loc="ISA 64:1">Is. 64.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 144:5">Tocca i monti, e <char style="add">fa' che</char> fumino.<verse eid="PSA 144:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6"/>Vibra il folgore, e dissipa quella gente;</para>
  <para style="q" vid="PSA 144:6">Avventa le tua saette, e mettili in rotta.<verse eid="PSA 144:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7"/>Stendi le tue mani da alto,</para>
  <para style="q" vid="PSA 144:7">
    <char style="add">E</char> riscuotimi, e trammi fuor di grandi acque,</para>
  <para style="q" vid="PSA 144:7">Di man degli stranieri;<verse eid="PSA 144:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8"/>La cui bocca parla menzogna;</para>
  <para style="q" vid="PSA 144:8">E la cui destra <char style="add">è</char> destra di frode.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9"/>O Dio, io ti canterò un nuovo cantico;</para>
  <para style="q" vid="PSA 144:9">Io ti salmeggerò in sul saltero <char style="add">ed</char> in sul decacordo.<verse eid="PSA 144:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10"/>
    <char style="add">Tu</char>, che dài vittoria ai re;</para>
  <para style="q" vid="PSA 144:10">Che riscuoti Davide, tuo servitore, dalla spada scellerata;<verse eid="PSA 144:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11"/>Liberami, e riscuotimi dalla mano degli stranieri.</para>
  <para style="q" vid="PSA 144:11">La cui bocca parla menzogna,</para>
  <para style="q" vid="PSA 144:11">E la cui destra <char style="add">è</char> destra di frode.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12"/>Acciocchè i nostri figliuoli <char style="add">sieno</char> come piante novelle<note caller="*" style="x"><char style="xo" closed="false">144.12 </char><char style="xk" closed="false">novelle </char><char style="xt" closed="false"><ref loc="PSA 128:3">Sal. 128.3</ref>.</char></note>,</para>
  <para style="q" vid="PSA 144:12">
    <char style="add">Bene</char> allevate nella lor giovanezza;</para>
  <para style="q" vid="PSA 144:12">
    <char style="add">E</char> le nostre figliuole <char style="add">sieno</char> come i cantoni intagliati</para>
  <para style="q" vid="PSA 144:12">Dell'edificio d'un palazzo;<verse eid="PSA 144:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13"/>E le nostre celle <char style="add">sieno</char> piene,</para>
  <para style="q" vid="PSA 144:13">
    <char style="add">E</char> porgano ogni specie <char style="add">di beni</char>;</para>
  <para style="q" vid="PSA 144:13">
    <char style="add">E</char> le nostre gregge moltiplichino a migliaia, e a diecine di migliaia,</para>
  <para style="q" vid="PSA 144:13">Nelle nostre campagne;<verse eid="PSA 144:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14"/>
    <char style="add">E</char> i nostri buoi <char style="add">sieno</char> grossi e possenti;</para>
  <para style="q" vid="PSA 144:14">
    <char style="add">E</char> non <char style="add">vi sia</char> per le nostre piazze nè assalto,</para>
  <para style="q" vid="PSA 144:14">Nè uscita, nè grido alcuno.<verse eid="PSA 144:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15"/>Beato il popolo che <char style="add">è</char> in tale stato;</para>
  <para style="q" vid="PSA 144:15">Beato il popolo, di cui il Signore è l'Iddio<note caller="*" style="x"><char style="xo" closed="false">144.15 </char><char style="xk" closed="false">Iddio </char><char style="xt" closed="false"><ref loc="DEU 33:29">Deut. 33.29</ref>. <ref loc="PSA 33:12">Sal. 33.12</ref>.</char></note>.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">SALMO CXLV</para>
  <para style="s1">Grandezza, bontà e provvidenza di Dio</para>
  <para style="d">
    <char style="add">Salmo di</char> lode, di Davide</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1"/>O DIO mio, Re mio, io ti esalterò;</para>
  <para style="q" vid="PSA 145:1">E benedirò il tuo Nome in sempiterno.<verse eid="PSA 145:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2"/>Io ti benedirò tuttodì;</para>
  <para style="q" vid="PSA 145:2">E loderò il tuo Nome in sempiterno.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3"/>Il Signore <char style="add">è</char> grande, e degno di somma lode;</para>
  <para style="q" vid="PSA 145:3">E la sua grandezza non può essere investigata<note caller="*" style="x"><char style="xo" closed="false">145.3 </char><char style="xk" closed="false">investigata </char><char style="xt" closed="false"><ref loc="JOB 9:10">Giob. 9.10</ref>. <ref loc="ROM 11:33">Rom. 11.33</ref>.</char></note>.<verse eid="PSA 145:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4"/>Un'età dopo l'altra predicherà le lodi delle tue opere;</para>
  <para style="q" vid="PSA 145:4">E gli uomini racconteranno le tue prodezze.<verse eid="PSA 145:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5"/>Io ragionerò della magnificenza della gloria della tua maestà,</para>
  <para style="q" vid="PSA 145:5">E delle tue maraviglie.<verse eid="PSA 145:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6"/>E <char style="add">gli uomini</char> diranno la potenza delle tue <char style="add">opere</char> tremende;</para>
  <para style="q" vid="PSA 145:6">Ed io narrerò la tua grandezza.<verse eid="PSA 145:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7"/>Essi sgorgheranno la ricordanza della tua gran bontà,</para>
  <para style="q" vid="PSA 145:7">E canteranno con giubilo la tua giustizia.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8"/>Il Signore <char style="add">è</char> grazioso, e pietoso;</para>
  <para style="q" vid="PSA 145:8">Lento all'ira, e di gran benignità<note caller="*" style="x"><char style="xo" closed="false">145.8 </char><char style="xk" closed="false">benignità </char><char style="xt" closed="false"><ref loc="EXO 34:6">Esod. 34.6</ref>,<ref loc="EXO 34:7">7</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 145:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9"/>Il Signore <char style="add">è</char> buono inverso tutti;</para>
  <para style="q" vid="PSA 145:9">E le sue compassioni <char style="add">son</char> sopra tutte le sue opere.<verse eid="PSA 145:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10"/>O Signore, tutte le tue opere ti celebreranno<note caller="*" style="x"><char style="xo" closed="false">145.10 </char><char style="xk" closed="false">celebreranno </char><char style="xt" closed="false"><ref loc="PSA 19:1">Sal. 19.1</ref>.</char></note>;</para>
  <para style="q" vid="PSA 145:10">E i tuoi santi ti benediranno:<verse eid="PSA 145:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11"/>Diranno la gloria del tuo regno;</para>
  <para style="q" vid="PSA 145:11">E narreranno la tua forza;<verse eid="PSA 145:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12"/>Per far note le tue prodezze,</para>
  <para style="q" vid="PSA 145:12">E la magnificenza della gloria del tuo regno a' figliuoli degli uomini.<verse eid="PSA 145:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13"/>Il tuo regno <char style="add">è</char> un regno di tutti i secoli,</para>
  <para style="q" vid="PSA 145:13">E la tua signoria <char style="add">è</char> per ogni età<note caller="*" style="x"><char style="xo" closed="false">145.13 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="PSA 146:10">Sal. 146.10</ref>. <ref loc="1TI 1:17">1 Tim. 1.17</ref>.</char></note>.<verse eid="PSA 145:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14"/>Il Signore sostiene tutti quelli che cadono,</para>
  <para style="q" vid="PSA 145:14">E rileva tutti quelli che dichinano.<verse eid="PSA 145:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15"/>Gli occhi di tutti sperano in te;</para>
  <para style="q" vid="PSA 145:15">E tu dài loro il lor cibo al suo tempo.<verse eid="PSA 145:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16"/>Tu apri la tua mano,</para>
  <para style="q" vid="PSA 145:16">E sazii di benevolenza ogni vivente<note caller="*" style="x"><char style="xo" closed="false">145.16 </char><char style="xk" closed="false">vivente </char><char style="xt" closed="false"><ref loc="PSA 104:21">Sal. 104.21</ref>,<ref loc="PSA 104:27">27</ref>; <ref loc="PSA 136:25">136.25</ref>.</char></note><verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17"/>Il Signore <char style="add">è</char> giusto in tutte le sue vie,</para>
  <para style="q" vid="PSA 145:17">E benigno in tutte le sue opere.<verse eid="PSA 145:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18"/>Il Signore <char style="add">è</char> presso di tutti quelli che l'invocano<note caller="*" style="x"><char style="xo" closed="false">145.18 </char><char style="xk" closed="false">invocano </char><char style="xt" closed="false"><ref loc="DEU 4:7">Deut. 4.7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 145:18">Di tutti quelli che l'invocano in verità<note caller="*" style="x"><char style="xo" closed="false">145.18 </char><char style="xk" closed="false">verità </char><char style="xt" closed="false"><ref loc="JHN 4:23">Giov. 4.23</ref>,<ref loc="JHN 4:24">24</ref>.</char></note>.<verse eid="PSA 145:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19"/>Egli adempie il desiderio di quelli che lo temono,</para>
  <para style="q" vid="PSA 145:19">E ode il lor grido, e li salva.<verse eid="PSA 145:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20"/>Il Signore guarda tutti quelli che l'amano<note caller="*" style="x"><char style="xo" closed="false">145.20 </char><char style="xk" closed="false">amano </char><char style="xt" closed="false"><ref loc="PSA 31:23">Sal. 31.23</ref>; <ref loc="PSA 97:10">97.10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 145:20">E distruggerà tutti gli empi.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21"/>La mia bocca narrerà la lode del Signore;</para>
  <para style="q" vid="PSA 145:21">E ogni carne benedirà il Nome della sua santità</para>
  <para style="q" vid="PSA 145:21">In sempiterno.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">SALMO CXLVI</para>
  <para style="s1">Fralezza dell'uomo; fedeltà di Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 146:1">Anima mia, loda il Signore<note caller="*" style="x"><char style="xo" closed="false">146.1 </char><char style="xk" closed="false">Signore </char><char style="xt" closed="false"><ref loc="PSA 103:1">Sal. 103.1</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 146:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2"/>Io loderò il Signore, mentre viverò;</para>
  <para style="q" vid="PSA 146:2">Io salmeggerò al mio Dio, mentre durerò.<verse eid="PSA 146:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3"/>Non vi confidate in principi,</para>
  <para style="q" vid="PSA 146:3">
    <char style="add">Nè</char> in alcun figliuol d'uomo, che non ha modo di salvare<note caller="*" style="x"><char style="xo" closed="false">146.3 </char><char style="xk" closed="false">salvare </char><char style="xt" closed="false"><ref loc="PSA 118:8">Sal. 118.8</ref>,<ref loc="PSA 118:9">9</ref>. <ref loc="ISA 2:22">Is. 2.22</ref>.</char></note>.<verse eid="PSA 146:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4"/>Il suo fiato uscirà, ed egli se ne ritornerà nella sua terra<note caller="*" style="x"><char style="xo" closed="false">146.4 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 104:29">Sal. 104.29</ref>. <ref loc="ECC 12:9">Eccl. 12.9</ref>.</char></note>;</para>
  <para style="q" vid="PSA 146:4">In quel dì periranno i suoi disegni.<verse eid="PSA 146:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5"/>Beato colui che ha l'Iddio di Giacobbe in suo aiuto<note caller="*" style="x"><char style="xo" closed="false">146.5 </char><char style="xk" closed="false">aiuto </char><char style="xt" closed="false"><ref loc="PSA 144:15">Sal. 144.15</ref> e rif. <ref loc="JER 17:7">Ger. 17.7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 146:5">La cui speranza <char style="add">è</char> nel Signore Iddio suo<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6"/>Il quale ha fatto il cielo e la terra<note caller="*" style="x"><char style="xo" closed="false">146.6 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="GEN 1:1">Gen. 1.1</ref> ecc. <ref loc="REV 14:7">Apoc. 14.7</ref>.</char></note>,</para>
  <para style="q" vid="PSA 146:6">Il mare, e tutto ciò ch'<char style="add">è</char> in essi;</para>
  <para style="q" vid="PSA 146:6">Che osserva la fede in eterno;<verse eid="PSA 146:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7"/>Il qual fa ragione agli oppressati<note caller="*" style="x"><char style="xo" closed="false">146.7 </char><char style="xk" closed="false">oppressati </char><char style="xt" closed="false"><ref loc="PSA 103:6">Sal. 103.6</ref>.</char></note>;</para>
  <para style="q" vid="PSA 146:7">
    <char style="add">E</char> dà del cibo agli affamati.</para>
  <para style="q" vid="PSA 146:7">Il Signore scioglie i prigioni<note caller="*" style="x"><char style="xo" closed="false">146.7 </char><char style="xk" closed="false">prigioni </char><char style="xt" closed="false"><ref loc="ISA 61:1">Is. 61.1</ref>.</char></note>.<verse eid="PSA 146:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8"/>Il Signore apre <char style="add">gli occhi</char> a' ciechi<note caller="*" style="x"><char style="xo" closed="false">146.8 </char><char style="xk" closed="false">ciechi </char><char style="xt" closed="false"><ref loc="MAT 9:30">Mat. 9.30</ref>. <ref loc="JHN 9:7-32">Giov. 9.7-32</ref>.</char></note>;</para>
  <para style="q" vid="PSA 146:8">Il Signore rileva quelli che son chinati;</para>
  <para style="q" vid="PSA 146:8">Il Signore ama i giusti.<verse eid="PSA 146:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9"/>Il Signore guarda i forestieri<note caller="*" style="x"><char style="xo" closed="false">146.9 </char><char style="xk" closed="false">forestieri </char><char style="xt" closed="false"><ref loc="DEU 10:18">Deut. 10.18</ref>. <ref loc="PSA 68:5">Sal. 68.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 146:9">Egli solleva l'orfano e la vedova;</para>
  <para style="q" vid="PSA 146:9">E sovverte la via degli empi.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10"/>Il Signore regna in eterno,</para>
  <para style="q" vid="PSA 146:10">E il tuo Dio, o Sion, per ogni età<note caller="*" style="x"><char style="xo" closed="false">146.10 </char><char style="xk" closed="false">età </char><char style="xt" closed="false"><ref loc="EXO 15:18">Esod. 15.18</ref>. <ref loc="REV 11:15">Apoc. 11.15</ref>.</char></note>.</para>
  <para style="q" vid="PSA 146:10">Alleluia.<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">SALMO CXLVII</para>
  <para style="s1">Esortazione a lodare Iddio per i suoi beneficii</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1"/>LODATE il Signore;</para>
  <para style="q" vid="PSA 147:1">Perciocchè egli <char style="add">è</char> cosa buona e dilettevole di salmeggiar l'Iddio nostro;</para>
  <para style="q" vid="PSA 147:1">La lode <char style="add">è</char> decevole.<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2"/>Il Signore è quel ch'edifica Gerusalemme;</para>
  <para style="q" vid="PSA 147:2">Egli raccoglierà i dispersi d'Israele<note caller="*" style="x"><char style="xo" closed="false">147.2 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="DEU 30:3">Deut. 30.3</ref>. <ref loc="ISA 11:12">Is. 11.12</ref>; <ref loc="ISA 27:13">27.13</ref>; <ref loc="ISA 56:8">56.8</ref>. <ref loc="EZK 39:28">Ezec. 39.28</ref>.</char></note>.<verse eid="PSA 147:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3"/>
    <char style="add">Egli è quel</char> che guarisce quelli che hanno il cuor rotto<note caller="*" style="x"><char style="xo" closed="false">147.3 </char><char style="xk" closed="false">rotto </char><char style="xt" closed="false"><ref loc="PSA 51:17">Sal. 51.17</ref>. <ref loc="ISA 57:15">Is. 57.15</ref>; <ref loc="ISA 61:1">61.1</ref> ecc. <ref loc="LUK 4:18">Luc. 4.18</ref> ecc.</char></note>,</para>
  <para style="q" vid="PSA 147:3">E fascia le lor doglie;<verse eid="PSA 147:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4"/>Che conta il numero delle stelle<note caller="*" style="x"><char style="xo" closed="false">147.4 </char><char style="xk" closed="false">stelle </char><char style="xt" closed="false"><ref loc="GEN 15:5">Gen. 15.5</ref>. <ref loc="ISA 40:26">Is. 40.26</ref>.</char></note>;</para>
  <para style="q" vid="PSA 147:4">Che le chiama tutte per li nomi <char style="add">loro</char>.<verse eid="PSA 147:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5"/>Il nostro Signore <char style="add">è</char> grande, e di gran forza;</para>
  <para style="q" vid="PSA 147:5">La sua intelligenza <char style="add">è</char> infinita<note caller="*" style="x"><char style="xo" closed="false">147.5 </char><char style="xk" closed="false">infinita </char><char style="xt" closed="false"><ref loc="ISA 40:28">Is. 40.28</ref> </char><char style="xta" closed="false">e rif.</char></note>.<verse eid="PSA 147:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6"/>Il Signore solleva i mansueti;</para>
  <para style="q" vid="PSA 147:6">Ed abbatte gli empi fino a terra.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7"/>Cantate al Signore con lode;</para>
  <para style="q" vid="PSA 147:7">Salmeggiate colla cetera all'Iddio nostro;<verse eid="PSA 147:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8"/>Il qual copre il cielo di nuvole,</para>
  <para style="q" vid="PSA 147:8">Ed apparecchia la pioggia alla terra<note caller="*" style="x"><char style="xo" closed="false">147.8 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="JOB 36:26-28">Giob. 36.26-28</ref>. <ref loc="PSA 104:13">Sal. 104.13</ref>,<ref loc="PSA 104:14">14</ref>.</char></note>,</para>
  <para style="q" vid="PSA 147:8">
    <char style="add">E</char> fa che i monti producono l'erba.<verse eid="PSA 147:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9"/>Che dà la sua pastura al bestiame.</para>
  <para style="q" vid="PSA 147:9">A' figli de' corvi, che gridano<note caller="*" style="x"><char style="xo" closed="false">147.9 </char><char style="xk" closed="false">gridano </char><char style="xt" closed="false"><ref loc="PSA 104:27">Sal. 104.27</ref>,<ref loc="PSA 104:28">28</ref>. <ref loc="MAT 6:26">Mat. 6.26</ref>.</char></note>.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10"/>Egli non si compiace nella forza del cavallo<note caller="*" style="x"><char style="xo" closed="false">147.10 </char><char style="xk" closed="false">cavallo </char><char style="xt" closed="false"><ref loc="PSA 33:16">Sal. 33.16</ref>,<ref loc="PSA 33:17">17</ref>. <ref loc="HOS 1:7">Os. 1.7</ref>.</char></note>;</para>
  <para style="q" vid="PSA 147:10">Egli non gradisce le gambe dell'uomo.<verse eid="PSA 147:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11"/>Il Signore gradisce quelli che lo temono,</para>
  <para style="q" vid="PSA 147:11">Quelli che sperano nella sua benignità.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12"/>Gerusalemme, celebra il Signore;</para>
  <para style="q" vid="PSA 147:12">Sion, loda il tuo Dio.<verse eid="PSA 147:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13"/>Perciocchè egli rinforza le sbarre delle tue porte;</para>
  <para style="q" vid="PSA 147:13">Egli benedice i tuoi figliuoli in mezzo di te.<verse eid="PSA 147:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14"/>
    <char style="add">Egli è quel</char> che mantiene il tuo paese in pace<note caller="*" style="x"><char style="xo" closed="false">147.14 </char><char style="xk" closed="false">pace </char><char style="xt" closed="false"><ref loc="ISA 60:17">Is. 60.17</ref>,<ref loc="ISA 60:18">18</ref>.</char></note>;</para>
  <para style="q" vid="PSA 147:14">Che ti sazia di grascia di frumento;<verse eid="PSA 147:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15"/>Che manda il suo dire in terra<note caller="*" style="x"><char style="xo" closed="false">147.15 </char><char style="xk" closed="false">terra </char><char style="xt" closed="false"><ref loc="PSA 107:20">Sal. 107.20</ref> </char><char style="xta" closed="false">e rif.</char></note>;</para>
  <para style="q" vid="PSA 147:15">
    <char style="add">E</char> la sua parola corre velocissimamente;<verse eid="PSA 147:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16"/>Che manda la neve a guisa di lana;</para>
  <para style="q" vid="PSA 147:16">Che sparge la brina a guisa di cenere;<verse eid="PSA 147:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17"/>Che getta il suo ghiaccio come <char style="add">per</char> pezzi;</para>
  <para style="q" vid="PSA 147:17">
    <char style="add">E</char> chi potrà durar davanti al suo freddo?<verse eid="PSA 147:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18"/>Egli manda la sua parola, e fa struggere quelle cose;</para>
  <para style="q" vid="PSA 147:18">Egli fa soffiare il suo vento, <char style="add">è</char> le acque corrono.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19"/>Egli annunzia le sue parole a Giacobbe;</para>
  <para style="q" vid="PSA 147:19">I suoi statuti e le sue leggi ad Israele<note caller="*" style="x"><char style="xo" closed="false">147.19 </char><char style="xk" closed="false">Israele </char><char style="xt" closed="false"><ref loc="DEU 33:2-4">Deut. 33.2-4</ref>. <ref loc="PSA 103:7">Sal. 103.7</ref>.</char></note>.<verse eid="PSA 147:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20"/>Egli non ha fatto così a tutte le genti<note caller="*" style="x"><char style="xo" closed="false">147.20 </char><char style="xk" closed="false">genti </char><char style="xt" closed="false"><ref loc="DEU 4:22-35">Deut. 4.22-35</ref>. <ref loc="ROM 3:1">Rom. 3.1</ref>,<ref loc="ROM 3:2">2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 147:20">Ed esse non conoscono le <char style="add">sue</char> leggi.</para>
  <para style="q" vid="PSA 147:20">Alleluia.<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">SALMO CXLVIII</para>
  <para style="s1">L'intero creato lodi il Signore</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 148:1">Lodate il Signore dal cielo;</para>
  <para style="q" vid="PSA 148:1">Lodatelo ne' <char style="add">luoghi</char> altissimi.<verse eid="PSA 148:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2"/>Lodatelo <char style="add">voi</char>, suoi Angeli tutti<note caller="*" style="x"><char style="xo" closed="false">148.2 </char><char style="xk" closed="false">tutti </char><char style="xt" closed="false"><ref loc="PSA 103:20">Sal. 103.20</ref>,<ref loc="PSA 103:21">21</ref> </char><char style="xta" closed="false">e rif.</char></note>.</para>
  <para style="q" vid="PSA 148:2">Lodatelo <char style="add">voi</char>, suoi eserciti.<verse eid="PSA 148:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3"/>Lodatelo, sole e luna;</para>
  <para style="q" vid="PSA 148:3">Lodatelo <char style="add">voi</char>, stelle lucenti tutte.<verse eid="PSA 148:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4"/>Lodatelo <char style="add">voi</char>, cieli de' cieli<note caller="*" style="x"><char style="xo" closed="false">148.4 </char><char style="xk" closed="false">cieli </char><char style="xt" closed="false"><ref loc="1KI 8:27">1 Re. 8.27</ref> e rif. <ref loc="2CO 12:2">2 Cor. 12.2</ref>.</char></note>;</para>
  <para style="q" vid="PSA 148:4">E <char style="add">voi</char>, acque che <char style="add">siete</char> di sopra al cielo<note caller="*" style="x"><char style="xo" closed="false">148.4 </char><char style="xk" closed="false">cielo </char><char style="xt" closed="false"><ref loc="GEN 6:1">Gen. 6.1</ref>,<ref loc="GEN 6:7">7</ref>.</char></note>.<verse eid="PSA 148:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5"/>
    <char style="add">Tutte queste cose</char> lodino il nome del Signore;</para>
  <para style="q" vid="PSA 148:5">Perciocchè al suo comandamento furono create<note caller="*" style="x"><char style="xo" closed="false">148.5 </char><char style="xk" closed="false">create </char><char style="xt" closed="false"><ref loc="GEN 1:1">Gen. 1.1</ref>,<ref loc="GEN 1:6">6</ref>,<ref loc="GEN 1:7">7</ref>. <ref loc="PSA 33:6">Sal. 33.6</ref>,<ref loc="PSA 33:9">9</ref>.</char></note>.<verse eid="PSA 148:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6"/>Ed egli le ha stabilite per sempre <char style="add">ed</char> in perpetuo<note caller="*" style="x"><char style="xo" closed="false">148.6 </char><char style="xk" closed="false">perpetuo </char><char style="xt" closed="false"><ref loc="PSA 119:90">Sal. 119.90</ref>,<ref loc="PSA 119:91">91</ref>. <ref loc="JER 31:35">Ger. 31.35</ref>,<ref loc="JER 31:36">36</ref>; <ref loc="JER 33:25">33.25</ref>.</char></note>;</para>
  <para style="q" vid="PSA 148:6">Egli ne ha fatto uno statuto, il qual non trapasserà giammai.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7"/>Lodate il Signore della terra.</para>
  <para style="q" vid="PSA 148:7">Balene<note caller="*" style="x"><char style="xo" closed="false">148.7 </char><char style="xk" closed="false">Balene </char><char style="xt" closed="false"><ref loc="ISA 43:20">Is. 43.20</ref>.</char></note>, ed abissi tutti;<verse eid="PSA 148:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8"/>Fuoco, e gragnuola; neve, e vapore,</para>
  <para style="q" vid="PSA 148:8">
    <char style="add">E</char> vento tempestoso ch'eseguisce la sua parola;<verse eid="PSA 148:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9"/>Monti, e colli tutti;</para>
  <para style="q" vid="PSA 148:9">Alberi fruttiferi, e cedri tutti<note caller="*" style="x"><char style="xo" closed="false">148.9 </char><char style="xk" closed="false">tutti </char><char style="xt" closed="false"><ref loc="ISA 44:23">Is. 44.23</ref>; <ref loc="ISA 49:13">49.13</ref>; <ref loc="ISA 55:12">55.12</ref>.</char></note>;<verse eid="PSA 148:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10"/>Fiere, e bestie domestiche tutte;</para>
  <para style="q" vid="PSA 148:10">Rettili, ed uccelli alati;<verse eid="PSA 148:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11"/>Re della terra, e popoli tutti;</para>
  <para style="q" vid="PSA 148:11">Principi, e rettori della terra tutti;<verse eid="PSA 148:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12"/>Giovani, ed anche vergini;</para>
  <para style="q" vid="PSA 148:12">Vecchi, e fanciulli;<verse eid="PSA 148:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13"/>Lodino il Nome del Signore;</para>
  <para style="q" vid="PSA 148:13">Perciocchè il Nome di lui solo è innalzato<note caller="*" style="x"><char style="xo" closed="false">148.13 </char><char style="xk" closed="false">innalzato </char><char style="xt" closed="false"><ref loc="PSA 8:1">Sal. 8.1</ref>,<ref loc="PSA 8:2">2</ref>. <ref loc="ISA 12:4">Is. 12.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 148:13">La sua maestà <char style="add">è</char> sopra la terra, e <char style="add">sopra</char> il cielo.<verse eid="PSA 148:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14"/>Ed ha alzato un corno al suo popolo,</para>
  <para style="q" vid="PSA 148:14">Il che <char style="add">è materia di</char> lode a tutti i suoi santi:</para>
  <para style="q" vid="PSA 148:14">A' figliuoli d'Israele, suo popolo prossimo.</para>
  <para style="q" vid="PSA 148:14">Alleluia.<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">SALMO CXLIX</para>
  <para style="s1">I fedeli lodino il loro Dio</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 149:1">Cantate al Signore un nuovo cantico<note caller="*" style="x"><char style="xo" closed="false">149.1 </char><char style="xk" closed="false">cantico </char><char style="xt" closed="false"><ref loc="PSA 33:3">Sal. 33.3</ref>. <ref loc="ISA 42:10">Is. 42.10</ref>.</char></note>;</para>
  <para style="q" vid="PSA 149:1">
    <char style="add">Cantate</char> la sua lode nella raunanza de' santi.<verse eid="PSA 149:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2"/>Rallegrisi Israele nel suo Fattore<note caller="*" style="x"><char style="xo" closed="false">149.2 </char><char style="xk" closed="false">Fattore </char><char style="xt" closed="false"><ref loc="PSA 100:3">Sal. 100.3</ref> e rif. <ref loc="ISA 54:5">Is. 54.5</ref>.</char></note>;</para>
  <para style="q" vid="PSA 149:2">Festiggino i figliuoli di Sion nel Re loro<note caller="*" style="x"><char style="xo" closed="false">149.2 </char><char style="xk" closed="false">loro </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Zac. 9.9</ref>. <ref loc="MAT 21:5">Mat. 21.5</ref>.</char></note>.<verse eid="PSA 149:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3"/>Lodino il suo Nome sul flauto;</para>
  <para style="q" vid="PSA 149:3">Salmeggingli col tamburo e colla cetera.<verse eid="PSA 149:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4"/>Perciocchè il Signore gradisce il suo popolo;</para>
  <para style="q" vid="PSA 149:4">Egli glorificherà i mansueti per la <char style="add">sua</char> salute.<verse eid="PSA 149:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5"/>I santi festeggeranno con gloria,</para>
  <para style="q" vid="PSA 149:5">Canteranno sopra i lor letti;<verse eid="PSA 149:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6"/>Avranno nella lor gola le esaltazioni di Dio,</para>
  <para style="q" vid="PSA 149:6">E nelle mani spade a due tagli<note caller="*" style="x"><char style="xo" closed="false">149.6 </char><char style="xk" closed="false">tagli </char><char style="xt" closed="false"><ref loc="HEB 4:12">Ebr. 4.12</ref>. <ref loc="REV 1:16">Apoc. 1.16</ref>.</char></note>;<verse eid="PSA 149:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7"/>Per far vendetta fra le genti,</para>
  <para style="q" vid="PSA 149:7">
    <char style="add">E</char> castigamenti fra i popoli.<verse eid="PSA 149:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8"/>Per legare i loro re con catene,</para>
  <para style="q" vid="PSA 149:8">E gli onorati d'infra loro con ceppi di ferro;<verse eid="PSA 149:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9"/>Per mandare ad esecuzione sopra loro il giudicio scritto;</para>
  <para style="q" vid="PSA 149:9">Il che <char style="add">sarà</char> gloria a tutti i suoi santi.</para>
  <para style="q" vid="PSA 149:9">Alleluia.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">SALMO CL</para>
  <para style="s1">Tutte le creature lodino il Signore</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1"/>ALLELUIA.</para>
  <para style="q" vid="PSA 150:1">Lodate Iddio nel suo santuario<note caller="*" style="x"><char style="xo" closed="false">150.1 </char><char style="xk" closed="false">santuario </char><char style="xt" closed="false"><ref loc="PSA 11:4">Sal. 11.4</ref>.</char></note>;</para>
  <para style="q" vid="PSA 150:1">Lodatelo nella distesa della sua gloria.<verse eid="PSA 150:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2"/>Lodatelo per le sue prodezze;</para>
  <para style="q" vid="PSA 150:2">Lodatelo secondo la sua somma grandezza<note caller="*" style="x"><char style="xo" closed="false">150.2 </char><char style="xk" closed="false">grandezza </char><char style="xt" closed="false"><ref loc="DEU 3:24">Deut. 3.24</ref>. <ref loc="PSA 145:5">Sal. 145.5</ref>,<ref loc="PSA 145:6">6</ref>.</char></note>.<verse eid="PSA 150:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3"/>Lodatelo col suon della tromba;</para>
  <para style="q" vid="PSA 150:3">Lodatelo col saltero e <char style="add">col</char>la cetera.<verse eid="PSA 150:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4"/>Lodatelo col tamburo e <char style="add">col</char> flauto;</para>
  <para style="q" vid="PSA 150:4">Lodatelo coll'arpicordo e <char style="add">col</char>l'organo.<verse eid="PSA 150:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5"/>Lodatelo con cembali sonanti;</para>
  <para style="q" vid="PSA 150:5">Lodatelo con cembali squillanti.<verse eid="PSA 150:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6"/>Ogni <char style="add">cosa che ha</char> fiato lodi il Signore.</para>
  <para style="q" vid="PSA 150:6">Alleluia.<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
