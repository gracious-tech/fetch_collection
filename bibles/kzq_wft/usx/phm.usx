<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Kaike Standard Traslation</book>
  <para style="toc3">फिले</para>
  <para style="toc2">फिले</para>
  <para style="toc1">फिलेमोनग पावलन हिगा</para>
  <para style="mt2">फिलेमोनलाई पावलको पत्र</para>
  <para style="mt1">फिलेमोनग पावलन हिगा</para>
  <para style="imt">फिलेमोन्न स्योःचे</para>
  <para style="ip">फिलेमोन्न किताब तुम्म प्रेरित पावल लम सर्पा ङ्याह् <char style="xt"><ref loc="PHM 1:1">1:1</ref></char>। पावल ज्यालग ङ्याह् जब नुई अन सर्बो, कन्न अर्थ जेङ्पा कि नुई अन रोमलै सर्पा ङ्याह्। यदि नु रोमग ङ्याह् र्‌वाङिन अन मसिह केह्तौन क्वाईमाल्‌ला 61 परान ङिक सर्पा ङ्याह्, कन नुई कलसियनकाङ्मोः सर्पान भेला जेङ्पा।</para>
  <para style="ip">नुई अन हिगा फिलेमोन मिह्‌न्न सिमी सर्बो। फिलेमोन मन्दलिन अगुवा रे राङ्पा मालिक यङ ङ्याह्। पावलजै फिलेमोन लम ज्यार्पा जेँन राङ्पा अनेसिमसग सजाय मबिन र्‌वार्‌वा लोम्म नू हिगा सर्बो। रोमी कानुन अन्सार फिलेमोनग ओनेसिमसग सच्‌चेन आङ ङ्याह्। ओनेसिमसग मसिहेन भाइन रुपग स्वीकार खेमः फिलेमोनग प्रोत्साहित खेमः पावलजै हौसला बिन्नान्न ल्होईव प्रयोग खेँ, रे ओनेसिमसग पावलन ङ्याबोई सेवा खेमः अनुमति बिम्म यङ सल्‌ला बिङ्‌ङ <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char></para>
  <para style="iot">छोए</para>
  <para style="io1">पावलजै फिलेमोन <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref></char> ग स्हीम ङिह्पाऊ र्‌वाङ।</para>
  <para style="io1">अन्न ङिक पावलजै मसिहेन भाइन रुपग स्वीकार खेखे ल्होङ्‌ङ <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref></char></para>
  <para style="io1">पावलजै जेन तूसुम स्यास्से रे स्हीम ङिह्पाऊ र्‌वार्‌वा लोल्‌लोई ताह्‌नान। <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />येसु मसिहन भिह्तु ङा झ्यालखानाः त्यापान पावल रे ङिन भाइ तिमोथीलम अन हिगा ङिन ङ्याबो धोन खेनान स्याङ्पान फुरी फिलेमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />ङ्योअन बहिनी अप्फिया रे ङ्योअन फुरी सिपाही अर्खिप्पास, रे नान यिमन मन्दली:<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">कल ४:१७</ref></char></note> <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />ङेनकाङ्मोः दया रे ङ्योअन पा परमेस्वर रे प्रभु येसु मसिहलम सान्ति!<verse eid="PHM 1:3" /></para>
  <para style="s">फिलेमोन्न मया रे बिस्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />ङन भाइ फिलेमोन सोअतापवग जब ङा नाः चिङ्‌ङ तब ङा ङन परमेस्वरग एकुरो मया रह्पा र्‌वानान, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />तैङर्‌वाङिन प्रभु येसु मसिहन ङ्या नान बिस्वासन भारेः रे परमेस्वरन पबित्र सिमिवक्याँ नान मयान भारेः ताँ। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />ङा सोअताप्चे कि नान बिस्वासन सङ्‌गतिजै मसिहग रह्पा ङ्योअन ल्होई लः पुरून ग्यान छार तयाःयो। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ङन भाइ, नान मया लम ङै लै किम्म रे सान्त्वना देप्पा ङिह्पा, तैङर्‌वाङिन ना लम परमेस्वरन पबित्र सिमिवन सम ह्‌याङ ताजा रह्पा ङ्याह्।<verse eid="PHM 1:7" /></para>
  <para style="s">ओनेसिमसन भिह्तु पावलन छ्याफुल</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />नाई तै खेत्वानान, अन खेमः आग्या बिन्चेन भिह्तु मसिहग ङाः हिम्मत ङिनै, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />मयान खातिर बरु ङा नाः छ्याःफुल्सुम ङिह्पा, ङा काप्पो पावल, आलै चोँ येसु मसिहन भिह्तु झ्यालखानाः त्यापान सिमिदी <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />ङन आत्मिक ङोह्जो ओनेसिमसन भिह्तु ङा नाः छ्याःफुल्चे, ङा झ्यालखानाः रातौ मसिहग नुन पा रह्पा ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">कल ४:९</ref></char></note> <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />नु ङू नान भिह्तु काम मीपान सिमि ङ्याह्, जेङ्नै चोँ नान भिह्तु रे ङन भिह्तु यङ फानत्वानान रह्पा ङ्याह्। <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />ङा नू, सु ङन जेँनै समन तुकरा जेङ्पा, नान स्याह्‌ ताप्‌ताप्‌ फेम्मः जाःपा ङिह्पा। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />ल्होन् लःन कारन झ्यालखानाः ङिह्पान भेला नान पूँ नू ङन सेवा खेमः नान्नान ङ्याह्, <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />जेङ्नै नान आदेस मीम ङा तये खेसुम मीपा, ताकि नान भलो करकापजै खेपा नराःयो, जेङ्नै नान जेँनै इच्छ्याई खेपा रायो। <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />हालम ना लम ङाई बेरन भिह्तु ओनिसमस भापा ङ्याह्, ताकि नु एकुरोन भिह्तु नान ङ्याबो छ्युङ् तयाःयो। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />तान धेरा राङ्पालैम नङ्पा, जेङ्नै राङ्पा खेरे ह्‌याल्म, स्याङ्पान भाइलैम, ङोत्वा ङन भिह्तु, जेङ्नै झन ह्‌याल्म ल्होग, प्रभू र्‌वार्‌वा, नान भिह्तु।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />अन्नकारन यदि नाई ङाः जेँनै फुरी छुँङिन ङाः लैम नू स्वीकार ख्या। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />यदि नुई नाः तयाः अलः खेपा रानै, आथबा नु तयाः ल्होईन छेर्सूपा ङिन, अन ङन हिसाबग नाह्‌ना। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />ङा पावल, जेँनै लाह्जै अन सर्चे। अन छेर ङह् फाःनान ङ्युँ। नाः र्‌वापा र्‌वात्वा खेमत्वामतौ, कि जेँनै भिह्तु यङ ना ङन छेरसूपा ङ्याह्। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />स्याङ्पान भाइ, ना लम प्रभू तयाः लाभ धेरायो र्‌वानान ङा सम खेनान। मसिहग ङन समग ह्‌याङ स्याङ्चे धोवाँ। <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />नाई र्‌वापा ङ्यान्नान र्‌वार्‌वा भर नान्नान ङै तोल्पान खेरे हेँ ह्‌याल्म खेनान ङ्याह् र्‌वानान छुछु ङा नाः सर्मः जाःपा ङिह्पा। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />ङ्याबो ङन भिह्तु दम्फु छ्युङ्नान्न कोठादी ठिक्‌क दोङदोङ नाह्‌ना, तैङर्‌वाङिन नान सोअताप लम ङा रे नान स्याह् स्वाचे देङ्‌ङिम कि र्‌वानान आस खेनान।<verse eid="PHM 1:22" /></para>
  <para style="s">अन्त्यन स्हीम ङिह्पाऊ र्‌वापा</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />येसु मसिहग ङन ङ्याबो झ्यालखानाः त्यापान इपाफ्रासजै नाः सिम ङिह्पाऊ र्‌वार्‌वा लोप्पा ङ्याह्। <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />उजुईखेखे ङ्योअन ङ्याबो धोन खेनान मर्कुस, अरिस्तार्खस, देमास रे लुकाई यङ। <verse eid="PHM 1:24" /><verse number="25" style="v" sid="PHM 1:25" />प्रभु येसु मसिहन दया ङेनकोन आत्मान ङ्याबो लुयाःयो।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>