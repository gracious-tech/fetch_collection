<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- KAIKE Standard Traslation</book>
  <para style="toc3">मर्क</para>
  <para style="toc2">मर्क</para>
  <para style="toc1">मर्कूसजै सर्पान ल्होन लः</para>
  <para style="mt2">मर्कुसले लेखेको सुसमाचार</para>
  <para style="mt1">मर्कूसजै सर्पान ल्होन् लः</para>
  <para style="iot">स्योःचे</para>
  <para style="ip">मर्कूसजै सर्पान ल्होन् लः कानुन सार्बान ली किताबवन बर्ग ती जेङ्पा। अनजै येसु मसिहन जिन्दगीन बर्नन खेँ। ख्युन बर्ग पुरूग “ल्होन् लः” र्‌वानान अन्न अर्थ “ल्होन् लः” जेङ्पा। ख्यु मत्ती, मर्कूस, लुका रे यूहन्नालम येसु सितामी सर्पा ङ्याह्। मर्कूसन अन्सार ल्होन् लः ल्होन लीन बर्ग पुरून खेरे तुम्म ङ्याह्। अन यङ मसिह केह्तामी 65-70 परान घूँ पुरू ल्होन् लःन बर्ग ङू सर्पा ङ्यान्नान। लै कानुन लन्नान्न सिमि बिद्‌वानवजै बिस्वास खेङिम कि र्‌वार्‌वा अन रोमग रोमन ईसाईकाङ्मोः हौसला बिन्सुमजै सर्पा ङ्याह्। मर्कूसग यूहन्ना मर्कूस र्‌वार्‌वाई स्योःनान, प्रेरित पावल रे बरनाबास फुरी ङ्याह् जेङ्नै बरनाबासजै जेँन मिसनरी वैमः ख्योवामी नुन सम खङ्पा ङ्याह् <char style="xt"><ref loc="ACT 13:13">प्रे १३:१३</ref></char>। ङिक मर्कूसजै बरनाबास ङ्याबो ह्‌याङ ल्हेम्बो <char style="xt"><ref loc="ACT 15:37-39">प्रे १५:३७-३९</ref></char> मर्कूसग पत्रुसन ग्याप्पा र्‌वार्‌वा स्योःनान <char style="xt"><ref loc="1PE 5:13">१ पत्र ५:१३</ref></char>। जेङ्नै मर्कूस येसुन जिन्दगीन साँचि मह्‌या, कानुन लन्नान्न सिमि बिद्‌वानवजै बिस्वास खेङिम कि र्‌वार्‌वा मर्कूसजै पत्रुसन र्‌वापान ल्होईव लैः रेकत खेबो रे अन मर्कूसन छोएग ल्होन् लःन अर्थ जेङ्पा। ल्होन लग मर्कूस सिचेन भेला चेलापन रे येसुन छोएग जोम्पा ङ्याह्।</para>
  <para style="iot">अन चन घूँन भिह्तु</para>
  <para style="io1">मर्कूसजै अध्याय <char style="ior"><ref loc="MRK 1:1-13">१:१-१३</ref></char> ग किताबन स्योःचे बिन्नान।</para>
  <para style="io1">आलै मर्कूसजै अध्याय <char style="ior"><ref loc="MRK 1:14-8:21">१:१४—८:२१</ref></char> ग येसु गालीलग रातौ नुन धोन्न बर्नन खेँ।</para>
  <para style="io1">आलै नुई येसु यरूसलेम तूपान भारेः र्‌वानान <char style="ior"><ref loc="MRK 8:22">८:२२</ref>; <ref loc="MRK 10:52">१०:५२</ref> </char></para>
  <para style="io1">मर्कूसजै येसु सिह्पा रे सिह्पालै ह्‌याङ सम्पु ग्युर्पा, ङ्याबो यरूसलेमग येसुन पालिन भिह्तु सरसर ताह्‌नान। <char style="ior"><ref loc="MRK 11:1-16:8">११:१—१६:८</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">बप्‌तिस्मा-बिन्नान यूहन्नान ल्होन</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती ३:१-१२</ref>; <ref loc="LUK 3:1-18">लुक ३:१-१८</ref>; <ref loc="JHN 11:19-28">यूह 1१:१९-२८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />परमेस्वरन ङोह्जो येसु मसिहन भारेः ल्होन् लः झामखेखे सुरु राँ। <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />यसैया भबिस्यबक्तान किताबग सर्पान अन्सार:</para>
  <para style="q1" vid="MRK 1:2">परमेस्वरजै र्‌वाबो, “सेह्‌ना, ङा ङन दुतग नान ङूह्ङूह् फेच्‌चे,</para>
  <para style="q2" vid="MRK 1:2">सुई नान लम दोङ्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAT 11:10">मत्ती ११:१०</ref>; <ref loc="MAL 3:1">मला ३:१</ref></char></note><verse eid="MRK 1:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="MRK 1:3" />सुनसान ठाउँग फाईरा खेनान्न केह्ः,</para>
  <para style="q1" vid="MRK 1:3">“परमप्रभुन लम तयार ख्या,</para>
  <para style="q2" vid="MRK 1:3">नुन लम थार्का धोँवा!”<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यसै ४०:३</ref></char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />बप्‌तिस्मा-बिन्नान यूहन्ना सिमिकाङ्मोः बप्‌तिस्मा भिनैभिनै सुनसान ठाउँग रङ्बो। नुई सिमिकाङ्मोः झामखेखे ताह्फेप्पो, “ङेनको घ्योप्पा खेखे तीपा खेमः ख्योवा रे बप्‌तिस्मा होरा आलै परमेस्वरजै ङेनकोन तीपा माफ खेनान ङ्याह्।” <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />यहूदियान प्रदेस रे यरूसलेम सहरग छ्युङ्नान सिमि पुरूव बप्‌तिस्मा बिन्नान यूहन्नान स्याह् स्वाबो। रे ख्युई जे-जेँन तीपा स्वीकारी खेईखेई यूहन्नालम यर्दन चाङ्पू बप्‌तिस्मा वप्पो। <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />बप्‌तिस्मा बिन्नान यूहन्ना ऊँतन पुलै ब्योःपान घोलाङ गोङ्‌ङ, रे हाङग फोन्न धब दम्ङ, रे ङ्योप्पा चन नर्सिङ्‌का रे तप्लन-अकु झाँ।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">२ झली १:८</ref>; <ref loc="MAT 3:4">मत्ती ३:४</ref> </char></note> <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />नुई झाःम र्‌वार्‌वा सिमिवन घूँ ताह्फेप्पो, “सु ङन ङिक स्वाङ नु ङनखेरे सक्तिसाली ङिह्पा, ङा खल्बु क्यापक्याप नुन पौलान तना फोल्चेन सम स्योरस्योरलैम मीपा। <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />ङै ङेनकाङ्मोः त्युई बप्‌तिस्मा बिम्पा ङिह्पा, जेङ्नै नुई ता ङेनकाङ्मोः पबित्र आत्माई बप्‌तिस्मा बिन्नान ङ्याह्।”<verse eid="MRK 1:8" /></para>
  <para style="s">येसुन बप्‌तिस्मा रे छोए सेम्पा</para>
  <para style="r">(<ref loc="MAT 3:13-17">मत्ती ३:१३-१७</ref>; <ref loc="MAT 4:11">४:११</ref>; <ref loc="LUK 3:21-22">लुक ३:२१-२२</ref>; <ref loc="LUK 4:1-13">४:१-१३</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />बप्‌तिस्मा बिन्नान यूहन्नाई झामखेखे ताह्फेप्पाई छ्युङ्पान भेला येसु गालीलन नासरत सहरलै स्वाबो, आलै नुई र्‌वार्‌वा यूहन्नान ल्हालम यर्दन चाङ्पू बप्‌तिस्मा वप्पो। <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />त्युलै खोलोः गेपलुङ्मीम येसुई स्वर्ग पोङ्पा रे पबित्र आत्मा पुरेन्न रुपग जेँन ल्हाः धुल्यङ खेपा रङ्बो। <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />आलै स्वर्गलै झाःम र्‌वापान केह्ः ताह्बो, “ना ङन स्याङ्पान ङोह्जो जेङ्पा, नान ङ्याबो ङा लै स्याङ्पा ङिह्पा।”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />मन्न छाम्म तुरुन्तै पबित्र आत्माई येसू सुनसान ठाउँग वप्पो। <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />स्याह् सैतानलम छोए सेन्चेग थेपथेप नु ङेथलर्यान बेर सुनसान ठाउँग लुईबो, नु तप्लँन भस्तवन ङ्याबो छ्युङ्बो, रे स्वर्गदुतवजै नू सेवा खेबो।<verse eid="MRK 1:13" /></para>
  <para style="s">येसुई ङाह् ज्युङ्नान सिमि लिपाः कताङ्पा</para>
  <para style="r">(<ref loc="MAT 4:12-22">मत्ती ४:१२-२२</ref>; <ref loc="LUK 4:14-15">लुक ४:१४-१५</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />यूहन्ना ज्यालग थेप्मी परमेस्वरन ल्होन् लः ताह्फेरैफेरै येसु गालीलग स्वाबो। <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />नुई र्‌वाबो, “ता भेला पुरा रह्पा ङ्याह्, रे परमेस्वरन राज्य ङेह्‌मः स्वातपा ङ्याह्। घ्योप्पा खेखे तीपा खेमः ख्योवा, रे ल्होन् लःग बिस्वास ख्या।”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />गालील योह्‌न नाः तूतौ येसुई सिमोन रे नुन भाइ अन्द्रियासग योह्ग जाल कायङ खेपा रङ्बो। तैङर्‌वाङिन ख्यु ङाह् जुङ्नान्न सिमि ङ्याह्। <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />आलै येसुई ख्युकाङ्मोः र्‌वाबो, “ङन ङिक जाः, रे ङा ङेनकाङ्मोः सिमिकाङ्मोः परमेस्वरन राज्यग कुजुई सत्त्वानान र्‌वार्‌वा लन्च्योवा।” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />अन ताह्‌लुङ्मीम ख्युई जेँन जालिव ख्योवाख्योवा येसुन ङिक जाःबो। <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />आलै ङाई धेरा वैमी नुई जब्दियान ङोह्जो ङेह्‌ याकूब रे नुन भाइ यूहन्नाः दोङा जालि दोङ्पाई छ्युङ्पा रङ्बो। <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />येसुई ख्युकाङ्मोः र्‌वार्‌वा तुरुन्तै कताङ्बो, रे ख्युई जेँन पा जब्दियाग धोन खेनान सिमिवन ङ्याबो दोङाः ख्योवाख्योवा येसुन ङिक जाःबो।<verse eid="MRK 1:20" /></para>
  <para style="s">येसुई मुई सेम्पा सिमिदीग ताःफाम्पा</para>
  <para style="r">(<ref loc="LUK 4:31-37">लुक ४:३१-३७</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />येसु मन चेलावन ङ्याबो कफर्नहुम सहरग स्वाबो, आलै नाह्‌न ल्हाः यहूदीन आराधनालयग जाःजाः नुई लह्‌म्मः जाःबो। <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />नुई लम्पा ताह्ताह् सिमिव हालाईबो तैङर्‌वाङिन नुई ख्युकाङ्मोः घङ कानुन लन्नान्न सिमिवजै लैम नङ्पा, जेङ्नै आङ किम खेखे लह्‌म्बो।<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />मन्नै भेला यहूदीन आराधनालयन झिङ मुई सेम्पा सिमिदी स्वास्वा फाईरा खेबो, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“हे नासरतन येसु, नाई ङी तै खेमः जाःपा? तै ना ङी मीपा दोङ्मः स्वापा जेङ्पौ? ना सु जेङ्पा र्‌वार्‌वा ङा स्योःनान, ना परमेस्वरन पबित्र सिमि जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भजन १६:१०</ref>; <ref loc="ISA 41:14">यसै ४१:१४</ref>; <ref loc="ACT 3:14">प्रे ३:१४</ref></char></note><verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />जेङ्नै येसुई मन आत्मा अलःग झाःम र्‌वार्‌वा ङार्बो, “तै मर्‌वारे छ्योवा, रे अन सिमिलम गेग्गे वया।” <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />अन र्‌वालुङ्मीम मुई मन सिमी काङ्‌क्याल सुमक्याल धेफानैफानै केह्ः किमई फाईरा खेखे नुनलम गेग्गे होई।<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />अन रङ्नान सिमि पुरूव हालाईलाई र्‌वामः जाःबो, “मोँह् अन तै जेअँ? अन ता सार्बा छोए जेअँ। अन सिमिजै ता आङ खेखे मुवगै कोँह्, रे ख्यु नुई कोह्पा ङ्याम्मन।” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />आलै खम्मै येसुन ल्होई गालील प्रदेसन धेँवछोँ लिब्रुङक्याँ फेल्बो।<verse eid="MRK 1:28" /></para>
  <para style="s">येसुई लै सिमिकाङ्मोः ताःफाम्पा</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्ती ८:१४-१७</ref>; <ref loc="LUK 4:38-41">लुक ४:३८-४१</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />यहूदीन आराधनालयलै तुरुन्तै गेग्गे येसु याकूब रे यूहन्नान ङ्याबो सिमोन रे अन्द्रियासन यिम जाःबो। <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />मन्न ल्हा सिमोन्न मेह् छायोई मिह्दा खङखङ आःपा ङ्याह्, रे येसु स्वा ताप्लुङ्मीम यिमन सिमिवजै अन ल्होई नू स्याप्पो। <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />येसुई रह्‌म्मै वैवै नुन ल्हा जुङजुङ सोल्बो, रे छायोई नू फेप्पो। आलै नुई ख्युन सेवा खेमः जाःबो।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />मन्न ल्हा‌ ङ्याजे ङिह्‌मा स्याःमी सिमिवजै नाह्प्पोवा, खङ्नान रे मुई सेम्पा पुरू सिमिकाङ्मोः येसुन स्याह् सप्पो। <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />रे सहरभरिन सिमिव यिमन झलाः जोम्बो। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />येसुई लैः राँसाराँसान नाह्जाई तेह्पफाम्पा लैः खङ्नानकाङ्मोः ताःफाम्बो, रे लैः मुव छ्यूबो, मुवजै नू स्योःपा ङ्याह्, जेङ्नै नुई ख्युकाङ्मोः ल्होई र्‌वा मफाम्बो।<verse eid="MRK 1:34" /></para>
  <para style="s">गालीलग येसुई ताह्फेप्पा</para>
  <para style="r">(<ref loc="LUK 4:42-44">लुक ४:४२-४४</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />नाह्प नम नाङ्चेन खेरे लैः ङू येसु च्याङच्याङ यिम ख्योवाख्योवा तीपू होई, रे स्याह्‌ सोअताप्पो। <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />सिमोन रे नुन फुरीव नू फाम्म खोलोः गेप्पो। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />नू धोमी ख्युई र्‌वाबो, “पुरूजै नाः फाप्पाई छ्युङ्पा ङ्याह्।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />आलै येसुई ख्युकाङ्मोः र्‌वाबो, “स्वा, ङि ङेह्‌मन घङ नामग भै, रे स्याह्‌ रे ङै ताह्फेच्‌चे धेराःयो, तैङर्‌वाङिन ङा अनै धोन्न भिह्तु स्वापा जेङ्पा।” <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />आलै पुरू गालीलग ख्युन यहूदी आराधनालयग ल्होन् लः ताह्फेरैफेरै रे मुकाङ्मोः छ्यूईछ्यूई ल्हेम्बो।<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्ती ४:२३</ref>; <ref loc="MAT 9:35">९:३५</ref> </char></note><verse eid="MRK 1:39" /></para>
  <para style="s">येसुई कोरन नाह्जा ताह्पा सिमिदीग ताःफाप्पा</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्ती ८:१-४</ref>; <ref loc="LUK 4:12-16">लुक ४:१२-१६</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />आलै कोरन नाह्जा ताह्पान सिमिदी येसुन स्याह्‌ स्वास्वा पोह् जुईजुई झाःम र्‌वार्‌वा छ्याःफुल्बो, “नाई चाहि खेङिन ङाः ताःफान तैनान।”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />तब दिसासा येसुई जेँन ल्हा क्याङक्याङ नू ज्यार्बो रे र्‌वाबो, “ङा चाहि खेनान, ना ताः।” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />आलै नुन कोरन नाह्जा नुनलम होई, रे नु ताःबो। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />आलै येसुई नू करा आग्या बिमबिम झाःम र्‌वार्‌वा तुरुन्तै फेप्पो, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“सेह्‌ना, नाई अन ल्होई सुई नर्‌वा, जेङ्नै वैवै ना जेँगै पुजारीन स्याह्‌ थना रे ना ताःपा सिमिवन साँचिन भिह्तु मोसान आग्या अन्सार भोका फुला।”<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:2-32">लेवी १४:२-३२</ref> </char></note> <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />जेङ्नै अन गेग्गे होई, आलै अन्न भिह्तु खास्या पुरू ताह्फेम्मः जाःबो, रे येसु ह्‌याङ सहरग हाकाहाकि जाःमतैबो, रे तीपू छ्युङ्बो। जेङ्नै सिमिव लिब्रुङक्याँलै नुन रह्‌म्म स्वाबो।<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">येसुई ती ल्हो मगुल्नान्न नाह्जा ताह्पा सिमी ताःफाम्पा</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्ती ९:१-८</ref>; <ref loc="LUK 5:17-26">लुक ५:१७-२६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />खजिर्यान ङिग येसु कफर्नहुम सहरग होल्बो, आलै पुरू सिमिकाङ्मोः नु यिम ङ्याह् र्‌वानान्न ल्होई क्युई रह्बो। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />आलै अकेः ह्‌याल्म सिमीव जोम्बो कि ख्यु स्याह्‌ मस्योङ्बो, स्यीह् थाल कि झलान खोलोः यङ च्याङ्चेन ठाउँ मरह्बो, रे येसुई ख्युकाङ्मोः परमेस्वरन बचन ताह्फेप्पाई छ्युङ्पा ङ्याह्। <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />आलै लिपाई हुर्पान ल्हो मगुल्नान्न नाह्जा ताह्पा सिमिदी सस्सै सिमीव येसुन स्याह्‌ स्वाबो। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />मोह्ङन कारनजै येसुन रह्‌म्म मन सिमी साःमतैबो, रे ख्युई येसु ङिपुन ङ्यान लुह्प पोङ्बो, रे पोङ्पान ठाउँलै ल्हो मगुल्नान्न नाह्जा ताह्पा सिमी नु आःपान खातन ङ्याबोई पोँ साःबो। <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />येसुई ख्युन बिस्वास रङरङ अन ल्हो मगुल्नान्न नाह्जा ताह्पा सिमी र्‌वाबो, “ए ङोह्जो, नान तीपाव माफ रह्बो।”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />जेङ्नै स्याह्‌ कान कानुन लन्नान्न सिमिव छ्युङपा ङ्याह्, रे जेँन समग झाःम र्‌वार्‌वा नावा खेपाई छ्युङ्पा ङ्याह्, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“अन सिमिजै तैङ झामखेखे ल्होई र्‌वाङ? अन ता परमेस्वरन लुह्‌ई झपा जेङ्पा। तीबाःदि, आथबा परमेस्वरजै नङ्म घङ सुई तीपा माफ खेतैनौ?”<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ISA 43:25">यसै ४३:२५</ref></char></note><verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />आलै ख्यु राह्ङराङ्साः झामखेखे नावा खेयङ ङ्याह् र्‌वानान येसुई तुरुन्तै जेँन आत्माः क्युई राह्‌राह्‌ ख्युकाङ्मोः र्‌वाबो, “तैङ ङेन जेँन समग झाःम नावा खेनान? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />ल्हो मगुल्नान्न नाह्जा ताह्पा सिमी ‘नान तीपा माफ रह्बो’ र्‌वाचे, कि ‘च्याँ, नान खात हुरहुर ल्हेना’ र्‌वाचे, कन चन छुम्म ङ्याह्? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />ङा ङेनकाङ्मोः पर्मान बिन्चे जेङ्नै सिमिन ङोह्जो पिर्थीबी तीपा माफ खेचेन आङ ङिह्पा र्‌वानान ङेनकाङ्मोः क्युई रा।” तब येसुई मन ल्हो मगुल्नान्न नाह्जा ताह्पा सिमी र्‌वाबो, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“ङा नाः र्‌वाचे च्याँ, नान खात हुरा, रे यिम वया।”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />अन च्याङ्बो, रे तुरुन्तै खात हुरहुर पुरून ङूलै होई। सिथाल कि, पुरू हालाईबो, रे “ङ्योअजै झाःम ता हातौयै रङ्पा मीपा” र्‌वाईर्‌वाई ख्युई परमेस्वरन महिमा खेमः जाःबो।<verse eid="MRK 2:12" /></para>
  <para style="s">येसुई लेवी स्वा र्‌वापा</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्ती ९:९-१३</ref>; <ref loc="LUK 5:27-32">लुक ५:२७-३२</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />येसु ह्‌याङ तीरेप गालील योह्‌न नाः नाः होई। आलै सिमीवन मोह्ङ किमदी नुन स्याह्‌ स्वाबो, रे येसुई ख्युकाङ्मोः लह्‌म्बो। <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />आलै वैतौ येसुई अल्फयसन ङोह्जो लेवी कर तुईनानवन ठाउँग छ्युङ्पा रङ्बो रे येसुई नू र्‌वाबो, “ङन ङिग जाः।” नु च्याङच्याङ येसुन ङिग जाःबो।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />आलै येसु लेवीन यिम ङ्योप्पा झाम छ्युङ्तौ कर तुईनान लै सिमिव रे पापीव येसु रे नुन चेलावन ङ्याबो छ्युङ्पा ङ्याह्। तैङर्‌वाङिन नुन ङिग जाःनान सिमिव लैः ङ्याह्। <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />नु पापीव रे कर तुईनानवन ङ्याबो ङ्योप्पा झपाई छ्युङ्पा रङरङ फरिसी पातिन कानुन लन्नान्न सिमिवजै नुन चेलाकाङ्मोः र्‌वाबो, “नु तैङ कर तुईनानव रे पापीवन ङ्याबो छ्युङछ्युङ झाँ?” <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />अन ताह्ताह् येसुई ख्युकाङ्मोः र्‌वाबो, “नाह्जा मीपा सिमिकाङ्मोः दाक्तार मत्वानान, जेङ्नै नाह्प्पुवाकाङ्मोः मात्र त्वानान। ङा धर्मीकाङ्मोः नङ्पा, जेङ्नै पापीकाङ्मोः स्वा र्‌वामः स्वापा जेङ्पा।”<verse eid="MRK 2:17" /></para>
  <para style="s">बर्तन भारेः प्रस्‌न</para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्ती ९:१४-१७</ref>; <ref loc="LUK 5:33-39">लुक ५:३३-३९</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />यूहन्नान चेलाव रे फरिसीव बर्त छ्युँ। मन्नकारन सिमीवजै स्वास्वा येसू र्‌वाबो, “यूहन्नान चेलाव रे फरिसीन चेलाव बर्त छ्युँ, जेङ्नै नान चेलाव तैङ बर्त मछ्यूँ?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />येसुई ख्युकाङ्मोः झब बिम्बो, तै भत्यारग घ्वापान लार्क्याव ङ्योप्पा मझारे वैनान तै? माःपान ङ्याबो रातौ सुई फोङै मछ्युङ्नान। <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />जेङ्नै भेला स्वानान ङ्याह्, जब माःपा ख्युनलम फानान ङ्याह्, तब ख्यु मन्न लाह्‌ बर्त छ्युङ्नान ङ्याह्।<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“सुई घोलाङ घ्वापाः सार्बा घोलाङन लाम्मा मताम्नान, तेमन्ता ताम्पान घोलाङ ज्योमज्योम गेन्नान, आथबा सार्बा घ्वापालै ज्योमज्योम गेन्नान, रे ज्योमताँ झन अलः राह्‌नान ङ्याह्। <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />आलै सुई अङ्‌गुरन खु सार्बा फोन घ्वापान खुन्चाः मकाह्‌नान, तेमन्ता मन अङ्‌गुरन खुजै फोन्न खुन्चाव तिल्नान, रे अङ्‌गुरन खु रे खुन्चा ङ्योरुम मीपा राह्‌नान। जेङ्नै सार्बा अङ्‌गुरन खु चन सार्बाई धाङग काह्‌नान।”<verse eid="MRK 2:22" /></para>
  <para style="s">नाह्‌न ल्हाःन भारेः प्रस्‌न</para>
  <para style="r">(<ref loc="MAT 12:1-14">मत्ती १२:१-१४</ref>; <ref loc="LUK 6:1-5">लुक ६:१-५</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />ती नाह्‌न ल्हाः येसु रुन्जन्न साह्ईन खेःलम राह्‌राह्‌ वैयङ खेपा ङ्याह्। स्याह्‌लै वैतौ नुन चेलावजै लेन्तौलेन्तौ साईन नम चामः जाःबो। <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />अन रङरङ फरिसीवजै येसू र्‌वाबो, “सेह्‌ना, नाह्‌न ल्हाः कानुनजै खेचे नङ्पा र्‌वापान धोन यङ नान चेलावजै तैङ खेँ?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />येसुई ख्युकाङ्मोः र्‌वाबो, “जब दाऊद रे नुन ङ्याबो ङिह्पाकाङ्मोः ल्हाग तये मर्हारे गुसिपा ङ्याह् तब दाऊदजै तै खेबो? तै ङेनकोजै हातौयै तोअपा मीपाऊ? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />प्रधान पुजारी अबियाथारन पाली परमेस्वरन यिम दाऊद जाःबो, रे परमेस्वरग फुल्पान रोता झबो, कानुन्न अन्सार पुजारीजै नङ्म घङ सिमिजै झाचे लः मह्‌या, रे अन रोता नुन ङ्याबो ङिह्पाकाङ्मोः र्‌वार्‌वा बिम्बो।” <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />ख्युकाङ्मोः येसुई र्‌वाबो, “नाह्‌न ल्हाः सिमिन भिह्तु दोङ्पा जेङ्पा, सिमि नाह्‌न ल्हाःन भिह्तु नङ्पा। <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />अन्नकारन सिमिन ङोह्जो नाह्‌न ल्हाःनै प्रभु जेङ्पा।”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">ल्हा खार्पा सिमि ताःपा</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्ती १२:९-१४</ref>; <ref loc="LUK 6:6-11">लुक ६:६-११</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ङाईलै ह्‌याङ येसु येहूदी आराधनालयग जाःबो। स्याह्‌ ल्हा खार्पा सिमिदी ङ्याह्। <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />कार्तौ येसुई नू नाह्‌न ल्हाः ताःफाङ्‌ङिम कि र्‌वार्‌वा नू दोस बिन्चेन भिह्तु जासुस खेनान्न सिमिव रे स्याह् ङ्याह्। <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />तब येसुई ल्हा खार्पा सिमी र्‌वाबो, “स्यीह् स्वास्वा घूँ च्याँ।” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />येसुई ख्युकाङ्मोः र्‌वाबो, ल्हूलामन कानुन अन्सार “नाह्‌न ल्हाः भलो खेचे कि अलः खेचे, परान सोमफान्चे कि सच्‌चे, कन चन लः ङ्याह्?” जेङ्नै ख्यु तै मर्‌वारे छ्युङ्बो।<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LUK 14:3">लुक १४:३</ref></char></note> <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />ख्युन सम क्योङ्मन कारन तूँलाक्या राह्‌राह्‌ सुतूतू येसुई ख्यु पुरूग सेम्बो आलै मन सिमी र्‌वाबो, “नान ल्हा क्याँ।” नुई ल्हा क्याङ्बो रे नुन ल्हा ताःबो।<verse eid="MRK 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 3:6" />तब फरिसीव यहूदी आराधनालयलै गेग्गे होई रे तुरुन्तै हेरोद झलीन सिमिवन ङ्याबो दोदो येसू कुजुई सच्‌चे र्‌वार्‌वा नुन बिरोधग सल्‌ला खेबो।<verse eid="MRK 3:6" /></para>
  <para style="s">योह्‌न नाक्याँ सिमिवन मोह्ङ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />आलै येसु जेँन चेलावन ङ्याबो गालीलन योह्क्याँ होई, सिमिवन मोह्ङ किम नुन ङिक जाःबो। ख्यु गालील रे यहूदिया प्रदेसलै स्वापा ङ्याह्। <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />यरूसलेम, इदुमिआ, यर्दन चाङ्पुन धिक्याँ रे तुरोस रे सीदोनन धेँवछोँलै सिमिवन मोह्ङ किम येसुन ताईलुवान धोन्न ल्होन ताह्ताह् नुन ङ्याबो स्वाबो। <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />मोह्ङजै नू नचियायो र्‌वार्‌वा येसुई जेँन चेलाकाङ्मोः जेँन भिह्तु दोङादी तयार खेफाम्बो। <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />येसुई लै सिमि ताःफाम्पा राह्‌राह्‌ नाह्जा ताह्पा पुरूजै नु ज्यार्चेन भिह्तु फुल्चीफुल्ची खेँ। <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />जब मुवजै येसू रँ, तब नुन ङू खल्बु क्यापक्याप झाःम र्‌वाईर्‌वाई फाईरा खेँ, “ना परमेस्वरन ङोह्जो जेङ्पा।”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />येसुई मुकाङ्मोः नु सु जेङ्पा र्‌वार्‌वा सुई नर्‌वा र्‌वार्‌वा करा आग्या बिम्बो।<verse eid="MRK 3:12" /></para>
  <para style="s">येसुई प्रेरित च्योङेपाः दम्पा</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्ती १०:१-४</ref>; <ref loc="LUK 6:12-16">लुक ६:१२-१६</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />आलै येसु धुरग लिप्पो, रे नुई चाहि खेपान सिमी स्वा र्‌वाबो, रे ख्यु नुन स्याह् स्वाबो। <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />नुई च्योङेपाः दम्बो, सुन मिह्‌न प्रेरित नाह्‌म्बो, नुई ख्युकाङ्मोः र्‌वाबो, “ङै ङेनकाङ्मोः ङन ङ्याबो छ्युङ्नान्न भिह्तु दम्पा। ङा ङेनकाङ्मोः ल्होन् लः ताह्फेच्‌चेन भिह्तु खोलोः फेच्‌चे। <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />रे ख्युकाङ्मोः मुव छ्यूचेन आङ रे बिम्बो।”<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />येसुई अजोवी च्योङेपा दम्बो: सिमोन, सू येसुई पत्रुस मिह्‌न नाह्‌म्बो, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />जब्दियान ङोह्जो याकूब रे याकूपन भाई यूहन्ना। नुई ख्युकाङ्मोः बोअनर्गेस, आथबा गर्जन्न ङोह्जो र्‌वानान्न मिह्‌न नाह्‌म्बो। <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />अन्द्रियास, फिलिप, बारथोलोमाइ, मत्ती, थोमा, अल्फयसन ङोह्जो याकूब, रे थेदियस, सिमोन कनानी, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />रे यहूदा इस्करियोत सुई येसू धोका बिमबिम जुङ्फाम्पा ङ्याह्।<verse eid="MRK 3:19" /></para>
  <para style="s">येसु रे बालजिबुल</para>
  <para style="r">(<ref loc="MAT 12:22-32">मत्ती १२:२२-३२</ref>; <ref loc="LUK 11:14-23">लुक ११:१४-२३</ref>; <ref loc="LUK 12:10">१२:१०</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />आलै येसु यिम होई। ह्‌याङ अकेःन मोह्ङ जोम्बो, कि येसु रे नुन चेलावजै ङ्योप्पा झाचेई मदेप्पो। <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />जब येसुन पयारजै अन ताह्बो, तब नू वच्‌चेन भिह्तु ख्यु गेप्पो, तैङर्‌वाङिन नुन सम मानग मह्‌या र्‌वार्‌वा सिमिव र्‌वाङ। <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />यरूसलेमलै स्वापा कानुन्न कानुन लन्नान्न सिमिवजै र्‌वाबो, “नुन स्याह् बालजिबुल मु ङ्याह्, रे मुवन मालिकन सक्तिलम नुई मुव छ्यूङ।”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />जेङ्नै येसुई ख्युकाङ्मोः जेँन रह्‌म्म स्वा र्‌वार्‌वा द्रिस्तान्तवग ल्होई र्‌वाबो, “सैतानजै सैतानग कुजुई छ्यू तैनान? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />यदि कान राज्यन राह्ङराङ्साः बिरोध राङिन अन राज्य थुप मतैनान। <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />कान यिमनै राह्ङराङ्साः बिरोध राङिन मन यिम थुप मतैनान। <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />यदि सैतानजै सैताननै राज्यन बिरोधग च्याङच्याङ भाचेन ल्होई सङ्‌ङिन अन थुप मतैनान, जेङ्नै नुन अन्त्य स्वातपा राह्‌नान।” <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />सुई ङार्छेम सिमिन यिम जाःजाः पहिले नू मखीन बेर नुई अन ङार्छेम सिमिन क्यु खु मतैनान। नुई नू खीतामी मात्र नुन यिम खुतैनान।<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, “सिमिवन तीपा पुरू रे लान ल्हुई झपा माफ खेनान ङ्याह्, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />जेङ्नै पबित्र आत्मान बिरोधग ल्हुई झानान्न सिमी तै खेखेई माफ राह्‌नान मह्‌या, जेङ्नै अन मताह्‌नान्न तीपान दोसी ठहरी राह्‌नान।” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />नुई अन ल्होई र्‌वाबो, “तैङर्‌वाङिन नुन स्याह् मु ङ्याह्” र्‌वार्‌वा कान सिमिवजै र्‌वापा ङ्याह्।<verse eid="MRK 3:30" /></para>
  <para style="s">येसुन मा रे थिक्‌कोव</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्ती १२:४६-५०</ref>; <ref loc="LUK 8:19-21">लुक ८:१९-२१</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />तब येसुन मा रे थिक्‌कोव स्याह्‌ स्वाबो, रे खोलोःई च्याङच्याङ नू स्वा र्‌वामः कान तीपा फेप्पो। <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />मोह्ङ नुन धेँवछोँ छ्युङ्पा ङ्याह् रे ख्युई येसू र्‌वाबो, “सेह्‌ना, ङेन मा रे ङेन जिङ्‌कोव खोलोः नाः फाङ्‌ङ।”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />येसुई ख्युकाङ्मोः झब बिमबिम र्‌वाबो, “ङन मा रे ङन थिक्‌कोव सु जेङ्पा?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />आलै जेँन धेँवछोँ लिब्रुङक्याँ सेनसेन नुई र्‌वाबो, “सेह्‌ना, अजोव जेङ्पा ङन मा रे ङन थिक्‌कोव। <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />तैङर्‌वाङिन सुई परमेस्वरन इच्छ्या ङ्यान्नान नुई ङन मा, भाइ रे बहिनी जेङ्पा।”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">र्‌यु पन्नान्न द्रिस्तान्त</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्ती १३:१-९</ref>; <ref loc="LUK 8:4-8">लुक ८:४-८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />ङाईलै ह्‌याङ गालील योह्‌न नाः येसुई लह्‌म्मः जाःबो। नुन लिब्रुङक्याँ लैः सिमिवन मोह्ङ जोम्पा राह्‌राह्‌ नु योह्ग ङिह्पान दोङादीग चपचप नाःलै धिङाः वैवै छ्युङ्बो। सिमिव चन मन नाःन साः छ्युङ्बो। <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />आलै येसुई ख्युकाङ्मोः द्रिस्तान्तवग लै ल्होई लह्‌म्बो। नुई जेँन छोएग ख्युकाङ्मोः झाःम र्‌वाबो:<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“ङ्याना, र्‌यु पन्नान्न सिमिदी र्‌यु पच्‌चेन भिह्तु गेप्पो। <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />आलै नुई र्‌यु पन्तौ कान लम्‌राः छार्बो, रे अन र्‌यु युजुई स्वास्वा झबो। <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />कान र्‌यु सा ताङ्‌खोराः छार्बो। स्याह्‌ सा ङाईदी ङिह्पान कारन मन यिप्पुदी थुङ्बो। <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />ङिह्‌मा लैः छाम रामी गुगुर्माव द्याबो, रे पादा मछ्यापान कारन मन खार्बो। <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />कान र्‌यु चन चेरन घूँ छार्बो। चेर छारैछारै होई, रे बोती च्योर्बो, आलै मनग फल‌ मछ्याबो। <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />जेङ्नै कान र्‌यु सा लःग छार्बो, रे थुङैथुङै रे छारैछारै होई गुना सुमच्यु, गुना सुमथल रे गुना ङाथल फल‌ बिम्बो।” <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />आलै येसुई र्‌वाबो, “सुन ङ्यान्नान्न नाम्ज्योवा ङ्याह्, नुई ङ्यानाःयो।”<verse eid="MRK 4:9" /></para>
  <para style="s">द्रिस्तान्तन उदेस्य</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्ती १३:१०-१७</ref>; <ref loc="LUK 8:9-10">लुक ८:९-१०</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />जब येसु तितिमाई रह्बो, तब चेला च्योङेपाव रे नुन धेँवछोँ ङिह्पान सिमिवजै येसू द्रिस्तान्तन भिह्तु लोप्पो। <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />येसुई ख्युकाङ्मोः र्‌वाबो, “परमेस्वरन राज्यन रहस्य ङेनकाङ्मोः बिम्पा ङ्याह्, जेङ्नै खोलोःन सिमिकाङ्मोः चन ल्होई पुरू द्रिस्तान्तग र्‌वानान, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />कि ख्यु सेन्चे ता सेह्ङ्‌ङ, जेङ्नै मरँ, ताचे ता ताँ, जेङ्नै हामकोँ, तेमन्ता ख्युई घ्योप्पा खेखे परमेस्वरक्याँ होल्नान ङ्याह् रे ख्युन तीपा माफ राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यसै ६:९-१०</ref></char></note><verse eid="MRK 4:12" /></para>
  <para style="s">येसुई र्‌यु पन्नान द्रिस्तान्तन अर्थ स्याप्पा</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्ती १३:१८-२३</ref>; <ref loc="LUK 8:11-15">लुक ८:११-१५</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनको अन द्रिस्तान्तन अर्थ हामकोँ? उजु जेङ्न घङ द्रिस्तान्त पुरूवन अर्थ कुजुई हाकोदरा? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />र्‌यु पन्नानजै परमेस्वरन बचन पन्नान। <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />कान सिमिव लम्‌राः पप्पान र्‌युलैम ङ्याह्। जब ख्युई बचन ताह्‌नान, तब तुरुन्तै सैतान स्वानान, रे ख्युकाङ्मोः पप्पान बचन वन्नान। <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />उजुखेखे सा ताङ्‌खोराः पप्पाव अजोव जेङ्पा, सुई जब बचन ताह्‌नान तब स्याङस्याङ तुरुन्तै अन स्वीकार खेनान। <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />जेङ्नै ख्युन जेँन पादा मछेःपा राह्‌राह्‌ मन ङाई बेर मात्र थुप्नान। जेङ्नै जब बचन्न कारन तूरि या तेह्पफाम्पा स्वानान, ख्यु तुरुन्तै दिम्नान। <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />चेरन घूँ पप्पा अनै जेङ्पा, सुई बचन ताह्‌नान, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />जेङ्नै अन सन्सारन छरा, क्युन लोभ रे घङ मालन लोभ स्वास्वा बचनग च्योर्नान। आलै मनग फल‌ मछ्याःनान। <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />जेङ्नै सा लः पप्पाव मन जेङ्पा, सुई बचन ताह्‌नान, स्वीकारी खेनान, रे फल बिन्नान गुना सुमच्यु, गुना सुमथल रे गुना ङाथल।”<verse eid="MRK 4:20" /></para>
  <para style="s">लज्युङ्न द्रिस्तान्त</para>
  <para style="r">(<ref loc="LUK 8:16-18">लुक ८:१६-१८</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />येसुई ख्युकाङ्मोः र्‌वाबो, “तै सुई लज्युङ पार्पार फाक्तिन्न पोँ आथबा खातन पोँ नान्चे र्‌वार्‌वा झिङ सन्नौ? तै सामदान्न ल्हाः नान्चे र्‌वार्‌वा नङ्पा तै? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />चिज तये क्युक्यु नान मतैनान कन थन्नान मह्‌या, आलै चिज तये फाक मह्‌या कन साल्मः सन्नान मह्‌या। <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />यदि कान सिमिन ङ्यान्चेन नाम्ज्योवा ङिङिन नुई ङ्यानाःयो।”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />येसुई ह्‌याङ ख्युकाङ्मोः र्‌वाबो, “ङेनको तै ताह्‌नान, मनग ध्यान भिना। तैङर्‌वाङिन कन नापजै ङेनको बिन्नान ङेनकोजै अनै नापजै देन्नान। रे ङेनकाङ्मोः झन ह्‌याल्म बिन्नान ङ्याह्। <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />तैङर्‌वाङिन सुन ङ्याबो ङ्याह् नू झन ह्‌याल्म बिन्नान ङ्याह्, रे सुन ङ्याबो मह्‌या नुन ङ्याबो ङिह्पा यङ नुनलम तल्नान ङ्याह्।”<verse eid="MRK 4:25" /></para>
  <para style="s">छार्नान र्‌युन द्रिस्तान्त</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />येसुई र्‌वाबो, “परमेस्वरन राज्य झाःम जेङ्पा, कान सिमि तीपाई साः र्‌यु पह्ङ्‌ङ, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />रे नु आःनै, सापसाप छ्युङ्नै ङिम्मेछाम्मे अन र्‌यु थुङ्नान रे छार्नान, जेङ्नै अन कुजुई छार्नान, अन नू क्युई मराह्‌नान। <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />सा जेँजै थुङ्नान, पहिली गुगुर्मा, आलै नम, ह्‌याङ नमग पुरू गेल्‌ला छ्यानान। <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />जेङ्नै जब साई मिन्नान, तब नुई तुरुन्तै खदमाई गम्मः जाःनान, तैङर्‌वाङिन गेल्‌ला चाचेन भेला स्वातपा राह्‌नान।”<verse eid="MRK 4:29" /></para>
  <para style="s">रायोन र्‌युन द्रिस्तान्त</para>
  <para style="r">(<ref loc="MAT 13:31-34">मत्ती १३:३१-३४</ref>; <ref loc="LUK 13:18-19">लुक १३:१८-१९</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />येसुई ह्‌याङ र्‌वाबो, “परमेस्वरन राज्य तैन ङ्याबो तुर्चे? आथबा कन द्रिस्तान्तग अन्न बर्नन खेचे? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />अन ता छून र्‌यु लैम ङ्याह्, अन साः पन्नान। पिर्थीबिभरी र्‌यु पुरूव खेरे छ्युम रानै <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />जब अन पन्नान, तब छार्नान, रे सागपात पुरून खेरे अन किम राह्‌नान, रे नुई धा किम-किम दोङ्नान, रे पान्नाङ्न युजुई अन्न छाहारीग चाङ दोङ्नान।” <verse eid="MRK 4:32" /><verse number="33" style="v" sid="MRK 4:33" />ख्युई हाकोतैन बेर येसुई झाःमै लै द्रिस्तान्तव र्‌वार्‌वा ख्युकाङ्मोः बचन स्याप्पो। <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />द्रिस्तान्त मीम नु ख्युन ङ्याबो ल्होई मर्‌वाबो, जेङ्नै जेँन चेलाव मात्र रातौ चन नुई द्रिस्तान्त पुरून अर्थ भुझाई खेँ।<verse eid="MRK 4:34" /></para>
  <para style="s">येसुई लन छ्याफाम्बो</para>
  <para style="r">(<ref loc="MAT 8:18">मत्ती ८:१८</ref>,<ref loc="MAT 8:23-27">२३-२७</ref>; <ref loc="LUK 8:22-25">लुक ८:२२-२५</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />मन्न लाह्‌ः नम्जे रुम्मी येसुई चेलाकाङ्मोः र्‌वाबो, “स्वा, ङि धिक्याँ भै।” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />आलै मोह्ङन ङ्याबो भिदा वप्मी, येसु कन दोङाः छ्युङ्पा ङ्याह् मनगै नू चेलावजै जेँन ङ्याबो वप्पो। रे घङ दोङाव रे नुन ङ्याबो ङ्याह्। <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />आलै स्याह्‌ लन किम स्वाबो, रे छ्योलापव दोङाः ठ्वामः जाःबो, स्यीह् थाल कि दोङा त्युई नाङ्मः जाःबो। <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />येसु जेँ चन दोङान ङीक्याँ खुमदी काका मिवा च्युपा ङ्याह्। ख्युई नू झाःम र्‌वाईर्‌वाई सोल्बो, “गुरुज्यू, ङि नुप्मः जाःबो र्‌वानान नाः वास्ता मीपाऊ?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />तब येसु च्याङ्बो, रे लनग ङार्बो, रे समुन्द्रन छ्योलापकाङ्मोः र्‌वाबो, “सान्त रा! छ्या!” आलै लन छ्याबो रे सान्त रह्बो। <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />येसुई चेलाकाङ्मोः र्‌वाबो, “ङेनको तैङ झामखेखे ङिन्नान? ङेनको ङ्याबो हेँ बिस्वास मीपाऊ?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />ख्यु मिह्दा ङिह्‌म्बो रे राह्ङराङ्साः र्‌वामः जाःबो, “नु सु जेङ्पा? लन रे समुन्द्रजै नुन र्‌वापा ङ्याङ्‌ङ।”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">येसुई मु ताह्पा सिमी ताःफाम्पा</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्ती ८:२८-३४</ref>; <ref loc="LUK 8:26-39">लुक ८:२६-३९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />येसु रे नुन चेलाव गालील योह्‌न धेरा गेरासेनसन छेत्रग स्वाबो। <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />येसु दोङालै खोलोः गेप्लुङ्मीम तुह्‌र्सालै खोलोः स्वास्वा मु ताह्पा सिमिदीजै येसू धोबो। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />अन तुर्सा रह्पू छ्युँ। सुई नू साँगलजै खीखी नान मतैङ। <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />तैङर्‌वाङिन अन लै नेल रे साँगलजै खीपा ङ्याह्, जेङ्नै नुई साँगलव तुकरा तुकरा खेखे परेङ्‌ङ। सिमि सुई र्‌वार्‌वा नू अधिनग नान तैपा मह्‌या। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />अन ङिम्मेछाम्मे एकुरो तुर्साव रे धुरवग फाईरा खेईखेई जेँजै जेँगै लुङजै छैछै ल्हेङ्‌ङ। <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />आलै जब नुई येसू ग्याङमलै रङ्बो तब धालैधालै स्वाबो, रे येसुन ङू खल्बू क्यापक्याप छ्याःफुल्बो। <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />आलै केह्ः किमै फाईरा खेखे नुई र्‌वाबो, “हे पुरून खेरे किम परमेस्वरन ङोह्जो येसु, नाई ङाः तै खेमः जाःपा जेङ्पा? ङा परमेस्वरग रेनरुरु नाः छ्याफुल्चे, कि ङा तूरि नबिना।”<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 8:29">मत्ती ८:२९</ref>; <ref loc="1KI 17:18">१ झली १७:१८</ref></char></note> <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />तैङर्‌वाङिन येसुई नू र्‌वापा ङ्याह्, “ए मु, मन सिमीलै गेग्गे वया।”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />आलै येसुई नू लोप्पो, “नान मिह्‌न तै जेङ्पा?” नुई नू झब बिम्बो, “ङन मिन फौज जेङ्पा, तैङर्‌वाङिन ङि लै ङिह्पा।” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />आलै नुई येसू मन ठाउँलै मुकाङ्मोः खोलोः नछ्यूयायो र्‌वार्‌वा घलिछ्याचल र्‌वार्‌वा छ्याःफुल्बो।<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />स्याह्‌ ङेह्‌मन धुरग छ्योअन मोह्ङ किमदी छापाई छ्युङ्पा ङ्याह्। <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />आलै मन मुवजै झाःम र्‌वार्‌वा येसू छ्याःफुल्बो, “ङी छ्योअवन ङ्याबो वै फाना, रे ङि ख्युन झिङ जाचे।” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />तब नुई ख्युकाङ्मोः वैफाम्बो, रे मुव मन सिमिलम गेग्गे छ्योअवन झिङ जाःबो, आलै क्वाईमाल्‌ला हजार ङेह्तौ छ्योवान अन मोह्ङ जारग लम योह्क्याँ पाह्‌मैपाह्‌मै होई, रे योह्ग नुपनुप सिबो।<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />मन छ्योवा छानान्न सिमिव ज्यार्बो, रे सहर रे नाम नामग ताह्फेप्पो। रे तै रह्दँ र्‌वार्‌वा सेह्‌म्म सिमिव स्याह्‌ स्वाबो। <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />तब ख्यु येसुन स्याह् स्वाबो, रे रङ्बो कि अन मु ताह्पान सिमि लः राह्‌राह्‌ घोलाङ गोनगोन छ्युङ्पा ङ्याह्। अन रङरङ ख्यु ङिह्‌म्बो। <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />आलै सुई अन रङ्पा ङ्याह्, ख्युई मु ताह्पा सिमि रे छ्योअकाङ्मोः तै रह्पा ङ्याह् अन सिमिकाङ्मोः स्याप्पो। <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />आलै ख्युन छेत्रलै वया र्‌वार्‌वा सिमिवजै येसू छ्याःफुल्मः जाःबो।<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />येसु दोङाः चप्म जातौ अन मु ताह्पा सिमिजै नुन ङ्याबो वैचेन भिह्तु छ्याःफुल्बो।<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />जेङ्नै येसुई नू वैमफाम्बो, आलै नू र्‌वाबो, “ना जेँन यिम वैवै नान जेँन सिमिकाङ्मोः प्रभुई नान भिह्तु खेपान मकेकुकेन किम धोन रे ना थम्पान दया किमन बर्नन ख्या।” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />आलै अन सिमि होई, रे येसुई नुन भिह्तु कताःमन धोन किम खेपा ङ्याह् अन देकापोलिस भरी ताह्फेम्मः जाःबो, रे अन ताह्‌नान सिमि पुरूवजै हालाईबो।<verse eid="MRK 5:20" /></para>
  <para style="s">याइरसन चमेः रे येसुन घोलाङ ज्यार्नान चिमिचा</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्ती ९:१८-२६</ref>; <ref loc="LUK 8:40-56">लुक ८:४०-५६</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />जब येसु ह्‌याङ दोङाः चपचप योह्‌न धिक्याँ होई, तब मोह्ङ किमदी नुन धेँवछोँ जोम्बो। नु चन योह्‌न नाः ङ्याह्। <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />यहूदी आराधनालयन अगुवावन बर्ग याइरस मिह्‌न्न सिमिदी येसुन स्याह् स्वाबो, रे नू रङरङ नुन ल्हेग खल्बु क्याप्पो, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />रे झाःम र्‌वार्‌वा छ्याःफुल्बो, “ङन कत्याम चमेः सिम जाःपा ङ्याह्, स्वास्वा नुन ङ्या ङेन ल्हा नाह्‌ना, रे अन ताःयो रे सोनायो।”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />तब येसु नुन ङ्याबो होई। मोह्ङ किमदी नुन ङिग जाःबो, रे सिमिव नुन धेँवछोँ फुल्चीफुल्ची खेमः जाःबो। <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />आलै च्योङे परान ङूलै कह वैनान्न नाह्जा ङिह्पा चिमिचादी स्याह्‌ ङ्याह्। <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />नुई लै अम्जीवन स्याह् वैवै यङ तातैपा मह्‌या। जेँन ङ्याबो ङिह्पान क्यु पुरू अन्नै भिह्तु खर्च खेतपा ङ्याह्, जेङ्नै ताःचेन पूँ झन स्हरजै नू जुङ्पा ङ्याह्। <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />येसुन भारेः नुई ताह्पा ङ्याह्, रे नुई मोह्ङन ङिक्याँलै स्वास्वा येसुन घोलाङ ज्यार्बो।<verse eid="MRK 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 5:28" />तैङर्‌वाङिन नुई समसमग र्‌वाबो, “ङै नुन घोलाङ मात्र ज्यार्ङिनै ङा ताःनान ङ्याह्।”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />नुई येसुन घोलाङ ज्यार्बो रे तुरुन्त नुन कह वैचे छ्याबो, रे जेँन ल्होन नाह्जा ताःपा नू क्युई रह्बो। <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />जेँनलम सक्ति खोलोः गेप्पा येसू हरक्‌क क्युई राह्‌राह्‌ मोह्ङक्याँ होलहोल लोप्पो, “ङन घोलाङ सुई ज्यार्बो?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />चेलावजै येसू र्‌वाबो, “मोह्ङजै फुल्चीफुल्ची खेपा ता ङेनजै रङ्पाई ङ्याह्, जेङ्नै ङेन र्‌वाङ ‘सुई ङा ज्यार्बो?’”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />जेङ्नै येसुई जेँग सुई ज्यार्बो र्‌वार्‌वा धेराछोरा सेह्‌म्बो। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />तब जेँग तै रह्पा ङ्याह् अन क्युई राह्‌राह्‌ अन चिमिचा ङिनङिन दारैदारै स्वास्वा येसुन ङू खल्बु क्याप्पो, रे नू तेम्मा ल्होई पुरू र्‌वाबो। <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />तब नुई चिमिचाः र्‌वाबो, “ए चमेः, नान बिस्वासजै नाः ताःफाम्पा ङ्याह्। ता नान स्हर वयायो रे ना किम्म खेखे वया।”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />येसुई झाःम र्‌वातौर्‌वातौ हाकिम याइरसन यिमलै सिमिव स्वास्वा र्‌वाबो, “ङेन चमेः ता सिबो। गुरुज्यूग ता घङ तूरि तैङ बिन्नान?” <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />जेङ्नै ख्युई र्‌वापान ल्होईवग ध्यान मबिमबिम येसुई येहूदी जोम्पुन हाकिमग र्‌वाबो, “नङिना, बिस्वास मात्र ख्या।” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />आलै नुई पत्रुस, याकूब रे याकूपन भाई यूहन्ना नङ्म घङ सुई जेँन ङ्याबो स्वा मफाम्बो। <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />ख्यु यहूदी जोम्पुन हाकिम याइरसन यिम स्वाबो, आलै नुई फाईराकुईरा खेनानव, दानानव रे बैरा खेखे दानानकाङ्मोः रङ्बो। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />झिङ जाःजाः नुई ख्युकाङ्मोः र्‌वाबो, “ङेनको तैङ फाईराकुईरा खेनान तैङ दानान? कोम्मे सिह्पा मह्‌या, जेङ्नै आःपाई छ्युङ्पा ङ्याह्।” <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />जेङ्नै ख्यु नुन ल्होईग रैबो। तब नुई ख्यु पुरूग खोलोः छ्यूबो, रे कोम्मेन पोमा रे नुन चेलाकाङ्मोः ङ्याबो वव्वै कोम्मे ङिपुन झिङ होई। <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />आलै कोम्मेन ल्हा जुङजुङ येसुई नू र्‌वाबो, “तालिता कूमी” अन्न अर्थ जेङ्पा, “ए कोम्मे, ङा नाः र्‌वाचे, च्याँ।” <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />आलै कोम्मे तुरुन्तै च्याङ्बो, रे ल्हेम्म जाःबो। नु च्योङे परान ङ्याह्। आलै मन्नै भेला सिमिव मिह्दा हालाईबो। <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />नुई ख्युकाङ्मोः अन सुई क्युई नराःयो र्‌वानान्न करा आग्या बिम्बो। आलै कोम्मेग तयाः झाफाना र्‌वार्‌वा ख्युकाङ्मोः र्‌वाबो।<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरतग येसू अस्वीकार खेपा</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्ती १३:५३-५८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />स्याह्‌लै गेग्गे येसु जेँनै सहरग होल्बो। नुन चेलाव ङ्याबो स्वाबो। <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />नाह्‌न ल्हाः नुई यहूदी आराधनालयग लह्‌म्मः जाःबो। ङ्यान्नान सिमिव लैजै हालाईलाई राह्ङराङ्साः झामखेखे ल्होई र्‌वामः जाःबो, “अन सिमिजै अन ल्होईव खालै लह्‌न्दँ? कताःमन बुद्धि देत्त! नुई कुजुई झाःम ताईलुवान धोन खेँ? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />तै नु अनै कर्मी नङ्पा तै? तै नु ता मरियमन ङोह्जो आथबा याकूब, योसेफ, यहूदा रे सिमोन्न दाज्यु नङ्पा तै? तै नुन मितिकोव रे ङिन ङ्याबोई मह्‌या तै?” झाःम र्‌वाईर्‌वाई ख्युई येसू बिस्वास मखेबो।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />तब येसुई ख्युकाङ्मोः र्‌वाबो, “भबिस्यबक्ताग जेँन देस रे जेँन क्यालाकिप्पावन घूँ रे जेँनै यिम नङ्म घङ खाई अनादर मराह्‌नान।”<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:44">यूह ४:४४</ref></char></note><verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />रे येसुई मन ठाउँग कान-कान नाह्प्पुवावन ल्हाः जेँन ल्हा नान्नान ख्युकाङ्मोः ताःफान्चेन धोन नङ्म घङ ताईलुवान धोनव तये खे मतैबो। <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />ख्युन अबिस्वास रङरङ नु हालाईबो। आलै नु नाम-नामग लह्‌नैलह्‌नै होई।<verse eid="MRK 6:6" /></para>
  <para style="s">येसुई चेला च्योङेपाः फेप्पा</para>
  <para style="r">(<ref loc="MAT 10:1">मत्ती १०:१</ref>,<ref loc="MAT 10:5-15">५-१५</ref>; <ref loc="LUK 9:1-6">लुक ९:१-६</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />येसुई चेला च्योङेपाः जेँन रह्‌म्म स्वा र्‌वाबो, रे ख्युकाङ्मोः ङेह् ङेह् खेखे फेप्पो। नुई ख्युकाङ्मोः मुवन ङ्या आङ यङ बिम्बो। <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />आलै नुई ख्युकाङ्मोः झाःम र्‌वार्‌वा आग्या बिम्बो, कि “लेन्चेन भिह्तु ङ्याबो तये नहुरा, न ता रोता, न ता झोला, न धबग सोङ, जेङ्नै पेर्गादी मात्र हुरा। <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />पौला गोना, जेङ्नै घङ ह्‌याल्म भन्दि नहुरा।” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />नुई ख्युकाङ्मोः हेँ र्‌वाईर्‌वाई होई, “कान नामग ताप्‌तौ कन यिम जानान, मन नामलै मगेन्न बेर मनै यिम छ्योवायो। <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />यदि कान ठाउँग ङेनकोन स्वागत मराङिन, सिमीवजै ङेनकोन ल्होई ङ्याम्म अस्वीकार खेङिन, ङेनको मन ठाउँलै गेत्तौ ख्युन बिरोधग साँचिन भिह्तु जेँन तिङ्पान थल्जुब खारा।” अन ख्युन चेतावनीन भिह्तु र्‌हानान ङ्याह्।<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />तब ख्यु गेग्गे होई आलै सिमीवजै जेँन तीपालै घ्योप्पा ख्याःयो र्‌वार्‌वा ताह्फेप्पो। <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />ख्युई लै मुकाङ्मोः छ्यूबो, रे लै नाह्प्पुवाकाङ्मोः छि दुद्‌दुई ताःफाम्बो।<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">याक ५:१४</ref></char></note><verse eid="MRK 6:13" /></para>
  <para style="s">बप्‌तिस्मा-बिन्नान यूहन्ना सिह्पा</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्ती १४:१-१२</ref>; <ref loc="LUK 9:7-9">लुक ९:७-९</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />ता झली हेरोदजै अन ल्होई पुरू ताह्पा ङ्याह्, तैङर्‌वाङिन खास्या पुरू येसुन मिनकै ङ्याह्। सिमिव र्‌वाङ, “बप्‌तिस्मा-बिन्नान यूहन्ना सिह्पालै सम्पु रह्दँ, अन्न कारन ता नुनलम झाःम सक्तिसाली धोन रह्पाई ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MAT 16:14">मत्ती १६:१४</ref>; <ref loc="MRK 8:28">मर्क ८:२८</ref>; <ref loc="LUK 9:19">लुक ९:१९</ref></char></note> <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />जेङ्नै घङवजै र्‌वाबो, “नु एलिया जेङ्पा।” रे ह्‌याङ घङवजै र्‌वाबो, “नु ता ताङ्बोन भबिस्यबक्ताव लैम भबिस्यबक्तादी जेङ्पा।” <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />जेङ्नै जब हेरोदजै अन ताह्बो तब नुई र्‌वाबो, “यूहन्ना, कन्न थोप्पा ङै थुम फाम्पा, नुई सम्पु ग्युर्दँ।” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />तैङर्‌वाङिन हेरोदजै जेँन भाइ फिलिपन मिसा हेरोदियासन भिह्तु यूहन्नाः जुङ फानफान नू खीखी झ्यालखानाः कह्पा ङ्याह्, तैङर्‌वाङिन नुई हेरोदियासग मिह्जी खेपा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="MAT 4:12">मत्ती ४:१२</ref>; <ref loc="LUK 3:19-20">लुक ३:१९-२०</ref></char></note> <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />तैङर्‌वाङिन यूहन्नाई हेरोदग झाःम र्‌वापा ङ्याह्, “कानुन्न अन्सार ङेन जेँन भाइन मिसा ङ्याबो मिह्जी खेचे लः नङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेवी १८:१६</ref>; <ref loc="LEV 20:21">२०:२१</ref></char></note><verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />अन्न कारन हेरोदियासजै यूहन्नान ङ्या खूँ नाम्पा ङ्याह्, रे नु सत्सुम खेपा ङ्याह्, जेङ्नै हेरोदन कारन खेतैपा मह्‌या। <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />तैङर्‌वाङिन यूहन्ना ती धार्मिक रे पबित्र सिमि र्‌वार्‌वा छुछु हेरोद नुन ङ्याबो ङिह्ङ्‌ङ, रे नू झ्यालखानाः सेन्चे खेखे नाम्पा ङ्याह्। यूहन्नान ल्होई ताह्ताह् नु आत्ति खेँ, जेङ्नै नुन ल्होई स्याङस्याङ ङ्याङ्‌ङ।<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />जेङ्नै र्‌वापालैमन मौका मन्तौ स्वाबो, जब हेरोदजै जेँ केह्पान ल्हा जेँन मकेकुकेन किम पदाधिकारीव, अधिकृतव रे गालीलन ङोत्वा-ङोत्वा सिमिकाङ्मोः भत्यार किम बिम्बो। <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />तैङर्‌वाङिन जब हेरोदियासन जेँनै चमेः झिङ स्वास्वा छ्याम्बो, तब नुई हेरोद रे नुन केह्पान भत्यारग स्वापाकाङ्मोः स्याङ फाम्बो। आलै झलीजै मन चिमिचाः र्‌वाबो, “नाः तै तोलसुम दोङ्‌ङ तोला, रे ङा अन नाः बिन्नान ङ्युँ।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />ह्‌याङ झलीजै रेनरुरु नू र्‌वाबो, “राज्य फेई तोल्नै ङा नाः बिन्चे।”<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="EST 5:3-6">एस ५:३-६</ref>; <ref loc="EST 7:2">७:२</ref> </char></note> <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />आलै नुई खोलोः गेग्गे जेँन माः लोप्पो, “मा ङा तै तोल्चे?” नुई र्‌वाबो, “बप्‌तिस्मा-बिन्नान्न यूहन्नान थोप्पा।” <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />अन तुरुन्तै झिङ झलीन रह्‌म्म होई, रे झाःम र्‌वार्‌वा तोल्बो, “ङेनजै चोँ ङाः बप्‌तिस्मा बिन्नान्न यूहन्नान थोप्पा तेर्माः क र्‌वानान ङा इच्छ्या खेनान।” <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />अन ताह्ताह् झली मिह्दा तुँलाक्या रह्बो, जेङ्नै अकेःन दम्फुवन ङू रेनरुरु मन चिमिचा बिन्चे र्‌वापान कारन ह्‌याङ मबिन र्‌वा मतैबो। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />झलीजै तुरुन्तै गारदन तीपा सिपाहीग फेप्पे यूहन्नान थोप्पा सह्रा र्‌वार्‌वा कोह्बो। आलै नुई झ्यालखानाः वैवै यूहन्नान थोप्पा थुम्बो, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />रे नुन थोप्पा तेर्माः सस्सै चिमिचाः बिम्बो, रे चिमिचाई अन नुन माः बिम्बो। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />यूहन्नान चेलावजै जब अन ल्होई ताह्बो तब ख्यु स्वास्वा नुन कुँह्‌म सोलसोल तुह्‌र्साः वव्वै लुँह्‌म्बो।<verse eid="MRK 6:29" /></para>
  <para style="s">येसुई मोह्ङ किम ख्वापा</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती १४:१३-२१</ref>; <ref loc="LUK 9:10-17">लुक ९:१०-१७</ref>; <ref loc="JHN 6:5-13">यूह ६:५-१३</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />आलै प्रेरितव येसुन रह्‌म्म जोम्बो, रे ख्युई तयाः-तयाः खेपा ङ्याह् रे लम्पा ङ्याह्, मन पुरू नू स्याप्पो। <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />नुई ख्युकाङ्मोः र्‌वाबो, “ङेह् रे ङन ङ्याबो तीपू स्वा, रे ङाई नाह्‌।” तैङर्‌वाङिन स्याह्‌ आउजाउ खेनानव लै ङ्याह्, रे ख्युकाङ्मोः झाचेनै घाम मह्‌या। <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />आलै ख्यु तै मर्‌वारे दोङाः चपचप तीपू होई। <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />लै सिमीवजै ख्यु वैयङ खेपा रङरङ स्योःबो, आलै सिमिव सहरवलै धालैधालै स्वास्वा चेलावन खेरे ङूई स्याह् ताप्पो। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />जब येसु नाः गेप्पो तब नुई मोह्ङ किमदी रङ्बो, रे नुई ख्युकाङ्मोः दिसाबो। तैङर्‌वाङिन ख्यु ग्वाल्या मीपान लूपावलैम ङ्याह्। रे नुई ख्युकाङ्मोः लै ल्होई लह्‌म्मः जाःबो।<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गन्ती २७:१७</ref>; <ref loc="1KI 22:17">१ झली २२:१७</ref>; <ref loc="2CH 18:16">२ इति १८:१६</ref> </char></note> <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />आलै जब भेला लै होई तब येसुन चेलावजै नुन रह्‌म्म स्वास्वा र्‌वाबो, “स्यीह् तीपू ङ्याह्, रे ता ङ्याजे रह्बो। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />सिमिकाङ्मोः भिदा भिना, रे ख्युई धेँवछोँन छ्युङ्पु रे नामग वैवै जेँन भिह्तु तयाः झायाप र्‌युह्‌यायो।”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />जेङ्नै येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनकोजै ख्युकाङ्मोः तयाः झाफाना।” जेङ्नै ख्युई नू र्‌वाबो, “तै ङी वैवै मुलन सिक्‌का क्याम ङेह्‌न रोता र्‌युह्र्‌युह् ख्युकाङ्मोः झा फान्चे तै?” <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनकोन ङ्याबो रोता हाति ङ्याह्? वैवै सेह्‌ना।” आलै ख्युई सेह्‌म्बो रे येसू झब बिम्बो, “रोता ङा रे ङाह् ङेह्‌।”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />आलै येसुई सिमिकाङ्मोः क्वा पिङ्मग लयन खेखे छ्युङ्फाम्बो। <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />ख्यु क्याम ती-ती रे फेराङ सुमथल-सुमथलन लयन दोङदोङ छ्युङ्बो। <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />नुई मन रोता ङा रे ङाह् ङेह्‌ वव्वै पान्नाङक्याँ सेनसेन परमेस्वरग असिका तोल्बो, रे अन रोता क्युप्पो आलै सिमिवन ङू नाह्‌ना र्‌वार्‌वा चेलाकाङ्मोः बिम्बो, रे अन ङाह् ङेह् यङ नुई पुरूग परेःबो। <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />आलै पुरूजै बरङबरङ झबो। <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ङाईलै चेलावजै रोता रे ङाह्‌न लामा रह्पान तुकराव थाम च्योङे खाप्च्योवा तुईबो। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />रोता झानान्न चोलोङ्चाव हजार ङा ङ्याह्।<verse eid="MRK 6:44" /></para>
  <para style="s">येसु त्युन ल्हाः लेम्पा</para>
  <para style="r">(<ref loc="MAT 14:22-36">मत्ती 1४:२२-३६</ref>; <ref loc="JHN 6:16-21">यूह ६:१६-२१</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />आलै येसुई तुरुन्त जेँन चेलाकाङ्मोः दोङाः चपचप योह्‌न धिक्याँ बेथसेदा नामग फेप्पो, नुँह् चन सिमिवन मोह्ङग भिदा बिम्म स्याह्ई छ्युङ्बो। <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />ख्युकाङ्मोः भिदा खेतामी नु धुरग सोअताप्मः होई। <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />छानजे दोङा समुन्द्रन घूँ ङ्याह्, रे येसु चन तितिमाई नाःन साः ङ्याह्। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />चेलाकाङ्मोः दोङा कुल्चे तूरि रह्पा नुई रङ्बो, तैङर्‌वाङिन लन ख्युन फिचीङघोल्वाक्याँ ङ्याह्। नाह्पन तिन बजेलै छ बजेन घूँ नु ख्युन स्याह् समुन्द्रन ल्हाः ल्हेनैल्हेनै स्वाबो, रे ख्युकाङ्मोः ङू तलतल वैमः जातौ <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />ख्युई नु समुन्द्रन ल्हाः लेन्यङ खेपा रङ्‌रङ मु जेङ्पा र्‌वार्‌वा छुबो, रे ख्यु फाईरा खेबो। <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />तैङर्‌वाङिन नू रङरङ पुरू ङिनपा ङ्याह्। जेङ्नै हतपत नुई ख्युकाङ्मोः र्‌वाबो, “हिम्मत ख्या, ङा जेङ्पा, नङिना।” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />आलै येसु ख्युन ङ्याबो दोङाः चप्पो, रे लन छ्याबो। आलै ख्यु मिह्दा हालाईबो, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />तैङर्‌वाङिन ख्युई हजार ङा सिमिकाङ्मोः झाम बिम्पा रोतान भारेन ल्होई हाकोपाई मह्‌या, जेङ्नै ख्युन सम क्योङ्म रह्पा ङ्याह्।<verse eid="MRK 6:52" /></para>
  <para style="s">येसुई गनेसरेतग नाह्प्पुवाकाङ्मोः ताःफाम्पा</para>
  <para style="r">(<ref loc="MAT 14:34-36">मत्ती १४:३४-३६</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />योह् गार्मी येसु रे नुन चेलाव गनेसरेतन प्रदेसग स्वा ताप्पो, रे ख्युई दोङा नाः नाह्‌म्बो। <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />जब ख्यु दोङालै गेप्पो तब मन्न भेलाई सिमीवजै येसू स्योःबो, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />मन्नकारन ख्युई लिब्रुङक्याँ धालैधालै वैवै येसु स्वाबो र्‌वानान्न ल्होन फेलफाम्बो। आलै सिमिवजै खङ्ननाकाङ्मोः खातग नान्नान सम्म जाःबो। <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />आलै नामवग, सहरवग, रे छ्युङ्पू खाः-खाः नु जाःबो, सिमीवजै नाह्प्पुवाकाङ्मोः बजार-बजारग नाह्‌म्बो, रे नुन घोलाङ्न नाः मात्र यङ ज्यार्चे धेरायो र्‌वार्‌वा ख्युई नू छ्याःफुल्बो, रे हातिपाई ज्यार्बो ख्यु पुरू ताःबो।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">खेपुलवन छोए</para>
  <para style="r">(<ref loc="MAT 15:1-9">मत्ती १५:१-९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />यरूसलेमलै स्वापान फरिसीव रे कानुन लन्नान्न सिमिव येसुन लिब्रुङक्याँ जोम्बो। <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />येसुन हातिपा चेलावजै ल्हा बाःपा, आथबा मथुपान ल्हाई ङ्योप्पा झपा ख्युई रङ्बो। <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />फरिसीव रे यहूदी पुरूव ख्युन खेपुलवजै बिम्पान ल्हूलाम ङ्यान्नान रह्पान कारन ल्हा मथुरे ङ्योप्पा मझाँ। <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />बजारलै स्वामी ल्हो थुथु छाङ्म मरारे ख्यु तये मझाँ। अकेः मात्र नङ्पा, ख्युई झाःम घङ लै ल्हूलाम ङ्याङ्‌ङ, आथबा खोरेव, धाङव रे काँसान धाङव थुनान्न ल्हूलाम।<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />तब फरिसीव रे कानुन लन्नान्न सिमिवजै येसू लोप्पो, “तैङ नान चेलाव खेपुलजै बिम्पान ल्हूलाम मङ्यानरे बाःपा ल्हाजै झाँ?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />तब येसुई ख्युकाङ्मोः र्‌वाबो, “यसैयाजै ना ख्वाकिबावन भारेः लः खेखे झामखेखे भबिस्यबानी खेबो, कताःम पबित्रसास्त्रग सर्पा ङ्याह्, ‘अन जातिजै ङाः ङुरजै मात्र सम्मान खेँ, जेङ्नै ख्युन सम ङन लम ग्याङम ङ्याह्। <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />ख्यु भाछ्योवा ङन आराधना खेँ, जेङ्नै ख्युन छोए मात्र सिमीवजै लम्पान निम जेङ्पा।’<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">यसै २९:१३</ref></char></note> <verse eid="MRK 7:7" /><verse number="8" style="v" sid="MRK 7:8" />ङेनको परमेस्वरन र्‌वापान ल्होई ख्योवाख्योवा सिमीवन ल्हूलाम ङ्याङ्‌ङ।” <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनको जेँन ल्हूलाम ङ्यान्चेन भिह्तु हाति जेर्म खेखे परमेस्वरन र्‌वापान ल्होई पह्ङ्‌ङ।” <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />तैङर्‌वाङिन मोसाई कानुन अन्सार र्‌वापा ङ्याह्, “जेँन पोमाः सम्मान ख्या, रे सुई पोमाः क्याह्ँ, मन तेम्माई सत्त्वानान।”<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस २०:१२</ref>; <ref loc="EXO 21:17">२१:१७</ref>; <ref loc="LEV 20:9">लेवी २०:९</ref>; <ref loc="DEU 5:16">कानुन ५:१६</ref></char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />यदि कान सिमिजै जेँन पोमाः “ङनलम तयाः हाति फुरी ङेनकाङ्मोः देत्त्वानान मन बलिदान जेङ्पा (अन्न अर्थ परमेस्वरग फुल्पा) र्‌वाङिन, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />ङेनको नू जेँन पोमान भिह्तु ह्‌याङ सेवा तये खे मफाङ्‌ङ। <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />झामखेखे ङेनको जेँन ल्हूलामग जाःजाः परमेस्वरन र्‌वापान ल्होईग फानमत्वानान छूँ आलै मनलैम घङ लै ल्होई ङेनकोजै खेपाई छ्युङ्पा ङ्याह्।”<verse eid="MRK 7:13" /></para>
  <para style="s">सिमी बाःपा दोङ्नान्न ल्होईव</para>
  <para style="r">(<ref loc="MAT 15:10-20">मत्ती १५:१०-२०</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />येसुई ह्‌याङ सिमिन मोह्ङग जेँन रह्‌म्म स्वा र्‌वार्‌वा ख्युकाङ्मोः र्‌वाबो, “ङेनको पुरूजै ङन ल्होई ङ्याना रे हाकोवा। <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />झाःम ल्होई तये मह्‌या कन खोलोःलै सिमिन झिङ जाःजाः नू बाःपा धोङ तैङ, जेङ्नै सिमिन लम खोलोः गेन्नान ल्होईवजै सिमी बाःपा धोँ। <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />सुन ङ्यान्नान्न नम्ज्योआ ङ्याह् नुई ङ्यानाःयो।”<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />सिमिन मोह्ङग ख्योवाख्योवा यिमन झिङ जामी येसुन चेलावजै नू अन द्रिस्तान्तन भारेः लोप्पो। <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />येसुई ख्युकाङ्मोः र्‌वाबो, तै ङेनको यङ हेँ घङ सिमिवलैम हाकोनान ङ्याह्‌यौ? तै खोलोःलै सिमिन झिङ जाःङ मह्‌नजै नू बाःपा धोङ मतैनान र्‌वार्‌वा ङेनकाङ्मोः क्युई मीपाऊ? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />तैङर्‌वाङिन मन नुन समग नङ्पा, जेङ्नै फौन झिङ जाःनान, रे ल्होलम खोलोः गेन्नान। (झामखेखे येसुई झायाप पुरू छाङ्म जेङ्पा र्‌वार्‌वा स्याप्पो।)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />येसुई र्‌वाबो, “सिमिलम तै खोलोः गेङ्‌ङ अनजै सिमी बाःपा धोँ। <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />तैङर्‌वाङिन तैस्याङ पुरून नावा अलःव समन झिङलै गेग्गे स्वानान रे नू धोन अलःक्याँ वन्नान, उदाहरन्न भिह्तु: ब्यभिचार खेनान, खुनान, सिमि सन्नान, पातार खेनान, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />लोभ खेनान, धोन अलः खेनान, ठग खेनान, यामखेपा राह्‌नान, थादोवा खेनान, सिमिन ल्हुई झानान, खिर्का राह्‌नान रे मुर्खन धोन खेनान। <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />अन अलः ल्होई पुरूव झिङलै गेन्नान, रे सिमी बाःपा दोङ्नान।”<verse eid="MRK 7:23" /></para>
  <para style="s">चिमिचादीन बिस्वास</para>
  <para style="r">(<ref loc="MAT 15:21-28">मत्ती १५:२१-2८</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />आलै स्याह्‌लै च्याङच्याङ येसु तुरोस सहर रे सीदोन्न ङेह्‌मन ठाउँलै वैवै यिमदीन झिङ जाःबो। अन ल्होई सुई क्युई नराःयो र्‌वानान नु चाहि खेँ, जेङ्नै नु फाक छ्युङ मतैबो। <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />मन्नै भेला चिमिचादीजै नुन भारेः ताह्बो रे स्वास्वा नुन ल्हेग खल्बु क्याप्पो। मन चिमिचान चमेःग मु ताह्पा ङ्याह्। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />अन सिरियान फोनिकेन ठाउँग केह्पा यहूदीन खोलोःन चिमिचादी ङ्याह्। मन चिमिचाई जेँन चमेलम मु छ्यूयाःयो र्‌वार्‌वा येसू छ्याःफुल्बो। <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />येसुई नू र्‌वाबो, “ङू वैचाकाङ्मोः झा फाना, तैङर्‌वाङिन वैचावन रोता वव्वै ख्युकोग पच्‌चे लः नङ्पा।”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />आलै नुई येसू र्‌वाबो, “जेङ्पा प्रभु, जेङ्नै ख्युकोजै र्‌वार्‌वा सिमिन वैचावजै तेबलन पोँ छार्फाम्पान तुकराव झाँ।”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ह्‌याङ येसुई नू र्‌वाबो, “नाई झाःम र्‌वापान कारनजै ना यिम वया। नान चमेलम मु गेग्गे वैपा ङ्याह्।” <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />नु यिम होई रे चमेःग खातग आःपाई छ्युङ्पा धोबो रे नुनलम मु गेत्तपा ङ्याह्।<verse eid="MRK 7:30" /></para>
  <para style="s">येसुई नाम्ज्योवा मताह्‌नान रे वाम्पा सिमी ताःफाम्पा</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />आलै येसु तुरोसन छेत्रलै गेग्गे सीदोन सहर राह्‌राह्‌ देकापोलिसन सिमानान घूँलम राईराई गालील-योह्ग होई। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />स्याह्‌ सिमीवजै नाम्ज्योवा मताह्‌नान रे वाम्पा सिमिदीग येसुन रह्‌म्म सप्पो, रे नुन ल्हाः ल्हा नाह्‌ना र्‌वार्‌वा नू छ्याःफुल्बो। <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />नू सिमिन मोह्ङलम तीपू वव्वै येसुई जेँन ल्हाजुप नुन नाम्ज्योवाग कह्बो। मन्न छाम्म छिमा पप्पे नुन लही ज्यार्बो। <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />आलै स्वर्गक्याँ सेनसेन ऊ र्‌याङ्म वव्वै नू र्‌वाबो, “इफ्फाता,” (अन्न अर्थ पोवा।) <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />अन्नै भेला नुन नाम्ज्योवा पोङ्बो, रे नुन खीपा लही पोङ्बो, रे अन लः खेखे र्‌वामः जाःबो। <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />“अन सुई नर्‌वा,” र्‌वार्‌वा येसुई ख्युकाङ्मोः र्‌वाबो। जेङ्नै हाति नुई सिमिकाङ्मोः आग्या बिङ्‌ङ, झन ह्‌याल्म तोप खेखे ख्युई अन ताह्फेङ्‌ङ। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />आलै ङ्यान्नान्न सिमिव पुरू मिह्दा हालाईलाई र्‌वामः जाःबो, नुई तैस्याङ पुरू लः खेपा ङ्याह्। “नुई नाम्ज्योवा मताह्‌नानग ताह्‌नान रे वाम्पाः ल्होई र्‌वा तैनान धोँ।”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">येसुई हजार ली सिमिकाङ्मोः ख्वापा</para>
  <para style="r">(<ref loc="MAT 15:32-39">मत्ती १५:३२-३९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />मन दिनग ह्‌याङ सिमिन मोह्ङ किमदी जोम्बो, जेङ्नै ख्युन ङ्याबो झायाप तये मह्‌या। तब येसुई चेलाकाङ्मोः जेँन ङ्याबो स्वा र्‌वार्‌वा र्‌वाबो, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“ङा अन सिमिकाङ्मोः दिसाँ, तैङर्‌वाङिन अजोव ङन ङ्याबो छ्युङ्पा त्या सुमङी रह्बो, रे ख्युन ङ्याबो झाचे तये मह्‌या। <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />आलै यदि अजोव: फोङ यिम फेङ्‌ङिन अजोव लमगै बेहोस राह्‌नान ङ्याह्। अजोवन बर्ग कान-कान ग्याङ्मलै स्वापा ङ्याह्।”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />येसुन चेलावजै नू र्‌वाबो, “अन सुनसान ठाउँग अकेःन सिमिकाङ्मोः ख्वाचेन भिह्तु हाति र्‌वार्‌वा ङ्योप्पा खालै सच्‌चे?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />येसुई ख्युकाङ्मोः लोप्पो, “ङेनकोन ङ्याबो रोता हाति ङ्याह्?” ख्युई झब बिम्बो, “रोता नेह्” <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />नुई सिमिन मोह्ङ्‌ग साः छ्युङ्फाम्बो, आलै नुई रोता नेह् ल्हाग वव्वै परमेस्वरग मया रह्बो र्‌वामी रोता क्युप्पो, रे जेँन चेलाकाङ्मोः सिमिन मोह्ङ्‌ग परेःया र्‌वार्‌वा बिम्बो। आलै चेलावजै सिमिकाङ्मोः परेःबो। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ख्युन ङ्याबो तयाः ङाह् कत्याःमव यङ ङ्याह्, रे नुई परमेस्वरग असिका तोलतोल मन यङ चेलाकाङ्मोः परेःफाम्बो। <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />आलै सिमिवजै झाझा बरङ्बो रे ख्युई लाःमा रह्पान तुकराव थाम नेह् नाङ्पा तुईबो। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />स्याह्‌ क्वाईमाल्‌ला: हजार ली सिमिव ङ्याह्। <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />नुई ख्युकाङ्मोः भिदा खेखे फेप्पो, आलै नु चन जेँन चेलावन ङ्याबो तुरुन्तै दोङाः चपचप दलमनुथान छेत्रक्याँ होई।<verse eid="MRK 8:10" /></para>
  <para style="s">फरिसीवजै ताईलुवान धोन्न भिह्तु लोप्पो</para>
  <para style="r">(<ref loc="MAT 16:1-4">मत्ती १६:१-४</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />फरिसीवजै येसुन रह्‌म्म स्वास्वा नुन ङ्याबो खाथू खेमः जाःबो, रे नू छोए सेन्चे फारैफारै र्‌वाबो, “ङी स्वर्गलै स्वानान्न ताईलुवान धोनदी थना।” <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />जेँन आत्माग नुई ऊ र्‌याङ्म वव्वै र्‌वाबो, “अन पुस्ताई तैङ ताईलुवान धोन फाङ्‌ङ? तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, अन पुस्ताः ताईलुवान धोन तये बिन्नान मह्‌या।” <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />आलै ख्युकाङ्मोः ख्योवाख्योवा नु ह्‌याङ दोङाः चपचप योह्‌न धिक्याँ होई।<verse eid="MRK 8:13" /></para>
  <para style="s">फरिसीव रे हेरोदन सोरा</para>
  <para style="r">(<ref loc="MAT 16:5-12">मत्ती १६:५-१२</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />चेलावजै ङ्याबो रोता हुर्चे ह्‌याका लेत्तँ, रे दोङाः ख्युन ङ्याबो रोता तीबाःदि ङ्याह्। <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />येसुई चेलाकाङ्मोः झाःम र्‌वार्‌वा चेतावनी बिम्बो, “ङेनको फरिसीवन सोरा रे हेरोदन सोरालै होस खेखे छ्योवा।”<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लुक १२:१</ref></char></note><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />जेङ्नै ख्युन ङ्याबो रोता मीपान कारन येसुई झाःम र्‌वापा जेङ्पा र्‌वार्‌वा ख्युई राह्ङराङ्साः ल्होई र्‌वाम जाःबो।<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />येसुई ख्युकाङ्मोः समन ल्होई हाकोको र्‌वाबो, “ङेनकोन ङ्याबो रोता मह्‌या र्‌वार्‌वा ङेनको तैङ राह्ङराङ्साः ल्होई र्‌वानान? तै ङेनको हेँद्रि मरङ्नान कि हाकोनान? तै ङेनकोन सम क्योङ्म रह्पा ङिह्पाऊ? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />मी रानै तै ङेनको मरङ्नौ? नाम्ज्योवा रानै तै ङेनकाङ्मोः मताह्‌नौ? तै ङेनकाङ्मोः ह्‌याका मीपाऊ,<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">यर ५:२१</ref>; <ref loc="EZK 12:2">इज १२:२</ref>; <ref loc="MRK 4:12">मर्क ४:१२</ref></char></note> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />जब ङै रोता ङा हजार ङा सिमिवन भिह्तु क्युप्पा, तब हाति थाम नाङ्पा तुकरा ताकरीव ङेनकोजै तुईपा? ख्युई नू झब बिम्बो, च्योङे।”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />जब येसुई लोप्पो, “अन रोता नेह् हजार ली सिमिवन घूँ क्युप्पा ङ्याह्, तब हाति थाम नाङ्पा तुकरा ताकरीव ङेनकोजै तुईपा ङ्याह्?” ख्युई नू र्‌वाबो, “नेह्।” <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />येसुई चेलाकाङ्मोः र्‌वाबो, “तब तै ङेनको हेँ हामकोनौ?”<verse eid="MRK 8:21" /></para>
  <para style="s">येसुई बेथसेदाग काना सिमिदीग ताःफाम्पा</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />मन्न छाम्म नु बेथसेदा स्वाबो, रे सिमिवजै काना सिमिदीग नुन स्याह् सप्पो, रे नू झ्यारा र्‌वार्‌वा येसू छ्याःफुल्बो। <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />येसुई मन काना सिमिन ल्हा जुङजुङ नू नामलै खोलोः सप्पो, रे नुन मी छिमा पप्पे नुन ल्हाः जेँन ल्हा नान्नान नू लोप्पो, “तै ना तयाः रङ्नौ?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />आलै ङ्यालक्याँ सेनसेन नुई र्‌वाबो, “ङा सिमिकाङ्मोः तङ्पुव लैम लेम्पाई छ्युङ्पा रङ्नान।” <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />तब नुई ह्‌याङ नुन मी ल्हा नाह्‌म्बो, रे नुई लः खेखे सेह्‌म्बो। आलै नुई रङ्चे देप्पो, रे तैस्याङ पुरू लः खेखे रङ्म जाःबो। <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />तब येसुई नू नाम्मरा नजायो र्‌वार्‌वा नुन यिम फेप्पो।<verse eid="MRK 8:26" /></para>
  <para style="s">येसुन भारेः पत्रुसन घोसना</para>
  <para style="r">(<ref loc="MAT 16:13-16">मत्ती १६:१३-१६</ref>; <ref loc="LUK 9:18-21">लुक ९:१८-२१</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />येसु रे नुन चेलाव कैसरिया फिलिप्पी सहरन रह्‌म्म ङिह्पान नामवक्याँ वैतौ नुई लमग जेँन चेलाकाङ्मोः झाःम र्‌वार्‌वा लोप्पो, “सिमिवजै ङाः सु जेङ्पा र्‌वाङ?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />ख्युई येसू र्‌वाबो, “कानजै र्‌वाङ, ‘बप्‌तिस्मा बिन्नान्न यूहन्ना।’ यहूदीन खोलोःन सिमिवजै ‘एलिया,’ आलै घङ हातिपाई र्‌वाङ, ‘भबिस्यबक्तावन बर्ग तीपा।’”<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14-15">मर्क ६:१४-१५</ref>; <ref loc="LUK 9:7-8">लुक ९:७-८</ref></char></note><verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />तब येसुई ख्युकाङ्मोः लोप्पो, “जेङ्नै ङेनको चन ङाः सु जेङ्पा र्‌वार्‌वा र्‌वानान न।” पत्रुसजै झब बिमबिम नू र्‌वाबो, “ना मसिह जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ती १०:३८</ref>; <ref loc="LUK 14:27">लुक १४:२७</ref>; <ref loc="JHN 6:68-69">यूह ६:६८-६९</ref>; <ref loc="JHN 8:34">८:३४</ref></char></note><verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />येसुई ख्युकाङ्मोः अन ल्होईन भारेः सुई तये नर्‌वा र्‌वार्‌वा आग्या बिम्बो!<verse eid="MRK 8:30" /></para>
  <para style="s">येसु जेँन तूरि रे कालन भारेः र्‌वापा</para>
  <para style="r">(<ref loc="MAT 16:21-28">मत्ती १६:२१-२८</ref>; <ref loc="LUK 9:22-27">लुक ९:२२-२७</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />मन्न छाम्म येसुई चेलाकाङ्मोः जेँन भारेः झामखेखे र्‌वामः जाःबो, “सिमिन ङोह्जोई तूरि लैः हुरत्वानान। अगुवाव, ङोत्वा पुजारीव रे कानुन लन्नान्न सिमिवजै नू अस्वीकार खेनान ङ्याह्, सन्नान ङ्याह्। जेङ्नै सुमङीग नु सिह्पालै सम्पु ग्युर्नान ङ्याह्।” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />झाःम खेखे नुई अन ल्होई लः खेखे र्‌वाबो। जेङ्नै अन ताह्ताह् पत्रुसजै नू तीक्याँ वव्वै ङार्म जाःबो। <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />जेङ्नै होलहोल जेँन चेलाकाङ्मोः सेनसेन, पत्रुसग नुई झाःम र्‌वार्‌वा ङार्बो, “ए सैतान, ङन लम वया, तैङर्‌वाङिन नान नावा परमेस्वरलम नङ्पा, जेङ्नै सिमिन स्वभाऊलै स्वाङ।”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />तब नुई जेँन चेलावन ङ्याबो मोह्ङ्‌ग जेँन स्याह् स्वा र्‌वार्‌वा ख्युकाङ्मोः र्‌वाबो, “कान सिमि ङन ङिक जासुम खेङिन नुई जेँग अस्वीकार ख्याःयो, रे जेँन क्रुस सोलसोल ङन ङिक जायो।<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ती १०:३८</ref>; <ref loc="LUK 14:27">लुक १४:२७</ref></char></note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />तैङर्‌वाङिन सुई जेँन परान सोमफान्सुम खेँ, नुई मन मोल्नान ङ्याह्, जेङ्नै ङन रे ल्होन् लःन भिह्तु जेँन परान पन्नानजै अन बचाई खेनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="LUK 17:33">लुक १७:३३</ref>; <ref loc="JHN 12:25">यूह १२:२५</ref></char></note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />तैङर्‌वाङिन सिमिजै सन्सार पुरू ल्हाग थेपथेप जेँन परान मोल्ङिन नू फाइदा तै राह्‌नान? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />आथबा सिमि सुई र्‌वार्‌वा जेँन परान्न भिह्तु तै बिन तैनौ? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />यदि अन ब्यभिचारी रे पापी पुस्ताग सुई ङा रे ङन बचनलै ब्याङ्‌ङिन, सिमिन ङोह्जो यङ जेँन पान महिमाग पबित्र स्वर्गदुतवन ङ्याबो स्वातौ मन सिमिलै ब्यान्नान ङ्याह्।”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />आलै येसुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, स्यीह् थाङथाङ छ्युङ्पावन बर्ग कान-कान ङ्याह्, सुई परमेस्वरन राज्य सक्तिग स्वापा मरङ्न बेर तै खेखेई सिह्‌नान मह्‌या।”<verse eid="MRK 9:1" /></para>
  <para style="s">येसुन खरि फिप्पो</para>
  <para style="r">(<ref loc="MAT 17:1-13">मत्ती १७:१-१३</ref>; <ref loc="LUK 9:28-36">लुक ९:२८-३६</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />मन्न रुर्यान ङिक येसुई पत्रुस, याकूब रे यूहन्नाः नुन ङ्याबो वव्वै ला किमदीग वप्पो। स्याह् ख्यु मात्र ङ्याह्, ख्युई सेन्तौसेन्तौ येसुन खरि फिप्पो।<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">२ पत्र १:१७-१८</ref></char></note> <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />आलै नुन घोलाङ ताह्‌म रे मिह्दा पाह्‌ल्म रह्बो, झाःम कि पिर्थीबी सुई र्‌वार्‌वा थुथु अकेःन पाह्ल्म धोङ मतैनान। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />तब चेला सुमपाई एलिया रे मोसा येसुन ङ्याबो ल्होई र्‌वापाई छ्युङ्पा रङ्बो। <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />पत्रुसजै येसू र्‌वाबो, “गुरुज्यू, ङि स्यीह् रह्पा लः रह्बो। ङि स्यीह् आति सुम दोङ्मता, ती नान भिह्तु, ती मोसान भिह्तु रे ती एलियान भिह्तु।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />ख्यु यामयाम ङिन्पान कारनजै पत्रुसग तै र्‌वाचे र्‌वार्‌वा क्युई मरह्बो।<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />आलै नमलूदी स्वास्वा ख्युकाङ्मोः कप्पो, रे नमलूलै झाःम केह्ःदी गेप्पो, “अन ङन स्याङ्पान ङोह्जो जेङ्पा, ङेनकोजै नुन ल्होई ङ्याना।”<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MRK 1:11">मर्क १:११</ref>; <ref loc="LUK 3:22">लुक ३:२२</ref>; <ref loc="2PE 1:17">२ पत्र १:१७</ref>; <ref loc="PSA 2:7">भजन २:७</ref> </char></note><verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />आलै हतपत धेँवछोँ सेन्तौ ख्युई जेँन ङ्याबो येसू नङ्म घङ सुई मरङ्बो।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />ख्यु लालै धुल्तौ येसुई ख्युकाङ्मोः “सिमिन ङोह्जो सिह्पालै सम्पु मग्युर्न बेर ख्युई तै रङ्पा ङ्याह् मन सुई नर्‌वा र्‌वार्‌वा आग्या बिम्बो।”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />ख्युई अन ल्होई समग नाह्‌म्बो, जेङ्नै सिह्पालै सम्पु ग्युर्नान र्‌वापा चन तै जेङ्पा र्‌वार्‌वा राह्ङराङ्साः ल्होई र्‌वामः जाःबो।<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />आलै ख्युई नू झाःम र्‌वार्‌वा लोप्पो, “ङू एलिया स्वा त्वानान र्‌वार्‌वा कानुन्न कानुन लन्नान्न सिमिव तैङ र्‌वानान?”<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मला ४:५</ref>; <ref loc="MAT 11:14">मत्ती ११:१४</ref></char></note><verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />येसुई र्‌वाबो, “तेम्माई, एलिया ङू स्वानान, रे तैस्याङ पुरू ह्‌याङ दोङ्नान। जेङ्नै सिमिन ङोह्जोई लै तूरि कूकू यहूदीन खोलोःन सिमिवलम अस्वीकार राह्‌नान ङ्याह् र्‌वार्‌वा पबित्रसास्त्रग तैङ सर्पा ङ्याह् न? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, कि एलिया ङूई स्वातपा ङ्याह्, रे पबित्रसास्त्रजै नुन भारेः र्‌वापालैम सिमिवजै नू जेँनै इच्छ्या अन्सार बेऊरा खेबो।”<verse eid="MRK 9:13" /></para>
  <para style="s">येसुई मुन आत्मा ताह्पान चोलोङ्चाः ताःफाम्पा</para>
  <para style="r">(<ref loc="MAT 1:14-21">मत्ती १:१४-२१</ref>; <ref loc="LUK 9:37-43">लुक ९:३७-४३</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />ख्यु घङ चेलावन स्याह् होलहोल स्वातौ ख्युकाङ्मोः मोह्ङ किमदीजै क्योरक्योर नाम्पा रे ख्युन ङ्याबो कानुन लन्नान्न सिमिवजै खाथू खेपाई छ्युङ्पा ख्युई रङ्बो। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />जब सिमिवजै येसू रङ्बो, ख्यु मिह्दा हालाईबो रे नुन ङ्याबो धालैधालै होई येसू सिह्‌म ङिह्पाऊ र्‌वाबो। <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />येसुई चेलाकाङ्मोः लोप्पो, “ङेनको अजोवन ङ्याबो ल्होई तैन भारेः खाथू खेनान?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />मोह्ङलै सिमिदीजै येसू झब बिम्बो, “गुरुज्यू, ङन ङोह्जोः वाम्पा दोङ्नान्न मुन आत्मा ताह्पा ङ्याह्, रे ङेन स्याह् सप्पा ङिह्पा। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />जब अनजै ङन ङोह्जोः जुङ्‌ङ, तब नू साः दिम्फाङ्‌ङ, आलै नुई ङुरलै भ्वा छ्यूङ, सो चह्ङ्‌ङ, रे ख्याःङ। ङै ङेन चेलाकाङ्मोः मन मुन आत्मा छ्यूयाःयो र्‌वार्‌वा छ्याःफुल्पा, जेङ्नै ख्युई मतैबो।”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />तब येसुई ख्युकाङ्मोः झब बिम्बो, “ए अबिस्वासी सिमिव, ङा हातौन बेर ङेनकोन ङ्याबो लुईदरा? ङेनकाङ्मोः ङा हाति कूचे? चोलोङ्चाः ङन रह्‌म्म सह्‌रा।” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />ख्युई मन चोलोङ्चाः नुन रह्‌म्म सप्पो। येसू रङ्लुङ्मीम मन मुन आत्माई चोलोङ्चाः काङ्‌क्याल सुमक्याल धेफाम्बो, रे नु साः दिमदिम ङुरलै भ्वा छ्युईछ्युई काङ्‌क्याल सुमक्याल धेम जाःबो। <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />नुई अन्न पाः लोप्पो, “हातौलै अनग झाःम रह्पा जेङ्पा?” नुई र्‌वाबो, “वैचान भेलालै।” <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />“मुई नू घरीघरी मेह् रे त्यू पप्पे सच्‌चे फाङ्‌ङ। गुरु! नाई तैङिन ङी दिसासा भलो ख्या।”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />येसुई नू र्‌वाबो, “ङेनजै तैनौ र्‌वार्‌वा तै र्‌वानान? बिस्वास खेनान्न सिमिन भिह्तु ल्होई पुरू रा तैनान।” <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />तब तुरुन्तै चोलोङ्चान पाई दादा र्‌वाबो, “ङा बिस्वास खेचे, जेङ्नै ह्‌याल्म मह्‌या। ङा ह्‌याजन बिस्वास देम्म फुरी ख्या।”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />तब मोह्ङ ङ्याबो धालैधालै स्वापा रङरङ येसुई मन मू झाःम र्‌वाबो, “ए वाम्पा रे नाज्योवा मताह्‌नान्न मुन आत्मा, ङा नाः र्‌वाचे, नुन स्याह्‌लै गेग्गे स्वा, रे ह्‌याङ हातौयै नुन झिङ नजा।” <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />आलै आत्मा फाईरा खेखे अन चोलोङ्चाः मिह्दा काङ्‌क्याल सुमक्याल धेफानफान मन आत्मा गेप्पो, रे अन चोलोङ्चा सिह्पा लैम रह्बो, सिथाल कि पुरूजै अन सिदँ र्‌वार्‌वा छुबो। <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />जेङ्नै येसुई नुन ल्हा जुङजुङ नू जुरुक्‌क सोल्बो, रे नु च्याङ्बो।<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />आलै जब येसु यिम वैपा तब नुन चेलावजै फाक नु झाःम र्‌वार्‌वा लोप्पो, “ङ्योअजै आत्मा तैङ छ्यु मतैबो?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />येसुई चेलाकाङ्मोः र्‌वाबो, “अन लैम आत्मा चन सोअतापजै नङ्म घङ मेसो तैजै छ्यु मतैनान।”<verse eid="MRK 9:29" /></para>
  <para style="s">येसुई जेँन सिचेन भारेः ङेरेप र्‌वापा</para>
  <para style="r">(<ref loc="MAT 17:22-23">मत्ती १७:२२-२३</ref>; <ref loc="LUK 9:43-45">लुक ९:४३-४५</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />आलै स्याह्‌लै गेग्गे ख्यु गालील राह्‌राह्‌ होई। अन ल्होई सुई क्युई नराःयो र्‌वानान नुन सम ङ्याह्, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />तैङर्‌वाङिन येसुई जेँन चेलाकाङ्मोः लनयङ ङ्याह्। नुई ख्युकाङ्मोः र्‌वाबो, “सिमिन ङोह्जो ङा सिमिवन ल्हाग थोन्नान ङ्याह्, रे ख्युई ङाः सन्नान ङ्याह्, रे ङा सिह्पान सुमङीन ङिक ह्‌याङ सम्पु राह्‌राह्‌ च्याङ्नान ङ्युँ।”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />जेङ्नै चेलावजै अन ल्होईन अर्थ हामकोबो, आलै येसू लोच्‌चे ङिह्‌म्बो।<verse eid="MRK 9:32" /></para>
  <para style="s">पुरून खेरे किम सु जेङ्पा?</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्ती १८:१-५</ref>; <ref loc="LUK 9:46-48">लुक ९:४६-४८</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />येसु रे नुन चेलाव कफर्नहुम स्वाबो, रे यिम ताप्मी येसुई ख्युकाङ्मोः लोप्पो, “लमग ङेनकोजै तैन ल्होई र्‌वापा?” <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />जेङ्नै ख्यु तै मर्‌वारे छ्युङ्बो, तैङर्‌वाङिन लमग ख्युई “ङ्योअग पुरून खेरे किम सु जेङ्पा?” र्‌वार्‌वा राह्ङराङ्साः ल्होई र्‌वापा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">लुक २२:२४</ref></char></note><verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />तब नु छ्युङ्बो, रे च्योङेपाः घ्वाबो, रे ख्युकाङ्मोः र्‌वाबो, “कान सिमि ङूस्योवा राचेन सम खेङिन, अन पुरून खेरे ङीस्योवा रे पुरून राङ्पा रा त्वानान।”<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">मत्ती २०:२६-२७</ref>; <ref loc="MAT 23:11">२३:११</ref>; <ref loc="MRK 10:43-44">मर्क १०:४३-४४</ref>; <ref loc="LUK 22:26">लुक २२:२६</ref></char></note> <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />आलै वैचा छ्युमदी वव्वै येसुई नू ख्युन घूँ नाह्‌म्बो, रे नू खोलग वव्वै नुई ख्युकाङ्मोः र्‌वाबो, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“सुई झाःम छ्युम वैचावन बर्ग तीपा ङन मिह्‌नग स्वीकारी खेँ नुई ङाः स्वीकारी खेनान, रे सुई ङा स्वीकारी खेँ नुई ङाः नङ्पा, जेङ्नै ङाः फेन्नानग स्वीकारी खेनान।”<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती १०:४०</ref>; <ref loc="LUK 10:16">लुक १०:१६</ref>; <ref loc="JHN 13:20">यूह १३:२०</ref></char></note><verse eid="MRK 9:37" /></para>
  <para style="s">सु ङिन बिरोधग मह्‌या नु ङिन भिह्तु जेङ्पा</para>
  <para style="r">(<ref loc="LUK 9:49-50">लुक ९:४९-५०</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />यूहन्नाई नू र्‌वाबो, “गुरुज्यू, सिमिदीजै ङेन मिह्‌नग मुव छ्यूपाई छ्युङ्पा ङी रङ्पा। ङी नू उजु खे मफाम्पा, तैङर्‌वाङिन मन ङिन मोह्ङन नङ्पा।” <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />येसुई ख्युकाङ्मोः र्‌वाबो, “नू नकाः, तैङर्‌वाङिन ङन मिह्‌नग ताईलुवान धोन खेनान सुई र्‌वार्‌वा हतपत ङन बिरोधग अलः ल्होईव र्‌वा मतैनान। <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />तैङर्‌वाङिन सु ङिन बिरोधग मह्‌या, नु ङिन पछेग ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">मत्ती १२:३०</ref>; <ref loc="LUK 11:23">लुक ११:२३</ref></char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />तैङर्‌वाङिन सुई ङेनकाङ्मोः मसिहन जेङ्पा र्‌वार्‌वा ङेनकाङ्मोः ङन मिह्‌नग त्यु खोरेदी थुङ् फान्दरा, तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, नुई तै खेखेई जेँन इनाम मोल्नान मह्‌या।”<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">मत्ती १०:४२</ref></char></note><verse eid="MRK 9:41" /></para>
  <para style="s">तीपान लोभव</para>
  <para style="r">(<ref loc="MAT 18:6-9">मत्ती १८:६-९</ref>; <ref loc="LUK 17:1-2">लुक १७:१-२</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“यदि कानजै अन छ्युमवन बर्ग कानग ङन ङ्या खेनान्न बिस्वासलै फाफा तीपा खेफाङ्‌ङिन, मन सिमिन होलाः ल्हाकोर किमन लुङ चुनचुन समुन्द्रग पच्‌चे लः राह्‌नान। <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />अन्नकारन यदि नान ल्हाजै नाः तीपा खेफाङ्‌ङिन मनग थुमा। ल्हा ङेह् राह्‌राह्‌ ङ्यालान मसिह्‌नान्न मेह्ग वैचेन पूँ दुर्या राह्‌राह्‌ झुनी जाचे ङेनकोन भिह्तु लः जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्ती ५:३०</ref></char></note> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />[ङ्यालाः ता न भु सिह्‌नान, न मेह्ई सिह्‌नान।] <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />आलै नान ल्हेजै नाः तीपा खेफाङ्‌ङिन मनग थुमा। ल्हे ङेह् राह्‌राह्‌ ङ्यालाः पच्‌चेन खेरे ता खोर्या राह्‌राह्‌ झुनी जाचे नान भिह्तु लः जेङ्पा। <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />[ङ्यालाः ता न भु सिह्‌नान, न मेह्ई सिह्‌नान।] <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />यदि नान मीजै नाः तीपा खेफाङ्‌ङिन मनग छ्यूछ्यू पह्‌रा। मी ङेह् राह्‌राह्‌ ङ्यालाः पच्‌चेन खेरे ता काना राह्‌राह्‌ परमेस्वरन राज्य जाचे ङेनको भिह्तु लः जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती ५:२९</ref></char></note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />ङ्यालाः ता न भु सिह्‌नान, न मेह्ई सिह्‌नान।”<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">यसै ६६:२४</ref></char></note><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />बलिदान चाई छाङ्म दोङ्पा लैम पुरू मेह्‌लम छाङ्म राह्‌नान ङ्याह्। <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />“चा लः जेङ्पा, जेङ्नै चान ङम्नान वैङिन, अन तैजै ङम्नान दोङ्चे? ङेनको राह्ङराङ्साः चा नाह्‌ना, रे राह्ङराङ्साः सान्तिग छ्योवा।”<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">मत्ती ५:१३</ref>; <ref loc="LUK 14:34-35">लुक १४:३४-३५</ref></char></note><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">भ्या भानान्न भारेः येसुन छोए</para>
  <para style="r">(<ref loc="MAT 19:1-12">मत्ती १९:१-१२</ref>; <ref loc="LUK 16:18">लुक १६:१८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />येसु कफर्नहुमलै यर्दन चाङ्पुन धिङा यहूदिया प्रदेसग स्वाबो रे मोह्ङ नुन रह्‌म्म जोम्बो, आलै नुन कानुन अन्सार ख्युकाङ्मोः ह्‌याङ नुई लह्‌म्बो।<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />कान फरिसीव नुन रह्‌म्म स्वास्वा नू छोए सेनसेन लोप्पो, “कानुन्न अन्सार तै कान चोलोङ्चाई जेँन मिसान ङ्याबो भ्या भाचे लः ङ्याह्‌यौ?” <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />येसुई ख्युकाङ्मोः झब बिमबिम र्‌वाबो, “मोसाई ङेनकाङ्मोः तै आग्या बिम्पा ङ्याह्?” <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />ख्युई र्‌वाबो, “ख्योवानान्न हिगादी सरसर सिमिजै जेँन मीसाः ख्योवा तैनान र्‌वार्‌वा मोसाई अनुमति बिम्पा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">कानुन २४:१-४</ref>; <ref loc="MAT 5:31">मत्ती ५:३१</ref></char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />जेङ्नै येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनकोन सम ख्वान कारन मोसाई ङेनकाङ्मोः अन आग्या सर्बो। <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />जेङ्नै सृस्तिन सुरुलै परमेस्वरजै ख्युकाङ्मोः चोलोङ्चा रे चिमिचा खेखे दोङ्बो, कुजु पबित्रसास्त्रग सर्पा ङ्याह्। <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘अन्नकारन सिमि जेँन पोमाः ख्योवाख्योवा जेँन मीसान ङ्याबो दीदी छ्युङ्नान,<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत २:२४</ref></char></note> <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />रे ख्यूम ल्होदी राह्‌नान ङ्याह्।’ ख्यु ह्‌याङ ङेह् नङ्पा, जेङ्नै ती जेङ्पा। <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />अन्नकारन परमेस्वरजै सू ङ्याबो थुप्पा ङ्याह्, सिमिजै नफाःयो।” <verse eid="MRK 10:9" /><verse number="10" style="v" sid="MRK 10:10" />जब ख्यु यिम होल्बो, तब चेलावजै येसू ह्‌याङ अन्न भारेः लोप्पो। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />येसुई ख्युकाङ्मोः र्‌वाबो, “सुई जेँन मीसाः ख्योवाख्योवा घङन ङ्याबो मिह्जी खेँ, नुई मिसान बिरोधग ब्यभिचार खेनान।<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती ५:३२</ref>; <ref loc="1CO 7:10-11">१ कोर ७:१०-११</ref></char></note> <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />आलै यदि चिमिचाई जेँन पसाः ख्योवाख्योवा घङन ङ्याबो मिह्जी खेङिन, नुई ब्यभिचार खेनान।”<verse eid="MRK 10:12" /></para>
  <para style="s">येसुई वैचाकाङ्मोः असिका बिम्पा</para>
  <para style="r">(<ref loc="MAT 19:13-15">मत्ती १९:१३-१५</ref>; <ref loc="LUK 18:15-17">लुक १८:१५-१७</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />कान सिमिवजै कत्याम वैचाकाङ्मोः येसुई ख्युन ल्हाः ल्हा नान्नान असिका भिनाःयो र्‌वार्‌वा नुन रह्‌म्म सप्पो, जेङ्नै चेलावजै सिमिकाङ्मोः ङार्बो। <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />जेङ्नै अन रङरङ येसू सुतुबो, रे चेलाकाङ्मोः र्‌वाबो, “वैचाकाङ्मोः ङन रह्‌म्म स्वा फाना, ख्युकाङ्मोः नकाः, तैङर्‌वाङिन परमेस्वरन राज्य ता झाःमै सिमिवन भिह्तुई जेङ्पा। <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, सुई परमेस्वरन राज्यग कत्याम वैचादीजै लैम स्वीकार मखेँ, नु तै खेखेई परमेस्वरन राज्यन झिङ जाःनान मह्‌या।”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">मत्ती १८:३</ref></char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />आलै येसुई वैचाकाङ्मोः खोलग वव्वै ख्युन ल्हाः जेँन ल्हा नान्नान ख्युकाङ्मोः असिका बिम्बो।<verse eid="MRK 10:16" /></para>
  <para style="s">छबा रेम्पा सिमिदी</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्ती १९:१६-३०</ref>; <ref loc="LUK 18:18-30">लुक १८:१८-३०</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />येसु लमग वैयङ खेतौ, सिमिदी धालैधालै स्वास्वा नुन ङू पोह् जूजू नू लोप्पो, “हे गुरु लः, मताह्‌नान्न झुनी देच्‌चेन भिह्तु ङै तै खेत्वानान?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />येसुई नू र्‌वाबो, “ना तैङ ङाः गुरू लः र्‌वानान? ती मात्र परमेस्वर नङ्म घङ सुई लः मह्‌या। <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />आग्याव ता नाः क्युई ङ्याह्, आथबा सिमि नसह्‌रायो, ब्यभिचार नख्याःयो, नखुवायो, लबारन साँचि नभिनायो, ठग नख्याःयो, जेँन पोमाः आदर ख्याःयो।”<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">प्रस २०:१२-१६</ref>; <ref loc="ROM 13:9">रोम १३:९</ref></char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />आलै नुई येसू र्‌वाबो, “गुरुज्यू, अन पुरू ता ङै ङन छबा रातौलै ङ्यान्पा ङिह्पा।”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />येसुई नू सेह्‌म्बो, रे नू मया खेखे र्‌वाबो, “नाः हेँ ल्होईदीन कोम्म ङ्याह्। वया, नाः तयाः तयाः ङ्याह् पुरू र्‌युरा रे सोङ बिखारीकाङ्मोः भिना, आलै नाः स्वर्गः क्यु देन्नान ङ्याह्। आलै स्वास्वा ङन ङिक जाः।” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />जब मन सिमिजै अन ल्होई ताह्बो, नुन नमी नाह्छुपछुप रह्बो, रे अन तुँलाक्या राह्‌राह्‌ होई, तैङर्‌वाङिन नुन ङ्याबो क्यु लैः ङ्याह्।<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />आलै धेँवछोँ सेनसेन येसुई जेँन चेलाकाङ्मोः र्‌वाबो, “रेम्पाकाङ्मोः परमेस्वरन राज्यग जाचे मिह्दा खराम ङ्याह्।”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />येसुई र्‌वापान अन ल्होईग चेलावजै हालाईबो। जेङ्नै येसुई ह्‌याङ ख्युकाङ्मोः र्‌वाबो, “वैचाव, क्युन ङ्या भर नान्नानकाङ्मोः परमेस्वरन राज्यन झिङ जाचे मिह्दा खराम ङ्याह्। <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />रेम्पा सिमी परमेस्वरन राज्यन झिङ जाःचेन खेरे ता बरु घबन मीलै ऊँत जाचे छुम्म राह्‌नान।” <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />चेलाव मिह्दा हालाईलाई राह्ङराङ्साः र्‌वामः जाःबो, “झाम राङिन सु सोन तैनान?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />येसुई ख्युकाङ्मोः सेनसेन र्‌वाबो, “अन सिमिलम राई मतैनान्न धोन जेङ्पा, जेङ्नै परमेस्वरलम चन रा तैनान, तैङर्‌वाङिन परमेस्वरलम धोन पुरू रा तैनान।”<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="JOB 42:2">अयू ४२:२</ref>; <ref loc="LUK 1:37">लुक १:३७</ref> </char></note><verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />पत्रुसजै नू र्‌वाबो, “सेह्‌ना, ङी ता तैस्याङ पुरू ख्योवाख्योवा ङेन ङिक जाःपा ङिह्पा।”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />येसुई र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, सुई ङन भिह्तु रे ल्होन् लःन खातिर यिम या थिक्‌कोव या मितिकोव या पोमा या ङोह्जो चमेःव या खेः ख्योवाङ, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />नुई तेह्पफान्नान्न ङ्याबो ङ्याबोः गुना ङाथल ह्‌याल्म यिम, थिक्‌कोव, मितिकोव, पोमा, ङोजो चमेव रे खेः अन्नै भेलाः देन्नान ङ्याह्, आलै स्वानान काल्बाग मताह्‌नान्न झुनी। <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />जेङ्नै लैः ङूस्योवा राह्‌नानव ङिस्योवा, रे ङिस्योवा राह्‌नानव चन ङूस्योवा राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती २०:१६</ref>; <ref loc="LUK 13:30">लुक १३:३०</ref></char></note><verse eid="MRK 10:31" /></para>
  <para style="s">येसुई जेँ सिह्‌नान्न भारेः सुमरेप र्‌वापा</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्ती २०:१७-१९</ref>; <ref loc="LUK 18:31-33">लुक १८:३१-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />येसु रे नुन चेलाव यरूसलेमक्याँ वैयङ ङ्याह्, रे येसु ख्युन ङूह्ङूह् लेम्पाई छ्युङ्पा ङ्याह्। चेलाव हालाईपा ङ्याह्, रे घङ ङिह्‌ङिह्‌ स्वानानव मिह्दा ङिन्पा ङ्याह्। तब नुई चेला च्योङेपाकाङ्मोः ह्‌याङ तीक्याँ वव्वै जेँन ङ्या स्वानान्न ल्होईव ख्युकाङ्मोः र्‌वाबो। <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />नुई र्‌वाबो, “ङ्याना, ङि यरूसलेमक्याँ वैयङ ङिह्पा। स्याह्‌ ङा सिमिन ङोह्जोः पक्राउग थेपथेप ङोत्वा पुजारीव रे कानुन लन्नान्न सिमिवन ल्हाग थोन्नान ङ्याह्, रे ख्युई ङाः सच्‌चेन धल भिनत्वानान र्‌वार्‌वा यहूदीन खोलोःन सिमिवन ल्हाग थोन्नान ङ्याह्। <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />आलै ख्युई ङाः खिसि खेनान ङ्याह् रे ङाः छिमा पन्नान ङ्याह्, ङा चेरन ताल्च्याई फ्याङ्नान ङ्याह् रे ङाः सन्नान ङ्याह्। जेङ्नै सुमङीन ङिक नु ह्‌याङ सम्पु राह्‌राह्‌ च्याङ्नान ङ्याह्।”<verse eid="MRK 10:34" /></para>
  <para style="s">याकूब रे यूहन्नान छ्याफुल</para>
  <para style="r">(<ref loc="MAT 20:20-28">मत्ती २०:२०-२८</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />जब्दियान ङोह्जो ङेह्, याकूब रे यूहन्ना येसुन रह्‌म्म स्वास्वा र्‌वाबो, “गुरुज्यू, ङि ङेनग तै तोल्ङ ङेनजै ङिन भिह्तु ख्याःयो र्‌वानान ङिन इच्छ्या ङिह्पा।” <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />येसुई ख्युकाङ्मोः लोप्पो, “ङेनकोन भिह्तु ङा तै खेचे, ङेनकोन इच्छ्या तै ङ्याह्?” <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />ख्युई झब बिम्बो, “ङेन महिमीत राज्यग ङि थिक्‌कोव ङेन याईपाक्याँ रे योम्मक्याँ छ्युङ्चे धेराःयो।”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />जेङ्नै येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनकोजै तै तोल्यङ ङ्याह् अन ङेनकाङ्मोः क्युई मह्‌या। तै ङै थुङ्त्वानान्न तूरिन खोरे ङेनकोजै र्‌वार्‌वा थुङ तैनौ? ङै वत्त्वानान्न तूरिन बप्‌तिस्मा तै ङेनकोजै र्‌वार्‌वा वत् तैनौ?”<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">लुक १२:५०</ref></char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />चेलावजै येसू झब बिम्बो, “ङि तैनान।” येसुई ख्युकाङ्मोः र्‌वाबो, “कन खोरे ङा थूँ अन ङेनकोजै थुङ्नान ङ्याह् रे कन बप्‌तिस्मा ङै वप्पा ङिह्पा अन बप्‌तिस्मा ङेनकाङ्मोः वन्नान ङ्याह्। <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />जेङ्नै ङन याईपा रे ङन योम्मक्याँ छ्युङ्म चन ङै बिन्नान्न ल्होई नङ्पा। अन ठाउँव ता परमेस्वरन जेँजै सुन भिह्तु तयार खेखे नाम्पा ङ्याह्, नुगै बिन्नान ङ्याह्।” <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />अन ताह्ताह् चेला च्युपाव याकूब रे यूहन्नान ङ्याबो सुतुबो। <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />तब येसुई ख्युकाङ्मोः जेँन रह्‌म्म स्वा र्‌वार्‌वा र्‌वाबो, “ङेनकाङ्मोः क्युई ङ्याह् कि यहूदीन खोलोःन सिमिवन ङ्या सासन खेनानवजै ख्युन ङ्या अख्तियार चलाई खेँ। आलै ख्युन स्योनान्न सिमिवजै ख्युन ङ्या आङ खेँ।”<note caller="-" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">लुक २२:२५-२६</ref></char></note><verse eid="MRK 10:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 10:43" />“ङेनकोन घूँ चन उजु नराःयो। जेङ्नै ङेनकोन घूँ सुई किम रासुम खेँ, मन ङेनको राङ्पा रात्वानान।<note caller="-" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती २३:११</ref>; <ref loc="MRK 9:35">मर्क ९:३५</ref></char></note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />आलै ङेनकोन घूँ सुई ङूस्योवा रासुम खेँ, अन पुरून राङ्पा रात्वानन। <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />तैङर्‌वाङिन ङा सिमिन ङोह्जो सुचा देच्‌चेन भिह्तु नङ्पा, जेङ्नै सेवा खेमः रे लै सिमिवन छुतकरा बिन्चेन भिह्तु जेँन परान बलि बिम्म स्वापा जेङ्पा।”<verse eid="MRK 10:45" /></para>
  <para style="s">येसुई मी मरङ्नान बारतिमैग ताःफाम्पा</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्ती २०:२९-३४</ref>; <ref loc="LUK 18:35-43">लुक १८:३५-४३</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />आलै येसु रे नुन चेलाव यरीहो सहरग स्वाबो, रे ख्यु सिमिन मोह्ङ किमन ङ्याबो यरीहोलै गेत्तौ तिमैन ङोह्जो बारतिमै, मी मरङ्नान बिखारी सिमिदी, लमन रह्‌म्म छ्युङपा ङ्याह्। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />जब नुई नू नासरतन येसु जेङ्पा र्‌वानान ताह्बो, तब फाईरा खेखे नुई र्‌वामः जाःबो, “हे येसु, दाऊदन ङोह्जो, ङन ङ्या दया ख्या।”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />तब लै सिमिवजै नू तै मर्‌वारे छ्योवा र्‌वार्‌वा ङार्बो। जेङ्नै अन झन केह्ः किम छ्यूछ्यू फाईरा खेमः जाःबो, “हे दाऊदन ङोह्जो, ङन ङ्या दया ख्या।” <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />लेन्तौलेन्तौ येसुई तक्‌क किलकिल र्‌वाबो, “नू स्यीह् स्वा र्‌वा” आलै ख्युई मन मी मरङ्नान्न सिमी झाःम र्‌वार्‌वा स्वा र्‌वाबो, “हिम्मत ख्या, च्याँ, येसुई नाः स्वा र्‌वाङ।” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />आलै नु जेँन घोलाङ पप्पे नू जुरुक्‌क च्याङ्बो रे येसुन रह्‌म्म स्वाबो। <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />येसुई नू र्‌वाबो, “ना तै चाहि खेनान, ङा नान भिह्तु तै खेचे?” मन मी मरङ्नान्न सिमिजै नू र्‌वाबो, “गुरुज्यू, ङै रङ्चे धेरायो।” <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />आलै येसुई नू र्‌वाबो, “ना वया। नान बिस्वासजै नाः ताःफाम्पा ङ्याह्।” तब तुरुन्तै नुई रङ्चे देप्पो, रे लमग येसुन ङिह्‌ङिह्‌ जाःबो।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">येसु यरूसलेमग स्वापा</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती २१:१-११</ref>; <ref loc="LUK 19:29-38">लुक १९:२९-३८</ref>; <ref loc="JHN 12:12-25">यूह १२:१२-२५</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />जब येसु रे नुन चेलाव यरूसलेमन ङेमः जैतून धुर्न रह्‌म्म बेथफागे सहर रे बेथानिया र्‌वानान ठाउँग स्वातबो, तब येसुई जेँन चेलाव बर्ग ङेपा झाःम र्‌वार्‌वा फेप्पो, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />“ङेन ङूक्याँन नामग वया, रे जाःतौजाःतौ ङेनजै चोँन बेर सिमि सुई मचप्पान खीपा पूँह्‌न तह्जा दोःनान ङ्याह्। मनग फोलफोल स्यीह् सह्‌रा। <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />कान सिमिजै ङेनकाङ्मोः ‘अन तैङ पोङ्नान?’ र्‌वाङिन, ‘प्रभु अन त्वापा ङ्याह्, रे नुई खम्म होल्नान ङ्याह्’ र्‌वा।”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />तब ख्यु होई, रे अन तह्जा लम्न रह्‌म्म यिमदीन खोलोःक्याँ झलान रह्‌म्म खीपा धोबो, रे मनग फोल्मः जातौ। <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />स्याह्‌ थाङ्थाङ् छ्युङ्पाकाङ्मोः बर्ग कान-कानजै ख्युकाङ्मोः लोप्पो, “तह्जा फोलफोल ङेनकाङ्मोः तै खेनान?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />येसुई ख्युकाङ्मोः कोपालैम ख्युई र्‌वाबो, रे ख्युई ख्युकाङ्मोः फोल फाम्बो। <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ख्युई तह्जा येसुन रह्‌म्म सप्पो, रे जेँन घोलाङव मन्न ल्हाः नाह्‌म्बो, रे नू मन्न ल्हाः चप्पो। <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />येसू सम्मान खेचेन भिह्तु लैजे जेँन घोलाङव रे घङवजै बारीलै स्याउलाव थुमथुम लम्म तिह्प्पो। <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />आलै नुन ङूह्ङूह् लेन्नान रे ङिह्‌ङिह्‌ स्वानानवजै झाःम र्‌वामः जाःबो, “झयजक्‌कार राःयो! धन्य नू, सु परमप्रभुन मिह्‌नग स्वाङ!<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">भजन ११८:२५-२६</ref></char></note> <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />धन्न रायो, ङिन खेपुल दाऊदन अन स्वानान राज्य, परमेस्वरन झयजक्‌कार राःयो!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />येसु यरूसलेम स्वास्वा आराधनालयन झिङ जाबो। आलै नुई धेँवछोँन तैस्याङ पुरू सेह्‌म्मी फिम रह्पान कारन चेला च्योङेपावनै ङ्याबो नु बेथानिया होई।<verse eid="MRK 11:11" /></para>
  <para style="s">येसुई खोअन तङ्पु सराप खेपा</para>
  <para style="r">(<ref loc="MAT 21:12-22">मत्ती २१:१२-२२</ref>; <ref loc="LUK 19:45-47">लुक १९:४५-४७</ref>; <ref loc="JHN 2:13-16">यूह २:१३-१६</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />नाप्चे येसु नुन चेलाव ङ्याबो बेथानियालै स्वातौ येसू गुसिबो। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />आलै ग्याङम ल्हाई नाङ्पा खोअन तङ्पुदी रङरङ कार्तौ मनग तयाः फल‌ देन्नन कि र्‌वार्‌वा नू होई, जेङ्नै स्याह्‌ ताप्मी नुई तङ्पु ल्हानङ्म तये मदेप्पो, तैङर्‌वाङिन मन्न भेला खोअन फल‌ छ्यानान भेला रह्पा मह्‌या। <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />तब नुई मन तङ्पु र्‌वाबो, “तान धेरा हातौयै सुई र्‌वार्‌वा नानलम फल‌ नझाँयो।” आलै अन र्‌वापा नुन चेलावजै ताह्बो।<verse eid="MRK 11:14" /></para>
  <para style="s">येसू आराधनालयग वैपा</para>
  <para style="r">(<ref loc="MAT 21:12-17">मत्ती २१:१२-१७</ref>; <ref loc="LUK 19:45-47">लुक १९:४५-४७</ref>; <ref loc="JHN 2:13-22">यूह २:१३-२२</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />आलै यरूसलेम ताप्मी नू आराधनालयन झिङ जाःबो, आलै आराधनालयग र्‌युचे खेनानकाङ्मोः खोलोः छ्यूबो रे सोङ फिन्नन तेबलव रे पुरेन र्‌युन्नान्न सिमि छ्युङ्पान पिर्काव लाल्वा पप्पो। <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />नुई आराधनालयलै सुई तयेः वप मफाम्बो। <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />आलै नुई सिमिकाङ्मोः लह्‌नैलह्‌नै र्‌वाबो, “सास्त्रग सर्पा ङ्याह् कि परमेस्वरजै र्‌वाबो, ‘ङन यिम सन्सारन पुरू सिमिवन भिह्तु सोअताप्चेन यिम राह्‌नान ङ्याह्।’ जेङ्नै ङेनजै ता च्यापावन जोम्पु दोङ्पा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="LUK 19:46">लुक १९:४६</ref>; <ref loc="ISA 56:7">यसै ५६:७</ref>; <ref loc="JER 7:11">यर ७:११</ref> </char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />आलै ङोत्वा पुजारीव रे कानुन लन्नान्न सिमिवजै अन ताह्ताह् येसू कुजुई मीपा दोङ्चे र्‌वार्‌वा मेसो फाम्म जाःबो। जेङ्नै ख्यु नुन ङ्याबो ङिह्ङ्‌ङ, तैङर्‌वाङिन मोह्ङ पुरूजै नुन छोए हालाईपा ङ्याह्।<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />नम्जे रुप्तौ येसु रे नुन चेलाव सहरन खोलोः गेग्गे होई।<verse eid="MRK 11:19" /></para>
  <para style="s">खार्पा खोअन तङ्पुलै छोए</para>
  <para style="r">(<ref loc="MAT 21:18-22">मत्ती २१:१८-२२</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />नाप्चे नाप स्याह्‌लै ङूनै लम वैता नुई मन खोअन तङ्पू पादालै खार्पा रङ्बो। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />आलै पत्रुसग अन ङूक्याँन ल्होई ह्‌याका रह्बो, रे नुई येसू र्‌वाबो, “रब्बी, सेह्‌ना, नाई सराप बिम्पा खोअन तङ्पु ता खार्दँ।”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />येसुई चेलाकाङ्मोः झब बिमबिम र्‌वाबो, “परमेस्वरग बिस्वास नाह्‌ना। <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, यदि सुई जेँन समग सङ्‌का मखेँ जेङ्नै जेँजै र्‌वापान ल्होई पुरा राह्‌नान र्‌वार्‌वा बिस्वास खेखे अन लाः ‘पिङ्पिङ् ना समुद्रग घ्या’ र्‌वाङिन, मन्न भिह्तु झामै राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्ती १७:२०</ref>; <ref loc="1CO 13:2">१ कोर १३:२</ref></char></note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />अन्नकारन ङा ङेनकाङ्मोः र्‌वाचे, ङेनजै सोअताप्चे तैस्याङ तोलनन अन देप्पा ङिह्पा र्‌वानान्न बिस्वास नाह्‌ना, रे अन ङेन देन्नान ङ्याह्। <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />जब ङेन सोअताप्मः च्याङ्नान, तब सुन बिरोधग ङेन तयाः ङिह्पा राङिन माफ ख्या, ताकि पान्नाङग ङिह्पा ङेन पाई ङेन अपराधव माफ ख्याःयो।<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">मत्ती ६:१४-१५</ref></char></note> <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />[जेङ्नै माफ मखेङिन, पान्नाङग रह्पा ङेन पाइ ङेन अपराधव माफ खेनान मह्‌या।]”<verse eid="MRK 11:26" /></para>
  <para style="s">येसू आङन भिह्तु प्रस्‌न</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्ती २१:२३-२७</ref>; <ref loc="LUK 20:1-8">लुक २०:१-८</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />येसु रे नुन चेलाव ह्‌याङ यरूसलेमग स्वाबो। आलै येसु आराधनालयग धेँवछोँ लेन्तौ ङोत्वा पुजारीव, कानुन लन्नान्न सिमिव, ताङ्बोन अगुवाकाङ्मोः नुन ङ्याबो स्वाबो। <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />ख्युई नू प्रस्‌न खेबो, “कन आङजै ना अन धोनव खेनान? अन धोनव खेनान आङ ना सुई बिम्बो?” <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङा ङेनकाङ्मोः ती प्रस्‌न लोच्‌चे, रे ङेनजै अन्न झब भिना, रे कन आङजै ङा अन धोन खेनान, अन ङेनकाङ्मोः र्‌वानान ङ्याह्। <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />यूहन्नाई बिम्पा बप्‌तिस्मा स्वर्गन परमेस्वरलम जेङ्पा कि सिमिलम, ङा झब भिना।”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />ख्यु राह्ङराङ्साः र्‌वाचे खेमः जाःबो, “ङ्योअजै तै र्‌वाचे? यदि ङ्योअजै ‘स्वर्गन परमेस्वरलम’ झब बिङ्‌ङिन, नुई र्‌वानान ङ्याह्, झाम राङिन नुई यूहन्ना तैङ बिस्वास मखेपा? <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />‘सिमिवलम’ र्‌वाचे कि” जेङ्नै झाम र्‌वामः ख्यु जनतालम ङिह्‌म्बो। तैङर्‌वाङिन पुरूजै यूहन्ना: तेम्मा भबिस्यबक्ता र्‌वार्‌वा छुपा ङ्याह्। <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />तब ख्युई येसु झब बिमबिम र्‌वाबो, “ङ्योअग क्युई मीपा।” येसुई ख्युकाङ्मोः र्‌वाबो, “ङा यङ कन आङलम अन धोन खेनान, अन ङेनकाङ्मोः मर्‌वा।”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">अङ्‌गुरन खेः स्याई वप्पा सिमिवन द्रिस्तान्त</para>
  <para style="r">(<ref loc="MAT 21:33-43">मत्ती २१:३३-४३</ref>; <ref loc="LUK 20:9-12">लुक २०:९-१२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />येसुई ख्युकाङ्मोः द्रिस्तान्तग र्‌वाम जाबो “सिमिदीजै अङ्‌गुरन भारि पाह्पा मन्न धेँवछोँ राह्ः कह्बो, रे मेलन भिह्तु ल्हुमदी ख्वाबो। आलै ततरिदी दोङ्दोङ् नुई अङ्‌गुरन खेः सिमिकाङ्मोः स्याईग पाह्फाम्बो, रे जेँ चन परदेस होई। <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />अङ्‌गुर मिन्मी नुई अङ्‌गुरन भारि स्याई वन्नान्न सिमिवलम तये फल‌ दर्म तीपा राङ्पा फेप्पो। <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />जेङ्नै ख्युई नू जुङजुङ फ्याङ्बो रे ल्हा होङ फेप्पो। <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />ह्‌याङ नुई ख्युकाङ्मोः ङ्याबो घङ राङ्पा फेप्पो, जेङ्नै ख्युई नुन थोप्पा फ्याङ्बो रे नुन माबी पप्पो। <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />तापोई हेँ घङग फेप्पो, जेङ्नै नू ख्युई सप्पो, रे घङ लैग फेप्पो, जेङ्नै ख्युई काङ्ग फ्याङ्बो रे काङ्ग सप्पो।”<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />“ता फेच्‌चेन भिह्तु तीबाःदि ह्‌याजन ङ्याह्, कन नुन स्याङ्पान ङोह्जो। ‘ख्युई ङन ङोह्जो ता सम्मान खेदरा’ र्‌वार्‌वा सोची खेखे पुरून खेरे ङिक नुई ङोह्जोः ख्युन ङ्याबो फेप्पो।” <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />“जेङ्नै मन खेः स्याई वन्नान्न सिमिवजै राह्ङराङ्साः र्‌वाबो, ‘अन ता तापोन ङोह्जो जेङ्पा। स्वा, ङी अनग सह्‌म्मता, रे क्यु ङिनै राह्‌नान ङ्याह्।’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />आलै ख्युई नू जुङजुङ सप्पो, रे अङ्‌गुरन भारिन खोलोः पप्पो।”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />तब अङ्‌गुरन भारिन ताःपोई तै खेनान ङ्याह् र्‌वार्‌वा येसुई लोप्पो? नू स्वानन ङ्याह्, रे मन खेः स्याई वन्नान्न सिमिकाङ्मोः मीपा दोङ्नान ङ्याह्, रे अङ्‌गुरन बारी घङकाङ्मोः बिन्नान ङ्याह्। <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />तै ङेनजै पबित्रसास्त्रग सर्पान अन ल्होई तोअपा मीपाऊ? “कन लुङ खार्बावजै फान मत्वानान र्‌वार्‌वा पप्पो अनै कोप्चान धुर दोङ्पान-लुङ रह्बो,<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">भजन ११८:२२-२३</ref> </char></note> <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />अन परमप्रभुलम रह्पा जेङ्पा, आलै ङिन सेन्ताँग अन हालाईपा जेङ्पा।”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />येसुई र्‌वापान अन द्रिस्तान्त येहूदी अगुवावजै ङिनै बिरोधग र्‌वापा जेङ्पा र्‌वार्‌वा हाकोबो। अन्नकारन ख्युई नू जुङ्चे फाप्पो, जेङ्नै ख्युई सिमिन मोह्ङग ङिन्पान कारनजै नू ख्योवाख्योवा होई।<verse eid="MRK 12:12" /></para>
  <para style="s">कैसरग कर बिन्नान्न भिह्तु प्रस्‌न</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्ती २२:१५-२२</ref>; <ref loc="LUK 20:20-26">लुक २०:२०-२६</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />ङाइलै येसू ल्होईवग फसाई ख्या र्‌वार्‌वा ख्युई फरिसीव रे हेरोदीव बर्गन कान सिमिकाङ्मोः नुन ङ्याबो फेप्पो। <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />ख्यु स्वास्वा येसू र्‌वाबो, “गुरुज्यू, ङी क्युई ङिह्पा, ङेन तेम्मा जेङ्पा, रे सुईन वास्ता मखेँ। तैङर्‌वाङिन ङेन ध्वा सेनसेन धोन मखेँ, जेङ्नै परमेस्वरन लम् लः खेखे लह्ङ्‌ङ। र्‌वा, कानुन्न अन्सार कैसरग कर फाःचे लः ङ्याह् कि मह्‌या?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />ङि कर फाचे कि मफा? येसुई ख्युन ख्वा क्युई राह्‌राह्‌ ख्युकाङ्मोः र्‌वाबो, “ङेनकाङ्मोः तैङ ङा छोए सेन्नान? ती मोरन सिक्‌का सर्‌हा, रे ङा थना।” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />ख्युई ती मोरन सिक्‌का सप्पो। नुई ख्युकाङ्मोः र्‌वाबो, “अन फुता रे मिह्‌न सुन जेङ्पा?” ख्युई नु र्‌वाबो, “कैसरन।”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />तब येसुई ख्युकाङ्मोः र्‌वाबो, “कन कैसरन जेङ्पा अन कैसरग भिना, रे कन परमेस्वरन जेङ्पा अन परमेस्वरग भिना।” येसुन झाम झब ताह्ताह् ख्यु हालाईबो।<verse eid="MRK 12:17" /></para>
  <para style="s">सिह्पालै सम्पु राह्‌राह्‌ च्याङ्चेन भारेः प्रस्‌न</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्ती २२:२३-३३</ref>; <ref loc="LUK 20:27-38">लुक २०:२७-३८</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />सिह्पालै सम्पु ग्युर्चेन ल्होई बिस्वास मखेनान्न सदुकीकाङ्मोः येसुन स्याह् स्वाबो, रे नू लोप्पो,<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">प्रे २३:८</ref></char></note> <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“हे गुरुज्यू, मोसान कानुनग ङिन भिह्तु सर्पान निम अन्सार कान्न धाज्यु वैचा मराह्‌रे सिङिन धाज्युन भिह्तु वैचा रायो र्‌वार्‌वा भाइजै च्योङ्‌ग नानत्वानान।”<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">कानुन २५:५</ref></char></note> <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />पयारदीग थिक्‌कोव नेह् ङ्याह्। ङोह्जो किस्योवाजै मिह्जी खेबो, आलै मन सिमि वैचा मराह्‌रे सिह्बो। <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ता बर्म भाइजै मन चिमिचा नाह्‌म्बो, रे नु रे वैचा मराह्‌रे सिह्बो। आलै घङजै र्‌वार्‌वा उजुई खेबो। <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />आलै थिक्‌कोव नेह्पानै वैचा मरह्बो। पुरून खेरे ङिक मन चिमिचा यङ सिह्बो।<verse eid="MRK 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 12:23" />“ता सिह्पाव सम्पु ग्युर्तौ ख्युन बर्ग मन चिमिचा सुन मिसा राह्‌नान? तैङर्‌वाङिन ख्यु थिक्‌कोव नेपाजै नुन ङ्याबो मिह्जी खेपा ङ्याह्।”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनकाङ्मोः सङ्‌का ताप्पान कारन अन नङ्पा तै, कि ङेनकाङ्मोः न ता पबित्रसास्त्र स्योनन, न परमेस्वरन सक्ति स्योनन? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />तैङर्‌वाङिन जब सिह्पालै ख्युन सिसी ह्‌याङ च्याङ्नन, ख्यु न ता भ्या खेँ, न ख्युन भ्या राह्‌नान, जेङ्नै ख्यु पान्नाङग रह्पा दुतव लैम राह्‌नान। <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />सिह्पाव सम्पु राह्‌राह्‌ च्याङ्चे ल्होईन भारेः तै ङेनजै मोसान किताबग तोअपा मीपाऊ? कि कुजुई पोथ्रान भारेः सर्पान पाठग परमेस्वरजै मोसा र्‌वाबो, ‘ङा अब्राहामन परमेस्वर, इसहाकन परमेस्वर रे याकूबन परमेस्वर जेङ्पा।’<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">प्रस ३:६</ref></char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />परमेस्वर सिह्पावन परमेस्वर नङ्पा, जेङ्नै सम्पुवन जेङ्पा। ङेनकाङ्मोः मिह्दा भ्रमग ताह्पा ङ्याह्।”<verse eid="MRK 12:27" /></para>
  <para style="s">पुरून खेखे किम आग्या</para>
  <para style="r">(<ref loc="MAT 22:34-40">मत्ती २२:३४-४०</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />कानुन लन्नान्न सिमिव बर्ग ती स्वाबो, रे ख्युकाङ्मोः राह्ङराङ्साः र्‌वाचे खेपा ताह्बो। येसुई सिमिकाङ्मोः झब ल बिम्पा रङरङ नुई नू लोप्पो, “पुरू आग्यावग महान आग्या कन जेङ्पा?”<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लुक १०:२५-२८</ref></char></note> <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />येसुई झब बिम्बो, “पुरून खेरे महान आग्या चन अन जेङ्पा: ‘हे इस्राएल ङ्याना, परमप्रभु ङिन परमेस्वर तीबाःदि परमप्रभु जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">कानुन ६:४-५</ref></char></note> <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />नाई परमप्रभु जेँन परमेस्वरग नान पुरू समजे, नान पुरू परानजै, नान पुरू नावाई, रे नान पुरू सक्तिजै मया ख्या।’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />ङे आग्या अन जेङ्पा, ‘नाई जेँन खिम्जेःग जेँग लैम मया ख्या।’ अन ङे आग्यालै घङ किम आग्या मया।”<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवी १९:१८</ref> </char></note><verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />मन कानुन लन्नान्न सिमिजै येसू र्‌वाबो, “गुरुज्यू, नाई तेम्मा र्‌वापा, परमेस्वर तीबाःदि जेङ्पा, नुनङ्म घङ सुई परमेस्वर मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">कानुन ४:३५</ref></char></note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />रे परमेस्वरग सम पुरूजै, नावा पुरूजै, सक्ति पुरूजै मया ख्याःयो, रे खिम्जेःग जेँग लैम मया ख्याःयो अन परमेस्वरग तैस्याङ पुरून होमबलि रे भोका फुल्पान खेरे लैः ङोत्वाखाईमे जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">होसे ६:६</ref></char></note><verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />नुई बुद्धिमानी ङ्याबो झब बिम्पा रङरङ येसुई नु र्‌वाबो, “ना परमेस्वरन राज्यलै ग्याङम मीपा।” अन्न ङिक नु प्रस्‌न खेनान सुई हिम्मत मरह्बो।<verse eid="MRK 12:34" /></para>
  <para style="s">मसिहन भारेः प्रस्‌न</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्ती २२:४१-४६</ref>; <ref loc="MAT 23:1-36">२३:१-३६</ref>; <ref loc="LUK 20:41-47">लुक २०:४१-४७</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />येसु आराधनालयग लनतौ नुई प्रस्‌न खेबो, “कुजु मसिह दाऊदन ङोह्जो जेङ्पा र्‌वार्‌वा कानुन्न कानुन लन्नान्न सिमिव र्‌वाङ?” <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />तैङर्‌वाङिन दाऊद जेँजै पबित्र आत्मालम र्‌वापा ङ्याह्, परमप्रभुई ङन प्रभू र्‌वाबो, “ना ङन याईपा लाक्याँ छ्योवा, जबथाल ङा नान बैरिकाङ्मोः नान लेह्‌न तिङ्पान पोँ मनान।”<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन ११०:१</ref></char></note><verse eid="MRK 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37" />“जब दाऊद जेँजै नु ‘प्रभु’ र्‌वाङ, रे खालै नू येसुन ङोह्जो रह्बो?” आलै स्याह्‌न किम मोह्ङजै नुन बचन स्याङस्याङ ताह्बो।<verse eid="MRK 12:37" /></para>
  <para style="s">येसुई कानुन गुरुवन बिरोध चेतावनी बिङ्ङ</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्ती २३:१-३६</ref>; <ref loc="LUK 20:45-47">लुक २०:४५-४७</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />तब छोए बिन्तौ येसुई र्‌वाबो, “कानुन लन्नान्न सिमिवलम सापसाप छ्योवा। ख्यु घोलाङ र्‌याङ्म गोनगोन धेँवछोँ तूह्‌मः रे बजारवग सम्मान देम्म, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />रे आराधनालयवग प्रमुख ठाउँ रे भत्यारोग सम्मान्न ठाउँ देम्म सम खेँ। <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />ख्यु लम्मावन फाइदा वङ्‌ङ रे ख्युन यिम खूँ, जेङ्नै घङग थन्चेन भिह्तु र्‌याङ्म-र्‌याङ्म सोअताप्ङ। झाःमन सिमिवजै झन ह्‌याल्म धल देन्नान ङ्याह्।”<verse eid="MRK 12:40" /></para>
  <para style="s">लम्मान भेती</para>
  <para style="r">(<ref loc="LUK 21:1-4">लुक २१:१-४</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />आलै येसु आराधनालयन भेती कानन ठाउँन ङू छ्युङ्बो, रे मोह्ङजै बकासग भेती कपा सेम्बो। आलै लै रेम्पा सिमिवजै किम-किम सोङ कबो। <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />आलै बिखारी लम्मादीजै स्वास्वा पलेङन सिक्‌का ङेह् कबो, कन्न मोल सोह्ङदी ङ्याह्। <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />तब जेँन चेलाकाङ्मोः जेँन स्याह् घ्वाघ्वा नुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, बकासग फुल्नानवन बर्ग अन बिखारी लम्माई पुरून खेरे किम कबो। <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />तैङर्‌वाङिन घङवजै जेँन लाःमा रह्पान क्युलम कह्बो, जेङ्नै अन लम्मा चिमिचाई चन बिखारी राह्‌राह्‌ यङ नुई सोन्चेन भिह्तु जेँन ङ्याबो रह्पान क्यु पुरू कह्बो।”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">येसुई आराधनालयन मीपा दोङ्नान्न भबिस्यबानी</para>
  <para style="r">(<ref loc="MAT 24:1-51">मत्ती २४:१-५१</ref>; <ref loc="LUK 21:5-36">लुक २१:५-३६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />जब नु आराधनालयलै गैत्तौ ङ्याह्, तब नुन चेलाव बर्ग तीपाई नू र्‌वाबो, “सेह्‌ना, गुरुज्यू, हाति किम-किम लुङ रे हाति किम भबनव।” <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />येसुई झब बिम्बो, ङेनजै अन किम भबनव रङ्पा? “स्यीह् ता लुङ ती यङ नुन ठाउँग छ्युङ्नान मह्‌या। ख्युन बर्ग पुरू पोँ पन्नान ङ्याह्।”<verse eid="MRK 13:2" /></para>
  <para style="s">कातू रे तेपफाम्पाव</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्ती २४:३-१४</ref>; <ref loc="LUK 21:7-19">लुक २१:७-१९</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />आलै येसु आराधनालयन<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">यहूदी सोअताप्चे खेनान्न यिम</char></note> ङू जैतून धुरी छ्युङ्पान भेला पत्रुस, याकूब, यूहन्ना रे अन्द्रियासजै नू गोप्पे लोप्पो, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“ङ्योअग र्वाउता, अन घतनाव हातौ राह्‌नान ङ्याह्? रे अन पुरू ल्होई पुरा राह्‌नान्न भिह्तु तै ताह्ः राह्‌नान ङ्याह्‌यौ?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />येसुई ख्युकाङ्मोः र्‌वाबो, “सापसाप छ्योवा, सुई र्‌वार्‌वा ङेनकाङ्मोः भ्रमग थेप नफानाःयो। <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />सिमि लै ङन मिह्‌नग ‘ङा अनै जेङ्पा’ र्‌वार्‌वा स्वानन ङ्याह्, रे ख्युई लैग भ्रमग थेप्नान ङ्याह्। <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />जब ङेनजै याल रे यालन फाईरा ताह्‌नान ङ्याह्, तब नङिना। झाम घतनाव मराखाईमे ङ्याह्। जेङ्नै अन भेला अन्त्यन भेला नङ्पा। <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />देस राह्ङराङ्साः याल खेनान ङ्याह्, रे राज्यवजै राह्ङराङ्साः आक्रमन खेनान ङ्याह्। खास्या पुरू साँगुल वैनान ङ्याह्, अनिकालव राह्‌नान ङ्याह्। अन चन चिमिचा झर सुरु रह्पालैम तूरिन सुरु जेङ्पा।”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“ङेनको जेँन बिसयग होस खेखे छ्योवा। ख्युई ङेनकाङ्मोः अदालतग थोन्नान ङ्याह्। ङेनको आराधनालयवग फ्याङ्ची देन्नान ङ्याह्। आलै हाकिमव रे झलीवन ङू ङन खातिर ख्युकाङ्मोः साँचि बिम्म ङेनको च्याङ्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">मत्ती १०:१७-२०</ref>; <ref loc="LUK 12:11-12">लुक १२:११-१२</ref> </char></note> <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />रे सिचेन भेला स्वाचेन ङू पुरू सिमिव ल्होन् लः ताह्फेत्त्वानान। <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />जब सिमिवजै ङेनकाङ्मोः जुङजुङ वव्वै मुर्दा खेनान, तब तै र्‌वाचे र्‌वार्‌वा ङूलै छरा नख्या। जेङ्नै अन्तौ तै ङेनकाङ्मोः बिङ्ङ, अनै र्वा, तैङर्‌वाङिन र्‌वानान ङेनकाङ्मोः नङ्पा, जेङ्नै पबित्र आत्मा जेङ्पा।”<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />“आलै भाइ तीजै घङ भाइग सच्‌चेन भिह्तु बिन्नान ङ्याह्, रे च्योआलैम पाइ यङ ङोह्जो। वैचावजै पोमावन बिरोध च्याङ्नान ङ्याह्, रे ख्युकाङ्मोः सम्म जाःफान्नान ङ्याह्। <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />आलै ङन मिह्‌न्न खातिर ङेनकाङ्मोः पुरूजै ङान्ज्यान खेनान ङ्याह्, जेङ्नै सु अन्त्यन बेर स्हे खेखे छ्युङनन नुनै उद्धार राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती १०:२२</ref></char></note><verse eid="MRK 13:13" /></para>
  <para style="s">मिह्दा दुङालन भेला</para>
  <para style="r">(<ref loc="MAT 24:15-28">मत्ती २४:१५-२८</ref>; <ref loc="LUK 21:20-24">लुक २१:२०-२४</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“जब ङेनको मीपा दोङ्नान्न मस्याङ्मस्याङ लैम चिजग खाः रा मत्वानान स्याह्ई च्याङ्च्याङ छ्युङ्पा रङ्नान ङ्याह्।” (तोअनानजै हाकोवाःयो), तब यहूदिया प्रदेसग ङिह्पान लाक्याँ ज्याराःयो।<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दान ९:२७</ref></char></note> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />यिमन ल्हुपग ङिह्पा पोँ नलिबायो, न ता जेँन यिमलै तयाः छ्युचे झिङ जायो।<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुक १७:३१</ref> </char></note> <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />खेः ङिह्पा जेँन घोलाङ दर्म यिम नहोलाःयो। <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />जेङ्नै ऊफ, मन दिनग ङोजोमा चिमिचाकाङ्मोः रे छ्युम वैचाव केह्‌नान्न मावन भिह्तु हाति ङिनङिन लैम र्‌हदरा! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />अन गुन्जे नराःयो र्‌वार्‌वा परमेस्वरग सोअताप्चे ख्या। <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />तैङर्‌वाङिन मन दिनवग झाम दुङाल स्वानन ङ्याह् कि परमेस्वरजै सन्सार सृस्ति खेपान सुरुलै चोँनबेर स्यीह् न ता झाम रह्पा ङ्याह्, न हातौयै राह्‌नान।<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दान १२:१</ref>; <ref loc="REV 7:14">प्रका ७:१४</ref> </char></note> <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />यदि परमेस्वरजै मन दिन घताई मखेङिन ता सिमि सुई सोन्नान मह्‌या, जेङ्नै नुई दम्पावन खातिर अन दिन घताई खेपा ङ्याह्।<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />अन्तौ सुई ङेनकाङ्मोः “सेह्‌ना, मसिह सि ङिह्पा” आथबा “स्याह्‌ ङ्याह्” र्‌वाङिन, ङेनकाङ्मोः बिस्वास नख्या। <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />तैङर्‌वाङिन लबारन मसिहको रे लबारन भबिस्यबक्ताव च्याङ्नान ङ्याह्, आलै राह्‌नान जेङ्न, परमेस्वरजै दम्पाकाङ्मोः भ्रमग थेपफाम्मः ख्युई ताईलुवान धोन रे हालाईचेन धोनव खेनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="MAT 24:24">मत्ती २४:२४</ref> </char></note> <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />जेङ्नै ङेनकाङ्मोः सापसाप छ्योवा। सेह्‌ना, ङै ङेनकाङ्मोः ल्होई पुरू भेलान ङूलै र्‌वापा ङिह्पा।<verse eid="MRK 13:23" /></para>
  <para style="s">सिमिन ङोह्जो स्वानान</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्ती २४:२९-३१</ref>; <ref loc="LUK 21:25-28">लुक २१:२५-२८</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“जेङ्नै मन दिनग दुङालन छाम्म ङिह्‌मा नातुमा राह्‌नान ङ्याह्, रे धाई जेँन साल्म बिन्नान मह्‌या,<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यसै १३:१०</ref>; <ref loc="EZK 32:7">इज ३२:७</ref>; <ref loc="JOL 2:10">योए २:१०</ref>,<ref loc="JOL 2:31">३१</ref>; <ref loc="JOL 3:15">३:१५</ref>; <ref loc="REV 6:12">प्रका ६:१२</ref></char></note> <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />घर पान्नाङलै घ्यानन ङ्याह्, रे पान्नाङग रह्पा सक्तिव ख्योर्ननङ्या।<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">यसै ३४:४</ref>; <ref loc="JOL 2:10">योए २:१०</ref>; <ref loc="REV 6:13">प्रका ६:१३</ref></char></note> <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />आलै मन भेलाः सिमिवजै सिमिन ङोह्जो सक्ति रे महिमा ङ्याबो नमलुई स्वायङ खेपा रङनन ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दान ७:१३</ref>; <ref loc="REV 1:7">प्रका १:७</ref></char></note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />तब परमेस्वरजै स्वर्गदुतकाङ्मोः फेन्नान ङ्याह्, रे पिर्थीबिन अन्त्यलै पान्नाङन अन्त्यथाल लिब्रुङक्याँलै जेँन दम्पाकाङ्मोः जमता खेनान ङ्याह्।”<verse eid="MRK 13:27" /></para>
  <para style="s">खोअन तङ्पुन पाठ</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्ती २४:३२-३५</ref>; <ref loc="LUK 21:29-33">लुक २१:२९-३३</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“खोअन तङ्पुलै द्रिस्तान्त लह्‌ना: अन्न धा नोर्म राह्‌राह्‌ ल्हा पलाई खेलुङ्मीम रेन्जे ङेमः स्वादँ र्‌वार्‌वा ङेनकाङ्मोः क्युई राह्‌नान। <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />उजुखेखे ङेनकोजै र्‌वार्‌वा जब अन घतनाव रह्पा रङनन, तब अन ङेमः ङ्याह्, झलागै ङ्याह् र्‌वार्‌वा हाकोवा। <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, अन ल्होई पुरू पुरा राह्‌राह्‌ मतानन्नबेर अन पुस्तान सिमि ताह्ताह् वैनान मह्‌या। <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />पान्नाङ रे पिर्थीबी ताह्ताह् वैनान ङ्याह्, जेङ्नै ङन बचन हातौयै ताह्‌नान मह्‌या।”<verse eid="MRK 13:31" /></para>
  <para style="s">अन दिन रे अन भेला सुई क्युई मराह्‌नान</para>
  <para style="r">(<ref loc="MAT 24:36-44">मत्ती २४:३६-४४</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“जेङ्नै मन दिन रे मन भेलान भारेः पाइ नङ्म घङ सुई क्युई मह्‌या, न ता पान्नाङग राह्‌नान स्वर्गदुतवजै न ङोह्जोई।<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">मत्ती २४:३६</ref></char></note> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />सेह्‌ना, सापसाप छ्योवा, रे सोअताप्चे ख्या, तैङर्‌वाङिन अन्न भेला हातौ स्वानन जेङ्पा, अन ङेनकाङ्मोः क्युई मराह्‌नान <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />अन ता मालिकजै जेँन राङ्पाकाङ्मोः यिमन धोन पुरू रे दायित्वन जिम्मा बिमबिम रे पालेग सापसाप छ्योवाःयो र्‌वार्‌वा आग्या बिमबिम परदेस वैपान सिमिदीलैम जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">लुक १२:३६-३८</ref></char></note><verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />“अन्नकारन ङेनकाङ्मोः यङ सापसाप छ्योवा, तैङर्‌वाङिन यिमन ताःपो ङ्याजे, कि छानफेग, कि कापा तर्तौ, कि नाप, हातौ स्वाचे जेङ्पा, अन ङेनकाङ्मोः क्युई मराह्‌नान। <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />तेमन्ता नू तैमेग स्वातौ नुई ङेनकाङ्मोः आःपा धोद्रा। <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />तै ङा ङेनकाङ्मोः र्‌वानान अन ङा पुरूग र्‌वाचे, ‘सापसाप छ्योवा’।”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">येसू सच्‌चेन सदेन्त्र</para>
  <para style="r">(<ref loc="MAT 26:1-16">मत्ती २६:१-१६</ref>; <ref loc="LUK 22:1-6">लुक २२:१-६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />अन्न ङितौन ङिक निस्तार रे सोरा मकानान्न रोतान तेवर ङ्याह्। ङोत्वा पुजारीव रे कानुन लन्नान्न सिमिव येसू कुजुई छकाई पप्पे जुङजुङ सच्‌चेन दाउग ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:2-27">प्रस १२:२-२७</ref></char></note> <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />तैङर्‌वाङिन ख्युई र्‌वापा ङ्याह्, “तेवरन भेला नङ्पा, तेमन्ता सिमिकाङ्मोः फाईराकुईरा मच्‌ची र्हदरा।”<verse eid="MRK 14:2" /></para>
  <para style="s">बेथानियाग येसू दुईपा</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती २६:६-१३</ref>; <ref loc="JHN 12:1-8">यूह १२:१-८</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />येसु बेथानियाग सिमोन कोरन नाह्जा ताह्पान सिमिन यिम झाम छ्युङ्तौ चिमिचादी मिह्दा छाङ्म जतामसीन मकेकुकेन कुम्म अत्तर सिङ्गमरमरन बोतलग सस्सै स्वाबो, रे अन बोदल तिलतिल अन र्हिस्याम जतामसीन मकेकुकेन कुम्म अत्तर येसुन थोप्पा हाल्बो।<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लुक ७:३७-३८</ref></char></note> <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />जेङ्नै कान-कानजै सुतुतु राह्ङराङ्साः र्‌वामः जाःबो, “अन र्हिस्याम मकेकुकेन कुम्म अत्तर तैङ झाम पाह्दुर खेपा? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />तैङर्‌वाङिन अन मकेकुकेन कुम्म अत्तर क्यामसुम मुलन सिक्‌का खेरे ह्‌याल्म र्‌युर्‌यु बिखारीवग अन सोङ भिन तैनन।” आलै ख्युई मन चिमिचा ङार्बो।<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />जेङ्नै येसुई ख्युकाङ्मोः र्‌वाबो, “फेरा, तैङ ङेनकाङ्मोः अजोव तूरि बिन्नान? अनजै ङन भिह्तु धोन ल खेपा ङ्याह्। <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />तैङर्‌वाङिन बिखारीव ता ङेनकाङ्मोः ङ्याबो एकुरो राह्‌नान, रे सम्म छ्युपा कन्न भेला ङेनकाङ्मोः ख्युन भलाइ खेतैनन। जेङ्नै ङा ता एकुरो ङेन ङ्याबो मराह्‌नान।<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">कानुन १५:११</ref></char></note> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />अन चिमिचाई तै खेतैनन अन खेपा ङ्याह्। अनजै ङन ल्हो दुन्नान्न भिह्तु ङूलै र्हिस्याम मकेकुकेन कुम्म अत्तर दुद्‌दुई तयार खेपा ङ्याह्। <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, पुरू सन्सारग खाः-खाः अन ल्होन् लः ताह्फेङ्‌ङ, अन चिमिचाई तै खेपा ङिह्पा नुन चिन्चेन भिह्तु अन धोन्न बर्नन खेनान ङ्याह्।”<verse eid="MRK 14:9" /></para>
  <para style="s">यहूदा येसू घात खेमः दीपा</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्ती २६:१४-१६</ref>; <ref loc="LUK 22:3-6">लुक २२:३-६</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />तब चेला च्योङेपावन बर्ग तीपा यहूदा इस्करियोत चन येसु ख्युन ल्हाग च्योल्चेन भिह्तु ङोत्वा पुजारीव ङ्याबो होई। <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ख्यु अन ताह्ताह् स्याङ्बो, रे नू सोङ बिन्च्योवा र्‌वार्‌वा रेनरुबो। आलै यहूदाई येसू कुजुई जुङ्फान्चे र्‌वार्‌वा र्‌वापालैमन मौका फाम्मः जाःबो।<verse eid="MRK 14:11" /></para>
  <para style="s">येसु जेँन चेलाव ङ्याबो निस्तार तेवरन भत्यार झाँ</para>
  <para style="r">(<ref loc="MAT 26:17-35">मत्ती २६:१७-३५</ref>; <ref loc="LUK 22:7-23">लुक २२:७-२३</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />सोरा मकपान रोता झानान्न तेवरन ङूस्योवान ल्हा, जब ख्युई निस्तार-तेवरन लूचा भोका फुल्ङ, नुन चेलावजै नू लोप्पो, “ङेन इच्छ्या तै ङ्याह्? ङि खाः वैवै ङेन भिह्तु निस्तार-तेवरन भत्यार तयार खेचे?”<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="EXO 12:6">प्रस १२:६</ref>; <ref loc="EXO 12:15">१२:१५</ref> </char></note><verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />आलै येसुई जेँन चेलाव बर्ग ङेपा झाःम र्‌वार्‌वा फेप्पो, “सहरग वया, रे गाःरी त्यु हुरहुर वन्नन सिमि तीपाई ङेनकाङ्मोः दोनन ङ्याह्। नुन ङिक जा। <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />अन सिमि खाः जाःङ मन यिमन तापो र्वा, ‘गुरुज्यू र्‌वाङ, ङन चेलाव ङ्याबो निस्तार-तेवरन भत्यार झानन ङन दम्पु कोठा खाः ङ्याह्?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />आलै नुई ङेनकाङ्मोः लखे दोङदोङ तयार खेपा रुजान कोठा किमदी थन्नन ङ्याह्, रे स्याह्‌ई ङेनजै ङिन भिह्तु भत्यार तयार ख्या।”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />तब मन चेलाव होई, रे सहरग जाःबो, आलै नुई ख्युकाङ्मोः र्‌वापालैम धोबो, रे ख्युई निस्तार-तेवरन पुरू तयार खेबो।<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />ङ्याजे रातौ येसु चेला च्योङेपा ङ्याबो स्वाबो। <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />ख्यु छ्युङछ्युङ झातौ येसुई र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेनकाङ्मोः बर्ग ङन ङ्याबो झानन तीपाई ङा बैरीन पक्राउ थेप्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन ४१:९</ref></char></note><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />ख्यु तुँलाक्या रह्बो, आलै पालिपालि येसू “तै अन ङा जेङ्पौ?” र्‌वार्‌वा लोम्म जाःबो।<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />येसुई ख्युकाङ्मोः र्‌वाबो, “च्योङेपान बर्ग तीपा, सुई ङन ङ्याबो तेर्माः रोता सुप्पा ङ्याह्। <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />तैङर्‌वाङिन पबित्रसास्त्रग सर्पान अन्सार ङा सिमि ङोह्जो जेङ्पा, ङा सित्वानान, जेङ्नै धिक्कार बैरीन ल्हाग पक्राउ थेप्नान मन सिमि सुलम सिमिन ङोह्जो दुङाल राँ। मन सिमि ता मकेह्पा राङिन ल राह्‌नान ङ्याह्।”<verse eid="MRK 14:21" /></para>
  <para style="s">चेलावन ङ्याबो प्रभु भोज</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्ती २६:२६-३०</ref>; <ref loc="LUK 22:14-20">लुक २२:१४-२०</ref>; <ref loc="1CO 11:23-25">१ कोर ११:२३-२५</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />आलै झातौ येसुई रोतादी वव्वै परमेस्वरग असिका तोलतोल क्युप्पो रे चेलाकाङ्मोः बिन्तौ र्‌वाबो, “होरा, अन ङन ल्हो जेङ्पा।”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />आलै खोरे वव परमेस्वरग मया रह्बो र्‌वामी नुई ख्युकाङ्मोः बिम्बो, रे ख्यु पुरूजै मनलै थुङ्बो। <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />आलै येसुई ख्युकाङ्मोः र्‌वाबो, “अन रेनरुपा सार्बान ङन कह जेङ्पा, कन पापीवन तीपा माफ खेचेन भिह्तु फ्यानान। ङन कह सुई परमेस्वरन रेनरुग कप्नान।<note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">प्रस २४:८</ref>; <ref loc="JER 31:31-34">यर ३१:३१-३४</ref></char></note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, ङा अङ्‌गुरन खुलम अन दिन्न बेर थुङ्नान मह्‌या, हातौन बेर परमेस्वरन राज्यग अन सार्बा खेखे मथुङ।” <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />आलै भजन्न धेनदी धेधे ख्यु गेग्गे जैतून धुरीक्याँ होई।<verse eid="MRK 14:26" /></para>
  <para style="s">येसुई पत्रुसन अस्वीकारन भबिस्यबानी खेँ</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती २६:३१-३५</ref>; <ref loc="LUK 22:31-34">लुक २२:३१-३४</ref>; <ref loc="JHN 12:36-38">यूह १२:३६-३८</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनकाङ्मोः पुरू छान ङा ख्योवाख्योवा ज्यार्नान ङ्याह्, तैङर्‌वाङिन झाम पबित्रसास्त्र सर्पा ङ्याह्, ‘परमेस्वरजै ग्वाल्या सन्नान ङ्याह्, रे लूपाव खातत्त्याग वैनान ङ्याह्।’<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">जक १३:७</ref></char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />जेङ्नै सम्पु राह्‌राह्‌ च्याङ्मी ङा ङेनकाङ्मोः खेरे ङू गालील वैनान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती २८:१६</ref></char></note><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पत्रुसजै येसू र्‌वाबो, “पुरूजै ना ख्योवानै बर्ग ङा हातौयै ख्योवानान मह्‌या।”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />तब येसुई पत्रुसग र्‌वाबो, “तेम्माई, ङा ना र्‌वाचे, त्यानै छानजे काःपा ङेरेप तर्चेन ङू नाई ङा मस्योनान र्‌वार्‌वा सुमरेप र्‌वानान ङ्याह्।”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />जेङ्नै पत्रुसजै झन तोप खेखे र्‌वाबो, “नान ङ्याबो ङा सिचेरानै कानि ङा ना मस्योनान र्‌वार्‌वा हातौयै लबर मर्‌वा।” आलै पुरू चेलावजै झाम र्‌वाबो।<verse eid="MRK 14:31" /></para>
  <para style="s">गेतसमनीग येसुन सोअताप</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्ती २६:३६-४६</ref>; <ref loc="LUK 22:39-46">लुक २२:३९-४६</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />आलै येसु रे नुन चेलाव गेतसमनी मिह्‌न्न ठाउँग होई, रे नुई जेँन चेलाकाङ्मोः र्‌वाबो, “ङा सोअताप्चेन बेर ङेनकाङ्मोः स्यीह्ई छ्योवा कोई।” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />तब नुई पत्रुस, याकूब रे यूहन्ना ङ्याबो वप्पो, रे नू लै आत्ति रह्बो रे मिह्दा तुँलाक्या राम जाःबो। <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />नुई ख्युकाङ्मोः र्‌वाबो, “ङन आत्मा सिनैथाल सम्तुइ आत्ति रह्पा ङ्याह्। ङेनकाङ्मोः सि छ्योवा, रे सापसाप छ्योवा।”<note caller="-" style="x"><char style="xo" closed="false">14:34 </char><char style="xt" closed="false"><ref loc="PSA 42:5">भजन ४२:५</ref> </char></note><verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />आलै ङाइ धेरा वैवै येसू सा पो जुबो, रे रातैङिन अन भेला ङनलम ग्याङम रायो र्‌वार्‌वा सोअताप्पो। <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />आलै नुई सोअताप्पो, “अब्बा, पा, नानलम तैस्याङ पुरू राह्‌नान। अन दुङालन खोरे ङनलम पह्रा। जेङ्नै ङै सम खेपालैम नङ्पा, नाई सम खेपालैम रायो।”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />येसु ह्‌याङ स्वातौ चेलाकाङ्मोः आःपा धोबो। नुई पत्रुसग र्‌वाबो, “सिमोन, तै ना आःपाई छ्युङ्पा ङिह्पाऊ? तै घन्तादी यङ मिबा सास्सै छ्युङ मतैबो यौ?” <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />आलै ख्युकाङ्मोः र्‌वाबो, “सापसाप छ्योवा, आलै सोअताप्चे ख्या, रे ङेनकाङ्मोः छोए सेन्चेग नथेबा। आत्मा ता तेम्माई तयार ङ्याह्, जेङ्नै ल्हो ङारमछेःपा ङ्याह्।”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />येसु ह्‌याङ ङेरेप वैवै अनै ल्होईव र्‌वातौ सोअताप्पो। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ह्‌याङ स्वास्वा नुई चेलाकाङ्मोः आःपा धोबो, तैङर्‌वाङिन ख्युन मी मिबाई चुम्पा ङ्याह्, रे नु तै झब बिन्चे, अन मरह्बो।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />येसु सुमरेप स्वाबो, रे ख्युकाङ्मोः र्‌वाबो, “तै ङेनकाङ्मोः हेँ आःआः किम्म खेपा ङिह्पाऊ? ता रह्बो, भेला स्वातबो। सेह्‌ना, सिमिन ङोह्जो पापीवन ल्हाग पक्राउ थेम्मः जाःपा ङ्याह्। <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />च्याँ, वया। सेह्‌ना, ङा जुङ्मः थेप्नान सिमि स्यीह् रह्‌म्मै स्वातपा ङ्याह्।”<verse eid="MRK 14:42" /></para>
  <para style="s">प्रभु येसु पक्राउ थेम्नन</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती २६:४७-५६</ref>; <ref loc="LUK 22:47-53">लुक २२:४७-५३</ref>; <ref loc="JHN 18:3-11">यूह १८:३-११</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />येसु र्‌वातौर्‌वातौ चेला च्योङेपावन बर्ग तीपा यहूदा इस्करियोत तैमेग स्याह्‌ रङ्बो। ङोत्वा पुजारीव, कानुन लन्नान्न सिमिव रे अगुवावजै फेप्पान मोह्ङदी तरवाली रे पेर्गा सस्सै नुन ङ्याबो स्याह्‌ स्वाबो। <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />नु पक्राउ थेप्नानजै ख्युकाङ्मोः झाम ती त्हा बिम्पा ङ्याह्, “सू ङा मोई खेनान, अन सिमि नुई येसु जेङ्पा, नु पक्री ख्या रे ल खेखे होरा।”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />आलै यहूदा स्वाबो, रे तुरुन्तै येसु रह्‌म्म वैवै र्‌वाबो, “हे रब्बी,” रे नू मोई खेबो। <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />तब ख्युई येसू जुङ्बो रे गिरफ्तार खेबो। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />स्याह्‌ रह्‌म्म थाङ्थाङ् छ्युङ्पाकाङ्मोः बर्ग कान तीपाई तरवाली छ्युछ्यु प्रधान पुजारीन राङ्पा फ्याङ्बो रे नुन ती नाम्ज्योवा च्वात्त थुम्बो।<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />येसुई ख्युकाङ्मोः र्‌वाबो, “तै ङेनकाङ्मोः च्यापादीग लैम तरवाली रे पेर्गा यङ सस्सै जुङ्मः स्वापा जेङ्पौ? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />एकुरो आराधनालयग लन्तौ ङा ङेनकाङ्मोः ङ्याबो ङ्याह्, रे ङेनजै ङा पक्री मखेबोयौ। जेङ्नै पबित्रसास्त्रन केह्ः पुरा राःयो।”<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लुक १९:४७</ref>; <ref loc="LUK 21:37">२१:३७</ref></char></note><verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />आलै चेलाव पुरू येसू ख्योवाख्योवा ज्यार्बो।<note caller="-" style="x"><char style="xo" closed="false">14:50 </char><char style="xt" closed="false"><ref loc="PSA 88:18">भजन ८८:१८</ref></char></note><verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />आलै ती छबा जेँन चत्यापा ल्होग ती सुतीन घोलाङ गोन्तौ नुन ङिक जाःबो। रे सिमिवजै नु जुङ्बो, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />जेङ्नै घोलाङ ख्योवाख्योवा अन चत्यापा ज्यार्बो।<verse eid="MRK 14:52" /></para>
  <para style="s">येसु यहूदी महासभान ङू</para>
  <para style="r">(<ref loc="MAT 26:56-68">मत्ती २६:५६-६८</ref>; <ref loc="LUK 22:66-71">लुक २२:६६-७१</ref>; <ref loc="JHN 18:12-13">यूह १८:१२-१३</ref>; <ref loc="JHN 18:19-24">१८:१९-२४</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />तब ख्युई येसु प्रधान पुजारीन ङ्याबो वप्पो; रे स्याह्‌ पुरू ङोत्वा पुजारीव, कानुन लन्नान्न सिमिव रे अगुवाव जोम्पा ङ्याह्। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पत्रुस चन ग्याङमलै प्रधान पुजारीन यिमन ख्यामन झिङ नुन ङिङि जाःबो, आलै स्याह्‌ सिपाहीकाङ्मोः ङ्याबो छ्युङछ्युङ नु मेह् धेम जाःबो। <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />ङोत्वा पुजारी रे यहूदी जोम्पा पुरूजै येसू सच्‌चेन भिह्तु नुन बिरोध साँचि फाप्पो, जेङ्नै तये मदेप्पो। <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />लैजे नुन बिरोध लबारन साँचि बिम्बो, जेङ्नै ख्युई बिम्पा बयान च्योआलैम मरह्बो।<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />कान-कानजै च्याङच्याङ नुन बिरोध झाम लबारन बयान बिम्बो, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“अनजै झाम र्‌वापा ङ्योअग ताह्बो, ‘सिमिन ल्हाई दोङ्पा अन आराधनालय ङा फ्वानन ङ्याह्, रे बिना ल्हाई दोङ्पा घङ आराधनालय ङा सुमङीग दोङ्नन ङ्याह्’।”<note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">यूह २:१९</ref></char></note><verse eid="MRK 14:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MRK 14:59" />जेङ्नै अनगै ख्युन साँचि च्योआलैम मह्‌या।<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />तब प्रधान पुजारीजै घूँ च्याङच्याङ येसू लोप्पो, “तै नान ङ्याबो तये झब मीपाऊ? अन सिमिवजै नान बिरोध बयान बिम्पा तै जेङ्पा?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />जेङ्नै येसुई तये मर्‌वारे छ्युङ्बो, रे झब तये मबिम्बो। ह्‌याङ प्रधान पुजारीजै नू लोप्पो, “तै ना परमधन्यन ङोह्जो मसिह जेङ्पौ?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />येसुई र्‌वाबो, “ङा जेङ्पा, आलै ङेनजै सिमिन ङोह्जो पुरून खेरे सक्ति किम ङिह्पा प्रभुन ल्हा याईपाक्याँ छ्युङ्पा रे पान्नाङन नम्लुन ङ्याबो स्वापा रङ्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दान ७:१३</ref>; <ref loc="PSA 110:1">भजन ११०:१</ref></char></note><verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />तब प्रधान पुजारीजै जेँन घोलाङ छ्योनछ्योन र्‌वाबो, “ङी घङ साँचिव तै त्वाबो? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />ङेनजै लान ल्हुई झपा ता ताह्बो। ङेनकोन सोच तै ङ्याह्?” आलै ख्यु पुरूजै नु सच्‌चेन धलन स्योरस्योरलैम दोङ्बो।<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:1">लेवी २४:१</ref>; <ref loc="LEV 24:16">२४:१६</ref> </char></note><verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />ख्युन बर्ग कान-कानजै येसू छिमा पम्म जाःबो, रे नुन मी पत्ति खीखी नू फ्याङ्बो। ख्युई र्‌वाबो, “ना सुई फ्याङ्बो भबिस्यबानी न।” आलै सिपाहीवजै नु वव्वै ताप्पर फ्याङ्बो।<verse eid="MRK 14:65" /></para>
  <para style="s">पत्रुसजै येसू अस्वीकार खेपा</para>
  <para style="r">(<ref loc="MAT 26:69-75">मत्ती २६:६९-७५</ref>; <ref loc="LUK 22:56-62">लुक २२:५६-६२</ref>; <ref loc="JHN 18:15-18">यूह १८:१५-१८</ref>; <ref loc="JHN 18:25-27">१८:२५-२७</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />पत्रुस पोँ ख्यामग रातौ प्रधान पुजारीन राङ्मावन बर्ग तीपा स्याह्‌ स्वाबो, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />रे पत्रुसग मेह् धेपा रङरङ नु लखे सेनसेन र्‌वाबो, “ना र्‌वार्‌वा येसू नासरीन ङ्याबो ङ्याह्।” <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />जेङ्नै नुई झाम र्‌वाईर्‌वाई अस्वीकार खेबो, “ना तै र्‌वानान झाम ल्होई ङा हाकोँ।” आलै नु खोलोः ताह्ङ्‌राक्याँ होई। आलै काःपा तर्बो। <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />राङ्माई थाङथाङ छ्युङ्पावन ङ्याबो ह्‌याङ र्‌वाम जाबो, “अन ता ख्युन बर्गन ती जेङ्पा।” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />जेङ्नै पत्रुसजै ह्‌याङ अस्वीकार खेबो। आलै ङाइलै धेँवछोँ च्याङ्च्याङ छ्युङ्पावजै ह्‌याङ पत्रुसग र्‌वाबो, “तेम्माई, ना ख्यु बर्गन ती जेङ्पा, तैङर्‌वाङिन ना गालीलन सिमि जेङ्पा।”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />जेङ्नै नुई जेँग धिक्‌कारी खेबो रे रेनरुरु र्‌वामः जाःबो, “सुन भारेः ङेनकाङ्मोः र्‌वानान, मन सिमि ङा मस्योनन।”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />आलै तुरुन्तै काःपा ङेरेप तर्बो। रे पत्रुसग येसुई झाम र्‌वापा ल्होई ह्‌याका स्वाबो, “कापा ङेरेप तर्चेन ङू नाई ङा मस्योनान र्‌वार्‌वा सुमरेप अस्वीकार खेनान ङ्याह्।” आलै मन ल्होईन नावा खेखे नु दाबो।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">पिलातसन ङू येसु</para>
  <para style="r">(<ref loc="MAT 27:11-31">मत्ती २७:११-३१</ref>; <ref loc="LUK 23:2-3">लुक २३:२-३</ref>; <ref loc="LUK 23:18-25">२३:१८-२५</ref>; <ref loc="JHN 18:28-40">यूह १८:२८-४०</ref>; <ref loc="JHN 19:1-16">१९:१-१६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />नाप रालुङ्मीम ङोत्वा पुजारीव, अगुवाव, कानुन लन्नान्न सिमिव रे पुरू यहूदी जोम्पावजै राह्ङराङ्साः सल्‌ला खेखे येसू खीखी वप्पो, रे पिलातसन ल्हाग बिम्बो। <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />पिलातसजै नू लोप्पो: “तै ङेन यहूदीवन झली जेङ्पौ?” येसुई नू झब बिम्बो, “ना नह् र्‌वाङ।”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />ङोत्वा पुजारीवजै नू लै ल्होईन दोस बिम्बो। <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलातसजै नू ह्‌याङ झाःम र्‌वार्‌वा लोप्पो, “तै नान ङ्याबो तये झब मीपाऊ? सेह्‌ना, नान बिरोध ख्युई हाति ल्होईन दोस बिङ्ङ।”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />जेङ्नै येसुई ह्‌याङ झब तये मबिम्बो, सिथाल कि पिलातस हालाईबो।<verse eid="MRK 15:5" /></para>
  <para style="s">येसू सच्‌चेन धल बिम्पा</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्ती २७:१५-२६</ref>; <ref loc="LUK 23:13-25">लुक २३:१३-२५</ref>; <ref loc="JHN 18:39-19:16">यूह १८:३९—१९:१६</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />निस्तार-तेवरन भेला ल्हूलाम अन्सार ती पराग सिमिवजै तोल्पा झ्यालखानाः त्यापा सिमिदी ख्युन भिह्तु पिलातसजै फेङ्‌ङ। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />युद्धन भेलाः बारब्बा मिह्‌न्न ती सिमि युद्ध खेनानवन ङ्याबो झ्यालखानाः ङ्याह्। सुई युद्धग सिमि सह्प्पा ङ्याह्। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />मोह्ङ स्वाबो रे पिलातसग नुन ल्हूलाम अन्सार ख्युन भिह्तु ख्या र्‌वार्‌वा छ्याफुलम जाःबो। <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />जेङ्नै पिलातसजै झाःम र्‌वार्‌वा ख्युकाङ्मोः प्रस्‌न खेबो, “तै ङा ङेन भिह्तु यहूदीवन झली फेरा र्‌वानान ङेनकाङ्मोः सम खेनौ?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />तैङर्‌वाङिन थादोवा खेखेई ङोत्वा पुजारीवजै येसू पिलातसन ल्हाग बिम्पा जेङ्पा र्‌वार्‌वा नु क्युई ङ्याह्।<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />जेङ्नै येसू नङ्पा बरु बारब्बा ङिन भिह्तु पिलातसजै फेरायो र्‌वार्‌वा ङोत्वा पुजारीवजै मोह्ङ्‌ग उल्बाङ खेबो। <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />पिलातसजै ह्‌याङ ख्युकाङ्मोः लोप्पो, “उजु राङिन सु ङेनकाङ्मोः यहूदीवन झली र्‌वानान, नु ङा तै खेचे ता?” <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />ख्यु ह्‌याङ फाईरा खेबो, “नू क्रुसग चुना।” <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />पिलातसजै ख्युकाङ्मोः लोप्पो, “तैङ? नुई तयाः अलः खेपा ङ्याह् तै?” जेङ्नै झन केह्ः किम फाईरा खेखे ख्युई र्‌वाबो, “नु क्रुसग चुना!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />तब पिलातसजै मोह्ङग सम घुफान्चेन समजे ख्युन भिह्तु बारब्बा फेप्पो, रे येसू चेरन ताल्च्याई फ्याङफ्याङ क्रुसग चुम्मः थोप्पो।<verse eid="MRK 15:15" /></para>
  <para style="s">सिपाहीवजै येसुन अपमान खेपा</para>
  <para style="r">(<ref loc="MAT 27:27-31">मत्ती २७:२७-३१</ref>; <ref loc="JHN 19:2-3">यूह १९:२-३</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />सिपाहीवजै येसू प्रेतोरियन, आथबा राज्यपालन दरबारन चोकग वप्पो, रे ह्‌याजन मोह्ङग घ्वाबो।<verse eid="MRK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 15:17" />आलै ख्युई येसू ल्होःम रङन घोलाङ थम्बो, रे चेरन मुकुत दोङ्दोङ नुन थोप्पाः थम्बो, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />आलै ख्युई नु नमस्ते खेखे झाम र्‌वाबो, “यहूदीवन झली छर्‌याङ्म छ्योवा”<verse eid="MRK 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 15:19" />आलै ख्युई नुन थोप्पा मिजे फ्याङतौ नु छिमा पप्पो, रे पो जूजू नु नमस्ते खेबो। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />आलै येसुन माबी पह्‌म्मी ख्युई ल्होःम घोलाङ फोल्बो, रे नुन जेँनै घोलाङ थम्बो। आलै ख्युई नु क्रुसग चुम्मः खोलोः वप्पो।<verse eid="MRK 15:20" /></para>
  <para style="s">येसू क्रुसग चुम्पा</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती २७:३२-४४</ref>; <ref loc="LUK 23:33-43">लुक २३:३३-43</ref>; <ref loc="JHN 19:17-27">यूह १९:१७-२७</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />आलै अलेक्जेन्दर रे रुफसन पा, कुरेनी बासिन्दा सिमोनग नामन लमलै स्वातौ ख्युई धोबो, रे सिपाहीवजै येसुन क्रुस हुरहुर वम्म सिमोनग धिप्पी खेबो।<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">रोम १६:१३</ref></char></note> <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />आलै ख्युई येसू गलगथा र्‌वानान ठाउँग सप्पो। गलगथान धा कह्प्लीन ठाउँ जेङ्पा। <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />आलै ख्युई येसू मूर्र होम्पा अङ्‌गुरन खु थुङ्म बिम्बो। जेङ्नै नुई मथुङ्बो।<verse eid="MRK 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 15:24" />ख्युई नू क्रुसग चुम्बो। आलै सुई कन काला देच्‌चे अन पक्‌का खेमः चित्ता फ्याङफ्याङ ख्युई नुन घोलाङव राह्ङराङ्साः परेःबो।<note caller="-" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजन २२:१८</ref></char></note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />ख्युई नू क्रुसग चुन्तौ नाह्पन नौ बजे रह्पा ङ्याह्। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />आलै नुन दोस-पत्र “यहूदीवन झली” र्‌वानान सर्पा ङ्याह्। <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />आलै ख्युई नुन ङ्याबो खुम्पा ङेपा क्रुसग चुम्बो, ती नुन याईपाक्याँ, रे घङ्ग नुन योम्मक्याँ। <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />[पबित्रसास्त्रन बचन झाःम खेखे पुरा रह्बो, “आलै नू अपराधिव ङ्याबो जेर्बो।”]<note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">यसै ५३:१२</ref></char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />स्याह्‌लै आउजाउ खेनान सिमिवजै जेँन होला कुलैकुलै झाःम र्‌वार्‌वा नुन खिसि खेबो, “वाह! ना आराधनालय फोआफोआ सुमङीग दोङ्नान,<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">भजन २२:७</ref>; <ref loc="PSA 109:25">१०९:२५</ref>; <ref loc="MRK 14:58">मर्क १४:५८</ref>; <ref loc="JHN 2:19">यूह २:१९</ref></char></note> <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />क्रुसलै लिपलिप स्वा, रे जेँग सोमफाना।”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />उजु खेखे ङोत्वा पुजारीवजै कानुन लन्नान्न सिमिव ङ्याबो झाःम र्‌वार्‌वा राह्ङराङ्साः येसुन खिसि खेबो, “अनजै घङ्ग समफाम्बो, जेङ्नै जेँग चन सोन मतैबो। <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />ना तेम्मा मसिह इस्राएलन झली जेङ्न, क्रुसलै लिपलिप स्वा, कि ङि अन रङरङ बिस्वास खेनान ङ्याह्।” नुन ङ्याबो क्रुसग चुम्पावजै नुन ल्होई च्याप्पो।<verse eid="MRK 15:32" /></para>
  <para style="s">येसु सिह्पा</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती २७:४५-५६</ref>; <ref loc="LUK 23:44-49">लुक २३:४४-४९</ref>; <ref loc="JHN 19:28-30">यूह १९:२८-३०</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />बाह्र बजेलै तिन बजेन बेर देस पुरूग नातुमाई गाबो। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />तिन बजेरा झाःम र्‌वार्‌वा येसु केह्ः किमई फाईरा खेबो, “इलोई, इलोई, लामा सबखथनी?” कन्न धा जेङ्पा, “हे ङन परमेस्वर, हे ङन परमेस्वर, नाई ङा तैङ ख्योपा?”<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">भजन २२:१</ref></char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />धेँवछोँ थाङथाङ छ्युङ्नानकाङ्मोः बर्ग कान-कान सिमिवजै अन ताह्ताह् र्‌वाबो, “ङ्याना, नुई एलिया घ्वाङ।” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />आलै ख्युन बर्ग तीपाई धालैधालै होई ती भोङ्म कपास अङ्‌गुरन खुग पुरू सुपसुप र्‌याङ्म मिदी झाःम र्‌वार्‌वा नु थुङ् फाम्बो, “सेम्मता, कार्तौ एलिया नु घ्याम स्वाङिम कि।”<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजन ६९:२१</ref></char></note><verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />तब येसुई केह्ः किम छ्युछ्यु परान पप्पो।<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />आलै आराधनालयग कपा पर्दा ङ्यालै पोँथालै ङेकाराङ राह्‌राह्‌ ज्योम्बो।<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">प्रस २६:३१-३३</ref></char></note> <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />येसुई झाःम खेखे परान पप्पा रङरङ नुन ङू थाङथाङ अफिसरजै र्‌वाबो, “तेम्माई अन सिमि परमेस्वरन ङोह्जो जेअँ।”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />स्याह्‌ ग्याङमलै सेन्नन कान चिमिचाव ङ्याह्। ख्यु बर्ग मरियम मग्दलिनी आलै छ्युम याकूब रे योसेफन मा मरियम रे सलोमी ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">15:40 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">लुक ८:२-३</ref></char></note> <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />नु गालीलग रातौ, अजोव नुन ङिक जाःङ, रे नुन सेवा खेँ। येसुन ङ्याबो यरूसलेमग स्वापा घङ लै चिमिचाव स्याह्‌ ङ्याह्।<verse eid="MRK 15:41" /></para>
  <para style="s">येसू लुम्पा</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती २७:५७-६१</ref>; <ref loc="LUK 23:50-56">लुक २३:५०-५६</ref>; <ref loc="JHN 19:38-42">यूह १९:३८-४२</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />आलै जब ङ्याजे रह्बो, तैङर्‌वाङिन अन तयारीन दिन ङ्याह्, आथबा नाह्‌न ल्हाःन ङूस्योवान ल्हाः, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />महासभान स्योःनान सिमि अरिमाथियान योसेफ, सुई परमेस्वरन राज्यन लम सेनतौ ङ्याह्, नुई सन्तक खेखे पिलातस ङ्याबो वैवै येसुन सिह्पान ल्हो तोल्बो। <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />येसु पहिली सितपा ताह्ताह् पिलातस हालाईबो। आलै अफिसरग जेँन स्याह् घ्वाघ्वा नू सिह्पा जेम कि नम र्‌वार्‌वा लोप्पो। <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />नू सितपान ल्होई अफिसरलम क्युई रामि पितालसजे येसुन सिह्पा ल्हो योसेफग वच्‌चेन आदेस बिम्बो। <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />आलै योसेफजै मलमलन घोलाङ र्‌युबो, रे येसू क्रुसलै पोँ फेप्पे घोलाङजै च्योम्बो, आलै लुङ च्वाच्वा दोङ्पा तुह्‌र्सादीग नाह्‌म्बो। मन्न छाम्म तुर्सान ङुरग नुई लुङ किमदी नाह्‌म्बो। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />मरियम मग्दलिनी रे योसेफन मा मरियमजे येसू कुँह्‌म खाः नाम्पा ङ्याह्, स्याह्‌क्याँ सेम्पा ङ्याह्।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">येसु सिह्पालै सम्पु राह्‌राह्‌ च्याङ्पा</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती २८:१-८</ref>; <ref loc="LUK 24:1-12">लुक २४:१-१२</ref>; <ref loc="JHN 20:1-10">यूह २०:१-१०</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />नाह्‌न ल्हाः वैमी मरियम मग्दलिनी रे याकूबन मा मरियम रे सलोमीजै र्हिस्याम छि येसुन ल्होग दुच्‌चेन भिह्तु र्‌युप्पो। <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />आलै नेर्यान ङूस्योवान दिन नाप्पर्म ङिह्‌मा स्यातौ ख्यु तुह्‌र्साः होई। <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />आलै ख्युई राह्ङराङ्साः र्‌वाबो, “ङिन भिह्तु तुह्‌र्सान ङुरन लुङ किम सुई छ्युचे?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />ङ्याः सेन्तौ ख्युई तुर्सान अन लुङ छ्युछ्यु नाम्पा रङबो। अन लुङ मिह्दा किम ङ्याह्। <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />आलै तुह्‌र्सान झिँङ जाःजाः ख्युई पाह्‌ल्म घोलाङ गोम्पा छबा सिमिदी याईपाक्याँ छ्युङपा रङ्बो, रे ख्यु मिह्दा हालाईबो। <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />नुई ख्युकाङ्मोः र्‌वाबो, “हानलाया, ङेनकाङ्मोः नासरतन येसू फान्नौ, सु क्रुसग चुम्पा ङ्याह्। नु सम्पु राह्‌राह्‌ च्याङ्पा ङ्याह्। नु स्यीह् मह्‌या। नु नाम्पा ठाउँ सेह्‌ना। <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />वया, नुन चेलाव रे पत्रुसग र्‌वा कि नु ङेन ङूह्ङूह् गालीलग वैयङ ङ्याह्। नुई ङेनकाङ्मोः र्‌वापालैम ङेनको नू स्याह्‌ रङ्नान ङ्याह्।” <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />आलै ख्यु येसुन तुह्‌र्सा होङलै गेग्गे धालैधालै होई, तैङर्‌वाङिन ङिनङिन रे हालाईलाई ख्यु दार्पाई छ्युङ्पा ङ्याह्। आलै ख्युई सुई तेय मर्‌वाबो, तैङर्‌वाङिन ख्यु तेम्माई ङिन्पा ङ्याह्।<verse eid="MRK 16:8" /></para>
  <para style="s">येसु मरियम मग्दलिनीग थम्पा</para>
  <para style="r">(<ref loc="MAT 28:9-20">मत्ती २८:९-२०</ref>; <ref loc="LUK 24:13-53">लुक २४:१३-५३</ref>; <ref loc="JHN 20:11-23">यूह २०:११-२३</ref>; <ref loc="ACT 1:4-11">प्रे १:४-११</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />[नेर्यान ङूस्योवान दिन नाप्पर्म नू सम्पु राह्‌राह्‌ च्याङ्मी नू पहिली मरियम मग्दलिनीन ङू थम्बो। नुनलम येसुई मुव ने छ्युपा ङ्याह्। <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />मरियमजे वैवै नुन फुरीकाङ्मोः अन ल्होन बिम्बो। ख्यु समतु खेईखेई दापाई छ्युङ्पा ङ्याह्। <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />जेङ्नै जब येसु सम्पु रह्बो रे मरियमन ङू थम्बो र्‌वानान ल्होई ख्युई ताह्बो, तब ख्युई हीमछेबो।<verse eid="MRK 16:11" /></para>
  <para style="s">चेला ङेह्पाः येसु थम्पा</para>
  <para style="r">(<ref loc="MAT 28:9-10">मत्ती २८:९-१०</ref>; <ref loc="JHN 20:11-19">यूह २०:११-१९</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />आलै चेला ङे नामरा वैतौ ख्युन ङू येसु घङ मेसो थम्बो। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />आलै ख्यु होलहोल होई घङ चेलाकाङ्मोः स्याप्पो। जेङ्नै ख्युई ख्युकाङ्मोः र्‌वार्‌वा बिस्वास मखेबो।<verse eid="MRK 16:13" /></para>
  <para style="s">येसु च्युदी चेलाकाङ्मोः ङू थम्बो</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती २८:१६-२०</ref>; <ref loc="LUK 24:36-49">लुक २४:३६-४९</ref>; <ref loc="JHN 20:19-23">यूह २०:१९-२३</ref>; <ref loc="ACT 1:6-8">प्रे १:६-८</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />ङाईलै येसु च्युदी चेलावन ङू ख्यु झाम छ्युङपान भेला थम्बो, आलै ख्युन अबिस्वास रे सम ख्वान भिह्तु नुई ख्युकाङ्मोः ङार्बो; तैङर्‌वाङिन नू सिह्पालै सम्पु राह्‌राह्‌ च्याङ्मी नू रङ्नानवन ल्होई ख्युई बिस्वास खेपा मह्‌या। <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />आलै येसुई ख्युकाङ्मोः र्‌वाबो, “पुरू सन्सारग वैवै पुरू दोङ्पा सिमिकाङ्मोः ल्होन् लः ताह्फेरा।<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रे १:८</ref> </char></note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />बिस्वास खेनान रे बप्‌तिस्मा वन्नानजै उद्धार देन्नान ङ्याह्, जेङ्नै बिस्वास मखेनानजै धल देन्नान ङ्याह्। <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />बिस्वास खेनानवन ङ्याबो अन ताईलुवान धोन खेनान्न सक्ति बिन्नान ङ्याह्, ख्युई ङन मिह्‌नग मुव दान्नान ङ्याह्, ख्युई सार्बा सार्बा ल्होईवग ल्होई र्‌वानान ङ्याह्, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />ख्युई भुलेनव जुङ्नन ङ्याह् रे कान दू ङिह्पान चिज थुङ्नै तै खेखेई मनजे ख्युन हानि खेनान मह्‌या। ख्युई नाप्पुवावन ल्हाः जेँन ल्हा नान्नन ङ्याह् रे ख्यु तानान ङ्याह्।”<verse eid="MRK 16:18" /></para>
  <para style="s">येसु पान्नाङग लिप्पा</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />तब झाःम खेखे ख्युन ङ्याबो ल्होई र्वातामी प्रभु येसु पान्नाङग लिप्पो, रे परमेस्वरन याईपाक्याँ छ्युङ्बो।<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">प्रे १:९-११</ref> </char></note> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />आलै ख्यु चेलावजै पुरू ठाउँग वैवै ताह्फेप्पो। प्रभुई ख्युन ङ्याबो धोन खेखेई छ्युङ्बो, रे हालाईचेन धोनव रे ख्युई ताह्फेप्पा अन केह्ः तेम्मा ङ्याह् र्‌वार्‌वा पर्मानित खेबो आमेन।]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>