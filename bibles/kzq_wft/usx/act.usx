<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Kaike Standard Traslation</book>
  <para style="h">प्रेरित</para>
  <para style="toc3">प्रे</para>
  <para style="toc2">प्रे</para>
  <para style="toc1">प्रेरितवन धोन</para>
  <para style="mt1">प्रेरितवन धोन</para>
  <para style="mt2">प्रेरितहरूका काम</para>
  <para style="imt">किताबन स्योःचे</para>
  <para style="ip">प्रेरितवन धोन्न किताब मन्दलिन सुरुवातन रुह्ङ जेङ्पा। रे कुजुई अन यरूसलेमलै यहूदिया, सामरिया, रे मन्न खोलोः फेल्बो, ठिक्‌क उजुखेखेई कुजुई येसुई नुन चेलाकाङ्मोः स्वर्गः वैचेन खेरे ङू र्‌वापा ङ्याह् <char style="xt"><ref loc="ACT 1:8">1:8</ref></char>। अन लुकालम सर्पा ङ्याह्। सुई लुका अन्सार ल्होन् लः यङ सर्पा ङ्याह्। नु दाक्तारदी ङ्याह्। रे नुई तेम्मा रे ठिक बिबरनव सर्मः लै होसियारी रह्पा ङ्याह्। नुई जेँन ल्होन् लः रे प्रेरितवन धोन्न किताब “थियोफिलस” ग सम्बोधन खेपा ङ्याह्। सु ग्रिकदी ङ्याह्, जेङ्नै अन किताबव हालम ग्रीक रे यहूदी ङ्योरुमग समाबेस खेनान मसिहेन समुदायवन भिह्तु सर्पा ङ्याह् <char style="xt"><ref loc="ACT 1:1">1:1</ref></char>।</para>
  <para style="ip">प्रेरितवन धोन हालमः मसिह केह्‌मी 60-64 ई:वी परान घूँ सर्पा ङ्याह्, तैङर्‌वाङिन अन किताब पावल ज्यालखानालै गेच्‌चेन खेरे ङू ताह्‌नान। लुका प्रेरित पावल ङ्याबो लेम्पा ङ्याह् रे हालम नुई प्रेरितवन धोन्न किताब एन्तिओखिया सहरग छ्युङछ्युङ सर्पा ङ्याह्। प्रेरितवन धोन लुका ल्होन् लःन लाईलाई जेङ्पा। रे येसु स्वर्गः वैपान घतनालै सुरु राह्‌नान। लुका सर्चेन उदेस्य हालम नुन ल्होन् लःन लैम ङ्याह्। नुई थियोफिलस रे छारैछारै वैपान मसिहेनवन मोङग ख्युई लम्पान तेम्मा ल्होई ङिह्पान कारन पक्‌का राम सर्पा ङ्याह्। रे नुई येसुन जिन्दगी रे मसिहेन्न बिस्तारन बिबरन लः सर्बो।</para>
  <para style="ip">प्रेरितवन धोनजै ङ्योअग ङून मन्दलिन उदाहरन बिङ्‌ङ। रे येसू बिस्वासन जिन्दगी कत्याम रँ र्‌वानान्न ल्होई थङ्‌ङ। प्रेरितवन उदाहरनजै ङ्योअग घङ्न थाल ल्होन् लः साःमः पबित्र आत्मान सक्तिग भर खेमः लन्नान।</para>
  <para style="iot">सङ्‌रचना</para>
  <para style="io1">ङू पबित्र आत्मा चेलाकाङ्मोः स्वाङ रे मन्दली फेल्मः जाःङ। <char style="ior"><ref loc="ACT 1:1">१:१</ref>; <ref loc="ACT 8:1">८:१</ref></char></para>
  <para style="io1">आलै मन्दलीजै तूरि हुर्ङ रे यरूसलेमन खोलोः फेल्मः जाःङ। <char style="ior"><ref loc="ACT 8:2">८:२</ref>; <ref loc="ACT 12:23">१२:२३</ref></char></para>
  <para style="io1">पावल ङू मिसनरी यात्रा खेमः वैङ। <char style="ior"><ref loc="ACT 12:24">१२:२४</ref>; <ref loc="ACT 14:28">१४:२८</ref></char></para>
  <para style="io1">आलै बिस्वासी सार्बाकाङ्मोः तै तोलत्वानान र्‌वानान्न निर्नय खेमः यरूसलेमग जोम्ङ। <char style="ior"><ref loc="ACT 15:1-35">१५:१-३५</ref></char></para>
  <para style="io1">पावल मिसनरी ङेह् यात्रा खेमः वैङ। <char style="ior"><ref loc="ACT 15:36">१५:३६</ref>; <ref loc="ACT 18:22">१८:२२</ref></char></para>
  <para style="io1">आलै मिसनरी सुम यात्रा खेमः वैङ। <char style="ior"><ref loc="ACT 15:23">१५:२३</ref>; <ref loc="ACT 20:38">२०:३८</ref></char></para>
  <para style="io1">पावल यरूसलेमग गिरफ्तार राह्‌नान। <char style="ior"><ref loc="ACT 21:26">२१:२६</ref> </char></para>
  <para style="io1">अन्त्यग नू रोम फेन्नान। <char style="ior"><ref loc="ACT 27:28">२७:२८</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">येसु स्वर्ग वैपा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />स्याङ्पान थियोफिलस, येसुई खेमः रे लह्‌म्मः जाःपा ल्होई पुरून भारेः ङै ङन ङूस्योवान किताबग सर्पा ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">लुक १:१-४</ref></char></note> <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />जेँजै दम्पा प्रेरितकाङ्मोः येसुई पबित्र आत्मान सक्तिलम कोह्‌मी नु स्वर्गः थीथी वप्पान ल्हान बेरन ल्होई पुरू मन किताबग सर्पा ङ्याह्। <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />जेँन तूरि हुर्मी मिह्दा पक्‌का पर्मानलम ख्युन ङू नुई जेँगै सम्पु थम्बो। ङेथलर्या थाल नु ख्युन स्याह्‌ रङ्बो। आलै परमेस्वरन राज्यन भारेः ख्युकाङ्मोः स्याप्पो। <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />ख्युन ङ्याबो झाम छ्युङ्तौ नुई ख्युकाङ्मोः झाःम आदेस बिम्बो, “ङेनको यरूसलेमलै खारै नवया, जेङ्नै पाई रेनरुपा ल्होई पुरा रान बेर कुवा। अन्न भारेः ङेनकोजै ङनलम ताह्तपा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">लुक २४:४९</ref></char></note> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />तैङर्‌वाङिन यूहन्नाई ता त्युई बप्‌तिस्मा बिम्बो, जेङ्नै त्यान खजिर्यान ङिक ङेनकाङ्मोः पबित्र आत्माई बप्‌तिस्मा बिन्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्ती ३:११</ref>; <ref loc="MRK 1:8">मर्क १:८</ref>; <ref loc="JHN 1:33">यूह १:३३</ref></char></note><verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />अन्नकारन जब प्रेरितव जोम्बो, तब ख्युई नू लोप्पो, “हे प्रभु, तै ङेनजै चोँ इस्राएल राज्य ह्‌याङ दोङ्नौ?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />येसुई ख्युकाङ्मोः र्‌वाबो, “पाई जेँन आङलम तोकि खेपान भेला रे लाह् क्युई राह्‌नान ङेनकोन धोन नङ्पा। <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />जेङ्नै पबित्र आत्मा ङेनकोन स्याह् स्वामी ङेनकोजै सक्ति देन्नान ङ्याह्, रे ङेनको यरूसलेमग, यहूदिया पुरूग, सामरियाग रे पिर्थीबिन अन्त्यन नाःथाल ङन साँचि राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">मत्ती २८:१९</ref>; <ref loc="MRK 16:15">मर्क १६:१५</ref>; <ref loc="LUK 24:47-48">लुक २४:४७-४८</ref></char></note> <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />नुई अन ल्होई र्‌वामी, ख्युई सेन्तौसेन्तौ नु स्वर्गक्याँ थीबो, रे नु नमलूग ख्युन मीलै मोल्बो।<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">मर्क १६:१९</ref>; <ref loc="LUK 24:50-51">लुक २४:५०-५१</ref></char></note> <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />जब नु वैयङ खेपा ख्युई ती खेखे पान्नाङक्याँ सेम्पाई छ्युङ्पा ङ्याह्, तब तैमेग पाह्ल्म घोलाङ गोम्पा सिमि ङेपा ख्युन रह्‌म्म स्वास्वा च्याङ्बो। <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />ख्युई र्‌वाबो, “हे गालीलन सिमि हो, ङेनको तैङ पान्नाङक्याँ सेनैसेनै थाङथाङ छ्युङ्पा ङिह्पा? अनै येसू, सु ङेनकोलम स्वर्गः वप्पो, चोँ कुजुई ङेनकोजै नू स्वर्गः वैपा रङ्बो, उजुखेखेई नु ह्‌याङ स्वानान ङ्याह्।”<verse eid="ACT 1:11" /></para>
  <para style="s">येसुई मतियासग दम्पा</para>
  <para style="r">(<ref loc="MAT 27:3-10">मत्ती २७:३-१०</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />तब प्रेरितव जैतुन मिह्‌न्न धुरलै यरूसलेम होल्बो। यरूसलेम सहरलै अन धुर क्वाईमाल्‌ला: किलोमितर तीतौ ग्याङम ङ्याह्। <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />सहरन झिङ जामी ङ्याल्क्यान तलान जेँ छ्युङ्नान्न कोठाः लिप्पो। ख्यु चन पत्रुस, यूहन्ना, याकूब, अन्द्रियास, फिलिप रे थोमा, बारथोलोमाइ रे मत्ती, अल्फयसन ङोह्जो याकूब रे उग्रपन्थी पातिन सिमोन रे याकूपन ङोह्जो यहूदा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">मत्ती १०:२-४</ref>; <ref loc="MRK 3:16-19">मर्क ३:१६-१९</ref>; <ref loc="LUK 6:14-16">लुक ६:१४-१६</ref></char></note><verse eid="ACT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 1:14" />हातिपा चिमिचाव रे येसुन मा मरियम आलै नुन भाइवन ङ्याबो प्रेरित पुरूव सम ती राह्‌राह्‌ लाईलाई सोअताबाईताबाई छ्युँ। <verse eid="ACT 1:14" /><verse number="15" style="v" sid="ACT 1:15" />अन्तौ बिस्वासी थिक्‌कोवन घूँ पत्रुस च्याङ्बो (अन सिमिवन मोङ क्वाईमाल्‌ला: रूथल ङ्याह्), रे र्‌वाबो, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“बिस्वासी थिक्‌कोव हो, पबित्रसास्त्रन बचन पुरा रात्वानान, कन बचन येसू जुङ्नानवन ताङ्बोन अगुवा यहूदान भारेः दाऊदन ङुरलम ङूलै पबित्र आत्माई ल्होई र्‌वापा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन ४१:९</ref></char></note> <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />तैङर्‌वाङिन यहूदान जेर्‌ताँ ङिन ङ्याबोई रह्पा ङ्याह्। रे अनै धोनग नुई ठाउँ देप्पा ङ्याह्।”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />येहूदाई तीपान कमाईलै खेःदी र्‌युबो, आलै युजार्ग घ्याबो रे नुन फौ दिल्बो, रे नुन खोअ पुरू गेप्पो।<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="MAT 27:3-8">मत्ती २७:३-८</ref></char></note> <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />अन ल्होई यरूसलेमग छ्युङ्नान पुरूवग क्युई रह्पा। अन खेःन मिह्‌न ख्युन जेँन ल्होईग आखेल्दमा नाह्‌म्बो, आथबा कहन खेः।<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />पत्रुसजै र्‌वाबो, “तैङर्‌वाङिन भजनसङ्ग्रहन किताबग झाम सर्पा ङ्याह्, ‘नुन यिम होङ रायो, रे स्याह्‌ छ्युङ्नान सुई नराःयो रे नुन धोन्न जिम्मा घङजै होराःयो।’”<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">भजन ६९:२५</ref>; <ref loc="PSA 109:8">१०९:८</ref></char></note> <verse eid="ACT 1:20" /><verse number="21" style="v" sid="ACT 1:21" />अन्नकारन ङिन ङ्याबो छ्युङ्नान सिमिव बर्ग झाम तीपा मफाखाईमे ङ्याह्, कन सिमि प्रभु येसू ङिन घूँ छ्युङछ्युङ खोलोः-झिङ खेतौ एकुरो ङिन ङ्याबो ङ्याह्,<verse eid="ACT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 1:22" />“आथबा झाम सिमि सु यूहन्नान बप्‌तिस्मालै वव्वै नु ङिनलम स्वर्गक्याँ वप्पान दिन्न बेर ङिन ङ्याबो ङ्याह्। मन सिमि ङिन ङ्याबो ङ्याबोई नु सिपालै सम्पु ग्युर्पान साँचि रात्वानान।”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />ख्युई ङेपा, आथबा बरनाबास र्‌वानान योसेफ, सुन तेम्मा मिह्‌न युस्तस ङ्याह्, रे मतियास मिह्‌न नाह्‌म्बो। <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />ख्युई झामखेखे सोअताप्पो, “सिमि पुरून समन ल्होई क्युई राह्‌नान प्रभु, अन ङेह्‌न बर्ग ङेनजै सू दम्पा ङ्याह् अन ङ्योअग थना, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />रे नु अन सेवा रे प्रेरितन धोनग जाः तयाःयो, कन सेवालम यहूदा ज्यारज्यार जेँन ठाउँ अलःग सिह्बो।” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />आलै ख्युई मन ङेह्‌न घूँ चित्ता फ्याङ्बो, रे मतियासन मिह्‌नग तँम्बो, रे प्रेरित च्युदीवन ङ्याबो नुन जेर्‌ताँ रह्पा।<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">पबित्र आत्मा स्वापा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />जब पेन्तिकोसन दिन स्वाबो, तब बिस्वासी सिमि पुरूव तीपू जोम्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लेवी २३:१५-२१</ref>; <ref loc="DEU 16:9-11">कानुन १६:९-११</ref></char></note> <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />आलै स्वर्गलै तैमेग लन किमन तोप लैम ती केह्ः स्वाबो, रे ख्यु छ्युङपा यिम पुरू नाङ्बो। <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />आलै मेह्‌न लहीव लैम ख्युन स्याह्‌ रङ्बो, रे फे-फे राह्‌राह्‌ ख्यु पुरून लाह्ः छ्युङ्बो। <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />आलै ख्यु पुरू पबित्र आत्माई नाङ्बो, रे पबित्र आत्माई ख्युकाङ्मोः बिम्पा ल्होई र्‌वाचेन सक्तिलम ख्यु घङ-घङ ल्होईवग ल्होई र्‌वामः जाःबो। <verse eid="ACT 2:4" /><verse number="5" style="v" sid="ACT 2:5" />स्वर्गन पोँ रह्पा देस पुरूलम ला तेन्नान यहूदीव अन्तौ यरूसलेमग ङ्याह्। <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />तब अन केह्ः ताह्ताह् मोङ जोम्बो। ख्यु हालाईबो, तैङर्‌वाङिन पुरूजै जेँ-जेँन ल्होईग ख्युई ल्होई र्‌वापाई रह्पा ताह्बो। <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />ख्यु पुरू हालाईबो, रे हालाईलाई र्‌वामः जाःबो।, “तै अन ल्होई र्‌वानान पुरूव गालीलन सिमिव नङ्पा तै? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />कुजुई ख्यु पुरूजै ङिन जेँन ल्होईग ल्होई र्‌वापा ङि ताँ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />ङि स्यीह् पार्थीव, मादीव रे एलामीव, रे मेसोपोतामियान, यहूदियान, कापादोकियान, पोन्तस रे एसिया छ्युङ्नानव ङिह्पा। <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />आलै फ्रिगिया, पामफिलिया, मिस्र रे कुरेनीग परि राह्‌नान लिबियान हातिपा देसव रे रोमलै स्वापा यहूदी रे यहूदी कानुन ङ्यान्नानव ङ्योरुम ङिह्पा, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />क्रेतग छ्युङ्नानव, रे अरब देसलै स्वापान सिमिव जेङ्पा। ङि यहूदी रा, या यहूदी धर्म मानि खेनान, या यहूदीन खोलोःन सिमि रा। अजोवजै परमेस्वरजै खेनान्न मकेकुकेन किम धोनवन भारेः ल्होई र्‌वापा चन ङि जेँ-जेँन ल्होईग ताँ।” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />ख्यु पुरू हालाईबो रे राह्‌ङराङ्साः र्‌वामः जाःबो, “अन्न अर्थ तै जेँ?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />जेङ्नै घङवजै बिस्वासीकाङ्मोः रैरै र्‌वाबो, “ख्यु ता रःसि थुङथुङ योप्पा ङ्याह्।”<verse eid="ACT 2:13" /></para>
  <para style="s">पत्रुसन ल्हो‌न</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />जेङ्नै पत्रुसजै च्युदीपान ङ्याबो च्याङच्याङ केह्ः किम खेखे मोङग र्‌वाबो, “यहूदियान सिमि हो, रे पुरू यरूसलेमग छ्युङ्नान पुरूव ङेनकाङ्मोः अन ल्होई क्युई रायो, रे ङन ल्होई ङ्याना। <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />तैङर्‌वाङिन ङेनजै छुपालैम अजोव योप्पा मह्‌या, तैङर्‌वाङिन चोँ न्हापन नौ मात्र बजि रह्पा ङ्याह्”। <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />जेङ्नै योएल भबिस्यबक्तालम र्‌वापा ल्होई अनै जेङ्पा, <verse eid="ACT 2:16" /><verse number="17" style="v" sid="ACT 2:17" />अन्त्यन भेला झाम राह्‌नान ङ्याह् र्‌वार्‌वा परमेस्वर र्‌वाङ, ङा सिमि पुरूवन लाह्ः ङन आत्मा हाल्नान ङ्युँ, रे ङेन ङोह्जोव, रे ङेन चमेःवजै भबिस्यबानी र्‌वानान ङ्याह्, रे ङेन छबावजै दर्सन रङ्नान ङ्याह्, रे ङेन काप्पोव मङ मङ्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">योए २:२८-३२</ref></char></note> <verse eid="ACT 2:17" /><verse number="18" style="v" sid="ACT 2:18" />जेङ्पा, ङा अन्तौ जेँन राङ्पा-राङ्मावन लाह्ः ङन आत्मा हाल्नान ङ्युँ, रे ख्युई भबिस्यबानी र्‌वानान ङ्याह्। <verse eid="ACT 2:18" /><verse number="19" style="v" sid="ACT 2:19" />ङा तोह्ः पान्नाङग ताईलुवान धोन रे माह्ः पिर्थीबी हालाईचेन धोनव खेनान ङ्युँ। कह, मेह्, रे तुह्प्पान मूपा थन्नान ङ्युँ। <verse eid="ACT 2:19" /><verse number="20" style="v" sid="ACT 2:20" />परमप्रभुन मकेकुकेन किम रे गौरवमय दिन स्वाचेन खेरे ङू ङिह्‌मा नाःतुमाः रे धा कहलैम राह्‌नान ङ्याह्। <verse eid="ACT 2:20" /><verse number="21" style="v" sid="ACT 2:21" />आलै सुई परमप्रभुन मिह्‌न वन्नान ङ्याह्, नुई उद्धार देन्नान ङ्याह्। <verse eid="ACT 2:21" /><verse number="22" style="v" sid="ACT 2:22" />हे इस्राएली हो, अन ल्होई ङ्याना! नासरतन येसू झाम सिमि ङ्याह्, सू परमेस्वरजै ताईलुवान धोनव, ताईलोवान धोनव रे हालाईचेन धोनवलम ङेन ङू पर्मानित खेबो। ङेनकाङ्मोः क्युई ङ्याह् कि परमेस्वरजै ङेन घूँ अन धोनव येसुलम खेपा जेङ्पा। <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />परमेस्वरजै ठहर्याई खेपान योजन पक्‌का रे ङूई खेतपा निर्नय अन्सार जुङ्पा अनै येसू पापी सिमिवन ल्हालम ङेनकोजै नू क्रुसग चुनचुन सह्प्पो।<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">मत्ती २७:३५</ref>; <ref loc="MRK 15:24">मर्क १५:२४</ref>; <ref loc="LUK 23:33">लुक २३:३३</ref>; <ref loc="JHN 19:18">यूह १९:१८</ref></char></note> <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />येसू परमेस्वरजै सिचेन तूरिलै फाफा सम्पु ग्युर्फाम्बो। तैङर्‌वाङिन नु कालन अधिनग लुईपाई छ्युङ्चे रा मतैनान्न ल्होई ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">मत्ती २८:५-६</ref>; <ref loc="MRK 16:6">मर्क १६:६</ref>; <ref loc="LUK 24:5">लुक २४:५</ref></char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />तैङर्‌वाङिन दाऊदजै नुन भारेः र्‌वाङ, “ङै प्रभू एकुरो ङन ङू रङ्पा, तैङर्‌वाङिन ङा नङिनाःयो र्‌वार्‌वा नु ङन याईपाक्याँ ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">भजन १६:८-११</ref></char></note> <verse eid="ACT 2:25" /><verse number="26" style="v" sid="ACT 2:26" />अन्नकारन ङन सम किम्म रे ङन ङुर स्याङस्याङ ल्होई र्‌वाङ। अन नङ्म ङन ल्होजै र्‌वार्‌वा आसग सोन्नान ङ्याह्, <verse eid="ACT 2:26" /><verse number="27" style="v" sid="ACT 2:27" />तैङर्‌वाङिन ङेनजै ङन परानग पातालग ख्योवानान मह्‌या। रे जेँन पबित्र सिमिन ल्हो तुर्साः तोह्‌नफान्नान मह्‌या। <verse eid="ACT 2:27" /><verse number="28" style="v" sid="ACT 2:28" />नाई ङाः जिन्दगीन लमव थम्पा ङ्याह्, नान ङ्याबो रातौ ङा यामयाम स्याङ्नान।”<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">भजन १६:८-११</ref></char></note><verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />“ङन इस्राएली भाइ हो, ङिन खेपुल झली दाऊदन भारेः ङा ङेनकाङ्मोः स्पस्त खेखे र्‌वा तैनान, कि नु सिह्बो रे लुँह्‌म्बो। आलै त्यान बेर नुन तुर्सा ङ्याह्। <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />जेङ्नै दाऊद भबिस्यबक्ता ङ्याह् रे नुनै सन्तानलम तीपा नुन सिङ्‌हासनग छ्युङ्नान ङ्याह् र्‌वानान्न ल्होई नू क्युई ङ्याह्। परमेस्वरजै नुन ङ्याबो अन रेनरुपा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">२ सामू ७:१२-१३</ref>; <ref loc="PSA 132:11">भजन १३२:११</ref></char></note> <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />अन स्वानान्न ल्होई रङरङ, नुई मसिहन सिह्‌सिह्‌ सम्पु ग्युर्पान ल्होई र्‌वाबो, कि नु पातालग ख्योवाबो, न ता नुन ल्होई तोह्म्बो।”<verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />अनै येसू परमेस्वरजै सिपालै सम्पु दोङ्बो। अन ल्होईन साँचि ङि पुरू ङिह्पा। <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />अन्नकारन परमेस्वरजै नू जेँन याईंपा लाह्‌ग किम दोङ्बो। आलै परमेस्वर पाई नू पबित्र आत्मा बिम्बो, कन नुई बिन्चेन भिह्तु रेनरुपा ङ्याह्। आलै नुई अन पबित्र आत्मा हाल्बो, कन ङेन चोँ रङ्नान रे ताह्‌नान। <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />तैङर्‌वाङिन दाऊद पान्नाङग वैपा मह्‌या। बरु नुई र्‌वाबो, “परमप्रभुई ङन प्रभू र्‌वाबो, ना ङन लाह् याईपाक्याँ छ्योवा,<note caller="-" style="x"><char style="xo" closed="false">2:34 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन ११०:१</ref></char></note> <verse eid="ACT 2:34" /><verse number="35" style="v" sid="ACT 2:35" />जबथाल ङा नान बैरिकाङ्मोः नान ल्हेन तिङ्पान पोँ मनान।”<note caller="-" style="x"><char style="xo" closed="false">2:35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन ११०:१</ref></char></note><verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“अन्नैकारन इस्राएलीन सिमि पुरूजै अन तेम्माई क्युई रायो, कि येसु, सू ङेनजै क्रुसग चुम्बो, परमेस्वरजै नू प्रभु रे मसिह दोङ्बो।”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />अन ताह्ताह् ख्युन सम खङ्बो। आलै ख्युई पत्रुस रे घङ प्रेरितकाङ्मोः लोप्पो, “हे जिङ्‌को हो, आन ता ङी तै खेचे?” <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />पत्रुसजै ख्युकाङ्मोः र्‌वाबो, “घ्योप्पा ख्या, ङेन तीपान माफ देच्‌चेन भिह्तु येसू मसिहन मिह्‌नग ङेन पुरूजै बप्‌तिस्मा होरा, रे ङेनजै पबित्र आत्मान बर देन्नान ङ्याह्। <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />तैङर्‌वाङिन अन रेनरुपा ङेन भिह्तु, ङेन सन्तान्न भिह्तु रे ग्याङ्म ग्याङ्मन सिमि पुरूवन भिह्तु जेङ्पा, पुरू सू प्रभु ङिन परमेस्वरजै जेँन ङ्याबो स्वा र्‌वानान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="JOL 2:32">योए २:३२</ref></char></note><verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />घङ लै ल्होईवलम पत्रुसजै ख्युकाङ्मोः चेतावनी बिम्बो, रे झाःम र्‌वार्‌वा खाईकोए यङ बिम्बो, “अन सिमि अलःवन ङ्या स्वानान्न धललम जेँग सोमफाना।”<note caller="-" style="x"><char style="xo" closed="false">2:40 </char><char style="xt" closed="false"><ref loc="DEU 32:5">कानुन ३२:५</ref>; <ref loc="PSA 78:8">भजन ७८:८</ref></char></note> <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />तब सुवा-सुवाजै नुन ल्होई स्वीकार खेबो, ख्युई बप्‌तिस्मा वप्पो, रे अन्नै लाह्‌ क्वाईमाल्‌ला हजार सुम सिमिव ख्युन मोह्ङ्‌ग पोह्‌न रह्बो।<verse eid="ACT 2:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />ख्यु प्रेरितवन छोए, सङ्‌गति रे रोता क्युप्मः रे सोअतापग भक्ति खेखे जाःङ।<verse eid="ACT 2:42" /></para>
  <para style="s">बिस्वासीवन जिन्दगी</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />प्रेरितवजै लै ताईलुवान धोनव रे हालाईचेन धोनव थङ्‌ङ। मन्नकारन सिमिव परमेस्वरग ङिङ्‌ङ जाःबो। <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />बिस्वास खेनानव भरी पुरू ङ्याबो छ्युँ, रे ख्युन तैस्याङ पुरू पीमा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">प्रे ४:३२-३५</ref></char></note> <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />ख्युई जेँन क्यु रे खेः र्‌युर्‌यु अन सुवा-सुवाः तयाः-तयाः त्वाङ पुरूग परेङ। <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />ख्यु समन ती राह्‌राह्‌ यरूसलेमन आराधनालयग ङ्याबो जोम्ङ, रे यिम-यिम रोता क्युप्ङ, रे ख्यु स्याङपा रे सम छाङ्मै दीदी झाँ, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />रे परमेस्वरन प्रसङ्सा खेँ, रे सिमि पुरू नुनलम किम्म ङ्याह्, आलै सु उद्धार देङ्‌ङ प्रभुई एकुरो ख्युन मोह्ङ्‌ग पोह्‌न काँ।<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">तीपा खोर्या ताःफाम्पा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />पत्रुस रे यूहन्ना ङिजे तिन बजे सोअताप्चेन भेला आराधनालयग वैयङ ङ्याह्। <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />आराधनालयन झिङ जाःनानवन ङ्याबो भीक तोल्मः तीपा केतौलैन खोर्याः सिमिव हुरहुर सङ्‌ङ रे एकुरो आराधनालयन सुन्दर मिह्‌न्न झलाः नाह्ङ्‌ङ। <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />पत्रुस रे यूहन्नाः आराधनालयन झिङ जाम जाःपा रङरङ नुई भीक तोल्बो। <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />यूहन्नान ङ्याबोई पत्रुसजै नू तीह् सेनसेन र्‌वाबो, “स्यीह् सेह्‌ना!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />ख्युन लम तयाः देच्‌चेन आस खेखे नुई ध्यान बिमबिम ख्युकाङ्मोः सेह्‌म्बो।<verse eid="ACT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6" />तब पत्रुसजै र्‌वाबो, “मुल रे मर ता ङन ङ्याबो मीपा। जेङ्नै तै ङन ङ्याबो ङिह्पा, अन ङा नाः बिन्चे। नासरतन येसु मसिहन मिह्‌नग च्याँ आलै ल्हेना!” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />नुई लुल्यान लाह् याईपा जुङ्जुङ् नू सोल्बो, रे तुरुन्तै नुन तीङ्पाव रे लेह्‌न छीवग तोप स्वाबो। <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />आलै नु हतपत च्याङ्बो रे ल्हेम्म जाःबो, रे ल्हेनैल्हेनै, बोरैबोरै परमेस्वरन प्रसङ्सा खेईखेई ख्युन ङ्याबो आराधनालयग जाःबो। <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />जब सिमि पुरूवजै नू लेनयङ खेपा रे परमेस्वरन प्रसङ्सा खेपाई रह्पा रङ्बो। <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />तब ख्युई नू आराधनालयन सुन्दर मिह्‌न्न झलाः भीक तोल्मः छ्युङ्‌पाछ्युङ्त्वा खेनान अनै जेङ्पा र्‌वार्‌वा स्योःबो, रे नुन लाह्ः रह्पान ल्होईग ख्युई यामयाम हालाईबो।<verse eid="ACT 3:10" /></para>
  <para style="s">आराधनालयग पत्रुसन खाईकोए</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />अन सिमि पत्रुस रे यूहन्नान ङिह्‌ङिह्‌ जाःपा रङरङ सिमि पुरूव मिह्दा हालाईलाई सोलोमन मिह्‌न्न नाह्पू ङ्याबो ख्युन स्याह्‌ धालैधालै स्वाबो। <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />अन रङरङ पत्रुसजै सिमिकाङ्मोः र्‌वाबो, “इस्राएलन सिमि हो, अन ल्होईग ङेन तैङ हालाईनान? ङेन ङ्योअग झामखेखे सेह्ङ्‌ङ कि कन सिमि सक्ति आथबा भक्तिलम ङ्योअजै अनग ल्हेनतैनान दोङ्पालैम ङ्योअग तैङ झामखेखे सेन्नान? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />अब्राहाम, इसहाक रे याकूबन परमेस्वर, ङिन खेपुलन परमेस्वरजै जेँन सेवक येसू महिमित दोङ्‌बो, सू ङेनकोजै जुङ्‌फाम्बो, रे पिलातसजै नू फेच्‌चेन फैसला खेचे फात्तौ यङ ङेनकोजै नू नुनै ङू अस्वीकार खेबो।<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">प्रस ३:१५</ref></char></note> <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />ङेनजै मन पबित्र रे धर्मी येसू अस्वीकार खेबो, आलै झाम छुपा कि सिमि सन्नानदीग ङेनकोन भिह्तु फेराःयो।<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">मत्ती २७:१५-२३</ref>; <ref loc="MRK 15:6-14">मर्क १५:६-१४</ref>; <ref loc="LUK 23:13-23">लुक २३:१३-२३</ref>; <ref loc="JHN 19:12-15">यूह १९:१२-१५</ref> </char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />रे जिन्दगी सोम्फान्नान सिमी ङेनजै सह्प्पो, सू परमेस्वरजै सिह्पालै सोल्बो, ङि अन्न साँचि ङिह्पा। <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />नुन मिह्‌न्न लाह्ः खेपा बिस्वासजै रे नुनै मिह्‌नजै ङेनजै रङ्पा रे क्युई रह्पा अन सिमी ङार्छेम दोङ्बो। येसुलम देप्पा बिस्वासजै अन सिमी ङेन पुरून ङू पुरा ताःफाम्बो।”<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />ता हे इस्राएली जिङ्‌को हो, ङाः क्युई ङिह्पा, कि ङेनजै छतर्याःग उजु खेबो, रे ङेन हाकिमवजै र्‌वार्‌वा उजुई खेबो। <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />नुन मसिहजै तूरि हुरत्वानान र्‌वार्‌वा परमेस्वरजै भबिस्यबक्ता पुरून ङुरलै र्‌वापा भबिस्यबानी नुई झामखेखे पुरा खेबो। <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />ता ङेनको जेँ-जेँन तीपा स्वीकार खेखे परमेस्वरक्याँ होला, आलै ङेनकोन तीपा पुरू माफ राह्‌नान ङ्याह्, झामखेखे ङेनजै परमेस्वरलम आत्माग किम्म रे सक्ति देन्नान ङ्याह्, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />रे परमेस्वरजै ङेन भिह्तु ङूलै दम्पान मसिह आथबा येसू फेन्नान। <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />परमेस्वरजै ताङ्बोलै जेँन पबित्र भबिस्यबक्तावन ङुरलै र्‌वापा तैस्याङ पुरू ह्‌याङ दोङ्चेन भेला मस्वान बेर मसिह स्वर्गः तेम्माई छ्युङ्त्वानान। <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />मोसाई र्‌वापा ङ्याह्, “परमप्रभु परमेस्वरजै ङाः सोल्पालैम ङेन थिक्‌कोवन घूँलै तीपा भबिस्यबक्ता ङेन भिह्तु सोल्नान ङ्याह्। नुई ङेनकाङ्मोः तयाः-तयाः र्‌वानान ङ्याह् मन ल्होई पुरू ङेनजै ङ्यान्त्वानान।<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">कानुन १८:१५-१८</ref></char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />झाःम राह्‌नान ङ्याह्, कि मन भबिस्यबक्ताः मङ्यान्नान प्रानी पुरू परमेस्वरन सिमिवलम फानान ङ्याह् रे मीपा राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="LEV 23:29">लेवी २३:२९</ref>; <ref loc="DEU 18:19">कानुन १८:१९</ref></char></note><verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />“सामुएललै वव्वै नुन ङिकन भबिस्यबक्ता पुरूव हातिपाई ल्होई र्‌वापा ङ्याह्, ख्यु पुरूजै अनै दिनवन घोसना खेपा ङ्याह्। <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />ङेन मनै भबिस्यबक्तावन रे मनै रेनरुपान सन्तान जेङ्पा, कन रेनरुपा परमेस्वरजै ङेन खेपुल अब्राहामन ङ्याबो झाःम र्‌वार्‌वा झबो, ‘नान जेँन सन्तानग पिर्थीबिन पयार पुरूजै असिका देन्नान ङ्याह्।’<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">उत २२:१८</ref> </char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />ङेन पुरूग जेँन अलः लमलै होलहोल ङेनकाङ्मोः असिका बिन्चे र्‌वार्‌वा परमेस्वरजै जेँन सेवकग सोल्बो रे ङू ङेन स्याह्‌ फेप्पो।”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">येहूदीवन किम अदालतन ङू पत्रुस रे यूहन्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />पत्रुस रे यूहन्ना सिमिवन ङ्याबो ल्होई र्‌वायङ ङ्याह्, पुजारीव, आराधनालयन सेनापति रे सदुकीव ख्युन स्याह्‌ स्वाबो। <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />मन प्रेरित ङेह्पावजै “येसु सिह्पालै सम्पु ग्युर्बो, मन्नकारन घङ सिह्पान सिमिव यङ सम्पु ग्युर्नान ङ्याह्।” र्‌वार्‌वा पर्मान बिम्बो। अन्नकारन सदुकिव सुतूबो। <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />तब ख्युई अजोवग जुङ्‌बो, रे नाप्चेन बेर ज्यालग नाह्‌म्बो, तैङर्‌वाङिन अन्तौ ङ्याजे रातपा ङ्याह्। <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />जेङ्नै बचन ङ्यान्नानवन बर्ग लैःजै बिस्वास खेबो, बिस्वास खेनानवन ताँका क्वाईमाल्‌ला: हजार ङा रह्पा।<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />नाप्चे अजोवन सासकव, अगुवाव रे कानुन लन्नान्न सिमिव यरूसलेमग जोम्पा ङ्याह्। <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />प्रधान पुजारी हन्नास, कैयाफा, यूहन्ना, अलेक्जेन्दर रे प्रधान पुजारीन पयार पुरू स्याह्‌ ङ्याह्। <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />ख्युई पत्रुस रे यूहन्नाः घूँ सोलसोल लोप्पो, “कन सक्तिलम आथबा सुन मिह्‌नग ङेनजै अन खेपा जेङ्पा?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />तब पबित्र आत्माई नाङ्पा राह्‌राह्‌ पत्रुसजै ख्युकाङ्मोः र्‌वाबो, “सिमिवन हाकिम रे अगुवा हो, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />त्या ङी खोर्या सिमिदीन ङ्या धोन लःदी खेपान भारेः नु कुजुई ताःबो र्‌वार्‌वा ल्होङ्‌ङिन, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />ङेन पुरूग रे इस्राएलन सिमि पुरूग क्युई रायो, कि ङेनजै क्रुसग चुम्पान रे परमेस्वरजै सिह्पालै सम्पु दोङ्पा, नुई नासरतन येसू मसिहन मिह्‌न्न सक्तिग अन सिमि ङेन ङू सिम राह्‌राह्‌ थाङ्थाङ् छ्युङ्पा ङ्याह्।” <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />येसु ती जेङ्पा सुन भिह्तु पबित्रसास्त्रजै र्‌वाङ, “कन लुङग ङेन खार्बावजै काम मीपा र्‌वार्‌वा छुछु पप्पो, अनै कोप्चान धुरन-लुङ रह्बो।<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">भजन ११८:२२-२३</ref>; <ref loc="DAN 2:34-35">दान २:३४-३५</ref></char></note> <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />घङ सुई र्‌वार्‌वा मुक्ति मया, तैङर्‌वाङिन सिमिवजै मुक्ति देच्‌चेन भिह्तु पान्नाङन पोँ सिमिकाङ्मोः घङ मिह्‌न तये बिम्पा मया।”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />जब ख्युई पत्रुस रे यूहन्नान हिम्मत रङ्बो, रे अजोव छोए मलम्पा रे साधारन सिमिव जेअँ र्‌वार्‌वा क्युई रह्पा, तब ख्यु हालाईबो, रे अजोव येसुन ङ्याबो छ्युँ र्‌वानान ख्युकाङ्मोः क्युई रह्पा। <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />जेङ्नै ताःपान सिमी पत्रुस रे यूहन्नान ङ्याबो थाङ्थाङ् छ्युङ्पा रङरङ ख्युन बिरोधग ल्होई तये र्‌वा मतैबो। <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />अन्नकारन अजोवग यहूदीवन किम अदालतलै खोलोः वया र्‌वार्‌वा ख्युई राह्ङराङ्साः फोब्लि खेबो, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />“अन सिमिकाङ्मोः ता ङ्योअजै तै खेचे जेम? तैङर्‌वाङिन तेम्माई अजोवलम ताईलुवान धोनदी रह्पा ङ्याह् र्‌वानान यरूसलेमग छ्युङ्नान पुरूजै रङ्‌तपा ङ्याह्, रे ङि अन अस्वीकार खे मतैनान। <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />जेङ्नै अन ल्होई सिमिकाङ्मोः नफेलाःयो र्‌वार्‌वा ‘ह्‌याङ ङेन येसुन मिह्‌नग सिमि सुईनै ङ्याबो ल्होई तये नर्‌वा’ र्‌वार्‌वा ङ्योअजै अजोवग चेतावनी बिनत्वानान।”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />आलै अजोवग स्वा र्‌वार्‌वा “त्यान धेरा येसुन मिह्‌नग ल्होई नर्‌वा रे तये नलना” र्‌वार्‌वा ख्युई आदेस बिम्बो।<verse eid="ACT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19" />जेङ्नै पत्रुस रे यूहन्नाई ख्युकाङ्मोः झब बिम्बो, “परमेस्वरन ल्होई ङ्यान्चेन खेरे ङेनकोन ल्होई ङ्यान्चे परमेस्वरन ङू लः जेङ्पा कि नङ्पा ङेह्‌ः छोए ख्या। <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />तैङर्‌वाङिन ङ्योअजै रङ्पा रे ताह्पा ल्होईव ङ्योअग मर्‌वारे छ्युङ मतैनान।” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />ख्युई सजाय बिन्चे मेसो तये मर्हारे अजोवग हेँ ह्‌याल्म फ्याङफ्याङ फाप्पो, तैङर्‌वाङिन कन घतना घती रह्पा ङ्याह् अन्न पत सिमि पुरूवजै परमेस्वरन महिमा खेपाई ङ्याह्। <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />तैङर्‌वाङिन कन सिमि ताईलुवान धोनलम ताःफाम्पा ङ्याह्, नुन उमेर परा ङेथलन खेरे ह्‌याल्म ङ्याह्।<verse eid="ACT 4:22" /></para>
  <para style="s">बिस्वासीवन सोअताप</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />छुतकरा देद्दे पत्रुस रे यूहन्ना जेँन फुरीवन स्याह्‌ स्वाबो, रे ङोत्वा पुजारीव रे अगुवाजै र्‌वापा ल्होई पुरूव ख्युकाङ्मोः स्याप्पो। <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />जब बिस्वासीवजै अन ताह्बो, तब ख्युई ङ्याबो परमेस्वरक्याँ जेँन केह्ः छ्युछ्यु र्‌वाबो, “हे प्रभु, सुई पान्नाङ, पिर्थीबी, समुन्द्र रे मनग रह्पा तैस्याङ पुरू दोङ्बो, <note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false" /><char style="xt" closed="false">प्रस २०:११; नहे ९:६; भजन १४६:६</char></note> <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />सुई पबित्र आत्मालम जेँन सेवक ङिन खेपुल दाऊदन ङुरलै र्‌वाबो, ‘यहूदीन खोलोःन सिमिव तैङ सुतूबो, रे सिमिव भाछ्योवाग तैङ सदेन्त्र धोँ? <verse eid="ACT 4:25" /><verse number="26" style="v" sid="ACT 4:26" />परमप्रभुन बिरोधग रे नुन अभिसिक्त सिमिन बिरोधग पिर्थीबिन झलीव च्याङ्बो, रे हाकिमव ङ्याबो जोम्बो।’”<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">भजन २:१-२</ref></char></note><verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />तैङर्‌वाङिन तेम्माई ङेनजै अभिसेक खेपा, “ङेन पबित्र सेवक येसुन बिरोधग हेरोद रे पन्तियस पिलातस ङ्योरुम, यहूदीन खोलोःन सिमि रे इस्राएलीवन ङ्याबो अनै सहरग जोम्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="MAT 27:1-2">मत्ती २७:१-२</ref>; <ref loc="MRK 15:1">मर्क १५:१</ref>; <ref loc="LUK 23:1">लुक २३:१</ref>; <ref loc="LUK 7:11">७:११</ref>; <ref loc="JHN 18:28-29">यूह १८:२८-२९</ref>; <ref loc="ISA 61:1">यसै ६१:१</ref></char></note> <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />अनै खेचेन पत तै ङेन पाःपुङ्लम रे ङेन योजना अन्सार ङूलै ठहर्याई खेपा ङ्याह्। <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />ता हे प्रभु, ख्युन धम्की सेह्‌ना, रे नान राङ्पाकाङ्मोः यामयाम हिम्मत खेखे नान बचन र्‌वाफाना, <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />रे ताफान्चेन पत ङेनजै जेँन पाःपुङ क्याङ्तौ, जेँन पबित्र सेवक येसुन मिह्‌नलम ताईलुवान धोन रे हालाईचेन धोन रायो।”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />ख्युई सोअताप्मी ख्यु जोम्पू दार्बो, रे ख्यु पुरू पबित्र आत्माई नाङ्बो, रे ख्युई हिम्मत खेखे परमेस्वरन बचन र्‌वाबो।<verse eid="ACT 4:31" /></para>
  <para style="s">बिस्वासीवजै जेँन क्यु पीमा खेपा</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />बिस्वास खेनानवन मोङ पुरू सम ती रे ती आत्मान रह्पा ङ्याह्, रे ख्युन बर्ग तीजै जेँन क्युन तयाः अन ङन जेँन जेङ्पा र्‌वार्‌वा मर्‌वाङ, जेङ्नै ख्युन तैस्याङ पुरू पीमा ङ्याह्। <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />मन प्रेरितवजै यामयाम सक्ति ङ्याबो प्रभु येसु सिह्पालै सम्पु ग्युर्पान साँचि बिङ्‌ङ, रे ख्यु पुरून लाह्ः परमेस्वरन दया किम लुईपा ङ्याह्। <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />ख्युन बर्ग सुई र्‌वार्‌वा तैनै कोम्म मराँ, तैङर्‌वाङिन सुन ङ्याबो खेः रे यिम ङ्याह्, ख्युई मन र्‌युर्‌यु, ग्युर्पा चिजवन मोल सङ्‌ङ, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />रे प्रेरितवन स्याह् नाह्ङ्‌ङ, रे सुवा-सुवाः तयाः-तयाः त्वाङ, अन पुरूग परेङ।<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />ता साइप्रस देसन लेवी खान्दान्न योसेफ, सू प्रेरितवजै बरनाबास र्‌वार्‌वा मिह्‌न नाम्पा ङ्याह् (कन्न अर्थ जेङ्पा हौसला बिन्नान्न सिमि), <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />नुई जेँन खेः र्‌युप्पो रे अन सोह्ङ सस्सै प्रेरितवन चरनग नाह्‌म्बो।<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हननिया रे सफिरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />जेङ्नै हननिया मिह्‌न्न ती सिमि रे नुन मिसा सफिराई तयाः खेः र्‌युबो, <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />रे अन्न मोललम नुन मिसानै सल्‌लाग ङाई जेँन ङ्याबो नाह्‌म्बो, रे ङाई वव्वै प्रेरितवन चरनग नाह्‌म्बो। <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />जेङ्नै पत्रुसजै र्‌वाबो, “ए हननिया, पबित्र आत्मा ङ्याबो लबार र्‌वानान रे खेःन र्‌युप्पान मोललम ङाई जेँन ङ्याबो नान्चेन ल्होई सैतानजै कुजुई नान सम्म नाह्‌म्बो? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />मन मग्युर्नान्न बेर तै मन नान जेँनै मह्‌यायौ? रे मन ग्युर्मी यङ मन नानै आङग मह्‌या तै? झाःम धोन खेचेन नावा नान समग कुजुई स्वाबो? नाई सिमिकाङ्मोः ता नङ्पा, जेङ्नै परमेस्वरगै लबार र्‌वापा ङ्याह्।” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />अन ल्होई ताह्ताह् हननिया साः घ्याबो रे नुई परान पप्पो। अन ताह्‌नान पुरूव ङिह्‌म्बो। <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />तब छबावजै च्याङच्याङ नू घोलाङजै कप्पो रे खोलोः हुरहुर वप्पो, रे लुँह्‌म्बो। <verse eid="ACT 5:6" /><verse number="7" style="v" sid="ACT 5:7" />तै रातपा ङ्याह् अन क्युई मरारे क्वाईमाल्‌ला: घन्ता सुमन ङिक नुन मिसा रे झिङ स्वाबो। <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />पत्रुसजै नू लोप्पो, “ङाः र्‌वा, ङेनजै खेः अकेगै र्‌युप्पा जेङ्पौ?” आलै नुई र्‌वाबो, “अँ, अकेगै जेङ्पा।” <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />जेङ्नै पत्रुसजै नू र्‌वाबो, “ङेनजै प्रभुन आत्मान छोए सेह्‌म्म कुजुई दीदी सल्‌ला खेपा? सेह्‌ना, नान पसाः लुम्नानव झलागै ङ्याह् रे ख्युई ना हुरहुर खोलोः वन्नान ङ्याह्।” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />आलै तुरुन्तै अन नुन लेह्‌न रह्‌म्म दिम्बो रे परान पप्पो। जब छबाव झिङ स्वाबो, नू सितपा रङरङ खोलोः हुरहुर वप्पो, रे नुन पसान रह्‌म्मः लुँह्‌म्बो। <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />पुरू मन्दलिव रे अन ल्होई ताह्‌नान पुरू ङिनङिन लै आत्ति रह्पा।<verse eid="ACT 5:11" /></para>
  <para style="s">प्रेरितव लम ताईलुवान धोनव रे हालाईचेन धोनव रह्पा</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />ता प्रेरितवन ल्हालै लैः ताईलुवान धोनव रे हालाईचेन धोनव सिमिन घूँ थङ्‌ङ, रे बिस्वासी पुरू सोलोमन मिह्‌न्न नाह्पू ङ्याबो जोम्ङ। <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />जेङ्नै घङव बर्ग सुईनै ख्युन ङ्याबो धोमः स्वाचेन हिम्मत मरह्पा, जेङ्नै सिमिवजै ख्युकाङ्मोः सम्मान खेँ। <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />प्रभू बिस्वास खेनान चोलोङ्चा रे चिमिचाव ङ्योरुमन मोङ झन ह्‌याल्म पोह्‌न राम जाःबो, <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />सिथाल कि सिमिवजै लम-लमग खङ्नानकाङ्मोः सप्पो, रे पत्रुस स्वातौ नुन तिप्सो मात्र रानै ख्युन बर्ग कान-कान्न ङ्या थेबाःयो र्‌वार्‌वा ल्हौ रे खातवग ख्युकाङ्मोः आःफानफान नाह्ङ्‌ङ। <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />यरूसलेमन धेँवछोँन सहरलमै लै सिमिवजै खङ्नानव रे आत्मा बाःपाई तेपफाम्पाकाङ्मोः वव्वै स्वाङ रे मन पुरू ताःङ।<verse eid="ACT 5:16" /></para>
  <para style="s">प्रेरितकाङ्मोः तेपफाम्पा</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />प्रधान पुजारी रे नुन फुरीव पुरू, कन सदुकी पातीन ङ्याह् थादोवाई नाङ्नाङ् प्रेरितवन बिरोधग च्याङ्बो, <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />रे प्रेरितकाङ्मोः कूकू सरकारी झ्यालखानाः कह्बो। <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />जेङ्नै प्रभुन ती दुतजै छान्जे झ्यालखानान झलाव पोङ्बो, रे ख्युकाङ्मोः खोलोः सस्सै र्‌वाबो, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“वया रे आराधनालयग च्याङ्च्याङ अन सार्बा जिन्दगीन ल्हो‌न् पुरू सिमिकाङ्मोः स्यारा।” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />अन ताह्‌मी ख्यु नाप्पर्म आराधनालयन झिङ जाःजाः लह्‌म्मः जाःबो। जेङ्नै प्रधान पुजारी रे नुन फुरीवजै स्वाबो, आलै यहूदीन अदालत किम, आथबा इस्राएलीवन जोम्पा पुरून पुरू सिमिकाङ्मोः घ्वाबो, रे प्रेरितकाङ्मोः झ्यालखानालै सम्म सिमिव फेप्पो। <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />जेङ्नै अधिक्रितवजै झ्यालखानाः ताप्‌ताप्‌ सेन्तौ ख्युकाङ्मोः मदोतौ होलहोल स्वाबो। आलै अन ल्हो‌न स्याप्पो, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“ङ्योअजै झ्यालखानाः लः खेखे कोल्च्योवा फ्याङ्पा रे पालेव झलावग थाङ्थाङ् छ्युङ्पा रङ्पा, जेङ्नै झला पोङ्तौ ङ्योअजै झिङ सुई मदोपा।” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />अन ताह्ताह् आराधनालयन सिपाहीवन सेनापति रे ङोत्वा पुजारीव हालाईबो, ख्युई तै रह्पा ङ्याह् र्‌वार्‌वा नावाई खे मतैबो। <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />जेङ्नै कान तीपाई स्वास्वा ख्युकाङ्मोः र्‌वाबो, “सेह्‌ना, ङेनजै कन सिमिकाङ्मोः झ्यालखानाः नाम्पा ङ्याह् ख्यु आराधनालयग च्याङच्याङ सिमिकाङ्मोः लम्पाई ङ्याह्।” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />तब अफिसर र सिपाहीव वैवै प्रेरितकाङ्मोः हलजफत मखेरे सप्पो, तैङर्‌वाङिन सिमिवजै ख्युकाङ्मोः लुङजै फ्याङ्दरा र्‌वार्‌वा ख्यु ङिह्‌म्बो।<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />ख्युकाङ्मोः प्रेरितकाङ्मोः सस्सै यहूदीवन अदालत किमन ङू सोल्बो, रे प्रधान पुजारीजै ख्युकाङ्मोः लोप्पो, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“ङ्योअजै ङेनकाङ्मोः येसू मसिहन मिह्‌नग तये नलना र्‌वार्‌वा करा आग्या बिम्पा ङ्याह्, जेङ्नै ङेनजै जेँन छोएजै यरूसलेम पुरू काङ्तबो, रे मन सिमिन कहन दोस ङिन लाह्ः सस्सुम खेनौ।”<note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">मत्ती २७:२५</ref></char></note> <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />जेङ्नै पत्रुस रे घङ प्रेरितवजै र्‌वाबो, “ङ्योअजै सिमिवन नङ्पा जेङ्नै परमेस्वरन र्‌वापा ङ्यान्त्वानान। <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />ङिन खेपुलन परमेस्वरजै येसू सिह्पालै सम्पु दोङ्बो, सू ङेनजै क्रुसग किला थिङथिङ सप्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="DEU 21:22">कानुन २१:२२</ref>,<ref loc="DEU 21:23">२३</ref></char></note> <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />परमेस्वरजै इस्राएलन घ्योप्पान पत रे ख्युन तीपावन माफ बिम्म नू ताङ्बोन अगुवा रे मुक्तिदाता दोङ्दोङ् जेँन पाःपुङ याईपाई किम दोङ्बो।<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="LUK 24:47">लुक २४:४७</ref></char></note> <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />ङि अन ल्होई पुरून साँचि ङिह्पा, रे उजुईखेखे पबित्र आत्मा रे, सू परमेस्वरजै जेँन र्‌वापा ङ्यान्नानकाङ्मोः बिम्पा ङ्याह्।”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />जेङ्नै जब यहूदी जोम्पुन सदस्यवजै अन ताह्बो। तब ख्यु मिह्दा सुतुबो, रे ख्युकाङ्मोः सच्‌चे फाप्पो। <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />जेङ्नै कानुन लन्नान्न सिमि रे जनताग माननीय गमलिएल मिह्‌न्न फरिसीजै यहूदी जोम्पू च्याङच्याङ ख्युकाङ्मोः यिप्पुदीन भिह्तु खोलोः वैफाम्बो, <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />रे नुई यहूदीवन अदालत किमन सिमिकाङ्मोः र्‌वाबो, “इस्राएली हो, अन सिमिकाङ्मोः ङेनजै तै खेसुम खेपा ङ्याह्, अनग सापसाप छ्योवा। <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />तैङर्‌वाङिन त्यान खेरे ङू थुदास र्‌वानान्न सिमिदी जेँगै सिमि किम जेङ्पा र्‌वार्‌वा च्याङ्बो। जेङ्नै नू सह्प्पो रे नुन ङिक जाःनान्न क्याम लीतौ सिमि पुरूव खातत्त्या होई आलै नुन मिह्‌नै मोल्बो। <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />मन्न छाम्म सिमिन ताँका जेर्नान्न भेलाः यहूदा र्‌वानान गालीलन सिमि च्याङ्बो, रे हातिपा सिमिकाङ्मोः जेँनक्याँ परेःबो। अन रे सिबो, रे नु तेन्नानव खातत्त्या होई। <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />चोँन अन भारेः ङा ङेनकाङ्मोः र्‌वाचे, कि अजोव सिमिवलम भाभा छ्योवा, रे अजोवग ख्योवा, तैङर्‌वाङिन अजोवन अन योजना आथबा अन धोन सिमिवलम राङिन नुँह् सिह्‌नान ङ्याह्। <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />जेङ्नै यदि अन परमेस्वरलम जेङ्‌ङिनता ङेनजै अनग काःमतैनान। तेमन्ता ङेन परमेस्वरन बिरोध च्याङ्पा ठहरी राह्‌नान ङ्याह्।” <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />तब ख्युई नुन सल्‌ला ङ्याम्बो। आलै ख्युई प्रेरितकाङ्मोः झिङ घ्वाघ्वा फ्याङ्बो, रे “येसुन मिह्‌नग ल्होई नर्‌वा” र्‌वार्‌वा ख्युकाङ्मोः ख्योवाबो। <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />तब येसुन मिह्‌नग अपमान कूचेन सम स्योरस्योरलैम ठहरी रह्पा र्‌वानान्न ल्होईग स्याङैस्याङै प्रेरितव यहूदी जोम्पुन ङूलै गेग्गे होई। <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />आलै एकुरो ख्युई आराधनालयग रे यिम-यिम वैवै येसू र्‌वार्‌वा मसिह जेङ्पा र्‌वार्‌वा लह्‌म्मः रे ताह्फेम्मः मख्योवाबो।<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">फुरी खेनान ङेह्पाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />मन दिनग जब चेलावन ताँका छारै वैपा ङ्याह्, तब हिब्रुवन बिरोधग ग्रीक-यहूदीवजै गनगन खेबो, तैङर्‌वाङिन बात्तैन साह्ई बिन्तौ ख्युन लम्मावजै त्वानान्न साह्ई मदेङ्‌ङ। <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />तब प्रेरित च्योङेपावजै चेलावन मोङग स्वा र्‌वार्‌वा र्‌वाबो, “परमेस्वरन बचन ताह्फेम्मः ख्योवाख्योवा झाफान्नान-थुङ्फान्नान्न सेवा खेचे ङी लः मराह्‌नान। <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />अन्नकारन जिङ्‌कोव हो, ङेनकोन बर्गलै पबित्र आत्मा, बुद्धिजै नाङ्पा रे पुरून आदर देप्पान सिमि नेपा फा सू ङी अन धोनग दम्मता। <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />जेङ्नै ङ्योअ ता सोअताप रे भेला पुरू बचन ताह्फेच्‌चेन धोन खेपाई छ्युङ्नान ङ्युँ।”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />अन ल्होई मोङन पुरूग सम थाबो रे जोम्पा पुरूग ल छुबो, रे ख्युई पबित्र आत्मा रे बिस्वासजै नाङ्पा स्तिफनस, फिलिप, प्रखरस, निकनोर, तीमोन, पर्मिनास रे एन्तिओखियान यहूदीन ल्हूलाम ङ्यान्नान निकोलाउसग दम्बो। <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />ख्युई अन सिमिकाङ्मोः प्रेरितवन ङू सप्पो। प्रेरितवजै सोअताप्पो रे अजोवन लाह्ः जेँन लाह् नाह्‌म्बो।<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />परमेस्वरन बचन छारै होई, रे चेलावन ताँका यरूसलेमग मिह्दा पोह्‌न रह्पा। पुजारीव बर्ग लैजे अन बिस्वासग स्वीकार खेबो।<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनसग जुङ्पा</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफनसजै परमेस्वरन दया रे सक्तिजै नाङनाङ सिमिवन घूँ किम-किम ताईलुवान धोन रे हालाईचेन धोनव खेबो। <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />जेङ्नै हातिपा सिमिव चन नुन बिरोध खेमः जाःबो। ख्यु यहूदीवन आराधनालयन “स्वतन्त्र” र्‌वानान पातिन सिमिव आलै अलेक्जेन्द्रिया सहर रे कुरेनी, किलिकिया रे एसिया छेत्रलम स्वापान यहूदीव ङ्याह्। ख्यु पुरु दीदी स्तिफनस ङ्याबो खाथू खेमः जाःबो। <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />नु कन बुद्धिजै रे आत्मा लम ल्होई र्‌वाङ, ख्युई नुन सामना खे मतैबो। <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />तब ख्युई फाक सिमिकाङ्मोः घुस बिमबिम झाम र्‌वा फाम्बो, “मोसा रे परमेस्वरन बिरोधग अनजै ल्हुई झपा ङी ताह्पा।” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />तब ख्युई सिमिव, अगुवा रे कानुन लन्नान्न सिमिकाङ्मोः उल्बाङ खेबो, रे ख्युकाङ्मोः फ्याङ्बो रे जुङ्जुङ् यहूदी जोम्पू सप्पो। <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />ख्युई झाम र्‌वानान्न लबारन साँचिव ङू साःबो, “अन सिमिजै पबित्र ठाउँ रे कानुन्न बिरोधग ल्होईव र्‌वाचे मख्योवानान।<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JER 26:11">यर २६:११</ref></char></note> <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />तैङर्‌वाङिन अनजै झाम र्‌वापा ङ्योअजै ताह्पा, ‘नासरतन येसुई अन ठाउँग मीपा दोङ्नान ङ्याह्, रे मोसाई ङ्योअग बिम्पा ल्हूलाम यङ फिन्नान ङ्याह्’।” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />यहूदी जोम्पू छ्युङ्पा मन पुरूजै स्तिफनस ती खेखे सेम्बो, रे नुन नमी स्वर्गदुतन नमीलैम रङ्बो।<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्तिफनसन भासन</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />तब प्रधान पुजारीजै लोप्पो, “तै अन ल्होई तेम्मा जेङ्पौ?” <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />नुई र्‌वाबो, थिक्‌कोव रे पा हो, ङ्याना। महिमान परमेस्वरजै ङिन खेः अब्राहामग नु हारानग छ्युङ्चेन खेरे ङू मेसोपोतामियाग रातौ दर्सन बिम्पा ङ्याह्,<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="GEN 12:1">उत १२:१</ref></char></note> <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />नू र्‌वाबो, “ना जेँन देस रे जेँन सन्तानलम गेग्गे, कन देस ङा नाः थन्नान, स्या वया।”<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1">उत १२:१</ref></char></note> <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />तब नु कन्दीवन देसलम गेग्गे हारानग स्वास्वा छ्युङ्बो, रे नुन पा सिमी परमेस्वरजै नू स्याह्‌लै अन ठाउँग साःबो, खाः चोँ ङेन छ्युङ्नान।<note caller="-" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">उत ११:३१</ref>; <ref loc="GEN 12:5">१२:५</ref></char></note> <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />आलै परमेस्वरजै नू क्यु तये मबिम्बो, जेङ्नै मनग लेह् नाम्पु यङ मबिम्बो। जेङ्नै मन्तौ नुन सन्तान सुई मया ह्‌याङ रेनरुबो कि, “ङा अन देस, नान सन्तान लाग बिन्चे।”<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 13:15">उत १३:१५</ref>; <ref loc="GEN 15:18">१५:१८</ref>; <ref loc="GEN 16:1">१६:१</ref>; <ref loc="GEN 24:7">२४:७</ref>; <ref loc="DEU 2:5">कानुन २:५</ref>; <ref loc="DEU 11:5">११:५</ref></char></note> <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />परमेस्वरजै झामखेखे र्‌वाबो, “नान सन्तान क्याम लि परा थाल सिमिन देसग वैवै छ्युङ्नान ङ्याह्, रे नान सन्तानजै ख्युकाङ्मोः राङ्पा दोङदोङ जेँन अधिनग नान्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">उत १५:१३-१४</ref>; <ref loc="EXO 2:22">प्रस २:२२</ref></char></note> <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />परमेस्वरजै र्‌वाबो “जेङ्नै ख्यु कन जातिन राङ्पा राह्‌राह्‌ छ्युङ्नान ङ्याह् मन जातिन न्याय ङा खेनान ङ्युँ। आलै ख्यु गेग्गे स्वास्वा अनै ठाउँग ङन आराधना खेनान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="GEN 15:14">उत १५:१४</ref>; <ref loc="EXO 3:12">प्रस ३:१२</ref></char></note> <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />परमेस्वरजै नुन ङ्याबो खतनान पत रेनरुबो, रे अब्राहाम इसहाकन पा राह्‌राह्‌ केर्याग इसहाकन खतना खेबो। इसहाक याकूबन पा रह्पा, रे याकूब पत्ति च्योङेपानै पा रह्पा।<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-11">उत १७:१०-११</ref>; <ref loc="GEN 21:4">२१:४</ref></char></note><verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“याकूबन ङोह्जोवजै भाइ योसेफग थादोवा खेखे नू मिस्रदेसग र्‌युप्पो। जेङ्नै परमेस्वर नुन ङ्याबो ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">उत ३७:११</ref>; <ref loc="GEN 37:28">३७:२८</ref>; <ref loc="GEN 39:2-3">३९:२-३</ref>; <ref loc="GEN 45:4">४५:४</ref></char></note> <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />परमेस्वरजै नुन तूरि पुरूलम फाफा मिस्रदेसन झली फारोन ङू नू दया खेबो, रे बुद्धि बिम्बो, आलै फारोई नू मिस्रदेस रे नुन यिम पुरून हाकिम दोङ्बो।”<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 39:21">उत ३९:२१</ref>; <ref loc="GEN 41:40">४१:४०</ref>; <ref loc="GEN 41:43">४१:४३</ref>; <ref loc="GEN 41:46">४१:४६</ref>; <ref loc="PSA 105:21">भजन १०५:२१</ref></char></note><verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />आलै मिस्रदेस पुरू रे कनानग अनिकाल राह्‌राह्‌ मिह्दा तूरि रह्पा, रे ङिन खेपुलवजै साई मदेप्पो।<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 41:54-55">उत ४१:५४-५५</ref>; <ref loc="GEN 42:5">४२:५</ref></char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />जेङ्नै याकूबजै मिस्रदेसग साह्ई ङ्याह् र्‌वानान ल्होई ताह्ताह् ङिन खेपुलकाङ्मोः पहिली स्या फेप्पो। <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />ङेरेप दोदो योसेफजे नुन थिक्‌कोवकाङ्मोः जेँन परिचय बिम्बो, रे योसेफन पयार रे फारोन ङ्याबो स्वाबो। <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />योसेफजे जेँन पा याकूबग रे जेँन क्यालाकिप्पा पुरूग, सु फेराङलिथल रै ङापा ङ्याह्, नुन ङ्याबो घ्वाम फेप्पो।<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-11">उत ४५:९-११</ref>; <ref loc="GEN 45:18-19">४५:१८-१९</ref>; <ref loc="EXO 1:5">प्रस १:५</ref>; <ref loc="DEU 10:22">कानुन १०:२२</ref></char></note> <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />याकूब मिस्रदेसग होई, रे नु स्याह्ई सिबो, रे स्या ङिन खेपुलव यङ सिबो।<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 45:6-7">उत ४५:६-७</ref>; <ref loc="GEN 49:33">४९:३३</ref>; <ref loc="EXO 1:6">प्रस १:६</ref></char></note> <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />आलै ख्युन कुँह्‌म सकेमग वप्पो, रे सकेमग अब्राहामजै हमोरन ङोह्जोवलम मुलन सोङ बिमबिम र्‌युपान तुर्साः नाह्‌म्बो।<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 23:16-17">उत २३:१६-१७</ref>; <ref loc="GEN 33:19">३३:१९</ref>; <ref loc="GEN 49:30">४९:३०</ref>; <ref loc="GEN 50:13">५०:१३</ref>; <ref loc="JOS 24:32">यहो २४:३२</ref></char></note> <verse eid="ACT 7:16" /><verse number="17" style="v" sid="ACT 7:17" />“जेङ्नै जब परमेस्वरजै अब्राहाम ङ्याबो रेनरुपा पुरा राचेन भेला ङेमः स्वाबो तब मिस्रदेसग मन सिमिव पोह्‌न राम जाःबो, रे ख्युन ताँका ह्‌याल्म रह्पा।”<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">प्रस १:७-८</ref></char></note><verse eid="ACT 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 7:18" />तब मिस्रदेसग योसेफग मस्योनान घङ झली च्याङ्बो। <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />नुई ङ्योअन सिमिन ङ्याबो अलः खेबो, रे ङिन खेपुलकाङ्मोः नुन वैचाव खोलोः सस्सै नाम फाम्म धिपी खेँ, रे झामखेखे घोमाः केह्पा वैचा पुरूव सीँ।<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="DEU 1:9-10">कानुन १:९-१०</ref>; <ref loc="DEU 1:18">१:१८</ref>; <ref loc="DEU 1:22">१:२२</ref></char></note> <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />अन्नै भेला मोसा केह्बो। नु परमेस्वरन ङू ल ङ्याह्। नु ला सुमङीथाल जेँन पान यिम झाबो।<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="DEU 2:2">कानुन २:२</ref></char></note> <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />नु खोलोः पह्‌म्मी फारोन चमेःजै नू सोलसोल वप्पो, रे जेँनै ङोह्जो दोङदोङ झाबो।<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="DEU 2:5">कानुन २:५</ref>; <ref loc="DEU 2:10">२:१०</ref></char></note> <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />मोसाः मिस्रीवन छोए पुरूग लम्बो, रे मोसा जेँन बचन रे धोनग सक्तिसाली रह्पा। <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />जब नु ङेथल परान रह्पा, तब जेँन इस्राएली थिक्‌कोवकाङ्मोः दोसुम नुन सम्म स्वाबो।<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="EXO 2:11">प्रस २:११</ref></char></note> <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />जेँन थिक्‌कोवन बर्ग तीपान लाह्ः अन्याय रह्पा रङरङ, मोसाई नू सेम्बो, रे मन अन्याय खेनान मिस्री सस्सै जेँन भाइन लाह्ः रह्पा अत्याचारन खूँ नाम्बो।<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="EXO 2:12">प्रस २:१२</ref></char></note> <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />परमेस्वरजै ङन ल्हालै ख्युकाङ्मोः बचाई खेनान र्‌वानान्न ल्होई ङन थिक्‌कोवजै हाकोदरा र्‌वानान नुई नावा खेपा ङ्याह्। जेङ्नै ख्युई अन हामकोबो। <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />नाप्चे इस्राएलीव यङ राह्ङराङ्साः याल खेपाई छ्युङ्पान भेलाः नु स्वाबो, रे झाःम र्‌वार्‌वा ख्युकाङ्मोः दीफान्चेन भिह्तु सम्झाई खेबो, हे चोलोङ्चाव, “ङेन ता थिक्‌कोव जेङ्पा, तीजै घङ्‌ग तैङ अन्याय खेनान?” <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />जेङ्नै जेँन खिम्जेन ङ्या अन्याय खेनानजै नू झाःम र्‌वार्‌वा फुल्चि खेबो, “ङिन ङ्या हाकिम रे न्यायकर्ता राम नाः सुई दम्बो? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />थ्याँ मन मिस्री सह्प्पा लैम ना ङाः र्‌वार्‌वा सस्सुम खेनौ?”<note caller="-" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="EXO 2:13-14">प्रस २:१३-१४</ref></char></note> <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />झाम झब ताह्ताह् मोसा ज्यारज्यार मिद्‌यान देसग वैवै परदेसी रह्पा। स्या नुन ङोह्जो ङे केह्बो।<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 2:15-22">प्रस २:१५-२२</ref>; <ref loc="EXO 18:3-4">प्रस १८:३-४</ref></char></note><verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“ङेथल परा वैमी सीनै धुरन तये मीपान ठाउँग छ्याप्पाई छ्युङ्पा पोथ्रान मेह्ग ती स्वर्गदुत नुन रह्‌म्म रङ्बो। <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />जब मोसाई अन रङ्बो तब नु हालाईबो, रे अन सेम्म ङेह्‌मः वैतौ परमप्रभुन झाम केह्ः ङ्याम्बो, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘ङा नान खेपुलवन परमेस्वर जेङ्पा, अब्राहाम, इसहाक रे याकूबन परमेस्वर।’ मोसा दार्मः जाःबो, रे नुई स्याह्‌क्याँ सेन्चे यङ हिम्मत मखेबो।”<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />“तब परमप्रभुई नू र्‌वाबो, ‘नान लेह्‌न पौला फोला, तैङर्‌वाङिन कन ठाउँग ना च्याङ्पा ङ्याह्, अन पबित्र थाउँ जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">7:33 </char><char style="xt" closed="false"><ref loc="EXO 3:5">प्रस ३:५</ref></char></note> <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मिस्रग ङिह्पान ङन सिमिवन तूरि ङै रङ्पा, रे ख्युन समतूतू दापा यङ रङ्पा। ख्युकाङ्मोः अन तूरिलम फाम ङा लिपलिप स्वापा ङिह्पा। ता स्वा, ङा नाः मिस्रदेसग फेन्नान ङ्युँ।’”<note caller="-" style="x"><char style="xo" closed="false">7:34 </char><char style="xt" closed="false"><ref loc="EXO 2:24">प्रस २:२४</ref>; <ref loc="EXO 3:7-10">प्रस ३:७-१०</ref></char></note><verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“कन मोसाः ख्युई झाःम र्‌वार्‌वा अस्वीकार खेपा ङ्याह्, ‘सुई नाः ङिन ङ्या हाकिम रे न्यायधीस दोङ्बो’ नू परमेस्वरजै सासक रे उद्धारकर्ता दोङदोङ मन स्वर्गदुतलम सुई नू पोथ्राग दर्सन बिम्पा ङ्याह्, फेप्पो।<note caller="-" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="EXO 2:14">प्रस २:१४</ref>; <ref loc="EXO 3:2">प्रस ३:२</ref></char></note> <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />अनै सिमिजै मिस्रदेसग, लाल समुन्द्रग रे ङेथल पराभरी सुनसान ठाउँग ताईलुवान धोन रे हालाईचेन धोनव खेखे ख्युकाङ्मोः खोलोः सप्पो।<note caller="-" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="DEU 7:3">कानुन ७:३</ref>; <ref loc="DEU 18:15-18">१८:१५-१८</ref></char></note> <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />मन नुई मोसा जेङ्पा, सुई इस्राएलीकाङ्मोः र्‌वापा ङ्याह्, ‘परमेस्वरजै ङा सोल्पालैम ङेन थिक्‌कोवन बर्गलम ङेन पत तीपा भबिस्यबक्ता सोल्नान ङ्याह्।’<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">कानुन १८:१५-१८</ref> </char></note> <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />अन नुई मोसा जेङ्पा, सु सुनसान ठाउँग रह्पा समुदायग मन स्वर्गदुत ङ्याबो ङ्याह्, कन स्वर्गदुतजै सीनै धुरग रे ङिन खेपुलवन ङ्याबो ल्होई र्‌वापा ङ्याह्, रे नुई र्‌वार्‌वा ङी बिन्चेन भिह्तु सम्पु बचनव देप्पा ङ्याह्,”<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1">प्रस १९:१</ref>; <ref loc="EXO 20:17">२०:१७</ref>; <ref loc="DEU 5:1-33">कानुन ५:१-३३</ref> </char></note><verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“जेङ्नै ङिन खेपुलवजै नुन र्‌वापा मङ्याम्बो। ख्युई नू ख्योवाख्योवा मिस्रदेसगै होलसुम खेबो।<note caller="-" style="x"><char style="xo" closed="false">7:39 </char><char style="xt" closed="false"><ref loc="EXO 23:20-21">प्रस २३:२०-२१</ref>; <ref loc="NUM 14:3-4">गन्ती १४:३-४</ref></char></note> <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />ख्युई हारूनग झाःम र्‌वाबो, ‘ङिन ङूह्ङूह् वैनान कान लाव ङिन पत धोँवा, तैङर्‌वाङिन ङ्योअग मिस्रदेसलै छ्युछ्यु सन्नान अन मोसाः तयाः रह्पा ङी क्युई मीपा।’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />मन्तौ ख्युई मिप्चादीन कु दोङ्बो, रे मनग भोका यङ फुल्बो, रे जेँन ल्हान धोनग स्याङ्बो।<note caller="-" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:4-6">प्रस ३२:४-६</ref></char></note> <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />मन्नकारन परमेस्वरजै ख्युकाङ्मोः ख्योवाबो, रे ख्युकाङ्मोः पान्नाङन घरवन आराधना खेमः ख्योवाबो, कताःम भबिस्यबक्तावन किताबग सर्पा ङ्याह्, इस्राएलन सिमि हो, तै ङेनकोजै ङेथल परान बेर सुनसान ठाउँग ङाः भोका रे भेतीव फुल्बो मन ता ङन भिह्तु मह्‌या।”<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="JER 7:18">यर ७:१८</ref>; <ref loc="JER 8:2">८:२</ref>; <ref loc="JER 19:13">१९:१३</ref></char></note><verse eid="ACT 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 7:43" />ङेनजै मोलोकन पाल रे ला रेफन्न घर, रे ङेनजै आराधना खेमः दोङ्पा कुव सोलसोल वप्पा। ता ङा ङेनकाङ्मोः बेबिलोनलै धेँ दान्नान ङ्युँ।<note caller="-" style="x"><char style="xo" closed="false">7:43 </char><char style="xt" closed="false"><ref loc="AMO 5:25-26">आमो ५:२५-२६</ref></char></note><verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />सुनसान ठाउँग ङिन खेपुलवन साँचिन पाल ङ्याह्। मोसाई रङ्पा मीलुपलैम परमेस्वरन आदेस अन्सार अन रह्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:1-40">प्रस २५:१-४०</ref>; <ref loc="EXO 27:21">२७:२१</ref>; <ref loc="NUM 1:50">गन्ती १:५०</ref></char></note> <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />परमेस्वरजै अन देसग छ्युङ्नान्न यहूदीन खोलोःन सिमिकाङ्मोः ताल्बो रे यहोसुजै अन देस क्यालक्याल वत्तौ ख्युई मन पबित्र पाल अन देसग सप्पो। मन्न छाम्म झली दाऊदन पालिन बेर मन पबित्र पाल ख्युन ङ्याबोई लुईबो।<note caller="-" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">यहो ३:१४-१७</ref>; <ref loc="JOS 18:1">१८:१</ref>; <ref loc="JOS 23:9">२३:९</ref>; <ref loc="JOS 24:18">२४:१८</ref></char></note> <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />नुई परमेस्वरन दया देप्पो, रे याकूबन परमेस्वरन भिह्तु छ्युङ्पुदी दोङ्चेन आदेस तोल्बो।<note caller="-" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:2-16">२ सामू ७:२-१६</ref>; <ref loc="1KI 8:17-18">१ झली ८:१७-१८</ref>; <ref loc="1CH 17:1-14">१ इति १७:१-१४</ref>; <ref loc="2CH 6:7-8">२ इति ६:७-८</ref>; <ref loc="PSA 132:5">भजन १३२:५</ref></char></note> <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />जेङ्नै नुन पत यिम चन सोलोमनजै दोङ्बो।<note caller="-" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-2">१ झली ६:१-२</ref>; <ref loc="1KI 6:14">६:१४</ref>; <ref loc="1KI 8:19-20">८:१९-२०</ref>; <ref loc="2CH 3:1">२ इति ३:१</ref>; <ref loc="2CH 5:1">५:१</ref>; <ref loc="2CH 6:2">६:२</ref>; <ref loc="2CH 6:10">६:१०</ref></char></note> <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />“जेङ्नै लाह्जै दोङ्पा यिमवग पुरून खेरे किम परमेस्वर मछ्युङ्नान, झाम भबिस्यबक्ताजै र्‌वापा ङ्याह्, <verse eid="ACT 7:48" /><verse number="49" style="v" sid="ACT 7:49" />‘ङन सिङ्‌हासन स्वर्ग जेङ्पा, रे पिर्थीबी ङन ल्हे नाम्पु जेङ्पा, ङेनजै ङन पत कत्यामन यिम दोङ्चे? परमप्रभु र्‌वाङ, ङन नाह्‌न कन जेङ्पा?’”<verse eid="ACT 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="ACT 7:50" />तै अन तैस्याङ पुरू ङनै लाह्जै दोङ्पा नङ्पा तै?<note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">यसै ६६:१-२</ref></char></note> <verse eid="ACT 7:50" /><verse number="51" style="v" sid="ACT 7:51" />स्तीफनसजै र्‌वाबो, “हे राह्ङद्‌या सिमिव हो, सम क्योङ्म रे नाम्ज्योवा काना रह्पा हो, ङेन एकुरो पबित्र आत्मान बिरोध खेनान। ङेन खेपुलजै कत्याम खेबो ङेन रे झाम खेनान।<note caller="-" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="EXO 32:9">प्रस ३२:९</ref>; <ref loc="LEV 26:41">लेवी २६:४१</ref>; <ref loc="NUM 27:14">गन्ती २७:१४</ref>; <ref loc="ISA 63:10">यसै ६३:१०</ref>; <ref loc="JER 9:26">यर ९:२६</ref></char></note> <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />भबिस्यबक्ताव बर्ग कनग ङेन खेपुलजै तेपमफाम्बो? ख्युई धर्मी सिमि स्वानान र्‌वार्‌वा ङूलै र्‌वानानव पुरूग सह्प्पो, नू ङेनजै बिस्वासघात खेबो, रे नू सह्प्पो। मन पुरूग सह्प्पो, सुई मन तेम्मा सिमिन स्वानान्न लोन ङूलै स्याप्पा ङ्याह्। ता ङेन चन नुनै बिस्वासघाति रे सिमि सन्नान रह्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">7:52 </char><char style="xt" closed="false"><ref loc="2CH 36:16">२ इति ३६:१६</ref></char></note> <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />स्वर्गदुतवजै बिम्पा कानुन ङेनजै देप्पो, जेङ्नै मन मङ्याम्बो।”<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनसग लुङजे फ्याङफ्याङ सप्पा</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />जब यहूदी जोम्पुन सदस्यवजै अन ल्होई ताह्बो तब ख्यु सुतुबो रे सुतुतु सो चम्म जाःबो।<note caller="-" style="x"><char style="xo" closed="false">7:54 </char><char style="xt" closed="false"><ref loc="JOB 16:9">अयू १६:९</ref>; <ref loc="PSA 35:16">भजन ३५:१६</ref>; <ref loc="PSA 37:12">३७:१२</ref>; <ref loc="PSA 112:10">११२:१०</ref></char></note> <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />जेङ्नै स्तिफनजै चन पबित्र आत्माई नाङनाङ स्वर्गक्याँ ती सेम्बो, रे परमेस्वरन महिमा रे येसू परमेस्वरन याईपाक्याँ थाङथाङ छ्युङ्पा रङबो। <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />नुई र्‌वाबो, “सेह्‌ना, स्वर्ग पोङ्पा ङा रँ, रे सिमिन ङोह्जोः परमेस्वरन याईपाक्याँ थाङथाङ छ्युङ्पा ङा रँ।”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />जेङ्नै ख्यु केह्ः किमै फाईरा खेखे च्याङ्बो, रे जे-जेँन नाम्ज्योवा काःबो, रे ख्यु ङ्याबो फ्याङ्मः स्वाबो। <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />ख्युई नू सहरन खोलोः छ्यूछ्यू वप्पो, रे नू लुङजै फ्याङ्बो। रे साँचि छ्युङ्पान सिमिवजै जेँन घोलाङव साऊल मिह्‌न्न तीपा छबान लेह्‌न रह्‌म्म छ्युछ्यु नाह्‌म्बो। <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />कुजुई ख्युई स्तिफनसग लुङजै फ्याङ्पा ङ्याह्, नुई सोअताप्पो, “हे प्रभु येसु, ङन आत्माः स्वीकारी ख्या।”<note caller="-" style="x"><char style="xo" closed="false">7:59 </char><char style="xt" closed="false"><ref loc="PSA 31:5">भजन ३१:५</ref></char></note> <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />नुई पोह् जूजू केह्ः किमै पुकार खेबो, “हे प्रभु, अन तीपान दोस अजोवग नताह्ःयो।” अकेः र्‌वार्‌वा नुई परान पप्पो।<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">साऊल मन्दली तेपफाङ्‌ङ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />नू सत्तौ साऊल रे दीपा ङ्याह्। मन्नै लाह्ः यरूसलेमग रह्पा मन्दलिन बिरोधग दुङाल किम सुरु रह्पा, रे प्रेरितव नङ्म ख्यु पुरू यहूदिया रे सामरियान देसग खातत्त्या होई। <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />भक्त सिमिवजै स्तिफनसग वव्वै लुँह्‌म्बो, रे नुन पत लै समतु खेबो। <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />जेङ्नै साऊलजै मन्दली नोङ फाम्पा ङ्याह्। आलै नुई यिम-यिम जाःजाः चोलोङ्चा रे चिमिचाकाङ्मोः पुरीपुरी वव्वै झ्यालखानाः काँ।<verse eid="ACT 8:3" /></para>
  <para style="s">सामरियाग फिलिप</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />तब मन खातत्त्याग रह्पावजै लिब्रुङ्क्याँ वैवै बचन ताह्फेप्पो। <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />आलै फिलिप चन सामरियान ती सहरग वैवै ख्युकाङ्मोः मसिहन ल्होन् लः ताह्फेप्पो। <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />फिलिपजै र्‌वापा बचन ताह्ताह् आलै नुई खेपा हालाईचेन धोनव रङरङ, मोह्ङजै ती सम राह्‌राह्‌ नुन ल्होईग ध्यान बिम्बो। <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />तैङर्‌वाङिन लै सिमिवलम मुव केह्ः किमै फाईरा खेखे गेङ्ङ जाःबो, रे लै ल्हो मगुल्नान्न नाप्पुवाव रे लुल्याव रे ताःफाम्बो। <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />झामखेखे मन सहरग मिह्दा किम्म रह्पा।<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />स्या सिमोन मिह्‌न्न ती सिमि ङ्याह्। नुई ङूलै मन सहरग जादु खेखे सामरियान सिमिकाङ्मोः ताईलुवा दोङ्पा ङ्याह्, रे जेँग ङह्‌ किम जेङ्पा र्‌वार्‌वा छूँ। <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />मन सिमी छ्युमलै किमथाल पुरूजै झाःम र्‌वार्‌वा ङ्याङ्‌ङ, “अन सिमि परमेस्वरन अन सक्ति जेङ्पा, कनग मकेकुकेन किम सक्ति र्‌वानान।” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />ख्युई नू मानि खेँ, तैङर्‌वाङिन भेला लैःलै नुई जेँन जादु खेखे सिमिकाङ्मोः ताईलुवा दोङ्पा ङ्याह्। <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />जेङ्नै जब ख्युई परमेस्वरन राज्य रे येसू मसिहन मिह्‌न्न ल्होन् लः स्यान्नान फिलिपन ल्होईग बिस्वास खेबो, तब चोलोङ्चा रे चिमिचावजै बप्‌तिस्मा वप्पो। <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />सिमोन जेँजै बिस्वास खेबो। नुई बप्‌तिस्मा वप्पो, रे अन फिलिपन ङ्याबो सङ खेखेई लुईबो, रे हालाईचेन धोनव, ताईलुवान धोन खेपा रङरङ नू हालाईबो।<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />सामरियान सिमिवजै परमेस्वरन बचन स्वीकारी खेबो र्‌वानान ताह्ताह् यरूसलेमग रह्पा प्रेरितवजै पत्रुस रे यूहन्नाः ख्युन ङ्याबो फेप्पो। <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />ख्यु स्या स्वास्वा ख्युई पबित्र आत्मा धेराःयो र्‌वार्‌वा सार्बा बिस्वासीवन भिह्तु सोअतापप्पो। <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />तैङर्‌वाङिन मन्न बेर ख्युन बर्ग सुन लाह्ः यङ नु स्वापा मया। ख्युन बप्‌तिस्मा प्रभु येसुन मिह्‌नग रह्पा ङ्याह्। <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />तब पत्रुस रे यूहन्ना जेँन लाह् ख्युन लाह्ः नाह्‌म्बो, रे ख्युई पबित्र आत्मा देप्पो। <verse eid="ACT 8:17" /><verse number="18" style="v" sid="ACT 8:18" />ता प्रेरितवजै लाह् नाह्ङ्‌ङिन पबित्र आत्मा देन्नान जेअँ र्‌वानान रङरङ सिमोनजै झाम र्‌वायङ ख्युकाङ्मोः सोह्ङ बिम्म सप्पो, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“ङाः र्‌वार्‌वा अन सक्ति क, रे ङै सुस्याङ्न ल्हाः ल्हा नाम्मी नुई पबित्र आत्मा धेरायो।”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />जेङ्नै पत्रुसजै र्‌वाबो, “नान सोह्ङ नानै ङ्याबो मीपा रायो, तैङर्‌वाङिन परमेस्वरन बर सोह्ङजै र्‌युह् तैनान र्‌वार्‌वा नाई सोच खेबो। <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />नाई अन धोन खेचे मदेन्नान। नान अनग न काला ङ्याह् न ता आङ तैङर्‌वाङिन परमेस्वरन ङू नान सम लः नँह्।<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="PSA 78:37">भजन ७८:३७</ref></char></note> <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />अन्नकारन नान जेँन अन अलःन पत घ्योप्पा ख्या आलै प्रभू सोअताप फुला, रे हालम नान समन झाम सोच माफ र्‌हदरा। <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />तैङर्‌वाङिन ङा रँ, ना खाःपाई नाङ्पा ङ्याह्, आलै तीपान बन्धनग ङ्याह्।”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />तब सिमोनजै र्‌वाबो, “ङेनजै ङन पत प्रभू सोअताप ख्याःयो, रे ङेनजै र्‌वापा ल्होई तै यङ ङन लाह्ः नताह्ःयो।” <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />आलै ख्युई बयान बिनतामी रे प्रभुन बचन र्‌वातामी सामरीवन लै नामग ल्होन् लः ताह्फेरैफेरै ख्यु यरूसलेम होल्बो।<verse eid="ACT 8:25" /></para>
  <para style="s">फिलिप रे इथियोपियान अधिकृत</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />आलै प्रभुन ती दुतजै फिलिपग र्‌वाबो, “च्याङच्याङ ज्याङक्याँ यरूसलेमलै गाजाक्याँ वैनान लम्म वया। स्या मरुभुमीन लम ङ्याह्।” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />आलै फिलिप च्याङच्याङ होई, रे ती इथीयोपियाली छक्‌काः धोबो, सु इथियोपिया देसन मकेकुकेन किम झलीमा कन्दाकीन अधिकृत रे क्यु पुरून कोसाध्यछे ङ्याह्। नु यरूसलेमग आराधना खेमः वैपा ङ्याह्। <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />नु होल्चे खेपाई ङ्याह्, रे जेँन तान रथग छ्युङछ्युङ यसैया भबिस्यबक्तान किताबग तोअपाई ङ्याह्। <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />तब पबित्र आत्माई फिलिपग र्‌वाबो, “वया रे मन रथन ङ्याबो जा।” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फिलिप नुन रह्‌म्म धालैधालै होई, रे नू यसैया भबिस्यबक्तान किताब तोअपा ताह्ताह् नुई लोप्पो, “नाई तोअपा ल्होई हाकोनौ?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />तब नुई र्‌वाबो, “सुई मर्‌वारे ङा कुजुई हाकोतैनान?” आलै नुई फिलिपग ता चपचप नुन ङ्याबो छ्योवा र्‌वार्‌वा छ्याःफुल्बो। <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />ता नुई तोअपा पबित्रसास्त्रन खन्द अन ङ्याह्, “कुजुई लूपा थुम्म वन्नान, आथबा थुमा मन ठेलान ङू तै मर्‌वारे छ्युङ्नान, झामखेखेई नुई जेँन ङुर मपोङ्बो। <verse eid="ACT 8:32" /><verse number="33" style="v" sid="ACT 8:33" />नुन ङान्ज्यान देप्पान भेला नू न्याय मदेप्पो। नुन काल्बान बयान सुई खेचे? तैङर्‌वाङिन नुन जिन्दगी पिर्थीबिलै तल्बो।”<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="ISA 53:7-8">यसै ५३:७-८</ref></char></note><verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />तब मन छक्‌काई फिलिपग र्‌वाबो, “दया खेखे ङा र्‌वा, भबिस्यबक्ताजै अन सुन भारेः र्‌वापा जेङ्पा, नुन जेँनै भारेः कि घङ सुईन भारेः?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />तब फिलिपजै जेँन ङुर पोङपोङ पबित्रसास्त्रन अनै खन्दलै नु येसुन ल्होन् लः स्याप्पो। <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />आलै ख्यु लम्म वैतौ वैता ङाई त्यु र्‌हपुन रह्‌म्म स्वातबो। मन छक्‌काई र्‌वाबो, “सेह्‌ना, स्यीह् त्यु ङिम्न, ङा बप्‌तिस्मा वच्‌चेलै तैजै काःतैनौ?” [ <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फिलिपजै र्‌वाबो, “यदि पुरू समजै बिस्वास खेङिन नाई बप्‌तिस्मा वत्तैनान।” नुई झब बिम्बो “येसू मसिह यङ परमेस्वरन ङोह्जो जेङ्पा र्‌वार्‌वा ङा बिस्वास खेनान।”]<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />फिलिपजै रथ काःफाम्बो, आलै फिलिप रे मन छक्‌का ङ्योरुम त्युन झिङ जाःबो, रे नुई नू बप्‌तिस्मा बिम्बो। <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />जेङ्नै जब ख्यु त्युलै खोलोः लिपलिप स्वाबो, तब प्रभुन आत्माई फिलिपग जुङ्जुङ् वप्पो, रे मन छक्‌काई फिलिपग ह्‌याङ मरङ्बो, रे मन स्याङैस्याङै जेँन लम्म जाःबो।<note caller="-" style="x"><char style="xo" closed="false">8:39 </char><char style="xt" closed="false"><ref loc="1KI 18:12">१ झली १८:१२</ref></char></note> <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />जेङ्नै फिलिप अस्दोदग रङ्बो, रे कैसरिया मताप्न बेर सहर पुरूग ल्होन् लः स्याईस्याई होई।<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">साऊलन मुक्ति</para>
  <para style="r">(<ref loc="ACT 26:6-16">प्रे २६:६-१६</ref>; <ref loc="ACT 26:12-18">२६:१२-१८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />साऊल प्रभुन चेलावन बिरोधग हेँदिरि सच्‌चेन धम्की भिनैभिनै प्रधान पुजारीन स्याह् होई, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />रे नुई मन लम्न चोलोङ्चा रा या चिमिचा, सू धोनै ख्युकाङ्मोः खीखी यरूसलेमग सच्‌चे धेराःयो र्‌वार्‌वा दमस्कसन आराधनालयवन मिह्‌नग पुर्जी तोल्बो। <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />जब साऊल तूतौ दमस्कसन ङेमः ताप्पा, तैमेग स्वर्गलै ती ताह्‌म नुन धेँवछोँ चम्कि रह्पा। <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />नु साः घ्याबो, रे नुई झाम र्‌वानान केह्ः ताह्बो, “साऊल, साऊल, ना तैङ ङा तेपफाम्बो?” <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />नुई र्‌वाबो, “प्रभु, ङेन सु जेङ्पा?” आलै नुई र्‌वाबो, “ङा येसू जेङ्पा, सू ना तेफाफाङ्‌ङ। <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />जेङ्नै च्याङच्याङ सहरग वया, रे नाई तै खेत्वानान अन नाः स्यान्नान ङ्याह्।”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />नुन ङ्याबो यात्रा सिमिवजै केह्ः चन ताह्बो, जेङ्नै सुई र्‌वार्‌वा मरङरङ तै मर्‌वारे थाङथाङ छ्युङ्बो। <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />तब साऊल सालै च्याङ्बो रे मी पोङ्तौ नुई तये मरङ्नान रह्पा, रे ख्युई नुन लाह् जुङ्जुङ् र्‌वार्‌वा नू दमस्कसग सप्पो। <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />आलै नु सुमङी थाल रङ मतैबो, रे न ता झबो न थुङ्बो। <verse eid="ACT 9:9" /><verse number="10" style="v" sid="ACT 9:10" />दमस्कसग हननिया मिह्‌न्न ती चेला ङ्याह्। नू प्रभुई दर्सनग र्‌वाबो, “ए हननिया।” नुई र्‌वाबो, “हई प्रभु।” <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />तब प्रभुई नू र्‌वाबो, “च्याँ, रे ‘सीधा’ मिह्‌न्न गल्‌ली वया, रे स्याह् यहूदान यिम साऊल मिह्‌न्न तार्तसग छ्युङ्नान सिमी फारा, तैङर्‌वाङिन नु सोअताबाईताबाई छ्युङ्पा ङ्याह्। <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />नुई दर्सनग हननिया मिह्‌न्न ती सिमि झिङ स्वास्वा नुई देच्‌चे धेरायो र्‌वार्‌वा जेँन लाह्ः नुन लाह् नाम्पा रङ्पा ङ्याह्।”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />जेङ्नै हननियाजै र्‌वाबो, “प्रभु, अन सिमिवजै यरूसलेमग ङेन पबित्र सिमिकाङ्मोः अलः लै खेपा ङ्याह्, अन ङै लै सिमिलम ताह्पा ङिह्पा। <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />स्यीह् यङ नान मिह्‌न वन्नान पुरूग ज्यालग काचेन आङ ङोत्वा पुजारीवलम नुई देप्पा ङ्याह्।” <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />जेङ्नै प्रभुई नू र्‌वाबो, “वया, तैङर्‌वाङिन यहूदीन खोलोःन सिमिव, झलीव रे इस्राएलन सिमिन ङू ङन मिह्‌न ताह्फेम्मः नु दम्पा ङन ती पात्र जेङ्पा, <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />तैङर्‌वाङिन ङन मिह्‌न्न भिह्तु नुई हाति तूरि हुरत्वानान, अन ङा नु थन्नान ङ्युँ।” <verse eid="ACT 9:16" /><verse number="17" style="v" sid="ACT 9:17" />तब हननिया वैवै मन यिमन झिङ जाःबो, रे नुन लाह्ः जेँन लाह् नान्नान र्‌वाबो, “भाइ साऊल, कन प्रभु येसू ना स्वापा लम्म नान रह्‌म्म रङ्पा ङ्याह्, नुई र्‌वार्‌वा नाई रङ्चे धेरा रे ना पबित्र आत्माई नाङा र्‌वार्‌वा ङा फेप्पा ङ्याह्।” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />तुरुन्तै नुन मीलै सोपलैम तयाः छार्बो, नुई ह्‌याङ रङ्चे देप्पो। तब नु च्याङ्बो रे बप्‌तिस्मा वप्पो, <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />आलै ङ्योप्पा झाझा नुई तोप देप्पो। साऊल खजिर्या दमस्कसग रह्पा चेलावन ङ्याबो छ्युङ्बो।<verse eid="ACT 9:19" /></para>
  <para style="s">दमस्कसग साऊलजै ताह्फेप्पा</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />आलै तुरुन्तै नुई आराधनालयवग येसुन भारेः झामखेखे ताह्फेप्पो, “नु परमेस्वरन ङोह्जो जेङ्पा।” <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />तब ताह्‌नान भरि पुरूजै हालाईलाई र्‌वाबो, “अन मिह्‌न वन्नान पुरूग यरूसलेमग मीपा दोङ्नान रे स्याह्ई ख्युकाङ्मोः खीखी ङोत्वा पुजारीवन ङ्याबो वस्सुमजै स्वानान अनै नङ्पा तै?” <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />जेङ्नै साऊल हेँ ह्‌याल्म सक्तिसाली राईराई होई, रे येसुई मसिह जेङ्पा र्‌वानान पर्मान बिमबिम दमस्कसग छ्युङ्नान यहूदीकाङ्मोः तये र्‌वा मतैनान दोङ्बो।<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />आलै दिन लै वैमी यहूदीवजै दीदी नू सच्‌चेन सदेन्त्र दोङ्बो। <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />जेङ्नै ख्युन सदेन्त्र साऊलग क्युई रह्पा। ख्यु नू सह्‌म्मः ङिमछाम सहरन झलावग कुकु छ्युँ। <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />जेङ्नै नुन चेलावजै नू छान्जेई थामग काह्‌का पेःलै पोँ साःबो।<verse eid="ACT 9:25" /></para>
  <para style="s">साऊल यरूसलेमग</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />यरूसलेम होल्मी साऊल प्रभु येसुन चेलावन ङ्याबो दिचेन फाप्पो। जेङ्नै चेलाव साऊलग ङिह्‌म्बो तैङर्‌वाङिन नु तेम्माई प्रभुन चेला जेङ्पा र्‌वार्‌वा ख्युई बिस्वासै खे मतैबो। <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />जेङ्नै बरनाबासजै नू ङ्याबो वव्वै प्रेरितव ङ्याबो वप्पो। आलै साऊलजै प्रभू लमग रङ्पा रे प्रभु नुन ङ्याबो ल्होई र्‌वापा रे नुई दमस्कसग हिम्मत खेखे येसुन मिह्‌नग ताह्फेप्पा ल्होई ख्युकाङ्मोः स्याप्पो। <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />साऊल यरूसलेमग ख्युन ङ्याबो ङ्याबोई हाकाहाकि ल्हेम्म जाःबो, रे मङिनङिन प्रभुन मिह्‌नग ताह्फेम्मः जाःबो, <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />आलै नु यहूदीन खोलोःन सिमिव ङ्याबो खासे खेँ, जेङ्नै ख्युई नू सच्‌चे फाङ्‌ङ। <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />जेङ्नै अन क्युई राह्‌राह्‌ बिस्वासी थिक्‌कोवजै नू कैसरियाग सप्पो रे स्याह्‌लै नू तार्तसग फेप्पो।<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />मन्न छाम्म यहूदिया, गालील रे सामरिया छेत्रग ङिह्पान मन्दलि पुरूवग किम्म रह्बो। प्रभुन चेलावजै पबित्र आत्मालम हिम्मत देप्पो रे मन्दलिन उन्नति रह्बो। चेलाव परमेस्वरग ङिनङिन ल्हेङ्‌ङ रे सिमिव यङ पोह्‌न राईराई होई।<verse eid="ACT 9:31" /></para>
  <para style="s">पत्रुस लुद्‌दा रे जोप्पाग</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />पत्रुस धेँवछोँन ठाउँ पुरूग तुह्ईतुह्ई लुद्‌दाग ङिह्पान परमेस्वरन पबित्र सिमिवन स्याह् यङ स्वा ताप्पो। <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />नुई स्याह् एनियास मिह्‌न्न कान सिमिदिग धोबो, सु के परालै ल्हो मगुल्नान्न नाजाई ल्हौग दिम्पा ङ्याह्। <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पत्रुसजै नू र्‌वाबो, “ए एनियास, येसू मसिहजै नाः ताःफान्नान। च्याँ, रे नान ल्हौ तिह्‌रा।” आलै अन तुरुन्तै च्याङ्बो। <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />लुद्‌दा रे सारोनग छ्युङ्नान भरि पुरूजै नू रङरङ प्रभुक्याँ होल्बो।<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />जोप्पा सहरग तबीता, आथबा दोरकास (हरिनी) मिह्‌न्न चेलीदी ङ्याह्। नु धोन लः खेमः रे दान बिम्म जाःङ। <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />अन्तौ नु खङ्‌खङ सिह्बो, रे सिमिवजै नू थुथु ङ्याल्क्यान तलान कोदीग नाह्‌म्बो। <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />लुद्‌दा जोप्पा सहरन ङेमः रह्पान कारन, चेलावजै पत्रुस स्या ङ्याह् र्‌वानान ताह्ताह् नुन ङ्याबो सिमि ङेह्पाः झाःम र्‌वार्‌वा छ्याःफुल्मः फेप्पो, “ङ्योअन स्याह् खम्म स्वा।” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />तब पत्रुस च्याङच्याङ ख्युन ङ्याबो होई। स्या ताप्मी ख्युई नू ङ्याल्क्यान तलान कोठाः वप्पो। लम्माव पुरू नुन रह्‌म्म थाङथाङ खेखे दामः जाःबो, रे दोरकास ख्युन ङ्याबो रातौ नुई दोङदोङ नाम्पा घोलाङ रे घङ घोलाङ थम्बो। <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />जेङ्नै पत्रुसजै ख्यु पुरूग खोलोः फेप्फे पो जुबो आलै सोअताप्पो, रे मन सिह्पान ल्होक्याँ होलहोल र्‌वाबो, “तबीता, च्याँ!” आलै नुई मी पोङ्बो, रे पत्रुसग रङरङ च्याङच्याङ छ्युङ्बो। <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />नुई नू जेँन ल्हाजै जुङ्जुङ् जुरुक्‌कै सोल्बो, आलै पबित्र सिमिव रे लम्माकाङ्मोः स्वा र्‌वार्‌वा नू सम्पु थम्बो। <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />ता अन ल्होई पुरू जोप्पा भरि ताप्पो, रे लैजे प्रभू बिस्वास खेबो। <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />आलै नु खजिर्यान बेर सिमोन र्‌वानान फोन्न धोन खेनान सिमिदीन ङ्याबो जोप्पाः छ्युङ्बो।<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">पत्रुस रे कर्नेलियस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />कैसरियाग कर्नेलियस मिह्‌न्न ती सिमि ङ्याह्, सु रोम इतालिया मिह्‌न्न पल्तन्न ती अफिसर ङ्याह्। <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />नु परमेस्वरन भक्त ङ्याह्, नु रे नुन पयार पुरूजै परमेस्वरग ङिह्ङ्‌ङ। नुई त्वापाकाङ्मोः दया खेखे दान बिमबिम परमेस्वरग एकुरो सोअताप्ङ। <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />नुई ङिजे तिन बजेरा दर्सनग लः खेखे परमेस्वरन ती स्वर्गदुत जेँक्याँ स्वास्वा झाम र्‌वापा ताह्बो, “कर्नेलियस।” <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />नुई ङिनङिन नू लः खेखे सेह्‌म्बो रे र्‌वाबो, “प्रभु, र्‌वा।” आलै स्वर्गदुतजै नू र्‌वाबो, “नान सोअताप रे बिखारीकाङ्मोः बिम्पा दान नावान रुपग परमेस्वरन ङू ताप्पा ङ्याह्। <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />ता सिमिकाङ्मोः जोप्पा सहरग फेरा, रे पत्रुस र्‌वानान सिमोनग घ्वाम फेरा। <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />नु फोन्न धोन खेनान सिमोन्न स्या छ्युङ्पा ङ्याह्, सुन यिम समुन्द्रन नाः ङ्याह्।” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />जब नुन ङ्याबो ल्होई र्‌वानान स्वर्गदुत होई, तब नुई जेँन राङ्पावन बर्ग ङेपा रे एकुरो नुन सेन्चे खेनान भक्त सिपाहीदीग स्वा र्‌वाबो, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />रे ख्युकाङ्मोः ल्होई पुरू स्यापस्याप जोप्पाः फेप्पो।<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />नाप्चे ङिजे बार बजेरा ख्यु सुम्पा जोप्पा सहरन रह्‌म्म स्वा ताप्पो, मन्तौ पत्रुस यिमन ल्हुपग सोअताप्मः बरन्दा लिप्पो। <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />नु गुसिबो, रे नुई तयाः झासुम खेबो, जेङ्नै घङवजै ङ्योप्पा दोङैदोङै छ्युङ्तौ नुई दर्सन रङ्बो। <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />नुई पान्नाङ पोङ्बो, रे स्याह्‌लै कोप्चा लिब्रुङग खीपा तन्नालैम तयाः पिर्थीबिक्याँ घ्यापा यङ रङ्बो। <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />मन तन्नाग पिर्थीबिन तैस्याङ पुरून ल्हे ली ङिह्पा भस्त, स्युस्स्युई लेन्नान्न परानी रे पान्नाङन युजुव ङ्याह्। <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />तब नुई ती केह्ः ताह्बो, “ए पत्रुस च्याँ, रे सस्सै झा।” <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />जेङ्नै पत्रुसजै र्‌वाबो, “नङ्पा प्रभु, तैङर्‌वाङिन ङै हातौयै अपबित्र आथबा बाःपा तये झपा मीपा।”<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="LEV 11:1-47">लेवी ११:१-४७</ref>; <ref loc="JOS 4:14">यहो ४:१४</ref></char></note> <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />नुई मन केह्ः ह्‌याङ ङेरेप ताह्बो, “परमेस्वरजै तै छाङ्म दोङ्पा ङ्याह् मनग ना बाःपा नछुवा।” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />सुमरेपथाल झाम रह्पा, रे तुरुन्तै अन तन्ना स्वर्गक्याँ वप्पो।<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />जब पत्रुस जेँजै रङ्पान अन दर्सन्न अर्थ तै जेअँ र्‌वार्‌वा समसमग अकमक्‌क रह्पा ङ्याह्, मन्नै भेला कर्नेलियसजै फेप्पान सिमिव सिमोन्न यिम फारैफारै झलान ङू च्याङ्बो, <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />“पत्रुस र्‌वानान सिमोन स्यीह् छ्युङ्नौ?” र्‌वार्‌वा केह्ः किम खेखे लोप्पो।<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />जब पत्रुस दर्सन्न भारेः नावा खेपाई ङ्याह् तब पबित्र आत्माई नू र्‌वाबो, “सेह्‌ना, सिमि सुमपाई नाः फारैफारै छ्युङ्पा ङ्याह्। <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />च्याङच्याङ पोँ वया, रे कनकन मखेरे ख्युन ङ्याबो जाः, तैङर्‌वाङिन ख्युकाङ्मोः ङै फेप्पा जेङ्पा।” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />तब पत्रुस पोँ लिप्पो, रे मन सिमिवन ङ्याबो वैवै र्‌वाबो, “सेह्‌ना, ङेनजै फापा सिमि ङाई जेङ्पा। ङेन स्यीह् तैङ स्वापा?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />ख्युई र्‌वाबो, “अफिसर कर्नेलियसजै नाः नुन यिम घ्वाम फेप्पा जेङ्पा।” नु वाम्पा रे परमेस्वरग ङिन्नान यहूदी पुरू लम सम्मान देप्पा सिमि जेङ्पा, रे ङेनलम ल्हो‌न् ङ्यानाःयो र्‌वार्‌वा पबित्र स्वर्गदुतदीलम नू आदेस देप्पा ङ्याह्। <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />तब नुई ख्युकाङ्मोः झिङ स्वा र्‌वार्‌वा ख्युन स्वागत-सत्कार खेबो। नाप्चे पत्रुस च्याङच्याङ ख्युन ङ्याबो होई, रे जोप्पान कान बिस्वासी थिक्‌कोव नुन ङ्याबो जाःबो। <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />दानाप ख्यु कैसरिया ताप्पो। जेँन क्यालाकिप्पाव रे जेँन फुरीकाङ्मोः स्वा र्‌वार्‌वा यिम रूरू कर्नेलियसजै पत्रुसग कूपाई छ्युङ्पा ङ्याह्। <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />पत्रुस स्वास्वा झिङ जाःतौ कर्नेलियसजै नुन ल्हे ध्वाः खेबो। <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />जेङ्नै पत्रुसजै नू झाम र्‌वाईर्‌वाई सोल्बो, “च्याँ, ङा रे सिमिदी जेङ्पा।” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />तब पत्रुस नुन ङ्याबो ल्होई र्‌वाईर्‌वाई यिमन झिङ होई, रे स्या नुई लै सिमि जोम्पा रङ्बो। <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />तब पत्रुसजै ख्युकाङ्मोः र्‌वाबो, “यहूदीन खोलोःन सिमिन ङ्याबो सङ खेचे, आथबा ख्युकाङ्मोः दोःचे ती यहूदीन पत हाति अलः जेङ्पा र्‌वानान ल्होई ङेनकाङ्मोः क्युई मया। जेङ्नै परमेस्वरजै ङा सिमि सुई र्‌वार्‌वा अपबित्र आथबा बाःपा नछुवा र्‌वार्‌वा थम्पा ङ्याह्। <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />अन्नकारन कताङ्लुङमिम सङ्‌का तये मखेरे ङा ङेन स्या स्वापा। ङेनजै ङा तैङ घ्वापा? ता र्‌वा।” <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />तब कर्नेलियसजै र्‌वाबो, “सुमङीन ङू क्वाईमाल्‌ला: अन्नै भेला यिम ङा तिन बजेन सोअताबाईताबाई छ्युङ्पा ङ्याह्, तब साल्म घोलाङ च्योम्पा सिमि ती ङन ङू च्याङ्बो, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />आलै र्‌वामः जाःबो, ‘कर्नेलियस, परमेस्वरजै नान सोअताप ङ्याम्पा ङ्याह्, रे नाई बिखारीकाङ्मोः बिम्पा दान्न नावा खेपा ङ्याह्। <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />अन्नकारन जोप्पाग सिमि फेप्पे पत्रुस र्‌वानान सिमोनग घ्वाम फेरा। नु समुन्द्र नाः फोन्न धोन खेनान सिमोन्न यिम छ्युङ्पा ङ्याह्।’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />तब ङै तुरुन्तै नान स्या सिमि फेप्पा, रे ना दया खेखे स्वाबो। ता प्रभुलम नाः र्‌वापा ल्होई पुरूव ङ्याम्म ङि पुरू परमेस्वरन ङू स्यीह् स्वापा ङिह्पा।”<verse eid="ACT 10:33" /></para>
  <para style="s">पत्रुसन भासन</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />तब पत्रुसजै ल्होई र्‌वामः जाःबो, “तेम्माई ङा रँ, कि परमेस्वरजै छ्योवा मरुप्नान,<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">कानुन १०:१७</ref>; <ref loc="2CH 19:7">२ इति १९:७</ref></char></note> <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />जेङ्नै सिमि पुरू नुन ङ्याबो ङिह्ङ्‌ङ, रे धोन लः खेँ, अन नुन ङू स्वीकारी खेचेन पत सम स्योरस्योर राह्‌नान। <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />परमेस्वरजै इस्राएलीकाङ्मोः कोर्पान लोन, आथबा मसिहलम ताह्फेप्पा किम्मन ल्होन् लः ङेनकाङ्मोः क्युई ङ्याह्। (येसु र्‌वार्‌वा पुरून प्रभु जेङ्पा।)<note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="PSA 107:20">भजन १०७:२०</ref>; <ref loc="PSA 147:18">१४७:१८</ref>; <ref loc="ISA 52:7">यसै ५२:७</ref>; <ref loc="NAM 1:15">नहू १:१५</ref></char></note> <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />बप्‌तिस्मा बिन्नान्न यूहन्नाई ताह्फेप्पा बप्‌तिस्मान ङिक, गालील प्रदेसलै सुरु खेखे पुरू यहूदिया देसभरि ताह्फेप्पान बचन अनै जेङ्पा, <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />कि परमेस्वरजै नासरतन येसू पबित्र आत्मा रे सक्तिजै अभिसेक खेबो। नु धोन ल खेयङ रे सैतानलम तेपफाम्पा सिमिकाङ्मोः सिम दोङैदोङै ल्हेम्बो, तैङर्‌वाङिन परमेस्वर नुन ङ्याबो ङ्याह्।” <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />“आलै नुई यहूदीवन देसग रे यरूसलेमग खेपा तैस्याङ पुरून ङि साँचि जेङ्पा। नू ख्युई क्रुसग चुनचुन यङ सह्प्पो।<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="DEU 21:22-23">कानुन २१:२२-२३</ref></char></note> <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />नू परमेस्वरजै सुमङीग सम्पु दोङदोङ सोल्बो, रे नू सिमिवन ङू थम्बो, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />सिमि पुरूग नङ्पा, जेङ्नै ङि सू परमेस्वरजै साँचिन रुपग फाप्पो, रे नु सिपालै सम्पु रामी ङ्योअजै नुन ङ्याबो झपा थुङ्पा। <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />नुई ङ्योअग सिमिवन घूँ ताह्फेम्मः, आलै नु सम्पु रे सिह्पावन न्यायकर्ता राम परमेस्वरलम दम्पा सिमि जेङ्पा र्‌वानान्न साँचि भिना र्‌वार्‌वा कोपा ङ्याह्। <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />भबिस्यबक्ता पुरूवजै नुन साँचि बिम्पा ङ्याह्, कि येसुन लाह्ः बिस्वास खेनान पुरूजै नुन मिह्‌न्न सक्तिलम तीपान माफ देन्नान।”<note caller="-" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="ISA 33:24">यसै ३३:२४</ref>; <ref loc="ISA 53:5-6">५३:५-६</ref>; <ref loc="JER 31:34">यर ३१:३४</ref>; <ref loc="DAN 9:24">दान ९:२४</ref></char></note><verse eid="ACT 10:43" /></para>
  <para style="s">यहूदीन खोलोःन सिमिवजै पबित्र आत्मा देप्पा</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पत्रुसजै अन ल्होई र्‌वातौ र्‌वातौ केह्ः ङ्यान्नान पुरून लाह्ः पबित्र आत्मा लिप्पो। <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />यहूदीन खोलोःन सिमिवन ल्हाः यङ पबित्र आत्मान वर हाल्पा रङरङ पत्रुसन ङ्याबो स्वानान यहूदी बिस्वासीव हालाईबो। <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />तैङर्‌वाङिन घङ ल्होईग ल्होई र्‌वार्‌वा ख्युई परमेस्वरन प्रसङ्सा खेपा ख्युई ताह्बो। तब पत्रुसजै र्‌वाबो, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“ङि लैम पबित्र आत्मा देन्नान अजोवग त्युन बप्‌तिस्मा देच्‌चेलै सुई काःतैनौ?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />आलै नुई ख्युकाङ्मोः येसू मसिहन मिह्‌नग बप्‌तिस्मा भिना र्‌वार्‌वा र्‌वाबो। तब ख्युई पत्रुसग खजिर्या स्याह्ई छ्योवा र्‌वार्‌वा छ्याःफुल्बो।<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">पत्रुसन रिपोत यरूसलेमन मन्दली</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />यहूदियाग ङिह्पा प्रेरित रे बिस्वासी थिक्‌कोवजै यहूदीन खोलोःन सिमिवजै र्‌वार्‌वा परमेस्वरन बचन स्वीकारी खेदँ र्‌वानान ताह्बो। <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />जब पत्रुस यरूसलेमग स्वाबो, तब खतना खेनानवन मोह्ङजै नू झाःम र्‌वार्‌वा खागे खेबो, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“यहूदी बिस्वासीवन ङ्याबो वैवै ख्युन ङ्याबो नाई तैङ झापा थुङ्पा?” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />तब पत्रुसजै ङूलै ख्युकाङ्मोः र्‌वामः जाःबो:<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“ङा जोप्पा सहरग सोअताप यङ ङ्याह्, रे दर्सन ङ्याह्, तब ती किम तन्नालैम लिब्रुङक्याँ जुङ्जुङ् स्वर्गलै पोँ घ्यापा तयाः ङै दर्सनग रङ्पा, रे अन ङन ङ्याबो स्वाबो। <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />ङै लः खेखे सेन्तौ स्याह्‌ पिर्थीबिन भस्त रे तप्लन भस्तव, स्युस्स्युई लेन्नान्न परानी रे पान्नाङन युजुव रङ्पा। <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />ङा झाम र्‌वापा केह्ःदी ङै ताह्पा, ‘पत्रुस च्याँ, रे सस्सै झा।’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />जेङ्नै ङै र्‌वापा, ‘नङ्पा प्रभु, ङै तये अपबित्र आथबा बाःपा झानान्न माल हातौयै झापा मीपा।’” <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />“जेङ्नै मन केह्ःजै ङेरेप स्वर्गलै ङाः र्‌वाबो, ‘तै परमेस्वरजै छाङ्म दोङ्पा ङ्याह् मनग ना बाःपा नछुवा।’” <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />सुमरेप झामै रह्पा, रे मन पुरू ह्‌याङ स्वर्गः वप्पो। <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />“अन्नै भेला कैसरियालै ङन ङ्याबो फेप्पा सिमि सुमपाव ङा छ्युङ्पा यिम स्वा ताप्पो। <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />कनकन मखेरे ख्युन ङ्याबो वया र्‌वार्‌वा ङाः पबित्र आत्माई र्‌वाबो। अन थिक्‌कोव रुपाई ङन ङ्याबो जाःपा ङ्याह्, रे ङि मन सिमिन यिम जाःपा। <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />नुई ङ्योअग स्याप्पो, कि ती स्वर्गदुत नुन यिम थाङ्थाङ् छ्युङ्पाग झाम र्‌वापा नुई रङ्बो, ‘जोप्पाः सिमि फेप्पे पत्रुस र्‌वानान सिमोनग घ्वाम फेरा। <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />नुई नाः बचन स्यान्नान ङ्याह्, सुन लम ना रे नान पयार पुरूजै उद्धार देन्नान ङ्याह्।’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />जब ङै ल्होई र्‌वामः जाःपा, तब ङू ङिन लाह्ः लिप्पा लैम पबित्र आत्मा ख्युन लाह्ः रे लिप्पो। <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />तब प्रभुई र्‌वापान अन बचन ङा नावा रह्पा, ‘यूहन्नाई ता त्युई बप्‌तिस्मा बिम्बो, जेङ्नै पबित्र आत्माग ङेन बप्‌तिस्मा राह्‌नान ङ्याह्।’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />प्रभु येसू मसिहन लाह्ः बिस्वास खेतौ परमेस्वरजै ङ्योअग कन बर बिम्बो, यहूदीन खोलोःन सिमिकाङ्मोः अनै बर बिम्मी परमेस्वरग काःतैनान ङा सु जेङ्पा?” <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />अन ल्होई ताह्‌मी ख्यु तै मर्‌वारे छ्युङ्बो, रे झाम र्‌वाईर्‌वाई ख्युई परमेस्वरन महिमा खेबो, “ता ता परमेस्वरजै यहूदीन खोलोःन सिमिकाङ्मोः जिन्दगीन पत घ्योप्पा खेचेन मौका बिन्दँ।”<verse eid="ACT 11:18" /></para>
  <para style="s">एन्तिओखियाग मन्दली</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />स्तिफनसन भेलाः सुरु रह्पा तूरिन कारन खास्या पुरू फेल्पावजै घङग नङ्पा, जेङ्नै यहूदीकाङ्मोः मात्र केह्ः ताह्फेरैफेरै, फोनिके, साइप्रस रे एन्तिओखियाथाल तूह्बो। <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />जेङ्नै ख्युन बर्ग कान-कान साइप्रस रे कुरेनीन सिमिव ङ्याह्। ख्युई एन्तिओखियाग स्वास्वा यहूदीन खोलोःन सिमिकाङ्मोः प्रभु येसुन ल्होन् लः ताह्फेप्पो। <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />अन्नकारन प्रभुन सक्ति ख्यु ङ्याबो रह्पान कारन लैःजै बिस्वास खेबो रे घ्योप्पा खेखे प्रभुक्याँ होल्बो।<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />अन ल्हो‌न यरूसलेमग रह्पा मन्दलिजै ताह्बो, रे ख्युई बरनाबासग एन्तिओखियाः फेप्पो। <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />नु स्याह् स्वास्वा परमेस्वरन दया रङरङ स्याङ्बो, रे पुरूग सम पुरूजै प्रभुक्याँ बिस्वासी रह्पाई छ्योवा र्‌वार्‌वा प्रोत्साहन बिम्बो। <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />तैङर्‌वाङिन बरनाबास लः, पबित्र आत्मा रे ङोत्वा बिस्वासी सिमि ङ्याह्। सिमिव मोङ किम प्रभू पोह्‌न रह्पा।<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />तब साऊलग फाम्म बरनाबास तार्तसग होई। <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />जब नुई नू धोबो तब नू एन्तिओखियाग सप्पो। तब पुरा ती परान बेर मन्दलिन सिमिवन ङ्याबो ख्युई दोःचे खेपाई छ्युङ्बो, रे सिमिवन मोङ किमग लह्‌म्बो। चेलाव पहिली एन्तिओखियागै इसाही रह्बो।<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />अन्तौ कान भबिस्यबक्ताव यरूसलेमलै एन्तिओखिया स्वाबो। <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />ख्युन बर्ग अगाबस मिह्‌न्न ती सिमि च्याङच्याङ सन्सार पुरूग अनिकाल किम राम जाःपा ङ्याह् र्‌वानान पबित्र आत्मालम भबिस्यबानी र्‌वाबो। अन अनिकाल क्लौदियसन पाली रह्पा। <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />तब चेला पुरूवजै जे-जेँन औगात अन्सार यहूदिया छ्युङ्नान थिक्‌कोवग फुरी खेचेन भिह्तु भेती कोर्चे पक्‌का खेबो। <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />ख्युई झामै खेबो, आलै बरनाबास रे साऊलन लाह्ःलम ख्युन भेती ताङ्बोन अगुवावन स्या फेप्पो।<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">लै तेपफाम्पा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />मन्न लाह्ः हेरोद झलीजै मन्दलिन लै सिमिकाङ्मोः तूरि बिन्चेन भिह्तु नुन लाह्ः लाह् कह्बो। <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />नुई यूहन्नान दाज्यु याकूबग तरवालीजै सह्प्पो। <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />अन धोनजै यहूदीव स्याङ्पा रङरङ पत्रुसग र्‌वार्‌वा जुङ्चेन प्रयास खेबो। अन घतना सोरा मकानान्न रोतान तेवरन लाह् रह्पा ङ्याह्। <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />हेरोदजै पत्रुसग जुङ्जुङ् झ्यालखानाः कबो, रे निस्तार तेवरन ङिक नू सिमिन ङू सस्सुम खेखे नू सेन्चे खेमः सिपाहीन मोङ लीन जिम्मा बिम्बो। <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />झामखेखे पत्रुस झ्यालखानाः कपा ङ्याह्, जेङ्नै नुन पत मन्दलिजै परमेस्वरग तुत्तुई सोअताप्पाई छ्युङ्पा ङ्याह्।<verse eid="ACT 12:5" /></para>
  <para style="s">पत्रुसग ज्यालखानालै फेप्पा</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />हेरोदजै नू खोलोः छ्युछ्यु सत्फाम्पानै छान्जे, पत्रुस साँगल ङेह्जै खीखी पाले सिपाहीवन घूँ आःपाई ङ्याह्। सिपाहीव रे झलान ङूक्याँ थाङ्थाङ् छ्युङ्पाग झ्यालखानान सेन्चे खेपाई ङ्याह्। <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />तैमेग प्रभुन स्वर्गदुतदी स्याह् रङ्बो, रे कोठाः साल्म रह्पा। स्वर्गदुतजै पत्रुसग कुलकुल “खम्म च्याँ” र्‌वार्‌वा नू सोल्बो। तब साँगलव नुन ल्हालै फोलफोल घ्याबो। <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />स्वर्गदुतजै नू र्‌वाबो, “घोलाङ रे पौला घोना।” तब नुई झामै खेबो। नुई नू र्‌वाबो, “बर्खि गोनगोन ङन ङिह्‌ङिह्‌ जाः।” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />आलै नु ज्यालखानालै गेग्गे नुन ङिङि जाःबो। स्वर्गदुतलम खेपान ल्होई तेम्माई जेङ्पा र्‌वानान नु क्युई मरह्पा। जेङ्नै नुई दर्सन रङ्पाई ङिह्पा र्‌वार्‌वा छुबो। <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />जब सिपाहीन सेन्चे खेमः छ्युङ्पा पहिली रे ङेन मोह्ङग बोरबोर ख्यु सहरग जाःनान जङ्न झलाः ताप्पो, तब अन झला ख्युन पत नुँह् पोङ्बो, रे ख्यु खोलोः गेग्गे ती गल्‌लीन लम राह्‌राह्‌ होई, रे तुरुन्तै स्वर्गदुत पत्रुसग ख्योवाख्योवा होई।<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />जब पत्रुसन ह्‌याका स्वाबो तब नुई र्‌वाबो, “ता ङाः तेम्माई क्युई रह्पा, कि प्रभुई जेँन दुत फेप्पे हेरोद झलीन ल्हालै, रे यहूदीवजै तै खेसुम खेँ मन पुरूलम ङाः छुतकरा बिम्बो।”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />अन ल्होई पत्रुसग क्युई रामी, नु यूहन्ना, सू मर्कुस यङ र्‌वानान नुन मा मरियमन यिम होई। स्या सिमि लै जोमजोम सोअतापाई ङ्याह्। <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />पत्रुसजै झला कुल्तौ रोदा मिह्‌न्न राङ्मा झला पोङ्मः स्वाबो। <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />पत्रुसन केह्ः स्योःमी अन स्याङस्याङ झलाई मपोङ्‌रे झिङ धालैधालै होई “पत्रुस झलाः थाङथाङ छ्युङ्पा ङ्याह्” र्‌वार्‌वा ल्हो‌न बिम्बो। <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />जेङ्नै ख्युई नू र्‌वाबो, “ना युङ्मा जेङ्पौ।” जेङ्नै नुई र्‌वापा ल्होई तेम्माई जेङ्पा र्‌वार्‌वा नुई धिप्पी खेबो। तब ख्युई र्‌वाबो, “अन नुन स्वर्गदुत जेम्तौ।”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />जेङ्नै पत्रुसजै चन कुल्पाकुल्त्वा खेबो। झला पोङ्तौ नू रङरङ ख्यु हालाईबो। <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />पत्रुसजै “तै मर्‌वारे छ्योवा” र्‌वार्‌वा लाह्जै लाःता खेबो, रे प्रभुई नू कुजुई झ्यालखानालै खोलोः छ्यूबो अन ख्युकाङ्मोः स्याप्पो। अन ल्होईन ल्हो‌न याकूब रे घङ बिस्वासी थिक्‌कोवग भिना र्‌वार्‌वा नु स्याह्‌लै घङपू होई।<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />नाप रामी पत्रुसग तै रह्पा? र्‌वार्‌वा सिपाहीवन घूँ मिह्दा फाईरा रह्पा। <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />हेरोदजै नू फाप्पे मदोतौ, सिपाहीवन छोए सेनसेन ख्युकाङ्मोः सच्‌चेन आदेस बिम्बो। आलै हेरोद चन यहूदियालै कैसरिया वैवै स्याह्ई छ्युङ्बो।<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोद सिपा</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोद तुरोस रे सिदोन्न सिमिवन ङ्याबो यामयाम सुतूपा ङ्याह्। ख्यु मोह्ङदी राह्‌राह्‌ नुन स्याह् स्वाबो, रे झलीन झिङन कर्मचारी बलस्तसन ङ्याबो चापलुसी खेखे दिचेन भिह्तु छ्याःफुल्बो। तैङर्‌वाङिन ख्युन देस साईन भिह्तु झलीन देसग निर्भर ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="1KI 5:11">१ झली ५:११</ref>; <ref loc="EZK 27:17">इज २७:१७</ref></char></note><verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />तोकि खेपान दिनग झलीन घोलाङ गोनगोन हेरोद नुन सिङ्‌हासनग छ्युङ्बो, रे सिमिकाङ्मोः नुई भासन बिम्बो। <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />सिमिव “अन ता लान ल्होई जेङ्पा, सिमिन नङ्पा!” र्‌वार्‌वा फाईरा खेबो। <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />जेङ्नै परमेस्वरन प्रसङ्सा मखेपान कारन मन्नै भेला प्रभुन स्वर्गदुतदीजै नू फ्याङ्बो, रे खोल-खोल भु राह्‌राह्‌ नु सिबो।<note caller="-" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="DAN 5:20">दान ५:२०</ref></char></note><verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />जेङ्नै परमेस्वरन केह्ः छार्यङ रे फेलैफेलै होई। <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />बरनाबास रे साऊल जेँन सेवान धोन पुरा खेखे यरूसलेमलै होल्बो। आलै ख्युन ङ्याबो मर्कुस र्‌वानान यूहन्ना रे होई।<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बरनबास रे सावलग सेवाकाईन भिह्तु दमदम फेप्पा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />एन्तिओखियान मन्दली भबिस्यबक्ताव रे गुरुव, आथबा बरनाबास, काला र्‌वानान सिमीयोन, कुरेनीन लुकियस, प्रान्तीय ङोत्वा सासक हेरोदन ङ्याबो छारै वैपा मनेन रे साऊल ङ्याह्। <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />ख्युई प्रभुन आराधना खेपाई छ्युङ्पा रे बर्त छ्युङ्पान भेला पबित्र आत्माई र्‌वाबो, “ङन भिह्तु बरनाबास रे साऊलग मन धोन्न भिह्तु फा, कन धोन्न भिह्तु ङै ख्युकाङ्मोः घ्वापा ङिह्पा।”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />तब बर्त रे सोअतापताप ख्युई ख्युन लाह्ः जेँन लाह् नान्नान ख्युकाङ्मोः लम होई।<verse eid="ACT 13:3" /></para>
  <para style="s">साईप्रसग सेवाकाई</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />तब पबित्र आत्मालम फेप्पा रह्पान कारन बरनाबास रे साऊल सिलुकियाग होई रे स्याह्‌लै त्युन जहाजग चपचप साइप्रसक्याँ होई। <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />सलामिसग स्वातामी ख्युई यहूदीवन आराधनालयवग परमेस्वरन ल्होन् लः ताह्फेप्पो। ख्युकाङ्मोः फुरी खेमः यूहन्ना ख्युन ङ्याबो ङ्याह्। <verse eid="ACT 13:5" /><verse number="6" style="v" sid="ACT 13:6" />जब ख्यु तापु पुरूग ल्हेनैल्हेनै पाफोसथाल स्वा ताप्पो, तब स्या ख्युई यहूदी लबारन भबिस्यबक्तादीन बार-येसु मिह्‌न्न जादु खेनान्न सिमिदीग धोबो। <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />अन जादु खेनान्न सिमिदी प्रदेसन ङोत्वा सासक सर्गियस पौलसन ङ्याबो छ्युँ। सर्गियस पौलस बुद्धिमानी सिमि ङ्याह्। नुई साऊल रे बरनाबासग घ्वाघ्वा परमेस्वरन केह्ः ङ्यान्सुम खेबो। <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />जेङ्नै एलुमास जादु खेनान्न सिमिजै (तैङर्‌वाङिन ग्रीक ल्होईग नुन मिह्‌न्न धा अनै जेङ्पा) सर्गियस पौलसग बिस्वासलै होलफानफान ख्युकाङ्मोः काःबो। <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />जेङ्नै साऊलजै, सू पावल यङ र्‌वाङ, पबित्र आत्माई नाङनाङ नुनङ्या ती खेखे सेनसेन र्‌वाबो, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“ना सैतान्न ङोह्जो, पुरू धर्मी सिमिन बैरी, पुरू छल रे अलःजै नाङ्पा! तै ना प्रभुन थार्का लम् यिम्पु दोङ्म मख्योवानौ? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />ता सेह्‌ना, प्रभुन लाह् नान लाह्ः थेप्पा ङ्याह्, रे ना ता ङाई बेरथाल ङिह्‌मान ताह्‌म मरङ्नान राह्‌राह्‌ काना राह्‌नान ङ्याह्।” आलै मन्नै भेला मूपा रे नातुमाई नू कप्पो, रे कानजै नुन लाह्‌ जुङ्जुङ् र्‌वानान कि र्‌वार्‌वा अन धेँवछोँ वैमः जाःबो। <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />तब देसन मन ङोत्वा सासकजै अन र्‌वापा रङरङ बिस्वास खेबो, तैङर्‌वाङिन प्रभुन छोएग नु हालाईपा ङ्याह्।<verse eid="ACT 13:12" /></para>
  <para style="s">पिसिदियान एन्तिओखियाग सेवाकाई</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पावल रे नुन फुरीव पाफोसलै त्युन जहाज चपचप पामफिलिया सहरन पर्गाः ताप्पो, रे यूहन्ना ख्युन लम भाभा यरूसलेम होल्बो। <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />जेङ्नै ख्यु पर्गालै गेग्गे पिसिदियान एन्तिओखियाग स्वाबो, रे नाह्‌न ल्हाः आराधनालयन झिङ वैवै छ्युङ्बो। <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />ता कानुन रे भबिस्यबक्तान किताबन पाठ तोअमी यहूदी आराधनालयन ङोत्वा अगुवावजै ख्युन स्याह् झाःम र्‌वार्‌वा फेप्पो, “ए भाइ हो, ङेनकोन ङ्याबो सिमिवन भिह्तु खाईकोएन तयाः ल्होई ङिङिन र्‌वा।” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />तब च्याङच्याङ पावलजै लाह्जै लाःता खेखे र्‌वाबो, “हे इस्राएली रे यहूदीन खोलोःन सिमि परमेस्वरग ङिन्नान हो, ङ्याना, <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />इस्राएली सिमिवन परमेस्वरजै ङिन खेपुलकाङ्मोः दमदम मिस्रदेसग छ्युङ्तौ ख्युकाङ्मोः मकेकुकेन किम दोङ्बो, रे नुन सक्तिसाली पाःपुङ्जै ख्युकाङ्मोः मन देसलै छ्युछ्यु सप्पो।<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EXO 6:1">प्रस ६:१</ref>; <ref loc="EXO 12:51">१२:५१</ref></char></note> <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />सुनसान ठाउँग क्वाईमाल्‌ला: ङेथल पराथाल नुई ख्युन सेन्चे खेबो।<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="EXO 16:35">प्रस १६:३५</ref>; <ref loc="NUM 14:34">गन्ती १४:३४</ref>; <ref loc="DEU 1:31">कानुन १:३१</ref></char></note> <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />तब नुई कनान देसग ने जाति मीपा दोङ्दोङ् ख्युन देसन आङ क्वाईमाल्‌ला: क्याम ङेह्‌ रै फेराङ ङाथल पराथाल ख्युकाङ्मोः बिम्बो।<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">कानुन ७:१</ref>; <ref loc="JOS 14:1">यहो १४:१</ref> </char></note>” <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />अन ल्होईन ङिक सामुएल भबिस्यबक्तान पालिन बेर नुई न्यायधीसव बिम्बो।<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="JDG 2:16">न्याय २:१६</ref>; <ref loc="1SA 3:20">१ सामू ३:२०</ref></char></note> <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />आलै ख्युई झली तोल्बो, रे परमेस्वरजै बेन्यामीन पत्तिन किसन ङोह्जो साऊलग ङेथल पराथाल ख्युन लाह्ः रजाई खेफाम्बो।<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">१ सामू ८:५</ref>; <ref loc="1SA 8:19">८:१९</ref>; <ref loc="1SA 10:24">१०:२४</ref>; <ref loc="1SA 11:15">११:१५</ref></char></note> <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />परमेस्वरजै नू पह्‌म्मी दाऊदग ख्युन झली राम सोल्बो। नुन भारेः परमेस्वरजै साँचि बिमबिम र्‌वाबो, “ङै यिसैन ङोह्जो दाऊदग ङन सम अन्सारन सिमि देप्पा, सुई ङन इच्छ्या पुरू पुरा खेनान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">१ सामू १३:१४</ref>; <ref loc="1SA 16:12-13">१६:१२-१३</ref>; <ref loc="PSA 89:20">भजन ८९:२०</ref>; <ref loc="ISA 44:28">यसै ४४:२८</ref></char></note> <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />अनै सिमिन ङिकन सन्तानलम, नुन रेनरुपा अन्सार, परमेस्वरजै इस्राएलन पत ती मुक्तिदाता, येसू सप्पो।<note caller="-" style="x"><char style="xo" closed="false">13:23 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">२ सामू ७:१२-१३</ref>; <ref loc="ISA 11:1">यसै ११:१</ref></char></note> <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />नु स्वाचेन खेरे ङू बप्‌तिस्मा बिन्नान्न यूहन्नाई इस्राएलन सिमि पुरूग घ्योप्पान बप्‌तिस्मान ताह्फेप्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">मर्क १:४</ref>; <ref loc="LUK 3:3">लुक ३:३</ref></char></note> <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />बप्‌तिस्मा बिन्नान्न यूहन्नाई जेँन धोन ताःमः जातौ र्‌वापा ङ्याह्, “ङेनकाङ्मोः तै छुनान, ङा सु जेङ्पा? ङा नु नङ्पा। जेङ्नै ङन ङिक तीपा स्वानान ङ्याह्, सुन ङा लेह्‌न पौलान तना यङ फोल्चेन सम स्योरस्योर लैम मीपा।”<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“ए, अब्राहामन सन्तान सिमि, रे ङेन बर्ग परमेस्वरग ङिन्नान ए भाइ हो, ङिन स्याह्ई अन मुक्तिन ल्हो‌न कोर्पा ङ्याह्। <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />तैङर्‌वाङिन यरूसलेमग छ्युङ्नान रे ख्युन हाकिमवजै यसू मस्योरे बात्तै नाह्‌न ल्हाः तोअनान्न भबिस्यबक्तान बचनव हामकोरे न्यायग नू सच्‌चेन धल बिमबिम मन बचन पुरा खेबो। <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />सच्‌चेन धलन कारन तये मदेन्नै ख्युई नू सत्त्वानान र्‌वार्‌वा पिलातसन ङ्याबो छ्याःफुल्बो, <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />रे नुन भारेः सर्पा ल्होई पुरू ख्युई पुरा खेमी ख्युई नू क्रुसलै पोँ साःसाः तुह्‌र्साः लुँह्‌म्बो। <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />जेङ्नै परमेस्वरजै नू सिह्पालै सम्पु दोङ्बो। <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />जेँन ङ्याबो गालीललै यरूसलेम स्वानानवन स्याह् नु दिन लैन बेर रङ्बो, रे ख्यु चोँ सिमिवन घूँ नुन साँचि जेङ्पा।” <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />परमेस्वरजै खेपुलग खेपान मन रेनरुपान ल्होन् लः ङि ङेनकाङ्मोः स्यान्नान। <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />आथबा, कुजुई परमेस्वरजै येसू सम्पु दोङ्दोङ् सोलसोल अन ल्होई ङि, ख्युन सन्तान्न पत पुरा खेबो, कुजु भजनसङ्ग्रह ङेगै सर्पा ङ्याह्, “ना ङन ङोह्जो जेङ्पा, त्यान दिन ङै ना केह्पा ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भजन २:७</ref> </char></note> <verse eid="ACT 13:33" /><verse number="34" style="v" sid="ACT 13:34" />नुई मसिहग हातौयै मतोन्नान खेखे सिपालै सम्पु दोङ्पान भारेः चन झाम र्‌वापा ङ्याह्,<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">यसै ५५:३</ref></char></note> “ङा ङेनकाङ्मोः दाऊदग बिम्पा पबित्र रे मताह्‌नान्न असिका बिन्नान ङिह्पा।” <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />तैङर्‌वाङिन घङपू र्‌वार्‌वा झाम र्‌वापा ङ्याह्, ङेनजै जेँन पबित्र सिमिन ल्हो तोह्‌नफान्नान मया,<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भजन १६:१०</ref></char></note><verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />“तैङर्‌वाङिन नुन जेँनै पुस्ताग परमेस्वरन उदेस्य अन्सार सेवा खेखे सिमी नुन खेपुलवन ङ्याबो दाऊद लुँह्‌म्बो, रे नुन ल्हो तोह्‌तोह्‌ होई।<note caller="-" style="x"><char style="xo" closed="false">13:36 </char><char style="xt" closed="false"><ref loc="JDG 2:10">न्याय २:१०</ref>; <ref loc="1KI 2:10">१ झली २:१०</ref></char></note> <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />जेङ्नै सू परमेस्वरजै सिह्पालै सम्पु दोङ्बो नुन ल्हो‌ चन मतोह्‌म्बो।” <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />“अन्नकारन हे जिङ्‌कोव, ङेनकाङ्मोः क्युई राःयो, कि मनै येसुलम तीपा माफ राह्‌नान र्‌वानान्न घोसना ङेनकाङ्मोः खेपा ङिह्पा। <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />ङेन बिस्वास खेनानव पुरूजै नुन लमै ल्होई पुरूलम छुतकरा देप्पा ङ्याह्, कन छुतकरा मोसान कानुनलम ङेन पत राह्‌नान मया।”<verse eid="ACT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 13:40" />अन्नकारन होस खेखे छ्योवा, तेमन्ता भबिस्यबक्तावन किताबग र्‌वापा अन ल्होई ङेन लाह्ः स्वानान ङ्याह्:<note caller="-" style="x"><char style="xo" closed="false">13:40 </char><char style="xt" closed="false"><ref loc="HAB 1:5">हब १:५</ref></char></note><verse eid="ACT 13:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 13:41" />“हे सिमिन नाः पन्नान हो, सेह्‌ना रे हालया, आलै मीपा रा, तैङर्‌वाङिन ङेन पाली ङा ती धोन खेचे, झाःम धोन कन्न भारेः सुई बयान खेनै ङेनजै हातौयै बिस्वास खेनान मया।”<note caller="-" style="x"><char style="xo" closed="false">13:41 </char><char style="xt" closed="false"><ref loc="HAB 1:5">हब १:५</ref> </char></note> <verse eid="ACT 13:41" /><verse number="42" style="v" sid="ACT 13:42" />पावल रे बरनाबास यहूदी आराधनालयलै गेत्तौ सिमिवजै “घङ नाह्‌न ल्हाः ह्‌याङ स्वास्वा अन ल्होईवन भारेः ङी हेँ स्यारा” र्‌वार्‌वा छ्याःफुल्बो। <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />आराधनालयन जोम्पा सिमिव च्याङ्मी लै यहूदीव रे यहूदीन ल्हूलाम ङ्यान्नान सिमिव पावल रे बरनाबासन ङिक जाःबो, रे ख्युई ख्युन ङ्याबो ल्होई र्‌वाईर्‌वाई ख्युकाङ्मोः परमेस्वरन दयाग लुईपाई छ्योवा र्‌वार्‌वा छ्याःफुल्बो।<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />घङ नाह्‌न ल्हाः क्वाईमाल्‌ला सहरन पुरू परमेस्वरन केह्ः ङ्यान्चेन पत होलहोल स्वाबो। <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />मोङग रङ्तौ, यहूदीव थादोवाई नाङ्बो रे पावलजै र्‌वापा ल्होई च्याप्पो, रे नुन ल्हुई झबो।<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />जेङ्नै पावल रे बरनाबासजै हिम्मत खेखे र्‌वाबो, “परमेस्वरन बचन पुरून खेरे ङू ङेनकोगै मस्याखाईमे ङ्याह्। ङेनकोजै अनग अस्वीकार खेखे जेँगै न्यायग मताह्‌नान्न जिन्दगी मदेन्नान दोङ्पा राह्‌राह्‌ ङि ता यहूदीन खोलोःन सिमिवन स्याह् वैनान ङ्यु। <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />तैङर्‌वाङिन प्रभुई ङ्योअग झाःमन आग्या बिम्पा ङ्याह्, पिर्थीबिन धेँन नाःथाल मुक्ति साःमः ङै नाः यहूदीन खोलोःन सिमिवन पत ताह्‌म राम दम्पा ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="ISA 42:6">यसै ४२:६</ref>; <ref loc="ISA 49:6">४९:६</ref> </char></note> <verse eid="ACT 13:47" /><verse number="48" style="v" sid="ACT 13:48" />जब यहूदीन खोलोःन सिमिवजै अन ल्होई ताह्बो, ख्यु स्याङ्बो, रे परमेस्वरन बचन्न प्रसङ्सा खेबो, रे मताह्‌नान्न जिन्दगीन पत दम्पा पुरूजै बिस्वास खेबो।<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />प्रभुन केह्ः ठाउँ पुरूग फेल्बो। <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />जेङ्नै पावल रे बरनाबासन बिरोधग यहूदीवजै अगुवा रे परमेस्वरन आराधना खेनान्न स्योःनान चिमिचाव रे सहरन ङोत्वा-ङोत्वा सिमिकाङ्मोः उक्साई खेबो, रे ख्युकाङ्मोः जेँन ठाउँलै खोलोः धाम्बो। <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />जेङ्नै ख्युचन जेँन लेह्‌न थल्जुब ख्युन बिरोधग खारखार आइकोनियनग स्वाबो।<note caller="-" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">मत्ती १०:१४</ref>; <ref loc="MRK 6:11">मर्क ६:११</ref>; <ref loc="LUK 9:5">लुक ९:५</ref>; <ref loc="LUK 10:11">१०:११</ref></char></note> <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />चेलाव किम्म रे पबित्र आत्माई नाङ्बो।<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">आइकोनियनग पावल रे बरनाबासन सेवाकाई</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />ता आइकोनियनग पावल रे बारनाबास ङ्याबो येहूदीवन आराधनालयग जाःजाः झाःम खेखे ल्होई र्‌वाबो, कि यहूदीव रे यहूदीन खोलोःन सिमिवन मोङ किमै बिस्वास खेबो। <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />जेङ्नै बिस्वास मखेनान यहूदीवजै चन यहूदीन खोलोःन सिमिकाङ्मोः बर्ग जाःजाः थिक्‌कोवन बिरोधग ख्युन सम खाःपा दोङ्बो। <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />प्रभुन भरग हिम्मत खेखे ल्होई र्‌वायङ भेला लै थाल पावल रे बरनाबास स्याह् छ्यूबो। प्रभुई ख्युन ल्हालै हालाईचेन धोनव रे ताईलुवान धोन खेफानफान जेँन दयान बचन्न साँचि बिम्बो। <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />जेङ्नै सहरन सिमिकाङ्मोः भाचे रह्पा, रे कान यहूदीवक्याँ रे कान प्रेरितवक्याँ जाःबो।<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />यहूदीन खोलोःन सिमि रे यहूदीव ङ्योरुमजै ख्युन हाकिमवन ङ्याबो दीदी प्रेरितकाङ्मोः तेपफान्नान रे लुङ फ्याङ्चेन प्रयास खेबो। <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />ख्युई अन ल्होई क्युई रह्पा, रे लुकोनियान सहरव लुस्त्रा, दर्बी रे धेँवछोँन छेत्र राह्‌राह्‌ ज्यारज्यार होई, <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />रे स्याह् ख्युई ल्होन् लः ताह्फेप्पाई छ्युङ्बो।<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्त्रा रे दर्बीग सेवाकाई</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />ता लुस्त्रा सहरग लेह् कुल मतैनान सिमि तीपा छ्युङ्पा ङ्याह्। अन केह्तौलैन लुल्या ङ्याह्, रे हातौयै लेम्पा मया। <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />पावलजै ल्होई र्‌वापा नुई ङ्यान्यङ ङ्याह्। पावलजै नू ती खेखे सेम्बो, रे ताःचेन नुन बिस्वास ङ्याह् र्‌वानान रङरङ <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />केह्ः किमै फाईरा खेखे र्‌वाबो, “नान लेह्‌न भरग थार्का च्याँ।” आलै अन सैतैग च्याङ्बो रे बोरैबोरै ल्हेम्म जाःबो। <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />जब पावलजै खेपा अन धोन मोह्ङजै रङ्बो, तब ख्युई लुकोनियान ल्होईग केह्ः किमै झाम र्‌वाबो, “लाव सिमिन रुपग ङ्योअन ङ्याबो लिपलिप स्वादँ।” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />ख्युई बरनाबासग जिउस ला रे पावलग हर्मेस ला र्‌वामः जाःबो, तैङर्‌वाङिन अजोव चन ङोत्वा भासन बिन्नान्न सिमि ङ्याह्। <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />सहरन ङूक्याँ रह्पा जिउसन आराधनालयन पुजारीजै ताह्ङ्‌रावग मिबाव रे मिन्नोवान फुलमालाव सस्सै स्याह्‌न सिमिवन ङ्याबो दीदी भोका-फुलसुम खेबो।<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />जेङ्नै जब प्रेरितव, बरनाबास रे पावलजै अन ल्होई ताह्बो, तब ख्यु जेँन घोलाङ छ्योनछ्योन झाम र्‌वायङ फाईरा खेखे सिमिवन घूँ धालैधालै होई रे र्‌वाबो, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“सिमिव हो, ङेनको तैङ झाःम धोन खेनान? ङि रे ङेनको लैम तूरि-किम्म कूनान्न सिमिव जेङ्पा, रे ङेनकाङ्मोः अन भाछ्योवान ल्होईव लम सम्पु परमेस्वरक्याँ होलफान्चेन पत ल्होन् लः स्यान्नान, सु परमेस्वरजै स्वर्ग, पिर्थीबी, समुन्द्र रे मनग रह्पा तैस्याङ पुरू दोङ्बो।<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">प्रस २०:११</ref>; <ref loc="PSA 146:6">भजन १४६:६</ref></char></note> <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />नुई ङू वैतपा पुस्ताग सिमि पुरूवग जे-जेँनै ल्हूलाम अन्सार वैफाम्बो। <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />जेङ्नै नुई जेँग साँचि मीपा मख्योवाबो, तैङर्‌वाङिन नुई भलो खेखे ङेनकाङ्मोः पान्नाङलै नाङ्‌का रे फल छ्यानान्न सम्यो बिम्बो रे ङेनकोन समग ङ्योप्पा रे किम्मै हन्तक दोङ्बो।”<note caller="-" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="PSA 147:8">भजन १४७:८</ref>; <ref loc="JER 5:24">यर ५:२४</ref></char></note> <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />अन ल्होई पुरु र्‌वार्‌वा प्रेरितवजै धौखेखे भोका-आराधना फुलमफानरे मन मोङग काःबो।<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />जेङ्नै कान-कान यहूदीव एन्तिओखिया रे आइकोनियनलै स्याह् स्वा ताप्पो, रे मोङग उक्स्याई खेखे पावलग लुङ फ्याङ्बो, रे नु सिह्पा जेम्तौ र्‌वार्‌वा छुछु सहरलै खोलोः पुरीपुरी वप्पो। <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />जेङ्नै जब चेलाव नुन धेँवछोँ च्याङ्बो। आलै नु च्याङ्बो रे सहरन झिङ जाःबो, रे नाप्चे बरनाबासन ङ्याबो गेग्गे दर्बी होई।<verse eid="ACT 14:20" /></para>
  <para style="s">सिरियान एन्तिओखियाग होल्पा</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />पावल रे बरनाबासजै दर्बिया सहरग ल्होन् लः ताह्फेप्पे लै चेलाव दोङ्बो, रे ख्यु लुस्त्रा, आइकोनियन रे पिसिदियान एन्तिओखियाग होल्बो, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />ख्युई चेलाकाङ्मोः ङार्छेम दोङ्बो रे ख्युकाङ्मोः बिस्वासग तेम्मा राह्‌राह्‌ छ्युङ्मः हौसला बिम्बो। ख्युई “परमेस्वरन राज्यग जाःम ङ्योअजै लै तूरिव गारत्वानान,” र्‌वार्‌वा लह्‌म्बो। <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />जब ख्युई ख्युन मन्दली पुरूग अगुवाव दम्बो। तब सोअताप रे बर्त ङ्याबो ख्युवाजै बिस्वास खेपान प्रभुन जिम्माः ख्युकाङ्मोः बिम्बो।<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />आलै ख्यु पिसिदियालम राह्‌राह्‌ पामफिलिया छेत्रग स्वाबो। <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />पर्गाः केह्ः ताह्फेप्पे ख्यु अतालियाग स्वाबो। <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />आलै स्याह्‌लै ख्यु समुन्द्र यात्रा खेखे एन्तिओखियाः होई, खाः ख्युई पुरा खेपा धोन्न पत परमेस्वरन दयाग ख्युकाङ्मोः थोप्पा ङ्याह्। <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />जब ख्यु एन्तिओखियाः स्वा ताप्पो, तब मन्दली रूबो, आलै परमेस्वरजै ख्युन ङ्याबो खेपा धोन पुरून बयान खेबो, रे कुजुई नुई यहूदीन खोलोःन सिमिवन पत बिस्वासन झला पोङ्बो अन स्याप्पो। <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />ख्यु एन्तिओखियाग चेलावन ङ्याबो याम्मा छ्युङ्बो।<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">यरूसलेमन बिस्वासीव जोम्पा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />ता कान सिमिवजै यहूदियालै एन्तिओखियाः स्वास्वा बिस्वासी थिक्‌कोवग झाम लह्‌म्मः जाःबो, “ङेन मोसान कानुन अन्सार खतना मराङिन ता ङेन उद्धार रा तैनान मया।”<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">लेवी १२:३</ref></char></note> <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />तब पावल रे बरनाबासन ख्युन ङ्याबो लै मदीचे रे र्‌वाचे रामी, स्यान थिक्‌कोवजै पावल, बरनाबास रे घङ हातिपाः अन प्रस्‌नन फैसलान पत प्रेरितव रे ताङ्बोन अगुवावन ङ्याबो यरूसलेम वैचेन पत दम्बो।<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />मन्दलिन सिमिवजै ख्युकाङ्मोः स्याह्‌लै भिदा बिम्बो। ख्यु फोनिके रे सामरियालम राह्‌राह्‌ वैतौ यहूदीन खोलोःन सिमिवन प्रभू स्वीकारी खेपान ल्होई पुरू मङी खेखे ख्युकाङ्मोः स्याप्पो। अन ल्होनजै स्यान बिस्वासी थिक्‌कोव मिह्दा स्याङ्बो। <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />जब ख्यु यरूसलेम स्वा ताप्पो। तब ख्युकाङ्मोः मन्दलि, प्रेरित रे ताङ्बोन अगुवावजै स्वागत खेबो। परमेस्वरजै ख्युन ङ्याबो खेपा ल्होई पुरून प्रतिबेदन ख्युई स्याह् बिम्बो। <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />तब फरिसी पातीन हातिपा बिस्वास खेनानवजै च्याङच्याङ र्‌वाबो, “यहूदीन खोलोःन सिमिवन खतना राचे रे ख्युकाङ्मोः मोसान कानुन ङ्यान फानत्वानान ङ्याह्।”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />अन्न बिसयग सोच बिचार खेचेन भिह्तु प्रेरितव रे ताङ्बोन अगुवाव जोम्बो। <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />लै ल्होई रामी पत्रुसजै च्याङच्याङ ख्युकाङ्मोः र्‌वाबो, “भाइ हो, ङेनकाङ्मोः क्युई ङ्याह्, ङून दिनवग कुजुई परमेस्वरजै ङन ङुरलै यहूदीन खोलोःन सिमिवजै ल्होन् लःन केह्ः ताँयो रे बिस्वास ख्याःयो र्‌वार्‌वा ङेन घूँलै ङाः दम्बो। <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />समन ल्होई क्युई राह्‌नान परमेस्वरजै ख्युकाङ्मोः र्‌वार्‌वा ङी लैम पबित्र आत्मा बिमबिम ख्युकाङ्मोः स्वीकार खेपान ल्होई थम्बो। <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />नुई ख्यु रे ङिन घूँ तये भेदभाव मनाह्‌म्बो, जेङ्नै ख्युन सम बिस्वासलम छाङ्म दोङ्बो। <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />अन्न कारन चेलावन छोअपाः अन सिङ्‌कुल नान्नान तैङ परमेस्वरन छोए सेन्नान? अन सिङ्‌कुल न ता ङिन खेपुलजै न ङ्योअजै हुर तैनान। <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />जेङ्नै ङि बिस्वास खेनान, कि प्रभु येसुन दयालम ङ्योअजै उद्धार देप्पा ङिह्पा, कुजुई ख्युई रे देप्पा ङ्याह्।”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />तब जोम्पाः पुरू तै मर्‌वारे छ्युङ्बो, आलै यहूदीन खोलोःन सिमिवन घूँ परमेस्वरजै ख्युन लम कत्यामन हालाईचेन धोनव रे ताईलुवान धोनव खेबो अन्न बयान बरनाबास रे पावलजै खेबो। ख्युई अन बयान ङ्याम्बो। <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />ख्युई ल्होई र्‌वातामी याकूबजै झाम र्‌वाबो, “भाइ हो, ङन ल्होई ङ्याना, <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />परमेस्वरजै जेँनै मिह्‌न्न पत यहूदीन खोलोःन सिमिव लम ती सिमि दम्चेन दया खेबो र्‌वानान ल्होई सिमोनजै स्याप्पा ङ्याह्। <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />अनै ल्होईन ङ्याबो भबिस्यबक्तान केह्ः रे दीनान, कुजु पबित्रसास्त्रग सर्पा ङ्याह्, <verse eid="ACT 15:15" /><verse number="16" style="v" sid="ACT 15:16" />‘अन ल्होईन ङिक ङा होल्नान ङ्युँ, रे दाऊदन दिम्पान छ्युङ्पु ह्‌याङ दोङ्नान ङ्युँ, मन्न दिमदिम लुईपाव ङा ह्‌याङ दोङ्नान ङ्युँ, रे नू सोल्नान ङ्युँ,<note caller="-" style="x"><char style="xo" closed="false">15:16 </char><char style="xt" closed="false"><ref loc="JER 12:15">यर १२:१५</ref></char></note> <verse eid="ACT 15:16" /><verse number="17" style="v" sid="ACT 15:17" />रे लुईपा सिमिवजै परमप्रभू फात्तयाःयो, रे यहूदीन खोलोःन सिमि पुरूवजै, सू ङन मिह्‌नलै स्वा र्‌वापा ङ्याह्, <verse eid="ACT 15:17" /><verse number="18" style="v" sid="ACT 15:18" />अन ल्होई परमप्रभु र्‌वाङ, सुई ताङ्बोलै अन ल्होईवन ल्हो‌न स्यारैस्यारै स्वापा ङ्याह्।’<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="AMO 9:9-12">आमो ९:९-१२</ref>; <ref loc="ISA 45:21">यसै ४५:२१</ref></char></note><verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“अन्नकारन ङन फैसला अन ङिह्पा, कि परमेस्वरक्याँ होल्नान यहूदीन खोलोःन सिमिकाङ्मोः ङ्योअ मकान्मता, <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />जेङ्नै ख्युकाङ्मोः अन ल्होई सर्मता, कि ख्यु कु सोल्याप्नान्न बापा धोनलम भाभा छ्योवायो, ब्यभिचारलम, होला च्योरच्योर सह्प्पा भस्तन स्या रे कहलम भाभा छ्योवायो।<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="GEN 9:4">उत ९:४</ref>; <ref loc="LEV 3:17">लेवी ३:१७</ref>; <ref loc="LEV 17:10-14">१७:१०-१४</ref></char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />तैङर्‌वाङिन ङून पुस्तालै सहर सहरग मोसान कानुन्न ताह्फेप्पाई ङ्याह्, तैङर्‌वाङिन अन पुरू येहूदी आराधनालय पुरूग नाह्‌न ल्हाः तोअयङ ङ्याह्।”<verse eid="ACT 15:21" /></para>
  <para style="s">यहूदीन खोलोःन बिस्वासीकाङ्मोः पत्र</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />तब प्रेरितव, ताङ्बोन अगुवाव रे मन्दलि पुरूजै दीदी जेँन घूँलै हातिपा सिमिकाङ्मोः दमदम पावल रे बरनाबासन ङ्याबो एन्तिओखियाः फेच्चे ल छुबो। रे थिक्‌कोवन बर्ग ङोत्वा सिमिव, यहूदा र्‌वानान बरनाबास रे सिलासग दम्बो। <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />रे नुन ङ्याबो ख्युई अन पत्र कोर्बो: “एन्तिओखिया, सिरिया रे किलिकियाः छ्युङ्नान यहूदीन खोलोःन सिमि बिस्वासी थिक्‌कोव, प्रेरितव रे ताङ्बोन अगुवावन नमस्ते। <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />ङिन घूँलै वैपान कान-कान सिमिवजै घोलोवा लनलन ङिन ङेनकाङ्मोः तूरि बिम्बो र्‌वानान्न ल्होई ङी ताह्पा ङिह्पा। जेङ्नै ङी मन सिमिकाङ्मोः फेप्पा नङ्पा। <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />अन्नकारन ङि पुरूजै ती सम राह्‌राह्‌ खेपा निर्नय अन्सार हातिपा सिमिकाङ्मोः दमदम ख्युकाङ्मोः ङिन स्याङ्पान बरनाबास रे पावलन ङ्याबो ङेन स्याह्‌ फेच्चे ङ्योअग ल छुबो। <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />अन सिमिव झाम जेङ्पा, सुई ङिन प्रभु येसू मसिहन पत जेँन परान जोखिमग पप्पा ङ्याह्। <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />अन्नकारन ङ्योअजै यहूदा रे सिलासग फेप्पा ङिह्पा। ख्युई र्‌वार्‌वा अनै ल्होईव ङुरलै र्‌वानान ङ्याह्। <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />तैङर्‌वाङिन पबित्र आत्मा रे ङ्योअग अन ल छुबो, कि अन ङोत्वाखाईमे ल्होईव नङ्म घङ ह्‌याल्म तूरि ङेनकाङ्मोः हुरमफान्नान। <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />ङेनकाङ्मोः कुकाङ्मोः भोका फुल्याप, कह, होला च्योरच्योर सप्पा भस्तन स्या रे ब्यभिचारलै भाभा छ्योवा। अन ल्होईवलम भाभा छ्युँङिन ल राह्‌नान ङ्याह्। ङ्याबो ङ्योअन नमस्ते।”<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="GEN 9:4">उत ९:४</ref>; <ref loc="LEV 3:17">लेवी ३:१७</ref></char></note><verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />भिदा रामी ख्यु एन्तिओखियाः स्वाबो, रे बिस्वासीन मोङग ङ्याबो जोमजोम अन पत्र बिम्बो। <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />पत्रग रह्पान खाईकोएन ल्होई तोअतोअ ख्यु स्याङ्बो। <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहूदा रे सिलास जेँ र्‌वार्‌वा भबिस्यबक्ता रह्पान कारन थिक्‌कोवकाङ्मोः लैः बचनलम खाईकोए बिमबिम ख्युकाङ्मोः बिस्वासग ङार्छेम दोङ्बो। <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />अजोवजै खजिर्या स्याह् छ्युङ्मी, स्याह्‌न बिस्वासी थिक्‌कोवजै अजोवग फेन्नानवन स्याह् किम्म खेखे भिदा बिमबिम फेप्पो। [ <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />जेङ्नै सिलासग स्याह्‌ई छ्युङ्चे ल छुबो।]<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />पावल रे बरनाबास चन लह्‌नैलह्‌नै रे प्रभुन केह्ः ताह्फेरैफेरै घङ लै सिमिन ङ्याबो खजिर्या एन्तिओखियाग छ्युङ्बो।<verse eid="ACT 15:35" /></para>
  <para style="s">पावल रे बरनाबास भापा</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />खजिर्यान ङिक पावलजै बरनाबासग र्‌वाबो, “स्वा, कन-कन सहरग प्रभुन केह्ः ङ्योअजै ताह्फेप्पा ङ्याह् मन सहरवग होलहोल होई बिस्वासी थिक्‌कोवग धोमता रे ख्यु कत्याम ङ्याह् सेम्मता।” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />बरनाबासजै मर्कुस र्‌वानान यूहन्नाः ख्युन ङ्याबो वत्सुम खेबो। <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />जेङ्नै पावलजै मर्कुसग ङ्याबो वच्‌चे ल मछुबो, तैङर्‌वाङिन नु पामफिलिया छेत्रलै ख्युन ङ्याबो भाभा वैपा ङ्याह्, रे ख्युन ङ्याबो धोनग वैपा मया।<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">प्रे १३:१३</ref></char></note> <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />ख्युन घूँ अकेः किम सल्‌ला मदीनान रह्पा, कि ख्यु राह्ङराङ्सालम भाबो, रे बरनाबास मर्कुसग ङ्याबो वव्वै त्युन जहाजग साइप्रसक्याँ होई। <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />जेङ्नै पावलजै सिलासग दम्बो, आलै थिक्‌कोवलम परमेस्वरन दयाग जेँग नान्नान स्याह्‌लै होई। <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />मन्दलिवग ङाह्‌र्छेम दोङैदोङै नुई सिरिया रे किलिकिया राह्‌राह्‌ यात्रा खेबो।<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">पावल रे सिलासन ङ्याबो तिमोथीन यात्रा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />पावल दर्बी रे लुस्त्रागै स्वाबो। स्याह्‌ तिमोथी मिह्‌न्न चेलादी ङ्याह्। नु बिस्वासी यहूदी चिमिचादीन ङोह्जो ङ्याह्, जेङ्नै नुन पा चन ग्रीक ङ्याह्। <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />लुस्त्रा रे आइकोनियन्न थिक्‌कोवग नुन मिह्‌नकै ङ्याह्। <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />तिमोथीग पावलजै ङ्याबो वत्सुम खेबो। मन ठाउँवग छ्युङ्नान यहूदीवन कारनजै खेखे पावलजै नू वव्वै खतना खेबो। तैङर्‌वाङिन नुन पा ग्रीक ङ्याह् र्‌वानान ख्यु पुरूग क्युई ङ्याह्। <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />ता ख्यु सहरवन लम राह्‌राह्‌ वैतौ ख्युई यरूसलेमन प्रेरितव रे ताङ्बोन अगुवावजै खेपा निर्नयव अजोवग ङ्यानाःयो र्‌वार्‌वा स्याप्पो। <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />झामखेखे मन्दलिव बिस्वासग ङार्छेम राईराई रे ताँका बात्तै छारैछारै होई।<verse eid="ACT 16:5" /></para>
  <para style="s">त्रोआसग पावलन दर्सन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />पबित्र आत्मालम एसियाग केह्ः ताह्‌नफेरा र्‌वापा राह्‌राह्‌ पावल रे नुन फुरिव फ्रिगिया रे गलातियान ठाउँव राह्‌राह्‌ होई। <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />माइसियान सिमानाः स्वामी ख्युई बिनिथिया प्रदेसक्याँ वैसुम खेबो। जेङ्नै येसुन आत्माई ख्युकाङ्मोः वैमफाम्बो। <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />तब माइसिया राह्‌राह्‌ ख्यु त्रोआसग होई। <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />छान पावलजै ती मङ मङ्बो, माकेदोनियान ती सिमि च्याङच्याङ नू छ्याःफुल्पाई छ्युङ्पा ङ्याह्, “माकेदोनियाः स्वा, रे ङ्योअग सहयोग ख्या।” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />जब नुई अन दर्सन देप्पो, आलै तुरुन्तै ङि माकेदोनिया वैमः तयार रह्पा। ङ्योअजै अन तेम्माई छुपा कि ख्युकाङ्मोः ल्होन् लः ताह्फेम्मः परमेस्वरजै ङ्योअग घ्वापा जेअँ।<verse eid="ACT 16:10" /></para>
  <para style="s">फिलिप्पीग लिदियान सम लःरितपा</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />तब ङि त्रोआसलै त्युन जहाजग चपचप थारेः सामोथ्राके तापुक्याँ वैपा, रे नाप्चे नियापोलिस स्वा ताप्पा, <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />स्याह्‌लै माकेदोनियान ङूस्योवान जिल्‌ला ङोत्वा सहर फिलिप्पी सहरग स्वा ताप्पा। मन सहर चन रोमीवन अधिनग ङ्याह्। स्याह् ङि खजिर्या बेर छ्युङ्पा। <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />ता नाह्‌न ल्हाः सहरन झलालै खोलोः चाङ्पुन नाः वैपा, तैङर्‌वाङिन स्याह्‌ सोअताप्पु ङ्याह् र्‌वार्‌वा ङ्योअजै छोए खेपा ङ्याह्, रे स्याह्‌ ङि छ्युङ्पा रे जोम्पान चिमिचावन ङ्याबो ल्होई र्‌वामः जाःपा। <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />आलै थिआतीरा सहरग छ्युङ्नान, बैजनी घोलाङन ब्यपार खेनान लिदिया मिह्‌न्न परमेस्वरग आराधना खेनान्न चिमिचादीजै ङिन ल्होई ङ्याम्बो। पावलजै र्‌वापान ल्होई ध्यान खेखे ङ्यानाःयो र्‌वार्‌वा प्रभुई नुन सम पोङ्बो। <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />जब नु रे नुन यिमन सिमि पुरूजै बप्‌तिस्मा वप्पो, तब नुई ङी छ्याःफुल्बो, “यदि ङेनकोजै ङा प्रभुन बिस्वासिनी छुचेन निर्नय खेङिन ङन यिम स्वास्वा छ्योवा।” रे नुई ङी धिप्पी खेबो।<verse eid="ACT 16:15" /></para>
  <para style="s">पावल रे सिलास ज्यालग</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />जब ङि सोअताप्पू वैयङ ङ्याह्, तब ल्हा सेन्नान्न आत्मा अलः ङिह्पान राङ्मा चिमिचादीग ङी दोपा, सुई ल्हा सेनसेन नुन मालिकवन भिह्तु लै कमाइ खेँ। <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />अन पावल रे ङिन ङिङि जाःबो, रे झाम र्‌वायङ फाईरा खेबो, “अन सिमिव पुरून खेरे किम परमेस्वरन सेवकव जेङ्पा। अजोवजै ङेनकाङ्मोः मुक्तिन लम्न घोसना खेँ।” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />मन चिमिचाई लै दिन्न बेर झाःम खेपाई छ्युङ्बो। तब पावलजै छरछर ङिक होलहोल मन आत्मा अलःग र्‌वाबो, “येसु मसिहन मिह्‌नग ङा नाः नुनलम गेग्गे वया र्‌वाचे।” आलै मन आत्मा अलः मन्नै भेला गेप्पो।<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />जेङ्नै नुन मालिकवजै ख्युन कमाईन आस मरह्पा रङरङ पावल रे सिलासग जुङ्जुङ् बजारन चोकग ङोत्वा हाकिमवन स्याह्‌ कानैकानै वप्पो। <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />आलै ख्युकाङ्मोः रोमी सासकवन ङ्याबो सस्सै र्‌वाबो, “अन सिमिव यहूदी जेङ्पा, अजोवजै ङिन सहरग गोलमाल धोँ।<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="1KI 18:17">१ झली १८:१७</ref></char></note> <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />अजोवजै झाम-झाम ल्हूलामव लन्नान कन ङि रोमीवन कानुन्न बिरोधग स्वीकार खेचे आथबा ङ्यान्चे लः मह्‌या।” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />तब मोह्ङव दीदी पावल रे सिलासग फ्याङ्मः जाःबो। सहरन सासकवजै ख्युन घोलाङ छ्योनछ्योन पप्पो, रे ख्युकाङ्मोः पेर्गाई फ्याङ फाम्बो। <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />ख्युई पावल रे सिलासग लै पेर्गाई फ्याङ्मी ख्युकाङ्मोः ज्यालग कबो, रे ज्यालखानान सासकग अन झ्यालखानाः त्यापा सिमिकाङ्मोः लः खेखे सेह्‌ना र्‌वार्‌वा आदेस बिम्बो। <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />झाम आदेस देद्दे नुई ख्युकाङ्मोः झ्यालखानान झिङक्याँ वव्वै ख्युन ल्हे ठिँगुरो थीङ्थिङ नाह्‌म्बो।<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />जेङ्नै छानफेग पावल रे सिलास सोअताबाईताबाई परमेस्वरन धेन धेपाई छ्युङ्पा ङ्याह्, रे घङ झ्यालखानाः त्यापान सिमिवजै अन ङ्याम्पाई छ्युङ्पा ङ्याह्। <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />तब हतपत ती किम साँगुल होई, रे झ्यालखानान जगव दार्बो, रे तुरुन्तै झलाव पुरू पोङ्बो, रे पुरून खीपाव पोङ्बो। <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />ज्यालखानान सासक मिवालै साप्पो, रे ज्यालखानान झलाव पोङ्पा रङरङ झ्यालखानाः त्यापा सिमि पुरूव ज्यार्तदँ र्‌वार्‌वा छुछु नुई हत्या खेसुमजै जेँन तरवाली छ्यूबो। <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />जेङ्नै पावलजै केह्ः छाम खेखे झाम र्‌वायङ फाईरा खेबो, “नाई जेँग हानि तये नख्या, तैङर्‌वाङिन ङि पुरू स्यीह्ई ङिह्पा,”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />तब बत्ती तोल्‌तोल्‌ नु बोरैबोरै झिङ स्वाबो, रे ङिनङिन दारैदारै पावल रे सिलासन ङू खल्बु क्याप्पो। <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />ख्युकाङ्मोः नुई खोलोः सस्सै र्‌वाबो, “गुरुज्यू उद्धार देच्‌चेन पत ङै तै खेत्वानान?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />आलै ख्युई झब बिम्बो, “प्रभु येसू मसिहग बिस्वास ख्या, आलै ना रे नान पयारजै उद्धार देन्नान ङ्याह्।” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />ख्युई नू रे नुन यिम रह्पा भरि पुरूग प्रभुन केह्ः स्याप्पो। <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />तब छान्न मनै भेला नुई ख्युकाङ्मोः वव्वै भुमा थुबो। आलै नु रे नुन पयारजै तुरुन्तै बप्‌तिस्मा वप्पो। <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />आलै पावल रे सिलासग यिम सस्सै ख्युकाङ्मोः ङ्योप्पा बिम्बो, रे परमेस्वरग बिस्वास खेबो र्‌वानान ल्होईग नुन पयार पुरून ङ्याबो नु स्याङ्बो।<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />जेङ्नै नम नाङ्मी रोमन सासकवजै सिपाहीकाङ्मोः अन आदेस बिमबिम फेप्पो, “ख्युम फेरा।”<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />तब ज्यालखानान सासकजै पावलग अन ल्होई स्याप्पो, “सहरन सासकवजै ङेनकाङ्मोः फेच्‌चेन आदेस बिम्पा ङ्याह्। अन्नकारन ता गेग्गे किम्म खेखे वया।”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />जेङ्नै पावलजै ख्युकाङ्मोः र्‌वाबो, “ङि रोमी सिमी दोसी ठहर्याई मखेरे ख्युई सिमिवन ङू फ्याङ्बो, रे झ्यालखानाः र्‌वार्‌वा कह्बो, रे ता ङ्योअग फाक छ्यूचे फाङ्‌ङ? अन रा मतैनान। रोमी आङ खेनान्न सिमि जेँ स्वायो रे ङ्योअग छ्युछ्यु होराःयो।” <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />मन सिपाहीवजै सासककाङ्मोः अन ल्होई स्याप्पो। ख्यु ता रोमी सिमि जेअँ र्‌वानान ताह्ताह् ख्यु ङिह्‌म्बो। <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />ख्युई स्वास्वा पावल रे सिलासन ङ्याबो माफ तोल्बो, रे ख्युकाङ्मोः खोलोः वप्पो रे सहर ख्योवाख्योवा वया र्‌वार्‌वा छ्याःफुल्बो। <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />ख्यु झ्यालखानालै खोलोः गेग्गे लिदियान यिम होई, रे बिस्वासी थिक्‌कोवन ङ्याबो दोःचे खेमी ख्युकाङ्मोः प्रोत्साहन बिमबिम होई।<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">पावल रे सिलास थेसलोनिकेग</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />पावल रे सिलास अम्फिपोलिस रे अपोल्‌लोनियान लम राह्‌राह्‌ थेसलोनिके स्वाबो। स्याह्‌ येहूदीवन ती यहूदीवन आराधनालय ङ्याह्। <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />पावल जेँन बानि अन्सार ख्युन ङ्याबो झिङ होई, रे नाह्‌न ल्हाः सुमङीन बेर पबित्रसास्त्रलम ख्युन ङ्याबो ल्होई र्‌वायङ छ्युङ्बो। <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />“मसिहग पक्‌का तूरि हुर्चे रे सिपालै सम्पु रात्वाङ, रे अनै येसू, सुन ल्होन् लः ङा ङेनकाङ्मोः स्याच्‌चे, नुई मसिह जेङ्पा” र्‌वानान ल्होईन धा पोङपोङ पावलजै पर्मानित खेबो। <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />ख्यु बर्ग हातिपा बिस्वास खेखे पावल रे सिलासक्याँ जाःबो। ताँका किमः परमेस्वरन भक्ति खेनान यहूदीन खोलोःन सिमिव रे हातिपा ङोत्वा चिमिचाव रे जाःपा ङ्याह्।<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />जेङ्नै थादोवाई नाङनाङ यहूदीवजै बजारन अलः सिमिकाङ्मोः रूरू मोङ सोलसोल सहरग फाईरा खेफाम्बो, आलै यासोन्न यिम हमला खेखे पावल रे सिलासग सिमिन ङू सच्‌चे फाप्पो। <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />ख्युकाङ्मोः लाह्‌ग थेप मतैतौ, ख्युई यासोन रे कान-कान थिक्‌कोवकाङ्मोः सहरन ङोत्वा सासकवन स्याह्‌ झाःम र्‌वार्‌वा फाईरा खेईखेई पुरीपुरी सप्पो, “सन्सारग गदबद दोङ्नान अन सिमिव स्यीह् रे स्वा ताप्पा ङ्याह्। <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />आलै यासोन्न दम्फु रह्पा ङ्याह्, रे ख्यु पुरूजै येसू र्‌वानान तीपा घङयङ झली ङ्याह् र्‌वार्‌वा कैसरन आदेसन बिरोधग धोन खेँ।” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />अन ल्होई ताह्ताह् सिमिव रे सहरन ङोत्वा सासकव आत्ती खेबो। <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />ख्युई यासोन रे नुन ङ्याबो रह्पा ह्‌याजन सिमिवन ङ्याबो धरौती वव्वै ख्युकाङ्मोः फेप्पो।<verse eid="ACT 17:9" /></para>
  <para style="s">बेरियाग पावल रे सिलास</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />बिस्वासी थिक्‌कोवजै तुरुन्तै पावल रे सिलासग छान्जेई बेरिया फेप्पो, आलै जब ख्यु ताप्पो तब नु यहूदीवन आराधनालयन झिङ होई। <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />बेरियान येहूदीव थेसलोनिकेन सिमिव खेरे ह्‌याल्म लः ङ्याह्। तैङर्‌वाङिन अजोवजै यामयाम स्याङ्स्याङ बचन स्वीकारी खेबो, रे मन ल्होईव र्‌वापालैम जेम कि नम र्‌वार्‌वा एकुरो पबित्रसास्त्र तोअतोअ छोए सेह्ङ्‌ङ। <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />अन्नकारन अजोवन बर्ग लैजे, ङ्याबो लै युनानी खान्दान्न चिमिचावजै रे चोलोङ्चावजै बिस्वास खेबो।<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />जेङ्नै जब परमेस्वरन केह्ः पावल लम बेरियागै ताह्फेप्पाई ङ्याह् र्‌वानान थेसलोनिकेन यहूदीकाङ्मोः क्युई रह्पा, तब ख्यु स्या रे मोह्ङग सोल्मः रे बर्ग झाम स्वा ताप्पो। <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />तब बिस्वासी थिक्‌कोवजै तुरुन्तै पावलग समुन्द्रक्याँ फेप्पो। जेङ्नै सिलास रे तिमोथी चन बेरियागै छ्युङ्बो। <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पावलग साःमः वैनानवजै नू एथेन्सथाल सप्पो। सिलास रे तिमोथी चन तैन बेर खम्मै नुन ङ्याबो स्वात्वानान र्‌वानान आग्या देद्दे ख्यु बेरिया होल्बो।<verse eid="ACT 17:15" /></para>
  <para style="s">पावल एथेन्सग</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />पावलजै सिलास रे तिमोथीग एथेन्सग कुकु छ्युङ्तौ, अन सहरग कुई नाङ्पा रङ्‌रङ आत्माग नु मिह्दा तुँलाक्या रह्बो। <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />अन्नकारन नुई यहूदीव रे परमेस्वरन भक्ति खेनान सिमिवन ङ्याबो आराधनालयग, रे दोपा पुरून ङ्याबो चन बजारन लम्म एकुरो खासे खेँ। <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />इपिक्युरी रे स्तोइकीन ल्हा सेन्नान सिमिवन बर्ग हातिपाई नुन ङ्याबो खाथू खेबो। ख्यु हातिपाई र्‌वाबो, “अन लही थोअपा तै र्‌वाङ?” घङवजै र्‌वाबो, “घङ कान बिदेसि लावन ताह्फेन्नान लैम रँ।” तैङर्‌वाङिन पावलजै येसू रे सिपालै सम्पु ग्युर्नान्न ल्होईन ताह्फेङ्‌ङ। <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />तब ख्युई नू अरियोपागसग वव्वै लोप्पो, “नाई बिम्पा अन सार्बा छोए तै जेङ्पा, तै ङि हाकोतैनौ? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />तैङर्‌वाङिन ना ङिन नाम्ज्योवाग हालाईचेन ल्होईव स्याप्यङ ङ्याह्। अन्नकारन अन ल्होईन अर्थ तै जेङ्पा ङी हाकोसुम ङिह्पा।” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />पुरू एथेन्सग छ्युङ्नानव रे स्याह्‌ छ्युङ्नान्न बिदेसिव सार्बा-सार्बा ल्होई र्‌वामः रे ङ्याम्म नङ्म जेँन भेला घङ धोन तयेग बिताई मखेँ।<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />पावलजै अरियोपागसन घूँ च्याङच्याङ र्‌वाबो, “एथेन्सन सिमि हो, ङेनकाङ्मोः ङा ल्होई पुरूग मिह्दा ला तेन्नान रँ, <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />अन सहरग तूतौ ङै ङेनकोन सोल्यापुव यङ रङ्पा। ठाउँदीन भोका फुल्नान्न बेदी ‘मस्योनान्न ला’ सर्पा ङिम्न। ङेनकोजै मस्योरेई सोल्याप्पान नुई परमेस्वरग ङा चोँ ताह्फेन्नान।” <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />“परमेस्वर, सुई सन्सार रे अनग रह्पा तैस्याङ पुरू दोङ्बो, नु पान्नाङ रे पिर्थीबिन प्रभु रह्पान कारन लाह्जै दोङ्पा आराधनालयग मछ्युङ्नान,<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="1KI 8:27">१ झली ८:२७</ref>; <ref loc="ISA 42:5">यसै ४२:५</ref>; <ref loc="ACT 7:48">प्रे ७:४८</ref>; <ref loc="2CH 6:18">२ इति ६:१८</ref>; <ref loc="PSA 146:6">भजन १४६:६</ref> </char></note> <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />नू चिज तयाः त्वापालैम खेखे सिमिन ल्हालै नुन सेवा रात्वानान र्‌वार्‌वा नछुवा। तैङर्‌वाङिन नुई र्‌वार्‌वा पुरूग झुनी, ऊ रे तैस्याङ पुरू बिन्नान। <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />नुई तीपा लम लै सिमि पिर्थीबी छ्युङ्मः जाति पुरून सिमि दोङ्बो। ख्युन लुईत्वानान्न भेला रे अन्त्यन दिन यङ तोकि खेबो,<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="DEU 32:8">कानुन ३२:८</ref></char></note> <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />सिमिवजै नू फाम्मः रे छामछुम खेखे देत्तयाःयो र्‌वार्‌वा नुई झाःम खेबो। जेङ्नै परमेस्वर ङि स्याह्‌लै ग्याङ्म मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="ISA 55:6">यसै ५५:६</ref>; <ref loc="JER 23:23">यर २३:२३</ref></char></note>” <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />तैङर्‌वाङिन “ङि नुग सोन्नान, रे नुग स्याङ्नान रे नुग ङिन अस्तित्व ङिह्पा।” ङेन जेँनै कबिवजै र्‌वापा ङ्याह्, “ङि तेम्माई नुनै सन्तान जेङ्पा।” <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />“तब ङि परमेस्वरन सन्तान रह्पान कारन, परमेस्वर मर, मुल आथबा लुङलैम जेङ्पा र्‌वार्‌वा ङी छुचे नङ्पा। अजोव चन सिमिन सिप रे छोएन प्रतिरुप मात्र जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">17:29 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उत १:२७</ref>; <ref loc="ISA 40:18-20">यसै ४०:१८-२०</ref>; <ref loc="ISA 44:10-17">४४:१०-१७</ref></char></note> <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />झाम क्युई मीपान भेलाः परमेस्वरजै ध्यान मबिम्बो, जेङ्नै ता ठाउँ पुरूग सिमिकाङ्मोः पुरू तीपान लमलै सम होल्मः घ्योप्पा खेफान्नान। <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />तैङर्‌वाङिन नुई दिन ती तोकि खेपा ङ्याह्, कन दिन नुई जेँजै दम्पा तीपा सिमिलम धर्मी सोभाऊग सन्सारन न्याय खेनान ङ्याह्। नू सिपालै समपु दोङदोङ नुई पुरू सिमिकाङ्मोः अन्न पर्मान बिम्पा ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="PSA 9:8">भजन ९:८</ref>; <ref loc="PSA 72:2-4">७२:२-४</ref>; <ref loc="PSA 96:13">९६:१३</ref>; <ref loc="PSA 98:9">९८:९</ref>; <ref loc="ISA 2:4">यसै २:४</ref></char></note><verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />जब पावललम ख्युई सिपालै सम्पु ग्युर्नान्न भारेः ताह्बो, तब कान-कानजै नू खिसि खेबो। जेङ्नै घङवजै चन “ङि ह्‌याङ अन भारेः नान ल्होई ङ्यान्नान ङिह्पा” र्‌वाबो। <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />आलै पावल ख्युन जोम्पालै होई। <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />जेङ्नै कान सिमिव नुन ङ्याबो जाःबो, आलै बिस्वास खेबो। ख्युन बर्ग अरियोपागसन सदस्य दियनुसियस, दामारिस मिह्‌न्न चिमिचादी, रे यहूदीन खोलोःन सिमिव रे ङ्याह्।<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">पावल कोरिन्थग</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />आलै पावल एथेन्स सहरलै भिदा राह्‌राह्‌ कोरिन्थ सहरग होई। <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />नुई पोन्तसग छ्युङ्नान अकिलास मिह्‌न्न तीपा यहूदी धोबो। नु जेँन मिसा प्रिस्किलान ङ्याबो इतालियालै स्वापा ङ्याह्, तैङर्‌वाङिन सम्रात क्लौदियसजै पुरू यहूदीकाङ्मोः रोमलै गेग्गे वैफाम्पा ङ्याह्। पावल ख्युकाङ्मोः धोमः होई। <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />च्योवालैम सिप रह्पान सिमि राह्‌राह्‌ नु रे ख्युन ङ्याबोई छ्युङ्बो, रे धोन खेबो। तैङर्‌वाङिन ख्युन धोन पाल दोङ्नान ङ्याह्। <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />पावल बात्तै नाह्‌न ल्हाः आराधनालयग वैवै यहूदीव रे ग्रीकवन ङ्याबो खाथू खेँ रे ङ्युरुमग मनाई खेचे फाङ्‌ङ,<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />जब सिलास रे तिमोथी माकेदोनियालै स्वा ताप्पो, पावल भेला पुरू केह्ः ताह्फेम्मः बिताई खेँ, रे यहूदीकाङ्मोः येसुई मसिह जेङ्पा र्‌वार्‌वा नुई बयान बिन्यङ ङ्याह्। <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />जेङ्नै जब ख्युई बिरोध खेखे नुन ल्हुई झाम जाःबो, तब नुई जेँन घोलाङ खारखार ख्युकाङ्मोः र्‌वाबो, “ङेन कह ङेनै थोप्पा छाराःयो, ङा निर्दोस ङिह्पा। तानधेरा ङा यहूदीन खोलोःन सिमिवन ङ्याबो वैनान ङ्यु।”<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />तब पावल ख्युकाङ्मोः ख्योवाख्योवा परमेस्वरन भक्ति खेनान तीतस युस्तस मिह्‌न्न यहूदीन खोलोःन सिमिन यिम होई। नुन यिम आराधनालयन रह्‌म्मै ङ्याह्। <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />यहूदी आराधनालयन ङोत्वा हाकिम क्रिस्पस रे नुन पयार पुरूजै प्रभू बिस्वास खेबो, रे कोरिन्थीवन बर्ग लैजे पावलन केह्ः ङ्यानङ्यान बिस्वास खेबो, रे बप्‌तिस्मा वप्पो।<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />ती छान मङ्‌ग प्रभुई पावलग र्‌वाबो, “नङिना, जेङ्नै ङन केह्ः र्‌वायङ वया, रे तै मर्‌वारे नछ्योवा, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />तैङर्‌वाङिन ङा नान ङ्याबो ङिह्पा, रे सुई नाः आक्रमन खेखे नाप्पा दोङ तैनान मया, तैङर्‌वाङिन अन सहरग ङन लै सिमिव ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ISA 41:10">यसै ४१:१०</ref>; <ref loc="ISA 43:5">४३:५</ref>; <ref loc="JER 1:8">यर १:८</ref></char></note> <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />आलै परमेस्वरन केह्ः सिमिकाङ्मोः लह्‌नैलह्‌नै पावल ती परा रे लाह्‌ रून बेर ख्युन ङ्याबो कोरन्थीग छ्युङ्बो।<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />जब गलियोन अखैयान ङोत्वा हाकिम रह्बो, तब कोरन्थीन यहूदी पुरूव जोमजोम पावलन ङ्या आक्रमन खेबो, रे नू जुङजुङ अदालतग सप्पो, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />रे ख्युई झाम र्‌वाबो, “अन सिमिजै कानुन्न बिरोधग परमेस्वरन आराधना खेमः सिमिकाङ्मोः लम्पाई ङ्याह्।”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />जब पावल र्‌वामः जाःपा ङ्याह्, तब गलियोनजै मन यहूदीकाङ्मोः र्‌वाबो, “यहूदी हो, यदि तेम्माई अन तयाः अन्याय आथबा अलः अपराधन ल्होई जेङ्न ता ङै ङेनकोन ल्होई स्हेः खेखे ङ्यान्चे लः राह्‌नान ङ्याह्। <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />जेङ्नै बचनव, मिह्‌नव रे ङेन जेँनै कानुन्न झब रह्पान कारन ङेह्‌ छोए ख्या। ङा झाम ल्होईवन न्याय दोङ्सुम मीपा।” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />आलै नुई ख्युकाङ्मोः अदालतन ङूलै धाम्बो। <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />तब ख्यु पुरूजै यहूदी जोम्पुन ङोत्वा हाकिम सोस्थेनेसग जुङजुङ अदालतन ङू फ्याङ्बो। जेङ्नै गलियोनजै मन ल्होईन तये वास्ता मखेबो।<verse eid="ACT 18:17" /></para>
  <para style="s">पावल एन्तिओखिया सहरग होल्पा</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />मन्न छाम्म पावल लैःन बेर कोरिन्थग छ्युङ्बो। तब थिक्‌कोवन ङ्याबो भिदा राह्‌राह्‌ नु त्युन जहाजग सिरिया होई। नुन ङ्याबो प्रिस्किला रे अकिलास यङ ङ्याह्। तयाः लान रेनरुपाः नुई क्रिकियाग जेँन छम पप्पो।<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">गन्ती ६:१८</ref></char></note> <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />ख्यु एफिससग स्वा ताप्पो, आलै पावलजै अकिलास रे प्रिस्किलाः स्याह्ई ख्योवाबो, रे नुँह् चन ती आराधनालयग जाःजाः यहूदीवन ङ्याबो खाथू खेमः जाःबो। <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />तब ख्युई नू हेँ खजिर्या छ्योवा र्‌वार्‌वा छ्याःफुल्तौ नुई मङ्याम्बो। <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />ख्युन ङ्याबो भिदा रातौ नुई र्‌वाबो, “परमेस्वरन सम राङिन ङा ह्‌याङ ङेन ङ्याबो होलहोल स्वानान ङिह्पा।” तब नु त्युन जहाजग चपचप एफिससलै होई।<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />जब नु कैसरियाग ताप्पो, तब लाह्ः लिपलिप मन्दलिन सिमिकाङ्मोः दोदो नमस्ते खेखे एन्तिओखियाक्याँ होई। <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />नुई स्याह् खजिर्या छ्युङ्छ्युङ् स्याह्‌लै गेग्गे गलातिया रे फ्रिगिया छेत्रन ठाउँव राह्‌राह्‌ चेला पुरूवग हौसला भिनैभिनै घङ-घङ ठाउँग होई।<verse eid="ACT 18:23" /></para>
  <para style="s">एफिसस रे कोरेन्थग अपोल्‌लोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />मन्नै भेला अलेक्जेन्द्रिया सहरग केह्पा अपोल्‌लोस मिह्‌न्न यहूदीदी एफिससग स्वाबो। नु यामयाम ल्होई र्‌वामः खाईम सिमि ङ्याह् रे नू पबित्रसास्त्रन लैः ग्यान ङ्याह्। <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />नुई प्रभुन लम्न छोए देप्पा ङ्याह्, रे आत्माः स्याङ्स्याङ् येसुन भारेन ल्होईव लः खेखे र्‌वायङ लह्ङ्‌ङ। जेङ्नै नुई बप्‌तिस्मा बिन्नान्न यूहन्नान बप्‌तिस्मान ल्होई मात्र हाकोपा ङ्याह्। <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />नु आराधनालयग मङिनङिन र्‌वामः जाःबो। जेङ्नै नुई र्‌वापा ल्होई ताह्ताह् प्रिस्किला रे अकिलासजै नू जेँन यिम सप्पो, रे परमेस्वरन लम्न धा झन लः खेखे बुझाई खेबो। <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />अपोल्‌लोसजै अखैया छेत्रग वैसुम खेतौ बिस्वासी थिक्‌कोवजै नू स्याह्‌ वया र्‌वार्‌वा हौसला बिम्बो, रे नू स्वीकारी ख्यायो र्‌वार्‌वा स्याह्‌न चेलाकाङ्मोः हौसला बिमबिम पत्र सर्बो। नुई स्याह्‌ ताप्‌ताप्‌ परमेस्वरन दयालम बिस्वास खेनानकाङ्मोः लै सहयोग खेबो। <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />तैङर्‌वाङिन नुई पबित्रसास्त्रन बचनलम येसुई मसिह जेङ्पा र्‌वानान ल्होई थनथन पुरू यहूदीवन ङू तेम्माई झब भिनमतैनान दोङ्बो।<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">पावल एफिससग</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />अपोल्‌लोस कोरिन्थ सहरग रातौ पावल एसिया छेत्रलै राह्‌राह्‌ एफिससग स्वाबो। स्याह्‌ नुई कान-कान चेलाकाङ्मोः धोबो। <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />नुई ख्युकाङ्मोः र्‌वाबो, “जब ङेनजै बिस्वास खेपा तै ङेनजै पबित्र आत्मा देप्पाऊ?” ख्युई नू र्‌वाबो, “पबित्र आत्मा ङिह्पा र्‌वानान ता ङ्योअजै ताह्पाई मया।” <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />आलै पावलजै ख्युकाङ्मोः र्‌वाबो, “तब ङेनजै सुन बप्‌तिस्मा वप्पा?” ख्युई र्‌वाबो, “यूहन्नान बप्‌तिस्मा।”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />तब पावलजै र्‌वाबो, “यूहन्नाई बिम्पा बप्‌तिस्मा चन घ्योप्पान बप्‌तिस्मा ङ्याह्। नुन ङिक स्वानान्न सिमि, आथबा येसुन लाह्ः बिस्वास ख्या र्‌वार्‌वा नुई इस्राएली सिमिकाङ्मोः स्याङ्‌ङ।”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />अन ल्होई ताह्ताह् ख्युई प्रभु येसुन मिह्‌नग बप्‌तिस्मा वप्पो। <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />जब पावलजै ख्युन लाह्ः लाह् नाह्‌म्बो, तब पबित्र आत्मा ख्युन लाह्ः स्वाबो, रे ख्युई घङ-घङ ल्होईग ल्होई र्‌वाबो रे भबिस्यबानी खेबो। <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />ख्यु क्वाईमाल्‌ला: चोलोङ्चा च्योङेपा ङ्याह्।<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />पावल यहूदी आराधनालयग जाःजाः लाह् सुमङीन बेर परमेस्वरन राज्यन भारेः ख्युन ङ्याबो मङिनङिन बहस खेबो रे सिमिकाङ्मोः हाको फानैफानै छ्युङ्बो। <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />जेङ्नै जब कान-कानजै राह्ङद्‌या राह्‌राह्‌ बिस्वास मखेबो, रे अन समुदायन बिरोधग मोङन ङू प्रभुन लम्न पत घोलोवा ल्होई र्‌वामः जाःबो, “तब पावल ख्युलम भाबो, रे चेलाकाङ्मोः ङ्याबो वव्वै तुरान्नसन स्कुलग खाथू खेमः जाःबो। <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />अन धोन ङेह् परान बेर रह्पाई लुईपा, रे एसियान पुरू प्रदेसन बासिन्दाव, यहूदी रे यहूदीन खोलोःन सिमि ङ्योरुमजै प्रभुन केह्ः ङ्याम्बो।”<verse eid="ACT 19:10" /></para>
  <para style="s">सिवान सन्तान</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />परमेस्वरजै पावलन ल्हालै राई मतैनान्न ताईलुवान धोनव खेबो, <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />सिथाल कि रुमाल आथबा बर्खि नुन ल्होग ज्यारज्यार खङ्नानवन ङ्याबो वङ्‌ङ, रे ख्युन ल्होलै नाह्जा वैङ रे मु यङ गेङ्‌ङ। <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />जेङ्नै कान-कान धेँवछोँ तूनान यहूदी फुकफाक खेनानजै मुई सेम्पाकाङ्मोः प्रभु येसुन मिह्‌न ङुरलै छ्यूईछ्यूई झाम र्‌वाबो, “पावलजै ताह्फेप्पा येसुलम ङा नाः आदेस बिन्चे।” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />स्याह् तीपा स्केवास मिह्‌न्न यहूदी प्रधान पुजारीन ङोह्जो नेह्पावजै झाःम धोन खेँ।<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />तब मुई झब बिमबिम ख्युकाङ्मोः र्‌वाबो, “येसू ङा स्योःनान, रे पावलग र्‌वार्‌वा ङा स्योःनान, जेङ्नै ङेन चन सु जेङ्पा?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />मन मु ताह्पा सिमि ख्युन ल्हाः बोरैबेरै स्वाबो, रे यहूदी फुकफाक खेनान पुरूवग अधिनग नान्नान ख्युन ङिक जाःबो रे ख्यु मन यिमलै चत्याःपा रे नाप्पा राह्‌राह्‌ ज्यार्बो। <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />अन ल्होई एफिससग छ्युङ्नान, यहूदी रे यहूदीन खोलोःन सिमिकाङ्मोः पुरू क्युई रह्पा। आलै ख्यु पुरू ङिह्‌म्बो, रे प्रभु येसुन मिह्‌न्न प्रसङ्सा रह्बो। <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />बिस्वास खेनानव लै स्वाबो, रे ख्युई खेपा जे-जेँन अलः धोनवन स्वीकार खेबो रे मन थम्बो। <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />ख्युन बर्ग लै, सुवा-सुवाजै तन्तर मन्तर खेँ, जे-जेँन किताबव रूरू सप्पो, रे पुरून ङू कोःबो। कन हजार फेराङसुमथल मुलन सिक्‌का बराबर रह्पा। <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />झामखेखे प्रभुन बचन फेलैफेलै होई, रे सक्तिसाली रह्बो।<verse eid="ACT 19:20" /></para>
  <para style="s">एफिससग याल</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />अन घतनावन ङिक, पबित्र आत्मान हौसलाग पावलजै माकेदोनिया रे अखैयान लम राह्‌राह्‌ यरूसलेम वैचेन निर्नय खेबो। नुई र्‌वाबो, “स्याह्‌ ताप्मी ङा रोम वैत्वानान” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />नुन सेवा खेनानव ङेपा, तिमोथी रे इरास्तसग नुई माकेदोनियाः फेप्पो, जेङ्नै नुँह् खजिर्या एसिया प्रदेसगै छ्युङ्बो।<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />अन्तौ परमेस्वरन लम्न भारेः मिह्दा फाईरा रह्पा। <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />देमेत्रियस मिह्‌न्न तीपा मुलन कु दोङ्नान सुनारजै आर्तेमिस आराधनालयन मुलन कत्याःम कत्याःम आराधनालयव दोङदोङ कु दोङ्नानकाङ्मोः धोन लै बिङ्ङ, तैङर्‌वाङिन अन धोनलै मिह्दा फाइदा रह्पा ङ्याह्। <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />तब अजोवकाङ्मोः रे घङ अनलैम सिप रह्पान सिमिकाङ्मोः नुई रूरू र्‌वाबो, “भाइ हो, ङेनकाङ्मोः क्युई ङ्याह्, कि अनै ब्यपारलम ङी कमाई लः राँ। <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />ङेनजै रङ्पाई ङ्याह् रे ताह्पाई ङ्याह्, कि एफिससग मात्र नङ्पा, जेङ्नै सोलोः एसिया प्रदेसग लाह्जै दोङ्पा ला तये नङ्पा र्‌वार्‌वा पावलजै लै सिमिवन मोङग लनलन बहकाई खेखे वप्पा ङ्याह्। <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />झामखेखे ङिन धोन्न मात्र नङ्पा जेङ्नै मकेकुकेन किम चिमिचा ला आर्तेमिसन आराधनालयनै ङान्ज्यान राह्‌नान ङ्याह्, आलै एसिया रे सन्सारभरिन सिमिवजै तेनैतेनै स्वापान मकेकुकेन किम चिमिचा ला आर्तेमिसन पुजा यङ बन्द राह्‌नान ङ्याह्।”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />अन ताह्ताह् ख्यु मिह्दा सुतूबो, रे “एफिसीवन आर्तेमिस मकेकुकेन किम जेङ्पा।” र्‌वार्‌वा फाईरा खेमः जाःबो। <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />सहर पुरूग फाईरा मच्‌ची रह्बो रे ख्यु दीदी पावलन ङ्याबो लेन्नान्न फुरी माकेदोनिया छ्युङ्नान्न गायस रे अरिस्तार्खसगै जुङ्जुङ् रङ्‌गसालान झिङ पुरीपुरी वप्पो। <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />पावल सिमिवन मोङग वैसुम खेबो, जेङ्नै चेलावजै नू वैमफाम्बो। <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />एसियान हातिपा ङोत्वा सिमिव पावलन फुरी ङ्याह्। ख्युई पावलग रङ्‌गसालान झिङ नवया र्‌वार्‌वा ल्हो‌न कोर्बो। <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />तब ख्यु राँसा-राँसान ल्होई र्‌वायङ फाईरा खेमः जाःबो। तैङर्‌वाङिन अन मोङग फाईरा मच्‌ची रह्पा ङ्याह्, रे लै सिमिवजै ता ख्यु तैङ जोम्पा जेङ्पा अन यङ क्युई रह्पा मया। <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />मोङन हातिपा सिमिवजै अलेजेन्दरग ङू साःबो, सू यहूदीवजै सोल्पा ङ्याह्। अलेजेन्दरजै लाह्जै लाःता खेखे तै मर्‌वारे छ्योवा र्‌वार्‌वा सिमिवन ङू जेँग सोमफान्चेन भिह्तु तयाः र्‌वासुम ङिह्पा र्‌वाबो। <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />जेङ्नै ख्युई अन ता यहूदी जेअँ र्‌वानान क्युई राह्‌राह्‌ पुरूजै केह्ः तीजै क्वाईमाल्‌ला घन्ता ङे “एफिसीवन आर्तेमिस मकेकुकेन किम जेङ्पा” र्‌वायङ फाईरा खेबो।<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />सहरन हाकिमजै सिमिकाङ्मोः छ्याःफाम्मी र्‌वाबो, “एफिससन सिमिव हो, एफिसीवन सहर चन किम आर्तेमिसन आराधनालय रे पान्नाङलै छार्पान नुन कुन रछेक जेङ्पा र्‌वानान ल्होई सुई क्युई मह्‌या तै? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />ङेन ख्युई ङिह्पा अन ल्होई च्याप मतैनान ङ्याह्, अन्नकारन ङेन छ्या त्वानान रे तये, घोल्वा धोन खेचे नङ्पा। <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />तैङर्‌वाङिन ङेनकोजै सप्पान अन सिमिवजै आराधनालय खुपा मया रे ङिन लान ल्हुई यङ पप्पा मया। <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />अन्नकारन यदि देमेत्रियस रे नुन ङ्याबो रह्पा कु दोङ्नान सिमिवन कान्न बिरोधग मुद्‌दा तयाः राङिन अदालतव पोङ्पा ङ्याह्, रे न्यायधीसव रे ङ्याह्, ख्यु राह्‌राह्‌ सान बिरोधग मुद्दा ध्याःयो। <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />जेङ्नै अन नङ्म घङै भारेः सोल्मः सम खेङिन ता अन्न फैसला जोम्पान निर्नय अन्सार राह्‌नान ङ्याह्, <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />तैङर्‌वाङिन त्यान अन मोङन दोस ङिन लाह्ः स्वादरा र्‌वार्‌वा ङिन्चे ङ्याह्। तैङर्‌वाङिन अन कारन मीपान यालग ङि सु तेम्मा सु लबार र्‌वा मतैनान।” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />अकेः र्‌वार्‌वा नुई जोम्पाः भिदा खेबो।<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">पावल माकेदोनिया रे ग्रीसग</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />अन फाईरा छ्यामी पावलजै चेलाकाङ्मोः घ्वाम फेप्पो, रे ख्युकाङ्मोः खाईकोए बिम्बो, रे ख्युन ङ्याबो भिदा राह्‌राह्‌ माकेदोनियाक्याँ होई। <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />स्याह्‌न छेत्रवग वैवै बिस्वासी सिमिकाङ्मोः लै हौसला बिम्मी नु ग्रीस देसग होई। <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />स्याह्‌ नु लाह् सुमङीग छ्युङ्बो। नु सिरियाक्याँ त्युन जहाजलम वैतौ यहूदीवजै नुन बिरोधग सदेन्त्र खेपा राह्‌राह्‌ पावलजै माकेदोनिया राह्‌राह्‌ई होल्चेन पक्‌का खेबो। <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />तब बेरिया छ्युङ्नान पुरसन ङोह्जो सोपात्रोस, थेसलोनिकेलै अरिस्तार्खस रे सिकन्दस, दर्बीन गायस, आलै तिमोथी रे एसिया प्रदेसन तुखिकस रे त्रोफिमस नुन ङ्याबो होई। <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />अजोव ङूई ताप्‌ताप्‌ ङ्योअग त्रोआसग कूपाई छ्युङ्पा ङ्याह्। <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />ङि चन निस्तार तेवर मनाई खेतामी फिलिप्पी सहरलै त्युन जहाजग चपचप वैपा। आलै ङार्याग ख्युकाङ्मोः त्रोआस सहरग दोपा, रे स्याह् ङि नेर्यान बेर छ्युङ्पा।<verse eid="ACT 20:6" /></para>
  <para style="s">त्रोआसग पावलन अन्त्यन यात्रा</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />नेर्यान ङूस्योवान लाह्ः जब ङ्योअ रोता क्युच्‌चेन भिह्तु जोम्पा, तब पावलजै चन नाप्चे वैसुम खेपा राह्‌राह्‌, ख्युन ङ्याबो छानफेथाल ल्होई खेपाई छ्युङ्बो। <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />ङ्योअ जोम्पान ङ्याल्क्यान तलान कोठाः लज्युङव लै छ्यापाई छ्युङ्पा ङ्याह्। <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />युतिकस मिह्‌न्न तीपा छबा झ्यालग छ्युङ्पा ङ्याह्। पावलजै लैःन बेर ल्होई र्‌वापाई छ्युङ्तौ नु मिबा किम्मः च्युबो रे मिबान ल्हाग थेप्थेप नु तला सुमलै घ्याबो रे नू ख्युई सिह्पान अबस्थाग सोल्बो। <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />तब पावल पोँ स्वाबो, रे खल्बु क्यापक्याप नू कुसुली क्याप्पो रे र्‌वाबो, “नङिना तैङर्‌वाङिन अन सम्पुई ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">20:10 </char><char style="xt" closed="false"><ref loc="1KI 17:21">१ झली १७:२१</ref></char></note> <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />तब नु लाह्ः लिप्पो आलै रोता क्युक्यु झातामी नाप नम मनाङ्न बेर ल्होई खेखे छ्युङ्बो। आलै होई। <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />स्याह्‌न चेलावजै चन मन छबाः यिम साबो। मन छबा सोम्पान कारन पुरू स्याङ्बो।<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआसलै मिलेतसथाल वैपा</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />ङ्योअ ङूलै त्युन जहाजग चपचप अस्सोस सहरग वैपा। ङ्योअ पावलग स्याह् त्युन जहाजग चप फानसुम ङ्याह्। पावलजै झामै जोरजाम खेखे नु अस्सोसथाल ल्हेनैल्हेनै वैपा ङ्याह्। <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />आलै जब नुई ङ्योअग अस्सोस सहरग धोबो, ङ्योअजै नू त्युन जहाजग चपफाम्पा, रे मितिलेने सहरग स्वापा। <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />स्याह्‌लै त्युन जहाजग वैवै नाप्चे खियस तापू स्वा ताप्पा। नुन सूनाप सामोस तापू स्वा ताप्पा। ह्‌याङ लीनाप मिलेतस सहरग स्वापा, <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />एसिया प्रदेसग छ्युङ्सुम मरह्पान कारन पावलजै एफिसस मजाःजाः वैचेन निर्नय पक्‌का खेबो। तैङर्‌वाङिन रातैङिन पेन्तिकोसन दिन यरूसलेमगै तैनबेर नुई तापसुम खेपा ङ्याह्।<verse eid="ACT 20:16" /></para>
  <para style="s">एफिससन ताङ्बोन अगुवावन आराधना</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />नुई मिलेतसलै एफिसस प्रदेसग सिमि फेप्पे मन्दलिन अगुवाकाङ्मोः घ्वाम फेप्पो। <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />जब ख्यु नुन ङ्याबो स्वाबो नुई ख्युकाङ्मोः र्‌वाबो, “एसिया प्रदेसग ताप्पान ङूस्योवान लाह्‌ःलै ङै भेला लै ङेन घूँ कत्याम खेखे छ्युङ्पा अन ङेनकाङ्मोः क्युई ङिह्पा। <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />पुरू नम्रताग छिमा पह्‌नैपह्‌नै, यहूदी सदेन्त्रन छोए सेन्चेग र्‌वार्‌वा ङै प्रभुन सेवा खेपा। <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />ङेनकोन फाईदा राह्‌नान्न ल्होई ङेनकोन ङू घोसना खेचेलै रे यिम-यिम पुरून ङू ङेनकाङ्मोः लह्‌म्मलम ङा ङिक मच्योल्पा। <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />यहूदीकाङ्मोः रे ग्रीककाङ्मोः घ्योप्पा खेखे परमेस्वरक्याँ होलाःयो रे ङ्योअन प्रभु येसू मसिहन लाह्ः बिस्वास नानायो र्‌वानान ल्होईन बयान ङै बिम्पा ङिह्पा।” <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />“ता सेह्‌ना, ङा पबित्र आत्माः बाध्य राह्‌राह्‌ यरूसलेमक्याँ वैयङ ङिह्पा, स्याह्‌ ङाः तयाः राम स्वानान जेम अन ङाः तये क्युई मीपा। <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />जेङ्नै अकेः मात्र क्युई ङिह्पा, कि सहर पुरूग तेपफाम्पा रे झ्यालखानान तूरि कुत्वानान ङ्याह् र्‌वार्‌वा पबित्र आत्माई ङाः स्याङ्‌ङ। <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />ङा ङन जेँन जिन्दगी ध्यान मबिन्नान। ङा अकेः मात्र चाहि खेनान, कि परमेस्वरजै सिमी दया खेपा ङ्याह् र्‌वानान्न ल्होन् लः फेल फान्चेन धोनग ङा पुरा खेतयाःयो, कन धोन चन प्रभु येसुई ङाः कोपा जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">२ तिमो ४:७</ref></char></note><verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“ता सेह्‌ना, ङाः क्युई ङिह्पा कि ङेनकोन बर्ग पुरू, सुवा-सुवाः ङै परमेस्वरन राज्यन ताह्फेरैफेरै लेम्बो, ङेनजै ङन ध्वा ह्‌याङ हातौयै रङ्नान मया। <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />अन्नैकारन त्या ङा ङेनकाङ्मोः साँचि भिनैभिनै र्‌वाचे, कि ङा पुरून कहलम निर्दोस ङिह्पा। <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />तैङर्‌वाङिन परमेस्वरन इच्छ्या पुरू ङेनकाङ्मोः र्‌वामः ङा ङिक मच्योल्पा। <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />ङेन जेँन भिह्तु रे जेँन मोह्ङ पुरून भिह्तु होस खेखे छ्योवा। पबित्र आत्माई ङेनकाङ्मोः मोङन जिम्मेवार दोङ्पा राह्‌राह्‌ नुई जेँनै कहजै र्‌युपा परमेस्वरन मन्दलिन सेन्चे ङेन ख्या।<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="PSA 74:2">भजन ७४:२</ref></char></note> <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />तैङर्‌वाङिन ङाः क्युई ङिह्पा, कि ङा वैमी ङिनङिन लैमन फाराव ङेनकोन घूँ जाःनान ङ्याह्, सुई मोह्ङग लाःमा नान्नान मह्‌या। <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />झामन भेला स्वानान ङ्याह्, ङेनकोनै घूँलै लबारन ल्होई र्‌वानान्न सिमिव च्याङ्नान ङ्याह्, सुई तेम्मा बिस्वासीकाङ्मोः जेँन चेला दोङदोङ घङ लम अलःग वन्नान ङ्याह्। <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />अन्नकारन जेर्म राह्‌राह्‌ छ्योवा, आलै ङै सुम परान बेर ङिम्मेछाम्मे छिमा पह्‌नैपह्‌नै सिमि पुरू ङै चेतावनी बिमबिम लम्पान ह्‌याका नलेया। <verse eid="ACT 20:31" /><verse number="32" style="v" sid="ACT 20:32" />ता ङा ङेनकाङ्मोः परमेस्वरग रे नुन दयान बचनग थोच्‌चे, सुई ङेनकाङ्मोः पक्‌का दोङ तैनान, रे पबित्र दोङ्पा पुरूवन घूँ आङ बिन तैनान। <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />ङै सुई सिमिन मर, मुल, रे घोलाङन लोभ मखेपा।<note caller="-" style="x"><char style="xo" closed="false">20:33 </char><char style="xt" closed="false"><ref loc="1SA 12:3">१ सामू १२:३</ref></char></note> <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />ङेह् क्युई ङ्याह् कि ङन अनै लाह्जै ङन जेँनै रे ङन ङ्याबो ङिह्पावन आबस्यकता पुरा खेपा ङ्याह्। <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />झामखेखे ‘वन्नानव खेरे बिन्नानव धन्न जेङ्पा’ र्‌वार्‌वा प्रभु येसु जेँजै र्‌वापान ल्होईग चिनचिन छ्याप्पुवावन सेन्चे खेमः तैन बेर तूरि खेखे धोन खेत्वानान र्‌वार्‌वा ङै ल्होई पुरूग थम्पा ङिह्पा।” <verse eid="ACT 20:35" /><verse number="36" style="v" sid="ACT 20:36" />अकेः र्‌वार्‌वा नुई पो जूबो रे ख्यु पुरून ङ्याबो सोअताप्पो। <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />ख्यु पुरू दाबो, रे पावलग कुसुली क्यापक्याप मोई खेबो। <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />ख्युई ह्‌याङ हातौयै नुन ध्वा रङ्नान मया र्‌वार्‌वा पावलजै र्‌वापा ल्होईग ख्युई मिह्दा समतू खेबो, आलै ख्युई नू त्युन जहाज थाल साबो।<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">यरूसलेमग पावलन यात्रा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />ख्युन ङ्याबो भिदा राह्‌राह्‌ ङ्योअ त्युन जहाजग चपचप थारेः कोस तापू स्वापा, रे नाप्चे रोदसग रे स्याह्‌लै पताराग स्वा ताप्पा। <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />आलै फोनिकेग वैनान्न त्युन जहाजदी दोदो ङ्योअ मनगै चपचप वैपा। <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />जब साइप्रस तापु रङ्बो, तब ङ्योअ त्युन जहाजग योम्मक्याँ होलफानफान सिरियाक्याँ वैवै तुरोसग लिप्पा। तैङर्‌वाङिन त्युन जहाजन आलमाल स्याह्‌ छ्युत्वापा ङ्याह्। <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />चेलाकाङ्मोः फाप्पाई दोदो ख्युन ङ्याबो ङ्योअ नेर्या स्याह्‌ छ्युङ्पा। पावलग यरूसलेमग नवया र्‌वार्‌वा ख्युई पबित्र आत्मालम र्‌वाबो। <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />स्याह्‌लै ङ्योअन वैचेन भेला रामी ङ्योअ भाभा जेँन ल्हेम्म गेप्पा। आलै ख्यु पुरू जेँन पयार रे वैचाव यङ ङ्योअग सहरन खोलोःथाल साःमः स्वाबो, रे ङ्योअजै समुन्द्रन नाः पो जूजू सोअताप्पा, <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />रे राह्ङराङ्सान ङ्याबो भिदा रह्पा। तब ङ्योअ त्युन जहाजग चप्पा, रे ख्यु चन जेँन यिम होल्बो।<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />तुरोसलै समुन्द्र-यात्रा खेखे ङ्योअ तोलेमाइग स्वा ताप्पा। स्याह्‌ बिस्वासी जिङ्‌कोव स्हीम ङिह्पाऊ र्‌वार्‌वा ख्युन ङ्याबो तीँ छ्युङ्पा। <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />नाप्चे ङ्योअ भाभा कैसरियाग स्वापा, रे ताह्फेन्नान फिलिपन यिम छ्युङ्पा। नु नेह्पान बर्ग ती ङ्याह् सू यरूसलेमन सेवकन भिह्तु दम्पा ङ्याह्। <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />परमेस्वरन केह्ः भबिस्यबानी र्‌वानान नुन लिपा कन्या चमेःव ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="JOL 2:28">योए २:२८</ref></char></note><verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />ङ्योअ स्याह्‌ खजिर्या छ्युङ्तौ यहूदियालै अगाबस मिह्‌न्न तीपा भबिस्यबक्ता स्वाबो। <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />नुई ङ्योअन स्याह् स्वास्वा पावलन धब वव्वै जेँन लाह्-लेह् खीबो, रे र्‌वाबो, “पबित्र आत्मा झाम र्‌वाङ, ‘अन धब कन सिमिन जेङ्पा, नू यरूसलेमग यहूदीवजै झामखेखेई खीनान ङ्याह् रे यहूदीन खोलोःन सिमिवन लाह्‌ग बिन्नान ङ्याह्’।”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />अन ल्होई ताह्ताह्, ङ्योअ रे मन ठाउँन सिमिव दीदी नू यरूसलेमग नवया र्‌वार्‌वा छ्याःफुल्पा। <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />जेङ्नै पावलजै झब बिम्बो, “ङेन झामखेखे दादा ङन सम तैङ मक्युप्पा दोङ्नान? तैङर्‌वाङिन प्रभु येसुन मिह्‌न्न भिह्तु ज्यालग थेप्चे मात्र नङ्पा, जेङ्नै ङा यरूसलेमग सिनै तयार ङिह्पा।”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />नू मनाई खे मतैतौ “प्रभुन इच्छ्या पुरा रायो” र्‌वार्‌वा ङ्योअ तै मर्‌वारे छ्युङ्पा।<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />स्याह्‌ ङाई छ्युङ्मी ङ्योअ आलमाल तयार खेखे यरूसलेमक्याँ वैपा। <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />ङ्योअन ङ्याबो कैसरियान कान-कान चेलाव रे वैपा, रे ख्युई ङ्योअग साइप्रसन पहिलीन बिस्वासीदी मनासोन र्‌वानान्न यिम सप्पो। नुन स्याह्‌ ङ्योअ छ्युङ्त्वापा ङ्याह्।<verse eid="ACT 21:16" /></para>
  <para style="s">पावलजै याकूबग दोपा</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />आलै जब ङ्योअ यरूसलेमग स्वा ताप्पा, तब बिस्वासी थिक्‌कोवजै ङ्योअग स्याङस्याङ स्वागत खेबो। <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />घङ्न लाह्ः पावल ङिन ङ्याबो याकूबग धोमः वैपा। स्याह्‌ मन्दलिन ताङ्बोन अगुवा पुरूव जोम्पा ङ्याह्। <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />ख्युकाङ्मोः स्हीम ङिह्पाऊ र्‌वामी, पावलजै नुन सेवाकाईलम यहूदीन खोलोःन सिमिवन घूँ परमेस्वरजै खेपान धोन ख्युकाङ्मोः ती-ती खेखे स्याप्पो। <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />अन ताह्‌मी ख्युई परमेस्वरन महिमा खेबो। तब नू र्‌वाबो, “पावल भाइ सेह्‌ना, यहूदीवन घूँ बिस्वास खेनानव हजारौँ ङ्याह्, रे कानुन्न ल्होईग ख्यु पुरू तखरा ङ्याह्। <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />ख्युई नान भारेः यङ तयाः ल्होई ताह्पा ङ्याह्, अन तै जेङ्पा र्‌वाङिन, यहूदीन खोलोःन सिमिवन घूँ छ्युङ्नान येहूदीकाङ्मोः नाई ‘मोसान कानुनग ख्योवाःयो रे ख्युन वैचाकाङ्मोः खतना नख्याःयो रे यहूदीवन ल्हूलाम नङ्यानाःयो,’ र्‌वार्‌वा लम्पा ङ्याह्, रु। <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />ता तै खेचे? ना स्वापा ङ्याह् र्‌वार्‌वा ख्युई तेम्माई ताह्‌नान ङ्याह्। <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />अन्नकारन तै ङि र्‌वानान, अन ख्या। रेनरुनान्न सिमि लिपाव ङिन ङ्याबो ङ्याह्। <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />अजोवग वव्वै ना रे अजोवन ङ्याबो ङ्याबोई छाङ्म रा, रे अजोवग त्वानान खर्च नाई फाः, रे अजोवजै छम पह्राःयो। झामखेखे नाई मोसान कानुन ङ्याम्पा रङरङ नान भारेः ताह्पा ल्होई तये तेम्मा नह् र्‌वार्‌वा पुरूग क्युई राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="NUM 6:5">गन्ती ६:५</ref>; <ref loc="NUM 6:13-18">६:१३-१८</ref>; <ref loc="NUM 6:21">६:२१</ref> </char></note> <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />जेङ्नै यहूदीन खोलोःन सिमिव सुई बिस्वास खेपा ङ्याह्, ख्यु कू भोका फुल्पान चिज, कह, होला च्योरच्योर सप्पा भस्तन स्या रे ब्यभिचारलै भाभा छ्युङ्त्वानान र्‌वानान्न ङ्योअन निर्नय स्यापस्याप ङ्योअजै हिगा सर्पा ङिह्पा।”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />तब पावलजै मन सिमिकाङ्मोः वप्पो, रे नाप्चे ख्युन ङ्याबो ङ्याबोई जेँगै छाङ्म खेफाम्बो रे छाङ्म दोङ्नान्न दिनव हातौ पुरा राह्‌नान जेम, आथबा पुरून भिह्तु बिन्नान भेतीन ल्हो‌न ताह्फेम्मः नु आराधनालयन झिङ होई।<note caller="-" style="x"><char style="xo" closed="false">21:26 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">गन्ती ६:१३-२१</ref></char></note><verse eid="ACT 21:26" /></para>
  <para style="s">आराधनालयग पावलग जुङ्पा</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />जब नेर्या पुरा राम जाःपा ङ्याह्, तब एसिया प्रदेसन यहूदीवजै पावलग आराधनालयग रङरङ मोङ पुरूग उत्साहित दोङ्बो, रे नू जुङ्बो। <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />ख्यु झाम र्‌वायङ फाईरा खेमः जाःबो “इस्राएलन सिमि हो, सहयोग ख्या! सिमिकाङ्मोः खातत्त्या ङ्योअन जाति, मोसान कानुन रे अन ठाउँन बिरोधग लनलन लेन्नान सिमि अनै जेङ्पा। अकेः मात्र नङ्पा, अनजै यहूदीन खोलोःन सिमिकाङ्मोः आराधनालयन झिङ सस्सै अन पबित्र ठाउँग बाःपा दोङ्पा ङ्याह्।” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />तैङर्‌वाङिन अन्न ङू ख्युई एफिससन त्रोफिमस र्‌वानान सिमि तीपाः नुन ङ्याबो सहरग रङपा राह्‌राह्‌ नू पावलजै आराधनालयन झिङ सप्पा जेङ्पा र्‌वार्‌वा ख्युई छुबो।<note caller="-" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रे २०:४</ref></char></note><verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />तब सहर पुरूग फाईरा रह्पा, रे सिमिवन ङ्याबो धालैधालै स्वाबो। ख्युई पावलग जुङ्जुङ् आराधनालयलै खोलोः पुरीपुरी सप्पो, रे तुरुन्तै झलाव थाबो। <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />जब ख्युई नू सच्‌चेन प्रयास खेपा ङ्याह्, तब यरूसलेम पुरू फाईराकुईरा रह्पा ङ्याह् र्‌वानान ल्होईन ल्हो‌न पल्तन्न सेनापतिन स्याह्‌ स्वा ताप्पो। <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />सरदार तुरुन्तै सिपाही रे सिपाहीन अफिसरन ङ्याबो वव्वै ख्युन ङ्याबो धालैधालै स्वाबो। ख्युई सिपाहीन अफिसर रे सिपाहीकाङ्मोः रङ्बो, रे पावलग फ्याङ्मः ख्योवाबो। <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />तब मन सेनापति रह्‌म्म स्वास्वा पावलग जुङ्बो रे साँगल ङेह्जै नू खीफाम्बो। अन सु जेङ्पा रे अनजै तै खेबो र्‌वार्‌वा नुई लोप्पो। <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />जेङ्नै मन मोङन बर्ग कानजै ल्होईदी रे कानजै घङ ल्होई र्‌वार्‌वा फाईरा खेबो, रे नुई अन फाईरान कारन घतना तै जेङ्पा अन क्युई रा मतैरे पावलग ब्यारेकग होरा र्‌वार्‌वा र्‌वाबो। <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />जब पावल भर्याङग स्वा ताप्पो, तब थल्जुबन ङिनङिनलैमन प्रोत्साहनजै खेखे सिपाहीवजै नू थीथी वप्पो। <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />तैङर्‌वाङिन सिमिवन मोङ “नू सह्‌रा” र्‌वार्‌वा फाईरा खेयङ ङिङि जाःपा ङ्याह्।<verse eid="ACT 21:36" /></para>
  <para style="s">पावलजै जेँग सोमफाम्पा</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />ब्यारेकन झिङ साःमः जातौ पावलजै सेनापती र्‌वाबो, “गुरु, अनुमति देङ्‌ङिन, ङा तयाः र्‌वासुम ङिह्पा।” नुई र्‌वाबो, “तै नाः ग्रीक ल्होई स्वानौ? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />आन ना मन मिस्री नङ्पाऊ, सुई तोर्ज्या क्रान्ति सुरु खेपा ङ्याह् रे हजार ली सोसस्त्र आतङ्‌कारीकाङ्मोः सुनसान ठाउँग वप्पा ङ्याह्?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />जेङ्नै पावलजै झब बिम्बो, “ङा ता किलिकियान सहर तार्तसन यहूदी सिमिदी जेङ्पा, मामलि सहरन सिमि नङ्पा। घलिछ्याःचल, अन सिमिकाङ्मोः तयाः र्‌वाचे ङाः अनुमति भिना।”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />जब नुई अनुमति बिम्बो, तब भर्याङ्‌ग थाङथाङ पावलजै सिमिकाङ्मोः लाह्जै लाःता खेबो। सिमिव पुरा छ्यामी, नुई ख्युकाङ्मोः हिब्रु ल्होईग झाम र्‌वाबो।<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />जिङ्‌को हो आथबा वैचा हो, “ङेनकोन ङू ङै जेँन पछेग र्‌वात्वानान ल्होई ता ङ्याना।” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />नु हिब्रु ल्होईग ल्होई र्‌वापा ताह्ताह् ख्यु हेँ तै मर्‌वारे छ्युङ्बो।<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />नुई र्‌वाबो, “ङा किलिकियान सहर तार्तसग केह्पा यहूदीदी जेङ्पा, जेङ्नै अन एरुसलेम सहरग गमलिएलन ल्हेन रह्‌म्म छ्युङ्छ्युङ् छोए लम्पा। ङिन खेपुलन कानुन यङ ङै लः खेखे लम्पा ङिह्पा। त्या ङेनको परमेस्वरक्याँ हाति उत्साही ङ्याह्, ङा रे अकेई उत्साही ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ACT 5:34-39">प्रे ५:३४-३९</ref></char></note> <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />ङै अन लम्न सिमिकाङ्मोः सिचेन थालै तेपफाम्पा, आलै चोलोङ्चा रे चिमिचा ङ्योरुमग साँगलजै खीखी झ्यालखानाः कह्‌पा।<note caller="-" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रे ८:३</ref>; <ref loc="ACT 26:9-11">२६:९-११</ref></char></note> <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />प्रधान पुजारी रे जोम्पा पुरूजै र्‌वार्‌वा ङन पछेग साँचि बिन्नान। ख्युनै भिह्तु भाइवन मिह्‌नग पुर्जी देद्‌दे ङा स्याह्‌ रह्पान बिस्वासीकाङ्मोः खीखी यरूसलेमग सस्सै सजाय बिमफाम्मः दमस्कसग वैपा ङ्याह्।”<verse eid="ACT 22:5" /></para>
  <para style="s">पावलजै जेँन सम लःरिताफान्चेन भिह्तु र्‌वापा</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रे ९:१-१९</ref>; <ref loc="ACT 26:12-18">२६:१२-१८</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“दमस्कसन रह्‌म्म स्वा ताप्‌तौ क्वाईमाल्‌ला: ङिजे फे रातौ, तैमेग स्वर्गलै ताह्‌म किमदी ङन धेँवछोँ चम्कि रह्पा, <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />रे ङा साः घ्यापा, आलै ङाः झाम र्‌वापाई खेपा केह्ःदी ताह्पा, ‘ए साऊल, ए साऊल, ना तैङ ङाः तेपफान्नान?’” <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />आलै ङै लोप्पा, “हे प्रभु, ना सु जेङ्पा?” आलै नुई ङाः र्‌वाबो, “नासरतन येसू ङाई जेङ्पा, सू ना तेपफाम्पाई ङ्याह्।” <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />तब ङन ङ्याबो हातिपा ङ्याह्, ख्युई ताह्‌म ता रङ्बो, जेङ्नै ङन ङ्याबो ल्होई र्‌वानान्न बचन चन मताह्बो। <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />“ङै र्‌वापा, ‘हे प्रभु, ता ङा तै खेचे?’ आलै प्रभुई ङाः र्‌वाबो, ‘च्याँ, दमस्कसग वया, रे नाई खेत्वानान तोकि खेपान धोनव नाः स्यान्नान ङ्याह्।’” <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />मन मकेकुकेन ताह्‌मन कारन जब ङै तये रङ मतैबो, तब ङन ङ्याबो राह्‌नानवजै लाह्जै जुङ्जुङ् र्‌वार्‌वा ङाः दमस्कसग सप्पो।<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“मन सहरग हननिया र्‌वानान कानुन अन्सार लेन्नान्न भक्ति सिमिदी सुई स्याह्‌ छ्युङ्नान यहूदी पुरूवलम आदर देप्पा ङ्याह्, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />नु ङन ङ्याबो स्वाबो, रे ङन रह्‌म्म च्याङच्याङ ङाः र्‌वाबो, ‘साऊल भाइ, रङ्नान रा।’ रे ङै अन्नै भेला रङ्नान रह्पा, रे नू रङ्पा। <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />मन्न छाम्म नुई ङाः र्‌वाबो, ‘नाई ङिन खेपुलन परमेस्वरन इच्छ्या नाई क्युई रातया र्‌वार्‌वाई नुई नाः दम्पा ङ्याह्। मन धर्मी सेवक येसू रङ्चे धेरा, रे नुन ङुरलै र्‌वापान ल्होईग ङ्यान्चे धेराःयो। <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />तैङर्‌वाङिन सिमि पुरूवन ङू नुन भिह्तु ङेनजै तै रङ्पा रे ताह्पा ङ्याह्, ना नुन साँचि राह्‌नान ङ्याह्। <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />ता तैङ कूनान? च्याँ, रे बप्‌तिस्मा होरा, आलै येसुन मिह्‌न्न पुकार खेखे जेँन तीपा थुवा।’”<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="JOL 2:32">योए २:३२</ref></char></note><verse eid="ACT 22:16" /></para>
  <para style="s">पावलजै यहूदीन खोलोःन सिमिकाङ्मोः ताह्फेप्पा</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“यरूसलेमग होलहोल स्वामी आराधनालयग सोअतापाई छ्युङ्तौ ङै दर्सन रङ्पा। <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />प्रभुई ङाः झाम र्‌वापाई रह्पा ङै रङ्पा, ‘खम्म खेखे यरूसलेमलै गेरा, तैङर्‌वाङिन ङन भारेः नाई बिम्पा साँचि ख्युई स्वीकारी खेनान मया।’” <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />ङै र्‌वापा, “हे प्रभु, ङै यहूदीन आराधनालय पुरूग वैवै नान लाह्ः बिस्वास खेनानकाङ्मोः ज्यालखानाः कह्पा रे फ्याङ्पा अजोव पुरूग क्युई ङ्याह्। <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />नान साँचि स्तिफनसन कह गेत्फान्तौ ङह् रे रह्‌म्मै च्याङ्च्याङ नू सह्त्तौ दीदी, नू सन्नानवन घोलाङ कुकु छ्युङ्पा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">प्रे ७:५८</ref></char></note> <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />“तब प्रभुई ङाः र्‌वाबो, ‘वया, तैङर्‌वाङिन ङा नाः यहूदीन खोलोःन सिमिव स्याह्‌ ग्याङम-ग्याङ्मथाल फेन्नान ङ्युँ।’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />अकेः र्‌वान बेर सिमिवजै पावलन ल्होई ङ्यान्पाई छ्युङ्पा ङ्याह्, जेङ्नै मन्न छाम्म चन ख्युई फाईरा खेईखेई र्‌वामः जाःबो, “अनग सस्सै पिर्थीबिलै पह्त्त्वानान, ता अनग सम्पु ख्योवाचेई नङ्पा।” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />ख्यु जेँन घोलाङ छ्योनैछ्योनै रे थल्जुब खेईखेई फाईरा खेमः जाःबो। <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />रोमन सेनापतिजै र्‌वाबो, “नू ब्यारेकन झिङ सह्‌रा, रे चेरन ताल्च्या फ्याङफ्याङ छोए सेह्‌ना, कि तैङ नुन बिरोधग ख्यु झामखेखे फाईरा खेपाई छ्युङ्पा ङ्याह्।” <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />आलै जब ख्युई पावलग फोन्न रूजै खीबो, तब पावलजै रह्‌म्मै थाङथाङ सिपाहीन अफिसरग लोप्पो, “तै रोमी सिमि रे दोसी ठहरी मरह्पान सिमी कानुन्न अन्सार चेरन ताल्च्या फ्याङ्चे लः जेङ्पाऊ?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />सिपाहीन अफिसरजै अन ताह्‌मी अफिसरन स्याह् स्वास्वा झाम र्‌वाबो, “नाई तै खेमः जाःपा ङिह्पा? तैङर्‌वाङिन अन सिमि ता रोमी सिमि जेअँ।” <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />तब सेनापतिजै स्वास्वा पावलग लोप्पो, “ङाः र्‌वा, तै ना रोमी सिमि जेङ्पौ?” नुई र्‌वाबो, “जेङ्पा।” <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />सेनापतिजै झब बिम्बो, “ङै ता अन सिमिन आङ सोङ लै फाफा र्‌युपा जेङ्पा।” पावलजै र्‌वाबो, “जेङ्नै ङा ता केह्तौलैन रोमी जेङ्पा।” <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />जेङ्नै नू छोए सेह्‌म्म तयार रह्पा सिमि पुरूव तुरुन्तै च्योलच्योल होई, रे पावल रोमी सिमिदी जेअँ र्‌वार्‌वा क्युई राह्‌राह्‌ सेनापति यङ ङिह्‌म्बो, तैङर्‌वाङिन नुई पावलग साँगलजै खीपा ङ्याह्।<verse eid="ACT 22:29" /></para>
  <para style="s">पावल जोम्पा किमन ङू</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />जेङ्नै नाप्चे यहूदीवजै पावलग पक्‌का कन कारनजै दोस बिम्पा ङ्याह् अन हाकोसुमजै नू पोङ्बो, रे ङोत्वा पुजारी पुरूव रे जोम्पा किम जोमफाम्बो, आलै पावलग पोँ सस्सै ख्युन ङू सोल्बो।<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पावलजै यहूदी जोम्पु लिबरुङक्याँ सेनसेन र्‌वाबो, “थिक्‌कोव हो, त्यान बेर जिन्दगीन यात्राग ङै ङन बिबेग्ग परमेस्वरन ङू छाङ्म नाम्पा ङिह्पा।” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />अन ल्होईग प्रधान पुजारी हननियाजै पावलन रह्‌म्म थाङ्थाङ् छ्युङ्नानकाङ्मोः खापराः फ्याँ र्‌वाबो। <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />तब पावलजै नू र्‌वाबो, “हे चुना छिम्पान पेः! नाः र्‌वार्‌वा परमेस्वरजै फ्याङ्नान ङ्याह्। ना कानुन अन्सार ङन न्याय खेमः छ्युङछ्युङ तै कानुन्न बिरोधग ङाः फ्याँ र्‌वानौ?”<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">मत्ती २३:२७-२८</ref>; <ref loc="LEV 19:15">लेवी १९:१५</ref>; <ref loc="JOS 13:10-15">यहो १३:१०-१५</ref></char></note><verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />आलै पावलन रह्‌म्म थाङ्थाङ् छ्युङ्नानवजै र्‌वाबो, “तै ना परमेस्वरन प्रधान पुजारीन माबि पन्नौ?” <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />तब पावलजै र्‌वाबो, “इस्राएली भाइ हो, ना प्रधान पुजारी जेङ्पा र्‌वानान ङाः क्युई मया। तैङर्‌वाङिन पबित्रसास्त्रग सर्पा ङ्याह्, ‘नाई जेँन जनतान हाकिमग अलः ल्होई नर्‌वाःयो’।”<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">प्रस २२:२८</ref></char></note> <verse eid="ACT 23:5" /><verse number="6" style="v" sid="ACT 23:6" />जेङ्नै मन यहूदी जोम्पू पातीदी सदुकी रे घङ पाती फरिसीव जेअँ र्‌वानान क्युई राह्‌राह्‌ पावलजै केह्ः किमः र्‌वाबो, “इस्राएली भाइ हो, ङा ता फरिसीवन ङोह्जो फरिसी यङ जेङ्पा। सिह्पावन आस रे सिपालै सम्पु ग्युर्नान्न कारन ङन मुद्दा चलि रह्पाई ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">प्रे २६:५</ref>; <ref loc="PHP 3:5">फिलि ३:५</ref></char></note><verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />नुई झाम र्‌वामी फरिसीव रे सदुकीवन घूँ सल्‌ला मदीनान रह्पा, रे मोङग भाचे रह्पा। <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />तैङर्‌वाङिन सदुकीव र्‌वानान, कि सिपालै सम्पु ग्युर्नान, स्वर्गदुत, आत्मा र्‌वानान तये मीपा। जेङ्नै फरिसीव मन पुरू ङ्यान्नान।<note caller="-" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">मत्ती २२:२३</ref>; <ref loc="MRK 12:28">मर्क १२:२८</ref>; <ref loc="LUK 20:27">लुक २०:२७</ref></char></note> <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />स्याह्‌ किम फाईरा रह्पा, रे फरिसी पातीन कान कानुन लन्नान्न सिमिव च्याङच्याङ झाम र्‌वायङ खाथू खेमः जाःबो, “अन सिमिन स्याह् ङि तये अलः मदेन्नान। यदि आत्मा आथबा स्वर्गदुतजै नू झाम र्‌वापा जेङ्न तै?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />स्याह्‌ लै सोच मदीनान रामी ख्युई पावलग छम कर्दरा र्‌वार्‌वा ङिनङिन सेनापतिजै सिपाहीकाङ्मोः पोँ वैवै नू ख्युन घूँलै हलजफत खेखे सस्सै ब्यारेकन झिङ होरायो र्‌वार्‌वा कोह्बो।<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />नाप्चे छान्जे प्रभुई नुन रह्‌म्म थाङ्थाङ् छ्युछ्यु र्‌वाबो, “हिम्मत ख्या, पावल, तैङर्‌वाङिन कुजुई नाई यरूसलेमग ङन भारेः बयान बिम्पा, उजुखेखे नाई रोमगै साँचि बिनत्वानान।”<verse eid="ACT 23:11" /></para>
  <para style="s">पावलग सच्‌चेन सदेन्त्र</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />नाप नम नाङ्मी यहूदीवजै राह्ङराङ्साः मोङ रूरू पावलग मसच्‌चेन बेर तये मझानान रे मथुङ्नान र्‌वार्‌वा रेनरुबो। <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />अन सदेन्त्र खेनान सिमिव ङेथलन खेरै ह्‌याल्म ङ्याह्। <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />अजोवजै ङोत्वा पुजारीकाङ्मोः रे अगुवावन स्याह् वैवै र्‌वाबो, “पावलग मसच्‌चेन थाल ङि तये झानान मह्‌या र्‌वार्‌वा ङ्योअजै पक्‌का रेनरुपा ङिह्पा। <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />अन्नकारन ङेनकाङ्मोः रे यहूदी जोम्पुन सिमिव दीदी सेनापती निबेदन भिना, रे नुन मुद्‌दान निर्नय हेँ लः खेखे खेत्वानान र्‌वानान बहाना दोङदोङ नू स्वा र्‌वा। आलै अन स्याह् स्वालुङ्मीम ङि नु सच्‌चेन भिह्तु तयारग छ्युङ्नान।”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />ता पावलन तिन ङोह्जोई अन सदेन्त्र हाकोको ब्यारेकन झिङ वैवै पावलग र्‌वाबो। <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />तब पावलजै सुबेदारकाङ्मोः बर्ग ती सिमि घ्वाघ्वा र्‌वाबो, “अन छबा अफिसरन ङ्याबो होरा, तैङर्‌वाङिन अन नु तयाः र्‌वाचेन सम खेँ।” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />अन्नकारन नुई नु वव्वै सेनापतिन ङ्याबो फेप्पे र्‌वाबो, “बन्दी पावलजै ङा घ्वाघ्वा अन चोलोङ्चाः नान ङ्याबो होरा र्‌वापा ङ्याह्, ना र्‌वाचेन तयाः ल्होई ङ्याह्, रु।”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />सेनापतिजै नुन लाह् जुङ्जुङ् तीक्याँ वव्वै फाक लोप्पो, “नाई ङाः र्‌वानान्न ल्होई तै जेङ्पा?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />नुई र्‌वाबो, “यहूदीवजै पावलन भारेः हेँ लः खेखे लोच्‌चे खेनान बहाना खेखे नाप्चे नु यहूदी जोम्पु सर्‌हा र्‌वार्‌वा नान ङ्याबो अनुरोध खेनान सल्‌ला खेपा ङ्याह्। <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />जेङ्नै नाई ख्युन ल्होई नङ्याना, तैङर्‌वाङिन ख्युन बर्ग ङेथल खेरै ह्‌याल्म सिमिवजै नु मसच्‌चेन बेर तये झाचे थुङ्चे मखेनान्न रेनरुरु नु सच्‌चेन भिह्तु कुकु छ्युङ्पा ङ्याह्, रे ता ख्यु नान बचन्न आस खेखे तयारग ङ्याह्।”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />अन्नकारन सेनापतिजै मन चोलोङ्चा झाःम र्‌वार्‌वा आग्या बिमबिम फेप्पो, “नाई ङा अन लोन बिम्पा ल्होई सुई नर्‌वा।”<verse eid="ACT 23:22" /></para>
  <para style="s">पावलग कैसरिया फेप्पा</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />मन्न छाम्म नुई अफिसरवन बर्ग ङे सिमि घ्वाघ्वा र्‌वाबो, “त्या छान नौ बजेरा क्याम ङेह् सिपाहीकाङ्मोः, फेराङलिथल ताः चपचप रे क्याम ङेह् दुङ जुङ्पाकाङ्मोः कैसरियाथाल वैमः तयार दोङदोङ नाना। <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />आलै पावलन भिह्तु यङ तान ब्यबस्था ख्या, रे नू सुरछित सासक फेलिक्सन स्याह् साह्।” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />नुई झाम पत्र यङ सर्पा: <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />“माननीय सासक फेलिक्सग, क्लौदियस लुसियस स्हीम ङिह्पाऊ! <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />अन सिमी यहूदीवजै जुङजुङ सह्‌म्मः जाःपा ङ्याह्, जेङ्नै अन रोमी सिमि जेअँ र्‌वानान ङाः क्युई राह्‌राह्‌ फौजन ङ्याबो स्याह् ताप्मी अनग फापा। <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />कन आरोपग ख्युई अनग दोस बिम्पा जेअँ र्‌वार्‌वा स्योःनान समजे ङै अनग ख्युन यहूदी जोम्पु सप्पा। <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />ख्युई कानुन्न प्रस्‌नन भारेः अनग दोस बिम्पा जेअँ। जेङ्नै ङै सच्‌चेन धल आथबा झ्यालखानाः काचे लैमन दोस तये मदेप्पो। <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />अन सिमिन बिरोध सदेन्त्र रातौ ङ्याह् र्‌वानान ल्होईन लोन ङा बिम्बो, रे अनग तुरुन्तै नान ङू फेप्पा ङिह्पा, रे अन्न बिरोध दोस बिन्नानकाङ्मोः र्‌वार्‌वा नान ङू बयान बिना र्‌वार्‌वा आदेस खेपा ङिह्पा।”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />अनजै आग्या देप्पा अन्सार सिपाहीवजै पावलग छानै एन्तिपात्रिसग साबो। <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />ता चप्पान सिमिकाङ्मोः नुन ङ्याबो वैमः स्याह्ई ख्योवाख्योवा घङ्न लाह् ख्यु यरूसलेम ब्यारेकक्याँई होल्बो। <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />कैसरियाग ताप्मी ख्युई सासकग हिगा बिमबिम पावलग र्‌वार्‌वा नुन ङू साबो। <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />सासकजै हिगा तोअमी नु कन प्रदेसन जेङ्पा र्‌वार्‌वा लोप्पो। नु किलिकियान जेङ्पा र्‌वार्‌वा क्युई रामी नुई र्‌वाबो, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />“ना दोस बिन्नानकाङ्मोः स्वा ताप्मी नान मुद्दा ङ्यान्नन ङ्याह्।” आलै नुई नु हेरोदजै दोङ्पा दरबारग नाह्‌ना र्‌वार्‌वा आदेस बिम्बो।<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पावलन बिरोधग मुद्दा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />ङार्यान ङिक प्रधान पुजारी हननिया रे कान ताङ्बोन अगुवाकाङ्मोः, तर्तुल्‌लस मिह्‌न्न वकिलदीन ङ्याबो कैसरीयाग स्वाबो, रे ख्युई पावलन बिरोधग सासक फेलिक्सन ङू मुद्दा पेस खेबो। <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />पावलग स्याह् सम्मी तर्तुल्‌लसजै नू झाम र्‌वायङ दोस बिम्म जाःबो, “मिह्दा माननीय फेलिक्स, नानलम ङ्योअजै किम्म किम देप्पा ङिह्पा, रे नाई अन देसन भिह्तु लै सुधारव सुरु खेपा ङ्याह्। <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />अन ल्होई हरप्रकारजै ठाउँ पुरूग ङि घूँ खेखे स्वीकार खेनान। <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />जेङ्नै नान भेला ह्‌याल्म मवव्वै ङ्योअन छ्याःफुल ङाई दया खेखे ङ्याना। <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />तैङर्‌वाङिन ङी अन सिमि खातत्त्या तूरि बिमबिम लेन्नान, सन्सारभरीन यहूदी पुरूवन घूँ आन्दोलन मच्‌चाई खेनान, रे नासरी पातीन ङोत्वा अगुवान रुपग दोपा ङ्याह्। <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />अनजै आराधनालय अपबित्र दोङ्चेन हिम्मत खेपा ङ्याह्, जेङ्नै अनग ङ्योअजै जुङ्पा। ङिन ल्हूलाम अन्सार धल बिम्पा राङिम, <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />जेङ्नै सेनापति लुसियसजै ङिन स्याह् स्वास्वा मिह्दा हलजफत खेखे नू ङिन ल्हालै तलतल वप्पो, <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />ता नजै अन्न छोए सेम्पा ङ्योअजै अनग बिम्पान दोसन अन ल्होई पुरू नुन लम क्युई रा तैनान।” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />मन यहूदीवजै र्‌वार्‌वा अन ल्होईव पुरू तेम्मा जेङ्पा र्‌वार्‌वा दीबो।<verse eid="ACT 24:9" /></para>
  <para style="s">फेलिक्सन ङू पावलजै झब बिम्पा</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />सासकजै पावलग र्‌वाचेन लाःता खेतामी पावलजै झब बिम्बो, “लै परालै ना यहूदी जातिन न्यायधीस रह्पान ल्होई क्युई राह्‌राह्‌ ङा जेँन भिह्तु ल्होई र्‌वाचे देद्‌दे स्याङ्पा ङिह्पा। <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />नाई क्युई रा तैनान कि ङा यरूसलेमग आराधना खेमः वैपा दिन च्योङे खेरे ह्‌याल्म रह्पा मया। <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />अन यहूदीव सुई ङाः दोस बिम्बो ख्युई ङाः आराधनालयग सुई ङ्याबो खाथू खेपाई छ्युङ्पा मधोबो। रे अजोवजै आराधनालयग या यहूदी आराधनालय आथबा सहरग जन्ताः बर्ग जाःजाः उल्बाङ खेफाम्पा यङ मधोबो। <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />न ता ङा हेँ दोस बिम्पा ल्होईवन अजोवजै पर्मान बिनतैनान। <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />जेङ्नै अन ल्होई चन ङा र्‌वाचे, कन मुक्ति देन्नान्न लमग ख्युई लबार र्‌वाङ, मनै लम्न ङिक जाःजाः ङा ङिन खेपुलन परमेस्वरन आराधना खेचे। जेङ्नै भबिस्यबक्तावजै सर्पान पबित्रसास्त्र रे मोसाई बिम्पान कानुन पुरु ङा बिस्वास खेचे। <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />धर्मी रे पापीव ङ्योरुम सिपालै सम्पु ग्युर्नान र्‌वानान अजोव जेँजै स्वीकार खेपालैम ङा परमेस्वरग आस नान्नान।<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दान १२:२</ref></char></note> <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />अन्नकारनजै ङा एकुरो परमेस्वर आलै सिमिवन ङू जेँन बिबेग प्रयास खेनान कन ङन बिस्वासग ल राह्‌नान।<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“ता ङाई परान ङिक जेँन सिमिन भिह्तु दान रे भोकान भेती फुल्मः ङा यरूसलेमग स्वापा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">प्रे २१:१७-२८</ref></char></note> <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />अजोवजै ङाः आराधनालयग दोतौ छाङ्म राचेन कानुन ङै पुरा खेतपा ङ्याह्, स्याह् मोङ सुई मया, फाईरा यङ मया। <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />जेङ्नै स्याह्‌ एसिया प्रदेसन कान यहूदीव ङ्याह्, ख्यु स्यीह् नान ङू स्वानान ङ्याह्। ङन बिरोध यदि तयाः र्‌वानान ल्होई राङिन ख्युई दोस बिनतैनान। <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />आथबा अन सिमिवजै नह् स्याह्‌ र्‌वाःयो, ङा किम जोम्पान ङू च्याङ्तौ ङन स्याह् दोस तये देप्पा मया? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />केबल अनै ल्होईदी मात्र जेङ्पा, कन ङै ख्युन घूँ थाङथाङ फाईरा खेखे र्‌वापा ङ्याह्, ‘सिह्पाव सम्पु ग्युर्नान र्‌वानान्न बिसयग त्या ङेन ङू ङन मुद्दा चलि रह्पाई ङ्याह्।’”<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रे २३:६</ref></char></note><verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />अन लम्न बिसयग फेलिक्सग र्‌वापालैमन ग्यान रह्पा रह्पान कारन नुई अन ल्होईव ताह्‌मी ख्युकाङ्मोः झाःम र्‌वार्‌वा तारि खेखे फेप्पो, “सेनापति लुसियस स्यीह् स्वामी ङा ङेनकोन मुद्दा फैसला खेनान ङ्यु।” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />तब नुई पावलग सेन्चे लः खेखे नाह्‌नाःयो रे नू तयाः स्वतन्त्र भिनाःयो, आलै नू त्वायाप साःनान्न फुरीकाङ्मोः चन नकाः र्‌वार्‌वा सेनान्न अफिसरग आग्या बिम्बो।<verse eid="ACT 24:23" /></para>
  <para style="s">पावल फिलिक्स रे द्रुसिल्‌लान ङू</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />खजिर्यालै फेलिक्स नुन यहूदी मिसा द्रुसिल्‌लाग ङ्याबो सस्सै स्वाबो, रे नुई पावलग घ्वाघ्वा मसिह येसुन ङ्यान बिस्वासन भारेः नुनलम ताह्बो। <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />पावलजै परमेस्वरन इच्छ्या, स्हेः र्‌याङ्म रे स्वानान्न न्यायन भारेः ल्होई र्‌वातौ फेलिक्स आत्ती रह्पा, रे झाम र्‌वाबो, “चोँ वया, मौका देप्पान भेला ङा नाः स्वा र्‌वाच्योवा।” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />पावललम कार्तौ सोह्ङ देङ्‌ङिम कि र्‌वार्‌वा आस यङ खेपा ङ्याह्। अन्नकारनजै र्‌वार्‌वा नुई ना कार्तौकार्तौ घ्वाघ्वा ल्होई र्‌वाङ।<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />जेङ्नै ङे परान ङिक जब फेलिक्सन थाउँग पर्किअस फेस्तस स्वाबो, तब फेलिक्सजै यहूदीकाङ्मोः स्याङ्फान्चेन भिह्तु पावलग ज्यालग नान्नान होई।<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">सम्रातन ङू पावलन छ्याफुल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />फेस्तस जेँन प्रदेसग स्वापा सुमङीन ङिक कैसरियालै यरूसलेमग स्वाबो। <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />ङोत्वा पुजारीव रे यहूदीवन ङोत्वा सिमिवजै पावलन बिरोधग दोस बिम्बो, <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />रे नु लमगै सच्‌चेन सदेन्त्र दोङ्दोङ पावलग यरूसलेमग सपफान्चेन दया राःयो र्‌वार्‌वा छ्याःफुल्बो। <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />जेङ्नै फेस्तसजै पावल कैसरियागै झ्यालग नाम्पा, रे नह् खम्म वैचेन सम रह्पा ल्होई र्‌वाबो। <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />नुई र्‌वाबो, “अन्नकारन ङेनकोन बर्ग अगुवाकाङ्मोः स्याह् ङन ङ्याबो कैसरियाग वयाःयो, रे मन सिमी तयाः अलः राङिन नु दोस बिना।”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />ख्युन घूँ नु केर्या-च्युर्या खेरे ह्‌याल्म मछ्युङ्‌रे कैसरिया होल्बो, रे मन्नै नाप्चेरा न्याय आसनग छ्युङछ्युङ पावलग सच्‌चेन आदेस बिम्बो। <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />पावल स्वामी यरूसलेमलै स्वापान यहूदीव नू लिब्रुङक्याँलै क्योरक्योर राँसा राँसान दोस गम्भिर बिम्बो, कन्न ख्युई पर्मान भिन मतैबो। <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />पावलजै जेँन पछेग ल्होई र्‌वायङ र्‌वाबो, “ङै यहूदीवन कानुन्न बिरोधग, आराधनालयन बिरोधग, रे कैसरन बिरोधग अपराध तये खेपा मया।”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />जेङ्नै फेस्तसजै यहूदीकाङ्मोः स्याङ्फान्चेन भिह्तु पावलग र्‌वाबो, “तै ना यरूसलेमग वैवै स्याह् ङन ङू अन ल्होईन भारेः न्याय ख्याःयो र्‌वानान्न इच्छ्या खेनौ?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />जेङ्नै पावलजै र्‌वाबो, “ङा कैसरन न्याय आसन्न ङू च्याङ्पाई छ्युङ्पा ङिह्पा, खाः ङन न्याय रात्वानान। यहूदीकाङ्मोः ङै अलः तये खेपा मया, अन ना लः खेखे क्युई ङ्याह्। <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />यदि ङा अपराधी जेङ्पा, रे ङै सिचेन धल देच्‌चेन सम स्योरस्योरलैमन धोन खेपा राङिन सोन्चेन लाह्ई ल्होई मर्‌वाचे। जेङ्नै यदि अजोवजै ङा बिम्पान दोसग तेम्मा मराङिन ङा अजोवन लाह्‌ग सुई र्‌वार्‌वा बिनमतैनान। ङा कैसरन ङ्याबो निबेदन खेचे।”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />तब फेस्तसजै सल्‌ला खेनानवन ङ्याबो सल्‌ला खेखे र्‌वाबो, “नाई कैसर ङ्याबो निबेदन खेपा, ना कैसर ङ्याबोई वैनान।”<verse eid="ACT 25:12" /></para>
  <para style="s">अग्रिपास रे बरनिकीन ङू पावल</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />खजिर्या वैतामी फेस्तसग छ्याःफुल्म झली अग्रिपास रे बरनिकी कैसरिया स्वा ताप्पो। <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />ख्यु स्याह् खजिर्या छ्युङ्मी फेस्तसजै पावलन ल्होई झलीन ङू झामखेखे स्याप्पो, “स्यीह् फेलिक्सजै झ्यालखानाः त्याःपान सिमिदी ङ्याह्, <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />सुन भारेः, ङा यरूसलेमग रातौ, ङोत्वा पुजारीव रे यहूदीवन ताङ्बोन अगुवावजै नुन बिरोधग दोस बिमबिम नु धल बिनत्वानान र्‌वार्‌वा छ्याःफुल्पा ङ्याह्।” <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />“दोस देप्पान सिमिजै दोस बिन्नान सिमिवन ङ्याबो ङू मर्हारे, रे जेँन बिरोध देप्पा दोसन भारेः र्‌वानान मौका मदेङ्‌ङिन सिमि सुई भाछ्योवा धलन आग्या बिन्नान रोमीवन ल्हूलाम मया र्‌वार्‌वा ङै ङेनकाङ्मोः झब बिम्पा। <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />जब ख्यु जोमजोम स्यीह् स्वापा, ङै पुल्म मखेरे नाप्चे न्याय आसनग छ्युङछ्युङ ना हाजिर खेफान्नान आदेस खेबो। <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />जब बैरीव च्याङ्पा ङै छुपालैम नुन मुद्‌दाग तये अलः ल्होईवन दोस ख्युई सप्मतैबो। <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />जेङ्नै ख्युन भेदभाव चन ख्युनै धर्मन भारेः रे सितपा येसुन भारेः जेअँ, सू पावलजै चन हेँ सम्पु ङ्याह् र्‌वार्‌वा दाबि खेँ। <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />अन ल्होईन भारेः ङै ता तये लोच्‌चे खेई मतैपा। उजु राह्‌राह्‌ ङै नू ‘यरूसलेम वैवै नान न्याय स्याह्ई खेन राङिम कि’ र्‌वार्‌वा लोप्पा। <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />जेङ्नै पावलजै सम्रातन फैसला मर्हान बेर झ्यालखानागै नाह्‌ना र्‌वार्‌वा निबेदन खेपा रामी नु कैसरन स्याह् मफेन्नान्न बेर लः खेखे सेन्चे ख्या र्‌वार्‌वा आदेस बिम्पा।”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />तब अग्रिपासजै फेस्तसग र्‌वाबो, “अन सिमिन ल्होई ङह् ङ्यानसुम खेनान।” आलै नुई र्‌वाबो, “नाप्चे नाई ङ्याना।”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />नाप्चे अग्रिपास रे बरनिकी मिह्दा खैकि खेखे सेनापतिव रे सहरन ङोत्वा पुजारी सिमिवन ङ्याबो जोमपू जाःबो। आलै फेस्तसन आदेस देद्दे पावलग सप्पो। <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्तसजै र्‌वाबो, “झली अग्रिपास रे ङिन ङ्याबो स्यीह् स्वापा स्योनान्न सिमि पुरू हो, यहूदी पुरूवजै ङन स्यीह् उजुरी खेपान सिमि अनै जेङ्पा। अन सिमी सह्त्त्वानान अन सोन्चेन सम स्योरस्योर लैम मह्‌या र्‌वार्‌वा यहूदी पुरूवजै यरूसलेमग रे स्यीह् कैसरियाग र्‌वार्‌वा र्‌वाङ। <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />जेङ्नै सच्‌चेन धल देत्त्वानान अनजै तये खेपा ङै मदोपा राह्‌राह्‌ रे अन जेँजै र्‌वार्‌वा सम्रातन ङ्याबो निबेदन खेपा रामी ङै अनग फेच्‌चेन निर्नय पक्‌का खेपा। <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />अन्न भारेः ङै ङन सम्रातग सर्नान ङोत्वा ल्होई तये मीपा। अन्नकारन ङै अनग ङेनकोन ङू, रे ङोत्वा खेखे, हे झली अग्रिपास, नान ङू सप्पा ङिह्पा, रे ङी अन्न छोए सेह्‌म्मी हालम ङै तये सर्चेन ल्होई देन्नान ङ्युँ। <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />तैङर्‌वाङिन झ्यालखानाः त्यापा सिमिन बिरोधग पक्‌का दोस मथनरे नू फेम्मः ङा लः लाई मराँ।”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">अग्रिपासन ङू पावल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />अग्रिपासजै पावलग र्‌वाबो, “नाः जेँन भारेः र्‌वाचेन अनुमति ङ्याह्।” तब जेँन लाह् क्याङक्याङ पावलजै जेँन सुरछ्यान भिह्तु र्‌वामः जाःबो:<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“हे झली अग्रिपास, यहूदीवजै ङा बिम्पा दोस पुरून भारेः त्या नान ङू ङै जेँग बचाई खेचेन भिह्तु ल्होई र्‌वाचे देत्तौ ङा जेँग सोरे छुनान। <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />नाः यहूदीवन ल्हूलाम पुरू रे खाथू खेनान ल्होईवन भारेः लः खेखे क्युई रह्पान कारन ङा जेँग झन भाग्यमानी छुनान। उजु राह्‌राह्‌ ता नाः छ्याःफुल्चे, ङन ल्होई स्हेः र्‌याङ्म खेखे ङ्याना।”<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“जेँन सिमिन घूँ ङन देस रे यरूसलेमग सुरुलै बिताई खेपा ङन छबा रातौलैन ङन चाल चलन यहूदीकाङ्मोः क्युई ङ्याह्। <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />लैः ङूलै ख्युकाङ्मोः क्युई रह्पानै ल्होई जेङ्पा, कि ङिन धर्मन पुरून खेरे करा पन्थी पातिन अन्सार ङै फरिसीदी राह्‌राह्‌ जिन्दगी चलाई खेपा ङिह्पा। ख्युई चाहि खेङिन अन ल्होईन साँचि भिन तैनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रे २३:६</ref>; <ref loc="PHP 3:5">फिलि ३:५</ref></char></note> <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />परमेस्वरजै ङिन खेपुलकाङ्मोः रेनरुपा ङै आस नाम्पान कारनजै त्या ङा अन मुद्दाग च्याङ्पा ङिह्पा। <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />च्योङेपाई कुल ङिन सिमिवजै अन आस देच्‌चेन भिह्तु ङिम्मेछाम्मे ती समजै परमेस्वरन आराधना खेँ, रे अन आसन पत, हे झली, यहूदीवजै ङा दोस बिम्पा ङ्याह्। <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />परमेस्वरजै न्यायग सिह्पाकाङ्मोः सम्पु ग्युर्फान्नान र्‌वानान्न ल्होईग ङेनको तैङ बिस्वास मखेनान?”<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“नासरतन येसुन मिह्‌न्न बिरोधग कारबाई लै खेत्वानान र्‌वानान ङह् र्‌वार्‌वा बिस्वास ङिह्पा,<note caller="-" style="x"><char style="xo" closed="false">26:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रे ८:३</ref>; <ref loc="ACT 22:4-5">२२:४-५</ref></char></note> <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />ङै यरूसलेमग उजुई खेपा, रे ङोत्वा पुजारीव लम आङ देद्दे लै परमेस्वरन पबित्र सिमिकाङ्मोः ङै झ्यालखानाः कपा मात्र नङ्पा, जेङ्नै ख्युकाङ्मोः सत्तौ ख्युनै बिरोधग ङै ङन भोत यङ बिम्पा। <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />आलै पुरू यहूदीवन आराधनालय ख्युकाङ्मोः घरिघरि सजाय बिमबिम ख्युकाङ्मोः बिस्वास ख्योवा फान्चेन प्रयास खेँ। ख्युन बिरोध सुतूतू खोलोःन सहरवगै ङै ख्युकाङ्मोः तेपफाम्पा।”<verse eid="ACT 26:11" /></para>
  <para style="s">पावलजै जेँन सम लःरितपा भारेः र्‌वापा</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रे ९:१-१९</ref>; <ref loc="ACT 22:6-16">२२:६-१६</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />झामखेखे ङोत्वा पुजारीकाङ्मोः लम आङ रे आग्या पत्र देद्दे ङा दमस्कसक्याँ वैपा। <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />हे झली अग्रिपास, ङिह्‌मास्यार्मी लमग ङै स्वर्गलै ङिह्‌मा खेरै साल्म ताह्‌म रङ्पा, जो ङा रे ङन ङ्याबो लेन्नानवन लिब्रुङक्याँ चम्की रह्पा ङ्याह्। <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />जब ङ्योअ पुरू सा घ्यापा ङ्याह्, तब हिब्रु ल्होईग ङा झाम र्‌वापा केह्ः ङै ताह्पा, “साऊल, साऊल, ना तैङ ङाः तेपफान्नान? छाम पेर्गाः लात्ती फ्याङ्तौ नाः र्‌वार्‌वा खङ्नान।” <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />“आलै ङै र्‌वापा, ‘हे प्रभु, ना सु जेङ्पा?’ प्रभुई ङा र्‌वाबो, ‘ङा येसू जेङ्पा, सु ना तेपफाम्बो। <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />ता च्याँ, ङा नाः ङन सेवक रे ङन साँचि बिन्नान्न सिमि दोङ्सुम ङिह्पा। अन्नकारन ङा नान स्याह् रङ्पा जेङ्पा। नाई ङन भारेः रङ्पान ल्होई रे ङै नाः ङिक थन्नान्न ल्होईव यङ घङ सिमिकाङ्मोः स्यात्त्वानान। <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />ङा ना नान जेँनै इस्राएल रे यहूदीन खोलोःन सिमि लम छुतकरा बिन्चे, सुन स्याह् ङा ना फेच्चे,<note caller="-" style="x"><char style="xo" closed="false">26:17 </char><char style="xt" closed="false"><ref loc="1CH 16:35">१ इति १६:३५</ref></char></note> <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />कि नाई ख्युन मी पोवा, रे ख्यु नाःतुमालै ज्योतिक्याँ, रे सैतान्न सक्तिलै परमेस्वरक्याँ होला। झामखेखे ख्युई तीपान माफ देन्नान ङ्याह् रे ङन ङ्यान बिस्वास लम पबित्र रह्पावन ठाउँ ख्युई र्‌वार्‌वा देन्नान ङ्याह्।’<note caller="-" style="x"><char style="xo" closed="false">26:18 </char><char style="xt" closed="false"><ref loc="DEU 33:3-4">कानुन ३३:३-४</ref>; <ref loc="ISA 35:5-6">यसै ३५:५-६</ref>; <ref loc="ISA 42:6">४२:६</ref>; <ref loc="ISA 42:16">४२:१६</ref>; <ref loc="ISA 61:1">६१:१</ref> </char></note><verse eid="ACT 26:18" /></para>
  <para style="s">पावल जेँन सेवाकाईन भारेः र्‌वापा</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“अन्नकारन, हे झली अग्रिपास, स्वर्गन दर्सन लाह्ः ङा मङ्यानङ्यान छ्युङ मतैबो। <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />जेङ्नै पहिली दमस्कसग, तब यरूसलेमग रे पुरू यहूदिया देसभरि छ्युङ्नानकाङ्मोः, रे यहूदीन खोलोःन सिमिकाङ्मोः र्‌वार्‌वा जेँन तीपालै घ्योप्पा खेखे परमेस्वरक्याँ होला रे जेँन घ्योप्पा जैनान्न धोन ख्या र्‌वार्‌वा ङै ताह्फेप्पा।<note caller="-" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">प्रे ९:२०</ref>; <ref loc="ACT 9:28-29">९:२८-२९</ref></char></note> <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />अन ल्होईवन कारन कान यहूदीवजै जब ङा आराधनालयग ङ्याह् स्या जुङ्जुङ् सच्‌चेन हिम्मत खेबो। <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />त्यान दिन्न बेर परमेस्वर लम ङै फुरी देप्पा ङिह्पा। अन कारनजै किम छ्युम ङ्योरुमग साँचि भिनैभिनै ङा स्यीह् च्याङ्पा ङिह्पा। भबिस्यबक्तावजै रे मोसाई र्‌वापा केह्ः तेम्माई पुरा राह्‌नान र्‌वानान ल्होई नङ्म ङै घङ तये र्‌वापा मया। <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />ख्युई र्‌वापा ङ्याह् कि मसिहजै तूरि हुरत्वानान, रे सिपालै सम्पु ग्युर्पा ङूस्योवा राह्‌राह्‌ नुई यहूदी रे यहूदीन खोलोःन सिमिकाङ्मोः उद्धार ताह्‌मन घोसना खेनान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="ISA 42:6">यसै ४२:६</ref>; <ref loc="ISA 49:6">४९:६</ref>; <ref loc="1CO 15:20">१ कोर १५:२०</ref></char></note><verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />पावलजै जेँन सोमफान्चेन भिह्तु अन ल्होईव र्‌वातौ फेस्तसजै केह्ः किमः र्‌वाबो, “ए पावल, ना युङ्पा जेङ्पौ, नान लै बुद्धिजै ना युङ्पा दोङ्पा ङ्याह्।”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />पावलजै र्‌वाबो, “माननीय फेस्तस, ङा युङ्पा नङ्पा, ङा लः ङिह्पा रे तेम्मान ल्होईव र्‌वानान। <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />तैङर्‌वाङिन झली जेँगै अन ल्होईन भारेः क्युई ङ्याह्, सुन ङू ङा किम्म खेखे ल्होई र्‌वायङ ङिह्पा। तैङर्‌वाङिन अन ल्होई तये नुनलम पेर्पा मह्‌या। अन ल्होई फाक र्‌वापा नङ्पा। <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />झली अग्रिपास, तै नाई भबिस्यबक्तावन लाह्ः बिस्वास खेनौ? ङा स्योःनान, नाई बिस्वास खेनान।” <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />अग्रिपासजै पावलग र्‌वाबो, “तै अकेः ङाई भेला लै ना ङा इसाहि दोङ्सुम ङिह्पाऊ?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पावलजै झब बिम्बो, “भेला ङाई रा या र्‌याङ्म ङन परमेस्वरग अन सोअताप ङिह्पा कि साँगलव नङ्म ना रे त्या ङन ल्होई ङ्यान्नान सिमि पुरू ङालैम राःयो।” <verse eid="ACT 26:29" /><verse number="30" style="v" sid="ACT 26:30" />तब झली, सासक, बरनिकी रे स्या छ्युङ्नानकाङ्मोः भरी पुरू च्याङ्बो। <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />तब ख्यु गेप्मी राह्ङराङ्साः झाम र्‌वातौ ल्होई र्‌वाबो, “अन सिमिजै सच्‌चेन धल देन्नान आथबा झ्यालखानाः वैत्वानान लैम धोन तये खेपा मया।” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />अग्रिपासजै फेस्तसग र्‌वाबो, “अनजै कैसरन ङ्याबो निबेदन खेपा राङिन ता अन सिमि ख्योवानै राह्‌नान ङ्याह्।”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पावलन रोम यात्रा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />समुन्द्रन लम राह्‌राह्‌ ङि इतालिया वैचे जेङ्पा र्‌वानान निर्नय रामी, ख्युई पावल रे घङ हातिपा झ्यालखानाः त्यापा सिमिकाङ्मोः सम्रात अगस्तस फौजन युलियस मिह्‌न्न अफिसरन लाह्‌ग बिम्पा। <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />एद्रामितेनोसलै एसिया प्रदेसन राँसा बन्दरगाहव राह्‌राह्‌ वैनान ती त्युन जहाजग चपचप ङी ल्हेम्म जाःपा। अरिस्तार्खस मिह्‌न रह्पा थेसलोनिकेन ती माकेदोनियान सिमि ङिन ङ्याबो ङ्याह्। <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />नाप्चेरा ङ्योअजै सीदोनग लङ्‌गर कपा। युलियसजै पावलग दया थनथन नुन फुरीकाङ्मोः ङ्याबो वैवै त्वापातौ फुरी खेनान्न मौका बिम्बो। <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />स्याह्‌लै ङिन त्युन जहाज ह्‌याङ समुन्द्रक्याँ जाःबो, जेङ्नै त्युन जहाजन ङूक्याँलै लन च्याङ्पान कारन ङि साइप्रस तापुन नाःलम काईकाई वैत्वाबो। <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />किलिकिया रे पामफिलिया धिक्याँन समुन्द्रग ताप्मी, ङ्योअग लुकियान ती सहर माइरा सहरग स्वा ताप्पा। <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />स्याह् इतालिया वैनान अलेक्जेन्द्रियान त्युन जहाजदी दोदो अफिसरजै ङी मनग चपफाम्बो। <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />लै दिनथाल कोलेः कोलेः वैवै धौखेखे क्नीदसग स्वा ताप्पा रे लनजे हेँ ङू वैमफाम्मी क्रेतन च्योरच्योर ङ्योअग सालमोनेन ना-ना राह्‌राह्‌ वैपा। <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />धौखेखे मन्न ना-ना जाःजाः ङ्योअग सुन्दर बन्दरगाह र्‌वानान ठाउँग स्वापा। स्याह्‌लै लासिया सहर ङेमः ङ्याह्। <verse eid="ACT 27:8" /><verse number="9" style="v" sid="ACT 27:9" />स्याह् ताप्चेन भिह्तु भेला लै वैपा ङ्याह्। बर्त छ्युङ्नान्न तीती लाह्ः यङ वैतपा ङ्याह् रे मन रुन्जेन भेलाः स्वापान छ्योलापवन कारन ता त्युन जहाजलम ङू वैचे ङिन्चे ङ्याह्। उजु राह्‌राह्‌ पावलजै जेँग कूनान्न सिमिकाङ्मोः झाम र्‌वाईर्‌वाई सम्झाई खेबो, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“फुरीव हो, ङि चोँ त्युन जहाजलम स्यीह्‌लै वैङिन जहाज रे अनग ङिह्पान आलमाल मात्र नङ्पा, जेङ्नै ङी सिह्दरा र्‌वार्‌वा ङिन्चे ङ्याह्।” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />जेङ्नै अफिसरजै पावलन ल्होईवग नङ्पा जेङ्नै त्युन जहाजन कुल्नान्न सिमि रे त्युन जहाजन तापोन ल्होई ह्‌याल्म हीछेःबो। <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />रुन्जेन भेला बिताई खेमः मन बन्दरगाह लः यङ मह्‌या। उजु रातौ हातिपा सिमिव तै खेखेई स्याह्‌लै वैवै फोनिक्स सहर ताप्चेन कोसिसग ङ्याह्। क्रेत तापू रह्पान मन फोनिक्स सहरग चन ज्याङ-ल्हो रे नुह्प ल्होक्याँ होल्पान बन्दरगाह ङ्याह्।<verse eid="ACT 27:12" /></para>
  <para style="s">समुन्द्रग हुर्‌यापा</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />जब ज्याङन लन कोलेः कोलेः स्वामः जाःबो। ख्युन उदेस्य ल रह्पा र्‌वानान छुछु, लङ्‌गर छ्युछ्यु ख्यु क्रेतन ना-ना रातौ यात्रा खेमः जाःबो। <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />जेङ्नै ङाइलै मन तापुलै ङिनङिनलैम हुर्‌यापा तोबग नुह्प-स्यारग लन किम स्वाबो। <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />जब त्युन जहाज हुर्यापाई च्योर्बो, मह्‌नजै हुर्यापाः सामना खे मतैबो, रे ङी मनग खाः वैनै वयाःयो र्‌वार्‌वा ख्योवापा। <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />क्लौदा र्‌वानान्न तापुन ज्याङक्याँ ताप्मी तापुई लनग ङाई काःबो। जेङ्नै स्याह् रे ङी त्युन जहाजन ङिक खीपान कत्याम दोङाः धौखेखे जगाई खेतैपा। <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />ख्युई मनग त्युन जहाजग कान्बो जहाजग थाःपाई खीबो। लिबियान सिरितिस र्‌वानान्न पेह्‌मान नाः छार्ङिम कि र्‌वार्‌वा ख्यु ङिह्‌म्बो, अन्नकारन ख्युई पाल पोँ साःबो रे त्युन जहाजग लनजै फ्याफाम्बो। <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />ता हुर्यापाई ङ्योअकाङ्मोः यामयाम सोल्म रे दिम्फाम्म जाःबो, रे नाप्चे ख्युई त्युन जहाजन आलमाल पह्‌म्म जाःबो। <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />आलै सुमङी ख्युई जेँनै लाह्जै त्युन जहाजन लत्ठा पप्पो। <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />लै दिनथाल ङिह्‌मा, घर तये रङ्चे मदेप्पो। लन किम च्याङ्पाच्याङ्त्वा राह्‌राह्‌ अन्त्यग सोन्चेन आस यङ ङ्योअजै ख्योवापा।<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />लै दिनथाल ख्यु मझारे छ्युङ्पा ङ्याह्। तब पावलजै ख्युन ङ्याबो स्वास्वा र्‌वाबो, “फुरी हो, ङेनजै ङन सल्‌ला ङ्यानङ्यान क्रेतलै त्युन जहाज मकुल्चे ङ्याह्, रे झाम तूरि रे नोङ ङेनजै कुत्वानान मह्‌या। <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />जेङ्नै चोँ ङा ङेनकाङ्मोः छ्याफुल्चे, हिम्मत ख्या। ङेनकोन बर्ग सुई यङ सिह्‌नान मह्‌या, जेङ्नै त्युन जहाज मीपा राह्‌नान ङ्याह्। <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />तैङर्‌वाङिन कन परमेस्वरन सिमि ङा जेङ्पा, रे सुन आराधना ङा खेनान, नुन दुतदी थ्याँ छान ङन रह्‌म्म च्याङ्बो। <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />नुई ङा र्‌वाबो, ‘पावल, नङिना, ना कैसरन ङू तेम्मा च्याङ्चे जेङ्पा, रे सेह्‌ना, नान ङ्याबो त्युन जहाजग चप्नान भरी पुरून परान परमेस्वरजै नान लाह्‌ग बिम्पा ङ्याह्।’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />अन्नकारन फुरी हो, हिम्मत ख्या। ङा परमेस्वरग बिस्वासन, ङा कुजु र्‌वापा ङ्याह्, ठिक्‌क मनलैम राह्‌नान ङ्याह्। <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />जेङ्नै ङ्योअ चन कान तापुदीग ठ्वात्वानान ङ्याह्।”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />जेङ्नै जब छान च्युल्‌लि रह्पा ङ्याह्, रे ङ्योअ एद्रियास समुन्द्रग हुत्ति रह्पा ङ्याह्, तब छानफेरा दोङा कुल्नानवजै ङ्योअग कान सान रह्‌म्म स्वातपा ङ्याह् र्‌वानान छोई खेबो, <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />रे तिङ नापी खेखे सेन्तौ ख्युई मितर ङेथल क्युई रह्पा, रे ङाइ धेरा वैवै ह्‌याङ तिङ नापी खेखे सेन्तौ ख्युई सुमच्यु मितर हाकोबो। <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />आलै कान लुङ्न लाह्ः फ्याङ ताप्नान कि र्‌वानान ङिनङिन, ख्युई त्युन जहाजन ङीक्याँलै लङ्‌गर ली पप्पो रे नाप रायो र्‌वार्‌वा सोअताप्मः जाःबो। <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />जब नावीकाङ्मोः त्युन जहाजलै ज्यार्मः जाःपा ङ्याह्, रे ङूक्याँ लङ्‌गर पच्‌चेन बहानाजै दोङा समुन्द्रग साःतपा ङ्याह्, <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />तब पावलजै अफिसर रे सिपाहीकाङ्मोः र्‌वाबो, “अन सिमिकाङ्मोः त्युन जहाजग मछ्युङ्‌ङिन ङेनकाङ्मोः सोन्नान मह्‌या।” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />तब सिपाहीवजै दोङान थाःपाभरी थुम्बो, रे दोङाः वैफाम्बो।<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />नम नाङ्मः जाःमी पावलजै सिमिकाङ्मोः “तयाः झाई त्वानान” र्‌वानान्न सल्‌ला भिनैभिनै र्‌वाबो, “ङेन छरान कारन झाई मझारे छ्युङ्पा च्युल्‌लिर्या रा तदँ। <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />अन्नकारन तयाः झा र्‌वार्‌वा ङा ङेनकाङ्मोः छ्याःफुल्चे। तयाः झाङिन ङेन सोन्नान ङ्याह्।” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />अन ल्होई र्‌वामी नुई रोता झबो, रे पुरून ङू परमेस्वरग धन्यवाद फुलफुल अन क्युक्क्युई झाम जाःबो। <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />तब ख्यु पुरूजै हौसला देद्दे तयाः झायाप झबो। <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />त्युन जहाजग ङिह्पा ङ्योअ पुरू क्याम ङेह् रै फेराङलिथल रे रु सिमि ङ्याह्। <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />ख्युई बरङबरङ झामी, त्युन जहाज भोङ्म दोङ्म समुन्द्रग रुन्जन पप्पो।<verse eid="ACT 27:38" /></para>
  <para style="s">त्युन जहाज मीपा रह्पा</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />नाह्प रामी ख्युई समुन्द्रन कान नाः रङ्बो, जेङ्नै त्युन जहाज कुल्नानवजै मन थाउँ स्योः मतैबो। नाः थाउँ सम्म रङरङ ख्युई त्युन जहाजग स्याह्ई वच्‌चेन नावा खेबो। <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />ख्युई लङ्‌गरव साःबो, रे मन समुन्द्रगै लुईफाम्बो। मन्नै भेला पतवारकाङ्मोः खीपान रूव फोल्बो। ङूक्याँन पाल सोलसोल लनक्याँ होल्बो रे त्युन जहाजग नाक्याँ वप्पो। <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />जेङ्नै त्युन पोँ पेर्पा पेह्‌मान रासो त्युन जहाज ठ्वाठ्वा स्याह्ई मीपा रह्बो, त्युन जहाजन ङूस्योवान भाग खल्बो रे गुलै मतैबो, आलै ङीस्योवान भाग चन छ्योलापवन तोपजै क्युप्मः जाःबो।<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />झ्यालखानाः त्यापा सिमिकाङ्मोः पौरी फ्याङफ्याङ ज्यार्दरा कि र्‌वार्‌वा छुछु सिपाहीवजै ख्युकाङ्मोः सच्‌चेन सम खेबो। <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />जेङ्नै अफिसरजै पावलग सोमफान्सुम खेखे ख्युकाङ्मोः उजु खे मफाम्बो। पौरी फ्याङ तैनान पुरू त्युन जहाजलै पहिली बोरबोर नाः स्वा र्‌वानान आदेस नुई बिम्बो, <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />लाःमा रह्पाकाङ्मोः चन पाँलेपवग रे त्युन जहाजन तुकरावग धेँ वैचे र्‌वाबो। झामखेखे पुरू सुरछित नाः ताप्पो।<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">पावल माल्ता तापू</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />ङि सुरछित नाः स्वामी मन तापुन मिह्‌न माल्ता जेअँ र्‌वानान ङी क्युई ङिह्पा। <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />स्याह् छ्युङ्नानवजै ङी सार्बा दया थम्पा। नाङ्‌का ज्युज्यु ख्यारि रह्पान कारनजै ख्युई मेह् भुबो, रे ङि पुरूग स्वागत खेबो। <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />पावलजै सिङ पाह्दी चाह्चाह् मेह्ग पह्‌न्तौ भुलेनदी मेह् छामन कारन नुन लाह्‌ग कह्बो।<verse eid="ACT 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 28:4" />स्याह् छ्युङ्नान्न सिमिवजै नुन ल्हाग भुलेन च्योम्पा रङरङ राह्ङराङ्साः र्‌वामः जाःबो, “अन सिमि तेम्माई सिमि सन्नान्न सिमि राईत्वानान। अन समुन्द्रलै सोनसोन ता गेप्पो जेङ्नै न्यायलम अन सोम मतैबो।” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />जेङ्नै पावलजै जेँन ल्हा खार्तौ भुलेन स्वात्तै मेह्ग छार्बो। <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />स्याह्‌न सिमिवजै “पावल ङाईलै रङरङ सिह्‌नान ङ्याह्” र्‌वार्‌वा सेम्पाई छ्युङ्बो। आथबा नु घ्याघ्या सिदँ र्‌वार्‌वा ख्युई कुकु छ्युङ्मः जाःबो। जेङ्नै लैःलै यङ नू तये मरह्पा। अन रङरङ ख्युन नावा फिप्पो। रे हालाईलाई ख्युई र्‌वाबो, “अन ता पो जेअँ।”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />मन तापुन पब्लियस मिह्‌न्न ङोत्वा पुजारीन खेः मन ठाउँन रह्‌म्मै ङ्याह्। नुई ङी जेँन यिम वव्वै स्वागत खेबो, ङि सुमङी नुन यिम दम्फु राह्‌राह्‌ छ्युङ्पा। <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />पब्लियसन पा छायोई रे आउँन नाजाइ खङ्पा ङ्याह्। पावल नु सेम्म होई, रे नुन पत सोअताप्पो, रे जेँन लाह् नुन लाह्ः नान्नान नुग सिमि दोङ्पा। <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />झामखेखे ताःपा क्युई राह्‌राह् तापू ङिह्पान खङ्नान पुरूव स्वाबो रे पावलजै ख्युकाङ्मोः ताःफाम्बो। <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />ख्युई लै प्रकारजै ङ्योअन सम्मान खेबो। जब ङ्योअ त्युन जहाजग चप्पा, ख्युई ङ्योअग त्वातौ आलमालव त्युन जहाजग कह्बो।<verse eid="ACT 28:10" /></para>
  <para style="s">माल्ता तापुलै रोमथाल</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />लाह्‌ सुमङीन ङिक छामा ला र्‌वानान्न त्युन जहाजग चपचप माल्ता तापू ख्योवाख्योवा वैपा। मन त्युन जहाज चन अलेक्जेन्द्रिया सहरलै स्वास्वा गुन्जेन भेलाभरि माल्ता तापुगै कुकु छ्युङ्पा ङिम्न। <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />सुराकुसाईग ताप्‌ताप्‌ ङि स्या सुमङी छ्युङ्पा। <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />स्याह्‌लै ङि ना-नाः रेगियन सहरग स्वा ताप्पा। तीँन ङिक ज्याङन लन स्वाबो, रे नाप्चे ङि पतिओलिग स्वा ताप्पा। <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />स्या ङ्योअजै भाइकाङ्मोः धोबो, रे ख्युई ङ्योअग नेर्याथाल ख्युन ङ्याबो छ्युङ्चेन भिह्तु छ्याःफुल्बो। झामखेखे ङ्योअग रोमग स्वा ताप्पा। <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />स्याह्‌लै ङि स्वानान र्‌वानान्न ल्होन ताह्ताह रोमन बिस्वासी थिक्‌कोव ङी धोमः अप्पियसन बजार रे तीन पाती र्‌वापू स्वापा ङ्याह्। अजोवग रङरङ पावलजै परमेस्वरग मया रह्बो र्‌वाबो, रे हौसला देप्पो।<verse eid="ACT 28:15" /></para>
  <para style="s">रोमग पावल</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />मन्न छाम्म ङि रोमग वैपा, रे स्याह् पावलग तितिमाई छ्युङ्फाम्बो। जेङ्नै नू सेन्चे खेचेन भिह्तु सिपाहीदी छ्युङ्बो।<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />सुमङीन ङिक पावलजै यहूदीवन बासिन्दा लम ल थन्नान सिमिकाङ्मोः घ्वाम फेप्पा। ख्यु जमता रामी नुई ख्युकाङ्मोः र्‌वाबो, “इस्राएली जिङ्‌को हो, ङै ता जेँन देसन सिमिकाङ्मोः, आथबा खेपुलन ल्हूलामन बिरोध तये खेपा मया। जेङ्नै बन्दी राह्‌राह्‌ यरूसलेमलै रोमीवन लाह्‌ग ङा बिम्पा ङ्याह्। <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />ख्युई छोए सेह्‌म्मी ङन स्याह् सच्‌चेन धलन कारन तये मदोतौ ङा फेस्सुम खेपा ङ्याह्। <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />जेङ्नै यहूदीवजै बिरोध खेपा रामी कैसरन स्याह् निबेदन खेमः ङा धिप्पी खेबो: ङन सिमिन बिरोध तैनै दोस सच्‌चेन ल्होई मया।<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">प्रे २५:११</ref></char></note> <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />अन्नकारनजै ङै ङेनकाङ्मोः ङ्याबो दोदो ल्होई खेमः ङेनकाङ्मोः घ्वापा जेङ्पा। तैङर्‌वाङिन इस्राएलन आस सु जेङ्पा नुन पत अन साँगलग ङा खीपा ङिह्पा।”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />ख्युई नू र्‌वाबो, “ङ्योअजै ता नान भारेः यहूदिया प्रदेसलै हिगा तये देप्पा मया। कान ङिन सिमिव स्वास्वा नान बिरोध तये अलः ल्होई यङ ङ्याम्पा रे र्‌वापा मह्‌या। <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />जेङ्नै ङि नान सोचव ङ्यान्सुम ङिह्पा। तैङर्‌वाङिन नान मोङन बिरोधग खास्यापुरू रह्पान ल्होई चन ङी क्युई ङिह्पा।”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />तब ख्युई पावलन भिह्तु लाह्दी तोकि खेबो, रे ताँका लैग सिमिव नुन छ्युङ्पू स्वाबो। नुई ख्युकाङ्मोः नाह्पलै ङ्याजेनै बेर चर्चा खेबो, रे मोसान कानुन रे भबिस्यबक्तावन किताबलै परमेस्वरन राज्यन साँचि बिम्बो, आलै येसुन भारेः ख्युकाङ्मोः बिस्वास देप्फान्चेन प्रयास खेबो। <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />नुई र्‌वापान ल्होई हातिपाई बिस्वास खेबो, हातिपाई बिस्वास मखेबो। <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />ख्यु राह्ङराङ्साः मदीबो, रे भिदा राम जातौ पावलजै अन अन्त्यन भासन बिम्बो, “ङेन खेपुलग यसैया भबिस्यबक्ता लम पबित्र आत्माई र्‌वापान बचन लः ङ्याह्,”<verse eid="ACT 28:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="ACT 28:26" />“अन सिमिकाङ्मोः ङ्याबो वैवै र्‌वा,</para>
  <para style="q1" vid="ACT 28:26">‘ङ्याना ता ङेनकाङ्मोः ङ्यान्नन, जेङ्नै हातौयै मस्योनन,</para>
  <para style="q2" vid="ACT 28:26">सेन्चे ता सेन्नन, जेङ्नै हातौयै मरङ्नन।’”<note caller="-" style="x"><char style="xo" closed="false">28:26 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यसै ६:९-१०</ref></char></note><verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />तैङर्‌वाङिन मन सिमिवन सम हरक्‌क हामकोनान रह्पा ङ्याह्,</para>
  <para style="q2" vid="ACT 28:27">रे ख्युई जेँन नाम्ज्योवा काःपा ङ्याह्,</para>
  <para style="q2" vid="ACT 28:27">मी चुम्पा ङ्याह्,</para>
  <para style="q2" vid="ACT 28:27">तेमन्ता ख्युन मीजै रङ्नान ङ्याह्।</para>
  <para style="q1" vid="ACT 28:27">नाम्ज्योवाजै ताह्‌नान ङ्याह्,</para>
  <para style="q2" vid="ACT 28:27">समजै हाकोनान ङ्याह्,</para>
  <para style="q2" vid="ACT 28:27">रे ङाक्याँ होल्नान ङ्याह्, रे परमेस्वरजै र्‌वाबो,</para>
  <para style="q2" vid="ACT 28:27">“आलै ङा ख्युकाङ्मोः ताःफान्नान ङ्याह्!”<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />अन्नकारन “ङेनकाङ्मोः क्युई रायो, कि परमेस्वरन अन मुक्ति यहूदीन खोलोःन सिमिवन पत फेप्पा ङिह्पा, रे ख्युई ताह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">28:28 </char><char style="xt" closed="false"><ref loc="PSA 67:2">भजन ६७:२</ref>; <ref loc="PSA 98:3">९८:३</ref>; <ref loc="ISA 40:5">यसै ४०:५</ref> </char></note> [<verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />आलै नुई अन बचन र्‌वामी, यहूदीकाङ्मोः राह्ङराङ्साः लै खाथू खेतौ होई।]<note caller="-" style="x"><char style="xo" closed="false">28:29 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यसै ६:९-१०</ref></char></note><verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />पावल पुरू ङेह्परा थाल जेँनै खर्चग रोमग छ्युङ्बो, रे नुन ङ्याबो स्वानानकाङ्मोः पुरूग नुई स्वागत खेबो। <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />नुई सहासी राह्‌राह्‌ परमेस्वरन राज्यन ताह्फेरैफेरै प्रभु येसु मसिहन भारेः लह्ङ्‌ङ रे सुई र्‌वार्‌वा मकाँ।<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>