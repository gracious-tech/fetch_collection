<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">MAT-KAIKE Standard Traslation</book>
  <para style="toc3">मत्ती</para>
  <para style="toc2">मत्ती</para>
  <para style="toc1">मत्तीजै सर्पान ल्होन लः</para>
  <para style="mt2">मत्तीले लेखेको सुसमाचार</para>
  <para style="mt1">मत्तीजै सर्पान ल्होन लः</para>
  <para style="imt">किताबन स्योःचे</para>
  <para style="ip">मत्तीन अन्सार ल्होन् लः निम सार्बान किताबव लीन बर्ग ती जेङ्पा कनजै येसु मसिहन बर्नन खेँ। मन पुरूग “ल्होन् लः” र्‌वाङ, कन्न अर्थ “ल्होन् लः” जेङ्पा। मन किताबव येसु सिमी मत्ती, मर्कूस, लुका रे यूहन्नालम सर्पा ङ्याह्। बिद्‌वानकाङ्मोः मत्तीन अन्सार ल्होन् लः हातौ सर्पा ङ्याह् र्‌वानान ठिक्‌क मिति क्युई मह्‌या, जेङ्नै अन मसिह केह्पान हालम 60 परान ङिकन ल्होई जेम कि। ङ्याबो, अन खाः सर्पा ङ्याह् र्‌वानान्न ठाउँ क्युई मह्‌या, जेङ्नै लैजै छोए खेँ कि अन प्यालेस्ताइनग रे हालम यरूसलेम सहरग र्‌वार्‌वा सर्पा ङ्याह्।</para>
  <para style="ip">अन किताबग सर्नान्न सिमि मत्ती जेङ्पा, सु येसुई जेँन चेला रा र्‌वाचेन खेरे ङू कर तुईनान्न सिमि ङ्याह्। नु लेवीन मिह्‌नजै र्‌वार्‌वा स्योःङ। मत्ती प्रेरित च्योङेपावन बर्ग ती ङ्याह् रे नुई यहूदी तोअनानवन भिह्तु सर्पा ङ्याह्। निम घ्वापान पबित्रसास्त्रन 60 खेरे ह्‌याल्म सर्पान ल्होईवलम अन लः खेखे रङ तैनान। नुई येसु मसिह, परमेस्वरजै दम्पान मुक्तिदाता ङ्याह् र्‌वार्‌वा थनसुम खेँ, कन्न भारेः भबिस्यबानी खेपा ङ्याह्। मत्तीजै र्‌वार्‌वा राज्यन भारेः लैः सर्बो। यहूदीवजै मसीह राजनितिक राज्यन झली राह्‌नान्न इच्छ्या खेपा ङ्याह्। मत्तीजै परमेस्वरन आत्मिक राज्यन बर्नन खेखे मन बिस्वासग ङू वैफाम्मः लैः होसियार रा।</para>
  <para style="ip">मत्तीन अन्सार ल्होन् लः निम सार्बा सुरु खेचेन भिह्तु किताब लः जेङ्पा। तैङर्‌वाङिन अन्न सर्पान ल्होई पुरूव निम घ्वापाग ङ्याह्। अनजै निम ङेह्‌वग थुप्ङ। बिद्‌वानवजै अन र्‌वार्‌वा सल्‌ला बिम्पा ङ्याह् कि मत्तीजै मोसान किताबवन आकारन मीलुप सेनसेन उजुई खे फाप्पा जेम्तौ, कन निम घ्वापान ङूस्योवान किताबव ङा जेङ्पा। येसुन धुरग खाईकोए <char style="xt"><ref loc="MAT 5-7">५—७</ref></char> ग परमेस्वरजै मोसाः कानुन बिम्पान ङ्याबो थुत्तैनान। <char style="xt"><ref loc="DEU 19:3">कानुन १९:३</ref>; <ref loc="DEU 23:3">२३:३</ref></char></para>
  <para style="iot">सुची</para>
  <para style="io1">मत्तीजै अध्याय <char style="ior"><ref loc="MAT 1-4">१—४</ref></char> ग येसु मसिह केह्पा रे नुन सेवाकाईन सुरुवातन भारेः र्‌वाईर्‌वाई ल्होन् लः सुरु खेँ।</para>
  <para style="io1">घङ मत्तीजै अध्याय <char style="ior"><ref loc="MAT 5:25">५:२५</ref></char> ग येसुन सेवाकाई रे नुन लैः छोएवन बर्नन खेँ।</para>
  <para style="io1">मत्तीन अन्तिम खन्द येसु सिचे रे ह्‌याङ सम्पु ग्युर्चेन ल्होई नुन सेवाकाईन सिखरन भारेः जेङ्पा। <char style="ior"><ref loc="MAT 26-28">२६—२८</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">येसु मसिहन खेपुलव</para>
  <para style="r">(<ref loc="LUK 3:23-38">लुक ३:२३-३८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />अन दाऊद रे अब्राहामन सन्तान येसु मसिहन खेपुलवन सुची जेङ्पा। <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />अब्राहाम इसहाकन पा ङ्याह्। इसहाक याकूबन पा ङ्याह्, याकूब यहूदा रे नुन थिक्‌कोवन पा ङ्याह्, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />यहूदा फारेस रे जाहेरन पा ङ्याह्, ख्युन मा तामार ङ्याह्। फारेसन ङोह्जो हेस्रोन, हेस्रोन्न ङोह्जो आराम, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />आराम अम्मीनादाबन पा, अम्मीनादाब नहसोन्न पा, नहसोन सल्मोन्न पा,<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="RUT 4:19-22">रूथ ४:१९-२२</ref> </char></note> <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />सल्मोन बोअजन पा ङ्याह्। नुन मा राहाब ङ्याह्। बोअज ओबेदन पा ङ्याह्। नुन मा रुथ ङ्याह्। आबेद यिसैन पा, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />यिसै दाऊद झलीन पा ङ्याह्। दाऊद सोलोमन्न पा ङ्याह्। सोलोमन्न मा उरियाहन मिसा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2SA 12:24">२ सामू १२:२४</ref></char></note> <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />सोलोमन रहबामन पा, रहबाम अबियान पा, अबिया आसान पा, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />आसा यहोसापातन पा, यहोसापात यहोरामन पा, यहोराम उज्जियाहन पा, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />उज्जियाह योतामन पा, योताम आहाजन पा, आहाज हिजकियान पा, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />हिजकिया मनस्सेन पा, मनस्से अमोन्न पा, अमोन योसियाहन पा, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />योसियाह यकोनियास रे नुन भाइवन पा ङ्याह्। ख्यु बेबिलोनग यहूदीकाङ्मोः बन्दी दोङदोङ वप्पो मन्नै भेला केह्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="JER 27:20">यर २७:२०</ref></char></note> <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />बेबिलोनग भन्दि दोङदोङ वप्मी: यकोनियास सालतिएलन पा ङ्याह्, सालतिएल यरुबाबेलन पा, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />यरुबाबेल अबिउदन पा, अबिउद एल्याकिमन पा, एल्याकीम आजोरन पा, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />आजोर सादोकन पा, सादोक आखिमन पा, आखिम एलिउदन पा, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />एलिउद एलाजारन पा, एलाजार मत्तान्न पा, मत्तान याकूबन पा ङ्याह्। <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />याकूब मनै योसेफन पा ङ्याह्, सुन मिसा मरियम ङ्याह्। अन्नै मरियमलम येसु केह्बो, सू मसिह र्‌वानान। <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />झामखेखे अब्राहामलै दाऊदथाल पुस्ता च्युल्‌लि, दाऊदलै बेबिलोनग बन्दी दोङदोङ साःनान्न भेला बेर पुस्ता च्युल्‌लि, रे बेबिलोनग बन्दी दोङदोङ साःनान्न भेलालै मसिहन भेला बेर पुस्ता च्युल्‌लि रह्पा।<verse eid="MAT 1:17" /></para>
  <para style="s">येसु मसिह केह्पा</para>
  <para style="r">(<ref loc="LUK 2:1-7">लुक २:१-७</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />येसु मसिह झामखेखे केह्बो: नुन मा मरियमग योसेफन तोल्पा ङ्याह्, जेङ्नै ख्युन मिह्जी मराह्‌रेई मरियम पबित्र आत्मालम फौरिमा रह्पा क्युई रह्बो। <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />जेङ्नै नुन पसा योसेफ धार्मिक सिमि रह्पान कारन, नू ब्याफास्सुम मखेरे नू तै मर्‌वारे ख्योवासुम खेबो। <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />जेङ्नै जब नुई अन ल्होई नावा खेईखेई छ्युङ्पा ङ्याह्, मङग परमप्रभुन दुत रङबो, रे नू झाःम र्‌वाबो, “योसेफ, दाऊदन ङोह्जो, मरियमग जेँन मिसान रुपग यिम वच्‌चे नङिना, तैङर्‌वाङिन सु नुन फौग ङ्याह्, नु पबित्र आत्मालम जेङ्पा। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />नुई ङोह्जोदी केह्‌नान ङ्याह्, रे नाई नुन मिह्‌न येसु नाह्‌नाःयो, तैङर्‌वाङिन नुई जेँन सिमिकाङ्मोः ख्युन तीपालै बचाई खेनान ङ्याह्।” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />भबिस्यबक्तालम परमप्रभुई र्‌वापान बचन पुरा राचेन भिह्तुई अन पुरू रह्पा जेङ्पा:<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यसै ७:१४</ref></char></note> <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“सेह्‌ना, कन्या फौरिमा राह्‌नान ङ्याह्, रे नुई ङोह्जोदी केह्‌नान ङ्याह्, रे नुन मिह्‌न इम्मानुएल नान्नान ङ्याह्,” कन्न अर्थ जेङ्पा, “परमेस्वर ङिन ङ्याबो।”<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यसै ७:१४</ref></char></note> <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />योसेफ मिवालै साप्पो, रे परमप्रभुन दुतजै र्‌वापालैम नुई मरियमग जेँन मिसान रुपग स्वीकार खेखे यिम वप्पो। <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />मरियमजै ङोह्जो मकेह्‌न बेर योसेफ नुन ङ्याबो मआःबो। योसेफजै नुन मिह्‌न येसु नाह्‌म्बो।<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">येसू धोमः जोतिसिव स्यारलै स्वापा</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />हेरोद झलीन पाली यहूदिया प्रदेसन बेथलेहेम सहरग जब येसु केह्बो, स्यारन देसलै जोतिसिव यरूसलेमग स्वा ताप्पो। <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />आलै ख्युई लोप्पो, “यहूदियान झली राह्‌राह्‌ केह्‌नान्न सिमि खाः ङ्याह्? तैङर्‌वाङिन ङी नुन घर स्यारग रङ्पा रे नू ध्वाः खेमः स्वापा ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="NUM 24:17">गन्ती २४:१७</ref></char></note><verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />जब हेरोद झलीजै अन ताह्बो, नु उदास रह्बो, रे नुन ङ्याबो सोलोः यरूसलेम यङ उदास रह्बो। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />आलै नुई ङोत्वा पुजारी पुरूव रे जनताः कानुन लन्नान्न सिमिकाङ्मोः रूबो, रे “मसिह खाः केह्‌नान जेम?” र्‌वार्‌वा लोच्‌चे खेबो। <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />ख्युई झब बिम्बो, “यहूदियान बेथलेहेम सहरग। तैङर्‌वाङिन भबिस्यबक्ताई अन्न भारेः सर्पा ङ्याह्: <verse eid="MAT 2:5" /><verse number="6" style="v" sid="MAT 2:6" />‘ए बेथलेहेम, यहूदिया मुलुकन सहरव, ना तै खेखेई यहूदान सासकवन घूँ सुई खेरै फान मत्वानान मह्‌या, तैङर्‌वाङिन नान स्याह्‌लै सासकदी गेग्गे स्वानान ङ्याह्, सुई ङन सिमि, इस्राएलग सेन्चे खेनान ङ्याह्’।” <verse eid="MAT 2:6" /><verse number="7" style="v" sid="MAT 2:7" />तब हेरोदजै मन स्यारन जोतिसिकाङ्मोः तै मर्‌वारे स्वा र्‌वार्‌वा घर ठिक्‌क कन्न भेला रङ्पा जेङ्पा, र्‌वानान्न ल्होई ख्युनलम क्युई रह्बो। <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />नुई ख्युकाङ्मोः झाःम र्‌वार्‌वा बेथलेहेम सहरग फेप्पो, “वया, रे लः खेखे मन वैचाः फारा। नू धोमी ङाः ताह्फेरा, रे ङा रे नू ध्वाः खेनान ङ्युँ।” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />तब झलीन ल्होई ताह्ताह् ख्यु जेँन लमग होई। कन घर ख्युई स्यारग रङ्पा ङ्याह्, मन घर ख्युन ङूह्ङूह् होई, रे वैचा रह्पू ताप्मी मन घर स्याह्ई खल्बो। <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />ख्युई मन घर रङरङ यामयाम स्याङ्बो।<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="LUK 2:20">लुक २:२०</ref> </char></note> <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />आलै यिमन झिङ जाःजाः ख्युई वैचाः नुन मा मरियमन ङ्याबो रङ्बो, रे खल्बू क्यापक्याप नू ध्वाः खेबो। तब जेँन बकाःस पोङपोङ नू मर, रिह् स्यामन प्वे रे मूर्रन भेति फुल्बो। <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />आलै हेरोदन स्याह् होलहोल नवया र्‌वानान मङग चेतावनी देद्‌दे ख्यु घङै लम राह्‌राह्‌ जेँन देसग होल्बो।<verse eid="MAT 2:12" /></para>
  <para style="s">मिस्र देसग वैपा</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />मन जोतिसिव वैमी, परमप्रभुन दुतदी मङग योसेफन स्याह् रङ्बो रे नुई झाम र्‌वाबो, “च्याँ, कत्याम वैचा रे नुन माः ङ्याबो वव्वै मिस्र देसग वया, रे नाः ङै मर्‌वान बेर स्याह्ई छ्योवा। तैङर्‌वाङिन, हेरोदजै वैचाः सच्‌चे र्‌वार्‌वा नू फाच्‌चे खेमः जाःपा ङ्याह्।” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />आलै नु च्याङच्याङ वैचा कत्याम रे नुन माः ङ्याबो वव्वै मिस्र देसग मनै छानजे होई, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />रे हेरोद मह्‌सिन बेर स्याह्ई छ्युङ्बो। भबिस्यबक्तालम परमप्रभुई र्‌वापान बचन झामखेखे पुरा रह्बो, “ङै जेँन ङोह्जोः मिस्र देसलै स्वा र्‌वापा।”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">होसे ११:१</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">हेरोदजै वैचाकाङ्मोः सह्त फाम्पा</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />तब जोतिसिवजै नू छकाई पप्पान ल्होई हेरोदग क्युई रह्पा, रे नुई मिह्दा सेह्ताङ खेबो। आलै जोतिसिवलम क्युई रह्पान भेला अन्सार बेथलेहेम रे मन छेत्रन झिङन ङेह् परा रे मनलै ज्योम्मु पुरू वैचाकाङ्मोः सत्फाम्बो। <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />तब यर्मिया भबिस्यबक्ताजै र्‌वापान बचन पुरा रह्बो, <verse eid="MAT 2:17" /><verse number="18" style="v" sid="MAT 2:18" />“रामाग छिदी ताह्बो, केह्ः छ्यूछ्यू दापा रे तूँलाक्या राह्‌राह्‌ दाःपान केह्ः किम, राहेल जेँन वैचावन भिह्तु दापाई छ्युपा, सान्तोना नुई अस्वीकार खेबो, तैङर्‌वाङिन नुन वैचाव ता मलुईबो।”<note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">यर ३१:१५</ref></char></note><verse eid="MAT 2:18" /></para>
  <para style="s">मिस्र देसलै होल्पा</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोद सिमी परमप्रभुन स्वर्गदुतजै मिस्र देसग योसेफन स्याह् मङ मङ्बो। <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />रे झाम र्‌वाबो, “च्याँ, वैचा रे नुन माः ङ्याबो वव्वै इस्राएल देसग वया, तैङर्‌वाङिन वैचाः सच्‌चे फान्नानव सितपा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="EXO 4:19">प्रस ४:१९</ref> </char></note><verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />योसेफ च्याङच्याङ वैचा रे नुन माः ङ्याबो वव्वै इस्राएल देसग होल्बो। <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />जेङ्नै यहूदियाग जेँन पा हेरोदन ठाउँग अर्खिलाउसजै राज्य खेपा ङ्याह् र्‌वानान्न ल्होई ताह्ताह् नु स्याह् वैचे ङिह्‌म्बो, रे मङग चेतावनी देद्‌दे नु गालीलन प्रदेसग होई। <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />नु वैवै नासरत र्‌वानान्न सहरग छ्युङ्बो। झामखेखे भबिस्यबक्तावलम र्‌वापान बचन पुरा रह्बो, “नू नासरी र्‌वानान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">मर्क १:२४</ref>; <ref loc="LUK 2:39">लुक २:३९</ref>; <ref loc="JHN 1:45">यूह १:४५</ref>; <ref loc="ISA 11:1">यसै ११:१</ref>; <ref loc="ISA 4:2">४:२</ref>; <ref loc="ISA 42:6">४२:६</ref></char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">बप्‌तिस्मा-बिन्नान्न यूहन्नान ताह्फेः</para>
  <para style="r">(<ref loc="MRK 1:1-8">मर्क १:१-८</ref>; <ref loc="LUK 3:1-18">लुक ३:१-१८</ref>; <ref loc="JHN 1:19-28">यूह १:१९-२८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />मन्नै भेला बप्‌तिस्मा बिन्नान्न यूहन्ना यहूदिया प्रदेसन सुनसान ठाउँग स्वाबो, रे झाम र्‌वाईर्‌वाई ताह्फेम्मः जाःबो, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />नुई र्‌वाबो, “जेँन तीपावलम होला, तैङर्‌वाङिन स्वर्गन राज्य रह्‌म्म स्वापा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यसै ४०:३</ref></char></note> <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />तैङर्‌वाङिन अन नुई जेङ्पा, सुन भारेः यसैया भबिस्यबक्तालम झाम र्‌वापा ङ्याह्:</para>
  <para style="p" vid="MAT 3:3">“सुनसान ठाउँग तीपा फाईरा खेनान्न केह्ः, ‘परमप्रभुन लम तयार ख्या, नुन लम थार्का धोँवा’।”<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यसै ४०:३</ref></char></note> <verse eid="MAT 3:3" /><verse number="4" style="v" sid="MAT 3:4" />यूहन्नाई ऊँतन पूह्‌न घोलाङ गोङ्‌ङ, रे हाङग फोन्न धब दम्ङ। नुन झायाप लिप्नान्न नर्सिङ्‌का किम रे तप्लन-अकु ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">२ झली १:८</ref></char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />यरूसलेम सहर, यहूदिया प्रदेसन नाम पुरू रे यर्दन चाङ्पुन लिब्रुङ्क्याँलै सिमिव नुन रह्‌म्म होई, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />रे जेँ-जेँन तीपाव स्वीकार खेईखेई यर्दन चाङ्पू नुनलम बप्‌तिस्मा वम्मः जाःबो।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />जेङ्नै फरिसीव रे सदुकीवन बर्ग लैःग बप्‌तिस्मा वम्मः स्वायङ खेपा रङरङ नुई ख्युकाङ्मोः र्‌वाबो, “ए भुलेन्न वैचा हो, स्वामः जाःपान सेह्ताङलम ज्यार्मः सुई ङेनकाङ्मोः चेतावनी बिम्बो? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />मन धोनव ख्या कनजै ङेन जेँन तीपावलम होल्पा ङ्याह् र्‌वार्‌वा थङ्‌ङ। <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />अब्राहामै ङिन पा जेङ्पा र्‌वार्‌वा राह्ङराङ्साः ल्होई नर्‌वा। तैङर्‌वाङिन ङा ङेनकाङ्मोः र्‌वाचे, परमेस्वरजै अन लुङवलम अब्राहामन भिह्तु सन्तान दोङ तैनान,<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">यूह ८:३३</ref></char></note> <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />चोँई तङ्पुन पादा वा ताह्तपा ङ्याह्। अन्नकारन फल लः मछ्यानान्न तङ्पु पुरू थुम्नान, रे मेह्ग पन्नान।” <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />“ङा ता ङेनकाङ्मोः घ्योप्पान भिह्तु त्युई बप्‌तिस्मा बिन्नान, जेङ्नै ङन ङिक स्वानान ङन खेरे हेँ सक्तिसाली ङिह्पा, सुन ङा पौला हुर्चेन सम स्योरस्योरलैम मीपा। नुई ङेनकाङ्मोः पबित्र आत्मा रे मेह्ई बप्‌तिस्मा बिन्नान ङ्याह्। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />नुन ताम्नान्न फरा नुनै लाह्ग ङ्याह्, रे नुई जेँन ह्‌वाः पुरू खामसाङ्म दोङ्नान ङ्याह्, रे जेँन रुन्जन स्योह्बुङग रूनान ङ्याह्, जेङ्नै क्रुपव चन मसिनान्न मेह्ग कोःनान ङ्याह्।”<verse eid="MAT 3:12" /></para>
  <para style="s">येसुन बप्‌तिस्मा</para>
  <para style="r">(<ref loc="MRK 1:9-11">मर्क १:९-११</ref>; <ref loc="LUK 3:21-22">लुक ३:२१-२२</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />मन्न भेला येसु गालीललै यूहन्नान स्याह् नुन लम बप्‌तिस्मा वम्मः यर्दन चाङ्पू स्वाबो। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />जेङ्नै यूहन्नाई झाःम र्‌वार्‌वा नू काःचे फाप्पो, “बरु ङाः पो नानलम बप्‌तिस्मा मवखाईमे ङिह्पा, रे तै ना ङन स्याह् स्वाचेऊ?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />जेङ्नै येसुई नू र्‌वाबो, “चोँ झामै राफाना। तैङर्‌वाङिन झामखेखेई ङी परमेस्वरन इच्छ्यान धोन पुरू पुरा खेत्वानान।” <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />आलै येसु बप्‌तिस्मा वव्वै तुरुन्तै त्युलै ङ्याह् गेप्पो, आलै स्वर्ग पोङ्बो, रे नुई परमेस्वरन आत्माः पुरेन लैम धुलयङ खेपा रे जेँन लाह्ः स्वायङ खेपा रङ्बो। <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />तब स्वर्गलै अन केह्ः स्वाबो, “अन ङन स्याङ्पान ङोह्जो जेङ्पा, नुन ङ्याबो ङा मिह्दा स्याङ्पा ङिह्पा।”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">येसुन छोए सेम्पा</para>
  <para style="r">(<ref loc="MRK 1:12-13">मर्क १:१२-१३</ref>; <ref loc="LUK 4:1-13">लुक ४:१-१३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />अन्न छाम्म सैतानलम छोए सेन्चेन भिह्तु पबित्र आत्मालम येसु सुनसान ठाउँग वप्पो। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />नू ङेथल ङिह्‌म रे ङेथल छान्न बेर बर्त छ्युङ तामी गुसिह्बो।<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">प्रस ३४:२८</ref></char></note> <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />तब छोए सेन्नानजै नुन स्याह् स्वास्वा र्‌वाबो, “ना परमेस्वरन ङोह्जो जेङ्न अन लुङवग रोता राःयो र्‌वार्‌वा आग्या भिना।”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />जेङ्नै येसुई झब बिम्बो, “सर्पा ङ्याह्, ‘सिमि रोताई मात्र नङ्पा, जेङ्नै परमेस्वरन ङुरलै गेप्पान बचन पुरूजै सम्पु लुईनान।’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />तब सैतानजै नू पबित्र सहर यरूसलेमग वव्वै आराधनालयन यू सोल्बो,<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="LUK 4:9">लुक ४:९</ref></char></note> <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />रे नू र्‌वाबो, ङेन परमेस्वरन ङोह्जो जेङ्न स्यीह्‌लै माह्ः भोरा तैङर्‌वाङिन झाःम सर्पा ङ्याह्,</para>
  <para style="q1" vid="MAT 4:6">परमेस्वरजै जेँन दुतकाङ्मोः आग्या खेनान ङ्याह्</para>
  <para style="q2" vid="MAT 4:6">रे ख्युई नाः सेन्चे खेनान ङ्याह्,</para>
  <para style="q2" vid="MAT 4:6">तेमन्ता नान लेह् लुङ्‌ग थ्वाफान्नान ङ्याह्!<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">भजन ९१:११-१२</ref></char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />येसुई नू र्‌वाबो, “सर्पा ङ्याह्, ‘नाई परमप्रभु जेँन परमेस्वरन छोए नसेह्‌ना।’”<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">कानुन ६:१६</ref></char></note> <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />ह्‌याङ सैतानजै नू ला थोमदीग वव्वै सन्सारन राज्य पुरू रे नुन बैभब नू थम्बो, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />रे नू र्‌वाबो, “नाई खल्बू क्यापक्याप ङाः ध्वाः खेङिन, अन तैस्याङ पुरू ङा नाः बिन्नान ङ्युँ।” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />तब येसुई नू र्‌वाबो, “सैतान, ना ग्याङ्म रा! तैङर्‌वाङिन सर्पा ङ्याह्, ‘नाई परमप्रभु जेँन परमेस्वरग ध्वाः ख्या, रे नुन मात्र सेवा ख्या’।”<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">कानुन ६:१३</ref></char></note> <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />तब सैतान नू ख्योवाख्योवा होई रे स्वर्गदुतवजै स्वास्वा नू सेवा खेबो।<verse eid="MAT 4:11" /></para>
  <para style="s">येसुई गालीलग जेँन धोन सुरु खेपा</para>
  <para style="r">(<ref loc="MRK 1:14-15">मर्क १:१४-१५</ref>; <ref loc="LUK 4:14-15">लुक ४:१४-१५</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />बप्‌तिस्मा बिन्नान्न यूहन्ना झ्यालखानाः थेप्पो र्‌वानान्न ल्होई ताह्ताह् येसु गालील प्रदेसग होई,<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ती १४:३</ref>; <ref loc="MRK 6:17">मर्क ६:१७</ref>; <ref loc="LUK 3:19-20">लुक ३:१९-२०</ref></char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />रे नासरत ख्योवाख्योवा कफर्नहुमग वैवै स्याह् छ्युङ्मः जाःबो। अन सहर जबूलून रे नप्‌तालिन छेत्रग, योह्‌न नाः परि राँ। <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />यसैया भबिस्यबक्ताजै र्‌वापान बचन झामखेखे पुरा रह्बो <verse eid="MAT 4:14" /><verse number="15" style="v" sid="MAT 4:15" />“जबूलून्न मुलुक रे नप्‌तालिन मुलुक, यर्दन चाङ्पुन धिङाः, समुद्रक्याँ, यहूदीन खोलोःन सिमिवन गालील, <verse eid="MAT 4:15" /><verse number="16" style="v" sid="MAT 4:16" />नाःतुमाः छ्युङ्नान्न सिमिवजै किम ताह्‌मदी रङ्पा ङ्याह्। कालन तिप्सोन देसग छ्युङ्नानवन लाह्ः ताह्‌मदी स्यार्पा ङ्याह्।” <verse eid="MAT 4:16" /><verse number="17" style="v" sid="MAT 4:17" />मन्न भेलालै ताह्फेरैफेरै येसुई र्‌वामः जाःबो, “तीपावलम होला, तैङर्‌वाङिन स्वर्गन राज्य ङेह्‌मः स्वा ताप्पा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्ती ३:२</ref></char></note><verse eid="MAT 4:17" /></para>
  <para style="s">येसुई ङाह् जुङ्नान्न लिपाः कताङ्पा</para>
  <para style="r">(<ref loc="MRK 1:16-20">मर्क १:१६-२०</ref>; <ref loc="LUK 5:1-11">लुक ५:१-११</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />गालील-योह्‌न नाः लेन्तौ नुई पत्रुस र्‌वानान्न सिमोन रे नुन भाई अन्द्रियास, थिक्‌कोव ङ्योरुमग योह्ग जाल कह्पाई छ्युङ्पा रङ्बो। ख्यु ङाह् जुङ्नान्न सिमि ङ्याह्। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />नुई ख्युकाङ्मोः र्‌वाबो, “ङन ङिक जाः, रे ङा ङेनकाङ्मोः सिमिकाङ्मोः जुङ्नान्न सिमि दोङ्नान ङ्युँ।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />तब मन्नै भेला जालव ख्योवाख्योवा ख्यु येसुन ङिक जाःबो। <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />स्याह्‌लै वैतौवैतौ नुई घङ थिक्‌कोव ङेह्, जब्दियान ङोह्जोव याकूब रे नुन भाई युहन्नाः ख्युन पा जब्दियान ङ्याबो दोङाः जेँन जाल दोङ्यङ खेपा रङ्बो, रे नुई ख्युकाङ्मोः कताङ्बो। <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />तब तुरुन्तै दोङा रे ख्युन पाः ख्योवाख्योवा ख्यु नुन ङिक जाःबो।<verse eid="MAT 4:22" /></para>
  <para style="s">गालिलग येसुन सेवाकाई</para>
  <para style="r">(<ref loc="LUK 6:17-19">लुक ६:१७-१९</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />आलै येसु ख्युन आराधनालयवग लह्‌नैलह्‌नै, राज्यन ल्होन् लः ताह्फेरैफेरै, रे सिमिकाङ्मोः ङिह्पान राँसा राँसान नाह्जा रे ल्हो‌न नाह्‌प्पुवा ताःफानैफानै पुरू गालीलभरि तूह्बो। <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />नुन मिह्‌नकै सिरिया देसभरि फेल्बो, रे खङ्नानव, आथबा राँसा राँसान नाह्जा रे पिरजै तेपफाम्पा, मुई सेम्पा, नाम्क्यान ताह्पा, रे ल्हो मगुल्नान्न नाह्जा रह्पाव पुरूग सिमिवजै नुन स्याह् सप्पो। नुई ख्युकाङ्मोः ताःफाम्बो। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />आलै गालील प्रदेस, देकापोलिस, यरूसलेम सहर, यहूदिया रे यर्दन चाङ्पुन धिङाःलैन मोङ किमव नुन ङिक जाःबो।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">धुरन खाईकोए</para>
  <para style="r">(<ref loc="LUK 6:20-23">लुक ६:२०-२३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />सिमिवन मोह्ङग रङरङ येसु धुरन लाह्ः वैवै छ्युङ्बो रे चेलाव र्‌वार्‌वा नुन धेँवछोँ छ्युङ्बो। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />आलै नुई ख्युकाङ्मोः खाईकोए भिनैभिनै झाम र्‌वाबो:<verse eid="MAT 5:2" /></para>
  <para style="s">तेम्मा स्याङ्पा</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />“धन्न आत्माग बिखारीव, तैङर्‌वाङिन स्वर्गन राज्य ख्युन जेङ्पा।” <verse eid="MAT 5:3" /><verse number="4" style="v" sid="MAT 5:4" />धन्न छरा खेनानव, तैङर्‌वाङिन ख्युई सान्तोना देन्नान ङ्याह्। <verse eid="MAT 5:4" /><verse number="5" style="v" sid="MAT 5:5" />धन्न नम्रव, तैङर्‌वाङिन ख्युई पिर्थीबिन आङ देन्नान ङ्याह्। <verse eid="MAT 5:5" /><verse number="6" style="v" sid="MAT 5:6" />धन्न परमेस्वरन इच्छ्यान भिह्तु गुसिनान रे त्यु बुल्नानव, तैङर्‌वाङिन ख्यु बरङ्नान ङ्याह्। <verse eid="MAT 5:6" /><verse number="7" style="v" sid="MAT 5:7" />धन्न दया खेनानव, तैङर्‌वाङिन ख्युई परमेस्वरलम दया देन्नान ङ्याह्। <verse eid="MAT 5:7" /><verse number="8" style="v" sid="MAT 5:8" />धन्न सम छाङ्म राह्‌नानव, तैङर्‌वाङिन ख्युई परमेस्वरग रङ्नान ङ्याह्। <verse eid="MAT 5:8" /><verse number="9" style="v" sid="MAT 5:9" />धन्न दीफान्नानव, तैङर्‌वाङिन ख्यु परमेस्वरन सन्तान र्‌वानान ङ्याह्। <verse eid="MAT 5:9" /><verse number="10" style="v" sid="MAT 5:10" />धन्न परमेस्वरन इच्छ्यान भिह्तु तेह्पफान्नानव, तैङर्‌वाङिन स्वर्गन राज्य ख्युन जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">१ पत्र ३:१४</ref></char></note> <verse eid="MAT 5:10" /><verse number="11" style="v" sid="MAT 5:11" />“धन्न जेङ्पा ङेन, जब सिमिवजै ङन खातिर ङेनकोन ल्हुई झानान ङ्याह् रे तेह्पफान्नान ङ्याह्, रे लबारन ल्होई र्‌वार्‌वा ङेनकोन बिरोधग तैस्याङ पुरून ल्होई अलः र्‌वानान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">१ पत्र ४:१४</ref></char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />तब स्याँ, रे मिह्दा किम्म रा, तैङर्‌वाङिन स्वर्गः ङेनकोन इनाम किम राह्‌नान ङ्याह्। तैङर्‌वाङिन झामखेखेई ङेन खेरे ङून भबिस्यबक्ताकाङ्मोः ख्युई तेपफाम्पा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">२ इति ३६:१६</ref>; <ref loc="ACT 7:52">प्रे ७:५२</ref></char></note><verse eid="MAT 5:12" /></para>
  <para style="s">चा रे ताह्‌म</para>
  <para style="r">(<ref loc="MRK 9:50">मर्क ९:५०</ref>; <ref loc="LUK 14:34-35">लुक १४:३४-३५</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“ङेन पिर्थीबिन चा जेङ्पा, जेङ्नै चान तोह्‌प्लाः वैङिन मन तैजै ह्‌याङ स्युर्पा दोङ्चे? मन ता खोलोः पच्‌चे रे सिमिन लेह्ई लेच्‌चेन नङ्म घङ तये फान्त्वानान मराह्‌नान।” <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />“ङेन सन्सारन ताह्‌म जेङ्पा। धुरग नाम्पान सहर पेर मतैङ।<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">यूह ८:१२</ref>; <ref loc="JHN 9:5">९:५</ref></char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />सिमिवजै लज्युङ पार्पार खेखे फाक्तिनजै ता मकप्ङ, जेङ्नै सामदानग नाह्ङ्‌ङ रे यिम ङिह्पा पुरून भिह्तु नुई साल्म बिङ्‌ङ।<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">मर्क ४:२१</ref>; <ref loc="LUK 8:16">लुक ८:१६</ref>; <ref loc="LUK 11:33">११:३३</ref></char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />झामखेखेई ङेनकोन ताह्‌म सिमिवन ङू चम्कि राःयो, रे ख्युई ङेनकोन धोन लः रँयो, रे स्वर्गः ङिह्पान ङेनकोन पान महिमा ख्याःयो।”<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">१ पत्र २:१२</ref></char></note><verse eid="MAT 5:16" /></para>
  <para style="s">कानुन्न भारेः लम्पा</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“मोसाई बिम्पान कानुन आथबा भबिस्यबक्तावजै र्‌वापान ल्होई पह्‌म्मः ङा स्वापा जेङ्पा र्‌वार्‌वा नछुवा। ङा मन पह्‌म्मः नङ्पा, जेङ्नै पुरा खेमः स्वापा जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 10:4">रोम १०:४</ref></char></note> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />तैङर्‌वाङिन तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, जबथाल स्वर्ग रे पिर्थीबि ताह्ताह् मवैङ तबथाल कानुन्न ल्होई पुरू पुरा मरारे तै खेखेई अछेर कत्याम या थोप्लादी यङ ताह्ताह् वैनान मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लुक १६:१७</ref></char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />अन्नकारन सुई अन आग्यावन बर्ग पुरून खेरे कत्याःमः मङ्यान्दरा, रे सिमिकाङ्मोः उजुई खेमः लह्‌नदरा, स्वर्गन राज्यग नु पुरून खेरे कत्याम राह्‌नान ङ्याह्। जेङ्नै सुई मन आग्याव पालन खेदरा रे लह्‌नदरा, स्वर्गन राज्यग नु किम राह्‌नान ङ्याह्। <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />तैङर्‌वाङिन ङा ङेनकाङ्मोः र्‌वाचे, ङेनकोन परमेस्वरन इच्छ्या कानुन लन्नान्न सिमि रे फरिसीवन खेरे ह्‌याल्म मराङिन ङेन तैस्याङ खेनै स्वर्गन राज्यग जाःनान मह्‌या।”<verse eid="MAT 5:20" /></para>
  <para style="s">सेह्ताङन भारेः लम्पा</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“ङेनजै ताह्पा ङ्याह्, ताङ्बोन सिमिकाङ्मोः झाःम र्‌वापा ङ्याह्, ‘नाई सिमि नसह्‌रा, रे सुई सिमि सह्ङ्‌ङ नु धलन सम स्योरस्योर लैम राह्‌नान ङ्याह्।’<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="DEU 20:13">कानुन २०:१३</ref>; <ref loc="DEU 5:17">कानुन ५:१७</ref></char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, सुस्याङ जेँन भाईन ङ्याबो सेह्ताङ खेँ नु धलन सम स्योरस्योर लैम राह्‌नान ङ्याह्, रे सुई जेँन भाइन अपमान खेँ, नु सिमि जोम्पू झब भिन मतैनान राह्‌नान ङ्याह्। जेङ्नै सुई जेँन भाइग ‘ना मुर्ख’ र्‌वाङ, नु ङ्यालान मेह्ग वैचेन जोखिमग राह्‌नान ङ्याह्।” <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />“अन्नकारन नाई बेदीग जेँन भेति फुल्तौ नान भाईन समग नान बिरोधग तयाः ङ्याह् र्‌वानान नाः ह्‌याका राङिन, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />नान भेति स्याह्‌ई बेदीन ङू ख्योवा, रे वया। ङू जेँन भाईन ङ्याबो दीचे ख्या, रे मन्न छाम्म स्वास्वा जेँन भेती फुला।” <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />“नान बैरीन ङ्याबो अदालतग वैतौ लमगै दिया, तेमन्ता बैरिजै नाः न्यायधीसन लाह्ग थोत्‌तरा, रे न्याधीसजै अधिक्रितन लाह्ग थोत्‌तरा, रे ना झ्यालखानाः थेप्नान ङ्याह्। <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, नाई सोह्ङ पुरु मफाःन बेर ना स्याह्‌लै बुप्नान मह्‌या।”<verse eid="MAT 5:26" /></para>
  <para style="s">ब्यभिचारन भारेः लम्पा</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“ङेनजै झाम र्‌वापा ताह्पा ङिह्पाऊ, ‘नाई ब्यभिचार<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false">पातार, नावा घोल्वा, धोन अलः आदि खेनान। </char></note> नख्या।’<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="DEU 20:14">कानुन २०:१४</ref>; <ref loc="DEU 5:18">कानुन ५:१८</ref></char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, सुई कान चिमिचाः नावा घोल्वान ईछ्याई सेह्ङ्‌ङ, नुई ङूलै जेँन समग नुन ङ्याबो ब्यभिचार खेतह्पा राह्‌नान। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />यदि नान मी याईपाई नाः तीपा खेफाङ्‌ङिन मनग छ्यूछ्यू पह्‌रा, तैङर्‌वाङिन नान ल्हो पुरू ङ्यालाः पच्‌चेन खेरे बरु नान अङ्‌गवन बर्ग ती मोल्चे नान भिह्तु ल: राह्‌नान।<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">मत्ती १८:९</ref>; <ref loc="MRK 9:47">मर्क ९:४७</ref></char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />नान याईपा लाह्ई नाः तीपा खेफाङ्‌ङिन मनग थुमथुम पह्‌रा। तैङर्‌वाङिन नान ल्हो पुरू ङ्यालाः वैचेन खेरे बरु नान अङ्‌गवन बर्ग ती मोल्चे नान भिह्तु ल: राह्‌नान।<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">मत्ती १८:८</ref>; <ref loc="MRK 9:43">मर्क ९:४३</ref></char></note><verse eid="MAT 5:30" /></para>
  <para style="s">मिह्जी भानान्न भारेः लम्पा</para>
  <para style="r">(<ref loc="MRK 10:11-12">मर्क १०:११-१२</ref>; <ref loc="LUK 16:18">लुक १६:१८</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“झाम रे र्‌वापा ङ्याह्, कि ‘सुई जेँन मिसाः ख्योवाङ, नुई मिसाः ख्योवानान्न हिगा सह्‌राःयो।’<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">कानुन २४:१-४</ref>; <ref loc="MAT 19:7">मत्ती १९:७</ref>; <ref loc="MRK 10:4">मर्क १०:४</ref></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, सुई जेँन मिसा: ब्यभिचारन कारन नङ्म घङ कारनजै ख्योवादरा, नुई मिसाः ब्यभिचारिनी दोङ्नान, रे सुई ख्योवापान चिमिचान ङ्याबो मिह्जी खेदरा, नुई पातार खेनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">मत्ती १९:९</ref>; <ref loc="MRK 10:11-12">मर्क १०:११-१२</ref>; <ref loc="LUK 16:18">लुक १६:१८</ref>; <ref loc="1CO 7:10-11">१ कोर ७:१०-११</ref></char></note><verse eid="MAT 5:32" /></para>
  <para style="s">रेनरुपान भारेः लम्पा</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“ह्‌याङ ङेनजै ताह्पा ङ्याह्, कि ताङ्बोन सिमिकाङ्मोः र्‌वापा ङ्याह्, ‘नाई लबारन रेन नरुवा, जेङ्नै परमप्रभुन भिह्तु रुपान रेन नाई पुरा ख्या।’<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">लेवी १९:१२</ref>; <ref loc="NUM 30:2">गन्ती ३०:२</ref>; <ref loc="DEU 23:21">कानुन २३:२१</ref></char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, रेन रुई नरुवा। स्वर्गन मिह्‌नग रेन नरुवा, तैङर्‌वाङिन मन परमेस्वरन सिङ्‌हासन जेङ्पा,<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">याक ५:१२</ref>; <ref loc="ISA 66:1">यसै ६६:१</ref>; <ref loc="MAT 23:22">मत्ती २३:२२</ref></char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />न ता पिर्थीबिन, तैङर्‌वाङिन मन नुन ल्हे नाम्पु जेङ्पा, न ता यरूसलेमन, तैङर्‌वाङिन मन मकेकुकेन किम झलीन सहर जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यसै ६६:१</ref>; <ref loc="PSA 48:2">भजन ४८:२</ref></char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />जेँन थोप्पान रेन नरुवा, तैङर्‌वाङिन नाई छमदीग पाह्ल्म या म्याह्‌म्म दोङ मतैनान। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />ङेनजै र्‌वापान ल्होई चन ‘जेङ्पा’ र्‌वाङिन ‘जेङ्पा,’ ‘नङ्पा’ र्‌वाङिन ‘नङ्पा’ मात्र राःयो। अन्न खेरे ह्‌याल्म चन अलःलम स्वाङ।”<verse eid="MAT 5:37" /></para>
  <para style="s">खूँ नान्नान्न भारेः लम्पा</para>
  <para style="r">(<ref loc="LUK 6:27-36">लुक ६:२७-३६</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“झाम र्‌वापा ङेनजै ताह्पा ङ्याह्, ‘मीन पूँ मी, रे सोन पूँ सो।’<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">प्रस २१:२४</ref>; <ref loc="LEV 24:20">लेवी २४:२०</ref>; <ref loc="DEU 19:21">कानुन १९:२१</ref></char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, सिमि अलःन ङ्याबो थाप्चि नख्या। सुई नान धामा याईपाः फ्याङदरा, नू घङ धामा यङ ताह्। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />यदि कान सिमिजै मुद्दा खेखे नान भन्दि वच्‌चे फाङ्‌ङिन, नू नान कोत यङ भिना। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />यदि सुई नाः ङन ङ्याबो किलोमितरदी थाल भै र्‌वार्‌वा धिपी खेङिन, नुन ङ्याबो किलोमितर ङेह् थाल वया। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />नान ङ्याबो तोल्नानग भिना, रे नान ङ्याबो छेर वस्सुम खेनानग अस्वीकार नख्या।<verse eid="MAT 5:42" /></para>
  <para style="s">बैरिग मया ख्या</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“ङेनजै झाम र्‌वापा ताह्पा ङ्याह्, ‘नान खिम्जेःग मया ख्या, रे नान बैरी मस्याङ्चे ख्या।’<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवी १९:१८</ref></char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, जेँन बैरिकाङ्मोः मया ख्या, रे ङेनकाङ्मोः तेह्पफान्नानवन भिह्तु सोअताबा,<note caller="-" style="x"><char style="xo" closed="false">5:44 </char><char style="xt" closed="false"><ref loc="ROM 12:14">रोम १२:१४</ref></char></note> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />रे ङेन स्वर्गः ङिह्पान जेँन पान ङोह्जोव राह्‌नान ङ्याह्। नुई अलः रे लः ङ्योरुमग ङिह्‌मान ताप बिन्नान, आलै धर्मी रे पापी ङ्योरुमग नाङ्‌का झ्युफान्नान। <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />तैङर्‌वाङिन यदि ङेन जेँग मया खेनानकाङ्मोः मात्र मया खेङिन ङेनकाङ्मोः पुरस्कार तै ङ्याह्? तै कर तुईनानवजै र्‌वार्‌वा उजुई मखेनान तै? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />ङेनजै जेँन थिक्‌कोवग मात्र ध्वाः खेङिन घङवन खेरे ह्‌याल्म तै खेपा? तै यहूदीन खोलोःन सिमिवजै र्‌वार्‌वा उजुई मखेँ तै? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />अन्नकारन कताःम ङेनकोन स्वर्गः ङिह्पान पा वाम्म ङ्याह्, ङेन र्‌वार्‌वा उजुई वाम्म रात्वानान।”<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">लेवी १९:२</ref>; <ref loc="DEU 18:13">कानुन १८:१३</ref></char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">दान बिन्नान्न भारेः लम्पा</para>
  <para style="r">(<ref loc="LUK 11:2-4">लुक ११:२-४</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“होसखेखे छ्योवा, ङेन सिमिकाङ्मोः थन्चेन भिह्तु केवान धोन नख्या। तेमन्ता स्वर्गः ङिह्पान ङेनकोन पा लम ङेनजै इनाम तये देन्नान मह्‌या।” <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />“अन्नकारन जब ङेन दान बिङ्‌ङ, तब जेँन ङू भुकुर नभुरा कताःम ख्वाकिबावजै आराधनालयव रे लमवग सिमिवलम प्रसङ्सा देच्‌चेन भिह्तु खेँ। तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ख्युई जेँन इनाम देत्तपा ङ्याह्। <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />जेङ्नै जब ना दान बिङ्‌ङ, नान लाह् याईपाई तै खेपाई ङ्याह् अन लाह् योम्माः क्युई नराःयो। <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />नान दान फाक राःयो, रे फाक रङ्नान्न नान पाई नाः इनाम बिन्नान ङ्याह्।”<verse eid="MAT 6:4" /></para>
  <para style="s">सोअतापन भारेः लम्पा</para>
  <para style="r">(<ref loc="LUK 11:2-4">लुक ११:२-४</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“जब ना सोअताप्ङ तब ख्वाकिबाव लैम नह्‌रा, तैङर्‌वाङिन ख्यु आराधनालयवग रे लमवन कोप्चाः सिमिवजै रँयो र्‌वार्‌वा च्याङ्च्याङ् सोअताप्मः स्याँ। तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ख्युई जेँन इनाम देत्तपा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">लुक १८:१०-१४</ref></char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />“जेङ्नै ना जब सोअताप्ङ, जेँन झिङन कोथाः जाः, रे झला थाथा फाक छ्युङ्नान्न स्वर्गन परमेस्वर पाः सोअताबा, रे फाक छ्युङ्नान्न नान पाई नाः इनाम बिन्नान ङ्याह्।” <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />रे सोअताप्‌तौ यहूदीन खोलोःन सिमिव लैम भाछ्योवाग प्यारप्यार नख्या। तैङर्‌वाङिन छि लैःग ल्होई र्‌वाङिन अन ङ्यान्नान र्‌वानान ख्यु छूँ। <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />अन्नकारन ख्युलैम नह्‌रा। तैङर्‌वाङिन ङेनजै नुन ङ्याबो तोल्चेन खेरे ङूह्ई ङेनकाङ्मोः ल्होई तैन कोम्म रह्पा ङ्याह्, अन ङेनकोन स्वर्गः ङिह्पान परमेस्वर पाः क्युई ङिह्पा। <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />जेङ्नै ङेनचन झामखेखे सोअताबा:</para>
  <para style="p" vid="MAT 6:9">“हे ङिन पा, सु स्वर्गः ङिह्पा, नान मिह्‌न पबित्र ङ्यानाःयो।<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="LUK 12:2">लुक १२:२</ref></char></note> <verse eid="MAT 6:9" /><verse number="10" style="v" sid="MAT 6:10" />नान राज्य स्वाःयो। नान इच्छ्या स्वर्गः कताःम ङ्याह्। मन लैमै अन पिर्थीबी पुरा राःयो। <verse eid="MAT 6:10" /><verse number="11" style="v" sid="MAT 6:11" />ङी त्या ङिन बात्तैन ङ्योप्पा क। <verse eid="MAT 6:11" /><verse number="12" style="v" sid="MAT 6:12" />ङी खेपान तीपाव माफ ख्या, कुजुई ङी र्‌वार्‌वा ङिन बिरोधग तीपा खेनानकाङ्मोः माफ खेपा ङिह्पा। <verse eid="MAT 6:12" /><verse number="13" style="v" sid="MAT 6:13" />ङी छोए सेन्चेग थेप नफाना, अलःलै फा तैङर्‌वाङिन राज्य, पराक्रम रे महिमा एकुरोभरि नानै जेङ्पा, आमेन।” <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" />तैङर्‌वाङिन ङेनजै सिमिवन तीपा माफ खेङिन ङेनकोन स्वर्गः ङिह्पान परमेस्वर पाई र्‌वार्‌वा ङेनकाङ्मोः माफ खेनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">मर्क ११:२५-२६</ref></char></note> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />जेङ्नै ङेनजै सिमिवन तीपा माफ मखेङिन ङेनकोन स्वर्गः ङिह्पान परमेस्वर पाई र्‌वार्‌वा ङेन तीपा माफ खेनान मह्‌या।<verse eid="MAT 6:15" /></para>
  <para style="s">बर्तन भारेः लम्पा</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“जब ङेन बर्त छयूँ, तब ख्वाकिबाव लैम नाह्छुपछुप ध्वा नथना। तैङर्‌वाङिन सिमिकाङ्मोः बर्त छ्युङ्पा थन्चेन भिह्तु ख्यु जेँन ध्वा नाःतुमा धोँ। तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, ख्युई जेँन पुरस्कार देत्तपा ङ्याह्। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />ना चन बर्त छ्युङ्तौ एकुरोलैम जेँन थोप्पाः छि दुद्‌दुई जेँन खालाः थुथु छ्योवा। <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />रे नान बर्त सिमिवजै नङ्पा, जेङ्नै फाक ङिह्पान नान पाई रँयो, रे फाक ङिह्पान नान पाई नाः इनाम बिन्नान ङ्याह्।”<verse eid="MAT 6:18" /></para>
  <para style="s">स्वर्गन क्यु</para>
  <para style="r">(<ref loc="LUK 12:33-34">लुक १२:३३-३४</ref>; <ref loc="LUK 16:13">१६:१३</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“जेँन भिह्तु पिर्थीबी क्यु नसाः, स्यीह् साःपान क्यु ता भु रे घत्याःजै मन मीपा दोङ्नान रे खुम्मपावजै यिम तिलतिल मन खुनान।<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">याक ५:२-३</ref></char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />जेङ्नै जेँन भिह्तु स्वार्गः क्यु सा, खाः भुई या घत्याःजै मीपा मदोङ्नान, रे खुम्पाई र्‌वार्‌वा यिम तिलतिल मखुनान। <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />तैङर्‌वाङिन खाः नान क्यु राह्‌नान, स्याह्ई नान सम यङ राह्‌नान।”<verse eid="MAT 6:21" /></para>
  <para style="s">ल्हो‌न ताह्‌म</para>
  <para style="r">(<ref loc="LUK 11:34-36">लुक ११:३४-३६</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />मी ल्हो‌न लज्युङ जेङ्पा। अन्नकारन यदि नान मी खामसाङ्म ङिङिन, नान ल्हो पुरू साल्म राह्‌नान ङ्याह्। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />जेङ्नै यदि नान मी अलः ङिङिन, नान ल्हो पुरू नाःतुमा राह्‌नान ङ्याह्। अन्नकारन नान समग रह्पान साल्म चन नाःतुमा राङिन, अन नाःतुमा हाति ह्‌याल्म नाःतुमा र्‌हदरा!<verse eid="MAT 6:23" /></para>
  <para style="s">परमेस्वर रे क्यु</para>
  <para style="r">(<ref loc="LUK 16:13">लुक १६:१३</ref>; <ref loc="LUK 12:22-31">१२:२२-३१</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />सुई यङ मालिक ङेह्‌न सेवा खे मतैनान। तैङर्‌वाङिन नुई तीपाः मस्याङ्नान ङ्याह् रे घङग मया खेनान ङ्याह्। आथबा नुई तीपाः भक्ति नान्नान ङ्याह्, रे घङग नुई फानै मत्वानान र्‌वार्‌वा छुनान ङ्याह्। ङेनजै परमेस्वर रे क्युन सेवा खे मतैनान।<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />अन्नैकारन ङा ङेनकाङ्मोः र्‌वाचे, “तै झाचे, तै थुङ्चे र्‌वार्‌वा जेँन परान्न भिह्तु रे तै गोन्चे र्‌वार्‌वा जेँन ल्हो‌न भिह्तु छरा नख्या।” तै झायाप खेरे जिन्दगी किम रे घोलाङ खेरे ल्हो किम नङ्पा तै? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />पान्नाङ्न युजू सेह्‌ना। ख्युई न ता र्‌यु पह्ङ्‌ङ, न साह्ई गम्ङ, न स्योह्बुङ्‌ग साःङ, जेङ्नै ङेनकोन स्वर्गन पाई ख्युकाङ्मोः झाफाङ्‌ङ। तै ङेन ख्युन खेरे मकेकुकेन कुम्म मिपा तै? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />ङेनकोन बर्ग कन चनजै छरा खेखे जेँन छ ङाईदी यङ र्‌याङ्म दोङ तैनौ? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />“आलै घोलाङन भिह्तु ङेन तैङ छरा खेनान? क्वान लिलि मिन्नोवाग सेह्‌ना। मन कुजुई छार्ङ। नुई न तूरि खेँ, न ता घोलाङ ब्योङ। <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, सोलोमन झली यङ जेँन बैभब पुरूग ख्युन बर्ग तीपान झोर यङ छ्याईपा मह्‌या। <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />त्या ङिह्पा रे नाप्चे मेह्कोअन मेह्ग पन्नान्न सी परमेस्वरजै झामखेखे थङ्‌ङ र्‌वाङिन, ए ङाईदिन बिस्वासी हो, तै ङेनकाङ्मोः हेँ ह्‌याल्म नुई थन्नान मह्‌या तै?” <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />अन्नकारन “तै झाचे? कि तै थुङ्चे? कि तै गोन्चे? र्‌वार्‌वा छरा नख्या।” <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />तैङर्‌वाङिन यहूदीन खोलोःन सिमिवजै अन तैस्याङ पुरू फाङ्‌ङ, रे ङेनकोन स्वर्गः ङिह्पान पाई ङेनकाङ्मोः अन तैस्याङ पुरू त्वाङ र्‌वार्‌वा क्युई ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">6:32 </char><char style="xt" closed="false"><ref loc="LUK 12:31">लुक १२:३१</ref></char></note> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />जेङ्नै ङू परमेस्वरन राज्य रे परमेस्वरन इच्छ्या फाच्‌चे ख्या, रे अन तैस्याङ पुरू ङेनकोन भिह्तु पोह्‌न राह्‌नान ङ्याह्। <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />अन्नकारन नाप्चेन भिह्तु छरा नख्या, तैङर्‌वाङिन नाप्चेन लाह्जै जेँन छरा जेँजै खेनान ङ्याह्। त्यान तूरि त्यान भिह्तु हाति र्‌वार्‌वा ङ्याह्।<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">घङवन छोए नसेह्‌ना</para>
  <para style="r">(<ref loc="LUK 6:37-38">लुक ६:३७-३८</ref>; <ref loc="LUK 6:41-42">६:४१-४२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />येसुई हेँ र्‌वाईर्‌वाई होई, “घङग न्याय नख्या आलै परमेस्वरजै र्‌वार्‌वा ङेनकाङ्मोः न्याय खेनान मह्‌या। <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />तैङर्‌वाङिन कुजुई ङेनकोजै घङ्‌काङ्मोः न्याय खेँ, उजुखेखेई परमेस्वरजै र्‌वार्‌वा ङेनकाङ्मोः न्याय खेनान ङ्याह्। कन नापजै ङेनकोजै घङग नापि खेँ, मनै नापजै ङेनकोजै र्‌वार्‌वा देन्नान ङ्याह्।” <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />“तैङ ना जेँन भाइन मी ङिह्पान थल्जुपन च्याच्यार रँ, जेङ्नै नान जेँनै मी ङिह्पान थोसो चन क्युई मराँ? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />आथबा नान जेँनै मी थोसो ङिङिन कुजुई ना नान भाईग र्‌वा तैनान, ‘ङाः नान मीलै थल्जुपन च्याच्यार छ्यूफाना।’” <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />ए ख्वाकिबाव हो, ङू जेँनै मीलै थोसो थोरा, तब नान भाईन मीलै थल्जुपन च्याच्यार छ्यूचेन भिह्तु ना लः खेखे रङ तैनान ङ्याह्। <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />“तै पबित्र ङ्याह् अन ख्युकोग नभिना। जेँन मोतीव छ्योअन ङू नपह्‌रा, तेमन्ता नुई जेँन लेह्ई नू लेत्तरा रे होलहोल नाः फ्याङ्दारा।”<verse eid="MAT 7:6" /></para>
  <para style="s">तोला, फारा रे झला कुला</para>
  <para style="r">(<ref loc="LUK 11:9-13">लुक ११:९-१३</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“तोला न ङेनकाङ्मोः बिन्नान ङ्याह्, फारा न ङेनजै दोःनान ङ्याह्, झला कुला न ङेनकोन भिह्तु पोङ्नान ङ्याह्। <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />तैङर्‌वाङिन सुई तोल्ङ, नुई देन्नान, सुई फाङ्‌ङ, नुई दोःनान, सुई झला कुल्ङ, नुन भिह्तु झला पोङ्नान ङ्याह्।” <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />“ङेनकोन बर्ग कन सिमि जेम्तौ, सुन ङोह्जोई रोता तोल्तौ नू लुङ बिङ्‌ङ? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />आथबा ङाह् तोल्तौ नू भुलेन बिङ्‌ङ? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />अन्नकारन ङेन अलः राह्‌राह्‌ यङ जेँन ङोह्जो चमेः चिज लः बिन्चे क्युई राँ र्‌वाङिन, स्वर्गः ङिह्पान ङेनकोन पाई नुन ङ्याबो तोल्नानकाङ्मोः हातिन ह्‌याल्म खेखे चिज लः बिन्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="LUK 11:13">लुक ११:१३</ref></char></note> <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />सिमिवजै ङेन ङ्याबो कताःमन बेऊरा ख्याःयो र्‌वानान ङेन चाहि खेँ, ङेनजै र्‌वार्‌वा ख्युन ङ्याबो उजुई बेऊरा ख्या, तैङर्‌वाङिन अनै मोसान कानुन रे भबिस्यबक्तावजै र्‌वापान ल्होईव जेङ्पा।<verse eid="MAT 7:12" /></para>
  <para style="s">झला त्वाम</para>
  <para style="r">(<ref loc="LUK 13:24">लुक १३:२४</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“झला त्वामलै झिङ जाः, तैङर्‌वाङिन मीपा दोङ्नानग साःनान झला वाःम रे लम छुम्म राह्‌नान, रे अनलम झिङ जाःनान सिमिव लै राह्‌नान। <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />तैङर्‌वाङिन झुनी साःनान्न लम त्वाम राह्‌नान रे लम खराःम राह्‌नान, सुई झुनी साःङ, रे मन दोःनान सिमिव ङाईदी राह्‌नान।<verse eid="MAT 7:14" /></para>
  <para style="s">तङ्पु रे नुन फल</para>
  <para style="r">(<ref loc="LUK 6:43-44">लुक ६:४३-४४</ref>; <ref loc="LUK 13:25-27">१३:२५-२७</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“नक्‌कली अगमबक्तावलम होसखेखे छ्योवा, सु ङेन स्याह् लूपान रुपग स्वाङ, जेङ्नै झिङक्याँ चन ङिनङिनलैमन फाराव लैम राह्‌नान।<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="JER 22:27">यर २२:२७</ref></char></note> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />ख्युन माह्‌लम ङेनजै ख्युकाङ्मोः स्योःनान ङ्याह्। तै चेरन तङ्पुलै अङ्‌गुर आथबा सिऊरिलै खोअ चाह्‌नान तै? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />उजुईखेखे तङ्पु लः पुरूजै फल लः छ्यानान। जेङ्नै तङ्पु अलःजै फल अलः छ्यानान। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />तङ्पु लजै फल अलः छ्याः मतैनान, न ता तङ्पु अलःजै फल लः छ्याः तैङ। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />फल लः मछ्यानान्न तङ्पु पुरूग थुमथुम मेह्ग पन्नान।<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">मत्ती ३:१०</ref>; <ref loc="LUK 3:9">लुक ३:९</ref></char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />झामखेखे मन नक्‌कली अगमबक्ताकाङ्मोः ख्युन धोनलमै स्योःनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती १२:३३</ref></char></note><verse eid="MAT 7:20" /></para>
  <para style="s">ङै नाः हातौयै मस्योःपा</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“ङाः ‘प्रभु, प्रभु’ र्‌वानान पुरू स्वर्गन राज्यग जाःनान मह्‌या। स्वर्गः ङिह्पान ङन पान इच्छ्या ङ्यान्नान्न सिमिव मात्र परमेस्वरन राज्यग जाःनान ङ्याह्। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />मन्न ल्हाः लैःजै ङाः र्‌वानान ङ्याह्, ‘प्रभु, प्रभु, तै ङी नान मिह्‌नग भबिस्यबानी मर्‌वापौ? नान मिह्‌नग मुव मधाम्पौ? रे नान मिह्‌नग राँसा राँसान ताईलुवान धोन मखेपा तै?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />मन्तौ ङा ख्युकाङ्मोः थारेः र्‌वानान ङ्युँ, ‘ए कानुन मङ्यान्नान्न सिमिव हो, ङै ङेनकाङ्मोः हातौयै स्योःपा मीपा। ङन स्यीह्‌लै ग्याङ्म रा।’<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">भजन ६:८</ref></char></note><verse eid="MAT 7:23" /></para>
  <para style="s">यिम ङेह्‌ दोङ्नानव</para>
  <para style="r">(<ref loc="LUK 6:47-49">लुक ६:४७-४९</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“अन्नकारन सुई ङन अन बचन ङ्याङ्‌ङ रे ङ्याङ्‌ङ, ङा बुद्धिमानी सिमिदीन ङ्याबो नुन तुलना खेचे, सुई जेँन यिम लुङ्न लाह्ः दोङ्बो। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />आलै नाङ्‌का झ्युबो, स्योला स्वाबो, आलै लन च्याङ्बो रे यिमन लाह्ः ठ्वाबो, जेङ्नै मन यिम मदिम्बो। तैङर्‌वाङिन मन लुङ्न लाह्ः झग कह्पा ङ्याह्। <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />सुई ङन अन बचन ताह्ताह् यङ मङ्याङ्‌ङ, नुन तुलना मुर्ख सिमिदीन ङ्याबो खेनान, सुई जेँन यिम पेह्‌मान ल्हाः दोङ्बो। <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />नाङ्‌का झ्युबो, रे स्योला स्वाबो, आलै लन च्याङ्बो रे मन यिमन लाह्ः ठ्वाबो, रे मन यिम दिमदिम मीपा रह्पा।”<verse eid="MAT 7:27" /></para>
  <para style="s">येसुन आङ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />येसुई अन ल्होई र्‌वातामी सिमिवन मोङ नुन छोए ताह्ताह् हालाईबो।<note caller="-" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="MRK 1:22">मर्क १:२२</ref>; <ref loc="LUK 4:32">लुक ४:३२</ref></char></note> <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />तैङर्‌वाङिन नुई ख्युन कानुन लन्नान्न सिमिवजै लैम नङ्पा, जेङ्नै आङ ङिह्पान सिमिजै लैम खेखे लह्ङ्‌ङ।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">कोरन नाह्जा ताह्पा सिमिदी ताःपा</para>
  <para style="r">(<ref loc="MRK 1:40-45">मर्क १:४०-४५</ref>; <ref loc="LUK 5:12-16">लुक ५:१२-१६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />येसु धुरलै धुल्मी सिमिवन मोङ किम नुन ङिक जाःबो। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />कोरन नाह्जा ताह्पान सिमिदी नुन स्याह् स्वाबो, रे नुन ङू पो जूजू झाम र्‌वाबो, “हे प्रभु, नाई चाहि खेङिन ङाः ताःफान तैनान।” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />नुई जेँन लाह् क्याङक्याङ नू ज्यार्बो, रे र्‌वाबो, “ङा चाहि खेनान, ना ताह्ः।” तुरुन्तै नुन कोरन नाह्जा ताःबो। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />तब येसुई नू र्‌वाबो, “ङ्याना, अन ल्होई सुई नर्‌वा। जेङ्नै वया, रे जेँग पुजारीन स्याह् थना, रे मोसाई फुला र्‌वापान भेति फुला, ताकि सिमिकाङ्मोः साँचि रायो।”<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लेवी १४:१-३२</ref></char></note><verse eid="MAT 8:4" /></para>
  <para style="s">येसुई रोमी सेनापतिन राङ्पाः ताःफाम्पा</para>
  <para style="r">(<ref loc="LUK 7:1-10">लुक ७:१-१०</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />येसु कफर्नहुम सहरग जाःतौ रोमी अफिसरदी स्वास्वा नू छ्याःफुल्बो, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“हे प्रभु, ङन राङ्पा ल्हो मगुल्नान नाह्जाई मिह्दा तूरि देद्‌दे यिम आःपाआःत्वा ङ्याह्।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />येसुई नू र्‌वाबो, “ङा स्वास्वा नू ताःफान्नान ङ्युँ।” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />जेङ्नै अफिसरजै र्‌वाबो, “हे प्रभु, ङा नाः ङन यिम स्वागत खेचेन सम स्योरस्योरलैम मीपा। जेङ्नै बचन मात्र र्‌वा, रे ङन राङ्पा तानान ङ्याह्। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />तैङर्‌वाङिन ङा रे हाकिमवन अधिनग ङिह्पा, आलै ङन लाह्ग सिपाहीव ङ्याह्। ङा तीपाः ‘वया’ र्‌वानान, आलै नु वैङ, रे घङग ‘स्वा’ र्‌वानान, आलै नु स्वाङ। ङन राङ्पाः ‘झाम ख्या’ र्‌वानान, आलै नुई अन खेँ।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />नुन ल्होई ताह्ताह् येसु हालाईबो, रे नुन ङिक स्वानानकाङ्मोः र्‌वाबो, “तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, इस्राएलगै झाम बिस्वास किम ङै दोःपा मीपा। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />ङा ङेनकाङ्मोः र्‌वाचे, स्यार रे ल्होलम सिमि लैः स्वानान ङ्याह्, रे अब्राहाम, इसहाक रे याकूबन ङ्याबो स्वर्गन राज्यन भत्यारग छ्युङ्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">लुक १३:२९</ref></char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />आलै राज्यन सन्तान खोलोः नाःतुमाः पन्नान ङ्याह्। स्याह् सिमिव दानान ङ्याह् रे सो चप्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">मत्ती २२:१३</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28-29">लुक १३:२८-२९</ref></char></note> <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />तब येसुई अफिसरग र्‌वाबो, “वया, कताःम नाई बिस्वास खेपा ङ्याह्, उजुई नाः राःयो।” आलै मन राङ्पा मन्नै भेला ताःबो।<verse eid="MAT 8:13" /></para>
  <para style="s">येसुई लैः सिमिकाङ्मोः ताःफाम्पा</para>
  <para style="r">(<ref loc="MRK 1:29-34">मर्क १:२९-३४</ref>; <ref loc="LUK 4:38-41">लुक ४:३८-४१</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />पत्रुसन यिम स्वामी येसुई नुन मोह्‌मग छायोई मिह्दा खङखङ खाःतः दिम्पाई छ्युङ्पा रङ्बो। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />प्रभुई नुन लाह् ज्यार्बो, रे छायोई नू फेप्पो। आलै नु च्याङच्याङ नुन सेवा खेबो।<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />जब ङ्याजे रह्बो, तब ख्युई नुन स्याह् मुई सेम्पा लैः सिमिकाङ्मोः सप्पो। रे नुई छिलमै मुकाङ्मोः छ्यूबो, रे पुरू खङ्नान्न सिमिकाङ्मोः ताःफाम्बो। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />यसैया भबिस्यबक्ताजै र्‌वापान भबिस्यबानी पुरा राचेन भिह्तु अन रह्पा ङ्याह्, “नुई ङिन कमिकमजोरीव वप्पो, रे ङिन नाह्जाव सोलसोल वप्पो।”<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">यसै ५३:४</ref>; <ref loc="1PE 2:24">१ पत्र २:२४</ref></char></note><verse eid="MAT 8:17" /></para>
  <para style="s">येसुन ङिक जाःतौ फात्वानान्न मोल</para>
  <para style="r">(<ref loc="LUK 9:57-62">लुक ९:५७-६२</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />येसुई जेँन धेँवछोँ सिमिवन मोङ किम रङरङ जेँन चेलाकाङ्मोः “दे ङि योह्‌न धिक्याँ वैमता,” र्‌वाबो। <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />कानुन लन्नान्न सिमिदी नुन स्याह् स्वाबो, रे नू र्‌वाबो, “गुरुज्यू, ना खाः खाः वैनान, ङा नान ङिह्‌ङिह्‌ जाःनान ङ्युँ।” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />येसुई नू र्‌वाबो, “सेलान पु रे पान्नाङन युजुवन चाङ राह्‌नान, जेङ्नै सिमिन ङोह्जोन भिह्तु ता थोप्पा नाम्पु यङ मह्‌या।” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />नुन चेलावन बर्ग घङ तीपाई र्‌वाबो, “प्रभु, ङू वैवै ङाः ङन पान कुँह्‌म लुम्फाना।”<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="1KI 19:20-21">१ झली १९:२०-२१</ref></char></note> <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />जेङ्नै येसुई नू र्‌वाबो, “ङन ङिक स्वा, कुँह्‌मजै र्‌वार्‌वा नुन जेँन कुह्‌म लुमाःयो।”<verse eid="MAT 8:22" /></para>
  <para style="s">येसुई लनग छ्याःफाम्पा</para>
  <para style="r">(<ref loc="MRK 4:35-41">मर्क ४:३५-४१</ref>; <ref loc="LUK 8:22-25">लुक ८:२२-२५</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />येसु दोङाः चप्मी नुन चेलाव नुन ङिक जाःबो। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />तैमेःग योह्ग लन किम च्याङ्बो, रे छ्योलापन कारन दोङा नुप्मः जाःबो। जेङ्नै येसु चन आःपाई छ्युङ्पा ङ्याह्। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />आलै चेलावजै येसुन रह्‌म्म वैवै नू सोलैसोलै र्‌वाबो, “गुरुज्यू, ङी बचाई ख्या, ङि ता सिमः जाःबो।” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङाईदिन बिस्वासी सिमि हो, ङेन तैङ ङिन्नान?” तब च्याङच्याङ नुई लन रे योह्ः ङार्बो, रे लन मार्छारे छ्याःबो। <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />“नु ता कताःमन सिमि जेम, तैङर्‌वाङिन लन रे छ्योलापजै र्‌वार्‌वा नुन र्‌वापा ङ्याम्मन” र्‌वार्‌वा मन सिमिव हालाईबो।<verse eid="MAT 8:27" /></para>
  <para style="s">मुई सेम्पान सिमि ङेह्</para>
  <para style="r">(<ref loc="MRK 5:1-20">मर्क ५:१-२०</ref>; <ref loc="LUK 8:26-39">लुक ८:२६-३९</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />जब येसु योह्‌न धिक्याँ गदरिनीवन प्रदेसग स्वाबो, तब मुई सेम्पान सिमि ङेह्पावजै तुह्‌र्सालै स्वायङ खेतौ नू धोबो। ख्यु झाःमन ङिनङिनलैम ङ्याह्, कि सुई र्‌वार्‌वा स्याह्‌लै आउजाउ खे मतैङ। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />ख्युई झाम र्‌वाईर्‌वाई फाईरा खेबो, “हे परमेस्वरन ङोह्जो, ना ङी तै खेमः स्वापा? ङिन भेला मह्‌रारे ङी तूरि बिम्मः ना स्यीह् स्वापा जेङ्पौ?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />ख्यु रह्पुलै ङाई धिङाः छ्योअन मोङ किमदी छापाई ङ्याह्। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />मुवजै नू झाःम र्‌वार्‌वा छ्याःफुल्बो, “यदि नाई ङी छ्यूङिन, ङी छ्योअन मोङग फेरा।” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />आलै नुई ख्युकाङ्मोः र्‌वाबो, “वया।” तब ख्यु गेग्गे छ्योअवग जाःबो, रे छ्योअन मोङ पुरू जारलै पाह्‌मैपाह्‌मै होई रे योह्ग नुपनुप सिह्बो। <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />छ्योअ छानानव ज्यार्बो रे सहरग वैवै ल्होई पुरू, रे मन मुई सेम्पाकाङ्मोः तै रह्पा अन स्याप्पो। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />तब सहर पुरु येसू धोमः स्वाबो, रे नू रङरङ सिमिवजै ङिन छेत्रलै वया र्‌वार्‌वा नू छ्याःफुल्बो।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">येसुई ल्हो मगुल्नान्न नाह्जा ताह्पा सिमी ताःफाम्पा</para>
  <para style="r">(<ref loc="MRK 2:1-12">मर्क २:१-१२</ref>; <ref loc="LUK 5:17-26">लुक ५:१७-२६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />मन्न छाम्म येसु दोङाः चपचप योह्‌न धिक्याँ जेँ छ्युङ्पान सहरग होलहोल स्वाबो। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />सिमिवजै खातग दिमदिम आःपा ल्हो मगुल्नान सिमिदी नुन स्याह् सप्पो। येसुई ख्युन बिस्वास रङरङ ल्हो मगुल्नान सिमी र्‌वाबो, “ङोह्जो, हिम्मत ख्या। नान तीपा माफ रह्पा।” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />कानुन लन्नान्न सिमिवन बर्ग हातिपाई राह्ङराङ्साः र्‌वाबो, “अन ता परमेस्वरन ल्हुई झाँ।” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />येसुई ख्युन समन ल्होई हाकोको र्‌वाबो, “ङेन तैङ जेँन समग नावा अलः खेनान? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />तैङर्‌वाङिन तै र्‌वाचे छुम्म ङ्याह्, ‘नान तीपा माफ रह्बो’ र्‌वाचे कि ‘च्याँ रे ल्हेना’ र्‌वाचे? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />जेङ्नै सिमिन ङोह्जोः पिर्थीबी तीपा माफ खेचेन आङ ङ्याह् र्‌वार्‌वा ङेनजै क्युई रा तयाःयो।” तब नुई मन ल्हो मगुल्नान्न नाह्जा ताह्पा सिमी र्‌वाबो, “च्याँ, नान खात हुरा, रे यिम वया।” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />आलै नु च्याङ्बो, रे जेँन यिम होई। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />जब सिमिवन मोह्ङजै अन रङ्बो, तब ख्यु ङिह्‌म्बो, रे सिमिकाङ्मोः झामन सक्ति बिन्नान परमेस्वरन प्रसङ्सा खेबो।<verse eid="MAT 9:8" /></para>
  <para style="s">मत्ती स्वा र्‌वापा</para>
  <para style="r">(<ref loc="MRK 2:13-17">मर्क २:१३-१७</ref>; <ref loc="LUK 5:27-32">लुक ५:२७-३२</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />येसु स्याह्‌लै वैतौ मत्ती र्‌वानान्न सिमिदी कर तुईनान्न यिम छ्युङ्पा रङ्बो, रे नू र्‌वाबो, “ङन ङिक जाः।” आलै नु च्याङ्बो रे नुन ङिक जाःबो।<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />“येसु मत्तीन यिम झाम छ्युङ्तौ, लैः कर तुईनानव रे पापीव स्वास्वा नु रे नुन चेलावन ङ्याबो झाम छ्युङ्बो।” <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />जब फरिसीवजै मन रङ्बो, तब नुन चेलाकाङ्मोः र्‌वाबो, “तैङ ङेनकोन गुरु कर तुईनानव रे पापीवन ङ्याबो झाँ?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />अन ताह्ताह् येसुई र्‌वाबो, “नाह्जा मीपा सिमिकाङ्मोः अम्जी मत्वानान, जेङ्नै नाह्‌प्पुवाकाङ्मोः त्वानान। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />जेङ्नै वैवै अन्न अर्थ तै जेङ्पा ङेन लह्‌ना ‘ङा बलिदान नङ्पा, दया चाई खेनान।’ तैङर्‌वाङिन ङा धर्मी नङ्पा, जेङ्नै पापीकाङ्मोः स्वा र्‌वामः स्वापा।”<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">मत्ती १२:७</ref>; <ref loc="HOS 6:6">होसे ६:६</ref></char></note><verse eid="MAT 9:13" /></para>
  <para style="s">बर्तन भारेः प्रस्‌न</para>
  <para style="r">(<ref loc="MRK 2:18-22">मर्क २:१८-२२</ref>; <ref loc="LUK 5:33-39">लुक ५:३३-३९</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />तब यूहन्नान चेलाव येसुन स्याह् स्वाबो, रे नू लोप्पो, “ङि रे फरिसीव बर्त छ्युङ्नान, जेङ्नै नान चेलाव तैङ बर्त मछ्यूँ?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />येसुई ख्युकाङ्मोः झब बिम्बो, “जबथाल भत्यारग माःपा लार्क्यावन ङ्याबो छ्यूँ, तै ख्यु बैराग खेनान तै? जेङ्नै मन्न ल्हाः स्वानान ङ्याह् जब माःपा ख्युन स्याह्‌लै वन्नान ङ्याह्। तब ख्यु बर्त छ्युङ्नान ङ्याह्।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“सुई घोलाङ घ्वापाः लाम्मा सार्बा मताम्नान। तैङर्‌वाङिन लाम्मा सार्बाई घोलाङ छ्योन्नान, रे घोलाङ झन ह्‌याल्म ज्योन्नान। <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />सुई फोन्न खुन्चा घ्वापाः अङ्‌गुरन खु सार्बा मनान्नान, तेमन्ता खुन्चा दिल्ङ, रे अङ्‌गुरन खु हाल्नान, रे खुन्चा मीपा राह्‌नान। जेङ्नै अङ्‌गुरन खु सार्बा फोन्न खुन्चा सार्बागै नान्नान। रे ङ्योरुम जोग्गी राह्‌नान।”<verse eid="MAT 9:17" /></para>
  <para style="s">याईरसन सिह्पान चमेः रे खङ्नान्न चिमिचा ताःपा</para>
  <para style="r">(<ref loc="MRK 5:21-43">मर्क ५:२१-४३</ref>; <ref loc="LUK 8:40-56">लुक ८:४०-५६</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />येसुई ख्युकाङ्मोः अन ल्होई र्‌वातौर्‌वातौ यहूदी जोम्पुन हाकिमदी स्वाबो, रे नू ध्वाः खेखे र्‌वाबो, “ङन चमेः घोमाः सिह्बो, जेङ्नै ना स्वास्वा नू ज्यार्ङिन नु सम्पु ग्युर्नान ङ्याह्।” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />येसु च्याङ्बो रे जेँन चेलावन ङ्याबो मन सासकन ङिक जाःबो। <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />मन्नै भेला च्योङे परालै कह वैनान्न नाह्जा रह्पा चिमिचादीजै ङिक्याँलै स्वास्वा येसुन घोलाङ्न नाः ज्यार्बो।<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="MAT 14:36">मत्ती १४:३६</ref></char></note> <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />तैङर्‌वाङिन नुई समसमग सोचि खेपा ङ्याह्, “ङै नुन घोलाङ मात्र ज्यार्ङिनै ङा ताःनान ङ्युँ।” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />ङिक होलहोल सेन्तौ येसुई मन चिमिचाः रङ्बो, रे र्‌वाबो, “चमेः, हिम्मत ख्या, नान बिस्वासजै नाः ताःफाम्पा ङ्याह्।” मन चिमिचा मन्नै भेला ताःबो। <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />आलै जब येसु हाकिमन यिम स्वा ताप्पो, नुई ल्यू बुन्नानव रे मोह्ङजै फाईराकुईरा खेपाई छ्युङ्पा रङ्बो। <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />नुई ख्युकाङ्मोः र्‌वाबो, खोलोः वया, तैङर्‌वाङिन चमेः सिह्पा मह्‌या, जेङ्नै आःपा ङ्याह्। ख्युई नुन माबी पप्पो। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />सिमिकाङ्मोः खोलोः छ्यूमी नु झिङ जाःबो, रे मन चमेःन लाह् जुङ्बो, आलै मन चमेः च्याङ्बो। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />मन्न छाम्म देसभरी अन ल्होईन भारेः चर्चा फेल्बो।<verse eid="MAT 9:26" /></para>
  <para style="s">येसुई काना सिमि ङेह्पाः ताःफाम्पा</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />येसु स्याह्‌लै वैतौ ङेह् काना सिमिव “हे दाऊदन ङोह्जो, ङी दया ख्या” र्‌वार्‌वा फाईरा खेईखेई नुन ङिह्‌ङिह्‌ जाःबो। <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />येसु यिम स्वामी मन ङेह् काना सिमिव रे स्याह्ई ताप्पो। येसुई ख्युकाङ्मोः लोप्पो, “तै ङै ङेनकाङ्मोः ताःफान तैनान र्‌वार्‌वा ङेनकाङ्मोः बिस्वास ङिह्पौ?” ख्युई र्‌वाबो, “अँ ङिह्पा, प्रभु।” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />तब येसुई ख्युन मी ज्यारज्यार र्‌वाबो, “ङेनकोन बिस्वास अन्सार ङेनकाङ्मोः राःयो।” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />आलै ख्युन मी पोङ्बो। येसुई झाःम र्‌वार्‌वा ख्युकाङ्मोः करा चेतावनी बिम्बो, “अन ल्होई सुई क्युई नराःयो।” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />जेङ्नै ख्यु होई, रे मन देसभरि नुन मिह्‌नकै फेल्बो।<verse eid="MAT 9:31" /></para>
  <para style="s">येसुई सिमि वाम्पाः ताःफाम्पा</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />जब ख्यु गेग्गे वैयङ खेपा ङ्याह्, तब मु ताह्ताह् वाम्पा सिमिदी येसुन स्याह् सप्पो। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />मु छ्यूमी मन वाम्पाई ल्होई र्‌वाबो। आलै “इस्राएलग हातौयै झाम मरङ्बो” र्‌वाईर्‌वाई सिमिवन मोह्ङजै हालाईबो। <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />जेङ्नै फरिसीव र्‌वामः जाःबो, “मुवन मालिकलम नुई मु छ्यूँ।”<verse eid="MAT 9:34" /></para>
  <para style="s">येसुई सिमिकाङ्मोः दया खेपा</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />येसु पुरू सहरव रे नामवक्याँ ख्युन यहूदीवन आराधनालयवग लह्‌नैलह्‌नै, राज्यन ल्होन् लः ताह्फेरैफेरै रे सिमिवन नाह्जा पुरु रे कमिकमजोरीव ताःफानैफानै होई।<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्ती ४:२३</ref>; <ref loc="MRK 1:39">मर्क १:३९</ref>; <ref loc="LUK 4:44">लुक ४:४४</ref></char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />जेङ्नै सिमिन मोह्ङकाङ्मोः रङरङ नुई ख्युकाङ्मोः यामयाम दिसाबो। तैङर्‌वाङिन ख्यु ग्वाल्या मीपान लूपावलैम तूरि देप्पा रे फुरी मदेप्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गन्ती २७:१७</ref>; <ref loc="1KI 22:17">१ झली २२:१७</ref>; <ref loc="2CH 18:16">२ इति १८:१६</ref>; <ref loc="EZK 34:5">इज ३४:५</ref>; <ref loc="MRK 6:34">मर्क ६:३४</ref></char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />तब नुई जेँन चेलाकाङ्मोः र्‌वाबो, “भालि हाति र्‌वार्‌वा ङ्याह्, जेङ्नै खेः धोन खेनान्न सिमिव ङाईदि ङ्याह्। <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />अन्नकारन भालिन ताःपोग सोअताबा, रे नुई जेँन बालि गम्नान्न खेः धोन खेनान्न सिमिव फेरा र्‌वार्‌वा छ्याःफुला।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">येसुई फेप्पान प्रेरित च्योङेपाव</para>
  <para style="r">(<ref loc="MRK 3:13-19">मर्क ३:१३-१९</ref>; <ref loc="MRK 6:7-13">६:७-१३</ref>; <ref loc="MRK 13:9-13">१३:९-१३</ref>; <ref loc="LUK 6:12-16">लुक ६:१२-१६</ref>; <ref loc="LUK 9:1-6">९:१-६</ref>; <ref loc="LUK 12:2-9">१२:२-९</ref>; <ref loc="LUK 21:12-17">२१:१२-१७</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />येसुई जेँन चेला च्योङेपाकाङ्मोः स्वा र्‌वार्‌वा मुव छ्यूनान रे तैस्याङ पुरून नाह्जा रे कमिकमजोरी ताःफान्चेन आङ ख्युकाङ्मोः बिम्बो। <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />प्रेरित च्योङेपावन मिह्‌न अनै जेङ्पा, ङूस्योवान पत्रुस र्‌वानान सिमोन रे नुन भाई अन्द्रियास, जब्दियान ङोह्जो याकूब रे नुन भाइ यूहन्ना, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />फिलिप रे बारथोलोमाइ, थोमा रे कर तुईनान्न मत्ती, अल्फयसन ङोह्जो याकूब रे थेदियस, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />सिमोन कनानी रे यहूदा इस्करियोत, सुई येसू जुङ्फाम्बो।<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />येसुई अन चेला च्योङेपाः झाःम र्‌वार्‌वा आदेस बिमबिम फेप्पो, “यहूदीन खोलोःन सिमिवन घूँ नवया, रे सामरीवन सहरग नजाः।”<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="JER 50:6">यर ५०:६</ref></char></note> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />जेङ्नै इस्राएल जातिन मोल्पान लूपावन स्याह् वया। <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />स्वर्गन राज्य रह्‌म्मः स्वा ताप्पा ङ्याह् र्‌वाईर्‌वाई ताह्फेरा। <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />खङ्नानकाङ्मोः ताःफाना। सिह्पाकाङ्मोः सम्पु धोँवा, कोरन नाह्जा ताह्पान सिमिकाङ्मोः छाङ्म धोँवा, मुकाङ्मोः छ्यूवा। ङेनजै भाछ्योँवाग देप्पा, भाछ्योँवाग भिना। <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />ङेन जेँन धबग मर, मुल रे पलेङ्न सिक्‌का नहुरा, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />लेन्चेन भिह्तु झोला, भन्दि छ्या ङेह्, पौला, पेर्गा नहोरा। तैङर्‌वाङिन खेः धोन खेनान्न सिमिजै नुन ङ्योप्पा देत्‌त्वानान।<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">१ कोर ९:१४</ref>; <ref loc="1TI 5:18">१ तिमो ५:१८</ref></char></note> <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />“कन सहर या नाम्‌ग ङेन जाःङ, स्याह्‌ सु लः ङ्याह् र्‌वार्‌वा फारा, रे स्याह्‌लै मवैन बेर स्याह्ई छ्योँवा। <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />मन यिमन झिङ जाःतौ सिह्‌म ङिह्पाऊ र्‌वा। <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />मन यिम सम स्योरस्योरलैम ङिङिन, ङेनकोन सान्ति मन यिम स्वाःयो। जेङ्नै मन सम स्योरस्योरलैम नह् र्‌वाङिन, ङेनकोन सान्ति ङेन स्याह्ई होलहोल स्वाःयो। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />यदि सुई ङेनकाङ्मोः स्वीकार मखेबो या ङेनकोन ल्होई मङ्याङ्‌ङिन, मन यिम आथबा सहरलै गेत्तौ जेँन लेह्‌न थल्जुप खारा।<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रे १३:५१</ref></char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, न्यायन ल्हाः मन थाउँन धसा खेरे बरु सदोम रे गमोरान धसा ह्‌याल्म कुतैनान राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्ती ११:२४</ref>; <ref loc="GEN 19:24-28">उत १९:२४-२८</ref>; <ref loc="LUK 10:4-12">लुक १०:४-१२</ref></char></note><verse eid="MAT 10:15" /></para>
  <para style="s">स्वामः जाःपान तेह्पफान्नान्न भारेः</para>
  <para style="r">(<ref loc="MRK 13:9-13">मर्क १३:९-१३</ref>; <ref loc="LUK 21:12-17">लुक २१:१२-१७</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“सेह्‌ना, ङा ङेनकाङ्मोः फारावन घूँ लूपा लैम फेप्पाई ङिह्पा, अन्नकारन ङेन भुलेन लैम जेर्म रे पुरेन लैम वाम्म रा।<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">लुक १०:३</ref></char></note> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />जेङ्नै सिमिवलम होसखेखे छ्योँवा, तैङर्‌वाङिन ख्युई ङेनकाङ्मोः अदालतवग थोन्नान ङ्याह्, रे ख्युन यहूदीन आराधनालयवग ङेनकाङ्मोः चेरन ताल्च्या फ्याङ्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">मर्क १३:९-११</ref>; <ref loc="LUK 12:11-12">लुक १२:११-१२</ref>; <ref loc="LUK 21:12-15">२१:१२-१५</ref></char></note> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />ङेन ङन खातिर हाकिम रे झलीवन ङू सोल्नान ङ्याह् रे अन ख्यु रे यहूदीन खोलोःन सिमिवन भिह्तु साँचि राह्‌नान ङ्याह्। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />जेङ्नै जब ख्युई ङेनकाङ्मोः जुङ्फाङ्‌ङ, तब कुजुई रे तै ल्होई र्‌वाचे र्‌वार्‌वा छरा नख्या। तैङर्‌वाङिन ङेनजै तै ल्होई र्‌वात्वानान, मन्नै भेला ङेनकाङ्मोः स्यान्नान ङ्याह्। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />तैङर्‌वाङिन ल्होई र्‌वानान ङेह् राह्‌नान मह्‌या, जेङ्नै ङेनकोन पा परमेस्वरन आत्मा ङेनलम ल्होई र्‌वानान ङ्याह्।” <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />“थिक्‌कोवजै जेँन भाइग सत्फान्चेन भिह्तु जुङ्फान्नान ङ्याह्, रे पाई ङोह्जो-चमेःग, रे ङोह्जो-चमेःव पोमावन बिरोधग च्याङ्नान ङ्याह् रे ख्युकाङ्मोः सत्फान्नान ङ्याह्। <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />ङन मिह्‌न्न खातिर सिमि पुरूवलम ङेन मस्याङ्नान राह्‌नान ङ्याह्। जेङ्नै सु अन्त्यन बेर स्थिर छ्यूँ, नुनै उद्धार राह्‌नान ङ्याह्। <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जब ख्युई ङेनकाङ्मोः सहरदीग तेह्पफाङ्‌ङ तब घङ सहरग झ्यारा। तैङर्‌वाङिन तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेन इस्राएलन सहर पुरूवग मतूपा रातौ यङ सिमिन ङोह्जो स्वानान ङ्याह्।” <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" />“चेला जेँन गुरु खेरे रे राङ्पा जेँन मालिक खेरे किम मराह्‌नान। <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />चेला जेँन गुरु लैम रे राङ्पा जेँन मालिक लैम राचे हाति र्‌वार्‌वा जेङ्पा। यदि ख्युई यिमन ताःपोग र्‌वार्‌वा बालजिबुल<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">सैतान</char></note> र्‌वापा ङ्याह् र्‌वाङिन, झन नुन पयारकाङ्मोः झन हाति ह्‌याल्म र्‌वादरा?” <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />“अन्नकारन ख्युन ङ्याबो नङिना। तैङर्‌वाङिन कप्‌कप्‌ मरङ्नान रे क्युक्यु क्युई मराह्‌नान तये मह्‌या। <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />तै ङा ङेनकाङ्मोः नाःतुमाः र्‌वानान, अन ङेनजै साल्मः र्‌वा, रे तै ङेनजै फाक र्‌वापान ल्होई नाम्ज्योवाग ताँ, अन ङेनजै यिमन ल्हुपलै ताह्फेरा। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />ख्युन ङ्याबो नङिना सुई ल्होग सह्ङ्‌ङ, जेङ्नै आत्माः सत मतैङ। बरु आत्मा रे ल्हो ङ्योरुमग ङ्यालाः मीपा दोङ तैनान परमेस्वरन ङ्याबो ङिना। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />तै सोह्ङदीग छिप्चा ङेह् मग्युर्नौ? मन्न बर्ग ती यङ ङेनकोन पान इच्छ्या मीम सा: छार्नान मह्‌या। <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />ङेनकोन थोप्पान छमव यङ पुरू जेर्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="LUK 12:7">लुक १२:७</ref></char></note> <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />अन्नकारन ङेन नङिना, ङेन लैः छिप्चा खेरे ह्‌याल्म मकेकुकेन कुम्म ङ्याह्।”<verse eid="MAT 10:31" /></para>
  <para style="s">येसू स्वीकार खेपा रे अस्वीकार मखेपा</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“अन्नकारन पुरू सुई सिमिवन ङू ङाः स्वीकार खेँ, ङा रे नू स्वर्गः छ्युङ्नान्न ङन पान ङू स्वीकार खेनान ङ्युँ। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />जेङ्नै पुरू सुई ङाः सिमिवन ङू अस्वीकार खेँ, ङा रे नू स्वर्गः छ्युङ्नान्न ङन पान ङू अस्वीकार खेनान ङ्युँ।”<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">२ तिमो २:१२</ref></char></note><verse eid="MAT 10:33" /></para>
  <para style="s">सान्ति नङ्पा जेङ्नै तरवाली</para>
  <para style="r">(<ref loc="LUK 12:52-53">लुक १२:५२-५३</ref>; <ref loc="LUK 14:26-27">१४:२६-२७</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“ङा पिर्थीबी सान्ति सस्सै स्वापा जेङ्पा र्‌वार्‌वा नछुव। सान्ति सस्सै नङ्पा, जेङ्नै ङा तरवाली कुल्चेन भिह्तु स्वापा जेङ्पा। <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />तैङर्‌वाङिन ङा सिमी नुन पान बिरोधग, रे चमेःग नुन मान बिरोधग, रे झाङ्‌ग नुन मेह्‌न बिरोधग सोल्मः स्वापा जेङ्पा। <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />सिमिवन बैरी नुन जेँन पयारन झिङनै सिमिव राह्‌नान ङ्याह्।” <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />“सुई ङाः खेरे ह्‌याल्म जेँन पा या माः मया खेँ, नु ङन सम स्योरस्योरलैम मराह्‌नान। सुई ङाः खेरे ह्‌याल्म जेँन ङोह्जो या चमेःग मया खेनान यङ ङन चेला राचेन सम स्योरस्योरलैम मराह्‌नान। <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />सुस्याङ जेँन क्रुस सोलसोल ङन ङिक मजाँः, नु ङन सम स्योरस्योरलैम मराह्‌नान। <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />सुई जेँन परान बचाई खेँ, नुई मन मोल्नान ङ्याह्, रे जेँन परान ङन भिह्तु मोल्नान सिमिजै चन जुनि देन्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">मत्ती १६:२५</ref>; <ref loc="MRK 8:35">मर्क ८:३५</ref>; <ref loc="LUK 9:24">लुक ९:२४</ref>; <ref loc="LUK 17:33">१७:३३</ref>; <ref loc="JHN 12:25">यूह १२:२५</ref> </char></note><verse eid="MAT 10:39" /></para>
  <para style="s">चेलाई देन्नान्न इनामन भारेः</para>
  <para style="r">(<ref loc="MRK 9:41">मर्क ९:४१</ref>; <ref loc="LUK 10:16">लुक १०:१६</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“ङेनकाङ्मोः स्वीकार खेनान्न सिमिजै ङाः स्वीकार खेँ, रे ङाः स्वीकार खेनान्न सिमिजै ङाः फेन्नानग स्वीकार खेँ। <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />सुई परमेस्वरन भबिस्यबक्ताग ‘भबिस्यबक्ता जेङ्पा’ र्‌वार्‌वा स्वीकार खेनानजै भबिस्यबक्तानै इनाम देन्नान ङ्याह्। उजुखेखेई परमेस्वरन ङू धर्मी रह्पा सिमी स्वीकार खेनानजै नुनै इनाम देन्नान ङ्याह्। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />सुई अन छ्युमवन बर्ग तीपाः ङन चेला छुछु खोरेदी त्यु भाम्म मात्र रानै थुङ फान्दरा, तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, नुई जेँन इनाम तै खेखेई मोल्नान मह्‌या।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">येसु रे बप्‌तिस्मा-बिन्नान्न यूहन्ना</para>
  <para style="r">(<ref loc="LUK 7:18-35">लुक ७:१८-३५</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />जेँन चेला च्योङेपाकाङ्मोः अन ल्होई र्‌वातामी येसु स्याह्‌लै ख्युन सहरवग लह्‌म्मः रे ल्होन् लः ताह्फेच्‌चेन भिह्तु होई। <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />बप्‌तिस्मा बिन्नान्न यूहन्नाई झ्यालखानाः रातौ येसु मसिहजै खेपान धोनवन भारेः ताह्बो, आलै नुई जेँन कान चेलाकाङ्मोः येसुन स्याह् अन ल्होई लोम्म फेप्पो, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />रे ख्युई येसुन स्याह् स्वास्वा झाम लोप्पो, “स्वानान चन नाई जेङ्पा, कि ङि घङ सुई कूचे?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />येसुई ख्युकाङ्मोः र्‌वाबो “ङेनजै ताह्पा रे रङ्पान ल्होईव यूहन्नाः र्‌वा, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />कानाव रङ्तैनान्न सिमि राँ, रे लुल्याव ल्हेङ्‌ङ। कोरन नाह्जा ताह्पान सिमिव छाङ्म रायङ ङ्याह्। नाम्ज्योवा मताह्‌नान्न सिमिव ताह्तैनान रह्पा ङ्याह्। सिह्पाव सम्पु राह्‌राह्‌ च्याङ्पा ङ्याह्, रे बिखारिकाङ्मोः ल्होन् लः ताह्फेप्पाई ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">यसै ३५:५-६</ref>; <ref loc="ISA 61:1">६१:१</ref></char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />ङन भारेः सङ्‌का मखेनान्न सिमि तेम्माई धन्न जेङ्पा।”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />आलै यूहन्नान चेलाव वैयङ खेतौ येसुई सिमिकाङ्मोः यूहन्नान भारेः र्‌वामः जाःबो, “ङेन सुनसान ठाउँग तै सेह्‌म्मः वैपा? तै लनजै कुल्पान मिन ल्हा? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />मराह्‌ङिन ङेन तै सेह्‌म्म वैपा? तै घोलाङ लः लः गोप्पान सिमी? घोलाङ लः लः गोन्नान्न सिमिव ता झलीवन यिम छ्यूँ। <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />तेम्माई र्‌वा लो ङेन तै सेह्‌म्म वैपा? तै कान अगमवक्ताग? हो, तेम्माई र्‌वाचे र्‌वाङिन ङेनजै भबिस्यबक्ता खेरै किम तीपाः सेह्‌म्म वैपा। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />तैङर्‌वाङिन पबित्रसास्त्रग परमेस्वरजै यूहन्नानै भारेः र्‌वापा ङ्याह्, ‘सेह्‌ना, नान ङू ङा ङन दुतग फेच्‌चे, आलै नुई नान लम तयार खेनान ङ्याह्।’ <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, चिमिचालम केह्पावन बर्ग बप्‌तिस्मा बिन्नान्न यूहन्ना खेरे किम घङ सुई रह्पा मह्‌या। जेङ्नै स्वर्गन राज्यग सु पुरून खेरे छ्युम ङ्याह्, नु यूहन्ना खेरै किम जेङ्पा। <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />बप्‌तिस्मा बिन्नान्न यूहन्नाई ताह्फेत्तौलै चोँनबेर स्वर्गन राज्य तोप खेखे ङू वैपाई ङ्याह्। आलै सक्तिसाली सिमिव हलजफत खेखे अनग जुङ्‌ङ।<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="LUK 16:16">लुक १६:१६</ref></char></note> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />तैङर्‌वाङिन बप्‌तिस्मा बिन्नान्न यूहन्नान पालिन बेर मोसान कानुन रे भबिस्यबक्ता पुरूवजै परमेस्वरन राज्यनै भारेः भबिस्यबानी र्‌वापा ङ्याह्। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ङेन स्वीकार खेमः ङ्याङ्‌ङिन, स्वात्वानान्न एलिया अनै जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मला ४:५</ref>; <ref loc="MAT 17:10-13">मत्ती १७:१०-१३</ref>; <ref loc="MRK 9:11-13">मर्क ९:११-१३</ref></char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />सुन ङ्यान्नान्न नाम्ज्योवा ङ्याह्, नुई ङ्यानाःयो। <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />“अन पुस्ताग ङा तैन ङ्याबो तुलना खेचे? ख्यु ता बजारग छ्युङछ्युङ जेँन फुरीवन ङ्याबो झामखेखे ल्होई र्‌वानान्न वैचाव लैम ङ्याह्। <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘ङी ङेन भिह्तु ल्यू बुप्पा, जेङ्नै ङेन मछ्याम्बो। ङी बैराःन धेन धेपा, जेङ्नै ङेनजै बैराग मखेबो।’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />जेङ्नै यूहन्ना झाईझाई रे थुङैथुङै मस्वाबो, रे ख्युई नू मुई सेम्पा सिमि र्‌वाबो। <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />सिमिन ङोह्जो झाईझाई रे थुङैथुङै स्वाबो, रे ख्युई र्‌वाङ, ‘सेह्‌ना, झाचे मदेप्पा, थुङ्चे मदेप्पा, कर तुईनान रे पापीवन फुरी’ र्‌वार्‌वा दोस खेँ। परमेस्वरन छोएग नुन धोनजै र्‌वार्‌वा तेम्मा ठहर्याई खेँ।”<verse eid="MAT 11:19" /></para>
  <para style="s">बिस्वास मखेनान्न सहरव</para>
  <para style="r">(<ref loc="LUK 10:13-15">लुक १०:१३-१५</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />कन-कन सहरग येसुई खेपान ताईलुवान धोनव लैः ङ्याह्, नुई मन सहरवग धिक्‌कार रा र्‌वामः जाःबो, कारन ख्युई घ्योप्पा मखेबो। <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“धिक्‌कार नाः, ए खोराजीन! धिक्‌कार नाः, ए बेथसेदा! तैङर्‌वाङिन ङेन स्याह् खेपान सक्तिसाली धोनव दुङाल देप्पान तुरोस रे सीदोनग खेपा जेङ्न ख्युई लैःलै सोला छिनछिन रे माला छिनछिन घ्योप्पा खेतपा राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">यसै २३:१-१८</ref>; <ref loc="EZK 26:1-21">इज २६:१-२१</ref>; <ref loc="JOL 3:4-8">योए ३:४-८</ref>; <ref loc="AMO 1:9-10">आमो १:९-१०</ref>; <ref loc="ZEC 9:2-4">जक ९:२-४</ref></char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, न्यायन दिनग ङेन खेरे ता तुरोस रे सीदोन्न हालत ह्‌याल्म कुतैनान राह्‌नान ङ्याह्। <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />ए कफर्नहुम, तै ना पान्नाङ थालै थीनान ङ्याह् तै? ना पातालथाल घ्या फान्नान ङ्याह्। तैङर्‌वाङिन नान स्याह् खेपान ताईलुवान धोनव सदोमग रह्पा जेङ्न अन त्यान लाह्‌न बेर लुईपा ङिम्तौ।<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">यसै १४:१३-१५</ref>; <ref loc="GEN 19:24-28">उत १९:२४-२८</ref></char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, फैसलान ल्हाः नान धसा खेरे ता सदोम सहरन दसा ह्‌याल्म कुतैनान राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्ती १०:१५</ref>; <ref loc="LUK 10:12">लुक १०:१२</ref></char></note><verse eid="MAT 11:24" /></para>
  <para style="s">ङन ङिक स्वा रे नाह्ः</para>
  <para style="r">(<ref loc="LUK 10:21-22">लुक १०:२१-२२</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />मन्न भेला येसुई र्‌वाबो, “हे पा, स्वर्ग रे पिर्थीबिन प्रभु, ङा ना मया रह्बो र्‌वाचे, तैङर्‌वाङिन नाई अन ल्होई बुद्धिमानी रे हाकोनान्न सिमिवलम फाक नाह्‌म्बो, आलै वैचाकाङ्मोः मन थम्बो। <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />जेङ्पा, पा, तैङर्‌वाङिन नाः अनै लः छुबो।” <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />“ङन पाई तैस्याङ पुरू ङाः थोप्पा ङिह्पा। पा नङ्म ङोह्जोः सुई मस्योःङ, रे ङोह्जो नङ्म पाः सुई मस्योःङ, आलै ख्युई र्‌वार्‌वा स्योःङ सू ङोह्जोई पा थनसुम खेँ।”<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">यूह ३:३५</ref>; <ref loc="JHN 1:18">१:१८</ref>; <ref loc="JHN 10:15">१०:१५</ref></char></note> <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />“हे पुरू गोप्पा रे तूरि देप्पा हो, ङन स्यीह् स्वा, ङा ङेनकाङ्मोः नाह्ःफान्नान ङ्युँ। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />ङन सिङ्‌कुल जेँन लाह्ः होरा, रे ङन लम लह्‌ना, तैङर्‌वाङिन ङा समग दिसानान रे बिनम्र ङिह्पा, आलै ङेनजै जेँन आत्माग नाःचे देन्नान ङ्याह्। <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />तैङर्‌वाङिन ङन सिङ्‌कुल छुम्म ङिह्पा, रे ङन हुर भोङ्म ङिह्पा।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">नाह्‌न लाह्ःन भारेः लोप्पा</para>
  <para style="r">(<ref loc="MRK 2:23-28">मर्क २:२३-२८</ref>; <ref loc="MRK 3:1-6">३:१-६</ref>; <ref loc="LUK 6:1-11">लुक ६:१-११</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />मन्न भेलाः येसु नाह्‌न ल्हाः रुन्जन्न खेःवलम राह्‌राह्‌ वैयङ खेपा ङ्याह्। नुन चेलाव गुसिह्पा ङ्याह् रे रुन्जन्न नम चाह्ईचाह्ई झामः जाःबो। <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />जेङ्नै फरिसीवजै अन रङरङ येसू र्‌वाबो, “सेह्‌ना, नान चेलाव नाह्‌न ल्हाः कानुनजै खेचे नङ्पा र्‌वापान धोन यङ खेँ।”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />जेङ्नै येसुई ख्युकाङ्मोः र्‌वाबो, “दाऊदजै, नु रे नुन फुरिव गुसितौ तै खेपा ङ्याह्, तै ङेनजै तोअपा मीपाऊ?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">१ सामू २१:१-६</ref></char></note> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />नुई परमेस्वरन भबन्न झिङ जाःजाः नू फुल्पान पबित्र रोता फुरीवन ङ्याबोई दीदी झबो। कानुन्न अन्सार पुजारी नङ्म घङ सुई यङ मन रोता झाचे लः मह्‌या। <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />आथबा तै कानुनग तोअपा मीपाऊ, कुजुई नाह्‌न ल्हाः पुजारीवजै आराधनालयग नाह्‌न लाह्‌न आग्या मङ्याङ्‌ङ, जेङ्नै निर्दोस थहरी राँ?”<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">गन्ती २८:९-१०</ref></char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />“जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, आराधनालय खेरे किम यङ कान स्यीह् ङ्याह्। <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />जेङ्नै पबित्रसास्त्रग सर्पा ङ्याह्, ‘ङा बलिदान नङ्पा, दया चाहि खेनान’ र्‌वापान अर्थ तै जेङ्पा अन ङेनजै हाकोपा जेङ्न ङेनजै निर्दोसी दोस बिन्नान मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्ती ९:१३</ref>; <ref loc="HOS 6:6">होसे ६:६</ref></char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />तैङर्‌वाङिन सिमिन ङोह्जो नाह्‌न ल्हाःन प्रभु जेङ्पा।”<verse eid="MAT 12:8" /></para>
  <para style="s">येसुई लाह् खार्पा सिमी ताःफाम्पा</para>
  <para style="r">(<ref loc="MRK 3:1-6">मर्क ३:१-६</ref>; <ref loc="LUK 6:6-11">लुक ६:६-११</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />स्याह्‌लै गेग्गे येसु ख्युन आराधनालयग होई। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />स्याह् ल्हा खार्पा सिमिदी ङ्याह्। ख्युई येसू दोस बिनसुमजै नू लोप्पो, “कानुन्न अन्सार तै नाह्‌न ल्हाः सुई ताःफान्चे लः ङ्याह्‌यौ?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेन बर्ग सुई लूपादी ङ्याह्, रे नाह्‌न ल्हाः मन लुह्‌मग छार्ङिन, तै ना नू जुङजुङ खोलोः मछ्यूनान तै?<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">लुक १४:५</ref></char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />लूपा खेरे ता सिमि लैः कुम्म जेङ्पा। अन्नकारन कानुन अन्सार यङ नाह्‌न ल्हाः सिमिन भलो खेचे लः ठहरि राह्‌नान।” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />तब नुई मन सिमी र्‌वाबो, “नान लाह् क्याँ।” नुई लाह् क्याङ्बो, रे मन घङ लाह् लैम लः रह्पा। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />जेङ्नै फरिसीवजै खोलोः वैवै नू कुजुई सच्‌चे र्‌वार्‌वा नुन बिरोधग दीदी सल्‌ला खेमः जाःबो।<verse eid="MAT 12:14" /></para>
  <para style="s">परमेस्वरजै दम्पान सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />तब मन ल्होई क्युई राह्‌राह्‌ येसु स्याह्‌लै होई, रे सिमि लैः नुन ङिक जाःबो, रे नुई ख्यु पुरूग ताःफाम्बो, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />जेङ्नै नुई ख्युकाङ्मोः अन्न भारेः सुई तये नर्‌वा, र्‌वानान्न चेतावनी बिम्बो। <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />झामखेखे परमेस्वरजै यसैया भबिस्यबक्तालम र्‌वापान अन ल्होई पुरा राचेन भिह्तुई अन रह्पा जेङ्पा, <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />“ङन राङ्पा सू ङै दम्पा ङिह्पा, ङन स्याङ्पा सुन ङ्याबो ङा किम्म ङिह्पा, ङा ङन आत्मा नुग फेन्नान ङ्युँ, रे नुई यहूदीन खोलोःन सिमिकाङ्मोः न्यायन ताह्फेन्नान ङ्याह्। <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />नु न ता याल खेनान ङ्याह् न मिह्दा फाईरा खेनान ङ्याह्, न ता सुई नुन केह्ः गल्‌लीवग ताह्‌नान ङ्याह्। <verse eid="MAT 12:19" /><verse number="20" style="v" sid="MAT 12:20" />दिल्पान मि नुई क्युत्नान मह्‌या, रे सिमः जाःपान लज्युङ नुई सन्नान मह्‌या, रे अन्त्यग न्यायग क्याल्नान्न बेर साःनान ङ्याह्। <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />आलै नुनै मिह्‌नग सन्सारन सिमि पुरूवजै आस नान्नान ङ्याह्।”<verse eid="MAT 12:21" /></para>
  <para style="s">येसु रे बालजिबुल</para>
  <para style="r">(<ref loc="MRK 3:20-30">मर्क ३:२०-३०</ref>; <ref loc="LUK 6:43-45">लुक ६:४३-४५</ref>; <ref loc="LUK 11:14-23">११:१४-२३</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />तब नुन स्याह्‌ मुई सेम्पा काना रे वाम्पा सिमिदी सप्पो। येसुई नू ताःफाम्बो, अकेह्थाल कि, स्याह्‌न वाम्पा सिमि ल्होई र्‌वा तैनान रे रङ तैनान रह्बो। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />आलै सिमिन मोङ पुरूजै हालाईलाई र्‌वाबो, “तै अन दाऊदनै सन्तान जेङ्पाऊ?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />जेङ्नै अन ताह्ताह् फरिसीवजै र्‌वाबो, “अन सिमिजै मुन मालिक बालजिबुललम मात्र मुकाङ्मोः धाङ्‌ङ।” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />जेङ्नै येसू ख्युन नावा क्युई राह्‌राह्‌ ख्युकाङ्मोः र्‌वाबो, “राह्ङराङ्साः बिरोधि रह्पान राज्य पुरू मीपा दोङ्नान ङ्याह्, रे सहर आथबा पयार पुरू जेँनै घूँ याल राङिन थुप्नान मह्‌या। <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />यदि सैतानजै सैतानग छ्यूङिन, नु जेँन बिरोधग भानान, रे आन नुन राज्य कुजुई थुप तैनान? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />यदि ङै बालजिबुललम मुव धाङ्‌ङिन, ङेनकोन ङोह्जोवजै चन सुलम मन छ्यूङ? अन्नकारन ख्युई ङेनकोन न्यायकर्ता राह्‌नान ङ्याह्। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />जेङ्नै यदि परमेस्वरन आत्मालम ङा मुव धान्नान र्‌वाङिन परमेस्वरन राज्य ङेन स्याह् स्वातपा ङ्याह्।” <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />आलै ह्‌याङ “ङू ङार्छेम सिमी मखीरे, नुन यिमन झिङ जाःजाः सुई नुन क्यु वव्वै वै तैनौ? मन ङार्छेम सिमी खीतामी मात्र नुन यिम खु तैनान।” <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />“सु ङन ङ्याबो मह्‌या, नुन ङन बिरोधग ङ्याह्, रे सुई ङन ङ्याबो मरूङ, नुई छरपस्त पारि खेँ। <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />अन्नैकारन ङा ङेनकाङ्मोः र्‌वाचे, सिमिवजै खेपान तीपा पुरू रे लान ल्हुई झपा माफ राह्‌नान ङ्याह्, जेङ्नै पबित्र आत्मान बिरोधग झपान ल्हुई माफ राह्‌नान मह्‌या। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />सुई सिमिन ङोह्जोन बिरोधग तयाः र्‌वाङिन नू माफ राह्‌नान ङ्याह्, जेङ्नै सुई पबित्र आत्मान बिरोधग ल्होई र्‌वाङिन नू अन काल्बाग रे स्वानान्न काल्बागै माफ राह्‌नान मह्‌या।” <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />“कि तङ्पू लः धोँवा, रे नुन फल लः राह्‌नान ङ्याह्। कि तङ्पू अलः धोँवा रे नुन फल यङ अलः राह्‌नान ङ्याह्। तैङर्‌वाङिन माह्‌लमै तङ्पु स्योःनान।<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">मत्ती ७:२०</ref>; <ref loc="LUK 6:44">लुक ६:४४</ref></char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />ए भुलेन्न वैचा हो! ङेह् अलः ङ्याह्, ल्होई लः कुजुई र्‌वा तैनान? तैङर्‌वाङिन समग नाङ्पान ल्होईव यङ ङुरलम गेङ्‌ङ। <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />सिमि लःजै जेँन समग ङिह्पान ल्होई लःन भकारिलै ल्होई लःई छ्यूनान, जेङ्नै सिमि अलःजै ल्होई अलःन भकारिलै ल्होई अलःई छ्यूनान। <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />ङा ङेनकाङ्मोः र्‌वाचे, फान मराह्‌नान्न ल्होई पुरू कन सिमिव र्‌वाङ, ‘न्यायन दिनग ख्युई मन्न हिसाब बिनत्वानान ङ्याह्।’ <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />तैङर्‌वाङिन नान ल्होईवजै ना निर्दोस ठहरी राह्‌नान ङ्याह्, रे नान ल्होईवजै ना दोसी ठहरी राह्‌नान ङ्याह्।”<verse eid="MAT 12:37" /></para>
  <para style="s">योनान ताह्</para>
  <para style="r">(<ref loc="MRK 8:11-12">मर्क ८:११-१२</ref>; <ref loc="LUK 11:29-32">लुक ११:२९-३२</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />तब कानुन लन्नान्न सिमिव रे फरिसीवन बर्ग कान-कानजै नू र्‌वाबो, “गुरुज्यू, ङि नानलम ताह्दी सेनसुम ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">मत्ती १६:१</ref>; <ref loc="MRK 8:11">मर्क ८:११</ref>; <ref loc="LUK 11:16">लुक ११:१६</ref></char></note> <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />येसुई ख्युकाङ्मोः झब बिम्बो, “अलः रे ब्यभिचारी पुस्ताई ताईलोवान धोन खेपा सेन्चे फान्नान। जेङ्नै अन पुस्ताः योना भबिस्यबक्ताः रह्पान ताह् नङ्म घङ ताईलोवान धोन बिन्नान मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">मत्ती १६:४</ref>; <ref loc="MRK 8:12">मर्क ८:१२</ref></char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />तैङर्‌वाङिन कुजुई योना ङाह् किमन फौन झिङ ङिम सुमङी रे छान सुमङी लुईबो, उजुखेखेई सिमिन ङोह्जो यङ पिर्थीबिन फौग ङिम सुमङी रे छान सुमङी लुईनान ङ्याह्। <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />निनब्बेन सिमिव परमेस्वरन न्यायन दिनग अन पुस्तान ङ्याबो च्याङ्नान ङ्याह्, रे नू दोसी ठहर्याई खेनान ङ्याह्। तैङर्‌वाङिन ख्युई योनान ताह्फेःग घ्योप्पा खेपा ङ्याह्, जेङ्नै सेह्‌ना, योना खेरै किम सुई स्यीह् ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 3:5">योना ३:५</ref></char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />ज्याङन मकेकुकेन किम झलीमा न्यायन दिनग अन पुस्तान ङ्याबो च्याङ्नान ङ्याह्, रे अनग दोसी ठहर्याई खेनान ङ्याह्, तैङर्‌वाङिन नु पिर्थीबिन धिङाःन नाःलै सोलोमन्न बुद्धिन ल्होई ङ्यान्चेन भिह्तु स्वाबो। जेङ्नै सेह्‌ना, सोलोमन खेरे किम सुई स्यीह् ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">१ झली १०:१-१०</ref>; <ref loc="2CH 9:1-12">२ इति ९:१-१२</ref></char></note><verse eid="MAT 12:42" /></para>
  <para style="s">आत्मा बाःपा होलहोल स्वानान</para>
  <para style="r">(<ref loc="LUK 11:24-26">लुक ११:२४-२६</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“जब आत्मा बाःपा सिमिलम गेग्गे वैङ, नु नाह्पु फारैफारै ओबानो ठाउँराः तुह्ईतुह्ई ल्हेङ्‌ङ, जेङ्नै खारै मदेन्नान। <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />तब नुई र्‌वाङ, ‘खालै ङा गेग्गे स्वापा, स्याह्‌ई जेँन यिम ङा होलहोल वैनान ङ्युँ।’ होलहोल स्वातौ नुई यिम होङ, खामसाङ्म दोङदोङ नाङ्पा, रे छ्याईपा दोःनान। <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />तब नु वैङ रे जेँन खेरे हेँ अलः घङ नेह्पा थाम मुन आत्मा जेँन ङ्याबो सन्नान, रे झिङ जाःजाः ख्यु स्याह् छ्यूँ, रे मन सिमिन ङिस्योवान दसा ङूस्योवान खेरे हेँ अलः राँ। अन अलः पुस्ताः र्‌वार्‌वा उजुई राह्‌नान ङ्याह्।”<verse eid="MAT 12:45" /></para>
  <para style="s">येसुन मा रे भाइव</para>
  <para style="r">(<ref loc="MRK 3:31-35">मर्क ३:३१-३५</ref>; <ref loc="LUK 8:19-21">लुक ८:१९-२१</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />येसुई सिमिवन मोङग अन ल्होईव र्‌वातौर्‌वातौ नुन मा रे थिक्‌कोव स्याह् ताप्पो। ख्युई येसुन ङ्याबो ल्होई र्‌वाकोए ङिह्पा र्‌वार्‌वा जेँ खोलोःई छ्युङछ्युङ सिमिदीग येसू अन ल्होई स्याप्म फेप्पो। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />तब तीपाई येसू र्‌वाबो, “सेह्‌ना, नान मा रे नान थिक्‌कोव खोलोः थाङथाङ छ्युङपा ङ्याह्, रे नान ङ्याबो ल्होई र्‌वासुम खेँ।” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />जेङ्नै नुन ङ्याबो ल्होई र्‌वानान सिमी येसुई र्‌वाबो, “ङन मा सु जेङ्पा? ङन थिक्‌कोव सु जेङ्पा?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />आलै नुई जेँन लाह्जै चेलाकाङ्मोः थनैथनै र्‌वाबो, “सेह्‌ना ङन मा रे ङन थिक्‌कोव। <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />तैङर्‌वाङिन सुई स्वर्गः ङिह्पान ङन पान इच्छा ङ्याङ्‌ङ, नुई र्‌वार्‌वा ङन थिक्‌कोव, रे ङन बहिनी, रे ङन मा जेङ्पा।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">र्‌यु पन्नान्न द्रिस्तान्त</para>
  <para style="r">(<ref loc="MRK 4:1-12">मर्क ४:१-१२</ref>; <ref loc="LUK 8:4-10">लुक ८:४-१०</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />मन्नै लाह्ः येसु यिमलै गेग्गे समुद्रन नाः लह्‌म्मः छ्युङ्बो। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />आलै सिमिवन अकेः मोङ किम नुन रह्‌म्म जोम्बो, कि नु दोङाः चपचप छ्युङ्बो, आलै सिमि पुरूव नाः थाङथाङ छ्युङ्बो।<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लुक ५:१-३</ref></char></note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />येसुई मन सिमिकाङ्मोः ल्होई लैः द्रिस्तान्तन रुपग झाम रुह्ङदी र्‌वाबो। नुई र्‌वाबो, “तीँ तीपा र्‌यु पन्नान र्‌यु पह्‌म्मः गेप्पो।” <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />“आलै झामखेखे पह्‌न्तौ कान र्‌यु लम्‌राः छार्बो, रे युजुई स्वास्वा मन झबो। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />कान र्‌यु ताङ्‌खोराःन साः छार्बो, खाः सा लैः मह्‌या, रे सा तिङ मरह्पान कारन मन खम्मै थुङ्बो। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />जेङ्नै जब ङिह्‌मा स्याःबो रे पादा मीपा राह्‌राह्‌ मन खार्बो। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />कान र्‌यु चन चेरवन घूँ छार्बो, जेङ्नै चेरव छारछार स्वाबो रे नू च्योर्बो। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />कान र्‌यु सा लग छार्बो, रे कानजै ङाथल, कानजै सुमथल, कानजै सुमच्यु गुना फल बिम्बो। <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />येसुई र्‌वाबो, सुन नाम्ज्योवा ङ्याह्, नुई ङ्यानाःयो।”<verse eid="MAT 13:9" /></para>
  <para style="s">द्रिस्तान्तन अर्थ</para>
  <para style="r">(<ref loc="MRK 4:1-12">मर्क ४:१-१२</ref>; <ref loc="LUK 8:9-10">लुक ८:९-१०</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />आलै चेलाव स्वास्वा येसू र्‌वाबो, “ना ख्युन ङ्याबो तैङ द्रिस्तान्तवग ल्होई र्‌वानान?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />येसुई ख्युकाङ्मोः झब बिम्बो, “ङेनकाङ्मोः ता स्वर्गन राज्यन रहस्यवन ग्यान बिम्पा ङ्याह्, जेङ्नै ख्युकाङ्मोः चन बिम्पा मह्‌या। <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />तैङर्‌वाङिन सुन ङ्याबो ङ्याह्, नू हेँ ह्‌याल्म बिन्नान ङ्याह्, रे नुन ङ्याबो हाति र्‌वार्‌वा राह्‌नान ङ्याह्। जेङ्नै सुन ङ्याबो मह्‌या, नुन ङ्याबो ङिह्पा यङ नुन लम तल्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">मत्ती २५:२९</ref>; <ref loc="MRK 4:25">मर्क ४:२५</ref>; <ref loc="LUK 8:18">लुक ८:१८</ref>; <ref loc="LUK 19:26">१९:२६</ref></char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />अन्नैकारन ङा ख्युन ङ्याबो द्रिस्तान्तग ल्होई र्‌वानान: तैङर्‌वाङिन ख्यु सेन्चे ता सेह्ङ्‌ङ, जेङ्नै मरँ, ङ्यान्चे ता ङ्याङ्‌ङ, जेङ्नै ताह्ताह् हामकोँ। <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />यसैयान भबिस्यबानी ख्युन स्याह् पुरा रह्पा ङ्याह् “ङ्यान्चे ता ङेन ङ्याङ्‌ङ, जेङ्नै हातौयै हामकोँ, सेन्चे ता सेह्ङ्‌ङ, जेङ्नै हातौयै मरँ।<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यसै ६:९-१०</ref></char></note> <verse eid="MAT 13:14" /><verse number="15" style="v" sid="MAT 13:15" />तैङर्‌वाङिन अन सिमिवन सम पुल्म रह्पा ङ्याह्, रे ख्युन नाम्ज्योवा मताह्‌नान रह्पा ङ्याह्, रे ख्युई जेँन मी चिम खेपा ङ्याह्, तेमन्ता ख्युई मीजै रङ्नान ङ्याह्, नाम्ज्योवाई ताह्‌नान ङ्याह्, समजै हाकोनान ङ्याह्, रे होल्नान ङ्याह्, रे ङा ख्युकाङ्मोः ताःफान्नान ङ्याह्। <verse eid="MAT 13:15" /><verse number="16" style="v" sid="MAT 13:16" />जेङ्नै ङेन चन धन्न जेङ्पा। ङेनकोन मीजै रँ रे नाम्ज्योवाजै ताँ।<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">लुक १०:२३-२४</ref></char></note> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, ङेनजै रङ्पान ल्होई लैः भबिस्यबक्तावजै रे धर्मी सिमिवजै यामयाम सेनसुम खेपा ङ्याह्, जेङ्नै मरङ्बो, आलै ङेनजै ताह्पान ल्होई यामयाम ङ्यानसुम खेपा ङ्याह्, जेङ्नै मह्ताबो।<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“र्‌यु पन्नान्न द्रिस्तान्तन अर्थ ङ्याना। <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />जब कान सिमिवजै स्वर्गन राज्यन बचन ङ्याङ्‌ङ, रे अन हामकोँ, तब आत्मा अलः स्वानान रे नुन समग तै पप्पा ङ्याह् अन तलतल वन्नान। लम्‌राः पप्पान र्‌यु चन मनै जेङ्पा। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />आलै सा ताङ्‌खोराः पप्पा र्‌यु चन मन जेङ्पा, सुई बचन ङ्यानलुङ्मीम स्याङस्याङ समग वङ्‌ङ। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />जेङ्नै नुन जेँन पादा मीपा राह्‌राह्‌ मन ङाईदिन बेर मात्र थुप्ङ, बचन्न कारनजै तूरि या तेह्पफान्नानग थेपलुङ्मीम मन ङिक च्योल्ङ। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />चेरवग पप्पा र्‌यु चन मन जेङ्पा, सुई बचन ङ्याङ्‌ङ, जेङ्नै अन सन्सारन छरा रे क्युन लोभजै बचनग च्योर्ङ, रे मन फल मछ्याःनान राह्‌नान। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />जेङ्नै सा लग पप्पा र्‌यु चन मन जेङ्पा, सुई बचन ङ्याङ्‌ङ, रे हाकोँ, रे तेम्माई फल छ्याःङ। नुई पप्पान र्‌युलम गुना ङाथल, गुना सुमथल रे गुना सुमच्यु फल छ्याःङ।”<verse eid="MAT 13:23" /></para>
  <para style="s">सामान द्रिस्तान्त</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />येसुई ह्‌याङ ख्युकाङ्मोः घङ द्रिस्तान्त स्याप्पो, “स्वर्गन राज्य सिमि तीपा लैम जेङ्पा, सुई जेँन खेः र्‌यु लः पप्पो। <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />जेङ्नै सिमिव आःपान भेला नुन बैरि स्वाबो, रे रुन्जन्न घूँ-घूँ सामान र्‌युको पप्पे होई। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />जब रुन्जन्न बोती गेग्गे मनग गेल्‌ला छ्याःबो, तब सामा यङ रङ्बो।” <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />“यिमन ताःपोन राङ्पावजै स्वास्वा नू र्‌वाबो, ‘गुरू, तै नाई जेँन खेः र्‌यु लः पप्पा नङ्पाऊ? स्याह् सामा खालै स्वाबो?’” <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />“यिमन तापोई ख्युकाङ्मोः र्‌वाबो, ‘कान बैरिजै झाम खेपा जेङ्पा।’ राङ्पावजै नू र्‌वाबो, ‘तै ङि वैवै मन सामाव पिङ्‌ङी?’” <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />“जेङ्नै नुई र्‌वाबो, ‘उजु नख्या, तेमन्ता ङेनजै सामा पिङ्तौ रुन्जन यङ पिङ्दरा। <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />बालि चाह्‌नान्न भेला बेर ङ्योरुमग ङ्याबो ङ्याबोई छार्फाना। बालि चाह्‌नान्न भेला ङा गम्नानकाङ्मोः र्‌वानान ङ्युँ,’ ‘ङू सामा पिङ्पिङ् मेह्ः तुन्चेन भिह्तु पोला ध्वाँ, जेङ्नै रुन्जन चन तुह्ईतुह्ई ङन स्योह्बुङग नाह्‌ना।’”<verse eid="MAT 13:30" /></para>
  <para style="s">रायोन र्‌यु रे सोरान द्रिस्तान्त</para>
  <para style="r">(<ref loc="MRK 4:30-34">मर्क ४:३०-३४</ref>; <ref loc="LUK 13:18-21">लुक १३:१८-२१</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />येसुई ख्युकाङ्मोः घङ द्रिस्तान्त र्‌वाबो, “स्वर्गन राज्य छून र्‌यु लैम जेङ्पा, कन सिमि तीपाई वव्वै जेँन बारी पाःबो। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />मन र्‌यु पुरूवग छ्युम राह्‌नान, जेङ्नै जब छार्ङ, तब मन सागपात पुरूव खेरे किम राह्‌नान रे तङ्पुई राह्‌नान। पान्नाङन युजुव स्वास्वा मन्न धावग चाङ धोँ।” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />येसुई ख्युकाङ्मोः घङ द्रिस्तान्त र्‌वाबो, “स्वर्गन राज्य सोरा लैम जेङ्पा, कन चिमिचादीजै किलोग्राम सुमच्यु राःपि होम्बो, रे अन पुरू सोरा बारबार ठिक मह्‌रान बेर नू तीपू नाह्‌म्बो।” <verse eid="MAT 13:33" /><verse number="34" style="v" sid="MAT 13:34" />येसुई अन ल्होई पुरू सिमिन मोह्ङग द्रिस्तान्तग र्‌वाबो। द्रिस्तान्त मीम नुई ख्युकाङ्मोः तये मर्‌वाबो। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />भबिस्यबक्तालम झाम र्‌वापान बचन पुरा रह्बो,</para>
  <para style="q1" vid="MAT 13:35">“ङा जेँन ङुर द्रिस्तान्तवग पोङ्नान ङ्युँ,</para>
  <para style="q1" vid="MAT 13:35">सन्सारन स्रिस्तिलै क्युक्यु नाम्पान ल्होईव ङा र्‌वानान ङ्युँ!”<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">भजन ७८:२</ref></char></note><verse eid="MAT 13:35" /></para>
  <para style="s">सामान द्रिस्तान्तन अर्थ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />मन्न छाम्म पुरू सिमिकाङ्मोः स्याह्ई ख्योवाख्योवा येसु यिमक्याँ होई। नुन चेलाव नुन स्याह् वैबो रे र्‌वाबो, “घलि छ्याचल ङी खेःन सामान द्रिस्तान्तन अर्थ र्‌वा।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />येसुई झब बिम्बो, “खेः र्‌यु लः पन्नान्न सिमिन ङोह्जो जेङ्पा। <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />सन्सारै खेः जेङ्पा। र्‌यु लःव राज्यन परमेस्वरनै सिमिव जेङ्पा। सामा सैतान्न सन्तानव जेङ्पा। <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />आलै र्‌यु अलःव पन्नान बैरि चन सैतान जेङ्पा। साह्ई गम्नान्न भेला चन सन्सारन अन्त्य जेङ्पा। आलै साह्ई गम्नानव स्वर्गदुतव जेङ्पा।”<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />“सामाव रूमी मन मेह्ग कोःनान ङ्याह्, सन्सारन अन्त्यगै उजुई राह्‌नान ङ्याह्। <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />मन्न लाह्ः सिमिन ङोह्जोई जेँन स्वर्गदुतकाङ्मोः फेन्नान ङ्याह् रे ख्युई नुन राज्यभरिन कानुन मङ्यान्नान रे कानुन ङ्यान फान्नानव पुरूग रूनान ङ्याह्। <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />छ्याप्पान मेह्ग पन्नान ङ्याह्। स्याह् सिमिव दाईदाई सो चपैचपै छ्युङ्नान ङ्याह्। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />परमेस्वरन ङू धर्मी ठहरी राह्‌नानव चन जेँन पा परमेस्वरन राज्यग ङिह्‌मा लैम चम्कि राह्‌राह्‌ छ्युङ्नान ङ्याह्। सुन नाम्ज्योवा ङ्याह्, नुई ङ्यानाःयो।”<verse eid="MAT 13:43" /></para>
  <para style="s">लुम्पा क्युन द्रिस्तान्त</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“स्वर्गन राज्य कान खेदीग लुम्‌लुम नाम्पान लुम्पा क्यु लैम जेङ्पा। कन सिमि तीपाई दोदो क्युक्यु नान्नान, रे नु स्याङ्स्याङ नु वैनान रे जेँन ङ्याबो ङिह्पान तैस्याङ पुरूव र्‌युह्बो रे मन खेः र्‌युप्पो।”<verse eid="MAT 13:44" /></para>
  <para style="s">मकेकुकेन कुम्म मोतीन द्रिस्तान्त</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“ह्‌याङ, स्वर्गन राज्य ती ब्यापारी लैम जेङ्पा, सुई मोती लःव फाप्पो। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />तीँ मन ब्यपारीजै ती मकेकुकेन कुम्म मोती देप्पो। रे नुई वैवै जेँन ङ्याबो रह्पान तैस्याङ पुरू र्‌युर्‌र्‌युई मन मोती र्‌युह्बो।”<verse eid="MAT 13:46" /></para>
  <para style="s">जालन द्रिस्तान्त</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />ह्‌याङ “स्वर्गन राज्य समुन्द्रग ताह्पान जाल लैम जेङ्पा। मन जालग राँसाराँसान ङाह्‌व थेप्पो। <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />आलै जाल नाङ्मी सिमिवजै मनग नाः कानकान छ्यूबो, रे छ्युङछ्युङ लः भरी धाङवग साबो, रे अलः भरी खोलोः पह्प्पो। <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />सन्सारन अन्त्यगै झामै राह्‌नान ङ्याह्। स्वर्गदुतव स्वा ताप्नान ङ्याह् आलै परमेस्वरन ङू धर्मी ठहर्याई खेपान सिमिवलम सिमि अलःकाङ्मोः फानान ङ्याह्। <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />छ्याप्पान मेह्ग पन्नान ङ्याह्। मन सिमिव पिरजै दोःनान ङ्याह् सो चम्नान ङ्याह्।”<verse eid="MAT 13:50" /></para>
  <para style="s">सार्बा रे घ्वापा तेम्मा</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />तब येसुई जेँन चेलाकाङ्मोः लोप्पो, “तै अन ल्होई पुरूव ङेनजै हाकोपौ?”</para>
  <para style="p" vid="MAT 13:51">ख्युई झब बिम्बो, “अँ प्रभु, ङ्योअजै हाकोपा।”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />तब येसुई जेँन चेलाकाङ्मोः र्‌वाबो, “पुरू कानुन लन्नान्न सिमि सुई स्वर्गन राज्यन भारेः लम्पान ती यिमन तापो लैम जेङ्पा। नुई जेँन भकारिलै ङिङ्‌पा रे सार्बा चिजव जगाई नाम्पा राह्‌नान। आलै नुई मन घ्वापा रे सार्बा चिजव खोलोः छ्यूनान।”<verse eid="MAT 13:52" /></para>
  <para style="s">नासरतग येसू अस्वीकार खेपा</para>
  <para style="r">(<ref loc="MRK 6:1-6">मर्क ६:१-६</ref>; <ref loc="LUK 4:16-30">लुक ४:१६-३०</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />झामखेखे द्रिस्तान्तवग लनतामी येसुई स्याह्‌लै होई। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />येसु जेँन सहरग स्वाबो। येसुई यहूदी आराधनालयग ख्युकाङ्मोः लह्‌म्बो। नुन छोए ङ्यान्नानव हालाईलाई र्‌वाबो। अन्नकारन नुई राह्‌ङराङ्साः ल्होई र्‌वाबो, “हालाईचेन धोनव खेनान्न झाम बुद्धि रे सक्ति अनजै खालै देप्पो? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />अन नुई कर्मीन ङोह्जो नङ्पाऊ? आलै नुन मा मरियम नङ्पाऊ? याकूब, योसेफ, सिमोन रे यहूदा नुन भाईव नङ्पा तै? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />नुन मितिकोव चोँ ङिन ङ्याबो ङ्याह्। अन्नकारन नुई अन ल्होईव र्‌वानान्न अकेः किम बुद्धि रे सक्ति खालै देत्‌तँ?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />अन्नकारन सिमिवजै येसू स्वीकार खे मतैबो। जेङ्नै येसुई ख्युकाङ्मोः र्‌वाबो, “घङ सिमिवजै भबिस्यबक्ताः सम्मान खेँ। जेङ्नै जेँन सहरग रे जेँनै यिमन सिमिवजै भबिस्यबक्ताः उजुखेखे नुन लैम सम्मान मखेँ।”<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />मन ठाउँग सिमिवजै येसू बिस्वास मखेपान कारन नुई स्याह् लैः ताईलुवान धोनव मथम्बो।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">बप्‌तिस्मा बिन्नान्न यूहन्ना सिह्प्पा</para>
  <para style="r">(<ref loc="MRK 6:14-29">मर्क ६:१४-२९</ref>; <ref loc="LUK 9:7-9">लुक ९:७-९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />मन्न भेला गालील प्रदेसग राज्य खेनान्न हेरोदजै येसुन भारेः ताह्बो। <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />हेरोदजै जेँन राङ्पाकाङ्मोः र्‌वाबो, “अन सिमि तेम्माई बप्‌तिस्मा बिन्नान्न यूहन्ना जेङ्पा। नु सिह्पालै सम्पु ग्युर्दँ। अन्नकारन झाम ताईलुवान धोनव खे तैङ।”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />तैङर्‌वाङिन हेरोदजै यूहन्नाः झ्यालखानाः कह्पा ङ्याह्। हेरोदजै हेरोदियासन कारन यूहन्नाः साँगलजै खीखी झ्यालखानाः कपा ङ्याह्। हेरोदियास, हेरोदन धाज्यु फिलिपन मीसा ङ्याह्। <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />झाम र्‌वापा ङ्याह्, “ना हेरोदजै झाङ्‌ग मिसा दोङ्दोङ् नान्चे कानुन अन्सार लः मराह्‌नान अन्नकारन यूहन्नाः जुङ्पा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेवी १८:१६</ref>; <ref loc="LEV 20:21">२०:२१</ref></char></note> <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />झाम र्‌वापा राह्‌राह्‌ हेरोदजै नू सच्‌चे यङ फाप्पा ङ्याह्। जेङ्नै नु सिमिवलम ङिह्‌म्बो तैङर्‌वाङिन ख्युई यूहन्नाः भबिस्यबक्ता जेङ्पा र्‌वार्‌वा ङ्याङ्‌ङ। <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />हेरोद केह्पान स्याङ्चेन लाह्ः, हेरोदियासन चमेःजै ख्युकाङ्मोः छ्याम्‌छ्याम्‌ थम्बो। हेरोद मिह्दा स्याङ्बो। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />आलै हेरोदजै मन चिमिचाः झाम र्‌वाबो, “नाः तैस्याङ त्वानै तोला ङा बिनच्योवा र्‌वार्‌वा रेनरुबो।” <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />चमेःजै तै तोल्चे र्‌वार्‌वा माः लोत्तौ नुई माई लम्पा लैम खेखे झाम र्‌वाबो, “बप्‌तिस्मा बिन्नान्न यूहन्नान थोप्पा ङाः तेर्मादीग क।” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />तब झली हेरोद मिह्दा बैरा जाःबो। जेङ्नै रेनरुपा रे दम्फुवन कारन नुई जेँन चमेःग त्वापान ल्होई सच्‌चेन आदेस बिम्बो। <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />अन्नकारन नुई कान सिमिकाङ्मोः फेप्पे झ्यालखानाः थेप्पान यूहन्नान थोप्पा थुमफाम्बो। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />ख्युई यूहन्नान थोप्पा तेर्मादीग सप्पो रे मन चिमिचाः बिम्बो। नुई यूहन्नान थोप्पा जेँन मा हेरोदियासन स्याह् वप्पो। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />यूहन्नान चेलाव स्वाबो रे नुन कुह्‌म वव्वै लुह्‌म्बो। आलै ख्यु येसुन स्याह् होई रे अन घतना पुरूव स्याप्पो।<verse eid="MAT 14:12" /></para>
  <para style="s">येसुई हजार ङा सिमिकाङ्मोः ख्वापा</para>
  <para style="r">(<ref loc="MRK 6:30-44">मर्क ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लुक ९:१०-१७</ref>; <ref loc="JHN 6:1-14">यूह ६:१-१४</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />जब येसुई यूहन्नाः अन ल्होईव ताह्बो, नु दोङादीग चपचप तये सुनसान ठाउँग होई। जब सिमिवजै येसु वैतपान ल्होई क्युई रह्पा। ख्युई जेँन सहरलै लेनलेन येसुन ङिक जाःबो। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />जब येसु दोङालै धुल्बो, स्याह् नुई सिमिवन मोङ रङ्बो। नुई ख्युकाङ्मोः मिह्दा दिसाबो, आलै ख्युन बर्ग खङ्नानकाङ्मोः ताःफाम्बो। <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />मन्नै ङ्याजे चेलाव येसुन रह्‌म्म ताप्‌ताप्‌ र्‌वामः जाःबो, “स्यीह् सिमि सुई मछ्यूँ। अन सिमिकाङ्मोः फेरा ताकि ख्युवा वैवै जेँन भिह्तु झायाप र्‌युह्‌र्‌युह् झाःयो।” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />येसुई र्‌वाबो, “सिमिव स्यीह्‌लै नवयाःयो बरु ङेनजै र्‌वार्‌वा ख्युकाङ्मोः तयाः झाफाना।” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />चेलावजै र्‌वाबो, “जेङ्नै ङिन ङ्याबो रोता ङा थाम रे ङाह् ङेह् थाम मात्र ङ्याह्।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />येसुई र्‌वाबो, “मन रोता रे ङाह्‌व स्यीह् सह्रा।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />मन्न छाम्म येसुई पुरू सिमिकाङ्मोः क्वाः छ्युङ्फाम्बो। नुई रोता ङा थाम रे ङाह् ङेह् थाम वप्पो। नुई स्वर्गक्याँ सेनसेन परमेस्वरग असिका तोल्बो। मन्न छाम्म नुई रोताव क्युक्‌क्युई चेलाकाङ्मोः मन रोता बिम्बो, आलै चेलावजै चन रोता सिमिवन घूँ परेःबो। <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />पुरूजै बरङ्बरङ् झबो। चेलावजै लाःमा रह्पा तुकराव रूरू थाम च्योङेग काङ्बो। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />स्याह् चिमिचाव रे वैचाव नङ्म झानान क्वाई माल्‌ला हजार ङातौ सिमिव ङ्याह्।<verse eid="MAT 14:21" /></para>
  <para style="s">येसु त्युन लाह्ः लेम्पा</para>
  <para style="r">(<ref loc="MRK 6:45-52">मर्क ६:४५-५२</ref>; <ref loc="JHN 6:16-21">यूह ६:१६-२१</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />अन्न छाम्म तुरुन्त येसुई चेलाकाङ्मोः दोङाः चपचप योह्‌न धिक्याँ जेँ खेरे ङू वैफाम्बो। नु जेँ चन सिमिकाङ्मोः भिदा खेमः छ्युङ्बो। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />सिमिकाङ्मोः भिदा खेतामी, येसु तितिमाई सोअताप्चेन भिह्तु धुरग लिह्‌प्पो। नम्जी रुप्न बेर नु तितिमाई स्याह् छ्युङ्बो। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />मन्तौन बेर दोङा नाःलैः ग्याङ्म तापतपा ङ्याह्। जेङ्नै ङूलै लन च्याङच्याङ छ्योलापजै दोङाः धेँवछोँ कुल्पा राह्‌राह्‌ चेलाव ङू वै मतैबो। <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />नाह्प तिन बजेलै छ बजेन घूँराः, येसु त्युन लाह्ः लेनलेन चेलावन स्याह् स्वाबो। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />नू त्यू लेनलेन स्वायङ खेपा रङ्‌रङ चेलाकाङ्मोः मु जेअँ र्‌वार्‌वा ङिनङिन फाईरा खेमः जाःबो। <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />आलै तुरुन्तै येसुई र्‌वाबो, “नङिना, ङा जेङ्पा, हिम्मत ख्या।” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />पत्रुसजै र्‌वाबो, “प्रभु, यदि तेम्माई ना जेङ्न, ङाः त्युन लाह्ः लेनलेन नान रह्‌म्म स्वा र्‌वा।” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />येसुई र्‌वाबो, “स्वा न।” पत्रुस दोङालै धुलधुल त्युन लाह्ः ल्हेनैल्हेनै येसुन रह्‌म्म वैमः जाःबो। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />जेङ्नै हुर्याःपा च्याङ्पा रङरङ नु ङिह्‌म्बो। त्युन लाह्ः झाछ्योँवाग नु नुप्मः जाःबो रे आत्ती राह्‌राह्‌ “बचाई ख्या प्रभु!” र्‌वाईर्‌वाई फाईरा खेबो। <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />येसुई नू हतपत जुङजुङ् र्‌वाबो, “ए ङाईदिन बिस्वासी, नाई तैङ सङ्‌का खेपा?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />मन ङेह्पा दोङाः चप्पो रे हुर्याःपा छ्याःबो। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />दोङाः ङिह्पान चेलावजै येसू छ्याःफुलैफुलै र्‌वामः जाःबो, “तेम्माई ना परमेस्वरन ङोह्जो जेङ्पा।”<verse eid="MAT 14:33" /></para>
  <para style="s">येसुई गनेसरेतग खङ्नानकाङ्मोः ताःफाम्पा</para>
  <para style="r">(<ref loc="MRK 6:53-56">मर्क ६:५३-५६</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />येसु चेलावन ङ्याबोई योह् गार्गार गनेसरेत मिह्‌न्न ठाउँदीग ताप्पो। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />स्याह्‌न सिमिवजै येसुई जेअँ र्‌वार्‌वा नू स्योःबो। मन्नकारन ख्युई धेँवछोँःन नाम पुरून खङ्नानकाङ्मोः येसुन स्याह् साप्पो। <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />ख्युई नुन घोलाङ्न नादी रानै ज्यार्चे धेराःयो र्‌वार्‌वा नू छ्याःफुल्बो, रे हातिपाई ज्यार्बो ख्यु ताःबो।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">खेपुलवन खाईकोए</para>
  <para style="r">(<ref loc="MRK 7:1-23">मर्क ७:१-२३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />तब कान फरिसीव रे कानुन लन्नान्न सिमिव यरूसलेम सहरलै स्वास्वा येसू लोप्पो। <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“नान चेलावजै खेपुलवन ल्हूलाम तैङ मङ्याङ्‌ङ? ख्युई झाचेन खेरे ङू लाह्ई मथूँ।” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />येसुई ख्युकाङ्मोः झब बिम्बो, “ङेन रे जेँन ल्हूलामन भिह्तु परमेस्वरन र्‌वापा तैङ मङ्याङ्‌नान? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />परमेस्वरजै र्‌वापा ङ्याह्, ‘जेँन पोमाः सम्मान ख्या आलै सुई जेँन पोमाः सराप खेँ नू सह्त त्वानान।’<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस २०:१२</ref>; <ref loc="EXO 21:17">२१:१७</ref>; <ref loc="DEU 5:16">कानुन ५:१६</ref>; <ref loc="LEV 20:9">लेवी २०:९</ref></char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />जेङ्नै ङेनजै र्‌वाङ, सुई जेँन पोमाः ‘सेह्‌ना ङेनकाङ्मोः बिनत्वानान्न भेति ङै परमेस्वरग फुल्तह्पा’ र्‌वाङिन <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />नुई चन जेँन पोमान सम्मान खेमत्वानान। झामखेखे ङेन जेँनै ल्हूलामग जाःजाः परमेस्वरन आग्या फानै मत्वानान र्‌वार्‌वा छूँ। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />ङेन ख्वाकिबाव हो। यसैयाजै भबिस्यबानी र्‌वापान ल्होई ङेनकाङ्मोः थ्याक्‌कै दीङ: <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />‘ङुरजै चन अन सिमिवजै ङाः सम्मान खेँ! जेङ्नै ख्युन सम चन ङन स्यीह्‌लै लैः ग्याङ्म ङ्याह्। <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />ख्युई ङाः आराधना खेपा ता भाछ्योवा ङ्याह्। तैङर्‌वाङिन ख्युई एकुरो सिमिजै दोङ्पान लूह्‌लाम मात्र लह्ङ्‌ङ।’”<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">यसै २९:१३</ref></char></note><verse eid="MAT 15:9" /></para>
  <para style="s">सिमी बाःपा दोङ्नान्न ल्होईव</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />मन्न छाम्म येसुई सिमिवन मोङग जेँन रह्‌म्म स्वा र्‌वार्‌वा र्‌वाबो, “ङन ल्होई ध्यान बिमबिम ङ्याना, <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />ङुरलै झिङ जाःनान्न ल्होईजै सिमी बाःपा दोङ्नान नङ्पा। नुन ङुरलै खोलोः गेन्नान्न जिचजै नू बाःपा धोँ।” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />तब चेलाव येसुन स्याह् स्वास्वा नू र्‌वाबो, “तै नाः क्युई रह्बोयौ? नाई र्‌वापान ल्होईग फरिसीव सुतूबो।” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />येसुई र्‌वाबो, “स्वर्गन ङन पाई मजूपान तङ्पु पुरु पिङ्‌नान ङ्याह्। <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />ख्युन वास्ता नख्या, ख्यु ता कानावन अगुवा काना जेङ्पा। कानादीजै घङ कानाः र्‌वाङिन तै ङ्योरुम लुह्‌मग मघ्यानान तै।”<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">लुक ६:३९</ref></char></note> <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />पत्रुसजै नू र्‌वाबो, “ङी अन द्रिस्तान्तन अर्थ र्‌वा।” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />येसुई र्‌वाबो, “तै ङेन हेँद्रि हामकोनौ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />ङेनकाङ्मोः क्युई मह्‌या तै? सिमिन ङुरलै झिङ जाःपान ल्होई ता नुन फौग ताप्ङ। आलै ङिक ल्हो‌लै गेग्गे वैङ। <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />जेङ्नै सिमिन ङुरलै गेन्नान्न ल्होई नुन समलै स्वापा राह्‌नान। अनै ल्होईवजै नू बाःपा धोँ। <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />तैङर्‌वाङिन सिमिन समन झिङलै नावा अलःव गेङ्‌ङ। अनै नावा अलःवजै खेपान कारन नुई सिमि सच्‌चे, जेँन ब्यभिचार खेचे, खुचे, लबारन साँचि बिन्चे, ल्हुई झाचेलैम धोन अलःव खेँ। <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />अन ल्होईवजै सिमी बाःपा धोँ। जेङ्नै ल्हा मथुरे झाझा सिमी बाःपा मदोङ्नान।”<verse eid="MAT 15:20" /></para>
  <para style="s">कनानी चिमिचान बिस्वास</para>
  <para style="r">(<ref loc="MRK 7:24-30">मर्क ७:२४-३०</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />येसु मन ठाउँ ख्योवाख्योवा तुरोस रे सीदोन सहरक्याँ होई। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />स्याह्ई कनानी चिमिचादी येसुन स्याह् स्वास्वा फाईरा खेईखेई र्‌वाबो, “हे प्रभु, दाऊदन ङोह्जो, ङाः दया ख्या। ङन चमेः मुई सेम्पा राह्‌राह्‌ मिह्दा तूरि देप्पा ङ्याह्।” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />जेङ्नै येसुई नू तये यङ झब मबिम्बो आलै नुन चेलावजै स्वास्वा नू छ्याःफुल्बो, “अन चिमिचाः फेरा, नु ता ङिन ङिह्‌ङिह्‌ दाईदाई स्वायङ खेपा ङ्याह्।” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />जेङ्नै येसुई र्‌वाबो, “इस्राएलन सिमिवन मोल्पान लूपावन स्याह् फेप्पा जेङ्पा।” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />अन ताह्ताह् मन चिमिचाई येसुन ल्हेग खल्बू क्याप्‌क्याप र्‌वाबो, “प्रभु, ङाः फुरी ख्या।” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />जेङ्नै येसुई र्‌वाबो, “जेँन वैचावन रोता तलतल ख्युकोग बिन्चे लः मराह्‌नान?” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />आलै मन यहूदीन खोलोःन चिमिचाई र्‌वाबो, “जेङ्पा प्रभु, जेङ्नै ख्युवजै र्‌वार्‌वा जेँन मालिकवन तेबललै छार्पान रोतान तुकराव झाँ न।” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />तब येसुई र्‌वाबो, “हे चिमिचा नान बिस्वास किम ङिम्न। नाई चाहि खेपा लैमै राःयो।” आलै नुन चमेः मन्नै भेला ताःबो।<verse eid="MAT 15:28" /></para>
  <para style="s">येसुई लैः सिमिकाङ्मोः ताःफाम्पा</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />येसु मन ठाउँ ख्योवाख्योवा गालील योह्‌न नाः नाः वैवै धुरग लिह्प्पो रे स्याह् छ्युङ्बो। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />ह्‌याङ लैः सिमिवन मोङ येसुन स्याह् स्वाबो। मन सिमिवजै लैः नाह्जा ङिह्पान सिमिकाङ्मोः वव्वै स्वाबो आलै येसुन ङू नाह्‌म्बो। लुल्या, काना, वाम्पा आलै नाम्ज्योवा मताह्‌नान मोङलम सप्पा ङ्याह्। येसुई अन पुरूग ताःफाम्बो। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />स्यीह् थाल कि, वाम्पाव ल्होई र्‌वापा, लुल्याव ताःपा, खोर्याव लेम्पा रे कानावजै मी रङ तैनान रह्पा रङरङ सिमिव हालाईबो, रे ख्युई इस्राएलन परमेस्वरन महिमा खेबो।<verse eid="MAT 15:31" /></para>
  <para style="s">येसुई घङ किम मोह्ङग ख्वाःपा</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />तब येसुई जेँन चेलाकाङ्मोः जेँन स्याह् घ्वाघ्वा र्‌वाबो, “ङा अन मोह्ङ्‌ग दिसाँ, तैङर्‌वाङिन अजोव ङन ङ्याबो छ्युङ्पा त्या सुमङी रह्पा, आलै अजोवन ङ्याबो झाचेन भिह्तु तये मह्‌या। अजोवग फोङै फेस्सुम ङाः मीपा। तेमन्ता ख्यु लमग बेहोस रह्दरा।” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />चेलावजै नू र्‌वाबो, “अकेः ह्‌याल्म मोह्ङग अन सुनसान ठाउँग खालै झायाप सस्सै ख्वाःचे?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />येसुई ख्युकाङ्मोः लोप्पो, “ङेन ङ्याबो रोता हाति थाम ङिह्पा?” ख्युई झब बिम्बो, “नेह् थाम रोता रे तयाः ङाह् कत्याःम ङिह्पा।” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />नुई मोह्ङ्‌ग साः छ्योवा र्‌वार्‌वा र्‌वाबो। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />नुई मन नेह् रोता रे ङाह् वव्वै परमेस्वरग मया रह्पा र्‌वामी क्युक्‌क्युई चेलाकाङ्मोः बिम्बो, आलै चेलावजै सिमिकाङ्मोः परेःबो। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />ख्यु पुरूजै बरङ्बरङ् झबो। रे चेलावजै लाःमा रह्पान तुकराव रूरू थाम नेह् खाप्च्योवा तुईबो। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />चिमिचाव रे वैचाव नङ्म झानानव हजार ली चोलोङ्चाव ङ्याह्। <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />तब सिमिन मोङ किमवग भिदा खेतामी नु दोङाः चप्पो, रे मगादान्न छेत्रक्याँ होई।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">ताईलोवान धोन तोल्पा</para>
  <para style="r">(<ref loc="MRK 8:11-13">मर्क ८:११-१३</ref>; <ref loc="LUK 12:54-56">लुक १२:५४-५६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />फरिसीव रे सदुकीव स्वाबो, रे येसू छोए सेह्‌म्म स्वर्गलै ताईलुवान धोन खेखे ङी थना र्‌वार्‌वा नू तोल्बो।<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">मत्ती १२:३८</ref>; <ref loc="LUK 11:16">लुक ११:१६</ref></char></note> <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />जेङ्नै नुई ख्युकाङ्मोः झब बिम्बो, “जब ङ्याजे राँ, तब ङेन र्‌वाङ, ‘अन मौसम खामसाङ्म राह्‌नान ङ्याह्, तैङर्‌वाङिन पान्नाङ ल्होःम ङ्याह्।’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />ह्‌याङ नाह्प र्‌वाङ, ‘पान्नाङ ल्होःम रे नम्‌लुई कप्पा ङ्याह्, त्या यामयाम लन च्याङ्नान जेम्न।’ ङेन पान्नाङ्न अबस्था सेनसेन दिन कताःम राह्‌नान र्‌वार्‌वा फाम राँ, जेङ्नै भेलान ताह्‌न अर्थ पोङ मतैङ। <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />अलः रे ब्यभिचारी पुस्ताई ताह् फाङ्‌ङ, जेङ्नै योनान ताह् नङ्म घङ ताह् नू बिन्नान मह्‌या।” आलै ख्युकाङ्मोः ख्योवाख्योवा नु होई।<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्ती १२:३९</ref>; <ref loc="LUK 11:29">लुक ११:२९</ref></char></note><verse eid="MAT 16:4" /></para>
  <para style="s">फरिसी रे सदुकीवन सोरा</para>
  <para style="r">(<ref loc="MRK 8:14-21">मर्क ८:१४-२१</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />चेलाव योह्‌न धिङाः स्वातौ ख्युई रोता दर्मः ह्‌याका लेत्‌तँ। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />येसुई ख्युकाङ्मोः र्‌वाबो, “ध्यान भिना, फरिसी रे सदुकीवन सोरा लम होसखेखे छ्योवा।”<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लुक १२:१</ref></char></note> <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />ख्युई राह्‌ङराङ्साः खाथू खेमः जाःबो, “ङी रोता मसप्पा, अन्नकारन नुई झाम र्‌वापा जेम्तौ।” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />येसू अन क्युई राह्‌राह्‌ र्‌वाबो, “ए ङाईदिन बिस्वासी हो! ङेन ङ्याबो रोता मह्‌या र्‌वार्‌वा तैङ राह्ङराङ्साः खाथू खेनान? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />तै ङेन हेँद्रि हामकोनौ? हजार ङान भिह्तु रोता ङान ल्होई ङेनकाङ्मोः हेँ ह्‌याका मीपाऊ? ङेनजै हाति थाम रूपा?<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">मत्ती १४:१७-२१</ref></char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />आलै रोता नेह्जै हजार लिपाः ख्वातौ हाति थाम नाङ्पा तुकरा ङेनजै रूपा?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">मत्ती १५:३४-३८</ref></char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />ङै ङेनकाङ्मोः रोतान भारेः र्‌वापा नङ्पा र्‌वार्‌वा ङेन तैङ हामकोनान? जेङ्नै फरिसी रे सदुकीवन सोरालम होसखेखे छ्योवा।” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />तब ख्युई हाकोबो, कि नुई रोतान सोरालम नङ्पा जेङ्नै फरिसी रे सदुकीवन छोएलम होसखेखे छ्योवा र्‌वापा जेअँ।<verse eid="MAT 16:12" /></para>
  <para style="s">येसुन भारेः पत्रुसन घोसना</para>
  <para style="r">(<ref loc="MRK 8:27-30">मर्क ८:२७-३०</ref>; <ref loc="LUK 9:18-21">लुक ९:१८-२१</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />येसु कैसरिया फिलिप्पीन प्रदेसग स्वामी, नुई जेँन चेलाकाङ्मोः लोप्पो, “सिमिवजै सिमिन ङोह्जोः सु जेङ्पा र्‌वार्‌वा र्‌वाङ?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />ख्युई झब बिम्बो, “कानजै बप्‌तिस्मा बिन्नान्न यूहन्ना, कानजै एलिया, रे कानजै यर्मिया या भबिस्यबक्तावन बर्ग कान तीपा जेङ्पा र्‌वार्‌वा र्‌वाङ।”<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">मत्ती १४:१-२</ref>; <ref loc="MRK 6:14-15">मर्क ६:१४-१५</ref>; <ref loc="LUK 9:7-8">लुक ९:७-८</ref></char></note> <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />येसुई ख्युकाङ्मोः लोप्पो, “ङेन तै र्‌वानान, ङा सु जेङ्पा?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />“सिमोन पत्रुसजै झब बिम्बो, सम्पु परमेस्वरन ङोह्जो मसिह जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">यूह ६:६८-६९</ref></char></note> <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />येसुई नू र्‌वाबो, “योनान ङोह्जो सिमोन, ना धन्न जेङ्पा। तैङर्‌वाङिन स्या रे कह ङिह्पान सिमिलम ताह्ताह् नाई र्‌वापा नङ्पा, जेङ्नै स्वर्गः ङिह्पान ङन पाई नाः थम्पा जेङ्पा। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />ङा नाः र्‌वाचे, कि पत्रुस ना लुङ जेङ्पा। ङा ङन मन्दली अन लुङ्न लाह्ः दोङ्नान ङ्युँ, रे ङ्यालान झलाव मन्न लाह्ः क्याल्नान मह्‌या। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />ङा नाः स्वर्गन राज्यन धिमी बिन्नान ङ्युँ। तै नाई पिर्थीबी खीनान ङ्याह्, अन स्वर्गः खीनान ङ्याह्, रे तै नाई पिर्थिबी पोङ्‌ङ, अन स्वर्गः पोङ्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्ती १८:१८</ref>; <ref loc="JHN 20:23">यूह २०:२३</ref></char></note> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />नु मसिह जेङ्पा र्‌वार्‌वा सुई नर्‌वा र्‌वार्‌वा येसुई चेलाकाङ्मोः करा आग्या बिम्बो।<verse eid="MAT 16:20" /></para>
  <para style="s">येसुई जेँ सिह्‌नान्न भारेः र्‌वापा</para>
  <para style="r">(<ref loc="MRK 8:31">मर्क ८:३१</ref>; <ref loc="MRK 9:1">९:१</ref>; <ref loc="LUK 9:22-27">लुक ९:२२-२७</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />येसु कुजुई यरूसलेमग वैत्वानान, रे अगुवा रे ङोत्वा पुजारीव रे कानुन लन्नान्न सिमिवलम लै तूरि हुरत्वानान, सह्त त्वानान रे सुमङीग सम्पु राह्‌राह्‌ च्याङ्त्वानान र्‌वार्‌वा नुई मन्न भेलालै जेँन चेलाकाङ्मोः स्याप्म जाःबो। <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />पत्रुसजै नू तीपू वव्वै ङार्मः जाःबो, “परमेस्वरजै झाम नख्याःयो, प्रभु, नान लाह्ः झाम हातौयै नह्‌राःयो।” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />जेङ्नै होलहोल नुई पत्रुसग र्‌वाबो, “ए सैतान, ङन ङूलै वया, ना ङन भिह्तु बाधा जेङ्पा। तैङर्‌वाङिन ना परमेस्वरन ल्होईग नङ्पा, जेङ्नै सिमिवन ल्होईवग ध्यान बिङ्‌ङ।” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />तब येसुई जेँन चेलाकाङ्मोः र्‌वाबो, “सुई ङन ङिक स्वासुम खेङिन, नुई जेँग अस्वीकार ख्याःयो रे जेँन क्रुस सोलसोल ङन ङिक जायो।<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ती १०:३८</ref>; <ref loc="LUK 14:27">लुक १४:२७</ref></char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />तैङर्‌वाङिन सुई जेँन परान बचाई खेसुम खेँ, नुई मन मोल्नान ङ्याह्, जेङ्नै सुई जेँन परान ङन भिह्तु मोल्ङ, नुई मन देन्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="LUK 17:33">लुक १७:३३</ref>; <ref loc="JHN 12:25">यूह १२:२५</ref></char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />सोलो सन्सार देद्दे यङ जेँन परान मोल्ङिन, सिमी तै लाभ राह्‌नान? आथबा सिमिजै जेँन परान्न पूँ तै भिन तैनान? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />तैङर्‌वाङिन सिमिन ङोह्जो जेँन पान महिमाग जेँन स्वर्गदुतवन ङ्याबो स्वानान ङ्याह्, रे मन्तौ नुई सिमि पुरूग नुन धोन अन्सार प्रतिफल बिन्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती २५:३१</ref>; <ref loc="PSA 62:12">भजन ६२:१२</ref>; <ref loc="ROM 2:6">रोम २:६</ref></char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, स्यीह् च्याङ्नानवन बर्ग हातिपाई सिमिन ङोह्जोः जेँन राज्यग स्वायङ खेपा मरङ्न बेर सिह्‌नानै मह्‌या।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">येसुन खरि फिप्पा</para>
  <para style="r">(<ref loc="MRK 9:2-13">मर्क ९:२-१३</ref>; <ref loc="LUK 9:28-36">लुक ९:२८-३६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />मन्न रूर्यान ङिक येसुई पत्रुस, याकूब रे नुन भाई युहन्नाः जेँन ङ्याबो धुर थोमदीन लाह्ः वप्पो। <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />ख्युन ङू नुन खरि फिप्पो। नुन ध्वा ङिह्‌मा लैम चम्कि रह्बो रे नुन घोलाङ बत्ति लैम पाह्ल्म रह्बो। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />आलै हरक्‌क मोसा रे एलिया रङ्बो रे येसुन ङ्याबो ल्होई र्‌वामः जाःबो। <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />पत्रुसजै येसू र्‌वाबो, “हे प्रभु, ङि स्यीह् ङिह्पा मिह्दा लः रह्दँ। नान इच्छ्या राङिन ङा स्यीह् सुम थाम आति दोङ्नान ङ्युँ, ती नान भिह्तु, ती मोसान भिह्तु रे ती एलियान भिह्तु।” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />पत्रुसजै ल्होई र्‌वातौर्‌वातौ चहकिलो नमलू स्वास्वा नुन तिप्सोई ख्युकाङ्मोः कप्पो आलै नमलून झिङलै केह्दी स्वाबो, “अन ङन स्याङ्पान ङोह्जो जेङ्पा, अन्न ङ्याबो ङा मिह्दा किम्म ङिह्पा, अन्न ल्होई ङ्याना।”<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">उत २२:२</ref>; <ref loc="DEU 18:15">कानुन १८:१५</ref>; <ref loc="PSA 2:7">भजन २:७</ref>; <ref loc="ISA 42:1">यसै ४२:१</ref>; <ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MAT 12:18">१२:१८</ref>; <ref loc="MRK 1:11">मर्क १:११</ref>; <ref loc="LUK 3:22">लुक ३:२२</ref></char></note> <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />जब चेलावजै अन ताह्बो, तब ख्यु मिह्दा ङिनङिन साः खल्बु क्याप्पो। <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />जेङ्नै येसुई स्वास्वा ख्युकाङ्मोः ज्यारज्यार र्‌वाबो, “च्याँ, नङिना।” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />जब ख्युई तो सेन्तौ येसु नङ्म घङ सुई मरङ्बो। <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />जब ख्यु धुरलै धुल्यङ खेपा ङ्याह्, येसुई ख्युकाङ्मोः आग्या खेबो, “जब थाल सिमिन ङोह्जो सिह्पालै सम्पु राह्‌राह्‌ मच्याँ, तबथाल ङेनजै अन दर्सन्न ल्होई सुई नर्‌वा।” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />आलै चेलावजै नू झाःम र्‌वार्‌वा लोप्पो, “तब तैङ कानुन लन्नान्न सिमिवजै पहिली एलिया स्वात्वानान र्‌वार्‌वा र्‌वाङ?”<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मला ४:५</ref></char></note> <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />येसुई ख्युकाङ्मोः र्‌वाबो, “एलिया तेम्माई स्वानान, रे नुई ल्होई पुरू ह्‌याङ दोङ्लाई खेनान ङ्याह्।” <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />जेङ्नै ङा ङेनकाङ्मोः र्‌वाचे, “एलिया लैःलै स्वापा ङ्याह्, आलै सिमिवजै नू मस्योःबो, जेङ्नै नू ख्युई जेँन स्याङ खेबो। उजुखेखेई सिमिन ङोह्जोई र्‌वार्‌वा ख्युन ल्हालै तूरि कुत्वानान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्ती ११:१४</ref></char></note> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />तब नुई बप्‌तिस्मा बिन्नान्न यूहन्नान भारेः ख्युकाङ्मोः र्‌वापा जेङ्पा र्‌वार्‌वा चेलावजै हाकोबो।<verse eid="MAT 17:13" /></para>
  <para style="s">मुई सेम्पा चोलोङ्चा</para>
  <para style="r">(<ref loc="MRK 9:14-29">मर्क ९:१४-२९</ref>; <ref loc="LUK 9:37-43">लुक ९:३७-४३</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />येसु चेलावन ङ्याबो सिमिन मोङ रह्पू होलहोल स्वातौ सिमिदीजै नुन ल्हेग खल्बु क्यापक्याप र्‌वाबो, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“प्रभु, ङन ङोह्जोः दया ख्या! नाम्क्यान्न ताह्पान कारनजै नुई मिह्दा तूरि देप्पाई ङ्याह्। नु घरीघरी बेहोस राँ रे मेह् या त्यू घ्याँ। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ङै नू नान चेलावन स्याह् सप्पा, जेङ्नै ख्युई ताःफान मतैबो।” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />येसुई र्‌वाबो, “ए ङाईदी बिस्वास ङिह्पा रे भ्रमग परि रह्पान पुस्ता, हातौन बेर ङा ङेनकोन ङ्याबो लुईनान ङ्युँ? हातिर्यान बेर ङै ङेनकाङ्मोः कूचे? नू स्यीह् सह्रा।” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />आलै येसुई मन मू ङार्ङार धाम्बो रे मन चोलोङ्चा तुरुन्तै ताःबो। <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />ङिक चेलावजै येसू फाक लोप्पो, “ङी चन मन मू तैङ छ्यू मतैपा?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />येसुई र्‌वाबो, “ङेनकोन अबिस्वासन कारनजै जेङ्पा। तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेनकोन ङ्याबो छून र्‌युदीतौन बिस्वास ङिङिन अन धुरग स्यीह्‌लै वया र्‌वाङिन वैनान ङ्याह् रे ङेनकोन भिह्तु खे मतैनान तये राह्‌नान मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">मत्ती २१:२१</ref>; <ref loc="MRK 11:23">मर्क ११:२३</ref>; <ref loc="1CO 13:2">१ कोर १३:२</ref></char></note> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />जेङ्नै झामन मु चन सोअताप रे बर्त मछ्युङ्मी मगेन्नान।”<verse eid="MAT 17:21" /></para>
  <para style="s">जेँ सिह्‌नान्न भारेः येसुई ह्‌याङ र्‌वापा</para>
  <para style="r">(<ref loc="MRK 9:30-32">मर्क ९:३०-३२</ref>; <ref loc="LUK 9:43-45">लुक ९:४३-४५</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />चेलावन ङ्याबोई गालील छेत्रग रातौ येसुई ख्युकाङ्मोः र्‌वाबो, “ता सिमिन ङोह्जोः जुङजुङ सिमिवन लाह्ग थोन्नान ङ्याह्। <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ख्युई नू सन्नान ङ्याह्। जेङ्नै सुमङीग नु ह्‌याङ सिह्पालै सम्पु ग्युर्नान ङ्याह्।” अन ताह्ताह् चेलाकाङ्मोः बैराः जाःबो।<verse eid="MAT 17:23" /></para>
  <para style="s">कर फाःम येसुन छोए</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />येसु रे नुन चेलाव कफर्नहुमग स्वा ताप्मी आराधनालयन कर तुईनानवजै स्वास्वा पत्रुसग लोप्पो, “तै ङेनकोन गुरुई आराधनालयन कर फाःनौ?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />पत्रुसजै झब बिम्बो, “फाःनान।” आलै नु यिमन झिङ जाःमी येसुई ल्होई छ्यूबो, “ए सिमोन, नान सोच तै ङिह्पा? अन सन्सारन झलीवजै सुलम कर तुईनान? जेँनै ङोह्जोवलम तुईनान कि घङवलम?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />“घङव लमै तुईनान,” पत्रुसजै झब बिम्बो। येसुई र्‌वाबो, “आन ङोह्जो अलःवजै कर फाःमत्वानान। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />जेङ्नै ङि अन सिमिकाङ्मोः ठेस मबिम्मता। ना वया रे योह्ग जाल फ्याँ। पुरून खेरे ङू जालग थेप्पान ङाह् छ्यूछ्यू नुन ङुर पोवा। नुन ङुरग नाई मुलन सिक्‌कादी दोःनान ङ्याह्। मन चन आराधनालयन कर तुईनानवन स्याह् वव्वै ङीमन कर फाःमता।”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">पुरून खेरे किम सु जेङ्पा</para>
  <para style="r">(<ref loc="MRK 9:33-37">मर्क ९:३३-३७</ref>; <ref loc="LUK 9:46-48">लुक ९:४६-४८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />मन्न भेला चेलाव स्वास्वा येसू लोप्पो, “स्वर्गन राज्यग पुरून खेरे किम सु जेङ्पा?”<note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">लुक २२:२४</ref></char></note> <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />तब येसुई वैचादीग रह्‌म्म स्वा र्‌वार्‌वा ख्युन घूँ सोल्बो <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />रे र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, जेँन समग परिबर्तन झाम वैचा लैम मराङिन ङेन हातौयै स्वर्गन राज्यग जाःचे देन्नान मह्‌या। <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />अनै कत्याःम वैचा लैम नम्र राह्‌नान्न सिमि यङ स्वर्गन राज्यग पुरून खेरे किम राह्‌नान ङ्याह्। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />आलै ङन मिह्‌नग झामै वैचाः स्वीकार खेनानजै ङाः र्‌वार्‌वा स्वीकार खेँ।”<verse eid="MAT 18:5" /></para>
  <para style="s">तीपान परिनाम</para>
  <para style="r">(<ref loc="MRK 9:42-48">मर्क ९:४२-४८</ref>; <ref loc="LUK 17:1-2">लुक १७:१-२</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“यदि सुई ङाः बिस्वास खेनान्न झाःम कत्याःम वैचावग बिस्वास ख्योवाख्योवा तीपा खेफाङ्‌ङिन नू ता बरु होलाः ल्हाकोर चुनचुन समुन्द्र तिङ्‌ग नुप फान्चेई लः राह्‌नान ङ्याह्।” <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />धिक्‌कार अन सन्सारग! तैङर्‌वाङिन अन सन्सारग ता सिमिकाङ्मोः ङिनङिन लैमन तीपाः फसाई खेनान्न ल्होईव ङ्याह्। झाम ल्होईव स्वानान, जेङ्नै धिक्‌कार, मन सिमी सुई घङग तीपाः फसाई खेँ! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />“यदि नान ल्हा या ल्हेजै नाः तीपा खेफाङ्‌ङिन नू थुमथुम पह्‌रा। ङ्योरुम लाह्-लेह् वव्वै हातौयै मसिह्‌नान्न मेह्ग थेप्चेन खेरे ता बरु दुर्या रे खोर्या राह्‌राह्‌ मताह्‌नान्न झुनि देच्‌चेई लः जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्ती ५:३०</ref></char></note> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />आलै उजुई खेखे नान मीजै नाः तीपा खेफाङ्‌ङिन मनगै छ्यूछ्यू पह्‌रा। मी ङेह् वव्वै ङ्यालान मेह्ग थेप्चेन खेरे ता बरु काना राह्‌राह्‌ मताह्‌नान्न झुनि देच्‌चेई लः जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती ५:२९</ref></char></note><verse eid="MAT 18:9" /></para>
  <para style="s">मोल्पा लूपान द्रिस्तान्त</para>
  <para style="r">(<ref loc="LUK 15:3-7">लुक १५:३-७</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“होस ख्या, अन कत्याम वैचाव सुई ङेनजै ङान्ज्यान नख्या। ङा ङेनकाङ्मोः र्‌वाचे, ङेनकोन सेन्चे खेनान्न स्वर्गदुतव स्वर्गः ङिह्पान ङन परमेस्वर पानै ङू ङ्याह्। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />तैङर्‌वाङिन ङा सिमिन ङोह्जो ता मोल्पावगै सोमफान्चेन भिह्तु स्वापा जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">लुक १९:१०</ref></char></note> <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />“ङेन तै नावा खेनान? लूपा क्यामदी राह्‌नान्न सिमिजै लूपादी मोल्ङिन नुई तै खेदरा? नुई घङ लिथल रै च्युर्गु थामः स्याह्ई पाखाः ख्योवाख्योवा मोल्पान लूपादी फाम्म मवैनान तै? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />यदि नुई मनग धोङिन, तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, मन मख्याम्नान्न लूपावन भिह्तुन खेरै मन दोःपान तिबाःदि लूपान भिह्तु मिह्दा स्याङ्नान ङ्याह्। <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />हो उजु खेखेई स्वर्गः ङिह्पान ङेनकोन परमेस्वर पाई र्‌वार्‌वा अन कत्याम वैचावन बर्ग सुई यङ मोल्पा चाहि मखेनान।”<verse eid="MAT 18:14" /></para>
  <para style="s">अपराध खेनान्न जिङ्‌कोव</para>
  <para style="r">(<ref loc="LUK 17:3">लुक १७:३</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“यदि नान भाइजै नान बिरोधग तीपा खेपा ङिङिन नू तितिमाई वैवै समजाई ख्या। नुई नान ल्होई ङ्याङ्‌ङिन नाई नू जेँनक्याँ होल फाम्पा राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">लुक १७:३</ref></char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />जेङ्नै नुई नान ल्होई मङ्याङ्‌ङिन घङ तीपा ङेह्पान ङ्याबोई वैवै नू सम्झाई ख्या तैङर्‌वाङिन पबित्रसास्त्रजै र्‌वापालैम याल पुरूवन फैसला खेचेन भिह्तु ङेह् या सुमपा साँचि घ्वा त्वानान। <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />अकेः रातौरातौ यङ नुई ल्होई मङ्याङ्‌ङिन मन्दली वैवै नाई ल्होई पुरू स्यारा आलै ख्युन ल्होई यङ नुई मङ्याङ्‌ङिन यहूदीन खोलोःन सिमि रे कर तुईनान लैम राःयो।” <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, “तै ङेनजै अन पिर्थीबी खीङ, मन स्वर्गः र्‌वार्‌वा खीनान ङ्याह्। आलै तै ङेनजै अन पिर्थीबी फोल्दरा, मन स्वर्गः र्‌वार्‌वा फोल्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">मत्ती १६:१९</ref>; <ref loc="JHN 20:23">यूह २०:२३</ref></char></note> <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />आलै तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, अन पिर्थीबी ङेःमै तै तोल्नान जेम, अन दीदी तोल्ङिन, मन स्वर्गः ङिह्पान ङेनकोन परमेस्वर पाई ङेनकाङ्मोः मन बिन्नान ङ्याह् <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />तैङर्‌वाङिन खाः ङेह् या सुमपा ङन मिह्‌नग जोम्ङ, ङा ख्युन घूँ राह्‌नान ङ्युँ।”<verse eid="MAT 18:20" /></para>
  <para style="s">माफ मबिन्नान राङ्पान द्रिस्तान्त</para>
  <para style="r">(<ref loc="LUK 17:4">लुक १७:४</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />पत्रुसजै येसू लोप्पो, “प्रभु, ङन भाइजै ङन बिरोधग तीपा खेपाई छ्युङ्‌ङिन ङै नू हातिरेप माफ बिनत्वानान? नेरेप?”<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">लुक १७:३-४</ref></char></note> <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />येसुई झब बिम्बो, “नेरेप मात्र नङ्पा, जेङ्नै गुना फेराङ लिथल नेरेप!” <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />तैङर्‌वाङिन स्वर्गन राज्य ता तीपा झलीजै जेँन राङ्पान हिसाब-किताब वप्पा लैम राह्‌नान। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />मन झलीजै जेँन हिसाब-किताब वप्मः जाःतौ हजार च्यु मरन सिक्‌का छेर वन्नान राङ्पादी नुन स्याह् सप्पो। <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />जेङ्नै मन सिमी छेर फाःमः तये यङ मह्‌या। अन्नकारन मन मालिकजै नू ङिह्पान पुरू, कानस्योवा, मिसा, ङोह्जो-चमेः रे जेँगै र्‌वार्‌वा र्‌युह्र्‌युह् छेर फाः र्‌वानान्न आदेस बिम्बो।<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />मन राङ्पाई झलीन लेह् ध्वाध्वा छ्याःफुल्बो, “मालिक, खजिर्याथाल कुह्‌वा, ङा नान छेर पुरू फाःनान ङ्युँ।” <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />मालिकग दिसाबो रे नुई राङ्पान छेर पुरूव माफ खेबो। <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />“तब मन राङ्पा खोलोः होई रे नुई जेँनै ङ्याबो धोन खेनान्न राङ्पा घङ फुरीग धोबो। मन फुरीजै नुन स्याह्‌लै मुलन सिक्‌का क्यामदी छेर वप्पा ङ्याह्। नुई जुङजुङ होला च्योरैच्योरै र्‌वाबो, ‘खाले, नाई झपान छेर चोँह् फाः’!”<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />मन ङ्याबो धोन खेनान्न राङ्पा फुरीजै लेह् ध्वाध्वा छ्याःफुलैफुलै र्‌वाबो, “खजिर्याथाल कुह्‌वा, ङा छेर पुरूव फाःनान ङ्युँ।”<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />जेङ्नै नुई मङ्याम्बो। छेर मफाःन बेर नुई नू झ्यालखानाः कह्बो। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />“मन ङेह्पान ङ्याबोई धोन खेनान्न राङ्पा घङ फुरीवजै र्‌वार्‌वा अन ल्होई पुरूव रङ्पाई ङ्याह्। ख्युकाङ्मोः मिह्दा सम तूह्बो। ख्युई वैवै मालिकग तैस्याङ पुरून ल्होई पुरूव स्याप्पो। <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />आलै मालिकजै मन राङ्पाः स्वा र्‌वार्‌वा र्‌वाबो, ‘ए अलः राङ्पा! नान छ्याःफुल ङ्यान्ङ्यान ङै नाः छेर पुरू माफ खेपा ङ्याह्। <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ङै नाः दया खेपालैम नाई र्‌वार्‌वा जेँन ङ्याबोई धोन खेनान्न राङ्पा फुरीग दया खेत्वानान मह्‌या तै?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />आलै मालिकजै सुतूतू मन राङ्पाई छेर पुरू मफाःन बेर तेह्पफाम्मः नू झ्यालखालान सिमिवन लाह् थोप्पो।” <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />मन्न छाम्म येसुई नतिजा छ्यूबो, “ङेनजै जेँन समलै जेँन थिक्‌कोव माफ मबिङ्‌ङिन स्वर्गः ङिह्पान नान परमेस्वर पाई र्‌वार्‌वा ङेनकाङ्मोः उजुई खेनान ङ्याह्।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">येसुई मिसाः ख्योवानान्न भारेः लम्पा</para>
  <para style="r">(<ref loc="MRK 10:1-12">मर्क १०:१-१२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />अन ल्होईव र्‌वातामी येसु गालील प्रदेसलै लेनलेन यर्दन चाङ्पुन धिङा यहूदिया प्रदेसन छेत्रक्याँ होई। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />सिमिन मोङ किम नुन ङिह्‌ङिह् जाःबो रे नुई ख्युकाङ्मोः ताःफाम्बो। <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />आलै कान फरिसीवजै नुन स्याह् स्वास्वा नू छोए सेन्चे र्‌वार्‌वा लोप्पो, “सुई कारन मीम कानुन अन्सार जेँन मिसा ख्योवाचे देन्नान कि मदेन्नान?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />येसुई झब भिनैभिनै र्‌वाबो, “तै ङेनजै पबित्रसास्त्रग तोअपा मीपाऊ? सृस्तिग स्रिस्ती खेनानजै सिमी चोलोङ्चा रे चिमिचा खेखे दोङ्बो।<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उत १:२७</ref>; <ref loc="GEN 5:2">५:२</ref></char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />‘मन्नकारन चोलोङ्चाई जेँन पोमाः ख्योवाख्योवा जेँन मिसान ङ्याबोई छ्यूँ रे मन ङेह् दीदी ती ल्हो राह्‌नान।’<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत २:२४</ref></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />अन्नकारन ता ख्यु ङेह् नङ्पा, जेङ्नै ल्होदी जेङ्पा आलै परमेस्वरजै थुप्पाकाङ्मोः सिमिजै फाचे नङ्पा।” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />फरिसीवजै नू लोप्पो, “आन तैङ मोसाई कानुनग मिसा ख्योवानान्न सिमी ख्योवाचेन हिगा सरसर ख्योवा र्‌वापा न?”<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">कानुन २४:१-४</ref>; <ref loc="MAT 5:31">मत्ती ५:३१</ref></char></note> <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />येसुई झब बिम्बो, “मोसाई ङेनकोन सम ख्वान कारन कानुनग मिसा ख्योवाचे देन्नान र्‌वापा जेङ्पा। जेङ्नै सृस्तिग ता उजु मह्‌या। <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />सेह्‌ना, ङा ङेनकाङ्मोः र्‌वाचे, ब्यभिचारन दोसन कारन नङ्म मिसाः ख्योवाख्योवा घङ चिमिचान ङ्याबो मिह्जि खेनान्न चोलोङ्चाई ब्यभिचारै खेनान।”<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती ५:३२</ref>; <ref loc="1CO 7:10-11">१ कोर ७:१०-११</ref></char></note> <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />चेलावजै नू र्‌वाबो, “मिसा-पसान घूँ झामै राह्‌नान जेङ्न ता मिह्जी मखेचे लः।” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />येसुई ख्युकाङ्मोः झब बिम्बो, “सिमि पुरूजै अन बचन स्वीकार खे मतैनान, केवल ख्युई मात्र तैनान सू परमेस्वरजै बिम्पा ङ्याह्। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />मिह्जि मखेनान राँसा राँसाई कारनव राह्‌नान तैङर्‌वाङिन हातिपा ता केह्पालै छक्‌का राह्‌नान, कानग घङ सिमिजै छक्‌का दोङ्पा राह्‌नान आलै हातिपा चन स्वर्गन राज्यन भिह्तु मिह्जि मखेनान यङ राह्‌नान। ता ङ्यान तैनानजै चन अन ल्होई ङ्यानाःयो।”<verse eid="MAT 19:12" /></para>
  <para style="s">येसुई कत्याम वैचाकाङ्मोः असिका बिम्पा</para>
  <para style="r">(<ref loc="MRK 10:13-16">मर्क १०:१३-१६</ref>; <ref loc="LUK 18:15-17">लुक १८:१५-१७</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />मन्न भेला येसुई जेँन लाह् नान्नान असिका भिनाःयो रे सोअताबाःयो र्‌वार्‌वा सिमिवजै जेँन कत्याम वैचाकाङ्मोः नुन स्याह् सप्पो। अन रङरङ चेलावजै मन सिमिकाङ्मोः ङार्बो। <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />जेङ्नै येसुई र्‌वाबो, “वैचाकाङ्मोः ङन स्याह् स्वा फाना, ख्युकाङ्मोः नकाः तैङर्‌वाङिन स्वर्गन राज्य ता अन कत्याम वैचाव लैम सिमिवन भिह्तुई जेङ्पा।” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />आलै नुई ख्यु ती-तीन लाह्ः जेँन लाह् नाह्‌म्बो आलै असिका बिमबिम होई।<verse eid="MAT 19:15" /></para>
  <para style="s">रेम्पा छबा</para>
  <para style="r">(<ref loc="MRK 10:17-31">मर्क १०:१७-३१</ref>; <ref loc="LUK 18:18-30">लुक १८:१८-३०</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />तीरेप छबा सिमिदीजै येसुन स्याह् स्वास्वा लोप्पो, “गुरुज्यू, मताह्‌नान्न झुनि देच्‌चेन भिह्तु ङै कनचन धोन लः खेत्वानान?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />येसुई झब बिम्बो, “धोन लःन भारेः ना तैङ ङाः लोन्नान? लः ता तीबाःदि ङिह्पा। नाई मताह्‌नान्न झुनि देस्सुम खेङिन आग्याव ङ्याना।” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />नुई लोप्पो, “कन आग्याव?” येसुई र्‌वाबो, “अनै ता जेङ्पा: सिमी नसह्‌रा, ब्यभिचार नख्या, नखुवा, लबारन साँचि नभिना।<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">प्रस २०:१३-१६</ref>; <ref loc="DEU 5:17-20">कानुन ५:१७-२०</ref> </char></note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />पोमान सम्मान ख्या आलै जेँन खिम्जेःग र्‌वार्‌वा जेँगै लैम मया ख्या।”<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस २०:१२</ref>; <ref loc="DEU 5:16">कानुन ५:१६</ref>; <ref loc="LEV 19:18">लेवी १९:१८</ref></char></note> <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />सिमि छबाई र्‌वाबो, “अन आग्या पुरूव ता ङै ङ्यानैङ्यानै स्वापा ङिह्पा। घङ तै खेत्वानान?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />येसुई नू र्‌वाबो, “ना तेम्माई परमेस्वरन ङू सिमि लः राचे फाङ्‌ङिन वैवै जेँन ङ्याबो ङिह्पान क्यु पुरू र्‌युह्र्‌युह् स्वापान सोह्ङ बिखारिकाङ्मोः भिना रे नाई स्वर्गन क्यु देन्नान ङ्याह् आलै स्वास्वा ङन ङिक जाः।” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />झाःम ल्होई ताह्ताह् मन सिमि छबा ध्वाः नाःतुमा दोङदोङ होई तैङर्‌वाङिन नुन क्यु लैः ङ्याह्। <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />मन्न छाम्म येसुई जेँन चेलाकाङ्मोः र्‌वाबो, तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, “सिमि रेम्पाः स्वर्गन राज्यग जाःचे खराःम लैः ङ्याह्।” <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />ह्‌याङ ङा ङेनकाङ्मोः र्‌वाचे, “सिमि रेम्पाः परमेस्वरन राज्यग जाःचेन खेरे ता बरु ऊँतग घबन तोत्यालै जाःचे छुम्म रह्दरा।” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />चेलावजै हालाईलाई र्‌वाबो, “आन सुई उद्धार देत तैनान?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />येसुई ख्युकाङ्मोः सेनसेन र्‌वाबो, “अन सिमिलम राई मतैनान्न ल्होई जेङ्पा, जेङ्नै परमेस्वरलम चन ल्होई पुरू रा तैनान।” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />मन्न छाम्म पत्रुसजै र्‌वाबो, “सेह्‌ना, ङी ता ल्होई पुरू ख्योवाख्योवा नान ङिक जाःपा ङिह्पा। ङी तै देन्नान ङ्युँ?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />येसुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, सिमिन ङोह्जो तैस्याङ पुरू ह्‌याङ दोङ्तौन मन राज्य सार्बाः जेँन महिमामय झलीन सिङ्‌हासनग छ्युङ्नान ङ्याह्। मन्तौ ङन ङिक जाःनान ङेन रे जेँन सिङ्‌हासन च्योङे थामग छ्युङ्नान ङ्याह् रे इस्राएलन कुल च्योङेन न्याय खेनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती २५:३१</ref>; <ref loc="LUK 22:30">लुक २२:३०</ref></char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />ङन भिह्तु जेँन यिम, थिक्‌कोव, मितिकोव, पोमा, ङोह्जो-चमेः खेः ख्योवानानवजै अन्न खेरे गुना क्यामदी ह्‌याल्म रे मताह्‌नान्न झुनि यङ देन्नान ङ्याह्। <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />जेङ्नै चोँ ङू राह्‌नानवन बर्ग लैः ङिक राह्‌नान ङ्याह् रे चोँ ङिक राह्‌नानव चन ङू राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती २०:१६</ref>; <ref loc="LUK 13:30">लुक १३:३०</ref></char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">अङ्‌गुर भारी धोन खेनान सिमिवन द्रिस्तान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />येसुई र्‌वाईर्‌वाई होई, “स्वर्गन राज्य अङ्‌गुर भारिन रेम्पान द्रिस्तान्तन रुह्ङलैम ङ्याह्। नापपर्मै मन रेम्पा जेँन अङ्‌गुर भारी धोन खेनान्न खेः धोन खेनान्न सिमिकाङ्मोः फाम्म गेप्पो <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />आलै दिन्न ज्याला मुलन सिक्‌कादी बिन्चे, र्‌वार्‌वा कान खेः धोन खेनान्न सिमिकाङ्मोः अङ्‌गुरन भारी धोनग फेप्पो।” <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />ङिजेन नौ बजेराः ह्‌याङ नुई कान सिमिकाङ्मोः धोन मर्हारे भाछ्योवा चोकग च्याङ्च्याङ छ्युङ्पा रङ्बो। <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />रे नुई ख्युकाङ्मोः र्‌वाबो, “ङेनको रे अङ्‌गुरन भारी वया, रे तै लः ङ्याह् ङा ङेनकाङ्मोः बिन्नान ङ्युँ।” <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />ख्यु धोनग होई। मन्न छाम्म नुई ङिजे बाह्र बजेराः रे ह्‌याङ तीन बजेराः यङ उजुई खेखे घङ सिमिकाङ्मोः धोनग फेप्पो। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />ह्‌याङ पाँच बजेराः वैतौ यङ नुई कान सिमी धोन मर्हारे भाछ्योँवा बजारग थाङथाङ छ्युङ्‌पाई रङ्बो। नुई ख्युकाङ्मोः र्‌वाबो, “ङेन स्यीह् तैङ ङिह्‌म पुरू धोन मीम थाङथाङ छ्युङ्पा ङिह्पा?” <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />ख्युई झब बिम्बो, “ङी सुई धोन मबिम्बो।” तब नुई र्‌वाबो, “उजु जेङ्न ङेन रे ङन अङ्‌गुरन भारी धोन खेमः वया।” <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />“ङ्याजे रामी अङ्‌गुरन भारिन ताःपोई जेँन धोन खेनानवन ठेकदारग र्‌वाबो, ‘खेः धोन खेनान्न सिमिकाङ्मोः स्वा र्‌वार्‌वा ख्युई धोन खेपान ज्याला भिना। ज्याला पुरून खेरे ङिक स्वानानवलम सुरु खेखे अन्त्यग पुरून खेरे ङू स्वानानकाङ्मोः भिना।’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />आलै ठेकदारजै पाँच बजेराः धोन सुरु खेनानकाङ्मोः पहिली स्वा र्‌वार्‌वा पुरूग मुलन सिक्‌का ती ती ज्याला बिम्बो। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />मन्तौ पुरून खेरे ङू धोनग जाःनानवजै चन लैः देत्तरा र्‌वार्‌वा नावा खेबो। जेङ्नै ख्युई र्‌वार्‌वा मुलन सिक्‌का ती ती मात्र देप्पो। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />आलै ज्याला देप्मी ख्युई जेँ-जेँन ज्याला वप्पो रे बारीन ताःपोन स्याह् वैवै गनगन खेमः जाःबो। <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />ख्युई र्‌वाबो, ‘सेह्‌ना, अन ङिक स्वानान्न सिमिवजै ता घन्तादी मात्र धोन खेबो, ङी ता ङिह्‌म पुरू छाप्पाः धोन खेपा। जेङ्नै नाई ता ख्युकाङ्मोः र्‌वार्‌वा ङिन झोरै ज्याला बिम्बो!’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />जेङ्नै ताःपोई ख्युन बर्ग तीपाः झब भिनैभिनै र्‌वाबो, ‘सेह्‌ना ग्याप्पा, ङै नाः अन्याय खेपा मीपा। ना ता मुलन सिक्‌कादीग ङिह्‌म्पुरू धोन खेमः मन्जुर रह्पा नङ्पा तै? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />ना जेँन देत्त्वानान्न ज्याला वव्वै यिम वया। ङा अन धोनग ङिक स्वानान्न सिमी र्‌वार्‌वा नान झोरै बिनसुम खेनान। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />तै ङाः जेँन सोह्ङ जेँजै बिन्सुम रह्पाकाङ्मोः बिन्चेन आङ मीपा तै? ङन उदारताग ना तैङ थादोवा खेनान?’” <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />ल्होई चाराईचाराई येसुई र्‌वाबो, “झामखेखेई ङीस्योवा ङूस्योवा राह्‌नान ङ्याह् रे ङूस्योवा चन ङीस्योवा राह्‌नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्ती १९:३०</ref>; <ref loc="MRK 10:31">मर्क १०:३१</ref>; <ref loc="LUK 13:30">लुक १३:३०</ref></char></note><verse eid="MAT 20:16" /></para>
  <para style="s">येसुई सुमरेप जेँ सिह्‌नान्न भारेः चर्चा खेपा</para>
  <para style="r">(<ref loc="MRK 10:32-34">मर्क १०:३२-३४</ref>; <ref loc="LUK 18:31-34">लुक १८:३१-३४</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />यरूसलेमक्याँ वैतौ येसुई जेँन चेला च्योङेपाः तीक्याँ स्वा र्‌वार्‌वा र्‌वाबो, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“सेह्‌ना, ङि यरूसलेम वैयङ ङिह्पा। स्याह् सिमिन ङोह्जोः ङोत्वा पुजारीव रे कानुन लन्नान्न सिमिवन लाह्ग थोन्नान ङ्याह्। ख्युई नू सन्नान्न धल बिन्नान ङ्याह् <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />आलै यहूदीन खोलोःन सिमिवन लाह्ग थोन्नान ङ्याह्। ख्युई नू खिसि खेनान ङ्याह्, चेरन ताल्च्याई फ्याङ्नान ङ्याह् आलै क्रुसग चुनचुन सन्नान ङ्याह्। जेङ्नै सुमङीग नु ह्‌याङ सिह्पालै सम्पु ग्युर्नान ङ्याह्।”<verse eid="MAT 20:19" /></para>
  <para style="s">ती मान छ्याफुल</para>
  <para style="r">(<ref loc="MRK 10:35-45">मर्क १०:३५-४५</ref>; <ref loc="LUK 22:24-27">लुक २२:२४-२७</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />मन्न छाम्म जब्दियान ङोह्जो ङेह् जेँन मान ङ्याबो येसुन रह्‌म्म होई। ख्युन माई येसुन लेह् ध्वाध्वा छ्याःफुल्बो, “ङाः दया ख्या।” <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />येसुई नू लोप्पो, “नाः तै त्वाबो, ङाः र्‌वा?” नुई मर्‌वाबो, “लेह् ध्वा, ना झली रातौ ङन अन ङोह्जो ङेह् नान याईपा रे योम्मक्याँ छ्युङ्चे धेराःयो।” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />येसुई ख्युकाङ्मोः झब बिम्बो, “ङेनजै तै तोल्ङ, अन ङेनकाङ्मोः क्युई मह्‌या। तै ङै थुङत्वानान्न तूरिन खोरे ङेन रे थुङ तैनौ?” ख्युई तैनान र्‌वार्‌वा झब बिम्बो। <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />तब येसुई र्‌वाबो, “तेम्मा, ङै थुङ्नान्न खोरे ङेन रे थुङ्नान ङ्याह्। जेङ्नै ङन याईपा रे योम्मक्याँ छ्युङ्नान चन ङै बिन्नान्न ल्होई नङ्पा। अन ठाउँव ता ङन पाई सुन भिह्तु तयार खेपा ङ्याह्, नू बिन्नान ङ्याह्।” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />अन ल्होई ताह्ताह् घङ चेला च्युपाव चन मन ङेह्‌न ङ्याबो सुतूबो <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />आलै येसुई ख्यु पुरूग जेँन रह्‌म्म स्वा र्‌वार्‌वा र्‌वाबो, “ङेनकाङ्मोः क्युई ङ्याह्, यहूदीन खोलोःन सिमिवन झलीव ख्युन ङ्याः प्रभुत्व खेँ आलै हाकिमजै घङवन ङ्या आङ खेँ। <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />जेङ्नै ङेनकाङ्मोः चन झाःम राचे नङ्पा। ङेनकाङ्मोः ता किम राचे फान्नानजै पुरून सेवक रात्वानान। <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />सुस्याङ ङेनकोन बर्ग पुरून खेरे ङू रासुम खेँ नु ङेनकोन राङ्पा रात्वानान। <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />उजुखेखेई ङा सिमिन ङोह्जो यङ घङ्लम सेवा देप्मः नङ्पा, जेङ्नै घङ्न सुचा खेमः रे लैःनै छुतकरा भिह्तु मोलस्वरुप जिन्दगी बिम्मः जेँनै परान पह्‌म्मः स्वापा जेङ्पा।”<verse eid="MAT 20:28" /></para>
  <para style="s">येसुई काना ङेह्पाः ताःफाम्पा</para>
  <para style="r">(<ref loc="MRK 10:46-52">मर्क १०:४६-५२</ref>; <ref loc="LUK 18:35-43">लुक १८:३५-४३</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />आलै येसु रे नुन चेलाव यरीहो सहरलै वैतौ सिमिवन मोङ किम येसुन ङिह्‌ङिह्‌ जाःबो। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />लम्न नाः काना ङेह्पाव छ्युङ्पा ङ्याह्। येसु मनै लम राह्‌राह्‌ वैयङ खेपा क्युई राह्‌राह्‌ ख्युई फाईरा खेईखेई र्‌वाबो, “हे दाऊदन ङोह्जो, हे प्रभु, ङिन ङ्या दया ख्या!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />सिमिवजै ख्युकाङ्मोः “तै मर्‌वारेः छ्योवा” र्‌वार्‌वा ङार्बो। जेङ्नै ख्युई झन फाईरा खेखे र्‌वाबो, “हे दाऊदन ङोह्जो, हे प्रभु, ङिन ङ्या दया ख्या!” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />लेन्तौलेन्तौ येसु खल्बो आलै ख्युकाङ्मोः स्वा र्‌वार्‌वा लोप्पो, “ङेनकोन भिह्तु ङै तै खेत्वाबो?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />ख्युई छ्याःफुल्फुल र्‌वाबो, “प्रभु, ङी मी रङ्चे धेराःयो!” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />येसुई दिसाबो रे नुई ख्युन मी ज्यार्बो। मन्नै भेला ख्यु मी रङ्नान रह्पा आलै येसुन ङिक जाःबो।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">येसुन येरुसलेमग ताप्पा</para>
  <para style="r">(<ref loc="MRK 11:1-11">मर्क ११:१-११</ref>; <ref loc="LUK 19:28-40">लुक १९:२८-४०</ref>; <ref loc="JHN 12:12-19">यूह १२:१२-१९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />यरूसलेम वैतौवैतौ ख्यु येरुसलेमन ङेह्‌मै जैतून धुरन रह्‌म्मन बेथफागे र्‌वापू स्वा ताप्पो। स्याह्‌लै येसुई चेला ङेह्पाकाङ्मोः झाःम र्‌वार्‌वा फेप्पो, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“ङेन धिङाःन नामग वया। नामग जाःलुङ्मीम ङेनजै पूँह्‌न तह्जा मा ङ्याबोई खीखी नाम्पा दोःनान ङ्याह्। मन ङेह्पाः फोलफोल ङन स्यीह् सह्‌रा। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />यदि सुई ङेनकाङ्मोः ल्होई तयाः र्‌वाङिन ‘प्रभू अन त्वापा ङ्याह्’ र्‌वाःयो आलै नुई मनग तुरुन्तै फेन्नान।” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />भबिस्यबक्ताजै पबित्रसास्त्रग सर्पान अन ल्होई पुरा राःयो र्‌वार्‌वाई झाःम रामः स्वापा जेङ्पा, <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />सियोन्न चमेः र्‌वा, “सेह्‌ना, ता ङेनकोन झली ङेन स्याह् स्वाङ, नु नम्र राह्‌राह्‌ पूँह् चपचप स्वाङ, नु पूँह्‌न तह्जान लाह्ः चपचप स्वाङ।”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />मन चेलावजै वैवै येसुई कोह्पा लैमै खेबो। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />ख्युई पूँह्‌न तह्जा मा ङ्याबोई वव्वै स्वाबो रे नुन ङिङाः जेँ-जेँन घोलाङ तीह्बो आलै येसु चप्पो। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />सिमिवन मोङ किमदीजै जेँ-जेँन घोलाङव फोलफोल लमग तीह्बो। घङ हातिपाई चन तङ्पुलै स्याउलाव थुम्थुम वव्वै लमग तीह्बो। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />येसुन धेँवछोँलै लेन्नान सिमि पुरून मोङवजै झाःम र्‌वाईर्‌वाई फाईरा खेमः जाःबो, “दाऊदन ङोह्जोन झयजक्‌कार राःयो! परमप्रभुन मिह्‌नग स्वानान कताःमन धन्न जेङ्पा! पुरून खेरे तोह्ः स्वर्गः ङिह्पान परमेस्वरन झयजक्‌कार राःयो!”<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">भजन ११८:२५-२६</ref></char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />येसु यरूसलेमग जाःतौ सहरभरी फाईराकुईरा रह्पा रे सिमिवजै लोप्पो, “अन सु जेङ्पा?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />मोङग ङिह्पान सिमिवजै झब बिम्बो, “नु ता गालीलन नासरतलै स्वापान भबिस्यबक्ता येसु जेङ्पा।”<verse eid="MAT 21:11" /></para>
  <para style="s">येसु आराधनालयग वैपा</para>
  <para style="r">(<ref loc="MRK 11:15-19">मर्क ११:१५-१९</ref>; <ref loc="LUK 19:45-48">लुक १९:४५-४८</ref>; <ref loc="JHN 2:13-22">यूह २:१३-२२</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />येसु आराधनालयग होई आलै स्याह् र्‌युच्‌चे खेखे पुरु छ्युङ्नानकाङ्मोः आराधनालयलै धाम्बो। नुई सोह्ङ फिन्नानवन तेबलव धिम्बो रे पुरेन र्‌युन्नानवन छ्युङ्पूव धिम्बो। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />आलै नुई ख्युकाङ्मोः र्‌वाबो, “पबित्रसास्त्रग झाम सर्पा ङ्याह्, ‘ङन यिम सोअताप्नान्न यिम रात्वानान।’ जेङ्नै ङेनजै ता अनग च्यापावन अद्‌दा दोङ्पा ङ्याह्!”<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">यसै ५६:७</ref>; <ref loc="JER 7:11">यर ७:११</ref></char></note> <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />मन्न छाम्म काना रे लुल्याव आराधनालयग येसुन स्याह् स्वाबो। नुई ख्युकाङ्मोः ताःफाम्बो। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />अन हालाईचेन धोनव रङरङ रे आराधनालयग वैचावजै फाईरा खेईखेई “दाऊदन ङोह्जोन झयजक्‌कार राःयो!” र्‌वापा ताह्ताह् ङोत्वा पुजारीव रे कानुन लन्नान्न सिमिव सुतूबो। <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />ख्युई येसू लोप्पो, “अन वैचावजै तै र्‌वाङ, नाई मताँयौ?” येसुई झब बिम्बो, “ताँ जेङ्नै हे प्रभु, होमा थुङ्नान्न वैचावन ङुरलै नाई प्रसङ्सा खेपा रा त्वानान र्‌वार्‌वा पबित्रसास्त्रग सर्पान ल्होई तै ङेनजै तोअपा मीपाऊ?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />आलै येसु यरूसलेम सहरलै गेग्गे ख्युकाङ्मोः ख्योवाख्योवा बेथानिया नामग होई रे छान्जे स्याह्ई छ्युङ्बो।<verse eid="MAT 21:17" /></para>
  <para style="s">येसुई खोअन तङ्पू सराप खेपा</para>
  <para style="r">(<ref loc="MRK 11:12-14">मर्क ११:१२-१४</ref>; <ref loc="MRK 11:20-24">११:२०-२४</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />नाप्चे नाह्पपर्मै यरूसलेम सहरक्याँ होल्तौ येसू गुसिह्बो। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />लम्न नाः खोअन तङ्पु रङरङ फल ङिम कि र्‌वार्‌वा नु मन तङ्पुन रह्‌म्म होई, जेङ्नै मनग ल्हा नङ्म घङ तये मह्‌या। नुई मन तङ्पू र्‌वाबो, “तान धेरा नान स्याह् हातौयै फल नछ्याःयो। मन खोअन तङ्पु ता मन्नै भेला खार्बो।” <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />अन रङरङ चेलावजै हालाईलाई लोप्पो, “अकेः खम्म अन खोअन तङ्पु कुजुई खार्बो?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />येसुई झब बिम्बो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेनजै ङाईदी यङ सङ्‌का मखेरे बिस्वास खेङिन खोअन तङ्पू ङै खेपालैम खे तैनान रे अकेः मात्र नङ्पा, ङेनजै अन धुरग ‘स्यीह्‌लै वैवै समुन्द्रग छारा’ र्‌वाङिनै उजुई राह्‌नान ङ्याह्। <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />यदि बिस्वास खेङिन सोअतापग तै तोल्नै ङेनजै मन देन्नान ङ्याह्।”<verse eid="MAT 21:22" /></para>
  <para style="s">येसुन आङ्न भारेः लोप्पा</para>
  <para style="r">(<ref loc="MRK 11:27-33">मर्क ११:२७-३३</ref>; <ref loc="LUK 20:1-8">लुक २०:१-८</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />येसुई आराधनालयग लनयङ ङ्याह्। मन्तौ ङोत्वा पुजारीव रे घङ अगुवावजै नुन स्याह् स्वास्वा नू लोप्पो, “नाई खालै आङ देद्‌दे अन धोन खेनान? अन आङ नाः सुई बिम्बो?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />येसुई ख्युकाङ्मोः झब बिम्बो, “ङा यङ ङेनकाङ्मोः ल्होईदी लोच्‌चे, ङाः झब बिङ्‌ङिन ङै खालै आङ देद्‌दे अन धोन खेनान, मन ङेनकाङ्मोः र्‌वानान ङ्युँ। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />ता र्‌वा, यूहन्नाई बप्‌तिस्मा बिन्नान्न आङ खालै देप्पो, स्वर्गन परमेस्वरलम कि सिमिलम?” अन ताह्ताह् ख्यु राह्ङराङ्साः झामखेखे ल्होई र्‌वामः जाःबो, “ता ङी तै झब बिन्चे? स्वर्गन परमेस्वरलम र्‌वाङिन ‘ङेनजै यूहन्नाः तैङ बिस्वास मखेपा न?’ र्‌वार्‌वा नुई लोन्नान ङ्याह्। <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />यदि सिमिलम र्‌वाङिन ङी सिमिकाङ्मोः ङिन्चे ङ्याह् तैङर्‌वाङिन पुरूजै यूहन्नाः भबिस्यबक्ता जेङ्पा र्‌वार्‌वा ङ्यान्नान।” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />अन्नकारन ख्युई येसू र्‌वाबो, “च्या, ङी ता क्युई मीपा।” तब येसुई र्‌वाबो, “आन ङै खालै आङ देद्‌दे अन धोन खेँ, ङा रे ङेनकाङ्मोः मर्‌वा।”<verse eid="MAT 21:27" /></para>
  <para style="s">ङोह्जो ङेह्‌न द्रिस्तान्त</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />ता, “ङेन तै छोए खेनान? सिमिदीन ङोह्जो ङेह् ङ्याह्। नुई कान्स्योवान स्याह् वैवै र्‌वाबो, ‘ए ङोह्जो, त्या नाई अङ्‌गुरन भारी वैवै धोन ख्या कोई।’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />‘ङा मह्ई!’ जेङ्नै ङिक नुन सम फिप्पो रे धोनग होई। <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />आलै पाई वैवै घङ ङोह्जोः र्‌वार्‌वा उजुई र्‌वाबो। आलै नुई र्‌वाबो ‘लौ लौ पा, ङा वैच्योवा।’ जेङ्नै धोनग चन मवैबो। <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />ता अन ङोह्जो ङेह्‌न बर्ग कन चनजै पान इच्छ्या ङ्याम्बो?” ख्युई झब बिम्बो, “कान्स्योवा चनजै!” तब येसुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, कर तुईनान रे पातार्निव ङेन खेरे ङू परमेस्वरन राज्यग जाःङ। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />तैङर्‌वाङिन बप्‌तिस्मा बिन्नान्न यूहन्ना तेम्मा लम थम्मः ङेनकोन स्याह् स्वाबो, जेङ्नै ङेनजै बिस्वास मखेबो। बरु कर तुईनान रे पातार्निवजै चन बिस्वास खेबो। ङेनजै अन रङरङ यङ घ्योप्पा मखेबो रे नू बिस्वास मखेबो।”<note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">लुक ३:१२</ref>; <ref loc="LUK 7:29-30">७:२९-३०</ref></char></note><verse eid="MAT 21:32" /></para>
  <para style="s">अङ्‌गुर बारी रे बारी स्याईग वप्पान सिमिव</para>
  <para style="r">(<ref loc="MRK 12:1-12">मर्क १२:१-१२</ref>; <ref loc="LUK 20:9-19">लुक २०:९-१९</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />येसुई र्‌वाबो, “दे ता ङेन द्रिस्तान्तन रुपग घङ रुह्ङदी ङ्याना। तीरेप खेःन ताःपोदी ङ्याह्। नुई अङ्‌गुरन भारि पाःबो, लिब्रुङक्याँ राह्ः कह्बो आलै अङ्‌गुर पेलि खेमः सिङ्न कोल रे बारी सेह्‌म्म छ्युङ्पु दोङ्बो। स्याह्ई वन्नान सिमिकाङ्मोः जिम्मा बिमबिम जेँ चन प्रदेसराः होई।<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">यसै ५:१-२</ref></char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />अङ्‌गुरन बारी रूचेन भेला रामी नुई जेँन राङ्पाकाङ्मोः जेँन कालाः स्वानान्न अङ्‌गुर तुईमः बारी स्याह्ई वप्पा सिमिवन स्याह् फेप्पो। <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />जेङ्नै मन बारी स्याह्ई वप्पा सिमिव दीदी राङ्पाकाङ्मोः फ्याङ्मः जाःबो, कानग फ्याङ्बो, कानग लुङ्जै फ्याङ्बो आलै कानग चन सह्प्पो। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />ह्‌याङ बारीन ताःपोई ङून खेरे लैः राङ्पाव बारी स्याह्ई वप्पा सिमिवन स्याह् फेप्पो। जेङ्नै ख्युकाङ्मोः र्‌वार्‌वा बारी स्याई वप्पा सिमिवजै ङून सिमिकाङ्मोः लैम खेबो।” <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />“आखिर बारीन ताःपोई ‘ङन ङोह्जोः ता ख्युई तेम्माई सम्मान खेदरा’ र्‌वार्‌वा छुछु जेँनै ङोह्जोः बारी स्याह्ई वप्पा सिमिवन स्याह् फेप्पो।” <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />जेङ्नै मन बारी स्याह्ई वप्पा सिमिवजै ङोह्जो चनग रङ्लुङ्मीम सल्‌ला खेखे र्‌वाबो, “दे, मन ता बारीन ताःपोनै ङोह्जो जेङ्पा। स्वा, ङि नू सह्‌म्मता रे नुन क्युन आङ वम्मता।” <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />झाःम र्‌वार्‌वा ख्युई नू जुङजुङ अङ्‌गुरन भारिलै खोलोः वव्वै सह्प्पो। <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />येसुई लोप्पो, “दे र्‌वा, ता अङ्‌गुरन भारिन ताःपोई स्वास्वा मन बारी स्याह्ई वप्पा सिमी तै खेदरा?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />ख्युई झब बिम्बो, “नूँह् स्वास्वा मन अङ्‌गुरन भारी अलः सिमिकाङ्मोः सन्नान ङ्याह् आलै जेँजै देत्‌त्वानान्न स्याईन काला लः खेखे बिन्नान्न सिमिकाङ्मोः मन बारी स्याह्ई बिन्नान ङ्याह्।” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />येसुई ख्युकाङ्मोः र्‌वाबो, “तै ङेनजै हातौयै पबित्रसास्त्र तोअपा मह्‌यायौ?”</para>
  <para style="p" vid="MAT 21:42">खार्बावजै फान मत्वानान र्‌वार्‌वा पप्पान लूङै यिमन झग कातौ ङोत्वा लुङ रामः स्वाबो। उजु ता प्रभु परमेस्वर जेँजै राफाम्पा जेङ्पा, अन हातिन हालाईचेन धोन ङिम्न! <verse eid="MAT 21:42" /><verse number="43" style="v" sid="MAT 21:43" />“मन्नैकारन ङा ङेनकाङ्मोः र्‌वाचे, परमेस्वरन राज्य ता ङेनलम तलतल फल छ्यानान्न यहूदीन खोलोःन सिमिदीग बिन्नान ङ्याह्। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />मन लुङ्‌न लाह्ः घ्यानान पुरू राःपा राह्‌नान ङ्याह् आलै सुनै लाह्ः घ्याङिन नु चकनाचुर राह्‌नान ङ्याह्।” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />येसुई र्‌वापान अन द्रिस्तान्तव ताह्ताह् ङोत्वा पुजारीव रे फरिसी र्‌वानान्न कठोर धार्मिक मोङन सिमिवजै अन ल्होई जेँगै र्‌वापा जेङ्पा र्‌वार्‌वा हाकोबो। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />मन्नैकारन ख्युई नू जुङ्चे फाप्पो, जेङ्नै ख्यु सिमिवलम ङिह्‌म्बो तैङर्‌वाङिन सिमिवजै येसू भबिस्यबक्ता जेङ्पा र्‌वार्‌वा ङ्याङ्‌ङ।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">भ्यान भत्यारन द्रिस्तान्त</para>
  <para style="r">(<ref loc="LUK 14:15-24">लुक १४:१५-२४</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />आलै येसुई ख्युकाङ्मोः ह्‌याङ द्रिस्तान्तग ल्होई र्‌वाबो, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“स्वर्गन राज्यग झलीदीन ङ्याबो तुलना खेतैनान, सुई जेँन ङोह्जोन भ्यान भत्यार तयार खेबो। <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />मन झलीजै घ्वापाकाङ्मोः स्वा र्‌वामः जेँन राङ्पाव फेप्पो। जेङ्नै ख्यु मस्वाबो।” <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />आलै नु ह्‌याङ घङ राङ्पाकाङ्मोः झाःम र्‌वार्‌वा फेप्पो, “वैवै मन घ्वानानकाङ्मोः र्‌वा, ‘झाचेन भेला रह्बो, ङन मिबा रे चोःम-चोःम भस्तव थुम्पा ङ्याह्। ता भत्यार झाचेन भिह्तु स्वा’।” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />जेङ्नै मन घ्वापावजै वास्ताई मखेरे जेँ-जेँन धोनग होई। कान जेँन खेःराः होई आलै कान चन जेँन ब्यापार्राः जाःबो। <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />घङ लाःमा सिमिवजै चन झलीन राङ्पाकाङ्मोः जुङजुङ फ्याङ्बो रे सह्प्पो। <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />मन झली सुतूबो आलै जेँन सेनाव फेप्पे मन सिमि सन्नानकाङ्मोः मीपा दोङ्बो रे ख्युन सहरग कोह्बो। <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />मन्न छाम्म नुई राङ्पाकाङ्मोः ह्‌याङ र्‌वाबो, “भ्यान भत्यार ता तयार ङ्याह्, जेङ्नै ङै घ्वापाव चन अन भत्यार झाचेन सम स्योरस्योरलैम मीह्‌मन।” <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />“अन्नकारन ङेनको चोकवग वया रे सुवा-सुवाः धोँ, ख्युकाङ्मोः भत्यारग घ्वाघ्वा सह्रा।” <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />आलै राङ्पाव सदकग होई रे दोःपाभरी लः अलः पुरूग रूबो। झामखेखे भत्यारन स्याह् सिमिव खाप्च्योवा रह्पा। <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />“झलीजै दम्फुकाङ्मोः सेह्‌म्म स्वातौ तीपाः भ्याःग गोनत्वानान्न घोलाङ मगोनगोन स्वापा रङ्बो। <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />झलीजै नू लोप्पो, ‘ए ग्याप्पा! ना भ्याःन घोलाङै मगोनगोन कुजुई झिङ जाःपा?’ जेङ्नै मन सिमिजै तये यङ झब बिन मतैबो। <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />आलै झलीजै जेँन राङ्पाकाङ्मोः कोह्बो, ‘दे, अन्न लाह्-लेह् खीखी खोलोः नाःतुमाः पह्रा। स्याह् नुई सो चमैचमै दाःपाई छ्योवाःयो’!”<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती ८:१२</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लुक १३:२८</ref></char></note> <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />अन्त्यग येसुई र्‌वाबो, “घ्वापा ता लैः ङ्याह्, जेङ्नै दम्पा चन ङाईदि ङ्याह्।”<verse eid="MAT 22:14" /></para>
  <para style="s">कर फाःनान्न भारेः लोप्पा</para>
  <para style="r">(<ref loc="MRK 12:13-17">मर्क १२:१३-१७</ref>; <ref loc="LUK 20:20-26">लुक २०:२०-२६</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />तब फरिसीव वैवै येसू नुनै ल्होईग कुजुई फसाई खेचे र्‌वार्‌वा योजना दोङ्बो। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />ख्युई जेँन कान चेलाकाङ्मोः हेरोद झलीन सिमिवन ङ्याबोई येसुन स्याह् फेप्पो। ख्युई वैवै नू र्‌वाबो, “हे गुरु, नाई तेम्मा ल्होई र्‌वाङ र्‌वार्‌वा ङी क्युई ङिह्पा। सिमिकाङ्मोः लह्‌न्तौ नाई तेम्मा खेखे परमेस्वरन लम् लह्ङ्‌ङ। सिमिवजै तै र्‌वादरा र्‌वार्‌वा नाई वास्ता यङ खेचे नङ्पा। नाई ता सुई ध्वा सेनसेन ल्होई मखेँ! <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />ता ङी र्‌वा, कानुन अन्सार कैसर आथबा रोमी सरकारग<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">कैसर रोमन झली </char></note> कर फाःम नान छोएग लः ङ्याह् कि मह्‌या?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />ख्युन झाम नावा अलः हाकोको येसुई र्‌वाबो, “ए ख्वाकिबाव हो, ङाः तैङ फसाई खेचे फान्नान? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />खाले कर फाःनान्न सिक्‌कादी थना न।” ख्युई नू सिक्‌का सस्सै थम्बो। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />आलै नुई ख्युकाङ्मोः लोप्पो, “अन ध्वाःन छाप रे मिह्‌न सुन जेङ्पा?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />ख्युई झब बिम्बो, “अन ता कैसर आथबा रोमी सरकारन जेङ्पा।” तब येसुई र्‌वाबो, “आन सरकारन चन सरकारग भिना रे परमेस्वरन चन परमेस्वरग भिना।” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />येसुन झब ताह्ताह् ख्युई हालाईबो आलै नू ख्योवाख्योवा होई।<verse eid="MAT 22:22" /></para>
  <para style="s">सिह्पालै सम्पु ग्युर्नान्न भारेः लोप्पा</para>
  <para style="r">(<ref loc="MRK 12:18-27">मर्क १२:१८-२७</ref>; <ref loc="LUK 20:27-40">लुक २०:२७-४०</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />मन्नै लाह्ः हातिपा सदुकीव येसुन स्याह् होई। रे सिमि सिह्पालै सम्पु ग्युर्नान ङ्याह् र्‌वार्‌वा दाबि खेबो आलै ख्युई येसू लोप्पो, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“हे गुरु, मोसाई ता झाम र्‌वापा ङ्याह्, सुई धाज्यु सन्तान मर्हारे सिङिन धाज्युन भिह्तु सन्तान राःयो र्‌वार्‌वा भाइजै मन लम्मान ङ्याबो मिह्जि खेत्वानान।<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">कानुन २५:५</ref></char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />ता ङिन घूँ नेह् थिक्‌कोव ङ्याह्। धाज्यु कान्स्योवाजै मिह्जि खेबो, जेङ्नै ङोह्जो-चमेः मराह्‌रेई सिह्बो। उजु राह्‌राह्‌ भाइजै च्योङ्‌न ङ्याबो मिह्जी खेबो। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />जेङ्नै नु रे सन्तान मर्हारे सिह्बो। बर्म भाइजै र्‌वार्‌वा झाःमै खेबो रे उजु खेखेई भाई नेह्जै मिह्जी खेबो, जेङ्नै वैचा मह्‌रारे सिह्बो। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />मन्न छाम्म ङिक मन चिमिचा यङ सिह्बो। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />ता सिह्पा पुरूवलम सम्पु ग्युर्ङिन मन नेह्‌न बर्ग नु सुन मिसा राह्‌नान? नू ता थिक्‌कोव नेह्पाई मिह्जी खेपा ङ्याह्!” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेन भ्रमग परि रह्पा ङ्याह्। ङेनजै पबित्रसास्त्र रे परमेस्वरन सक्तिन भारेः हामकोँ। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />सिह्पान सिमिव सम्पु ग्युर्मी ता ख्युन मिह्जि राचे रे खे फान्चेन ल्होई राह्‌नान मह्‌या। ख्यु ता स्वर्गः छ्युङ्नान्न स्वर्गदुतवलैम राह्‌नान ङ्याह् <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />जेङ्नै सिह्पावन बर्ग सम्पु ग्युर्नान्न भारेः परमेस्वरजै ङेनकाङ्मोः तै र्‌वापा ङ्याह्, अन ङेनजै तोअपा मीपाऊ? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘ङा अब्राहाम, इसहाक रे याकूबन परमेस्वर जेङ्पा’ परमेस्वर सिह्पावन नङ्पा, जेङ्नै सम्पुवन परमेस्वर जेङ्पा।” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />झाःमन नुन छोए ताह्ताह् सिमिन मोह्ङव हालाईबो।<verse eid="MAT 22:33" /></para>
  <para style="s">पुरून खेरे किम आग्या</para>
  <para style="r">(<ref loc="MRK 12:28-34">मर्क १२:२८-३४</ref>; <ref loc="LUK 10:25-28">लुक १०:२५-२८</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />येसुई सदुकीकाङ्मोः तै मर्‌वारे छ्युङ्फाम्बो र्‌वानान्न ल्होई ताह्ताह् फरिसीव जोमजोम नुन स्याह् स्वाबो। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />ख्युन बर्ग कानुन लन्नान्न सिमिदीजै येसू छोए सेन्चेन भिह्तु नू लोप्पो,<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लुक १०:२५-२८</ref> </char></note> <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“हे गुरु, मोसान कानुनग पुरून खेरे किम आग्या कन जेङ्पा?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />येसुई झब बिम्बो, “नाई परमप्रभु जेँन परमेस्वरग जेँन सम पुरू, परान पुरू रे नावा पुरूजै मया ख्या।<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">कानुन ६:५</ref></char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />पुरून खेरे ङूस्योवा रे किम आग्या अनै जेङ्पा। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />आलै झाःमै घङ ङेह् रे किम आग्या अनै जेङ्पा, ‘जेँन खिम्जेःग जेँगै लैम मया ख्या।’<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवी १९:१८</ref></char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />मोसान कानुन पुरू भबिस्यबक्तान छोएवन आधार अनै आग्या ङेह् जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लुक १०:२५-२८</ref></char></note><verse eid="MAT 22:40" /></para>
  <para style="s">मसिहन भारेः लोप्पा</para>
  <para style="r">(<ref loc="MRK 12:35-37">मर्क १२:३५-३७</ref>; <ref loc="LUK 20:41-44">लुक २०:४१-४४</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />मन्न भेला येसुई मोङ दोङदोङ स्वापान फरिसीकाङ्मोः लोप्पो, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“मसिहन भारेः ङेन तै छुनान? नु सुन सन्तान जेङ्पा?” ख्युई झब बिम्बो, “नु ता दाऊदन सन्तान जेङ्पा।” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />येसुई ख्युकाङ्मो र्‌वाबो, “आन तैङ दाऊदग परमेस्वरन आत्माई नू ‘प्रभु’ र्‌वा फाम्बो?” तैङर्‌वाङिन दाऊद जेँजै ता झामखेखे र्‌वापा ङ्याह्:<verse eid="MAT 22:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 22:44" />परमप्रभुई ङन प्रभू र्‌वाबो, “ङै नान बैरिकाङ्मोः नान तिङ्पान पोँ मनान्न बेर ना ङन याईपाक्याँई छ्योवा।”<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन ११०:१</ref></char></note> <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />“झामखेखे दाऊद जेँजै मसिहग प्रभु र्‌वाङिन कुजुई मसिहग दाऊदन सन्तान र्‌वाचे?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />“जेङ्नै सुई र्‌वार्‌वा झब तये बिन मतैबो। आलै मन्न लाह्‌ःलै सुई र्‌वार्‌वा येसू ल्होई तये लोच्‌चेन हिम्मत यङ मखेबो।”<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">येसुन कानुन लन्नान्न सिमिव रे फरिसीवन बिरोधग चेतावनी</para>
  <para style="r">(<ref loc="MRK 12:38-40">मर्क १२:३८-४०</ref>; <ref loc="LUK 11:39-52">लुक ११:३९-५२</ref>; <ref loc="LUK 20:45-47">२०:४५-४७</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />येसुई सिमिवन मोङ रे जेँन चेलाकाङ्मोः झाम र्‌वाबो, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“कानुन लन्नान्न सिमिव रे फरिसीवजै मोसान कानुन लन्चेन आङ देप्पा ङ्याह्। <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />अन्नकारन ङेनजै ख्युई र्‌वापान ल्होईव ख्या जेङ्नै होस खेखे तैङर्‌वाङिन ख्युई घङग ता छोए लह्ङ्‌ङ, जेङ्नै जेँ चन मन मखेँ। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />ख्यु घङग चन कानुन्न हुर लीह्‌म हुर फाङ्‌ङ, जेङ्नै जेँ चन मन हुर हुर्चे ता धेरा नाह्‌ना, ल्हाजुपजै र्‌वार्‌वा मज्यार्ङ।” <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />ख्यु ल्होई पुरू थन्चेन भिह्तु मात्र खेँ। ख्यु जेँन पह्‌राई रे ल्हान कानुन्न हिगा किम-किम धोँ रे धर्मी जेङ्पा र्‌वार्‌वा थम्मः जेँन घोलाङ्‌ग झुम्का र्‌याङ्म र्‌याङ्म थुप्ङ।<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">मत्ती ६:१</ref>; <ref loc="DEU 6:8">कानुन ६:८</ref>; <ref loc="NUM 15:38">गन्ती १५:३८</ref></char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />ख्यु भत्यारवग सम्मान देच्‌चे रे आराधनालयग ङोतोव आसनवग छ्युङ्म स्याँ। <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />बजारवग तूतौ सिमिवजै जेँग सम्मान खेखे ध्वा ख्याःयो आलै गुरु र्‌वाःयो र्‌वानान ङेन इच्छ्या खेँ। <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />जेङ्नै “ङेनकाङ्मोः सुई गुरु नर्‌वाःयो तैङर्‌वाङिन ङेन ता पुरू थिक्‌कोवई जेङ्पा। ङेनकोन तिबाःदि गुरु ङ्याह्। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />अन पिर्थीबी ङेनजै सुई पा नर्‌वाःयो तैङर्‌वाङिन ङेनकोन तीबाःदि पा ङिह्पा, सु स्वर्गः ङिह्पा। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />ङेनकाङ्मोः सुई गुरु नर्‌वाःयो तैङर्‌वाङिन ङेनकोन गुरु तीबाःदि मसिह जेङ्पा। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />ङेनकाङ्मोः पुरून खेरे किमै चन पुरून सेवक रात्वानान।<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">मत्ती २०:२६-२७</ref>; <ref loc="MRK 9:35">मर्क ९:३५</ref>; <ref loc="MRK 10:43-44">१०:४३-४४</ref>; <ref loc="LUK 22:26">लुक २२:२६</ref></char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />जेँ किम राचे फान्नान चन छ्युम दोङ्नान ङ्याह् रे जेँग छ्युम दोङ्नान चन किम दोङ्नान ङ्याह्।”<verse eid="MAT 23:12" /></para>
  <para style="s">कैफतिन बिरोधग चेतावनी</para>
  <para style="r">(<ref loc="MRK 12:40">मर्क १२:४०</ref>; <ref loc="LUK 11:39-42">लुक ११:३९-४२</ref>; <ref loc="LUK 20:47">२०:४७</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“ए कानुन लन्नान्न सिमि रे फरिसीव हो! ङेनकाङ्मोः धिक्‌कार ङ्याह्! ङेन ता ख्वाकिबा ङ्याह्। ङेनजै स्वर्गन राज्यन झलाः थाःपा ङ्याह्। ङेह् र्‌वार्‌वा झिङ मजाँः आलै झिङ जाःचे फान्नानकाङ्मोः र्‌वार्‌वा जाःमफाङ्‌ङ।” <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />“ए कानुन लन्नान सिमि रे फरिसीव हो! ङेनकाङ्मोः धिक्‌कार! ङेन ता ऊजूपा ङ्याह्। ङेनजै लम्मावन यिम तल्ङ रे हेँ थन्चेन भिह्तु र्‌याङ्म-र्‌याङ्म सोअताप्ङ। अन्नैकारन ङेनजै ह्‌याल्म धल देन्नान ङ्याह्।” <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />“ए कानुन लन्नान्न सिमि रे फरिसीव हो! ङेन ता ख्वाकिबा ङ्याह्। घङग जेँन पातिग सम्म सन्सारभरी रूङ रे सुई जेँन पातिग सङ्‌ङिन नू जेँनखेरे दोब्बर ङ्यालान सम स्योरस्योर लैम धोँ।” <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />“ए काना अगुवाव हो! ङेनकाङ्मोः धिक्‌कार! ङेनकोजै ‘आराधनालय ज्यारज्यार रेनरुतौ तये मराह्‌नान, जेङ्नै आराधनालयन मर ज्यारज्यार रेनरुतौ चन रेनरुपा ताह्‌नान’ र्‌वार्‌वा लह्ङ्‌ङ। <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />ङेन कताःमन काना रे मुर्ख ङ्याह्! कनचन ल्होई किम जेङ्पा, मर कि मरग पबित्र दोङ्नान्न आराधनालय? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />ह्‌याङ ‘बेदी ज्यार्‌ज्यार रेनरुङिन तये मराह्‌नान, जेङ्नै बेदीग फुल्पान भेति ज्यारज्यार रेनरुतौ चन रेनरुपा ताह्‌नान’ र्‌वार्‌वा लह्ङ्‌ङ। <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />ङेन कत्यामन काना सिमिव! कनचन ल्होई किम जेङ्पा, बेदीग फुल्पान भेति कि भेती पबित्र दोङ्नान्न बेदी? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />बेदी ज्यारज्यार रेनरुनानजै ता बेदी रे अनग फुल्पान भेति पुरूव ज्यारज्यार रेनरूँ! <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />उजुई खेखे आराधनालय ज्यारज्यार रेनरुनानजै चन आराधनालय रे आराधनालयग छ्युङ्नान्न परमेस्वरगै ज्यारज्यार रेनरूँ। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />स्वर्गन मिह्‌न वव्वै रेनरुनानजै चन स्वर्गन सिङ्‌हासन रे अनग छ्युङ्नान्न परमेस्वरनै मिह्‌नग रेनरूँ।”<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यसै ६६:१</ref>; <ref loc="MAT 5:34">मत्ती ५:३४</ref></char></note> <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />“धिक्‌कार ङेनकाङ्मोः कानुन लन्नान्न सिमि रे फरिसीव हो! ख्वाकिबा हो! तैङर्‌वाङिन ङेन पुदीना, सुप रे जिरा परमेस्वरग फुल्ङ। जेङ्नै न्याय, दया रे बिस्वासलैम कानुन्न ङोत्वा ल्होईवन चन ङेन वास्ताई मखेँ। मन घङ ल्होईन ङ्याबोई न्याय, दया रे बिस्वास यङ खेचे ख्या।<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">लेवी २७:३०</ref></char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />ङेन काना अगुवा जेङ्पा तैङर्‌वाङिन ङेनजै साल्‌लाँ ता याल्ङ, जेङ्नै ऊँतग चन गाल्ङ।” <verse eid="MAT 23:24" /><verse number="25" style="v" sid="MAT 23:25" />“ए कानुन लन्नान्न सिमि रे फरिसीव हो! ङेनको ता ख्वाकिबा ङ्याह्। ङेनकोजै तेर्मा रे खोरे छाङ्म दोङ्चे ता धोँ, जेङ्नै मन्न झिङ चन स्वार्थ रे लोभजै खुखु सप्पान ल्होईवजै काँ। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />ए काना फरिसीव हो! ङू खोरेन झिङक्याँ फ्याँ आलै खोलोःक्याँ यङ खामसाङ्म राह्‌नान ङ्याह्।” <verse eid="MAT 23:26" /><verse number="27" style="v" sid="MAT 23:27" />ए कानुन लन्नान्न सिमि रे फरिसीव हो! ङेनकाङ्मोः धिक्‌कार! ङेनको हाति ख्वाकिबा ङ्याह्। ङेनको ता कमेरोई छिम्पान तुह्‌र्सा लैम ङ्याह्। मन तुह्‌र्सा खोलोःलै सेन्तौ ता लः रँ, जेङ्नै झिङक्याँ चन कुँह्‌म तोन्पान स्युह्‌रु रे बाःपान तैस्याङ पुरू लुईपा राह्‌नान।<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">प्रे २३:३</ref></char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />उजुई खेखे खोलोःलै सेन्तौ चन ङेन सिमिन ङू धर्मी लैम रँ, जेङ्नै झिङ चन ख्वा रे अलःजै नाङ्पा राह्‌नान।<verse eid="MAT 23:28" /></para>
  <para style="s">येसुई ख्युन धलन भारेः भबिस्यबानी खेपा</para>
  <para style="r">(<ref loc="LUK 11:47-51">लुक ११:४७-५१</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“ए कानुन लन्नान्न सिमि फरिसीव हो! ङेनकाङ्मोः धिक्‌कार! ङेनको ता ख्वाकिबा ङ्याह्। ङेनकोजै भबिस्यबक्तावन भिह्तु तुह्‌र्सा लः लःव धोँ रे परमेस्वरन आग्याग जाःपान पबित्र सिमिवन तुह्‌र्साव यङ छाईङ। <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />आलै ङेन र्‌वाङ, ‘ताङ्बो ङिन खेपुलवजै ता भबिस्यबक्ताकाङ्मोः सह्प्पो। जेङ्नै ङेन यङ ख्युन ङ्याबो रह्पान कारन ङ्योअजै चन मनलैम धोन खेमः ख्युकाङ्मोः फुरी खेनान मह्‌या।’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />झाःम र्‌वार्‌वा ङेन जेँगै मन भबिस्यबक्ताकाङ्मोः सन्नान्नै सन्तान जेङ्पा र्‌वार्‌वा साँचि बिङ्‌ङ! <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />ता ङेनकोन खेपुलवजै सुरु खेपान धोन पुरा ख्या!” <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />“ए भुलेनव रे भुलेन्न सन्तान हो! ङेन ङ्यालान धललै कुजुई सोनतैनान?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती ३:७</ref>; <ref loc="MAT 12:34">१२:३४</ref>; <ref loc="LUK 3:7">लुक ३:७</ref></char></note> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />ता लः खेखे ङ्याना, ङा ङेन स्याह् भबिस्यबक्ता, स्योःनान सिमि रे कानुन लन्नान्न सिमिकाङ्मोः फेन्नान ङ्युँ। ख्युन बर्ग ङेनजै हातिग सन्नान ङ्याह्, हातिग क्रुसग च्यार्नान ङ्याह् आलै हातिग चन आराधनालयग चेरन ताल्च्या फ्याङ्नान ङ्याह् रे हातिग सहरदीलै घङ सहरथाल धाम्नान ङ्याह्। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />पिर्थीबी पप्पान धर्मी सिमि पुरून कह: निर्दोस हाबिलन कहलै वव्वै बेरेक्याहन ङोह्जो जकरियान कह थाल, सू ङेनकोजै पबित्र ठाउँ रे बेदीन घूँ सह्प्पो। अन दोस ङेनकोनै थोप्पाः स्वानान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">उत ४:८</ref>; <ref loc="2CH 24:20-21">२ इति २४:२०-२१</ref></char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, अन पुरून दोस अन पुस्तान थोप्पागै स्वानान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="GEN 4:8">उत ४:८</ref>; <ref loc="2CH 24:20-21">२ इति २४:२०-२१</ref> </char></note><verse eid="MAT 23:36" /></para>
  <para style="s">येरुसलेमन भिह्तु येसुन मया</para>
  <para style="r">(<ref loc="LUK 13:34-35">लुक १३:३४-३५</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“यरूसलेम, ए येरुसलेम! ना भबिस्यबक्ताकाङ्मोः सह्ङ्‌ङ रे परमेस्वरजै फेप्पाकाङ्मोः लुङजै फ्याङ्‌ङ। काःमाई काःचावग कप्पालैम ङै हातिरेप नान ङोह्जो-चमेःकाङ्मोः जगाई खेचे फाप्पो, जेङ्नै नाई मङ्याम्बो।” <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />“सेह्‌ना, नान यिम तये मीपा दोङदोङ ख्योवानान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">यर २२:५</ref></char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />ता ङा र्‌वाचे, ‘जबथाल नाई परमप्रभुन मिह्‌नग स्वानान हाति धन्न जेङ्पा’ मर्‌वाङ, तबथाल नाई ङाः रङ्नान मह्‌या।”<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">भजन ११८:२६</ref></char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">येसुई आराधनालय मीपा राह्‌नान्न भारेः ल्होई र्‌वापा</para>
  <para style="r">(<ref loc="MRK 13:1-13">मर्क १३:१-१३</ref>; <ref loc="LUK 21:5-19">लुक २१:५-१९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />मन्न छाम्म येसु आराधनालयलै गेग्गे वैतौ चेलाव स्वास्वा नू आराधनालयन भबनव थन्चे र्‌वार्‌वा नुन रह्‌म्म स्वाबो। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />आलै येसुई र्‌वार्‌वा, “ङेनजै अन पुरू रँ आउ? तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, अन भबनवन लुङ्दीन लाह्ः घङ लुङ यङ लाःमा लुईनान मह्‌या, पुरू दिम्नान ङ्याह्।” <verse eid="MAT 24:2" /><verse number="3" style="v" sid="MAT 24:3" />येसु जैतून धुरग छ्युङ्पान भेलाः चेलावजै तै मर्‌वारे स्वास्वा नू लोप्पो, “गुरुज्यू, ङी र्‌वा न, अन ल्होई पुरूव हातौ राह्‌नान ङ्याह्? आलै ना होलहोल स्वामः जाःपा रे सन्सारन अन्त्य रामः जाःपा ङ्याह् र्‌वार्‌वा ङी कुजुई क्युई रा तैनान?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />येसुई झब बिम्बो, “होसखेखे छ्योवा! सुई ङेनकाङ्मोः छकाई पच्‌चे नधेराःयो <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />तैङर्‌वाङिन लैः सिमिव ‘मसिह ङाई जेङ्पा’ र्‌वाईर्‌वाई ङन मिह्‌नग स्वानान ङ्याह् आलै लैः सिमिकाङ्मोः छकाई पन्नान ङ्याह्। <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />ङेनजै युद्ध रह्पा र्‌वानान रे युद्ध राह्‌नान्न फाईराव ताह्‌नान ङ्याह्। जेङ्नै मन्न भेला ङेन नङिना। मन ल्होई पुरूव ता राई त्वानान, जेङ्नै मन्नै भेला ता सन्सारन अन्त्य मराह्‌नान। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />तैङर्‌वाङिन जातिन बिरोधग जाति, रे राज्यन बिरोधग राज्य च्याङ्नान ङ्याह्। ठाउँ ठाउँग अनिकाल राह्‌नान ङ्याह् रे साँगुल स्वानान ङ्याह्।” <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />अन ल्होईव ता वैचा केतौन स्हरन सुरु मात्र जेङ्पा। <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />मन्न भेला सिमिवजै ङेनकाङ्मोः जुङ्नान्न ङ्याह् रे सजाय बिम्म वन्नान ङ्याह्, हेँ सन्नान यङ ङ्याह्। ङन कारनजै जाति पुरून सिमिवजै ङेनकाङ्मोः मस्याङ्चे खेनान ङ्याह्। <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />मन्न भेला लैःजै जेँन बिस्वासग ख्योवानान ङ्याह्, तीजै घङग धोकेबाज खेनान ङ्याह्, मस्याङ्नान ङ्याह्। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />लैः लबारन भबिस्यबक्ताव गेग्गे लैः सिमिकाङ्मोः छकाई पन्नान ङ्याह्। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />खातत्त्या कानुन मङ्यान्नान लैम अलःव छार्नान्न कारन लैः सिमिवन मया यङ भाम्म राह्‌राह्‌ वैनान ङ्याह्। <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />जेङ्नै अन्त्यन बेर स्थिर छ्युङ्नानव चन बचाई खेनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती १०:२२</ref></char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />जाति पुरून सिमिकाङ्मोः साँचि राःयो र्‌वार्‌वा ङू परमेस्वरन राज्यन ल्होन् लः सन्सारभरी ताह्फेन्नान ङ्याह्। मन्न छाम्म सन्सारन अन्त्य राह्‌नान ङ्याह्।<verse eid="MAT 24:14" /></para>
  <para style="s">ङिनङिनलैम तूरिन भेला</para>
  <para style="r">(<ref loc="MRK 13:14-23">मर्क १३:१४-२३</ref>; <ref loc="LUK 21:20-24">लुक २१:२०-२४</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“भबिस्यबक्ता दानिएलजै ‘आराधनालयन पबित्र ठाउँग मीपा दोङ्नान्न मस्याङ्मस्याङ लैम चिज च्याङ्च्याङ छ्युङ्पा रङ्नान ङ्याह्’ र्‌वापा ङेनजै रङ्नान ङ्याह्। अन्न अर्थ तोअनानवजै हाकोवाःयो।”<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दान ९:२७</ref>; <ref loc="DAN 11:31">११:३१</ref>; <ref loc="DAN 12:11">१२:११</ref></char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />मन्न भेला यहूदियाग ङिह्पाव धुरक्याँ झ्याराःयो। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />यिमन ल्हुपग ङिह्पाव आलमाल दर्मः पोँ यिम नधुलाःयो।<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुक १७:३१</ref></char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />खे-बारी ङिह्पाव जेँन घोलाङ दर्मः होलहोल यिम नस्वाःयो। <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />मन्न भेला काँचिली या खोलग वैचा ङिह्पान माकाङ्मोः मन्न ल्हाः कत्याःमन ङिनङिन लैम रह्दरा। <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />रुन्जेन भेला रे नाह्‌न ल्हाः ज्यार्चे नराःयो र्‌वार्‌वा ङेनजै परमेस्वरग सोअताबा। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />तैङर्‌वाङिन मन्न लाह्‌वग स्वानान लैम तूरि ता सन्सारन सुरुलै चोँन बेर रह्पाई मह्‌या रे ङिक यङ राह्‌नान मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दान १२:१</ref>; <ref loc="REV 7:14">प्रका ७:१४</ref></char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />परमेस्वरजै मन तूरिन दिनव घताई मखेपा जेङ्न सुई सोन तैनान मह्‌या। जेङ्नै जेँन दम्पा सिमिवन कारनजै नुई मन दिन घताई खेनान ङ्याह्। <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />“सेह्‌ना ‘मन्नै भेला मसिह ता स्यीह् ङ्याह् या स्याह् ङ्याह्’ र्‌वार्‌वा ङेनकाङ्मोः सुई र्‌वाङिन मन ल्होई बिस्वास नख्या। <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />तैङर्‌वाङिन झाम लबारन मसिह रे लबारन भबिस्यबक्ताव रङ्नान ङ्याह्। ख्युई किम-किम ताईलुवान धोन रे हालाईचेन धोनव थनथन तैन बेर परमेस्वरजै दम्पान सिमिकाङ्मोः र्‌वार्‌वा झुक्याई खेनान ङ्याह्।” <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />“ङ्याना, ङै ङेनकाङ्मोः अन ल्होई भेला स्वाचेन खेरै ङू र्‌वापा ङिह्पा।” <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />सिमिवजै ङेनकाङ्मोः “नु सुनसान-ठाउँग ङ्याह्” र्‌वानै ङेन स्याह् नवया। ख्युई “सेह्‌ना, नु ता झिङन कोथाः पेर्पा ङ्याह्” र्‌वानै ङेन मन ल्होई बिस्वास नख्या।<note caller="-" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">लुक १७:२३-२४</ref></char></note> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />तैङर्‌वाङिन पान्नाङग स्यारलै ल्हो‌ थाल बिजुली चम्कि रह्पालैम ङा सिमिन ङोह्जो स्वातौ राह्‌नान ङ्याह्। <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />खाः कुँह्‌म ङ्याह्, स्याह्ई च्यारगोएव जोम्ङ!<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">लुक १७:३७</ref></char></note><verse eid="MAT 24:28" /></para>
  <para style="s">सिमिन ङोह्जो रङ्नान्न लाह्ः</para>
  <para style="r">(<ref loc="MRK 13:24-27">मर्क १३:२४-२७</ref>; <ref loc="LUK 21:25-28">लुक २१:२५-२८</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“मन तूरिन दिनव वैमी ङिह्‌मा तुरुन्तै नाःतुमा राह्‌नान ङ्याह्, धाई साल्म बिन्नान मह्‌या, घरव पान्नाङलै छार्नान ङ्याह् आलै पान्नाङन सक्ति पुरूव गुल्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यसै १३:१०</ref>; <ref loc="ISA 34:3">३४:३</ref>; <ref loc="JOL 2:10">योए २:१०</ref>; <ref loc="JOL 3:15">३:१५</ref>; <ref loc="REV 6:12-13">प्रका ६:१२-१३</ref></char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />मन्न भेला पान्नाङग सिमिन ङोह्जो स्वानान्न ताह्ः रङ्नान ङ्याह्। सिमिन ङोह्जोः किम सक्ति रे मकेकुकेन किम महिमान ङ्याबो पान्नाङन नमलूग स्वायङ खेपा रङरङ सन्सारन जाति पुरूव दाःचे खेनान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दान ७:१३</ref>; <ref loc="ZEC 12:10-14">जक १२:१०-१४</ref>; <ref loc="REV 1:7">प्रका १:७</ref></char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />सँह्‌ःलिङ बुन्नान ङ्याह् आलै सिमिन ङोह्जोई स्वर्गदुतकाङ्मोः पिर्थिबी रे पान्नाङ्न कोप्चा लिब्रुङ्‌ग फेन्नान ङ्याह् रे परमेस्वरजै दम्पाकाङ्मोः रूरू सन्नान ङ्याह्।”<verse eid="MAT 24:31" /></para>
  <para style="s">खोअन तङ्पुलम छोए</para>
  <para style="r">(<ref loc="MRK 13:28-31">मर्क १३:२८-३१</ref>; <ref loc="LUK 21:29-33">लुक २१:२९-३३</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“खोअन तङ्पुलम तयाः ल्होई लह्‌ना। अन्न धावग ल्हा पलाई राह्‌राह्‌ तुसा स्वामी रेन्जे रह्दँ र्‌वार्‌वा क्युई राँ। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />उजुखेखेई र्‌वापान अन ल्होई पुरू रायङ खेपा रङ्‌नान ङ्याह्, तब स्वानान्न मन्न भेला रह्‌म्मै, झलाःगै ङ्याह् र्‌वार्‌वा ङेनकाङ्मोः क्युई रा। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, अन ल्होई पुरू पुरा मह्‌रान बेर अन पुस्ता ताह्ताह् वैनान मह्‌या। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />पान्नाङ रे पिर्थीबि फ्याफ्या वैनान ङ्याह्, जेङ्नै ङै र्‌वापान ल्होई चन हातौयै ताह्ताह् वैनान मह्‌या।”<verse eid="MAT 24:35" /></para>
  <para style="s">सुई र्‌वार्‌वा मन्न लाह्ः रे भेला क्युई मह्‌या</para>
  <para style="r">(<ref loc="MRK 13:32-37">मर्क १३:३२-३७</ref>; <ref loc="LUK 17:26-30">लुक १७:२६-३०</ref>; <ref loc="LUK 17:34-36">१७:३४-३६</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />जेङ्नै मन्न लाह्‌ः रे भेलान भारेः अन लः खेखे सुई क्युई मह्‌या। मन ता स्वर्गदुतव रे ङा परमेस्वरन ङोह्जोः र्‌वार्‌वा क्युई मह्‌या। मन ल्होई चन केवल परमेस्वर पाः मात्र क्युई ङ्याह्। <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />ङा सिमिन ङोह्जो स्वामः जाःनान्न लाह्‌वग नोआन पाली रह्पालैम राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">उत ६:५-८</ref> </char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />मन्न भेला नोआ त्युन जहाजग मजाःन बेर सिमिव झायङ खेपा, थुङ्यङ खेपा रे मिह्जीव खेपाई छ्युङ्पा ङ्याह्। <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />स्योङ स्वास्वा पुरू स्वात्तै फ्याफ्या मवन्न बेर ख्युकाङ्मोः तये क्युई मरह्पा। ङा सिमिन ङोह्जो स्वातौ यङ उजुई राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">उत ७:६-२४</ref></char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />मन्न भेला बारी धोन खेपाई छ्युङ्पान सिमि ङेह्पावन बर्ग ती वन्नान ङ्याह् रे घङ चन स्याह्ई ख्योवानान ङ्याह्। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />ल्हाकोर राःपाई छ्युङ्पान चिमिचा ङेह्‌न बर्ग ती वन्नान ङ्याह् घङ चन ख्योवानान ङ्याह्। <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />“अन्नकारन ङेन जेर्म राह्‌राह्‌ छ्योवा तैङर्‌वाङिन ङेनकोन प्रभु कन्न लाह्‌ः स्वानान ङ्याह्, अन ङेनकाङ्मोः क्युई मराह्‌नान। <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />जेङ्नै अन ल्होई चिनचिन नाह्‌ना, खुम्पा स्वानान्न भेला क्युई रह्पा जेङ्न ता यिमन ताःपो सापसाप छ्युङ्नान ङ्याह् रे खुम्पाः यिम जाःफान्नान मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">लुक १२:३९-४०</ref></char></note> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />अन्नकारन ङेन यङ जेर्म राह्‌राह्‌ छ्योवा! ङा सिमिन ङोह्जो ङेनजै नावाई मखेपान भेलाः स्वानान ङ्याह्।<verse eid="MAT 24:44" /></para>
  <para style="s">बिस्वासी रे अबिस्वासी राङ्पा</para>
  <para style="r">(<ref loc="LUK 12:41-48">लुक १२:४१-४८</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“बिस्वासी रे बुद्धिमानी राङ्पा सु जेङ्पा? उदाहरन्न भिह्तु मालिकजै जेँन यिमन धोन पुरू जिम्मा बिम्मी बुद्धिमानी रे र्‌वापा लैम राङ्पाई चन घङ राङ्पाकाङ्मोः भेला लः-ल:ग झाफाङ्‌ङ। <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />मालिक होलहोल स्वास्वा मन राङ्पाः उजुई धोन खेपाई छ्युङ्पा दोतौ नु हाति धन्न राह्‌नान ङ्याह्। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, मालिकजै मन राङ्पाः जेँन क्यु पुरून जिम्मा बिन्नान ङ्याह्। <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />जेङ्नै यदि मन राङ्पा अलःजै ‘ङन मालिक पुल्म खेखे होलहोल स्वाङ’ र्‌वानान नछुवा <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />रे ह्‌याल्म रःसि थुङ्नानवन ङ्याबो झाझा योयोई घङ राङ्पाकाङ्मोः फ्याङ्मः जाःङिन <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />मन राङ्पान मालिक नुई नावाई मखेपान लाह्ः रे भेलाः स्वा ताप्नान ङ्याह्। <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />मालिकजै नू तुकरा तुकरा दोङ्नान ङ्याह् रे ख्वाकिबावन भागेदार दोङ्नान ङ्याह्। स्याह् नु दानान ङ्याह् रे सो चप्नान ङ्याह्।”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">कन्या च्युपान द्रिस्तान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />मन्न भेला येसुई हेँ र्‌वाबो, “स्वर्गन राज्य चन धोमः वैनान्न कन्या च्युपान ल्होई लैम राह्‌नान ङ्याह्। कन्या जेँ-जेँन लज्युङ वव्वै मापाः धोमः होई।<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">लुक १२:३५</ref></char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />मन च्युपान बर्ग ङापा बुद्धिमानी रे ङापा चन मुर्ख ङ्याह्। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />मुर्खवजै लज्युङ ता वव्वै होई, जेङ्नै घङ छि चन मवप्पो। <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />जेङ्नै बुद्धिमानीवजै चन लज्युङ्न ङ्याबो बत्ताः घङ छि यङ वप्पो। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />कुकु छ्युङ्तौ माःपा स्वामः पुल्म राह्‌राह्‌ ख्यु पुरू ङ्योम्ङ्योम राह्‌राह्‌ मिवा च्युमः जाःबो।” <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />“छान फेःग ख्युई ‘सेह्‌ना माःपा, नू खेमः च्याँ’ र्‌वापा ताह्बो।” <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />कन्या पुरूव जुरुक्‌क च्याङच्याङ जेँ-जेँन लज्युङव तयार खेबो। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />मुर्ख कन्यावजै चन बुद्धिमानीकाङ्मोः र्‌वाबो, “ङेनकोन छि ङी र्‌वार्‌वा ङाई क न, ङिन लज्युङव ता सिमै जाःपा ङ्याह्।” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />जेङ्नै बुद्धिमानीवजै झब बिम्बो, “ङेनकाङ्मोः र्‌वार्‌वा घङ छि ङिन ङ्याबो मीपा, ङेन पसलग वैवै र्‌युर्‌र्‌युई सह्‌रा न।” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />“आलै मन मुर्ख कन्याव छि र्‌युह्‌म्मः वैतौ माःपा स्वा ताप्पो। तयार राह्‌राह्‌ छ्युङ्पान बुद्धिमानी कन्या ङापा चन माःपान ङ्याबो भ्यान भत्यार मनाई खेमः झिङ जाःबो रे झला यङ बन रह्बो।” <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />“ङाईदिलै मन मुर्ख कन्याव यङ स्वा ताप्पो रे र्‌वामः जाःबो, ‘हे प्रभु, हे प्रभु, ङिन भिह्तु झला पोवा’!”<note caller="-" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="LUK 13:25">लुक १३:२५</ref></char></note> <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />जेङ्नै माःपाई झब बिमबिम र्‌वाबो, “तेम्माई, ङा ङेनकाङ्मोः मस्योःनान!” <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />झामखेखेई येसुई र्‌वाबो, ङेन जेर्म राह्‌राह्‌ छ्योवा तैङर्‌वाङिन सिमिन ङोह्जो कन्न लाह्ः रे कन भेला स्वानान ङ्याह्, अन ङेनकाङ्मोः क्युई राह्‌नान मह्‌या।<verse eid="MAT 25:13" /></para>
  <para style="s">राङ्पा सुमपावन द्रिस्तान्त</para>
  <para style="r">(<ref loc="LUK 19:11-27">लुक १९:११-२७</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />मन्तौ स्वर्गन राज्य झाम राह्‌नान ङ्याह्, “सिमिन ङोह्जो स्वानान्न भेलाः चन मालिकदी परदेस वैवै यिम होल्नान्न भेलाः रह्पालैम राह्‌नान ङ्याह्। मन सिमिजै परदेस वैचेन खेरे ङू जेँन राङ्पाकाङ्मोः स्वा र्‌वार्‌वा जेँन क्यु जिम्म बिम्बो।<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">लुक १९:११-२७</ref></char></note> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />नुई राङ्पान बुद्धि अन्सार ती हजार ङा, घङग हजार ङेह् रे घङग हजारदी मरन सिक्‌का जिम्मा बिमबिम पर्‌देसग होई। <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />हजार ङा मरन सिक्‌का जिम्मा वन्नान राङ्पा चन तुरुन्तै वैवै मन सोह्ङ व्यापारग कह्बो रे नुई मनलै घङ हजार ङा मरन सिक्‌का कमाई खेबो। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />उजुई खेखे हजार ङेह् सिक्‌का जिम्मा वन्नान राङ्पाई र्‌वार्‌वा घङ हजार ङेह् मरन सिक्‌का कमाई खेबो। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />जेङ्नै हजारदी मरन सिक्‌का जिम्मा वन्नान राङ्पाई चन साः लुह्‌म ख्वाख्वा मालिकन ग पेरपेर नाह्‌म्बो।” <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />“भेला लैः वैमी मन राङ्पावन मालिक होलहोल स्वाबो रे ख्युलम जेँन हिसाब वप्पो। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />हजार ङा मरन सिक्‌का देन्नानजै स्वास्वा मालिकग र्‌वाबो, ‘सेह्‌ना, नाई ङाः हजार ङा मरन सिक्‌का बिम्पा ङ्याह्, मनलम ङै घङ हजार ङा बुद्धिजै कमाई खेखे सप्पा ङिह्पा।’” <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />मालिकजै र्‌वाबो, “साबासाबा! ना लः रे र्‌वापालैम राङ्पा जेअँ। ना ल्होई ङाईग र्‌वापालैम रह्पान कारन ङा नाः घङ लैः ल्होईन जिम्मा बिन्चे। ना स्वास्वा ङन ङ्याबो स्याँ।” <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />मन्न छाम्म हजार ङेह् मरन सिक्‌का देन्नानजै स्वास्वा र्‌वाबो, “गुरु, नाई ङाः हजार ङेह् मरन सिक्‌का बिम्पा ङ्याह्। सेह्‌ना, ङै घङ हजार ङेह् कमाई खेखे सप्पा ङिह्पा।” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />मालिकजै र्‌वाबो, “साबासाबा! ना लः रे र्‌वापालैम राङ्पा जेअँ। ना ल्होई कत्याःमः र्‌वापालैम ङिह्पान कारन ङा नाः घङ लैः ल्होईन जिम्मा बिन्चे। ना र्‌वार्‌वा स्वास्वा ङन ङ्याबोई स्याँ।” <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />“मन्न छाम्म हजारदी मरन सिक्‌का देन्नान सिमिजै स्वास्वा र्‌वाबो, ‘गुरु, ना क्योङ्जाखाबा ङ्याह्, नाई जेँजै मपाह्पान भालि गम्गम वन्नान रे जेँजै मताम्पा साह्ई यङ रूनान र्‌वानान्न ल्होई ङाः क्युई ङ्याह्।’ <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />अन्नकारन नाः ङिनङिन ङै ता नान सिक्‌का सान पोँ क्युक्यु नाम्पा। स्यीह् सेह्‌ना अन नान सिक्‌का जेङ्पा।” <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />तब मालिकजै नू र्‌वाबो, “ए बदमास रे अल्छी राङ्पा! ङा जेँजै मपाह्पान बालि गम्‌गम्‌ वन्नान रे जेँजै मताम्पा साह्ई रूनान क्योङ्जाखाबा जेङ्पा र्‌वानान नाः क्युई ङ्याह् र्‌वाङिन <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />नाई ङन सोह्ङ वव्वै ब्याजग बिन्चे नङ्पाऊ न? आलै ङा होलहोल स्वातौ तये मराह्‌नै ब्याज देङ्‌ङ! <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />नुनलम अन मरन सिक्‌का तलतल मनै च्यु थाम मरन सिक्‌का ङिह्पा सिमी भिना <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />तैङर्‌वाङिन सुन ङ्याबो ङ्याह्, नू हेँ बिन्नान ङ्याह् रे नुन ङ्याबो हेँ हाति र्‌वार्‌वा राह्‌नान ङ्याह्। जेङ्नै सुन ङ्याबो मह्‌या, नुनलम ङाई ङिह्पा यङ तल्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती १३:१२</ref>; <ref loc="MRK 4:25">मर्क ४:२५</ref>; <ref loc="LUK 8:18">लुक ८:१८</ref></char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />ता अन फान मीपान राङ्पाः वव्वै खोलोः नाःतुमाः पह्‌रा। स्याह् अनजै सो चमैचमै दाःचे खेपाई छ्योवायो!”<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती ८:१२</ref>; <ref loc="MAT 22:13">२२:१३</ref>; <ref loc="LUK 13:28">लुक १३:२८</ref></char></note><verse eid="MAT 25:30" /></para>
  <para style="s">अन्त्यन न्याय</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“सिमिन ङोह्जो महिमा किमः स्वर्गदुतवन ङ्याबो स्वास्वा जेँन महिमामय सिङ्‌हासनग छ्युङ्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">मत्ती १६:२७</ref>; <ref loc="MAT 19:28">१९:२८</ref></char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />मन्न भेला पिर्थीबिन सिमि पुरूव नुन ङू च्याङ्नान ङ्याह् आलै ग्वाल्याई राह् रे लूपावग फापालैम नुई मन सिमिकाङ्मोः र्‌वार्‌वा फानान ङ्याह्। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />नुई लूपावग जेँन ल्हा याईपाक्याँ रे राह्‌वग जेँन ल्हा योम्मक्याँ फाफा नान्नान ङ्याह्। <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />झलीजै जेँन याईपा ल्हाक्याँन सिमिकाङ्मोः र्‌वानान ङ्याह्, ‘ए ङन पा परमेस्वरलम असिका देप्पान सिमिव हो! स्वास्वा सन्सारन स्रिस्तिलै ङेनकोन भिह्तु तयार दोङदोङ नाम्पान राज्यग छ्योवा <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />तैङर्‌वाङिन ङा गुसितौ ङेनजै ङाः ख्वाबो, त्यु बुल्तौ त्यु बिम्बो रे ङा परदेसी रातौ यङ नान यिम ङाः छ्युङ्फाम्बो। <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />ङा चत्यापा रातौ घोलाङ थम्बो, खङ्तौ सेन्चे खेबो, झ्यालखानाः थेप्‌तौ ङाः धोमः स्वाबो।’” <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />“अन ताह्ताह् परमेस्वरन र्‌वापा ङ्यानैङ्यानै स्वापान धार्मिक सिमिवजै नू लोन्नान ङ्याह्, ‘प्रभु, ङी नाः हातौ गुसिपा रङ्पा रे ख्वापा? हातौ त्यु बुल्पा रङ्पा रे त्यु बिम्पा? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />हातौ ना परदेसी रातौ ङिन यिम नाः छ्युङ्फाम्पा? हातौ नाः चत्यापा रङ्पा रे घोलाङ थम्पा? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />हातौ नाः खङ्पा रङ्पा रे सेन्चे खेपा? आलै हातौ झ्यालखानाः थेप्पो रे ङि धोमः स्वापा?’” <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />तब झलीजै झब बिमबिम र्‌वानान ङ्याह्, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङन भाइवन बर्ग पुरून खेरे छ्युमः ङेनजै तै खेपा, अन ङाः र्‌वार्‌वा खेपा जेङ्पा।” <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />मन्न छाम्म नुई जेँन लाह् याईपाक्याँ रह्पाकाङ्मोः र्‌वानान ङ्याह्, “ए परमेस्वरन सरापित सिमिव हो, स्यीह्‌लै वया! दियाबलस रे नुन स्वर्गदुतकाङ्मोः तयार खेखे नाम्पा हातौयै मसिह्‌नान्न मेह्ग वया! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />तैङर्‌वाङिन ङा गुसितौ ङेनजै ङाः मख्वाबो, त्यु बुल्तौ त्यु मबिम्बो। <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />ङा परदेसी राह्‌राह्‌ स्वातौ ङेनजै ङाः जेँन यिम छ्युङ मफाम्बो, चत्यापा रातौ घोलाङ मथम्बो। ङा खङ्तौ रे झ्यालखानाः थेप्‌तौ ङेन ङाः धोमः मस्वाबो।” <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />“आलै ख्युई लोन्नान ङ्याह्, ‘प्रभु, हातौ ङी नाः गुसिपा, त्यु बुल्पा, परदेसी रह्पा, चत्यापा रह्पा, खङ्पा आलै झ्यालखानाः थेप्पा रङरङ यङ नान सेवा मखेपा?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />मन्न भेला झलीजै ख्युकाङ्मोः र्‌वानान ङ्याह्, ‘तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङन भाइवन बर्ग पुरून खेरे छ्युमः फुरी मखेपाई ङाः मखेपा जेङ्पा।’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />आलै ख्युई चन हातौयै मताह्‌नान्न धल देन्नान ङ्याह्, जेङ्नै धार्मिक सिमिवजै चन हातौयै मताह्‌नान्न झुनि देन्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दान १२:२</ref></char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">येसुन बिरोधग सदेन्त्र</para>
  <para style="r">(<ref loc="MRK 14:1-2">मर्क १४:१-२</ref>; <ref loc="LUK 22:1-2">लुक २२:१-२</ref>; <ref loc="JHN 11:45-53">यूह ११:४५-५३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />अन ल्होई पुरू लनतामी येसुई जेँन चेलाकाङ्मोः र्‌वाबो, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“ङेनकाङ्मोः क्युई ङ्याह्, ङेर्यान ङिक निस्तार तेवर स्वानान ङ्याह्। मन्तौ क्रुसग चुनचुन सच्‌चेन भिह्तु सिमिन ङोह्जो जुङ्फान्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="DEU 12:1-27">कानुन १२:१-२७</ref></char></note> <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />मन्नै भेला कैयाफा प्रधान पुजारीन ख्यामग ङोत्वा पुजारी रे घङ अगुवाव दीदी जोम्बो। <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />मन जोमग ख्युई येसू फाक जुङजुङ सम्मता र्‌वार्‌वा दीदी सल्‌ला खेबो। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />जेङ्नै ख्युई र्‌वाबो, तेवरन भेलाः चन ङी अन धोन खेचे नङ्पा, तेमन्ता सिमिकाङ्मोः फाईराकुईरा राह्‌नान ङ्याह्।<verse eid="MAT 26:5" /></para>
  <para style="s">बेथानीया सहरग येसुन थोप्पाः अत्तर हाल्पा</para>
  <para style="r">(<ref loc="MRK 14:3-9">मर्क १४:३-९</ref>; <ref loc="JHN 12:1-8">यूह १२:१-८</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />येसु बेथानियाग सिमोन कोरन नाह्जा ताह्पान सिमिन यिम ङिम्तौ <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />चिमिचादी ठेकोः मकेकुकेन कुम्म अत्तर सस्सै येसुन स्याह् स्वाबो। रे नु ङ्योप्पा झामः छ्युङ्तौ नुई मन अत्तर पुरू थोप्पाः हाल्बो।<note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लुक ७:३७-३८</ref></char></note> <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />नुई झाःम खेपा कुह् मतैरे चेलावजै र्‌वाबो, “अकेः ह्‌याल्म अत्तर तैङ भाछ्योँवा पाह्दुर पप्पा? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />बरु अनग सोङ लैःग र्‌युह्र्‌युह् बिखारीकाङ्मोः परेःपा जेङ्न राह्‌नान न!” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />ख्युई झाःम ल्होई र्‌वापा ताह्ताह् येसुई र्‌वाबो, “तैङ ङेन अनग तूरि बिन्नान? अनजै ङन भिह्तु धोन लःदी खेपा ङ्याह्। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />बिखारीव ता ङेन ङ्याबो बात्तै राह्‌नान, जेङ्नै ङा ता ङेन ङ्याबो बात्तै मराह्‌नान!<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">कानुन १५:११</ref></char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />अन अत्तर हालहाल अनजै ङन ल्होग लुम्चेन भिह्तु तयार खेपा जेङ्पा। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, सन्सारभरी अन ल्होन् लः खाः-खाः स्यान्नान ङ्याह्, स्याह्-स्याह् अन चिमिचाई खेपान अन धोन्नै चर्चा खेनान ङ्याह्।”<verse eid="MAT 26:13" /></para>
  <para style="s">यहूदा येसू धोका बिम्मः राजि रह्पा</para>
  <para style="r">(<ref loc="MRK 14:10-11">मर्क १४:१०-११</ref>; <ref loc="LUK 22:3-6">लुक २२:३-६</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />मन्न छाम्म चेला च्योङेपावन बर्ग यहूदा इस्करियोत र्‌वानान चन ङोत्वा पुजारीवन स्याह् वैवै र्‌वाबो, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />“यदि ङै येसू जुङ्फाङ्‌ङिन ङाः तै बिन्नान?” ख्युई नू अन धोन्न भिह्तु मुलन सिक्‌का सुमच्यु थाम बिम्बो।<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">जक ११:१२</ref></char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />मन्न भेलालै यहूदाई येसू जुङ्फान्चेन मौका फाम्म जाःबो।<verse eid="MAT 26:16" /></para>
  <para style="s">अन्त्यन भत्यार</para>
  <para style="r">(<ref loc="MRK 14:12-26">मर्क १४:१२-२६</ref>; <ref loc="LUK 22:7-23">लुक २२:७-२३</ref>; <ref loc="JHN 13:21-30">यूह १३:२१-३०</ref>; <ref loc="1CO 11:23-25">१ कोर ११:२३-२५</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />सोरा मकह्पान रोता झानान निस्तार तेवरन ङूस्योवान लाह्ः चेलाव येसुन स्याह् स्वाबो रे लोप्पो, “नान भिह्तु तेवरन भत्यार ङि खाः तयार खेचे?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />नुई ख्युकाङ्मोः र्‌वाबो, “सहरग बिसेस सिमिदीन स्याह् वया रे र्‌वा: गुरुई झाम र्‌वापा ङ्याह्, ‘ङन भेला रह्पा। ङा जेँन चेलावन ङ्याबो नान यिम निस्तार तेवरन भत्यार झासुम ङिह्पा।’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />चेलावजै वैवै येसुई कोह्पा लैम खेबो आलै स्याह्ई निस्तार तेवरन भत्यार तयार खेबो।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />येसु ङ्याजे रामी चेला च्योङेपावन ङ्याबोई झामः छ्युङ्बो। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />झातौ येसुई र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेनकोनै घूँलै तीपाई ङाः बैरिकाङ्मोः जुङ्फान्नान ङ्याह्।” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />अन ताह्ताह् चेलाकाङ्मोः यामयाम सम तूह्बो रे तीपा-तीपाई “प्रभु, तै ङा ता नङ्मतौ?” र्‌वार्‌वा लोप्पो।<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />येसुई ख्युकाङ्मोः र्‌वाबो, “चोँ तेर्माः ङन ङ्याबोई रोता सुप्नानजै ङाः जुङ्फान्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन ४१:९</ref></char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />पबित्रसास्त्रग सर्पा लैम सिमिन ङोह्जो ता वैई त्वानान। जेङ्नै धिक्‌कार मन सिमी, सुई सिमिन ङोह्जोः जुङ्फान्नान ङ्याह्। नु ता बरु मकेह्पा जेङ्न लः राह्‌नान ङ्याह्!” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />जुङ्फान्नान यहूदाई र्‌वार्‌वा र्‌वाबो, “गुरुज्यू, तै अन ङा जेङ्पाऊ?” येसुई झब बिम्बो, “अन ता नह् र्‌वाङ।”<verse eid="MAT 26:25" /></para>
  <para style="s">प्रभु भोज</para>
  <para style="r">(<ref loc="MRK 14:22-26">मर्क १४:२२-२६</ref>; <ref loc="LUK 22:14-20">लुक २२:१४-२०</ref>; <ref loc="1CO 11:23-25">१ कोर ११:२३-२५</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />झपाई छ्युङ्पान भेला येसुई रोता वव्वै परमेस्वरन ङ्याबो असिका बिमबिम क्युप्पो आलै चेलाकाङ्मोः परेईपरेई र्‌वाबो, “अन वव्वै झा, अन ङन ल्हो जेङ्पा।” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />मन्न छाम्म नुई खोरे यङ वप्पो आलै परमेस्वरग मया रह्पा र्‌वार्‌वा चेलाकाङ्मोः भिनैभिनै र्‌वाबो, “अनलम ङेन पुरूजै थुवा। <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />अन रेनरुपा सार्बा थुप्नान्न ङन कह जेङ्पा, कन सिमि लैःन तीपा फ्याःचेन भिह्तु पन्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="DEU 24:8">कानुन २४:८</ref>; <ref loc="JER 31:31-34">यर ३१:३१-३४</ref></char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />ङा ङेनकाङ्मोः र्‌वाचे, “ङन पान राज्यग ङेन ङ्याबो अङ्‌गुरन खु सार्बा मथुङ्न बेर ङा ह्‌याङ अन अङ्‌गुरन खु थुङ्नान मीह्।” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />आलै धेनदी धेमी येसु चेलावन ङ्याबो जैतून धुरक्याँ होई।<verse eid="MAT 26:30" /></para>
  <para style="s">पत्रुसन अस्वीकारन भारेः येसुन भबिस्यबानी</para>
  <para style="r">(<ref loc="MRK 14:27-31">मर्क १४:२७-३१</ref>; <ref loc="LUK 22:31-34">लुक २२:३१-३४</ref>; <ref loc="JHN 13:36-38">यूह १३:३६-३८</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />मन्न भेला येसुई चेलाकाङ्मोः र्‌वाबो, “त्या छान्जे ङेन पुरू ङाः ख्योवाख्योवा ज्यार्नान ङ्याह्। तैङर्‌वाङिन पबित्रसास्त्रग झाम सर्पा ङ्याह्, परमेस्वरजै ग्वाल्याः सन्नान ङ्युँ रे मोह्ङन लूपाव तितरबितर राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">जक १३:७</ref></char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />जेङ्नै सिह्पालै सम्पु ग्युर्मी ङा ङेन खेरे ङू गालील छेत्रग वैनान ङ्युँ।”<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती २८:१६</ref></char></note><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />पत्रुसजै येसू र्‌वाबो, “पुरूजै ख्योवाख्योवा ज्यार्नै ङा नाः हातौयै ख्योवानान मीह्।”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />येसुई र्‌वाबो, “तेम्माई ङा नाः र्‌वाचे, नाप्चे नाह्पा काःपा तर्चेन खेरे ङूई ङाः स्योई मस्योःनान र्‌वार्‌वा नाई सुमरेप थाल अस्वीकार खेनान ङ्याह्।”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />पत्रुसजै झब बिम्बो, “नान ङ्याबो सित्वानै ङा नाः मस्योःनान र्‌वार्‌वा हातौयै र्‌वानान मीह्!” घङ चेला पुरूवजै र्‌वार्‌वा उजुई र्‌वाबो।<verse eid="MAT 26:35" /></para>
  <para style="s">गेतसमनी क्वाग येसुन सोअताप</para>
  <para style="r">(<ref loc="MRK 14:32-42">मर्क १४:३२-४२</ref>; <ref loc="LUK 22:29-46">लुक २२:२९-४६</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />मन्न छाम्म येसु जेँन चेलावन ङ्याबो गेतसमनी र्‌वानान्न क्वाग होई। स्याह् ताप्‌ताप्‌ नुई चेलाकाङ्मोः र्‌वाबो, “ङेन स्यीह् छ्योवा कोई, ङा ङाई धेरा वैवै सोअताप्चे।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />जेङ्नै पत्रुस रे जब्दियान ङोह्जो ङेह्ग चन नुई जेँन ङ्याबोई वप्पो आलै येसू मिह्दा तूरि रे पिरग थेप्पो। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />नुई चेलाकाङ्मोः र्‌वाबो, “ङन परान यामयाम छराई सिह्पालैम रह्पा ङ्याह्। ङेन चन सापसाप स्यीह् ङन ङ्याबो छ्योवा।” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />नु चन ङाई धेरा वैवै साः खल्बू क्यापक्याप झाःम र्‌वाईर्‌वाई सोअताप्मः जाःबो, “हे ङन पा, रा तैङिन अन तूरिन खोरे ङन स्यीह्‌लै ग्याङ्म होरा। जेङ्नै ङन इच्छ्या ता नङ्‌पा, नानै इच्छ्या पुरा राःयो।” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />येसु च्याङच्याङ जेँन चेलावन स्याह् होलहोल स्वातौ ख्यु आःपाई छ्युङ्पा धोबो। येसुई पत्रुसग र्‌वाबो, “तै ङेन घन्तादी यङ ङन भिह्तु साप्पागै छ्युङ् मतैनौ?” <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />ङेन “स्वानान्न छोए सेन्नान्न भेला तीपाः फसि मराह्‌मता” र्‌वार्‌वा साप्पागै छ्युङछ्युङ सोअताबा। “तेम्माई आत्मा चन तयार ङ्याह्, जेङ्नै ल्हो चन कमजोर ङ्याह्।”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />ह्‌याङ वैवै येसुई ङेरेप झाःम र्‌वार्‌वा सोअताप्पो, “हे ङन पा, अन तूरिन खोरे ङै मथुङ्‌खाईमे जेङ्न, नानै इच्छ्या पुरा राःयो।” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />आलै ह्‌याङ चेलावन स्याह् होलहोल स्वातौ ख्यु ह्‌याङ यङ आःपाई छ्युङ्पा धोबो। ख्युई मी पोङै मतैबो।<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />आलै येसुई ख्युकाङ्मोः अझामगै ख्योवाख्योवा होई सुमरेप ह्‌याङ ङून लैम सोअताप्पो। <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />मन्न छाम्म नु चेलावन स्याह् होलहोल स्वास्वा र्‌वाबो, “तै ङेन हेँ आःआः नाह्‌ःनान? ङ्याना, ङा सिमिन ङोह्जो पापी सिमिन लाह्ग थोन्नान्न भेला रातह्बो। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />ता च्याँ, वैमता! सेह्‌ना, ङाः जुङ्फान्नान सिमि यङ स्वा ताप्पा ङ्याह्।”<verse eid="MAT 26:46" /></para>
  <para style="s">येसू जुङ्पा</para>
  <para style="r">(<ref loc="MRK 14:43-50">मर्क १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लुक २२:४७-५३</ref>; <ref loc="JHN 18:3-12">यूह १८:३-१२</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />येसुई अन ल्होई र्‌वातौ च्योङेपान बर्ग यहूदा र्‌वानान चेलादी चन स्वा ताप्पो। यहूदान ङ्याबो पेर्गा रे तरवाली वप्पा सिमिवन मोङ किम ङ्याह्। ख्युकाङ्मोः ङोत्वा पुजारी रे घङ अगुवावजै फेप्पा ङ्याह्। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />जुङ्फान्नान यहूदाई मन सिमिकाङ्मोः ताह्दी बिम्पा ङ्याह्, “सू ङा मोई खेनान” नुई येसु जेङ्पा, नू झ्वाँ र्‌वापा ङ्याह्। <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />ता यहूदाई थारेः येसुन स्याह् वैवै “स्हिम ङिह्पौ गुरु” र्‌वार्‌वा मोई खेबो।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />येसुई र्‌वाबो, “ए ङन ग्याप्पा! तै खेमः स्वापा जेङ्पा, अन ख्या।” तब ख्युई येसू जुङ्बो। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />अन रङरङ येसुन ङ्याबो ङिह्पान फुरीदीजै जेँन तरवाली छ्यूबो रे फ्याङफ्याङ प्रधान पुजारीन राङ्पान नाम्ज्योवा थुम्बो। <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />जेङ्नै येसुई नू र्‌वाबो, “नान तरवाली स्योह्पग नाह्‌ना। तरवाली कुल्नानव तरवालीजै सन्नान ङ्याह्। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />ङै तोल्पा जेङ्न ङन पाई ङाः तुरुन्त पल्तन च्योङेपा खेरेई लै स्वर्गदुतव फेङ्‌ङ। तै ना अन रा मतैमतौ र्‌वार्‌वा छुनौ? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />जेङ्नै यदि ङै तोल्ङिन ता पबित्रसास्त्रग झाःम रात्वानान र्‌वार्‌वा सर्पान ल्होई कुजुई पुरा राह्‌नान?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />मन्न छाम्म येसुई जेँग जुङ्मः स्वापा सिमिकाङ्मोः र्‌वाबो, “तै ङा च्याःपा जेङ्पौ तै ङेन पेर्गा रे तरवाली वव्वै ङाः जुङ्मः स्वापौ? ङै बात्तै आराधनालयग छ्युङछ्युङ लन्तौ ता च्या ङाः जुङ्चेन हिम्मतै मखेबो!<note caller="-" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लुक १९:४७</ref>; <ref loc="LUK 21:37">२१:३७</ref></char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />जेङ्नै भबिस्यबक्तावजै पबित्रसास्त्रग सर्पान ल्होई पुरा राःयो र्‌वाईर्‌वाई अन पुरू रामः स्वापा जेङ्पा।” मन्नै भेला चेलाव भरि पुरू येसू ख्योवाख्योवा ज्यार्बो।<verse eid="MAT 26:56" /></para>
  <para style="s">यहूदी जोम्पुन ङू येसु</para>
  <para style="r">(<ref loc="MRK 14:53-65">मर्क १४:५३-६५</ref>; <ref loc="LUK 22:54-55">लुक २२:५४-५५</ref>; <ref loc="JHN 18:13-14">यूह १८:१३-१४</ref>; <ref loc="JHN 18:19-24">१८:१९-२४</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />ख्युई येसू प्रधान पुजारी कैयाफान यिम वप्पो। स्याह् कानुन लन्नान्न सिमि रे घङ अगुवाव जोम्पा ङ्याह्। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />पत्रुस चन येसू ग्याङ्मलै ङिक जाईजाई प्रधान पुजारीन यिमन ख्यामग ताप्पो। आलै स्याह् तै राह्‌नान जेम र्‌वार्‌वा सेह्‌म्म नु वैवै पालेवन ङ्याबो छ्युङ्बो। <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />ङोत्वा पुजारी रे यहूदी जोम्पुन घङ जोम्पा सिमि पुरूवजै येसू सन्नान्न धल भिन त्वानान र्‌वार्‌वा लबारन साँचि फाम्मः जाःबो। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />लै लबार साँचि बिन्नानव स्वास्वा नू दोस बिम्बो, जेङ्नै प्रमानदी यङ मदेप्पो। ङिक सिमि ङेह्पाई ङू वैवै र्‌वाबो, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />“अन सिमिजै ता ‘ङा परमेस्वरन आराधनालय फ्वाफ्वा सुमङीगै ह्‌याङ दोङ् तैनान’ र्‌वाङ।”<note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">यूह २:१९</ref></char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />आलै प्रधान पुजारीजै च्याङच्याङ येसू लोप्पो, “ए, तैङ झब मबिन्नान? नान बिरोधग अजोवजै बिम्पान साँचिन भारेः नाः तये र्‌वाकोए मीपाऊ?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />जेङ्नै येसु तै मर्‌वारे छ्युङ्बो। ह्‌याङ प्रधान पुजारीजै र्‌वाबो, “सम्पु परमेस्वरन मिह्‌नग रेनरुरु र्‌वा, तै ना परमेस्वरन ङोह्जो मसिह जेङ्पौ?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />येसुई झब बिमबिम र्‌वाबो, “मन नँह् र्‌वाङ, आलै ङा ङेनकाङ्मोः र्‌वाचे, तान धेरा ङेनजै सिमिन ङोह्जोः सर्बसक्तिमान परमेस्वरन याईपाक्याँ सिङ्‌हासनग छ्युङ्पा रे स्वर्गलै नमलूग स्वायङ खेपा रङ्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दान ७:१३</ref></char></note> <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />अन ताह्ताह् ङोत्वा पुजारीजै वाक्‌क राह्‌राह्‌ जेँन घोलाङ छ्योनैछ्योनै र्‌वाबो, “दे सेह्‌ना, अनजै परमेस्वरन ल्हुई झपा ङेनजै ताह्बो, ता ङी घङ तै पर्मान त्वाबो?<note caller="-" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी २४:१६</ref></char></note> <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />दे र्‌वा, ङेन तै छोए खेनान?” “अन अपराधी जेङ्पा, अनजै सन्नान्न धल देत्‌त्वानान,” र्‌वाईर्‌वाई <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />ख्युई येसुन ङुरग छिमा पप्पो, मुक्‌का फ्याङ्बो आलै हातिपाई नू ताप्पर फ्याङफ्याङ र्‌वाबो,<note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">यसै ५०:६</ref></char></note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“हे मसिह, यदि ना भबिस्यबक्ता जेङ्न ङी भबिस्यबानी, नाः सुई फ्याङ्बो?”<verse eid="MAT 26:68" /></para>
  <para style="s">पत्रुसजै येसू अस्वीकार खेपा</para>
  <para style="r">(<ref loc="MRK 14:66-72">मर्क १४:६६-७२</ref>; <ref loc="LUK 22:56-62">लुक २२:५६-६२</ref>; <ref loc="JHN 18:15-18">यूह १८:१५-१८</ref>; <ref loc="JHN 18:25-27">१८:२५-२७</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />मन्न भेला बेर पत्रुस खोलोः ख्यामगै छ्युङ्पा ङ्याह्। राङ्मादी स्वास्वा नू र्‌वाबो, “ना रे गालील प्रदेसग छ्युङ्नान्न येसुन ङ्याबोई ङ्याह् न, नङ्पा तै?” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />जेङ्नै पत्रुसजै पुरून ङू, “नङ्पा, नाई तै र्‌वानान ङाः क्युई मीपा!” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />र्‌वार्‌वा ख्यामन झलाक्याँ होई। झलान रह्‌म्म घङ राङ्मादीजै स्याह् ङिह्पान सिमिकाङ्मोः र्‌वाबो, “अन सिमि यङ नासरतन येसुन ङ्याबोई ङ्याह्!” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />ह्‌याङ पत्रुसजै रेनरुरु अस्वीकार खेखे झाःम र्‌वाबो, “ङा ता मन सिमी स्योई मस्योःनान!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />ङाईदिलै स्याह्‌न सिमिवजै पत्रुसन रह्‌म्म स्वास्वा र्‌वाबो, “तेम्माई ना रे नुन ङ्याबोई ङ्याह्, नान ल्होईजै र्‌वार्‌वा अन ल्होई क्युई राँ!” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />आलै ह्‌याङ पत्रुसजै रेनरुरु र्‌वाबो, “ङै लबार र्‌वापा जेङ्न परमेस्वरन धल ङन ङ्याःई स्वाःयो, ङा ता मन सिमी स्योई मस्योःनान!” उजु र्‌वालुङ्मीम काःपा तर्बो <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />रे “काःपा तर्चेन खेरे ङू ङाः सुमरेपथाल स्योई मस्योःनान र्‌वार्‌वा अस्वीकार खेनान ङ्याह्,” र्‌वार्‌वा येसुई र्‌वापान ल्होई पत्रुसजै नावा खेबो। नु खोलोः वैवै धुरुधुरु दाःबो।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">येसू पिलातसन स्याह् वप्पा</para>
  <para style="r">(<ref loc="MRK 15:1">मर्क १५:१</ref>; <ref loc="LUK 23:1-2">लुक २३:१-२</ref>; <ref loc="JHN 18:28-32">यूह १८:२८-३२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />नाह्पपर्म ङोत्वा पुजारी रे घङ अगुवावजै येसू सच्‌चे र्‌वार्‌वा सल्‌ला खेबो। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />आलै ख्युई नू साँगलजै खीखी रोमी हाकिम-किम पिलातसन स्याह् वव्वै थोप्पो।<verse eid="MAT 27:2" /></para>
  <para style="s">यहूदा सिह्पा</para>
  <para style="r">(<ref loc="ACT 1:18-19">प्रे १:१८-१९</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />येसू सन्नान्न धल बिम्पान ल्होई ताह्ताह् जुङ्फान्नान यहूदाः घ्योप्पा रह्बो। नुई मन मुलन सिक्‌का च्युसुम वव्वै ङोत्वा पुजारी रे घङ अगुवावन स्याह् वैबो।<note caller="-" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">प्रे १:१८-१९</ref></char></note> <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />रे झाःम र्‌वाबो, “ङै अपराध खेपा, निर्दोस सिमी सच्‌चेन भिह्तु जुङ्फाप्पा।” ख्युई झब बिम्बो, “मन्न ङी तै मल्‌लब? अन ता नान ल्होई पो जेङ्पा।” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />अन ताह्ताह् येहूदाई मन सोह्ङ आराधनालयन झिङ पप्पो आलै स्याह्‌लै वैवै नु चुनचुन सिह्बो। <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />ङोत्वा पुजारीवजै चन मन सोह्ङ चाह्चाह् र्‌वाबो, “अन ता कहन सोह्ङ जेङ्पा, कानुन अन्सार अनग आराधनालयन भकाःसः नान्चे लः मराह्‌नान।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />अन्नकारन ख्युई प्रदेसिवन कुह्‌म लुह्‌म्मः कुमालेन खे र्‌वानान्न सा र्‌युह्‌नान्न सल्‌ला खेबो। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />अन्नैकारन त्यान बेरै मन साः “कहन सा” र्‌वानान्न लूह् ङ्याह्। <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />झामखेखे मन्तौ यर्मिया भबिस्यबक्ताजै र्‌वापान अन ल्होई पुरा रामः स्वापा जेङ्पा, “इस्राएलन सिमिवजै नुन भिह्तु तोकि खेपान मोल चन मुलन सिक्‌का सुमच्यु ङ्याह्। मन ख्युई वप्पो।<note caller="-" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">जक ११:१२-१३</ref></char></note> <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />आलै परमप्रभुई ङाः कोह्पा लैम खेखे ख्युई मन सोह्ङ कुमालेन खेःन भिह्तु बिम्बो।”<verse eid="MAT 27:10" /></para>
  <para style="s">पिलातसन ङू येसु</para>
  <para style="r">(<ref loc="MRK 15:2-15">मर्क १५:२-१५</ref>; <ref loc="LUK 23:3-5">लुक २३:३-५</ref>; <ref loc="JHN 18:29">यूह १८:२९</ref>; <ref loc="JHN 19:16">१९:१६</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />येसु रोमन हाकिम किम पिलातसन ङू थाङ्थाङ् छ्युङ्मी हाकिमजै नू लोप्पो, “तै ना यहूदीवन झली जेङ्पौ?” येसुई झब बिम्बो, “अन ता नँह्ः र्‌वाङ।” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />ङोत्वा पुजारी रे घङ अगुवावजै येसू लै दोस बिम्मः जाःबो। जेङ्नै हाति दोस बिन्नै नुई तये मर्‌वाबो। <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />अन्नकारन पिलातसजै नू र्‌वाबो, “ख्युई अकेह्‌न दोसव बिम्पा ना मताँयौ?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />जेङ्नै येसुई ल्होईदीनै झब मबिम्बो। अन रङरङ हाकिम-किम मिह्दा हालाईबो।<verse eid="MAT 27:14" /></para>
  <para style="s">येसू सच्‌चेन धल बिम्पा</para>
  <para style="r">(<ref loc="MRK 15:6-15">मर्क १५:६-१५</ref>; <ref loc="LUK 23:13-25">लुक २३:१३-२५</ref>; <ref loc="JHN 18:39">यूह १८:३९</ref>; <ref loc="JHN 19:16">१९:१६</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />निस्तार तेवरन भेलाः रोमन हाकिम-किमै सिमिवजै दम्पा तीपा कैदी फेच्‌चेन ल्हू ङ्याह्। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />मन्न भेला बारब्बा मिह्‌न्न मिह्‌नकै रह्पान सिमिदी झ्यालखानाः ङ्याह्। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />आलै पिलातसजै जोम्पा सिमिकाङ्मोः लोप्पो, “दे र्‌वा, ङा सू फेच्‌चे? बारब्बाः कि मसिह र्‌वानान्न येसू?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />तैङर्‌वाङिन यहूदी आङ खेनान्न सिमिवजै येसू थादोवा खेखे थोप्मः सप्पा जेङ्पा र्‌वानान्न ल्होई हाकिम-किम पिलातसग क्युई रह्बो।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />पिलातस न्याय आसनग छ्युङ्पा ङ्याह्। मन्नै भेला नुन मिसाई नू झाःम र्‌वार्‌वा ल्हो‌न कोर्बो, “मन धर्मी सिमी तये नख्याःयो तैङर्‌वाङिन त्या छान ङै नुन भारेः मङ रङरङ तूरि लैः देप्पा ङिह्पा।” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />जेङ्नै ङोत्वा पुजारी रे घङ अगुवावजै चन सिमिवन मोह्ङ्‌ग उक्स्याई खेखे झाम र्‌वामः जाःबो, “येसू सह्‌रा, बारब्बाः चन फेरा।” <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />रोमन हाकिम-किम पिलातसजै मोङग ह्‌याङ लोप्पो, “तेम्माई र्‌वा, सू फेच्‌चे?” ख्युई “बारब्बागै फेरा,” र्‌वार्‌वा फाईरा खेबो। <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />आलै पिलातसजै ख्युकाङ्मोः ह्‌याङ लोप्पो, “आन मसिह र्‌वानान्न येसू चन ङा तै खेचे?” ख्यु पुरूजै फाईरा खेखे र्‌वाबो, “नू क्रुसग चुना।” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />पिलातसजै लोप्पो, “अनजै तै अपराध खेपा ङ्याह्?” जेङ्नै ख्युई हेँ फाईरा खेखे र्‌वाबो, “नू क्रुसग चुनाःयो!” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />पिलातसग ता तै खेखेई मराह्‌नान लैम रह्बो। ता ता फाईराकुईरा रह्दरा र्‌वानान छुछु नुई पुरून ङू लाह् थुईथुई र्‌वाबो, “सेह्‌ना, अन सिमी सह्प्पान दोस ङाः नङ्पा, जेङ्नै ङेनकाङ्मोः ताह्ःयो।”<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">कानुन २१:६-९</ref></char></note> <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />“लौ लौ, येसू सह्प्पान दोस ङि रे ङिनै ङोह्जो-चमेःन ङ्याःई थेबाःयो!” ख्युई फाईरा खेईखेई र्‌वाबो। <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />तब पिलातसजै बारब्बाः फेप्पो। येसू चन नुई चेरन ताल्च्या फ्याङफ्याङ क्रुसग चुम्मः सिपाहीकाङ्मोः जिम्मा बिम्बो।<verse eid="MAT 27:26" /></para>
  <para style="s">सिपाहीवजै येसू खिसि खेपा</para>
  <para style="r">(<ref loc="MRK 15:16-20">मर्क १५:१६-२०</ref>; <ref loc="JHN 19:2-3">यूह १९:२-३</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />मन्न छाम्म पिलातसन सिपाहीवजै येसू दरबारन झिङ वप्पो आलै घङ पुरू सिपाहीकाङ्मोः रूबो। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />ख्युई येसुन घोलाङ छ्यूछ्यू नू झलीन लैम घोलाङ ल्हो‌ःम थम्बो। <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />चेरन मुकुत दोङ्दोङ् नुन थोप्पाः थम्बो रे नुन लाह् याईपाः मि वप फानफान नुन ङू कुकु खिसि खेईखेई र्‌वाबो, “यहूदीवन झलीन छ र्‌याङ्म राःयो!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />मन्न छाम्म सिपाहीवजै नू छिमा पप्पो आलै मि तलतल नुनै थोप्पाः फ्याङ्बो। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />ख्युई नू झामखेखे खिसि खेतामी घोलाङ ल्होःम छ्यूछ्यू नुन जेँनै घोलाङ थम्बो। मन्न छाम्म ख्युई नू क्रुसग चुम्मः जाःबो।<verse eid="MAT 27:31" /></para>
  <para style="s">येसु क्रुसग चुम्पा</para>
  <para style="r">(<ref loc="MRK 15:21-32">मर्क १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लुक २३:२६-४३</ref>; <ref loc="JHN 19:17-27">यूह १९:१७-२७</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />लमग वैतौवैतौ ख्युई सिमोन मिह्‌न्न कुरेनी सहरन सिमिदीग धोबो। ख्युई नू हलजफत येसुन क्रुस हुर फाम्बो <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />आलै ख्यु गलगथा र्‌वानान्न ठाउँग स्वा ताप्पो। गलगथा र्‌वापा चन “कपलि रह्पु” जेङ्पा। <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />स्याह् ताप्‌ताप्‌ ख्युई येसू मान खाःपा कह्पान खु थुङ्फाम्बो। चाकि खेमी नुई थुङ्चे मङ्याम्बो।<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजन ६९:२१</ref></char></note><verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />मन्न छाम्म ख्युई येसू क्रुसग किला थिङ्थिङ चुम्बो। नुन घोलाङ चन ख्युई राह्‌ङराङ्साः चित्ता फ्याङफ्याङ परेःबो।<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजन २२:१८</ref></char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />तब स्याह् छ्युङछ्युङ ख्यु नू सेन्चे खेमः जाःबो। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />नुन थोप्पान ङ्या ख्युई “अन येसु यहूदीवन झली जेङ्पा,” र्‌वार्‌वा दोसन हिगा सर्पा च्यार्बो। <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />येसू चुन्तौ ख्युई ङेह् च्याःपाकाङ्मोः र्‌वार्‌वा नुन याईपा रे योम्मक्याँ क्रुसग चुम्बो।<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />मन लम राह्‌राह्‌ वैनान भरि सिमि पुरूवजै होला कुलैकुलै येसू खिसि खेईखेई र्‌वाबो,<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">भजन २२:७</ref>; <ref loc="PSA 109:25">१०९:२५</ref></char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“आराधनालय फ्वाफ्वा ह्‌याङ सुमङीगै दोङ्तैनान्न सिमि ना नङ्पाऊ? यदि परमेस्वरनै ङोह्जो जेङ्न दे ता जेँगै बचाई खेखे क्रुसलै धुलधुल स्वा!”<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ती २६:६१</ref>; <ref loc="JHN 2:19">यूह २:१९</ref></char></note> <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />उजुई खेखे ङोत्वा पुजारी, कानुन लन्नान्न सिमि रे घङ अगुवावजै र्‌वार्‌वा येसू खिसि खेबो। <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />ख्युई र्‌वाबो, “नुई घङग ता सोम फाम्बो, जेङ्नै सेह्‌ना, जेँगै चन बचाई मतैबो। यदि अन इस्राएलीवजै झली जेङ्न क्रुसलै धुलधुल स्वाःयो आन पो ङि बिस्वास खेच्योवा! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />अनजै परमेस्वरग बिस्वास खेँ रे ‘ङा ता परमेस्वरन ङोह्जो जेङ्पा’ र्‌वार्‌वा ल्हेङ्‌ङ। परमेस्वर अन्न ङ्याबो स्याङ्पा ङिङिन ता नुई र्‌वार्‌वा अनग बचाई ख्याःयो।”<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">भजन २२:८</ref></char></note> <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />उजुई खेखे नुनै ङ्याबो चुम्पान मन च्यापावजै र्‌वार्‌वा येसुन खिसि खेबो।<verse eid="MAT 27:44" /></para>
  <para style="s">येसु सिह्पा</para>
  <para style="r">(<ref loc="MRK 15:33-41">मर्क १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लुक २३:४४-४९</ref>; <ref loc="JHN 19:28-30">यूह १९:२८-३०</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />ङिजे बार बजेलै तिन बजे थाल देसभरी नाःतुमा रह्बो। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />तीन बजेराः येसुई केह्ः किम छ्यूछ्यू र्‌वाबो, “ईलोई-ईलोई लामा सबखथनी?” अन्न अर्थ जेङ्पा, “हे ङन परमेस्वर, हे ङन परमेस्वर, ङाः तैङ ख्योवापा?”<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">भजन २२:१</ref></char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />येसु झामखेखे फाईरा खेपा ताह्ताह् स्याह् थाङ्थाङ् छ्युङ्पावन बर्ग कान कानजै र्‌वाबो, “अन सिमिजै ता एलियाग कताँ!” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />तीपा चन धालैधालै वैवै खु खाःपाः कपास सुपसुप सप्पो रे मन झुम्रो मिन नाः कानकान येसू थुङ्फाम्बो।<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजन ६९:२१</ref></char></note> <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />जेङ्नै घङवजै र्‌वाबो, “कुवा, कुवा, कार्तौ एलिया स्वास्वा अनग बचाई खेङिम कि, सेह्‌म्मता!” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />आलै मन्नै भेला येसुई ह्‌याङ तीरेप केह्ः किमै फाईरा खेखे जेँन परान पप्पो। <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />तब सेह्‌ना, मन्नै भेलाः आराधनालयन झिङ च्यार्पान पर्दा ङयाःलै पोँथालै काला ङेह् राह्‌राह्‌ छ्योम्बो। साँगुल होई, सेन्चे लुङव दिल्बो,<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">प्रस २६:३१-३३</ref></char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />तुह्‌र्साव पोङ्बो रे सितपान परमेस्वरन लै पबित्र सिमिवन सिह्पान ल्हो सम्पु ग्युर्बो। <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />येसु सिह्पालै सम्पु ग्युर्मी ख्यु जेँ-जेँन तुह्‌र्सालै गेग्गे पबित्र सहरग जाःबो रे लै सिमिवन स्याह् रङ्बो। <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />साँगुल वैपा रे स्याह् रह्पा तैस्याङ पुरू रङरङ येसू कुकु छ्युङ्पा सिपाहीव रे ख्युन अफिसर मिह्दा ङिह्‌म्बो। आलै ख्युई र्‌वाबो, “तेम्माई नु ता परमेस्वरनै ङोह्जो जेअँ।”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />लैः चिमिचाव रे ग्याङ्मलै च्याङ्च्याङ सेम्पाई ङ्याह्। ख्युई येसू गालीललै ङिक जाईजाई रे सेवा खेईखेई स्वापा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">27:55 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">लुक ८:२-३</ref></char></note> <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />ख्युन बर्ग मरियम मग्दलिनी, याकूब रे योसेफन मा मरियम आलै जब्दियान ङोह्जो ङेह्‌न मा ङ्याह्।<verse eid="MAT 27:56" /></para>
  <para style="s">येसू लुम्पा</para>
  <para style="r">(<ref loc="MRK 15:42-47">मर्क १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लुक २३:५०-५६</ref>; <ref loc="JHN 19:38-42">यूह १९:३८-४२</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />ङ्याजे योसेफ मिह्‌न्न तीपा अरिमाथिया सहरन रेम्पा सिमि स्वाबो। नु रे येसुनै चेला रह्पा ङ्याह्। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ता नुई पिलातसन स्याह् वैवै येसुन कुह्‌म तोल्बो। पिलातसजै र्‌वार्‌वा नुन सिह्पान ल्हो वन्नान्न अनुमति बिम्बो। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />योसेफजै सिह्पान ल्हो वव्वै सुतीन घोलाङ खामसाङ्म सार्बादी च्योम्बो, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />रे मन सिह्पान ल्होग मात्र लुङ ख्वाख्वा जेँन भिह्तु दोङ्दोङ् नाम्पान तुह्‌र्सा सार्बाः नाह्‌म्बो आलै लुङ किमदी वव्वै तुह्‌र्सान ङुर थाथा नु स्याह्‌लै होई। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />मरियम मग्दलिनी रे घङ मरियम चन तुह्‌र्सान ङूई छ्युङ्बो।<verse eid="MAT 27:61" /></para>
  <para style="s">तुह्‌र्साः सिपाहीव</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />नाप्चे नाह्‌न लाह्ः ङोत्वा पुजारी रे फरिसीव दीदी पिलातसन स्याह् वैवै र्‌वाबो, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />“गुरु, ङी ह्‌याका खेपा ङिह्पा, मन ठगजै सम्पु रातौ ‘ङा सिसि सुमङीग ह्‌याङ सम्पु ग्युर्नान ङ्युँ’ र्‌वाईर्‌वाई ल्हेङ्‌ङ।<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्ती १६:२१</ref>; <ref loc="MAT 17:23">१७:२३</ref>; <ref loc="MAT 20:19">२०:१९</ref>; <ref loc="MRK 8:31">मर्क ८:३१</ref>; <ref loc="MRK 9:31">९:३१</ref>; <ref loc="MRK 10:33-34">१०:३३-३४</ref>; <ref loc="LUK 9:22">लुक ९:२२</ref>; <ref loc="LUK 18:31-33">१८:३१-३३</ref></char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />अन्नकारन सुमङी मवैन बेर मन तुह्‌र्सा लः खेखे सेन फाना। कार्तौ नुन चेलावजै स्वास्वा नुन कुह्‌म खुखु वव्वै ‘नु ता सिह्पालै सम्पु ग्युर्पा ङ्याह्’ र्‌वार्‌वा सिमिकाङ्मोः छकाई पच्‌चे नधेराःयो! तेमन्ता पहिलीन छल खेरै अन अलः राह्‌नान ङ्याह्।” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />उजु रातौ पिलातसजै ख्युकाङ्मोः र्‌वाबो, “सिपाहीकाङ्मोः वव्वै तैनबेर लः खेखे तुह्‌र्सान सेन्चे खे फाना।” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />आलै ख्युई वैवै तुह्‌र्सा सुरछित नाह्‌म्मः तुह्‌र्सान ङुर कप्नान्न लुङ्‌ग ताह्ः नाह्‌म्बो रे सिपाहीकाङ्मोः सेह्‌मफाम्बो।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">येसु सिह्पालै सम्पु ग्युर्पा</para>
  <para style="r">(<ref loc="MRK 16:1-11">मर्क १६:१-११</ref>; <ref loc="LUK 24:1-12">लुक २४:१-१२</ref>; <ref loc="JHN 20:1-18">यूह २०:१-१८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />नाह्‌न ल्हाःन ङूस्योवा आईतन लाह्ः नाह्प ङाई नम नाङ्पान भेला मरियम मग्दलिनी रे घङ मरियम येसू नाम्पान तुह्‌र्सा सेह्‌म्म होई। <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />मन्तौ तैमेग साँगुल किम होई तैङर्‌वाङिन स्वर्गलै प्रभु परमेस्वरन स्वर्गदुतदी स्वास्वा तुह्‌र्सान लुङ लाल्‌लोवा पप्पै मन्नै लाह्ः छ्युङ्बो। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />नुन ध्वा बिजुली लैम चम्किलो रे घोलाङ लिङ लैम पाह्ल्म ङ्याह्। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />पालेव चन ङिनराःछेछे दारदार साः घ्याबो रे सिह्पान सिमिलैम रह्पा। <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />जेङ्नै स्वर्गदुतजै मन चिमिचाकाङ्मोः र्‌वाबो, “नङिना, ङाः क्युई ङिह्पा, ङेन क्रुसग चुनचुन सप्पान येसू फाम्मः स्वापा जेङ्पा। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />जेङ्नै सेह्‌ना, येसु स्यीह् मह्‌या। जेँजै र्‌वापालैम नु ता सिह्पालै सम्पु ग्युर्पा ङ्याह्। स्वास्वा प्रभुन सिह्पान ल्हो नाम्पु सेह्‌ना! <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />मन्न छाम्म खम्म वैवै नुन चेलाकाङ्मोः ‘प्रभु ता सिह्पालै सम्पु ग्युर्पा ङ्याह्। नु ङेन खेरे ङूई गालीलग वैङ, स्याह् ङेनजै नू रङ्नान ङ्याह्’ र्‌वार्‌वा ताह्फेरा! ता वया, ङै र्‌वापान ल्होई ङेन ह्‌याका ख्या।”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />मन चिमिचाकाङ्मोः ङिह्‌म्बो यङ रे यामयाम स्याङ्बो यङ। आलै ख्यु तुरुन्तै तुह्‌र्सालै गेप्पो रे चेलाकाङ्मोः ताह्फेम्मः धाल्बो।<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />येसुई ख्युकाङ्मोः हरक्‌क दोदो र्‌वाबो, “ङेनकाङ्मोः सान्ति राःयो!” मन्नै भेला ख्युई खल्बू क्याप्‌क्याप नुन लेह् ध्वा खेबो। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />येसुई ख्युकाङ्मोः र्‌वाबो, “नङिना, ङेन वैवै ङन थिक्‌कोवकाङ्मोः गालीलग वया र्‌वार्‌वा र्‌वा। स्याह्ई ख्युई ङाः रङ्नान ङ्याह्।”<verse eid="MAT 28:10" /></para>
  <para style="s">सिपाहीवजै सप्पान ल्होन</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />मन चिमिचाव वैतामी तुह्‌र्साः सेन्चे खेनान कान सिपाहीव यङ सहरक्याँ होई रे तुह्‌र्साः रह्पान ल्होई पुरूव ङोत्वा पुजारीकाङ्मोः स्याप्पो। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />ङोत्वा पुजारीवजै घङ अगुवावन ङ्याबो दीदी सल्‌ला खेबो आलै ख्युई सिपाहीकाङ्मोः सोह्ङ लैः बिमबिम र्‌वाबो, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“ङेनजै झाःम र्‌वा कोई ‘छान्जे ङि आःपान भेला येसुन चेलावजै स्वास्वा नुन कुह्‌म खुखु वत्तँ।’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />रोमी हाकिम-किमै ताह्दँ र्‌वाङिन ङि नुन ङ्याबो ल्होई मिलाई खेच्योवा। ख्युई अन्न भारेः छरा तये खेमत्वानान।”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />मन सेन्चे खेनानवजै सोह्ङ वव्वै ङोत्वा पुजारीवजै लम्पा लैम र्‌वाबो। अन ल्होई चन यहूदीवन घूँ चोँन बेरै फेल्पाई ङ्याह्।<verse eid="MAT 28:15" /></para>
  <para style="s">मकेकुकेन किम आदेस</para>
  <para style="r">(<ref loc="MRK 16:14-18">मर्क १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लुक २४:३६-४९</ref>; <ref loc="JHN 20:19-23">यूह २०:१९-२३</ref>; <ref loc="ACT 1:6-8">प्रे १:६-८</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />चेला च्युदीपाव येसुई वया र्‌वापान गालीलन धुरग होई।<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्ती २६:३२</ref>; <ref loc="MRK 14:28">मर्क १४:२८</ref></char></note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />येसू रङ्लुङ्मीम ख्यु नुन ङू खल्बू क्याप्पो। जेङ्नै ख्युन बर्ग हाति चेलाः ता “येसुई जेम या नह्‌म” र्‌वानान्न सङ्‌का रह्बो। <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />तब येसु रह्‌म्म स्वास्वा ख्युकाङ्मोः र्‌वाबो, “सेह्‌ना, स्वर्ग रे पिर्थीबिन आङ पुरू ङाः बिम्पा ङिह्पा। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />ता ङेन वैवै पुरू सिमिकाङ्मोः ङन चेलाव धोँवा। ख्युकाङ्मोः पा, ङोह्जो रे पबित्र आत्मान मिह्‌नग बप्‌तिस्मा भिना।<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रे १:८</ref></char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />रे ङेनकाङ्मोः र्‌वापान तैस्याङ पुरू ङ्याना र्‌वार्‌वा ख्युकाङ्मोः लह्‌ना। आलै सेह्‌ना, ङा एकुरोभरि, सन्सारन अन्त्यन दिन्न बेर ङेनकोन ङ्याबोई लुईनान ङ्युँ।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>