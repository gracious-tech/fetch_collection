<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Kaike Standard Traslation</book>
  <para style="h">यूह</para>
  <para style="toc3">यूह</para>
  <para style="toc2">यूह</para>
  <para style="toc1">यूहन्नाई सर्पान ल्होन लः</para>
  <para style="mt2">यूहन्नाले लेखेको सुसमाचार</para>
  <para style="mt1">यूहन्नाई सर्पान ल्होन लः</para>
  <para style="imt">किताबन स्योःचे</para>
  <para style="ip">यूहन्नान अन्सार ल्होन् लःन स्योःचे यूहन्नान अन्सार ल्होन् लः सार्बा कानुन्न ली किताबवन बर्ग ती जेङ्पा। सुई येसु मसिहन जिन्दगी बर्नन खेँ। ख्युन बर्ग पुरूग “ल्होन् लः” र्‌वानान, कन्न अर्थ “ल्होन् लः” जेङ्पा। ख्यु मत्ती, मर्कूस, लुका रे यूहन्ना लम येसु सिमी सर्पा ङ्याह्। यूहन्नान अन्सार ल्होन् लः मसिह केह्पान क्वाईमाल्‌ला 90 परान ङिक प्रेरित यूहन्नाई सर्पा जेङ्पा। किताबजै यूहन्ना सर्नान्न सिमि जेङ्पा र्‌वार्‌वा मर्‌वानै सर्ताङ १ यूहन्ना, २ यूहन्ना रे ३ यूहन्नान अछेरवन ङ्याबो दीनान ङ्याह्। कान ताङ्बोन सर्नान सिमिवजै अन्न भेला युहन्नाः एफिसस सहरग नाम्पा ङ्याह्, अन्नकारन अन किताब एफिससग सर्पा जेम्तौ। यूहन्नाई रीह्पा खेखे अन किताबन उदेस्य र्‌वापान सिमिकाङ्मोः येसुई मसिह, सम्पु परमेस्वरन ङोह्जो जेङ्पा र्‌वानान्न बिस्वास खेमः सहयोग खेनान जेङ्पा र्‌वार्‌वा स्याङ्‌ङ २०:३१। अन बिस्वास खेखे ङ्योअजै नुन मिह्‌नग जुनि देत्तैनान। किताब यहूदी रे यहूदीन खोलोःन तोअनान सिमिवन भिह्तु सर्पा ङ्याह्। यूहन्नान ल्होन् लः घङ सुम ल्होन् लः खेरे लै राँसा ङ्याह्। नुई येसुई खेपान हालाईचेन धोनवग ध्यान बिम्बो रे नुन द्रिस्तान्तवन भारेः लै मसर्बो। येसुन बप्‌तिस्मा रे लोभ्याई खेनान लैम घङ लै घतनाव यङ ल्होन् लःग सर्पा मह्‌या।</para>
  <para style="iot">सङ्‌रचना:</para>
  <para style="io1">यूहन्नाई अध्याय <char style="ior"><ref loc="JHN 1:1-18">१:१-१८</ref></char> ग ल्होन् लः सुरु खेँ।</para>
  <para style="io1">अन्न ङिक यूहन्नाई येसुई खेपान लै हालाईचेन धोनव <char style="ior"><ref loc="JHN 1:19">१:१९</ref>; <ref loc="JHN 12:50">१२:५०</ref></char> न भारेः सर्ङ।</para>
  <para style="io1">आलै नुई येसुन जिन्दागी लै घतनाव बर्नन खेँ कन नुन सिपा रे सिपालै सम्पु ग्युर्पाः ताप्ङ <char style="ior"><ref loc="JHN 13:1">१३:१</ref>; <ref loc="JHN 20:31">२०:३१</ref> </char></para>
  <para style="io1">यूहन्नाई अध्याय २१ ग ल्होन् लःन अन्त्य खेँ जब येसु सिह्पावलै सम्पु ग्युर्मी सिमिवन ङू रङ्बो। रे अन्न ङिक किताब सर्चेन उदेस्य स्याप्पो।</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">बचन ल्हो रह्पा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />तैस्याङ पुरू सृस्ति राचेन खेरे ङू बचन ङ्याह्, बचन परमेस्वरन ङ्याबो ङ्याह्, आलै बचन परमेस्वर ङ्याह्। <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />नु सुरुग परमेस्वरन ङ्याबो ङ्याह्। <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />तैस्याङ पुरू नुई दोङ्बो, रे दोङ्पान चिज तये यङ नु मीम मरह्पा। <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />नुग जुनि ङ्याह्, रे मन जिन्दगी सिमिवन ताह्‌म ङ्याह्। <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />मन ताह्‌म नाःतुमाः छ्यानान, रे नातुमाई नू हातौयै सप्पा मह्‌या।<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />परमेस्वरलम फेप्पान ल्हो‌न ताह्फेन्नान सिमिदी ङ्याह्, सुन मिह्‌न यूहन्ना ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">मत्ती ३:१</ref>; <ref loc="MRK 1:4">मर्क १:४</ref>; <ref loc="LUK 3:1-2">लुक ३:१-२</ref></char></note> <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />नु मन ज्योतिन साँचि बिन्चेन भिह्तु साँचि राह्‌राह्‌ स्वाबो, कि सिमि पुरूवजै नुनलम बिस्वास ख्यायो। <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />नुह्ँ मन ताह्ःम मह्‌या, जेङ्नै मन ज्योतिन साँचि बिम्म स्वाबो। <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />नु तेम्मा ताह्‌म ङ्याह्, मन ताह्‌म सन्सारग स्वामः जाःपा ङ्याह्। आलै नु सिमि पुरूवग चम्कि राह्‌नान। <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />नु सन्सारग ङ्याह्, सन्सारग नुई दोङ्बो, जेङ्नै सन्सारजै नू मस्योःबो। <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />नु जेँनै सिमिवन स्याह् स्वाबो, जेङ्नै नुन जेँन सिमिवजै नू स्वीकार मखेबो। <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />जेङ्नै हाति सिमिवजै नू स्वीकार खेबो रे नुन मिह्‌न्न लाह्ः बिस्वास खेबो, नुई ख्युकाङ्मोः परमेस्वरन सन्तान राचेन आङ बिम्बो। <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />ख्यु न कहलम, न ल्हो‌न इच्छ्यालम, न सिमिन इच्छ्यालम जेङ्नै परमेस्वरलम केह्पा राह्‌नान।<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />आलै बचन ल्हो रह्पा, रे दया रे तेम्माजै नाङ्नाङ ङिन घूँ छ्युङ्बो। ङ्योअजै नुन महिमा रङ्पा, कन महिमा पा लम स्वापा ङोह्जो तीबाःदिन लैम ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="1JN 4:9">१ यूह ४:९</ref></char></note> <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />यूहन्नाई नुन बिसयग साँचि भिनैभिनै केह्ः किमै र्‌वाबो, नु मनै सिमि जेङ्पा, “सुन भारेः ङै र्‌वापा, ‘ङन ङिक स्वानान ङनखेरे किम ङिह्पा, तैङर्‌वाङिन नु ङा केह्चेन खेरे ङूलै यङ ङ्याह्’।” <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />नुन हाति र्‌वार्‌वा दयालम ङ्योअजै ती दयान लाह्ः घङ दया देप्पा ङिह्पा। <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />तैङर्‌वाङिन कानुन मोसालम बिम्बो, दया रे तेम्मा चन येसु मसिहलम स्वाबो। <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />परमेस्वरग सुई हातौयै रङ्पा मह्‌या। पान ङ्याबो ङिह्पान तीबाःदि ङोह्जो ङ्याह् सु पान पछेग ङिह्पा परमेस्वरजै नू थम्पा ङ्याह्।<verse eid="JHN 1:18" /></para>
  <para style="s">बप्‌तिस्मा-बिन्नान यूहन्नान ल्हो‌न</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती ३:१-१२</ref>; <ref loc="MRK 1:1-8">मर्क १:१-८</ref>; <ref loc="LUK 3:1-18">लुक ३:१-१८</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />जब यरूसलेम सहरलै यहूदीवजै अगुवावजै पुजारीव रे लेवीकाङ्मोः यूहन्नान स्याह्‌ “ना सु जेङ्पा?” र्‌वानान्न ल्होई लोम्म फेप्पो। तब यूहन्नान साँचि अन ङ्याह्। <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />तब यूहन्नाई झब बिम्म अस्वीकार मखेबो, आलै मङी खेखे र्‌वाबो “ङा मसिह नङ्पा।” <verse eid="JHN 1:20" /><verse number="21" style="v" sid="JHN 1:21" />तब ख्युई नू लोप्पो, “आलै तै? ना एलिया जेङ्पौ?” नुई र्‌वाबो “ङा नङ्पा।” “तै ना मन भबिस्यबक्ता जेङ्पौ?” नुई झब बिम्बो, “नङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">कानुन १८:१५-१८</ref>; <ref loc="MAL 4:5">मला ४:५</ref></char></note> <verse eid="JHN 1:21" /><verse number="22" style="v" sid="JHN 1:22" />ख्युई युहन्नाः र्‌वाबो, “ना सु जेङ्पा? ङ्योअग र्‌वा, ताकि ङ्योअग फेन्नानकाङ्मोः ङ्योअ झब बिन तैमता। ना जेँन भारेः तै र्‌वानान?” <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />यूहन्नाई झब बिम्बो, “यसैया भबिस्यबक्ताजै र्‌वापालैम, ‘परमप्रभुन लम थार्का धोवाँ’ र्‌वार्‌वा तये मीपान ठाउँ फाईरा खेनान सिमिदीन ङा केह्ः जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यसै ४०:३</ref></char></note> <verse eid="JHN 1:23" /><verse number="24" style="v" sid="JHN 1:24" />ख्युकाङ्मोः फरिसीवजै फेप्पा ङ्याह्। <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />आलै ख्युई नू लोप्पो “ना मसिह यङ नङ्पा, एलिया यङ नङ्पा, मन भबिस्यबक्ता यङ नङ्पा र्‌वाङिन, तैङ बप्‌तिस्मा बिन्नान?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />यूहन्नाई ख्युकाङ्मोः झब बिम्बो, “ङा ता त्युई बप्‌तिस्मा बिन्नान, जेङ्नै ङेनकोन घूँ तीपा च्याङ्पा ङिह्पा, सू ङेनकाङ्मोः मस्योँ। <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />ङन ङिक स्वानान नुई जेङ्पा। सुन पौलान तना फोल्चे सम स्योरस्योर लैम ङा मीपा।” <verse eid="JHN 1:27" /><verse number="28" style="v" sid="JHN 1:28" />अन ल्होई यर्दन चाङ्पुन धिक्याँ बेथानियाग रह्पा ङ्याह्, खाः यूहन्नाई बप्‌तिस्मा बिम्पाई ङ्याह्।<verse eid="JHN 1:28" /></para>
  <para style="s">परमेस्वरन थुमा</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />नाप्चे यूहन्नाई येसु जेँनक्याँ स्वायङ खेपा रङरङ र्‌वाबो, “सेह्‌ना, सन्सारन तीपा सोलसोल वन्नान परमेस्वरन थुमा!<note caller="-" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="1PE 1:19">१ पत्र १:१९</ref>; <ref loc="ISA 53:7">यसै ५३:७</ref></char></note> <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />नु नुई जेङ्पा, सुन भारेः ङै र्‌वापा, ‘ङन ङिक सिमिदी स्वानान, सु ङनखेरे किम ङ्याह्, तैङर्‌वाङिन नु ङा केह्चेन खेरे ङूलै यङ ङ्याह्।’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />ङजै नू स्योङ, जेङ्नै नु इस्राएलग रँयो र्‌वार्‌वाई ङा त्युई बप्‌तिस्मा भिनैभिनै स्वापा।” <verse eid="JHN 1:31" /><verse number="32" style="v" sid="JHN 1:32" />यूहन्नाई झाःम र्‌वाईर्‌वाई साँचि बिम्बो, “ङै पबित्र आत्माग पुरेन्न रुपग पान्नाङलै धुलधुल स्वास्वा येसुन लाह्ः छ्युङ्पा रङ्पा। <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />ङै नू स्योपा मीपा, जेङ्नै सुई ङाः त्युई बप्‌तिस्मा भिना र्‌वार्‌वा फेप्पो, नुई र्‌वार्‌वा ङाः र्‌वाबो, ‘सुन लाह्ः ना पबित्र आत्मा लिबयङ रे छ्युङ्‌यङ खेपा रङ्नान, पबित्र आत्माई बप्‌तिस्मा बिन्नान नुई जेङ्पा।’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />ङै रङ्पा ङिह्पा, रे साँचि बिम्पा ङिह्पा, कि परमेस्वरन ङोह्जो नुई जेङ्पा।”<verse eid="JHN 1:34" /></para>
  <para style="s">येसुन ङूस्योवान चेलाव</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />ह्‌याङ घङ्न लाह् यूहन्ना नुन चेलावन बर्ग ङेह्पान ङ्याबो थाङथाङ छ्युङ्पा ङ्याह्। <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />नुई येसु वैपाई खेपा रङरङ र्‌वाबो, “सेह्‌ना, परमेस्वरन थुमा!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />यूहन्नाई र्‌वापान अन ल्होई ताह्ताह् मन चेला ङेह्पाव येसुन ङिक जाःबो। <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />येसुई होलहोल सेह्‌म्बो, रे ख्युकाङ्मोः ङिह्‌ङिह्‌ स्वायङ खेपा रङरङ ख्युकाङ्मोः लोप्पो, “ङेन तै फान्नान?” ख्युई नू र्‌वाबो, “रब्बी (कन्न अर्थ जेङ्पा, गुरुज्यू) ना खाः छ्युङ्नान?” <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />नुई ख्युकाङ्मोः र्‌वाबो, “स्वा, रे ङेनजै रङ्नान ङ्याह्।” ख्यु होई, रे नु छ्युङ्पान ठाउँ रङ्बो। ख्यु मन्न लाह् नुन ङ्याबो छ्युङ्बो, तैङर्‌वाङिन क्वाईमाल्‌ला: ङ्याजेन चार बजि रातपा ङ्याह्।<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />यूहन्नाई र्‌वापान ल्होई ङ्यान्नान रे येसुन ङिक जाःनान मन ङेह्पान बर्ग तीपा सिमोन पत्रुसन भाइ अन्द्रियास ङ्याह्। <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />नुई ङू जेँन भाइ सिमोनग धोबो, रे नू र्‌वाबो “ङ्योअजै मसीहग (कन्न अर्थ जेङ्पा, मसिह) दोपा ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">1:41 </char><char style="xt" closed="false"><ref loc="JHN 4:25">यूह ४:२५</ref></char></note> <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />नुई सिमोनग येसुन स्याह्‌ सप्पो। येसुई नू सेनसेन र्‌वाबो, “ना यूहन्नान ङोह्जो सिमोन जेङ्पा, ना केफास (कन्न अर्थ जेङ्पा, लुङ) र्‌वानान ङ्याह्।”<verse eid="JHN 1:42" /></para>
  <para style="s">फिलिप रे नथानेलग येसुई घ्वापा</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />नाप्चे येसुई गालील प्रदेसग वैचे पक्‌का खेबो। रे फिलिपग दोदो येसुई नू र्‌वाबो, “ङन ङिक जा।” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />अन्द्रियास रे पत्रुसलैम फिलिप यङ बेथसेदा सहरनै ङ्याह्। <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />फिलिपजै नथानेलग दोदो र्‌वाबो, “सुन भारेः मोसाई रे भबिस्यबक्तावजै र्‌वार्‌वा कानुनग सर्पा ङ्याह्, योसेफन ङोह्जो नासरतन येसु ङ्योअजै दोपा ङिह्पा।”<note caller="-" style="x"><char style="xo" closed="false">1:45 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती २१:११</ref></char></note> <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />नथानेलजै नू र्‌वाबो, “तै नासरतलै तयाः ल्होई लः स्वातैनान तै?” फिलिपजै नू झब बिम्बो, “स्वास्वा सेह्‌ना।” <verse eid="JHN 1:46" /><verse number="47" style="v" sid="JHN 1:47" />येसुई नथानेलग जेँन स्याह् स्वायङ खेपा रङरङ नुन भारेः र्‌वाबो, “तीपा तेम्मा इस्राएलीग सेह्‌ना, सू छल तेय मह्‌या।” <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />नथानेलजै लोप्पो, “नाई ङाः कुजुई स्योपा?” येसुई नू झब बिमबिम र्‌वाबो, “फिलिपजै नाः कताङ्चेन खेरे ङू, खोअन तङ्पुन पोँ ङै नाः रङ्पा।” <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />नथानेलजै नू र्‌वाबो, “रब्बी, ना परमेस्वरन ङोह्जो जेङ्पा, ना इस्राएलन झली जेङ्पा।” <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />येसुई नू झब बिमबिम र्‌वाबो, “ङै ना खोअन तङ्पुन पोँ रङ्पा र्‌वार्‌वा ना बिस्वास खेँ? नाई अन खेरे हेँ किम ल्होईव रङ्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">1:50 </char><char style="xt" closed="false"><ref loc="JHN 11:40">यूह ११:४०</ref></char></note> <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />आलै नुई नथानेलग र्‌वाबो, “तेम्माई, ङा नाः र्‌वाचे, ङेनजै स्वर्ग पोङ्पा रे परमेस्वरन दुतकाङ्मोः सिमिन ङोह्जोन लाह्ः लिबयङ रे धुलयङ खेपा रङ्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">1:51 </char><char style="xt" closed="false"><ref loc="GEN 28:12">उत २८:१२</ref></char></note><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना सहरग भ्यान भत्यार</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />सुमङीन लाह् गालील प्रदेसन काना सहरग भ्यान भत्यारदी ङ्याह्। येसुन मा स्याह्‌ ङ्याह्। <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />येसु रे नुन चेलाव यङ भत्यारग घ्वापा ङ्याह्। <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />अङ्‌गुरन खु ताह्‌मी येसुन माई नू र्‌वाबो, “ख्युन ङ्याबो अङ्‌गुरन खु मह्‌या।” <verse eid="JHN 2:3" /><verse number="4" style="v" sid="JHN 2:4" />येसुई नू र्‌वाबो, “हे चिमिचा, ङै तै खेत्वानान ङाः नर्‌वा। ङन भेला हेँदिरि स्वापा मह्‌या।” <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />नुन माई राङ्पाकाङ्मोः र्‌वाबो, “नुई र्‌वापालैम ङेनजै ख्या।”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />ता यहूदीवन छाङ्म राचेन ल्हून भिह्तु स्याह्‌ क्वाईमाल्‌ला: लितर क्यामदी स्योङ्नान लुङन गेर्जा रु थाम नाम्पा ङ्याह्। <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />येसुई राङ्पाकाङ्मोः र्‌वाबो, “गेर्जाव त्युई काना।” ख्युई त्यु गेर्जान ङुरथालै काङ्बो। <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />नुई ख्युकाङ्मोः र्‌वाबो, “गेर्जा पोङपोङ ङाई त्यु भत्यारन मुखियान स्याह् होरा।” ख्युई अन वप्पो। <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />भत्यारन मुखियाजै मन त्यु चाकी खेबो, कन ता अङ्‌गुरन खु रह्पा ङ्याह्। मन खालै स्वापा जेङ्पा र्‌वार्‌वा नू क्युई मह्‌या, जेङ्नै त्यु काङ्नान्न राङ्पाकाङ्मोः चन क्युई ङ्याह्। ता भत्यारन मुखियाजै मापाः घ्वाघ्वा र्‌वाबो, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“सिमि पुरूजै ङू अङ्‌गुरन खु साङ्क्याङ नान्नान आलै सिमिवजै याम्मा झातामी मात्र अङ्‌गुरन खु र्‌योःचाम नान्नान। नुई ता अङ्‌गुरन खु साङ्क्याङ चोँन बेर ख्योवाख्योवा नाम्पा ङ्याह्।” <verse eid="JHN 2:10" /><verse number="11" style="v" sid="JHN 2:11" />नुन ताईलुवान धोनवन बर्ग अन पहिली हालाईचेन धोन येसुई गालील प्रदेसन काना सहरग खेबो। झामखेखे नुई जेँन महिमा थम्बो, आलै नुन चेलावजै नुन लाह्ः बिस्वास खेबो। <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />अन्न ङिक नु जेँन मा, भाइव रे चेलावन ङ्याबो कफर्नहुम होई, रे खजिर्या स्याह्‌ छ्युङ्बो।<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 4:13">मत्ती ४:१३</ref></char></note><verse eid="JHN 2:12" /></para>
  <para style="s">येसु यरूसलेमन आराधनालयग वैपा</para>
  <para style="r">(<ref loc="MAT 21:12-13">मत्ती २१:१२-१३</ref>; <ref loc="MRK 11:11-17">मर्क ११:११-१७</ref>; <ref loc="LUK 19:45-46">लुक १९:४५-४६</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहूदीवन निस्तार-तेवर ङेह्‌मः ङ्याह्, रे येसु यरूसलेमन आराधनालयग होई।<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">प्रस १२:१-२७</ref></char></note> <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />नुई आराधनालयग मिबा, लूपा रे पुरेन र्‌युत्नानव रे सोङ फिन्नानवजै र्‌युच्‌चे खेपाई रह्पा धोबो। <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />तब थाःपादीन ताल्च्या दोङदोङ नुई ख्यु पुरूग, नुन लूपाव रे मिबाकाङ्मोः र्‌वार्‌वा आराधनालयलै खोलोः ताल्बो, रे सोङ फिन्नानवन सोङ नाम्पान तेबल धिम्बो। <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />पुरेन र्‌युन्नानकाङ्मोः नुई र्‌वाबो, “स्यीह्‌लै अन तैस्याङ पुरू होरा। ङन पान यिमग बजारन दोकान नधोवा।” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />नुन चेलाकाङ्मोः पबित्रसास्त्रग सर्पा अन ल्होई ह्‌याका रह्बो, “हे परमेस्वर, नान यिमन भिह्तु ङन तोप ङनै झिङ मेह्‌लैम छ्याङ्‌ङ।”<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PSA 69:9">भजन ६९:९</ref></char></note> <verse eid="JHN 2:17" /><verse number="18" style="v" sid="JHN 2:18" />यहूदी आङ खेनान्न सिमिवजै प्रस्‌नदीन झब बिम्बो, “नाः झाम खेनान्न आङ ङिह्पा र्‌वार्‌वा थन्चेन भिह्तु ताईलुवान धोन तै खेतैनान?” <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />येसुई ख्युकाङ्मोः झब बिम्बो, “अन आराधनालयग फ्वा, रे ङा सुमङीग अनग दोङ्नान ङ्युँ।”<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ती २६:६१</ref>; <ref loc="MAT 27:40">२७:४०</ref>; <ref loc="MRK 14:58">मर्क १४:५८</ref>; <ref loc="MRK 15:29">१५:२९</ref></char></note> <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />तब यहूदीवजै र्‌वाबो, “अन आराधनालय दोङ्म ङेथल रै रू परा थ्वाबो, रे तै ना अनग सुमङीग दोङतैनान तै?” <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />जेङ्नै कन आराधनालयन भारेः नुई ल्होई र्‌वापा ङ्याह्, मन नुन ल्हो ङ्याह्। <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />जब नु सिह्पालै सम्पु सोल्बो, तब येसुई र्‌वापान अन ल्होई चेलाकाङ्मोः नावा रह्पा, रे ख्युई पबित्रसास्त्रन लाह्ः रे येसुई र्‌वापा बचन्न ङ्याः बिस्वास खेबो।<verse eid="JHN 2:22" /></para>
  <para style="s">येसु सिमिन सम स्योःनान</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />जब येसु निस्तार-तेवरन भत्यारन भेला यरूसलेमग ङ्याह्, तब नुई खेपान ताईलुवान धोनव रङरङ लै सिमिवजै नुन मिह्‌नग बिस्वास खेबो। <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />जेङ्नै येसुई जेँगै ख्युन भरग मख्योवाबो, तैङर्‌वाङिन सिमि तै जेङ्पा र्‌वार्‌वा नु स्योङ। <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />नू सिमिन भारेः सुई साँचि मबिनखाईमे मह्‌या, तैङर्‌वाङिन सिमिन समग तै राह्‌नान, अन नुँह् स्योङ।<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">निकोदेमस रे येसु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />फरिसीवन बर्ग निकोदेमस मिह्‌न्न सिमिदी ङ्याह्। नु यहूदी जोम्पुन हाकिम ङ्याह्। <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />नु छान्जे येसुन स्याह्‌ स्वाबो, रे नू र्‌वाबो, “गुरुज्यू, ङ्योअग क्युई ङिह्पा ना परमेस्वरलम स्वापान गुरु जेङ्पा, तैङर्‌वाङिन परमेस्वरन ङ्याबो मह्‌या र्‌वाङिन नाई खेपान अन ताईलुवान धोनव सुई खे मतैनान।” <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />येसुई नू झब बिम्बो, “तेम्माई ङा नाः र्‌वाचे, सुई सार्बा खेखे मकेङिन नुई परमेस्वरन राज्य रङ मतैनान।” <verse eid="JHN 3:3" /><verse number="4" style="v" sid="JHN 3:4" />निकोदेमसजै नू र्‌वाबो, “सिमि काप्पो रामी कुजुई केह्तैनान? तै नु जेँन मान फौग ङेरेप जाःजाः केह्तैनौ?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />येसुई झब बिम्बो, “तेम्माई ङा नाः र्‌वाचे, सुई त्यु रे आत्मालम मकेङिन परमेस्वरन राज्यग जाः मतैनान। <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />ल्होलम केह्पा ल्हो जेङ्पा, रे आत्मालम केह्पा आत्मा जेङ्पा। <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />ङै नाः सार्बा खेखे केह्त्वानान र्‌वार्‌वा र्‌वातौ हानलाया। <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />लन खाः वैसुम खेनान स्याह्‌ई वैनान, ना लन्न केह्ः ताह्‌नान, जेङ्नै मन खालै स्वानान रे खाः वैनान र्‌वार्‌वा क्युई मराह्‌नान। आत्मालम केह्पान सिमि पुरू झामै राह्‌नान।”<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ECC 11:5">खाई ११:५</ref></char></note> <verse eid="JHN 3:8" /><verse number="9" style="v" sid="JHN 3:9" />निकोदेमसजै नू लोप्पो, “अन कुजुई रा तैनान?” <verse eid="JHN 3:9" /><verse number="10" style="v" sid="JHN 3:10" />येसुई नू झब बिम्बो, “ना इस्राएलन ङोत्वा गुरु राह्‌राह्‌ अन ल्होई हामकोनौ? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />तेम्माई, ङा नाः र्‌वाचे, ङ्योअजै तै हाकोनान अन र्‌वानान, रे ङ्योअजै तै रङ्पा ङिह्पा अन्न साँचि बिन्नान, जेङ्नै ङेन ङ्योअन बयान स्वीकार मखेँ। <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />ङै ङेनकाङ्मोः पिर्थीबिन ल्होई र्‌वापा, जेङ्नै ङेन बिस्वास मखेँ, झन ङेनकाङ्मोः स्वर्गन ल्होई स्याङ्‌ङिन कुजुई बिस्वास खेतैनान? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />स्वर्गलै धुलधुल स्वानान सिमिन ङोह्जो नङ्म सुई यङ स्वर्गः लिप्पा मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="JHN 6:38">यूह ६:३८</ref></char></note>” <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />कुजुई मोसाई तये मीपान ठाउँग भुलेनग सोल्बो, उजुखेखेई सिमिन ङोह्जो थित्वानान,<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="NUM 21:9">गन्ती २१:९</ref>; <ref loc="JHN 8:28">यूह ८:२८</ref></char></note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />रे कान-कानजै नुन लाह्ः बिस्वास खेँ, नुई मताह्‌नान्न झुनी देन्नान। <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />“तैङर्‌वाङिन परमेस्वरजै सन्सारग झाम मया खेबो, कि नुई जेँन तीबाःदि ङोह्जो बिम्बो, ताकि नुन लाह्ः बिस्वास खेनान सुई यङ मीपा नराःयो, जेङ्नै नुई मताह्‌नान्न झुनी धेरायो। <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />तैङर्‌वाङिन परमेस्वरजै ङोह्जोः सन्सारग न्याय ख्या र्‌वार्‌वा मफेप्पो, जेङ्नै सन्सार नुनलम उद्धार धेरायो र्‌वार्‌वा फेप्पो।”<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />सुई ङोह्जोन लाह्ः बिस्वास खेँ, नुन न्याय मराह्‌नान, जेङ्नै बिस्वास मखेनानवन चन ङूई न्याय रह्पा ङ्याह्, तैङर्‌वाङिन नुई परमेस्वरन तीबाःदि ङोह्जोन मिह्‌नग बिस्वास खेपा मह्‌या। <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />फैसला चन अनै जेङ्पा, ताह्‌म सन्सारग स्वापा ङ्याह्, रे सिमिवजै ताह्‌मः ख्योवाख्योवा नाःतुमाः स्याङ्बो, तैङर्‌वाङिन ख्युन धोन अलः ङ्याह्। <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />तैङर्‌वाङिन धोन अलः खेनान पुरूजै ताह्‌मः मस्याङ्नान, रे ख्युन धोन रङ्नान र्‌वार्‌वा ख्यु ताह्‌मः मस्वानान। <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />तेम्मालम सोन्नान सिमि साल्म स्वानान, रे झामखेखे नुई खेपान धोनव परमेस्वरग खेपा जेङ्पा र्‌वानान प्रस्त रङ्नान।<verse eid="JHN 3:21" /></para>
  <para style="s">येसु रे यूहन्ना</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />अन्न ङिक येसु रे नुन चेलाव यहूदिया मुलुकग होई, रे स्याह्‌ ख्युन ङ्याबो खजिर्या छ्युङ्बो, रे बप्‌तिस्मा बिम्बो। <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />यूहन्नाई यङ सालीमन ङेह्‌मः एनोनग बप्‌तिस्मा बिङ्‌ङ, तैङर्‌वाङिन स्याह्‌ त्यु हाति र्‌वार्‌वा ङ्याह्। स्याह् सिमिव नुन स्याह्‌ स्वाङ रे नुई ख्युकाङ्मोः बप्‌तिस्मा बिङ्‌ङ। <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />मन्न भेला बेर यूहन्ना झ्यालखानाः थेप्पा मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ती १४:३</ref>; <ref loc="MRK 6:17">मर्क ६:१७</ref>; <ref loc="LUK 3:19-20">लुक ३:१९-२०</ref></char></note><verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />अन्तौ यूहन्नान चेलावन यहूदीदीन ङ्याबो छाङ्म राचेन भारेः खाथू रह्पा। <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />यूहन्नान स्याह्‌ स्वास्वा ख्युई नू र्‌वाबो, “गुरुज्यू, यर्दन चाङ्पुन स्यारक्याँ सु नान ङ्याबो ङ्याह्, सुन भिह्तु नाई साँचि बिम्बो, सेह्‌ना, नुई बप्‌तिस्मा बिम्पाई ङ्याह्, रे पुरू नुन स्याह्‌ वैयङ ङ्याह्।” <verse eid="JHN 3:26" /><verse number="27" style="v" sid="JHN 3:27" />यूहन्नाई झब बिम्बो, “सिमि स्वर्गलै मबिन्न बेर नुई तये देतमतैनान। <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />‘ङा मसिह नङ्पा, जेङ्नै ङा नुनखेरे ङू फेप्पा जेङ्पा’ र्‌वानान्न ङन साँचि ङेह् बिङ्‌ङ।<note caller="-" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">यूह १:२०</ref>; <ref loc="MAL 3:1">मला ३:१</ref></char></note> <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />सुन ङ्याबो दुलही ङिह्पा, दुलाह अनै जेङ्पा। दुलाहन फुरी सु नुन रह्‌म्म च्याङ्नान, नुन केह्ः ताह्ताह् मिह्दा किम्म राह्‌नान। अन्नकारन ङन अन किम्म ता पुरा रह्पा ङ्याह्। <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />नु किम राचे, जेङ्नै ङा छ्युम मराखाईमे ङ्याह्।<verse eid="JHN 3:30" /></para>
  <para style="s">नु सु स्वर्गलै स्वाबो</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“तोह्‌लै स्वानान चन पुरून खेरे किम ङिह्पा। पिर्थीबिलम राह्‌नान पिर्थीबिन जेङ्पा, रे पिर्थीबिन ल्होई र्‌वानान। स्वर्गलै स्वानान पुरून खेरे महान ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">3:31 </char><char style="xt" closed="false"><ref loc="JHN 8:23">यूह ८:२३</ref></char></note> <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />येसुई तै रङ्पा रे ताह्पा ङिह्पा, नु अन्न बयान बिन्नान, जेङ्नै नुन साँचि सुई स्वीकार मखेनान। <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />सुई नुन साँचि स्वीकार खेपा ङ्याह्, नुई परमेस्वर तेम्मा ङिह्पा र्‌वानान ल्होईन पर्मान बिङ्‌ङ। <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />तैङर्‌वाङिन सू परमेस्वरजै फेप्पो, नुई परमेस्वरन ल्होई र्‌वानान, तैङर्‌वाङिन परमेस्वरजै हाति र्‌वार्‌वा पबित्र आत्मा बिन्नान। <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />पाई नुन ङोह्जो मया खेनान, रे तैस्याङ पुरू नुनै लाह्‌ग बिम्पा ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती ११:२७</ref>; <ref loc="LUK 10:22">लुक १०:२२</ref></char></note> <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />सुई ङोह्जोन लाह्ः बिस्वास खेँ, नुई मताह्‌नान्न झुनी देप्पा ङिह्पा। जेङ्नै सुई ङोह्जोन र्‌वापा मङ्याङ्‌ङ, नुई जिन्दगी रङ्नान मह्‌या, जेङ्नै परमेस्वरन सेह्ताङ नुन लाह्ः लुईपाई राह्‌नान।”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">येसु रे सामरी चिमिचा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />यूहन्नाई खेरे येसुई लै चेलाव दोङ्म जाःपा ङ्याह् रे बप्‌तिस्मा यङ बिम्म जाःपा ङ्याह् र्‌वानान फरिसीवजै ताह्बो। <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />(तेम्माग येसु जेँजै ता नङ्पा, जेङ्नै नुन चेलावजै बप्‌तिस्मा बिङ्‌ङ।) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />जब येसुई अन ताह्बो, तब नु यहूदिया ख्योवाख्योवा ह्‌याङ गालीलग होल्बो। <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />नू सामरियान लमलै राह्‌राह्‌ वैत्वाङ।<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />रे नु सामरियान सुखार र्‌वानान सहरग स्वा ताप्पो। अन सहर चन याकूबजै जेँन ङोह्जो योसेफग बिम्पा सान रह्‌म्मै परि राँ।<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="GEN 33:19">उत ३३:१९</ref>; <ref loc="JOS 24:32">यहो २४:३२</ref></char></note> <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />स्याह्‌ याकूबन इनार ङ्याह्। येसु लेनलेन गोप्पा राह्‌राह्‌ अन इनारन नाः छ्युङपाई ङ्याह्। अन्तौ क्वाईमाल्‌ला: ङिजे रह्पा ङ्याह्।<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />ती सामरियान चिमिचा त्यु काङ्मः स्याह्‌ स्वाबो। येसुई नू र्‌वाबो, “ङाः त्यु थुङ फाना।” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />नुन चेलाव सहरग झायाप र्‌युप्मः वैपा ङ्याह्।<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />तब सामरी चिमिचाई नू र्‌वाबो, “ना यहूदी राह्‌राह्‌ ङा सामरी चिमिचान ल्हालै कुजुई त्यु थुङ्नान?” (यहूदीवजै सामरीवन ङ्याबो सङै मखेँ)<note caller="-" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">एज्रा ४:१-५</ref>; <ref loc="NEH 4:1-2">नहे ४:१-२</ref></char></note> <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />येसुई नू र्‌वाबो, “नाई परमेस्वरन वर रे नान ङ्याबो त्यु तोल्नान सिमि स्योपा राङिन नाई नू तोल्नान ङ्याह्, रे नुई ना सम्पु त्यु बिन्नान ङ्याह्।” <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />मन चिमिचाई नू र्‌वाबो, “गुरु, नान ङ्याबो त्यु छ्यूनान्न धाङ मीपाऊ, रे इनार यङ तिङ ङ्याह्। तब नाई खालै अन सम्पु त्यु सन्नान? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />तै ङेन ङिन खेपुल याकूबन खेरे किम जेङ्पौ? नुई ङी अन इनार दोङ्बो, रे नु जेँजै, नुन सन्तान रे नुन भस्तई अन इनारन त्यु थुङ्बो।”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />येसुई नू झब बिम्बो, “अन त्यु थुङ्नान पुरू ह्‌याङ त्यु बुल्नान ङ्याह्, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />जेङ्नै सुवा-सुवाजै ङै बिन्नान त्यु थुङ्नान अन हातौयै त्यु बुल्नान मह्‌या। कन त्यु ङा नू बिन्नान ङ्युँ, अन नुग मताह्‌नान्न जिन्दगीन भिह्तु थाङ्पाई छ्युङ्नान त्युन फु राह्‌नान ङ्याह्!”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />मन चिमिचाई नू र्‌वाबो, “गुरु, ङा अनै त्यु भिना, रे ङा त्यु बुल्नान मह्‌या, रे स्यीह् त्यु दर्मः स्वापास्वात्वा खेमत्वानान”। <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />येसुई नू र्‌वाबो, “वया, नान पसा घ्वाघ्वा स्यीह् सह्‌रा।” <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />मन चिमिचाई र्‌वाबो, “ङन पसा मीपा।” येसुई नू र्‌वाबो, “नान पसा मीपा र्‌वार्‌वा नाई तेम्मा र्‌वापा, <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />तैङर्‌वाङिन नान पसा ङापा रातपा ङ्याह्, रे सु चोँ नान ङ्याबो ङिह्पा, अन नान पसा नङ्पा। नाई अन तेम्मा र्‌वापा जेङ्पा।”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />मन चिमिचाई नू र्‌वाबो, “गुरु, ना भबिस्यबक्ता जेङ्पा र्‌वार्‌वा ङाः क्युई ङिह्पा। <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />ङ्योअन खेपुलवजै अन धुरग परमेस्वरन आराधना खेबो, आलै ङेन येहूदीव र्‌वाङ, कि आराधना खेपु यरूसलेम जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="DEU 11:29">कानुन ११:२९</ref></char></note><verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />येसुई नू र्‌वाबो, “ए चिमिचा, ङाः बिस्वास ख्या, मन्न भेला स्वा जाःपा ङ्याह्, जब ङेन न ता अन धुरग, न यरूसलेमग पान आराधना खेनान ङ्याह्। <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />ङेन सामरीव तै आराधना खेँ अन मराँ। ङ्योअजै तै आराधना खेनान अन राह्‌नान, तैङर्‌वाङिन मुक्ति चन यहूदीवलम स्वाङ।<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="ISA 2:3">यसै २:३</ref></char></note> <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />जेङ्नै भेला स्वायङ ङ्याह्, रे मन भेला चोँई जेङ्पा, जब तेम्मा पुजारीवजै पाः आत्मा रे तेम्माग आराधना खेनान ङ्याह्। तैङर्‌वाङिन आराधना खेनान झामै आराधककाङ्मोः र्‌वार्‌वा पाई फाङ्‌ङ। <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />परमेस्वर आत्मा जेङ्पा, रे नुन आराधकवजै आत्मा रे तेम्माग आराधना खेत्वानान।” <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />मन चिमिचाई नू र्‌वाबो, “ङाः क्युई ङिह्पा, कि मसीह स्वानान (सू मसिह र्‌वाङ), रे जब नु स्वानान, तब नुई यङ ङ्योअग ल्होई पुरू स्यान्नान ङ्याह्।” <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />येसुई नू र्‌वाबो, “नान ङ्याबो ल्होई र्‌वानान, ङा नुई जेङ्पा।” <verse eid="JHN 4:26" /><verse number="27" style="v" sid="JHN 4:27" />अन्नै भेला नुन चेलाव स्वाबो, रे नू चिमिचादीन ङ्याबो ल्होई र्‌वायङ खेपा रङरङ हालाईबो, जेङ्नै “ना तै सम खेनान?” आथबा “ङेन अन चिमिचान ङ्याबो तैङ ल्होई र्‌वायङ ङिह्पा?” र्‌वार्‌वा सुई मलोप्पो।<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />तब अन चिमिचा जेँन गाःरि ख्योवाख्योवा सहरक्याँ होई, रे सिमिकाङ्मोः र्‌वामः जाःबो, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“स्वा, तीपा सिमी सेह्‌ना, सुई ङै खेपा धोन पुरू ङा स्याप्पो। कार्तौ नुई मसिह ता नङ्मतौ?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />तब ख्यु सहरलै गेग्गे येसुन स्याह्‌ होई। <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />अन्नै भेला घूँ चेलावजै नू झाःम र्‌वार्‌वा छ्याःफुल्बो, “रब्बी, तयाः झा।” <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />जेङ्नै नुई ख्युकाङ्मोः र्‌वाबो, “ङन ङ्याबो झाचेन भिह्तु ङ्योप्पा ङिह्पा, कन ङेनकाङ्मोः क्युई मह्‌या।” <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />अन्नकारन चेलावजै राह्ङराङ्साः र्‌वाबो, “हँ सुई नू झायाप सत्त कि तै जेअँ?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङा फेन्नान्न इच्छ्या अन्सार खेचे, रे नुन धोन पुरा खेचेई ङन ङ्योप्पा जेङ्पा। <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />तै ङेन मर्‌वानौ, ‘हेँ लाह् ली लामा ङिह्पा, तब बालि गम्चेन भेला स्वाङ?’ ङा ङेनकाङ्मोः र्‌वाचे, जेँन बारी सेह्‌ना, बालि गम्चेन भिह्तु मिनतपा ङ्याह्। <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />सुई बालि गम्ङ नुई ज्याला देङ्‌ङ, रे मताह्‌नान्न जिन्दगीन भिह्तु फल रूङ, रे र्‌यु पन्नान रे बालि गम्नान ङ्याबो स्याँ। <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />तैङर्‌वाङिन ‘तीपाई र्‌यु पह्ङ्‌ङ, रे घङजै बालि गम्ङ,’ र्‌वानान्न बचन अनगै तेम्मा राँ।<note caller="-" style="x"><char style="xo" closed="false">4:37 </char><char style="xt" closed="false"><ref loc="MIC 6:15">मीका ६:१५</ref></char></note> <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />ङै ङेनकाङ्मोः स्याह्‌ बालि गम्मः फेप्पा, खाः ङेनजै तूरि खेपा मह्‌या। घङवजै तूरि खेपा ङिह्पा, रे ख्युन तूरि खेपान फल ङेनजै देप्पा ङिह्पा।”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />“ङै तै खेपा नुई ङाः पुरू र्‌वाबो” र्‌वानान मन चिमिचान साँचिजै खेखे मन सहरन सामरीवन बर्ग लैजे नुन लाह्ः बिस्वास खेबो। <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />अन्नकारन जब सामरीव नुन स्याह् स्वाबो, तब ख्युई नू ख्युन ङ्याबो छ्योवा र्‌वार्‌वा छ्याःफुल्बो, रे नु ङेर्या स्याह् छ्युङ्बो।<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />आलै येसुन बचन्न कारन घङ लैजे नुन लाह्ः बिस्वास खेबो। <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />मन चिमिचाः ख्युई र्‌वाबो, “ता नाई र्‌वापान ल्होईजै खेखे ङ्योअजै बिस्वास खेपा नङ्पा। जेङ्नै ङ्योअ जेँजै ताह्पान कारनजै तेम्माई नु सन्सारन मुक्तिदाता जेङ्पा र्‌वार्‌वा ङ्योअग क्युई रह्पा।”<verse eid="JHN 4:42" /></para>
  <para style="s">येसुई ङोत्वा आङ खेनान्न सिमिन ङोह्जो ताःफाम्बो</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />ङितौन ङिक स्याह्‌लै गेग्गे येसु गालीलग होई। <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />(येसु जेँजै साँचि बिम्बो, कि जेँन देस अलःग भबिस्यबक्ता सुई सम्मान मराँ।)<note caller="-" style="x"><char style="xo" closed="false">4:44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">मत्ती १३:५७</ref>; <ref loc="MRK 6:4">मर्क ६:४</ref>; <ref loc="LUK 4:24">लुक ४:२४</ref></char></note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />जब नु गालीलग स्वाबो, तब नुई यरूसलेमग निस्तार तेवरन भेलाः तै खेपा ङ्याह् अन धोन पुरू रङ्पा राह्‌राह्‌ गालीलन सिमिवजै नू स्वागत खेबो, तैङर्‌वाङिन ख्यु यङ तेवरग वैपा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">4:45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">यूह २:२३</ref></char></note><verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />अन्न ङिक येसु ह्‌याङ गालीलन काना सहरग स्वाबो। खाः नुई त्यू अङ्‌गुरन खु दोङ्पा ङ्याह्। कफर्नहुमग ङोत्वा आङ खेनान्न सिमिदी ङ्याह्, नुन ङोह्जो खँ।<note caller="-" style="x"><char style="xo" closed="false">4:46 </char><char style="xt" closed="false"><ref loc="JHN 2:1-11">यूह २:१-११</ref></char></note> <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />येसु यहूदियालै गालीलग स्वापा ङ्याह् र्‌वानान ताह्ताह् ङोत्वा आङ खेनान्न सिमि नुन स्याह्‌ होई, आलै नुन ङोह्जो स्वास्वा सिम धोवाँ र्‌वार्‌वा नू छ्याःफुल्बो, तैङर्‌वाङिन नुन ङोह्जो सिम जाःपा ङ्याह्। <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />येसुई नू र्‌वाबो, “ङेन ताईलुवान धोन रे हालाईचेन धोनव मरङ्न बेर तै खेखेई बिस्वास मखेँ।”<note caller="-" style="x"><char style="xo" closed="false">4:48 </char><char style="xt" closed="false"><ref loc="DAN 4:2">दान ४:२</ref></char></note> <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />मन ङोत्वा आङ खेनान्न सिमिजै नू र्‌वाबो, “गुरु, ङन ङोह्जो सिचेन खेरे ङूई स्वायो।” <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />येसुई नू र्‌वाबो, “वया, नान ङोह्जो सम्पु ङ्याह्।” येसुई नू र्‌वापान बचन मन सिमिजै बिस्वास खेबो, रे जेँन लमग होई। <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />आलै नु वैतौवैतौ लमगै नुन राङ्पावजै नू दोदो नुन ङोह्जो सोम्बो र्‌वार्‌वा नू स्याप्पो।<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />हातौन भेलालै नू ताःमः जाःबो र्‌वार्‌वा नुई ख्युकाङ्मोः लोत्तौ ख्युई र्‌वाबो, “थ्याँ ङिजे एक बजेलै छायोई नू फेप्पो।” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />येसुई नू “नान ङोह्जो सोन्नान ङ्याह्” र्‌वापान भेलालै जेअँ र्‌वार्‌वा पाः क्युई रह्बो। आलै नुँह्‌जै रे नुन यिमन पयार पुरूजै बिस्वास खेबो। <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />यहूदियालै गालीलग स्वास्वा येसुई खेपा अन ङेरेपन ताईलुवान धोन ङ्याह्।<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">योह् कत्यामग पछेघाति ताह्पा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />अन्न ङिक यहूदीवन तेवर ङ्याह्, रे येसु यरूसलेमग होई। <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरूसलेमग लूपा झलान रह्‌म्म ङा थाम थेम्पा रह्पान योह् पोखरीदी ङ्याह्, कनग हिब्रु ल्होईग बेथस्दा र्‌वाङ। <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />स्याह्‌ राँसा राँसान खङ्नानव, आथबा मी मरङ्नान, लेह्‌न मतैनान, ल्हो मगुल्नान्न सिमिव क्याङक्याङ छ्युँ। [ख्यु त्यु कन्न भेला कुल्ङ र्‌वार्‌वा कूङ। <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />तैङर्‌वाङिन परमप्रभुन दुतदीजै कार्तौ-कार्तौ योह् कत्यामग धुलधुल त्यु कुल्ङ, रे त्यु कुल्मी सु ङू त्युन झिङ जाःङ, तैस्याङ्न नाजाई खङ्पा रानै, मन ताँ।] <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />स्याह्‌ ङिच्यु रै च्योर्गे परालै खङ्पा सिमिदी ङ्याह्। <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />येसुई नू स्याह्‌ क्याङक्याङ छ्युङ्पा रङ्बो आलै भेला र्‌याङ्मलै मन अन धसा ङिम्न र्‌वार्‌वा क्युई राह्‌राह्‌ येसुई नू र्‌वाबो, “तै ना ताःसुम खेनौ?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />खङ्नानजै नू र्‌वाबो, “गुरु, कन्न भेला त्यु कुल्ङ मन्न भेला ङाः पोखरीन त्यु थाल साःनान ङन सिमि सुई मीपा, ङा वैतौवैतौ ङन खेरे ङू घङ सिमि त्यू धुल्ङ।”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />येसुई नू र्‌वाबो, “च्याँ, रे जेँन ल्हौ तुह्‌या, रे ल्हेना।” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />तुरुन्तै अन सिमि ताह्बो, रे नु जेँन ल्हौ हुरहुर ल्हेम्बो। अन्तौ नाह्‌न ल्हाः ङ्याह्। <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />अन्नकारन ताःफाम्पा मन सिमी यहूदीवजै र्‌वाबो, “त्या ता नाह्‌न ल्हाः जेङ्पा, कानुन अन्सार नाः ल्हौ हुर्चे लः मह्‌या।”<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="NEH 13:19">नहे १३:१९</ref>; <ref loc="JER 17:21">यर १७:२१</ref></char></note> <verse eid="JHN 5:10" /><verse number="11" style="v" sid="JHN 5:11" />नुई ख्युकाङ्मोः झब बिम्बो, “सुई ङाः ताःफाम्बो नुई यङ र्‌वाबो, ‘जेँन ल्हौ हुरहुर ल्हेना’।” <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />ख्युई नू लोप्पो, “नाः ल्हौ हुरहुर ल्हेना र्‌वानान सिमि सु जेङ्पा?” <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />जेङ्नै ताःपान मन सिमिजै नु सु ङ्याह् र्‌वार्‌वा स्योपा मह्‌या, तैङर्‌वाङिन मन ठाउँग मोङ रह्पान कारन येसु स्याह्‌लै वैतपा ङ्याह्। <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />अन्न ङिक येसुई नू आराधनालयग दोदो र्‌वाबो, “सेह्‌ना, ना ताह्पा ङ्याह्। ह्‌याङ तीपा नख्या, रे नान लाह्ः हेँ ह्‌याल्म अलः नराःयो।”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />नू ताःफान्नान ता येसु जेअँ र्‌वार्‌वा मन सिमिजै वैवै यहूदी आङ खेनान्न सिमिकाङ्मोः र्‌वाबो। <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />अन्नकारनजै यहूदीवजै येसू तेपफाम्मः जाःबो, तैङर्‌वाङिन नुई अन धोन नाह्‌न ल्हाः खेपा ङ्याह्। <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />तब येसुई ख्युकाङ्मोः र्‌वाबो, “ङन पाई चोँन बेर धोन खेपाई ङ्याह्, रे ङा यङ धोन खेपाई ङिह्पा।” <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />अन्नकारन यहूदी आङ खेनान्न सिमिवजै येसू सह्‌म्मः हेँ ह्‌याल्म प्रयास खेमः जाःबो, तैङर्‌वाङिन नुई नाह्‌न ल्हाः‌न कानुन नोङ्फान्चेन धोन मात्र नङ्पा, जेङ्नै जेँगै परमेस्वरन तोह्‌या दोङदोङ नुई परमेस्वरग जेँनै पा र्‌वापा ङ्याह्।<verse eid="JHN 5:18" /></para>
  <para style="s">ङोह्जोन आङ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />येसुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, ङोह्जो जेँजै तये खे मतैनान, जेङ्नै पाई तै खेपा रँ अनै मात्र खेँ, तैङर्‌वाङिन पाई तै खेँ, ङोह्जोई झामै खेँ। <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />तैङर्‌वाङिन पाई ङोह्जोः मया खेँ, रे नु जेँजै खेपाई रह्पान धोन पुरू ङोह्जोः थङ्‌ङ। अन खेरे मकेकुकेन किम धोन नुई ङोह्जोः थन्नान ङ्याह्, रे ङेन हालाईनान ङ्याह्। <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />तैङर्‌वाङिन कुजुई पाई सिह्पाकाङ्मोः सोम्फान्नान रे ख्युकाङ्मोः झुनी बिन्नान, झामखेखेई ङोह्जोई सू सम खेनान, नू झुनी बिन्नान। <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />तैङर्‌वाङिन पाई सुई न्याय मखेनान, जेङ्नै न्याय खेनान्न धोन पुरू ङोह्जो बिम्पा ङ्याह्, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />ताकि पुरूजै ङोह्जोन सम्मान ख्याःयो, कुजुई ख्युई पान सम्मान खेँ। ङोह्जोन सम्मान मखेनान सिमिजै नू फेन्नान पानै सम्मान मखेनान।”<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, सुई ङन बचन ङ्यान्नान रे ङा फेन्नान्न लाह्ः बिस्वास खेनान, नुन ङ्याबो मताह्‌नान्न झुनी ङिह्पा। अन न्यायग मस्वानान, जेङ्नै सिपालै नु झुनी ताप्पा ङिह्पा। <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, अन भेला स्वायङ ङ्याह्, रे अन भेला चोँ जेङ्पा, जब सिह्पावजै परमेस्वरन ङोह्जोन बचन ताह्‌नान ङ्याह्, रे ताह्‌नानकाङ्मोः सम्पु राह्‌राह्‌ च्याङ्नान ङ्याह्। <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />तैङर्‌वाङिन कुजुई पा जेँगै झुनी ङ्याह्, उजुखेखेई नुई ङोह्जोः र्‌वार्‌वा जेँनै ङ्याबो जिन्दगीन फु राचेन आङ बिम्पा ङ्याह्, <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />आलै नू न्यायन फैसला बिन्चेन आङ बिम्पा ङ्याह्, तैङर्‌वाङिन नु सिमिन ङोह्जो जेङ्पा। <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />“अनग हानलाया, तैङर्‌वाङिन भेला स्वायङ ङ्याह्, जब तुह्‌र्साः रह्पा पुरूवजै नुन केह्ः ताह्‌नान ङ्याह्, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />रे खोलोः गेग्गे स्वानान ङ्याह् धोन लः खेनानव सम्पु ग्युर्नान्न भिह्तु, रे धोन अलः खेनानव चन धल कूचेन भिह्तु सम्पु ग्युर्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दान १२:२</ref></char></note><verse eid="JHN 5:29" /></para>
  <para style="s">येसुन साँचिव</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“ङह् तये खे मतैनान। कताःम ङा ताँ, झामै न्याय ङा खेनान, रे ङन न्याय लः ठहरी राह्‌नान, तैङर्‌वाङिन ङा जेँन इच्छ्या मफान्नान, जेङ्नै ङाः फेन्नान्न इच्छ्या फान्नान।” <verse eid="JHN 5:30" /><verse number="31" style="v" sid="JHN 5:31" />“यदि ङै जेँन भारेः साँचि बिङ्‌ङिन ङन बयान तेम्मा मराह्‌नान। <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />ङन भारेः साँचि बिन्नान घङ ङिह्पा, रे ङाः क्युई ङिह्पा, कि ङन भारेः नुई तै साँचि बिङ्‌ङ, मन साँचि तेम्माई जेङ्पा।” <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />“ङेनजै यूहन्नान स्याह् लोम्म फेप्पा, आलै नुई तेम्मान साँचिन बिम्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">यूह १:१९-२७</ref>; <ref loc="JHN 3:27-30">३:२७-३०</ref></char></note> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />ङै स्वीकारी खेनान्न साँचि सिमिन नङ्पा, जेङ्नै ङेनकोन उद्धार रायो र्‌वार्‌वा ङा अन ल्होई र्‌वानान। <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />यूहन्ना छ्यान्नान रे चम्कि राह्‌नान लज्युङ लैम ङ्याह्, रे ङेन नुन ताह्‌मग ङाईदी बेर स्याङ्मः ङ्याम्बो।” <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />“जेङ्नै ङन ङ्याबो कन साँचि ङिह्पा, मन यूहन्नान साँचि खेरे किम ङिह्पा। तैङर्‌वाङिन कन धोनव पुरा खेमः पाई ङाः बिम्पा ङिह्पा, मन धोन ङै खेपाई ङिह्पा, आलै नुई ङन भारेः साँचि बिम्पाई ङ्याह् कि पाई ङाः फेप्पा जेङ्पा। <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />ङाः फेन्नान पा जेँजै ङन भारेः साँचि बिम्पा ङ्याह्। नुन केह्ः ङेनजै हातौयै ङ्याम्पा मह्‌या, आलै नुन ध्वा हातौयै रङ्पा मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MRK 1:11">मर्क १:११</ref>; <ref loc="LUK 3:22">लुक ३:२२</ref></char></note> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />नुन केह्ः ङेन ङ्याबो मलुईनान। तैङर्‌वाङिन सू नुई फेप्पो, ङेन नुन लाह्ः बिस्वास मखेँ। <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />ङेन पबित्रसास्त्रग फाङ्‌ङ, तैङर्‌वाङिन स्याह् मताह्‌नान्न झुनी देङ्‌ङ र्‌वार्‌वा ङेन छूँ। ङन भारेः साँचि बिन्नान मनै पबित्रसास्त्र जेङ्पा, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />जेङ्नै ङेन झुनी देम्म ङन ङ्याबो स्वासुम मखेँ। <verse eid="JHN 5:40" /><verse number="41" style="v" sid="JHN 5:41" />ङै सिमिवलम सम्मान देस्सुम मखेनान। <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />जेङ्नै ङाः क्युई ङिह्पा, कि ङेन कत्यामन सिमि जेङ्पा। आलै ङाः क्युई ङिह्पा, ङेनकोन समग परमेस्वरन भिह्तु मया तये मह्‌या। <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />ङा ङन पान मिह्‌नग स्वापा ङिह्पा, जेङ्नै ङेन ङाः स्वीकार मखेँ। घङ सुई जेँनै मिह्‌नग स्वाङिन नू स्वीकार खेनान ङ्याह्। <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />ङेन कुजुई बिस्वास खेतैनान, जब कि ङेन राह्ङराङ्साः तीजै-घङ लम सम्मान देस्सुम खेँ, आलै अन सम्मान्न वास्ता मखेँ, कन तीबाःदि परमेस्वरलम स्वाङ? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />अन नछुवा, कि ङा पान ङू ङेनकाङ्मोः दोस बिन्नान ङ्युँ। ङेनकाङ्मोः दोस बिन्नान ता मोसा ङ्याह्, सुन लाह्ः ङेनजै जेँन आस नाम्पा ङ्याह्। <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />तैङर्‌वाङिन ङेनजै मोसाः बिस्वास खेपा जेङ्न ङा यङ बिस्वास खेनान ङ्याह्, तैङर्‌वाङिन नुई ङन भारेः सर्पा ङ्याह्। <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />जेङ्नै ङेन नुई सर्पान ल्होईव बिस्वास मखेङिन, ङन ल्होई कुजुई बिस्वास खेनान?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">येसुई हजार ङा सिमिकाङ्मोः ख्वाबो</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती १४:१३-२१</ref>; <ref loc="MRK 6:30-44">मर्क ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लुक ९:१०-१७</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />अन ल्होईन ङिक, येसु गालील, आथबा तिबेरियासन योह्‌न धिक्याँ होई। <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />आलै मोङ किमदी नुन ङिक जाःबो, तैङर्‌वाङिन नुई खङ्नानवन लाह्ः खेपान ताईलुवान धोनव ख्युई रङ्पा ङ्याह्। <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />येसु धुरन लाह्ः होई, रे जेँन चेलावन ङ्याबो स्याह्‌ छ्युङ्बो। <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />यहूदीवन तेवर, आथबा निस्तार-तेवर ङेह्‌मः ङ्याह्। <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />तब येसुई जेँन लिब्रुङक्याँ सेन्तौ मोङ किमदी जेँन स्याह् स्वायङ खेपा रङरङ फिलिपग र्‌वाबो, “अजोवग ख्वाचेन भिह्तु ङ्योअजै खालै रोता र्‌युचे?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />येसुई नुन छोए सेन्चेन भिह्तु अन र्‌वापा ङ्याह्। तैङर्‌वाङिन नुई तै खेमः जाःपा ङ्याह् अन नू क्युई ङ्याह्।<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फिलिपजै नू झब बिम्बो, “पुरूजै ङाई-ङाई देन्नै क्याम ङेह् मुलन सिक्‌कान रोताई ख्युकाङ्मोः झ्योनान मह्‌या।” <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />नुन चेलावन बर्ग तीपा, सिमोन पत्रुसन भाइ अन्द्रियासजै र्‌वाबो, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“स्यीह् चोलोङ्चादी ङ्याह्। नुन ङ्याबो नजन्न रोता ङा रे ङाह् ङेह् ङ्याह्। जेङ्नै अकेः ह्‌याल्म सिमिवन भिह्तु अकेःजै ज्योनान तै?” <verse eid="JHN 6:9" /><verse number="10" style="v" sid="JHN 6:10" />येसुई र्‌वाबो, “सिमिकाङ्मोः छ्युङ्फाना” स्याह् सी लै रह्पान क्वा ङ्याह्। तब क्वाईमाल्‌ला: हजार ङा चोलोङ्चाव स्याह्‌ छ्युङ्बो। <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />तब येसुई रोता वप्पो रे परमेस्वरग मया रह्बो र्‌वामी छ्युङ्नानकाङ्मोः परेःबो, रे झाःम खेखे ङाह् यङ परेःबो। ख्युई बरङबरङ झबो। <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />जब ख्युई झातामी येसुई जेँन चेलाकाङ्मोः र्‌वाबो, “लामा तुकराव रुवा। तये पाह्दुर नपरा।” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />झानानवजै लामा नाम्पा नजन्न मन रोतान तुकराव ख्युई रूबो रे थाम च्योङे काङ्बो। <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />अन्नकारन नुई खेपान अन ताईलुवान धोन रङरङ मन सिमिवजै र्‌वाबो, “सन्सारग स्वानान्न भबिस्यबक्ता तेम्माई नुई जेअँ।” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />ख्यु स्वास्वा नू हलजफत खेखे वव्वै झली दोङ्म जाःपा र्‌वानान क्युई राह्‌राह्‌ येसु ह्‌याङ तितिमाई धुरग होई।<verse eid="JHN 6:15" /></para>
  <para style="s">येसु त्युन लाह्ः लेम्पा</para>
  <para style="r">(<ref loc="MAT 14:22-27">मत्ती १४:२२-२७</ref>; <ref loc="MRK 6:45-52">मर्क ६:४५-५२</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />ङ्याजे रामी येसुन चेलाव योह्क्याँ होई। <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />रे दोङाः चपचप ख्यु योह्‌न धिक्याँ कफर्नहुमक्याँ वैमः जाःबो। अन्तौ नातुमा रह्पा ङ्याह्, रे येसु चोँन बेर ख्युन ङ्याबो स्वापा मह्‌या। <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />आलै लन किम च्याङच्याङ योह्‌न छ्योलाप युङ्मः जाःबो। <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />ख्युई किलोमितर ङा-रु थाल दोङा कुलकुल वप्पो। ख्युई येसु योह्‌न लाह्ः लेनलेन दोङान रह्‌म्म स्वायङ खेपा रङ्बो। आलै ख्यु ङिह्‌म्बो। <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />जेङ्नै नुई ख्युकाङ्मोः र्‌वाबो, “ङा जेङ्पा, नङिना।” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />ख्युई स्याङस्याङ नू दोङा नाह्‌म्बो, रे दोङा तुरुन्तै ख्यु वैनान्न ठाउँग स्वा ताप्पो।<verse eid="JHN 6:21" /></para>
  <para style="s">सिमिवजै येसू फाप्पा</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />योह्‌न धिक्याँ रह्पान मोह्ङजै नाप्चे स्याह् ती मात्र दोङा रङ्बो। ख्युकाङ्मोः क्युई ङ्याह्, कि येसु जेँन चेलावन ङ्याबो दोङाः चप्पा मह्‌या, जेङ्नै नुन चेलाव मात्र वैपा ङ्याह्। <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />तब तिबेरियासलै घङ दोङाव मन ठाउँन रह्‌म्म स्वाबो। खाः प्रभुई परमेस्वरग मया रह्बो र्‌वामी ख्युई रोता झपा ङ्याह्। <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />येसु रे नुन चेलाव स्याह् मरह्पान क्युई राह्‌राह्‌ मन सिमिव येसु फारैफारै दोङावग चपचप कफर्नहुम होई।<verse eid="JHN 6:24" /></para>
  <para style="s">येसु जिन्दगीन रोता जेङ्पा</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />सिमिवजै येसू योह्‌न धिक्याँ दोदो नू लोप्पो, “रब्बी, ना स्यीह् हातौ स्वापा?” <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />येसुई ख्युकाङ्मोः झब बिमबिम र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेन ताईलुवान धोनव रङरङ नङ्पा, जेङ्नै बरङबरङ रोता झपान कारनजै ङाः फाङ्‌ङ। <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />मीपा राह्‌नान साह्ईन भिह्तु तूरि नख्या, जेङ्नै मताह्‌नान्न झुनी थाल लुईनान साईन भिह्तु तूरि ख्या, कन सिमिन ङोह्जोई ङेनकाङ्मोः बिन्नान ङ्याह्। तैङर्‌वाङिन पा परमेस्वरजै नुन लाह्ः छाप छिम्पा ङ्याह्।”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />ख्युई नू र्‌वाबो, “परमेस्वरजै चाहि खेपान धोन खेचेन भिह्तु ङ्योअजै तै खेत्वानान।” <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />येसुई ख्युकाङ्मोः र्‌वाबो, “परमेस्वरन धोन अनै जेङ्पा: सू नुई फेप्पो नुन लाह्ः बिस्वास ख्या।” <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />अन्नकारन ख्युई नू र्‌वाबो, “ना ताईलुवान धोन तै थन्नान, अन ङ्योअ सेम्मता, रे ङेन ङ्याबो बिस्वास खेमता? ना तै खेनान? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />ङ्योअन खेपुलजै तये मीपान ठाउँग मन्न झबो, कुजु पबित्रसास्त्रग सर्पा ङ्याह्, ‘नुई ख्युकाङ्मोः झाचेन भिह्तु स्वर्गलै रोता बिम्बो’।”<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="EXO 16:4-15">प्रस १६:४-१५</ref>; <ref loc="PSA 78:24">भजन ७८:२४</ref> </char></note> <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />येसुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे। ङेनकाङ्मोः स्वर्गलै रोता बिन्नान मोसा नङ्पा, जेङ्नै स्वर्गलै ङेनकाङ्मोः तेम्मा रोता बिन्नान ङन पा जेङ्पा। <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />तैङर्‌वाङिन परमेस्वरन रोता अनै जेङ्पा, कन स्वर्गलै धुलधुल स्वाङ, रे सन्सारग झुनी बिङ्‌ङ।”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />सिमिवजै येसू र्‌वाबो, “प्रभु, अन रोता ङ्योअग एकुरो भिना।” <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />येसुई ख्युकाङ्मोः र्‌वाबो, “जिन्दगीन रोता ङा जेङ्पा। ङन स्याह् स्वानान गुसिनान मह्‌या, रे ङन लाह्ः बिस्वास खेनान हातौयै त्युबुल्नान मह्‌या। <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />जेङ्नै ङै ङेनकाङ्मोः र्‌वातपा ङिह्पा, ङेनजै ङाः रङ्पा ङ्याह्, जेङ्नै बिस्वास मखेँ। <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />पाई ङा बिन्नान सिमि पुरू ङन स्याह्‌ स्वानान ङ्याह्, रे ङन स्याह् स्वानान सिमी तैखेनै ङा मछ्यू। <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />जेँन इच्छ्या पुरा खेमः ङा स्वर्गलै धुलधुल स्वापा नङ्पा, जेङ्नै ङाः फेन्नान्न इच्छ्या पुरा खेचेन भिह्तु स्वापा जेङ्पा। <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />रे ङाः फेन्नान्न इच्छ्या अन जेङ्पा, कि नुई ङाः बिम्पान सिमिवन बर्ग सुई र्‌वार्‌वा ङा ममोलायो, जेङ्नै ख्युकाङ्मोः अन्त्यन दिनग सोम्फानायो। <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />तैङर्‌वाङिन ङन पान इच्छ्या अन जेङ्पा, कि ङोह्जोः सेन्चे रे नुन लाह्ः बिस्वास खेनान पुरूजै मताह्‌नान्न झुनी धेरायो, रे ङा नू अन्त्यन दिनग सम्पु दोङ्नान ङ्युँ।”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />यहूदीव येसुन बिरोधग गनगन खेमः जाःबो। तैङर्‌वाङिन नुई र्‌वाबो, “स्वर्गलै धुलधुल स्वापान रोता ङाई जेङ्पा।” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />ख्युई र्‌वाबो, “तै अन योसेफन ङोह्जो, येसु नङ्पायौ? नुन पा रे माः ङ्योअ मस्योनान तै? चोँ नुई कुजुई ‘ङा स्वर्गलै धुलधुल स्वापा जेङ्पा’ र्‌वार्‌वा र्‌वाङ?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />येसुई ख्युकाङ्मोः झब बिम्बो, “ङेन राह्ङराङ्साः गनगन नख्या। <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />ङाः फेन्नान्न पाई मकान्ङिन सुई ङन स्याह् स्वा मतैनान, रे ङा नू अन्त्यन दिनग सम्पु सोल्नान ङ्युँ। <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />‘आलै ख्यु पुरूग परमेस्वरजै लन्नान ङ्याह्’ र्‌वार्‌वा भबिस्यबक्तावन किताबग सर्पा ङ्याह्। पुरू सुई पा लम ङ्याङ्‌ङ रे लह्ङ्‌ङ नु ङन स्याह् स्वानान।<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">यसै ५४:१३</ref></char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />पा सिमि सुई रङ्पा मह्‌या, नुई मात्र रङ्पा ङिह्पा, सु परमेस्वरलम स्वापा जेङ्पा, नुई पा रङ्पा ङिह्पा।” <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />“तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, सुई बिस्वास खेनान नुन ङ्याबो मताह्‌नान्न झुनी ङिह्पा। <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />ङा जिन्दगीन रोता जेङ्पा। <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />ङेन खेपुलवजै तये मीपान ठाउँग मन्न झानै ख्यु सिबो। <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />जेङ्नै स्वर्गलै धुलधुल स्वानान रोता अनै जेङ्पा, सुई अन झाँ अन सिह्‌नान मह्‌या। <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />स्वर्गलै धुलधुल स्वापा सम्पु रोता ङाई जेङ्पा। सुई अन रोता झाङिन अन एकुरोभरि सम्पु लुईनान। रे कन रोता ङा सन्सारन जिन्दगीन भिह्तु बिन्नान ङिह्पा, अन चन ङन ल्हो जेङ्पा।” <verse eid="JHN 6:51" /><verse number="52" style="v" sid="JHN 6:52" />तब यहूदीव राह्ङराङ्साः ल्होई र्‌वामः जाःबो, “अन सिमिजै कुजुई ङ्योअग जेँन ल्हो झा फानतैनौ?” <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />येसुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, ङेनजै सिमिन ङोह्जोन ल्हो मझाङिन, रे नुन कह मथुङ्‌ङिन ङेन ङ्याबो झुनी मराह्‌नान। <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />ङन ल्हो झानान रे कह थुङ्नान्न ङ्याबो मताह्‌नान्न झुनी ङिह्पा, रे अन्त्यन दिनग ङा नू सम्पु दोङ्नान ङ्युँ। <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />तैङर्‌वाङिन ङन ल्हो तेम्माई झायाप जेङ्पा, रे ङन कह तेम्माई थुङ्‌याप जेङ्पा। <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />ङन ल्हो झानान रे कह थुङ्नान चन ङन स्याह् लुईनान, ङा नुग लुईनान। <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />कुजुई सम्पु पाई ङाः फेप्पो, रे ङा पान कारनजै सोन्नान। उजुईखेखे ङा झानान सिमि यङ ङन कारनजै सोन्नान ङ्याह्। <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />स्वर्गलै स्वापा अन रोता झाःम नङ्पा, कन खेपुलवजै झानै सिसि होई। अन रोता झानान चन एकुरोभरि सोन्नान ङ्याह्।” <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />नुई अन ल्होई कफर्नहुमन आराधनालयग लनतौ र्‌वापा जेङ्पा।<verse eid="JHN 6:59" /></para>
  <para style="s">मताह्‌नान्न जिन्दगीन बचन</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />अन ताह्‌मी नुन चेलावन बर्ग लैजे र्‌वाबो, “अन बचन क्योङ्म ङ्याह्, सु अन ताह् तैनान?” <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />जेङ्नै नुन चेलाव अन्न भिह्तु गनगन खेपाई ङ्याह् र्‌वार्‌वा क्युई राह्‌राह्‌ येसुई ख्युकाङ्मोः र्‌वाबो, “तै ङन अन ल्होईजै ङेनकाङ्मोः बाधा बिम्पाई ङ्याह्‌यौ? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />ङेनजै सिमिन ङोह्जो खाः नु पहिली ङ्याह्, स्याह्‌ लिपाई खेपा रङ्‌ङिन तै राह्‌नान?<note caller="-" style="x"><char style="xo" closed="false">6:62 </char><char style="xt" closed="false"><ref loc="PSA 47:5">भजन ४७:५</ref></char></note> <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />झुनी बिन्नान परमेस्वरन आत्मा जेङ्पा, ल्होलै फाईदा तये मराह्‌नान। कन बचन ङै ङेन ङ्याबो र्‌वापा ङिह्पा, अनजै जिन्दगी बिन्नान्न आत्मा सङ्‌ङ। <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />जेङ्नै ङेन बर्ग बिस्वास मखेनान हाति ङ्याह्, बिस्वास मखेनान सुवा-सुवा जेङ्पा, रे नू धोका बिन्नान सु राह्‌नान ङ्याह् र्‌वार्‌वा येसु ङूलै यङ क्युई ङ्याह्।” <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />आलै नुई र्‌वाबो, “अन्नकारन ङै ङेनकाङ्मोः र्‌वापा ङ्याह्, यदि पा लम आङ मबिङ्‌ङिन सिमि सुई नुन स्याह् मतैनान।” <verse eid="JHN 6:65" /><verse number="66" style="v" sid="JHN 6:66" />अन्नकारन नुन चेलावन बर्ग लै ङिक च्योल्बो, रे नुन ङ्याबो वैचे ख्योवाबो। <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />येसुई च्योङेपा र्‌वाबो, “तै ङेन यङ ङाः ख्योवाख्योवा वैचेऊ?” <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />सिमोन पत्रुसजै झब बिम्बो, “हे प्रभु, ङ्योअ सुन स्याह्‌ वैचे? नान ङ्याबो बचन ङ्याह्, मताह्‌नान्न जिन्दगी जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">6:68 </char><char style="xt" closed="false"><ref loc="MAT 16:16">मत्ती १६:१६</ref>; <ref loc="MRK 8:29">मर्क ८:२९</ref>; <ref loc="LUK 9:20">लुक ९:२०</ref> </char></note> <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />रे ङ्योअजै बिस्वास खेपा ङिह्पा रे क्युई ङिह्पा, ङेन परमेस्वरन पबित्र ङोह्जो जेङ्पा।” <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />येसुई ख्युकाङ्मोः झब बिम्बो, “तै ङजै ङेनको च्योङेपाः दम्पा नङ्पा तै? ङेनकोन बर्ग तीपा चन सैतान<note caller="+" style="f"><char style="fr" closed="false">6:70 </char><char style="ft" closed="false">सैतान </char></note> जेङ्पा।” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />अन नुई सिमोन इस्करियोतन ङोह्जो यहूदान भारेः र्‌वापा ङ्याह्। तैङर्‌वाङिन च्योङेपान बर्ग तीपा राह्‌राह्‌ यङ येसू धोका बिम्म जाःपा ङ्याह्।<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">येसु रे नुन भाईव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />अन्न ङिक येसु गालीलगै तूचे खेबो, जेङ्नै नु यहूदियाग वैसुम मखेबो, तैङर्‌वाङिन यहूदी आङ खेनान्न सिमिव नू सच्‌चेन दाउग ङ्याह्। <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />ता यहूदीवन आती छ्युङ्नान्न तेवर ङेह्‌मै ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">लेवी २३:३४</ref>; <ref loc="DEU 16:13">कानुन १६:१३</ref></char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />अन्नकारन येसुन भाइवजै नू र्‌वाबो, “अन ठाउँ ख्योवाख्योवा यहूदिया वया। रे नाई खेपाई रह्पान धोनव नान चेलावजै र्‌वार्‌वा रँयो। <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />कन सिमिजै मिह्‌नकै देस्सुम खेँ, नुई फाक धोन मखेनान। ङेन अन धोनव खेङिन जेँग सन्सारग थना।” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />तैङर्‌वाङिन नुन थिक्‌कोवजै नुन लाह्ः बिस्वास मखेँ। <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङन र्‌वापालैम भेला हेँ स्वापा मह्‌या। जेङ्नै ङेन भिह्तु ता भेला पुरू र्‌वापालैम ङ्याह्। <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />सन्सारजै ङेनकाङ्मोः ङान्ज्यान खे मतैनान, जेङ्नै ङा ता ङान्ज्यान खेँ। तैङर्‌वाङिन सन्सारन भारेः नुन धोनव अलः ङ्याह् र्‌वार्‌वा ङा साँचि बिन्चे। <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />ङेन अन तेवरग वया। ङा अन तेवरग मै। तैङर्‌वाङिन ङन भेला हेँ पुरा रह्पा मह्‌या।” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />ख्युकाङ्मोः झाःम र्‌वार्‌वा नु गालीलगै छ्युङ्बो।<verse eid="JHN 7:9" /></para>
  <para style="s">आती तेवरग येसु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />जेङ्नै थिक्‌कोव तेवरग वैमी येसु यङ हाकाहाकि नङ्पा, जेङ्नै फाक होई। <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />तेवरग यहूदी आङ खेनान्न सिमिवजै नू फाप्पाई ङ्याह्, रे “नु खाः ङ्याह्?” र्‌वार्‌वा लोङ्‌ङ।<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />मोङवन घूँ नुन भारेः चर्चा राम जाःबो। कानजै र्‌वाङ, “नु लः ङ्याह्।” घङजै र्‌वाङ, “नङ्पा, नुई सिमिकाङ्मोः भ्रमग थेप्पा ङ्याह्।” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />जेङ्नै यहूदी आङ खेनान्न सिमिवन ङिनङिन नुन भारेः सुई हाकाहाकि ल्होई र्‌वा मतैबो।<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />तेवरन घूँ येसु आराधनालयन झिङ जाःबो, रे लह्‌म्मः जाःबो।<verse eid="JHN 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 7:15" />यहूदी आङ खेनान्न सिमिवजै हालाईलाई झाम र्‌वाबो, “तये छोए मलनलन नुई कुजुई अकेःन छोए देप्पो?” <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />तब येसुई झब बिमबिम ख्युकाङ्मोः र्‌वाबो, “ङन छोए ङनै नङ्पा, जेङ्नै परमेस्वरन जेङ्पा, सुई ङाः फेप्पो। <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />यदि कान सिमिजै परमेस्वरन इच्छ्या ङ्यानसुम खेङिन, ङन छोए परमेस्वरन तर्फलम जेङ्पा, कि ङन जेँन तर्फलम जेङ्पा अन नुई क्युई राह्‌नान ङ्याह्। <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />सुई जेँनै तर्फलम ल्होई र्‌वाङ, नुई जेँनै सम्मान फान्नान, जेङ्नै सुई जेँग फेन्नान्न सम्मान फाङ्‌ङ, अन तेम्मा जेङ्पा, रे नुग छल तये मराह्‌नान। <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />तै मोसाई ङेनकाङ्मोः कानुन मबिम्बोयौ? जेङ्नै ङेन सुई अन कानुन मङ्याङ्‌ङ। ङेन तैङ ङाः सच्‌चे फान्नान?” <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />मोह्ङजै झब बिम्बो, “नाः मुई सेम्पा ङ्याह्। सुई नाः सच्‌चेन हिम्मत खेँ?” <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />येसुई झब बिमबिम ख्युकाङ्मोः र्‌वाबो, “ङै हालाईचेन धोनदी खेपा, आलै ङेन पुरू अनग हालाईङ। <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />मोसाई ङेनकाङ्मोः खतनान लुह्ः बिम्पा ङ्याह्। (जेङ्चे ता, अन मोसान तर्फलम ता नङ्पा, जेङ्नै खेपुलवलम जेङ्पा,) रै नाह्‌न ल्हाः ङेन चोलोङ्चा खतना खेँ।<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="GEN 17:10-13">उत १७:१०-१३</ref>; <ref loc="LEV 12:3">लेवी १२:३</ref></char></note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />मोसान कानुन भङग नराःयो र्‌वार्‌वा यदि कान सिमिजै नाह्‌न ल्हाः खतना खेङिन, ङै सिमि तीपा नाह्‌न ल्हाः पुरू ताःफाम्पा र्‌वार्‌वा तै ङेन ङन ङ्याबो सुतूनौ?<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">यूह ५:९</ref></char></note> <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />ध्वा सेनसेन न्याय नख्या, जेङ्नै लः खेखे न्याय ख्या।”<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="ISA 11:3">यसै ११:३</ref>; <ref loc="JHN 8:15">यूह ८:१५</ref></char></note><verse eid="JHN 7:24" /></para>
  <para style="s">तै अन मसिह जेङ्पौ?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />यरूसलेमन कान-कान सिमिवजै र्‌वाबो, “तै नु नुई नङ्पाऊ, सू यहूदी आङ खेनान्न सिमिवजै सच्‌चे फाङ्‌ङ? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />सेह्‌ना, नु ता हाकाहाकि ल्होई र्‌वापाई ङ्याह्, जेङ्नै ख्यु नू तये मर्‌वाङ! तै नुई मसिह जेङ्पा र्‌वानान अगुवाकाङ्मोः तेम्माई क्युई रह्बोयौ? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />जेङ्नै जब मसिह स्वानान, नु खालै स्वानान र्‌वार्‌वा सुई क्युई राह्‌नान मह्‌या। ङ्योअ पुरूग क्युई ङिह्पा अन सिमि खालै स्वापा जेङ्पा।”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />तब येसुई यरूसलेमन आराधनालयग लन्तौ, नुई केह्ः किमई र्‌वाबो, “ङेन ङाः स्योङ, रे ङा खालै स्वापा जेङ्पा, अन यङ क्युई ङ्याह्। ङा जेँनै इच्छ्याई स्वापा नङ्पा, जेङ्नै सुई ङाः फेप्पो नु तेम्मा ङिह्पा। ङेन नू मस्योँ, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />जेङ्नै ङा नू स्योःनान, तैङर्‌वाङिन ङा नु लम स्वापा जेङ्पा, रे नुई ङाः फेप्पा जेङ्पा।” <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />अन्नकारन ख्युई नू जुङ्चे फाप्पो, जेङ्नै सुई नुन लाह्ः लाह् मकह्बो, तैङर्‌वाङिन नुन भेला हेँ स्वातपा मह्‌या। <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />जेङ्नै मोङन लै सिमिवजै नुन लाह्ः बिस्वास खेबो। ख्युई र्‌वाबो, “जब मसिह स्वानान, तब तै नुई सिमिन खेरे ह्‌याल्म ताईलुवान धोन खेनान तै?”<verse eid="JHN 7:31" /></para>
  <para style="s">येसू जुङ्मः सिपाहीकाङ्मोः फेप्पा</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />मोह्ङजै येसुन भारेः चर्चा खेपा फरिसीवजै ताह्बो। तब ङोत्वा पुजारीव रे फरिसीवजै नू जुङ्मः आराधनालयन पालेकाङ्मोः फेप्पो। <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />अन्तौ येसुई र्‌वाबो, “ङा हेँ ङाईन बेर ङेन ङ्याबो ङिह्पा। आलै ङा ङाः फेन्नान्न स्याह् वैनान ङ्युँ। <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />ङेनजै ङाः फान्नान ङ्याह्, जेङ्नै दोःनान मह्‌या। रे खाः ङा राह्‌नान, स्याह् ङेन स्वा मतैनान।” <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />तब येहूदी आङ खेनान्न सिमिवजै राह्ङराङ्साः र्‌वाबो, “नु खाः वैमः जाःपा ङ्याह्, रे ङ्योअ नू दोःनान मह्‌या? तै नु ग्रीक सहरग तितरबितर राह्‌राह्‌ छ्युङ्पा यहूदीवन स्याह् वैवै ग्रीककाङ्मोः लनसुम खेँयौ? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />नुई र्‌वापा अन बचन तै जेङ्पा? ‘ङेन ङाः फान्नान ङ्याह्, जेङ्नै दोःनान मह्‌या, रे ङा खाः राह्‌नान, ङेन स्वा मतैनान?’”<verse eid="JHN 7:36" /></para>
  <para style="s">झुनी बिन्नान त्युन फु</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />ता तेवरन ङिस्योवान दिन, आथबा तेवरन ङोत्वा दिनग, च्याङच्याङ येसुई केह्ः किमई झाःम र्‌वाबो, “यदि सुई त्यु बुल्ङिन ङन स्याह्‌ स्वायो रे थ्वाःयो।<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="ISA 55:1">यसै ५५:१</ref></char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />सुई ङन लाह्ः बिस्वास खेँ, पबित्रसास्त्रजै र्‌वापान अन्सार ‘नुन समन झिङलै सम्पु त्युन स्योलाव गेग्गे वैनान ङ्याह्।’” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />जेङ्नै अन ल्होई नुई पबित्र आत्मान भारेः र्‌वापा ङ्याह्, कन पबित्र आत्मा नुन लाह्ः बिस्वास खेनानवजै देम्म जाःपा ङ्याह्। तैङर्‌वाङिन पबित्र आत्मा चोँन बेर बिम्पा मह्‌या, तैङर्‌वाङिन येसु महिमान भिह्तु हेँद्रि थीथी वप्पा मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">7:39 </char><char style="xt" closed="false"><ref loc="ISA 44:3">यसै ४४:३</ref></char></note><verse eid="JHN 7:39" /></para>
  <para style="s">सिमिवन घूँ दीचे मरह्पा</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />अन ल्होई ताह्‌नान कान-कान सिमिवजै र्‌वाबो, “नु ता तेम्माई भबिस्यबक्ता जेअँ।”<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ती २१:११</ref></char></note> <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />घङवजै र्‌वाबो, “नु मसिह जेङ्पा।” जेङ्नै कान-कानजै र्‌वाबो, “तै मसिह गालीललै स्वानान तै? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />तै पबित्रसास्त्रजै र्‌वापा मह्‌यायौ, कि मसिह दाऊदन सन्तानलम रे दाऊदनै सहर बेथलेहेमलै स्वानान।”<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="2SA 7:12">२ सामू ७:१२</ref>; <ref loc="MIC 5:2">मीका ५:२</ref></char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />अनजै येसुन कारन सिमिवन घूँ भाचे रह्पा। <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />ख्युन बर्ग हातिपाई नू जुङ्चे फाप्पो। जेङ्नै नुन लाह्ः सुई यङ लाह् मकह्बो।<verse eid="JHN 7:44" /></para>
  <para style="s">यहूदी आङ खेनान्न सिमिवन अबिस्वास</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />तब आराधनालयन पालेव रे ङोत्वा पुजारीव फरिसीवन स्याह्‌ स्वाबो। ख्युई अजोवग र्‌वाबो, “ङेनजै नू तैङ मसप्पा?” <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />आराधनालयन पालेवजै झब बिम्बो, “अन सिमिजै लैम ता सिमि सुई हातौयै ल्होई मर्‌वाबो!” <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />फरिसीवजै अजोवग र्‌वाबो, “ङेनकाङ्मोः र्‌वार्‌वा छकाई पप्पो कि तै वा? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />तै ङेन स्योःनौ अगुवाव आथबा फरिसीवन बर्ग सुई नुन लाह्ः बिस्वास खेपा ङिह्पा? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />जेङ्नै अन मोङ, सुई मोसान कानुन मस्योनान, अन परमेस्वरलम स्रापित ङिह्पा।”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />ख्युन बर्ग तीपा फरिसी सुन मिह्‌न निकोदेमस जेङ्पा, नु तीरेप येसुन स्याह् स्वापा ङ्याह्, नुई र्‌वाबो,<note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">यूह ३:१-२</ref></char></note> <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“तै ङिन कानुनजै ङू सिमिन भारेः मताह्‌रे आथबा नुई तै खेपा ङ्याह् अन क्युई मराह्‌रे नू न्याय खेनान तै?” <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />ख्युई नू झब बिम्बो, “तै ना रे गालीलन सिमि जेङ्पौ? पबित्रसास्त्र फाप्पे सेह्‌ना, रे नाई रङ्नान ङ्याह्, कि गालीललै भबिस्यबक्ता गेग्गे मस्वानान।” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />तब सिमि पुरू जे-जेँन यिम होई।<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">व्यभिचारग जुङ्पा चिमिचा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />जेङ्नै येसु जैतून धुरग होई। <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />नु नापपर्मै ह्‌याङ यरूसलेम आराधनालयग होई, रे सिमिव पुरू नुन स्याह्‌ स्वाबो, रे नु छ्युङ्बो, रे ख्युकाङ्मोः लह्‌म्बो। <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />कानुन लन्नान्न सिमि रे फरिसीवजै ब्यभिचारग जुङ्पा चिमिचादी सप्पो, रे नू घूँ सोल्बो। <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />ख्युई येसु र्‌वाबो, “गुरुज्यू, अन चिमिचा ब्यभिचार खेतौ जुङ्पा। <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />कानुनग मोसाई झाःम चिमिचाः लुङ्जै फ्याँ र्‌वार्‌वा ङी आग्या बिम्पा ङिह्पा। ङेन अन्न भिह्तु तै र्‌वानान?”<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="LEV 20:10">लेवी २०:१०</ref>; <ref loc="DEU 22:22-24">कानुन २२:२२-२४</ref></char></note> <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />जेङ्नै ख्युई नुन छोए सेन्चेन भिह्तु, रे नू आरोप खेतैङिम कि र्‌वार्‌वा झाम र्‌वापा ङ्याह्। येसुई खल्बु क्यापक्याप लाह्ःजुपजै साः सर्बो।<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />जेङ्नै जब ख्यु च्याङच्याङ नू लोप्पाई छ्युङ्बो, तब येसुई ख्युकाङ्मोः र्‌वाबो, “ङेन ङ्याबो सु तीपा मीपा ङिह्पा, नुई अन चिमिचा पहिली लुङ फ्याँयो।” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />आलै ह्‌याङ खल्बु क्यापक्याप नुई लाह्ःजुपजै साः सर्बो। <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />जेङ्नै जब ख्युई अन ताह्बो, तब किमलै वव्वै छ्युम थाल ती-ती खेखे होई, रे येसु मन चिमिचा ङ्याबो तितिमाई लुईबो, आलै अन चिमिचा चन नुन ङू च्याङ्पाई छ्युङ्बो। <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />येसुई मन चिमिचा सेनसेन र्‌वाबो, “ए चिमिचा, ख्यु खाः होई? तै सुई ना धल मबिम्पाऊ?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />येसुई र्‌वाबो, “प्रभु, सुई मबिम्बो।” नुई र्‌वाबो, “ङा यङ ना धल मबिन। वया, आलै ह्‌याङ तीपा नख्या।”]<verse eid="JHN 8:11" /></para>
  <para style="s">येसु, सन्सारन साल्म</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />येसुई ह्‌याङ फरिसीकाङ्मोः र्‌वाबो, “ङा सन्सारन साल्म जेङ्पा। ङन ङिक जाःनान नातुमा आउजाउ खेनान मह्‌या, जेङ्नै नुई जिन्दगीन साल्म देन्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्ती ५:१४</ref>; <ref loc="JHN 9:5">यूह ९:५</ref></char></note> <verse eid="JHN 8:12" /><verse number="13" style="v" sid="JHN 8:13" />तब फरिसीवजै नू र्‌वाबो, “ना जेँनै भिह्तु बयान बिम्पाई ङ्याह्। नान साँचि तेम्मा मराह्‌नान।”<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="JHN 5:31">यूह ५:३१</ref></char></note><verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />येसुई झब बिम्बो, “ङा जेँनै भिह्तु बयान बिन्चे, जेङ्नै ङन साँचि तेम्मा ङिह्पा। ङा स्योःनान, ङा खालै स्वापा जेङ्पा, रे ङा खाः वैपाई ङिह्पा। जेङ्नै ङेन मस्योनान, ङा खालै स्वानान, आथबा खाः वैपाई ङिह्पा। <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />ङेन सिमिन सेन्ताँलै न्याय खेनान। ङा सुई न्याय मखेनान। <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />ङै न्याय खेङिनै, ङन न्याय तेम्मा राह्‌नान। तैङर्‌वाङिन न्याय खेनान ङा तितिमाई मीपा, जेङ्नै ङा ङिह्पा, रे ङा फेन्नान पा ङिह्पा। <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />ङेन कानुनगै ङे सिमिन साँचि तेम्मा राह्‌नान र्‌वार्‌वा सर्पा ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="DEU 19:15">कानुन १९:१५</ref></char></note> <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />जेँन भारेः ङह् साँचि बिन्नान, रे ङा फेन्नान पाई ङन भारेः बयान बिन्नान।” <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />ख्युई नू र्‌वाबो, “नान पा खाः ङिह्पा?” येसुई झब बिम्बो, “ङेन न ता ङा स्योःनान न पा। ङेनजै ङा स्योपा राङिन ङन पाः र्‌वार्‌वा स्योःनान ङ्याह्।”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />अन ल्होईव येसुई यरूसलेमन आराधनालयग लन्तौ भेती काह्‌नान बकासन रह्‌म्म र्‌वापा जेङ्पा। आलै सुई येसू मजुङ्बो, तैङर्‌वाङिन नुन भेला हेँ स्वापा मह्‌या।<verse eid="JHN 8:20" /></para>
  <para style="s">ङा खाः वैनान ङेन वै मतैनान</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />येसुई ह्‌याङ ख्युकाङ्मोः र्‌वाबो, “ङा वैचे, रे ङेनजै ङा फान्नान ङ्याह्, रे ङेन जेँन तीपा सिह्‌नान ङ्याह्। खाः ङा वैनान, ङेन स्वा मतैनान।”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />यहूदी आङ खेनान्न सिमिवजै र्‌वाबो, “तै नुई जेँग सह्‌न्नौ? तैङर्‌वाङिन नुई ‘खाः ङा वैनान ङेन स्वा मतैनान’ र्‌वाङ।”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />आलै येसुई ख्युकाङ्मोः र्‌वाबो, “ङेन माह्ःन जेङ्पा। ङा तोन जेङ्पा। ङेन अन सन्सारन जेङ्पा। ङा अन सन्सारन नङ्पा। <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />ङै ङेनकाङ्मोः र्‌वापा, ‘ङेन जेँन तीपा सिह्‌नान ङ्याह्,’ तैङर्‌वाङिन ङा नुई जेङ्पा र्‌वार्‌वा ङेनजै बिस्वास मखेङिन जेँन तीपा सिह्‌नान ङ्याह्।”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />ख्युई येसु लोप्पो, “ना सु जेङ्पा?” नुई ख्युकाङ्मोः र्‌वाबो, “ङा नुई जेङ्पा, कन ङै ङेनकाङ्मोः ङूलै र्‌वायङ स्वापा ङिह्पा। <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />ङै ङेनकोन भारेः र्‌वाकोए रे न्याय खेकोए लै ङिह्पा। जेङ्नै ङाः फेन्नान तेम्मा ङिह्पा, रे नुनलम ङै तै ताह्पा अनै ल्होई ङा सन्सारग र्‌वानान।” <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />पान भारेः येसुई र्‌वापा जेङ्पा र्‌वार्‌वा ख्युई हामकोबो। <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />अन्नकारन येसुई र्‌वाबो, “जब ङेनजै सिमिन ङोह्जो तोह्ः सोल्नान ङ्याह्, ङा नुई जेङ्पा र्‌वार्‌वा ङेनजै हाकोनान ङ्याह्, रे ङा जेँनै आङग तये मखेनान, जेङ्नै पाई लम्पा ल्होईव र्‌वानान र्‌वार्‌वा स्योःनान ङ्याह्। <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />ङा फेन्नान ङन ङ्याबो ङिह्पा। नुई ङा तितिमाई ख्योवापा मह्‌या, तैङर्‌वाङिन ङा एकुरो नू स्याङ्फान्चेन धोन खेनान।” <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />येसुई अन ल्होई र्‌वातौ ङ्यान्नानव लैःजै नुन लाह्ः बिस्वास खेबो।<verse eid="JHN 8:30" /></para>
  <para style="s">तेम्मा ङेनकाङ्मोः स्वतन्त्र खेनान</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />येसुई जेँन लाह्ः बिस्वास खेनान यहूदीकाङ्मोः र्‌वाबो, “ङेन ङन बचनग लुईङिन ङेन तेम्माई ङन चेला जेङ्पा। <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />तब ङेनजै तेम्मा तै जेङ्पा अन क्युई राह्‌नान ङ्याह्, रे तेम्माजै ङेनकाङ्मोः स्वतन्त्र दोङ्नान ङ्याह्।”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />ख्युई येसू झब बिम्बो, “ङ्योअ अब्राहामन सन्तान जेङ्पा, रे चोँन बेर सुई राङ्पा रह्पा मीपा। ‘ङेन स्वतन्त्र राह्‌नान ङ्याह्’ र्‌वार्‌वा कुजुई र्‌वानान?”<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="MAT 3:9">मत्ती ३:९</ref>; <ref loc="LUK 3:8">लुक ३:८</ref></char></note><verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />येसुई ख्युकाङ्मोः झब बिम्बो, “तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, सुस्याङ तीपा खेनान नु तीपान राङ्पा जेङ्पा। <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />राङ्पा एकुरोभरि यिम मलुईनान, जेङ्नै ङोह्जो चन एकुरो यिम लुईनान।<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="GAL 4:30">गला ४:३०</ref></char></note> <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />अन्नकारन ङोह्जोई ङेनकाङ्मोः स्वतन्त्र दोङ्‌ङिन ङेन तेम्माई स्वतन्त्र राह्‌नान ङ्याह्। <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />ङाः क्युई ङिह्पा, ङेन अब्राहामन सन्तान जेङ्पा। जेङ्नै ङेन ङाः सच्‌चे फाङ्‌ङ, तैङर्‌वाङिन ङन बचनजै ङेन ङ्याबो ठाउँ मदेङ्‌ङ। <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />ङा ङन पाई थम्पा ल्होईन भिह्तु ल्होई र्‌वानान। जेङ्नै नान पाई र्‌वापा ल्होई ङेन खेनान।” <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />ख्युई नू र्‌वाबो, “ङ्योअन पा ता अब्राहाम जेङ्पा।” येसुई ख्युकाङ्मोः र्‌वाबो, “ङेन तेम्माई अब्राहामन सन्तान राङिन ता, ङेनजै अनै धोन खेनान ङ्याह् कन अब्राहामजै खेबो। <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />ङै परमेस्वरलम ताह्पा तेम्मा ङेनकाङ्मोः र्‌वापा ङिह्पा, जेङ्नै चोँ ङेन ङाः सच्‌चे फाङ्‌ङ। अब्राहामजै झाःम धोन मखेबो। <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />ङेन पाई तै खेपा ङेन अनै धोन खेनान।” ख्युई नू र्‌वाबो, “ङ्योअग ङेलू केह्पा नङ्पा! ङ्योअन पा तीबाःदि ङिह्पा, नु परमेस्वर जेङ्पा।”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />येसुई ख्युकाङ्मोः र्‌वाबो, “परमेस्वर ङेन पा राङिन ता ङेनजै ङा मया खेनान ङ्याह्, तैङर्‌वाङिन ङा परमेस्वरलम स्वापा। ङा जेँनै समजे स्वापा नङ्पा, जेङ्नै नुई ङा फेप्पो। <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />ङै र्‌वापा ङेन तैङ हामकोनान? तैङर्‌वाङिन ङेनजै ङन केह्ः ङ्यान मतैनान। <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />ङेनको जेँन पा सैतान्न जेङ्पा, रे ङेन पान इच्छ्या पुरा खेचे ङन लछे ङ्याह्। मन ता सुरुलै सिमि सन्नान ङ्याह्, रे तेम्मान ङ्याबो नू वास्ता तये मह्‌या। तैङर्‌वाङिन नुन स्याह् तेम्मा तये मह्‌या। जब नुई लबार ल्होई र्‌वाङ, नु जेँनै स्वभाऊ अन्सार ल्होई र्‌वानान, तैङर्‌वाङिन अन लबर्खा जेङ्पा रे लबारन पा जेङ्पा।<note caller="-" style="x"><char style="xo" closed="false">8:44 </char><char style="xt" closed="false"><ref loc="ACT 13:10">प्रे १३:१०</ref></char></note> <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />जेङ्नै ङा तेम्मा र्‌वानान, आलै ङेन ङा बिस्वास मखेनान। <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />ङा तीपान दोसी ङिह्पा र्‌वार्‌वा ङेन बर्ग सुई पर्मानित खेतैनौ? तेम्मा ल्होई र्‌वानान र्‌वाङिन तैङ बिस्वास मखेनान? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />सु परमेस्वर लम स्वाङ, नु परमेस्वरन बचन ङ्यान्नान। ङेन परमेस्वर लम स्वापा नङ्पा, अन्नकारन ङेन मङ्याङ्‌ङ।”<verse eid="JHN 8:47" /></para>
  <para style="s">येसु रे अब्राहाम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />यहूदीवजै येसू झब बिम्बो, “तै ङ्योअजै अन र्‌वापा तेम्मा नङ्पाऊ, कि ना सामरी जेङ्पा रे ना मुई सेम्पा ङ्याह्?” <verse eid="JHN 8:48" /><verse number="49" style="v" sid="JHN 8:49" />येसुई झब बिम्बो, “ङाः मुई सेम्पा मीपा, जेङ्नै ङा जेँन पान सम्मान खेनान, रे ङेन ङाः सम्मान मखेँ। <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />जेङ्नै ङा ङनै सम्मान मफान्नान, तीपा ङिह्पा सुई महिमा फान्नान रे न्याय खेनान। <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, यदि सुई ङन बचन ङ्याङ्‌ङिन नु हातौयै सिह्‌नान मह्‌या।” <verse eid="JHN 8:51" /><verse number="52" style="v" sid="JHN 8:52" />यहूदीवजै नू र्‌वाबो, “ता ङ्योअग तेम्माई क्युई रह्पा, नाः मुई सेम्पाई जेङ्पा। अब्राहाम सिह्बो, भबिस्यबक्ताव यङ सिह्बो, जेङ्नै ना र्‌वाङ, ‘सुई ङन बचन ङ्याङ्‌ङिन नु हातौयै सिह्‌नान मह्‌या।’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />तै ङ्योअन खेपुल अब्राहामन खेरे ना महान जेङ्पौ? नु सिह्बो, आलै भबिस्यबक्ताव यङ सिह्पा। ना चन जेँगै सु जेङ्पा र्‌वार्‌वा दाबि खेनान?” <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />येसुई झब बिम्बो, “यदि ङै जेँनै प्रसङ्सा खेङिन ङन प्रसङ्सा भाछ्योवा राह्‌नान। ङाः महिमा बिन्नान ङन पा ङिह्पा, सू ङेन ‘ङ्योअन परमेस्वर’ र्‌वाङ। <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />ङेनजै नू स्योपा मह्‌या, जेङ्नै ङा नू स्योःनान। ङा नू मस्योनान र्‌वाङिन ङा ङेनलैम लबर्खा ठहरी राह्‌नान ङ्युँ। जेङ्नै ङा नू स्योःनान, रे नुन बचन ङ्यान्नान। <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />ङेनकोन खेपुल अब्राहाम ङन दिन रङ्चेन भिह्तु मिह्दा स्याङ्पा ङ्याह्, रे नुई रङ्बो आलै स्याङ्बो।” <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />अन्नकारन यहूदीवजै नू र्‌वाबो, “ना हेँ फेराङसुमथल परा ताप्पा मह्‌या, रे तै नाई अब्राहामग रङ्पा ङिह्पाऊ?” <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />येसुई ख्युकाङ्मोः र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, अब्राहाम केह्पान खेरे ङूलै ङा ङिह्पा।” <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />तब ख्युई नू फ्याङ्चे र्‌वार्‌वा लुङ चाबो, जेङ्नै येसु पेरपेर आराधनालयलै खोलोः गेग्गे होई।<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">केतौलैन कानाः येसुई ताःफाम्पा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />स्याह्‌लै वैतौवैतौ येसुई तीपा केतौलैन काना चोलोङ्चाः रङ्बो। <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />नुन चेलावजै नू लोप्पो, “रब्बी, सुई तीपा खेबो, अनजै कि अन्न पोमाई, रे अन काना केह्बो?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />येसुई झब बिम्बो, “न ता अनजै तीपा खेबो न अन्न पोमाई, जेङ्नै अन अन्नकारनजै केह्तौलैन काना रह्पा कि परमेस्वरन सक्तिन धोन अन सिमिन जिन्दगी रँयो। <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />ङिजेन साल्म रातौ यङ ङाः फेन्नान्न धोनव ङ्योअजै खेत्वानान। नम्जे रुप्मी सुई र्‌वार्‌वा धोन खे मतैनान। <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />ङा सन्सारग रानबेर ङा सन्सारन साल्म जेङ्पा।”<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्ती ५:१४</ref>; <ref loc="JHN 8:12">यूह ८:१२</ref></char></note><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />अन ल्होई र्‌वार्‌वा नुई साः छिमा पप्पो, रे छिमाई सा मोलमोल धामा नुन मी छिम्बो। <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />आलै येसुई नू र्‌वाबो, “वया, सिलोआमको (कन्न अर्थ जेङ्पा, फेप्पा) पोखरी वैवै केवा।” नुई वैवै क्वबो, रे रङ्नान राह्‌राह्‌ होल्बो।<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="ISA 35:5">यसै ३५:५</ref></char></note> <verse eid="JHN 9:7" /><verse number="8" style="v" sid="JHN 9:8" />नुन खिम्जेःव रे नू भिख तोल्पा रङ्नानवजै र्‌वाबो, “लमग छ्युङछ्युङ भिख तोल्नान सिमि तै अन नङ्पाऊ?” <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />कान-कानजै र्‌वाबो, “अन नुई जेङ्पा।” घङजै र्‌वाबो, “नङ्पा, अन नुई लैम रँ।” नुई र्‌वाबो, “ङा नुई जेङ्पा।” <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />तब ख्युई नू लोप्पो, “ना कुजुई रङ तैनान रह्पा?” <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />नुई झब बिम्बो, “येसु र्‌वानान्न सिमिदीजै सान धामा दोङदोङ ङन मी छिनछिन ङाः र्‌वाबो, ‘सिलोआमग वया रे केवा।’ तब वैवै ङै क्योःपा, रे ङा रङ तैनान रह्पा।” <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />ख्युई नू र्‌वाबो, “नु खाः ङ्याह् न?” नुई र्‌वाबो, “ङा क्युई मीपा।”<verse eid="JHN 9:12" /></para>
  <para style="s">फरिसीवलम ताःफान्नान्न भिह्तु छोए सेन्नान</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />ङू काना रह्पा मन सिमी ख्युई फरिसीवन स्याह्‌ सप्पो। <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />कन्न दिन येसुई सान धामा दोङदोङ मन काना सिमी रङ तैनान दोङ्पा ङ्याह् अन नाह्‌न ल्हाः‌ ङ्याह्। <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />फरिसीवजै नू लोप्पो, “ना कुजुई रङ तैनान रह्पा?” नुई ख्युकाङ्मोः र्‌वाबो, “नुई ङन मी सान धामा छिम्बो, आलै ङै क्योःपा रे रङ तैनान रह्पा।”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />फरिसीवन बर्ग कान-कानजै र्‌वाबो, “अन सिमि परमेस्वरलम स्वापा नङ्पा, तैङर्‌वाङिन नुई नाह्‌न ल्हाः मङ्याङ्‌ङ।” जेङ्नै घङवजै र्‌वाबो, “कुजुई पापी सिमिजै झाम ताईलुवान धोनव खेतैनान?” रे ख्युन घूँ भाचे रह्पा। <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />ख्युई मन कानाः ह्‌याङ लोप्पो, “नुई नान मी रङ तैनान दोङ्‌दँ, ता नुन भारेः ना तै र्‌वाचे?” नुई झब बिम्बो, “नु भबिस्यबक्ता जेङ्पा।”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />रङ्चे देन्नान सिमिन पोमा घ्वाघ्वा मलोप्पान बेर यहूदी आङ खेनान्न सिमिवजै अन काना ङ्याह् रे रङ्नान रह्पान र्‌वार्‌वा बिस्वास मखेबो। <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />तब ख्युई काना सिमिन पोमा लोप्पो, “तै अन ङेन ङोह्जो जेङ्पौ सु काना केह्पा ङ्याह् र्‌वार्‌वा ङेन र्‌वाङ? ता कुजुई अन रङ तैनान रह्पा?” <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />नुन पोमाई ख्युकाङ्मोः र्‌वाबो, “ङि स्योःनान अन ङिन ङोह्जो जेङ्पा, रे काना केह्पा ङ्याह्। <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />जेङ्नै ता अन कुजुई रङ्नान रह्बो ङी क्युई मीपा, आथबा नुन मी सुई पोङ्बो अन यङ ङी क्युई मीपा। अन्न उमेर छिप्पी रह्पान ङ्याह्, अनगै ल्होरा। जेँन भारेः नुह्ँ ल्होई र्‌वानान ङ्याह्।” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />नुन पोमाई अन ल्होई र्‌वाबो, तैङर्‌वाङिन ख्यु यहूदी आङ खेनान्न सिमिव खेरे ङिह्ङ्‌ङ। तैङर्‌वाङिन सुई नू मसिह र्‌वार्‌वा स्वीकार खेङिन, नू यहूदी आराधनालयलै छ्युत्वानान र्‌वार्‌वा यहूदीव ङूई दीपा ङ्याह्। <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />अन्नकारन नुन पोमाई र्‌वाबो, “अन्न उमेर छिप्पी रह्पा ङ्याह्, नू ल्होरा।”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />तब ख्युई अन केतौलैन कानाः ङेरेप स्वा र्‌वार्‌वा रेनरुफानैफानै र्‌वाबो, “परमेस्वरन प्रसङ्सा ख्या। ङी क्युई ङिह्पा अन सिमि पापी जेङ्पा।” <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />नुई झब बिम्बो, “नु पापी जेम कि नम, ङा क्युई मीपा। ङा ल्होईदी मात्र क्युई ङिह्पा कि ङा काना ङ्याह्, जेङ्नै ता रङ्नान।” <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />तब ख्युई नू र्‌वाबो, “नुई ना तै खेबो? नुई नाः कुजुई रङ तैनान दोङ्बो?” <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />नुई ख्युकाङ्मोः झब बिम्बो, “ङै ङेनकाङ्मोः ङू यङ र्‌वातपा, जेङ्नै ङेनजै मङ्याम्बो। ता ह्‌याङ तैङ ङ्यानसुम खेनान? ङेन यङ नुन चेला रासुम खेनान कि कुजु?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />ख्युई नू ङारैङारै र्‌वाबो, “ना पो नुन चेला जेङ्पा, जेङ्नै ङि ता मोसान चेला जेङ्पा। <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />ङ्योअग क्युई ङिह्पा मोसान ङ्याबो परमेस्वरजै ल्होई र्‌वापा ङ्याह्, जेङ्नै ङ्योअग क्युई मीपा अन सिमि चन खालै स्वापा जेङ्पा।” <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />अन सिमिजै झब बिमबिम ख्युकाङ्मोः र्‌वाबो, “कत्याम हालाईचेन ल्होई! नु खालै स्वापा जेङ्पा ङेन ङ्याबो क्युई मीपाऊ, जेङ्नै ङन मी नुई पोङ्बो। <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />ङ्योअग क्युई ङिह्पा कि परमेस्वर पापीवन ल्होई मङ्यान्नान, जेङ्नै परमेस्वरग ङिन्नान रे नुन इच्छ्या ङ्यान्नान सिमिन ल्होई परमेस्वरजै ङ्यान्नान।<note caller="-" style="x"><char style="xo" closed="false">9:31 </char><char style="xt" closed="false"><ref loc="PRO 15:29">हितो १५:२९</ref> </char></note> <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />सन्सारन सुरुलै झाम केह्पालैन काना सिमी सुई रङ तैनान दोङ्पा ल्होई हातौयै ताह्पा मीपा। <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />यदि अन सिमि परमेस्वरलम मस्वापा राङिन नुई तये खेतैनान मह्‌या।” <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />ख्युई नू झब बिमबिम र्‌वाबो, “ना ता तेम्माई तीपा केह्पा ङ्याह्, रे तै ता ना ङ्योअग लनसुम खेनौ?” आलै ख्युई नू यहूदी आराधनालयलै खोलोः छ्यूबो।<verse eid="JHN 9:34" /></para>
  <para style="s">आत्मान काना</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />ख्युई नू खोलोः छ्यूबो र्‌वानान येसुई ताह्बो, रे नू दोदो र्‌वाबो, “तै ना सिमिन ङोह्जोन लाह्ः बिस्वास खेनौ?” <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />नुई झब बिमबिम र्‌वाबो, “प्रभु, नु सु जेङ्पा? ङा नुन लाह्ः बिस्वास खेनान ङिह्पा?” <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />येसुई नू र्‌वाबो, “नाई नू रङ्पा ङिह्पाऊ, आलै नान ङ्याबो ल्होई र्‌वानान नुई जेङ्पा।” <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />तब नुई र्‌वाबो, “प्रभु, ङा बिस्वास खेचे, रे नुई नू ध्वाः खेबो।”<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />आलै येसुई र्‌वाबो, “ङा न्यायन भिह्तु अन सन्सारग स्वापा कि मरङ्नानवजै रँयो रे रङ्नानव चन काना राःयो।” <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />अन ल्होई ताह्ताह् नुन रह्‌म्म राह्‌नान फरिसीवन बर्ग कान-कानजै नू र्‌वाबो, “तै ङ्योअ रे काना जेङ्पौ?” <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेन काना जेङ्न ता तीपान दोसी राह्‌नान मह्‌या, जेङ्नै ङेन ‘ङ्योअग रङ्नान’ र्‌वाङ, अन्नकारन ङेन हेँ दोसी ङिह्पा।”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">ग्वाल्यान द्रिस्तान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />येसुई र्‌वाबो तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, “कन लूपा त्याःनान भङन झलालै झिङ मजाःङ, जेङ्नै घङक्याँलम चपचप जाःङ, नु चन खुम्पा रे च्यापा जेङ्पा, <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />जेङ्नै झलालै झिङ जाःनान चन लूपान ग्वाल्या ल जेङ्पा। <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />झला पोङ्नानजै नुन भिह्तु पोङ्नान, रे लूपावजै नुन केह्ः ङ्यान्नान, रे नुई जेँन लूपाकाङ्मोः मिह्‌न छ्युई-छ्युई कताङ्नान, आलै ख्युकाङ्मोः खोलोः वन्नान। <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />जब नुई जेँन लूपाकाङ्मोः पुरू खोलोः छ्यूछ्यू ताह्‌नान, नु ख्युन ङूह्ङूह् लेन्नान, रे लुपाव नुन ङिक जाःनान, तैङर्‌वाङिन ख्युई नुन केह्ः स्योःनान। <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />जेङ्नै मस्योपा सिमिन ङिक ख्यु मजानान, जेङ्नै नुन स्याह्‌लै ज्यार्नान ङ्याह्। तैङर्‌वाङिन मस्योनान सिमिन केह्ः ख्युई मस्योनान।” <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />येसुई ख्युकाङ्मोः अन द्रिस्तान्त र्‌वाबो, जेङ्नै नुई ख्युकाङ्मोः र्‌वापा ल्होईन अर्थ ख्युई हामकोबो।<verse eid="JHN 10:6" /></para>
  <para style="s">येसु ग्वाल्या ल</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />अन्नकारन येसुई ह्‌याङ ख्युकाङ्मोः र्‌वाबो, “तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, लूपावन झला ङाई जेङ्पा। <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />ङनखेरे ङू स्वानान पुरू खुम्पा रे च्यापाव जेङ्पा, जेङ्नै लूपावजै ख्युन ल्होई मङ्याम्बो।<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="JER 23:1">यर २३:१</ref>; <ref loc="JHN 10:27">यूह १०:२७</ref></char></note> <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />झला ङाई जेङ्पा, यदि सिमि सु ङा लम झिङ जाःङिन अन उद्धार देन्नान ङ्याह्, रे झिङ-खोलोः आउजाउ खेनान ङ्याह्, रे क्वा झाचे देन्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="PSA 118:20">भजन ११८:२०</ref></char></note> <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />“खुम्पा ता खुम, सह्‌म्मः रे मीपा दोङ्मः मात्र स्वानान। ङा ता ख्युई झुनी धेरायो, रे अन हाति र्‌वार्‌वा धेरायो र्‌वार्‌वा स्वापा।”<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />ङा ग्वाल्या लः जेङ्पा। ग्वाल्या लजै जेँन लूपावन भिह्तु जेँन परान थोन्नान।<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="PSA 23:1">भजन २३:१</ref>; <ref loc="ISA 40:11">यसै ४०:११</ref>; <ref loc="EZK 34:15">इज ३४:१५</ref></char></note> <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />ज्याला वव्वै ग्वाला खेनान्न सिमि चन लूपावन जेँनै ग्वाल्या लैम नङ्पा। नुई ता फारा स्वापा रङरङ लूपाकाङ्मोः ख्योवाख्योवा अन ज्यार्नान, रे फाराई लूपाकाङ्मोः झम्ति खेखे वन्नान, रे खातत्त्याग वैफान्नान। <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />अन ज्यार्नान, तैङर्‌वाङिन अन भारान सिमि जेङ्पा, नुई लूपान वास्ता तये मखेनान। <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />“ङा ग्वाल्या ल जेङ्पा, ङा जेँन लूपाकाङ्मोः स्योःनान, आलै ङन लूपावजै ङाः स्योःनान। <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />कुजुई पाई ङा स्योःनान, ङा पा स्योःनान, आलै ङा लूपावन भिह्तु जेँन जिन्दगी बिन्नान।”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती ११:२७</ref>; <ref loc="LUK 10:22">लुक १०:२२</ref></char></note> <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />“ङन घङ लूपा ङिह्पा, सु अन भङन नङ्पा। ख्युकाङ्मोः यङ ङै सत्त्वापा ङिह्पा, रे ख्युई ङन बचन ङ्यान्नान ङ्याह्, रे ख्यु मोह्ङदी राह्‌नान ङ्याह्, रे ग्वाल्या ती राह्‌नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ISA 56:8">यसै ५६:८</ref>; <ref loc="EZK 34:23">इज ३४:२३</ref>; <ref loc="EZK 37:24">३७:२४</ref></char></note> <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />पाई ङा अन्नकारन मया खेँ, तैङर्‌वाङिन ङा जेँन परान ह्‌याङ होलहोल वस्सुमजै थोच्‌चे। <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />सुई ङनलम ङन परान वतमतैनान, जेङ्नै ङा जेँनै समजे जेँन जिन्दगी बिन्नान। जेँन जिन्दगी बिन्नान्न आङ ङन ङ्याबो ङिह्पा, आलै ह्‌याङ वन्नान्न आङ रे ङन ङ्याबो ङिह्पा। अन आग्या ङै ङन पा लम देप्पा ङिह्पा।” <verse eid="JHN 10:18" /><verse number="19" style="v" sid="JHN 10:19" />अन बचन्न कारनजै यहूदीवन घूँ ह्‌याङ भाचे रह्पा। <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />ख्युन बर्ग लैजे र्‌वाङ, “अनग मुई सेम्पा ङ्याह्, रे अन युङ्पा ङ्याह्। ङेन अन्न ल्होई तैङ ङ्यान्नान?” <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />घङवजै र्‌वाङ, “मुई सेम्पा सिमिन ल्होई झाम मराह्‌नान। तै मुई काना सिमिन मी पोङ तैनान तै?”<verse eid="JHN 10:21" /></para>
  <para style="s">येसु अस्वीकार खेपा</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरूसलेमग परमेस्वरग आराधनालय थोन्नान्न तेवर ङ्याह्। अन गुन्जेन भेला ङ्याह्। <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />येसु यरूसलेम आराधनालयन झिङ सोलोमन्न नाह्पू तुह्ईतुह्ई छ्युङ्पा ङ्याह्। <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />यहूदीवजै नुन लिब्रुङक्याँ जोमजोम लोप्पो, “हातौन बेर ना ङ्योअग आच्यामाच्या नान्नान? ना मसिह जेङ्न ङ्योअग तेम्मा र्‌वा।”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />येसुई ख्युकाङ्मोः झब बिम्बो, “ङै ङेनकाङ्मोः र्‌वातपा ङिह्पा, जेङ्नै ङेन बिस्वास मखेँ। ङन पान मिह्‌नग तै धोन ङा खेँ, नुई ङन साँचि बिन्नान। <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />जेङ्नै ङेन बिस्वास मखेँ, तैङर्‌वाङिन ङेन ङन लूपावन बर्गन नङ्पा। <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />ङन लूपावजै ङन केह्ः ङ्यान्नान, रे ख्युकाङ्मोः ङा स्योःनान, रे ख्यु ङन ङिक स्वानान। <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />ख्युकाङ्मोः ङा मताह्‌नान्न झुनी बिन्चे, रे ख्यु हातौयै मीपा राह्‌नान मह्‌या, रे सुई ख्युकाङ्मोः ङन ल्हालै तलतल वन्नान मह्‌या। <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />ङन पाई मन ङाः बिम्पा ङिह्पा, नु पुरून खेरे महान ङिह्पा। पान ल्हालै सुई ख्युकाङ्मोः तलतल वत्तैनान मह्‌या। <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />पा रे ङा ती जेङ्पा।”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />अन ल्होई ताह्‌मी यहूदीवजै येसू फ्याङ्चे र्‌वार्‌वा लुङ चाबो। <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङै ङेनकाङ्मोः ङन पा लम लै धोन ल थम्पा, मन बर्ग कन धोन्न भिह्तु ङेन ङा लुङजे फ्याङ्सुम खेनान?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />यहूदीजै नू झब बिम्बो, “धोन लन भिह्तु ङ्योअ नाः लुङजै मफ्याङ्नान, जेङ्नै परमेस्वरन ल्हुई झपान कारन, तैङर्‌वाङिन ना सिमि राह्‌राह्‌ यङ जेँगै परमेस्वर दोङ्चे फाङ्‌ङ।”<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी २४:१६</ref></char></note> <verse eid="JHN 10:33" /><verse number="34" style="v" sid="JHN 10:34" />येसुई ख्युकाङ्मोः झब बिम्बो, कानुनग सर्पा अन्सार, “परमेस्वर र्‌वाङ, ङेन लाव जेङ्पौ?”<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">भजन ८२:६</ref> </char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />ङ्योअग क्युई ङिह्पा कि पबित्रसास्त्रजै र्‌वापा ल्होई मताह्‌नान्न जिन्दगीन भिह्तु तेम्मा जेङ्पा। रे परमेस्वरजै मन सिमिकाङ्मोः लाव र्‌वाबो, सू नुन ल्हो‌न बिम्पा ङ्याह्। <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />पाई ङाः दमदम सन्सारग फेप्पो। “ङा परमेस्वरन ङोह्जो जेङ्पा” र्‌वातौ कुजुई परमेस्वरन ल्हुई झपा राह्‌नान? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />यदि ङै ङन पान इच्छ्यान धोन खेपा मीपा र्‌वाङिन ङन लाह्ः बिस्वास नख्या। <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />जेङ्नै यदि ङा पान धोन खेँ जेङ्नै ङेन ङन लाह्ः बिस्वास मखेङिन अन धोनवन लाह्ः बिस्वास ख्या, रे ङेनजै क्युई रा तैनान ङ्याह् रे हाकोनान ङ्याह्, कि पा ङन ङ्याबो ङिह्पा रे ङा पान ङ्याबो ङिह्पा।<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />यहूदीवजै ह्‌याङ नू जुङ्चे फाप्पो, जेङ्नै नु ख्युन ल्हालै बुप्पो। <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />आलै नु ह्‌याङ यर्दन चाङ्पुन धिक्याँ मन ठाउँग होई, खाः यूहन्नाई पहिली बप्‌तिस्मा बिङ्‌ङ, रे नु स्याह्‌ई छ्युङ्बो। <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />लै सिमिव नुन स्याह् स्वामः जाःबो, रे ख्युई र्‌वाबो, “यूहन्नाई ताईलुवान धोन तये मखेबो, जेङ्नै यूहन्नाई नुन भारेः तयाः-हाति र्‌वापा ङ्याह् अन तेम्मा जेअँ।” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />आलै स्याह् लै सिमिवजै नुन लाह्ः बिस्वास खेबो।<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजरस सिह्बो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />लाजरस मिह्‌न्न सिमिदी खङ्पा ङ्याह्। नु मरियम रे नुन ति मार्थान नाम बेथानियान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="LUK 10:38-39">लुक १०:३८-३९</ref></char></note> <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />प्रभू मकेकुकेन कुम्म अत्तर छिनछिन नुन लेह् जेँन छमजै फ्याःनान्न मरियम अनै ङ्याह्। नुनै भाइ लाजरस खङ्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">यूह १२:३</ref></char></note> <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />अन मितिकोवजै येसुन स्याह् झाःम र्‌वार्‌वा ल्हो‌न कोर्बो, “प्रभु, सू ङेन मया खेनान, नु खँ।”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />जेङ्नै अन ताह्ताह् येसुई र्‌वाबो, “अन खङ्नान सिचेन भिह्तु नङ्पा, जेङ्नै अन परमेस्वरन महिमान भिह्तु जेङ्पा, ताकि अन्न लम परमेस्वरन ङोह्जोन प्रसङ्सा रायो।” <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />येसुई मार्था, नुन बहिनी रे लाजरसग मया खेँ, <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />जेङ्नै लाजरस खँ र्‌वानान ताह्ताह् येसु खाः ङ्याह्, हेँ ङेर्या स्याह्‌ई छ्युङ्बो। <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />आलै येसुई चेलाकाङ्मोः र्‌वाबो, “स्वा, ता ङ्योअग ह्‌याङ यहूदिया होलहोल वैमता।” <verse eid="JHN 11:7" /><verse number="8" style="v" sid="JHN 11:8" />चेलावजै नू र्‌वाबो, “रब्बी, चोङ्‌ङा यहूदीवजै नाः लुङजै फ्याङ्चे फाङ्‌ङ, रे तै ह्‌याङ ना स्याह्‌ई वैसुम खेनौ?” <verse eid="JHN 11:8" /><verse number="9" style="v" sid="JHN 11:9" />येसुई झब बिम्बो, “तै दिनग घन्ता च्योङे मराह्‌नान तै?” दिनग आउजाउ खेनानग मथ्वानान, तैङर्‌वाङिन नुई अन सन्सारन साल्म रङ्नान, <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />जेङ्नै छान्जे आउजाउ खेनान सिमि थ्वानान, तैङर्‌वाङिन छान्जे ता नुन ङ्याबो साल्म मराह्‌नान। <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />आलै नुई ख्युकाङ्मोः र्‌वाबो, “ङिन फुरी लाजरस आःपा ङ्याह्, जेङ्नै नू मिवालै सोल्मः ङा स्याह् वैचे।” <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />चेलावजै नू र्‌वाबो, “प्रभु, नु आःपा ङ्याह् र्‌वाङिन नु ताःनान ङ्याह्।”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />येसुई र्‌वापान अर्थ चन “लाजरस सितबो” र्‌वानान ङ्याह्। जेङ्नै चेलावजै चन लाजरस तेम्माई आःपा मात्र ङ्याह् र्‌वानान छुपा ङ्याह्। <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />येसुई ख्युकाङ्मोः ल खेखे र्‌वाबो, “लाजरस सिपा ङ्याह्। <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />ङेनजै बिस्वास ख्या र्‌वार्‌वा ङेनकोन खातिर ङा स्याह् मीपान कारन स्याङ्पा ङिह्पा। तै रानै ता ङि नुन स्याह् भै।”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />तब दिदुमस र्‌वानान थोमाई जेँन ङ्याबो रह्पान चेलाकाङ्मोः र्‌वाबो, “स्वा, ङि रे भै, रे नुनै ङ्याबो सीमता।”<verse eid="JHN 11:16" /></para>
  <para style="s">येसुन सम्पु ग्युर्नान रे जिन्दगी</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />जब येसु स्वा ताप्पो, तब लाजरसग तुह्‌र्सा नाम्पा लिर्या रातपा क्युई रह्पा। <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बेथानिया यरूसलेमलै ङेह्‌मः क्वाईमाल्‌ला किलोमितर सुमतौन ग्याङ्म ङ्याह्। <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />लै यहूदीव मार्था रे मरियमन स्याह् नुन भाईन भारेः ख्युकाङ्मोः सान्त्वना बिम्म स्वापा ङ्याह्।<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />येसु स्वायङ ङ्याह् र्‌वानान ताह्ताह् मार्था होई रे नू धोबो। जेङ्नै मरियम यिमै छ्युङ्बो। <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />तब मार्थाई येसू र्‌वाबो, “प्रभु, ना स्यीह् रह्पान राङिन ता ङन भाइ सिह्‌नान मह्‌या। <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />जेङ्नै ता रे ङाः क्युई ङिह्पा, नाई परमेस्वरन ङ्याबो तै तोल्नान, परमेस्वरजै नाः बिन्नान ङ्याह्।” <verse eid="JHN 11:22" /><verse number="23" style="v" sid="JHN 11:23" />येसुई नू र्‌वाबो, “नान भाइ ह्‌याङ सम्पु राह्‌नान ङ्याह्।” <verse eid="JHN 11:23" /><verse number="24" style="v" sid="JHN 11:24" />मार्थाई नू र्‌वाबो, “ङाः क्युई ङिह्पा, कि नु अन्त्यन दिन्न सम्पु ग्युर्नानग ह्‌याङ सम्पु राह्‌राह्‌ च्याङ्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="ACT 24:15">प्रे २४:१५</ref></char></note> <verse eid="JHN 11:24" /><verse number="25" style="v" sid="JHN 11:25" />येसुई नू र्‌वाबो, “सम्पु ग्युर्नान रे झुनी ङाई जेङ्पा। ङाः बिस्वास खेनान सिङिनै सम्पु राह्‌नान ङ्याह्। <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />आलै सोन्नान रे ङन लाह्ः बिस्वास खेनान पुरू हातौयै सिह्‌नान मह्‌या। तै ना अन बिस्वास खेनौ?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />नुई येसु र्‌वाबो, “जेङ्पा प्रभु, ङा बिस्वास खेनान, ना सन्सारग स्वानान मसिह, परमेस्वरन ङोह्जो जेङ्पा।”<verse eid="JHN 11:27" /></para>
  <para style="s">येसु दाबो</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />अकेः र्‌वार्‌वा मार्था होई, रे जेँन बहिनी मरियमग कताङ्‌कताङ्‌ सुतुक्‌क र्‌वाबो, “गुरुज्यू स्वा ताप्पो, रे नाः स्वा र्‌वाङ।” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />अन ताह्ताह् मरियम हतपत च्याङच्याङ येसुन स्याह् होई। <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />अन्न बेर येसु नामग स्वा ताप्पा मह्‌या, जेङ्नै नु स्याह्ई ठाउँग ङ्याह् खाः मार्थाई नू दोपा ङ्याह्। <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />यिम नू सान्त्वना बिम्म स्वापा यहूदीवजै मरियम हतपत च्याङच्याङ खोलोः वैपा रङरङ, नु मन तुह्‌र्साः दामः वैपा जेङ्पा र्‌वानान छुछु, नुन ङिक जाःबो।<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />जब मरियम येसु रह्पा ठाउँग स्वाबो रे नू रङ्बो, तब झाःम र्‌वार्‌वाई नु येसुन ल्हे ध्वा खेबो, “हे प्रभु, ना स्यीह् रह्पान राङिन ता ङन भाइ सिह्‌नान मह्‌या।” <verse eid="JHN 11:32" /><verse number="33" style="v" sid="JHN 11:33" />जब येसुई नू दापा रे नुन ङ्याबो स्वानान यहूदीव यङ दापा रङ्बो, तब नु समलै मिह्दा बैराः च्याङ्बो आलै लै तुँलाक्या रह्पा। <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />येसुई ख्युकाङ्मोः लोप्पो, “ङेनजै नू खाः लुम्पा ङ्याह्?” ख्युई नू र्‌वाबो, “प्रभु, स्वास्वा सेह्‌ना।” <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />येसु दाबो। <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />अन्नकारन यहूदीवजै र्‌वाबो, “सेह्‌ना, नुई नू हाति मया खेँ।” <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />जेङ्नै कान-कानजै र्‌वाबो, “तै कानाः रङ तैनान दोङ्नान नुई अन सिमी र्‌वार्‌वा सिपालै सोन फानतैनान मह्‌या तै?”<verse eid="JHN 11:37" /></para>
  <para style="s">येसुई लाजरसग सम्पु दोङ्बो</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />तब येसु ह्‌याङ मिह्दा तूँलाक्या राह्‌राह्‌ तुर्साः होई। अन तुह्‌र्सा पुदीग ङ्याह्। अन्न ङुर ती लुङजै कप्पा ङ्याह्। <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />येसुई र्‌वाबो, “लुङ परा।” सिपा सिमिन ति मार्थाई नू र्‌वाबो, “हे प्रभु, ताह्‌सुपन बेर ता अन रिह्खामः जाः तपा जेम्तौ, तैङर्‌वाङिन अन सिपा लिर्या रातबो।” <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />येसुई नू र्‌वाबो, “तै ङै ना र्‌वापा नङ्पाऊ, ‘नाई बिस्वास खेङिन परमेस्वरन महिमा रङ्नान ङ्याह्?’” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />ख्युई लुङ पप्पो। आलै येसुई ङ्यालक्याँ सेनसेन र्‌वाबो, “हे पा, ङा ङेन ङ्याबो धन्यवाद बिन्चे, तैङर्‌वाङिन ङेनजै ङन छ्याःफुल्पा ताह्बो। <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />ङा क्युई ङिह्पा, कि ङेनजै ङन छ्याःफुल्पा एकुरो ङ्यान्नान। जेङ्नै स्यीह् थाङथाङ छ्युङ्पा मोङ्न खातिर ङै अन र्‌वापा जेङ्पा, ताकि ङेनजै ङाः फेप्पा जेङ्पा र्‌वार्‌वा ख्युई बिस्वास ख्याःयो।” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />आलै अन ल्होई र्‌वामी येसुई केह्ः किमई फाईरा खेबो, “लाजरस, खोलोः गेग्गे स्वा।” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />अन सिपा सिमि नुन लाह्‌ रे लेह् पत्तीजै खीपागै रे नह्‌मी घोलाङजै च्योम्पागै खोलोः गेग्गे स्वाबो। येसुई ख्युकाङ्मोः र्‌वाबो, “नुन खीपा फोला, रे नू वैफाना।”<verse eid="JHN 11:44" /></para>
  <para style="s">येसुन बिरोधग सदेन्त्र</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती २६:१-५</ref>; <ref loc="MRK 14:1-2">मर्क १४:१-२</ref>; <ref loc="LUK 22:1-2">लुक २२:१-२</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />मरियमन स्याह् स्वापा लै यहूदीवजै येसुई खेपा धोन रङरङ नुन लाह्ः बिस्वास खेबो। <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />जेङ्नै ख्युन बर्ग कान चन फरिसीवन स्याह् होई, रे येसुई खेपा धोनव स्याप्पो। <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />तब ङोत्वा पुजारीव रे फरिसीवजै महासभान सदस्यकाङ्मोः घ्वाबो रे नू र्‌वाबो, “ता ङ्योअग तै खेचे? तैङर्‌वाङिन अन सिमि ता लै ताईलुवान धोनव खेपाई ङ्याह्। <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />अनग झामै ख्योवाङिन पुरूजै अन्न लाह्ः बिस्वास खेनान ङ्याह्, रे रोमी आङ खेनान्न सिमिवजै स्वास्वा ङ्योअन आराधनालय रे ङ्योअन देस ङ्योरुमग मीपा दोङ्नान ङ्याह्।”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />जेङ्नै ख्युन बर्ग तीपा, कैयाफा, सु मन पाह्‌ङन प्रधान पुजारी ङ्याह्, नुई ख्युकाङ्मोः र्‌वाबो, “ङेन ङ्याबो तये क्युई मह्‌या! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />लै देस मीपा राचेन खेरे बरु जनतान भिह्तु सिमिदी सिचेई ङेनकोन भलो ङ्याह् र्‌वार्‌वा ङेन हामकोँ।” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />अन नुई जेँनै लम र्‌वापा मह्‌या, जेङ्नै अन्न पाह्‌ङन प्रधान पुजारी रह्पान कारन देसन भिह्तु येसु सित्वानान र्‌वानान भबिस्यबानी र्‌वापा जेङ्पा। <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />देसन भिह्तु मात्र नुई अन र्‌वापा मह्‌या, जेङ्नै खास्या पुरू रह्पा परमेस्वरन सिमि ङ्याबो रूचेन भिह्तु अन र्‌वापा ङ्याह्।<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />अन्नकारनजै मन्न लाह्‌ःलै यहूदी आङ खेनान्न सिमिवजै येसु सच्‌चेन सदेन्त्र खेबो। <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />अन्नकारन येसु ह्‌याङ यहूदीवन घूँ हाकाहाकि आउजाउ मखेबो, जेङ्नै स्याह्‌लै सुनसान ठाउँन ङेह्‌मः रह्पान एफ्राइम र्‌वानान सहरग होई, रे स्याह् चेलावन ङ्याबो छ्युङ्बो। <verse eid="JHN 11:54" /><verse number="55" style="v" sid="JHN 11:55" />यहूदीवन निस्तार तेवर ङेह्‌मः ङ्याह्, रे नाम-नामलै लै सिमिव राह्ङराङ्साः छाङ्म दोङ्चे र्‌वार्‌वा निस्तार तेवरन सुरु राचेन ङू यरूसलेमग होई।<note caller="-" style="x"><char style="xo" closed="false">11:55 </char><char style="xt" closed="false"><ref loc="2CH 30:17">२ इति ३०:१७</ref></char></note> <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />तब ख्युई येसू फाप्पो, आलै ख्यु आराधनालयग च्याङ्तौ राह्ङराङ्साः र्‌वामः जाःबो, “ङेनकाङ्मोः कताःम लाई राँ, तै नु तेवरग स्वादरा?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />ङोत्वा पुजारीव रे फरिसीवजै चन येसु जुङ्मः नु खाः ङ्याह् र्‌वार्‌वा सुई क्युई राङिन ताह्फेरा र्‌वानान्न आग्या बिम्पा ङ्याह्।<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">बेथानियाग येसुन अभिसेग</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती २६:६-१३</ref>; <ref loc="MRK 14:3-9">मर्क १४:३-९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />निस्तार-तेवरन रूर्यान ङू येसु बेथानियाग स्वाबो। स्याह् लाजरस छ्युँ, सू येसुई सिह्पालै सम्पु दोङ्पा ङ्याह्। <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />ख्युई येसुन भिह्तु स्याह् ङ्याजेन ङ्योप्पा दोङ्बो। मार्थाई सेवा खेँ, आलै लाजरस चन नुन ङ्याबोई झाम छ्युङ्पावन बर्ग तीपा ङ्याह्। <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />तब मरियमजै लितर फेःतौ जतामसी छाङ्मन रिह् स्याम कुम्म अत्तर सस्सै येसुन ल्हेग दुप्पो, आलै नुन ल्हे जेँन छमजै फ्याबो, रे अत्तरन रिह् स्यामै यिम नाङ्बो।<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लुक ७:३७-३८</ref></char></note> <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />जेङ्नै येसुन चेलावन बर्ग तीपा, आथबा नू बिस्वासघात खेनान यहूदा इस्करियोतजै र्‌वाबो, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“अन मकेकुकेन कुम्म अत्तर क्याम सुम मुलन सिक्‌का र्युर्‌र्युई अन सोङ बिखारीकाङ्मोः तैङ मबिम्बो?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />जेङ्नै नुई बिखारीवन वास्ता खेखे अन र्‌वापा मह्‌या, तैङर्‌वाङिन नु खुम्पा ङ्याह्, रे सोह्ङन खुन्चा नुई नाह्ङ्‌ङ, आलै स्याह्‌लै खुचे खेँ।<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />तब येसुई र्‌वाबो, “नू तये नर्‌वा, ङन लुम्चेन-दिन्न भिह्तु नू अन नानफाना। <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />तैङर्‌वाङिन बिखारीव एकुरो ङेन ङ्याबो राह्‌नान, जेङ्नै ङा ता एकुरो ङेन ङ्याबो मराह्‌नान।”<note caller="-" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="DEU 15:11">कानुन १५:११</ref>; <ref loc="MRK 14:7">मर्क १४:७</ref></char></note><verse eid="JHN 12:8" /></para>
  <para style="s">लाजरसन बिरोधग सदेन्त्र</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />यहूदीवन मोङ किमदीजै येसु स्याह् ङिह्पा र्‌वानान क्युई रह्पा, रे नुन खातिरग मात्र नङ्पा, जेङ्नै नुई सिह्पालै सम्पु दोङ्पा लाजरसगै सेन्चे र्‌वार्‌वा ख्यु स्वापा ङ्याह्। <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />आलै ङोत्वा पुजारीवजै लाजरसगै सच्‌चेन योजना खेबो। <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />तैङर्‌वाङिन नुई खेखे लैः यहूदीवजै ख्युकाङ्मोः अस्वीकार खेईखेई येसुन ङ्याः बिस्वास खेमः जाःपा ङ्याह्।<verse eid="JHN 12:11" /></para>
  <para style="s">येसु क्यालक्याल यरूसलेमग जाःपा</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती २१:१-११</ref>; <ref loc="MRK 11:1-11">मर्क ११:१-११</ref>; <ref loc="LUK 19:28-40">लुक १९:२८-४०</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />घङ्न लाह् निस्तार तेवरग स्वानान मोङ किमै येसु यरूसलेमग स्वायङ ङ्याह् र्‌वानान ताह्बो, <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />रे सिमिव खजुरन धाव वव्वै नू स्वागत खेमः फाईरा खेईखेई गेप्पो, “झयजक्‌कार राःयो! धन्न परमप्रभुन मिह्‌नग स्वानान इस्राएलन झली!”<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">भजन ११८:२५-२६</ref></char></note> <verse eid="JHN 12:13" /><verse number="14" style="v" sid="JHN 12:14" />आलै पुँह्‌न तजादी दोदो येसु नुन लाह्ः चप्पो, कुजु पबित्रसास्त्रग सर्पा ङ्याह्, <verse eid="JHN 12:14" /><verse number="15" style="v" sid="JHN 12:15" />“सियोन्न चमेः, नङिना। सेह्‌ना, नान झली पूँह्‌न तह्जान लाह्ः चपचप स्वायङ ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जक ९:९</ref></char></note><verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />“अन ल्होईव येसुन चेलावजै ङू हामकोबो। जेङ्नै येसुन महिमा रामी अन ल्होई नुन भारेः पबित्रसास्त्रग सर्पा ङ्याह्, रे अन धोन नुन भिह्तु ख्युई खेपा जेङ्पा र्‌वार्‌वा ख्युई छुबो।”<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />येसुई लाजरसग तुह्‌र्सालै घ्वाघ्वा खोलोः सिह्पालै सम्पु दोङ्तौ नुन ङ्याबो ङिह्पान मोङन सिमिवजै नुन साँचि बिम्पाई लुईबो। <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />नुई अन हालाईचेन धोन खेपा ङ्याह् र्‌वार्‌वा ताह्पा राह्‌राह्‌ यङ मोङ नू धोमः वैपा ङ्याह्। <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />तब फरिसीवजै राह्ङराङ्साः र्‌वामः जाःबो, “सेह्‌ना, ङेन लम तये राह्‌नौ नङ। सन्सारै नुन ङिक जाःतबो!”<verse eid="JHN 12:19" /></para>
  <para style="s">कान ग्रीकवजै येसू फाप्पो</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />तेवरग आराधना खेनानवन बर्ग कान-कान ग्रीकव रे ङ्याह्। <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />ख्यु गालीलन बेथसेदा छ्युङ्नान फिलिपन स्याह् स्वास्वा झाःम र्‌वार्‌वा छ्याःफुल्बो, “गुरुज्यू, ङ्योअ येसू दोसुम ङिह्पा।”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फिलिपजै वैवै अन्द्रियासग र्‌वाबो, रे अन्द्रियास रे फिलिप ङ्योरुम वैवै येसु र्‌वाबो। <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />येसुई ख्युकाङ्मोः झब बिम्बो, “सिमिन ङोह्जोन महिमित राचेन भेला स्वा ताप्पा ङ्याह्। <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, रुन्जन्न गेल्‌ला सा छारछार मसिङिन अन तितिमाई लुईनान। जेङ्नै अन सिङिन नुई फल लै छ्यानान। <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />जेँन परानग मया खेनानजै अन मोल्नान, जेङ्नै जेँन परानग अन सन्सारग कत्याम छुनानजै चन मताह्‌नान्न जिन्दगीन भिह्तु अन ताह्ः खेखे नान्नान<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="MAT 16:25">मत्ती १६:२५</ref>; <ref loc="MRK 8:35">मर्क ८:३५</ref>; <ref loc="LUK 9:24">लुक ९:२४</ref>; <ref loc="LUK 17:33">लुक १७:३३</ref></char></note> <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />सुई ङन सेनताप खेङिन नु ङन ङिक जायो रे ङा खाः ङिह्पा, ङन सेवक यङ स्याह् ङन ङ्याबो राह्‌नान ङ्याह्। सुई ङन सेवा खेङिन पाई नुन सम्मान खेनान ङ्याह्।<verse eid="JHN 12:26" /></para>
  <para style="s">येसु जेँ सिचेन भिह्तु र्‌वापा</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“ता ङन परान बिचल्‌लि रह्पा ङिह्पा, रे ङा तै र्‌वाचे? ‘हे पा, ङा अन्न भेलालै सोमफाना’? नङ्पा, अन्न कारनजै ङा अन्न भेला थाल स्वा ताप्पा ङिह्पा। <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />हे पा, नान मिह्‌न्न महिमा ख्या।” तब स्वर्गलै झाम ती केह्ः स्वाबो, “ङै अन महिमा खेपा ङिह्पा, रे ह्‌याङ खेनान ङिह्पा।”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />स्याह् च्याङ्पा मोह्ङजै अन ताह्ताह् र्‌वाबो, “अन धू तिह्पा जेङ्पा!” घङवजै र्‌वाबो, “स्वर्गदुत नुन ङ्याबो ल्होई र्‌वापा जेङ्पा!”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />येसुई ख्युकाङ्मोः झब बिम्बो, “अन केह्ः ङन भिह्तु रह्पा नङ्पा, जेङ्नै ङेन भिह्तु जेङ्पा। <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ता अन सन्सारन न्याय राह्‌नान। अन सन्सारन ङोत्वा हाकिम खोलोः पन्नान ङ्याह्। <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />आलै ङा जब पिर्थीबिलै थीनान, ङा सिमि पुरूग जेँनक्याँ कान्नान ङ्युँ।” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />नु कुजुई सिह्‌नान, अन ताह् बिन्चेन भिह्तु नुई झाम र्‌वापा ङ्याह्।<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />मोह्ङजै येसु लोप्पो, “मसिह एकुरोभरि लुईनान र्‌वार्‌वा कानुन लम ङ्योअजै ताह्पा ङिह्पा। ना कुजुई र्‌वातैनान, सिमिन ङोह्जो थित्वानान रु? अन सिमिन ङोह्जो चन सु जेङ्पा?”<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">भजन ११०:४</ref>; <ref loc="ISA 9:7">यसै ९:७</ref>; <ref loc="EZK 37:25">इज ३७:२५</ref>; <ref loc="DAN 7:14">दान ७:१४</ref></char></note><verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />येसुई ख्युकाङ्मोः र्‌वाबो, “हेँ ङाईन बेर ताह्‌म ङेन ङ्याबो ङिह्पा। साल्म ङेन ङ्याबो रान बेर आउजाउ ख्या, ताकि नातुमाई ङेनकाङ्मोः नकबाःयो। सुई नातुमा आउजाउ खेङिन, नुई ङह् खाः वैपाई ङिह्पा, अन क्युई मराह्‌नान। <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जब थाल साल्म ङेन ङ्याबो ङिह्पा साल्म बिस्वास ख्या, रे ङेन ताह्‌मन सन्तान रा।” अन ल्होई र्‌वामी, येसु स्याह्‌लै होई, रे ख्युन लम पेर्बो।<verse eid="JHN 12:36" /></para>
  <para style="s">सिमिवन अबिस्वास</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />येसुई ख्युन ङू अकेःन ताईलुवान धोनव खेपा ङ्याह्, जेङ्नै ख्युई नुन लाह्ः बिस्वास मखेबो। <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />अन ङोत्वाखाईमे ङ्याह्, कि यसैया भबिस्यबक्तान बचन पुरा राःयो, “हे परमप्रभु, ङ्योअन ल्हो‌न सुई बिस्वास खेबो? आलै परमप्रभुन सक्ति सू थम्बो?” <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />अन्नकारन ख्युई बिस्वास खे मतैबो, तैङर्‌वाङिन यसैयाई ह्‌याङ अन यङ र्‌वापा ङ्याह्, <verse eid="JHN 12:39" /><verse number="40" style="v" sid="JHN 12:40" />“परमेस्वरजै ख्युकाङ्मोः रङ मतैनान दोङ्पा ङ्याह्, रे ख्युन सम क्योङ्म दोङ्दोङ् नाम्पा ङ्याह्, झामखेखे ख्युई मी नरँयो, आलै समजै हानकोवाःयो, तेमन्ता ख्यु होल्नान ङ्याह् रे ङै ख्युकाङ्मोः ताह् फानत्वानान।”<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">यसै ६:१०</ref></char></note><verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यसैयाई अन ल्होई र्‌वाबो, तैङर्‌वाङिन नुई येसुन महिमा रङ्बो, रे नुन भारेः र्‌वाबो।<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />जेङ्नै यहूदी अगुवावन बर्ग लैजे येसुन लाह्ः बिस्वास खेबो, जेङ्नै फरिसीवन ङिनङिन, रे ख्युई यहूदी आराधनालयलै छ्यूनान र्‌वार्‌वा ङिनङिन अन स्वीकार मखेबो। <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />तैङर्‌वाङिन परमेस्वरन प्रसङ्सान खेरे सिमिन प्रसङ्सा खेचे ख्यु ह्‌याल्म स्याँ।<verse eid="JHN 12:43" /></para>
  <para style="s">येसुन बचनलम न्याय</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />येसुई केह्ः किमई र्‌वाबो, “ङाः बिस्वास खेनानजै ङाः नङ्पा, जेङ्नै ङाः फेन्नान्न लाह्ः बिस्वास खेनान। <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />सुई ङाः रँ, नुई ङाः फेन्नानग रङ्नान। <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />ङा सन्सारग ताह्‌म राह्‌राह्‌ स्वापा ङिह्पा, ताकि ङन लाह्ः बिस्वास खेनान सुस्याङ नातुमा नलुयाःयो।” <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />“सुई ङन बचन ङ्यान्नान, रे मन मङ्याङ्‌ङिन, ङा नुन न्याय मखे। तैङर्‌वाङिन ङा सन्सारन न्याय खेमः स्वापा नङ्पा, जेङ्नै सन्सारग सोमफाम्मः स्वापा जेङ्पा। <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />ङाः बिस्वास मखेनान रे ङन ल्हो‌न स्वीकार मखेनान्न भिह्तु न्यायदिसदी ङ्याह्। कन बचन ङै र्‌वापा नुई अन्त्यन दिनग नुन न्याय खेनान ङ्याह्। <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />तैङर्‌वाङिन ङै जेँनै तर्फलम ल्होई मर्‌वापा, जेङ्नै ङै तै र्‌वा त्वानान तै जेङ्पा, रे तै र्‌वात्वानान जेङ्पा, ङा फेन्नान पा नजै ङा आग्या बिम्पा ङिह्पा। <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />ङा स्योःनान, कि नुन आग्या मताह्‌नान्न झुनी जेङ्पा। अन्नकारन ङा तै र्‌वानान, पाई ङा र्‌वापालैम र्‌वानान।”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">येसुई जेँन चेलावन लेह् थुबो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />निस्तार-तेवरन ङू अन सन्सारलै भिदा राह्‌राह्‌ पान स्याह्‌ वैचेन नुन भेला स्वा ताप्पो र्‌वानान येसू क्युई रह्पा, आलै सन्चारग रह्पा जेँन सिमिकाङ्मोः मया खेखे नुई ख्युकाङ्मोः अन्त्यन बेर मया खेबो।<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />येसु रे नुन चेलाव छान्जे ङ्योप्पा झातौ सैतानजै सिमोन्न ङोह्जो यहूदा इस्करियोतन समग नू जुङ्फान्चेन नावा ङूलै कातपा ङ्याह्। <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />पाई सक्ति पुरू नुन लाह्‌ग बिम्पा ङ्याह् रे नु परमेस्वरन तर्फलम स्वापा जेङ्पा रे परमेस्वरन स्याह्‌ई वैपाई ङ्याह् र्‌वानान ल्होई येसू क्युई रह्पा। <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />आलै नु ङ्योप्पा झातामी च्याङ्बो। रे खोलोःन घोलाङ तीक्याँ नान्नान ताबेलदी हाङग च्योम्बो। <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />तब नुई लमग त्यु हाल्बो रे चेलावन ल्हे थुम जाबो, रे जेँजै च्योम्पान ताबेलजै ख्युन ल्हे फ्याम जाबो। <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />जब नु सिमोन पत्रुसन स्याह्‌ स्वाबो, तब नुई येसू र्‌वाबो, “प्रभु, तै नाई ङन लेह् थुचेऊ?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />येसुई नू झब बिम्बो, “ङा तै खेँ नाः चोँ क्युई मह्‌या, जेङ्नै ङिक हाकोनान ङ्याह्।” <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />पत्रुसजै नू र्‌वाबो, “ङेनजै ङन ल्हे हातौयै थुत्वानान मह्‌या।” येसुई नू झब बिम्बो, “ङै मथुङिन ता ना ङन चेला राचे देन्नान मह्‌या।” <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />सिमोन पत्रुसजै नू र्‌वाबो, “हे प्रभु, ङन लेह् मात्र नङ्पा, जेङ्नै ङन थोप्पालै लेह् थालै थुवा।” <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />येसुई नू र्‌वाबो, “थु तपान सिमी लेह् नङ्म घङ तये थुमत्वानान, मन पुरू छाङ्म ङ्याह्। आलै ङेन छाङ्म ङ्याह् जेङ्नै पुरू ता नङ्पा।” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />तैङर्‌वाङिन नू बिस्वासघात खेनानग नुई स्योःतपा ङ्याह्, अन्नैकारन नुई र्‌वापा ङ्याह्, “ङेन पुरू छाङ्म मह्‌या।” <verse eid="JHN 13:11" /><verse number="12" style="v" sid="JHN 13:12" />ख्युन लेह् थुतामी जेँन खोलोःन घोलाङ गोनगोन नु ह्‌याङ छ्युङ्बो। तब येसुई ख्युकाङ्मोः र्‌वाबो, “तै ङेनकाङ्मोः क्युई ङिह्पाऊ, ङै ङेन भिह्तु तै खेपा?”<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="LUK 22:27">लुक २२:२७</ref></char></note> <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />ङेन ङाः “गुरु रे प्रभु” र्‌वाङ, अन ङेन ल र्‌वाङ, तैङर्‌वाङिन ङा नुई जेङ्पा। <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />ङा ङेनकोन प्रभु रे गुरु राह्‌राह्‌ यङ ङै ङेनकोन लेह् थुपा ङिङिन ङेनजै र्‌वार्‌वा तीजै-घङ्न लेह् थुत्वानान, <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />तैङर्‌वाङिन ङै ङेनकाङ्मोः ती उदाहरन बिम्पा ङिह्पा, रे कत्याम ङै ङेन भिह्तु खेपा, ङेनजै अन च्योआलैम ख्या। <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, राङ्पा जेँन मालिकन खेरे किम मराह्‌नान, आलै ल्हो‌न वन्नान ल्हो‌न कोर्नान्न खेरे किम मराह्‌नान।<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती १०:२४</ref>; <ref loc="LUK 6:40">लुक ६:४०</ref>; <ref loc="JHN 15:20">यूह १५:२०</ref></char></note> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />यदि ङेनकोजै अन तेम्मा ल्होई क्युई रह्बो रे मन धोन खेङिन, ङेनको धन्न राह्‌नान ङ्याह्।<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />ङै ङेन पुरून भारेः र्‌वापाई नङ्पा, ङै सू दम्पा जेङ्पा, नू ङा स्योःनान। जेङ्नै पबित्रसास्त्र पुरा राःयो र्‌वार्‌वा अन रह्पा, कि “ङनै रोता झानानजै ङन लाह्ः जेँन लात्ती सोल्बो।”<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन ४१:९</ref></char></note> <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />अन राचेन ङू चोँनै ङा ङेनकाङ्मोः र्‌वाचे, ताकि जब अन रामः स्वानान, ङा नुई जेङ्पा र्‌वार्‌वा ङेनकाङ्मोः बिस्वास रायो।<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="JHN 14:29">यूह १४:२९</ref></char></note> <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, “सू ङा फेन्नान, नू स्वीकारी खेनानजै ङाः स्वीकारी खेनान, आलै ङाः स्वीकारी खेनानजै ङाः फेन्ननग स्वीकारी खेनान।”<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती १०:४०</ref>; <ref loc="MRK 9:37">मर्क ९:३७</ref>; <ref loc="LUK 9:48">लुक ९:४८</ref>; <ref loc="LUK 10:16">लुक १०:१६</ref></char></note><verse eid="JHN 13:20" /></para>
  <para style="s">येसु बिस्वासघाति खेनान्न भिह्तु भबिस्यबानी</para>
  <para style="r">(<ref loc="MAT 26:20-25">मत्ती २६:२०-२५</ref>; <ref loc="MRK 14:17-21">मर्क १४:१७-२१</ref>; <ref loc="LUK 22:21-23">लुक २२:२१-२३</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />अन ल्होई र्‌वामी येसु आत्माग आत्ती रह्पा रे नुई साँचि बिमबिम र्‌वाबो, “तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेन बर्ग तीपाई ङा बैरीन लाह्‌ग जुङ्फान्नान ङ्याह्।” <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />येसुई सुन भारेः र्‌वापा जेङ्पा र्‌वार्‌वा क्युई मर्हारे चेलावजै तीपाई-घङग सेन्चे खेबो। <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />नुन चेलावन बर्ग येसुई मया खेनान चेला चन येसुन घूँ रेमरेम छ्युङ्पा ङ्याह्। <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />तब सिमोन पत्रुसजै नू लाःता खेखे लोप्पो, “नुई अन ल्होई सुन भारेः र्‌वापा जेङ्पा?” <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />येसुन घूँ उजुखेखे रेमरेम छ्युङ्पागै नुई नू लोप्पो, “प्रभु, नु सु जेङ्पा?” <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />येसुई झब बिम्बो, “सू ङा रोतान तुकरा सुपसुप बिन्नान, नु अनै जेङ्पा।” तब नुई रोतान तुकरा सुप्पो रे छ्युछ्यु अन सिमोन्न ङोह्जो यहूदा इस्करियोतग बिम्बो। <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />रोतान तुकरा वप्मी सैतान नुन झिङ जाःबो। तब येसुई नू र्‌वाबो, “ना तै खेचे ङ्याह्, अन खम्म ख्या।” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />तब येसुई तैङ नू झाम र्‌वाबो र्‌वार्‌वा ङ्योप्पा झाम छ्युङ्पाव सुई यङ हामकोबो। <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />तैङर्‌वाङिन कान-कानजै अन सोचि खेबो, कि यहूदान ङ्याबो सोह्ङन खुन्चा ङ्याह्, अन्नकारनजै येसुई नू तेवरन भिह्तु त्वायाप र्‌युयाःयो, आथबा नुई बिखारीकाङ्मोः तयाः भिनाःयो र्‌वापा जेङ्पा। <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />तब रोतान तुकरा वप्मी यहूदा स्करियोत तुरुन्तै खोलोः गेप्पो। अन्न भेला छान्जे रह्पा ङ्याह्।<verse eid="JHN 13:30" /></para>
  <para style="s">आग्या सार्बा</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />जब अन खोलोः होई तब येसुई र्‌वाबो, “ता सिमिन ङोह्जो महिमित रह्पा ङ्याह्, रे परमेस्वर नुन लाह्ः महिमित रह्पा ङ्याह्। <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />आलै यदि नुन लम परमेस्वरन महिमा थन्नान, तब परमेस्वर सिमिन ङोह्जोन महिमा ङन स्याह् थन्नान, रे नुई झाम तुरुन्तै खेनान ङ्याह्।” <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />“हे वैचा हो, ङाईन बेर ङा ङेन ङ्याबो ङिह्पा। ङेनजै ङा फान्नान ङ्याह्, रे कत्याम ङै यहूदी आङ खेनान्न सिमिकाङ्मोः र्‌वापा, ता ङेन ङ्याबो ङा र्‌वाचे, ‘खाः ङा वैपाई ङिह्पा, ङेन स्वा मतैनान।’”<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">यूह ७:३४</ref></char></note> <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />“ङा ङेनकाङ्मोः ती सार्बा आग्या बिन्चे: ङेन तीजै-घङग मया ख्या। ङेन ङ्याबो ङै कत्यामन मया खेपा ङिह्पा, ङेनजै र्‌वार्‌वा तीजै-घङग झामै मया ख्या।<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="JHN 15:12-17">यूह १५:१२-१७</ref>; <ref loc="1JN 3:23">१ यूह ३:२३</ref>; <ref loc="2JN 1:5">२ यूह ५</ref></char></note> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />यदि ङेनजै तीजै-घङ्ग मया खेङिन, अनै लम पुरूजै स्योःनान ङ्याह्, कि ङेन ङन चेलाव जेङ्पा।”<verse eid="JHN 13:35" /></para>
  <para style="s">येसुई पत्रुसन अस्वीकारन भारेः भबिस्यबानी</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />सिमोन पत्रुसजै नू र्‌वाबो, “हे प्रभु, ङेन खाः वैपाई ङिह्पा?” येसुई झब बिम्बो, “ना चोँ ङन ङिक स्वा मतैनान, जेङ्नै ङिक ना ङन ङिक स्वानान ङ्याह्।” <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />पत्रुसजै नू र्‌वाबो, “प्रभु, ङा तैङ चोँनै ङेन ङिक स्वा मतैनान? ङेन भिह्तु ङा जेँन परान बिन्नान ङिह्पा।” <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />येसुई झब बिम्बो, “तै ना जेँन परान ङन भिह्तु बिन्नान ङ्याह्‌यौ? तेम्माई ङा ना र्‌वाचे, नाई ङाः सुमरेप अस्वीकार मखेनान्न बेर काःपा तर्नान मह्‌या।”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">येसु पान स्याह् वैनान्न लम</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />येसुई जेँन चेलाकाङ्मोः झाम र्‌वाबो, “ङेन सम मछुप्पा नराःयो। ङेन परमेस्वरन लाह्ः बिस्वास खेनान, ङन लाह्ः यङ बिस्वास ख्या। <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />ङन पान यिम छ्युङ्पुव लै ङिह्पा। झाम मीम, ङा ङेनकाङ्मोः र्‌वानान तै, ङेन भिह्तु ठाउँ तयार खेमः ङा वैपाई ङिह्पा? <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />आलै वैवै ङै ङेन भिह्तु ठाउँ तयार खेमी ङा ह्‌याङ स्वानान ङिह्पा रे ङेनकाङ्मोः ङन ङ्याबो वन्नान ङिह्पा, रे ङा खाः ङिह्पा, स्याह्‌ ङेन यङ लुईनान ङ्याह्। <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />खाः ङा वैपाई ङिह्पा, ङेन स्याह्‌ वैनान्न लम स्योःनान।”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />थोमाई नू र्‌वाबो, “हे प्रभु, ङेन खाः वैयङ ङिह्पा, ङि क्युई मराह्‌नान, तब ङ्योअजै लम कुजुई स्योःचे?” <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />येसुई नू र्‌वाबो, “लम, तेम्मा रे जिन्दगी ङाई जेङ्पा। ङन लम नङ्म सुई पान स्याह् स्वा मतैनान। <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />ङेनजै ङाः स्योपा राङिन, ङन पाः र्‌वार्‌वा स्योःनान ङ्याह्। तान धेरा नू स्योःनान, रे नू रङ्पा ङिह्पा” <verse eid="JHN 14:7" /><verse number="8" style="v" sid="JHN 14:8" />फिलिपजै नू र्‌वाबो, “हे प्रभु, ङी पा थना। अकेः रान ङी ज्योनान।” <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />येसुई नू र्‌वाबो, “फिलिप, अकेःन बेर ङा ङेन ङ्याबो ङिह्पा, जेङ्नै नाई ङा मस्योनौ? सुई ङा रङ्पा ङिह्पा, नुई पा रङ्पा ङिह्पा। ना कुजुई र्‌वातैनान, ‘ङ्योअग पा थना?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />फिलिप तै ना बिस्वास मखेनौ?” ङा पान ङ्याबो ङिह्पा, रे पा ङन ङ्याबो ङिह्पा कन बचन ङा ङेनकाङ्मोः र्‌वानान, अन ङै ङन जेँनै आङग र्‌वापा नङ्पा जेङ्नै ङन ङ्याबो छ्युङ्नान पाई जेँन धोन खेनान। <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />ङाः बिस्वास ख्या, कि ङा पान ङ्याबो ङिह्पा, रे पा ङन ङ्याबो ङिह्पा, मर्हाङिन अन धोनवनै भिह्तु बिस्वास ख्या। <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, सुई ङा बिस्वास खेनान, नुई ङै खेपा धोन यङ खेनान ङ्याह्, रे मन खेरे किम धोन खेनान ङ्याह्, तैङर्‌वाङिन ङा पान स्याह्‌ वैपाई ङिह्पा। <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />ङेनजै ङन मिह्‌नग तै तोल्नै ङोह्जोन स्याह् पान महिमा रायो र्‌वार्‌वा ङा अन खेनान ङ्युँ। <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />ङेनजै ङन मिह्‌नग तयाः तोल्ङिन ङा खेनान ङ्युँ।<verse eid="JHN 14:14" /></para>
  <para style="s">पबित्र आत्मान रेनरुबो</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />ङेनजै ङाः मया खेङिन ङन आग्याव ल्होई ङ्यान्नान ङ्याह्। <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />रे ङा पाः छ्याःफुल्नान ङ्युँ, रे नुई ङेनकाङ्मोः घङ सल्‌ला बिन्नान्न सिमि बिन्नान ङ्याह्, रे नु ङेन ङ्याबो एकुरोभरिन भिह्तु छ्युङ्नान ङ्याह्। <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />नु तेम्मान आत्मा जेङ्पा, सू सन्सारजै स्वीकार खे मतैनान, तैङर्‌वाङिन सन्सारजै नू न ता रँ न स्योङ। ङेन नू स्योःनान, तैङर्‌वाङिन नु ङेन ङ्याबो छ्युङ्नान, रे नु ङेन ङ्याबो छ्युङ्नान ङ्याह्। <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />ङा ङेनकाङ्मोः तोक्या ख्योवानान मीपा। ङा ङेन स्याह्‌ ह्‌याङ स्वानान ङिह्पा। <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />ता ङाई बेरन ङिक सन्सारजै ङाः हातौयै रङ्नान मह्‌या। जेङ्नै ङेनजै ङाः रङ्नान ङिह्पा। ङा सम्पु रह्पान कारन, ङेन यङ सम्पु लुईनान ङ्याह्। <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />अन्न लाह् ङेनकाङ्मोः क्युई राह्‌नान ङ्याह् कि ङा ङन पान ङ्याबो ङिह्पा, रे ङेन ङन ङ्याबो, रे ङा ङेन ङ्याबो ङिह्पा। <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />“ङाः मया खेनान नुई जेङ्पा सुन ङ्याबो ङन आग्या ङ्याह् रे मन ङ्याङ्‌ङ। आलै ङा मया खेनानग ङन पाई मह्‌या खेनान। ङा नू मया खेनान ङ्युँ। रे ङा जेँगै नुन स्याह्‌ रङ्नान ङ्युँ।”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />यहूदाई (इस्करियोत चन नङ्पा) नू र्‌वाबो, “प्रभु, ङेनजै तै र्‌वापा, ङेन नगै ङ्योअग थन्नान रे सन्सारग चन नङ्पा?” <verse eid="JHN 14:22" /><verse number="23" style="v" sid="JHN 14:23" />येसुई नू झब बिमबिम र्‌वाबो, “सुई ङा मया खेनान, नुई ङन बचन ङ्यान्नान ङ्याह्। रे पाई नू मया खेनान ङ्याह्। रे ङ्योअग नुन स्याह्‌ स्वानान ङिह्पा, रे नुन ङ्याबो छ्युङ्नान ङिह्पा। <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ङा मया मखेनानजै ङन बचन मङ्यान्नान। कन बचन ङेन ताँ, अन ङन नङ्पा, जेङ्नै ङाः फेन्नान पान जेङ्पा। <verse eid="JHN 14:24" /><verse number="25" style="v" sid="JHN 14:25" />अन ल्होई ङा ङेन ङ्याबो लुईतौ यङ ङै ङेनकाङ्मोः र्‌वापा जेङ्पा। <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />जेङ्नै सल्‌ला बिन्नान्न सिमिजै, आथबा पबित्र आत्मा, सू पाई ङन मिह्‌नग फेन्नान ङ्याह्, नुई ङेनकाङ्मोः ल्होई पुरू लन्नान ङ्याह्, रे ङै ङेनकाङ्मोः र्‌वापा ल्होई पुरू ङेनकाङ्मोः ह्‌याका बिन्नान ङ्याह्। <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />सान्ति ङा ङेनकोन ङ्याबो ख्योवाचे। ङा जेँन सान्ति ङेनकाङ्मोः बिन्चे। सन्सारजै बिम्पालैम ङा ङेनकाङ्मोः मबिन। ङेनकोन सम छरा खेनान नराःयो रे नङिना। <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />ङै ङेनकाङ्मोः ‘ङा वैपाई ङिह्पा, रे ङेन स्याह् स्वानान’ र्‌वापा ङेनजै ताह्बो। ङेनजै ङा मया खेपा राङिन ङा पान स्याह्‌ वैयङ ङिह्पा र्‌वापा ताह्ताह् ङेन स्याङ्नान ङ्याह्, तैङर्‌वाङिन पा ङन खेरे महान ङिह्पा। <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />ता अन राचेन खेरे ङूई ङै ङेनकाङ्मोः र्‌वापा ङिह्पा, रे जब अन रामः स्वानान ङेनजै बिस्वास खेतयाःयो। <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />ङा ङेन ङ्याबो ता ह्‌याल्म ल्होई र्‌वानान मीह्, तैङर्‌वाङिन अन सन्सारन हाकिम स्वायङ ङ्याह्। ङन लाह्ः नुन सक्ति तये मह्‌या। <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />जेङ्नै ङा पाः मया खेनान, रे कत्याम पाई ङाः आग्या खेपा ङ्याह् झामखेखे खेनान र्‌वार्‌वा सन्सारग क्युई रायो। च्याँ, ङ्योअ स्यीह्‌लै भै”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">येसु तेम्मा धाव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“तेम्मा अङ्‌गुरन तङ्पु ङा जेङ्पा, रे ङन पा किसान जेङ्पा। <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />ङन ङ्याबो ङिह्पा धा पुरू सुई फल मछ्याःङ नुई नू थुम्नान। रे फल छ्यानान धा पुरूग हेँ ह्‌याल्म फल छ्याःयो र्‌वार्‌वा नुई थुम्नान। <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />ङै ङेनकाङ्मोः र्‌वापान बचनजै ङेन ङूई छाङ्म रातपा ङ्याह्। <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />ङान ङ्याबो छ्योवा, रे ङा ङेन ङ्याबो छ्युङ्नान। कुजुई धा अङ्‌गुरन तङ्पुन ङ्याबो मछ्युङ्‌ङिन अन जेँजै फल छ्या मतैनान, झामखेखे ङेन ङन ङ्याबो मछ्युङ्‌ङिन ङेनजै र्‌वार्‌वा फल छ्यामतैनान।”<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“अङ्‌गुरन बुता ङा जेङ्पा, ङेन चन धाव जेङ्पा। यदि सुई ङन ङ्याबो लुईङिन, रे ङा नुग लुईङिन, नुई फल लै छ्यानान। तैङर्‌वाङिन ङा लम भाभा ङेन तये खे मतैनान। <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />सुई सिमि ङन ङ्याबो मलुईङिन, अन धालैम खोलोः पन्नान, रे अन खार्नान। झाम धाव सिमिवजै रूनान, रे मेह्ग पन्नान, रे मन कोःनान। <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />ङेन ङन ङ्याबो छ्युँङिन, रे ङन बचन ङेन ङ्याबो लुईङिन, रे ङेनकाङ्मोः तै स्याँ तोला, रे अन ङेन भिह्तु राह्‌नान ङ्याह्। <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />ङेनजै फल लै छ्याछ्या ङन चेला जेङ्पा र्‌वानान पर्मानित खेङिन अनगै ङन पान महिमा राह्‌नान ङ्याह्।” <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />“पाई कुजुई ङा मया खेपा ङ्याह्, ङै र्‌वार्‌वा ङेनकाङ्मोः मया खेपा ङिह्पा। ङेन ङन मयाग छ्योवा। <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />यदि ङन आग्याव ङ्याङ्‌ङिन ङेन ङन मयाग छ्युङ्नान ङ्याह्, कुजुई ङै ङन पान आग्याव ङ्याम्पा ङिह्पा रे नुन मयाग छ्युङ्नान।”<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />ङै अन ल्होई ङेनकाङ्मोः अन्नकारन र्‌वापा ङिह्पा, कि ङन किम्म ङेन ङ्याबो रायो, रे ङेन किम्म हाति र्‌वार्‌वा रायो। <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />“ङन आग्या अनै जेङ्पा, कि ङै ङेनकाङ्मोः कुजुई मया खेपा, ङेनजै तीजै-घङग झामखेखेई मया ख्या।<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">यूह १३:३४</ref>; <ref loc="JHN 15:17">१५:१७</ref>; <ref loc="1JN 3:23">१ यूह ३:२३</ref>; <ref loc="2JN 1:5">२ यूह ५</ref> </char></note> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />जेँन फुरीवन भिह्तु जेँन परान बिन्चेन खेरे किम मया घङ सुईनै मराह्‌नान। <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />ङा ङेनकाङ्मोः कन आग्या खेँ, अन ङेनजै ङ्याङ्‌ङिन, ङेन ङन फुरी जेङ्पा। <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />तान धेरा ङा ङेनकाङ्मोः राङ्पा मर्‌वाचे, तैङर्‌वाङिन नुन मालिकजै तै खेँ र्‌वार्‌वा राङ्पाः क्युई राह्‌नान। जेङ्नै ङै ङेनकाङ्मोः फुरी र्‌वापा ङिह्पा, तैङर्‌वाङिन तै ङै ङन पा लम ताह्पा, ङै अन ङेन पुरूग स्याप्पा ङिह्पा। <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />ङाः ङेनजै मदम्बो, जेङ्नै ङै ङेनकाङ्मोः दम्पा रे ङेनकाङ्मोः दम्पा, कि ङेन वया, रे फल छ्या, आलै ङेन फल लुईपाई रायो। अन्नकारन ङेनजै पान ङ्याबो ङन मिह्‌नग तै तोल्दरा, नुई ङेनकाङ्मोः अन बिन्नान ङ्याह्। <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />ङा ङेनकाङ्मोः अन आग्या बिन्चे, कि ङेनजै तीजै-घङग मया ख्या।<verse eid="JHN 15:17" /></para>
  <para style="s">सन्सारजै चेलाकाङ्मोः मस्याङ्पा</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“यदि सन्सारजै ङेनकाङ्मोः मस्याङ्‌ङिन, ङेनकाङ्मोः क्युई रायो, कि ङेनकाङ्मोः मस्याङ्चेन खेरे ङू नुई ङाः मस्याङ्पा जेङ्पा। <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />यदि ङेन अन सन्सारन जेङ्‌ङिनता सन्सारजै ङेनकाङ्मोः जेँन सिमि छुछु मया खेनान ङ्याह्। जेङ्नै ङेन अन सन्सारन नङ्पा। ङेनकाङ्मोः सन्सारलै ङै दम्पा, अन्नकारन सन्सारजै ङेनकाङ्मोः मस्याँ। <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />ङै ङेनकाङ्मोः र्‌वापान बचन ह्‌याका झ्वा, ‘राङ्पा यिमन मालिक खेरे किम मराह्‌नान।’ ख्युई ङाः तेपफाङ्‌ङिन ङेनकाङ्मोः र्‌वार्‌वा तेपफान्नान ङ्याह्। ख्युई ङन बचन ङ्याङ्‌ङिन ङेनकोन बचन यङ ङ्यान्नान ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती १०:२४</ref>; <ref loc="LUK 6:40">लुक ६:४०</ref>; <ref loc="JHN 13:16">यूह १३:१६</ref></char></note> <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />जेङ्नै ख्युई अन ल्होई पुरू ङन मिह्‌न्न खातिर ङेनकाङ्मोः खेनान ङ्याह्, तैङर्‌वाङिन ख्युई ङाः फेन्नानग मस्योँ। <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />ङा मस्वापा जेङ्न रे ख्युकाङ्मोः मस्याप्पा जेङ्न ख्यु तीपान दोसी राह्‌नान मह्‌या, जेङ्नै ता ता जेँन तीपान भिह्तु ख्युन ङ्याबो बहाना तये मह्‌या। <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />सुई ङा ङान्ज्यान खेँ, नुई ङन पाः र्‌वार्‌वा ङान्ज्यान खेनान। <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />यदि घङ सुई मखेपान धोन ङै ख्युन घूँ मखेपा राङिन ख्यु तीपान दोसी राह्‌नान मह्‌या। जेङ्नै ता ख्युई ङा रे ङन पा ङ्योरुमग रङ्पा ङिह्पा रे ङान्ज्यान खेपा ङिह्पा। <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />जेङ्नै, कानुनग सर्पा अन केह्ः पुरा राचेन भिह्तु अन रह्पा ङ्याह्, ‘ख्युई ङा भाछ्योवा ङान्ज्यान खेबो।’<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 35:19">भजन ३५:१९</ref>; <ref loc="PSA 69:4">६९:४</ref>; <ref loc="PSA 109:3">१०९:३</ref></char></note><verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“जब सल्‌ला बिन्नान्न सिमि स्वानान, सू ङा पा लम ङेन स्याह्‌ फेन्नान ङिह्पा, आथबा तेम्मान आत्मा, सु पान लम स्वानान, नुई ङन भारेः साँचि बिन्नान ङ्याह्। <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />ङेन सुरुलै ङन ङ्याबो लुईपा राह्‌राह्‌, ङेन यङ ङन साँचि जेङ्पा।”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“ङै ङेनकाङ्मोः अन र्‌वापा ङिह्पा, अन्नकारन कि ङेनजै जेँन बिस्वास नख्योवाःयो। <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />ख्युई ङेनकाङ्मोः यहूदी आराधनालयलै छ्यूनान ङ्याह्। बास्तबग झाःमन भेला स्वायङ ङ्याह्, जब ङेनकाङ्मोः सन्नानजै परमेस्वरन सेवा खेयङ ङिह्पा र्‌वार्‌वा छुनान ङ्याह्। <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />ख्युई अन धोन खेनान ङ्याह्, तैङर्‌वाङिन ख्युई पाः स्योपा मह्‌या, रे ङन ङ्याबो मस्योँ। <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />जेङ्नै अन ल्होई ङै ङेनकाङ्मोः स्याप्पा ङिह्पा, कि जब अन भेला स्वानान, तब ङेनकाङ्मोः तै र्‌वापा ङ्याह् अन ङेनकाङ्मोः ह्‌याका राह्‌नान ङ्याह्। ङूई ङै ङेनकाङ्मोः अन ल्होई मर्‌वापा, तैङर्‌वाङिन ङा ङेनकाङ्मोः ङ्याबो ङ्याह्।”<verse eid="JHN 16:4" /></para>
  <para style="s">पबित्र आत्मान धोन</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“ता ङा ङाः फेन्नान्न स्याह्‌ वैईपाई छ्युङ्पा ङिह्पा, जेङ्नै ‘ङेन खाः वैनान?’ र्‌वार्‌वा ङेनको सुई ङाः मलोङ्‌ङ। <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />जेङ्नै ङै ङेनकाङ्मोः अन ल्होई र्‌वापान कारन ङेन सम बैरागजै नाङ्पा ङ्याह्। <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />जेङ्नै ङा ङेनकाङ्मोः तेम्मा ल्होई र्‌वाचे, ङा वैचेगै ङेन भलो ङिह्पा। तैङर्‌वाङिन ङा मवैङिन, सल्‌ला बिन्नान्न सिमि ङेन स्याह्‌ स्वानान मह्‌या। जेङ्नै वैङिन ङा नू ङेन स्याह्‌ फेन्नान ङिह्पा। <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />आलै जब नु स्वानान, नुई सन्सारग तीपा, तेम्मा रे न्यायन भारेः दोसी ठहर्याई खेनान ङ्याह्। <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />तीपान भारेः, ख्यु गलति ङ्याह् तैङर्‌वाङिन ख्यु ङन लाह्ः बिस्वास मखेँ, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />नुई परमेस्वरन ङू तै चन लः ङ्याह्, अनै थन्नान तैङर्‌वाङिन ङा पान स्याह् वैयङ ङिह्पा, रे ङेन ङाः ह्‌याङ रङ्नान मह्‌या। <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />रे न्यायन भारेः, तैङर्‌वाङिन अन सन्सारन हाकिमग ङूलै यङ दोसी थर्याई खेतपा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">16:11 </char><char style="xt" closed="false"><ref loc="JHN 12:31">यूह १२:३१</ref></char></note> <verse eid="JHN 16:11" /><verse number="12" style="v" sid="JHN 16:12" />“ङै ङेनकाङ्मोः र्‌वाचेन ल्होई हेँ लै ङ्याह्, जेङ्नै चोँ ङेन अन ल्होई कूमतैनान।”<verse eid="JHN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 16:13" />जब नु आथबा तेम्मान आत्मा स्वानान ङ्याह्, तब नुई ङेनकाङ्मोः पुरू तेम्माग र्‌वानान ङ्याह्। नु ङन लम र्‌वानान मह्‌या। नुई तै ताह्‌नान, अनै र्‌वानान ङ्याह्, रे राम स्वानान ल्होईव ङेनकाङ्मोः स्यान्नान ङ्याह्। <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />नुई ङन महिमा खेनान ङ्याह्, तैङर्‌वाङिन तै ङन जेङ्पा, अन ङनलम वव्वै ङेनकाङ्मोः स्यान्नान ङ्याह्। <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />हाति पान ङ्याबो ङ्याह्, अन ङन जेङ्पा। अन्नकारन ङै र्‌वापा, तै ङन जेङ्पा अन ङनलम वव्वै आत्माई ङेनकाङ्मोः बिन्नान रे स्यान्नान ङ्याह्।<verse eid="JHN 16:15" /></para>
  <para style="s">तूरि रे किम्म</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“ङाईन ङिक ङेनजै ङा ह्‌याङ रङ्नान मह्‌या, आलै ङाईन ङिक ङा ह्‌याङ रङ्नान ङ्याह्।”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />तब नुन कान-कान चेलावजै तीजै-घङग र्‌वाबो, “नुई ङ्योअग अन तै र्‌वापा जेअँ? ‘ङाईन ङिक ङेन ङा रङ्नान मह्‌या, आलै ह्‌याङ ङाईन ङिक ङेन ङा रङ्नान ङ्याह्,’ रे ‘तैङर्‌वाङिन ङा पान स्याह्‌ वैनान’।” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />ख्युई र्‌वाबो, “नुई ‘ङाई बेर’ र्‌वापान अर्थ तै जेङ्पा? ङी क्युई मीपा, नु तै र्‌वाङ।” <verse eid="JHN 16:18" /><verse number="19" style="v" sid="JHN 16:19" />चेलावजै नू लोस्सुम खेँ र्‌वानान येसु क्युई रह्बो, रे नुई र्‌वाबो, “‘ङाईन ङिक ङेन ङाः रङ्नान मह्‌या आलै ङाईदिन ङिक ङा रङ्नान ङ्याह्’ र्‌वानान ल्होईन धा तै जेङ्पा र्‌वानान भारेः तै ङेन राह्ङराङ्साः ल्होई र्‌वापाई ङिह्पाऊ? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />तेम्माई, ङा ङेनकाङ्मोः र्‌वाचे, ङेन दोःनान ङ्याह् रे समतूई दानान ङ्याह्, जेङ्नै सन्सार स्याङ्नान ङ्याह्। ङेन उदास राह्‌नान ङ्याह्, जेङ्नै ङेनकोन बैराग किम्मः फिन्नान ङ्याह्। <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />वैचा केह्तौ चिमिचा झर राह्‌नान तैङर्‌वाङिन नुन भेला स्वापा राह्‌नान, जेङ्नै जब नुई वैचा केह्‌नान, तब नू अन झरन ह्‌याका मराह्‌नान तैङर्‌वाङिन सन्सारग ती वैचा केह्बो र्‌वानान ल्होईग नु स्याङ्नान।<note caller="-" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="ISA 26:17">यसै २६:१७</ref>; <ref loc="MIC 4:9">मीका ४:९</ref></char></note> <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />झामखेखेई चोँ ङेनकाङ्मोः समतु राह्‌नान, जेङ्नै ङा ह्‌याङ ङेनकाङ्मोः रङ्नान ङिह्पा, रे ङेन सम किम्म राह्‌नान ङ्याह्। आलै सुई ङेन किम्म ङेन लम तल्नान मह्‌या।”<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />“जब अन दिन स्वानान। ङेनजै ङा तये लोन्नान मह्‌या। तेम्माई ङा ङेनकाङ्मोः र्‌वाचे, ङेनजै ङन मिह्‌नग पान ङ्याबो तै तोल्नान, नुई अन ङेनकाङ्मोः बिन्नान ङ्याह्। <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />चोँनबेर ङेनजै ङन मिह्‌नग तये तोल्पा मह्‌या। तोला, आलै ङेनजै देन्नान ङ्याह्। झामखेखे ङेन किम्म पुरा रायो।”<verse eid="JHN 16:24" /></para>
  <para style="s">सन्सारन लाह्ः क्याल्पा</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“अन ल्होई ङै ङेनकाङ्मोः द्रिस्तान्तग र्‌वापा ङिह्पा। जेङ्नै भेला स्वायङ ङ्याह्, जब ङा ङेन ङ्याबो ह्‌याङ द्रिस्तान्तग ल्होई र्‌वानान मह्‌या, जेङ्नै पान भारेः ङेनकाङ्मोः ल खेखे स्यान्नान ङ्युँ। <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />अन्न लाह् ङेनजै ङन मिह्‌नग तोल्नान ङ्याह्। ङा ङेन भिह्तु पा छ्याःफुल्नान ङ्युँ र्‌वार्‌वा ङेनकाङ्मोः मर्‌वा, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />तैङर्‌वाङिन पा जेँजै ङेनकाङ्मोः मया खेँ, तैङर्‌वाङिन ङेनजै ङा मया खेपा ङिह्पा, रे ङा परमेस्वर लम स्वापा र्‌वार्‌वा बिस्वास खेपा ङिह्पा। <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />ङा पान लम स्वापा, आलै सन्सारग स्वापा ङिह्पा, रे ह्‌याङ ङा सन्सारग ख्योवाख्योवा पान स्याह्‌ वैयङ ङिह्पा।”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />येसुन चेलावजै र्‌वाबो, “ता ङेन मङी खेखे र्‌वाङ, द्रिस्तान्तग नङ्पा। <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />ता ङी हाकोपा, ङेनग तैस्याङ पुरू क्युई ङ्याह्, आलै ङेनग सुई मलोईखाईमे मह्‌या। अन्नकारन ङि बिस्वास खेनान, कि ङेन परमेस्वर लम स्वापा जेङ्पा।”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />येसुई ख्युकाङ्मोः झब बिम्बो, “तै ङेन ता बिस्वास खेनौ? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />सेह्‌ना, भेला स्वायङ ङ्याह्, तेम्माई स्वातपा ङ्याह्, जब ङेन छरपस्त राह्‌राह्‌ जेँनै यिम वैनान ङ्याह् रे ङाः तितिमाई ख्योवानान ङ्याह्। जेङ्नै ङा तितिमाई मीपा, तैङर्‌वाङिन पा ङन ङ्याबो ङिह्पा।<note caller="-" style="x"><char style="xo" closed="false">16:32 </char><char style="xt" closed="false"><ref loc="JHN 8:29">यूह ८:२९</ref></char></note> <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />ङेनको ङन स्यीह् छ्युङ्छ्युङ् किम्म धेत्तया र्‌वार्‌वाई ङै ङेनकाङ्मोः अन ल्होई पुरू र्‌वापा जेङ्पा। सन्सारग ङेनकाङ्मोः तूरि राह्‌नान ङ्याह्, जेङ्नै हिम्मत ख्या, ङै सन्सारग क्याल्पा ङिह्पा।”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">चेलावन भिह्तु येसुन सोअताप</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />अन ल्होई र्‌वातामी येसुई स्वर्गक्याँ सेनसेन र्‌वाबो, “हे पा, भेला स्वातपा ङ्याह्, ङेन ङोह्जोन महिमा थना, रे ङोह्जोई ङेन महिमा थनाःयो। <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />तैङर्‌वाङिन ङेनजै नू सिमि पुरून लाह्ः आङ बिम्पा ङिह्पा, ताकि ङेनजै नू बिम्पा सिमि पुरूग नुई मताह्‌नान्न झुनी भिनाःयो। <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />ता मताह्‌नान्न जिन्दगीन धा अनै जेङ्पा, कि ख्युई ङेन, तीबाःदि तेम्मा परमेस्वरग स्योयाःयो, रे ङेनजै फेप्पा येसु मसिहग स्योयाःयो। <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />कन धोन ङेनजै ङा बिम्बो, अन पुरा खेखे ङेन ङ्याबो पिर्थीबी ङै महिमा खेपा ङिह्पा। <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />हे पा, ता ङाः जेँनै ङ्याबो नान्नान मनै महिमा क, कन महिमा सन्सार दोङ्चेन खेरे ङू नान ङ्याबो रातौ ङन ङ्याबो ङ्याह्।”<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“सन्सारलै कन सिमिव ङेनजै ङा बिम्बो, ख्युकाङ्मोः ङेन मिह्‌न ङै थम्पा ङिह्पा। ख्यु ङेन ङ्याह्, आलै ङेनजै ख्यु ङा बिम्बो, रे ख्युई ङेन केह्ः ङ्याम्पा ङ्याह्। <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />ख्युकाङ्मोः ता क्युई ङ्याह्, कि ङेनजै ङाः बिम्पान ल्होई पुरू ङेन लम स्वापा जेङ्पा। <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />तैङर्‌वाङिन कन बचन ङेनजै ङा बिम्बो, ङै ख्युकाङ्मोः बिम्पा ङिह्पा, रे ख्युई अन स्वीकारी खेपा ङ्याह्। ङा ङेन लम स्वापा जेङ्पा र्‌वानान ख्युई तेम्माई क्युई रह्पा ङ्याह्, आलै ङेनजै ङा फेप्पा जेङ्पा र्‌वार्‌वा ख्युई बिस्वास खेपा ङ्याह्।”<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />ङा ख्युन भिह्तु सोअताप्चे, सन्सारन भिह्तु ङा सोअमताप, जेङ्नै ख्युन भिह्तु, सू ङेनजै ङाः बिम्पा ङिह्पा। तैङर्‌वाङिन ख्यु ङेनै जेङ्पा। <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />ङन पुरू तै ङिह्पा ङेन जेङ्पा, रे ङेन तै ङिह्पा ङन जेङ्पा। ङन महिमा ख्युन लम थम्पा ङ्याह्। <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />“ङा ह्‌याङ सन्सारग मलुईनान, जेङ्नै अजोव ता सन्सारग लुईनान। ङा चन ङेन स्याह् स्वायङ ङिह्पा। पबित्र पा, ङेनजै ङा बिम्पा ङेन मिह्‌नग ख्युकाङ्मोः ताह् खेखे नाह्‌ना, रे ङ्योअग च्योआलैम ख्यु रे ती रायो। <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />जब थाल ङा ख्युन ङ्याबो ङ्याह्, नाई ङाः बिम्पा ङेन सक्तिसाली मिह्‌नग ख्युकाङ्मोः ताह् खेखे नाम्पा। ख्युकाङ्मोः ताह् खेपा। आलै ख्युन बर्ग मीपा दोङ्नान्न ङोह्जो नङ्म घङ सुई मीपा मरह्पा, तैङर्‌वाङिन पबित्रसास्त्र पुरा मराखाईमे ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन ४१:९</ref>; <ref loc="JHN 13:18">यूह १३:१८</ref> </char></note> <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />“जेङ्नै ता ङा ङेन स्याह् स्वायङ ङिह्पा। सन्सारग रातौ अन ल्होई ङा र्‌वानान, कि ख्युकाङ्मोः ङन सम किम्म पुरा रायो। <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />ङै ख्युकाङ्मोः ङेन बचन बिम्पा, जेङ्नै सन्सारजै ख्युकाङ्मोः ङान्ज्यान खेबो, तैङर्‌वाङिन ख्यु सन्सारन नङ्पा, कुजुई ङा सन्सारन नङ्पा। <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />ङेनजै ख्युकाङ्मोः सन्सारलै होरा र्‌वार्‌वा ङा सोअमताप, जेङ्नै ख्युकाङ्मोः अलः लम ताह्ः खेखे नाह्‌ना। <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />ख्यु सन्सारन नङ्पा, कुजुई ङा रे सन्सारन नङ्पा। <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />ख्युकाङ्मोः तेम्माई ङन स्याह्ई थोरा, ङेन बचन तेम्मा जेङ्पा। <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />कुजुई ङेनजै ङा सन्सारग फेप्पो, ङै यङ ख्युकाङ्मोः सन्सारग फेप्पा ङिह्पा। <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />ख्युन भिह्तु ङा जेँगै थोच्‌चे, ताकि ख्यु रे तेम्माई पबित्र रायो।”<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“ङा अजोवन भिह्तु मात्र सोअमताप, जेङ्नै अजोवन ल्होन् लः लम ङन ङ्या बिस्वास खेनानवन भिह्तु सोअताप्चे, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />कि ख्यु पुरू ती रायो। हे पा, कुजुई ङेन ङन ङ्याबो ङिह्पा, रे ङा ङेन ङ्याबो, झामखेखे ख्यु रे ङ्योअग रायो, रे ङेनजै ङा फेप्पो र्‌वार्‌वा सन्सारजै बिस्वास ख्याःयो। <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />कन महिमा नाई ङाः बिम्पा ङ्याह्, ङै ख्युकाङ्मोः बिम्पा ङिह्पा, ताकि ङ्योअग ती रह्पालैम ख्यु रे ती रायो। <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />ङा ख्युन ङ्याबो, आलै ङेन ङन ङ्याबो, कि ख्यु पुर्न रुपजै ती रायो, रे ङेनजै ङा फेप्पा जेङ्पा, आलै ङा मया खेपालैम ङेनजै ख्युकाङ्मोः यङ मया खेबो र्‌वार्‌वा सन्सारजै क्युई रायो।” <verse eid="JHN 17:23" /><verse number="24" style="v" sid="JHN 17:24" />“पा, ङा इच्छ्या खेचे, कि ङेनजै ङा बिम्पा सिमिव ङा खाः ङिह्पा ङन ङ्याबो लुयाःयो, रे ङन महिमा रँयो, कन महिमा, सन्सार दोङ्चेन खेर ङू लै र्‌वार्‌वा ङा मया खेपा राह्‌राह्‌ ङेनजै ङा बिम्पा ङ्याह्।” <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />“तेम्मा न्याय खेनान्न पा, सन्सारजै नाः मस्योँ जेङ्नै ङा ङेन ङ्याबो स्योःनान, आलै ङेनजै ङा फेप्पा जेङ्पा र्‌वार्‌वा अजोवजै हाकोँ। <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />ङै नान मिह्‌न अजोवग थम्पा, आलै नान मिह्‌न अजोवग थम्पाई राह्‌नान ङ्युँ, ताकि कन मयाई ङाः नाई मया खेबो, अन ख्युकाङ्मोः लुयाःयो, रे ङा ख्युकाङ्मोः लुयाःयो।”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">येसू जुङ्पा</para>
  <para style="r">(<ref loc="MAT 26:46-56">मत्ती २६:४६-५६</ref>; <ref loc="MRK 14:43-50">मर्क १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लुक २२:४७-५३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />येसुई सोअतापतामी नु जेँन चेलावन ङ्याबो किद्रोन चाङ्पुन धिक्याँ होई। स्याह् ती क्वा ङ्याह्। येसु जेँन चेलावन ङ्याबो स्याह् ताप्पो। <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />नू जुङ्फान्नान यहूदाई र्‌वार्‌वा अन ठाउँ स्योपा ङ्याह्, तैङर्‌वाङिन येसु जेँन चेलावन ङ्याबो स्याह् लै वैतपा ङ्याह्। <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />तब बत्ति, मेह्‌न छ्याप्पान मेराङ रे हतियारव सस्सै सिपाहीवन ती दल रे ङोत्वा पुजारी रे फरिसीवजै फेप्पा पालेव सस्सै यहूदा क्वाग स्वाबो। <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />तब जेँन लाह्ः स्वानान ल्होई पुरू क्युई राह्‌राह्‌ येसु ङू स्वाबो, रे ख्युकाङ्मोः र्‌वाबो, “ङेन सू फान्नान?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />ख्युई नू र्‌वाबो, “नासरतन येसू।” येसुई ख्युकाङ्मोः र्‌वाबो, “ङा नुई जेङ्पा।” ता नू जुङ्फान्नान यहूदा यङ ख्युन ङ्याबोई थाङथाङ छ्युङ्पा ङ्याह्। <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />जब येसुई ख्युकाङ्मोः “ङा नुई जेङ्पा” र्‌वाबो। तब ख्यु ङिक होई, आलै सा घ्याबो। <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />ह्‌याङ नुई ख्युकाङ्मोः लोप्पो, “ङेन सू फान्नान?” ख्युई र्‌वाबो, “नासरतन येसु।” <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />येसुई झब बिम्बो, “ङै ङेनकाङ्मोः र्‌वापा न, ङा नुई जेङ्पा। अन्नकारन यदि ङेन ङा फाप्पे ङिह्पा र्‌वाङिन ख्यु सिमिकाङ्मोः चन वैफाना।” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />“ङेनजै ङाः बिम्पा सिमिवन बर्ग तीगै ङै ममोल्पा” र्‌वार्‌वा नुई र्‌वापा केह्ः पुरा राःयो र्‌वार्‌वा अन रह्पा।<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />सिमोन पत्रुसजै जेँन ङ्याबो रह्पान तरवाली छ्युछ्यु ङोत्वा पुजारीन राङ्पा फ्याङ्बो रे नुन याईपा नाम्ज्योवा च्वात्त थुम्बो। मन राङ्पान मिह्‌न माल्खस ङ्याह्। <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />येसुई पत्रुसग र्‌वाबो, “तरवाली स्युह्‌पग का। तै पाई ङा बिम्पा खोरे मथुङ्चेऊ?”<verse eid="JHN 18:11" /></para>
  <para style="s">हन्नासन ङू येसु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />आलै रोमी सिपाहीवन दल, ख्युन सुबेदार, रे यहूदीवन पालेवजै येसु जुङ्बो, रे नू खीबो। <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />पहिली ख्युई नू हन्नासन स्याह् वप्पो, कन अन्न पाह्‌न्न प्रधान पुजारी कैयाफान खेः ङ्याह्। <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />अन नुई कैयाफा ङ्याह्, सुई “जन्तान भिह्तु सिमिदी सिचेई ल: ङ्याह्” र्‌वार्‌वा यहूदी आङ खेनान्न सिमिकाङ्मोः सल्‌ला बिम्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">यूह ११:४९-५०</ref></char></note><verse eid="JHN 18:14" /></para>
  <para style="s">पत्रुसजै येसू अस्वीकार खेपा</para>
  <para style="r">(<ref loc="MAT 26:69-70">मत्ती २६:६९-७०</ref>; <ref loc="MRK 14:66-68">मर्क १४:६६-६८</ref>; <ref loc="LUK 22:55-57">लुक २२:५५-५७</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />सिमोन पत्रुस रे येसुन घङ चेलादी येसुन ङिक जाःबो। मन घङ चेला चन प्रधान पुजारीन स्योपा सिमि ङ्याह्, रे येसु ङ्याबोई प्रधान पुजारीन ख्यामग जाःबो। <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />जेङ्नै पत्रुस खोलोः झलाः थाङथाङ छ्युङ्पा ङ्याह्। मन घङ चेला चनजै, सु प्रधान पुजारीन स्योपा सिमि ङ्याह्, खोलोः गेग्गे झलाः छ्युङ्नान चिमिचा र्‌वार्‌वा पत्रुसग झिङ सप्पो। <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />तब झलाः छ्युङ्नान मन राङ्माई पत्रुसग र्‌वाबो, “तै ना रे अन सिमिन चेलावन बर्ग ती जेङ्पौ?” पत्रुसजै र्‌वाबो, “ङा नङ्पा।” <verse eid="JHN 18:17" /><verse number="18" style="v" sid="JHN 18:18" />स्याह् राङ्पा रे पालेव मेह् धेधे थाङथाङ छ्युङ्पा ङ्याह्। तैङर्‌वाङिन ख्याःरि ङ्याह्। आलै पत्रुस यङ ख्युन ङ्याबो थाङथाङ मेह् धेम जाःबो।<verse eid="JHN 18:18" /></para>
  <para style="s">येसु प्रधान पुजारी लम प्रस्‌न</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती २६:५९-६६</ref>; <ref loc="MRK 14:55-64">मर्क १४:५५-६४</ref>; <ref loc="LUK 22:66-71">लुक २२:६६-७१</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />ता प्रधान पुजारीजै येसु नुन चेलाव रे नुन छोएन भारेः लोप्पो। <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />येसुई नू झब बिम्बो, “ङै सन्सारग हाकाहाकि र्‌वापा ङिह्पा। ङै एकुरो जोम्पू रे यहूदीन आराधनालयग लम्पा ङिह्पा, खाः पुरू यहूदीव जोम्नान। ङै फाक तये र्‌वापा मह्‌या। <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />ङा तैङ लोन्नान? ङै ख्युकाङ्मोः तै र्‌वापा अन ङ्यान्नानकाङ्मोः ल्होरा। ङै र्‌वापा ल्होईव अजोव क्युई ङ्याह्।”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />येसुई अन ल्होई र्‌वातौ रह्‌म्म थाङथाङ छ्युङ्पा पालेवन बर्ग तीपाई झाःम र्‌वार्‌वा येसू ताप्पर फ्याङ्बो, “तै प्रधान पुजारी झामखेखे झब बिन्नौ?”<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="LUK 22:63">लुक २२:६३</ref>; <ref loc="MIC 5:1">मीका ५:१</ref></char></note> <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />येसुई नू र्‌वाबो, “ङै घोलोवा र्‌वापा जेङ्न अन्न पर्मान भिना, जेङ्नै यदि ङै तेम्मा र्‌वापा जेङ्न ङा तैङ फ्याङ्नान?” <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />तब हन्नासजै नू खीपागै प्रधान पुजारी कैयाफान स्याह् फेप्पो।<verse eid="JHN 18:24" /></para>
  <para style="s">पत्रुसजै खेपा ङेरेप रे सुमरेपन अस्वीकार</para>
  <para style="r">(<ref loc="MAT 26:71-75">मत्ती २६:७१-७५</ref>; <ref loc="MRK 14:69-72">मर्क १४:६९-७२</ref>; <ref loc="LUK 22:58-62">लुक २२:५८-६२</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />सिमोन पत्रुस थाङथाङ छ्युङछ्युङ मेह् धेपाई ङ्याह्। ख्युई नू र्‌वाबो, “तै नुन चेलावन बर्ग तीपा ना रे नङ्पाऊ?” नुई अस्वीकार खेखे र्‌वाबो, “ङा नङ्पा।” <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />प्रधान पुजारीन राङ्पाव बर्ग तीपा, सुन सिमिन नाम्ज्योवा पत्रुसजै थुम्पा ङ्याह्, नुई लोप्पो, “तै ङै ना नुन ङ्याबो क्वा मरङ्पा तै?” <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />तब ह्‌याङ पत्रुसजै अस्वीकार खेबो। आलै तुरुन्तै काःपा तर्बो।<verse eid="JHN 18:27" /></para>
  <para style="s">पिलातसन ङू येसु</para>
  <para style="r">(<ref loc="MAT 27:1-2">मत्ती २७:१-२</ref>; <ref loc="MAT 27:11-14">२७:११-१४</ref>; <ref loc="MRK 15:1-5">मर्क १५:१-५</ref>; <ref loc="LUK 23:1-5">लुक २३:१-५</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />तब ख्युई येसू कैयाफान यिमलै महलक्याँ वप्पो। अन्तौ नाह्प ङ्याह्। बाःपा राह्‌राह्‌ निस्तार-तेवरन भत्यार झाचे मदेन्नान र्‌वानान ङिनङिन ख्यु महलन झिङ मजाबो। <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />अन्नकारन ख्युन स्याह् खोलोः गेग्गे पिलातसजै र्‌वाबो, “अन सिमिन बिरोधग ङेन तै दोस बिन्नान?” <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />ख्युई नू र्‌वाबो, “यदि अन सिमि अपराधी मराङिन ङ्योअग नू ङेन स्याह् फेन्नान मह्‌या।”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पिलातसजै ख्युकाङ्मोः र्‌वाबो, “ङेन नू होरा, रे ङेनकोन जेँनै कानुन अन्सार नुन न्याय ख्या।” यहूदीवजै नू र्‌वाबो, “सिमि सुई र्‌वार्‌वा सच्‌चेन धल बिन्चेन आङ ङ्योअग मीपा।” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />जेँ कुजुई सित्वानान र्‌वार्‌वा येसु जेँजै र्‌वापान ल्होई पुरा राचेन भिह्तु झाम रह्पा।<note caller="-" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">यूह ३:१४</ref>; <ref loc="JHN 12:32">१२:३२</ref></char></note> <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />पिलातस ह्‌याङ महलन झिङ जाःबो, रे नुई येसु घ्वाघ्वा र्‌वाबो, “तै ना यहूदीवन झली जेङ्पौ?” <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />येसुई झब बिम्बो, “ङेन ङजै झाम र्‌वानान, आथबा ङन भिह्तु ङेन ङ्याबो घङ सुई र्‌वापा?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />पिलातसजै झब बिम्बो, “तै ङा यहूदी जेङ्पौ? नानै सिमि रे ङोत्वा पुजारीवजै नाः ङन लाह्‌ग थोप्पो। नाई तै खेपा?” <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />येसुई झब बिम्बो, “ङन राज्य अन सन्सारन नङ्पा। ङन राज्य अन सन्सारन रह्पा जेङ्न ता ङन सेवकव ङन भिह्तु फ्याङ्ची खेनान ङ्याह्, रे ङा यहूदीवन लाह्‌ग थेप्नान मीह्। जेङ्नै ङन राज्य अन सन्सारन नङ्पा।” <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />पिलातसजै नू लोप्पो, “तै ना झलीई जेङ्पौ?” येसुई झब बिम्बो, “ङा झली जेङ्पा र्‌वार्‌वा नह् र्‌वाङ। अन्नै भिह्तु ङा केह्पा जेङ्पा, रे अन्नै भिह्तु तेम्मान साँचि बिम्म ङा अन सन्सारग स्वापा जेङ्पा। पुरू सु तेम्मान पछेग ङ्याह्, नुई ङन केह्ः ङ्यान्नान।”<note caller="-" style="x"><char style="xo" closed="false">18:37 </char><char style="xt" closed="false"><ref loc="1JN 4:6">१ यूह ४:६</ref></char></note><verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />पिलातसजै नू लोप्पो, “तेम्मा तै जेङ्पा?” अकेः र्‌वार्‌वा नु यहूदीवन स्याह् खोलोः गेग्गे होई, रे ख्युकाङ्मोः र्‌वाबो, “ङा अन्न स्याह् दोस तये मदेङ्‌ङ।”<verse eid="JHN 18:38" /></para>
  <para style="s">येसू सच्‌चेन आग्या</para>
  <para style="r">(<ref loc="MAT 27:15-31">मत्ती २७:१५-३१</ref>; <ref loc="MRK 15:6-20">मर्क १५:६-२०</ref>; <ref loc="LUK 23:13-25">लुक २३:१३-२५</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />निस्तार-तेवरग तीपाः ङै ङेनकोन भिह्तु फेच्‌चेन ङेनकोन कानुन ङ्याह्। ता ङेन तै सम खेनान, कि “यहूदीवन झली फेचेऊ?” <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />जेङ्नै ख्यु ह्‌याङ झाम र्‌वायङ फाईरा खेबो, “नू नङ्पा, जेङ्नै बारब्बा।” बारब्बा चन च्यापा ङ्याह्।<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />तब पिलातसजै येसु वव्वै चेरन ताल्च्या फ्याङ फाम्बो। <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />आलै सिपाहीवजै चेरन मुकुत दोङ्दोङ नुन थोप्पाः थम्बो, रे नू रङ ल्होःम रे पिङ्म होम्पा घोलाङ थम्बो, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />रे नुन रह्‌म्म स्वास्वा र्‌वाबो, “नमस्ते, यहूदीवन झली!” आलै ख्युई नू ताप्पर फ्याङ्बो।<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />ह्‌याङ खोलोः गेग्गे पिलातसजै ख्युकाङ्मोः र्‌वाबो, “सेह्‌ना, ङा नू ङेन स्याह् खोलोः सप्पा ङिह्पा, रे ङेनकाङ्मोः स्यास्सुम ङिह्पा, ङा नू दोस तये मदेन्नान।” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />तब चेरन मुकुत रे बैजनी रङन घोलाङ थम्पा येसु खोलोः स्वाबो, रे पिलातसजै ख्युकाङ्मोः र्‌वाबो, “सेह्‌ना, अन सिमी!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />जब ङोत्वा पुजारीव रे पालेवजै नू रङ्बो, ख्यु झाम र्‌वायङ फाईरा खेमः जाःबो, “नू क्रुसग चुना!” नू क्रुसग चुना पिलातसजै ख्युकाङ्मोः र्‌वाबो, “ङेनजै नू वव्वै क्रुसग चुना, तैङर्‌वाङिन ङा नुग दोस तये मदेन्नान!” <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />यहूदीवजै नू झब बिम्बो, “ङ्योअन ती कानुन ङिह्पा, रे मन कानुन अन्सार अन सित्वानान, तैङर्‌वाङिन नुई जेँगै परमेस्वरन ङोह्जो जेङ्पा र्‌वार्‌वा दाबि खेपा ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी २४:१६</ref></char></note> <verse eid="JHN 19:7" /><verse number="8" style="v" sid="JHN 19:8" />अन ल्होई ताह्ताह् पिलातस झन ङिह्‌म्बो। <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />नु ह्‌याङ महलन झिङ जाःबो रे येसु लोप्पो, “ना खान जेङ्पा?” जेङ्नै येसुई नू झब तये मबिम्बो। <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />अन्नकारन पिलातसजै नू र्‌वाबो, “तै ना ङन ङ्याबो ल्होई मर्‌वानौ? ना फेच्‌चेन आङ ङन ङ्याबो ङिह्पा, रे ना क्रुसग चुम्चेन आङ यङ ङन ङ्याबो ङिह्पा र्‌वानान ना क्युई मीपाऊ?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />येसुई झब बिम्बो, “ङेन ङ्याबो परमेस्वर लम आङ मबिम्पा जेङ्न ङन लाह्ः ङेन तये आङ राह्‌नान मह्‌या। अन्नकारन ङा नान लाह्‌ग बिन्नान हेँ ह्‌याल्म तीपान दोसी ङिह्पा।” <verse eid="JHN 19:11" /><verse number="12" style="v" sid="JHN 19:12" />आलै पिलातसजै नू फेच्‌चेन प्रयास लै खेबो। जेङ्नै यहूदीव झाम र्‌वायङ फाईरा खेबो, “यदि ङेनजै अन सिमि फेङ्‌ङिन ङेन कैसरन फुरी मराने। जेँगै झली जेङ्पा र्‌वार्‌वा धिपी खेनान पुरू कैसरन बिरोधग च्याङ्नान।” <verse eid="JHN 19:12" /><verse number="13" style="v" sid="JHN 19:13" />पिलातसजै अन ल्होई ताह्ताह् येसु खोलोः सप्पो, रे नु “लुङन पाती” र्‌वानान ठाउँग (कनग हिब्रु ल्होईग गब्बथा र्‌वानान) न्याय आसनग छ्युङ्बो। <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />अन्तौ निस्तार-तेवरन तयारीन दिन ङ्याह्। ङिजेन क्वाईमाल्‌ला बार बजि रह्पा ङ्याह्। पिलातसजै यहूदीकाङ्मोः र्‌वाबो, “सेह्‌ना, ङेन झली!” <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />जेङ्नै ख्यु झाम र्‌वायङ फाईरा खेबो, “नू सह्‌रा, नू सह्‌रा, नू क्रुसग चुना!” पिलातसजै ख्युकाङ्मोः लोप्पो, “तै ङा ङेन झली क्रुसग चुना?” ङोत्वा पुजारीवजै झब बिम्बो, “कैसर नङ्म घङ ङ्योअन झली मीपा।” <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />तब पिलातसजै नू क्रुसग चुम्मः ख्युन लाह्‌ग बिम्बो। अन्नकारन सिपाहीवजै येसु जिम्मा वप्पो।<verse eid="JHN 19:16" /></para>
  <para style="s">येसू क्रुसग चुम्पा</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्ती २७:३२-४४</ref>; <ref loc="MRK 15:21-32">मर्क १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लुक २३:२६-४३</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />नु जेँन क्रुस ङजै हुरहुर खप्परे र्‌वापू होई, कनग हिब्रु ल्होईग गलगथा र्‌वानान। <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />स्याह् ख्युई नू क्रुसग चुम्बो रे नुन ङ्याबो घङ ङेह्पाः चुम्बो, तीपा तीक्याँ रे घङग घङक्याँ, आलै घूँ येसु। <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पिलातसजै ती दोस-पत्र यङ सर्बो, आलै क्रुसन लाह्ः चुम्बो। मनग अनै सर्पा ङ्याह्, “नासरतन येसु, यहूदीवन झली।” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />ता लै यहूदीवजै अन दोस-पत्र तोअबो, तैङर्‌वाङिन येसु क्रुसग चुम्पान ठाउँ सहरन ङेह्‌मः ङ्याह्। अन हिब्रु, ल्यातिन रे ग्रीक ल्होईग सर्पा ङ्याह्। <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />यहूदीवन ङोत्वा पुजारीवजै पिलातसग र्‌वाबो, “यहूदीवन झली, र्‌वाचे नङ्पा, जेङ्नै ‘नुई ङा यहूदीवन झली जेङ्पा र्‌वाबो’ र्‌वार्‌वा सह्रा।” <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />पिलातसजै झब बिम्बो, “ङै तै सर्नै, सर्पा।”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />सिपाहीवजै येसू क्रुसग चुनतामी नुन घोलाङ वव्वै काला ली कबो रे राह्ङराङ्साः परेःबो। नुन घोलाङ र्‌याङ्म चन ङ्यालै पोँथाल ब्योई मत्वानान खेखे दोङ्पा ङ्याह्। <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />अन्नकारन ख्युई राह्ङराङ्साः र्‌वाबो, “अन चन मछ्योम्मता, जेङ्नै अन सू थेप्नान जेङ्पा र्‌वार्‌वा चित्ता कामता।” पबित्रसास्त्र पुरा राःयो र्‌वार्‌वाई अन रह्पा ङ्याह् “ख्युई ङन घोलाङ राह्ङराङ्साः परेःबो, रे खोलोःन घोलाङ चन चित्ता कबो।”<note caller="-" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजन २२:१८</ref></char></note><verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />अन्नकारन सिपाहीवजै अन धोन खेबो। आलै येसुन क्रुसन रह्‌म्म नुन मा, नुन मान बहिनी, क्लोपासन मिसा मरियम रे मरियम मग्दलिनी थाङथाङ छ्युङ्पा ङ्याह्। <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />जब येसुई जेँन मा रे नुई मया खेनान चेला रह्‌म्म थाङथाङ छ्युङ्पा रङ्बो, तब नुई जेँन मा र्‌वाबो, “चिमिचा, सेह्‌ना, ङेन ङोह्जो!” <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />तब मन चेलाः र्‌वार्‌वा नुई र्‌वाबो, “सेह्‌ना, नान मा!” मन्न भेलालै मन चेलाई नू जेँनै यिम वप्पो।<verse eid="JHN 19:27" /></para>
  <para style="s">येसु सिह्बो</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती २७:४५-५६</ref>; <ref loc="MRK 15:33-41">मर्क १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लुक २३:४४-४९</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />आलै येसुई ता ल्होई पुरू तह्बो र्‌वार्‌वा क्युई राह्‌राह्‌ पबित्रसास्त्र पुरा रायो र्‌वार्‌वा र्‌वाबो, “ङा त्यु बुल्बो।”<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="PSA 22:15">भजन २२:१५</ref>; <ref loc="PSA 69:21">६९:२१</ref></char></note> <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />स्याह् खु खाःपाई नाङ्पान धाङदी नाम्पा ङ्याह्। अन्नकारन खु खाःपा नाङ्पान कपासदी हिसपन धाः नान्नान ख्युई नुन ङुरग साःबो।<note caller="-" style="x"><char style="xo" closed="false">19:29 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजन ६९:२१</ref></char></note> <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />जब येसुई खु खाःपा वप्पो, तब नुई र्‌वाबो, “ता तह्बो,” रे नुई थोप्पा कुकु जेँन परान पप्पो।<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="LUK 23:46">लुक २३:४६</ref>; <ref loc="MRK 15:37">मर्क १५:३७</ref></char></note><verse eid="JHN 19:30" /></para>
  <para style="s">दुङ्जै काँचिली चापा</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />मन्न लाह्‌ः तयारीन दिन ङ्याह्। अन्नकारन यहूदी आङ खेनान्न सिमिवजै नाह्‌न ल्हाः (तेम्मा खेखे अन नाह्‌न लाह्ः, कन चन ङोत्वाखाईमे ङ्याह्) सिपा ल्होव क्रुसग नलुयाःयो र्‌वार्‌वा पिलातसग छ्याःफुल्बो, रे ख्युन लेह् क्युक्क्युई ख्युन ल्हो वच्‌चे धेरायो र्‌वार्‌वा तोल्बो। <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />तब सिपाहीव स्वास्वा नुन ङ्याबो क्रुसग चुम्पावन लेह् क्युप्पो, पहिली तीपान, आलै घङ्न। <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />जेङ्नै जब मन सिपाहीव येसुन रह्‌म्म होई तब ख्युई नु लैःलै सितपा रङ्बो, अन्नकारन ख्युई नुन लेह् मक्युप्पो। <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />जेङ्नै सिपाहीव बर्ग तीपाई नुन काँचिली दुङ्जै चाबो, रे तुरुन्तै कह रे त्यु गेप्पो। <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />ङेन यङ बिस्वास खेतयाःयो र्‌वार्‌वा अन रङ्नानजै बयान बिम्पा जेङ्पा रे नुन साँचि तेम्मा ङिह्पा, रे तेम्मा ल्होई र्‌वानान र्‌वार्‌वा नु हाकोँ। <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />“नुन स्युह्‌रु ती यङ क्युन्नान मह्‌या” र्‌वानान पबित्रसास्त्रन केह्ः पुरा राःयो र्‌वार्‌वा अन ल्होई राम स्वाबो।<note caller="-" style="x"><char style="xo" closed="false">19:36 </char><char style="xt" closed="false"><ref loc="EXO 12:46">प्रस १२:४६</ref>; <ref loc="NUM 9:12">गन्ती ९:१२</ref>; <ref loc="PSA 34:20">भजन ३४:२०</ref></char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />आलै ह्‌याङ घङ ठाउँग पबित्रसास्त्र र्‌वाङ, “सू ख्युई चापा ङ्याह्, ख्युई नू सेन्नान ङ्याह्।”<note caller="-" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="ZEC 12:10">जक १२:१०</ref>; <ref loc="REV 1:7">प्रका १:७</ref></char></note><verse eid="JHN 19:37" /></para>
  <para style="s">येसु लुम्पा</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती २७:५७-६१</ref>; <ref loc="MRK 15:42-47">मर्क १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लुक २३:५०-५६</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />अन्न ङिक अरिमाथियान योसेफ, सु यहूदीकाङ्मोः ङिनङिन फाक मात्र येसुन चेला ङ्याह्, नुई पिलातसग येसुन सिह्पान ल्हो वच्‌चे धेरायो र्‌वार्‌वा छ्याःफुल्बो। पिलातसजै वपफाम्बो। तब नुई स्वास्वा नुन कुँह्‌म वप्पो। <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />आलै ङू नुन रह्‌म्म छान स्वानान निकोदेमस यङ क्वाईमाल्‌ला: किलो सुमच्यु मूर्र रे एलवा होम्पा रिह् स्यामन छि सस्सै स्याह् स्वाबो। <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />झामखेखे ख्युई येसुन ल्हो यहूदीवन लुम्नान्न ल्हू अन्सार र्हिस्याम छिन ङ्याबो सुतीन घोलाङग खीबो। <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />नु क्रुसग चुम्पान ठाउँग ती क्वा ङ्याह्। मन क्वाग सुई हातौयै मनाम्पा तुह्‌र्सादी सार्बा ङ्याह्। <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />तैङर्‌वाङिन यहूदीवन तयारीन दिन ङ्याह्, आलै मन तुह्‌र्सा यङ ङेह्‌मः ङ्याह्, रे ख्युई येसू अनै तुर्सा नाह्‌म्बो।<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">तुर्सा होङ</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती २८:१-८</ref>; <ref loc="MRK 16:1-8">मर्क १६:१-८</ref>; <ref loc="LUK 24:1-12">लुक २४:१-१२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />नेर्यान ङूस्योवान दिन नाह्प नम मनाङ्तौ मरियम मग्दलिनी तुर्साः स्वाबो, रे नुई लुङ तुह्‌र्सालै पप्पा रङ्बो। <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />नु सिमोन पत्रुस रे येसुई मया खेनान घङ चेलान स्याह्‌ धालैधालै होई, रे ख्युकाङ्मोः र्‌वाबो, “ख्युई प्रभू तुह्‌र्सालै खोलोः वत्तँ, रे नू खाः नाम्पा ङ्याह्, अन ङ्योअग क्युई मह्‌या।” <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />तब पत्रुस रे घङ चेला खोलोः गेग्गे तुह्‌र्साक्याँ होई। <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />ख्यु ङ्योरुम ङ्याबो धालैधालै होई, जेङ्नै घङ चेला पत्रुसग ङू तलतल तुह्‌र्सा ङू स्वा ताप्पो। <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />तुर्सान झिङ कुकु सेन्तौ, नुई ङू च्योम्पान सुती घोलाङव मात्र छार्पा रङ्बो, जेङ्नै नु झिङ मजाबो। <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />सिमोन पत्रुस नुन ङिङि स्वाबो, रे तुह्‌र्सान झिङ जाःबो, आलै नुई र्‌वार्‌वा मलमलन च्योम्नान्न घोलाङव मात्र रङ्बो। <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />नुन थोप्पाः च्योम्पान बर्खि चन मलमलन घोलाङव ङ्याबो मह्‌या, जेङ्नै तीक्याँ ताप्‌ताप्‌ नाम्पा ङ्याह्। <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />तब तुह्‌र्साः ङू स्वा ताप्नान घङ चेला यङ झिङ जाःबो, रे अन रङरङ नुई बिस्वास खेबो। <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />तैङर्‌वाङिन ख्युई नु सिपालै सम्पु राह्‌राह्‌ च्याङत्वानान र्‌वानान पबित्रसास्त्रन बचन चोँन बेर हाकोपा मह्‌या।<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भजन १६:१०</ref></char></note> <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />अन्न ङिक मन चेलाव जेँन यिम होल्बो।<verse eid="JHN 20:10" /></para>
  <para style="s">येसु मरियम मग्दलिनीन स्याह्‌ रङ्बो</para>
  <para style="r">(<ref loc="MAT 28:9-10">मत्ती २८:९-१०</ref>; <ref loc="MRK 16:9-11">मर्क १६:९-११</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />जेङ्नै मरियम तुह्‌र्सान खोलोः धाईधाई थाङथाङ छ्युङछ्युङ तुर्साक्याँ कुकु सेम्बो, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />रे खाः येसुन सिह्पा ल्हो नाम्पा ङ्याह्, स्याह् घोलाङ पाह्ल्म गोम्पा ङेह् स्वर्गदुतकाङ्मोः, तीपा थोप्पाक्याँ रे घङ ल्हेक्याँ छ्युङ्पा नुई रङ्बो। <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />ख्युई नू र्‌वाबो, “चिमिचा, तैङ दोःनान?” नुई ख्युकाङ्मोः र्‌वाबो, “ख्युई ङन प्रभू वत्तँ, रे नू खाः नाम्पा ङ्याह्, ङाः क्युई मह्‌या।”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />अन ल्होई र्‌वार्‌वा नु ङिक्याँ होल्बो, रे नुई येसू थाङथाङ छ्युङ्पा रङ्बो, जेङ्नै येसुई जेङ्पा र्‌वार्‌वा मस्योःबो। <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />येसुई नू र्‌वाबो, “चिमिचा, ना तैङ दादाई ङिह्पा? सू फान्नान?” नुई नू क्वान धोन खेनान र्‌वार्‌वा छुछु र्‌वाबो, “गुरु, नाई नू स्यीह्‌लै वप्पा राङिन, खाः नाम्पा ङिह्पा ङा र्‌वा, रे ङा नू वन्नान ङ्युँ।” <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />येसुई नू र्‌वाबो, “मरियम!” नुई होलहोल नू हिब्रु ल्होईग र्‌वाबो, “रब्बोनी,” आथबा “हे गुरुज्यू!” <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />येसुई नू र्‌वाबो, “ङा नज्यारा, तैङर्‌वाङिन ङा चोँन बेर पान स्याह् वैपा मीपा। जेङ्नै ङन भाइवन स्याह् वैवै ख्युकाङ्मोः र्‌वा, ‘ङन पा रे ङेन पा, रे ङन परमेस्वर रे ङेन परमेस्वरन स्याह् वैपाई ङ्युँ’।” <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />मरियम मग्दलिनी होई, रे चेलाकाङ्मोः स्याप्पो, “ङै प्रभू रङ्पा।” आलै नुई र्‌वापा ल्होई ख्युकाङ्मोः नुई र्‌वाबो।<verse eid="JHN 20:18" /></para>
  <para style="s">येसु चेलावन स्याह्‌ रङ्बो</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती २८:१६-२०</ref>; <ref loc="MRK 16:14-17">मर्क १६:१४-१७</ref>; <ref loc="LUK 24:36-49">लुक २४:३६-४९</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />मन्नै लाह्‌ः, आथबा नेर्यान ङूस्योवान दिन्न ङ्याजे, जब यहूदीकाङ्मोः ङिनङिन चेलाव झलाव थाथा झिङ जोमजोम छ्युङ्पा ङ्याह्, येसु स्वास्वा ख्युन घूँ थाङथाङ छ्युङ्बो, रे ख्युकाङ्मोः र्‌वाबो, “ङेनकाङ्मोः सान्ति!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />अकेः र्‌वार्‌वा नुई ख्युकाङ्मोः जेँन लाह् रे काँचुलि यङ थम्बो। प्रभू रङरङ चेलाव मिह्दा स्याङ्बो। <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />तब येसुई ह्‌याङ ख्युकाङ्मोः र्‌वाबो, “ङेनकाङ्मोः सान्ति! कुजुई पाई ङा फेप्पो, झामखेखे ङा रे ङेनकाङ्मोः फेच्चे।” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />आलै अकेः र्‌वार्‌वा नुई ख्युन लाह्ः फु खेखे र्‌वाबो, “पबित्र आत्मा होरा। <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />सुन तीपा ङेन माफ खेनान, ख्युकाङ्मोः माफ राह्‌नान, रे सुन तीपा ङेन माफ मखेनान माफ राह्‌नान मह्‌या।”<note caller="-" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">मत्ती १६:१९</ref>; <ref loc="MAT 18:18">१८:१८</ref></char></note><verse eid="JHN 20:23" /></para>
  <para style="s">येसु रे थोमा</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />येसु स्वातौ च्योङेपा बर्ग तीपा, दिदुमस मिह्‌न्न थोमा चन, ख्युन ङ्याबो मह्‌या। <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />अन्नकारन घङ चेलावजै नू र्‌वाबो, “ङी प्रभू रङ्पा।” जेङ्नै नुई ख्युकाङ्मोः र्‌वाबो, “कन्न बेर ङा नुन ल्हाग किलावन माल मरँ, रे किलावन मालग ङन ल्हाजुप मका, नुन काँचिली ङन ल्हा मका, मन्न बेर ङा बिस्वास खेनान मीह्।”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />केर्यान ङिक नुन चेलाव ह्‌याङ यिमन झिङै ङ्याह्। थोमा यङ ख्युन ङ्याबो ङ्याह्। झलाव थाःपा ङ्याह्, जेङ्नै येसु झिङ स्वाबो, रे घूँ थाङथाङ छ्युङछ्युङ र्‌वाबो, “ङेनकाङ्मोः सान्ति!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />तब नुई थोमा र्‌वाबो, “नान ल्हाजुप स्यीह् नाह्‌ना, रे ङन लाह्ःव सेह्‌ना। नान लाह् क्याङक्याङ ङन काँचिली का। अबिस्वासी नङ्पा जेङ्नै बिस्वासी रा।” <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />थोमाई नू र्‌वाबो, “ङन प्रभु, ङन परमेस्वर!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />येसुई नू र्‌वाबो, “नाई ङा रङ्पान कारन ङन लाह्ः बिस्वास खेपा जेङ्पा? धन्न जेङ्पा ख्यु, सुई ङा रङ्पा मह्‌या, रै बिस्वास खेनान।”<verse eid="JHN 20:29" /></para>
  <para style="s">अन किताबन उदेस्य</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />येसुई घङ लै ताईलुवान धोनव चेलावन ङू खेबो, कन चन अन किताबग सर्पा मह्‌या। <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />जेङ्नै अजोव सर्पा ङ्याह्, कि ङेनजै येसु परमेस्वरन ङोह्जो, मसिह जेङ्पा र्‌वार्‌वा बिस्वास ख्या, रे बिस्वासलम नुन मिह्‌नग ङेनकाङ्मोः झुनी धेरायो।<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">येसु ने चेलावन स्याह् रङ्बो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />अन्न ङिक चेलावन स्याह् तिबेरियास योह्‌न नाः येसुई ह्‌याङ जेँग थम्बो। नुई जेँग झामखेखे थम्बो, <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />सिमोन पत्रुस, दिदुमस र्‌वानान थोमा, गालीलन काना सहरन नथानेल, जब्दियान ङे ङोह्जोव रे नुन चेलावन बर्ग घङ ङेपा ङ्याबो ङ्याह्। <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />सिमोन पत्रुसजै ख्युकाङ्मोः र्‌वाबो, “ङा ङाह् जुङ्मः वैचे।” ख्युई नू र्‌वाबो, “ङ्योअ रे नान ङ्याबो स्वाचे।” ख्यु वैवै दोङा चप्पो, जेङ्नै अन छान ख्युई तये मजुङ्बो।<note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">लुक ५:५</ref></char></note> <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />नाप राम जाःपा ङ्याह्, येसु ना च्याङ्बो। जेङ्नै चेलावजै नु येसुई जेङ्पा र्‌वार्‌वा मस्योःबो। <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />येसुई ख्युकाङ्मोः र्‌वाबो, “वैचा हो ङेन ङ्याबो तयाः ङाह् ङिह्पाऊ?” ख्युई नू झब बिम्बो, “मीपा।”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />येसुई ख्युकाङ्मोः र्‌वाबो, “जाल दोङान याईपाक्याँ का, आलै देन्नान ङ्याह्।” तब ख्युई जाल कबो, रे ङाह् अकेः ह्‌याल्म थेप्पो कि ख्युई जाल कानै मतैबो।<note caller="-" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="LUK 5:6">लुक ५:६</ref></char></note><verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />येसुई मया खेनान चेलाई पत्रुसग र्‌वाबो, “नु प्रभु जेअँ।” “नु प्रभु जेअँ” र्‌वानान ताह्ताह् सिमोन पत्रुसजै जेँन खोलोःन घोलाङ हाङग तिह्‌बो, तैङर्‌वाङिन नुई घोलाङ फुप्पा ङ्याह्, रे त्यू बोर्बो। <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />घङ चेलाव दोङागै छ्युङछ्युङ ङाह् थेप्पा जाल कानैकानै स्वाबो। ख्यु नाःलै ग्याङ्म नङ्पा, जेङ्नै क्वाईमाल्‌ला: मितर क्याम तीतौग ग्याङ्म ङ्याह्। <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />जब ख्यु नाः धुल्बो, तब ख्युई मेह्रोवान लाह्ः ङाह् नाम्पा रे रोता रङ्बो। <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />येसुई ख्युकाङ्मोः र्‌वाबो, “ङेनजै घोमाः जुङ्पा ङाह्‌लम ङाई क।” <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />तब सिमोन पत्रुसजै दोङाः चपचप नेथल रै च्युसुम किम किम ङाह्‌ई नाङ्पान जाल कानकान नाः सप्पो, जेङ्नै अकेः ह्‌याल्म रानै जाल मज्योम्बो। <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />येसुई ख्युकाङ्मोः र्‌वाबो, “स्वास्वा झा।” चेलावन बर्ग सुई यङ “ङेन सु जेङ्पा?” र्‌वार्‌वा लोच्‌चेन हिम्मत मखेबो, तैङर्‌वाङिन ख्युई नु प्रभु जेङ्पा र्‌वार्‌वा स्योःङ। <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />येसु स्वाबो रे रोता वव्वै ख्युकाङ्मोः बिम्बो, रे झामखेखे ङाह् यङ बिम्बो। <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />सिह्पालै सम्पु राह्‌राह्‌ च्याङ्मी येसु चेलावन स्याह् रङ्पा अन सुमरेप ङ्याह्।<verse eid="JHN 21:14" /></para>
  <para style="s">येसु रे पत्रुस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />जब ख्युई ङाह् रे रोता झातबो, तब येसुई सिमोन पत्रुसग र्‌वाबो, “यूहन्नान ङोह्जो सिमोन, तै ना ङाः अजोव खेरे ह्‌याल्म मया खेनौ?” नुई झब बिम्बो, “अँ प्रभु, नाः क्युई ङ्याह् न, ङा नाः मया खेनान।” येसुई नू र्‌वाबो, “ङन लूचाकाङ्मोः ख्वा।”<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />येसुई ह्‌याङ ङेरेप नू र्‌वाबो, “यूहन्नान ङोह्जो सिमोन, तै ना ङा मया खेनौ?” यूहन्नाई नू झब बिम्बो, “अँ, प्रभु, नाः क्युई ङ्याह् न, ङा नाः मया खेनान।” येसुई नू र्‌वाबो, “ङन लूपावन सेन्चे ख्या।” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />नुई सिमोनग सुमरेप र्‌वाबो, “यूहन्नान ङोह्जो सिमोन, तै ना ङा मया खेनौ?” पत्रुस तुँलाक्या रह्पा, तैङर्‌वाङिन येसुई सुमरेप नू, “तै ना ङा मया खेनौ?” र्‌वाबो। नुई नू र्‌वाबो, “प्रभु, ङेन ङ्याबो ल्होई पुरू क्युई ङिह्पा। ङा ङेन ङ्याबो मया खेनान र्‌वार्‌वा ङेन ङ्याबो क्युई ङिह्पा।” येसुई नू र्‌वाबो, “ङन लूपाकाङ्मोः ख्वा। <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />तेम्माई, ङा ना र्‌वाचे, जब ना छबा ङ्याह् नजै जेँन धप दम्म, रे खाः वैसुम दोङ्‌ङ स्याह् वैङ। जेङ्नै जब ना काप्पो राह्‌नान ङ्याह्, तब नाई जेँन लाह् क्याङ्नान ङ्याह्, रे घङजै नान धप दम्नान ङ्याह्, रे ना खाः वैसुम धोँ स्याह्‌ वन्नान ङ्याह्।” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />कुजुई सितौ नुई परमेस्वरन महिमा खेनान ङ्याह्, अन्न लाःता खेईखेई येसुई अन र्‌वापा ङ्याह्। अकेः र्‌वार्‌वा नुई सिमोन पत्रुसग र्‌वाबो, “ङन ङिक जाः।”<verse eid="JHN 21:19" /></para>
  <para style="s">येसु रे घङ चेलाव</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />पत्रुसजै ङिक होलहोल सेन्तौ येसुई मया खेनान चेला ङिङि स्वायङ खेपा रङ्बो। नुई ङ्याजेन ङ्योप्पा झानान्न भेला नुन घूँ रेमरेम, “प्रभु, ङेन ङ्याबो जुङ्फान्नान सु जेङ्पा?” र्‌वार्‌वा लोप्पा ङ्याह्।<note caller="-" style="x"><char style="xo" closed="false">21:20 </char><char style="xt" closed="false"><ref loc="JHN 13:25">यूह १३:२५</ref></char></note> <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />नू रङरङ पत्रुसजै येसु र्‌वाबो, “प्रभु, ता नू तै राह्‌नान?” <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />येसुई पत्रुसग र्‌वाबो, “ङा मस्वान बेर नु कुकु छ्योवाःयो र्‌वानान ङन इच्छ्या रानै ना तैन वास्ता? ना ङन ङिक जाः।” <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />अन्नैकारन मन चेला मसिनान्न र्‌वानान्न ल्होई भाइवन घूँ फेल्बो। येसुई नु मसिनान्न र्‌वापा मह्‌या, जेङ्नै “ङा मस्वान बेर नु कुकु छ्योवायो र्‌वानान ङन इच्छ्या रानै ना तै?” र्‌वापा ङ्याह्। <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />नु मनै चेला जेङ्पा, सुई अन ल्होईन भारेः बयान बिङ्‌ङ, रे अन ल्होई सर्पा ङ्याह्, आलै ङी क्युई ङिह्पा कि नुन साँचि तेम्मा ङिह्पा।<verse eid="JHN 21:24" /></para>
  <para style="s">अन्त्यन</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />येसुई घङ यङ लै धोन खेबो। मन्न बर्ग पुरून भारेः ती ती खेखे सर्नान जेङ्न, ङा झाम लाई राँ, कि मन भारेः सर्पा किताबव सन्सारभरी यङ स्योङ्नान मह्‌या।<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>