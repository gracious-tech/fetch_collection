<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Bekwel Bible</book>
  <para style="h">Lɔm</para>
  <para style="toc1">Mɛkana ɛ Pɔl nakwyal bot ɛ ghaada Lɔm ɛ</para>
  <para style="toc2">Lɔm</para>
  <para style="toc3">Lɔm</para>
  <para style="mt2">Mɛkana ɛ Pɔl nakwyal bot ɛ ghaada</para>
  <para style="mt1">Lɔm ɛ</para>
  <para style="imt1">Ɛniel</para>
  <para style="imt2">Ɛsuk ɛ etɛp ee mɛkana mak nakwyalaa ɛ</para>
  <para style="ip">Mɛkana mak ɛ́ mɛkana ɛ Pɔl nakwyal nɛ bot ɛ di edum koŋ nɛ Zɛɛb pɛ kɔ ghaada Lɔm ɔ. Ye nabɛ ɛ́, nyɛ dinaa ààkum penek, yɛ ɛ́ dhiiti mot ɛ nagoola bɛ Mbɛɛ Bhaadal nɛ ɛduu ɛ́ bɛ Zɛɛb. Pɔl nakwyal bɛmɛkana mak ɛ́, étɛp bɛ neegu nyɛ. Dum nɛ tɛp tak ɛ nyɛ di eke nɛ nɔɔ náá, é ghɛŋ nyɛ aadi etɔ́ pɛ kyee dik Ɛspanyɛ ɛ, nyɛ waadhaa pɛ daa lɔɔ, étɛp nyɛ needjɛ bɛ mɛghaaz tɔ mɛsa mɛ Klisto. Nyɛ naabaake nɛ nɔɔ náá, bɛ djaala étɛp nyɛ neebela ghwyil ɛtɔ́ mɛdjoŋ.</para>
  <para style="ip">Tɔ mɛkana mak, Pɔl naalyaal bɛ náá, ɛdum ɛ koŋ nɛ Klisto ɛ́ mbɛɛ sonok. Nyɛ nake ɛ́ náá, yɛ ɛ́ bot ɛ bɔs djas ɛ nasa mesyem, étɛp tak ɛ, bɛ di ààbela duma ɛ Zɛɛb. Tin, nenak, bɛ ɛ́ nɛ ghwyil ɛbula tɔ ɛgwakel nɛ nɛ, tɔ ɛgwakel nɛ Yezu Klisto. Zɛɛb naasɛ́ɛ Pɔl étɛp nyɛ needi mot-lwoma, étɛp ɛgoola Mbɛɛ Bhaadal. Pɔl naake náá, embɛɛ mɛkpa menek ɛ́ mɛbwala ɛ Zɛɛb étɛp bot djas di edum koŋ nɛ Zɛɛb ɔ. É di'enek, mot tok nɛ ghwyil ɛke náá, nwyak mot ɛ́ mot mbyak eYuda nɛghu nwyak mot tok mot mbyak eYuda. Etɛɛ náá, pɛ daa Zɛɛb, bot djas di edum koŋ nɛ Zɛɛb ɔ, bɛ ɛ́ djala, ye tok nɛ mot di edhaa mɔɔ sɔ. Nyɛ naasa náá, bɛ di bot ɛ epiki, dáa Ekwyala di elɛɛ ɛ. Deenek, Ekwyala lɛɛ ɛ́ náá: «Mot epiki aadi nɛ tsik ɛ́ tɔ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb» (<char style="xt"><ref loc="ROM 1:17">1.17</ref></char>). Pɔl naabaake náá, bɔɔ djas, bot ɛ di edum koŋ nɛ Zɛɛb ɔ, goka ɛ́ nɛ ɛdi tɔ ɛgwakel, sa mot ààbhina sɔ mot, sa nyɛ ààkwyesal mɔɔ sɔ mot ndjɛ sɔs, sa nyɛ ààpɛ́ɛ sɔ mot, ye nakoobɛ náá, mɛfulu mɔɔ tok djala.</para>
  <para style="ip">Mɛkana mak, mɛkana mɛ Pɔl nakwyal nɛ bot ɛ ghaada Lɔm ɛ́ nadyeebalii ɛ́ tɛp enɛm esa, kana dwoo lenek, ekeletyɛ naamyaala nɛ yɛ ɛnyɔɛpe.</para>
  <para style="ip">Mɛtsek mɛ mɛkana mɛ tak ɛ́:</para>
  <para style="io1">Pɔl naagoola Mbɛɛ Bhaadal (<char style="xt"><ref loc="ROM 1:1-17">1.1-17</ref></char>);</para>
  <para style="io1">yɛ ɛ́ bot ɛ bɔs djas ɛ nasyem (<char style="xt"><ref loc="ROM 1:18-3:20">1.18–3.20</ref></char>);</para>
  <para style="io1">dáa Zɛɛb nasa náá bot ɛ bɔs bela epiki ɛ (<char style="xt"><ref loc="ROM 3:21-4:25">3.21–4.25</ref></char>);</para>
  <para style="io1">bot ɛ zedum koŋ bɛ Zɛɛb ɔ waabela tsik na bes (<char style="xt"><ref loc="ROM 5:1-8:39">5.1–8.39</ref></char>);</para>
  <para style="io1">Zɛɛb eebet bot ɛ mbyak Yisalaɛl, tin, yɛ ɛ́ étɛp ba mɔɔ ɛwala (<char style="xt"><ref loc="ROM 9:1-11:36">9.1–11.36</ref></char>);</para>
  <para style="io1">tsik na bes tɔ mɛkwyɛla (<char style="xt"><ref loc="ROM 12:1-15:13">12.1–15.13</ref></char>);</para>
  <para style="io1">sa Pɔl namyam ɛsa ɛ, nɛ mɛswosel (<char style="xt"><ref loc="ROM 15:14-16:27">15.14–16.27</ref></char>).</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s1">Mɛswosel</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Yɛ ɛ́ mam Pɔl, mot-mɛsa ɛ Yezu Klisto. Zɛɛb ɛ nadjóo mɛ, nyɛy ɛ nasɛ́ɛ mɛ étɛp mɛ needi mot-lwoma, mɛ neegoola bin Mbɛɛ Bhaadal yɛ.<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />Zɛɛb naalookɛk Mbɛɛ Bhaadal tak nɛ bɛngoolel ɛ mɛkpa mɛ tɔ Ekwyala na dɛɛ<note caller="*" style="x"><char style="xo" closed="false">1.2 </char><char style="xt" closed="false"><ref loc="ISA 52:7">Eza 52.7</ref>; <ref loc="ISA 61:1">61.1</ref></char></note>. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Mbɛɛ Bhaadal tak lii ɛ́ kɔ ɛsu ɛ mɔn'ɛ Yezu Klisto Ghɛŋ'enaka. Nyɛ nabyel kɔ bɔs ɛ́ dáa bot djas di ebyel ɛ, tɔ lɔɔg mɛbyel mɛ bɛdha ɛ mɛkoozi Dhavid<note caller="*" style="x"><char style="xo" closed="false">1.3 </char><char style="xq" closed="false">bɛdha ɛ mɛkoozi Dhavid </char><char style="xt" closed="false"><ref loc="MAT 1:1">Mat 1.1</ref></char></note>. <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Nɛ mɛbwala mɛ Sisim na Dɛɛ, Zɛɛb naalyaal náá, Yezu Klisto Ghɛŋ'enaka ɛ́ Mɔn ɛ Zɛɛb<note caller="*" style="x"><char style="xo" closed="false">1.4 </char><char style="xq" closed="false">Mɔn ɛ Zɛɛb</char><char style="xt" closed="false"><ref loc="PSA 2:7">Mɛd 2.7</ref></char></note>, é sok nyɛ nagomal nyɛ pak bɛmyoŋ ɛ. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Nyɛy ɛ nasa náá, mɛ bela enɛm nɛ embɛɛ Zɛɛb ee mɛ di mos mot-lwom'aak. Etɛɛ náá, bot ɛ membyak mɛ sis djas needum koŋ nɛ Zɛɛb, nɛ ɛlooba nɛ nɛ, étɛp ɛdjɛ duu nɛ Klisto. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Biyɔ pe ɛ́ tɔ lɔɔg bot ɛ tak. Biyɔ, bot ɛ Yezu Klisto nasɛ́ɛ étɛp bi needi bot bɛ ɔ.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Mɛ kwyal mɛkana mak ɛ́ étɛp biyɔ djas, bot ɛ di pɛ ghaada Lɔm ɔ, biyɔ bot ɛ Zɛɛb di ekwyɛl ɔ, biyɔ bot ɛ Zɛɛb nazesɛ́ɛ étɛp bi needi bot ɛ na dɛɛ ɔ. Beta náá, Zɛɛb Sɛɛg'enaka nɛ Ghɛŋ Yezu Klisto djɛ bin enɛm nɛ embɛɛ nɛ egwyem.<verse eid="ROM 1:7" /></para>
  <para style="s1">Pɔl ɛpekwyɛl ɛtɔ́ kɛbee bot ɛ ezɛɛga mendjaala ghaada Lɔm</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Mɛ pookokan sok ɛ, ɛbulal bhɔɔ nɛ Zɛɛb'am nɛ din ɛ Yezu Klisto kɔ ɛsu ɛ len. Etɛɛ náá, bhwak djas ɛpelii ɛnyɔɛpe kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ len nɛ Zɛɛb. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Zɛɛb nɛ gu náá, sa mɛ di elɛɛ ɛ, yɛ ɛ́ etɛp etsɛɛtsɛ, nyɛy mot mɛ di esa mɛsa mɛ yii ɛgoola Mbɛɛ Bhaadal kɔ ɛsu ɛ Mɔn'ɛ nɛ lyem wat ɔ. Nyɛ nɛ gu náá, mɛ nɛ djaala étɛp'en ngwyis. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />É mɛwala djas mɛ di edjaala ɛ́, mɛ nɛ waab nɛ Zɛɛb náá, nyɛ djɛ mɛ ze ɛzyɛ pɛ yebɔ, yɛ bɛ náá, yɛ ɛ́ ɛkwosak ɛ lɛ ɔɔ. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Deenek, mɛ ɛ́ nɛ gwyes ɛboma nɛ nen dhaa tyɛ, étɛp bi neebela ɛkɛɛ ɛ Sisim na Dɛɛ, étɛp bi neebela mɛghaaz. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Tin, baabela náá, mɛ kwyɛl ɛ́ mɛ di é di wat nɛ nen étɛp bot needjɛelka mɛghaaz tɔ ɛdum ɛ koŋ ɛ lenaka nɛ Zɛɛb mena dika nɛ yɛ sama'aak. <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />Bɔn-nyɛɛg bam, mɛ kwyɛl ɛ́ bi gu náá, mɛ nɛ dyeebagek ɛzyɛ pɛ yebɔ. Tin, mɛ dinaa ààpabela ze ɛzyɛ penek dɔɔ nɛ dwoo pan mos'ak. Mɛ kwyɛl ɛ́ náá, mɛsa mam baaloo pɛ yebɔ pe, dáa ye naloo pɛ kyee bot ɛ membyak mɛ sis ɛ. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Ye goka ɛ́, mɛ tɔ́ pɛ daa bot djas, bot ɛ mbyak eGhɛlɛk nɛ bot ɛ di ààbɛ tɔ bot ɛ mbyak eGhɛlɛk ɔ, pɛ daa bot ɛ di egu mɛkana ɔ, nɛ pɛ daa bot ɛ di ààgu mɛkana ɔ. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Yɛ ɛ́ étɛp tak ɛ mɛ di nɛ gwyes dhaa tyɛ étɛp ɛzɛgoola bin Mbɛɛ Bhaadal, biyɔ bot ɛ di kɔ ghaada Lɔm ɔ.<verse eid="ROM 1:15" /></para>
  <para style="s1">Mɛbwala mɛ Mbɛɛ Bhaadal</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Mɛ tok nɛ sen nɛ Mbɛɛ Bhaadal, etɛɛ náá, yɛ ɛ́ mɛbwala mɛ Zɛɛb dyeebasa étɛp ɛtsik ɛ́ bot ɛ di edum koŋ nɛ Zɛɛb ɔ. Bot ɛ nyɛ aatsik sok ɔ, yɛ aadi ɛ́ bot ɛ mbyak eYuda, bhii tak, bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Tin, Mbɛɛ Bhaadal lyaal ɛ́ dhatyee Zɛɛb di enɛɛg mot piki é mis mɛ ɛ. Yɛ ɛ́ kɔ ɛsu ɛdum ɛ koŋ nɛ Zɛɛb, kana mɛkɛn kɛkum pɛ ɛsik dhatyee Ekwyala di elɛɛ ɛ: «Mot di mot epiki kɔ ɛsu ɛ ɛdum ɛ koŋ nɛ Zɛɛb ɔ, nyɛ waatsak<note caller="*" style="x"><char style="xo" closed="false">1.17 </char><char style="xt" closed="false"><ref loc="HAB 2:4">Hab 2.4</ref></char></note>.»<verse eid="ROM 1:17" /></para>
  <para style="s1">Bot ɛ bɔs djas ɛ́ nɛ mesyem sok bhwoob ɛ Zɛɛb</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Tin, pɛ tɔ gwoo, Zɛɛb ɛpelyaal ɛbuk ɛ lɛ kɔ bot djas di esa mesyem ɔ, bot ɛ di ààkɛ tɔ epiki ɔ. Etɛɛ náá, embee mɛsa mɔɔ ɛpelu bot náá, bɛ nàgu etsɛɛtsɛ dum nɛ Zɛɛb. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Bela náá, sa di egoka náá, bot gu dum nɛ Zɛɛb ɛ, yɛ ɛ́ popoopwon é mis mɔɔ. Zɛɛb nyɛ ɛmet naatel bɛ yɛ popoopwon. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Mɛbwala ɛ Zɛɛb nɛ konyel Zɛɛb nyɛy nyɛ ɛmet, yɛ ɛ́ esa ee di náá, bot tok nɛ ghwyil ɛbee yɛ popoopwon ɛ. Tin, kana dwoo Zɛɛb nakus bhwak ɛ, kɛyaka nɛ dwoo pan mos'aak, tsoŋ mot ɛ́ nɛ ghwyil ɛgu yɛ ɛnyɔɛpe, é ghɛŋ nyɛ di ebee esa ee Zɛɛb di esa ɛ. É di'enek, bot ɛ bɔs tok nɛ dhiiti mɛgham mɛ bɛ aasa náá, bɛ nàgu Zɛɛb ɛ. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Bɛ nɛ gu Zɛɛb, tin, bɛ ààduwal nyɛ, bɛ ààbee nyɛ dáa Zɛɛb, bɛ ààbulal bhɔɔ nɛ Zɛɛb dáa ye di egoka ɛ. Bela náá, egeka bɔɔ moo ɛ́ yii ewo, epila elyem bɔɔ eezedipal bɛ mis. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Deenek, bɛ dyeebaghɛɛ mɛnyel ɛ́ náá, bɛ ɛ́ bɛtsoŋ ɛ bot, ghuna bɛ ɛpelyet. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Tin, edi di egoka náá, bɛ duwal duma Zɛɛb mot di náá, nyɛ aanàboogwyɛ ɔ, bɔɔ duwal ɛ́ bɛnaghisɛ di ekpaka tyee bot, tyee enen, tyee bɛtit ɛ di nɛ mɛko mɛná ɔ, nɛ bɛdhiiti nakpakaa tyee edjaadela-djaadela ɔ.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Dum nɛ tɛp tak ɛ, Zɛɛb zedhuugal bɛ tɔ embee esesɛɛ e mɛkwosak mɛ elyem bɔɔ. Deenek, bɛ kadi ɛ́ esa mɛsa mɛ sen di eghwyalal mɛnyel mɔɔ met ɛ. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />É di'enek, bɛ ɛpebet etɛp etsɛɛtsɛ e Zɛɛb, étɛp ɛdu etɛp e etsal. Tin, bɛ kaduwal ɛ́ esa ee Zɛɛb nakus ɛ, ààduwal kusel tak nyɛy nyɛ ɛmet, mot di egoka nɛ ɛduwalaa kɔm-kɔm sii nɛ kɔm ɔ! <char style="sc">Amɛn</char>.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Dum nɛ tɛp tak ɛ, Zɛɛb zedhuugal bɛ tɔ mbee mɛzɔ di eghwyalal mɛnyel mɔɔ ɛ. Tin, boa ààkadi mɛba nɛ botom, bɛ kadiel mɛba ɛ́ pak'ɔɔ boa nɛ boa. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Tyee wat nɛ boa, botom pe ààkadi mɛba nɛ boa. Bɛ kadiel mɛba ɛ́ pak'ɔɔ botom nɛ botom. Yɛ ɛ́ deenek ɛ́ bɛ di ebela efute e embee esesɛɛ di esa náá, bɛ wo ze ɛ.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Dáa ye di náá, bɛ eebyen ɛdum ɛ koŋ nɛ Zɛɛb ɛ, Zɛɛb eezelum bɛ koŋ nɛ esiiza bɔɔ yii ewo, tin, bɛ ɛpesa esa ee di ààgoka nɛ ɛsael ɛ. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Deenek, bɛ moo ɛ́ nɛ bɛtɛ nɛ membi mɛ mɛsa mɛ di ààbɛ tɔ epiki ɛ, ɛbiyo, mbee dɔɔb, embee mɛsa, lyem zok, ɛgó ɛ bot, mɛwɔ, mbee mɛpek, mɛkɔŋ. Bɛ ɛpesu etɛp nɛ min mɛ bɛsɔ bɔɔ, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />bɛ ɛ́ bot ɛ mɛbhekel, bɛ ɛ́ bot ɛ mɛbhuka ɛ Zɛɛb, bɛ ààkaab bot, bɛ ɛ́ bot ɛ ɛbet, bot ɛ ɛghɛɛa nyel. Bɛ ɛ́ nɛ mɛpek mɛ ɛsa embee esesɛɛ, bɛ ààkaab bɛsɛɛg bɔɔ nɛ bɛnyɛɛg bɔɔ. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />Bɛ ààtselal, bɛ ààsa sa bɛ di elɛɛ ɛ, bɛ nɛ lyel elyem, ààbɛ nɛ ghoŋ nɛ bɛsɔ bɔɔ. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Tin, bɛ nɛ gu epɛ́ɛ e Zɛɛb ɛnyɔɛpe. Bot ɛ di ekɛ deenek ɔ, bɛ goka ɛ́ nɛ ɛsyee. É di'enek, bɛ ààzosik é ɛsa esɛsɛɛ binek nɛ esɛsɛɛ binek, bɛ ɛpemyaal bot ɛ di esa embee mɛsa menek ɔ.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s1">Epɛ́ɛ e Zɛɛb</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Wɔy, ye nakoozodi náá wɔ ɛ́ ɛzɛ, wɔy mot di epɛ́ɛ bɛsɔ bɔ ɔ, gua náá, wɔ aanàbela ɛpelak<note caller="*" style="x"><char style="xo" closed="false">2.1 </char><char style="xt" closed="false"><ref loc="MAT 7:1">Mat 7.1</ref>; <ref loc="LUK 6:37">Luk 6.37</ref></char></note>. Etɛɛ náá, wɔ di epɛ́ɛ bɛsɔ bɔ, da wɔ ɛ́ baadi ekɛ dáa bɔɔ ɔ, deenek, wɔy ɛmet ɛpewa nyel'ɔ é feŋ. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Mena nɛ guka náá, epɛ́ɛ e Zɛɛb ɛ́ tsɛɛtsɛ dum nɛ mbi bot ɛ di esa esesɛɛ binek ɔ. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Wɔy mot di epɛ́ɛ bot ɛ di esa embee esesɛɛ binek, da wɔ ɛ́ baadi esa esesɛɛ tak ɔ, wɔ gek ɛ́ náá, wɔ aadi ɛ́ kyiid tɔ epɛ́ɛ e Zɛɛb é? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Nɛghu, wɔ kwyɛl ɛ́ ɛbyasal boo enɛm esa e Zɛɛb, nɛ ɛdil ɛ lyem'ɛ nɛ mbɛɛ lyem'ɛ? Wɔ ààgu náá, boo enɛm esa e Zɛɛb ɛ́ kwaasa náá, wɔ swoola tsik é? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Tin, wɔ ɛpesa maa-ɛlɔ, wɔ ààkwyɛl ɛswoola mɛfulu. Yɛ ɛ́ étɛp tak ɛ wɔ di esɛɛg boo ɛbuk ɛ Zɛɛb kɔ nyel'ɔ endita-endita, dwoo Zɛɛb aatel boo ɛbuk ɛ lɛ tɔ epɛ́ɛ bɛ e piki ɛ. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Nyɛ waadjɛ mot nɛ mot efute mɛsa mɛ nyɛ nadi esa ɛ. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />É di'enek, nyɛ aadjɛ tsik na kɔm-kɔm ɛ́, nɛ bot ɛ di wa zii tɔ ɛsa enɛm esa, nɛ ɛsaŋ ɛ duma, duu, nɛ tsik na kɔm-kɔm ɔ. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Tin, nyɛ aatel boo ɛbuk ɛ lɛ ɛ́ nɛ bot ɛ di ààlooba nɛ nɛ ɔ, bot ɛ di ààkwyɛl ɛlooba nɛ etsɛɛtsɛ, da looba nɛ etɛp di ààbɛ tɔ epiki ɛ. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Bot djas di esa ɛbiyo ɔ, bɛ waabee mezuk nɛ bɛbebwol, yɛ aakan ɛ́ nɛ bot ɛ mbyak eYuda, zɛnɔɔ bot ɛ mbyak eGhɛlɛk. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />É di'enek, Zɛɛb ɛ́ waadjɛ duma, duu, egwyem nɛ bot djas di esa sa mɛnyɔ ɔ, yɛ aakan ɛ́ nɛ bot ɛ mbyak eYuda, zɛnɔɔ bot ɛ mbyak eGhɛlɛk, <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />etɛɛ náá, Zɛɛb ààwa mbɛk pak bot.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Bot ɛ di esyem ààgu etsi ɛ Moiiz ɔ, bɛ waagwyɛ pe ɛ́ ààbɛ nɛ etsi. Tin, bot ɛ di esyem, bɔɔ é gu etsi ɛ Moiiz ɔ, bɛ waapɛ́ɛaa ɛ́ dum nɛ etsi tak. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Etɛɛ náá, bot ɛ di bot ɛ epiki é mis ɛ Zɛɛb ɔ, ye tok bot ɛ di náá, bɔɔ zosik ɛ é ɛgwak etsi ɛ Moiiz ɔ. Tin, bot ɛ di bot ɛ epiki é mis ɛ Zɛɛb ɔ, yɛ ɛ́ bot ɛ di ewa etsi tak tɔ mɛsa ɔ. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />É ghɛŋ bot ɛ di ààbɛ bot ɛ mbyak eYuda, bot ɛ di ààgu etsi ɛ Moiiz di elooba nɛ etsi bɔɔ bɛmet ɔ. Yɛ ɛ́ ɛkɛɛ, etsi tak ɛ́ nɛ nɔɔ ɛ́ baala tɔ elyem, ye nakoozodi náá, bɛ tok nɛ yɛ. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Tin, bɛ lyaal deenek ɛ́, sa etsi di elyo náá, mot sa ɛ, yɛ ɛ́ kwyala tɔ elyem bɔɔ. Egeka e lyem bɔɔ ɛpelyaal yɛ, deenek, esiiza bɔɔ nɛ pit bɛ é dhiiti mɛwala, da baakɛm bɛ é yak mɛwala. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Etɛp binek djas aanyen ɛ́ dwoo Zɛɛb aapɛ́ɛ esa djas di syela tɔ tsik mot nɛ mot é ze ɛ Yezu Klisto ɛ. Yɛ ɛ́ sa Mbɛɛ Bhaadal mɛ di egoola ɛ di elɛɛ ɛ.<verse eid="ROM 2:16" /></para>
  <para style="s1">EYuda nɛ etsi</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Tin, wɔy mot di nɛ din ɛ mot mbyak eYuda ɔ, ɛbwaalel ɛ lɔ ɛ́ pɛ tɔ etsi, wɔ nɛ ben nyel kɔ ɛsu ɛ Zɛɛb'ɔ. <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />Wɔ nɛ gu ɛkwosak ɛ lɛ, etsi naalyo dáa wɔ di egoka nɛ ɛwa mbɛk pak mɛnyɔ nɛ ɛbiyo ɛ. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />Wɔ bee ɛ́ náá, wɔy ɛ́ ndjɛɛdel bot ɛ edhim, wɔy ɛ́ gwyɛ bot ɛ di tɔ ghooghom ɔ. <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />Wɔy ɛ́ lyoel bot ɛ di ààgu mɛdjek ɔ, lyoel bɔɔ dhyeeb, etɛɛ náá wɔy eezemyaal nɛ lyem wat náá, etsi ɛpesa náá, wɔ di mot di egu etɛp ɔ, mot di egu etsɛɛtsɛ ɔ. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />Tin, wɔy, mot di elyo bɛsɔ bɔ ɔ, étɛp yé wɔ di ààlyo nyel'ɔ met? Wɔy, mot di egoola bɛsɔ bɔ Mbɛɛ Bhaadal náá, bɛ nàdjii ɔ, étɛp yé wɔ di edjii? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Wɔy, mot di elu bot náá, bɛ nàsa ɛzɔ ɔ, étɛp yé wɔy di esa yɛ? Wɔy, mot di ebyen bɛnaghisɛ ɔ, étɛp yé wɔ di ekɛdjii esa ee di tɔ mendjaa mɛ bɛzɛɛb bɔɔ ɛ? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Wɔ nɛ sa ɛghɛɛa nyel kɔ ɛsu ɛ etsi, tin, wɔ kadi ɛ́ ààdjɛ Zɛɛb duu, é sok wɔ di esa sa etsi di elu ɛ! <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Tin, Ekwyala lɛɛ ɛ́ náá: «Dum nɛ etɛp bi di esa ɛ, bɛdhiiti membyak ɛpenyek Zɛɛb<note caller="*" style="x"><char style="xo" closed="false">2.24 </char><char style="xt" closed="false"><ref loc="ISA 52:5">Eza 52.5</ref></char></note>.»<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Ɛni ɛ́ beka val ɛ, yɛ bɛ náá, wɔ ɛpelooba nɛ etsi ɔɔ. Tin, wɔ kadi ààlooba nɛ etsi ɔɔ, yɛ ɛ́ ɛkɛɛ wɔ ààpani beka. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Tin, mot di ààni beka ɔ, nyɛ looba nɛ mɛtiŋ mɛ etsi ɔɔ, Zɛɛb aanàkwaabee nyɛ tyee mot zeni beka ɔ? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Tin, mot di ààni beka ɔ, nyɛ looba nɛ etsi ɔɔ, nyɛ waapɛ́ɛ wɔ, wɔy mot di ààlooba nɛ etsi ɔ, ye nakoozodi náá, wɔ nɛ gu mɛkana mɛ etsi nɛ náá, wɔ naaniigelaa beka. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />É di'enek, tɛtɛ mot mbyak eYuda tok mot di etel é mis mɛ bot náá, nyɛ ɛ́ Yuda ɔ. Tɛtɛ Yuda tok pe mot di nɛ bam pyoŋ beka é nyel ɔ. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Tin, tɛtɛ mot mbyak eYuda ɛ́ mot di ààdiig bet é mis mɛ bot ɔ, yɛ ɛ́ mot naniigelaa beka tɔ lyem'ɛ ɔ, beka tak ɛ́ yii Sisim Zɛɛb, ààbɛ yii etsi. Tɛtɛ mot mbyak e Yuda bela duu ɛ́ nɛ Zɛɛb, ààkabɛ nɛ bot ɛ bɔs.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Ɛdi ɛ́ mot mbyak eYuda kwyɛl ɛlɛɛ ɛ́, wɔ eedhaa bot djas é? Ɛni ɛ́ beka ɛ́ ɛpeval dhiiti sonok é? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Tsɛɛtsɛ, yɛ ɛ́ nɛ boo mɛtaŋ tɔ bɛtɛ nɛ esonok. Yii mɛkɛn ɛ́ náá, Zɛɛb naleekan ɛdjɛ mɛkpa mɛ ɛ́ nɛ bot ɛ mbyak eYuda. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Yɛ ɛ́ tsɛɛtsɛ náá, bɛdhiiti bot pak'ɔɔ nabɛ ɛ́ ààdi sosoob nɛ Zɛɛb. Tin, ye kakwyɛl ɛlɛɛ ɛ́ náá, Zɛɛb ɛ́ waakat ɛdi ɛ́ sosoob etɛɛ náá, bɛ tok sosoob é? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Ààbɛ deenek! Yɛ ɛ́ kobɛ náá, bot ɛ bɔs djas ɛ́ bot ɛ etsal ɔɔ, ye goka ɛ́, ye nyen popoopwon náá, Zɛɛb ɛ́ mot etsɛɛtsɛ. Yɛ ɛ́ tsɛɛtsɛ, Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 3:4">«Ye goka ɛ́ náá,</para>
  <para style="q1" vid="ROM 3:4">bot gu epiki bɔ, tɔ mɛkpa mɔ.</para>
  <para style="q1" vid="ROM 3:4">Tin, mot ɛ pit wɔ ɔɔ,</para>
  <para style="q1" vid="ROM 3:4">wɔ pɛ́ɛaa ɔɔ,</para>
  <para style="q1" vid="ROM 3:4">wɔ goka ɛ́ nɛ ɛdi nɛ gham<note caller="*" style="x"><char style="xo" closed="false">3.4 </char><char style="xt" closed="false"><ref loc="PSA 116:11">Mɛd 116.11</ref>; <ref loc="PSA 51:6">Mɛd 51.6</ref> </char></note>.»<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Tin, yɛ bɛ náá, embee mɛsa mɛ mena di esa ɛ, ye ɛpesa náá, epiki e Zɛɛb nyen popoopwon é mwos dwoo ɔɔ, haaa mena aakabaake dáa? Zɛɛb ɛ́ ɛbiyoɛpe etɛɛ náá, nyɛ eewa mena é feŋ é? Mɛ kalii wak ɛ́ dáa bot djas di elii ɛ. <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Yɛ aanàkwaasael deenek! Etɛɛ náá, yɛ ɛpedi ɛ́ di deenek ɔɔ, pe Zɛɛb aakasa dáa étɛp ɛpɛ́ɛ bot ɛ bɔs?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />Yɛ bɛ náá, etsal bam ɛpesa náá, etsɛɛtsɛ e Zɛɛb nyen popoopwon étɛp ɛlyaal duma yɛ ɔɔ, haaa, étɛp yé mɛ baadi epɛ́ɛaa dáa mot mesyem? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Bɛdhiiti bot ɛ di ààkɛ tɔ epiki di eke náá: «Djhoosaka ɛbiyo, etɛɛ náá, enɛm esa neenyen.» Bot binɔk ɛpebyak mɛ, bɛ ɛpeke náá, yɛ ɛ́ mɛkpa mam. Mbi binɔk bot ɛ́ waawaaa é feŋ di egoka nɛ nɔɔ ɛ.<verse eid="ROM 3:8" /></para>
  <para style="s1">Ye tok nɛ mot epiki é mis ɛ Zɛɛb</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Yɛ ɛ́ dáa? Ye kabɛ ɛ́ náá, menabɛlka bot ɛ mbyak eYuda eedhaa bot ɛ membyak mɛ sis é? Ààbɛ! Mɛ naazeloolyaal náá, bot djas, ye nakoozodi bot ɛ mbyak eYuda nɛghu bot ɛ mbyak eGhɛlɛk, bɔɔ djas ɛ́ si bhel mesyem. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />É di'enek, Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 3:10">«Ye tok nɛ mot di piki,</para>
  <para style="q1" vid="ROM 3:10">ààkobɛ-bɛak mot ngɔt,<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />ye tok nɛ mot di etselal,</para>
  <para style="q1" vid="ROM 3:11">ye tok nɛ mot di esaa Zɛɛb.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Deenek, bɛ tokapɛ é tɛtɛ ze,</para>
  <para style="q1" vid="ROM 3:12">bɔɔ djas eezewo ze.</para>
  <para style="q1" vid="ROM 3:12">Ye tok nɛ mot di esa enɛm esa,</para>
  <para style="q1" vid="ROM 3:12">ààkobɛ-bɛak mot ngɔt.<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />Egheŋel-gheŋel bɔɔ moo ɛ́ dáa ɛvit ɛ di náá, yɛ ɛ́ mbek ɛ,</para>
  <para style="q1" vid="ROM 3:13">edjem bɔɔ kagu ɛ́ mɛkɔŋ,</para>
  <para style="q1" vid="ROM 3:13">sa di ewyis kɔ ekwood e enuub bɔɔ moo ɛ́ dáa neya ɛgel,<verse eid="ROM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14" />enuub bɔɔ moo ɛ́ tɔɔɔ nɛ ekɛlok, nɛ embee mɛkpa àànyɔ.<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />Bɛ nɛ kwyɛs ɛ́ mɛko étɛp ɛgó ɛ bot.<verse eid="ROM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16" />É edi djas bɛ di edhaŋ ɛ, yɛ ɛ́ puluk,</para>
  <para style="q1" vid="ROM 3:16">tin bɛ ɛpewa bot tɔ tsik mezuk.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Bɛ ààkwyɛl ɛdi tɔ ɛgwakel nɛ bɔn-nyɛɛg bɔɔ.<verse eid="ROM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18" />Bɛ ààkaab Zɛɛb<note caller="+" style="f"><char style="fr" closed="false">3.18 </char><char style="ft" closed="false">Étɛp mɛlaŋel 10-12: <char style="xt"><ref loc="PSA 14:1-3">Mɛd 14.1-3</ref>; <ref loc="PSA 53:2-4">53.2-4</ref></char>; Ye nɔŋel ɛ́ tɔ mɛkana mɛ namwa tɔ lii eGhɛlɛk. Étɛp ɛlaŋel ɛ 13: <char style="xt"><ref loc="PSA 5:10">Mɛd 5.10</ref></char>. Ye nɔŋel ɛ́ tɔ mɛkana mɛ namwa tɔ lii eGhɛlɛk. <char style="xt"><ref loc="PSA 140:4">Mɛd 140.4</ref></char>. Étɛp ɛlaŋel 14: <char style="xt"><ref loc="PSA 10:7">Mɛd 10.7</ref></char> Ye nɔŋel ɛ́ tɔ mɛkana mɛ namwa tɔ lii eGhɛlɛk. Étɛp ɛlaŋel 15-17: <char style="xt"><ref loc="ISA 59:7-8">Eza 59.7-8</ref></char>. Étɛp ɛlaŋel 18: <char style="xt"><ref loc="PSA 36:2">Mɛd 36.2</ref></char>.</char></note>.»<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Bis nɛ gu náá, esa djas Etsi di elii ɛ, ye lii ɛ́ nɛ bot ɛ di si etsi ɔ. Etɛɛ náá, bot needi ààbɛɛ nuub étɛp ɛtaŋal. Deenek, étɛp bot ɛ bɔs djas needi nɛ ndjɛ é mis ɛ Zɛɛb. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Etɛɛ náá, ye tok nɛ mot aadi piki é mis ɛ Zɛɛb kɔ ɛsu ɛlooba nɛ etsi, bela náá, etsi lyaal ɛ́ esyem mɛ mot di esa ɛ.<verse eid="ROM 3:20" /></para>
  <para style="s1">Dáa Zɛɛb di esa náá mot di piki ɛ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Nenak yak, Zɛɛb eezetel mena dáa nyɛ di esa náá, mena dika bot ɛ epiki é mis mɛ, ààbɛ náá, yɛ ɛ́ kɔ ɛsu ɛ etsi ɛ. Bɛmɛkana mɛ etsi dɔɔ nɛ bɛngoolel ɛ Mɛkpa ɛ Zɛɛb naazeloolɛɛ yɛ. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Zɛɛb sa náá, mot di piki é mis mɛ ɛ, kɔ ɛsu ɛ ɛdum koŋ ɛ lɛ nɛ Yezu Klisto. Tin, nyɛ sa yɛ ɛ́ nɛ bot djas di edum koŋ nɛ Klisto ɔ, etɛɛ náá, ye tok nɛ mbɛk pak bot, <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />tin, bot djas naazesyem, duma ɛ Zɛɛb tokapɛ tɔ lɔɔ. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Tin, Zɛɛb tɔ enɛm nɛ embɛɛ bɛ, nyɛ eesa náá, mot di piki é mis mɛ, kɔ ɛsu ɛ Yezu Klisto mot di epɛk bot tɔ mesyem, ààbɛ nɛ efute ɔ. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Nyɛy ɛ́ mot Zɛɛb nasɛ́ɛ étɛp ɛka nyɛ buwa, etɛɛ náá, ghiya yɛ needis bot ɛ di edum koŋ nɛ Zɛɛb ɔ tɔ mesyem. Nyɛ nasa deenek ɛ́ étɛp ɛlyaal epiki bɛ. É ghɛŋ sok, nyɛ nabɛ ɛ́ ààbis mesyem mɛ bot, etɛɛ náá, nyɛ ɛ́ nɛ ɛmaad lyem. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Zɛɛb eelyaal epiki bɛ tɔ mɛlu mɛ mena dika mos'aak. Etɛɛ náá, nyɛ ɛ́ mot epiki, nyɛy ɛ di esa náá, mot di edum koŋ nɛ Yezu ɔ, di pe mot epiki.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />É di'enek, bot ɛ́ waabaadi nɛ gham ɛghɛɛ nyel é? Ààbɛ, haaa! Étɛp yé? Yɛ ɛ́, etɛɛ náá, sa di wak ɛ, ye tokapɛ dum nɛ ɛlooba nɛ etsi, yɛ ɛ́ dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Mena ɛ́ nɛ ghwyil ɛke náá, Zɛɛb bee mot piki ɛ́ kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb, ààkabɛ etɛɛ náá, nyɛ ɛpelooba nɛ etsi djas. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Deenek, Zɛɛb ɛ́ yii bot ɛ mbyak eYuda bɔɔ bɛmet é? Nyɛ tok nɛ ghwyil ɛbaadi Zɛɛb bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ? Tsɛɛtsɛ, nyɛ pe ɛ́ Zɛɛb bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />etɛɛ náá, Zɛɛb ɛ́ ngɔt. Zɛɛb aasa náá, bot ɛ mbyak eYuda di bot ɛ epiki kɔ ɛsu ɛ ɛdum ɛ koŋ nɛ Zɛɛb. Yɛ ɛ́ nyɛy ɛ aabaasa náá, bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ, bɛ di pe bot ɛ epiki kɔ ɛsu ɛ ɛdum ɛ koŋ nɛ Zɛɛb. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Ye kakwyɛl ɛlɛɛ ɛ́ náá, bot ɛ di edum koŋ nɛ Zɛɛb ɔɔ, etsi ààkaval é? Yɛ aanàkwaasael deenek, yɛ ɛ́ náá, bis ɛpedjɛ etsi boo mɛtaŋ.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s1">Djhoopookonɔɔka geka nɛ Abalaam</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Bot aake tin dáa, étɛp Abalaam mot di bhaab'enaka kɔ ɛko ɛ bɔs ɔ? Nyɛ nabela yé dum nɛ nyɛy nyɛ ɛmet? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Yɛ ɛpedi náá, Abalaam nadjɛaa di epiki é mis ɛ Zɛɛb ɛ, kɔ ɛsu ɛ mɛsa mɛ ɔɔ, pe nyɛ ɛ́ nɛ ghwyil ɛdi nɛ ɛghɛɛa nyel. Tin, nyɛ tok nɛ ghwyil ɛghɛɛ nyel é mis ɛ Zɛɛb. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Deenek, Ekwyala lɛɛ ɛ́ náá: «Abalaam naadum koŋ nɛ Zɛɛb, tin, Zɛɛb naadjɛ nyɛ di epiki kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb.» <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Mot di esa mɛsa ɔ, nyɛ goka ɛ́ nɛ ɛdjɛaa efute. Efute tak tok náá, ye djɛaa nyɛ yii toto, yɛ ɛ́ sa nyɛ di egoka nɛ ɛbela ɛ. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Mot ɛ di ààsa mɛsa mɛ etsi di elɛɛ ɔɔ, nyɛ dum koŋ nɛ Zɛɛb mot di epel bot ɛ mesyem ɔɔ, ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb aasa náá, nyɛ djɛaa di epiki. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Mɛmyaala nɛ mot Zɛɛb di edjɛ nyɛ di epiki, ààbee-beeak mɛsa mɛ ɔ. Yɛ ɛ́ deenek ɛ́ Dhavid di eke náá,<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />«Mɛmyaala nɛ bot ɛ di náá, Zɛɛb eepel ɛdjak ɛ lɔɔ ɔ,</para>
  <para style="q1" vid="ROM 4:7">bot ɛ di náá, Zɛɛb eedis mesyem mɔɔ ɔ!<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Mɛmyaala nɛ mot di náá, Ghɛŋ ààbis mesyem mɛ ɔ<note caller="*" style="x"><char style="xo" closed="false">4.8 </char><char style="xt" closed="false"><ref loc="PSA 32:1-2">Mɛd 32.1-2</ref></char></note>!»<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Tin, mɛmyaala menek ɛ́ étɛp bot ɛ zeni beka ohoo, dɔɔ nɛ bot ɛ di náá, bɛ ààpani beka ɔ? Bot aaloo nɛ ɛke wak mbembɛ náá: «Zɛɛb nadjɛ Abalaam di epiki ɛ́, kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb.» <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Etɛp binek nasael é yaa ɛwala? Ye nasael ɛ́ ɛsok nɛ Abalaam nɛ ɛni beka ohoo, ye nasael ɛ́ bhii tak? Ààbɛ, ye nabɛ ɛ́ ààsael bhii tak, ye nasael ɛ́ ɛsok nɛ nyɛ nɛ ni beka. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Bhis Abalaam nadjɛaa di epiki ɛ, nyɛ nakasaaa beka ɛ́ tyee geka di elyaal epiki ɛ. Nyɛ nabela tseŋa tak ɛ́ kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb, é sok nyɛ nabɛ nyɛ dinaa ààni beka ɛ. Yɛ ɛ́ deenek ɛ́ Abalaam nadi nyɛ moo sɛɛg bot ɛ di edum koŋ nɛ Zɛɛb ɔ, etɛɛ náá, Zɛɛb needjɛ bɛ di epiki, ye nakoozodi náá, bɛ ààpani beka. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Deenek, nyɛ pe ɛ́ sɛɛg bot ɛ zeni beka ɔ. Ye kwyɛl ɛlɛɛ ɛ́, ye tok bot ɛ zosik é ɛni ɛ beka nɛ ɛni beka ɔ. Tin, yɛ ɛ́ bot ɛ di ekɛ tɔ ɛdum ɛ koŋ ɛ sɛɛg'enaka Abalaam nadi nɛ yɛ nɛ Zɛɛb, ɛsok nɛ nyɛ nɛ ni beka.<verse eid="ROM 4:12" /></para>
  <para style="s1">Ekɛk e Zɛɛb belaaa ɛ́ tɔ ɛdum koŋ nɛ Zɛɛb</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Zɛɛb naakɛk Abalaam nɛ bɛdha bɛ náá, nyɛ waadjɛ bɛ bhwak, ye needi yɔbɔ. Tin, ekɛk binek nabɛ ɛ́ ààsael etɛɛ náá Abalaam nadi elooba nɛ etsi. Ye nasael ɛ́ etɛɛ náá, Zɛɛb naadjɛ nyɛ di epiki kɔ ɛsu ɛ ɛdum koŋ ɛ lɛ nɛ Zɛɛb. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Yɛ ɛpedi ɛ́ náá, esa ee Zɛɛb nakɛk ɛ, nyɛ nazokɛk yɛ ɛ́ nɛ bot ɛ di elooba nɛ etsi ɔɔ, ye kwyɛl ɛlɛɛ ɛ́ náá, ɛdum ɛ koŋ nɛ Zɛɛb moo ɛ́ ààkabɛ dhiiti vaŋ sonok, tin, ekɛk e Zɛɛb aadi ɛ́ yii toto. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Deenek, etsi ɛ́ di esa náá, ɛbuk ɛ Zɛɛb di kɔ bot. Tin, é di di ààbɛ nɛ tsi ɔ, ye tok nɛ tɛp ɛbyen ɛlooba nɛ tsi.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Yɛ ɛ́ deenek, ekɛk nadjɛaa ɛ́ kɔ ɛsu ɛdum koŋ nɛ Zɛɛb, étɛp ye needi ɛkɛɛ ɛ Zɛɛb nazedjɛ mena ɛ. Yɛ aadi ɛ́ deenek, nɛ bɛdha ɛ Abalaam djas, ààzobɛ-bɛak bot ɛ di elooba nɛ etsi ɔ, yɛ ɛ́ dɔɔ nɛ bot ɛ di edum ɛ koŋ nɛ Zɛɛb dáa Abalaam nadum koŋ nɛ Zɛɛb ɛ. Abalaam ɛ́ sɛɛg menabɛlka djas. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Tin, Ekwyala lɛɛ ɛ́ náá: «Mɛ eesa náá, wɔ di bhaab bɛtɛ nɛ membyak<note caller="*" style="x"><char style="xo" closed="false">4.17 </char><char style="xt" closed="false"><ref loc="GEN 17:5">Mɛk 17.5</ref></char></note>.» Nyɛ ɛ́ sɛɛg'enaka sok bhwoob ɛ Zɛɛb mot nyɛ nadum koŋ nɛ nɛ ɔ. Yɛ ɛ́ Zɛɛb mot di egomal bot ɛ zegwyɛ ɔ, mot di kusel esa ee nadi ààdi sok ɛ. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />Abalaam nabɛ ɛ́ ààwa ɛbwaalel ɛ lɛ é nyel'ɛ met, nyɛ nawa ɛbwaalel ɛ́ tɔ ghwyil ɛ Zɛɛb. Yɛ ɛ́ étɛp tak ɛ nyɛ nadi nyɛ moo «Bhaab bɛtɛ nɛ membyak». Ye nasael ɛ́ dáa Zɛɛb naloolɛɛ nyɛ ɛ: «Yɛ ɛ́ deenek ɛ́ mɛtaŋ mɛ bɛdha bɔ aadi<note caller="*" style="x"><char style="xo" closed="false">4.18 </char><char style="xt" closed="false"><ref loc="GEN 15:5">Mɛk 15.5</ref></char></note>.» <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />É ghɛŋ tak, Abalaam nabɛ ɛ́, nyɛ moo nɛ membu ɛkɛɛ sa yɛ aasa membu dhet (100). É ghɛŋ nyɛ nadi ebee náá, nyɛ moo ekunaa nɛ ɛsyee ɛ, nɛ dáa nyɛ nabee náá, Saala myɛl nabɛ ɛ́ kwyiid ɛ, ɛdum ɛ koŋ ɛ lɛ nabɛ ɛ́ ààbula bhis. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Tin, nyɛ nabɛ ɛ́ ààkat ɛwa ɛbwaalel ɛ lɛ nɛ Zɛɛb, nyɛ nabɛ ɛ́ ààbɛ esa mɛso nɛ ekɛk e Zɛɛb. Tin, ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb naadyeebadjedjɛ nyɛ mɛghaaz, nyɛ nadi ebulal bhɔɔ nɛ Zɛɛb. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Nyɛ nadi ɛ́ nɛ boo ɛbwaalel náá, sa Zɛɛb nakɛk ɛ, nyɛ ɛ́ nɛ ghwyil ɛsa yɛ. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Dum nɛ tɛp tak ɛ́, ye di ekeaa nɛ Abalaam kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb náá: «Zɛɛb naadjɛ nyɛ di epiki.» <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Mɛkpa mɛ di kwyala náá: «Zɛɛb naadjɛ nyɛ di epiki ɛ» ye nabɛ ɛ́ ààkwyalaa kɔ ɛsu Abalaam nyɛ ɛmet. <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />Tin, ye nabaakwyaalaa pe ɛ́, étɛp menabɛlka bot ɛ Zɛɛb zedjɛ di epiki ɔ, menabɛlka bot ɛ di edum koŋ nɛ Zɛɛb, mot nagomal Ghɛŋ'enaka Yezu pak myoŋ ɔ. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Nyɛ naka Yezu é ɛsyee ɛ́, étɛp ɛdjak ɛ lena. Nyɛ naagomal nyɛ pak myoŋ, étɛp ɛdjɛ mena di epiki é mis mɛ.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s1">Ɛdi ɛ́ tɔ ɛgwakel nɛ Zɛɛb</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Dáa ye di náá, Zɛɛb eedjɛ mena di epiki é mis mɛ, kɔ ɛsu ɛdum ɛ koŋ ɛ lena nɛ nɛ ɛ, yɛ ɛ́ mena dika mos tɔ ɛgwakel nɛ nɛ kɔ ɛsu ɛ Ghɛŋ'enaka Yezu Klisto'aak. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Yɛ ɛ́ kɔ ɛsu ɛ ɛdum ɛ koŋ nɛ Yezu ɛ mena belaka ze ɛbela enɛm nɛ embɛɛ e Zɛɛb ee mena dika mos ghiŋ tɔ tak'aak. Yɛ ɛ́ étɛp tak ɛ mena dika tɔ mɛmyaala mɛ ɛbwaalel ɛdi ɛ́ tɔ duma ɛ Zɛɛb. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Ɛbaanyɔ náá, mena baamyaalaka é sok mena dika tɔ mezuk ɛ, etɛɛ náá, mena nɛ guka náá, mezuk nɛ sa náá, mena dika nɛ ɛmaad ɛ lyem. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />Ɛmaad ɛ lyem nɛ sa náá, mena dika nɛ ghwyil ɛpyet tɔ mɛbhowal nɛ zii, da ghwyil ɛpyet tɔ mɛbhowal ɛsa náá, mena dika nɛ ɛbwaalel. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Bela náá, ɛbwaalel ɛlenek ààkɔɔ mena. Etɛɛ náá, é ze ɛ Sisim na Dɛɛ Zɛɛb nadjɛ mena ɛ, nyɛ eesa náá, mena dika nɛ kwyɛl nɛ nɛ tɔ ebhum elyem bena.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Tin, é ghɛŋ mena nadika mena dinaa ààbɛ nɛ ghwyil ɛ, é di'enek ɛ, Klisto nagwyɛ étɛp bot ɛ mesyem, é ɛwala ɛ Zɛɛb nalɛɛ ɛ. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Tin, ye nɛ lyel náá, mot myaal ɛsyee étɛp sɔ mot, ye nakoozodi náá, sɔ tak ɛ́ mot epiki. Deenek, mot ɛ́ nɛ ghwyil ɛbela mɛghaaz mɛ ɛgwyɛ, étɛp mot di esa enɛm esa ɔ. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Tin, Zɛɛb naatel dáa nyɛ di ekwyɛl mena ɛ: Klisto nagwyɛ ɛ́ kɔ ɛsu ɛ lena, é ghɛŋ mena nadika mena dinaa bot ɛ mesyem ɛ. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />Dáa ye di náá, yɛ ɛ́ kɔ ɛsu ɛ buwa nyel'ɛ ɛ, mena moo nenak bot ɛ epiki é mis ɛ Zɛɛb, tin, yɛ ɛ́ tsɛɛtsɛ náá, Klisto aabaatsik mena si ɛbuk ɛ Zɛɛb. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />É ghɛŋ mena nadika mena dinaaka bot ɛ mɛbhuka ɛ Zɛɛb ɛ, nyɛ naabulal ɛgwakel nɛ nena dum nɛ ɛsyee ɛ Mɔn'ɛ. Nenak, dáa ye di náá, Mɔn'ɛ ɛ́ nɛ tsik ɛ, nɛ dáa di náá, nyɛ eebulal ɛgwakel nɛ nena ɛ, yɛ ɛ́ tsɛɛtsɛ náá, nyɛ waatsik mena. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Ye tok yenek nɛ yenek, mena ɛpebaamyaalaka nɛ Zɛɛb dhaa nyel, kɔ ɛsu ɛ Ghɛŋ'enaka Yezu Klisto, nyɛy ɛ́ mot nanɛɛg mena tɔ ɛgwakel nɛ Zɛɛb ɔ.<verse eid="ROM 5:11" /></para>
  <para style="s1">Adam nɛ Yezu Klisto</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Dáa ye di náá syem nani kɔ ɛko ɛ bɔs ɛ, kɔ ɛsu ɛ mot ngɔt, Adam, da syem ɛ́ zɛdul ɛsyee kɔ bɔs ɛ, yɛ ɛ́ deenek ɛ́ ɛsyee nazɛbela bot djas, etɛɛ náá, bot djas naasyem. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Ɛsok nɛ Zɛɛb nɛ djɛ etsi nɛ Moiiz, syem nadi ɛ́ ye moo kɔ bɔs. Tin, dáa etsi nadi ye dinaa ààbɛ tak ɛ, Zɛɛb nabɛ ɛ́ ààdi ebee mesyem mɛ bot ɛ bɔs. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Bela náá, kana é ghɛŋ ɛ Adam, kɛkum é ghɛŋ ɛ Moiiz, ɛsyee nabɛ ɛ́ nɛ ghwyil kɔ bot djas dɔɔ nɛ bot ɛ nadi ààsyem dáa Adam mot nadi ààlooba nɛ sa Zɛɛb nalɛɛ nyɛ ɛ.</para>
  <para style="p" vid="ROM 5:14">Adam nabɛ ɛ́ mbaŋa-mbaŋa mot nadi egoka nɛ ɛzyɛ ɔ. <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />Tin, ɛdjak ɛ Adam tok nɛ ghwyil ɛdi tyee wat nɛ ɛkɛɛ ɛ enɛm nɛ embɛɛ ee Zɛɛb zedjɛ mot kɔ toto ɛ. Yɛ ɛ́ tsɛɛtsɛ náá, zukamwaa nɛ mot naagwyɛ kɔ ɛsu ɛ ɛdjak ɛ mot ngɔt. Tin, enɛm nɛ embɛɛ ee Zɛɛb nadjɛ mena kɔ toto ɛ, yɛ ɛ́ nɛ mɛtaŋ ɛbuɛpe. Ɛkɛɛ ɛ tak nadjɛaa ɛ́ nɛ bot ɛbuɛpe kɔ ɛsu ɛ mot ngot Yezu Klisto. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Deenek, ɛkɛɛ ɛ Zɛɛb di edjɛ ɛ, ye tok tyee wat nɛ syem mot ngɔt nasa ɛ. Syem ɛ Adam naasa náá, Zɛɛb kwyesal bot ɛ bɔs ndjɛ sɔs. Tin, ɛkɛɛ ɛ Zɛɛb nadjɛ bot kɔ toto ɛ, ye naasa náá, bot di epiki é mis mɛ, ye nakoozodi náá bɛ ɛ́ nɛ bɛtɛ nɛ mesyem. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Yɛ bɛ náá, syem mot ngɔt naasa náá, ɛsyee di nɛ ghwyil kɔ bot ɛ bɔs ɔɔ, tin, kɔ ɛsu ɛ mot ngɔt Yezu Klisto, bot eebela enɛm nɛ embɛɛ ɛbuɛpe, nɛ ɛkɛɛ ɛ epiki di esa náá, bot di nɛ tsik, nɛ ɛdi ɛ́ bɛmɛkoozi sama nɛ Yezu Klisto.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Nenak, syem mot ngɔt Adam eesa náá, bot djas kwyeselaa ndjɛ sɔs, yɛ ɛ́ tyee wat, nɛ mɛsa mɛ epiki mɛ mot ngɔt Yezu Klisto nasa náá, bot ɛ bɔs djas di bot ɛ epiki, nɛ ɛdjɛ bɛ tsik ɛ. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Dáa mot ngɔt nadi ààlooba ɛ, ye naasa náá, bɛtɛ nɛ bot ni tɔ mesyem, deenek, ɛlooba ɛ mot ngɔt nalooba ɛ, yɛ eesa náá, bɛtɛ nɛ bot di bot ɛ epiki é mis ɛ Zɛɛb.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />É ghɛŋ etsi natuula ɛ, mesyem naabaazɛbu. Tin, é di mesyem di ebu ɔ, enɛm nɛ embɛɛ Zɛɛb ɛpebaabu dhaa tyɛ. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Tin, dáa mesyem natel ghwyil'ɛ tɔ ɛsyee ɛ, yɛ ɛ́ deenek ɛ́ enɛm nɛ embɛɛ e Zɛɛb di etel ghwyil'ɛ tɔ epiki, étɛp ɛdjɛ mena tsik na kɔm-kɔm kɔ ɛsu ɛ Yezu Klisto Ghɛŋ'enaka.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s1">Ɛduwa Zɛɛb, yɛ ɛ́ ɛgwyɛ, nɛ tsik sama nɛ Klisto</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />É di'enek, bot aakake tin dáa? Ye goka ɛ́ bot gyee tɔ mesyem etɛɛ náá enɛm nɛ embɛɛ e Zɛɛb neebu dhaa tyɛ? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Yɛ aanàkwaasael deenek! Menabɛlka bot ɛ nazegwyɛ é ze mesyem ɔ, haaa étɛp yé mena di baakwyɛlka ɛsik tɔ tsik mesyem? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Bi ààgu náá, é ghɛŋ mena naduwaka Zɛɛb ɛ, menabɛlka djas nabɛ ɛ́, mena mooka mot ngɔt nɛ Yezu Klisto? Ye kwyɛl ɛlɛɛ ɛ́ náá, mena naazegwyɛka sama nɛ nɛ. <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Dum nɛ ɛduwa Zɛɛb'enek, mena naagwyɛ, delaa sama nɛ Klisto, etɛɛ náá, tyee wat nɛ dáa duma Sɛɛg nasa náá, Klisto gom pak myoŋ ɛ, yɛ ɛ́ deenek ɛ́ menabɛlka pe aabaakɛ tɔ tsik na bes.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Tin, yɛ bɛ náá, mena nadika ɛ́ mot ngɔt nɛ nɛ tɔ kɔkɔ mbi ɛsyee ɛ lɛ ɔɔ, mena aabaadika ɛ́ mot ngɔt nɛ nɛ tɔ mbi ɛgom ɛ lɛ pak myoŋ. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Bot goka ɛ́ nɛ ɛgu ɛnyɔɛpe náá, mena tokapɛ mbi bot ɛ mena nadika kpaambel ɔ. Mena naazegwyɛka, mbema é mɛlaaba sama nɛ Klisto. Etɛɛ náá, tsik epuud mena nadika nɛ yɛ ɛ́ neegwyɛ, tin, mena needi ààbaadika ekwom e mesyem. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Etɛɛ náá, mot nagwyɛ sama nɛ Klisto ɔ, nyɛ moo ɛ́ nyɛ eezedjɛaa di epiki, nyɛ naazepɛkaa tɔ mesyem. <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />Yɛ bɛ náá, mena eezegwyɛka sama nɛ Klisto ɔɔ, tin, mena ɛ́ nɛ ghwyil ɛdi nɛ ɛbwaalel náá, menaka pe ɛ́ nɛ tsik sama nɛ nɛ. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Mena nɛ guka ɛnyɔɛpe náá, Klisto naazegomelaa pak myoŋ, nyɛ tok nɛ ghwyil ɛbaagwyɛ. Tin, ɛsyee tokapɛ nɛ ghwyil kɔ lɛ. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Klisto nagwyɛ ɛ́ ngwyɛa sok wat, étɛp ɛsaab ghwyil mɛbwala mɛ mesyem mɛ bot ɛ bɔs. Tin, nenak yak, nyɛ moo ɛ́ nɛ tsik kɔ ɛsu ɛ Zɛɛb. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Yɛ ɛ́ tyee wat nɛ biyɔ, beeka náá, sok bhwoob mesyem, bi ɛ́ dáa bot ɛ zegwyɛ ɔ. É di'enek, guka náá, bi ɛ́ nɛ tsik ɛ étɛp Zɛɛb, kɔ ɛsu ɛ ɛgwakel ɛ len nɛ Yezu Klisto.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Sa mesyem ààbela ghwyil kɔ mɛnyel men di náá, yɛ waaboogwyɛ ɛ́, sa bi ààlooba nɛ egwyes e epuud bin. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Sa bi ààbaawa ekyes é mɛnyel men tɔ mesyem, etɛɛ náá, yɛ ɛzɛkɛwa bin tɔ ɛbiyo. Tin, djɛka Zɛɛb mɛnyel men djɛa wat, dáa bot ɛ zegom pak myoŋ étɛp ɛbula tɔ tsik ɛ. Bi goka ɛ́ nɛ ɛdjɛ mɛnyel men djas tɔ mɛsa mɛ, étɛp ɛsa mɛsa mɛ epiki. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />É di'enek, mesyem aanàbaadi nɛ ghwyil kɔ len, etɛɛ náá, bi tokapɛ si bhel etsi, bi moo ɛ́ tɔ enɛm nɛ embɛɛ e Zɛɛb.<verse eid="ROM 6:14" /></para>
  <para style="s">Ɛsa mɛsa mɛ epiki</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Yɛ ɛ́ yé? Yɛ ɛ́ náá, mena ɛ́ nɛ ghwyil saka mesyem, etɛɛ náá, mena tokapɛ si bhel etsi, mena mooka ɛ́ tɔ enɛm nɛ embɛɛ Zɛɛb é? Yɛ aanàkwaasael deenek! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Bi nɛ gu ɛnyɔɛpe náá, bi ɛ djɛ mɛnyel men nɛ bot náá, bɛ kɔk kɔ len ɔɔ, bi aakadi ɛ́ ekwom e bot ɛ bi di elooba nɛ nɔɔ yenek. Yɛ bɛ náá, syem ɛ di ekɔk kɔ len ɔɔ, yɛ waadul bin tɔ ɛsyee. Yɛ kabɛ náá, Zɛɛb ɛ di kɔk kɔ len ɔɔ, nyɛ waadjɛ bin tsik yii epiki. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Djhoobulalka bhɔɔ nɛ Zɛɛb etɛɛ náá, biyɔ bot ɛ nadi kpaambel ekwom e mesyem ɔ, bi moo mos ɛ́ elooba nɛ lyem wat nɛ mɛlyo mɛ nadjɛaa bin ɛ. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Bi tokapɛ bɛkwom ɛ mesyem, bi moo ɛ́ bot ɛ di esa mɛsa mɛ di náá, yɛ ɛ́ yii epiki ɛ. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Mɛ kalii wak ɛ́ dáa bot djas di elii ɛ, etɛɛ náá, bi ààdyeebanyɔ ɛmɛt mɛsuk mɛ etɛp. É ghɛŋ sok, bi nabɛ ɛ́ bi naawa elyem bin dɔkɔ tɔ ekwom e mɛsa mɛ edhuud nɛ yii ɛzɛm di edis ɛgwakel pak bi nɛ bɛ Zɛɛb ɛ. Yɛ ɛ́ dáa mos, bi goka ɛ́ nɛ ɛwa elyem bin djas dɔkɔ tɔ ekwom e mɛsa mɛ epiki, étɛp bi needi tɔ tsik na dɛɛ.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />É ghɛŋ bi nadi ekwom e mesyem ɛ, ɛsa mɛsa mɛ epiki nabɛ ɛ́ ààdi egwyák bin. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Tin, bi nakabela yé, é sok bi nadi esesa esa di edjɛ bin sen mos'aak? Esa binek dul bot ɛ́ tɔ ɛsyee! <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Nenak yak, bi moo ɛ́ pɛka si bhel mesyem, bi moo ɛ́ tɔ mɛsa mɛ Zɛɛb. Tin, sa bi bela ɛ́, yɛ ɛ́ tsik na dɛɛ, étɛp ɛbela tsik na kɔm-kɔm bhii tak. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Etɛɛ náá, efute e mesyem, yɛ ɛ́ ɛsyee. Tin, ɛkɛɛ yii toto Zɛɛb di edjɛ ɛ, yɛ ɛ́ tsik na kɔm-kɔm tɔ ɛgwakel nɛ Yezu Klisto Ghɛŋ'enaka.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Mɛpɛka si bhel etsi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Bɔn-nyɛɛg, bi nɛ gu ɛnyɔɛpe sa mɛ di ekwyɛl ɛlɛɛ bin ɛ, etɛɛ náá, bi nɛ gu etsi. Bi nɛ gu náá, etsi bela ghwyil kɔ mot ɛ, é sok di náá mot dinaa nɛ tsik ɛ. <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Djhoopookonɔɔka geka moma ɛba: etsi ɛba ke ɛ́ náá, moma di bhaada nɛ ngom ɛ, é sok ngom di, nyɛ dinaa nɛ tsik ɛ. Tin, yɛ kabɛ náá, ngom eegwyɛ ɔɔ, nyɛ tokapɛ si bhel etsi e ɛba. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Nyɛ bela dhiiti motom sis ngom dinaa nɛ tsik'ɔɔ, nyɛ aakadjóoaa ɛ́ moma mɛzɔ. Tin, ngom ɛ gwyɛ ɔɔ, nyɛ moo ɛ́ pɛka si bhel etsi e ɛba. Deenek, nyɛ ɛ́ nɛ ghwyil ɛdi mwaa dhiiti mot ààbɛ náá, nyɛ sa ɛ́ ɛzɔ. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Yɛ ɛ́ tyee wat nɛ biyɔ bɔn-nyɛɛg bam, dum nɛ etsi, bi moo ɛ́ bi eezegwyɛ etɛɛ náá, bi ɛ́ mot ngɔt nɛ nyel ɛ Klisto. É di'enek, bi moo ɛ́ bot ɛ mot sis, mot nazegom pak myoŋ étɛp mena neesaka esa ee di enyɔ é mis ɛ Zɛɛb ɛ. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Etɛɛ náá, é ghɛŋ mena nadika mena dinaa ekɛka tɔ mɛkwosak mɛ epuud ɛ, etsi nadi esa náá, embee mɛkwosak mɛ esyem sa mɛsa tɔ mɛnyel mena. Etɛɛ náá, ye needul mena tɔ ɛsyee. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Nenak mena moo ɛ́ pɛka si bhel etsi, etɛɛ náá, mena naazegwyɛka kɔ ɛsu ɛ sa nadi esa náá, mena dika é ekwom ɛ. Menaka ɛ́ nɛ ghwyil ɛkabaasa mɛsa mɛ Zɛɛb tyee sis, é ze Sisim na Dɛɛ, ààkabaabɛ dáa ye nadi esesael é ghɛŋ sok é ze etsi ɛ.<verse eid="ROM 7:6" /></para>
  <para style="s">Etsi nɛ mesyem</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />É di'enek, bot aakake tin dáa? Etsi ɛ esyem é? Yɛ aanàkwaasael deenek! Etɛɛ náá, yɛ ɛ́ dum nɛ etsi ɛ mɛ di egu sa di syem ɛ. Deenek, yɛ ɛpedi ɛ́ di náá tsi nabɛ ɛ́ ààlɛɛ náá: «Sa wɔ ààwyeeb sa mot<note caller="*" style="x"><char style="xo" closed="false">7.7 </char><char style="xt" closed="false"><ref loc="EXO 20:17">Ɛwy 20.17</ref>; <ref loc="DEU 5:21">Dɛt 5.21</ref></char></note>» ɔɔ, pe mɛ nabɛ ɛ́ ààgu syem di edjóoaa engwyeebel ɛ. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Tin, mesyem pyet ɛ́ kɔ mɛtiŋ, étɛp ɛsa náá, membi mɛ embee mɛkwosak djas neebyel tɔ lam. Etɛɛ náá, etsi ɛpedi ààbɛ ɔɔ, pe syem ɛ́ sa wat di náá yɛ eezegwyɛ ɛ. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />É ghɛŋ na mwa, é sok etsi nadi ààbɛ ɛ, mɛ nadi ɛ́ nɛ tsik. Dáa mɛtiŋ nakazyɛ ɛ, syem eebela di. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />Mam eezegwyɛ: Mɛtiŋ sa nabɛ náá, bot tsak nɛ ye ɛ, ye nakadul mam ɛ́ pɛ ze ɛsyee. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Etɛɛ náá, mesyem eebela ze ɛkɔɔ ɛ́ mɛ. Nyɛ kɔɔ mɛ ɛ́ dum nɛ mɛtiŋ. Yɛ ɛ́ kɔ ɛsu ɛ mɛtiŋ mɛ tak ɛ mɛ zegwyɛ'aak.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />Deenek, etsi ɛ́ dɛɛ, tin mɛtiŋ ɛ́ dɛɛ, epiki nɛ ɛnyɔ. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Mɛtiŋ, sa nadi náá yɛ ɛ́ mbɛɛ sonok ɛ, ye moo nɛ nam mos ɛ́ ɛsyee? Yɛ aanàkwaasael deenek! Yɛ ɛ́ mesyem ɛ nakus tɛp tak. Syem eelyaal nɛ tsɛɛtsɛ sa nyɛ di ɛ. Mesyem pyet ɛ́ kɔ sa di ɛnyɔɛpe ɛ, étɛp ye neegó mɛ. Yɛ ɛ́ deenek ɛ́ mɛtiŋ nasa náá, mena guka náá, mesyem ɛ́ mbee sonok dhaa tyɛ.<verse eid="ROM 7:13" /></para>
  <para style="s">Mot ɛ́ si bhel mesyem</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Mena nɛ guka náá, etsi ɛ́ etɛp Sisim. Tin, mam ɛ́ mot epuud, mɛ naazebɔmsaa tyee kwom mesyem. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Mɛ ààgu sa mɛ di esa ɛ, etɛɛ náá, mɛ ààsa sa lyem'am di ekwos ɛ. Tin, mɛ sa ɛ́, sa mɛ di ebhina ɛ. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Nɛ tsɛɛtsɛ yɛ bɛ náá, mɛ sa ɛ́ sa lyem'am di ààkwyɛl ɔɔ, mɛ eemyaal náá, etsi nɛ nyɔ. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Nenak, ye tok mam di esa deenek, yɛ ɛ́ syem di tɔ lam ɛ di esa deenek. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Etɛɛ náá, mɛ nɛ gu náá, ye tok nɛ sa mɛnyɔ di tɔ lam, mɛ lii deenek ɛ́, dum nɛ epuud bam. Nɛ tsɛɛtsɛ, ɛkwosak ɛsa sa di enyɔ ɛ́ tɔ lam, tin, mɛ ààbela ghwyil ɛsa yɛ. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Etɛɛ náá, mɛ ààsa enɛm esa ee mɛ di ekwyɛl ɛsa ɛ, tin, mɛ sa ɛ́ etɛp ɛbiyo ee mɛ di ààkwyɛl ɛsa ɛ. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Yɛ bɛ náá, mɛ sa ɛ́ sa lyem'am di ààkwyɛl ɔɔ, ye tok mam di esa deenek. Yɛ ɛ́ syem di tɔ lam ɛ di esa deenek.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Tin, mam mot di ekwyɛl ɛsa enɛm esa ɔ, mɛ nɛ dyeebabee náá, mɛ zobela ghwyil ɛ́ yii ɛsa embee mɛsa. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Bela náá, tɔ bum lyem'am, mɛ nɛ dyeebamyaala nɛ etsi ɛ Zɛɛb. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />É di'enek, mɛ ɛpebee náá, pɛ tɔ nyel'am, yɛ ɛ́ nɛ dhiiti etsi sis di tɔ zyaala nɛ etsi ee esiiza bam. Etsi tak ɛ di esa náá, mɛ di kwom etsi e mesyem di tɔ lam ɛ. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Haaa kpaa-ghoŋ nɛ nam! Ɛzɛ aapɛk mɛ nɛ nyel'ak di edul mɛ pɛ ze ɛsyee ɛ? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Djhoobulalka bhɔɔ nɛ Zɛɛb kɔ ɛsu ɛ Yezu Klisto Ghɛŋ'enaka!</para>
  <para style="p" vid="ROM 7:25">Deenek, mɛ ɛ́ tɔ mɛsa mɛ etsi e Zɛɛb kɔ ɛsu ɛ esiiza bam. Tin, tɔ egwyes epuud, mɛ ɛ́ kwom etsi e mesyem.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Tsik nɛ Sisim Zɛɛb</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Étɛp tak ɛ di náá, bot ɛ di mos sama nɛ Yezu Klisto ɔ, bɛ tokapɛ nɛ ndjɛ sɔs. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Etɛɛ náá, dum nɛ Yezu Klisto, tsi Sisim di edjɛ tsik ɛ, naazepɛk mɛ tɔ ekwom e etsi e mesyem nɛ ɛsyee. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Zɛɛb naasa esa ee di náá, etsi ɛ Moiiz nabɛ ɛ́ ààbɛ nɛ ghwyil ɛsa ɛ, etɛɛ náá, epuud nɛ sa elɛtɛ. Nyɛ naadhis mɔn'ɛ nɛ nyel epuud dáa menabɛlka bot ɛ mesyem, etɛɛ náá, nyɛ neepɛk mena tɔ mesyem. Yɛ ɛ́ deenek ɛ́ Zɛɛb nawa é feŋ mesyem mɛ nadi tɔ mɛnyel mɛ bot ɛ. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Zɛɛb sa deenek ɛ́, etɛɛ náá, mena needika nɛ ghwyil ɛkɛ dáa etsi di elɛɛ ɛ. Deenek, mena aanàkabaakɛ tɔ ghwyil epuud, tin, mena aakakɛka ɛ́ tɔ ghwyil Sisim. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Deenek, bot ɛ di ekɛ tɔ ghwyil epuud ɔ, bɛ sa ɛ́ mɛkwosak mɛ epuud. Tin, bot ɛ di ekɛ tɔ ghwyil Sisim ɔ, bɛ sa ɛ́ mɛkwosak mɛ Sisim. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Mot ɛ di ekɛ si ghwyil epuud ɔɔ, ye dul nyɛ ɛ́ é ze ɛsyee. Tin, mot ɛ di ekɛ si ghwyil Sisim ɔɔ, ye djɛ nyɛ ɛ́ tsik nɛ egwyem. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Etɛɛ náá, bot ɛ di ekɛ si ghwyil ɛkwosak ɛ epuud ɔ, bɛ ɛ́ bot ɛ mɛbhuka ɛ Zɛɛb, bɛ ààlooba nɛ etsi e Zɛɛb, bɛ tok nɛ ghwyil ɛlooba nɛ etsi e tak. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Bot ɛ di ekɛ si ghwyil epuud ɔ, Zɛɛb tok nɛ ghwyil ɛmyaala nɛ nɔɔ.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Yɛ kabɛ biyɔ ɔɔ, bi ààkɛ si ghwyil epuud, bi kɛ ɛ́ si ghwyil Sisim, etɛɛ náá, Sisim Zɛɛb eebe di tɔ len. Tin, mot di ààbɛ nɛ Sisim ɛ Klisto ɔ, nyɛ tok ngbɛ Klisto. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Ye nakoozodi náá, Klisto ɛ́ tɔ len, mɛnyel men aaboodi ɛ́ gwyɛ kɔ ɛsu ɛ mesyem, tin, Sisim djɛ bin tsik ɛ́, etɛɛ náá, Zɛɛb naazesa náá, bi djóoaa bot ɛ epiki é mis mɛ. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Yɛ bɛ náá, Sisim mot nagomal Yezu pak myoŋ ɛ́ tɔ len ɔɔ, tin, Zɛɛb mot nagomal Klisto pak myoŋ ɔ, nyɛ aabaadjɛ tsik é mɛnyel men nazegwyɛ ɔ, kɔ ɛsu ɛ Sisim'ɛ zebe di tɔ len ɛ.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />É di'enek, bɔn-nyɛɛg, yɛ bɛ náá, bis ɛ́ nɛ kola yebɔ ɔɔ, ye tok kola epuud, etɛɛ náá, bis neekɛ tɔ ɛkwosak ɛ epuud. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Etɛɛ náá, bi ɛ́ di tɔ mɛkwosak mɛ epuud ɔɔ, bi ɛ́ waagwyɛ. Tin, dum nɛ ghwyil Sisim di edjɛ bin ɛ, bi ɛ́ waakwak embee mɛfulu di tɔ mɛnyel men ɛ, bi aadi ɛ́ nɛ tsik. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Bot djas di edjɛɛdel nɛ Sisim Zɛɛb ɔ, bɛ ɛ́ bɔn ɛ Zɛɛb. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Etɛɛ náá, Sisim bi bela ɛ, ye tok Sisim di ewa bin tɔ ekwom nɛ ɛbaadjɛ bin bwoo ɔ. Deenek, Sisim bi nabela ɛ nasa náá, bi di bɛtɛtɛ bɔn ɛ Zɛɛb, yɛ ɛ́ kɔ ɛsu ɛ Sisim yenek ɛ mena di eben gwood, étɛp ɛtsim: «<char style="sc">Abha</char>!» Ye kwyɛl ɛlɛɛ ɛ́, «Saagam!» <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Sisim Zɛɛb nyɛ ɛmet ɛpelyaal nɛ tsɛɛtsɛ nɛ sisim yenaka náá, mena moo ɛ́ bɛtɛtɛ bɔn ɛ Zɛɛb. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Deenek, dáa ye di náá, menaka ɛ́ bɔn bɛ ɛ, menaka pe ɛ́ bɔn ɛ lyak! Nɛ tsɛɛtsɛ menaka ɛ́ bɔn ɛ lyak ɛ Zɛɛb, menaka ɛ́ bɔn ɛ lyak sama nɛ Klisto. Etɛɛ náá, mena zukeka sama nɛ nɛ ɔɔ, mena aabaadika ɛ́ sama nɛ nɛ tɔ duma yɛ.<verse eid="ROM 8:17" /></para>
  <para style="s">Duma di ezyɛ ɛ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Mɛ bee ɛ́ ɛkɛɛ, duma Zɛɛb aalyaal mena djɛmɛn ɛ, eedhaa mezuk mɛ mena di ezukeka mos'aak nɛ mɛtaŋ. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Bhwak djas ɛ́ lyem pɛ ɛko é bhwood ɛwala ɛ Zɛɛb aalyaal duma bɔn bɛ ɛ. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Etɛɛ náá, bhwak djas naazeni si bhel mɛze mɛ di ààval sonok ɛ. Ààbɛ náá, ye nakwyɛl ɛdi deenek ɛ́ nɛ ɛkwosak ɛ lɛ met. Yɛ ɛ́ kɔ ɛsu ɛ Mot nawa nyɛ si bhel'ɛ ɔ. Bela náá, ye dinaa nɛ ɛbwaalel. <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />Etɛɛ náá, esa ee Zɛɛb nakus djas ɛ, waapɛkel si bhel mɛbwala mɛ nazesaab yɛ nɛ ɛwa yɛ tɔ ekwom ɛ. Tin, bhwak djas aabela di tɔ duma mɛpɛka sama wat nɛ bɔn ɛ Zɛɛb. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Mena ɛpeguka náá, dɔɔ nɛ dwoo pan mos'ak, bhwak djas ɛpesim, nɛ ɛzuk dáa moma di egwak ɛbɛl ɔ. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Ye tok bhwak nɛ bhwak di ezuk. Yɛ ɛ́ dɔɔ nɛ menabɛlka, bot ɛ nazebela Sisim dáa ɛkɛɛ mɛkɛn tɔ mɛkɛɛ mɛ Zɛɛb nakɛk ɛ, mena ɛpebaasimka tɔ elyem bena. Deenek, menaka ɛ́ tɔ bhwood náá, Zɛɛb sa náá, mena dika bɛtɛtɛ bɔn bɛ, da nyɛ ɛ́ pɛk mɛnyel mena. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Etɛɛ náá, mena naazebelaka tsik, yɛ ɛ́ tsik tak ɛ́ di edjɛ mena ɛbwaalel. Yɛ bɛ náá, bot ɛ ɛpebee sa di náá, bot ɛ nɛ ɛbwaalel nɛ yɛ ɔɔ, yenek tokapɛ ɛbwaalel. Yɛ ɛ́ ɛzɛ baadi nɛ ɛbwaalel nɛ sa nyɛ di ebee ɛ? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Tin, yɛ bɛ náá, menaka ɛ́ nɛ ɛbwaalel nɛ sa di náá, mena ààbeeka ɔɔ, mena waawaka zii ɛ é bhwood.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Yɛ ɛ́ tyee wat nɛ Sisim. Sisim ɛpebaakwyee mena, etɛɛ náá, menaka ɛ́ nɛ elɛtɛ. Mena ààguka ɛdjaala dáa mena di egoka ɛ. Tin, Sisim nyɛ ɛmet ɛpedjaala Zɛɛb étɛp'ena etɔɔla nɛ mɛkpa mɛ di náá, mot tok nɛ ghwyil ɛlii ɛ. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Tin, Zɛɛb mot di ebee tɔ ebhum elyem e bot ɔ, nɛ gu sa Sisim di ekwyɛl ɛwaab ɛ. Etɛɛ náá, Sisim ɛpedjaala Zɛɛb, étɛp bot ɛ di edum koŋ nɛ Zɛɛb ɔ, dáa nyɛy Zɛɛb di ekwyɛl ɛ.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Mena nɛ baaguka náá, esonok djas sael ɛnyɔɛpe ɛ́, étɛp bot ɛ di ekwyɛl Zɛɛb ɔ, bot ɛ nyɛ nadjóo tɔ ɛkwosak ɛ lɛ ɔ. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Etɛɛ náá, Zɛɛb naazesɛ́ɛ bɛ, nyɛ naabaazesa náá, bɛ nɔŋel nɛ Mɔn'ɛ, etɛɛ náá, Mɔn'ɛ tak needi mɔn mɛgwyak mɛ bɛtɛ nɛ bɔn-nyɛɛg. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Bot ɛ di náá, Zɛɛb naazesɛ́ɛ bɛ ɔ, nyɛ naadjóo bɛ. Bot ɛ nyɛ nazedjóo ɔ, nyɛ naazedjɛ bɛ di epiki é mis mɛ. Bot ɛ nyɛ naazedjɛ bɛ di epiki ɔ, nyɛ naabaasa náá, bɛ bela di tɔ duma yɛ.<verse eid="ROM 8:30" /></para>
  <para style="s">Mɛbɔk mɛ kwyɛl ɛ Zɛɛb</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Mena aakabaake dáa? Yɛ bɛ náá, Zɛɛb ɛ́ pɛ yenabɛl kyee ɔɔ, ɛzɛ aabaadi nɛ ghwyil ɛkwak mena? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Nyɛy mot di náá nyɛ nabɛ ɛ́ ààsa náá Mɔn'ɛ Yezu di ngbɛ met ɔ, nyɛ naaka nyɛ buwa kɔ ɛsu ɛ menabɛlka djas. Sama nɛ Mɔn'ɛ, nyɛ aadi ààdjɛ mena esonok djas tɔ enɛm nɛ embɛɛ bɛ dáa? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Ɛzɛ aapit bot ɛ Zɛɛb nazesɛ́ɛ ɔ? Mot tok, etɛɛ náá, yɛ ɛ́ Zɛɛb ɛ di eke nɛ bot ɛ nyɛ nasɛ́ɛ ɔ náá, bɛ ɛ́ bot ɛ epiki. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Ɛzɛ di nɛ ghwyil ɛwa bɛ é feŋ? Mot tok, etɛɛ náá, Yezu Klisto ɛ́ mot nagwyɛ da gom bhis ɛsyee ɔ. Nyɛ ɛ́ pɛ mbɔ eghɛŋ ɛ Zɛɛb, nyɛ ɛpedjaala kɔ ɛsu ɛ lena. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Ɛzɛ di nɛ ghwyil ɛbɛk mena nɛ kwyɛl ɛ Klisto? Yɛ ɛ́ nɛ ghwyil ɛdi mezuk é, kɛŋ é, mɛtiiga, za, eduuba é, embee etɛp é, nɛghu ɛsyee? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 8:36">«Yɛ ɛ́ kɔ ɛsu ɛ lɔ ɛ mena di é mɛwala djas kaa é ɛsyee,</para>
  <para style="q1" vid="ROM 8:36">bɛ kabee mena ɛ́ tyee ebhata bɛ di edul étɛp kɛtsakaa ɛ<note caller="*" style="x"><char style="xo" closed="false">8.36 </char><char style="xt" closed="false"><ref loc="PSA 44:23">Mɛd 44.23</ref></char></note>.»<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Tin, mena naazekwakeka etɛp binek djas boo kwakak, kɔ ɛsu ɛ mot nazekwyɛl mena ɔ. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Nɛ tsɛɛtsɛ, mɛ nɛ gu náá, dhiiti sonok tok nɛ ghwyil ɛbɛk mena nɛ kwyɛl Zɛɛb di nɛ yɛ nɛ nena ɛ:</para>
  <para style="q1" vid="ROM 8:38">Ye nakoozodi ɛsyee nɛghu tsik,</para>
  <para style="q1" vid="ROM 8:38">ye nakoozodi efofop,</para>
  <para style="q1" vid="ROM 8:38">ye nakoozodi edhiiti ekukuma,</para>
  <para style="q1" vid="ROM 8:38">nɛghu membi mɛ mɛbwala mɛ di pɛ tɔ gwoo ɛ,</para>
  <para style="q1" vid="ROM 8:38">ye nakoozodi etɛp e mos nɛghu etɛp e djɛmɛn,<verse eid="ROM 8:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="ROM 8:39" />ye nakoozodi esa e mɛbwala mɛ di tɔ gwoo nɛghu pɛ si bɔs ɛ,</para>
  <para style="q1" vid="ROM 8:39">ààkobɛ-bɛak sa wat nakusaa-kusak ɛ,</para>
  <para style="q1" vid="ROM 8:39">ye tok nɛ sa wat di nɛ ghwyil ɛwa ndje tɔ kwyɛl di pak bis nɛ Zɛɛb ɛ.</para>
  <para style="m" vid="ROM 8:39">Zɛɛb naalyaal mena kwyɛl tak kɔ ɛsu ɛ Yezu Klisto Ghɛŋ'enaka.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Zɛɛb nasɛ́ɛ ɛ bot ɛ mbyak Yisalaɛl</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Sa mɛ aalɛɛ ɛ, yɛ ɛ́ etsɛɛtsɛ, mɛ ààlɛɛ etsal, etɛɛ náá, mɛ ɛ́ mot ɛ Klisto. Sisim na Dɛɛ ɛpelyaal tɔ esiiza bam náá, mɛ lɛɛ ɛ́ sa di tsɛɛtsɛ ɛ. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Lyem'am ɛ́ nɛ boo ghoŋ dhaa tyɛ, nɛ pel wat di náá, yɛ ààsi ɛ. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Nɛ tsɛɛtsɛ, ɛkwosak ɛ lam ɛ́ náá, mam ɛmet bela ekɛlok ɛ Zɛɛb, mɛ neebɛka nɛ Klisto, étɛp ɛtsik ɛ́ bɔn-nyɛɛg bam, bot ɛ mbyak'am. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Bɔn-nyɛɛg bam tak ɛ́, bot ɛ mbyak Yisalaɛl. Zɛɛb naasa náá, bɛ di bɔn bɛ, nyɛ naalyaal bɛ duma yɛ. Nyɛ naasa ɛbhɛŋ nɛ nɔɔ, nyɛ naadjɛ bɛ etsi. Nyɛ naalyaal bɛ dáa bɛ di egoka nɛ ɛduwal nyɛ ɛ, nyɛ naadjɛ bɛ ekɛk. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Bɛ nadi ɛ́ bɔn bɛdha ɛ bɛbhaab ɛ Zɛɛb naloozesɛ́ɛ ɔ. Dɔɔ nɛ Klisto pe, nyɛ nabyel ɛ́ tɔ lɔɔg bɛdha ɛ bɛbhaab ɛ bot ɛ membyak menek, dáa bot djas di egoka nɛ ɛbyel ɛ. Nyɛy mot di Zɛɛb kɔ esonok djas ɔ, beta náá, duu di nɛ nɛ kɔm-kɔm sii nɛ kɔm. <char style="sc">Amɛn</char>.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Yɛ ààkwyɛl ɛlɛɛ náá, Mɛkpa ɛ Zɛɛb ààkaval. Etɛɛ náá, ye tok bot di kɔ kyee dik Yisalaɛl djas ɔ, di bɔn bɛdha ɛ bhaab, mot nadi edjóoaa Yisalaɛl ɔ. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Deenek, bɔn Abalaam djas tok bɔn nadus tɔ mɔ'ɛ ɔ, etɛɛ náá, Zɛɛb nalɛɛ nɛ Abalaam ɛ́ náá: «Yɛ ɛ́ dum nɛ Izak ɛ wɔ aabela bɛdha mɛ nakɛk wɔ ɛ<note caller="*" style="x"><char style="xo" closed="false">9.7 </char><char style="xt" closed="false"><ref loc="GEN 21:12">Mɛk 21.12</ref></char></note>.» <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Ye kwyɛl ɛlɛɛ náá, ye tok bɔn di ebyel dáa bot di ezyɛ nɛ ɛbyel ɔ di bɔn ɛ Zɛɛb, yɛ ɛ́ bɔn nabyel dáa Zɛɛb nakɛk ɔ di ebeea dáa bɛtɛtɛ bɛdha. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Etɛɛ náá, mɛkpa mɛ ekɛk e Zɛɛb nalɛɛ ɛ́ náá: «É ɛwala bot di'ak, é mbu di ezyɛ yenek, mɛ aabula wak, mɛ aabela ɛ́, Saala eezebya mɔn motom<note caller="*" style="x"><char style="xo" closed="false">9.9 </char><char style="xt" closed="false"><ref loc="GEN 18:10">Mɛk 18.10</ref>,<ref loc="GEN 18:14">14</ref></char></note>.»<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Yɛ ààpasik tin, djhoobaataalaka nɛ Lebeka, mɛwas mɛ nabɛ ɛ́ bɔn sɛɛg ngɔt, sɛɛg'ɔɔ nabɛ ɛ́ Izak bhaab'enaka. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Zɛɛb nalii nɛ Lebeka ɛ esok mɛwas mɛ bɛbá binɔk nadi bɛ dinaa ààbyel ɛ. Ye nabɛ ɛ́ bɔn dinaa ààsa enɛm esa, ààsa ɛbiyo. Yɛ bɛ náá, Zɛɛb nalii nɛ Lebeka deenek ɔɔ, yɛ ɛ́ étɛp ekɛk bɛ needi kɔm-kɔm. <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />Ekɛk e tak sael ɛ́ tɔ ɛkwosak ɛ lɛ, nɛ ndjóoel nyɛ di edjóo bot ɛ, ààbɛ kɔ ɛsu ɛ mɛsa mɛ bot di esa ɛ. Tin, nyɛ nake nɛ Lebeka ɛ́ náá: «Mɔn mɛgwyak mɔ aadi ɛ́ mot-mɛsa mɛ mɔn aabɔɔba nyɛ ɔ<note caller="*" style="x"><char style="xo" closed="false">9.12 </char><char style="xt" closed="false"><ref loc="GEN 25:23">Mɛk 25.23</ref></char></note>.» <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Dáa Ekwyala di elɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 9:13">«Mɛ eekwyɛl Zakɔɔb, mɛ eebyen Ezau<note caller="*" style="x"><char style="xo" closed="false">9.13 </char><char style="xt" closed="false"><ref loc="GEN 25:23">Mɛk 25.23</ref>; <ref loc="MAL 1:2-3">Mal 1.2-3</ref></char></note>» ɛ.<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />É di'enek, mena aakake tin dáa? Zɛɛb tok piki? Yɛ aanàkwaasael deenek! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Tin, nyɛ eezɛke nɛ Moiiz náá: «Mɛ waagek ghoŋ nɛ mot lyem'am aakwyɛl náá mɛ gek nyɛ ghoŋ ɔ, nɛghu ɛsa enɛm nɛ embɛɛ nɛ mot di náá lyem'am aakwyɛl náá, mɛ sa enɛm nɛ embɛɛ ɔ<note caller="*" style="x"><char style="xo" closed="false">9.15 </char><char style="xt" closed="false"><ref loc="EXO 33:19">Ɛwy 33.19</ref></char></note>.» <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Deenek, ye tok ɛkwosak ɛ mot, ààkobɛ-bɛak nɛ ghwyil mot, yɛ ɛ́ nɛ ɛkwosak ɛ boo lyem ghoŋ Zɛɛb nyɛy ɛmet. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Zɛɛb nalɛɛ nɛ mɛkoozi mɛ dik Eziptɛ tɔ Ekwyala ɛ́ náá: «Mɛ nasa náá, wɔ di mɛkoozi ɛ́, etɛɛ náá, dum nɛ nɔ, mɛ neelyaal mɛbwala mam, étɛp din ɛ lam neegék kɔ ɛko ɛ bɔs djas<note caller="*" style="x"><char style="xo" closed="false">9.17 </char><char style="xt" closed="false"><ref loc="EXO 9:16">Ɛwy 9.16</ref></char></note>.» <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Deenek, Zɛɛb nɛ gek ghoŋ nɛ mot lyem'ɛ di ekwyɛl náá nyɛ gek nyɛ ghoŋ ɔ, é sok nyɛ di ekwyɛl ɛ, nyɛ nɛ sa náá, mot lyel lyem.<verse eid="ROM 9:18" /></para>
  <para style="s">Zɛɛb sɛ́ɛ bot ɛ́ nɛ lyem'ɛ met</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Wɔ ɛ́ nɛ ghwyil ɛke nɛ nam náá: «Étɛp yé, Zɛɛb di ebaadul mena mɛlɔ? Deenek, ɛzɛ aakoodi nɛ ghwyil ɛmaad sonok, yɛ bɛ náá, yɛ ɛ́ ɛkwosak ɛ lɛ ɔɔ?» <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Wɔy, wɔy ɛ́ yɔ zɛ, wɔy mot epuud, étɛp wɔ neesuu mɛso nɛ Zɛɛb? Bhe dyak nɛ dji mot namɛ yɛ ɔ náá: «Étɛp yé wɔ mɛ mɛ dáak é<note caller="*" style="x"><char style="xo" closed="false">9.20 </char><char style="xt" closed="false"><ref loc="ISA 29:16">Eza 29.16</ref>; <ref loc="ISA 45:9">45.9</ref></char></note>?» <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Mot di emɛ mɛbhe mɛ dyak ɔ, nyɛ ɛ́ nɛ ghwyil ɛmɛ sa nyɛ di ekwyɛl ɛ nɛ pɔtɔ dyak. Deenek, nɛ pɔtɔ dyak tak wat, nyɛ ɛ́ nɛ ghwyil ɛmɛ mɛbhe mɛ dyak étɛp mɛbyoŋ mɛ bot ɛ ghoŋ nɛghu, bɛdhiiti étɛp bɛ neebebe mɛlu djas<note caller="*" style="x"><char style="xo" closed="false">9.21 </char><char style="xt" closed="false"><ref loc="JER 18:6">Zel 18.6</ref></char></note>.<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Tin, Zɛɛb nadi ekwyɛl ɛlyaal ɛbuk ɛ lɛ ɛ, nɛ mɛbwala mɛ. Bela náá, nyɛ naadyeebamaad lyem kɔ ɛsu ɛ bot ɛ nadi egoka nɛ ɛbuk ɛ lɛ ɔ, bot ɛ nadi egoka nɛ ɛsyee ɔ. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Tin, nyɛ nabaakwyɛl ɛlyaal ɛ́ dáa mɛkas mɛ di eval nɛ bɛdhiiti bot ɛ, bot ɛ nyɛ di nɛ boo lyem ghoŋ nɛ nɔɔ ɔ, bot ɛ nyɛ naloozesɛ́ɛ, étɛp bɛ neebela di tɔ mɛkas mɛ ɔ. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Bot ɛ tak ɛ́ menabɛlka, menabɛlka bot ɛ nyɛ nadjóo ɔ, ààkabɛ tɔ sama eYuda nɛ eYuda, yɛ ɛ́, dɔɔ nɛ tɔ sama bot ɛ membyak mɛ sis. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Yɛ ɛ́ dáa nyɛ nalɛɛ tɔ mɛkana mɛ ngoolel-mɛkpa Oze ɛ:</para>
  <para style="q1" vid="ROM 9:25">«Bot ɛ nabɛ náá, bɛ tok bot ɛ mbyak'am ɔ,</para>
  <para style="q2" vid="ROM 9:25">mɛ aakadjóo bɛ ɛ́, “bot ɛ mbyak'am”.</para>
  <para style="q1" vid="ROM 9:25">Bot ɛ mbyak mɛ nadi ààkwyɛl ɔ,</para>
  <para style="q2" vid="ROM 9:25">mɛ aakadjóo bɛ ɛ́, “bot ɛ mɛ di ekwyɛl ɔ”<note caller="*" style="x"><char style="xo" closed="false">9.25 </char><char style="xt" closed="false"><ref loc="HOS 2:25">Oze 2.25</ref></char></note>.<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />Tin, é di bɛ nake nɛ nɔɔ náá: “Bi tok bot ɛ mbyak'am ɔ,”</para>
  <para style="q1" vid="ROM 9:26">bɛ aakadjóoaa ɛ́, “bɔn ɛ Zɛɛb di nɛ tsik ɔ”<note caller="*" style="x"><char style="xo" closed="false">9.26 </char><char style="xt" closed="false"><ref loc="HOS 2:1">Oze 2.1</ref></char></note>.»<verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />Deenek, ngoolel-mɛkpa Ezayi pɛ yɛ kyee, nyɛ nadi etuud dum nɛ bot ɛ mbyak Yisalaɛl ɛ́ náá: «Ye nakoozodi náá, bot ɛ mbyak Yisalaɛl nadi ɛ́ ɛbuɛpe dáa bɛsyɛ é ngwoob boo dii mɛsɔn, yɛ ɛ́ ba bim bot pak bot aalik ɔ, bɔɔ aakwaabela tsik, <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />etɛɛ náá, sa Ghɛŋ nake náá, nyɛ aasa ɛ, nyɛ waasa yɛ djas ghal-ghal kɔ ɛko ɛ bɔs<note caller="*" style="x"><char style="xo" closed="false">9.28 </char><char style="xt" closed="false"><ref loc="ISA 10:22-23">Eza 10.22-23</ref></char></note>.» <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />Yɛ ɛ́ dáa Ezayi nazeloolɛɛ ɛ:</para>
  <para style="q1" vid="ROM 9:29">«Yɛ ɛpedi ɛ́ ààdi náá, Ghɛŋ Sabhaɔt<note caller="+" style="f"><char style="fr" closed="false">9.29 </char><char style="fq" closed="false">Ghɛŋ Sabhaɔt </char><char style="ft" closed="false">ye kwyɛl ɛlɛɛ ɛ́, Zɛɛb bɛghɛl.</char></note> nabɛ ɛ́ ààlik mena ba bɛdha ɔɔ,</para>
  <para style="q1" vid="ROM 9:29">pe bot moo ɛ́ dáa ghaada Sodɔm,</para>
  <para style="q1" vid="ROM 9:29">Pe bot ɛ́ tyee wat nɛ ghaada Ghomɔɔd<note caller="*" style="x"><char style="xo" closed="false">9.29 </char><char style="xt" closed="false"><ref loc="ISA 1:9">Eza 1.9</ref>; <ref loc="GEN 19:23-28">Mɛk 19.23-28</ref></char></note>.»<verse eid="ROM 9:29" /></para>
  <para style="s">Bot djas di edum koŋ nɛ Yezu Klisto ɔ, bɛ moo ɛ́ bot ɛ epiki</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Mena aakeka dáa? Bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ, bɛ nabɛ ɛ́ ààdi esaa náá, bɛ di bot ɛ epiki é mis ɛ Zɛɛb. Tin, Zɛɛb naabee bɛ dáa bot ɛ epiki kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɔɔ nɛ Zɛɛb. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Bela náá, bot ɛ mbyak Yisalaɛl, bot ɛ nadi esaa náá, bɛ di bot ɛ epiki é mis ɛ Zɛɛb dáa Etsi di elɛɛ ɛ, bɛ nabɛ ɛ́ ààbela yɛ. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Bɛ nadi ààbela yɛ étɛp yé? Etɛɛ náá, bɛ nabɛ ɛ́ ààdi esaa náá, bɛ di bot ɛ epiki é mis ɛ Zɛɛb kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɔɔ nɛ nɛ. Bɛ nadi egek ɛ́ náá, bɛ aadi ɛ́ epiki bot, dum nɛ mɛsa mɔɔ. Bɛ eekɔa é «ɛkok ɛ di esa náá, bot bema ɛbɛk ɛ». <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 9:33">«Beeka, mɛ eewa tɔ ghaada Siyɔn,</para>
  <para style="q2" vid="ROM 9:33">ɛkok ɛ di esa náá, bot bema ɛbɛk ɛ,</para>
  <para style="q1" vid="ROM 9:33">bat ɛkok di ekwyesal bot ɛ.</para>
  <para style="q1" vid="ROM 9:33">Tin, mot di edum koŋ nɛ ɛkok ɛ tak ɔ,</para>
  <para style="q2" vid="ROM 9:33">nyɛ aanàkwaadhuselaa<note caller="*" style="x"><char style="xo" closed="false">9.33 </char><char style="xt" closed="false"><ref loc="ISA 28:16">Eza 28.16</ref>; <ref loc="ISA 8:14-15">8.14-15</ref></char></note>.»<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Bɔn-nyɛɛg bam, ɛkwosak ɛ lyem'am nɛ mendjaala mam pɛ daa Zɛɛb kɔ ɛsu ɛ bot ɛ mbyak eYuda ɛ́ náá, bɛ bela tsik. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Nɛ tsɛɛtsɛ, mɛ ɛ́ nɛ ghwyil ɛdi tyaasɛs é di yɔɔ náá, bɛ nɛ sa zii tɔ ɛsa mɛsa mɛ Zɛɛb. Tin, zii ɛsa mɛsa mɛ Zɛɛb tak nɛ bu ɛdjak tɔ tak. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />É di'enek, bɛ nabɛ ɛ́ àànyɔ ɛtiibal dáa Zɛɛb di esa náá, mot di mot epiki é mis mɛ ɛ. Tin, bɛ naasa yɔbɔ mɛpek mɛ ɛdi ɛ́ piki e bot nɛ mɛghwyil mɔɔ met. É di'enek, bɛ nabɛ ɛ́ ààlooba nɛ dáa Zɛɛb di esa étɛp mot needi mot epiki ɛ. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Etɛɛ náá, ɛtuula ɛ Klisto nabɛ ɛ́ ɛsik ɛ Etsi ɛ Moiiz, étɛp bot djas di edum koŋ nɛ Zɛɛb ɔ needjɛaa di epiki é mis ɛ Zɛɛb.<verse eid="ROM 10:4" /></para>
  <para style="s">Tsik ɛ́ yii bot djas di edum koŋ nɛ Ghɛŋ ɔ</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Beeka sa Moiiz nakwyal dum nɛ dáa mot di egoka nɛ ɛsa étɛp nyɛ needi mot epiki dum nɛ etsi ɛ: «Mot di ekɛ dáa mɛtiŋ mɛ etsi di elɛɛ ɔ, nyɛ aadi nɛ tsik kɔ ɛsu ɛ tak<note caller="*" style="x"><char style="xo" closed="false">10.5 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Msa 18.5</ref></char></note>.» <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Tin, gwakeka dáa ye di ekeaa, étɛp mot needjɛaa di epiki kɔ ɛsu ɛ ɛdum ɛ koŋ nɛ Zɛɛb ɛ: «Sa wɔ ààke tɔ lyem'ɔ náá: “Ɛzɛ aabyet tɔ gwoo?”» Ye kwyɛl ɛlɛɛ ɛ́, ɛsil Klisto kɔ ɛko ɛ bɔs. <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />Sa wɔ ààke-keak tɔ lyem'ɔ náá: «Ɛzɛ aasul tɔ guk di ààbɛ nɛ ɛsik ɛ<note caller="*" style="x"><char style="xo" closed="false">10.7 </char><char style="xt" closed="false"><ref loc="LUK 8:31">Luk 8.31</ref></char></note>?» Ye kwyɛl ɛlɛɛ ɛ́, ɛgomal Klisto pak myoŋ. <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Ye lɛɛ yé? Ye lɛɛ ɛ́ náá: «Mɛkpa ɛ Zɛɛb eezekunaa nɛ nɔ, yɛ ɛ́ pɛ tɔ nuub'ɔ, nɛ tɔ lyem'ɔ<note caller="*" style="x"><char style="xo" closed="false">10.8 </char><char style="xt" closed="false"><ref loc="DEU 9:4">Dɛt 9.4</ref>; <ref loc="DEU 30:12-14">30.12-14</ref></char></note>.» Mɛkpa mɛ tak ɛ́ bhaadal ɛdum ɛ koŋ nɛ Zɛɛb ee bis di egoola ɛ. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Deenek yɛ bɛ náá, pɛ tɔ nuub'ɔ wɔ eemyaal é mis mɛ bot djas náá, Yezu ɛ́ Ghɛŋ ɔɔ, yɛ bɛ náá, wɔ eemyaal nɛ lyem'ɔ met náá, Zɛɛb naagomal nyɛ pak myoŋ ɔɔ, wɔ aabela tsik. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Etɛɛ náá, bot dum koŋ nɛ Zɛɛb ɛ tɔ lyem. Tin, Zɛɛb djɛ mot di epiki ɛ, nyɛ di edum koŋ nɛ nɛ ɔ. Yɛ ɛ́ nɛ nuub ɛ mot di emyaal ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb, da Zɛɛb ɛ́ tsik nyɛ. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Ekwyala lɛɛ ɛ́ náá: «Mot aadum koŋ nɛ Zɛɛb ɔ, nyɛ aanàkwaadhuselaa<note caller="*" style="x"><char style="xo" closed="false">10.11 </char><char style="xt" closed="false"><ref loc="ISA 28:16">Eza 28.16</ref></char></note>.» <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />É di'enek, ye tok nɛ mbɛk pak bot ɛ mbyak eYuda nɛ bot ɛ mbyak eGhɛlɛk. Etɛɛ náá, bɔɔ djas djóo ɛ́ Ghɛŋ ngɔt, nyɛ sa enɛm esa bɛ ɛ́ nɛ bot djas di edjóo nyɛ ɔ. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Tin, Ekwyala lɛɛ ɛ́ náá: «Mot aadjaala nɛ din ɛ Ghɛŋ ɔ nyɛ waatsak<note caller="*" style="x"><char style="xo" closed="false">10.13 </char><char style="xt" closed="false"><ref loc="JOL 3:5">Zol 3.5</ref></char></note>.»<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Haaa bɛ aakodjóo nyɛ dáa, yɛ bɛ náá, bɛ ààpadum koŋ nɛ nɛ ɔɔ? Haaa bɛ aadum koŋ nɛ nɛ dáa, yɛ bɛ náá, bɛ ààpagwak bot elii dum nɛ nɛ ɔɔ? Haaa bɛ aagwak bot elii dum nɛ nɛ ɔ dáa, yɛ bɛ náá, ye tok nɛ bot ɛ di elii dum nɛ nɛ ɔɔ? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Tin, bɛ aakogoola yɛ dáa, yɛ bɛ náá, ye tok nɛ mot lwomaa étɛp tak ɔɔ? Yɛ ɛ́ dáa Ekwyala di elɛɛ náá: «Enɛm nɛ mɛbɔ mɛ bot ɛ di egoola embɛɛ mɛbhaadal ɔ<note caller="*" style="x"><char style="xo" closed="false">10.15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">Eza 52.7</ref></char></note>!» <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />Tin, bot djas nabɛ ɛ́ ààlooba nɛ Mbɛɛ Bhaadal. Ngoolel-mɛkpa Ezayi naake náá: «Ghɛŋ, ɛzɛ myaal Mbɛɛ Bhaadal bis goola ɛ<note caller="*" style="x"><char style="xo" closed="false">10.16 </char><char style="xt" closed="false"><ref loc="ISA 53:1">Eza 53.1</ref></char></note>?» <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />É di'enek, guka náá, ɛdum ɛ koŋ nɛ Zɛɛb dus ɛ́ tɔ ɛgwak ɛ Mbɛɛ Bhaadal nagoolaaa ɛ. Tin, Mbɛɛ Bhaadal tak ɛ́ mɛkpa ɛ Klisto.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />É di'enek, mɛ ɛ́ tin edji náá, eYuda nabɛ ɛ́ ààgwak bhaadal tak é? Bɛ naagwak yɛ! Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 10:18">«Tuud bɛngoolel ɛ Mɛkpa ɛ Zɛɛb naagék kɔ ɛko ɛ bɔs djas,</para>
  <para style="q2" vid="ROM 10:18">mɛkpa mɔɔ naadjala kɔ ɛko ɛ bɔs djas<note caller="*" style="x"><char style="xo" closed="false">10.18 </char><char style="xt" closed="false"><ref loc="PSA 19:5">Mɛd 19.5</ref></char></note>.»<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Mɛ ɛpebaadji náá, bot ɛ mbyak Yisalaɛl nabɛ ɛ́ àànyɔ ɛmɛt lo mɛsɔ mɛ tak é? Tin, pookogwakeka dáa Moiiz nayala ɛ:</para>
  <para style="q1" vid="ROM 10:19">«Zɛɛb ke ɛ́, mɛ waasa náá, “Bi di nɛ mbee lyem nɛ bot ɛ di ààkodi bot ɛ tɛtɛ mbyak ɔ,</para>
  <para style="q1" vid="ROM 10:19">mɛ waabesal bin náá, bi di nɛ ɛbuk nɛ bot ɛ mbyak di ààbɛ nɛ mɛtselal ɔ<note caller="*" style="x"><char style="xo" closed="false">10.19 </char><char style="xt" closed="false"><ref loc="DEU 32:21">Dɛt 32.21</ref></char></note>.”»<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Ezayi naabalazɛke náá:</para>
  <para style="q1" vid="ROM 10:20">«Zɛɛb ke ɛ́ náá: “Bot ɛ nadi ààsaa mɛ ɔ naabela mɛ,</para>
  <para style="q1" vid="ROM 10:20">mɛ naatel nyel'am nɛ bot ɛ nadi ààwaab dhiiti sonok nɛ nam ɔ.”»<verse eid="ROM 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ROM 10:21" />Tin, kɔ ɛsu ɛ bot ɛ Yisalaɛl, Zɛɛb naabaake náá:</para>
  <para style="q1" vid="ROM 10:21">«Mɛlu djas, mɛ naadja mɛmbɔ mam nɛ bot ɛ mbyak di ààlooba nɛ nam ɔ, bot ɛ mengat<note caller="*" style="x"><char style="xo" closed="false">10.21 </char><char style="xt" closed="false"><ref loc="ISA 65:1-2">Eza 65.1-2</ref></char></note>.»<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s1">Zɛɛb ààpaliig bot ɛ mbyak Yisalaɛl koŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Deenek, mɛ dji ɛ́ náá: Zɛɛb eebyen bot bɛ? Yɛ aanàkwaasael deenek! Etɛɛ náá, mam ɛmet ɛ́ mot mbyak Yisalaɛl, dha ɛ Abalaam, mɛ ɛ́ ngɔt tɔ bot ɛ mbyak Bhɛzamɛ. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Zɛɛb ààpabyen bot bɛ nyɛ naloozesɛ́ɛ ɔ. Bi nɛ gu ɛnyɔɛpe sa Ekwyala di elɛɛ ɛ, é di ngoolel-Mɛkpa ɛ Zɛɛb Eli di emwana nɛ Zɛɛb dum nɛ mɛfulu mɛ bɔn ɛ Yisalaɛl ɔ: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />«Ghɛŋ, bɛ naagó bɛngoolel ɛ mɛkpa mɔ, bɛ naabwak emesa e ebuwa bɔ, mɛ kalik ɛ́ mam ɛmet. Tin, bɛ ɛpesaŋ ɛgó ɛ mɛ.» <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Tin, Zɛɛb nakayala nyɛ dáa? «Mɛ dinaa nɛ bot bɛmil ɛtɛn nɛ bɛbá (7 000) mɛ di ebaal ɔ, bot ɛ di náá, bɛ ààpakwyit mɛboŋ mɔɔ si sok bhwoob zɛɛb di edjóoaa Bhal ɔ<note caller="*" style="x"><char style="xo" closed="false">11.4 </char><char style="xt" closed="false"><ref loc="1KI 19:18">Bm1 19.18</ref></char></note>.» <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Yɛ ɛ́ tyee wat, nɛ é mɛwala mɛ bot di'aak, yɛ ɛ́ nɛ ba bim bot bwak tɔ bot ɛ Zɛɛb nasɛ́ɛ tɔ enɛm nɛ embɛɛ bɛ ɔ. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Nyɛ nasɛ́ɛ bɛ ɛ́ tɔ enɛm nɛ embɛɛ, ààbɛ kɔ ɛsu ɛ mɛsa mɔɔ. Yɛ ɛpedi ààdi deenek ɔɔ, pe enɛm nɛ embɛɛ Zɛɛb tokapɛ enɛm nɛ embɛɛ.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Bot aakake tin dáa? Bot ɛ Yisalaɛl ààpabela sa bɛ nadi esaŋ ɛ. Tin, bot ɛ Zɛɛb nasɛ́ɛ ɔ, bɛ naabela sa bɛ nadi esaŋ ɛ. Yɛ kabɛ bɛdhiiti bot ɔɔ, bɛ nabɛ ɛ́ ààbɛ nɛ ghwyil ɛmɛt etɛp binek. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Yɛ ɛ́ dáa Ekwyala di elɛɛ ɛ: «Zɛɛb naasa náá, esisim bɔɔ di ààmɛt etɛp tak, nyɛ naadipal mis, étɛp bɛ needi ààbee, diyal mɛlɔ mɔɔ dɔɔ nɛ dwoo pan mos'ak, étɛp bɛ needi ààgwak<note caller="*" style="x"><char style="xo" closed="false">11.8 </char><char style="xt" closed="false"><ref loc="DEU 29:3">Dɛt 29.3</ref>; <ref loc="ISA 6:10">Eza 6.10</ref>; <ref loc="ISA 29:10">29.10</ref></char></note>.» <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />Tin, mɛkoozi Dhavid naabaake náá:</para>
  <para style="q1" vid="ROM 11:9">«Mɛbyoŋ mɔɔ di nɛ nɔɔ laab,</para>
  <para style="q2" vid="ROM 11:9">ye di nɛ nɔɔ ɛwyet,</para>
  <para style="q1" vid="ROM 11:9">ye di nɛ nɔɔ ɛbɛk ɛ aakwyesal bɛ ɔ,</para>
  <para style="q2" vid="ROM 11:9">da bɛ ɛ́ bela feŋ bɛ di egoka nɛ yɛ ɛ.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Beta náá, mis mɔɔ ghomela,</para>
  <para style="q2" vid="ROM 11:10">bɛ di ààkanyaa sok,</para>
  <para style="q1" vid="ROM 11:10">bɛ gheedi nɛ ekoŋ nyaka<note caller="*" style="x"><char style="xo" closed="false">11.10 </char><char style="xt" closed="false"><ref loc="PSA 69:23-24">Mɛd 69.23-24</ref></char></note>.»<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Deenek, mɛ ɛpedji náá: É ghɛŋ eYuda nabema ɛbɛk ɛ, bɛ nakadi ɛ́ tɔ ndjɛ kɔm-kɔm é? Yɛ aanàkwaasael deenek! Tin, kɔ ɛsu ɛ ɛdjak ɛ lɔɔ, tsik naadjɛaa bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ etɛɛ náá, ye neekpaa bot ɛ mbyak eYuda elyem. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Tin, yɛ bɛ náá, ɛdjak ɛ eYuda naasa náá, bot ɛ bɔs bela mɛvu mɛ Sisim ɔɔ, yɛ bɛ náá, ndjɛ yɔɔ naasa náá bot ɛ membyak mɛ sis bela mɛvu ɔɔ, haaa mɛvu aakadi dáa, yɛ di náá, bot ɛ mbyak eYuda eebulal elyem nɛ Zɛɛb étɛp tsik'ɔɔ ɔ?<verse eid="ROM 11:12" /></para>
  <para style="s">Tsik bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Mɛ kalii wak nenak ɛ́ nɛ biyɔ bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ: Mɛ ɛ́ mot-lwoma, étɛp bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ. Dáa ye di deenek ɛ́, mam, mɛ ɛpemyaala nɛ mɛsa mam. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Mɛ sa deenek ɛ́, étɛp ye neekpaa bɔn-nyɛɛg bam bot ɛ mbyak eYuda elyem. Yɛ ɛ́ etɛɛ náá, ba bim bot pak'ɔɔ neetsak. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Etɛɛ náá, é ghɛŋ Zɛɛb nalum bot ɛ mbyak eYuda koŋ ɛ, ye naasa náá, bot ɛ bɔs bulal ɛgwakel nɛ Zɛɛb. Haaa yɛ aakadi dáa, é ghɛŋ Zɛɛb aasa náá, ɛgwakel bula-bula sis nɛ bot ɛ mbyak eYuda ɔ? Nɛ tsɛɛtsɛ, yɛ aadi ɛ́ dáa bot aadus tɔ ɛsyee bula tɔ tsik ɛ!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />Yɛ bɛ náá, tom mapa eedjɛaa nɛ Zɛɛb ɔɔ, ye lɛɛ ɛ́ náá, djas ɛ tak moo ɛ́ yɛ. Yɛ bɛ náá, ekaŋal e le ɛ́ yii Zɛɛb ɔɔ, deenek, elɛɛ e le tak pe ɛ́ yɛ. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Bot ɛ Yisalaɛl ɛ́ dáa le oliv Zɛɛb natsaal edhiiti elɛɛ ɛ. Tin, wɔy mot di ààbɛ mot mbyak eYuda ɔ, wɔ ɛ́ dáa lɛɛ le oliv dik, wɔ eezɛbotelaa pak elɛɛ e le tak. Nenak, biyɔ djas lɔɔg bi ɛ́ nɛ ghwyil ɛdɛ mbɛɛ mɛdii mɛ le yenek di edus tɔ ekaŋal ɛ. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />Étɛp tak ɛ di náá, sa wɔ ààbyasal elɛɛ natsaalaa ɛ. Haaa yɛ ɛ́ yaa ɛbet wɔ aakosa? Ye tok wɔy di edjɛ ekaŋal ghwyil, yɛ ɛ́ ekaŋal ɛ di edjɛ wɔ ghwyil.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />Deenek, wɔ ɛ́ nɛ ghwyil ɛke náá: «Elɛɛ bak natsaalaa ɛ́ étɛp mɛ neebotelaa é di yɔɔ.» <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Yɛ ɛ́ tsɛɛtsɛ. Elɛɛ binek natsaalaa ɛ́ etɛɛ náá, ye nabɛ ɛ́ ààbɛ nɛ ɛdum ɛ koŋ nɛ Zɛɛb. Wɔy botelaa é di'enek ɛ kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɔ nɛ Zɛɛb. Tin, sa wɔ ààsa ɛbet, kaaba Zɛɛb. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Tin, tyee wat nɛ dáa Zɛɛb natsaal elɛɛ e le nabɛaa ɛ, wɔ ɛ́ koobaka ekaab náá, nyɛ ɛzɛkɛbaasa nɛ nɔ deenek. <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />Beea dáa Zɛɛb di elyaal é ɛwala wat, enɛm esa bɛ, nɛ ɛlyel ɛ mɛtiŋ mɛ ɛ: Nyɛ nɛ lyel mɛtiŋ nɛ bot ɛ di esa mesyem ɔ, nyɛ nɛ tel wɔ enɛm esa bɛ. Tin, wɔ goka ɛ́ nɛ ɛwa ɛbwaalel tɔ enɛm esa bɛ, yɛ di ààbɛ deenek ɔɔ, wɔ aatsaalaa dáa lɛɛ le. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Bot ɛ mbyak eYuda ɛ bulal ɛdum ɛ koŋ ɛ lɔɔ nɛ Zɛɛb ɔɔ, bɛ waabomelaa é di bɛ nadi sok ɔ, etɛɛ náá, Zɛɛb ɛ́ nɛ ghwyil ɛbaabomal bɛ bomela sis. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Wɔy, wɔ ɛ́ tɛtɛ lɛɛ le oliv dik ee Zɛɛb natsaal da botal ɛ. Ààbɛ tyee le oliv nabɛaa-bɛak ɛ. Yɛ kabɛ bot ɛ mbyak eYuda ɔɔ, bɛ ɛ́ dáa etɛtɛ elɛɛ e le oliv nabɛaa-bɛak ɛ. Zɛɛb ɛ́ nɛ ghwyil ɛbomal bɛ bomela sis é di bɛ nadi sok ɔ.<verse eid="ROM 11:24" /></para>
  <para style="s1">Bot ɛ mbyak Yisalaɛl ɛ́ waabela tsik</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Bɔn-nyɛɛg bam, mɛ ɛpekwyɛl náá, bi gu etɛp e Zɛɛb di syela ɛ, deenek ɛ́ bi aagu náá, bi tok bɛtsoŋ ɛ bot. Mɛlyel mɛ elyem mɛ bɛdhiiti bot tɔ sama bot ɛ Yisalaɛl aabɔya kɛkum ɛlu ɛ bot ɛ membyak mɛ sis djas aabela tsik ɛ. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Yɛ ɛ́ deenek ɛ́ bot ɛ Yisalaɛl djas aabela tsik, dáa Ekwyala di elɛɛ ɛ:</para>
  <para style="q1" vid="ROM 11:26">«Mot aazɛpɛk bot ɔ, aadus ɛ́ pɛ Siyɔn,</para>
  <para style="q1" vid="ROM 11:26">nyɛ waadis mɛlyel mɛ elyem mɛ bɛdha ɛ Zakɔɔb. <verse eid="ROM 11:26" /><verse number="27" style="v" sid="ROM 11:27" />Yenek ɛ́ ɛbhɛŋ ɛ lam mɛ aasa nɛ nɔɔ ɛ,</para>
  <para style="q1" vid="ROM 11:27">é ghɛŋ mɛ aadis mesyem mɔɔ ɛ<note caller="*" style="x"><char style="xo" closed="false">11.27 </char><char style="xt" closed="false"><ref loc="ISA 59:20-21">Eza 59.20-21</ref>; <ref loc="ISA 27:9">27.9</ref></char></note>.»<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Yɛ bɛ náá, nɛ tsɛɛtsɛ bɛ eebyen Mbɛɛ Bhaadal ɔɔ, bɛ ɛ́ bot ɛ mɛbhuka ɛ Zɛɛb étɛp enɛm bin. Tin, yɛ kabɛ nɛ dáa Zɛɛb sɛ́ɛ bɛ ɔɔ, Zɛɛb nɛ kwyɛl bɛ kɔ ɛsu ɛ bɛbhaab bɔɔ. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Etɛɛ náá, Zɛɛb ààdɛk ɛkɛɛ ɛ nyɛ nazedjɛ bɛ ɛ, nyɛ ààswoola esiiza bɛ dum nɛ bot ɛ nyɛ nazedjóo ɔ. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />É ghɛŋ sok, bi naabyen ɛlooba nɛ Zɛɛb, nenak yak, bi eezegu boo lyem ghoŋ ɛ Zɛɛb, etɛɛ náá, bot ɛ mbyak eYuda naabyen ɛlooba nɛ Zɛɛb. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Tyee wat nɛ bɔɔ pe, nenak bɛ eebyen ɛlooba etɛɛ náá, boo lyem ghoŋ ɛ Zɛɛb needi nɛ nen. Deenek, bɔɔ pe neebela boo lyem ghoŋ tak nenak<note caller="+" style="f"><char style="fr" closed="false">11.31 </char><char style="fq" closed="false">nenak </char><char style="ft" closed="false">tɔ bɛdhiiti bɛmɛkana, bɛ ààpake «nenak».</char></note>. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Etɛɛ náá, Zɛɛb eezesa náá, bot djas byen ɛlooba, étɛp nyɛ neelyaal bot djas boo lyem ghoŋ'ɛ.<verse eid="ROM 11:32" /></para>
  <para style="s1">Boo duu ɛ Zɛɛb</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Ekum e Zɛɛb nɛ bɔk! Nyɛ nɛ bu etsoŋ, nyɛ nɛ bu ɛgu! Ɛzɛ di nɛ ghwyil ɛpɛs epɛ́ɛ bɛ? Ɛzɛ di nɛ ghwyil ɛpiibal mɛze mɛ<note caller="*" style="x"><char style="xo" closed="false">11.33 </char><char style="xt" closed="false"><ref loc="ISA 55:8">Eza 55.8</ref>; <ref loc="PSA 139:6">Mɛd 139.6</ref>,<ref loc="PSA 139:17-18">17-18</ref></char></note>? <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />Dáa Ekwyala di elɛɛ ɛ:</para>
  <para style="q1" vid="ROM 11:34">«Ɛzɛ di egu esiiza e Ghɛŋ?</para>
  <para style="q1" vid="ROM 11:34">Ɛzɛ aakodi lyoel yɛ?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Ɛzɛ nakonyɛl ɛdjɛ nyɛ sonok sok?</para>
  <para style="q1" vid="ROM 11:35">Etɛɛ náá, mot tak neebela efute bhii tak<note caller="*" style="x"><char style="xo" closed="false">11.35 </char><char style="xt" closed="false"><ref loc="ISA 40:13">Eza 40.13</ref>; <ref loc="JER 23:18">Zel 23.18</ref>; <ref loc="JOB 15:8">Zɔb 15.8</ref>; <ref loc="JOB 41:3">41.3</ref></char></note>?»<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />Etɛɛ náá, esonok djas dus ɛ́ pɛ daa lɛ, yɛ ɛ́ kɔ ɛsu ɛ lɛ ɛ esonok djas di kɔ bɔs, esonok djas ɛ́ yɛ.</para>
  <para style="q1" vid="ROM 11:36">Duu di nɛ nɛ kɔm-kɔm sii nɛ kɔm! <char style="sc">Amɛn</char>.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Tsik na bes sama nɛ Klisto</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Deenek, bɔn-nyɛɛg, dáa ye di náá, Zɛɛb eezelyaal boo lyem ghoŋ'ɛ nɛ nena ɛ, mɛ ɛpedjɛ bin mɛghaaz náá, bi ka mɛnyel men dáa buwa di nɛ tsik ɛ, buwa na dɛɛ Zɛɛb di emyaala nɛ yɛ ɛ. Deenek, yɛ ɛ́ nɛ nen ɛ́ tɛtɛ mendjaala. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Sa bi ààbaŋa mɛfulu mɛ bot ɛ bɔs'ak. Tin, betka náá, Zɛɛb nyɛ ɛmet swoola esiiza bin, etɛɛ náá, bi needi bot ɛ na bes. É di'enek ɛ, bi aagu ɛkwosak ɛ Zɛɛb: yɛ ɛ́ sa di enyɔ ɛ, sa nyɛ di emyaala nɛ yɛ ɛ, sa di ààbɛ nɛ ɛtɔn ɛ.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Kɔ ɛsu ɛ enɛm nɛ embɛɛ ee Zɛɛb nadjɛ mɛ ɛ, mɛ lɛɛ nɛ nen ɛ́ náá: Sa bi ààdi nɛ ɛghɛɛa nyel kɛdhaa. Ye goka ɛ́ náá, mot nɛ mot gu mbi mot nyɛ di ɛ, dum nɛ yɛ ɛkɛɛ yii ɛdum ɛ koŋ nɛ Zɛɛb nyɛ bela ɛ. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Dáa ye di náá, nyel wat mena dika nɛ yɛ nɛ bu ekyes ɛ, kyes nɛ kyes ɛ́ nɛ mɛsa mɛ ye di esa ɛ. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />Ye nakoozodi náá, bot ɛ́ ɛbuɛpe, bot moo ɛ́ nyel ngɔt tɔ ɛgwakel nɛ Klisto. Deenek, bot ɛ́ tɔ ɛgwakel pak'enaka dáa esum e nyel mot ngɔt. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Deenek, menaka ɛ́ nɛ mɛkɛɛ membi nɛ membi Zɛɛb nadjɛ mot nɛ mot dum nɛ enɛm nɛ embɛɛ bɛ ɛ. Mot ngɔt tɔ len ɛ bela ɛkɛɛ ɛ ɛgoola bhaadal dus pɛ daa Zɛɛb ɔɔ, nyɛ goka ɛ́ nɛ ɛsa yɛ ɛ́ tɔ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Tin, yɛ bɛ náá, mot ngɔt ɛ́ nɛ ɛkɛɛ ɛ ɛsa mɛsa ɔɔ, nyɛ sa yɛ. Yɛ bɛ náá, mot ngɔt ɛ́ nɛ ɛkɛɛ ɛ ɛlyo ɔɔ, nyɛ lyo. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Yɛ bɛ náá, mot ɛ́ nɛ ɛkɛɛ ɛ ɛdjɛ bɛsɔ mɛghaaz ɔɔ, nyɛ goka ɛ́ nɛ ɛsa yɛ. Yɛ bɛ náá, mot ɛ́ nɛ ɛkɛɛ ɛ ɛgwyena ɔɔ, nyɛ goka ɛ́ nɛ sa yɛ nɛ mbɛɛ lyem. Yɛ bɛ náá, mot ɛ́ nɛ ɛkɛɛ ɛ ɛdjɛɛd bɛsɔ bot ɔɔ, nyɛ goka ɛ́ nɛ ɛsa yɛ nɛ zii. Yɛ bɛ náá, mot ɛ́ nɛ ɛkɛɛ ɛ ɛkwyee bɛdjel ɛ bot ɔɔ, nyɛ goka ɛ́ nɛ ɛsa yɛ tɔ mɛmyaala<note caller="*" style="x"><char style="xo" closed="false">12.8 </char><char style="xt" closed="false"><ref loc="1KI 12:4-12">Bm1 12.4-12</ref></char></note>.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Beta náá, kwyɛl bi di nɛ yɛ ɛ, di ààbɛ nɛ mɛdjhaaz pɛ ɛko bhimis pɛ si. Byenka ɛsa ɛbiyo, dika tɔ enɛm esa. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Kwyɛlaka pak'en nɛ lyem wat dáa bɔn-nyɛɛg tɔ ɛdum ɛ koŋ nɛ Zɛɛb, kaabelka pak'en. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Tin, dika bot ɛ ɛsa mɛsa ɛ Ghɛŋ waŋa-waŋa nɛ bham djas, ààkabɛ tɔ elɛtɛ. Waka zii tɔ ɛsa mɛsa ɛ Ghɛŋ. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Dika nɛ mɛmyaala kɔ ɛsu ɛ ɛbwaalel ɛ len. Dika nɛ ɛmaad ɛ lyem tɔ mezuk. É di'enek, bi goka ɛ́ nɛ ɛwa zii tɔ mendjaala. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Tin, kwyeeka bɔn-nyɛɛg bin bot ɛ na dɛɛ di tɔ pwom ɔ. Beka bot djas di esulal pɛ yebɔ ɛ ɛnyɔɛpe.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Deenek, djaalaka náá, Zɛɛb sa enɛm esa nɛ bot ɛ di etiig bin ɔ. Djaalaka náá, Zɛɛb sɛɛ bɛ mɛtel, ààbɛ náá, nyɛ wa bɛ tɔ mbee baka<note caller="*" style="x"><char style="xo" closed="false">12.14 </char><char style="xt" closed="false"><ref loc="MAT 5:44">Mat 5.44</ref>; <ref loc="LUK 6:28">Luk 6.28</ref></char></note>. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Myaalaka sama nɛ bot ɛ di tɔ mɛmyaala ɔ, djeka sama nɛ bot ɛ di edje ɔ. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Dika tɔ ɛgwakel pak'en. Tin, sa bi ààdi bot ɛ ɛghɛɛa nyel, dika bot ɛ mɛsila. Tin, sa bi ààbee náá, biyɔ bɛmet ɛ́ zodi bɛtsoŋ ɛ bot<note caller="*" style="x"><char style="xo" closed="false">12.16 </char><char style="xt" closed="false"><ref loc="ISA 5:21">Eza 5.21</ref></char></note>.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Sa bi ààbulal ɛbiyo nɛ mot sa bin ɛbiyo ɔ. Waka lyem tɔ ɛsa enɛm esa é mis mɛ bot djas. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Yɛ bɛ náá, ye dus ɛ́ nɛ nen ɔɔ, bi ɛ di nɛ ghwyil ɔɔ, saka náá, bi di tɔ ɛgwakel nɛ bot djas. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Bɔn-nyɛɛg bam mɛ di ekwyɛl ɔ, pak'en, sa bi ààbulal ɛbiyo nɛ ɛbiyo. Tin, betka náá, Zɛɛb nyɛy ɛmet wa mot di esa ɛbiyo ɔ é feŋ, etɛɛ náá, Ghɛŋ lɛɛ tɔ Ekwyala ɛ́ náá: «Yɛ ɛ́ mam ɛ di egoka nɛ ɛbulal ɛbiyo bɛ sa bin ɛ, mam ɛ di edjɛ mot nɛ mot yɛ efute.» <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Tin, Ekwyala baalɛɛ ɛ́ náá: «Yɛ bɛ náá, mot mɛbhuka mɔ ɛ́ nɛ za, nɛghu nɛ gwyes mɛdii ɔɔ, djɛa nyɛ. Etɛɛ náá, wɔ di esa deenek ɔɔ, yɛ ɛ́ dhatyee náá, wɔ ɛpekɛl nyɛ da kɔ lo<note caller="*" style="x"><char style="xo" closed="false">12.20 </char><char style="xt" closed="false"><ref loc="DEU 32:35">Dɛt 32.35</ref>; <ref loc="PRO 25:21-22">Eka 25.21-22</ref></char></note>.» <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />Deenek, sa wɔ ààbet náá, ɛbiyo kwak wɔ. Tin, ye goka ɛ́ náá, enɛm esa bɔ bela eghɛŋ kɔ ɛbiyo.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s1">Ɛlooba nɛ eKukuma</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Mot nɛ mot goka ɛ́ nɛ ɛlooba nɛ eKukuma di edjɛɛd bot kɔ bɔs ɔ. Etɛɛ náá, ghwyil ekukuma djas dus ɛ́ pɛ daa Zɛɛb. Tin, bot ɛ di ekukuma ɔ, yɛ ɛ́ Zɛɛb ɛ nadjɛ bɛ bóó ekukuma. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Étɛp tak ɛ di náá, mot ɛ byen ɛlooba nɛ kukuma ɔɔ, nyɛ eebyen ɛlooba nɛ lwomel Zɛɛb nadjɛ ɛ. Tin, bot ɛ di ebyen ɛlooba ɔɔ, bɛ ɛpedul epɛ́ɛ kɔ lɔɔ. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Bot ɛ di esa enɛm esa ɔ, bɛ tok nɛ ghwyil ɛgwak bwoo nɛ ekukuma. Tin, yɛ ɛ́ bot ɛ di esa embee mɛsa ɔ di egoka nɛ ɛdi nɛ bwoo nɛ ekukuma. Wɔ kwyɛl ɛdi ààbɛ nɛ bwoo nɛ ekukuma ɔɔ, wɔ goka ɛ́ nɛ ɛsa enɛm esa, bɛ waamyaala nɛ nɔ. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Etɛɛ náá, ekukuma sa mɛsa mɛ Zɛɛb ɛ́ étɛp ɛkwyee wɔ é ɛsa enɛm esa. Tin, yɛ bɛ náá, wɔ eesa ɛbiyo ɔɔ, bema ba nɛ nɔɔ, etɛɛ náá, Zɛɛb naadjɛ bɛ ghwyil ɛwa bot ɛ di esa ɛbiyo ɔ é feŋ. É sok bɛ di esa deenek ɛ́, bɛ sa ɛ́ mɛsa ɛ Zɛɛb, étɛp ɛlyaal ɛbuk ɛ Zɛɛb nɛ bot ɛ di esa embee mɛsa ɔ. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Dum nɛ tɛp tak ɛ di egoka náá, bot looba nɛ ekukuma, ààzobɛ-bɛak étɛp ɛkaab ɛ feŋ. Tin, loobaka nɛ nɔɔ, etɛɛ náá, bi nɛ gu tɔ ebhum e elyem bin náá, yɛ ɛ́ sa di ɛnyɔɛpe ɛ.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />Kɔ ɛsu ɛ tak ɛ bi di etuud membi mɛ lapo djas. Etɛɛ náá, bot ɛ di enɔɔ epata e lapo tak ɔ, sa ɛ́ mɛsa mɛ Zɛɛb. Étɛp tak ɛ bɛ di esa zii é ɛsa mɛsa mɛ tak. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Tuudka mot nɛ mot sa di egoka nɛ ɛtuudaa ɛ: Yɛ bɛ náá, yɛ ɛ́ etuud e epata e lapo ɔɔ, tuudka epata e lapo. Yɛ kabɛ dhiiti mbi etuud sis ɔɔ, tuudka yɛ. Yɛ bɛ ɛlooba ɔɔ, loobaka. Yɛ kabɛ tɛp ɛdjɛ duu ɔɔ, djɛka duu nɛ mot di egoka nɛ duu ɔ.<verse eid="ROM 13:7" /></para>
  <para style="s1">Kwyɛl nɛ sɔ'ɔ mot</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Nàdi nɛ kola nɛ sɔ'ɔ mot, ye di ààbɛ kola kwyɛl bi di egoka nɛ ɛdi nɛ yɛ pak'en ɔɔ, etɛɛ náá, mot di ekwyɛl bɛsɔ ɔ, looba ɛ́ nɛ etsi djas. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />É di'enek, etsi lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 13:9">«Sa wɔ ààsa mɛzɔ,</para>
  <para style="q1" vid="ROM 13:9">sa wɔ ààgó mot,</para>
  <para style="q1" vid="ROM 13:9">sa wɔ ààdjii sa mot,</para>
  <para style="q1" vid="ROM 13:9">sa wɔ ààwyeeb sa mot.»</para>
  <para style="m" vid="ROM 13:9">Mɛtiŋ menek djas dus ɛ́ tɔ ɛtiŋ ɛ wat di eke náá: «Kwyɛla sɔ'ɔ mot dáa wɔ di ekwyɛl nyel'ɔ ɛmet ɛ<note caller="*" style="x"><char style="xo" closed="false">13.9 </char><char style="xt" closed="false"><ref loc="EXO 20:13-17">Ɛwy 20.13-17</ref>; <ref loc="DEU 5:17-21">Dɛt 5.17-21</ref>; <ref loc="LEV 19:18">Msa 19.18</ref></char></note>.» <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Mot di ekwyɛl mɔɔ sɔ mot ɔ, nyɛ tok nɛ ghwyil ɛsa nyɛ sa ɛbiyo. Tin, wɔ kwyɛl sɔ'ɔ mot ɔɔ, wɔ eelooba nɛ etsi djas.<verse eid="ROM 13:10" /></para>
  <para style="s1">Ɛdi ɛ́ ndjem étɛp ɛzyɛ ɛ Klisto</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Saka deenek etɛɛ náá, bi nɛ gu mɛwala mɛ mena kadika mos'aak: Yɛ ɛ́ ɛwala ɛ mena di egoka nɛ ɛdjem é egɔ́ ɛ. Etɛɛ náá, tsik moo ɛ́ ɛkunaaɛpe nɛ nena dhaa-dhaŋak é ghɛŋ mena nadumka koŋ nɛ Yezu Klisto ɛ. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Deenek, pum moo ɛ́ ɛtsetaɛpe, mɛlem moo aalem. Djhookatka ɛsa embee mɛsa mɛ di esael tɔ ghooghom ɛ, deenek, djhoonɔɔka bɛghɛl ɛ di ebeaa é mwos ɛ. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Djhookɛka tɔ epiki, dáa bot ɛ di ekɛ tɔ gwyɛ ɔ. Sa mena ààdika bot ɛ elangi, bot ɛ mɛzɔ. Sa mena ààdika bot ɛ di enɔɔ mɛzɔ tyee mɛsa ɔ. Sa mena ààdika bot ɛ mɛwɔ, bot ɛ di ewyeeb esa e bot ɔ.<verse eid="ROM 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 13:14" />Tin, dika nɛ mɛfulu ɛ Ghɛŋ Yezu Klisto. Sa bi ààbet náá, embee mɛkwosak pus bin é ze ɛbiyo.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s1">Sa wɔ ààpɛ́ɛ mɔn-nyoog</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Myaalka ɛdi ɛnyɔɛpe nɛ mot di ààlyel tɔ ɛdum ɛ koŋ nɛ Zɛɛb ɔ, sa bi ààlii ɛbiyoɛpe dum nɛ mɛkpa mɛ. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Yɛ ɛ́ nɛ ghwyil ɛdi náá, mot ɛpemyaal ɛdɛ membi mɛ edee djas. Ye kabela ɛ́ náá, mot di ààlyel ɛnyɔɛpe tɔ ɛdum ɛ koŋ nɛ Zɛɛb ɔ zodɛ yɛ ɛ́ mɛwyee. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />É di'enek, mot di edɛ membi mɛ edee djas ɔ, sa nyɛ ààbyasal mot di etsi edhiiti membi mɛ edee ɔ. Mot di etsi edhiiti membi mɛ edee ɔ, sa nyɛ ààbyasal mot di edɛ membi mɛ edee djas ɔ, etɛɛ náá, Zɛɛb eemyaal nyɛ pe. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Wɔy ɛ́ yɔ zɛ étɛp ɛpɛ́ɛ mot-mɛsa mɛ mot sis? Yɛ bɛ náá, nyɛ eesa mɛsa mɛ ɛnyɔɛpe nɛghu nyɛ ààpasa ɛnyɔɛpe ɔɔ, ye gwyák ɛ́ kukuma yɛ. Tin, nyɛ aapyet tɔ ɛsa mɛsa mɛ, etɛɛ náá, Ghɛŋ ɛ́ nɛ ghwyil ɛsa náá, nyɛ pyet.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Mot ɛ́ nɛ ghwyil ɛbee náá, yak ɛlu eedhaa yak. Tin, dhiiti mot kabee ɛ́ náá, mɛlu djas ɛ́ djala. Mot nɛ mot goka ɛ́ ɛdi nɛ ɛmyaal tɔ sa nyɛ di egek ɛ. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Mot di ewa mbɛk pak mɛlu ɔ, nyɛ sa yɛ ɛ́ étɛp ɛduwal ɛ Ghɛŋ, mot di edɛ membi mɛ edee djas ɔ, nyɛ sa deenek ɛ́ étɛp ɛduwal ɛ Ghɛŋ, etɛɛ náá, nyɛ nɛ bulal bhɔɔ nɛ Zɛɛb kɔ ɛsu ɛ edee. Mot di etsi edhiiti membi mɛ edee ɔ, nyɛ sa deenek ɛ́ étɛp ɛduwal ɛ Ghɛŋ, nyɛy pe baabulal ɛ́ bhɔɔ nɛ Zɛɛb. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Ye tok nɛ mot pak'ena di nɛ tsik kɔ ɛsu ɛ lɛ met. Ye tok pe nɛ mot di egwyɛ kɔ ɛsu ɛ lɛ met. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Yɛ bɛ náá, mena ɛ́ nɛ tsik ɔɔ, yɛ ɛ́ kɔ ɛsu ɛ Ghɛŋ, yɛ bɛ náá, mena eegwyɛ ɔɔ, yɛ ɛ́ kɔ ɛsu ɛ Ghɛŋ. É di'enek, ye nakoozodi náá, mena ɛ́ nɛ tsik, nɛghu mena eegwyɛ, menaka ɛ́ bot ɛ Ghɛŋ. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Etɛɛ náá, Klisto naagwyɛ, gom étɛp ɛdi ɛ́ Ghɛŋ bot ɛ nazegwyɛ ɔ, nɛ bot ɛ di nɛ tsik ɔ. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Wɔy, étɛp yé wɔ di epɛ́ɛ mɔn-nyoog? Nɛ wɔy pe, étɛp yé wɔ di ebyasal mɔn-nyoog? Bela náá, menabɛlka djas ɛ́ waatyaaka sok bhwoob ɛ Zɛɛb étɛp epɛ́ɛ. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="ROM 14:11">«Mam Ghɛŋ, mot di nɛ tsik ɔ, mɛ eemyaal nɛ tsɛɛtsɛ náá:</para>
  <para style="q1" vid="ROM 14:11">Bot djas ɛ́ waakwyit mɛboŋ sok bhwoob'am,</para>
  <para style="q1" vid="ROM 14:11">bot ɛ membyak djas ɛ́ waaduwal duma ɛ Zɛɛb<note caller="*" style="x"><char style="xo" closed="false">14.11 </char><char style="xt" closed="false"><ref loc="ISA 45:23">Eza 45.23</ref></char></note>.»<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Deenek, mot nɛ mot ɛ́ waataŋal dum nɛ yɛ mɛsa é mis ɛ Zɛɛb.<verse eid="ROM 14:12" /></para>
  <para style="s1">Sa wɔ ààkwyesal mɔn-nyoog tɔ mɛbhowal</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Djhookatka ɛwa epɛ́ɛ pak'enaka. Sa bi ààdi nɛ mɛfulu mɛ di epus bɔn-nyɛɛg bin, bot ɛ di ààlyel tɔ ɛdum ɛ koŋ nɛ Zɛɛb ɔ náá, bɛ bema ɛbɛk nɛghu ɛpus bɛ tɔ ɛbiyo. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Kɔ ɛsu ɛ Ghɛŋ Yezu, mɛ nɛ gu ɛnyɔɛpe náá, ye tok nɛ dhiiti sonok di nɛ edhuud<note caller="*" style="x"><char style="xo" closed="false">14.14 </char><char style="xt" closed="false"><ref loc="MRK 7:19">Mak 7.19</ref></char></note>. Tin, mot ɛ bee náá, yak sonok ɛ́ nɛ edhuud ɔɔ, yɛ aakadi ɛ́ nɛ edhuud étɛp'ɛ. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Wɔ djɛ mɔn-nyoog tuŋ kɔ ɛsu ɛ edee ɔɔ, gua náá, wɔ ààkakɛ tɔ kwyɛl. Deenek, sa wɔ ààgel tsik mɔn-nyoog, mot Klisto nagwyɛ étɛp'ɛ ɔ, kɔ ɛsu ɛ ba mɔɔ tɛp edee. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Yɛ ààgoka náá, sa di enyɔ nɛ biyɔ ɛ, ye kadi sa di edjɛ bɛdhiiti bot ze ɛlii ɛbiyoɛpe nɛ nen ɛ. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Étɛp tak ɛ di náá, Ɛyoŋ ɛ Zɛɛb tok étɛp edee nɛghu étɛp edhiiti esa e dek. Tin, yɛ ɛ́ epiki, egwyem, nɛ mɛmyaala yii Sisim na Dɛɛ di edjɛ ɛ. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Mot di esa mɛsa mɛ Klisto deenek ɔ, nyɛ ɛ́ mbɛɛ mot é mis ɛ Zɛɛb, bot ɛ́ waadjɛ nyɛ gham.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Djhoosaaka sa di egoka nɛ egwyem ɛ, nɛ sa di egoka nɛ ɛkwyee mena náá, mena tɔ́ka sok tɔ ɛdum ɛ koŋ nɛ Zɛɛb ɛ. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Sa wɔ ààpul mɛsa mɛ Zɛɛb kɔ ɛsu ɛ edee. Nɛ tsɛɛtsɛ, membi mɛ edee djas ɛ́ dɛɛ, ye goka ɛ́ nɛ ɛdɛel. Tin yɛ àànyɔ náá, bot dɛ sa di nɛ ghwyil ɛpus mɔn-nyɛɛg'ena tɔ ɛdjak ɛ. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Sa di ɛnyɔɛpe ɛ, yɛ ɛ́ ɛtsi ɛ tit, ɛtsi ɛ mɛnyok, yɛ ɛ́ ɛbyen ɛ sa djas di nɛ ghwyil ɛpus mɔn-nyoog tɔ ɛdjak ɛ. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Ɛmyaal wɔ di nɛ yɛ dum nɛ tɛp edee ɛ, dia nɛ yɛ étɛp wɔy ɛmet é mis ɛ Zɛɛb. Mɛmyaala nɛ mot di ààdjɛ lyem'ɛ mɛbɛ nɛ sa nyɛ zesɛ́ɛ ɛ. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Tin, mot ɛ di nɛ mbee esiiza é sok nyɛ di edɛ edee ɔɔ, Zɛɛb waawa nyɛ é feŋ. Etɛɛ náá, ɛmyaal ɛ lɛ ɛ́ zyaala nɛ sa nyɛ sa ɛ. Tin, sa djas di zyaala nɛ ɛmyaal ɛ, yɛ ɛ́ syem.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s1">Dia dáa Klisto</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Menabɛlka bot ɛ di elyel tɔ ɛdum ɛ koŋ nɛ Zɛɛb ɔ, mena goka ɛ́, nɛ ɛdjɛ mɛghaaz nɛ bot ɛ di náá bɛ dinaa ààpalyel tɔ ɛdum ɛ koŋ nɛ Zɛɛb ɔ. Sa mena ààsaaka esa ee elyem bina di emyaala nɛ yɛ ɛ. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Ye goka ɛ́ náá, mot nɛ mot sa sa di náá, mɔɔ sɔ aamyaala nɛ yɛ ɛ, étɛp ye neenyɔ nɛ nɛ, ye neekwyee nyɛ é ɛtɔ́ sok tɔ ɛdum ɛkoŋ nɛ Zɛɛb. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Tin, Klisto nabɛ ɛ́ ààsaa sa lyem'ɛ aamyaala nɛ yɛ ɛ. Tin, dáa Ekwyala di elɛɛ: «Mɛlee mɛ bɛ nadi elee wɔ ɛ, yɛ eezezii kɔ lo'am<note caller="*" style="x"><char style="xo" closed="false">15.3 </char><char style="xt" closed="false"><ref loc="PSA 69:10">Mɛd 69.10</ref></char></note>.» <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Tin, sa djas nakwyalaa tɔ mɛkana mɛ na dɛɛ na mwa ɛ, ye nabɛ ɛ́ étɛp ye neelyo mena, etɛɛ náá, yɛ ɛ́ kɔ ɛsu ɛ zii nɛ mɛghaaz mɛ Ekwyala di edjɛ mena ɛ, mena aabelaka ɛbwaalel. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Beta náá, Zɛɛb mot di edjɛ bot zii nɛ mɛghaaz ɔ sa náá, bi di tɔ ɛgwakel pak'en dáa Yezu Klisto di esa nɛ nen ɛ. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Etɛɛ náá, biyɔ djas tɔ ɛgwakel dhatyee mot ngɔt, bi aaduwal Zɛɛb, Sɛɛg ɛ Ghɛŋ'enaka Yezu Klisto.<verse eid="ROM 15:6" /></para>
  <para style="s1">Mbɛɛ Bhaadal étɛp bot ɛ membyak djas</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Tin, myaalelka pak'en, dáa Klisto di emyaal bin étɛp duma Zɛɛb ɛ. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Tin, mɛ lɛɛ bin ɛ́ tsɛɛtsɛ náá, Klisto moo ɛ́ mot-mɛsa mɛ bot ɛ mbyak eYuda, étɛp ɛsa náá, ekɛk e Zɛɛb nakɛk nɛ bɛbhaab'ɔɔ ɛ neesael, nɛ ɛbaalyaal náá, Zɛɛb ɛ́ sosoob. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Nyɛ nabaazyɛ ɛ́ etɛɛ náá, bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ needuwal Zɛɛb kɔ ɛsu ɛ boo lyem ghoŋ'ɛ, dáa Ekwyala di elɛɛ ɛ:</para>
  <para style="q1" vid="ROM 15:9">«Dum nɛ tɛp tak ɛ mɛ waaduwal wɔ tɔ bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ,</para>
  <para style="q1" vid="ROM 15:9">nɛ ɛduwal din ɛ lɔ.»<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Ekwyala na dɛɛ ɛpebaalɛɛ náá:</para>
  <para style="q1" vid="ROM 15:10">«Biyɔ bot ɛ membyak mɛ sis, myaalaka sama nɛ bot ɛ mbyak ɛ Zɛɛb.»<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Tin, Ekwyala ɛpebaalɛɛ náá:</para>
  <para style="q1" vid="ROM 15:11">«Bot djas di ààbɛ bot ɛ mbyak eYuda ɔ, duwalka Ghɛŋ,</para>
  <para style="q1" vid="ROM 15:11">biyɔ bot djas di kɔ ɛko ɛ bɔs ɔ, tiika mɛdjeeb mɛ di eduwal Zɛɛb ɛ!»<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Ngoolel-Mɛkpa ɛ Zɛɛb Ezayi ɛpelɛɛ náá:</para>
  <para style="q1" vid="ROM 15:12">«Dha ɛ Yese ngɔt ɛ́ waabyel,</para>
  <para style="q1" vid="ROM 15:12">nyɛ aazyɛ ɛ́ étɛp ɛzɛdi kukuma bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ,</para>
  <para style="q1" vid="ROM 15:12">bot ɛ tak ɛ́ waawa ɛbwaalel ɛ lɔɔ ɛ́ nɛ nɛ<note caller="*" style="x"><char style="xo" closed="false">15.12 </char><char style="xt" closed="false"><ref loc="PSA 18:50">Mɛd 18.50</ref>; <ref loc="2SA 22:50">Sm2 22.50</ref>; <ref loc="DEU 32:43">Dɛt 32.43</ref>; <ref loc="ISA 11:10">Eza 11.10</ref></char></note>.»<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Beta náá, Zɛɛb mot di ɛsuk ɛbwaalel ɔ, lwoodal bin nɛ mɛmyaala nɛ tɛtɛ egwyem kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ len nɛ nɛ. Etɛɛ náá, bi needi nɛ ɛbwaalel nɛ nɛ ɛbuɛpe nɛ ghwyil ɛ Sisim na Dɛɛ.<verse eid="ROM 15:13" /></para>
  <para style="s1">Pɔl ɛ́ nɛ gham ɛkwyal mɛkana dáa nyɛ kwyal ɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Bɔn-nyɛɛg bam, mam ɛmet ɛpemyaal ɛnyɔɛpe náá, bi ɛ́ lwoodela nɛ embɛɛ mɛsa, lwoodela nɛ ghwyil ɛgu sa di egoka náá, bi lyoel pak'en ɛ. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Deenek, nɛ mɛghaaz djas, mɛ naazekwyal bin tɔ bɛtɛ nɛ mɛze mɛ mɛkana mam, étɛp bi neetaala nɛ sa bi nazedjek ɛ. Mɛ nakwyal deenek ɛ́ kɔ ɛsu ɛ enɛm nɛ embɛɛ ee Zɛɛb nadjɛ mɛ ɛ, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />étɛp ɛdi ɛ́ mot-mɛsa ɛ Yezu Klisto dum nɛ bot di ààbɛ bot ɛ mbyak eYuda ɔ. Deenek, mɛ sa ɛ́ mɛsa mɛ mɛbwala tɔ ɛgoola Mbɛɛ Bhaadal ɛ Zɛɛb, etɛɛ náá, bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ needi tyee buwa Zɛɛb di ekwyɛl ɛ, da bɛ ɛ́ beeaa piki é mis ɛ Zɛɛb é ze ɛ Sisim na Dɛɛ. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Tɔ ɛgwakel nɛ Yezu Klisto, mɛ ɛ́ nɛ ghwyil ɛdi tɔ mɛmyaala nɛ Zɛɛb dum nɛ mɛsa mam. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Etɛɛ náá, yɛ bɛ mɛ eelii dum nɛ dhiiti tɛp ɔɔ, yɛ aazodi ɛ́ sa Klisto nasa dum nɛ nam, étɛp ɛdul ɛ bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ, bɛ looba nɛ Zɛɛb. Nyɛ nasa yɛ ɛ, nɛ ghwyil mɛkpa nɛ mɛsa, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />nɛ ghwyil endem e mɛbwala nɛ mɛvyɛkɛlɛ, nɛ ghwyil Sisim Zɛɛb. Étɛp tak ɛ mɛ nagoola nɛ bham djas Mbɛɛ Bhaadal ɛ Klisto, kana pɛ ghaada Yeluzalɛm, zɛnɔɔ mɛdhik mɛ sis kɛkum pɛ kyee dik Iliidi. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Tin, mɛ nazokwyɛl ɛgoola Mbɛɛ Bhaadal pɛ tɔ edi di náá, bot nabɛ ɛ́ bɛ dinaa ààgwak bot elii dum nɛ Klisto ɔ. Mɛ nasa deenek ɛ́, étɛp mɛ needi ààsum kɔ ghus-zumal dhiiti mot. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Mɛ nasa deenek ɛ́ étɛp ɛdu sa Ekwyala di elɛɛ ɛ:</para>
  <para style="q1" vid="ROM 15:21">«Bot ɛ di náá, bɛ nabɛ ɛ́ ààgoola bɛ Mbɛɛ Bhaadal kɔ ɛsu ɛ Klisto ɔ, bɛ waabee nyɛ,</para>
  <para style="q1" vid="ROM 15:21">bot ɛ nadi ààgwak Mbɛɛ Bhaadal tak ɔ, bɛ waagu yɛ<note caller="*" style="x"><char style="xo" closed="false">15.21 </char><char style="xt" closed="false"><ref loc="ISA 52:15">Eza 52.15</ref></char></note>.»<verse eid="ROM 15:21" /></para>
  <para style="s1">Pɔl ɛpelii dum nɛ mɛdjoŋ mɛ pɛ ghaada Lɔm</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Yɛ ɛ́ etɛp binek ɛ nadi elu mɛ esok nɛ esok náá, mɛ nàzyɛ pɛ yebɔ. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />Tin, nenak, mɛ eesilal mɛsa mam kɔ mɛdhik mak. Bela náá, membu nɛ membu, mɛ nadi ekwyɛl ɛzyɛ pɛ yebɔ. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />Mɛ kwyɛl ɛsa yɛ ɛ́, é ghɛŋ mɛ aatɔ́ pɛ kyee dik Ɛspanyɛ ɛ. Etɛɛ náá, mɛ ɛ́ nɛ ɛbwaalel ɛbela mɛkɛɛ é sok mɛ aadhaa pɛ yebɔ ɛ, étɛp ɛtɔ́ pɛ kyee dik yenek ɛ. Tin, mɛ waadi ba mɛlu pɛ yebɔ. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Tin, nenak yak, mɛ tɔ́ ɛ́ pɛ ghaada Yeluzalɛm étɛp ɛsa mɛsa pɛ daa bot ɛ zedum koŋ nɛ Zɛɛb di penek ɔ. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Étɛp tak ɛ, bot ɛ zɛɛga mendjaala ghaada Masedwan nɛ yii ghaada Akayi naamyam ɛsɛɛg epata, étɛp ɛkwyee bɛdjel ɛ bot ɛ zedum koŋ nɛ Zɛɛb di kɔ ghaada Yeluzalɛm ɔ. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Bɛ namyam ɛsa yɛ ɛ́ nɛ mɛghwyil mɔɔ met, tin, nɛ tsɛɛtsɛ, bɛ nadi ɛ́ nɛ kola yɔɔ. Etɛɛ náá, bot ɛ mbyak eYuda di ekeletyɛ ɔ naagwyena esa e Sisim nɛ bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ. Deenek, bot ɛ di ààbɛ bot ɛ mbyak eYuda ɔ, goka ɛ́ nɛ ɛkwyee bɛ nɛ ekum bɔɔ. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />É sok mɛ aasilal etɛp binek ɛ, é sok mɛ aadjɛ bɛ epata binek ɛ, mɛ waadhaa pɛ yebɔ étɛp ɛgoola pɛ kyee dik Ɛspanyɛ. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Tin, mɛ nɛ gu náá, é sok mɛ aazyɛ pɛ yebɔ ɛ, mɛ aazyɛ ɛ́ tɔɔɔ nɛ esɛɛa mɛtel ɛ Klisto.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Tin, bɔn-nyɛɛg, gwakeka sa mɛ di ekwyɛl ɛwaab nɛ nen kɔ ɛsu ɛ Ghɛŋ'enaka Yezu Klisto, kɔ ɛsu ɛ kwyɛl Sisim na Dɛɛ di edjɛ ɛ. Duuka sama nɛ nam tɔ ɛdjaala Zɛɛb kɔ ɛsu ɛ lam. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Djaalaka Zɛɛb, étɛp nyɛ neebaal mɛ sok bhwoob bot ɛ kyee dik Yude, bot ɛ di ààdum koŋ nɛ Klisto ɔ. Tin, djaalaka etɛɛ náá, mɛkɛɛ mɛ mɛ aazyɛ nɛ yɛ pɛ ghaada Yeluzalɛm ɛ neemyaalaa nɛ lyem wat nɛ bot ɛ di edum koŋ nɛ Yezu ɔ. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Deenek, yɛ waasa náá, mɛ kum pɛ yebɔ nɛ mɛmyaala djas, Zɛɛb ɛ kwyɛl ɔɔ, mɛ waadi ba mɔɔ ɛwala pɛ daa len. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Beta náá, Zɛɛb mot di ɛsuk ɛ egwyem ɔ, di sama nɛ biyɔ djas. <char style="sc">Amɛn</char>.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s1">Mɛswosel</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Mɛ eedhis bin kɛl'ena Febe, mot-mɛsa ɛ Zɛɛb tɔ zɛɛga mendjaala mɛ ghaada Sɛɛkele<note caller="*" style="x"><char style="xo" closed="false">16.1 </char><char style="xt" closed="false"><ref loc="ACT 18:18">Mɛs 18.18</ref></char></note>. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />É sok nyɛ aakum penek ɛ, beka nyɛ ɛnyɔɛpe nɛ din ɛ Ghɛŋ, tyee bot ɛ zedum koŋ nɛ Zɛɛb ɔ di egoka nɛ ɛsa ɛ. Kwyeeka nyɛ tɔ etɛp djas ee nyɛ aadi nɛ gwyes mɛkwyeea ɛ, etɛɛ náá, nyɛ naakwyee mbula bot dɔɔ nɛ mam pe.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Swoska Pilisil nɛ ngom Akilas, bot ɛ bis nɛ bɛnɔɔ di esa mɛsa mɛ Yezu Klisto sama ɔ<note caller="*" style="x"><char style="xo" closed="false">16.3 </char><char style="xt" closed="false"><ref loc="ACT 18:2">Mɛs 18.2</ref></char></note>. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />Bɛ naaka bet étɛp ɛtsik ɛ mɛ. Mɛ eedyeebaghaapɛɛ bɛ, ye tok mam nɛ mam, yɛ ɛ́ dɔɔ nɛ bot ɛ ezɛɛga mendjaala djas di ààbɛ bot ɛ mbyak eYuda ɔ eebaaghaapɛɛ bɛ. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Swoska dɔɔ nɛ bot ɛ zɛɛga mendjaala di esɛɛga pɛ yɔbɔ ɛ. Swoska mɔn-nyaagam Efayinɛt mɛ di ekwyɛl ɔ, nyɛ nadi ɛ́ mot mɛkɛn nakan ɛdum ɛ koŋ nɛ Yezu Klisto pɛ tɔ kyee dik Azi ɔ. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Swoska Maali, mot nadyeebawa lyem tɔ mɛsa étɛp'en ɔ. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Swoska pe Andolonikus bɛ nɛ Zunyas bot ɛ mɛbyel mam, bot ɛ bis nɛ bɛnɔɔ nadi tɔ membok ɔ. Bɔɔ djas bɛbá ɛ́ bot ɛ lwoma ee bot di edjɛ duu ɛbuɛpe ɔ. Yɛ ɛ́ bɔɔ ɛ naleedum koŋ nɛ Yezu Klisto ɛsok nɛ nam.<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />Swoska Apilyatus mɔn-nyaagam mɛ di ekwyɛl tɔ ɛsa mɛsa mɛ Ghɛŋ ɔ. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Swoska Ulbɛ, mot bis nɛ bɛnɔɔ di esa mɛsa mɛ Yezu Klisto sama ɔ, dɔɔ nɛ Sitasis mɔn-nyaagam mɛ di ekwyɛl ɔ. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Swoska Apɛlɛs, mot nalyaal bot popoopwon náá, nyɛ eezedum koŋ'ɛ nɛ Klisto ɔ. Swoska bot ɛ mɛbyel mɛ ndjaŋ ɛ Alistobul. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Swoska Eelodiyɔn, mot mɛbyel mam. Baaswoska dɔɔ nɛ bot ɛ ndjaŋ ɛ Naasis di edum koŋ nɛ Ghɛŋ ɔ. <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />Swoska Tiilifɛn bɛ nɛ Tiilifɔɔz, boa di esa mɛsa mɛ Ghɛŋ ɔ, baaswoska Pɛɛsid kɛl'am mɛ di ekwyɛl ɛbuɛpe ɔ, nyɛ naadyeebawa lyem ɛlyelɛpe tɔ mɛsa mɛ Ghɛŋ. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Swoska Lufus<note caller="*" style="x"><char style="xo" closed="false">16.13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">Mak 15.21</ref></char></note>, mot-mɛsa ɛ Ghɛŋ nasɛ́ɛ ɔ. Baaswoska dɔɔ nɛ nyɛɛg, mot mɛ di ebee nyɛ dáa nyaagam ɔ. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Swoska pe Asɛɛkilit, nɛ Felegɔn, nɛ Ɛɛlmɛs, nɛ Patolobas, nɛ Ɛɛlmas, zɛnɔɔ bɔn-nyɛɛg bɔɔ djas bot ɛ zedum koŋ nɛ Zɛɛb di sama nɛ nɔɔ ɔ. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Baaswoska dɔɔ nɛ Filolɔɔg bɛ nɛ Zuli, nɛ Nɛɛlɛ bɛ nɛ kɛl, swoska Olɛɛpas, zɛnɔɔ bot djas zedum koŋ nɛ Zɛɛb di sama nɛ nɔɔ ɔ. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />Swoselka pak'en nɛ mɛbeedela dáa bɔn-nyɛɛg tɔ ɛdum ɛ koŋ nɛ Zɛɛb di esa ɛ. Bot ɛ ezɛɛga mendjaala ɛ Klisto djas eeswos bin.<verse eid="ROM 16:16" /></para>
  <para style="s1">Ɛdulaa mɛlɔ yii mɛsik</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Mɛ ɛpedjaala nɛ nen bɔn-nyɛɛg, bi ɛ́ kobaka nɛ bot djas di ewa mbɛk nɛ ɛzɛm tɔ sama bot ɛ zedum koŋ nɛ Zɛɛb ɔ, bot ɛ di esaa náá, bi liig Zɛɛb koŋ nɛ ɛbyen ɛ́ mɛdjek mɛ bi nadjek ɛ. Dika ɛtsetaɛpe nɛ nɔɔ, <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />etɛɛ náá, mbi binɔk bot ààsa mɛsa mɛ Klisto Ghɛŋ'enaka. Tin, bɛ sa mɛsa ɛ́ étɛp emɔ bɔɔ met! Mbɛɛ mɛkpa mɔɔ, nɛ elɛŋ e mɛkɔŋ mɔɔ, yɛ ɛ́ étɛp ɛkɔɔ bot ɛ di ààtselal ɔ. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Bot djas nɛ gu ɛlooba ɛ len nɛ Ghɛŋ. Mɛ nɛ myaala étɛp'en, tin, mɛ ɛpekwyɛl náá bi di bɛtsoŋ ɛ bot étɛp ɛsa enɛm esa, esa e dɛɛ, ààbɛ esa e ɛbiyo. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Zɛɛb, mot di ɛsuk ɛ egwyem ɔ, nyɛ moo aanyal Satan si mɛko men.</para>
  <para style="p" vid="ROM 16:20">Beta náá, enɛm nɛ embɛɛ Ghɛŋ'enaka Yezu di nɛ nen!<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Timote mot bis nɛ nɛ di esa mɛsa ɔ eeswos bin, dɔɔ nɛ Lusyus, nɛ Zasɔn zɛnɔɔ Sosipatɛɛd bot ɛ mɛbyel mam.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Yɛ ɛ́ mam, Tɛɛtyus ɛ di ekwyal bin mɛkana mak, mɛ eeswos bin nɛ din ɛ Ghɛŋ, mot di esa náá, mena dika tɔ ɛgwakel ɔ.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Ghayus, mot mɛ sulal pɛ daa lɛ ɔ eeswos bin. Yɛ ɛ́ pɛ daa lɛ ɛ bot djas di esɛɛga é mendjaala. Eelast mot di enɔɔ epata tɔ ghaada bɛ nɛ mɔn-nyɛɛg'ena Kaltus ɔ eeswos bin<note caller="*" style="x"><char style="xo" closed="false">16.23 </char><char style="xt" closed="false"><ref loc="ACT 19:29">Mɛs 19.29</ref>; <ref loc="COL 1:14">Kol 1.14</ref>; <ref loc="2TI 4:20">2Tm 4.20</ref></char></note>.</para>
  <para style="p" vid="ROM 16:23">[<verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />Beta náá, enɛm nɛ embɛɛ e Ghɛŋ'enaka Yezu Klisto di nɛ biyɔ djas. <char style="sc">Amɛn</char>.]<verse eid="ROM 16:24" /></para>
  <para style="s1">Pɔl ɛpeduwal Zɛɛb</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Djhoobulalka bhɔɔ nɛ Zɛɛb, mot di nɛ ghwyil ɛdjɛ bin mɛghaaz, étɛp bi needi ghiŋ tɔ ɛdum ɛ koŋ ɛ len, dáa mɛ di egoola bin tɔ Mbɛɛ Bhaadal kɔ ɛsu ɛ Yezu Klisto ɛ. É ghɛŋ sok, Zɛɛb nabɛ ɛ́ ààtel bot ɛkwosak ɛ lɛ, nyɛ naasyel yɛ. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Nenak yak, nyɛ eetel yɛ popoopwon tɔ bɛmɛkana mɛ bɛngoolel ɛ mɛkpa dáa Zɛɛb na kɔm-kɔm nalɛɛ ɛ. Tin, bot ɛ membyak djas eegwak mɛkpa menek, étɛp bɛ needum koŋ nɛ nɛ, nɛ ɛlooba nɛ nɛ.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />Djhoodjɛka duu nɛ Zɛɛb nɛ din ɛ Yezu Klisto, nyɛy mot di kɔm-kɔm sii nɛ kɔm ɔ, <char style="sc">Amɛn</char>!<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>