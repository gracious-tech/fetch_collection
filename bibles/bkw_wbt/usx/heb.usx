<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">BIBLE</book>
  <para style="h">Ebele</para>
  <para style="toc3">Ebe</para>
  <para style="toc2">Ebele</para>
  <para style="toc1">Mɛkana mɛ Bot ɛ Ebele</para>
  <para style="mt2">Mɛkana mɛ Bot ɛ</para>
  <para style="mt1">Ebele</para>
  <para style="imt">Ɛniel</para>
  <para style="ip">Yak ɛ́ mɛkana mɛ nakwyalaa étɛp eYuda nadi edu Klisto ɔ. Mot nakwyal yɛ ɔ, nyɛ ààguaa, sa di tsɛɛtsɛ tɔ tak ɛ́ náá, mot nakwyal yɛ ɔ nɛ gu Ekwyala ɛnyɔɛpe, etɛɛ náá, yɛ ɛ́ dum nɛ Ekwyala binek ɛ nyɛ di elyaal etsɛɛtsɛ etɛp ee nyɛ di ekaada tɔ mɛkana mak ɛ.</para>
  <para style="ip">Ekeletyɛ mɛkɛn naadyeebatiigaa, mɛtiiga mɛ tak nadi epus náá, bɛ kɛsɔsɔwa. Étɛp tak ɛ, bɛ nakwyal mɛkana mak, étɛp bɛ neepyet, ààbula bhis.</para>
  <para style="ip">É ghɛŋ bɛbhaab, Zɛɛb naagwakel bɛ nɛ bot ɛ mbyak eYuda. Nyɛ naalɛɛ nɛ nɔɔ náá, mot ɛ syem ɔɔ, bɛ go tit étɛp buwa, deenek ɛ, Zɛɛb aapel mesyem mɛ. Tin, mɛkana mak lɛɛ ɛ́ náá, ɛbhɛŋ ɛ na bes Zɛɛb sa nɛ bot ɛ di edum koŋ nɛ mɔn'ɛ ɔ, yɛ ɛ́ Yezu ɛ́ di mɔɔ bhata ɛ Zɛɛb nakaaa buwa, kɔ ɛsu ɛ mesyem mɛ bot djas ɛ. Bot djas di edum koŋ nɛ nɛ ɔ, bɛ tokapɛ nɛ gwyes ɛbaaka buwa bɛtit étɛp mesyem mɔɔ. Deenek, ɛbhɛŋ ɛ na bes eedhaa yii na mwa. Etɛɛ náá, sa Yezu Klisto nasa nɛ bot ɛ, yɛ eedhaa yii efofop, yɛ ɛ́ Moiiz, nɛ Aalɔn zɛnɔɔ yɛ Zozue nasa ɛ.</para>
  <para style="ip">Mɛtsek mɛ mɛkana mak ɛ́ dáak:</para>
  <para style="io1">Mɔn ɛ Zɛɛb ɛ́ boo kuma mot (<char style="xt"><ref loc="HEB 1:1-3">1.1-3</ref></char>);</para>
  <para style="io1">Yezu eedhaa efofop (<char style="xt"><ref loc="HEB 1:4-2:18">1.4–2.18</ref></char>);</para>
  <para style="io1">Yezu eedhaa Moiiz nɛ Zozue (<char style="xt"><ref loc="HEB 3:1-4:13">3.1–4.13</ref></char>);</para>
  <para style="io1">Yezu ɛ́ boo ghaa-Zɛɛb (<char style="xt"><ref loc="HEB 4:14-7:28">4.14–7.28</ref></char>);</para>
  <para style="io1">Yezu zyɛ ɛ́ nɛ ɛbhɛŋ ɛ di edhaa yii na mwa ɛ (<char style="xt"><ref loc="HEB 8:1-9:22">8.1–9.22</ref></char>);</para>
  <para style="io1">buwa Yezu ɛ́ ngɔt, yɛ ɛ́ buwa mɛsik (<char style="xt"><ref loc="HEB 9:23-10:31">9.23–10.31</ref></char>);</para>
  <para style="io1">bɛdhiiti eboo bot ɛ nadi edum koŋ nɛ Zɛɛb sok ɔ (<char style="xt"><ref loc="HEB 11:1-40">11.1-40</ref></char>);</para>
  <para style="io1">djhoobaŋaka Yezu (<char style="xt"><ref loc="HEB 12:1-13:19">12.1–13.19</ref></char>);</para>
  <para style="io1">mɛkpa mɛ mɛsik nɛ mɛswosel (<char style="xt"><ref loc="HEB 13:20-25">13.20-25</ref></char>).</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Zɛɛb nalii ɛ́ tɔ nuub Mɔn'ɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />É ghɛŋ na mwa, Zɛɛb naalii nɛ bɛbhaab'enaka esok nɛ esok. Nyɛ naalii nɛ nɔɔ nɛ membi mɛ mɛzel djas tɔ enuub bɛngoolel ɛ Mɛkpa ɛ Zɛɛb, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />tin, é mɛlu mɛ mɛsik mena dika mos'aak, nyɛ kalii nɛ nena ɛ́ tɔ nuub Mɔn'ɛ. Yɛ ɛ́ nyɛy ɛ di mot aalik nɛ esa djas ɔ, dum nɛ nɛ ɛ́ Zɛɛb nakus gwoo nɛ bɔs<note caller="*" style="x"><char style="xo" closed="false">1.2 </char><char style="xt" closed="false"><ref loc="JHN 1:3">Zaŋ 1.3</ref> </char></note>. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Yɛ ɛ́ Mɔn tak ɛ di mɛkas mɛ duma ɛ Zɛɛb. Yɛ ɛ́ nyɛy ɛ di elyaal dáa Zɛɛb di ɛ. Nyɛ ɛ́ di epyet esonok djas nɛ ghwyil mɛkpa mɛ nuub'ɛ. Bhii nyɛ nasilal ɛdis ɛ bot edhuud e mesyem mɔɔ ɛ, nyɛ naazɛnɔɔ nyel disi pɛ tɔ gwoo, pɛ mbɔ eghɛŋ ɛ Zɛɛb na-ghaa mɛbwala<note caller="*" style="x"><char style="xo" closed="false">1.3 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Mɛd 110.1</ref> </char></note>. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Zɛɛb naasa náá, Mɔn'ɛ di kɔ elo e efofop. Etɛɛ náá, nyɛ naadjɛ nyɛ boo din ɛ mɛbwala dhaa yii efofop.<verse eid="HEB 1:4" /></para>
  <para style="s">Mɔn ɛ Zɛɛb ɛ́ kɔ elo e efofop</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Yɛ ɛ́ tsɛɛtsɛ náá, Zɛɛb dinaa ààpake nɛ dhiiti fofop'ɛ ngɔt náá:</para>
  <para style="q1" vid="HEB 1:5">«Yɛ ɛ́ wɔy ɛ di Mɔn'am, kana dwoo pan mos'ak,</para>
  <para style="q1" vid="HEB 1:5">mɛ ɛ́ Soog<note caller="*" style="x"><char style="xo" closed="false">1.5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Mɛd 2.7</ref></char></note>.»</para>
  <para style="m" vid="HEB 1:5">Tin, nyɛ ààpakoke-keak nɛ dhiiti fofop náá:</para>
  <para style="q1" vid="HEB 1:5">«Mɛ waaboodi nɛ nɛ ɛ Sɛɛg,</para>
  <para style="q1" vid="HEB 1:5">nyɛ aadi nɛ nam ɛ́ Mɔn<note caller="*" style="x"><char style="xo" closed="false">1.5 </char><char style="xt" closed="false"><ref loc="2SA 7:14">Sm2 7.14</ref></char></note>.»<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Tin, é sok Zɛɛb nadhis Mɔn mɛgwyak mɛ kɔ bɔs ɛ, nyɛ nabɛ ɛ́, nyɛ naake náá:</para>
  <para style="q1" vid="HEB 1:6">«Efofop ɛ Zɛɛb djas goka ɛ́ nɛ ɛduwal ɛ́ nyɛ<note caller="*" style="x"><char style="xo" closed="false">1.6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Dɛt 32.43</ref> </char></note>!»<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Dum nɛ efofop, ye nabɛ ɛ́ Zɛɛb naake náá:</para>
  <para style="q1" vid="HEB 1:7">«Zɛɛb eesa náá, efofop bɛ di tyee epup.</para>
  <para style="q1" vid="HEB 1:7">Tin, nyɛ naasa náá, bot ɛ mɛsa mɛ di tyee ngel du<note caller="*" style="x"><char style="xo" closed="false">1.7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">Mɛd 104.4</ref></char></note>.»<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Tin, dum nɛ Mɔn, nyɛ naake náá:</para>
  <para style="q1" vid="HEB 1:8">«Zɛɛb, bóó mɛkoozi mɔ ɛ́ kɔm-kɔm sii nɛ kɔm.</para>
  <para style="q1" vid="HEB 1:8">Deenek, yɛ ɛ́ é ɛkɛ tɔ epiki ɛ wɔ di edjɛɛd ɛyoŋ ɛ lɔ.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Wɔ kwyɛl ɛ́ epiki, da wɔ ɛ́ bhina ɛbiyo,</para>
  <para style="q1" vid="HEB 1:9">dum nɛ tɛp tak ɛ, Zɛɛb Sɛɛg, Zɛɛb'ɔ natɔ wɔ étɛp wɔ di mot-mɛsa mɛ.</para>
  <para style="q1" vid="HEB 1:9">Nyɛ naso wɔ mul mɛ ebotan kɔ lo ɛ́ étɛp tak,</para>
  <para style="q1" vid="HEB 1:9">tɔ sama bɔn-nyoog djas, yɛ ɛ́ wɔy ɛ nyɛ nasɛ́ɛ<note caller="*" style="x"><char style="xo" closed="false">1.9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-8">Mɛd 45.6-8</ref></char></note>.»<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Zɛɛb naabaake náá:</para>
  <para style="q1" vid="HEB 1:10">«É mɛken tɔɔɔ, yɛ ɛ́ wɔy Ghɛŋ ɛ nakus bɔs,</para>
  <para style="q1" vid="HEB 1:10">dɔɔ nɛ wɔy ɛ́ nasa gwoo nɛ mɛmbɔ mɔ met.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Esonok binek djas aadi ɛ́ nɛ ɛsik,</para>
  <para style="q1" vid="HEB 1:11">yɛ ɛ́ kabɛ wɔy ɔ, wɔy aadi ɛ́ kɔm-kɔm.</para>
  <para style="q1" vid="HEB 1:11">Gwoo nɛ bɔs ɛ́ waapulel dáa ekaad.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Wɔ waabwaada bɛ dáa bɛ di ebwaada kaad ɛ,</para>
  <para style="q1" vid="HEB 1:12">deenek, wɔ waakaswoola bɛ ɛ́ dáa bot di eswoola ekaad é nyel ɛ.</para>
  <para style="q1" vid="HEB 1:12">Yɛ kabɛ wɔy ɔɔ, wɔy ààswoola, tsik'ɔ tok nɛ ɛsik<note caller="*" style="x"><char style="xo" closed="false">1.12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">Mɛd 102.25-27</ref></char></note>.»<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Zɛɛb nabɛ ɛ́ ààke nɛ dhiiti fofop'ɛ ngɔt náá:</para>
  <para style="q1" vid="HEB 1:13">«Da disi pɛ kyee mbɔ eghɛŋ bam,</para>
  <para style="q1" vid="HEB 1:13">kɛkum dwoo mɛ aasa náá, bot ɛ mɛbhuka mɔ di dáa poba wɔ di ekɛl mɛbɔ mɔ kɔ tak ɛ<note caller="*" style="x"><char style="xo" closed="false">1.13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Mɛd 110.1</ref></char></note>.»<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Efofop ɛ́ bɛzɛ? Bɛ tok esisim di esa mɛsa mɛ Zɛɛb ɔ? Zɛɛb lwom bɛ ɛ́, étɛp bɛ neegheekwyee-kwyee bot aabela tsik na kɔm-kɔm ɔ.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Tsik na boo mɛtaŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Yɛ ɛ́ etɛp tak ɛ di náá, ye goka ɛ́ mena pyetka ɛlyelɛpe tɔ mɛlyo mɛ mena nagwakeka ɛ, ekaab náá, mena ɛzɛkɛwo ze. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Deenek, bhaadal efofop nalɛɛ ɛ, moo mos ɛ́ nɛ mɛtaŋ, bot ɛ nasa maa-ɛlɔ ɔ, nɛ bot ɛ nadi ààlooba nɛ mɛkpa mɛ tak ɔ, naazebela feŋ bɛ di egoka nɛ yɛ ɛ. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Tin, menabɛlka bɛmet, mena aapɛkelka dáa tɔ yak feŋ, yɛ bɛ náá, mena ààbiska boo yak tsik na mɛtaŋ ɔɔ? Etɛɛ náá, Ghɛŋ nyɛ ɛmet nabɛ ɛ́ mot mɛkɛn ɛgoola tsik tak. Bot ɛ nagwak bhaadal tak ɔ, bɛ naabaŋa bis etsɛɛtsɛ e tak. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Zɛɛb nadi elyaal etsɛɛtsɛ e bhaadal tak nɛ bɛtɛ nɛ etseŋa, nɛ endem e mɛbwala, nɛ mɛvyɛkɛlɛ zɛnɔɔ mɛkɛɛ mɛ Sisim na Dɛɛ di edjɛ mot nɛ mot tɔ ɛkwosak ɛ Zɛɛb ɛ.<verse eid="HEB 2:4" /></para>
  <para style="s">Yezu ɛ́ di edjɛɛd bot é ze tsik</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Etɛɛ náá, Zɛɛb nabɛ ɛ́ ààdjɛ ghwyil nɛ efofop náá, bɛ di bot aakɔk kɔ bhwak di ezyɛ yenek, yii mena di elii kɔ ɛsu ɛ tak'aak. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Deenek, ye nabɛ ɛ́ dhiiti mot nakaada náá:</para>
  <para style="q1" vid="HEB 2:6">«Zɛɛb, mot ɛ́ yɛ zɛ, étɛp esiiza bɔ needi kɔ lɛ?</para>
  <para style="q1" vid="HEB 2:6">Mɔn ɛ mot ɛ́ yɛ zɛ, étɛp wɔ neekwyɛɛg nyɛ?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Wɔ naasa náá, mot di si efofop ba ɛwala batsa.</para>
  <para style="q1" vid="HEB 2:7">Tin, wɔ naadjɛ nyɛ duma nɛ duu<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />wɔ naadjɛ nyɛ ghwyil ɛkɔk kɔ esa ee di kɔ ɛko ɛ bɔs djas ɛ<note caller="*" style="x"><char style="xo" closed="false">2.8 </char><char style="xt" closed="false"><ref loc="PSA 8:5-7">Mɛd 8.5-7</ref>; <ref loc="1KI 15:27">Bm1 15.27</ref>; <ref loc="EPH 1:22">Efɛ 1.22</ref>; <ref loc="PHP 3:21">Fil 3.21</ref></char></note>.»</para>
  <para style="m" vid="HEB 2:8">Yɛ bɛ náá, Zɛɛb naasa náá, mot di ekɔk kɔ esa ee di kɔ ɛko ɛ bɔs djas ɔɔ, ye kwyɛl ɛlɛɛ náá, ye tok nɛ sa wat Zɛɛb nasa náá, ye nàlooba nɛ nɛ. Deenek, é di mena dik'aak, mena dinaa ààpabee dáa esonok djas di elooba nɛ mot ɛ. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Nenak yak, Yezu mot nasilaa é ba mɔɔ ɛwala batsa si efofop ɔ, mena beeka nyɛ mos ɛ́ nɛ boo duu nɛ duma, kɔ ɛsu ɛ mezuk mɛ ɛsyee nyɛ nagwyɛ ɛ. Tin, tɔ enɛm nɛ embɛɛ Zɛɛb, nyɛ naadhaa é ze ɛsyee étɛp bot djas. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Etɛɛ náá, Zɛɛb ɛ́ mot nakus esonok djas di kɔ ɛko ɛ bɔs ɔ, djas ɛ́ yɛ. Nyɛ kwyɛl ɛ́ nyɛ needul bɛtɛ nɛ bɔn, bɛ neebela di tɔ duma yɛ. Étɛp tak, ye nagoka ɛ́ náá, nyɛ kwyɛɛg Yezu tɔ mezuk kɛkum pɛ mɛsik, etɛɛ náá, nyɛ needi mot di egoka nɛ ɛdjɛɛd bot pɛ ze tsik ɔ.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />Deenek, Yezu mot di esa náá, bot di dɛɛ ɔ, nɛ bot ɛ moo bot ɛ edɛɛ ɔ, bɔɔ djas ɛ́ bɔn ɛ Sɛɛg ngɔt. Étɛp tak ɛ Yezu di ààdi nɛ sen ɛdjóo bɛ bɔn-nyɛɛg bɛ. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Nyɛ ke ɛ́ náá:</para>
  <para style="q1" vid="HEB 2:12">«Zɛɛb, mɛ ɛpekwyɛl ɛgoola din ɛ lɔ,</para>
  <para style="q1" vid="HEB 2:12">nɛ bɔn-nyɛɛg bam,</para>
  <para style="q1" vid="HEB 2:12">tɔ ɛdhuu ɛ bot ɛ zɛɛga mendjaala,</para>
  <para style="q1" vid="HEB 2:12">mɛ ɛpekwyɛl ɛdjeeb kɔ ɛsu ɛ lɔ<note caller="*" style="x"><char style="xo" closed="false">2.12 </char><char style="xt" closed="false"><ref loc="PSA 22:23">Mɛd 22.23</ref></char></note>.»<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Yezu eebaazɛke náá:</para>
  <para style="q1" vid="HEB 2:13">«Mɛ waawa ɛbwaalel ɛ lam nɛ Zɛɛb.»</para>
  <para style="m" vid="HEB 2:13">Nyɛ eebaazɛbil náá:</para>
  <para style="q1" vid="HEB 2:13">«Beea mɛ, mɛ ɛ́ bis nɛ bɔn ɛ Zɛɛb nadjɛ mɛ ɔ<note caller="*" style="x"><char style="xo" closed="false">2.13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">Eza 8.17-18</ref></char></note>.»<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Deenek, dáa ye di náá, bɔn tak nabyel ɛ, byela epuud nɛ ghiya ɛ, Yezu nyɛy pe nadi ɛ́ nyɛ moo dáa bɔɔ. Étɛp tak ɛ di náá, kɔ ɛsu ɛ ɛsyee ɛ lɛ, nyɛ naakwak dim mot mɛkɔŋ, mot nadi nɛ eghɛŋ kɔ esyee ɔ. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />É di'enek, nyɛ naazɛpɛk bot tɔ bwoo ɛsyee nazemɛt bɛ, dáa ekwom membu nɛ mesee ɛ. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Etɛɛ náá, yɛ ɛ́ tsɛɛtsɛ, nyɛ nabɛ ɛ́ ààzyɛ étɛp ɛzɛkwyee efofop. Nyɛ nazyɛ ɛ́ étɛp ɛkwyee bot ɛ mɛbyel ɛ Abalaam<note caller="*" style="x"><char style="xo" closed="false">2.16 </char><char style="xt" closed="false"><ref loc="ISA 41:8-9">Eza 41.8-9</ref> </char></note>. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Étɛp tak ɛ Zɛɛb nasa náá, nyɛ di tyee wat nɛ bɔn-nyɛɛg, étɛp nyɛ needi boo ghaa-Zɛɛb'ɔɔ na mbɛɛ lyem nɛ esosoob tɔ mɛsa mɛ Zɛɛb, étɛp Zɛɛb neepel mesyem mɛ bot ɛ bɔs djas. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />É di'enek, dáa ye di náá, nyɛ nawaaa tɔ mɛbhowal ɛ, nyɛy nyɛ ɛmet naabee mezuk, nyɛ ɛ́ nɛ ghwyil kakwyee bot ɛ di tɔ mɛbhowal ɔ.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Duu ɛ Yezu eedhaa yii Moiiz</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Bɔn-nyɛɛg bam, biyɔ bot ɛ na dɛɛ, biyɔ bot ɛ Zɛɛb nadjóo ɔ, waka lyem nɛ Yezu. Tin guka náá, Yezu ɛ́ mot-lwoma ɛ Zɛɛb, nyɛ ɛ́ boo ghaa-Zɛɛb ɛdum ɛ koŋ mena di egoolaka ɛ. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Nyɛ nadi ɛ́ sosoob é mis ɛ Zɛɛb, mot natɔ nyɛ étɛp ɛsa mɛsa menek ɔ, dáa Moiiz nadi sosoob kɔ ndjaa-Zɛɛb djas<note caller="*" style="x"><char style="xo" closed="false">3.2 </char><char style="xt" closed="false"><ref loc="NUM 12:7">Ɛla 12.7</ref></char></note> ɛ. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Tin, Yezu goka ɛ́ nɛ djɛaa duma dhaa duma di edjɛaa nɛ Moiiz ɛ. Etɛɛ náá, mot di esum ndjaŋ ɔ, nyɛ ɛ́ nɛ duu dhaa ndjaa tak. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Mendjaa djas sumaa ɛ́ nɛ mot, ghuna, Zɛɛb ɛ́ di mot di esum esonok djas ɔ. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Yɛ kabɛ Moiiz ɔɔ, nyɛ nabɛ ɛ́ sosoob tɔ ndjaa-Zɛɛb djas. Nyɛ nabɛ ɛ́ mot-mɛsa di egoola etɛp e Zɛɛb nadi elɛɛ ɛ. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Tin, Klisto ɛ́ sosoob dáa Mɔn di náá, Sɛɛg naadjɛ nyɛ ekukuma ɛdjɛɛd ndjaŋ'ɛ ɔ. Bela náá, ndjaŋ'ɛ tak ɛ́ menabɛlka, yɛ bɛ náá, mena ɛpebaalka ɛdum ɛ koŋ nɛ Zɛɛb nɛ ɛbwaalel mena dika nɛ mɛmyaala kɔ ɛsu ɛ tak ɔɔ.<verse eid="HEB 3:6" /></para>
  <para style="s">Zɛɛb ɛpedjɛ ɛwala nɛ bot ɛ di elooba nɛ nɛ ɔ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Yɛ ɛ́ etɛp tak ɛ Sisim na Dɛɛ di elɛɛ náá:</para>
  <para style="q1" vid="HEB 3:7">«Mos, bi ɛ gwak gwood ɛ Zɛɛb ɔɔ,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />sa bi ààlyel elyem, dáa bi nasa é ghɛŋ bi nakus ɛghuub nɛ nɛ</para>
  <para style="q1" vid="HEB 3:8">dwoo bi nawa nyɛ tɔ mɛbhowal pɛ kyee bɔs bɛsyɛ di ààbɛ nɛ mɛdii ɛ.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Zɛɛb ke ɛ́ náá, penek, ye nabɛ ɛ́, bɛbhaab bin naawa mɛ tɔ mɛbhowal,</para>
  <para style="q1" vid="HEB 3:9">ye nakoozodi bhii bɛ nazebee esa djas mɛ nasa <verse eid="HEB 3:9" /><verse number="10" style="v" sid="HEB 3:10" />tɔ membu mɛkam-mɛná ɛ.</para>
  <para style="q1" vid="HEB 3:10">Yɛ ɛ́ dum nɛ tɛp tak ɛ mɛ nabiyo nɛ bot binɔk,</para>
  <para style="q2" vid="HEB 3:10">bhii tak, mɛ eezɛke náá: “Mɛlu djas elyem bɔɔ ɛ́ tɔ ɛdjak,</para>
  <para style="q1" vid="HEB 3:10">bɛ dinaa ààpatiibal sa mɛ di egwaal nɛ nɔɔ ɛ.”<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Myoŋ nɛ mɛsoŋ mɛ mɛ natuwal tɔ ɛbuk ɛ lam ɛ́ náá, bɛ aanàbooni tɔ sum dik mɛ nazekoobal bɛ étɛp ɛkɛwala ɛ<note caller="*" style="x"><char style="xo" closed="false">3.11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">Mɛd 95.7-11</ref></char></note>!»<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Bɔn-nyɛɛg, dika ndjem. Sa dhiiti mot pak'en ààdi nɛ mbee lyem di esa náá, nyɛ nàdum koŋ nɛ Zɛɛb ɛ, sa nyɛ ààlum Zɛɛb mot di nɛ tsik ɔ koŋ. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Djɛelka mɛghaaz pak'en mɛlu djas, dáa Ekwyala di elɛɛ náá, «dwoo lak mos», ekaab náá, mot ngɔt pak'en ɛ́ zɛkɛbyen ɛgwak, da nyɛ ɛ́ sik tɔ mesyem. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Tin, menaka ɛ́ bot ɛ di egyee sama nɛ Klisto ɔ, yɛ bɛ náá, mena ɛpebaalka ɛbwaalel ɛ mena dika nɛ yɛ nɛ Klisto, dáa bot nakɛkan ààwak é ze ɔɔ. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="HEB 3:15">«Mos, bi ɛ gwak gwood ɛ Zɛɛb ɔɔ, sa bi ààlyel elyem,</para>
  <para style="q1" vid="HEB 3:15">dáa bi nasa é ghɛŋ bi nakus ɛghuub nɛ nɛ ɛ<note caller="*" style="x"><char style="xo" closed="false">3.15 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">Mɛd 95.7-8</ref></char></note>.»<verse eid="HEB 3:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="HEB 3:16" />Ye nabɛ bɛzɛ nagwak gwood ɛ Zɛɛb, da bɛ ɛ́ kus ɛghuub nɛ nɛ? Ye nabɛ ɛ́ bot djas Moiiz nawyisal pɛ kɔ dɛl Eziptɛ ɔ. <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Tin, Zɛɛb nalyaal ɛbuk ɛ lɛ nɛ bɛzɛ edi membu mɛkam-mɛná? Nyɛ nalyaal ɛbuk ɛ lɛ ɛ́ nɛ bot ɛ nasyem ɔ, wɔ gwaa bɛ zɛbela ɛsyee, gwyɛ kɔ kyee bɔs bɛsyɛ di ààbɛ nɛ mɛdii ɛ. <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />É ghɛŋ Zɛɛb natuwal myoŋ nɛ mɛsoŋ mɛ náá: «Bɛ aanàkwaani tɔ sum di mɛ nazekoobal bɛ yɛ ɛ étɛp bɛ neezɛwala ɛ» tin, nyɛ nalii deenek nɛ bɛzɛ? Nyɛ nalii ɛ́ nɛ bot ɛ nakus ɛghuub nɛ nɛ ɔ. <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Deenek, mena naabee nɛ tsɛɛtsɛ náá, bɛ nabɛ ɛ́ ààni tɔ sum dik ɛwala, etɛɛ náá, bɛ naabyen ɛdum ɛ koŋ nɛ Zɛɛb.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Zɛɛb naakɛk mena náá, mena waabelaka di ɛwala nyɛ nazekoobal étɛp'ena ɛ. Mena ɛ́ kobakaka, sa mot pak'enaka ààsu ɛni tɔ di ɛwala ɛlenek. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Etɛɛ náá, mena naagwak Mbɛɛ Bhaadal dáa bot ɛ nadi tɔ kyee dik bɛsyɛ di ààbɛ nɛ mɛdii ɛ. Tin, Mbɛɛ Bhaadal bɛ nagwak ɛ, nabɛ ɛ́ ààsa bɛ sonok, etɛɛ náá, bɛ nabɛ ɛ́ ààwa ɛdum ɛ koŋ ɛ lɔɔ nɛ sa bɛ nagwak ɛ. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Menabɛlka bot ɛ di edum koŋ nɛ Zɛɛb ɔ, mena ɛ́ waanika tɔ ɛwala ɛ Zɛɛb nakɛk náá:</para>
  <para style="q1" vid="HEB 4:3">«Myoŋ nɛ mɛsoŋ mɛ mɛ natuwal tɔ ɛbuk ɛ lam ɛ́ náá,</para>
  <para style="q1" vid="HEB 4:3">bɛ aanàbooni tɔ sum dik mɛ nazekoobal bɛ étɛp ɛkɛwala ɛ<note caller="*" style="x"><char style="xo" closed="false">4.3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Mɛd 95.11</ref> </char></note>.»</para>
  <para style="m" vid="HEB 4:3">Nyɛ nakake deenek ɛ́, nyɛ eezesilal mɛsa mɛ é sok nyɛ nakus bhwak ɛ. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />É di'enek, Ekwyala lɛɛ kɔ ɛsu ɛ ɛlu ɛ etɛn nɛ ebá ɛ́ náá: «Zɛɛb naazɛwala é ɛlu ɛ etɛn nɛ ebá yii mɛsa mɛ djas nyɛ nadi esa ɛ<note caller="*" style="x"><char style="xo" closed="false">4.4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Mɛk 2.2</ref> </char></note>.» <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Zɛɛb nabaake tɔ Ekwyala binek ɛ́ náá: «Bɛ aanàbooni tɔ sum dik mɛ nazekoobal bɛ yɛ, étɛp bɛ neekɛwala ɛ<note caller="*" style="x"><char style="xo" closed="false">4.5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Mɛd 95.11</ref></char></note>.» <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Bot ɛ nanyɛl ɛgwak Mbɛɛ Bhaadal ɔ, bɛ nabɛ ɛ́ ààni tɔ ɛwala ɛ Zɛɛb nakɛk ɛ, etɛɛ náá, bɛ nabɛ ɛ́ ààlooba. É di'enek, bɛdhiiti bot ɛ nɛ ghwyil ɛni yɔbɔ tɔ ɛwala ɛlenek. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Kɔ ɛsu ɛ tak ɛ Zɛɛb nabaadjɛ dhiiti ɛlu, nyɛ djóo ɛlu ɛ tak ɛ́ «mos». Nyɛ naaloozelɛɛ tɔ nuub ɛ Dhavid náá:</para>
  <para style="q1" vid="HEB 4:7">«Bi ɛ gwak gwood ɛ Zɛɛb mos ɔɔ,</para>
  <para style="q1" vid="HEB 4:7">sa bi ààlyel elyem<note caller="*" style="x"><char style="xo" closed="false">4.7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">Mɛd 95.7-8</ref></char></note>.»<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Yɛ ɛ́ pe bɛ náá, Zozue naadjɛɛd bɔn ɛ Yisalaɛl étɛp ɛkɛniigal bɛ tɔ sum dik é ɛwala ɛ Zɛɛb <note caller="*" style="x"><char style="xo" closed="false">4.8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">Dɛt 31.7</ref>; <ref loc="JOS 22:4">Zoz 22.4</ref></char></note>ɔɔ, pe Zɛɛb ààpalii kɔ ɛsu ɛ dhiiti ɛlu. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Ye kwyɛl ɛlɛɛ náá, yɛ ɛ́ pe ɛ́ nɛ dhiiti ɛwala étɛp bɔn ɛ Zɛɛb. Ɛwala tak nɔŋel ɛ́ nɛ ɛwala ɛ ɛlu ɛ etɛn nɛ ebá. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Etɛɛ náá, mot aani tɔ di ɛwala ɛ Zɛɛb nazekoobal ɔ, nyɛ waawala tɔ mɛsa mɛ, dáa Zɛɛb nawala tɔ yɛ mɛsa ɛ. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Djhoosaka mɛghaaz étɛp ɛni tɔ ɛwala tak, etɛɛ náá, mot ngɔt needi ààwo ze, étɛp ɛbaŋa embee mɛsa mɛ bɛbhaab bena, bot ɛ nabyen ɛlooba ɔ.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Mɛkpa mɛ Zɛɛb ɛ́ nɛ tsik, yɛ ɛ́ nɛ ghwyil. Yɛ ɛ́ wol-wol dhaa pɛl. Mɛkpa mɛ Zɛɛb nɛ ni tɔ ɛsuk ɛ elyem, tɔ mɛtii mɛ nyel, kɛkum tɔ mɛsyel mɛ egwyes. Ye nɛ pɛ́ɛ mɛkwosak nɛ esiiza e elyem. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Ye tok nɛ sa di tɔ sɔ é mis ɛ Zɛɛb. Esonok djas nyɛ nasa ɛ́ popoopwon é mis mɛ. Mis mɛ nɛ bee etɛp djas. Yɛ ɛ́ pɛ daa lɛ ɛ mena aabookɛtaŋalka.<verse eid="HEB 4:13" /></para>
  <para style="s">Yezu ɛ́ boo ghaa-Zɛɛb</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Djhoopyetka ghiŋ tɔ ɛdum ɛkoŋ nɛ Zɛɛb mena di egoolaka ɛ! Etɛɛ náá, menaka ɛ́ nɛ boo ghaa-Zɛɛb, mot mɛbwala nakɛkum pɛ daa Zɛɛb ɔ. Yɛ ɛ́ Yezu, Mɔn ɛ Zɛɛb. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Boo ghaa-Zɛɛb yena ɛ́ nɛ mezuk tɔ lyem, é ghɛŋ nyɛ di ebee mena tɔ mezuk kɔ ɛsu ɛ etɛp di edhaa mena ghwyil ɛ. Etɛɛ náá, nyɛ naawaaa tɔ mɛbhowal mɛ etɛp djas dáa menabɛlka. Tin, nyɛ nabɛ ɛ́ ààkosyem. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Djhootiilaka nɛ ɛbwaalel djas é bhaaz bóó ekukuma ɛ Zɛɛb, pɛ kyee di nɛ enɛm nɛ embɛɛ ɛ. Pɛ daa lɛ, mena ɛpebelaka ɛpelak nɛ enɛm nɛ embɛɛ, étɛp náá, nyɛ neekwyee mena é tɛtɛ ɛwala.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Ghaa-Zɛɛb djas sɛ́ɛaa ɛ́ pak bot, mɛsa mɛ ɛ́ ɛsa mɛsa mɛ Zɛɛb étɛp bot. Nyɛ djɛ Zɛɛb ɛ́ esa e ɛgwyena nɛ ɛka ebuwa étɛp mesyem mɔɔ. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Boo ghaa-Zɛɛb ɛ́ nɛ ghwyil ɛdi nɛ lyem ghoŋ nɛ bot ɛ di ààgu sonok ɔ, nɛ bot ɛ zewo ze ɔ. Etɛɛ náá, nyɛy nyɛ ɛmet ɛ́ mot, yɛ ɛ́ nɛ esa ee di edhaa nyɛ ghwyil ɛ. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Dáa ye di náá, yɛ ɛ́ nɛ esa ee di edhaa nyɛ ghwyil ɛ, nyɛ goka ɛ́ nɛ ɛka ebuwa étɛp ɛpelak ɛ mesyem mɛ bot, dɔɔ nɛ ɛpelak ɛ mesyem mɛ met<note caller="*" style="x"><char style="xo" closed="false">5.3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Msa 9.7</ref> </char></note>. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Mot tok nɛ ghwyil dja djem náá, mɛ moo ɛ́ ghaa-Zɛɛb. Yɛ ɛ́ Zɛɛb ɛ di esa náá, mot di ghaa-Zɛɛb, dáa nyɛ nasa nɛ Aalɔn ɛ. <figure style="fig" alt="Grand sacrificateur de Dieu" file="hk00260c.tif" size="col" loc="5.4" copy="Horace Knowles" ref="5.4">Boo ghaa-Zɛɛb</figure><verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Yɛ ɛ́ tyee wat nɛ Klisto, ye tok nyɛy ɛmet nasa náá, nyɛ di boo ghaa-Zɛɛb. Nyɛ nabela di boo ghaa-Zɛɛb ɛ́ nɛ Zɛɛb, mot nake nɛ nɛ náá:</para>
  <para style="q1" vid="HEB 5:5">«Yɛ ɛ́ wɔy ɛ di Mɔn'am,</para>
  <para style="q1" vid="HEB 5:5">kana dwoo pan mos'ak, mɛ ɛ́ Soog<note caller="*" style="x"><char style="xo" closed="false">5.5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Mɛd 2.7</ref></char></note>.»<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Zɛɛb nabaake ɛ́ náá:</para>
  <para style="q1" vid="HEB 5:6">«Wɔ ɛ́ ghaa-Zɛɛb kɔm-kɔm sii nɛ kɔm,</para>
  <para style="q1" vid="HEB 5:6">tyee wat nɛ Mɛlkisedɛk<note caller="*" style="x"><char style="xo" closed="false">5.6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Mɛd 110.4</ref></char></note>.»<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />É sok Yezu nadi kɔ ɛko ɛ bɔs ɛ, nyɛ nadi edjaala, dɔɔ nɛ ɛwaab ɛ ghoŋ pɛ daa Zɛɛb tɔ etsim, nɛ miŋal é mis. Nyɛ nadi edjaala deenek ɛ́ nɛ Zɛɛb, mot nagoka nɛ ɛtsik nyɛ tɔ ɛsyee ɔ. Tin, Zɛɛb naagwak mendjaala mɛ, etɛɛ náá, nyɛ nadi ɛ́ tɔ ɛlooba nɛ etɛp djas. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Ye nakoozodi náá, nyɛ ɛ́ Mɔn ɛ Zɛɛb, nyɛ naadjek ɛlooba nɛ Zɛɛb tɔ mezuk mɛ djas nyɛ naboma nɛ yɛ ɛ. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Zɛɛb naasa náá, nyɛ di mot zedjala ɔ. Tin, bot djas di elooba nɛ Klisto ɔ, bɛ waabela tsik na kɔm-kɔm kɔ ɛsu ɛ lɛ. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Deenek, Zɛɛb eedjɛ nyɛ di boo ghaa-Zɛɛb tyee wat nɛ Mɛlkisedɛk.<verse eid="HEB 5:10" /></para>
  <para style="s">Ɛdi ɛ́ ghiŋ tɔ ɛdum ɛ koŋ nɛ Zɛɛb</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Bis ɛ́ nɛ bɛtɛ nɛ etɛp e ɛlii dum nɛ tɛp'ak. Sa di esa ɛ, yɛ ɛ́ náá, ye nɛ kɔɔla é ɛbɔɔd ɛ tɛp tak ɛnyɔɛpe, etɛɛ náá, bi ààkawa zii é ɛmɛt ɛsuk ɛ etɛp. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Ye moo ɛ́ nɛ bɛtɛ nɛ mɛlu di esiŋa náá, bi di bɛlyoel ɛ. Deenek, bi dinaa nɛ gwyes náá, bɛ baalyo bin ba mɛlyo mɛ mɛkɛn e Mɛkpa ɛ Zɛɛb. Bi dinaa nɛ gwyes ɛdɛ mɛdii mɛ mɛbel, ààbɛ edee e bot ɛ di nɛ mɛdjɛ ɔ. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Mot di náá, edee bɛ ɛ, mɛdii mɛ mɛbel nɛ mɛdii mɛ mɛbel ɔ, yɛ ɛ́ mɔn tɔlɔɔ. Nyɛ tok nɛ ghwyil ɛsuu mɛso é etɛp di náá, yɛ ɛ́ epiki ɛ. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Tin, mɛdjaab mɛ na lyel-lyel ɛ edee bot ɛ di nɛ mɛdjɛ ɔ, yɛ ɛ́ edee eboo bot. Tɔ mɛsa mɔɔ, bɛ eezegu mɛnyɔ nɛ ɛbiyo.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Deenek, mena goka nɛ ɛdu ɛ́ mɛlyo mɛ di egoka nɛ bot ɛ zewyee ɔ, ààkabɛ náá, mena baasikeka pɛ mɛlyo mɛ mɛkɛn dum nɛ Klisto. Sa mena ààbaasikeka tɔ ɛsuk ɛ mɛlyo mɛ mɛkɛn mɛ di elii dum nɛ ɛkat esesɛɛ di edul bot tɔ ɛsyee ɛ, nɛ mɛlyo mɛ ɛdum ɛ koŋ nɛ Zɛɛb, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />mɛlyo étɛp ɛdis edhuud, nɛ ɛkɛl ɛ bot mɛmbɔ, nɛ mɛlyo dum nɛ ɛgom ɛ bot bhis ɛsyee, zɛnɔɔ mɛlyo dum nɛ epɛ́ɛ na kɔm-kɔm. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Zɛɛb ɛ kwyɛl ɔɔ, mena ɛ́ waadjɛka mɛlyo mɛ di egoka nɛ bot ɛ zewyee ɔ.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Djhoonɔɔka geka nɛ bot ɛ nabula pɛ bhis tɔ mbi tsik bɛ nadi nɛ yɛ sok ɛ: Bɛ naabela mɛkas ɛ Zɛɛb, bɛ naabowal ɛkɛɛ nadus tɔ gwoo ɛ, bɛ naabela Sisim na Dɛɛ, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />bɛ naakwyɛl mbɛɛ Mɛkpa ɛ Zɛɛb, bɛ naagu ghwyil mɛbwala mɛ bhwak aazyɛ ɛ, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />bela náá, bɛ naabaabula sik tɔ tsik'ɔɔ na mwa. Bɛ tok nɛ ghwyil ɛbaaswoola tsik'ɔɔ swoola sis, etɛɛ náá, bɛ ɛpebaabem Mɔn ɛ Zɛɛb bema sis é mɛlaaba. Bɛ ɛpedjɛs bɛdhiiti bot ze náá, bɛ lee nyɛ.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Djhoopookonɔɔka geka bɔs: É ghɛŋ bɛbhi di enee ɛ, bɔs nɛ min mɛdii mɛ tak, yɛ ɛ́ di esa náá, embɛɛ eka kwyil, ɛnyɔ nɛ bot ɛ di ebɛ epyeeb ɔ. Deenek, Zɛɛb eesɛɛ mɛtel kɔ bɔs tak. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Tin, bɔs tak ɛwyisal mɛkpak mɛ mɛgɔk, nɛ engwyinini ɔɔ, yɛ ààval dhiiti sonok. Deenek, Zɛɛb aanàbɔya nɛ ɛkal ɛ yɛ, tin, ɛsik ɛ tak aadi ɛdikaa tɔ du.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Bɔn-nyɛɛg bis di ekwyɛl ɔ, yɛ bɛ náá, bis ɛpelii deenek ɔɔ, bis ɛ́ nɛ ɛbwaalel náá, bi ɛ́ tɔ tɛtɛ ze di edjɛ tsik ɛ. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Zɛɛb ɛ́ mot di piki ɔ. Nyɛ aanàdjisa embɛɛ mɛsa mɛ bi di esa ɛ, ààkobɛ-bɛak kwyɛl bi di nɛ yɛ nɛ nɛ ɛ. Bi nalyaal kwyɛl tak ɛ, tɔ embɛɛ mɛsa mɛ bi nadi esesa, nɛ yii bi di esa nenak nɛ bɛdhiiti bot ɛ di edum koŋ nɛ Zɛɛb ɔ. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Tin, bis kwyɛl ɛ́ náá, mot nɛ mot pak'en wa zii kɛkum dwoo mɛsik, etɛɛ náá, ɛbwaalel ɛ len neesael ɛnyɔɛpe. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Sa bi ààdi bɛsikel ɛ bot. Tin, nɔɔka geka bot ɛ di edum koŋ nɛ Zɛɛb nɛ zii djas ɔ, bot ɛ di náá bɛ waaboobela ekɛk e Zɛɛb ɔ.<verse eid="HEB 6:12" /></para>
  <para style="s">Ekɛk e Zɛɛb ààswoola</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />É ghɛŋ Zɛɛb nakɛk Abalaam ɛ, nyɛ naatuwal myoŋ nɛ mɛsoŋ nɛ din ɛ lɛ met. Etɛɛ náá, ye tok nɛ mot di nɛ mɛbwala dhaa nyɛy, étɛp nyɛ neetuwal myoŋ nɛ mɛsoŋ nɛ din ɛ lɛ. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Nyɛ naake náá: «Nɛ tsɛɛtsɛ, mɛ waasɛɛ wɔ mɛtel, mɛ waasa náá, wɔ di nɛ bɛtɛ nɛ bɛdha<note caller="*" style="x"><char style="xo" closed="false">6.14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">Mɛk 22.16-17</ref> </char></note>.»<verse eid="HEB 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 6:15" />Abalaam naabɔya tɔ bhwood, nyɛ naabalabela sa Zɛɛb nakɛk nyɛ ɛ. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />É ghɛŋ bot di etuwal myoŋ nɛ mɛsoŋ ɛ, bɛ sa yɛ ɛ́, nɛ din ɛ mot di eval dhaa bɔɔ ɔ. Deenek, ɛtuwal ɛ myoŋ nɛ mɛsoŋ menek lyaal ɛ́ etsɛɛtsɛ, nɛ ɛbaasa náá, mɛso si. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Ghuna Zɛɛb nakwyɛl ɛ́, ɛlyaal popoopwon nɛ bot ɛ di ebwood ekɛk ɔ náá, mɛkpa mɛ ààswoola, étɛp tak ɛ di náá, nyɛ naatuwal myoŋ nɛ mɛsoŋ kɔ ekɛk binek. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Ekɛk nɛ ɛtuwal myoŋ nɛ mɛsoŋ, yɛ ɛ́ esonok ebá ee bot di ààswoola ɛ. Tɔ ekɛk bɛ, nɛ tɔ ɛtuwal ɛ myoŋ nɛ mɛsoŋ mɛ, Zɛɛb tok nɛ ghwyil ɛkɔɔ<note caller="*" style="x"><char style="xo" closed="false">6.18 </char><char style="xt" closed="false"><ref loc="NUM 23:19">Ɛla 23.19</ref> </char></note>. Deenek, menabɛlka bot ɛ zebet esonok djas étɛp ɛdi ɛ́ sama nɛ Zɛɛb ɔ, yɛ ɛpedjɛ mena mɛghaaz náá, mena dika nɛ boo ɛbwaalel étɛp ɛbela sa nyɛ nakɛk mena ɛ. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Ɛbwaalel ɛ tak ɛ nɛ nena ɛ́, dáa mbwak mɛsuwa<note caller="+" style="f"><char style="fr" closed="false">6.19 </char><char style="fq" closed="false">mbwak mɛsuwa </char><char style="ft" closed="false">ye kwyɛl ɛlyaal ɛ́ náá, dáa mbwak mɛsuwa di esa náá, mɛsuwa nàwo ɛ, ɛbwaalel ɛ bot aanàkwaawo.</char></note> étɛp tsik yenaka. Yɛ ɛ́ sa mɛlyel nɛ tsɛɛtsɛ, yii di edhaa kɛtuula pɛ tɔ boo lɛmbɛ na pip-pip di ekaa mɛdhɛŋ mɛ Ndjaa-ebuwa di tɔ gwoo ɛ, kɛkum Di na Dɛɛ di tɔ tak<note caller="*" style="x"><char style="xo" closed="false">6.19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">Msa 16.2</ref></char></note> ɛ. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Yɛ ɛ́ tin ɛ, Yezu nadi mot mɛkɛn ɛni tɔ tak, ɛsok nɛ nena kɔ ɛsu ɛ lena. Etɛɛ náá, nyɛ moo ɛ́ boo ghaa-Zɛɛb kɔm-kɔm sii nɛ kɔm tyee wat nɛ Mɛlkisedɛk.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Mɛlkisedɛk ɛ́ mɛkoozi, nyɛ ɛ́ pe ɛ́ ghaa-Zɛɛb</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Mɛlkisedɛk yenɔk nabɛ ɛ́ mɛkoozi mɛ kyee dik Salɛm, nyɛ nabaadi ɛ́ ghaa-Zɛɛb, Zɛɛb na vyɛɛg-vyɛɛg. É ghɛŋ, Abalaam nabula kɛlumla dɛɛb nyɛ nakwak bɛmɛkoozi ɛ, Mɛlkisedɛk naatɔ́ kɛboma nɛ nɛ. Bhii tak, nyɛ nasɛɛ Abalaam mɛtel. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Abalaam naadjɛ nyɛ ndyaal wat tɔ endyaal kam esa ee nyɛ nabela ɛ. Guka náá, din ɛ Mɛlkisedɛk kwyɛl ɛlɛɛ ɛ́: «Mɛkoozi mɛ epiki». Baabela náá, Mɛlkisedɛk ɛ́ mɛkoozi mɛ kyee dik Salɛm, ye kwyɛl ɛlɛɛ ɛ́: «Mɛkoozi mɛ egwyem». <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Nyɛ tok nɛ dhaad mɛbyel. Bot ààgu ɛbyel ɛ lɛ nɛ ɛsyee ɛ lɛ. Nyɛ ɛ́ tyee Mɔn ɛ Zɛɛb, nyɛ ɛ́ ghaa-Zɛɛb kɔm-kɔm sii nɛ kɔm.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Beeka, Mɛlkisedɛk nadi ɛ́ boo kuma mot, bhaab'enaka Abalaam naadjɛ nyɛ ndyaal wat tɔ endyaal kam esa ee nyɛ nabela é dɛɛb ɛ. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Etsi ɛ Moiiz lɛɛ kɔ ɛsu ɛ bɛghaa-Zɛɛb, bot ɛ mɛbyel ɛ Levi ɛ́ náá, ye goka ɛ́ bɛ nɔɔ ndyaal wat tɔ endyaal kam e esa e bot ɛ mbyak Yisalaɛl djas. Ye kwyɛl ɛlɛɛ ɛ́ náá, bɛ nɔɔ ndyaal wat tɔ endyaal kam tak nɛ bɔn-nyɛɛg bɔɔ met, bɔn-nyɛɛg bɔɔ tak ɛ́ pe ɛ́ bɛdha ɛ Abalaam. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Mɛlkisedɛk nabɛ ɛ́ ààbɛ dha ɛ Levi. Tin, nyɛ naanɔɔ ndyaal wat tɔ endyaal kam kɔ esa ee Abalaam nabula nɛ yɛ é dɛɛb ɛ. Bhii tak, nyɛ naasɛɛ Abalaam mot nabela ekɛk e Zɛɛb ɔ mɛtel. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Tin, mot di esɛɛ mot mɛtel ɔ, nyɛ eedhaa mot bɛ di esɛɛ nyɛ mɛtel ɔ, mot tok nɛ ghwyil ɛsuu mɛso kɔ ɛsu ɛ tak. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Bɛdha ɛ Levi, bot ɛ di enɔɔ ndyaal wat tɔ endyaal kam kɔ esa e bot ɔ, bɛ ɛ́ bot di náá, bɛ waagwyɛ djɛmɛn ɔ. Tin, Mɛlkisedɛk mot nanɔɔ ndyaal wat tɔ endyaal kam kɔ esa e Abalaam ɛ́ nɛ tsik, dáa Ekwyala di elɛɛ ɛ. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />É di'enek, bot ɛ nɛ ghwyil ɛke náá, é sok Abalaam nadjɛ ndyaal wat tɔ endyaal kam bɛ ɛ, ye kwyɛl ɛlyaal ɛ́ náá, bɛdha ɛ Levi, bot ɛ di enɔɔ ndyaal wat tɔ endyaal kam ɔ, bɛ naabaadjɛ yɔbɔ ndyaal wat tɔ endyaal kam. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />É di'enek, é ghɛŋ Mɛlkisedɛk natɔ́ kɛboma nɛ Abalaam ɛ, ye nabɛ ɛ́ Levi dinaa ààbyel.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Etsi e bot ɛ mbyak Yisalaɛl lɛɛ ɛ́ náá, yɛ ɛ́ bɛdha ɛ Levi ɛ di egoka nɛ ɛdi ɛ́ bɛghaa-Zɛɛb. Bɔn ɛ Levi nadi bɛghaa-Zɛɛb ɛ́ tyee mbi yii Aalɔn. Tin, mbi yɔbɔ ɛdi ɛ́ bɛghaa-Zɛɛb nabɛ ɛ́, ààdjala dáa ye di egoka ɛ. Yɛ ɛpedi ɛnyɔɛpe ɔɔ, haaa étɛp yé yɛ aabaadi nɛ dhiiti ghaa-Zɛɛb mbi yii Mɛlkisedɛk? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Etɛɛ náá, é ghɛŋ bɛ di eswoola mɛzel mɛ ɛdi ɛ́ bɛghaa-Zɛɛb ɛ, ye baagoka ɛ́ náá, bɛ swoola etsi. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Etɛp bak liiaa ɛ́ kɔ ɛsu Ghɛŋ'enaka. Nyɛ nabɛ ɛ́ mot mbyak sis, tɔ yɔbɔ mbyak, ye nabɛ ɛ́ ààbɛ nɛ ghaa-Zɛɛb. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Menabɛlka djas nɛ guka náá, Ghɛŋ'enaka nabyel ɛ́ tɔ dhaad mɛbyel ɛ Yuda. Bela náá, é ghɛŋ Moiiz nadi elii dum nɛ bɛghaa-Zɛɛb ɛ, nyɛ nabɛ ɛ́ ààtuwal mbyak tak.<verse eid="HEB 7:14" /></para>
  <para style="s">Dhiiti ghaa-Zɛɛb di enɔŋel nɛ Mɛlkisedɛk ɔ</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Beeka sa wat di elyaal náá, etɛp binek ɛ́ etsɛɛtsɛ ɛ, dhiiti ghaa-Zɛɛb eebaatuula, nyɛ ɛ́ tyee wat nɛ Mɛlkisedɛk. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Nyɛ nabɛ ɛ́ ààdi ghaa-Zɛɛb dum nɛ mɛtiŋ mɛ bot ɛ bɔs. Tin, nyɛ nadi ghaa-Zɛɛb ɛ́ nɛ ghwyil tsik di ààbɛ nɛ ɛsik ɛ. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Deenek, Ekwyala ɛpelɛɛ náá:</para>
  <para style="q1" vid="HEB 7:17">«Wɔ aadi ɛ́ ghaa-Zɛɛb kɔm-kɔm sii nɛ kɔm,</para>
  <para style="q1" vid="HEB 7:17">tyee wat nɛ Mɛlkisedɛk<note caller="*" style="x"><char style="xo" closed="false">7.17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Mɛd 110.4</ref></char></note>.»<verse eid="HEB 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 7:18" />Deenek, etsi na mwa nadisaa ɛ́, etɛɛ náá, ye nabɛ ɛ́ ààdi nɛ mɛbwala, ààval dhiiti sonok. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Yɛ ɛ́ tsɛɛtsɛ náá, etsi ɛ Moiiz ààpasa náá, bot di bot ɛ zedjala dáa ye di egoka ɛ. Tin, mbɛɛ ɛbwaalel naazedjɛaa mena, kɔ ɛsu ɛ tak ɛ́ mena aabelaka ghwyil ɛkunaa nɛ Zɛɛb. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />Etɛp binek nasael ɛ́ kɔ myoŋ nɛ mɛsoŋ mɛ Zɛɛb natuwal ɛ. Bɛdhiiti bot nadi bɛghaa-Zɛɛb ɛ́, Zɛɛb ààtuwal myoŋ nɛ mɛsoŋ, kɔ ɛsu ɛ lɔɔ. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Yɛ kabɛ Yezu ɔɔ, nyɛ nadi ghaa-Zɛɛb ɛ́, é ghɛŋ Zɛɛb natuwal myoŋ nɛ mɛsoŋ mɛ náá:</para>
  <para style="q1" vid="HEB 7:21">«Ghɛŋ eetuwal myoŋ nɛ mɛsoŋ,</para>
  <para style="q1" vid="HEB 7:21">nyɛ aanàkabaaswoola yɛ:</para>
  <para style="q1" vid="HEB 7:21">“Wɔy ɛ́ ghaa-Zɛɛb kɔm-kɔm sii nɛ kɔm<note caller="*" style="x"><char style="xo" closed="false">7.21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Mɛd 110.4</ref></char></note>.”»<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Dum nɛ tɛp tak ɛ́ di náá, Yezu ɛ́ mot di esa náá, mena dika tɔ tɛtɛ ɛbhɛŋ dhaa yii na mwa ɛ.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Yɛ ɛ́ nɛ boo zyaala: bɛghaa-Zɛɛb nadi ɛ́ ɛbuɛpe, etɛɛ náá, ɛsyee nadi esa náá, bɛ nàsa mɛsa mɔɔ mɛlu djas. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Tin, Yezu ɛ́ nɛ tsik kɔm-kɔm sii nɛ kɔm, deenek, nyɛ ɛ́ ghaa-Zɛɛb na kɔm-kɔm. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Dum nɛ tɛp tak ɛ, nyɛ di nɛ ghwyil ɛtsik bot ɛ di ekunaa nɛ Zɛɛb é ze'ɛ ɔ. Dáa ye di náá, nyɛ ɛ́ nɛ tsik kɔm-kɔm ɛ, nyɛ nɛ djaala Zɛɛb kɔ ɛsu ɛ lɔɔ.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />É di'enek, Yezu ɛ́ boo ghaa-Zɛɛb, mot di egoka nɛ nena ɔ. Nyɛ ɛ́ dɛɛ, ààbɛ nɛ ndjɛ, ààbɛ nɛ syem. Deenek, nyɛ naawa mbɛk pak nyɛy nɛ bot ɛ mesyem, nyɛ naabenaa ɛvyɛɛgɛpe pɛ tɔ gwoo. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Nyɛ tok dáa bɛdhiiti bɛghaa-Zɛɛb, nyɛ tok nɛ gwyes ɛka ebuwa mɛlu djas, étɛp mesyem mɛ met nɛghu mesyem mɛ bɛdhiiti bot. Nyɛ naazesa etɛp binek djas sok wat, é ghɛŋ nyɛ naka nyel'ɛ met buwa ɛ. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Etsi ɛ Moiiz djɛ di ɛdi boo ghaa-Zɛɛb ɛ́, nɛ bot ɛ di bɛ dinaa nɛ mendjɛ ɔ. Tin, myoŋ nɛ mɛsoŋ mɛ Zɛɛb natuwal bhis etsi ɛ, lɛɛ ɛ́ náá, Mɔn'ɛ di boo ghaa-Zɛɛb na kɔm-kɔm sii nɛ kɔm tɔ edɛɛ.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Yezu ɛ́ boo Ghaa-Zɛɛb'enaka</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Gwakeka sa di nɛ boo mɛtaŋ yii bis di ekwyɛl ɛlɛɛ bin ɛ: Yɛ ɛ́ ɛnyɔɛpe dáa ye di náá, menaka ɛ́ nɛ boo ghaa-Zɛɛb ɛ, nyɛy mot di ndiindel pɛ tɔ gwoo pɛ mbɔ eghɛŋ bóó mɛkoozi ɛ Zɛɛb<note caller="*" style="x"><char style="xo" closed="false">8.1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Mɛd 110.1</ref></char></note>, mot di nɛ mɛbwala djas ɔ. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Nyɛ ɛpesa mɛsa mɛ tɔ Di na Dɛɛ. Ye kwyɛl ɛlɛɛ ɛ́ tɛtɛ pɛt di náá, Ghɛŋ Zɛɛb nyɛy ɛmet ɛ́ nasum ɛ, ààbɛ yii bot ɛ bɔs nasum ɛ.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Eboo bɛghaa-Zɛɛb djas nanɛɛgaa tin ɛ́, étɛp ɛgoola esa e ɛgwyena pɛ daa Zɛɛb, nɛ ɛka ebuwa. Tin, ye goka ɛ́ náá, boo ghaa-Zɛɛb'enaka Yezu baadi nɛ yɛ sa nyɛ aagwyena nɛ Zɛɛb ɛ. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Tin, nyɛy ɛpedi ɛ́ kɔ ɛko ɛ bɔs ɔɔ, pe nyɛ tok nɛ ghwyil ɛdi ghaa-Zɛɛb, etɛɛ náá, kɔ ɛko ɛ bɔs, yɛ ɛ́ nɛ bot ɛ di eka ebuwa dáa etsi ɛ Moiiz di elɛɛ ɛ. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Ghuna, mɛsa mɛ bɛghaa-Zɛɛb di esa tɔ pɛt ɛbhɛŋ ɛ Zɛɛb ɛ, yɛ ɛ́ mbaŋa-mbaŋa esa di enɔŋel nɛ esa ee di esael pɛ tɔ gwoo ɛ. É sok Moiiz nawaasum pɛt ɛbhɛŋ ɛ, Zɛɛb naalɛɛ nyɛ náá: «Gwyáka, wɔ aasum yɛ ɛ, dáa wɔ nalyaalaa pɛ kɔ ɛtsok<note caller="*" style="x"><char style="xo" closed="false">8.5 </char><char style="xt" closed="false"><ref loc="EXO 25:40">Ɛwy 25.40</ref> </char></note> ɛ.»<verse eid="HEB 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 8:6" />Tin, nenak yak, mɛsa mɛ Yezu di esa ɛ, yɛ ɛ́ mɛsa mɛ di edhaa mɛsa djas ɛ. Etɛɛ náá, nyɛy ɛ́ mot nasɛ́ɛaa étɛp ɛduula pak bot nɛ Zɛɛb tɔ tɛtɛ ɛbhɛŋ ɔ. Tɛtɛ ɛbhɛŋ ɛ tak nakusaa ɛ́ nɛ tɛtɛ ekɛk di edhaŋ ɛ.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Tin, yɛ ɛpedi ɛ́ náá, ɛbhɛŋ na mwa nadi ɛ́ ààbɛ nɛ ndjɛ tɔ tak ɔɔ, pe bɛ nabɛ ɛ́ ààdis yɛ, da swoola yɛ nɛ dhiiti ɛbhɛŋ ɛ sis. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Zɛɛb nadul bot ɛ mbyak'ɛ mɛlɔ ɛ́ náá:</para>
  <para style="q1" vid="HEB 8:8">«Mam Ghɛŋ ke ɛ́ náá, tɔ mɛlu di ezyɛ yenek,</para>
  <para style="q1" vid="HEB 8:8">mɛ waasa ɛbhɛŋ ɛ na bes,</para>
  <para style="q1" vid="HEB 8:8">nɛ bot ɛ mbyak Yisalaɛl dɔɔ nɛ bot ɛ kyee dik eYuda.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Yɛ aanàkwaadi tyee wat nɛ yii mɛ nasa nɛ bɛbhaab bɔɔ ɛ,</para>
  <para style="q1" vid="HEB 8:9">é sok mɛ namɛt bɛ é mbɔ, wyisal bɛ pɛ dik Eziptɛ ɛ.</para>
  <para style="q1" vid="HEB 8:9">Bɛ nabɛ ɛ́ ààlooba nɛ ɛbhɛŋ ɛ tak,</para>
  <para style="q1" vid="HEB 8:9">é di tak ɛ́ mɛ natsin bɛ.»<verse eid="HEB 8:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 8:10" />Ghɛŋ ke ɛ́ náá:</para>
  <para style="q1" vid="HEB 8:10">«Beeka ɛbhɛŋ ɛ mɛ aasa nɛ bot ɛ mbyak Yisalaɛl ɛ,</para>
  <para style="q1" vid="HEB 8:10">bhii mɛlu menek,</para>
  <para style="q1" vid="HEB 8:10">mɛ aakwyal mɛtiŋ mam ɛ́ tɔ esiiza bɔɔ,</para>
  <para style="q1" vid="HEB 8:10">mɛ aasɔn mɛtiŋ mam tɔ ebhum elyem bɔɔ,</para>
  <para style="q1" vid="HEB 8:10">mɛ aadi ɛ́ Zɛɛb'ɔɔ, tin, bɔɔ kadi ɛ́ bot ɛ mbyak'am!<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Tin, mot aanàkabaadi nɛ gwyes ɛdjɛ mot di é bhaaz'ɛ nɛghu mɔn-nyɛɛg mɛlyo náá,</para>
  <para style="q1" vid="HEB 8:11">“Gua Ghɛŋ!”</para>
  <para style="q1" vid="HEB 8:11">Etɛɛ náá, bot djas ɛ́ waagu mɛ,</para>
  <para style="q1" vid="HEB 8:11">kana mɔn dhyeeb kɛkum boo-mot.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />É di'enek, mɛ waapel ɛdjak ɛ lɔɔ, mɛ aanàbaataala mesyem mɔɔ<note caller="*" style="x"><char style="xo" closed="false">8.12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Zel 31.31-34</ref></char></note>.»<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />É sok nyɛ nadi elii dum nɛ ɛbhɛŋ na bes ɛ, ye nakwyɛl ɛlɛɛ ɛ́ náá, ɛbhɛŋ ɛ mɛkɛn moo ɛ́ yii na mwa. Bela náá, sa di náá, ye moo ɛ́ na mwa ɛ, nazelɔɔd ɛ́, kunaa ɛ́ nɛ ɛdiib.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">Ɛduwal ɛ Zɛɛb yii kɔ bɔs nɛ yii tɔ gwoo</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Ɛbhɛŋ ɛ mɛkɛn nabɛ ɛ́ nɛ mɛtiŋ étɛp ɛduwal ɛ Zɛɛb, zɛnɔɔ pɛt ɛbhɛŋ kɔ bɔs. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />É di'enek, pɛt wat na mɛtsek mɛmbá naasumaa. Ɛtsek ɛ mɛkɛn nadi edjóoaa ɛ́ «Di na Dɛɛ». Tɔ tak, ye nabɛ ɛ́ nɛ boo lama na mengel etɛn nɛ ebá, zɛnɔɔ emesa nɛ emapa ee bɛ di eka buwa nɛ Zɛɛb ɛ.<figure style="fig" alt="Les choses qui se trouvent dans le lieu saint" file="59_Heb9.2_HolyPlace.tif" size="span" loc="9.2" copy="Gordon Thompson" ref="9.2">Esa ee di tɔ Di na Dɛɛ ɛ</figure><verse eid="HEB 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 9:3" />Bhii lɛmbɛ na pip-pip, ye nadi ɛ́ nɛ dhiiti dhɛŋ sis bɛ di edjóo «Di na Dɛɛ dhaa nyel ɛ». <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Ye nadi ɛ́ nɛ dhiiti mɔɔ buku nasael nɛ lɔɔd, étɛp ɛdik ɛ epu ele na mbɛɛ mɛnuub, nɛ tot ɛbhɛŋ nasael nɛ lɔɔd ɛ. Tɔ tot ɛbhɛŋ ɛ tak, ye nabɛ ɛ́ nɛ loŋo nasael nɛ lɔɔd ɛ, ye nadi ɛ́ nɛ mapa nadi edus pɛ ɛko di edjóoaa «<char style="sc">Man</char>» ɛ, zɛnɔɔ suub ɛ Aalɔn, suub tak nadi ɛ́ ye moo nɛ bɔɔ eka é go é tak. Ye nabaabɛ ɛ́ nɛ epɛk e mɛkok nakwyalaa mɛtiŋ mɛ ɛbhɛŋ kɔ tak ɛ. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Kɔ tot ɛbhɛŋ ɛ tak, ye nabɛ ɛ́ nɛ dhiiti edjema nadi enɔŋel nɛ efofop e duma, nadi elyaal náá, Zɛɛb ɛ́ tinaak ɛ. Mɛbhap mɔɔ nadi ɛ́ elɛsa. Piyo mɛbhap mɛ tak nadi ɛ́ ebutal tot ɛbhɛŋ. Nenak, yak tok ɛwala di náá, mena sɔs etɛp binek djas.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />É ghɛŋ ye nadi náá, esa binek djas nabɛ ɛ́ yɛ eezekoobelaa ɛ, bɛghaa-Zɛɛb nadi ɛ́ enini mɛlu djas tɔ ɛtsek ɛ mɛken pɛt ɛbhɛŋ, étɛp ɛkɛsa mɛsa mɔɔ. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Tin, tɔ ɛtsek ɛ ebá e pɛt, yɛ ɛ́ boo ghaa-Zɛɛb nyɛy ɛmet ɛ di nɛ ghwyil ɛni penek, nyɛ zoni penek ɛ́, sok wat tɔ mbu. Nyɛ goka nɛ ɛni penek ɛ́ nɛ ghiya tit yii nyɛ di eka Zɛɛb buwa, étɛp mesyem mɛ met nɛ yii bot ɛ. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />É di'enek, Sisim na Dɛɛ ɛpelyaal náá, dáa ɛtsek ɛ mɛkɛn dinaa tin ɛ, ye lyaal ɛ́ náá, Di na Dɛɛ dhaa nyel dinaa ndiila. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Etɛp binek nɔŋel ɛ́ nɛ etɛp ee mena kadi ebee mos'aak. Ye kwyɛl ɛlyaal ɛ́ náá, esa ee mot di egwyena nɛ Zɛɛb ɛ, zɛnɔɔ ebuwa bɛtit ee mot di eka Zɛɛb yɛ ɛ, ye tok nɛ ghwyil ɛsa náá, lyem mot di esa mbi mendjaala menek ɔ, di sɛŋ. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Mɛtiŋ menek dum ɛ́ nɛ esa e dek, nɛ mɛnyok, zɛnɔɔ dáa mot di egoka nɛ ɛsa étɛp ɛdis edhuud ɛ. Yɛ ɛ́ mɛzel mɛ bot nazetawa nɛ ɛsa, kɛkum é ɛwala Zɛɛb nakoobal esonok djas ɛ.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Tin, Klisto nazyɛ ɛ́ dáa boo ghaa-Zɛɛb embɛɛ esa ee di kɔ ɛko ɛ bɔs ɛ. Nyɛ naani tɔ pɛt<note caller="+" style="f"><char style="fr" closed="false">9.11 </char><char style="fq" closed="false">pɛt </char><char style="ft" closed="false">yɛ ɛ́ di mendjaala mɛ bɛghaŋ ɛ etsi, bɔn ɛ Yisalaɛl nadi esesa mɛsa mɛ ɛka ebuwa tɔ tak ɛ. Ye nabɛ ɛ́ pɛt bɛ nabebyal yɛ byalak ɛ. Bɛ sulal edhiiti edi'ɔɔ, bɛ kasum ɛ́ sumak étɛp mɛsa mɔɔ. Bi ɛ́ waabela yɛ tɔ mɛkana mɛ <char style="xt"><ref loc="EXO 25:8-9">Ɛwy 25.8-9</ref></char>. </char></note> di enyɔ dhaa tyɛ ɛ, pɛt di náá, yɛ eezedjala nɛ di tak ɛ, yii di náá, ye tok bot ɛ bɔs nasum ɛ. Bela náá, pɛt tak tok kɔ bhwak nakusaa-kusak ɛ. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />É ghɛŋ Klisto nani-niak wat na kɔm-kɔm tɔ Di na Dɛɛ dhaa nyel ɛ, nyɛ nabɛ ɛ́ ààka buwa ghiya ngom taa nɛghu yii mɔn ngɔmbɛ. Tin, nyɛ naka ɛ́ ghiya yɛ met, da pɛk mena sok wat ekeekeee tɔ mesyem mena. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Ghiya engom e engɔmbɛ nɛ engom e etaa nɛghu mɛsii mɛ engɔmbɛ zedikaa, yii bɛ nadi emwam kɔ bot ɛ di nɛ edhuud ɔ, yɛ ɛ́ étɛp ye needis bɛ edhuud, nɛ étɛp ɛbulal ɛgwakel ɛ lɔɔ nɛ Zɛɛb. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Yɛ bɛ náá, yɛ ɛ́ deenek ɔɔ, ghiya ɛ Klisto eedhaa yenek boo dhaŋak. Nɛ ghwyil Sisim na Dɛɛ, Klisto eeka nyel'ɛ met nɛ Zɛɛb dáa tɛtɛ buwa di ààbɛ nɛ djam ɛ. Ghiya yɛ ɛ waagwyii elyem ee zepulel nɛ embee mɛsa mɛ di edul mena tɔ ɛsyee ɛ, étɛp mena neesaka mɛsa mɛ Zɛɛb, mot di nɛ tsik ɔ.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Dum nɛ tɛp tak ɛ́ di náá, Klisto ɛ́ di mot di eduula pak Zɛɛb nɛ bot tɔ ɛbhɛŋ na bes ɔ. Etɛɛ náá, bot ɛ Zɛɛb nazedjóo ɔ, neebela esa e lyak na kɔm-kɔm ee nyɛ nakɛk bɛ ɛ. Tin, bɛ aabela yɛ ɛ́, dum nɛ ɛsyee ɛ mot ngɔt nagwyɛ ɔ. Kɔ ɛsu ɛ tak ɛ́, bot ɛ bɔs moo mos pɛka tɔ mesyem mɛ bɛ nasa si ɛbhɛŋ ɛ na mwa ɛ.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />É di di náá, mɛkana mɛ mɛlik naalikaa ɔ, ye goka ɛ́ náá, ye lyaalaa náá, mot nakwyal mɛkana mɛ mɛlik mɛ tak ɔ, naazegwyɛ. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />É di'enek, mɛkana mɛ mɛlik ààval dhiiti sonok, yɛ bɛ náá mot kwyal yɛ ɔɔ, dinaa nɛ tsik ɔ. Tin, ye val ɛ́, yɛ ɛ́ bɛ náá, mot nakwyal yɛ ɔɔ, nyɛ eezekpaa nɛ mɛsyee, gwyɛ ɔ. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Dum nɛ tɛp tak ɛ́ di náá, ɛbhɛŋ mɛkɛn nabɛ ɛ́ ààval sonok, ɛsok nɛ ghiya nɛ see. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Moiiz napookokan sok ɛ́ ɛlaa mɛtiŋ é mis mɛ bot djas, dáa ye nazodjɛaa nyɛ ɛ. Bhii tak, wɔ gwaa, nyɛ zɛnɔɔ ghiya yii ngom e etaa nɛ yii bɔɔ engɔmbɛ, dɔɔ nɛ mɛdii, myek yɛ kɔ mɛkana mɛ etsi dɔɔ nɛ é mɛnyel mɛ bot djas. Nyɛ naanɔɔ lɛɛ le di edjóoaa Izop ɛ, nɛ mɔɔ pes kaad na tɔɔbelaa tiŋal é tak, étɛp ɛduu tɔ ghiya, da myek yɛ. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Nyɛ naake náá: «Yak ɛ́ wak ɛ́ ghiya di elyaal ɛbhɛŋ ɛ Zɛɛb djɛ bin náá, bi duwal ɛ<note caller="*" style="x"><char style="xo" closed="false">9.20 </char><char style="xt" closed="false"><ref loc="EXO 24:3-8">Ɛwy 24.3-8</ref></char></note>.» <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Moiiz naabaamyek ghiya kɔ pɛt ɛbhɛŋ, nɛ kɔ esa djas di ebeaa étɛp ɛsa mɛsa mɛ Zɛɛb ɛ. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Etsi lɛɛ ɛ́ náá, bɛ dis edhuud é esonok djas ɛ́ nɛ ghiya. Deenek, ye tok nɛ mot di nɛ ghwyil ɛbela ɛpelak mesyem yɛ bɛ náá, ghiya ààpasee ɔɔ.<verse eid="HEB 9:22" /></para>
  <para style="s1">Buwa ɛ Klisto dis ɛ́ mesyem</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Yɛ bɛ náá, embaŋa-mbaŋa e esa ee di pɛ tɔ gwoo ɛ goka ɛ́ nɛ ɛdisaa edhuud ɛ deenek ɔɔ, é di'enek, esa ee di pɛ tɔ gwoo ɔ, yɛ ɛ́ nɛ gwyes buwa di nɛ boo mɛtaŋ ɛ. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Etɛɛ náá, Klisto nabɛ ɛ́ ààni tɔ Di na Dɛɛ di náá, bot ɛ bɔs ɛ́ nasa nɛ mɛmbɔ mɔɔ ɔ, é di di náá, yɛ ɛ́ mbaŋa-mbaŋa tɛtɛ Di na Dɛɛ ɔ. Tin, nyɛ nani ɛ́ tɔ gwoo, nyɛ ɛ́ sok bhwoob ɛ Zɛɛb étɛp'enaka. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Membu djas, boo ghaa-Zɛɛb bot ɛ mbyak eYuda dyeebani tɔ Di na Dɛɛ dhaa nyel ɛ́, nɛ ghiya tit. Tin, Klisto nabɛ ɛ́ ààni esok nɛ esok étɛp ɛkɛka nyel'ɛ buwa. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Yɛ ɛ́ pe bɛ náá, ye nasael ɛ́ deenek ɔɔ, pe Klisto nazuk ɛ́, esok nɛ esok kana bhwak nakusel ɛ. Nenak dáa ye di náá, bhwak moo ɛ́ pɛ mɛsik ɛ, Klisto nazotuula ɛ́ sok wat, nyɛ naaka nyel'ɛ met buwa, étɛp ɛpel ɛ́ mesyem. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Bot djas kɔ ɛko ɛ bɔs goka ɛ́ nɛ ɛgwyɛ sok wat, bhii tak, Zɛɛb ɛpɛ́ɛ bɛ. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Yɛ ɛ́ tyee wat dáa Klisto naka nyel'ɛ buwa étɛp ɛpel mbula mesyem mɛ bot ɛ bɔs ɛ. Tin, nyɛ waabaatuula-tuula sis, é sok yenek yɛ aanàkabaadi étɛp ɛpel ɛ́ mesyem. Deenek, yɛ aakadi ɛ́ étɛp ɛdjɛ tsik nɛ bot ɛ di egwaal ɛtuula ɛ lɛ ɔ.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Etsi ɛ Moiiz nazobɛ ɛ́ mbaŋa-mbaŋa di elyaal mena embɛɛ esa aasael djɛmɛn ɛ. Tin, yɛ ààlyaal etsɛɛtsɛ etɛp e tak dáa ye di ɛ. Étɛp tak ɛ́ di náá, ɛkeka mbi buwa wat membu nɛ membu tok nɛ ghwyil ɛdis edhuud e bot ɛ di esaa ɛkunaa nɛ Zɛɛb ɔ. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Yɛ ɛpedi ɛ́ náá, kwaambi yenek ɛdjaala ɛ Zɛɛb ɛpedis bot edhuud nɛ tsɛɛtsɛ ɔɔ, pe bɛ aanàkabaadi nɛ esiiza nɛ mesyem mɔɔ. Tin, bot ɛ́ waakat ɛbaakeka buwa. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Tin, ebuwa binek ɛ́ di esa náá, mot gheetetaala mesyem mɛ nyɛ nadi esa membu nɛ membu ɛ. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Etɛɛ náá, ghiya ngom ngɔmbɛ nɛ yii ngom taa tok nɛ ghwyil ɛdis mesyem mɛ bot.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Dum nɛ tɛp tak, é sok Klisto nadi ezyɛ kɔ ɛko ɛ bɔs ɛ, nyɛ naake nɛ Zɛɛb náá:</para>
  <para style="q1" vid="HEB 10:5">«Wɔ nabɛ ɛ́ ààbɛ nɛ gwyes ebuwa,</para>
  <para style="q1" vid="HEB 10:5">ààbɛ nɛ gwyes esa e ɛgwyena.</para>
  <para style="q1" vid="HEB 10:5">Tin, wɔ naasa náá, mɛ di nɛ nyel.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Wɔ nabɛ ɛ́ ààmyaala nɛ ebuwa nadikaaa wɔ kɔ mesa-ebuwa ɛ,</para>
  <para style="q1" vid="HEB 10:6">nɛghu ebuwa nakaaa wɔ étɛp ɛpel mesyem mɛ bot ɛ.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />É di'enek, mɛ naazɛke náá, “Zɛɛb'am, mɛ eezyɛ pɛ daa lɔ mam mɛ ɛmet,</para>
  <para style="q1" vid="HEB 10:7">étɛp ɛsa ɛkwosak ɛ lɔ,</para>
  <para style="q1" vid="HEB 10:7">dáa ye nakwyalaa dum nɛ nam tɔ mɛkana mɛ na dɛɛ ɛ<note caller="*" style="x"><char style="xo" closed="false">10.7 </char><char style="xt" closed="false"><ref loc="PSA 40:7-9">Mɛd 40.7-9</ref></char></note>.”»<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Tin, nyɛ nakan ɛke sok ɛ́ náá: «Wɔ ààpakwyɛl ebuwa, nɛghu esa e ɛgwyena, wɔ ààpakwyɛl bɛtit zedikaaa kɔ mesa-ebuwa ɛ, nɛghu ebuwa dikaaa étɛp ɛpel ɛ mesyem mɛ bot ɛ, wɔ nabɛ ɛ́ ààmyaala nɛ sa wat.» Dhi ebuwa binek di ekaaa dáa etsi di elɛɛ ɛ. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Bhii tak, nyɛ eezɛke náá:</para>
  <para style="q1" vid="HEB 10:9">«Beea mɛ, mam mɛ ɛmet eezyɛ zɛsa ɛkwosak ɛ lɔ.»</para>
  <para style="p" vid="HEB 10:9">Deenek, Klisto eedis ebuwa na mwa, nyɛ eedjila nɛ buwa yɛ. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Yezu Klisto naasa ɛkwosak ɛ Zɛɛb, deenek, nyɛ naaka nyel'ɛ met buwa sok wat kɔm-kɔm sii nɛ kɔm. Tin, nyɛ naasa náá, mena dika bot ɛ edɛɛ.<verse eid="HEB 10:10" /></para>
  <para style="s">Ɛpelak ɛ mesyem é ze buwa ɛ Klisto</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Ghaa-Zɛɛb djas dyeebadi ɛ́ tetel mɛlu djas étɛp ɛsa mɛsa mɛ, étɛp ɛka ebuwa e tak wat mɛlu djas. Bela náá, ebuwa tak tok nɛ ghwyil ɛdis mot mesyem. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Tin, Klisto nyɛ ɛmet nazoka buwa ɛ́ sok wat étɛp ɛdis ɛ bot mesyem, bhii tak, nyɛ moo ɛ́ ndiindel pɛ mbɔ eghɛŋ ɛ Zɛɛb. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Nenak, yɛ ɛ́ tin ɛ nyɛ di ebwood náá, Zɛɛb sa náá, bot ɛ mɛbhuka mɛ di dáa poba bɛ di ekɛl mɛko ɛ. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Deenek, nɛ buwa tak wat, nyɛ naadis bot edhuud disak wat ekeekeee étɛp bot needi dɛɛ.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Tin, dɔɔ nɛ Sisim na Dɛɛ ɛpebaalɛɛ mena náá, yɛ ɛ́ etɛp e tsɛɛtsɛ. Etɛɛ náá, nyɛ pookoke ɛ́ náá:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />«Ghɛŋ ke ɛ́ náá:</para>
  <para style="q1" vid="HEB 10:16">Beeka ɛbhɛŋ ɛ mɛ aasa nɛ nɔɔ ɛ,</para>
  <para style="q1" vid="HEB 10:16">bhii mɛlu menek.</para>
  <para style="q1" vid="HEB 10:16">Mɛ waakwyal mɛtiŋ mam ɛ́ tɔ ebhum elyem bɔɔ,</para>
  <para style="q1" vid="HEB 10:16">mɛ waasɔn yɛ tɔ esiiza bɔɔ.»<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Bhii tak, nyɛ eebaazɛke náá: «Mɛ aanàbaataala ɛdjak ɛ lɔɔ, nɛghu mesyem mɔɔ.» <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Ghuna, é di mesyem di epelaa ɛ, bot tokapɛ nɛ ghwyil ɛbaaka buwa étɛp mesyem.<verse eid="HEB 10:18" /></para>
  <para style="s">Djhookunaaka nɛ Zɛɛb</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />É di'enek, bɔn-nyɛɛg bam, menaka ɛ́ nɛ ɛbwaalel náá, mena waanika tɔ Di na Dɛɛ dhaa nyel, kɔ ɛsu ɛ ghiya ɛ Yezu naso tyee buwa ɛ. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Nyɛ naazedii mena ze na bes di nɛ tsik ɛ, nyɛy nyɛ ɛmet ɛ́ nadhaa é ze boo lɛmbɛ na pip-pip ndjaa-Zɛɛb, ye kwyɛl ɛlyaal ɛ́ nyel'ɛ met. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Tin, menaka ɛ́ nɛ boo ghaa-Zɛɛb, mot di kukuma di edjɛɛd ndjaa-Zɛɛb ɔ. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Djhookunaaka nɛ Zɛɛb, nɛ lyem wat, nɛ ɛdum ɛ koŋ nɛ Zɛɛb zepyet ɛ, etɛɛ náá, ghiya ɛ Yezu eezegwyii embee esiiza ee di tɔ bhum elyem bena ɛ, dɔɔ nɛ mɛnyel mena eezegwyiiel nɛ tɛtɛ mɛdii. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Djhoobaalka ɛlyelɛpe ɛbwaalel ɛ mena di egoolaka ɛ, etɛɛ náá, Zɛɛb ɛ́ sosoob tɔ ekɛk bɛ. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Djhookwyɛɛgelka pak'enaka étɛp ɛdjɛel mɛghaaz tɔ kwyɛl nɛ ɛsa enɛm esa. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Sa mena ààkatka ɛtɔ́ pɛ ndjaa mendjaala, dáa bɛdhiiti bot moo nɛ mɛfulu mɛ ɛsa yɛ mos ɛ. Tin, mena goka ɛ́ nɛ ɛdjɛel mɛghaaz pak'enaka, etɛɛ náá, bi ɛpebee biyɔ bɛmet náá, ɛlu ɛ Ghɛŋ eezekunaa.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Etɛɛ náá, bhii bot aazegu etsɛɛtsɛ ɛ, mena baasyemka nɛ ɛkwosak ɛ lena ɔɔ, ye tokapɛ nɛ buwa étɛp ɛpelak mesyem mɛ tak. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Ye kalik mena ɛ́, ɛgwaal tɔ mɛnyɛnyɛ epɛ́ɛ e Zɛɛb nɛ boo du na goo-goo yii aadik bot ɛ mɛbhuka mɛ ɛ. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Mot ɛ di ààlooba nɛ etsi ɛ Moiiz ɔɔ, nyɛ waagóa ààbɛ nɛ ghoŋ, yɛ ɛ́ bɛ náá, bɛtyaasɛs ebá nɛghu bɛlɛl eemyaal sa nyɛ sa ɛ. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />É di'enek, yɛ aakadi tin dáa nɛ mot di ebhina Mɔn ɛ Zɛɛb ɔ, nɛ mot di ebee ghiya ɛbhɛŋ ɛ nasa náá, ɛgwakel baabula pak bot nɛ Zɛɛb é mis toto ɔ, nɛ mot di elee Sisim di ɛsuk ɛ enɛm nɛ embɛɛ ɔ? Bi eepookogek mbi feŋ yenɔk mot di egoka nɛ ɛbela ɛ? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Tin, mena nɛ guka mot nalɛɛ náá:</para>
  <para style="q1" vid="HEB 10:30">«Yɛ ɛ́ mam ɛ di egoka nɛ ɛbulal ɛbiyo bɛ sa bin ɛ, mam ɛ di edjɛ mot nɛ mot yɛ efute.»</para>
  <para style="m" vid="HEB 10:30">Nyɛ naabaalɛɛ náá:</para>
  <para style="q1" vid="HEB 10:30">«Ghɛŋ ɛ́ waapɛ́ɛ bot ɛ mbyak'ɛ<note caller="*" style="x"><char style="xo" closed="false">10.30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">Dɛt 32.35-36</ref></char></note>.»<verse eid="HEB 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 10:31" />Yɛ ɛ́ àànyɔ náá, mot di nɛ ndjɛ é mis ɛ Zɛɛb mot di nɛ tsik ɔ.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Pookotaalaka nɛ sa bi naboma nɛ yɛ é ghɛŋ sok, é sok Zɛɛb nabɛɛ bin mis étɛp bin neegu etsɛɛtsɛ ɛ. Bi naasa mɛghaaz tɔ eboo mezuk mɛ bi naboma nɛ yɛ ɛ. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Bɛdhiiti bot pak'en naaleeaa, tiigaa é mis mɛ bot, bela náá, bɛdhiiti bot nabɛ ɛ́ nɛ lyem ɛkwyee bot ɛ nadi ezuk nɛ ɛtiigaa dáa bɔɔ ɔ. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Bi naazuk lɔɔg wat nɛ bot ɛ membok. Bi nadi ɛ́ tɔ mɛmyaala, é sok bɛ nadɛk mɛvu men ɛ. Etɛɛ náá, bi nɛ gu náá, bi ɛ́ nɛ tɛtɛ mɛvu di kɔm-kɔm sii nɛ kɔm ɛ. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Sa bi ààbulal lyem bhis dum nɛ ɛbwaalel bi di nɛ yɛ ɛ, etɛɛ náá, bi aabela boo efute. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Ye goka ɛ́ náá, bi wa zii étɛp bi neesa ɛkwosak ɛ Zɛɛb, étɛp bi neebela sa nyɛ nakɛk bin ɛ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Tin, Ekwyala lɛɛ ɛ́ náá:</para>
  <para style="q1" vid="HEB 10:37">«Tɔ mɔɔ ɛwala, tɔ ba mɔɔ pes ɛwala,</para>
  <para style="q1" vid="HEB 10:37">mot di egoka nɛ ɛzyɛ ɔ, nyɛ waazyɛ,</para>
  <para style="q1" vid="HEB 10:37">ɛzyɛ ɛ lɛ eezekunaa.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />É di'enek, Zɛɛb ke ɛ́ náá, mot di tɔ epiki é mis mam tɔ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb ɔ, nyɛ waatsak.</para>
  <para style="q1" vid="HEB 10:38">Tin, nyɛ bula bhis ɔɔ, mɛ aanàkwaamyaala nɛ nɛ<note caller="*" style="x"><char style="xo" closed="false">10.38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">Hab 2.3-4</ref></char></note>.»<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Mena tokeka bot ɛ di ebula bhis tɔ ɛdum ɛ koŋ nɛ Zɛɛb, da wo ze ɔ. Menaka ɛ́ bot ɛ di tɔ ɛdum ɛ koŋ nɛ Zɛɛb, bot ɛ di tɔ ze tsik na kɔm-kɔm ɔ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Ɛdum ɛ koŋ nɛ Zɛɛb</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Ɛdum ɛ koŋ nɛ Zɛɛb, yɛ ɛ́ ɛdi nɛ ɛbwaalel náá, sa wɔ di ebun ɛ, wɔ waabela yɛ. Yɛ ɛ́ ɛmyaal nɛ lyem wat náá, sa di ààbeeaa nɛ mis ɛ, yɛ ɛ́ tak nɛ tsɛɛtsɛ. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Yɛ ɛ́ dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb ɛ, Zɛɛb namyaal bot ɛ na mwa.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Yɛ ɛ́ dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb ɛ, bot di egu náá, bhwak nakusaa ɛ́ nɛ Mɛkpa ɛ Zɛɛb. Ye kwyɛl ɛlɛɛ ɛ́ náá, esa ee di beeaa ɛ nasael ɛ́ nɛ esa ee nadi ààbeeaa ɛ.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Yɛ ɛ́ dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb ɛ, Abhɛl nadjɛ Zɛɛb esa e ɛgwyena dhaa yii mɔn-nyɛɛg Kayin. Yɛ ɛ́ dum nɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb ɛ, Zɛɛb nabee nyɛ dáa mot epiki, etɛɛ náá, Zɛɛb nyɛy nyɛ ɛmet naamyaala nɛ esa e ɛgwyena ɛ lɛ. Ye nakoozodi náá, Abhɛl naazegwyɛ, etɛp nyɛ nasa ɛ́ dinaa egék.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Yɛ ɛ́ dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb ɛ, Enɔk nabyet tɔ́ pɛ tɔ gwoo, nyɛy ààgwyɛ. Tin, mot nabɛ ɛ́ ààkabaabela nyɛ, etɛɛ náá, Zɛɛb naaben nyɛ pɛ tɔ gwoo. Ekwyala lɛɛ ɛ́ náá, ɛsok nɛ nyɛ nɛ tɔ́ tɔ gwoo, Zɛɛb naamyaala nɛ nɛ, etɛɛ náá, nyɛ nadi esa Zɛɛb edjɔɔ é mis. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Bela náá, Zɛɛb tok nɛ ghwyil ɛbela edjɔɔ é mis nɛ mot di ààdum koŋ nɛ nɛ ɔ. Tin, mot di etiila pɛ daa Zɛɛb ɔ, nyɛ goka nɛ ɛmyaal náá, Zɛɛb ɛ́ tak. Nyɛ nɛ djɛ efute nɛ bot ɛ di esaa nyɛ ɔ.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Yɛ ɛ́ dum nɛ ɛdum koŋ nɛ Zɛɛb ɛ, Noe nagwak sa Zɛɛb nalɛɛ nyɛ, dum nɛ sa nadi náá yɛ aasael ɛ. Ye nabɛ ɛ́, bot dinaa ààbee sa tak. Nyɛ naadyeebawa lyem tɔ etɛp ee Zɛɛb nalɛɛ nyɛ ɛ. Nyɛy batasa mɛsuwa mɛ nyɛ natsik nyel'ɛ met nɛ bot ɛ mɛbyel mɛ ɛ. É sok nyɛ nasa deenek ɛ́, ye nabɛ ɛ́, nyɛ naakwyesal bot djas ndjɛ sɔs. É di'enek, dum nɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb, Zɛɛb naabee nyɛ dáa mot epiki.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Yɛ ɛ́ dum nɛ ɛdum koŋ nɛ Zɛɛb ɛ, Abalaam nalooba nɛ ndjóoel ɛ Zɛɛb é sok nyɛ nadjóo nyɛ ɛ. Wɔ gwaa, nyɛ zɛtɔ́ pɛ kyee dik Zɛɛb nakɛk náá, nyɛ aadjɛ nyɛ ɛ. Tin, nyɛ naazɛtɔ́, ààgu pɛ kyee nyɛ di etɔ́ ɛ. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Dum nɛ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb, nyɛ naadi tyee ndjoŋ kɔ kyee dik Zɛɛb nakɛk nyɛ ɛ. Tin, nyɛ nadidi ɛ́ pɛ tɔ epɛt, tyee wat nɛ Izak, zɛnɔɔ Zakɔɔb, bot ɛ nabela mbi ekɛk e tak wat ɔ. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Etɛɛ náá, Abalaam nadi ebwood ɛ́ boo ghaada di nɛ ghus-zumal na lyel-lyel ɛ. Ghaada di náá, Zɛɛb nyɛy ɛmet ɛ di mot di ekoobal dáa yɛ aasael ɛ, yɛ ɛ́ nyɛy nyɛ ɛmet di sumel tak.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Yɛ ɛ́ dum nɛ ɛdum koŋ nɛ Zɛɛb ɛ, Saala ye nakoozodi náá, nyɛ nabɛ ɛ́ kwyiid tɔ́a-moma, Zɛɛb naadjɛ nyɛ ghwyil ɛbela ɛbum, bya. Tin, nyɛ nabɛ ɛ́ nɛ boo ɛbwaalel náá, Zɛɛb ɛ́ sosoob nɛ ekɛk bɛ. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Étɛp tak ɛ bhaab'enaka ngɔt Abalaam di ɛsuk ɛ mɛbyel mɛ bot ɛbuɛpe, ye nakoozodi náá, nyɛ nabɛ ɛ́ nyɛ moo tɔa-mot, nyɛ eezekunaa nɛ ɛsyee. Bot ɛ mɛbyel mɛ tak bu ɛ́ dáa ekwyikwyen tɔ gwoo, nɛghu dáa bɛsyɛ é ɛboŋ ɛ boo dii mɛsɔn, mot tok nɛ ghwyil ɛlaa bɛ.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Bot binɔk djas nagwyɛ ɛ́, bɔɔ edum koŋ nɛ Zɛɛb, bɛ nagwyɛ ɛ́ ààbela ekɛk e Zɛɛb nakɛk bɛ ɛ. Tin, bɛ nazobee yɛ ɛ́ ɛtsetaɛpe, deenek, bɛ naamyaala nɛ yɛ. Bɛ naagu yɛ popoopwon náá, bɛ nabɛ ɛ́ bɛndjoŋ, ekpaa-goŋ kɔ bɔs. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Bot ɛ di elii deenek ɔ, bɛ lyaal popoopwon ɛ́ náá, bɛ ɛpesaa kyee dik di náá, yɛ aadi ɛ́ yɔbɔ ɛ. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Tin, bɛ ɛpedi etaala kyee dik bɛ nadus pɛ yiizaag ɔɔ, pe bɛ eezebela ze ɛsik ɛ́ penek. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Nɛ tsɛɛtsɛ, bɛ nakwyɛl ɛ́ mbɛɛ kyee dik di eedhaa yak ɛ, kyee dik di tɔ gwoo ɛ. Dum nɛ tɛp tak ɛ di náá, Zɛɛb tok nɛ sen ɛmyaal náá, nyɛ di Zɛɛb'ɔɔ. Tin, nyɛ eezekoobal bɛ tɛtɛ ghaada.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Yɛ ɛ́ dum nɛ ɛdum koŋ nɛ Zɛɛb ɛ, Abalaam naka Izak buwa, é ghɛŋ Zɛɛb nawa nyɛ tɔ mɛbhowal ɛ. Nyɛ nadi ɛ́ nyɛ moo babeega, étɛp ɛka sɛɛŋɛlɛ mɔn'ɛ ngɔt é buwa, dhi nyɛ di egu náá, nyɛ naabela ekɛk. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Zɛɛb naalɛɛ nɛ nɛ náá:</para>
  <para style="q1" vid="HEB 11:18">«Yɛ ɛ́ dum nɛ Izak ɛ wɔ aabela bɛdha ɛ mɛ nakɛk wɔ ɛ.»<verse eid="HEB 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19" />Deenek, Abalaam nabɛ ɛ́ nɛ ɛbwaalel náá, Zɛɛb ɛ́ nɛ ghwyil ɛgomal Izak mɔn'ɛ pak myoŋ. Dum nɛ tɛp tak ɛ, Zɛɛb nabulal nyɛ mɔn tak. Tin, ye lyaal ɛ́ ɛkɛɛ Izak gomelaa ɛ́, pak bɛmyoŋ.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb, Izak naasɛɛ Zakɔɔb nɛ Ezau mɛtel, étɛp esa ee di eezyɛ pɛ sok ɛ.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb, Zakɔɔb naasɛɛ bɔn ɛ Zozɛf mɛtel, ɛsok nɛ nyɛ nɛ gwyɛ. Nyɛ nadi epyet nɛ suub étɛp ɛ́ ɛduwal ɛ Zɛɛb.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb, Zozɛf, ɛsok nɛ nyɛ nɛ gwyɛ, nyɛ naalɛɛ náá, bɔn ɛ Yisalaɛl ɛ́ waawyis tɔ dik Eziptɛ. Nyɛ naabaalɛɛ nɛ nɔɔ náá, bɛ wyis nɛ egwyes e nyel'ɛ.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb, sɛɛg nɛ nyɛɛg ɛ Moiiz naasyel nyɛ, edi bɛngɔn ɛlɛl bhis ɛbyel ɛ lɛ. É sok bɛ naabee náá, mɔn tɔlɔɔ tak nabɛ ɛ́ nɛm ɛ, bɛ nabɛ ɛ́ ààgwak bwoo ɛbyen ɛlooba nɛ mɛtiŋ mɛ Mɛkoozi Falaɔŋ.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Dum nɛ ɛdum koŋ nɛ Zɛɛb, é sok Moiiz nadi nyɛ moo boo-mot ɛ, nyɛ naabyen náá bɛ djóo nyɛ, mɔn ɛ ɛsyes ɛ Falaɔŋ. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Moiiz, naamyaal náá, nyɛ tiigaa sama wat nɛ bɔn ɛ Zɛɛb, nɛ náá, nyɛ di ɛ́ tɔ mɛmyaala mɛ etɛp e mesyem, mɛmyaala mɛ esa ee di ààbɔya ɛ. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Nyɛ nadi ebee ɛ́ náá, ɛdukaa dáa Klisto nadukaa ɛ́, yɛ eedhaa mɛvu djas di kɔ kyee dik Eziptɛ ɛ, nɛ boo mɛtaŋ. Etɛɛ náá, mis mɛ nadi egwyák ɛ́, efute bɛ yii di ezyɛ ɛ.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb, Moiiz naadus kɔ dik Eziptɛ, ààkaab ɛbuk ɛ Falaɔŋ. Nyɛ nabɛ ɛ́ ghiŋ tɔ ɛdum ɛ koŋ ɛ lɛ nɛ Zɛɛb ɛkɛɛ náá, nyɛ nadi ebee Zɛɛb, mot di ààbeeaa ɔ. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Dum nɛ ɛdum koŋ nɛ Zɛɛb, Moiiz naakus ɛbyoŋ ɛ pak. Tin, nyɛ naazɛke náá, bɛ lɔɔb ghiya é mɛbɛ mɛ mendjaa. Etɛɛ náá, é sok fofop ɛsyee aadhaŋ ɛ, nyɛ needi ààgó bɔn mɛgwyak mɛ bot ɛ mbyak Yisalaɛl.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Dum nɛ ɛdum koŋ nɛ Zɛɛb ɛ, bɔn ɛ Yisalaɛl nasɛɛ boo dii mɛsɔn na tɔɔbelaa nɛ mɛko mɔɔ, ɛkɛɛ ye nabɛ ɛ́ tɛtɛ gba bot di eezyɛ nɛ ɛdhaŋ ɛ. Tin, é sok bot ɛ Eziptɛ nawaabaŋaa bɛ ɛ, bɔɔ djas naasi bhɛɛɛ tɔ boo dii mɛsɔn.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Yɛ ɛ́ dum nɛ ɛdum koŋ nɛ Zɛɛb ɛ, eboo epap e ghaada Yeliko nabik, bhii bɔn ɛ Yisalaɛl nasa mɛlu mɛ etɛn nɛ ebá ekii ghaada ɛ.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb ɛ Layaab, moma mɛzɔ nadi ààgwyɛ sama nɛ bot nadi ààlooba nɛ Zɛɛb ɔ. Etɛɛ náá, nyɛ naasyel bɔn ɛ Yisalaɛl ɛnyɔɛpe, bot nazyɛ zɛbee ghaada tɔ sɔ ɔ. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />Bi kwyɛl náá, mɛ baake dáa? Mɛ tok nɛ bɛtɛ nɛ ɛwala étɛp ɛkaada bin etɛp kɔ ɛsu ɛ Zedeɔŋ, Bhalak, Samsɔŋ, Zɛfete, nɛ Dhavid, zɛnɔɔ Samyɛl dɔɔ nɛ bɛdhiiti bɛngoolel ɛ Mɛkpa ɛ Zɛɛb. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Yɛ ɛ́ dum nɛ ɛdum koŋ nɛ Zɛɛb ɛ, bɛ nakwak mɛyoŋ, bɛ nakɛ tɔ epiki, bɛ nabela sa Zɛɛb nakɛk bɛ ɛ. Bɛ naadiyal bɛghee enuub, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />bɛ naadimal eboo mu, bɛ naadus é eban e ɛsyee ɛ bɛ nadi ekwyɛl ɛgó bɛ nɛ epɛl ɛ, bɛ naabaabela ghwyil bhii mɛbɛ́, bɛ naalyaal ghwyil'ɔɔ, é sok bɛ nadi elumla dɛɛb ɛ, wɔ gwaa, bɛ sɔ esodja e edhiiti mɛdhik mɛ sis.<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />Dum nɛ ɛdum ɛ koŋ nɛ Zɛɛb, boa naabee dáa bot bɔɔ nazegwyɛ ɔ nagom ɛ.</para>
  <para style="p" vid="HEB 11:35">Bɛdhiiti bot naatiigaa ɛlyelɛpe, bɔɔ gwyɛ. Bɛ naabyen mɛpɛka, étɛp ɛbela tɛtɛ tsik bhis ɛsyee. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Tin, bɛdhiiti naadukaa, biaa nɛ eghwyɛs, bak bɛdhiiti naakɔlaa nɛ ekel e ghwooz, waaa é membok. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Bɛdhiiti bot naagóaa nɛ mɛkok, syakaa ebil ebá, góaa nɛ epɛl. Bɛdhiiti bot nabɛ ɛ́ etɔ́ nɛ ɛtwol edi nɛ edi, ekaad bɔɔ nabɛ ɛ́ eket e etaa nɛ yii ebhata, bɛ nabɛ ɛ́ bɛdjel ɛ bot, bɛ nadi etiigaa nɛ ɛzukaa. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Bhwak nabɛ ɛ́ ààgoka nɛ mbi binɔk bot. Bɛ nadi ekɛ ghooghoŋ ɛbat-bat pɛ kyee mɛdhik bɛsyɛ di ààbɛ nɛ mɛdhii ɛ, nɛ pɛ kɔ mɛtsok. Bɛ nadi edjedjaasi ɛ́ tɔ egho e mɛkok dɔɔ nɛ tɔ ebhik di tɔ bɔs ɛ.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Zɛɛb naamyaal bot binɔk djas kɔ ɛsu ɛ ɛdum ɛ koŋ ɛ lɔɔ nɛ nɛ. Bela náá, bɛ nabɛ ɛ́ ààbela sa Zɛɛb nakɛk ɛ. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Tin, nɛ tsɛɛtsɛ, ye nabɛ ɛ́, Zɛɛb naazekobal mena sa di ɛnyɔɛpe nɛ nena ɛ. Tin, Zɛɛb nakwyɛl ɛ́ náá, bɛ di bot ɛ zedjala ɔ sama wat nɛ nena.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Feŋ ɛ Zɛɛb dum nɛ bɔn bɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Yɛ kabɛ menabɛlka ɔɔ, menaka ɛ́ kuku bɛtɛ nɛ bɛtyaasɛs. Djhoodiska esa djas di esa náá, mena nàkɛka ɛnyɔɛpe ɛ, daŋ-daŋ ɛ mesyem mɛ mena di esesaka ngwyis ɛ. Tin, djhoopatka kaab di náá, mena waakaabka kɛkum pɛ ɛsik ɛ. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Mis mena goka ɛ́ nɛ ɛgwyák ɛ́ Yezu, nyɛy ɛ́ di esa náá, mena dika nɛ ɛdum ɛ koŋ nɛ Zɛɛb, nyɛy ɛ́ di baasa náá, ɛdum ɛ koŋ ɛ lena nɛ Zɛɛb kum di di edjala ɔ. Nyɛ naamyaal ɛgwyɛ kɔ mɛlaaba, ààgwak sen, etɛɛ náá, nyɛ nadi ɛ́ ebee mɛmyaala mɛ di ebwood nyɛ bhii tak ɛ. Nenak, nyɛ ɛ́ ndiindel pɛ mbɔ eghɛŋ bóó mɛkoozi Zɛɛb.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Taalaka nyɛ nɛ dáa nyɛ nazemaad swaka bot ɛ mesyem ɛ. Deenek, bi aanàbet náá, bi kwyeselaa, bi aanàbula pɛ bhis tɔ ɛdum ɛ koŋ nɛ Zɛɛb. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Etɛɛ náá, tuub bi di eduu nɛ syem ɛ, bi dinaa ààpaduu yɛ kɛmyaal náá, bi gwyɛ. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Bi eezedjisa mɛghaaz mɛ Zɛɛb di edjɛ bin dáa bɔn bɛ ɛ?</para>
  <para style="q1" vid="HEB 12:5">«Mɔn'am sa wɔ ààbyasal feŋ Ghɛŋ di ewa wɔ é tak ɛ,</para>
  <para style="q1" vid="HEB 12:5">é sok nyɛ di ewa wɔ é feŋ ɛ, sa wɔ ààbula bhis.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Etɛɛ náá, Ghɛŋ dyeebawa é feŋ ɛ́ mot nyɛ di ekwyɛl ɔ,</para>
  <para style="q1" vid="HEB 12:6">nyɛ dyeebamyak ɛ́, mot nyɛ di ebee nyɛ dáa mɔn'ɛ ɔ<note caller="*" style="x"><char style="xo" closed="false">12.6 </char><char style="xt" closed="false"><ref loc="PRO 3:11-12">Eka 3.11-12</ref></char></note>.»<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Maadka mezuk mɛ Zɛɛb di ezuk bin, é sok nyɛ di ewa bin é feŋ ɛ, nyɛ bee bin tin ɛ́ dáa bɔn bɛ. Yɛ ɛ́ nɛ mɔn di náá, sɛɛg ààwa nyɛ é feŋ é? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Yɛ bɛ náá, bi ààpawaaa é feŋ, dáa nyɛ di esa nɛ bɔn bɛ ɔɔ, é di'enek, ye lyaal ɛ́ náá, bi tok bɛtɛtɛ bɔn bɛ. Tin, ekwyɛl ɛlɛɛ ɛ́ náá, bi ɛ́ bɔn bel. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Djhoopookonɔɔka geka bɛsɛɛg bena kɔ ɛko ɛ bɔs. É ghɛŋ bɛ nadi ewa mena é feŋ ɛ, mena nadi egwak bɛ. Haaa, gwata nɛ Sɛɛg'enaka mot di pɛ tɔ gwoo ɔ, mena goka ɛ́ nɛ gwak nyɛ dhaa tyɛ, étɛp mena needika nɛ tsik. <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Deenek, bɛsɛɛg bena nadyeebawewa mena é feŋ ɛ, é ba mɔɔ pes ɛwala dáa elyem bɔɔ di ekwyɛl ɛ. Tin, Zɛɛb wa mena é feŋ ɛ, étɛp mɛvu mena met, etɛɛ náá, mena neebela di tɔ edɛɛ bɛ. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />É ghɛŋ mena di ewaaa é feŋ ɛ, yɛ ɛ́ nɛ menaka ɛ́ dáa ɛwala ɛ ghoŋ tɔ lyem, ààbɛ yii mɛmyaala. Bhii tak, bot ɛ nawaaa é kwaambi yenek mbi feŋ ɔ, bɛ aakadi ɛ́ bɛ moo bot ɛ epiki, nɛ bot ɛ egwyem.<verse eid="HEB 12:11" /></para>
  <para style="s">Mɛlyo nɛ ɛdulaa ɛ mɛlɔ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Sɛɛbka mɛmbɔ men zetsak ɛ, lyelka mɛboŋ men di epwak ɛ! <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Beta náá, mɛko men du mɛze mɛ di piki ɛ, etɛɛ náá, mɛko mɛ mot di nɛ djam ɔ, ɛ́ zɛkɛpiiza, tin, ye nyɔ ɛ́ ye tsak-tsakak.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Saka mɛghaaz mɛ ɛdi ɛ́ tɔ egwyem nɛ bot djas, nɛ ɛdi ɛ́ tɔ tsik na dɛɛ ɛ. Etɛɛ náá, yɛ di ààbɛ deenek ɔɔ, ye tok nɛ mot ngɔt aabee Ghɛŋ. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Bi ɛ́ koobaka, sa mot ààsaa náá, nyɛ su enɛm nɛ embɛɛ e Zɛɛb. Sa mot ngɔt pak'en ààdi dáa le di nɛ bhum na gwyee-gwyee ɛ, etɛɛ náá, nyɛ ɛ́ zɛkɛpul bɛtɛ nɛ bot pak'en nɛ mɛgwyee mɛ. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Sa mot ngɔt tɔ len ààsa mɛzɔ, sa mot ààbyasal esa e dɛɛ, dáa Ezau mot nagwyena etooba bɛ étɛp edee ɔ. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Biyɔ bɛmet nɛ gu náá, bhii tak, nyɛ nadi ɛ́ nɛ gwyes náá, sɛɛg sɛɛ nyɛ mɛtel. Tin, wɔ gwaa sɛɛg byen ɛsɛɛ nyɛ mɛtel. É di'enek, nyɛ nabɛ ɛ́ ààbela ghwyil ɛswoola lyem sɛɛg, ye nakoozodi mɛgwyɛ mɛ.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />É ghɛŋ bi nakunaa nɛ Zɛɛb ɛ, bi nabɛ ɛ́ ààtiila nɛ ɛtsok ɛ di náá, bot ɛ nɛ ghwyil ɛmɛt ɛ, ɛtsok ɛ Sinayi nɛ boo du'ɛ, nɛ ghooghom'ɛ, nɛ pum'ɛ, nɛ boo ghuu'ɛ, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />bɔn ɛ Yisalaɛl nabɛ ɛ́ bɛ eegwak lii tɔŋ, bɛ naagwak gwood tuud. É ghɛŋ bɛ nagwak yɛ ɛ, bɛ naabyen ɛbaagwak gwood tak. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Deenek, bɛ nabɛ ɛ́ ààbɛ nɛ ghwyil ɛmaad lwomel'enek: «Mot aazomɛt ɛtsok ɛlak ɔ, ye nakoozodi tit, nyɛ aagóaa ɛ́ nɛ mɛkok<note caller="*" style="x"><char style="xo" closed="false">12.20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">Ɛwy 19.12-13</ref></char></note>.» <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Kɔ ɛsu ɛ esa ee bɛ nadi ebee ɛ, wɔ gwaa, Moiiz zɛke náá: «Mɛ ɛpepwak, mɛ ɛpedyeebagwak bwoo<note caller="*" style="x"><char style="xo" closed="false">12.21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">Dɛt 9.19</ref></char></note>!»<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Tin, bi naakunaa nɛ ɛtsok ɛ Siyɔŋ, bi naakunaa nɛ ghaada Zɛɛb mot di nɛ tsik ɔ. Yɛ ɛ́ Ghaada Yeluzalɛm di pɛ tɔ gwoo ɛ, yɛ ɛ́ pɛ efofop bɛdhet nɛ bɛdhet di tɔ ɛbyoŋ ɛ. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Bi nabɛ ɛ́, bi naazekunaa nɛ dhiiti zɛɛga bot ɛ nadi tɔ ɛbyoŋ ɔ. Zɛɛga tak nabɛ ɛ́ yii bɔn mɛgwyak ɛ Zɛɛb, bot ɛ di náá, min mɔɔ moo ɛ́ ekwyala pɛ tɔ gwoo ɔ. Bi eezekunaa nɛ Zɛɛb, mot di nɛ ghwyil ɛpɛ́ɛ bot ɛ bhwak djas ɔ. Bi eezekunaa nɛ esisim e bot ɛ epiki di náá, bɛ eezedjala ɛ. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Bi nabɛ ɛ́, bi eezekunaa nɛ Yezu, mot di nduula-nduula ɛbhɛŋ ɛ na bes ɔ, nɛ ghiya yɛ nasee ɔ, ghiya tak ɛpetuud ɛlyelɛpe dhaa-dhaŋak ghiya ɛ Abhɛl.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Dika ndjem, sa bi ààbyen ɛgwak mot di elii nɛ nen ɔ. Bot ɛ nabyen ɛgwak ɛ mot nadi edul bɛ mɛlɔ kɔ bɔs ɔ, bɛ naaboma nɛ yɔbɔ feŋ. Ye kwyɛl ɛlɛɛ ɛ́ náá, dɔɔ nɛ menabɛlka pe, mena aanàdus é feŋ, mena aadi ààlooba nɛ mot di elii nɛ nena pɛ tɔ gwoo ɔɔ. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />É ghɛŋ sok, gwood'ɛ naasa náá, bɔs dheegel, nenak, nyɛ eekɛk mena náá: «Mɛ waabaadheeg bɔs dheega sis, dɔɔ nɛ gwoo<note caller="*" style="x"><char style="xo" closed="false">12.26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Ajh 2.6</ref></char></note>.» <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Mɛkpa mɛ di ekeaa wak náá: «dheega sis», kwyɛl ɛlɛɛ ɛ́ náá, esa ee nakusaa ɛ waadheegel dhaa tyɛ, bhii tak, yɛ ɛ́ diib, étɛp ɛdjɛ di nɛ esonok di náá, ye tok nɛ ghwyil ɛdheegel ɛ.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Djhoobulalka bhɔɔ nɛ Zɛɛb, etɛɛ náá, mena waabelaka ɛyoŋ ɛ di ààdheegel ɛ. Djhoolyaalka bhɔɔ tak tɔ ɛsa ɛ mɛsa mɛ Zɛɛb tyee wat di náá, lyem'ɛ waamyaala nɛ yɛ ɛ. Djhoosaka yɛ tɔ ɛkaab nɛ ɛlooba nɛ nɛ. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Etɛɛ náá, Zɛɛb'enaka ɛ́ du di edik esonok djas ɛ.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Mena aasaka dáa étɛp Zɛɛb neemyaala nɛ nena</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Gheekwyekwyɛlelka pak'en dáa bɛkɛl nɛ bɛdhem. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Sa mot ààdjisa ɛdjɛ bɛdjoŋ ɛ di ezyɛ pɛ daa len ɔ edi. Etɛɛ náá, é ɛsa deenek, bɛdhiiti bot naadjɛ efofop nazyɛ mɛdjoŋ pɛ daa lɔɔ edi, bɔɔ ààgu náá, bɛ nabɛ ɛ́ efofop. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Taalaka nɛ bot ɛ di tɔ membok ɔ, ɛkɛɛ biyɔ pe é membok bi nɛ bɛnɔɔ. Taalaka nɛ bot ɛ di tɔ mɛtiiga ɔ, etɛɛ náá, biyɔ pe ɛ́ bot nɛ mɛnyel nɛ epuud, di nɛ ghwyil tiigaa dáa bɔɔ ɛ.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Ye goka ɛ́ náá, bot djas duwal ɛba, tin ye baagoka ɛ́ náá, moma nɛ motom kɛ tɔ esosoob tɔ ɛba. Etɛɛ náá Zɛɛb ɛ waapɛ́ɛ bot ɛ mɛzɔ nɛ bot ɛ membyam.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Yɛ ààgoka náá, gwyes epata djɛɛd bin. Ye goka ɛ́ náá, bi myaala nɛ esa bi di nɛ yɛ ɛ, etɛɛ náá, Zɛɛb nyɛy ɛmet ke ɛ́ náá: «Ààbɛ, mɛ aanàkwaabet wɔ, mɛ aanàkwaapek wɔ<note caller="*" style="x"><char style="xo" closed="false">13.5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Dɛt 31.6</ref>,<ref loc="DEU 31:8">8</ref>; <ref loc="JOS 1:5">Zoz 1.5</ref></char></note>.» <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />É tɛp tak ɛ di náá, mena ɛ́ nɛ ghwyil ɛke nɛ ɛbwaalel djas náá:</para>
  <para style="q1" vid="HEB 13:6">«Ghɛŋ ɛ mot di ekwyee mɛ ɔ,</para>
  <para style="q1" vid="HEB 13:6">mɛ tok nɛ ghwyil ɛ di nɛ bwoo.</para>
  <para style="q1" vid="HEB 13:6">Mot aakosa mɛ yé<note caller="*" style="x"><char style="xo" closed="false">13.6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">Mɛd 118.6</ref></char></note>?»<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Taalaka nɛ bot ɛ nadi edjɛɛd bin ɔ, bot ɛ nagoola bin Mɛkpa ɛ Zɛɛb ɔ. Deenek, taalaka nɛ dáa bɛ nadi ekɛ ɛ, nɛ dáa bɛ nagwyɛ ɛ. Bi goka ɛ́ nɛ ɛbaŋa mbi ɛdum ɛ koŋ ɛ lɔɔ nɛ Zɛɛb bɛ nadi nɛ yɛ ɛ. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yezu Klisto ɛ́ tyee wat koko, mos, kɔm-kɔm sii nɛ kɔm.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Sa bi ààbet náá, mɛlyo mbɛs yii bot ɛ sis sa náá, bi wo ze. Ye nyɔ ɛ́ náá, enɛm nɛ embɛɛ e Zɛɛb djɛ mena mɛghaaz, ààkabɛ náá, ye di etsi e bot zesa dum nɛ edee mena di edɛka ɛ. Bot ɛ di edu mbi yenek etsi ɔ, bɛ aanàkobela vaŋ sonok.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Bɛghaa-Zɛɛb di esa mɛsa tɔ pɛt ɛbhɛŋ ɛ Zɛɛb ɔ, bɛ tok nɛ ghwyil ɛdɛ esa di ekaa kɔ mesa-ebuwa bina ɛ. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Boo ghaa-Zɛɛb dyeebatɔ́ pɛ tɔ Di na Dɛɛ ɛ nɛ ghiya bɛtit. Etɛɛ náá, nyɛ neeka yɛ buwa étɛp ɛpelak ɛ mesyem. Tin, epuud e bɛtit binek kawyisaa nɛ yɛ tɔ ghaada ɛ, kɛdikaa pɛ kel. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Dum nɛ tɛp tak ɛ, Yezu nadi ààgwyɛ tɔ ghaada, etɛɛ náá, nyɛ neegwyii bot nɛ ghiya yɛ met. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Djhoowyiska tɔ ghaada, kɛboma nɛ nɛ pɛ kel, etɛɛ náá, mena neekɛbomaka nɛ mbi mɛduka mɛ nyɛ nadukaa ɛ. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Etɛɛ náá, kɔ ɛko ɛ bɔs wak, mena tokeka nɛ ghaada di nɛ ghwyil ɛdi kɔm-kɔm sii nɛ kɔm ɛ. Mena saaka wak ɛ, ghaada di ezyɛ yenek. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Kɔ ɛsu ɛ Yezu, djhoogheekeka Zɛɛb ebuwa e mɛkpa mɛ di edjɛ nyɛ duu ɛ mɛlu djas, yɛ ɛ́ mɛdjeeb mɛ di elyaal náá, nyɛy ɛ́ Ghɛŋ ɛ. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Sa bi ààdjisa ɛsesa enɛm esa, nɛ ɛkwyekwyeel pak'en. Yenek ɛ́ ebuwa e Zɛɛb di emyaala nɛ yɛ ɛ.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Loobaka nɛ bɛdjɛɛdel bin, gwakeka bɛ. Etɛɛ náá, bɛ ɛpebaal bin mɛlu djas. Guka náá, bɛ waabookɛtaŋal é mis ɛ Zɛɛb kɔ ɛsu ɛ len. Tin, bi goka ɛ́ nɛ ɛsa náá, bɛ sa mɛsa mɔɔ ɛnyɔɛpe nɛ boo mɛmyaala, ààkabɛ náá, bɛ sa yɛ nɛ mɛnwyaad. Etɛɛ náá, bɛ sa yɛ nɛ mɛnwyaad ɔɔ, yɛ aanàkwaanyɔ nɛ nen.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Djaalaka étɛp'es! Bis ɛpegu tɔ elyem bis náá, elyem bis ɛ́ sɛŋ. Deenek, sa di nɛ nis ɛ, yɛ ɛ́ náá, mɛwala djas, bis ɛ́ tɔ ɛsɛɛga ɛdi nɛ embɛɛ mɛfulu. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Sa mɛ di ewaab nɛ nen daŋ-daŋ ɛ́ náá, djaalaka nɛ Zɛɛb náá, nyɛ sa náá, mɛ lel ɛbula pɛ daa len.<verse eid="HEB 13:19" /></para>
  <para style="s">Ɛkwosak ɛ mɛsik</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Zɛɛb ɛ́ ɛsuk ɛ egwyem, nyɛ naagomal Ghɛŋ'enaka Yezu pak myoŋ. Yezu moo mos ɛ́, boo djɛɛdel ebhata kɔ ɛsu ɛ ghiya yɛ, ghiya di ewa mena tɔ ɛbhɛŋ na kɔm-kɔm sii nɛ kɔm ɛ. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Beta náá, Zɛɛb tak wat djɛ bin ghwyil ɛsesa enɛm esa, étɛp bi neesa ɛkwosak ɛ lɛ. Tin, Zɛɛb sa nɛ nen sa lyem'ɛ di ekwyɛl ɛ, é ze ɛ Yezu Klisto, mot di egoka nɛ ɛdjɛaa duu kɔm-kɔm sii nɛ kɔm ɛ! <char style="sc">Amɛn</char>.<verse eid="HEB 13:21" /></para>
  <para style="s">Mɛkpa mɛ mɛsik nɛ mɛswosel</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Bɔn-nyɛɛg bam, mɛ waab nɛ nen ɛ́ náá: Gwakeka nɛ lyem wat mɛkpa mɛ di edjɛ mɛghaaz ɛ. Bela náá, mɛkana mɛ mɛ kwyal bin ɛ́, yɛ ààdyeebadjaa. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Mɛ kwyɛl ɛ́ bi gu náá, mɔn-nyɛɛg'ena Timote naazewyis tɔ membok. Nyɛ lel ɛkum wak ɔɔ, mɛ waazyɛ zɛbee bin, bis nɛ nɛ.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Swoska bɛdjɛɛdel bin djas, nɛ bot ɛ zedum koŋ nɛ Zɛɛb ɔ djas. Bɔn-nyɛɛg'enaka bot ɛ kyee dik Itali eeswos bin.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Beta náá, enɛm nɛ embɛɛ e Zɛɛb di nɛ biyɔ djas.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>