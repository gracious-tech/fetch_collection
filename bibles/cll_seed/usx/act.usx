<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">-Chala</book>
  <para style="h">Dɩtʋm</para>
  <para style="toc1">Kirisito Kpirida baa Dɩtʋm</para>
  <para style="toc2">Dɩtʋm</para>
  <para style="toc3">Dɩ</para>
  <para style="mt2">Kirisito Kpirida baa</para>
  <para style="mt1">Dɩtʋm</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Maŋ Luka maa sabɩɛ tanɛ gana maa fa bɩnɛ Tiyofilosi. Ma tanɛ gaa ma chɩŋkpɩɛ sabɩɛ lɩɩna ŋii Yesu fara wʋ a yɩɛ na wʋ kalaa ŋii kpiniŋ <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />mʋ gaa tala wɩɩ gaa Ɩsʋɔ mʋ ɩ ju Ɩsʋɔ adugbe. Pɔɩ na wʋ a ju Ɩsʋɔ adugbe na, wʋ pala na Ɩsʋɔ Feliŋ ŋii dʋɔ kalaa wʋ kpirida baa wʋ lɩsɛ na ŋii ba n yɩɛ. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Yesu awʋrʋfʋɔ wʋrʋgbɩɛ na, wʋ lɩsɛ wʋ wʋsɛ kalaa wʋ kpirida baa gbɩɛsɛ fɔɩ dʋɔ na ŋii kalaa gʋ wʋ chaɩ nkpa naŋ. Gʋ feŋ nkpa naŋ wʋrʋgbɩɛ na, wʋ lɩsɛ wʋ wʋsɛ kalaa ba wɩɛ ŋɩla (40), sɛ wʋ tawɩ Ɩsʋɔ Juori gaa wɩɛ. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Ga wɩɩ darɛ, gʋ wʋ na ba a di na, wʋ dʋ ba sɛ, &lt;&lt;N baa lɩɩ Yerusalem, ama n daa gafaasa gaa Majuo tawɩ si sɛ wʋ a fa amɩɛ, gaa ɩ nyii gʋ ma tawɩ ga wɩɛ na. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Akala takɩɛ Yohane mʋ lɩŋ bɛ sɔ bakpa, ama wɩɛ akalasa ŋarɛ wʋrʋgbɩɛ na, Ɩsʋɔ aja mʋ wʋ Feliŋ sɔ amɩɛ.&gt;&gt;<verse eid="ACT 1:5" /></para>
  <para style="s1">Yesu ju Ɩsʋɔ adugbe</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Gʋ Yesu na wʋ kpirida baa sɩla na, ba tasɛ ɩ sɛ, &lt;&lt;Kpaŋjuo, dɩtɩɛna nyaa ti bɔrɛ mʋ juori gaa fa Isiralitina yaa?&gt;&gt;<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Ŋɩ ba yɩɛ amɩɛ wɩɛ takɩɛ n jiŋ saŋa yaa wɩɩ gaa Juo wʋŋ mʋ wʋ tɩŋtɩŋ wʋ yikuo lɩsɛ si na a. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Ama Ɩsʋɔ Feliŋ kɔŋ amɩɛ dʋɔ na ɩɩ yu doŋ, na ɩ yɩɛ ma seriyatina Yerusalem, Yudiya na Samariya tibi kpiniŋ dʋɔ, na tibi dʋɔ gapɩlɛkʋma.&gt;&gt;<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Gʋ wʋ tawɩ ŋina taŋ na, Ɩsʋɔ mʋ ɩ ju Ɩsʋɔ adugbe yela baa kɩɛ ɩ sɛ Ɩsʋɔ tanɩɛ fu wʋ dʋɔ lɩɩ ba asa dʋɔ.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Gʋ baa kɩɛ Ɩsʋɔ tanɛ naŋ na dieli gʋ wʋ a ju na, gabʋanaŋ sɛ baala bala barɛ gaa sɩŋ ba jaŋ ba fuona abʋrɩ afʋlʋma. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Sɛ ba tasɛ ba sɛ, &lt;&lt;Galaliya baala, be n yɩɛ sɛ ɩ sɩmɩɛɩ jɩna ɩ kɩɛ adugbe? Yesu wʋdʋŋdʋlʋŋ wina wʋŋ ba mʋ ɩ lɩɩ amɩɛ jaŋ ju Ɩsʋɔ adugbe na, dɩmʋŋ sɛ wʋ a ti bɔrɛ kɔŋ ganaŋkʋ ɩ na ɩ wʋ a ju Ɩsʋɔ adugbe na.&gt;&gt;<verse eid="ACT 1:11" /></para>
  <para style="s1">Matiyasi sɩŋ Yudasi nafara naŋ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Sɛ kpirida baa bɔrɛ lɩɩ bʋrɔŋ bie garɛ gaa baa yagɛ ga sɛ Olifi Dasɛ bʋrɔŋ dʋɔ ju Yerusalem. Lɩɩ Yerusalem ju dɩmaŋ aja yɩɛ mayili salɛ. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Gʋ ba tala Yerusalem dɩɛ naŋ na, ba jiŋ abaŋsʋrʋ ju adugbe danɛ gaa ba cha ba chaɩ ga tɩba na naŋ. Baa ba wɩɛ dɩmaŋ na n nyina Petero, Yohane, Jamesi na Andurusi, Filipo na Tomasi, Batolomiyo na Matiyo, Yakubu wʋŋ wʋjuo n nyina Alifiyosi na Simoŋ wʋŋ wʋ kpi Sɩlɔtɩ dikpeŋ gaa dʋɔ na, na Yudasi Yakubu bu. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Ba kpiniŋ na ala barɛ na Yesu wʋnaa Mariya na wʋnabie baa jaŋi saŋa kʋma baa jɔ dɩga.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Dɩmʋŋ gɩyɩɛnɩŋ ŋina naŋ na, Petero kʋlʋ sɩŋ Kirisito lɩɛdɩra tɩba [lɩɛdɩra dikpeŋ gaa aja yɩɛ bakpa gafie garɛ na nkuo] <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />sɛ wʋ tawɩ sɛ, &lt;&lt;Ma dɔŋa Yudatina, ŋɩ tiri gʋ Ɩsʋɔ Sabɩɛwɩɛ ŋii a kɔŋ tɩba ŋii Ɩsʋɔ Feliŋ pala na Dawidi dʋɔ tawɩ lɩɩna Yudasi wʋŋ wʋ aaŋ ja wʋ a pala ba asanaŋ na baa chaŋ Yesu na. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Yudasi cha kpi daa dʋɔ sɛ daa na ɩ n yɩɛ dɩmʋŋ dɩtʋm gana.&gt;&gt;<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />[Yudasi lɩɛ tibi lɩɩ tɔnʋɔ gaa wʋ yu lɩɩ wʋ dɩsʋbʋ gaa wʋ yɩɛ na naŋ, diele gaa wʋ sala wʋ nyi dʋɔ sɛ wʋ patɩɛ sɛ wʋ luobie kpiniŋ lɩɩ sɛ wʋ sɩŋ. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Wʋkʋma wʋŋ wʋ wɩɛ Yerusalem nyii wɩɛ ŋina, dɩmʋŋ dʋɔ baa yagɛ dɩmʋŋ tibi gana ba dɩtawɩ naŋ sɛ Akelidama, ga tie n nyina sɛ Asima Tibi.]<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />Sɛ Petero ti tawɩ sɛ ba sabɩɛ numba tanɛ gaa naŋ sɛ,</para>
  <para style="q1" vid="ACT 1:20">&lt;&lt;Wʋ waa n bɩrɩŋsɛ dɩtakpaŋ;</para>
  <para style="q2" vid="ACT 1:20">wʋrʋ n baa cha ga tɩba&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">Num 69:25</ref>.</char></note></para>
  <para style="m" vid="ACT 1:20">Sɛ ba ti sabɩɛ sɛ,</para>
  <para style="q1" vid="ACT 1:20">&lt;&lt;N yela na wʋrʋ a sɩŋ wʋ nafara naŋ asanaŋtina dɩtʋm naŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 109:8">Num 109:8</ref>.</char></note><verse eid="ACT 1:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21" />Dɩmʋŋ dʋɔ ŋɩ tiri gʋ dɩ n lɩsɛ baala baa tɩba wʋrʋ na wʋ a kpi daa dʋɔ. Dɩ daga na baalɛ wʋŋ a yɩɛ wʋŋ daa na ɩ dɩ palɛ saŋa gaa Kpaŋjuo Yesu chaɩ daa jaŋ na, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />lɩɩ saŋa gaa Yohane sɔ bakpa Ɩsʋɔ sɔ mʋ gaa tala saŋa gaa ba mʋ Yesu lɩɩ daa jaŋ. Ŋɩ tiri gʋ dɩmʋŋ bakpa bana tɩba wʋrʋ a kpi daa dʋɔ na dɩɩ di Yesu feŋ lɩɩ sɩŋ naŋ dʋɔ seriya.<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Dɩmʋŋ dʋɔ ba lɩsɛ bakpa bala. Baa n nyina Yosefu wʋŋ baa yagɛ ɩ sɛ Basabasi [sɛ ba ti baa yagɛ ɩ sɛ Jositosi] na Matiyasi. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Sɛ ba jɔ dɩga sɛ, &lt;&lt;Kpaŋjuo nya jiŋ wʋkʋma wina digela naŋ. Kalaa daa baala bala bana tɩba wʋŋ nya lɩsɛ na <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />wʋ a gaa yɩɛ kpirida dɩtʋm gaa Yudasi yela si sɛ wʋ ju diele gaa wʋ daga na.&gt;&gt; <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Dɩmaŋ sɛ ba lɔ mbi, sɛ ba lɩsɛ Matiyasi. Dɩmʋŋ dʋɔ ba mʋ ɩ kpi kpirida gifi darɛ baa dʋɔ.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s1">Ɩsʋɔ Feliŋ ŋii kɔnɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Gʋ Yudatina asadi adiya ŋii baa yagɛ sɛ Pentikosi wɩɩ gaa talɛ na, Kirisito lɩɛdɩra baa kpiniŋ sɩla dikulie. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Gabʋanaŋ sɛ galaŋba takɩɛ feliŋ adoŋtina jɔ lɩɩ Ɩsʋɔ adugbe jʋʋ waa gaa ba chaɩ ga tɩba na kpiniŋ naŋ. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Sɛ ba na bʋrʋ garɛ takɩɛ bʋala nʋɔ-bisi kpara tɩba kɔŋ gaa cha ba wʋkʋma dʋɔ. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Sɛ Ɩsʋɔ Feliŋ ŋii su ba kpiniŋ sɛ ba fara baa tawɩ atawɩ ngoriŋ-ngoriŋ ganaŋkʋ Ɩsʋɔ Feliŋ ŋii fa ba sɛ ba n tawɩ na.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Saŋa gana naŋ na, Yudatina baa baa se Ɩsʋɔ sɛ ba lɩɩ dulunya naŋ gapɩlɛkʋma sɛ ba chaɩ Yerusalem na. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Gʋ ba nyii dɩmʋŋ galaŋba gana na, bakpa fɔɩ kɔŋ gaa jaŋi sɛ dɩ yɩɛ ba doba akala takɩɛ ba wʋkʋma nyii gʋ baa tawɩ wʋ tɩŋtɩŋ wʋ dɩtawɩ bɛ. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Sɛ dɩ yɩɛ ba doba fɔɩ sɛ ba tasɛ sɛ, &lt;&lt;Baala bana baa baa tawɩ n na kpiniŋ ba yɩɛ Galaliyatina bɛ yaa? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Na sɩnɛ sɛ daa wʋkʋma nyii gʋ baa tawɩ wʋ tɩŋtɩŋ wʋ dɩtawɩ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Daa tɩba barɛ yɩɛ Patiyatina, Midiyatina na Elamititina. Barɛ lɩɩ Mesopotamiya, Yudiya, Kapadokiya na Pontosi, Asiya, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Firigiya, Pamfiliya, Ijipiti na Libiya salɛ gaa ga tirina Kireni, na mʋɔra baa ba lɩɩ Roma na. <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Ba barɛ [yɩɛ Yudatina na baa ba bɩrɩŋsɛ gaa tʋŋ Yudatina tʋm na], Kiretitina na Arabiyatina. Dɩ nyii gʋ baa tawɩ Ɩsʋɔ mamachi wɩɛ daa tɩŋtɩŋ daa dɩtawɩ naŋ.&gt;&gt; <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Sɛ dɩ yɩɛ ba doba sɛ ba wuliti, sɛ ba tasɛ dɔŋa sɛ, &lt;&lt;Be sɛ ŋina tie a kalaa?&gt;&gt;<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />Ama barɛ jabi ba tawɩ sɛ, &lt;&lt;Ba nyʋɔ wayɩŋ sʋlʋŋ fɔɩ.&gt;&gt;<verse eid="ACT 2:13" /></para>
  <para style="s1">Petero wɩɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Sɛ Petero na kpirida gifi darɛ baa kʋlʋ sɩŋ, sɛ wʋ jiŋna wʋ lofu tawɩ fa jama baa sɛ, &lt;&lt;Ma dɔŋa Yudatina na wʋkʋma wʋŋ wʋ chaɩ Yerusalem na kpiniŋ, n nyii ŋii ma tawɩ na na dieli, n yela na maa lɩsɛ wɩɛ ŋii tie fa amɩɛ. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Baala bana n dɩɛsɛ ɛ takɩɛ ganaŋkʋ ɩ fa nfɩɛrɛ na. Ŋɩ yɩɛ nafo karafɩɛ saŋgʋ bɛ.&gt;&gt; <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Ama ŋii ŋɩ tibi na yɩɛ ŋii Ɩsʋɔ cha pala na Ɔja Joweli dʋɔ tawɩ si na bɛ sɛ,<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />&lt;&lt;Ɩsʋɔ tawɩ sɛ gɩyɩɛnɩŋ dɩtamtɩŋ na,</para>
  <para style="q2" vid="ACT 2:17">maa chɩɛgɩ ma Feliŋ wʋrʋgɩ bakpa kpiniŋ dʋɔ.</para>
  <para style="q1" vid="ACT 2:17">Amɩɛ bie bala jaŋ na ala jaŋ aja gbala,</para>
  <para style="q2" vid="ACT 2:17">amɩɛ yalaŋbie aja yu Ɩsʋɔ lɩsɛ kalaa,</para>
  <para style="q2" vid="ACT 2:17">amɩɛ bɩnɩɛ aja dosi.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Hali ma tʋmɩra bala jaŋ na ala jaŋ gba maa chɩɛgɩ ma Feliŋ wʋrʋgɩ ba dʋɔ gɩyɩɛnɩŋ ŋina naŋ,</para>
  <para style="q2" vid="ACT 2:18">na baa gbala.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Maa kalaa mamachi wɩɛ Ɩsʋɔ adugbe</para>
  <para style="q2" vid="ACT 2:19">na daasɛ tibi dʋɔ,</para>
  <para style="q2" vid="ACT 2:19">na maa kalaa asima, bʋala na nyɩŋfʋ asitasa.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Wiita aja bɩrɩŋsɛ giteŋteŋbiri,</para>
  <para style="q2" vid="ACT 2:20">na gafita a bɩrɩŋsɛ asima</para>
  <para style="q2" vid="ACT 2:20">pɔɩ na Kpaŋjuo jilima wɩɩ janɛ gaa a kɔŋ.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Na wʋkʋma wʋŋ wʋ yagɛ</para>
  <para style="q2" vid="ACT 2:21">Kpaŋjuo yɩrɛ na, aja yu mɔlɔgɩ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">Jo 2:28-32</ref>.</char></note><verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />Sɛ Petero ju dʋɔ tawɩ sɛ, &lt;&lt;Ma dɔŋa Isiralitina n nyii wɩɛ ŋina, Yesu Nasarati yɩɛ baalɛ wʋŋ Ɩsʋɔ lɩsɛ fa amɩɛ sɛ wʋ n yɩɛ adaŋgana, mamachi wɩɛ na daasɛ ŋii Ɩsʋɔ pala wʋ dʋɔ yɩɛ amɩɛ tɩba, takɩɛ ganaŋkʋ amɩɛ tɩŋtɩŋ ɩ jiŋ na. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Ɩsʋɔ wʋŋ wʋ fa ŋina gbɩɛsɛ nfɩɛrɛ sɛ wʋ fɩla wʋ jiŋ ŋina dʋɔ na, n lɩsɛ dɩmʋŋ baalɛ wina fa amɩɛ, sɛ ɩ yela sɛ bakpa sʋbʋɛ chɔna amɩɛ, sɛ ɩ jɔ ɩ daŋ gasagasa dʋɔ kʋ ɩ. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Ama Ɩsʋɔ feŋsi ɩ lɩɩ sɩŋ naŋ, sɛ wʋ lɩsɛ ɩ lɩɩ sɩŋ yowu naŋ, akala takɩɛ sɩŋ n dɩlɛ di wʋ dʋɔ ɔ.&gt;&gt; <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Sɛ Dawidi fɩla tawɩ Yesu wʋsɛ dʋɔ wɩɛ sɛ,</para>
  <para style="q1" vid="ACT 2:25">&lt;&lt;Saŋa kʋma maa na Ɩsʋɔ ma asanaŋ.</para>
  <para style="q2" vid="ACT 2:25">Akala takɩɛ wʋ wɩɛ ma pam jɩsaŋ dʋɔ,</para>
  <para style="q2" vid="ACT 2:25">ma aa jigisi i.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Dɩmʋŋ dʋɔ ma yu asadi fɔɩ, sɛ ma yu jʋŋ fɔɩ ma dɩtawɩ naŋ,</para>
  <para style="q2" vid="ACT 2:26">maŋ gba maa cha tamaa naŋ,<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />akala takɩɛ nya aa yela ma feliŋ dʋ atatina diele e,</para>
  <para style="q2" vid="ACT 2:27">yaa nyaa yela n dɩchɩrɩchɩrɩtɛ wʋŋ wʋsɛ a dara.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Nya yela sɛ ma jiŋ nkpa gbɩɛ;</para>
  <para style="q2" vid="ACT 2:28">nya yela sɛ ma yu asadi na dieli nya asanaŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">Num 16:8-11</ref>.</char></note><verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />Ma dɔŋa Yudatina, maa dɩlɛ jɔ ma digela naŋ tawɩ amɩɛ sɛ daa gɩnanaŋ Dawidi sɩŋ sɛ ba wuu ɩ sɛ wʋ bʋɔ duwei jɩna gaa tala jaŋ. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Ama wʋ cha wʋ yɩɛ Ɩsʋɔ Ɔja bɛ sɛ wʋ jiŋ gʋ Ɩsʋɔ ka ntaŋ tawɩ si fa Dawidi sɛ wʋ a mʋ wʋ gananabie wʋrʋ chasɛ wʋ juorigbeli dʋɔ. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Gʋ Dawidi jiŋ bʋrʋ gaa gaa kɔŋ na, wʋ tawɩ Kirisito feŋ lɩɩ sɩŋ naŋ dʋɔ wɩɛ takɩɛ ba n yela ɩ dʋ atatina diele ɩ yaa wʋ wʋsɛ n baa dara. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />Ɩsʋɔ feŋsi dɩmʋŋ Yesu wina kɔŋ nkpa naŋ sɛ daa kpiniŋ dɩ yɩɛ ŋɩ dʋɔ seriya dira gasiŋteŋ. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Sɛ Ɩsʋɔ jiŋna ɩ ju ga chasɛ wʋ pam jɩsaŋ dʋɔ sɛ Juo wʋŋ fa ɩ Feliŋ ganaŋkʋ wʋ tawɩ si na. Sɛ wʋ chɩɛgɩ ŋii ɩ na sɛ ɩ nyii dɩtɩɛna na wʋrʋgɩ. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Dawidi n ju Ɩsʋɔ adugbe e, ama wʋ tawɩ sɛ,</para>
  <para style="q1" vid="ACT 2:34">&lt;&lt;Ɩsʋɔ wʋŋ tawɩ fa ma Kpaŋjuo sɛ,</para>
  <para style="q2" vid="ACT 2:34">Cha ma pam jɩsaŋ dʋɔ,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />ga tala gʋ maa mʋ n badʋŋna mʋ yɩɛ n nafara dɩjagatɩŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Num 110:1</ref>.</char></note><verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ dʋɔ n yela na Isiralitina kpiniŋ a nyii na dieli sɛ, Ɩsʋɔ yɩɛ Yesu wina wʋŋ ɩ jɔ ɩ daŋ gasagasa dʋɔ na Kpaŋjuo na Kirisito.&gt;&gt;<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Gʋ bakpa baa nyii wɩɛ ŋina na, dɩ jʋʋ ba ba agela naŋ sɛ ba tasɛ Petero na kpirida ba baŋbaŋ baa sɛ, &lt;&lt;Ma dɔŋa Yudatina, be sɛ dɩɩ yɩɛ?&gt;&gt;<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Sɛ Petero lɩsɛ ba nʋɔ sɛ, &lt;&lt;N biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ na baa sɔ amɩɛ tɩba wʋkʋma Yesu Kirisito yɩrɛ naŋ na wʋ a mʋ amɩɛ dɩsʋbʋ chɩɛ amɩɛ na ɩ yu gafaasa gaa ga yɩɛ Ɩsʋɔ Feliŋ ŋii. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Ɩsʋɔ tawɩ si sɛ wʋ a fa amɩɛ na amɩɛ bie na baa ba wɩɛ taŋasɛ. Ŋɩ yɩɛ baa Kpaŋjuo daa Ɩsʋɔ aja yagɛ ba na kpiniŋ teri bɛ.&gt;&gt;<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Sɛ wʋ tawɩ wɩɛ fɔɩ jɔ ba nyienaŋ, sɛ wʋ sʋlʋ ba sɛ, &lt;&lt;N mɔlɔgɩ amɩɛ wʋsɛ lɩɩ gɩnanaŋ nyinaŋ doŋ gana naŋ.&gt;&gt; <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Dɩmʋŋ dʋɔ baa ba lɩɛ wʋ wɩɛ ŋii di sɛ ba sɔ ba sɛ ba gaa kpi lɩɛdɩra baa dʋɔ wɩɩ gana na, aja yɩɛ bakpa kɔrʋɔsɛ sɩ toro.<verse eid="ACT 2:41" /></para>
  <para style="s1">Lɩɛdɩra baa chawʋ naŋ ayɩɛsa</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />Sɛ ba mʋ ba wʋsɛ fa kpirida baa kalaa ŋii, bʋga yɩɛ garɛ, ba jaɩ bodobodo kpara sɛ ba jɔ dɩga. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />Sɛ wʋkʋma se ba lɩɩna mamachi wɩɛ na adaŋgana daasɛ fɔɩ ŋii Kpirida baa yɩɛ na dʋɔ. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Lɩɛdɩra baa kpiniŋ cha bʋga dikulie, sɛ ba bʋrʋkʋma cha ga yɩɛ ba kpiniŋ ba teri. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Sɛ baa yaa ba akpaŋta na ba abʋrɩ ba chamɩna aterembie ŋii baa fa wʋkʋma ganaŋkʋ dɩ cha tiri ɩ na. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Wɩɩ kʋma baa ju dʋɔ baa sɩla baa bʋga Ɩsʋɔ tʋm danɛ gaa naŋ. Baa jaɩ bodobodo ba wʋkʋma waasɛ dʋɔ sɛ baa mʋ asadi na digela fʋlʋŋsɛ baa di adiya, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />baa kalɩɛ Ɩsʋɔ, sɛ baa yu bakpa baa kpiniŋ asanaŋ Ɩsʋɔ wɩɩ. Sɛ Kpaŋjuo wʋŋ mʋ baa wʋ mɔlɔgɩ ba na kpi lɩɛdɩra baa dʋɔ gɩyɩɛ kʋma.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s1">Petero chɔ buobi sʋlʋdɛ wʋrʋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Ga wɩɩ darɛ gʋ dɩ tala dɩga jɔ saŋa na, Petero na Yohane cha baa ju Ɩsʋɔ tʋm danɛ naŋ. Ŋɩ yɩɛ wiita karafɩɛ atoro saŋa bɛ. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Saŋa gana naŋ na, ba sɩlɛ baalɛ wʋŋ ba lʋrʋ ɩ buobi kɔŋ Ɩsʋɔ tʋm danɛ buonɔ gaa baa yagɛ sɛ Dieli, diele gaa baa mʋ ɩ baa si wɩɩ kʋma yela wʋ a sʋlʋ bakpa baa baa kɔŋ Ɩsʋɔ tʋm danɛ gaa naŋ na aterembie. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Gʋ wʋ na Petero na Yohane aja baa jʋʋ na, wʋ sʋlʋ ba aterembie. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Sɛ Petero na Yohane ba kɩɛ ɩ na dieli, sɛ Petero tawɩ ɩ sɛ, &lt;&lt;Kɩɛ daa!&gt;&gt; <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Dɩmʋŋ dʋɔ baalɛ wʋŋ kɩɛ ba yela wʋ a kɩɛ gbɩɛ takɩɛ wʋ a yu bʋrʋ lɩɩ ba jaŋ.<verse eid="ACT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6" />Dɩmaŋ sɛ Petero tawɩ ɩ sɛ, &lt;&lt;Ma tana diterembi fʋlʋm yaa diterembi gasɩɛm m, ama maa fa nyaŋ bʋrʋ gaa ma wɩɛna. Yesu Kirisito Nasarati wʋkpa wʋŋ yɩrɛ naŋ, kʋlʋ pala.&gt;&gt; <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Sɛ Petero chaŋ wʋ jɩsaŋ pam naŋ chɔna ɩ sɛ wʋ kʋlʋ. Gabʋanaŋ sɛ baalɛ wʋŋ nafara na nafara akɔnaŋ yɩɛ doŋ. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Sɛ wʋ puli sɩŋ, sɛ wʋ fara wʋ a palɛ. Sɛ wʋ na ba jʋʋ Ɩsʋɔ tʋm danɛ gaa naŋ, wʋ dɔŋ, wʋ a puli yela wʋ a kalɩɛ Ɩsʋɔ. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Gʋ bakpa baa kpiniŋ na gʋ wʋ dɔŋ yela wʋ a kalɩɛ Ɩsʋɔ na, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />ba jiŋ gʋ wʋŋ n nyina baalɛ wʋdʋŋdʋlʋŋ wʋŋ nafʋɔ wʋ chaɩ Ɩsʋɔ tʋm danɛ buonɔ gaa baa yagɛ ga sɛ Dieli wʋ a sʋlʋ aterembie na. Ŋii ŋɩ tibi wʋ dʋɔ na yela sɛ dɩ yɩɛ ba mamachi na doba.<verse eid="ACT 3:10" /></para>
  <para style="s1">Petero dɩtawɩ Ɩsʋɔ tʋm danɛ naŋ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Gʋ sʋlʋdɛ wʋŋ chaŋ Petero na Yohane tɩba na, dɩ yɩɛ bakpa baa kpiniŋ doba sɛ ba se ju ba jaŋ diele gaa baa yagɛ sɛ Solomoŋ Diko naŋ. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Gʋ Petero na ŋina na, wʋ tawɩ ba sɛ, &lt;&lt;Ma dɔŋa Isiralitina, be n yɩɛ sɛ ŋina yɩɛ amɩɛ doba? Be n yɩɛ sɛ ɩɩ kɩɛ daa sɛ daa tɩŋtɩŋ daa doŋ yaa gʋ dɩɩ se Ɩsʋɔ na dʋɔ sɛ dɩ yela sɛ baalɛ wina kʋlʋ wʋ dɔŋ? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Abiraham, Isaki na Yakubu ba Ɩsʋɔ na daa duluŋ Ɩsʋɔ n fa wʋ tʋmɩrɛ Yesu jilima. Amɩɛ n mʋ ɩ fa sɛ ba n kʋ ɩ sɛ ɩ pɩɛ ɩ Pilato asanaŋ. Ŋɩ wɩɛ tɩba takɩɛ Pilato cha yɩɛ wʋ nfɩɛrɛ sɛ wʋ a yela ɩ. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Ɩ pɩɛ Dɩchɩrɩchɩrɩ na Wʋchirigisa Wʋŋ sɛ ɩ tasɛ sɛ ba n yela gatagapʋtɛ wʋŋ fa amɩɛ. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Sɛ ɩ kʋ wʋŋ wʋ a fa nkpa na, ama Ɩsʋɔ feŋsi ɩ kɔŋ nkpa naŋ. Dɩ yɩɛ ŋina dʋɔ seriyatina. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Yesu yɩrɛ naŋ lɩɛdi n yela sɛ baalɛ wina wʋŋ ɩ jiŋ ɩ, sɛ ɩ na ɩ n na yu doŋ. Yesu yɩrɛ naŋ na lɩɛdi gaa ga pala na wʋ dʋɔ kɔŋ n fa ɩ lʋm chʋɔ kʋrʋkʋrʋ takɩɛ ganaŋkʋ amɩɛ kpiniŋ ɩ na ɩ na.&gt;&gt;<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />Ma dɔŋa Yudatina, dɩtɩɛna ma na gʋ ɩ yɩɛ gɩbajɩŋ wɩɛ, dɩmʋŋ sɛ amɩɛ asanaŋtina gba yɩɛ. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Ama ŋina sɛ Ɩsʋɔ yela sɛ ŋii wʋ fɩla tawɩ si lɩɩna na wʋ bajana dʋɔ sɛ wʋ Kirisito aja na awʋrʋfʋɔ na, a kɔŋ tɩba. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Dɩmʋŋ dʋɔ n biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ na ɩ kɔŋ Ɩsʋɔ jaŋ na wʋ a mʋ amɩɛ dɩsʋbʋ chɩɛ amɩɛ. Dɩmʋŋ saŋa gana na, ɩɩ yu fɩɛsɛ lɩɩ Ɩsʋɔ jaŋ, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />na wʋ a kpiri Kirisito wʋŋ wʋ cha lɩsɛ ɩ fa amɩɛ na, wʋŋ n nyina Yesu. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Ŋɩ tiri gʋ wʋ a dʋɔ Ɩsʋɔ adugbe ga tala saŋa gaa Ɩsʋɔ aja desina bʋrʋkʋma si ga gbɩɛ dʋɔ takɩɛ ganaŋkʋ Ɩsʋɔ pala na wʋ bajana dɩchɩrɩchɩrɩ dʋɔ tawɩ si saŋa gaa ga lam na. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Akala takɩɛ Mosesi tawɩ sɛ, &lt;&lt;Kpaŋjuo amɩɛ Ɩsʋɔ wʋŋ aja lɩsɛ ɔja takɩɛ maŋ lɩɩ amɩɛ tɩŋtɩŋ amɩɛ bakpa naŋ. Ŋɩ tiri gʋ n nyii wɩɛ kʋma ŋii wʋ a tawɩ amɩɛ na. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Na wʋkʋma wʋŋ wʋ aa nyii wʋ jaŋ na, Ɩsʋɔ aja lɩsɛ ɩ lɩɩ wʋ bakpa naŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="DEU 18:15">Ditiro 18:15</ref>,<ref loc="DEU 18:18">18</ref>,<ref loc="DEU 18:19">19</ref>.</char></note><verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Gasiŋteŋ, Ɩsʋɔ bajana baa kpiniŋ lɩɩ Samuweli dʋɔ na baa ba kpaŋ ɩ na, ba fɔɩ baa ba cha tawɩ na, fɩla tawɩ si dɩmʋŋ gɩyɩɛnɩŋ ŋina dʋɔ wɩɛ. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Amɩɛ tɩŋtɩŋ ɩ yɩɛ Ɩsʋɔ bajana baa gananabisi bɛ na dɩkɔŋ gaa Ɩsʋɔ jʋɔ na daa duluŋ. Wʋ tawɩ Abiraham sɛ, &lt;Maa pala na n gananabisi dʋɔ yɩɛ tibi dʋɔ bakpa kpiniŋ kusee.&gt;<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">Jene 22:18</ref>; <ref loc="GEN 26:4">26:4</ref>.</char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Gʋ Ɩsʋɔ lɩsɛ wʋ tʋmɩrɛ na, wʋ chɩŋkpɩɛ kpiri ɩ amɩɛ jaŋ sɛ wʋ n gaa yɩɛ amɩɛ kusee wʋ a yela amɩɛ wʋkʋma a biliŋi lɩɩ wʋ dɩsʋbʋ gbɩɛsɛ naŋ.&gt;&gt;<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s1">Petero na Yohane sɩŋ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ asanaŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Sɛ Ɩsʋɔ seina, Ɩsʋɔ tʋm danɛ kɩɛrɛ bɩnɛ, na Sadukitina kɔŋ Petero na Yohane jaŋ gʋ ba saŋ baa tawɩ baa fa bakpa baa na. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Sɛ ba kara biŋbira fɔɩ akala takɩɛ kpirida baa a kalaa bakpa baa yela baa tawɩ sɛ gʋ Yesu feŋ lɩɩ sɩŋ naŋ dʋɔ, atatina gba aja feŋ kɔŋ nkpa naŋ. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Sɛ ba chaŋ Petero na Yohane gʋ ŋɩ yɩɛ bʋyanɔ na dʋɔ ba mʋ ba ga tɔ danɛ hali tɩɛna. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Ama ba fɔɩ baa ba nyii wɩɛ ŋii na lɩɛ di, sɛ baala baa nʋɔ yɩɛ bɔlɩŋ takɩɛ bakpa kɔrʋɔsɛ sɩ nʋŋ.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Gʋ tɩɛna na, Yudatina asanaŋtina, dɩɛ bɩnɩɛ na Mosesi mbara bakalaasa baa sɩla Yerusalem. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Baa ba sɩla dɩmaŋ na n nyina Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ Anasi, Kayifasi, Yohane, Alesanda na baala barɛ baa ba yɩɛ sei bɩnɩɛ naŋ bɩnɛ wʋŋ lʋŋtina. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Sɛ ba mʋ Petero na Yohane kɔŋ gaa sɩŋ ba asanaŋ sɛ ba fara baa tasɛ ba sɛ, &lt;&lt;Yikuo gamʋɔ yaa Yɩrɛ gamʋɔ naŋ sɛ ɩɩ yɩɛ ŋina?&gt;&gt;<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />Sɛ Petero wʋŋ Ɩsʋɔ Feliŋ su wʋ tɩba na tawɩ ba sɛ, &lt;&lt;Yudatina asanaŋtina na dɩɛ bɩnɩɛ! <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />Sɛ dɩbam gaa dɩ yɩɛ fa buobi wina dʋɔ sɛ ɩ yagɛ daa jaŋ ɩɩ tasɛ daa ganaŋkʋ wʋ yu lʋm chʋɔ na, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />dɩmʋŋ bɩrɛ amɩɛ na Isiralitina kpiniŋ n jiŋ ŋina takɩɛ ŋɩ yɩɛ Yesu Kirisito Nasarati wʋkpa wʋŋ ɩ jɔ ɩ daŋ gasagasa dʋɔ, sɛ Ɩsʋɔ feŋsi ɩ lɩɩ sɩŋ naŋ na yɩrɛ naŋ sɛ baalɛ wina wʋŋ wʋ sɩmɩɛɩ amɩɛ asanaŋ n na yu lʋm chʋɔ.&gt;&gt; <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Yesu wina n nyina</para>
  <para style="q1" vid="ACT 4:11">&lt;&lt;Bʋɩ gaa amɩɛ danɛ mara pɩɛ ga na,</para>
  <para style="q2" vid="ACT 4:11">gaa aaŋ ja gaa chaŋ danɛ gaa dɩkɔŋ naŋ na doŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Num 118:22</ref>.</char></note><verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Mɔlɔgɩ taŋ wʋrʋ tɩba a, akala takɩɛ yɩrɛ garɛ taŋ tibi gana dʋɔ sɛ ba mʋ ga fa bakpa sɛ ba n pala na ga dʋɔ na baa mɔlɔgɩ daa a.<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Gʋ ba na gʋ Petero na Yohane yu digela sɛ ba jiŋ gʋ ba n kpalɩɛna tanɛ ama ba yɩɛ bakpa bɛ dɩmʋŋ na, dɩ yɩɛ ba doba. Sɛ ba jiŋ gʋ baala bana cha kpaŋ Yesu. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Ama gʋ ba na baalɛ wʋŋ ba chɔ ɩ sɩmɩɛɩ ba jaŋ na, ba n dɩlɛ tawɩ bʋrʋ o. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Dɩmʋŋ dʋɔ ba dʋ sɛ ba n lɩɩ wɩɛ diri danɛ gaa naŋ sɛ ba tawɩ ba nyiŋeŋ-nyiŋeŋ. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Sɛ ba tasɛ dɔŋa sɛ, &lt;&lt;Sɩnɛ sɛ dɩɩ yɩɛ dɩmʋŋ baala bana? Wʋkʋma wʋŋ wʋ wɩɛ Yerusalem jiŋ gʋ ba yɩɛ adaŋgana ŋii ŋɩ goriei sɛ dɩ ɩɩ dɩlɛ pɩɛ ŋɛ ɛ. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Ama ganaŋkʋ wɩɛ ŋii ba aa yalagi bakpa naŋ na dʋɔ, dɩ daga na dɩɩ jɔ bakpa bana nyienaŋ sɛ ba n baa ti tawɩ dɩmʋŋ yɩrɛ gana wɩɛ fa wʋrʋ.&gt;&gt;<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Dɩmaŋ sɛ ba ti bɔrɛ yagɛ ba dʋ ba sɛ ba n baa ti tawɩ yaa kalaa Yesu yɩrɛ naŋ kpiniŋ-kpiniŋ. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Ama Petero na Yohane lɩsɛ ba nʋɔ sɛ, &lt;&lt;Amɩɛ tɩŋtɩŋ n fa nfɩɛrɛ ŋina dʋɔ takɩɛ ŋɩ wɩɛ dieli Ɩsʋɔ asanaŋ sɛ dɩ n nyii amɩɛ jaŋ yaa Ɩsʋɔ jaŋ? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Akala takɩɛ dɩ ɩɩ dɩlɛ yela bʋrʋ gaa dɩ na sɛ dɩ nyii dʋɔ wɩɛ dɩtawɩ ɩ.&gt;&gt;<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />Gʋ ba ŋaŋsɛ ba fɔɩ wʋrʋgbɩɛ na, ba yela ba sɛ ba lam. Ba n dɩlɛ fa nfɩɛrɛ yu gbɩɛ gaa baa sɩŋ dʋɔ fɔŋɩ ba dɩlɛ ɛ, akala takɩɛ bakpa baa kpiniŋ a kalɩɛ Ɩsʋɔ ŋii ŋɩ tibi na dʋɔ. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Baalɛ wʋŋ ba pala na adaŋgana gbɩɛ dʋɔ chɔ ɩ na kii bɩŋsɛ ŋɩla (40).<verse eid="ACT 4:22" /></para>
  <para style="s1">Lɩɛdɩra baa jɔ dɩga sʋlʋ digela doŋ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Gʋ ba yela Petero na Yohane na, ba bɔrɛ ju ba dɔŋa lɩɛdɩra baa jaŋ ga tawɩ ba bʋrʋkʋma gaa Ɩsʋɔ sei bɩnɩɛ na dɩɛ bɩnɩɛ tawɩ ba na kpiniŋ. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Gʋ ba nyii ŋina na, ba mʋ nʋɔ garɛ jɔ dɩga fa Ɩsʋɔ tawɩ sɛ, &lt;&lt;Kpaŋjuo Ɩsʋɔ, nyaŋ n lɔ Ɩsʋɔ adugbe na tie, ɔpʋ na ŋɩ tɩba bʋrʋkʋma. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Nya mʋna n Feliŋ ŋii dʋɔ yela sɛ daa duluŋ Dawidi, n tʋmɩrɛ gʋ wʋ tawɩ sɛ,</para>
  <para style="q1" vid="ACT 4:25">&lt;&lt;Be n yɩɛ sɛ atawɩ yɩrɩ a kara biŋbira?</para>
  <para style="q2" vid="ACT 4:25">Be n yɩɛ sɛ bakpa gbɩɛsɛ nfɩɛrɛ yɩɛ kpakpuo?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Tibi dʋɔ juoneŋ kʋlʋ sɩŋ kʋla ba wʋsɛ,</para>
  <para style="q2" vid="ACT 4:26">sɛ dɩɛ asanaŋtina sɩla bʋga</para>
  <para style="q1" vid="ACT 4:26">kʋlʋ sɩŋ Ɩsʋɔ</para>
  <para style="q2" vid="ACT 4:26">na wʋ Lɩsɛrɛ Wʋŋ dʋɔ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 2:1">Num 2:1</ref>,<ref loc="PSA 2:2">2</ref>.</char></note><verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />Gasiŋteŋ, Hɛrɔdɩ na Pontiyosi Pilato na baa ba ba yɩɛ Yudatina na Isiralitina baa ba wɩɛ dɩɛ janɛ gana naŋ sɩla sɛ ba kʋlʋ sɩŋ Yesu n tʋmɩrɛ dɩchɩrɩchɩrɩ wʋŋ nya lɩsɛ na dʋɔ. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Sɛ ba yɩɛ bʋrʋ gaa ga pala na n doŋ na n jawʋ naŋ ŋii nya cha fa ŋɩ dʋɔ nfɩɛrɛ takɩɛ ŋii tibi na. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Dɩtɩɛna Ɩsʋɔ, kɩɛ ba ŋaŋsɛ dʋɔ na nyaa yela n tʋmɩrɛ a dɩlɛ tawɩ n wɩɛ digela doŋ naŋ. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Tɩɛŋɩ n pam na nyaa pala na Yesu n tʋmɩrɛ dɩchɩrɩchɩrɩ wʋŋ yɩrɛ naŋ chɔ bakpa na nyaa yɩɛ adaŋgana daasɛ na mamachi wɩɛ.<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Gʋ ba jɔ dɩga taŋ na, diele gaa ba jaŋi na jigisi. Sɛ Ɩsʋɔ Feliŋ su ba kpiniŋ sɛ ba mʋ digela doŋ tawɩ Ɩsʋɔ wɩɛ.<verse eid="ACT 4:31" /></para>
  <para style="s1">Lɩɛdɩra baa kpara ba akpaŋta</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Lɩɛdɩra baa kpiniŋ yɩɛ bʋdʋŋdʋlʋŋ bɛ digela na nfɩɛrɛ naŋ. Ba wʋrʋ ba aa tawɩ sɛ wʋ tɩŋtɩŋ wʋ akpaŋta yɩɛ wʋ nyiŋeŋ wʋ teri i, ama baa kpara bʋrʋkʋma gaa ba wɩɛna. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Sɛ Kpirida baa mʋ doŋ ju dʋɔ di Kpaŋjuo Yesu feŋ lɩɩ sɩŋ naŋ dʋɔ seriya, sɛ Ɩsʋɔ wɩɩ wɩɛ ba kpiniŋ dʋɔ. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Wʋrʋ taŋ lɩɛdɩra baa tɩba sɛ bʋrʋ darɛ tiri i. Akala takɩɛ baa ba wɩɛna tibi yaa waasɛ na saŋa mʋ ju saŋa na baa yaa ŋɛ na baa mʋ aterembie ŋii kɔna <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />kpirida baa na baa kpara fa wʋkʋma ganaŋkʋ ŋɩ tiri ɩ na.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Sɛ Yosefu, Lewi wʋkpa wʋŋ wʋ lɩɩ Kipurosi, wʋŋ kpirida baa a yagɛ ɩ sɛ Banabasi [ga tie a kalaa sɛ Tawɩ dʋ wʋkpa] na, <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />yaa wʋ tibi gaa wʋ wɩɛna na, sɛ wʋ mʋ aterembie ŋii kɔna kpirida baa.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s1">Ananiyasi na Safira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Sɛ baalɛ wʋrʋ baa yagɛ ɩ sɛ Ananiyasi na wʋ alʋ Safira gba yaa ba tibi garɛ. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Ananiyasi alʋ gba jiŋ gʋ wʋ lɩsɛ aterembie ŋii ŋarɛ, sɛ wʋ mʋ ŋii ŋɩ kakaa na, kɔna kpirida baa.<verse eid="ACT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3" />Sɛ Petero tasɛ ɩ sɛ, &lt;&lt;Ananiyasi be n yɩɛ sɛ nya yela sɛ Sɩtanɩ su n digela sɛ nyaa yɩɛ akarɩɛ nyaa fa Ɩsʋɔ Feliŋ, sɛ nya lɩsɛ aterembie ŋii nya yaa n tibi na ŋarɛ? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Tibi gaa ba yɩɛ n teri bɛ pɔɩ sɛ nya yaa? Gʋ nya yaa wʋrʋgbɩɛ na, aterembie ŋii ba yɩɛ n teri bɛ? Be n yɩɛ sɛ nya fa nfɩɛrɛ sɛ nyaa yɩɛ ŋina? Nya n yɩɛ akarɩɛ fa wʋkpa a, ama Ɩsʋɔ.&gt;&gt;<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />Gʋ Ananiyasi nyii ŋina na, wʋ lɩɩ sala sɛ wʋ sɩŋ. Sɛ nyɩŋtɩɛ fɔɩ chaŋ baa ba nyii ŋii ŋɩ tibi na. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Sɛ yalaŋbie kɔŋ gaa mʋ dukuru pɔgʋ wʋ gɩtatɛ sɛ ba silɛ ɩ lɩɩ dɩmaŋ ga wuu.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Aja yɩɛ karafɩɛ atoro wʋrʋgbɩɛ na, wʋ alʋ jʋʋ kɔŋ, wʋ ba jiŋ bʋrʋ gaa ga tibi na a. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Sɛ Petero tasɛ ɩ sɛ, &lt;&lt;Tawɩ maŋ, ŋina n nyina aterembie ŋii nyaŋ na Ananiyasi ɩ yu lɩɩ tibi gaa dʋɔ?&gt;&gt;</para>
  <para style="p" vid="ACT 5:8">Sɛ wʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Ɛɛŋ, ga aterembie mɩnaŋ.&gt;&gt;<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Sɛ Petero tawɩ ɩ sɛ, &lt;&lt;Be n yɩɛ sɛ nyaŋ na ɩ kpa na ɩ yɩɛ Ɩsʋɔ Feliŋ ŋii lɔ tɩba? Kɩɛ, baa ba wuu n baalɛ na wɩɛ buonɔ, sɛ baa aaŋ ja baa sɩlɛ nyaŋ gba.&gt;&gt;<verse eid="ACT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10" />Gabʋanaŋ sɛ wʋ lɩɩ sala Petero asanaŋ sɛ wʋ sɩŋ. Gʋ yalaŋbie baa kɔŋ gaa na ɩ gʋ wʋ sɩŋ na, ba sɩlɛ wʋ gɩtatɛ lɩɩ dɩmaŋ mʋ ɩ ga wuu wʋ baalɛ jaŋ. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Sɛ nyɩŋtɩɛ fɔɩ chaŋ lɩɛdɩra dikpeŋ gaa na baa ba nyii wɩɛ ŋii na kpiniŋ.<verse eid="ACT 5:11" /></para>
  <para style="s1">Adaŋgana na mamachi wɩɛ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Sɛ kpirida baa yɩɛ adaŋgana daasɛ na mamachi fɔɩ bakpa baa tɩba. Sɛ lɩɛdɩra baa kpiniŋ cha baa sɩla baa bʋga Solomoŋ diko naŋ. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Ŋɩ wɩɛ tɩba takɩɛ bakpa baa tawɩ ba wʋsɛ dʋɔ wɩɛ abama bɩrɛ, ama wʋrʋ n dɩlɛ yu digela na wʋ a kpi ba dʋɔ ɔ. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Ama baala na ala fɔɩ lɩɛ Kpaŋjuo wʋŋ di, sɛ ba mʋ ba gaa kpi lɩɛdɩra baa dʋɔ. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Ŋina dʋɔ, bakpa kɔna lʋmɩɛtina dɩɛ naŋ gbɩɛsɛ bisi naŋ, sɛ ba duosi ba mpa na akalaŋ dʋɔ ganaŋkʋ Petero a lam na, na wʋ dikuiwu a sala ba barɛ dʋɔ. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Sɛ bakpa galaga baa ba lɩɩ dɩɛsɛ ŋii ŋɛ logo Yerusalem gba jaŋi, sɛ ba kɔna ba lʋmɩɛtina na baa feliŋ sʋbʋ a nyala ba, sɛ ba chɔ ba kpiniŋ.<verse eid="ACT 5:16" /></para>
  <para style="s1">Ba nyala kpirida baa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Sɛ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ na baa ba kpi wʋ dʋɔ sɛ ba yɩɛ Sadukitina dikpeŋ gaa dɩsɛchɛ kpirida baa dʋɔ. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Ba chaŋ kpirida baa sɛ ba mʋ ba tɔ danɛ. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Ama yuluma gana, Ɩsʋɔ gabʋɔ kɔŋ gaa tʋlʋ danɛ dɩtʋɔtɩŋ bʋɔlɩɛ ŋii sɛ wʋ lɩsɛ ba. <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;N pala ju ga sɩŋ Ɩsʋɔ tʋm danɛ gaa naŋ, na ɩ tawɩ nkpa gafɔlɛ gana dʋɔ wɩɛ ŋii kpiniŋ fa bakpa.&gt;&gt;<verse eid="ACT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21" />Gʋ tɩɛna na, ba jʋʋ Ɩsʋɔ tʋm danɛ naŋ sɛ ba fara baa kalaa bakpa takɩɛ ganaŋkʋ Ɩsʋɔ gabʋɔ wʋŋ cha tawɩ ba na.</para>
  <para style="p" vid="ACT 5:21">Gʋ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ wʋŋ na baa ba kpi wʋ dʋɔ gaa talɛ na, ba yagɛ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ baa ba yɩɛ Isirali bɩnɩɛ kpiniŋ gaa sɩla. Sɛ ba kpiri barɛ sɛ ba n ju danɛ dɩtʋɔtɩŋ gaa na baa ga lɩsɛ kpirida baa kɔŋ.<verse eid="ACT 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 5:22" />Ama gʋ gagbasɛ anyaŋnyaŋtina baa tala danɛ dɩtʋɔtɩŋ dɩmaŋ na, ba n na ba a. Dɩmʋŋ dʋɔ ba bɔrɛ gaa tawɩ bɩnɩɛ baa sɛ, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />&lt;&lt;Dɩ na gʋ ba tɔ danɛ dɩtʋɔtɩŋ gaa na dieli yela kɩɛra baa sɩmɩɛɩ bʋɔlɩɛ ŋii nʋɔ, ama gʋ dɩ tʋlʋ ŋɛ na, dɩ n na wʋrʋ ŋɩ tɩba a.&gt;&gt; <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Gʋ baa nyii wɩɛ ŋina na, Ɩsʋɔ tʋm danɛ kɩɛrɛ bɩnɛ wʋŋ na Ɩsʋɔ sei bɩnɩɛ baa wuliti, sɛ ba fa nfɩɛrɛ sɛ be wɩɛ n kɔŋ dɩmʋŋ.<verse eid="ACT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25" />Sɛ wʋrʋ kɔŋ gaa tawɩ ba sɛ, &lt;&lt;N kɩɛ, baala baa ɩ tɔ danɛ na, ba sɩmɩɛɩ Ɩsʋɔ tʋm danɛ naŋ baa kalaa bakpa baa.&gt;&gt; <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Sɛ kɩɛrɛ bɩnɛ wʋŋ na wʋ gagbasɛ anyaŋnyaŋtina barɛ ju ga mʋ kpirida baa kɔŋ. Ba n mʋ ba doŋ dʋɔ ɔ, akala takɩɛ baa se nyɩŋtɩɛ takɩɛ bakpa baa aja lɔ ba bʋɛ.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />Gʋ ba mʋ kpirida baa kɔŋ na, ba mʋ ba gaa sɩŋ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ baa asanaŋ, na Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ wʋŋ a tasɛ ba wɩɛ. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Dɩ dʋ amɩɛ na dieli sɛ n baa ti kalaa yɩrɛ gana naŋ. Ama ɩ kalaa-kalaa sɛ Yerusalem kpiniŋ nyii amɩɛ kalaa takɩɛ ɩɩ ja sɛ dɩɩ di baalɛ wina sɩŋ dʋɔ dɩpʋɛ.&gt;&gt;<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Sɛ Petero na kpirida ba baŋbaŋ baa lɩsɛ ba nʋɔ sɛ, &lt;&lt;Ŋɩ tiri gʋ dɩ n nyii Ɩsʋɔ jaŋ kii bakpa. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Daa duluŋ Ɩsʋɔ feŋsi Yesu wʋŋ ɩ jɔ ɩ daŋ gasagasa dʋɔ kʋ ɩ na lɩɩ sɩŋ naŋ. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Ɩsʋɔ jiŋna ɩ ju ga chasɛ wʋ tɩŋtɩŋ wʋ pam jɩsaŋ dʋɔ takɩɛ Asanaŋtɛ na Mɔlɔgɩrɛ ganaŋkʋ Isiralitina a biliŋi lɩɩ ba dɩsʋbʋ naŋ na wʋ a mʋ ba dɩsʋbʋ chɩɛ ba. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Daa na Ɩsʋɔ Feliŋ ŋii wʋŋ Ɩsʋɔ mʋ fa baa baa nyii wʋ wɩɛ na yɩɛ wɩɛ ŋina dʋɔ seriyatina bɛ.&gt;&gt;<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Gʋ ba nyii wɩɛ ŋina na, ba kara biŋbira baa ja baa kʋ ba. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Ama Farasi wʋkpa wʋrʋ wʋŋ baa yagɛ ɩ sɛ Gamali, wʋ yɩɛ Mosesi mbara wʋkalaasa bɛ sɛ bakpa baa kpiniŋ a mʋ jilima baa fa ɩ na, kʋlʋ sɩŋ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ baa tɩba tawɩ sɛ, ba n yela na baala baa a lɩɩ asʋŋ chonii. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Dɩmaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;Ma dɔŋa Isiralitina, n kɩɛ na dieli ŋii ɩ ja sɛ ɩ mʋ yɩɛ baala bana na dʋɔ. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Saŋa gaa ga lam na, Tiyodasi cha kɔŋ gaa tawɩ sɛ wʋ yɩɛ wʋkpa wʋjanɛ bɛ, sɛ bakpa aja yɩɛ takɩɛ gafisi sɩ nara (400) kpaŋ ɩ. Ba kʋ ɩ sɛ wʋ kpamɩra baa kpiniŋ puseŋ sɛ ŋɩ yɩɛ kpakpuo. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Wʋ wʋrʋgbɩɛ na, Yudasi wʋŋ wʋ yɩɛ Galaliya wʋkpa na kɔŋ bakpa kalɩŋ gɩyɩɛnɩŋ ŋii saŋa, sɛ wʋ yela sɛ bakpa kʋlʋ sɩŋ Romatina baa dʋɔ. Wʋŋ gba ba kʋ ɩ sɛ wʋ kpamɩra baa kpiniŋ puseŋ. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Dɩmʋŋ dʋɔ wɩɛ ŋii ŋɩ kɔŋ jaŋ na, maa tawɩ amɩɛ sɛ n yela baala bana nyiŋeŋ na baa pala. Akala takɩɛ ba gbɩɛsɛ nfɩɛrɛ yaa ba dɩtʋm lɩɩ wʋkpa jaŋ na, ŋii warɩɛ. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Ama sɛ ŋɩ lɩɩ Ɩsʋɔ jaŋ na, ɩ ɩɩ dɩlɛ gaa baala bana gbɩɛ ɛ. Ɩ na gʋ ɩɩ yuo na Ɩsʋɔ mɩnaŋ.&gt;&gt;<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />Sɛ ba lɩɛ wʋ nʋɔnaŋ dɩtawɩ gaa dʋ. Ba yagɛ kpirida baa jʋʋ kɔŋ sɛ ba taɩ ba achʋchʋɛ. Dɩmaŋ sɛ ba dʋ ba sɛ ba n baa ti tawɩ wɩɛ ŋarɛ Yesu yɩrɛ naŋ, sɛ ba yela ba sɛ ba lam.<verse eid="ACT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41" />Sɛ kpirida baa mʋ asadi lɩɩ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ baa asanaŋ, akala takɩɛ Yɩrɛ gaa dʋɔ ba kalaa ba takɩɛ ba daga awʋrʋfʋɔ asaju. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Wɩɩ kʋma ba dɔŋ Ɩsʋɔ tʋm danɛ naŋ na waasɛ dʋɔ. Sɛ ba ju dʋɔ kalaa yela baa jɔ Wɩɛ abama ŋii dʋɔ dawuta takɩɛ Yesu n nyina Kirisito wʋŋ.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s1">Chɔnara lɩkarɛ baa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Gɩyɩɛnɩŋ ŋina naŋ gʋ kpalɛnara baa a bɔlɛ na, Yudatina baa baa tawɩ Giriki dɩtawɩ sɛ ba wɩɛ ba tɩba na, a fʋlʋ baa baŋ Yudatina baa tɩŋtɩŋ akala takɩɛ ba pɩɛsɛ ba bakulapuna ala wɩɩ kʋma adiya ŋii baa kparɛ na. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Dɩmʋŋ dʋɔ gifi bala baa sɩla kpalɛnara baa kpiniŋ, sɛ ba tawɩ ba sɛ, &lt;&lt;Dɩ n daga na dɩɩ pɩɛ Ɩsʋɔ wɩɛ tawɩ na dɩɩ gaa kpara adiya a. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Dɩmʋŋ dʋɔ ma dɔŋa Isiralitina, n kɩɛ amɩɛ tɩba na ɩ lɩsɛ baala lɩkarɛ baa ɩ jiŋ gʋ baa tawɩ ba wʋsɛ dʋɔ wɩɛ abama, sɛ Ɩsʋɔ Feliŋ na kpiŋjim su ba tɩba na dɩɩ mʋ dɩmʋŋ dɩtʋm gana dʋ ba pamɩɛ naŋ, <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />sɛ daa bɩrɛ dɩɩ mʋ daa wʋsɛ fa dɩga jʋɔ na Ɩsʋɔ wɩɛ ŋii tawɩ.&gt;&gt;<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Sɛ dikpeŋ gaa kpiniŋ asadi ba wɩɛ ŋina dʋɔ. Sɛ ba lɩsɛ Sitifiŋ, baalɛ wʋŋ lɩɛdi na Ɩsʋɔ Feliŋ su wʋ tɩba, na Filipo, na Pokorosi, na Nikanɔ, na Timoŋ, na Pamenasi na Nikolasi wʋŋ wʋ lɩɩ Antiyokiya sɛ wʋ bɩrɩŋsɛ gaa tʋŋ Yudatina tʋm na. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Ba mʋ dɩmʋŋ bakpa bana ga sɩŋ kpirida baa asanaŋ, sɛ ba mʋ ba pamɩɛ jaga ba dʋɔ jɔ dɩga fa ba.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Dɩmʋŋ dʋɔ Ɩsʋɔ wɩɛ ŋii yalagi, sɛ kpalɛnara baa ba wɩɛ Yerusalem na bɔla fɔɩ, sɛ Ɩsʋɔ seina fɔɩ lɩɛ Yesu di.<verse eid="ACT 6:7" /></para>
  <para style="s1">Ba chaŋ Sitifiŋ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Sɛ Sitifiŋ wʋŋ Ɩsʋɔ wɩɩ na doŋ su wʋ tɩba na, yɩɛ mamachi janɛ na adaŋgana daasɛ bakpa baa tɩba. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Ama Yudatina tʋm danɛ naŋ bakpa baa barɛ baa ba yu ba wʋsɛ [takɩɛ ganaŋkʋ baa yagɛ ga na]. Baa n nyina Yudatina baa ba lɩɩ Kireni, Alesandiriya, Kilikiya na Asiya tibi dʋɔ na kpiniŋ kʋlʋ sɩŋ Sitifiŋ dʋɔ. Dɩmʋŋ bakpa bana fara baa di Sitifiŋ noro, <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />ama kpiŋjim na Ɩsʋɔ Feliŋ ŋii ŋɩ yela sɛ wʋ tawɩ wɩɛ na dʋɔ, ba n dɩlɛ di ɩ noro o.<verse eid="ACT 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11" />Sɛ ba wɩsɛ ga tawɩ bakpa barɛ sɛ ba n tawɩ sɛ, &lt;&lt;Dɩ nyii gʋ Sitifiŋ tawɩ mbusu wɩɛ wʋ a baŋ Mosesi na Ɩsʋɔ.&gt;&gt;<verse eid="ACT 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12" />Dɩmʋŋ dʋɔ ba fuosi dʋ bakpa baa, dɩɛ bɩnɩɛ baa na Mosesi mbara bakalaasa baa. Sɛ ba chaŋ Sitifiŋ mʋ ɩ kɔŋ gaa sɩŋ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Ba kɔna akarɩɛ seriyatina gaa di seriya sɛ, &lt;&lt;Baalɛ wina taŋ wʋ a yela mbusu wɩɛ tawɩ baŋ dɩmʋŋ chɩrɩchɩrɩ diele gana na Mosesi mbara ŋii i. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Sɛ dɩ ti nyii gʋ wʋ tawɩ sɛ dɩmʋŋ Yesu Nasarati wʋkpa wina aja salɩɛ Ɩsʋɔ tʋm danɛ na wʋ a biliŋi daa ayɩɛsa ŋii Mosesi mʋ fa daa na.&gt;&gt;<verse eid="ACT 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15" />Baa ba chaɩ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa tɩba na kpiniŋ kɩɛ Sitifiŋ na dieli, sɛ ba na gʋ wʋ asanaŋ kɩɛna takɩɛ Ɩsʋɔ gabʋɔ asanaŋ.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s1">Sitifiŋ dɩtawɩ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Sɛ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ wʋŋ tasɛ Sitifiŋ sɛ, &lt;&lt;Wɩɛ ŋii ba mʋ pʋɩ nyaŋ na yɩɛ Gasiŋteŋ?&gt;&gt;<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Sɛ wʋ lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Majuo aba na ma dɔŋa Isiralitina, n nyii ma jaŋ! Ɩsʋɔ jilima-tɛ wʋŋ lɩsɛ wʋ wʋsɛ kalaa daa duluŋ Abiraham gʋ wʋ saŋ wʋ wɩɛ Mesopotamiya tibi dʋɔ na, pɔɩ sɛ wʋ kʋlʋ gaa cha Haraŋ. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Ɩsʋɔ tawɩ ɩ sɛ, kʋlʋ lɩɩ n tibi dʋɔ na n lʋŋtina tɩba na nyaa ju tibi gaa maa kalaa nyaŋ na dʋɔ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1">Jene 12:1</ref>.</char></note><verse eid="ACT 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4" />Dɩmʋŋ dʋɔ wʋ lɩɩ Chalidiyatina tibi dʋɔ sɛ wʋ ga cha Haraŋ. Wʋjuo sɩŋ wʋrʋgbɩɛ na, sɛ Ɩsʋɔ yela sɛ wʋ ju ga cha tibi gana dʋɔ diele gaa ɩ chaɩ dɩtɩɛna na. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Ɩsʋɔ n mʋ tibi fa ɩ hali nafarɛ taŋtaŋ gba takɩɛ akpaŋta jɩna a. Ama Ɩsʋɔ tawɩ si sɛ tibi gaa aja yɩɛ wʋ na wʋ gananabisi baa baa kɔŋ wʋ wʋrʋgbɩɛ na teri bɛ. Ŋɩ wɩɛ tɩba takɩɛ dɩmʋŋ saga gana naŋ na, Abiraham tana bu u. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />N na sɛ Ɩsʋɔ tawɩ fa ɩ sɛ, &lt;&lt;N gananabisi aja yɩɛ mʋɔra wʋrʋ dɩɛ naŋ, baa yɩɛ ba gbeŋa na baa nyala ba bɩŋsɛ gafisi sɩ nara (400). <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Ama Ɩsʋɔ tawɩ sɛ maa fɔŋɩ bakpa baa baa tʋŋ ba takɩɛ gbeŋa na dɩla. Sɛ ŋina wʋrʋgbɩɛ na, baa lɩɩ dɩmʋŋ tibi gana dʋɔ na baa gaa tʋŋ maŋ jɩna gana.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="GEN 15:13">Jene 15:13</ref>,<ref loc="GEN 15:14">14</ref>.</char></note> <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Sɛ Ɩsʋɔ na Abiraham jɔ baŋlɛ karɩŋ dɩkɔŋ. Gʋ Abiraham lʋrʋ Isaki na, wʋ kara wʋ baŋlɛ wɩɛ jiŋinara wʋrʋgbɩɛ. Wʋrʋgbɩɛ na, Isaki lʋrʋ Yakubu sɛ Yakubu lʋrʋ daa duluŋ gifi bala baa.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />Daa duluŋ dɩsɛchɛ ba ŋmɩɛtɩ Yosefu dʋɔ, dɩmʋŋ dʋɔ ba yaa ɩ sɛ ba mʋ ɩ ju Ijipiti takɩɛ gbeŋi. Ama Ɩsʋɔ kpi wʋ dʋɔ <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />sɛ wʋ lɩsɛ ɩ lɩɩ wʋ awʋrʋfʋɔ kpiniŋ naŋ. Sɛ wʋ fa Yosefu kpiŋjim sɛ wʋ yela sɛ wʋ yu wʋ wɩɩ Ijipiti Juo Faro asanaŋ, dɩmʋŋ dʋɔ Juo Faro mʋ Ijipiti tibi kpiniŋ na wʋ juorigbɩɛ fa ɩ sɛ wʋ n di dʋɔ.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ saŋa gana na, dusoŋ janɛ kɔŋ Ijipiti na Kana tibi kpiniŋ dʋɔ, sɛ ŋɩ kɔna dusoŋ janɛ. Sɛ daa duluŋ n yu adiya a. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Gʋ Yakubu nyii gʋ adiya wɩɛ Ijipiti na, wʋ kpiri daa duluŋ kpiri ŋii ŋɩ dɔŋ asanaŋ. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Kpiri bʋlatɛ na, Yosefu tawɩ wʋ ŋmɩɛtina wʋŋ wʋ yɩɛ na, sɛ Faro nyii gʋ ba yɩɛ Yosefu wʋ lʋŋtina bɛ. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Ŋina wʋrʋgbɩɛ na, Yosefu kpiri ga mʋ wʋjuo Yakubu na wʋ lʋŋtina kpiniŋ kɔŋ, ba kpiniŋ ba yɩɛ ŋitoro sala na anʋŋ (75). <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Dɩmaŋ sɛ Yakubu ju Ijipiti, diele gaa wʋ na daa duluŋ cha sɩŋ na. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Sɛ ba mʋ ba gɩtatɛ bɔrɛ kɔŋ Sekem gaa wuu bʋɔ gaa Abiraham mʋ aterembie lɩɛ lɩɩ Hamɔ bie baala jaŋ Sekem dɩɛ naŋ na tɩba.&gt;&gt;<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />Sitifiŋ ti tawɩ sɛ, &lt;&lt;Gʋ saŋa tirina ŋii Ɩsʋɔ tawɩ si fa Abiraham a kɔŋ tɩba na, daa bakpa baa ba wɩɛ Ijipiti tibi dʋɔ na yɩɛ bɔlɩŋ fɔɩ. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Dɩmʋŋ saŋa gana sɛ Juo fɔlɛ wʋrʋ wʋŋ wʋ ba jiŋ bʋrʋ lɩɩ Yosefu dʋɔ na, kɔŋ gaa di juori Ijipiti tibi dʋɔ. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Sɛ wʋ mʋ dɩsɛ fulu pɩna daa bakpa sɛ wʋ nyala daa duluŋ, sɛ wʋ ŋɩrɛ ba sɛ ba n tʋsʋ ba bachaasɛ bafɔlɩɛ asʋŋ na baa sɩŋ.&gt;&gt;<verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Saŋa gana naŋ sɛ ba lʋrʋ Mosesi, wʋ yɩɛ wʋchaa wʋŋ wʋ wɩɛ dieli Ɩsʋɔ asanaŋ. Ba kɩɛ wʋ dʋɔ gafɩtasɛ sɩ toro wʋ juo waa dʋɔ. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Gʋ ba lɩsɛ ɩ yela ɩ asʋŋ na, Juo Faro bu alʋ jaŋ mʋ ɩ ga bɩsɛ takɩɛ wʋ tɩŋtɩŋ wʋbu. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Sɛ ba kalaa Mosesi Ijipitina kpiŋjim wɩɛ kpiniŋ, sɛ wʋ dɩtawɩ na wʋ ayɩɛsa wɩɛ dieli.&gt;&gt;<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Gʋ Mosesi di bɩŋsɛ ŋɩla na, wʋ yɩɛ wʋ n nfɩɛrɛ sɛ wʋ a bʋɔ wʋ dɔŋa Isiralitina dʋɔ. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Gʋ wʋ tala dɩmaŋ na, wʋ na gʋ Ijipiti wʋkpa a tugu Isirali wʋkpa. Dɩmʋŋ dʋɔ wʋ ju ga chɔna ɩ sɛ wʋ kʋ Ijipiti wʋkpa wʋŋ tɔ kɩm. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Mosesi nfɩɛrɛ n nyina sɛ wʋ bakpa aja jiŋ gʋ Ɩsʋɔ aja pala wʋ dʋɔ mɔlɔgɩ ba, ama ba n jiŋ dɩmʋŋ ŋ. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Gʋ tɩɛna na, Mosesi na gʋ Isiralitina baala barɛ a yuo, sɛ wʋ chɩdɩsɛ wʋ a jɔ ba bʋga sɛ wʋ tawɩ ba sɛ baala, ɩ yɩɛ bakpa badʋŋdʋlʋŋ bɛ, be n yɩɛ sɛ ɩɩ pera dɔŋa?&gt;&gt;<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />Ama baalɛ wʋŋ wʋ pera wʋ dʋɔ na ti Mosesi si laraŋ tawɩ sɛ, &lt;&lt;Mmʋɔ n lɩsɛ nyaŋ daa asanaŋtɛ na wɩɛ diri? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Nyaa ja sɛ nyaa kʋ maŋ takɩɛ ganaŋkʋ daŋda n kʋ Ijipiti wʋkpa wʋŋ naa?&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="EXO 2:14">Ɛsa 2:14</ref>.</char></note> <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Gʋ Mosesi nyii dɩmʋŋ wɩɛ ŋina na, wʋ se ju Midiyaŋ tibi dʋɔ, dɩmaŋ sɛ wʋ ga cha takɩɛ mʋɔrɛ, sɛ wʋ lʋrʋ bie baala jaŋ bala.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Bɩŋsɛ ŋɩla wʋrʋgbɩɛ na, Ɩsʋɔ gabʋɔ lɩsɛ wʋ wʋsɛ kalaa ɩ bʋala gaa gaa chaŋ dɩpʋnfa na nʋɔbɩsɩ naŋ ifuli dʋɔ tirina Sina Bʋrɔŋ. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Gʋ wʋ na ŋina na, dɩ yɩɛ ɩ doba. Gʋ wʋ tirina na wʋ a kɩɛ na dieli na, wʋ nyii Ɩsʋɔ lofu tawɩ sɛ, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />Maŋ n nyina amɩɛ duluŋ Ɩsʋɔ, Abiraham, Isaki na Yakubu Ɩsʋɔ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Ɛsa 3:6</ref>.</char></note> Sɛ nyɩŋtɩɛ chaŋ Mosesi yela wʋ a selesi sɛ wʋ n dɩlɛ kɩɛ ɛ.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />Dɩmaŋ sɛ Ɩsʋɔ tawɩ ɩ sɛ, &lt;&lt;Lɩsɛ nya asibita akala takɩɛ diele gaa n sɩmɩɛɩ na yɩɛ tibi chɩrɩchɩrɩ bɛ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Gasiŋteŋ ma na ganaŋkʋ baa nyala ma bakpa Ijipiti. Sɛ ma nyii ba kiŋii sɛ ma tibi kɔŋ maa gaa mɔlɔgɩ ba. Dɩtɩɛna kɔŋ, maa kpiri nyaŋ na nyaa bɔrɛ ju Ijipiti.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:34 </char><char style="xt" closed="false"><ref loc="EXO 3:5">Ɛsa 3:5</ref>,<ref loc="EXO 3:7">7</ref>,<ref loc="EXO 3:8">8</ref>,<ref loc="EXO 3:10">10</ref>.</char></note><verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />Sɛ Sitifiŋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ Mosesi wʋdʋŋdʋlʋŋ wina wʋŋ ba pɩɛ ɩ tawɩ sɛ Mmʋɔ n yɩɛ nyaŋ asanaŋtɛ na wɩɛ diri?&gt;&gt; Ɩsʋɔ tɩŋtɩŋ pala na wʋ gabʋɔ dʋɔ lɩsɛ wʋ wʋsɛ kalaa ɩ dɩpʋnfa gaa naŋ. Wʋŋ n kpiri ɩ sɛ wʋ n yɩɛ ba asanaŋtɛ na Mɔlɔgɩrɛ. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Wʋ pala ba asanaŋ lɩsɛ ba lɩɩ Ijipiti tibi dʋɔ, sɛ wʋ yɩɛ mamachi na adaŋgana daasɛ Ijipiti Ɔpʋ Gasem<note caller="+" style="f"><char style="fr" closed="false">7:36 </char><char style="ft" closed="false">Gaa baa yagɛ sɛ ŋmɩrɛ Ɔpʋ</char></note> gaa jaŋ na bɩŋsɛ ŋɩla ifuli dʋɔ.<verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Dɩmʋŋ Mosesi wina n tawɩ Isiralitina sɛ Ɩsʋɔ aja lɩsɛ Ɩsʋɔ ɔja takɩɛ maŋ lɩɩ amɩɛ tɩŋtɩŋ amɩɛ bakpa naŋ. <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Mosesi cha kpi Isiralitina baa ba jaŋi ifuli dʋɔ na dʋɔ, wʋ kpi daa duluŋ na Ɩsʋɔ gabʋɔ wʋŋ wʋ cha tawɩ fa ɩ Sina Bʋrɔŋ gaa dʋɔ na dʋɔ dɩmaŋ. Sɛ wʋ yu nkpa wɩɛ ŋii wʋ mʋ fa daa na.&gt;&gt;<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Ama daa duluŋ n nyii wʋ jaŋ ŋ sɛ ba pɩɛ ɩ, sɛ ba yɩɛ ba nfɩɛrɛ takɩɛ ba yu na, baa bɔrɛ ju Ijipiti. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Sɛ ba tawɩ Arɔŋ sɛ yɩɛ panɩŋ fa daa baa baa pala daa asanaŋ. Dɩmʋŋ Mosesi wina wʋŋ wʋ lɩsɛ daa lɩɩ Ijipiti na, dɩ ba jiŋ bʋrʋ gaa ga tibi wʋ dʋɔ ɔ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">Ɛsa 32:1</ref>.</char></note> <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Dɩmʋŋ saŋa gana sɛ ba yɩɛ panɛ takɩɛ naa baalie. Sɛ ba mʋ gadiesa kɔna ga, sɛ ba di ba asa lɩɩ bʋrʋ gaa ba mʋ ba pamɩɛ yɩɛ na dʋɔ. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Ama Ɩsʋɔ lɩsɛ wʋ asa lɩɩ ba dʋɔ sɛ wʋ mʋ ba fa sɛ ba n tʋŋ wiita, gafita na gachikpebisɛ. Takɩɛ ganaŋkʋ ba cha sabɩɛ dʋ Ɩsʋɔ bajana tanɩɛ naŋ sɛ,</para>
  <para style="q1" vid="ACT 7:42">&lt;&lt;O Isiralitina, ɩ kɔna maŋ gadiesa na faa ifuli dʋɔ</para>
  <para style="q2" vid="ACT 7:42">bɩŋsɛ ŋɩla bɛ?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Ɩ sɩlɛ Moleki panɛ danɛ</para>
  <para style="q2" vid="ACT 7:43">na amɩɛ panɛ Refaŋ gachikpebi,</para>
  <para style="q2" vid="ACT 7:43">panɩŋ ŋii ɩ yɩɛ na ɩ tʋŋ.</para>
  <para style="q1" vid="ACT 7:43">Dɩmʋŋ dʋɔ maa yela na baa yuo chaŋ amɩɛ mʋ ju ga chasɛ wʋrʋ tibi dʋɔ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:43 </char><char style="xt" closed="false"><ref loc="AMO 5:25">Amo 5:25</ref>.</char></note> Babiloŋ wʋrʋgbɩɛ.<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Daa duluŋ cha ba wɩɛna Seriya dukuru diko ba jaŋ ifuli dʋɔ. Ba yɩɛ ga bɛ takɩɛ ganaŋkʋ Ɩsʋɔ cha tawɩ Mosesi sɛ wʋ n yɩɛ na. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Daa duluŋ cha yu dukuru diko gaa lɩɩ ba duluŋ jaŋ bɛ. Yosuwa saŋa na, ba mʋ ga kɔŋ tibi gaa Ɩsʋɔ geŋ atawɩ yɩrɩ lɩɩ ga dʋɔ sɛ wʋ mʋ fa ba na dʋɔ. Sɛ ga dʋɔ tibi gaa dʋɔ ga tala Dawidi saŋa, <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />wʋŋ wʋ yu Ɩsʋɔ wɩɩ na, sʋlʋ Ɩsʋɔ sɛ wʋ n yela na wʋ a ma Ɩsʋɔ tʋm danɛ fa Yakubu Ɩsʋɔ.<note caller="+" style="f"><char style="fr" closed="false">7:46 </char><char style="ft" closed="false">Ɩsʋɔ Sabɩɛwɩɛ ŋarɛ wɩɛna Yakubu danɛ.</char></note> <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Ama Solomoŋ n nyina wʋŋ wʋ cha ma Ɩsʋɔ waa gaa fa ɩ.&gt;&gt;<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />Sɛ Sitifiŋ ju dʋɔ tawɩ sɛ, &lt;&lt;Ama Ɩsʋɔ Wʋjanɛ wʋŋ ba aa cha waasɛ ŋii wʋkpa ma ŋɛ na tɩba a. Takɩɛ ganaŋkʋ Ɩsʋɔ ɔja tawɩ sɛ,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />&lt;&lt;Ɩsʋɔ tawɩ sɛ</para>
  <para style="q2" vid="ACT 7:49">Ɩsʋɔ Adugbe n nyina ma juorigbeli,</para>
  <para style="q1" vid="ACT 7:49">sɛ tibi n nyina ma nafara dɩjagatɩŋ.</para>
  <para style="q4" vid="ACT 7:49">Waa gamʋɔ duluŋ sɛ nyaa ma fa maŋ?</para>
  <para style="q2" vid="ACT 7:49">yaa le aaŋ ja yɩɛ ma dɩfɩɛsɛtɩŋ?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Naa ma pamɩɛ n yɩɛ abʋrɩ ŋina kpiniŋ?&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Yis 66:1</ref>,<ref loc="ISA 66:2">2</ref>.</char></note><verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Amɩɛ dɩla naŋ doŋtina, ɩ pɩɛ Ɩsʋɔ wɩɛ amɩɛ agela naŋ sɛ ɩ tɔ amɩɛ dɩla fa Ɩsʋɔ wɩɛ ŋii. Saŋa kʋma ɩ kʋlʋ ɩ sɩŋ Ɩsʋɔ Feliŋ ŋii dʋɔ, amɩɛ gba ɩ kɩɛna bɛ takɩɛ amɩɛ duluŋ. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Ɩsʋɔ ɔja wʋ Mmʋɔ n cha sɛ amɩɛ duluŋ n cha nyala ɩ? Ba kʋ Ɩsʋɔ bajana baa ba cha gbala Wʋchirigisa Wʋŋ wʋ a kɔnɛ na wɩɛ gba. Sɛ dɩtɩɛna ɩ lɩsɛ ɩ fa sɛ ɩ kʋ ɩ. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Ɩ yu mbara ŋii Ɩsʋɔ pala na wʋ gabʋɔsɛ dʋɔ mʋ fa amɩɛ na, ama ɩŋ kpaŋ ŋɩ dʋɔ ɔ.&gt;&gt;<verse eid="ACT 7:53" /></para>
  <para style="s1">Ba lɔ Sitifiŋ bʋɛ kʋ ɩ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Gʋ Yudatina bɩnɩɛ baa nyii wɩɛ ŋina na, ba kara biŋbira na dieli dʋ ɩ sɛ ba tawʋ ba kela naŋ dʋ ɩ. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Ama Sitifiŋ wʋŋ Ɩsʋɔ Feliŋ su wʋ tɩba na, kɩɛ Ɩsʋɔ adugbe sɛ wʋ na Ɩsʋɔ jilima yela Yesu sɩmɩɛɩ Ɩsʋɔ pam jɩsaŋ dʋɔ. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Sɛ Sitifiŋ tawɩ sɛ, &lt;&lt;Kɩɛ, ma na gʋ Ɩsʋɔ adugbe fulu yela Wʋkpa Bu wʋŋ sɩmɩɛɩ Ɩsʋɔ pam jɩsaŋ dʋɔ.&gt;&gt;<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Gʋ ba nyii wɩɛ ŋina na, ba tɔ ba dɩla sɛ ba kuusi na doŋ, sɛ ba kpiniŋ ba se gaa fu wʋ dʋɔ, <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />fɔŋɩ ɩ lɩɩ dɩɛ janɛ gaa naŋ sɛ ba fara baa lɔ ɩ bʋɛ. Sɛ baa baa lɔ ɩ bʋɛ na, mʋ ba gagbasɛ si yeleŋbu wʋŋ baa yagɛ ɩ sɛ Sɔɔlʋ na asanaŋ.<verse eid="ACT 7:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59" />Gʋ ba cha baa lɔ Sitifiŋ bʋɛ na, wʋ jɔ dɩga sɛ, &lt;&lt;Kpaŋjuo Yesu lɩɛ ma sʋbʋ.&gt;&gt; <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Sɛ wʋ laŋ luuŋ wʋ dʋna dʋɔ sɛ wʋ kuusi sɛ, &lt;&lt;Kpaŋjuo Yesu mʋ dɩsʋbʋ gaa baa yɩɛ n na chɩɛ ba.&gt;&gt; Gʋ wʋ tawɩ dɩmʋŋ na, sɛ wʋ sɩŋ.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Na Sɔɔlʋ wɩɛ dɩmaŋ sɛ wʋ kpa gʋ ba n kʋ Sitifiŋ.</para>
  <para style="p" vid="ACT 8:1">Dɩmʋŋ wɩɩ gana ba nyala lɩɛdɩra dikpeŋ gaa ga wɩɛ Yerusalem na fɔɩ sɛ ba kpiniŋ puseŋ jʋʋ Yudiya na Samariya tibi dʋɔ sɛ dɩkaka kpirida baa nyiŋeŋ.<verse eid="ACT 8:1" /></para>
  <para style="s1">Sɔɔlʋ nyala Kirisito lɩɛdɩra dikpeŋ gaa</para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 8:2" />Sɛ bakpa barɛ baa baa se Ɩsʋɔ na wuu Sitifiŋ sɛ ba wii na doŋ fa ɩ. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Ama Sɔɔlʋ fara wʋ a nyala lɩɛdɩra dikpeŋ gaa yela wʋ dɔŋ waasɛ dʋɔ wʋ a fɔŋɩ lɩɛdɩra baala na ala wʋ a tɔ ba danɛ.<verse eid="ACT 8:3" /></para>
  <para style="s1">Filipo tawɩ Ɩsʋɔ wɩɛ Samariya tibi dʋɔ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Lɩɛdɩra baa ba puseŋ na, tawɩ Ɩsʋɔ wɩɛ abama gapɩlɛkʋma gaa ba ju na. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Sɛ Filipo ju Samariya dɩɛ janɛ garɛ naŋ ga tawɩ Kirisito<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Kirisito n nyina Mesaya.</char></note> wʋsɛ dʋɔ wɩɛ dɩmaŋ. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Gʋ jama baa nyii Filipo dʋɔ, sɛ ba na adaŋgana daasɛ ŋii wʋ yɩɛ na, ba kpiniŋ ba kaŋ dɩla baa nyii ŋii wʋ tawɩ na. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Sɛ feliŋ sʋbʋ kuusi na doŋ lɩɩ bakpa fɔɩ tɩba sɛ buobi aba na baa ba jaɩ-jaɩ na fɔɩ yu lʋm chʋɔ. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Dɩmʋŋ dʋɔ asadi fɔɩ kɔŋ dɩɛ janɛ gaa naŋ.<verse eid="ACT 8:8" /></para>
  <para style="s1">Simoŋ majigi-tɛ wʋŋ</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Baalɛ wʋrʋ wʋŋ baa yagɛ ɩ sɛ Simoŋ wɩɛ Samariya dɩɛ naŋ. Aja yɩɛ takɩɛ saŋa garɛ mɩnaŋ, wʋ mʋ wʋ majigi yɩɛ adaŋgana dɩɛ janɛ gaa naŋ mʋ yɩɛ Samariyatina baa kpiniŋ mamachi. Wʋ a jiŋna wʋ wʋsɛ adugbe sɛ wʋ yɩɛ wʋkpa wʋjanɛ bɛ, <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />sɛ bakpa kpari na baa ba tana charɛ na kpiniŋ kaŋ dɩla nyii wʋ jaŋ. Sɛ ba tawɩ sɛ, &lt;&lt;Baalɛ wina n nyina Ɩsʋɔ doŋ gaa baa yagɛ sɛ Doŋ Gajanɛ gaa.&gt;&gt; <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Ba kpaŋ ɩ akala takɩɛ wʋ mʋ wʋ majigi yɩɛ ba mamachi taŋgɩlɛ. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Ama gʋ ba lɩɛ Ɩsʋɔ Wɩɛ Abama ŋii Filipo tawɩ lɩɩna Ɩsʋɔ juori gaa dʋɔ na Yesu Kirisito yɩrɛ gaa di na, wʋ sɔ baala na ala. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Simoŋ tɩŋtɩŋ lɩɛ di sɛ wʋ sɔ ɩ. Sɛ wʋ kpaŋ Filipo ju gapɩlɛkʋma sɛ daasɛ na adaŋgana ajanɩɛ ŋii wʋ na na, yɩɛ ɩ doba.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Gʋ kpirida baa ba wɩɛ Yerusalem cha nyii gʋ Samariyatina lɩɛ Ɩsʋɔ wɩɛ di na, ba kpiri Petero na Yohane ba jaŋ. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Gʋ ba tala dɩmaŋ na, ba jɔ dɩga fa ba na baa yu Ɩsʋɔ Feliŋ ŋii. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Wʋ sɔ ba Kpaŋjuo Yesu yɩrɛ naŋ, akala takɩɛ Ɩsʋɔ Feliŋ ŋii n kɔŋ ta ba wʋrʋ dʋɔ ɔ. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Dɩmaŋ sɛ Petero na Yohane mʋ ba pamɩɛ jaga ba dʋɔ sɛ ba yu Ɩsʋɔ Feliŋ ŋii.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Gʋ Simoŋ na gʋ kpirida baa mʋ ba pamɩɛ jaga ba dʋɔ sɛ ba yu Ɩsʋɔ Feliŋ ŋii na, wʋ fa ba aterembie <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />sɛ wʋ tawɩ ba sɛ, &lt;&lt;N fa maŋ gba doŋ ŋina ŋarɛ ganaŋkʋ wʋkʋma wʋŋ ma mʋ ma pam jaga wʋ dʋɔ na, a yu Ɩsʋɔ Feliŋ ŋii.&gt;&gt;<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Sɛ Petero lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Nyaŋ na nya aterembie kpiniŋ n warɩɛ. Akala takɩɛ nya fa nfɩɛrɛ sɛ nyaa dɩlɛ mʋ aterembie lɩɛ Ɩsʋɔ gafaasa gaa! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Nya n kpi daa dʋɔ yaa daa na nyaŋ dɩ ɩɩ kpara dɩtʋm gana naŋ ŋ, akala takɩɛ n digela n chirigi Ɩsʋɔ asanaŋ ŋ. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Biliŋi lɩɩ dɩmʋŋ dɩsʋbʋ jawʋ naŋ na nyaa jɔ dɩga fa Ɩsʋɔ. Akʋtɔfɩɛ wʋ a mʋ dɩmʋŋ nfɩɛrɛ ŋina ŋii nya fa n digela naŋ na chɩɛ nyaŋ. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Akala takɩɛ ma na gʋ dɩsɛchɩbɛ su n tɩba sɛ dɩsʋbʋ di n dʋɔ.&gt;&gt;<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Dɩmaŋ sɛ Simoŋ lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Jɔ dɩga fa Kpaŋjuo wʋŋ fa maŋ ganaŋkʋ wɩɛ ŋii nya tawɩ na, ŋarɛ n baa kɔŋ ma dʋɔ.&gt;&gt;<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Gʋ Petero na Yohane di Yesu wɩɛ ŋii dʋɔ seriya, sɛ ba tawɩ Kpaŋjuo wɩɛ ŋii fa ba na, ba bɔrɛ ju Yerusalem yela baa tawɩ wɩɛ abama ŋii Samariyatina dɩɛsɛ bisi fɔɩ naŋ.<verse eid="ACT 8:25" /></para>
  <para style="s1">Filipo na Itiyopiya bɩnɛ wʋrʋ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Sɛ dɩtɩɛna Ɩsʋɔ gabʋɔ tawɩ Filipo sɛ, &lt;&lt;Kʋlʋ ju gbɩɛ gaa gaa ju tie na dʋɔ. Dɩmʋŋ gbɩɛ gaa ga lɩɩ Yerusalem gaa ju Gasa dɩɛ naŋ. Dɩtɩɛna ba aa ti pala na gbɩɛ gana a.&gt;&gt; <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Dɩmʋŋ dʋɔ Filipo fara wʋ a ju, gʋ wʋ dɔŋ gbɩɛ dʋɔ na, wʋ jaŋina Itiyopiya wʋkpa wʋrʋ wʋŋ ba lɩsɛ wʋ julubie, wʋ yɩɛ bɩnɛ wʋkpari bɛ sɛ wʋ a kɩɛ Kandaki, wʋŋ wʋ yɩɛ Itiyopiya ala Juo aterembie dʋɔ. Baalɛ wina cha ju Yerusalem ga tʋm Ɩsʋɔ, <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />gʋ wʋ chaɩ lɔrɛ gaa beŋi a fɔŋɩ ga naŋ wʋ dɔŋ gbɩɛ dʋɔ wʋ a ju dɩɛ na yela wʋ a karaŋ Ɩsʋɔ ɔja Yisaya tanɛ gaa. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Sɛ Ɩsʋɔ Feliŋ tawɩ Filipo sɛ, &lt;&lt;Ju ga sɩŋ tirina lɔrɛ gaa beŋi a fɔŋɩ ga na.&gt;&gt;<verse eid="ACT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30" />Dɩmaŋ sɛ Filipo se ju lɔrɛ gaa beŋi a fɔŋɩ ga na jaŋ, sɛ wʋ nyii gʋ baalɛ wʋŋ a karaŋ Ɩsʋɔ ɔja Yisaya tanɛ gaa. Sɛ Filipo tasɛ ɩ sɛ, &lt;&lt;Nyaa nyii ŋii nyaa karaŋ na tie?&gt;&gt;<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Sɛ baalɛ wʋŋ lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Sɩnɛ sɛ maa dɩlɛ nyii tie? Amʋɔ wʋrʋ lɩsɛ ŋɩ tie fa maŋ.&gt;&gt; Dɩmʋŋ dʋɔ wʋ yagɛ Filipo sɛ wʋ n jiŋ gaa cha wʋ jaŋ.<verse eid="ACT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32" />Itiyopiya wʋkpa wʋŋ cha wʋ a karaŋ dɩmʋŋ wɩɛ lɩɩ Ɩsʋɔ Sabɩɛwɩɛ ŋii naŋ sɛ,</para>
  <para style="q1" vid="ACT 8:32">&lt;&lt;Ba mʋ ɩ laŋ takɩɛ fie wʋŋ baa ga kʋ ɩ na,</para>
  <para style="q2" vid="ACT 8:32">sɛ wʋ kɩɛna bɛ takɩɛ fiebu wʋŋ wʋ n tawɩ bʋrʋ gʋ baa kuli wʋ fʋŋda,</para>
  <para style="q2" vid="ACT 8:32">dɩmʋŋ dʋɔ wʋ n fulu wʋ nʋɔ ɔ.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Ba disi ɩ asaju, sɛ ba n di wʋ wɩɛ ŋɩ gbɩɛ dʋɔ ɔ.</para>
  <para style="q2" vid="ACT 8:33">Mmʋɔ aaŋ dɩlɛ tawɩ wʋ gananabisi wʋsɛ dʋɔ wɩɛ?</para>
  <para style="q2" vid="ACT 8:33">Akala takɩɛ ba kara wʋŋ nkpa dʋɔ tibi dʋɔ bɛ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="ISA 53:7">Yis 53:7</ref>,<ref loc="ISA 53:8">8</ref>.</char></note><verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Sɛ Itiyopiya wʋkpa wʋŋ tasɛ Filipo sɛ, &lt;&lt;Maa sʋlʋ nyaŋ bɛ tawɩ maŋ, Mmʋɔ wʋsɛ dʋɔ wɩɛ sɛ Ɩsʋɔ ɔja wʋŋ a tawɩ, wʋ tɩŋtɩŋ yaa wʋrʋ?&gt;&gt; <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Dɩmaŋ sɛ Filipo sɩŋ dɩmʋŋ Ɩsʋɔ Sabɩɛwɩɛ ŋii wʋ karaŋ na dʋɔ sɛ wʋ tawɩ Yesu wʋsɛ dʋɔ wɩɛ abama ŋii fa ɩ.<verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />Gʋ ba dɔŋ na gbɩɛ baa ju na, ba ga mɩɛna lɩŋ ŋarɛ sɛ Itiyopiya wʋkpa wʋŋ tasɛ ɩ sɛ, &lt;&lt;Kɩɛ lɩŋ mɩnaŋ, be n gara maŋ gbɩɛ sɛ ma n baa sɔ? <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />Sɛ Filipo tawɩ sɛ nya lɩɛ di n digela kpiniŋ naŋ na, nyaa dɩlɛ sɔ. Sɛ Itiyopiya wʋkpa wʋŋ lɩsɛ nʋɔ sɛ ma lɩɛ di takɩɛ Yesu Kirisito n nyina Ɩsʋɔ Bu wʋŋ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Ɩsʋɔ Sabɩɛwɩɛ ŋii ŋarɛ mʋ 36 na 37 wɩɛ bʋga. </char></note> <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Sɛ wʋ dʋ ba sɛ ba n yela na lɔrɛ gaa beŋi a fɔŋɩ ga na a dʋɔsɩŋ. Sɛ Filipo na Itiyopiya wʋkpa wʋŋ tibi ju lɩŋ ŋii naŋ, sɛ Filipo sɔ ɩ. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Gʋ ba lɩɩ lɩŋ ŋii naŋ na, Ɩsʋɔ Feliŋ ŋii mʋ Filipo laŋ gabʋanaŋ, sɛ Itiyopiya wʋkpa wʋŋ n ti na ɩ ɩ, ama wʋ ju dʋɔ mʋ asadi wʋ a ju wʋ gbɩɛ. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Ama Filipo ga lɩɩ Asotusi dɩɛ naŋ, sɛ wʋ pala dɩɛsɛ-dɩɛsɛ kpiniŋ dʋɔ wʋ a tawɩ wɩɛ abama ŋii dɩɛsɛ kpiniŋ dʋɔ hali wʋ ga tala Kayisariya tibi dʋɔ.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s1">Sɔɔlʋ lɩɛ Yesu di</para>
  <para style="r">
    <ref loc="ACT 22:6-16">Dɩtʋm 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Saŋa gana naŋ na, Sɔɔlʋ saŋ wʋ a tawɩ kʋ ŋaŋsɛ wɩɛ wʋ a baŋ Kpaŋjuo Yesu kpalɛnara baa. Wʋ cha ju sei bɩnɩɛ naŋ bɩnɛ wʋŋ jaŋ <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />sɛ wʋ ga tasɛ ɩ sɛ wʋ n fa ɩ yikuo tanɩɛ na wʋ a ju Yudatina tʋm danɩŋ ŋii ŋɩ wɩɛ Damasiko dɩɛ naŋ na wʋ a ga chaŋ baala na ala baa ba kpi Gbɩɛ<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Gbɩɛ gaa yɩɛ baa ba kpamɩna gbɩɛ gaa Kpaŋjuo Yesu kalaa na.</char></note> gaa dʋɔ na, na wʋ a mʋ ba kɔŋ Yerusalem takɩɛ danɛ tʋɔra. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Gʋ wʋ tirina Damasiko dɩɛ na, gabʋanaŋ sɛ ŋmaŋi lɩɩ Ɩsʋɔ adugbe gaa chɩrɩɛ logo ɩ. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Sɛ wʋ lɩɩ sala tibi sɛ wʋ nyii lofu garɛ tasɛ ɩ sɛ, &lt;&lt;Sɔɔlʋ, Sɔɔlʋ be n yɩɛ sɛ nyaa nyala maŋ?&gt;&gt;<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Sɛ Sɔɔlʋ tasɛ sɛ, &lt;&lt;Kpaŋjuo, nyaŋ n nyina Mmʋɔ?&gt;&gt;</para>
  <para style="p" vid="ACT 9:5">Sɛ lofu gaa lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Maŋ n nyina Yesu wʋŋ nyaa nyala ɩ na.&gt;&gt;<verse eid="ACT 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 9:6" />&lt;&lt;Dɩtɩɛna kʋlʋ ju dɩɛ janɛ gaa naŋ. Baa tawɩ nyaŋ bʋrʋ gaa ŋɩ tiri gʋ nya n yɩɛ.&gt;&gt;<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Sɛ baala baa ba na Sɔɔlʋ a ju gbɩɛ na sɩmɩɛɩ ba aa dɩlɛ baa tawɩ bʋrʋ ʋ, baa nyii lofu ama ba n na wʋrʋ ʋ. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sɔɔlʋ kʋlʋ tibi na, ama wʋ fulu wʋ asa na, wʋ a na a. Dɩmʋŋ dʋɔ ba chaŋ wʋ pam naŋ bɛ ju Damasiko dɩɛ naŋ. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Wʋ yɩɛ ɔtaŋpʋ wɩɛ atoro yela wʋ n di yaa wʋ n nyʋɔ bʋrʋ ʋ.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Kpalɛnarɛ wʋrʋ wɩɛ Damasiko dɩɛ naŋ baa yagɛ ɩ sɛ Ananiyasi. Sɛ Kpaŋjuo lɩsɛ kalaa ɩ yagɛ ɩ sɛ, &lt;&lt;Ananiyasi!&gt;&gt;</para>
  <para style="p" vid="ACT 9:10">Sɛ wʋ kpa sɛ, &lt;&lt;Ɛɛŋ Kpaŋjuo.&gt;&gt;<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Sɛ Kpaŋjuo tawɩ ɩ sɛ, &lt;&lt;Kʋlʋ ju Yudasi waa gaa ga wɩɛ Chirigi dɩɛ naŋ gbɩɛ bie gaa dʋɔ, na nyaa tasɛ baalɛ wʋŋ wʋ lɩɩ Taasusi dɩɛ naŋ sɛ baa yagɛ ɩ sɛ Sɔɔlʋ na dʋɔ, akala takɩɛ wʋ a jɔ dɩga. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Sɛ wʋ yu Ɩsʋɔ lɩsɛ kalaa sɛ wʋ na gʋ baalɛ wʋrʋ wʋŋ baa yagɛ ɩ sɛ Ananiyasi kɔŋ gaa mʋ wʋ pam jaga wʋ dʋɔ, na wʋ asa a fulu.&gt;&gt;<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Ama Ananiyasi tawɩ sɛ, &lt;&lt;Kpaŋjuo, ma nyii wɩɛ fɔɩ lɩɩ dɩmʋŋ baalɛ wina dʋɔ na ganaŋkʋ wʋ nyala n bakpa dɩchɩrɩchɩrɩ Yerusalem na. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Wʋ yu yikuo lɩɩ sei bɩnɩɛ naŋ bɩnɩɛ baa jaŋ kɔŋ jɩna na wʋ a gaa chaŋ baa baa yagɛ n yɩrɛ na kpiniŋ.&gt;&gt;<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Ama Kpaŋjuo tawɩ Ananiyasi sɛ, &lt;&lt;Ju! Baalɛ wina yɩɛ wʋkpa wʋŋ ma lɩsɛ na bɛ, na wʋ a gaa tawɩ ma yɩrɛ dʋɔ wɩɛ fa baa ba ba yɩɛ Yudatina na ba juoneŋ na Isiralitina kpiniŋ. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Maa kalaa ɩ ganaŋkʋ ŋɩ tiri gʋ wʋ a na awʋrʋfʋɔ fɔɩ ma yɩrɛ dʋɔ.&gt;&gt;<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Dɩmaŋ sɛ Ananiyasi ju ga jʋʋ waa gaa dʋɔ. Sɛ wʋ mʋ wʋ pam jaga Sɔɔlʋ dʋɔ tawɩ sɛ, &lt;&lt;Ma dʋɔ Sɔɔlʋ, Kpaŋjuo Yesu, wʋŋ wʋ lɩsɛ wʋ wʋsɛ kalaa nyaŋ gbɩɛ naŋ gʋ nyaa kɔŋ jɩna na, n kpiri maŋ ganaŋkʋ nya asa aja fulu, na Ɩsʋɔ Feliŋ ŋii a su n tɩba.&gt;&gt; <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Gabʋanaŋ sɛ bʋrʋ garɛ ga kɩɛna bɛ takɩɛ diji bɔrɩɛ lɩɩ Sɔɔlʋ asa dʋɔ sala, sɛ wʋ bɔrɛ wʋ a na. Wʋ kʋlʋ sɛ ba sɔ ɩ. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Gʋ wʋ di taŋ na, wʋ yu doŋ.</para>
  <para style="s1" vid="ACT 9:19">Sɔɔlʋ Tawɩ Ɩsʋɔ wɩɛ Damasiko dɩɛ naŋ</para>
  <para style="p" vid="ACT 9:19">Sɔɔlʋ di gɩyɩɛnɩŋ fɔɩ kpalɛnara baa jaŋ Dasikosi dɩɛ naŋ.<verse eid="ACT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />Gabʋanaŋ sɛ Sɔɔlʋ fara wʋ a tawɩ Ɩsʋɔ wɩɛ Yudatina tʋm danɩŋ naŋ sɛ Yesu n nyina Ɩsʋɔ Bu wʋŋ. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Sɛ dɩ yɩɛ baa ba nyii wʋ wɩɛ ŋii kpiniŋ doba sɛ ba tasɛ sɛ, &lt;&lt;Naa baalɛ wina n cha nyala baa ba wɩɛ Yerusalem baa dɩmʋŋ yagɛ gana yɩrɛ naa? Naa wʋŋ n kɔŋ jɩna na wʋ a gaa chaŋ ba takɩɛ danɛ tʋɔra ga fa Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɩɛ baa naa?&gt;&gt; <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Ama Sɔɔlʋ bɩɩ yɩɛ doŋ Ɩsʋɔ wɩɛ tawɩ naŋ sɛ wʋ dɩlɛ kalaa gʋ Yesu n nyina Kirisito wʋŋ. Ŋina dʋɔ Yudatina baa ba wɩɛ Damasiko dɩɛ naŋ na n dɩlɛ di ɩ noro ʋ.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Wɩɛ fɔɩ ŋarɛ wʋrʋgbɩɛ na, Yudatina baa pɔgʋ sɛ ba n kʋ ɩ, <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />ama Sɔɔlʋ jiŋ ŋii ba pɔgʋ na. Wiita na yuluma kpiniŋ baa kɩɛ dɩɛ janɛ gaa buonɔ na dieli na baa ɩ kʋ. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Ama wʋ kpamɩra baa mʋ ɩ dʋ gachaŋa naŋ yuluma mʋ ɩ mʋna dɩpɔrɛ gaa ga logo dɩɛ janɛ gaa bʋɔ naŋ tibi na ɩ.<verse eid="ACT 9:25" /></para>
  <para style="s1">Sɔɔlʋ wɩɛ Yerusalem</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Gʋ Sɔɔlʋ tala Yerusalem na, wʋ chɩdɩsɛ wʋ a kpi kpalɛnara baa dʋɔ, ama ba kpiniŋ baa se ɩ, akala takɩɛ ba n lɩɛ ɩ di gʋ wʋ yɩɛ kpalɛnarɛ gasiŋteŋ ŋ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Ama Banabasi mʋ ɩ kɔŋ kpirida baa jaŋ. Wʋ tawɩ ba ganaŋkʋ Sɔɔlʋ na Kpaŋjuo sɛ Kpaŋjuo tawɩ fa ɩ gʋ wʋ a ju gbɩɛ, na ganaŋkʋ wʋ mʋ digela tawɩ Ɩsʋɔ wɩɛ Yesu yɩrɛ naŋ Damasiko. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Sɛ Sɔɔlʋ cha ba jaŋ sɛ wʋ lɔ wʋ wʋsɛ Yerusalem, sɛ wʋ mʋ digela tawɩ Ɩsʋɔ wɩɛ Kpaŋjuo yɩrɛ naŋ. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Sɛ wʋ tawɩ di noro na Yudatina baa baa tawɩ Giriki dɩtawɩ na, ama ba chɩdɩsɛ baa kʋ ɩ. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Gʋ lɩɛdɩra baa jiŋ ŋina na, ba mʋ ɩ ju Kayisariya dɩɛ naŋ sɛ ba lɩsɛ ɩ gbɩɛ ju Taasusi.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Dɩmaŋ sɛ lɩɛdɩra dikpeŋ gaa ga wɩɛ Yudiya, Galaliya na Samariya tibi kpiniŋ dʋɔ na yu wʋsɛfɩɛ saŋa gana naŋ. Sɛ Ɩsʋɔ Feliŋ dʋ ba doŋ sɛ wʋ tawɩ dʋ ba, sɛ lɩɛdɩra dikpeŋ gaa bɩɩ sɛ lɩɛdɩra baa cha Kpaŋjuo wʋŋ sebisi naŋ.<verse eid="ACT 9:31" /></para>
  <para style="s1">Petero wɩɛ Lida na Yopa</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Gʋ Petero pala tibi gaa kpiniŋ dʋɔ na, wʋ ju ga yɩlɩ Ɩsʋɔ bakpa dɩchɩrɩchɩrɩ baa ba wɩɛ Lida dɩɛ naŋ. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Dɩmaŋ sɛ wʋ na baalɛ wʋrʋ baa yagɛ ɩ sɛ Aniyasi, wʋ jaɩ-jaɩ wʋ duwei kalaŋ dʋɔ bɩŋsɛ jiŋinara. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Sɛ Petero tawɩ ɩ sɛ, &lt;&lt;Aniyasi, Yesu Kirisito chɔ nyaŋ. Kʋlʋ na nyaa go n kalaŋ.&gt;&gt; Gabʋanaŋ sɛ wʋ kʋlʋ. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Gʋ bakpa baa ba wɩɛ Lida na Saroŋ dɩɛ naŋ kpiniŋ na ɩ na, ba biliŋi ba n nfɩɛrɛ sɛ ba lɩɛ Kpaŋjuo di.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Alʋ Lɩɛdɩrɛ wʋrʋ wɩɛ Yopa dɩɛ naŋ baa yagɛ ɩ sɛ Tabita [tie n nyina Dokasi<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">Dokasi yɩɛ Giriki dɩtawɩ bɛ, sɛ Tabita yɩɛ Aramiki dɩtawɩ. Dokasi tie a kalaa sɛ chaŋgbɩlaŋ </char></note>], wʋŋ wʋ a yɩɛ dɩbam yela wʋ a chɔna ayɔŋtina saŋa kʋma. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Dɩmʋŋ saŋa gana sɛ wʋ kili sɛ wʋ sɩŋ, sɛ ba sɔ wʋ gɩtatɛ mʋ ɩ ga si abaŋsʋrʋ danɛ naŋ. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Lida dɩɛ tirina Yopa dɩɛ. Dɩmʋŋ dʋɔ gʋ kpalɛnara baa nyii gʋ Petero wɩɛ Lida dɩɛ naŋ na, ba kpiri baala bala wʋ jaŋ ga tawɩ ɩ sɛ, &lt;&lt;Dɩɩ sʋlʋ nyaŋ, yɩɛ bileŋ na nyaa kɔŋ.&gt;&gt;<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />Sɛ ba na Petero ba ju. Gʋ wʋ talɛ na, ba mʋ ɩ ju abaŋsʋrʋ danɛ gaa naŋ. Sɛ bakulapuna ala jaŋ baa kpiniŋ sɩŋ logo ɩ baa wɩɩ yela ba chamɩna ba gagbasɛ na abʋrɩ afuusa ŋii Dokasi ŋara fa ba, gʋ wʋ chaɩ nkpa naŋ ba jaŋ na mʋ kalaa Petero.<verse eid="ACT 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40" />Sɛ Petero yela sɛ baa ba wɩɛ danɛ gaa naŋ na kpiniŋ lɩɩ asʋŋ. Sɛ wʋ luuŋ wʋ dʋna dʋɔ jɔ dɩga. Sɛ wʋ biliŋi kɩɛ atatɛ wʋŋ tawɩ sɛ, &lt;&lt;Tabita kʋlʋ.&gt;&gt; Sɛ wʋ fulu wʋ asa na Petero, sɛ wʋ kʋlʋ cha. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Sɛ Petero chaŋ wʋ pam naŋ chɔna ɩ sɛ wʋ kʋlʋ sɩŋ. Dɩmaŋ sɛ wʋ yagɛ lɩɛdɩra baa na ala bakulapuna baa sɛ wʋ mʋ Tabita wʋŋ wʋ feŋ kɔŋ nkpa naŋ na, fa ba. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Dɩmʋŋ wɩɛ ŋina yalagi Yopa dɩɛ naŋ kpiniŋ, sɛ bakpa fɔɩ lɩɛ Kpaŋjuo di. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Sɛ Petero cha Yopa dɩɛ naŋ wɩɛ akalasa ŋarɛ gbaŋsɩba wʋrʋ wʋŋ baa yagɛ ɩ sɛ Simoŋ na jaŋ.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s1">Petero na Koneliyosi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Baalɛ wʋrʋ wɩɛ Kayisariya dɩɛ naŋ baa yagɛ ɩ sɛ Koneliyosi. Wʋ cha wʋ yɩɛ Roma yuora dikpeŋ gaa baa yagɛ ga sɛ Italiya Dikpeŋ yuora gafie bɩnɛ bɛ. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Wʋ na wʋ lʋŋtina kpiniŋ cha baa tʋŋ Ɩsʋɔ na dieli sɛ baa se Ɩsʋɔ. Wʋ yɩɛ dɩbam fa ayɔŋtina sɛ wʋ a jɔ dɩga saŋa kʋma. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Wɩɩ darɛ aja yɩɛ karafɩɛ atoro wiita sɛ wʋ yu Ɩsʋɔ lɩsɛ kalaa. Wʋ na na dieli gʋ Ɩsʋɔ gabʋɔ kɔŋ wʋ jaŋ, sɛ wʋ yagɛ ɩ sɛ, &lt;&lt;Koneliyosi!&gt;&gt;<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Sɛ wʋ mʋ nyɩŋtɩɛ kɩɛ ɩ na dieli sɛ wʋ tasɛ ɩ sɛ, &lt;&lt;Kpaŋjuo, be bɛ?&gt;&gt;</para>
  <para style="p" vid="ACT 10:4">Sɛ Ɩsʋɔ gabʋɔ wʋŋ lɩsɛ ɩ nʋɔ sɛ nya dɩga na gafaasa fa ayɔŋtina kɔŋ Ɩsʋɔ asanaŋ takɩɛ nyiŋi gadiesa.<verse eid="ACT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 10:5" />Dɩtɩɛna kpiri bakpa ju Yopa na baa ga yagɛ baalɛ wʋŋ baa yagɛ ɩ sɛ Simoŋ Petero na kɔŋ. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Wʋ chaɩ Simoŋ wʋŋ wʋ yɩɛ gbaŋsɩba sɛ wʋ waa tirina ɔpʋ na jaŋ.<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />Gʋ Ɩsʋɔ gabʋɔ wʋŋ wʋ tawɩ fa ɩ lam na, Koneliyosi yagɛ wʋ tʋmɩra bala na yuorɛ wʋŋ wʋ a tʋŋ Ɩsʋɔ na dieli na, wʋŋ wʋ yɩɛ baa baa tʋŋ ɩ na tɩba wʋrʋ. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Wʋ tawɩ ba bʋrʋkʋma gaa ga tibi na, sɛ wʋ kpiri ba Yopa.<verse eid="ACT 10:8" /></para>
  <para style="s1">Petero yu Ɩsʋɔ lɩsɛ kalaa</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Gʋ tɩɛna aja yɩɛ takɩɛ wiita keŋkeŋ gʋ gabʋɔsɛ baa dɔŋ gbɩɛ dʋɔ baa ju sɛ ba tirina dɩɛ janɛ gaa na, Petero jiŋ ju danɛ adugbe na wʋ a ga jɔ dɩga. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Dusoŋ chaŋ ɩ sɛ wʋ a ja bʋrʋ garɛ wʋ a di. Gʋ baa tɩŋɛ adiya na, wʋ yu Ɩsʋɔ lɩsɛ kalaa. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Wʋ na gʋ Ɩsʋɔ adugbe fulu sɛ bʋrʋ garɛ gaa ga kɩɛna takɩɛ dukuru janɛ lɩɩ Ɩsʋɔ adugbe ga na ga nʋɔbɩsɩ anara gaa kɔŋ tibi. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Ga tɩba wɩɛna namɩɛ kʋma baa ba wɩɛna nafara anara, na namɩɛ baa baa kpii ba lorie dʋɔ na jimbisi. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Dɩmaŋ sɛ lofu garɛ tawɩ ɩ sɛ, &lt;&lt;Petero, kʋlʋ kʋ na nyaa tawʋ.&gt;&gt;<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Sɛ Petero tawɩ sɛ, &lt;&lt;Kpaŋjuo, aye! Ma n di ta bʋrʋ gaa ga ba yɩɛ dɩchɩrɩchɩrɩ yaa ga wʋsɛ wɩɛna iniesi i.&gt;&gt;<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />Sɛ lofu gaa ti tawɩ ɩ bʋlatɛ sɛ, &lt;&lt;N baa ti yagɛ bʋrʋ gaa Ɩsʋɔ yɩɛ ga chɩrɩchɩrɩ sɛ ga wɩɛna iniesi.&gt;&gt;<verse eid="ACT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16" />Ŋina tibi gbɩɛta butoro, gabʋanaŋ sɛ dukuru gaa bɔrɛ ju Ɩsʋɔ adugbe.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Gʋ Petero cha wʋ a fa nfɩɛrɛ Ɩsʋɔ lɩsɛ kalaa ŋii wʋ yu tie na, bakpa baa Koneliyosi kpiri ba na jiŋ diele gaa Simoŋ waa gaa wɩɛ, sɛ ba ga dʋɔsɩŋ ga buonɔ. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Sɛ ba kuusi tasɛ sɛ, &lt;&lt;Jɩna sɛ Simoŋ wʋŋ baa yagɛ ɩ Petero chaɩ naa?&gt;&gt;<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />Gʋ Petero saŋ wʋ a fa nfɩɛrɛ Ɩsʋɔ lɩsɛ kalaa ŋii wʋ yu dʋɔ na, Ɩsʋɔ Feliŋ ŋii tawɩ ɩ sɛ, &lt;&lt;Simoŋ, baala batoro<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">Ɩsʋɔ wɩɛ ŋarɛ n wɩɛna batoro.</char></note> barɛ aja nyaŋ.&gt;&gt; <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Dɩmʋŋ dʋɔ kʋlʋ na nyaa tibi. N baa mʋ wɩɛ ŋii kpii na nyaŋ na ba ɩ ju, akala takɩɛ maŋ n kpiri ba.<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />Sɛ Petero tibi tie gaa tawɩ baala baa sɛ, &lt;&lt;Maŋ sɛ ɩ jawʋ na. Be dʋɔ sɛ ɩ kɔnɛ?&gt;&gt;<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Sɛ baala baa lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Yuora gafie bɩnɛ Koneliyosi n kpiri daa. Wʋ yɩɛ wʋchirigisa sɛ wʋ a se Ɩsʋɔ, sɛ Yudatina baa kpiniŋ a bu ɩ. Ɩsʋɔ gabʋɔ dɩchɩrɩchɩrɩ n tawɩ ɩ sɛ wʋ n yagɛ nyaŋ kɔŋ wʋ waa dʋɔ na wʋ a nyii wɩɛ ŋii nya wɩɛna nyaa tawɩ na.&gt;&gt; <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Dɩmaŋ sɛ Petero yagɛ baala baa jʋʋ waa gaa dʋɔ na baa yɩɛ wʋ mʋɔra.</para>
  <para style="s1" vid="ACT 10:23">Petero wɩɛ Koneliyosi waa dʋɔ</para>
  <para style="p" vid="ACT 10:23">Gʋ tɩɛna na, Petero kʋlʋ sɛ wʋ na ba ju, sɛ lɩɛdɩra baa barɛ baa ba lɩɩ Yopa na kpaŋ ba.<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />Gʋ tɩɛna na, wʋ tala Kayisariya. Koneliyosi cha wʋ a kɩɛ ba gbɩɛ sɛ wʋ yagɛ wʋ lʋŋtina na wʋ dɩɛtina baa ba tirina ɩ gaa sɩla. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Gʋ Petero jʋʋ waa gaa dʋɔ na, sɛ Koneliyosi jaŋina ɩ sɛ wʋ luuŋ wʋ dʋna dʋɔ wʋ asanaŋ. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Ama Petero yela sɛ wʋ kʋlʋ sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Kʋlʋ, maŋ gba ma yɩɛ wʋkpa bɛ!&gt;&gt;<verse eid="ACT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27" />Gʋ Petero a tawɩ wʋ jaŋ na, wʋ jʋʋ waa gaa dʋɔ, sɛ wʋ na bakpa fɔɩ sɩla. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Amɩɛ tɩŋtɩŋ ɩ jiŋ gʋ daa mbara n fa gbɩɛ sɛ Yuda wʋkpa na wʋŋ wʋ ba yɩɛ Yuda wʋkpa n bʋga yaa wʋ n ju ga bʋɔ wʋ dʋɔ ɔ. Ama Ɩsʋɔ kalaa maŋ sɛ ma n baa tawɩ wʋrʋ sɛ wʋ ba yɩɛ dɩchɩrɩchɩrɩ yaa wʋ wʋsɛ wɩɛna iniesi i. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Dɩmʋŋ dʋɔ gʋ ɩ kpiri yagɛ maŋ na, ma n pɩɛ ɛ. Maa dɩlɛ tasɛ amɩɛ kpɩnɩdɩ dʋɔ sɛ ɩ kpiri yagɛ maŋ naa?&gt;&gt;<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Sɛ Koneliyosi lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Wɩɛ anara mɩnaŋ dɩmʋŋ saŋa gana karafɩɛ atoro saŋa wiita keŋkeŋ ma wɩɛ ma waa dʋɔ maa jɔ dɩga. Gabʋanaŋ sɛ ma na baalɛ wʋrʋ fuona gagbasɛ aŋalagisa gaa sɩŋ ma asanaŋ, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />sɛ wʋ tawɩ sɛ Koneliyosi, Ɩsʋɔ nyii n dɩga sɛ wʋ nyiŋi nya afaasa fa ayɔŋtina. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Kpiri ju Yopa na baa ga yagɛ Simoŋ wʋŋ baa yagɛ ɩ sɛ Petero. Wʋ yɩɛ mʋɔrɛ bɛ wʋ wɩɛ Simoŋ gbaŋsɩba wʋŋ wʋ waa tirina ɔpʋ na dʋɔ. <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Dɩmʋŋ dʋɔ sɛ ma kpiri yagɛ nyaŋ gabʋanaŋ, ŋɩ wɩɛ dieli fa nyaŋ gʋ nya kɔnɛ. Dɩtɩɛna daa kpiniŋ dɩ jaŋi Ɩsʋɔ asanaŋ na dɩɩ nyii bʋrʋkʋma gaa Kpaŋjuo dʋ nyaŋ sɛ nya n tawɩ daa.&gt;&gt;<verse eid="ACT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Dɩmaŋ sɛ Petero fara wʋ a tawɩ sɛ, &lt;&lt;Dɩtɩɛna ma jiŋ gʋ ŋɩ yɩɛ gasiŋteŋ takɩɛ Ɩsʋɔ ba aa kɩɛ wʋkpa asanaŋ ŋ, <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />ama atawɩ yɩrɩ wʋkʋma naŋ, baa baa se ɩ sɛ baa yɩɛ bʋrʋ gaa ga wɩɛ dieli na, wʋ a lɩɛ ba dʋ. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Ɩ nyii wɩɛ ŋii Ɩsʋɔ mʋ kɔna Isiralitina sɛ wʋ mʋna Yesu Kirisito wʋŋ wʋ yɩɛ bakpa kpiniŋ Kpaŋjuo na dʋɔ tawɩ wʋsɛfɩɛ wɩɛ abama ŋii. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Sɛ ɩ jiŋ wɩɛ ŋii ŋɩ tibi Yudiya tibi dʋɔ kpiniŋ, ŋɩ fara lɩɩ Galaliya tibi dʋɔ bɛ saŋa gaa Yohane tawɩ Ɩsʋɔ sɔ dʋɔ wɩɛ ŋii wʋrʋgbɩɛ. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Ganaŋkʋ Ɩsʋɔ mʋ wʋ Feliŋ na doŋ fa Yesu Nasarati wʋkpa wʋŋ, na ganaŋkʋ wʋ dɔŋ wʋ a kiliŋsi wʋ a yɩɛ dɩbam yela wʋ a chɔ baa Sɩtanɩ di ba dʋɔ na, akala takɩɛ Ɩsʋɔ cha kpi wʋ dʋɔ.&gt;&gt;<verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩ yɩɛ seriyatina bɛ fa bʋrʋkʋma gaa wʋ yɩɛ Yudiya na Yerusalem tibi dʋɔ. Ba jɔ ɩ daŋ gasagasa dʋɔ bɛ kʋ ɩ, <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />ama Ɩsʋɔ feŋsi ɩ lɩɩ sɩŋ naŋ wɩɛ atorotɛ sɛ wʋ yela sɛ ba na ɩ. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Naa wʋkʋma n na ɩ ɩ, ama seriyatina baa Ɩsʋɔ fɩla lɩsɛ ba na. Daa baa daa na ɩ di sɛ dɩ nyʋɔ na, gʋ wʋ feŋ lɩɩ sɩŋ naŋ na wʋrʋgbɩɛ. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Wʋ dʋ daa sɛ dɩ n tawɩ Ɩsʋɔ wɩɛ ŋii fa bakpa, na dɩɩ di seriya takɩɛ wʋŋ n nyina wʋŋ Ɩsʋɔ lɩsɛ takɩɛ wɩɛ diri fa bakɩɛnasa na atatina. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Ɩsʋɔ bajana baa kpiniŋ di wʋ wʋsɛ dʋɔ seriya takɩɛ wʋkʋma wʋŋ wʋ lɩɛ ɩ di na, wʋ a yu dɩsʋbʋ mʋ chɩɛ wʋ yɩrɛ naŋ.&gt;&gt;<verse eid="ACT 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Gʋ Petero saŋ wʋ a tawɩ dɩmʋŋ wɩɛ ŋina na, Ɩsʋɔ Feliŋ kɔŋ baa ba nyii wɩɛ ŋii na kpiniŋ dʋɔ. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Sɛ dɩ yɩɛ lɩɛdɩra baŋlɛ karada baa ba kpaŋ Petero kɔŋ na doba takɩɛ Ɩsʋɔ mʋ gafaasa gaa ga yɩɛ wʋ Feliŋ na fa baa ba ba yɩɛ Yudatina na gba. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Akala takɩɛ ba nyii gʋ baa tawɩ atawɩ afɔlɩɛ<note caller="+" style="f"><char style="fr" closed="false">10:46 </char><char style="ft" closed="false">Dɩtawɩ baŋbaŋ.</char></note> yela baa kalɩɛ Ɩsʋɔ.</para>
  <para style="p" vid="ACT 10:46">Dɩmaŋ sɛ Petero tawɩ sɛ, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />&lt;&lt;Wʋrʋ a dɩlɛ gaa bakpa bana gbɩɛ sɛ ba n baa mʋ lɩŋ sɔ ba? Ba yu Ɩsʋɔ Feliŋ takɩɛ ganaŋkʋ dɩ yu na.&gt;&gt; <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Dɩmʋŋ dʋɔ Petero dʋ sɛ ba n sɔ ba Yesu Kirisito yɩrɛ naŋ. Dɩmaŋ sɛ ba sʋlʋ ɩ sɛ wʋ n cha ba jaŋ wɩɛ akalasa ŋarɛ.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s1">Petero lɩsɛ bʋrʋkʋma gaa ga tibi na tie fa Yerusalem lɩɛdɩra dikpeŋ gaa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Sɛ kpirida baa na lɩɛdɩra baa ba wɩɛ Yudiya tibi dʋɔ kpiniŋ nyii gʋ baa ba ba yɩɛ Yudatina na gba lɩɛ Ɩsʋɔ wɩɛ dʋ na. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Dɩmʋŋ dʋɔ gʋ Petero bɔrɛ kɔŋ Yerusalem na, lɩɛdɩra karɩŋ baŋlɛ baa na ɩ di noro <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />sɛ ba tawɩ sɛ, &lt;&lt;Nya ju baa ba n kara ba baŋlɛ na waa dʋɔ sɛ nyaŋ na ba ɩ ga di.&gt;&gt;<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />Sɛ Petero fara wʋ a lɩsɛ bʋrʋkʋma gaa ga tibi na tie kʋrʋkʋrʋ wʋ a fa ba sɛ, <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />&lt;&lt;Ma wɩɛ Yopa dɩɛ janɛ gaa naŋ maa jɔ dɩga sɛ ma yu Ɩsʋɔ lɩsɛ kalaa. Ma na bʋrʋ garɛ gaa ga kɩɛna takɩɛ dukuru janɛ lɩɩ Ɩsʋɔ adugbe ga na ga nʋɔbɩsɩ anara gaa kɔŋ tibi, sɛ ga kɔŋ diele gaa ma wɩɛ na. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Gʋ ma kɩɛ ga tɩba na, ma na tibi dʋɔ namɩɛ baa ba wɩɛna nafara anara, kasɛ naŋ namɩɛ, namɩɛ baa baa kpii ba lorie dʋɔ, na jimbisi. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Dɩmaŋ sɛ ma nyii lofu garɛ gaa tawɩ maŋ sɛ Petero, kʋlʋ kʋ na nyaa tawʋ.&gt;&gt;<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />Sɛ wʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Aye Kpaŋjuo, bʋrʋ gaa ga ba yɩɛ chɩrɩchɩrɩ yaa ga wɩɛna iniesi n jʋʋ ta ma nʋɔ ɔ.&gt;&gt;<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />Sɛ lofu gaa ti tawɩ lɩɩ Ɩsʋɔ adugbe bʋlatɛ sɛ, &lt;&lt;N baa ti yagɛ bʋrʋ gaa Ɩsʋɔ yɩɛ ga chɩrɩchɩrɩ sɛ ga wɩɛna iniesi.&gt;&gt; <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Ŋina tibi gbɩɛta butoro sɛ ŋɩ kpiniŋ ŋɩ bɔrɛ ju Ɩsʋɔ adugbe.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />Sɛ Petero ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmaŋ sɛ baala batoro baa ba kpiri ba lɩɩ Kayisariya ma jaŋ na, gaa dʋɔsɩŋ waa gaa ma wɩɛ ga dʋɔ na. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Sɛ Ɩsʋɔ Feliŋ tawɩ maŋ sɛ n baa mʋ wɩɛ ŋii kpii na maŋ na ba dɩɩ ju. Lɩɛdɩra lʋrʋ bana gba kpaŋ maŋ sɛ dɩ jʋʋ baalɛ wʋŋ waa dʋɔ. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Wʋ tawɩ daa ganaŋkʋ wʋ na Ɩsʋɔ gabʋɔ lɩsɛ wʋ wʋsɛ kalaa ɩ wʋ waa dʋɔ, sɛ wʋ tawɩ ɩ sɛ kpiri ju Yopa na baa yagɛ Simoŋ wʋŋ baa yagɛ ɩ sɛ Petero na. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Wʋ a kɔna nyaŋ wɩɛ ŋarɛ ŋii nyaŋ na n waa dʋɔtina kpiniŋ aja pala na yu mɔlɔgɩ.&gt;&gt;<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Gʋ ma fara maa tawɩ na, Ɩsʋɔ Feliŋ kɔŋ ba dʋɔ takɩɛ ganaŋkʋ wʋ chɩŋkpɩɛ kɔŋ daa dʋɔ na. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Dɩmaŋ sɛ ma nyiŋi wɩɛ ŋii Kpaŋjuo Yesu cha tawɩ sɛ Yohane mʋ lɩŋ bɛ sɔ, ama amɩɛ bɩrɛ, Ɩsʋɔ Feliŋ sɛ baa mʋ sɔ amɩɛ. <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Dɩmʋŋ dʋɔ sɛ Ɩsʋɔ fa ba gafaasa gadʋŋdʋlʋŋ takɩɛ ganaŋkʋ wʋ fa daa baa dɩ lɩɛ Kpaŋjuo Yesu Kirisito di na, Mmʋɔ n nyina maŋ sɛ maa dɩlɛ gara Ɩsʋɔ gbɩɛ?&gt;&gt;<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Gʋ baa nyii wɩɛ ŋina na, ba cha kuruŋ sɛ ba kalɩɛ Ɩsʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ bɩrɛ Ɩsʋɔ fa baa ba ba yɩɛ Yudatina na gba gbɩɛ sɛ ba n biliŋi lɩɩ dɩsʋbʋ naŋ na baa yu nkpa.&gt;&gt;<verse eid="ACT 11:18" /></para>
  <para style="s1">Lɩɛdɩra dikpeŋ gaa ga wɩɛ Antiyokiya</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Dɩtɩɛna ganyala gaa ga kɔnɛ lɩɩna Sitifiŋ sɩŋ dʋɔ na yela sɛ lɩɛdɩra baa puseŋ ju taŋasɛ takɩɛ Fonisiya Kipurosi, Antiyokiya tibi dʋɔ yela baa tawɩ Yesu wʋsɛ dʋɔ wɩɛ baa fa Yudatina nyiŋeŋ. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Ama ba barɛ baa ba lɩɩ Kipurosi na Kireni ju Antiyokiya, sɛ ba fara baa tawɩ Kpaŋjuo Yesu wʋsɛ dʋɔ wɩɛ abama ŋii baa fa Girikitina gba. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Kpaŋjuo doŋ wɩɛ ba dʋɔ sɛ bakpa fɔɩ lɩɛ di sɛ ba biliŋi kɔŋ Kpaŋjuo jaŋ.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Gʋ Lɩɛdɩra dikpeŋ gaa ga wɩɛ Yerusalem nyii dɩmʋŋ wɩɛ ŋina na, sɛ ba kpiri Banabasi ju Antiyokiya dɩɛ naŋ. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Gʋ wʋ ga tala dɩmaŋ na, wʋ na gʋ Ɩsʋɔ wɩɩ wɩɛ ba dʋɔ, sɛ dɩ yɩɛ ɩ jʋŋ sɛ wʋ tawɩ dʋ ba kpiniŋ sɛ ba n ju dʋɔ mʋ ba agela kpiniŋ kpaŋ Kpaŋjuo gasiŋteŋ naŋ. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Gʋ Banabasi cha wʋ yɩɛ wʋkpa bam sɛ Ɩsʋɔ Feliŋ na lɩɛdi su wʋ tɩba na dʋɔ, bakpa fɔɩ lɩɛ Kpaŋjuo di.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Dɩmaŋ sɛ Banabasi ju Taasusi dɩɛ naŋ ga ja Sɔɔlʋ, <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />gʋ wʋ ga na ɩ na, wʋ mʋ ɩ kɔŋ Antiyokiya dɩɛ naŋ. Sɛ Banabasi na Sɔɔlʋ cha yela baa jaŋi lɩɛdɩra dikpeŋ gaa bɩriŋnʋɔ gaa kpiniŋ, sɛ ba kalaa bakpa fɔɩ. Antiyokiya dɩɛ naŋ sɛ ba chɩŋkpɩɛ yagɛ kpalɛnara baa sɛ Kirisitotina.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Dɩmʋŋ saŋa gana naŋ na, Ɩsʋɔ bajana barɛ lɩɩ Yerusalem kɔŋ Antiyokiya. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Sɛ ba tɩba wʋrʋ wʋŋ baa yagɛ ɩ sɛ Agabusi kʋlʋ sɩŋ sɛ Ɩsʋɔ Feliŋ pala na wʋ dʋɔ gbala sɛ dusoŋ janɛ gaa ga nʋɔ wɩɛ doŋ aja kɔŋ Roma tibi kpiniŋ dʋɔ. [Roma Juo Kaladiyosi saŋa sɛ ŋina tibi.] <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Ŋina dʋɔ kpalɛnara baa kpa sɛ ba wʋkʋma aja chɔna wʋ doŋ gɩtɛ, na baa mʋ gaa fa lɩɛdɩra baa ba wɩɛ Yudiya tibi dʋɔ. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Sɛ ba yɩɛ dɩmʋŋ, sɛ ba mʋ ba gafaasa fa Banabasi na Sɔɔlʋ sɛ ba n mʋ ga fa lɩɛdɩra dikpeŋ bɩnɩɛ baa.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s1">Ba nyala Kirisito lɩɛdɩra baa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Dɩmʋŋ saŋa gana naŋ, Juo Hɛrɔdɩ chaŋ lɩɛdɩra dikpeŋ gaa tɩba barɛ akala takɩɛ wʋ a ja sɛ wʋ a nyala ba. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Wʋ yela sɛ ba mʋ yuo dabɩla kʋ Jamesi, Yohane wʋ ŋmɩɛtɩ. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Gʋ wʋ na gʋ Yudatina asadi na, wʋ ju dʋɔ ga chaŋ Petero gba. Bodobodo gaa ga Tana Yiisi Asadi Adiya di saŋa sɛ ŋina tibi. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Gʋ wʋ chaŋ ɩ wʋrʋgbɩɛ na, wʋ mʋ ɩ tɔ danɛ, sɛ wʋ mʋ ɩ fa yuora akpeŋ anara ŋii dikpeŋ garɛ kʋma yɩɛ yuora banara na. Hɛrɔdɩ yɩɛ wʋ nfɩɛrɛ sɛ ba di Nyiŋi Asadi Adiya di taŋ na, wʋ a lɩsɛ ɩ na baa di wʋ wɩɛ bakpa asanaŋ.<verse eid="ACT 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5" />Dɩmʋŋ dʋɔ Petero saŋ wʋ wɩɛ danɛ dɩtʋɔtɩŋ, ama lɩɛdɩra dikpeŋ gaa dɩsɛchɩbɛ sɛ ba jɔ dɩga fa Ɩsʋɔ fa ɩ.<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Yuluma pʋɩ na Hɛrɔdɩ a lɩsɛ ɩ na baa di wʋ wɩɛ na, Petero cha wʋ duwei yuora bala tɩtɩba sɛ ba mʋ agbaraŋgbaraŋ ala pɔgʋ ɩ yela yuora sɩmɩɛɩ danɛ dɩtʋɔtɩŋ buonɔ baa gie ga. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Gabʋanaŋ sɛ Ɩsʋɔ gabʋɔ lɩsɛ wʋ wʋsɛ sɛ danɛ dɩtʋɔtɩŋ gaa naŋ ŋmaŋi. Sɛ wʋ jɔ Petero feŋsi ɩ tawɩ ɩ sɛ, &lt;&lt;Kʋlʋ sɩŋ bileŋ.&gt;&gt; Sɛ dɩgbaraŋgbaraŋ gaa ba cha mʋ pɔgʋ ɩ wʋ pamɩɛ naŋ na boli lɩɩ sala.<verse eid="ACT 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 12:8" />Dɩmaŋ sɛ Ɩsʋɔ gabʋɔ wʋŋ tawɩ ɩ sɛ, &lt;&lt;Fu nya abʋrɩ na nyaa dʋ nya asibita.&gt;&gt; Sɛ Petero yɩɛ dɩmʋŋ. Sɛ Ɩsʋɔ gabʋɔ wʋŋ ti tawɩ sɛ, &lt;&lt;Fu nya adugbe gagba na nyaa kpaŋ maŋ.&gt;&gt; <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Sɛ Petero kpaŋ Ɩsʋɔ gabʋɔ wʋŋ lɩɩ danɛ dɩtʋɔtɩŋ gaa naŋ. Ama Petero ba jiŋ sɛ ŋii Ɩsʋɔ gabʋɔ wʋŋ cha wʋ a yɩɛ na, a tibi gasiŋteŋ ŋ. Wʋ cha wʋ jiŋ sɛ wʋ yu Ɩsʋɔ lɩsɛ kalaa bɛ. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Sɛ ba chɩŋkpɩɛ laŋ kɩɛra asanaŋtina na bʋlatɛ baa dʋɔ, sɛ ba gaa tala nyɩŋgɩrɛ buonɔ gaa baa mʋna baa jʋʋ dɩɛ janɛ gaa naŋ na. Sɛ ga tɩŋtɩŋ ga tʋlʋ fa ba sɛ ba pala lɩɩ. Gʋ ba pala dɩɛ naŋ gbɩɛ bie gaa dʋɔ ju ba asanaŋ chonii na, gabʋanaŋ sɛ Ɩsʋɔ gabʋɔ wʋŋ tʋsʋ Petero dʋɔ.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Dɩmaŋ sɛ dɩ ŋmaŋi Petero asa dʋɔ sɛ wʋ tawɩ sɛ, &lt;&lt;Dɩtɩɛna ma jiŋ gʋ ŋɩ yɩɛ gasiŋteŋ bɛ takɩɛ Ɩsʋɔ kpiri wʋ gabʋɔ sɛ wʋ n gaa lɩɛ maŋ lɩɩ Hɛrɔdɩ pamɩɛ naŋ, na bʋrʋkʋma gaa nafʋɔ Yudatina a kɩɛ gbɩɛ sɛ ba n mʋ yɩɛ maŋ na.&gt;&gt;<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Gʋ wʋ cha na ŋina na, wʋ ju Mariya wʋŋ wʋ bu n nyina Yohane wʋŋ baa yagɛ ɩ sɛ Maakɩ waa dʋɔ, diele gaa bakpa fɔɩ sɩla baa jɔ dɩga. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Sɛ Petero jɔ asʋŋ bʋɔlɛ gaa dʋɔ, sɛ tʋmɩrɛ galibie wʋrʋ wʋŋ baa yagɛ ɩ sɛ Roda gaa suŋa kɩɛ sɛ n Mmʋɔ aaŋ jɔ bʋɔlɛ gaa. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Gʋ wʋ jiŋ Petero lofu na, wʋ asadi galaŋ sɛ wʋ n tʋlʋ bʋɔlɛ gaa a, sɛ wʋ se ga tawɩ ba sɛ, &lt;&lt;Petero sɩmɩɛɩ buonɔ.&gt;&gt;<verse eid="ACT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15" />Sɛ ba tawɩ ɩ sɛ, &lt;&lt;Nya nfɩɛrɛ warɩɛwʋ.&gt;&gt; Gʋ wʋ ju dʋɔ wʋ a tawɩ sɛ ŋɩ yɩɛ gasiŋteŋ na, ba tawɩ sɛ, &lt;&lt;Aja yɩɛ wʋ Ɩsʋɔ gabʋɔ bɛ.&gt;&gt;<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Ama Petero ju dʋɔ wʋ a jɔ bʋɔlɛ gaa, gʋ ba tʋlʋ sɛ ba na ɩ na, dɩ yɩɛ ba doba. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Sɛ Petero ŋɩrɛ ba pam sɛ ba n fu ba nʋɔsɛ dʋɔ. Sɛ wʋ tawɩ ba ganaŋkʋ Kpaŋjuo lɩsɛ ɩ lɩɩ danɛ dɩtʋɔtɩŋ gaa tɩba. Sɛ wʋ tawɩ ba sɛ, &lt;&lt;N tawɩ ŋina fa Jamesi na lɩɛdɩra baa.&gt;&gt; Sɛ wʋ lɩɩ dɩmaŋ ju gatʋŋgʋrʋ.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Gʋ tɩɛna nafo na, yuora baa wuliti akala takɩɛ ba ba jiŋ bʋrʋ gaa ga yɩɛ Petero na a. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Gʋ Hɛrɔdɩ yela sɛ ba ju ga ja ɩ na dieli sɛ ba n na ɩ na, wʋ tasɛ kɩɛra baa nʋɔnaŋ wɩɛ na dieli sɛ wʋ dʋ sɛ ba n kʋ ba.</para>
  <para style="s1" vid="ACT 12:19">Hɛrɔdɩ sɩŋ wɩɛ</para>
  <para style="p" vid="ACT 12:19">Dɩmaŋ sɛ Hɛrɔdɩ lɩɩ Yudiya ju Kayisariya ga cha wɩɛ akalasa ŋarɛ. <verse eid="ACT 12:19" /><verse number="20" style="v" sid="ACT 12:20" />Hɛrɔdɩ cha wʋ a yuo na Tirositina na Sidoŋtina. Ba yɩɛ nʋɔ garɛ kpiri gabʋɔ ju Hɛrɔdɩ jaŋ. Ba tawɩ Bilasitusi wʋŋ wʋ yɩɛ juo wʋŋ bɩnɩɛ baa tɩba wʋkpari, sɛ wʋ kpa sɛ wʋ a chɔna ba na baa ju Hɛrɔdɩ jaŋ ga ja wʋsɛfɩɛ, akala takɩɛ wʋ tibi dʋɔ sɛ baa yu ba adiya baa lɩɩ.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Gʋ wɩɩ gaa Hɛrɔdɩ lɩsɛ si talɛ na, wʋ fu wʋ juori gagbasɛ sɛ wʋ cha wʋ juorigbeli dʋɔ tawɩ wʋ nʋɔnaŋ wɩɛ fa bakpa baa bakpa naŋ. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Sɛ ba kuusi na doŋ tawɩ sɛ, &lt;&lt;Panɛ lofu mɩnaŋ, naa wʋkpa a.&gt;&gt; <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Gabʋanaŋ sɛ Kpaŋjuo gabʋɔ jɔ Hɛrɔdɩ lɔ akala takɩɛ wʋ n mʋ kalɩɛwʋ fa Ɩsʋɔ ɔ, sɛ sieliesi di ɩ sɛ wʋ sɩŋ.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Ama Ɩsʋɔ wɩɛ ŋii ju dʋɔ bɩɩ sɛ ŋɩ yalagi.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Gʋ Banabasi na Sɔɔlʋ taŋ ba dɩtʋm na, ba lɩɩ Yerusalem bɔrɛ ju Antiyokiya, sɛ ba mʋ Yohane wʋŋ ba ti baa yagɛ ɩ sɛ Maakɩ na kpi ba wʋsɛ dʋɔ.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s1">Ba lɩsɛ Banabasi na Sɔɔlʋ kpiri ba</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Ɩsʋɔ bajana na bakalaasa barɛ wɩɛ lɩɛdɩra dikpeŋ gaa ga wɩɛ Antiyokiya na naŋ. Baa n nyina Banabasi, Simiyoŋ wʋŋ baa yagɛ ɩ sɛ Niga, Lusiyosi wʋŋ wʋ lɩɩ Kireni, Manayeŋ [wʋŋ Hɛrɔdɩ Teteraki bɩsɛ ɩ] na Sɔɔlʋ. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Gʋ baa tʋŋ Ɩsʋɔ yela baa chaŋ nʋɔ pɔgʋ na, Ɩsʋɔ Feliŋ tawɩ ba sɛ, &lt;&lt;Ba n lɩsɛ Banabasi na Sɔɔlʋ fa maŋ na baa ga yɩɛ dɩtʋm gaa ga dʋɔ sɛ ma yagɛ ba na.&gt;&gt; <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Dɩmʋŋ dʋɔ gʋ ba chaŋ nʋɔ pɔgʋ sɛ ba jɔ dɩga taŋ na, ba mʋ ba pamɩɛ jaga ba dʋɔ lɩsɛ ba gbɩɛ.<verse eid="ACT 13:3" /></para>
  <para style="s1">Banabasi na Sɔɔlʋ wɩɛ Kipurosi dɩɛ naŋ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Sɛ Ɩsʋɔ Feliŋ kpiri Banabasi na Sɔɔlʋ sɛ ba n ju Selusiya, sɛ ba mʋna lɩŋ dʋɔ lɩɩ dɩmaŋ ju Kipurosi dɩchafɩya dʋɔ. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Gʋ ba tala Salamisi na, ba tawɩ Ɩsʋɔ wɩɛ abama ŋii Yudatina tʋm danɩŋ naŋ. Yohane cha wʋ wɩɛ ba jaŋ takɩɛ ba Chɔnarɛ.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Ba keleŋsi dɩchafɩya gaa kpiniŋ dʋɔ hali ba gaa tala Pafosi. Dɩmaŋ sɛ ba ga mɩɛna Yuda wʋkpa wʋrʋ wʋŋ wʋ yɩɛ majigi-tɛ na akarɩɛ ɔja, baa yagɛ ɩ sɛ Baa-Yesu. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Wʋ wɩɛ Roma tibi dʋɔ kɩɛra Segiyosi Pɔɔlʋ jaŋ. Roma tibi dʋɔ kɩɛrɛ cha wʋ yɩɛ wɩɛ jɩmɩrɛ bɛ. Wʋ kpiri yagɛ Banabasi na Sɔɔlʋ akala takɩɛ wʋ ja sɛ wʋ a nyii Ɩsʋɔ wɩɛ. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Ama Elimasi, majigi-tɛ wʋŋ [ganaŋkʋ wʋ yɩrɛ tie a kalaa na mɩnaŋ] kʋlʋ gaa ba gbɩɛ sɛ wʋ aa ja sɛ Roma tibi dʋɔ kɩɛrɛ wʋŋ a lɩɛdi i. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Sɛ Sɔɔlʋ wʋŋ ba ti baa yagɛ ɩ sɛ Pɔɔlʋ wʋŋ Ɩsʋɔ Feliŋ su wʋ tɩba na, kɩɛ Elimasi surumm sɛ wʋ tawɩ ɩ sɛ, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />&lt;&lt;Nya yɩɛ Ɩsʋɔ ɔdʋŋ bu na bʋrʋkʋma gaa ga wɩɛ dieli na ɔdʋŋ bɛ. Bakpa pɩna na sisi n su n tɩba sɛ nyaa ja sɛ nyaa biliŋi Ɩsʋɔ chirigi gbɩɛ mʋ yɩɛ akarɩɛ. <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Dɩtɩɛna Ɩsʋɔ a ja fɔŋɩ n dɩla. Nya asa aja salɩɛ sɛ nya aa ti na wiita ga tala saŋa garɛ ɛ.&gt;&gt;</para>
  <para style="p" vid="ACT 13:11">Gabʋanaŋ sɛ giteŋteŋbiri kɔŋ wʋ asa dʋɔ, sɛ wʋ dɔŋ wʋ a logo wʋ a ja wʋŋ wʋ a chaŋ wʋ pam naŋ kalaa ɩ gbɩɛ.<verse eid="ACT 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 13:12" />Gʋ Roma tibi dʋɔ kɩɛrɛ wʋŋ na bʋrʋ gaa ga tibi na, wʋ lɩɛ di, akala takɩɛ Kpaŋjuo wʋsɛ dʋɔ wɩɛ kalaa ŋii yɩɛ ɩ doba.<verse eid="ACT 13:12" /></para>
  <para style="s1">Pɔɔlʋ wɩɛ Antiyokiya gaa ga wɩɛ Pisidiya dɩɛ naŋ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Sɛ Pɔɔlʋ na wʋ dɔŋa baa lɩɩ Pafosi mʋna lɩŋ dʋɔ kɔŋ Pɛgɩ dɩɛ gaa ga wɩɛ Pamfiliya tibi dʋɔ. Dɩmaŋ sɛ Yohane yela ba sɛ wʋ bɔrɛ ju Yerusalem. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Ba lɩɩ Pɛgɩ ju Antiyokiya gaa ga wɩɛ Pisidiya tibi dʋɔ. Gʋ Fɩɛsɛ wɩɩ talɛ na, ba ju Yudatina tʋm danɛ gaa naŋ ga cha. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Gʋ ba karaŋ lɩɩ Mosesi mbara na Ɩsʋɔ bajana tanɛ naŋ taŋ na, Yudatina tʋm danɛ asanaŋtina baa kpiri sɛ ba n gaa tawɩ ba sɛ, &lt;&lt;Daa dɔŋa Yudatina, sɛ ɩ wɩɛna wɩɛ ŋarɛ ɩ tawɩ dʋ bakpa bana na, n tawɩ.&gt;&gt;<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Sɛ Pɔɔlʋ kʋlʋ ŋɩrɛ ba pam sɛ wʋ tawɩ sɛ, &lt;&lt;Ma dɔŋa Isiralitina na amɩɛ baa ɩ ba yɩɛ Yudatina sɛ ɩɩ tʋm Ɩsʋɔ, n nyii ma jaŋ. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Isiralitina Ɩsʋɔ lɩsɛ daa duluŋ sɛ wʋ yela sɛ ba yɩɛ dieli saŋa gaa ba wɩɛ Ijipiti tibi dʋɔ, sɛ wʋ mʋ wʋ doŋ janɛ lɩsɛ ba lɩɩ dɩmʋŋ tibi gana dʋɔ. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Ŋɩ wɩɛ tɩba takɩɛ ba kʋlʋ sɩŋ Ɩsʋɔ dʋɔ bɩrɛ, ama wʋ kɩɛ ba dʋɔ bɩŋsɛ ŋɩla ifuli dʋɔ. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Ɩsʋɔ yela sɛ ba yuo di atawɩ yɩrɩ lɩkarɛ Kana tibi dʋɔ sɛ wʋ mʋ ba tibi fa wʋ bakpa takɩɛ ba gapatɩɛ.&gt;&gt; <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Ŋina kpiniŋ di aja yɩɛ takɩɛ bɩŋsɛ gafisi sɩ nara na ŋɩla na sala (450).</para>
  <para style="p" vid="ACT 13:20">Ŋina wʋrʋgbɩɛ na, Ɩsʋɔ fa ba wɩɛ dira ga tala Ɩsʋɔ ɔja Samuweli saŋa.<verse eid="ACT 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 13:21" />Dɩmaŋ sɛ bakpa baa tasɛ ɩ sɛ wʋ n fa ba juo, sɛ wʋ fa ba Kisi bu Sɔɔlʋ wʋŋ wʋ lɩɩ Benyamiŋ buonɔ. Sɛ wʋ di juori bɩŋsɛ ŋɩla (40). <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Gʋ Ɩsʋɔ kʋna Sɔɔlʋ juori dʋɔ na, wʋ mʋ Dawidi si ba juo. Sɛ wʋ di wʋ wʋsɛ dʋɔ seriya sɛ, &lt;&lt;Ma na Yese bu Dawidi takɩɛ wʋ yɩɛ baalɛ wʋŋ maa ja wʋ wɩɛ ma digela naŋ, wʋŋ aaŋ ja wʋ a yɩɛ bʋrʋkʋma gaa maa ja sɛ wʋ n yɩɛ na.&gt;&gt;<verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />Sɛ Petero ju dʋɔ tawɩ sɛ, &lt;&lt;Lɩɩ dɩmʋŋ baalɛ wina gananabisi naŋ sɛ Ɩsʋɔ lɩsɛ Yesu Mɔlɔgɩrɛ wʋŋ fa Isiralitina takɩɛ ganaŋkʋ wʋ tawɩ si na. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Pɔɩ na Yesu a kɔŋ na, Yohane cha tawɩ biliŋi lɩɩ dɩsʋbʋ naŋ na Ɩsʋɔ sɔ wɩɛ fa Isiralitina kpiniŋ. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Gʋ Yohane a taŋ wʋ dɩtʋm na, wʋ tawɩ sɛ Mmʋɔ sɛ ɩɩ fa nfɩɛrɛ sɛ ma yɩɛ? Ma ba yɩɛ ɩ ɩ. Ama wʋŋ wʋ a kɔŋ ma wʋrʋgbɩɛ na, ma n daga na maa luuŋ buoli wʋ asibita ganyasɛ ɛ.&gt;&gt;<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Ma dɔŋa Isiralitina Abiraham gananabisi, na amɩɛ baa ɩ ba yɩɛ Yudatina sɛ ɩɩ se Ɩsʋɔ na, daa sɛ ba kɔna nkpa mɔlɔgɩ wɩɛ ŋina. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Yerusalemtina na ba asanaŋtina n jiŋ Yesu u, ama dɩpʋɛ gaa ba fu ɩ na yela sɛ Ɩsʋɔ bajana baa wɩɛ ŋii baa karaŋ Fɩɛsɛ wɩɩ kʋma na, kɔŋ tɩba <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Ŋɩ wɩɛ tɩba takɩɛ ba n yu bʋrʋ garɛ gba sɩŋ dʋɔ na ba fu ɩ sɩŋ dɩpʋɛ ɛ, ama ba tawɩ Pilato sɛ wʋ n kʋ ɩ. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Gʋ ba yɩɛ bʋrʋ gaa ba sabɩɛ lɩɩ wʋ wʋsɛ dʋɔ kpiniŋ taŋ na, ba tibi na ɩ lɩɩ daŋ gasagasa gaa dʋɔ mʋ ɩ ga wuu bʋɔ naŋ, <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Ama Ɩsʋɔ feŋsi ɩ lɩɩ sɩŋ naŋ, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />sɛ gɩyɩɛnɩŋ fɔɩ ŋina naŋ na, baa wʋ na ba cha pala lɩɩ Galaliya ju Yerusalem na na ɩ. Dɩtɩɛna, baa n nyina wʋ seriya dira fa daa bakpa.&gt;&gt;<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />Sɛ wʋ ju dʋɔ tawɩ sɛ dɩɩ tawɩ wɩɛ abama ŋii Ɩsʋɔ cha tawɩ si fa daa duluŋ na fa amɩɛ, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />wʋ yela sɛ ŋɩ kɔŋ tɩba fa daa baa dɩ yɩɛ ba gananabisi sɛ wʋ feŋsi Yesu takɩɛ ganaŋkʋ ba sabɩɛ Numba alatɛ naŋ sɛ,</para>
  <para style="q1" vid="ACT 13:33">&lt;&lt;Nya yɩɛ mabu,</para>
  <para style="q2" vid="ACT 13:33">jaŋ ma yɩɛ Njuo.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Num 2:7</ref>.</char></note><verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Ɩsʋɔ feŋsi Yesu lɩɩ sɩŋ naŋ, na wʋ n baa ti bɔrɛ sɩŋ. Ganaŋkʋ Ɩsʋɔ tawɩ sɛ,</para>
  <para style="q1" vid="ACT 13:34">&lt;&lt;Maa yɩɛ amɩɛ kusee chɩrɩchɩrɩ gaa ma tawɩ si sɛ maa mʋ fa Dawidi na.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">Yis 55:3</ref>.</char></note><verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Sɛ ba ti sabɩɛ Numba naŋ gatʋŋgʋrʋ sɛ,</para>
  <para style="q1" vid="ACT 13:35">&lt;&lt;Nya aa yela na nbu dɩchɩrɩchɩrɩtɛ wʋŋ a dara a.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">Num 16:10</ref>.</char></note><verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />&lt;&lt;Akala takɩɛ gʋ Dawidi tʋŋ wʋ tɩŋtɩŋ wʋ saŋa ŋii Ɩsʋɔ a jawʋ na, wʋ sɩŋ sɛ ba wuu ɩ wʋ duluŋ jaŋ sɛ wʋ wʋsɛ darɛ. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Ama wʋŋ Ɩsʋɔ feŋsi ɩ lɩɩ sɩŋ naŋ bɩrɛ, wʋ n dara a.&gt;&gt;<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />Dɩmʋŋ dʋɔ ma dɔŋa Isiralitina, maa ja sɛ ɩ jiŋ gʋ lɩɩna Yesu dʋɔ dɩ tawɩ dɩsʋbʋ mʋ chɩɛ wɩɛ fa amɩɛ. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Lɩɩna wʋ dʋɔ sɛ wʋkʋma wʋŋ wʋ lɩɛ di na, wʋ chirigi Ɩsʋɔ asanaŋ lɩɩ bʋrʋkʋma gaa Mosesi mbara ŋii n dɩlɛ yela na wʋ a chirigi Ɩsʋɔ asanaŋ na. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />N kɩɛ na dieli na bʋrʋ gaa Ɩsʋɔ bajana baa tawɩ na, n baa kɔŋ amɩɛ dʋɔ takɩɛ,<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />&lt;&lt;N nyii, amɩɛ jabira,</para>
  <para style="q2" vid="ACT 13:41">ŋii yɩɛ amɩɛ mamachi na ɩ sɩŋ,</para>
  <para style="q1" vid="ACT 13:41">akala takɩɛ maa yɩɛ bʋrʋ garɛ amɩɛ saŋa</para>
  <para style="q2" vid="ACT 13:41">hali wʋrʋ tawɩ amɩɛ gba</para>
  <para style="q2" vid="ACT 13:41">ɩ ɩɩ lɩɛ ɩ di i.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">13:41 </char><char style="xt" closed="false"><ref loc="HAB 1:5">Haba 1:5</ref>.</char></note><verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Gʋ Pɔɔlʋ na Banabasi a lɩɩ Yudatina tʋm danɛ gaa naŋ na, bakpa baa sʋlʋ ba sɛ ba n bɔrɛ kɔŋ Fɩɛsɛ wɩɩ gaa gaa kɔŋ na, na baa ti gaa tawɩ lɩɩna dɩmʋŋ wɩɛ ŋina dʋɔ. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Gʋ bakpa baa lɩɩ dijaŋitiŋ gaa na, Yudatina baa na baa ba bɩrɩŋsɛ gaa tʋŋ Yudatina tʋm fɔɩ kpamɩna Pɔɔlʋ na Banabasi. Sɛ ba tawɩ fa ba sɛ ba n ju dʋɔ cha Ɩsʋɔ wɩɩ ŋii naŋ.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Gʋ Fɩɛsɛ wɩɩ gaa ga kpamɩna talɛ na, dɩɛ janɛ gaa kpiniŋ jaŋi na baa nyii Ɩsʋɔ wɩɛ. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Gʋ Yudatina baa na jama baa na, dɩsɛchɩbɛ su ba sɛ ba di wɩɛ kʋma ŋii Pɔɔlʋ tawɩ na noro, sɛ ba ti ɩ.<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />Dɩmaŋ sɛ Pɔɔlʋ na Banabasi mʋ digela tawɩ ba sɛ, &lt;&lt;Dɩ daga na dɩɩ chɩŋkpɩɛ tawɩ Ɩsʋɔ wɩɛ ŋii fa amɩɛ. Ama gʋ ɩ pɩɛ ŋɛ sɛ ɩŋ kɩɛ amɩɛ wʋsɛ takɩɛ ɩ daga nkpa ŋii ŋɩ taŋ gɩtɛ. Ŋina dʋɔ, dɩtɩɛna dɩɩ yela amɩɛ na dɩɩ ju baa ba ba yɩɛ Yudatina na jaŋ. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Akala takɩɛ ŋina n nyina ŋii Kpaŋjuo Ɩsʋɔ dʋ daa takɩɛ,</para>
  <para style="q1" vid="ACT 13:47">&lt;&lt;Ma yɩɛ amɩɛ ŋmaŋi fa baa ba ba yɩɛ Yudatina,</para>
  <para style="q2" vid="ACT 13:47">ganaŋkʋ ɩɩ kɔna nkpa mɔlɔgɩ tibi dʋɔ gapɩlɛkʋma.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="ISA 49:6">Yis 49:6</ref>.</char></note><verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Gʋ baa ba ba yɩɛ Yudatina nyii ŋina na, dɩ yɩɛ ba jʋŋ sɛ ba mʋ jilima fa Ɩsʋɔ wɩɛ ŋii, na baa ba lɩsɛ ba na kpiniŋ sɛ ba n yu nkpa ŋii ŋɩ taŋ gɩtɛ sɛ lɩɛ di.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />Sɛ Kpaŋjuo wʋŋ wɩɛ ŋii yalagi tibi gaa dʋɔ gapɩlɛkʋma. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Ama Yudatina baa fuosi dʋ dɩɛ janɛ gaa asanaŋtina na ala baa baa se Ɩsʋɔ sɛ ba yɩɛ ba kpari na. Sɛ ba yela sɛ bakpa nyala Pɔɔlʋ na Banabasi, sɛ ba geŋ ba lɩɩ ba tibi dʋɔ. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Dɩmʋŋ dʋɔ ba kpisi ba nafara tie dibuu wʋrʋgɩ na ŋii chicha ba. Sɛ ba ju Ikoniyom dɩɛ naŋ. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Sɛ asadi na Ɩsʋɔ Feliŋ su kpalɛnara baa tɩba.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s1">Pɔɔlʋ na Banabasi wɩɛ Ikoniyom</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Gʋ Pɔɔlʋ na Banabasi wɩɛ Ikoniyom dɩɛ naŋ na, ba ju Yudatina tʋm danɛ naŋ ganaŋkʋ ba cha baa yɩɛ na. Sɛ ba tawɩ Ɩsʋɔ wɩɛ sɛ Yudatina na baa ba ba yɩɛ Yudatina fɔɩ lɩɛ di. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Ama Yudatina baa ba n lɩɛ di na fuosi dʋ baa ba ba yɩɛ Yudatina tawɩ warɩɛ ba nfɩɛrɛ sɛ ba kʋlʋ sɩŋ lɩɛdɩra baa dʋɔ. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Dɩmʋŋ dʋɔ Pɔɔlʋ na Banabasi cha dɩmaŋ taŋgɩlɛ. Sɛ ba mʋ digela doŋ tawɩ Kpaŋjuo wʋsɛ dʋɔ wɩɛ. Sɛ wʋ yela sɛ ba yɩɛ adaŋgana daasɛ na mamachi wɩɛ mʋ kalaa sɛ wɩɛ ŋii ba tawɩ lɩɩna Ɩsʋɔ wɩɩ dʋɔ na yɩɛ gasiŋteŋ. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Sɛ dɩɛ janɛ gaa bakpa baa kpara tɩba, barɛ kpaŋ Yudatina sɛ barɛ dʋɔ kpaŋ kpirida baa. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />Sɛ baa ba ba yɩɛ Yudatina, Yudatina na ba asanaŋtina fa nfɩɛrɛ jɔ dɩkɔŋ sɛ baa nyala ba na baa lɔ bʋɛ kʋ ba. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Ama gʋ kpalɛnara baa jiŋ ŋina na dʋɔ, ba se ju Lisitira na Dɛbɩ ŋii ŋɩ yɩɛ Likoniya dɩɛsɛ ajanɩɛ, na dɩɛsɛ ŋii ŋɩ logo, <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />dɩmaŋ sɛ ba ju dʋɔ tawɩ wɩɛ abama ŋii.<verse eid="ACT 14:7" /></para>
  <para style="s1">Pɔɔlʋ na Barabasi wɩɛ Lisitira na Dɛbɩ dɩɛsɛ naŋ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Baalɛ wʋrʋ cha wʋ wɩɛ Lisitira dɩɛ naŋ, wʋ yɩɛ buobi bɛ, sɛ ba lʋrʋ ɩ wʋ jaɩ-jaɩ sɛ wʋ n pala gɩyɩɛ gʋrʋ ʋ. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Wʋ nyii wɩɛ ŋii Pɔɔlʋ a tawɩ na. Sɛ Pɔɔlʋ kɩɛ ɩ kurum na gʋ wʋ wɩɛna lɩɛdi gʋ wʋ a dɩlɛ yu lʋm chʋɔ, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />sɛ Pɔɔlʋ kuusi tawɩ sɛ, &lt;&lt;Kʋlʋ sɩŋ n nafara dʋɔ.&gt;&gt; Baalɛ wʋŋ nyii ŋina na, wʋ puli sɛ wʋ fara wʋ dɔŋ.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />Gʋ jama baa na ŋii Pɔɔlʋ yɩɛ na, ba kuusi Likoniya dɩtawɩ naŋ sɛ, &lt;&lt;Panɩŋ baa kɔŋ daa jaŋ takɩɛ bakpa.&gt;&gt; <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Sɛ ba fa Banabasi yɩrɛ sɛ Siyosi sɛ ba fa Pɔɔlʋ dʋɔ yɩrɛ sɛ Hemisi akala takɩɛ wʋŋ n nyina ba tawɩrɛ. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Sɛ panɛ Siyosi tʋm danɛ wɩɛ dɩɛ janɛ gaa laraŋ sɛ ga sei kɔna naa baalɛ na fʋagɩɛ dɩɛ janɛ gaa buonɔ, akala takɩɛ wʋ na jama baa a ja sɛ baa diesi gadiesa fa ba.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Ama gʋ kpirida baa Banabasi na Pɔɔlʋ nyii dɩmʋŋ na, ba chati ba abʋrɩ afuusa sɛ ba se jʋʋ jama baa tɩba kuusi sɛ, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />&lt;&lt;Baala, be n yɩɛ sɛ ɩ yɩɛ ŋina? Daa gba dɩ yɩɛ bakpa bɛ takɩɛ amɩɛ. Dɩ chamɩna wɩɛ abama ŋii bɛ dɩɩ kɔna amɩɛ sɛ dɩɩ tawɩ amɩɛ sɛ n yela panɩŋ ŋii ŋɩ yɩɛ kpakpuo na tʋm, na ɩ kɔŋ Ɩsʋɔ wʋkɩɛnasa wʋŋ jaŋ, wʋŋ wʋ yɩɛ Ɩsʋɔ adugbe, tie, ɔpʋ na bʋrʋkʋma gaa ga wɩɛ ŋɩ tɩba. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Saŋa gaa ga lam na, Ɩsʋɔ yela sɛ atawɩ yɩrɩ kpiniŋ pala na ba tɩŋtɩŋ ba gbɩɛsɛ dʋɔ. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Ama Ɩsʋɔ yɩɛ bʋrʋ bam mʋ di wʋ wʋsɛ dʋɔ seriya. Wʋ yɩɛ wʋbam sɛ wʋ yela sɛ duoni nɩɛ lɩɩ Ɩsʋɔ adugbe sɛ adiya yɩɛ dieli ŋɩ saŋa dʋɔ kʋrʋkʋrʋ, wʋ fa amɩɛ adiya fɔɩ sɛ wʋ yela sɛ amɩɛ asadi.&gt;&gt; <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Hali gʋ ba tawɩ wɩɛ ŋina na gba, dɩ yɩɛ wiliŋ fa ba sɛ ba n dɩlɛ gaa jama baa gbɩɛ na ba n baa diesi gadiesa fa ba.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Dɩmaŋ sɛ Yudatina barɛ baa ba lɩɩ Antiyokiya na Ikoniyom tawɩ biliŋi jama baa sɛ ba n kʋlʋ sɩŋ Pɔɔlʋ na Banabasi dʋɔ. Sɛ ba lɔ Pɔɔlʋ bʋɛ sɛ ba fɔŋɩ ɩ lɩɩ dɩɛ janɛ gaa laraŋ, sɛ ba nfɩɛrɛ yɩɛ ba takɩɛ wʋ sɩŋ. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Ama gʋ kpalɛnara baa sɩla logo ɩ wʋrʋgbɩɛ na, wʋ kʋlʋ sɩŋ sɛ wʋ bɔrɛ ju dɩɛ janɛ gaa naŋ. Gʋ tɩɛna na, wʋ na Banabasi lɩɩ dɩmaŋ ju Dɛbɩ.<verse eid="ACT 14:20" /></para>
  <para style="s1">Pɔɔlʋ na Barabasi bɔrɛ ju Antiyokiya gaa ga wɩɛ Siriya tibi dʋɔ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Pɔɔlʋ na Banabasi tawɩ wɩɛ abama ŋii dɩmʋŋ dɩɛ janɛ gana naŋ sɛ ba yu kpalɛnara fɔɩ. Sɛ ba bɔrɛ kɔŋ Lisitira, Ikoniyom na Antiyokiya, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />yela baa dʋ kpalɛnara baa doŋ, sɛ ba tawɩ dʋ ba sɛ ba n sɩŋ gasiŋteŋ ba lɩɛdi naŋ. Sɛ ba ti tawɩ ba sɛ, &lt;&lt;Ŋɩ tiri gʋ dɩɩ pala awʋrʋfʋɔ fɔɩ naŋ na dɩɩ jʋʋ Ɩsʋɔ juori gaa naŋ.&gt;&gt; <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Sɛ Pɔɔlʋ na Banabasi lɩsɛ lɩɛdɩra dikpeŋ bɩnɩɛ fa lɩɛdɩra dikpeŋ kʋma. Ba pɔgʋ nʋɔ jɔ dɩga mʋ ba dʋ Kpaŋjuo wʋŋ ba mʋ ba wʋsɛ lɔ wʋ dʋɔ na pamɩɛ naŋ. <verse eid="ACT 14:23" /><verse number="24" style="v" sid="ACT 14:24" />Gʋ ba mʋna Pisidiya tibi dʋɔ wʋrʋgbɩɛ na, ba kɔŋ Pamfiliya tibi dʋɔ. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Gʋ ba tawɩ Ɩsʋɔ wɩɛ ŋii Pɛgɩ dɩɛ naŋ na, ba ju dʋɔ ju Ataliya dɩɛ naŋ.<verse eid="ACT 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26" />Ba lɩɩ Ataliya na, ba mʋna lɩŋ dʋɔ bɔrɛ kɔŋ Antiyokiya, dɩmaŋ sɛ ba mʋ dʋ Ɩsʋɔ pamɩɛ naŋ sɛ wʋ n fa ba wʋ wɩɩ sɛ ba taŋ dɩtʋm gaa kʋrʋkʋrʋ. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Gʋ ba tala dɩmaŋ na, ba yagɛ lɩɛdɩra dikpeŋ gaa sɩla dikulie, sɛ ba tawɩ bʋrʋ gaa Ɩsʋɔ pala na ba dʋɔ yɩɛ na kpiniŋ na ganaŋkʋ wʋ fulu lɩɛdi gbɩɛ fa baa ba ba yɩɛ Yudatina na. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Sɛ ba cha kpalɛnara baa jaŋ taŋgɩlɛ.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s1">Dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa sɩla Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Baala barɛ lɩɩ Yudiya tibi dʋɔ kɔŋ Antiyokiya baa kalaa lɩɛdɩra baa sɛ, &lt;&lt;Ba n kara amɩɛ baŋlɛ takɩɛ ganaŋkʋ Mosesi mbara a kalaa na, ɩ ɩɩ dɩlɛ yu mɔlɔgɩ ɩ.&gt;&gt; <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Ŋina yela sɛ ba na Pɔɔlʋ na Banabasi di noro gaa ga nʋɔ wɩɛ doŋ. Dɩmʋŋ dʋɔ ba lɩsɛ Pɔɔlʋ na Banabasi na lɩɛdɩra barɛ sɛ ba n ju Yerusalem ga na kpirida na lɩɛdɩra dikpeŋ bɩnɩɛ lɩɩna wɩɛ tasɛ ŋina dʋɔ. <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />Lɩɛdɩra dikpeŋ gaa lɩsɛ ba gbɩɛ. Gʋ baa ju na ba mʋna Fonisiya na Samariya sɛ ba tawɩ ganaŋkʋ baa ba ba yɩɛ Yudatina biliŋi kɔŋ Ɩsʋɔ jaŋ. Wɩɛ ŋina yela sɛ dɩ yɩɛ lɩɛdɩra baa jʋŋ fɔɩ. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Gʋ ba tala Yerusalem na, lɩɛdɩra dikpeŋ gaa, kpirida na lɩɛdɩra dikpeŋ bɩnɩɛ baa lɩɛ ba sɛ ba tawɩ bʋrʋkʋma gaa Ɩsʋɔ pala na ba dʋɔ yɩɛ na.<verse eid="ACT 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5" />Dɩmaŋ sɛ lɩɛdɩra barɛ baa ba kpi Farasitina dikpeŋ gaa dʋɔ na kʋlʋ sɩŋ tawɩ sɛ, &lt;&lt;Ŋɩ tiri gʋ baa ba ba yɩɛ Yudatina a kara ba baŋlɛ na dɩɩ dʋ ba sɛ ba n kpaŋ Mosesi mbara ŋii dʋɔ.&gt;&gt;<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Sɛ kpirida na lɩɛdɩra dikpeŋ bɩnɩɛ baa sɩla na baa kɩɛ wɩɛ tasɛ ŋina tɩba. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Gʋ ba tawɩ-tawɩ wɩɛ ŋii dʋɔ taŋgɩlɛ wʋrʋgbɩɛ na, Petero kʋlʋ sɩŋ tawɩ ba sɛ, &lt;&lt;Ma dɔŋa lɩɛdɩra, ɩ jiŋ gʋ saŋa gaa ga lam na, Ɩsʋɔ lɩsɛ maŋ lɩɩ amɩɛ tɩba sɛ ma n tawɩ wɩɛ abama ŋii fa baa ba ba yɩɛ Yudatina, na baa nyii na baa lɩɛ di. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Ɩsʋɔ wʋŋ wʋ jiŋ digela naŋ na, fa ba wʋ Feliŋ takɩɛ ganaŋkʋ wʋ fa daa na, na ŋii kalaa sɛ wʋ lɩɛ ba dʋ. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Ɩsʋɔ n yɩɛ daa na ba ngoriŋ-ngoriŋ ŋ, akala takɩɛ ba lɩɛdi dʋɔ wʋ yɩɛ ba agela dɩchɩrɩchɩrɩ. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Dɩmʋŋ dʋɔ, dɩtɩɛna be n yɩɛ sɛ ɩ ja sɛ ɩ yɩɛ Ɩsʋɔ lɔ tɩba, takɩɛ ɩɩ mʋ gasʋlasɛ ayuntina ŋii daa yaa daa duluŋ n dɩlɛ sɩlɛ na ɩɩ sɩlɛ kpalɛnara baa? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Aye! Dɩ lɩɛ di gʋ ŋɩ pala na Kpaŋjuo Yesu Ɩsʋɔ wɩɩ dʋɔ sɛ dɩ yu mɔlɔgɩ, takɩɛ baa.&gt;&gt;<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Sɛ bakpa baa ba sɩla dɩmaŋ na kpiniŋ yɩɛ surumm baa nyii Banabasi na Pɔɔlʋ jaŋ gʋ baa tawɩ ba adaŋgana daasɛ na mamachi ŋii Ɩsʋɔ pala na ba dʋɔ yɩɛ baa ba yɩɛ Yudatina tɩba na. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Gʋ ba tawɩ taŋ na, Jamesi lɩsɛ nʋɔ sɛ, &lt;&lt;Ma dɔŋa lɩɛdɩra, n nyii ma jaŋ. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Simoŋ tawɩ daa ganaŋkʋ Ɩsʋɔ chɩŋkpɩɛ kalaa baa ba ba yɩɛ Yudatina na sɛ ba wɩɛ tiri ɩ, sɛ wʋ lɩsɛ ba tɩba barɛ fa wʋ wʋsɛ. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Ŋii Ɩsʋɔ bajana baa tawɩ na dɩmʋŋ wɩɛ ŋina yɩɛ bʋdʋŋdʋlʋŋ ganaŋkʋ ba sabɩɛ sɛ,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />&lt;&lt;Ŋina wʋrʋgbɩɛ na, maa ti bɔrɛ kɔŋ</para>
  <para style="q2" vid="ACT 15:16">na maa bɔrɛ ma Dawidi dukuru diko gaa ga warɩɛwʋ.</para>
  <para style="q1" vid="ACT 15:16">Maa bɔrɛ ma ŋii ŋɩ salɩɛ na,</para>
  <para style="q2" vid="ACT 15:16">na maa ti kʋna ga sɩŋ na dieli.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Sɛ bakpa baa ba kakaa na aja ja Kpaŋjuo</para>
  <para style="q2" vid="ACT 15:17">na baa ba ba yɩɛ Yudatina sɛ ma yɩrɛ jaga ɩ ba dʋɔ na kpiniŋ,</para>
  <para style="q1" vid="ACT 15:17">Kpaŋjuo wʋŋ wʋ yɩɛ ŋina,<verse eid="ACT 15:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18" />sɛ wʋ lɩsɛ kalaa saŋa gaa ga lam taŋgɩlɛ na, n tawɩ dɩmʋŋ.&gt;&gt;<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />Sɛ Yakubu ju dʋɔ tawɩ sɛ, &lt;&lt;Ma nfɩɛrɛ n nyina sɛ n baa yela na dɩɩ yɩɛ ŋɛ wiliŋ fa baa ba ba yɩɛ Yudatina sɛ baa biliŋi baa kɔŋ Ɩsʋɔ jaŋ na. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Ama dɩ daga na dɩɩ sabɩɛ tanɛ ga fa ba tawɩ ba sɛ ba n baa di adiya ŋii ba mʋ diesi gadiesa fa panɩŋ, ba n lɩsɛ ba wʋsɛ lɩɩ danaŋburidi naŋ, ba n baa tawʋ namɩɛ baa ba ŋɩrɛ ba kʋ sɛ ba n baa di asima. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Akala takɩɛ ba tawɩ Mosesi mbara ŋii dɩɛ kʋma naŋ taŋgɩlɛ fɔɩ, sɛ ba karaŋ ŋɛ Yudatina tʋm danɩŋ naŋ Fɩɛsɛ wɩɩ kʋma.&gt;&gt;<verse eid="ACT 15:21" /></para>
  <para style="s1">Ba sabɩɛ tanɛ juna baa ba ba yɩɛ Yudatina lɩɛdɩra</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Sɛ kpirida, lɩɛdɩra dikpeŋ bɩnɩɛ baa na lɩɛdɩra dikpeŋ gaa kpiniŋ fa nfɩɛrɛ sɛ ba n lɩsɛ ba tɩba barɛ na baa kpiri ba na Pɔɔlʋ na Banabasi ju Antiyokiya. Ba lɩsɛ Yudasi [wʋŋ baa yagɛ ɩ sɛ Basabasi] na Silasi. Baala bala baa ba yɩɛ lɩɛdɩra baa tɩba asanaŋtina. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Sɛ ba sabɩɛ wɩɛ ŋina dʋ tanɛ naŋ mʋ kpiri ba sɛ,</para>
  <para style="pmo" vid="ACT 15:23">Dɩɩ yɩlɩ amɩɛ.</para>
  <para style="pmo" vid="ACT 15:23">Kpirida na lɩɛdɩra dikpeŋ bɩnɩɛ baa na amɩɛ dɔŋa lɩɛdɩra kpiniŋ.</para>
  <para style="pmo" vid="ACT 15:23">Dɩɩ sabɩɛ tanɛ gana dɩɩ fa amɩɛ baa ɩ ba yɩɛ Yudatina lɩɛdɩra baa ɩ wɩɛ Antiyokiya, Siriya na Kilikiya na kpiniŋ.<verse eid="ACT 15:23" /></para>
  <para style="pm">
    <verse number="24" style="v" sid="ACT 15:24" />Dɩ nyii gʋ daa tɩba barɛ baa dɩ n fa ba gbɩɛ kɔŋ amɩɛ jaŋ baa tawɩ wɩɛ ŋarɛ baa nyala amɩɛ yela baa warɩɛ amɩɛ nfɩɛrɛ. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Dɩmʋŋ dʋɔ daa kpiniŋ dɩ kpa gʋ dɩɩ lɩsɛ baala barɛ kpi daa dɩɛtina Banabasi na Pɔɔlʋ dʋɔ kpiri ba amɩɛ jaŋ. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />Baa n nyina baa ba mʋ ba nkpa si fa daa Kpaŋjuo Yesu Kirisito yɩrɛ gaa. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Dɩmʋŋ dʋɔ dɩɩ kpiri Yudasi na Silasi amɩɛ jaŋ na ba tɩŋtɩŋ baa tawɩ amɩɛ wɩɛ adʋŋdʋlʋŋ ŋii dɩɩ sabɩɛ. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Ŋɩ wɩɛ dieli fa Ɩsʋɔ Feliŋ na daa takɩɛ dɩ n baa mʋ gasʋla yuŋtɛ sɩlɛ amɩɛ kpi mbara ŋina dʋɔ. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />Ŋii n nyina sɛ n baa di adiya ŋii ba mʋ diesi gadiesa fa panɩŋ na asima, n baa tawʋ namɩɛ baa ba ŋɩrɛ na kʋ na ɩ lɩsɛ amɩɛ wʋsɛ lɩɩ danaŋburidi naŋ. Sɛ ɩŋ yɩɛ dɩmʋŋ wɩɛ ŋina na, aja yɩɛ dieli fa amɩɛ.</para>
  <para style="pmc" vid="ACT 15:29">Dɩɩ kali amɩɛ.<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Sɛ ba tii ba gbɩɛ sɛ ba ju Antiyokiya, dɩmaŋ sɛ ba yagɛ lɩɛdɩra dikpeŋ gaa sɩla sɛ ba mʋ tanɛ gaa fa ba. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Gʋ bakpa baa karaŋ tanɛ gaa na, dɩ yɩɛ ba jʋŋ lɩɩna tawɩ dʋ wɩɛ ŋii dʋɔ. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yudasi na Silasi baa ba tɩŋtɩŋ ba yɩɛ Ɩsʋɔ bajana na, tawɩ wɩɛ fɔɩ mʋ tawɩ dʋ lɩɛdɩra baa sɛ ba dʋ ba doŋ naŋ. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Gʋ ba cha dɩmaŋ saŋa chonii na, lɩɛdɩra baa dʋɔ tii ba gbɩɛ wʋsɛfɩɛ naŋ na baa bɔrɛ kɔŋ baa ba kpiri ba na jaŋ. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Ama Silasi yɩɛ wʋ nfɩɛrɛ sɛ wʋ a dʋɔ dɩmaŋ.<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Naa Ɩsʋɔ Sabɩɛwɩɛ kpiniŋ n wɩɛna dɩmʋŋ wɩɛ ŋina a.</char></note> <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Ama Pɔɔlʋ na Banabasi dʋɔ Antiyokiya, dɩmaŋ sɛ ba na fɔɩ barɛ kalaa sɛ ba tawɩ Kpaŋjuo wɩɛ ŋii.<verse eid="ACT 15:35" /></para>
  <para style="s1">Pɔɔlʋ na Banabasi tɩtɩba kparɛ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Saŋa garɛ wʋrʋgbɩɛ na, Pɔɔlʋ tawɩ Banabasi sɛ, &lt;&lt;Yela dɩɩ bɔrɛ ju ga bʋɔ lɩɛdɩra baa ba wɩɛ dɩɛsɛ ŋii dɩ tawɩ Kpaŋjuo wɩɛ na kpiniŋ dʋɔ, na dɩɩ kɩɛ ganaŋkʋ ba chaɩ na.&gt;&gt; <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Banabasi aja sɛ wʋ a mʋ Yohane, wʋŋ ba ti baa yagɛ ɩ sɛ Maakɩ na kpi ba dʋɔ. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Ama Pɔɔlʋ n kpa sɛ wʋ n kpaŋ ba a, akala takɩɛ wʋ yela ba sɛ wʋ n cha ba jaŋ na baa ju dʋɔ yɩɛ dɩtʋm gaa Pamfiliya dɩɛ naŋ ŋ. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Sɛ noro gaa ga nʋɔ wɩɛ doŋ kɔŋ ba tɩtɩba sɛ ba kpara tɩba. Sɛ Banabasi mʋ Maakɩ mʋna lɩŋ dʋɔ ju Kipurosi, <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />ama Pɔɔlʋ lɩsɛ Silasi sɛ wʋ na ɩ ba lam, sɛ lɩɛdɩra baa mʋ ba dʋ Ɩsʋɔ pamɩɛ naŋ takɩɛ wʋ n fa ba wʋ wɩɩ. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Sɛ wʋ mʋna Siriya na Kilikiya yela wʋ a dʋ lɩɛdɩra akpeŋ ŋii doŋ.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s1">Timoti kpaŋ Pɔɔlʋ na Silasi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Sɛ Pɔɔlʋ kɔŋ Dɛbɩ, sɛ wʋ ju dʋɔ ju Lisitira dɩɛ naŋ, diele gaa kpalɛnarɛ wʋŋ baa yagɛ ɩ sɛ Timoti chaɩ. Wʋnaa yɩɛ Yuda wʋkpa lɩɛdɩrɛ bɛ, ama wʋjuo bɩrɛ yɩɛ Giriki wʋkpa bɛ. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Lɩɛdɩra baa ba wɩɛ Lisitira na Ikoniyom na tawɩ wʋ wʋsɛ dʋɔ wɩɛ abama. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Pɔɔlʋ aja sɛ wʋ a mʋ ɩ kpi wʋ wʋsɛ dʋɔ ju gbɩɛ, dɩmʋŋ dʋɔ wʋ kara wʋ baŋlɛ Yudatina baa ba chaɩ dɩmaŋ na kpiniŋ dʋɔ, akala takɩɛ ba jiŋ gʋ wʋ juo yɩɛ Giriki wʋkpa bɛ. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Gʋ ba pala lɩɩ dɩɛsɛ naŋ baa ju dɩɛsɛ naŋ na, ba tawɩ wɩɛ ŋii kpirida na lɩɛdɩra dikpeŋ bɩnɩɛ baa ba wɩɛ Yerusalem lɩɛ dʋ na fa bakpa baa sɛ ba n di dʋɔ. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Dɩmʋŋ dʋɔ lɩɛdɩra akpeŋ ŋii yɩɛ doŋ ŋɩ lɩɛdi naŋ yela ŋii bɩɩ wɩɩ kʋma.<verse eid="ACT 16:5" /></para>
  <para style="s1">Pɔɔlʋ yu Ɩsʋɔ lɩsɛ kalaa Tʋrasɩ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Sɛ Pɔɔlʋ na wʋ dɔŋa mʋna Firigiya na Galati tibi dʋɔ, akala takɩɛ Ɩsʋɔ Feliŋ n fa ba gbɩɛ sɛ ba n tawɩ Ɩsʋɔ wɩɛ Asiya tibi dʋɔ ɔ. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Gʋ ba ga tala Misiya dɩkpalɩŋ na, ba chɩdɩsɛ baa jʋʋ Bitiniya dɩɛ naŋ, ama Yesu Feliŋ n fa ba gbɩɛ ɛ. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Dɩmʋŋ dʋɔ ba mʋna Misiya ju Tʋrasɩ dɩɛ naŋ. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Yuluma na, Pɔɔlʋ yu Ɩsʋɔ lɩsɛ kalaa sɛ wʋ na gʋ Masidoniya baalɛ wʋrʋ sɩmɩɛɩ wʋ a sʋlʋ ɩ sɛ, &lt;&lt;Kɔŋ Masidoniya gaa chɔna daa.&gt;&gt; <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Gʋ Pɔɔlʋ yu Ɩsʋɔ lɩsɛ kalaa ŋii wʋrʋgbɩɛ na, dɩ kʋla daa wʋsɛ bʋdʋŋdʋlʋŋ na dɩɩ ju Masidoniya, akala takɩɛ dɩ jiŋ gʋ Ɩsʋɔ n yagɛ daa sɛ dɩ n gaa tawɩ wɩɛ abama ŋii fa ba.<verse eid="ACT 16:10" /></para>
  <para style="s1">Lidiya lɩɛ Kpaŋjuo di Filipi dɩɛ naŋ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Dɩ lɩɩ Tʋrasɩ cha ɔpʋ dʋɔ ju Samotiraki. Gʋ tɩɛna na, sɛ dɩ ju dʋɔ ju Niyapolisi. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Sɛ dɩ lɩɩ dɩmaŋ ju Filipi gaa ga yɩɛ dɩɛ janɛ gakpari Masidoniya tibi dʋɔ, sɛ ga wɩɛ Romatina tie. Dɩ cha dɩmaŋ gɩyɩɛnɩŋ fɔɩ.<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />Gʋ Fɩɛsɛ wɩɩ talɛ na, dɩ lɩɩ dɩɛ gaa naŋ ju lɩɩ nʋɔ, dɩmaŋ sɛ dɩɩ kɩɛ sɛ dɩɩ yu dɩga dɩjʋɔtɩŋ. Dɩ cha dɩmaŋ sɛ dɩ fara dɩɩ tawɩ dɩɩ fa ala baa ba sɩla dɩmaŋ. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Ala baa baa nyii na tɩba wʋrʋ wʋ yɩrɛ n nyina Lidiya wʋ lɩɩ Tatira dɩɛ janɛ gaa naŋ bɛ, sɛ wʋ a yaa akura ŋii ŋɩ yawʋ wɩɛ doŋ. Wʋ a tʋŋ Ɩsʋɔ sɛ Kpaŋjuo fulu wʋ digela sɛ wʋ lɩɛ Pɔɔlʋ wɩɛ ŋii. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Gʋ ba sɔ wʋ na wʋ waa dʋɔtina na, wʋ yagɛ daa ju wʋ waa dʋɔ. Sɛ wʋ tawɩ daa sɛ, &lt;&lt;Sɛ ɩɩ kɩɛ maŋ takɩɛ ma yɩɛ lɩɛdɩrɛ Kpaŋjuo naŋ na, n kɔŋ gaa cha ma waa dʋɔ.&gt;&gt; Sɛ wʋ sʋlʋ daa sɛ dɩ kpa.<verse eid="ACT 16:15" /></para>
  <para style="s1">Ba tɔ Pɔɔlʋ na Silasi danɛ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Gɩyɩɛ gʋrʋ gʋ dɩɩ ju dɩga dɩjʋɔtɩŋ na, dɩ jaŋina gbeŋi galibie wʋŋ feliŋ sʋbʋ wɩɛ wʋ tɩba sɛ wʋ a dɩlɛ wʋ a gbala ŋii ŋii kɔŋ chifuo. Wʋ a yu aterembie fɔɩ wʋ a fa wʋ kpaŋjuo aba lɩɩ wʋ gbalɩŋ ŋii naŋ. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Dɩmʋŋ galibie wina kpaŋ Pɔɔlʋ na daa baa dɩ kakaa na yela wʋ a kuusi sɛ, &lt;&lt;Dɩmʋŋ bakpa bana yɩɛ Ɩsʋɔ Wʋjanɛ wʋŋ tʋmɩra bɛ, baa aaŋ kalaa amɩɛ gbɩɛ gaa ɩɩ mʋ yu mɔlɔgɩ.&gt;&gt; <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Wʋ ju dʋɔ wʋ a yɩɛ ŋina gɩyɩɛnɩŋ fɔɩ. Dɩtamtɩŋ na, Pɔɔlʋ kara biŋbira fɔɩ sɛ wʋ biliŋi kɩɛ tawɩ feliŋ sʋbʋ wʋŋ sɛ, &lt;&lt;Ma dʋ nyaŋ Yesu Kirisito yɩrɛ naŋ sɛ lɩɩ wʋ tɩba!&gt;&gt;Gabʋanaŋ sɛ feliŋ sʋbʋ wʋŋ lɩɩ wʋ tɩba.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Gʋ gbeŋi galibie wʋŋ wʋ kpaŋjuo aba na gʋ ba tamaa gaa baa yu aterembie tam na, ba chaŋ Pɔɔlʋ na Silasi fɔŋɩ ba ju gɩyɩɛnaŋ mʋ ba ga sɩŋ wɩɛ dira asanaŋ. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Ba kɔna ba wɩɛ dira asanaŋ gaa tawɩ sɛ, &lt;&lt;Baala bana yɩɛ Yudatina bɛ, sɛ baa ja sɛ baa bala daa dɩɛ fu, <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />sɛ baa kalaa ayɩɛsa ŋii daa Romatina mbara n fa gbɩɛ sɛ dɩ n lɩɛ dʋ yaa dɩ n yɩɛ ɛ.&gt;&gt;<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Sɛ jama baa gba kʋlʋ Pɔɔlʋ na Silasi dʋɔ, sɛ wɩɛ dira baa dʋ sɛ ba n fulu ba abʋrɩ afuusa na baa taɩ ba. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Gʋ ba taɩ ba na dieli taŋ na, ba mʋ ba ga tɔ danɛ sɛ ba tawɩ danɛ dɩtʋɔtɩŋ kɩɛrɛ wʋŋ sɛ wʋ n gara ba na dieli. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Gʋ wʋ lɩɛ dɩmʋŋ dʋ ŋina na, wʋ mʋ dɩgbaraŋgbaraŋ pɔgʋ ba nafara mata digbiliŋ sɛ wʋ mʋ ba dʋ danɛ dɩtʋɔtɩŋ lorinaŋ.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Aja yɩɛ takɩɛ tɩɛtɩtɩba na, Pɔɔlʋ na Silasi a jɔ dɩga yela baa kpie numbasɛ baa fa Ɩsʋɔ yela ba dɔŋa danɛtʋɔra baa a nyii ba jaŋ. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Gabʋanaŋ sɛ tibi jigisi gaa ga nʋɔ wɩɛ doŋ jigisi danɛ dɩtʋɔtɩŋ gaa tie dɩpɔrɛ. Gabʋanaŋ sɛ danɛ dɩtʋɔtɩŋ gaa bʋɔlɩɛ ŋii tʋlʋ sɛ ba wʋkʋma agbaraŋgbaraŋ ŋii buoli. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Gʋ danɛ dɩtʋɔtɩŋ kɩɛrɛ wʋŋ feŋ na gʋ bʋɔlɩɛ ŋii tʋlʋ na, wʋ fɔŋɩ wʋ yuo dabɩla na wʋ a kʋ wʋ wʋsɛ, akala takɩɛ wʋ jiŋ sɛ danɛtʋɔra baa sebi. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Ama Pɔɔlʋ kuusi na doŋ sɛ, &lt;&lt;N baa pɩra n wʋsɛ daa kpiniŋ dɩ wɩɛ jɩna!&gt;&gt;<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Sɛ danɛ dɩtʋɔtɩŋ kɩɛrɛ wʋŋ yela sɛ ba mʋ fitila kɔna ɩ, sɛ wʋ yɩɛ bileŋ jʋʋ gaa sala Pɔɔlʋ na Silasi asanaŋ yela wʋ a selesi. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Sɛ wʋ lɩsɛ ba kɔŋ asʋŋ gaa tasɛ ba sɛ, &lt;&lt;Ma kpaŋjuo aba, be sɛ ŋɩ tiri gʋ ma n yɩɛ na maa yu mɔlɔgɩ?&gt;&gt;<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Sɛ ba lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Lɩɛ Kpaŋjuo Yesu di, nyaŋ na n waa dʋɔtina ɩɩ yu mɔlɔgɩ.&gt;&gt; <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Dɩmaŋ sɛ ba tawɩ Ɩsʋɔ wɩɛ ŋii fa wʋ na baa ba wɩɛ wʋ waa dʋɔ na kpiniŋ. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Dɩmʋŋ yuluma saŋa gana, danɛ dɩtʋɔtɩŋ kɩɛrɛ wʋŋ kpaɩ ba awʋnda, gabʋanaŋ sɛ ba sɔ wʋ na wʋ lʋŋtina kpiniŋ. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Danɛ dɩtʋɔtɩŋ kɩɛrɛ wʋŋ mʋ ba kɔŋ wʋ waa dʋɔ sɛ wʋ fa ba adiya. Wʋ asadi akala takɩɛ wʋ na wʋ lʋŋtina kpiniŋ ba lɩɛ Ɩsʋɔ di.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Gʋ tɩɛna na, wɩɛ dira baa kpiri ba gagbasɛ anyaŋnyaŋtina ga tawɩ danɛ dɩtʋɔtɩŋ kɩɛrɛ wʋŋ sɛ, &lt;&lt;Yela dɩmʋŋ baala bana.&gt;&gt; <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Danɛ dɩtʋɔtɩŋ kɩɛrɛ wʋŋ tawɩ Pɔɔlʋ sɛ, &lt;&lt;Wɩɛ dira baa dʋ maŋ sɛ ma n yela nyaŋ na Silasi. Dɩtɩɛna ɩɩ dɩlɛ lam. N pala wʋsɛfɩɛ naŋ.&gt;&gt;<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Ama Pɔɔlʋ tawɩ gagbasɛ anyaŋnyaŋtina baa sɛ, &lt;&lt;Ba tugu daa bakpa naŋ yela ba n di daa wɩɛ ɛ, sɛ ba tɔ daa danɛ hali gʋ dɩ yɩɛ Romatina na gba. Sɛ dɩtɩɛna baa ja sɛ baa wɩsɛ lɩsɛ daa? Aye, yela ba tɩŋtɩŋ baa gaa lɩsɛ daa.&gt;&gt;<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Sɛ gagbasɛ anyaŋnyaŋtina baa ga tawɩ wɩɛ dira baa, gʋ ba nyii sɛ Pɔɔlʋ na Silasi yɩɛ Roma dɩɛsɛ bie na nyɩŋtɩɛ nyaŋ ba. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Ba kɔŋ gaa duo ba dɩsɩsɩ sɛ ba lɩsɛ ba lɩɩ danɛ dɩtʋɔtɩŋ gaa, sɛ ba sʋlʋ ba sɛ ba n lɩɩ dɩɛ janɛ gaa naŋ. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Gʋ Pɔɔlʋ na Silasi lɩɩ danɛ dɩtʋɔtɩŋ na, ba ju Lidiya waa dʋɔ dɩmaŋ sɛ ba sɩla lɩɛdɩra baa sɛ ba tawɩ dʋ ba. Sɛ ba lam.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s1">Pɔɔlʋ na Silasi wɩɛ Tesalonika dɩɛ naŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Gʋ Pɔɔlʋ na Silasi ba mʋna Amfipolisi na Apoloniya dɩɛsɛ naŋ na, ba kɔŋ Tesalonika dɩɛ naŋ, diele gaa Yudatina tʋm danɛ cha ga wɩɛ. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Sɛ Pɔɔlʋ jʋʋ Yudatina tʋm danɛ gaa naŋ ganaŋkʋ wʋ ayɩɛsa a kalaa, sɛ wʋ na ba mɩɛgɩ-mɩɛgɩ Ɩsʋɔ Sabɩɛwɩɛ ŋii naŋ Fɩɛsɛ wɩɩ atoro. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Pɔɔlʋ kalaa tɩba mʋ kalaa sɛ dɩ daga na Kirisito<note caller="+" style="f"><char style="fr" closed="false">17:3 </char><char style="ft" closed="false">Wʋŋ wʋdʋŋdʋlʋŋ wina n nyina Mesaya.</char></note> a na awʋrʋfʋɔ na wʋ a feŋ lɩɩ sɩŋ naŋ. Sɛ wʋ bɔrɛ tawɩ sɛ, &lt;&lt;Dɩmʋŋ Yesu wʋŋ maa jɔ wʋ dʋɔ dawuta maa fa amɩɛ na, n nyina Kirisito wʋŋ.&gt;&gt; <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Sɛ Yudatina baa barɛ lɩɛ wɩɛ ŋii Pɔɔlʋ tawɩ na di sɛ ba kpi wʋ na Silasi dʋɔ, dɩmʋŋ gba sɛ Girikitina baa baa se Ɩsʋɔ na fɔɩ, na ala bakpari fɔɩ.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Ama dɩ jʋʋ Yudatina baa sɛ ba ju ga ja wɩɛ asʋbʋɛtina barɛ gɩyɩɛnaŋ sɛ ba ga bɔlɩɛɩ sɛ ba fara kɔna siŋii dɩɛ janɛ gaa naŋ. Sɛ ba kpala ju Jasiŋ waa dʋɔ ga ja Pɔɔlʋ na Silasi na baa mʋ ba kɔna jama baa. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Ama gʋ ba n na ba na, ba fɔŋɩ Jasiŋ na lɩɛdɩra baa barɛ kɔŋ dɩɛ janɛ gaa bɩnɛ asanaŋ yela baa kuusi sɛ, &lt;&lt;Dɩmʋŋ bakpa bana aaŋ biliŋi dulunya baa fu gakplɩɛkʋma, dɩtɩɛna ba kɔŋ jɩna, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />sɛ Jasiŋ lɩɛ ba wʋ waa dʋɔ. Ba kpiniŋ ba kʋlʋ chicha Roma tibi dʋɔ kɩɛrɛ Juo Kayisa mbara ŋii yela baa tawɩ sɛ juo wʋrʋ wɩɛ baa yagɛ ɩ sɛ Yesu.&gt;&gt; <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Gʋ jama baa na dɩɛ janɛ gaa bɩnɛ baa nyii wɩɛ ŋina na, dɩ nyala ba fɔɩ. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Sɛ ba yela sɛ Jasiŋ na lɩɛdɩra ba baŋbaŋ tɔ aterembie ganaŋkʋ dɩ daga sɛ ba yela ba.<verse eid="ACT 17:9" /></para>
  <para style="s1">Pɔɔlʋ na Silasi wɩɛ Beriya dɩɛ naŋ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Gʋ tɩɛ tam na, lɩɛdɩra baa tii Pɔɔlʋ na Silasi gbɩɛ ju Beriya dɩɛ naŋ. Gʋ ba tala dɩmaŋ na, ba ju Yudatina tʋm danɛ gaa naŋ. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Beriyatina nfɩɛrɛ naŋ fulu kii Tesalonikatina, akala takɩɛ ba kaŋ dɩlɛ nyii wɩɛ ŋii, sɛ baa kɩɛ Ɩsʋɔ Sabɩɛwɩɛ ŋii tɩba na dieli wɩɩ kʋma na baa kɩɛ sɛ wɩɛ ŋii Pɔɔlʋ cha tawɩ na yɩɛ gasiŋteŋ. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Dɩmʋŋ dʋɔ Yudatina fɔɩ, Giriki ala bakpari na Giriki baala fɔɩ lɩɛ di.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />Gʋ Yudatina baa ba wɩɛ Tesalonika jiŋ gʋ Pɔɔlʋ a tawɩ Ɩsʋɔ wɩɛ ŋii Beriya dɩɛ naŋ na, ba kɔŋ dɩmaŋ gaa dʋ jama baa biŋbira yela baa fuosi baa dʋ ba. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Sɛ lɩɛdɩra baa yɩɛ bileŋ mʋ Pɔɔlʋ ju ɔpʋ nʋɔ, ama Silasi na Timoti dʋɔ Beriya. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Sɛ baala baa ba mʋ Pɔɔlʋ baa ju na, mʋ ɩ kɔŋ Atensi dɩɛ naŋ, sɛ wʋ mʋ tɩla si ba sɛ ba n tawɩ Silasi na Timoti sɛ ba n yɩɛ bileŋ gaa kpi wʋ dʋɔ.<verse eid="ACT 17:15" /></para>
  <para style="s1">Pɔɔlʋ wɩɛ Atensi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Gʋ Pɔɔlʋ wɩɛ Atensi wʋ dana Silasi na Timoti, sɛ wʋ na gʋ panɩŋ su dɩɛ janɛ gaa naŋ na, dɩ nyala ɩ fɔɩ <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Dɩmʋŋ dʋɔ wʋ na Yudatina na Girikitina baa baa se Ɩsʋɔ sɛ baa jaŋi Yudatina tʋm danɛ naŋ, na baa ba wɩɛ gɩyɩɛnaŋ tɩɛ na ga naa kʋma na mɩɛgɩ-mɩɛgɩ Ɩsʋɔ wɩɛ ŋii naŋ. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Sɛ Epikuriyotina na Sitokitina kpiŋjim bakalaasa dikpeŋ fara baa di Pɔɔlʋ noro. Sɛ ba barɛ tasɛ sɛ, &lt;&lt;Be sɛ gɩmɩɛmɩɛtɛ wʋmalaŋpʋ wina aja wʋ a tawɩ bɛ?&gt;&gt; Sɛ barɛ dʋɔ tawɩ sɛ, &lt;&lt;Aja yɩɛ wʋ a tawɩ panɩŋ afɔlɩɛ ŋarɛ wɩɛ bɛ.&gt;&gt; Ba tawɩ ŋina bɛ akala takɩɛ Pɔɔlʋ a tawɩ Yesu wɩɛ abama ŋii na wʋ feŋ lɩɩ sɩŋ naŋ wɩɛ. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Sɛ ba mʋ ɩ kɔŋ Ariyopagusi dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ. Dɩmaŋ sɛ ba tasɛ ɩ sɛ, &lt;&lt;Dɩɩ dɩlɛ jiŋ dɩmʋŋ kalaa afɔlɩɛ ŋii nyaa tawɩ ŋɩ wɩɛ n naa? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Akala takɩɛ nyaa tawɩ wɩɛ afɔlɩɛ nyaa fa daa sɛ dɩɩ ja sɛ dɩɩ jiŋ ŋɩ tie.&gt;&gt; <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />[Atensitina na mʋɔra baa ba wɩɛ dɩmaŋ na kpiniŋ mʋ ba saŋa kpiniŋ baa nyii wɩɛ afɔlɩɛ yela baa tawɩ ŋɩ dʋɔ wɩɛ.]<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Dɩmaŋ sɛ Pɔɔlʋ kʋlʋ sɩŋ Ariyopagusi dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ tawɩ sɛ, &lt;&lt;Atensitina, ma na gʋ gbɩɛ kʋma dʋɔ na, ɩɩ ja panɩŋ tʋm na dieli. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Akalaa takɩɛ gʋ ma dɔŋ-ma dɔŋ maa kɩɛ abʋrɩ ŋii ɩɩ tʋm na dieli na, ma na gadiesa dɩgbɩŋgbɩŋ gaa ba sabɩɛ ga dʋɔ sɛ Ɩsʋɔ WƲŊ Ɩ BA JIŊ Ɩ na. Dɩtɩɛna ŋii ɩɩ tʋm yela ɩ ba jiŋ ŋɛ na dʋɔ wɩɛ sɛ maa ja maa tawɩ amɩɛ.&gt;&gt;<verse eid="ACT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩsʋɔ wʋŋ wʋ lɔ dulunya na ga tɩba bʋrʋkʋma na, n nyina Ɩsʋɔ adugbe na tie Kpaŋjuo, sɛ wʋ aa cha tʋm danɩŋ gaa bakpa ma ga na naŋ ŋ. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Wʋ aa ja sɛ bakpa n mʋ ba pamɩɛ tʋŋ ɩ ɩ, takɩɛ wʋ a ja bʋrʋ darɛ na, akala takɩɛ wʋŋ wʋ tɩŋtɩŋ n fa bakpa nkpa, na wuosi na bʋrʋkʋma. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Wʋ lɩɩ wʋkpa wʋdʋŋdʋlʋŋ naŋ lɔ atawɩ yɩrɩ kpiniŋ bakpa sɛ ba n cha tibi kpiniŋ dʋɔ. Sɛ wʋ fa ba saŋa na diele gaa ba n cha na dekulie gaa dɩ daga na baa cha. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Ɩsʋɔ yɩɛ ŋina bɛ ganaŋkʋ bakpa aja ja ɩ na baa na ɩ. Ŋɩ wɩɛ tɩba takɩɛ wʋ taŋ taŋasɛ na daa tɩba wʋrʋ ʋ. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Akala takɩɛ wʋ tɩba sɛ dɩ chaɩ, dɩ dɔŋ yela dɩ wɩɛna nkpa. Takɩɛ ganaŋkʋ amɩɛ tɩba kpiŋjim wɩɛ sabɩɛra barɛ tawɩ sɛ daa kpiniŋ dɩ yɩɛ wʋ bie bɛ.&gt;&gt;<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />Dɩmʋŋ dʋɔ sɛ dɩ yɩɛ Ɩsʋɔ bie bɩrɛ na, dɩ daga na dɩ n baa yɩɛ daa nfɩɛrɛ sɛ Ɩsʋɔ duluŋ kɩɛna takɩɛ diterembi gasɩɛm yaa diterembi gafʋlʋm yaa bʋɩ gaa wʋkpa n mʋ wʋ kpiŋjim na adawʋ yɩɛ. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Saŋa gaa ga lam na, Ɩsʋɔ ba aa kɩɛ ba gɩbajɩŋ ŋ, ama dɩtɩɛna bɩrɛ wʋ dʋ bakpa kpiniŋ gapɩlɛkʋma sɛ ba n biliŋi lɩɩ ba dɩsʋbʋ naŋ. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Akala takɩɛ wʋ lɩsɛ wɩɩ garɛ si takɩɛ wʋ a pala na baalɛ wʋrʋ wʋŋ wʋ lɩsɛ ɩ na dʋɔ na wʋ a di dulunya wɩɛ ŋɩ gbɩɛ dʋɔ. Wʋ yɩɛ ŋina mʋ kalaa bakpa kpiniŋ gʋ wʋ feŋsi ɩ lɩɩ sɩŋ naŋ.<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Gʋ ba nyii atatina feŋ lɩɩ sɩŋ naŋ dʋɔ wɩɛ na, ba barɛ jabi ɩ, sɛ barɛ dʋɔ tawɩ sɛ, &lt;&lt;Dɩɩ ja sɛ nyaa bɔrɛ tawɩ dɩmʋŋ wɩɛ ŋina.&gt;&gt; <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Dɩmaŋ sɛ Pɔɔlʋ lɩɩ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Sɛ baala barɛ yɩɛ Pɔɔlʋ kpamɩra sɛ ba lɩɛ di. Ba tɩba barɛ n nyina Diyonisi wʋŋ wʋ kpi Ariyopagusi dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa dʋɔ, na alʋ wʋŋ baa yagɛ ɩ sɛ Damarisi na bakpa baa barɛ.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s1">Pɔɔlʋ ju Koronto</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Gʋ Pɔɔlʋ lɩɩ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ wʋrʋgbɩɛ na, wʋ lɩɩ Atensi ju Koronto dɩɛ naŋ. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Dɩmaŋ sɛ wʋ ga mɩɛna Yuda wʋkpa wʋrʋ baa yagɛ ɩ sɛ Akʋɩla, wʋ yɩɛ Pontosi dɩɛsɛ-bu bɛ, wʋ na wʋ alʋ Pirisila lɩɩ Italiya kɔŋ Koronto dɩɛ naŋ na, dɩ n taŋgɩlɛ ta a akala takɩɛ Kaladiyosi cha dʋ sɛ Yudatina kpiniŋ n lɩɩ Roma tibi dʋɔ. Sɛ Pɔɔlʋ ju na wʋ a ga kɩɛ ba, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Akala takɩɛ wʋ yɩɛ dukuru diko yɩɛrɛ bɛ takɩɛ ba. Dɩmʋŋ dʋɔ wʋ cha ba jaŋ sɛ wʋ na ba yɩɛ dɩtʋm. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Fɩɛsɛ wɩɩ kʋma Pɔɔlʋ a ju Yudatina tʋm danɛ naŋ na wʋ a ga mɩɛgɩ Ɩsʋɔ wɩɛ naŋ na Yudatina na Girikitina baa, sɛ wʋ chɩdɩsɛ wʋ a tawɩ wʋ a fa ba na baa lɩɛ wɩɛ ŋii wʋ a tawɩ na di.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Gʋ Silasi na Timoti lɩɩ Masidoniya kɔŋ na, Pɔɔlʋ mʋ wʋ wʋsɛ kpiniŋ fa Ɩsʋɔ wɩɛ tawɩ yela wʋ a di seriya wʋ a fa Yudatina baa sɛ Yesu n nyina Kirisito wʋŋ.<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="ft" closed="false">Wʋŋ wʋdʋŋdʋlʋŋ wina n nyina Mesaya.</char></note> <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Ama Yudatina baa kʋlʋ sɩŋ Pɔɔlʋ dʋɔ yela baa tii ɩ, wʋ kpisi wʋ abʋrɩ afuusa dibuu tawɩ ba sɛ, &lt;&lt;Amɩɛ asima n dʋɔ amɩɛ tɩŋtɩŋ amɩɛ nyienaŋ. Ma ba jiŋ dʋɔ ɔ. Lɩɩ dɩtɩɛna mʋ a ju, maa ju baa ba ba yɩɛ Yudatina na jaŋ.&gt;&gt;<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />Dɩmaŋ sɛ Pɔɔlʋ lɩɩ Yudatina tʋm danɛ naŋ ju Titosi Jositosi wʋŋ wʋ yɩɛ Ɩsʋɔ tʋmɩrɛ na waa dʋɔ. Wʋ waa tirina Yudatina tʋm danɛ gaa. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Kirisiposi wʋŋ wʋ yɩɛ Yudatina tʋm danɛ naŋ asanaŋtɛ na wʋ waa dʋɔtina kpiniŋ lɩɛ Kpaŋjuo di, sɛ Korontotina fɔɩ baa ba nyii wʋ wɩɛ na, lɩɛ di sɛ ba sɔ ba.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Yuluma gʋrʋ Pɔɔlʋ yu Ɩsʋɔ lɩsɛ kalaa. Sɛ Kpaŋjuo tawɩ ɩ sɛ, &lt;&lt;N baa se nyɩŋtɩɛ, ju dʋɔ tawɩ wɩɛ ŋii, n baa fu n nʋɔ dʋɔ. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />Ma kpi n dʋɔ, sɛ wʋrʋ ba aa dɩlɛ kʋlʋ sɩŋ n dʋɔ na wʋ a yɩɛ nyaŋ bʋrʋ ʋ, akala takɩɛ ma wɩɛna bakpa fɔɩ dɩɛ janɛ gana naŋ.&gt;&gt; <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Dɩmʋŋ dʋɔ Pɔɔlʋ cha dɩmaŋ bɩriŋnʋɔ garɛ na salɛ yela wʋ a kalaa ba Ɩsʋɔ wɩɛ.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Gʋ Galiyo yɩɛ Roma tibi dʋɔ kɩɛrɛ wʋŋ wʋ a kɩɛ Akaya tibi na dʋɔ, Yudatina baa yɩɛ nʋɔ kʋlʋ sɩŋ Pɔɔlʋ dʋɔ mʋ ɩ ju wɩɛ didiitiŋ. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />Sɛ ba pʋɩ ɩ sɛ, &lt;&lt;Baalɛ wina a fuosi wʋ a dʋ bakpa sɛ ba n tʋm Ɩsʋɔ yela ŋii chicha mbara ŋii.&gt;&gt;<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Gʋ Pɔɔlʋ aja wʋ a tawɩ na, Galiyo tawɩ Yudatina baa sɛ, &lt;&lt;O amɩɛ Yudatina! Nafʋɔ ŋɩ yɩɛ dɩsʋbʋ gajanɛ yaa bʋrʋ gaa ga taŋ dieli na dʋɔ sɛ ɩɩ pʋɩ ɩ na, nafʋɔ ŋɩ wɩɛ dieli fa maŋ na maa yu digela nyii amɩɛ jaŋ. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Ama gʋ ŋɩ yɩɛ lɩɩna wɩɛ, na yɩrɩɛ na amɩɛ Yudatina mbara wɩɛ tasɛ n na bɩrɛ, amɩɛ tɩŋtɩŋ n desina amɩɛ wɩɛ. Ma aa yɩɛ wɩɛ diri ŋina dʋɔ ɔ.&gt;&gt; <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Sɛ wʋ yela sɛ ba geŋ ba lɩɩ wɩɛ didiitiŋ dɩmaŋ <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Dɩmaŋ sɛ ba kpiniŋ ba chaŋ Sositene wʋŋ wʋ yɩɛ Yudatina tʋm danɛ naŋ asanaŋtɛ na tugu ɩ wɩɛ didiitiŋ gaa asanaŋ. Ama ŋɩ n tiri Galiyo o.<verse eid="ACT 18:17" /></para>
  <para style="s1">Pɔɔlʋ bɔrɛ kɔŋ Antiyokiya dɩɛ naŋ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Sɛ Pɔɔlʋ cha Koronto gɩyɩɛnɩŋ akalasa ŋarɛ. Dɩmaŋ sɛ wʋ yela lɩɛdɩra baa sɛ wʋ mʋna lɩŋ dʋɔ ju Siriya, sɛ Pirisila na Akʋɩla ba kpaŋ ɩ. Pɔɩ na wʋ a ju na, wʋ fʋŋ wʋ nyɩnyʋɔsɛ Kenkiriya dɩɛ naŋ lɩɩna ntaŋ ŋii wʋ ka na dʋɔ. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Gʋ ba tala Efiso na, dɩmaŋ sɛ Pɔɔlʋ yela Pirisila na Akʋɩla sɛ wʋ tɩŋtɩŋ wʋ jʋʋ Yudatina tʋm danɛ gaa naŋ na wʋ a ga mɩɛgɩ-mɩɛgɩ Ɩsʋɔ wɩɛ ŋii naŋ na Yudatina baa. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Gʋ ba sʋlʋ ɩ sɛ wʋ n cha ba jaŋ wɩɛ akalasa ŋarɛ na, sɛ wʋ pɩɛ. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Ama gʋ wʋ a ja wʋ a ju na, wʋ tawɩ si sɛ, &lt;&lt;Sɛ Ɩsʋɔ kpa na, maa bɔrɛ kɔŋ.&gt;&gt; Sɛ wʋ lɩɩ Efiso mʋna lɩŋ dʋɔ laŋ. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Gʋ wʋ dʋɔsɩŋ Kayisariya na, wʋ ga yɩlɩ lɩɛdɩra dikpeŋ gaa, sɛ wʋ ju Antiyokiya.<verse eid="ACT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23" />Gʋ Pɔɔlʋ di wɩɛ akalasa ŋarɛ Antiyokiya wʋrʋgbɩɛ na, wʋ lɩɩ dɩmaŋ ju Galatiya na Firigiya tibi dʋɔ yela wʋ a tawɩ wʋ a dʋ kpalɛnara baa doŋ naŋ.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Saŋa gana na, Yuda wʋkpa wʋŋ baa yagɛ ɩ sɛ Apolo sɛ wʋ yɩɛ Alesandiriya dɩɛsɛ bu na kɔŋ Efiso. Wʋ jiŋ dɩtawɩ sɛ wʋ jiŋ Ɩsʋɔ Sabɩɛwɩɛ ŋii na dieli. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Ba kalaa ɩ Kpaŋjuo gbɩɛ gaa dʋɔ, sɛ wʋ lɩɩ wʋ jawʋ naŋ tawɩ sɛ wʋ kalaa Yesu dʋɔ wɩɛ kʋrʋkʋrʋ. Ŋɩ wɩɛ tɩba takɩɛ Yohane Ɩsʋɔ sɔ nyiŋeŋ sɛ wʋ jiŋ. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Sɛ wʋ mʋ digela fara wʋ a tawɩ Yudatina tʋm danɛ gaa naŋ. Gʋ Pirisila na Akʋɩla nyii wɩɛ ŋii wʋ a tawɩ na, ba yagɛ ɩ ju ba waa dʋɔ ga lɩsɛ Ɩsʋɔ gbɩɛ gaa kalaa ɩ kʋrʋkʋrʋ.<verse eid="ACT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27" />Gʋ Apolo aja wʋ a ju Akaya na, lɩɛdɩra baa tawɩ dʋ ɩ, sɛ ba sabɩɛ tanɛ ga fa kpalɛnara baa ba wɩɛ dɩmaŋ sɛ ba n lɩɛ ɩ. Gʋ wʋ talɛ na, wʋ chɔna baa Ɩsʋɔ wɩɩ dʋɔ ba lɩɛ di fɔɩ. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Akala takɩɛ wʋ mʋ noro ŋii ŋɩ nʋɔ wɩɛ doŋ di na Yudatina baa, sɛ wʋ di ba dʋɔ bakpa naŋ, sɛ wʋ mʋ Ɩsʋɔ Sabɩɛwɩɛ ŋii kalaa tɩba takɩɛ Yesu n nyina Kirisito wʋŋ.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s1">Pɔɔlʋ wɩɛ Efiso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Gʋ Apolo wɩɛ Koronto na, Pɔɔlʋ pala Asiya adugbe salɛ ga tala Efiso. Dɩmaŋ sɛ wʋ ga na kpalɛnara barɛ <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />sɛ wʋ tasɛ ba sɛ, &lt;&lt;Gʋ ɩ lɩɛ di na ɩ yu Ɩsʋɔ Feliŋ?&gt;&gt;</para>
  <para style="p" vid="ACT 19:2">Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Aye, dɩ n nyii ta gba sɛ Ɩsʋɔ Feliŋ ŋarɛ wɩɛ ɛ.&gt;&gt;<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Dɩmʋŋ dʋɔ Pɔɔlʋ tasɛ ba sɛ, &lt;&lt;Dɩmʋŋ bɩrɛ Ɩsʋɔ sɔ gamʋɔ sɛ ɩ yu?&gt;&gt;</para>
  <para style="p" vid="ACT 19:3">Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Yohane Ɩsʋɔ sɔ.&gt;&gt;<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Sɛ Pɔɔlʋ tawɩ ba sɛ, &lt;&lt;Yohane Ɩsʋɔ sɔ yɩɛ biliŋi lɩɩ dɩsʋbʋ naŋ bɛ. Sɛ wʋ tawɩ bakpa baa sɛ ba n lɩɛ wʋŋ wʋ a kɔŋ wʋ wʋrʋgbɩɛ na di, wʋŋ n nyina Yesu.&gt;&gt; <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />Gʋ ba nyii ŋina na, ba sɔ ba Kpaŋjuo Yesu yɩrɛ naŋ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Gʋ Pɔɔlʋ mʋ wʋ pamɩɛ jaga-jaga ba dʋɔ na, Ɩsʋɔ Feliŋ kɔŋ ba dʋɔ sɛ ba tawɩ atawɩ afɔlɩɛ, sɛ ba gbalɛ. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Baala baa kpiniŋ aja yɩɛ gifi bala.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Pɔɔlʋ jʋʋ Yudatina tʋm danɛ gaa naŋ sɛ wʋ mʋ digela tawɩ fa bakpa baa gafɩtasɛ sɩ toro. Sɛ wʋ mʋ noro wʋ a tawɩ lɩɩna Ɩsʋɔ juori gaa dʋɔ wɩɛ wʋ a fa ba na baa lɩɛ wɩɛ ŋii wʋ a tawɩ na di. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Ama ba barɛ yɩɛ dɩlɛ na doŋ, sɛ ba pɩɛ na baa lɩɛ di, sɛ ba sɩŋ bakpa naŋ tawɩ wɩɛ asʋbʋɛ baŋ Gbɩɛ gaa. Dɩmʋŋ dʋɔ Pɔɔlʋ yela ba, sɛ wʋ mʋ kpalɛnara baa kpaŋ wʋ wʋsɛ sɛ wɩɩ kʋma wʋ a mɩɛgɩ Ɩsʋɔ wɩɛ ŋii naŋ Tirano dɩkalaatɩŋ gaa naŋ. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Ŋina ju dʋɔ bɩŋsɛ ala, sɛ ŋɩ yela sɛ Yudatina na Girikitina baa ba wɩɛ Asiya tibi dʋɔ na kpiniŋ nyii Kpaŋjuo Yesu wɩɛ ŋii.<verse eid="ACT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Ɩsʋɔ pala na Pɔɔlʋ dʋɔ yɩɛ adaŋgana ŋii ŋɩ wɩɛ mamachi, <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />hali gʋ bakpa mʋ chimuŋ na akura ŋii ba mʋ tapʋ Pɔɔlʋ mʋ gaa tapʋ lʋmɩɛtina na, ba yu lʋm chʋɔ, sɛ feliŋ sʋbʋ lɩɩ ba tɩba.<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />Yudatina barɛ baa ba dɔŋ baa geŋ feliŋ sʋbʋ baa lɩɩ bakpa tɩba na, aja sɛ baa mʋ Kpaŋjuo Yesu yɩrɛ mʋ geŋ feliŋ sʋbʋ lɩɩ baa ba wɩɛ ba tɩba na. Baa tawɩ sɛ, &lt;&lt;Ma dʋ nyaŋ sɛ Yesu wʋŋ Pɔɔlʋ a tawɩ wʋ wʋsɛ dʋɔ wɩɛ na yɩrɛ naŋ, lɩɩ wʋ tɩba.&gt;&gt; <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Sikifa wʋŋ wʋ yɩɛ Yudatina sei bɩnɛ na bie baala jaŋ lɩkaarɛ aaŋ yɩɛ ŋina. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Wɩɩ darɛ feliŋ sʋbʋ wʋŋ tawɩ ba sɛ, &lt;&lt;Ma jiŋ Yesu, sɛ ma jiŋ Pɔɔlʋ dʋɔ, sɛ Mmʋɔ n nyina amɩɛ?&gt;&gt; <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Dɩmaŋ sɛ baalɛ wʋŋ feliŋ sʋbʋ wɩɛ wʋ tɩba na sala ba dʋɔ tugu ba na dieli sɛ wʋ di ba kpiniŋ dʋɔ. Sɛ ba se lɩɩ waa gaa dʋɔ diboloŋ yela asima a lɩɩ ba wʋsɛ dʋɔ.<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />Gʋ Yudatina na Girikitina baa ba wɩɛ Efiso nyii ŋii ŋɩ tibi na, nyɩŋtɩɛ chaŋ ba sɛ ba kalɩɛ Kpaŋjuo Yesu yɩrɛ gaa. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Sɛ bakpa baa ba lɩɛ di na fɔɩ kɔŋ gaa tawɩ fulu ba dɩsʋbʋ ayɩɛsa jama baa asanaŋ. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Sɛ ba fɔɩ baa baa yɩɛ majigi na mʋ ba tanɩɛ aguosa kɔŋ gaa sɩla sɛ ba tʋʋ ŋɛ bakpa asanaŋ. Gʋ ba kɩɛ tanɩɛ aguosa ŋii yawʋ na, ŋɩ ga lɩɩ aterembie afʋlʋma bie kɔrʋɔsɛ ŋɩla na sala (50,000). <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Ŋina dʋɔ Kpaŋjuo wɩɛ ŋii yalagi sɛ ŋɩ bɩɩ doŋ dʋɔ.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Gʋ ŋina kpiniŋ tibi wʋrʋgbɩɛ na, Pɔɔlʋ yɩɛ wʋ nfɩɛrɛ sɛ wʋ a mʋna Masidoniya na Akaya ju Yerusalem. Sɛ wʋ tawɩ sɛ, &lt;&lt;Ma ju dɩmaŋ wʋrʋgbɩɛ na, ŋɩ tiri gʋ maa bʋɔ Roma gba dʋɔ.&gt;&gt; <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Sɛ wʋ kpiri wʋ chɔnara bala, Timoti na Erasito ju Masidoniya, sɛ wʋ dʋɔ cha Asiya tibi dʋɔ chonii.<verse eid="ACT 19:22" /></para>
  <para style="s1">Wɩɛ siŋii Efiso</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Aja yɩɛ dɩmʋŋ saŋa gana na, siŋii gaa ga nʋɔ yɩɛ doŋ kɔŋ lɩɩna Gbɩɛ gaa dʋɔ. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Bayɩpʋ wʋrʋ baa yagɛ ɩ sɛ Dimiterosi wʋŋ wʋ a mʋ aterembie afʋlʋma wʋ a luu Atemisi panɛ alʋ jaŋ panɩŋ danɩŋ. Ŋina yela sɛ wʋ na adawʋtina baa kpiniŋ yu dɩtʋm baa yɩɛ. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Sɛ wʋ yagɛ ba, na baa wʋ na ba dɩtʋm yɩɛ bʋdʋŋdʋlʋŋ na gaa jaŋi tawɩ ba sɛ, &lt;&lt;Ma dɔŋa, ɩ jiŋ gʋ dɩɩ yu aterembie na dieli dɩɩ lɩɩ dɩmʋŋ dɩtʋm gana tɩba. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Ɩ naa sɛ ɩ nyii ganaŋkʋ dɩmʋŋ Pɔɔlʋ wina tawɩ fa ba sɛ ba lɩɛ wɩɛ ŋii wʋ tawɩ na di, wʋ yela sɛ bakpa fɔɩ baa ba wɩɛ Efiso jɩna na Asiya tibi dʋɔ kpiniŋ tʋsʋ gbɩɛ. Wʋ a tawɩ sɛ panɩŋ ŋii bakpa yɩɛ na ba yɩɛ panɩŋ kpiniŋ-kpiniŋ. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Wɩɛ asʋbʋɛ a kɔnɛ naa daa dɩtʋm nyiŋeŋ yɩrɛ aaŋ ja warɩɛ ɛ, ama panɛ janɛ alʋ jaŋ Atemisi panɛ danɛ gba aja yɩɛ kpakpuo, na panɛ alʋ jaŋ tɩŋtɩŋ wʋŋ Asiya tibi kpiniŋ na dulunya a tʋm ɩ na, a paŋ wʋ panɛ gɩjaŋjanɛ.&gt;&gt;<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Gʋ ba nyii ŋina na, ba kara biŋbira sɛ ba fara baa kuusi sɛ, &lt;&lt;Daa Efisotina panɛ Atemisi n nyina panɛ gajanɛ!&gt;&gt; <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Sɛ dɩɛ gaa naŋ siŋii. Sɛ bakpa baa chaŋ Gayosi na Arisitakosi, Pɔɔlʋ wʋ dɔŋa baa wʋ na ba a ju gbɩɛ sɛ ba lɩɩ Masidoniya na, fɔŋɩ ba ju dijaŋitiŋ. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Nafʋɔ Pɔɔlʋ ja wʋ a ju jama baa asanaŋ, ama kpalɛnara baa n fa ɩ gbɩɛ ɛ. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Hali tibi gaa dʋɔ asanaŋtina barɛ baa ba yɩɛ Pɔɔlʋ wʋ dɩɛtina na gba fa nʋɔ sʋlʋ ɩ sɛ wʋ n baa ju dijaŋitiŋ dɩmaŋ.<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />Saŋa gana na, bakpa baa ba jaŋi na wuliti, barɛ a kuusi baa tawɩ wɩɛ ŋarɛ, sɛ barɛ dʋɔ a kuusi baa tawɩ wɩɛ abaŋbaŋ. Bakpa fɔɩ ba jiŋ bʋrʋ gaa ga dʋɔ sɛ ba wɩɛ dɩmaŋ na a. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Sɛ Yudatina baa ti Alesanda gaa sɩŋ asanaŋ, sɛ jama baa tɩba barɛ kuusi tawɩ ɩ ŋii wʋ n yɩɛ. Sɛ wʋ ŋɩrɛ ba pam sɛ ba n cha kuruŋ na wʋ a dɩlɛ tawɩ gara wʋ wʋsɛ bakpa baa asanaŋ. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Ama gʋ ba jiŋ gʋ wʋ yɩɛ Yuda wʋkpa na, ba kpiniŋ ba kuusi nʋɔ garɛ naŋ aja yɩɛ takɩɛ saŋa ala tawɩ sɛ, &lt;&lt;Daa Efisotina panɛ Atemisi n nyina panɛ gajanɛ!&gt;&gt;<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Sɛ dɩɛ janɛ gaa sabɩɛrɛ yela sɛ bakpa baa cha kuruŋ sɛ wʋ tawɩ sɛ, &lt;&lt;Ma dɔŋa Efisotina, dulunya kpiniŋ jiŋ gʋ Efiso dɩɛ janɛ gana aaŋ kɩɛ panɛ janɛ Atemisi panɛ danɛ na wʋ bʋɩ gaa ga lɩɩ adugbe sala tibi naa? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Dɩmʋŋ dʋɔ lɩɩna gʋ wʋrʋ ba aa dɩlɛ pɩɛ gasiŋteŋ ŋina dʋɔ, dɩ daga na ɩ cha kuruŋ na n baa kpaala yɩɛ bʋrʋ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Ɩ mʋ baala bana kɔŋ jɩna, ŋɩ wɩɛ tɩba takɩɛ ba n ŋmɩɛlɛ bʋrʋ lɩɩ tʋm danɩŋ naŋ yaa ba n tawɩ mbusu wɩɛ chicha daa panɛ alʋ jaŋ ŋ. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Sɛ Dimiterosi na wʋ dɔŋa adawʋtina wɩɛna wɩɛ na baa mʋ pʋɩ wʋrʋ na, wɩɛ didiitiŋ na wɩɛ dira baa wɩɛ. Baa dɩlɛ pʋɩ ba dɩmaŋ. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Sɛ ɩ wɩɛna wɩɛ ŋarɛ kpi na, ŋɩ tiri gʋ bakpa baa n mʋna gbɩɛ bam dʋɔ sɩla na baa desina ŋɛ. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Ganaŋkʋ ŋɩ kɩɛna na, wɩɛ aja mɩɛna daa lɩɩna jaŋ siŋii ŋii dʋɔ, akala takɩɛ dɩ tana kpɩnɩdɩ dɩɩ mʋ kalaa dɩmʋŋ siŋii ŋina tɩba a.&gt;&gt; <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Gʋ wʋ tawɩ ŋina taŋ na, sɛ wʋ yela sɛ bakpa baa ba sɩla na yasɩŋ.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s1">Pɔɔlʋ ju Masidoniya na Akaya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Gʋ siŋii ŋii nʋɔ kɔŋ tie na, Pɔɔlʋ kpiri yagɛ kpalɛnara baa. Gʋ wʋ tawɩ dʋ ba taŋ na, wʋ kali ba sɛ wʋ lɩɩ dɩmaŋ ju Masidoniya. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Wʋ pala tibi gaa dɩɛsɛ dʋɔ yela wʋ a tawɩ tawɩ dʋ wɩɛ fɔɩ wʋ a fa bakpa baa. Dɩtamtɩŋ na wʋ gaa tala Girisi, <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />dɩmaŋ sɛ wʋ cha gafɩtasɛ sɩ toro. Gʋ wʋ a ja wʋ a mʋna lɩŋ dʋɔ ju Siriya na, Yudatina baa jɔ wʋ dʋɔ dɩkɔŋ, dɩmʋŋ dʋɔ wʋ yɩɛ wʋ nfɩɛrɛ sɛ wʋ a bɔrɛ ga mʋna Masidoniya. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Baa ba kpaŋ ɩ na n nyina Sopata Piro bu wʋŋ wʋ lɩɩ Beriya, Arisitakosi na Sekondosi baa ba lɩɩ Tesalonika, Gayosi wʋŋ wʋ lɩɩ Dɛbɩ, Timoti, Tikiko na Tirofimo baa ba lɩɩ Asiya tibi dʋɔ. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Baala bana pala asanaŋ ga daa daa Tʋrasɩ dɩɛ naŋ. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Gʋ ba di Bodobodo gaa ga Tana Yiisi Asadi Adiya di taŋ na, dɩ pala lɩŋ dʋɔ lɩɩ Filipo. Gɩyɩɛnɩŋ anʋŋ wʋrʋgbɩɛ na, dɩ ga mɩɛna ba Tʋrasɩ, dɩmaŋ sɛ dɩ cha gɩyɩɛnɩŋ lɩkarɛ.<verse eid="ACT 20:6" /></para>
  <para style="s1">Pɔɔlʋ feŋsi Yutiku kɔŋ nkpa naŋ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Wɩɩ gaa ga dɔŋ Soji asanaŋ na, dɩ gaa jaŋi na dɩɩ di adiya. Sɛ Pɔɔlʋ tawɩ fa bakpa baa, akala takɩɛ tɩɛna wʋ a lɩɩ ba jaŋ dʋɔ, wʋ ju dʋɔ tawɩ ga tala tɩɛ tɩtɩba. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Fitila aba bɔlɩɛɩ abaŋsʋrʋ danɛ gaa naŋ diele gaa dɩɩ jaŋi na. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Yeleŋbu wʋrʋ baa yagɛ ɩ sɛ Iwutukosi wʋ chaɩ nfaŋsʋrʋ jaŋ wʋ a doliewu gʋ Pɔɔlʋ a tawɩ wʋ a ju wʋ a kɔnɛ na. Gʋ wʋ duo asoroŋ ga laŋ na, wʋ lɩɩ abaŋsʋrʋ danɛ atorotɛ naŋ gaa sala tibi, gʋ ba mʋ ɩ na, wʋ sɩŋ. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Sɛ Pɔɔlʋ tibi kɔŋ sɛ wʋ fu yeleŋbu wʋŋ dʋɔ sɛ wʋ puga ɩ tawɩ sɛ, &lt;&lt;N baa yɩyɩɛ, wʋ chaɩ nkpa naŋ.&gt;&gt; <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Dɩmaŋ sɛ Pɔɔlʋ ti bɔrɛ jiŋ abaŋsʋrʋ danɛ gaa ga jaɩ bodobodo tawʋ. Sɛ wʋ ju dʋɔ tawɩ Ɩsʋɔ wɩɛ hali tɩɛ naa, sɛ wʋ lɩɩ dɩmaŋ. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Sɛ bakpa baa mʋ asadi mʋ yeleŋbu wʋŋ wʋ chaɩ nkpa naŋ na ju dɩɛ.<verse eid="ACT 20:12" /></para>
  <para style="s1">Pɔɔlʋ lɩɩ Tʋrasɩ ju Militusi</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Dɩ mʋ pantuu janɛ pala lɩŋ dʋɔ ju Asosi, diele gaa dɩɩ ga mʋ Pɔɔlʋ. Wʋ fɩla yɩɛ dɩmʋŋ gbɩɛsɛ nfɩɛrɛ ŋina si, akala takɩɛ wʋ a pala bɛ ju dɩmaŋ. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Gʋ wʋ jaŋina daa Asosi na, dɩ mʋ ɩ sɛ daa na ɩ dɩ ju Mitileni. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Gʋ tɩɛ naa na, dɩ lɩɩ dɩmaŋ mʋna lɩŋ dʋɔ gaa tala Kiyosi. Gʋ tɩɛ ti naa na, dɩ tɩɛsɛ ju Samosi, go tɩɛ ti naa na, sɛ dɩ ga tala Militusi. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Pɔɔlʋ yɩɛ wʋ nfɩɛrɛ takɩɛ wʋ a mʋna lɩŋ dʋɔ laŋ Efiso na wʋ n baa taŋgɩlɛ Asiya tibi dʋɔ. Akala takɩɛ wʋ a ja bileŋ na wʋ a tala Yerusalem pɔɩ na Pentikosi asadi adiya wɩɩ gaa a tala.<verse eid="ACT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Gʋ Pɔɔlʋ wɩɛ Militusi na, wʋ kpiri yagɛ Efisotina lɩɛdɩra dikpeŋ gaa bɩnɩɛ. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Gʋ ba kɔnɛ na, wʋ tawɩ ba sɛ, &lt;&lt;Ɩ jiŋ ganaŋkʋ maŋ na amɩɛ dɩ cha saŋa kpiniŋ lɩɩ gɩyɩɛ gaa ga dɔŋ asanaŋ gʋ ma kɔŋ Asiya tibi dʋɔ na. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Ma kɔna ma wʋsɛ tie na dieli sɛ ma mʋ asa lɩŋ tʋŋ Kpaŋjuo wʋŋ, ŋɩ wɩɛ tɩba takɩɛ Yudatina baa jɔ ma dʋɔ dɩkɔŋ mʋ yɩɛ maŋ lɔ tɩba fɔɩ. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Ɩ jiŋ gʋ bʋrʋ gaa gaa chɔna amɩɛ na, ma n mʋ wɩsɛ amɩɛ ɛ, ama ma kalaa amɩɛ bakpa naŋ na waa garɛ dʋɔ mʋ ju garɛ dʋɔ. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Ma jɔ Yudatina na Girikitina nyienaŋ sɛ ŋɩ tiri gʋ ba n biliŋi lɩɩ ba dɩsʋbʋ naŋ kɔŋ Ɩsʋɔ jaŋ na baa yu lɩɛdi daa Kpaŋjuo Yesu naŋ.&gt;&gt;<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩtɩɛna Ɩsʋɔ Feliŋ dʋ maŋ sɛ ma n ju Yerusalem, sɛ ma ba jiŋ bʋrʋ gaa gaa tibi ma dʋɔ dɩmaŋ ŋ. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Ma jiŋ gʋ dɩɛ janɛ kʋma naŋ na, Ɩsʋɔ Feliŋ ŋii jɔ ma nyinaŋ sɛ danɛ tʋɔ na awʋrʋfʋɔ dana maŋ. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Ama ma na gʋ ma nkpa yɩɛ kpakpuo bɛ fa maŋ. Ŋii maa jawʋ na n nyina sɛ maa taŋ ma dɩtʋm na dɩtʋm gaa Kpaŋjuo Yesu mʋ fa maŋ na kʋrʋkʋrʋ. Dɩtʋm gaa n nyina sɛ maa di wɩɛ abama dʋɔ seriya lɩɩna Ɩsʋɔ wɩɩ dʋɔ.&gt;&gt;<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />&lt;&lt;Dɩtɩɛna ma jiŋ gʋ amɩɛ baa ma pala amɩɛ tɩba tawɩ Ɩsʋɔ juori gaa dʋɔ wɩɛ fa na, tɩba wʋrʋ ba aa ti na maŋ ŋ. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Dɩmʋŋ dʋɔ maa tawɩ amɩɛ jaŋ sɛ, amɩɛ tɩba wʋkʋma wʋŋ wʋ tʋsʋ na, ŋɩ n lɩɩ ma jaŋ ŋ. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Akala takɩɛ ma n mʋ kpii na maa jɔ Ɩsʋɔ jawʋ kpiniŋ dawuta fa amɩɛ ɛ. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />N kɩɛ amɩɛ wʋsɛ dʋɔ na dieli na ɩ kɩɛ feŋ dikpeŋ gaa Ɩsʋɔ Feliŋ ŋii yɩɛ amɩɛ asanaŋtina na dʋɔ. N yɩɛ Ɩsʋɔ<note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="ft" closed="false">Ɩsʋɔ Sabɩɛwɩɛ ŋarɛ wɩɛna Kpaŋjuo.</char></note> lɩɛdɩra dikpeŋ gaa wʋ mʋ wʋ tɩŋtɩŋ wʋ bu asima lɩɛ ba na feŋ kpara. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Ma jiŋ gʋ ma lam wʋrʋgbɩɛ na, gbogboo aba baa ba libi na aja jʋʋ amɩɛ tɩba, na baa chaŋ feŋ dikpeŋ gaa. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Hali amɩɛ tɩŋtɩŋ amɩɛ tɩba baala barɛ aja kʋlʋ na baa biliŋi gasiŋteŋ gaa, ganaŋkʋ baa fɔŋɩ lɩɛdɩra baa gaa kpaŋ ba wʋsɛ. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Dɩmʋŋ dʋɔ n kɩɛ amɩɛ wʋsɛ dʋɔ na dieli, na ɩ nyiŋi gʋ bɩŋsɛ sɩ toro mɩnaŋ gʋ ma n mʋ asa lɩŋ yela amɩɛ wʋkʋma nyinaŋ jʋɔ yuluma na wiita a.&gt;&gt;<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩtɩɛna, ma chamɩna amɩɛ maa dʋ Ɩsʋɔ pam naŋ na wʋ wɩɩ wɩɛ naŋ. Ŋii aaŋ dɩlɛ yela na ɩ bɩɩ, na ŋii yela amɩɛ na baa Ɩsʋɔ yɩɛ ba dɩchɩrɩchɩrɩ na a yu gapatɩɛ. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Ma asa ba aa chɛ wʋrʋ diterembi fʋlʋm yaa diterembi sɩɛm yaa abʋrɩ afuusa a. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Amɩɛ tɩŋtɩŋ ɩ jiŋ gʋ ma pamɩɛ ŋina sɛ ma chamɩna maa yɩɛ dɩtʋm maa yu abʋrɩ ŋii ŋɩ tiri ma tɩŋtɩŋ na ma dɔŋa. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Bʋrʋkʋma gaa ma yɩɛ na, ma kalaa amɩɛ sɛ dɩ daga na ɩ yɩɛ dɩmʋŋ dɩtʋm doŋ-tɛ mʋ chɔna baa ba fʋʋ na. Na ɩ nyiŋi wɩɛ ŋii Kpaŋjuo Yesu tɩŋtɩŋ tawɩ na takɩɛ kusee wɩɛ fa naŋ kii lɩɛ.&gt;&gt;<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Gʋ wʋ tawɩ ŋina na, wʋ na ba kpiniŋ luuŋ ba dʋna dʋɔ sɛ ba jɔ dɩga. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Sɛ ba kpiniŋ ba wii sɛ ba puga ɩ, sɛ ba kali ɩ. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Bʋrʋ gaa ga yela sɛ ba bɔtaa na n nyina gʋ wʋ tawɩ ba sɛ ba aa ti na ɩ ɩ. Dɩmaŋ sɛ ba kpaŋ ɩ ju pantuu janɛ gaa jaŋ.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s1">Pɔɔlʋ ju Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Gʋ dɩ kali lɩɛdɩra dikpeŋ gaa bɩnɩɛ baa taŋ na, dɩ mʋna ɔpʋ dʋɔ ju Kosi dɩɛ naŋ. Gʋ tɩɛna na, dɩ ju Rodosi dɩɛ naŋ, sɛ dɩ lɩɩ dɩmaŋ ju Patara dɩɛ naŋ. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Sɛ dɩ na pantuu janɛ garɛ gaa tɩɛsɛ gaa ju Fonisiya. Sɛ dɩ jʋʋ ga tɩba ju. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Gʋ dɩ tala diele gaa daa asa kɩɛna Kipurosi dɩɛ na, sɛ dɩ mʋna Kipurosi dɩɛ gaa tie ju Siriya. Sɛ dɩ dʋɔsɩŋ Tirosi dɩɛ naŋ, dɩmaŋ sɛ ba lɩsɛ gasʋlasɛ lɩɩ pantuu janɛ gaa naŋ. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Dɩ na kpalɛnara baa wɩɛ dɩmaŋ sɛ dɩ cha ba jaŋ gɩyɩɛnɩŋ lɩkarɛ. Sɛ Ɩsʋɔ Feliŋ pala na ba dʋɔ tawɩ Pɔɔlʋ sɛ, wʋ n baa ju Yerusalem. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Ama gʋ daa saŋa talɛ na, dɩ lɩɩ dɩmaŋ sɛ dɩ ju dʋɔ. Kpalɛnara baa kpiniŋ na ba ala na ba bie kpaŋ daa lɩɩ dɩɛ janɛ gaa naŋ gaa tala ɔpʋ gaa nʋɔ, dɩmaŋ sɛ dɩ luuŋ daa dʋna dʋɔ jɔ dɩga. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Gʋ dɩ kali dɔŋa taŋ na, sɛ dɩ jʋʋ pantuu janɛ gaa naŋ sɛ ba bɔrɛ ju dɩɛ.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Dɩ ju dʋɔ pala lɩŋ dʋɔ lɩɩ Tirosi sɛ dɩ dʋɔsɩŋ Potolemayi, dɩmaŋ sɛ dɩ yɩlɩ lɩɛdɩra baa ba wɩɛ dɩmaŋ na, sɛ dɩ cha ba jaŋ wiita bi. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Gʋ tɩɛna na, dɩ lɩɩ dɩmaŋ ju Kayisariya ga cha Filipo Ɩsʋɔ wɩɛ tawɩrɛ wʋŋ waa dʋɔ. Sɛ wʋ ti wʋ yɩɛ chɔnara lɩkarɛ baa tɩba wʋrʋ. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Wʋ wɩɛna bie ala jaŋ ba nara baa ba n saa ta a sɛ baa gbalɛ.<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />Gʋ dɩ cha dɩmaŋ wɩɛ akalasa ŋarɛ wʋrʋgbɩɛ na, Ɩsʋɔ ɔja wʋrʋ wʋŋ baa yagɛ ɩ sɛ Agabusi lɩɩ Yudiya kɔŋ dɩmaŋ. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Gʋ wʋ kɔŋ daa jaŋ na, sɛ wʋ mʋ Pɔɔlʋ tɩŋa naŋ ganya pɔgʋ wʋ tɩŋtɩŋ wʋ pamɩɛ na wʋ nafara tawɩ sɛ, &lt;&lt;Ɩsʋɔ Feliŋ tawɩ sɛ n na sɛ Yudatina baa ba wɩɛ Yerusalem na aja pɔgʋ dɩmʋŋ tɩŋa naŋ ganya gana ga kpaŋjuo, na baa mʋ ɩ ju ga fa baa ba ba yɩɛ Yudatina.&gt;&gt;<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Gʋ dɩ nyii wɩɛ ŋina na, daa na bakpa baa ba wɩɛ dɩmaŋ sʋlʋ Pɔɔlʋ sɛ wʋ n baa ju Yerusalem. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Dɩmaŋ sɛ Pɔɔlʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Be n yɩɛ sɛ ɩɩ wii sɛ ɩ yela sɛ maa bɔtaa dɩmʋŋ? Maŋ bɩrɛ ma kʋla ma wʋsɛ fa, naa pɔgʋ ŋii baa pɔga maŋ na nyiŋeŋ ŋ, ama Kpaŋjuo Yesu yɩrɛ gaa dʋɔ, maa sɩŋ Yerusalem.&gt;&gt; <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Gʋ dɩ n dɩlɛ tawɩ na baa lɩɛ wɩɛ ŋii dɩ tawɩ ba di na, dɩ yela ɩ sɛ dɩ tawɩ sɛ, &lt;&lt;Kpaŋjuo jawʋ bɛ n kɔŋ tɩba.&gt;&gt;<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Ŋina wʋrʋgbɩɛ na, sɛ dɩ kʋla daa wʋsɛ ju Yerusalem. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Kpalɛnara baa ba lɩɩ Kayisariya na, barɛ ti daa gbɩɛ kɔŋ Manasoŋ wʋŋ wʋ lɩɩ Kipurosi na waa dʋɔ, diele gaa dɩɩ ju ga cha. Wʋ yɩɛ kpalɛnara baa ba chɩŋkpɩɛ lɩɛ di na tɩba wʋrʋ bɛ.<verse eid="ACT 21:16" /></para>
  <para style="s1">Pɔɔlʋ ju gabʋɔ Yakubu dʋɔ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Gʋ dɩ tala Yerusalem na, lɩɛdɩra baa mʋ asadi lɩɛ daa. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Gʋ tɩɛna na, Pɔɔlʋ na daa baa dɩkaka na ju ga na Jamesi yela lɩɛdɩra dikpeŋ gaa bɩnɩɛ baa kpiniŋ wɩɛ dɩmaŋ. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Gʋ Pɔɔlʋ yɩlɩ ba na, sɛ wʋ kalaa tɩba na dieli bʋrʋ gaa Ɩsʋɔ pala na wʋ dɩtʋm dʋɔ yɩɛ baa ba ba yɩɛ Yudatina na tɩba fa ba.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />Gʋ ba nyii dɩmʋŋ wɩɛ ŋina na, ba kalɩɛ Ɩsʋɔ. Dɩmaŋ sɛ ba tawɩ Pɔɔlʋ sɛ, &lt;&lt;Daa dʋɔ lɩɛdɩrɛ, nya na ganaŋkʋ Yudatina kɔrʋɔsɛ-kɔrʋɔsɛ lɩɛ di, na ganaŋkʋ ba kpiniŋ ba mʋ jawʋ gaa ga nʋɔ wɩɛ doŋ kpaŋ Mosesi mbara ŋii dʋɔ. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Ba tawɩ ba sɛ nyaa kalaa Yudatina kpiniŋ baa ba chaɩ baa ba ba yɩɛ Yudatina na tɩba, sɛ ba n yela Mosesi mbara ŋii dʋɔ di yela nyaa tawɩ ba sɛ ba n baa karɩɛ ba bie baŋlɛ yaa ba n baa kpaŋ daa ayɩɛsa dʋɔ. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Dɩ n yɩɛ sɩnɛ baa nyii gʋ nya kɔnɛ. Dɩmʋŋ dʋɔ be sɛ dɩɩ yɩɛ? <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Dɩmʋŋ dʋɔ yɩɛ ŋii dɩ tawɩ nyaŋ na. Baala banara barɛ wɩɛ daa jaŋ baa ba ka ntaŋ na. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Mʋ baala bana na nyaa kpi ba dʋɔ na ɩ ju ga yɩɛ iniesi saŋ lɩsɛ, na nyaa tɔ ba nyie dʋɔ kɩmɩɛ na baa fʋŋ ba nyie. Na ba wʋkʋma a jiŋ gʋ wɩɛ ŋii ba tawɩ lɩɩ n dʋɔ na ba yɩɛ gasiŋteŋ ŋ, ama nyaŋ n tɩŋtɩŋ nyaa kpaŋ Mosesi mbara ŋii dʋɔ. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Lɩɩna baa ba ba yɩɛ Yudatina lɩɛdɩra baa bɩrɛ, dɩ fɩla mʋ nfɩɛrɛ sɛ dɩ sabɩɛ tanɛ fa ba sɛ ba n baa di adiya ŋii ba mʋ diesi gadiesa fa panɩŋ na asima, ba n baa tawʋ namɩɛ baa ba ŋarɛ ba kʋ, na baa lɩsɛ ba wʋsɛ lɩɩ danaŋburidi naŋ.&gt;&gt;<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Gʋ tɩɛna na, Pɔɔlʋ mʋ baala baa sɛ wʋ na ba ju ga yɩɛ iniesi saŋ lɩsɛ. Sɛ wʋ ju Ɩsʋɔ tʋm danɛ naŋ ga si gɩyɩɛnɩŋ ŋii iniesi saŋ lɩsɛ ŋii aja taŋ na, na fa ŋii baa fa ba wʋkʋma na.<verse eid="ACT 21:26" /></para>
  <para style="s1">Ba chaŋ Pɔɔlʋ Ɩsʋɔ tʋm danɛ naŋ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Gʋ gɩyɩɛnɩŋ lɩkarɛ ŋii kakaa chonii na ŋii taŋ na, Yudatina barɛ baa ba lɩɩ Asiya tibi dʋɔ na Pɔɔlʋ Ɩsʋɔ tʋm danɛ gaa naŋ, sɛ ba fuosi dʋ jama baa kpiniŋ sɛ ba chaŋ ɩ <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />yela baa kuusi sɛ, &lt;&lt;Isiralitina n chɔna daa! Wina n nyina baalɛ wʋŋ wʋ a kalaa bakpa gapɩlɛkʋma wʋ a chicha daa bakpa, daa mbara na Ɩsʋɔ tʋm danɛ gana. Sɛ ŋii ŋɩ ti kpi na n nyina sɛ wʋ mʋ Girikitina kɔŋ daa Ɩsʋɔ tʋm danɛ gaa naŋ gaa yɩɛ Ɩsʋɔ tʋm danɛ chɩrɩchɩrɩ gana iniesi.&gt;&gt; <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />[Ba chɩŋkpɩɛ na Efiso wʋkpa Tirofimo na Pɔɔlʋ dɩɛ janɛ gaa naŋ, sɛ ba fa nfɩɛrɛ sɛ Pɔɔlʋ mʋ ɩ jʋʋ Ɩsʋɔ tʋm danɛ gaa naŋ.]<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Sɛ siŋii kɔŋ dɩɛ janɛ gaa naŋ, sɛ bakpa baa se lɩɩ dɩɛ gaa gapɩlɛkʋma kɔŋ dɩmaŋ. Ba chaŋ Pɔɔlʋ sɛ ba fɔŋɩ ɩ lɩɩ Ɩsʋɔ tʋm danɛ gaa naŋ, gabʋanaŋ sɛ ba tɔ bʋɔlɩɛ ŋii kpiniŋ. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Gʋ baa ja baa kʋ ɩ na, wɩɛ ŋii ga mɩɛna Roma yuora bɩnɛ wʋŋ takɩɛ siŋii kʋlʋ Yerusalem dɩɛ kpiniŋ naŋ. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Gabʋanaŋ sɛ wʋ lɩsɛ yuora na asanaŋtina barɛ sɛ ba se ju jama baa jaŋ. Gʋ jama baa na yuora bɩnɛ wʋŋ na wʋ yuora na, sɛ ba yela Pɔɔlʋ tugu.<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />Sɛ yuora bɩnɛ wʋŋ kɔŋ gaa chaŋ Pɔɔlʋ sɛ wʋ dʋ sɛ ba mʋ agbaraŋgbaraŋ ala pɔgʋ ɩ. Dɩmaŋ sɛ wʋ tasɛ wʋ tɛ wʋŋ wʋ yɩɛ, na ŋii wʋ yɩɛ. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Sɛ jama baa tɩba barɛ kuusi tawɩ wɩɛ ŋarɛ, sɛ barɛ dʋɔ a kuusi baa tawɩ wɩɛ abaŋbaŋ. Lɩɩna siŋii ŋii dʋɔ, yuora bɩnɛ wʋŋ n dɩlɛ yu wɩɛ ŋii naŋ gasiŋteŋ ŋ, sɛ wʋ dʋ sɛ ba n mʋ Pɔɔlʋ ju yuora dɩchatɩŋ. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Gʋ Pɔɔlʋ ga tala diele gaa baa jiŋ baa jʋʋ yuora dɩchatɩŋ gaa naŋ na, gʋ jama baa chɩdɩsɛ na baa laragi ɩ dʋɔ yuora baa jiŋna Pɔɔlʋ adugbe. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Sɛ jama baa ba kpamɩna na ju dʋɔ baa kuusi sɛ, &lt;&lt;N kʋ ɩ.&gt;&gt;<verse eid="ACT 21:36" /></para>
  <para style="s1">Pɔɔlʋ tawɩ gara wʋ wʋsɛ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Gʋ yuora baa aja baa mʋ Pɔɔlʋ ju ba dɩchatɩŋ na, wʋ tasɛ yuora bɩnɛ wʋŋ sɛ, &lt;&lt;Maa dɩlɛ tawɩ nyaŋ wɩɛ ŋarɛ?&gt;&gt;</para>
  <para style="p" vid="ACT 21:37">Sɛ wʋ tasɛ Pɔɔlʋ sɛ, &lt;&lt;Nyaa nyii Giriki dɩtawɩ?&gt;&gt;<verse eid="ACT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 21:38" />Sɛ wʋ ti tasɛ ɩ sɛ, &lt;&lt;Naa nyaŋ n nyina Ijipiti wʋkpa wʋŋ n cha kʋlʋ sɩŋ Romatina dʋɔ, sɛ nya pala gatagapʋtina kɔrʋɔsɛ sɩ nara asanaŋ ju ifuli dʋɔ saŋa gaa ga lam naa?&gt;&gt;<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Sɛ Pɔɔlʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Ma yɩɛ Yuda wʋkpa bɛ sɛ ma lɩɩ Taasusi gaa ga wɩɛ Kilikiya tibi dʋɔ. Ma yɩɛ Taasusi dɩɛ janɛ kpari gaa dɩɛsɛ bu bɛ. Maa sʋlʋ nyaŋ, yela na maa tawɩ bakpa baa jaŋ.&gt;&gt;<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Gʋ yuora bɩnɛ wʋŋ fa ɩ gbɩɛ na, Pɔɔlʋ kʋlʋ sɩŋ diele gaa baa jiŋ baa jʋʋ yuora baa dɩchatɩŋ, sɛ wʋ ŋɩrɛ jama baa pam sɛ ba n cha kuruŋ. Gʋ ba kpiniŋ ba cha kuruŋ na, sɛ wʋ tawɩ ba jaŋ Aramiki<note caller="+" style="f"><char style="fr" closed="false">21:40 </char><char style="ft" closed="false">Ɩsʋɔ Sabɩɛwɩɛ ŋarɛ wɩɛna Hibiri dɩtawɩ.</char></note> dɩtawɩ naŋ.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="nb">
    <verse number="1" style="v" sid="ACT 22:1" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Ma juo aba na ma dɔŋa Yudatina, dɩtɩɛna n nyii ma wɩɛ ŋii maa tawɩ mʋ gara ma wʋsɛ na.&gt;&gt;<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />Gʋ ba nyii gʋ wʋ tawɩ ba jaŋ Aramiki dɩtawɩ naŋ na, sɛ ba cha kuruŋ.</para>
  <para style="p" vid="ACT 22:2">Dɩmaŋ sɛ Pɔɔlʋ tawɩ sɛ, <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />&lt;&lt;Ma yɩɛ Yuda wʋkpa bɛ, sɛ ba lʋrʋ maŋ Taasusi gaa ga wɩɛ Kilikiya, ama ba bɩsɛ maŋ dɩɛ janɛ gana naŋ bɛ. Gamali n kalaa maŋ daa duluŋ mbara ŋii na dieli, sɛ ma mʋ jawʋ gaa ga nʋɔ wɩɛ doŋ kpaŋ Ɩsʋɔ takɩɛ ganaŋkʋ amɩɛ wʋkʋma kɩɛna jaŋ na. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Ma nyala baa ba kpamɩna dɩmʋŋ Gbɩɛ gaa, hali ga tala ba sɩŋ sɛ ma chaŋ baala na ala ga tɔ danɛ, <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />sɛ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ na dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa kpiniŋ gba a dɩlɛ di ŋina dʋɔ seriya. Ba fa maŋ tanɩɛ sɛ ma n mʋ ju ga fa ba dɔŋa baa ba wɩɛ Damasiko dɩɛ naŋ, na maa ju dɩmaŋ ga chaŋ dɩmʋŋ bakpa bana takɩɛ danɛtʋɔra kɔŋ Yerusalem na baa fɔŋɩ ba dɩla.&gt;&gt;<verse eid="ACT 22:5" /></para>
  <para style="s1">Pɔɔlʋ tawɩ ganaŋkʋ wʋ lɩɛ Yesu di dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="ACT 9:1-19">Dɩtʋm 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Aja yɩɛ wiita keŋkeŋ gʋ ma dɔŋ gbɩɛ dʋɔ sɛ ma tirina Damasiko dɩɛ na, gabʋanaŋ sɛ ŋmaŋi lɩɩ Ɩsʋɔ adugbe gaa chɩrɩɛ logo maŋ. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Sɛ ma lɩɩ sala tibi sɛ ma nyii lofu garɛ tawɩ maŋ sɛ Sɔɔlʋ! Sɔɔlʋ! Be n yɩɛ sɛ nyaa nyala maŋ?&gt;&gt;<verse eid="ACT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8" />Sɛ ma tasɛ sɛ, &lt;&lt;Kpaŋjuo, nyaŋ n nyina Mmʋɔ?&gt;&gt;</para>
  <para style="p" vid="ACT 22:8">Sɛ lofu gaa lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Maŋ n nyina Yesu Nasarati wʋkpa wʋŋ nyaa nyala ɩ na.&gt;&gt;<verse eid="ACT 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 22:9" />Ma dɔŋa na ŋmaŋi gaa, ama ba n nyii lofu gaa gaa tawɩ gaa fa maŋ na wɩɛ ŋii tie e.<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />Sɛ ma tasɛ sɛ, &lt;&lt;Kpaŋjuo, be sɛ maa yɩɛ?&gt;&gt;</para>
  <para style="p" vid="ACT 22:10">Sɛ Kpaŋjuo wʋŋ tawɩ ɩ sɛ, &lt;&lt;Kʋlʋ na nyaa ju Damasiko dɩɛ naŋ. Dɩmaŋ sɛ baa tawɩ nyaŋ ŋii ma mʋ fa nyaŋ sɛ nya n yɩɛ na kpiniŋ.&gt;&gt;<verse eid="ACT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 22:11" />Sɛ ma dɔŋa chaŋ ma pam naŋ pala ma asanaŋ mʋ maŋ ju Damasiko, akala takɩɛ ŋmaŋi gaa ga ŋmaŋi na salɩɛ ma asa.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />Sɛ wʋ ti tawɩ sɛ, &lt;&lt;Baalɛ wʋrʋ wʋŋ baa yagɛ ɩ sɛ Ananiyasi, wʋ a se Ɩsʋɔ sɛ wʋ a kpaŋ Mosesi mbara ŋii dʋɔ, wʋŋ Yudatina baa ba chaɩ dɩmaŋ kpiniŋ a bu ɩ na kɔŋ gaa kɩɛ maŋ. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Sɛ wʋ gaa sɩŋ ma jaŋ tawɩ maŋ sɛ ma dʋɔ lɩɛdɩrɛ Sɔɔlʋ, ti bɔrɛ na abʋrɩ.&gt;&gt; Sɛ gabʋanaŋ ma na ɩ.<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />Sɛ wʋ ti tawɩ sɛ, &lt;&lt;Daa duluŋ Ɩsʋɔ n lɩsɛ nyaŋ sɛ nya n jiŋ wʋ jawʋ na nyaa na Wʋchirigisa Wʋŋ, na nyaa nyii wʋ nʋɔ naŋ wɩɛ. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Nyaa di wʋ wʋsɛ dʋɔ seriya lɩɩna ŋii n nyii na ŋii nya na na fa bakpa kpiniŋ. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Dɩtɩɛna be sɛ n dana? Kʋlʋ na baa sɔ nyaŋ, na wʋ a mʋ n dɩsʋbʋ chɩɛ nyaŋ, na nyaa yagɛ wʋ yɩrɛ.&gt;&gt;<verse eid="ACT 22:16" /></para>
  <para style="s1">Ɩsʋɔ yagɛ Pɔɔlʋ sɛ wʋ n ju ga tawɩ wʋ wɩɛ fa baa ba ba yɩɛ Yudatina</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Gʋ ma bɔrɛ ju Yerusalem ma wɩɛ Ɩsʋɔ tʋm danɛ gaa naŋ maa jɔ dɩga na, ma yu Ɩsʋɔ lɩsɛ kalaa <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />sɛ ma nyii gʋ Kpaŋjuo a tawɩ wʋ a fa maŋ sɛ yɩɛ bileŋ na nyaa lɩɩ Yerusalem gabʋanaŋ, akala takɩɛ ba aa lɩɛ n seriya gaa nyaa di lɩɩ ma dʋɔ na dʋ ʋ.&gt;&gt;<verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />Sɛ ma lɩsɛ nʋɔ sɛ, &lt;&lt;Kpaŋjuo, dɩmʋŋ bakpa bana jiŋ gʋ ma pala ba tʋm danɩŋ naŋ na maa tɔ ba danɛ, sɛ ma tugu baa ba lɩɛ nyaŋ di na. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Gʋ ba kʋ Sitifiŋ amɩɛ seriyatɛ wʋŋ na, ma sɩŋ dɩmaŋ lɩɛ wʋ sɩŋ gaa dʋ, sɛ maa kɩɛ baa ba kʋ ɩ na gagbasɛ dʋɔ.&gt;&gt;<verse eid="ACT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21" />Sɛ wʋ ti tawɩ sɛ, &lt;&lt;Dɩmaŋ sɛ Kpaŋjuo wʋŋ tawɩ maŋ sɛ, pala, maa kpiri nyaŋ gbɩɛ taŋasɛ ju baa ba ba yɩɛ Yudatina na jaŋ.&gt;&gt;<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Sɛ jama baa nyii Pɔɔlʋ wɩɛ ga tala gʋ wʋ tawɩ dɩmʋŋ wɩɛ ŋina. Dɩmaŋ sɛ ba kuusi na doŋ sɛ, &lt;&lt;N kʋ ɩ, wʋ n daga na wʋ a cha nkpa naŋ ŋ.&gt;&gt;<verse eid="ACT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23" />Gʋ baa kuusi yela baa fulu ba gagbasɛ na, yela baa lɔ tɩɛra baa dʋ feliŋ naŋ, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />sɛ yuora bɩnɛ wʋŋ dʋ sɛ ba n mʋ Pɔɔlʋ jʋʋ yuora dɩchatɩŋ gaa naŋ. Sɛ wʋ tawɩ ba sɛ ba n taɩ ɩ achʋchʋɛ na baa tasɛ ɩ jiŋ kpɩnɩdɩ dʋɔ sɛ bakpa baa a kuusi baa baŋ ɩ dɩmʋŋ. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Gʋ ba tɩɛŋɩ ɩ na baa taɩ ɩ achʋchʋɛ na, sɛ Pɔɔlʋ tawɩ yuora gafie bɩnɛ wʋŋ wʋ sɩmɩɛɩ dɩmaŋ na sɛ, &lt;&lt;Mbara ŋii fa amɩɛ gbɩɛ sɛ n taɩ Roma dɩɛsɛ-bu achʋchʋɛ yela ɩŋ fu ɩ dɩpʋɛ?&gt;&gt;<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Gʋ yuora gafie bɩnɛ wʋŋ nyii ŋina na, wʋ ju yuora baa bɩnɛ wʋŋ jaŋ ga tawɩ ɩ. Sɛ wʋ tasɛ ɩ sɛ, &lt;&lt;Be sɛ nyaa yɩɛ? Dɩmʋŋ baalɛ wina yɩɛ Roma dɩɛsɛ-bu bɛ.&gt;&gt;<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Sɛ yuora bɩnɛ wʋŋ ju Pɔɔlʋ jaŋ ga tasɛ ɩ sɛ, &lt;&lt;Tawɩ maŋ, nya yɩɛ Roma dɩɛsɛ-bu bɛ?&gt;&gt;</para>
  <para style="p" vid="ACT 22:27">Sɛ wʋ lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Ɛɛŋ, ma yɩɛ.&gt;&gt;<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Dɩmaŋ sɛ yuora bɩnɛ wʋŋ tawɩ sɛ, &lt;&lt;Ma tɔ aterembie fɔɩ pɔɩ sɛ ma yɩɛ Roma dɩɛsɛ-bu.&gt;&gt;</para>
  <para style="p" vid="ACT 22:28">Ama Pɔɔlʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Maŋ bɩrɛ ba lʋrʋ maŋ Roma dɩɛsɛbu bɛ.&gt;&gt;<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Gabʋanaŋ sɛ baa nafʋɔ ba ja baa tasɛ ɩ wɩɛ na bɔrɛ ba wʋrʋgbɩɛ. Gʋ yuora bɩnɛ wʋŋ jiŋ gʋ Pɔɔlʋ yɩɛ Roma dɩɛsɛ-bu sɛ wʋ mʋ agbaraŋgbaraŋ pɔgʋ ɩ na, nyɩŋtɩɛ chaŋ ɩ.<verse eid="ACT 22:29" /></para>
  <para style="s1">Pɔɔlʋ sɩmɩɛɩ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Gʋ tɩɛna na, yuora bɩnɛ wʋŋ a ja wʋ a jiŋ bʋrʋ ga dʋŋdʋlʋŋ gaa ga dʋɔ sɛ Yudatina baa cha baa pʋɩ Pɔɔlʋ, sɛ wʋ yela Pɔɔlʋ sɛ wʋ dʋ Ɩsʋɔ sei bɩnɩɛ baa na dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa kpiniŋ gaa jaŋi. Dɩmaŋ sɛ wʋ mʋ Pɔɔlʋ kɔŋ gaa sɩŋ ba asanaŋ.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Sɛ Pɔɔlʋ kɩɛ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa surumm sɛ wʋ tawɩ sɛ, &lt;&lt;Ma dɔŋa Yudatina, ma jiŋ gʋ ma nfɩɛrɛ naŋ ba aa nyala maŋ lɩɩna chawʋ gaa ma cha Ɩsʋɔ asanaŋ gaa tala dɩmʋŋ wɩɩ gana a.&gt;&gt; <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Dɩmaŋ sɛ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ Ananiyasi dʋ baa ba sɩmɩɛɩ tirina Pɔɔlʋ na sɛ ba n jɔ wʋ nʋɔ dʋɔ. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Dɩmaŋ sɛ Pɔɔlʋ tawɩ ɩ sɛ, &lt;&lt;Ɩsʋɔ aja jɔ nyaŋ wʋŋ nya kɩɛna takɩɛ gabaŋdɩɛ gafʋlʋm. N cha dɩmaŋ di ma wɩɛ ganaŋkʋ mbara ŋii kalaa, ama nyaŋ n tɩŋtɩŋ nya warɩɛ mbara ŋii takɩɛ nya dʋ sɛ ba n jɔ maŋ!&gt;&gt;<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Sɛ baa ba sɩmɩɛɩ tirina Pɔɔlʋ na tawɩ sɛ, &lt;&lt;Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ sɛ nyaa tɩwʋ?&gt;&gt;<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Sɛ Pɔɔlʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Ma dɔŋa Isiralitina, ma ba jiŋ sɛ wʋ yɩɛ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ ɛ, akala takɩɛ ba sabɩɛ si sɛ, &lt;N baa tawɩ wɩɛ asʋbʋɛ baŋ asanaŋtɛ wʋŋ wʋ a kɩɛ n bakpa dʋɔ.&gt;<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">Ɛsa 22:28</ref>.</char></note>&gt;&gt;<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Gʋ Pɔɔlʋ jiŋ gʋ bakpa baa barɛ yɩɛ Sadukitina sɛ ba barɛ dʋɔ yɩɛ Farasitina na, wʋ kuusi dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ baa tɩba tawɩ sɛ, &lt;&lt;Ma dɔŋa Isiralitina, ma yɩɛ Farasi wʋkpa na Farasi wʋkpa bu bɛ. Ma sɩmɩɛɩ baa di ma wɩɛ lɩɩna tamaa gaa ma wɩɛna gʋ atatina aja feŋ lɩɩ sɩŋ naŋ na dʋɔ.&gt;&gt; <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />Gʋ wʋ tawɩ ŋina na, sɛ noro kɔŋ Farasitina na Sadukitina baa tɩtɩba, sɛ bakpa baa ba jaŋi na kpara tɩba. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />[Sɛ Sadukitina baa tawɩ sɛ feŋ lɩɩ sɩŋ naŋ taŋ ŋ, sɛ Ɩsʋɔ gabʋɔsɛ yaa feliŋ taŋ ŋ, ama Farasitina baa bɩrɛ lɩɛ ŋina kpiniŋ dʋ.]<verse eid="ACT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9" />Sɛ siŋii gaa ga nʋɔ wɩɛ doŋ kɔnɛ, sɛ mbara bakalaasa baa barɛ baa ba yɩɛ Farasitina na, kʋlʋ sɩŋ baa di noro doŋ dʋɔ baa tawɩ sɛ, &lt;&lt;Dɩ n na bʋrʋ gaa ga taŋ dieli baalɛ wina dʋɔ ɔ. Akʋtɔfɩɛ feliŋ yaa Ɩsʋɔ gabʋɔ n tawɩ wʋ jaŋ.&gt;&gt; <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Sɛ noro gaa nʋɔ yɩɛ doŋ sɛ nyɩŋtɩɛ chaŋ yuora bɩnɛ wʋŋ, takɩɛ baa chati Pɔɔlʋ tɩba aguŋda. Sɛ wʋ dʋ yuora baa sɛ ba n ju ga lɩɛ Pɔɔlʋ lɩɩ jama baa jaŋ doŋ dʋɔ, na baa mʋ ɩ kɔŋ yuora dɩchatɩŋ gaa.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Gʋ tɩɛna yuluma na, Kpaŋjuo gaa sɩŋ tirina Pɔɔlʋ tawɩ ɩ sɛ, &lt;&lt;Yu digela! Ganaŋkʋ nya di ma wʋsɛ dʋɔ seriya Yerusalem na, dɩmʋŋ gba sɛ ŋɩ tiri gʋ nya n di ma wʋsɛ dʋɔ seriya Roma dɩɛ naŋ.&gt;&gt;<verse eid="ACT 23:11" /></para>
  <para style="s1">Ba jɔ dɩkɔŋ sɛ baa kʋ Pɔɔlʋ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Gʋ tɩɛna na, Yudatina baa barɛ wɩsɛ jaŋi jɔ dɩkɔŋ ka ntaŋ sɛ, ba aa di i yaa ba aa nyʋɔ ɔ ga tala gʋ baa kʋ Pɔɔlʋ <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Baala baa ba jɔ dɩmʋŋ dɩkɔŋ gana na kii ŋɩla (40). <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Ba ju Ɩsʋɔ sei bɩnɩɛ na dɩɛ naŋ bɩnɩɛ baa jaŋ ga tawɩ sɛ, &lt;&lt;Dɩ ka ntaŋ gaa ga nʋɔ wɩɛ doŋ takɩɛ dɩ ɩɩ di bʋrʋ ʋ ga tala gʋ dɩɩ kʋ Pɔɔlʋ. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Dɩtɩɛna amɩɛ na dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa n tawɩ yuora bɩnɛ wʋŋ sɛ wʋ n mʋ Pɔɔlʋ kɔŋ amɩɛ asanaŋ, na ɩ yɩɛ takɩɛ ɩ ja sɛ ɩ nyii wʋ wɩɛ ŋii tɩba na dieli. Dɩ yɩɛ sɩrɩya takɩɛ dɩɩ kʋ ɩ pɔɩ na wʋ a tala jɩna.&gt;&gt;<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Ama gʋ Pɔɔlʋ gagbelabie baalɛ jaŋ nyii dɩmʋŋ dɩkɔŋ gaa ba jɔ na, wʋ ju yuora dɩchatɩŋ gaa ga tawɩ Pɔɔlʋ.<verse eid="ACT 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 23:17" />Dɩmaŋ sɛ Pɔɔlʋ yagɛ yuora gafie bɩnɩɛ baa tɩba wʋrʋ tawɩ ɩ sɛ, &lt;&lt;Mʋ yeleŋbu wina ju yuora bɩnɛ wʋŋ jaŋ, wʋ wɩɛna wɩɛ ŋarɛ na wʋ a tawɩ ɩ.&gt;&gt; <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Dɩmʋŋ dʋɔ wʋ mʋ ɩ ju yuora bɩnɛ wʋŋ jaŋ.</para>
  <para style="p" vid="ACT 23:18">Sɛ yuora gafie bɩnɛ wʋŋ tawɩ sɛ, &lt;&lt;Pɔɔlʋ danɛtʋɔrɛ wʋŋ n kpiri yagɛ maŋ sɛ ma n mʋ baalɛ wina kɔna nyaŋ, akala takɩɛ wʋ wɩɛna wɩɛ ŋarɛ wʋ a tawɩ nyaŋ.&gt;&gt;<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Sɛ yuora bɩnɛ wʋŋ chaŋ yeleŋbu wʋŋ pam naŋ mʋ ɩ lɩɩ laraŋ, sɛ wʋ tasɛ ɩ sɛ, &lt;&lt;Be wɩɛ sɛ n wɩɛna na nyaa tawɩ maŋ?&gt;&gt;<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Sɛ wʋ tawɩ yuora bɩnɛ wʋŋ sɛ, &lt;&lt;Yudatina baa tawɩ kpa sɛ baa sʋlʋ nyaŋ na nyaa mʋ Pɔɔlʋ kɔŋ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ chifuo, na baa yɩɛ takɩɛ baa ja sɛ baa nyii wʋ wɩɛ ŋii tɩba na dieli. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Ama n baa nyii tie fa ba, akala takɩɛ bakpa baa kii ŋɩla gʋ baa fu gbɩɛ naŋ na baa da ɩ. Ba ka ntaŋ sɛ ba aa di i yaa ba aa nyʋɔ ɔ ga tala gʋ baa kʋ ɩ. Dɩtɩɛna ba yɩɛ sɩrɩya ba dana takɩɛ nyaa kpa ŋii ba sʋlʋ nyaŋ na.&gt;&gt;<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Sɛ yuora bɩnɛ wʋŋ tawɩ yeleŋbu wʋŋ sɛ wʋ n pala, sɛ wʋ dʋ ɩ sɛ, &lt;&lt;N baa tawɩ wʋrʋ sɛ nya tawɩ wɩɛ ŋina fa maŋ.&gt;&gt;<verse eid="ACT 23:22" /></para>
  <para style="s1">Ba mʋ Pɔɔlʋ ju Roma tibi kɩɛrɛ Felisi jaŋ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Sɛ yuora bɩnɛ wʋŋ yagɛ wʋ yuora gafie bɩnɩɛ bala dʋ ba sɛ, &lt;&lt;N yela na yuora gafisi sɩla, yuora baa baa cha abeŋi dʋɔ ŋitoro sala na yuora baa baa lɔ banɩŋ gafisi sɩla a yɩɛ sɩrɩya, na baa ju Kayisariya yuluma karafɩɛ saŋgʋ. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />N ja abeŋi fa Pɔɔlʋ ganaŋkʋ baa mʋ ɩ ju na alaŋfiya ga fa Felisi wʋŋ wʋ yɩɛ Roma bɩnɛ wʋŋ wʋ a kɩɛ Isirali tibi dʋɔ na.&gt;&gt;<verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />Sɛ wʋ sabɩɛ tanɛ tawɩ sɛ,<verse eid="ACT 23:25" /></para>
  <para style="pmo">
    <verse number="26" style="v" sid="ACT 23:26" />Maŋ Kaladiyosi Lisiyasi aaŋ sabɩɛ dɩmʋŋ tanɛ gana maa fa nyaŋ Felisi Roma tibi kɩɛrɛ Wʋkpari.</para>
  <para style="pmo" vid="ACT 23:26">Maa yɩlɩ nyaŋ.<verse eid="ACT 23:26" /></para>
  <para style="b" />
  <para style="pm">
    <verse number="27" style="v" sid="ACT 23:27" />Yudatina baa n chaŋ dɩmʋŋ baalɛ wina baa ja baa kʋ ɩ, ama maŋ na ma yuora dɩ kɔŋ gaa lɩɛ ɩ, akala takɩɛ ma jiŋ gʋ wʋ yɩɛ Roma dɩɛsɛ-bu bɛ. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Maa ja maa jiŋ kpɩnɩdɩ dʋɔ sɛ baa pʋɩ ɩ, dɩmʋŋ dʋɔ ma mʋ ɩ kɔŋ ba dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ gaa asanaŋ. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Ma na gʋ ba pʋɩ ŋii yɩɛ ba mbara dʋɔ wɩɛ tasɛ bɛ. Ama pʋɩ ŋarɛ taŋ ŋii baŋ ɩ takɩɛ dɩ daga baa kʋ ɩ yaa baa tɔ ɩ danɛ dɩtʋɔtɩŋ ŋ. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Gʋ ba tawɩ maŋ dɩkɔŋ gaa ba jʋɔ takɩɛ baa kʋ baalɛ wina na, ma yɩɛ bileŋ mʋ ɩ kɔna nyaŋ. Sɛ ma tawɩ wʋ pʋɩra baa sɛ ba n kɔŋ nya asanaŋ gaa tawɩ wɩɛ ŋii ba chamɩna baa pʋɩ ɩ na.<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Dɩmʋŋ dʋɔ yuora baa yɩɛ ganaŋkʋ ba dʋ ba na, sɛ ba mʋ Pɔɔlʋ dɩmʋŋ yuluma gana ju taŋasɛ Antipatiri dɩɛ naŋ. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Gʋ tɩɛna na, ba yela sɛ yuora baa baa cha abeŋi dʋɔ, ju dʋɔ mʋ ɩ ju sɛ yuora baa ba dɔŋ na bɔrɛ kɔŋ ba dɩchatɩŋ. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Gʋ yuora baa baa cha abeŋi dʋɔ tala Kayisariya na, ba mʋ tanɛ ga fa Roma tibi kɩɛrɛ wʋŋ sɛ ba mʋ Pɔɔlʋ dʋ wʋ pamɩɛ naŋ. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Sɛ Roma tibi kɩɛrɛ wʋŋ karaŋ tanɛ gaa sɛ wʋ tasɛ tibi gaa wʋ lɩɩ ga dʋɔ. Gʋ wʋ jiŋ gʋ wʋ lɩɩ Kilikiya na, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />wʋ tawɩ sɛ, &lt;&lt;Nya pʋɩra tala jɩna na, sɛ maa di n wɩɛ.&gt;&gt; Dɩmaŋ sɛ wʋ dʋ sɛ ba n kɩɛ Pɔɔlʋ dʋɔ Hɛrɔdɩ juorigbɩɛ gaa naŋ.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s1">Ba pʋɩ Pɔɔlʋ Felisi asanaŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Wɩɛ anʋŋ wʋrʋgbɩɛ na, Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ Ananiyasi, dɩɛ naŋ bɩnɩɛ barɛ na mbara jɩmɩrɛ wʋŋ baa yagɛ ɩ sɛ Tetulo na kɔŋ Kayisariya dɩɛ naŋ. Sɛ ba mʋ ba pʋɩ ŋii ba mʋ baŋ Pɔɔlʋ na kɔŋ Roma bɩnɛ wʋŋ wʋ a kɩɛ Isirali tibi dʋɔ na asanaŋ. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Gʋ ba yagɛ Pɔɔlʋ jʋʋ na, sɛ Tetulo fara wʋ a tawɩ ŋii wʋ mʋ pʋɩ Pɔɔlʋ Felisi asanaŋ sɛ, &lt;&lt;Nya chifuo dʋɔ nfɩɛrɛ mʋ abʋrɩ abama kɔŋ tibi gana dʋɔ sɛ dɩ yu wʋsɛfɩɛ taŋgɩlɛ n tie. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Felisi wʋkpari, gapɩlɛkʋma na gbɩɛ kʋma dʋɔ, daa asasu ŋina dʋɔ sɛ dɩɩ yɩlɩ nyaŋ fɔɩ. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ama ganaŋkʋ ma aa nyala nyaŋ fɔɩ na dʋɔ, maa sʋlʋ nyaŋ sɛ nya n yu digela na nyaa nyii daa wɩɛ diguŋ.&gt;&gt;<verse eid="ACT 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5" />&lt;&lt;Dɩ fɩla na baalɛ wina gʋ wʋ yɩɛ ganyala wʋkpa bɛ, sɛ wʋ a fuosi siŋii wʋ a dʋ Yudatina kpiniŋ tɩba dulunya gapɩlɛkʋma. Sɛ wʋ ti wʋ yɩɛ Nasarene akarɩɛ dikpeŋ gaa asanaŋtɛ, <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />sɛ hali wʋ ja wʋ a mʋ iniesi mʋ yɩɛ Ɩsʋɔ tʋm danɛ gaa, dɩmʋŋ dʋɔ dɩ chaŋ ɩ. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Ama yuora bɩnɛ Lisiyasi mʋ doŋ gaa lɩɛ ɩ lɩɩ daa pamɩɛ naŋ. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />N tɩŋtɩŋ n kɩɛ tɩba na dieli na, nyaa dɩlɛ jiŋ gasiŋteŋ gaa lɩɩna pʋɩ ŋii dɩ mʋ baŋ ɩ na.&gt;&gt;<verse eid="ACT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9" />Sɛ Yudatina baa gba pʋɩ ɩ tawɩ sɛ ŋina kpiniŋ yɩɛ gasiŋteŋ bɛ.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Gʋ Roma tibi kɩɛrɛ wʋŋ ŋɩrɛ ba pam sɛ wʋ n tawɩ na, sɛ Pɔɔlʋ tawɩ sɛ, &lt;&lt;Ma jiŋ gʋ bɩŋsɛ fɔɩ mɩnaŋ gʋ n cha nya yɩɛ wɩɛ diri tibi gana dʋɔ. Dɩmʋŋ dʋɔ dɩ yɩɛ maŋ jʋŋ gʋ maa tawɩ ma wɩɛ gara ma wʋsɛ. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Nyaa dɩlɛ kɩɛ ŋɩ tɩba na nyaa nyii takɩɛ wɩɛ gifi ala mɩnaŋ gʋ ma ju Yerusalem ga tʋm Ɩsʋɔ. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Ma pʋɩra n na maŋ na wʋrʋ a di noro Ɩsʋɔ tʋm danɛ gaa naŋ ŋ, yaa maa fuosi maa dʋ jama baa Yudatina tʋm danɩŋ naŋ yaa dɩɛ janɛ gaa naŋ gatʋŋgʋrʋ ʋ. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Sɛ dɩtɩɛna ba aa dɩlɛ kalaa pʋɩ ŋii ba mʋ baŋ maŋ na tɩba fa nyaŋ ŋ. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Ama ma lɩɛ dʋ gʋ ma tʋm daa duluŋ Ɩsʋɔ takɩɛ wʋŋ wʋ yɩɛ Gbɩɛ gaa baa yagɛ sɛ akarɩɛ dikpeŋ na kpamɩrɛ. Ma lɩɛ bʋrʋkʋma gaa ga kpa Mosesi mbara ŋii, na ŋii ba sabɩɛ Ɩsʋɔ bajana baa tanɩɛ naŋ na di, <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />sɛ ma wɩɛna tamaa gadʋŋdʋlʋŋ Ɩsʋɔ naŋ takɩɛ baala bana takɩɛ feŋ lɩɩ sɩŋ naŋ wɩɛ fa bachirigisa na baa ba n chirigi na kpiniŋ. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Dɩmʋŋ dʋɔ saŋa kʋma maa chɩdɩsɛ ganaŋkʋ ma nfɩɛrɛ naŋ ba aa nyala maŋ Ɩsʋɔ na wʋkpa asanaŋ.&gt;&gt;<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />&lt;&lt;Gʋ ma lɩɩ Yerusalem bɩŋsɛ fɔɩ wʋrʋgbɩɛ na, ma bɔrɛ kɔŋ dɩmaŋ na maa gaa fa ma bakpa baa ba yɩɛ ayɔŋtina na afaasa, na maa diesi gadiesa. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Gʋ maa yɩɛ iniesi saŋ lɩsɛ, sɛ ma tam na sɛ ba na maŋ Ɩsʋɔ tʋm danɛ gaa naŋ. Jama taŋ ma jaŋ ŋ yaa ma n kpi siŋii ŋarɛ dʋɔ ɔ. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Ama Yudatina barɛ baa ba lɩɩ Asiya tibi na wɩɛ dɩmaŋ, baa sɛ nafʋɔ ba wɩɛna pʋɩ ŋarɛ na, dɩ daga baa kɔŋ nya asanaŋ jɩna gaa mʋ baŋ maŋ, <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />yaa bana baa ba wɩɛ jɩna n na n tawɩ dɩsʋbʋ gaa ba na ma dʋɔ saŋa gaa ma sɩmɩɛɩ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ baa asanaŋ na. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Amʋɔ bʋrʋ ga dʋŋdʋlʋŋ gana sɛ ma kuusi tawɩ, gʋ ma sɩmɩɛɩ ba asanaŋ na, ŋɩ yɩɛ lɩɩna atatina feŋ lɩɩ sɩŋ naŋ dʋɔ sɛ ma wɩɛ nya asanaŋ baa di ma wɩɛ jaŋ.&gt;&gt;<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Dɩmaŋ sɛ Felisi wʋŋ wʋ jiŋ Gbɩɛ gaa dʋɔ wɩɛ na kʋna wɩɛ ŋii si, tawɩ sɛ, &lt;&lt;Sɛ yuora bɩnɛ Lisiyasi kɔnɛ na, maa di n wɩɛ, sɛ wʋ mʋ wɩɛ di ŋii si gɩyɩɛ gafɔlɛ.&gt;&gt; <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Sɛ wʋ dʋ yuora gafie bɩnɛ wʋŋ sɛ wʋ n gie Pɔɔlʋ, ama wʋ n yela na wʋ a yu wʋ wʋsɛ na wʋ a fa wʋ dɩɛtina gbɩɛ na baa fa ɩ ŋii ŋɩ tiri ɩ na.<verse eid="ACT 24:23" /></para>
  <para style="s1">Ba mʋ Pɔɔlʋ kɔŋ Felisi na Durusila asanaŋ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Gɩyɩɛnɩŋ fɔɩ wʋrʋgbɩɛ na, Felisi na wʋ alʋ Durusila wʋŋ wʋ yɩɛ Yuda wʋkpa na kɔnɛ. Sɛ wʋ kpiri yagɛ Pɔɔlʋ na wʋ a nyii wʋ jaŋ gʋ wʋ tawɩ lɩɩna Yesu Kirisito lɩɛdi naŋ dʋɔ wɩɛ na. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Gʋ Pɔɔlʋ a tawɩ chirigi, chaŋ n wʋsɛ na wɩɛ di gaa gaa kɔŋ wɩɛ na, nyɩŋtɩɛ chaŋ Felisi sɛ wʋ tawɩ sɛ, &lt;&lt;Dɩtɩɛna dɩ mɩɛ dɩmʋŋ. Nyaa dɩlɛ lam. Ma yu saŋa na, maa kpiri yagɛ nyaŋ.&gt;&gt; <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Dɩmʋŋ saŋa gana na, wʋ wɩɛna tamaa gʋ Pɔɔlʋ aja wʋ a fa ɩ wɩsɛ aterembie. Dɩmʋŋ dʋɔ wʋ a dɩlɛ wʋ a kpiri wʋ a yagɛ ɩ na wʋ na ɩ baa biri alijima.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Bɩŋsɛ sɩla wʋrʋgbɩɛ na, Pokiyo Fesito gaa baŋ Felisi nafara naŋ. Ama gʋ Felisi aja sɛ wʋ a yɩɛ bʋrʋ darɛ na Yudatina baa asasu wʋ dʋɔ na, wʋ yela Pɔɔlʋ danɛ dɩtʋɔtɩŋ.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s1">Pɔɔlʋ sʋlʋ sɛ Juo Kayisa n di wʋ wɩɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Gʋ Fesito kɔŋ Kayisariya tibi dʋɔ wɩɛ atoro wʋrʋgbɩɛ na, wʋ lɩɩ dɩmaŋ ju Yerusalem, <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />dɩmaŋ sɛ Ɩsʋɔ sei bɩnɩɛ na Yudatina asanaŋtina baa kɔŋ wʋ asanaŋ gaa tawɩ ba pʋɩ wɩɛ baŋ Pɔɔlʋ. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Sɛ ba sʋlʋ Fesito sɛ wʋ n yɩɛ ŋii ŋii su ba asa fa ba, na wʋ a yela na Pɔɔlʋ a kɔŋ Yerusalem. Akala takɩɛ ba kʋla ba wʋsɛ takɩɛ baa fu gbɩɛ naŋ na baa kʋ ɩ. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Sɛ Fesito lɩsɛ nʋɔ sɛ, &lt;&lt;Pɔɔlʋ saŋ wʋ wɩɛ danɛ dɩtʋɔtɩŋ Kayisariya, sɛ ba aa taŋgɩlɛ ɛ, ma tɩŋtɩŋ maa ju dɩmaŋ. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />N lɩsɛ amɩɛ asanaŋtina barɛ na maŋ na ba dɩɩ ju, sɛ baalɛ wina yɩɛ bʋrʋ gaa ga taŋ dieli na, na ɩ pʋɩ ɩ dɩmaŋ.&gt;&gt;<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Gʋ Fesito cha ba jaŋ wɩɛ jiŋinara yaa gifi wʋrʋgbɩɛ na, wʋ lɩɩ dɩmaŋ ju Kayisariya. Gʋ tɩɛna na wʋ cha takɩɛ wɩɛ diri sɛ wʋ dʋ sɛ ba n mʋ Pɔɔlʋ kɔŋ wʋ asanaŋ. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Gʋ Pɔɔlʋ kɔŋ dɩmaŋ na, Yudatina baa ba lɩɩ Yerusalem na sɩmɩɛɩ logo ɩ, sɛ ba tawɩ pʋɩ ŋii ŋɩ nʋɔ wɩɛ doŋ fɔɩ baŋ ɩ, ŋii ba n dɩlɛ kalaa tɩba a.<verse eid="ACT 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8" />Dɩmaŋ sɛ Pɔɔlʋ tawɩ gara wʋ wʋsɛ sɛ, &lt;&lt;Ma n yɩɛ bʋrʋ gaa ga taŋ dieli chicha Yudatina mbara ŋii yaa Ɩsʋɔ tʋm danɛ gaa yaa Juo Kayisa a.&gt;&gt;<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Ama gʋ Fesito a ja wʋ a yɩɛ ŋii ŋii su Yudatina baa asa na dʋɔ, wʋ tasɛ Pɔɔlʋ sɛ, &lt;&lt;Nyaa ja sɛ nyaa ju Yerusalem, na maa di n wɩɛ ma asanaŋ dɩmaŋ lɩɩna pʋɩ ŋina dʋɔ yaa?&gt;&gt;<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Sɛ Pɔɔlʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Dɩtɩɛna ma sɩmɩɛɩ nya asanaŋ takɩɛ nya yɩɛ wɩɛ diri Juo Kayisa wɩɛ didiitiŋ, dɩmaŋ sɛ dɩ daga gʋ ba n di ma wɩɛ. Ma n yɩɛ Yudatina baa bʋrʋ gaa ga taŋ dieli i, takɩɛ ganaŋkʋ n tɩŋtɩŋ nya jiŋ na dieli na. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Nafʋɔ ma di dɩpʋɛ ŋii ma yɩɛ sɛ ŋɩ daga sɩŋ na, ma n pɩɛ sɛ ma aa sɩŋ ŋ. Ama sɛ Yudatina pʋɩ ŋii ba mʋ baŋ maŋ ba yɩɛ gasiŋteŋ ŋ bɩrɛ na, wʋrʋ taŋ gbɩɛ na wʋ a lɩsɛ maŋ fa ba a. Maa sʋlʋ sɛ Kayisa n di ma wɩɛ!&gt;&gt;<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Gʋ Fesito na wʋ bɩnɩɛ mʋ sawʋra wʋrʋgbɩɛ na, ba tawɩ Pɔɔlʋ sɛ, &lt;&lt;Nya sʋlʋ sɛ Kayisa n di nya wɩɛ. Kayisa jaŋ sɛ nyaa ju!&gt;&gt;<verse eid="ACT 25:12" /></para>
  <para style="s1">Pɔɔlʋ sɩŋ Agiripa na Benisi asanaŋ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Wɩɛ akalisa ŋarɛ wʋrʋgbɩɛ na, Juo Agiripa na Benisi kɔŋ Kayisariya dɩɛ naŋ na baa gaa yɩlɩ Fesito. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Gʋ ba cha dɩmaŋ gɩyɩɛnɩŋ fɔɩ na, sɛ Fesito tawɩ Pɔɔlʋ wɩɛ fa Juo wʋŋ sɛ, &lt;&lt;Baalɛ wʋrʋ wɩɛ jɩna gʋ Felisi yela ɩ takɩɛ danɛtʋɔrɛ. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Gʋ ma ju Yerusalem na, Ɩsʋɔ sei bɩnɩɛ na Yudatina bɩnɩɛ baa mʋ pʋɩ kɔŋ gaa baŋ ɩ sɛ ba sʋlʋ maŋ sɛ ma n fu ɩ dɩpʋɛ.&gt;&gt;<verse eid="ACT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16" />Sɛ Fesito tawɩ juo sɛ, &lt;&lt;Ma tawɩ ba sɛ ŋɩ ba yɩɛ daa Romatina ayɩɛsa takɩɛ dɩ n fu wʋrʋ dɩpʋɛ pɔɩ na wʋ a jaŋi wʋ pʋɩra a, na wʋ a yu gbɩɛ tawɩ wɩɛ mʋ gara wʋ wʋsɛ lɩɩ ba pʋɩ ŋii dʋɔ. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Gʋ ba sɩla ma jaŋ jɩna na, ma n taŋgɩlɛ dʋɔ ɔ, gʋ tɩɛna na, ma ju ga cha wɩɛ diri gbeli dʋɔ sɛ ma dʋ sɛ ba n mʋ baalɛ wʋŋ kɔŋ dɩmaŋ. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Gʋ wʋ pʋɩra baa kʋlʋ sɩŋ baa tawɩ na, ba n dɩlɛ mʋ wɩɛ asʋbʋɛ pʋɩ ɩ ŋii nafʋɔ ma asa jagaɩ dʋɔ na a. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Ama ba na ɩ di noro lɩɩna ba tɩŋtɩŋ ba tʋm dʋɔ, na lɩɩna baalɛ wʋŋ wʋ sɩŋ sɛ baa yagɛ ɩ sɛ Yesu wʋŋ Pɔɔlʋ a tawɩ sɛ wʋ chaɩ nkpa naŋ. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Sɛ ma ba jiŋ ŋii ma n yɩɛ na maa kɩɛ wɩɛ ŋii naŋ na dieli i. Dɩmʋŋ dʋɔ ma tawɩ ɩ sɛ, wʋ a ja sɛ wʋ a ju Yerusalem na maa ga di wʋ wɩɛ dɩmaŋ pʋɩ ŋina dʋɔ. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Sɛ Pɔɔlʋ sʋlʋ sɛ ba n yela Juo janɛ Kayisa a mʋ nfɩɛrɛ na wʋ a di wʋ wɩɛ, ma dʋ sɛ ba n gie e ga tala gʋ maa mʋ ɩ ga fa Kayisa.&gt;&gt;<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Dɩmaŋ sɛ Agiripa tawɩ Fesito sɛ, &lt;&lt;Ma tɩŋtɩŋ maa ja sɛ maa nyii baalɛ wina nʋɔ naŋ wɩɛ.&gt;&gt;</para>
  <para style="p" vid="ACT 25:22">Sɛ Fesito lɩsɛ nʋɔ sɛ, &lt;&lt;Chifuo nyaa nyii wʋ nʋɔ naŋ wɩɛ.&gt;&gt;<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Gʋ tɩɛna na, Juo Agiripa na Benisi desina ba wʋsɛ sɛ ba mʋ jilima na asadi jʋʋ dijaŋitiŋ gaa, sɛ yuora bɩnɩɛ na dɩɛ janɛ gaa asanaŋtina baa kpaŋ ɩ. Sɛ Fesito dʋ sɛ ba n ga mʋ Pɔɔlʋ kɔŋ. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Sɛ Fesito tawɩ sɛ, &lt;&lt;Juo Agiripa na amɩɛ baa ɩ wɩɛ daa jaŋ jɩna na kpiniŋ. Baalɛ wina wʋŋ ɩɩ na ɩ na, Yudatina baa ba wɩɛ Yerusalem na Kayisariya na kpiniŋ sʋlʋ maŋ lɩɩ wʋ dʋɔ. Sɛ ba kuusi sɛ wʋ n ti daga wʋ a cha nkpa naŋ ŋ. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Ma na gʋ wʋ n yɩɛ bʋrʋ gaa ga daga sɩŋ ŋ, ama gʋ wʋ sʋlʋ sɛ Juo janɛ Kayisa n di wʋ wɩɛ na dʋɔ, ma yɩɛ ma nfɩɛrɛ takɩɛ maa mʋ ɩ ju Roma. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Ama ma tana wɩɛ bi gaa maa sabɩɛ ga fa wʋ Kpaŋjuo Kayisa lɩɩ wʋ dʋɔ ɔ. Dɩmʋŋ dʋɔ ma mʋ ɩ kɔŋ amɩɛ kpiniŋ amɩɛ asanaŋ, fɔŋfɔŋ nyaŋ Juo Agiripa, takɩɛ ganaŋkʋ dɩ kɩɛ wɩɛ ŋii tɩba na dieli na, maa dɩlɛ yu wɩɛ ŋarɛ na maa sabɩɛ lɩɩna ŋii ŋii lɩɩ ŋɩ tɩba kɔŋ. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Maa tamaa sɛ ŋɩ taŋ dieli takɩɛ ma n mʋ danɛtʋɔrɛ ju yela ma aa dɩlɛ kalaa wɩɛ ŋii ba chamɩna baa pʋɩ ɩ na tɩba a.&gt;&gt;<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s1">Pɔɔlʋ tawɩ gara wʋ wʋsɛ Agiripa asanaŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Sɛ Juo Agiripa tawɩ Pɔɔlʋ sɛ, &lt;&lt;Nya wɩɛ gbɩɛ na nyaa tawɩ n wɩɛ.&gt;&gt;</para>
  <para style="p" vid="ACT 26:1">Sɛ Pɔɔlʋ ŋɩrɛ ba pam sɛ wʋ fara wʋ a tawɩ wʋ a gara wʋ wʋsɛ sɛ, <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />&lt;&lt;Juo Agiripa, ma yu asadi takɩɛ gʋ ma sɩmɩɛɩ nya asanaŋ jaŋ maa tawɩ ma wɩɛ maa gara ma wʋsɛ lɩɩna pʋɩ ŋii Yudatina mʋ baŋ maŋ na kpiniŋ. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Fɔŋfɔŋ nya jiŋ Yudatina ayɩɛsa na ba noro wɩɛ kpiniŋ na dieli. Dɩmʋŋ dʋɔ maa sʋlʋ nyaŋ takɩɛ nya n yu digela, na nyaa nyii ma jaŋ.&gt;&gt;<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Yudatina kpiniŋ jiŋ ganaŋkʋ ma cha ma chawʋ naŋ lɩɩ ma gɩchasɩtɩɛ, na ganaŋkʋ ma cha ma tɩŋtɩŋ ma dɩɛ naŋ na Yerusalem. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Ba jiŋ maŋ taŋgɩlɛ, sɛ baa jawʋ na, baa dɩlɛ di seriya takɩɛ ma kpi dikpeŋ gaa gaa kpaŋ daa dɩtʋm dʋɔ na dieli sɛ ma chaɩ takɩɛ Farasi wʋkpa. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Dɩtɩɛna lɩɩna ma tamaa gaa ma wɩɛna bʋrʋ gaa Ɩsʋɔ tawɩ si fa daa duluŋ na dʋɔ, sɛ ma sɩmɩɛɩ ɩɩ di ma wɩɛ jaŋ n na. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Dɩmʋŋ Ɩsʋɔ tawɩ si ŋina sɛ Isirali buonɔsɛ gifi ala wɩɛna tamaa na baa na gʋ ŋii kɔŋ tɩba, dɩmʋŋ dʋɔ sɛ ba chɩdɩsɛ baa tʋŋ Ɩsʋɔ wiita na yuluma. O Juo, lɩɩna dɩmʋŋ tamaa gana dʋɔ sɛ Yudatina baa a pʋɩ maŋ. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Be n yɩɛ sɛ ɩɩ lɩɛ ɩ di takɩɛ Ɩsʋɔ a feŋsi atatina?&gt;&gt;<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />Sɛ Pɔɔlʋ ti tawɩ sɛ, &lt;&lt;Maŋ gba ma lɩɛ di takɩɛ dɩ daga maa yɩɛ bʋrʋkʋma gaa maa dɩlɛ yɩɛ mʋ chicha Yesu Nasarati wʋkpa wʋŋ yɩrɛ gaa. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Sɛ dɩmʋŋ gba sɛ ma yɩɛ Yerusalem. Ma yu yikuo lɩɩ Ɩsʋɔ sei bɩnɩɛ baa jaŋ takɩɛ ma n chaŋ Ɩsʋɔ bakpa dɩchɩrɩchɩrɩ kpiniŋ ga tɔ danɛ, sɛ ma kpa takɩɛ ba n kʋ ba. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Maa dɩlɛ maa ju Yudatina tʋm danɛ garɛ naŋ mʋ ju garɛ naŋ maa chaŋ ba maa fɔŋɩ ba dɩla, sɛ maa ŋɩrɛ ba sɛ baa tawɩ mbusu wɩɛ. Gʋ maa kara biŋbira ba dʋɔ na dieli na dʋɔ, maa kpaŋ ba maa ju mʋɔra dɩɛsɛ dʋɔ maa nyala ba.&gt;&gt;<verse eid="ACT 26:11" /></para>
  <para style="s1">Pɔɔlʋ tawɩ ganaŋkʋ wʋ lɩɛ Yesu di</para>
  <para style="r">
    <ref loc="ACT 9:1-19">Dɩtʋm 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ gbɩɛsɛ ju ŋina garɛ tɩba gaa ma lɩɛ tanɛ lɩɩ Ɩsʋɔ sei bɩnɩɛ baa jaŋ gaa ga fa maŋ yikuo na gbɩɛ sɛ ma n ju Damasiko. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />O Juo, aja yɩɛ wiita keŋkeŋ gʋ ma dɔŋ na gbɩɛ na, ma na ŋmaŋi garɛ lɩɩ Ɩsʋɔ adugbe, gaa ŋalagi kii wiita sɛ ga kɔŋ gaa ŋalagi logo maŋ na ma dɔŋa. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Daa kpiniŋ dɩ lɩɩ sala sɛ ma nyii gʋ lofu garɛ a tasɛ maŋ Aramiki<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">Ɩsʋɔ Sabɩɛwɩɛ ŋarɛ wɩɛna Hibiri dɩtawɩ.</char></note> dɩtawɩ naŋ sɛ Sɔɔlʋ, Sɔɔlʋ, be n yɩɛ sɛ nyaa nyala maŋ? N jiŋ sɛ nyaa nyala maŋ bɛ, nyaa nyala n tɩŋtɩŋ n wʋsɛ bɛ.&gt;&gt;<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />&lt;&lt;Dɩmaŋ sɛ ma tasɛ sɛ Kpaŋjuo, nyaŋ n nyina Mmʋɔ? Sɛ Kpaŋjuo lɩsɛ nʋɔ sɛ Maŋ n nyina Yesu wʋŋ nyaa nyala na.&gt;&gt;<verse eid="ACT 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 26:16" />&lt;&lt;Dɩtɩɛna kʋlʋ sɩŋ n nafara dʋɔ, ma lɩsɛ ma wʋsɛ kalaa nyaŋ na maa lɩɛ nyaŋ takɩɛ tʋmɩrɛ, na nyaa di ŋii nya na lɩɩ ma dʋɔ na ŋii maa kalaa nyaŋ na dʋɔ seriya. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Maa lɩɛ nyaŋ lɩɩ n tɩŋtɩŋ nya bakpa na baa ba ba yɩɛ Yudatina pamɩɛ naŋ. Maa kpiri nyaŋ ba jaŋ <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />na nyaa ga fulu ba asa, na nyaa lɩsɛ ba lɩɩ giteŋteŋbiri naŋ kɔŋ ŋmaŋi naŋ. Na nyaa lɩsɛ ba lɩɩ Sɩtanɩ doŋ naŋ kɔŋ Ɩsʋɔ jaŋ, ganaŋkʋ lɩɩna lɩɛdi gaa ba wɩɛna ma tɩba na dʋɔ baa yu dɩsʋbʋ mʋ chɩɛ na dɩchatɩŋ baa ba yɩɛ dɩchɩrɩchɩrɩ na tɩba.&gt;&gt;<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />Sɛ Pɔɔlʋ ti tawɩ sɛ, &lt;&lt;Dɩmʋŋ dʋɔ, Juo Agiripa, ma n yɩɛ dɩlɛ naŋ doŋ fa Ɩsʋɔ lɩsɛ kalaa gaa ga lɩɩ Ɩsʋɔ adugbe na a. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Ma chɩŋkpɩɛ tawɩ wɩɛ ŋii fa baa ba wɩɛ Damasiko, Yerusalem na baa ba wɩɛ Yudiya na kpiniŋ, na baa ba ba yɩɛ Yudatina na gba. Ma tawɩ ba sɛ ba n biliŋi lɩɩ ba dɩsʋbʋ naŋ kɔŋ Ɩsʋɔ jaŋ, na ba ayɩɛsa a kalaa takɩɛ ba biliŋi lɩɩ ba dɩsʋbʋ naŋ. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ŋina dʋɔ sɛ Yudatina baa chaŋ maŋ Ɩsʋɔ tʋm danɛ naŋ baa ja baa kʋ maŋ. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Ama Ɩsʋɔ n chɔna maŋ gaa tala jaŋ gɩyɩɛ gana, ŋina dʋɔ sɛ ma sɩmɩɛɩ jɩna maa di seriya maa fa ba kpari na baa ba ba yɩɛ ba kpari. Ŋii maa tawɩ na ŋii Ɩsʋɔ bajana na Mosesi tawɩ sɛ ŋii kɔŋ na yɩɛ bʋdʋŋdʋlʋŋ bɛ. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />Ŋii n nyina sɛ Kirisito wʋŋ aja na awʋrʋfʋɔ, na wʋ a yɩɛ feŋ lɩɩ sɩŋ naŋ asanaŋtɛ. Na wʋ a jɔ ŋmaŋi gaa dawuta fa wʋ tɩŋtɩŋ wʋ bakpa na baa ba ba yɩɛ Yudatina na kpiniŋ.&gt;&gt;<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Gʋ Pɔɔlʋ ju dʋɔ wʋ a tawɩ wʋ a gara wʋ wʋsɛ na, sɛ Fesito kara wʋ nʋɔ dʋɔ kuusi tawɩ sɛ, &lt;&lt;Pɔɔlʋ, n nyi warɩɛwʋ. N tanɛ jim fɔɩ yela sɛ nya kili jɩtɩrɛ.&gt;&gt;<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Sɛ Pɔɔlʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Fesito wʋkpari, ma aa kili jɩtɩrɛ ɛ. Maa tawɩ gasiŋteŋ na kpiŋjim wɩɛ bɛ. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Juo n jiŋ wɩɛ ŋina dʋɔ, maa dɩlɛ yu digela tawɩ fa ɩ. Sɛ ma lɩɛ wɩɛ ŋii wʋ tawɩ na di ŋii ma tawɩ na ŋarɛ n wɩsɛ nyaŋ ŋ, akala takɩɛ ba n yɩɛ ŋɩ ŋarɛ asɩrɩ naŋ ŋ. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Juo Agiripa, n lɩɛ Ɩsʋɔ bajana baa di? Ma jiŋ gʋ n lɩɛ di.&gt;&gt;<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Dɩmaŋ sɛ Juo Agiripa tasɛ Pɔɔlʋ sɛ, &lt;&lt;Nyaa fa nfɩɛrɛ sɛ nyaa dɩlɛ mʋ saŋa ga guŋ gana tawɩ na maa lɩɛ wɩɛ ŋii nyaa tawɩ maŋ di na maa yɩɛ Kirisito wʋkpa bɛ yaa?&gt;&gt;<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Sɛ Pɔɔlʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Saŋa ga guŋ naŋ bɛ o, aja taŋgɩlɛ bɛ o, maa jɔ dɩga maa fa Ɩsʋɔ sɛ naa n nyiŋeŋ ŋ, ama baa baa nyii ma wɩɛ jaŋ na kpiniŋ a kɩɛna takɩɛ maŋ, amʋɔ baa n baa mʋ agbaraŋgbaraŋ ŋina pɔgʋ ba.&gt;&gt;<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Sɛ Juo wʋŋ na Roma bɩnɛ wʋŋ wʋ a kɩɛ Isirali tibi dʋɔ na Benisi, na baa ba chaɩ dɩmaŋ na kpiniŋ kʋlʋ. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Ba lɩɩ danɛ gaa naŋ yela baa tawɩ dɔŋa jaŋ sɛ, &lt;&lt;Baalɛ wina ba aa yɩɛ bʋrʋ gaa ga daga gʋ ba n kʋ ɩ, yaa ba n tɔ ɩ danɛ ɛ.&gt;&gt;<verse eid="ACT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32" />Sɛ Agiripa tawɩ Fesito sɛ, &lt;&lt;Sɛ baalɛ wina n sʋlʋ sɛ Juo Kayisa n di wʋ wɩɛ na, nafʋɔ dɩɩ yela ɩ.&gt;&gt;<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s1">Pɔɔlʋ mʋna lɩŋ dʋɔ ju Roma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Gʋ ba fa nfɩɛrɛ sɛ dɩ n cha lɩŋ dʋɔ ju Italiya na, ba mʋ Pɔɔlʋ na danɛtʋɔra barɛ dʋ yuora gafie bɩnɛ wʋŋ baa yagɛ ɩ sɛ Juliyosi, wʋŋ wʋ kpi Juo janɛ yuora dikpeŋ gaa dʋɔ na pam naŋ. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Sɛ dɩ jʋʋ pantuu janɛ gaa ga lɩɩ Adaramutino gaa ja gaa ju Asiya tibi dʋɔ ɔpʋ nʋɔ pantuu janɛ adaŋtɩŋ na sɛ dɩ lam. Sɛ Masidoniya wʋkpa Arisitakosi wʋŋ wʋ lɩɩ Tesalonika na kpi daa dʋɔ.<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />Gʋ tɩɛna na, sɛ dɩ tala Sidoŋ, sɛ Juliyosi lɩɩ wʋ dɩbam naŋ fa Pɔɔlʋ gbɩɛ sɛ wʋ n ju wʋ dɩɛtina jaŋ na baa fa ɩ ŋii ŋɩ tiri ɩ. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Gʋ dɩ lɩɩ dɩmaŋ na, dɩ ti mʋna ɔpʋ dʋɔ pala Kipurosi dɩlɩɩtɩŋ lɩɩna feliŋ ŋii ŋii jɔ ŋii jaŋina daa na dʋɔ. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Gʋ dɩ mʋna ɔpʋ gaa tɩtɩba Kilikiya na Pamfiliya salɛ ga tala Mira dɩɛ gaa ga wɩɛ Lisiya tibi dʋɔ na. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Dɩmaŋ sɛ yuora bɩnɛ wʋŋ na pantuu janɛ garɛ gaa ga lɩɩ Alesandiriya dɩɛ naŋ gaa ju Italiya sɛ wʋ mʋ daa ga dʋ ga tɩba. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />Dɩ pala laakarɛ dʋɔ gɩyɩɛnɩŋ fɔɩ, dɩ yɩɛ wiliŋ fa daa pɔɩ sɛ dɩ tala Kinido dɩɛ naŋ. Gʋ feliŋ ŋii n fa daa gbɩɛ na dɩɩ ju diele gaa dɩɩ jawʋ na dʋɔ, dɩ mʋna ɔpʋ dʋɔ ju Kireti dɩlɩɩtɩŋ, Salimoni dɩɛ sinabie. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Gʋ dɩ dɔŋ ɔpʋ gaa nʋɔ na, dɩ yɩɛ wiliŋ fa daa pɔɩ sɛ dɩ gaa tala diele gaa baa yagɛ sɛ pantuu ajanɩɛ Dɩdaŋtɩŋ Gabam tirina Lasiya dɩɛ.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Dɩ taŋgɩlɛ gbɩɛ dʋɔ, sɛ lɩŋ ŋii dʋɔ palɩŋ yɩɛ nyɩŋtɩɛ, akala takɩɛ nʋɔ pɔgʋ<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">Ŋina yɩɛ Wɩɩ gaa Yudatina a di asadi adiya baa nyiŋi ganaŋkʋ ba yu dɩsʋbʋ mʋ chɩɛ na. Dɩmʋŋ Wɩɩ gana baa jɔ dɩga, sɛ baa pɔgʋ nʋɔ yela baa tʋŋ Ɩsʋɔ.</char></note> saŋa lam. Dɩmʋŋ dʋɔ Pɔɔlʋ jɔ ba nyienaŋ tawɩ ba sɛ, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />&lt;&lt;Baala, ma na gʋ daa gbɩɛ gaa aja kɔna jerebi na pantuu janɛ gaa na gasʋlasɛ ŋii a warɩɛ. Sɛ daa gba dɩɩ sɩŋ.&gt;&gt; <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Ama yuora bɩnɛ wʋŋ n nyii Pɔɔlʋ wɩɛ ŋii i, sɛ wʋ kpaŋ ŋii pantuu kamɩrɛ na pantuu-tɛ wʋŋ tawɩ fa ɩ na dʋɔ. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Akala takɩɛ pantuu dɩdaŋtɩŋ gana taŋ dieli fa daŋ gbaŋgbaŋ saŋa a. Sɛ ba galaga lɩɛ dʋ takɩɛ ba n ju dʋɔ, akala takɩɛ ba wɩɛna tamaa gʋ baa tala Fonisi na baa cha dɩmaŋ gbaŋgbaŋ saŋa. Dɩmʋŋ pantuu dɩdaŋtɩŋ gana wɩɛ Kireti bɛ, sɛ ga asa a kalaa tie dɩsalɩtɩŋ na adugbe dɩsalɩtɩŋ.<verse eid="ACT 27:12" /></para>
  <para style="s1">Feliŋ janɛ jɔ ɔpʋ dʋɔ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Gʋ feliŋ ŋii ŋɩ nʋɔ taŋ doŋ fara jɔ lɩɩ tie na, ba jiŋ sɛ ba yu ŋii baa jawʋ na bɛ, dɩmʋŋ dʋɔ ba lɩsɛ nyɩŋgɩrɛ yuŋtɛ gaa gaa chaŋ pantuu janɛ gaa sɩŋ, sɛ dɩ mʋna Kireti ɔpʋ gaa nʋɔ. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Ama ŋɩ n taŋgɩlɛ sɛ feliŋ adoŋtina ŋarɛ ŋii baa yagɛ sɛ &lt;&lt;Dɩlɩɩtɩŋ feliŋ,&gt;&gt; jɔ lɩɩ dɩchafɩya gaa dʋɔ. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Gʋ pantuu janɛ gaa jaŋina feliŋ janɛ ŋii na, ga aa ti dɩlɛ gaa ju ga asanaŋ ŋ. Dɩmʋŋ dʋɔ dɩ yela ga fa feliŋ ŋii yela ŋii jɔ daa ŋɩ dɔŋ. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Sɛ dɩ mʋna dɩchafɩya pii garɛ baa yagɛ ga sɛ Kawuda dɩlɩɩtɩŋ, dɩ yɩɛ wiliŋ fa daa pɔɩ sɛ dɩ dɩlɛ pɔgʋ buori pii gaa. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Gʋ baala baa mʋ buori pii gaa dʋ pantuu janɛ gaa naŋ sɛ ba mʋ ganyasɛ pɔgʋ ga mata ga na. Sɛ nyɩŋtɩɛ chaŋ ba takɩɛ pantuu janɛ gaa aja gaa daŋ Ewuritisi tɩɛra diele gaa taŋ dɩkɩŋ na, dɩmʋŋ dʋɔ ba lɩsɛ nyɩŋgɩrɛ yuŋtɛ gaa gaa chaŋ pantuu janɛ gaa sɩŋ na, sɛ dɩ yela sɛ feliŋ ŋii a jɔ pantuu janɛ gaa ga dɔŋ. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Gʋ tɩɛna sɛ feliŋ janɛ ŋii ŋɩ nʋɔ wɩɛ doŋ a jɔ daa na, ba fara baa lɩsɛ gasʋlasɛ baa lɩɩ pantuu janɛ gaa naŋ baa lɔ lɩŋ naŋ. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Wɩɛ atorotɛ na, ba mʋ ba tɩŋtɩŋ ba pamɩɛ baa lɩsɛ pantuu janɛ gaa naŋ abʋrɩ baa lɔ lɩŋ ŋii naŋ. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Gʋ wiita yaa achikpebi n lɩɩ gɩyɩɛnɩŋ fɔɩ yela feliŋ janɛ ŋii saŋ ŋii jʋɔ na, dɩ ti tana tamaa takɩɛ dɩɩ yu mɔlɔgɩ ɩ.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Gʋ baala baa cha gɩyɩɛnɩŋ fɔɩ yela ba n di adiya wʋrʋgbɩɛ na, Pɔɔlʋ kʋlʋ sɩŋ ba asanaŋ tawɩ sɛ, &lt;&lt;Baala, nafʋɔ ɩ nyii ma wɩɛ ŋii ma tawɩ fa amɩɛ takɩɛ dɩ n baa lɩɩ Kireti na, nafʋɔ dɩmʋŋ jerebi ŋina n mɩɛna daa a. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Ama dɩtɩɛna maa sʋlʋ amɩɛ sɛ n yu digela, akala takɩɛ amɩɛ tɩba wʋrʋ ba aa sɩŋ ŋ, pantuu janɛ gaa nyiŋeŋ aaŋ ja gaa warɩɛ. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Daŋda yuluma, Ɩsʋɔ wʋŋ ma yɩɛ wʋ teri, sɛ maa tʋŋ ɩ na gabʋɔ, gaa sɩŋ ma jaŋ <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />tawɩ sɛ, &lt;Pɔɔlʋ, n baa se nyɩŋtɩɛ. Ŋɩ tiri gʋ nyaa sɩŋ Juo Kayisa asanaŋ na wʋ a di n wɩɛ, gʋ Ɩsʋɔ wɩɩ n dʋɔ na dʋɔ, wʋ mʋ baa ba kpi n dʋɔ lɩŋ ŋii dʋɔ na kpiniŋ nkpa fa ba.&gt; <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Dɩmʋŋ dʋɔ baala, n yu digela akala takɩɛ ma wɩɛna lɩɛdi Ɩsʋɔ naŋ takɩɛ ŋii tibi ganaŋkʋ wʋ tawɩ maŋ na. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Ama ŋɩ tiri gʋ pantuu janɛ gaa a daŋ dɩchafɩya garɛ dʋɔ.&gt;&gt;<verse eid="ACT 27:26" /></para>
  <para style="s1">Ɔpʋ dʋɔ awʋrʋfʋɔ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Gɩyɩɛnɩŋ gifi anara wɩɩ yuluma na, feliŋ janɛ ŋii saŋ ŋii jɔ daa ŋii logo Adiratiki Ɔpʋ dʋɔ. Go aja yɩɛ takɩɛ tɩɛtɩtɩba na, sɛ pantuu janɛ gaa dɩtʋm yɩɛra baa na gʋ ba tirina dedambi. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Sɛ ba mʋ ganya pɔgʋ nyɩŋgɩrɛ lɔ dʋ lɩŋ ŋii naŋ na baa kɩɛ ŋɩ dɩkɩŋ, sɛ ba na gʋ dɩmaŋ dɩkɩŋ yɩɛ nafara gafie na nkuo. Gʋ ba ju asanaŋ chonii na, ba ti lɔ ganya gaa dʋ lɩŋ ŋii naŋ sɛ ba na gʋ dɩmaŋ dɩkɩŋ yɩɛ nafara ŋɩnara salaa. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Sɛ dɩ yɩɛ daa nyɩŋtɩɛ takɩɛ dɩɩ ga sʋɔ akpa bʋɛ, sɛ ba lɩsɛ nyɩŋgɩrɩɛ ayuntina ŋii ŋii chaŋ pantuu janɛ gaa sɩŋ na anara lɔ dʋ lɩŋ naŋ pantuu janɛ gaa wʋrʋgbɩɛ, sɛ ba jɔ dɩga sɛ tɩɛ n na bileŋ. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Gʋ pantuu janɛ gaa dɩtʋm yɩɛra baa ja sɛ ba n se lɩɩ ga tɩba na dʋɔ, ba buoli buori pii gaa jaga ɔpʋ gaa dʋɔ, sɛ ba yɩɛ takɩɛ baa ga lɩsɛ nyɩŋgɩrɩɛ ayuntina ŋii ŋii chaŋ pantuu janɛ gaa sɩŋ na dʋ lɩŋ naŋ pantuu janɛ gaa asanaŋ. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Dɩmaŋ sɛ Pɔɔlʋ tawɩ yuora bɩnɛ wʋŋ na yuora baa sɛ, &lt;&lt;Baala bana n cha pantuu janɛ gana naŋ na, ɩ ɩɩ dɩlɛ yu mɔlɔgɩ ɩ.&gt;&gt; <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Dɩmʋŋ dʋɔ yuora baa karɩɛ ganyasɛ ŋii ŋɩ chamɩna buori pii gaa tɩba na, sɛ ba yela ga sɛ ga lam.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Pɔɩ na a tala tafɩlɛ na, sɛ Pɔɔlʋ sʋlʋ ba kpiniŋ sɛ ba n di adiya. Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Gɩyɩɛnɩŋ gifi anara mɩnaŋ gʋ ɩɩ dana ɩɩ kɩɛ, sɛ ɩŋ di adiya a. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Dɩtɩɛna maa sʋlʋ amɩɛ sɛ n di adiya na ɩ cha nkpa naŋ. Amɩɛ tɩba wʋrʋ nyɩnyʋɔ garɛ gba ba aa kuli tʋsʋ ʋ.&gt;&gt; <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Gʋ Pɔɔlʋ tawɩ ŋina taŋ na, wʋ mʋ bodobodo garɛ sɛ wʋ yɩlɩ Ɩsʋɔ ba kpiniŋ ba asanaŋ. Sɛ wʋ jaɩ ga tɩba sɛ wʋ fara wʋ a tawʋ. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Sɛ ba kpiniŋ yu tawɩ dʋ sɛ ba di adiya. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Daa baa dɩ wɩɛ pantuu janɛ gaa naŋ na, nʋɔ yɩɛ gafisi sɩla na ŋitoro sala na lʋrʋ (276). <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Gʋ ba di pa na, ba lɩsɛ gamɩsɛ ŋii ŋɩ wɩɛ pantuu janɛ gaa naŋ na lɔ dʋ ɔpʋ naŋ, na gaa kʋlʋ yuŋ.<verse eid="ACT 27:38" /></para>
  <para style="s1">Pantuu janɛ gaa warɩɛwʋ</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Gʋ tɩɛna na, pantuu janɛ gaa dɩtʋm yɩɛra baa n dɩlɛ jiŋ ɔpʋ nʋɔ gadʋŋdʋlʋŋ gaa a. Ama ba na dedambi diele gaa tɩɛra wɩɛ, dɩmaŋ sɛ ba yɩɛ ba nfɩɛrɛ takɩɛ nafʋɔ baa dɩlɛ na, ba n mʋ pantuu janɛ gaa ga daŋ. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Sɛ ba karɩɛ ganyasɛ ŋii ŋɩ chamɩna nyɩŋgɩrɩɛ ayuntina ŋii ŋii chaŋ pantuu janɛ gaa sɩŋ na sɛ ŋɩ sala ɔpʋ naŋ, dɩmʋŋ saŋa gana ba buoli ganyasɛ ŋii ŋɩ chamɩna daasɛ ŋii. Dɩmaŋ sɛ ba mʋ dukuru janɛ gaa adugbe fa feliŋ ŋii na ŋii jɔ pantuu janɛ gaa daŋ ɔpʋ gaa nʋɔ. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Ama pantuu janɛ gaa sʋɔ tɩɛra diele gaa taŋ dɩkɩŋ na sɛ ga daŋ. Sɛ ga asanaŋ jʋʋ tɩɛra naŋ sɛ ga aa ti dɩlɛ gaa ju asanaŋ ŋ. Sɛ feliŋ janɛ ŋii jɔ ga wʋrʋgbɩɛ sɛ ga salɩɛ aguŋda-aguŋda.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Sɛ yuora baa fa gbɩɛsɛ nfɩɛrɛ sɛ baa kʋ danɛtʋɔra baa, na ba n baa yu gbɩɛ sala lɩŋ na baa se. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Ama yuora bɩnɛ wʋŋ aja sɛ wʋ a mɔlɔgɩ Pɔɔlʋ nkpa, sɛ wʋ n yela na baa yɩɛ ba gbɩɛsɛ nfɩɛrɛ ɛ. Wʋ dʋ baa baa dɩlɛ sala lɩŋ na sɛ ba n chɩŋkpɩɛ puli sala tɩba, na baa sala ju dedambi dʋɔ. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Sɛ baa ba kakaa na mʋ ba wʋsɛ fu-fu dasɛ ajanɩɛ yaa pantuu janɛ gaa aguŋda ŋii dʋɔ ju dedambi dʋɔ. Dɩmʋŋ gbɩɛ gana dʋɔ sɛ wʋkʋma mʋna ga tala dedambi dʋɔ na alaŋfiya.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s1">Pɔɔlʋ wɩɛ Malita</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Gʋ dɩ tala dedambi dʋɔ na alaŋfiya na, sɛ dɩ jiŋ gʋ baa yagɛ dɩchafɩya gaa sɛ Malita. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Sɛ dɩchafɩya gaa dʋɔ bakpa lɩɛ daa sɛ ba lɩsɛ ba dɩbam yɩɛ fɔɩ kalaa daa. Gʋ duoni a nɩɛ sɛ warɛ wɩɛ na dʋɔ, ba dʋ bʋala fa daa sɛ dɩ n wʋlʋ. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Sɛ Pɔɔlʋ kʋla dasɛ sɩla, gʋ wʋ chamɩna wʋ a dʋ bʋala naŋ na, sɛ bʋala gaa awulawula yela sɛ dʋm lɩɩ dasɛ ŋii naŋ gaa pɔgʋ Pɔɔlʋ pam. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Gʋ dɩchafɩya gaa dʋɔ bakpa na gʋ dʋm wʋŋ chɔlɔgaɩ Pɔɔlʋ pam dʋɔ na, sɛ ba tawɩ dɔŋa sɛ, &lt;&lt;Baalɛ wina aja yɩɛ gatagapʋ wʋkpa bɛ, ŋɩ wɩɛ tɩba takɩɛ wʋ n sɩŋ ɔpʋ gaa naŋ ŋ, panɛ wʋŋ baa yagɛ ɩ sɛ Di Wɩɛ Ŋɩ Gbɩɛ Dʋɔ na, ba aa yela na wʋ a yu nkpa a.&gt;&gt; <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Ama Pɔɔlʋ ŋmati dʋm wʋŋ dʋ bʋala gaa naŋ yela bʋrʋ n yɩɛ ɩ ɩ. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Bakpa jiŋ sɛ wʋ a pʋ yaa wʋ a sala na wʋ a sɩŋ gabʋanaŋ bɛ. Ama gʋ ba daa taŋgɩlɛ sɛ ba na gʋ bʋrʋ n yɩɛ ɩ na, ba biliŋi ba nfɩɛrɛ sɛ ba tawɩ sɛ, wʋ yɩɛ panɛ bɛ.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Popilosi wʋŋ wʋ yɩɛ asanaŋtɛ wʋkpari dɩchafɩya gana dʋɔ na wɩɛna tibi garɛ tirina dɩmaŋ. Wʋ lɩɛ daa wʋ waa dʋɔ, kɩɛ daa sɛ wʋ yɩɛ dɩbam fa daa wɩɛ atoro. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Popilosi wʋ Juo cha wʋ duwei wʋ a kili gɩbɩrɩma yela wʋ a jʋɔwʋ. Sɛ Pɔɔlʋ jʋʋ ga kɩɛ ɩ sɛ wʋ mʋ wʋ pam jaga wʋ dʋɔ, sɛ wʋ jɔ dɩga fa ɩ sɛ wʋ yu lʋm chʋɔ. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Gʋ ŋina tibi na, sɛ lʋmɩɛtina baa ba kakaa ba wɩɛ dɩchafɩya gaa dʋɔ na kpiniŋ kɔnɛ, sɛ ba yu lʋm chʋɔ. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Sɛ ba bu daa gbɩɛsɛ fɔɩ dʋɔ, gʋ saŋa tala na dɩɩ ju na, ba fa daa abʋrɩ ŋii ŋɩ tiri daa.<verse eid="ACT 28:10" /></para>
  <para style="s1">Ba mʋ Pɔɔlʋ lɩɩ Malita ju Roma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Gafɩtasɛ atoro wʋrʋgbɩɛ na, dɩ ga jʋʋ pantuu janɛ gaa ga lɩɩ Alesandiriya sɛ ga dʋɔsɩŋ dɩchafɩya dʋɔ warɛ saŋa na. Ba sabɩɛ Ata aba panɩŋ Kasita na Poluki jaga ga dʋɔ. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Dɩ ga tala Surakawasa dɩɛ naŋ, sɛ dɩ cha dɩmaŋ wɩɛ atoro. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Dɩ lɩɩ dɩmaŋ pala lɩŋ dʋɔ ga tala Regiyoŋ dɩɛ naŋ. Tɩɛna na feliŋ jɔ lɩɩ tie, gʋ tɩɛ ti na na, sɛ dɩ ga tala Potiyolo dɩɛ naŋ. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Dɩmaŋ sɛ dɩ na lɩɛdɩra barɛ, sɛ ba lɔ pam yagɛ daa sɛ dɩ n cha ba jaŋ soji garɛ. N na sɛ dɩ pala ga tala Roma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Gʋ lɩɛdɩra baa ba wɩɛ dɩmaŋ nyii gʋ dɩɩ kɔnɛ na, sɛ ba barɛ ju gbɩɛ taŋasɛ gaa jaŋina daa dɩɛsɛ ŋii baa yagɛ ŋɛ sɛ Apiya Gɩyɩɛ naŋ, sɛ barɛ gaa jaŋina daa Mʋɔra Aduweitiŋ Atoro. Gʋ Pɔɔlʋ na ba na, wʋ yɩlɩ Ɩsʋɔ sɛ wʋ yu tawɩ dʋ. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />Gʋ dɩ tala Roma na, ba fa Pɔɔlʋ gbɩɛ sɛ wʋ n cha wʋ nyiŋeŋ, sɛ ba fa ɩ yuorɛ sɛ wʋ n gie ɩ.<verse eid="ACT 28:16" /></para>
  <para style="s1">Pɔɔlʋ tawɩ Ɩsʋɔ wɩɛ Roma</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Wɩɛ atoro wʋrʋgbɩɛ na, Pɔɔlʋ yagɛ Yudatina asanaŋtina baa gaa jaŋi. Gʋ ba jaŋi na, wʋ tawɩ ba sɛ, &lt;&lt;Ma dɔŋa Isiralitina, ŋɩ wɩɛ tɩba takɩɛ ma n yɩɛ bʋrʋ baŋ daa bakpa yaa daa duluŋ ayɩɛsa a, sɛ ba chaŋ maŋ Yerusalem dɩɛ naŋ mʋ maŋ dʋ Romatina pamɩɛ naŋ. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Ba kɩɛ ma wɩɛ naŋ na dieli na, ba ja baa yela maŋ, akala takɩɛ ma n yɩɛ dɩsʋbʋ gaa ga daga baa kʋ maŋ ŋ. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Ama gʋ Yudatina baa pɩɛ na, sɛ dɩ ŋɩrɛ maŋ takɩɛ ma n sʋlʋ Juo Kayisa na wʋ a di ma wɩɛ, naa sɛ ma wɩɛna pʋɩ ŋarɛ maa mʋ baŋ ma tɩŋtɩŋ ma bakpa a. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ŋina dʋɔ sɛ ma sʋlʋ sɛ maa na amɩɛ, na maŋ na amɩɛ dɩɩ tawɩ. Isiralitina tamaa dʋɔ sɛ ba mʋ agbaraŋgbaraŋ pɔgʋ maŋ.&gt;&gt;<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Dɩ n yu tanɛ garɛ lɩɩ Yudiya lɩɩna n dʋɔ ɔ, sɛ daa dɔŋa baa ba lɩɩ dɩmaŋ kɔŋ na, wʋrʋ n tawɩ wɩɛ asʋbʋɛ ŋarɛ lɩɩ n wʋsɛ dʋɔ ɔ. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Ama dɩɩ ja sɛ dɩɩ nyii nya nfɩɛrɛ bɛ, akala takɩɛ dɩ jiŋ gʋ bakpa baa ba wɩɛ gapɩlɛkʋma a tawɩ baa baŋ dɩmʋŋ dikpeŋ gana.&gt;&gt;<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Sɛ ba si gɩyɩɛ garɛ takɩɛ ba na Pɔɔlʋ ba n jaŋi, sɛ bakpa fɔɩ kɔŋ diele gaa wʋ chaɩ na. Wʋ kalaa ba wɩɛ ŋii tɩba sɛ wʋ di Ɩsʋɔ Juori gaa dʋɔ seriya fa ba lɩɩ nafo ga tala bʋyanɔ. Wʋ pala na Mosesi mbara na Ɩsʋɔ bajana baa sabɩɛ wɩɛ ŋii dʋɔ chɩdɩsɛ tawɩ ba na baa lɩɛ wɩɛ ŋii wʋ a tawɩ na di lɩɩna Yesu wʋsɛ dʋɔ wɩɛ. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Sɛ ba barɛ lɩɛ wɩɛ ŋii wʋ tawɩ na di, ama barɛ dʋɔ n lɩɛ di i. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Sɛ bakpa baa n nyii dɔŋa tie e, sɛ ba fara baa lɩɩ dɩmaŋ gʋ Pɔɔlʋ tawɩ wɩɛ taŋ na sɛ, &lt;&lt;Ɩsʋɔ Feliŋ pala na Ɩsʋɔ ɔja Yisaya dʋɔ tawɩ gasiŋteŋ fa amɩɛ duluŋ sɛ,<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />&lt;&lt;Ju bakpa bana jaŋ ga tawɩ ba sɛ,</para>
  <para style="q1" vid="ACT 28:26">Ɩɩ nyii, ama ɩɩ nyii tie e,</para>
  <para style="q2" vid="ACT 28:26">ɩɩ kɩɛ, ama ɩɩ na a.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Akala takɩɛ bakpa bana agela wɩɛ doŋ,</para>
  <para style="q2" vid="ACT 28:27">ba tɔ ba dɩla,</para>
  <para style="q2" vid="ACT 28:27">ba fu ba asa.</para>
  <para style="q1" vid="ACT 28:27">Naa dɩmʋŋ na, nafʋɔ ba asa aja na,</para>
  <para style="q2" vid="ACT 28:27">baa nyii,</para>
  <para style="q1" vid="ACT 28:27">ba agela a nyii wɩɛ tie,</para>
  <para style="q1" vid="ACT 28:27">na baa biliŋi lɩɩ ba dɩsʋbʋ naŋ kɔŋ ma jaŋ, na maa chɔ ba.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">28:27 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Yis 6:9-10</ref>. </char></note><verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />Sɛ Pɔɔlʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ dʋɔ maa ja na ɩ jiŋ takɩɛ Ɩsʋɔ nkpa mɔlɔgɩ ju baa ba ba yɩɛ Yudatina na jaŋ, na baa nyii.&gt;&gt; <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Gʋ Pɔɔlʋ tawɩ ŋina taŋ na, Yudatina baa lɩɩ dɩmaŋ yela ba nyiŋeŋ-nyiŋeŋ baa di noro ŋii ŋɩ nʋɔ wɩɛ doŋ.<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">Naa Ɩsʋɔ Sabɩɛwɩɛ ŋii kpiniŋ n wɩɛna dɩmʋŋ nkuo saŋgʋ gana a.</char></note><verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Pɔɔlʋ cha dɩmaŋ bɩŋsɛ sɩla kpiniŋ wʋ tɩŋtɩŋ wʋ waa gaa wʋ a tɔ ga dʋɔ kɩm na tɩba. Sɛ wʋ lɩɛ baa baa kɔŋ baa bʋɔ wʋ dʋɔ na kpiniŋ. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Wʋ yu digela tawɩ Ɩsʋɔ Juori gaa dʋɔ wɩɛ sɛ wʋ kalaa Kpaŋjuo Yesu Kirisito wʋsɛ dʋɔ wɩɛ yela wʋrʋ n dɩlɛ gara ɩ gbɩɛ ɛ.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>