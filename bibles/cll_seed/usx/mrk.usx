<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">-Chala</book>
  <para style="h">Maakɩ</para>
  <para style="toc1">Yesu Kirisito Wɩɛ Abama Ŋii Ganaŋkʋ Maakɩ Sabɩɛ</para>
  <para style="toc2">Maakɩ</para>
  <para style="toc3">Mk</para>
  <para style="mt2">Yesu Kirisito Wɩɛ Abama Ŋii Ganaŋkʋ</para>
  <para style="mt1">Maakɩ</para>
  <para style="mt2">Sabɩɛ</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">Yohane Ɩsʋɔ Sɔrɛ wʋŋ a tawɩ Ɩsʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 3:1-11">Matiyo 3:1-11</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Ŋina n nyina Yesu Kirisito, Ɩsʋɔ Bu<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Naa Sabɩɛwɩɛ kpiniŋ n wɩɛna Ɩsʋɔ Bu wʋŋ</char></note> wʋŋ wʋsɛ wɩɛ abama dɩ faratɩŋ.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Ɩsʋɔ ɔja Yisaya chɩŋkpɩɛ sabɩɛ Ɩsʋɔ wɩɛ si sɛ,</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Maa kpiri ma gabʋɔ pala nya asanaŋ</para>
  <para style="q2" vid="MRK 1:2">na wʋ a desina gbɩɛ si fa nyaŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref>.</char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Lofu garɛ a kuusi ifuli dʋɔ sɛ,</para>
  <para style="q1" vid="MRK 1:3">&lt;&lt;Desina gbɩɛ si fa Kpaŋjuo wʋŋ,</para>
  <para style="q2" vid="MRK 1:3">na ɩ chirigi gbɩɛ fa ɩ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Yis 40:3</ref>.</char></note><verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Dɩmʋŋ dʋɔ sɛ Yohane Ɩsʋɔ Sɔrɛ kɔŋ ifuli dʋɔ wʋ a gaa sɔ bakpa Ɩsʋɔ sɔ, sɛ wʋ jɔ Ɩsʋɔ wɩɛ dawuta sɛ, &lt;&lt;N biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ na ɩ kɔŋ Ɩsʋɔ jaŋ na maa sɔ amɩɛ Ɩsʋɔ sɔ, na wʋ a mʋ amɩɛ dɩsʋbʋ chɩɛ amɩɛ.&gt;&gt; <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Bakpa lɩɩ Yudiya tibi dʋɔ na Yerusalem dɩɛ naŋ kɔŋ wʋ jaŋ baa gaa nyii wʋ wɩɛ. Gʋ ba kɔnɛ na ba tawɩ ba dɩsʋbʋ sɛ wʋ sɔ ba Ɩsʋɔ sɔ Yodaŋ buo naŋ. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yohane gagba gaa wʋ cha wʋ fuona na, nyɔma fʋŋda sɛ ba mʋ lʋ ga, wʋ cha mʋ nam tanɛ tɩŋa naŋ ganya pɔgʋ wʋ tɩŋa naŋ. Wʋ adiya ŋii wʋ a di na yɩɛ aforo na tɩbʋɔ lɩŋ. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Wʋ tawɩ bakpa baa sɛ, &lt;&lt;Wʋŋ wʋ a kɔŋ ma wʋrʋgbɩɛ na yɩɛ wʋ janɛ kii maŋ, ma n daga na maa luuŋ buoli wʋ asibita ganyasɛ ɛ. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Maŋ bɩrɛ, maa mʋ lɩŋ sɔ amɩɛ Ɩsʋɔ sɔ, ama wʋŋ bɩrɛ Ɩsʋɔ Feliŋ sɛ wʋ a mʋ sɔ amɩɛ.&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s1">Yesu sɔ Ɩsʋɔ sɔ na wʋ lɔ tɩba</para>
  <para style="r">
    <ref loc="MAT 3:13-17">Matiyo 3:13-17</ref>; <ref loc="LUK 3:21-22">Luka 3:21-22</ref>; <ref loc="MAT 4:1-11">Matiyo 4:1-11</ref>; <ref loc="LUK 4:1-13">Luka 4:1-13</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Saŋa gaa Yohane a sɔ bakpa Ɩsʋɔ sɔ na, Yesu lɩɩ Nasarati gaa ga wɩɛ Galaliya tibi dʋɔ kɔŋ sɛ wʋ n sɔ ɩ Ɩsʋɔ sɔ Yodaŋ buo naŋ. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Gʋ Yesu a lɩɩ lɩŋ naŋ na, kɩɛ gabʋanaŋ, sɛ Ɩsʋɔ adugbe fulu sɛ wʋ na gʋ Ɩsʋɔ Feliŋ tibi a kɔŋ wʋ dʋɔ takɩɛ juori gakuo na <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />sɛ lofu lɩɩ Ɩsʋɔ adugbe kɔŋ sɛ, &lt;&lt;Nyaŋ n nyina Mabu wʋŋ maa ja n wɩɛ, ma asa su n dʋɔ.&gt;&gt;<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Gabʋanaŋ sɛ Ɩsʋɔ Feliŋ ŋii mʋ ɩ ju ifuli dʋɔ. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Dɩmaŋ sɛ wʋ cha wɩɛ ŋɩla (40) sɛ Sɩtanɩ gaa yɩɛ ɩ lɔ tɩba. Diele gaa wʋ wɩɛ na kasɛ naŋ namɩɛ wɩɛ dɩmaŋ sɛ Ɩsʋɔ gabʋɔsɛ kɔŋ gaa kɩɛ wʋ dʋɔ.<verse eid="MRK 1:13" /></para>
  <para style="s1">Yesu yagɛ aji chamara banara barɛ</para>
  <para style="r">
    <ref loc="MAT 4:18-22">Matiyo 4:18-22</ref>; <ref loc="LUK 5:2-11">Luka 5:2-11</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Yohane danɛ tʋɔ wʋrɩgbɩɛ na, Yesu ju Galaliya tibi dʋɔ ga tawɩ Ɩsʋɔ Wɩɛ Abama ŋii. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Wʋ tawɩ sɛ, &lt;&lt;Saŋa gaa kɔnɛ, Ɩsʋɔ juori gaa tirina. N biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ na ɩ lɩɛ Ɩsʋɔ Wɩɛ Abama ŋii di.&gt;&gt;<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Gʋ Yesu cha wʋ dɔŋ Galaliya lɩɩ nʋɔ na, wʋ na aji chamara bala, Simoŋ na wʋ nabu Andurusi baa alɔ disawu. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N kɔŋ gaa kpaŋ maŋ na maa kalaa amɩɛ na ɩ lɩsɛ bakpa fa Ɩsʋɔ.&gt;&gt; <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Gabʋanaŋ sɛ ba yela ba asawu si sɛ ba kpaŋ ɩ.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Gʋ Yesu ju asanaŋ chonii na wʋ ti na Sebedi bie bala, Jamesi na wʋ nabu Yohane wɩɛ buori naŋ baa desina ba asawu. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Gabʋanaŋ sɛ Yesu yagɛ ba, sɛ ba yela ba juo Sebedi na paa dira baa buori gaa naŋ sɛ ba kpaŋ Yesu.<verse eid="MRK 1:20" /></para>
  <para style="s1">Yesu geŋ feliŋ sʋbʋ lɩɩ baalɛ wʋrʋ tɩba</para>
  <para style="r">
    <ref loc="LUK 4:31-37">Luka 4:31-37</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesu na wʋ kpalɛnara kɔŋ Kapeniyum dɩɛ naŋ. Gʋ Fɩɛsɛ wɩɩ talɛ na, Yesu ju Yudatina tʋm danɛ naŋ ga kalaa Ɩsʋɔ wɩɛ. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Bakpa baa nyii wʋ kalaa ŋii na dɩ yɩɛ ba doba. Akala takɩɛ, wʋ kalaa-kalaa ba takɩɛ wʋkpa wʋŋ wʋ wɩɛna yikuo na, ama naa takɩɛ mbara bakalaasa a, <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Dɩmaŋ gana na, baalɛ wʋrʋ feliŋ sʋbʋ wɩɛ wʋ tɩba wʋ wɩɛ Yudatina tʋm danɛ gaa naŋ sɛ wʋ kuusi sɛ, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;Nyaŋ, Yesu Nasarati wʋkpa, be sɛ nyaa ja daa jaŋ? Nya kɔŋ na nyaa warɩɛ daa bɛ? Ma jiŋ wʋkpa wʋŋ nya yɩɛ na. Nya yɩɛ wʋŋ wʋ yɩɛ dɩchɩrɩchɩrɩ wʋŋ wʋ lɩɩ Ɩsʋɔ jaŋ na bɛ.&gt;&gt;<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesu fuba feliŋ sʋbʋ wʋŋ dʋɔ sɛ, &lt;&lt;Fu n nʋɔ dʋɔ na nyaa lɩɩ baalɛ wʋŋ tɩba.&gt;&gt; <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Feliŋ sʋbʋ wʋŋ jigisi baalɛ wʋŋ sɛ wʋ kuusi na doŋ sɛ wʋ lɩɩ wʋ tɩba.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Bakpa baa kpiniŋ na dɩmʋŋ na, ba wʋsɛ yɔgɔsɛ ba. Sɛ ba fara baa tasɛ dɔŋa sɛ, &lt;&lt;Kalaa afɔlɩɛ amʋɔ mɩnaŋ sɛ yikuo wɩɛ tɩba nna? Baalɛ wina a fuba feliŋ basʋbʋɛ dʋɔ sɛ baa nyii wʋ jaŋ.&gt;&gt; <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Dɩ lɩɩ takɩɛ Yesu wʋsɛ dʋɔ wɩɛ ŋii nyii Galaliya tibi dʋɔ gapɩlɛkʋma.<verse eid="MRK 1:28" /></para>
  <para style="s1">Yesu chɔ bakpa fɔɩ</para>
  <para style="r">
    <ref loc="MAT 8:14-17">Matiyo 8:14-17</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Gʋ Yesu na wʋ kpalɛnara baa lɩɩ Yudatina tʋm danɛ gaa naŋ na, ba ju Simoŋ na Andurusi waa dʋɔ na Jamesi na Yohane kpi ba dʋɔ. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Gʋ ba tala dɩmaŋ na, Simoŋ awu a kili gibirima wʋ duwei waa dʋɔ. Dɩmaŋ sɛ ba tawɩ Yesu. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Wʋ ju wʋ jaŋ sɛ wʋ chaŋ wʋ pam sɛ wʋ chɔna ɩ sɛ wʋ kʋlʋ. Dɩmaŋ gana sɛ gibirima gaa yela ɩ sɛ wʋ kʋlʋ fa ba adiya.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Bʋyanɔ gʋ wiita a ju wʋ a ga sala na, bakpa mʋ lʋmɩɛtina kpiniŋ na baa feliŋ sʋbʋ wɩɛ ba tɩba na kɔŋ Yesu jaŋ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Kapeniyumtina galaga gaa sila waa gaa asanaŋ. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yesu chɔ bakpa fɔɩ baa baa kili lʋmɩɛ ngoriŋ-ngoriŋ na. Sɛ wʋ ti geŋ feliŋ sʋbʋ lɩɩ bakpa tɩba. Ama wʋ n kpa na feliŋ sʋbʋ wʋŋ a tawɩ ɩ, dɩ lɩɩ takɩɛ ba jiŋ wʋkpa wʋŋ wʋ yɩɛ na.<verse eid="MRK 1:34" /></para>
  <para style="s1">Yesu tawɩ Ɩsʋɔ Wɩɛ Abama Galaliya tibi dʋɔ</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Tafɩlɛ garɛ, Yesu kʋlʋ lɩɩ waa dʋɔ ju diele gaa galaŋba taŋ na, na wʋ a ga jɔ dɩga. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Na Simoŋ na wʋ dɔŋa ju baa ja ɩ. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Gʋ ba na ɩ na, ba tawɩ ɩ sɛ, &lt;&lt;Wʋkʋma wina aja nyaŋ.&gt;&gt;<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;N yela dɩ ju dɩɛsɛ bisi ŋii ŋɩ tirina daa na naŋ na dɩ ga tawɩ Ɩsʋɔ Wɩɛ Abama fa baa gba, akala takɩɛ, dɩmʋŋ dʋɔ sɛ ma kɔnɛ.&gt;&gt; <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Dɩmʋŋ dʋɔ, wʋ ju Galaliya tibi dʋɔ gapɩlɛkʋma ga tawɩ Ɩsʋɔ Wɩɛ Abama Yudatina tʋm danɛ naŋ sɛ wʋ geŋ feliŋ sʋbʋ lɩɩ bakpa naŋ.<verse eid="MRK 1:39" /></para>
  <para style="s1">Yesu chɔ baalɛ chaalaŋa wʋrʋ</para>
  <para style="r">
    <ref loc="MAT 8:2-4">Matiyo 8:2-4</ref>; <ref loc="LUK 5:12-14">Luka 5:12-14</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Baalɛ wʋrʋ wʋŋ wʋ a kili gɩchalaŋa<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">Giriki wɩɛ bi fa gɩchalaŋa sɩmɩɛɩ fa lʋm yiri gaa gaa fu wʋkpa dʋɔ </char></note> kɔŋ Yesu jaŋ, wʋ luuŋ wʋ dʋna dʋɔ wʋ asanaŋ sʋlʋ ɩ sɛ, &lt;&lt;Nyaa jawʋ na, nyaa dɩlɛ chɔ maŋ.&gt;&gt;<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Sɛ lʋmtɛ wʋŋ wɩɛ yɩɛ Yesu gɩyɔŋ, sɛ wʋ tɩɛŋɩ wʋ pam jaga wʋ dʋɔ tawɩ sɛ, &lt;&lt;Maa jawʋ, n wʋsɛ n yɩɛ dɩchɩrɩchɩrɩ.&gt;&gt; <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Gabʋanaŋ sɛ gɩchalaŋa gaa lam sɛ wʋ yu lʋm chʋɔ.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Sɛ Yesu tawɩ ɩ sɛ wʋŋ pala sɛ wʋ jɔ wʋ nyinaŋ sɛ, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />&lt;&lt;Nyaŋ, kɩɛ na dieli na nya n baa tawɩ wʋrʋ. Ama mʋ n wʋsɛ ju ga kalaa Ɩsʋɔ sei, na nyaa diesi gadiesa ganaŋkʋ Mosesi mbara akala na, na ŋii di seriya takɩɛ nya yu lʋm chʋɔ.&gt;&gt; <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Ama baalɛ wʋŋ lɩɩ dɩmaŋ na, wʋ n fu wʋ nʋɔ dʋɔ ɔ sɛ wʋ tawɩ yalagi ŋii Yesu yɩɛ na kpiniŋ fa bakpa. Dɩmʋŋ dʋɔ, Yesu n ti dɩlɛ jʋʋ dɩɛ garɛ naŋ na bakpa a na ɩ ɩ. Dɩmʋŋ dʋɔ, wʋ ga cha diele galamba taŋ na. Ama bakpa saŋ baa lɩɩ akpie dʋɔ baa kɔŋ wʋ jaŋ.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">Yesu chɔ buobi wʋrʋ</para>
  <para style="r">
    <ref loc="MAT 9:2-8">Matiyo 9:2-8</ref>; <ref loc="LUK 5:18-26">Luka 5:18-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Wɩɛ akalisa ŋarɛ wʋrʋgbɩɛ na, Yesu bɔrɛ kɔŋ Kapeniyum dɩɛ naŋ sɛ ba nyii gʋ wʋ kɔŋ waa gaa wʋ a jʋʋ ga dʋɔ na naŋ. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Dɩmʋŋ dʋɔ, bakpa fɔɩ gaa jaŋi waa gaa dʋɔ sɛ waa gaa suu sɛ dɩjʋʋtɩŋ tɩtaŋ na bakpa a jʋʋ ʋ. Sɛ Yesu tawɩ Ɩsʋɔ wɩɛ fa ba. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Dɩmaŋ sɛ baala banara barɛ sɩlɛ buobi wʋrʋ kɔŋ dɩmaŋ. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Ama bakpa fɔɩ baa dʋɔ, ba n yu gbɩɛ mʋ buobi wʋŋ tala wʋ jaŋ ŋ. Dɩmʋŋ dʋɔ ba jiŋ danɛ adugbe, fʋrʋ bʋɔ diele gaa wʋ wɩɛ na. Sɛ ba tibina ɩ yela wʋ duwei kalaŋ dʋɔ si wʋ asanaŋ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Gʋ Yesu na ba lɩɛdi na, wʋ tawɩ buobi wʋŋ sɛ, &lt;&lt;Mabu, ma mʋ n dɩsʋbʋ chɩɛ nyaŋ.&gt;&gt;<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Gʋ Yesu tawɩ dɩmʋŋ wɩɛ ŋina na, mbara bakalaasa baa barɛ wɩɛ dɩmaŋ baa tawɩ ba nyienaŋ sɛ, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt;Be dʋɔ sɛ wʋkpa wina a tawɩ dɩmʋŋ? Wʋ a tawɩ mbusu wɩɛ. Mmʋɔ aaŋ dɩlɛ mʋ dɩsʋbʋ chɩɛ? Amʋɔ Ɩsʋɔ nyiŋeŋ.&gt;&gt;<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Gabʋanaŋ sɛ Yesu jiŋ ba nfɩɛrɛ, dɩmʋŋ dʋɔ wʋ tasɛ ba sɛ, &lt;&lt;Be dʋɔ sɛ ɩ fa nfɩɛrɛ ŋina? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Ŋɩ amʋɔ n duo na tibi naŋ, sɛ ma tawɩ fa buobi sɛ, ma mʋ n dɩsʋbʋ chɩɛ nyaŋ, yaa ma tawɩ sɛ, kʋlʋ na nyaa mʋ n kalaŋ na nyaa pala. <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Ama ganaŋkʋ aja yela na ɩ jiŋ gʋ Wʋkpa Bu wʋŋ wɩɛna yikuo tibi dʋɔ sɛ wʋ a dɩlɛ mʋ dɩsʋbʋ chɩɛ.&gt;&gt; Sɛ Yesu tawɩ buobi wʋŋ sɛ, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />&lt;&lt;Maa tawɩ nyaŋ sɛ, kʋlʋ mʋ n kalaŋ na nyaa ju dɩɛ.&gt;&gt; <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Gabʋanaŋ sɛ buobi wʋŋ kʋlʋ mʋ wʋ kalaŋ wʋ a ju yela ba kpiniŋ a kɩɛ ɩ. Sɛ dɩ yɩɛ wʋkʋma wina doba sɛ ba kalɩɛ Ɩsʋɔ tawɩ sɛ, &lt;&lt;Dɩ n naa ta ŋina duluŋ ŋ.&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s1">Yesu yagɛ Lewi</para>
  <para style="r">
    <ref loc="MAT 9:9-13">Matiyo 9:9-13</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Wɩɩ darɛ, Yesu bɔrɛ ju Galaliya buo nʋɔ, sɛ bakpa fɔɩ kɔŋ wʋ jaŋ sɛ wʋ kalaa-kalaa ba Ɩsʋɔ wɩɛ. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Gʋ wʋ dɔŋ buo nʋɔ wʋ a ju na, wʋ na Alifiyosi bu Lewi chaɩ lampo danɛ naŋ. Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Kpaŋ maŋ.&gt;&gt; Sɛ wʋ kʋlʋ kpaŋ ɩ.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Dɩ kɔŋ takɩɛ Yesu na wʋ kpalɛnara wɩɛ Lewi waa dʋɔ baa di, na lampo lɩɛra<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Bakpa a kɩɛ lampo lɩɛra sɛ ba yɩɛ dɩsʋbʋ yɩɛra</char></note> na dɩsʋbʋ yɩɛra fɔɩ kpi ba dʋɔ baa di. Dɩmʋŋ bakpa bana fɔɩ n cha ba kpamɩna Yesu. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Gʋ Mosesi mbara bakalaasa baa ba barɛ yɩɛ Farasitina na Yesu na dɩsʋbʋ yɩɛra na lampo lɩɛra a di na, ba tasɛ wʋ kpalɛnara baa sɛ, &lt;&lt;Be n yɩɛ sɛ Yesu na lampo lɩɛra na dɩsʋbʋ yɩɛra a di?&gt;&gt;<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Gʋ Yesu nyii ŋina na wʋ lɩsɛ ba nʋɔ sɛ, &lt;&lt;Alaŋfiyatina n tiri lʋm chʋɔrɛ ɛ, amʋɔ lʋmɩɛtina. Ma n kɔŋ maa gaa yagɛ bachirigisa a, ama dɩsʋbʋ yɩɛra.&gt;&gt;<verse eid="MRK 2:17" /></para>
  <para style="s1">Nʋɔ pɔgʋ dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MAT 9:14-17">Matiyo 9:14-17</ref>; <ref loc="LUK 5:33-38">Luka 5:33-38</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Gʋ Yohane Ɩsʋɔ Sɔrɛ kpalɛnara na Farasitina a chaŋ nʋɔ pɔgʋ na, bakpa barɛ kɔŋ gaa tasɛ Yesu sɛ, &lt;&lt;Be dʋɔ sɛ Yohane kpalɛnara na Farasitina kpalɛnara a chaŋ nʋɔ pɔgʋ, sɛ n kpalɛnara bɩrɛ baa chaŋ nʋɔ pɔgʋ?&gt;&gt;<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;alʋfɔlɛ baalɛ wʋŋ mʋɔrɛ a chaŋ nʋɔ pɔgʋ yela wʋ wɩɛ ba jaŋ? Aye, gʋ wʋ wɩɛ ba jaŋ n na bɩrɛ, baa chaŋ nʋɔ pɔgʋ ʋ. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ama saŋa gʋrʋ aja kɔŋ baa mʋ alʋfɔlɛ baalɛ wʋŋ lɩɩ ba jaŋ, saŋa gana sɛ baa chaŋ nʋɔ pɔgʋ.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />&lt;&lt;Wʋrʋ baa mʋ dukuru fɔlɛ wʋ a tarɛ gabɩnɛ naŋ ŋ. Sɛ wʋ yɩɛ dɩmʋŋ na, gafɔlɛ gaa aja kparagi gabɩnɛ gaa na bʋɔ gaa a yɩɛ gajanɛ. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Dɩmʋŋ sɛ wʋrʋ baa chɩɛgɩ wayɩŋ sʋlʋŋ fɔlɛ wʋ a dʋ kpalɛ gabɩnɛ naŋ ŋ. Sɛ wʋ yɩɛ dɩmʋŋ na, sʋlʋŋ ŋii aja sagɛ kpalɛ gaa na gaa warɩɛ na sʋlʋŋ ŋii a chɩɛgɩ tʋsʋ. Dɩmʋŋ dʋɔ ŋɩ tiri gʋ ba n chɩɛgɩ wayɩŋ sʋlʋŋ fɔlɛ dʋ kpalɛ gafɔlɛ naŋ.&gt;&gt;<verse eid="MRK 2:22" /></para>
  <para style="s1">Fɩɛsɛ wɩɩ dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MAT 12:1-14">Matiyo 12:1-14</ref>; <ref loc="LUK 6:1-11">Luka 6:1-11</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Fɩɛsɛ wɩɩ garɛ, Yesu na wʋ kpalɛnara baa dɔŋ kiliŋgbe fʋɔ garɛ naŋ. Sɛ wʋ kpalɛnara baa fara baa jaɩ kiliŋgbe ŋii ŋarɛ baa tawʋ. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Sɛ Farasitina baa barɛ tasɛ Yesu sɛ, &lt;&lt;Kɩɛ, be dʋɔ sɛ n kpalɛnara baa a yɩɛ ŋii daa mbara n fa gbɩɛ sɛ dɩ n yɩɛ Fɩɛsɛ wɩɩ?&gt;&gt;<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Ɩŋ karaŋ Ɩsʋɔ wɩɛ ŋii naŋ ŋii Dawidi yɩɛ saŋa gaa dusoŋ a kʋ wʋ na wʋ dɔŋa sɛ baa ja adiya baa di naa? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Dawidi ju Ɩsʋɔ tʋm danɛ gaa naŋ saŋa gaa Abiyata yɩɛ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ. Wʋ ju Ɩsʋɔ tʋm danɛ naŋ ga tawʋ bodobodo gaa ba yɩɛ ga chɩrɩchɩrɩ fa Ɩsʋɔ yela Mosesi mbara n fa gbɩɛ sɛ ba n tawʋ ʋ, amʋɔ Ɩsʋɔ seina nyiŋeŋ. Sɛ wʋ mʋ ŋarɛ fa wʋ dɔŋa na.&gt;&gt;<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Bakpa dʋɔ sɛ Ɩsʋɔ yɩɛ Fɩɛsɛ wɩɩ. Naa Fɩɛsɛ wɩɩ dʋɔ sɛ wʋ yɩɛ bakpa a <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Dɩmʋŋ dʋɔ, Wʋkpa Bu wʋŋ yɩɛ Kpaŋjuo Fɩɛsɛ wɩɩ dʋɔ bɛ.&gt;&gt;<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">Yesu chɔ baalɛ wʋrʋ wʋ pam sɩŋ</para>
  <para style="r">
    <ref loc="MAT 12:9-14">Matiyo 12:9-14</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Saŋ gʋrʋ dʋɔ Yesu ti bɔrɛ ju Yudatina tʋm danɛ naŋ. Na baalɛ wʋrʋ wɩɛ dɩmaŋ wʋ pam sɩŋ. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Na bakpa barɛ wɩɛ dɩmaŋ baa ja sɛ baa pʋɩ Yesu. Dɩmʋŋ dʋɔ baa pɩɛtɩ ɩ baa kɩɛ sɛ wʋ a chɔ baalɛ wʋŋ Fɩɛsɛ wɩɩ gaa yaa. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Sɛ Yesu tawɩ wʋŋ wʋ pam sɩŋ na sɛ, &lt;&lt;Kʋlʋ sɩŋ ba asanaŋ jɩna.&gt;&gt;<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Mosesi mbara fa gbɩɛ sɛ dɩ n yɩɛ dɩbam yaa dɩsʋbʋ Fɩɛsɛ wɩɩ? Dɩ n mɔlɔgɩ nkpa yaa dɩ n kʋ bakpa?&gt;&gt; Ama ba n tawɩ bʋrʋ ʋ.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Gʋ Yesu mʋ biŋbira kɩɛ ba na wʋ asa n lɩɛ ɛ, akala takɩɛ ba wɩɛna digela doŋ. Sɛ Yesu tawɩ baalɛ wʋŋ sɛ, &lt;&lt;Tɩɛŋɩ n pam.&gt;&gt; Sɛ wʋ tɩɛŋɩ sɛ gaa yɩɛ doŋ. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Gabʋanaŋ sɛ Farasitina baa lɩɩ tʋm danɛ gaa naŋ sɛ ba na Juo Hɛrɔdɩ wʋrʋgbɩɛtina baa barɛ ga mʋ sawʋra ganaŋkʋ ba kʋ Yesu na.<verse eid="MRK 3:6" /></para>
  <para style="s1">Bakpa fɔɩ kpaŋ Yesu</para>
  <para style="r">
    <ref loc="MAT 12:15-16">Matiyo 12:15-16</ref>; <ref loc="LUK 6:17-19">Luka 6:17-19</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesu na wʋ kpalɛnarɛ kʋlʋ ju Galaliya buo nʋɔ. Sɛ bakpa fɔɩ lɩɩ Galaliya tibi dʋɔ kpaŋ ɩ. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Gʋ ba nyii ŋii wʋ a yɩɛ na, bakpa fɔɩ lɩɩ Yudiya tibi dʋɔ, Yerusalem dɩɛ naŋ, Idumiya tibi dʋɔ, Yodaŋ gatɩɛsa, Tiro na Sidoŋ dɩɛsɛ naŋ kɔŋ wʋ jaŋ. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Bakpa fɔɩ baa dʋɔ Yesu tawɩ wʋ kpalɛnarɛ baa sɛ ba n ja buori fa ɩ na wʋ a tu ju buo gaa dʋɔ, na bakpa n baa gaa fu wʋ dʋɔ. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Akala takɩɛ wʋ chɔ bakpa fɔɩ, dɩmʋŋ dʋɔ sɛ lʋmɩɛtina fɔɩ aja sɛ baa mʋ ba pamɩɛ tapʋ ɩ. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Saŋa kʋma gaa bakpa baa feliŋ sʋbʋ wɩɛ ba tɩba na ɩ na, baa lɩɩ sala wʋ asanaŋ kuusi sɛ, &lt;&lt;Nyaŋ n nyina Ɩsʋɔ Bu wʋŋ.&gt;&gt; <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Sɛ Yesu jɔ ba nyienaŋ sɛ, ba n baa tawɩ wʋ tɛ wʋŋ wʋ yɩɛ na.<verse eid="MRK 3:12" /></para>
  <para style="s1">Yesu lɩsɛ kpirida gifi bala</para>
  <para style="r">
    <ref loc="MAT 10:2-4">Matiyo 10:2-4</ref>; <ref loc="LUK 6:14-16">Luka 6:14-16</ref>; <ref loc="ACT 1:13">Dɩtʋm 1:13</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yesu ju bʋrɔŋ garɛ dʋɔ, sɛ wʋ yagɛ baa wʋ a jawʋ na sɛ ba kɔŋ wʋ jaŋ. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Sɛ wʋ lɩsɛ ba tɩba gifi bala sɛ wʋ yagɛ ba sɛ kpirida<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Naa Sabɩɛwɩɛ ŋii kpiniŋ n wɩɛna wʋ yɩɛ ba wʋ kpirida a</char></note> sɛ ba n wɩɛ wʋ jaŋ na wʋ a kpiri ba na baa ga tawɩ Ɩsʋɔ wɩɛ, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />na baa yu yikuo na baa geŋ feliŋ sʋbʋ lɩɩ bakpa naŋ. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Gifi bala baa wʋ yagɛ na ba yɩrɩɛ mɩnaŋ: Simoŋ [wʋŋ Yesu si ɩ yɩrɛ sɛ Petero], <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Jamesi na wʋ nabu Yohane Sebedi bie, [baa Yesu si ba yɩrɛ sɛ Bʋwanagɛsɩ ga tie akala sɛ duoni fuba bie]. <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Na Andurusi, Filipo, Batolomiyo, Matiyo, Tomasi, Yakubu Alifiyosi bu, Tadiyosi, na Simoŋ wʋŋ baa yagɛ sɛ Sɩlɔtɩ<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Sɩlɔtɩtina ba yɩɛ Yudatina dikpeŋ baa ba kʋlʋ yuo Romatina</char></note> <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />na Yudasi Isikariyoti wʋŋ wʋ lɩsɛ Yesu fa na.<verse eid="MRK 3:19" /></para>
  <para style="s1">Yesu na Baalesebu</para>
  <para style="r">
    <ref loc="MAT 12:22-32">Matiyo 12:22-32</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Yesu ju waa dʋɔ, sɛ bakpa fɔɩ ti gaa jaŋi waa gaa dʋɔ, dɩmʋŋ dʋɔ wʋ na kpalɛnara baa n dɩlɛ yu gbɩɛ na baa di i. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Gʋ wʋ lʋŋtina nyii dɩmʋŋ na ba ju baa ga mʋ ɩ kɔŋ dɩɛ, akala takɩɛ bakpa a tawɩ sɛ aja yɩɛ wʋ nfɩɛrɛ warɩɛwʋ.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Sɛ Mosesi mbara bakalaasa baa ba barɛ lɩɩ Yerusalem kɔŋ ba wɩɛ dɩmaŋ na tawɩ sɛ, &lt;&lt;Belesebu wʋŋ wʋ yɩɛ feliŋ sʋbʋ bɩnɛ na yikuo wɩɛ wʋ tɩba. Dɩmʋŋ dʋɔ sɛ wʋ a dɩlɛ wʋ a geŋ feliŋ sʋbʋ wʋ a lɩɩ bakpa tɩba.&gt;&gt;<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Dɩmʋŋ dʋɔ Yesu yagɛ ba kɔŋ wʋ jaŋ sɛ wʋ tawɩ aduuna naŋ fa ba sɛ, &lt;&lt;Sɩnɛ sɛ Sɩtanɩ a dɩlɛ geŋ Sɩtanɩ lɩɩ bakpa tɩba? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Juori kʋma gaa ga kpara ga wʋsɛ tɩba gaa yuo dɔŋa na, gaa salɩɛ. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Dɩmʋŋ sɛ waa kʋma gaa ga kpara ga wʋsɛ gaa yuo dɔŋa na, gaa salɩɛ. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Dɩmʋŋ sɛ Sɩtanɩ gba kpara wʋ wʋsɛ wʋ a yuo dɔŋa na, wʋ aa dɩlɛ sɩŋ wʋ nafara dʋɔ ɔ. Dɩmʋŋ bɩrɛ na wʋ gɩtɛ talɛ mɩnaŋ. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Wʋrʋ taŋ wʋ a dɩlɛ ju doŋ-tɛ waa dʋɔ ga mʋ wʋ gapatɩɛ ɛ, amʋɔ wʋ chɩŋkpɩɛ pɔgʋ ɩ pɔɩ na wʋ a dɩlɛ ŋmɛlɩ ɩ. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Maa tawɩ sɛ n nyii na dieli sɛ Ɩsʋɔ aja wʋ a mʋ wʋkpa dɩsʋbʋ kpiniŋ na mbusu wɩɛ chɩɛ ɩ. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Ama wʋkʋma wʋŋ wʋ tawɩ mbusu wɩɛ baŋ Ɩsʋɔ Feliŋ na bɩrɛ, wʋ aa mʋ wʋ dɩsʋbʋ chɩɛ ɩ. Akala takɩɛ wʋ yɩɛ dɩsʋbʋ gaa ga taŋ gɩtɛ na.&gt;&gt;<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />Yesu tawɩ wɩɛ ŋina akala takɩɛ bakpa baa tawɩ sɛ feliŋ sʋbʋ wɩɛ wʋ tɩba.<verse eid="MRK 3:30" /></para>
  <para style="s1">Yesu wʋnaa na wʋnabie</para>
  <para style="r">
    <ref loc="MAT 12:46-50">Matiyo 12:46-50</ref>; <ref loc="LUK 8:19-21">Luka 8:19-21</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Dɩmaŋ sɛ Yesu wʋnaa na wʋnabie kɔŋ diele gaa wʋ wɩɛ na gaa dʋɔ sɩŋ waa gaa asʋŋ, sɛ ba kpiri wʋrʋ sɛ wʋŋ ga yagɛ ɩ fa ba. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Na bakpa fɔɩ chaɩ logo ɩ, sɛ ba tawɩ ɩ sɛ, &lt;&lt;Kɩɛ, nnaa na nnabie sɩmɩɛɩ waa gaa asanaŋ baa ja nyaŋ.&gt;&gt;<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Mmʋɔ n nyina manaa na manabie?&gt;&gt;<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Dɩmaŋ sɛ wʋ kɩɛ baa ba chaɩ logo ɩ na, sɛ wʋ tawɩ ba sɛ, &lt;&lt;Kɩɛ, manaa na manabie mɩnaŋ. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Wʋkʋma wʋŋ wʋ a yɩɛ Ɩsʋɔ jawʋ na n nyina manaa, manabu na madiesi.&gt;&gt;<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">Faradɛ wʋrʋ dʋɔ diduu</para>
  <para style="r">
    <ref loc="MAT 13:1-23">Matiyo 13:1-23</ref>; <ref loc="LUK 8:4-15">Luka 8:4-15</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Sɛ Yesu ti bɔrɛ ju Galaliya lɩɩ gaa nʋɔ sɛ wʋ fara wʋ a kalaa-kalaa bakpa. Bakpa fɔɩ baa dʋɔ, wʋ jʋʋ cha buori naŋ ju wʋ asanaŋ chonii, yela bakpa sɩmɩɛɩ lɩɩ gaa nʋɔ <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Sɛ wʋ mʋ aduuna kalaa ba wɩɛ fɔɩ, sɛ wʋ tawɩ ba sɛ, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />&lt;&lt;N nyii! Farɩdɛ wʋrʋ n ju na wʋ a ŋmati adiya bie. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Gʋ wʋ a ŋmati na, ŋarɛ sala gbɩɛ laraŋ sɛ jimbisi kɔŋ gaa tɔɔsɩ ŋɩ kpiniŋ di. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Sɛ ŋarɛ sala bʋɛ dʋɔ diele gaa tɩɛra taŋ fɔɩ na. Bie ŋii tu bileŋ akala takɩɛ tɩɛra fɔɩ taŋ bʋɛ ŋii dʋɔ ɔ, <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />dɩmʋŋ dʋɔ, wiita lɩɩ na ŋɩ ŋɩɛwʋ, akala takɩɛ ŋɩ tana lira a. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Sɛ ŋarɛ dʋɔ sala sɔba tibi dʋɔ. Sɛ sɔba na adiya bie ŋii tu bʋga ama sɔba ŋii bɩɩ ŋɩrɛ ŋɛ, dɩmʋŋ dʋɔ ŋɩ n dɩlɛ si bie e. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Dɩmʋŋ sɛ ŋarɛ dʋɔ sala tibi bam dʋɔ, sɛ ŋɩ tu bɩɩ sɛ ŋɩ si bie. Ŋarɛ si bie nkuo na sala, ŋarɛ dʋɔ ŋitoro, sɛ ŋarɛ dʋɔ gafie.&gt;&gt;<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Wʋŋ wʋ wɩɛna dɩla na, wʋ n nyii.&gt;&gt;<verse eid="MRK 4:9" /></para>
  <para style="s1">Kpɩnɩdɩ dʋɔ sɛ Yesu a tawɩ aduuna naŋ</para>
  <para style="r">
    <ref loc="MAT 13:10-17">Matiyo 13:10-17</ref>; <ref loc="LUK 8:9-10">Luka 8:9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Gʋ dɩka Yesu nyiŋeŋ na, wʋ kpirida gifi bala baa na baa ba kpi ba dʋɔ na kɔŋ gaa tasɛ ɩ sɛ, wʋ n kalaa ba diduu gaa tie. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Sɛ Yesu tawɩ ba sɛ amɩɛ bɩrɛ, Ɩsʋɔ yela sɛ ɩ nyii wʋ juori asiri wɩɛ ŋii tie, ama baa ba n kpi amɩɛ dʋɔ na bɩrɛ, aduuna naŋ sɛ wʋ a tawɩ wʋ a fa ba. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Dɩmʋŋ dʋɔ,</para>
  <para style="q1" vid="MRK 4:12">&lt;&lt;&lt;Baa kɩɛ bɩrɛ, ama baa na a.</para>
  <para style="q2" vid="MRK 4:12">Baa nyii bɩrɛ, ama baa nyii tie e.</para>
  <para style="q2" vid="MRK 4:12">Naa dɩmʋŋ na, nafʋɔ baa yela dɩsʋbʋ yɩɛ na</para>
  <para style="q2" vid="MRK 4:12">baa kɔŋ Ɩsʋɔ jaŋ</para>
  <para style="q2" vid="MRK 4:12">na wʋ a mʋ ba dɩsʋbʋ chɩɛ ba.&gt;<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Yis 6:9-10</ref>.</char></note>&gt;&gt;<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Sɛ Yesu tasɛ wʋ wʋrʋgbɩɛtina sɛ, &lt;&lt;Ɩŋ nyii diduu gana tie? Aja yɩɛ sɩnɛ na ɩ nyii aduuna ŋii ŋɩ kakaa na tie? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Farɩdɛ wʋŋ adiya bie ŋii wʋ duu na n nyina Ɩsʋɔ wɩɛ ŋii. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Adiya bie ŋii ŋɩ sala gbɩɛ laraŋ n nyina bakpa baa ba nyii Ɩsʋɔ wɩɛ na, gabʋanaŋ sɛ Sɩtanɩ a gaa lɩsɛ lɩɩ ba tɩba. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Bie ŋii ŋɩ sala bʋɛ tibi dʋɔ na n nyina bakpa baa ba nyii Ɩsʋɔ wɩɛ na, gabʋanaŋ sɛ baa mʋ asadi mʋ wɩɛ ŋii. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ama gʋ wɩɛ ŋii n pɩsɛ ba agela naŋ dʋɔ, baa dɩlɛ baa sɩŋ ba lɩɛdi naŋ taŋgɩlɛ ɛ. Sɛ awʋrʋfʋɔ yaa wʋsɛ chaŋ kɔŋ ba dʋɔ lɩɩ Ɩsʋɔ wɩɛ dʋɔ na, sɛ baa yela ba lɩɛdi naŋ. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Bie ŋii ŋɩ sala sɔba tibi dʋɔ na n nyina bakpa baa ba nyii Ɩsʋɔ wɩɛ, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ama ba yela sɛ chawʋ naŋ wɩɛ bisi, aterembie dɩsɛchɩbɛ na dulunya abʋrɩ jawʋ a nyala ba. Ŋina dʋɔ a gaa Ɩsʋɔ wɩɛ ŋii gbɩɛ ŋɩ yela sɛ ŋii dɩlɛ ŋii si bie ɩ. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Bie ŋii ŋɩ sala tibi bam dʋɔ na n nyina bakpa baa ba nyii wɩɛ ŋii na, baa lɩɛ ŋɛ na baa si bie. Barɛ si nkuo na sala, barɛ dʋɔ ŋitoro sɛ barɛ dʋɔ gafie kii ŋii ba ŋmati na.&gt;&gt;<verse eid="MRK 4:20" /></para>
  <para style="s1">Fetila dʋɔ diduu</para>
  <para style="r">
    <ref loc="LUK 8:16-18">Luka 8:16-18</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Sɛ Yesu ti bɔrɛ jɔ diduu sɛ, &lt;&lt;Wʋrʋ baa tʋ fitila na wʋ a mʋ dinyiŋkpa fu ga dʋɔ yaa wʋ a mʋ dʋ mpa tie e. Baa tʋ fitila mʋ jaga fitila dɩjagatɩŋ bɛ. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Akala takɩɛ bʋrʋkʋma gaa ga wɩsaɩ na, gaa lɩɩ na baa na. Dɩmʋŋ sɛ bʋrʋkʋma gaa ba fu ga dʋɔ na, gaa fulu dʋɔ na baa na. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Wʋkʋma wʋŋ wʋ wɩɛna dɩla na, wʋ n nyii.&gt;&gt;<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;N kɩɛ na dieli wɩɛ ŋii ɩ nyii na dʋɔ. Mudu gaa ɩ mʋ kalaa bʋrʋ darɛ fa wʋrʋ na, gaa sɛ Ɩsʋɔ gba aja wʋ a mʋ kalaa fa amɩɛ, na wʋ a mʋ ŋarɛ kpi amɩɛ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Akala takɩɛ, wʋkʋma wʋŋ wʋ wɩɛna bʋrʋ garɛ na, Ɩsʋɔ aja mʋ ŋarɛ kpi wʋ dʋɔ. Ama wʋkʋma wʋŋ wʋ tana na, pii ŋii wʋ wɩɛna ŋɛ na, Ɩsʋɔ aja lɩɛ lɩɩ wʋ jaŋ.&gt;&gt;<verse eid="MRK 4:25" /></para>
  <para style="s1">Bie ŋarɛ dʋɔ diduu</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ farɩdɛ wʋrʋ wʋŋ wʋ ŋmati bie wʋ fʋɔ naŋ. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Wʋ duo kʋlʋ saŋa kʋma na, wʋ a na gʋ bie ŋii a tu sɛ ŋii bɩɩ, ama gbɩɛ gaa ŋii mʋna dʋɔ sɛ ŋii bɩɩ na, wʋ ba jiŋ ŋ. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Tibi gaa aaŋ yela sɛ gamɩsɛ ŋii a bɩɩ sɛ ŋii si bie. Ŋii chɩŋkpɩɛ tu, ŋii nɔgʋ na ŋii lʋrʋ pɔɩ sɛ ŋii bɩɩ. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Ŋɩ bɩɩ na, farɩdɛ wʋŋ a mʋ luoji ju ga kara gamɩsɛ ŋii, akala takɩɛ ŋɩ karɩŋ saŋa talɛ.&gt;&gt;<verse eid="MRK 4:29" /></para>
  <para style="s1">Kpeli daŋ bi dʋɔ diduu</para>
  <para style="r">
    <ref loc="MAT 13:31-32">Matiyo 13:31-32</ref>; <ref loc="LUK 13:18-19">Luka 13:18-19</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesu tasɛ ba sɛ, &lt;&lt;Be bʋrʋ dʋɔ sɛ dɩɩ mʋ Ɩsʋɔ Juori gaa mʋ kɩɛsɩna yaa diduu gamʋɔ sɛ dɩ mʋ lɩsɛ tie? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Ga kɩɛna takɩɛ kpeli daŋ bi gaa ga yɩɛ gapii daŋ bie ŋii baa duu na kpiniŋ naŋ. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Gʋ ba duu ga na, gaa bɩɩ sɛ gaa yɩɛ daŋ janɛ dasɛ kpiniŋ naŋ sɛ gaa yɩɛ gayabɩsɛ na fʋagɩɛ, sɛ jimbisi a gaa yɩɛ gasɩsasɛ ga tɩba.&gt;&gt;<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Sɛ Yesu mʋ aduuna fɔɩ mʋ tawɩ Ɩsʋɔ wɩɛ kalaa ba ganaŋkʋ baa nyii tie. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Wʋ n tawɩ wɩɛ ŋarɛ fa ba sɛ wʋ n jɔ diduu u. Ama dɩka wʋ na wʋ kpalɛnarɛ nyiŋeŋ na, wʋ a lɩsɛ aduuna ŋii tie wʋ a kalaa ba.<verse eid="MRK 4:34" /></para>
  <para style="s1">Yesu yela sɛ feliŋ janɛ cha kuruŋ</para>
  <para style="r">
    <ref loc="MAT 8:23-27">Matiyo 8:23-27</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Dɩmʋŋ wɩɩ gana bʋyanɔ, Yesu tawɩ wʋ kpalɛnara baa sɛ, &lt;&lt;N yela dɩ tɩɛsɛ ju gatɩɛsa.&gt;&gt; <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Sɛ wʋ kpalɛnara baa kʋlʋ yela bakpa fɔɩ baa jʋʋ cha buori gaa Yesu chaɩ ga tɩba na sɛ ba tɩɛsɛ ju gatɩɛsa. Bakpa barɛ gba wɩɛ buori garɛ naŋ ba kpamɩna ba. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Gʋ baa ju na, sɛ feliŋ janɛ jɔ lɩɩ gaa dʋɔ sɛ dɩ jɔ apaa dʋ buori gaa naŋ hali ga ja gaa muru. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Ama Yesu bɩrɛ, wʋ duo gaputu dʋɔ buori gaa wʋrʋgbɩɛ. Sɛ wʋ kpalɛnara baa feŋsi ɩ sɛ ba tawɩ ɩ sɛ, &lt;&lt;Wʋkalaasa, gʋ dɩ ja dɩ muru na, ŋɩ n tiri nyaŋ?&gt;&gt;<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Dɩmaŋ na sɛ Yesu kʋlʋ sɛ wʋ fʋba feliŋ ŋii dʋɔ sɛ wʋ tawɩ apaa ŋii sɛ, &lt;&lt;Chakuruŋ.&gt;&gt; Sɛ ŋɩ chakuruŋ.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Sɛ Yesu tasɛ wʋ kpalɛnara baa sɛ, &lt;&lt;Be n yɩɛ sɛ nyɩŋtɩɛ chamɩna amɩɛ? Ɩ saŋ ɩɩ lɩɛdi bɛ?&gt;&gt;<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Gʋ ba na ŋii ŋɩ ju dʋɔ na, sɛ nyɩŋtɩɛ chaŋ ba sɛ ba tasɛ dɔŋa sɛ, &lt;&lt;Wʋkpa wʋ Mmʋɔ gba mɩnaŋ sɛ apaa na lɩŋ a nyii wʋ jaŋ nna?&gt;&gt;<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">Yesu gɩŋ feliŋ sʋbʋ lɩɩ baalɛ wʋrʋ tɩba</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesu na wʋ kpalɛnara baa tɩɛsɛ Galaliya lɩɩ ju gatɩɛsa gaa ga wɩɛ Gerasa tibi dʋɔ. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Gʋ Yesu lɩɩ buori gaa naŋ na, baalɛ wʋrʋ feliŋ sʋbʋ wɩɛ wʋ tɩba pala lɩɩ diwuutiŋ kɔŋ gaa jaŋi na ɩ. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Diwuutiŋ dɩmaŋ sɛ wʋ chaɩ. Wʋrʋ taŋ wʋ a dɩlɛ mʋ dɩgbaraŋgbaraŋ gba pɔgʋ ɩ ɩ. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Saŋa kʋma gaa ba mʋ dɩgbaraŋgbaraŋ pɔgʋ wʋ pamɩɛ na wʋ nafara na wʋ a ja ɩ ŋɛ. Wʋ doŋ dʋɔ, wʋrʋ taŋ wʋ a dɩlɛ pɔgʋ ɩ. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Tɩɛ naa na ga tam kʋma, wʋ dɔŋ diwuutiŋ na bʋrɔŋ biesi dʋɔ wʋ a kuusi yela wʋ chamɩna bʋɛ wʋ a karɩɛ wʋ wʋsɛ.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Gʋ wʋ na Yesu taŋasɛ na, wʋ se gaa luuŋ wʋ dʋna dʋɔ wʋ asanaŋ <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />sɛ wʋ kuusi na doŋ sɛ, &lt;&lt;Yesu, Ɩsʋɔ Wʋjanɛ Bu. Be sɛ maŋ na nyaŋ wɩɛna dɩ yɩɛ? Maa sʋlʋ nyaŋ Ɩsʋɔ yɩrɛ naŋ sɛ n baa nyala maŋ.&gt;&gt; <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Wʋ tawɩ dɩmʋŋ, akala takɩɛ Yesu cha tawɩ feliŋ sʋbʋ wʋŋ sɛ, &lt;&lt;Nyaŋ feliŋ sʋbʋ lɩɩ baalɛ wʋŋ tɩba.&gt;&gt;<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Sɛ Yesu tasɛ ɩ sɛ, &lt;&lt;Sɩnɛ sɛ baa yagɛ nyaŋ?&gt;&gt; Sɛ wʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Baa yagɛ maŋ sɛ Bɔlɩŋ, akala takɩɛ dɩ bɔlɩɛɩ.&gt;&gt;<verse eid="MRK 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 5:10" />Sɛ wʋ sʋlʋ Yesu sɛ, &lt;&lt;N baa geŋ daa lɩɩ tibi gana dʋɔ.&gt;&gt;<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Na ɔvaaba dikpeŋ barɛ wɩɛ bʋrɔŋ garɛ jaŋ baa di. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Sɛ feliŋ sʋbʋ wʋŋ sʋlʋ Yesu sɛ, &lt;&lt;Gɩŋ daa na dɩ ga jʋʋ ɔvaaba dikpeŋ baa tɩba.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Sɛ Yesu fa ba gbɩɛ sɛ ba lɩɩ baalɛ wʋŋ tɩba ga jʋʋ ɔvaaba baa tɩba. Ɔvaaba baa bɔlɩŋ aja yɩɛ kɔrʋɔsɛ ala (2,000) se ga jʋʋ lɩɩ gaa naŋ sɛ ba sɩŋ.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Gʋ ɔvaaba baa kɩɛra na ŋii ŋɩ tibi na, ba se ju dɩɛ gaa naŋ na fʋɔsɛ naŋ ga tawɩ wɩɛ ŋii fa bakpa. Dɩmʋŋ dʋɔ, bakapa ju ga kɩɛ ŋii ŋɩ tibi na. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Gʋ ba kɔŋ Yesu jaŋ na, ba na baalɛ wʋŋ feliŋ sʋbʋ bɔlɩŋ cha ba wɩɛ wʋ tɩba na kparɛ wʋ fuona gagba wʋ chaɩ Yesu jaŋ, sɛ nyɩŋtɩɛ chaŋ ba. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Baa ba na ŋii ŋɩ tibi na, ba kalaa fa baa ba kɔŋ dɩmaŋ na ganaŋkʋ baalɛ wʋŋ feliŋ sʋbʋ cha ba wɩɛ wʋ tɩba na kparɛ na ɔvaaba baa wɩɛ. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Sɛ ba sʋlʋ Yesu sɛ wʋ n lɩɩ ba tibi dʋɔ.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Gʋ Yesu bɔrɛ wʋ a ga jʋʋ buori gaa naŋ na, baalɛ wʋŋ Yesu gɩŋ feliŋ sʋbʋ wʋ tɩba na, sʋlʋ ɩ sɛ wʋŋ yela na wʋ na ɩ baa jʋʋ. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Ama Yesu n kpa a sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Bɔrɛ ju n dɩɛ naŋ na nyaa ga tawɩ ŋii Ɩsʋɔ yɩɛ fa nyaŋ, na ganaŋkʋ wʋ wɩɩ n gɩyɔŋ na fa n lʋŋtina.&gt;&gt; <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Dɩmʋŋ dʋɔ, baalɛ wʋŋ ti bɔrɛ ju Dekapolisi<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">Dekapolisi tie akala sɛ dɩɛsɛ gifi</char></note> tibi kpiniŋ dʋɔ ga tawɩ ŋii Yesu yɩɛ fa ɩ na. Sɛ dɩ yɩɛ wʋkʋma wina doba.<verse eid="MRK 5:20" /></para>
  <para style="s1">Yariyosi bu na alʋ wʋŋ wʋ tapʋ Yesu gagba na</para>
  <para style="r">
    <ref loc="MAT 9:18-26">Matiyo 9:18-26</ref>; <ref loc="LUK 8:41-56">Luka 8:41-56</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Gʋ Yesu na wʋ kpalɛnara baa ti bɔrɛ jʋʋ buori naŋ tɩɛsɛ ju gatɩɛsa na. Wʋ wɩɛ dɩmaŋ, sɛ bakpa fɔɩ gaa sila logo ɩ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Yudatina tʋm danɛ naŋ bɩnɩɛ baa tɩba wʋrʋ baa yagɛ ɩ sɛ Yariyosi kɔŋ dɩmaŋ. Gʋ wʋ na Yesu na, sɛ wʋ luuŋ wʋ nafara tie. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Sɛ wʋ chɩdɩsɛ sʋlʋ ɩ sɛ, &lt;&lt;Mabu galibie a kili wʋ a ja wʋ a sɩŋ. Maa sʋlʋ nyaŋ, yela na dɩɩ ju na nyaa ga mʋ n pam jaga wʋ dʋɔ na wʋ a yu lʋm chʋɔ na wʋ a ju dʋɔ cha nkpa naŋ.&gt;&gt; <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Gʋ wʋ na Yesu mʋ gbɩɛ baa ju na, yela bakpa fɔɩ kpamɩna ba fuwei wʋ dʋɔ.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Alʋ wʋrʋ asima ajɔyɩ bɩŋsɛ gifi ala cha wʋ wɩɛ bakpa fɔɩ baa tɩba. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Wʋŋ wʋ warɩɛ wʋ aterembie kpiniŋ lʋmɩɛ Chɔra jaŋ sɛ nafʋɔ wʋ n yu alaŋfiya, ama dɩtɩɛna sɛ lʋm gaa nʋɔ yɩɛ doŋ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Gʋ alʋ wʋŋ nyii Yesu dʋɔ na, wʋ lɩɩ bakpa fɔɩ baa naŋ lɩɩna wʋ wʋrʋgbɩɛ sɛ wʋ mʋ wʋ pam ga tapʋ wʋ adugbe gagba, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />akala takɩɛ, wʋ tawɩ wʋ nyinaŋ sɛ, &lt;&lt;Ma dɩlɛ mʋ ma pam chaŋ wʋ adugbe gagba na, maa yu lʋm chʋɔ.&gt;&gt; <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Sɛ wʋ chaŋ Yesu gagba gaa naŋ, gabʋanaŋ sɛ asima ŋii ŋii jɔ ɩ na kena yela. Sɛ wʋ na wʋ wʋsɛ naŋ gʋ wʋ yu lʋm chʋɔ.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Gabʋanaŋ sɛ Yesu jiŋ wʋ wʋsɛ naŋ gʋ doŋ ŋarɛ lɩɩ wʋ tɩba. Wʋ kɩɛ bakpa bɔlɩŋ baa naŋ logo sɛ wʋ tasɛ sɛ, &lt;&lt;Mmʋɔ n tapʋ ma adugbe gagba?&gt;&gt;<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Sɛ Yesu kpalɛnara baa lɩsɛ nʋɔ sɛ, &lt;&lt;Nyaŋ gba nya na gʋ bakpa fuwei n dʋɔ. Be n yɩɛ sɛ nya tasɛ sɛ Mmʋɔ n tapʋ nyaŋ?&gt;&gt;<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Ama Yesu a kɩɛ wʋ a logo wʋ a ja wʋŋ wʋ yɩɛ dɩmʋŋ na. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Alʋ wʋŋ na gʋ asima ŋii karɛ na, wʋ mʋ nyɩŋtɩɛ na wʋsɛ selesi gaa luuŋ Yesu nafara tie sɛ wʋ tawɩ gasiŋteŋ gaa kpiniŋ fa ɩ. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Alʋ, n lɩɛdi chɔ nyaŋ. Pala wʋsɛfɩɛ naŋ, nya awʋrʋfʋɔ si gɩtɛ.&gt;&gt;<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Gʋ Yesu saŋ wʋ a tawɩ na, gabʋɔsɛ barɛ baa ba lɩɩ Yariyosi wʋŋ wʋ yɩɛ Yudatina tʋm danɛ naŋ bɩnɛ na waa dʋɔ kɔŋ gaa tawɩ ɩ sɛ, &lt;&lt;Nbu galibie sɩŋ. Be n yɩɛ sɛ n saŋ nyaa nyala wʋkalaasa wʋŋ?&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Ama Yesu n mʋ ba wɩɛ ŋii mʋ tʋŋ dɩtʋm m, sɛ wʋ tawɩ Yariyosi sɛ, &lt;&lt;N baa yela nyɩŋtɩɛ a chaŋ nyaŋ, nyaŋ bɩrɛ lɩɛ di.&gt;&gt;<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Yesu n yela wʋrʋ a kpaŋ ɩ ɩ amʋɔ Petero, Jamesi na wʋnabu Yohane. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Gʋ ba tala Yariyosi waa dʋɔ na, Yesu na bakpa baa a wii doŋ dʋɔ. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yesu jʋʋ waa gaa dʋɔ, sɛ wʋ tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ wii doŋ dʋɔ? Galibie wʋŋ n sɩŋ ŋ, ama wʋ duo bɛ.&gt;&gt; <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Ama bakpa baa ba nyii wɩɛ ŋii na, ba mʋɩ ɩ. Sɛ wʋ yela sɛ ba lɩɩ asʋŋ, sɛ dɩkaka galibie wʋŋ lʋrʋda, na wʋ kpalɛnara batoro baa, sɛ ba jʋʋ danɛ gaa galibie wʋŋ duwei ga tɩba na.<verse eid="MRK 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 5:41" />Wʋ chaŋ atatɛ wʋŋ tawɩ sɛ, <char style="tl">&lt;&lt;Talita kum&gt;&gt;, </char> tie akala sɛ galibie kʋlʋ. <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Gabʋanaŋ sɛ galibie wʋŋ kʋlʋ wʋ dɔŋ wʋ dɔŋ danɛ gaa naŋ [wʋ di bɩŋsɛ gifi ala]. Sɛ dɩ yɩɛ bakpa kpiniŋ doba. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Sɛ Yesu dʋ ba sɛ ba n baa tawɩ wɩɛ ŋii fa wʋrʋ. Sɛ wʋ tawɩ ba sɛ ba n ja adiya fa ɩ na wʋ a di.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">Nasaratitina pɩɛ Yesu</para>
  <para style="r">
    <ref loc="MAT 13:54-58">Matiyo 13:54-58</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesu lɩɩ dɩmaŋ bɔrɛ ju wʋ dɩɛnaŋ Nasarati sɛ wʋ kpalɛnara baa kpaŋ ɩ. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Gʋ Fɩɛsɛ wɩɩ talɛ na, wʋ ju Yudatina tʋm danɛ gaa naŋ sɛ wʋ fara wʋ a kalaa Ɩsʋɔ wɩɛ. Sɛ wʋ wɩɛ ŋii yɩɛ bakpa fɔɩ baa ba nyii na doba. Sɛ ba tasɛ sɛ, &lt;&lt;Le sɛ wʋkpa wina yu wɩɛ ŋina?&gt;&gt; Sɛ ba ju dʋɔ tasɛ sɛ, &lt;&lt;Le sɛ wʋ yu kpiŋjim hali wʋ a dɩlɛ wʋ a yɩɛ adaŋgana ŋina? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Naa kapinta wʋŋ mɩnaŋ? Naa Mariya bu wʋŋ bɛ, wʋŋ wʋ nabie yɩɛ Jamesi, Yosefu, Yudasi na Simoŋ? Naa wʋ diesina n wɩɛna daa jaŋ nna?&gt;&gt; Dɩmʋŋ dʋɔ ba pɩɛ ɩ.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Bakpa a mʋ jilima baa fa Ɩsʋɔ ɔja gapɩlɛkʋma, amʋɔ wʋ dɩɛ naŋ na wʋ dɩɛnaŋtina na wʋ waa dʋɔtina nyiŋeŋ jaŋ sɛ wʋ tana jilima a.&gt;&gt; <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Dɩmʋŋ dʋɔ, wʋ n dɩlɛ yɩɛ adaŋgana fɔɩ dɩmaŋ ŋ, amʋɔ bakpa pii barɛ sɛ wʋ mʋ wʋ pam jaga ba dʋɔ sɛ ba yu lʋm chʋɔ. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Sɛ dɩ yɩɛ Yesu doba, akala takɩɛ bakpa baa tana lɩɛdi. Sɛ Yesu pala akpie-akpie dʋɔ kalaa Ɩsʋɔ wɩɛ.<verse eid="MRK 6:6" /></para>
  <para style="s1">Yesu kpiri wʋ kpalɛnara gifi bala baa</para>
  <para style="r">
    <ref loc="MAT 10:5-15">Matiyo 10:5-15</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Sɛ Yesu yagɛ wʋ kpalɛnara gifi bala baa kɔŋ wʋ jaŋ, sɛ wʋ kpiri ba bala-bala sɛ wʋ fa ba yikuo feliŋ sʋbʋ dʋɔ.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Ɩ ju gbɩɛ gaa na, n baa mʋ bʋrʋ amʋɔ dasɛ atugasa. N baa mʋ adiya, didiku yaa aterembie dʋ aterembie takpe naŋ. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />N dʋ asibita, ama n baa mʋ gagbasɛ chaŋ kpi.&gt;&gt; <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Waa kʋma gaa ɩ jʋʋ ga dʋɔ na, n cha dɩmaŋ ga tala saŋa gaa ɩ lɩɩ dɩɛ gana naŋ. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Gapɩlɛkʋma gaa ɩ ju sɛ ba n lɩɛ amɩɛ yaa ba n nyii amɩɛ wɩɛ na, ɩ lɩɩ dɩmaŋ na, n kpisi amɩɛ nafara tie dibuu wʋrʋgɩ dɩmaŋ, na ŋii di seriya chicha ba takɩɛ ba dɩsʋbʋ dʋɔ ba dʋɔ.&gt;&gt;<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Dɩmʋŋ dʋɔ, ba ju ga tawɩ Ɩsʋɔ wɩɛ fa bakpa sɛ ba n biliŋi lɩɩ ba dɩsʋbʋ naŋ. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Sɛ ba geŋ feliŋ asʋbʋɛ lɩɩ bakpa tɩba sɛ ba susaa lʋmɩɛtina galaga nuŋ sɛ ba chɔ bakpa.<verse eid="MRK 6:13" /></para>
  <para style="s1">Yohane Ɩsʋɔ Sɔrɛ wʋŋ sɩŋ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 14:1-12">Matiyo 14:1-12</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Juo Hɛrɔdɩ nyii Yesu wʋsɛ dʋɔ wɩɛ, akala takɩɛ wʋ yɩrɛ nyii gapɩlɛkʋma. Sɛ barɛ tawɩ sɛ, &lt;&lt;Yohane Ɩsʋɔ Sɔrɛ wʋŋ n feŋ lɩɩ sɩŋ naŋ, dɩmʋŋ dʋɔ sɛ wʋ wɩɛna yikuo wʋ a yɩɛ adaŋgana ŋina.&gt;&gt;<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Barɛ dʋɔ a tawɩ sɛ, &lt;&lt;Wʋ yɩɛ Ɩsʋɔ ɔja Eliya bɛ.&gt;&gt; Sɛ barɛ dʋɔ a tawɩ sɛ, &lt;&lt;Wʋ yɩɛ Ɩsʋɔ bajana gɩbɩnɩŋtina baa tɩba wʋrʋ bɛ.&gt;&gt;<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Gʋ Juo Hɛrɔdɩ nyii Yesu wɩɛ ŋii ba tawɩ na, wʋ tawɩ sɛ, &lt;&lt;Wʋ yɩɛ Yohane Ɩsʋɔ Sɔrɛ wʋŋ ma cha yela sɛ ba kara wʋ nyi na bɛ sɛ wʋ feŋ lɩɩ sɩŋ naŋ.&gt;&gt;<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Hɛrɔdɩ tawɩ dɩmʋŋ akala takɩɛ wʋŋ n cha yela sɛ ba chaŋ Yohane Ɩsʋɔ Sɔrɛ wʋŋ, sɛ ba mʋ dɩgbaraŋgbaraŋ pɔgʋ ɩ sɛ ba mʋ ɩ tɔ danɛ, akala takɩɛ Yohane n kpa sɛ wʋ n lɩɛ wʋ nabu Filipo alʋ Hɛrɔdɩya saa a. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yohane Ɩsʋɔ Sɔrɛ wʋŋ cha tawɩ Hɛrɔdɩ sɛ, &lt;&lt;Mosesi mbara n fa gbɩɛ sɛ nyaŋ Hɛrɔdɩ n saa nnabu alʋ ʋ.&gt;&gt; <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Dɩmʋŋ dʋɔ sɛ Hɛrɔdɩya akɔla Yohane wʋ a ja wʋ a kʋ ɩ. Ama wʋ n dɩlɛ ɛ. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Akala takɩɛ Juo Hɛrɔdɩ a fa Yohane jilima sɛ wʋ jiŋ gʋ wʋ yɩɛ wʋkpa wʋchirigisa na dɩchɩrɩchɩrɩ, dɩmʋŋ dʋɔ wʋ a gie ɩ. Wʋ aja Yohane wɩɛ nyii bɩrɛ, ama saŋa kʋma ga wʋ nyii na, wʋ digela a warɩɛwʋ.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Gʋ Juo Hɛrɔdɩ lʋrʋ wɩɩ asadi talɛ na, wʋ yagɛ dɩɛ bɩnɩɛ, yuora bɩnɩɛ na Galaliya bɩnɩɛ sɛ ba n gaa di asadi adiya di. Dɩmaŋ sɛ gbɩɛ duo fa wʋ alʋ Hɛrɔdɩya takɩɛ wʋŋ yu gbɩɛ kʋ Yohane. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Dɩmaŋ sɛ Hɛrɔdɩya bu galibie sʋɛ sɛ Juo Hɛrɔdɩ na baa wʋ lɔ pam yagɛ ba na asadi wʋ dʋɔ. Dɩmʋŋ dʋɔ, wʋ tawɩ galibie wʋŋ sɛ, &lt;&lt;Tasɛ bʋrʋkʋma gaa nyaa jawʋ na maa yɩɛ fa nyaŋ.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Sɛ wʋ ka ntaŋ sɛ, &lt;&lt;Bʋrʋkʋma gaa nyaa jawʋ na, hali ma juori gaa salɛ gba, maa mʋ fa nyaŋ.&gt;&gt;<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Sɛ galibie wʋŋ ju ga tasɛ wʋnaa sɛ, &lt;&lt;Be sɛ maŋ tasɛ?&gt;&gt;</para>
  <para style="p" vid="MRK 6:24">Sɛ wʋnaa tawɩ ɩ sɛ, &lt;&lt;Tawɩ ɩ sɛ nyaa ja Yohane Ɩsʋɔ Sɔrɛ wʋŋ nyi.&gt;&gt;<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Sɛ galibie wʋŋ yɩɛ bileŋ ju ga tawɩ Juo Hɛrɔdɩ sɛ, &lt;&lt;Maa ja Yohane Ɩsʋɔ Sɔrɛ wʋŋ nyi taŋgiraŋ dʋɔ dɩtɩɛna gana.&gt;&gt;<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Juo Hɛrɔdɩ asa n lɩɛ ɛ, ama ntaŋ ŋii wʋ ka na baa wʋ lɔ pam yagɛ ba na dʋɔ, wʋ n dɩlɛ pɩɛsɛ ɩ ɩ. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Dɩmaŋ sɛ wʋ kpiri wʋ yuoyuori wʋrʋ sɛ wʋŋ ju danɛ dɩtʋɔtɩŋ ga kara Yohane nyi kɔŋ. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Sɛ wʋ ju ga kara Yohane nyi mʋ jaga taŋgiraŋ dʋɔ mʋ kɔna galibie wʋŋ. Sɛ galibie wʋŋ mʋ ju ga fa wʋnaa. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Gʋ Yohane kpalɛnara baa nyii wʋ sɩŋ na, ba kɔŋ gaa mʋ wʋ gɩtatɛ ga wuu.<verse eid="MRK 6:29" /></para>
  <para style="s1">Yesu disi bakpa kɔrʋɔsɛ sɩ nʋŋ adiya</para>
  <para style="r">
    <ref loc="MAT 14:13-21">Matiyo 14:13-21</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Yesu kpirida baa wʋ kpiri ba na bɔrɛ kɔŋ wʋ jaŋ. Sɛ ba gaa tawɩ ɩ ŋii ba ga yɩɛ na ŋii ba ga kalaa na kpiniŋ. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Bakpa fɔɩ baa baa jiŋ baa tibi Yesu dʋɔ na, dɩ yela sɛ Yesu na wʋ kpirida baa n dɩlɛ yu saŋa na baa di i. Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N yela na dɩ ju ifuli dʋɔ ga fɩɛsɛ.&gt;&gt;<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Sɛ ba nyiŋeŋ jʋʋ buori naŋ ju ifuli dʋɔ. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Ama gʋ baa ju na, bakpa fɔɩ na ba jiŋ ba. Sɛ bakpa baa se lɩɩ dɩɛsɛ naŋ kpiniŋ pala asanaŋ ga daa ba diele gaa baa ju na. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Gʋ Yesu tibi buori naŋ sɛ wʋ na bakpa fɔɩ baa na, ba wɩɛ yɩɛ ɩ gɩyɔŋ. Akala takɩɛ ba kɩɛna bɛ takɩɛ feŋ baa ba tana kparɛ na. Dɩmaŋ sɛ wʋ kalaa-kalaa ba wɩɛ fɔɩ.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Gʋ dɩ tala bʋyanɔ na, wʋ kpalɛnara baa kɔŋ wʋ jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Jɩna yɩɛ ifuli dʋɔ bɛ tɩɛ dʋɔ tam. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Lɩsɛ bakpa baa gbɩɛ na baa ju dɩɛsɛ naŋ na dɩɛsɛ bisi ŋii ŋɩ tirina daa na ba tɩŋtɩŋ baa ju ga lɩɛ adiya di.&gt;&gt;<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Ama Yesu tawɩ ba sɛ, &lt;&lt;Amɩɛ tɩŋtɩŋ n fa ba adiya na baa di.&gt;&gt; Sɛ ba tasɛ ɩ sɛ, &lt;&lt;Le sɛ dɩ yu dɩtʋm yɩɛrɛ gafɩtasɛ jiŋinara kɩmtʋɔ aterembie ga lɩɛ adiya fa ba na baa di?&gt;&gt;<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Bodobodo aŋmaŋ sɛ ɩ wɩɛna? N ju ga kɩɛ.&gt;&gt; Gʋ ba ju ga kɩɛ na, ba gaa tawɩ sɛ, &lt;&lt;Bodobodo anʋŋ na aji bala sɛ dɩ wɩɛna.&gt;&gt;<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Sɛ Yesu tawɩ wʋ kpalɛnara baa sɛ ba n yela na bakpa baa a cha kasɛ alayɩɛ ŋii dʋɔ akpeŋ-akpeŋ. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Sɛ bakpa baa cha akpeŋ-akpeŋ gafɩsɩ dʋɔ na ŋɩla na sala dʋɔ. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Sɛ Yesu mʋ bodobodo anʋŋ ŋii na aji bala baa, sɛ wʋ kɩɛ Ɩsʋɔ adugbe sɛ wʋ yɩlɩ Ɩsʋɔ. Sɛ wʋ jaɩ mʋ fa wʋ kpalɛnara baa sɛ ba n mʋ fa bakpa baa kpiniŋ. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Sɛ wʋkʋma wina di sɛ wʋ pawʋ. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Sɛ wʋ kpalɛnara baa tɔɔsɩ ŋii ba di kakaa na gachaŋasɛ gifi ala. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Baala baa ba kpi bakpa baa ba di adiya ŋii dʋɔ na nʋɔ yɩɛ kɔrʋɔsɛ sɩ nʋŋ (5,000).<verse eid="MRK 6:44" /></para>
  <para style="s1">Yesu pala lɩŋ dʋɔ</para>
  <para style="r">
    <ref loc="MAT 14:22-33">Matiyo 14:22-33</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Dɩmaŋ sɛ Yesu yela sɛ wʋ kpalɛnara baa jʋʋ buori naŋ, sɛ ba pala wʋ asanaŋ ju Betisayida gaa ga wɩɛ gatɩɛsa. Sɛ wʋ dʋɔ wʋrʋgbɩɛ sɛ wʋ tii bakpa baa gbɩɛ. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Gʋ wʋ tii ba gbɩɛ taŋ na, sɛ wʋ ju bʋrɔŋ dʋɔ ga jɔ dɩga.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Gʋ bʋyanɔ talɛ na, dɩ kakaa Yesu nyiŋeŋ lɩɩ gaa nʋɔ, yela buori gaa tala lɩɩ gaa tɩtɩba. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Sɛ Yesu na gʋ wʋ kpalɛnara baa wʋsɛ a chaŋ ba palaa ŋii naŋ, akala takɩɛ apaa ŋii a jaŋina ba. Aja yɩɛ tafɩlɛ karafɩɛ anara saŋa na Yesu pala lɩŋ ŋii dʋɔ wʋ a ju ba jaŋ wʋ a ja wʋ a laŋ ba dʋɔ. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Ama gʋ ba na Yesu pala lɩŋ ŋii dʋɔ wʋ a kɔnɛ na, ba jiŋ sɛ gɩtatɩrɛ bɛ, sɛ ba kuusi. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Akala takɩɛ ba kpiniŋ ba na ɩ na, nyɩŋtɩɛ chaŋ ba. Gabʋanaŋ sɛ Yesu tawɩ ba sɛ, &lt;&lt;N yu digela. Maŋ bɛ. N baa yɩɛ nyɩŋtɩɛ.&gt;&gt;<verse eid="MRK 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51" />Sɛ Yesu jʋʋ ba jaŋ buori gaa naŋ, sɛ feliŋ janɛ ŋii yeli. Sɛ dɩ yɩɛ ba doba, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />sɛ ba n nyii bodobodo ŋii Yesu fa bakpa kɔrʋɔsɛ sɩ nʋŋ (5,000) sɛ ba di na, tie ɩ. Akala takɩɛ ba agela wɩɛ doŋ.<verse eid="MRK 6:52" /></para>
  <para style="s1">Yesu chɔ lʋmɩɛtina Jenesareti tibi dʋɔ</para>
  <para style="r">
    <ref loc="MAT 14:34-36">Matiyo 14:34-36</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Sɛ Yesu na wʋ kpalɛnara baa tɩɛsɛ lɩɩ kɔŋ Jenesareti tibi dʋɔ sɛ ba mʋ ba buori gaa kpaŋ. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Gʋ ba lɩɩ buori gaa naŋ na, gabʋanaŋ sɛ bakpa jiŋ Yesu. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Dɩmʋŋ dʋɔ bakpa se lɩɩ tibi gaa dʋɔ kpiniŋ, sɩlɛ lʋmɩɛtina ba akalaŋ dʋɔ baa kɔŋ diele gaa ba nyii Yesu dʋɔ na. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Gapɩlɛkʋma gaa Yesu aja ju na, dɩɛsɛ ajanɩɛ naŋ bɛ o yaa dɩɛsɛ bisi naŋ bɛ o, bakpa a mʋ ba lʋmɩɛtina baa kɔŋ gɩyɩɛ naŋ baa sʋlʋ ɩ sɛ wʋ n yela na baa mʋ ba pamɩɛ tapʋ wʋ adugbe gagba nʋɔ. Sɛ baa ba tapʋ ɩ na kpiniŋ yu lʋm chʋɔ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">Duluŋ akalaasa</para>
  <para style="r">
    <ref loc="MAT 15:1-9">Matiyo 15:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Farasitina na mbara bakalaasa baa barɛ lɩɩ Yerusalem dɩɛ naŋ kɔŋ gaa sila logo Yesu, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />sɛ ba na Yesu kpalɛnara barɛ gʋ ba n saŋ ba pamɩɛ na ŋii yɩɛ dɩchɩrɩchɩrɩ pɔɩ na baa di, ganaŋkʋ Farasitina ayɩɛsa kɩɛna na a. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />[Akala takɩɛ Farasitina na Yudatina kpiniŋ a kpaŋ ba duluŋ ayɩɛsa dʋɔ. Dɩmʋŋ dʋɔ baa di i, amʋɔ ba saŋ ba pamɩɛ iniesi saŋ lɩsɛ pɔɩ na baa di, ganaŋkʋ ba duluŋ ayɩɛsa akala na. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Ba lɩɩ gɩyɩɛ naŋ kɔŋ na, baa di adiya a, amʋɔ ba saŋ ba pamɩɛ ganaŋkʋ ba ayɩɛsa akala na. Ba duluŋ ayɩɛsa ŋii baa kpaŋ dʋɔ na ŋarɛ n nyina takɩɛ gafisi, sapɩɛ bisi na nyɩnasɛ yalɛ.]<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Sɛ Farasitina na Mosesi mbara bakalaasa baa tasɛ Yesu sɛ, &lt;&lt;Be n yɩɛ sɛ n kpalɛnara baa ba aa kpaŋ daa duluŋ ayɩɛsa dʋɔ? Akala takɩɛ ba aa mʋ ba pamɩɛ na iniesi baa di (baa saŋ ba pamɩɛ na baa yɩɛ ba wʋsɛ dɩchɩrɩchɩrɩ pɔɩ na baa di i.)&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Wɩɛ ŋii Ɩsʋɔ ɔja Yisaya cha gbalɛ lɩɩna amɩɛ aluguusitina dʋɔ na yɩɛ gasiŋteŋ bɛ. Ba sabɩɛ Ɩsʋɔ wɩɛ naŋ sɛ,</para>
  <para style="q1" vid="MRK 7:6">&lt;&lt;&lt;Bakpa bana, ba nʋɔ naŋ sɛ baa bu maŋ,</para>
  <para style="q2" vid="MRK 7:6">ama ŋɩ n lɩɩ ba agela naŋ ŋ.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Ɩ tʋm maŋ kpakpuo, akala takɩɛ,</para>
  <para style="q2" vid="MRK 7:7">wʋkpa mbara sɛ ɩ kalaa.&gt;<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Yis 29:13</ref>.</char></note>&gt;&gt;<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩ yela Ɩsʋɔ mbara sɛ ɩ kpaŋ amɩɛ duluŋ ayɩɛsa dʋɔ.&gt;&gt;<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Sɛ wʋ ti bɔrɛ tawɩ ba sɛ, &lt;&lt;Ɩ wɩɛna dɩsɛ fulu gbɩɛ gaa ɩ sɩmɩɛɩ dʋɔ ɩ yela Ɩsʋɔ mbara ŋii ɩ si laraŋ, na ɩ yu gbɩɛ kpaŋ amɩɛ duluŋ ayɩɛsa dʋɔ. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Mosesi tawɩ mbara wɩɛ ŋii naŋ sɛ, &lt;Bu njuo na nnaa,&gt;<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Ɛsa 20:12</ref>; <ref loc="DEU 5:6">Ditiro 5:6</ref>.</char></note> na wʋkʋma wʋŋ wʋ a tawɩ wɩɛ baŋ wʋjuo yaa wʋnaa na, ŋɩ tiri gʋ ba n kʋ ɩ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 21:17">Ɛsa 21:17</ref>; <ref loc="LEV 20:9">Lɛf 20:9</ref>.</char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ama amɩɛ bɩrɛ, ɩ kalaa sɛ wʋkʋma n tawɩ wʋjuo yaa wʋnaa sɛ, &lt;&lt;Chɔna kʋma ŋii nyaa yu lɩɩ ma jaŋ na yɩɛ Kɔbaŋ [gaa ga tie akala sɛ gafaasa fa Ɩsʋɔ.] <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Dɩmʋŋ dʋɔ dɩ yela sɛ wʋ aa dɩlɛ kɩɛ wʋjuo yaa wʋnaa a. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Dɩ kɔŋ dɩmʋŋ na, amɩɛ duluŋ ayɩɛsa ŋii ba yela si fa amɩɛ na dʋɔ ɩɩ di Ɩsʋɔ wɩɛ dʋɔ ɔ. Wɩɛ ŋii ŋɩ kɩɛna dɩmʋŋ na fɔɩ sɛ ɩ yɩɛ.&gt;&gt;<verse eid="MRK 7:13" /></para>
  <para style="s1">Bʋrʋ gaa gaa yela sɛ wʋkpa wʋsɛ a yɩɛ iniesi</para>
  <para style="r">
    <ref loc="MAT 15:10-20">Matiyo 15:10-20</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yesu ti bɔrɛ yagɛ jama baa kɔŋ wʋ jaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;Wʋkʋma n nyii ma jaŋ na ɩ nyii tie sɛ <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />naa ŋii ŋɩ lɩɩ asʋŋ jʋʋ wʋkpa wʋsɛ naŋ na, aaŋ yela sɛ wʋ wʋsɛ a yɩɛ iniesi i. Ama bʋrʋ gaa gaa lɩɩ wʋ wʋsɛ naŋ na, aaŋ dɩlɛ yela na wʋ wʋsɛ a yɩɛ iniesi.&gt;&gt; <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />[Wʋkʋma wʋŋ wʋ wɩɛna dɩla na wʋ n nyii.]<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Naa Sabɩɛwɩɛ ŋii kpiniŋ n wɩɛna dɩmʋŋ wɩɛ ŋii na a</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Gʋ Yesu lɩɩ jama baa jaŋ ju waa dʋɔ na, wʋ kpalɛnara baa tasɛ ɩ diduu gaa tie. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Amɩɛ gba ɩŋ nyii tie? Naa ŋii ŋɩ lɩɩ asʋŋ jʋʋ wʋkpa wʋsɛ naŋ na aaŋ yela sɛ wʋ wʋsɛ a yɩɛ iniesi i. <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Akala takɩɛ ŋii ŋɩ jʋʋ wʋ digela naŋ, ama ŋii jʋʋ wʋ lori naŋ bɛ na ŋii lɩɩ.&gt;&gt; [Yesu tawɩ ŋina mʋ kalaa takɩɛ adiya kʋma ŋina yɩɛ chɩrɩchɩrɩ.]<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Bʋrʋkʋma gaa ga lɩɩ wʋkpa wʋsɛ naŋ na, aaŋ yela sɛ wʋ wʋsɛ a yɩɛ iniesi. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Akala takɩɛ wʋkpa digela naŋ sɛ dɩsʋbʋ kpiniŋ a lɩɩ ŋii kɔnɛ sɛ ŋii yela sɛ wʋ a yɩɛ dɩsʋbʋ takɩɛ nfɩɛrɛ asʋbʋɛ, danaŋburidi, ŋmɩɛlɩŋ, gatagapʋ, baalɛ wʋrʋgbɩɛ lɩɩ yaa alʋ wʋrʋgbɩɛ lɩɩ, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />dɩsɛchɩbɛ, kɔlɩŋ ayɩɛsa, pɩna, gɩjaga wɩɛ, ajʋʋnyaŋ, yɩrɛ warɩɛwʋ, gɩjaŋjanɛ na gɩmalaŋpʋrɛ. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Dɩmʋŋ dɩsʋbʋ ŋina kpiniŋ aaŋ lɩɩ wʋkpa digela naŋ sɛ ŋii yela sɛ wʋ wʋsɛ a yɩɛ iniesi.&gt;&gt;<verse eid="MRK 7:23" /></para>
  <para style="s1">Giriki alʋ wʋrʋ lɩɛdi</para>
  <para style="r">
    <ref loc="MAT 15:21-28">Matiyo 15:21-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesu lɩɩ Galaliya lɩɩ nʋɔ ju Tirosi tibi dʋɔ. Wʋ jʋʋ waa garɛ dʋɔ na wʋ n ja sɛ wʋrʋ a jiŋ wʋ dʋɔ sɛ wʋ wɩɛ dɩmaŋ ŋ. Ama ŋɩ n dɩlɛ yɩɛ wɩɛ awɩsɛsa a. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Alʋ wʋrʋ feliŋ sʋbʋ chaɩ wʋbu galibie tɩba, gʋ wʋ nyii Yesu dʋɔ na, gabʋanaŋ sɛ wʋ kɔŋ Yesu jaŋ sɛ wʋ gaa luuŋ wʋ asanaŋ. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Alʋ wʋŋ yɩɛ Giriki wʋkpa bɛ, sɛ ba lʋrʋ ɩ Siro-Fonisiya tibi dʋɔ. Wʋ sʋlʋ Yesu sɛ wʋ n gɩŋ feliŋ sʋbʋ wʋŋ lɩɩ wʋ galibie wʋŋ tɩba.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Sɛ Yesu tawɩ Giriki alʋ wʋŋ sɛ, &lt;&lt;N yela na bachaasɛ achɩŋkpɩɛ di pa pɔɩ. Akala takɩɛ dɩ n daga na baa mʋ bachaasɛ adiya fa paasɛ ɛ.&gt;&gt;<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Sɛ Alʋ wʋŋ tawɩ ɩ sɛ, &lt;&lt;Kpaŋjuo, yɩɛ gasiŋteŋ bɩrɛ ama paasɛ gba a duo tebulu tie baa di bachaasɛ ajarɩɛ bisi ŋii ŋɩ lɩɩ sala tibi na.&gt;&gt;<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Sɛ Yesu tawɩ alʋ wʋŋ sɛ, &lt;&lt;Ganaŋkʋ nya lɩsɛ nʋɔ na dʋɔ, bɔrɛ ju dɩɛ, feliŋ sʋbʋ wʋŋ lɩɩ nbu galibie wʋŋ tɩba.&gt;&gt;<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Gʋ wʋ ju waa dʋɔ na, wʋ ga na wʋbu galibie wʋŋ duwei mpa dʋɔ, feliŋ sʋbʋ wʋŋ lɩɩ wʋ tɩba.<verse eid="MRK 7:30" /></para>
  <para style="s1">Yesu chɔ baalɛ wʋrʋ wʋ yɩɛ kpawu na namu</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Sɛ Yesu lɩɩ Tirosi tibi dʋɔ sɛ wʋ mʋna Sidoŋ tibi dʋɔ ju Galaliya lɩɩ nʋɔ gaa ga wɩɛ Dekapolisi<note caller="+" style="f"><char style="fr" closed="false">7:31 </char><char style="ft" closed="false">Dekapolisi tie nyɩnasɛ dɩɛsɛ gifi</char></note> tibi dʋɔ. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Dɩmaŋ sɛ bakpa barɛ mʋ baalɛ wʋrʋ wʋ yɩɛ kpawu bɛ sɛ wʋ yɩɛ namu kɔŋ Yesu jaŋ. Sɛ ba sʋlʋ Yesu sɛ wʋ n mʋ wʋ pam jaga baalɛ wʋŋ dʋɔ na wʋ a chɔ ɩ.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Sɛ Yesu mʋ baalɛ wʋŋ lɩɩ jama baa tɩba ju laraŋ. Sɛ wʋ mʋ wʋ pamɩɛ nyiŋbisi dʋ baalɛ wʋŋ dɩla naŋ. Sɛ wʋ tɔ mɩtalɩŋ jaga wʋ pam nyiŋbie dʋɔ sɛ wʋ mʋ tapʋ wʋ nʋɔ jʋlʋŋ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Yesu kɩɛ Ɩsʋɔ adugbe sɛ wʋ lɩɩ wuosi sala tɩba sɛ wʋ tawɩ baalɛ wʋŋ sɛ, <char style="tl">&lt;&lt;Efata&gt;&gt;</char> tie akala sɛ, &lt;&lt;fulu!&gt;&gt; <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Dɩmaŋ gana sɛ baalɛ wʋŋ dɩla fulu sɛ wʋ nʋɔ jʋlʋŋ buoli sɛ wʋ fara wʋ a tawɩ na dieli.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Yesu jɔ ba nyienaŋ sɛ ba n baa tawɩ wʋrʋ ŋii ŋɩ yɩɛ na. Ama gʋ wʋ jɔ ba nyienaŋ na, yela ba saŋ baa jɔ wɩɛ ŋii dʋɔ dawuta. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Sɛ dɩ yɩɛ bakpa baa kpiniŋ doba. Sɛ ba tawɩ sɛ, &lt;&lt;Wʋ yɩɛ bʋrʋkʋma gana na dieli. Wʋ yela sɛ akpawu gba a nyii wɩɛ sɛ anamu a tawɩ.&gt;&gt;<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">Yesu fa bakpa kɔrʋɔsɛ sɩ nara (4,000) adiya</para>
  <para style="r">
    <ref loc="MAT 15:32-39">Matiyo 15:32-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Dɩmʋŋ gɩyɩɛnɩŋ ŋina naŋ na bakpa fɔɩ kɔŋ Yesu jaŋ. Gʋ ba tana bʋrʋ na baa di dʋɔ, Yesu yagɛ wʋ kpalɛnara baa kɔŋ wʋ jaŋ sɛ wʋ tawɩ ba sɛ, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />&lt;&lt;Bakpa bana wɩɛ wɩɛ maŋ gɩyɔŋ, akala takɩɛ wɩɛ atoro mɩnaŋ gʋ ba wɩɛ ma jaŋ, sɛ ba n yu bʋrʋ di i. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Sɛ ma tii ba gbɩɛ sɛ ba mʋ dusoŋ bɔrɛ ju dɩɛ na, baa lɩɩ sala gbɩɛ naŋ, akala takɩɛ ba barɛ lɩɩ gbɩɛ taŋasɛ.&gt;&gt;<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Sɛ wʋ kpalɛnara baa tasɛ ɩ sɛ, &lt;&lt;Le sɛ wʋkpa aja yu adiya fɔɩ ifuli ŋina dʋɔ fa jama bana?&gt;&gt;<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Bodobodo aŋmaŋ sɛ ɩ wɩɛna?&gt;&gt; Sɛ ba lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Lɩkaarɛ.&gt;&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Sɛ Yesu tawɩ jama baa sɛ n cha tibi naŋ. Gʋ wʋ mʋ bodobodo lɩkaarɛ ŋii sɛ wʋ yɩlɩ Ɩsʋɔ taŋ na, wʋ jaɩ tɩba sɛ wʋ mʋ fa wʋ kpalɛnara baa sɛ ba n kpara fa jama baa. Sɛ ba yɩɛ dɩmʋŋ. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Na ba wɩɛna aji pii. Sɛ wʋ yɩlɩ Ɩsʋɔ sɛ wʋ mʋ fa ba sɛ ba n kpara fa jama baa. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Bakpa baa di sɛ ba pawʋ sɛ wʋ kpalɛnara baa kui ŋii ba di kakaa na gachaŋasɛ lɩkaarɛ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Bakpa baa ba di adiya ŋina na tɩba baala aja yɩɛ kɔrʋɔsɛ sɩ nara (4,000). Gʋ Yesu tii ba gbɩɛ taŋ na, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />wʋ na wʋ kpalɛnara baa jʋʋ buori naŋ ju Dalimanuta tibi dʋɔ.<verse eid="MRK 8:10" /></para>
  <para style="s1">Farasitina tasɛ Yesu adaŋgana</para>
  <para style="r">
    <ref loc="MAT 12:38-42">Matiyo 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Gʋ Yesu wɩɛ dɩmaŋ na, Farasitina barɛ kɔŋ wʋ jaŋ sɛ ba fara baa tasɛ ɩ wɩɛ. Gʋ baa ja baa yɩɛ ɩ lɔ tɩba dʋɔ, ba tawɩ ɩ sɛ wʋ n yela na adaŋgana a lɩɩ Ɩsʋɔ adugbe kɔŋ na ŋii kalaa sɛ wʋ yikuo lɩɩ Ɩsʋɔ jaŋ bɛ. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Sɛ Yesu lɩɩ wuosi sala tɩba sɛ wʋ tawɩ sɛ, &lt;&lt;Be dʋɔ sɛ dɩmʋŋ gɩnanaŋ ɩ ja daasɛ wɩɛ ɩ naa? Maa tawɩ sɛ n nyii na dieli sɛ daasɛ wɩɛ ŋarɛ taŋ ŋii lɩɩ adugbe kɔŋ fa amɩɛ ɛ.&gt;&gt; <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Sɛ Yesu yela ba dɩmaŋ sɛ wʋ jʋʋ buori naŋ sɛ wʋ tɩɛsɛ ju gatɩɛsa.<verse eid="MRK 8:13" /></para>
  <para style="s1">Farasitina na Hɛrɔdɩ yiisi</para>
  <para style="r">
    <ref loc="MAT 16:5-12">Matiyo 16:5-12</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Gʋ wʋ kpalɛnara baa tala gatɩɛsa na, dɩmaŋ sɛ ba nyiŋi gʋ ba n mʋ bodobodo o, amʋɔ bodobodo garɛ sɛ ba mʋ chaŋ buori gaa naŋ. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Sɛ Yesu jɔ ba nyienaŋ sɛ, &lt;&lt;N kɩɛ amɩɛ wʋsɛ dʋɔ na dieli lɩɩ Farasitina na Hɛrɔdɩ yiisi<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">Yiisi yɩɛ tii bɛ sɛ ba mʋ dʋ bodobodo mʋlʋŋ na sɛ ŋii yɩɛ gafʋʋ</char></note> dʋɔ.&gt;&gt;<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Sɛ wʋ kpalɛnara baa tawɩ ba nyiŋeŋ-nyiŋeŋ sɛ, &lt;&lt;Bodobodo gaa dɩ n mʋ na dʋɔ sɛ wʋ tawɩ dɩmʋŋ.&gt;&gt;<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Gʋ Yesu jiŋ wɩɛ ŋii baa tawɩ na, wʋ tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ tawɩ sɛ dɩ tana bodobodo? Ɩ saŋ ɩŋ na ta yaa ɩŋ nyii ta tie? Amɩɛ nfɩɛrɛ naŋ taŋ dɩkɩŋ bɛ? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Ɩ wɩɛna asa ama ɩ naa? Ɩ wɩɛna dɩla ama ɩ nyii i? Ɩ nyiŋi <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />bodobodo anʋŋ ŋii ma jaɩ fa bakpa kɔrʋɔsɛ sɩ nʋŋ (5,000) sɛ ba di kakaa na gachaŋasɛ aŋmaŋ sɛ ɩ kuiwu?&gt;&gt; Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Gifi ala.&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />Sɛ Yesu ti bɔrɛ tawɩ ba sɛ, &lt;&lt;Gʋ ma jaɩ bodobodo lɩkaarɛ ŋii fa bakpa kɔrʋɔsɛ sɩ nara (4,000) sɛ ba di kakaa na gachaŋasɛ aŋmaŋ sɛ ɩ kuiwu?&gt;&gt; Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;lɩkaarɛ.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Ɩ saŋ ɩŋ nyii ta tie?&gt;&gt;<verse eid="MRK 8:21" /></para>
  <para style="s1">Yesu chɔ ɔtaŋpʋ Betisayida dɩɛ naŋ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Gʋ Yesu na wʋ kpalɛnara baa tala Betisayida dɩɛ naŋ na, bakpa barɛ kɔna baalɛ ɔtaŋpʋ wʋrʋ Yesu jaŋ sɛ ba sʋlʋ ɩ sɛ wʋ n mʋ wʋ pam tapʋ ɩ na wʋ a chɔ ɩ. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesu chaŋ baalɛ ɔtaŋpʋ wʋŋ pam naŋ mʋ ɩ lɩɩ dɩɛ bie gaa naŋ. Wʋ tɔ mɩtalɩŋ dʋ ɔtaŋpʋ wʋŋ asanaŋ sɛ wʋ mʋ wʋ pam jaga wʋ dʋɔ, sɛ Yesu tasɛ ɩ sɛ, &lt;&lt;Nya na bʋrʋ garɛ?&gt;&gt;<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Sɛ wʋ jiŋna wʋ asa kɩɛ adugbe, sɛ wʋ tawɩ sɛ, &lt;&lt;Maa na bakpa takɩɛ dasɛ ba dɔŋ ba dɔŋ.&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Sɛ Yesu ti bɔrɛ mʋ wʋ pam tapʋ baalɛ wʋŋ asa sɛ ŋɩ fʋlʋ, sɛ wʋ a na bʋrʋkʋma na dieli. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Sɛ Yesu tii ɩ gbɩɛ sɛ wʋ n ju waa dʋɔ sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;N baa ti ju dɩɛ bie<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">Wɩɛ asabɩɛsa ŋii ŋarɛ wɩɛ &lt;&lt;M ba ti ju dɩɛ bie gaa naŋ ga tawɩ wʋrʋ.&gt;&gt;</char></note> gaa naŋ.&gt;&gt;<verse eid="MRK 8:26" /></para>
  <para style="s1">Petero kalaa wʋkpa wʋŋ Yesu yɩɛ na</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Sɛ Yesu na wʋ kpalɛnara baa lɩɩ Betisayida dɩɛ naŋ sɛ ba ju dɩɛsɛ bisi ŋii ŋɩ wɩɛ Kayisariya Filipi tibi dʋɔ. Gʋ ba ju na, wʋ tasɛ ba sɛ, &lt;&lt;Mmʋɔ sɛ bakpa a tawɩ sɛ ma yɩɛ?&gt;&gt;<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Ba lɩsɛ nʋɔ sɛ, &lt;&lt;Barɛ sɛ Yohane Ɩsʋɔ Sɔrɛ, barɛ sɛ Ɩsʋɔ ɔja Eliya, sɛ barɛ dʋɔ sɛ wʋ yɩɛ Ɩsʋɔ bajana baa tɩba wʋrʋ bɛ.&gt;&gt;<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Amɩɛ dʋɔ, Mmʋɔ sɛ ɩ sɛ ma yɩɛ?&gt;&gt; Sɛ Petero lɩsɛ nʋɔ sɛ, &lt;&lt;Nyaŋ n nyina Kirisito<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">Girikitina a yagɛ Kirisito sɛ Yudatina a yagɛ Mesaya</char></note> wʋŋ.&gt;&gt;<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Sɛ Yesu jɔ ba nyienaŋ sɛ, &lt;&lt;N ba tawɩ wʋkpa wʋŋ ma yɩɛ na fa wʋrʋ.&gt;&gt;<verse eid="MRK 8:30" /></para>
  <para style="s1">Yesu tawɩ wʋ awʋrʋfʋɔ na wʋ sɩŋ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 16:21-28">Matiyo 16:21-28</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Sɛ Yesu fara wʋ a tawɩ wʋ kpalɛnara baa sɛ, &lt;&lt;Ŋɩ tiri gʋ Wʋkpa Bu wʋŋ a na awʋrʋfʋɔ fɔɩ, na dɩɛ bɩnɩɛ, Ɩsʋɔ sei bɩnɩɛ na mbara bakalaasa a pɩɛ ɩ na baa kʋ ɩ, ama wɩɛ atoro wɩɩ na, wʋ a feŋ lɩɩ sɩŋ naŋ.&gt;&gt; <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Gʋ Yesu tawɩ fulu wɩɛ ŋii asa dʋɔ fa ba na, sɛ Petero yagɛ ɩ lɩɩ laraŋ sɛ wʋ tawɩ baŋ ɩ sɛ wʋ n baa tawɩ dɩmʋŋ.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Ama Yesu biliŋi kɩɛ wʋ kpalɛnara na, wʋ tawɩ baŋ Petero sɛ, &lt;&lt;Lɩɩ ma dʋɔ Sɩtanɩ! Akala takɩɛ wʋkpa nfɩɛrɛ sɛ nyaa faa, naa Ɩsʋɔ teri i.&gt;&gt;<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Sɛ Yesu yagɛ jama na wʋ kpalɛnara baa kɔŋ wʋ jaŋ. Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Wʋkʋma wʋŋ wʋ a ja sɛ wʋ a kpaŋ maŋ na, ŋɩ tiri gʋ wʋ a yela wʋ tɩŋtɩŋ wʋ jawʋ na wʋ a mʋ wʋ daŋ gasagasa na wʋ a kpaŋ maŋ. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Akala takɩɛ wʋkʋma wʋŋ wʋ a ja wʋ a yu nkpa fa wʋ wʋsɛ na, ŋii jɔ ɩ. Ama wʋkʋma wʋŋ wʋ nkpa jɔ ɩ lɩɩ maŋ na Ɩsʋɔ wɩɛ dʋɔ na, wʋ a yu nkpa. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Wʋkpa yu dulunya abʋrɩ kpiniŋ sɛ wʋ nkpa lɩɩ wʋ pam naŋ na, be sɛ wʋ a yu? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Yaa be sɛ wʋkpa a dɩlɛ mʋ chɩɛgɩna wʋ nkpa? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Wʋkʋma wʋŋ asaju chaŋ ɩ lɩɩ maŋ na ma wɩɛ dʋɔ gɩnanaŋ gana gɩ baa di gasiŋteŋ fa Ɩsʋɔ sɛ baa yɩɛ dɩsʋbʋ na, dɩmʋŋ sɛ asaju aja chaŋ Wʋkpa Bu wʋŋ fa wʋkpa wina saŋa gaa wʋ a bɔrɛ kɔŋ Wʋ juo jilima naŋ na Ɩsʋɔ gabʋɔsɛ dɩchɩrɩchɩrɩ na.&gt;&gt;<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Sɛ Yesu ju dʋɔ tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ, amɩɛ baa ɩ wɩɛ jɩna na barɛ baa na sɩŋ ŋ ga tala gʋ baa na Ɩsʋɔ Juori a kɔŋ doŋ naŋ.&gt;&gt;<verse eid="MRK 9:1" /></para>
  <para style="s1">Yesu wʋsɛ gori</para>
  <para style="r">
    <ref loc="MAT 17:1-13">Matiyo 17:1-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Wɩɩ lʋrʋ wʋrʋgbɩɛ na, Yesu mʋ Petero, Jamesi na Yohane sɛ wʋ na ba nyiŋeŋ ju bʋrɔŋ jalɩŋtɛ garɛ dʋɔ. Dɩmaŋ sɛ ba na gʋ Yesu wʋsɛ gori ba asa dʋɔ. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Sɛ wʋ gagba ŋalagi fʋlʋŋsɛ parɛ-parɛ kii gʋ wʋrʋ a dɩlɛ yalɛ dukuru tibi gana dʋɔ na gaa yɩɛ dɩmʋŋ. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Dɩmaŋ sɛ ba na gʋ Ɩsʋɔ ɔja Eliya na Mosesi na Yesu a tawɩ.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Sɛ Petero tawɩ Yesu sɛ, &lt;&lt;Wʋkalaasa, ŋɩ wɩɛ dieli gʋ dɩ wɩɛ jɩna. Yela na dɩ baŋ akoneŋ atoro, n teri garɛ, Mosesi teri garɛ na Ɩsʋɔ ɔja Eliya gba teri garɛ.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Ŋii ŋɩ tibi na dʋɔ, nyɩŋtɩɛ chaŋ Petero na wʋ dɔŋa baa dɩmʋŋ dʋɔ sɛ wʋ tawɩ dɩmʋŋ.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Dɩmaŋ sɛ Ɩsʋɔ tanɛ fu ba dʋɔ. Sɛ lofu garɛ lɩɩ Ɩsʋɔ tanɛ gaa naŋ kɔŋ sɛ, &lt;&lt;Wina n nyina mabu wʋŋ maa ja wʋ wɩɛ. N nyii wʋ jaŋ.&gt;&gt;<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Gʋ wʋ kpalɛnara batoro baa kɩɛ logo na, ba n na wʋrʋ ʋ, amʋɔ Yesu nyiŋeŋ.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Gʋ ba tibi bʋrɔŋ gaa baa kɔnɛ na, Yesu dʋ ba sɛ ba n baa tawɩ ŋii ba na na fa wʋrʋ ga tala gʋ Wʋkpa Bu wʋŋ aja feŋ lɩɩ sɩŋ naŋ. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Dɩmʋŋ dʋɔ ba mʋ wɩɛ ŋii dʋ ba nyienaŋ, sɛ ba tasɛ dɔŋa sɛ, &lt;&lt;Feŋ lɩɩ sɩŋ naŋ tie akala sɩnɛ?&gt;&gt;<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Sɛ ba tasɛ Yesu sɛ, &lt;&lt;Be dʋɔ sɛ mbara bakalaasa baa tawɩ sɛ ŋɩ tiri gʋ Ɩsʋɔ ɔja Eliya n chɩŋkpɩɛ kɔŋ pɔɩ?&gt;&gt;<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Yɩɛ gasiŋteŋ bɛ, ŋɩ tiri gʋ Eliya n chɩŋkpɩɛ kɔŋ na wʋ a gaa desina bʋrʋkʋma si ga gbɩɛ dʋɔ. Ama be dʋɔ sɛ ba sabɩɛ Sabɩɛwɩɛ naŋ sɛ, Wʋkpa Bu wʋŋ aja na awʋrʋfʋɔ fɔɩ na baa pɩɛ ɩ? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ama maa tawɩ amɩɛ sɛ Eliya taŋ kɔnɛ sɛ bakpa yɩɛ ɩ ŋii baa jawʋ ganaŋkʋ ba sabɩɛ wʋ wʋsɛ dʋɔ wɩɛ dʋ Ɩsʋɔ Wɩɛ naŋ na.&gt;&gt;<verse eid="MRK 9:13" /></para>
  <para style="s1">Yesu gɩŋ feliŋ sʋbʋ lɩɩ bu baalɛ wʋrʋ tɩba</para>
  <para style="r">
    <ref loc="MAT 17:14-21">Matiyo 17:14-21</ref>; <ref loc="LUK 9:37-45">Luka 9:37-45</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Gʋ Yesu na wʋ kpalɛnara batoro baa tibi bʋrɔŋ baa kɔŋ kpalɛnara ba baŋbaŋ baa jaŋ na, ba na jama logo ba, yela ba na mbara bakalaasa baa barɛ a di noro. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Gʋ bakpa baa na Yesu na, dɩ yɩɛ ba doba sɛ ba se ju wʋ jaŋ ga yɩlɩ ɩ.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Sɛ Yesu tasɛ wʋ kpalɛnara baa sɛ, &lt;&lt;Be bʋrʋ dʋɔ sɛ amɩɛ na ba ɩ di noro?&gt;&gt;<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Sɛ jama baa tɩba wʋrʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Wʋkalaasa, ma mʋ mabu baalɛ jaŋ wʋŋ feliŋ sʋbʋ chaɩ wʋ tɩba sɛ dɩ yela sɛ wʋ aa dɩlɛ wʋ aa tawɩ na kɔŋ sɛ nyaŋ chɔ ɩ. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Saŋa kʋma gaa feliŋ sʋbʋ wʋŋ jigisi wʋ wʋsɛ na, a kara ɩ lɔ, yela afʋfʋ a lɩɩ wʋ nʋɔ naŋ, yela wʋ a tawʋ wʋ kela naŋ sɛ wʋ wʋsɛ a kem. Ma sʋlʋ nya kpalɛnara baa sɛ ba n geŋ feliŋ sʋbʋ wʋŋ lɩɩ wʋ tɩba, ama ba n dɩlɛ ɛ.&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;O, amɩɛ gɩnanaŋ baa ɩɩ lɩɛ ɩ di i. Mʋ ga tala wɩɛ aŋmaŋ sɛ maŋ na amɩɛ dɩ n cha? Mʋ ga tala wɩɛ aŋmaŋ sɛ ma n yu digela fa amɩɛ? N mʋ yeleŋbu wʋŋ kɔna maŋ.&gt;&gt;<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />Sɛ ba mʋ yeleŋbu wʋŋ kɔna Yesu. Gʋ feliŋ sʋbʋ wʋŋ na Yesu na sɛ dɩgbɩŋgbɩŋ chaŋ ɩ, gabʋanaŋ sɛ dɩ kara ɩ lɔ tibi, wʋ a fiti yela wʋ a gbiliti, yela wʋ nʋɔ naŋ a lɩɩ afʋfʋʋ.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Sɛ Yesu tasɛ wʋ juo sɛ, &lt;&lt;A yɩɛ ɩ dɩmʋŋ na dɩ taŋgɩlɛ?&gt;&gt; Sɛ wʋ juo wʋŋ lɩsɛ nʋɔ sɛ, &lt;&lt;Lɩɩ wʋ gɩ chasɩtɩɛ.&gt;&gt;<verse eid="MRK 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 9:22" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Ŋii dɩlɛ ŋii kara ɩ ŋii lɔ bʋala naŋ yaa lɩŋ naŋ na ŋii kʋ ɩ. Nyaa dɩlɛ na, wɩɩ daa gɩyɔŋ na nyaa chɔna daa.&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Sɛ Yesu tasɛ ɩ sɛ, &lt;&lt;Be n yɩɛ dʋɔ sɛ nya tawɩ sɛ maa dɩlɛ naa? Ɩsʋɔ a dɩlɛ yɩɛ bʋrʋkʋma fa wʋŋ wʋ lɩɛ di na.&gt;&gt;<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Gabʋanaŋ sɛ wʋchaa bu baalɛ wʋŋ wʋ juo kuusi tawɩ sɛ, &lt;&lt;Ma lɩɛ di, chɔna maŋ na nyaa suri ma lɩɛ di dʋɔ.&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Gʋ Yesu na bakpa sebie ɩ baa kɔŋ dɩmaŋ na, wʋ fʋba feliŋ sʋbʋ wʋŋ dʋɔ sɛ, &lt;&lt;Nyaŋ feliŋ sʋbʋ wʋŋ wʋ yɩɛ kpawu na namu, maa tawɩ nyaŋ sɛ lɩɩ wʋchaa bu baalɛ wʋŋ tɩba, n baa ti bɔrɛ kɔŋ gaa jʋʋ wʋ tɩba.&gt;&gt;<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Sɛ feliŋ sʋbʋ wʋŋ kuusi sɛ dɩ kara wʋchaa bu baalɛ wʋŋ lɔ sɛ wʋ lɩɩ wʋ tɩba. Sɛ wʋ dʋɔ wʋ duwei takɩɛ atatɛ na sɛ wʋkʋma sɛ, &lt;&lt;Wʋ sɩŋ.&gt;&gt; <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Ama Yesu chaŋ wʋchaa bu baalɛ wʋŋ pam naŋ sɛ wʋ chɔna ɩ sɛ wʋ kʋlʋ sɩŋ.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Ŋina wʋrʋ gbɩɛ na, Yesu na wʋ kpalɛnara baa nyiŋeŋ bɔrɛ ju dɩɛ, sɛ ba tasɛ ɩ sɛ, &lt;&lt;Be n yɩɛ sɛ dɩ n dɩlɛ geŋ feliŋ sʋbʋ wʋŋ lɩɩ wʋ tɩba?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Amʋɔ dɩga<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Ɩsʋɔ Wɩɛ ŋii ŋarɛ wɩɛna dɩga na nʋɔ pɔgʋ</char></note> fa Ɩsʋɔ nyiŋeŋ aaŋ dɩlɛ geŋ dɩmʋŋ feliŋ sʋbʋ wina.&gt;&gt;<verse eid="MRK 9:29" /></para>
  <para style="s1">Yesu ti tawɩ wʋ sɩŋ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 17:22-23">Matiyo 17:22-23</ref>; <ref loc="LUK 9:43-45">Luka 9:43-45</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Ŋina wʋrʋgbɩɛ na, Yesu na wʋ kpalɛnara baa lɩɩ dɩmaŋ sɛ ba mʋna Galaliya tibi dʋɔ. Yesu baa ja na wʋrʋ a jiŋ diele gaa ba wɩɛ na a, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />akala takɩɛ wʋ a kalaa wʋ kpalɛnara baa. Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Baa lɩsɛ Wʋkpa Bu wʋŋ fa bakpa na baa kʋ ɩ. Ama wɩɛ atoro wɩɩ na, wʋ a feŋ lɩɩ sɩŋ naŋ.&gt;&gt; <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Wʋ kpalɛnara baa n nyii wɩɛ ŋii wʋ a tawɩ na tie e, ama wɩɛ ba nyɩŋtɩɛ na baa tasɛ ɩ wɩɛ ŋii tie.<verse eid="MRK 9:32" /></para>
  <para style="s1">Mmʋɔ n nyina wʋjaŋ-janɛ Ɩsʋɔ juori naŋ?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">Matiyo 18:1-5</ref>; <ref loc="LUK 9:46-48">Luka 9:46-48</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Yesu na wʋ kpalɛnara ju Kapeniyum dɩɛ naŋ. Gʋ ba wɩɛ waa dʋɔ na, wʋ tasɛ ba sɛ, &lt;&lt;Be bʋrʋ dʋɔ noro sɛ ɩ di gbɩɛ naŋ na?&gt;&gt; <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Ama ba fu ba nʋɔ dʋɔ, akala takɩɛ ba di dɔŋa noro gbɩɛ naŋ sɛ Mmʋɔ n nyina wʋjaŋ-janɛ.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Gʋ Yesu cha na, wʋ yagɛ wʋ kpirida gifi bala baa kɔŋ wʋ jaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;Wʋkʋma wʋŋ wʋ a ja sɛ wʋ a yɩɛ asanaŋtɛ amɩɛ tɩba na, ŋɩ tiri gʋ wʋ n yɩɛ wʋrʋgbɩɛtɛ na wʋ a yɩɛ amɩɛ kpiniŋ tʋmɩrɛ.&gt;&gt;<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Sɛ Yesu mʋ wʋchaa pii wʋrʋ gaa sɩŋ ba asanaŋ. Sɛ wʋ mʋ wʋ pamɩɛ jaga wʋ dʋɔ sɛ wʋ tawɩ ba sɛ, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />&lt;&lt;Wʋkʋma wʋŋ wʋ lɩɛ wʋchaa n na duluŋ ma yɩrɛ naŋ na, maŋ sɛ wʋ lɩɛ. Wʋkʋma wʋŋ wʋ lɩɛ maŋ na, naa ma nyiŋeŋ sɛ wʋ lɩɛ ɛ, ama wʋ lɩɛ wʋŋ wʋ kpiri maŋ na gba.&gt;&gt;<verse eid="MRK 9:37" /></para>
  <para style="s1">Wʋŋ wʋ aa yuo daa na wʋ kpi daa dʋɔ</para>
  <para style="r">
    <ref loc="LUK 9:49-50">Luka 9:49-50</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Sɛ Yohane tawɩ Yesu sɛ, &lt;&lt;Wʋkalaasa, dɩ na baalɛ wʋrʋ wʋ mʋ n yɩrɛ wʋ a geŋ feliŋ sʋbʋ wʋ a lɩɩ bakpa tɩba sɛ dɩ tawɩ ɩ sɛ wʋ n yela, akala takɩɛ wʋ n kpi daa dʋɔ ɔ.&gt;&gt;<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N baa tawɩ ɩ sɛ wʋ n yela. Wʋkpa kʋma wʋŋ wʋ chamɩna ma yɩrɛ wʋ a yɩɛ adaŋgana na, wʋ aa dɩlɛ tawɩ wɩɛ asʋbʋɛ lɩɩ ma dʋɔ ɔ. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Akala takɩɛ wʋkʋma wʋŋ wʋ aa yuo daa na wʋ kpi daa dʋɔ. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Maa tawɩ sɛ n nyii na dieli sɛ, wʋkʋma wʋŋ wʋ fa amɩɛ lɩŋ na gafie ma yɩrɛ naŋ, akala takɩɛ ɩ yɩɛ ma tʋmɩra na, Ɩsʋɔ aja fa ɩ ŋɩ dʋɔ kɩmtʋɔ.&gt;&gt;<verse eid="MRK 9:41" /></para>
  <para style="s1">Lɔ tɩba ŋii ŋii kɔna dɩsʋbʋ</para>
  <para style="r">
    <ref loc="MAT 18:6-9">Matiyo 18:6-9</ref>; <ref loc="LUK 17:1-2">Luka 17:1-2</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Wʋkʋma wʋŋ wʋ a yela na bachaasɛ buruburu baa ba lɩɛ maŋ di na tɩba wʋrʋ a yɩɛ dɩsʋbʋ na, ŋɩ wɩɛ dieli fa ɩ takɩɛ gʋ ba mʋ bʋɩ ganamsa janɛ pɔgʋ wʋ lafu tie, na baa lɔ ɩ dʋ ɔpʋ naŋ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Sɛ n pam aja yela na nyaa yɩɛ dɩsʋbʋ na, kara tʋsʋ. Ŋɩ wɩɛ dieli fa nyaŋ takɩɛ nyaa mʋ pam garɛ ju nkpa ŋii ŋɩ taŋ gɩtɛ naŋ kii gʋ nya mʋ pamɩɛ ala ju awʋrʋfʋɔ bʋala naŋ, dɩmaŋ sɛ bʋala baa dum m. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Dɩmaŋ sɛ ba sieliesi baa sɩŋ ŋ, sɛ bʋala baa dum m.<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">Na Ɩsʋɔ Wɩɛ ŋii kpiniŋ n wɩɛna dɩmʋŋ</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Sɛ n nafarɛ aja yela na nyaa yɩɛ dɩsʋbʋ na, kara tʋsʋ. Ŋɩ wɩɛ dieli fa nyaŋ takɩɛ nya mʋ nafarɛ garɛ ju nkpa ŋii ŋɩ taŋ gɩtɛ naŋ kii gʋ nya mʋ nafara ala ju awʋrʋfʋɔ bʋala naŋ, dɩmaŋ sɛ bʋala baa dum m. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Dɩmaŋ sɛ ba sieliesi baa sɩŋ ŋ, sɛ bʋala baa dum m.<note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="ft" closed="false">Na Ɩsʋɔ Wɩɛ ŋii kpiniŋ n wɩɛna dɩmʋŋ</char></note> <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Sɛ n dɩsɛ aja yela na nyaa yɩɛ dɩsʋbʋ na, chɔla ga tʋsʋ. Ŋɩ wɩɛ dieli fa nyaŋ takɩɛ nyaa mʋ dɩsɛ garɛ ju Ɩsʋɔ Juori naŋ kii gʋ nya mʋ asa ala ju awʋrʋfʋɔ bʋala naŋ. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Dɩmaŋ sɛ</para>
  <para style="q1" vid="MRK 9:48">&lt;&lt;&lt;Ba sieliesi baa sɩŋ ŋ,</para>
  <para style="q2" vid="MRK 9:48">sɛ bʋala baa dum m.&gt;<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Yis 66:24</ref>.</char></note><verse eid="MRK 9:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49" />Baa mʋ bʋala yɩɛ wʋkʋma dɩchɩrɩchɩrɩ takɩɛ ganaŋkʋ baa mʋ yasɛ baa yɩɛ gadiesa chɩrɩchɩrɩ na. <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />Yasɛ wɩɛ dieli, ama ŋɩ tʋsʋ ŋɩ jʋŋ lɩɩ ŋɩ tɩba na, sɩnɛ sɛ ɩ yɩɛ ŋɛ na ŋii tii yɩɛ jʋŋ? Dɩmʋŋ dʋɔ n yela na amɩɛ ayɩɛsa a yɩɛ jʋŋ takɩɛ yasɛ na ɩ cha wʋsɛfɩɛ naŋ.&gt;&gt;<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">Yesu kalaa sarɛ yela dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 19:1-12">Matiyo 19:1-12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Gʋ Yesu lɩɩ Kapeniyum dɩɛ naŋ na, wʋ tɩɛsɛ Yodaŋ buo ju Yudiya tibi dʋɔ Yodaŋ gatɩɛsa. Sɛ jama baa kɔŋ wʋ jaŋ sɛ wʋ kalaa ba Ɩsʋɔ wɩɛ ganaŋkʋ wʋ ayɩɛsa kɩɛna na.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Sɛ Farasitina barɛ baa baa ja baa yɩɛ ɩ lɔ tɩba na kɔŋ wʋ jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Daa mbara fa gbɩɛ sɛ baalɛ n yela wʋ alʋ?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Sɛ Yesu dʋɔ tasɛ ba sɛ, &lt;&lt;Be mbara sɛ Mosesi dʋ amɩɛ?&gt;&gt;<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Sɛ Farasitina baa lɩsɛ nʋɔ sɛ, &lt;&lt;Mosesi fa gbɩɛ sɛ baalɛ n sabɩɛ tanɛ fa wʋ alʋ na gaa kalaa gʋ wʋ yela ɩ sarɛ pɔɩ na wʋ a yela ɩ.&gt;&gt;<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesu tawɩ ba sɛ, &lt;&lt;Amɩɛ agela doŋ dʋɔ sɛ Mosesi sabɩɛ dɩmʋŋ mbara ŋina fa amɩɛ. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Ama lɩɩ dulunya dɩfaratɩŋ sɛ, &lt;Ɩsʋɔ lɔ ba, baalɛ na alʋ.&gt;<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Jene 1:27</ref>.</char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Ŋina dʋɔ, baalɛ aja yela wʋjuo na wʋnaa na wʋ na wʋ alʋ baa ga cha bʋga <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />na baa bala baa yɩɛ wʋsɛ tanɛ gadʋŋdʋlʋŋ.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Jene 2:24</ref>.</char></note> Dɩmʋŋ dʋɔ ba ba ti yɩɛ bakpa bala a, ama wʋdʋŋdʋlʋŋ. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Ŋina dʋɔ, ŋii Ɩsʋɔ bʋga na, wʋrʋ n baa kpara tɩba.&gt;&gt;<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Gʋ ba bɔrɛ kɔŋ waa dʋɔ na, wʋ kpalɛnara baa tasɛ ɩ sarɛ yela dʋɔ wɩɛ. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Baalɛ kʋma wʋŋ wʋ yela wʋ a alʋ sɛ wʋ ga saa alʋ fɔlɛ na, wʋ yɩɛ alʋ wʋrʋgbɩɛ lɩɩ. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Dɩmʋŋ gba sɛ alʋ wʋŋ wʋ yela wʋ baalɛ sɛ wʋ ga saa baalɛ wʋ fɔlɛ na, wʋ yɩɛ baalɛ wʋrʋgbɩɛ lɩɩ.&gt;&gt;<verse eid="MRK 10:12" /></para>
  <para style="s1">Yesu yɩɛ bachaasɛ bisi kusee</para>
  <para style="r">
    <ref loc="MAT 19:13-15">Matiyo 19:13-15</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Bakpa barɛ mʋ bachaasɛ bisi kɔŋ Yesu jaŋ sɛ wʋ n mʋ wʋ pam jaga ba dʋɔ ama wʋ kpalɛnara baa gɩŋ ba. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Gʋ Yesu na ŋina na, wʋ kara biŋbira. Sɛ wʋ tawɩ ba sɛ, &lt;&lt;N yela na bachaasɛ bisi baa a kɔŋ ma jaŋ, ama n baa gaa ba gbɩɛ. Akala takɩɛ Ɩsʋɔ juori gaa yɩɛ baa ba kɩɛna dɩmʋŋ na teri bɛ. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Maa tawɩ sɛ n nyii na dieli sɛ, wʋkʋma wʋŋ wʋ n lɩɛ Ɩsʋɔ Juori di takɩɛ wʋchaa pii na, wʋ aa dɩlɛ jʋʋ ʋ.&gt;&gt; <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Sɛ Yesu mʋ wʋ pam jaga-jaga bachaasɛ bisi baa dʋɔ garɛ-garɛ sɛ wʋ yɩɛ ba kusee.<verse eid="MRK 10:16" /></para>
  <para style="s1">Baalɛ akpaŋtatɛ wʋrʋ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 19:16-30">Matiyo 19:16-30</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Gʋ Yesu na wʋ kpalɛnara baa chaŋ gbɩɛ baa ju na, baalɛ wʋrʋ se ga luuŋ wʋ dʋna dʋɔ wʋ asanaŋ tawɩ sɛ, &lt;&lt;Wʋkalaasa wʋbam, be n tiri gʋ ma n yɩɛ na maa yu nkpa ŋii ŋɩ taŋ gɩtɛ?&gt;&gt;<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Be n yɩɛ sɛ nyaa yagɛ maŋ sɛ wʋbam? Wʋrʋ taŋ wʋ yɩɛ wʋbam m, amʋɔ Ɩsʋɔ nyiŋeŋ. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />N jiŋ Ɩsʋɔ mbara ŋii ŋii kalaa sɛ n baa tagapʋ, n baa yɩɛ baalɛ wʋrʋgbɩɛ lɩɩ yaa alʋ wʋrʋgbɩɛ lɩɩ, n baa ŋmɩɛlɛ, n baa di akarɩɛ seriya, n baa sisi wʋrʋ, na nyaa bu njuo na nnaa<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="DEU 5:16-20">Ditiro 5:16-20</ref>.</char></note>.&gt;&gt;<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Sɛ baalɛ wʋŋ tawɩ Yesu sɛ, &lt;&lt;Wʋkalaasa, lɩɩ ma gɩchasɩtɩɛ sɛ ma kpaŋ mbara wɩɛ ŋina kpiniŋ dʋɔ.&gt;&gt;<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Sɛ Yesu kɩɛ ɩ, sɛ wʋ ja wʋ wɩɛ. Sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Dɩkaka nyaŋ bʋrʋ darɛ. Ju ga yaa bʋrʋkʋma gaa nya wɩɛna, na nyaa mʋ aterembie ŋii ga fa ayɔŋtina, nyaa yu akpaŋta Ɩsʋɔ adugbe. Na nyaa gaa kpaŋ maŋ.&gt;&gt;<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Ama baalɛ wʋŋ nyii wɩɛ ŋina na, dɩ n yɩɛ ɩ jʋŋ ŋ, akala takɩɛ wʋ wɩɛna akpaŋta fɔɩ.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Sɛ Yesu kɩɛ logo wʋ kpalɛnara baa sɛ wʋ tawɩ ba sɛ, &lt;&lt;Aja yɩɛ doŋ fa akpaŋtatina na baa jʋʋ Ɩsʋɔ Juori gaa naŋ.&gt;&gt;<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Sɛ wɩɛ ŋii yɩɛ Yesu kpalɛnara baa doba. Ama Yesu ti bɔrɛ tawɩ sɛ, &lt;&lt;Mabie, aja yɩɛ doŋ fa wʋkpa na wʋ a jʋʋ Ɩsʋɔ Juori gaa naŋ. <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Aja fʋ fa nyɔma na wʋ a mʋna dɩkparɛ bʋɔ naŋ, ama aja yɩɛ wiliŋ fa akpaŋtatɛ na wʋ a jʋʋ Ɩsʋɔ Juori gaa naŋ.&gt;&gt;<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Gʋ Yesu kpalɛnara baa nyii wɩɛ ŋii na, dɩ yɩɛ ba doba ga laŋ. Sɛ ba tasɛ dɔŋa sɛ, &lt;&lt;Dɩmʋŋ bɩrɛ Mmʋɔ sɛ baa mɔlɔgɩ?&gt;&gt;<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesu kɩɛ ba sɛ wʋ tawɩ sɛ, &lt;&lt;Wʋkpa jaŋ bɩrɛ, ŋina baa dɩlɛ yɩɛ ɛ, ama Ɩsʋɔ jaŋ bɩrɛ, ŋina a dɩlɛ yɩɛ. Ɩsʋɔ a dɩlɛ yɩɛ bʋrʋkʋma.&gt;&gt;<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Sɛ Petero tawɩ Yesu sɛ, &lt;&lt;Dɩ yela bʋrʋkʋma gaa kpaŋ nyaŋ.&gt;&gt;<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ wʋkʋma wʋŋ wʋ a yela wʋ waa yaa wʋ ŋmɩɛtina yaa wʋ diesina, wʋjuo yaa wʋnaa yaa wʋbie yaa wʋ fʋɔ maŋ na Ɩsʋɔ Wɩɛ Abama ŋii dʋɔ na, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />wʋ a yu ŋɩ dʋɔ kɩmtʋɔ. Wʋ a yu waasɛ, nabie, diesina, naa aba, bie na fʋɔsɛ gafisi-gafisi dʋɔ saŋa gana dulunya naŋ na baa nyala ɩ. Wʋrʋgbɩɛ na, wʋ a ti yu nkpa ŋii ŋɩ taŋ gɩtɛ dulunya gaa gaa kɔŋ na naŋ. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Ama fɔɩ baa ba yɩɛ asanaŋtina na aja yɩɛ wʋrʋgbɩɛtina na wʋrʋgbɩɛtina a yɩɛ asanaŋtina.&gt;&gt;<verse eid="MRK 10:31" /></para>
  <para style="s1">Yesu tawɩ wʋ sɩŋ wɩɛ gbɩɛta butoro tɛ</para>
  <para style="r">
    <ref loc="MAT 20:17-19">Matiyo 20:17-19</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Yesu na wʋ kpalɛnara baa ju dʋɔ baa ju Yerusalem dɩɛ naŋ, Yesu dɔŋ ba asanaŋ. Sɛ dɩ yɩɛ wʋ kpalɛnara baa doba sɛ nyɩŋtɩɛ chaŋ baa ba kpamɩna ɩ na. Sɛ Yesu ti bɔrɛ mʋ wʋ kpirida gifi bala baa lɩɩ laraŋ sɛ wʋ tawɩ ba bʋrʋ gaa gaa tibi wʋ dʋɔ na. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;N nyii, dɩɩ ju Yerusalem dɩɛ naŋ, dɩmaŋ sɛ baa lɩsɛ Wʋkpa Bu wʋŋ fa Ɩsʋɔ sei bɩnɩɛ na Mosesi mbara bakalaasa baa na baa fu ɩ dɩpʋɛ sɛ ba n kʋ ɩ na baa mʋ ɩ fa baa ba ba yɩɛ Yudatina, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />baa jabi ɩ, tɔ mɩtalɩŋ fu ɩ, ta ɩ achʋchʋɛ na baa kʋ ɩ. Wɩɛ atoro wɩɩ na, wʋ a feŋ lɩɩ sɩŋ naŋ.&gt;&gt;<verse eid="MRK 10:34" /></para>
  <para style="s1">Yakubu na Yohane ba sʋlʋ Yesu bʋrʋ garɛ</para>
  <para style="r">
    <ref loc="MAT 20:20-28">Matiyo 20:20-28</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Sɛ Jamesi na Yohane Sebedi bie baa kɔŋ Yesu jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Wʋkalaasa, dɩ ja sɛ bʋrʋkʋma gaa dɩ tasɛ nyaŋ na, nyaa yɩɛ fa daa.&gt;&gt;<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Be sɛ ɩ ja sɛ maa yɩɛ fa amɩɛ?&gt;&gt;<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Nya cha n jilima juorigbeli gaa dʋɔ na, yela na daa wʋrʋ a cha n jɩsaŋ dʋɔ na wʋrʋ a cha n nambi dʋɔ.&gt;&gt;<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Ɩ ba jiŋ ŋii ɩ tasɛ na a. Ɩ dɩlɛ na awʋrʋfʋɔ ŋii maa naa? Ɩ dɩlɛ sɔ yuewu sɔ ŋii baa mʋ sɔ maŋ naa?&gt;&gt;<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;ɛɛŋ, dɩ dɩlɛ.&gt;&gt; Sɛ Yesu tawɩ ba sɛ ɩ dɩlɛ na awʋrʋfʋɔ ŋii maa na, na ɩ sɔ yowu sɔ ŋii baa mʋ sɔ maŋ na. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Ama naa maŋ aaŋ ja maa yela na ɩ cha ma jɩsaŋ dʋɔ yaa ma nambi dʋɔ ɔ. Dɩchatɩŋ gana bɩrɛ, ga yɩɛ baa Ɩsʋɔ desina ba si na teri bɛ.<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Gʋ kpirida gifi baa ba kakaa na nyii wɩɛ ŋina na, ba kara biŋbira dʋ Yakobo na wʋ nabu Yohane. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Dɩmaŋ sɛ Yesu yagɛ wʋ kpalɛnara baa kpiniŋ kɔŋ gaa sila wʋ jaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;Ɩ jiŋ gʋ baa ba ba yɩɛ Yudatina na juoneŋ a mʋ yikuo bɛ baa di ba bakpa dʋɔ, sɛ ba bɩnɩɛ gba a mʋ yikuo baa di ba bakpa dʋɔ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ama amɩɛ bɩrɛ, n baa yɩɛ takɩɛ ba. Wʋkʋma wʋŋ wʋ a ja sɛ wʋ a yɩɛ wʋjanɛ amɩɛ tɩba na, ŋɩ tiri gʋ wʋ a yɩɛ amɩɛ tɩba tʋmɩrɛ, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />sɛ wʋkʋma wʋŋ wʋ a ja sɛ wʋ a yɩɛ asanaŋtɛ na, ŋɩ tiri gʋ wʋ a yɩɛ amɩɛ kpiniŋ tɩba tʋmɩrɛ. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Akala takɩɛ Wʋkpa Bu wʋŋ, n kɔŋ sɛ ba n tʋm ɩ. Ama wʋ gaa tʋm, sɛ wʋ mʋ wʋ nkpa tɔ kɩm lɩɛ bakpa fɔɩ nkpa.&gt;&gt;<verse eid="MRK 10:45" /></para>
  <para style="s1">Yesu fulu ɔtaŋpʋ Batimiyosi asa</para>
  <para style="r">
    <ref loc="MAT 20:29-34">Matiyo 20:29-34</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Sɛ Yesu na wʋ kpalɛnara baa ju Yeriko dɩɛ naŋ. Gʋ ba na jama baa a lɩɩ dɩɛ janɛ gaa naŋ na, ɔtaŋpʋ wʋŋ baa yagɛ ɩ sɛ Batimiyosi wʋŋ wʋ juo yɩɛ Timiyosi, cha wʋ chaɩ gbɩɛ laraŋ wʋ a sʋlʋ. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Gʋ wʋ nyii sɛ Yesu Nasarati wʋkpa wʋŋ a lam na, wʋ kuusi tawɩ sɛ, &lt;&lt;Yesu, Juo Dawidi ganana bie, wɩɩ ma gɩyɔŋ.&gt;&gt;<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Sɛ bakpa baa barɛ tawɩ ɩ sɛ fu n nʋɔ dʋɔ. Ama wʋ ju dʋɔ kuusi na doŋ sɛ, &lt;&lt;Juo Dawidi ganana bie, wɩɩ ma gɩyɔŋ.&gt;&gt;<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Sɛ Yesu dʋɔsɩŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;N yagɛ ɩ fa maŋ.&gt;&gt; Sɛ ba yagɛ ɩ tawɩ ɩ sɛ, &lt;&lt;Yela n digela a fɩɛ nyaŋ, kʋlʋ, Yesu a yagɛ nyaŋ.&gt;&gt;<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Sɛ ɔtaŋpʋ wʋŋ lɩsɛ wʋ adugbe gagba tʋsʋ, sɛ wʋ puli sɛ wʋ kɔŋ Yesu jaŋ.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Sɛ Yesu tasɛ ɩ sɛ, &lt;&lt;Be sɛ nyaa ja sɛ maa yɩɛ fa nyaŋ?&gt;&gt; Sɛ ɔtaŋpʋ wʋŋ lɩsɛ nʋɔ sɛ, &lt;&lt;Wʋkalaasa, maa ja sɛ maa na.&gt;&gt;<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Pala, n lɩɛdi chɔ nyaŋ.&gt;&gt; Gabʋanaŋ sɛ wʋ asa fulu sɛ wʋ kpaŋ Yesu laŋ.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">Yesu jʋʋ Yerusalem takɩɛ Juo</para>
  <para style="r">
    <ref loc="MAT 21:1-11">Matiyo 21:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Gʋ Yesu na wʋ kpalɛnara baa a ju sɛ ba tirina Yerusalem dɩɛ na, gʋ ba tala Betifage na Betaniya dɩɛsɛ bisi ŋii ŋɩ wɩɛ olifi dasɛ bʋrɔŋ bie gaa dʋɔ na sɛ Yesu kpiri wʋ kpalɛnara baa tɩba bala, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />sɛ wʋ tawɩ ba sɛ, &lt;&lt;N ju dɩɛ bie gaa ga wɩɛ amɩɛ asanaŋ na naŋ. Gʋ ɩ jʋʋ na, ɩ na kpaŋa bie wʋŋ wʋrʋ n cha ta wʋ dʋɔ na pɔgaɩ, n buoli ɩ kɔna maŋ. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Wʋkʋma wʋŋ wʋ tasɛ amɩɛ sɛ, &lt;Be sɛ ɩ yɩɛ na?&gt; N tawɩ ɩ sɛ Kpaŋjuo wʋŋ n tiri ɩ, ama wʋ a bɔsɩna ɩ kɔŋ.&gt;&gt;<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Gʋ ba ga talɛ na, ba na kpaŋa bie wʋŋ pɔga ɩ buonɔ. Gʋ baa buoli ɩ na, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />sɛ bakpa barɛ baa ba sɩmɩɛɩ dɩmaŋ na tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ buoli kpaŋa bie wʋŋ?&gt;&gt; <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Sɛ ba lɩsɛ nʋɔ ganaŋkʋ Yesu tawɩ ba na, sɛ ba yela ba sɛ ba mʋ kpaŋa bie wʋŋ laŋ. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Gʋ ba mʋ kpaŋa bie wʋŋ kɔna Yesu na, ba mʋ ba adugbe gagbasɛ jaga wʋ dʋɔ sɛ Yesu cha ŋɛ dʋɔ. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Sɛ bakpa fɔɩ mʋ ba adugbe gagbasɛ tɔ gbɩɛ naŋ, sɛ barɛ dʋɔ wʋŋɩɩ abilafa lɩɩ fʋɔsɛ naŋ gaa tɔ gbɩɛ naŋ fa ɩ. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Sɛ bakpa baa ba dɔŋ asanaŋ na baa ba kpamɩna wʋrʋgbɩɛ na kpiniŋ fara baa kuusi sɛ,</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Hosana!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Hosana yɩɛ Hibiri dɩtawɩ bɛ, ga tie akala sɛ mɔlɔgɩ. Wʋrʋgbɩɛ na ga gaa sɩŋ fa kalɩɛwʋ.</char></note></para>
  <para style="q1" vid="MRK 11:9">Kusee n nyina wʋŋ wʋ a kɔŋ Ɩsʋɔ yɩrɛ naŋ!<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">Num 118:25-26</ref>.</char></note><verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />Kusee n ju fa daa Dawidi Juori gaa gaa kɔnɛ na!</para>
  <para style="q2" vid="MRK 11:10">Hosana n ju fa Ɩsʋɔ wʋŋ wʋ wɩɛ adugbe na!&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Sɛ Yesu gaa tala Yerusalem dɩɛ naŋ, wʋ jʋʋ Ɩsʋɔ tʋm danɛ naŋ, sɛ wʋ kɩɛ bʋrʋkʋma logo, ama lɩɩna gʋ tɩɛ a tam dʋɔ, wʋ na wʋ kpirida gifi bala baa bɔrɛ ju Betaniya.<verse eid="MRK 11:11" /></para>
  <para style="s1">Yesu tawɩ figi daŋ garɛ nʋɔsɛ</para>
  <para style="r">
    <ref loc="MAT 21:18-19">Matiyo 21:18-19</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Gʋ tɩɛna na, Yesu na wʋ kpirida baa lɩɩ Betaniya baa kɔŋ Yerusalem na, dusoŋ chaŋ Yesu. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Wʋ na figi daŋ garɛ sɩmɩɛɩ taŋasɛ ga pɔrɔgɩ fagɩɛ. Sɛ wʋ ju ga tie ga kɩɛ sɛ ga si bie yaa, ama wʋ tala dɩmaŋ na, wʋ n na bʋrʋ ʋ amʋɔ fagɩɛ, akala takɩɛ ŋɩ ba yɩɛ ga si saŋa a. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Sɛ Yesu tawɩ figi daŋ gaa sɛ, &lt;&lt;Wʋrʋ taŋ wʋ a ti di n bie e.&gt;&gt; Sɛ wʋ kpalɛnara baa nyii ŋii wʋ tawɩ daŋ gaa na.<verse eid="MRK 11:14" /></para>
  <para style="s1">Yesu gɩŋ yawʋ dira lɩɩ Ɩsʋɔ tʋm danɛ naŋ</para>
  <para style="r">
    <ref loc="MAT 21:12-17">Matiyo 21:12-17</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Gʋ Yesu tala Yerusalem dɩɛ naŋ na, wʋ jʋʋ Ɩsʋɔ tʋm danɛ naŋ. Sɛ wʋ fara wʋ a geŋ baa baa di yawʋ na wʋ a lɩɩ dɩmaŋ. Sɛ wʋ titi ba tebulu aba ŋii baa chɩɛgɩna aterembie ŋɩ dʋɔ, na juori gakuosɛ yara gbeliŋ lɔ. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Sɛ wʋ gaa gbɩɛ sɛ wʋrʋ n ba ti yaa bʋrʋ Ɩsʋɔ tʋm danɛ naŋ. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Sɛ wʋ kalaa-kalaa ba tawɩ sɛ ba sabɩɛ Sabɩɛwɩɛ naŋ sɛ,</para>
  <para style="q1" vid="MRK 11:17">&lt;&lt;Ma tʋm danɛ aja yɩɛ dɩga danɛ</para>
  <para style="q2" vid="MRK 11:17">fa atawɩ yɩrɩ kpiniŋ.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Yis 56:7</ref>.</char></note></para>
  <para style="m" vid="MRK 11:17">Ama ɩ mʋ dɩmaŋ yɩɛ ŋmɩɛla baa ba chamɩna doŋ baa lɩɛ bakpa abʋrɩ na dɩchatɩŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="JER 7:11">Yere 7:11</ref>.</char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Gʋ Ɩsʋɔ sei bɩnɩɛ na mbara bakalaasa baa nyii ŋii Yesu yɩɛ Ɩsʋɔ tʋm danɛ naŋ na, sɛ ba fara baa ja gbɩɛ gaa baa mʋna dʋɔ na baa kʋ ɩ, ama baa se ɩ akala takɩɛ wʋ kalaa ŋii a su jama baa asa.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Gʋ dɩ tala bʋyanɔ na, Yesu na wʋ kpalɛnara baa lɩɩ Yerusalem dɩɛ gaa naŋ.<verse eid="MRK 11:19" /></para>
  <para style="s1">Figi daŋ gaa sɩŋ</para>
  <para style="r">
    <ref loc="MAT 21:20-22">Matiyo 21:20-22</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Nafo fuu gʋ ba dɔŋ gbɩɛ naŋ baa ju na, sɛ ba na gʋ figi daŋ gaa Yesu tawɩ ga nʋɔsɛ na sɩŋ ga tala ga lira naŋ. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Dɩmaŋ sɛ Petero nyiŋi wɩɛ ŋii Yesu tawɩ fa figi daŋ gaa na. Sɛ wʋ tawɩ Yesu sɛ, &lt;&lt;Wʋkalaasa, kɩɛ, figi daŋ gaa nya tawɩ ga nʋɔsɛ na, ga sɩŋ.&gt;&gt;<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;N lɩɛ Ɩsʋɔ di.&gt;&gt; <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Maa tawɩ sɛ n nyii na dieli sɛ, &lt;&lt;wʋkʋma wʋŋ wʋ a tawɩ bʋrɔŋ sɛ, &lt;Kuli ju ga sala ɔpʋ naŋ&gt; sɛ wʋ aa lɩɛ noro wʋ digela naŋ ŋ sɛ wʋ lɩɛ di sɛ ŋii wʋ tawɩ aja tibi na, ŋii yɩɛ dɩmʋŋ fa ɩ. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Dɩmʋŋ dʋɔ, n nyii na dieli sɛ, bʋrʋkʋma gaa ɩ jɔ dɩga sʋlʋ Ɩsʋɔ na, n lɩɛ di sɛ ɩ yu na gaa yɩɛ amɩɛ teri. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Sɛ ɩ jɔ dɩga na, n mʋ bʋrʋkʋma gaa wʋrʋ yɩɛ chicha amɩɛ na chɩɛ ɩ, na amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na a mʋ amɩɛ dɩsʋbʋ chɩɛ amɩɛ. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Ama sɛ ɩŋ mʋ dɩsʋbʋ chɩɛ na, dɩmʋŋ sɛ amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe gba, baa mʋ amɩɛ dɩsʋbʋ chɩɛ amɩɛ ɛ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Naa Sabɩɛwɩɛ ŋii kpiniŋ n wɩɛna dɩmʋŋ wɩɛ ŋina a </char></note><verse eid="MRK 11:26" /></para>
  <para style="s1">Yesu yikuo dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MAT 21:23-27">Matiyo 21:23-27</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Gʋ Yesu na wʋ kpalɛnara baa ti bɔrɛ kɔŋ Yerusalem dɩɛ naŋ na, ba jʋʋ Ɩsʋɔ tʋm danɛ gaa naŋ. Gʋ Yesu dɔŋ Ɩsʋɔ tʋm danɛ gaa naŋ na, Ɩsʋɔ sei bɩnɩɛ, mbara bakalaasa na dɩɛ bɩnɩɛ baa barɛ kɔŋ wʋ jaŋ. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Sɛ ba tasɛ ɩ sɛ, &lt;&lt;Yikuo gamʋɔ sɛ nya wɩɛna sɛ nyaa yɩɛ abʋrɩ ŋina? Mmʋɔ n fa nyaŋ dɩmʋŋ yikuo gana?&gt;&gt;<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Maa tasɛ amɩɛ wɩɛ a dʋŋdʋlʋŋ, sɛ ɩ dɩlɛ lɩsɛ nʋɔ na, maa tawɩ amɩɛ yikuo gaa ma chamɩna maa yɩɛ ŋina kpiniŋ. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />N tawɩ maŋ, Yohane Ɩsʋɔ Sɔrɛ wʋŋ Ɩsʋɔ sɔ lɩɩ Ɩsʋɔ bɛ yaa wʋkpa?&gt;&gt;<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Sɛ ba tawɩ ba nyiŋeŋ-nyiŋeŋ sɛ, &lt;&lt;Dɩ lɩsɛ nʋɔ sɛ ŋɩ lɩɩ Ɩsʋɔ na, wʋ a tasɛ daa sɛ, be n yɩɛ sɛ dɩ n lɩɛ Yohane Ɩsʋɔ Sɔrɛ wʋŋ di? <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ama sɛ dɩ lɩsɛ nʋɔ sɛ ŋɩ lɩɩ bakpa na [Baa se bakpa baa, akala takɩɛ wʋkʋma lɩɛdi gʋ Yohane cha wʋ yɩɛ Ɩsʋɔ ɔja bɛ.]&gt;&gt;<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />Dɩmʋŋ dʋɔ, ba lɩsɛ nʋɔ sɛ, &lt;&lt;Dɩ ba jiŋ ŋ&gt;&gt; Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Maŋ gba, maa tawɩ amɩɛ yikuo gaa maa mʋ maa yɩɛ ŋina kpiniŋ na a.&gt;&gt;<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">Fʋɔ kɩɛra barɛ dʋɔ diduu</para>
  <para style="r">
    <ref loc="MAT 21:33-46">Matiyo 21:33-46</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Sɛ Yesu jɔ ba diduu sɛ, &lt;&lt;Baalɛ wʋrʋ n cha fara girepi fʋɔ sɛ wʋ ma dɩpɔrɛ logo fʋɔ gaa, sɛ wʋ wuru bʋɔ bɔlɛ ga tɩba, dɩmaŋ sɛ baa ŋaŋsɛ girepi bie lɩŋ ŋii baa mʋ baa yɩɛ sʋlʋŋ na. Sɛ wʋ ma giera danɛ jalɩŋtɛ garɛ gaa naŋ. Sɛ wʋ mʋ girepi fʋɔ gaa dʋ kɩɛra barɛ pamɩɛ naŋ. Wʋrʋgbɩɛ na, wʋ ju gbɩɛ. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Gʋ girepi bie karɩŋ saŋa talɛ na, sɛ girepi fʋɔtɛ wʋŋ kpiri wʋ tʋmɩrɛ fʋɔ kɩɛra baa jaŋ sɛ wʋ n ju ga lɩɛ wʋ teri kɔna ɩ. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ama fʋɔ kɩɛra baa chaŋ ɩ, tugu ɩ sɛ ba gɩŋ ɩ bɔsɩna pamɩɛ kpaŋ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Sɛ girepi fʋɔtɛ wʋŋ ti bɔrɛ kpiri wʋ baŋbaŋ, sɛ fʋɔ kɩɛra baa mʋ dɩchʋchʋ kpasɛ-kpasɛ wʋ nyinaŋ, sɛ ba tii ɩ ŋaba ɩ. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Sɛ wʋ ti bɔrɛ kpiri wʋ baŋbaŋ, sɛ fʋɔ kɩɛra baa kʋ ɩ. Sɛ wʋ kpiri fɔɩ, sɛ ba tugu barɛ sɛ ba kʋ barɛ.&gt;&gt;<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />&lt;&lt;Wʋŋ wʋ kakaa na wʋ a kpiri ɩ na, n nyina wʋbu baalɛ jaŋ wʋŋ wʋ a ja wʋ wɩɛ, sɛ wʋ kpiri ɩ. Sɛ wʋ tawɩ sɛ mabu baalɛ jaŋ wina bɩrɛ, baa bu ɩ.&gt;&gt;<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />Ama fʋɔ kɩɛra baa tawɩ dɔŋa sɛ, &lt;&lt;Wina n nyina gapatɩɛ diiri wʋŋ. N kɔŋ na dɩ kʋ ɩ na gapatɩɛ gaa a yɩɛ daa teri. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Dɩmʋŋ dʋɔ, ba chaŋ wʋbu wʋŋ, sɛ ba kʋ ɩ sɛ ba fɔŋɩ ɩ lɩɩ girepi fʋɔ gaa naŋ.&gt;&gt;<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Be sɛ fʋɔtɛ wʋŋ aja wʋ a yɩɛ? Wʋ a kɔŋ gaa kʋ fʋɔ kɩɛra baa na wʋ a mʋ fʋɔ gaa dʋ kɩɛra ba fɔlɩɛ pamɩɛ naŋ.&gt;&gt; <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Ɩŋ karaŋ ta Ɩsʋɔ Sabɩɛwɩɛ ŋii? Ŋii ba sabɩɛ sɛ,</para>
  <para style="q1" vid="MRK 12:10">&lt;&lt;&lt;Bʋɩ gaa danɛ mara pɩɛ ga na,</para>
  <para style="q2" vid="MRK 12:10">gaa aaŋ ja gaa chaŋ danɛ gaa dɩkɔŋ naŋ na doŋ.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Ɩsʋɔ n yɩɛ ŋina,</para>
  <para style="q2" vid="MRK 12:11">sɛ dɩ yɩɛ doba daa asa dʋɔ.&gt;<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Num 118:22-23</ref>.</char></note>&gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Yudatina bɩnɩɛ baa jiŋ gʋ baa sɛ Yesu jɔ diduu ga na, dɩmʋŋ dʋɔ baa ja gbɩɛ gaa baa mʋna dʋɔ na baa chaŋ ɩ. Ama baa se jama baa, dɩmʋŋ dʋɔ ba yela ɩ sɛ wʋ lam.<verse eid="MRK 12:12" /></para>
  <para style="s1">Lampo tɔ dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MAT 22:15-22">Matiyo 22:15-22</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Ba kpiri Farasitina na Juo Hɛrɔdɩ wʋrʋgbɩɛtina tɩba barɛ sɛ ba n ju ga yii Yesu gʋdʋ wʋ wɩɛ a tawɩsa dʋɔ, na baa sɩŋ ŋɩ dʋɔ chaŋ ɩ. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Ba kɔŋ Yesu jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Wʋkalaasa, dɩ jiŋ gʋ nya yɩɛ gasiŋteŋ diri bɛ, sɛ ŋɩ n tiri nyaŋ lɩɩ ŋii bakpa a tawɩ ɩ akala takɩɛ nyaa kɩɛ wʋkpa asanaŋ n dɩ tawɩ naŋ ŋ. Ama nyaŋ bɩrɛ, nyaa kalaa Ɩsʋɔ wɩɛ ŋii ŋɩ yɩɛ gasiŋteŋ ŋɩ gbɩɛ dʋɔ. Tawɩ daa, ŋɩ wɩɛ gbɩɛ sɛ dɩ n tɔ lampo fa Roma Juo Kayisa yaa dɩ n baa tɔ? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Dɩdaga na dɩ tɔ yaa dɩ n ba tɔ?&gt;&gt; Ama Yesu jiŋ ba aluguusi wɩɛ, dɩmʋŋ dʋɔ wʋ tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ ja sɛ ɩ yii maŋ gʋdʋ? N mʋ diterembi dinari<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Dinari yɩɛ Romatina diterembi bɛ </char></note> garɛ kɔna maŋ na maa kɩɛ.&gt;&gt;<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Sɛ ba mʋ kɔna ɩ sɛ wʋ tasɛ ba sɛ, &lt;&lt;Mmʋɔ nyi na wʋ yɩrɛ n jaga na ga dʋɔ?&gt;&gt; Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Juo Kayisa teri.&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Dɩmʋŋ bɩrɛ, n mʋ ŋii ŋɩ yɩɛ Juo Kayisa teri na fa Juo Kayisa na ɩ mʋ ŋii ŋɩ yɩɛ Ɩsʋɔ teri na fa Ɩsʋɔ.&gt;&gt; Sɛ Yesu wɩɛ ŋii yɩɛ ba doba.<verse eid="MRK 12:17" /></para>
  <para style="s1">Feŋ lɩɩ sɩŋ naŋ dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MAT 22:23-33">Matiyo 22:23-33</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Sɛ Sadukitina baa baa lɩɛ baa di sɛ feŋ lɩɩ sɩŋ naŋ wɩɛ na barɛ kɔŋ Yesu jaŋ gaa tasɛ ɩ sɛ, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />&lt;&lt;Wʋkalaasa, Mosesi mbara ŋii naŋ na, wʋ sabɩɛ fa daa Yudatina sɛ baalɛ sɩŋ yela wʋ alʋ sɛ ba n lʋrʋ na, ŋɩ tiri gʋ wʋnabu n saa okulapu wʋŋ, na wʋ a lʋrʋ bie fa wʋ ŋmɩɛtɩ wʋŋ wʋ sɩŋ na. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Juo lʋrʋbie baala jaŋ lɩkaarɛ barɛ n cha ba wɩɛna. Sɛ ba tɩba bɩnɛ jaŋ wʋŋ saa alʋ, wʋ n lʋrʋ ʋ sɛ wʋ sɩŋ. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Wʋnabu balatɛ saa okulapu wʋŋ. Wʋŋ dʋɔ, wʋ n lʋrʋ ʋ sɛ wʋ sɩŋ. Dɩmʋŋ sɛ dɩ mɩɛna batoro-tɛ wʋŋ. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Baala lɩkaarɛ baa kpiniŋ saa alʋ wʋŋ ama ba n lʋrʋ ʋ sɛ ba sɩŋ. Wʋrʋgbɩɛ na, sɛ alʋ wʋŋ gba sɩŋ. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Dɩmʋŋ dʋɔ, feŋ lɩɩ sɩŋ naŋ wɩɩ na, ba tɩba wʋ Mmʋɔ alʋ n nyina alʋ wʋŋ?&gt;&gt; Akala takɩɛ juo lʋrʋbie lɩkaarɛ baa kpiniŋ saa ɩ.<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Ɩ tʋsʋ gbɩɛ, akala takɩɛ ɩ ba jiŋ Ɩsʋɔ Sabɩɛwɩɛ ŋii yaa Ɩsʋɔ doŋ ŋ. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Feŋ lɩɩ sɩŋ naŋ wʋrʋgbɩɛ na, bakpa baa saa a, baa kɩɛna bɛ takɩɛ Ɩsʋɔ gabʋɔsɛ baa ba wɩɛ Ɩsʋɔ adugbe na. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Dɩtɩɛna, lɩɩna atatina feŋ lɩɩ sɩŋ naŋ na, ɩŋ karaŋ Mosesi tanɛ naŋ ganaŋkʋ bʋala a chaŋ dɩpʋnfa naa? Dɩmaŋ sɛ Ɩsʋɔ tawɩ Mosesi sɛ, &lt;Maŋ n nyina Abiraham Ɩsʋɔ, Isaki Ɩsʋɔ na Yakubu Ɩsʋɔ.&gt;<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Ɛsa 3:6</ref>.</char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Wʋ ba yɩɛ atatina Ɩsʋɔ ɔ, ama wʋ yɩɛ bakpa bakɩɛnasa Ɩsʋɔ bɛ. Dɩmʋŋ dʋɔ ɩ tʋsʋ gbɩɛ amɩɛ dɩ tawɩ naŋ.&gt;&gt;<verse eid="MRK 12:27" /></para>
  <para style="s1">Mbara gaa ga yɩɛ gajanɛ</para>
  <para style="r">
    <ref loc="MAT 22:34-40">Matiyo 22:34-40</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Mosesi mbara bakalaasa baa tɩba wʋrʋ kɔŋ dɩmaŋ, sɛ wʋ nyii gʋ Yesu na Sadukitina baa a di noro. Sɛ wʋ na gʋ Yesu lɩsɛ Sadukitina baa nʋɔ bam, wʋ tasɛ ɩ sɛ, &lt;&lt;Mosesi mbara ŋii kpiniŋ naŋ, gamʋɔ n nyina gajaŋ-janɛ?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Mbara ŋii tɩba gajanɛ n nyina: Isiralitina n nyii. Ɩsʋɔ daa Ɩsʋɔ wʋŋ yɩɛ Ɩsʋɔ wʋ dʋŋdʋlʋŋ bɛ. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Ja Ɩsʋɔ lɩɩ n digela naŋ, n sʋbʋ kpiniŋ, nya nfɩɛrɛ kpiniŋ naŋ na n doŋ kpiniŋ. <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Mbara bʋlatɛ n nyina sɛ, &lt;Ja n dʋɔ takɩɛ n wʋsɛ.&gt; Mbara ŋarɛ taŋ sɛ ŋɩ kii ŋina a.&gt;&gt;<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Sɛ Mosesi mbara wʋkalaasa wʋŋ tawɩ Yesu sɛ, &lt;&lt;Wʋkalaasa, nya tawɩ gasiŋteŋ sɛ Ɩsʋɔ yɩɛ wʋdʋŋdʋlʋŋ bɛ. Wʋrʋ taŋ ŋ amʋɔ wʋ nyiŋeŋ. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Ja Ɩsʋɔ lɩɩ n digela kpiniŋ naŋ, nya nfɩɛrɛ kpiniŋ naŋ na n doŋ kpiniŋ na nyaa ja n dʋɔ takɩɛ n wʋsɛ dɩmʋŋ mbara ŋina kii gʋ nya yɩɛ ŋɩɛwʋ nam gadiesa na gadiesa fa Ɩsʋɔ na.&gt;&gt;<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Gʋ Yesu na gʋ wʋ lɩsɛ nʋɔ na dieli na, sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Nya tirina Ɩsʋɔ Juori gaa.&gt;&gt; Ganaŋkʋ Yesu lɩsɛ nʋɔ na dʋɔ, wʋrʋ n ti dɩlɛ yu digela tasɛ ɩ wɩɛ ŋarɛ ɛ.<verse eid="MRK 12:34" /></para>
  <para style="s1">Kirisito dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MAT 22:41-46">Matiyo 22:41-46</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Gʋ Yesu akalaa Ɩsʋɔ tʋm danɛ naŋ na, wʋ tasɛ ba sɛ, &lt;&lt;Be dʋɔ sɛ mbara bakalaasa baa a tawɩ sɛ Kirisito<note caller="+" style="f"><char style="fr" closed="false">12:35 </char><char style="ft" closed="false">Kirisito tie akala sɛ nkpalɩɛrɛ. Girikitina a yagɛ sɛ Kirisito sɛ Yudatina a yagɛ sɛ Mesaya</char></note> wʋŋ yɩɛ Juo Dawidi ganana bie? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Sɛ Ɩsʋɔ Feliŋ yela sɛ Dawidi tawɩ sɛ,</para>
  <para style="q1" vid="MRK 12:36">&lt;&lt;Ɩsʋɔ wʋŋ n tawɩ ma Kpaŋjuo sɛ,</para>
  <para style="q2" vid="MRK 12:36">cha ma pam jɩsaŋ dʋɔ ga tala gʋ maa mʋ n badʋŋna mʋ yɩɛ n nafara dɩjagatɩŋ.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Num 110:1</ref>.</char></note>&gt;&gt;<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Dawidi tɩŋtɩŋ a yagɛ Kirisito sɛ, &lt;&lt;Kpaŋjuo. Dɩmʋŋ dʋɔ, sɩnɛ sɛ Kirisito wʋŋ a ti dɩlɛ yɩɛ Dawidi ganana bie?&gt;&gt; Sɛ bakpa baa mʋ asadi nyii wɩɛ ŋii wʋ a tawɩ na.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Gʋ Yesu a kalaa ba na, wʋ tawɩ ba sɛ, &lt;&lt;N kɩɛ amɩɛ wʋsɛ dʋɔ mbara bakalaasa baa dʋɔ. Baa fu gagbasɛ ajalɩŋtina ba dɔŋ ba dɔŋ, na bakpa a luuŋ yɩlɩ ba gɩyɩɛnɩŋ naŋ. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Baa ja achaatɩŋ ajanɩɛ Yudatina tʋm danɛ naŋ, na achaatɩŋ ŋii ŋɩ wɩɛ jilima na asadi adiya di tie. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Baa mʋna kpiŋjim gbɩɛ dʋɔ baa lɩɛ bakʋlapʋna gapatɩɛ. Baa jɔ dɩga jalɩŋtɛ takɩɛ ba yɩɛ bakpa ba bama. Dɩmʋŋ dʋɔ, Ɩsʋɔ aja fɔŋɩ dɩmʋŋ bakpa bana dɩlɛ fɔɩ.&gt;&gt;<verse eid="MRK 12:40" /></para>
  <para style="s1">Okulapu wʋŋ faa</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Wɩɩ darɛ, Yesu cha ju Yudatina tʋm danɛ naŋ, sɛ wʋ ga cha faa dɩdaka gaa sinabie wʋ a kɩɛ ganaŋkʋ bakpa baa a mʋ aterembie baa dʋ faa dɩdaka gaa naŋ. Aterembietina a mʋ aterembie ajanɩɛ-ajanɩɛ baa kɔŋ baa dʋ. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Dɩmaŋ sɛ alʋ okulapu ayɔŋtɛ wʋrʋ gba kɔnɛ, sɛ wʋ mʋ kpaŋnyɔ ala ju ga dʋ faa dɩdaka gaa naŋ.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />Sɛ Yesu yagɛ wʋ kpalɛnara baa kɔŋ wʋ jaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli, dɩmʋŋ alʋ okulapu ayɔŋtɛ wina mʋ aterembie dʋ faa dɩdaka naŋ kii wʋkʋma. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Akala takɩɛ bakpa baa kpiniŋ lɩsɛ chonii bɛ lɩɩ ba akpaŋta naŋ dʋ faa dɩdaka naŋ. Ama okulapu ayɔŋtɛ wʋŋ bɩrɛ, wʋ lɩɩ wʋ gɩyɔŋ naŋ bɛ sɛ wʋ mʋ pii ŋii wʋ a di na kpiniŋ ju ga dʋ faa dɩdaka gaa naŋ.&gt;&gt;<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">Yesu tawɩ Ɩsʋɔ tʋm danɛ warɩɛwʋ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 24:1-2">Matiyo 24:1-2</ref>; <ref loc="LUK 21:5-6">Luka 21:5-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Gʋ Yesu a lɩɩ Ɩsʋɔ tʋm danɛ naŋ na, wʋ kpalɛnara baa tɩba wʋrʋ tawɩ ɩ sɛ, &lt;&lt;Wʋkalaasa, kɩɛ bʋɛ ajanɩɛ abama ŋii ba mʋ ma danɩŋ ŋina sɛ ŋɩ yɩɛ dieli.&gt;&gt;<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Naa ɩ na danɩŋ ajanɩɛ ŋina ya? Bʋɩ garɛ baa ti jaga ga dʋɔ-dʋɔ ɔ. Baa salɩɛ ŋɩ kpiniŋ.&gt;&gt;<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Gʋ Yesu chaɩ olifi dasɛ bʋrɔŋ gaa dʋɔ Ɩsʋɔ tʋm danɛ gaa sinabie. Petero, Jamesi, Yohane na Andurusi nyiŋeŋ kɔŋ wʋ jaŋ gaa tasɛ ɩ sɛ, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />&lt;&lt;Tawɩ daa, saŋa gamʋɔ sɛ ŋina aja tibi? Sɛ be aaŋ ja yɩɛ daasɛ gaa gaa kalaa sɛ ŋina kpiniŋ aja kɔŋ tɩba.&gt;&gt;<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;N kɩɛ amɩɛ wʋsɛ dʋɔ na dieli, na wʋrʋ n baa pɩna amɩɛ. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Bakpa fɔɩ aja kɔŋ ma yɩrɛ naŋ na baa gaa tawɩ sɛ, &lt;Baa n nyina Kirisito wʋŋ&gt; na baa pɩna bakpa fɔɩ. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Ɩ nyii yuo gaa ga tirina amɩɛ na yuo gaa ga wɩɛ taŋasɛ wɩɛ na, n baa yela na amɩɛ agela a kʋlʋ. Akala takɩɛ ŋɩ tiri gʋ ŋina a tibi, ama ŋii kalaa sɛ dulunya dɩtamtɩŋ talɛ ɛ. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Atawɩ yɩrɩ kpiniŋ aja yuo dɔŋa na juori a yuo juori. Na tibi a jigisi akpie dʋɔ-akpie dʋɔ na wɔŋfɩrɛ a kɔŋ. Ŋina kpiniŋ kɩɛna bɛ takɩɛ dʋŋɩwʋ ŋii ŋɩ dɔŋ asanaŋ pɔɩ na alʋ a lʋrʋ na.&gt;&gt;<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Dɩmʋŋ dʋɔ, ŋɩ tiri gʋ n kɩɛ amɩɛ wʋsɛ dʋɔ na dieli. Ma dʋɔ, baa chaŋ amɩɛ mʋ ju wɩɛ adiitiŋ bɩnɩɛ asanaŋ na baa taɩ amɩɛ achʋchʋɛ Yudatina tʋm danɛ naŋ, baa chaŋ amɩɛ ju Roma bɩnɩɛ baa baa kɩɛ Isirali tibi dʋɔ na, na juoneŋ asanaŋ na baa ga di amɩɛ wɩɛ. Dɩmaŋ sɛ ɩ yu gbɩɛ tawɩ Ɩsʋɔ Wɩɛ Abama ŋii fa ba. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ŋɩ tiri gʋ baa chɩŋkpɩɛ tawɩ Ɩsʋɔ Wɩɛ Abama ŋii fa atawɩ yɩrɩ kpiniŋ. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Sɛ ba chaŋ amɩɛ ju wɩɛ didiitiŋ na, n baa nyala amɩɛ wʋsɛ wɩɛ ŋii ɩ tawɩ na dʋɔ. Dɩ tala dɩmaŋ na, n tawɩ a kʋma ŋii Ɩsʋɔ aja kalaa amɩɛ na. Akala takɩɛ naa amɩɛ tɩŋtɩŋ aaŋ ja ɩ tawɩ ɩ, ama Ɩsʋɔ Feliŋ aaŋ ja tawɩ.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />Sɛ Yesu tawɩ sɛ nalʋrʋ bie aja lɩsɛ dɔŋa fa na baa kʋ ba, na juo a lɩsɛ wʋbu fa. Bachaasɛ aja kʋlʋ sɩŋ ba lʋrʋda dʋɔ na baa kʋ ba. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Ma dʋɔ, bakpa kpiniŋ aja kɔla amɩɛ. Ama wʋŋ wʋ a sɩŋ na doŋ ga tala dɩtamtɩŋ na, wʋ a yu nkpa.<verse eid="MRK 13:13" /></para>
  <para style="s1">Akɔlɛsa ŋii ŋɩ wɩɛ Ɩsʋɔ tʋm danɛ naŋ</para>
  <para style="r">
    <ref loc="MAT 24:15-28">Matiyo 24:15-28</ref>; <ref loc="LUK 21:20-24">Luka 21:20-24</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Sɛ Yesu ti ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩ kɔŋ sɛ ɩ na akɔlɛsa ŋii ŋɩ wɩɛ Ɩsʋɔ tʋm danɛ gaa naŋ na, sɛ dɩ n daga na ŋii sɩŋ dɩmaŋ ŋ, [n yela wʋkʋma wʋŋ wʋ a karaŋ dɩmʋŋ wɩɛ ŋina na a nyii tie.] N yela wʋkʋma wʋŋ wʋ wɩɛ Yudiya tibi dʋɔ na a se ju bʋrɔŋsɛ dʋɔ. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />N yela na wʋŋ wʋ wɩɛ danɛ adugbe na, n baa tibi jʋʋ danɛ naŋ ga mʋ bʋrʋ. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />N yela na wʋŋ wʋ wɩɛ fʋɔnaŋ na, n baa yɩɛ wʋ nfɩɛrɛ sɛ wʋ a ti bɔrɛ kɔŋ dɩɛ gaa mʋ wʋ adugbe gagba. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Dɩmʋŋ gɩyɩɛnɩŋ ŋina naŋ na, filietina na alʋsɔna, baa lakʋ! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />N jɔ dɩga na dɩmʋŋ wɩɛ ŋina n baa tibi gbaŋgbaŋ saŋa. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Akala takɩɛ, dɩmʋŋ saŋa gana naŋ na, wʋkpa wʋsɛ aja chaŋ ɩ na dieli kii saŋa gaa Ɩsʋɔ lɔ dulunya gaa tala jaŋ, sɛ ŋɩ ŋarɛ baa ti tibi i. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Sɛ Ɩsʋɔ n kɔgɩ gɩyɩɛnɩŋ ŋina dʋɔ na, dɩmʋŋ bɩrɛ, nafʋɔ wʋrʋ baa yu nkpa a. Ama baa wʋ lɩsɛ ba na dʋɔ, wʋ a kɔgɩ gɩyɩɛnɩŋ ŋii dʋɔ. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Dɩmʋŋ saŋa gana naŋ na, sɛ wʋrʋ tawɩ amɩɛ sɛ, &lt;N kɩɛ, Kirisito wʋŋ mɩnaŋ,&gt; yaa &lt;N kɩɛ, wʋŋ n wɩɛna dɩmaŋ na,&gt; n baa lɩɛ di. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Akala takɩɛ, barɛ baa baa yɩɛ akarɩɛ sɛ ba yɩɛ Kirisito na akarɩɛ bajana aja kɔŋ gaa yɩɛ daasɛ na adaŋgana na baa mʋ pɩna baa Ɩsʋɔ lɩsɛ ba na. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Dɩmʋŋ dʋɔ, n kɩɛ amɩɛ wʋsɛ dʋɔ na dieli, ma chɩŋkpɩɛ tawɩ amɩɛ wɩɛ ŋina kpiniŋ pɔɩ na saŋa gana a tala.&gt;&gt;<verse eid="MRK 13:23" /></para>
  <para style="s1">Wʋkpa Bu wʋŋ aja bɔrɛ kɔŋ</para>
  <para style="r">
    <ref loc="MAT 24:29-31">Matiyo 24:29-31</ref>; <ref loc="LUK 21:25-28">Luka 21:25-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ saŋa gana naŋ, wʋkpa wʋsɛ chaŋ wʋrʋgbɩɛ na, wiita baa lɩɩ ɩ, sɛ gafita baa fʋlʋŋsɛ ɛ.&gt;&gt; <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />Achikpebi aja kuli lɩɩ Ɩsʋɔ tanɛ naŋ gaa sala, na Ɩsʋɔ adugbe abʋrɩ kpiniŋ ajigisi.<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />Dɩmʋŋ saŋa gana naŋ na, bakpa aja na Wʋkpa Bu wʋŋ a kɔnɛ na yikuo na jilima lɩɩ Ɩsʋɔ tanɩɛ naŋ. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Na wʋ a kpiri wʋ gabʋɔsɛ dulunya naŋ gapɩlɛkʋma na baa pala sila Ɩsʋɔ bakpa baa wʋ lɩsɛ dulunya naŋ na kpiniŋ lɩɩ wiita dɩlɩɩtɩŋ na dɩsalɩtɩŋ, adugbe na atagbɩɛ.<verse eid="MRK 13:27" /></para>
  <para style="s1">Kpalɩɛna lɩɩ figi daŋ gaa dʋɔ</para>
  <para style="r">
    <ref loc="MAT 24:32-35">Matiyo 24:32-35</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Sɛ Yesu jɔ ba diduu sɛ, &lt;&lt;N kɩɛ figi daŋ na ɩ kpalɩɛna bʋrʋ garɛ. Ga pɔrɔgɩ na, n jiŋ gʋ awuluŋ tirina. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Dɩmʋŋ gba sɛ ɩ na ŋina kpiniŋ a tibi na, n jiŋ gʋ Wʋkpa Bu wʋŋ bɔrɛ kɔŋ tirina, wʋ wɩɛ buonɔ. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Maa tawɩ sɛ n nyii na dieli, gɩnanaŋ gana baa laŋ ŋ ga tala saŋa gaa ŋina kpiniŋ aja tibi. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Ɩsʋɔ adugbe na tie aja laŋ, ama ma wɩɛ ŋii bɩrɛ, ŋii laŋ ŋ.&gt;&gt;<verse eid="MRK 13:31" /></para>
  <para style="s1">Wʋrʋ ba jiŋ wɩɩ na saŋa gaa Yesu aja kɔŋ ŋ</para>
  <para style="r">
    <ref loc="MAT 24:36-44">Matiyo 24:36-44</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Wʋrʋ ba jiŋ wɩɩ gaa yaa saŋa gaa a. Ɩsʋɔ gabʋɔsɛ baa ba wɩɛ Ɩsʋɔ adugbe yaa Bu wʋŋ gba ba jiŋ ŋ, amʋɔ Juo wʋŋ nyiŋeŋ. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Dɩmʋŋ dʋɔ n kɩɛ amɩɛ wʋsɛ dʋɔ na dieli na ɩ gie, akala takɩɛ ɩ ba jiŋ saŋa gaa ŋii kɔŋ na a. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Ŋɩ kɩɛna bɛ takɩɛ baalɛ wʋrʋ a ju gbɩɛ sɛ wʋ mʋ wʋ waa dʋ wʋ tʋmɩra pamɩɛ naŋ. Sɛ wʋ fa wʋkʋma wʋ dɩtʋm gaa wʋ n yɩɛ. Sɛ wʋ tawɩ buonɔ kɩɛrɛ wʋŋ sɛ wʋŋ duo wʋ wʋsɛ dʋɔ.&gt;&gt;<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />Dɩmʋŋ dʋɔ, n duo amɩɛ wʋsɛ dʋɔ, akala takɩɛ ɩ ba jiŋ wɩɩ gaa waatɛ wʋŋ aja bɔrɛ kɔŋ ŋ. A dɩlɛ yɩɛ bʋyanɔ, tɩɛtɩtɩba, tafɩlɛ yaa nafo, <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />na wʋ n baa gaa purugi amɩɛ ɩ duwei asoroŋ. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Wɩɛ ŋii ma tawɩ fa amɩɛ na, maa tawɩ wʋkʋma sɛ, &lt;&lt;N duo amɩɛ wʋsɛ dʋɔ.&gt;&gt;<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">Ba jɔ dɩkɔŋ sɛ baa kʋ Yesu</para>
  <para style="r">
    <ref loc="MAT 26:1-5">Matiyo 26:1-5</ref>; <ref loc="LUK 22:1-2">Luka 22:1-2</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Gʋ dɩ kakaa wɩɛ ala na Yudatina Nyiŋi Asadi Adiya di<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Yudatina nyiŋi asadi adiya di yɩɛ gɩyɩɛnɩŋ ŋii baa di ba mʋ ba nyiŋi ganaŋkʋ Ɩsʋɔ lɩsɛ baa lɩɩ Misirim tibi dʋɔ </char></note> na Bodobodo<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Bodobodo gaa ga tana</char></note> gaa ga Tana Yiisi Asadi Adiya di gɩyɩɛnɩŋ a tala na, sei bɩnɩɛ na mbara bakalaasa ja gbɩɛ gaa baa mʋna dʋɔ wɩsɛ chaŋ Yesu na baa kʋ ɩ. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Ama ba tawɩ sɛ, &lt;&lt;N baa yela dɩ chaŋ ɩ nyiŋi asadi adiya di gɩyɩɛnɩŋ ŋina naŋ, naa dɩmʋŋ na, ŋii kɔna siŋii dɩɛ naŋ.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="s1">Alʋ wʋrʋ chɩɛgɩ nuŋ alifeŋsa wʋrʋgɩ Yesu nyinaŋ</para>
  <para style="r">
    <ref loc="MAT 26:6-13">Matiyo 26:6-13</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Gʋ Yesu wɩɛ Batani Simoŋ wʋŋ wʋ cha kili gɩchalaŋa waa dʋɔ wʋ a di na, sɛ alʋ wʋrʋ kɔŋ dɩmaŋ wʋ chamɩna sapɩɛ bie garɛ yela naadɩ<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Nuŋ alifeŋsa ŋina na naadɩ daŋ sɛ ba mʋ yɩɛ ŋɛ.</char></note> nuŋ alifeŋsa ŋii ŋɩ yawʋ wɩɛ doŋ wɩɛ ga tɩba sɛ wʋ chɩɛgɩ wʋrʋgɩ Yesu nyinaŋ.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Gʋ bakpa baa ba wɩɛ dɩmaŋ na barɛ na dɩmʋŋ na, ba kara biŋbira sɛ ba tawɩ dɔŋa sɛ, &lt;&lt;Be n yɩɛ sɛ wʋ a warɩɛ nuŋ alifeŋsa ŋina? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Nafʋɔ baa dɩlɛ yaa nuŋ alifeŋsa ŋina na baa yu wʋrʋ bɩriŋnʋɔ kɩmtʋɔ na baa mʋ aterembie dinari ŋii fa ayɔŋtina.&gt;&gt; Sɛ ba tawɩ wʋ asanaŋ.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N yela alʋ wʋŋ! Be n yɩɛ sɛ ɩ nyala ɩ dɩmʋŋ? Wʋ yɩɛ bʋrʋ gabam fa maŋ bɛ. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Akala takɩɛ ayɔŋtina bɩrɛ, ba wɩɛ amɩɛ jaŋ. Ɩ dɩlɛ yɩɛ dɩbam fa ba saŋa kʋma gaa ɩ jawʋ na. Ama maŋ bɩrɛ, ma taŋ amɩɛ jaŋ saŋ kʋma a. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Alʋ wʋŋ yɩɛ bʋrʋ gaa wʋ a dɩlɛ. Wʋ chɩɛgɩ nuŋ alifeŋsa ŋii wʋrʋgɩ ma wʋsɛ mʋ desina maŋ si daa ma wuu bɛ. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Maa tawɩ sɛ n nyii na dieli sɛ dulunya naŋ gapɩlɛkʋma gaa baa tawɩ Ɩsʋɔ Wɩɛ Abama ŋii na, baa tawɩ ŋii alʋ wʋŋ yɩɛ na mʋ nyiŋi ɩ.&gt;&gt;<verse eid="MRK 14:9" /></para>
  <para style="s1">Yudasi kpa gʋ wʋ a lɩsɛ Yesu fa</para>
  <para style="r">
    <ref loc="MAT 26:14-16">Matiyo 26:14-16</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Sɛ Yudasi Isikariyoti, kpirida gifi bala baa tɩba wʋrʋ ju Ɩsʋɔ sei bɩnɩɛ jaŋ na wʋ a ga lɩsɛ Yesu fa ba. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Ba asadi wɩɛ ŋii wʋ tawɩ ba na dʋɔ. Sɛ ba tawɩ ɩ sɛ baa fa ɩ aterembie. Lɩɩ dɩmʋŋ saŋa gana mʋ a ju na, sɛ wʋ fara wʋ a ja gbɩɛ gaa wʋ a mʋna dʋɔ lɩsɛ Yesu fa ba.<verse eid="MRK 14:11" /></para>
  <para style="s1">Yesu na wʋ kpalɛnara di nyiŋi asadi adiya di adiya</para>
  <para style="r">
    <ref loc="MAT 26:17-25">Matiyo 26:17-25</ref>; <ref loc="LUK 22:7-23">Luka 22:7-23</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Wɩɩ gaa ga doŋ asanaŋ fa Bodobodo gaa ga Tana Yiisi Asadi Adiya di na, ŋɩ yɩɛ ba ayɩɛsa sɛ ba n kʋ Nyiŋi Asadi Adiya di fiebu mʋ diesi gadiesa. Sɛ Yesu kpalɛnara baa tasɛ ɩ sɛ, &lt;&lt;Le sɛ nyaa ja sɛ dɩ ju ga desina fa nyaŋ na nyaa ga di Nyiŋi Asadi Adiya di adiya?&gt;&gt;<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Yesu kpiri wʋ kpalɛnara baa tɩba bala sɛ wʋ tawɩ ba sɛ, &lt;&lt;N ju dɩɛ janɛ gaa naŋ ɩ jaŋina baalɛ wʋrʋ wʋ siana sapɩɛ bie na lɩŋ, n kpaŋ ɩ, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />ju waa gaa wʋ a jʋʋ ga dʋɔ na. N tawɩ waatɛ wʋŋ sɛ, &lt;Wʋkalaasa wʋŋ sɛ, kalaa daa mʋɔra danɛ gaa maŋ na ma kpalɛnara dɩ cha tɩba di Nyiŋi Asadi Adiya di adiya ŋii.&gt; <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Wʋ a kalaa amɩɛ abaŋsʋrʋ danɛ janɛ garɛ sɛ ba desina tɩba na. Dɩmaŋ sɛ n yɩɛ nyiŋi asadi adiya di adiya ŋii fa daa.&gt;&gt;<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Sɛ wʋ kpalɛnara baa kʋlʋ ju dɩɛ janɛ gaa naŋ ga na bʋrʋkʋma ganaŋkʋ Yesu tawɩ ba na. Sɛ ba yɩɛ Nyiŋi Asadi Adiya di adiya ŋii dɩmaŋ.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Gʋ bʋyanɔ talɛ na, Yesu na wʋ kpirida gifi bala baa kɔŋ waa gaa dʋɔ. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Gʋ ba chaɩ baa di na, sɛ Yesu tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ, amɩɛ baa maŋ na amɩɛ dɩ di n na tɩba wʋrʋ aja lɩsɛ maŋ fa.&gt;&gt;<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Gʋ ba nyii wɩɛ ŋii Yesu tawɩ na, sɛ ba bɔtaa. Sɛ ba tasɛ Yesu garɛ-garɛ sɛ, &lt;&lt;Maŋ bɛ yaa?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Amɩɛ gifi bala bana tɩba wʋdʋŋdʋlʋŋ wʋŋ maŋ na ɩ dɩɩ di nyɩna garɛ naŋ na aaŋ ja wʋ a lɩsɛ maŋ fa. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Wʋkpa Bu wʋŋ aja sɩŋ ganaŋkʋ ba sabɩɛ wʋ wʋsɛ dʋɔ wɩɛ Ɩsʋɔ Wɩɛ naŋ na. Ama wʋkpa wʋŋ wʋ a lɩsɛ Wʋkpa Bu wʋŋ fa na, wʋŋ lakʋ! Nafʋɔ ba n lʋrʋ ɩ gba bɔ.&gt;&gt;<verse eid="MRK 14:21" /></para>
  <para style="s1">Kpaŋjuo adiya</para>
  <para style="r">
    <ref loc="MAT 26:26-30">Matiyo 26:26-30</ref>; <ref loc="LUK 22:14-20">Luka 22:14-20</ref>; <ref loc="1CO 11:23-25">1Koronto 11:23-25</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Gʋ Yesu na wʋ kpalɛnara baa a di na, wʋ mʋ bodobodo sɛ wʋ yɩlɩ Ɩsʋɔ sɛ wʋ jaɩ-jaɩ tɩba mʋ fa wʋ kpalɛnara baa, sɛ wʋ tawɩ ba sɛ, &lt;&lt;Ma wʋsɛ mɩnaŋ, n lɩɛ di.&gt;&gt;<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Sɛ Yesu mʋ gafie bie gaa wayɩŋ sʋlʋŋ wɩɛ tɩba sɛ wʋ yɩlɩ Ɩsʋɔ sɛ wʋ mʋ fa wʋ kpalɛnara baa kpiniŋ sɛ ba n nyʋɔ fa dɔŋa.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Ma asima mɩnaŋ, ŋii ŋɩ chɩɛgɩ wʋrʋgɩ fa bakpa kpiniŋ, ŋii n nyina dɩkɔŋ fɔlɛ gaa Ɩsʋɔ na bakpa jʋɔ. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Maa tawɩ sɛ n nyii na dieli sɛ, maa ti nyʋɔ wayɩŋ sʋlʋŋ ŋina ŋarɛ ɛ mʋ ga tala wɩɩ gaa maa nyʋɔ ŋɩ afɔlɩɛ Ɩsʋɔ Juori gaa naŋ.&gt;&gt;<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Gʋ ba kpie numba yɩlɩ Ɩsʋɔ taŋ na, ba lɩɩ dɩmaŋ ju olifi dasɛ bʋrɔŋ dʋɔ.<verse eid="MRK 14:26" /></para>
  <para style="s1">Yesu tawɩ Petero pɩɛ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 26:31-35">Matiyo 26:31-35</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Sɛ Yesu tawɩ wʋ kpalɛnara baa sɛ, &lt;&lt;Amɩɛ kpiniŋ ɩ puseŋ yela maŋ.&gt;&gt; Akala takɩɛ ba sabɩɛ Sabɩɛwɩɛ ŋii naŋ sɛ, Ɩsʋɔ tawɩ sɛ,</para>
  <para style="q1" vid="MRK 14:27">&lt;&lt;Maa kʋ feŋ kparɛ wʋŋ</para>
  <para style="q2" vid="MRK 14:27">na feŋ baa a puseŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Sak 13:7</ref>.</char></note><verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Ama ma feŋ lɩɩ sɩŋ naŋ wʋrʋgbɩɛ na, maa pala amɩɛ asanaŋ ju Galaliya.<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Sɛ Petero tawɩ Yesu sɛ, &lt;&lt;Sɛ ba kpiniŋ baa puseŋ yela nyaŋ na, maŋ bɩrɛ, maa yɩɛ dɩmʋŋ ŋ.&gt;&gt;<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Nyaŋ Petero, maa tawɩ sɛ nyii na dieli sɛ yuluma gana, pɔɩ na dijimba akɔlɛ bʋla na, nyaa pɩɛ maŋ butoro sɛ n ba jiŋ maŋ ŋ.&gt;&gt;<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Sɛ Petero tawɩ baŋ dʋɔ sɛ, &lt;&lt;Dɩkɔŋ sɛ maŋ na nyaŋ dɩɩ sɩŋ gba, maa tawɩ sɛ ma ba jiŋ nyaŋ ŋ.&gt;&gt; Dɩmʋŋ sɛ wʋ kpalɛnara baa ba kakaa na gba tawɩ.<verse eid="MRK 14:31" /></para>
  <para style="s1">Yesu jɔ dɩga Gesemani</para>
  <para style="r">
    <ref loc="MAT 26:36-46">Matiyo 26:36-46</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Sɛ Yesu na wʋ kpalɛnara ju diele gaa baa yagɛ sɛ Gesemani, sɛ wʋ tawɩ wʋ kpalɛnara baa sɛ, &lt;&lt;N cha jɩna na maa ga jɔ dɩga.&gt;&gt; <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Sɛ Yesu mʋ Petero, Jamesi na Yohane kpaŋ wʋ wʋsɛ. Dɩmaŋ sɛ wʋ fara wʋ a bɔtaa sɛ wʋ jʋʋ gayɩyɩɛ. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Wʋsɛ yɔgɔsɛ su ma digela gʋ ŋii dɩlɛ mʋ maŋ ju sɩŋ naŋ. N cha jɩna na ɩ gie.&gt;&gt;<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Gʋ Yesu ju wʋ asanaŋ chonii na, sɛ wʋ laŋ fu sɛ wʋ jɔ dɩga sɛ, nafʋɔ aja yɩɛ dieli na, yela na awʋrʋfʋɔ ŋina a giligi maŋ. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Aba,<note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="ft" closed="false">Aramiki dɩtawɩ naŋ na, Aba tie akala sɛ Juo</char></note> Juo! Nyaa dɩlɛ yɩɛ bʋrʋkʋma. Yela na awʋrʋfʋɔ ŋina a giligi maŋ. Ama naa ŋii maa jawʋ ʋ, ama ŋii nyaa jawʋ na.&gt;&gt;<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Gʋ Yesu bɔrɛ ju wʋ kpalɛnara batoro baa jaŋ na, wʋ ga na gʋ ba duo. Sɛ Yesu tasɛ Petero sɛ, &lt;&lt;Simoŋ, nya duo bɛ? Nya n dɩlɛ cha karafɩɛ darɛ yela nya n duo? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />N gie na ɩ jɔ dɩga fa Ɩsʋɔ na n ba jʋʋ lɔ tɩba naŋ. Amɩɛ sʋbʋ a jawʋ, ama amɩɛ wʋsɛ bɩrɛ fʋʋ.&gt;&gt;<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Sɛ Yesu bɔrɛ ju ga jɔ dɩga tawɩ wɩɛ a dʋŋdʋlʋŋ ŋina. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Sɛ Yesu bɔrɛ kɔŋ gaa na gʋ wʋ kpalɛnara batoro baa duo akala takɩɛ asoroŋ a kʋ ba fɔɩ sɛ ba ba jiŋ bʋrʋ gaa baa tawɩ fa ɩ.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Gʋ Yesu ti bɔrɛ ju ba jaŋ butoro-tɛ na, wʋ tawɩ ba sɛ, &lt;&lt;Ɩ saŋ ɩ duo yela ɩ fɩɛsɛ? Dɩ mɩɛ! N kɩɛ, saŋa gaa talɛ, baa lɩsɛ Wʋkpa Bu wʋŋ dʋ dɩsʋbʋ yɩɛra pamɩɛ naŋ. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />N kʋlʋ na dɩ ju! N kɩɛ, wʋŋ wʋ a lɩsɛ maŋ fa na aaŋ kɔnɛ na!&gt;&gt;<verse eid="MRK 14:42" /></para>
  <para style="s1">Ba chaŋ Yesu</para>
  <para style="r">
    <ref loc="MAT 26:47-56">Matiyo 26:47-56</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Gʋ Yesu saŋ wʋ a tawɩ wʋ a fa wʋ kpalɛnara baa na, Yudasi wʋŋ wʋ yɩɛ wʋ kpirida gifi bala baa tɩba wʋrʋ na, wʋ na jama baa ba kpamɩna ɩ ba chamɩna yuo dabɩlasɛ na akolie na kɔŋ dɩmaŋ. Na Sei bɩnɩɛ, Mosesi mbara bakalaasa na dɩɛ bɩnɩɛ n kpiri ba.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Sɛ Yudasi lɩsɛrɛ wʋŋ kalaa ba daasɛ sɛ, &lt;&lt;Wʋŋ maa puga ɩ na, na wʋŋ mɩnaŋ. N chaŋ ɩ, na ɩ chaŋ wʋ tɩba na dieli na ɩ mʋ ɩ ju.&gt;&gt; <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Gabʋanaŋ dɩmaŋ sɛ Yudasi ju Yesu jaŋ sɛ wʋ tawɩ sɛ, &lt;&lt;Wʋkalaasa&gt;&gt; Sɛ wʋ puga ɩ. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Dɩmaŋ sɛ bakpa baa chaŋ Yesu sɛ ba chaŋ wʋ tɩba na doŋ. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Sɛ baa ba sɩmɩɛɩ tirina Yesu na, tɩba wʋrʋ lɩsɛ yuo dabɩla kara Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ wʋŋ tʋmɩrɛ dɩlɛ lɩsɛ.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Ma yɩɛ ŋmɩɛlɛ wʋŋ wʋ chamɩna doŋ wʋ a lɩɛ bakpa abʋrɩ bɛ sɛ ɩ mʋ yuo dabɩlasɛ na akolie ɩ kɔŋ ɩ chaŋ maŋ?&gt;&gt; <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Wɩɩ kʋma ma wɩɛ amɩɛ jaŋ Ɩsʋɔ tʋm danɛ naŋ maa kalaa amɩɛ, ama ɩŋ chaŋ maŋ ŋ. Ama ŋɩ tiri gʋ ŋina a tibi ganaŋkʋ ba sabɩɛ Sabɩɛwɩɛ ŋii naŋ na, a kɔŋ tɩba. <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Sɛ wʋ kpalɛnara baa kpiniŋ puseŋ yela ɩ.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Sɛ ba chaŋ yeleŋbu wʋrʋ wʋ fuona dɩkalala nyiŋeŋ wʋ kpamɩna Yesu. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Sɛ wʋ yela dɩkalala gaa lɔ sɛ wʋ se laŋ diboloŋ.<verse eid="MRK 14:52" /></para>
  <para style="s1">Dɩɛ naŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ a di Yesu wɩɛ</para>
  <para style="r">
    <ref loc="MAT 26:57-68">Matiyo 26:57-68</ref>; <ref loc="LUK 22:54-71">Luka 22:54-71</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Sɛ ba mʋ Yesu ju sei bɩnɩɛ naŋ bɩnɛ wʋŋ waa dʋɔ sɛ sei bɩnɩɛ, dɩɛ bɩnɩɛ na mbara bakalaasa kpiniŋ gaa sila. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Na Petero cha wʋ kpamɩna Yesu nafarɛ-nafarɛ ga jʋʋ sei bɩnɩɛ naŋ bɩnɛ wʋŋ waa gaa naŋ sɛ wʋ ga cha kɩɛra baa jaŋ wʋ a wʋlʋ bʋala.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Sei bɩnɩɛ na dɩɛ naŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ baa kpiniŋ aja wɩɛ ŋii baa sɩŋ ŋɩ dʋɔ mʋ sʋɔ Yesu na baa kʋ ɩ. Ama ba n yu u. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Sɛ bakpa fɔɩ di akarɩɛ seriya chicha Yesu, ama ba seriya ŋii n yɩɛ bʋdʋŋdʋlʋŋ ŋ.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Sɛ barɛ kʋlʋ di akarɩɛ seriya chicha Yesu sɛ, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />&lt;&lt;Dɩ nyii gʋ wʋ tawɩ sɛ maa salɩɛ Ɩsʋɔ tʋm danɛ gaa wʋkpa maa na, na maa mʋ wɩɛ atoro ma gafɔlɛ gaa naa wʋkpa n ma na.&gt;&gt; <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ama ba di akarɩɛ seriya ŋii ŋɩ ba yɩɛ bʋdʋŋdʋlʋŋ ŋ.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Sɛ sei bɩnɩɛ naŋ bɩnɛ wʋŋ kʋlʋ sɩŋ ba kpiniŋ ba asanaŋ tasɛ Yesu sɛ, &lt;&lt;Seriya ŋii baa di baa chicha nyaŋ n na, nya tana ŋɩ nʋɔ lɩsɛ?&gt;&gt; <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ama Yesu n tawɩ bʋrʋ ʋ. Sɛ sei bɩnɩɛ naŋ bɩnɛ wʋŋ ti bɔrɛ tasɛ Yesu sɛ, &lt;&lt;Nyaŋ n nyina Kirisito, Ɩsʋɔ wʋŋ dɩtʋm ɩ na Bu wʋŋ?&gt;&gt;<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Maŋ n nyina ɩ! Ɩ na Wʋkpa Bu wʋŋ wʋ chaɩ Ɩsʋɔ Doŋ-tɛ wʋŋ pam jɩsaŋ dʋɔ wʋ a lɩɩ Ɩsʋɔ tanɩɛ naŋ wʋ a kɔnɛ.&gt;&gt;<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Sɛ sei bɩnɩɛ naŋ bɩnɛ wʋŋ chati wʋ gagba, sɛ wʋ tasɛ sɛ, &lt;&lt;Be dʋɔ sɛ dɩ ti dɩ ja seriyatina barɛ?&gt;&gt; <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Ɩ nyii mbusu wɩɛ ŋii wʋ tawɩ baŋ Ɩsʋɔ na? Sɩnɛ n nyina amɩɛ nfɩɛrɛ? Sɛ ba kpiniŋ ba fu ɩ dɩpʋɛ sɛ wʋ daga sɩŋ.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Sɛ barɛ tɔ mɩtalɩŋ fu Yesu, sɛ ba mʋ dukuru pɔgʋ wʋ asa sɛ ba jɔ ɩ tasɛ ɩ sɛ, &lt;&lt;Gbala kalaa wʋŋ wʋ jɔ nyaŋ na.&gt;&gt; Sɛ kɩɛra baa mʋ ɩ ju ga tugu ɩ.<verse eid="MRK 14:65" /></para>
  <para style="s1">Petero pɩɛ Yesu</para>
  <para style="r">
    <ref loc="MAT 26:69-75">Matiyo 26:69-75</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Gʋ Petero wɩɛ waa gaa naŋ na, Sei bɩnɩɛ naŋ bɩnɛ wʋŋ tʋmɩrɛ galibiesi tɩba wʋrʋ kɔŋ dɩmaŋ. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Gʋ wʋ na Petero a wʋlʋ bʋala na, wʋ kɩɛ ɩ na dieli sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Nyaŋ gba, nya kpi Yesu Nasarati wʋkpa wʋŋ dʋɔ.&gt;&gt;<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Ama Petero pɩɛ sɛ, &lt;&lt;Ma ba jiŋ ŋ, sɛ wɩɛ ŋii nya tawɩ na gba maa nyii tie e.&gt;&gt; Sɛ Petero lɩɩ ju waa buonɔ ga wii.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Sɛ tʋmɩrɛ galibie wʋŋ ti na Petero dɩmaŋ na, wʋ ti bɔrɛ tawɩ bakpa baa ba sɩmɩɛɩ ɩ dɩmaŋ na sɛ, &lt;&lt;Baalɛ wina gba kpi Yesu kpalɛnara baa dʋɔ.&gt;&gt; <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Sɛ Petero ti bɔrɛ pɩɛ. Gʋ dɩ yɩɛ chonii na, baa ba sɩmɩɛɩ ɩ dɩmaŋ na tawɩ Petero sɛ, &lt;&lt;Gasiŋteŋ, nya yɩɛ ba tɩba wʋrʋ bɛ. Akala takɩɛ nya yɩɛ Galaliya wʋkpa bɛ.&gt;&gt;<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Sɛ Petero tawɩ nʋɔsɛ fa wʋ wʋsɛ sɛ, &lt;&lt;Ma ba jiŋ baalɛ wʋŋ ɩ tawɩ wʋ wʋsɛ dʋɔ wɩɛ n na a.&gt;&gt;<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Gabʋanaŋ sɛ dijimba kɔlɛ bʋlatɛ. Sɛ Petero nyiŋi wɩɛ ŋii Yesu tawɩ ɩ na sɛ, &lt;&lt;Pɔɩ na dijimba a kɔlɛ bʋlatɛ na, nyaa pɩɛ butoro sɛ n ba jiŋ maŋ ŋ.&gt;&gt; Sɛ wʋ wii.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">Ba mʋ Yesu ga sɩŋ Pilato asanaŋ</para>
  <para style="r">
    <ref loc="MAT 27:1-2">Matiyo 27:1-2-14</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Gʋ tɩɛna nafo na, sei bɩnɩɛ, dɩɛ bɩnɩɛ, Mosesi mbara bakalaasa na dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ kpiniŋ jɔ dɩkɔŋ ganaŋkʋ baa yɩɛ Yesu na. Ba pɔgʋ ɩ sɛ ba mʋ ɩ ju ga fa Pilato.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Sɛ Pilato tasɛ Yesu sɛ, &lt;&lt;Nyaŋ n nyina Yudatina Juo naa?&gt;&gt; Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Ŋii sɛ n tɩŋtɩŋ nya tawɩ na.&gt;&gt;<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Sɛ sei bɩnɩɛ baa pʋɩ Yesu lɩɩ wɩɛ fɔɩ dʋɔ. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Sɛ Pilato ti bɔrɛ tasɛ Yesu sɛ, &lt;&lt;Nyii, wɩɛ fɔɩ ŋii baa tawɩ baa jaga n dʋɔ na, nyaa lɩsɛ nʋɔ?&gt;&gt;<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Ama Yesu pɩɛ nʋɔ lɩsɛ sɛ dɩ yɩɛ Pilato doba.<verse eid="MRK 15:5" /></para>
  <para style="s1">Ba fu Yesu sɩŋ dɩpʋɛ</para>
  <para style="r">
    <ref loc="MAT 27:15-26">Matiyo 27:15-26</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>; <ref loc="LUK 19:16">19:16</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Bɩriŋnʋɔ kʋma dɩ tala Yudatina nyiŋi asadi adiya di na, ŋɩ yɩɛ Pilato ayɩɛsa sɛ wʋ n yela bakpa baa ba tɔ ba danɛ na tɩba wʋŋ bakpa baa a jawʋ na wʋrʋ fa ba. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Saŋa gana na, ba tɔ baalɛ wʋrʋ danɛ baa yagɛ ɩ sɛ Barabasi. Na wʋ cha kpi baa ba kʋlʋ yuo chicha Roma bɩnɩɛ baa ba wɩɛ Yudatina tibi dʋɔ sɛ wʋ kʋ ba tɩba barɛ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Sɛ bakpa baa kɔŋ Pilato jaŋ, sɛ ba tawɩ ɩ sɛ wʋ n yɩɛ fa ba takɩɛ ganaŋkʋ wʋ a yɩɛ bɩriŋnʋɔ kʋma na.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Sɛ Pilato tasɛ ba sɛ, &lt;&lt;Ɩ ja sɛ maŋ yela Yudatina Juo wʋŋ?&gt;&gt; <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Akala takɩɛ Pilato jiŋ gʋ kɔlɩŋ dʋɔ sɛ sei bɩnɩɛ baa mʋ Yesu kɔna ɩ. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Ama sei bɩnɩɛ baa fuosi dʋ jama baa sɛ ba n tawɩ Pilato sɛ wʋ n yela Barabasi fa ba.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />Sɛ Pilato ti bɔrɛ tasɛ ba sɛ, &lt;&lt;Be sɛ ɩ ja sɛ maŋ yɩɛ wʋŋ ɩ yagɛ ɩ sɛ Yudatina Juo na?&gt;&gt;<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Sɛ ba kuusi sɛ, &lt;&lt;Jɔ ɩ daŋ gasagasa dʋɔ.&gt;&gt;<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Sɛ Pilato tasɛ sɛ, &lt;&lt;Be dɩsʋbʋ sɛ wʋ yɩɛ bɛ?&gt;&gt; Ama ba kuusi na doŋ sɛ, &lt;&lt;Jɔ ɩ daŋ gasagasa dʋɔ.&gt;&gt;<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Pilato aja wʋ a yɩɛ bakpa baa digela jawʋ fa ba dʋɔ, wʋ yela Barabasi fa ba. Sɛ wʋ yela sɛ ba taɩ Yesu achʋchʋɛ sɛ wʋ mʋ ɩ fa ba sɛ ba n jɔ ɩ daŋ gasagasa dʋɔ.<verse eid="MRK 15:15" /></para>
  <para style="s1">Yuora baa jabi Yesu</para>
  <para style="r">
    <ref loc="MAT 27:27-31">Matiyo 27:27-31</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Sɛ yuora baa mʋ Yesu ju Pilato juorigbɩɛ, sɛ ba yagɛ ba dɔŋa baa kpiniŋ gaa sila. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Sɛ ba fu ɩ kirimaŋ lɩŋ gagba gajalɩŋtɛ sɛ ba mʋ sɔba lʋʋ juori gapa mʋ fu ɩ. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Sɛ ba fara baa jabi ɩ sɛ, &lt;&lt;Yudatina Juo, yu nkpa.&gt;&gt; <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Ba mʋ ŋmɩrɛ baa taɩ wʋ nyinaŋ sɛ ba tɔ mɩtalɩŋ fu ɩ. Sɛ ba luuŋ ba dʋna dʋɔ wʋ asanaŋ mʋ jabi ɩ. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Gʋ ba jabi Yesu taŋ na, ba fulu kirimaŋ lɩŋ gagba gajalɩŋtɛ gaa sɛ ba mʋ wʋ tɩŋtɩŋ wʋ gagba fu ɩ. Sɛ ba mʋ ɩ lɩɩ na baa ga jɔ ɩ daŋ gasagasa dʋɔ.<verse eid="MRK 15:20" /></para>
  <para style="s1">Ba jɔ Yesu daŋ gasagasa dʋɔ</para>
  <para style="r">
    <ref loc="MAT 27:32-44">Matiyo 27:32-44</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Gʋ yuora baa mʋ Yesu baa ju na, ba jaŋina baalɛ wʋrʋ baa yagɛ ɩ sɛ Simoŋ, Alesanda na Rufusi ba Juo wʋŋ wʋ lɩɩ Kireni na. Wʋ lɩɩ dɩɛ bie garɛ naŋ wʋ a lam sɛ yuora baa chaŋ ɩ dʋ ɩ sɛ ba mʋ daŋ gasagasa gaa sɩlɛ ɩ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Gʋ ba ga tala diele gaa baa yagɛ sɛ Goligota na [tie akala sɛ Nyi Gafie]. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Sɛ ba mʋ gafɔla lira mʋlʋŋ dʋ sʋlʋŋ naŋ fa Yesu sɛ wʋ n nyʋɔ, ama wʋ n nyʋɔ ɔ. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Gʋ ba jɔ Yesu daŋ gasagasa dʋɔ taŋ na, sɛ ba lɔ wʋ gagbasɛ dʋɔ mbi mʋ kpara fa dɔŋa.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />Yɩɛ nafo karafɩɛ saŋgʋ sɛ ba jɔ Yesu daŋ gasagasa dʋɔ. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Sɛ ba sabɩɛ wɩɛ ŋii ba sɩŋ ŋɩ dʋɔ fu Yesu dɩpʋɛ na jaga wʋ nyie dʋɔ daŋ gasagasa gaa dʋɔ sɛ,</para>
  <para style="pc" vid="MRK 15:26">
    <char style="sc">&lt;&lt;YUDATINA JUO.&gt;&gt;</char><verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />Ba jɔ ŋmɩɛla baa ba chamɩna doŋ baa lɩɛ bakpa abʋrɩ na bala barɛ gba daŋ gasagasa dʋɔ. Wʋrʋ wɩɛ wʋ pam jɩsaŋ dʋɔ sɛ wʋrʋ dʋɔ wʋ pam naŋbii dʋɔ. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Ŋina yela sɛ wɩɛ ŋii ba sabɩɛ si Ɩsʋɔ Wɩɛ naŋ na kɔŋ tɩba sɛ, &lt;&lt;Ba mʋ ɩ kpi basʋbʋɛ dʋɔ.<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Yisaya 53:12</char></note>&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Naa Ɩsʋɔ wɩɛ ŋii kpiniŋ n wɩɛna ŋina a</char></note> <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Bakpa baa baa laŋ dɩmaŋ na kpiniŋ a jigisi ba nyie baa tii ɩ baa tawɩ sɛ, &lt;&lt;Kɩɛ! Naa nyaŋ n tawɩ sɛ nyaa salɩɛ Ɩsʋɔ tʋm danɛ na nyaa mʋ wɩɛ atoro ma ga naa? <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Mɔlɔgɩ n wʋsɛ na nya tibi daŋ gasagasa gaa dʋɔ!&gt;&gt;<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Dɩmʋŋ sɛ sei bɩnɩɛ na mbara bakalaasa baa gba jabi ɩ tawɩ sɛ, &lt;&lt;Wʋ a mɔlɔgɩ barɛ, ama wʋ n dɩlɛ mɔlɔgɩ wʋ wʋsɛ ɛ. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Wʋ sɛ wʋ yɩɛ Kirisito<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="ft" closed="false">Girikitina a yagɛ Kirisito tie akala sɛ Mɔlɔgɩrɛ sɛ Yudatina a yagɛ sɛ Mesaya</char></note> na Isiralitina Juo na, wʋ n tibi lɩɩ daŋ gasagasa gaa dʋɔ na dɩ na, na dɩ lɩɛ ɩ di.&gt;&gt; Sɛ ŋmɩɛla baa ba chamɩna doŋ baa lɩɛ bakpa abʋrɩ, sɛ ba jɔ ba daŋ gasagasa dʋɔ kpi Yesu dʋɔ na gba tii ɩ.<verse eid="MRK 15:32" /></para>
  <para style="s1">Yesu sɩŋ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 27:45-56">Matiyo 27:45-56</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Gʋ dɩ tala wiita keŋkeŋ na, giteŋteŋbiri kɔŋ tibi dʋɔ kpiniŋ ga tala bʋyanɔ karafɩɛ atoro. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Karafɩɛ atoro gana naŋ na, Yesu kuusi na doŋ sɛ, <char style="tl">&lt;&lt;Eli, Eli, lama sabatani?&gt;&gt;</char> Tie akala sɛ, &lt;&lt;Ma Ɩsʋɔ, ma Ɩsʋɔ, be n yɩɛ sɛ nya yela maŋ?&gt;&gt;<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Gʋ baa ba sɩmɩɛɩ dɩmaŋ na barɛ nyii wɩɛ ŋii wʋ tawɩ na, ba tawɩ sɛ, &lt;&lt;N nyii, wʋ a yagɛ Ɩsʋɔ ɔja Eliya!&gt;&gt;<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Sɛ ba tɩba wʋrʋ se ju ga mʋ dɩchɩɛ nyʋ wayɩŋ sʋlʋŋ aŋaŋsa ŋarɛ naŋ, sɛ wʋ mʋ saga daŋ dʋɔ, sɛ wʋ jiŋna ga ju Yesu nʋɔ jaŋ sɛ wʋ n chʋchʋʋ. Sɛ wʋ tawɩ sɛ, &lt;&lt;N yela na dɩɩ kɩɛ sɛ Eliya aja wʋ a kɔŋ gaa tibi na ɩ daŋ gasagasa gaa dʋɔ yaa.&gt;&gt;<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Sɛ Yesu kuusi na doŋ sɛ wʋ sɩŋ.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Sɛ dukuru gaa ba mʋ gara Ɩsʋɔ tʋm danɛ naŋ na chati tɩba bʋla lɩɩ adugbe gaa tala tie. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Gʋ yuora gafie bɩnɛ wʋŋ sɩmɩɛɩ dɩmaŋ, sɛ wʋ na ganaŋkʋ Yesu kuusi sɛ wʋ sɩŋ na, sɛ wʋ tawɩ sɛ, &lt;&lt;Gasiŋteŋ, baalɛ wina yɩɛ Ɩsʋɔ Bu bɛ.&gt;&gt;<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Na ala barɛ dʋɔ sɩmɩɛɩ taŋasɛ baa kɩɛ. Ba tɩba barɛ n nyina Mariya Magadalini na Mariya, Yakubu pii na Yosisi ba naa na Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Na dɩmʋŋ ala bana cha kpaŋ Yesu sɛ ba kɩɛ wʋ dʋɔ gʋ wʋ cha wʋ wɩɛ Galaliya na. Ala fɔɩ baa ba cha kpaŋ ɩ ju Yerusalem na gba wɩɛ dɩmaŋ.<verse eid="MRK 15:41" /></para>
  <para style="s1">Ba wuu Yesu</para>
  <para style="r">
    <ref loc="MAT 27:57-61">Matiyo 27:57-61</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Wɩɩ gaa Yudatina a mʋ baa desina ba wʋsɛ baa daa Fɩɛsɛ wɩɩ na bʋyanɔ <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yosefu wʋŋ wʋ lɩɩ Arimatiya, wʋ yɩɛ wʋkpa kpari dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ naŋ tɩba wʋrʋ bɛ. Sɛ wʋ dana Ɩsʋɔ Juori gaa kɔnɛ, wʋ yu digela ju Pilato jaŋ ga sʋlʋ sɛ wʋ n mʋ Yesu gɩtatɛ gaa fa ɩ na wʋ a mʋ ga wuu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Gʋ Pilato nyii gʋ Yesu taŋ sɩŋ na, dɩ yɩɛ ɩ doba. Wʋ yagɛ yuora gafie bɩnɛ wʋŋ tasɛ ɩ sɛ Yesu taŋ sɩŋ? <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Gʋ Pilato nyii lɩɩ yuora gafie bɩnɛ wʋŋ jaŋ sɛ Yesu sɩŋ na, wʋ fa gbɩɛ sɛ Yosefu n ju ga mʋ Yesu gɩtatɛ ga wuu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Sɛ Yosefu ga lɩɛ dɩkalala sɛ wʋ ga sagi Yesu gɩtatɛ lɩɩ daŋ gasagasa gaa dʋɔ, sɛ wʋ mʋ dɩkalala pɔgʋ ɩ. Sɛ wʋ mʋ ɩ ga wuu akpanaŋ bʋɔ naŋ. Sɛ wʋ gbiliti bʋɩ gajanɛ garɛ mʋ tɔ bʋɔ gaa nʋɔ. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Sɛ Mariya Magadalini na Mariya, Yosisi wʋnaa ga na diele gaa wʋ wuu Yesu na.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">Yesu feŋ lɩɩ sɩŋ naŋ</para>
  <para style="r">
    <ref loc="MAT 28:1-8">Matiyo 28:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Fɩɛsɛ wɩɩ lam na, Mariya Magadalini, Jamesi wʋnaa Mariya, na Salome lɩɛ wuu fʋagɩɛ tii alifeŋsa na baa mʋ ga susaa Yesu gɩtatɛ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Fɩɛsɛ wɩɩ wʋrʋgbɩɛ wɩɩ gaa ga dɔŋ soji asanaŋ na nafo fuu, ala baa cha ba dɔŋ baa ju akpanaŋ bʋɔ gaa dʋɔ. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Gʋ ba dɔŋ gbɩɛ naŋ baa ju na, sɛ ba tasɛ dɔŋa sɛ, &lt;&lt;Mmʋɔ aaŋ ja wʋ a ga gbiliti bʋɩ janɛ gaa lɩɩ akpanaŋ bʋɔ gaa nʋɔ fa daa?&gt;&gt;<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Ama ba kɩɛ ba asanaŋ na, ba na gʋ bʋɩ janɛ gaa ga fuwei akpanaŋ bʋɔ gaa nʋɔ na, gbiliti lɩɩ dɩmaŋ. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Gʋ ba jʋʋ akpanaŋ bʋɔ gaa naŋ na, ba na yeleŋbu wʋrʋ wʋ fuona gagbasɛ afʋlʋma ajalɩŋtina wʋ chaɩ pam jɩsaŋ dʋɔ. Sɛ nyɩŋtɩɛ chaŋ ba.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Sɛ yeleŋbu wʋŋ tawɩ ba sɛ, &lt;&lt;N baa yela nyɩŋtɩɛ a chaŋ amɩɛ. Ma jiŋ gʋ Yesu wʋŋ wʋ lɩɩ Nasarati sɛ ba jɔ ɩ daŋ gasagasa dʋɔ na sɛ ɩ jawʋ. Wʋ taŋ jɩna a. Wʋ feŋ lɩɩ sɩŋ naŋ. N gaa kɩɛ diele gaa ba cha mʋ wʋ gɩtatɛ si na. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Sɛ wʋ tawɩ sɛ ba n ju ga tawɩ Petero na kpalɛnara baa sɛ Yesu pala amɩɛ asanaŋ wʋ a ju Galaliya. Dɩmaŋ sɛ ɩ ga na ɩ, ganaŋkʋ wʋ fɩla tawɩ amɩɛ na.&gt;&gt;<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Sɛ ba mʋ nyɩŋtɩɛ na wʋsɛ selesi se lɩɩ gachaŋ gaa naŋ. Ba n tawɩ wɩɛ ŋarɛ fa wʋrʋ ʋ, akala takɩɛ nyɩŋtɩɛ chaŋ ba.<verse eid="MRK 16:8" /></para>
  <para style="s">Yesu lɩsɛ wʋ wʋsɛ kalaa Mariya Magadalini</para>
  <para style="r">
    <ref loc="MAT 28:9-10">Matiyo 28:9-10</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />
    <note caller="+" style="f">
      <char style="fr" closed="false">16:9 </char>
      <char style="ft" closed="false">Ɩsʋɔ sabɩɛ na gɩbɩnɩŋ Sabɩɛwɩɛ ŋii tana Maakɩ 16:9-20</char>
    </note> Fɩɛsɛ wɩɩ wʋrʋgbɩɛ wɩɩ gaa ga dɔŋ asanaŋ na nafo, gʋ Yesu feŋ lɩɩ sɩŋ naŋ na, wʋ chɩŋkpɩɛ lɩsɛ wʋ wʋsɛ kalaa Mariya Magadalini wʋŋ wʋ cha geŋ feliŋ basʋbʋɛ lɩkaarɛ lɩɩ wʋ tɩba na. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Sɛ wʋ ju ga tawɩ Yesu kpalɛnara baa baa yɩyɩɛ yela baa wii na. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Gʋ ba nyii gʋ Yesu feŋ kɔŋ nkpa naŋ sɛ Mariya Magadalini na ɩ na, ba n lɩɛdi i.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesu lɩsɛ wʋ wʋsɛ kalaa kpalɛnara bala barɛ</para>
  <para style="r">
    <ref loc="LUK 24:13-35">Luka 24:13-35</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Yesu feŋ lɩɩ sɩŋ naŋ wʋrʋgbɩɛ na, wʋ lɩsɛ wʋ wʋsɛ gbɩɛ gafɔlɛ dʋɔ kalaa wʋ kpalɛnara baa tɩba bala saŋa gaa ba dɔŋ gbɩɛ naŋ baa ju dɩɛ bie garɛ naŋ. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Sɛ ba bɔrɛ ga tawɩ baa ba kakaa na, ama ba n lɩɛ di i.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesu lɩsɛ wʋ wʋsɛ kalaa kpirida gifi darɛ baa</para>
  <para style="r">
    <ref loc="MAT 28:16-20">Matiyo 28:16-20</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="ACT 1:6-8">Dɩtʋm 1:6-8</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Ŋina wʋrʋgbɩɛ na, Yesu ti bɔrɛ lɩsɛ wʋ wʋsɛ kalaa wʋ kpirida gifi darɛ baa saŋa gaa baa di na. Sɛ wʋ tawɩ baŋ ba gʋ ba n lɩɛ di na ba agela doŋ ŋii ba wɩɛna, sɛ ba n lɩɛ baa ba na ɩ gʋ wʋ feŋ lɩɩ sɩŋ naŋ na wɩɛ ŋii di i.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N ju dulunya gapɩlɛkʋma ga tawɩ Ɩsʋɔ Wɩɛ Abama ŋii fa wʋkʋma. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Wʋkʋma wʋŋ wʋ aa lɩɛ di sɛ ba sɔ ɩ Ɩsʋɔ sɔ na, wʋ a yu nkpa. Ama wʋkʋma wʋŋ wʋ a lɩɛ wʋ a di i, Ɩsʋɔ aja fu ɩ dɩpʋɛ. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Baa ba lɩɛ di na, daasɛ ŋii ŋii kpaŋ ba na n nyina sɛ, ma yɩrɛ naŋ, baa geŋ feliŋ sʋbʋ na baa tawɩ atawɩ afɔlɩɛ. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Baa chaŋ dʋmɩɛ tɩba na baa nyʋɔ ti gakʋʋsa, ama ŋɩ ɩɩ yɩɛ ba bʋrʋ ʋ. Baa mʋ ba pamɩɛ jaga lʋmɩɛtina dʋɔ, na baa yu alaŋfiya.&gt;&gt;<verse eid="MRK 16:18" /></para>
  <para style="s1">Yesu ju Ɩsʋɔ adugbe</para>
  <para style="r">
    <ref loc="LUK 24:50-53">Luka 24:50-53</ref>; <ref loc="ACT 1:9-11">Dɩtʋm 1:9-11</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Gʋ Kpaŋjuo Yesu tawɩ fa kpirida gifi darɛ baa taŋ na, sɛ Ɩsʋɔ mʋ ɩ ju Ɩsʋɔ adugbe ga chasɛ wʋ pam jɩsaŋ dʋɔ. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Sɛ Yesu kpalɛnara baa ju ga tawɩ Ɩsʋɔ Wɩɛ Abama ŋii gapɩlɛkʋma. Sɛ Kpaŋjuo Yesu fa doŋ sɛ daasɛ kpaŋ na ŋii kalaa takɩɛ wɩɛ ŋii ba tawɩ na yɩɛ gasiŋteŋ.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>