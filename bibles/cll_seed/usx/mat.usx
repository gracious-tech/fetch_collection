<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">-Chala</book>
  <para style="h">Matiyo</para>
  <para style="toc1">Yesu Kirisito Wɩɛ Abama Ŋii Ganaŋkʋ Matiyo Sabɩɛ</para>
  <para style="toc2">Matiyo</para>
  <para style="toc3">Mt</para>
  <para style="mt2">Yesu Kirisito Wɩɛ Abama Ŋii Ganaŋkʋ</para>
  <para style="mt1">Matiyo</para>
  <para style="mt2">Sabɩɛ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Yesu Kirisito duluŋ naŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Yesu Kirisito duluŋ naŋ yɩrɩɛ mɩnaŋ. Yesu Kirisito yɩɛ Juo Dawidi ganana bie bɛ sɛ wʋ ti wʋ yɩɛ Abiraham ganana bie.<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Abiraham bu n nyina Isaki,</para>
  <para style="li1" vid="MAT 1:2">sɛ Isaki bu n nyina Yakubu</para>
  <para style="li1" vid="MAT 1:2">Yakubu bu n nyina Yuda na wʋ nabie.<verse eid="MAT 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3" />Yuda bie n nyina Peresi na Sera ba naa n nyina Tama.</para>
  <para style="li1" vid="MAT 1:3">Peresi bu n nyina Hesiroŋ,</para>
  <para style="li1" vid="MAT 1:3">sɛ Hesiroŋ bu n nyina Ram.<verse eid="MAT 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4" />Ram bu n nyina Aminadabi,</para>
  <para style="li1" vid="MAT 1:4">sɛ Aminadabi bu n nyina Naasoŋ,</para>
  <para style="li1" vid="MAT 1:4">sɛ Naasoŋ bu n nyina Salimoŋ.<verse eid="MAT 1:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5" />Salimoŋ bu n nyina Bowasi wʋnaa n nyina Rahabu,</para>
  <para style="li1" vid="MAT 1:5">sɛ Bowasi bu n nyina Obedi wʋnaa n nyina Ruti,</para>
  <para style="li1" vid="MAT 1:5">sɛ Obedi bu n nyina Yese.<verse eid="MAT 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6" />Yese bu n nyina juo Dawidi.</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li1" vid="MAT 1:6">Juo Dawidi bu n nyina Solomoŋ. Dawidi na alʋ wʋrʋ wʋŋ nafʋɔ wʋ yɩɛ Yuriya alʋ na n lʋrʋ Solomoŋ.<verse eid="MAT 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7" />Solomoŋ bu n nyina Rehobowam.</para>
  <para style="li1" vid="MAT 1:7">Rehobowam bu n nyina Abiya,</para>
  <para style="li1" vid="MAT 1:7">sɛ Abiya bu n nyina Asa.<verse eid="MAT 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8" />Asa bu n nyina Yehosafati,</para>
  <para style="li1" vid="MAT 1:8">sɛ Yehosafati bu n nyina Yehoram,</para>
  <para style="li2" vid="MAT 1:8">sɛ Yehoram bu n nyina Yosiyasi.<verse eid="MAT 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9" />Yosiyasi bu n nyina Yotam,</para>
  <para style="li1" vid="MAT 1:9">sɛ Yotam bu n nyina Ahasi.</para>
  <para style="li1" vid="MAT 1:9">Ahasi bu n nyina Hesekiya.<verse eid="MAT 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10" />Sɛ Hesekiya bu n nyina Manase,</para>
  <para style="li1" vid="MAT 1:10">sɛ Manase bu n nyina Amoŋ.</para>
  <para style="li1" vid="MAT 1:10">Amoŋ bu n nyina Yosiyasi.<verse eid="MAT 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11" />Yosiyasi bie n nyina Yekoniya na wʋ nabie. Dɩmʋŋ saŋa gana sɛ Babiloŋtina yuo chaŋ Isiralitina mʋ ba ju ba tibi dʋɔ.<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="MAT 1:12" />Gʋ ba mʋ ba ju ba tibi dʋɔ wʋrʋgbɩɛ na,</para>
  <para style="li1" vid="MAT 1:12">sɛ Yekoniya lʋrʋ Salatiya,</para>
  <para style="li1" vid="MAT 1:12">sɛ Salatiya dʋɔ bu nyina Serubabeli,<verse eid="MAT 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13" />Serubabeli bu n nyina Abiwudi.</para>
  <para style="li1" vid="MAT 1:13">Abiwudi bu n nyina Eliyakim,</para>
  <para style="li1" vid="MAT 1:13">sɛ Eliyakim bu n nyina Asori.<verse eid="MAT 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14" />Asori bu n nyina Sadoki,</para>
  <para style="li1" vid="MAT 1:14">Sɛ Sadoki bu n nyina Akim.</para>
  <para style="li1" vid="MAT 1:14">Akim bu n nyina Eliwudi,<verse eid="MAT 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15" />Eliwudi bu n nyina Eleyasa,</para>
  <para style="li1" vid="MAT 1:15">Eleyasa bu n nyina Mataŋ,</para>
  <para style="li1" vid="MAT 1:15">sɛ Mataŋ bu n nyina Yakubu.<verse eid="MAT 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16" />Yakubu bu n nyina Yosefu, wʋ alʋ n nyina Mariya wʋŋ wʋ lʋrʋ Yesu wʋŋ baa yagɛ sɛ Kirisito na.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Lɩɩ Abiraham saŋa mʋ gaa tala Juo Dawidi saŋa na, ba cha ba yɩɛ duluŋ gifi banara. Lɩɩ saŋa gaa Babiloŋtina yuo chaŋ Isiralitina mʋ ba ju ba tibi dʋɔ na, ba cha ba yɩɛ duluŋ gifi banara. Lɩɩ saŋa gaa Babiloŋtina yuo chaŋ Isiralitina mʋ ba ju ba tibi dʋɔ na mʋ gaa tala gʋ ba lʋrʋ Kirisito na, wʋ duluŋ cha ba yɩɛ gifi banara.<verse eid="MAT 1:17" /></para>
  <para style="s1">Yesu Kirisito lʋrʋ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="LUK 2:1-7">Luka 2:1-7</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ŋina n nyina Yesu Kirisito lʋrʋ dʋɔ wɩɛ. Ba mʋ Mariya fa Yosefu sarɛ. Pɔɩ na baa saa na, ba na gʋ wʋ dɔŋna fɩlɩ gaa ga lɩɩ Ɩsʋɔ Feliŋ naŋ. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Gʋ Yosefu wʋŋ wʋ a kɔŋ wʋ a gaa saa Mariya yɩɛ wʋ chirigisa dʋɔ, wʋ aa ja sɛ wʋ a ŋaba Mariya bakpa naŋ ŋ. Dɩmʋŋ dʋɔ wʋ yɩɛ wʋ nfɩɛrɛ sɛ wʋ a yela ɩ sarɛ yela wʋrʋ n na a.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Gʋ Yosefu fa nfɩɛrɛ ŋina na, kɩɛ Ɩsʋɔ gabʋɔ lɩsɛ wʋ wʋsɛ kalaa ɩ duosi naŋ tawɩ ɩ sɛ, &lt;&lt;Yosefu, Juo Dawidi ganana bie, n baa se nyɩŋtɩɛ na nyaa mʋ Mariya takɩɛ nya alʋ. Akala takɩɛ wʋ fɩlɩ gaa lɩɩ Ɩsʋɔ Feliŋ naŋ bɛ. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Wʋ a lʋrʋ bu baalɛ na ɩ yagɛ ɩ sɛ Yesu. Akala takɩɛ wʋŋ aaŋ ja wʋ a gaa mɔlɔgɩ wʋ bakpa lɩɩ dɩsʋbʋ naŋ.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ŋina kpiniŋ kɔŋ tɩba ganaŋkʋ Ɩsʋɔ wɩɛ ŋii wʋ pala na wʋ bajana dʋɔ tawɩ na, a kɔŋ tɩba sɛ, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Galibie wʋŋ wʋ ba jiŋ baalɛ na aja yu fɩlɩ na wʋ a lʋrʋ bu baalɛ, na baa yagɛ ɩ sɛ Imanuweli&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">Yis 7:14</ref>.</char></note> Gaa ga tie akala sɛ, &lt;&lt;Ɩsʋɔ wɩɛ daa jaŋ.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Gʋ Yosefu feŋ na, wʋ yɩɛ ganaŋkʋ Ɩsʋɔ gabʋɔ wʋŋ tawɩ ɩ na. Sɛ wʋ mʋ Mariya ju wʋ waa dʋɔ takɩɛ wʋ alʋ <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ama Yosefu n duo na Mariya a mʋ ga tala gʋ wʋ lʋrʋ bu baalɛ. Sɛ Yosefu sii ɩ yɩrɛ sɛ Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Kpiŋjimtina baa ba lɩɩ dɩlɩɩtɩŋ na wʋsɛ dʋɔ wɩɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Ba lʋrʋ Yesu Betilehem gaa ga wɩɛ Yudiya tibi dʋɔ, dɩmʋŋ saŋa gana na Hɛrɔdɩ n nyina Juo. Wʋ lʋrʋ wʋrʋgbɩɛ na, kpiŋjimtina barɛ lɩɩ dɩlɩɩtɩŋ kɔŋ Yerusalem <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />gaa tasɛ sɛ, &lt;&lt;Le sɛ ba lʋrʋ wʋchaa fɔlɛ wʋŋ wʋ a gaa yɩɛ Yudatina Juo naa? Dɩ na wʋ gachikpebi wiita dɩlɩɩtɩŋ sɛ dɩ kɔŋ na dɩ gaa tʋŋ ɩ.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Gʋ Juo Hɛrɔdɩ nyii dɩmʋŋ wɩɛ ŋina na, wʋ na Yerusalemtina kpiniŋ agela warɩɛ ba. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Dɩmʋŋ dʋɔ wʋ yagɛ Ɩsʋɔ sei bɩnɩɛ kpiniŋ na Mosesi mbara bakalaasa gaa jaŋi tasɛ ba sɛ, &lt;&lt;Le sɛ baa lʋrʋ Kirisito<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">Girikitina a yagɛ sɛ Kirisito sɛ Yudatina dʋɔ a yagɛ sɛ Mesaya </char></note> wʋŋ naa?&gt;&gt; <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Sɛ ba lɩsɛ ɩ nʋɔ sɛ Betilehem gaa ga wɩɛ Yudiya tibi dʋɔ. Akala takɩɛ Ɩsʋɔ pala na wʋ bajana dʋɔ sabɩɛ si sɛ,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt;Nyaŋ Betilehem, gaa ga wɩɛ Yuda tibi dʋɔ,</para>
  <para style="q2" vid="MAT 2:6">n ba yɩɛ wʋ pii dɩɛsɛ ajanɩɛ ŋii ŋɩ wɩɛ Yuda tibi dʋɔ na naŋ ŋ.</para>
  <para style="q1" vid="MAT 2:6">Akala takɩɛ n tɩba sɛ asanaŋtɛ wʋjanɛ aja lɩɩ</para>
  <para style="q2" vid="MAT 2:6">na wʋ a yɩɛ kɩɛrɛ fa ma bakpa Isiralitina.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Mik 5:2</ref>.</char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Sɛ Juo Hɛrɔdɩ yagɛ kpiŋjimtina baa lɩɩ laraŋ, sɛ wʋ tasɛ ba na wʋ a jiŋ saŋa gaa gachikpebi wʋŋ lɩɩ na. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Sɛ wʋ kpiri ba Betilehem tawɩ ba sɛ, &lt;&lt;N ju ga ja wʋchaa fɔlɛ wʋŋ na dieli. Ɩ na ɩ na n kɔŋ gaa tawɩ maŋ na maŋ gba maa ju ga tʋŋ ɩ.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Gʋ ba nyii Juo wʋŋ jaŋ taŋ na ba lɩɩ dɩmaŋ laŋ. Gʋ baa ju na, ba ti na gachikpebi wʋŋ ba chɩŋkpɩɛ na ɩ wiita dɩlɩɩtɩŋ na dɔŋ ba asanaŋ ga tala gʋ wʋ ga dʋɔsɩŋ waa gaa wʋchaa fɔlɛ wʋŋ wɩɛ ga tɩba na kʋrʋkʋrʋ. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Gʋ ba na gachikpebi wʋŋ na, ba asadi galaŋ. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Gʋ ba jʋʋ waa gaa tɩba na, ba na wʋchaa fɔlɛ wʋŋ na wʋ naa Mariya sɛ ba luuŋ tʋŋ ɩ. Sɛ ba buoli ba akpaŋta kpari didaka lɩsɛ aterembie asɩɛma, mʋlʋŋ tii alifeŋsa na ɩnsɛnsɩ gafɔla lira mʋ fa ɩ takɩɛ afaasa. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ɩsʋɔ cha jɔ kpiŋjimtina baa nyienaŋ duosi naŋ sɛ ba n baa ti bɔrɛ ju Juo Hɛrɔdɩ jaŋ. Dɩmʋŋ dʋɔ ba mʋna gbɩɛ fɔlɛ dʋɔ bɔrɛ ju ba dɩɛnaŋ.<verse eid="MAT 2:12" /></para>
  <para style="s1">Ba mʋ Yesu se ju Ijipiti</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Gʋ kpiŋjimtina baa lam wʋrʋgbɩɛ na, Ɩsʋɔ gabʋɔ kɔŋ gaa lɩsɛ wʋ wʋsɛ kalaa Yosefu duosi naŋ tawɩ ɩ sɛ, &lt;&lt;Kʋlʋ mʋ wʋchaa wʋŋ na wʋ naa se ju Ijipiti tibi dʋɔ. N cha dɩmaŋ ga tala saŋa gaa maa tawɩ amɩɛ sɛ n lɩɩ dɩmaŋ. Akala takɩɛ Hɛrɔdɩ aja wʋchaa wʋŋ na wʋ a kʋ ɩ.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Dɩmʋŋ dʋɔ Yosefu kʋlʋ mʋ wʋchaa wʋŋ na wʋ naa dɩmʋŋ yuluma gana ju Ijipiti, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Sɛ ba cha dɩmaŋ ga tala gʋ Juo Hɛrɔdɩ sɩŋ. Ŋina tibi ganaŋkʋ wɩɛ ŋii Ɩsʋɔ pala na wʋ ɔja dʋɔ tawɩ si na a kɔŋ tɩba sɛ, &lt;&lt;Ijipiti tibi dʋɔ sɛ maa yagɛ mabu.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hos 11:1</ref>.</char></note><verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Gʋ Juo Hɛrɔdɩ jiŋ gʋ kpiŋjimtina baa pɩna ɩ na wʋ kara biŋbira fɔɩ. Sɛ wʋ dʋ wʋ yuora baa sɛ baŋ kʋ bachaasɛ baala jaŋ baa ba tala bɩŋsɛ sɩla na baa ba n tala ta bɩŋsɛ sɩla sɛ ba wɩɛ Betilehem na ga dɩɛsɛ bisi kpiniŋ naŋ. Wʋ tawɩ dɩmʋŋ akala takɩɛ lɩɩ saŋa gaa wʋ nyii lɩɩ kpiŋjimtina baa jaŋ na, wʋchaa wʋŋ aja wɩɛ dɩmʋŋ bɩŋsɛ ŋina tɩba. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Ŋina yela sɛ wɩɛ ŋii Ɩsʋɔ pala na wʋ ɔja Yeremiya dʋɔ tawɩ si na kɔŋ tɩba sɛ,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Lofu garɛ nyii lɩɩ Rama,</para>
  <para style="q2" vid="MAT 2:18">wiiniŋ na doŋ dʋɔ wiiniŋ,</para>
  <para style="q1" vid="MAT 2:18">Raheli a wii wʋ bie,</para>
  <para style="q2" vid="MAT 2:18">sɛ wʋ pɩɛ tawɩ dʋ,</para>
  <para style="q2" vid="MAT 2:18">akala takɩɛ ba sɩŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Yere 31:15</ref>.</char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">Yosefu bɔsɩna Yesu ju Nasarati</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Juo Hɛrɔdɩ sɩŋ wʋrʋgbɩɛ na, Ɩsʋɔ gabʋɔ lɩsɛ wʋ wʋsɛ kalaa Yosefu duosi naŋ Ijipiti <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Kʋlʋ, mʋ wʋchaa wʋŋ na wʋ naa bɔrɛ ju Isirali tibi dʋɔ akala takɩɛ baa baa ja wʋchaa wʋŋ baa kʋ na sɩŋ.&gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Dɩmʋŋ dʋɔ wʋ kʋlʋ mʋ wʋchaa wʋŋ na wʋ naa bɔrɛ ju Isirali tibi dʋɔ. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ama gʋ wʋ nyii sɛ Hɛrɔdɩ bu Akilayosi n baŋ wʋ juo nafara naŋ di Juo Yudiya tibi dʋɔ na, dɩ yɩɛ ɩ nyɩŋtɩɛ na dɩmaŋ ju. Ɩsʋɔ cha jɔ wʋ nyinaŋ duosi naŋ sɛ wʋ n baa ju dɩmaŋ, dɩmʋŋ dʋɔ wʋ ju Galaliya tibi dʋɔ. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Sɛ wʋ ju ga cha Nasarati dɩɛ naŋ. Ŋina yela sɛ wɩɛ ŋii Ɩsʋɔ pala na wʋ bajana dʋɔ tawɩ si na kɔŋ tɩba sɛ, Baa yagɛ ɩ sɛ Nasarati wʋkpa.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Yohane Ɩsʋɔ Sɔrɛ tawɩ Ɩsʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 1:1-8">Maakɩ 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Saŋa gana naŋ Yohane Ɩsʋɔ Sɔrɛ kɔŋ Yudiya ifuli dʋɔ gaa jɔ Ɩsʋɔ wɩɛ dawuta <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />sɛ, &lt;&lt;N biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ na ɩ kɔŋ Ɩsʋɔ jaŋ akala takɩɛ Ɩsʋɔ Juori gaa tirina.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohane wina sɛ Ɩsʋɔ pala na ɔja Yisaya dʋɔ chɩŋkpɩɛ sabɩɛ Ɩsʋɔ wɩɛ si sɛ,</para>
  <para style="q1" vid="MAT 3:3">Lofu garɛ a kuusi ifuli dʋɔ sɛ,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Desina gbɩɛ si fa Kpaŋjuo wʋŋ,</para>
  <para style="q2" vid="MAT 3:3">na ɩ chirigi gbɩɛ fa ɩ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Yis 40:3</ref>.</char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohane gagba gaa wʋ cha wʋ fuona na, nyɔma fʋŋda sɛ ba mʋ lʋ ga, sɛ wʋ mʋ nam tanɛ tɩŋa naŋ ganya pɔgʋ wʋ tɩŋa naŋ. Wʋ adiya ŋii wʋ a di na yɩɛ aforo na tɩbʋɔ lɩŋ. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Bakpa lɩɩ Yerusalem dɩɛ naŋ, Yudiya tibi dʋɔ kpiniŋ na tibi gaa ga tirina Yodaŋ buo na kpiniŋ kɔŋ wʋ jaŋ. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Gʋ ba kɔnɛ na ba tawɩ ba dɩsʋbʋ sɛ wʋ sɔ ba Ɩsʋɔ sɔ Yodaŋ buo naŋ.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Gʋ Yohane na Farasitina na Sadukitina baa kpiniŋ kɔŋ wʋ jaŋ sɛ wʋŋ sɔ ba Ɩsʋɔ sɔ na, sɛ wʋ tawɩ ba sɛ, &lt;&lt;Dʋmɩɛ sɔrɛtina, Mmʋɔ n jɔ amɩɛ nyienaŋ sɛ n se lɩɩ Ɩsʋɔ biŋbira ŋii wʋ chamɩna wʋ a kɔŋ amɩɛ dʋɔ na?&gt;&gt; <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />N yela na amɩɛ ayɩɛsa a kalaa takɩɛ ɩ biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />N baa fa nfɩɛrɛ na ɩ tawɩ amɩɛ wʋsɛ sɛ, &lt;&lt;Abiraham yɩɛ daa duluŋ bɛ.&gt;&gt; Maa tawɩ amɩɛ sɛ, Ɩsʋɔ a dɩlɛ mʋ bʋɛ ŋina yɩɛ ganana bie fa Abiraham. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ba fɩla mʋ dɩkpaŋfa ga jaga dasɛ ŋii lira dʋɔ, daŋ kʋma gaa gaa si bie abama na, baa wʋŋ ga lɔ na baa mʋ lɔ dʋ bʋala naŋ.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Wʋ tawɩ bakpa baa sɛ, &lt;&lt;Maŋ bɩrɛ, ma mʋ lɩŋ bɛ sɔ amɩɛ Ɩsʋɔ sɔ na ŋii kalaa sɛ ɩ biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ. Ama wʋŋ wʋ a kɔŋ ma wʋrʋgbɩɛ na yɩɛ wʋ janɛ kii maŋ, ma n daga na maa sɩlɛ wʋ asibita a. Wʋŋ bɩrɛ, Ɩsʋɔ Feliŋ ŋii na bʋala sɛ wʋ a mʋ sɔ amɩɛ.&gt;&gt; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Wʋ chamɩna bʋrʋ gafalɩsa wʋ pam naŋ na wʋ a mʋ fala lɩsɛ gamɩsɛ lɩɩ duofu naŋ ŋɩ dɩkpalaŋ naŋ, na wʋ a kui bie ŋii dʋ wʋ dichonkon naŋ. Ama duofu ŋii bɩrɛ, wʋ a tʋ ŋɛ bʋala gaa gaa dum na naŋ.<verse eid="MAT 3:12" /></para>
  <para style="s1">Yohane sɔ Yesu Ɩsʋɔ sɔ</para>
  <para style="r">
    <ref loc="MRK 1:9-11">Maakɩ 1:9-11</ref>; <ref loc="LUK 3:21-22">Luka 3:21-22</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Yesu lɩɩ Galaliya tibi dʋɔ kɔŋ Yohane Ɩsʋɔ Sɔrɛ wʋŋ jaŋ sɛ wʋ n sɔ ɩ Ɩsʋɔ sɔ Yodaŋ buo naŋ. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ama Yohane pɩɛ sɛ wʋ tawɩ sɛ, &lt;&lt;Maŋ n daga na nyaa sɔ maŋ Ɩsʋɔ sɔ sɛ nyaŋ n kɔŋ ma jaŋ?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Ama Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Saŋa gana yela na a yɩɛ dɩmʋŋ. Dɩ daga na dɩɩ yɩɛ ŋina ganaŋkʋ Ɩsʋɔ jawʋ a kɔŋ tɩba. Sɛ Yohane nyii tie.&gt;&gt;<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Gʋ Yohane sɔ Yesu Ɩsʋɔ sɔ taŋ sɛ wʋ lɩɩ lɩŋ ŋii naŋ na, kɩɛ gabʋanaŋ sɛ Ɩsʋɔ adugbe fulu sɛ wʋ na gʋ Ɩsʋɔ Feliŋ tibi a kɔŋ wʋ dʋɔ takɩɛ juori gakuo na duoni ŋmaŋi. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Sɛ lofu lɩɩ Ɩsʋɔ adugbe kɔŋ sɛ, &lt;&lt;Wina n nyina mabu wʋŋ maa ja wʋ wɩɛ, ma asa su wʋ dʋɔ.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Sɩtanɩ yɩɛ Yesu lɔ tɩba</para>
  <para style="r">
    <ref loc="MRK 1:12-13">Maakɩ 1:12-13</ref>; <ref loc="LUK 4:1-13">Luka 4:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Sɛ Ɩsʋɔ Feliŋ mʋ Yesu ju ifuli dʋɔ sɛ Sɩtanɩ n ga yɩɛ ɩ lɔ tɩba. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Gʋ wʋ chaŋ nʋɔ pɔgʋ wɩɛ ŋɩla wiita na yuluma wʋrʋgbɩɛ na, dusoŋ chaŋ ɩ. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Sɛ Sɩtanɩ kɔŋ gaa tawɩ ɩ sɛ, &lt;&lt;Sɛ nyaŋ n nyina Ɩsʋɔ Bu na, tawɩ bʋɛ ŋina na ŋii bɩrɩŋsɛ adiya.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Ba sabɩɛ Ɩsʋɔ wɩɛ naŋ sɛ adiya nyiŋeŋ baa fa wʋkpa nkpa a. Ama wɩɛ kʋma ŋii ŋɩ lɩɩ Ɩsʋɔ nʋɔ naŋ na.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Ditiro 8:3</ref>.</char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Sɛ Sɩtanɩ ti mʋ Yesu ju dɩɛ chɩrɩchɩrɩ naŋ sɛ wʋ mʋ ɩ ga sɩŋ Ɩsʋɔ tʋm danɛ adugbe. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Sɛ nyaŋ n nyina Ɩsʋɔ Bu na, puli lɩɩ jɩna ga tala tibi.&gt;&gt; Akala takɩɛ, ba sabɩɛ Ɩsʋɔ wɩɛ naŋ sɛ,</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt;&lt;Ɩsʋɔ aja kpiri wʋ gabʋɔsɛ na baa gaa gara nyaŋ.</para>
  <para style="q2" vid="MAT 4:6">Baa chaŋ n tɩba ba pamɩɛ naŋ</para>
  <para style="q1" vid="MAT 4:6">na n nafara n baa baŋ bʋɩ.&gt;<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Num 91:11-12</ref>.</char></note>&gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Ba ti sabɩɛ Ɩsʋɔ wɩɛ naŋ sɛ, &lt;N baa yɩɛ Kpaŋjuo nya Ɩsʋɔ lɔ tɩba.&gt;<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Ditiro 6:16</ref>.</char></note>&gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Ŋina wʋrʋgbɩɛ na, Sɩtanɩ ti bɔrɛ mʋ Yesu ju bʋrɔŋ janɛ garɛ dʋɔ ga kalaa ɩ dulunya Juori kpiniŋ na ga tɩba jilima. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Nyaa luuŋ tʋm maŋ na, maa mʋ ŋina kpiniŋ fa nyaŋ.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Sɩtanɩ lɩɩ ma jaŋ, ba sabɩɛ Ɩsʋɔ wɩɛ naŋ sɛ, &lt;Tʋm Kpaŋjuo nya Ɩsʋɔ na nyaa tʋŋ wʋ nyiŋeŋ.&gt;<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Ditiro 6:13</ref>.</char></note>&gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Dɩmaŋ sɛ Sɩtanɩ yela ɩ, sɛ Ɩsʋɔ gabʋɔsɛ kɔŋ gaa kɩɛ wʋ dʋɔ.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu fara wʋ dɩtʋm</para>
  <para style="r">
    <ref loc="MRK 1:14-15">Maakɩ 1:14-15</ref>; <ref loc="LUK 4:14-15">Luka 4:14-15</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Gʋ Yesu nyii gʋ ba tɔ Yohane danɛ na, wʋ bɔrɛ ju Galaliya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Sɛ wʋ lɩɩ Nasarati ju ga cha Kapeniyum gaa ga tirina Galaliya lɩɩ nʋɔ sɛ ga wɩɛ Sebuluŋ na Nafitali tibi dʋɔ na. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Ŋina yela sɛ wɩɛ ŋii Ɩsʋɔ ɔja Yisaya tawɩ si na kɔŋ tɩba<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />sɛ, &lt;&lt;Sebuluŋ tibi na Nafitali tibi</para>
  <para style="q2" vid="MAT 4:15">ŋii ŋɩ wɩɛ ɔpʋ gbɩɛ dʋɔ gaa</para>
  <para style="q2" vid="MAT 4:15">ga wɩɛ Yodaŋ buo gatɩɛsa,</para>
  <para style="q2" vid="MAT 4:15">na Galaliya tibi dʋɔ, baa ba ba yɩɛ Yudatina dɩ chaɩ.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Bakpa baa ba chaɩ giteŋteŋbiri naŋ na,</para>
  <para style="q2" vid="MAT 4:16">na ŋmaŋi janɛ</para>
  <para style="q1" vid="MAT 4:16">baa ba chaɩ nyɩŋtɩɛ sɩŋ tibi dʋɔ na,</para>
  <para style="q2" vid="MAT 4:16">ŋmaŋi kɔŋ fa ba.&gt;&gt; <note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1">Yis 9:1</ref>.</char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Lɩɩ saŋa gana sɛ Yesu fara wʋ a tawɩ Ɩsʋɔ wɩɛ abama ŋii sɛ, &lt;&lt;N biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ kɔŋ Ɩsʋɔ jaŋ, akala takɩɛ Ɩsʋɔ Juori gaa tirina.&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s1">Yesu yagɛ aji chamara banara barɛ</para>
  <para style="r">
    <ref loc="MRK 1:16-20">Maakɩ 1:16-20</ref>; <ref loc="LUK 5:1-11">Luka 5:1-11</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Gʋ Yesu cha wʋ dɔŋ Galaliya lɩɩ nʋɔ na, wʋ na aji chamara bala, Simoŋ wʋŋ baa yagɛ sɛ Petero na wʋ nabu Andurusi baa alɔ disawu baa chaŋ aji. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N kɔŋ gaa kpaŋ maŋ maa kalaa amɩɛ na ɩ lɩsɛ bakpa fa Ɩsʋɔ.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Gabʋanaŋ sɛ ba yela ba asawu si sɛ ba kpaŋ ɩ.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Gʋ Yesu ju asanaŋ chonii na wʋ ti na Sebedi bie bala, Jamesi<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">Jamesi n nyina Jamesi</char></note> na wʋ nabu Yohane wɩɛ buori naŋ ba na ba juo Sebedi baa desina ba asawu. Sɛ Yesu yagɛ ba. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Gabʋanaŋ sɛ ba yela buori gaa na ba juo sɛ ba kpaŋ ɩ.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesu tawɩ Ɩsʋɔ Wɩɛ Abama sɛ wʋ chɔ lʋmɩɛtina</para>
  <para style="r">
    <ref loc="LUK 6:17-19">Luka 6:17-19</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu pala Galaliya tibi dʋɔ gapɩlɛkʋma ga kalaa Ɩsʋɔ wɩɛ abama ŋii Yudatina tʋm danɩŋ naŋ, wʋ a tawɩ Ɩsʋɔ Juori gaa dʋɔ wɩɛ abama ŋii yela wʋ a chɔ baa baa kili lʋmɩɛ ngoriŋ-ngoriŋ na lʋm kpiniŋ. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Wʋ wʋsɛ dʋɔ wɩɛ yalagi Siriya tibi dʋɔ kpiniŋ, sɛ bakpa mʋ baa baa kili lʋmɩɛ ngoriŋ-ngoriŋ, baa baa na awʋrʋfʋɔ fɔɩ, baa feliŋ sʋbʋ chaɩ ba tɩba, dɩgbɩŋgbɩŋtina na baa ba jaɩ-jaɩ tɩba na kɔna Yesu sɛ wʋ chɔ ba. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Bakpa fɔɩ lɩɩ Galaliya na Dekapolisi<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Dekapolisi yɩɛ dɩɛsɛ gifi</char></note> tibi dʋɔ, Yerusalem dɩɛ naŋ, Yudiya tibi dʋɔ na tibi gaa ga wɩɛ Yodaŋ buo gatɩɛsa kpiniŋ gaa kpaŋ ɩ.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Yesu kalaa Ɩsʋɔ wɩɛ bʋrɔŋ garɛ dʋɔ</para>
  <para style="r">
    <ref loc="LUK 6:20-23">Luka 6:20-23</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Gʋ Yesu na jama baa na, wʋ ju bʋrɔŋ bie garɛ dʋɔ ga cha. Sɛ wʋ kpalɛnara baa kɔŋ wʋ jaŋ, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Sɛ wʋ fara wʋ a kalaa ba sɛ,<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />Kusee n nyina amɩɛ baa ɩ yɩɛ ayɔŋtina Ɩsʋɔ feliŋ naŋ,</para>
  <para style="q2" vid="MAT 5:3">akala takɩɛ Ɩsʋɔ Juori gaa yɩɛ amɩɛ teri.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Kusee n nyina baa baa bɔtaa,</para>
  <para style="q2" vid="MAT 5:4">akala takɩɛ baa sɛ Ɩsʋɔ aja wʋ a tawɩ dʋ.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Kusee n nyina baa ba fʋʋ,</para>
  <para style="q2" vid="MAT 5:5">akala takɩɛ baa sɛ tibi gana aja yɩɛ ba teri.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Kusee n nyina baa chirigi wɩɛ ba gayalaga,</para>
  <para style="q2" vid="MAT 5:6">akala takɩɛ baa sɛ Ɩsʋɔ aja yela na chirigi a paa ba.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Kusee n nyina baa baa wɩɩ bakpa gɩyɔŋ,</para>
  <para style="q2" vid="MAT 5:7">akala takɩɛ baa sɛ Ɩsʋɔ aja wɩɩ ba gɩyɔŋ.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Kusee n nyina baa ba agela naŋ fʋlʋmɩɛɩ,</para>
  <para style="q2" vid="MAT 5:8">akala takɩɛ baa aaŋ ja baa na Ɩsʋɔ.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Kusee n nyina baa baa kɔna wʋsɛfɩɛ bakpa tɩtɩba,</para>
  <para style="q2" vid="MAT 5:9">akala takɩɛ baa sɛ baa yagɛ Ɩsʋɔ bie.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Kusee n nyina baa chirigi dʋɔ baa nyala ba,</para>
  <para style="q2" vid="MAT 5:10">akala takɩɛ baa sɛ Ɩsʋɔ Juori gaa aja yɩɛ ba teri.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Kusee n nyina amɩɛ baa ma dʋɔ bakpa a ti amɩɛ, baa nyala amɩɛ, sɛ baa yɩɛ akarɩɛ baa tawɩ wɩɛ asʋbʋɛ baa jaga amɩɛ dʋɔ. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />N yela na a yɩɛ amɩɛ jʋŋ na ŋii yɩɛ amɩɛ asadi, akala takɩɛ Ɩsʋɔ aja tɔ amɩɛ kɩm gajanɛ Ɩsʋɔ adugbe. Dɩmʋŋ sɛ ba nyala Ɩsʋɔ bajana baa ba cha pala amɩɛ asanaŋ na.<verse eid="MAT 5:12" /></para>
  <para style="s1">Yasɛ na ŋmaŋi</para>
  <para style="r">
    <ref loc="MRK 9:50">Maakɩ 9:50</ref>; <ref loc="LUK 14:34-35">Luka 14:34-35</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Amɩɛ n nyina tibi dʋɔ yasɛ, ama yasɛ tʋsʋ ŋɩ jʋŋ na, sɩnɛ sɛ ɩ yɩɛ ŋɛ na ŋii ti yɩɛ jʋŋ? Ŋɩ ti taŋ dieli fa bʋrʋ ʋ, amʋɔ ba chɩɛgɩ tʋsʋ na bakpa a chicha dʋɔ.&gt;&gt;<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Amɩɛ n nyina dulunya ŋmaŋi. Dɩɛ janɛ gaa ga jagaɩ bʋrɔŋ bie dʋɔ na baa wɩsɛ ɛ. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Wʋrʋ baa tʋ fitila mʋ dinyiŋkpa fu ga dʋɔ ɔ, ama baa mʋ jaga fitila dɩjagatɩŋ bɛ na gaa ŋmaŋi fa wʋkʋma wʋŋ wʋ wɩɛ waa gaa dʋɔ na. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Dɩmʋŋ sɛ n yela na amɩɛ fitila a ŋmaŋi fa bakpa, na baa na amɩɛ ayɩɛsa abama na baa kalɩɛ amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na.<verse eid="MAT 5:16" /></para>
  <para style="s1">Yesu kalaa lɩɩna mbara ŋii dʋɔ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Sɛ Yesu ti ju dʋɔ tawɩ sɛ, &lt;&lt;N baa yɩɛ amɩɛ nfɩɛrɛ sɛ ma kɔŋ na maa gaa warɩɛ Mosesi mbara yaa Ɩsʋɔ bajana baa kalaa ŋii. Ma n kɔŋ na maa gaa warɩɛ ŋɛ ɛ, ama ma kɔnɛ bɛ na ŋii kɔŋ tɩba. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Maa tawɩ sɛ n nyii na dieli sɛ, gʋ Ɩsʋɔ adugbe na tie saŋ ŋɩ wɩɛ n na bɩrɛ, mbara ŋii naŋ sabɩɛ ga pii garɛ gba baa lɩɩ mbara ŋii tɩba a, mʋ ga tala gʋ bʋrʋkʋma aja kɔŋ tɩba. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Dɩmʋŋ dʋɔ wʋkʋma wʋŋ wʋ n kpaŋ mbara ŋii tɩba ga pii dʋɔ na, sɛ wʋ a kalaa barɛ sɛ ba n yɩɛ dɩmʋŋ na, baa yagɛ ɩ wʋ pii Ɩsʋɔ Juori gaa naŋ. Ama wʋkʋma wʋŋ wʋ a di dʋɔ sɛ wʋ a kalaa mbara ŋii na, baa yagɛ ɩ wʋjanɛ Ɩsʋɔ Juori gaa naŋ. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Maa tawɩ amɩɛ sɛ, amɩɛ chirigi n kii Farasitina na Mosesi mbara bakalaasa na, ɩɩ dɩlɛ jʋʋ Ɩsʋɔ Juori gaa naŋ ŋ.&gt;&gt;<verse eid="MAT 5:20" /></para>
  <para style="s1">Yesu kalaa lɩɩna biŋbira wɩɛ dʋɔ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Sɛ Yesu ti bɔrɛ tawɩ sɛ, &lt;&lt;Ɩ nyii gʋ Mosesi mbara ŋii tawɩ gɩbɩnɩŋtina baa sɛ n baa tagapʋ. Wʋkʋma wʋŋ wʋ a tagapʋ na, baa di wʋ wɩɛ.&gt;&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ama maŋ bɩrɛ, maa tawɩ amɩɛ sɛ wʋkʋma wʋŋ wʋ kara biŋbira dʋ wʋ dʋɔ<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Sabɩɛwɩɛ ŋii ŋarɛ wɩɛna kara biŋbira dʋ n dʋɔ kpakpuo</char></note> na, baa fu ɩ dɩpʋɛ. Wʋkʋma wʋŋ wʋ a tii wʋ dʋɔ sɛ, &lt;&lt;Wʋkpa kpakpuo na, baa mʋ ɩ sɩŋ dɩɛnaŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ asanaŋ. Ama wʋkʋma wʋŋ wʋ a tii wʋ dʋɔ sɛ nyaŋ wʋmalaŋpʋ na aja ju awʋrʋfʋɔ bʋala gaa gaa dum na naŋ.&gt;&gt;<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Dɩmʋŋ dʋɔ, &lt;&lt;Nya mʋ gafaasa ju nyaa ga fa faa gadiesa dɩgbɩŋgbɩŋ dʋɔ na, n wɩɛ dɩmaŋ sɛ n nyiŋi gʋ nyaŋ na n dʋɔ ɩ wɩɛna wɩɛ na, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />yela gafaasa gaa si gadiesa dɩgbɩŋgbɩŋ gaa jaŋ, na nyaa bɔrɛ ju na nyaŋ na n dʋɔ wʋŋ ɩ ga jɔ bʋga pɔɩ na nyaa bɔrɛ kɔŋ gaa fa gafaasa.&gt;&gt;<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />N dʋɔ mʋ nyaŋ ju wɩɛ didiitiŋ na, gʋ ɩ dɔŋ gbɩɛ naŋ ɩɩ ju na, kɩɛ na ɩ desina wɩɛ ŋii pɔɩ na ɩ tala dɩmaŋ. Sɛ nya n yɩɛ dɩmʋŋ na, wʋ a mʋ nyaŋ ga fa wɩɛ diri na wʋ a fu nyaŋ dɩpʋɛ na wʋ a mʋ nyaŋ fa gagbasɛ anyaŋnyaŋtina, na baa mʋ nyaŋ ga tɔ danɛ. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Maa tawɩ sɛ n nyii na dieli sɛ, baa lɩsɛ nyaŋ lɩɩ danɛ dɩtʋɔtɩŋ ŋ, ga tala gʋ nyaa tɔ kɩm gaa taŋ.<verse eid="MAT 5:26" /></para>
  <para style="s1">Yesu kalaa lɩɩna baalɛ wʋrʋgbɩɛ lɩɩ na alʋ wʋrʋgbɩɛ lɩɩ wɩɛ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Sɛ Yesu ti bɔrɛ ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩ nyii gʋ Mosesi mbara ŋii tawɩ sɛ n baa yɩɛ baalɛ wʋrʋgbɩɛ lɩɩ yaa alʋ wʋrʋgbɩɛ lɩɩ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">Ɛsa 20:14</ref>.</char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ama maŋ bɩrɛ, maa tawɩ amɩɛ sɛ wʋkʋma wʋŋ wʋ a kɩɛ alʋ na wʋ a yalaga ɩ na, wʋ taŋ fɩla yɩɛ alʋ wʋrʋgbɩɛ lɩɩ wʋ digela naŋ. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Sɛ n dɩsɛ jɩsaŋ aja yela na nyaa yɩɛ dɩsʋbʋ na, chɔla ga tʋsʋ. Ŋɩ wɩɛ dieli fa nyaŋ takɩɛ nya paŋ n wʋsɛ gatʋŋgʋrʋ kii gʋ nya mʋ n wʋsɛ kpiniŋ mʋ ju awʋrʋfʋɔ bʋala naŋ. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Sɛ n pam jɩsaŋ aja yela na nyaa yɩɛ dɩsʋbʋ na kara ga tʋsʋ. Ŋɩ wɩɛ dieli fa nyaŋ takɩɛ nya paŋ n wʋsɛ gatʋŋgʋrʋ kii gʋ nya mʋ n wʋsɛ kpiniŋ ju awʋrʋfʋɔ bʋala naŋ.<verse eid="MAT 5:30" /></para>
  <para style="s1">Yesu kalaa sarɛ yela dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MAT 19:9">Matiyo 19:9</ref>; <ref loc="MRK 10:11-12">Maakɩ 10:11-12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩ nyii gʋ wʋkʋma wʋŋ wʋ yela wʋ alʋ na ŋɩ tiri gʋ wʋ n sabɩɛ tanɛ fa ɩ na gaa kalaa gʋ wʋ yela ɩ sarɛ.&gt;&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ama maŋ bɩrɛ maa tawɩ amɩɛ sɛ, &lt;&lt;Baalɛ kʋma wʋŋ wʋ yela wʋ alʋ sɛ ŋɩ ba yɩɛ baalɛ wʋrʋgbɩɛ lɩɩ na, wʋ yela sɛ alʋ wʋŋ yɩɛ baalɛ wʋrʋgbɩɛ lɩɩ. Dɩmʋŋ gba sɛ baalɛ kʋma wʋŋ wʋ saa alʋ wʋŋ ba yela ɩ sarɛ na, wʋ yɩɛ alʋ wʋrʋgbɩɛ lɩɩ.&gt;&gt;<verse eid="MAT 5:32" /></para>
  <para style="s1">Ntaŋ ka dʋɔ kalaa</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩ ti bɔrɛ nyii gʋ Mosesi mbara ŋii tawɩ gɩbɩnɩŋtina sɛ n baa ka ntaŋ sala. Ama n di amɩɛ ntaŋ ŋii ɩ ka fa Ɩsʋɔ na dʋɔ.&gt;&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ama maa tawɩ amɩɛ sɛ, n baa ka ntaŋ kpiniŋ-kpiniŋ. N baa ka Ɩsʋɔ adugbe, akala takɩɛ ga yɩɛ Ɩsʋɔ Juorigbeli bɛ, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />yaa n baa ka tibi, akala takɩɛ ga yɩɛ Ɩsʋɔ nafara dɩjagatɩŋ bɛ, yaa Yerusalem dɩɛ janɛ akala takɩɛ ga yɩɛ Juo janɛ wʋŋ dɩɛ bɛ. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />N baa ka amɩɛ nyi dʋɔ ntaŋ akala takɩɛ nyaa dɩlɛ yɩɛ nyɩnyʋɔ garɛ gba gafʋlʋm yaa ganyaŋnyaŋ ŋ. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />N yela na amɩɛ &lt;&lt;ɛɛŋ a yɩɛ ɛɛŋ&gt;&gt; yaa amɩɛ &lt;&lt;Aye a yɩɛ aye.&gt;&gt; Bʋrʋkʋma gaa ɩ tawɩ kpi ŋina dʋɔ na ŋɩ lɩɩ Sɩtanɩ bɛ.<verse eid="MAT 5:37" /></para>
  <para style="s1">N baa mʋ dɩsʋbʋ tɔ dɩsʋbʋ kɩm</para>
  <para style="r">
    <ref loc="LUK 6:29-30">Luka 6:29-30</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩ nyii gʋ Mosesi mbara ŋii ti tawɩ sɛ wʋrʋ salɩɛ wʋ dʋɔ dɩsɛ na, baa salɩɛ wʋ teri, sɛ wʋrʋ kuli wʋ dʋɔ keli na, baa kuli wʋ teri.&gt;&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ama maŋ bɩrɛ, maa tawɩ amɩɛ sɛ wʋrʋ yɩɛ nyaŋ dɩsʋbʋ na, n baa mʋ dɩsʋbʋ tɔ ɩ kɩm. Sɛ wʋrʋ kpa nyaŋ gabaa n jɩsaŋ lati dʋɔ na, biliŋi alatɛ fa ɩ. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Sɛ wʋrʋ aja sɛ wʋ a mʋ nyaŋ ju na baa ga di n wɩɛ na wʋ a lɩɛ nya tie gagba na, mʋ adugbe gagba kpi ɩ. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Sɛ wʋrʋ dʋ nyaŋ sɛ nya n pala mayili garɛ na, nyaŋ na ɩ n pala mayili ala. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Fa wʋŋ wʋ sʋlʋ nyaŋ bʋrʋ darɛ na, wʋŋ wʋ a ja sɛ nyaŋ n kɩŋ ɩ bʋrʋ darɛ na, n baa pɩɛsɛ ɩ.<verse eid="MAT 5:42" /></para>
  <para style="s1">Ja n badʋŋna</para>
  <para style="r">
    <ref loc="LUK 6:27-28">Luka 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Sɛ Yesu ti ju dʋɔ tawɩ sɛ, &lt;&lt;E nyii gʋ Mosesi mbara ŋii ti tawɩ sɛ ja n dʋɔ<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lɛf 19:18</ref>.</char></note> na nyaa kɔla n badʋŋna.&gt;&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ama maŋ bɩrɛ, maa tawɩ amɩɛ sɛ n ja amɩɛ badʋŋna na ɩ jɔ dɩga fa baa baa nyala amɩɛ, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ŋina aaŋ ja yela ɩ yɩɛ amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na bie. Wʋŋ aaŋ yela sɛ wiita a lɩɩ wʋ a fa dɩsʋbʋ yɩɛra na bakpa ba bama, sɛ wʋ a yela sɛ duoni a nɩɛ wʋ a fa bachirigisa na baa ba ba yɩɛ bachirigisa. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Sɛ ɩ ja baa baa ja amɩɛ nyiŋeŋ na, kɩmtʋɔ gamʋɔ sɛ ɩ yu? Lampo lɩɛra gba a yɩɛ dɩmʋŋ. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Sɛ ɩ yɩlɩ amɩɛ dɔŋa nyiŋeŋ na, be sɛ ɩ yɩɛ kii wʋrʋ. Baa ba ba jiŋ Ɩsʋɔ na gba a yɩɛ dɩmʋŋ. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Dɩmʋŋ dʋɔ n yɩɛ kʋrʋkʋrʋ takɩɛ ganaŋkʋ amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na gba yɩɛ kʋrʋkʋrʋ na.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Kalaa lɩɩ gafaasa dʋɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Sɛ Yesu tawɩ sɛ, &lt;&lt;N kɩɛ na dieli na n baa yɩɛ amɩɛ dɩbam bakpa asa dʋɔ na baa na. Sɛ ɩ yɩɛ dɩmʋŋ na, ɩɩ yu kɩmtʋɔ amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na jaŋ ŋ.&gt;&gt;<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Dɩmʋŋ dʋɔ nya fa ayɔŋtɛ bʋrʋ garɛ na, n baa jɔ ga dʋɔ dawuta takɩɛ ganaŋkʋ aluguusitina a yɩɛ Yudatina tʋm danɛ naŋ, na dɩɛ naŋ gbɩɛsɛ bisi naŋ na bakpa a kalɩɛ ba. Maa tawɩ sɛ n nyii na dieli sɛ ba taŋ yu ba kɩmtʋɔ kpiniŋ. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ama sɛ nyaa fa ayɔŋtɛ na, n baa yela n pam nambi a na bʋrʋ gaa n pam jɩsaŋ a yɩɛ, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />ganaŋkʋ aja yɩɛ na ŋii nyaa fa na a yɩɛ asiri. Na n Juo wʋŋ wʋ jiŋ asiri naŋ na, a tɔ nyaŋ kɩm.&gt;&gt;<verse eid="MAT 6:4" /></para>
  <para style="s1">Kalaa lɩɩ dɩga jʋɔ dʋɔ</para>
  <para style="r">
    <ref loc="LUK 11:2-4">Luka 11:2-4</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Sɛ ɩ jɔ dɩga na, n baa yɩɛ takɩɛ aluguusitina, akala takɩɛ baa ja sɛ ba sɩŋ Yudatina tʋm danɛ naŋ na dɩɛ naŋ gbɩɛsɛ bisi naŋ baa jɔ dɩga na bakpa a na ba. Maa tawɩ sɛ n nyii na dieli sɛ ba taŋ yu ba kɩmtʋɔ kpiniŋ. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ama nyaŋ bɩrɛ, nyaa jɔ dɩga na, jʋʋ n danɛ naŋ na nyaa tɔ bʋɔlɛ na nyaa jɔ dɩga fa n Juo wʋŋ wʋ wɩɛ asiri naŋ na. Na n Juo wʋŋ wʋ na ŋii nya yɩɛ asiri naŋ na, a tɔ nyaŋ kɩm. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Ɩ jɔ dɩga na, n baa tawɩ wɩɛ fɔɩ ŋii ŋɩ taŋ tɔnʋɔ takɩɛ baa ba ba jiŋ Ɩsʋɔ ɔ, akala takɩɛ ba jiŋ sɛ ba atawɩ fɔɩ aaŋ ja yela na Ɩsʋɔ a nyii ba wɩɛ. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />N baa yɩɛ takɩɛ ba, akala takɩɛ amɩɛ Juo jiŋ ŋii ɩ jawʋ pɔɩ sɛ ɩ sʋlʋ ɩ.&gt;&gt;<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />N na sɛ n jɔ dɩga, n tawɩ sɛ,</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt;Daa Juo Ɩsʋɔ wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe,</para>
  <para style="q1" vid="MAT 6:9">n yɩrɛ yɩɛ dɩchɩrɩchɩrɩ.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Yela n Juori a kɔŋ,</para>
  <para style="q1" vid="MAT 6:10">n jawʋ n yɩɛ tibi dʋɔ</para>
  <para style="q2" vid="MAT 6:10">takɩɛ ganaŋkʋ ŋɩ kɩɛna Ɩsʋɔ adugbe na.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Fa daa wɩɩ kʋma adiya.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Mʋ daa dɩsʋbʋ chɩɛ daa</para>
  <para style="q2" vid="MAT 6:12">takɩɛ ganaŋkʋ daa gba dɩ mʋ dɩ chɩɛ wʋkʋma wʋŋ wʋ yɩɛ daa dɩsʋbʋ na.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Gara daa na dɩ n baa jʋʋ lɔ tɩba naŋ,</para>
  <para style="q1" vid="MAT 6:13">ama lɩsɛ daa lɩɩ Sɩtanɩ pamɩɛ naŋ. [Akala takɩɛ nyaŋ sɛ Juori, yikuo na jilima yɩɛ n teri gakpaa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Sabɩɛwɩɛ ŋii ŋarɛ wɩɛna ŋina</char></note>]<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Sɛ ɩ mʋ bakpa dɩsʋbʋ gaa ba yɩɛ amɩɛ chɩɛ ba na, amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na gba aja wʋ a mʋ amɩɛ teri chɩɛ amɩɛ. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ama sɛ ɩŋ mʋ bakpa dɩsʋbʋ gaa ba yɩɛ amɩɛ chɩɛ ba na, amɩɛ Juo gba baa mʋ amɩɛ teri chɩɛ amɩɛ ɛ.<verse eid="MAT 6:15" /></para>
  <para style="s1">Nʋɔ pɔgʋ dʋɔ wɩɛ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Ɩ chaŋ nʋɔ pɔgʋ na, n baa yɩɛ amɩɛ asanaŋ gɩyɔŋ-gɩyɔŋ takɩɛ ganaŋkʋ aluguusitina a yɩɛ, na bakpa a na ba takɩɛ ba chaŋ nʋɔ pɔgʋ. Maa tawɩ sɛ n nyii na dieli sɛ ba taŋ yu ba kɩmtʋɔ kpiniŋ. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ama ɩ chaŋ nʋɔ pɔgʋ na, n kɔŋ amɩɛ asa na ɩ sagɩtɩɛ amɩɛ nyie, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />na bakpa n baa jiŋ sɛ ɩ chaŋ nʋɔ pɔgʋ, amʋɔ Ɩsʋɔ n Juo wʋŋ wʋ wɩɛ asiri naŋ na nyiŋeŋ bɛ n na. Na n Juo wʋŋ wʋ na ŋii nya yɩɛ asiri naŋ na a tɔ nyaŋ kɩm.&gt;&gt;<verse eid="MAT 6:18" /></para>
  <para style="s1">Dɩ n ja adugbe akpaŋta</para>
  <para style="r">
    <ref loc="LUK 12:33-34">Luka 12:33-34</ref></para>
  <para style="r">
    <ref loc="MAT 16:13">16:13</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Sɛ Yesu ti bɔrɛ tawɩ ba sɛ, &lt;&lt;N baa kʋla akpaŋta si tibi gana dʋɔ, dɩmaŋ sɛ tabɩrɩta aba na nkaŋdʋrɔ a dɩlɛ warɩɛ ŋɛ, sɛ ŋmɩɛla gba a dɩlɛ salɩɛ buonɔ na baa ŋmɩɛlɛ. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ama n kʋla akpaŋta ŋii ŋɩ wɩɛ Ɩsʋɔ adugbe na si fa amɩɛ wʋsɛ. Dɩmaŋ sɛ tabɩrɩta aba na nkaŋdʋrɔ baa dɩlɛ warɩɛ ŋɛ ɛ, sɛ ŋmɩɛla gba baa dɩlɛ salɩɛ buonɔ ga ŋmɩɛlɛ ŋɛ ɛ. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Akala takɩɛ diele gaa nya akpaŋta wɩɛ na, dɩmaŋ sɛ n digela wɩɛ.&gt;&gt;<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Nya asa kɩɛna bɛ takɩɛ fitila na fa n wʋsɛ. Dɩmʋŋ dʋɔ nya asa wɩɛ dieli na, n wʋsɛ kpiniŋ gba wɩɛna ŋmaŋi. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ama sɛ nya asa taŋ dieli na, n wʋsɛ kpiniŋ gba wɩɛna gɩbɩrɩ. Sɛ ŋmaŋi gaa ga wɩɛ n tɩba dum na, dɩmʋŋ bɩrɛ gɩbɩrɩ gaa aja yɩɛ gajanɛ.<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Wʋrʋ taŋ sɛ wʋ a dɩlɛ tʋŋ kpaŋjuo aba bala a. Sɛ dɩ kɔŋ dɩmʋŋ na, wʋ a kɔla wʋrʋ na wʋ a ja wʋrʋ wɩɛ, yaa wʋ a mʋ wʋ wʋsɛ fa wʋrʋ na wʋ a kɩɛ wʋrʋ kpakpuo. Ɩ ɩɩ dɩlɛ tʋŋ Ɩsʋɔ na aterembie e.&gt;&gt;<verse eid="MAT 6:24" /></para>
  <para style="s1">N baa nyala amɩɛ wʋsɛ</para>
  <para style="r">
    <ref loc="LUK 12:22-31">Luka 12:22-31</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Sɛ Yesu ju dʋɔ kalaa sɛ, &lt;&lt;Dɩmʋŋ dʋɔ maa tawɩ amɩɛ sɛ, n baa nyala amɩɛ wʋsɛ amɩɛ nkpa dʋɔ bʋrʋ gaa ɩ di yaa ɩ nyʋɔ yaa amɩɛ wʋsɛ ŋii ɩ fu na dʋɔ. Akala takɩɛ nkpa kii adiya sɛ wʋsɛ gba kii abʋrɩ afuusa. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />N kɩɛ jimbisi, baa duu sɛ baa karɛwʋ ʋ, sɛ baa kʋla baa si adiya disiitiŋ ŋ, ama amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na a fa ba adiya. Ɩ ba yɩɛ ba kpari kii baa? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Amɩɛ tɩba wʋ Mmʋɔ sɛ wʋ ga nyala naŋ a dɩlɛ mʋ saŋa pii kpi wʋ nkpa dʋɔ.&gt;&gt;<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ nyala amɩɛ wʋsɛ abʋrɩ afuusa dʋɔ? N kɩɛ ganaŋkʋ kasɛ naŋ fʋɩrasɛ a bɩɩ ŋɩ wɩɛ dieli, ŋii yɩɛ dɩtʋm sɛ ŋii lʋʋ abʋrɩ afuusa a. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Ama maa tawɩ amɩɛ sɛ, Juo Solomoŋ na wʋ jilima naŋ kpiniŋ gba n dɩlɛ desina wʋ wʋsɛ na wʋ a yɩɛ dieli takɩɛ fʋɩrasɛ ŋina naŋ garɛ ɛ. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Sɛ dɩmʋŋ sɛ Ɩsʋɔ a fu kasɛ ŋii ɩ na ŋɛ jaŋ na chifuo ɩ tʋ ŋɛ bʋala na, be n yɩɛ sɛ wʋ aa fu amɩɛ? O amɩɛ baa amɩɛ lɩɛdi n bɔla a. <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Dɩmʋŋ dʋɔ n baa nyala amɩɛ wʋsɛ na ɩ tasɛ sɛ be sɛ dɩ di yaa dɩ nyʋɔ yaa dɩɩ fu? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Akala takɩɛ bakpa baa ba ba jiŋ Ɩsʋɔ na aja dɩmʋŋ abʋrɩ ŋina kpiniŋ. Ama amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na jiŋ gʋ ŋina kpiniŋ tiri amɩɛ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ama n chɩŋkpɩɛ ja Ɩsʋɔ Juori gaa na wʋ gbɩɛ chirigi na wʋ a mʋ ŋina kpiniŋ kpi amɩɛ. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Dɩmʋŋ dʋɔ n baa nyala amɩɛ wʋsɛ fa chifuo. Chifuo gana tɩŋtɩŋ aja mʋ ga wɩɛ kɔŋ. Wɩɩ kʋma wɩɛna ga tɩba ganyala.&gt;&gt;<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">N baa fu dɩpʋɛ</para>
  <para style="r">
    <ref loc="LUK 6:37">Luka 6:37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Sɛ Yesu tawɩ sɛ, &lt;&lt;N baa fu dɩpʋɛ na Ɩsʋɔ gba n baa fu amɩɛ dɩpʋɛ. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Akala takɩɛ ganaŋkʋ ɩ di wʋrʋ wɩɛ na, dɩmʋŋ sɛ Ɩsʋɔ a ja di amɩɛ wɩɛ. Mudu gaa ɩ mʋ kalaa bʋrʋ darɛ fa wʋrʋ na, gaa sɛ Ɩsʋɔ gba aja wʋ a mʋ kalaa fa amɩɛ.&gt;&gt;<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt;Be n yɩɛ sɛ nyaa kɩɛ kabie gaa ga jagaɩ n dɩɛtɛ dɩsɛ dʋɔ, ama dakpie gaa ga jagaɩ n tɩŋtɩŋ n dɩsɛ dʋɔ na bɩrɛ, nyaa na a? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Sɩnɛ sɛ nyaa dɩlɛ tawɩ n dɩɛtɛ sɛ, &lt;Yela na maa lɩsɛ kabie gaa ga jagaɩ n dɩsɛ dʋɔ,&gt; yela dakpie jagaɩ n tɩŋtɩŋ n dɩsɛ dʋɔ? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Nyaŋ aluguusitɛ, chɩŋkpɩɛ lɩsɛ dakpie n tɩŋtɩŋ n dɩsɛ dʋɔ na nyaa na na dieli, na nyaa dɩlɛ lɩsɛ kabie n dʋɔ dɩsɛ dʋɔ.&gt;&gt;<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;N baa mʋ bʋrʋ gaa ga yɩɛ chɩrɩchɩrɩ na fa paasɛ, dɩmʋŋ sɛ n baa mʋ bʋɛ abama lɔ fa ɔvaaba. Ɩ yɩɛ dɩmʋŋ na baa chicha ŋɛ na paasɛ baa gba a fu amɩɛ dʋɔ na baa tawʋ amɩɛ.&gt;&gt;<verse eid="MAT 7:6" /></para>
  <para style="s1">N tasɛ Ɩsʋɔ, wʋ a fa amɩɛ</para>
  <para style="r">
    <ref loc="LUK 11:9-13">Luka 11:9-13</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;N tasɛ Ɩsʋɔ na wʋ a fa amɩɛ, n ja na ɩ na. N jɔ ɩ bʋɔlɛ na wʋ a tʋlʋ amɩɛ. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Akala takɩɛ wʋkʋma wʋŋ wʋ tasɛ Ɩsʋɔ na, wʋ a fa ɩ. Wʋŋ wʋ a jawʋ na, wʋ a na. Dɩmʋŋ sɛ wʋŋ wʋ a jɔ ɩ bʋɔlɛ na, wʋ a tʋlʋ ɩ.&gt;&gt;<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Sɛ wʋ ju dʋɔ tawɩ sɛ, &lt;&lt;Amɩɛ tɩba wʋ Mmʋɔ bu n tasɛ ɩ bodobodo na sɛ wʋ a fa ɩ bʋɩ? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Yaa wʋ tasɛ ɩ diji na wʋ a fa ɩ dʋm? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Amɩɛ baa ɩ yɩɛ dɩsʋbʋ yɩɛra na gba jiŋ ganaŋkʋ ɩ mʋ abʋrɩ abama ɩ fa amɩɛ bie, be n yɩɛ sɛ amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na baa mʋ abʋrɩ abama fa baa baa tasɛ ɩ naa?&gt;&gt; <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Dɩmʋŋ dʋɔ bʋrʋkʋma naŋ na, n yɩɛ fa amɩɛ dɔŋa takɩɛ ganaŋkʋ ɩ ja sɛ ba n yɩɛ fa amɩɛ na. Ŋina n nyina Mosesi mbara na Ɩsʋɔ bajana baa kalaa ŋii.<verse eid="MAT 7:12" /></para>
  <para style="s1">Buonɔ mɔmɔkyɩ</para>
  <para style="r">
    <ref loc="LUK 13:24">Luka 13:24</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Sɛ Yesu tawɩ sɛ, &lt;&lt;N mʋna buonɔ mɔmɔkyɩ gaa naŋ. Akala takɩɛ buonɔ ga yalagisa na gbɩɛ ga yalagisa aaŋ ju dɩwarɩɛ naŋ. Dɩmʋŋ dʋɔ bakpa fɔɩ aaŋ mʋna ga baa jʋʋ. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ama buonɔ pii na gbɩɛ mɔmɔkyɩ aaŋ ju nkpa naŋ. Dɩmʋŋ dʋɔ bakpa pii barɛ aaŋ na ga baa mʋna.&gt;&gt;<verse eid="MAT 7:14" /></para>
  <para style="s1">Daŋ na ga bie</para>
  <para style="r">
    <ref loc="LUK 6:43">Luka 6:43</ref>,<ref loc="LUK 6:44">44</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;N kɩɛ amɩɛ wʋsɛ dʋɔ na dieli akarɩɛ bajana dʋɔ. Baa kɔŋ amɩɛ jaŋ takɩɛ feŋ, ama ba tɩba bɩrɛ ba kɩɛna bɛ takɩɛ gbogboo aba baa ba libi na. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ba ayɩɛsa sɛ ɩ mʋ jiŋ ba. Bakpa a kɔ ponponsi bie lɩɩ sɔba daŋ dʋɔ yaa dikutu lɩɩ didiŋpo daŋ dʋɔ? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Dɩmʋŋ sɛ daŋ bam kʋma a si bie abama, sɛ daŋ sʋbʋ kʋma dʋɔ a si bie asʋbʋɛ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Daŋ bam baa dɩlɛ si bie asʋbʋɛ ɛ, sɛ daŋ sʋbʋ dʋɔ baa dɩlɛ si bie abama a. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Daŋ kʋma gaa gaa si bie abama na, baa wʋŋ ga bɛ lɔ na baa mʋ ga dʋ bʋala naŋ. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Dɩmʋŋ dʋɔ ba ayɩɛsa sɛ ɩ mʋ jiŋ ba.&gt;&gt;<verse eid="MAT 7:20" /></para>
  <para style="s1">Ma ba jiŋ amɩɛ ɛ</para>
  <para style="r">
    <ref loc="LUK 13:25-27">Luka 13:25-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Naa wʋkʋma wʋŋ wʋ a yagɛ maŋ sɛ Kpaŋjuo, kpaŋjuo na aaŋ ja wʋ a ju Ɩsʋɔ Juori gaa naŋ ŋ, amʋɔ wʋŋ wʋ a yɩɛ Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe jawʋ na.&gt;&gt; <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Bakpa fɔɩ aja tawɩ maŋ Ɩsʋɔ dɩpʋɛ fuu wɩɩ sɛ, &lt;&lt;Kpaŋjuo, Kpaŋjuo, naa n yɩrɛ naŋ sɛ dɩ tawɩ Ɩsʋɔ wɩɛ ɛ, naa n yɩrɛ naŋ sɛ dɩ geŋ feliŋ sʋbʋ lɩɩ bakpa tɩba, sɛ dɩ yɩɛ adaŋgana fɔɩ? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ama maa tawɩ tʋlʋ ba sɛ, ma ba jiŋ amɩɛ ɛ. N lɩɩ ma jaŋ, amɩɛ dɩsʋbʋ yɩɛra!&gt;&gt;<verse eid="MAT 7:23" /></para>
  <para style="s1">Danɛ maara bala barɛ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="LUK 6:47-49">Luka 6:47-49</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩmʋŋ dʋɔ, wʋkʋma wʋŋ wʋ a nyii ma wɩɛ ŋina sɛ wʋ a di ŋɩ dʋɔ na kɩɛna bɛ takɩɛ baalɛ wɩɛ jɩmɩrɛ wʋŋ wʋ ma wʋ danɛ jaga bʋɛ dʋɔ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Duoni janɛ nɩɛ sɛ buosɛ suu, sɛ feliŋ janɛ jɔ danɛ gaa ama ga n sala a, akala takɩɛ ba si tie dɩpɔrɛ jaga bʋɛ dʋɔ. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Ama wʋkʋma wʋŋ wʋ a nyii ma wɩɛ ŋina, sɛ wʋ aa di ŋɩ dʋɔ na kɩɛna bɛ takɩɛ baalɛ wʋmalaŋpʋ wʋŋ wʋ ma wʋ danɛ jaga tɩɛra dʋɔ. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Duoni janɛ nɩɛ sɛ buosɛ suu, sɛ feliŋ janɛ jɔ dɩmʋŋ danɛ gana sɛ ga salɩɛ kpiniŋ-kpiniŋ.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Gʋ Yesu tawɩ ŋina taŋ na, wʋ kalaa ŋii yɩɛ bakpa baa doba. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Akala takɩɛ wʋ kalaa-kalaa ba takɩɛ wʋkpa wʋŋ wʋ wɩɛna yikuo, ama naa takɩɛ ba mbara bakalaasa baa a.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu chɔ baalɛ chaalaŋa wʋrʋ</para>
  <para style="r">
    <ref loc="MRK 1:40-45">Maakɩ 1:40-45</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Gʋ Yesu tibi lɩɩ bʋrɔŋ dʋɔ kɔŋ na, bakpa fɔɩ kpaŋ ɩ. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Dɩmaŋ sɛ baalɛ chalaŋa<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">Giriki wɩɛ bi fa gɩchalaŋa sɩmɩɛɩ fa lʋm yiri gaa gaa fu wʋkpa dʋɔ</char></note> wʋrʋ kɔŋ wʋ jaŋ gaa luuŋ wʋ asanaŋ sʋlʋ ɩ sɛ, &lt;&lt;Kpaŋjuo, nyaa jawʋ na, nyaa dɩlɛ chɔ maŋ.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Sɛ Yesu tɩɛŋɩ wʋ pam jaga baalɛ wʋŋ dʋɔ tawɩ sɛ, &lt;&lt;Maa jawʋ, n wʋsɛ n yɩɛ dɩchɩrɩchɩrɩ.&gt;&gt; Gabʋanaŋ sɛ gɩchalaŋa gaa lam. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Nyaŋ, kɩɛ na dieli na nya n baa tawɩ wʋrʋ. Ama mʋ n wʋsɛ ju ga kalaa Ɩsʋɔ sei, na nyaa diesi gadiesa ganaŋkʋ Mosesi mbara akala na, na ŋii di seriya takɩɛ nya yu lʋm chʋɔ.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s1">Yesu chɔ Roma bɩnɛ tʋmɩrɛ</para>
  <para style="r">
    <ref loc="LUK 7:1-10">Luka 7:1-10</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Gʋ Yesu ju Kapeniyum dɩɛ naŋ na, yuora gafie bɩnɛ wʋrʋ kɔŋ wʋ jaŋ gaa sʋlʋ ɩ sɛ wʋ n chɔna ɩ. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Kpaŋjuo, ma tʋmɩrɛ jaɩ-jaɩ wʋ duwei waa dʋɔ wʋ a na awʋrʋfʋɔ fɔɩ.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Maa ju ga chɔ ɩ.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Ama yuora gafie bɩnɛ wʋŋ tawɩ sɛ, &lt;&lt;Kpaŋjuo, ma n daga na nyaa kɔŋ ma waa dʋɔ ɔ. Ama tawɩ wɩɛ, ma tʋmɩrɛ wʋŋ aja yu lʋm chʋɔ. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Akala takɩɛ ma tɩŋtɩŋ ma wɩɛ yikuo tie bɛ, sɛ maŋ gba ma wɩɛna yuora ma tie. Ma tawɩ ba tɩba wʋrʋ sɛ ju na wʋ a ju, sɛ ma tawɩ wʋ baŋbaŋ sɛ kɔŋ na wʋ a kɔnɛ, sɛ ma tawɩ ma tʋmɩrɛ sɛ yɩɛ ŋina na, wʋ a yɩɛ.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Gʋ Yesu nyii wɩɛ ŋina na, dɩ yɩɛ ɩ doba. Sɛ wʋ tawɩ baa ba kpamɩna ɩ na sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ ma n naa ta wʋrʋ Isiralitina naŋ wʋ wɩɛna lɩɛdi gana duluŋ ŋ. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Maa tawɩ fa amɩɛ sɛ bakpa fɔɩ aja lɩɩ dɩlɩɩtɩŋ na dɩsalɩtɩŋ na gɩbɩnɩŋtina Abiraham, Isaki na Yakubu aja cha asadi adiya di Ɩsʋɔ juori gaa naŋ. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ama Isiralitina baa nafʋɔ Ɩsʋɔ Juori gaa yɩɛ ba teri na, baa lɔ ba lɩsɛ asʋŋ ga dʋ giteŋteŋbiri naŋ, dɩmaŋ sɛ wiiniŋ na kela naŋ tawʋ wɩɛ.&gt;&gt;<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Sɛ Yesu tawɩ yuora gafie bɩnɛ wʋŋ sɛ, &lt;&lt;Ju dɩɛ! Ŋii yɩɛ fa nyaŋ takɩɛ ganaŋkʋ n lɩɛ di na.&gt;&gt;Dɩmʋŋ saŋa gana kʋrʋkʋrʋ sɛ wʋ tʋmɩrɛ wʋŋ yu lʋm chʋɔ.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesu chɔ bakpa fɔɩ</para>
  <para style="r">
    <ref loc="MRK 1:29-34">Maakɩ 1:29-34</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Gʋ Yesu ju Petero waa dʋɔ na, wʋ na Petero awu a kili gibirima wʋ duwei waa dʋɔ. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Sɛ wʋ mʋ wʋ pam jaga alʋ wʋŋ pam dʋɔ sɛ gibirima gaa yela ɩ. Sɛ wʋ kʋlʋ tɩŋɛ adiya fa ba.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Bʋyanɔ gʋ wiita a ju wʋ a ga sala na, bakpa mʋ baa feliŋ sʋbʋ fɔɩ wɩɛ ba tɩba na kɔŋ Yesu jaŋ. Sɛ wʋ geŋ feliŋ sʋbʋ lɩɩ bakpa baa tɩba sɛ wʋ chɔ lʋmɩɛtina baa kpiniŋ. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Wʋ yɩɛ ŋina sɛ dɩ yela sɛ wɩɛ ŋii Ɩsʋɔ pala na ɔja Yisaya dʋɔ tawɩ si na kɔŋ tɩba sɛ,</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Wʋ mʋ daa wʋsɛ fʋʋ,</para>
  <para style="q2" vid="MAT 8:17">sɛ wʋ sɩlɛ daa lʋmɩɛ.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s1">Baa baa ja baa kpaŋ Yesu na</para>
  <para style="r">
    <ref loc="LUK 9:57-62">Luka 9:57-62</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Gʋ Yesu na jama baa logo ɩ na, wʋ dʋ wʋ kpalɛnara baa sɛ n yela dɩ tɩɛsɛ lɩɩ gaa ju gatɩɛsa. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Sɛ Mosesi mbara wʋkalaasa wʋrʋ kɔŋ wʋ jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Wʋkalaasa, gapɩlɛkʋma gaa nyaa ju na maa kpaŋ nyaŋ.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Awʋja aba wɩɛna bʋɔsɛ baa duo sɛ jimbisi wɩɛna gasɩsasɛ. Ama Wʋkpa Bu wʋŋ bɩrɛ, wʋ tana diduwei i.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Sɛ wʋ kpalɛnara baa tɩba wʋrʋ tawɩ ɩ sɛ, &lt;&lt;Kpaŋjuo, yela maa chɩŋkpɩɛ ju ga wuu majuo pɔɩ.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ama Yesu tawɩ ɩ sɛ, &lt;&lt;Kpaŋ maŋ, na nyaa yela na sira a wuu dɔŋa.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesu yela sɛ feliŋ janɛ chakuruŋ</para>
  <para style="r">
    <ref loc="MRK 4:35-41">Maakɩ 4:35-41</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Sɛ Yesu jʋʋ buori naŋ sɛ wʋ kpalɛnara baa kpaŋ ɩ. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Gabʋanaŋ sɛ feliŋ janɛ jɔ lɩɩ gaa dʋɔ sɛ dɩ jɔ apaa dʋ buori gaa naŋ hali ga ja gaa muru. Ama Yesu bɩrɛ, wʋ duo asoroŋ. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Sɛ wʋ kpalɛnara baa feŋsi ɩ sɛ ba tawɩ ɩ sɛ, &lt;&lt;Kpaŋjuo, dɩɩ muru oo, mɔlɔgɩ daa!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Amɩɛ baa amɩɛ lɩɛdi n bɔla a, be n yɩɛ sɛ nyɩŋtɩɛ chamɩna amɩɛ?&gt;&gt; Sɛ wʋ kʋlʋ fʋba feliŋ na apaa ŋii dʋɔ sɛ ŋɩ chakuruŋ.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Sɛ dɩ yɩɛ wʋ kpalɛnara baa doba sɛ ba tasɛ sɛ, &lt;&lt;Wʋkpa wʋ Mmʋɔ gba mɩnaŋ sɛ feliŋ na apaa a nyii wʋ jaŋ n naa?&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesu chɔ baala bala baa feliŋ sʋbʋ wɩɛ ba tɩba</para>
  <para style="r">
    <ref loc="MRK 5:1-20">Maakɩ 5:1-20</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Gʋ Yesu na wʋ kpalɛnara baa tɩɛsa kɔŋ Gadara tibi gaa ga wɩɛ gatɩɛsa na, bakpa bala baa feliŋ sʋbʋ wɩɛ ba tɩba na lɩɩ diwuutiŋ gaa jaŋina ɩ. Ba cha libi fɔɩ, dɩmʋŋ dʋɔ wʋrʋ baa dɩlɛ mʋna gbɩɛ gana a. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Gʋ ba na Yesu na, ba kuusi sɛ, &lt;&lt;Ɩsʋɔ Bu, be sɛ nyaa ja daa jaŋ?&gt;&gt;N kɔŋ na nyaa gaa nyala daa pɔɩ na Ɩsʋɔ dɩpʋɛ fuu wɩɩ gaa a tala bɛ?<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Na ɔvaaba dikpeŋ barɛ wɩɛ tirina bʋrɔŋ garɛ baa di. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Sɛ feliŋ sʋbʋ wʋŋ sʋlʋ Yesu sɛ, &lt;&lt;Nyaa gɩŋ daa na, geŋ daa na dɩ ga jʋʋ ɔvaaba dikpeŋ baa tɩba.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N lɩɩ ju!&gt;&gt; Sɛ ba lɩɩ ga jʋʋ ɔvaaba baa tɩba. Sɛ Ɔvaaba baa kpiniŋ se tibi bʋrɔŋ ga jʋʋ lɩɩ gaa naŋ sɛ ba sɩŋ. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Gʋ ɔvaaba baa kɩɛra na ŋii ŋɩ tibi na, ba se ju dɩɛ gaa naŋ ga tawɩ wɩɛ ŋii, na ganaŋkʋ feliŋ sʋbʋ lɩɩ baala baa tɩba na. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Dɩmʋŋ dʋɔ dɩɛ gaa naŋ bakpa kpiniŋ lɩɩ gaa jaŋina Yesu. Gʋ ba na ɩ na, ba sʋlʋ ɩ sɛ wʋ n lɩɩ ba tibi dʋɔ.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesu chɔ baalɛ wʋrʋ wʋ jaɩ-jaɩ</para>
  <para style="r">
    <ref loc="MRK 2:1-12">Maakɩ 2:1-12</ref>; <ref loc="LUK 5:17-26">Luka 5:17-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesu jʋʋ buori naŋ tɩɛsɛ lɩɩ bɔrɛ kɔŋ wʋ tɩŋtɩŋ wʋ dɩɛ naŋ. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Gʋ Yesu wɩɛ dɩmaŋ na, baala barɛ sɩlɛ baalɛ wʋrʋ wʋ jaɩ-jaɩ kalaŋ dʋɔ kɔŋ Yesu jaŋ. Gʋ wʋ na ba lɩɛdi na, wʋ tawɩ wʋŋ wʋ jaɩ-jaɩ na sɛ, &lt;&lt;Mabu, yu digela, ma mʋ n dɩsʋbʋ chɩɛ nyaŋ.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Dɩmaŋ sɛ Mosesi mbara bakalaasa baa barɛ tawɩ ba nyiŋeŋ-nyiŋeŋ sɛ, &lt;&lt;Baalɛ wina a tawɩ mbusu wɩɛ!&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Gʋ Yesu jiŋ ba nfɩɛrɛ na, wʋ tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ fa nfɩɛrɛ asʋbʋɛ ŋina? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Sɛ Yesu tasɛ sɛ ŋɛ amʋɔ n duo na tibi naŋ, sɛ ma tawɩ fa wʋŋ wʋ jaɩ-jaɩ na sɛ, &lt;Ma mʋ n dɩsʋbʋ chɩɛ nyaŋ&gt; yaa ma tawɩ sɛ, &lt;Kʋlʋ na nyaa pala?&gt; <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ama ganaŋkʋ aja yela na ɩ jiŋ gʋ Wʋkpa Bu wʋŋ wɩɛna yikuo tibi dʋɔ sɛ wʋ a dɩlɛ mʋ dɩsʋbʋ chɩɛ. Sɛ wʋ tawɩ wʋŋ wʋ jaɩ-jaɩ na sɛ, Kʋlʋ, mʋ n kalaŋ na nyaa ju dɩɛ.&gt;&gt; <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Sɛ baalɛ wʋŋ kʋlʋ sɛ wʋ ju dɩɛ. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Gʋ jama baa na ŋina na dɩ yɩɛ ba doba fɔɩ, sɛ ba kalɩɛ Ɩsʋɔ gʋ wʋ mʋ yikuo gana duluŋ fa bakpa.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesu yagɛ Matiyo</para>
  <para style="r">
    <ref loc="MRK 2:13-17">Maakɩ 2:13-17</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Gʋ Yesu lɩɩ dɩmaŋ wʋ a ju na, wʋ na lampo lɩɛrɛ wʋrʋ baa yagɛ ɩ sɛ Matiyo wʋ chaɩ lampo danɛ naŋ. Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Kpaŋ maŋ,&gt;&gt; sɛ wʋ kʋlʋ kpaŋ ɩ.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Dɩ kɔŋ takɩɛ Yesu na wʋ kpalɛnara wɩɛ Matiyo waa dʋɔ baa di. Lampo lɩɛra na dɩsʋbʋ yɩɛra fɔɩ gaa kpi ba dʋɔ baa di. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Gʋ Farasitina na ŋina na, ba tasɛ wʋ kpalɛnara baa sɛ, &lt;&lt;Be n yɩɛ sɛ amɩɛ wʋkalaasa na lampo lɩɛra na dɩsʋbʋ yɩɛra a di?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Gʋ Yesu nyii ŋina na, wʋ lɩsɛ ba nʋɔ sɛ, &lt;&lt;Alaŋfiyatina n tiri lʋm chʋɔrɛ ɛ, ama lʋmɩɛtina. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ama n ju ga kɩɛ Sabɩɛwɩɛ ŋii naŋ na dieli na ɩ nyii tie wɩɛ ŋii Ɩsʋɔ tawɩ sɛ, &lt;Maa ja gɩyɔŋ wɩɩ bɛ naa gadiesa a.&gt;Akala takɩɛ ma n kɔŋ na maa gaa yagɛ bachirigisa a, ama dɩsʋbʋ yɩɛra.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s1">Nʋɔ pɔgʋ dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MRK 2:18-22">Maakɩ 2:18-22</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Wɩɩ darɛ Yohane kpalɛnara kɔŋ Yesu jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Be n yɩɛ sɛ daa na Farasitina a chaŋ nʋɔ pɔgʋ sɛ n kpalɛnara bɩrɛ baa chaŋ nʋɔ pɔgʋ?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Alʋfɔlɛ baalɛ wʋŋ mʋɔrɛ a bɔtaa yela wʋ wɩɛ ba jaŋ? Ama saŋa gʋrʋ aja kɔŋ baa mʋ alʋfɔlɛ baalɛ wʋŋ lɩɩ ba jaŋ, saŋa gana sɛ baa chaŋ nʋɔ pɔgʋ.&gt;&gt;<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Sɛ Yesu ti bɔrɛ tawɩ sɛ, &lt;&lt;Wʋrʋ baa mʋ dukuru fɔlɛ wʋ a tarɛ gabɩnɛ naŋ ŋ. Sɛ wʋ yɩɛ dɩmʋŋ na, gafɔlɛ gaa aja kparagi gabɩnɛ gaa na bʋɔ gaa a yɩɛ gajanɛ. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Dɩmʋŋ sɛ wʋrʋ baa chɩɛgɩ wayɩŋ sʋlʋŋ fɔlɛ wʋ a dʋ kpalɛ gabɩnɛ naŋ ŋ. Sɛ wʋ yɩɛ dɩmʋŋ na, kpalɛ gabɩnɛ gaa aja sagɛ na gaa salɩɛ na sʋlʋŋ ŋii a chɩɛgɩ tʋsʋ. Dɩmʋŋ dʋɔ baa chɩɛgɩ sʋlʋŋ fɔlɛ baa dʋ kpalɛ gafɔlɛ naŋ bɛ na ŋɩ kpiniŋ n ba warɩɛ.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s1">Yesu feŋsi galibie wʋrʋ sɛ wʋ chʋɔ alʋ wʋrʋ asima a jɔ ɩ</para>
  <para style="r">
    <ref loc="MRK 5:21-43">Maakɩ 5:21-43</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Gʋ Yesu saŋ wʋ a tawɩ ŋina na, kɩɛ Yudatina tʋm danɛ naŋ bɩnɛ wʋrʋ kɔŋ gaa luuŋ wʋ asanaŋ tawɩ sɛ, &lt;&lt;Mabu alʋ jaŋ sɩŋ dɩtɩɛna gana. Dɩmʋŋ dʋɔ kɔŋ na nyaa gaa mʋ n pam jaga wʋ dʋɔ na wʋ a feŋ.&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Dɩmʋŋ dʋɔ Yesu kʋlʋ kpaŋ ɩ sɛ wʋ kpalɛnara baa kpam.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Gʋ baa ju na, alʋ wʋrʋ wʋŋ asima jɔ ɩ bɩŋsɛ gifi ala na lɩɩ Yesu wʋrʋgbɩɛ mʋ wʋ pam ga tapʋ wʋ adugbe gagba nʋɔ, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Akala takɩɛ alʋ wʋŋ tawɩ wʋ nyinaŋ sɛ, &lt;&lt;Ma tapʋ wʋ adugbe gagba na, maa yu lʋm chʋɔ.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Sɛ Yesu biliŋi kɩɛ ɩ tawɩ ɩ sɛ, &lt;&lt;Alʋ, yu digela, n lɩɛdi chɔ nyaŋ.&gt;&gt;Gabʋanaŋ sɛ wʋ yu lʋm chʋɔ.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Gʋ Yesu jʋʋ Yudatina tʋm danɛ naŋ bɩnɛ wʋŋ waa dʋɔ na, wʋ na galiebi fʋlʋda lie gaa naŋ na jama baa barɛ dʋɔ a wii na doŋ, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />sɛ wʋ tawɩ ba sɛ, &lt;&lt;N lɩɩ jɩna. Galibie wʋŋ n sɩŋ ŋ, ama wʋ duo bɛ.&gt;&gt; Ama ba mʋɩ ɩ. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Gʋ ba yela sɛ bakpa baa lɩɩ asʋŋ wʋrʋgbɩɛ na, Yesu jʋʋ danɛ naŋ sɛ wʋ chaŋ galibie wʋ pam naŋ sɛ wʋ kʋlʋ. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Sɛ wɩɛ ŋina yalagi ju tibi gaa dʋɔ gapɩlɛkʋma.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesu chɔ bataŋpʋna bala</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Gʋ Yesu lɩɩ dɩmaŋ wʋ a ju na, sɛ bataŋpʋna bala barɛ kpaŋ ɩ baa kuusi sɛ, &lt;&lt;Dawidi ganana bie, wɩɩ daa gɩyɔŋ!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Gʋ Yesu kɔŋ waa dʋɔ na, bataŋpʋna bala baa kɔŋ wʋ jaŋ, sɛ wʋ tasɛ ba sɛ, &lt;&lt;Ɩ lɩɛ di sɛ maa dɩlɛ fulu amɩɛ asa?&gt;&gt; Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Ɛɛŋ, kpaŋjuo.&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Sɛ Yesu mʋ wʋ pam jaga ba asa dʋɔ tawɩ sɛ, &lt;&lt;Ganaŋkʋ amɩɛ lɩɛdi kɩɛna na, ŋɩ n yɩɛ dɩmʋŋ fa amɩɛ.&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Gabʋanaŋ sɛ ba asa fulu, sɛ Yesu jɔ ba nyienaŋ na doŋ sɛ, &lt;&lt;N kɩɛ na dieli na n baa tawɩ wʋrʋ.&gt;&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ama gʋ ba lɩɩ dɩmaŋ na, ba jɔ Yesu wɩɛ ŋii dʋɔ dawuta sɛ ŋɩ yalagi tibi gaa gapɩlɛkʋma.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Gʋ baala bala baa Yesu fulu ba asa na lɩɩ dɩmaŋ baa ju na, kɩɛ bakpa barɛ mʋ baalɛ wʋrʋ wʋŋ feliŋ sʋbʋ wɩɛ wʋ tɩba sɛ wʋ yɩɛ namu na kɔna Yesu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Sɛ Yesu geŋ feliŋ sʋbʋ wʋŋ lɩɩ baalɛ namu wʋŋ tɩba sɛ wʋ dɩlɛ tawɩ sɛ dɩ yɩɛ jama baa doba sɛ ba tawɩ sɛ, &lt;&lt;Dɩ n naa ta ŋina duluŋ Isirali tibi dʋɔ ɔ.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ama Farasitina baa tawɩ sɛ, &lt;&lt;Sɩtanɩ wʋŋ wʋ yɩɛ feliŋ sʋbʋ bɩnɛ na yikuo sɛ wʋ chamɩna wʋ a geŋ feliŋ asʋbʋɛ.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s1">Yesu wɩɩ bakpa gɩyɔŋ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu pala dɩɛsɛ na dɩɛsɛ bisi naŋ wʋ a kalaa Yudatina tʋm danɩŋ naŋ. Wʋ tawɩ Ɩsʋɔ Juori gaa dʋɔ wɩɛ abama ŋii yela wʋ a chɔ lʋm na lʋmɩɛ. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Gʋ Yesu na jama baa na, ba wɩɛ yɩɛ ɩ gɩyɔŋ, akala takɩɛ ganyala fɔɩ wɩɛ ba dʋɔ sɛ ba ba jiŋ ŋii ba n yɩɛ ɛ. Ba kɩɛna bɛ takɩɛ feŋ baa ba tana kparɛ na. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Sɛ Yesu tawɩ wʋ kpalɛnara baa sɛ, &lt;&lt;Mala karɩŋ bɔlɩɛɩ ama karada n bɔla a. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Dɩmʋŋ dʋɔ n sʋlʋ kpaŋjuo fʋɔtɛ wʋŋ na wʋ a kpiri tʋmɩra barɛ gaa kpi karada baa dʋɔ fʋɔ gaa naŋ.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Yesu kpirida gifi bala baa</para>
  <para style="r">
    <ref loc="MRK 3:13-19">Maakɩ 3:13-19</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesu yagɛ wʋ kpalɛnara gifi bala baa kɔŋ wʋ jaŋ, sɛ wʋ fa ba yikuo sɛ ba n gɩŋ feliŋ sʋbʋ lɩɩ bakpa tɩba na baa chɔ lʋm na lʋmɩɛ ngoriŋ-ngoriŋ.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Kpirida gifi bala baa yɩrɩɛ mɩnaŋ: wʋŋ wʋ dɔŋ asanaŋ na n nyina Simoŋ [wʋŋ baa yagɛ ɩ Petero] na wʋ nabu Andurusi, na Jamesi na Yohane Sebedi bie, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipo, Batolomiyo, Tomasi, Matiyo lampo lɩɛrɛ wʋŋ, Yakubu Alifiyosi bu, Tadiyosi, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simoŋ wʋŋ baa yagɛ ɩ sɛ Sɩlɔtɩ<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">Sɩlɔtɩtina ba yɩɛ Yudatina baa ba kʋlʋ yuo Romatina</char></note>, na Yudasi Isikariyoti wʋŋ wʋ lɩsɛ Yesu fa na.<verse eid="MAT 10:4" /></para>
  <para style="s1">Yesu kpiri wʋ kpalɛnara gifi bala baa</para>
  <para style="r">
    <ref loc="MRK 6:7-13">Maakɩ 6:7-13</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesu kpiri wʋ kpalɛnara gifi bala baa sɛ wʋ tawɩ ba sɛ, &lt;&lt;N baa ju baa ba ba yɩɛ Yudatina na salɛ yaa Samariyatina dɩɛ garɛ naŋ. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ama n ju Isiralitina baa ba kɩɛna takɩɛ feŋ batʋsʋsa na jaŋ. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Ɩ ju na, n tawɩ ba sɛ, &lt;Ɩsʋɔ Juori gaa tirina.&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />N chɔ lʋmɩɛtina, n feŋsi sira, n chɔ achalaŋa na ɩ geŋ feliŋ sʋbʋ lɩɩ bakpa tɩba. Ba mʋ yikuo gana fa amɩɛ kpakpuo bɛ, dɩmʋŋ sɛ amɩɛ gba n mʋ fa kpakpuo. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />N baa mʋ diterembi sɩɛm bi, diterembi fʋlʋm bi yaa nyɩŋgɩrɛ sɩɛm diterembi bi dʋ amɩɛ aterembie takpe naŋ. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Ɩ ju gbɩɛ na, n baa mʋ adiku, yaa adugbe gagba kpi, asibita kpi yaa daŋ gatugasa kpi. Akala takɩɛ dɩtʋm yɩɛrɛ daga wʋ kɩmtʋɔ.&gt;&gt;<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Dɩɛ yaa dɩɛ bie kʋma gaa ɩ ju ga tɩba na, n tasɛ ja wʋkʋma wʋŋ wʋ daga na wʋ a lɩɛ amɩɛ na, n cha wʋ waa dʋɔ ga tala saŋa gaa ɩ lɩɩ dɩmaŋ. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Waa kʋma gaa ɩ jʋʋ ga dʋɔ na, n tawɩ sɛ wʋsɛfɩɛ n kɔŋ amɩɛ dʋɔ. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Waa gana dʋɔ bakpa lɩɛ amɩɛ na, amɩɛ wʋsɛfɩɛ n kɔŋ ba dʋɔ. Ama sɛ ba n lɩɛ amɩɛ bɩrɛ, n yela na amɩɛ wʋsɛfɩɛ a bɔrɛ kɔŋ amɩɛ jaŋ. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Ama sɛ dɩɛ yaa waa garɛ dʋɔ bakpa pɩɛ amɩɛ yaa ba n nyii amɩɛ wɩɛ na. Ɩ lɩɩ dɩmaŋ na, n kpisi amɩɛ nafara tie dibuu wʋrʋgɩ dɩmaŋ. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Maa tawɩ sɛ n nyii na dieli sɛ Ɩsʋɔ wɩɛ di wɩɩ gaa na, wʋ a fɔŋɩ dɩɛ gana bakpa dɩla kii Sodomtina na Gomoratina.<verse eid="MAT 10:15" /></para>
  <para style="s1">Ganyala ŋii ŋii kɔŋ na</para>
  <para style="r">
    <ref loc="MRK 13:9-13">Maakɩ 13:9-13</ref>; <ref loc="LUK 21:12-17">Luka 21:12-17</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />N kɩɛ, maa kpiri amɩɛ takɩɛ feŋ sɛ n ju gbogboo aba naŋ. Dɩmʋŋ dʋɔ n yu kpiŋjim takɩɛ dʋmɩɛ na ɩ yɩɛ chɩrɩchɩrɩ takɩɛ Juori gakuosɛ.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />Dɩmʋŋ dʋɔ, &lt;&lt;N duo amɩɛ wʋsɛ dʋɔ lɩɩna bakpa dʋɔ. Baa chaŋ amɩɛ mʋ ju wɩɛ adiitiŋ bɩnɩɛ asanaŋ na baa taɩ amɩɛ Yudatina tʋm danɩŋ naŋ. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ma dʋɔ, baa mʋ amɩɛ mʋ ju Roma bɩnɩɛ baa baa kɩɛ Isirali tibi dʋɔ na, na juoneŋ asanaŋ na baa di amɩɛ wɩɛ. Dɩmaŋ sɛ ɩ yu gbɩɛ tawɩ Ɩsʋɔ Wɩɛ Abama ŋii fa ba na baa ba ba yɩɛ Yudatina na. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Sɛ ba chaŋ amɩɛ na, n baa nyala amɩɛ wʋsɛ wɩɛ ŋii ɩ tawɩ na dʋɔ yaa ganaŋkʋ ɩ tawɩ na. Dɩ tala dɩmaŋ na, Ɩsʋɔ aja kalaa amɩɛ ŋii ɩ tawɩ na. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Akala takɩɛ naa amɩɛ tɩŋtɩŋ aaŋ ja ɩ tawɩ ɩ, ama amɩɛ Juo Ɩsʋɔ Feliŋ aaŋ ja mʋna amɩɛ dʋɔ tawɩ.&gt;&gt;<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Nalʋrʋ bie aja lɩsɛ dɔŋa fa na baa kʋ ba, na juo a lɩsɛ wʋbu fa. Bachaasɛ aja kʋlʋ sɩŋ ba lʋrʋda dʋɔ na baa kʋ ba. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ma dʋɔ, bakpa kpiniŋ aja kɔla amɩɛ. Ama wʋŋ wʋ a sɩŋ na doŋ ga tala dɩtamtɩŋ na, wʋ a mɔlɔgɩ ɩ. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Sɛ ba nyala amɩɛ dɩɛ garɛ naŋ na, n se ju dɩɛ gafɔlɛ naŋ. Maa tawɩ sɛ n nyii na dieli sɛ ɩɩ taŋ Isirali dɩɛsɛ ajanɩɛ ŋii naŋ kɩlɩŋsɩ ɩ pɔɩ na Wʋkpa Bu wʋŋ a kɔŋ.&gt;&gt;<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;Kpalɛnarɛ baa kii wʋ wʋkalaasa a, sɛ tʋmɩrɛ baa kii wʋ kpaŋjuo o. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Wɩɛ dieli fa kpalɛnarɛ na wʋ a yɩɛ takɩɛ wʋ wʋkalaasa, na tʋmɩrɛ gba a yɩɛ takɩɛ wʋ kpaŋjuo. Sɛ ba yagɛ maŋ wʋŋ ma yɩɛ waa nyi sɛ Belesebu na, sɩnɛ sɛ baa yagɛ amɩɛ baa ɩ yɩɛ ma waa dʋɔtina!&gt;&gt;<verse eid="MAT 10:25" /></para>
  <para style="s1">Wʋŋ ba n se ɩ na</para>
  <para style="r">
    <ref loc="LUK 12:2-7">Luka 12:2-7</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;N baa se ba nyɩŋtɩɛ. Bʋrʋkʋma gaa ba fu ga dʋɔ na, gaa fulu dʋɔ na baa na. Dɩmʋŋ sɛ wɩɛ ŋii ŋɩ wɩsaɩ na, aja lɩɩ na baa na. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Wɩɛ kʋma ŋii maa tawɩ gɩbɩrɩ naŋ na, n tawɩ ŋɛ bakpa naŋ. Wɩɛ ŋii ba muni dʋ n dɩlɛ naŋ na, n jɔ ŋɩ dʋɔ dawuta.&gt;&gt; <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />N baa se baa baa dɩlɛ kʋ wʋsɛ nanɛ, ama baa dɩlɛ kʋ sʋbʋ ʋ. Ama n se Ɩsʋɔ wʋŋ wʋ a dɩlɛ warɩɛ sʋbʋ na wʋsɛ nanɛ kpiniŋ awʋrʋfʋɔ bʋala naŋ. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Naa kpaŋnyɔ sɛ baa mʋ lɩɛ tʋra jimbisi banʋŋ? Ama Ɩsʋɔ amɩɛ Juo n fa gbɩɛ na, ba wʋrʋ taŋ wʋ a sala a. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ama amɩɛ bɩrɛ, wʋ jiŋ amɩɛ nyi nyʋɔsɛ kpiniŋ nʋɔ. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Dɩmʋŋ dʋɔ n baa se nyɩŋtɩɛ, akala takɩɛ ɩ yɩɛ ba kpari kii tʋra jimbisi fɔɩ.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Maa tawɩ amɩɛ sɛ, wʋkʋma wʋŋ wʋ a tawɩ bakpa asanaŋ sɛ wʋ yɩɛ ma wʋrʋgbɩɛtɛ na, Wʋkpa Bu wʋŋ gba wʋ a lɩsɛ tawɩ sɛ wʋ yɩɛ ma wʋrʋgbɩɛtɛ Ɩsʋɔ Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na asanaŋ. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ama wʋkʋma wʋŋ wʋ pɩɛ maŋ bakpa asanaŋ na, maŋ gba, maa pɩɛ ɩ Ɩsʋɔ Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na asanaŋ.&gt;&gt;<verse eid="MAT 10:33" /></para>
  <para style="s1">Yesu n mʋ wʋsɛfɩɛ kɔŋ ŋ ama galu</para>
  <para style="r">
    <ref loc="LUK 12:51-53">Luka 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Sɛ Yesu tawɩ sɛ n ba fa nfɩɛrɛ sɛ wʋsɛfɩɛ sɛ ma mʋ kɔŋ tibi dʋɔ. Ma n kɔna wʋsɛfɩɛ ɛ, ama galu. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Akala takɩɛ ma kɔŋ sɛ,</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt;Bu baalɛ jaŋ a kʋlʋ wʋjuo dʋɔ,</para>
  <para style="q2" vid="MAT 10:35">bu alʋ jaŋ a kʋlʋ wʋnaa dʋɔ,</para>
  <para style="q1" vid="MAT 10:35">bu baalɛ jaŋ alʋ a kʋlʋ wʋ awu dʋɔ.<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />Na wʋkpa badʋŋna a yɩɛ wʋ tɩŋtɩŋ wʋ waa dʋɔtina.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">10:36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mik 7:6</ref>.</char></note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt;Wʋkʋma wʋŋ wʋ a ja wʋjuo yaa wʋnaa kii maŋ na, wʋ n daga na wʋ a yɩɛ ma wʋrʋgbɩɛtɛ ɛ. Dɩmʋŋ sɛ wʋkʋma wʋŋ wʋ a ja wʋ bu baalɛ jaŋ yaa alʋ jaŋ kii maŋ na, wʋ n daga na wʋ a yɩɛ ma wʋrʋgbɩɛtɛ ɛ. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Sɛ wʋkʋma wʋŋ wʋ n mʋ wʋ tɩŋtɩŋ wʋ daŋ gasagasa silɛ na wʋ a kpaŋ maŋ na, wʋ n daga na wʋ a yɩɛ ma wʋrʋgbɩɛtɛ ɛ. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Akala takɩɛ wʋkʋma wʋŋ wʋ a ja wʋ a yu nkpa fa wʋ wʋsɛ na, ŋii jɔ ɩ. Ama wʋkʋma wʋŋ wʋ nkpa jɔ ɩ lɩɩ ma dʋɔ na, wʋ a yu nkpa.&gt;&gt;<verse eid="MAT 10:39" /></para>
  <para style="s1">Ɩsʋɔ kɩmtʋɔ</para>
  <para style="r">
    <ref loc="MRK 9:41">Maakɩ 9:41</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Wʋkʋma wʋŋ wʋ lɩɛ nyaŋ na lɩɛ maŋ, sɛ wʋkʋma wʋŋ wʋ lɩɛ maŋ na lɩɛ wʋŋ wʋ kpiri maŋ na gba. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Wʋkʋma wʋŋ wʋ lɩɛ Ɩsʋɔ ɔja akala takɩɛ wʋ yɩɛ Ɩsʋɔ ɔja na, wʋ a yu ɔja kɩmtʋɔ. Sɛ wʋkʋma wʋŋ wʋ lɩɛ wʋkpa wʋchirigisa akala takɩɛ wʋ yɩɛ wʋkpa wʋchirigisa na, wʋ a yu wʋchirigisa kɩmtʋɔ. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Sɛ wʋkʋma wʋŋ wʋ a fa bachaasɛ bisi bana lɩŋ afɩɛsa na gafie akala takɩɛ wʋ yɩɛ ma kpalɛnarɛ na, maa tawɩ sɛ n nyii na dieli sɛ Ɩsʋɔ aja fa ɩ ŋɩ dʋɔ kɩmtʋɔ.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Yesu na Yohane Ɩsʋɔ Sɔrɛ wʋŋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Gʋ Yesu kalaa wʋ kpalɛnara gifi bala baa taŋ na, wʋ lɩɩ dɩmaŋ ju ga kalaa, sɛ wʋ tawɩ Ɩsʋɔ Wɩɛ Abama ŋii Galaliya dɩɛsɛ naŋ.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Gʋ Yohane Ɩsʋɔ Sɔrɛ wɩɛ danɛ dɩtʋɔtɩŋ sɛ wʋ nyii ŋii Kirisito a yɩɛ na, wʋ kpiri wʋ kpalɛnara <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />sɛ ba n ga tasɛ ɩ sɛ, &lt;&lt;Nyaŋ n nyina wʋŋ wʋ a kɔnɛ na yaa dɩ n kɩɛ wʋ fɔlɛ gbɩɛ?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;N bɔrɛ ju ga tawɩ Yohane ŋii ɩ naa na ŋii ɩ nyii sɛ, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />bataŋpʋna asa fulu, buobi aba palɛ, achalaŋa yu lʋm chʋɔ, akpawu a nyii wɩɛ, atatina feŋ lɩɩ sɩŋ naŋ, sɛ ayɔŋtina gba nyii Ɩsʋɔ wɩɛ abama ŋii. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Kusee n nyina wʋkʋma wʋŋ ma dʋɔ wʋ aa yela wʋ lɩɛdi naŋ ŋ.&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Gʋ Yohane kpalɛnara baa a bɔrɛ na, Yesu fara wʋ a tawɩ Yohane wʋsɛ dʋɔ wɩɛ wʋ a fa jama baa sɛ, &lt;&lt;Be sɛ ɩ ju ifuli dʋɔ ga kɩɛ? Ɩ ju ga kɩɛ ŋmɩrɛ ŋii feliŋ a jʋɔ naa? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Sɛ naa dɩmʋŋ na, be sɛ ɩ ju ga kɩɛ? Yaa baalɛ wʋŋ wʋ fuona gagbasɛ abama naa? Aye, baa ba fuona gagbasɛ abama ba chaɩ juorigbɩɛ na. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Be sɛ ɩ ju ga kɩɛ? Ɩsʋɔ ɔja? Gasiŋteŋ, maa tawɩ amɩɛ sɛ, Yohane wʋŋ ɩ naa na kii Ɩsʋɔ ɔja. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Yohane Ɩsʋɔ Sɔrɛ wina sɛ ba sabɩɛ wʋ wʋsɛ dʋɔ wɩɛ Ɩsʋɔ wɩɛ naŋ sɛ,</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt;Maa kpiri ma gabʋɔ pala nya asanaŋ</para>
  <para style="q2" vid="MAT 11:10">na wʋ a desina gbɩɛ si fa nyaŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref>.</char></note><verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Maa tawɩ sɛ n nyii na dieli sɛ Yohane Ɩsʋɔ Sɔrɛ yɩɛ wʋjanɛ kii wʋkʋma wʋŋ ba lʋrʋ ɩ. Ama wʋŋ wʋ yɩɛ wʋ pii Ɩsʋɔ Juori naŋ na, kii ɩ. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Lɩɩ Yohane saŋa mʋ gaa tala jaŋ, bakpa chɩdɩsɛ baa ja sɛ baa jʋʋ Ɩsʋɔ Juori gaa naŋ dʋɔ, baa ba mʋ dɩsɛ chɩbɛ chɩdɩsɛ na aaŋ ja baa yu gbɩɛ jʋʋ. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ɩsʋɔ bajana na Mosesi mbara ŋii kpiniŋ fɩla tawɩ Ɩsʋɔ Juori gaa wɩɛ pɔɩ sɛ Yohane kɔnɛ. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Sɛ ɩ ja sɛ ɩ lɩɛ dʋ na, Yohane wina n nyina Eliya wʋŋ wʋ a kɔŋ na. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Wʋkʋma wʋŋ wʋ wɩɛna dɩla na, wʋ n nyii.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Sɛ Yesu ju dʋɔ tawɩ sɛ be sɛ maa mʋ jaŋ gɩnanaŋ gana mʋ kɩɛsɩna? Ba kɩɛna bɛ takɩɛ bachaasɛ baa ba chaɩ gɩyɩɛ naŋ baa yagɛ dɔŋa baa tawɩ sɛ,<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt;Dɩ fʋlʋ galɩɛbɩ fa amɩɛ,</para>
  <para style="q2" vid="MAT 11:17">ama ɩŋ sʋɛ ɛ,</para>
  <para style="q1" vid="MAT 11:17">Dɩ kpie lie numba fa amɩɛ,</para>
  <para style="q2" vid="MAT 11:17">ama ɩŋ wii i.&gt;&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Gʋ Yohane Ɩsʋɔ Sɔrɛ wʋŋ kɔnɛ na, wʋ n di adiya a, sɛ wʋ n nyʋɔ sʋlʋŋ ŋ, sɛ ɩ tawɩ sɛ, &lt;&lt;Feliŋ sʋbʋ wɩɛ wʋ tɩba. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Wʋkpa Bu wʋŋ kɔnɛ na, wʋ a di sɛ wʋ a nyʋɔ, sɛ ɩ tawɩ sɛ n kɩɛ, wʋ yɩɛ diiri na sʋlʋŋ nyʋɔrɛ. Wʋ yɩɛ lampo lɩɛra na dɩsʋbʋ yɩɛra ba dɩɛtɛ. Bakpa baa ba wɩɛna Ɩsʋɔ kpiŋjim na, ba ayɩɛsa aja yela na baa tawɩ sɛ ŋɩ wɩɛ dieli.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s1">Dɩɛsɛ ŋii ŋɩ n lɩɛ Yesu di na</para>
  <para style="r">
    <ref loc="LUK 10:13-15">Luka 10:13-15</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Sɛ Yesu fara wʋ a tawɩ wʋ a baŋ bakpa baa ba wɩɛ dɩɛsɛ ajanɩɛ ŋii wʋ yɩɛ adaŋgana fɔɩ ŋɩ dʋɔ na, akala takɩɛ ba n biliŋi lɩɩ ba dɩsʋbʋ naŋ ŋ. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Korasintina, amɩɛ lakʋ! Betisayidatina, amɩɛ lakʋ! Nafʋɔ adaŋgana ŋii ma yɩɛ amɩɛ tɩba na sɛ ma yɩɛ Tirosi na Sidoŋ dɩmʋŋ na, nafʋɔ baa fu kotoku gagba na baa susaa npʋɔ na ŋii kalaa takɩɛ ba biliŋi lɩɩ ba dɩsʋbʋ naŋ taŋgɩlɛ. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ama maa tawɩ amɩɛ Korasintina na Betisayidatina sɛ, Ɩsʋɔ wɩɛ di wɩɩ gaa na, wʋ a fɔŋɩ amɩɛ dɩlɛ na dieli kii Tirositina na Sidoŋtina. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Amɩɛ Kapeniyumtina, ɩ jiŋ sɛ Ɩsʋɔ aja jiŋna amɩɛ Ɩsʋɔ adugbe bɛ? Aye, Ɩsʋɔ aja mʋ amɩɛ ju awʋrʋfʋɔ bʋala naŋ bɛ. Nafʋɔ adaŋgana ŋii ma yɩɛ amɩɛ tɩba na sɛ ma yɩɛ Sodom na, nafʋɔ ga saŋ ga wɩɛ gaa lɩɩ jaŋ. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Ama maa tawɩ amɩɛ Kapeniyumtina sɛ, Ɩsʋɔ wɩɛ di wɩɩ gaa na, wʋ a fɔŋɩ amɩɛ dɩlɛ na dieli kii Sodomtina.&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s1">N kɔŋ Yesu jaŋ na ɩ yu fɩɛsɛ</para>
  <para style="r">
    <ref loc="LUK 10:21-22">Luka 10:21-22</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Saŋa gana sɛ Yesu tawɩ sɛ, &lt;&lt;Majuo, Ɩsʋɔ adugbe na tie tɛ maa kalɩɛ nyaŋ gʋ nya mʋ wɩɛ ŋina wɩsɛ wɩɛ jimɩra na nfɩɛrɛtina, sɛ nya lɩsɛ kalaa bachaasɛ bisi. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ɛɛŋ, Majuo, ŋii nya yɩɛ na su nya asa.&gt;&gt;<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Majuo mʋ abʋrɩ kpiniŋ dʋ ma pam naŋ. Wʋrʋ ba jiŋ Bu wʋŋ ŋ, amʋɔ Juo wʋŋ nyiŋeŋ. Dɩmʋŋ sɛ wʋrʋ ba jiŋ Juo wʋŋ ŋ, amʋɔ Bu wʋŋ nyiŋeŋ na baa Bu wʋŋ a jawʋ na sɛ wʋ a lɩsɛ Juo wʋŋ kalaa ba.&gt;&gt;<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;N kɔŋ ma jaŋ, amɩɛ baa dɩ bɩɩ amɩɛ lɩɩna amɩɛ gasʋlasɛ ayuntina dʋɔ, maa yela na ɩ fɩɛsɛ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />N mʋ ma gasʋla na ɩ kpalɩɛna lɩɩ ma jaŋ, akala takɩɛ ma fʋʋ sɛ maa kɔna ma wʋsɛ tie ma digela naŋ, na ɩ yu fɩɛsɛ fa amɩɛ sʋbʋɛ. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Akala takɩɛ ma gasʋla taŋ doŋ na sɩlɛ sɛ ga taŋ yuŋ ŋ.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Fɩɛsɛ wɩɩ dʋɔ kpaŋjuo</para>
  <para style="r">
    <ref loc="MRK 2:23-28">Maakɩ 2:23-28</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Fɩɛsɛ wɩɩ garɛ, Yesu cha wʋ dɔŋ kiliŋgbe fʋɔ garɛ naŋ. Na dusoŋ chaŋ wʋ kpalɛnara baa, dɩmʋŋ dʋɔ ba fara baa jaɩ kiliŋgbe ŋii ŋarɛ baa tawʋ. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Gʋ Farasitina baa barɛ na dɩmʋŋ na, ba tawɩ Yesu sɛ, &lt;&lt;Kɩɛ, n kpalɛnara baa a yɩɛ ŋii daa mbara n fa gbɩɛ sɛ dɩ n yɩɛ Fɩɛsɛ wɩɩ.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Sɛ Yesu tasɛ ba sɛ, ɩŋ karaŋ Ɩsʋɔ Wɩɛ ŋii naŋ ŋii Dawidi yɩɛ saŋa gaa dusoŋ a kʋ wʋ na wʋ dɔŋa naa? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Wʋ ju Ɩsʋɔ tʋm danɛ gaa naŋ sɛ wʋ na wʋ dɔŋa ga tawʋ bodobodo gaa ba yɩɛ ga chɩrɩchɩrɩ fa Ɩsʋɔ yela Mosesi mbara n fa gbɩɛ sɛ ba n tawʋ ʋ, amʋɔ Ɩsʋɔ seina nyiŋeŋ. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Yaa ɩŋ karaŋ ta Mosesi mbara ŋii naŋ sɛ, Ɩsʋɔ seina wɩɛ Ɩsʋɔ tʋm danɛ naŋ Fɩɛsɛ wɩɩ kʋma baa yɩɛ dɩtʋm baa warɩɛ Fɩɛsɛ wɩɩ gaa, ama baa na ba takɩɛ ba di dɩpʋɛ ɛ? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Maa tawɩ amɩɛ sɛ wʋrʋ wɩɛ jɩna wʋ yɩɛ wʋ janɛ kii Ɩsʋɔ tʋm danɛ gaa. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Nafʋɔ ɩ nyii wɩɛ ŋii Ɩsʋɔ tawɩ Sabɩɛwɩɛ ŋii naŋ tie na sɛ, &lt;&lt;Maa ja gɩyɔŋ wɩɩ bɛ naa gadiesa a.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos 6:6</ref>.</char></note> Nafʋɔ ɩɩ fuu baa ba n yɩɛ dɩsʋbʋ na dɩpʋɛ ɛ. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Dɩmʋŋ dʋɔ, Wʋkpa Bu wʋŋ yɩɛ Kpaŋjuo Fɩɛsɛ wɩɩ dʋɔ bɛ.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s1">Yesu chɔ baalɛ wʋrʋ wʋ pam sɩŋ</para>
  <para style="r">
    <ref loc="MRK 3:1-6">Maakɩ 3:1-6</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Sɛ Yesu lɩɩ dɩmaŋ ga jʋʋ Yudatina tʋm danɛ naŋ. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Na baalɛ wʋrʋ wɩɛ dɩmaŋ wʋ pam sɩŋ. Na bakpa barɛ wɩɛ dɩmaŋ baa ja sɛ baa pʋɩ Yesu. Dɩmʋŋ dʋɔ ba tasɛ ɩ sɛ, &lt;&lt;Daa mbara fa gbɩɛ sɛ dɩ n chɔ Fɩɛsɛ wɩɩ?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Amɩɛ tɩba wʋrʋ wɩɛna fie sɛ wʋ sala bʋɔ naŋ Fɩɛsɛ wɩɩ na, wʋ aa lɩsɛ ɩ? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Wʋkpa yɩɛ wʋ kpari kii fie. Dɩmʋŋ dʋɔ mbara fa gbɩɛ sɛ dɩ n yɩɛ dɩbam Fɩɛsɛ wɩɩ.&gt;&gt;<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Sɛ Yesu tawɩ baalɛ wʋŋ sɛ, &lt;&lt;Tɩɛŋɩ n pam.&gt;&gt; Sɛ wʋ tɩɛŋɩ sɛ wʋ pam gaa yɩɛ doŋ takɩɛ ga baŋbaŋ na. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ama Farasitina baa lɩɩ tʋm danɛ gaa naŋ ga mʋ sawʋra ganaŋkʋ baa kʋ Yesu na.<verse eid="MAT 12:14" /></para>
  <para style="s1">Tʋmɩrɛ wʋŋ Ɩsʋɔ lɩsɛ ɩ na</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Gʋ Yesu jiŋ ba sawʋra na, wʋ lɩɩ dɩmaŋ. Bakpa fɔɩ kpaŋ ɩ sɛ wʋ chɔ lʋmɩɛtina baa kpiniŋ. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Sɛ Yesu jɔ ba nyienaŋ sɛ, ba n baa tawɩ wʋ tɛ wʋŋ wʋ yɩɛ na. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Ŋina yɩɛ dɩmʋŋ na wɩɛ ŋii Ɩsʋɔ pala na ɔja Yisaya dʋɔ tawɩ na a kɔŋ tɩba sɛ,<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Kɩɛ, wina n nyina ma tʋmɩrɛ wʋŋ ma lɩsɛ,</para>
  <para style="q2" vid="MAT 12:18">wʋŋ maa ja wʋ wɩɛ, ma asa su wʋ dʋɔ.</para>
  <para style="q1" vid="MAT 12:18">Maa mʋ ma Feliŋ fa ɩ</para>
  <para style="q2" vid="MAT 12:18">na wʋ a tawɩ wɩɛ ŋɩ gbɩɛ dʋɔ fa baa ba ba yɩɛ Yudatina.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Wʋ aa di noro o, yaa wʋ aa kuusi i,</para>
  <para style="q2" vid="MAT 12:19">wʋrʋ baa nyii wʋ lofu dɩɛ naŋ gbɩɛsɛ bisi dʋɔ ɔ.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Wʋ aa jaɩ ŋmɩrɛ ganyɔŋsa a,</para>
  <para style="q2" vid="MAT 12:20">sɛ wʋ aa duŋsi fitila ganya gaa gaa cham ama gaa naa na a.</para>
  <para style="q1" vid="MAT 12:20">Ga tala gʋ wʋ a yela na wɩɛ ŋɩ gbɩɛ dʋɔ a di dɩlɛ.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Wʋ yɩrɛ naŋ sɛ baa ba ba yɩɛ Yudatina aja baa yu tamaa.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Yis 42:1-4</ref>.</char></note><verse eid="MAT 12:21" /></para>
  <para style="s1">Yesu na Belesebu</para>
  <para style="r">
    <ref loc="MRK 3:20-30">Maakɩ 3:20-30</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Sɛ bakpa mʋ baalɛ wʋrʋ feliŋ sʋbʋ wɩɛ wʋ tɩba sɛ wʋ yɩɛ ɔtaŋpʋ na namu kɔna Yesu. Sɛ wʋ chɔ ɩ, sɛ wʋ tawɩ yela wʋ a na. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Sɛ dɩ yɩɛ bakpa baa kpiniŋ doba sɛ ba tasɛ sɛ, &lt;&lt;Wina yɩɛ Dawidi ganana bie wʋŋ bɛ yaa?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Ama gʋ Farasitina baa nyii ŋina na, ba tawɩ sɛ, &lt;&lt;Belesebu<note caller="+" style="f"><char style="fr" closed="false">12:24 </char><char style="ft" closed="false">Belesebu wʋŋ n nyina Sɩtanɩ</char></note> wʋŋ wʋ yɩɛ feliŋ sʋbʋ bɩnɛ na yikuo sɛ wʋ chamɩna wʋ a geŋ feliŋ sʋbʋ wʋ a lɩɩ bakpa tɩba.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Ama gʋ Yesu jiŋ ba nfɩɛrɛ na sɛ wʋ tawɩ ba sɛ, &lt;&lt;Juori kʋma gaa ga kpara ga wʋsɛ tɩba gaa yuo dɔŋa na, gaa salɩɛ. Dɩmʋŋ sɛ dɩɛ janɛ yaa waa kʋma gaa ga kpara ga wʋsɛ tɩba gaa yuo dɔŋa na, gaa salɩɛ. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Sɛ Sɩtanɩ geŋ Sɩtanɩ na, wʋ a yuo wʋ wʋsɛ. Aja yɩɛ sɩnɛ na wʋ juori a sɩŋ ga nafara dʋɔ. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Sɛ ɩ tawɩ sɛ Belesebu yikuo sɛ ma chamɩna maa gɩŋ feliŋ sʋbʋ maa lɩɩ bakpa tɩba na, dɩmʋŋ bɩrɛ Mmʋɔ yikuo sɛ amɩɛ kpamɩra dʋɔ chamɩna baa gɩŋ feliŋ sʋbʋ baa lɩɩ bakpa tɩba? Sɛ dɩ yɩɛ dɩmʋŋ bɩrɛ baa aaŋ ja baa yɩɛ amɩɛ wɩɛ dira. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ama sɛ Ɩsʋɔ Feliŋ sɛ ma chamɩna maa gɩŋ feliŋ sʋbʋ maa lɩɩ bakpa tɩba na, dɩmʋŋ bɩrɛ Ɩsʋɔ Juori kɔŋ amɩɛ jaŋ.&gt;&gt;<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt;Yaa wʋrʋ taŋ wʋ a dɩlɛ ju doŋ-tɛ waa dʋɔ ga mʋ wʋ gapatɩɛ ɛ amʋɔ wʋ chɩŋkpɩɛ pɔgʋ ɩ pɔɩ na wʋ a dɩlɛ ŋmɛlɩ ɩ.&gt;&gt;<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Wʋkʋma wʋŋ wʋ n kpi ma dʋɔ na, wʋ a kʋlʋ sɩŋ ma dʋɔ. Wʋkʋma wʋŋ wʋ aa kʋla wʋ a chɔna maŋ ŋ, a yasɩŋ tɩba bɛ.&gt;&gt; <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Dɩmʋŋ dʋɔ maa tawɩ amɩɛ sɛ, Ɩsʋɔ aja mʋ dɩsʋbʋ kʋma gaa wʋkpa aja yɩɛ na mbusu wɩɛ ŋii wʋ a tawɩ na chɩɛ ɩ. Ama wʋkʋma wʋŋ wʋ a tawɩ mbusu wɩɛ baŋ Ɩsʋɔ Feliŋ na bɩrɛ, wʋ aa mʋ chɩɛ ɩ. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Wʋkʋma wʋŋ wʋ a tawɩ wɩɛ baŋ Wʋkpa Bu wʋŋ na, Ɩsʋɔ aja mʋ chɩɛ ɩ. Ama wʋkʋma wʋŋ wʋ a tawɩ mbusu wɩɛ baŋ Ɩsʋɔ Feliŋ na bɩrɛ, wʋ aa mʋ chɩɛ ɩ dulunya gana naŋ yaa dulunya gaa gaa kɔŋ na naŋ ŋ.<verse eid="MAT 12:32" /></para>
  <para style="s1">Daŋ na ga bie</para>
  <para style="r">
    <ref loc="LUK 6:43-45">Luka 6:43-45</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Yɩɛ daŋ gabam na ga bie a yɩɛ abama, yaa yɩɛ daŋ ga sʋbʋ na ga bie a yɩɛ asʋbʋɛ. Akala takɩɛ daŋ gaa bie sɛ ba chamɩna baa jiŋ ga. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ɩ yɩɛ bakpa sʋbʋɛ takɩɛ dʋmɩɛ, sɩnɛ sɛ amɩɛ bakpa sʋbʋɛ a dɩlɛ tawɩ wɩɛ abama? Akala takɩɛ wɩɛ ŋii ŋɩ suu wʋkpa digela naŋ na, ŋii aaŋ lɩɩna wʋ nʋɔ. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Wʋkpa bam a lɩsɛ wɩɛ abama ŋii ŋɩ wɩɛ wʋ digela naŋ na asoŋ. Dɩmʋŋ sɛ wʋkpa sʋbʋ gba a lɩsɛ wɩɛ asʋbʋɛ ŋii ŋɩ wɩɛ wʋ digela naŋ na asoŋ. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Ama maa tawɩ amɩɛ sɛ Ɩsʋɔ wɩɛ di wɩɩ gaa na, dɩtawɩ jaga kʋma gaa wʋkpa tawɩ na, wʋ a lɩsɛ ga nʋɔ. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Akala takɩɛ Ɩsʋɔ aja sɩŋ n dɩ tawɩ dʋɔ bɛ tala n wɩɛ takɩɛ n di dɩlɛ yaa n di dɩpʋɛ.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s1">Farasitina tasɛ Yesu adaŋgana</para>
  <para style="r">
    <ref loc="MRK 8:11-12">Maakɩ 8:11-12</ref>; <ref loc="LUK 11:29-32">Luka 11:29-32</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Sɛ Farasitina na Mosesi mbara bakalaasa baa barɛ tawɩ Yesu sɛ, &lt;&lt;Wʋkalaasa, dɩɩ ja sɛ dɩɩ na adaŋgana lɩɩ n jaŋ.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Amɩɛ nyinaŋ doŋtina na gɩnanaŋ gaa ɩ yɩɛ gɩ baa di gasiŋteŋ fa Ɩsʋɔ, ɩ ja adaŋgana na ɩ na. Ama ɩɩ na ŋarɛ ɛ, amʋɔ ŋii ŋɩ tibi ɔja Yona dʋɔ na. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Takɩɛ ganaŋkʋ Yona cha di wɩɛ atoro wiita na yuluma diji janɛ lorinaŋ na, dɩmʋŋ sɛ Wʋkpa Bu wʋŋ gba aja di wɩɛ atoro wiita na yuluma gachaŋ naŋ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Niniwetina aja kʋlʋ sɩŋ fu gɩnanaŋ gana dɩpʋɛ Ɩsʋɔ wɩɛ di wɩɩ. Akala takɩɛ ba nyii Yona wɩɛ na, ba biliŋi lɩɩ ba dɩsʋbʋ naŋ. Kɩɛ, wʋŋ wʋ kii Yona na wɩɛ jɩna. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Siba ala Juo aja kʋlʋ sɩŋ na wʋ a fu gɩnanaŋ gana dɩpʋɛ Ɩsʋɔ wɩɛ di wɩɩ. Akala takɩɛ wʋ lɩɩ taŋasɛ gaa nyii Solomoŋ kpiŋjim wɩɛ. Kɩɛ, wʋŋ wʋ kii Solomoŋ na wɩɛ jɩna.&gt;&gt;<verse eid="MAT 12:42" /></para>
  <para style="s1">Feliŋ sʋbʋ bɔrɛ kɔŋ</para>
  <para style="r">
    <ref loc="LUK 11:24-26">Luka 11:24-26</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Feliŋ sʋbʋ lɩɩ wʋkpa tɩba na, wʋ dɔŋ ifuli dʋɔ bɛ wʋ a ja dɩchatɩŋ. Sɛ wʋ n yu na, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />wʋ a tawɩ bɛ sɛ, &lt;Maa ti bɔrɛ ju ma waa gabɩnɛ dʋɔ.&gt;Wʋ bɔrɛ kɔŋ gaa na gʋ wʋrʋ taŋ waa gaa ba desina ga dʋɔ na dieli na, <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />wʋ a bɔrɛ ga mʋ feliŋ sʋbʋ lɩkaarɛ baa ba wɩɛ nyinaŋ doŋ kii ɩ, na baa gaa cha wʋkpa wʋŋ tɩba. Na wʋkpa wina chawʋ naŋ a warɩɛ kii wʋ chawʋ gɩbɩnɩŋ. Dɩmʋŋ sɛ aja yɩɛ fa amɩɛ nyinaŋ doŋ gɩnanaŋ gana.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s1">Yesu wʋnaa na wʋnabie</para>
  <para style="r">
    <ref loc="MRK 3:31-35">Maakɩ 3:31-35</ref>; <ref loc="LUK 8:19-21">Luka 8:19-21</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Gʋ Yesu saŋ wʋ a tawɩ wʋ a fa jama baa na, wʋnaa na wʋnabie gaa sɩŋ waa gaa asʋŋ baa ja sɛ baa tawɩ wʋ jaŋ. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Sɛ wʋrʋ tawɩ ɩ sɛ, &lt;&lt;Kɩɛ, nnaa na nnabie sɩmɩɛɩ waa gaa asʋŋ baa ja sɛ baa tawɩ n jaŋ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">Naa Sabɩɛwɩɛ ŋii kpiniŋ n wɩɛna kparatɩba gana</char></note><verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Sɛ Yesu tasɛ ɩ sɛ, &lt;&lt;Mmʋɔ n nyina manaa sɛ Mmʋɔ n nyina manabie?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Sɛ wʋ mʋ wʋ pam kalaa wʋ kpalɛnara baa tawɩ sɛ, &lt;&lt;Kɩɛ, manaa na ma manabie mɩnaŋ. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Wʋkʋma wʋŋ wʋ a yɩɛ Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe jawʋ na n nyina manaa, manabu na madiesi.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Ŋmatɩrɛ wʋrʋ dʋɔ diduu</para>
  <para style="r">
    <ref loc="MRK 4:1-9">Maakɩ 4:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Dɩmʋŋ wɩɩ gana Yesu lɩɩ waa dʋɔ ju ga cha lɩɩ nʋɔ. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Jama baa ba logo ɩ na dʋɔ, wʋ jʋʋ cha bori naŋ yela bakpa baa kpiniŋ sɩmɩɛɩ lɩɩ gaa nʋɔ. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Sɛ wʋ mʋ aduuna kalaa ba wɩɛ fɔɩ sɛ, &lt;&lt;N nyii! Faradɛ wʋrʋ n ju na wʋ a ga ŋmati adiya bie. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Gʋ wʋ a ŋmati na, ŋarɛ sala gbɩɛ laraŋ sɛ jimbisi kɔŋ gaa tɔɔsɩ ŋɩ kpiniŋ di. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Sɛ ŋarɛ sala bʋɛ dʋɔ diele gaa tɩɛra taŋ fɔɩ na. Bie ŋii tu bileŋ akala takɩɛ tɩɛra fɔɩ taŋ bʋɛ ŋii dʋɔ ɔ, <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />dɩmʋŋ dʋɔ, wiita lɩɩ na ŋɩ ŋɩɛwʋ, akala takɩɛ ŋɩ tana lira a. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Sɛ ŋarɛ dʋɔ sala sɔba tibi dʋɔ. Sɛ sɔba ŋii bɩɩ ŋɩrɛ adiya bie ŋii. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Dɩmʋŋ sɛ ŋarɛ dʋɔ sala tibi bam dʋɔ, sɛ ŋɩ si bie. Ŋarɛ si gafie, ŋitoro yaa gbɩɛta nkuo na sala kii ŋii wʋ ŋmati na.&gt;&gt;<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Wʋŋ wʋ wɩɛna dɩla na, wʋ n nyii.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s1">Kpɩnɩdɩ dʋɔ sɛ Yesu tawɩ aduuna naŋ</para>
  <para style="r">
    <ref loc="MRK 4:10-12">Maakɩ 4:10-12</ref>; <ref loc="LUK 8:9-10">Luka 8:9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Sɛ Yesu kpalɛnara baa kɔŋ wʋ jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Be n yɩɛ sɛ nyaa tawɩ nyaa fa bakpa baa aduuna naŋ?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Sɛ wʋ lɩsɛ ba nʋɔ sɛ, &lt;&lt;Amɩɛ bɩrɛ, Ɩsʋɔ yela sɛ ɩ nyii wʋ juori asiri wɩɛ ŋii tie, ama baa bɩrɛ wʋ mʋ wɩsɛ ba. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Wʋkʋma wʋŋ wʋ wɩɛna bʋrʋ garɛ na, Ɩsʋɔ aja mʋ ŋarɛ kpi wʋ dʋɔ na wʋ a yu fɔɩ. Ama wʋkʋma wʋŋ wʋ tana na, pii ŋii wʋ wɩɛna ŋɛ na, Ɩsʋɔ aja lɩɛ lɩɩ wʋ jaŋ.&gt;&gt; <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ŋina dʋɔ sɛ maa tawɩ aduuna naŋ maa fa ba sɛ,</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;Baa kɩɛ, ama baa na a,</para>
  <para style="q2" vid="MAT 13:13">baa nyii, ama baa nyii i yaa baa nyii tie e.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />Ŋina yela sɛ Ɩsʋɔ ɔja Yisaya gbalɩŋwɩɛ ŋii kɔŋ tɩba sɛ,</para>
  <para style="q1" vid="MAT 13:14">Ɩ nyii, ama ɩɩ nyii tie ɩ.</para>
  <para style="q2" vid="MAT 13:14">Ɩ kɩɛ, ama ɩɩ na a.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Akala takɩɛ bakpa bana agela wɩɛ doŋ,</para>
  <para style="q2" vid="MAT 13:15">ba tɔ ba dɩla,</para>
  <para style="q2" vid="MAT 13:15">sɛ ba fu ba asa.</para>
  <para style="q1" vid="MAT 13:15">Naa dɩmʋŋ na, nafʋɔ ba asa aja na,</para>
  <para style="q1" vid="MAT 13:15">baa nyii,</para>
  <para style="q1" vid="MAT 13:15">ba agela a nyii wɩɛ tie.</para>
  <para style="q2" vid="MAT 13:15">Na baa biliŋi lɩɩ ba dɩsʋbʋ naŋ kɔŋ ma jaŋ, na maa chɔ ba.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Yis 6:9-10</ref>. </char></note><verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Kusee n nyina amɩɛ baa amɩɛ asa a na sɛ amɩɛ dɩla a nyii. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Maa tawɩ sɛ n nyii na dieli sɛ Ɩsʋɔ bajana na bachirigisa galaga aja sɛ baa na ŋii ɩ na, ama ba n na a. Na baa nyii ŋii ɩ nyii na, ama ba n nyii i.<verse eid="MAT 13:17" /></para>
  <para style="s1">Yesu kalaa ŋmatɩrɛ diduu gaa tie</para>
  <para style="r">
    <ref loc="MRK 4:13-20">Maakɩ 4:13-20</ref>; <ref loc="LUK 8:11-15">Luka 8:11-15</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Sɛ Yesu tawɩ sɛ, &lt;&lt;N nyii bʋrʋ gaa ŋmatɩrɛ wʋŋ diduu gaa akala na. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Adiya bie ŋii ŋɩ sala gbɩɛ laraŋ na n nyina bakpa baa ba nyii Ɩsʋɔ Juori gaa wɩɛ sɛ ba n nyii tie na, Sɩtanɩ a gaa lɩsɛ bie ŋii ba duu ba agela naŋ na. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Bie ŋii ŋɩ sala bʋɛ tibi dʋɔ na n nyina bakpa baa ba nyii Ɩsʋɔ wɩɛ na, gabʋanaŋ sɛ baa mʋ asadi mʋ wɩɛ ŋii. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ama gʋ wɩɛ ŋii n pɩsɛ ba agela naŋ dʋɔ, baa dɩlɛ baa sɩŋ ba lɩɛdi naŋ taŋgɩlɛ ɛ. Sɛ awʋrʋfʋɔ yaa ga nyala kɔŋ ba dʋɔ lɩɩ Ɩsʋɔ wɩɛ dʋɔ na, sɛ baa yela ba lɩɛdi naŋ. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Bie ŋii ŋɩ sala sɔba tibi dʋɔ na n nyina bakpa baa ba nyii Ɩsʋɔ wɩɛ, ama chawʋ naŋ wɩɛ bisi na aterembie dɩsɛchɩbɛ a gaa wɩɛ ŋii gbɩɛ, ŋɩ yela sɛ ŋii dɩlɛ ŋii si bie ɩ. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Ama adiya bie ŋii ŋɩ sala tibi bam dʋɔ na n nyina bakpa baa ba nyii Ɩsʋɔ wɩɛ ŋii sɛ ba nyii ŋɩ tie. Ba si bie gafie, ŋarɛ dʋɔ ŋitoro, sɛ ŋarɛ dʋɔ gbɩɛta nkuo sala kii ŋii ba ŋmati na.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s1">Kasɛ bie dʋɔ diduu</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Sɛ Yesu ti bɔrɛ jɔ ba diduu sɛ, &lt;&lt;Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ gʋ baalɛ wʋrʋ ga ŋmati adiya bie abama wʋ fʋɔ naŋ. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Gʋ wʋkʋma duo na, sɛ wʋ ɔdʋŋ gaa ŋmati kasɛ sʋbʋ bie gamɩsɛ ŋii naŋ, sɛ wʋ lam. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Gʋ gamɩsɛ ŋii nɔgʋ ŋii lʋrʋ na, sɛ kasɛ sʋbʋ ŋii lɩɩ ifuli.&gt;&gt;<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />Sɛ fʋɔtɛ wʋŋ tʋmɩra kɔŋ wʋ jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Kpaŋjuo, naa adiya bie abama sɛ nya ŋmati n fʋɔ naŋ? Le sɛ dɩmʋŋ kasɛ sʋbʋ ŋina lɩɩ?&gt;&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />Sɛ wʋ lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Ma ɔdʋŋ n gaa yɩɛ dɩmʋŋ.&gt;&gt;</para>
  <para style="p" vid="MAT 13:28">Sɛ wʋ tʋmɩra baa tasɛ ɩ sɛ, &lt;&lt;Nyaa ja sɛ dɩ ju ga kuli ŋɛ tʋsʋ?&gt;&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />Sɛ wʋ lɩsɛ ba nʋɔ sɛ, &lt;&lt;Aye, ɩ kuli ŋɛ na, ɩ dɩlɛ kuli gamɩsɛ ŋii bʋga na ŋɛ. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />N yela na ŋii bʋla ŋii bɩɩ bʋga ga tala karɩŋ saŋa. Saŋa gana na, maa tawɩ karada baa sɛ ba n chɩŋkpɩɛ kui kasɛ sʋbʋ ŋii na baa pɔgʋ ŋɛ akpeŋ-akpeŋ na baa tʋ ŋɛ. Na baa kʋla gamɩsɛ ŋii ga dʋ ma dichonkon naŋ.&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s1">Kpeli daŋ bi dʋɔ diduu</para>
  <para style="r">
    <ref loc="MRK 4:30-32">Maakɩ 4:30-32</ref>; <ref loc="LUK 13:18-19">Luka 13:18-19</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesu ti jɔ ba diduu baŋbaŋ sɛ, &lt;&lt;Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ kpeli daŋ bi gaa baalɛ wʋrʋ mʋ duu wʋ fʋɔnaŋ. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ga yɩɛ gapii adiya bie kpiniŋ naŋ bɩrɛ, ama ga bɩɩ na, gaa yɩɛ daŋ janɛ dasɛ bie ŋii baa duu na kpiniŋ naŋ, sɛ gaa gaa yɩɛ daŋ sɛ jimbisi a gaa yɩɛ gasɩsasɛ ga gayabɩsɛ naŋ.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="s1">Yiisi dʋɔ diduu</para>
  <para style="r">
    <ref loc="LUK 13:20-21">Luka 13:20-21</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Sɛ Yesu ti bɔrɛ jɔ diduu baŋbaŋ sɛ, &lt;&lt;Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ yiisi gaa alʋ wʋrʋ mʋ pii bʋga bodobodo mʋlʋŋ ŋii ŋɩ bɔlɩɛɩ na naŋ. Sɛ dɩ yela sɛ ŋɩ yɩɛ gafʋʋ.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu tawɩ ŋina kpiniŋ fa jama baa aduuna naŋ bɛ, wʋ n tawɩ wɩɛ ŋarɛ fa ba sɛ wʋ n jɔ diduu u. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Wʋ yɩɛ dɩmʋŋ bɛ na wɩɛ ŋii Ɩsʋɔ pala na ɔja Yisaya dʋɔ tawɩ si na a kɔŋ tɩba sɛ,</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Maa tawɩ Aduuna naŋ.</para>
  <para style="q2" vid="MAT 13:35">Maa tawɩ asiri wɩɛ lɩɩ saŋa gaa ba lɔ dulunya.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s1">Yesu kalaa kasɛ sʋbʋ dʋɔ diduu gaa tie</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Sɛ Yesu yela jama baa sɛ wʋ ju waa dʋɔ. Sɛ wʋ kpalɛnara baa kɔŋ wʋ jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Lɩsɛ kasɛ sʋbʋ dʋɔ diduu gaa tie kalaa daa.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Sɛ wʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Wʋŋ wʋ duu adiya bie abama ŋii na n nyina Wʋkpa Bu wʋŋ. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Fʋɔ gaa n nyina dulunya, sɛ adiya bie abama ŋii n nyina Ɩsʋɔ juori gaa bakpa. Kasɛ sʋbʋ gaa n nyina Sɩtanɩ bakpa. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Sɛ ɔdʋŋ wʋŋ wʋ ŋmati ŋɛ na n nyina Sɩtanɩ. Karɩŋ saŋa gaa n nyina dulunya dɩtamtɩŋ, sɛ karada baa n nyina Ɩsʋɔ gabʋɔsɛ.&gt;&gt;<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Takɩɛ ganaŋkʋ baa kuli kasɛ sʋbʋ ga tʋ bʋala naŋ na, dɩmʋŋ sɛ aja yɩɛ dulunya dɩtamtɩŋ. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Wʋkpa Bu wʋŋ aja kpiri wʋ gabʋɔsɛ na baa gaa lɩsɛ bʋrʋ gaa gaa yela sɛ wʋkpa a yɩɛ dɩsʋbʋ, na baa baa yɩɛ dɩsʋbʋ na lɩɩ wʋ juori gaa naŋ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Na baa lɔ ba dʋ awʋrʋfʋɔ diele bʋala naŋ, dɩmaŋ sɛ wiiniŋ na kela naŋ tawʋ wɩɛ. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Na bachirigisa a ŋalagi dʋɔ takɩɛ wiita ba Juo Juori gaa naŋ. Wʋŋ wʋ wɩɛna dɩla na, wʋ n nyii.&gt;&gt;<verse eid="MAT 13:43" /></para>
  <para style="s1">Akpaŋta kpari gaa ga wɩsaɩ na dʋɔ diduu</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Sɛ Yesu ti bɔrɛ jɔ ba diduu sɛ, &lt;&lt;Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ akpaŋta kpari gaa ba mʋ wɩsɛ fʋɔ garɛ naŋ. Sɛ baalɛ wʋrʋ ga na ga, sɛ wʋ ti mʋ wɩsɛ. Sɛ wʋ mʋ asadi ga yaa wʋ abʋrɩ kpiniŋ mʋ ga lɩɛ fʋɔ gaa.&gt;&gt;<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ gʋ yawʋ diri a ja bʋɛ abama. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Gʋ wʋ ga yu gakpari garɛ na, wʋ ga yaa wʋ abʋrɩ kpiniŋ mʋ ga lɩɛ ga.&gt;&gt;<verse eid="MAT 13:46" /></para>
  <para style="s1">Disawu dʋɔ diduu</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Sɛ Yesu ti bɔrɛ jɔ diduu sɛ, &lt;&lt;Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ disawu gaa ba lɔ dʋ lɩɩ naŋ sɛ ba chaŋ aji ngoriŋ-ngoriŋ na bɛ. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Gʋ ga suu na, sɛ aji chamɩra baa fɔŋɩ ga lɩɩ lɩɩ gaa nʋɔ. Sɛ ba cha tɔɔsɩ aji ba bama baa dʋ gachaŋa naŋ, sɛ ba lɔ baa ba taŋ dieli na tʋsʋ. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Dɩmʋŋ sɛ aja yɩɛ dulunya dɩtamtɩŋ. Ɩsʋɔ gabʋɔsɛ aja kɔŋ gaa lɩsɛ basʋbʋɛ lɩɩ bachirigisa naŋ. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Na baa lɔ ba dʋ awʋrʋfʋɔ diele bʋala naŋ, dɩmaŋ sɛ wiiniŋ na kela naŋ tawʋ wɩɛ.&gt;&gt;<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Ɩ nyii aduuna ŋina kpiniŋ tie?&gt;&gt;Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Ɛɛŋ.&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Dɩmʋŋ dʋɔ, mbara wʋkalaasa kʋma wʋŋ wʋ gaa yɩɛ kpalɛnarɛ Ɩsʋɔ Juori gaa dʋɔ na, kɩɛna bɛ takɩɛ waatɛ wʋŋ wʋ lɩsɛ wʋ a akpaŋta kpari afɔlɩɛ na abɩnɩɛ lɩɩ wʋ akpaŋta dɩsɩɩtɩŋ na bɛ.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s1">Nasaratitina pɩɛ Yesu</para>
  <para style="r">
    <ref loc="MRK 6:1-6">Maakɩ 6:1-6</ref>; <ref loc="LUK 4:16-30">Luka 4:16-30</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Gʋ Yesu jɔ ba aduuna ŋina taŋ na sɛ wʋ lɩɩ dɩmaŋ. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Sɛ wʋ bɔrɛ ju wʋ tɩŋtɩŋ wʋ dɩɛnaŋ. Sɛ wʋ fara wʋ a kalaa bakpa Yudatina tʋm danɛ naŋ sɛ dɩ yɩɛ ba doba. Sɛ ba tasɛ sɛ, &lt;&lt;Le sɛ baalɛ wina yu dɩmʋŋ kpiŋjim sɛ wʋ a yɩɛ adaŋgana ŋina?&gt;&gt; <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Sɛ ba tasɛ sɛ, &lt;&lt;Naa kapinta wʋŋ bu mɩnaŋ? Naa wʋ naa n nyina Mariya wʋŋ wʋ nabie yɩɛ Jamesi, Yosefu, Simoŋ na Yudasi naa? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Naa wʋ diesina kpiniŋ n wɩɛna daa jaŋ n naa?&gt;&gt; Le sɛ baalɛ wina yu abʋrɩ ŋina? <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Dɩmʋŋ dʋɔ ba pɩɛ ɩ. Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Ɩsʋɔ ɔja wɩɛna jilima gapɩlɛkʋma amʋɔ wʋ tɩŋtɩŋ wʋ dɩɛ naŋ na wʋ waa dʋɔ nyiŋeŋ.&gt;&gt;<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Yesu n dɩlɛ yɩɛ adaŋgana fɔɩ dɩmaŋ ŋ, akalaa takɩɛ ba tana lɩɛdi i.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Yohane Ɩsʋɔ Sɔrɛ wʋŋ sɩŋ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 6:14-29">Maakɩ 6:14-29</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Dɩmʋŋ saŋa gana na, Juo Hɛrɔdɩ wʋŋ wʋ yɩɛ juo Galaliya tibi dʋɔ na nyii Yesu wʋsɛ dʋɔ wɩɛ, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />sɛ wʋ tawɩ wʋ bɩnɩɛ sɛ, &lt;&lt;Wina n nyina Yohane Ɩsʋɔ Sɔrɛ wʋŋ wʋ feŋ lɩɩ sɩŋ naŋ na, dɩmʋŋ dʋɔ sɛ wʋ wɩɛna yikuo wʋ a yɩɛ adaŋgana ŋina.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Hɛrɔdɩ wina n cha yela sɛ ba chaŋ Yohane Ɩsʋɔ Sɔrɛ wʋŋ, sɛ ba mʋ dɩgbaraŋgbaraŋ pɔgʋ ɩ mʋ ɩ tɔ danɛ, akala takɩɛ Yohane n kpa sɛ wʋ n lɩɛ wʋ nabu Filipo alʋ Hɛrɔdɩya saa a. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yohane a tawɩ ɩ saŋa kʋma sɛ, &lt;&lt;Mosesi mbara n fa gbɩɛ sɛ nyaŋ Hɛrɔdɩ n saa nnabu alʋ ʋ.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hɛrɔdɩ cha wʋ a ja wʋ a kʋ Yohane ama wʋ a se bakpa baa, akala takɩɛ bakpa baa kpiniŋ lɩɛ Yohane di gʋ wʋ yɩɛ Ɩsʋɔ ɔja bɛ.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Gʋ Juo Hɛrɔdɩ lʋrʋ wɩɩ talɛ na, wʋ yagɛ asadi adiya di. Dɩmaŋ sɛ Hɛrɔdɩya bu galibie sʋɛ fa ba sɛ dɩ su Juo Hɛrɔdɩ asa fɔɩ <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />sɛ wʋ ka ntaŋ tawɩ galibie wʋŋ sɛ bʋrʋkʋma gaa wʋ a tasɛ ɩ na wʋ a fa ɩ. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Sɛ wʋnaa tawɩ ɩ sɛ ju ga tawɩ Juo Hɛrɔdɩ sɛ, &lt;&lt;Fa maŋ Yohane Ɩsʋɔ Sɔrɛ wʋŋ nyi taŋgiraŋ dʋɔ.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Juo Hɛrɔdɩ asa n lɩɛ ɛ, ama ntaŋ ŋii wʋ ka na baa wʋ lɔ pam yagɛ ba na dʋɔ, wʋ dʋ sɛ ba n yɩɛ ŋii galibie wʋŋ tasɛ na fa ɩ <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />sɛ wʋ yela sɛ ba ga kara Yohane nyi danɛ dɩtʋɔtɩŋ. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Sɛ ba ju ga kara wʋ nyi mʋ jaga taŋgiraŋ dʋɔ mʋ kɔna galibie wʋŋ. Sɛ wʋ mʋ ju ga fa wʋnaa. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Sɛ Yohane kpalɛnara baa kɔŋ gaa mʋ wʋ gɩtatɛ ga wuu. Sɛ ba ju ga tawɩ Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesu disi bakpa kɔrʋɔsɛ sɩ nʋŋ adiya</para>
  <para style="r">
    <ref loc="MRK 6:30-44">Maakɩ 6:30-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Gʋ Yesu nyii ŋii ŋɩ tibi na, wʋ jʋʋ buori naŋ ju ifuli dʋɔ. Gʋ jama baa nyii dɩmʋŋ na, ba pala lɩɩ akpie dʋɔ kpaŋ ɩ. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Gʋ Yesu tibi buori naŋ sɛ wʋ na bakpa fɔɩ baa na, ba wɩɛ yɩɛ ɩ gɩyɔŋ sɛ wʋ chɔ ba tɩba lʋmɩɛtina.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Gʋ dɩ tala bʋyanɔ na, wʋ kpalɛnara baa kɔŋ wʋ jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Jɩna yɩɛ ifuli dʋɔ bɛ tɩɛ dʋɔ tam. Lɩsɛ bakpa fɔɩ baa gbɩɛ na baa ju dɩɛsɛ bisi naŋ na ba tɩŋtɩŋ baa ju ga lɩɛ adiya di.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Ŋɩ n daga baa laŋ ŋ. Amɩɛ tɩŋtɩŋ n fa ba adiya na baa di.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Sɛ wʋ kpalɛnara baa lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Bodobodo anʋŋ na aji bala nyiŋeŋ sɛ dɩ wɩɛna.&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;N mʋ ŋɛ kɔna maŋ jɩna.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Sɛ wʋ yela sɛ bakpa baa cha kasɛ ŋii dʋɔ. Sɛ wʋ mʋ bodobodo anʋŋ ŋii na aji bala baa, sɛ wʋ kɩɛ Ɩsʋɔ adugbe yɩlɩ Ɩsʋɔ. Sɛ wʋ jaɩ mʋ fa wʋ kpalɛnara baa sɛ ba n mʋ fa bakpa baa. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Sɛ wʋkʋma di sɛ wʋ pawʋ. Sɛ wʋ kpalɛnara baa tɔɔsɩ ŋii ba di kakaa na gachaŋasɛ gifi ala. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Baala baa ba di adiya ŋii na nʋɔ yɩɛ kɔrʋɔsɛ sɩ nʋŋ (5,000) yela ala na bachaasɛ n kpi i.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesu pala lɩŋ dʋɔ</para>
  <para style="r">
    <ref loc="MRK 6:45-52">Maakɩ 6:45-52</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Sɛ Yesu yela sɛ wʋ kpalɛnara baa jʋʋ buori naŋ pala wʋ asanaŋ ju lɩɩ gatɩɛsa. Sɛ wʋ dʋɔ wʋrʋgbɩɛ tii jama baa gbɩɛ. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Gʋ wʋ tii ba gbɩɛ taŋ na, sɛ wʋ ju bʋrɔŋ dʋɔ wʋ nyiŋeŋ na wʋ a ga jɔ dɩga. Gʋ dɩ tala bʋyanɔ na, wʋ wɩɛ dɩmaŋ wʋ nyiŋeŋ. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Dɩmʋŋ saŋa gana na, buori gaa tala lɩɩ gaa tɩtɩba, sɛ feliŋ janɛ na apaa jɔ sɛ dɩ cheŋkpeŋ buori gaa.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Aja yɩɛ Tafɩlɛ karafɩɛ anara saŋa na sɛ Yesu pala lɩŋ ŋii dʋɔ wʋ a kɔŋ ba jaŋ. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Gʋ wʋ kpalɛnara baa na ɩ wʋ pala lɩŋ ŋii dʋɔ wʋ a kɔnɛ na, nyɩŋtɩɛ chaŋ ba, sɛ ba kuusi nyɩŋtɩɛ naŋ tawɩ sɛ, &lt;&lt;Gɩtatɩrɛ bɛ.&gt;&gt; <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Gabʋanaŋ sɛ Yesu tawɩ ba sɛ, &lt;&lt;N yu digela. Maŋ bɛ. N baa yɩɛ nyɩŋtɩɛ.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Sɛ Petero lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Kpaŋjuo, sɛ ŋɩ yɩɛ nyaŋ na, yela maa pala lɩŋ ŋii dʋɔ kɔŋ n jaŋ.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Kɔŋ.&gt;&gt; Sɛ Petero tibi lɩɩ buori gaa naŋ pala lɩŋ ŋii dʋɔ wʋ a ju Yesu jaŋ.<verse eid="MAT 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 14:30" />Ama gʋ wʋ na feliŋ janɛ a jɔ na, nyɩŋtɩɛ chaŋ ɩ, sɛ wʋ fara wʋ a muru. Sɛ wʋ kuusi sɛ, &lt;&lt;Kpaŋjuo, mɔlɔgɩ maŋ!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Gabʋanaŋ sɛ Yesu tɩɛŋɩ wʋ pam chaŋ wʋ tɩba tawɩ ɩ sɛ, &lt;&lt;Nyaŋ, n lɩɛdi n bɔla a. Be n yɩɛ sɛ nya n lɩɛ maŋ di?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Gʋ ba jʋʋ buori gaa naŋ na sɛ feliŋ janɛ ŋii yeli. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Sɛ wʋ kpalɛnara baa ba wɩɛ buori gaa naŋ na luuŋ tʋŋ ɩ tawɩ sɛ, &lt;&lt;Gasiŋteŋ, nya yɩɛ Ɩsʋɔ Bu wʋŋ bɛ.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="s1">Yesu chɔ lʋmɩɛtina Jenesareti tibi dʋɔ</para>
  <para style="r">
    <ref loc="MRK 6:46-47">Maakɩ 6:46-47</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Sɛ Yesu na wʋ kpalɛnara baa tɩɛsɛ lɩɩ kɔŋ Jenesareti tibi dʋɔ. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Gʋ dɩɛ gana bakpa jiŋ Yesu na, ba kpiri tawɩ dɩɛsɛ ŋii ŋɩ logo tibi gaa dʋɔ na kpiniŋ. Sɛ bakpa mʋ ba lʋmɩɛtina kpiniŋ kɔŋ wʋ jaŋ <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />gaa sʋlʋ ɩ sɛ wʋ n yela na lʋmɩɛtina a mʋ ba pamɩɛ tapʋ wʋ adugbe gagba nʋɔ. Sɛ baa ba tapʋ ɩ na kpiniŋ yu lʋm chʋɔ.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Duluŋ akalaasa</para>
  <para style="r">
    <ref loc="MRK 7:1-13">Maakɩ 7:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Farasitina na mbara bakalaasa baa barɛ lɩɩ Yerusalem kɔŋ gaa tasɛ Yesu sɛ, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />Be n yɩɛ sɛ n kpalɛnara baa baa kpaŋ daa duluŋ ayɩɛsa dʋɔ? Akala takɩɛ baa saŋ ba pamɩɛ pɔɩ na baa di i.<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ amɩɛ duluŋ ayɩɛsa dʋɔ ɩɩ kpaŋ Ɩsʋɔ mbara dʋɔ? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Akala takɩɛ Ɩsʋɔ tawɩ Mosesi mbara wɩɛ ŋii naŋ sɛ bu njuo na nnaa<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Ɛsa 20:12</ref>; <ref loc="DEU 5:6">Ditiro 5:6</ref>.</char></note> na wʋkʋma wʋŋ wʋ a tawɩ wɩɛ baŋ wʋjuo yaa wʋnaa na, ŋɩ tiri gʋ ba n kʋ ɩ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="LEV 20:9">Lɛf 20:9</ref>.</char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ama amɩɛ bɩrɛ ɩ kalaa sɛ wʋkʋma wʋŋ wʋ tawɩ wʋjuo yaa wʋnaa sɛ, &lt;&lt;Chɔna kʋma ŋii nyaa yu lɩɩ ma jaŋ na yɩɛ gafaasa fa Ɩsʋɔ. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Ɩ tawɩ sɛ ŋɩ n ti daga wʋ a bu wʋjuo<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">Sabɩɛwɩɛ ŋii ŋarɛ wɩɛna wʋjuo yaa wʋnaa</char></note> na wʋ a kɩɛ wʋ dʋɔ ɔ. Dɩ kɔŋ dɩmʋŋ na amɩɛ duluŋ ayɩɛsa dʋɔ, ɩɩ kpaŋ Ɩsʋɔ mbara ŋii dʋɔ ɔ. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Amɩɛ aluguusitina! Amɩɛ wʋsɛ dʋɔ wɩɛ ŋii Ɩsʋɔ ɔja Yisaya cha gbalɛ na yɩɛ gasiŋteŋ&gt;&gt; bɛ sɛ,<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;&lt;&lt;Bakpa bana, ba nʋɔ naŋ sɛ baa bu maŋ,</para>
  <para style="q2" vid="MAT 15:8">ama ŋɩ n lɩɩ ba agela naŋ ŋ.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Baa tʋm maŋ kpakpuo bɛ,</para>
  <para style="q2" vid="MAT 15:9">wʋkpa mbara sɛ baa kalaa.&gt;<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Yis 29:13</ref>.</char></note>&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s1">Bʋrʋ gaa gaa yela sɛ wʋkpa wʋsɛ a yɩɛ iniesi</para>
  <para style="r">
    <ref loc="MRK 7:14-23">Maakɩ 7:14-23</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesu yagɛ jama baa kɔŋ wʋ jaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;N nyii ma jaŋ na ɩ nyii tie <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />naa bʋrʋ gaa gaa jʋʋ wʋkpa nʋɔ naŋ na aaŋ yela sɛ wʋ wʋsɛ a yɩɛ iniesi i. Ama bʋrʋ gaa gaa lɩɩ wʋ nʋɔ naŋ na aaŋ dɩlɛ yela na wʋ wʋsɛ a yɩɛ iniesi.&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Sɛ wʋ kpalɛnara baa kɔŋ wʋ jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;N jiŋ gʋ Farasitina baa nyii dɩmʋŋ wɩɛ ŋina na ba kara biŋbira?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Daŋ kʋma gaa naa Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe n duu ga na, wʋ a kuli ga tʋsʋ. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />N baa nyala amɩɛ wʋsɛ ba dʋɔ, ba kɩɛna bɛ takɩɛ bataŋpʋna baa baa pala bataŋpʋna asanaŋ na. Ɔtaŋpʋ pala ɔtaŋpʋ asanaŋ na, baa bala baa sala dɩchabʋɔ naŋ.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Sɛ Petero tawɩ ɩ sɛ, &lt;&lt;Lɩsɛ diduu gaa tie kalaa daa.&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Sɛ Yesu tasɛ ba sɛ &lt;&lt;Amɩɛ gba ɩŋ nyii tie? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ɩ ba jiŋ gʋ bʋrʋ gaa ga jʋʋ wʋkpa nʋɔ naŋ na, gaa jʋʋ wʋ lori naŋ bɛ na gaa lɩɩ wʋ wʋsɛ naŋ? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ama wɩɛ ŋii ŋii lɩɩ wʋkpa nʋɔ naŋ na lɩɩ wʋ digela naŋ bɛ, ŋina aaŋ yela sɛ wʋkpa wʋsɛ a yɩɛ iniesi. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Akala takɩɛ wʋkpa digela naŋ sɛ nfɩɛrɛ asʋbʋɛ, gatagapʋ, alʋ wʋrʋgbɩɛ lɩɩ yaa baalɛ wʋrʋgbɩɛ lɩɩ, danaŋburidi, ŋmɩɛlɩŋ, akarɩɛ sariya na yɩrɛ warɩɛwʋ kpiniŋ a lɩɩ. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ŋina aaŋ yela sɛ wʋkpa wʋsɛ a yɩɛ iniesi, ama wʋkpa n saŋ wʋ pamɩɛ sɛ wʋ mʋ di adiya baa dɩlɛ yela na wʋ wʋsɛ a yɩɛ iniesi i.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s1">Kanani alʋ wʋrʋ lɩɛdi</para>
  <para style="r">
    <ref loc="MRK 7:24-30">Maakɩ 7:24-30</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Sɛ Yesu lɩɩ dɩmaŋ ju Tirosi na Sidoŋ tibi dʋɔ. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Sɛ Kanani alʋ wʋrʋ wʋŋ wʋ lɩɩ tibi gaa dʋɔ na kɔŋ wʋ jaŋ wʋ a kuusi sɛ, &lt;&lt;Kpaŋjuo, Juo Dawidi ganana bie, wɩɩ ma gɩyɔŋ! Feliŋ sʋbʋ chaɩ mabu galibie tɩba wʋ a nyala ɩ.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Ama Yesu n lɩsɛ ɩ nʋɔ ɔ. Dɩmʋŋ dʋɔ wʋ kpalɛnara baa kɔŋ wʋ jaŋ gaa sʋlʋ ɩ sɛ, &lt;&lt;Lɩsɛ ɩ gbɩɛ akala takɩɛ wʋ kpamɩna daa wʋ a kuusi.&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Isiralitina baa ba kɩɛna takɩɛ feŋ baa ba tʋsʋ na jaŋ sɛ Ɩsʋɔ kpiri maŋ.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Sɛ alʋ wʋŋ kɔŋ gaa luuŋ wʋ asanaŋ sʋlʋ ɩ sɛ, &lt;&lt;Kpaŋjuo, chɔna maŋ!&gt;&gt;<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Dɩ n daga na baa mʋ bachaasɛ adiya fa paasɛ ɛ.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Sɛ alʋ wʋŋ tawɩ ɩ sɛ, &lt;&lt;Kpaŋjuo, yɩɛ gasiŋteŋ bɩrɛ, ama paasɛ gba a di ajarɩɛ bisi ŋii ŋɩ lɩɩ sala ba kpaŋjuo aba tebulu tie na.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Alʋ, n lɩɛdi bɔlɩɛɩ! N tasɛ n kɔŋ tɩba fa nyaŋ.&gt;&gt; Gabʋanaŋ sɛ wʋ bu galibie wʋŋ yu lʋm chʋɔ.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu chɔ bakpa fɔɩ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Sɛ Yesu lɩɩ dɩmaŋ ju wʋ dɔŋ Galaliya lɩɩ nʋɔ. Sɛ wʋ jiŋ bʋrɔŋ garɛ ga cha. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Sɛ jama baa mʋ baa ba jaɩ-jaɩ, bataŋpʋna, buobi aba, anamu na lʋmɩɛtina fɔɩ baa ba kakaa na kɔŋ wʋ jaŋ gaa sii wʋ asanaŋ sɛ wʋ n chɔ ba. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Gʋ bakpa baa na gʋ anamu a tawɩ, buobi aba yu alaŋfiya, baa ba jaɩ-jaɩ na palɛ sɛ bataŋpʋna asa fulu na, dɩ yɩɛ ba doba. Sɛ ba kalɩɛ Isiralitina Ɩsʋɔ.<verse eid="MAT 15:31" /></para>
  <para style="s1">Yesu fa bakpa kɔrʋɔsɛ sɩ nara (4,000) adiya</para>
  <para style="r">
    <ref loc="MRK 8:1-10">Maakɩ 8:1-10</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Sɛ Yesu yagɛ wʋ kpalɛnara baa kɔŋ wʋ jaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;Bakpa bana wɩɛ wɩɛ maŋ gɩyɔŋ, akala takɩɛ wɩɛ atoro mɩnaŋ gʋ ba wɩɛ ma jaŋ, sɛ ba n yu bʋrʋ di i. Maa ja sɛ maa tii ba gbɩɛ na dusoŋ ŋ, naa dɩmʋŋ na baa lɩɩ sala gbɩɛ naŋ.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Sɛ wʋ kpalɛnara baa tasɛ ɩ sɛ, &lt;&lt;Le sɛ dɩɩ yu adiya ifuli ŋina dʋɔ fa jama bana?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Bodobodo aŋmaŋ sɛ ɩ wɩɛna?&gt;&gt; Sɛ ba lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Lɩkaarɛ na gajibisi pii barɛ.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Sɛ Yesu tawɩ jama baa sɛ n cha tibi naŋ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Sɛ wʋ mʋ bodobodo lɩkaarɛ ŋii na aji baa, gʋ wʋ yɩlɩ Ɩsʋɔ taŋ na, wʋ jaɩ tɩba mʋ fa wʋ kpalɛnara baa sɛ ba mʋ fa bakpa baa. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Bakpa baa kpiniŋ di sɛ ba pawʋ sɛ wʋ kpalɛnara baa kui ŋii ba di kakaa na gachaŋasɛ lɩkaarɛ. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Bakpa baa ba di adiya ŋii na tɩba baala nʋɔ yɩɛ kɔrʋɔsɛ sɩ nara (4,000). Ala na bachaasɛ n kpi i. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Gʋ Yesu tii jama baa gbɩɛ taŋ na, wʋ jʋʋ buori naŋ tɩɛsɛ ju Magadaŋ tibi dʋɔ.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Farasitina na Sadukitina aja adaŋgana baa na</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Sɛ Farasitina na Sadukitina barɛ kɔŋ Yesu jaŋ na baa gaa yɩɛ ɩ lɔ tɩba, dɩmʋŋ dʋɔ ba tawɩ ɩ sɛ wʋ n yela na adaŋgana a lɩɩ Ɩsʋɔ adugbe kɔŋ.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Dɩ tala bʋyanɔ na, ɩ tawɩ sɛ, &lt;Duoni tanɩɛ aja yɩɛ dieli akala takɩɛ duoni tanɩɛ chɩbɛ,&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />sɛ nafo dʋɔ, ɩ tawɩ sɛ, &lt;Jaŋ duoni aja nɩɛ, akala takɩɛ duoni cha sɛ duoni tanɩɛ biri.&gt;Ɩ dɩlɛ ɩ kɩɛ Ɩsʋɔ tanɛ naŋ na ɩ kalaa ŋii ŋii kɔŋ tibi na, ama daasɛ ŋii ŋii tibi saŋa gana na, ɩɩ nyii tie e. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Amɩɛ nyinaŋ doŋ gɩnanaŋ sɛ ɩ yɩɛ gɩ baa di gasiŋteŋ fa Ɩsʋɔ, ɩ aja adaŋgana na ɩ na. Ama ɩɩ na ŋarɛ ɛ, amʋɔ ŋii ŋɩ tibi Yona dʋɔ na.&gt;&gt; Sɛ Yesu yela ba sɛ wʋ lam.<verse eid="MAT 16:4" /></para>
  <para style="s1">Farasitina na Sadukitina yiisi dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 8:14-21">Maakɩ 8:14-21</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Gʋ wʋ kpalɛnara baa tɩɛsɛ lɩɩ gaa ju gatɩɛsa na, dɩmaŋ sɛ ba nyiŋi gʋ ba n mʋ bodobodo o, <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu tawɩ ba sɛ, &lt;&lt;N kɩɛ amɩɛ wʋsɛ dʋɔ na dieli lɩɩ Farasitina na Sadukitina yiisi<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">Yiisi yɩɛ tii bɛ sɛ ba mʋ dʋ bodobodo mʋlʋŋ na sɛ ŋii yɩɛ gafʋʋ</char></note> dʋɔ.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Sɛ wʋ kpalɛnara baa tawɩ ba nyiŋeŋ-nyiŋeŋ sɛ, &lt;&lt;Bodobodo gaa dɩ n mʋ na dʋɔ sɛ wʋ tawɩ dɩmʋŋ.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Gʋ Yesu jiŋ wɩɛ ŋii baa tawɩ na, wʋ tasɛ ba sɛ, &lt;&lt;Amɩɛ baa amɩɛ lɩɛdi n bɔla a, be n yɩɛ sɛ ɩ tawɩ amɩɛ nyiŋeŋ-nyiŋeŋ sɛ dɩ tana bodobodo? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ɩ saŋ ɩŋ nyii ta tie? Ɩ nyiŋi bodobodo anʋŋ ŋii ma jaɩ fa bakpa kɔrʋɔsɛ sɩ nʋŋ (5,000) sɛ ba di kakaa na, gachaŋasɛ aŋmaŋ sɛ ɩ kuiwu? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Yaa bodobodo lɩkaarɛ ŋii ma jaɩ fa bakpa kɔrʋɔsɛ sɩ nara (4,000) sɛ ba di kakaa na, gachaŋasɛ aŋmaŋ sɛ ɩ kuiwu? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Be n yɩɛ sɛ ɩɩ nyii tie sɛ naa bodobodo wɩɛ sɛ maa tawɩ maa fa amɩɛ? Ama n kɩɛ amɩɛ wʋsɛ dʋɔ na dieli lɩɩ Farasitina na Sadukitina yiisi dʋɔ.&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Dɩmaŋ sɛ wʋ kpalɛnara baa nyii tie gʋ naa yiisi ŋii baa mʋ baa dʋ bodobodo tɩba na wɩɛ sɛ wʋ a tawɩ sɛ ba n kɩɛ ba wʋsɛ dʋɔ na dieli i, ama Farasitina na Sadukitina kalaa wɩɛ sɛ wʋ dʋɔna.<verse eid="MAT 16:12" /></para>
  <para style="s1">Petero kalaa wʋkpa wʋŋ Yesu yɩɛ</para>
  <para style="r">
    <ref loc="MRK 8:27-30">Maakɩ 8:27-30</ref>; <ref loc="LUK 9:18-21">Luka 9:18-21</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Gʋ Yesu ju Kayisariya Filipi tibi dʋɔ na, wʋ tasɛ wʋ kpalɛnara baa sɛ, &lt;&lt;Mmʋɔ sɛ bakpa a tawɩ sɛ Wʋkpa Bu wʋŋ yɩɛ?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Ba lɩsɛ nʋɔ sɛ, &lt;&lt;Barɛ sɛ Yohane Ɩsʋɔ Sɔrɛ, barɛ sɛ Ɩsʋɔ ɔja Eliya, sɛ barɛ dʋɔ sɛ Ɩsʋɔ ɔja Yeremiya yaa Ɩsʋɔ bajana baa tɩba wʋrʋ bɛ.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Amɩɛ dʋɔ, Mmʋɔ sɛ ɩ sɛ ma yɩɛ?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Sɛ Simoŋ Petero lɩsɛ nʋɔ sɛ, &lt;&lt;Nyaŋ n nyina Kirisito,<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Girikitina a yagɛ Kirisito sɛ Yudatina a yagɛ Mesaya</char></note> Ɩsʋɔ wʋkɩɛnasa wʋŋ Bu.&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Nyaŋ Simoŋ, Yona bu, kusee n nyina nyaŋ, akala takɩɛ naa wʋkpa n lɩsɛ wɩɛ ŋina kalaa nyaŋ ŋ, ama Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Maŋ bɩrɛ, maa tawɩ nyaŋ sɛ nyaŋ n nyina Petero<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Petero tie a kalaa sɛ dɩkpa</char></note>, nyaŋ dɩkpa gana dʋɔ sɛ maa ma Kirisito lɩɛdɩra dikpeŋ jaga dʋɔ. Sɛ sɩŋ gba baa dɩlɛ di ga dʋɔ ɔ. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Maa mʋ Ɩsʋɔ Juori gaa safiwu aba fa nyaŋ. Wɩɛ kʋma ŋii nya pɔgʋ ŋɛ tibi dʋɔ na, baa pɔgʋ ŋɛ Ɩsʋɔ adugbe. Sɛ wɩɛ kʋmʋ ŋii nya buoli ŋɛ tibi dʋɔ na, baa buoli ŋɛ Ɩsʋɔ adugbe.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Sɛ Yesu jɔ wʋ kpalɛnara baa nyienaŋ sɛ ba n baa tawɩ wʋrʋ sɛ wʋŋ n nyina Kirisito wʋŋ.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu tawɩ wʋ awʋrʋfʋɔ na wʋ sɩŋ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 8:31">Maakɩ 8:31</ref>; <ref loc="MRK 9:1">9:1</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Lɩɩ dɩmʋŋ saŋa gana mʋ a ju na, Yesu fara wʋ a tawɩ wʋ kpalɛnara baa sɛ ŋɩ tiri gʋ wʋ a ju Yerusalem na wʋ a na awʋrʋfʋɔ fɔɩ dɩɛ bɩnɩɛ, Ɩsʋɔ sei bɩnɩɛ na mbara bakalaasa pamɩɛ naŋ na baa kʋ ɩ, ama wɩɛ atoro wɩɩ na, wʋ a feŋ lɩɩ sɩŋ naŋ.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Sɛ Petero yagɛ Yesu lɩɩ laraŋ sɛ wʋ tawɩ baŋ ɩ sɛ, &lt;&lt;Kpaŋjuo, Ɩsʋɔ n mʋ ju taŋasɛ! Ŋina baa tibi n dʋɔ ɔ.&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Sɛ Yesu biliŋi kɩɛ Petero sɛ wʋ tawɩ ɩ sɛ, &lt;&lt;Lɩɩ ma dʋɔ Sɩtanɩ! Nya yɩɛ gbɩɛ garadɛ bɛ fa maŋ, akala takɩɛ wʋkpa nfɩɛrɛ sɛ nyaa faa, naa Ɩsʋɔ teri i.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Sɛ Yesu tawɩ wʋ kpalɛnara baa sɛ, &lt;&lt;Wʋkʋma wʋŋ wʋ a ja sɛ wʋ a kpaŋ maŋ na, ŋɩ tiri gʋ wʋ a yela wʋ tɩŋtɩŋ wʋ jawʋ na wʋ a mʋ wʋ daŋ gasagasa na wʋ a kpaŋ maŋ. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Akala takɩɛ wʋkʋma wʋŋ wʋ a ja sɛ wʋ a mɔlɔgɩ wʋ tɩŋtɩŋ wʋ nkpa na, ŋii jɔ ɩ. Ama wʋkʋma wʋŋ wʋ nkpa jɔ ɩ lɩɩ ma dʋɔ na, wʋ a yu nkpa ŋii ŋɩ taŋ gɩtɛ. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Wʋkpa yu dulunya abʋrɩ kpiniŋ sɛ wʋ nkpa lɩɩ wʋ pam naŋ na, be sɛ wʋ a yu? Yaa be sɛ wʋkpa a dɩlɛ mʋ chɩɛgɩna wʋ nkpa? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Wʋkpa Bu wʋŋ aja wʋ a kɔŋ Wʋ juo jilima naŋ wʋ na wʋ gabʋɔsɛ, na wʋ a gaa tɔ wʋkʋma kɩm ganaŋkʋ wʋ ayɩɛsa kɩɛna. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Maa tawɩ sɛ n nyii na dieli sɛ, amɩɛ baa ɩ wɩɛ jɩna na barɛ baa na sɩŋ ŋ ga tala gʋ baa na Wʋkpa Bu wʋŋ bɔrɛ wʋ a kɔŋ wʋ juori naŋ.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Yesu wʋsɛ gori</para>
  <para style="r">
    <ref loc="MRK 9:2-13">Maakɩ 9:2-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Wɩɛ lʋrʋ wʋrʋgbɩɛ na, Yesu mʋ Petero, Jamesi na wʋnabu Yohane sɛ wʋ na ba nyiŋeŋ ju bʋrɔŋ jalɩŋtɛ garɛ dʋɔ. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Dɩmaŋ sɛ ba na gʋ Yesu wʋsɛ gori ba asa dʋɔ. Wʋ asanaŋ ŋalagi takɩɛ wiita, sɛ wʋ abʋrɩ afuusa fʋlʋŋsɛ takɩɛ ŋmaŋi. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Kɩɛ, dɩmaŋ sɛ ba na gʋ Mosesi na Ɩsʋɔ ɔja Eliya na Yesu a tawɩ.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Sɛ Petero tawɩ Yesu sɛ, &lt;&lt;Kpaŋjuo, ŋɩ wɩɛ dieli gʋ dɩ wɩɛ jɩna. Nyaa jawʋ na, yela na maa baŋ akoneŋ atoro, n teri garɛ, Mosesi teri garɛ na Ɩsʋɔ ɔja Eliya gba teri garɛ.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Gʋ Petero saŋ wʋ a tawɩ na, Ɩsʋɔ tanɛ ga ŋalagisa gaa fu ba dʋɔ. Sɛ lofu garɛ lɩɩ Ɩsʋɔ tanɛ gaa naŋ kɔŋ sɛ, &lt;&lt;Wina n nyina Mabu wʋŋ maa ja wʋ wɩɛ. Ma asa a su wʋ dʋɔ, n nyii wʋ jaŋ.&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Gʋ wʋ kpalɛnara baa nyii ŋina na, nyɩŋtɩɛ chaŋ ba sɛ ba laŋ duo. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ama Yesu kɔŋ gaa tapʋ ba tawɩ sɛ, &lt;&lt;N kʋlʋ, n baa yela nyɩŋtɩɛ a chaŋ amɩɛ.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Gʋ ba mʋ ba nyie adugbe na, ba n na wʋrʋ ʋ, amʋɔ Yesu nyiŋeŋ.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Gʋ ba tibi bʋrɔŋ gaa baa kɔnɛ na, Yesu jɔ ba nyienaŋ sɛ, &lt;&lt;Ba n baa tawɩ ŋii ba na na fa wʋrʋ ga tala gʋ Wʋkpa Bu wʋŋ aja feŋ lɩɩ sɩŋ naŋ.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Sɛ wʋ kpalɛnara baa tasɛ ɩ sɛ, &lt;&lt;Be dʋɔ sɛ mbara bakalaasa baa tawɩ sɛ ŋɩ tiri gʋ Ɩsʋɔ ɔja Eliya n chɩŋkpɩɛ kɔŋ pɔɩ?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Yɩɛ gasiŋteŋ bɛ, ŋɩ tiri gʋ Eliya n chɩŋkpɩɛ kɔŋ na wʋ a gaa desina bʋrʋkʋma si ga gbɩɛ dʋɔ. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ama maa tawɩ amɩɛ sɛ Eliya taŋ kɔnɛ sɛ bakpa n jiŋ ɩ ɩ. Sɛ ba yɩɛ ɩ bʋrʋkʋma gaa baa jawʋ. Dɩmʋŋ sɛ Wʋkpa Bu wʋŋ gba aja na awʋrʋfʋɔ ba pamɩɛ naŋ.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Ŋina wʋrʋgbɩɛ na, wʋ kpalɛnara baa nyii tie gʋ Yohane Ɩsʋɔ Sɔrɛ wʋŋ wɩɛ sɛ wʋ a tawɩ wʋ a fa ba.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesu geŋ feliŋ sʋbʋ lɩɩ yeleŋbu wʋrʋ tɩba</para>
  <para style="r">
    <ref loc="MRK 9:14-29">Maakɩ 9:14-29</ref>; <ref loc="LUK 9:37-43">Luka 9:37-43</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Gʋ Yesu na wʋ kpalɛnara baa bɔrɛ kɔŋ jama baa jaŋ na, baalɛ wʋrʋ kɔŋ Yesu jaŋ gaa luuŋ wʋ asanaŋ <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />sɛ wʋ tawɩ sɛ, &lt;&lt;Kpaŋjuo, wɩɩ mabu baalɛ jaŋ gɩyɔŋ. Wʋ a kili dɩgbɩŋgbɩŋ sɛ wʋ a na awʋrʋfʋɔ fɔɩ. Wʋ a dɩlɛ wʋ sala bʋala naŋ yaa lɩŋ naŋ. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ma mʋ ɩ kɔna n kpalɛnara baa sɛ ba n chɔ ɩ, ama ba n dɩlɛ ɛ.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;O, amɩɛ gɩnanaŋ baa ɩɩ lɩɛ ɩ di i sɛ amɩɛ gbɩɛsɛ n chirigi i. Mʋ ga tala wɩɛ aŋmaŋ sɛ maŋ na amɩɛ dɩ n cha? Mʋ ga tala wɩɛ aŋmaŋ sɛ ma n yu digela fa amɩɛ? N mʋ yeleŋbu wʋŋ kɔna maŋ jɩna.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Sɛ Yesu fʋba feliŋ sʋbʋ wʋŋ wʋ wɩɛ yeleŋbu wʋŋ tɩba na dʋɔ sɛ wʋ lɩɩ wʋ tɩba. Gabʋanaŋ sɛ wʋ yu lʋm chʋɔ.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Wʋrʋgbɩɛ na, wʋ kpalɛnara baa kɔŋ wʋ jaŋ wʋ nyiŋeŋ gaa tasɛ ɩ sɛ, &lt;&lt;Be n yɩɛ sɛ dɩ n dɩlɛ geŋ feliŋ sʋbʋ wʋŋ lɩɩ wʋ tɩba?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Sɛ wʋ lɩsɛ ba nʋɔ sɛ, &lt;&lt;Akala takɩɛ amɩɛ lɩɛdi n bɔla a. Maa tawɩ sɛ n nyii na dieli sɛ ɩ wɩɛna lɩɛdi pii takɩɛ kpeli daŋ bi na, nafʋɔ ɩ dɩlɛ tawɩ bʋrɔŋ gana sɛ, &lt;Kuli lɩɩ jɩna ga sɩŋ dɩmaŋ&gt; na ŋii kɔŋ tɩba dɩmʋŋ. Bʋrʋ taŋ sɛ ɩɩ dɩlɛ yɩɛ ɛ. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Dɩmʋŋ feliŋ sʋbʋ wina duluŋ amʋɔ dɩga na nʋɔ pɔgʋ aaŋ dɩlɛ geŋ ɩ.&gt;&gt;<verse eid="MAT 17:21" /></para>
  <para style="s1">Yesu ti tawɩ wʋ sɩŋ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 9:30-32">Maakɩ 9:30-32</ref>; <ref loc="LUK 9:43-45">Luka 9:43-45</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Gʋ Yesu kpalɛnara baa jaŋi Galaliya tibi dʋɔ na, Yesu tawɩ ba sɛ, &lt;&lt;Baa lɩsɛ Wʋkpa Bu wʋŋ dʋ bakpa pamɩɛ naŋ <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />na baa kʋ ɩ. Ama wɩɛ atoro wɩɩ na, wʋ a feŋ lɩɩ Sɩŋ naŋ.&gt;&gt; Gʋ wʋ kpalɛnara baa nyii ŋina na, ba bɔtaa.<verse eid="MAT 17:23" /></para>
  <para style="s1">Ɩsʋɔ tʋm danɛ lampo tɔ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Gʋ Yesu na wʋ kpalɛnara baa kɔŋ Kapeniyum dɩɛ naŋ na, Ɩsʋɔ tʋm danɛ lampo lɩɛra baa kɔŋ Petero jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Amɩɛ wʋkalaasa a tɔ Ɩsʋɔ tʋm danɛ lampo?&gt;&gt;<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Sɛ Petero lɩsɛ nʋɔ sɛ, &lt;&lt;Ɛɛŋ, wʋ a tɔ.&gt;&gt;Gʋ Petero kɔŋ waa dʋɔ na, Yesu n chɩŋkpɩɛ tasɛ ɩ sɛ, &lt;&lt;Simoŋ, nya nfɩɛrɛ n nyina sɩnɛ lɩɩna wɩɛ ŋina dʋɔ? Mmʋɔ aba aaŋ tɔ lampo baa fa juoneŋ? Dɩɛsɛ bie yaa mʋɔra?&gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Sɛ Petero lɩsɛ nʋɔ sɛ, &lt;&lt;Mʋɔra.&gt;&gt; Sɛ Yesu tawɩ Petero sɛ, &lt;&lt;Dɩmʋŋ bɩrɛ dɩɛsɛ bie baa tɔ lampo o.&gt;&gt;<verse eid="MAT 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 17:27" />Ama ganaŋkʋ dɩ ɩɩ dʋ ba biŋbira na dʋɔ, ju lɩɩ gaa naŋ ga lɔ darɩwa. Diji wʋŋ nyaa chɩŋkpɩɛ chaŋ na, fulu wʋ nʋɔ nyaa na diterembi. Lɩsɛ na nyaa mʋ tɔ ba maŋ na nyaŋ lampo.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Mmʋɔ n nyina wʋjaŋ-janɛ Ɩsʋɔ Juori naŋ</para>
  <para style="r">
    <ref loc="MRK 9:33-37">Maakɩ 9:33-37</ref>; <ref loc="LUK 9:46-48">Luka 9:46-48</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Dɩmʋŋ saŋa gana na, Yesu kpalɛnara baa kɔŋ wʋ jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Mmʋɔ n nyina wʋjan-janɛ Ɩsʋɔ Juori gaa naŋ?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Sɛ Yesu yagɛ wʋchaa pii gaa sɩŋ ba asanaŋ. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ ɩŋ biliŋi amɩɛ nfɩɛrɛ na ɩ yɩɛ takɩɛ bachaasɛ bisi na, ɩɩ dɩlɛ jʋʋ Ɩsʋɔ Juori gana naŋ ŋ. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Dɩmʋŋ dʋɔ wʋkʋma wʋŋ wʋ kɔna wʋ wʋsɛ tie takɩɛ wʋchaa wina na, wʋŋ n nyina wʋjan-janɛ Ɩsʋɔ Juori gaa naŋ.&gt;&gt;<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />Wʋkʋma wʋŋ wʋ lɩɛ wʋchaa pii wina ma yɩrɛ naŋ na lɩɛ maŋ. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Ama wʋkʋma wʋŋ wʋ a yela na bachaasɛ buruburu baa ba lɩɛ maŋ di na tɩba wʋrʋ a yɩɛ dɩsʋbʋ na, ŋɩ wɩɛ dieli fa ɩ takɩɛ gʋ ba mʋ bʋɩ ganamsa janɛ pɔgʋ wʋ lafu tie, na baa lɔ ɩ dʋ ɔpʋ dɩkɩŋ diele.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Dulunya naŋ bakpa amɩɛ lakʋ akala takɩɛ bʋrʋ gaa gaa yela sɛ bakpa a yɩɛ dɩsʋbʋ na aja kɔŋ. Ama wʋŋ aja pala na wʋ dʋɔ kɔŋ na, wʋŋ lakʋ. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Sɛ n pam yaa n nafarɛ aja yela na nyaa yɩɛ dɩsʋbʋ na, kara ga tʋsʋ. Ŋɩ wɩɛ dieli fa nyaŋ takɩɛ nyaa mʋ pam garɛ yaa nafarɛ garɛ ju nkpa ŋii ŋɩ taŋ gɩtɛ naŋ kii gʋ nya mʋ pamɩɛ ala yaa nafara ala ju bʋala gaa gaa dum na naŋ. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Sɛ n dɩsɛ aja yela na nyaa yɩɛ dɩsʋbʋ na, chɔla ga tʋsʋ. Ŋɩ wɩɛ dieli fa nyaŋ takɩɛ nyaa mʋ dɩsɛ garɛ ju nkpa ŋii ŋɩ taŋ gɩtɛ na naŋ kii gʋ nyaa mʋ asa ala ju awʋrʋfʋɔ bʋala gaa gaa dum na naŋ.<verse eid="MAT 18:9" /></para>
  <para style="s1">Fie wʋ tʋsʋsa dʋɔ diduu</para>
  <para style="r">
    <ref loc="LUK 15:3-7">Luka 15:3-7</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N kɩɛ na dieli na n baa kɩɛ ba buruburu bana tɩba wʋrʋ kpakpuo. Akala takɩɛ maa tawɩ amɩɛ sɛ ba Ɩsʋɔ adugbe gabʋɔsɛ wɩɛ Majuo asanaŋ saŋa kʋma. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Wʋkpa Bu wʋŋ kɔŋ na wʋ a gaa mɔlɔgɩ baa ba tʋsʋ na bɛ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Naa Sabɩɛwɩɛ ŋii kpiniŋ n wɩɛna kparatɩba gana a</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Amɩɛ nfɩɛrɛ n nyina sɩnɛ lɩɩna wɩɛ ŋina dʋɔ? Wʋkpa wɩɛna feŋ gafie (100) sɛ ba tɩba wʋrʋ tʋsʋ na, wʋ aa yela ŋɩnara sala na saŋgʋ (99) baa si bʋrɔŋ bisi dʋɔ dɩmaŋ, na wʋ a ju ga ja wʋŋ wʋ tʋsʋ naa? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Maa tawɩ sɛ n nyii na dieli sɛ wʋ na ɩ na wʋ asa aja lɩɛ wʋ dʋɔ kii ŋɩnara sala na saŋgʋ baa ba n tʋsʋ na. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Dɩmʋŋ sɛ amɩɛ Juo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na gba baa ja ba buruburu bana tɩba wʋrʋ n tʋsʋ ʋ.&gt;&gt;<verse eid="MAT 18:14" /></para>
  <para style="s1">N dʋɔ yɩɛ nyaŋ dɩsʋbʋ na</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;N dʋɔ lɩɛdɩrɛ yɩɛ nyaŋ dɩsʋbʋ na, ju wʋ jaŋ ga tawɩ ɩ wʋ dɩsʋbʋ nyaŋ na ɩ bala. Wʋ nyii wʋ dɩsʋbʋ tie na, na ɩ ti yɩɛ dɔŋa lɩɛdɩra. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ama sɛ wʋ n nyii wʋ dɩsʋbʋ tie na, mʋ wʋkpa wʋrʋ yaa bakpa bala kpi n wʋsɛ dʋɔ ju wʋ jaŋ ganaŋkʋ aja yɩɛ na Sabɩɛwɩɛ ŋii ŋɩ tawɩ sɛ, &lt;Wɩɛ kʋma ŋii baa mʋ pʋɩ wʋrʋ na aja tiri (seriyatina bala yaa batoro) bakpa bala yaa batoro seriya.&gt;<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Ditiro 19:15</ref>.</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Sɛ wʋ pɩɛ wʋ n nyii ba jaŋ na, n tawɩ Kirisito lɩɛdɩra dikpeŋ asanaŋ, sɛ wʋ n nyii ba jaŋ na, mʋ ɩ takɩɛ wʋ yɩɛ wʋŋ wʋ ba jiŋ Ɩsʋɔ na yaa lampo lɩɛrɛ.&gt;&gt;<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ wɩɛ kʋma ŋii ɩ pɔgʋ ŋɛ tibi dʋɔ na, baa pɔgʋ ŋɛ Ɩsʋɔ adugbe. Sɛ wɩɛ kʋma ŋii ɩ pɩɛ ŋɛ tibi dʋɔ na, baa pɩɛ ŋɛ Ɩsʋɔ adugbe.&gt;&gt;<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Ma ti bɔrɛ maa tawɩ amɩɛ sɛ bakpa bala tawɩ kpa sɛ ba jɔ dɩga tasɛ bʋrʋ garɛ na, Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na aja yɩɛ fa ba. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Akala takɩɛ diele gaa bakpa bala yaa batoro jaŋi ma yɩrɛ naŋ na, ma kpi ba dʋɔ.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s1">Tʋmɩrɛ nyinaŋ doŋ-tɛ wʋrʋ dʋɔ diduu</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Sɛ Petero kɔŋ Yesu jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Kpaŋjuo, ma dʋɔ yɩɛ maŋ dɩsʋbʋ na, gbɩɛta bʋŋmaŋ sɛ ma n mʋ chɩɛ ɩ? Gbɩɛta lɩkaarɛ?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Maa tawɩ amɩɛ sɛ, naa gbɩɛta lɩkaarɛ ɛ, ama gbɩɛta ŋitoro sala na lɩkaarɛ.&gt;&gt;<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;Dɩmʋŋ dʋɔ Ɩsʋɔ Juori gaa kɩɛna bɛ takɩɛ Juo wʋrʋ wʋŋ wʋ yagɛ wʋ tʋmɩra sɛ ba n gaa kalaa ɩ wʋ aterembie nʋɔ. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Gʋ wʋ fara wʋ a yɩɛ ŋina na, ba mʋ baalɛ wʋrʋ wʋŋ wʋ chamɩna ɩ kɩm diterembi talɛntɩ kɔrʋɔsɛ gifi na kɔna ɩ. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Gʋ wʋ n dɩlɛ tɔ kɩm gaa na dʋɔ, wʋ kpaŋjuo wʋŋ dʋ sɛ ba n yaa ɩ, wʋ alʋ, wʋ bie na bʋrʋkʋma gaa wʋ wɩɛna na, na baa mʋ gaa tɔ kɩm gaa.&gt;&gt;<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />Sɛ tʋmɩrɛ wʋŋ luuŋ wʋ dʋna dʋɔ wʋ kpaŋjuo asanaŋ sʋlʋ ɩ sɛ, &lt;&lt;Yu digela fa maŋ, maa tɔ nyaŋ kɩm gaa kpiniŋ.&gt;&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Sɛ wʋ kpaŋjuo wʋŋ wɩɩ wʋ gɩyɔŋ, sɛ wʋ mʋ kɩm gaa chɩɛ ɩ sɛ wʋ yela sɛ wʋ lam.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Gʋ tʋmɩrɛ wʋŋ a ju na, wʋ ga na wʋ dʋɔ tʋmɩrɛ wʋrʋ wʋ chamɩna ɩ kɩm aterembie dinari<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="ft" closed="false">Dinari gafie yɩɛ dɩtʋm yɩɛrɛ wiitabi kɩmtʋɔ bɛ</char></note> gafie. Sɛ wʋ chaŋ wʋ lofu tie tawɩ ɩ sɛ tɔ maŋ kɩm gaa n chamɩna maŋ na.&gt;&gt;<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Wʋ dʋɔ tʋmɩrɛ wʋŋ luuŋ wʋ dʋna dʋɔ wʋ asanaŋ sʋlʋ ɩ sɛ, yu digela fa maŋ maa tɔ nyaŋ kɩm gaa kpiniŋ.&gt;&gt;<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Ama wʋŋ bɩrɛ wʋ pɩɛ, sɛ wʋ mʋ ɩ ga tɔ danɛ dɩtʋɔtɩŋ ga tala saŋa gaa wʋ a gaa tɔ kɩm gaa.&gt;&gt; <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Gʋ tʋmɩra ba baŋbaŋ baa na ŋii ŋɩ tibi na, ba asa n lɩɛ ɛ sɛ ba ju ga tawɩ ŋii ŋɩ tibi na kpiniŋ fa ba kpaŋjuo wʋŋ.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />Sɛ kpaŋjuo wʋŋ yagɛ tʋmɩrɛ wʋŋ tawɩ ɩ sɛ, &lt;&lt;Nyaŋ tʋmɩrɛ nyinaŋ doŋ-tɛ, nya sʋlʋ maŋ dʋɔ ma mʋ n kɩm kpiniŋ chɩɛ nyaŋ. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Be dʋɔ sɛ nya n dɩlɛ wɩɩ n dʋɔ gɩyɔŋ takɩɛ ganaŋkʋ ma wɩɩ n gɩyɔŋ naa?&gt;&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Sɛ wʋ kpaŋjuo wʋŋ kara biŋbira sɛ wʋ tawɩ fa danɛ tʋɔra sɛ ba n nyala ɩ ga tala gʋ wʋ a tɔ kɩm gaa kpiniŋ.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;N na sɛ Majuo wʋŋ wʋ wɩɛ Ɩsʋɔ adugbe na aja yɩɛ amɩɛ wʋkʋma wʋŋ wʋ n lɩɩ wʋ digela naŋ mʋ wʋ dʋɔ dɩsʋbʋ chɩɛ ɩ na.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Yesu kalaa sarɛ yela dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 10:1-12">Maakɩ 10:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Gʋ Yesu tawɩ wɩɛ ŋina taŋ na, wʋ lɩɩ Galaliya tibi dʋɔ tɩɛsɛ Yodaŋ buo ju Yudiya tibi dʋɔ Yodaŋ gatɩɛsa. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Jama baa kpaŋ ɩ, sɛ wʋ chɔ ba lʋmɩɛ dɩmaŋ.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Sɛ Farasitina barɛ kɔŋ wʋ jaŋ gaa yɩɛ lɔ tɩba, dɩmʋŋ dʋɔ ba tasɛ ɩ sɛ, &lt;&lt;Daa mbara fa gbɩɛ sɛ baalɛ a dɩlɛ sɩŋ wɩɛ kʋma dʋɔ yela wʋ alʋ?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Ɩŋ karaŋ Ɩsʋɔ Wɩɛ naŋ, lɩɩ dulunya dɩfaratɩŋ sɛ Ɩsʋɔ lɔ ba baalɛ na alʋ,&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Jene 1:27</ref>.</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />sɛ Ɩsʋɔ tawɩ sɛ, &lt;&lt;Ŋina dʋɔ, baalɛ aja yela wʋjuo na wʋnaa na wʋ na wʋ alʋ baa ga cha bʋga, na baa bala baa yɩɛ wʋsɛ tanɛ gadʋŋdʋlʋŋ. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Dɩmʋŋ dʋɔ ba ba ti yɩɛ bakpa bala a, ama wʋdʋŋdʋlʋŋ. Ŋina dʋɔ, ŋii Ɩsʋɔ bʋga na, wʋrʋ n baa kpara tɩba.&gt;&gt;<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Sɛ Farasitina baa tasɛ ɩ sɛ, &lt;&lt;Be dʋɔ sɛ Mosesi dʋ sɛ baalɛ n sabɩɛ tanɛ fa wʋ alʋ na gaa kalaa gʋ wʋ yela ɩ sarɛ pɔɩ na wʋ a yela ɩ?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Amɩɛ agela doŋ dʋɔ sɛ Mosesi fa amɩɛ gbɩɛ sɛ n yela amɩɛ ala. Ama lɩɩ dulunya dɩfaratɩŋ na, ŋɩ ba yɩɛ dɩmʋŋ ŋ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Maa tawɩ amɩɛ sɛ baalɛ kʋma wʋŋ wʋ yela wʋ alʋ sɛ ŋɩ ba yɩɛ baalɛ wʋrʋgbɩɛ lɩɩ, sɛ wʋ saa alʋ fɔlɛ na yɩɛ alʋ wʋrʋgbɩɛ lɩɩ.&gt;&gt;<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Sɛ wʋ kpalɛnara baa tawɩ ɩ sɛ, &lt;&lt;Sɛ dɩmʋŋ sɛ kɩɛna baalɛ na wʋ alʋ tɩtɩba bɩrɛ, wʋkpa n saa na ŋɩ bɔ.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Naa wʋkʋma aaŋ dɩlɛ lɩɛ dɩmʋŋ wɩɛ ŋina dʋ ʋ, amʋɔ baa Ɩsʋɔ yela sɛ ba nyii ŋɩ tie na nyiŋeŋ. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Baala barɛ wɩɛ baa dɩlɛ saa a, akala takɩɛ dɩmʋŋ sɛ ba lʋrʋ ba. Sɛ barɛ dʋɔ bakpa n yɩɛ ba dɩmʋŋ, barɛ dʋɔ Ɩsʋɔ Juori gaa dʋɔ sɛ baa ja baa saa a. Wʋŋ wʋ a dɩlɛ lɩɛ dɩmʋŋ wɩɛ ŋina na, wʋ n lɩɛ dʋ.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s1">Yesu yɩɛ bachaasɛ bisi kusee</para>
  <para style="r">
    <ref loc="LUK 18:15-17">Luka 18:15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Bakpa barɛ mʋ bachaasɛ bisi kɔna Yesu sɛ wʋ n mʋ wʋ pam jaga ba dʋɔ na wʋ a jɔ dɩga fa ba. Ama wʋ kpalɛnara baa gɩŋ ba.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N yela na bachaasɛ bisi a kɔŋ ma jaŋ, ama n baa gaa ba gbɩɛ. Akala takɩɛ Ɩsʋɔ Juori gaa yɩɛ baa ba kɩɛna dɩmʋŋ na teri bɛ.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Gʋ Yesu mʋ wʋ pam jaga-jaga bachaasɛ bisi baa dʋɔ garɛ-garɛ taŋ na, wʋ lɩɩ dɩmaŋ laŋ.<verse eid="MAT 19:15" /></para>
  <para style="s1">Yeleŋbu akpaŋtatɛ wʋrʋ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 10:17-31">Maakɩ 10:17-31</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Sɛ baalɛ wʋrʋ kɔŋ Yesu jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Wʋkalaasa, bʋrʋ bam gamʋɔ sɛ ŋɩ tiri gʋ ma n yɩɛ na maa yu nkpa ŋii ŋɩ taŋ gɩtɛ?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Be n yɩɛ sɛ nyaa tasɛ maŋ dɩbam wɩɛ? Wʋdʋŋdʋlʋŋ n nyina wʋbam. Nyaa ja nyaa yu nkpa ŋii ŋɩ taŋ gɩtɛ na, kpaŋ mbara ŋii dʋɔ.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Sɛ baalɛ wʋŋ tasɛ ɩ sɛ, &lt;&lt;&lt;Mbara amʋɔ? Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ n baa tagapʋ, n baa yɩɛ baalɛ wʋrʋgbɩɛ lɩɩ yaa alʋ wʋrʋgbɩɛ lɩɩ, n baa ŋmɩɛlɛ, n baa di akarɩɛ seriya, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />bu njuo na nnaa<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Ɛsa 20:12-16</ref>; <ref loc="DEU 5:16-20">Ditiro 5:16-20</ref>.</char></note> na nyaa ja n dʋɔ takɩɛ n wʋsɛ.&gt;<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lɛf 19:18</ref>.</char></note>&gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Sɛ yeleŋbu wʋŋ tawɩ Yesu sɛ, &lt;&lt;Ma kpaŋ mbara ŋina kpiniŋ dʋɔ. Be n ka sɛ ma n yɩɛ?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Nyaa ja sɛ nyaa yɩɛ kʋrʋkʋrʋ na, ju ga yaa nya akpaŋta na nyaa mʋ aterembie ŋii ga fa ayɔŋtina, na nyaa yu akpaŋta Ɩsʋɔ adugbe. Na nyaa gaa kpaŋ maŋ.&gt;&gt;<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Ama yeleŋbu wʋŋ nyii wɩɛ ŋina na, dɩ n yɩɛ ɩ jʋŋ ŋ sɛ wʋ lam, akala takɩɛ wʋ wɩɛna akpaŋta fɔɩ.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Sɛ Yesu tawɩ wʋ kpalɛnara baa sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ aja yɩɛ doŋ fa akpaŋtatɛ na wʋ a jʋʋ Ɩsʋɔ Juori gaa naŋ. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ma ti maa tawɩ amɩɛ sɛ aja fʋ fa nyɔma na wʋ a mʋna dɩkparɛ bʋɔ naŋ, ama aja yɩɛ wiliŋ fa akpaŋtatɛ na wʋ a jʋʋ Ɩsʋɔ Juori gaa naŋ.&gt;&gt;<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Gʋ Yesu kpalɛnara baa nyii wɩɛ ŋina na, dɩ yɩɛ ba doba ga laŋ. Sɛ ba tasɛ ɩ sɛ, &lt;&lt;Dɩmʋŋ bɩrɛ Mmʋɔ sɛ baa mɔlɔgɩ?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Sɛ Yesu kɩɛ ba sɛ wʋ tawɩ sɛ, &lt;&lt;Wʋkpa jaŋ bɩrɛ, ŋina baa dɩlɛ yɩɛ ɛ, ama Ɩsʋɔ bɩrɛ, wʋ a dɩlɛ yɩɛ bʋrʋkʋma.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Sɛ Petero tasɛ Yesu sɛ, &lt;&lt;Kɩɛ! Dɩ yela bʋrʋkʋma gaa kpaŋ nyaŋ.&gt;&gt; Be sɛ dɩɩ yu?<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ dulunya gafɔlɛ gaa gaa kɔŋ gʋ Wʋkpa Bu wʋŋ aja wʋ a cha wʋ jilima Juorigbeli gaa dʋɔ na, amɩɛ baa ɩ kpaŋ maŋ na gba aja cha juorigbeliŋ gifi ala ŋii dʋɔ di Isirali buonɔsɛ gifi ala ŋii dʋɔ. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Wʋkʋma wʋŋ wʋ a yela waasɛ yaa nabie yaa diesina yaa juo yaa naa, yaa bie yaa fʋɔsɛ ma dʋɔ na, aja yu ŋɛ gbɩɛta gafie dʋɔ fɔɩ na wʋ a ti yu nkpa ŋii ŋɩ taŋ gɩtɛ. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ama fɔɩ baa ba yɩɛ asanaŋtina na aja yɩɛ wʋrʋgbɩɛtina na fɔɩ baa ba yɩɛ wʋrʋgbɩɛtina na a yɩɛ asanaŋtina.&gt;&gt;<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Fʋɔnaŋ dɩtʋm yɩɛra</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Ɩsʋɔ juori gaa kɩɛna bɛ takɩɛ gʋ fʋɔtɛ wʋrʋ kʋlʋ nafo ga ja tʋmɩra na baa gaa yɩɛ dɩtʋm wʋ fʋɔnaŋ. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Wʋ na ba tawɩ kpa sɛ wʋ a tɔ ba diterembi dinari<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Dinari yɩɛ dɩtʋm yɩɛrɛ wiita bi kɩmtʋɔ bɛ</char></note> garɛ wiita bi sɛ wʋ mʋ ba ju wʋ fʋɔnaŋ.&gt;&gt;<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Aja yɩɛ nafo karafɩɛ saŋgʋ saŋa na, wʋ ti ju ga na barɛ sɩmɩɛɩ gɩyɩɛ naŋ baa yɩɛ bʋrʋ ʋ. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Amɩɛ gba n ju ma fʋɔnaŋ ga yɩɛ dɩtʋm, maa tɔ amɩɛ na dieli. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Dɩmʋŋ dʋɔ ba ju.&gt;&gt;</para>
  <para style="p" vid="MAT 20:5">Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Gʋ dɩ tala wiita karafɩɛ gifi ala na wiita karafɩɛ atoro naŋ na, fʋɔtɛ wʋŋ ti bɔrɛ ga mʋ barɛ ju.&gt;&gt;<verse eid="MAT 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6" />Aja yɩɛ bʋyanɔ karafɩɛ anʋŋ naŋ na, wʋ ti ju ga na barɛ ba sɩmɩɛɩ baa yɩɛ bʋrʋ ʋ. Sɛ wʋ tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ sɩmɩɛɩ jɩna ɩ biri yela ɩɩ yɩɛ bʋrʋ?&gt;&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />Sɛ ba lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Wʋrʋ n fa daa dɩtʋm sɛ dɩ n yɩɛ ɛ.&gt;&gt;</para>
  <para style="p" vid="MAT 20:7">Sɛ wʋ tawɩ ba sɛ, &lt;&lt;Amɩɛ gba n ju ga yɩɛ dɩtʋm ma fʋɔnaŋ.&gt;&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Gʋ bʋyanɔ talɛ na, fʋɔtɛ wʋŋ yagɛ wʋ kɩɛrɛ bɩnɛ tawɩ ɩ sɛ yagɛ tʋmɩra baa gaa jaŋi na nyaa tɔ ba kɩm, fara lɩɩ baa ba dʋɔ wʋrʋgbɩɛ na dʋɔ mʋ ju baa ba chɩŋkpɩɛ kɔnɛ na dʋɔ.&gt;&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Dɩtʋm yɩɛra baa ba ju fʋɔ gaa naŋ aja yɩɛ karafɩɛ anʋŋ saŋa kɔnɛ sɛ ba wʋkʋma yu diterembi dinari<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">Dinari yɩɛ dɩtʋm yɩɛrɛ wiita bi kɩmtʋɔ bɛ</char></note> garɛ. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Gʋ dɩ tala baa ba chɩŋkpɩɛ ju fʋɔ gaa naŋ dʋɔ na, ba jiŋ sɛ baa yu kii dɩmʋŋ. Ama ba wʋkʋma yu diterembi dinari garɛ. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Gʋ ba lɩɛ ba aterembie na, sɛ ba fara baa fʋlʋ na fʋɔtɛ wʋŋ. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Sɛ ba tawɩ sɛ, &lt;&lt;Baala baa ba dʋɔ wʋrʋgbɩɛ gaa yɩɛ dɩtʋm karafɩɛ garɛ nyiŋeŋ na, nya tɔ daa baa dɩ sɩŋ wiita keŋkeŋ yɩɛ dɩtʋm ibiri na ba kʋrʋkʋrʋ.&gt;&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Ama fʋɔtɛ wʋŋ lɩsɛ ba tɩba wʋrʋ nʋɔ sɛ, &lt;&lt;Ma dɩɛtɛ, ma n sisi nyaŋ ŋ. Nya n kpa gʋ diterembi dinari sɛ nyaa lɩɛ wiita bi?&gt;&gt; <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Mʋ nya aterembie na nyaa pala. Maa ja sɛ maa tɔ baalɛ wʋŋ ma mʋ ɩ dɩtʋm dʋɔ wʋrʋgbɩɛ na takɩɛ ganaŋkʋ ma tɔ nyaŋ na. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Ma taŋ gbɩɛ na maa mʋ ma aterembie yɩɛ ŋii maa jawʋ na yaa? Yaa ajʋʋnyaŋ lɩɩna ma dɩbam yɩɛ dʋɔ?<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Dɩmʋŋ dʋɔ baa ba yɩɛ wʋrʋgbɩɛtina na aja yɩɛ asanaŋtina na asanaŋtina a yɩɛ wʋrʋgbɩɛtina.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s1">Yesu tawɩ wʋ sɩŋ wɩɛ butoro-tɛ</para>
  <para style="r">
    <ref loc="MRK 10:32-34">Maakɩ 10:32-34</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Gʋ Yesu a ju Yerusalem na, wʋ mʋ wʋ kpirida gifi bala baa lɩɩ laraŋ sɛ wʋ tawɩ ba sɛ, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;N nyii, dɩɩ ju Yerusalem, dɩmaŋ sɛ baa lɩsɛ Wʋkpa Bu wʋŋ fa Ɩsʋɔ sei bɩnɩɛ na Mosesi mbara bakalaasa baa na baa fu ɩ dɩpʋɛ sɛ ba n kʋ ɩ <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />na baa mʋ ɩ fa baa ba ba yɩɛ Yudatina na baa jabi ɩ, ta ɩ achʋchʋɛ na baa jɔ ɩ daŋ gasagasa dʋɔ. Ama wɩɛ atoro wɩɩ na, wʋ a feŋ lɩɩ sɩŋ naŋ.&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s1">Yakubu na Yohane ba naa sʋlʋ Yesu bʋrʋ garɛ</para>
  <para style="r">
    <ref loc="MRK 10:35-45">Maakɩ 10:35-45</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Sɛ Sebedi alʋ na wʋ bie baala jaŋ kɔŋ Yesu jaŋ, sɛ ba naa gaa laŋ luuŋ Yesu asanaŋ sʋlʋ ɩ bʋrʋ garɛ.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Sɛ Yesu tasɛ ɩ sɛ, &lt;&lt;Be sɛ ɩ jawʋ?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Sɛ wʋ lɩsɛ nʋɔ sɛ, &lt;&lt;Yela na ma bie baala jaŋ bala bana wʋrʋ a cha n jɩsaŋ dʋɔ na wʋrʋ dʋɔ a cha n nambi dʋɔ n juori gaa naŋ.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Ɩ ba jiŋ ŋii ɩ tasɛ na a. Ɩ dɩlɛ na awʋrʋfʋɔ ŋii maa naa?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Dɩ dɩlɛ.&gt;&gt; <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Ɩ dɩlɛ na awʋrʋfʋɔ ŋii maa na gba na, ama naa maŋ aaŋ ja maa yela na ɩ cha ma jɩsaŋ dʋɔ yaa ma nambi dʋɔ ɔ. Achaatɩŋ ŋina yɩɛ baa Majuo desina ba si na teri bɛ.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Gʋ kpalɛnara gifi baa nyii wɩɛ ŋina na, ba kara biŋbira dʋ nabie baala jaŋ baa. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Sɛ Yesu yagɛ wʋ kpalɛnara baa kpiniŋ kɔŋ gaa jaŋi wʋ jaŋ sɛ wʋ tawɩ ba sɛ, &lt;&lt;Ɩ jiŋ gʋ baa ba ba yɩɛ Yudatina na juoneŋ a mʋ yikuo bɛ baa di ba bakpa dʋɔ, sɛ ba bɩnɩɛ gba a mʋ yikuo baa di ba bakpa dʋɔ. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ama amɩɛ bɩrɛ, n baa yɩɛ takɩɛ ba. Wʋkʋma wʋŋ wʋ a ja sɛ wʋ a yɩɛ wʋjanɛ amɩɛ tɩba na, ŋɩ tiri gʋ wʋ a yɩɛ amɩɛ tɩba tʋmɩrɛ, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />sɛ wʋkʋma wʋŋ wʋ a ja sɛ wʋ a yɩɛ asanaŋtɛ na, ŋɩ tiri gʋ wʋ a yɩɛ amɩɛ tɩba tʋmɩrɛ <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />takɩɛ ganaŋkʋ Wʋkpa Bu wʋŋ n kɔŋ sɛ ba n tʋm ɩ na, ama wʋ gaa tʋm sɛ wʋ mʋ wʋ nkpa tɔ kɩm lɩɛ bakpa fɔɩ lɩɩ ba dɩsʋbʋ naŋ.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s1">Yesu fulu bataŋpʋna bala barɛ asa</para>
  <para style="r">
    <ref loc="MRK 10:46-52">Maakɩ 10:46-52</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Gʋ Yesu na wʋ kpalɛnara baa a lɩɩ Yeriko dɩɛ naŋ na, jama baa kpaŋ ɩ. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Kɩɛ, bataŋpʋna bala barɛ cha ba chaɩ gbɩɛ laraŋ. Gʋ ba nyii gʋ Yesu a lam na, ba kuusi tawɩ sɛ, &lt;&lt;Kpaŋjuo, Dawidi ganana bie, wɩɩ daa gɩyɔŋ!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Sɛ jama baa tawɩ baŋ ba sɛ ba n fu ba nʋɔsɛ dʋɔ. Ama ba ju dʋɔ kuusi na doŋ sɛ, &lt;&lt;Kpaŋjuo, Dawidi ganana bie, wɩɩ daa gɩyɔŋ!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Sɛ Yesu dʋɔsɩŋ sɛ wʋ yagɛ ba tasɛ ba sɛ, &lt;&lt;Be sɛ ɩ ja sɛ maa yɩɛ fa amɩɛ.&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Sɛ ba lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Kpaŋjuo, dɩɩ ja sɛ daa asa a fulu bɛ.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Sɛ Yesu wɩɩ ba gɩyɔŋ sɛ wʋ mʋ wʋ pam tapʋ ba asa. Gabʋanaŋ sɛ ba asa fulu sɛ ba kpaŋ ɩ.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu jʋʋ Yerusalem takɩɛ Juo</para>
  <para style="r">
    <ref loc="MRK 11:1-11">Maakɩ 11:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Gʋ Yesu na wʋ kpalɛnara baa a ju sɛ ba tirina Yerusalem dɩɛ na, gʋ ba tala Betifage dɩɛ bie gaa ga wɩɛ olifi dasɛ bʋrɔŋ bie gaa dʋɔ na sɛ Yesu kpiri wʋ kpalɛnara baa tɩba bala, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />sɛ wʋ tawɩ ba sɛ, &lt;&lt;N ju dɩɛ bie gaa ga wɩɛ amɩɛ asanaŋ na naŋ. Gʋ ɩ jʋʋ na, ɩ na kpaŋa pɔgaɩ yela kpaŋa bie wʋrʋ sɩmɩɛɩ wʋ jaŋ, n buoli ba kɔna maŋ. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Sɛ wʋrʋ tasɛ amɩɛ bʋrʋ darɛ na, n tawɩ ɩ sɛ Kpaŋjuo wʋŋ n tiri ba, wʋ a fa amɩɛ gbɩɛ na ɩ mʋ ba kɔna maŋ.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ŋina yɩɛ dɩmʋŋ na wɩɛ ŋii Ɩsʋɔ pala na wʋ ɔja dʋɔ tawɩ si na a kɔŋ tɩba sɛ,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Tawɩ Siyoŋ dɩɛ sɛ</para>
  <para style="q2" vid="MAT 21:5">N kɩɛ amɩɛ juo a kɔŋ amɩɛ jaŋ,</para>
  <para style="q1" vid="MAT 21:5">wʋ fʋʋ sɛ wʋ chaɩ kpaŋa,</para>
  <para style="q2" vid="MAT 21:5">kpaŋa bie wʋrʋ dʋɔ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Sak 9:9</ref>.</char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Sɛ wʋ kpalɛnara baa ju ga yɩɛ ganaŋkʋ Yesu kalaa ba sɛ baŋ ga yɩɛ na. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ba mʋ kpaŋa wʋŋ na kpaŋa bie wʋrʋ kɔna Yesu, ba mʋ ba adugbe gagbasɛ jaga wʋ dʋɔ sɛ Yesu cha ŋɛ dʋɔ. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Bakpa fɔɩ mʋ ba adugbe gagbasɛ tɔ gbɩɛ naŋ sɛ barɛ dʋɔ wʋŋɩɩ abilafa tɔ gbɩɛ naŋ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Sɛ jama baa ba dɔŋ asanaŋ na baa ba kpamɩna wʋrʋgbɩɛ na kpiniŋ kuusi sɛ,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosana<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Hosana yɩɛ Hibiri dɩtawɩ bɛ, ga tie akala sɛ mɔlɔgɩ. Wʋrʋgbɩɛ na ga gaa sɩŋ fa kalɩɛwʋ. </char></note> n ju fa Dawidi ganana bie.&gt;&gt;</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">&lt;&lt;Kusee n nyina wʋŋ wʋ a kɔŋ Ɩsʋɔ yɩrɛ naŋ!&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">Num 118:25-26</ref>.</char></note></para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">&lt;&lt;Hosana<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Hosana yɩɛ Hibiri dɩtawɩ bɛ, ga tie akala sɛ mɔlɔgɩ. Wʋrʋgbɩɛ na ga gaa sɩŋ fa kalɩɛwʋ.</char></note> n ju fa Ɩsʋɔ wʋŋ wʋ wɩɛ adugbe na!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Gʋ Yesu jʋʋ Yerusalem dɩɛ naŋ na, dɩɛ gaa kpiniŋ asadi fɔɩ sɛ ba tasɛ sɛ &lt;&lt;Mmʋɔ bɛ?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Sɛ jama baa lɩsɛ nʋɔ sɛ, &lt;&lt;Wina n nyina Yesu, Ɩsʋɔ ɔja wʋŋ wʋ lɩɩ Nasarati gaa ga wɩɛ Galaliya tibi dʋɔ na.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s1">Yesu gɩŋ yawʋ dira lɩɩ Ɩsʋɔ tʋm danɛ naŋ</para>
  <para style="r">
    <ref loc="MRK 11:15-19">Maakɩ 11:15-19</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Sɛ Yesu jʋʋ Ɩsʋɔ tʋm danɛ naŋ sɛ wʋ geŋ baa baa di yawʋ na kpiniŋ lɩɩ dɩmaŋ. Sɛ wʋ titi ba tebulu aba ŋii baa chɩɛgɩna aterembie ŋɩ dʋɔ, na juori gakuosɛ yara gbeliŋ lɔ. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Sɛ wʋ tawɩ ba sɛ, &lt;&lt;&lt;Ba sabɩɛ Ɩsʋɔ wɩɛ naŋ sɛ baa yagɛ ma tʋm danɛ sɛ dɩga danɛ.<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Yis 56:7</ref>.</char></note> Ama ɩ mʋ dɩmaŋ yɩɛ ŋmɩɛla baa ba chamɩna doŋ baa lɩɛ bakpa abʋrɩ na dɩchatɩŋ.&gt;<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="JER 7:11">Yere 7:11</ref>.</char></note>&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Gʋ wʋ wɩɛ dɩmaŋ na, bataŋpʋna na buobi aba kɔŋ wʋ jaŋ sɛ wʋ chɔ ba. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ama gʋ sei bɩnɩɛ na Mosesi mbara bakalaasa baa na adaŋgana ŋii wʋ yɩɛ, na ganaŋkʋ bachaasɛ a kuusi Ɩsʋɔ tʋm danɛ naŋ sɛ, &lt;&lt;Hosana n ju fa Dawidi ganana bie na,&gt;&gt; ba kara biŋbira.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Sɛ ba tasɛ Yesu sɛ, &lt;&lt;N nyii ŋii bachaasɛ bana a tawɩ naa?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">Sɛ Yesu lɩsɛ ba nʋɔ sɛ, Ɛɛŋ, ma nyii. Sɛ wʋ tasɛ ba sɛ ɩŋ karaŋ ta Ɩsʋɔ Wɩɛ ŋii ŋɩ tawɩ sɛ,</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt;Bachaasɛ na bachaasɛ bisi</para>
  <para style="q2" vid="MAT 21:16">chamɩna kalɩɛwʋ baa fa nyaŋ.&gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Sɛ wʋ yela ba dɩmaŋ lɩɩ dɩɛ janɛ gaa naŋ ju Batani ga duo dɩmaŋ.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesu tawɩ figi daŋ garɛ nʋɔsɛ</para>
  <para style="r">
    <ref loc="MRK 11:12-14">Maakɩ 11:12-14-24</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Nafo fuu gʋ Yesu bɔrɛ wʋ a kɔŋ Yerusalem na, dusoŋ chaŋ ɩ. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Wʋ na figi daŋ garɛ sɩmɩɛɩ gbɩɛ laraŋ. Sɛ wʋ ju ga tie ama wʋ n na bʋrʋ ʋ amʋɔ fagɩɛ nyiŋeŋ. Sɛ Yesu tawɩ figi daŋ gaa sɛ, &lt;&lt;Nya aa ti si bie ɩ.&gt;&gt; Gabʋanaŋ sɛ figi daŋ gaa kpisi.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Gʋ wʋ kpalɛnara baa na ŋina na, dɩ yɩɛ ba doba. Sɛ ba tasɛ sɛ, &lt;&lt;Be n yɩɛ sɛ figi daŋ gaa kpisi bileŋ dɩmʋŋ?&gt;&gt;<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ ɩ lɩɛdi sɛ ɩŋ di noro na, naa ŋii ma yɩɛ figi daŋ gana nyiŋeŋ sɛ ɩ dɩlɛ yɩɛ ɛ, ama ɩ dɩlɛ tawɩ bʋrɔŋ gana sɛ, &lt;Kuli ju ga sala ɔpʋ naŋ&gt; na ŋii yɩɛ dɩmʋŋ. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Sɛ ɩ lɩɛ di na bʋrʋkʋma gaa ɩ jɔ dɩga sɛ ɩ tasɛ na, ɩ yu.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s1">Yesu yikuo dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MRK 11:27-33">Maakɩ 11:27-33</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Sɛ Yesu jʋʋ Ɩsʋɔ tʋm danɛ gaa naŋ. Gʋ wʋ a kalaa na, Ɩsʋɔ sei bɩnɩɛ na dɩɛ bɩnɩɛ barɛ kɔŋ wʋ jaŋ. Sɛ ba tasɛ ɩ sɛ, &lt;&lt;Yikuo gamʋɔ sɛ nya wɩɛna sɛ nyaa yɩɛ abʋrɩ ŋina? Mmʋɔ n fa nyaŋ dɩmʋŋ yikuo gana?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Maa tasɛ amɩɛ wɩɛ a dʋŋdʋlʋŋ, sɛ ɩ dɩlɛ lɩsɛ nʋɔ na, maa tawɩ amɩɛ yikuo gaa ma chamɩna maa yɩɛ abʋrɩ ŋina. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />N tawɩ maŋ, Yohane Ɩsʋɔ Sɔrɛ wʋŋ Ɩsʋɔ sɔ lɩɩ Ɩsʋɔ bɛ yaa wʋkpa?&gt;&gt; Sɛ ba tawɩ ba nyiŋeŋ-nyiŋeŋ sɛ dɩ lɩsɛ nʋɔ sɛ ŋɩ lɩɩ Ɩsʋɔ na wʋ a tasɛ daa sɛ be n yɩɛ sɛ dɩ n lɩɛ Yohane Ɩsʋɔ Sɔrɛ wʋŋ di?<verse eid="MAT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 21:26" />Ama sɛ dɩ lɩsɛ nʋɔ sɛ, &lt;&lt;Ŋɩ lɩɩ bakpa na, dɩɩ se bakpa baa, akala takɩɛ wʋkʋma lɩɛdi gʋ Yohane cha wʋ yɩɛ Ɩsʋɔ ɔja bɛ.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Dɩmʋŋ dʋɔ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Dɩ ba jiŋ ŋ. Sɛ Yesu tawɩ ba sɛ maŋ gba, maa tawɩ amɩɛ yikuo gaa maa mʋ maa yɩɛ abʋrɩ ŋina na a.&gt;&gt;<verse eid="MAT 21:27" /></para>
  <para style="s1">Bie baala jaŋ bala baa dʋɔ diduu</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Sɩnɛ n nyina amɩɛ nfɩɛrɛ wɩɛ ŋina dʋɔ? Baalɛ wʋrʋ cha wʋ wɩɛ wʋ wɩɛna bie baala jaŋ bala. Wʋ ju bɩnɛ jaŋ wʋŋ jaŋ ga tawɩ ɩ sɛ mabu baalɛ jaŋ, ju ga yɩɛ dɩtʋm ma fʋɔnaŋ jaŋ.&gt;&gt;<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Maa ju u.&gt;&gt; Ama wʋrʋgbɩɛ na, wʋ biliŋi wʋ nfɩɛrɛ sɛ wʋ ju.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />Sɛ juo wʋŋ ju wʋbu pii wʋŋ jaŋ ga tawɩ ɩ dɩmʋŋ. Sɛ wʋ tawɩ sɛ,&lt;&lt;Majuo, maa ju.&gt;&gt; Ama wʋ n ju u.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />Sɛ Yesu tasɛ Ɩsʋɔ sei bɩnɩɛ na dɩɛ bɩnɛ baa sɛ, &lt;&lt;Wʋ bie bala baa tɩba wʋ Mmʋɔ n yɩɛ wʋ juo jawʋ?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Sɛ ba lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Bɩnɛ jaŋ wʋŋ.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ lampo lɩɛra na ala jaga baa aja chɩŋkpɩɛ amɩɛ jʋʋ Ɩsʋɔ juori gaa naŋ.&gt;&gt;<verse eid="MAT 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 21:32" />Akala takɩɛ Yohane Ɩsʋɔ Sɔrɛ kɔŋ amɩɛ jaŋ gaa kalaa amɩɛ gbɩɛ ga chirigisa sɛ ɩŋ lɩɛ ɩ di i, ama lampo lɩɛra na ala jaga baa lɩɛ ɩ di. Gʋ ɩ na ŋina wʋrʋgbɩɛ na, ɩŋ biliŋi lɩɩ amɩɛ dɩsʋbʋ naŋ, na ɩ lɩɛ ɩ di i.<verse eid="MAT 21:32" /></para>
  <para style="s1">Fʋɔ kɩɛra barɛ dʋɔ diduu</para>
  <para style="r">
    <ref loc="MRK 12:1-12">Maakɩ 12:1-12</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Sɛ Yesu jɔ ba diduu sɛ, &lt;&lt;N nyii diduu gabaŋbaŋ. Baalɛ wʋrʋ cha fara girepi fʋɔ. Wʋ ma dɩpɔrɛ logo fʋɔ gaa, sɛ wʋrʋ girepi bie dɩŋaŋsɛtɩŋ ga tɩba. Wʋ ma giera danɛ jalɩŋtɛ garɛ fʋɔ gaa naŋ. Sɛ wʋ mʋ girepi fʋɔ gaa dʋ kɩɛra barɛ pamɩɛ naŋ. Wʋrʋgbɩɛ na, wʋ ju gbɩɛ. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Gʋ karɩŋ saŋa talɛ na, sɛ fʋɔtɛ wʋŋ kpiri wʋ tʋmɩra fʋɔ kɩɛra baa jaŋ sɛ ba n ju ga lɩɛ wʋ teri kɔna ɩ. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ama fʋɔ kɩɛra baa chaŋ ba, tugu wʋrʋ, kʋ wʋrʋ sɛ ba lɔ bʋɛ kʋ wʋrʋ.&gt;&gt;<verse eid="MAT 21:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 21:36" />Sɛ fʋɔtɛ wʋŋ ti kpiri tʋmɩra barɛ baa ba kii baa wʋ chɩŋkpɩɛ kpiri na, dɩmʋŋ sɛ ba yɩɛ baa gba. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Wʋŋ wʋ kakaa sɛ wʋ kpiri ɩ na n nyina wʋ tɩŋtɩŋ wʋbu baalɛ jaŋ. Sɛ wʋ tawɩ sɛ, &lt;&lt;Mabu baalɛ jaŋ wina bɩrɛ, baa bu ɩ.&gt;&gt;<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />Ama gʋ fʋɔ kɩɛra baa na wʋbu wʋŋ na, ba tawɩ ba nyiŋeŋ-nyiŋeŋ sɛ, &lt;&lt;Wina n nyina gapatɩɛ diiri wʋŋ. N kɔŋ na dɩ kʋ ɩ na gapatɩɛ gaa a yɩɛ daa teri. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Dɩmʋŋ dʋɔ ba chaŋ wʋbu wʋŋ sɛ ba fɔŋɩ ɩ lɩɩ girepi fʋɔ gaa naŋ sɛ ba kʋ ɩ.&gt;&gt;<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Sɛ Yesu tasɛ ba sɛ, &lt;&lt;Dɩmʋŋ dʋɔ sɛ fʋɔtɛ wʋŋ kɔnɛ na, be sɛ wʋ a yɩɛ fʋɔ kɩɛra baa?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Wʋ a kʋ dɩmʋŋ kɩɛra basʋbʋɛ bana na wʋ a mʋ fʋɔ gaa dʋ kɩɛra ba fɔlɛ pamɩɛ naŋ baa karɩŋ saŋa talɛ na, baa fa ɩ wʋ teri.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Sɛ Yesu tawɩ ba sɛ ɩŋ karaŋ ta Ɩsʋɔ Sabɩɛwɩɛ ŋii? Ŋii ba sabɩɛ sɛ,</para>
  <para style="q1" vid="MAT 21:42">&lt;&lt;&lt;Bʋɩ gaa danɛ mara pɩɛ ga na,</para>
  <para style="q2" vid="MAT 21:42">gaa aaŋ ja gaa chaŋ danɛ gaa dɩkɔŋ naŋ na doŋ.</para>
  <para style="q1" vid="MAT 21:42">Ɩsʋɔ n yɩɛ ŋina</para>
  <para style="q2" vid="MAT 21:42">sɛ dɩ yɩɛ doba daa asa dʋɔ.&gt;<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Num 118:22-23</ref>.</char></note>&gt;&gt;<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Dɩmʋŋ dʋɔ maa tawɩ amɩɛ sɛ baa mʋ Ɩsʋɔ juori gaa lɩɩ amɩɛ jaŋ, na baa mʋ fa bakpa baa baa yɩɛ wʋ jawʋ na. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Wʋkʋma wʋŋ wʋ sala bʋɩ gaa dʋɔ na, gaa karɩɛ-karɩɛ ɩ aguŋda-aguŋda. Sɛ wʋkʋma wʋŋ bʋɩ gaa sala wʋ dʋɔ na, gaa patɩɛ ɩ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">Naa Sabɩɛwɩɛ kpiniŋ n wɩɛna dɩmʋŋ</char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Gʋ Ɩsʋɔ sei bɩnɩɛ na Farasitina baa nyii Yesu aduuna na, ba jiŋ gʋ baa sɛ wʋ dʋɔna. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Dɩmʋŋ dʋɔ baa ja gbɩɛ gaa baa mʋna dʋɔ na baa chaŋ ɩ ama baa se jama baa akala takɩɛ bakpa baa jiŋ gʋ wʋ yɩɛ Ɩsʋɔ ɔja bɛ.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Sarɛ asadi adiya di dʋɔ diduu</para>
  <para style="r">
    <ref loc="LUK 14:15-24">Luka 14:15-24</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Sɛ Yesu ti jɔ diduu tawɩ ba sɛ, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;Ɩsʋɔ juori gaa kɩɛna bɛ takɩɛ gʋ juo wʋrʋ desina sarɛ asa lɩɛ adiya fa wʋbu baalɛ jaŋ. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Wʋ kpiri wʋ tʋmɩra sɛ ba n ju ga tawɩ baa wʋ lɔ pam yagɛ ba na sɛ ba n kɔŋ ama ba pɩɛ.&gt;&gt;<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />Sɛ wʋ ti kpiri wʋ tʋmɩra fɔɩ barɛ tawɩ ba sɛ, &lt;&lt;N tawɩ baa ma lɔ pam yagɛ ba na sɛ ma yɩɛ sarɛ asadi adiya taŋ. Ma kʋ naa baalɛ na naa nuntɛ, sɛ bʋrʋkʋma yɩɛ siriya. N kɔŋ sarɛ asadi gaa tie.&gt;&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Ama ba n dʋ ɩ nʋɔ ɔ sɛ ba lam gatʋŋgʋrʋ. Barɛ laŋ ba fʋɔsɛ naŋ sɛ barɛ dʋɔ laŋ ba gɩyɩɛ. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Sɛ baa ba kakaa na gba chaŋ juo wʋŋ tʋmɩra baa tugu ba sɛ ba kʋ ba. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Sɛ juo wʋŋ kara biŋbira fɔɩ. Sɛ wʋ kpiri wʋ yuora sɛ ba n ga kʋ gatagapʋna baa, na baa tʋ ba dɩɛ janɛ gaa.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />Sɛ wʋ tawɩ wʋ tʋmɩra baa sɛ, &lt;&lt;Ma yɩɛ sarɛ asadi adiya ŋii taŋ, ama baa ma lɔ pam yagɛ ba na n daga na baa kɔŋ ŋ. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />N ju dɩɛ naŋ gbɩɛsɛ bisi naŋ ga yagɛ wʋkʋma wʋŋ ɩ na na baa kɔŋ asadi adiya ŋii tie. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Dɩmʋŋ dʋɔ wʋ tʋmɩra baa ju dɩɛ naŋ gbɩɛsɛ bisi naŋ gapɩlɛkʋma ga yagɛ wʋkʋma wʋŋ ba na ɩ na, bakpa ba bama na ba sʋbʋɛ kpiniŋ kɔŋ. Sɛ mʋɔra su sarɛ dɩlɩɛtɩŋ gaa.&gt;&gt;<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Ama gʋ Juo wʋŋ jʋʋ sarɛ asadi dɩlɩɛtɩŋ gaa na wʋ a gaa kɩɛ mʋɔra baa na, wʋ na gʋ baalɛ wʋrʋ wɩɛ dɩmaŋ wʋ ba fuona sarɛ abʋrɩ afuusa a.&gt;&gt; <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Sɛ wʋ tasɛ ɩ sɛ, &lt;&lt;Ma dɩɛtɛ, sɩnɛ sɛ nya yɩɛ gaa jʋʋ jɩna yela n ba fuona sarɛ abʋrɩ afuusa?&gt;&gt; Ama baalɛ wʋŋ n tawɩ bʋrʋ ʋ.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Sɛ Juo wʋŋ tawɩ wʋ tʋmɩra baa sɛ, &lt;&lt;N pɔgʋ wʋ pamɩɛ na wʋ nafara na ɩ lɔ ɩ asʋŋ ga dʋ giteŋteŋbiri naŋ, dɩmaŋ sɛ wiiniŋ na kela naŋ tawʋ wɩɛ.&gt;&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Sɛ Yesu tawɩ sɛ, &lt;&lt;Ba yagɛ bakpa fɔɩ, ama pii barɛ sɛ ba lɩsɛ.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s1">Lampo tɔ dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MRK 12:13-17">Maakɩ 12:13-17</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Sɛ Farasitina barɛ ga jaŋi ja gbɩɛ gaa baa mʋna dʋɔ yii Yesu gʋdʋ wʋ nʋɔnaŋ atawɩsa dʋɔ. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Ba kpiri ba kpalɛnara na Juo Hɛrɔdɩ wʋrʋgbɩɛtina tɩba barɛ sɛ ba n ju wʋ jaŋ ga tasɛ ɩ sɛ, &lt;&lt;Wʋkalaasa, dɩ jiŋ gʋ nya yɩɛ gasiŋteŋ diri bɛ, sɛ nyaa kalaa Ɩsʋɔ wɩɛ ŋii ŋɩ yɩɛ gasiŋteŋ ŋɩ gbɩɛ dʋɔ. Ŋɩ n tiri nyaŋ lɩɩ ŋii bakpa a tawɩ ɩ, akala takɩɛ nyaa kɩɛ wʋkpa asanaŋ n dɩ tawɩ naŋ ŋ. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tawɩ daa, sɩnɛ n nyina nya nfɩɛrɛ wɩɛ ŋina dʋɔ? Ŋɩ wɩɛ gbɩɛ sɛ dɩ n tɔ lampo fa Roma Juo Kayisa yaa dɩ n baa tɔ?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ama Yesu jiŋ ba nfɩɛrɛ sʋbʋ dʋɔ, wʋ tawɩ sɛ, &lt;&lt;Amɩɛ aluguusitina, be n yɩɛ sɛ ɩ ja sɛ ɩ yii maŋ gʋdʋ? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />N mʋ diterembi dinari gaa baa mʋ baa tɔ lampo na kɔna maŋ na maa kɩɛ.&gt;&gt; Sɛ ba mʋ diterembi dinari kɔna ɩ <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />sɛ wʋ tasɛ ba sɛ, &lt;&lt;Mmʋɔ nyi na wʋ yɩrɛ n jaga na ga dʋɔ?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Juo Kayisa teri.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N mʋ ŋii ŋɩ yɩɛ Juo Kayisa teri na fa Juo Kayisa na ɩ mʋ ŋii ŋɩ yɩɛ Ɩsʋɔ teri na fa Ɩsʋɔ.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Gʋ ba nyii wɩɛ ŋina na, dɩ yɩɛ ba doba sɛ ba yela ɩ sɛ ba lam.<verse eid="MAT 22:22" /></para>
  <para style="s1">Feŋ lɩɩ sɩŋ naŋ dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MRK 12:18-27">Maakɩ 12:18-27</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Dɩmʋŋ wɩɩ gana na, Sadukitina baa baa lɩɛ baa di sɛ feŋ lɩɩ sɩŋ naŋ wɩɛ na barɛ kɔŋ Yesu jaŋ na baa gaa tasɛ ɩ wɩɛ. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Sɛ ba tasɛ ɩ sɛ, &lt;&lt;Wʋkalaasa, Mosesi tawɩ daa sɛ baalɛ sɩŋ yela wʋ alʋ sɛ ba n lʋrʋ bie na, ŋɩ tiri gʋ wʋnabu n saa okulapu wʋŋ, na wʋ a lʋrʋ bie fa wʋ ŋmɩɛtɩ wʋŋ wʋ sɩŋ na. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Juo lʋrʋbie baala jaŋ lɩkaarɛ barɛ n cha ba wɩɛna. Sɛ ba tɩba bɩnɛ jaŋ wʋŋ saa alʋ, wʋ n lʋrʋ ʋ sɛ wʋ sɩŋ. Sɛ wʋnabu mʋ okulapu wʋŋ saa. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Dɩmʋŋ sɛ dɩ mɩɛna wʋnabu balatɛ wʋŋ na batoro-tɛ wʋŋ mʋ ga tala lɩkaaratɛ wʋŋ dʋɔ. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Wʋrʋgbɩɛ na, sɛ alʋ wʋŋ gba sɩŋ. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Dɩmʋŋ dʋɔ feŋ lɩɩ sɩŋ naŋ wɩɩ na, ba tɩba wʋ Mmʋɔ alʋ n nyina alʋ wʋŋ?&gt;&gt;Akala takɩɛ juo lʋrʋbie lɩkaarɛ baa kpiniŋ saa ɩ.<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Ɩ tʋsʋ gbɩɛ, akala takɩɛ ɩ ba jiŋ Ɩsʋɔ Sabɩɛwɩɛ ŋii yaa Ɩsʋɔ doŋ ŋ. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Akala takɩɛ feŋ lɩɩ sɩŋ naŋ wʋrʋgbɩɛ na, bakpa baa saa a, baa kɩɛna bɛ takɩɛ Ɩsʋɔ gabʋɔsɛ baa ba wɩɛ Ɩsʋɔ adugbe na. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Lɩɩna atatina feŋ lɩɩ sɩŋ naŋ na, ɩŋ karaŋ ŋii Ɩsʋɔ tawɩ fa amɩɛ sɛ, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />maŋ n nyina Abiraham Ɩsʋɔ, Isaki Ɩsʋɔ na Yakubu Ɩsʋɔ wʋŋ wʋ ba yɩɛ atatina Ɩsʋɔ ɔ, ama wʋ yɩɛ bakpa bakɩɛnasa Ɩsʋɔ bɛ.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Gʋ jama baa nyii wɩɛ ŋii na, dɩ yɩɛ ba doba na wʋ kalaa ŋii.<verse eid="MAT 22:33" /></para>
  <para style="s1">Mbara gaa ga yɩɛ gajanɛ</para>
  <para style="r">
    <ref loc="MRK 12:28-34">Maakɩ 12:28-34</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Gʋ Farasitina baa nyii ganaŋkʋ Yesu lɩsɛ Sadukitina baa nʋɔ sɛ dɩ duo ba nʋɔ na, ba yagɛ dɔŋa gaa jaŋi. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Sɛ ba tɩba wʋrʋ wʋŋ wʋ yɩɛ mbara wʋbɩɩsa na tasɛ ɩ wɩɛ mʋ yɩɛ ɩ lɔ tɩba sɛ, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />&lt;&lt;Wʋkalaasa, Mosesi mbara ŋii kpiniŋ naŋ, gamʋɔ n nyina gajaŋ-janɛ?&gt;&gt;<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Ja Ɩsʋɔ nya Ɩsʋɔ lɩɩ n digela naŋ kpiniŋ, n sʋbʋ kpiniŋ, nya nfɩɛrɛ kpiniŋ naŋ.<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Ditiro 6:5</ref>.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Mbara gana n nyina gaa ga dɔŋ asanaŋ sɛ ga yɩɛ gajaŋ-janɛ. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Mbara bʋlatɛ kɩɛna takɩɛ gana. Gaa n nyina sɛ ja n dʋɔ takɩɛ n wʋsɛ.<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lɛf 19:18</ref>.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Mosesi Mbara ŋii na Ɩsʋɔ bajana baa kalaa ŋii kpiniŋ sɩmɩɛɩ dɩmʋŋ mbara ala ŋina dʋɔ bɛ.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s1">Kirisito dʋɔ wɩɛ tasɛ</para>
  <para style="r">
    <ref loc="MRK 12:35-37">Maakɩ 12:35-37</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Gʋ Farasitina baa jaŋi na, Yesu tasɛ ba sɛ, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Sɩnɛ n nyina amɩɛ nfɩɛrɛ lɩɩna Kirisito wʋŋ dʋɔ?&gt;&gt;Mmʋɔ ganana bie n nyina ɩ?</para>
  <para style="p" vid="MAT 22:42">Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Dawidi ganana bie bɛ.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Sɛ Yesu ti tasɛ baa sɛ, Be dʋɔ sɛ Ɩsʋɔ feliŋ yela sɛ Dawidi yagɛ ɩ sɛ, &lt;&lt;Kpaŋjuo?&gt;&gt; Akala takɩɛ Dawidi tawɩ sɛ,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;&lt;Ɩsʋɔ wʋŋ n tawɩ ma Kpaŋjuo sɛ,</para>
  <para style="q2" vid="MAT 22:44">Cha ma pam jɩsaŋ dʋɔ ga</para>
  <para style="q1" vid="MAT 22:44">tala gʋ maa mʋ n badʋŋna</para>
  <para style="q2" vid="MAT 22:44">mʋ yɩɛ n nafara dɩjagatɩŋ.<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Num 110:1</ref>.</char></note>&gt;&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Sɛ Dawidi tɩŋtɩŋ yagɛ Kirisito sɛ, &lt;&lt;Kpaŋjuo na, sɩnɛ sɛ Kirisito wʋŋ a ti dɩlɛ yɩɛ Dawidi ganana bie?&gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Wʋrʋ n dɩlɛ lɩsɛ nʋɔ ɔ. Lɩɩ dɩmʋŋ wɩɩ gana mʋ a ju na, wʋrʋ n ti dɩlɛ yu digela tasɛ ɩ wɩɛ ŋarɛ ɛ.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">N kɩɛ na dieli mbara bakalaasa na Farasitina baa dʋɔ</para>
  <para style="r">
    <ref loc="MRK 12:38-39">Maakɩ 12:38-39</ref>; <ref loc="LUK 11:43-46">Luka 11:43-46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Sɛ Yesu tawɩ jama baa na wʋ kpalɛnara baa sɛ, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Mbara bakalaasa na Farasitina baa nyiŋeŋ n wɩɛna yikuo na baa dɩlɛ kalaa Mosesi mbara ŋii tie. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Dɩmʋŋ dʋɔ ŋɩ tiri gʋ n nyii ba wɩɛ na ɩ yɩɛ bʋrʋkʋma gaa ba tawɩ amɩɛ na. Ama n baa yɩɛ bʋrʋ gaa baa yɩɛ na, akala takɩɛ ba tɩŋtɩŋ baa di ba kalaa dʋɔ ɔ. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Baa pɔgʋ gasʋlasɛ anyuŋtina mʋ sɩlɛ bakpa, ama ba tɩŋtɩŋ bɩrɛ baa ja sɛ baa mʋ ba pam nyiŋbie gba chɔna ba a.&gt;&gt;<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />Gʋ baa ja baa yɩɛ bʋrʋkʋma na bakpa a na ba dʋɔ na, ba yɩɛ nam tanɛ adaka a pii-pii ŋii baa sabɩɛ Ɩsʋɔ wɩɛ baa dʋ ŋɩ tɩba, ŋii baa mʋ baa pɔgʋ ba tulie na ba pamɩɛ dʋɔ na ajanɩɛ, na ŋii baa mʋ baa saga ba adugbe gagbasɛ nʋɔsɛ na gba ajalɩŋtina. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Baa ja achaatɩŋ ŋii ŋɩ wɩɛ jilima na asadi adiya di tie, na achaatɩŋ ajanɩɛ Yudatina tʋm danɩŋ naŋ, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />baa ja sɛ bakpa a luuŋ yɩlɩ ba gɩyɩɛnɩŋ naŋ na baa yagɛ ba sɛ, &lt;&lt;Bakalaasa.&gt;&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Ama amɩɛ bɩrɛ n baa yela na baa yagɛ amɩɛ sɛ, &lt;&lt;Bakalaasa&gt;&gt; akala takɩɛ ɩ wɩɛna wʋkalaasa wʋdʋŋdʋlʋŋ bɛ sɛ amɩɛ kpiniŋ ɩ yɩɛ dɔŋa lɩɛdɩra bɛ. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />N baa yagɛ wʋrʋ tibi gana dʋɔ sɛ, &lt;&lt;Juo&gt;&gt; akala takɩɛ ɩ wɩɛna Juo wʋdʋŋdʋlʋŋ bɛ Ɩsʋɔ adugbe. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Yaa n baa yela na baa yagɛ amɩɛ &lt;&lt;Wʋkalaasa&gt;&gt; akala takɩɛ ɩ wɩɛna wʋkalaasa wʋdʋŋdʋlʋŋ bɛ, wʋŋ n nyina Kirisito wʋŋ. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Amɩɛ tɩba wʋjaŋ-janɛ aja yɩɛ amɩɛ tɩba tʋmɩrɛ. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Akala takɩɛ wʋkʋma wʋŋ wʋ a jiŋna wʋ wʋsɛ na, Ɩsʋɔ aja kɔna ɩ tie, sɛ wʋkʋma wʋŋ wʋ a kɔna wʋ wʋsɛ tie na, Ɩsʋɔ aja jiŋna ɩ adugbe.<verse eid="MAT 23:12" /></para>
  <para style="s1">Yesu fuu ba dɩpʋɛ lɩɩ ba aluguusi wɩɛ dʋɔ</para>
  <para style="r">
    <ref loc="MRK 12:40">Maakɩ 12:40</ref>; <ref loc="LUK 11:39-42">Luka 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Amɩɛ Mosesi mbara bakalaasa na Farasitina, amɩɛ aluguusitina amɩɛ lakʋ! Akala takɩɛ ɩ tɔ Ɩsʋɔ Juori gaa bɔlɛ ɩ fa bakpa. Amɩɛ tɩŋtɩŋ ɩŋ jʋʋ o sɛ ɩ gara baa baa ja sɛ baa jʋʋ na gbɩɛ. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Amɩɛ mbara bakalaasa na Farasitina, amɩɛ aluguusitina amɩɛ lakʋ! Akala takɩɛ ɩ mʋna kpiŋjim gbɩɛ dʋɔ ɩ lɩɛ bakʋlapʋna gapatɩɛ, sɛ ɩ yɩɛ aluguusitina baa ɩ jɔ dɩga jalɩŋtɛ ɩ fa Ɩsʋɔ ɩ kalaa bakpa. Dɩmʋŋ dʋɔ Ɩsʋɔ aja fɔŋɩ amɩɛ dɩlɛ fɔɩ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Naa asabɩɛ wɩɛ ŋii kpiniŋ n wɩɛna ŋina a</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Amɩɛ mbara bakalaasa na Farasitina, amɩɛ aluguusitina amɩɛ lakʋ! Akala takɩɛ ɩ ju gbɩɛ gapɩlɛkʋma ɩ ja wʋkpa wʋrʋ na wʋ a biliŋi gaa kpi amɩɛ dʋɔ na ɩ tʋm, sɛ ɩ yu wʋrʋ kpi amɩɛ dʋɔ na, ɩɩ yela na wʋ a daga dɩla fɔŋɩwʋ gbɩɛta bʋla awʋrʋfʋɔ bʋala naŋ kii amɩɛ tɩŋtɩŋ.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Amɩɛ mbara bakalaasa na Farasitina baa ɩ kɩɛna takɩɛ bataŋpʋna baa baa pala bakpa asanaŋ, amɩɛ lakʋ. Ɩ kalaa sɛ, &lt;&lt;Sɛ wʋrʋ ka Ɩsʋɔ tʋm danɛ ntaŋ na, ba yɩɛ bʋrʋ ʋ, ama sɛ wʋrʋ ka aterembie asɩɛma ŋii ŋɩ wɩɛ Ɩsʋɔ tʋm danɛ naŋ ntaŋ na, ŋɩ tiri gʋ wʋ a di wʋ ntaŋ ŋii dʋɔ.&gt;&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Amɩɛ bataŋpʋna bamalaŋpʋna! Gamʋɔ n nyina gakpari, aterembie asɩɛma yaa Ɩsʋɔ tʋm danɛ gaa gaa yela sɛ aterembie asɩɛma ŋii a yɩɛ chɩrɩchɩrɩ naa? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ɩ ti tawɩ sɛ, &lt;&lt;Sɛ wʋrʋ ka gadiesa dɩgbɩŋgbɩŋ ntaŋ na, ba yɩɛ bʋrʋ ʋ, ama wʋrʋ ka gafaasa gaa ga jaga ɩ ga dʋɔ na, ŋɩ tiri gʋ wʋ a di wʋ ntaŋ ŋii dʋɔ.&gt;&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Amɩɛ bataŋpʋna. Gamʋɔ n nyina ga kpari, gafaasa yaa gadiesa dɩgbɩŋgbɩŋ gaa ga yela sɛ gafaasa gaa yɩɛ chɩrɩchɩrɩ naa? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Dɩmʋŋ dʋɔ wʋŋ wʋ ka gadiesa dɩgbɩŋgbɩŋ ntaŋ na, wʋ ka dɩgbɩŋgbɩŋ na gafaasa gaa ga jaga ɩ dʋɔ na kpiniŋ. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Sɛ wʋŋ wʋ ka Ɩsʋɔ tʋm danɛ gaa ntaŋ na, wʋ ka tʋm danɛ gaa na Ɩsʋɔ wʋŋ wʋ chaɩ ga tɩba na ntaŋ. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Sɛ wʋŋ wʋ ka Ɩsʋɔ adugbe ntaŋ na, wʋ ka Ɩsʋɔ juorigbeli na Ɩsʋɔ wʋŋ wʋ chaɩ ga dʋɔ na ntaŋ.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Mbara bakalaasa na Farasitina, amɩɛ aluguusitina, amɩɛ lakʋ! Akala takɩɛ ɩ tɔ amɩɛ jagɩɛ, akpinie na kielasɛ dʋɔ gifi naŋ garɛ ɩ fa Ɩsʋɔ. Ama ɩ pɩɛ mbara ŋii tɩba gaa ga yɩɛ ga kpari takɩɛ di wɩɛ ŋɩ gbɩɛ dʋɔ, gɩyɔŋ na gasiŋteŋ fa Ɩsʋɔ. Ŋina n daga na ɩ yɩɛ na n baa yela gifi naŋ garɛ tɔ. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Mbara bakalaasa na Farasitina baa ɩ kɩɛna takɩɛ bataŋpʋna baa baa pala bakpa asanaŋ. Ɩ chatɛ lɩŋ ɩ lɩsɛ chʋɔsɛ, ama ɩ liri nyɔma.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Mbara bakalaasa na Farasitina, amɩɛ aluguusitina, amɩɛ lakʋ! Akala takɩɛ ɩ yalɛ amɩɛ gafɩsɩ na achuŋputuŋ wʋrʋgbɩɛ, ama dɩsɛ chɩbɛ na wʋsɛ gɩbaa dɩlɛ cham n su ŋɩ tɩba. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Amɩɛ Farasitina bataŋpʋna! N chɩŋkpɩɛ yalɛ gafɩsɩ na achuŋputuŋ ŋii tɩba, na ŋɩ wʋrʋgbɩɛ gba a yɩɛ chɩrɩchɩrɩ?<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Mbara bakalaasa na Farasitina, amɩɛ aluguusitina, amɩɛ lakʋ. Ɩ kɩɛna bɛ takɩɛ bʋɔsɛ ŋii ba bɔlɛ ŋɩ dʋɔ ŋɩ wɩɛ dieli, ama ŋɩ tɩba bɩrɛ, ŋmaba na iniesi abʋrɩ n su ŋɛ. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Dɩmʋŋ sɛ ɩ yɩɛ bachirigisa bakpa asa dʋɔ, ama amɩɛ tɩba bɩrɛ, aluguusi wɩɛ na wɩɛ asʋbʋɛ n su amɩɛ.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Mbara bakalaasa na Farasitina, amɩɛ aluguusitina, amɩɛ lakʋ! Akala takɩɛ ɩ ma bʋɔsɛ ɩ fa Ɩsʋɔ bajana sɛ ɩ desina bachirigisa bʋɔsɛ. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Sɛ ɩ tawɩ sɛ, &lt;&lt;Nafʋɔ dɩ cha dɩ wɩɛ daa duluŋ saŋa na, nafʋɔ dɩɩ kpi ba dʋɔ na dɩ kʋ Ɩsʋɔ bajana baa a.&gt;&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Dɩmʋŋ dʋɔ wɩɛ ŋii ɩ tawɩ na di seriya baŋ amɩɛ tɩŋtɩŋ sɛ ɩ yɩɛ baa ba kʋ Ɩsʋɔ bajana baa ganana bie na bɛ. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />N kpaŋ amɩɛ duluŋ nafara na ɩ kʋ bakpa takɩɛ ganaŋkʋ ba yɩɛ na.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Amɩɛ dʋmɩɛ! Amɩɛ baa ɩ kɩɛna takɩɛ dʋmɩɛ sɔrɛtina. Sɩnɛ sɛ ɩ dɩlɛ se lɩɩ dɩpʋɛ gaa baa fuu amɩɛ mʋ ju awʋrʋfʋɔ bʋala naŋ naa? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Dɩmʋŋ dʋɔ maa kpiri bajana, wɩɛ jimɩra na mbara bakalaasa amɩɛ jaŋ. Ɩ kʋ ba tɩba barɛ na ɩ jɔ barɛ daŋ gasagasa dʋɔ, barɛ dʋɔ ɩ taɩ ba amɩɛ tʋm danɩŋ naŋ na ɩ pala dɩɛsɛ-dɩɛsɛ dʋɔ gɩŋ ba. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Dɩmʋŋ dʋɔ, Ɩsʋɔ aja fɔŋɩ amɩɛ dɩla bachirigisa kpiniŋ baa ɩ kʋ ba tibi gana dʋɔ lɩɩ wʋchirigisa Abeli dʋɔ ga tala Sakariya wʋŋ wʋjuo n nyina Barakiya na dʋɔ, wʋŋ ɩ kʋ ɩ Ɩsʋɔ tʋm danɛ na gadiesa dɩgbɩŋgbɩŋ tɩtɩba na. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Maa tawɩ sɛ n nyii na dieli sɛ dɩla fɔŋɩwʋ ŋina kpiniŋ aja kɔŋ dɩmʋŋ gɩnanaŋ gana dʋɔ.<verse eid="MAT 23:36" /></para>
  <para style="s1">Yesu wɩɩ fa Yerusalem</para>
  <para style="r">
    <ref loc="LUK 13:34-35">Luka 13:34-35</ref></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;O Yerusalemtina, Yerusalemtina! Amɩɛ baa ɩ kʋ Ɩsʋɔ bajana sɛ ɩ lɔ baa Ɩsʋɔ kpiri ba amɩɛ jaŋ na bʋɛ. Maa ja sɛ maa sila amɩɛ na maa gie amɩɛ takɩɛ ganaŋkʋ dijim naa a sila wʋbie wʋ baŋasɛ naŋ sɛ wʋ a gie ba na. Ama ɩŋ kpa a. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />N nyii, Ɩsʋɔ aja lɩsɛ wʋ asa lɩɩ amɩɛ dɩɛ janɛ dʋɔ na gaa yɩɛ dɩtakpaŋ. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Maa tawɩ amɩɛ sɛ ɩɩ ti na maŋ ŋ ga tala saŋa gaa ɩ tawɩ sɛ, &lt;Kusee n nyina wʋŋ wʋ a kɔŋ Kpaŋjuo yɩrɩɛ naŋ na.&gt;<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Num 118:26</ref>.</char></note>&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Yesu tawɩ Ɩsʋɔ tʋm danɛ warɩɛwʋ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 13:1-2">Maakɩ 13:1-2</ref>; <ref loc="LUK 21:5-6">Luka 21:5-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Gʋ Yesu a lɩɩ Ɩsʋɔ tʋm danɛ gaa naŋ na, wʋ kpalɛnara baa kɔŋ wʋ jaŋ gaa tawɩ ɩ sɛ wʋ n kɩɛ ganaŋkʋ Ɩsʋɔ tʋm danɩŋ ŋii kɩɛna na. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Naa ɩ na ŋina kpiniŋ yaa? Maa tawɩ sɛ n nyii na dieli sɛ bʋɩ garɛ baa ti jaga ga dʋɔ-dʋɔ ɔ. Baa salɩɛ ŋɩ kpiniŋ.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s1">Awʋrʋfʋɔ na ganyala dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 13:3-13">Maakɩ 13:3-13</ref>; <ref loc="LUK 21:7-19">Luka 21:7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Gʋ Yesu chaɩ Olifi dasɛ bʋrɔŋ gaa dʋɔ na, wʋ kpalɛnara baa kɔŋ wʋ nyiŋeŋ jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Tawɩ daa, saŋa gamʋɔ sɛ ŋina aja tibi? Sɛ be aaŋ ja yɩɛ daasɛ gaa gaa kalaa sɛ nya bɔrɛ kɔŋ na dulunya dɩtamtɩŋ talɛ?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;N kɩɛ amɩɛ wʋsɛ dʋɔ na dieli, na wʋrʋ n baa pɩna amɩɛ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Akala takɩɛ bakpa fɔɩ aja kɔŋ ma yɩrɛ naŋ na baa gaa tawɩ sɛ baa n nyina Kirisito wʋŋ na baa pɩna bakpa fɔɩ.&gt;&gt; <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ɩ nyii yuo gaa ga tirina amɩɛ na yuo gaa ga wɩɛ taŋasɛ wɩɛ na, n baa yela na amɩɛ agela a kʋlʋ. Akala takɩɛ ŋɩ tiri gʋ ŋina a tibi, ama ŋii kalaa sɛ dulunya dɩtamtɩŋ talɛ ɛ. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Dɩɛsɛ aja yuo dɩɛsɛ na juori a yuo juori. Dusoŋ ŋii ŋɩ nʋɔ wɩɛ doŋ aja kɔŋ na tibi a jigisi akpie dʋɔ-akpie dʋɔ. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ŋina kpiniŋ kɩɛna bɛ takɩɛ dʋŋɩwʋ ŋii ŋɩ dɔŋ asanaŋ pɔɩ na alʋ a lʋrʋ na.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Saŋa gana naŋ, baa lɩsɛ amɩɛ fa na baa nyala amɩɛ na baa kʋ amɩɛ. Ma dʋɔ, bakpa kpiniŋ aja kɔla amɩɛ. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Saŋa gana naŋ, bakpa fɔɩ aaŋ ja yela ba lɩɛdi naŋ na baa lɩsɛ dɔŋa fa na baa kɔla dɔŋa. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Akarɩɛ bajana fɔɩ aja kɔŋ gaa pɩna bakpa fɔɩ. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Wɩɛ asʋbʋɛ fɔɩ dʋɔ, bakpa fɔɩ baa dɩlɛ ja ba dɔŋa a. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ama wʋŋ wʋ a sɩŋ na doŋ ga tala dɩtamtɩŋ na, wʋ a yu nkpa. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Baa tawɩ Ɩsʋɔ juori gaa wɩɛ abama ŋii fa atawɩ yɩrɩ kpiniŋ pɔɩ na dulunya dɩtamtɩŋ a tala.<verse eid="MAT 24:14" /></para>
  <para style="s1">Akɔlɛsa ŋii ŋɩ wɩɛ Ɩsʋɔ tʋm danɛ naŋ</para>
  <para style="r">
    <ref loc="MRK 13:14-23">Maakɩ 13:14-23</ref>; <ref loc="LUK 21:20-24">Luka 21:20-24</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Sɛ Yesu ti ju dʋɔ tawɩ sɛ, &lt;&lt;Dɩ kɔŋ sɛ ɩ na akɔlɛsa<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref>.</char></note> ŋii ŋii yɩɛ Ɩsʋɔ tʋm danɛ gaa iniesi ŋii Ɩsʋɔ pala na ɔja Daniyeli dʋɔ tawɩ na, n yela na wʋkʋma wʋŋ wʋ a karaŋ dɩmʋŋ wɩɛ ŋina na a nyii tie.&gt;&gt; <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />N yela baa ba wɩɛ Yudiya tibi dʋɔ na a se ju bʋrɔŋsɛ dʋɔ. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />N yela na wʋŋ wʋ wɩɛ danɛ adugbe na, n baa tibi jʋʋ danɛ naŋ ga mʋ bʋrʋ. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />N yela na wʋŋ wʋ wɩɛ fʋɔnaŋ na, n baa yɩɛ wʋ nfɩɛrɛ sɛ wʋ a ti bɔrɛ kɔŋ dɩɛ gaa mʋ wʋ adugbe gagba. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Dɩmʋŋ wɩɛ ŋina naŋ na, filietina na alʋsɔna, baa lakʋ. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />N jɔ dɩga na amɩɛ sebisi n baa tibi gbaŋgbaŋ saŋa yaa Fɩɛsɛ wɩɩ. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Akala takɩɛ dɩmʋŋ saŋa gana naŋ na, wʋkpa wʋsɛ aja chaŋ ɩ na dieli kii ŋii ŋɩ tibi lɩɩ dulunya dɩfaratɩŋ gaa tala jaŋ, sɛ ŋɩ ŋarɛ baa ti tibi i. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Sɛ Ɩsʋɔ n kɔgɩ gɩyɩɛnɩŋ ŋina dʋɔ na, dɩmʋŋ bɩrɛ, nafʋɔ wʋrʋ baa yu nkpa a. Ama baa wʋ lɩsɛ ba na dʋɔ, wʋ a kɔgɩ gɩyɩɛnɩŋ ŋii dʋɔ. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Dɩmʋŋ saŋa gana naŋ na, sɛ wʋrʋ tawɩ amɩɛ sɛ, &lt;&lt;N kɩɛ, Kirisito wʋŋ mɩnaŋ yaa wʋŋ n wɩɛna dɩmaŋ na, n baa lɩɛ di.&gt;&gt; <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Akala takɩɛ barɛ baa baa yɩɛ akarɩɛ sɛ ba yɩɛ Kirisito na akarɩɛ bajana aja kɔŋ gaa yɩɛ daasɛ ajanɩɛ na adaŋgana na baa mʋ pɩna baa Ɩsʋɔ lɩsɛ ba na gba. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />N nyii, ma chɩŋkpɩɛ tawɩ amɩɛ pɔɩ na saŋa gana a tala.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Dɩmʋŋ dʋɔ sɛ wʋrʋ tawɩ amɩɛ sɛ, &lt;N kɩɛ, Kirisito wʋŋ wɩɛ ifuli dʋɔ na,&gt; n baa &lt;ju dɩmaŋ ga kɩɛ,&gt; yaa &lt;wʋŋ n wɩɛna danɛ naŋ jɩna na,&gt; n baa lɩɛ di. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Akala takɩɛ ganaŋkʋ duoni ŋmaŋi a charɩɛ lɩɩ dɩlɩɩtɩŋ mʋ ju dɩsalɩtɩŋ na bakpa a na ŋɛ na, dɩmʋŋ sɛ Wʋkpa Bu wʋŋ bɔrɛ kɔŋ aja yɩɛ. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Diele gaa atatɛ wɩɛ na, dɩmaŋ sɛ ajɩsaŋ asila.&gt;&gt;<verse eid="MAT 24:28" /></para>
  <para style="s1">Wʋkpa Bu wʋŋ aja bɔrɛ kɔŋ</para>
  <para style="r">
    <ref loc="MRK 13:24-27">Maakɩ 13:24-27</ref>; <ref loc="LUK 21:25-28">Luka 21:25-28</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Sɛ Yesu ju dʋɔ tawɩ sɛ dɩmʋŋ saŋa gana naŋ, wʋkpa wʋsɛ chaŋ wʋrʋgbɩɛ na,</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt;wiita baa lɩɩ ɩ,</para>
  <para style="q2" vid="MAT 24:29">sɛ gafita baa fʋlʋŋsɛ ɛ.</para>
  <para style="q1" vid="MAT 24:29">Achikpebi aja kuli lɩɩ Ɩsʋɔ adugbe gaa sala,</para>
  <para style="q2" vid="MAT 24:29">na adugbe abʋrɩ kpiniŋ ajigisi.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Yis 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>.</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt;Dɩmʋŋ saŋa gana naŋ na, bakpa aja na daasɛ Ɩsʋɔ tanɛ naŋ ŋii ŋii kalaa sɛ Wʋkpa Bu wʋŋ a kɔnɛ, na atawɩ yɩrɩ kpiniŋ aja bɔtaa. Baa na Wʋkpa Bu wʋŋ a kɔnɛ na doŋ na jilima janɛ lɩɩ Ɩsʋɔ tanɩɛ naŋ. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Wʋ a kpiri wʋ gabʋɔsɛ tibi dʋɔ na baa fʋlʋ dɩgaŋtaŋ na doŋ na baa sila baa wʋ lɩsɛ dulunya naŋ gapɩlɛkʋma na gaa jaŋi.&gt;&gt;<verse eid="MAT 24:31" /></para>
  <para style="s1">Kpalɩɛna lɩɩ figi daŋ gaa dʋɔ</para>
  <para style="r">
    <ref loc="MRK 13:28-31">Maakɩ 13:28-31</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Sɛ Yesu jɔ ba diduu sɛ, &lt;&lt;N kɩɛ figi daŋ na ɩ kpalɩɛna bʋrʋ garɛ. Ga pɔrɔgɩ na, n jiŋ gʋ awuluŋ tirina. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Dɩmʋŋ gba sɛ ɩ na ŋina kpiniŋ tibi na, n jiŋ gʋ Wʋkpa Bu wʋŋ bɔrɛ kɔŋ tirina, wʋ wɩɛ buonɔ. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Maa tawɩ sɛ n nyii na dieli sɛ gɩnanaŋ gana baa laŋ ŋ ga tala saŋa gaa ŋina kpiniŋ aja tibi. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Ɩsʋɔ adugbe na tie aja laŋ, ama ma wɩɛ bɩrɛ, ŋii laŋ ŋ.&gt;&gt;<verse eid="MAT 24:35" /></para>
  <para style="s1">Wʋrʋ ba jiŋ wɩɩ na saŋa gaa Yesu aja bɔrɛ kɔŋ ŋ</para>
  <para style="r">
    <ref loc="MRK 13:32-37">Maakɩ 13:32-37</ref>; <ref loc="LUK 17:26-30">Luka 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Sɛ Yesu ju dʋɔ tawɩ sɛ, &lt;&lt;Wʋrʋ ba jiŋ wɩɩ gaa yaa saŋa gaa a. Ɩsʋɔ gabʋɔsɛ baa ba wɩɛ Ɩsʋɔ adugbe yaa Bu wʋŋ gba ba jiŋ ŋ, amʋɔ Juo wʋŋ nyiŋeŋ. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Ganaŋkʋ dɩ cha yɩɛ Nowa saŋa na, dɩmʋŋ sɛ Wʋkpa Bu wʋŋ bɔrɛ kɔŋ aja yɩɛ. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Akala takɩɛ wɩɛ ŋina naŋ pɔɩ na lɩŋ a su walɛ mʋ dulunya na, bakpa cha baa di baa nyʋɔ yela baa fa sarɛ ga tala wɩɩ gaa Nowa jʋʋ buori janɛ gaa naŋ. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Na ba cha ba ba jiŋ sɛ bʋrʋ garɛ aja tibi ba dʋɔ ɔ, mʋ ga tala gʋ lɩŋ su walɛ mʋ ba kpiniŋ laŋ. Dɩmʋŋ sɛ aja yɩɛ Wʋkpa Bu wʋŋ bɔrɛ kɔŋ naŋ. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Baala bala aja wɩɛ fʋɔnaŋ, baa mʋ wʋrʋ na baa yela wʋrʋ. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Ala bala aja naŋ gamɩsɛ bʋɩ garɛ dʋɔ, baa mʋ wʋrʋ na baa yela wʋrʋ.&gt;&gt;<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Dɩmʋŋ dʋɔ, n duo amɩɛ wʋsɛ dʋɔ, akala takɩɛ ɩ ba jiŋ wɩɩ gaa amɩɛ kpaŋjuo aja bɔrɛ kɔŋ ŋ. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ama n nyii ŋina tie na dieli sɛ, nafʋɔ waatɛ jiŋ saŋa gaa ŋmɩɛlɛ aja kɔŋ yuluma na, nafʋɔ wʋ a gie wʋ waa na wʋ n baa salɩɛ jʋʋ. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Dɩmʋŋ dʋɔ amɩɛ gba ŋɩ tiri gʋ n desina amɩɛ wʋsɛ ɩ dana, akala takɩɛ Wʋkpa Bu wʋŋ aja kɔŋ saŋa gaa ɩ ba kɩɛna wʋ gbɩɛ ɛ.&gt;&gt;<verse eid="MAT 24:44" /></para>
  <para style="s1">Tʋmɩrɛ gasiŋteŋ-tɛ na wʋŋ wʋ aa di gasiŋteŋ ŋ</para>
  <para style="r">
    <ref loc="LUK 12:41-48">Luka 12:41-48</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Sɛ Yesu tawɩ sɛ, &lt;&lt;N Mmʋɔ n nyina tʋmɩrɛ gasiŋteŋ-tɛ na tʋmɩrɛ wɩɛ jɩmɩrɛ? Wʋŋ n nyina wʋŋ wʋ kpaŋjuo yela sɛ wʋ a kɩɛ wʋ tʋmɩra ba baŋbaŋ wʋ waa dʋɔ sɛ wʋ a fa ba adiya saŋa bam naŋ. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Asadi n nyina tʋmɩrɛ wʋŋ wʋ kpaŋjuo aja bɔrɛ kɔŋ gaa mɩɛna ɩ yela wʋ a tʋm wʋ dɩtʋm ga gbɩɛ dʋɔ. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Maa tawɩ sɛ n nyii na dieli sɛ kpaŋjuo wʋŋ aja mʋ wʋ akpaŋta kpiniŋ dʋ wʋ pamɩɛ naŋ sɛ wʋ n kɩɛ dʋɔ. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ama dɩ n mʋ takɩɛ tʋmɩrɛ nyinaŋ doŋ-tɛ wʋŋ tawɩ wʋ nyinaŋ sɛ, &lt;Ma kpaŋjuo aja taŋgɩlɛ pɔɩ na wʋ a kɔŋ,&gt; <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />sɛ wʋ fara wʋ a tugu wʋ dɔŋa tʋmɩra baa, wʋ a di yela wʋ na sʋlʋŋ nyʋɔra baa nyʋɔ. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Dɩmʋŋ tʋmɩrɛ wina wʋ kpaŋjuo wʋŋ aja wʋ a purugi ɩ wɩɩ gaa wʋ aa kɩɛ wʋ gbɩɛ na saŋa gaa wʋ ba jiŋ ŋ. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Wʋ a fɔŋɩ wʋ dɩlɛ na dieli na wʋ a mʋ ɩ kpi aluguusitina dʋɔ, diele gaa wiiniŋ na kela naŋ tawʋ wɩɛ na.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Galibie gifi barɛ dʋɔ diduu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Sɛ Yesu ti jɔ diduu sɛ saŋa gana naŋ na, Ɩsʋɔ Juori gaa aja kɩɛna bɛ takɩɛ gʋ ala gifi barɛ baa ba ba jiŋ baalɛ na mʋ ba fitila aba lɩɩ baa ga jaŋina alʋfɔlɛ baalɛ. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ba tɩba ba nʋŋ yɩɛ bamalaŋpʋna sɛ ba nʋŋ dʋɔ yɩɛ wɩɛ jimɩra. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Bamalaŋpʋna baa mʋ ba fitila aba, ama ba n mʋ nuŋ chaŋ kpi i. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ama wɩɛ jimɩra baa bɩrɛ mʋ ba fitila aba na nuŋ sapɩɛ bie naŋ chaŋ kpi. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Gʋ alʋfɔlɛ baalɛ n kɔŋ bileŋ na, asoroŋ chaŋ ba sɛ ba duo.&gt;&gt;<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;Gʋ dɩ tala tɩɛtɩtɩba na, wʋrʋ kuusi tawɩ sɛ alʋfɔlɛ baalɛ wʋŋ a kɔnɛ, n kʋlʋ ga jaŋina ɩ!&gt;&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Sɛ ala gifi baa ba ba jiŋ baalɛ na kpiniŋ feŋ kʋlʋ jiŋna ba fitila aba. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Sɛ bamalaŋpʋna baa tawɩ wɩɛ jimɩra baa sɛ, &lt;&lt;N fa daa amɩɛ nuŋ ŋii ŋarɛ. Akala takɩɛ daa fitila aba aja ŋii duŋ.&gt;&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Sɛ wɩɛ jimɩra baa lɩsɛ ba nʋɔ sɛ, &lt;&lt;Aye, daa teri n bɔla ŋii tala daa na amɩɛ ɛ. N ju baa baa yaa nuŋ na jaŋ na ɩ lɩɛ ŋarɛ.&gt;&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />Gʋ baa ju na baa ga lɩɛ nuŋ na, sɛ alʋfɔlɛ baalɛ wʋŋ gaa talɛ. Sɛ wʋ na ala baa ba ba jiŋ baalɛ sɛ ba kʋla ba wʋsɛ ba dana ɩ na, jʋʋ waa gaa baa di sarɛ asadi adiya na naŋ. Sɛ ba chaŋ bʋɔlɛ tɔ.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Wʋrʋgbɩɛ na, bamalaŋpʋna baa kɔŋ gaa jɔ bʋɔlɛ tawɩ sɛ, &lt;&lt;Kpaŋjuo, kpaŋjuo, tʋlʋ daa.&gt;&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Ama alʋfɔlɛ baalɛ wʋŋ lɩsɛ ba nʋɔ sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli takɩɛ ma ba jiŋ amɩɛ ɛ.&gt;&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />&lt;&lt;Dɩmʋŋ dʋɔ n kɩɛ amɩɛ wʋsɛ dʋɔ na dieli, akala takɩɛ ɩ ba jiŋ wɩɩ gaa yaa saŋa gaa ŋii kɔŋ na a.&gt;&gt;<verse eid="MAT 25:13" /></para>
  <para style="s1">Tʋmɩra batoro barɛ dʋɔ diduu</para>
  <para style="r">
    <ref loc="LUK 19:11-27">Luka 19:11-27</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Sɛ Yesu ti jɔ diduu sɛ, &lt;&lt;Ɩsʋɔ juori gaa kɩɛna bɛ takɩɛ gʋ baalɛ wʋrʋ kuli gbɩɛ ju dɩɛ garɛ dʋɔ. Sɛ wʋ yagɛ wʋ tʋmɩra gaa jaŋi wʋ jaŋ, sɛ wʋ mʋ wʋ akpaŋta dʋ ba pamɩɛ naŋ sɛ ba n kɩɛ dʋɔ. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Wʋ fa wʋrʋ diterembi talɛntɩ anʋŋ, wʋrʋ diterembi talɛntɩ ala, sɛ wʋrʋ dʋɔ diterembi talɛntɩ garɛ. Ganaŋkʋ wʋkʋma aja dɩlɛ yɩɛ bʋrʋ garɛ. Wʋrʋgbɩɛ na sɛ wʋ kuli gbɩɛ. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Sɛ baalɛ wʋŋ wʋ yu diterembi talɛntɩ anʋŋ na laŋ gabʋanaŋ mʋ wʋ aterembie ga dɩ yawʋ sɛ wʋ yu diterembi talɛntɩ anʋŋ kpi. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Dɩmʋŋ sɛ wʋŋ wʋ yu diterembi talɛntɩ ala na gba yu diterembi talɛntɩ ala kpi. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ama baalɛ wʋŋ wʋ yu diterembi talɛntɩ garɛ na bɩrɛ, wʋ ju ga wuru bʋɔ sɛ wʋ mʋ wʋ kpaŋjuo aterembie ŋii ga wuu.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt;Gʋ dɩ taŋgɩlɛ na, tʋmɩra baa kpaŋjuo wʋŋ bɔrɛ kɔŋ. Sɛ wʋ yagɛ ba sɛ ba n gaa kalaa ɩ wʋ aterembie nʋɔ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Sɛ wʋŋ wʋ yu diterembi talɛntɩ anʋŋ na mʋ diterembi talɛntɩ anʋŋ ŋii wʋ yu kpi na kɔŋ, sɛ wʋ tawɩ sɛ Kpaŋjuo, nya fa maŋ diterembi talɛntɩ anʋŋ bɛ. Kɩɛ, ma yu diterembi talɛntɩ anʋŋ kpi ŋɩ dʋɔ.&gt;&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />&lt;&lt;Sɛ wʋ Kpaŋjuo wʋŋ tawɩ ɩ sɛ ma tʋmɩrɛ wʋbam wʋŋ wʋ a di gasiŋteŋ! N sa na dɩtʋm. Nya di gasiŋteŋ abʋrɩ pii ŋina dʋɔ, maa yela na nyaa kɩɛ abʋrɩ fɔɩ dʋɔ. Kɔŋ ma asadi adiya di tie na maŋ na nyaŋ dɩɩ lɩɛ daa asa.&gt;&gt;<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />&lt;&lt;Sɛ wʋŋ wʋ yu diterembi talɛntɩ ala na gba kɔŋ gaa tawɩ sɛ Kpaŋjuo, nya fa maŋ diterembi talɛntɩ ala bɛ. Kɩɛ, ma yu diterembi talɛntɩ ala kpi ŋɩ dʋɔ.&gt;&gt;<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />Sɛ wʋ Kpaŋjuo wʋŋ tawɩ ɩ sɛ, &lt;&lt;Ma tʋmɩrɛ wʋbam wʋŋ wʋ a di gasiŋteŋ! N sa na dɩtʋm. Nya di gasiŋteŋ abʋrɩ pii ŋina dʋɔ, maa yela na nyaa kɩɛ abʋrɩ fɔɩ dʋɔ. Kɔŋ ma asadi adiya di tie na maŋ na nyaŋ dɩɩ lɩɛ daa asa.&gt;&gt;<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Sɛ wʋŋ wʋ yu diterembi talɛntɩ garɛ kɔŋ gaa tawɩ sɛ, &lt;&lt;Kpaŋjuo, ma jiŋ gʋ n wɩɛ wɩɛ doŋ. Nyaa kara diele gaa nya n duu u, sɛ nyaa kʋla diele gaa nya n ŋmati bie ɩ. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Maa se nyaŋ dʋɔ ma ga wuru bʋɔ sɛ ma mʋ nya talɛntɩ ga wuu. Kɩɛ, nya diterembi talɛntɩ mɩnaŋ.<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />&lt;&lt;Sɛ wʋ kpaŋjuo wʋŋ lɩsɛ nʋɔ sɛ nyaŋ tʋmɩrɛ sʋbʋ wʋlʋjɔtɛ! N jiŋ gʋ maa kara diele gaa ma n du u, sɛ maa kʋla diele gaa ma n ŋmati bie ɩ. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Dɩmʋŋ bɩrɛ nafʋɔ nya mʋ ma aterembie ŋii ga dʋ aterembie disiitiŋ ganaŋkʋ maa bɔrɛ kɔŋ na maa lɩɛ ŋɩ na ŋɩ tɔnʋɔ.&gt;&gt;<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />&lt;&lt;N lɩɛ diterembi talɛntɩ gaa lɩɩ wʋ jaŋ na ɩ mʋ kpi wʋŋ wʋ wɩɛna diterembi talɛntɩ gifi na dʋɔ. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Akala takɩɛ wʋkʋma wʋŋ wʋ wɩɛna bʋrʋ garɛ na, Ɩsʋɔ aja mʋ ŋarɛ kpi wʋ dʋɔ na wʋ a yu fɔɩ. Ama wʋkʋma wʋŋ wʋ tana na, pii ŋii wʋ wɩɛna na, Ɩsʋɔ aja lɩɛ lɩɩ wʋ jaŋ. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Tʋmɩrɛ kpakpuo wʋŋ bɩrɛ, n lɔ ɩ tʋsʋ asʋŋ mʋ ga dʋ giteŋteŋbiri naŋ. Diele gaa wiiniŋ na kela naŋ tawʋ wɩɛ.&gt;&gt;<verse eid="MAT 25:30" /></para>
  <para style="s1">Dɩtamtɩŋ dɩpʋɛ fuu</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Sɛ Yesu ti tawɩ sɛ, &lt;&lt;Saŋa gaa Wʋkpa Bu wʋŋ aja bɔrɛ kɔŋ wʋ jilima naŋ yela Ɩsʋɔ gabʋɔsɛ kpiniŋ kpi wʋ dʋɔ na, wʋ a cha wʋ jilima juorigbeli dʋɔ adugbe. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Atawɩ yɩrɩ kpiniŋ aja sila wʋ jaŋ, na wʋ a kpara ba tɩba takɩɛ ganaŋkʋ feŋ kparɛ a kpara feŋ na ajalasɛ tɩba na. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Wʋ a mʋ feŋ si wʋ jɩsaŋ dʋɔ na wʋ a mʋ ajalasɛ si wʋ naŋbii dʋɔ.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt;Dɩmaŋ sɛ juo wʋŋ aja wʋ a tawɩ baa ba wɩɛ wʋ pam jɩsaŋ dʋɔ na sɛ n kɔŋ, amɩɛ baa Majuo yɩɛ amɩɛ kusee. N kɔŋ na ɩ gaa di Ɩsʋɔ juori gaa wʋ desina si fa amɩɛ lɩɩ naŋ dulunya dɩfaratɩŋ. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Akala takɩɛ gʋ dusoŋ chamɩna maŋ na, ɩ fa maŋ adiya sɛ ma di, nyʋɔlɛ chamɩna maŋ na, ɩ fa maŋ lɩŋ sɛ ma nyʋɔ, ma yɩɛ mʋɔrɛ na sɛ ɩ lɩɛ maŋ amɩɛ waasɛ dʋɔ. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Gʋ maa ja abʋrɩ afuusa na, ɩ fa maŋ, ma kili na, ɩ kɩɛ ma dʋɔ, ma wɩɛ danɛ dɩtʋɔtɩŋ na sɛ ɩ gaa kɩɛ maŋ.&gt;&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Dɩmaŋ sɛ bachirigisa aja lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Kpaŋjuo, be wɩɩ sɛ dɩ na nyaŋ gʋ dusoŋ a kʋ nyaŋ sɛ dɩ fa nyaŋ adiya yaa nyʋɔlɛ a kʋ nyaŋ sɛ dɩ fa nyaŋ lɩŋ sɛ n nyʋɔ? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Be wɩɩ sɛ dɩ na nyaŋ gʋ nya yɩɛ mʋɔrɛ sɛ dɩ lɩɛ nyaŋ daa waasɛ dʋɔ yaa nyaa ja abʋrɩ afuusa sɛ dɩ fa nyaŋ? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Be wɩɩ sɛ dɩ na nyaŋ gʋ nyaa kili yaa nya wɩɛ danɛ dɩtʋɔtɩŋ sɛ dɩ gaa kɩɛ nyaŋ?&gt;&gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />Dɩmaŋ sɛ Juo wʋŋ aja lɩsɛ nʋɔ sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ bʋrʋkʋma gaa ɩ yɩɛ fa ma dɔŋa ba pii-pii bana tɩba wʋrʋ na, ɩ yɩɛ fa maŋ.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />&lt;&lt;Sɛ wʋ a tawɩ baa ba wɩɛ wʋ naŋbii dʋɔ na sɛ n lɩɩ ma jaŋ, amɩɛ baa Ɩsʋɔ tawɩ amɩɛ nʋɔsɛ. N pala ga jʋʋ awʋrʋfʋɔ bʋala gaa gaa dum na naŋ gaa Ɩsʋɔ desina si Sɩtanɩ na wʋ gabʋɔsɛ na. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Akala takɩɛ gʋ dusoŋ a kʋ maŋ na, ɩŋ fa maŋ adiya na maa di i, nyʋɔlɛ a kʋ maŋ na, ɩŋ fa maŋ lɩŋ na maa nyʋɔ ɔ. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ma yɩɛ mʋɔrɛ na, ɩŋ lɩɛ maŋ amɩɛ waasɛ dʋɔ ɔ, maa ja abʋrɩ afuusa na, ɩŋ fa maŋ ŋ, maa kili sɛ ma wɩɛ danɛ dɩtʋɔtɩŋ na, ɩŋ kɩɛ maŋ ŋ.&gt;&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Dɩmaŋ sɛ baa gba baa lɩsɛ nʋɔ sɛ, &lt;&lt;Kpaŋjuo, be wɩɩ sɛ dɩ na nyaŋ gʋ dusoŋ a kʋ nyaŋ yaa nyʋɔlɛ a kʋ nyaŋ yaa nya yɩɛ mʋɔrɛ yaa nyaa ja abʋrɩ afuusa yaa nyaa kili yaa nya wɩɛ danɛ dɩtʋɔtɩŋ sɛ dɩ n kɩɛ n dʋɔ?&gt;&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />Dɩmaŋ sɛ juo wʋŋ aja lɩsɛ ba nʋɔ sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ bʋrʋkʋma gaa ɩŋ yɩɛ fa ma nabie ba pii-pii bana tɩba wʋrʋ na, ɩŋ yɩɛ fa maŋ ŋ.&gt;&gt;<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />Dɩmaŋ sɛ &lt;&lt;wʋ a mʋ ba ju dɩlɛ fɔŋɩwʋ gakpaa naŋ ama bachirigisa baa bɩrɛ, wʋ a mʋ ba ju nkpa ŋii ŋɩ taŋ gɩtɛ na naŋ.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Ba jɔ dɩkɔŋ sɛ baa kʋ Yesu</para>
  <para style="r">
    <ref loc="MRK 14:1-2">Maakɩ 14:1-2</ref>; <ref loc="LUK 22:1-2">Luka 22:1-2</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Gʋ Yesu tawɩ wɩɛ ŋina kpiniŋ taŋ na, wʋ tawɩ wʋ kpalɛnara baa sɛ, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;takɩɛ ganaŋkʋ ɩ jiŋ na, ɩ jiŋ gʋ dɩ kakaa wɩɛ ala na Yudatina nyiŋi asadi adiya di a tala na. Baa lɩsɛ Wʋkpa Bu wʋŋ fa na baa jɔ ɩ daŋ gasagasa dʋɔ.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Saŋa gana naŋ na, Ɩsʋɔ sei bɩnɩɛ na dɩɛ bɩnɩɛ jaŋi Kayifasi wʋŋ wʋ yɩɛ Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ na juorigbɩɛ <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />sɛ ba jɔ dɩkɔŋ gaa baa mʋna dʋɔ wɩsɛ chaŋ Yesu na baa kʋ ɩ. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ama ba tawɩ sɛ, &lt;&lt;N baa yela dɩ chaŋ ɩ nyiŋi asadi adiya di ŋina naŋ, naa dɩmʋŋ na, ŋii kɔna siŋii dɩɛ naŋ.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s1">Alʋ wʋrʋ chɩɛgɩ nuŋ alifeŋsa wʋrʋgɩ Yesu nyinaŋ</para>
  <para style="r">
    <ref loc="MRK 14:3-9">Maakɩ 14:3-9</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Gʋ Yesu wɩɛ Batani Simoŋ wʋŋ wʋ cha kili gɩchalaŋa waa dʋɔ <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />wʋ a di na, alʋ wʋrʋ kɔŋ wʋ jaŋ wʋ chamɩna alabasita sapɩɛ bie garɛ yela naadɩ<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="ft" closed="false">Nuŋ alifeŋsa ŋina na naadɩ daŋ sɛ ba mʋ yɩɛ ŋɛ.</char></note> nuŋ alifeŋsa ŋii ŋɩ yawʋ wɩɛ doŋ wɩɛ ga tɩba sɛ wʋ chɩɛgɩ wʋrʋgɩ Yesu nyinaŋ.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Gʋ wʋ kpalɛnara baa na ŋina na sɛ ba kara biŋbira, sɛ ba tasɛ sɛ, &lt;&lt;Be n yɩɛ sɛ wʋ a warɩɛ nuŋ alifeŋsa ŋina? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Nafʋɔ baa dɩlɛ yaa nuŋ alifeŋsa ŋina na baa yu aterembie fɔɩ na baa mʋ fa ayɔŋtina.&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Gʋ Yesu jiŋ bʋrʋ gaa ba tawɩ na sɛ wʋ tasɛ ba sɛ, &lt;&lt;Be n yɩɛ sɛ ɩ nyala alʋ wina dɩmʋŋ? Wʋ yɩɛ bʋrʋ gabam fa maŋ bɛ. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ayɔŋtina bɩrɛ, ba wɩɛ amɩɛ jaŋ saŋa kʋma. Ama maŋ bɩrɛ, ma taŋ amɩɛ jaŋ saŋ kʋma a. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Wʋ chɩɛgɩ nuŋ alifeŋsa ŋii wʋrʋgɩ ma wʋsɛ mʋ desina maŋ si daa ma wuu bɛ. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Maa tawɩ sɛ n nyii na dieli sɛ dulunya naŋ gapɩlɛkʋma gaa baa tawɩ Ɩsʋɔ wɩɛ abama ŋii na, baa tawɩ ŋii alʋ wʋŋ yɩɛ na mʋ nyiŋi ɩ.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s1">Yudasi kpa gʋ wʋ a lɩsɛ Yesu fa</para>
  <para style="r">
    <ref loc="MRK 14:10-11">Maakɩ 14:10-11</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Sɛ Yudasi Isikariyoti, wʋŋ wʋ yɩɛ kpirida gifi bala baa tɩba wʋrʋ na ju Ɩsʋɔ sei bɩnɩɛ jaŋ <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ga tasɛ ba sɛ, &lt;&lt;Sɛ ma lɩsɛ Yesu fa amɩɛ na, be sɛ ɩɩ fa maŋ?&gt;&gt; Sɛ ba kala diterembi fʋlʋm bie nkuo na sala fa ɩ. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Lɩɩ dɩmʋŋ saŋa gana mʋ a ju na, Yudasi fara wʋ a ja gbɩɛ gaa wʋ a mʋna dʋɔ lɩsɛ Yesu fa ba.<verse eid="MAT 26:16" /></para>
  <para style="s1">Yesu na wʋ kpalɛnara di nyiŋi di wɩɩ adiya</para>
  <para style="r">
    <ref loc="MRK 14:12-21">Maakɩ 14:12-21</ref>; <ref loc="LUK 22:7-23">Luka 22:7-23</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Wɩɩ gaa ga doŋ asanaŋ fa Bodobodo gaa ga Tana Yiisi Asadi Adiya di talɛ na, Yesu kpalɛnara baa kɔŋ wʋ jaŋ gaa tasɛ ɩ sɛ, &lt;&lt;Le sɛ nyaa ja sɛ dɩ ju ga desina fa nyaŋ na nyaa ga di nyiŋi asadi adiya di adiya?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Ba n ju baalɛ wʋrʋ jaŋ dɩɛ janɛ gaa naŋ ga tawɩ ɩ sɛ, wʋkalaasa wʋŋ sɛ, ma saŋa tirina gʋ maŋ na ma kpalɛnara dɩ di nyiŋi asadi adiya di adiya ŋii n waa dʋɔ.&gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Dɩmʋŋ dʋɔ wʋ kpalɛnara baa yɩɛ ganaŋkʋ Yesu tawɩ ba na. Sɛ ba yɩɛ nyiŋi asadi adiya di adiya ŋii dɩmaŋ.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Gʋ bʋyanɔ talɛ na, Yesu na wʋ kpirida gifi bala baa chaɩ baa di adiya. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Gʋ baa di na, sɛ wʋ tawɩ ba sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ amɩɛ tɩba wʋrʋ aja lɩsɛ maŋ fa.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Sɛ kpalɛnara baa bɔtaa fɔɩ, sɛ ba fara baa tasɛ dɔŋa garɛ-garɛ sɛ, &lt;&lt;Kpaŋjuo, maŋ bɛ yaa?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Sɛ Yesu lɩsɛ ba nʋɔ sɛ, &lt;&lt;Wʋŋ maŋ na ɩ dɩɩ di nyɩna garɛ naŋ na aaŋ ja wʋ a lɩsɛ maŋ fa. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Wʋkpa Bu wʋŋ aja sɩŋ ganaŋkʋ ba sabɩɛ wʋ wʋsɛ dʋɔ wɩɛ Ɩsʋɔ Wɩɛ naŋ na. Ama wʋkpa wʋŋ wʋ a lɩsɛ Wʋkpa Bu wʋŋ fa na, wʋŋ lakʋ! Nafʋɔ ba n lʋrʋ ɩ gba bɔ.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Sɛ Yudasi wʋŋ wʋ a lɩsɛ Yesu fa na gba tasɛ ɩ sɛ, &lt;&lt;Wʋkalaasa, maŋ bɛ yaa?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Ɛɛŋ, nyaŋ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">26:25 </char><char style="ft" closed="false">Ŋii sɛ nyaŋ tɩŋtɩŋ nyaa tawɩ na</char></note><verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Gʋ Yesu na wʋ kpalɛnara baa a di na, wʋ mʋ bodobodo sɛ wʋ yɩlɩ Ɩsʋɔ sɛ wʋ jaɩ-jaɩ tɩba mʋ fa wʋ kpalɛnara baa tawɩ ba sɛ, &lt;&lt;Ma wʋsɛ mɩnaŋ, n lɩɛ di.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Sɛ wʋ mʋ gafie bie gaa wayɩŋ sʋlʋŋ wɩɛ tɩba sɛ wʋ yɩlɩ Ɩsʋɔ sɛ wʋ mʋ fa wʋ kpalɛnara baa tawɩ sɛ, &lt;&lt;Amɩɛ kpiniŋ n lɩɛ nyʋɔ fa dɔŋa. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Ma asima mɩnaŋ, ŋii n nyina dɩkɔŋ fɔlɛ gaa Ɩsʋɔ na bakpa jʋɔ ŋii ŋɩ chɩɛgɩ wʋrʋgɩ fa bakpa kpiniŋ na baa yu dɩsʋbʋ mʋ chɩɛ <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Maa tawɩ amɩɛ sɛ, maa ti nyʋɔ wayɩŋ sʋlʋŋ ŋina ŋarɛ ɛ, lɩɩ saŋa gana mʋ ga tala wɩɩ gaa maŋ na amɩɛ aja nyʋɔ ŋɩ afɔlɩɛ Majuo Juori naŋ.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Gʋ ba kpie numba yɩlɩ Ɩsʋɔ taŋ na, ba lɩɩ dɩmaŋ ju Olifi dasɛ bʋrɔŋ dʋɔ.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yesu tawɩ Petero pɩɛ dʋɔ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 14:27-31">Maakɩ 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Gʋ Yesu na wʋ kpalɛnara baa wɩɛ Olifi dasɛ bʋrɔŋ dʋɔ na, wʋ tawɩ ba sɛ ma dʋɔ, amɩɛ kpiniŋ ɩ puseŋ yela maŋ yuluma gana. Ganaŋkʋ ba sabɩɛ Ɩsʋɔ Wɩɛ naŋ sɛ, Ɩsʋɔ tawɩ sɛ,</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt;Maa kʋ feŋ kparɛ wʋŋ</para>
  <para style="q2" vid="MAT 26:31">na feŋ dikpeŋ gaa a puseŋ.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Sak 13:7</ref>.</char></note><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Ama ma feŋ lɩɩ sɩŋ naŋ wʋrʋgbɩɛ na, maa pala amɩɛ asanaŋ ju Galaliya.<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Sɛ Petero tawɩ Yesu sɛ, &lt;&lt;Sɛ ba kpiniŋ baa puseŋ yela nyaŋ na, maŋ bɩrɛ, maa yɩɛ dɩmʋŋ ŋ.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Sɛ Yesu tawɩ Petero sɛ, &lt;&lt;Maa tawɩ sɛ n nyii na dieli sɛ yuluma gana pɔɩ na dijimba akɔlɛ bʋla na, nyaa pɩɛ maŋ butoro sɛ n ba jiŋ maŋ ŋ.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Ama Petero tawɩ ɩ sɛ, &lt;&lt;Dɩkɔŋ sɛ maŋ na nyaŋ dɩɩ sɩŋ gba, maa tawɩ sɛ ma ba jiŋ nyaŋ ŋ.&gt;&gt; Dɩmʋŋ sɛ wʋ kpalɛnara baa ba kakaa na gba tawɩ.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu jɔ dɩga Gesemani</para>
  <para style="r">
    <ref loc="MRK 14:32-42">Maakɩ 14:32-42</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Sɛ Yesu na wʋ kpalɛnara ju diele gaa baa yagɛ sɛ Gesemani, sɛ wʋ tawɩ ba sɛ, &lt;&lt;N cha jɩna na maa ju gatʋŋgʋrʋ ga jɔ dɩga.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Sɛ Yesu mʋ Petero na Sebedi bie baala jaŋ bala baa kpaŋ wʋ wʋsɛ. Dɩmaŋ sɛ wʋ fara wʋ a bɔtaa sɛ wʋ jʋʋ gayɩyɩɛ. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;Bɔtaa gaa ga nʋɔ wɩɛ doŋ su ma digela gʋ ŋii dɩlɛ mʋ maŋ ju sɩŋ naŋ.&gt;&gt; N cha jɩna gie na maŋ na n baa duo.<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Gʋ Yesu ju wʋ asanaŋ chonii na, sɛ wʋ laŋ fu sɛ wʋ jɔ dɩga sɛ, &lt;&lt;Majuo, nafʋɔ aja yɩɛ dieli na, yela na awʋrʋfʋɔ ŋina a giligi maŋ. Ama naa ŋii maa jawʋ ʋ, ama ŋii nyaa jawʋ na.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Sɛ Yesu bɔrɛ kɔŋ wʋ kpalɛnara batoro baa jaŋ gaa na gʋ ba duo. Sɛ Yesu tasɛ Petero sɛ, &lt;&lt;Ɩŋ dɩlɛ cha gie na maŋ karafɩɛ darɛ yela ɩŋ duo? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />N gie na ɩ jɔ dɩga na n ba jʋʋ lɔ tɩba naŋ. Amɩɛ sʋbʋ a jawʋ, ama amɩɛ wʋsɛ bɩrɛ fʋʋ.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Sɛ Yesu bɔrɛ ju bʋlatɛ ga jɔ dɩga sɛ, &lt;&lt;Majuo, sɛ awʋrʋfʋɔ ŋina baa giligi maŋ ŋ, amʋɔ dɩ daga na maa na na, yela n jawʋ a yɩɛ.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Sɛ Yesu bɔrɛ kɔŋ gaa na gʋ wʋ kpalɛnara batoro baa duo akala takɩɛ asoroŋ a kʋ ba fɔɩ. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Sɛ Yesu lɩɩ ba jaŋ ju wʋ a ga jɔ dɩga butoro-tɛ sɛ wʋ tawɩ dɩtawɩ gadʋŋdʋlʋŋ gana.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Sɛ Yesu bɔrɛ kɔŋ wʋ kpalɛnara baa jaŋ, sɛ wʋ tawɩ ba sɛ, &lt;&lt;Ɩ saŋ ɩ duo yela ɩ fɩɛsɛ? N kɩɛ, saŋa gaa tirina, baa lɩsɛ Wʋkpa Bu wʋŋ dʋ dɩsʋbʋ yɩɛra pamɩɛ naŋ. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />N kʋlʋ na dɩ ju! N kɩɛ, wʋŋ wʋ a lɩsɛ maŋ fa na aaŋ kɔnɛ na!&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s1">Ba chaŋ Yesu</para>
  <para style="r">
    <ref loc="MRK 14:43-50">Maakɩ 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Gʋ Yesu saŋ wʋ a tawɩ wʋ a fa wʋ kpalɛnara baa na, Yudasi wʋŋ wʋ yɩɛ wʋ kpirida gifi bala baa tɩba wʋrʋ na, wʋ na jama baa ba kpamɩna ɩ ba chamɩna yuo dabɩlasɛ na akolie na kɔŋ dɩmaŋ. Na sei bɩnɩɛ na dɩɛ bɩnɩɛ n kpiri ba. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Sɛ Yudasi lɩsɛrɛ wʋŋ kalaa ba daasɛ sɛ, &lt;&lt;Wʋŋ maa puga ɩ na, na wʋŋ mɩnaŋ. N chaŋ ɩ.&gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Gabʋanaŋ sɛ Yudasi ju Yesu jaŋ sɛ wʋ tawɩ sɛ, &lt;&lt;Wʋkalaasa, maa yɩlɩ nyaŋ.&gt;&gt; Sɛ wʋ puga ɩ.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Ma dɩɛtɛ, yɩɛ ŋii n kɔŋ ŋɩ dʋɔ na.&gt;&gt;</para>
  <para style="p" vid="MAT 26:50">Dɩmaŋ sɛ bakpa baa lɩɩ gaa chaŋ ɩ na doŋ.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Kɩɛ, Yesu dɔŋa ba tɩba wʋrʋ lɩsɛ yuo dabɩla kara Ɩsʋɔ sei bɩnɩɛ naŋ bɩnɛ wʋŋ tʋmɩrɛ dɩlɛ lɩsɛ.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Sɛ Yesu tawɩ ɩ sɛ, &lt;&lt;Bɔsɩna n yuo dabɩla gaa dʋ ga furu naŋ. Akala takɩɛ wʋkʋma wʋŋ wʋ a lɩsɛ yuo dabɩla na, wʋ a sɩŋ yuo dabɩla nʋɔ. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />N ba jiŋ sɛ maa dɩlɛ yagɛ Majuo na wʋ a kpiri gabʋɔsɛ kɔrʋɔsɛ-kɔrʋɔsɛ dʋɔ gabʋanaŋ na baa gaa yuo fa maŋ? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ama sɛ dɩ kɔŋ dɩmʋŋ na, aja yɩɛ sɩnɛ na wɩɛ ŋii ba sabɩɛ Ɩsʋɔ Sabɩɛwɩɛ naŋ sɛ ŋɩ tiri gʋ ŋina a tibi na, a kɔŋ tɩba?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Dɩmʋŋ saŋa gana na, Yesu tasɛ jama baa sɛ, &lt;&lt;Ma yɩɛ ŋmɩɛlɛ wʋŋ wʋ chamɩna doŋ wʋ a lɩɛ bakpa abʋrɩ bɛ, sɛ ɩ mʋ yuo dabɩlasɛ na akolie ɩ kɔŋ ɩ chaŋ maŋ?&gt;&gt; Wɩɩ kʋma ma wɩɛ Ɩsʋɔ tʋm danɛ naŋ maa kalaa amɩɛ, ama ɩŋ chaŋ maŋ ŋ. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ama ŋina kpiniŋ tibi ganaŋkʋ Ɩsʋɔ bajana baa wɩɛ ŋii ba sabɩɛ Ɩsʋɔ Sabɩɛwɩɛ ŋii naŋ na, a kɔŋ tɩba. Sɛ wʋ kpalɛnara baa kpiniŋ puseŋ se yela ɩ.<verse eid="MAT 26:56" /></para>
  <para style="s1">Ba mʋ Yesu kɔŋ dɩɛ naŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ asanaŋ</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Sɛ bakpa baa ba chaŋ Yesu na mʋ ɩ ju Kayifasi wʋŋ wʋ yɩɛ sei bɩnɩɛ naŋ bɩnɛ na waa dʋɔ diele gaa mbara bakalaasa na dɩɛ bɩnɩɛ sila. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Na Petero cha wʋ kpamɩna Yesu nafarɛ-nafarɛ ga jʋʋ sei bɩnɩɛ naŋ bɩnɛ wʋŋ waa gaa naŋ. Sɛ wʋ cha kɩɛra baa jaŋ na wʋ a kɩɛ ŋii ŋii tibi na.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Sei bɩnɩɛ naŋ bɩnɩɛ na dɩɛ naŋ bɩnɩɛ naŋ bɩnɩɛ dikpeŋ baa kpiniŋ aja akarɩɛ seriya ŋii baa di mʋ sʋɔ Yesu na baa kʋ ɩ. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ama ba n yu u. Ŋɩ wɩɛ takɩɛ akarɩɛ seriyatina fɔɩ kɔŋ gaa yɩɛ akarɩɛ jaga wʋ dʋɔ. Wʋrʋgbɩɛ na, sɛ baala bala barɛ kʋlʋ sɩŋ <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />tawɩ sɛ, &lt;&lt;Baalɛ wina cha tawɩ sɛ maa dɩlɛ salɛ Ɩsʋɔ tʋm danɛ gaa, na maa mʋ wɩɛ atoro ma ga.&gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Sɛ sei bɩnɩɛ naŋ bɩnɛ wʋŋ kʋlʋ sɩŋ tasɛ Yesu sɛ, &lt;&lt;Seriya ŋii baa di baa chicha nyaŋ n na, nya tana ŋɩ nʋɔ lɩsɛ?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ama Yesu n tawɩ bʋrʋ ʋ. Sɛ sei bɩnɩɛ naŋ bɩnɛ wʋŋ tawɩ ɩ sɛ, &lt;&lt;Ka Ɩsʋɔ wʋkɩɛnasa wʋŋ ntaŋ, tawɩ daa sɛ nyaŋ n nyina Kirisito, Ɩsʋɔ Bu wʋŋ na.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Sɛ Yesu lɩsɛ nʋɔ sɛ, &lt;&lt;Ɛɛŋ, ŋii sɛ nya tawɩ na. Ama maa tawɩ amɩɛ kpiniŋ sɛ lɩɩ saŋa gana mʋ a ju, ɩ na Wʋkpa Bu wʋŋ wʋ chaɩ Ɩsʋɔ Doŋ-tɛ wʋŋ pam jɩsaŋ dʋɔ wʋ lɩɩ Ɩsʋɔ tanɩɛ naŋ wʋ a kɔnɛ.&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Sɛ sei bɩnɩɛ naŋ bɩnɛ wʋŋ chati wʋ gagba, sɛ wʋ tawɩ sɛ, &lt;&lt;Wʋ tawɩ mbusu wɩɛ baŋ Ɩsʋɔ. Be dʋɔ sɛ dɩ ti dɩ ja seriyatina barɛ? Dɩtɩɛna, ɩ nyii mbusu wɩɛ ŋii wʋ tawɩ na.&gt;&gt; <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Sɩnɛ n nyina amɩɛ nfɩɛrɛ?</para>
  <para style="p" vid="MAT 26:66">Sɛ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Wʋ daga sɩŋ.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Sɛ ba tɔ mɩtalɩŋ dʋ wʋ a asanaŋ sɛ ba jɔ ɩ dikuntunkuŋ, sɛ barɛ dʋɔ kpa ɩ gabasɛ. <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />Sɛ ba tawɩ ɩ sɛ, &lt;&lt;Sɛ nyaŋ nyina Kirisito wʋŋ na, gbala kalaa daa wʋŋ wʋ jɔ nyaŋ na.&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s1">Petero pɩɛ Yesu</para>
  <para style="r">
    <ref loc="MRK 14:66-72">Maakɩ 14:66-72</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Saŋa gana na, Petero chaɩ waa gaa naŋ, dɩmaŋ sɛ tʋmɩrɛ galibie wʋrʋ kɔŋ wʋ jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Nyaŋ gba nya kpi Yesu Galaliya wʋkpa wʋŋ dʋɔ.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ama Petero pɩɛ ŋɛ ba kpiniŋ ba asanaŋ sɛ, &lt;&lt;Ma ba jiŋ wɩɛ ŋii nyaa tawɩ na a.&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Sɛ Petero lɩɩ ju waa buonɔ, dɩmaŋ sɛ galibie wʋrʋ ti na ɩ, sɛ wʋ tawɩ fa baa ba wɩɛ dɩmaŋ na sɛ, &lt;&lt;Baalɛ wina kpi Yesu Nasarati wʋkpa wʋŋ dʋɔ.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Sɛ Petero ti bɔrɛ pɩɛ ka ntaŋ sɛ, &lt;&lt;Ma ba jiŋ baalɛ wina a!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Gʋ dɩ yɩɛ chonii na, baa ba sɩmɩɛɩ dɩmaŋ na kɔŋ Petero jaŋ gaa tawɩ ɩ sɛ, &lt;&lt;Gasiŋteŋ, nya yɩɛ ba tɩba wʋrʋ bɛ. Akala takɩɛ nya dɩtawɩ aaŋ kalaa.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Sɛ Petero fara wʋ a tawɩ wʋ wʋsɛ nʋɔsɛ sɛ wʋ ka ntaŋ sɛ, &lt;&lt;Ma ba jiŋ baalɛ wina a!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Gabʋanaŋ sɛ dijimba kɔlɛ. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Sɛ Petero nyiŋi wɩɛ ŋii Yesu tawɩ ɩ na sɛ, &lt;&lt;Pɔɩ na dijimba a kɔlɛ na, nyaa pɩɛ butoro sɛ n ba jiŋ maŋ ŋ.&gt;&gt; Sɛ Petero lɩɩ ju asʋŋ ga wii fɔɩ.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Ba mʋ Yesu ga sɩŋ Pilato asanaŋ</para>
  <para style="r">
    <ref loc="MRK 15:1">Maakɩ 15:1</ref>; <ref loc="LUK 23:1-2">Luka 23:1-2</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Gʋ tɩɛna nafo na, sei bɩnɩɛ na dɩɛ bɩnɩɛ baa kpiniŋ jɔ dɩkɔŋ sɛ baa kʋ Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Ba mʋ dɩgbaraŋgbaraŋ pɔgʋ ɩ sɛ ba mʋ ɩ ju ga fa Pilato, Roma bɩnɛ wʋŋ wʋ a kɩɛ Isirali tibi dʋɔ na.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Gʋ Yudasi wʋŋ wʋ lɩsɛ Yesu fa na, na gʋ ba fu Yesu dɩpʋɛ na, wʋ nu wʋ wʋsɛ sɛ wʋ bɔsɩna diterembi fʋlʋm bie nkuo na sala ŋii juna sei bɩnɩɛ na dɩɛ bɩnɩɛ baa. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Sɛ wʋ tawɩ sɛ, &lt;&lt;Ma yɩɛ dɩsʋbʋ takɩɛ gʋ ma lɩsɛ wʋŋ wʋ n yɩɛ dɩsʋbʋ na fa. Ama ba tawɩ ɩ sɛ ŋɩ n tiri daa a. N wɩɛ mɩnaŋ.&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Dɩmʋŋ dʋɔ Yudasi lɔ aterembie ŋii dʋ Ɩsʋɔ tʋm danɛ naŋ sɛ wʋ lam ga dʋ wʋ wʋsɛ ganya.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Sɛ sei bɩnɩɛ baa mʋ aterembie bie ŋii tawɩ sɛ, &lt;&lt;Ŋii chicha daa mbara na dɩɩ mʋ ga kpi Ɩsʋɔ tʋm danɛ naŋ aterembie dʋɔ, akala takɩɛ ŋɩ yɩɛ asima aterembie bɛ.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Dɩmʋŋ dʋɔ ba yɩɛ ba nfɩɛrɛ sɛ baa mʋ aterembie ŋii ga lɩɛ dinyiŋkpa maarɛ wʋrʋ tibi na baa wuu mʋɔra. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Dɩmʋŋ dʋɔ sɛ baa yagɛ dɩmaŋ sɛ asima tibi gaa tala jaŋ. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Sɛ dɩ yela sɛ wɩɛ ŋii Ɩsʋɔ ɔja Yeremiya tawɩ si na kɔŋ tɩba sɛ, &lt;&lt;Ba mʋ diterembi fʋlʋm bie nkuo na sala ŋii ŋɩ yɩɛ yawʋ gaa Isiralitina mʋ jaga wʋ nyi dʋɔ. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Sɛ ba mʋ ŋɛ mʋ lɩɛ dinyiŋkpa maarɛ wʋrʋ tibi ganaŋkʋ Ɩsʋɔ dʋ maŋ na.&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">Sak 11:12-13</ref>.; <ref loc="JER 19:1-13">Yere 19:1-13</ref>; <ref loc="JER 32:6-9">32:6-9</ref>.</char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">Pilato tasɛ Yesu wɩɛ</para>
  <para style="r">
    <ref loc="MRK 15:2-5">Maakɩ 15:2-5</ref>; <ref loc="LUK 23:3-5">Luka 23:3-5</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Sɛ ba mʋ Yesu ga sɩŋ Pilato wʋŋ wʋ yɩɛ Isirali tibi dʋɔ kɩɛrɛ na asanaŋ sɛ wʋ tasɛ ɩ sɛ, &lt;&lt;Nyaŋ n nyina Yudatina Juo naa?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Sɛ Yesu lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Ɛɛŋ, ŋii sɛ nya tawɩ na.&gt;&gt;<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Gʋ sei bɩnɩɛ na dɩɛ bɩnɩɛ baa pʋɩ Yesu na, wʋ n lɩsɛ nʋɔ ɔ. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Sɛ Pilato ti bɔrɛ tasɛ ɩ sɛ, &lt;&lt;Nyaa nyii seriya gaa baa di baa sʋɔ nyaŋ naa?&gt;&gt; <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ama Yesu n lɩsɛ wɩɛ ŋii garɛ nʋɔ ɔ. Sɛ dɩ yɩɛ Isirali tibi dʋɔ kɩɛrɛ wʋŋ doba fɔɩ.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Bɩriŋnʋɔ kʋma dɩ tala Yudatina nyiŋi asadi adiya di na, ŋɩ yɩɛ Pilato ayɩɛsa sɛ wʋ n yela bakpa baa ba tɔ ba danɛ na tɩba wʋŋ jama baa a jawʋ na wʋrʋ fa ba. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Saŋa gana na, ba tɔ baalɛ wʋrʋ danɛ wʋŋ wʋ yu yɩrɛ sʋbʋ sɛ baa yagɛ ɩ sɛ Barabasi na. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Gʋ jama baa sila na, Pilato tasɛ ba sɛ, &lt;&lt;Wʋ Mmʋɔ sɛ ɩ ja sɛ maŋ yela fa amɩɛ, Barabasi yaa Yesu wʋŋ baa yagɛ Kirisito naa?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Akala takɩɛ Pilato jiŋ gʋ kɔlɩŋ dʋɔ sɛ ba mʋ Yesu kɔna ɩ.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Gʋ Pilato chaɩ wɩɛ diri gbeli dʋɔ na, wʋ alʋ kpiri gaa tawɩ ɩ sɛ, &lt;&lt;N baa yɩɛ baalɛ wina wʋŋ wʋ yɩɛ wʋchirigisa na bʋrʋ. Akala takɩɛ wʋ dʋɔ ma na awʋrʋfʋɔ ma dosi naŋ daŋda yuluma.&gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ama Ɩsʋɔ sei bɩnɩɛ na dɩɛ bɩnɩɛ baa fuosi dʋ jama baa sɛ ba n tawɩ Pilato sɛ wʋ n yela Barabasi na baa kʋ Yesu.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Sɛ Pilato tasɛ ba sɛ, &lt;&lt;Bakpa bala baa tɩba wʋ Mmʋɔ sɛ ɩ ja sɛ maŋ yela fa amɩɛ?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">Sɛ ba lɩsɛ ɩ nʋɔ sɛ, &lt;&lt;Barabasi.&gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Sɛ Pilato ti bɔrɛ tasɛ ba sɛ, &lt;&lt;Be sɛ ɩ ja sɛ maŋ yɩɛ Yesu wʋŋ baa yagɛ ɩ Kirisito naa?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">Sɛ ba kpiniŋ ba lɩsɛ nʋɔ sɛ, &lt;&lt;Jɔ ɩ daŋ gasagasa dʋɔ.&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Sɛ Pilato tasɛ sɛ, &lt;&lt;Be dɩsʋbʋ sɛ wʋ yɩɛ bɛ?&gt;&gt; Ama ba kuusi na doŋ sɛ, &lt;&lt;jɔ ɩ daŋ gasagasa dʋɔ.&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Gʋ Pilato na gʋ wʋ aa ti dɩlɛ yɩɛ bʋrʋ ʋ ama wʋ na gʋ siŋii fara a kɔnɛ na, wʋ mʋ lɩŋ yalɛ wʋ pamɩɛ jama baa asanaŋ tawɩ sɛ, &lt;&lt;Ma ba jiŋ baalɛ wina sɩŋ dʋɔ ɔ, ŋɩ yɩɛ amɩɛ wɩɛ bɛ.&gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Sɛ bakpa baa kpiniŋ lɩsɛ nʋɔ sɛ, &lt;&lt;yela na baa ja wʋ asima lɩɩ daa na daa bie jaŋ.&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Sɛ Pilato yela Barabasi fa ba. Sɛ wʋ yela sɛ ba taɩ Yesu achʋchʋɛ sɛ wʋ mʋ ɩ fa ba sɛ ba n jɔ ɩ daŋ gasagasa dʋɔ.<verse eid="MAT 27:26" /></para>
  <para style="s1">Yuora baa jabi Yesu</para>
  <para style="r">
    <ref loc="MRK 15:16-20">Maakɩ 15:16-20</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Sɛ Pilato yuora baa mʋ Yesu ju Pilato juorigbɩɛ, sɛ ba yagɛ ba dɔŋa baa kpiniŋ gaa sila logo Yesu. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ba fulu wʋ gagba sɛ ba mʋ gagba sɩɛm gajalɩŋtɛ fu ɩ takɩɛ juo. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Sɛ ba mʋ sɔba lʋʋ juori gapa mʋ fu ɩ, sɛ ba mʋ daŋ gatugasa mʋ dʋ wʋ pam jɩsaŋ naŋ, sɛ ba luuŋ ba dʋna dʋɔ wʋ asanaŋ sɛ ba jabi ɩ tawɩ sɛ, &lt;&lt;Yudatina Juo, yu nkpa.&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ba tɔ mɩtalɩŋ fu ɩ sɛ ba lɩɛ daŋ gatugasa gaa lɩɩ wʋ jaŋ sɛ ba mʋ taɩ-taɩ wʋ nyinaŋ. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Gʋ ba jabi Yesu taŋ na, ba fulu adugbe gagba gasɩɛm gajalɩŋtɛ gaa sɛ ba mʋ wʋ tɩŋtɩŋ wʋ gagba fu ɩ. Sɛ ba mʋ ɩ lɩɩ na baa ga jɔ ɩ daŋ gasagasa dʋɔ.<verse eid="MAT 27:31" /></para>
  <para style="s1">Ba jɔ Yesu daŋ gasagasa dʋɔ</para>
  <para style="r">
    <ref loc="MRK 15:21-32">Maakɩ 15:21-32</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Gʋ yuora baa mʋ Yesu baa ju na, ba jaŋina baalɛ wʋrʋ baa yagɛ ɩ sɛ Simoŋ, wʋŋ wʋ lɩɩ Kireni na. Sɛ yuora baa chaŋ ɩ dʋ ɩ sɛ ba mʋ daŋ gasagasa gaa sɩlɛ ɩ. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Gʋ ba ga tala diele gaa baa yagɛ sɛ Goligota na [tie akala sɛ Nyi Gafie]. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Dɩmaŋ sɛ ba mʋ bʋrʋ gaŋaŋtɛ bʋga na sʋlʋŋ mʋ fa ɩ sɛ wʋ n nyʋɔ. Ama gʋ wʋ da kɩɛ na, wʋ n nyʋɔ ɔ. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Gʋ ba jɔ Yesu daŋ gasagasa dʋɔ taŋ na, sɛ ba lɔ wʋ gagbasɛ dʋɔ mbi mʋ kpara fa dɔŋa. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Wʋrʋgbɩɛ na, sɛ yuora baa cha dɩmaŋ baa gie ɩ. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Sɛ ba sabɩɛ wɩɛ ŋii ba sɩŋ ŋɩ dʋɔ fu ɩ dɩpʋɛ na jaga wʋ nyie dʋɔ daŋ gasagasa gaa dʋɔ sɛ,</para>
  <para style="qc" vid="MAT 27:37">WINA N NYINA YESU, YUDATINA JUO WƲŊ.<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Ba jɔ ŋmɩɛla baa ba chamɩna doŋ baa lɩɛ bakpa abʋrɩ na bala barɛ daŋ gasagasa dʋɔ. Wʋrʋ wɩɛ wʋ pam jɩsaŋ dʋɔ sɛ wʋrʋ dʋɔ wʋ pam naŋbii dʋɔ. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Bakpa baa baa laŋ dɩmaŋ na kpiniŋ a jigisi ba nyie baa tii ɩ <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />baa tawɩ sɛ, &lt;&lt;Kɩɛ! Nyaŋ n tawɩ sɛ nyaa salɩɛ Ɩsʋɔ tʋm danɛ na nyaa mʋ wɩɛ atoro ma ga. Sɛ nyaŋ n nyina Ɩsʋɔ Bu wʋŋ na, mɔlɔgɩ n wʋsɛ na nyaa tibi daŋ gasagasa gaa dʋɔ!&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Dɩmʋŋ sɛ sei bɩnɩɛ, mbara bakalaasa na dɩɛ bɩnɩɛ baa gba jabi ɩ <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />tawɩ sɛ, &lt;&lt;Wʋ a mɔlɔgɩ barɛ, ama wʋ n dɩlɛ mɔlɔgɩ wʋ wʋsɛ ɛ. Wʋ sɛ wʋ yɩɛ Isiralitina Juo na, wʋ n tibi lɩɩ daŋ gasagasa gaa dʋɔ na dɩɩ lɩɛ ɩ di. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Wʋ lɩɛ Ɩsʋɔ di. N yela na Ɩsʋɔ a mɔlɔgɩ ɩ dɩtɩɛna sɛ wʋ a ja ɩ na. Akala takɩɛ wʋ tawɩ sɛ maŋ n nyina Ɩsʋɔ Bu wʋŋ.&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Dɩmʋŋ sɛ ŋmɩɛla baa ba chamɩna doŋ baa lɩɛ bakpa abʋrɩ, sɛ ba jɔ ba daŋ gasagasa dʋɔ kpi Yesu dʋɔ na gba tii ɩ.<verse eid="MAT 27:44" /></para>
  <para style="s1">Yesu sɩŋ wɩɛ</para>
  <para style="r">
    <ref loc="MRK 15:33-41">Maakɩ 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Gʋ dɩ tala wiita keŋkeŋ na, giteŋteŋbiri kɔŋ tibi dʋɔ kpiniŋ ga tala bʋyanɔ karafɩɛ atoro. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Karafɩɛ atoro gana naŋ na, Yesu kuusi na doŋ sɛ, <char style="tl">&lt;&lt;Eli, Eli,<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">Sabɩɛwɩɛ kpiniŋ wɩɛna Eloyi.</char></note> lama sabatani?&gt;&gt;</char> Tie akala sɛ, &lt;&lt;Ma Ɩsʋɔ, ma Ɩsʋɔ, be n yɩɛ sɛ nya yela maŋ?&gt;&gt;<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Num 22:1</ref>.</char></note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Gʋ baa ba sɩmɩɛɩ dɩmaŋ na barɛ nyii wɩɛ ŋii wʋ tawɩ na, ba tawɩ sɛ, &lt;&lt;N nyii, wʋ a yagɛ Ɩsʋɔ ɔja Eliya!&gt;&gt;<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Gabʋanaŋ sɛ ba tɩba wʋrʋ se ju ga mʋ dɩchɩɛ nyʋ wayɩŋ sʋlʋŋ aŋaŋsa ŋarɛ naŋ, sɛ wʋ mʋ saga daŋ dʋɔ, sɛ wʋ jiŋna ga ju Yesu nʋɔ jaŋ sɛ wʋ n chʋchʋʋ. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Sɛ baa ba kakaa na tawɩ sɛ, &lt;&lt;N yela ɩ wʋ nyiŋeŋ dɩtɩɛna. N yela na dɩɩ kɩɛ sɛ Eliya aja wʋ a kɔŋ gaa mɔlɔgɩ ɩ.&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Gʋ Yesu ti bɔrɛ kuusi na doŋ na, sɛ wʋ wuosi tam.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Gabʋanaŋ sɛ dukuru gaa ba mʋ gara Ɩsʋɔ tʋm danɛ naŋ na, chati tɩba bʋla lɩɩ adugbe gaa tala tie. Tibi jigisi sɛ akpa bʋɛ salɩɛ-salɩɛ tɩba. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Sɛ gachaŋsɛ fulu sɛ bakpa dɩchɩrɩchɩrɩ fɔɩ baa ba sɩŋ na feŋ lɩɩ sɩŋ naŋ. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Saŋa gaa Yesu feŋ lɩɩ sɩŋ naŋ wʋrʋgbɩɛ na, Ɩsʋɔ bakpa baa ba feŋ lɩɩ sɩŋ naŋ na ju Yerusalem dɩɛ janɛ naŋ sɛ ba lɩsɛ ba wʋsɛ kalaa bakpa fɔɩ.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Gʋ yuora gafie bɩnɛ wʋŋ na baa ba kpi wʋ dʋɔ baa kɩɛ Yesu dʋɔ na ganaŋkʋ tibi jigisi, na ŋii ŋɩ tibi kpiniŋ na, nyɩŋtɩɛ chaŋ ba fɔɩ sɛ ba tawɩ sɛ, &lt;&lt;Gasiŋteŋ, baalɛ wina yɩɛ Ɩsʋɔ Bu bɛ.&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Sɛ ala fɔɩ barɛ baa ba kpaŋ Yesu lɩɩ Galaliya gaa kɩɛ wʋ dʋɔ na sɩmɩɛɩ taŋasɛ baa kɩɛ. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ala baa tɩba barɛ n nyina Mariya Magadalini, Mariya wʋŋ wʋ bie n nyina Yakubu<note caller="+" style="f"><char style="fr" closed="false">27:56 </char><char style="ft" closed="false">Yakubu n nyina Jamesi.</char></note> na Yosefu na Sebedi bie baala jaŋ baa ba naa.<verse eid="MAT 27:56" /></para>
  <para style="s1">Yesu wuu</para>
  <para style="r">
    <ref loc="MRK 15:42-47">Maakɩ 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Gʋ dɩ tala bʋyanɔ na, akpaŋtatɛ wʋrʋ baa yagɛ ɩ sɛ Yosefu wʋŋ wʋ lɩɩ Arimatiya. Wʋŋ gba wʋ cha wʋ yɩɛ Yesu kpalɛnarɛ bɛ. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Sɛ wʋ ju Pilato jaŋ ga sʋlʋ Yesu gɩtatɛ sɛ Pilato fa gbɩɛ sɛ ba mʋ fa ɩ. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Sɛ Yosefu sagi Yesu gɩtatɛ sɛ wʋ mʋ dɩkalala gafɔlɛ pɔgɩ ɩ. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Sɛ wʋ mʋ Yesu gɩtatɛ ga wuu wʋ tɩŋtɩŋ wʋ akpanaŋ bʋɔ gafɔlɛ gaa naŋ. Sɛ wʋ gbiliti bʋɩ ga janɛ garɛ mʋ tɔ bʋɔ gaa nʋɔ sɛ wʋ lam. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Sɛ Mariya Magadalini na Mariya wʋ baŋbaŋ wʋŋ cha dɩmaŋ bʋɔ gaa sinabie.<verse eid="MAT 27:61" /></para>
  <para style="s1">Kɩɛrɛ wʋŋ wʋ a gie Yesu bʋɔ na</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Pɔɩ na tɩɛ a na Fɩɛsɛ wɩɩ na, Ɩsʋɔ sei bɩnɩɛ na Farasitina ju Pilato jaŋ <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />ga tawɩ ɩ sɛ, &lt;&lt;Kpaŋjuo, dɩ nyiŋi gʋ akarɩɛtɛ wʋŋ chaɩ nkpa naŋ na, wʋ tawɩ sɛ, &lt;Wɩɛ atoro wʋrʋgbɩɛ na, maa feŋ lɩɩ sɩŋ naŋ.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Dɩmʋŋ dʋɔ, dʋ na baa ga gie bʋɔ gaa na dieli ga tala wɩɛ atoro wɩɩ. Naa dɩmʋŋ na, wʋ kpalɛnara baa aja gaa ŋmɩɛlɛ wʋ gɩtatɛ gaa na baa tawɩ bakpa sɛ wʋ feŋ lɩɩ sɩŋ naŋ. Akarɩɛ ŋii baa di wʋrʋgbɩɛ na, aja kii ŋii ba chɩŋkpɩɛ di na.&gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Sɛ Pilato tawɩ ba sɛ, &lt;&lt;N mʋ yuora baa na baa ga gie bʋɔ gaa na ɩ mʋna gbɩɛ kʋma dʋɔ gie ga na dieli.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Dɩmʋŋ dʋɔ ba ju ga daasɛ bʋɩ janɛ gaa ba gbiliti tɔ bʋɔ gaa nʋɔ ganaŋkʋ wʋrʋ gbiliti ga na baa jiŋ. Sɛ ba lɩsɛ yuora baa si sɛ ba n gie ga.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Yesu feŋ lɩɩ sɩŋ naŋ</para>
  <para style="r">
    <ref loc="MRK 16:1-10">Maakɩ 16:1-10</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Fɩɛsɛ wɩɩ wʋrʋgbɩɛ wɩɩ gaa ga dɔŋ soji asanaŋ tafɩlɛ na, Mariya Magadalini na Mariya wʋ baŋbaŋ wʋŋ ju ga kɩɛ bʋɔ gaa.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Gʋ ba tala dɩmaŋ na, kɩɛ gabʋanaŋ sɛ tibi jigisi na doŋ, akala takɩɛ Ɩsʋɔ gabʋɔ tibi lɩɩ Ɩsʋɔ adugbe gaa gbiliti bʋɩ janɛ gaa ga fuwei akpanaŋ bʋɔ gaa nʋɔ na, sɛ wʋ cha ga dʋɔ. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Wʋ wʋsɛ a ŋalagi takɩɛ duoni ŋmaŋi sɛ wʋ abʋrɩ afuusa fʋlʋmɩɛɩ ŋii ŋalagi takɩɛ dɩkalala na. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Gʋ gachaŋ kɩɛra baa na Ɩsʋɔ gabʋɔ wʋŋ na sɛ nyɩŋtɩɛ chaŋ ba, sɛ ba selesi sɛ ba lɩɩ sala takɩɛ atatina na.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Sɛ Ɩsʋɔ gabʋɔ wʋŋ tawɩ ala baa sɛ, &lt;&lt;N baa yela nyɩŋtɩɛ a chaŋ amɩɛ. Ma jiŋ gʋ Yesu wʋŋ ba jɔ ɩ daŋ gasagasa dʋɔ na sɛ ɩ jawʋ. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Wʋ taŋ jɩna a. Wʋ feŋ lɩɩ sɩŋ naŋ ganaŋkʋ wʋ fɩla tawɩ na. N gaa kɩɛ diele gaa ba cha mʋ wʋ gɩtatɛ si na. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />N ju bileŋ ga tawɩ wʋ kpalɛnara baa sɛ, &lt;N kɩɛ, wʋ feŋ lɩɩ sɩŋ naŋ sɛ wʋ pala amɩɛ asanaŋ wʋ a ju Galaliya, dɩmaŋ sɛ ɩ ga na ɩ.&gt; N nyii, dɩtɩɛna ma tawɩ amɩɛ.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Dɩmʋŋ dʋɔ ala baa kpala lɩɩ gachaŋ gaa jaŋ. Nyɩŋtɩɛ chaŋ ba bɩrɛ, ama ba mʋ asadi se ga tawɩ wʋ kpalɛnara baa. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Kɩɛ, gabʋanaŋ sɛ Yesu jaŋina ba tawɩ sɛ, &lt;&lt;Maa yɩlɩ amɩɛ,&gt;&gt; sɛ ba kɔŋ wʋ jaŋ gaa luuŋ ba dʋna dʋɔ sɛ ba tʋŋ ɩ. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Sɛ Yesu tawɩ ba sɛ, &lt;&lt;N baa yela na nyɩŋtɩɛ achaŋ amɩɛ. N ju ga tawɩ ma dɔŋa sɛ ba n ju Galaliya dɩmaŋ sɛ baa ga na maŋ.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s1">Yuora baa tawɩ ŋii ŋɩ tibi na fa Ɩsʋɔ sei bɩnɩɛ baa</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Gʋ ala baa a ju na, kɩɛ yuora baa barɛ ju dɩɛ janɛ gaa naŋ ga tawɩ sei bɩnɩɛ baa ŋii ŋɩ tibi na kpiniŋ. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Sɛ sei bɩnɩɛ na dɩɛ bɩnɩɛ baa gaa jaŋi jɔ dɩkɔŋ sɛ ba fa yuora baa aterembie fɔɩ, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />sɛ ba tawɩ ba sɛ n yɩɛ akarɩɛ sɛ, &lt;&lt;N tawɩ sɛ, &lt;Wʋ kpalɛnara baa kɔŋ gaa ŋmɩɛlɛ wʋ gɩtatɛ gʋ dɩ duo yuluma na.&gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Sɛ Pilato nyii wɩɛ ŋina na, daa tɩŋtɩŋ dɩɩ tawɩ ɩ sɛ ɩ ba jiŋ wɩɛ ŋina dʋɔ bʋrʋ ʋ ganaŋkʋ ɩɩ yu wɩɛ na.&gt;&gt; <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Dɩmʋŋ dʋɔ yuora baa lɩɛ aterembie ŋii sɛ ba yɩɛ ganaŋkʋ ba tawɩ ba na. Sɛ dɩmʋŋ akarɩɛ ŋina yasɩŋ jʋʋ Yudatina tɩba gaa lɩɩ jaŋ.<verse eid="MAT 28:15" /></para>
  <para style="s1">Dɩtʋm gajanɛ gaa Yesu fa wʋ kpalɛnara baa na</para>
  <para style="r">
    <ref loc="MRK 16:14-18">Maakɩ 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="ACT 1:6-8">Dɩtʋm 1:6-8</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Sɛ kpalɛnara gifi darɛ baa ju bʋrɔŋ garɛ dʋɔ Galaliya diele gaa Yesu cha tawɩ ba sɛ ba n ju na. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Gʋ ba na Yesu na ba tʋŋ ɩ, ama barɛ dʋɔ lɩɛ noro sɛ naa wʋŋ bɛ ɛ. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Sɛ Yesu kɔŋ ba jaŋ gaa tawɩ sɛ, &lt;&lt;Ɩsʋɔ mʋ Ɩsʋɔ adugbe na tie dʋɔ yikuo kpiniŋ fa maŋ. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Dɩmʋŋ dʋɔ n ju atawɩ yɩrɩ kpiniŋ jaŋ ga yɩɛ ba ma kpalɛnara. N sɔ ba Ɩsʋɔ sɔ Juo wʋŋ na Bu wʋŋ na Ɩsʋɔ Feliŋ yɩrɛ naŋ, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />na ɩ kalaa ba na baa kpaŋ bʋrʋkʋma gaa ma dʋ amɩɛ na dʋɔ. N nyii takɩɛ ma wɩɛ amɩɛ jaŋ saŋa kʋma ga tala dulunya dɩtamtɩŋ.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>