<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Biblica® Open Icelandic Living New Testament and Psalms</book>
  <para style="h">II. Jóhannesarbréf</para>
  <para style="toc1">II. Jóhannesarbréf</para>
  <para style="toc2">II. Jóhannesarbréf</para>
  <para style="toc3">II. Jóhannesarbréf</para>
  <para style="mt1">II. Jóhannesarbréf</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>Frá Jóhannesi, öldungi kirkjunnar.</para>
  <para style="p" vid="2JN 1:1">Til hennar, sem Guð útvaldi, og barna hennar, sem ég og allir aðrir í kirkjunni elska af hjarta. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>Við höldum fast við sannleikann <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>og því mun Guð, faðirinn, og sonur hans, Jesús Kristur, blessa okkur með miskunn sinni og friði, sannleika og elsku.<verse eid="2JN 1:3"/></para>
  <para style="s1">Gætið ykkar á falsleiðtogum</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Það var mjög ánægjulegt að hitta nokkur barna þinna hér og sjá að þau lifa lífinu eins og ætlast er til, í fylgd með sannleikanum og hlýðni við boð Guðs.<verse eid="2JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2JN 1:5"/>Kæru vinir, ég minni ykkur alvarlega á gamla boðorðið sem Guð gaf okkur þegar í öndverðu: Kristnir menn eiga að elska hver annan. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>Ef við elskum Guð gerum við það sem hann býður okkur – í upphafi sagði hann okkur að elska hvert annað.<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>Gætið ykkar á falsleiðtogum – og nóg er af þeim – sem trúa því ekki að Jesús Kristur hafi komið til jarðarinnar sem maður í líkama, eins og þeim, sem við höfum. Slíkir menn eru í andstöðu við sannleikann og einnig við Krist. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>Gætið þess að verða ekki eins og þeir, því að þá glatið þið því, sem þið hafið þegar öðlast í samfélaginu við Guð. Látið ekkert koma í veg fyrir að þið fáið full laun frá Drottni. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>Ef þið farið út fyrir kenningu hans, snúið þið baki við Guði, en ef þið hlýðið orðum Krists, eigið þið samfélag við Guð, já, bæði föðurinn og soninn.<verse eid="2JN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2JN 1:10"/>Ef einhver, sem ekki trúir orðum Krists, kemur til þess að uppfræða ykkur, þá bjóðið honum hvorki inn á heimili ykkar né hvetjið hann á nokkurn hátt, <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>því að ef þið gerið það, þá verðið þið þátttakendur í illverkum hans.<verse eid="2JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Ég hefði gjarnan viljað segja ýmislegt fleira, en ég ætla ekki að gera það í þessu bréfi. Ég vona að ég geti fljótlega komið til ykkar og þá getum við rætt saman og átt góðar stundir.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>Börn systur þinnar – en hún er líka Guðs barn – biðja að heilsa þér.</para>
  <para style="p" vid="2JN 1:13">Jóhannes<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
