<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open Icelandic Living New Testament and Psalms</book>
  <para style="h">Sálmarnir</para>
  <para style="toc1">Sálmarnir</para>
  <para style="toc2">Sálmarnir</para>
  <para style="toc3">Sálmarnir</para>
  <para style="mt1">Sálmarnir</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 1:1"/>Mikil er gæfa þess manns sem ekki fer að ráðum óguðlegra, ekki á félagsskap við syndara sem hæða Guð, <verse eid="PSA 1:1"/><verse number="2" style="v" sid="PSA 1:2"/>heldur hefur unun af því að hlýða Drottni og íhuga orð hans dag og nótt, og þannig nálgast hann sífellt meira.<verse eid="PSA 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 1:3"/>Hann líkist tré sem stendur við rennandi læk og ber sætan ávöxt sinn á réttum tíma og blöð þess visna ekki. Slíkum manni tekst allt vel.<verse eid="PSA 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 1:4"/>En hvað með syndarana? Það er önnur saga! Þeir fjúka burt eins og hismi undan vindi. <verse eid="PSA 1:4"/><verse number="5" style="v" sid="PSA 1:5"/>Þeir munu ekki standast á degi dómsins né heldur í söfnuði réttlátra.<verse eid="PSA 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 1:6"/>Drottinn vakir yfir lífi og áformum hinna trúuðu, en vegur óguðlegra endar í vegleysu.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 2:1"/>Hvílík heimska að þjóðirnar skuli ráðast gegn Drottni! Furðulegt að menn láti sér detta í hug að þeir séu vitrari en Guð! <verse eid="PSA 2:1"/><verse number="2" style="v" sid="PSA 2:2"/>Leiðtogar heimsins hittast og ráðgera samsæri gegn Drottni og Kristi konungi. <verse eid="PSA 2:2"/><verse number="3" style="v" sid="PSA 2:3"/>„Komum,“ segja þeir, „og vörpum af okkur oki hans. Slítum okkur lausa frá Guði!“<verse eid="PSA 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 2:4"/>En á himnum hlær Guð að slíkum mönnum! Honum er skemmt með þeirra fánýtu ráðagerðum. <verse eid="PSA 2:4"/><verse number="5" style="v" sid="PSA 2:5"/>Hann ávítar þá í reiði sinni og skýtur þeim skelk í bringu.</para>
  <para style="p" vid="PSA 2:5">Drottinn lýsir yfir: <verse eid="PSA 2:5"/><verse number="6" style="v" sid="PSA 2:6"/>„Þennan konung hef ég útvalið og krýnt í Jerúsalem, minni helgu borg“.</para>
  <para style="p" vid="PSA 2:6">Hans útvaldi svarar: <verse eid="PSA 2:6"/><verse number="7" style="v" sid="PSA 2:7"/>„Ég mun kunngera áform Guðs, því að Drottinn sagði við mig: „Þú ert sonur minn. Í dag verður þú krýndur. Í dag geri ég þig dýrlegan“.“ <verse eid="PSA 2:7"/><verse number="8" style="v" sid="PSA 2:8"/>„Bið þú mig og ég mun leggja undir þig öll ríki heimsins. <verse eid="PSA 2:8"/><verse number="9" style="v" sid="PSA 2:9"/>Stjórnaðu þeim með harðri hendi og mölvaðu þau eins og leirkrukku!“<verse eid="PSA 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 2:10"/>Þið, konungar jarðarinnar! Hlustið meðan tími er til! <verse eid="PSA 2:10"/><verse number="11" style="v" sid="PSA 2:11"/>Þjónið Drottni með óttablandinni lotningu og fagnið með auðmýkt. <verse eid="PSA 2:11"/><verse number="12" style="v" sid="PSA 2:12"/>Fallið á kné fyrir syni hans og kyssið fætur hans svo að hann reiðist ekki og tortími ykkur! <verse eid="PSA 2:12"/><verse number="13" style="v" sid="PSA 2:13"/>Gætið ykkar, því að senn mun blossa reiði hans. En munið þetta: Sæll er hver sá sem leitar ásjár hjá honum.<verse eid="PSA 2:13"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 3:1"/>Sálmur eftir Davíð þegar hann flúði frá Absalon, syni sínum.<verse eid="PSA 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 3:2"/>Ó, Drottinn, það eru svo margir á móti mér, svo margir sem gera uppreisn gegn mér. <verse eid="PSA 3:2"/><verse number="3" style="v" sid="PSA 3:3"/>Menn segja að Guð muni alls ekki hjálpa mér. <verse eid="PSA 3:3"/><verse number="4" style="v" sid="PSA 3:4"/>En, Drottinn, þú ert skjöldur minn, sæmd mín og von. Þú lætur mig bera höfuðið hátt, þrátt fyrir allt.<verse eid="PSA 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 3:5"/>Ég hrópaði til Drottins og hann svaraði mér frá musteri sínu í Jerúsalem. <verse eid="PSA 3:5"/><verse number="6" style="v" sid="PSA 3:6"/>Þá lagðist ég fyrir og sofnaði í friði. Síðar vaknaði ég öruggur, því að Drottinn gætir mín. <verse eid="PSA 3:6"/><verse number="7" style="v" sid="PSA 3:7"/>Nú er ég óhræddur, jafnvel þótt tíu þúsund óvinir umkringi mig! <verse eid="PSA 3:7"/><verse number="8" style="v" sid="PSA 3:8"/>Ég mun hrópa til Drottins: „Drottinn, rís þú upp! Bjargaðu mér, þú Guð minn!“ Og hann mun slá óvini mína og brjóta tennur illvirkjanna. Hjálpin kemur frá Guði. Blessun hans hvílir yfir þjóð hans.<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 4:1-2"/> Þú, Guð réttlætis míns, þú sem hefur annast mig í öllum mínum erfiðleikum. Hlusta nú þegar ég kalla á nýjan leik. Miskunna þú mér. Heyr bæn mína.<verse eid="PSA 4:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 4:3"/>Drottinn Guð spyr: „Þið mannanna börn, ætlið þið endalaust að vanhelga nafn mitt með því að tilbiðja þessa heimskulegu hjáguði? Vitið þið ekki að heiður þeirra er bull og hégómi?“<verse eid="PSA 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 4:4"/>Takið eftir: Drottinn hefur sýnt mér mikla náð og hann mun hlusta og svara mér þegar ég kalla. <verse eid="PSA 4:4"/><verse number="5" style="v" sid="PSA 4:5"/>Sýnið Drottni óttablandna lotningu og syndgið ekki gegn honum. Hugsið um þetta í hvílum ykkar og verið þögul. <verse eid="PSA 4:5"/><verse number="6" style="v" sid="PSA 4:6"/>Setjið traust ykkar á Drottin, og færið honum þóknanlegar fórnir.<verse eid="PSA 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 4:7"/>Margir spyrja hvar hjálp sé að fá. Drottinn, þú ert sá sem hjálpar. Láttu ljós þitt lýsa okkur. <verse eid="PSA 4:7"/><verse number="8" style="v" sid="PSA 4:8"/>Gleðin sem þú hefur veitt mér er mun meiri en þeirra sem gleðjast yfir ríkulegri uppskeru. <verse eid="PSA 4:8"/><verse number="9" style="v" sid="PSA 4:9"/>Nú leggst ég til hvíldar í friði og sofna, því þú, Drottinn verndar mig gegn öllu illu.<verse eid="PSA 4:9"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 5:1-2"/> Drottinn, hlustaðu á orð mín. Heyr þú mína einlægu bæn. <verse eid="PSA 5:1-2"/><verse number="3" style="v" sid="PSA 5:3"/>Hlustaðu á kveinstafi mína, þú Guð, konungur minn, því að ég mun aldrei biðja til neins nema þín. <verse eid="PSA 5:3"/><verse number="4" style="v" sid="PSA 5:4"/>Á hverjum morgni horfi ég til himins, já til þín, og legg bænir mínar fram fyrir þig.<verse eid="PSA 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 5:5"/>Ég veit að þú fyrirlítur óguðleika og að þeir sem iðka hið illa fá ekki að dveljast hjá þér. <verse eid="PSA 5:5"/><verse number="6" style="v" sid="PSA 5:6"/>Hrokafullir syndarar standast augnaráð þitt ekki, því að þú hatar illgjörðir þeirra. <verse eid="PSA 5:6"/><verse number="7" style="v" sid="PSA 5:7"/>Þú munt eyða þeim sem tala lygi og þú hefur andstyggð á morðum og svikum.<verse eid="PSA 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 5:8"/>En hvað um mig? Af náð þinni fæ ég að ganga inn í musteri þitt, umvafinn vernd þinni og ást. Ég vil tilbiðja þig í djúpri lotningu.<verse eid="PSA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 5:9"/>Drottinn, leiddu mig eins og þú lofaðir mér, annars munu óvinir mínir sigra mig. Segðu mér skýrt hvað ég á að gera, og hvert ég á að fara, <verse eid="PSA 5:9"/><verse number="10" style="v" sid="PSA 5:10"/>því að þeir reyna að blekkja mig. Hjörtu þeirra eru full af illsku. Tortíming og dauði býr í ráðum þeirra og þeir nota svik og pretti sér til framdráttar. <verse eid="PSA 5:10"/><verse number="11" style="v" sid="PSA 5:11"/>Ó, Guð láttu þá fá makleg málagjöld. Þeir lendi í eigin gildru. Hrintu þeim burt vegna hinna mörgu afbrota þeirra, því að þeir storka þér.<verse eid="PSA 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 5:12"/>En þeir sem treysta þér gleðjast og kætast. Þeir hrópa af gleði því þú verndar þá. Þeir sem elska þig gleðjast yfir þér. <verse eid="PSA 5:12"/><verse number="13" style="v" sid="PSA 5:13"/>Því að þú, ó Guð, blessar hinn trúaða, þú verndar hann með skildi elsku þinnar.<verse eid="PSA 5:13"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 6:1-2"/> Æ, Drottinn! Ekki refsa mér í reiði þinni! <verse eid="PSA 6:1-2"/><verse number="3" style="v" sid="PSA 6:3"/>Miskunnaðu mér því að ég örmagnast. Lækna mig, því að líkami minn er sjúkur. <verse eid="PSA 6:3"/><verse number="4" style="v" sid="PSA 6:4"/>Ég er hræddur, veit ekki mitt rjúkandi ráð. Ó, Drottinn, reistu mig á fætur, og það fljótt!<verse eid="PSA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 6:5"/>Komdu Drottinn og læknaðu mig. Bjargaðu mér í kærleika þínum. <verse eid="PSA 6:5"/><verse number="6" style="v" sid="PSA 6:6"/>Því að ef ég dey, þá get ég ekki lengur lofað þig meðal vina minna. <verse eid="PSA 6:6"/><verse number="7" style="v" sid="PSA 6:7"/>Ég er aðframkominn af kvöl. Hverja nótt væti ég koddann með tárum. <verse eid="PSA 6:7"/><verse number="8" style="v" sid="PSA 6:8"/>Augu mín daprast af hryggð vegna illráða óvina minna.<verse eid="PSA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 6:9"/>Farið! Látið mig í friði, þið illmenni, því að Drottinn hefur séð tár mín <verse eid="PSA 6:9"/><verse number="10" style="v" sid="PSA 6:10"/>og heyrt grátbeiðni mína. Hann mun svara öllum mínum bænum. <verse eid="PSA 6:10"/><verse number="11" style="v" sid="PSA 6:11"/>Óvinir mínir munu verða til skammar og skelfingin mun steypast yfir þá. Guð mun reka þá sneypta burtu.<verse eid="PSA 6:11"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 7:1-2"/> Ég treysti þér, Drottinn, Guð minn, að þú frelsir mig frá þeim sem ofsækja mig. <verse eid="PSA 7:1-2"/><verse number="3" style="v" sid="PSA 7:3"/>Þeir vilja ráðast á mig úr launsátri eins og ljón, særa mig og draga burt hálfdauðan. Láttu það ekki takast! <verse eid="PSA 7:3"/><verse number="4" style="v" sid="PSA 7:4"/>En Drottinn, ef ég hefði illt fyrir stafni <verse eid="PSA 7:4"/><verse number="5" style="v" sid="PSA 7:5"/>– ef ég launaði gott með illu eða beitti nágranna mína órétti, <verse eid="PSA 7:5"/><verse number="6" style="v" sid="PSA 7:6"/>þá væri réttlátt að þú létir óvini mína eyða mér, fella mig og fótum troða.<verse eid="PSA 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 7:7"/>En Drottinn! Rís þú upp í reiði gegn ofstopa óvina minna. Vakna þú Drottinn! Láttu mig ná rétti mínum! <verse eid="PSA 7:7"/><verse number="8-9" style="v" pubnumber="8,9" sid="PSA 7:8-9"/> Safnaðu saman öllum þjóðum. Taktu þér sæti hátt uppi yfir þeim og dæmdu syndir þeirra. En mig, Drottinn, lýstu mig réttlátan svo allir heyri, auglýstu réttlæti mitt og ráðvendni. <verse eid="PSA 7:8-9"/><verse number="10" style="v" sid="PSA 7:10"/>Stöðvaðu alla illsku, Drottinn, og blessa þá sem í einlægni tilbiðja þig. Því að þú, réttláti Guð, kannar hugarfylgsni mannanna og rannsakar viðhorf þeirra og tilgang.<verse eid="PSA 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 7:11"/>Guð er skjöldur minn. Hann mun vernda mig. Hann frelsar þá sem hjartahreinir eru.<verse eid="PSA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 7:12"/>Guð er fullkomlega réttlátur dómari og dag hvern gremst honum illska hinna vondu. <verse eid="PSA 7:12"/><verse number="13" style="v" sid="PSA 7:13"/>Ef þeir iðrast ekki mun hann bregða sverði og eyða þeim. Hann hefur spennt boga sinn <verse eid="PSA 7:13"/><verse number="14" style="v" sid="PSA 7:14"/>og lagt eldlegar örvar á streng, – banvænar örvar.<verse eid="PSA 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 7:15"/>Hinn illi bruggar launráð og íhugar vélabrögð sín. Hann lætur til skarar skríða með lygum og svikum. <verse eid="PSA 7:15"/><verse number="16" style="v" sid="PSA 7:16"/>Hann falli á eigin bragði. <verse eid="PSA 7:16"/><verse number="17" style="v" sid="PSA 7:17"/>Ofbeldið sem hann ætlaði öðrum, verði honum sjálfum að fjörtjóni.<verse eid="PSA 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 7:18"/>Ég lofa og vegsama Drottinn, því hann er góður. Ég vil lofsyngja nafni Drottins, honum sem er öllum drottnum æðri.<verse eid="PSA 7:18"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 8:1-2"/> Ó, Drottinn Guð, mikið er nafn þitt! Jörðin er full af dýrð þinni og himnarnir endurspegla mikilleik þinn.<verse eid="PSA 8:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 8:3"/>Þú hefur kennt börnum að lofsyngja þér. Fyrirmynd þeirra og vitnisburður þaggi niður í óvinum þínum og valdi þeim skömm.<verse eid="PSA 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 8:4"/>Þegar ég horfi á himininn og skoða verk handa þinna, tunglið og stjörnurnar sem þú hefur skapað – <verse eid="PSA 8:4"/><verse number="5" style="v" sid="PSA 8:5"/>þá undrast ég að þú skulir minnast mannsins, láta þér umhugað um mannanna börn. <verse eid="PSA 8:5"/><verse number="6" style="v" sid="PSA 8:6"/>Og líka, að þú lést manninn verða litlu minni en Guð! Krýndir hann sæmd og heiðri!<verse eid="PSA 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 8:7"/>Þú hefur sett hann yfir allt sem þú hefur skapað, allt er honum undirgefið: <verse eid="PSA 8:7"/><verse number="8" style="v" sid="PSA 8:8"/>Uxar og allur annar fénaður, villidýrin <verse eid="PSA 8:8"/><verse number="9" style="v" sid="PSA 8:9"/>fuglar og fiskar, já, allt sem í sjónum syndir. <verse eid="PSA 8:9"/><verse number="10" style="v" sid="PSA 8:10"/>Ó, Drottinn Guð, hversu dýrlegt er nafn þitt um alla jörðina!<verse eid="PSA 8:10"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 9:1-2"/> Drottinn, ég vil lofa þig af öllu hjarta og segja öllum frá þínum dásamlegu verkum! <verse eid="PSA 9:1-2"/><verse number="3" style="v" sid="PSA 9:3"/>Ég vil fagna, já, kætast þín vegna! Ég vil lofsyngja þér, Drottinn Guð, þú ert öllum guðum æðri.<verse eid="PSA 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 9:4"/>Óvinir mínir hörfuðu undan, já, hrösuðu og fórust fyrir augliti þínu. <verse eid="PSA 9:4"/><verse number="5" style="v" sid="PSA 9:5"/>Þú hefur látið mig ná rétti mínum, ábyrgst verk mín og sagt frá hásæti þínu að þau séu góð. <verse eid="PSA 9:5"/><verse number="6" style="v" sid="PSA 9:6"/>Þú hefur ávítað þjóðirnar og eytt illvirkjunum, þurrkað út nöfn þeirra að eilífu.<verse eid="PSA 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 9:7"/>Þið, óvinir mínir, eruð búnir að vera, og eigið ykkur ekki viðreisnar von. Drottinn mun eyða borgum ykkar og minning þeirra mun gleymast.<verse eid="PSA 9:7"/></para>
  <para style="p">
    <verse number="8-9" style="v" pubnumber="8,9" sid="PSA 9:8-9"/> En Drottinn lifir að eilífu. Hann situr í hásæti sínu, sker úr málum þjóðanna og dæmir þær með réttvísi. <verse eid="PSA 9:8-9"/><verse number="10" style="v" sid="PSA 9:10"/>Allir kúgaðir komi til hans. Hann er skjól þeirra og athvarf á neyðarstundu. <verse eid="PSA 9:10"/><verse number="11" style="v" sid="PSA 9:11"/>Allir þeir sem þekkja miskunn þína, Drottinn, treysta á hjálp þína. Þú hefur aldrei yfirgefið þá sem treysta þér.<verse eid="PSA 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 9:12"/>Lofsyngið Guði, honum sem býr í Jerúsalem! Víðfrægið dáðir hans um allan heiminn! <verse eid="PSA 9:12"/><verse number="13" style="v" sid="PSA 9:13"/>Hann sem refsar morðingjum. Hann hlustar eftir þeim sem hrópa á réttlæti. Hann daufheyrist ekki við hrópum þeirra sem eru í nauðum staddir.<verse eid="PSA 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 9:14"/>Og nú, Drottinn, miskunna þú mér, þú sérð hvernig óvinir mínir kvelja mig. Hríf mig úr þessari dauðans hættu. <verse eid="PSA 9:14"/><verse number="15" style="v" sid="PSA 9:15"/>Frelsa mig að ég geti lofað þig í allra áheyrn í hliðum Jerúsalem og glaðst yfir því að þú bjargaðir mér.<verse eid="PSA 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 9:16"/>Þjóðirnar falla sjálfar í gryfjuna sem þær hafa grafið öðrum, þær hafa lent í eigin gildru. <verse eid="PSA 9:16"/><verse number="17" style="v" sid="PSA 9:17"/>Drottinn lætur svikráð þeirra koma þeim sjálfum í koll!<verse eid="PSA 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 9:18"/>Illmennin munu hrapa til heljar og eins verða örlög þeirra þjóða sem gleyma Drottni. <verse eid="PSA 9:18"/><verse number="19" style="v" sid="PSA 9:19"/>Því að ekki verður skortur hinna snauðu umborinn endalaust og né hjálp fátæklinganna látin dragast lengur.<verse eid="PSA 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 9:20"/>Ó, Drottinn, rís þú upp, dæm þjóðirnar og refsa þeim. Lát þær ekki hrósa sigri yfir þér! <verse eid="PSA 9:20"/><verse number="21" style="v" sid="PSA 9:21"/>Lát þá skjálfa af ótta og skilja að þeir eru aðeins dauðlegir menn.<verse eid="PSA 9:21"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 10:1"/>Drottinn, hvers vegna ert þú víðs fjarri og gerir ekkert í málinu?! Hvers vegna felur þú þig þegar ég þarfnast þín svo mjög? <verse eid="PSA 10:1"/><verse number="2" style="v" sid="PSA 10:2"/>Komdu og lækkaðu rostann í hinum hrokafullu og illgjörnu sem ofsækja lítilmagnann. Láttu illskubrögð þeirra koma þeim sjálfum í koll! <verse eid="PSA 10:2"/><verse number="3" style="v" sid="PSA 10:3"/>Því að þessir menn stæra sig af illsku sinni, hæða Guð og hrósa þeim sem Drottinn fyrirlítur. Að safna auði er þeirra hjartans mál.<verse eid="PSA 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 10:4"/>Þessir vondu og sjálfumglöðu menn virðast halda að Guð sé ekki til. Að leita Guðs, það dettur þeim ekki í hug! <verse eid="PSA 10:4"/><verse number="5" style="v" sid="PSA 10:5"/>En samt ná þeir árangri og óvinir þeirra lúta í lægra haldi fyrir þeim. Þeir vita ekki að refsing þín bíður þeirra.<verse eid="PSA 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 10:6"/>Sá hrokafulli segir:. „Hvorki Guð né menn geta stöðvað mig, ég mun finna einhverja leið!“ <verse eid="PSA 10:6"/><verse number="7" style="v" sid="PSA 10:7"/>Munnur hans er fullur af formælingum, lygi og ofbeldi. Hann hrósar sér af illum áformum. <verse eid="PSA 10:7"/><verse number="8" style="v" sid="PSA 10:8"/>Slíkir menn læðast í skúmaskotum borgarinnar og myrða þann sem fram hjá gengur. <verse eid="PSA 10:8"/><verse number="9" style="v" sid="PSA 10:9"/>Eins og ljón sitja fyrir bráð sinni, sitja þeir fyrir fátæklingnum, tilbúnir að hremma hann. Þeir leggja snörur fyrir fórnarlömb sín, veiða þau í net. <verse eid="PSA 10:9"/><verse number="10" style="v" sid="PSA 10:10"/>Hinir ólánssömu undrast mátt þeirra og falla fyrir skeytum þeirra. <verse eid="PSA 10:10"/><verse number="11" style="v" sid="PSA 10:11"/>Þeir segja við sjálfa sig: „Guð sér þetta ekki, og hann mun aldrei komast að því.“<verse eid="PSA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 10:12"/>Drottinn, rís þú upp! Refsa þeim, ó Guð! Gleymdu ekki fátæklingunum né öðrum sem eiga bágt. <verse eid="PSA 10:12"/><verse number="13" style="v" sid="PSA 10:13"/>Hvers vegna lætur þú illmennin sem spotta þig, ganga laus? Þeir halda að þú munir aldrei refsa þeim. <verse eid="PSA 10:13"/><verse number="14" style="v" sid="PSA 10:14"/>Drottinn, þú sérð verk þeirra. Þú þekkir öll þeirra brögð. Allt það böl og hryggðina sem þeir hafa valdið, gjörþekkir þú! Refsaðu þeim Drottinn, og það strax!</para>
  <para style="p" vid="PSA 10:14">Drottinn, hinn bágstaddi treystir á þig og þú ert kallaður stoð lítilmagnans. <verse eid="PSA 10:14"/><verse number="15" style="v" sid="PSA 10:15"/>Brjóttu armlegg illgjörðamannanna. Veittu þeim eftirför uns enginn er eftir orðinn. <verse eid="PSA 10:15"/><verse number="16" style="v" sid="PSA 10:16"/>Drottinn er konungur um aldir alda! Þeim sem elta aðra guði verður útrýmt úr landi hans.<verse eid="PSA 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 10:17"/>Drottinn, þú þekkir vonir hinna hógværu. Vissulega munt þú heyra hróp þeirra og hugga hjörtu þeirra. <verse eid="PSA 10:17"/><verse number="18" style="v" sid="PSA 10:18"/>Þú munt láta munaðarlausa og alla kúgaða ná rétti sínum, svo að mennirnir – þeir eru bara mold – beiti ekki lengur ofbeldi.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 11:1"/>Hvernig getið þið sagt: „Flýðu til fjallanna og leitaðu skjóls!?“ Vitið þið ekki að ég treysti því að Drottinn muni hjálpa mér.<verse eid="PSA 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 11:2"/>Óguðlegir leggja ör á streng, spenna boga sína og miða úr launsátri á lýð Guðs. <verse eid="PSA 11:2"/><verse number="3" style="v" sid="PSA 11:3"/>Menn segja: „Lögin hafa verið afnumin! Hinir réttlátu verða að forða sér.“<verse eid="PSA 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 11:4"/>En, Drottinn er enn í sínu heilaga musteri. Hann ríkir enn frá himnum. Hann fylgist grannt með öllu sem gerist á jörðu. <verse eid="PSA 11:4"/><verse number="5" style="v" sid="PSA 11:5"/>Hann prófar bæði trúaða og vantrúaða. Hann fyrirlítur þá sem elska ofbeldi. <verse eid="PSA 11:5"/><verse number="6" style="v" sid="PSA 11:6"/>Hann mun senda eld og brennistein yfir illgjörðamennina og svíða þá með glóheitum vindi.<verse eid="PSA 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 11:7"/>Því að Guð er réttlátur og hefur mætur á góðum verkum. Hinir hjartahreinu munu sjá auglit hans.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 12:1-2"/> Drottinn! Hjálpa þú! Hinum trúuðu fækkar óðum. Hvar eru þeir sem hægt er að treysta? <verse eid="PSA 12:1-2"/><verse number="3" style="v" sid="PSA 12:3"/>Allir ljúga og iðka svik og pretti, en einlægnin virðist fokin út í veður og vind.<verse eid="PSA 12:3"/></para>
  <para style="p">
    <verse number="4-5" style="v" pubnumber="4,5" sid="PSA 12:4-5"/> En Drottinn mun ekki fara mjúkum höndum um þá sem iðka ranglæti. Hann mun útrýma þessum lygurum sem segja: „Við skulum ljúga til um áform okkar, enda ráðum við sjálfir hvað við segjum!“ <verse eid="PSA 12:4-5"/><verse number="6" style="v" sid="PSA 12:6"/>Þessu svarar Drottinn: „Ég mun rísa upp og verja þá kúguðu, fátæku og hrjáðu. Ég mun frelsa þá samkvæmt bænum þeirra.“ <verse eid="PSA 12:6"/><verse number="7" style="v" sid="PSA 12:7"/>Loforð Drottins eru áreiðanleg. Hvert orð á vörum hans er satt og rétt eins og marghreinsað skíragull. <verse eid="PSA 12:7"/><verse number="8" style="v" sid="PSA 12:8"/>Drottinn, við vitum að þú munt varðveita þitt fólk frá verkum illra manna, þó svo þeir vaði alls staðar uppi og njóti heiðurs í landinu.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 13:1-2"/> Hversu lengi ætlar þú Drottinn að gleyma mér – að eilífu, eða hvað? Ætlar þú sífellt að horfa í aðra átt þegar ég er í nauðum staddur? <verse eid="PSA 13:1-2"/><verse number="3" style="v" sid="PSA 13:3"/>Hve lengi verð ég að byrgja inni angist mína? Hve lengi eiga óvinir mínir að hreykja sér upp yfir mig? <verse eid="PSA 13:3"/><verse number="4" style="v" sid="PSA 13:4"/>Svara mér Drottinn, Guð minn, og sendu mér ljós þitt, annars er úti um mig!<verse eid="PSA 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 13:5"/>Þaggaðu niður í óvinum mínum sem segja: „Við höfum sigrað hann!“ Láttu þá ekki hlakka yfir því að ógæfa hendi mig.<verse eid="PSA 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 13:6"/>En, – ég mun treysta þér og miskunn þinni hvað sem á gengur og fagna yfir hjálp þinni! <verse eid="PSA 13:6"/><verse number="7" style="v" sid="PSA 13:7"/>Ég vil lofsyngja Drottni, því að ríkulega blessaði hann mig.<verse eid="PSA 13:7"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 14:1"/>En sá heimskingi sem segir: „Guð er ekki til!“ Sá er líka bæði illur og spilltur og einskis góðs af honum að vænta.<verse eid="PSA 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 14:2"/>Drottinn horfir niður af himnum og virðir fyrir sér mennina, hvort einhver sé skynsamur og geri vilja hans. <verse eid="PSA 14:2"/><verse number="3" style="v" sid="PSA 14:3"/>Nei, það gerir enginn þeirra. Allir eru þeir viknir af leið, allir spilltir af synd. Enginn er raunverulega góður, ekki einn einasti! <verse eid="PSA 14:3"/><verse number="4" style="v" sid="PSA 14:4"/>Þeir kúga og kvelja þjóð mína og dettur ekki í hug að ákalla mig! Skyldu þeir ekki fá að kenna á því illgjörðamennirnir?<verse eid="PSA 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 14:5"/>Þeir munu óttast þegar þeir sjá að Guð er með þeim sem elska hann. <verse eid="PSA 14:5"/><verse number="6" style="v" sid="PSA 14:6"/>Hann er skjól hinna hrjáðu og hógværu þegar illgjörðamenn ofsækja þá. <verse eid="PSA 14:6"/><verse number="7" style="v" sid="PSA 14:7"/>Ó, að lausnardagur þeirra væri nú þegar kominn! Að Guð kæmi frá bústað sínum á Síon til bjargar þjóð sinni. En sá gleðidagur þegar Drottinn frelsar Ísrael!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 15:1"/>Drottinn, hver fær að leita skjóls og hælis í tjaldi þínu á fjallinu þínu helga?<verse eid="PSA 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 15:2"/>Sá sem er hógvær og lifir réttlátu lífi. <verse eid="PSA 15:2"/><verse number="3" style="v" sid="PSA 15:3"/>Sá sem ekki baktalar náungann, leggur sig ekki eftir slúðri né gerir meðbróður sínum mein. <verse eid="PSA 15:3"/><verse number="4-5" style="v" pubnumber="4,5" sid="PSA 15:4-5"/> Sá sem andmælir illverkum og fyrirlítur þau. Sá sem heiðrar þá er fylgja Drottni í trúfesti og stendur við orð sín hvað sem það kostar.<verse eid="PSA 15:4-5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 16:1"/>Bjarga mér, ó Guð, því að hjá þér leita ég skjóls. <verse eid="PSA 16:1"/><verse number="2" style="v" sid="PSA 16:2"/>Ég sagði við Drottin: „Þú ert minn Drottinn, þú ert mín eina hjálp.“ <verse eid="PSA 16:2"/><verse number="3" style="v" sid="PSA 16:3"/>Ég þrái samfélag við trúaða fólkið í landinu, á því hef ég alla mína velþóknun. <verse eid="PSA 16:3"/><verse number="4" style="v" sid="PSA 16:4"/>Þeir sem kjósa sér annan guð uppskera þrengingu og tár. Ekki vil ég snerta við fórnum þeirra né nefna guði þeirra á nafn.<verse eid="PSA 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 16:5"/>Drottinn er arfleifð mín. Hann er fjársjóður minn og fögnuður alla daga! Hann verndar allar eigur mínar. <verse eid="PSA 16:5"/><verse number="6" style="v" sid="PSA 16:6"/>Hann hefur gefið mér unaðsreit að erfð. <verse eid="PSA 16:6"/><verse number="7" style="v" sid="PSA 16:7"/>Ég lofa Drottin sem gefur mér góð ráð. Á nóttunni leiðbeinir hann mér og segir mér hvað gera skuli.<verse eid="PSA 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 16:8"/>Drottinn hverfur mér aldrei úr huga. Af því að hann er með mér hrasa ég hvorki né fell. <verse eid="PSA 16:8"/><verse number="9" style="v" sid="PSA 16:9"/>Nú fagnar andi minn, líkami og sál <verse eid="PSA 16:9"/><verse number="10" style="v" sid="PSA 16:10"/>því að þú munt ekki skilja mig eftir meðal hinna dánu né leyfa að þinn elskaði rotni í gröfinni. <verse eid="PSA 16:10"/><verse number="11" style="v" sid="PSA 16:11"/>Þú hefur leyft mér að lifa og fagna. Ég mun njóta þeirrar miklu gleði að lifa með þér að eilífu!<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">Bæn Davíðs</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 17:1"/>Drottinn, ó hjálpa þú mér, því að ég er heiðvirður og breytni mín réttlát. Hlustaðu þegar ég hrópa til þín! <verse eid="PSA 17:1"/><verse number="2" style="v" sid="PSA 17:2"/>Úrskurða mig réttlátan svo að allir heyri, þú réttvísi Drottinn. <verse eid="PSA 17:2"/><verse number="3" style="v" sid="PSA 17:3"/>Þú hefur prófað mig, já jafnvel um nætur, en engar illar hugsanir fundið hjá mér, né vond orð mér á vörum.<verse eid="PSA 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 17:4"/>Boðorðum þínum hef ég hlýtt og forðast félagsskap við illmenni og rudda. <verse eid="PSA 17:4"/><verse number="5" style="v" sid="PSA 17:5"/>Ég hef fylgt leiðsögn þinni og ekki farið villur vegar. <verse eid="PSA 17:5"/><verse number="6" style="v" sid="PSA 17:6"/>Ég ákalla þig því að ég veit að þú svarar mér! Já, hlustaðu á bæn mína. <verse eid="PSA 17:6"/><verse number="7" style="v" sid="PSA 17:7"/>Sýndu mér kærleika þinn og náð, þú sem frelsar hina ofsóttu. <verse eid="PSA 17:7"/><verse number="8" style="v" sid="PSA 17:8"/>Vernda mig eins og sjáaldur augans. Hyl mig í skjóli vængja þinna.<verse eid="PSA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 17:9"/>Óvinir mínir umkringja mig með morðsvip í augum. <verse eid="PSA 17:9"/><verse number="10" style="v" sid="PSA 17:10"/>Þeir eru óguðlegir og beita mig ofbeldi. Hlustaðu á tal þeirra! Hvílíkur hroki! <verse eid="PSA 17:10"/><verse number="11" style="v" sid="PSA 17:11"/>Þeir koma nær og nær, ákveðnir í að troða mig undir. <verse eid="PSA 17:11"/><verse number="12" style="v" sid="PSA 17:12"/>Þeir líkjast gráðugum ljónum sem vilja rífa mig á hol – ungum ljónum sem liggja í leyni og bíða eftir bráð.<verse eid="PSA 17:12"/></para>
  <para style="p">
    <verse number="13-14" style="v" pubnumber="13,14" sid="PSA 17:13-14"/> Drottinn, rís þú upp og hastaðu á þá! Rektu þá frá! Komdu og frelsaðu mig frá hinum óguðlegu sem aðeins leita jarðnesks ávinnings, þeim sem þú hefur gefið auð og völd og ótal afkomendur.<verse eid="PSA 17:13-14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 17:15"/>En ég sækist ekki eftir veraldlegum auði, heldur því að þekkja þig og lifa réttvíslega – vera sáttur við þig. Ég vil hugsa um þig jafnt á degi sem nóttu og þegar ég vakna mun ég sjá auglit þitt og gleðjast!<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 18:1"/>Þennan sálm orti Davíð eftir að Drottinn hafði frelsað hann undan óvinum hans, þeirra á meðal Sál konungi.<verse eid="PSA 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 18:2"/>Drottinn – ég elska þig! Þú hefur gert stórkostlega hluti fyrir mig! <verse eid="PSA 18:2"/><verse number="3" style="v" sid="PSA 18:3"/>Drottinn er vígi mitt, þar er ég öruggur. Enginn getur veitt mér eftirför og unnið á mér. Hann er felustaður minn, frelsari og varðborg, kletturinn þar sem enginn getur náð mér! Hann er skjöldur minn. Styrkur hans er eins og uxans sem mundar horn sín í vígahug! <verse eid="PSA 18:3"/><verse number="4" style="v" sid="PSA 18:4"/>Mér nægir að ákalla hann – lof sé Guði! – og ég frelsast undan öllum óvinum mínum.<verse eid="PSA 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 18:5"/>Ég var bundinn hlekkjum dauðans og holskeflur óguðlegra risu ógnandi gegn mér. <verse eid="PSA 18:5"/><verse number="6" style="v" sid="PSA 18:6"/>Umkringdur og hjálparvana barðist ég um í netinu sem dró mig niður í djúp dauðans.<verse eid="PSA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 18:7"/>Þá hrópaði ég til Drottins. – Hróp mitt náði eyrum hans á himnum! <verse eid="PSA 18:7"/><verse number="8" style="v" sid="PSA 18:8"/>Þá lyftist jörðin og nötraði og undirstöður fjallanna skulfu vegna bræði hans. Hvílíkur landskjálfti! Já, Drottinn reiddist. <verse eid="PSA 18:8"/><verse number="9" style="v" sid="PSA 18:9"/>Eldsblossar gengu út af munni hans svo að jörðin sviðnaði og reykur streymdi um nasir hans. <verse eid="PSA 18:9"/><verse number="10" style="v" sid="PSA 18:10"/>Hann sveigði himininn og steig niður mér til bjargar! Skýjasorti var undir fótum hans. <verse eid="PSA 18:10"/><verse number="11" style="v" sid="PSA 18:11"/>Hann steig á bak kerúbi og sveif til mín með hraða vindsins. <verse eid="PSA 18:11"/><verse number="12" style="v" sid="PSA 18:12"/>Hann skýldi sér með myrkri, leyndi komu sinni með regnsorta og dimmu skýi. <verse eid="PSA 18:12"/><verse number="13" style="v" sid="PSA 18:13"/>En svo birtist hann í skýjunum! Hvílík hátign! Eldingar leiftruðu og haglið dundi!<verse eid="PSA 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 18:14"/>Himnarnir nötruðu í þrumugný Drottins. Guð allra guða hafði talað! <verse eid="PSA 18:14"/><verse number="15" style="v" sid="PSA 18:15"/>Hann sendi út eldingar sínar sem örvar og tvístraði óvinum mínum. Sjá, hvernig þeir flýðu! <verse eid="PSA 18:15"/><verse number="16" style="v" sid="PSA 18:16"/>Þá hljómaði skipun Drottins – og hafið hopaði og það sá í mararbotn!<verse eid="PSA 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 18:17"/>Þá seildist Drottinn niður frá himnum, greip mig og frelsaði mig úr neyðinni. Hann bjargaði mér úr hyldýpi dauðans.<verse eid="PSA 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 18:18"/>Hann frelsaði mig frá ofurafli óvinarins, úr höndum þeirra sem hötuðu mig, því í greipum þeirra mátti ég mín einskis.<verse eid="PSA 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 18:19"/>Þeir réðust á mig þegar ég mátti mín einskis, en Drottinn studdi mig. <verse eid="PSA 18:19"/><verse number="20" style="v" sid="PSA 18:20"/>Hann leiddi mig í öruggt skjól, því að hann hefur velþóknun á mér. <verse eid="PSA 18:20"/><verse number="21" style="v" sid="PSA 18:21"/>Drottinn launaði mér réttlæti mitt og hreinleika. <verse eid="PSA 18:21"/><verse number="22" style="v" sid="PSA 18:22"/>Því að ég hef hlýtt boðorðum hans og ekki syndgað með því að snúa í hann baki. <verse eid="PSA 18:22"/><verse number="23" style="v" sid="PSA 18:23"/>Ég gætti lögmáls hans í hvívetna og lítilsvirti enga grein þess. <verse eid="PSA 18:23"/><verse number="24" style="v" sid="PSA 18:24"/>Ég lagði mig fram við að halda það og forðaðist ranglæti. <verse eid="PSA 18:24"/><verse number="25" style="v" sid="PSA 18:25"/>Þess vegna hefur Drottinn launað mér með blessun, því að ég gerði það sem rétt var og gætti hreinleika hjarta míns. Allt þetta þekkti hann, enda vakir hann yfir hverju skrefi mínu.<verse eid="PSA 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PSA 18:26"/>Drottinn, þú miskunnar þeim sem auðsýna miskunn og ert góður við ráðvanda. <verse eid="PSA 18:26"/><verse number="27" style="v" sid="PSA 18:27"/>Þú blessar hjartahreina en snýrð þér frá þeim sem yfirgefa þig. <verse eid="PSA 18:27"/><verse number="28" style="v" sid="PSA 18:28"/>Þú hlífir hinum hógværu, en ávítar stolta og hrokafulla. <verse eid="PSA 18:28"/><verse number="29" style="v" sid="PSA 18:29"/>Já, þú lætur lampa minn skína. Drottinn, Guð minn, hefur lýst upp myrkrið sem umlukti mig. <verse eid="PSA 18:29"/><verse number="30" style="v" sid="PSA 18:30"/>Með þinni hjálp stekk ég yfir múra og brýt niður borgarveggi óvinarins.<verse eid="PSA 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PSA 18:31"/>Drottinn, hann er mikill Guð! Fullkominn í öllum hlutum! Orð hans standast öll. Skjöldur er hann öllum þeim sem til hans leita. <verse eid="PSA 18:31"/><verse number="32" style="v" sid="PSA 18:32"/>Því hver er hinn sanni Guð nema Drottinn? Og hver er bjargið nema hann?<verse eid="PSA 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PSA 18:33"/>Hann styrkir mig og verndar hvar sem ég fer. <verse eid="PSA 18:33"/><verse number="34" style="v" sid="PSA 18:34"/>Hann gerir fætur mína fima sem geitanna á fjöllunum. Hann tryggir mér fótfestu á hæstu tindum. <verse eid="PSA 18:34"/><verse number="35" style="v" sid="PSA 18:35"/>Hann æfir hendur mínar til hernaðar og gerir mér kleift að spenna eirbogann.<verse eid="PSA 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="PSA 18:36"/>Þú fékkst mér skjöld hjálpræðis þíns. Hægri hönd þín, Drottinn, styður mig, mildi þín hefur gert mig mikinn. <verse eid="PSA 18:36"/><verse number="37" style="v" sid="PSA 18:37"/>Þú lagðir veg fyrir fætur mína og þar mun ég ekki hrasa. <verse eid="PSA 18:37"/><verse number="38" style="v" sid="PSA 18:38"/>Ég veitti óvinum mínum eftirför, elti þá uppi og eyddi þeim. <verse eid="PSA 18:38"/><verse number="39" style="v" sid="PSA 18:39"/>Ég tók þá einn af öðrum – þeir gátu enga vörn sér veitt – allir lágu í valnum að lokum. <verse eid="PSA 18:39"/><verse number="40" style="v" sid="PSA 18:40"/>Hjálpin frá þér var eins og brynja í bardaganum. Óvini mína beygðir þú undir mig. <verse eid="PSA 18:40"/><verse number="41" style="v" sid="PSA 18:41"/>Þú stökktir þeim á flótta og ég eyddi öllum þeim sem ofsóttu mig.<verse eid="PSA 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="PSA 18:42"/>Þeir hrópuðu á hjálp, en fengu enga. Þeir æptu til Drottins, en hann ansaði ekki, <verse eid="PSA 18:42"/><verse number="43" style="v" sid="PSA 18:43"/>en ég muldi þá mélinu smærra og dreifði þeim upp í vindinn. Ég fleygði þeim burt eins og rusli á haug. <verse eid="PSA 18:43"/><verse number="44-46" style="v" sid="PSA 18:44-46"/>Þú veittir mér sigur í sérhverri orustu. Þjóðirnar komu og þjónuðu mér. Jafnvel þær sem ég þekkti ekki komu nú og veittu mér lotningu. Útlendingar sem aldrei höfðu mig augum litið lýstu sig reiðubúna til þjónustu. Skjálfandi stigu þeir niður úr virkjum sínum.<verse eid="PSA 18:44-46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="PSA 18:47"/>Guð lifir! Lofaður sé hann, klettur hjálpræðis míns. <verse eid="PSA 18:47"/><verse number="48" style="v" sid="PSA 18:48"/>Hann er sá Guð sem endurgeldur þeim sem ofsækja mig og auðmýkir þjóðir fyrir augum mér.<verse eid="PSA 18:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="PSA 18:49"/>Hann frelsar mig frá óvinum mínum. Hann sér til þess að þeir ná ekki til mín og bjargar mér undan öflugum andstæðingum.<verse eid="PSA 18:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="PSA 18:50"/>Fyrir þetta, Drottinn minn, lofa ég þig í áheyrn þjóðanna. <verse eid="PSA 18:50"/><verse number="51" style="v" sid="PSA 18:51"/>Oftsinnis hefur þú frelsað mig – það var kraftaverk í öll skiptin! Þú gerðir mig að konungi, þú hefur elskað mig og auðsýnt mér gæsku og eins muntu gera við afkomendur mína.<verse eid="PSA 18:51"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 19:1-2"/> Himnarnir sýna okkur dýrð Guðs. Þeir eru þögull vitnisburður um mikilleik verka hans. <verse eid="PSA 19:1-2"/><verse number="3" style="v" sid="PSA 19:3"/>Dagur og nótt vitna um vísdóm Drottins. <verse eid="PSA 19:3"/><verse number="4-5" style="v" pubnumber="4,5" sid="PSA 19:4-5"/> Hljóðlaust og án orða bera þau boðin um gervalla jörðina. Sólin fer sína braut um loftin – einmitt þá sem Drottinn setti henni í upphafi. <verse eid="PSA 19:4-5"/><verse number="6" style="v" sid="PSA 19:6"/>Hnarreist siglir hún yfir hvolfið, geislandi eins og brúður í brúðkaupi eða hlaupari sem hlakkar til að renna sitt skeið. <verse eid="PSA 19:6"/><verse number="7" style="v" sid="PSA 19:7"/>Sólin fer um himininn frá austri til vesturs, ekkert fær dulist við geislaflóð hennar og yl.<verse eid="PSA 19:7"/></para>
  <para style="p">
    <verse number="8-9" style="v" pubnumber="8,9" sid="PSA 19:8-9"/> Lög Guðs eru fullkomin. Þau vernda og auka skilning, gleðja og lýsa. <verse eid="PSA 19:8-9"/><verse number="10" style="v" sid="PSA 19:10"/>Lög Guðs eru eilíf, réttlát og hrein. <verse eid="PSA 19:10"/><verse number="11" style="v" sid="PSA 19:11"/>Þau eru dýrmætari en gull. Þau eru sætari en hunang. <verse eid="PSA 19:11"/><verse number="12" style="v" sid="PSA 19:12"/>Því að þau vara okkur við hættum og efla velgengni þeirra sem hlýða þeim.<verse eid="PSA 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 19:13"/>Hver verður var við syndina sem loðir við hjarta mitt? Hreinsa mig af leyndum syndum. <verse eid="PSA 19:13"/><verse number="14" style="v" sid="PSA 19:14"/>Forða mér frá vondum mönnum, og stöðva hönd mína að ég geri ekkert ljótt. Sýknaðu mig af syndum mínum svo að ég lifi hreinu lífi.<verse eid="PSA 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 19:15"/>Ó, að orðin á vörum mér og hugsanir mínar geðjist þér, þú Guð, klettur minn og frelsari.<verse eid="PSA 19:15"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 20:1-2"/> Drottinn sé með þér og bænheyri þig á degi neyðarinnar! Guð Jakobs frelsi þig frá allri ógæfu. <verse eid="PSA 20:1-2"/><verse number="3" style="v" sid="PSA 20:3"/>Hann sendi þér hjálp frá helgidómi sínum, styðji þig frá Síon. <verse eid="PSA 20:3"/><verse number="4" style="v" sid="PSA 20:4"/>Hann minnist með gleði gjafa þinna og brennifórna. <verse eid="PSA 20:4"/><verse number="5" style="v" sid="PSA 20:5"/>Hann veiti þér það sem hjarta þitt þráir og láti öll þín áform ná fram að ganga.<verse eid="PSA 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 20:6"/>Þegar við fréttum um sigur þinn, munum við hrópa fagnaðaróp og veifa fánanum Guði til dýrðar, því að mikla hluti hefur hann gert fyrir þig. Hann veiti svör við öllum þínum bænum!<verse eid="PSA 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 20:7"/>Guð blessi konunginn! – Já, það mun hann vissulega gera! í himinhæðum heyrir hann bæn mína og veitir mér mikinn sigur.<verse eid="PSA 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 20:8"/>Hinir stæra sig af herstyrk og vopnavaldi, en við af Drottni, Guði. <verse eid="PSA 20:8"/><verse number="9" style="v" sid="PSA 20:9"/>Þjóðir þessar munu hrasa og farast, en við rísa og standa traustum fótum.<verse eid="PSA 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 20:10"/>Drottinn, sendu konungi okkar sigur! Drottinn, heyr þú bænir okkar.<verse eid="PSA 20:10"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 21:1-2"/> Drottinn! Yfir valdi þínu og mætti fagnar konungurinn. Hann gleðst stórlega yfir hjálp þinni! <verse eid="PSA 21:1-2"/><verse number="3" style="v" sid="PSA 21:3"/>Því að þú hefur veitt honum það sem hjarta hans þráir, allt sem hann bað þig um!<verse eid="PSA 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 21:4"/>Þú leiddir hann til valda og veittir honum velgengni og blessun. Þú krýndir hann kórónu úr gulli. <verse eid="PSA 21:4"/><verse number="5" style="v" sid="PSA 21:5"/>Hann bað um langa ævi og góða daga og þú heyrðir bænir hans. Ævidagar hans munu aldrei taka enda! <verse eid="PSA 21:5"/><verse number="6" style="v" sid="PSA 21:6"/>Frægð og frama gafst þú honum, íklæddir hann vegsemd og dýrð. <verse eid="PSA 21:6"/><verse number="7" style="v" sid="PSA 21:7"/>Þú veitir honum eilífa blessun og gleður hann með nærveru þinni meira en orð fá lýst. <verse eid="PSA 21:7"/><verse number="8" style="v" sid="PSA 21:8"/>Konungurinn treystir Drottni og því mun hann aldrei hrasa né falla. Hann reiðir sig á elsku og trúfesti þess Guðs sem er æðri öllum guðum.<verse eid="PSA 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 21:9"/>Drottinn, hönd þín mun ná öllum óvinum þínum og hatursmönnum. <verse eid="PSA 21:9"/><verse number="10-11" style="v" pubnumber="10,11" sid="PSA 21:10-11"/> Þegar þú stígur fram eyðast þeir í eldinum sem út frá þér gengur. Drottinn mun afmá þá og afkomendur þeirra.<verse eid="PSA 21:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 21:12"/>Samsæri hafa þeir gert gegn þér Drottinn, en það mun ekki takast. <verse eid="PSA 21:12"/><verse number="13" style="v" sid="PSA 21:13"/>Þegar þeir sjá boga þinn spenntan, flýja þeir sem fætur toga.<verse eid="PSA 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 21:14"/>Drottinn, þinn er mátturinn og dýrðin! Heyr þú lofgjörð okkar! Um máttarverk þín syngjum við og kveðum!.<verse eid="PSA 21:14"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 22:1-2"/> Guð minn, Guð minn, hví hefur þú yfirgefið mig? Hví ert þú þögull og hjálpar ekki þegar ég hrópa til þín í neyð minni? <verse eid="PSA 22:1-2"/><verse number="3" style="v" sid="PSA 22:3"/>Daga og nætur græt ég og ákalla þig, en fæ ekkert svar! <verse eid="PSA 22:3"/><verse number="4-5" style="v" pubnumber="4,5" sid="PSA 22:4-5"/> – En samt ert þú hinn heilagi og lofsöngvar Ísraels óma umhverfis hásæti þitt. Feðurnir treystu þér og þú frelsaðir þá. <verse eid="PSA 22:4-5"/><verse number="6" style="v" sid="PSA 22:6"/>Þú heyrðir er þeir hrópuðu til þín, brást við og bjargaðir þeim. Vonir þeirra brugðust ekki þegar þeir leituðu til þín.<verse eid="PSA 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 22:7"/>En ég er maðkur en ekki maður! Hræddur og fyrirlitinn af minni eigin þjóð – já öllum mönnum. <verse eid="PSA 22:7"/><verse number="8" style="v" sid="PSA 22:8"/>Þeir sem sjá mig hrista höfuðið og senda mér tóninn. <verse eid="PSA 22:8"/><verse number="9" style="v" sid="PSA 22:9"/>„Er þetta sá sem treysti Drottni fyrir málum sínum?“ segja þeir og hlæja. „Sá sem taldi sig öruggan um velþóknun Guðs? Því trúum við ekki fyrr en við sjáum Drottin hjálpa honum.“<verse eid="PSA 22:9"/></para>
  <para style="p">
    <verse number="10-12" style="v" sid="PSA 22:10-12"/>Drottinn, oft hefur þú hjálpað mér. Móðir mín fæddi mig heilbrigðan í heiminn og þar varst þú til staðar og gættir mín, eins og öll mín bernskuár. Frá fæðingu hef ég átt allt undir þér. Þú varst minn Guð allt frá fyrstu stundu. Yfirgef mig ekki nú, nei ekki núna á neyðarstundu þegar enginn getur hjálpað nema þú!<verse eid="PSA 22:10-12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 22:13"/>Ég er umkringdur illmennum. Þeir líkjast sterkum basan – uxum. <verse eid="PSA 22:13"/><verse number="14" style="v" sid="PSA 22:14"/>Þeir æða að mér með opinn skoltinn, eins og öskrandi ljón sem ræðst á bráðina. <verse eid="PSA 22:14"/><verse number="15" style="v" sid="PSA 22:15"/>Þrek mitt fjaraði út, rann út í sandinn og bein mín gliðnuðu sundur. Hjartað er bráðnað í brjósti mér <verse eid="PSA 22:15"/><verse number="16" style="v" sid="PSA 22:16"/>og tungan þurr eins og brenndur leir. Þú lætur mig horfast í augu við dauðann. <verse eid="PSA 22:16"/><verse number="17" style="v" sid="PSA 22:17"/>Hópur illvirkja hefur umkringt mig. Eins og hundar slá þeir hring um mig. Hendur mínar og fætur hafa þeir gegnumstungið. <verse eid="PSA 22:17"/><verse number="18" style="v" sid="PSA 22:18"/>Ég get talið öll mín bein. Þeir stara á mig og senda mér háðsglósur. <verse eid="PSA 22:18"/><verse number="19" style="v" sid="PSA 22:19"/>Þeir skipta á milli sín klæðum mínum og varpa hlutkesti um kyrtil minn.<verse eid="PSA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 22:20"/>Ó, Drottinn, vertu ekki fjarri! Drottinn, styrkur minn, skunda mér til hjálpar! <verse eid="PSA 22:20"/><verse number="21" style="v" sid="PSA 22:21"/>Bjargaðu mér frá dauða, frá því að falla fyrir hendi kúgarans. <verse eid="PSA 22:21"/><verse number="22" style="v" sid="PSA 22:22"/>Frelsaðu mig úr gini þessara varga, undan hornum uxanna!<verse eid="PSA 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 22:23"/>Ég vil lofa þig meðal bræðra minna, standa upp í söfnuðinum og vitna um þín undursamlegu verk. <verse eid="PSA 22:23"/><verse number="24" style="v" sid="PSA 22:24"/>Ég segi: „Lofið Drottin, allir þið sem óttist hann, hver og einn ykkar heiðri hann og tigni. Allur Ísrael lofsyngi honum, <verse eid="PSA 22:24"/><verse number="25" style="v" sid="PSA 22:25"/>því að hann hefur ekki fyrirlitið ákall mitt um hjálp, ekki snúið við mér baki í eymd minni. Hann heyrði hróp mitt og kom!“<verse eid="PSA 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PSA 22:26"/>Ég vil rísa á fætur og vegsama þig fyrir augum þjóðar minnar. Heit mín vil ég efna í áheyrn allra þeirra sem elska þig og heiðra. <verse eid="PSA 22:26"/><verse number="27" style="v" sid="PSA 22:27"/>Fátæklingurinn mun eta sig saddan og allir þeir sem leita Drottins munu finna hann og vegsama nafn hans. Hjörtu þeirra munu fagna að eilífu. <verse eid="PSA 22:27"/><verse number="28" style="v" sid="PSA 22:28"/>Öll jörðin mun sjá það og snúa sér til Drottins, og fólk af öllum þjóðum mun vegsama hann.<verse eid="PSA 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PSA 22:29"/>Því að Drottinn er konungur yfir öllum þjóðum. <verse eid="PSA 22:29"/><verse number="30" style="v" sid="PSA 22:30"/>Jafnt háir sem lágir, allir dauðlegir menn, lúti honum og lofi hann. <verse eid="PSA 22:30"/><verse number="31" style="v" sid="PSA 22:31"/>Og börnin okkar, – einnig þau munu þjóna honum því þau hafa heyrt vitnisburð okkar um hann. <verse eid="PSA 22:31"/><verse number="32" style="v" sid="PSA 22:32"/>Ófæddar kynslóðir munu heyra um máttarverk hans okkar á meðal.<verse eid="PSA 22:32"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 23:1"/>Drottinn er minn hirðir, mig mun ekkert skorta.<verse eid="PSA 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 23:2"/>Hann lætur mig hvílast á grænum grundum og njóta næðis hjá lygnum vötnum. <verse eid="PSA 23:2"/><verse number="3" style="v" sid="PSA 23:3"/>Hann hressir mig og styrkir og leiðir mig réttan veg. Hann hjálpar mér, nafni sínu til vegsemdar.<verse eid="PSA 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 23:4"/>Og jafnvel þótt ég fari um dimman dal, óttast ég ekkert illt, því að þú ert hjá mér og hughreystir mig!<verse eid="PSA 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 23:5"/>Já, og þú heldur mér veislu frammi fyrir fjendum mínum og þeir geta ekkert við því gert! Þú smyrð höfuð mitt með blessun og annast ríkulega allar mínar þarfir.<verse eid="PSA 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 23:6"/>Gæska þín og velþóknun fylgja mér alla ævidaga mína og síðan fæ ég að búa hjá þér að eilífu!<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 24:1"/>Jörðin er eign Drottins og allt sem á henni er, – heimurinn og þeir sem í honum búa. <verse eid="PSA 24:1"/><verse number="2" style="v" sid="PSA 24:2"/>Það var hann sem safnaði vötnunum saman svo að hafið varð til og þurrlendið birtist.<verse eid="PSA 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 24:3"/>Hver fær að stíga upp á fjall Drottins og ganga inn í bústað hans? Hver fær staðist frammi fyrir honum? <verse eid="PSA 24:3"/><verse number="4" style="v" sid="PSA 24:4"/>Aðeins þeir sem hafa hreint hjarta og óflekkaðar hendur, heiðarlegt fólk sem segir sannleikann. <verse eid="PSA 24:4"/><verse number="5" style="v" sid="PSA 24:5"/>Þeir munu njóta gæsku Guðs, og hann, frelsari þeirra, mun lýsa þá réttláta. <verse eid="PSA 24:5"/><verse number="6" style="v" sid="PSA 24:6"/>Það eru þeir sem fá að standa frammi fyrir Drottni og tilbiðja hann, Guð Jakobs.<verse eid="PSA 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 24:7"/>Opnist þið fornu dyr! Konungur dýrðarinnar vill ganga inn. <verse eid="PSA 24:7"/><verse number="8" style="v" sid="PSA 24:8"/>Hver er konungur dýrðarinnar? Það er Drottinn, hinn voldugi og sterki, sigurhetjan. <verse eid="PSA 24:8"/><verse number="9" style="v" sid="PSA 24:9"/>Já, opnist þið ævafornu dyr fyrir konungi dýrðarinnar!<verse eid="PSA 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 24:10"/>Hver er þessi konungur dýrðarinnar? Drottinn, sá er ræður öllum hersveitum himnanna, hann er konungur dýrðarinnar!<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 25:1"/>Drottinn, ég sendi bæn mína upp til þín. <verse eid="PSA 25:1"/><verse number="2" style="v" sid="PSA 25:2"/>Hafnaðu mér ekki, Drottinn, því að ég treysti þér. Láttu ekki óvini mína yfirbuga mig. Láttu þá ekki vinna sigur. <verse eid="PSA 25:2"/><verse number="3" style="v" sid="PSA 25:3"/>Sá sem treystir Drottni, mun ekki verða til skammar en hinir ótrúu verða það.<verse eid="PSA 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 25:4"/>Drottinn, sýndu mér þann veg sem ég á að ganga, bentu mér á réttu leiðina. <verse eid="PSA 25:4"/><verse number="5" style="v" sid="PSA 25:5"/>Leiddu mig og kenndu mér því að þú ert sá eini Guð sem getur hjálpað. Á þig einan vona ég. <verse eid="PSA 25:5"/><verse number="6-7" style="v" pubnumber="6,7" sid="PSA 25:6-7"/> Drottinn, minnstu ekki æskusynda minna. Líttu til mín miskunnaraugum og veittu mér náð. Minnstu mín í elsku þinni og gæsku, Drottinn minn.<verse eid="PSA 25:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 25:8"/>Drottinn er góður og fús að vísa þeim rétta leið, sem villst hafa. <verse eid="PSA 25:8"/><verse number="9" style="v" sid="PSA 25:9"/>Hann sýnir þeim rétta leið sem leita hans með auðmjúku hjarta. <verse eid="PSA 25:9"/><verse number="10" style="v" sid="PSA 25:10"/>Þeir sem hlýða Drottni fá að ganga á hans vegum og upplifa elsku hans og trúfesti.<verse eid="PSA 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 25:11"/>En Drottinn, hvað um syndir mínar? Æ, þær eru svo margar! Fyrirgef þú mér vegna elsku þinnar og nafni þínu til dýrðar.<verse eid="PSA 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 25:12"/>Sá maður sem óttast Drottin – heiðrar hann og hlýðir honum – mun njóta leiðsagnar Guðs í lífinu. <verse eid="PSA 25:12"/><verse number="13" style="v" sid="PSA 25:13"/>Hann verður gæfumaður og börn hans erfa landið.<verse eid="PSA 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 25:14"/>Drottinn sýnir trúnað og vináttu þeim sem óttast hann. Hann trúir þeim fyrir leyndarmálum sínum!<verse eid="PSA 25:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 25:15"/>Ég mæni á Drottin í von um hjálp, því að hann einn getur frelsað mig frá dauða. <verse eid="PSA 25:15"/><verse number="16" style="v" sid="PSA 25:16"/>Kom þú, Drottinn, og miskunna mér, því að ég er hrjáður og hjálparlaus og <verse eid="PSA 25:16"/><verse number="17" style="v" sid="PSA 25:17"/>vandi minn fer stöðugt vaxandi. Ó, frelsaðu mig úr neyð minni! <verse eid="PSA 25:17"/><verse number="18" style="v" sid="PSA 25:18"/>Líttu á eymd mína og sársauka og fyrirgefðu mér syndir mínar!<verse eid="PSA 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 25:19"/>Sjáðu óvini mína og hve þeir hata mig!<verse eid="PSA 25:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 25:20"/>Frelsaðu mig frá þessu öllu! Bjargaðu mér úr klóm þeirra! Láttu engan segja að ég hafi treyst þér án árangurs.<verse eid="PSA 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 25:21"/>Láttu hreinskilni og heiðarleika vernda mig – já vera lífverði mína! Ég reiði mig á vernd þína. <verse eid="PSA 25:21"/><verse number="22" style="v" sid="PSA 25:22"/>Ó, Guð, frelsa þú Ísrael úr öllum nauðum hans.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 26:1"/>Drottinn, láttu mig ná rétti mínum, því að ég hef kappkostað að halda boð þín og treyst þér af öllu hjarta. <verse eid="PSA 26:1"/><verse number="2" style="v" sid="PSA 26:2"/>Rannsakaðu mig yst sem innst, Drottinn, og prófaðu viðhorf mín og einlægni. <verse eid="PSA 26:2"/><verse number="3" style="v" sid="PSA 26:3"/>Afstaða mín til lífsins og allra hluta mótaðist hjá þér. Þú kenndir mér elsku og sannleika. <verse eid="PSA 26:3"/><verse number="4" style="v" sid="PSA 26:4"/>Ég forðast félagsskap hræsnara og þeirra sem tala lygi. <verse eid="PSA 26:4"/><verse number="5" style="v" sid="PSA 26:5"/>Ég hef andstyggð á samkundum syndaranna og stíg ekki fæti þar inn. <verse eid="PSA 26:5"/><verse number="6" style="v" sid="PSA 26:6"/>Ég þvæ hendur mínar, gef til kynna sakleysi mitt og geng að altari þínu <verse eid="PSA 26:6"/><verse number="7" style="v" sid="PSA 26:7"/>með þakkargjörð á vörum, minnugur máttarverka þinna.<verse eid="PSA 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 26:8"/>Drottinn, ég elska hús þitt – helgidóminn þar sem dýrð þín birtist! <verse eid="PSA 26:8"/><verse number="9-10" style="v" pubnumber="9,10" sid="PSA 26:9-10"/> Láttu mér ekki farnast eins og syndurum og morðingjum eða þeim sem beita saklausa menn vélráðum og heimta mútur.<verse eid="PSA 26:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 26:11"/>Nei, með slíkum á ég enga samleið. Ég geng hinn beina, en bratta veg sannleikans. Miskunna mér og frelsa mig. <verse eid="PSA 26:11"/><verse number="12" style="v" sid="PSA 26:12"/>Opinskátt og í áheyrn allra lofa ég Drottin, hann sem ver mig hrösun og falli.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 27:1"/>Drottinn er ljós mitt og frelsari, hvern ætti ég að óttast? Hann er skjól mitt og vígi, og því hræðist ég ekki.<verse eid="PSA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 27:2"/>Þegar illmenni reyna að uppræta mig, þá hrasa þeir sjálfir og falla. <verse eid="PSA 27:2"/><verse number="3" style="v" sid="PSA 27:3"/>Þótt voldugur her umkringi mig á alla vegu, þá óttast ég ekki hót! Ég er öruggur og veit að Guð mun frelsa mig.<verse eid="PSA 27:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 27:4"/>Drottinn, þetta þrái ég mest af öllu: Að hugleiða í helgidómi þínum, og vera frammi fyrir þér alla mína ævidaga. Þar vil ég gleðjast yfir dýrð hans og fullkomnun, hún er engu lík! <verse eid="PSA 27:4"/><verse number="5" style="v" sid="PSA 27:5"/>Þar verð ég öruggur á óheilladeginum – öruggur í skjóli Drottins. Hann lyftir mér upp á háan klett <verse eid="PSA 27:5"/><verse number="6" style="v" sid="PSA 27:6"/>þar sem óvinirnir ná ekki til mín. Þá mun ég færa honum fórnir og lofa hann fagnandi. <verse eid="PSA 27:6"/><verse number="7" style="v" sid="PSA 27:7"/>Drottinn, heyrðu hróp mitt! Ég kalla hátt! Sendu mér miskunn þína og hjálp!<verse eid="PSA 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 27:8"/>Drottinn, ég minnist þess sem þú sagðir: „Þú þjóð mín, kom þú og leitaðu mín.“ „Já, Drottinn! Ég kem!“ svara ég.<verse eid="PSA 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 27:9"/>Drottinn, hyl þig ekki fyrir mér. Hafnaðu ekki þjóni þínum í reiði. Þú varst mér skjól þegar á móti blés, yfirgefðu mig ekki. Hafnaðu mér ekki, þú Guð hjálpræðis míns. <verse eid="PSA 27:9"/><verse number="10" style="v" sid="PSA 27:10"/>Þótt faðir minn og móðir vísuðu mér á bug, þá tækir þú mér tveim höndum og huggaðir mig.<verse eid="PSA 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 27:11"/>Drottinn, hvað á ég til bragðs að taka? Svaraðu mér fljótt! Óvinir umkringja mig! <verse eid="PSA 27:11"/><verse number="12" style="v" sid="PSA 27:12"/>Láttu þá ekki ná mér, Drottinn! Láttu mig ekki falla þeim í hendur! Þeir ásaka mig að ástæðulausu og sitja á svikráðum við mig. <verse eid="PSA 27:12"/><verse number="13" style="v" sid="PSA 27:13"/>En ég treysti því að Drottinn frelsi mig og að ég sjái hjálp hans, því að enn er von, – enn er ég á lífi!<verse eid="PSA 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 27:14"/>Þú, hver sem þú ert, misstu ekki vonina! Treystu Drottni og hann mun frelsa þig! Vertu hugrakkur og djarfur og óttastu ekki. Bíddu um stund og hann mun senda þér hjálp!<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 28:1"/>Ég hrópa til þín um hjálp, Drottinn, því að þú ert klettur hjálpræðis míns. Ef þú hjálpaðir ekki væri úti um mig. Framundan væri ekkert nema dauðinn. <verse eid="PSA 28:1"/><verse number="2" style="v" sid="PSA 28:2"/>Drottinn, ég lyfti höndum til himins og ákalla þig um hjálp. Ó, heyr þú grátbeiðni mína!<verse eid="PSA 28:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 28:3"/>Drottinn, refsaðu mér ekki ásamt illgjörðamönnunum, þeim sem sitja á svikráðum við nágranna sína. <verse eid="PSA 28:3"/><verse number="4" style="v" sid="PSA 28:4"/>Refsaðu þeim eins og rétt er. Illvirki þeirra eiga skilið réttlátan dóm. <verse eid="PSA 28:4"/><verse number="5" style="v" sid="PSA 28:5"/>Þeir hugsa ekkert um Guð, sköpun hans og verk. Þess vegna mun Guð ryðja þeim úr vegi, rífa þá eins og ónýtt hús sem ekki verður endurreist.<verse eid="PSA 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 28:6"/>Lofaður sé Drottinn! Hann heyrði grátbeiðni mína! <verse eid="PSA 28:6"/><verse number="7" style="v" sid="PSA 28:7"/>Hann er styrkur minn, skjól mitt gegn öllum árásum. Honum treysti ég og hann hjálpaði mér. Gleðin svellur í brjósti mér og brýst út í lofgjörð til hans! <verse eid="PSA 28:7"/><verse number="8" style="v" sid="PSA 28:8"/>Drottinn verndar sitt fólk og veitir konungi sínum sigur.<verse eid="PSA 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 28:9"/>Stattu vörð um þjóð þína, Drottinn! Vernda og blessa þitt útvalda fólk. Eins og fjárhirðir leiðir sauði sína, þá leið og vernda þjóð þína að eilífu.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 29:1"/>Þið englar Drottins, lofið hann í mætti hans og dýrð! <verse eid="PSA 29:1"/><verse number="2" style="v" sid="PSA 29:2"/>Lofið hann í mikilleik dýrðar hans, þeirri dýrð er stafar af nafni hans. Tilbiðjið hann í helgum skrúða.<verse eid="PSA 29:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 29:3"/>Raust Drottins fyllir himininn, hún kveður við eins og þruma! <verse eid="PSA 29:3"/><verse number="4" style="v" sid="PSA 29:4"/>Rödd hans hljómar kröftuglega, hún hljómar af mikilleik og tign. <verse eid="PSA 29:4"/><verse number="5-6" style="v" pubnumber="5,6" sid="PSA 29:5-6"/> Hún fellir sedrustrén til jarðar og klýfur hin hávöxnu tré í Líbanon. Raust Drottins skekur fjöllin í Líbanon og hristir Hermonfjall. Hans vegna hoppa þau um eins og ungir kálfar! <verse eid="PSA 29:5-6"/><verse number="7-8" style="v" pubnumber="7,8" sid="PSA 29:7-8"/> Rödd Drottins kveður við í eldingunni og endurómar í eyðimörkinni sem nötrar endanna á milli. <verse eid="PSA 29:7-8"/><verse number="9" style="v" sid="PSA 29:9"/>Raust Drottins skekur skógartrén, feykir burt laufi þeirra og lætur hindirnar bera fyrir tímann. Allir þeir sem standa í helgidómi hans segja: „Dýrð! Já, dýrð sé Drottni!“<verse eid="PSA 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 29:10"/>Flóðið mikla var ógurlegt, en Drottinn er enn meiri! Og enn birtir hann mátt sinn og kraft. <verse eid="PSA 29:10"/><verse number="11" style="v" sid="PSA 29:11"/>Hann mun veita lýð sínum styrkleik og blessa hann með friði og velgengni.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 30:1-2"/> Ég vil lofa þig Drottinn, því að þú hefur frelsað mig frá óvinum mínum. Þú leyfðir þeim ekki að yfirbuga mig. <verse eid="PSA 30:1-2"/><verse number="3" style="v" sid="PSA 30:3"/>Ó, Drottinn Guð minn, ég hrópaði til þín og þú læknaðir mig. <verse eid="PSA 30:3"/><verse number="4" style="v" sid="PSA 30:4"/>Þú hreifst mig burt frá barmi grafarinnar, já úr dauðans greipum, og gafst mér líf og framtíð!<verse eid="PSA 30:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 30:5"/>Syngið Drottni lof og þökk, þið sem á hann trúið. <verse eid="PSA 30:5"/><verse number="6" style="v" sid="PSA 30:6"/>Reiði hans stendur stutta stund, en náð hans varir að eilífu! Hans vegna stend ég stöðugur, fastur fyrir eins og fjöllin. Gráturinn sækir að um nætur, en gleðisöngur þegar dagur rís.<verse eid="PSA 30:6"/></para>
  <para style="p">
    <verse number="7-8" style="v" pubnumber="7,8" sid="PSA 30:7-8"/> Þegar allt gekk mér í hag, hugsaði ég: „Svona verður það alla tíð, nú getur ekkert stöðvað mig framar! Drottinn hefur velþóknun á mér. Hans vegna stend ég stöðugur, fastur fyrir eins og fjöllin!“ Þá snerir þú þér, Drottinn, burt frá mér og hélst aftur af blessun þinni. Skyndilega var kjarkur minn brostinn. Ég varð skelkaður og örvænti um minn hag. <verse eid="PSA 30:7-8"/><verse number="9" style="v" sid="PSA 30:9"/>Ég hrópaði til þín Drottinn. Já, svo sannarlega ákallaði ég þig! <verse eid="PSA 30:9"/><verse number="10" style="v" sid="PSA 30:10"/>Ég sagði: „Hvers vegna vilt þú Drottinn, koma mér á kné? – leiða mig í dauðann? Þar verður lofsöngur minn til lítils gagns. Hvernig á ég þá, liðið lík, að lofa þig, og vegsama trúfesti þína?! <verse eid="PSA 30:10"/><verse number="11" style="v" sid="PSA 30:11"/>Heyr þú ákall mitt, Drottinn! Miskunna þú mér og sendu mér hjálp þína.“<verse eid="PSA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 30:12"/>Þá breytti hann grát mínum í gleðidans! Hann dró af mér sorgarklæðin og færði mig í veisluskrúða! <verse eid="PSA 30:12"/><verse number="13" style="v" sid="PSA 30:13"/>Og þá gat ég lofsungið honum og gleymt ógnum grafarinnar! Ó, Drottinn, minn Guð, hvernig fæ ég fullþakkað þér?<verse eid="PSA 30:13"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 31:1-2"/> Drottinn, þér einum treysti ég. Láttu ekki óvini mína yfirbuga mig. Bjargaðu mér, því að þú ert réttlátur í öllum hlutum. <verse eid="PSA 31:1-2"/><verse number="3" style="v" sid="PSA 31:3"/>Svara mér í skyndi, nú þegar ég hrópa til þín. Beygðu þig niður að mér og hlustaðu á bæn mína. Vertu mér verndarbjarg, skjól fyrir óvinum. <verse eid="PSA 31:3"/><verse number="4" style="v" sid="PSA 31:4"/>Já, þú ert klettur minn og vígi, sýndu mátt þinn og gerðu nafn þitt dýrlegt og bjargaðu mér. <verse eid="PSA 31:4"/><verse number="5" style="v" sid="PSA 31:5"/>Forða fæti mínum frá snörunni sem óvinir mínir hafa lagt fyrir mig. Þú einn getur frelsað mig. <verse eid="PSA 31:5"/><verse number="6" style="v" sid="PSA 31:6"/>Í þínar hendur fel ég anda minn. Þú, Guð, sem stendur við öll þín orð, þú hefur bjargað mér. Þig einan lofa ég. <verse eid="PSA 31:6"/><verse number="7" style="v" sid="PSA 31:7"/>Ég hata alla þá sem dýrka fánýt falsgoð en Drottni treysti ég. <verse eid="PSA 31:7"/><verse number="8" style="v" sid="PSA 31:8"/>Ég gleðst mjög, því að þú hefur miskunnað mér, þú gafst gaum að þrengingum mínum og sálarneyð. <verse eid="PSA 31:8"/><verse number="9" style="v" sid="PSA 31:9"/>Þú framseldir mig ekki óvinum mínum, heldur rýmkaðir um mig á alla vegu.<verse eid="PSA 31:9"/></para>
  <para style="p">
    <verse number="10-11" style="v" pubnumber="10,11" sid="PSA 31:10-11"/> Ó, Drottinn, miskunna mér í neyð minni. Augu mín eru grátbólgin, heilsa mín brostin af sorg. <verse eid="PSA 31:10-11"/><verse number="12" style="v" sid="PSA 31:12"/>Ár mín líða í harmi, hryggðin styttir ævi mína. Syndirnar draga úr mér allan þrótt. Hokinn stend ég – sneyptur af skömm. Óvinirnir spotta mig og nágrannarnir hæða mig. Óhug slær að vinum mínum. Þeir, jafnvel þeir, forðast að mæta mér og líta undan þegar ég geng hjá. <verse eid="PSA 31:12"/><verse number="13" style="v" sid="PSA 31:13"/>Ég er gleymdur eins og líkið í gröf sinni – eins og brotið ker sem fleygt hefur verið á haug. <verse eid="PSA 31:13"/><verse number="14" style="v" sid="PSA 31:14"/>Ég frétti hvað um mig var sagt – um baktal óvina minna. Ógn og skelfing var hvert sem ég leit, svik og prettir í öllum hornum!<verse eid="PSA 31:14"/></para>
  <para style="p">
    <verse number="15-16" style="v" pubnumber="15,16" sid="PSA 31:15-16"/> En Drottinn, þér treysti ég! Ég sagði: „Þú einn ert minn Guð,“ þú ákveður ævilengd mína. Frelsaðu mig Drottinn, undan þeim sem ofsækja mig. <verse eid="PSA 31:15-16"/><verse number="17" style="v" sid="PSA 31:17"/>Láttu velþóknun þína aftur verða augljósa á þjóni þínum. Frelsa mig því að þú ert góður! <verse eid="PSA 31:17"/><verse number="18" style="v" sid="PSA 31:18"/>Drottinn, láttu mig ekki verða til skammar þegar ég ákalla þig um hjálp. Láttu illmennin blygðast sín fyrir það sem þau treysta á. Já, sendu þá sneypta og þegjandi í gröfina <verse eid="PSA 31:18"/><verse number="19" style="v" sid="PSA 31:19"/>lygarana sem ásaka réttláta með hroka og fyrirlitningu.<verse eid="PSA 31:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 31:20"/>Mikil er miskunn þín við þá sem treysta þér og vitna um trúfesti þína, þá sem elska þig og heiðra í augsýn annarra.<verse eid="PSA 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 31:21"/>Vertu ástvinum þínum skjól gegn svikráðum manna, verndaðu þá fyrir illum tungum. <verse eid="PSA 31:21"/><verse number="22" style="v" sid="PSA 31:22"/>Lofaður sé Drottinn, því að hann hefur sýnt mér dásamlega náð og verndað mig gegn illu. <verse eid="PSA 31:22"/><verse number="23" style="v" sid="PSA 31:23"/>Í fljótfærni sagði ég: „Drottinn hefur yfirgefið mig.“ En hann heyrði samt bæn mína og svaraði mér!<verse eid="PSA 31:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PSA 31:24"/>Elskið Drottin, öll þið sem honum treystið, því að Drottinn verndar trúfasta, en refsar harðlega þeim sem hafna honum í hroka. <verse eid="PSA 31:24"/><verse number="25" style="v" sid="PSA 31:25"/>Verið því glöð og hughraust, öll þið sem vonið á Drottin!<verse eid="PSA 31:25"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 32:1-2"/> Hvílík náð að fá syndir sínar fyrirgefnar! Það er dásamlegt þegar afbrotin eru strikuð út! En sá léttir hverjum játandi syndara að heyra Drottin segja: „Ég sýkna þig.“<verse eid="PSA 32:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 32:3"/>Sú var tíðin að ég þrjóskaðist við og neitaði að iðrast. En synd mín kvaldi mig og nagaði öllum stundum. <verse eid="PSA 32:3"/><verse number="4" style="v" sid="PSA 32:4"/>Ég var friðlaus bæði nætur og daga og fann að Drottinn áminnti mig. Styrkur minn þvarr eins og lækur sem þornar á heitu sumri. <verse eid="PSA 32:4"/><verse number="5" style="v" sid="PSA 32:5"/>Að lokum játaði ég synd mína fyrir þér, viðurkenndi afbrotin. Ég sagði: „Ég vil játa það allt fyrir Drottni,“ og þá fyrirgafstu mér! Sekt mín var strikuð út!<verse eid="PSA 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 32:6"/>Þess vegna segi ég: Þú sem trúir, játaðu synd þína strax fyrir Guði, já, strax og samviskan angrar þig. Notaðu tímann meðan fyrirgefning Guðs stendur þér til boða. Annars vofir dómurinn yfir þér.<verse eid="PSA 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 32:7"/>Þú ert skjól mitt í andstreymi lífsins og lausn í nauðum og vanda. Með frelsisfögnuði umlykur þú mig. <verse eid="PSA 32:7"/><verse number="8" style="v" sid="PSA 32:8"/>Drottinn segir: „Ég vil fræða þig og vísa þér veginn gegnum lífið. Ég vil gefa þér ráð og fylgjast með framför þinni. <verse eid="PSA 32:8"/><verse number="9" style="v" sid="PSA 32:9"/>Vertu ekki eins og þrjóskur hestur! Með taum og beisli verður að temja hann.“<verse eid="PSA 32:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 32:10"/>Miklar eru þjáningar syndugs manns, en þá sem treysta Drottni umlykur hann elsku. <verse eid="PSA 32:10"/><verse number="11" style="v" sid="PSA 32:11"/>Gleðjist yfir Guði, þið sem á hann trúið, og rekið upp fagnaðaróp, þið sem honum hlýðið!<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 33:1"/>Gleðjist og fagnið fyrir Drottni, þið hans trúuðu, því að lofsöngur hæfir réttlátum! <verse eid="PSA 33:1"/><verse number="2" style="v" sid="PSA 33:2"/>Leikið af þrótti á alls konar hljóðfæri og lofið Drottin. <verse eid="PSA 33:2"/><verse number="3" style="v" sid="PSA 33:3"/>Lofsyngið honum með nýjum söngvum. Sláið strengina ákaft og hrópið fagnaðaróp!<verse eid="PSA 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 33:4"/>Því að orð Drottins er áreiðanlegt – því má treysta. Öll hans verk eru í trúfesti gjörð. <verse eid="PSA 33:4"/><verse number="5" style="v" sid="PSA 33:5"/>Hann elskar allt sem rétt er og gott, kærleikur hans umvefur heiminn. <verse eid="PSA 33:5"/><verse number="6-7" style="v" pubnumber="6,7" sid="PSA 33:6-7"/> Það var orð Drottins sem skapaði himininn og alla hans stjörnumergð. Og höfunum safnaði hann saman og bjó þeim sinn rétta stað.<verse eid="PSA 33:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 33:8"/>Allir heimsbúar – bæði háir og lágir – óttist Drottin, og nálgist hann með lotningu. <verse eid="PSA 33:8"/><verse number="9" style="v" sid="PSA 33:9"/>Því að hann talaði og þá stóð heimurinn þar! Orð hans hljómaði og veröldin varð til!<verse eid="PSA 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 33:10"/>Drottinn ónýtir áform þjóða sem gegn honum rísa <verse eid="PSA 33:10"/><verse number="11" style="v" sid="PSA 33:11"/>en fyrirætlanir hans standa að eilífu, frá kynslóð til kynslóðar.<verse eid="PSA 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 33:12"/>Sæl er sú þjóð sem á Drottin að Guði, það fólk sem hann hefur kosið eignarlýð sinn. <verse eid="PSA 33:12"/><verse number="13-15" style="v" sid="PSA 33:13-15"/>Drottinn lítur niður af himni, horfir á mannanna börn. Hann hefur myndað hjörtu þeirra og gefur gætur að öllum athöfnum þeirra.<verse eid="PSA 33:13-15"/></para>
  <para style="p">
    <verse number="16-17" style="v" pubnumber="16,17" sid="PSA 33:16-17"/> Velbúinn her tryggir konungi ekki sigur og ofurafl eitt stoðar lítið. Stríðshestur er ekki til að reiða sig á, styrkur hans einn frelsar engan. <verse eid="PSA 33:16-17"/><verse number="18-19" style="v" pubnumber="18,19" sid="PSA 33:18-19"/> En, – augu Drottins vaka yfir þeim sem óttast hann, þeim sem reiða sig á elsku hans. Hann frelsar þá frá dauða, varðveitir líf þeirra á neyðarstund.<verse eid="PSA 33:18-19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 33:20"/>Ég hef sett traust mitt á Drottin. Enginn getur hjálpað nema hann, hann er skjöldur og vígi! <verse eid="PSA 33:20"/><verse number="21" style="v" sid="PSA 33:21"/>Hans vegna gleðjumst við og fögnum. Hans heilaga nafni treystum við. <verse eid="PSA 33:21"/><verse number="22" style="v" sid="PSA 33:22"/>Miskunn þín Drottinn umvefji okkur. Við vonum á þig.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 34:1-2"/> Ég vil lofa Drottin öllum stundum, vegsama hann seint og snemma. <verse eid="PSA 34:1-2"/><verse number="3" style="v" sid="PSA 34:3"/>Ég hrósa mér af Drottni. Hinir hógværu hlusta og öðlast nýjan kjark. <verse eid="PSA 34:3"/><verse number="4" style="v" sid="PSA 34:4"/>Lofið Drottin ásamt mér, tignum í sameiningu nafn hans.<verse eid="PSA 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 34:5"/>Ég hrópaði til hans og hann svaraði mér, frelsaði mig frá öllu því sem ég hræddist. <verse eid="PSA 34:5"/><verse number="6" style="v" sid="PSA 34:6"/>Lítið til hans og gleðjist og þið munuð ekki verða til skammar.<verse eid="PSA 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 34:7"/>Ég var vesæll og aumur, en ég hrópaði til Drottins. Drottinn heyrði hróp mitt og frelsaði frá öllu því sem ég hræddist. <verse eid="PSA 34:7"/><verse number="8" style="v" sid="PSA 34:8"/>Engill Drottins stendur vörð um þá sem óttast hann, og hann bjargar þeim.<verse eid="PSA 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 34:9"/>Finndu og sjáðu hve Guð er góður! Sæll er sá sem leitar hælis hjá honum. <verse eid="PSA 34:9"/><verse number="10" style="v" sid="PSA 34:10"/>Treystið Drottni og sýnið honum lotningu – óttist hann – því að þeir sem óttast hann líða engan skort. <verse eid="PSA 34:10"/><verse number="11" style="v" sid="PSA 34:11"/>Ung ljón búa við skort en þeir sem leita Drottins fara einskis góðs á mis.<verse eid="PSA 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 34:12"/>Börnin góð, komið og ég mun kenna ykkur að óttast Drottin. Það er mikilvægt. <verse eid="PSA 34:12"/><verse number="13" style="v" sid="PSA 34:13"/>Viljið þið lifa langa og góða ævi? <verse eid="PSA 34:13"/><verse number="14" style="v" sid="PSA 34:14"/>Gætið þá tungu ykkar! Segið aldrei ósatt orð. <verse eid="PSA 34:14"/><verse number="15" style="v" sid="PSA 34:15"/>Haldið ykkur frá öllu illu og ástundið það sem gott er. Reynið að lifa í sátt við aðra menn og keppið eftir friði.<verse eid="PSA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 34:16"/>Því að augu Drottins hvíla á hinum réttlátu og hann hlustar eftir bænum þeirra. <verse eid="PSA 34:16"/><verse number="17" style="v" sid="PSA 34:17"/>En öllum óguðlegum mun Drottinn eyða og afmá minningu þeirra af jörðinni. <verse eid="PSA 34:17"/><verse number="18" style="v" sid="PSA 34:18"/>Þegar réttlátir hrópa, þá heyrir Drottinn og frelsar þá úr nauðum. <verse eid="PSA 34:18"/><verse number="19" style="v" sid="PSA 34:19"/>Já, Drottinn er nálægur öllum þeim sem hafa auðmjúkt hjarta. Hann frelsar þá sem í einlægni og auðmýkt iðrast synda sinna. <verse eid="PSA 34:19"/><verse number="20" style="v" sid="PSA 34:20"/>Góður maður kemst oft í vanda – fær sinn skammt af mótlæti – en Drottinn á lausn við öllu slíku. <verse eid="PSA 34:20"/><verse number="21" style="v" sid="PSA 34:21"/>Jafnvel gegn slysum verndar Drottinn hann.<verse eid="PSA 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PSA 34:22"/>Ógæfan eltir og drepur óguðlegan mann og þeir sem hata réttláta bíða síns dóms. <verse eid="PSA 34:22"/><verse number="23" style="v" sid="PSA 34:23"/>En Drottinn frelsar líf þjóna sinna. Enginn sem leitar hælis hjá honum verður dæmdur sekur.<verse eid="PSA 34:23"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 35:1"/>Drottinn, farðu gegn þeim sem ásækja mig. Berst þú við þá sem berjast gegn mér. <verse eid="PSA 35:1"/><verse number="2" style="v" sid="PSA 35:2"/>Klæddu þig brynju, taktu fram skjöld og verndaðu mig. <verse eid="PSA 35:2"/><verse number="3" style="v" sid="PSA 35:3"/>Lyftu spjóti mér til varnar, því að óvinir mínir nálgast. Segðu við mig: „Ég bjarga þér!“ <verse eid="PSA 35:3"/><verse number="4" style="v" sid="PSA 35:4"/>Láttu þá verða til skammar sem ofsækja mig. Snúðu þeim frá og ruglaðu þá í ríminu! <verse eid="PSA 35:4"/><verse number="5" style="v" sid="PSA 35:5"/>Feyktu þeim burt eins og laufum í vindi. Engill þinn varpi þeim um koll. <verse eid="PSA 35:5"/><verse number="6" style="v" sid="PSA 35:6"/>Gerðu veg þeirra myrkan og hálan er engill þinn eltir þá.<verse eid="PSA 35:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 35:7"/>Því að þótt ég gerði þeim ekkert illt, lögðu þeir fyrir mig gildru og grófu mér gröf. <verse eid="PSA 35:7"/><verse number="8" style="v" sid="PSA 35:8"/>Láttu eyðingu koma yfir þá þegar þeir eiga þess síst von. Þeir falli á eigin bragði og tortímist.<verse eid="PSA 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 35:9"/>En ég mun fagna í Drottni. Hann mun frelsa mig! <verse eid="PSA 35:9"/><verse number="10" style="v" sid="PSA 35:10"/>Ég lofa hann af öllu hjarta. Hver er vörn lítilmagnans nema hann? Hver annar en hann verndar hinn veika og þurfandi gegn ofbeldismönnunum sem ræna og rupla.<verse eid="PSA 35:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 35:11"/>Slíkir menn eru ljúgvottar. Þeir ásaka mig um hluti sem ég hef aldrei heyrt. <verse eid="PSA 35:11"/><verse number="12" style="v" sid="PSA 35:12"/>Ég gerði þeim gott eitt, en þeir launa mér með illu. Ég er að dauða kominn. <verse eid="PSA 35:12"/><verse number="13" style="v" sid="PSA 35:13"/>Þegar þeir lágu sjúkir klæddist ég sorgarbúningi og var dapur. Ég fastaði – neitaði mér um mat – og bað í einlægni fyrir heilsu þeirra. <verse eid="PSA 35:13"/><verse number="14" style="v" sid="PSA 35:14"/>Ég var harmandi, eins og móðir mín, vinur eða bróðir væru sjúk og að dauða komin. <verse eid="PSA 35:14"/><verse number="15" style="v" sid="PSA 35:15"/>En nú gleðjast þeir yfir óförum mínum. Þeir koma saman til að baktala mig – jafnvel ókunnugir og útlendingar eru í þeirra hópi. <verse eid="PSA 35:15"/><verse number="16" style="v" sid="PSA 35:16"/>Þeir ala á illsku, formæla mér og hæða mig.<verse eid="PSA 35:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 35:17"/>Drottinn, hve lengi ætlar þú að horfa á aðgerðalaus?</para>
  <para style="p" vid="PSA 35:17">Gríptu inn í og bjargaðu mér, því að ég er einmana og þessir vargar bíða færis. <verse eid="PSA 35:17"/><verse number="18" style="v" sid="PSA 35:18"/>Frelsaðu mig og þá mun ég þakka þér í áheyrn alls safnaðarins, vegsama þig meðal fjölda fólks.<verse eid="PSA 35:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 35:19"/>Láttu þá ekki fá sigur sem ráðast gegn mér án minnsta tilefnis. Láttu mig ekki falla, því það mundi gleðja þá mjög.<verse eid="PSA 35:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 35:20"/>Þeir tala hvorki um frið, né það að gera gott, nei, heldur brugga þeir saklausum mönnum launráð. <verse eid="PSA 35:20"/><verse number="21" style="v" sid="PSA 35:21"/>Þeir hafa hátt og segja mig beita ranglæti. „Já!“ segja þeir, „við sáum það með eigin augum!“ <verse eid="PSA 35:21"/><verse number="22" style="v" sid="PSA 35:22"/>En Drottinn þekkir málið betur en nokkur annar. Gríptu inn í! Skildu mig ekki eftir einan og yfirgefinn!<verse eid="PSA 35:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 35:23"/>Stígðu fram, Drottinn, Guð minn! Láttu mig ná rétti mínum. <verse eid="PSA 35:23"/><verse number="24" style="v" sid="PSA 35:24"/>Þú ert réttlátur og þekkir málið. Lýstu yfir sakleysi mínu. Láttu ekki óvini mína hlakka yfir ógæfu minni.<verse eid="PSA 35:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 35:25"/>Láttu þá ekki segja: „Gott! Það fór eins og við óskuðum! Loksins tókst okkur að gera út af við hann!“ <verse eid="PSA 35:25"/><verse number="26" style="v" sid="PSA 35:26"/>Láttu þá blygðast sín. Láttu þá sem sýna mér hroka og fagna yfir óförum mínum, sjálfa þola skömm og svívirðing. <verse eid="PSA 35:26"/><verse number="27" style="v" sid="PSA 35:27"/>Láttu þá sem óska mér blessunar sjá góða daga. Þeir hrópi: „Mikill er Drottinn sem gerir vel við þjón sinn!“<verse eid="PSA 35:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PSA 35:28"/>Ég vil segja öllum frá réttlæti Drottins og lofa hann liðlangan daginn.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 36:1-2"/> Rödd syndarinnar talar í huga guðleysingjans og hvetur hann til vondra verka. Enginn guðsótti býr í hjarta hans. <verse eid="PSA 36:1-2"/><verse number="3" style="v" sid="PSA 36:3"/>Syndin dregur hann á tálar, mistök hans verða augljós og menn hata hann. <verse eid="PSA 36:3"/><verse number="4" style="v" sid="PSA 36:4"/>Svik og tál eru á vörum hans og hann er hættur að vera hygginn og breyta vel. <verse eid="PSA 36:4"/><verse number="5" style="v" sid="PSA 36:5"/>Á nóttunni liggur hann í rúmi sínu og upphugsar svik, forðast ekki hið illa.<verse eid="PSA 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 36:6"/>Drottinn, miskunn þín er mikil eins og himinninn og trúfesti þín takmarkalaus. <verse eid="PSA 36:6"/><verse number="7" style="v" sid="PSA 36:7"/>Réttlæti þitt er stöðugt eins og fjöllin. Dómar þínir hvíla á vísdómi, þeir vitna um mikilleik þinn líkt og úthöfin. Þú berð umhyggju fyrir mönnum og skepnum. <verse eid="PSA 36:7"/><verse number="8" style="v" sid="PSA 36:8"/>Hversu dýrmæt er miskunn þín ó, Guð! Mennirnir leita skjóls í skugga vængja þinna. <verse eid="PSA 36:8"/><verse number="9" style="v" sid="PSA 36:9"/>Þú nærir þá með krásum af borði þínu og lætur þá drekka úr lækjum unaðssemda þinna.<verse eid="PSA 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 36:10"/>Þú, Drottinn, ert uppspretta lífsins! í þínu ljósi sjáum við ljós. <verse eid="PSA 36:10"/><verse number="11" style="v" sid="PSA 36:11"/>Lát miskunn þína haldast við þá sem þekkja þig og réttlæti þitt við þá sem hlýða þér og elska.<verse eid="PSA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 36:12"/>Lát ekki fót hins hrokafulla troða á mér né hendur óguðlegra hrekja mig burt. <verse eid="PSA 36:12"/><verse number="13" style="v" sid="PSA 36:13"/>Líttu á! Illgjörðamennirnir eru fallnir! Þeim hefur verið varpað um koll og þeir megna ekki að rísa upp aftur.<verse eid="PSA 36:13"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 37:1"/>Öfundaðu aldrei vonda menn, <verse eid="PSA 37:1"/><verse number="2" style="v" sid="PSA 37:2"/>því að fyrr en varir eru þeir fallnir og visna eins og grasið. <verse eid="PSA 37:2"/><verse number="3" style="v" sid="PSA 37:3"/>Treystu heldur Drottni, vertu góðgjarn og sýndu kærleika. Þá muntu búa öruggur í landinu og farnast vel.<verse eid="PSA 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 37:4"/>Þú skalt gleðjast í Drottni – og hann mun veita þér það sem hjarta þitt þráir. <verse eid="PSA 37:4"/><verse number="5" style="v" sid="PSA 37:5"/>Fel Drottni framtíð þína, áform þín og verk, og treystu honum. Hann mun vel fyrir öllu sjá. <verse eid="PSA 37:5"/><verse number="6" style="v" sid="PSA 37:6"/>Heiðarleiki þinn og hreinskilni verða öllum augljós, og Drottinn mun láta þig ná rétti þínum.<verse eid="PSA 37:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 37:7"/>Hvíldu í Drottni og treystu honum. Bíð þess í þolinmæði að hann hefjist handa. Öfunda ekki vonda menn sem vegnar vel.<verse eid="PSA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 37:8"/>Láttu af reiðinni! Slepptu heiftinni. Vertu ekki svekktur og áhyggjufullur – slíkt leiðir ekki til góðs. <verse eid="PSA 37:8"/><verse number="9" style="v" sid="PSA 37:9"/>Þeir sem illt fremja verða þurrkaðir út, en þeir sem treysta Drottni eignast landið og gæði þess. <verse eid="PSA 37:9"/><verse number="10" style="v" sid="PSA 37:10"/>Innan skamms verða guðleysingjarnir á bak og burt. Þegar þú leitar þeirra eru þeir horfnir. <verse eid="PSA 37:10"/><verse number="11" style="v" sid="PSA 37:11"/>En hinir hógværu fá landið til eignar, þeir munu hljóta blessun og frið.<verse eid="PSA 37:11"/></para>
  <para style="p">
    <verse number="12-13" style="v" pubnumber="12,13" sid="PSA 37:12-13"/> Drottinn hlær að þeim sem brugga launráð gegn hans trúuðu. Hann hefur þegar ákveðið daginn er þeir verða dæmdir. <verse eid="PSA 37:12-13"/><verse number="14" style="v" sid="PSA 37:14"/>Óguðlegir hyggja á illt gegn réttlátum, undirbúa blóðbað. <verse eid="PSA 37:14"/><verse number="15" style="v" sid="PSA 37:15"/>En þeir munu farast fyrir eigin sverði og bogar þeirra verða brotnir.<verse eid="PSA 37:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 37:16"/>Betra er að eiga lítið og vera guðrækinn, en óguðlegur og hafa allsnægtir, <verse eid="PSA 37:16"/><verse number="17" style="v" sid="PSA 37:17"/>því að óguðlegir munu falla, en Drottinn annast sína trúuðu.<verse eid="PSA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 37:18"/>Daglega skoðar Drottinn réttlætisverk trúaðra og reiknar þeim eilíf laun. <verse eid="PSA 37:18"/><verse number="19" style="v" sid="PSA 37:19"/>Hann styður þá í kreppunni og heldur lífinu í þeim í hallæri. <verse eid="PSA 37:19"/><verse number="20" style="v" sid="PSA 37:20"/>Vantrúaðir farast og óvinir Guðs visna eins og grasið. Eins og sinu verður þeim brennt, þeir líða burt eins og reykur. <verse eid="PSA 37:20"/><verse number="21" style="v" sid="PSA 37:21"/>Guðlaus maður tekur lán og borgar ekki, en hinn guðrækni er ónískur og gefur með gleði. <verse eid="PSA 37:21"/><verse number="22" style="v" sid="PSA 37:22"/>Þeir sem Drottinn blessar eignast landið, en bannfærðum verður útrýmt.<verse eid="PSA 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 37:23"/>Drottinn stýrir skrefum hins guðrækna og gleðst yfir breytni hans. <verse eid="PSA 37:23"/><verse number="24" style="v" sid="PSA 37:24"/>Þótt hann falli þá liggur hann ekki flatur því að Drottinn reisir hann á fætur.<verse eid="PSA 37:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 37:25"/>Ungur var ég og nú er ég gamall orðinn, en aldrei sá ég Drottin snúa baki við guðhræddum manni né heldur börn hans biðja sér matar. <verse eid="PSA 37:25"/><verse number="26" style="v" sid="PSA 37:26"/>Nei, guðræknir menn eru mildir og lána og börn þeirra verða öðrum til blessunar.<verse eid="PSA 37:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PSA 37:27"/>Viljir þú búa við frið og lifa lengi, þá forðastu illt en gerðu gott, <verse eid="PSA 37:27"/><verse number="28" style="v" sid="PSA 37:28"/>því að Drottinn hefur mætur á góðum verkum og yfirgefur ekki sína trúuðu, hann mun varðveita þá, en uppræta niðja óguðlegra.<verse eid="PSA 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PSA 37:29"/>Hinir réttlátu fá landið til eignar og búa þar mann fram af manni. <verse eid="PSA 37:29"/><verse number="30-31" style="v" pubnumber="30,31" sid="PSA 37:30-31"/> Guðrækinn maður talar speki, enda réttsýnn og sanngjarn. Lögmál Guðs er í hjarta hans og hann kann að greina gott frá illu.<verse eid="PSA 37:30-31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PSA 37:32"/>Ranglátir menn njósna um réttláta, vilja þá feiga. <verse eid="PSA 37:32"/><verse number="33" style="v" sid="PSA 37:33"/>En Drottinn stöðvar áform illvirkjanna og sýknar réttláta fyrir dómi.<verse eid="PSA 37:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="PSA 37:34"/>Óttastu ekki, því að Drottinn mun svara bæn þinni! Gakktu hiklaust á hans vegum. Á réttum tíma mun hann veita þér velgengni og uppreisn æru. Þá muntu sjá illvirkjunum útrýmt.<verse eid="PSA 37:34"/></para>
  <para style="p">
    <verse number="35-36" style="v" pubnumber="35,36" sid="PSA 37:35-36"/> Ég sá vondan mann og hrokafullan – hann þandi sig út eins og laufmikið tré – en svo var hann horfinn! Ég leitaði eftir honum, en fann hann ekki framar. <verse eid="PSA 37:35-36"/><verse number="37" style="v" sid="PSA 37:37"/>En hvað um hinn ráðvanda og hreinskilna? Það er önnur saga! Því að góðir menn og friðsamir eiga framtíð fyrir höndum. <verse eid="PSA 37:37"/><verse number="38" style="v" sid="PSA 37:38"/>Illum mönnum verður útrýmt og þeir eiga enga framtíðarvon.<verse eid="PSA 37:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="PSA 37:39"/>Drottinn bjargar hinum guðræknu. Hann er þeim hjálp og skjól á neyðartímum. <verse eid="PSA 37:39"/><verse number="40" style="v" sid="PSA 37:40"/>Þeir treysta honum og því hjálpar hann þeim og frelsar þá frá vélráðum óguðlegra.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 38:1-2"/> Drottinn, ekki refsa mér, þótt þú sért reiður. <verse eid="PSA 38:1-2"/><verse number="3" style="v" sid="PSA 38:3"/>Örvar þínar standa í mér og hönd þín liggur þungt á mér. <verse eid="PSA 38:3"/><verse number="4-5" style="v" pubnumber="4,5" sid="PSA 38:4-5"/> Vegna reiði þinnar er ég sjúkur maður, heilsa mín er farin vegna synda minna. Syndir mínar líkjast flóði sem færir mig í kaf, eins og byrði sem ég kikna undan. <verse eid="PSA 38:4-5"/><verse number="6-7" style="v" pubnumber="6,7" sid="PSA 38:6-7"/> Ólykt leggur af sárum mínum – það er drep í þeim. Ég er ráðþrota vegna synda minna. Ég ráfa um í angist liðlangan daginn. <verse eid="PSA 38:6-7"/><verse number="8" style="v" sid="PSA 38:8"/>Lendar mínar brenna af sviða og líkami minn er helsjúkur. <verse eid="PSA 38:8"/><verse number="9" style="v" sid="PSA 38:9"/>Máttur minn er þrotinn og ég er örvæntingu nær.<verse eid="PSA 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 38:10"/>Drottinn, ég þrái bót á meini mínu! Þú heyrir kvein mín og andvörp. <verse eid="PSA 38:10"/><verse number="11" style="v" sid="PSA 38:11"/>Hjartað hamast í brjósti mér, kraftar mínir búnir og sjónin dvín. <verse eid="PSA 38:11"/><verse number="12" style="v" sid="PSA 38:12"/>Ástvinir mínir og góðir grannar forðast sjúkdóm minn og böl og frændur mínir eru á bak og burt.<verse eid="PSA 38:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 38:13"/>Óvinir mínir sæta færis að drepa mig. Liðlangan daginn sitja þeir á svikráðum, brugga mér banaráð. <verse eid="PSA 38:13"/><verse number="14-15" style="v" pubnumber="14,15" sid="PSA 38:14-15"/> En illráð þeirra verka ekki á mig! Ég virði þá ekki viðlits. Áform þeirra rætast ekki, <verse eid="PSA 38:14-15"/><verse number="16" style="v" sid="PSA 38:16"/>því að ég vona á þig, Drottinn, Guð minn. Kom þú og vernda mig. <verse eid="PSA 38:16"/><verse number="17" style="v" sid="PSA 38:17"/>Þaggaðu niður í þeim sem hlæja að óförum mínum.<verse eid="PSA 38:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 38:18"/>Ég er að falli kominn og angist mín er enn hin sama. <verse eid="PSA 38:18"/><verse number="19" style="v" sid="PSA 38:19"/>Ég játa syndir mínar og iðrast þess sem ég hef gert. <verse eid="PSA 38:19"/><verse number="20" style="v" sid="PSA 38:20"/>En ofsóknum óvina minna linnir ekki og heift þeirra minnkar ekki. Þeir hata mig án ástæðu. <verse eid="PSA 38:20"/><verse number="21" style="v" sid="PSA 38:21"/>Þeir launa mér gott með illu, hata mig fyrir góðverk mín.<verse eid="PSA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PSA 38:22"/>Yfirgefðu mig ekki, Drottinn. Vík ekki frá mér! <verse eid="PSA 38:22"/><verse number="23" style="v" sid="PSA 38:23"/>Komdu skjótt og hjálpaðu mér, þú frelsari minn!<verse eid="PSA 38:23"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 39:1-2"/> Ég hugsaði: „Ég ætla ekki að kvarta, né segja neitt ljótt meðan óguðlegir heyra til.“ <verse eid="PSA 39:1-2"/><verse number="3-4" style="v" pubnumber="3,4" sid="PSA 39:3-4"/> Og ég þagði. En hið innra leið mér verr og verr. Ég hélt aftur af mér, en gremjan magnaðist í mér. Að lokum gat ég ekki orða bundist: <verse eid="PSA 39:3-4"/><verse number="5" style="v" sid="PSA 39:5"/>„Drottinn, fæ ég aðeins að lifa örfá ár í viðbót? <verse eid="PSA 39:5"/><verse number="6-7" style="v" pubnumber="6,7" sid="PSA 39:6-7"/> Ævi mín er lítið lengri en höndin á mér! Og í þínum augum er hún nánast ekki neitt! Maðurinn, hvað er hann? Vindblær, flöktandi skuggi! Ys hans og amstur kemur engu til leiðar. Hann rakar saman fé sem svo aðrir eyða!“<verse eid="PSA 39:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 39:8"/>En á hvern vona ég þá? Drottinn, ég vona á þig!<verse eid="PSA 39:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 39:9"/>Frelsa mig frá syndum mínum svo að heimskingjarnir hafi mig ekki að spotti.<verse eid="PSA 39:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 39:10"/>Drottinn, ég þegi því að þú hefur talað. Ég vil ekki kvarta, því að þú hefur refsað mér.<verse eid="PSA 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 39:11"/>Drottinn láttu refsingu þína taka enda – ég þoli ekki meira! <verse eid="PSA 39:11"/><verse number="12" style="v" sid="PSA 39:12"/>Þegar þú hirtir manninn vegna synda hans, þá er nánast úti um hann. Hann er sem mölétin flík, já, hann líður burt eins og gufa. <verse eid="PSA 39:12"/><verse number="13" style="v" sid="PSA 39:13"/>Heyr þú bæn mína, Drottinn, hlustaðu á hróp mitt! Vertu ekki hljóður við tárum mínum. Mundu að ég er gestur hér, förumaður á þessari jörð eins og forfeður mínir.<verse eid="PSA 39:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 39:14"/>Miskunna þú mér, Drottinn og læknaðu mig. Lofaðu mér aftur að sjá glaðan dag áður en ég dey.<verse eid="PSA 39:14"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 40:1-2"/> Ég setti alla mína von á Drottin. Hann heyrði kvein mitt og að lokum bjargaði hann mér. <verse eid="PSA 40:1-2"/><verse number="3" style="v" sid="PSA 40:3"/>Hann dró mig upp úr glötunargröfinni, hinni botnlausu leðju, og lyfti mér upp á klett. Hann gerði mig styrkan í gangi.<verse eid="PSA 40:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 40:4"/>Þá fylltist munnur minn lofsöng – lofgjörð um Guð. Margir hlustuðu er ég söng um velgjörðir hans við mig. Þeir munu einnig lúta honum og lofa hann, setja traust sitt á hann. <verse eid="PSA 40:4"/><verse number="5" style="v" sid="PSA 40:5"/>Þeir sem treysta Drottni verða lánsamir, þeir sem forðast ráð dramblátra og halda sér frá lygi.<verse eid="PSA 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 40:6"/>Drottinn, Guð minn, mörg dásemdarverk hefur þú gert og mikillar umhyggju höfum við notið. Ekkert kemst í samjöfnuð við þig! Mér endist ekki tími til að rifja upp öll þín undraverk!<verse eid="PSA 40:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 40:7"/>Sláturfórnir og matfórnir þráir þú ekki frá lýð þínum, og brennifórnir heimtar þú ekki. Nei, þú þráir að ég þjóni þér alla ævi. <verse eid="PSA 40:7"/><verse number="8" style="v" sid="PSA 40:8"/>Ég sagði: „Sjá, ég kem, rétt eins og orð þitt býður mér. <verse eid="PSA 40:8"/><verse number="9" style="v" sid="PSA 40:9"/>Það að gera vilja þinn, Drottinn minn, þrái ég því að lögmál þitt er ritað á hjarta mitt!“<verse eid="PSA 40:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 40:10"/>Ég hef vitnað um það fyrir öllum, aftur og aftur, að þú fyrirgefur syndir. Það veistu Drottinn. <verse eid="PSA 40:10"/><verse number="11" style="v" sid="PSA 40:11"/>Ég hef ekki þagað yfir réttlæti þínu heldur boðað það öllum. Allur söfnuðurinn hefur heyrt mig tala um elsku þína og trúfesti.<verse eid="PSA 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 40:12"/>Þess vegna, Drottinn minn, taktu ekki miskunn þína frá mér! Ég á allt mitt undir kærleika þínum og náð. <verse eid="PSA 40:12"/><verse number="13" style="v" sid="PSA 40:13"/>Sért þú ekki með mér, er úti um mig. Vandamál mín eru mér ofvaxin, og syndir mínar – sem eru fleiri en hárin á höfði mér – hafa lamað mig. Ég veit ekki mitt rjúkandi ráð.<verse eid="PSA 40:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 40:14"/>Ó, Drottinn, ég hrópa til þín! Frelsa þú mig! Komdu fljótt og hjálpaðu mér. <verse eid="PSA 40:14"/><verse number="15-16" style="v" pubnumber="15,16" sid="PSA 40:15-16"/> Ruglaðu þá í ríminu; sem sækjast eftir lífi mínu. Sendu þá burt með skömm!<verse eid="PSA 40:15-16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 40:17"/>Allir þeir sem elska Drottin og leita hans, skulu gleðjast yfir hjálpræði hans. Þeir segi án afláts: „Mikill er Drottinn!“<verse eid="PSA 40:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 40:18"/>Ég er aumur og fátækur, en þó ber Drottinn umhyggju fyrir mér. Þú, Guð minn, ert hjálp mín, og frelsari; Ó, komdu og bjargaðu mér! Láttu það ekki dragast!.<verse eid="PSA 40:18"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 41:1-2"/> Guð blessar þann sem hjálpar bágstöddum. Á mæðudeginum bjargar Drottinn honum. <verse eid="PSA 41:1-2"/><verse number="3" style="v" sid="PSA 41:3"/>Drottinn verndar hann og heldur í honum lífinu. Hann lætur hann njóta sæmdar og frelsar hann frá óvinum hans. <verse eid="PSA 41:3"/><verse number="4" style="v" sid="PSA 41:4"/>Drottinn annast hann á sóttarsæng, veitir honum hvíld og hressing.<verse eid="PSA 41:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 41:5"/>Ég bað: „Drottinn, miskunnaðu mér. Læknaðu sál mína því að ég hef syndgað gegn þér.“<verse eid="PSA 41:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 41:6"/>Óvinir mínir biðja mér bölbæna og segja: „Bara að hann deyi sem fyrst svo að allir gleymi honum!“ <verse eid="PSA 41:6"/><verse number="7" style="v" sid="PSA 41:7"/>Sumir sem heimsækja mig í veikindunum eru að þykjast. Innst inni hata þeir mig og líkar vel að ég er sjúkur. Þegar út er komið baktala þeir mig. <verse eid="PSA 41:7"/><verse number="8" style="v" sid="PSA 41:8"/>Hatursmenn mínir hæða mig og spotta. Þeir skrafa og pískra hvað gera skuli þegar ég er allur <verse eid="PSA 41:8"/><verse number="9" style="v" sid="PSA 41:9"/>„Þetta er banvænt, hvað sem það er,“ segja þeir, „honum mun aldrei batna.“<verse eid="PSA 41:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 41:10"/>Og besti vinur minn, hann snerist líka gegn mér, maðurinn sem ég treysti svo vel, hann sem át við borð mitt. <verse eid="PSA 41:10"/><verse number="11" style="v" sid="PSA 41:11"/>En, Drottinn, yfirgef mig ekki! Miskunnaðu mér og læknaðu mig svo að ég geti endurgoldið þeim! <verse eid="PSA 41:11"/><verse number="12" style="v" sid="PSA 41:12"/>Ég veit að þú elskar mig og að þú munt ekki láta óvini mína hlakka yfir mér. <verse eid="PSA 41:12"/><verse number="13" style="v" sid="PSA 41:13"/>Vegna sakleysis míns hefur þú varðveitt mig og lætur mig lifa með þér að eilífu.<verse eid="PSA 41:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 41:14"/>Lofaður sé Drottinn, Guð Ísraels, frá eilífð til eilífðar. Amen. Amen.<verse eid="PSA 41:14"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 42:1-2"/> Eins og hindin þráir vatnslindir, þrái ég þig, ó Guð. <verse eid="PSA 42:1-2"/><verse number="3" style="v" sid="PSA 42:3"/>Mig þyrstir eftir Guði, hinum lifandi Guði. Hvenær fæ ég að koma og standa frammi fyrir honum? <verse eid="PSA 42:3"/><verse number="4" style="v" sid="PSA 42:4"/>Daga og nætur leita ég hans grátandi, en óvinir mínir spotta mig og segja: „Hvar skyldi Guð þinn vera?!“<verse eid="PSA 42:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" pubnumber="5,6" sid="PSA 42:5-6"/> Hresstu þig nú, sál mín! Minnstu þess er þú á hátíðum leiddir skrúðgönguna til musterisins, og söngst lofsöng um Drottin? Það var ógleymanlegt! Til hvers þá að vera hnugginn? Hvers vegna að súta og syrgja? Treystu Drottni! Já, svo sannarlega vil ég lofa hann á ný. Aftur vil ég þakka honum hjálp hans. <verse eid="PSA 42:5-6"/><verse number="7" style="v" sid="PSA 42:7"/>Ég er dapur og stúrinn, en samt vil ég hugsa um þig hér við fjöllin Misar og Hermon þar sem Jórdan streymir fram. <verse eid="PSA 42:7"/><verse number="8" style="v" sid="PSA 42:8"/>Bylgjur þínar hafa brotnað á mér og fossar þínir baðað mig í sorg.<verse eid="PSA 42:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 42:9"/>En þó streymir náð Drottins til mín dag eftir dag og um nætur lofa ég hann og bið til Guðs sem gaf mér lífið.<verse eid="PSA 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 42:10"/>Ég bið og segi: „Ó, þú Guð, klettur minn.“ „Hvers vegna hefur þú yfirgefið mig? Hvers vegna verð ég að þola árásir óvina minna?“ <verse eid="PSA 42:10"/><verse number="11" style="v" sid="PSA 42:11"/>Mig svíður undan ögrunum þeirra og aftur og aftur gera þeir gys að mér. „Hvar er þessi Guð þinn?!“ segja þeir. <verse eid="PSA 42:11"/><verse number="12" style="v" sid="PSA 42:12"/>En sál mín, misstu ekki móðinn. Láttu þér ekki gremjast það. Vonaðu á Guð. Já ég veit að hann mun hjálpa mér og þá mun ég lofa hann fyrir allt það sem hann gerir. Hann er björgun mín! Hann er minn Guð!<verse eid="PSA 42:12"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 43:1"/>Ó, Guð, láttu mig ná rétti mínum gegn svikulum og vondum mönnum sem ásaka mig. <verse eid="PSA 43:1"/><verse number="2" style="v" sid="PSA 43:2"/>Þú einn ert Guð, skjól mitt og vígi. Hvers vegna hefur þú vísað mér frá? Hví verð ég að ganga um harmandi, kúgaður af óvinum? <verse eid="PSA 43:2"/><verse number="3" style="v" sid="PSA 43:3"/>Sendu ljós þitt og sannleika til að vísa mér veginn að musteri þínu á Síon, fjallinu þínu helga. <verse eid="PSA 43:3"/><verse number="4" style="v" sid="PSA 43:4"/>Þar vil ég ganga að altari Guðs, uppsprettu gleðinnar, og lofa hann með hörpuleik. Ó, Guð, – minn Guð!<verse eid="PSA 43:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 43:5"/>Sál mín hvers vegna ertu döpur og kjarklaus? Treystu Guði! Víst mun ég fá að lofa hann á ný, því hann mun hjálpa mér og aftur mun auglit mitt gleðjast!<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 44:1-2"/> Guð, við höfum heyrt um máttarverk þín á dögum forfeðra okkar. Þeir hafa sagt: <verse eid="PSA 44:1-2"/><verse number="3" style="v" sid="PSA 44:3"/>Hann rak heiðnu þjóðirnar úr landinu og gaf okkur það, lét Ísrael setjast hér að. <verse eid="PSA 44:3"/><verse number="4" style="v" sid="PSA 44:4"/>Ekki sigruðu þeir af eigin krafti, heldur vegna máttar þíns og velþóknunar þinnar á þeim.<verse eid="PSA 44:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 44:5"/>Þú ert konungur minn og Guð. Láttu þjóð þína vinna sigur! <verse eid="PSA 44:5"/><verse number="6" style="v" sid="PSA 44:6"/>Aðeins í þínum krafti og nafni sigrum við óvininn. <verse eid="PSA 44:6"/><verse number="7" style="v" sid="PSA 44:7"/>Vopnin duga skammt, þau tryggja ekki sigur. <verse eid="PSA 44:7"/><verse number="8" style="v" sid="PSA 44:8"/>Aðeins með þinni hjálp getum við sigrað.<verse eid="PSA 44:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 44:9"/>Guð, aftur og aftur hrósa ég mér af þér. Hvernig get ég þakkað þér sem skyldi! <verse eid="PSA 44:9"/><verse number="10" style="v" sid="PSA 44:10"/>En þó hefur þú, Drottinn, nú um stund yfirgefið okkur og ekki stutt í orustum. <verse eid="PSA 44:10"/><verse number="11" style="v" sid="PSA 44:11"/>Já, þú hefur barist gegn okkur og við höfum flúið. Óvinir okkar gerðu árás. Þeir rændu og rupluðu. <verse eid="PSA 44:11"/><verse number="12" style="v" sid="PSA 44:12"/>Þú hefur farið með okkur eins og sláturfé, tvístrað okkur meðal þjóðanna. <verse eid="PSA 44:12"/><verse number="13" style="v" sid="PSA 44:13"/>Þú selur þjóð þína fyrir lítið, metur hana einskis virði. <verse eid="PSA 44:13"/><verse number="14" style="v" sid="PSA 44:14"/>Nágrannarnir hæða okkur og spotta vegna alls sem þú lætur á okkur dynja. <verse eid="PSA 44:14"/><verse number="15" style="v" sid="PSA 44:15"/>Þín vegna er „Gyðingur!“ háðsyrði og hneyksli meðal þjóðanna, öllum til ama. <verse eid="PSA 44:15"/><verse number="16-17" style="v" pubnumber="16,17" sid="PSA 44:16-17"/> Ég verð fyrir stöðugum skömmum, mér er formælt og ég fyrirlitinn af hefnigjörnum óvinum.<verse eid="PSA 44:16-17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 44:18"/>Og þetta hefur gerst, Drottinn, þrátt fyrir tryggð okkar við þig. Sáttmála þinn höfum við ekki rofið. <verse eid="PSA 44:18"/><verse number="19" style="v" sid="PSA 44:19"/>Ekki höfum við snúið okkur gegn þér, ekki vikið eitt skref af vegi þínum! <verse eid="PSA 44:19"/><verse number="20" style="v" sid="PSA 44:20"/>Væri svo, gætum við skilið refsingu þína, landauðn og niðdimmu dauðans. <verse eid="PSA 44:20"/><verse number="21" style="v" sid="PSA 44:21"/>Ef við hefðum hætt að tilbiðja Guð og snúið okkur að hjáguðadýrkun, <verse eid="PSA 44:21"/><verse number="22" style="v" sid="PSA 44:22"/>hefði honum þá ekki verið kunnugt um það? Hann sem þekkir alla hluti og leyndarmál mannanna. <verse eid="PSA 44:22"/><verse number="23" style="v" sid="PSA 44:23"/>En það höfum við ekki gert. Við erum í dauðans hættu fyrir það eitt að þjóna þér! Við erum eins og lömb leidd til slátrunar!<verse eid="PSA 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PSA 44:24"/>Vakna þú! Rís þú á fætur! Hvers vegna sefur þú, Drottinn? Hefur þú hafnað okkur fyrir fullt og allt? <verse eid="PSA 44:24"/><verse number="25" style="v" sid="PSA 44:25"/>Hvers vegna horfir þú í aðra átt? Af hverju er þér sama um sorg okkar og neyð? <verse eid="PSA 44:25"/><verse number="26" style="v" sid="PSA 44:26"/>Við erum fallnir og liggjum hér endilangir. <verse eid="PSA 44:26"/><verse number="27" style="v" sid="PSA 44:27"/>Rís þú upp, Drottinn, komdu og hjálpaðu okkur! Frelsaðu okkur vegna eilífrar elsku þinnar.<verse eid="PSA 44:27"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 45:1-2"/> Hjarta mitt svellur af fögrum orðum. Ég vil flytja konungi ljóð. Tunga mín er penni hraðritarans, hún flytur langa sögu á augabragði:<verse eid="PSA 45:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 45:3"/>Þú ert fegurri en mannanna börn. Blessun streymir um varir þínar. Velþóknun Guðs er yfir þér að eilífu.<verse eid="PSA 45:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 45:4"/>Þú hetja, tak herklæði þín, máttugur ertu og krýndur ljóma <verse eid="PSA 45:4"/><verse number="5" style="v" sid="PSA 45:5"/>Sæktu fram! Sigursæll ertu, vörður tryggðar og réttlætis. Gakk fram – máttarverk þín verði á allra vörum!<verse eid="PSA 45:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 45:6"/>Örvar þínar eru hvesstar, óvinir falla að fótum þér. <verse eid="PSA 45:6"/><verse number="7" style="v" sid="PSA 45:7"/>Hásæti þitt, ó Guð, stendur um eilífð. Réttlætið er sproti þinn. <verse eid="PSA 45:7"/><verse number="8" style="v" sid="PSA 45:8"/>Þú elskar hið góða hefur andstyggð á illsku. Því hefur Guð, þinn Guð, sveipað þig gleði sem engan annan.<verse eid="PSA 45:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 45:9"/>Skikkja þín ilmar af myrru, alóe og kassíu. Hallir þínar eru skreyttar fílabeini og fyllast af ljúfum tónum. <verse eid="PSA 45:9"/><verse number="10" style="v" sid="PSA 45:10"/>Konungadætur eru í hópi vinkvenna þinna. Drottningin stendur þér við hlið, fagurlega klædd og skreytt skíra gulli frá Ófír! <verse eid="PSA 45:10"/><verse number="11-12" style="v" pubnumber="11,12" sid="PSA 45:11-12"/> „Dóttir mín, hlustaðu. Ég vil gefa þér ráð: Gleymdu heimþránni, vertu ekki döpur. Konungurinn elskar þig og gleðst yfir fegurð þinni. Sýndu honum lotningu því hann er herra þinn. <verse eid="PSA 45:11-12"/><verse number="13" style="v" sid="PSA 45:13"/>Íbúar Týrus, baða þig í gjöfum og auðmenn þjóðarinnar leita hylli þinnar.“<verse eid="PSA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 45:14"/>Brúðurin – konungsdóttir – bíður í skrauthýsi sínu, íklædd fegursta djásni, kjól skreyttum gulli og perlum. <verse eid="PSA 45:14"/><verse number="15" style="v" sid="PSA 45:15"/>Fögur er hún! Meyjarnar leiða hana á fund konungs. <verse eid="PSA 45:15"/><verse number="16" style="v" sid="PSA 45:16"/>Þær fara í skrúðgöngu gegnum hliðið. Þarna er höllin! <verse eid="PSA 45:16"/><verse number="17" style="v" sid="PSA 45:17"/>„Synir þínir verða allir konungar og feta í fótspor föður síns. Þeir munu sitja á hásætum víðs vegar um heim!“<verse eid="PSA 45:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 45:18"/>„Ég mun gera nafn þitt kunnugt meðal allra kynslóða og þjóðir jarðarinnar munu hylla þig að eilífu.“<verse eid="PSA 45:18"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 46:1-2"/> Guð er mér hæli og styrkur, örugg hjálp í nauðum. <verse eid="PSA 46:1-2"/><verse number="3" style="v" sid="PSA 46:3"/>Þess vegna óttumst við ekki, þótt heimurinn farist og fjöllin steypist í hafið. <verse eid="PSA 46:3"/><verse number="4" style="v" sid="PSA 46:4"/>Hafið æði og freyði, fjöllin nötri og skjálfi!<verse eid="PSA 46:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 46:5"/>Lækir gleðinnar streyma frá borg Guðs – frá heilögum bústað Guðs hins hæsta. <verse eid="PSA 46:5"/><verse number="6" style="v" sid="PSA 46:6"/>Hér býr Guð, hún mun ekki haggast. Þegar þörf er á, kemur Guð henni til hjálpar. <verse eid="PSA 46:6"/><verse number="7" style="v" sid="PSA 46:7"/>Þjóðir risu upp og létu ófriðlega en þegar Guð talaði varð heimurinn að þagna og jörðin nötraði.<verse eid="PSA 46:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 46:8"/>Drottinn, hann sem ræður hersveitum himinsins, er hér! Hann er á meðal okkar! Hann, Guð Jakobs, er kominn til að hjálpa.<verse eid="PSA 46:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 46:9"/>Komið og sjáið máttarverk hans á jörðinni. <verse eid="PSA 46:9"/><verse number="10" style="v" sid="PSA 46:10"/>Hann stöðvar styrjaldir um víða veröld, brýtur vopnin og kastar á eld.<verse eid="PSA 46:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 46:11"/>„Þögn! Standið kyrr! Vitið að ég er Guð! Allar þjóðir heims syni mér lotningu.“<verse eid="PSA 46:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 46:12"/>Drottinn hersveita himinsins er hér, hann er á meðal okkar! Hann, Guð Jakobs, er hér til að frelsa!<verse eid="PSA 46:12"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 47:1-2"/> Komið allar þjóðir! Klappið saman höndum af gleði! Hrópið af fögnuði fyrir Guði! <verse eid="PSA 47:1-2"/><verse number="3" style="v" sid="PSA 47:3"/>Drottinn er æðri öllum guðum. Hann er ógurlegur. Honum verður ekki með orðum lýst. Hann er konungur til endimarka jarðarinnar. <verse eid="PSA 47:3"/><verse number="4" style="v" sid="PSA 47:4"/>Hann hefur beygt þjóðir undir sig <verse eid="PSA 47:4"/><verse number="5" style="v" sid="PSA 47:5"/>og valið úr yndislegt land og gefið okkur, þjóð sinni, Ísrael.<verse eid="PSA 47:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 47:6"/>Guð er stiginn upp með miklu hrópi og hvellum lúðurhljómi.<verse eid="PSA 47:6"/></para>
  <para style="p">
    <verse number="7-8" style="v" pubnumber="7,8" sid="PSA 47:7-8"/> Lofsyngið Guði, konungi okkar. Já, syngið lofgjörðarsöng fyrir konunginn, konung allrar jarðarinnar. Lofsyngið Guði! <verse eid="PSA 47:7-8"/><verse number="9" style="v" sid="PSA 47:9"/>Hann ríkir yfir þjóðunum. Hann situr á hásæti sínu. <verse eid="PSA 47:9"/><verse number="10" style="v" sid="PSA 47:10"/>Leiðtogar heimsins koma og taka undir lofgjörðina með lýð Guðs Abrahams. Skjaldarmerki þjóðanna eru sigurtákn hans. Hann er mjög upphafinn. Hann er konungur alls heimsins.<verse eid="PSA 47:10"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 48:1-2"/> Mikill er Drottinn! Vegsömum hann, já lofum hann! Hann býr á sínu helga fjalli í Jerúsalem. <verse eid="PSA 48:1-2"/><verse number="3" style="v" sid="PSA 48:3"/>Fallegt er Síonfjall í norðri. Fjallið sem þjóðin elskar, þar sem konungurinn mikli býr.<verse eid="PSA 48:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 48:4"/>Drottinn sjálfur er verndari Jerúsalem. <verse eid="PSA 48:4"/><verse number="5" style="v" sid="PSA 48:5"/>Konungar jarðarinnar sátu þar ráðstefnu. Þeir skoðuðu borgina. <verse eid="PSA 48:5"/><verse number="6" style="v" sid="PSA 48:6"/>Þeir urðu agndofa, hræddir og flýðu. <verse eid="PSA 48:6"/><verse number="7" style="v" sid="PSA 48:7"/>Hátign Jerúsalem skelfdi þá. Þeir urðu magnþrota eins og kona sem fæðir barn! <verse eid="PSA 48:7"/><verse number="8" style="v" sid="PSA 48:8"/>Því að með austanvindinum einum tortímir þú heilum her! <verse eid="PSA 48:8"/><verse number="9" style="v" sid="PSA 48:9"/>Dýrð þín, Jerúsalem, er á allra vörum. Þú ert borgin þar sem Guð býr, hann sem ríkir yfir hersveitum himinsins. Við höfum séð hana eigin augum! Guð hefur reist Jerúsalem. Hún mun standa að eilífu.<verse eid="PSA 48:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 48:10"/>Drottinn, í musterinu hugleiðum við kærleika þinn. <verse eid="PSA 48:10"/><verse number="11" style="v" sid="PSA 48:11"/>Nafn þitt er þekkt um alla jörðina. Þú ert lofaður um víða veröld vegna hjálpræðis þíns. Vegsemd þín breiðist um allan heim því alls staðar framkvæmir þú réttlætisverk. <verse eid="PSA 48:11"/><verse number="12" style="v" sid="PSA 48:12"/>Gleð þig, Jerúsalem! Gleð þig Júdaættkvísl! Því að Guð mun vissulega láta þig ná rétti þínum. <verse eid="PSA 48:12"/><verse number="13" style="v" sid="PSA 48:13"/>Komið og skoðið borgina! Gangið um og teljið turnana! <verse eid="PSA 48:13"/><verse number="14-15" style="v" pubnumber="14,15" sid="PSA 48:14-15"/> Lítið á múrinn og sjáið hallirnar og segið komandi kynslóð frá því að slíkur sé Drottinn! Hann mun leiða okkur um aldur og ævi.<verse eid="PSA 48:14-15"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="p">
    <verse number="1-3" style="v" sid="PSA 49:1-3"/>Hlustið nú háir og lágir, ríkir og fátækir. Allir heimsbúar hlýðið á. <verse eid="PSA 49:1-3"/><verse number="4" style="v" sid="PSA 49:4"/>Ég tala til ykkar vísdómsorð. <verse eid="PSA 49:4"/><verse number="5" style="v" sid="PSA 49:5"/>Með undirleik hörpu kveð ég um hyggindi, veiti svör við spurningum lífsins: <verse eid="PSA 49:5"/><verse number="6" style="v" sid="PSA 49:6"/>Láttu ekki ógæfuna hræða þig, né óvini sem umkringja þig með illsku! <verse eid="PSA 49:6"/><verse number="7" style="v" sid="PSA 49:7"/>Auðæfum sínum treysta þeir og stæra sig af miklu ríkidæmi <verse eid="PSA 49:7"/><verse number="8" style="v" sid="PSA 49:8"/>en þó gæti enginn þeirra greitt Guði lausnargjald fyrir bróður sinn, keypt hann lausan. <verse eid="PSA 49:8"/><verse number="9-10" style="v" pubnumber="9,10" sid="PSA 49:9-10"/> Sál mannsins er dýrmætari en svo að hún verði keypt fyrir fé. Auður alls heimsins hrekkur ekki til að kaupa einum manni líf og forða honum frá gröfinni.<verse eid="PSA 49:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 49:11"/>Þið auðmenn og vitringar og aðrir sem hreykið ykkur hátt, þið munuð farast eins og aðrir menn. Þið hafið enga kröfu til lífsins fremur en fífl og fáráðlingar. Þið verðið að eftirláta öðrum auð ykkar. <verse eid="PSA 49:11"/><verse number="12" style="v" sid="PSA 49:12"/>Hús og eignir bera nöfn ykkar rétt eins og þið ætlið að búa þar að eilífu! <verse eid="PSA 49:12"/><verse number="13" style="v" sid="PSA 49:13"/>Nei, maðurinn verður að deyja. Hann er eins og skepnurnar, þrátt fyrir frægð sína og frama. <verse eid="PSA 49:13"/><verse number="14" style="v" sid="PSA 49:14"/>Slík verða afdrif hinna hrokafullu en samt mun þeirra getið með virðingu þegar þeir eru dauðir.<verse eid="PSA 49:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 49:15"/>En þeir fá ekki umflúið dauðann. Þegar upp er staðið verða hinir vondu að þjóna hinum góðu. Vald auðsins er þeim gagnslaust í dauðanum og ekki taka þeir auðæfi sín með sér.<verse eid="PSA 49:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 49:16"/>En hvað um mig? Guð mun leysa sál mína frá dauða og frelsa mig úr helju.<verse eid="PSA 49:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 49:17"/>Vertu ekki gramur þótt einhver verði ríkur og reisi sér glæsihöll. <verse eid="PSA 49:17"/><verse number="18" style="v" sid="PSA 49:18"/>Ekkert af því mun hann taka með sér í gröfina, ekki einu sinni frægð sína! <verse eid="PSA 49:18"/><verse number="19" style="v" sid="PSA 49:19"/>Í lifanda lífi telur hann sig heppinn og heimurinn klappar honum lof í lófa, <verse eid="PSA 49:19"/><verse number="20" style="v" sid="PSA 49:20"/>en þó deyr hann eins og aðrir og hverfur inn í myrkrið. <verse eid="PSA 49:20"/><verse number="21" style="v" sid="PSA 49:21"/>Sá sem elskar eigin lofstír deyr eins og skepnan, þrátt fyrir frægð sína og frama.<verse eid="PSA 49:21"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 50:1"/>Drottinn er alvaldur Guð. Hann kallar þjóð sína saman úr austri og vestri. <verse eid="PSA 50:1"/><verse number="2" style="v" sid="PSA 50:2"/>Dýrð Guðs ljómar frá musteri hans á Síonfjalli. <verse eid="PSA 50:2"/><verse number="3" style="v" sid="PSA 50:3"/>Hann birtist í þrumugný, umlukinn eyðandi eldi og stormviðri. <verse eid="PSA 50:3"/><verse number="4" style="v" sid="PSA 50:4"/>Hann er kominn til að dæma lýð sinn. Hróp hans heyrist á himni og jörðu: <verse eid="PSA 50:4"/><verse number="5" style="v" sid="PSA 50:5"/>„Safnið saman þjóð minni sem með fórnunum á altari mínu hefur gert sáttmála við mig.“ <verse eid="PSA 50:5"/><verse number="6" style="v" sid="PSA 50:6"/>Guð mun dæma réttláta dóma. Himinninn vitnar um réttlæti hans.<verse eid="PSA 50:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 50:7"/>Hlusta þú, þjóð mín! Ég er þinn Guð! Taktu eftir úrskurði mínum: <verse eid="PSA 50:7"/><verse number="8" style="v" sid="PSA 50:8"/>Fórnir þínar tek ég gildar. Þar hefur þú sýnt trúfesti. <verse eid="PSA 50:8"/><verse number="9" style="v" sid="PSA 50:9"/>En ég girnist þó ekki uxa þína og geitur, <verse eid="PSA 50:9"/><verse number="10-11" style="v" pubnumber="10,11" sid="PSA 50:10-11"/> því að öll dýr jarðarinnar tilheyra mér! Hjarðirnar á fjöllunum og fuglar loftsins – allt er það mitt. <verse eid="PSA 50:10-11"/><verse number="12" style="v" sid="PSA 50:12"/>Væri ég hungraður, segði ég þér ekki frá því – allt á jörðu er mitt, ekkert er undan skilið. <verse eid="PSA 50:12"/><verse number="13" style="v" sid="PSA 50:13"/>Nei, ég þrái ekki kjötfórnir þínar og blóðfórnir, <verse eid="PSA 50:13"/><verse number="14-15" style="v" pubnumber="14,15" sid="PSA 50:14-15"/> heldur þakklæti og orðheldni. Ákallaðu mig á degi neyðarinnar og þá mun ég frelsa þig. Og þú skalt vegsama mig. Já, þetta skaltu gera. <verse eid="PSA 50:14-15"/><verse number="16" style="v" sid="PSA 50:16"/>En við hina óguðlegu segir Drottinn: „Hættið að þylja upp lögmál mitt og heimta af mér, <verse eid="PSA 50:16"/><verse number="17" style="v" sid="PSA 50:17"/>þið sem hafnið aga og lítilsvirðið boðorð mín. <verse eid="PSA 50:17"/><verse number="18" style="v" sid="PSA 50:18"/>Þið aðstoðið þjófinn og samneytið hórkörlum. <verse eid="PSA 50:18"/><verse number="19" style="v" sid="PSA 50:19"/>Þið bölvið og ljúgið <verse eid="PSA 50:19"/><verse number="20" style="v" sid="PSA 50:20"/>og baktalið bróður ykkar. <verse eid="PSA 50:20"/><verse number="21" style="v" sid="PSA 50:21"/>Þannig ferst ykkur og svo á ég að þegja?! Er ég þá eins og þið? Nei, ég mun hegna ykkur svo ekki verður um villst. <verse eid="PSA 50:21"/><verse number="22" style="v" sid="PSA 50:22"/>En þið sem gleymduð Guði, fáið eitt tækifæri enn, síðan læt ég eyðinguna koma og þá er allt um seinan.<verse eid="PSA 50:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 50:23"/>Sá sem færir þakkargjörð að fórn, heiðrar mig. Og þeir sem breyta eftir orðum mínum fá að sjá hjálpræði mitt.“<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 51:1"/>Þennan sálm orti Davíð <verse eid="PSA 51:1"/><verse number="2" style="v" sid="PSA 51:2"/>eftir að Natan spámaður hafði birt honum dóm Guðs vegna hórdóms hans með Batsebu og morðsins á Úría eiginmanni hennar.<verse eid="PSA 51:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 51:3"/>Þú góði og miskunnsami Guð, ó, fyrirgefðu mér! Vertu mér náðugur! Taktu burt synd mína og skömm! <verse eid="PSA 51:3"/><verse number="4" style="v" sid="PSA 51:4"/>Þvoðu mig hreinan af syndasekt minni. Hreinsaðu hjarta mitt <verse eid="PSA 51:4"/><verse number="5" style="v" sid="PSA 51:5"/>því að ég játa synd mína – daga og nætur minnir hún á sig! <verse eid="PSA 51:5"/><verse number="6" style="v" sid="PSA 51:6"/>Gegn þér, já þér einum, hef ég brotið. Drýgt hræðilega synd. Þú varst vitni að öllu þessu og dómur þinn er réttlátur. <verse eid="PSA 51:6"/><verse number="7" style="v" sid="PSA 51:7"/>Syndugur var ég þegar móðir mín fæddi mig, sekur þegar ég varð til. <verse eid="PSA 51:7"/><verse number="8" style="v" sid="PSA 51:8"/>Þú vilt að menn séu hreinskilnir við sjálfa sig, einlægir og segi satt. Gefðu mér náð til að gera það!<verse eid="PSA 51:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 51:9"/>Þvoðu mig að ég verði hreinn, hreinsaðu mig svo ég verði hvítari en snjór. <verse eid="PSA 51:9"/><verse number="10" style="v" sid="PSA 51:10"/>Og þegar þú hefur refsað mér, þá gefðu mér gleði mína á ný. <verse eid="PSA 51:10"/><verse number="11" style="v" sid="PSA 51:11"/>Einblíndu ekki á syndir mínar, heldur afmáðu þær allar. <verse eid="PSA 51:11"/><verse number="12" style="v" sid="PSA 51:12"/>Skapaðu í mér nýtt og hreint hjarta, ó Guð! Gefðu mér þinn heilaga anda svo að ég hugsi rétt og þrái það sem gott er. <verse eid="PSA 51:12"/><verse number="13" style="v" sid="PSA 51:13"/>Varpaðu mér ekki burt frá þér og taktu ekki þinn heilaga anda frá mér. <verse eid="PSA 51:13"/><verse number="14" style="v" sid="PSA 51:14"/>Fylltu mig aftur gleði þíns hjálpræðis og löngun til að hlýða þér! <verse eid="PSA 51:14"/><verse number="15" style="v" sid="PSA 51:15"/>Þá get ég leitt aðra syndara inn á veg þinn svo að þeir – sekir eins og ég – játi syndir sínar og snúi sér til þín. <verse eid="PSA 51:15"/><verse number="16-17" style="v" pubnumber="16,17" sid="PSA 51:16-17"/> Frelsaðu mig frá dauðans háska, ó Guð minn. Þú einn getur frelsað mig! Leyf mér að syngja um miskunn þína, Drottinn. Opnaðu varir mínar svo að ég megi vegsama þig! <verse eid="PSA 51:16-17"/><verse number="18" style="v" sid="PSA 51:18"/>Þú hefur ekki þóknun á dýrafórnum, annars myndi ég láta þær í té. Og brennifórnir eru ekki í uppáhaldi hjá þér. <verse eid="PSA 51:18"/><verse number="19" style="v" sid="PSA 51:19"/>Þetta vilt þú: Auðmjúkan anda og iðrandi samvisku. Þann sem iðrast af öllu hjarta, munt þú ó Guð, ekki fyrirlíta.<verse eid="PSA 51:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 51:20"/>Drottinn, lát Ísrael ekki gjalda syndar minnar. Hjálpaðu þjóð þinni og vernda Jerúsalem.<verse eid="PSA 51:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 51:21"/>Þegar hjarta mitt er rétt gagnvart þér, þá gleðst þú yfir verkum mínum og því sem ég fórna á altari þínu.<verse eid="PSA 51:21"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 52:1"/>Þennan sálm orti Davíð <verse eid="PSA 52:1"/><verse number="2" style="v" sid="PSA 52:2"/>til að andmæla óvini sínum Dóeg sem síðar tók af lífi áttatíu og fimm presta og fjölskyldur þeirra (sjá: 1. Sam. 22.).<verse eid="PSA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 52:3"/>Kallar þú þig hetju?! Þú sem hreykir þér af ódæði gegn þjóð Guðs og herðir þig gegn miskunn hans. <verse eid="PSA 52:3"/><verse number="4" style="v" sid="PSA 52:4"/>Þú ert eins og skeinuhættur hnífur, þú svikahrappur! <verse eid="PSA 52:4"/><verse number="5" style="v" sid="PSA 52:5"/>Þú elskar illt meir en gott, lygi umfram sannleika. <verse eid="PSA 52:5"/><verse number="6" style="v" sid="PSA 52:6"/>Rógburð elskar þú og annað skaðræðistal!<verse eid="PSA 52:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 52:7"/>En Guð mun koma þér á kné, draga þig út úr húsi þínu og uppræta af landi lifenda. <verse eid="PSA 52:7"/><verse number="8" style="v" sid="PSA 52:8"/>Hinir réttlátu munu sjá það og óttast Guð, síðan hlægja og segja: <verse eid="PSA 52:8"/><verse number="9" style="v" sid="PSA 52:9"/>„Svo fer fyrir þeim sem fyrirlíta Guð og treysta á mátt sinn og megin, þeim sem þrjóskast í illsku sinni.“<verse eid="PSA 52:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 52:10"/>Ég er sem grænt olífutré í garði Guðs. Ég treysti á miskunn hans meðan ég lifi. <verse eid="PSA 52:10"/><verse number="11" style="v" sid="PSA 52:11"/>Drottinn, ég vil vegsama þig að eilífu og þakka það sem þú hefur gert. Ég segi hinum trúuðu: Góður er Guð!<verse eid="PSA 52:11"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 53:1-2"/> En sú heimska að segja: „Guð er ekki til.“ Hvers vegna segja menn slíkt? Vegna þess að hjörtu þeirra eru spillt og verk þeirra vond.<verse eid="PSA 53:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 53:3"/>Guð lítur niður af himni. Hann rennir augum yfir mannanna börn. Skyldi nokkur vera hygginn og leita vilja Guðs? <verse eid="PSA 53:3"/><verse number="4" style="v" sid="PSA 53:4"/>Nei, allir hafa þeir snúið í hann baki. Þeir eru spilltir. Enginn þeirra gerir vilja Guðs, ekki einn einasti! <verse eid="PSA 53:4"/><verse number="5" style="v" sid="PSA 53:5"/>Þeir munu fá sinn dóm, illgjörðamennirnir sem ofsækja lýð Guðs. <verse eid="PSA 53:5"/><verse number="6" style="v" sid="PSA 53:6"/>Þeir munu þjást af ótta, jafnvel þegar engin hætta er! Guð mun á sínum tíma tvístra þeim. Hann hefur fellt sinn dóm og hafnað þeim.<verse eid="PSA 53:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 53:7"/>Ó, að Guð kæmi frá Síon og frelsaði Ísrael! Þá munum við taka gleði okkar á ný.<verse eid="PSA 53:7"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 54:1"/>Sálmur eftir Davíð, <verse eid="PSA 54:1"/><verse number="2" style="v" sid="PSA 54:2"/>ortur þegar menn frá Síf reyndu að svíkja hann í hendur Sál konungs.<verse eid="PSA 54:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 54:3"/>Komdu í mætti þínum, ó Guð, og bjargaðu mér! Verndaðu mig með krafti þínum! <verse eid="PSA 54:3"/><verse number="4" style="v" sid="PSA 54:4"/>Bænheyrðu mig, <verse eid="PSA 54:4"/><verse number="5" style="v" sid="PSA 54:5"/>því að ofbeldismenn hafa risið gegn mér – heiðingjar sem ekki trúa á þig, sækjast eftir lífi mínu.<verse eid="PSA 54:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 54:6"/>En Guð er minn hjálpari. Hann er vinur minn! <verse eid="PSA 54:6"/><verse number="7" style="v" sid="PSA 54:7"/>Fyrir hans tilverknað mun illska þeirra koma þeim sjálfum í koll. Efndu loforð þitt, Guð, og þurrkaðu út þessa illvirkja.<verse eid="PSA 54:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 54:8"/>Glaður kem ég fram fyrir þig með fórn mína. Ég lofa nafn þitt, Drottinn, því það er gott.<verse eid="PSA 54:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 54:9"/>Guð hefur frelsað mig frá dauða og yfirbugað óvini mína.<verse eid="PSA 54:9"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 55:1-2"/> Heyr bæn mína, ó Guð! Snú þér ekki frá þegar ég ákalla þig. <verse eid="PSA 55:1-2"/><verse number="3" style="v" sid="PSA 55:3"/>Hlustaðu á ákall mitt. Ég andvarpa og græt í sorg minni.<verse eid="PSA 55:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 55:4"/>Óvinir mínir æpa á mig, hóta að drepa mig. Þeir umkringja mig og brugga mér banaráð, öskra á mig í hamslausri reiði. <verse eid="PSA 55:4"/><verse number="5-6" style="v" pubnumber="5,6" sid="PSA 55:5-6"/> Ég er lamaður af ótta, fullur örvæntingar. Hvílík skelfing! <verse eid="PSA 55:5-6"/><verse number="7" style="v" sid="PSA 55:7"/>Ó, að ég hefði vængi eins og fuglinn! Þá mundi ég fljúga burt og leita skjóls. <verse eid="PSA 55:7"/><verse number="8" style="v" sid="PSA 55:8"/>Ég mundi svífa langt og leita skjóls í eyðimörkinni, <verse eid="PSA 55:8"/><verse number="9" style="v" sid="PSA 55:9"/>flýja á öruggan stað, laus úr allri hættu.<verse eid="PSA 55:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 55:10"/>Ó, Drottinn, ruglaðu þá í ríminu! Sérðu ekki kúgunina sem viðgengst? <verse eid="PSA 55:10"/><verse number="11" style="v" sid="PSA 55:11"/>Þeir vakta borgina daga og nætur, ganga múrana og skima eftir óvinum. En neyðin er innandyra, því að ofbeldi og svik eru í borginni, <verse eid="PSA 55:11"/><verse number="12" style="v" sid="PSA 55:12"/>morð og gripdeildir.<verse eid="PSA 55:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 55:13"/>Ekki var það óvinur minn sem ofsótti mig – það gæti ég þolað. Þá hefði ég falið mig um stund. <verse eid="PSA 55:13"/><verse number="14" style="v" sid="PSA 55:14"/>En það varst þú, vinur minn og félagi. <verse eid="PSA 55:14"/><verse number="15" style="v" sid="PSA 55:15"/>Við sem vorum alúðarvinir og gengum saman í Guðs hús.<verse eid="PSA 55:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 55:16"/>Dauðinn taki þá og dragi þá til heljar, því að illska er í húsum þeirra, synd í hjörtum þeirra.<verse eid="PSA 55:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 55:17"/>En ég hrópa til Guðs, og hann mun frelsa mig! <verse eid="PSA 55:17"/><verse number="18" style="v" sid="PSA 55:18"/>Kvölds og morgna og um miðjan dag sárbæni ég Guð. Ég veit að hann heyrir til mín og mun svara mér. <verse eid="PSA 55:18"/><verse number="19" style="v" sid="PSA 55:19"/>Þótt óvinir mínir séu margir, mun hann samt frelsa mig og gefa mér frið. <verse eid="PSA 55:19"/><verse number="20" style="v" sid="PSA 55:20"/>Sjálfur Guð – sem er frá eilífð – mun svara mér, en óvinir mínir, breytast ekki og óttast ekki Guð.<verse eid="PSA 55:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 55:21"/>En vinur minn, sveik mig og ofsótti – rauf heit sitt. <verse eid="PSA 55:21"/><verse number="22" style="v" sid="PSA 55:22"/>Orðin á tungu hans voru ljúf og blíð en hjartað fullt af hatri.<verse eid="PSA 55:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 55:23"/>Varpaðu áhyggjum þínum á Drottin, hann ber umhyggju fyrir þér. Hann mun aldrei láta trúaðan mann verða valtan á fótum. <verse eid="PSA 55:23"/><verse number="24" style="v" sid="PSA 55:24"/>Guð mun varpa óvinum mínum til heljar, til dánarheima. Morðingjar og svikarar munu ekki ná háum aldri. En ég treysti þér, að þú leyfir mér að lifa.<verse eid="PSA 55:24"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 56:1-2"/> Drottinn, miskunna þú mér, því að liðlangan daginn sækja óvinir mínir að. <verse eid="PSA 56:1-2"/><verse number="3" style="v" sid="PSA 56:3"/>Fjandmennirnir ryðjast fram, fjölmennt lið, þeir ætla að drepa mig.<verse eid="PSA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 56:4"/>Þegar ég er hræddur, set ég traust mitt á þig. <verse eid="PSA 56:4"/><verse number="5" style="v" sid="PSA 56:5"/>Ég treysti loforðum Guðs og veit því að þessir óvinir munu ekki ná mér, þeir eru aðeins dauðlegir menn! <verse eid="PSA 56:5"/><verse number="6" style="v" sid="PSA 56:6"/>Þeir vinna gegn mér með öllum ráðum og hugsa um það eitt að fella mig. <verse eid="PSA 56:6"/><verse number="7" style="v" sid="PSA 56:7"/>Þeir áreita mig, sitja um mig. Þeir liggja í leyni eins og stigamenn, hlusta eftir fótataki mínu og leggja ör á streng. <verse eid="PSA 56:7"/><verse number="8" style="v" sid="PSA 56:8"/>Þeir halda sig sleppa við refsingu, og komast undan, en Drottinn, láttu þá fá makleg málagjöld, annað er ekki réttlátt.<verse eid="PSA 56:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 56:9"/>Þú þekkir alla hrakninga mína og tár, já, þekkir þau með tölu!<verse eid="PSA 56:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 56:10"/>Þegar ég hrópa til þín um hjálp, breytist bardaginn. Óvinir mínir flýja! Þá veit ég að Guð er með mér! Hann liðsinnir mér! <verse eid="PSA 56:10"/><verse number="11" style="v" sid="PSA 56:11"/>Með hjálp Guðs mun ég lofa orð hans, já vissulega mun ég lofa orð hans. <verse eid="PSA 56:11"/><verse number="12" style="v" sid="PSA 56:12"/>Ég treysti Guði. Loforð hans eru dásamleg! Ég óttast ekki svikráð mannanna – hvað geta þeir gert mér?! <verse eid="PSA 56:12"/><verse number="13" style="v" sid="PSA 56:13"/>Drottinn, ég vil standa við orð mín og þakka þér hjálpina! <verse eid="PSA 56:13"/><verse number="14" style="v" sid="PSA 56:14"/>Þú hefur frelsað mig frá dauða og forðað frá hrösun og þess vegna fæ ég að njóta ljóss og lífs með þér.<verse eid="PSA 56:14"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 57:1-2"/> Þennan sálm orti Davíð þegar hann flýði inn í hellinn undan Sál. (Sjá <char style="xt"><ref loc="1SA 22:1-2">1. Sam. 22:1‑2</ref> og <ref loc="1SA 24:1-9">24:1‑9</ref></char>).</para>
  <para style="p" vid="PSA 57:1-2">Ó Guð, vertu mér náðugur, því að ég treysti þér. Ég vil leita skjóls undir vængjum þínum uns storminn hefur lægt. <verse eid="PSA 57:1-2"/><verse number="3" style="v" sid="PSA 57:3"/>Ég hrópa til Guðs hins hæsta, hans sem leysir öll mín mál. <verse eid="PSA 57:3"/><verse number="4" style="v" sid="PSA 57:4"/>Hann sendir mér hjálp frá himnum og frelsar mig vegna elsku sinnar og trúfesti. Hann mun bjarga mér frá lygurum sem sitja um líf mitt. <verse eid="PSA 57:4"/><verse number="5" style="v" sid="PSA 57:5"/>Ég er umkringdur ofstopamönnum – glefsandi úlfum. Tennur þeirra eru hvassari en örvar og spjót og tungurnar beittari en sverð! <verse eid="PSA 57:5"/><verse number="6" style="v" sid="PSA 57:6"/>Drottinn, lofað sé nafn þitt á himnum! Láttu dýrð þína líka birtast á jörðu! <verse eid="PSA 57:6"/><verse number="7" style="v" sid="PSA 57:7"/>Óvinir mínir hafa lagt gildru fyrir mig. Þeir hafa grafið mér gryfju. Ég er mæddur og kvíðinn. En! Eitt veit ég: Þeir munu sjálfir falla í hana!<verse eid="PSA 57:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 57:8"/>Guð minn, nú er hjarta mitt rótt og ég treysti þér. Ég vil lofa þig! <verse eid="PSA 57:8"/><verse number="9" style="v" sid="PSA 57:9"/>Rís þú nú upp, sál mín! <verse eid="PSA 57:9"/><verse number="10" style="v" sid="PSA 57:10"/>Vakna þú harpa og gígja! Bjóddu morgunroðann velkominn með söng! Allir landsbúar heyra þakkargjörð mína. <verse eid="PSA 57:10"/><verse number="11" style="v" sid="PSA 57:11"/>Ég vil syngja þér lof meðal þjóðanna. <verse eid="PSA 57:11"/><verse number="12" style="v" sid="PSA 57:12"/>Miskunn þín er há eins og himinninn og trúfesti þín nær til skýjanna. <verse eid="PSA 57:12"/><verse number="13" style="v" sid="PSA 57:13"/>Þú ert hærri en hæstu himnar, ó, Guð. Láttu dýrð þína breiðast yfir gjörvalla jörðina.<verse eid="PSA 57:13"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 58:1-2"/> Þið konungar og leiðtogar þjóðanna, talið þið sannleika? Er réttlæti í dómum ykkar og úrskurðum? <verse eid="PSA 58:1-2"/><verse number="3" style="v" sid="PSA 58:3"/>Nei, svo er ekki. Þið eruð allir svikarar sem seljið „réttlæti“ fyrir mútur. <verse eid="PSA 58:3"/><verse number="4" style="v" sid="PSA 58:4"/>Slíkir menn hafa allt frá fæðingu vikið af réttum vegi. Þeir hafa talað lygi frá því þeir fengu málið. <verse eid="PSA 58:4"/><verse number="5-6" style="v" pubnumber="5,6" sid="PSA 58:5-6"/> Eiturnöðrur eru þeir, slöngur sem daufheyrast við skipunum særingamannsins.<verse eid="PSA 58:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 58:7"/>Drottinn, slíttu úr þeim eiturbroddinn! Dragðu vígtennurnar úr þessum vörgum, ó Guð. <verse eid="PSA 58:7"/><verse number="8" style="v" sid="PSA 58:8"/>Láttu þá hverfa eins og jörðin hafi gleypt þá. Sláðu vopnin úr höndum þeirra. <verse eid="PSA 58:8"/><verse number="9" style="v" sid="PSA 58:9"/>Láttu þá þorna upp eins og snigla og ekki sjá sólina frekar en þeir sem andvana eru fæddir. <verse eid="PSA 58:9"/><verse number="10" style="v" sid="PSA 58:10"/>Guð mun svipta þeim burt, eyða þeim skjótar en pottur hitnar yfir eldi.<verse eid="PSA 58:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 58:11"/>Þá munu hinir guðhræddu fagna, þegar réttlætið sigrar og þeir fá að ganga um blóðidrifin stræti fallinna óvina. <verse eid="PSA 58:11"/><verse number="12" style="v" sid="PSA 58:12"/>Þá munu menn sjá að réttlætið sigrar og að Guð dæmir jörðina með réttvísi.<verse eid="PSA 58:12"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 59:1"/>Þennan sálm orti Davíð þegar Sál konungur sendi menn heim til hans til að handsama hann og drepa (sjá: 1. Sam. 19:11).<verse eid="PSA 59:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 59:2"/>Ó, Guð minn, frelsaðu mig frá óvinum mínum! Verndaðu mig gegn þeim sem vilja drepa mig! <verse eid="PSA 59:2"/><verse number="3" style="v" sid="PSA 59:3"/>Forðaðu mér frá þessum glæpalýð, þessum morðingjum. <verse eid="PSA 59:3"/><verse number="4" style="v" sid="PSA 59:4"/>Þeir sitja um líf mitt. Sterkir menn bíða útifyrir. Drottinn, þeir eru ekki hér af því að ég hafi gert þeim rangt. <verse eid="PSA 59:4"/><verse number="5" style="v" sid="PSA 59:5"/>Samt vilja þeir drepa mig! Drottinn, vaknaðu! Sjáðu hvað er að gerast! Hjálpaðu mér! <verse eid="PSA 59:5"/><verse number="6" style="v" sid="PSA 59:6"/>Þú Drottinn, Guð hinna himnesku hersveita, Guð Ísraels, rís þú upp og refsa heiðnu þjóðunum sem umhverfis okkur búa. Miskunna ekki illgjörðamönnum. <verse eid="PSA 59:6"/><verse number="7" style="v" sid="PSA 59:7"/>Að kvöldi koma þeir og njósna. Þeir snuðra eins og hundar og ráfa um borgina. <verse eid="PSA 59:7"/><verse number="8" style="v" sid="PSA 59:8"/>Ég heyri háðsglósur þeirra og hvernig þeir formæla Guði. „Enginn heyrir til okkar,“ segja þeir. <verse eid="PSA 59:8"/><verse number="9" style="v" sid="PSA 59:9"/>En þú Drottinn, hlærð að þeim, gerir einnig gys að heiðingjunum sem umhverfis okkur búa.<verse eid="PSA 59:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 59:10"/>Guð, þú ert styrkur minn! Ég vil syngja þér lof, því að þú ert skjól mitt og hlíf.<verse eid="PSA 59:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 59:11"/>Guð mætir mér með náð sinni. Hann lætur mig sjá þegar óvinir mínir verða auðmýktir. <verse eid="PSA 59:11"/><verse number="12" style="v" sid="PSA 59:12"/>Ekki lífláta þá, þeirri ráðningu gleymir þjóð mín fljótt. Steyptu þeim heldur af stóli. Varpa þeim til jarðar, Drottinn, þú skjöldur minn. <verse eid="PSA 59:12"/><verse number="13" style="v" sid="PSA 59:13"/>Þeir eru hrokafullir. Þeir formæla og ljúga. <verse eid="PSA 59:13"/><verse number="14" style="v" sid="PSA 59:14"/>Sviptu þeim burt með reiði þinni svo að þeir verði ekki framar til. Láttu þá kenna á því og sjá að þú, Drottinn, ert við völd í Ísrael og um allan heim.<verse eid="PSA 59:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 59:15"/>Á hverju kvöldi koma þeir aftur, ýlfra eins og hundar og ráfa um borgina, urra og leita að æti.<verse eid="PSA 59:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 59:16"/>En ég? – Á hverjum morgni vil ég syngja um miskunn þína og mátt, því að á degi neyðarinnar varstu mér vígi. <verse eid="PSA 59:16"/><verse number="17" style="v" sid="PSA 59:17"/>Þú styrkur minn, um þig vil ég syngja ljóðin mín. Þú háborg mín! Þú minn miskunnsami Guð!<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 60:1"/>Þennan sálm orti Davíð <verse eid="PSA 60:1"/><verse number="2" style="v" sid="PSA 60:2"/>þegar hann átti í ófriði við Sýrlendinga og óvíst var um úrslit. Þetta gerðist á sama tíma og Jóab, hershöfðingi Ísraels, vann sigur á 12.000 Edomítum í Saltdalnum.<verse eid="PSA 60:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 60:3"/>Þú Guð, hefur útskúfað okkur og brotið niður varnirnar. Þú hefur reiðst okkur og tvístrað. Drottinn sýndu aftur miskunn þína. <verse eid="PSA 60:3"/><verse number="4" style="v" sid="PSA 60:4"/>Þú lést landið skjálfa, sprungur opnuðust. Drottinn læknaðu það og græddu sárin. <verse eid="PSA 60:4"/><verse number="5" style="v" sid="PSA 60:5"/>Þú lést lýð þinn kenna á hörðu, við reikuðum eins og drukknir menn.<verse eid="PSA 60:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 60:6"/>En nú hefur þú reist okkur herfána! Þangað stefnum við allir sem elskum þig. <verse eid="PSA 60:6"/><verse number="7" style="v" sid="PSA 60:7"/>Réttu út þína sterku hönd og frelsaðu okkur! Bjargaðu ástvinum þínum. <verse eid="PSA 60:7"/><verse number="8-9" style="v" pubnumber="8,9" sid="PSA 60:8-9"/> Guð hefur heitið hjálp. Hann hefur svarið það við heilagleika sinn! Er að undra þótt ég sé glaður?! „Síkem, Súkkót, Gíleað, Manasse – allt er þetta mitt,“ segir hann. „Júda gefur konung og Efraím varðmenn. <verse eid="PSA 60:8-9"/><verse number="10" style="v" sid="PSA 60:10"/>Móab er þjónn minn og Edóm þræll. Og yfir Filisteu æpi ég siguróp!“<verse eid="PSA 60:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 60:11"/>Hver fer með til Edóms, inn í víggirtar borgir hans? <verse eid="PSA 60:11"/><verse number="12" style="v" sid="PSA 60:12"/>Guð! Hann sem áður útskúfaði og yfirgaf hersveitir okkar!<verse eid="PSA 60:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 60:13"/>Drottinn, styð okkur gegn óvinunum, því að ekki hjálpa menn.<verse eid="PSA 60:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 60:14"/>Með Guðs hjálp vinnum við stórvirki, hann mun fótum troða óvinina.<verse eid="PSA 60:14"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 61:1-2"/> Ó, Guð, heyrðu hróp mitt! Hlustaðu á bæn mína. <verse eid="PSA 61:1-2"/><verse number="3" style="v" sid="PSA 61:3"/>Því að hvar sem ég fer, jafnvel um endimörk jarðar, þá hrópa ég eftir hjálp þinni. Þegar hjarta mitt örmagnast og ég get ekki meir, þá lyftu mér á klett, hjálpræðisbjargið þitt góða, mitt örugga skjól. <verse eid="PSA 61:3"/><verse number="4" style="v" sid="PSA 61:4"/>Þú ert skjól mitt, háreist borg, ókleif óvinum.<verse eid="PSA 61:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 61:5"/>Í helgidómi þínum mun ég búa að eilífu, öruggur í skjóli vængja þinna, <verse eid="PSA 61:5"/><verse number="6" style="v" sid="PSA 61:6"/>Því að þú, ó Guð, hefur heyrt heit mín og uppfyllt óskir þeirra sem óttast þig og heiðra nafn þitt.<verse eid="PSA 61:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 61:7"/>Þú munt lengja lífdaga mína og láta ævi konungsins vara frá kyni til kyns. <verse eid="PSA 61:7"/><verse number="8" style="v" sid="PSA 61:8"/>Ég mun lifa frammi fyrir Drottni að eilífu! Lát elsku þína og trúfesti gæta mín, þá mun ég lofa nafn þitt um aldur og ævi og efna heit mín dag eftir dag.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 62:1-2"/> Ég bíð rólegur og þögull eftir hjálp Drottins. <verse eid="PSA 62:1-2"/><verse number="3" style="v" sid="PSA 62:3"/>Hann einn er bjarg mitt og lausnari, vörn mín og vígi. Ég hef ekkert að óttast.<verse eid="PSA 62:3"/></para>
  <para style="p">
    <verse number="4-5" style="v" pubnumber="4,5" sid="PSA 62:4-5"/> En hvað um þessa menn sem ásaka mig þegar veldi mitt stendur höllum fæti, vilja mig feigan og ljúga og pretta til að steypa mér af stóli. Þeir tala fagurgala, satt er það, en hata mig í hjörtum sínum! <verse eid="PSA 62:4-5"/><verse number="6" style="v" sid="PSA 62:6"/>En ég stend þögull frammi fyrir fyrir Drottni og vænti hjálpar hans. Hann einn getur hjálpað. <verse eid="PSA 62:6"/><verse number="7" style="v" sid="PSA 62:7"/>Já, hann einn er bjarg mitt, og lausnari, vörn mín og vígi. Ég hef ekkert að óttast.<verse eid="PSA 62:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 62:8"/>Öryggi mitt og farsæld er í hendi Drottins. Hann einn er skjól mitt og klettur – þangað kemst óvinurinn ekki!<verse eid="PSA 62:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 62:9"/>Þú þjóð mín, treystu Drottni. Segið honum óskir ykkar, hann getur uppfyllt þær! <verse eid="PSA 62:9"/><verse number="10" style="v" sid="PSA 62:10"/>Mennirnir miklast og hrokast í hégóma sínum. Einn þykist öðrum meiri, en hann metur alla jafnt.<verse eid="PSA 62:10"/></para>
  <para style="p">
    <verse number="11-12" style="v" pubnumber="11,12" sid="PSA 62:11-12"/> Safnið ekki auði með svikum og ránum og treystið ekki illa fengnu fé. Treystið Drottni! Minnist þess aftur og aftur að Drottins er styrkurinn. <verse eid="PSA 62:11-12"/><verse number="13" style="v" sid="PSA 62:13"/>Já, hjá þér Drottinn, er miskunn og þú launar sérhverjum eftir verkum hans.<verse eid="PSA 62:13"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 63:1"/>Þennan sálm orti Davíð þegar hann leitaði skjóls í Júdeueyðimörkinni.<verse eid="PSA 63:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 63:2"/>Ó, þú Guð minn, ég leita þín! Mig þyrstir eftir þér í þessari skrælnuðu eyðimörk. Ó, hve ég þrái þig! <verse eid="PSA 63:2"/><verse number="3" style="v" sid="PSA 63:3"/>Þegar ég gekk um í helgidómi þínum þá leitaði ég þín, þráði að sjá veldi þitt og dýrð.<verse eid="PSA 63:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 63:4"/>Miskunn þín er betri en lífið sjálft! Með vörum mínum lofa ég þig. <verse eid="PSA 63:4"/><verse number="5" style="v" sid="PSA 63:5"/>Ég vil lofa þig svo lengi sem ég lifi, lyfta höndum mínum í bæn til þín. <verse eid="PSA 63:5"/><verse number="6" style="v" sid="PSA 63:6"/>Þá mun sál mín mettast og verða glöð, og munnur minn lofa þig með fögnuði.<verse eid="PSA 63:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 63:7"/>Ég ligg andvaka um nætur og hugsa um þig, rifja upp öll þau skipti sem þú hefur hjálpað. <verse eid="PSA 63:7"/><verse number="8" style="v" sid="PSA 63:8"/>Þá fyllist ég gleði, finn mig öruggan hjá þér. <verse eid="PSA 63:8"/><verse number="9" style="v" sid="PSA 63:9"/>Ég vil halda mér fast við þig, og styðjast við þína sterku hönd. <verse eid="PSA 63:9"/><verse number="10" style="v" sid="PSA 63:10"/>Þeir munu sjálfir deyja sem brugga mér banaráð, og hverfa niður til heljar. <verse eid="PSA 63:10"/><verse number="11" style="v" sid="PSA 63:11"/>Þeir munu falla fyrir sverði, verða sjakölum að bráð.<verse eid="PSA 63:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 63:12"/>Ég vil gleðjast í Guði! Og þeir sem honum treysta skulu fagna sigri því að munni lygaranna hefur verið lokað.<verse eid="PSA 63:12"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="p">
    <verse number="1-3" style="v" sid="PSA 64:1-3"/>Ó, Drottinn, hlustaðu á neyðaróp mitt, því að hópur af þorpurum og bófum hafa gert samsæri gegn mér. Verndaðu mig! <verse eid="PSA 64:1-3"/><verse number="4" style="v" sid="PSA 64:4"/>Orð þeirra eru eins og rýtingur í bakið. Þeir hvæsa á mig og nísta hjarta mitt. <verse eid="PSA 64:4"/><verse number="5-6" style="v" pubnumber="5,6" sid="PSA 64:5-6"/> Þeir senda mér kaldar kveðjur úr launsátri, vinna verk sín í skyndi, eru hvergi smeykir. Þeir sitja á svikráðum. Hittast á laun og leggja gildrur fyrir aðra. „Þetta sér enginn,“ segja þeir. <verse eid="PSA 64:5-6"/><verse number="7" style="v" sid="PSA 64:7"/>Þeir upphugsa ill verk og segja „Nú er allt klappað og klárt!“ Hjörtu þeirra fyllast illsku og svikum.<verse eid="PSA 64:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 64:8"/>En Guð mun slá þá til jarðar. Eins og hendi sé veifað hittir örin þá <verse eid="PSA 64:8"/><verse number="9" style="v" sid="PSA 64:9"/>Tunga þeirra verður þeim að falli. Menn hrista höfuðið yfir þeim og <verse eid="PSA 64:9"/><verse number="10" style="v" sid="PSA 64:10"/>ótta slær á alla. Þeir játa mikilleik Guðs og hans voldugu verk, gefa gætur að því sem hann gerir. <verse eid="PSA 64:10"/><verse number="11" style="v" sid="PSA 64:11"/>En hinir trúuðu munu fagna í Drottni, leita hjálpar hans og hrósa sigri með honum.<verse eid="PSA 64:11"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 65:1-2"/> Ó, þú Guð á Síon, við lofum þig og vegsömum og efnum heit okkar við þig. <verse eid="PSA 65:1-2"/><verse number="3" style="v" sid="PSA 65:3"/>Þú heyrir bænir og því leita allir menn til þín. <verse eid="PSA 65:3"/><verse number="4" style="v" sid="PSA 65:4"/>Margar freistingar urðu mér að falli, ég gerði margt rangt, en þú fyrirgafst mér allar þessar syndir. <verse eid="PSA 65:4"/><verse number="5" style="v" sid="PSA 65:5"/>Sá er heppinn sem þú hefur útvalið, sá sem fær að búa hjá þér í forgörðum helgidóms þíns og njóta allsnægta í musteri þínu. <verse eid="PSA 65:5"/><verse number="6" style="v" sid="PSA 65:6"/>Með krafti þínum sýnir þú réttlæti þitt, þú Guð, frelsari okkar. Þú ert skjól öllum mönnum, allt að endimörkum jarðar.<verse eid="PSA 65:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 65:7"/>Þú reistir fjöllin í mætti þínum, <verse eid="PSA 65:7"/><verse number="8" style="v" sid="PSA 65:8"/>þú stöðvar brimgný hafsins og háreysti þjóðanna. <verse eid="PSA 65:8"/><verse number="9" style="v" sid="PSA 65:9"/>Þeir sem búa við ysta haf óttast tákn þín og austrið og vestrið kætast yfir þér! <verse eid="PSA 65:9"/><verse number="10" style="v" sid="PSA 65:10"/>Þú vökvar jörðina og eykur frjósemi hennar. Ár þínar og uppsprettur munu ekki þorna. Þú gerir jörðina hæfa til sáningar og gefur þjóð þinni ríkulega uppskeru. <verse eid="PSA 65:10"/><verse number="11" style="v" sid="PSA 65:11"/>Með steypiregni vökvar þú plógförin og mýkir jarðveginn – útsæðið spírar og vex! <verse eid="PSA 65:11"/><verse number="12-13" style="v" pubnumber="12,13" sid="PSA 65:12-13"/> Landið klæðist grænni kápu. Heiðarnar blómstra og hlíðarnar brosa, allt er loðið af gróðri! <verse eid="PSA 65:12-13"/><verse number="14" style="v" sid="PSA 65:14"/>Hjarðirnar liðast um hagana og dalirnir fyllast af korni. Allt fagnar og syngur!<verse eid="PSA 65:14"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 66:1"/>Allur heimurinn gleðjist með Guði! <verse eid="PSA 66:1"/><verse number="2" style="v" sid="PSA 66:2"/>Lofið nafn hans, það er undursamlegt! Segið öllum frá máttarverkum hans!<verse eid="PSA 66:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 66:3"/>Guð, hversu undursamleg eru verk þín! Máttur þinn er stórkostlegur! Ekki er að furða þótt óvinir þínir smjaðri fyrir þér. <verse eid="PSA 66:3"/><verse number="4" style="v" sid="PSA 66:4"/>Lofaður sért þú um víða veröld! <verse eid="PSA 66:4"/><verse number="5" style="v" sid="PSA 66:5"/>Komið og sjáið máttarverk Guðs! Mikil eru þau undur sem fólk hans fær að sjá og reyna. <verse eid="PSA 66:5"/><verse number="6" style="v" sid="PSA 66:6"/>Hann opnaði þeim veg í gegnum hafið! Þar gengu þeir yfir þurrum fótum. Hvílík gleði og fögnuður ríkti þann dag!<verse eid="PSA 66:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 66:7"/>Drottinn mun ríkja að eilífu vegna máttar síns. Hann virðir vandlega fyrir sér mennina. Engir uppreisnarmenn þora að láta á sér bæra.<verse eid="PSA 66:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 66:8"/>Sérhver maður lofi Drottin og vegsami nafn hans. <verse eid="PSA 66:8"/><verse number="9" style="v" sid="PSA 66:9"/>Hann gaf okkur lífið og hann verndar frá hrösun. <verse eid="PSA 66:9"/><verse number="10" style="v" sid="PSA 66:10"/>Þú, ó Guð, hreinsaðir okkur í eldi eins og silfur er hreinsað. <verse eid="PSA 66:10"/><verse number="11" style="v" sid="PSA 66:11"/>Þú hefur fjötrað okkur og lokað inni og lagt á okkur byrðar. <verse eid="PSA 66:11"/><verse number="12" style="v" sid="PSA 66:12"/>Þú lést hersveitir troða okkur fótum og við urðum að fara gegnum eld og vatn, en að lokum leiddir þú okkur út og inn í yndislegt land.<verse eid="PSA 66:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 66:13"/>Nú kem ég í helgidóm þinn, fórna og efni þannig heit mitt. <verse eid="PSA 66:13"/><verse number="14" style="v" sid="PSA 66:14"/>Manstu, þegar ég var í nauðum staddur, þá gaf ég þér heit? <verse eid="PSA 66:14"/><verse number="15" style="v" sid="PSA 66:15"/>Nú ber ég fram fórn mína: Hrúta, naut og kiðling. Megi reykurinn af fórnum þessum stíga upp til þín.<verse eid="PSA 66:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 66:16"/>Komið og hlustið, þið sem óttist Drottin, og ég skal segja ykkur hvað hann hefur gert fyrir mig!: <verse eid="PSA 66:16"/><verse number="17" style="v" sid="PSA 66:17"/>Ég hrópaði til hans um hjálp, – og víst bjó lofgjörðin undir! <verse eid="PSA 66:17"/><verse number="18" style="v" sid="PSA 66:18"/>En fyrst játaði ég synd mína, annars hefði ég ekki fengið svar. <verse eid="PSA 66:18"/><verse number="19" style="v" sid="PSA 66:19"/>En hann heyrði bæn mína og hlustaði, gaf gaum að því sem ég sagði.<verse eid="PSA 66:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 66:20"/>Lof sé Guði! Hann vísaði ekki bæn minni á bug né tók miskunn sína frá mér.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 67:1-2"/> Ó, veittu okkur miskunn þína og náð! Leyfðu okkur að sjá þig og kærleika þinn. <verse eid="PSA 67:1-2"/><verse number="3" style="v" sid="PSA 67:3"/>Leyfðu öllum mönnum að fá að kynnast þér og þekkja hjálpræði þitt. <verse eid="PSA 67:3"/><verse number="4" style="v" sid="PSA 67:4"/>Allar þjóðir skulu lofa Drottin. <verse eid="PSA 67:4"/><verse number="5" style="v" sid="PSA 67:5"/>Þær skulu fagna og gleðjast, því að þú færir þeim réttlæti, og leiðir þær um réttan veg. <verse eid="PSA 67:5"/><verse number="6" style="v" sid="PSA 67:6"/>Allur heimurinn lofi þig, ó Guð! Já, allar þjóðir í heiminum flytji þér þakkargjörð! <verse eid="PSA 67:6"/><verse number="7-8" style="v" pubnumber="7,8" sid="PSA 67:7-8"/> Því að uppskera jarðarinnar varð mikil og Guð, hefur blessað okkur ríkulega. Og hann blessi okkur áfram svo að allar þjóðir megi óttast hann og elska.<verse eid="PSA 67:7-8"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 68:1-2"/> Þegar Guð rís á fætur þá tvístrast óvinir hans! Þeir sem hata hann flýja sem mest þeir mega. <verse eid="PSA 68:1-2"/><verse number="3" style="v" sid="PSA 68:3"/>Blástu þeim burt eins og reyk í vindi! Bræddu þá eins og vax í eldi! Þannig munu óguðlegir tortímast fyrir Guði.<verse eid="PSA 68:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 68:4"/>En hinir trúuðu skulu fagna. Þeir kætist og gleðjist <verse eid="PSA 68:4"/><verse number="5" style="v" sid="PSA 68:5"/>og lofsyngi Guði! Hefjið lofsöng til hans sem ekur um á skýjunum. Nafn hans er Drottinn! Gleðjist og fagnið í nærveru hans. <verse eid="PSA 68:5"/><verse number="6" style="v" sid="PSA 68:6"/>Hann er faðir föðurlausra og verndari ekkna, hann er heilagur. <verse eid="PSA 68:6"/><verse number="7" style="v" sid="PSA 68:7"/>Hann lætur hinn einmana komast heim aftur og leiðir fanga út í frelsið á ný. Þar verður sungið og fagnað! En uppreisnarmenn skulu búa við sult og seyru.<verse eid="PSA 68:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 68:8"/>Guð, þegar þú leiddir þjóð þína gegnum öræfin, <verse eid="PSA 68:8"/><verse number="9" style="v" sid="PSA 68:9"/>þá skalf jörðin og himnarnir nötruðu. Sínaífjall hneigði sig fyrir þér af virðingu og ótta – þér Guði Ísraels. <verse eid="PSA 68:9"/><verse number="10-11" style="v" pubnumber="10,11" sid="PSA 68:10-11"/> Þú, Guð, sendir regnskúrir yfir land þitt, hresstir það og endurnærðir. Þar settist þjóð þín að. Þú gafst hinum hrjáðu heimili og skjól.<verse eid="PSA 68:10-11"/></para>
  <para style="p">
    <verse number="12-13" style="v" sid="PSA 68:12-13"/>Drottinn lætur orð sín rætast og þegar hann talar flýja óvinirnir. Konurnar sem heima eru flytja gleðifrétt: „Óvinaherinn er flúinn, þeir sem vildu eyða öllu og umturna!“ Og konur í Ísrael skipta herfanginu. <verse eid="PSA 68:12-13"/><verse number="14" style="v" sid="PSA 68:14"/>Þær hylja sig með gulli og silfri, rétt eins og dúfan vængjum sínum! <verse eid="PSA 68:14"/><verse number="15" style="v" sid="PSA 68:15"/>Þegar Guð stökkti óvinunum á flótta þá snjóaði á Salmonsfjalli.<verse eid="PSA 68:15"/></para>
  <para style="p">
    <verse number="16-17" style="v" pubnumber="16,17" sid="PSA 68:16-17"/> Þið voldugu Basanfjöll, þið illkleifu tindar! Hvers vegna horfið þið með öfund til Síonar – fjallsins sem Drottinn hefur kosið sér til bústaðar? <verse eid="PSA 68:16-17"/><verse number="18" style="v" sid="PSA 68:18"/>Með þúsundum vagna lagði Drottinn upp frá Sínaí og kom til síns heilaga musteris á Síon. <verse eid="PSA 68:18"/><verse number="19" style="v" sid="PSA 68:19"/>Hann kleif fjöllin, tók með sér fjölda bandingja og veitti viðtöku gjöfum frá mönnum, jafnvel uppreisnarmönnum. Og nú býr hann hér!<verse eid="PSA 68:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 68:20"/>Lofaður sé Drottinn! Hann leiðir okkur dag eftir dag og hjálpar í öllum vanda. <verse eid="PSA 68:20"/><verse number="21" style="v" sid="PSA 68:21"/>Guð er hjálpræðisguð. Hann er alvaldur og bjargar frá dauða. <verse eid="PSA 68:21"/><verse number="22" style="v" sid="PSA 68:22"/>En óvinum sínum eyðir hann, þeim sem þrjóskast og halda áfram á glæpabraut. <verse eid="PSA 68:22"/><verse number="23" style="v" sid="PSA 68:23"/>Hann segir: „Komið!“ við óvini þjóðar sinnar, þá sem fela sig til fjalla eða í hafdjúpunum. <verse eid="PSA 68:23"/><verse number="24" style="v" sid="PSA 68:24"/>Þjóð hans vill troða þá undir, ganga í blóði þeirra og gefa hundum hræ þeirra.<verse eid="PSA 68:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 68:25"/>Guð, konungur minn, gengur inn til musteris síns. <verse eid="PSA 68:25"/><verse number="26" style="v" sid="PSA 68:26"/>Fremst fara söngvarar, þá hljóðfæraleikarar og stúlkur sem slá taktinn. <verse eid="PSA 68:26"/><verse number="27" style="v" sid="PSA 68:27"/>Allur Ísrael gleðjist með Guði, uppsprettu Ísraels á þessum hátíðardegi. <verse eid="PSA 68:27"/><verse number="28" style="v" sid="PSA 68:28"/>Fremst fer Benjamínsætt, hún er minnst. Þá koma prinsar og öldungar Júda og síðan höfðingjar Sebúlons og Naftalí. <verse eid="PSA 68:28"/><verse number="29" style="v" sid="PSA 68:29"/>Sýn þú, Guð, mátt þinn og styrk, því að mikla hluti hefur þú gert.<verse eid="PSA 68:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PSA 68:30"/>Konungar jarðarinnar gefa gjafir til musteris þíns í Jerúsalem. <verse eid="PSA 68:30"/><verse number="31" style="v" sid="PSA 68:31"/>Ávíta þú óvini okkar, Drottinn. Færðu þá hingað, sneypta og berandi skattinn! Tvístraðu þeim sem efna til ófriðar. <verse eid="PSA 68:31"/><verse number="32" style="v" sid="PSA 68:32"/>Egyptar sendi gull og Bláland fórni höndum í lotningu til Guðs. <verse eid="PSA 68:32"/><verse number="33" style="v" sid="PSA 68:33"/>Syngið frammi fyrir Drottni, þið konungsríki jarðarinnar, syngið honum lofgjörðarsöng, <verse eid="PSA 68:33"/><verse number="34" style="v" sid="PSA 68:34"/>honum, Guði eilífðar, sem ekur um himininn og talar með þrumuraust svo að undir tekur.<verse eid="PSA 68:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="PSA 68:35"/>Drottinn hefur máttinn! Dýrð hans ljómar yfir Ísrael og hans voldugu verk birtast á himninum. <verse eid="PSA 68:35"/><verse number="36" style="v" sid="PSA 68:36"/>Við krjúpum fyrir honum í lotningu og ótta í musteri hans. Ísraels Guð veitir þjóð sinni mátt og megin. Lofaður sé Guð!<verse eid="PSA 68:36"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 69:1-2"/> Frelsaðu mig, ó Guð, því að vatnið hækkar sífellt <verse eid="PSA 69:1-2"/><verse number="3" style="v" sid="PSA 69:3"/>og ég sekk æ dýpra í þessa botnlausu leðju. <verse eid="PSA 69:3"/><verse number="4" style="v" sid="PSA 69:4"/>Ég er útgrátinn og örmagna, hálsinn þurr og sár og augun þrútin. Góði Guð, bjargaðu mér! <verse eid="PSA 69:4"/><verse number="5" style="v" sid="PSA 69:5"/>Þeir eru margir sem hata mig að ástæðulausu, fjöldi manna sem brugga mér banaráð. Þó er ég saklaus. Þeir heimta að ég bæti það sem ég hef ekki brotið!<verse eid="PSA 69:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 69:6"/>Ó, Guð, þú þekkir heimsku mína og syndir. <verse eid="PSA 69:6"/><verse number="7" style="v" sid="PSA 69:7"/>Drottinn Guð, þú sem ræður hersveitum himnanna, láttu mig ekki verða til hneykslunar þeim sem treysta þér. Þú Guð Ísraels, forðaðu mér frá því að valda þeim vonbrigðum, <verse eid="PSA 69:7"/><verse number="8" style="v" sid="PSA 69:8"/>þó svo að þín vegna sé ég hæddur og smáður. <verse eid="PSA 69:8"/><verse number="9" style="v" sid="PSA 69:9"/>Jafnvel bræður mínir sniðganga mig! <verse eid="PSA 69:9"/><verse number="10" style="v" sid="PSA 69:10"/>Guð, þú ert í huga mér öllum stundum og um musteri þitt hugsa ég. Og vegna þess að ég held uppi málstað þínum, hata þeir mig, rétt eins og þig. <verse eid="PSA 69:10"/><verse number="11" style="v" sid="PSA 69:11"/>Ég hef fastað og iðrast frammi fyrir þér, en þeir hæddu mig engu að síður.<verse eid="PSA 69:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 69:12"/>Ég klæddist hærusekk – tákni auðmýktar og iðrunar – og þá ortu þeir um mig níðvísu! <verse eid="PSA 69:12"/><verse number="13" style="v" sid="PSA 69:13"/>Ég er nýjasta fréttin í bænum og jafnvel rónarnir spotta mig! <verse eid="PSA 69:13"/><verse number="14" style="v" sid="PSA 69:14"/>En ég held áfram að biðja til þín, Drottinn, og gefst ekki upp, því að þú hlustar! Svaraðu mér með blessun þinni og miskunnaðu mér.<verse eid="PSA 69:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 69:15"/>Dragðu mig upp úr leðjunni, Drottinn, ég finn að ég er að sökkva! Forðaðu mér frá óvinum mínum, úr þessum hræðilega pytti! <verse eid="PSA 69:15"/><verse number="16" style="v" sid="PSA 69:16"/>Láttu ekki flóðið taka mig, hringiðuna svelgja mig! <verse eid="PSA 69:16"/><verse number="17" style="v" sid="PSA 69:17"/>Ó, Drottinn, svaraðu bænum mínum, vegna gæsku þinnar og náðar við mig. <verse eid="PSA 69:17"/><verse number="18" style="v" sid="PSA 69:18"/>Snúðu ekki við mér bakinu, því að ég er í nauðum staddur! Flýttu þér! Komdu og frelsaðu mig! <verse eid="PSA 69:18"/><verse number="19" style="v" sid="PSA 69:19"/>Drottinn, komdu og bjargaðu mér! Leystu mig undan ofríki óvina minna. <verse eid="PSA 69:19"/><verse number="20" style="v" sid="PSA 69:20"/>Þú sérð þá og þekkir háðsglósur þeirra, hvernig þeir níða mig niður.<verse eid="PSA 69:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 69:21"/>Háðsyrði þeirra hafa sært mig djúpu sári og andi minn örmagnast. Ó, ef einhver hefði sýnt mér samúð og einhver viljað hugga mig! <verse eid="PSA 69:21"/><verse number="22" style="v" sid="PSA 69:22"/>Þeir færðu mér eitraðan mat – malurt – og edik við þorstanum. <verse eid="PSA 69:22"/><verse number="23" style="v" sid="PSA 69:23"/>Verði gleði þeirra að sorg og friður þeirra að skelfingu. <verse eid="PSA 69:23"/><verse number="24" style="v" sid="PSA 69:24"/>Myrkur komi yfir þá, blinda og ringulreið. <verse eid="PSA 69:24"/><verse number="25" style="v" sid="PSA 69:25"/>Reiði þín upptendrist gegn þeim og eldur þinn tortími þeim. <verse eid="PSA 69:25"/><verse number="26" style="v" sid="PSA 69:26"/>Leggðu hús þeirra í rúst svo að þar búi enginn framar. <verse eid="PSA 69:26"/><verse number="27" style="v" sid="PSA 69:27"/>Því að þeir ofsækja þann sem þú hefur slegið og hlæja að kvöl þess sem þú hefur gegnumstungið. <verse eid="PSA 69:27"/><verse number="28" style="v" sid="PSA 69:28"/>Skráðu hjá þér allar syndir þeirra, já láttu enga gleymast. <verse eid="PSA 69:28"/><verse number="29" style="v" sid="PSA 69:29"/>Strikaðu þá út af listanum yfir þá sem fá að lifa, leyfðu þeim ekki að njóta lífsins með réttlátum.<verse eid="PSA 69:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PSA 69:30"/>Ó, Guð, frelsaðu mig úr þessari neyð! Ég veit að þú munt bjarga mér! <verse eid="PSA 69:30"/><verse number="31" style="v" sid="PSA 69:31"/>Ég lofa Guð í ljóði, mikla hann með lofsöng. <verse eid="PSA 69:31"/><verse number="32" style="v" sid="PSA 69:32"/>Það mun gleðja hann meira en margs konar fórnir. <verse eid="PSA 69:32"/><verse number="33" style="v" sid="PSA 69:33"/>Hinir auðmjúku munu sjá að Drottinn hjálpar mér og þeir munu gleðjast. Já, gleðjist, þið sem leitið Guðs! <verse eid="PSA 69:33"/><verse number="34" style="v" sid="PSA 69:34"/>Því að Drottinn heyrir hróp hinna snauðu, og snýr ekki við þeim bakinu.<verse eid="PSA 69:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="PSA 69:35"/>Himinn og jörð, lofið Drottin, og hafið og allt sem í því er! <verse eid="PSA 69:35"/><verse number="36" style="v" sid="PSA 69:36"/>Því að Guð mun frelsa Jerúsalem og endurreisa borgirnar í Júda og þjóð hans mun búa við öryggi. <verse eid="PSA 69:36"/><verse number="37" style="v" sid="PSA 69:37"/>Börnin munu erfa landið og þeir sem elska Drottin njóta þar friðar og velgengni.<verse eid="PSA 69:37"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 70:1-2"/> Bjargaðu mér, ó Guð! Flýttu þér Drottinn, að hjálpa mér! <verse eid="PSA 70:1-2"/><verse number="3-4" style="v" pubnumber="3,4" sid="PSA 70:3-4"/> Óvinir mínir sækjast eftir lífi mínu og njóta þess að kvelja mig. Rektu þá burt með skömm! Stöðvaðu þá! Láttu þá ekki hæða mig og spotta. <verse eid="PSA 70:3-4"/><verse number="5" style="v" sid="PSA 70:5"/>Allir þeir sem leita Guðs skulu fagna og gleðjast. Þeir sem elska hjálpræði þitt hrópi: „Lofaður sé Guð!“ <verse eid="PSA 70:5"/><verse number="6" style="v" sid="PSA 70:6"/>En ég er í miklum vanda ó, Guð! Flýttu þér að hjálpa mér! Þú ert sá eini sem getur bjargað. Drottinn minn, láttu það ekki dragast!<verse eid="PSA 70:6"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 71:1"/>Drottinn, þú ert skjól mitt! Ekki yfirgefa mig! <verse eid="PSA 71:1"/><verse number="2" style="v" sid="PSA 71:2"/>Frelsaðu mig frá óvinum mínum, því að þú er réttlátur. Bjargaðu mér! Snúðu eyra þínu að mér og hlustaðu á mína einlægu bæn. <verse eid="PSA 71:2"/><verse number="3" style="v" sid="PSA 71:3"/>Vertu mér vígi og skjól gegn öllum árásum. <verse eid="PSA 71:3"/><verse number="4" style="v" sid="PSA 71:4"/>Já, bjargaðu mér ó Guð, frá svikum þessara illmenna. <verse eid="PSA 71:4"/><verse number="5" style="v" sid="PSA 71:5"/>Drottinn, þú ert mín síðasta von. Allt frá barnsaldri treysti ég á þig. <verse eid="PSA 71:5"/><verse number="6" style="v" sid="PSA 71:6"/>Frá fæðingu hefur þú vakað yfir mér og verndað mig – skyldi ég ekki vegsama þig?! <verse eid="PSA 71:6"/><verse number="7" style="v" sid="PSA 71:7"/>Velgengni mína, sem margir undrast, á ég vernd þinni að þakka. <verse eid="PSA 71:7"/><verse number="8" style="v" sid="PSA 71:8"/>Ég vil lofa þig liðlangan daginn, ó Guð, því að alls góðs hef ég notið úr hendi þinni. <verse eid="PSA 71:8"/><verse number="9" style="v" sid="PSA 71:9"/>Nú þegar aldurinn færist yfir, þá vísa mér ekki frá. Hafnaðu mér ekki þegar þrekið minnkar. <verse eid="PSA 71:9"/><verse number="10-11" style="v" pubnumber="10,11" sid="PSA 71:10-11"/> Óvinir mínir hvísla: „Guð hefur yfirgefið hann! Nú er hann auðveld bráð. Hann hefur engan sér til hjálpar!“ <verse eid="PSA 71:10-11"/><verse number="12" style="v" sid="PSA 71:12"/>Guð minn, farðu ekki frá mér! Komdu fljótt og hjálpaðu mér! <verse eid="PSA 71:12"/><verse number="13" style="v" sid="PSA 71:13"/>Útrýmdu þeim. Láttu þá verða til skammar sem óska mér óhamingju. <verse eid="PSA 71:13"/><verse number="14" style="v" sid="PSA 71:14"/>En ég mun áfram treysta þér og ekki draga úr lofgjörð minni! <verse eid="PSA 71:14"/><verse number="15" style="v" sid="PSA 71:15"/>Oftsinnis frelsaðir þú mig úr bráðri hættu. Ég vitna og rifja upp gæsku þína og daglega umhyggju. <verse eid="PSA 71:15"/><verse number="16" style="v" sid="PSA 71:16"/>Drottinn, styrkur þinn heldur mér uppi. Það skulu allir vita að þú einn ert góður og réttlátur. <verse eid="PSA 71:16"/><verse number="17" style="v" sid="PSA 71:17"/>Guð minn, allt frá æsku hjálpaðir þú mér – um dásemdarverk þín hef ég ekki þagað. <verse eid="PSA 71:17"/><verse number="18" style="v" sid="PSA 71:18"/>Nú er ég orðinn gamall og hárin grá, en Drottinn yfirgefðu mig ekki! Láttu mig lifa enn um stund, svo að unga kynslóðin fái að heyra um máttarverk þín. <verse eid="PSA 71:18"/><verse number="19" style="v" sid="PSA 71:19"/>Kraftur þinn og kærleikur, Drottinn, nær til himna. Ó, hve það er dásamlegt! Hvar er slíkan Guð að finna sem þig?! <verse eid="PSA 71:19"/><verse number="20" style="v" sid="PSA 71:20"/>Þú hefur sent okkur margvíslegt mótlæti – en ég veit að þú munt frelsa á ný og leyfa okkur að lifa! <verse eid="PSA 71:20"/><verse number="21" style="v" sid="PSA 71:21"/>Þú munt auka við heiður minn og hugga mig að nýju.<verse eid="PSA 71:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PSA 71:22"/>Ég leik á hörpu mína og lofa þig, því að öll þín orð og fyrirheit hafa staðist, þú hinn heilagi í Ísrael. <verse eid="PSA 71:22"/><verse number="23" style="v" sid="PSA 71:23"/>Ég vil lofa þig hárri röddu, því að þú hefur frelsað mig! <verse eid="PSA 71:23"/><verse number="24" style="v" sid="PSA 71:24"/>Liðlangan daginn vitna ég um ást þína og réttlæti, því að óvinir mínir sem óskuðu mér ógæfu, voru auðmýktir og roðnuðu af skömm.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 72:1"/>Guð, hjálpa þú konunginum, að hann fái skorið úr málum manna eftir vilja þínum og hjálpaðu syni hans til að gera rétt. <verse eid="PSA 72:1"/><verse number="2-3" style="v" pubnumber="2,3" sid="PSA 72:2-3"/> Gefðu að hann dæmi þjóð þína með sanngirni og láti hina snauðu ná rétti sínum. Stjórnspeki hans leiði af sér velferð og grósku. <verse eid="PSA 72:2-3"/><verse number="4" style="v" sid="PSA 72:4"/>Styrktu hann að vernda fátæklinga og þurfandi og eyða kúgurum þeirra. <verse eid="PSA 72:4"/><verse number="5" style="v" sid="PSA 72:5"/>Þá mun hann lifa meðan sólin skín og tunglið gefur birtu. Já, að eilífu!<verse eid="PSA 72:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 72:6"/>Stjórn hans verður mild og góð eins og gróðrarskúr á sprettutíma. <verse eid="PSA 72:6"/><verse number="7" style="v" sid="PSA 72:7"/>Á ríkisárum hans mun réttlætið blómgast og friður eflast, já, meðan veröldin er til. <verse eid="PSA 72:7"/><verse number="8" style="v" sid="PSA 72:8"/>Ríki hans mun ná frá hafi til hafs, frá Evfrat-fljóti til endimarka jarðar. <verse eid="PSA 72:8"/><verse number="9" style="v" sid="PSA 72:9"/>Óvinir hans munu lúta honum og leggjast flatir á jörðina við fætur hans. <verse eid="PSA 72:9"/><verse number="10" style="v" sid="PSA 72:10"/>Konungarnir frá Tarsus og eylöndunum munu færa honum gjafir, og skatt þeir frá Saba og Seba. <verse eid="PSA 72:10"/><verse number="11" style="v" sid="PSA 72:11"/>Allir konungar munu lúta honum og þjóðir þeirra þjóna honum. <verse eid="PSA 72:11"/><verse number="12" style="v" sid="PSA 72:12"/>Hann mun bjarga hinum snauða er hrópar á hjálp, og hinum þjáða sem enginn réttir hjáparhönd. <verse eid="PSA 72:12"/><verse number="13" style="v" sid="PSA 72:13"/>Hann aumkast yfir bágstadda og þá sem ekkert eiga og liðsinnir fátæklingum. <verse eid="PSA 72:13"/><verse number="14" style="v" sid="PSA 72:14"/>Hann verndar þá og leysir frá ofríki og kúgun því að líf þeirra er dýrmætt í augum hans. <verse eid="PSA 72:14"/><verse number="15" style="v" sid="PSA 72:15"/>Lífið blasir við honum og menn munu gefa honum gull frá Saba. Hann mun njóta fyrirbæna margra og fólk mun blessa hann liðlangan daginn. <verse eid="PSA 72:15"/><verse number="16" style="v" sid="PSA 72:16"/>Landið mun gefa góða uppskeru, einnig til fjalla eins og í Líbanon. Fólki mun fjölga í borgunum eins og gras vex á engi! <verse eid="PSA 72:16"/><verse number="17" style="v" sid="PSA 72:17"/>Nafn hans mun lofað að eilífu og meðan sólin skín mun orðstír hans aukast. Allir munu óska sér blessunar hans og þjóðirnar segja hann sælan.<verse eid="PSA 72:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 72:18"/>Lofaður sé Drottinn, Guð Ísraels, hann einn gerir furðuverk. <verse eid="PSA 72:18"/><verse number="19" style="v" sid="PSA 72:19"/>Lofað sé hans dýrlega nafn að eilífu! Öll jörðin fyllist dýrð hans! Amen, já amen!<verse eid="PSA 72:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 72:20"/>(Hér enda sálmar Davíðs Ísaísonar.)<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 73:1"/>Guð er góður við Ísrael! Hann er góður þeim sem hreinlyndir eru. <verse eid="PSA 73:1"/><verse number="2" style="v" sid="PSA 73:2"/>En hvað um mig? Ég var kominn á ystu nöf. Það munaði engu að mér skrikaði fótur og ég félli! <verse eid="PSA 73:2"/><verse number="3" style="v" sid="PSA 73:3"/>Ég hafði fyllst gremju út af velgengni hinna hrokafullu. <verse eid="PSA 73:3"/><verse number="4" style="v" sid="PSA 73:4"/>Þeim virtist ganga allt í haginn. Þeir eru hraustir og sterkir. <verse eid="PSA 73:4"/><verse number="5" style="v" sid="PSA 73:5"/>Þeir virðast lausir við alla erfiðleika og áföll sem henda aðra. <verse eid="PSA 73:5"/><verse number="6" style="v" sid="PSA 73:6"/>Hrokinn er eins og glitrandi festi um háls þeirra og þeir eru sveipaðir ofríki eins og skikkju. <verse eid="PSA 73:6"/><verse number="7" style="v" sid="PSA 73:7"/>Þeir belgjast út af offitu og augu þeirra tútna af ágirnd. <verse eid="PSA 73:7"/><verse number="8" style="v" sid="PSA 73:8"/>Þeir hæðast að Guði og hafa í hótunum við fólk hans. Hroki er í hverju orði. <verse eid="PSA 73:8"/><verse number="9" style="v" sid="PSA 73:9"/>Þeir stæra sig gegn himninum og blaðrið í þeim heyrist um allar jarðir.<verse eid="PSA 73:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 73:10"/>Þjóð Guðs er orðlaus og gleypir í sig boðskap þeirra. <verse eid="PSA 73:10"/><verse number="11-12" style="v" pubnumber="11,12" sid="PSA 73:11-12"/> „Guð virðist láta þá í friði,“ segir fólk, „já, þessir guðleysingjar lifa áhyggjulausu lífi og verða ríkari með hverjum degi.“<verse eid="PSA 73:11-12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 73:13"/>Hef ég eytt tíma mínum til einskis? Er til nokkurs að kappkosta að lifa heiðvirðu lífi? <verse eid="PSA 73:13"/><verse number="14" style="v" sid="PSA 73:14"/>Allt sem ég hef upp úr því er erfiði og strit – alla daga, sí og æ! <verse eid="PSA 73:14"/><verse number="15" style="v" sid="PSA 73:15"/>Ef ég talaði með þessum hætti, væri ég að bregðast lýð þínum. <verse eid="PSA 73:15"/><verse number="16" style="v" sid="PSA 73:16"/>En þetta er samt svo torskilið – velgengni þeirra sem hata Drottin. <verse eid="PSA 73:16"/><verse number="17" style="v" sid="PSA 73:17"/>En dag einn fór ég í helgidóm Drottins til að íhuga, og þá hugleiddi ég framtíð þessara vondu manna. <verse eid="PSA 73:17"/><verse number="18" style="v" sid="PSA 73:18"/>Sá vegur sem þeir ganga mun enda í skelfingu. Skyndilega mun þeim skrika fótur og þeir hrasa og steypast fram af brúninni, niður í hyldýpið. <verse eid="PSA 73:18"/><verse number="19" style="v" sid="PSA 73:19"/>Það verður snöggur endir á allri „gæfunni“, skyndileg tortíming. <verse eid="PSA 73:19"/><verse number="20" style="v" sid="PSA 73:20"/>Líf þeirra líkist draumi. Þeir munu vakna til veruleikans, eins og þegar menn vakna af draumsvefni og sjá að allt var ímyndun ein!<verse eid="PSA 73:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 73:21"/>Þegar ég skyldi þetta, fylltist ég hryggð og leið illa. <verse eid="PSA 73:21"/><verse number="22" style="v" sid="PSA 73:22"/>Ég sá hve heimskur og fávís ég var. Ég hlýt að vera eins og skynlaus skepna í þínum augum, Guð! <verse eid="PSA 73:22"/><verse number="23" style="v" sid="PSA 73:23"/>En samt elskar þú mig! Þú heldur í hægri hönd mína og varðveitir mig.<verse eid="PSA 73:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PSA 73:24"/>Og áfram munt þú leiða mig með vísdómi þínum og speki. <verse eid="PSA 73:24"/><verse number="25" style="v" sid="PSA 73:25"/>Hvern á ég að á himnum nema þig? Og þú ert sá sem ég þrái mest á jörðu! <verse eid="PSA 73:25"/><verse number="26" style="v" sid="PSA 73:26"/>Heilsu minni hrakar og hjarta mitt þreytist, en Guð lifir! Hann er styrkur minn, ég fæ að tilheyra honum að eilífu.<verse eid="PSA 73:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PSA 73:27"/>Drottinn, þeir sem hafna þér munu farast, því að þú eyðir þeim sem þjóna öðrum guðum.<verse eid="PSA 73:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PSA 73:28"/>En hvað um mig? Ég vil komast eins nálægt Guði og ég get! Ég hef kosið að trúa á Drottin. Hann er skjól mitt. Ég vil vitna um það í allra áheyrn að margsinnis hefur hann bjargað mér á undursamlega hátt.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 74:1"/>Guð, hvers vegna hefur þú hafnað okkur fyrir fullt og allt? Af hverju ertu reiður? Við erum þó þín eigin hjörð? <verse eid="PSA 74:1"/><verse number="2" style="v" sid="PSA 74:2"/>Mundu, að við erum þjóðin þín – fólkið sem þú forðum leystir úr útlegð og valdir þér til eignar og gleði. Þú útvaldir Jerúsalem sem bústað þinn á jörðu.<verse eid="PSA 74:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 74:3"/>Fáðu þér göngu og skoðaðu rústirnar! Sjáðu, óvinirnir hafa eyðilagt borgina og musteri þitt. <verse eid="PSA 74:3"/><verse number="4" style="v" sid="PSA 74:4"/>Þar, já, inni í helgidómnum, æptu þeir heróp, reistu stríðsfána sína og guðamyndir og fögnuðu sigri! <verse eid="PSA 74:4"/><verse number="5-6" style="v" pubnumber="5,6" sid="PSA 74:5-6"/> Allt er eins og rjúkandi rúst, eins og brunninn skógur. Með öxum sínum og sleggjum hjuggu þeir og brutu allan útskurðinn. <verse eid="PSA 74:5-6"/><verse number="7" style="v" sid="PSA 74:7"/>Þeir kveiktu í musterinu og gjöreyddu helgidóm þinn, Drottinn. <verse eid="PSA 74:7"/><verse number="8" style="v" sid="PSA 74:8"/>„Þurrkum út allt sem minnir á Drottin!“ öskruðu þeir og brenndu síðan öll samkomuhús Guðs í landinu.<verse eid="PSA 74:8"/></para>
  <para style="p">
    <verse number="9-10" style="v" pubnumber="9,10" sid="PSA 74:9-10"/> Ekkert er nú eftir sem sýnir að við séum þín útvalda þjóð. Spámennirnir eru horfnir og hver getur þá sagt okkur hvenær þessi ósköp munu enda? Hve lengi ætlar þú Guð að leyfa óvinum þínum að óvirða nafn þitt? Ætlar þú að láta þá komast upp með þetta að eilífu? <verse eid="PSA 74:9-10"/><verse number="11" style="v" sid="PSA 74:11"/>Eftir hverju ertu að bíða? Af hverju gerir þú ekkert? Ó, rektu þá burt með þinni sterku hendi!<verse eid="PSA 74:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 74:12"/>Guð, þú ert konungur minn frá alda öðli. Hjálpar þinnar hef ég notið á öllum mínum ferðum. <verse eid="PSA 74:12"/><verse number="13-14" style="v" pubnumber="13,14" sid="PSA 74:13-14"/> Þú klaufst hafið með mætti þínum, molaðir haus sjávarguðsins! <verse eid="PSA 74:13-14"/><verse number="15" style="v" sid="PSA 74:15"/>Eftir skipun þinni opnuðust lindir og þar gat þjóð þín svalað þorstanum. Og þú þurrkaðir fyrir þau farveg Jórdanar, sem annars streymir endalaust. <verse eid="PSA 74:15"/><verse number="16" style="v" sid="PSA 74:16"/>Þú stjórnar bæði nóttu og degi og sólina og stjörnurnar hefur þú skapað. <verse eid="PSA 74:16"/><verse number="17" style="v" sid="PSA 74:17"/>Öll náttúran er á valdi þínu og vetur og sumar eru þín verk. <verse eid="PSA 74:17"/><verse number="18" style="v" sid="PSA 74:18"/>Drottinn líttu á, óvinir þínir spotta þig, ofstopalýður óvirðir nafn þitt!<verse eid="PSA 74:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 74:19"/>Ó, Drottinn, frelsaðu mig! Verndaðu turtildúfuna þína fyrir ránfuglunum. Bjargaðu eignarlýð þínum úr klóm varganna. <verse eid="PSA 74:19"/><verse number="20" style="v" sid="PSA 74:20"/>Minnstu loforða þinna! Landið er hulið myrkri og ofbeldismenn út um allt. <verse eid="PSA 74:20"/><verse number="21" style="v" sid="PSA 74:21"/>Drottinn, þjóð þín er kúguð, en láttu hana ekki þurfa að þola þessa svívirðing endalaust. Leyfðu hinum fátæku og hrjáðu að lofa nafn þitt! <verse eid="PSA 74:21"/><verse number="22" style="v" sid="PSA 74:22"/>Komdu, ó Guð, og ákærðu óvini okkar. Hlustaðu á óþverrann sem þessi illmenni ausa yfir þig alla daga! <verse eid="PSA 74:22"/><verse number="23" style="v" sid="PSA 74:23"/>Gleymdu ekki formælingum óvina þinna, þær glymja hærra og hærra.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 75:1-2"/> Þökk sé þér Drottinn! Máttarverk þín staðfesta umhyggju þína.<verse eid="PSA 75:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 75:3"/>„Já,“ svarar Drottinn, „og þegar stundin er komin mun ég refsa öllum illgjörðamönnum! <verse eid="PSA 75:3"/><verse number="4" style="v" sid="PSA 75:4"/>Þótt jörðin nötri og íbúar hennar skjálfi af ótta, eru undirstöður hennar traustar, enda verk handa minna!“<verse eid="PSA 75:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 75:5"/>Ég sagði hinum hrokafullu að láta af drambi sínu og illmennunum að hætta sínum ögrandi augnagotum, <verse eid="PSA 75:5"/><verse number="6" style="v" sid="PSA 75:6"/>að láta af þrjósku og hroka. <verse eid="PSA 75:6"/><verse number="7" style="v" sid="PSA 75:7"/>Velgengni og völd getur enginn þakkað sér sjálfum, <verse eid="PSA 75:7"/><verse number="8" style="v" sid="PSA 75:8"/>allt eru það gjafir frá Guði. Hann upphefur einn, en niðurlægir annan. <verse eid="PSA 75:8"/><verse number="9" style="v" sid="PSA 75:9"/>Drottinn heldur á bikar fullum af freyðandi víni – það er dómurinn gegn illmennum heimsins. Þau skulu drekka hann í botn! <verse eid="PSA 75:9"/><verse number="10" style="v" sid="PSA 75:10"/>En ég mun vegsama Guð um aldur og ævi. <verse eid="PSA 75:10"/><verse number="11" style="v" sid="PSA 75:11"/>Styrkur hinna óguðlegu verður að engu, en réttlátir skulu ríkja með reisn.<verse eid="PSA 75:11"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 76:1-2"/> Orðstír Drottins er mikill í Júda og Ísrael. <verse eid="PSA 76:1-2"/><verse number="3" style="v" sid="PSA 76:3"/>Bústaður hans er í Jerúsalem. Hann situr á Síonfjalli. <verse eid="PSA 76:3"/><verse number="4" style="v" sid="PSA 76:4"/>Þar sundurbraut hann vopn óvina okkar.<verse eid="PSA 76:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 76:5"/>Öll háreist fjöll blikna í ljóma dýrðar hans! <verse eid="PSA 76:5"/><verse number="6" style="v" sid="PSA 76:6"/>Úrvalslið óvinanna er gjörsigrað! Þeir liggja flatir, sofnaðir svefninum langa. Enginn þeirra getur framar lyft hendi. <verse eid="PSA 76:6"/><verse number="7" style="v" sid="PSA 76:7"/>Þegar þú, Guð Jakobs, hastaðir á þá, féllu bæði hestar og riddarar. <verse eid="PSA 76:7"/><verse number="8" style="v" sid="PSA 76:8"/>Ekki er að undra þótt menn óttist þig! Hver fær staðist reiði Guðs?! <verse eid="PSA 76:8"/><verse number="9" style="v" sid="PSA 76:9"/>Þegar þú birtir þeim dóminn frá himnum, þá nötraði jörðin og þagnaði fyrir þér. <verse eid="PSA 76:9"/><verse number="10" style="v" sid="PSA 76:10"/>Þú stígur fram til að refsa illgjörðamönnunum, en verndar hina auðmjúku. <verse eid="PSA 76:10"/><verse number="11" style="v" sid="PSA 76:11"/>Þegar við sjáum heimsku og reiði mannanna, þá skiljum við enn betur hve dýrð þín er mikil.<verse eid="PSA 76:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 76:12"/>Efnið heitin sem þið gáfuð Drottni, Guði ykkar. Allir sem umhverfis hann eru færa honum gjafir. Þeir nálgast hann með óttablandinni virðingu. <verse eid="PSA 76:12"/><verse number="13" style="v" sid="PSA 76:13"/>Hann er sá sem lægir ofstopa höfðingjanna og kemur konungum jarðarinnar á kné!<verse eid="PSA 76:13"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 77:1"/>Ég ákalla Drottin. Ég hrópa og kalla til hans. Ó, að hann vildi hlusta! <verse eid="PSA 77:1"/><verse number="2" style="v" sid="PSA 77:2"/>Ég er í miklum vanda og þarfnast mjög hjálpar hans. Alla nóttina er ég á bæn, ég lyfti höndum til himins, – ég bið og bið. Ég mun ekki eiga glaðan dag fyrr en Drottinn hefur hjálpað mér. <verse eid="PSA 77:2"/><verse number="3" style="v" sid="PSA 77:3"/>Ég hugsa um Guð, mikið þrái ég hjálp hans! <verse eid="PSA 77:3"/><verse number="4" style="v" sid="PSA 77:4"/>Drottinn, mér mun ekki koma dúr á auga fyrr en þú hefur hjálpað mér. Ég er við það að gefast upp, jafnvel bænin er mér erfið.<verse eid="PSA 77:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 77:5"/>Góðar minningar liðinna ára leita sífellt á huga minn. <verse eid="PSA 77:5"/><verse number="6" style="v" sid="PSA 77:6"/>Þá sungum við gleðiljóð langt fram á kvöld! Ég velti þessu fyrir mér, íhuga hve allt hefur breyst. <verse eid="PSA 77:6"/><verse number="7" style="v" sid="PSA 77:7"/>Hefur Drottinn hafnað mér fyrir fullt og allt? Mun hann ekki miskunna mér framar? <verse eid="PSA 77:7"/><verse number="8" style="v" sid="PSA 77:8"/>Elskar hann mig ekki lengur og er umhyggja hans búin fyrir fullt og allt? Gekk hann á bak orða sinna? <verse eid="PSA 77:8"/><verse number="9" style="v" sid="PSA 77:9"/>Gleymdi hann miskunn sinni við mig, vesalinginn? Hefur hann í reiðikasti lokað dyrum kærleika síns? <verse eid="PSA 77:9"/><verse number="10" style="v" sid="PSA 77:10"/>„Þetta eru örlög mín,“ sagði ég, „blessun Guðs hefur snúist í bölvun.“ <verse eid="PSA 77:10"/><verse number="11" style="v" sid="PSA 77:11"/>Ég renni huganum yfir alla þá blessun sem ég hef notið frá Guði. <verse eid="PSA 77:11"/><verse number="12" style="v" sid="PSA 77:12"/>Sú gæfa gleymist seint! – Já, hún líður mér aldrei úr minni!<verse eid="PSA 77:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 77:13"/>Guð minn, þínir vegir eru heilagir. Hvar skyldi aðra eins að finna? <verse eid="PSA 77:13"/><verse number="14" style="v" sid="PSA 77:14"/>Þú ert Guð undra og tákna. Stórvirki þín blasa við augum.<verse eid="PSA 77:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 77:15"/>Með þinni voldugu hendi bjargaðir þú sonum Jakobs og Jósefs. <verse eid="PSA 77:15"/><verse number="16" style="v" sid="PSA 77:16"/>Þegar Rauðahafið sá þig, ókyrrðist það! Jafnvel djúpið skalf af ótta! <verse eid="PSA 77:16"/><verse number="17" style="v" sid="PSA 77:17"/>Það varð skýfall og þrumur bergmáluðu um himininn. Elding leiftraði. <verse eid="PSA 77:17"/><verse number="18" style="v" sid="PSA 77:18"/>Þrumurnar tjáðu reiði þína og eldingarnar lýstu upp jörðina!<verse eid="PSA 77:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 77:19"/>Þú lagðir veg gegnum hafið – veg sem enginn þekkti áður! <verse eid="PSA 77:19"/><verse number="20" style="v" sid="PSA 77:20"/>Þú leiddir fólk þitt þessa leið eins og fjárhóp, undir leiðsögn Móse og Arons.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 78:1"/>Þjóð mín, hlustaðu á kenningu mína. Gefðu gaum að því sem ég hef að segja. <verse eid="PSA 78:1"/><verse number="2-3" style="v" pubnumber="2,3" sid="PSA 78:2-3"/> Nú ætla ég að rifja upp fyrir þér liðna atburði, frásagnir sem varðveist hafa frá kynslóð til kynslóðar. <verse eid="PSA 78:2-3"/><verse number="4" style="v" sid="PSA 78:4"/>Ég birti ykkur sannleikann, svo að þið getið sagt börnum ykkar frá dásemdarverkum Drottins, öllum þeim undrum sem hann vann. <verse eid="PSA 78:4"/><verse number="5" style="v" sid="PSA 78:5"/>Lögmál sitt gaf hann Ísrael og bauð forfeðrunum að kenna það börnum sínum <verse eid="PSA 78:5"/><verse number="6" style="v" sid="PSA 78:6"/>sem síðan skyldu kenna það sínum afkomendum. Þannig skyldi lögmál hans berast frá einni kynslóðinni til annarrar. <verse eid="PSA 78:6"/><verse number="7" style="v" sid="PSA 78:7"/>Því hefur sérhver kynslóð getað haldið lög Guðs, treyst honum og heyrt um hans dásemdarverk. <verse eid="PSA 78:7"/><verse number="8" style="v" sid="PSA 78:8"/>Ný kynslóð skyldi ekki þurfa að fara að fordæmi feðra sinna sem voru þrjóskir, óhlýðnir og ótrúir og forhertu sig gegn Guði.<verse eid="PSA 78:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 78:9"/>Þótt íbúar Efraím væru alvopnaðir, þá flúðu þeir þegar að orustunni kom. <verse eid="PSA 78:9"/><verse number="10" style="v" sid="PSA 78:10"/>Þannig rufu þeir sáttmálann við Guð og fóru sína eigin leið. <verse eid="PSA 78:10"/><verse number="11-12" style="v" pubnumber="11,12" sid="PSA 78:11-12"/> Þeir gleymdu máttarverkum Drottins, sem hann hafði fyrir þá gert og forfeður þeirra í Egyptalandi, <verse eid="PSA 78:11-12"/><verse number="13" style="v" sid="PSA 78:13"/>þegar hann klauf hafið og leiddi þá yfir þurrum fótum. Vatnið stóð eins og veggur til beggja handa! <verse eid="PSA 78:13"/><verse number="14" style="v" sid="PSA 78:14"/>Að degi til leiddi hann þá með skýi, en eldstólpa um nætur. <verse eid="PSA 78:14"/><verse number="15" style="v" sid="PSA 78:15"/>Hann rauf gat á klettinn í eyðimörkinni. Vatnið streymdi fram og þeir svöluðu þorsta sínum.<verse eid="PSA 78:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 78:16"/>Já, það flæddi frá klettinum, líkast rennandi á! <verse eid="PSA 78:16"/><verse number="17" style="v" sid="PSA 78:17"/>Samt héldu þeir fast við þrjósku sína og syndguðu gegn hinum hæsta Guði.<verse eid="PSA 78:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PSA 78:18"/>Þeir kvörtuðu og kveinuðu og heimtuðu annað að borða en það sem Guð gaf þeim. <verse eid="PSA 78:18"/><verse number="19-20" style="v" pubnumber="19,20" sid="PSA 78:19-20"/> Þeir ásökuðu jafnvel sjálfan Guð og sögðu: „Hann gaf okkur vatn, en hvers vegna fáum við ekki brauð eða kjöt?!“ <verse eid="PSA 78:19-20"/><verse number="21" style="v" sid="PSA 78:21"/>Drottinn hlustaði og honum rann í skap, reiði hans upptendraðist gegn Ísrael. <verse eid="PSA 78:21"/><verse number="22" style="v" sid="PSA 78:22"/>Enda treystu þeir honum ekki, né trúðu forsjá hans. <verse eid="PSA 78:22"/><verse number="23" style="v" sid="PSA 78:23"/>Jafnvel þótt hann lyki upp himninum – eins og glugga! – <verse eid="PSA 78:23"/><verse number="24" style="v" sid="PSA 78:24"/>og léti manna rigna niður. <verse eid="PSA 78:24"/><verse number="25" style="v" sid="PSA 78:25"/>Já, þeir átu englabrauð! – og urðu mettir.<verse eid="PSA 78:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PSA 78:26"/>Þá lét hann austanvind blása og stýrði vestanvindinum með krafti sínum. <verse eid="PSA 78:26"/><verse number="27" style="v" sid="PSA 78:27"/>Og viti menn, fuglum rigndi af himni, – þeir voru eins og sandur á sjávarströnd! <verse eid="PSA 78:27"/><verse number="28" style="v" sid="PSA 78:28"/>Af hans völdum féllu þeir til jarðar um allar tjaldbúðirnar. <verse eid="PSA 78:28"/><verse number="29" style="v" sid="PSA 78:29"/>Og fólkið át nægju sína. Hann mettaði hungur þeirra. <verse eid="PSA 78:29"/><verse number="30" style="v" sid="PSA 78:30"/>En varla höfðu þeir lokið matnum – fæðan var enn í munni þeirra, <verse eid="PSA 78:30"/><verse number="31" style="v" sid="PSA 78:31"/>þá reiddist Drottinn þeim og lagði að velli æskumenn Ísraels. <verse eid="PSA 78:31"/><verse number="32" style="v" sid="PSA 78:32"/>En þeir sáu sig ekki um hönd, en héldu áfram að syndga og vildu ekki trúa kraftaverkum Drottins. <verse eid="PSA 78:32"/><verse number="33" style="v" sid="PSA 78:33"/>Þess vegna stytti hann ævi þeirra og sendi þeim miklar hörmungar. <verse eid="PSA 78:33"/><verse number="34" style="v" sid="PSA 78:34"/>En þegar neyðin var stærst, tóku þeir að leita Guðs. Þeir iðruðust og snéru sér til hans. <verse eid="PSA 78:34"/><verse number="35" style="v" sid="PSA 78:35"/>Þeir viðurkenndu að Guð er eini grundvöllur lífsins – að hinn hæsti Guð væri frelsari þeirra. <verse eid="PSA 78:35"/><verse number="36" style="v" sid="PSA 78:36"/>En því miður fylgdu þeir honum aðeins í orði kveðnu, en ekki af heilum hug, <verse eid="PSA 78:36"/><verse number="37" style="v" sid="PSA 78:37"/>hjarta þeirra var langt frá honum. Þeir stóðu ekki við orð sín.<verse eid="PSA 78:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="PSA 78:38"/>Samt var hann þeim miskunnsamur, fyrirgaf syndir þeirra og tortímdi þeim ekki. Margoft hélt hann aftur af reiði sinni. <verse eid="PSA 78:38"/><verse number="39" style="v" sid="PSA 78:39"/>Hann minntist þess að þeir voru dauðlegir menn, eins og andblær sem kemur og fer. <verse eid="PSA 78:39"/><verse number="40" style="v" sid="PSA 78:40"/>Já, oft risu þeir gegn Guði í eyðimörkinni og ollu honum vonbrigðum. <verse eid="PSA 78:40"/><verse number="41" style="v" sid="PSA 78:41"/>Aftur og aftur sneru þeir við honum baki og freistuðu hans. <verse eid="PSA 78:41"/><verse number="42" style="v" sid="PSA 78:42"/>Þeir gleymdu krafti hans og kærleika og hvernig hann hafði frelsað þá frá óvinum þeirra. <verse eid="PSA 78:42"/><verse number="43" style="v" sid="PSA 78:43"/>Þeir gleymdu plágunum sem hann sendi Egyptum í Sóan <verse eid="PSA 78:43"/><verse number="44" style="v" sid="PSA 78:44"/>þegar hann breytti fljótum þeirra í blóð, svo að enginn gat drukkið. <verse eid="PSA 78:44"/><verse number="45" style="v" sid="PSA 78:45"/>Eða þegar hann fyllti landið af flugum og froskum! <verse eid="PSA 78:45"/><verse number="46" style="v" sid="PSA 78:46"/>Lirfurnar spilltu uppskerunni og engispretturnar átu allt, hvort tveggja var frá honum komið. <verse eid="PSA 78:46"/><verse number="47" style="v" sid="PSA 78:47"/>Hann eyddi vínviði þeirra með hagléli og mórberjatrjánum með frosti. <verse eid="PSA 78:47"/><verse number="48" style="v" sid="PSA 78:48"/>Búpeningurinn hrundi niður í haganum, haglið rotaði hann og sauðirnir drápust í eldingum. <verse eid="PSA 78:48"/><verse number="49" style="v" sid="PSA 78:49"/>Hann úthellti reiði sinni yfir þá, sendi þeim ógn og skelfingu. Hann leysti út sendiboða ógæfunnar – engla sem létu þá kenna á því! <verse eid="PSA 78:49"/><verse number="50" style="v" sid="PSA 78:50"/>Hann gaf reiðinni lausan tauminn. Og ekki hlífði hann Egyptunum. Þeir fengu vænan skerf af plágum og sjúkdómum. <verse eid="PSA 78:50"/><verse number="51" style="v" sid="PSA 78:51"/>Þá deyddi hann frumburði Egypta, efnilegan ungviðinn, sem vonirnar voru bundnar við. <verse eid="PSA 78:51"/><verse number="52" style="v" sid="PSA 78:52"/>Sinn eigin lýð leiddi hann styrkri hendi gegnum eyðimörkina. <verse eid="PSA 78:52"/><verse number="53" style="v" sid="PSA 78:53"/>Hann var skjól þeirra og vörn. Þeir þurftu ekkert að óttast, en hafið gleypti óvini þeirra. <verse eid="PSA 78:53"/><verse number="54" style="v" sid="PSA 78:54"/>Hann greiddi för þeirra til fyrirheitna landsins, til hæðanna sem hann hafði skapað. <verse eid="PSA 78:54"/><verse number="55" style="v" sid="PSA 78:55"/>Íbúum landsins stökkti hann á flótta en gaf þar ættkvíslum Ísraels erfðahlut og skjól. <verse eid="PSA 78:55"/><verse number="56" style="v" sid="PSA 78:56"/>En þótt þeir nytu gæsku Guðs, risu þeir gegn hinum hæsta og fyrirlitu boðorð hans. <verse eid="PSA 78:56"/><verse number="57" style="v" sid="PSA 78:57"/>Þeir sneru af leið og rufu trúnað rétt eins og feður þeirra. Eins og bogin ör misstu þeir marksins sem Guð hafði sett þeim. <verse eid="PSA 78:57"/><verse number="58" style="v" sid="PSA 78:58"/>Þeir tóku aðra guði, reistu þeim ölturu og egndu Drottin á móti sér. <verse eid="PSA 78:58"/><verse number="59" style="v" sid="PSA 78:59"/>Guð sá verk þeirra og reiddist – fékk viðbjóð á Ísrael. <verse eid="PSA 78:59"/><verse number="60" style="v" sid="PSA 78:60"/>Hann yfirgaf helgidóm sinn í Síló, bústað sinn meðal manna. <verse eid="PSA 78:60"/><verse number="61" style="v" sid="PSA 78:61"/>Örk sína lét hann falla í hendur óvinanna og vegsemd hans var óvirt af heiðingjum. <verse eid="PSA 78:61"/><verse number="62" style="v" sid="PSA 78:62"/>Hann reiddist lýð sínum og lét hann falla fyrir sverði óvinanna. <verse eid="PSA 78:62"/><verse number="63" style="v" sid="PSA 78:63"/>Æskumenn Ísraels fórust í eldi og ungu stúlkurnar upplifðu ekki sinn brúðkaupsdag. <verse eid="PSA 78:63"/><verse number="64" style="v" sid="PSA 78:64"/>Prestunum var slátrað og ekkjur þeirra dóu áður en þær gátu harmað þá. <verse eid="PSA 78:64"/><verse number="65" style="v" sid="PSA 78:65"/>Þá var sem Drottinn vaknaði af svefni, eins og hetja sem rís upp úr vímu, <verse eid="PSA 78:65"/><verse number="66" style="v" sid="PSA 78:66"/>og hann gaf þeim vænt spark í bakhlutann og sendi þá burt með skömm, sömu leið og þeir komu. <verse eid="PSA 78:66"/><verse number="67" style="v" sid="PSA 78:67"/>Hann hafnaði fjölskyldu Jósefs, ætt Efraíms, <verse eid="PSA 78:67"/><verse number="68" style="v" sid="PSA 78:68"/>en kaus Júdaættkvísl og Síonfjall, sem hann elskar. <verse eid="PSA 78:68"/><verse number="69" style="v" sid="PSA 78:69"/>Þar reisti hann musteri sitt – voldugt og traust rétt eins og himin og jörð. <verse eid="PSA 78:69"/><verse number="70" style="v" sid="PSA 78:70"/>Hann kaus Davíð sem þjón sinn, tók hann frá sauðunum, <verse eid="PSA 78:70"/><verse number="71" style="v" sid="PSA 78:71"/>úr smalamennskunni, til að verða leiðtogi og hirðir þjóðar sinnar. Og hann gætti hennar af öryggi og með hreinu hjarta.<verse eid="PSA 78:71"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 79:1"/>Guð, – hefur þú ekki heyrt: Heiðingjarnir hafa ráðist inn í land þitt! Musterið hefur verið saurgað og Jerúsalem er rjúkandi rúst! <verse eid="PSA 79:1"/><verse number="2" style="v" sid="PSA 79:2"/>Lík þinna manna liggja á bersvæði og eru fæða hræfugla og villidýra! <verse eid="PSA 79:2"/><verse number="3" style="v" sid="PSA 79:3"/>Óvinirnir hafa stráfellt íbúa Jerúsalem, svo að allt flýtur í blóði. Enginn er eftir til að grafa hina föllnu. <verse eid="PSA 79:3"/><verse number="4" style="v" sid="PSA 79:4"/>Nágrannaþjóðirnar hæða okkur og spotta og ausa svívirðingum.<verse eid="PSA 79:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 79:5"/>Drottinn, hversu lengi ætlar þú að vera okkur reiður? Að eilífu? Á vandlæti þitt að brenna þar til öll von er úti?! <verse eid="PSA 79:5"/><verse number="6" style="v" sid="PSA 79:6"/>Úthelltu heldur reiði þinni yfir guðlausu þjóðirnar, ekki okkur! Já, yfir konungsríkin sem ekki ákalla nafn þitt. <verse eid="PSA 79:6"/><verse number="7" style="v" sid="PSA 79:7"/>Það eru þau sem hafa útrýmt þjóð þinni og ráðist inn á hvert heimili. <verse eid="PSA 79:7"/><verse number="8" style="v" sid="PSA 79:8"/>Við biðjum þig: Láttu okkur ekki gjalda löngu drýgðra synda forfeðranna! Miskunnaðu þig yfir eymd okkar, því að við höfum verið troðnir niður í svaðið! <verse eid="PSA 79:8"/><verse number="9" style="v" sid="PSA 79:9"/>Hjálpaðu okkur, því að þú ert frelsari okkar! Hjálpaðu okkur, vegna þíns eigin orðstírs! Frelsaðu okkur og fyrirgefðu okkur syndirnar. <verse eid="PSA 79:9"/><verse number="10" style="v" sid="PSA 79:10"/>Hvers vegna fá heiðnu þjóðirnar að hæða okkur og segja: „Hvar er þessi Guð ykkar?!“ Hefndu ófara lýðs þíns svo að eftir verði tekið! <verse eid="PSA 79:10"/><verse number="11" style="v" sid="PSA 79:11"/>Hlustaðu á stunur fanganna og hinna dauðadæmdu. Sýndu mátt þinn og frelsaðu þá. <verse eid="PSA 79:11"/><verse number="12" style="v" sid="PSA 79:12"/>Drottinn, láttu þá fá sjöfalt endurgjald, þessar þjóðir sem hæða þig og spotta!<verse eid="PSA 79:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 79:13"/>Þá munum við, þjóð þín og gæsluhjörð, lofa þig að eilífu og þakka mikilleika þinn frá kynslóð til kynslóðar.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 80:1-2"/> Þú hirðir Ísraels sem leiðir þjóð þína eins og hjörð. Þú Guð sem situr á hásæti uppi yfir verndarenglunum, beygðu þig niður og hlustaðu á bæn mína. Láttu veldi þitt birtast í geisladýrð! <verse eid="PSA 80:1-2"/><verse number="3" style="v" sid="PSA 80:3"/>Leyfðu ættkvíslum Efraíms, Benjamíns og Manasse að verða vitni að því er þú frelsar okkur með mætti þínum.<verse eid="PSA 80:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 80:4"/>Dragðu okkur til þín á ný, ó Guð. Líttu til okkar með velþóknun og kærleika, það er okkar eina von. <verse eid="PSA 80:4"/><verse number="5" style="v" sid="PSA 80:5"/>Ó, Drottinn, þú Guð sem stjórnar hersveitum himnanna, hve lengi ætlar þú að draga bænheyrsluna og láta reiði þína haldast? <verse eid="PSA 80:5"/><verse number="6" style="v" sid="PSA 80:6"/>Þú hefur alið okkur á sorg og sút <verse eid="PSA 80:6"/><verse number="7" style="v" sid="PSA 80:7"/>og gert okkur að andstyggð í augum nágrannaþjóðanna sem hæða okkur og spotta.<verse eid="PSA 80:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 80:8"/>Drottinn hersveitanna, dragðu okkur til þín á ný. Líttu til okkar með velþóknun og kærleika, annars er úti um okkur. <verse eid="PSA 80:8"/><verse number="9" style="v" sid="PSA 80:9"/>Þú fluttir okkur frá Egyptalandi eins og gæðavínvið, upprættir heiðingjana og gróðursettir okkur í landinu. <verse eid="PSA 80:9"/><verse number="10" style="v" sid="PSA 80:10"/>Þú plægðir jörðina og braust landið, við skutum rótum og klæddum hæðirnar.<verse eid="PSA 80:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 80:11"/>Við skyggðum á fjöllin og breiddum úr okkur eins og greinar sedrustrésins, <verse eid="PSA 80:11"/><verse number="12" style="v" sid="PSA 80:12"/>þöktum landið frá Miðjarðarhafi og allt til Evfrat. <verse eid="PSA 80:12"/><verse number="13" style="v" sid="PSA 80:13"/>En nú hefur þú brotið niður múra okkar og eftir stöndum við varnarlausir. <verse eid="PSA 80:13"/><verse number="14" style="v" sid="PSA 80:14"/>Landið hefur verið eytt og er nú orðið að bústað villidýra.<verse eid="PSA 80:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 80:15"/>Við biðjum þig, þú Guð hinna himnesku hersveita, komdu og blessaðu okkur. Líttu niður af himni, sjáðu þjáningar okkar og hlúðu að þessum vínviði þínum! <verse eid="PSA 80:15"/><verse number="16" style="v" sid="PSA 80:16"/>Vernda það sem þú sjálfur gróðursettir, einkasoninn þinn! <verse eid="PSA 80:16"/><verse number="17" style="v" sid="PSA 80:17"/>Óvinirnir lögðu okkur að velli og kveiktu í borgunum. Þeir farast fyrir augliti þínu! <verse eid="PSA 80:17"/><verse number="18" style="v" sid="PSA 80:18"/>Styrktu manninn sem þú elskar, soninn sem þú valdir <verse eid="PSA 80:18"/><verse number="19" style="v" sid="PSA 80:19"/>og við munum aldrei snúa við þér baki. Lífgaðu okkur á nýjan leik og þá skulum við ákalla þig.<verse eid="PSA 80:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 80:20"/>Drottinn, Guð hersveitanna, dragðu okkur til þín á ný. Líttu niður til okkar og láttu okkur sjá velþóknun þína.<verse eid="PSA 80:20"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 81:1-2"/> Guð er okkar styrkur! Syngið lofsöng og fagnið fyrir Guði Ísraels! <verse eid="PSA 81:1-2"/><verse number="3" style="v" sid="PSA 81:3"/>Syngið lofsöng og berjið bumbur, sláið strengi hörpunnar og látið gígjurnar hljóma! <verse eid="PSA 81:3"/><verse number="4" style="v" sid="PSA 81:4"/>Lúðurinn hvelli! Komið til fagnaðar þegar tunglið er fullt og fjölmennið á hátíðir Drottins. <verse eid="PSA 81:4"/><verse number="5" style="v" sid="PSA 81:5"/>Þetta er regla í Ísrael; boðorð frá Guði Jakobs. <verse eid="PSA 81:5"/><verse number="6" style="v" sid="PSA 81:6"/>Við höldum hátíð og minnumst sigurs Drottins á Egyptum þegar við vorum þrælar þar í landi. Ég heyrði ókunna rödd sem sagði: <verse eid="PSA 81:6"/><verse number="7" style="v" sid="PSA 81:7"/>„Ég vil varpa af þér byrðinni, losa af þér ánauðarfjötrana.“ <verse eid="PSA 81:7"/><verse number="8" style="v" sid="PSA 81:8"/>Og hann hélt áfram: „Þú hrópaðir í neyðinni og ég frelsaði þig. Ég svaraði þér úr þrumuskýi. Ég reyndi trú þína hjá Meríba, þar sem þorstinn var sár. <verse eid="PSA 81:8"/><verse number="9" style="v" sid="PSA 81:9"/>Hlustaðu nú á mig, þjóð mín, þegar ég áminni þig. Ísrael, ó, að þú vildir hlýða mér. <verse eid="PSA 81:9"/><verse number="10" style="v" sid="PSA 81:10"/>Engum öðrum guðum mátt þú þjóna og ekki tilbiðja neina útlenda guði. <verse eid="PSA 81:10"/><verse number="11" style="v" sid="PSA 81:11"/>Því að það var ég, Drottinn, Drottinn Guð þinn sem leiddi þig út úr Egyptalandi. Prófa þú mig einu sinni enn. Opnaðu munninn og sjáðu hvort ég muni ekki fylla hann. Þú munt vissulega fá hjá mér hverja þá blessun sem þú þarft! <verse eid="PSA 81:11"/><verse number="12" style="v" sid="PSA 81:12"/>Nei, annars – þjóð mín vill ekki hlusta á mig. Ísrael kærir sig ekki um mig. <verse eid="PSA 81:12"/><verse number="13" style="v" sid="PSA 81:13"/>Þess vegna leyfi ég þeim að ráfa í blindni á vegum þrjósku sinnar og lifa eftir sínum eigin girndum.<verse eid="PSA 81:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 81:14"/>Aðeins ef þjóð mín vildi hlusta á mig! Ó, að Ísrael kysi nú að fylgja mér, ganga á mínum vegum! <verse eid="PSA 81:14"/><verse number="15" style="v" sid="PSA 81:15"/>Þá mundi ég skjótlega brjóta óvini þeirra á bak aftur – reiða hnefann gegn kúgurum þeirra. <verse eid="PSA 81:15"/><verse number="16" style="v" sid="PSA 81:16"/>Þá mundu hatursmenn Drottins skríða fyrir honum og ógæfa þeirra vara við. <verse eid="PSA 81:16"/><verse number="17" style="v" sid="PSA 81:17"/>En ykkur mundi hann ala vel! Já, gefa ykkur hunang úr klettaskoru!“<verse eid="PSA 81:17"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 82:1"/>Guð stígur fram á himnum. Hann segir: „Réttur er settur!“ Síðan birtir hann úrskurð sinn gegn dómurum á jörðu.<verse eid="PSA 82:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 82:2"/>Hve lengi ætlið þið, dómarar, að sniðganga réttlætið? Hve lengi ætlið þið að draga taum hinna ranglátu? <verse eid="PSA 82:2"/><verse number="3" style="v" sid="PSA 82:3"/>Kveðið upp réttláta dóma í málum hinna fátæku og föðurlausu, bágstöddu og þjáðu, <verse eid="PSA 82:3"/><verse number="4" style="v" sid="PSA 82:4"/>Losið fátæklingana úr klóm hinna guðlausu! <verse eid="PSA 82:4"/><verse number="5" style="v" sid="PSA 82:5"/>Þið eruð sljóir og fáfróðir og blindir. Þess vegna riðar þjóðfélagið til falls. <verse eid="PSA 82:5"/><verse number="6" style="v" sid="PSA 82:6"/>Ég hef kallað ykkur „guði“ og „syni hins hæsta“, <verse eid="PSA 82:6"/><verse number="7" style="v" sid="PSA 82:7"/>en í raun og veru eruð þið aðeins dauðlegir menn. Þið munuð falla rétt eins og aðrir af höfðingjunum.<verse eid="PSA 82:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 82:8"/>Rís þú upp, ó Guð, og dæmdu jörðina. Þú hefur hana á valdi þínu og þjóðirnar eru í þinni hendi.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 83:1-2"/> Guð, vertu ekki þögull og afskiptalaus þegar við biðjum til þín. Svaraðu okkur! Já, bjargaðu okkur!<verse eid="PSA 83:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 83:3"/>Heyrirðu ekki skarkalann og ysinn í hópi óvina þinna? Sérðu ekki hvað þeir aðhafast, þessir hatursmenn þínir? <verse eid="PSA 83:3"/><verse number="4" style="v" sid="PSA 83:4"/>Þeir eru með ráðagerðir um að tortíma þeim sem þú elskar! <verse eid="PSA 83:4"/><verse number="5" style="v" sid="PSA 83:5"/>„Komum!“ segja þeir, „þurrkum út Ísrael, svo að þeir hætti að vera til og gleymist.“ <verse eid="PSA 83:5"/><verse number="6" style="v" sid="PSA 83:6"/>Þetta var samþykkt af leiðtogum þeirra. Þessir undirrituðu sáttmála um að fylkja liði gegn almáttugum Guði: <verse eid="PSA 83:6"/><verse number="7" style="v" sid="PSA 83:7"/>Ísmaelítar, Edomítar, Móabítar og Hagrítar. <verse eid="PSA 83:7"/><verse number="8" style="v" sid="PSA 83:8"/>Einnig Gebalmenn, Ammon, Amalek, Filistear og Týrusbúar. <verse eid="PSA 83:8"/><verse number="9" style="v" sid="PSA 83:9"/>Assýría hefur líka slegist í hópinn og gjört bandalag við afkomendur Lots.<verse eid="PSA 83:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 83:10"/>Farðu með þá eins og Midíansmenn forðum, já eins og þú fórst með Sísera og Jabín við Kíshonlæk <verse eid="PSA 83:10"/><verse number="11" style="v" sid="PSA 83:11"/>og með óvini þína við Endór, en lík þeirra urðu að áburði á jörðina. <verse eid="PSA 83:11"/><verse number="12" style="v" sid="PSA 83:12"/>Láttu höfðingja þeirra falla eins og Óreb og Seeb, foringja þeirra deyja líkt og Seba og Salmúna <verse eid="PSA 83:12"/><verse number="13" style="v" sid="PSA 83:13"/>sem sögðu: „Leggjum undir okkur haglendi Drottins!“<verse eid="PSA 83:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 83:14"/>Þú, Guð minn, feyktu þeim burt eins og ryki, eins og hismi fyrir vindi <verse eid="PSA 83:14"/><verse number="15" style="v" sid="PSA 83:15"/>– eins og skógi sem brennur til ösku. <verse eid="PSA 83:15"/><verse number="16" style="v" sid="PSA 83:16"/>Flæmdu þá burt í óveðri, skelfdu þá með fellibyl þínum. <verse eid="PSA 83:16"/><verse number="17" style="v" sid="PSA 83:17"/>Drottinn, láttu þá kenna á andúð þinni uns þeir viðurkenna mátt þinn og vald. <verse eid="PSA 83:17"/><verse number="18" style="v" sid="PSA 83:18"/>Láttu öll þeirra verk mistakast, svo að þeir skelfist og blygðist sín <verse eid="PSA 83:18"/><verse number="19" style="v" sid="PSA 83:19"/>og viðurkenni að þú einn, Drottinn, ert Guð yfir öllum guðum og að jörðin öll er á þínu valdi.<verse eid="PSA 83:19"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 84:1-2"/> Ó, hve musteri þitt er yndislegt, þú Drottinn hersveitanna. <verse eid="PSA 84:1-2"/><verse number="3" style="v" sid="PSA 84:3"/>Mig langar svo mjög, já ég þrái, að nálgast þig, hinn lifandi Guð. <verse eid="PSA 84:3"/><verse number="4" style="v" sid="PSA 84:4"/>Jafnvel spörvum og svölum leyfist að búa sér hreiður innan um ölturu þín og eiga þar unga sína. Þú Drottinn hinna himnesku hersveita, konungur minn og Guð minn! <verse eid="PSA 84:4"/><verse number="5" style="v" sid="PSA 84:5"/>Sælir eru þeir sem fá að búa í musteri þínu og syngja þér lof.<verse eid="PSA 84:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 84:6"/>Sælir eru þeir sem fá styrk frá þér og þrá það eitt að ganga veg þinn. <verse eid="PSA 84:6"/><verse number="7" style="v" sid="PSA 84:7"/>Þegar þeir ganga gegnum táradalinn, þá breytir þú honum í vatnsríka vin og haustregrúð færir þeim blessun. <verse eid="PSA 84:7"/><verse number="8" style="v" sid="PSA 84:8"/>Þeir styrkjast á göngunni og fá að lokum að ganga fram fyrir Drottin í musteri hans á Síon.<verse eid="PSA 84:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 84:9"/>Drottinn, Guð hersveitanna, heyrðu bæn mína! Hlusta þú Guð Ísraels. <verse eid="PSA 84:9"/><verse number="10" style="v" sid="PSA 84:10"/>Guð, þú ert vörn okkar, miskunna honum sem þú smurðir til konungs.<verse eid="PSA 84:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 84:11"/>Einn dagur í musteri þínu er betri en þúsund aðrir sem eytt er á öðrum stað! Frekar vildi ég vera dyravörður í musteri Guðs míns, en búa í höllum óguðlegra. <verse eid="PSA 84:11"/><verse number="12" style="v" sid="PSA 84:12"/>Því að Drottinn er okkur ljós og skjöldur. Vegsemd og náð veitir hann. Hann neitar þeim ekki um nein gæði sem hlýða honum.<verse eid="PSA 84:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 84:13"/>Drottinn hersveitanna, sæll er sá maður sem treystir þér.<verse eid="PSA 84:13"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 85:1-2"/> Drottinn, þú hefur baðað land þetta blessun! Þú hefur snúið hlutunum Ísrael í hag <verse eid="PSA 85:1-2"/><verse number="3" style="v" sid="PSA 85:3"/>og fyrirgefið syndir þjóðar þinnar, já, hulið þær allar! <verse eid="PSA 85:3"/><verse number="4" style="v" sid="PSA 85:4"/>Reiði þína hefur þú líka dregið í hlé.<verse eid="PSA 85:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 85:5"/>Dragðu okkur nær þér svo að við getum elskað þig heitar, að þú þurfir ekki að reiðast okkur á ný. <verse eid="PSA 85:5"/><verse number="6" style="v" sid="PSA 85:6"/>(Eða mun reiði þín vara að eilífu, frá kynslóð til kynslóðar?) <verse eid="PSA 85:6"/><verse number="7" style="v" sid="PSA 85:7"/>Lífgaðu okkur við, þjóð þína, svo að við getum aftur lofað þig. <verse eid="PSA 85:7"/><verse number="8" style="v" sid="PSA 85:8"/>Leyfðu okkur að njóta elsku þinnar og gæsku, ó Guð, og veittu okkur hjálp þína.<verse eid="PSA 85:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 85:9"/>Þegar Drottinn talar til þjóðar sinnar, hlusta ég vel, þegar hann ávarpar sinn útvalda lýð. Hann flytur okkur frið og velgengni þegar við snúum hjörtum okkar til hans. <verse eid="PSA 85:9"/><verse number="10" style="v" sid="PSA 85:10"/>Vissulega njóta þeir hjálpar hans þeir sem hlýða honum og heiðra hann. Velgengni og blessun hans mun breiðast yfir allt landið. <verse eid="PSA 85:10"/><verse number="11" style="v" sid="PSA 85:11"/>Miskunn og sannleikur munu mætast, réttlæti og friður kyssast! <verse eid="PSA 85:11"/><verse number="12" style="v" sid="PSA 85:12"/>Trúfestin eflist á jörðu og réttlætið brosir frá himni! <verse eid="PSA 85:12"/><verse number="13" style="v" sid="PSA 85:13"/>Drottinn blessar landið og það ber margfalda uppskeru. <verse eid="PSA 85:13"/><verse number="14" style="v" sid="PSA 85:14"/>Réttlæti og friður fylgir Drottni.<verse eid="PSA 85:14"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 86:1"/>Drottinn, líttu til mín! Hlustaðu á bæn mína! Svaraðu mér því að ég er í nauðum staddur.<verse eid="PSA 86:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 86:2"/>Bjargaðu mér frá dauða, því að ég tilheyri þér. Frelsaðu mig, því að ég treysti þér og hlýði. <verse eid="PSA 86:2"/><verse number="3" style="v" sid="PSA 86:3"/>Miskunna mér, Drottinn. Ég mæni til þín og vona á þig liðlangan daginn. <verse eid="PSA 86:3"/><verse number="4" style="v" sid="PSA 86:4"/>Drottinn, leyfðu mér að gleðjast því að ég tilbið þig einan. <verse eid="PSA 86:4"/><verse number="5" style="v" sid="PSA 86:5"/>Drottinn, þú ert mildur og góður og fús að fyrirgefa, gæskuríkur við alla sem ákalla þig.<verse eid="PSA 86:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 86:6"/>Heyr þú bæn mína Drottinn, því að ég ákalla þig í neyð minni. <verse eid="PSA 86:6"/><verse number="7" style="v" sid="PSA 86:7"/>Þegar ég er í vanda staddur hrópa ég til þín því að þú hjálpar mér.<verse eid="PSA 86:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 86:8"/>Enginn hinna heiðnu guða stenst samjöfnuð við þig! Þín verk eru engu lík! <verse eid="PSA 86:8"/><verse number="9" style="v" sid="PSA 86:9"/>Þjóðirnar – þú skapaðir þær allar – munu koma og lúta þér. Þær munu lofa þitt háa og heilaga nafn <verse eid="PSA 86:9"/><verse number="10" style="v" sid="PSA 86:10"/>því að þú ert mikill og gerir furðuverk. Þú einn ert Guð!<verse eid="PSA 86:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 86:11"/>Sýndu mér, Drottinn, hvert þú vilt senda mig og þangað mun ég fara, því það er vegur sannleikans. Ó, að ég gæti tignað þig af heilu hjarta og hreinni samvisku! <verse eid="PSA 86:11"/><verse number="12" style="v" sid="PSA 86:12"/>Ég lofa þig Drottinn Guð minn af öllu hjarta. Ég vil vegsama nafn þitt að eilífu. <verse eid="PSA 86:12"/><verse number="13" style="v" sid="PSA 86:13"/>Mikill er kærleikur þinn! Þú ert mér alltaf svo góður! Þú frelsaðir mig úr djúpi heljar.<verse eid="PSA 86:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 86:14"/>Ofstopamenn rísa gegn mér. Guðlaus illmenni vilja ryðja mér burt. <verse eid="PSA 86:14"/><verse number="15" style="v" sid="PSA 86:15"/>En þú, Drottinn, ert miskunnsamur Guð, seinn til reiði, langlyndur og trúr. <verse eid="PSA 86:15"/><verse number="16" style="v" sid="PSA 86:16"/>Líttu til mín í náð og styrktu mig. Ég er þjónn þinn, frelsaðu mig. <verse eid="PSA 86:16"/><verse number="17" style="v" sid="PSA 86:17"/>Gefðu mér tákn um að þú elskir mig. Þegar óvinir mínir sjá það, munu þeir blygðast sín því að þú hjálpar mér og huggar mig.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 87:1-2"/> Hátt á hinu heilaga fjalli, stendur Jerúsalem, borg Guðs – borgin sem hann elskar öllum borgum framar.<verse eid="PSA 87:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 87:3"/>Vel er um þig talað, þú borg Guðs! <verse eid="PSA 87:3"/><verse number="4" style="v" sid="PSA 87:4"/>Ef ég í vinahópi minnist á Egyptaland eða Babýlon, Filisteu eða Týrus eða hið fjarlæga Bláland, þá hrósa þeir sér sem fæddir eru á þessum stöðum. <verse eid="PSA 87:4"/><verse number="5" style="v" sid="PSA 87:5"/>En mestur heiður fylgir Jerúsalem! Hún er móðirin og gott er að vera fæddur þar! Hann, hinn hæsti Guð, mun sjálfur vernda hana.<verse eid="PSA 87:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 87:6"/>Þegar Drottinn lítur yfir þjóðskrárnar, mun hann merkja við þá sem hér eru fæddir!<verse eid="PSA 87:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 87:7"/>Á hátíðum og tyllidögum munu menn syngja: „Jerúsalem, uppsprettur lífs míns eru í þér!“<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 88:1-2"/> Drottinn, þú Guð minn og hjálpari minn, ég ákalla þig um daga og nætur. <verse eid="PSA 88:1-2"/><verse number="3" style="v" sid="PSA 88:3"/>Svaraðu bænum mínum! Hlustaðu á hróp mitt, <verse eid="PSA 88:3"/><verse number="4" style="v" sid="PSA 88:4"/>því að ég er altekinn ótta og finn dauðann nálgast. <verse eid="PSA 88:4"/><verse number="5" style="v" sid="PSA 88:5"/>„Líf hans er að fjara út,“ segja sumir, „það er vonlaust með hann.“ <verse eid="PSA 88:5"/><verse number="6" style="v" sid="PSA 88:6"/>Ég er einn og yfirgefinn og bíð þess eins að deyja, rétt eins og þeir sem falla á vígvellinum.<verse eid="PSA 88:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 88:7"/>Þú hefur varpað mér niður í myrkradjúp. <verse eid="PSA 88:7"/><verse number="8" style="v" sid="PSA 88:8"/>Reiði þín hefur þrýst mér niður, hver holskeflan á fætur annarri kaffærir mig. <verse eid="PSA 88:8"/><verse number="9" style="v" sid="PSA 88:9"/>Vinir mínir sneru við mér bakinu og eru horfnir – það var af þínum völdum. Ég er innikróaður, sé enga undankomuleið. <verse eid="PSA 88:9"/><verse number="10" style="v" sid="PSA 88:10"/>Augu mín eru blinduð af tárum. Daglega kalla ég eftir hjálp þinni. Ó, Drottinn, ég lyfti höndum í bæn um náð!<verse eid="PSA 88:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 88:11"/>Gerðu kraftaverk svo að ég deyi ekki, því hvað gagnar mér hjálp þín ef ég ligg kaldur í gröfinni? Þá get ég ekki lofað þig! <verse eid="PSA 88:11"/><verse number="12" style="v" sid="PSA 88:12"/>Geta hinir látnu vegsamað gæsku þína? Syngja þeir um trúfesti þína?! <verse eid="PSA 88:12"/><verse number="13" style="v" sid="PSA 88:13"/>Getur myrkrið borið vitni um máttarverk þín? Hvernig eiga þeir sem búa í landi gleymskunnar að tala um hjálp þína?<verse eid="PSA 88:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 88:14"/>Ó, Drottinn, dag eftir dag bið ég fyrir lífi mínu. <verse eid="PSA 88:14"/><verse number="15" style="v" sid="PSA 88:15"/>Drottinn, hvers vegna hefur þú útskúfað mér? Af hverju hefur þú snúið þér burt frá mér og litið í aðra átt? <verse eid="PSA 88:15"/><verse number="16" style="v" sid="PSA 88:16"/>Allt frá æsku hef ég átt erfiða ævi og oft staðið andspænis dauðanum. Ég er magnþrota gagnvart örlögum þeim sem þú hefur búið mér. <verse eid="PSA 88:16"/><verse number="17" style="v" sid="PSA 88:17"/>Heift þín og reiði hefur lamað mig. Þessi skelfing þín hefur næstum gert út af við mig. <verse eid="PSA 88:17"/><verse number="18" style="v" sid="PSA 88:18"/>Alla daga hvolfist hún yfir mig. <verse eid="PSA 88:18"/><verse number="19" style="v" sid="PSA 88:19"/>Ástvinir, félagar og kunningjar – öll eru þau farin. Ég sit hér einn í myrkri.<verse eid="PSA 88:19"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 89:1-2"/> Ég vil syngja um miskunn Drottins að eilífu! Ungir sem gamlir skulu fá að heyra um trúfesti þína. <verse eid="PSA 89:1-2"/><verse number="3" style="v" sid="PSA 89:3"/>Elska þín og náð vara að eilífu og trúfesti þín stendur óhögguð eins og himinninn.<verse eid="PSA 89:3"/></para>
  <para style="p">
    <verse number="4-5" style="v" pubnumber="4,5" sid="PSA 89:4-5"/> Svo segir Drottinn Guð: „Ég hef gert sáttmála við Davíð, minn útvalda þjón. Ég hef unnið þann eið, að afkomendur hans skuli sitja á konungsstóli héðan í frá og að eilífu!“<verse eid="PSA 89:4-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 89:6"/>Himinninn lofi máttarverk þín, Drottinn og herskarar englanna vegsami trúfesti þína. <verse eid="PSA 89:6"/><verse number="7" style="v" sid="PSA 89:7"/>Því að hver á himnum kemst í samjöfnuð við Guð? Hinn mesti meðal englanna, hver er hann við hlið Drottins?! <verse eid="PSA 89:7"/><verse number="8" style="v" sid="PSA 89:8"/>Hinir voldugu englar nálgast hann með ótta og virðingu. Hann er ægilegur í þeirra augum. <verse eid="PSA 89:8"/><verse number="9" style="v" sid="PSA 89:9"/>Drottinn, þú konungur hinna himnesku hersveita, enginn kemst í samjöfnuð við þig! Trúfestin er einkenni þitt!<verse eid="PSA 89:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 89:10"/>Þú hefur hemil á ofstopa hafsins, stöðvar óveðursöldur. Með einu orði lægir þú þær. <verse eid="PSA 89:10"/><verse number="11" style="v" sid="PSA 89:11"/>Þú rotaðir skrímslið, það lá marflatt – og tvístraðir óvinum þínum með undramætti. <verse eid="PSA 89:11"/><verse number="12" style="v" sid="PSA 89:12"/>Himinninn og jörðin, allt er það þitt. Þú skapaðir það. <verse eid="PSA 89:12"/><verse number="13" style="v" sid="PSA 89:13"/>Þú skapaðir norðrið og suðrið líka. Tabor og Hermon kætast, hin háu fjöll, sem hönd þín gjörði. <verse eid="PSA 89:13"/><verse number="14" style="v" sid="PSA 89:14"/>Mikill er máttur þinn! Hægri hönd þín er upphafin í mætti og dýrð!<verse eid="PSA 89:14"/></para>
  <para style="p">
    <verse number="15-16" style="v" pubnumber="15,16" sid="PSA 89:15-16"/> Tvær eru undirstöður hásætis þíns: Réttvísi og réttlæti, og miskunn og trúfesti eru fylgdarsveinar þínir. Sælir eru þeir sem heyra fagnaðarópið – þeir sem ganga í ljósinu sem stafar frá Drottni. <verse eid="PSA 89:15-16"/><verse number="17" style="v" sid="PSA 89:17"/>Þín vegna gleðjast þeir alla daga og fagna yfir þínum réttlátu verkum. <verse eid="PSA 89:17"/><verse number="18" style="v" sid="PSA 89:18"/>Þú ert styrkur þeirra. Þetta er undursamlegt! Já, við hressumst og gleðjumst því við vitum að þú hefur velþóknun á okkur! <verse eid="PSA 89:18"/><verse number="19" style="v" sid="PSA 89:19"/>Sjálfur Drottinn er okkar vörn og hann, hinn heilagi í Ísrael – sjálfur Guð – hefur gefið okkur konung.<verse eid="PSA 89:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 89:20"/>Þú talaðir við spámann þinn í sýn og sagðir: „Ég hef fundið rétta manninn meðal fólksins, hann skal verða konungur! <verse eid="PSA 89:20"/><verse number="21" style="v" sid="PSA 89:21"/>Það er Davíð, þjónn minn! Ég hef smurt hann minni heilögu olíu.<verse eid="PSA 89:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PSA 89:22"/>Ég vil veita honum kraft og styrkja hann á göngunni. <verse eid="PSA 89:22"/><verse number="23" style="v" sid="PSA 89:23"/>Óvinir hans skulu ekki fella hann, né illmennin kúga hann. <verse eid="PSA 89:23"/><verse number="24" style="v" sid="PSA 89:24"/>Ég mun láta hann sjá er ég eyði óvinum hans og þurrka út hatursmenn hans.<verse eid="PSA 89:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 89:25"/>Ég mun stöðugt vernda hann og blessa og umvefja hann elsku minni. Mín vegna mun hann verða mikill. <verse eid="PSA 89:25"/><verse number="26" style="v" sid="PSA 89:26"/>Ríki hans mun ná frá Miðjarðarhafi til Evfratfljóts. <verse eid="PSA 89:26"/><verse number="27" style="v" sid="PSA 89:27"/>Hann mun segja við mig: „Þú ert faðir minn, Guð minn, klettur hjálpræðis míns.“<verse eid="PSA 89:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PSA 89:28"/>Ég mun líta á hann sem frumgetinn son minn og gera hann fremstan meðal konunga jarðarinnar. <verse eid="PSA 89:28"/><verse number="29" style="v" sid="PSA 89:29"/>Ég mun elska hann að eilífu og vera honum góður. Ég mun halda sáttmála minn við hann að eilífu. <verse eid="PSA 89:29"/><verse number="30" style="v" sid="PSA 89:30"/>Hann mun aldrei skorta erfingja og hásæti hans mun standa um eilífð eins og himinninn. <verse eid="PSA 89:30"/><verse number="31-33" style="v" sid="PSA 89:31-33"/>Ef afkomendur hans hafna lögmáli mínu og óhlýðnast mér, þá mun ég hegna þeim, <verse eid="PSA 89:31-33"/><verse number="34" style="v" sid="PSA 89:34"/>en aldrei mun ég þó hætta að miskunna þeim, né bregðast loforði mínu. <verse eid="PSA 89:34"/><verse number="35" style="v" sid="PSA 89:35"/>Nei, sáttmála minn mun ég alls ekki rjúfa. Ekkert orða minna tek ég aftur. <verse eid="PSA 89:35"/><verse number="36-37" style="v" pubnumber="36,37" sid="PSA 89:36-37"/> Ég hef heitið Davíð því (og hinn heilagi Guð talar sannleika) að konungsætt hans mun vara um aldir alda, já rétt eins og sólin! <verse eid="PSA 89:36-37"/><verse number="38" style="v" sid="PSA 89:38"/>Konungdómur hans skal standa að eilífu eins og tunglið, – trúfasta vitnið á himninum!“<verse eid="PSA 89:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="PSA 89:39"/>En, – hvers vegna hefur þú þá útskúfað mér?! Hafnað þeim sem þú valdir til konungs? <verse eid="PSA 89:39"/><verse number="40" style="v" sid="PSA 89:40"/>Hefur þú rofið sáttmálann við hann? Þú sem kastaðir kórónu hans í skítinn! <verse eid="PSA 89:40"/><verse number="41" style="v" sid="PSA 89:41"/>Múra hans hefur þú brotið og rifið niður varnarvirkin. <verse eid="PSA 89:41"/><verse number="42" style="v" sid="PSA 89:42"/>Allir vegfarendur ræna hann. Hann er til háðungar nágrönnum sínum. <verse eid="PSA 89:42"/><verse number="43" style="v" sid="PSA 89:43"/>Þú magnaðir óvini hans gegn honum, og nú kætast þeir! <verse eid="PSA 89:43"/><verse number="44" style="v" sid="PSA 89:44"/>Þú slóst sverð hans til jarðar og neitaðir honum um hjálp í bardaganum. <verse eid="PSA 89:44"/><verse number="45" style="v" sid="PSA 89:45"/>Þú hefur bundið enda á vegsemd hans og hrint hásæti hans um koll. <verse eid="PSA 89:45"/><verse number="46" style="v" sid="PSA 89:46"/>Hann lítur út sem öldungur þótt ungur sé, og það er af þínum völdum. Þú hefur hulið hann skömm.<verse eid="PSA 89:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="PSA 89:47"/>Ó, Drottinn, hve lengi á þetta ástand að vara? Ætlar þú að fela þig fyrir mér að eilífu? Hve lengi á reiði þín að brenna?<verse eid="PSA 89:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="PSA 89:48"/>Mundu hve mannsævin er stutt og að verk okkar flestra eru hégómleg og smá. <verse eid="PSA 89:48"/><verse number="49" style="v" sid="PSA 89:49"/>Enginn maður lifir endalaust. Öll deyjum við að lokum. Og hver getur stigið upp úr gröf sinni?<verse eid="PSA 89:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="PSA 89:50"/>Drottinn, hvar er nú kærleikur þinn til mín? Hvar er gæskan sem þú lofaðir Davíð með eiði? <verse eid="PSA 89:50"/><verse number="51" style="v" sid="PSA 89:51"/>Veistu það, Drottinn, að öll þjóðin hæðist að mér! <verse eid="PSA 89:51"/><verse number="52" style="v" sid="PSA 89:52"/>Óvinir þínir spotta mig, manninn sem þú útvaldir til konungs.<verse eid="PSA 89:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="PSA 89:53"/>En þrátt fyrir allt og allt, sé Drottinn lofaður um eilífð! Amen, amen.<verse eid="PSA 89:53"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="d">
    <verse number="1" style="v" sid="PSA 90:1"/>Bæn guðsmannsins Móse.</para>
  <para style="p" vid="PSA 90:1">Drottinn, þú hefur verið okkur athvarf frá kynslóð til kynslóðar. <verse eid="PSA 90:1"/><verse number="2" style="v" sid="PSA 90:2"/>Áður en þú skapaðir fjöllin og jörðin varð til, varst þú, ó Guð – þú átt þér hvorki upphaf né endi! <verse eid="PSA 90:2"/><verse number="3" style="v" sid="PSA 90:3"/>Þú talar – og maðurinn verður aftur að dufti. <verse eid="PSA 90:3"/><verse number="4" style="v" sid="PSA 90:4"/>Þúsund ár eru eins og einn dagur fyrir þér, eins og klukkustund! <verse eid="PSA 90:4"/><verse number="5-6" style="v" pubnumber="5,6" sid="PSA 90:5-6"/> Við berumst með straumi tímans og hverfum líkt og í draumi. Við erum eins og grasið sem grær að morgni en skrælnar að kvöldi, visnar og deyr. <verse eid="PSA 90:5-6"/><verse number="7" style="v" sid="PSA 90:7"/>Við föllum fyrir reiði þinni og hnígum fyrir bræði þinni. <verse eid="PSA 90:7"/><verse number="8" style="v" sid="PSA 90:8"/>Þú hefur breitt úr syndum okkar frammi fyrir þér – einnig hinum leyndu syndum – engin þeirra er þér hulin. <verse eid="PSA 90:8"/><verse number="9" style="v" sid="PSA 90:9"/>Reiði þín er enginn leikur. Er að undra þótt ævin sé erfið og dagarnir líði sem andvarp.<verse eid="PSA 90:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 90:10"/>Ævi okkar er sjötíu ár og þegar best lætur áttatíu ár. En jafnvel bestu árin eru full af mæðu og hégóma. Þau eru horfin áður en varir og við á bak og burt! <verse eid="PSA 90:10"/><verse number="11" style="v" sid="PSA 90:11"/>Hver þekkir ógnir reiði þinnar, og hvert okkar óttast þig eins og ber?<verse eid="PSA 90:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 90:12"/>Kenndu okkur að telja alla okkar daga og skilja hve ævin er stutt. Gefðu að við fáum notað hana til góðs.<verse eid="PSA 90:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 90:13"/>Ó, Drottinn, hve lengi er þess að bíða að þú dragir reiði þína í hlé og blessir okkur á nýjan leik? <verse eid="PSA 90:13"/><verse number="14" style="v" sid="PSA 90:14"/>Miskunna okkur á hverjum morgni að við megum gleðjast hvern einasta dag. <verse eid="PSA 90:14"/><verse number="15" style="v" sid="PSA 90:15"/>Já, gefðu okkur gleði í stað armæðu liðinna daga. <verse eid="PSA 90:15"/><verse number="16" style="v" sid="PSA 90:16"/>Leyfðu okkur aftur að reyna máttarverk þín svo að börn okkar sjái dýrð þína eins og við forðum.<verse eid="PSA 90:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 90:17"/>Náð Drottins Guðs sé með okkur. Hann veiti okkur gæfu og gengi.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 91:1"/>Sæll er sá sem nýtur verndar hins hæsta og hvílir í skjóli hins almáttuga, <verse eid="PSA 91:1"/><verse number="2" style="v" sid="PSA 91:2"/>sá sem getur sagt við Drottin: „Þú ert skjól mitt og vörn! Þú ert minn Guð, ég treysti þér!“<verse eid="PSA 91:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 91:3"/>Hann frelsar þig úr snörunni og bjargar þér undan plágunni. <verse eid="PSA 91:3"/><verse number="4" style="v" sid="PSA 91:4"/>Hann mun skýla þér undir vængjum sínum. Þar muntu finna öruggt skjól! Hann hefur lofað að vernda þig og frelsa. <verse eid="PSA 91:4"/><verse number="5" style="v" sid="PSA 91:5"/>Nú þarftu ekki lengur að óttast ógnir myrkursins, né örina sem þýtur að morgni. <verse eid="PSA 91:5"/><verse number="6" style="v" sid="PSA 91:6"/>Heldur ekki drepsótt næturinnar né skelfingu um hábjartan dag.<verse eid="PSA 91:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 91:7"/>Þótt þúsund falli mér við hlið og tíu þúsund mér til hægri handar, þá mun hið illa ekki ná til mín. <verse eid="PSA 91:7"/><verse number="8" style="v" sid="PSA 91:8"/>Ég mun horfa á þegar óguðlegum er refsað en sjálfur vera óhultur, <verse eid="PSA 91:8"/><verse number="9" style="v" sid="PSA 91:9"/>því að Drottinn er skjól mitt! Ég hef valið hinn hæsta Guð mér til varnar. <verse eid="PSA 91:9"/><verse number="10" style="v" sid="PSA 91:10"/>Hvernig ætti þá ógæfa að yfirbuga mig eða plága að nálgast hús mitt? <verse eid="PSA 91:10"/><verse number="11" style="v" sid="PSA 91:11"/>Eins skipar hann englum sínum að vernda þig, hvar sem þú ert. <verse eid="PSA 91:11"/><verse number="12" style="v" sid="PSA 91:12"/>Þeir munu styðja þig á göngunni og forða þér frá hrösun. <verse eid="PSA 91:12"/><verse number="13" style="v" sid="PSA 91:13"/>Þótt þú mætir ljóni eða snák, þá er ekkert að óttast – þú munt jafnvel troða þau fótum!<verse eid="PSA 91:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 91:14"/>Hefur Drottinn ekki sagt: „Vegna þess að þú elskar mig, mun ég frelsa þig. Ég bjarga þér af því að þú þekkir mig og veist að mér er óhætt að treysta. <verse eid="PSA 91:14"/><verse number="15" style="v" sid="PSA 91:15"/>Þegar þú kallar á mig, svara ég þér. Ég er með þér á hættustund, frelsa þig og held uppi heiðri þínum. <verse eid="PSA 91:15"/><verse number="16" style="v" sid="PSA 91:16"/>Ég mun gefa þér langa og góða ævi og láta þig sjá hjálpræði mitt.“<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 92:1-2"/> Gott er að þakka Drottni og lofsyngja Guði hinum hæsta. <verse eid="PSA 92:1-2"/><verse number="3" style="v" sid="PSA 92:3"/>Á hverjum morgni segi ég við Drottin: „Þökk sé þér fyrir miskunn þína!“ Og á kvöldin fagna ég yfir trúfesti hans. <verse eid="PSA 92:3"/><verse number="4" style="v" sid="PSA 92:4"/>Syngið honum lof og leikið undir á hörpu og gígju. <verse eid="PSA 92:4"/><verse number="5" style="v" sid="PSA 92:5"/>Drottinn, mikið ertu mér góður. Ég syng af gleði! – Er nokkur hissa á því?<verse eid="PSA 92:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 92:6"/>Ó, Drottinn, mikil eru máttarverk þín! <verse eid="PSA 92:6"/><verse number="7" style="v" sid="PSA 92:7"/>Þeir einir sem ekki nenna að hugsa, fara þeirra á mis. Heimskingjarnir skilja ekki <verse eid="PSA 92:7"/><verse number="8" style="v" sid="PSA 92:8"/>að hinir óguðlegu – sem í bili virðast hafa það gott – munu afmáðir að eilífu. <verse eid="PSA 92:8"/><verse number="9" style="v" sid="PSA 92:9"/>En Drottinn, þú lifir að eilífu, hátt upphafinn á himnum, <verse eid="PSA 92:9"/><verse number="10" style="v" sid="PSA 92:10"/>meðan óvinir þínir – illgjörðamennirnir – tvístrast.<verse eid="PSA 92:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 92:11"/>Ég finn styrk og kraft, en Drottinn, allt er það þér að þakka! Blessun þín hefur endurnært mig. <verse eid="PSA 92:11"/><verse number="12" style="v" sid="PSA 92:12"/>Ég heyrði dóminn yfir óvinum mínum og sá þegar þeim var eytt. <verse eid="PSA 92:12"/><verse number="13" style="v" sid="PSA 92:13"/>En hinir réttlátu munu blómgast líkt og ávaxtatré, já vaxa eins og sedrustrén í Líbanon.<verse eid="PSA 92:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 92:14"/>Því að þeir eru gróðursettir í garði Drottins og njóta umhyggju hans. <verse eid="PSA 92:14"/><verse number="15" style="v" sid="PSA 92:15"/>Jafnvel á elliárunum bera þeir ávöxt og eru sem laufguð tré. <verse eid="PSA 92:15"/><verse number="16" style="v" sid="PSA 92:16"/>Þeir bera vitni um réttlæti Drottins, að hann er skjól og vernd og allt sem hann gerir er gott!<verse eid="PSA 92:16"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 93:1-2"/> Drottinn er konungur! Hann er íklæddur mætti og dýrð. Heimurinn allur er hásæti hans. Ó, Drottinn, þú hefur ríkt frá örófi alda. <verse eid="PSA 93:1-2"/><verse number="3" style="v" sid="PSA 93:3"/>Brimöldur hafsins boða dýrð þína. <verse eid="PSA 93:3"/><verse number="4" style="v" sid="PSA 93:4"/>En þú ert meiri en voldugar öldur sem brotna við strendur úthafanna! <verse eid="PSA 93:4"/><verse number="5" style="v" sid="PSA 93:5"/>Skipunum þínum fær enginn breytt og heilagleiki er einkenni húss þíns að eilífu.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 94:1-2"/> Drottinn, þú ert Guð hefndarinnar – sá Guð sem réttir hlut þeirra sem ranglæti eru beittir. Láttu dýrð þína birtast. Rís upp, þú dómari jarðar. Refsaðu ofstopamönnum fyrir illverk þeirra. <verse eid="PSA 94:1-2"/><verse number="3" style="v" sid="PSA 94:3"/>Drottinn, hve lengi eiga óguðlegir að hrósa sigri? <verse eid="PSA 94:3"/><verse number="4" style="v" sid="PSA 94:4"/>Þeir eru að springa af monti! Hlustaðu á grobbið í þeim! <verse eid="PSA 94:4"/><verse number="5" style="v" sid="PSA 94:5"/>Drottinn, líttu á hvernig þeir kúga þjóð þína og kvelja fólkið sem þú elskar. <verse eid="PSA 94:5"/><verse number="6-7" style="v" pubnumber="6,7" sid="PSA 94:6-7"/> Þeir myrða ekkjur og munaðarleysingja og líka útlendinga sem hér hafa sest að. „Drottinn sér þetta ekki,“ segja þeir, „hann lætur sér fátt um finnast.“<verse eid="PSA 94:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 94:8"/>Heimskingjar! <verse eid="PSA 94:8"/><verse number="9" style="v" sid="PSA 94:9"/>Haldið þið að Guð sé blindur og heyrnarlaus, hann sem skapar bæði augu og eyru! <verse eid="PSA 94:9"/><verse number="10" style="v" sid="PSA 94:10"/>Hann refsar þjóðunum – og nú er komið að ykkur. Enginn hlutur er honum hulinn. Eins og hann viti ekki hvað þið hafið gert!<verse eid="PSA 94:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 94:11"/>Drottinn þekkir skammsýni og hégómleika mannanna <verse eid="PSA 94:11"/><verse number="12-13" style="v" pubnumber="12,13" sid="PSA 94:12-13"/> og því agar hann okkur til góðs. Það gerir hann til þess að við göngum á hans vegum og gefumst ekki upp í mótlæti. <verse eid="PSA 94:12-13"/><verse number="14" style="v" sid="PSA 94:14"/>Drottinn afneitar ekki lýð sínum né yfirgefur þjóð sína. <verse eid="PSA 94:14"/><verse number="15" style="v" sid="PSA 94:15"/>Dómar hans eru réttlátir og fylgjendur hans fagna af hreinu hjarta.<verse eid="PSA 94:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 94:16"/>Hver vill vernda mig fyrir illgjörðamönnum? Hver vill vera skjöldur minn? <verse eid="PSA 94:16"/><verse number="17" style="v" sid="PSA 94:17"/>Án Drottins væri ég dauðans matur. <verse eid="PSA 94:17"/><verse number="18" style="v" sid="PSA 94:18"/>Ég æpti: „Drottinn, ég er að hrapa!“ og af gæsku sinni frelsaði hann mig. <verse eid="PSA 94:18"/><verse number="19" style="v" sid="PSA 94:19"/>Drottinn, þegar efasemdir ásækja mig og hjarta mitt er fullt af angist, þá gefðu mér frið þinn og endurnýjaðu gleði mína.<verse eid="PSA 94:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 94:20"/>Vilt þú vernda og viðhalda spilltri valdsstjórn sem hallar réttlætinu? Leyfir þú slíkt? <verse eid="PSA 94:20"/><verse number="21-22" style="v" pubnumber="21,22" sid="PSA 94:21-22"/> Hefur þú þóknun á þeim sem dæma saklausa til dauða? Nei! Drottinn, Guð minn, er vígi mitt, kletturinn þar sem ég leita skjóls. <verse eid="PSA 94:21-22"/><verse number="23" style="v" sid="PSA 94:23"/>Guð lætur syndir óguðlegra koma þeim sjálfum í koll. Illverk þeirra verða þeim að falli.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 95:1"/>Komið! Við skulum lofsyngja Drottni! Hrópum gleðióp til heiðurs kletti hjálpræðisins!<verse eid="PSA 95:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 95:2"/>Komum fram fyrir hann með þakkargjörð, syngjum honum lofgjörðarsálm. <verse eid="PSA 95:2"/><verse number="3" style="v" sid="PSA 95:3"/>Því að Drottinn er mikill Guð og æðri öllum sem menn kalla guði. <verse eid="PSA 95:3"/><verse number="4" style="v" sid="PSA 95:4"/>Hann hefur upphugsað djúp jarðar og hannað hin hæstu fjöll. <verse eid="PSA 95:4"/><verse number="5" style="v" sid="PSA 95:5"/>Hann gerði hafið og myndaði þurrlendið, allt er hans! <verse eid="PSA 95:5"/><verse number="6" style="v" sid="PSA 95:6"/>Komið! Föllum fram fyrir Drottni, skapara okkar, <verse eid="PSA 95:6"/><verse number="7" style="v" sid="PSA 95:7"/>því að hann er okkar Guð. Við erum hjörðin hans og hann er hirðir okkar. Ó, að þið vilduð heyra kall hans í dag og koma til hans.<verse eid="PSA 95:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 95:8"/>Forherðið ekki hjörtu ykkar eins og Ísraelsmenn gerðu hjá Meriba og Massa í eyðimörkinni. <verse eid="PSA 95:8"/><verse number="9" style="v" sid="PSA 95:9"/>Þar drógu feður ykkar orð mín í efa – sömu menn og sáu mig gera mörg kraftaverk. Þeir freistuðu mín, kvörtuðu og reyndu á þolinmæði mína. <verse eid="PSA 95:9"/><verse number="10" style="v" sid="PSA 95:10"/>„Í fjörutíu ár hafði ég viðbjóð á þessari kynslóð,“ segir Drottinn Guð. „Hjörtu þeirra allra voru langt í burtu frá mér og ekki vildu þeir halda lög mín. <verse eid="PSA 95:10"/><verse number="11" style="v" sid="PSA 95:11"/>Þá hét ég því að þeir skyldu aldrei komast inn í fyrirheitna landið, staðinn sem ég hafði ætlað þeim til hvíldar.“<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 96:1"/>Syngið Drottni nýjan söng! Syngið þann söng um alla jörðina! <verse eid="PSA 96:1"/><verse number="2" style="v" sid="PSA 96:2"/>Syngið um velgjörðir hans, lofið nafn hans. Kunngerið hjálpráð hans dag eftir dag.<verse eid="PSA 96:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 96:3"/>Segið frá dýrð hans meðal þjóðanna, – allra þjóða. Kunngerið öllum dásemdarverk hans. <verse eid="PSA 96:3"/><verse number="4" style="v" sid="PSA 96:4"/>Því að Drottinn er mikill og mjög vegsamlegur. Hann einn er sá Guð sem rétt er að tilbiðja. <verse eid="PSA 96:4"/><verse number="5" style="v" sid="PSA 96:5"/>Þjóðirnar tilbiðja falsguði eina, en okkar Guð hefur skapað himininn! <verse eid="PSA 96:5"/><verse number="6" style="v" sid="PSA 96:6"/>Hann er umvafinn heiðri og dýrð, styrkur og fegurð fylla musteri hans.<verse eid="PSA 96:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 96:7"/>Þið kynkvíslir jarðar, játið Drottni heiður og dýrð.<verse eid="PSA 96:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 96:8"/>Heiðrið hann eins og skyldugt er! Berið fram fórnina og tilbiðjið hann. <verse eid="PSA 96:8"/><verse number="9" style="v" sid="PSA 96:9"/>Tilbiðjið Drottin í heilagleik og heiðri. Allur heimurinn skjálfi fyrir augliti hans. <verse eid="PSA 96:9"/><verse number="10" style="v" sid="PSA 96:10"/>Kunngjörið þjóðunum að Drottinn er konungur. Hann ríkir yfir alheimi. Hann er skapari jarðar og mun dæma allar þjóðir með réttvísi.<verse eid="PSA 96:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 96:11"/>Himnarnir gleðjist og jörðin kætist og brimgnýr hafsins boði tign hans og mátt. <verse eid="PSA 96:11"/><verse number="12" style="v" sid="PSA 96:12"/>Ávöxtur jarðar vitnar um dýrð hans og þytur trjánna lofar hann. <verse eid="PSA 96:12"/><verse number="13" style="v" sid="PSA 96:13"/>Því að Drottinn mun dæma heiminn með réttvísi og þjóðirnar eftir trúfesti sinni!<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 97:1"/>Drottinn er konungur! Allur heimurinn gleðjist! Fagnið þið eyjar við ysta haf!<verse eid="PSA 97:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 97:2"/>Tignarleg ský umlykja hann. Réttlæti og réttvísi eru undirstöður hásætis hans. <verse eid="PSA 97:2"/><verse number="3" style="v" sid="PSA 97:3"/>Eldur gengur út frá honum og eyðir öllum óvinum hans. <verse eid="PSA 97:3"/><verse number="4" style="v" sid="PSA 97:4"/>Elding hans leiftrar og lýsir upp jörðina. Heimurinn skelfur af ótta. <verse eid="PSA 97:4"/><verse number="5" style="v" sid="PSA 97:5"/>Fjöllin bráðna eins og vax fyrir Drottni. <verse eid="PSA 97:5"/><verse number="6" style="v" sid="PSA 97:6"/>Himnarnir kunngera réttlæti hans og allar þjóðir sjá dýrð hans.<verse eid="PSA 97:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 97:7"/>Allir skurðgoðadýrkendur verða til skammar – þeir sem stæra sig af falsguðum – því að allir slíkir guðir verða að beygja sig fyrir Drottni. <verse eid="PSA 97:7"/><verse number="8-9" style="v" pubnumber="8,9" sid="PSA 97:8-9"/> Jerúsalem og borgirnar í Júda hafa heyrt af réttvísi þinni, Drottinn, og fagna, því að þú ríkir með reisn yfir allri jörðinni og ert hátt yfir alla aðra guði hafinn.<verse eid="PSA 97:8-9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 97:10"/>Drottinn elskar þá sem hata hið illa. Hann verndar líf fylgjenda sinna og frelsar þá undan óguðlegum. <verse eid="PSA 97:10"/><verse number="11" style="v" sid="PSA 97:11"/>Ljós skal lýsa hinum réttlátu og gleði hlotnast hinum góðu. <verse eid="PSA 97:11"/><verse number="12" style="v" sid="PSA 97:12"/>Allir réttlátir fagni fyrir Drottni og vegsami hans heilaga nafn.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 98:1"/>Syngið nýjan söng fyrir Drottin því að hann hefur unnið dásamlegt verk! Hann er sigursæll í mætti sínum og heilagleika.<verse eid="PSA 98:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 98:2"/>Hann hefur tilkynnt sigur sinn – birt þjóðunum réttlæti sitt. <verse eid="PSA 98:2"/><verse number="3" style="v" sid="PSA 98:3"/>Hann hefur miskunnað lýð sínum, haldið loforð sín til Ísrael. Allur heimurinn sá er Guð bjargaði þjóð sinni. <verse eid="PSA 98:3"/><verse number="4" style="v" sid="PSA 98:4"/>Þess vegna hefja löndin fagnaðarsöng, syngja og lofa hann af öllu hjarta.<verse eid="PSA 98:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 98:5"/>Syngið Drottni við undirleik hörpu. <verse eid="PSA 98:5"/><verse number="6" style="v" sid="PSA 98:6"/>Blásið í lúðra og básúnur gjalli! Hljómsveitin spili lofgjörðarlag. Hyllið Drottin, konunginn! <verse eid="PSA 98:6"/><verse number="7" style="v" sid="PSA 98:7"/>Hafið drynji og lofi Drottin! Jörðin og íbúar hennar reki upp fagnaðaróp!<verse eid="PSA 98:7"/></para>
  <para style="p">
    <verse number="8-9" style="v" pubnumber="8,9" sid="PSA 98:8-9"/> Fossarnir klappi lof í lófa og klettarnir syngi gleðisöng, því að Drottinn mun dæma heiminn í réttlæti sínu og af réttvísi.<verse eid="PSA 98:8-9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 99:1"/>Drottinn er konungur! Þjóðirnar skjálfi! Hásæti hans stendur miklu ofar englunum. Jörðin nötri í óttablandinni virðingu.<verse eid="PSA 99:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 99:2"/>Drottinn ríkir með hátign á Síon, æðri öllum konungum á jörðu. <verse eid="PSA 99:2"/><verse number="3" style="v" sid="PSA 99:3"/>Þeir tigni hans háa og heilaga nafn!<verse eid="PSA 99:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 99:4"/>Drottinn er voldugur konungur. Hann elskar réttlæti. Réttvísi og heiðarleiki einkenna stjórnarfar hans. Þannig ríkir hann í Ísrael. <verse eid="PSA 99:4"/><verse number="5" style="v" sid="PSA 99:5"/>Vegsamið Drottin, hinn heilaga Guð! Föllum fram við fótskör hans.<verse eid="PSA 99:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 99:6"/>Móse og Aron voru prestar hans og Samúel spámaður hans. Þeir báðu til Drottins og hann bænheyrði þá. <verse eid="PSA 99:6"/><verse number="7" style="v" sid="PSA 99:7"/>Úr skýstólpa talaði hann við þá, þeir hlustuðu og hlýddu fyrirmælum hans. <verse eid="PSA 99:7"/><verse number="8" style="v" sid="PSA 99:8"/>Ó, Drottinn, þú ert okkar Guð! Þú svaraðir þeim og fyrirgafst syndir þeirra.<verse eid="PSA 99:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 99:9"/>Tignið Drottin Guð! Tilbiðjið hann í Jerúsalem á fjallinu helga. Hann er heilagur.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 100:1"/>Öll veröldin fagni fyrir Drottni! <verse eid="PSA 100:1"/><verse number="2" style="v" sid="PSA 100:2"/>Þjónið Drottni með gleði, gangið fram fyrir hann með fagnaðarsöng!<verse eid="PSA 100:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 100:3"/>Reynið að skilja hvað í því felst að Drottinn er Guð. Við erum handaverk hans! Fólkið sem hann leiðir.<verse eid="PSA 100:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 100:4"/>Gangið inn um hlið hans með þakkargjörð, í forgarða hans með lofsöng. Þakkið honum, lofið nafn hans. <verse eid="PSA 100:4"/><verse number="5" style="v" sid="PSA 100:5"/>Því að Drottinn er góður! Miskunn hans varir að eilífu og trúfesti hans frá kynslóð til kynslóðar.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 101:1"/>Ég vil syngja um réttlætið og miskunnsemina. Ég vil lofsyngja þér, ó Guð!<verse eid="PSA 101:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 101:2"/>Ég, konungurinn, vil kappkosta að lifa heiðarlega og ganga um heimili mitt í grandvarleik – hjálpaðu mér til þess!<verse eid="PSA 101:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 101:3"/>Gefðu mér að forðast allt sem er gróft og ljótt – að fyrirlíta hið illa. <verse eid="PSA 101:3"/><verse number="4" style="v" sid="PSA 101:4"/>Já, ég vil ekki vera sjálfselskur og vondur. <verse eid="PSA 101:4"/><verse number="5" style="v" sid="PSA 101:5"/>Ég umber ekki þá sem baktala nágranna sinn, og hroka og dramb mun ég ekki þola. <verse eid="PSA 101:5"/><verse number="6" style="v" sid="PSA 101:6"/>Ég leita uppi réttláta menn í landinu og kalla þá til starfa, að þeir búi hjá mér, – þeir einir sem grandvarir eru. <verse eid="PSA 101:6"/><verse number="7" style="v" sid="PSA 101:7"/>Svikara og lygara þoli ég ekki í mínum húsum. <verse eid="PSA 101:7"/><verse number="8" style="v" sid="PSA 101:8"/>Ég þagga niður í illmennunum í landinu og útrými úr borginni öllum óguðlegum.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 102:1-2"/> Drottinn, heyrðu bæn mína! Hlustaðu á ákall mitt! <verse eid="PSA 102:1-2"/><verse number="3" style="v" sid="PSA 102:3"/>Snúðu ekki baki við mér á ógæfutímum. Hneigðu eyra þitt að mér og svaraðu mér fljótt. <verse eid="PSA 102:3"/><verse number="4-5" style="v" pubnumber="4,5" sid="PSA 102:4-5"/> Ævi mín líður svo hratt, dagarnir fljúga hver af öðrum. Heilsan er búin, hjartað er sjúkt – ég er eins og visið strá. Maturinn er bragðlaus, ég er hættur að finna bragð. <verse eid="PSA 102:4-5"/><verse number="6" style="v" sid="PSA 102:6"/>Ég er ekkert nema skinn og bein. <verse eid="PSA 102:6"/><verse number="7" style="v" sid="PSA 102:7"/>Ég er líkastur pelikan í eyðimörk eða uglu í húsarúst. <verse eid="PSA 102:7"/><verse number="8" style="v" sid="PSA 102:8"/>Ég ligg andvaka og styn eins og einmana fugl á þaki.<verse eid="PSA 102:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 102:9"/>Óvinir mínir hæða mig og spotta dag eftir dag. <verse eid="PSA 102:9"/><verse number="10-11" style="v" pubnumber="10,11" sid="PSA 102:10-11"/> Fæða mín er aska, ekki brauð, og drykkur minn blandast tárum mínum. Þú ert mér reiður Drottinn og hefur varpað mér burt frá þér.<verse eid="PSA 102:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 102:12"/>Líf mitt líður burt eins og kvöldskuggi. Ég visna eins og gras <verse eid="PSA 102:12"/><verse number="13" style="v" sid="PSA 102:13"/>en þú Drottinn ríkir í dýrð þinni að eilífu. Þinn orðstír mun lifa frá kynslóð til kynslóðar.<verse eid="PSA 102:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 102:14"/>Ég veit að þú munt koma og vægja Jerúsalem. – Gerðu það núna! – Efndu loforð þitt um hjálp. <verse eid="PSA 102:14"/><verse number="15" style="v" sid="PSA 102:15"/>Því að þjóð þín elskar hvern stein í múr hennar og jafnvel rykið á strætum hennar.<verse eid="PSA 102:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 102:16"/>Þjóðirnar og konungar þeirra skjálfi fyrir Drottni og hans miklu dýrð, <verse eid="PSA 102:16"/><verse number="17" style="v" sid="PSA 102:17"/>því að Drottinn mun endurreisa Jerúsalem og birtast þar í dýrð! <verse eid="PSA 102:17"/><verse number="18" style="v" sid="PSA 102:18"/>Hann hlustar á bænir fátæklinganna, gefur gaum að beiðni þeirra.<verse eid="PSA 102:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 102:19"/>Þetta hef ég skráð til þess að komandi kynslóðir lofi Drottin fyrir öll hans verk. Fólk sem enn hefur ekki séð dagsins ljós mun vegsama hann. <verse eid="PSA 102:19"/><verse number="20" style="v" sid="PSA 102:20"/>Segið þeim að Drottinn leit niður frá musteri sínu á himnum. <verse eid="PSA 102:20"/><verse number="21" style="v" sid="PSA 102:21"/>Hann heyrði stunur þjóðar sinnar í ánauðinni – hún var dauðans matur – og hann frelsaði hana!<verse eid="PSA 102:21"/></para>
  <para style="p">
    <verse number="22-23" style="v" pubnumber="22,23" sid="PSA 102:22-23"/> Þess vegna streyma þúsundir til musteris hans í Jerúsalem og lofa hann og vegsama um alla borgina. Konungar jarðarinnar eru í þeim hópi.<verse eid="PSA 102:22-23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PSA 102:24"/>Hann hefur tekið frá mér lífskraftinn og stytt ævi mína.<verse eid="PSA 102:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 102:25"/>En ég hrópaði til hans: „Þú, Guð sem lifir að eilífu, láttu mig ekki deyja fyrir aldur fram! <verse eid="PSA 102:25"/><verse number="26" style="v" sid="PSA 102:26"/>Í upphafi lagðir þú undirstöður jarðarinnar og himnarnir eru verk handa þinna. <verse eid="PSA 102:26"/><verse number="27" style="v" sid="PSA 102:27"/>Þau munu hverfa en þú ert að eilífu. Þau fyrnast, líkt og slitin föt sem lögð eru til hliðar. <verse eid="PSA 102:27"/><verse number="28" style="v" sid="PSA 102:28"/>En þú ert hinn sami og ár þín taka aldrei enda.<verse eid="PSA 102:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PSA 102:29"/>En afkomendur okkar munu lifa og þú munt varðveita þá, kynslóð fram af kynslóð.“<verse eid="PSA 102:29"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 103:1"/>Ég vil lofa Guð af öllu hjarta. <verse eid="PSA 103:1"/><verse number="2" style="v" sid="PSA 103:2"/>Ég vil vegsama Drottin og minnast allra velgjörða hans við mig. <verse eid="PSA 103:2"/><verse number="3" style="v" sid="PSA 103:3"/>Hann fyrirgefur syndir mínar. Hann læknar mig. <verse eid="PSA 103:3"/><verse number="4" style="v" sid="PSA 103:4"/>Hann frelsar mig frá dauða. Hann umlykur mig náð og miskunn. <verse eid="PSA 103:4"/><verse number="5" style="v" sid="PSA 103:5"/>Hann hleður á mig gjöfum! Hann endurnýjar lífsþrótt minn og gerir mig sterkan sem örn. <verse eid="PSA 103:5"/><verse number="6" style="v" sid="PSA 103:6"/>Hann réttir hlut þeirra sem misrétti þola. <verse eid="PSA 103:6"/><verse number="7" style="v" sid="PSA 103:7"/>Hann opinberaði Móse vilja sinn og hver hann væri og einnig þjóð sinni Ísrael.<verse eid="PSA 103:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 103:8"/>Hann er miskunnsamur og mildur við þá sem eiga það ekki skilið. Hann er seinn til reiði og fullur náðar og kærleika.<verse eid="PSA 103:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 103:9"/>Hann er ekki langrækinn né eilíflega reiður. <verse eid="PSA 103:9"/><verse number="10" style="v" sid="PSA 103:10"/>Hann hefur ekki refsað okkur fyrir syndir okkar eins og sanngjarnt var <verse eid="PSA 103:10"/><verse number="11" style="v" sid="PSA 103:11"/>því að miskunn hans við þá sem óttast hann og heiðra, er eins há og himinninn er yfir jörðinni. <verse eid="PSA 103:11"/><verse number="12" style="v" sid="PSA 103:12"/>Hann fleygði burt syndum okkar og það langt, já, eins langt og austrið er frá vestrinu! <verse eid="PSA 103:12"/><verse number="13" style="v" sid="PSA 103:13"/>Eins og faðir miskunnar börnum sínum, eins hefur Drottinn miskunnað þeim sem óttast hann, <verse eid="PSA 103:13"/><verse number="14" style="v" sid="PSA 103:14"/>því hann veit að við erum bara dauðlegir menn <verse eid="PSA 103:14"/><verse number="15" style="v" sid="PSA 103:15"/>og að ævi okkar er stutt og líður hratt. Við erum eins og jurt sem vex og blómgast <verse eid="PSA 103:15"/><verse number="16" style="v" sid="PSA 103:16"/>en skrælnar fyrr en varir í brennheitum vindinum, deyr og gleymist.<verse eid="PSA 103:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" pubnumber="17,18" sid="PSA 103:17-18"/> En miskunn Drottins endist að eilífu fyrir þá sem reiða sig á orð hans og óttast hann. Og hjálpræði hans nær til barnabarnanna ef við höldum sáttmála hans og hlýðum boðum hans.<verse eid="PSA 103:17-18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 103:19"/>Drottinn hefur reist sér hásæti á himnum og þaðan stjórnar hann heiminum. <verse eid="PSA 103:19"/><verse number="20" style="v" sid="PSA 103:20"/>Lofið Drottin, þið voldugu englar sem framkvæmið skipanir hans og takið við fyrirmælum hans. <verse eid="PSA 103:20"/><verse number="21" style="v" sid="PSA 103:21"/>Lofið Drottin, þið hersveitir englanna sem framfylgið vilja hans.<verse eid="PSA 103:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PSA 103:22"/>Öll verk Drottins, um víða veröld, lofa hann! Einnig ég vil lofa hann!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 104:1-2"/> Ég lofa Drottin! Drottinn, þú Guð minn, þú ert undursamlegur! Þú ert íklæddur hátign og dýrð og umlukinn ljósi! Þú þandir út himininn eins og dúk og dreifðir um hann stjörnunum. <verse eid="PSA 104:1-2"/><verse number="3" style="v" sid="PSA 104:3"/>Þú mótaðir þurrlendið og rýmdir fyrir hafinu. Þú gerðir ský að vagni þínum og ferð um á vængjum vindarins. <verse eid="PSA 104:3"/><verse number="4" style="v" sid="PSA 104:4"/>Englarnir eru erindrekar þínir og eldslogar þjóna þér.<verse eid="PSA 104:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 104:5"/>Undirstöður heimsins eru traustar, þær eru þitt verk, og þess vegna haggast hann ekki. <verse eid="PSA 104:5"/><verse number="6" style="v" sid="PSA 104:6"/>Þú lést vatnsflóð ganga yfir jörðina og hylja fjöllin. <verse eid="PSA 104:6"/><verse number="7-8" style="v" pubnumber="7,8" sid="PSA 104:7-8"/> Og þegar þú bauðst, safnaðist vatnið saman í höfunum, fjöllin risu og dalirnir urðu til. <verse eid="PSA 104:7-8"/><verse number="9" style="v" sid="PSA 104:9"/>Þú settir sjónum sín ákveðnu mörk svo að hann skyldi aldrei aftur flæða yfir þurrlendið.<verse eid="PSA 104:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 104:10"/>Þú settir lindir í dalina og lækir renna um fjöllin. <verse eid="PSA 104:10"/><verse number="11" style="v" sid="PSA 104:11"/>Þeir eru dýrunum til drykkjar og þar svalar villiasninn þorsta sínum. <verse eid="PSA 104:11"/><verse number="12" style="v" sid="PSA 104:12"/>Þar gera fuglar sér hreiður og söngur þeirra ómar frá trjánum. <verse eid="PSA 104:12"/><verse number="13" style="v" sid="PSA 104:13"/>Hann sendir regn yfir fjöllin svo að jörðin ber sinn ávöxt. <verse eid="PSA 104:13"/><verse number="14" style="v" sid="PSA 104:14"/>Safaríkt grasið vex að boði hans og er búfénu til fæðu. En maðurinn yrkir jörðina, ræktar ávexti, grænmeti og korn, <verse eid="PSA 104:14"/><verse number="15" style="v" sid="PSA 104:15"/>einnig vín sér til gleði, olíu sem gerir andlitið gljáandi og brauð sem gefur kraft. <verse eid="PSA 104:15"/><verse number="16" style="v" sid="PSA 104:16"/>Drottinn gróðursetti sedrustrén í Líbanon, há og tignarleg, <verse eid="PSA 104:16"/><verse number="17" style="v" sid="PSA 104:17"/>og þar byggja fuglarnir sér hreiður, en storkurinn velur kýprustréð til bústaðar. <verse eid="PSA 104:17"/><verse number="18" style="v" sid="PSA 104:18"/>Steingeiturnar kjósa hin háu fjöll, en stökkhérarnir finna sér stað í klettum.<verse eid="PSA 104:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 104:19"/>Tunglið settir þú til að afmarka mánuði, en sólina til að skína um daga. <verse eid="PSA 104:19"/><verse number="20" style="v" sid="PSA 104:20"/>Myrkur og nótt eru frá þér komin, þá fara skógardýrin á kreik. <verse eid="PSA 104:20"/><verse number="21" style="v" sid="PSA 104:21"/>Þá öskra ljónin eftir bráð og heimta æti sitt af Guði. <verse eid="PSA 104:21"/><verse number="22" style="v" sid="PSA 104:22"/>Þegar sólin rís draga þau sig í hlé og leggjast í fylgsni sín, <verse eid="PSA 104:22"/><verse number="23" style="v" sid="PSA 104:23"/>en mennirnir ganga út til starfa og vinna allt til kvölds. <verse eid="PSA 104:23"/><verse number="24" style="v" sid="PSA 104:24"/>Drottinn, hvílík fjölbreytni í öllu því sem þú hefur skapað! Allt á það upphaf sitt í vísdómi þínum! Jörðin er full af því sem þú hefur gert!<verse eid="PSA 104:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 104:25"/>Framundan mér teygir sig blikandi haf, iðandi af alls konar lífi! <verse eid="PSA 104:25"/><verse number="26" style="v" sid="PSA 104:26"/>Og sjá! Þarna eru skipin! Og þarna hvalirnir! – þeir leika á alls oddi! <verse eid="PSA 104:26"/><verse number="27" style="v" sid="PSA 104:27"/>Allar skepnur vona á þig, að þú gefir þeim fæðu þeirra á réttum tíma. <verse eid="PSA 104:27"/><verse number="28" style="v" sid="PSA 104:28"/>Þú mætir þörfum þeirra og þau mettast ríkulega af gæðum þínum.<verse eid="PSA 104:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PSA 104:29"/>En snúir þú við þeim bakinu er úti um þau. Þegar þú ákveður, deyja þau og verða að mold, <verse eid="PSA 104:29"/><verse number="30" style="v" sid="PSA 104:30"/>en þú sendir líka út anda þinn og vekur nýtt líf á jörðinni.<verse eid="PSA 104:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="PSA 104:31"/>Lof sé Guði að eilífu! Drottinn gleðst yfir verkum sínum!<verse eid="PSA 104:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PSA 104:32"/>Þegar hann lítur á jörðina, skelfur hún og eldfjöllin gjósa við snertingu fingra hans.<verse eid="PSA 104:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PSA 104:33"/>Ég vil lofsyngja Drottni svo lengi sem ég lifi, vegsama Guð á meðan ég er til! <verse eid="PSA 104:33"/><verse number="34" style="v" sid="PSA 104:34"/>Ó, að ljóð þetta mætti gleðja hann, því að Drottinn er gleði mín og fögnuður.<verse eid="PSA 104:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="PSA 104:35"/>Ó, að misgjörðarmenn hyrfu af jörðinni og að óguðlegir yrðu ekki framar til. En Drottin vil ég vegsama að eilífu! Hallelúja!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 105:1"/>Þakkið Drottni fyrir öll hans undursamlegu verk og segið frá þeim meðal þjóðanna. <verse eid="PSA 105:1"/><verse number="2" style="v" sid="PSA 105:2"/>Syngið fyrir hann, leikið fyrir hann og segið öllum frá máttarverkum hans. <verse eid="PSA 105:2"/><verse number="3" style="v" sid="PSA 105:3"/>Lofið og vegsamið hans heilaga nafn. Þið sem tilbiðjið Drottin, fagnið!<verse eid="PSA 105:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 105:4"/>Leitið hans og máttar hans, og keppið eftir að kynnast honum!<verse eid="PSA 105:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" pubnumber="5,6" sid="PSA 105:5-6"/> Minnist dásemdarverkanna sem hann vann fyrir okkur, sína útvöldu þjóð, afkomendur Abrahams og Jakobs, þjóna hans. Munið þið hvernig hann útrýmdi óvinum okkar? <verse eid="PSA 105:5-6"/><verse number="7" style="v" sid="PSA 105:7"/>Hann er Drottinn, Guð okkar. Elska hans blasir við hvar sem er í landinu. <verse eid="PSA 105:7"/><verse number="8-9" style="v" pubnumber="8,9" sid="PSA 105:8-9"/> Þótt þúsund kynslóðir líði, þá gleymir hann ekki loforði sínu, sáttmála sínum við Abraham og Ísak. <verse eid="PSA 105:8-9"/><verse number="10-11" style="v" pubnumber="10,11" sid="PSA 105:10-11"/> Þennan sáttmála endurnýjaði hann við Jakob. Þetta er hans eilífi sáttmáli við Ísrael: „Ég mun gefa ykkur Kanaansland að erfð.“ <verse eid="PSA 105:10-11"/><verse number="12" style="v" sid="PSA 105:12"/>Þetta sagði hann meðan þeir voru enn fámennir, já mjög fáir, og bjuggu sem útlendingar í landinu. <verse eid="PSA 105:12"/><verse number="13" style="v" sid="PSA 105:13"/>Síðar dreifðust þeir meðal þjóðanna og hröktust úr einu landinu í annað. <verse eid="PSA 105:13"/><verse number="14" style="v" sid="PSA 105:14"/>Samt leyfði hann engum að kúga þá og refsaði konungum sem það reyndu. <verse eid="PSA 105:14"/><verse number="15" style="v" sid="PSA 105:15"/>„Snertið ekki við mínum útvöldu og gerið spámönnum mínum ekkert mein.“ sagði hann.<verse eid="PSA 105:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 105:16"/>Og hann lét hungursneyð koma yfir Kanaansland og allur matur gekk til þurrðar. <verse eid="PSA 105:16"/><verse number="17" style="v" sid="PSA 105:17"/>Þá sendi hann Jósef í ánauð til Egyptalands, þjóð sinni til bjargar. <verse eid="PSA 105:17"/><verse number="18" style="v" sid="PSA 105:18"/>Þeir hlekkjuðu hann og þjáðu, <verse eid="PSA 105:18"/><verse number="19" style="v" sid="PSA 105:19"/>en Guð lét hann þola eldraunina og batt að lokum enda á fangavist hans. <verse eid="PSA 105:19"/><verse number="20" style="v" sid="PSA 105:20"/>Og faraó sendi eftir Jósef og lét hann lausan, <verse eid="PSA 105:20"/><verse number="21" style="v" sid="PSA 105:21"/>og setti hann svo yfir allar eigur sínar. <verse eid="PSA 105:21"/><verse number="22" style="v" sid="PSA 105:22"/>Þá hafði Jósef vald til að fangelsa höfðingja og segja ráðgjöfum konungs til.<verse eid="PSA 105:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 105:23"/>Síðar kom Jakob (Ísrael) til Egyptalands og settist þar að með sonum sínum. <verse eid="PSA 105:23"/><verse number="24" style="v" sid="PSA 105:24"/>Þau ár fjölgaði Ísrael mjög, já svo mjög að þeir urðu fjölmennari en Egyptar, sem réðu landinu. <verse eid="PSA 105:24"/><verse number="25" style="v" sid="PSA 105:25"/>En Guð sneri hjörtum Egypta gegn Ísrael, þeir hötuðu þá og hnepptu í þrældóm.<verse eid="PSA 105:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PSA 105:26"/>Þá útvaldi Guð Móse sem fulltrúa sinn og Aron honum til hjálpar. <verse eid="PSA 105:26"/><verse number="27" style="v" sid="PSA 105:27"/>Hann gjörði tákn meðal Egypta og vakti þannig ótta hjá þeim. <verse eid="PSA 105:27"/><verse number="28" style="v" sid="PSA 105:28"/>Þeir fóru að skipun Drottins og hann sendi myrkur yfir landið, <verse eid="PSA 105:28"/><verse number="29" style="v" sid="PSA 105:29"/>breytti ám og vötnum í blóð svo að fiskurinn dó.<verse eid="PSA 105:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="PSA 105:30"/>Þá kom flóðbylgja af froskum – þeir voru um allt, jafnvel í svefnherbergi konungs! <verse eid="PSA 105:30"/><verse number="31" style="v" sid="PSA 105:31"/>Að skipun Móse fylltist landið af mývargi og flugum. <verse eid="PSA 105:31"/><verse number="32" style="v" sid="PSA 105:32"/>Í stað regns dundi banvænt hagl yfir landið og eldingar skelfdu íbúana. <verse eid="PSA 105:32"/><verse number="33" style="v" sid="PSA 105:33"/>Vínviður þeirra og fíkjutré drápust, féllu brotin til jarðar. <verse eid="PSA 105:33"/><verse number="34" style="v" sid="PSA 105:34"/>Þá bauð hann engisprettum að naga allan grænan gróður <verse eid="PSA 105:34"/><verse number="35" style="v" sid="PSA 105:35"/>og eyðileggja uppskeruna, – hvílík plága! <verse eid="PSA 105:35"/><verse number="36" style="v" sid="PSA 105:36"/>Þá deyddi hann frumburðina, – elsta barn í hverri egypskri fjölskyldu – þar fór framtíðarvonin. <verse eid="PSA 105:36"/><verse number="37" style="v" sid="PSA 105:37"/>Og Drottinn leiddi sitt fólk heilu og höldnu út úr Egyptalandi, hlaðið gulli og silfri. Ekkert þeirra var veikt eða vanmáttugt. <verse eid="PSA 105:37"/><verse number="38" style="v" sid="PSA 105:38"/>Og Egyptar voru því fegnastir þegar Ísraelsmenn héldu á brott, því að þeir óttuðust þá.<verse eid="PSA 105:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="PSA 105:39"/>Um daga breiddi Guð út ský og hlífði þeim gegn brennheitri sólinni og um nætur lýsti hann þeim leiðina með eldstólpa. <verse eid="PSA 105:39"/><verse number="40" style="v" sid="PSA 105:40"/>Þeir báðu um kjöt og hann sendi þeim lynghænsni og brauð gaf hann þeim – manna, brauð frá himni. <verse eid="PSA 105:40"/><verse number="41" style="v" sid="PSA 105:41"/>Hann opnaði klettinn og vatnið spratt fram og varð að læk í eyðimörkinni. <verse eid="PSA 105:41"/><verse number="42" style="v" sid="PSA 105:42"/>Hann minntist loforðs síns til Abrahams, þjóns síns, <verse eid="PSA 105:42"/><verse number="43" style="v" sid="PSA 105:43"/>og leiddi sitt útvalda fólk fagnandi út úr Egyptalandi. <verse eid="PSA 105:43"/><verse number="44" style="v" sid="PSA 105:44"/>Og hann gaf þeim lönd heiðingjanna, sem stóðu í fullum blóma með þroskaða uppskeru og þeir átu það sem aðrir höfðu sáð til. <verse eid="PSA 105:44"/><verse number="45" style="v" sid="PSA 105:45"/>Allt skyldi þetta hvetja Ísrael til trúfesti og hlýðni við lög Drottins.</para>
  <para style="p" vid="PSA 105:45">Hallelúja!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 106:1"/>Hallelúja! Drottinn, þökk sé þér því að þú ert góður! Elska þín varir að eilífu. <verse eid="PSA 106:1"/><verse number="2" style="v" sid="PSA 106:2"/>Hver getur talið upp öll máttarverk Guðs og hver getur lofað hann eins og rétt er og skylt? Enginn!<verse eid="PSA 106:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 106:3"/>Sæll er sá réttláti sem gerir nágrönnum sínum gott.<verse eid="PSA 106:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 106:4"/>Drottinn, þegar þú blessar og bjargar fólki þínu, minnstu þá einnig mín. <verse eid="PSA 106:4"/><verse number="5" style="v" sid="PSA 106:5"/>Gefðu mér hlut í velgengni þinna útvöldu, að fá að gleðjast með þeim og deila með þeim hjálp þinni.<verse eid="PSA 106:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 106:6"/>Bæði við og feður okkar höfum margvíslega syndgað. <verse eid="PSA 106:6"/><verse number="7" style="v" sid="PSA 106:7"/>Máttarverk þín í Egyptalandi mátu þeir lítils og fljótlega gleymdu þeir góðverkum þínum og risu gegn þér við hafið hið rauða. <verse eid="PSA 106:7"/><verse number="8" style="v" sid="PSA 106:8"/>En samt frelsaðir þú þá, hélst uppi heiðri nafns þíns og sýndir mátt þinn. <verse eid="PSA 106:8"/><verse number="9" style="v" sid="PSA 106:9"/>Þú klaufst hafið, lagðir þurran veg um botn þess og leiddir þá þar í gegn. <verse eid="PSA 106:9"/><verse number="10" style="v" sid="PSA 106:10"/>Þannig frelsaðir þú þá frá óvinum þeirra. <verse eid="PSA 106:10"/><verse number="11" style="v" sid="PSA 106:11"/>Síðan féll sjórinn aftur í farveg sinn og óvinir þeirra fórust – ekki einn komst af!<verse eid="PSA 106:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 106:12"/>Þá loks trúðu þeir Drottni og sungu honum lofsöng.<verse eid="PSA 106:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 106:13"/>En þeir voru fljótir að gleyma honum á ný! Þeir treystu ekki orðum hans <verse eid="PSA 106:13"/><verse number="14" style="v" sid="PSA 106:14"/>en heimtuðu sífellt meira og meira og reyndu eins og þeir gátu á þolinmæði Guðs. <verse eid="PSA 106:14"/><verse number="15" style="v" sid="PSA 106:15"/>Og hann lét að vilja þeirra, en þó ekki að öllu leyti. <verse eid="PSA 106:15"/><verse number="16" style="v" sid="PSA 106:16"/>Þeir gerðu uppreisn gegn Móse og líka Aron, manninn sem Guð hafði valið til prests. <verse eid="PSA 106:16"/><verse number="17" style="v" sid="PSA 106:17"/>Þá opnaðist jörðin og gleypti Datan og flokk Abírams. <verse eid="PSA 106:17"/><verse number="18" style="v" sid="PSA 106:18"/>Eldur féll af himni og eyddi illmennum þessum.<verse eid="PSA 106:18"/></para>
  <para style="p">
    <verse number="19-20" style="v" pubnumber="19,20" sid="PSA 106:19-20"/> Þeir gerðu sér líkneski af nauti, sem étur gras, og tilbáðu það í stað hins dýrlega Guðs! <verse eid="PSA 106:19-20"/><verse number="21-22" style="v" pubnumber="21,22" sid="PSA 106:21-22"/> Þannig óvirtu þeir Guð, frelsara sinn, sem gert hafði undur og tákn í Egyptalandi og við hafið rauða. <verse eid="PSA 106:21-22"/><verse number="23" style="v" sid="PSA 106:23"/>Þess vegna áformaði Guð að eyða þeim öllum. En Móse, hans útvaldi þjónn, tók sér stöðu milli fólksins og Guðs og bað hann að láta af reiði sinni og tortíma þeim ekki.<verse eid="PSA 106:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PSA 106:24"/>Og ekki vildu þeir inn í fyrirheitna landið, þeir treystu ekki að Guð mundi vernda þá. <verse eid="PSA 106:24"/><verse number="25" style="v" sid="PSA 106:25"/>Þeir kvörtuðu í tjöldum sínum og fyrirlitu skipun hans. <verse eid="PSA 106:25"/><verse number="26" style="v" sid="PSA 106:26"/>Þá ákvað hann að láta þá deyja í eyðimörkinni, <verse eid="PSA 106:26"/><verse number="27" style="v" sid="PSA 106:27"/>tvístra afkomendum þeirra meðal þjóðanna og herleiða þá til annarra landa. <verse eid="PSA 106:27"/><verse number="28" style="v" sid="PSA 106:28"/>Og hjá Peór gengu forfeður okkar í lið með fylgjendum Baals og báru fram fórnir til dauðra skurðgoða. <verse eid="PSA 106:28"/><verse number="29" style="v" sid="PSA 106:29"/>Það reitti Drottin til reiði og þess vegna braust út plága meðal þeirra. <verse eid="PSA 106:29"/><verse number="30" style="v" sid="PSA 106:30"/>Hún hélst þar til Pínehas gekk fram og refsaði þeim sem henni höfðu valdið. <verse eid="PSA 106:30"/><verse number="31" style="v" sid="PSA 106:31"/>Hans verður ætíð minnst fyrir það réttlætisverk.<verse eid="PSA 106:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="PSA 106:32"/>Hjá Meríba reitti Ísrael Drottin aftur til reiði og olli Móse miklum vanda, <verse eid="PSA 106:32"/><verse number="33" style="v" sid="PSA 106:33"/>– hann reiddist og talaði ógætileg orð. <verse eid="PSA 106:33"/><verse number="34" style="v" sid="PSA 106:34"/>Og ekki útrýmdi Ísrael þjóðunum sem fyrir voru í landinu, eins og Guð hafði skipað þeim, <verse eid="PSA 106:34"/><verse number="35" style="v" sid="PSA 106:35"/>heldur blönduðust þeir heiðingjunum og tóku upp ósiði þeirra. <verse eid="PSA 106:35"/><verse number="36" style="v" sid="PSA 106:36"/>Þeir færðu skurðgoðum þeirra fórnir og leiddust burt frá Guði. <verse eid="PSA 106:36"/><verse number="37-38" style="v" pubnumber="37,38" sid="PSA 106:37-38"/> Þeir fórnuðu jafnvel börnum sínum til illra anda – til hjáguða Kanverja – úthelltu saklausu blóði og vanhelguðu landið með morðum. <verse eid="PSA 106:37-38"/><verse number="39" style="v" sid="PSA 106:39"/>Þeir saurguðust af illverkum þessum, því að með hjáguðadýrkun sinni rufu þeir trúnað við Guð. <verse eid="PSA 106:39"/><verse number="40" style="v" sid="PSA 106:40"/>Vegna alls þessa reiddist Drottinn Ísrael, lýð sínum, og fékk viðbjóð á honum, <verse eid="PSA 106:40"/><verse number="41-42" style="v" pubnumber="41,42" sid="PSA 106:41-42"/> og lét hann heiðnar þjóðir drottna yfir honum. Ísrael var stjórnað af óvinum sínum og þeir kúguðu hann.<verse eid="PSA 106:41-42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="PSA 106:43"/>Aftur og aftur leysti hann þá undan okinu, en þeir héldu áfram að óhlýðnast honum, uns syndir þeirra komu þeim á kné.<verse eid="PSA 106:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="PSA 106:44"/>Samt bænheyrði hann þá og linaði þjáningar þeirra. <verse eid="PSA 106:44"/><verse number="45" style="v" sid="PSA 106:45"/>Hann minntist loforðsins sem hann gaf þeim og aumkaðist yfir þá í elsku sinni, <verse eid="PSA 106:45"/><verse number="46" style="v" sid="PSA 106:46"/>svo að jafnvel þeir sem kúguðu þá, sýndu þeim miskunn.<verse eid="PSA 106:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="PSA 106:47"/>Ó, frelsaðu okkur, Drottinn Guð! Safnaðu okkur saman frá þjóðunum svo að við getum sameiginlega þakkað þér og lofað nafn þitt.<verse eid="PSA 106:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="PSA 106:48"/>Lofaður sé Drottinn, Guð Ísraels, frá eilífð til eilífðar. Og allt fólkið segi: „Amen!“ Hallelúja.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 107:1"/>Þakkið Drottni, því að hann er góður og miskunn hans varir að eilífu. <verse eid="PSA 107:1"/><verse number="2" style="v" sid="PSA 107:2"/>Hafi Drottinn frelsað þig, þá segðu frá því! Segðu öðrum frá því að hann hafi frelsað þig frá óvinum þínum.<verse eid="PSA 107:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 107:3"/>Hann leiddi hina útlægu heim frá ystu endimörkum jarðarinnar. <verse eid="PSA 107:3"/><verse number="4" style="v" sid="PSA 107:4"/>Þeir ráfuðu heimilislausir um eyðimörkina, <verse eid="PSA 107:4"/><verse number="5" style="v" sid="PSA 107:5"/>hungraðir og þyrstir og að niðurlotum komnir. <verse eid="PSA 107:5"/><verse number="6" style="v" sid="PSA 107:6"/>„Drottinn, hjálpaðu okkur!“ hrópuðu þeir, og hann svaraði bæn þeirra! <verse eid="PSA 107:6"/><verse number="7" style="v" sid="PSA 107:7"/>Hann leiddi þá í öruggt skjól, til byggilegrar borgar. <verse eid="PSA 107:7"/><verse number="8" style="v" sid="PSA 107:8"/>Ó, að þetta fólk vildi nú lofa Drottin fyrir miskunn hans og öll hans dásamlegu verk, <verse eid="PSA 107:8"/><verse number="9" style="v" sid="PSA 107:9"/>því að hann svalar þyrstri sál og mettar hungraðan gæðum.<verse eid="PSA 107:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 107:10"/>Hverjir eru þessir sem sitja í myrkri og skugga dauðans, þjáðir af eymd og volæði? <verse eid="PSA 107:10"/><verse number="11" style="v" sid="PSA 107:11"/>Þeir gerðu uppreisn gegn Drottni, fyrirlitu hann, hinn hæsta Guð. <verse eid="PSA 107:11"/><verse number="12" style="v" sid="PSA 107:12"/>Þess vegna beygði hann þá með mæðu. Þeir hrösuðu og enginn gat hjálpað þeim á fætur. <verse eid="PSA 107:12"/><verse number="13" style="v" sid="PSA 107:13"/>Þá hrópuðu þeir til Drottins í neyð sinni og hann bjargaði þeim! <verse eid="PSA 107:13"/><verse number="14" style="v" sid="PSA 107:14"/>Hann leiddi þá út úr myrkri og skugga dauðans og braut fjötra þeirra. <verse eid="PSA 107:14"/><verse number="15" style="v" sid="PSA 107:15"/>Þeir skulu lofa Drottin fyrir elsku hans og öll hans miskunnarverk! <verse eid="PSA 107:15"/><verse number="16" style="v" sid="PSA 107:16"/>Því að hann mölvaði hlið dýflissunnar og braut sundur rimlana.<verse eid="PSA 107:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 107:17"/>Sumir kölluðu yfir sig ógæfu með heimsku sinni. <verse eid="PSA 107:17"/><verse number="18" style="v" sid="PSA 107:18"/>Loks bauð þeim við öllum mat. Þeir sáu ekkert framundan nema dauðann. <verse eid="PSA 107:18"/><verse number="19" style="v" sid="PSA 107:19"/>Þá kölluðu þeir til Drottins í neyð sinni og hann bjargaði þeim úr angist þeirra, kom þeim á réttan veg. <verse eid="PSA 107:19"/><verse number="20" style="v" sid="PSA 107:20"/>Hann sendi út orð sitt og læknaði þá, hreif þá frá dyrum dauðans. <verse eid="PSA 107:20"/><verse number="21" style="v" sid="PSA 107:21"/>Ó, að menn þessir vildu lofa Drottin fyrir elsku hans og öll hans dásemdarverk! <verse eid="PSA 107:21"/><verse number="22" style="v" sid="PSA 107:22"/>Þeir þakki honum heilshugar og kunngjöri verk hans með gleði.<verse eid="PSA 107:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 107:23"/>Og svo eru þeir sem sigla um höfin, kaupmenn sem flytja vörur milli landa. <verse eid="PSA 107:23"/><verse number="24" style="v" sid="PSA 107:24"/>Einnig þeir fá að reyna máttarverk Drottins. <verse eid="PSA 107:24"/><verse number="25" style="v" sid="PSA 107:25"/>Hann kallar á storminn og lætur öldurnar rísa. <verse eid="PSA 107:25"/><verse number="26" style="v" sid="PSA 107:26"/>Skipin sveiflast til himins og hverfa í öldudali – öllum um borð fellst hugur í neyðinni. <verse eid="PSA 107:26"/><verse number="27" style="v" sid="PSA 107:27"/>Þeir ramba og skjögra eins og drukknir menn og vita ekki sitt rjúkandi ráð. <verse eid="PSA 107:27"/><verse number="28" style="v" sid="PSA 107:28"/>Þá hrópa þeir til Drottins í neyð sinni og hann frelsar þá. <verse eid="PSA 107:28"/><verse number="29" style="v" sid="PSA 107:29"/>Hann kyrrir bæði sjó og vind. <verse eid="PSA 107:29"/><verse number="30" style="v" sid="PSA 107:30"/>Hvílík blessun að ná höfn og njóta lognsins! <verse eid="PSA 107:30"/><verse number="31" style="v" sid="PSA 107:31"/>Ó, að þessir menn vildu þakka Drottni miskunn hans og öll hans dásemdarverk. <verse eid="PSA 107:31"/><verse number="32" style="v" sid="PSA 107:32"/>Þeir lofi hann upphátt í söfnuðinum og í áheyrn leiðtoga Ísraels.<verse eid="PSA 107:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="PSA 107:33"/>Hann þurrkar upp fljótin <verse eid="PSA 107:33"/><verse number="34" style="v" sid="PSA 107:34"/>og gerir land óguðlegra að skorpinni saltsléttu. <verse eid="PSA 107:34"/><verse number="35" style="v" sid="PSA 107:35"/>En hann kann líka að breyta auðninni í frjósama og vatnsríka vin. <verse eid="PSA 107:35"/><verse number="36" style="v" sid="PSA 107:36"/>Þangað leiðir hann hungraða sem setjast þar að og byggja sér borgir, <verse eid="PSA 107:36"/><verse number="37" style="v" sid="PSA 107:37"/>sá í akra, gróðursetja víngarða og afla afurða. <verse eid="PSA 107:37"/><verse number="38" style="v" sid="PSA 107:38"/>Þannig blessar hann! Og þeir margfaldast stórum og fénaði þeirra fjölgar.<verse eid="PSA 107:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="PSA 107:39"/>Sumir missa allt í ofsókn, þjáningu og sorg, <verse eid="PSA 107:39"/><verse number="40" style="v" sid="PSA 107:40"/>því að Guð sendir hrokafullum skömm og lætur tignarmenn ráfa um í rústum, <verse eid="PSA 107:40"/><verse number="41" style="v" sid="PSA 107:41"/>en hann bjargar fátæklingum sem honum treysta, gefur þeim fjölda afkomenda og mikla hagsæld. <verse eid="PSA 107:41"/><verse number="42" style="v" sid="PSA 107:42"/>Þetta sjá hinir guðhræddu og þeir gleðjast, meðan óguðlegir þegja í skömm.<verse eid="PSA 107:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="PSA 107:43"/>Þú sem ert vitur, hugleiddu þetta! Hugsaðu um miskunn og kærleika Drottins.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 108:1-2"/> Ó, Guð, nú vil ég lofa þig! Ég vil syngja og fagna frammi fyrir þér.<verse eid="PSA 108:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 108:3"/>Vaknaðu, harpa og gígja! Við viljum bjóða morgunroðann velkominn með söng! <verse eid="PSA 108:3"/><verse number="4" style="v" sid="PSA 108:4"/>Ég vil lofa þig um víða veröld, Drottinn, vegsama þig hjá hverri þjóð. <verse eid="PSA 108:4"/><verse number="5" style="v" sid="PSA 108:5"/>Því að miskunn þín nær til skýjanna og trúfesti þín er ómælanleg! <verse eid="PSA 108:5"/><verse number="6" style="v" sid="PSA 108:6"/>Láttu tign þína og mátt birtast og dýrð þína breiðast yfir jörðina. <verse eid="PSA 108:6"/><verse number="7" style="v" sid="PSA 108:7"/>Hlustaðu á ákall vina þinna og bjargaðu þeim með krafti þínum, já, bænheyrðu þá.<verse eid="PSA 108:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 108:8"/>Fögnum og gleðjumst því að við höfum fengið loforð frá Guði! Hann hefur lofað að gefa okkur Síkemland og Súkkótdal. <verse eid="PSA 108:8"/><verse number="9" style="v" sid="PSA 108:9"/>„Ég á Gíleað, ég á Manasse og Efraím er hjálmurinn á höfði mínu. Júda er veldissproti minn <verse eid="PSA 108:9"/><verse number="10" style="v" sid="PSA 108:10"/>en Móab og Edóm fyrirlít ég og yfir Filisteu æpi ég siguróp.“<verse eid="PSA 108:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 108:11"/>Hver nema Guð getur veitt mér styrk til að sigrast á víggirtum borgum? Hver nema hann getur opnað mér leið inn í Edóm?<verse eid="PSA 108:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 108:12"/>Drottinn, hefur þú útskúfað okkur? Hefur þú gert her okkar óvígan? <verse eid="PSA 108:12"/><verse number="13" style="v" sid="PSA 108:13"/>Ó, veittu okkur lið gegn óvinum okkar, því að mannahjálp er gagnslaus. <verse eid="PSA 108:13"/><verse number="14" style="v" sid="PSA 108:14"/>Með hjálp Guðs munum við vinna hetjudáð og hann mun gjörsigra óvini okkar.<verse eid="PSA 108:14"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 109:1"/>Þú Guð sem ég lofa, vertu ekki þögull <verse eid="PSA 109:1"/><verse number="2" style="v" sid="PSA 109:2"/>því að óguðlegir baktala mig og ljúga á mig sökum. <verse eid="PSA 109:2"/><verse number="3" style="v" sid="PSA 109:3"/>Án saka hata þeir mig og ráðast á mig. <verse eid="PSA 109:3"/><verse number="4" style="v" sid="PSA 109:4"/>Ég elska þá, en jafnvel meðan ég bið fyrir þeim, ofsækja þeir mig. <verse eid="PSA 109:4"/><verse number="5" style="v" sid="PSA 109:5"/>Þeir gjalda gott með illu og ást mína með hatri.<verse eid="PSA 109:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 109:6"/>Leyfðu þeim að finna hvernig mér líður! Leyfðu óvini mínum að þola sama óréttlæti og hann beitir mig – vera dæmdur af ranglátum dómara. <verse eid="PSA 109:6"/><verse number="7" style="v" sid="PSA 109:7"/>Og þegar úrskurður fellur, lát hann þá verða honum til tjóns. Líttu á bænir hans eins og innantómt raus. <verse eid="PSA 109:7"/><verse number="8" style="v" sid="PSA 109:8"/>Styttu æviár hans. Skipaðu annan í embætti hans. <verse eid="PSA 109:8"/><verse number="9-10" style="v" pubnumber="9,10" sid="PSA 109:9-10"/> Börn hans verði föðurlaus og kona hans ekkja og rektu þau burt úr rústum heimilis þeirra. <verse eid="PSA 109:9-10"/><verse number="11" style="v" sid="PSA 109:11"/>Lánardrottnarnir taki landareign hans og ókunnugir fái allt sem hann hafði aflað. <verse eid="PSA 109:11"/><verse number="12-13" style="v" pubnumber="12,13" sid="PSA 109:12-13"/> Enginn sýni honum miskunn né aumki sig yfir föðurlausu börnin hans. Afkomendur hans verði afmáðir og ætt hans eins og hún leggur sig. <verse eid="PSA 109:12-13"/><verse number="14" style="v" sid="PSA 109:14"/>Refsaðu fyrir syndir föður hans og móður og dragðu ekki af. <verse eid="PSA 109:14"/><verse number="15" style="v" sid="PSA 109:15"/>Láttu misgjörðir hans aldrei falla í gleymsku, en minningu ættarinnar að engu verða.<verse eid="PSA 109:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 109:16"/>Hann sýndi engum manni miskunn, en ofsótti nauðstadda og steypti aðþrengdum í dauðann. <verse eid="PSA 109:16"/><verse number="17" style="v" sid="PSA 109:17"/>Hann formælti öðrum, bölvunin komi honum sjálfum í koll. Að blessa lét hann ógert, blessun sé því fjarri honum. <verse eid="PSA 109:17"/><verse number="18" style="v" sid="PSA 109:18"/>Að bölva, það átti við hann, það var honum eðlilegt eins og að éta og drekka.<verse eid="PSA 109:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 109:19"/>Formælingar hans bitni á honum sjálfum, hylji hann, eins og fötin sem hann er í og beltið um mitti hans. <verse eid="PSA 109:19"/><verse number="20" style="v" sid="PSA 109:20"/>Þetta séu laun andstæðinga minna frá Drottni – þeirra sem ljúga á mig og hóta mér dauða.<verse eid="PSA 109:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 109:21"/>En Drottinn, farðu með mig eins og barnið þitt! Eins og þann sem ber þitt eigið nafn. Frelsaðu mig Drottinn, vegna elsku þinnar.<verse eid="PSA 109:21"/></para>
  <para style="p">
    <verse number="22-23" style="v" pubnumber="22,23" sid="PSA 109:22-23"/> Það hallar undan fæti, ég finn að dauðinn nálgast. Ég er hristur til jarðar eins og padda af ermi! <verse eid="PSA 109:22-23"/><verse number="24" style="v" sid="PSA 109:24"/>Ég skelf í hnjánum – fastan var erfið, ég er ekkert nema skinn og bein. <verse eid="PSA 109:24"/><verse number="25" style="v" sid="PSA 109:25"/>Ég er eins og minnisvarði um mistök og þegar menn sjá mig hrista þeir höfuðið.<verse eid="PSA 109:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="PSA 109:26"/>Hjálpaðu mér Drottinn Guð minn! Frelsaðu mig sakir elsku þinnar og kærleika. <verse eid="PSA 109:26"/><verse number="27" style="v" sid="PSA 109:27"/>Gerðu það svo að allir sjái, svo að enginn efist um að það var þitt verk, <verse eid="PSA 109:27"/><verse number="28" style="v" sid="PSA 109:28"/>– þá mega þeir formæla mér ef þeir vilja, sama er mér, aðeins að þú blessir mig. Þá munu illráð þeirra gegn mér mistakast og ég ganga mína leið, glaður í bragði.<verse eid="PSA 109:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="PSA 109:29"/>Ónýttu áform þeirra! Sveipaðu þá skömm! <verse eid="PSA 109:29"/><verse number="30" style="v" sid="PSA 109:30"/>Þá mun ég ekki láta af að þakka Drottni, lofa hann í allra áheyrn. <verse eid="PSA 109:30"/><verse number="31" style="v" sid="PSA 109:31"/>Því að hann er athvarf fátækra og þeirra sem líða skort. Hann frelsar þá undan óvinum þeirra.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 110:1"/>Guð sagði við minn Drottin – við Krist: „Þú skalt ráða og ríkja mér við hlið. Ég mun sigra óvini þína og láta þá þjóna þér.“<verse eid="PSA 110:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 110:2"/>Guð hefur reist þér hásæti í Jerúsalem og þaðan muntu drottna yfir óvinum þínum. <verse eid="PSA 110:2"/><verse number="3" style="v" sid="PSA 110:3"/>Þegar konungsvald þitt verður lýðum ljóst, mun þjóð þín flýta sér á þinn fund og æskufólk þitt íklæðast helgum skrúða. Eins og döggin er ný á hverjum morgni, eins mun styrkur minn endurnýjast dag eftir dag. <verse eid="PSA 110:3"/><verse number="4" style="v" sid="PSA 110:4"/>Guð hefur unnið mér eið – og hann iðrast þess ekki – að þú ert prestur að eilífu að hætti Melkísedeks. <verse eid="PSA 110:4"/><verse number="5" style="v" sid="PSA 110:5"/>Guð er þér til hægri handar til að vernda þig. Þegar reiðidómur hans verður birtur mun hann fella marga konunga til jarðar. <verse eid="PSA 110:5"/><verse number="6" style="v" sid="PSA 110:6"/>Hann mun refsa þjóðunum, lík þeirra munu liggja út um allt. Hann mun mölva höfuð þeirra. <verse eid="PSA 110:6"/><verse number="7" style="v" sid="PSA 110:7"/>Á leiðinni drekkur hann úr lindinni við veginn og ber höfuðið hátt.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 111:1-2"/> Hallelúja! Ég þakka Guði máttarverk hans, já, í áheyrn og augsýn allrar þjóðarinnar. Allir sem vilja, íhugi þetta ásamt mér. <verse eid="PSA 111:1-2"/><verse number="3" style="v" sid="PSA 111:3"/>Því að máttarverkin lýsa mikilleika hans, hátign og eilífum kærleika.<verse eid="PSA 111:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 111:4"/>Hver getur gleymt dásemdarverkum hans, miskunn hans? <verse eid="PSA 111:4"/><verse number="5" style="v" sid="PSA 111:5"/>Hann annast þarfir þeirra sem honum treysta og gleymir ekki loforðum sínum. <verse eid="PSA 111:5"/><verse number="6" style="v" sid="PSA 111:6"/>Hann sýndi mátt sinn er hann gaf þjóð sinni landið Ísrael – land sem margar þjóðir byggðu. <verse eid="PSA 111:6"/><verse number="7" style="v" sid="PSA 111:7"/>Allt gerir hann af trúfesti og réttlæti og öll fyrirmæli hans eru áreiðanleg og góð, <verse eid="PSA 111:7"/><verse number="8" style="v" sid="PSA 111:8"/>gefin í kærleika og af réttvísi – þau munu standa að eilífu. <verse eid="PSA 111:8"/><verse number="9" style="v" sid="PSA 111:9"/>Hann hefur frelsað þjóð sína og gert við hana eilífan sáttmála. Heilagt og óttalegt er nafn Drottins.<verse eid="PSA 111:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 111:10"/>Hvernig öðlast menn visku? Með því fyrst að óttast og heiðra Guð og síðan með því að halda lög hans. Lofað sé nafn hans að eilífu.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 112:1"/>Dýrð sé Guði! Að trúa á Guð og treysta honum veitir ómælda blessun. Sæll er sá maður sem hefur unun af boðorðum hans.<verse eid="PSA 112:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 112:2"/>Börn hans njóta hvarvetna heiðurs, því að góður arfur eflir göfugan mann. <verse eid="PSA 112:2"/><verse number="3" style="v" sid="PSA 112:3"/>Sjálfur býr hann við auðlegð og góðverk hans gleymast ekki. <verse eid="PSA 112:3"/><verse number="4" style="v" sid="PSA 112:4"/>Réttlátum er hann ljós í myrkri – miskunn hans og gæska eru augljós. <verse eid="PSA 112:4"/><verse number="5" style="v" sid="PSA 112:5"/>Sá mun blessun hljóta sem er góðgjarn og fús að lána og framkvæmir verk sín með réttvísi.<verse eid="PSA 112:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 112:6"/>Slíkur maður verður ekki fórnarlamb illra atvika. Umhyggja Guðs fyrir honum verður umræðuefni þeirra sem þekkja hann. <verse eid="PSA 112:6"/><verse number="7" style="v" sid="PSA 112:7"/>Hann óttast ekki vondar fréttir, né kvíðir því sem koma skal. Hann er öruggur og veit að Drottinn annast hann. <verse eid="PSA 112:7"/><verse number="8" style="v" sid="PSA 112:8"/>Þess vegna óttast hann ekkert og horfir á óvini sína með stakri ró. <verse eid="PSA 112:8"/><verse number="9" style="v" sid="PSA 112:9"/>Hann hefur miðlað mildilega og gefið fátækum. Góðverk hans munu ekki gleymast. Hann mun njóta vinsælda og hafa áhrif.<verse eid="PSA 112:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 112:10"/>Þetta sjá óguðlegir og þeim gremst. Þeir munu gnísta tönnum og tortímast og óskir þeirra rætast ekki.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 113:1"/>Hallelúja! Þið þjónar Drottins, lofið nafn hans. <verse eid="PSA 113:1"/><verse number="2" style="v" sid="PSA 113:2"/>Lofað sé nafn hans um aldur og ævi! <verse eid="PSA 113:2"/><verse number="3" style="v" sid="PSA 113:3"/>Vegsamið hann frá sólarupprás til sólarlags! <verse eid="PSA 113:3"/><verse number="4" style="v" sid="PSA 113:4"/>Því að hann er hátt upphafinn yfir þjóðirnar og dýrð hans er himnunum hærri.<verse eid="PSA 113:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 113:5"/>Hver kemst í samjöfnuð við Guð hinn hæsta? <verse eid="PSA 113:5"/><verse number="6" style="v" sid="PSA 113:6"/>Hann situr hátt og horfir niður á himin og jörð. <verse eid="PSA 113:6"/><verse number="7" style="v" sid="PSA 113:7"/>Hann reisir hinn fátæka úr skítnum, leiðir hinn hungraða frá sorphaugnum <verse eid="PSA 113:7"/><verse number="8" style="v" sid="PSA 113:8"/>og fær þeim sæti með tignarmönnum! <verse eid="PSA 113:8"/><verse number="9" style="v" sid="PSA 113:9"/>Fyrir hans hjálp verður hún hamingjusöm móðir – konan sem ekki gat fætt manni sínum börn. Hallelúja! Lof sé Drottni!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 114:1"/>Í árdaga, þegar Ísraelsmenn flúðu Egyptaland, land hinnar framandi tungu, <verse eid="PSA 114:1"/><verse number="2" style="v" sid="PSA 114:2"/>varð Júda og Ísrael bústaður Guðs og ríki hans.<verse eid="PSA 114:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 114:3"/>Hafið rauða sá þá koma og hopaði. Og áin Jórdan, hún stöðvaðist svo að þeir gátu gengið yfir. <verse eid="PSA 114:3"/><verse number="4" style="v" sid="PSA 114:4"/>Fjöllin hoppuðu eins og hrútar og hæðirnar sem lömb! <verse eid="PSA 114:4"/><verse number="5" style="v" sid="PSA 114:5"/>Hvað olli því, þú rauða haf, að þú hopaðir til beggja hliða? Og hvers vegna, áin Jórdan, stöðvaðist rennsli þitt? <verse eid="PSA 114:5"/><verse number="6" style="v" sid="PSA 114:6"/>Og þið fjöll, hvers vegna hoppið þið eins og hrútar og þið hæðir sem lömb?<verse eid="PSA 114:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 114:7"/>Nötra þú jörð frammi fyrir augliti Drottins, Guðs Jakobs, <verse eid="PSA 114:7"/><verse number="8" style="v" sid="PSA 114:8"/>því að hann lét uppsprettu opnast á klettinum.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 115:1"/>Drottinn, gefðu ekki okkur, heldur þínu nafni dýrðina. Gefðu að allir vegsami þig vegna miskunnar þinnar og trúfesti. <verse eid="PSA 115:1"/><verse number="2" style="v" sid="PSA 115:2"/>Hvers vegna leyfir þú heiðingjunum að segja: „Guð þeirra er ekki til!“<verse eid="PSA 115:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 115:3"/>Guð er á himnum og hann gerir það sem hann vill. <verse eid="PSA 115:3"/><verse number="4" style="v" sid="PSA 115:4"/>Guðir heiðingjanna eru mannaverk, smíðisgripir úr silfri og gulli.<verse eid="PSA 115:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 115:5"/>Þeir hvorki tala né sjá, en hafa þó bæði munn og augu! <verse eid="PSA 115:5"/><verse number="6" style="v" sid="PSA 115:6"/>Þeir heyra ekki, finna enga lykt <verse eid="PSA 115:6"/><verse number="7" style="v" sid="PSA 115:7"/>og hreyfa hvorki legg né lið! Þeir geta ekki sagt eitt einasta orð! <verse eid="PSA 115:7"/><verse number="8" style="v" sid="PSA 115:8"/>Smiðirnir sem þau gera og tilbiðja, eru engu gáfaðri en þau!<verse eid="PSA 115:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 115:9"/>Ísrael, treystu Drottni! Hann er hjálpari þinn, hann er skjöldur þinn. <verse eid="PSA 115:9"/><verse number="10" style="v" sid="PSA 115:10"/>Þið prestar af Aronsætt, treystið Drottni! Hann er ykkar hjálp og hlíf. <verse eid="PSA 115:10"/><verse number="11" style="v" sid="PSA 115:11"/>Þú lýður hans, þið öll, yngri sem eldri, treystið honum. Hann er hjálp og skjöldur.<verse eid="PSA 115:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 115:12"/>Drottinn mun ekki gleyma okkur og hann blessar okkur öll. Hann blessar Ísraels fólk og prestana af Arons ætt, <verse eid="PSA 115:12"/><verse number="13" style="v" sid="PSA 115:13"/>já, alla, bæði háa og lága – þá sem óttast hann.<verse eid="PSA 115:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 115:14"/>Drottinn blessi þig og börnin þín. <verse eid="PSA 115:14"/><verse number="15" style="v" sid="PSA 115:15"/>Drottinn, hann sem skapaði himin og jörð, mun blessa þig – já, þig! <verse eid="PSA 115:15"/><verse number="16" style="v" sid="PSA 115:16"/>Himinninn tilheyrir Drottni, en jörðina gaf hann mönnunum.<verse eid="PSA 115:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 115:17"/>Ekki geta andaðir menn lofað Drottin hér á jörðu, <verse eid="PSA 115:17"/><verse number="18" style="v" sid="PSA 115:18"/>en það getum við! Við lofum hann að eilífu! Hallelúja! Lof sé Drottni!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 116:1"/>Ég elska Drottin, því að hann heyrir bænir mínar – og svarar þeim. <verse eid="PSA 116:1"/><verse number="2" style="v" sid="PSA 116:2"/>Meðan ég dreg andann mun ég biðja til hans, því að hann lítur niður og hlustar á mig.<verse eid="PSA 116:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 116:3"/>Ég horfðist í augu við dauðann – var hræddur og hnípinn. <verse eid="PSA 116:3"/><verse number="4" style="v" sid="PSA 116:4"/>Þá hvíslaði ég: „Drottinn, frelsaðu mig!“ <verse eid="PSA 116:4"/><verse number="5" style="v" sid="PSA 116:5"/>Náðugur er Drottinn og góður er hann! <verse eid="PSA 116:5"/><verse number="6" style="v" sid="PSA 116:6"/>Drottinn hlífir vondaufum og styrkir hjálparvana. <verse eid="PSA 116:6"/><verse number="7" style="v" sid="PSA 116:7"/>Nú get ég slakað á og verið rór, því að Drottinn hefur gert mikla hluti fyrir mig. <verse eid="PSA 116:7"/><verse number="8" style="v" sid="PSA 116:8"/>Hann hefur bjargað mér frá dauða, augum mínum frá gráti og fótum mínum frá hrösun. <verse eid="PSA 116:8"/><verse number="9" style="v" sid="PSA 116:9"/>Ég fæ að lifa! Já, lifa með honum hér á jörðu!<verse eid="PSA 116:9"/></para>
  <para style="p">
    <verse number="10-11" style="v" pubnumber="10,11" sid="PSA 116:10-11"/> Þegar ég átti erfitt hugsaði ég: Þeir segja ósatt, að allt muni snúast mér í hag. <verse eid="PSA 116:10-11"/><verse number="12" style="v" sid="PSA 116:12"/>En nú, hvernig get ég nú endurgoldið Drottni góðverk hans við mig? <verse eid="PSA 116:12"/><verse number="13" style="v" sid="PSA 116:13"/>Ég vil lyfta bikarnum og vínberjalegi að fórn, þakka honum lífið. <verse eid="PSA 116:13"/><verse number="14" style="v" sid="PSA 116:14"/>Fórnina sem ég lofaði Drottni, færi ég nú í allra augsýn. <verse eid="PSA 116:14"/><verse number="15" style="v" sid="PSA 116:15"/>Hann elskar vini sína og lætur þá ekki deyja án gildrar ástæðu.<verse eid="PSA 116:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 116:16"/>Drottinn, þú hefur leyst fjötra mína, því vil ég þjóna þér af öllu hjarta. <verse eid="PSA 116:16"/><verse number="17" style="v" sid="PSA 116:17"/>Ég vil lofa þig og færa þér þakkarfórn. <verse eid="PSA 116:17"/><verse number="18-19" style="v" pubnumber="18,19" sid="PSA 116:18-19"/> Í forgörðum musteris Drottins í Jerúsalem vil ég – og það í augsýn allra – færa honum allt sem ég hafði lofað. Dýrð sé Drottni!<verse eid="PSA 116:18-19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 117:1"/>Lofið Drottin allar þjóðir. Vegsamið hann allir lýðir. <verse eid="PSA 117:1"/><verse number="2" style="v" sid="PSA 117:2"/>Miskunn hans er mikil og trúfesti hans varir að eilífu. Lofaður sé Drottinn!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 118:1"/>Þakkið Drottni því að hann er góður! Elska hans varir að eilífu. <verse eid="PSA 118:1"/><verse number="2" style="v" sid="PSA 118:2"/>Söfnuður Ísraels lofi hann og segi: „Elska hans varir að eilífu!“ <verse eid="PSA 118:2"/><verse number="3" style="v" sid="PSA 118:3"/>Og prestar Arons taki undir og syngi: „Elska hans varir að eilífu!“ <verse eid="PSA 118:3"/><verse number="4" style="v" sid="PSA 118:4"/>Og heiðingjarnir sem trú hafa tekið segi: „Elska hans varir að eilífu.“<verse eid="PSA 118:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 118:5"/>Í angist minni bað ég til Drottins. Hann svaraði mér og frelsaði mig. <verse eid="PSA 118:5"/><verse number="6" style="v" sid="PSA 118:6"/>Ég er hans! Hvað skyldi ég þá óttast? Hvað geta dauðlegir menn gert mér? <verse eid="PSA 118:6"/><verse number="7" style="v" sid="PSA 118:7"/>Ég er vinur Drottins og hann hjálpar mér. Óvinir mínir skulu vara sig!<verse eid="PSA 118:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 118:8"/>Betra er að treysta Drottni, en að reiða sig á menn. <verse eid="PSA 118:8"/><verse number="9" style="v" sid="PSA 118:9"/>Öruggara er að leita hjálpar hans en stuðnings frá voldugum konungi!<verse eid="PSA 118:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 118:10"/>Þó óvinaþjóðirnar ráðist gegn mér, allar sem ein, þá mun ég ganga fram undir gunnfána hans og gjöreyða þeim. <verse eid="PSA 118:10"/><verse number="11" style="v" sid="PSA 118:11"/>Já, þær umkringja mig og gera árás, en ég útrými þeim undir sigurmerki hans. <verse eid="PSA 118:11"/><verse number="12" style="v" sid="PSA 118:12"/>Þær þyrpast að mér eins og flugnager, blossa gegn mér sem eyðandi eldur. En undir fána hans gjörsigra ég þá!<verse eid="PSA 118:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 118:13"/>Þú, óvinur minn, gerðir allt til að útrýma mér, en Drottinn kom mér til hjálpar. <verse eid="PSA 118:13"/><verse number="14" style="v" sid="PSA 118:14"/>Þegar orustan stóð sem hæst var hann styrkur minn og lofsöngur og að endingu veitti hann mér sigur.<verse eid="PSA 118:14"/></para>
  <para style="p">
    <verse number="15-16" style="v" pubnumber="15,16" sid="PSA 118:15-16"/> Á heimilum réttlátra syngja menn fagnaðarljóð, enda nýkomnar fréttir af sigri! <verse eid="PSA 118:15-16"/><verse number="17" style="v" sid="PSA 118:17"/>Ekki mun ég deyja, heldur lifa og segja öllum frá máttarverkum hans. <verse eid="PSA 118:17"/><verse number="18" style="v" sid="PSA 118:18"/>Drottinn refsaði mér, en ofurseldi mig ekki dauðanum.<verse eid="PSA 118:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 118:19"/>Ljúkið upp hliðum musterisins – ég ætla að ganga inn og þakka Drottni. <verse eid="PSA 118:19"/><verse number="20" style="v" sid="PSA 118:20"/>Um þessi hlið liggur leiðin til Drottins og réttlátir ganga þar inn. <verse eid="PSA 118:20"/><verse number="21" style="v" sid="PSA 118:21"/>Ó, Drottinn, þökk sé þér að þú bænheyrðir og bjargaðir mér.<verse eid="PSA 118:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PSA 118:22"/>Steinninn sem smiðirnir höfðu hafnað var gerður að hornsteini hússins! <verse eid="PSA 118:22"/><verse number="23" style="v" sid="PSA 118:23"/>Það var að vilja og fyrir tilstilli Drottins og er í einu orði sagt stórkostlegt! <verse eid="PSA 118:23"/><verse number="24" style="v" sid="PSA 118:24"/>Þetta er dagurinn sem Drottinn hefur gert. Fögnum og verum glöð í dag! <verse eid="PSA 118:24"/><verse number="25" style="v" sid="PSA 118:25"/>Ó, Drottinn, hjálpa þú. Frelsa þú okkur. Láttu okkur ná árangri. <verse eid="PSA 118:25"/><verse number="26" style="v" sid="PSA 118:26"/>Blessaður sé sá sem er að koma, sá sem sendur er af Drottni. Við blessum þig frá helgidóminum.<verse eid="PSA 118:26"/></para>
  <para style="p">
    <verse number="27-28" style="v" pubnumber="27,28" sid="PSA 118:27-28"/> Drottinn er ljósið sem lýsir okkur. Dansið fyrir honum, já, alla leiðina að altari hans. Hann er minn Guð, ég þakka honum og lofa hann. <verse eid="PSA 118:27-28"/><verse number="29" style="v" sid="PSA 118:29"/>Þakkið Drottni, því að hann er góður! Miskunn hans varir að eilífu!<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 119:1"/>Sælir eru þeir sem breyta í öllu eftir lögum Guðs. <verse eid="PSA 119:1"/><verse number="2" style="v" sid="PSA 119:2"/>Sælir eru þeir sem leita Guðs og gera vilja hans í hvívetna, <verse eid="PSA 119:2"/><verse number="3" style="v" sid="PSA 119:3"/>þeir sem hafna málamiðlun við hið illa og ganga heilshugar á Guðs vegum. <verse eid="PSA 119:3"/><verse number="4" style="v" sid="PSA 119:4"/>Þú, Drottinn, gafst okkur lög þín til þess að við hlýddum þeim <verse eid="PSA 119:4"/><verse number="5" style="v" sid="PSA 119:5"/>– ó, hve ég þrái að breyta grandvarlega eftir þeim. <verse eid="PSA 119:5"/><verse number="6" style="v" sid="PSA 119:6"/>Þá verð ég ekki til skammar, heldur hef hreinan skjöld.<verse eid="PSA 119:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 119:7"/>Ég vil þakka þér leiðsögn þína og réttláta ögun, það hefur kennt mér að lifa lífinu rétt! <verse eid="PSA 119:7"/><verse number="8" style="v" sid="PSA 119:8"/>Ég vil vera þér hlýðinn! Og þá veit ég að þú munt alls ekki yfirgefa mig.<verse eid="PSA 119:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 119:9"/>Hvernig getur ungt fólk lifað hreinu lífi? Með því að hlusta á orð þín og fara eftir þeim. <verse eid="PSA 119:9"/><verse number="10" style="v" sid="PSA 119:10"/>Ég leitaði þín af öllu hjarta – láttu mig ekki villast burt frá boðum þínum. <verse eid="PSA 119:10"/><verse number="11" style="v" sid="PSA 119:11"/>Ég hef íhugað orð þín af kostgæfni og varðveitt þau í hjarta mínu svo að þau verndi mig frá því að syndga.<verse eid="PSA 119:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 119:12"/>Lof sé þér Drottinn, kenndu mér lög þín. <verse eid="PSA 119:12"/><verse number="13" style="v" sid="PSA 119:13"/>Ég fer með lög þín upphátt <verse eid="PSA 119:13"/><verse number="14" style="v" sid="PSA 119:14"/>– þau veita mér meiri gleði en mikil auðæfi.<verse eid="PSA 119:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 119:15"/>Ég vil íhuga þau og hafa þau í heiðri. <verse eid="PSA 119:15"/><verse number="16" style="v" sid="PSA 119:16"/>Ég gleðst yfir þeim og gleymi þeim ekki.<verse eid="PSA 119:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 119:17"/>Leyfðu mér að lifa langa ævi, og læra að hlýða þér meir og meir. <verse eid="PSA 119:17"/><verse number="18" style="v" sid="PSA 119:18"/>Opnaðu augu mín svo að ég sjái dásemdirnar í orði þínu. <verse eid="PSA 119:18"/><verse number="19" style="v" sid="PSA 119:19"/>Ég er pílagrímur hér á jörðu – mikið vantar mig leiðsögn! Boðorð þín eru mér bæði leiðsögn og kort! <verse eid="PSA 119:19"/><verse number="20" style="v" sid="PSA 119:20"/>Ég þrái fyrirmæli þín meira en orð fá lýst!<verse eid="PSA 119:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 119:21"/>Ávítaðu þá sem hafna boðum þínum. Þeir hafa kallað bölvun yfir sig. <verse eid="PSA 119:21"/><verse number="22" style="v" sid="PSA 119:22"/>Láttu það ekki viðgangast að þeir spotti mig fyrir að hlýða þér. <verse eid="PSA 119:22"/><verse number="23" style="v" sid="PSA 119:23"/>Jafnvel þjóðhöfðingjar hallmæla mér, en samt vil ég halda lög þín. <verse eid="PSA 119:23"/><verse number="24" style="v" sid="PSA 119:24"/>Lögmál þitt er mér bæði ljós og leiðsögn.<verse eid="PSA 119:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 119:25"/>Ég er bugaður maður, alveg kominn á kné. Lífgaðu mig með orði þínu! <verse eid="PSA 119:25"/><verse number="26" style="v" sid="PSA 119:26"/>Ég sagði þér áform mín og þú svaraðir mér. Skýrðu nú fyrir mér leiðsögn þína, <verse eid="PSA 119:26"/><verse number="27" style="v" sid="PSA 119:27"/>svo að ég skilji hvað þú vilt og upplifi dásemdir þínar.<verse eid="PSA 119:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="PSA 119:28"/>Ég græt af hryggð, hjarta mitt er bugað af sorg. Uppörvaðu mig og lífga með orðum þínum. <verse eid="PSA 119:28"/><verse number="29-30" style="v" pubnumber="29,30" sid="PSA 119:29-30"/> Leiddu mig burt frá öllu illu. Hjálpaðu mér, óverðugum, að hlýða lögum þínum, því að ég hef valið að gera rétt. <verse eid="PSA 119:29-30"/><verse number="31" style="v" sid="PSA 119:31"/>Ég held mér við boðorð þín og hlýði þeim vandlega. Drottinn, forðaðu mér frá öllu rugli. <verse eid="PSA 119:31"/><verse number="32" style="v" sid="PSA 119:32"/>Ég vil kappkosta að fara eftir lögum þínum, því að þú hefur gert mig glaðan í sinni.<verse eid="PSA 119:32"/></para>
  <para style="p">
    <verse number="33-34" style="v" pubnumber="33,34" sid="PSA 119:33-34"/> Segðu mér, Drottinn, hvað mér ber að gera og þá mun ég gera það. Ég vil hlýða þér af heilum hug svo lengi sem ég lifi. <verse eid="PSA 119:33-34"/><verse number="35" style="v" sid="PSA 119:35"/>Ó, leiddu mig um réttan veg, – því hvað er betra en það?!<verse eid="PSA 119:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="PSA 119:36"/>Gefðu að ég hlýði reglum þínum, en leiti ekki eftir rangfengnum gróða. <verse eid="PSA 119:36"/><verse number="37" style="v" sid="PSA 119:37"/>Snúðu huga mínum frá öllu öðru en því að fylgja þér. Lífgaðu mig, hresstu mig, svo að ég geti horft til þín.<verse eid="PSA 119:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="PSA 119:38"/>Minntu mig á það aftur og aftur að fyrirheit þín gilda fyrir mig! Já, ég treysti þér, heiðra þig og óttast!<verse eid="PSA 119:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="PSA 119:39"/>Þaggaðu niður háðið og spottið sem beint er að mér, því að lög þín eru góð og þeim fylgi ég. <verse eid="PSA 119:39"/><verse number="40" style="v" sid="PSA 119:40"/>Ég þrái að hlýða þeim. Þess vegna, Drottinn, lífgaðu mig við!<verse eid="PSA 119:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="PSA 119:41"/>Þú lofaðir að frelsa mig! Miskunna mér nú í kærleika þínum, <verse eid="PSA 119:41"/><verse number="42" style="v" sid="PSA 119:42"/>og þá mun ég geta svarað þeim sem spotta mig, því að orðum þínum treysti ég.<verse eid="PSA 119:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="PSA 119:43"/>Gef að ég gleymi aldrei orðum þínum og treysti alltaf þínum réttláta úrskurði. <verse eid="PSA 119:43"/><verse number="44-46" style="v" sid="PSA 119:44-46"/>Þess vegna vil ég hlýða þér um aldur og ævi og njóta þess frelsis sem lög þín veita. Ég mun fræða konunga um gildi þeirra og þeir munu hlusta af áhuga og virðingu.<verse eid="PSA 119:44-46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="PSA 119:47"/>Ég elska lög þín! Ég gleðst yfir boðum þínum! <verse eid="PSA 119:47"/><verse number="48" style="v" sid="PSA 119:48"/>„Komið, komið til mín!“ segi ég við þau; því að ég elska þau og þrái að íhuga þau.<verse eid="PSA 119:48"/></para>
  <para style="p">
    <verse number="49-50" style="v" pubnumber="49,50" sid="PSA 119:49-50"/> Drottinn, gleymdu ekki fyrirheitum þeim sem þú gafst mér, þjóni þínum, – þau eru það sem ég treysti á. Þau eru styrkur minn þegar á móti blæs – þau hressa mig og lífga! <verse eid="PSA 119:49-50"/><verse number="51" style="v" sid="PSA 119:51"/>Ofstopamenn spotta mig fyrir hlýðni mína við Guð, en ég læt ekki haggast. <verse eid="PSA 119:51"/><verse number="52" style="v" sid="PSA 119:52"/>Allt frá því ég var barn hef ég leitast við að hlýða þér, orð þín hafa verið mér huggun.<verse eid="PSA 119:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="PSA 119:53"/>Ég reiðist hinum óguðlegu, þeim sem hafna og fyrirlíta lög þín. <verse eid="PSA 119:53"/><verse number="54" style="v" sid="PSA 119:54"/>Því að þessi lög hafa verið uppspretta gleði minnar alla ævi. <verse eid="PSA 119:54"/><verse number="55" style="v" sid="PSA 119:55"/>Um nætur hugsa ég til þín Drottinn og minnist laga þinna. <verse eid="PSA 119:55"/><verse number="56" style="v" sid="PSA 119:56"/>Það hefur veitt mér mikla blessun að halda fyrirmæli þín.<verse eid="PSA 119:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="PSA 119:57"/>Drottinn, þú ert minn og ég hef ákveðið að hlýða orðum þínum. <verse eid="PSA 119:57"/><verse number="58" style="v" sid="PSA 119:58"/>Ég þrái blessun þína af öllu hjarta. Miskunna mér eins og þú lofaðir mér. <verse eid="PSA 119:58"/><verse number="59-60" style="v" pubnumber="59,60" sid="PSA 119:59-60"/> Þegar ég sá að ég var á rangri leið, snéri ég við og flýtti mér aftur til þín. <verse eid="PSA 119:59-60"/><verse number="61" style="v" sid="PSA 119:61"/>Óguðlegir menn hafa reynt að tæla mig til syndar, en ég er staðráðinn í að hlýða lögum þínum.<verse eid="PSA 119:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="PSA 119:62"/>Um miðnætti rís ég upp og þakka þér þín réttlátu ákvæði.<verse eid="PSA 119:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="PSA 119:63"/>Sá er bróðir minn sem óttast og treystir Drottni og hlýðir orðum hans. <verse eid="PSA 119:63"/><verse number="64" style="v" sid="PSA 119:64"/>Ó, Drottinn, jörðin er full af miskunn þinni! Kenndu mér lög þín!<verse eid="PSA 119:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="PSA 119:65"/>Drottinn, blessun þín umlykur mig, eins og þú hafðir lofað mér. <verse eid="PSA 119:65"/><verse number="66" style="v" sid="PSA 119:66"/>Kenndu mér góð hyggindi og þekkingu, því að lög þín vísa mér veginn. <verse eid="PSA 119:66"/><verse number="67" style="v" sid="PSA 119:67"/>Áður var ég reikull, þar til þú refsaðir mér, en nú hlýði ég þér með glöðu geði. <verse eid="PSA 119:67"/><verse number="68" style="v" sid="PSA 119:68"/>Þú ert góður og gerir aðeins gott, hjálpaðu mér að fylgja leiðsögn þinni.<verse eid="PSA 119:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="PSA 119:69"/>Ofstopamenn hafa spunnið upp lygar um mig, en málið er, að ég hlýði lögum þínum af öllu hjarta. <verse eid="PSA 119:69"/><verse number="70" style="v" sid="PSA 119:70"/>Þeir eru tilfinningalausir, skilja ekkert, en ég elska þig og fylgi orðum þínum.<verse eid="PSA 119:70"/></para>
  <para style="p">
    <verse number="71-72" style="v" pubnumber="71,72" sid="PSA 119:71-72"/> Hirting þín var það besta sem fyrir mig gat komið, því að hún beindi augum mínum að lögum þínum. Lög þín eru mér meira virði en hrúgur af gulli og silfri!<verse eid="PSA 119:71-72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="PSA 119:73"/>Þú, Drottinn, ert skapari minn, gefðu mér vit til að halda lög þín. <verse eid="PSA 119:73"/><verse number="74" style="v" sid="PSA 119:74"/>Allir þeir sem óttast og elska þig, taka mér vel, þeir sjá að einnig ég treysti orðum þínum.<verse eid="PSA 119:74"/></para>
  <para style="p">
    <verse number="75-77" style="v" sid="PSA 119:75-77"/>Ég veit, Drottinn, að ákvarðanir þínar eru réttar og að úrskurðir þínir gerðu mér gott. Huggaðu mig með miskunn þinni, eins og þú lofaðir mér. Umvef mig náð þinni svo að ég haldi lífi. Lög þín eru unun mín.<verse eid="PSA 119:75-77"/></para>
  <para style="p">
    <verse number="78" style="v" sid="PSA 119:78"/>Lát hina stoltu verða til skammar, þá sem beita mig brögðum. En ég vil íhuga fyrirmæli þín.<verse eid="PSA 119:78"/></para>
  <para style="p">
    <verse number="79" style="v" sid="PSA 119:79"/>Láttu þá sem treysta þér, þá sem heiðra þig, koma til mín og við munum ræða lög þín. <verse eid="PSA 119:79"/><verse number="80" style="v" sid="PSA 119:80"/>Gefðu mér náð til að þóknast vilja þínum svo að ég verði aldrei til skammar.<verse eid="PSA 119:80"/></para>
  <para style="p">
    <verse number="81" style="v" sid="PSA 119:81"/>Ég þrái hjálp þína af öllu hjarta! Þú lofaðir að hjálpa mér! <verse eid="PSA 119:81"/><verse number="82" style="v" sid="PSA 119:82"/>Ég einblíni á þig, bíð eftir því að sjá loforð þitt rætast.</para>
  <para style="p" vid="PSA 119:82">Hvenær ætlar þú að hugga mig með hjálp þinni? <verse eid="PSA 119:82"/><verse number="83" style="v" sid="PSA 119:83"/>Ég er eins og hrukkóttur vínbelgur, skorpinn af reyk, uppgefinn af að bíða. Samt held ég fast við lög þín og hlýði þeim. <verse eid="PSA 119:83"/><verse number="84" style="v" sid="PSA 119:84"/>Hve lengi verð ég að bíða þess að þú refsir ofsækjendum mínum? <verse eid="PSA 119:84"/><verse number="85-86" style="v" pubnumber="85,86" sid="PSA 119:85-86"/> Ofstopamenn sem hata sannleika þinn og lög hafa grafið mér gryfju. Lygi þeirra hefur komið mér í mikinn vanda. Þú elskar sannleikann, hjálpaðu mér! <verse eid="PSA 119:85-86"/><verse number="87" style="v" sid="PSA 119:87"/>Þeir höfðu næstum gert út af við mig, en ég neitaði að láta undan og óhlýðnast lögum þínum. <verse eid="PSA 119:87"/><verse number="88" style="v" sid="PSA 119:88"/>Láttu mig halda lífi sakir miskunnar þinnar og ég mun halda áfram að fara eftir boðum þínum.<verse eid="PSA 119:88"/></para>
  <para style="p">
    <verse number="89" style="v" sid="PSA 119:89"/>Drottinn, á himnum stendur orð þitt óhaggað um eilífð.<verse eid="PSA 119:89"/></para>
  <para style="p">
    <verse number="90-91" style="v" pubnumber="90,91" sid="PSA 119:90-91"/> Trúfesti þín nær frá kynslóð til kynslóðar, hún stendur óhögguð eins og jörðin sem þú hefur skapað. Hún varir samkvæmt orðum þínum. Allir hlutir lúta þér.<verse eid="PSA 119:90-91"/></para>
  <para style="p">
    <verse number="92" style="v" sid="PSA 119:92"/>Ég hefði örvænt og farist ef lögmál þitt hefði ekki verið unun mín. <verse eid="PSA 119:92"/><verse number="93" style="v" sid="PSA 119:93"/>Ég mun aldrei yfirgefa lög þín, í þeim fann ég lífsgleði og góða heilsu. <verse eid="PSA 119:93"/><verse number="94" style="v" sid="PSA 119:94"/>Ég tilheyri þér! Ég bið þig, varðveittu mig! Ég vil breyta eftir orðum þínum. <verse eid="PSA 119:94"/><verse number="95" style="v" sid="PSA 119:95"/>Óguðlegir bíða færis til að drepa, en ég íhuga loforð þín og reglur.<verse eid="PSA 119:95"/></para>
  <para style="p">
    <verse number="96" style="v" sid="PSA 119:96"/>Ekkert er fullkomið í þessum heimi nema eitt – orð þín. <verse eid="PSA 119:96"/><verse number="97" style="v" sid="PSA 119:97"/>Ég elska þau! Ég íhuga þau liðlangan daginn. <verse eid="PSA 119:97"/><verse number="98" style="v" sid="PSA 119:98"/>Þau hafa gert mig vitrari en óvini mína, veitt mér leiðsögn gegnum lífið. <verse eid="PSA 119:98"/><verse number="99" style="v" sid="PSA 119:99"/>Ég er orðinn hyggnari en allir kennarar mínir, því að ég íhuga reglur þínar, <verse eid="PSA 119:99"/><verse number="100" style="v" sid="PSA 119:100"/>skynsamari en öldungar, því að ég held fyrirmæli þín.<verse eid="PSA 119:100"/></para>
  <para style="p">
    <verse number="101" style="v" sid="PSA 119:101"/>Ég hef hafnað vegum illskunnar, því að ég vil vera hlýðinn orðum þínum. <verse eid="PSA 119:101"/><verse number="102-103" style="v" pubnumber="102,103" sid="PSA 119:102-103"/> Ekki hef ég snúið baki við fyrirmælum þínum; orð þín eru sætari en hunang! <verse eid="PSA 119:102-103"/><verse number="104" style="v" sid="PSA 119:104"/>Orð þín ein veita mér skilning og vísdóm, er þá nokkur hissa þótt ég hati lygina?<verse eid="PSA 119:104"/></para>
  <para style="p">
    <verse number="105" style="v" sid="PSA 119:105"/>Þitt orð er lampi fóta minna, ljós á vegum mínum. Það forðar mér frá hrösun. <verse eid="PSA 119:105"/><verse number="106" style="v" sid="PSA 119:106"/>Ég hef sagt það áður og segi enn: „Ég vil hlýða lögum þínum, þau eru yndisleg!“<verse eid="PSA 119:106"/></para>
  <para style="p">
    <verse number="107" style="v" sid="PSA 119:107"/>Óvinum mínum hefur næstum tekist að koma mér á kné, frelsaðu mig eins og þú lofaðir mér! <verse eid="PSA 119:107"/><verse number="108" style="v" sid="PSA 119:108"/>Hlustaðu á þakkargjörð mína og kenndu mér vilja þinn. <verse eid="PSA 119:108"/><verse number="109" style="v" sid="PSA 119:109"/>Líf mitt hangir á bláþræði, samt vil ég ekki óhlýðnast boðum þínum. <verse eid="PSA 119:109"/><verse number="110" style="v" sid="PSA 119:110"/>Illmenni hafa lagt gildrur fyrir mig, en ég mun ekki víkja af þínum vegi. <verse eid="PSA 119:110"/><verse number="111" style="v" sid="PSA 119:111"/>Lög þín eru það besta sem ég á! – Þau eru fjársjóður minn og endast mér að eilífu! <verse eid="PSA 119:111"/><verse number="112" style="v" sid="PSA 119:112"/>Ég er ákveðinn í að hlýða þér allt þar til ég dey.<verse eid="PSA 119:112"/></para>
  <para style="p">
    <verse number="113" style="v" sid="PSA 119:113"/>Þeir finnst mér andstyggilegir sem haltra til beggja hliða – þeir sem ófúsir eru að hlýða þér. Mitt val er klárt: Ég elska boðorð þín. <verse eid="PSA 119:113"/><verse number="114" style="v" sid="PSA 119:114"/>Þú ert skjól mitt og skjöldur og ég treysti orðum þínum. <verse eid="PSA 119:114"/><verse number="115" style="v" sid="PSA 119:115"/>Burt frá mér, þið illgjörðamenn! Reynið ekki að fá mig til að óhlýðnast boðorðum Guðs. <verse eid="PSA 119:115"/><verse number="116" style="v" sid="PSA 119:116"/>Drottinn, þú lofaðir að halda í mér lífinu. Láttu engan geta sagt að þú hafir brugðist mér. <verse eid="PSA 119:116"/><verse number="117" style="v" sid="PSA 119:117"/>Hjálpaðu mér svo að ég megi frelsast og halda áfram að íhuga orðin þín.<verse eid="PSA 119:117"/></para>
  <para style="p">
    <verse number="118" style="v" sid="PSA 119:118"/>Þú snýrð þér frá þeim sem afneita lögum þínum. Þeir verða sjálfum sér til skammar. <verse eid="PSA 119:118"/><verse number="119" style="v" sid="PSA 119:119"/>Illgjörðamennirnir eru eins og sorp í þínum augum. Ég vil ekki vera einn af þeim, og þess vegna elska ég þig og hlýði lögum þínum. <verse eid="PSA 119:119"/><verse number="120" style="v" sid="PSA 119:120"/>Ég skelf af hræðslu við þig; óttast að þú dæmir mig sekan.<verse eid="PSA 119:120"/></para>
  <para style="p">
    <verse number="121" style="v" sid="PSA 119:121"/>Ofursel mig ekki duttlungum óvina minna, því að ég hef iðkað réttlæti og verið heiðarlegur í öllu. <verse eid="PSA 119:121"/><verse number="122" style="v" sid="PSA 119:122"/>Lofaðu mér einu: Að blessa mig! Láttu ekki hina hrokafullu kúga mig. <verse eid="PSA 119:122"/><verse number="123" style="v" sid="PSA 119:123"/>Ó, Drottinn, hvenær ætlar þú að efna loforð þitt og frelsa mig? <verse eid="PSA 119:123"/><verse number="124" style="v" sid="PSA 119:124"/>Drottinn, gerðu við mig eftir gæsku þinni og kenndu mér, þjóni þínum, hlýðni. <verse eid="PSA 119:124"/><verse number="125" style="v" sid="PSA 119:125"/>Ég er þjónn þinn, gefðu mér því vit til að fara eftir reglum þínum í öllu sem ég geri.<verse eid="PSA 119:125"/></para>
  <para style="p">
    <verse number="126" style="v" sid="PSA 119:126"/>Drottinn, láttu nú til skarar skríða! Þessi illmenni hafa brotið lög þín. <verse eid="PSA 119:126"/><verse number="127" style="v" sid="PSA 119:127"/>Ég elska boðorð þín meira en skíra gull! <verse eid="PSA 119:127"/><verse number="128" style="v" sid="PSA 119:128"/>Öll eru þau réttlát, boðorð Guðs, sama um hvað þau fjalla. Aðrar reglur vil ég ekki sjá.<verse eid="PSA 119:128"/></para>
  <para style="p">
    <verse number="129" style="v" sid="PSA 119:129"/>Lögmál þitt er yndislegt! Er einhver hissa á að ég vilji hlýða því? <verse eid="PSA 119:129"/><verse number="130" style="v" sid="PSA 119:130"/>Þú útskýrir fyrir okkur orð þín og jafnvel einfeldningurinn skilur þau. <verse eid="PSA 119:130"/><verse number="131" style="v" sid="PSA 119:131"/>Orð þín vekja áhuga minn, ég hlusta á þau með opnum munni!<verse eid="PSA 119:131"/></para>
  <para style="p">
    <verse number="132" style="v" sid="PSA 119:132"/>Komdu og miskunnaðu mér, eins og öðrum þeim sem elska þig. <verse eid="PSA 119:132"/><verse number="133" style="v" sid="PSA 119:133"/>Leiðbeindu mér með lögum þínum, svo að hið illa nái ekki tökum á mér. <verse eid="PSA 119:133"/><verse number="134" style="v" sid="PSA 119:134"/>Bjargaðu mér úr klóm vondra manna svo að ég geti farið eftir fyrirmælum þínum. <verse eid="PSA 119:134"/><verse number="135" style="v" sid="PSA 119:135"/>Líttu til mín í náð þinni og kenndu mér lög þín. <verse eid="PSA 119:135"/><verse number="136" style="v" sid="PSA 119:136"/>Ég græt því að lög þín eru fótum troðin.<verse eid="PSA 119:136"/></para>
  <para style="p">
    <verse number="137" style="v" sid="PSA 119:137"/>Drottinn, þú ert réttvís og refsing þín sanngjörn. <verse eid="PSA 119:137"/><verse number="138" style="v" sid="PSA 119:138"/>Skipanir þínar góðar og réttlátar. <verse eid="PSA 119:138"/><verse number="139" style="v" sid="PSA 119:139"/>Ég er í uppnámi og reiðin sýður í mér, því að óvinir mínir hafa forsmáð lög þín. <verse eid="PSA 119:139"/><verse number="140" style="v" sid="PSA 119:140"/>Ég hef séð að orð þín eru sönn og hrein, og þess vegna elska ég þau! <verse eid="PSA 119:140"/><verse number="141" style="v" sid="PSA 119:141"/>Ég er lítilmótlegur og fyrirlitinn en boðorðum þínum hef ég ekki gleymt.<verse eid="PSA 119:141"/></para>
  <para style="p">
    <verse number="142" style="v" sid="PSA 119:142"/>Réttlæti þitt varir að eilífu, og lög þín eru byggð á trúfesti. <verse eid="PSA 119:142"/><verse number="143" style="v" sid="PSA 119:143"/>Boðorð þín eru huggun mín í andstreymi og neyð. <verse eid="PSA 119:143"/><verse number="144" style="v" sid="PSA 119:144"/>Lög þín eru réttlát í öllum greinum. Hjálpaðu mér að skilja þau svo að ég haldi lífi.<verse eid="PSA 119:144"/></para>
  <para style="p">
    <verse number="145" style="v" sid="PSA 119:145"/>Ég ákalla þig af öllu hjarta! Bænheyrðu mig, Drottinn! Þá mun ég hlýða lögum þínum. <verse eid="PSA 119:145"/><verse number="146" style="v" sid="PSA 119:146"/>„Bjargaðu mér!“ hrópa ég, „svo að ég geti hlýtt þér.“ <verse eid="PSA 119:146"/><verse number="147" style="v" sid="PSA 119:147"/>Fyrir sólarupprás var ég á fótum, ég bað til þín og beið svars. <verse eid="PSA 119:147"/><verse number="148" style="v" sid="PSA 119:148"/>Já, ég vaki um nætur og íhuga fyrirheit þín. <verse eid="PSA 119:148"/><verse number="149" style="v" sid="PSA 119:149"/>Hlustaðu á bæn mína og miskunna mér, bjargaðu lífi mínu eins og þú hefur heitið mér.<verse eid="PSA 119:149"/></para>
  <para style="p">
    <verse number="150" style="v" sid="PSA 119:150"/>Nú koma illmennin, nú gera þau árás! Orð þitt þekkja þeir ekki, nei alls ekki. <verse eid="PSA 119:150"/><verse number="151" style="v" sid="PSA 119:151"/>En þú Drottinn ert mér nærri, í trúfesti eru orð þín sögð. <verse eid="PSA 119:151"/><verse number="152" style="v" sid="PSA 119:152"/>Ég heyrði orð þín í bernsku og veit að þau breytast ekki.<verse eid="PSA 119:152"/></para>
  <para style="p">
    <verse number="153" style="v" sid="PSA 119:153"/>Líttu á sorg mína og bjargaðu mér, því að boðum þínum hef ég hlýtt. <verse eid="PSA 119:153"/><verse number="154" style="v" sid="PSA 119:154"/>Já, frelsaðu mig frá dauða samkvæmt orði þínu. <verse eid="PSA 119:154"/><verse number="155" style="v" sid="PSA 119:155"/>Óguðlegir munu ekki frelsast því að þeim er sama um boðorð þín. <verse eid="PSA 119:155"/><verse number="156" style="v" sid="PSA 119:156"/>Drottinn, mikil er miskunn þín, bjargaðu lífi mínu!<verse eid="PSA 119:156"/></para>
  <para style="p">
    <verse number="157" style="v" sid="PSA 119:157"/>Margir eru óvinir mínir og fjendur, en frá reglum þínum hvika ég ekki. <verse eid="PSA 119:157"/><verse number="158" style="v" sid="PSA 119:158"/>Þarna eru svikararnir – mér býður við þeim! Þeim er alveg sama um orð þitt. <verse eid="PSA 119:158"/><verse number="159" style="v" sid="PSA 119:159"/>Drottinn, það skaltu vita, að ég elska boðorð þín. Miskunnaðu mér og leyfðu mér að halda lífi og heilsu. <verse eid="PSA 119:159"/><verse number="160" style="v" sid="PSA 119:160"/>Trúfestin er rauði þráðurinn í orðum þínum og reglur þínar vara að eilífu.<verse eid="PSA 119:160"/></para>
  <para style="p">
    <verse number="161" style="v" sid="PSA 119:161"/>Höfðingjar ofsækja mig án saka, hvað geri ég? – skoða lög þín með lotningu! <verse eid="PSA 119:161"/><verse number="162" style="v" sid="PSA 119:162"/>Ég fagna yfir lögum þínum eins fundnum fjársjóði. <verse eid="PSA 119:162"/><verse number="163" style="v" sid="PSA 119:163"/>Ég hata lygi og fals, en elska lög þín. <verse eid="PSA 119:163"/><verse number="164" style="v" sid="PSA 119:164"/>Sjö sinnum á dag lofa ég þig vegna þinna réttlátu ákvæða.<verse eid="PSA 119:164"/></para>
  <para style="p">
    <verse number="165" style="v" sid="PSA 119:165"/>Þeir sem elska lögmál þitt eiga frið í hjarta og er ekki hætt við hrösun. <verse eid="PSA 119:165"/><verse number="166" style="v" sid="PSA 119:166"/>Drottinn, ég þrái hjálp þína og þess vegna hlýði ég boðum þínum. <verse eid="PSA 119:166"/><verse number="167-168" style="v" pubnumber="167,168" sid="PSA 119:167-168"/> Ég hef leitað og gætt boðorða þinna og elska þau af öllu hjarta. Þetta veistu, því að allt sem ég geri þekkir þú til fulls.<verse eid="PSA 119:167-168"/></para>
  <para style="p">
    <verse number="169" style="v" sid="PSA 119:169"/>Drottinn, heyr þú hróp mitt og gefðu mér skilning á orði þínu. <verse eid="PSA 119:169"/><verse number="170" style="v" sid="PSA 119:170"/>Hlusta á bænir mínar og frelsaðu mig eins og þú lofaðir mér. <verse eid="PSA 119:170"/><verse number="171" style="v" sid="PSA 119:171"/>Ég vegsama þig því að þú kenndir mér boðorð þín. <verse eid="PSA 119:171"/><verse number="172" style="v" sid="PSA 119:172"/>Efni þeirra er lofgjörð mín, öll eru þau réttlát. <verse eid="PSA 119:172"/><verse number="173" style="v" sid="PSA 119:173"/>Veittu mér lið þegar ég þarfnast hjálpar, því að ég hef kosið að hlýða þér. <verse eid="PSA 119:173"/><verse number="174" style="v" sid="PSA 119:174"/>Ó, Drottinn, ég þrái hjálpræði þitt og lög þín elska ég! <verse eid="PSA 119:174"/><verse number="175" style="v" sid="PSA 119:175"/>Láttu sál mína lifa svo að ég geti lofað þig og orð þín styðja mig á göngu lífsins.<verse eid="PSA 119:175"/></para>
  <para style="p">
    <verse number="176" style="v" sid="PSA 119:176"/>Ég villist eins og týndur sauður, leitaðu mín, því að boðorðum þínum hef ég ekki gleymt.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 120:1"/>Ég ákalla Guð í neyð minni og hann hjálpar mér.<verse eid="PSA 120:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 120:2"/>Drottinn, frelsaðu mig frá svikum og prettum. <verse eid="PSA 120:2"/><verse number="3" style="v" sid="PSA 120:3"/>Þú lygatunga, hver verða örlög þín? <verse eid="PSA 120:3"/><verse number="4" style="v" sid="PSA 120:4"/>Oddhvassar örvar munu stinga þig og glóandi kol brenna þig!<verse eid="PSA 120:4"/></para>
  <para style="p">
    <verse number="5-6" style="v" pubnumber="5,6" sid="PSA 120:5-6"/> Hvílík mæða að búa með óguðlegum! Ég er þreyttur á þeim sem hata friðinn. <verse eid="PSA 120:5-6"/><verse number="7" style="v" sid="PSA 120:7"/>Ég þrái frið, en þeir elska stríð og láta ráð mín sem vind um eyrun þjóta.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 121:1"/>Ég horfi til fjallanna, þar sem Jerúsalem rís. Hvaðan skyldi ég fá hjálp? <verse eid="PSA 121:1"/><verse number="2" style="v" sid="PSA 121:2"/>Hjálp mín kemur frá Drottni, skapara himins og jarðar! <verse eid="PSA 121:2"/><verse number="3-4" style="v" pubnumber="3,4" sid="PSA 121:3-4"/> Hann mun aldrei láta mig hrasa eða falla. Hann gætir mín öllum stundum og sefur ekki á verðinum.<verse eid="PSA 121:3-4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 121:5"/>Sjálfur Drottinn gætir þín! Hugleiddu það! Hann verndar þig gegn öllu illu og er þér alltaf nær. <verse eid="PSA 121:5"/><verse number="6" style="v" sid="PSA 121:6"/>Hann verndar þig jafnt daga sem nætur. <verse eid="PSA 121:6"/><verse number="7" style="v" sid="PSA 121:7"/>Hann frelsar þig frá illu og heldur í þér lífinu. <verse eid="PSA 121:7"/><verse number="8" style="v" sid="PSA 121:8"/>Hann hefur augun á þér hvort sem þú gengur út eða inn, já hann varðveitir þig alla daga og að eilífu.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 122:1"/>Ég varð glaður þegar sagt var við mig: „Komdu! Förum í musterið, hús Drottins!“<verse eid="PSA 122:1"/></para>
  <para style="p">
    <verse number="2-3" style="v" pubnumber="2,3" sid="PSA 122:2-3"/> Við erum stödd í Jerúsalem og borgin er full af fólki. <verse eid="PSA 122:2-3"/><verse number="4" style="v" sid="PSA 122:4"/>Allur Ísrael – þjóð Drottins – er kominn til að tilbiðja og lofa Drottin samkvæmt reglu lögmálsins. <verse eid="PSA 122:4"/><verse number="5" style="v" sid="PSA 122:5"/>Sjáið! Þarna eru dómararnir í borgarhliðinu, þeir skera úr deilumálum fólksins.<verse eid="PSA 122:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 122:6"/>Biðjið þess að friður haldist í Jerúsalem og að þeir sem hana elska njóti heilla og hamingju. <verse eid="PSA 122:6"/><verse number="7" style="v" sid="PSA 122:7"/>Ég bið að friður ríki umhverfis þig og hagsæld sé í höllum þínum, <verse eid="PSA 122:7"/><verse number="8" style="v" sid="PSA 122:8"/>já, vegna bræðra minna og vina sem hér búa. <verse eid="PSA 122:8"/><verse number="9" style="v" sid="PSA 122:9"/>Ég bið um hamingju þér til handa, Jerúsalem, vegna musteris Drottins sem í þér er.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 123:1"/>Ó, Guð, þú sem ríkir á himnum, ég hef augu mín til þín.<verse eid="PSA 123:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 123:2"/>Við horfum til Drottins Guðs, þráum miskunn hans og náð, rétt eins og þjónninn mænir á húsbónda sinn og þernan á húsmóður sína.<verse eid="PSA 123:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" pubnumber="3,4" sid="PSA 123:3-4"/> Miskunna okkur, Drottinn, miskunna okkur. Við höfum fengið nóg af háði og spotti hinna hrokafullu.<verse eid="PSA 123:3-4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 124:1"/>Hefði það ekki verið Drottinn sem með okkur var þetta skulu allir í Ísrael játa – hefði það ekki verið Drottinn, <verse eid="PSA 124:1"/><verse number="2-3" style="v" pubnumber="2,3" sid="PSA 124:2-3"/> þá hefðu óvinirnir gleypt okkur lifandi, útrýmt okkur í heiftarreiði sinni. <verse eid="PSA 124:2-3"/><verse number="4-5" style="v" pubnumber="4,5" sid="PSA 124:4-5"/> Við hefðum skolast burt á augabragði, horfið í strauminn.<verse eid="PSA 124:4-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 124:6"/>Lofaður sé Drottinn, hann bjargaði okkur úr klóm þeirra. <verse eid="PSA 124:6"/><verse number="7" style="v" sid="PSA 124:7"/>Við sluppum eins og fugl úr snöru veiðimanns. Snaran gaf sig og við flugum burt!<verse eid="PSA 124:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PSA 124:8"/>Hjálp okkar kemur frá Drottni sem skapaði himin og jörð.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 125:1"/>Þeir sem treysta Drottni eru eins og Síonfjall, þeir haggast ekki.<verse eid="PSA 125:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 125:2"/>Fjöllin umhverfis Jerúsalem eru henni til verndar, eins er Drottinn, hann umlykur og verndar sitt fólk. <verse eid="PSA 125:2"/><verse number="3" style="v" sid="PSA 125:3"/>Ekki skulu óguðlegir drottna yfir trúuðum, né réttlátir þvingaðir til illverka.<verse eid="PSA 125:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 125:4"/>Ó, Drottinn, gerðu vel við þá sem góðir eru, þá sem leitast við að gera vilja þinn, en útrýmdu illgjörðamönnum. Láttu frið og velgengni ríkja í Ísrael.<verse eid="PSA 125:4"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 126:1"/>Þegar Drottinn flutti þjóð sína aftur til Jerúsalem, heim úr herleiðingunni, þá héldum við að okkur væri að dreyma! <verse eid="PSA 126:1"/><verse number="2" style="v" sid="PSA 126:2"/>Við sungum og hlógum af gleði. Þá sögðu heiðnu þjóðirnar: „Drottinn hefur gert ótrúlega hluti fyrir þá!“ <verse eid="PSA 126:2"/><verse number="3" style="v" sid="PSA 126:3"/>Já, undursamlega hluti! Hvílíkt undur! Hvílík gleði! <verse eid="PSA 126:3"/><verse number="4" style="v" sid="PSA 126:4"/>Hresstu okkur nú Drottinn, já gefðu okkur kröftuga gróðrarskúr!<verse eid="PSA 126:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 126:5"/>Þeir sem sá með tárum skulu uppskera með gleðisöng. <verse eid="PSA 126:5"/><verse number="6" style="v" sid="PSA 126:6"/>Grátandi bera þeir sæðið til sáningar, en syngjandi koma þeir aftur og bera kornbindin heim!<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 127:1"/>Ef hús er ekki byggt að ráði Drottins, erfiða smiðirnir til ónýtis. Ef Drottinn verndar ekki borgina, vaka verðirnir til einskis. <verse eid="PSA 127:1"/><verse number="2" style="v" sid="PSA 127:2"/>Hvers vegna þrælar þú myrkranna á milli af ótta við skort? Veistu ekki að Guð vill að vinir hans fái þá hvíld sem þeir þarfnast? Á meðan þeir sofa, blessar hann þá með gjöfum.<verse eid="PSA 127:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 127:3"/>Börnin eru gjöf frá Guði, ávöxtur móðurkviðar og laun frá Drottni. <verse eid="PSA 127:3"/><verse number="4" style="v" sid="PSA 127:4"/>Börn sem maður eignast ungur, eru eins og beittar örvar – þau koma síðar að gagni! Sæll er sá maður sem hefur fyllt örvamæli sinn með þeim! Hann mun ekki verða til skammar þegar hann þarf að útkljá deilumál við óvini sína!<verse eid="PSA 127:4"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 128:1"/>Sæll er hver sá sem heiðrar Drottin, treystir honum og hlýðir.<verse eid="PSA 128:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 128:2"/>Honum mun launað með velgengni og hamingju. <verse eid="PSA 128:2"/><verse number="3" style="v" sid="PSA 128:3"/>Kona hans hugsar vel um heimilið – og ekki mun þau skorta börn! Þarna sitja þau að matnum, þróttmikil og frísk eins og ung olífutré! <verse eid="PSA 128:3"/><verse number="4" style="v" sid="PSA 128:4"/>Þannig launar Guð þeim sem elska hann og treysta honum.<verse eid="PSA 128:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 128:5"/>Drottinn blessi þig frá musterinu á Síon. Alla þína ævidaga muntu gleðjast yfir velgengni Jerúsalem <verse eid="PSA 128:5"/><verse number="6" style="v" sid="PSA 128:6"/>og eignast marga afkomendur. Friður Guðs sé yfir Ísrael!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 129:1"/>Allt frá bernsku var ég ofsóttur (það er Ísrael sem talar) <verse eid="PSA 129:1"/><verse number="2" style="v" sid="PSA 129:2"/>og misréttinu linnti ekki – en aldrei var ég þurrkaður út. Aldrei hefur óvinum mínum tekist að uppræta mig!<verse eid="PSA 129:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" pubnumber="3,4" sid="PSA 129:3-4"/> Þótt þeir húðstrýktu mig og tættu bak mitt, þá segi ég samt: „Drottinn er góður!“ Því að hann braut hlekkina sem illmennin höfðu fjötrað mig með.<verse eid="PSA 129:3-4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 129:5"/>Þeir sem hata Jerúsalem skulu verða til skammar og flýja. <verse eid="PSA 129:5"/><verse number="6-7" style="v" pubnumber="6,7" sid="PSA 129:6-7"/> Þeir skulu vera eins og gras á þaki – það skrælnar áður en það hefur vaxið og myndað fræ. Sláttumaðurinn mun grípa í tómt og sá sem bindur fær ekki neitt. <verse eid="PSA 129:6-7"/><verse number="8" style="v" sid="PSA 129:8"/>Þeir sem framhjá fara skulu ekki óska þér blessunar. En við ykkur segjum við: „Drottinn blessi þig!“<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 130:1"/>Ó, Drottinn, ég er í nauðum staddur, heyrðu hróp mitt! <verse eid="PSA 130:1"/><verse number="2" style="v" sid="PSA 130:2"/>Hlustaðu á mig! Svaraðu og hjálpaðu mér!<verse eid="PSA 130:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" pubnumber="3,4" sid="PSA 130:3-4"/> Drottinn, ef þú rifjaðir sífellt upp syndir okkar, hver fengi þá staðist? En þú fyrirgefur! Getum við annað en óttast þig og elskað? <verse eid="PSA 130:3-4"/><verse number="5" style="v" sid="PSA 130:5"/>Og þess vegna bið ég og vona og treysti hjálp Guðs, því að hann hefur lofað að hjálpa. <verse eid="PSA 130:5"/><verse number="6" style="v" sid="PSA 130:6"/>Næturverðirnir þrá nýjan dag, en ég þrái Drottin enn meira!<verse eid="PSA 130:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 130:7"/>Ísrael, treystu Drottni því að hann er góður og miskunnsamur og veitir gnægð lausnar. <verse eid="PSA 130:7"/><verse number="8" style="v" sid="PSA 130:8"/>Hann mun sjálfur leysa Ísrael frá öllum misgjörðum hans.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 131:1"/>Drottinn, ég er hvorki stoltur né hrokafullur. Ég álít sjálfan mig ekki betri en aðra. Ég læt ekki sem ég viti alla hluti. <verse eid="PSA 131:1"/><verse number="2" style="v" sid="PSA 131:2"/>Ég er hljóður fyrir Drottni, eins og barn sem vanið hefur verið af brjósti. Ég er hættur að suða og nauða.<verse eid="PSA 131:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 131:3"/>Ísrael, ver þú hljóður og treystu Drottni, nú og ævinlega.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 132:1"/>Manst þú, Drottinn, allar þjáningar Davíðs? <verse eid="PSA 132:1"/><verse number="2-5" style="v" sid="PSA 132:2-5"/>Hann náði ekki að hvílast, kom ekki dúr á auga. Þá kom honum í hug að reisa hús yfir örk þína, musteri fyrir hinn volduga í Ísrael. Og hann hét því að svo skyldi verða og sór hátíðlegan eið fyrir Drottni.<verse eid="PSA 132:2-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 132:6"/>Fyrst var örkin í Síló í Efrata og síðan í Jaar. <verse eid="PSA 132:6"/><verse number="7" style="v" sid="PSA 132:7"/>Nú fær hún stað í musterinu, bústað Guðs hér á jörð. Þar munum við falla fram og tilbiðja hann. <verse eid="PSA 132:7"/><verse number="8" style="v" sid="PSA 132:8"/>Rís þú upp, Drottinn! Gakktu inn í musteri þitt ásamt örk þinni, tákni máttar þíns!<verse eid="PSA 132:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 132:9"/>Við munum íklæða prestana hvítum skrúða, klæðum hreinleikans. Og þjóðin mun hrópa fagnaðaróp!<verse eid="PSA 132:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 132:10"/>Vísaðu Davíð þjóni þínum ekki frá – konunginum sem þú útvaldir handa þjóð þinni. <verse eid="PSA 132:10"/><verse number="11" style="v" sid="PSA 132:11"/>Þú lofaðir Davíð því að sonur hans yrði eftirmaður hans, skyldi erfa hásætið. Vissulega munt þú aldrei ganga á bak orða þinna! <verse eid="PSA 132:11"/><verse number="12" style="v" sid="PSA 132:12"/>Og annað fyrirheit gafstu Davíð líka: Ef afkomendur hans héldu ákvæði sáttmála þíns við þig, þá mundi konungdómurinn haldast í ætt Davíðs að eilífu.<verse eid="PSA 132:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 132:13"/>Ó, Drottinn, þú hefur útvalið Jerúsalem að bústað þínum.<verse eid="PSA 132:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 132:14"/>„Þetta er hvíldarstaður minn um aldur og ævi,“ sagðir þú, „staðurinn sem ég hef þráð. <verse eid="PSA 132:14"/><verse number="15" style="v" sid="PSA 132:15"/>Borg þessa vil ég blessa og auðga og fátæklingar hennar fá nóg að borða. <verse eid="PSA 132:15"/><verse number="16" style="v" sid="PSA 132:16"/>Presta hennar mun ég íklæða hjálpræði, og hinir trúuðu er þar búa munu hrópa fagnaðaróp. <verse eid="PSA 132:16"/><verse number="17" style="v" sid="PSA 132:17"/>Veldi Davíðs mun aukast, og ég mun gefa honum son, eftirmann í hásæti hans. <verse eid="PSA 132:17"/><verse number="18" style="v" sid="PSA 132:18"/>Ég hyl óvini hans skömm, en á honum skal kóróna hans ljóma.“<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 133:1"/>Sjáið hve yndislegt það er þegar systkini búa saman í sátt og samlyndi! Vináttan er dýrmæt! <verse eid="PSA 133:1"/><verse number="2" style="v" sid="PSA 133:2"/>Hún er eins og ilmolían sem hellt var yfir höfuð Arons, rann niður skeggið og draup á kyrtil hans, <verse eid="PSA 133:2"/><verse number="3" style="v" sid="PSA 133:3"/>eins og áin Jórdan sem sprettur upp við Hermonfjall og vökvar Ísrael. Guð mun blessa Jerúsalem og veita þar líf að eilífu.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 134:1"/>Já, lofið Drottin, þið sem vakið yfir musteri hans um nætur.<verse eid="PSA 134:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 134:2"/>Lyftið höndum til helgidómsins og lofið Drottin.<verse eid="PSA 134:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 134:3"/>Drottinn blessi þig frá Síon, hann sem skapaði himin og jörð.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 135:1-2"/> Hallelúja! Lýður Drottins lofi hann í forgörðum musteris hans. <verse eid="PSA 135:1-2"/><verse number="3" style="v" sid="PSA 135:3"/>Lofið Drottin því að hann er góður, vegsamið hans dýrlega nafn. <verse eid="PSA 135:3"/><verse number="4" style="v" sid="PSA 135:4"/>Því að Drottinn hefur kosið Ísrael sér að eignarlýð.<verse eid="PSA 135:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 135:5"/>Ég þekki mikilleik Drottins – að hann er öllum guðum æðri.<verse eid="PSA 135:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 135:6"/>Það sem honum þóknast, það gerir hann á himni, á jörðu og einnig í hafdjúpunum! <verse eid="PSA 135:6"/><verse number="7" style="v" sid="PSA 135:7"/>Hann lætur skýin stíga upp af jörðinni og eldinguna leiftra svo að rigni; og vindana lætur hann blása úr forðabúrum sínum. <verse eid="PSA 135:7"/><verse number="8" style="v" sid="PSA 135:8"/>Hann laust frumburði Egyptalands, bæði menn og dýr. <verse eid="PSA 135:8"/><verse number="9" style="v" sid="PSA 135:9"/>Undur og tákn gerði hann í augsýn Faraó og þjóna hans. <verse eid="PSA 135:9"/><verse number="10" style="v" sid="PSA 135:10"/>Fjölmennar þjóðir lagði hann að velli, felldi volduga konunga <verse eid="PSA 135:10"/><verse number="11" style="v" sid="PSA 135:11"/>– Síhon, Amoríta-konung og Óg, konung í Basan og konunga Kanaanslands <verse eid="PSA 135:11"/><verse number="12" style="v" sid="PSA 135:12"/>og gaf Ísrael lönd þeirra til eilífrar eignar.<verse eid="PSA 135:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 135:13"/>Ó, Drottinn, nafn þitt varir að eilífu! Frægð Drottins er kunn frá kynslóð til kynslóðar, <verse eid="PSA 135:13"/><verse number="14" style="v" sid="PSA 135:14"/>því að hann réttir hlut þjóðar sinnar og miskunnar þjónum sínum.<verse eid="PSA 135:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PSA 135:15"/>Heiðingjarnir tilbiðja skurðgoð úr gulli og silfri, handaverk manna <verse eid="PSA 135:15"/><verse number="16" style="v" sid="PSA 135:16"/>– mállaus og sjónlaus skurðgoð, <verse eid="PSA 135:16"/><verse number="17" style="v" sid="PSA 135:17"/>sem hvorki heyra né draga andann. <verse eid="PSA 135:17"/><verse number="18" style="v" sid="PSA 135:18"/>Smiðir þeirra líkjast þeim og þeir sem tilbiðja þau.<verse eid="PSA 135:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 135:19"/>Ísrael, lofa þú Drottin! Æðstuprestar Arons, vegsamið nafn hans, <verse eid="PSA 135:19"/><verse number="20" style="v" sid="PSA 135:20"/>og einnig þið prestar af Levíætt. Já, lofið nafn hans, öll þið sem treystið honum og óttist hann. <verse eid="PSA 135:20"/><verse number="21" style="v" sid="PSA 135:21"/>Þið íbúar Jerúsalem, lofið Drottin, hann sem býr í Jerúsalem! Hallelúja!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 136:1"/>Þakkið Drottni, því að hann er góður, miskunn hans varir að eilífu!<verse eid="PSA 136:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 136:2"/>Þakkið Guði guðanna, því að miskunn hans varir að eilífu. <verse eid="PSA 136:2"/><verse number="3" style="v" sid="PSA 136:3"/>Þakkið Drottni drottnanna, því að miskunn hans varir að eilífu.<verse eid="PSA 136:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 136:4"/>Lofið hann sem einn gjörir furðuverk, því að miskunn hans varir að eilífu. <verse eid="PSA 136:4"/><verse number="5" style="v" sid="PSA 136:5"/>Lofið hann sem skapaði himininn, því að miskunn hans varir að eilífu. <verse eid="PSA 136:5"/><verse number="6" style="v" sid="PSA 136:6"/>Lofið hann sem aðskildi höf og lönd, því að miskunn hans varir að eilífu. <verse eid="PSA 136:6"/><verse number="7" style="v" sid="PSA 136:7"/>Lofið hann sem skapaði ljósgjafa himinsins, því að miskunn hans varir að eilífu. <verse eid="PSA 136:7"/><verse number="8" style="v" sid="PSA 136:8"/>Sólina til að ráða deginum, því að miskunn hans varir að eilífu <verse eid="PSA 136:8"/><verse number="9" style="v" sid="PSA 136:9"/>og tunglið og stjörnurnar til að ráða um nætur, því að miskunn hans varir að eilífu. <verse eid="PSA 136:9"/><verse number="10" style="v" sid="PSA 136:10"/>Lofið Guð sem laust frumburði Egypta, því að miskunn hans við Ísrael varir að eilífu. <verse eid="PSA 136:10"/><verse number="11-12" style="v" pubnumber="11,12" sid="PSA 136:11-12"/> Hann leiddi þá út með mætti sínum og sinni voldugu hendi, því að miskunn hans við Ísrael varir að eilífu. <verse eid="PSA 136:11-12"/><verse number="13-14" style="v" pubnumber="13,14" sid="PSA 136:13-14"/> Lofið Drottin sem opnaði þeim leið gegnum Rauðahafið, því að miskunn hans – varir að eilífu, <verse eid="PSA 136:13-14"/><verse number="15" style="v" sid="PSA 136:15"/>en drekkti í hafinu hersveitum faraós, því að miskunn hans við Ísrael varir að eilífu.<verse eid="PSA 136:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 136:16"/>Lofið hann sem leiddi lýð sinn yfir auðnina, því að miskunn hans varir að eilífu. <verse eid="PSA 136:16"/><verse number="17" style="v" sid="PSA 136:17"/>Lofið hann sem frelsaði lýð sinn undan voldugum konungum, því að miskunn hans varir að eilífu <verse eid="PSA 136:17"/><verse number="18" style="v" sid="PSA 136:18"/>og laust þá til dauða, þessa óvini Ísraels, því að miskunn hans við Ísrael varir að eilífu: <verse eid="PSA 136:18"/><verse number="19" style="v" sid="PSA 136:19"/>Síhon, Amoríta-konung, því að miskunn Guðs við Ísrael varir að eilífu <verse eid="PSA 136:19"/><verse number="20" style="v" sid="PSA 136:20"/>– og Óg, konung í Basan – því að miskunn hans við Ísrael varir að eilífu. <verse eid="PSA 136:20"/><verse number="21" style="v" sid="PSA 136:21"/>Guð gaf Ísrael lönd þessara konunga til eilífrar eignar, því að miskunn hans varir að eilífu. <verse eid="PSA 136:21"/><verse number="22" style="v" sid="PSA 136:22"/>Já, þau skyldu verða varanleg gjöf til Ísrael, þjóns hans, því að miskunn hans varir að eilífu.<verse eid="PSA 136:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 136:23"/>Hann minntist okkar í eymd okkar, því að miskunn hans varir að eilífu <verse eid="PSA 136:23"/><verse number="24" style="v" sid="PSA 136:24"/>og frelsaði okkur frá óvinum okkar, því að miskunn hans varir að eilífu.<verse eid="PSA 136:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PSA 136:25"/>Hann gefur fæðu öllu því sem lifir, því að miskunn hans varir að eilífu. <verse eid="PSA 136:25"/><verse number="26" style="v" sid="PSA 136:26"/>Já, færið Guði himnanna þakkir, því að miskunn hans varir að eilífu!<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 137:1"/>Við sátum á bökkum Babylonsfljóts og minntumst Jerúsalem – og grétum. <verse eid="PSA 137:1"/><verse number="2" style="v" sid="PSA 137:2"/>Gígjurnar höfum við lagt til hliðar, hengt þær á greinar pílviðarins. <verse eid="PSA 137:2"/><verse number="3-4" style="v" pubnumber="3,4" sid="PSA 137:3-4"/> Hvernig eigum við að geta sungið? Samt heimta kúgarar okkar söng, vilja að við syngjum gleðiljóð frá Síon! <verse eid="PSA 137:3-4"/><verse number="5-6" style="v" pubnumber="5,6" sid="PSA 137:5-6"/> Ef ég gleymi þér Jerúsalem, þá visni mín hægri hönd! Ef ég elska annað umfram Jerúsalem, þá sé mér mátulegt að missa málið og tapa röddinni.<verse eid="PSA 137:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 137:7"/>Ó, Drottinn, gleymdu ekki orðum Edómíta, daginn þegar Babyloníumenn hernámu Jerúsalem. „Rífið allt til grunna!“ æptu þeir. <verse eid="PSA 137:7"/><verse number="8" style="v" sid="PSA 137:8"/>Þú Babýlon, ófreskja eyðingarinnar, þú munt sjálf verða lögð í rúst. Lengi lifi þeir sem eyða þig – þig sem eyddir okkur. <verse eid="PSA 137:8"/><verse number="9" style="v" sid="PSA 137:9"/>Og heill þeim sem tekur ungbörn þín og slær þeim við stein!<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 138:1"/>Drottinn, ég þakka þér af öllu hjarta! Ég vil lofsyngja þér í áheyrn englanna á himnum. <verse eid="PSA 138:1"/><verse number="2" style="v" sid="PSA 138:2"/>Ég vil falla fram fyrir þínu heilaga musteri, þakka þér elsku þína og trúfesti, og loforð þín sem þú hefur innsiglað með þínu mikilfenglega nafni. <verse eid="PSA 138:2"/><verse number="3" style="v" sid="PSA 138:3"/>Þegar ég bið, þá heyrir þú bænir mínar, styrkir mig og hughreystir.<verse eid="PSA 138:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 138:4"/>Konungar jarðarinnar skulu þakka þér, Drottinn, því að allir heyra þeir rödd þína. <verse eid="PSA 138:4"/><verse number="5" style="v" sid="PSA 138:5"/>Já, þeir skulu syngja um verk Drottins, því að mikil er dýrð hans. <verse eid="PSA 138:5"/><verse number="6" style="v" sid="PSA 138:6"/>En þótt Drottinn sé mikill, þá lýtur hann að hinum lítilmótlegu, en hrokafullir halda sig fjarri. <verse eid="PSA 138:6"/><verse number="7" style="v" sid="PSA 138:7"/>Þótt ég sé umvafinn erfiðleikum, muntu sjá um að allt fari vel. Þú réttir fram hnefann gegn óvinum mínum. Kraftur þinn mun frelsa mig. <verse eid="PSA 138:7"/><verse number="8" style="v" sid="PSA 138:8"/>Drottinn mun leysa úr öllum mínum málum – því að Drottinn, miskunn þín varir að eilífu. Yfirgef mig ekki, því að ég er verk handa þinna.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 139:1"/>Drottinn, þú rannsakar mig út og inn og veist allt um mig. <verse eid="PSA 139:1"/><verse number="2" style="v" sid="PSA 139:2"/>Hvort ég sit eða stend, það veist þú. Og þú lest hugsanir mínar úr fjarlægð! <verse eid="PSA 139:2"/><verse number="3" style="v" sid="PSA 139:3"/>Þú veist hvert ég stefni og þekkir langanir mínar. Og hvort sem ég geng eða ligg, þá athugar þú það. Þú veist öllum stundum hvar ég er. <verse eid="PSA 139:3"/><verse number="4" style="v" sid="PSA 139:4"/>Þú þekkir orðin á tungu minni áður en ég opna munninn! <verse eid="PSA 139:4"/><verse number="5" style="v" sid="PSA 139:5"/>Þú bæði fylgir mér og ferð á undan mér, leggur hönd þína á höfuð mitt og blessar mig.<verse eid="PSA 139:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 139:6"/>Þetta er stórkostlegt! Já, næstum of gott til að vera satt! <verse eid="PSA 139:6"/><verse number="7" style="v" sid="PSA 139:7"/>Hvert get ég farið frá anda þínum eða flúið frá augliti þínu? <verse eid="PSA 139:7"/><verse number="8" style="v" sid="PSA 139:8"/>Fari ég til himna, þá ertu þar, til dánarheima, þá ertu líka þar! <verse eid="PSA 139:8"/><verse number="9" style="v" sid="PSA 139:9"/>Ef ég svifi á skýjum morgunroðans og settist við fjarlæga strönd, <verse eid="PSA 139:9"/><verse number="10" style="v" sid="PSA 139:10"/>einnig þar mundi hönd þín leiða mig og ég finna styrk þinn og vernd. <verse eid="PSA 139:10"/><verse number="11" style="v" sid="PSA 139:11"/>Og þótt ég reyndi að læðast frá þér inn í myrkrið, þá myndi nóttin lýsa eins og dagur! <verse eid="PSA 139:11"/><verse number="12" style="v" sid="PSA 139:12"/>Því að myrkrið hylur ekkert fyrir Guði, dagur og nótt eru jöfn fyrir þér.<verse eid="PSA 139:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="PSA 139:13"/>Öll líffæri mín hefur þú skapað, ofið þau í kviði móður minnar. <verse eid="PSA 139:13"/><verse number="14" style="v" sid="PSA 139:14"/>Þökk, að þú skapaðir mig eins undursamlega og raun ber vitni! Þetta er dásamlegt um að hugsa! Handaverk þín eru stórkostleg – það er mér alveg ljóst. <verse eid="PSA 139:14"/><verse number="15" style="v" sid="PSA 139:15"/>Þú varst til staðar þegar ég var myndaður í leyni. <verse eid="PSA 139:15"/><verse number="16" style="v" sid="PSA 139:16"/>Þú þekktir mig þegar ég var fóstur í móðurkviði og áður en ég sá dagsins ljós hafðir þú ákvarðað alla mína ævidaga – sérhver dagur var skráður í bók þína!<verse eid="PSA 139:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" pubnumber="17,18" sid="PSA 139:17-18"/> Hugsanir þínar, ó Guð, eru mér torskildar, en samt eru þær stórkostlegar! Ef ég reyndi að telja þær, þá yrði það mér ofviða því að þær eru fleiri en sandkorn á sjávarströnd! Já, ég mundi vakna eins og af draumi, en hugur minn, hann væri enn hjá þér!<verse eid="PSA 139:17-18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="PSA 139:19"/>Vissulega munt þú, Guð, útrýma níðingunum. Já, burt með ykkur, þið morðingjar! <verse eid="PSA 139:19"/><verse number="20" style="v" sid="PSA 139:20"/>Þeir guðlasta og hreykja sér upp gegn þér – hvílík heimska! <verse eid="PSA 139:20"/><verse number="21" style="v" sid="PSA 139:21"/>Drottinn, ætti ég ekki að hata þá sem þig hata? Og ætti ég ekki að hafa viðbjóð á þeim? <verse eid="PSA 139:21"/><verse number="22" style="v" sid="PSA 139:22"/>Jú, ég hata þá, því að þínir óvinir eru mínir óvinir.<verse eid="PSA 139:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PSA 139:23"/>Prófaðu mig Guð. Rannsakaðu hjarta mitt og hugsanir mínar. <verse eid="PSA 139:23"/><verse number="24" style="v" sid="PSA 139:24"/>Sýndu mér það í fari mínu sem hryggir þig og leiddu mig svo áfram veginn til eilífs lífs.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 140:1-2"/> Ó, Drottinn, frelsaðu mig frá vondum mönnum. Verndaðu mig gegn ofbeldismönnunum <verse eid="PSA 140:1-2"/><verse number="3" style="v" sid="PSA 140:3"/>sem sitja á svikráðum alla daga og vekja ófrið. <verse eid="PSA 140:3"/><verse number="4" style="v" sid="PSA 140:4"/>Orð þeirra eru eins og eitruð höggormsbit. <verse eid="PSA 140:4"/><verse number="5" style="v" sid="PSA 140:5"/>Varðveittu mig gegn ofbeldi þeirra og svikráðum. <verse eid="PSA 140:5"/><verse number="6" style="v" sid="PSA 140:6"/>Þessir ofríkismenn hafa lagt gildru fyrir mig, sett út snöru sína. Þeir bíða þess að geta kastað yfir mig neti, flækja mig í möskva sína.<verse eid="PSA 140:6"/></para>
  <para style="p">
    <verse number="7-8" style="v" pubnumber="7,8" sid="PSA 140:7-8"/> Ó, Drottinn, þú ert minn Guð! Hlustaðu á grátbeiðni mína! Láttu ekki svikráð níðinganna heppnast. <verse eid="PSA 140:7-8"/><verse number="9" style="v" sid="PSA 140:9"/>Láttu þá ekki ná árangri eða hreykja sér hátt. <verse eid="PSA 140:9"/><verse number="10" style="v" sid="PSA 140:10"/>Svikráð þeirra komi þeim sjálfum í koll! <verse eid="PSA 140:10"/><verse number="11" style="v" sid="PSA 140:11"/>Eldsglóðum rigni yfir þá. Steyptu þeim í gjár sem þeir komast ekki úr.<verse eid="PSA 140:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 140:12"/>Láttu lygara einskis ávinnings njóta í landi okkar, en refsaðu þeim í skyndi. <verse eid="PSA 140:12"/><verse number="13" style="v" sid="PSA 140:13"/>Drottinn mun örugglega rétta hlut fólks sem þolað hefur ofsóknir þeirra, hann mun flytja mál hinna snauðu. <verse eid="PSA 140:13"/><verse number="14" style="v" sid="PSA 140:14"/>Hinir guðhræddu þakka þér. Þeir fá að lifa í nálægð þinni.<verse eid="PSA 140:14"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 141:1"/>Drottinn, þú hefur hlustað á bæn mína, svaraðu mér fljótt! Heyr þegar ég hrópa til þín eftir hjálp. <verse eid="PSA 141:1"/><verse number="2" style="v" sid="PSA 141:2"/>Líttu á bæn mína sem kvöldfórn, eins og reykelsi sem stígur upp til þín.<verse eid="PSA 141:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 141:3"/>Hjálpaðu mér, Drottinn, að gæta munns míns – innsiglaðu varir mínar! <verse eid="PSA 141:3"/><verse number="4" style="v" sid="PSA 141:4"/>Frelsaðu mig frá löngun í hið illa. Forðaðu mér frá félagsskap við syndara og þeirra vondu verkum. Láttu mig sneiða hjá svallveislum þeirra. <verse eid="PSA 141:4"/><verse number="5" style="v" sid="PSA 141:5"/>Hirting frá guðhræddum manni er mér til góðs – hún er áhrifaríkt læknislyf! Ég vil ekki hlusta á hrós vondra manna. Ég bið gegn illsku þeirra og svikum. <verse eid="PSA 141:5"/><verse number="6-7" style="v" pubnumber="6,7" sid="PSA 141:6-7"/> Þegar foringjar þeirra fá sinn dóm, þegar þeim verður hrint fram af kletti, þá munu menn þessir hlusta á viðvörun mína og skilja að ég vildi þeim vel. <verse eid="PSA 141:6-7"/><verse number="8" style="v" sid="PSA 141:8"/>Drottinn, ég horfi til þín í von um hjálp. Þú ert skjól mitt. Láttu þá ekki tortíma mér. <verse eid="PSA 141:8"/><verse number="9" style="v" sid="PSA 141:9"/>Forðaðu mér frá gildrum þeirra. <verse eid="PSA 141:9"/><verse number="10" style="v" sid="PSA 141:10"/>Hinir óguðlegu falli í eigin net, en ég sleppi heill á húfi.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 142:1-2"/> Ég bið og bið til Drottins, stöðugt grátbæni ég hann. <verse eid="PSA 142:1-2"/><verse number="3" style="v" sid="PSA 142:3"/>Ég er hræddur og ráðvilltur. Þú einn þekkir leiðina framhjá gildrum óvina minna. <verse eid="PSA 142:3"/><verse number="4" style="v" sid="PSA 142:4"/>Enginn maður hugsar hlýtt til mín. Hvergi er góð ráð að fá. Öllum er sama um mig. <verse eid="PSA 142:4"/><verse number="5" style="v" sid="PSA 142:5"/>Því bið ég til Drottins og segi: „Drottinn, þú einn ert skjól mitt á jörðu, ég er hvergi öruggur nema hjá þér. <verse eid="PSA 142:5"/><verse number="6" style="v" sid="PSA 142:6"/>Heyrðu hróp mitt því að ég er mjög þjakaður. Frelsaðu mig frá þeim sem ofsækja mig, því að þeir eru mér yfirsterkari. <verse eid="PSA 142:6"/><verse number="7" style="v" sid="PSA 142:7"/>Leiddu mig úr þessum mikla vanda og þá mun ég lofa þig. Hinir guðhræddu munu þyrpast til mín og fagna með mér yfir hjálp þinni.“<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 143:1"/>Drottinn, heyrðu bæn mína. Svaraðu ákalli mínu, því að þú ert réttlátur og stendur við orð þín. <verse eid="PSA 143:1"/><verse number="2" style="v" sid="PSA 143:2"/>Leiddu mig ekki fyrir dóm, því að enginn er réttlátur frammi fyrir þér.<verse eid="PSA 143:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 143:3"/>Óvinir mínir eltu mig og náðu mér. Þeir slógu mig til jarðar og drógu mig inn í myrkrið – ég er eins og þeir sem gengnir eru til grafar. <verse eid="PSA 143:3"/><verse number="4" style="v" sid="PSA 143:4"/>Ég eygi enga von, er lamaður af ótta. <verse eid="PSA 143:4"/><verse number="5" style="v" sid="PSA 143:5"/>Ég hugsa um máttarverk þau sem þú vannst fyrir langa löngu. <verse eid="PSA 143:5"/><verse number="6" style="v" sid="PSA 143:6"/>Ég leita þín. Mig þyrstir eftir þér eins og örþrota land, skrælnað af þurrki. <verse eid="PSA 143:6"/><verse number="7" style="v" sid="PSA 143:7"/>Komdu skjótt, Drottinn og bjargaðu mér, því að ég er að örmagnast! Snúðu ekki við mér bakinu, því að þá væri úti um mig. <verse eid="PSA 143:7"/><verse number="8" style="v" sid="PSA 143:8"/>Sýndu mér miskunn þína að morgni, því að þér treysti ég. Sýndu mér þann veg er ég á að ganga, því að bæn mín er beðin í einlægni. <verse eid="PSA 143:8"/><verse number="9" style="v" sid="PSA 143:9"/>Frelsaðu mig undan óvinum mínum, Drottinn minn, ég vil flýja í skjól þitt. <verse eid="PSA 143:9"/><verse number="10" style="v" sid="PSA 143:10"/>Hjálpaðu mér að gera vilja þinn, því að þú ert minn Guð. Þinn góði andi leiði mig um réttan veg.<verse eid="PSA 143:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PSA 143:11"/>Drottinn, láttu mig lífi halda og leystu mig úr öllum þessum nauðum, því að þú ert réttlátur og veist að ég hef ekkert til saka unnið. <verse eid="PSA 143:11"/><verse number="12" style="v" sid="PSA 143:12"/>Ég er þjónn þinn. Þú elskar mig og ert mér svo góður! Ryð þú burt þessum óvinum mínum og láttu þá hverfa sem ofsækja mig.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 144:1"/>Lofaður sé Drottinn! Hann er bjargið sem líf mitt er byggt á! Hann gefur mér kraft og leikni í bardaga. <verse eid="PSA 144:1"/><verse number="2" style="v" sid="PSA 144:2"/>Hann er miskunn mín. Hann er vígi mitt, borg mín og hjálpari, skjöldur minn og athvarf. Hann leggur þjóðir undir mig.<verse eid="PSA 144:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 144:3"/>Drottinn, hvers virði er maðurinn að þú ómakir þig og minnist hans? Hvers vegna skyldir þú yfirleitt skipta þér af fólki? <verse eid="PSA 144:3"/><verse number="4" style="v" sid="PSA 144:4"/>Því að maðurinn er eins og vindblær, dagar hans eins og hverfandi skuggi.<verse eid="PSA 144:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 144:5"/>Drottinn, sveigðu himininn og stígðu niður! Þegar þú tyllir þér á fjöllin þá rýkur úr þeim. <verse eid="PSA 144:5"/><verse number="6" style="v" sid="PSA 144:6"/>Láttu eldingar leiftra, – skjóttu örvum þínum og tvístraðu óvinunum!<verse eid="PSA 144:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 144:7"/>Réttu hönd þína niður og frelsaðu mig, dragðu mig upp úr hinum djúpu vötnum, undan ofurvaldi óvinanna. <verse eid="PSA 144:7"/><verse number="8" style="v" sid="PSA 144:8"/>Munnur þeirra er fullur af svikum og með hægri hönd sinni innsigla þeir lygi.<verse eid="PSA 144:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PSA 144:9"/>Ég vil syngja þér nýjan söng, ó Guð, og leika undir á tístrengjaða hörpu, <verse eid="PSA 144:9"/><verse number="10" style="v" sid="PSA 144:10"/>því að þú veitir konungum okkar sigur. Þú frelsar þjón þinn Davíð undan sverði dauðans. <verse eid="PSA 144:10"/><verse number="11" style="v" sid="PSA 144:11"/>Bjargaðu mér! Frelsaðu mig undan óvinum þessum, þeir bæði ljúga og svíkja. <verse eid="PSA 144:11"/><verse number="12-15" style="v" sid="PSA 144:12-15"/>Nú vil ég lýsa landinu þar sem Drottinn er Guð – hamingjulandinu! Þar eru synirnir hraustir og stæltir eins og þróttmikil tré. Dæturnar fagrar og prúðar eins og úthöggnar hallarsúlur. Hlöðurnar fullar af alls konar afurðum. Hjarðir þúsunda sauða liðast um hagana. Uxarnir eru klyfjaðir og ekkert skarð í múrnum. Friður hvert sem litið er, enginn maður í útlegð og glæpir horfnir af strætunum. Já, sæl er sú þjóð sem á Drottin að Guði.<verse eid="PSA 144:12-15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="p">
    <verse number="1-2" style="v" pubnumber="1,2" sid="PSA 145:1-2"/> Ég vil lofa þig, þú Guð minn og konungur, og vegsama nafn þitt hvern einasta dag, já að eilífu! <verse eid="PSA 145:1-2"/><verse number="3" style="v" sid="PSA 145:3"/>Mikill er Drottinn! Lofið hann án afláts! Dýrð hans er meiri en við fáum skilið! <verse eid="PSA 145:3"/><verse number="4" style="v" sid="PSA 145:4"/>Sérhver kynslóð fræðir börn sín um hans mörgu dásemdarverk. <verse eid="PSA 145:4"/><verse number="5" style="v" sid="PSA 145:5"/>Ég vil íhuga dýrð þína og vegsemd, glæsileik þinn og kraftaverk. <verse eid="PSA 145:5"/><verse number="6" style="v" sid="PSA 145:6"/>Undur þín eru á allra vörum, ég vil tala um stórvirki þín. <verse eid="PSA 145:6"/><verse number="7" style="v" sid="PSA 145:7"/>Öllum er ljúft að segja frá kærleika þínum, syngja um réttlæti þitt. <verse eid="PSA 145:7"/><verse number="8" style="v" sid="PSA 145:8"/>Náðugur og miskunnsamur er Drottinn, seinn til reiði og fullur góðvildar. <verse eid="PSA 145:8"/><verse number="9" style="v" sid="PSA 145:9"/>Drottinn er öllum góður og miskunn hans hvílir yfir öllu sem hann hefur skapað. <verse eid="PSA 145:9"/><verse number="10" style="v" sid="PSA 145:10"/>Öll sköpunin þakkar þér Drottinn, og þjóð þín lofar þig. <verse eid="PSA 145:10"/><verse number="11" style="v" sid="PSA 145:11"/>Þau segja frá dýrð ríkis þíns, og tala um kraft þinn og mátt. <verse eid="PSA 145:11"/><verse number="12" style="v" sid="PSA 145:12"/>Þau víðfrægja mikilleik þinn og máttarverk – dýrð konungdóms þíns. <verse eid="PSA 145:12"/><verse number="13" style="v" sid="PSA 145:13"/>Því að á ríki þínu er enginn endir, veldi þitt nær frá kynslóð til kynslóðar.<verse eid="PSA 145:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PSA 145:14"/>Drottinn reisir við hina föllnu og styður þá sem ætla að hníga. <verse eid="PSA 145:14"/><verse number="15" style="v" sid="PSA 145:15"/>Allra augu mæna á þig eftir hjálp, því að þú gefur þeim fæðu þeirra á réttum tíma. <verse eid="PSA 145:15"/><verse number="16" style="v" sid="PSA 145:16"/>Þú uppfyllir þarfir þeirra og blessar þá.<verse eid="PSA 145:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PSA 145:17"/>Drottinn er réttlátur og miskunnsamur í öllu sem hann gerir. <verse eid="PSA 145:17"/><verse number="18" style="v" sid="PSA 145:18"/>Hann er nálægur öllum sem ákalla hann í einlægni. <verse eid="PSA 145:18"/><verse number="19" style="v" sid="PSA 145:19"/>Hann uppfyllir þarfir þeirra sem óttast hann og elska. Hann heyrir hróp þeirra og hjálpar þeim. <verse eid="PSA 145:19"/><verse number="20" style="v" sid="PSA 145:20"/>Hann verndar alla þá sem elska hann, en útrýmir öllum óguðlegum.<verse eid="PSA 145:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PSA 145:21"/>Ég vil lofa Drottin! Og þið öll, vegsamið hans heilaga nafn á meðan ævi ykkar endist.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 146:1"/>Dýrð sé Guði! Já, ég vil vegsama hann! <verse eid="PSA 146:1"/><verse number="2" style="v" sid="PSA 146:2"/>Ég vil lofa hann á meðan ég lifi, vegsama hann fram á síðustu stund.<verse eid="PSA 146:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 146:3"/>Reiddu þig ekki á hjálp valdsmanna, því að þeir falla og ekkert verður úr aðstoð þeirra. <verse eid="PSA 146:3"/><verse number="4" style="v" sid="PSA 146:4"/>Þeir munu deyja og andi þeirra líður burt, áform þeirra verða að engu. <verse eid="PSA 146:4"/><verse number="5" style="v" sid="PSA 146:5"/>En sæll er sá maður sem reiðir sig á hjálp Guðs, Guðs Jakobs, sem vonar á Drottin, Guð sinn <verse eid="PSA 146:5"/><verse number="6" style="v" sid="PSA 146:6"/>– þann Guð sem skapaði himin og jörð og hafið og allt sem í því er. Hann er sá Guð sem óhætt er að treysta! <verse eid="PSA 146:6"/><verse number="7" style="v" sid="PSA 146:7"/>Hann leitar réttar fátækra og kúgaðra og gefur hungruðum brauð. Hann frelsar fanga, <verse eid="PSA 146:7"/><verse number="8" style="v" sid="PSA 146:8"/>opnar augu blindra, lyftir okinu af þeim sem eru að bugast. Drottinn elskar þá sem gera rétt. <verse eid="PSA 146:8"/><verse number="9" style="v" sid="PSA 146:9"/>Hann verndar útlendingana sem sest hafa að í landinu og gætir réttinda ekkna og einstæðinga, en ónýtir ráðabrugg vondra manna.<verse eid="PSA 146:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PSA 146:10"/>Drottinn mun ríkja að eilífu. Jerúsalem, veistu að Drottinn er konungur að eilífu?! Hallelúja!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 147:1"/>Hallelúja! Já, lofið Drottin! Það er gott að lofa Drottin! Indælt og rétt!<verse eid="PSA 147:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 147:2"/>Hann er að endurreisa Jerúsalem og flytja hina herleiddu heim. <verse eid="PSA 147:2"/><verse number="3" style="v" sid="PSA 147:3"/>Hann reisir upp hina niðurbeygðu og bindur um sár þeirra.<verse eid="PSA 147:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PSA 147:4"/>Hann þekkir fjölda stjarnanna, já og hverja fyrir sig með nafni! <verse eid="PSA 147:4"/><verse number="5" style="v" sid="PSA 147:5"/>Mikill er Drottinn! Vald hans er stórkostlegt! Þekking hans er takmarkalaus. <verse eid="PSA 147:5"/><verse number="6" style="v" sid="PSA 147:6"/>Drottinn styður auðmjúka, en varpar illmennum til jarðar. <verse eid="PSA 147:6"/><verse number="7" style="v" sid="PSA 147:7"/>Syngið honum þakkarljóð, lofið Guð með hörpuleik. <verse eid="PSA 147:7"/><verse number="8" style="v" sid="PSA 147:8"/>Hann fyllir himininn skýjum, gefur steypiregn og klæðir fjöllin grænu grasi. <verse eid="PSA 147:8"/><verse number="9" style="v" sid="PSA 147:9"/>Hann fæðir hin villtu dýr og hrafnarnir krunka til hans eftir æti. <verse eid="PSA 147:9"/><verse number="10" style="v" sid="PSA 147:10"/>Í hans augum kemst sprettharður foli varla úr sporunum og máttur mannsins má sín lítils. <verse eid="PSA 147:10"/><verse number="11" style="v" sid="PSA 147:11"/>En hann gleðst yfir þeim sem elska hann og reiða sig á kærleika hans og gæsku.<verse eid="PSA 147:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PSA 147:12"/>Lofa þú hann, Jerúsalem! Vegsama Guð þinn, Síon! <verse eid="PSA 147:12"/><verse number="13" style="v" sid="PSA 147:13"/>Því að hann hefur gert múra þína öfluga og blessað börnin þín. <verse eid="PSA 147:13"/><verse number="14" style="v" sid="PSA 147:14"/>Hann lætur frið haldast í landinu og fyllir hlöður þínar af úrvals hveiti. <verse eid="PSA 147:14"/><verse number="15" style="v" sid="PSA 147:15"/>Hann sendir boð sín til jarðar, skipanir hans berast hratt eins og vindurinn. <verse eid="PSA 147:15"/><verse number="16" style="v" sid="PSA 147:16"/>Skjannahvít mjöllin er frá honum komin og hrímið sem glitrar á jörðinni. <verse eid="PSA 147:16"/><verse number="17" style="v" sid="PSA 147:17"/>Haglélið er líka hans verk og frostið sem bítur í kinnarnar. <verse eid="PSA 147:17"/><verse number="18" style="v" sid="PSA 147:18"/>En síðan sendir hann hlýjan vorvind, snjórinn þiðnar og árnar ryðja sig. <verse eid="PSA 147:18"/><verse number="19" style="v" sid="PSA 147:19"/>Hann kunngjörði Ísrael lögmál sitt og ákvæði <verse eid="PSA 147:19"/><verse number="20" style="v" sid="PSA 147:20"/>– það hefur hann ekki gert við neina aðra þjóð, nei, þeim kennir hann ekki fyrirmæli sín.</para>
  <para style="p" vid="PSA 147:20">Hallelúja! Dýrð sé Drottni!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 148:1"/>Þið sem búið á himnum, lofið Drottin! Lofið hann í upphæðum!<verse eid="PSA 148:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 148:2"/>Lofið hann allir englar, allar hersveitir himnanna. <verse eid="PSA 148:2"/><verse number="3" style="v" sid="PSA 148:3"/>Lofið hann sól og tungl og allar lýsandi stjörnur. <verse eid="PSA 148:3"/><verse number="4" style="v" sid="PSA 148:4"/>Lofið hann hæstu himnar og þú dögg er svífur um háloftin.<verse eid="PSA 148:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PSA 148:5"/>Allt sem hann hefur skapað lofi nafn hans, því að þegar hann talaði, þá varð það allt til, <verse eid="PSA 148:5"/><verse number="6" style="v" sid="PSA 148:6"/>hann fékk þeim stað um aldur og ævi, setti þeim lögmál sem þau fá ekki brotið.<verse eid="PSA 148:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 148:7"/>Lofið Drottin einnig á jörðu, líka þið skepnur í hafdjúpunum. <verse eid="PSA 148:7"/><verse number="8" style="v" sid="PSA 148:8"/>Eldur og hagl, snjór, regn, vindur og veður öll, – allt hlýði það Drottni. <verse eid="PSA 148:8"/><verse number="9" style="v" sid="PSA 148:9"/>Allt skal þetta lofa Drottin: fjöll og hæðir, ávaxtatré sem önnur tré, <verse eid="PSA 148:9"/><verse number="10" style="v" sid="PSA 148:10"/>villidýr og búfé, höggormar og fuglar <verse eid="PSA 148:10"/><verse number="11" style="v" sid="PSA 148:11"/>konungar og allar þjóðir, höfðingjar og dómarar, <verse eid="PSA 148:11"/><verse number="12" style="v" sid="PSA 148:12"/>piltar og stúlkur, aldraðir og börn. <verse eid="PSA 148:12"/><verse number="13" style="v" sid="PSA 148:13"/>Sameiginlega skulu þau lofa Drottin, því að hann einn er þess verður og dýrð hans er ofar himni og jörðu. <verse eid="PSA 148:13"/><verse number="14" style="v" sid="PSA 148:14"/>Hann hefur gert þjóð sína volduga. Heldur uppi heiðri hinna guðhræddu – lýðs Ísraels, þjóðarinnar sem honum stendur næst. Hallelúja! Dýrð sé Drottni!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 149:1"/>Hallelúja! Lofið Drottin! Syngið honum nýjan söng. Lofsyngið honum öll þjóðin.<verse eid="PSA 149:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PSA 149:2"/>Ó, Ísrael, gleð þig yfir skapara þínum. Þið sem búið í Jerúsalem, fagnið yfir konungi ykkar! <verse eid="PSA 149:2"/><verse number="3" style="v" sid="PSA 149:3"/>Lofið nafn hans með gleðidansi og leikið fyrir hann á bumbur og gígjur.<verse eid="PSA 149:3"/></para>
  <para style="p">
    <verse number="4-5" style="v" pubnumber="4,5" sid="PSA 149:4-5"/> Drottinn hefur unun af lýð sínum. Hann frelsar hina auðmjúku. Hinir trúuðu gleðjist með sæmd og syngi fagnandi í hvílum sínum.<verse eid="PSA 149:4-5"/></para>
  <para style="p">
    <verse number="6-7" style="v" pubnumber="6,7" sid="PSA 149:6-7"/> Lofið hann, þið fólk hans! Framkvæmið refsingu hans á þjóðunum með tvíeggjuðu sverði. <verse eid="PSA 149:6-7"/><verse number="8" style="v" sid="PSA 149:8"/>Setjið konunga þeirra og fyrirmenn í járn og fullnægið á þeim skráðum dómi. Drottinn er vegsemd þjóðar sinnar. Hallelúja!<verse eid="PSA 149:8"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="p">
    <verse number="1" style="v" sid="PSA 150:1"/>Hallelúja! Lofið Drottin! Lofið hann í musteri hans, lofið hann á himnum. <verse eid="PSA 150:1"/><verse number="2" style="v" sid="PSA 150:2"/>Lofið hann fyrir máttarverk hans. Lofið hann fyrir mikilleik hátignar hans.<verse eid="PSA 150:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PSA 150:3"/>Lofið hann með lúðrablæstri, hörpu og gígju. <verse eid="PSA 150:3"/><verse number="4" style="v" sid="PSA 150:4"/>Lofið hann með strengjaleik og hjarðpípum. <verse eid="PSA 150:4"/><verse number="5" style="v" sid="PSA 150:5"/>Lofið hann með hljómandi skálabumbum, já og með hvellum skálabumbum!<verse eid="PSA 150:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 150:6"/>Allt sem andardrátt hefur lofi Drottin! Einnig þú! Hallelúja!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
