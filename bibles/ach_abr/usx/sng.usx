<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id" />
  <para style="h">WER PA SOLOMON</para>
  <para style="toc1">Wer pa Solomon</para>
  <para style="toc2">Wer pa Solomon</para>
  <para style="toc3">Wer</para>
  <para style="mt2">Wer pa</para>
  <para style="mt1">SOLOMON</para>
  <para style="imt">Lanyut wilok madito ma i buk man</para>
  <para style="ip">Buk me <char style="bk">Wer pa Solomon </char> obedo wer me mar makato ducu, ma jo matye ki mar ikin gi gikore kwede. Man tye wer ma laco wero bot dako ki ma dako wero bot laco. Buk man me wer me yomo cwiny makato ducu, jo mukene gilwongo ni, <char style="bk">Wer mamit </char> Lujudaya gumiyo woro ki Solomon macalo ngat ma ocoyo buk man ma oweko kilwongo ki nyinge.</para>
  <para style="ip">Wer man ki bot Lujudaya nyutu kit cal wat matye ikin Lubanga ki jone jo Icrael, dok bene ki tung bot jo muye, man nyutu kit wat matye ikin Kricito ki Kanica.</para>
  <para style="iot">Lacim wilok madito ma i buk man</para>
  <para style="io1">Wer mukwongo <char style="ior"><ref loc="SNG 1:1-2:7">1:1—2:7</ref></char></para>
  <para style="io1">Wer me aryo <char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref></char></para>
  <para style="io1">Wer me adek <char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref></char></para>
  <para style="io1">Wer me angwen <char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref></char></para>
  <para style="io1">Wer me abic <char style="ior"><ref loc="SNG 6:4-8:4">6:4—8:4</ref></char></para>
  <para style="io1">Wer me abicel <char style="ior"><ref loc="SNG 8:5-14">8:5-14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:32">1 Luk 4:32</ref>
      </char>
    </note>Man wer ma mwonya makato wer mukene ducu ma Solomon ocoyo.<verse eid="SNG 1:1" /></para>
  <para style="s">Wer mukwongo</para>
  <para style="sp">Wer pa nyako</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />Kono kong ikwako kora ki badi do,</para>
  <para style="q1" vid="SNG 1:2">mar meri ma itye kwede ikoma ber ma kato kongo bwino.<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />Nyingi longo matek adada,</para>
  <para style="q1" vid="SNG 1:3">dok calo moo wir i del komi;</para>
  <para style="q1" vid="SNG 1:3">Pimeno mon ducu gimari.<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />Wek alub kori, iwek wawot wacit woko oyotoyot;</para>
  <para style="q1" vid="SNG 1:4">bed rwot ma mera, ci itera wa i kicikani.</para>
  <para style="q1" vid="SNG 1:4">Ci wabibedo ki yomcwiny;</para>
  <para style="q1" vid="SNG 1:4">makato yomcwiny ma kongo bwino mamit kelo.</para>
  <para style="q1" vid="SNG 1:4">Pe ibed ki wur pien mon ducu gimari!<verse eid="SNG 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />Wun anyira Jerucalem; an acol matek, ento amwonya kwede,</para>
  <para style="q1" vid="SNG 1:5">anen mwonya mada calo kema pa jo Kedar,</para>
  <para style="q1" vid="SNG 1:5">anen maber calo bongi me kicika pa Solomon.<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />Pe myero wucik wangwu wunena ki cac pi rangi del komani,</para>
  <para style="q1" vid="SNG 1:6">pien lyeto me ceng ocido koma woko.</para>
  <para style="q1" vid="SNG 1:6">Kiniga omako omegina ikoma,</para>
  <para style="q1" vid="SNG 1:6">ci guketo an abedo katic i poti olok;</para>
  <para style="q1" vid="SNG 1:6">oweko pe abedo ki kare me yubu koma.<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />Tita, in ma amaro ki cwinya ducu,</para>
  <para style="q1" vid="SNG 1:7">ibitero romini kacam tung kwene?</para>
  <para style="q1" vid="SNG 1:7">Gibiywe kwene i dyeceng?</para>
  <para style="q1" vid="SNG 1:7">Imito abed kayenyi ayenya pingo</para>
  <para style="q1" vid="SNG 1:7">ikin romi pa lukwat luwoti?<verse eid="SNG 1:7" /></para>
  <para style="sp">Wer pa laco</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />In pe ingeyo kakare ce, in nyako ma nen mwonya makato mon ducuni?</para>
  <para style="q1" vid="SNG 1:8">Cit ilub kor romi,</para>
  <para style="q1" vid="SNG 1:8">wek inong kacam pa dyegini</para>
  <para style="q1" vid="SNG 1:8">kama cok ki kema pa lukwat.<verse eid="SNG 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />In nyako ma amaro,</para>
  <para style="q1" vid="SNG 1:9">aporo beri ki ber pa min aguragura ma ringo ki gadigadi pa Parao.<verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />Iruku ruk me deyo i iti ryoryo ducu ma omiyo inen mwonya mada,</para>
  <para style="q1" vid="SNG 1:10">iruku jami me welgu ma kirubu ki tol i nguti.<verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />Wabiyubu ruk me deyo ki jabu piri,</para>
  <para style="q1" vid="SNG 1:11">ma tiko ngute ducu bedo me ryal keken.<verse eid="SNG 1:11" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />Ikare ma rwota obedo i kayweyone,</para>
  <para style="q1" vid="SNG 1:12">ci moona ma ngwece kur ocako duny ma ngwece otyeko romo i piny woko.<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />En ngat ma amaroni pire tek bota calo adomo moo makur,</para>
  <para style="q1" vid="SNG 1:13">ka obutu ikora.<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />En ngat ma amaroni pire teka calo pi ature me tim ma turu maber adada</para>
  <para style="q1" vid="SNG 1:14">ma turu i poti olok matye i En-gedi.<verse eid="SNG 1:14" /></para>
  <para style="sp">Wer pa laco</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />Nen, in ma amaroni inen mwonya mada;</para>
  <para style="q1" vid="SNG 1:15">dok wangi bene ryeny aryenya ki mar macalo kom amam.<verse eid="SNG 1:15" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />Nen, in ma amaroni, inen ber adada,</para>
  <para style="q1" vid="SNG 1:16">ada neni yomo cwinya matek.</para>
  <para style="q1" vid="SNG 1:16">Lum alita aye bibedo kabutuwa</para>
  <para style="q1" vid="SNG 1:16">Wabibutu iwi lum ma pud olot alota.<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />Jang yadi me cedar aye bibedo rii me otwa,</para>
  <para style="q1" vid="SNG 1:17">ki bao me ciprec aye bibedo kwori me dan otwa.<verse eid="SNG 1:17" /></para>
  <para style="b" />
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />An acal ki ature ma i bar Caron,</para>
  <para style="q1" vid="SNG 2:1">nyo lenga ma aturene kwar ma maro twi i nota.<verse eid="SNG 2:1" /></para>
  <para style="sp">Wer pa laco</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Nyako ma amaroni rom ki ature lenga ma odongo ikin okutu,</para>
  <para style="q1" vid="SNG 2:2">ikin anyira luwote.<verse eid="SNG 2:2" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />En laco ma amaroni calo yat acuga</para>
  <para style="q1" vid="SNG 2:3">ma ikin yadi ma i bunga,</para>
  <para style="q1" vid="SNG 2:3">ka aporo en ki co mukene.</para>
  <para style="q1" vid="SNG 2:3">Dok amaro bedo ite tipune,</para>
  <para style="q1" vid="SNG 2:3">bedone kangeta romaroma ki camo nyig yat ma lim.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />Ci okelo an i ot me karamane,</para>
  <para style="q1" vid="SNG 2:4">ki benderane ma en otingo pira aye mar.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Miya acam olok ma otwone,</para>
  <para style="q1" vid="SNG 2:5">dok wek acam acuga wek koma olim tek;</para>
  <para style="q1" vid="SNG 2:5">pien mar omiya adoko latwo kombedi.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Kono ateno wiya ikom cinge ma lacam,</para>
  <para style="q1" vid="SNG 2:6">kun nongo en ogwaka ki cinge ma lacuc.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />Wukwonge bota, wun anyira Jerucalem,</para>
  <para style="q1" vid="SNG 2:7">ki nying bure ki til me tim,</para>
  <para style="q1" vid="SNG 2:7">ni pe wubibalo mitiwa.<verse eid="SNG 2:7" /></para>
  <para style="s1">Wer me aryo</para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Ci awinyo dwon laco ma amaroni.</para>
  <para style="q1" vid="SNG 2:8">Nen, en tye kabino ca,</para>
  <para style="q1" vid="SNG 2:8">tye karingo aringa ki iwi godi,</para>
  <para style="q1" vid="SNG 2:8">tye karingo ki iwi ceregu kun laro tung bota.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Laco ma amaroni obedo calo bure, nyo calo twon til.</para>
  <para style="q1" vid="SNG 2:9">Nen, en ocung inge celwa ca,</para>
  <para style="q1" vid="SNG 2:9">ci ociko wange tye kaneno piny ki i wang ot,</para>
  <para style="q1" vid="SNG 2:9">dok obedo kanena ki ikor ot ma obar.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />En laco ma amaroni tye kalok kweda.</para>
  <para style="sp" vid="SNG 2:10">Wer pa laco</para>
  <para style="q1" vid="SNG 2:10">A ibin, in ma amaro,</para>
  <para style="q1" vid="SNG 2:10">in nyako maber atika, a ibin waciti.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Nen, kare me cwir dong okato woko</para>
  <para style="q1" vid="SNG 2:11">ki kot dong bene ocok woko matwal.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Ature dong ocako turu i lobo,</para>
  <para style="q1" vid="SNG 2:12">kare me wer dong aye en,</para>
  <para style="q1" vid="SNG 2:12">akuri tye kakoko</para>
  <para style="q1" vid="SNG 2:12">ma dwone winye wa i lobowa.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Oduru ocako nyako nyige,</para>
  <para style="q1" vid="SNG 2:13">ki olok bene tye katuru;</para>
  <para style="q1" vid="SNG 2:13">ngwec aturene tye kaduny makur.</para>
  <para style="q1" vid="SNG 2:13">A ibin, in ma amaroni, laberi,</para>
  <para style="q1" vid="SNG 2:13">bin wacit kacel kwedi.<verse eid="SNG 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />In ikane calo akuri ikin got ma obar</para>
  <para style="q1" vid="SNG 2:14">i kakane matye i kor got ma wiye bit:</para>
  <para style="q1" vid="SNG 2:14">wek anen wangi maberi do,</para>
  <para style="q1" vid="SNG 2:14">dok awiny dwoni mamit tutwali.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />Wumak co ma girom ki too matinoni woko, ma gibalo poto olok,</para>
  <para style="q1" vid="SNG 2:15">pien olokwa dong tye katuru.<verse eid="SNG 2:15" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Laco ma amaroni mera kikome ki an bene amere.</para>
  <para style="q1" vid="SNG 2:16">En kwayo romine ikin lenga ma oturu<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />nio wang ma yamo me odiko ocako kodo mangic,</para>
  <para style="q1" vid="SNG 2:17">ma colpiny dong peke.</para>
  <para style="q1" vid="SNG 2:17">Loke idwog cen, in laco ma amaroni</para>
  <para style="q1" vid="SNG 2:17">calo bure nyo wod til ma pud tidi matye iwi godi.<verse eid="SNG 2:17" /></para>
  <para style="b" />
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />Abutu anino i kabutuna dyewor benebene,</para>
  <para style="q1" vid="SNG 3:1">abedo kaleko lek ikom en ma amaroni:</para>
  <para style="q1" vid="SNG 3:1">ci abedo kayenyone, ento pe amedo ki nonge;</para>
  <para style="q1" vid="SNG 3:1">ka alwongo en, ento en pe ogamo doga.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Abia kombedi acito arumu taun madit woko,</para>
  <para style="q1" vid="SNG 3:2">abiwoto wa i dye gudugu ki wa ikacokegu.</para>
  <para style="q1" vid="SNG 3:2">Abibedo kayenyo en ngat ma amaroni.</para>
  <para style="q1" vid="SNG 3:2">Ayenye, ento pe amedo ki nonge.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />Lukurpiny ma onongo gitye kawot me longo dye taun madit gunonga.</para>
  <para style="q1" vid="SNG 3:3">Ci an apenyogi ni, “Wuneno en ngat ma amaroni?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Ikare ma akato lukurpiny manok,</para>
  <para style="q1" vid="SNG 3:4">ci atugi nongo en ma amaroni woko cut.</para>
  <para style="q1" vid="SNG 3:4">Akwako kore, ma pe onongo atwero weko en ni ocit ka mo</para>
  <para style="q1" vid="SNG 3:4">nio ka dong akelo en wa i ot pa maa,</para>
  <para style="q1" vid="SNG 3:4">wa i kicika ot pa maa ma onywalani.<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />Wukwonge bota, wun anyira Jerucalem, ki nying bure ki til me tim,</para>
  <para style="q1" vid="SNG 3:5">ni pe wubibalo mitiwa.<verse eid="SNG 3:5" /></para>
  <para style="s1">Wer me adek</para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Meno kono anga ma a ki i tim matye kabinoni kun dunyu apwa, calo yito ma duny,</para>
  <para style="q1" vid="SNG 3:6">kun ngwec kome calo ngwec mura ki odok eceta ma kiomo ki loka nam,</para>
  <para style="q1" vid="SNG 3:6">ma obedo angwece ma lucatwil gicatoni?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Nen, gitye katingo Solomon ki kitarane maber;</para>
  <para style="q1" vid="SNG 3:7">dok jo ma gin oteka lweny ma romo pyere abicel aye gurume,</para>
  <para style="q1" vid="SNG 3:7">co ma gin oyita lweny me i Icrael.<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />Gin ducu jo makwiri i tic ki pala lucwangu,</para>
  <para style="q1" vid="SNG 3:8">dok gungiyo ki lweny.</para>
  <para style="q1" vid="SNG 3:8">Kun dano acel acel ikin gi tye ki pala lucwane ma otweyo i eme,</para>
  <para style="q1" vid="SNG 3:8">ma dong gikuru gin mo keken ma time i wor.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Kitingo rwot Solomon ki kitara</para>
  <para style="q1" vid="SNG 3:9">ma kiyubu ki bao mabeco adada me yadi me Lebanon.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Wir ma kiketo me wiye kitiyo ki ryal,</para>
  <para style="q1" vid="SNG 3:10">ci ngeye kitiyo ki jabu, ki kabedone oumu ki bongo ma obedo lamarlamar.</para>
  <para style="q1" vid="SNG 3:10">Ki tung iye kideyo maber tutwal,</para>
  <para style="q1" vid="SNG 3:10">ma anyira Jerucalem aye guyubu pi cwiny me mar ma gitye kwede.<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />Wun anyira Cion, wubin wunen rwot Solomon.</para>
  <para style="q1" vid="SNG 3:11">Ma en oruku lalukana ma mine oketo iwiye</para>
  <para style="q1" vid="SNG 3:11">inino ma onyomo iye dakone,</para>
  <para style="q1" vid="SNG 3:11">inino ma en obedo kwede ki yomcwiny madwong.<verse eid="SNG 3:11" /></para>
  <para style="b" />
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Wer pa laco</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />Nen, inen mwonya mada, in nyako ma amaro,</para>
  <para style="q1" vid="SNG 4:1">pien in iber adada!</para>
  <para style="q1" vid="SNG 4:1">Wangi tye karyeny aryenya ki inge kitambara me wii.</para>
  <para style="q1" vid="SNG 4:1">Yer wii tye macol dok boco kun ocung lijur calo lwak dyegi,</para>
  <para style="q1" vid="SNG 4:1">ma giwoto gicito piny i kor got Gilead.<verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />Laki tar calo megi romi matar</para>
  <para style="q1" vid="SNG 4:2">ma dong kingolo yer komgi woko,</para>
  <para style="q1" vid="SNG 4:2">ci kilwokogi.</para>
  <para style="q1" vid="SNG 4:2">Gin ducu guryeyo gukeme ki wadgi,</para>
  <para style="q1" vid="SNG 4:2">pe tye mo acel ikin gi ma orwenyo.<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />Del dogi kwar calo uci makwar,</para>
  <para style="q1" vid="SNG 4:3">dok bedo me yomcwiny mada bota me winyo lok ma iloko.</para>
  <para style="q1" vid="SNG 4:3">Lemi ducu nongo opong woko calo nyig pomegranat ma kipoko iye i dul aryo,</para>
  <para style="q1" vid="SNG 4:3">ma nen ki inge kitambara me wii.<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />Nguti bor calo ot pa Daudi ma wiye ocudu malo,</para>
  <para style="q1" vid="SNG 4:4">ma kigero ityeng me gweng,</para>
  <para style="q1" vid="SNG 4:4">ma kingabo iye kwot ma romo alip acel kulu,</para>
  <para style="q1" vid="SNG 4:4">ma gin ducu kwot pa oluma oteka lweny.<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />Tununi ryoryo ducu nen calo bure aryo,</para>
  <para style="q1" vid="SNG 4:5">calo lutino til aryo ma gin rudi,</para>
  <para style="q1" vid="SNG 4:5">ma gitye kacam ikin lenga ma oturu.<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />Abibedo iwi got me mura,</para>
  <para style="q1" vid="SNG 4:6">ki iwi cere me odok luban,</para>
  <para style="q1" vid="SNG 4:6">nio wang ma yamo me odiko ocako kodo mangic,</para>
  <para style="q1" vid="SNG 4:6">ki nio wang ma colpiny dong peke.<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />In inen mwonya mada, nyako ma amaro,</para>
  <para style="q1" vid="SNG 4:7">dok bene pe tye gin mo marac ikomi.<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />A woko ki iwi got Lebanon,</para>
  <para style="q1" vid="SNG 4:8">in nyako ger ma mera;</para>
  <para style="q1" vid="SNG 4:8">a woko ki i Lebanon ibin bota.</para>
  <para style="q1" vid="SNG 4:8">Lor ibin piny ki iwi got Amana,</para>
  <para style="q1" vid="SNG 4:8">ki iwi got Cenir ki got Kermon,</para>
  <para style="q1" vid="SNG 4:8">kama lwak labwor ki kwac gibedo iye.<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />Ka aneno wangi, in gin amarana, in nyako ger ma mera,</para>
  <para style="q1" vid="SNG 4:9">ki tiko ma iruku ingutini,</para>
  <para style="q1" vid="SNG 4:9">otyeko lok woko ki i cwinya liweng.<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />Mar ma ibedo kwede ikoma miya yomcwiny madit,</para>
  <para style="q1" vid="SNG 4:10">in gin amarana, in nyako ger ma mera,</para>
  <para style="q1" vid="SNG 4:10">mar ma itye kwede ikoma kato kongo mamit woko,</para>
  <para style="q1" vid="SNG 4:10">dok ngwec mooni kur kato angwece makur ducu.<verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />Nyako ma amaro, dogi lim calo kic,</para>
  <para style="q1" vid="SNG 4:11">lebi mit bota calo cak ki moo kic.</para>
  <para style="q1" vid="SNG 4:11">Ngwec bongini duny makur</para>
  <para style="q1" vid="SNG 4:11">calo angwece me yadi cedar me Lebanon.<verse eid="SNG 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />Nyako ger ma mera ma amaro, en poto me mung,</para>
  <para style="q1" vid="SNG 4:12">poto ma kirumu woko ki cel,</para>
  <para style="q1" vid="SNG 4:12">wang it ma kimwono woko maber.<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />Ginapita dongo kunu maber atika.</para>
  <para style="q1" vid="SNG 4:13">Gidongo calo yadi pomegranat</para>
  <para style="q1" vid="SNG 4:13">ma ginyako nyig mabeco makato ducu.</para>
  <para style="q1" vid="SNG 4:13">Kunu tye iye lwak ature makur ki yadi me moo nard ma ngwecgi kur,<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />yadi me moo ki lenga ki lum ma ngwecgi kur ki yadi me odok luban,</para>
  <para style="q1" vid="SNG 4:14">ki yadi me moo mura ki moo mukene ma ngwecgi kur,</para>
  <para style="q1" vid="SNG 4:14">ki kit yadi ducu mapatpat ma ngwecgi kur gidongo kunu.<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />In ibedo wang it ma piine bido ngom ma i poto,</para>
  <para style="q1" vid="SNG 4:15">ma piine gunye molamola,</para>
  <para style="q1" vid="SNG 4:15">ma mol a ki ikom got Lebanon cito piny i ora kulu.<verse eid="SNG 4:15" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />Coo woko, in yamo me tung kumalo,</para>
  <para style="q1" vid="SNG 4:16">in yamo me tung kupiny bene ibin, ikod i potona;</para>
  <para style="q1" vid="SNG 4:16">wek ngwec yamone obed makur ma duny o wa kamabor.</para>
  <para style="q1" vid="SNG 4:16">Wek laco ma amaroni obin i potone</para>
  <para style="q1" vid="SNG 4:16">ocam kit nyig yadi ducu mabeco ma iye mito.<verse eid="SNG 4:16" /></para>
  <para style="b" />
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Wer pa laco</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />An dong atyeko bino i potona,</para>
  <para style="q1" vid="SNG 5:1">In gin amarana, nyako ger ma mera.</para>
  <para style="q1" vid="SNG 5:1">Dong atye kapwono mura ki angwece,</para>
  <para style="q1" vid="SNG 5:1">atye kacamo moo kic ma mera ki peda kic:</para>
  <para style="q1" vid="SNG 5:1">atye kamato kongo bwinona kacel ki cak ma mera.</para>
  <para style="sp" vid="SNG 5:1">Wer pa anyira Jerucalem</para>
  <para style="q1" vid="SNG 5:1">Wun luremwa, wumat mat dok wucam,</para>
  <para style="q1" vid="SNG 5:1">nio wang ma mar oromowu!<verse eid="SNG 5:1" /></para>
  <para style="b" />
  <para style="s1">Wer me angwen</para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />Abedo kanino, ento cwinya bedo kalwodo lok.</para>
  <para style="q1" vid="SNG 5:2">Awinyo ka en ma amaroni dwongo dogola.</para>
  <para style="sp" vid="SNG 5:2">Wer pa laco</para>
  <para style="q1" vid="SNG 5:2">Yaba dogola do in gin amarana,</para>
  <para style="q1" vid="SNG 5:2">nyako ma amaro ma yomo cwinya,</para>
  <para style="q1" vid="SNG 5:2">in ileng calo akuri, pe tye gin mo ma orem ikomi.</para>
  <para style="q1" vid="SNG 5:2">Toyo odyako wiya woko,</para>
  <para style="q1" vid="SNG 5:2">ki lupuu ma duny i dyewor bene omwono yer wiya woko.<verse eid="SNG 5:2" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Dong atyeko lunyu bongona woko, imito dok aruk aye?</para>
  <para style="q1" vid="SNG 5:3">Dong atyeko lwoko tyena woko bene,</para>
  <para style="q1" vid="SNG 5:3">imito dok anywangi woko ki ngom?<verse eid="SNG 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />En ma amaroni orwako cinge iwang kika,</para>
  <para style="q1" vid="SNG 5:4">ci cwinya opoto niling.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Ikare ma aa kayabo dogola bot en ma amaroni,</para>
  <para style="q1" vid="SNG 5:5">ci cinga odyak woko ki moo mura,</para>
  <para style="q1" vid="SNG 5:5">lweta ducu odyak woko ki pig mura maliyo,</para>
  <para style="q1" vid="SNG 5:5">ikom lalor ma kimako ka kiyabo kwede dogola.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Ci ayabo dogola bot en ma amaroni,</para>
  <para style="q1" vid="SNG 5:6">ento anongo ni en dong oloke ocito woko.</para>
  <para style="q1" vid="SNG 5:6">Ikare ma nene en olokoni tipu koma oto woko lirut.</para>
  <para style="q1" vid="SNG 5:6">Ayenye tutwal ento pe amedo ki nonge;</para>
  <para style="q1" vid="SNG 5:6">alwonge bene kwe, ci en pe ogamo doga.<verse eid="SNG 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />Ka lukurpiny ma gubedo ka longo dye taun maditi gunonga;</para>
  <para style="q1" vid="SNG 5:7">ci gugoya dok guketo ret ikoma,</para>
  <para style="q1" vid="SNG 5:7">dok lukurpiny meno ma gikuru cel me taun maditi</para>
  <para style="q1" vid="SNG 5:7">gulunyu bongona me lageng koyo woko ki ikoma.<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />Wukwonge bota, wun anyira Jerucalem,</para>
  <para style="q1" vid="SNG 5:8">ka wunongo en ngat ma amaroni,</para>
  <para style="q1" vid="SNG 5:8">wutite ni mar kombedi omiya adoko latwo.<verse eid="SNG 5:8" /></para>
  <para style="sp">Wer pa anyira Jerucalem</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />In nyako maber ma nen mwonya makato anyira ducuni,</para>
  <para style="q1" vid="SNG 5:9">titiwa kit ngat ma imaroni.</para>
  <para style="q1" vid="SNG 5:9">Kit gin ango ma miyo kitwero bedo ki ur pire,</para>
  <para style="q1" vid="SNG 5:9">ma omiyo icikowa kuman?<verse eid="SNG 5:9" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />En ngat ma amaroni nen maber dok kome kwar ma nen mwonya,</para>
  <para style="q1" vid="SNG 5:10">en nen woko kamaleng kadi ka tye ikin jo alip apar.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Yer wiye boco dok omine amina</para>
  <para style="q1" vid="SNG 5:11">yere col calo kom okur,</para>
  <para style="q1" vid="SNG 5:11">tye me wel makato jabu woko.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Wange nen calo kom akuri</para>
  <para style="q1" vid="SNG 5:12">matye i nget wang it ma piine mol,</para>
  <para style="q1" vid="SNG 5:12">ginen calo akuri ma gikwang i cak,</para>
  <para style="q1" vid="SNG 5:12">nyo calo kidi me wel ma gimwono maber.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Leme obedo calo poto ma kipito iye yat angwece,</para>
  <para style="q1" vid="SNG 5:13">ma ngwece kur mada.</para>
  <para style="q1" vid="SNG 5:13">Doge nen maber calo ature lenga,</para>
  <para style="q1" vid="SNG 5:13">ma moo mura tye kamol ki iye.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Bade calo jabu ma kilungu adunu,</para>
  <para style="q1" vid="SNG 5:14">en oruku jami me welgu.</para>
  <para style="q1" vid="SNG 5:14">Kome pwot calo kom lak lyec,</para>
  <para style="q1" vid="SNG 5:14">ma kideyo ki kidi capir.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Tyene obedo calo wir ma pwot,</para>
  <para style="q1" vid="SNG 5:15">ma kicibo ikom got ma kideyo ki jabu.</para>
  <para style="q1" vid="SNG 5:15">Kite nen calo got Lebanon,</para>
  <para style="q1" vid="SNG 5:15">ma nen maber mada kun yat cedar mabecone orumu.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Lok ma en loko winye ma mit tutwal,</para>
  <para style="q1" vid="SNG 5:16">ki gin mo keken ma odok ikome yomo cwinya matek.</para>
  <para style="q1" vid="SNG 5:16">Man aye ngat ma amaroni ma en bene larema,</para>
  <para style="q1" vid="SNG 5:16">dong wun anyira Jerucalem myero dong wunge man ni ngat ma amaroni tye kit man.<verse eid="SNG 5:16" /></para>
  <para style="b" />
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Wer pa anyira Jerucalem</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />In nyako maber ma inen mwonya makato anyira ducuni,</para>
  <para style="q1" vid="SNG 6:1">en ngat ma imaroni kono ocito kwene?</para>
  <para style="q1" vid="SNG 6:1">En oloke odok tung kwene?</para>
  <para style="q1" vid="SNG 6:1">Wac ki wan, wek wakonyi ki yenyone.<verse eid="SNG 6:1" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />En ma amaroni ocito odok gire</para>
  <para style="q1" vid="SNG 6:2">tung piny i potone,</para>
  <para style="q1" vid="SNG 6:2">kama yadi ma ngwecgi kur dongo iye.</para>
  <para style="q1" vid="SNG 6:2">En tye kakwayo romine i poto,</para>
  <para style="q1" vid="SNG 6:2">en tye bene kapwono ature lenga.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Laco ma amaroni, en mera kikome ki an bene a mere.</para>
  <para style="q1" vid="SNG 6:3">En kwayo romine ikin lenga ma oturu.<verse eid="SNG 6:3" /></para>
  <para style="b" />
  <para style="s1">Wer me abic</para>
  <para style="sp">Wer pa laco</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />In nyako ma amaro, iber calo taun madit me Tirja,</para>
  <para style="q1" vid="SNG 6:4">inen mwonya mada calo taun madit me Jerucalem,</para>
  <para style="q1" vid="SNG 6:4">inen oluma calo buca mony ma gutingo benderagi.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Lok wangi cen pe inena, pien imiyo apari mada.</para>
  <para style="q1" vid="SNG 6:5">Yer wii ocung lijur calo lwak dyegi,</para>
  <para style="q1" vid="SNG 6:5">ma giwoto gicito piny i kor got Gilead.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Laki tar calo megi romi matar</para>
  <para style="q1" vid="SNG 6:6">ma dong kingolo yer komgi woko,</para>
  <para style="q1" vid="SNG 6:6">ci kilwokogi.</para>
  <para style="q1" vid="SNG 6:6">Gin ducu guryeyo gukeme ki wadgi,</para>
  <para style="q1" vid="SNG 6:6">pe tye mo acel ikin gi ma orwenyo.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Lemi ducu nongo opong woko calo nyig pomegranat ma kipoko iye i dul aryo,</para>
  <para style="q1" vid="SNG 6:7">ma nen ki inge kitambara me wii.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Laker twero bedo ki daker ma romo pyere abicel ki mon angeca ma romo pyere aboro,</para>
  <para style="q1" vid="SNG 6:8">wa ki anyira ma mabeco ma welgi pe kwane.<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />Ento pud ayero nyako ma amaro, en nyako aceli keken</para>
  <para style="q1" vid="SNG 6:9">ma nen mwonya mada calo akuri.</para>
  <para style="q1" vid="SNG 6:9">En latin nyako acel keken bot mine,</para>
  <para style="q1" vid="SNG 6:9">en latin ma kite ber ma mine maro adada.</para>
  <para style="q1" vid="SNG 6:9">Anyira ducu ginene ci gulwonge ni layomcwiny,</para>
  <para style="q1" vid="SNG 6:9">lwak mon ker ki mon angecagu giwero wer me pako en.<verse eid="SNG 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Man anga ma nen calo rupinyi?</para>
  <para style="q1" vid="SNG 6:10">En nen mwonya mada calo dwe ma ryeny,</para>
  <para style="q1" vid="SNG 6:10">dok calo ceng ma ryeny maleng,</para>
  <para style="q1" vid="SNG 6:10">ma nen oluma calo buca mony ma gutingo benderagi.<verse eid="SNG 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />Acito i poto kama kipito iye yadi ma nyako nyiggi calo yaa,</para>
  <para style="q1" vid="SNG 6:11">ka aneno ginapita ma pud gidongo adonga matye i nota,</para>
  <para style="q1" vid="SNG 6:11">dok acito kaneno ka olok dong ocako turu me keto nyige,</para>
  <para style="q1" vid="SNG 6:11">ki me neno bene ka yadi pomegranat dong oturu.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Ento ma onongo pud peya ayube,</para>
  <para style="q1" vid="SNG 6:12">miti me bedo kwedi atena</para>
  <para style="q1" vid="SNG 6:12">oyomo cwinya mada calo laker matye kangwec i gadigadi me ker.<verse eid="SNG 6:12" /></para>
  <para style="sp">Wer pa anyira me Jerucalem</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Dwog cen, dwog cen, in nyako me Culam,</para>
  <para style="q1" vid="SNG 6:13">dwog cen, dwog cen, wek waneni.</para>
  <para style="sp" vid="SNG 6:13">Wer pa nyako</para>
  <para style="q1" vid="SNG 6:13">Pingo wugomo ni wunena,</para>
  <para style="q1" vid="SNG 6:13">ka atye kamyel inyim dul pa luneno aryo mapatpat?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">Wer pa laco</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />Tyeni ma iruku war iyeni ber atika,</para>
  <para style="q1" vid="SNG 7:1">in nyako ma nen calo daker!</para>
  <para style="q1" vid="SNG 7:1">Emi nen ma olunge alunga calo tiko ngut ma kicweyo maber,</para>
  <para style="q1" vid="SNG 7:1">calo tic ma ladiro aye otiyo.<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />Peni bene obedo kiluka calo ngut opoko</para>
  <para style="q1" vid="SNG 7:2">ma kipiko iye kongo bwino mamit jwijwi.</para>
  <para style="q1" vid="SNG 7:2">Ii obedo calo wit ngano ma kiduru kacel,</para>
  <para style="q1" vid="SNG 7:2">ma ature lenga odongo orumu woko dyere.<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />Tununi obedo calo lutino til ma kinywalogi rudi,</para>
  <para style="q1" vid="SNG 7:3">dok bene obedo calo lutino bure aryo.<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />Nguti otone calo wir lak lyec</para>
  <para style="q1" vid="SNG 7:4">ma ocudu malo likung,</para>
  <para style="q1" vid="SNG 7:4">wangi nen calo kut ma i Kecibon,</para>
  <para style="q1" vid="SNG 7:4">ma cok ki dog taun madit me Bat-rabim.</para>
  <para style="q1" vid="SNG 7:4">Umi ber calo lubele me Lebanon,</para>
  <para style="q1" vid="SNG 7:4">ma okemo Damaciko.<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />Deyo me wii ocudu malo likung calo got Karmel,</para>
  <para style="q1" vid="SNG 7:5">yere olot ma oluk ma nen maber calo bongo ma obedo lamarlamar;</para>
  <para style="q1" vid="SNG 7:5">neno ber me yer wii omiyo an rwot ma meri dong adoko calo lamabuc.<verse eid="SNG 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />In iber, inen mwonya mada,</para>
  <para style="q1" vid="SNG 7:6">in nyako ma amaro adada, in imiyo an abedo ki yomcwiny madwong.<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />In icalo yat otit,</para>
  <para style="q1" vid="SNG 7:7">dok tunu ma i kori obedo calo tuga otit.<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />Ci an awaco ni, abiito yat otiti</para>
  <para style="q1" vid="SNG 7:8">ci amako jange ka apwono nyige.</para>
  <para style="q1" vid="SNG 7:8">Ki tung bota tununi nen calo tuga nyig olok,</para>
  <para style="q1" vid="SNG 7:8">ki yweyo me dogi kur calo yat ma ngwece kur.<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />Dogi mit rom ki kongo bwino mamit adada.</para>
  <para style="q1" vid="SNG 7:9">Ka imato imwonyo cito i ii ma pwot,</para>
  <para style="q1" vid="SNG 7:9">makato ki i dogi ki ikin lakigu.<verse eid="SNG 7:9" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />Laco ma amaroni en mera kikome,</para>
  <para style="q1" vid="SNG 7:10">mitine ducu tye ocung ikoma.<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />Bin, in ma amarini,</para>
  <para style="q1" vid="SNG 7:11">wek wacit kacel kwedi i potoni,</para>
  <para style="q1" vid="SNG 7:11">ka dong wabibutu i dyewor i gangi matye kunu.<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />Ci wabia malo con i odiko wacito i poti olok,</para>
  <para style="q1" vid="SNG 7:12">wek wacit wanen kace olok dong gucako turu me keto nyiggi,</para>
  <para style="q1" vid="SNG 7:12">dok me neno kace olok dong turu,</para>
  <para style="q1" vid="SNG 7:12">me neno bene ka yadi pomegranat dong turu.</para>
  <para style="q1" vid="SNG 7:12">Ci dong abinyutu mar mera boti ki kunu.<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />Ngwec yat nyodo tye kaduny makur,</para>
  <para style="q1" vid="SNG 7:13">ki yadi mabeco ducu ma inget dogolawa gutyeko nyak woko.</para>
  <para style="q1" vid="SNG 7:13">In ma amaro agwoko nyig yadi ma yomo cwiny piri,</para>
  <para style="q1" vid="SNG 7:13">tye macone kacel ki manyene bene.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />Kono yam ibedo omera,</para>
  <para style="q1" vid="SNG 8:1">ma idoto cak ki i tunu pa maa!</para>
  <para style="q1" vid="SNG 8:1">Ci onongo ka arwate kwedi i gudu,</para>
  <para style="q1" vid="SNG 8:1">onongo atwero noto lemi ma pe ngat mo twero caya.<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />Dok onongo atwero telo wii ateri wa i ot pa maa,</para>
  <para style="q1" vid="SNG 8:2">wa i kicika pa maa; ma en aye ma onywalani.</para>
  <para style="q1" vid="SNG 8:2">Dok onongo atwero mini kongo bwino ma ngwece kur imato,</para>
  <para style="q1" vid="SNG 8:2">ki kongo me pig nyig pomegranat ma mera wek imat.<verse eid="SNG 8:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />Kono bene ateno wiya ikom cingi ma lacam,</para>
  <para style="q1" vid="SNG 8:3">kun in nongo igwaka ki cingi ma lacuc.<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />Wukwonge bota, wun anyira Jerucalem,</para>
  <para style="q1" vid="SNG 8:4">ni pe wubiyelo nyako ma amaroni nio ka dong watyeko cobo mitiwa.<verse eid="SNG 8:4" /></para>
  <para style="s1">Wer me abicel</para>
  <para style="sp">Wer pa anyira Jerucalem</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />Meno anga ma oa ki i tim matye kabinoni,</para>
  <para style="q1" vid="SNG 8:5">ma ojenge ikom laco ma en maroni?</para>
  <para style="sp" vid="SNG 8:5">Wer pa nyako</para>
  <para style="q1" vid="SNG 8:5">Acoyo in ikare ma itye ite yat acuga,</para>
  <para style="q1" vid="SNG 8:5">en i kabedo ma meni onywali iye ki arem madwongi,</para>
  <para style="q1" vid="SNG 8:5">i kabedo meno aye meni ma onywalani obedo iye ki arem madwong.<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />Myero imar an keken ki cwinyi ducu,</para>
  <para style="q1" vid="SNG 8:6">dok itinga i badi macalo gin ma meri kikome;</para>
  <para style="q1" vid="SNG 8:6">pien mar tek calo to,</para>
  <para style="q1" vid="SNG 8:6">dok bene ger calo lyel.</para>
  <para style="q1" vid="SNG 8:6">Meny calo leb mac ma lyel,</para>
  <para style="q1" vid="SNG 8:6">leb mac ma lyel ki tek makato ducu.<verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />Pe tye pii mo kadi opong madit marom mene ma twero neko mac me mar woko,</para>
  <para style="q1" vid="SNG 8:7">kadi lalele ma mol matek pe twero mwonyo mar.</para>
  <para style="q1" vid="SNG 8:7">Ento ka dano mo otemo wilo mar ki lonyone ducu ma en tye kwede i ode,</para>
  <para style="q1" vid="SNG 8:7">ci jo gibicaye matek makato.<verse eid="SNG 8:7" /></para>
  <para style="sp">Wer pa omegi nyako</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />Watye ki laminwa matidine,</para>
  <para style="q1" vid="SNG 8:8">tunune pud peya ogulu.</para>
  <para style="q1" vid="SNG 8:8">Wabitimo gin ango pi laminwani,</para>
  <para style="q1" vid="SNG 8:8">ikare ma awobi mo bilok kwede</para>
  <para style="q1" vid="SNG 8:8">kun mito ni enyom?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />Ka nene laminwa obedo macalo cel me gang,</para>
  <para style="q1" vid="SNG 8:9">onongo watwero yubu lubele me ryal ma ocudu malo likung ikome.</para>
  <para style="q1" vid="SNG 8:9">Ka onongo en obedo macalo doggang,</para>
  <para style="q1" vid="SNG 8:9">onongo watwero lorone ki bao me yat cedar.<verse eid="SNG 8:9" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />An abedo macalo cel,</para>
  <para style="q1" vid="SNG 8:10">dong tununa gubedo calo wi cel ma ocudu malo.</para>
  <para style="q1" vid="SNG 8:10">En ngat ma marani dong ngeyo,</para>
  <para style="q1" vid="SNG 8:10">atir ni an ngat ma kelo kuc.<verse eid="SNG 8:10" /></para>
  <para style="sp">Wer pa laco</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />Solomon yam tye ki poto oloke</para>
  <para style="q1" vid="SNG 8:11">i kabedo ma kilwongo ni Baal-amon.</para>
  <para style="q1" vid="SNG 8:11">Ci en oyero lupur me gwoko poto oloke;</para>
  <para style="q1" vid="SNG 8:11">ma dano acel acel myero ocul bote lime maromo ryal alip acel pi olok ma ocek iye.<verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />Atye ki poto olok ma mera kikoma matye pira kena;</para>
  <para style="q1" vid="SNG 8:12">in Solomon, itwero gamo giri lim me ryal alip aceli;</para>
  <para style="q1" vid="SNG 8:12">ki lupur ma gigwoko oloki in ibimiyo botgi lim me ryal miya aryo.<verse eid="SNG 8:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />Ci in ma ibedo kama yadi ma ngwecgi kur dongo iyeni,</para>
  <para style="q1" vid="SNG 8:13">luwota gimito winyo dwoni;</para>
  <para style="q1" vid="SNG 8:13">lok wek bene awinyi.<verse eid="SNG 8:13" /></para>
  <para style="sp">Wer pa nyako</para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />Bin bota oyotoyot, in ma amaroni,</para>
  <para style="q1" vid="SNG 8:14">bed calo bure</para>
  <para style="q1" vid="SNG 8:14">nyo calo wod til ma bedo iwi godi kama yadi ma ngwece kur dongo iye.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>