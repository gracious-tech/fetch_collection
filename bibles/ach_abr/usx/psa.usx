<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id" />
  <para style="h">JABULI</para>
  <para style="toc1">Jabuli</para>
  <para style="toc2">Jabuli</para>
  <para style="toc3">Jab</para>
  <para style="mt1">JABULI</para>
  <para style="imt">Lanyut wilok madito ma i buk man</para>
  <para style="ip">Buk me Jabuli obedo wer ki lega matye i Baibul. Buk man lucoc mapatpat aye gucoyo ikare mapatpat bene. Jo Icrael guguru wer ki lega magi kacel ci gubedo katic kwedgi ikare me lega ma meggi. Motmot wer ki lega magi kiketogi ikin ginacoya.</para>
  <para style="ip">Coc magi ma obedo werwer tye kwai wer mapatpat. Ikine tye iye wer me pak ki woro Lubanga; lega me kony, gwoke ki lare; bako dog pi timo kica; wer me pwoyo Lubanga pi gin mabeco ma en miyo bot dano, ki dong lega pi miyo pwod bot merok. Lega magi tye pi ngat acel acel ki pi rok kulu. Wer mukene nyutu par ki cwercwiny pa dano acel keken ki mukene pi lwak pa Lubanga ducu.</para>
  <para style="ip">Yecu otiyo ki Jabuli ikare me pwonye ki bene lucoc me Cik Manyen gukwanyo lok ma i Jabuli ci guketo ikin coc ma meggi.</para>
  <para style="ip">Jabuli tye buk ma pire tek tutwal bot lukricitayo nicake wa i acaki pa Kanica pa Kricito.</para>
  <para style="iot">Lacim wilok madito ma i buk man</para>
  <para style="io1">Jabuli ducu tye 150 ma kingwekogi i dul abic kit man:</para>
  <para style="io2">Buk mukwongo, Jabuli <char style="ior"><ref loc="PSA 1-41">1—41</ref> </char></para>
  <para style="io2">Buk me aryo, Jabuli <char style="ior"><ref loc="PSA 42-72">42—72</ref> </char></para>
  <para style="io2">Buk me adek, Jabuli <char style="ior"><ref loc="PSA 73-89">73—89</ref> </char></para>
  <para style="io2">Buk me angwen, Jabuli <char style="ior"><ref loc="PSA 90-106">90—106</ref> </char></para>
  <para style="io2">Buk me abic, Jabuli <char style="ior"><ref loc="PSA 107-150">107—150</ref> </char></para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">BUK MUKWONGO</para>
  <para style="mr">
    <ref loc="PSA 1-41">Jab 1—41</ref></para>
  <para style="s1">Yomcwiny me ada</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Ngat ma kwero lubu tam pa jo maracu,</para>
  <para style="q1" vid="PSA 1:1">ma pe lubu kit pa lubalo,</para>
  <para style="q1" vid="PSA 1:1">ki ma pe bedo kacel ki lungala,</para>
  <para style="q1" vid="PSA 1:1">bedo ki yomcwiny.<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />En nongo yomcwinye i lubu cik pa Rwot,</para>
  <para style="q1" vid="PSA 1:2">en bedo kalwodo lok ikom cike dyeceng ki dyewor.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:8">Jer 17:8</ref>
      </char>
    </note>En bedo macalo yat ma odongo inget kulu,</para>
  <para style="q1" vid="PSA 1:3">ma nyako nyige i karene kikome,</para>
  <para style="q1" vid="PSA 1:3">ma pote bene pe two woko.</para>
  <para style="q1" vid="PSA 1:3">Gin ma en tiyo ducu, en limo iye gum.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Ento jo maracu pe gitye kitmeno;</para>
  <para style="q1" vid="PSA 1:4">gin calo cungkal mayamo kolo tero woko.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Pimeno jo maracu kibingolo kop loyogi;</para>
  <para style="q1" vid="PSA 1:5">ki jo ma lubalo pe kibiribogi ki jo ma kitgi atir.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Pien Rwot gwoko dok telo ngat ma kite atir,</para>
  <para style="q1" vid="PSA 1:6">ento ngat marac birwenyo mere woko matwal.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s1">Laker ma Lubanga oyero</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 4:25-26">Tic 4:25-26</ref>
      </char>
    </note>Pingo rok mapol gitye ki yub me jemo?</para>
  <para style="q1" vid="PSA 2:1">Pingo rok mapol gipiro lok ma konye peke?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Lukergi ducu gijemo woko,</para>
  <para style="q1" vid="PSA 2:2">ki lulocgi bene gipiro lok kacel,</para>
  <para style="q1" vid="PSA 2:2">ikom Rwot ki ikom ngat ma en dong otyeko wiro, kun giwaco ni,<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />“Wek wacodu nyorgi ma gutweyowa kwedeni woko,</para>
  <para style="q1" vid="PSA 2:3">dok wabolu twerogi me loc woko ki ikomwa.”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Rwot ma obedo iwi komkere i polo tye kanyero;</para>
  <para style="q1" vid="PSA 2:4">en ngalogi angala.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />En loko kwedgi ki kiniga,</para>
  <para style="q1" vid="PSA 2:5">dok miyogi lworo ki akemone mager, kun waco ni,<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />“An dong atyeko keto rwota iwi Cion,</para>
  <para style="q1" vid="PSA 2:6">ma en got mera maleng.”<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:33">Tic 13:33</ref>; <ref loc="HEB 1:5">Ibru 1:5</ref>; <ref loc="HEB 5:5">5:5</ref></char>
    </note>Abitito cik pa Rwot,</para>
  <para style="q1" vid="PSA 2:7">en owaco bota ni,</para>
  <para style="q1" vid="PSA 2:7">“In i woda, tin dong adoko woru.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Lega, ci abimiyo lurok bedo ginaleyani,</para>
  <para style="q1" vid="PSA 2:8">ki lobo ducu bene bibedo meri.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9: </char>
      <char style="xt" closed="false">
        <ref loc="REV 2:26-27">Niy 2:26-27</ref>; <ref loc="REV 12:5">12:5</ref>; <ref loc="REV 19:15">19:15</ref></char>
    </note>Ibiloyogi ki odo nyonyo,</para>
  <para style="q1" vid="PSA 2:9">ibingidogi woko matinotino macalo agulu.”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Kombedi dong wuwiny loka, wun luker, wubed ryek;</para>
  <para style="q1" vid="PSA 2:10">myero wuwiny pwony man, wun luloc me lobo.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Wutii bot Rwot ki lworo,</para>
  <para style="q1" vid="PSA 2:11">ki myel kom,<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />dok wurum congwu inyime;</para>
  <para style="q1" vid="PSA 2:12">wek kiniga pe omake ikomwu miyo wuto woko atura;</para>
  <para style="q1" vid="PSA 2:12">pien akemo twero make oyotoyot mada.</para>
  <para style="b" vid="PSA 2:12" />
  <para style="q1" vid="PSA 2:12">Gitye ki gum jo ducu ma giringo gilaro bote.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s1">Lega me odiko pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />Ai Rwot, lukwora gitye mapol,</para>
  <para style="q1" vid="PSA 3:1">gipol mada ma giero lweny ikoma!<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Giloko lok ikoma ma giwaco ni,</para>
  <para style="q1" vid="PSA 3:2">“Lubanga pe twero laro en.”<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Ento in, Ai Rwot, in aye i kwot ma gwoka ki i gin marac;</para>
  <para style="q1" vid="PSA 3:3">in i miya abedo i deyona, dok i miya tekcwiny bene.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Akok bot Rwot matek,</para>
  <para style="q1" vid="PSA 3:4">ci en gamo ki iwi got mere maleng.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Abutu piny anino woko,</para>
  <para style="q1" vid="PSA 3:5">dok aco odoco pien Rwot gwoka.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Pe alworo jo alip apar</para>
  <para style="q1" vid="PSA 3:6">ma guruma woko dyere pi lweny ikoma.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Bin, Ai Rwot!</para>
  <para style="q1" vid="PSA 3:7">Lara do, Ai Lubangana!</para>
  <para style="q1" vid="PSA 3:7">In aye ma ipwodo lukwora woko ducu,</para>
  <para style="q1" vid="PSA 3:7">dok ityeko kerogi woko liweng miyo pe gitwero tima marac.<verse eid="PSA 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Lar a ki bot Rwot;</para>
  <para style="q1" vid="PSA 3:8">wek gum meri obed ikom joni!<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s1">Lega me otyeno pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Ai Lubanga, gam doga ka akok boti,</para>
  <para style="q1" vid="PSA 4:1">in aye ma lacungudwar ma mera!</para>
  <para style="q1" vid="PSA 4:1">Ikare ma atye i can, in ceng ibino ikonya.</para>
  <para style="q1" vid="PSA 4:1">Kombedi dong ibed ki kica ikoma, dok iwiny legana.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Wun mono, wubibedo kayeta pi kare marom mene?</para>
  <para style="q1" vid="PSA 4:2">Wun mono wubimaro lok ma konye peke ki me goba pi kare marom mene?<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Myero wunge ni Rwot dong otyeko yera me bedo dano mere kikome;</para>
  <para style="q1" vid="PSA 4:3">ka akok bote en winyo kokona.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:26">Epe 4:26</ref>
      </char>
    </note>Kadi bed kiniga omakwu, ento pe wutim bal;</para>
  <para style="q1" vid="PSA 4:4">wutam tam matut mada ki icwinywu,</para>
  <para style="q1" vid="PSA 4:4">wubed kenwu dok wubed laling iwi kitandawu.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Wutyer gitum ma myero bot Rwot,</para>
  <para style="q1" vid="PSA 4:5">dok wuket gen mewu ikome.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Tye jo mapol ma gilego ni,</para>
  <para style="q1" vid="PSA 4:6">“Wek walim gum!”</para>
  <para style="q1" vid="PSA 4:6">Nenwa ki kica, Ai Rwot!<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Yomcwiny ma in imiya dwong,</para>
  <para style="q1" vid="PSA 4:7">kato yomcwiny pa jo ma gitye ki kal ki kongo madwong ata.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Ka abutu piny, acako nino woko mot liyoo ki kuc;</para>
  <para style="q1" vid="PSA 4:8">Ai Rwot, in keni aye ma igwoka miyo abedo maber.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s1">Lega pi gwok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Cik iti wek iwiny loka, Ai Rwot;</para>
  <para style="q1" vid="PSA 5:1">dok iwiny cura.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Rwota ki Lubangana, winy kokona ci ilara.</para>
  <para style="q1" vid="PSA 5:2">Abilego kun abako doga boti, Ai Rwot.<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />I odiko iwinyo dwona;</para>
  <para style="q1" vid="PSA 5:3">ka ceng dong otuc akelo gituma boti,</para>
  <para style="q1" vid="PSA 5:3">ci dong akuru lagam ma a ki boti.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />In pe Lubanga ma cwinye bedo yom pi tim maracu;</para>
  <para style="q1" vid="PSA 5:4">in pe iye nywako kabedo ki gin marac.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Pe iye ni jo ma gin luwake gucung inyimi;</para>
  <para style="q1" vid="PSA 5:5">idag lutim maracu ducu.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Ityeko lugoba woko liweng,</para>
  <para style="q1" vid="PSA 5:6">in Rwot cwinyi dag jo ma lutim bwami ma gineko dano wa ki jo ma lubwola.<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Abidonyo i ot meri,</para>
  <para style="q1" vid="PSA 5:7">pi mar meri madwong ma pe loke;</para>
  <para style="q1" vid="PSA 5:7">abiworo in i ot meri maleng,</para>
  <para style="q1" vid="PSA 5:7">kun aryebe piny inyimi ki lworo madwong.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />Ai Rwot, lukwora gitye mapol;</para>
  <para style="q1" vid="PSA 5:8">tela wek atii gin matye atir inyimi,</para>
  <para style="q1" vid="PSA 5:8">dok imii yoni ma alubu obed atir.<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:9: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Rom 3:13</ref>
      </char>
    </note>Lok ma lukwora giwaco pe lok ada</para>
  <para style="q1" vid="PSA 5:9">cwinygi opong ki tam me nek keken,</para>
  <para style="q1" vid="PSA 5:9">gungamo doggi calo lyel ma twolo,</para>
  <para style="q1" vid="PSA 5:9">kun giloko lok mamit me bwolo dano.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Pwodgi dok idwok balgi iwigi, Ai Lubanga;</para>
  <para style="q1" vid="PSA 5:10">mi yubgi maracu ma giyubu obed owic botgi.</para>
  <para style="q1" vid="PSA 5:10">Ryemgi woko ki inyimi gucit cen,</para>
  <para style="q1" vid="PSA 5:10">pien gutimo lwak bal mapol,</para>
  <para style="q1" vid="PSA 5:10">dok gujemo woko ikomi.<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Ento mi jo ma giringo gilaro boti gubed ki yomcwiny,</para>
  <para style="q1" vid="PSA 5:11">ci gin biwero wer kare ducu pi yomcwiny.</para>
  <para style="q1" vid="PSA 5:11">Dok igwok jo ma gimari;</para>
  <para style="q1" vid="PSA 5:11">pi in omiyo cwinygi yom adada.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Pien in imiyo gum ki jo ma kitgi atir, Ai Rwot;</para>
  <para style="q1" vid="PSA 5:12">mar meri gengo komgi woko macalo kwot.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s1">Lega pi kony ikare me can</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:1">Jab 38:1</ref>
      </char>
    </note>Ai Rwot, kiniga pe omaki, pe icoka,</para>
  <para style="q1" vid="PSA 6:1">dok pe ipwoda ma itye ki akemo.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Kica omaki ikoma do, Ai Rwot, pien koma dong oloc woko,</para>
  <para style="q1" vid="PSA 6:2">Ai Rwot, canga, pien koma ducu dong mwode amwoda wa i cogo.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Kwona ducu opong ki can,</para>
  <para style="q1" vid="PSA 6:3">Ai Rwot, ibigale pi kare marom mene pi konya?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Bin ilara, Ai Rwot;</para>
  <para style="q1" vid="PSA 6:4">lara ki i to, pien imara ki mar meri ma pe loke.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Pien pe kipo piri i lobo pa jo ma oto;</para>
  <para style="q1" vid="PSA 6:5">ngat mo ma paki ki i lyel kunu peke!<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Dong aol woko ki kumu;</para>
  <para style="q1" vid="PSA 6:6">i dyewor ducu nongo pig wanga odyako kabutuna woko,</para>
  <para style="q1" vid="PSA 6:6">akok ma laten wiya dyak woko.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Wanga okwot woko pi koko me cwercwiny,</para>
  <para style="q1" vid="PSA 6:7">wanga ocido woko, pe dong aneno piny maber;</para>
  <para style="q1" vid="PSA 6:7">man ducu otime pien lukwora giliba.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:23">Mat 7:23</ref>; <ref loc="LUK 13:27">Luk 13:27</ref></char>
    </note>Wua wucit woko cen, wun lutim maracu;</para>
  <para style="q1" vid="PSA 6:8">pien Rwot otyeko winyo dwona ka akok.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />Rwot otyeko winyo ka abako doga;</para>
  <para style="q1" vid="PSA 6:9">dok Rwot ogamo legana.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Lewic bimako lukwora ducu dok gibibedo ki cwercwiny madit tutwal;</para>
  <para style="q1" vid="PSA 6:10">gibiloke gidok cen cut ki lewic.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s1">Lega pi ngolo kop atir</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />Ai Rwot Lubangana, aringo alaro boti;</para>
  <para style="q1" vid="PSA 7:1">lara ki i cing lukwora ducu ma giryemo kora, ci ikonya;<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />ka pe, ci gibikila woko calo labwor ma kilo lee,</para>
  <para style="q1" vid="PSA 7:2">gibiywaya woko kama ngat mo nongo peke matwero lara.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />Ai Rwot Lubangana, kace onongo atiyo gin mo ikin jami magi,</para>
  <para style="q1" vid="PSA 7:3">kace atimo bal ikom ngat mo,<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />nyo ka atimo bal bot larema pi dwoko bote gin marac kom gin marac,</para>
  <para style="q1" vid="PSA 7:4">nyo ka atimo bwami ayako jami pa lakwora woko labongo tyen lok mo,<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />ci mi lukwora guryem kora gumaka woko i yoo,</para>
  <para style="q1" vid="PSA 7:5">wek gureta piny i ngom ci guneka woko,</para>
  <para style="q1" vid="PSA 7:5">ka dong gibwota i ngom kenyo ma dong ato woko.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Ai Rwot, a malo ki akemoni,</para>
  <para style="q1" vid="PSA 7:6">ci ilweny ikom lukwora ma gubino magwa ikomani;</para>
  <para style="q1" vid="PSA 7:6">Ai Lubangana, coo woko wek i konya, pien in aye iciko pi ngolo kop.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Wek lwak me rok ducu gucoke gurumi woko dyere;</para>
  <para style="q1" vid="PSA 7:7">ci ibed malo i kabedoni ka icak loyogi ki kunu.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />Rwot, in langolkop pa jo me rok ducu;</para>
  <para style="q1" vid="PSA 7:8">Ai Rwot, ngol kopa muporo kit ma atir ma atye kwede,</para>
  <para style="q1" vid="PSA 7:8">dok ma lubu kit ma cwinya leng kwede.<verse eid="PSA 7:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:9: </char>
      <char style="xt" closed="false">
        <ref loc="REV 2:23">Niy 2:23</ref>
      </char>
    </note>Gik tim marac ma jo maracu gitiyo woko,</para>
  <para style="q1" vid="PSA 7:9">ento wek jo ma kitgi atir gucung matek.</para>
  <para style="q1" vid="PSA 7:9">In Lubanga ma kiti tye atir,</para>
  <para style="q1" vid="PSA 7:9">in iniang tam pa dano kacel ki mitigi.<verse eid="PSA 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Lubanga aye kwot mera,</para>
  <para style="q1" vid="PSA 7:10">en laro jo ma cwinygi atir.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Lubanga langolkop ma ngolo kop atir,</para>
  <para style="q1" vid="PSA 7:11">en Lubanga matye ki kiniga nino ducu ikom lubalo.<verse eid="PSA 7:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Kace dano mo pe ongut,</para>
  <para style="q1" vid="PSA 7:12">ci Lubanga bipako pala lucwane.</para>
  <para style="q1" vid="PSA 7:12">En dong otyeko ciko atume tye atera;<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />en dong oyubu jami lweny maracu me nek,</para>
  <para style="q1" vid="PSA 7:13">lak ateronegu ducu gilyel mac.<verse eid="PSA 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Nen, latim marac tamo tam marac ki i cwinye,</para>
  <para style="q1" vid="PSA 7:14">dok opong ki yub me kelo ayela keken,</para>
  <para style="q1" vid="PSA 7:14">kun loko lok gobagoba me bwolo dano.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />En kwinyo bur matut i ngom,</para>
  <para style="q1" vid="PSA 7:15">ka dok loke poto i bur ma en okwinyoni kekene.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Dong tame maraci miyo en poto i can,</para>
  <para style="q1" vid="PSA 7:16">ki tim bwamine dwogo gire ikome kene.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Abipwoyo Rwot pien kite atir mada,</para>
  <para style="q1" vid="PSA 7:17">dok abiwero wer me pako nying Rwot,</para>
  <para style="q1" vid="PSA 7:17">ma en Ngat Mamalo Twal.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s1">Deyo pa Lubanga ki woro pa dano</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />Ai Rwot, in i Rwotwa,</para>
  <para style="q1" vid="PSA 8:1">dit me nyingi nen iwi lobo ducu!</para>
  <para style="b" vid="PSA 8:1" />
  <para style="q1" vid="PSA 8:1">Pak ma kikori kwede o malo i polo,<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:2: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:16">Mat 21:16</ref>
      </char>
    </note> ma lutino lukere ki lutino ma pud dot giwero me paki.</para>
  <para style="q1" vid="PSA 8:2">Ityeko gero cel gogo me gwokeni pi gengo lukwori,</para>
  <para style="q1" vid="PSA 8:2">wek ilo lukwori ki jo ma lwenyo ikomi.<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Ka aneno polo, ma in itiyo ki cingi,</para>
  <para style="q1" vid="PSA 8:3">ki dwe ki lakalatwe ma iketogi i kabedogi liking;<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:4: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:17-18">Yub 7:17-18</ref>; <ref loc="PSA 144:3">Jab 144:3</ref>; <ref loc="HEB 2:6-8">Ibru 2:6-8</ref></char>
    </note>dano kono gin ango mamiyo itamo pire,</para>
  <para style="q1" vid="PSA 8:4">dano adana ma mwani gin ango mamiyo iparo pire?<verse eid="PSA 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Ento imiye dit ma in Lubanga keken aye iloye,</para>
  <para style="q1" vid="PSA 8:5">ka dong iketo lalukana me dit kideyo i wiye.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:6: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:27">1 Kor 15:27</ref>; <ref loc="EPH 1:22">Epe 1:22</ref>; <ref loc="HEB 2:8">Ibru 2:8</ref></char>
    </note>Iketo en obedo laloc maloyo gin ducu ma icweyogi;</para>
  <para style="q1" vid="PSA 8:6">iketo en obedo lalo jami ducu,<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />romi ki dyangi, ki lee timgu,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />winyi kacel ki rec me nam,</para>
  <para style="q1" vid="PSA 8:8">ki kit gin ducu matye i dye nam.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />Ai Rwot, in i Rwotwa,</para>
  <para style="q1" vid="PSA 8:9">dit me nyingi nen iwi lobo ducu!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s1">Wer me pwoyo Lubanga pi ngolo kop atir</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />Abipaki, Ai Rwot, kun amiyi pwoc ki cwinya ducu,</para>
  <para style="q1" vid="PSA 9:1">abitito pi jami me auragu ducu ma itiyo.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Abiwero wer ki yomcwiny kun anyate piri.</para>
  <para style="q1" vid="PSA 9:2">Abiwero wer me pako nyingi, in Ngat Mamalo Twal.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Lukwora giloke gidok cen ka guneno in ituc;</para>
  <para style="q1" vid="PSA 9:3">gigate gipoto piny gito woko.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />In langolkop ma ngolo kop atir,</para>
  <para style="q1" vid="PSA 9:4">ibedo iwi komkeri,</para>
  <para style="q1" vid="PSA 9:4">ci ingolo kopa kakare.<verse eid="PSA 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />In ijuku lurok, dok ityeko jo maracu woko liweng;</para>
  <para style="q1" vid="PSA 9:5">ityeko jwayo nyinggi woko ducu,</para>
  <para style="q1" vid="PSA 9:5">pe dong kibipo ikomgi matwal.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Lukwora dong gutum woko matwal;</para>
  <para style="q1" vid="PSA 9:6">ijwero gangigi woko ducu,</para>
  <para style="q1" vid="PSA 9:6">wi dano dong otyeko wil woko ikomgi adada.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Ento Rwot en rwot ma bedo iwi komkere nakanaka;</para>
  <para style="q1" vid="PSA 9:7">en ocibo komkere pi ngolo kop.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />En loyo lobo ki kit ma atir,</para>
  <para style="q1" vid="PSA 9:8">ci ngolo kop pa lwak me rok ducu</para>
  <para style="q1" vid="PSA 9:8">kun ngolo kop atir.<verse eid="PSA 9:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />Rwot en kalare pa jo ma piny obwoyogi,</para>
  <para style="q1" vid="PSA 9:9">en cel matek ma gwokogi maber ikare me ayela.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Rwot, jo ma ngeyi gibiketo gen gi ikomi;</para>
  <para style="q1" vid="PSA 9:10">pien in pe ibwoto jo ma gibino boti.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Wuwer wer me pak bot Rwot, matye kaloc i Cion!</para>
  <para style="q1" vid="PSA 9:11">Wutuc gin ma en otiyo bot lwak me rok ducu!<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Pien Lubanga ma lacul kwor me remo poo pi jo ma can omakogi;</para>
  <para style="q1" vid="PSA 9:12">wiye pe wil ikom kokogi,</para>
  <para style="q1" vid="PSA 9:12">dok pwodo jo ma timogi rac.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />Kica omaki ikoma do, Ai Rwot!</para>
  <para style="q1" vid="PSA 9:13">Nen kit atwom ma jo ma gidaga gutyeko keto ikoma!</para>
  <para style="q1" vid="PSA 9:13">In aye ma ilara ci i ila malo ki i to,<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />wek imiya acung inyim jo Jerucalem,</para>
  <para style="q1" vid="PSA 9:14">wek atit botgi gin ducu ma omiyo apako nyingi.</para>
  <para style="q1" vid="PSA 9:14">Abibedo ki yomcwiny pien dong ilara.<verse eid="PSA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Lurok gukwinyo bur ka dok gupoto iye keken gi;</para>
  <para style="q1" vid="PSA 9:15">guciko obwo ci tyen gi ken gi aye omoko iye.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Rwot dong otyeko miyo nyinge ongene pi ngolo kop atir,</para>
  <para style="q1" vid="PSA 9:16">jo maracu gimoko i owic pi tim ma gin aye gutimo.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Agiki pa jo maracu ducu en aye to,</para>
  <para style="q1" vid="PSA 9:17">gin lurok ducu ma gikwero Lubanga.<verse eid="PSA 9:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Jo ma piny obwoyogi pe kibiwekogi ata kare ducu;</para>
  <para style="q1" vid="PSA 9:18">ki gen pa lucan bene pe birwenyo woko matwal.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Bin, Ai Rwot! Wek dano pe oloyi!</para>
  <para style="q1" vid="PSA 9:19">Lwong lurok gucoke inyimi wek ingol kop ikomgi.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Ai Rwot, mi lworo omakgi;</para>
  <para style="q1" vid="PSA 9:20">wek gunge ni gin dano adana mamwa.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s1">Lega pi lar ki i cing jo maracu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />Pingo icung cen kamabor, Ai Rwot?</para>
  <para style="q1" vid="PSA 10:1">Pingo ikane woko ikare me can?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Jo maracu giwake ma gidwaro lucan me aneka;</para>
  <para style="q1" vid="PSA 10:2">mi yub ducu maracu ma guyubuni aye otyekgi.<verse eid="PSA 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Dano marac nyate pi mitine maracu matye i cwinye;</para>
  <para style="q1" vid="PSA 10:3">dano ma wor ma mito ni enong magoba yeto Rwot dok kwere woko bene.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Dano marac bedo ki cwiny me wake kun waco ni, “Lubanga peke.”</para>
  <para style="q1" vid="PSA 10:4">En pe paro, dok pe bino bot Lubanga.<verse eid="PSA 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Gin marac ma en tamo ducu tiyo dok cobe kakare.</para>
  <para style="q1" vid="PSA 10:5">En pe niang i ngolo kop pa Lubanga pien tye lamal tutwal;</para>
  <para style="q1" vid="PSA 10:5">en neno lukwore ci jwiyogi woko ajwiya.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />En tamo ki i cwinye kun waco ni, “Gin mo peke ma biloya;</para>
  <para style="q1" vid="PSA 10:6">ikare me kwona ducu pe abineno can.”<verse eid="PSA 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:7: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:14">Rom 3:14</ref>
      </char>
    </note>Loke ducu opong ki ceno dano acena, wa ki bwola ki bura me diyo dano tektek;</para>
  <para style="q1" vid="PSA 10:7">en pe gale me loko lok marac ki lok makelo adagadaga.<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />En kane woko i dye gangi kakiyo piny;</para>
  <para style="q1" vid="PSA 10:8">en libo dano ci neko jo ma gipe ki bal.<verse eid="PSA 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />En neno piny kun roto dano ma can omako adada ma piny oloyo;</para>
  <para style="q1" vid="PSA 10:9">en kane woko i mung kakiyogi calo labwor.</para>
  <para style="q1" vid="PSA 10:9">En kane woko pi kiyo lacan wek emak woko,</para>
  <para style="q1" vid="PSA 10:9">en mako lacan nongo dong oleko wiye okelo omoko i obwone.<verse eid="PSA 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Dano ma can omako adada en nginyo woko, macalo lee ma tekone peke, pien teko pa lakwore nongo oloyo mere woko.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Dano marac tamo ki i cwinye ni, “Wi Lubanga dong otyeko wil woko,</para>
  <para style="q1" vid="PSA 10:11">dok omiyo wange woko, pe bitwero nena.”<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Bin ilara do, Ai Rwot!</para>
  <para style="q1" vid="PSA 10:12">Wii pe myero owil ikom ngat matye ki can, Ai Lubanga!<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Pingo dano marac kwero Lubanga,</para>
  <para style="q1" vid="PSA 10:13">kun tamo ki i cwinye ni, “Lubanga pe bipwoda?”<verse eid="PSA 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Ento in ineno, dok ingeyo can ki cwercwiny ma dano tye kwede,</para>
  <para style="q1" vid="PSA 10:14">kare ducu i tye ma i yube me miyo kony.</para>
  <para style="q1" vid="PSA 10:14">Dano matye ki can miyo kwone boti,</para>
  <para style="q1" vid="PSA 10:14">pien in ikonyo lutino kic.<verse eid="PSA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Myero itur twero pa jo maracu ki lutim maracu woko;</para>
  <para style="q1" vid="PSA 10:15">yeny balgi ducu nio wang ma pe dong ibinongo balgi mo kadi ki acel.<verse eid="PSA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />Rwot en aye Rwot Lubangawa ma bedo nakanaka;</para>
  <para style="q1" vid="PSA 10:16">lurok ducu ma giworo lubanga mukene gibito gitum woko ki i lobone.<verse eid="PSA 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Ai Rwot, ibiwinyo lega pa jo mamwol;</para>
  <para style="q1" vid="PSA 10:17">ibimiyo gibedo ki tekcwiny,</para>
  <para style="q1" vid="PSA 10:17">dok ibiciko iti pi winyogi.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Ibingolo kop pa lutino kic ki pa jo ma kiunugi,</para>
  <para style="q1" vid="PSA 10:18">wek dano mo me lobo man pe dok okel lworo ikomgi.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s1">Bedo ki gen ikom Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />Aringo alaro bot Rwot.</para>
  <para style="q1" vid="PSA 11:1">Pingo wuwaco bota ni,</para>
  <para style="q1" vid="PSA 11:1">“Tuk woko calo winyo, wek icit ibed iwi godi;<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />pien jo maracu gutero atum,</para>
  <para style="q1" vid="PSA 11:2">dok guketo te aterogi ikom tol atum,</para>
  <para style="q1" vid="PSA 11:2">wek gicel jo ma cwinygi atir woko i colpiny.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Pe tye gin mo ma dano ma kite atir twero timo,</para>
  <para style="q1" vid="PSA 11:3">ka te guti ducu dong kibalo woko?”<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />Rwot tye i Ot mere maleng; komkere tye i polo.</para>
  <para style="q1" vid="PSA 11:4">En neno dano ducu ma i lobo, dok ngiyo gin ma gin tiyo.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />Rwot ngiyo cwiny dano ducu, jo ma kitgi atir ki jo maracu,</para>
  <para style="q1" vid="PSA 11:5">en dag ngat ma maro timo tim bwami.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />En bionyo lodi mac ki gweng calfa ikom jo maracu;</para>
  <para style="q1" vid="PSA 11:6">en bipwodogi ki yamo oro malyet.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Rwot kite tye atir,</para>
  <para style="q1" vid="PSA 11:7">dok maro tim ma atir;</para>
  <para style="q1" vid="PSA 11:7">jo ma kitgi atir gibineno wange.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s1">Lega pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />Konya, Ai Rwot,</para>
  <para style="q1" vid="PSA 12:1">pien ngat mo maber ma geni dong peke;</para>
  <para style="q1" vid="PSA 12:1">dok jo ma lugen dong gurwenyo woko ki ikin dano.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Dano acel acel loko lok goba bot lawote,</para>
  <para style="q1" vid="PSA 12:2">ma nongo lok ma a ki idoggi mit ata ento cwinygi opoke woko i dul aryo.<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Rwot, myero ijuk lok me bitagi woko,</para>
  <para style="q1" vid="PSA 12:3">en lok ma a ki idoggi me nyateni!<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Gin giwaco ni, “Wabiloyo lok ki lok dogwa,</para>
  <para style="q1" vid="PSA 12:4">wabiloko gin ducu kit macalo wamito,</para>
  <para style="q1" vid="PSA 12:4">pien pe tye ngat mo ma en ladit ma loyowa.”<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />Rwot owaco ni, “Ento kombedi dong abibino,</para>
  <para style="q1" vid="PSA 12:5">pien dong kiyako jami pa lucan woko,</para>
  <para style="q1" vid="PSA 12:5">dok jo ma piny obwoyogi gitye kacur acura ki arem.</para>
  <para style="q1" vid="PSA 12:5">Pimeno dong abigwokogi kit ma gimito.”<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Lok pa Rwot ma en ciko ber, kitwero genone,</para>
  <para style="q1" vid="PSA 12:6">obedo calo ryal ma kiliyo maber ki mac,</para>
  <para style="q1" vid="PSA 12:6">ma kiliyo tyen abiro kulu.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />Gwokwa maber kare ducu, Ai Rwot,</para>
  <para style="q1" vid="PSA 12:7">gwokwa ki ikom yalwak me kare man.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Jo maracu gitye kawire i kabedo ducu kun giyenyo dano,</para>
  <para style="q1" vid="PSA 12:8">kit macalo dano ducu pako kwede tim marac ma gitiyo ikin dano ma i lobo.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s1">Lega pi kony ikare me can</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Ai Rwot, wii mono biwil woko ikoma pi kare, marom mene?</para>
  <para style="q1" vid="PSA 13:1">Wii biwil woko matwal bo?</para>
  <para style="q1" vid="PSA 13:1">Ibikane woko ki bota pi kare marom mene?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Myero abed ki arem pi kare marom mene,</para>
  <para style="q1" vid="PSA 13:2">dok bene myero abed ki cwercwiny dyeceng ki dyewor benebene?</para>
  <para style="q1" vid="PSA 13:2">Lukwora kono wigi pil ikoma pi kare marom mene?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Nen tung bota ci igam doga, Ai Rwot Lubangana.</para>
  <para style="q1" vid="PSA 13:3">Meny wanga, wek pe anin nino me to,<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />miyo lukwora giwaco ni, “Watyeko loyo en woko!”</para>
  <para style="q1" vid="PSA 13:4">Dok pe iwek lukwora gubed ki yomcwiny pien dong apoto i can.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Ento an dong atyeko geno mar meri ma pe loke;</para>
  <para style="q1" vid="PSA 13:5">dok abibedo ki yomcwiny pi lar meri.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Abiwero wer bot Rwot,</para>
  <para style="q1" vid="PSA 13:6">pien otima maber atika.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s1">Tim maracu pa dano</para>
  <para style="r">(<ref loc="PSA 53">Jab 53</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Rom 3:10-12</ref>
      </char>
    </note> Luming waco ki i cwinygi ni,</para>
  <para style="q1" vid="PSA 14:1">“Lubanga gire peke.”</para>
  <para style="q1" vid="PSA 14:1">Gin jo ma kitgi racu ma gitimo gin me kwer;</para>
  <para style="q1" vid="PSA 14:1">pe tye ngat mo ma tiyo gin maber.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />Rwot neno dano ducu ki i polo,</para>
  <para style="q1" vid="PSA 14:2">me neno kace tye jo mogo ikin gi ma gitiyo ki ryeko,</para>
  <para style="q1" vid="PSA 14:2">ma giyenyo Lubanga.<verse eid="PSA 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Ento gin ducu dong gungak woko, gudoko jo ma kitgi racu;</para>
  <para style="q1" vid="PSA 14:3">pe tye ngat mo ma tiyo gin maber, pe tye, kadi ki acel.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Gin jo ma lutim maracuni, mono pe gitye ki ngec?</para>
  <para style="q1" vid="PSA 14:4">Gin giyako lim pa jona calo gicamo kwon,</para>
  <para style="q1" vid="PSA 14:4">ma pe bene gilwongo nying Rwot.<verse eid="PSA 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Ento gibibedo kunu ki lworo madwong,</para>
  <para style="q1" vid="PSA 14:5">pien Lubanga tye ki jo ma kitgi atir.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Wun wumito balo yub pa lacan, ento Rwot aye ka larene.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Onongo bedo ber ka lare pa jo Icrael obino ki i Cion!</para>
  <para style="q1" vid="PSA 14:7">Ka Rwot bidwoko gum bot jone,</para>
  <para style="q1" vid="PSA 14:7">jo pa Yakobo bibedo ki yomcwiny madwong,</para>
  <para style="q1" vid="PSA 14:7">ki jo Icrael bene cwinygi bibedo yom.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s1">Gin ma Lubanga mito</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />Ai Rwot, anga ma bibedo i kemani?</para>
  <para style="q1" vid="PSA 15:1">Anga ma bibedo iwi got meri maleng?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Ngat ma cwinye leng; dok ma tiyo gin ma atir,</para>
  <para style="q1" vid="PSA 15:2">ma loko bene lok me ada ki cwinye ducu;<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />ma pe coko lok me kwot ilok ma en loko,</para>
  <para style="q1" vid="PSA 15:3">dok en pe timo gin marac mo ikom lareme,</para>
  <para style="q1" vid="PSA 15:3">dok pe balo nying lawote.<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />En cayo jo ma pe giworo Lubanga,</para>
  <para style="q1" vid="PSA 15:4">ento en woro jo ma gilworo Rwot.</para>
  <para style="q1" vid="PSA 15:4">Pe loko kwong mayam okwongo, kadi bed kwongeni kele can.<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />En pe mito enong magoba ikom lim ma en konyo ki dano,</para>
  <para style="q1" vid="PSA 15:5">dok pe gamo lim ma kiwile kwede i mung</para>
  <para style="q1" vid="PSA 15:5">wek kiwe lok odok ikom ngat ma peke ki bal.</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q1" vid="PSA 15:5">Ngat ma tiyo kumeno pe kidiro woko cen.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s1">Lega me gen</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Gwoka, Ai Lubanga, pien aringo alaro boti.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Awaco bot Rwot ni. “In i Rwoda;</para>
  <para style="q1" vid="PSA 16:2">gin maber ducu ma atye kweda a ki boti.”<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Jo maleng ma i lobo gin jo me awora,</para>
  <para style="q1" vid="PSA 16:3">ma giyomo cwinya mada.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Jo ma giyero lubanga mukene ginyayo cwercwinygi gimedo ameda;</para>
  <para style="q1" vid="PSA 16:4">an pe abionyo gityergi me remo,</para>
  <para style="q1" vid="PSA 16:4">dok bene pe abilwongo nying jogigi ki doga ikare me legana.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />Rwot in aye dula ma kipoka,</para>
  <para style="q1" vid="PSA 16:5">in imiya gin ducu ma amito;</para>
  <para style="q1" vid="PSA 16:5">kwona ducu tye i cingi.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Jami ducu ma imiya gibeco ma yomo cwinya;</para>
  <para style="q1" vid="PSA 16:6">eyo, gin ducu gibeco adada.<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Apwoyo Rwot ma omiya ryeko;</para>
  <para style="q1" vid="PSA 16:7">cwinya bene pwonya kadi ki i dyewor.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:8: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:25-28">Tic 2:25-28</ref>
      </char>
    </note>Kare ducu angeyo ni Rwot tye kweda;</para>
  <para style="q1" vid="PSA 16:8">pe kibidira woko cen, pien en tye tung bota gin mo pe bitaga.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Pimeno omiyo abedo ki yomcwiny madwong,</para>
  <para style="q1" vid="PSA 16:9">nino ducu abedo mere maber ki kuc;<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:10: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:35">Tic 13:35</ref>
      </char>
    </note>pien in pe ibitenya ata i lobo pa jo ma oto,</para>
  <para style="q1" vid="PSA 16:10">dok pe ibiweko danoni ma geni i bur lyel.<verse eid="PSA 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />In dong ibinyuta yo ma tera i kwo;</para>
  <para style="q1" vid="PSA 16:11">bedoni kweda miyo abedo ki yomcwiny madwong mada,</para>
  <para style="q1" vid="PSA 16:11">dok miya yomcwiny ma bedo nakanaka.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s1">Lega pa ngat ma cwinye leng</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />Ai Rwot, winy kokona pien loka tye atir;</para>
  <para style="q1" vid="PSA 17:1">cik iti iwiny kokona!</para>
  <para style="q1" vid="PSA 17:1">Winy legana,</para>
  <para style="q1" vid="PSA 17:1">pien pe tye lok me bwola mo ma a ki idoga.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Ibimiyo aloyo kop,</para>
  <para style="q1" vid="PSA 17:2">pien ingeyo kop matye atir.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Ka ingiyo cwinya, dok ka ilima i dyewor,</para>
  <para style="q1" vid="PSA 17:3">kadi bed itema, pe ibinongo gin marac mo ka tye i iya;</para>
  <para style="q1" vid="PSA 17:3">dok pe abalo ilok ducu ma aloko.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Dok ka ingiyo tic pa dano,</para>
  <para style="q1" vid="PSA 17:4">ibinongo ni alubu ciki,</para>
  <para style="q1" vid="PSA 17:4">pe alubu kit pa jo ma gin lubwami.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Kare ducu abedo kalubu yoni,</para>
  <para style="q1" vid="PSA 17:5">ma pe angak woko ki iye.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Alegi kun akok boti, Ai Lubanga, pien ibigamo doga;</para>
  <para style="q1" vid="PSA 17:6">cik iti bota, iwiny lok ma aloko.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Nyut mar meri ma pe loke i yo me aura,</para>
  <para style="q1" vid="PSA 17:7">in lalar pa jo ma giyenyo kalare i cingi tung lacuc,</para>
  <para style="q1" vid="PSA 17:7">pien igwokogi woko maber ki ikom lukworgi.<verse eid="PSA 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Gwoka macalo igwoko tong wangi kikome;</para>
  <para style="q1" vid="PSA 17:8">kana ite tipu me bwomi,<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />ki ikom jo maracu ma giyako lima,</para>
  <para style="q1" vid="PSA 17:9">gin lukwora ma giracu tutwali ma giruma woko dyere.<verse eid="PSA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Cwinygi dong odoko tek ma kica mo pe makogi;</para>
  <para style="q1" vid="PSA 17:10">dok lok ma giloko bene giloko ki nyate.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Gilubu kora; kombedi guruma woko;</para>
  <para style="q1" vid="PSA 17:11">guciko wanggi me nongo kare ma myero gireta kwede woko piny i ngom.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Lukwora calo labwor ma owor, gimito kido koma woko,</para>
  <para style="q1" vid="PSA 17:12">ma giliba kun gikura calo labwor i kabedo kama gukane iye.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />A malo, Ai Rwot, wek icit irwate ki lukwora,</para>
  <para style="q1" vid="PSA 17:13">lweny kwedgi ci iloogi woko!</para>
  <para style="q1" vid="PSA 17:13">Lara ki i cing jo maracu ki pala lucwani;<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />lara ki i cinggi ki tweroni,</para>
  <para style="q1" vid="PSA 17:14">Ai Rwot, ki i cing jo ducu ma dong gitye ki jami ducu ma igi mito i kwo man.</para>
  <para style="q1" vid="PSA 17:14">Wek guyeng ki gin mayam ikano pirgi;</para>
  <para style="q1" vid="PSA 17:14">mi lutinogi bene gunong can ma oromo ki makato;</para>
  <para style="q1" vid="PSA 17:14">ci dok bene myero guwek can mogo odong pi lutinogi ma pud lukere.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Kit macalo an kita tye atiri, abineni,</para>
  <para style="q1" vid="PSA 17:15">bedoni kweda miyo aco ki iwang nino ma nongo apong ki yomcwiny.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s1">Wer me wayu pa Daudi</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 Cam 22:1-51</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Amari, Ai Rwot!</para>
  <para style="q1" vid="PSA 18:1">Pien in i teka.<verse eid="PSA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />Rwot aye gota en cel gogona matek, en lalara.</para>
  <para style="q1" vid="PSA 18:2">En Lubangana, ki gota, aringo alaro bote;</para>
  <para style="q1" vid="PSA 18:2">en gwoka macalo kwot, en kalarena matek,</para>
  <para style="q1" vid="PSA 18:2">en gengo ngeya woko ci gwoka miyo abedo maber labongo ayela.<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Akok bot Rwot,</para>
  <para style="q1" vid="PSA 18:3">ci en olara ki i cing lukwora, pimeno myero kipak Rwot.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />To otelo tole ci otweya woko adunu,</para>
  <para style="q1" vid="PSA 18:4">biamwonyi me to otwage oruma woko dyere,</para>
  <para style="q1" vid="PSA 18:4">kulu ma piine, ger ma neko dano ocore woko iwiya limuk.<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Tol me to odwala woko,</para>
  <para style="q1" vid="PSA 18:5">owic me to bene orine woko inyima.<verse eid="PSA 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Ikare ma atye i can akok bot Rwot;</para>
  <para style="q1" vid="PSA 18:6">akok gira bot Lubanga pi kony.</para>
  <para style="q1" vid="PSA 18:6">En owinyo dwona ki i ot mere maleng,</para>
  <para style="q1" vid="PSA 18:6">kokona pi kony odonyo i ite.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Cutcut lobo oyenge ma more pe twere,</para>
  <para style="q1" vid="PSA 18:7">te godi bene ducu guyenge woko ma giyenge matek,</para>
  <para style="q1" vid="PSA 18:7">pien kiniga onongo omako Lubanga.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Yito oduny okati ki i ume,</para>
  <para style="q1" vid="PSA 18:8">mac ma wang malyet ki lodine okati ki idoge.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />En oywayo polo odwoko cen, ci olor obino piny,</para>
  <para style="q1" vid="PSA 18:9">kun piny macol mapek oryene ite tyene.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Oito iwi lakerubi ci otuk kwede,</para>
  <para style="q1" vid="PSA 18:10">oringo madwir i dye yamo.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Oketo piny macol orume dyere,</para>
  <para style="q1" vid="PSA 18:11">kemane obedo pol mapek mupong ki pii.<verse eid="PSA 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Pee ki lodi mac ma lyel</para>
  <para style="q1" vid="PSA 18:12">gunen i piny maryeny maleng ki inyime,</para>
  <para style="q1" vid="PSA 18:12">otucu dye pol macol licuc woko.<verse eid="PSA 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />Rwot omiyo polo omor,</para>
  <para style="q1" vid="PSA 18:13">dwon Ngat Mamalo Twal owinye,</para>
  <para style="q1" vid="PSA 18:13">ocwalo pee ki lodi mac.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />En obayo aterone, okeyo lumerok woko;</para>
  <para style="q1" vid="PSA 18:14">omiyo lutkot owil, ci orwadogi woko piny.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Dye nam opoke, tere onen,</para>
  <para style="q1" vid="PSA 18:15">guti me te lobo bene odong twolo,</para>
  <para style="q1" vid="PSA 18:15">ikare ma ijukugi, Ai Rwot,</para>
  <para style="q1" vid="PSA 18:15">ikare ma ikutugi ki yweyo ma okati ki i umi.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Rwot ocwalo cinge piny ki i polo, ci omaka,</para>
  <para style="q1" vid="PSA 18:16">oywaya okela woko ki i pii matut.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Ci en olara ki i cing lukwora matek,</para>
  <para style="q1" vid="PSA 18:17">en olara ki i cing jo ma gidaga,</para>
  <para style="q1" vid="PSA 18:17">pien onongo gitek mada giloya woko.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Gupoto ikoma ikare ma can obwoya matek,</para>
  <para style="q1" vid="PSA 18:18">ento Rwot aye obedo kakonya.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />En okwanya woko ki i peko ma odiya;</para>
  <para style="q1" vid="PSA 18:19">en olara pien onongo ayomo cwinye.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />Rwot omiya pwoc pien oneno ni kita atir,</para>
  <para style="q1" vid="PSA 18:20">omiya gum muporo leng cwinya.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />En otima kitmeno pien abedo kalubu cik pa Rwot,</para>
  <para style="q1" vid="PSA 18:21">pe apoke woko ki bot Lubanga pi bal mo.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Alubu cike ducu,</para>
  <para style="q1" vid="PSA 18:22">pe angak aweko gin ma en ociko.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Pe atimo bal mo inyime,</para>
  <para style="q1" vid="PSA 18:23">dok agwoke mada pe atimo bal alii mo.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />Ma omiyo Rwot omiya pwoc pien oneno ni kita atir,</para>
  <para style="q1" vid="PSA 18:24">en omiya gum ma oporo leng cwinya ma abedo kwede inyime.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />Rwot, in lagen bot jo ma lugen;</para>
  <para style="q1" vid="PSA 18:25">bot ngat maber ma pe ki bal inyute bote bene calo ngat maber ma pe ki bal.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />Cwinyi leng ikom jo ma cwinygi leng,</para>
  <para style="q1" vid="PSA 18:26">ento iger ikom dano ma tame ogom.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Ilaro jo ma mwole ken gi,</para>
  <para style="q1" vid="PSA 18:27">ento jo ma luwake idwokogi woko piny.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Eyo, in aye ma icwinyo mac tarana;</para>
  <para style="q1" vid="PSA 18:28">Rwot Lubangana aye menyo colpinya.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Eyo, atwero tyeko buca mony kulu ka ikonya;</para>
  <para style="q1" vid="PSA 18:29">pi teko pa Lubangana miyo apye akalo wi cel.<verse eid="PSA 18:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />Lubanga man, gin ducu ma en tiyo tye atir,</para>
  <para style="q1" vid="PSA 18:30">lok pa Rwot ma en cike me tiyo bedo ada;</para>
  <para style="q1" vid="PSA 18:30">en tye macalo kwot pa jo ducu ma giringo gilaro bote.<verse eid="PSA 18:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />Anga ma Lubanga, kono Rwot kene?</para>
  <para style="q1" vid="PSA 18:31">Anga ma got, pe Lubangawa aye keken gire?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />En aye Lubanga ma oruka ki tek,</para>
  <para style="q1" vid="PSA 18:32">en aye ma omiyo awoto ki kuc.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:33: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 3:19">Kab 3:19</ref>
      </char>
    </note>En oketo tyena obedo macalo tyen til,</para>
  <para style="q1" vid="PSA 18:33">ociba malo kama acung iye matek.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />En pwonyo cinga pi lweny,</para>
  <para style="q1" vid="PSA 18:34">ma omiyo atwero bayo wa atum mola.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Dong ityeko miya kwot me lari,</para>
  <para style="q1" vid="PSA 18:35">kun ijola ki cingi ma lacuc;</para>
  <para style="q1" vid="PSA 18:35">kony ma in imiya omiya adoko dit.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Imiyo aringo ayomo jo ma giryema ma gimito maka,</para>
  <para style="q1" vid="PSA 18:36">dok bene tyena pe ocer.<verse eid="PSA 18:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Aryemo kor lukwora ci amakogi woko i yoo;</para>
  <para style="q1" vid="PSA 18:37">pe aloke adok cen nio, ka atyekogi ducu.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Acobogi woko pil ci gupoto piny katyena;</para>
  <para style="q1" vid="PSA 18:38">ma pe dong gutwero a malo.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />In aye iruka ki tek pi lweny;</para>
  <para style="q1" vid="PSA 18:39">imiyo lulweny ikoma guto gutum woko katyena.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Imiyo lumeroka gungweco woko ki bota,</para>
  <para style="q1" vid="PSA 18:40">imiyo atyeko jo ma gidaga woko.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Gukok pi kony, ento ngat mo pe ma olarogi,</para>
  <para style="q1" vid="PSA 18:41">gukok bot Rwot, ento en pe ogamo doggi.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Adinogi woko gudoko macalo apwa ma yot mayamo kolo;</para>
  <para style="q1" vid="PSA 18:42">anyonogi macalo coto matye i yoo gudo.<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />In yam ilara ki ikom rok mapol ma gilwenyo kweda;</para>
  <para style="q1" vid="PSA 18:43">iketa abedo ladit maloyo rok ducu;</para>
  <para style="q1" vid="PSA 18:43">jo mayam pe angeyogi gudoko jo ma an aye aloyogi.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Cutcut ka lurok guwinyo pira ci gubino bota ma gimwole amwola,</para>
  <para style="q1" vid="PSA 18:44">ci lurok gubino kun giryebe piny inyima.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Tekcwiny orwenyo woko ki botgi,</para>
  <para style="q1" vid="PSA 18:45">gua ki kama gukane iye gubino ma komgi myel amyela.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />Rwot tye kwo! Kipwoye pien en gota!</para>
  <para style="q1" vid="PSA 18:46">Kipil wi Lubanga ma en lalara.<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />En Lubanga ma omiya aculu kwor ikom lukwora,</para>
  <para style="q1" vid="PSA 18:47">dok ma obwoyo rok mapol, omiyo gubedo ite loca;<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />ci olara ki i cing lumeroka.</para>
  <para style="q1" vid="PSA 18:48">Eyo, ipilo wiya makato lukwora, ilara ki i cing lulweny ma lubwami.<verse eid="PSA 18:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:49: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:9">Rom 15:9</ref>
      </char>
    </note>Pimeno abikori ikin lurok, Ai Rwot,</para>
  <para style="q1" vid="PSA 18:49">dok abiwero wer me pako nyingi.<verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Lubanga miyo deyo me loc madit bot rwote,</para>
  <para style="q1" vid="PSA 18:50">dok nyutu mar mere ma pe loke ikom danone ma en oyero ka kiwiro,</para>
  <para style="q1" vid="PSA 18:50">bot Daudi ki likwaye ducu matwal.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s1">Deyo pa Lubanga i ginacweya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Polo ki jami ducu matye iye ginyutu deyo pa Lubanga;</para>
  <para style="q1" vid="PSA 19:1">dan polo bene tito pi tic me cinge.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Nino acel acel tucu pire bot nino malube,</para>
  <para style="q1" vid="PSA 19:2">dyewor acel acel bene nwoyo titone bot dyewor mukene wek onge.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Pe giloko, ki lokgi mo bene peke;</para>
  <para style="q1" vid="PSA 19:3">dwon gi mo pe winye.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:4: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:18">Rom 10:18</ref>
      </char>
    </note>Ento dwon gi winye teretere iwi lobo ducu,</para>
  <para style="q1" vid="PSA 19:4">ki lok ma giloko winye wa i agiki piny.</para>
  <para style="b" vid="PSA 19:4" />
  <para style="q1" vid="PSA 19:4">Lubanga oguru kema i polo pi ceng,<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />ma bino macalo lanyom ma a woko ki i kicikane,</para>
  <para style="q1" vid="PSA 19:5">macalo laco ma kome tek ma ringo ngwec ki yomcwiny.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Tuc ki i acaki polo tungcel,</para>
  <para style="q1" vid="PSA 19:6">woto rumu woko ducu wa i agikine;</para>
  <para style="q1" vid="PSA 19:6">gin mo peke liweng matwero kane ki ilyetone.<verse eid="PSA 19:6" /></para>
  <para style="s1">Cik pa Rwot</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Cik pa Rwot ber, dok tye atir;</para>
  <para style="q1" vid="PSA 19:7">miyo keru me kwo manyen bot dano;</para>
  <para style="q1" vid="PSA 19:7">gin ma Rwot ociko tye me ada,</para>
  <para style="q1" vid="PSA 19:7">miyo ryeko bot jo ma gipeke ki ryeko.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Cik pa Rwot tye atir,</para>
  <para style="q1" vid="PSA 19:8">yomo cwiny dano;</para>
  <para style="q1" vid="PSA 19:8">gin ducu ma Rwot ociko tye maleng,</para>
  <para style="q1" vid="PSA 19:8">miyo dano niang maber.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Lworo Rwot ber,</para>
  <para style="q1" vid="PSA 19:9">dok pe bigik matwal,</para>
  <para style="q1" vid="PSA 19:9">ngolo kop pa Rwot tye kakare,</para>
  <para style="q1" vid="PSA 19:9">dok bedo atir kare ducu.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Pirgi tek ma myero kimak makato jabu,</para>
  <para style="q1" vid="PSA 19:10">kato bene jabu ma kiliyo maber.</para>
  <para style="q1" vid="PSA 19:10">Lim kato moo kic woko,</para>
  <para style="q1" vid="PSA 19:10">kato bene wa moo kic ma cwer ki i peda kic.<verse eid="PSA 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Gimiyo ngec bot an latici;</para>
  <para style="q1" vid="PSA 19:11">an ngat ma gwoko ciki alimo mot madit.<verse eid="PSA 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Anga matwero neno bale kene?</para>
  <para style="q1" vid="PSA 19:12">Lara ki ikom bala ducu mukane.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Juka bene wek pe apot i bal mo ma obino pi cwiny me wake;</para>
  <para style="q1" vid="PSA 19:13">pe iwek oloya!</para>
  <para style="q1" vid="PSA 19:13">Ci abibedo labongo bal mo ikoma,</para>
  <para style="q1" vid="PSA 19:13">abibedo ma pe atimo bal mo.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Mii lok ma a ki idoga ki tam ducu matye i cwinya</para>
  <para style="q1" vid="PSA 19:14">obed ma in ipwoyo,</para>
  <para style="q1" vid="PSA 19:14">Ai Rwot, in aye gota dok lalara.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s1">Lega pi loyo lweny</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />Rwot myero ogam dogi inino ma itye ki can!</para>
  <para style="q1" vid="PSA 20:1">Lubanga pa Yakobo myero okonyi!<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />En myero ocwal kony boti ki i kabedone maleng,</para>
  <para style="q1" vid="PSA 20:2">okony kori ki i Cion!<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />En myero ogam mot ducu ma ityero bote,</para>
  <para style="q1" vid="PSA 20:3">dok opwo gitum awangani ducu ma itumu bote.<verse eid="PSA 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />En myero omiyi gin ma cwinyi mito,</para>
  <para style="q1" vid="PSA 20:4">dok omii yub meri ducu ocobe kakare.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Wek wawer wer me pak ki yomcwiny pi loci;</para>
  <para style="q1" vid="PSA 20:5">wek wail benderawa malo i nying Lubangawa!</para>
  <para style="q1" vid="PSA 20:5">Rwot omiyi gin ducu ma ilego ki bote!<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Kombedi dong angeyo ni Rwot bikonyo laker ma mere ma kiwiro.</para>
  <para style="q1" vid="PSA 20:6">En bigamo doge ki i polone maleng, dok bimiye loyo lweny.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Jo mogo ginyate pi gadigadi lweny, ki pi aguragura;</para>
  <para style="q1" vid="PSA 20:7">ento wan wanyate pi nying Rwot Lubangawa.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Gibiyoke ci gipoto woko piny;</para>
  <para style="q1" vid="PSA 20:8">ento wan wabia malo wacung atir.<verse eid="PSA 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Mii loc bot laker meri, Ai Rwot;</para>
  <para style="q1" vid="PSA 20:9">gam dogwa ka wakok boti.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s1">Pak pi lar ki i cing lukwor</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Laker tye ki yomcwiny, Ai Rwot, pien in aye imiye tek;</para>
  <para style="q1" vid="PSA 21:1">dok opong ki yomcwiny madwong pi loc ma imiye.<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Ityeko miye gin ma cwinye mito,</para>
  <para style="q1" vid="PSA 21:2">dok igamo doge imiye gin ma en olegi pire.<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Ijole ki mot mabeco me gum;</para>
  <para style="q1" vid="PSA 21:3">iketo bene lalukana me jabu ma kiliyo maber i wiye.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />En olegi ni imiye kwo, ci imiye;</para>
  <para style="q1" vid="PSA 21:4">imiye kwo ma rii nakanaka pi kare malac.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Deyone dit pi kony ma imiyo bote;</para>
  <para style="q1" vid="PSA 21:5">imiye deyo ki dit me loc.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Eyo, imiyo ki en gum mabedo ikome matwal;</para>
  <para style="q1" vid="PSA 21:6">bedoni kwede miye yomcwiny.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Laker geno Rwot;</para>
  <para style="q1" vid="PSA 21:7">pimeno pe kibidire cen,</para>
  <para style="q1" vid="PSA 21:7">pi mar ma pe loke pa Ngat Mamalo Twal.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Ibicwalo cingi imako lukwori woko ducu;</para>
  <para style="q1" vid="PSA 21:8">ibimako jo ducu ma gidagi ki cingi ma lacuc.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Ka ibinen botgi,</para>
  <para style="q1" vid="PSA 21:9">ci ibilokogi woko i ruk-mac.</para>
  <para style="q1" vid="PSA 21:9">Rwot bimwonyogi woko ki kinigane,</para>
  <para style="q1" vid="PSA 21:9">ci mac biwangogi woko.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Ibineko lutinogi ityeko woko liweng ki i lobo,</para>
  <para style="q1" vid="PSA 21:10">ibineko likwayogi woko ducu.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Gipiro lok ikomi kun giyubu me timi marac,</para>
  <para style="q1" vid="PSA 21:11">ento kadi gibed ki yub me timo gin marac, yubgi pe bicobe kakare.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Ibitelo atumi ibayo atero kun imito icel wanggi woko;</para>
  <para style="q1" vid="PSA 21:12">miyo gin ducu giringo woko.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Dong kidwori pi teki, Ai Rwot!</para>
  <para style="q1" vid="PSA 21:13">Dok wabiwero wer kun wapako tweroni.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s1">Koko me remcwiny ki wer me pak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:1: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:46">Mat 27:46</ref>; <ref loc="MRK 15:34">Mar 15:34</ref></char>
    </note>Lubangana, Lubangana, itenya woko pingo?</para>
  <para style="q1" vid="PSA 22:1">Pingo ibedo kamabor ma pe iromo lara,</para>
  <para style="q1" vid="PSA 22:1">ma bene pe iwinyo ka acur acura?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Akok boti dyeceng, Ai Lubangana, ento pe igamo doga;</para>
  <para style="q1" vid="PSA 22:2">akok boti dyewor benebene,</para>
  <para style="q1" vid="PSA 22:2">ento pe anongo kit yweyo mo.<verse eid="PSA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Ento kun in ibedo iwi komkeri macalo Laker Maleng,</para>
  <para style="q1" vid="PSA 22:3">in aye Lubanga ma jo Icrael gipako.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Kwariwa yam gugeni;</para>
  <para style="q1" vid="PSA 22:4">gugeni, ci omiyo ilarogi.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Gin gukok boti, ci ilarogi;</para>
  <para style="q1" vid="PSA 22:5">gugeni, omiyo lewic pe omakogi.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Ento an mere acalo kwidi, ma konye peke;</para>
  <para style="q1" vid="PSA 22:6">jo ducu gingala dok gicaya.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:7: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:39">Mat 27:39</ref>; <ref loc="MRK 15:29">Mar 15:29</ref>; <ref loc="LUK 23:35">Luk 23:35</ref></char>
    </note>Jo ducu ma ginena gijwiya ajwiya,</para>
  <para style="q1" vid="PSA 22:7">gijanyo doggi ikoma, kun giyengo wigi.<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:43">Mat 27:43</ref>
      </char>
    </note>Gin giwaco ni, “En omiyo kwone bot Rwot;</para>
  <para style="q1" vid="PSA 22:8">wek Rwot olare,</para>
  <para style="q1" vid="PSA 22:8">wek Rwot olare ka cwinye yom ikome!”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />In aye yam ikonya omiyo kinywala;</para>
  <para style="q1" vid="PSA 22:9">ikare ma an pud latin lakere igwoka maber.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Cake ma kinywala abedo ka jenge ikomi,</para>
  <para style="q1" vid="PSA 22:10">cake ikare ma maa onywala in aye ibedo Lubangana.<verse eid="PSA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Pe ibed bor kweda,</para>
  <para style="q1" vid="PSA 22:11">pien ayelayela tye cok;</para>
  <para style="q1" vid="PSA 22:11">pe tye ngat mo ma myero okonya.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Lukwor mapol guruma woko macalo twoni,</para>
  <para style="q1" vid="PSA 22:12">gin ducu guruma woko dyere,</para>
  <para style="q1" vid="PSA 22:12">calo twoni ma komgi tek ma gua ki i lobo Bacan.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Gin ngamo doggi malac ikoma,</para>
  <para style="q1" vid="PSA 22:13">calo labwor mager matye kakoko.<verse eid="PSA 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Teka otum woko macalo pii ma kionyo i ngom,</para>
  <para style="q1" vid="PSA 22:14">cogona ducu guwote woko ki iwang mwot;</para>
  <para style="q1" vid="PSA 22:14">cwinya leny calo odok kic matye kaleny.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Teka otwo woko calo tako mutwo,</para>
  <para style="q1" vid="PSA 22:15">ki leba bene omoko woko i dana;</para>
  <para style="q1" vid="PSA 22:15">imiya apoto piny i apwa macalo ngat ma oto.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Eyo, dul pa jo ma gin lutim maracu gugura woko dyere,</para>
  <para style="q1" vid="PSA 22:16">gin calo lwak gwogi ma gugura woko dyere</para>
  <para style="q1" vid="PSA 22:16">ma dong gikayo cinga ki tyena.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Atwero kwano wel cogona ducu.</para>
  <para style="q1" vid="PSA 22:17">Ginena ki cac ma guciko wang gi ikoma.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:18: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:35">Mat 27:35</ref>; <ref loc="MRK 15:24">Mar 15:24</ref>; <ref loc="LUK 23:34">Luk 23:34</ref>; <ref loc="JHN 19:24">Jon 19:24</ref></char>
    </note>Gupoko ginarukana woko ikin gi,</para>
  <para style="q1" vid="PSA 22:18">kun gibolo kwir pi bongona.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Ento in, Ai Rwot, pe ibed kamabor kweda!</para>
  <para style="q1" vid="PSA 22:19">In Lalara, rune ibin oyot ikonya!<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Lara ki i lak pala lucwan,</para>
  <para style="q1" vid="PSA 22:20">lar kwona ki i teko pa gwogi magi!<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Lara ki i dog labwor magi,</para>
  <para style="q1" vid="PSA 22:21">dong ityeko laro kwona woko ki i tung twoni mageri!<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Abitito pi gin ma itiyo bot utmegina;</para>
  <para style="q1" vid="PSA 22:22">abipaki i dye lwak ma gucoke kacel.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Wun jo ma wulworo Rwot, wupake!</para>
  <para style="q1" vid="PSA 22:23">Wun likwaye pa Yakobo ducu wumiye deyo,</para>
  <para style="q1" vid="PSA 22:23">wuwore, wun jo Icrael ducu!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />En pe cayo can pa jo ma can opoto ikomgi;</para>
  <para style="q1" vid="PSA 22:24">iye pe dag neno can gi,</para>
  <para style="q1" vid="PSA 22:24">ento winyo kokogi, ka gukok bote.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Abipaki i dye lwak madwong ma gucoke kacel;</para>
  <para style="q1" vid="PSA 22:25">abicobo kwonga inyim jo ducu ma gilwori.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Jo ma can opoto ikomgi gibicamo cam ma giyeng;</para>
  <para style="q1" vid="PSA 22:26">ki jo ma giyenyo Rwot gibipake!</para>
  <para style="q1" vid="PSA 22:26">Myero gubed ki kwo maber nakanaka!<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Rok ducu ma i lobo gibipo ikom Rwot;</para>
  <para style="q1" vid="PSA 22:27">gibia ki i kabedo ducu gidwogo bote;</para>
  <para style="q1" vid="PSA 22:27">kaka ducu me rok mapatpat gibibino kawore.<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />Rwot aye laker,</para>
  <para style="q1" vid="PSA 22:28">dok loyo jo me rok ducu.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Eyo, jo ducu ma gin camo dito me lobo gibigungu piny bote;</para>
  <para style="q1" vid="PSA 22:29">ki jo ma oto ma gidok i ngom gibigungu piny inyime,</para>
  <para style="q1" vid="PSA 22:29">wa jo ducu ma gingeyo ni gin bene pe gibedo kwo.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Yalwak me kare ma anyim ducu gibitiyo bote;</para>
  <para style="q1" vid="PSA 22:30">dano gibitito lok ikom Rwot bot yalwak ma lubugi,<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />kun gitucu lare bot jo ma pud peya kinywalogi,</para>
  <para style="q1" vid="PSA 22:31">ni Rwot aye ma olaro jone.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s1">Rwot aye lakwata</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />Rwot aye lakwat ma kwayo an;</para>
  <para style="q1" vid="PSA 23:1">pe tye gin mo ma birem bota.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:2: </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:17">Niy 7:17</ref>
      </char>
    </note>En miyo abutu i olet maber,</para>
  <para style="q1" vid="PSA 23:2">en tera iwang pii mupye.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />En roco kwona doko nyen.</para>
  <para style="q1" vid="PSA 23:3">En tela miyo abedo ki kit kwo ma atir</para>
  <para style="q1" vid="PSA 23:3">pi nyinge kene keken.<verse eid="PSA 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Kadi bed awot i nota me tipu to,</para>
  <para style="q1" vid="PSA 23:4">pe abilworo gin mo marac;</para>
  <para style="q1" vid="PSA 23:4">pien in itye kweda;</para>
  <para style="q1" vid="PSA 23:4">tongi ki odooni me kwat gimiyo cwinya bedo tek.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Iketo meja me cam inyima</para>
  <para style="q1" vid="PSA 23:5">ma nongo lukwora bene gineno;</para>
  <para style="q1" vid="PSA 23:5">ijola maber kun iwiro wiya ki moo,</para>
  <para style="q1" vid="PSA 23:5">kikopona bene opong woko libyeny.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Adada, beri ki kicani bibedo ikoma</para>
  <para style="q1" vid="PSA 23:6">pi kare me kwona ducu;</para>
  <para style="q1" vid="PSA 23:6">dok an abibedo i Ot pa Rwot matwal.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s1">Rwot madit</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:26">1 Kor 10:26</ref>
      </char>
    </note>Lobo kacel ki jami ducu matye iye gin jami pa Rwot;</para>
  <para style="q1" vid="PSA 24:1">lobo kacel ki jo ducu ma gibedo iye bene mere.<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />En con oketo lobo iwi nam,</para>
  <para style="q1" vid="PSA 24:2">dok oketo te gutine ocung matek i dye pii me kulu matut.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Anga matye ki twero me ito malo iwi got pa Rwot?</para>
  <para style="q1" vid="PSA 24:3">Anga matwero cung i kabedone maleng?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:4: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:8">Mat 5:8</ref>
      </char>
    </note>Ngat ma tiyo gin ma atir, dok ma cwinye leng,</para>
  <para style="q1" vid="PSA 24:4">ngat ma pe miyo kwone me woro lubanga ma pe ada,</para>
  <para style="q1" vid="PSA 24:4">dok ma pe kwongo kwong ki goba.<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Rwot bimiye gum,</para>
  <para style="q1" vid="PSA 24:5">Lubanga lalare bimiyo en loyo kop.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Meno gin aye jo ma giyenyo en,</para>
  <para style="q1" vid="PSA 24:6">gin jo ma gibino inyim Lubanga pa Yakobo.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Wutinge, wuyabe malac, wun dog cel!</para>
  <para style="q1" vid="PSA 24:7">Wuyabe, wun dogola macon,</para>
  <para style="q1" vid="PSA 24:7">wek rwot madit me deyo odony.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Anga mono ma rwot madit me deyo?</para>
  <para style="q1" vid="PSA 24:8">En Rwot matek matye ki twer,</para>
  <para style="q1" vid="PSA 24:8">en Rwot matek maloyo lweny!<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Wutinge, wuyabe malac, wun dog cel!</para>
  <para style="q1" vid="PSA 24:9">Wuyabe, wun dogola macon,</para>
  <para style="q1" vid="PSA 24:9">wek Rwot me deyo odony.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Rwot me deyo man en anga?</para>
  <para style="q1" vid="PSA 24:10">Rwot me mony</para>
  <para style="q1" vid="PSA 24:10">aye Rwot madit!<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s1">Lega pi tel ki pi gwok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />Atingo kwona amiyo boti, Ai Rwot.<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Ageno in, Ai Lubangana, pe iwek lewic omaka;</para>
  <para style="q1" vid="PSA 25:2">pe iwek lukwora gunyera.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Eyo, pe iwek lewic omak jo ma giketo gen gi ikomi;</para>
  <para style="q1" vid="PSA 25:3">ento wek lewic omak jo ma gijemo woko ikomi nonono.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Pwonya wek ange yoni ducu, Ai Rwot;</para>
  <para style="q1" vid="PSA 25:4">pwonya me ngeyo yoni.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Tela i ada meri, dok ipwonya,</para>
  <para style="q1" vid="PSA 25:5">pien in Lubanga lalara,</para>
  <para style="q1" vid="PSA 25:5">aketo gen mera ikomi jwijwi.<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Po pi kicani, Ai Rwot, ki pi mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 25:6">mayam inyutu nia wacon.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Pe ipo pi roc ki bal mayam atimo ikare me tinona.</para>
  <para style="q1" vid="PSA 25:7">Ento po pira pi mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 25:7">ki pi beri, Ai Rwot.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />Rwot ber, dok cwinye atir;</para>
  <para style="q1" vid="PSA 25:8">pimeno en pwonyo lubalo yo ma myero gulubi.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />En telo jo mamwol me tiyo gin ma atir,</para>
  <para style="q1" vid="PSA 25:9">dok pwonyogi wek gunge gin ma en mito.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Yo pa Rwot ducu opong ki mar ma pe loke dok ki gen,</para>
  <para style="q1" vid="PSA 25:10">pi jo ma gigwoko gicikene ki lok me cik ma mere.<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />Pi ber me nyingi, Ai Rwot, wek bala, pien dwong.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Jo mene mono ma lworo Rwot?</para>
  <para style="q1" vid="PSA 25:12">Rwot bipwonyogi yo ma myero gulubi.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Gin ki komgi bibedo ki gum ma rii nakanaka,</para>
  <para style="q1" vid="PSA 25:13">dok lutinogi bene gibicamo lobo.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />Rwot bedo larem jo ma gilwore,</para>
  <para style="q1" vid="PSA 25:14">dok bene en miyo gingeyo gicikene.<verse eid="PSA 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Aneno bot Rwot kare ducu,</para>
  <para style="q1" vid="PSA 25:15">pien en bigonyo tyena woko ki i owic.<verse eid="PSA 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />Loke idwog bota, dok inyuta kicani;</para>
  <para style="q1" vid="PSA 25:16">pien dong adong kena, dok can odiya woko.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Kwany cwercwiny woko ducu ki i cwinya,</para>
  <para style="q1" vid="PSA 25:17">dok ilara ikwanya woko ki i lwak can ma atye iye.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Tam pi cana ki ayela ma atye kwede,</para>
  <para style="q1" vid="PSA 25:18">ci iwek bala ducu.<verse eid="PSA 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Tam pi lwak lukwora ma gitye,</para>
  <para style="q1" vid="PSA 25:19">nen kit ma gidaga kwede ki gero matek!<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Gwok kwona, dok ilara;</para>
  <para style="q1" vid="PSA 25:20">pe iwek kiket lewic iwiya,</para>
  <para style="q1" vid="PSA 25:20">pien aringo alaro boti.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Mii bera ki cwiny ma atir ma atye kwede gugwoka, pien ageno in.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />Ai Lubanga, lar jo Icrael ki i pekogi ducu.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s1">Lega pa dano ma cwinye ber</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Ngol kop atir, Ai Rwot,</para>
  <para style="q1" vid="PSA 26:1">pien abedo katiyo gin ma atir,</para>
  <para style="q1" vid="PSA 26:1">kun ageno in ki cwinya ducu ma pe akalo akala.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Ngiya maber, Ai Rwot, dok itema;</para>
  <para style="q1" vid="PSA 26:2">tem cwinya ki tama ducu.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Pien mar meri ma pe loke aye tela,</para>
  <para style="q1" vid="PSA 26:3">dok geneni aye ma nyuta yo.<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Pe abedo kacel ki jo ma lugoba,</para>
  <para style="q1" vid="PSA 26:4">dok pe aribe ki jo ma lubwola.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Adag ribe ki lutim maracu,</para>
  <para style="q1" vid="PSA 26:5">pe bene abibedo kacel ki jo maracu.<verse eid="PSA 26:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Ai Rwot, alwoko cinga pi nyutu ni apeke ki bal mo,</para>
  <para style="q1" vid="PSA 26:6">kun awori ma awoto arumu kwede keno tyeri.<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />Dok awero wer me pwoc ki dwona malongo,</para>
  <para style="q1" vid="PSA 26:7">kun atito bene pi tic me aura ma itiyo.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />Ai Rwot, amaro odi kama ibedo iye,</para>
  <para style="q1" vid="PSA 26:8">ma en aye kabedo kama deyoni tye iye.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Pe ityeka woko kacel ki lubalo,</para>
  <para style="q1" vid="PSA 26:9">dok pe ineka woko kacel ki jo ma gioyo remo pa dano.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Gin jo ma cwinygi tye pi timo gin marac,</para>
  <para style="q1" vid="PSA 26:10">ma jabagi opong woko ki lim me wil i mung.<verse eid="PSA 26:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Ento an atiyo gin ma atir;</para>
  <para style="q1" vid="PSA 26:11">lara, dok inyuta kicani.<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Abedo ki kuc ma gin marac mo peke ma gudu koma;</para>
  <para style="q1" vid="PSA 26:12">abipako Rwot i dye lwake ma gucoke.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s1">Lega me pak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />Rwot aye dero mera ki lalara; abilworo anga?</para>
  <para style="q1" vid="PSA 27:1">Rwot gwoka ki igin marac ducu;</para>
  <para style="q1" vid="PSA 27:1">pimeno pe abilworo ngat mo keken.<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Ka lutim maracu guero lweny ikoma kun gimito neka woko,</para>
  <para style="q1" vid="PSA 27:2">jo ma gin lukwora ki lumonena,</para>
  <para style="q1" vid="PSA 27:2">gibicato ci gipoto woko piny.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Kadi dul mony mo oruma woko dyere,</para>
  <para style="q1" vid="PSA 27:3">pe abibedo ki lworo i cwinya;</para>
  <para style="q1" vid="PSA 27:3">kadi gier lweny ikoma,</para>
  <para style="q1" vid="PSA 27:3">pud abibedo ki gen aye ikom Rwot.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Onongo alego Rwot pi jami acel,</para>
  <para style="q1" vid="PSA 27:4">abiyenyo en jami aceli keken ni,</para>
  <para style="q1" vid="PSA 27:4">myero abed i Ot pa Rwot pi kare me kwona ducu</para>
  <para style="q1" vid="PSA 27:4">wek abed kaneno ber pa Rwot,</para>
  <para style="q1" vid="PSA 27:4">dok apeny doge ki i ode.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />En bikana i ode,</para>
  <para style="q1" vid="PSA 27:5">ikare me can;</para>
  <para style="q1" vid="PSA 27:5">biuma woko i kemane,</para>
  <para style="q1" vid="PSA 27:5">dok biketa acung malo iwi got.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Pimeno abiloyo lukwora woko ducu</para>
  <para style="q1" vid="PSA 27:6">ma giruma woko dyereni;</para>
  <para style="q1" vid="PSA 27:6">dok abityero gitum i Ot pa Rwot kun adange ki yomcwiny madwong;</para>
  <para style="q1" vid="PSA 27:6">abiwero wer kun apako Rwot</para>
  <para style="q1" vid="PSA 27:6">ki dwon mamit.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Winya, Ai Rwot, ka akok boti matek,</para>
  <para style="q1" vid="PSA 27:7">nyut kicani bota dok igam doga!<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Iwaco ni, “Bin bota.”</para>
  <para style="q1" vid="PSA 27:8">Agamo ki i cwinya kun awaco ni,</para>
  <para style="q1" vid="PSA 27:8">“Abibino boti, Ai Rwot.”<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Pe ikane woko ki bota.</para>
  <para style="b" vid="PSA 27:9" />
  <para style="q1" vid="PSA 27:9">Pe iryem latici woko ki kiniga; in aye ibedo lakonya.</para>
  <para style="q1" vid="PSA 27:9">Pe ibola woko, dok pe ibwota, Ai Lubanga lalara!<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Wora ki maa gitwero bwota woko,</para>
  <para style="q1" vid="PSA 27:10">ento Rwot gire bigwoka.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Pwonya wek ange yoni, Ai Rwot,</para>
  <para style="q1" vid="PSA 27:11">tela awot i yoo ma opire maber,</para>
  <para style="q1" vid="PSA 27:11">wek lukwora pe guliba.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Pe imiya bot lumonena;</para>
  <para style="q1" vid="PSA 27:12">pien lucaden ma lugoba gucung kaloko lok gobagoba ikoma,</para>
  <para style="q1" vid="PSA 27:12">ma giloko loke ducu ki gero.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Aye ni abineno ber pa Rwot,</para>
  <para style="q1" vid="PSA 27:13">ma pud abedo ikin jo makwo i lobo.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Gen Rwot; bed ma itek, dok ibed ki tekcwiny; eyo, gen Rwot!<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s1">Lega pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Akok boti do Ai Rwot;</para>
  <para style="q1" vid="PSA 28:1">pe iding iti woko kawinyo kokona do, in gota,</para>
  <para style="q1" vid="PSA 28:1">pien ka iling woko ma pe igamo doga,</para>
  <para style="q1" vid="PSA 28:1">miyo adoko ngat acel ikin jo ma gidonyo piny i lyel.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Winy dwon me lega me bako doga boti ka akok boti pi kony,</para>
  <para style="q1" vid="PSA 28:2">kun atango cinga malo boti ma akemo kwede Ot meri maleng.<verse eid="PSA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Pe ingol kop oloya kacel ki jo maracu,</para>
  <para style="q1" vid="PSA 28:3">ki jo ma timo gin marac,</para>
  <para style="q1" vid="PSA 28:3">gin jo ma giloko ki luwotgi lok makelo kuc</para>
  <para style="q1" vid="PSA 28:3">kun gitamo ki i cwinygi me timo tim aranyi.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:4: </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:12">Niy 22:12</ref>
      </char>
    </note>Culgi muporo kit timgi,</para>
  <para style="q1" vid="PSA 28:4">ma oporo timgi maracu,</para>
  <para style="q1" vid="PSA 28:4">culgi muporo ticgi maracu</para>
  <para style="q1" vid="PSA 28:4">mi gunong can pi gin marac ma gutimo.<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Gin pe giparo pi gin ma Rwot otimo,</para>
  <para style="q1" vid="PSA 28:5">kadi pi tic me cinge;</para>
  <para style="q1" vid="PSA 28:5">pimeno en biturugi woko,</para>
  <para style="q1" vid="PSA 28:5">ma dok pe kibigero matwal.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Kipak Rwot,</para>
  <para style="q1" vid="PSA 28:6">pien en dong otyeko winyo kokona me bako dog.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />Rwot aye teka dok kwota;</para>
  <para style="q1" vid="PSA 28:7">agene ki cwinya ducu.</para>
  <para style="q1" vid="PSA 28:7">En okonya omiyo cwinya opong ki yomcwiny madwong,</para>
  <para style="q1" vid="PSA 28:7">dok awero wer me pak kun amiyo pwoc bote.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />Rwot aye tek pa lwake,</para>
  <para style="q1" vid="PSA 28:8">en aye kama dano ma en oyero ringo laro iye.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Lar lwaki, dok imii gum ikom jo ma gin meri.</para>
  <para style="q1" vid="PSA 28:9">Bed lakwatgi, dok igwokgi nakanaka.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s1">Dwon Rwot winye i dye yamo mapek</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:7-9">Jab 96:7-9</ref>
      </char>
    </note>Wupak Rwot, wun gin makwo ducu ma wubedo i polo,</para>
  <para style="q1" vid="PSA 29:1">wupak Rwot pi deyone ki pi teke.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Wupak nying Rwot matye kideyo;</para>
  <para style="q1" vid="PSA 29:2">wuwor Rwot pi deyone maleng.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Dwon Rwot mor winye wa iwi pii;</para>
  <para style="q1" vid="PSA 29:3">dwon Lubanga me deyo tye kamor,</para>
  <para style="q1" vid="PSA 29:3">Rwot dwone tye kawinye iwi nam madongo.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Dwon Rwot winye</para>
  <para style="q1" vid="PSA 29:4">ma opong ki tek dok ki dit me loc.<verse eid="PSA 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Dwon Rwot baro wa yadi cedar woko,</para>
  <para style="q1" vid="PSA 29:5">kadi wa yadi cedar madongo me Lebanon.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />En miyo godi me Lebanon pye calo roya dyang,</para>
  <para style="q1" vid="PSA 29:6">ki Cirion bene en miyo pye calo wod jubi ma i tim.<verse eid="PSA 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Dwon Rwot meny ci miyo leb mac puk woko lipil.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Dwon Rwot miyo tim yenge,</para>
  <para style="q1" vid="PSA 29:8">Rwot yengo tim Kadec.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Dwon Rwot miyo til nywal,</para>
  <para style="q1" vid="PSA 29:9">dok jwero yadi me bunga woko ducu;</para>
  <para style="q1" vid="PSA 29:9">dano ducu ma gicoke i ode gidange ni,</para>
  <para style="q1" vid="PSA 29:9">“Deyo obed bot Lubanga!”<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />Rwot aye maloyo pii matut ducu matye i nam;</para>
  <para style="q1" vid="PSA 29:10">en bedo iwi komkere matwal macalo rwot.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />Rwot myero omii teko bot lwake!</para>
  <para style="q1" vid="PSA 29:11">En myero omii gum me kuc ikom jone!<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s1">Lega me pwoc</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Abipaki, ai Rwot, pien dong ilara woko ki bur matut,</para>
  <para style="q1" vid="PSA 30:1">dok pe imiyo lukwora gubedo ki yomcwiny pira.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Ai Rwot Lubangana, onongo akok boti ni ikonya,</para>
  <para style="q1" vid="PSA 30:2">ci in dong ityeko canga woko.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Ai Rwot, in aye ma ilara ikwanya woko ki i lobo pa jo ma oto,</para>
  <para style="q1" vid="PSA 30:3">iroco kwona odoko nyen ki ikin jo ma gudonyo piny i lyel.<verse eid="PSA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Wuwer wer me pako Rwot wun jone ma gene,</para>
  <para style="q1" vid="PSA 30:4">dok wumiye pwoc pi nyinge maleng.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Kinigane pe rii, bedo pi kare manok keken,</para>
  <para style="q1" vid="PSA 30:5">ento bere bedo pi kare me kwowa kulu.</para>
  <para style="q1" vid="PSA 30:5">Koko twero bedo i dyewor,</para>
  <para style="q1" vid="PSA 30:5">ento yomcwiny bino i odiko.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Dong an ikare ma atye ki lonyo awaco ni,</para>
  <para style="q1" vid="PSA 30:6">“Dong pe kibidira woko cen.”<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />Pi beri bota, Ai Rwot,</para>
  <para style="q1" vid="PSA 30:7">omiyo iciba acung liking macalo got matek.</para>
  <para style="q1" vid="PSA 30:7">Ento ikare ma ikane woko ki bota,</para>
  <para style="q1" vid="PSA 30:7">abedo ki lworo madwong.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Akok boti, Ai Rwot,</para>
  <para style="q1" vid="PSA 30:8">dok alego lega me bako dog bot Rwot kun awaco ni,<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />“Kit kony ango ma tona twero miyo boti</para>
  <para style="q1" vid="PSA 30:9">ka adonyo piny i bur?</para>
  <para style="q1" vid="PSA 30:9">Apwa me ngom mono bipaki? Dok binyutu beri ki adani?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Ai Rwot, winy kokona, wek kica omaki ikoma!</para>
  <para style="q1" vid="PSA 30:10">Ai Rwot, bed lakonya!”<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Ityeko loko kumu ma atye kwede odoko myel me yomcwiny madwong;</para>
  <para style="q1" vid="PSA 30:11">igonyo bene bongo colana woko ka dong iruka ki yomcwiny.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Pimeno pe abibedo laling; abiwero wer me paki.</para>
  <para style="q1" vid="PSA 30:12">Ai Rwot Lubangana, abimiyi pwoc nakanaka.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s1">Lega me gen ikom Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Ai Rwot, aringo alaro boti wek igwoka;</para>
  <para style="q1" vid="PSA 31:1">pe iwek kiket lewic iwiya.</para>
  <para style="q1" vid="PSA 31:1">In Lubanga ma kiti atir, alegi lara do!<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Cik iti, iwiny legana, lara oyotoyot!</para>
  <para style="q1" vid="PSA 31:2">Bed got ma aringo alaro iye,</para>
  <para style="q1" vid="PSA 31:2">dok ibed cel gogona matek ma laro an.<verse eid="PSA 31:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Eyo, in aye i gota ki cel gogona;</para>
  <para style="q1" vid="PSA 31:3">tela dok igwoka pi nyingi.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Gonya woko ki i obwo ma kiciko kikano pira,</para>
  <para style="q1" vid="PSA 31:4">in aye kalarena.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:5: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:46">Luk 23:46</ref>
      </char>
    </note>Amiyo kwona dong i cingi;</para>
  <para style="q1" vid="PSA 31:5">Ai Rwot, in dong ityeko koka, in Lubanga me ada.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />In idag jo ma giworo lubanga ma pe ada;</para>
  <para style="q1" vid="PSA 31:6">ento an ageno mera Rwot.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Abibedo ki yomcwiny madwong pi mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 31:7">pien dong ityeko neno can ma omaka,</para>
  <para style="q1" vid="PSA 31:7">dok ityeko winyo koko me can ma odiya.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Pe imiyo lukwora gumaka;</para>
  <para style="q1" vid="PSA 31:8">imiyo alanyo lukwora woko.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Ai Rwot, kica omaki ikoma do, pien atye i can;</para>
  <para style="q1" vid="PSA 31:9">wanga dong olwal woko pi koko madwong,</para>
  <para style="q1" vid="PSA 31:9">koma ducu dong oloc woko marac.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />I kwona ducu abedo ki cwercwiny,</para>
  <para style="q1" vid="PSA 31:10">dok mwaka me bedona opong ki cur keken.</para>
  <para style="q1" vid="PSA 31:10">Tekona otum woko pi ayelayela ma atye kwede,</para>
  <para style="q1" vid="PSA 31:10">cogona ducu gubale woko.<verse eid="PSA 31:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Lumonena ducu gingala angala,</para>
  <para style="q1" vid="PSA 31:11">ki luwota bene gicaya acaya;</para>
  <para style="q1" vid="PSA 31:11">jo ma gingeya dong gilwora alwora,</para>
  <para style="q1" vid="PSA 31:11">ka ginena i gudu ci giringo woko ki bota.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Luwota dong wigi owil woko ikoma calo dong onongo ato woko atoya;</para>
  <para style="q1" vid="PSA 31:12">aloke adoko calo otako agulu ma oto.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Eyo, awinyo jo mapol gikwoto nyinga;</para>
  <para style="q1" vid="PSA 31:13">omiyo lworo bene ogura woko dyere!</para>
  <para style="q1" vid="PSA 31:13">Guribe gitye kayubu lok ikoma,</para>
  <para style="q1" vid="PSA 31:13">ma gipiro lok me neka woko.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Ento gena pud tye ikomi, Ai Rwot,</para>
  <para style="q1" vid="PSA 31:14">kun awaco ni, “In Lubangana.”<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Kare me kwona tye i cingi;</para>
  <para style="q1" vid="PSA 31:15">lara ki bot lukwora, ki i cing jo</para>
  <para style="q1" vid="PSA 31:15">ma giketo ayela ikoma.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />An latici, nena ki wang me kica;</para>
  <para style="q1" vid="PSA 31:16">lara pi mar meri ma pe loke!<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Akok boti, Ai Rwot, pe iwek lewic omaka;</para>
  <para style="q1" vid="PSA 31:17">wek lewic omak jo maracu,</para>
  <para style="q1" vid="PSA 31:17">wek guto gucit i lobo pa jo ma oto ci gubed mot laling.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Juk gin jo ma loko lok goba ni woko,</para>
  <para style="q1" vid="PSA 31:18">ma giloko lok maracu ikom jo ma kitgi atir</para>
  <para style="q1" vid="PSA 31:18">ki wake kacel ki cac.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Beri dit rom kwene,</para>
  <para style="q1" vid="PSA 31:19">ma igwoko pi jo ma gilwori!</para>
  <para style="q1" vid="PSA 31:19">Gin ma itiyo bedo me aura rom kwene iwang ngat acel acel,</para>
  <para style="q1" vid="PSA 31:19">ma itiyo pi jo ma giringo gilaro boti!<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Igwokogi woko maber i kabedo ma itye iye,</para>
  <para style="q1" vid="PSA 31:20">igwokogi bene ki i piro lok ma dano gipiro;</para>
  <para style="q1" vid="PSA 31:20">ikanogi woko ma gibedo mot ki kuc</para>
  <para style="q1" vid="PSA 31:20">i odi ki i yet pa lukworgi.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Kipwo Rwot,</para>
  <para style="q1" vid="PSA 31:21">pien dong otyeko nyutu mare bota i yo me aura,</para>
  <para style="q1" vid="PSA 31:21">kama onongo kigura woko dyere macalo gang ma kirumu.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Ikare ma adongo oduru awaco ni,</para>
  <para style="q1" vid="PSA 31:22">“Dong giryema woko ki inyimi kamabor.”</para>
  <para style="q1" vid="PSA 31:22">Ento in iwinyo lega me bako doga,</para>
  <para style="q1" vid="PSA 31:22">ikare ma akok boti pi kony.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Wumar Rwot, wun lwake ducu ma gene!</para>
  <para style="q1" vid="PSA 31:23">Rwot gwoko jo ma lugen,</para>
  <para style="q1" vid="PSA 31:23">ento pwodo jo ma gilyere ma giwake awaka.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Wubed tek, dok wubed ma cwinywu nwang,</para>
  <para style="q1" vid="PSA 31:24">wun jo ma wuketo genwu ikom Rwot!<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s1">Tucu bal ki timo kica</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:7-8">Rom 4:7-8</ref>
      </char>
    </note>Dano ma dong kiweko bale tye kigum,</para>
  <para style="q1" vid="PSA 32:1">ma bale dong kikwanyo woko.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Dano ma Rwot pe dong kwano bal mo i wiye tye ki yomcwiny,</para>
  <para style="q1" vid="PSA 32:2">ma pe tye ki bwola mo i cwinye.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Ikare ma akwero tucu bala, anongo ni koma obale woko</para>
  <para style="q1" vid="PSA 32:3">pi cur ma abedo kacur dyeceng jwi.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Pien imiya pwod malit i dyeceng ki i dyewor;</para>
  <para style="q1" vid="PSA 32:4">tekona ducu otwo woko macalo toyo two woko ki lyeto me oro.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Cut atucu bala boti,</para>
  <para style="q1" vid="PSA 32:5">pe amungu gin marac ducu ma onongo atimo;</para>
  <para style="q1" vid="PSA 32:5">awaco ni, “Abitucu bala ducu bot Rwot”;</para>
  <para style="q1" vid="PSA 32:5">ci in bene iweko bala ducu.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Pimeno wek jo ducu ma gigeni gukel legagi boti;</para>
  <para style="q1" vid="PSA 32:6">ikare ma nongo can mito mwonyogi woko calo lalele me pii madwong,</para>
  <para style="q1" vid="PSA 32:6">pii meno pe bio ikomgi.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />In aye kakanena,</para>
  <para style="q1" vid="PSA 32:7">igwoka ki i ayelayela;</para>
  <para style="q1" vid="PSA 32:7">abiwer ki dwon malongo,</para>
  <para style="q1" vid="PSA 32:7">pien igura woko dyere ki lari.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Rwot owaco ni, “Abipwonyi dok abicimi yo ma myero ilubi;</para>
  <para style="q1" vid="PSA 32:8">abimiyi ryeko dok abineni ki wang me mar.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Pe ibed calo aguragura nyo kana ma pe niang,</para>
  <para style="q1" vid="PSA 32:9">ma myero kitwe doge ki wiye,</para>
  <para style="q1" vid="PSA 32:9">wek olub gin ma kiwaco.”<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Jo maracu gibilimo arem madwong;</para>
  <para style="q1" vid="PSA 32:10">ento jo ma gigeno Rwot en gwokogi ki mar mere ma pe loke.<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Wubed ki yomcwiny madwong i Rwot,</para>
  <para style="q1" vid="PSA 32:11">wun jo ma kitwu atir, wudange pi yomcwiny,</para>
  <para style="q1" vid="PSA 32:11">wun jo ducu ma cwinywu atir!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s1">Wer me pako Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Wuwer matek ki yomcwiny i Rwot, wun jo ma kitwu atir!</para>
  <para style="q1" vid="PSA 33:1">Myero wupake, wun jo ducu ma cwinywu leng.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Wumii pwoc bot Rwot kun wupake ki opuk,</para>
  <para style="q1" vid="PSA 33:2">wupake ki wer nanga ma tole tye apar.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Wuwer wer manyen bote,</para>
  <para style="q1" vid="PSA 33:3">wugo nanga ki kit kwiriwu ducu kun wuwero ki dwonwu malongo.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Lok pa Rwot tye ada,</para>
  <para style="q1" vid="PSA 33:4">dok tice ma en tiyo ducu gene.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />Rwot maro kit ma atir ki ngolo kop atir;</para>
  <para style="q1" vid="PSA 33:5">lobo opong ki mar mere ma pe loke.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Rwot ocweyo polo ki loke,</para>
  <para style="q1" vid="PSA 33:6">ka ocweyo ceng, dwe ki lakalatwe ki lok ma en oloko ki doge.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />En oguru pii me nam woko ducu kacel,</para>
  <para style="q1" vid="PSA 33:7">i kabedo acel calo opiko i opoko;</para>
  <para style="q1" vid="PSA 33:7">ka okano nam madongo bene i kicika odine me kano jami.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Wek lobo ducu omii woro bot Rwot,</para>
  <para style="q1" vid="PSA 33:8">wek jo ducu ma gibedo i lobo gulwore.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Ikare ma en oloko, ci lobo obedo tye;</para>
  <para style="q1" vid="PSA 33:9">gin ma en ociko otiine, dok ocung matek liking.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />Rwot gengo yub pa lurok ma pe giwore wek pe ocobe,</para>
  <para style="q1" vid="PSA 33:10">dok gengo yub me tim maracu pa lwak me rok mapol wek pe guket i tic.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Yub pa Rwot bedo matwal;</para>
  <para style="q1" vid="PSA 33:11">yub ducu ma en tamo ki i cwinye bedo matwal ikare pa yalwak ducu.<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Lwak me rok ma Rwot aye Lubangagi tye ki gum,</para>
  <para style="q1" vid="PSA 33:12">gin aye jo ma en oyero me bedo jone kikome!<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />Rwot neno piny ki i polo;</para>
  <para style="q1" vid="PSA 33:13">en neno dano ducu.<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />En lworo piny ki wange ki iwi komker kama obedo iye,</para>
  <para style="q1" vid="PSA 33:14">dok neno jo ducu ma gibedo i lobo.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />En aye ma oketo cwinygi ducu,</para>
  <para style="q1" vid="PSA 33:15">dok en neno gin ducu ma gitiyo.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Kit rwot mo keken pe twero loyo lweny pi dul mony matek ma en tye kwede;</para>
  <para style="q1" vid="PSA 33:16">lalweny bene pe twero loyo lweny pi tekom madit ma en tye kwede.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Pe kitwero geno aguragura me lweny ni romo miyo loc;</para>
  <para style="q1" vid="PSA 33:17">tekeni ducu pe twero laro dano.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Nen, Rwot neno jo ma giwore,</para>
  <para style="q1" vid="PSA 33:18">gin jo ma gigeno mar mere ma pe loke,<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />wek olargi ki i to,</para>
  <para style="q1" vid="PSA 33:19">dok ogwokgi gubed makwo ikare me kec.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Genwa ducu tye ikom Rwot</para>
  <para style="q1" vid="PSA 33:20">en lakonywa, dok en kwot ma gwokowa.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Eyo, wabedo ki yomcwiny pi en,</para>
  <para style="q1" vid="PSA 33:21">pien wageno nyinge maleng.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Ai Rwot, wek mar meri ma pe loke obed ikomwa,</para>
  <para style="q1" vid="PSA 33:22">kit macalo wageno in.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s1">Wer pak pi ber pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Abipwoyo Rwot kare ducu;</para>
  <para style="q1" vid="PSA 34:1">dok abibedo ka pake nakanaka.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Abipako en pi gin ma dong otyeko tiyo;</para>
  <para style="q1" vid="PSA 34:2">wek jo ma gitye ki can guwiny dok gubed ki yomcwiny.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Wuribe kweda me pako dit pa Rwot,</para>
  <para style="q1" vid="PSA 34:3">wek wapaku nyinge kacel!<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Alego kony bot Rwot, ci en ogamo legana;</para>
  <para style="q1" vid="PSA 34:4">dok olara ki ikit lworo ducu ma onongo atye kwede.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Wuket genwu bote, wek wangwu oryeny ma nongo cwinywu yom,</para>
  <para style="q1" vid="PSA 34:5">wek lewic pe omakwu.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Jo ma piny obwoyogi gikok bot Rwot, ci en gamo doggi,</para>
  <para style="q1" vid="PSA 34:6">dok larogi ki i can ducu.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Lamalaika pa Rwot cung kun gwoko jo ma gilworo Rwot,</para>
  <para style="q1" vid="PSA 34:7">dok larogi bene woko ki i can.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:8: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 2:3">1 Pet 2:3</ref>
      </char>
    </note>Kong item in kikomi ci ibinongo ni Rwot kara ber.</para>
  <para style="q1" vid="PSA 34:8">Dano maringo laro bote bedo ki yomcwiny!<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Wulwor Rwot, wun jo maleng mere ducu,</para>
  <para style="q1" vid="PSA 34:9">gin mo pe ma rem bot jo ma gilwore.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Lutino labwor kare mogo camgi bedo peke, dok kec nekogi;</para>
  <para style="q1" vid="PSA 34:10">ento jo ma giyenyo Rwot gin mabeco mo pe birem botgi.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Wubin wunu lutinona, wuwiny loka, ci abipwonyowu kit me woro Rwot.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:12: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:10-12">1 Pet 3:10-12</ref>
      </char>
    </note>Anga ma maro kwo,</para>
  <para style="q1" vid="PSA 34:12">ma mito ni ebed kwo pi kare malac wek enong yomcwiny ikom jami mabeco?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Ngat meno myero ogwok lebe ma pe loko gin marac,</para>
  <para style="q1" vid="PSA 34:13">dok doge bene pe loko lok me bwola.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />A woko ki i gin marac, ci itii gin maber;</para>
  <para style="q1" vid="PSA 34:14">yeny kuc, dok itii matek macalo itwero wek inong.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Rwot neno jo ma kitgi atir,</para>
  <para style="q1" vid="PSA 34:15">dok ciko ite winyo koko ma gikok bote pi kony.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Rwot dag neno jo ma lutim maracu;</para>
  <para style="q1" vid="PSA 34:16">en miyo wi dano wil woko ikomgi matwal ki i lobo kany.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Ka jo ma kitgi atir okok bote pi kony, en winyo kokogi,</para>
  <para style="q1" vid="PSA 34:17">dok larogi bene woko ki i can gi ducu.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />Rwot tye cok ki jo ma cwinygi otur,</para>
  <para style="q1" vid="PSA 34:18">dok laro jo ma gen gi dong peke.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Dano ma kite atir limo can madwong;</para>
  <para style="q1" vid="PSA 34:19">ento Rwot lare ki i cane ducu.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:20: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:36">Jon 19:36</ref>
      </char>
    </note>En gwoko cogo ma ikome maber wek kadi acel mo pe otur woko.<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Gin marac bineko jo maracu;</para>
  <para style="q1" vid="PSA 34:21">dok jo ma gidag jo ma kitgi atir kibipwodogi.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />Rwot koko kwo pa lutice;</para>
  <para style="q1" vid="PSA 34:22">pe tye ngat mo ikom jo ma giringo gilaro bote ma kibingolo kop loyogi.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s1">Lega pi lar ki i cing lumerok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />Ai Rwot, juk jo ma giyela;</para>
  <para style="q1" vid="PSA 35:1">dok ilweny ki jo ma gilwenyo ikoma.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Mak kwot ki gin me gengo kori, ci ibin ikonya.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Bed ma iyube ki tong ki latong me lweny</para>
  <para style="q1" vid="PSA 35:3">me rwate ki jo ma giryemo kora.</para>
  <para style="q1" vid="PSA 35:3">Wac ki tipuna ni, “An lalari.”<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Wek lewic omak jo ma gimito neka woko</para>
  <para style="q1" vid="PSA 35:4">dok alee myero otwodgi.</para>
  <para style="q1" vid="PSA 35:4">Wek gin jo ma gipiro lok marac ikoma</para>
  <para style="q1" vid="PSA 35:4">guloke gudok cen ki lewic madwong!<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Wek gubed calo cung kal mayamo tingo woko,</para>
  <para style="q1" vid="PSA 35:5">ma kun lamalaika pa Rwot tye ka ryemogi.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />Mii yoogi ocid woko dok obed pwot ma cerogi acera,</para>
  <para style="q1" vid="PSA 35:6">dok iwek lamalaika pa Rwot oryem korgi.<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Guciko obwo gukano woko pira labongo bala mo;</para>
  <para style="q1" vid="PSA 35:7">dok bene gukwinyo bur wek apot iye ato woko.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Wek can opot ikomgi atura otyekgi woko;</para>
  <para style="q1" vid="PSA 35:8">ki obwo ma gukanoni aye bene omakgi,</para>
  <para style="q1" vid="PSA 35:8">mi gupot i bur gutum woko!<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Abibedo ki yomcwiny i Rwot,</para>
  <para style="q1" vid="PSA 35:9">abibedo ki yomcwiny pien Rwot olara.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Abiwaco lok man ki cwinya ducu ni,</para>
  <para style="q1" vid="PSA 35:10">“Ai Rwot, anga mono macalo in,</para>
  <para style="q1" vid="PSA 35:10">in ma ilaro dano magoro ki i cing jo ma gitek giloye woko?</para>
  <para style="q1" vid="PSA 35:10">Ilaro ngat magoro ki ma piny obwoyo ki i cing jo ma yako jamine woko.”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Caden ma cwinygi rac gikati kamaleng me tito lok ikoma,</para>
  <para style="q1" vid="PSA 35:11">kun gipenya pi gin ma pe angeyo.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Gicula ki gin marac pi gin maber;</para>
  <para style="q1" vid="PSA 35:12">piny dong orem kweda woko.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Ento an aruku bongo cola ikare ma onongo komgi lit,</para>
  <para style="q1" vid="PSA 35:13">dok amine kena i can me rii kec.</para>
  <para style="q1" vid="PSA 35:13">Alego ma agoyo kora kun akulu wiya piny pirgi,<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />macalo onongo akumu pi larema nyo pi omera.</para>
  <para style="q1" vid="PSA 35:14">Abedo kawot atata macalo dano ma koko mine,</para>
  <para style="q1" vid="PSA 35:14">kun akule piny kakumu.<verse eid="PSA 35:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Ento ikare ma ayoke gin ducu gubedo ki yomcwiny,</para>
  <para style="q1" vid="PSA 35:15">gucoke kacel ikoma;</para>
  <para style="q1" vid="PSA 35:15">jo mayam pe angeyogi</para>
  <para style="q1" vid="PSA 35:15">gucoke ikoma kayeta ma pe gitwero ling.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Gumede kangala ma nongo doggi bit ikoma,</para>
  <para style="q1" vid="PSA 35:16">ma gupong ki adagadaga madit ikoma.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />Ai Rwot, ibibedo kanena anena pi kare marom mene?</para>
  <para style="q1" vid="PSA 35:17">Lara woko ki i gerogi,</para>
  <para style="q1" vid="PSA 35:17">lar kwona ki i dog labwor magi.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />Ci abimiyi pwoc madit mada i coke madit;</para>
  <para style="q1" vid="PSA 35:18">dok abipaki kama lwak jo mapol gugure iye.<verse eid="PSA 35:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:4">Jab 69:4</ref>; <ref loc="JHN 15:25">Jon 15:25</ref></char>
    </note>Pe iwek lukwora ma gin lutim maracu gubed ki yomcwiny ikoma,</para>
  <para style="q1" vid="PSA 35:19">pe iwek jo ma gimiyo wangi lirwitrwit guloya,</para>
  <para style="q1" vid="PSA 35:19">gin jo ma daga labongo bal mo.<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Pe giloko lok makelo kuc,</para>
  <para style="q1" vid="PSA 35:20">ento gipiro meggi lok maracu ikom jo ma gibedo mot i lobo,</para>
  <para style="q1" vid="PSA 35:20">gupong ki lok me bwola keken.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Gingamo doggi malac me lok ikoma,</para>
  <para style="q1" vid="PSA 35:21">kun giwaco ni, “Aa! Aa! Watyeko neno gin ma itimo!”<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />Ai Rwot, dong ineno, pe myero iling alinga do!</para>
  <para style="q1" vid="PSA 35:22">Pe ibed bor kweda, Ai Rwot!<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Coo woko, cuke me ngolo kopa;</para>
  <para style="q1" vid="PSA 35:23">pid pira, in Rwoda ki Lubangana!<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />In ipore, Ai Rwot, pimeno kwany kop woko ki iwiya;</para>
  <para style="q1" vid="PSA 35:24">pe iwek lukwora gunong yomcwiny ikoma do, Lubangana.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Pe iwek gulok keken gi kun giwaco ni,</para>
  <para style="q1" vid="PSA 35:25">“Aa! Dong wanongo gin ma cwinywa mito.”</para>
  <para style="q1" vid="PSA 35:25">Dok pe iwek guwac ni,</para>
  <para style="q1" vid="PSA 35:25">“Dong watyeko mwonye woko.”<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Wek lewic omakgi dok gubed ki anyobanyoba lawangacel,</para>
  <para style="q1" vid="PSA 35:26">gin jo ma gibedo ki yomcwiny pi can ma omaka!</para>
  <para style="q1" vid="PSA 35:26">Wek gupong ki lewic ma alee bene otwodgi,</para>
  <para style="q1" vid="PSA 35:26">gin jo ma giwake ikomani!<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Wek jo ma cwinygi mito ni alo kop gudange pi yomcwiny kun giwaco nakanaka ni,</para>
  <para style="q1" vid="PSA 35:27">“Rwot dit, cwinye yom kaneno ni latice bedo ki kuc!”<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Ci abitito pi poreni,</para>
  <para style="q1" vid="PSA 35:28">dok abipako nyingi dyeceng jwi.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s1">Tim maracu pa dano</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:18">Rom 3:18</ref>
      </char>
    </note>Bal me turu cik loko kamatut i cwiny dano marac;</para>
  <para style="q1" vid="PSA 36:1">dano ma kitmeno pe tye ki lworo mo keken ikom Lubanga.<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Bal miyo en bwole kekene dok umu wange woko,</para>
  <para style="q1" vid="PSA 36:2">kun tamo ni pe kibinongo gin marac ma en timo,</para>
  <para style="q1" vid="PSA 36:2">mamiyo dano kwere woko.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Lok ma en loko obedo lok me tim aranyi ki me bwola keken;</para>
  <para style="q1" vid="PSA 36:3">pe dong tye ki ryeko mo ma weko en tiyo gin maber.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />En piro lok me timo gin marac ma kun nongo obutu iwi kitandane;</para>
  <para style="q1" vid="PSA 36:4">en loko kite woko i yo ma pe ber;</para>
  <para style="q1" vid="PSA 36:4">dok pe kwero kit gin mo keken marac.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Ai Rwot, mar meri ma pe loke o wa i polo,</para>
  <para style="q1" vid="PSA 36:5">dok adani bene o i pol.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Poreni ocung matek liking macalo godi madongo,</para>
  <para style="q1" vid="PSA 36:6">kit ngolo kopi tye calo kama tut ma i nam madit.</para>
  <para style="q1" vid="PSA 36:6">Ai Rwot, in aye ma igwoko dano kacel ki lee ducu.<verse eid="PSA 36:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Ai Rwot, ber me mar meri ma pe loke dit ma pe wace!</para>
  <para style="q1" vid="PSA 36:7">Jo ducu giringo gilaro kakane ite bwomi.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Giyeng ki lwak cam madwong matye i odi,</para>
  <para style="q1" vid="PSA 36:8">dok imiyo gimato pii ma oa i kulu me yomcwiny matye boti.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />In aye iwang it me kwo ducu,</para>
  <para style="q1" vid="PSA 36:9">i deroni wan bene waneno iye dero.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Med mar meri ma pe loke bot jo ma gingeyi,</para>
  <para style="q1" vid="PSA 36:10">dok imed lar meri bot jo ma cwinygi atir.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Pe iwek dano ma lawake oket dic ikoma,</para>
  <para style="q1" vid="PSA 36:11">pe iwek dano marac oryema woko cen.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Nen lutim maracu kiretogi aryeba ic,</para>
  <para style="q1" vid="PSA 36:12">kidiyogi woko piny ma pe dok gitwero a malo.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s1">Agiki pa jo maracu ki pa jo ma kitgi atir</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Cwinyi pe myero opot pi jo maracu;</para>
  <para style="q1" vid="PSA 37:1">pe ibed ki mone ikom jo ma gitiyo gin marac;<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />pien gibitwo woko calo lum,</para>
  <para style="q1" vid="PSA 37:2">dok gibiner woko calo pot dek madyak.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Gen Rwot, dok i tii gin maber; bed i lobo ki kuc.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Bed ki yomcwiny i Rwot,</para>
  <para style="q1" vid="PSA 37:4">ci en bimiyi gin ducu ma cwinyi mito.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Mii kwoni bot Rwot; gen en, ci en bikonyi.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />En bimiyo beri ryeny calo ceng,</para>
  <para style="q1" vid="PSA 37:6">dong kiti ma atir bibedo calo ceng maryeny i cwiny dyeceng.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Bed mot inyim Rwot, dok idi cwinyi ikure.</para>
  <para style="q1" vid="PSA 37:7">Pe ipar pi ngat matye kalony oyotoyot,</para>
  <para style="q1" vid="PSA 37:7">kadi pi ngat macobo yube me timo gin maracu.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Pe iwek kiniga omaki, dok iwek akemo obedi;</para>
  <para style="q1" vid="PSA 37:8">pe ibed ki par iye, pien tim ma kitmeno kelo gin marac keken.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Lutim maracu kibityekogi woko;</para>
  <para style="q1" vid="PSA 37:9">ento jo ma gigeno Rwot gibicamo lobo.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Odong kare manok, ci dano marac dong bibedo peke matwal;</para>
  <para style="q1" vid="PSA 37:10">kadi ingii i kabedone maber ci ibinongo ni en dong peke kunu.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:11: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:5">Mat 5:5</ref>
      </char>
    </note>Ento jo mamwol aye gibicamo lobo;</para>
  <para style="q1" vid="PSA 37:11">gibibedo ki yomcwiny pi lonyo madwong ma gibilimo.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Dano marac piro lok ikom dano ma kite atir,</para>
  <para style="q1" vid="PSA 37:12">dok kayo lake ikome matek.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Ento Rwot nyero dano marac anyera,</para>
  <para style="q1" vid="PSA 37:13">pien neno ni, nino me ngolo kop ikom dano marac dong tye kabino.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Jo maracu giwoto pala lucwan gi dok gitelo atumgi,</para>
  <para style="q1" vid="PSA 37:14">me neko lucan kacel ki jo ma piny obwoyogi,</para>
  <para style="q1" vid="PSA 37:14">ki pi neko jo ma cwinygi atir.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Pala lucwan gi bicobo cwinygi keken gi,</para>
  <para style="q1" vid="PSA 37:15">ki atumgi bene kibituru woko.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Gin mo manok ma dano ma kite atir tye kwede ber</para>
  <para style="q1" vid="PSA 37:16">kato lonyo madwong ma jo maracu mapol gitye kwede.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Twero ma jo maracu gitye kwede kibituru woko;</para>
  <para style="q1" vid="PSA 37:17">ento Rwot bigwoko jo ma kitgi atir.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Rwot gwoko jo ma lubu cike;</para>
  <para style="q1" vid="PSA 37:18">dok gipinygi birii nakanaka.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Lewic pe bimakogi ikare me can, dok gibibedo ki cam madwong ikare me kec.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Ento jo maracu, ma gin lukwor pa Rwot,</para>
  <para style="q1" vid="PSA 37:20">gibito gitum woko macalo lum i olet dyang,</para>
  <para style="q1" vid="PSA 37:20">gibiduny woko calo yito ma duny ci rweny woko.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Dano marac mako banya, ento pe twero culu wange,</para>
  <para style="q1" vid="PSA 37:21">ento dano ma kite atir lakica, miyo mere jami amiya nono.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Jo ma Rwot omiyo gum botgi aye gibicamo lobo,</para>
  <para style="q1" vid="PSA 37:22">ento jo ma dong en ocenogi kibityekogi woko.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Rwot telo dano ikit kwo ma myero en obed kwede,</para>
  <para style="q1" vid="PSA 37:23">dok bene gwoko dano makwone yomo cwinye<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Kadi oyoke, ci pe bipoto piny,</para>
  <para style="q1" vid="PSA 37:24">pien Rwot tye jole woko ki cinge.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Yam abedo latin, kombedi dong adoko dit;</para>
  <para style="q1" vid="PSA 37:25">ento pud peya aneno kibwoto dano ma kite atir,</para>
  <para style="q1" vid="PSA 37:25">kadi ki lutinone bene pe aneno ka gilego ginacama alega.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />En nino ducu ber, miyo jami amiya,</para>
  <para style="q1" vid="PSA 37:26">dok dano gimako banya bote,</para>
  <para style="q1" vid="PSA 37:26">ki lutinone bene gidoko jo makelo gum bot dano.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />A woko ki i gin marac, ci i tii gin maber,</para>
  <para style="q1" vid="PSA 37:27">ci in ki likwayi wubicamo lobo.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Pien Rwot maro ngolo kop atir;</para>
  <para style="q1" vid="PSA 37:28">dok pe bibwoto jo ma gigeno en.</para>
  <para style="q1" vid="PSA 37:28">En bigwoko jo ma kitgi atir matwal,</para>
  <para style="q1" vid="PSA 37:28">ento kibityeko lutino pa jo maracu woko ducu.<verse eid="PSA 37:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Jo ma kitgi atir gibicamo lobo,</para>
  <para style="q1" vid="PSA 37:29">dok gibibedo iye matwal!<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Dano ma kite atir loko lok me ryeko,</para>
  <para style="q1" vid="PSA 37:30">dok loko gin matye atir.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />En gwoko cik pa Lubangane i cwinye;</para>
  <para style="q1" vid="PSA 37:31">pe ngak woko ki iye.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Dano marac neno ngat ma kite atir,</para>
  <para style="q1" vid="PSA 37:32">ci yenyo yo me neke woko.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Ento Rwot pe bibwoto en ata i cing lakwore,</para>
  <para style="q1" vid="PSA 37:33">nyo ni kingol kop oloye ka kikelo en kapido.<verse eid="PSA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Ket geni ikom Rwot, dok ilub cike,</para>
  <para style="q1" vid="PSA 37:34">ci en bimiyi twero me camo lobo;</para>
  <para style="q1" vid="PSA 37:34">dok ibineno bene ka kityeko jo maracu woko.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Aneno dano marac ka keto gero mukato kare ikom jo mukene,</para>
  <para style="q1" vid="PSA 37:35">kun dongo mede ameda calo yat cedar me Lebanon.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Lacen ka akato ki kenyo, anongo ni en dong pe matwal;</para>
  <para style="q1" vid="PSA 37:36">kadi bed ayenye, ento pe dong en twero nonge.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Nen dano ma pe ki bal mo, dok inen dano ma cwinye atir;</para>
  <para style="q1" vid="PSA 37:37">dano makelo kuc likwaye bedo tye.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Ento jo ma lubalo kibityekogi woko liweng;</para>
  <para style="q1" vid="PSA 37:38">ki likwayo pa jo maracu bene kibijwerogi woko.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Rwot aye ma laro jo ma kitgi atir;</para>
  <para style="q1" vid="PSA 37:39">en bene ma gwokogi ikare me can.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />Rwot konyogi, dok larogi ki bot jo maracu,</para>
  <para style="q1" vid="PSA 37:40">pien giringo gilaro bote.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s1">Lega pa dano ma labalo matye ki arem</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />Ai Rwot, pe ijuka ki kiniga, dok pe ipwoda ki akemo!<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Ateroni dong gucela, gumwony woko i iya,</para>
  <para style="q1" vid="PSA 38:2">kun cingi bene odonga omiyo apoto piny.<verse eid="PSA 38:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Atye ki arem matek,</para>
  <para style="q1" vid="PSA 38:3">pi kinigani;</para>
  <para style="q1" vid="PSA 38:3">pe atye ki yotkom i cogona ducu</para>
  <para style="q1" vid="PSA 38:3">pi bala.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Bala dong oketo koma woko;</para>
  <para style="q1" vid="PSA 38:4">gipek calo yec ma pe aromo tingone.<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Wang bura kwok mangwe</para>
  <para style="q1" vid="PSA 38:5">pi mingona.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Arem koma dwong ma okula woko piny,</para>
  <para style="q1" vid="PSA 38:6">oweko abutu i ngom aryeba cwiny dyeceng jwi kun akumu akuma.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Pyera bene wange awanga calo mac,</para>
  <para style="q1" vid="PSA 38:7">pe atye ki kit yotkom mo wa ki acel.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Koma oloc dok onyonge woko adada;</para>
  <para style="q1" vid="PSA 38:8">acur pien atye ki remcwiny madwong tutwal.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Ai Rwot, in ingeyo gin ma amito ducu,</para>
  <para style="q1" vid="PSA 38:9">gin ma abedo kacur pireni pe obedo me mung ki boti.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Adununa tye ka gone matek lituktuk, miyo tekone bene tum woko;</para>
  <para style="q1" vid="PSA 38:10">wanga bene ocor woko, pe neno piny dong maber.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Lurema ki luwota ma wabedo kwedgi gicung ki cen kamabor pi bur ma oonyo ikoma,</para>
  <para style="q1" vid="PSA 38:11">ki lutuwa bene gicung ki cen kamabor adada.<verse eid="PSA 38:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Jo ma giyenyo yo me neka guciko owicgi pira,</para>
  <para style="q1" vid="PSA 38:12">jo ma gimito keto ret ikoma giloko lok me tyeko kwona woko,</para>
  <para style="q1" vid="PSA 38:12">gibedo kapiro lok marac ikoma dyeceng jwi.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Ento an abedo macalo ladingit, pe awinyo lokgi;</para>
  <para style="q1" vid="PSA 38:13">dok abedo calo ladogeoto ma pe ngamo doge kalok.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Eyo, adoko calo dano ma ite oding, ma pe winyo lok,</para>
  <para style="q1" vid="PSA 38:14">macalo latelebe oto ma pe gamo lok mo.<verse eid="PSA 38:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />Ento gena ducu tye ikomi, Ai Rwot;</para>
  <para style="q1" vid="PSA 38:15">Ai Rwot Lubangana, in aye ma ibigamo doga.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Alegi alega keken ni, “Pe iwek lumonena gunyate ikoma,</para>
  <para style="q1" vid="PSA 38:16">pe iwek jo ma gidaga gunong yomcwiny ikoma ka apoto i peko,”<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Dong acok poto,</para>
  <para style="q1" vid="PSA 38:17">atye kawinyo arem ikoma kare ducu.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Atucu bala,</para>
  <para style="q1" vid="PSA 38:18">kun cwinya cwer mada pire.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Lukwora ma gidaga nonono labongo gin mo ma abalo botgi gitek,</para>
  <para style="q1" vid="PSA 38:19">jo ma gidaga labongo telok mo gipol.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Jo ma giculu gin marac pi gin maber gudoko lukwora,</para>
  <para style="q1" vid="PSA 38:20">pien amito ni atii gin maber.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />Ai Rwot, pe ibwota;</para>
  <para style="q1" vid="PSA 38:21">Ai Lubangana, pe ibed bor kweda!<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Bin oyot ikonya,</para>
  <para style="q1" vid="PSA 38:22">Ai Rwot, lalara!<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s1">Tucu bal pa dano matye ki arem</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Awaco ni, “Abigwoke ikit gin ducu ma atiyo,</para>
  <para style="q1" vid="PSA 39:1">wek pe atim bal ki lok ma aloko;</para>
  <para style="q1" vid="PSA 39:1">abiling ma pe angamo doga kawaco lok mo,</para>
  <para style="q1" vid="PSA 39:1">kace atye kacel ki jo maracu.”<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Aling alinga ma pe awaco lok mo,</para>
  <para style="q1" vid="PSA 39:2">dok bene ajuke kekena kadi me waco gin mo maber;</para>
  <para style="q1" vid="PSA 39:2">ento cwercwinya dok omede ameda marac,<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />ci cwinya olyeti woko dok owang matek.</para>
  <para style="q1" vid="PSA 39:3">Ikare ma pud alwodo lok, ci mac olyel;</para>
  <para style="q1" vid="PSA 39:3">ci acako lok maber labongo lworo ni,<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />“Rwot, mi ange agikina, dok imiya ange wel ninona;</para>
  <para style="q1" vid="PSA 39:4">wek ange bene kit makwona rwenyo kwede woko oyot!<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Nen, ingolo ninona tye manok mo,</para>
  <para style="q1" vid="PSA 39:5">dok kare me kwona pe gin mo ki boti.</para>
  <para style="q1" vid="PSA 39:5">Adada dano acel acel cung mere macalo aluu nono!<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Adada dano rwenyo woko calo tipu yat!</para>
  <para style="q1" vid="PSA 39:6">Adada gicane nono pi gin ma pe konyo;</para>
  <para style="q1" vid="PSA 39:6">dano kano lonyo madwong, kun pe ngeyo anga ma bileyone.<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />Dong kombedi mono, Rwot, akuru gin ango?</para>
  <para style="q1" vid="PSA 39:7">Gena tye ikomi.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Lara ki i bala ducu.</para>
  <para style="q1" vid="PSA 39:8">Pe imii adok gin angala pa luming.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Aling woko litik, pe aromo ngamo doga kalok;</para>
  <para style="q1" vid="PSA 39:9">pien in aye ma imiya peko ma kit man.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Pe dok imede kapwoda ki odooni;</para>
  <para style="q1" vid="PSA 39:10">adong me cingi ma idonga kwede dong mito neka woko.<verse eid="PSA 39:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Ka ipwodo dano</para>
  <para style="q1" vid="PSA 39:11">kun ijuke pi bal,</para>
  <para style="q1" vid="PSA 39:11">ityeko bere woko macalo nyenye ma camo gin mo ma pire tek bot dano meno;</para>
  <para style="q1" vid="PSA 39:11">adada dano mere rom ki aluu mamwa.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />Ai Rwot, winy legana,</para>
  <para style="q1" vid="PSA 39:12">dok icik iti iwiny kokona;</para>
  <para style="q1" vid="PSA 39:12">pe iling woko alinga ka akok boti!</para>
  <para style="q1" vid="PSA 39:12">An a weloni pi kare manok mo,</para>
  <para style="q1" vid="PSA 39:12">dok an labedo macalo kwariwa ducu.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Kong dong iweka mono, wek abed ki yomcwiny mo,</para>
  <para style="q1" vid="PSA 39:13">ma pud peya aa aweko lobo man woko matwal.”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s1">Wer me pak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Akuru Rwot kun adiyo cwinya;</para>
  <para style="q1" vid="PSA 40:1">ci en ociko ite owinyo kokona.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />En owota woko ki i bur marac, ki i coto manwang,</para>
  <para style="q1" vid="PSA 40:2">ci oketa acung iwi got,</para>
  <para style="q1" vid="PSA 40:2">ci omiyo abedo kawot atir.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />En opwonya ki wer manyen,</para>
  <para style="q1" vid="PSA 40:3">ki wer me pako Lubangawa.</para>
  <para style="q1" vid="PSA 40:3">Jo mapol gibineno ci lworo bimakogi woko,</para>
  <para style="q1" vid="PSA 40:3">ci gibigeno Rwot.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Tye ki gum dano ma geno Rwot,</para>
  <para style="q1" vid="PSA 40:4">ma pe loke ribe ki jo ma luwake,</para>
  <para style="q1" vid="PSA 40:4">dok ma pe ribe ki jo ma ngak woko kun giworo lubanga ma pe ada!<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Ai Rwot Lubangana, itiyo tic madito me aura mapol,</para>
  <para style="q1" vid="PSA 40:5">dok iyubu lwak yub mapol pi konyowa;</para>
  <para style="q1" vid="PSA 40:5">pe tye ngat mo macalo in!</para>
  <para style="q1" vid="PSA 40:5">Ka onongo nene aromo tucu dok tito pirgi,</para>
  <para style="q1" vid="PSA 40:5">kono onongo gipol adada</para>
  <para style="q1" vid="PSA 40:5">ma pe kitwero kwano welgi.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:6: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:5-7">Ibru 10:5-7</ref>
      </char>
    </note>Pe imito gitum kadi gityer;</para>
  <para style="q1" vid="PSA 40:6">ento ityeko yabo ita wek abed ngat ma lawiny.</para>
  <para style="q1" vid="PSA 40:6">In pe ipenyo pi gitum awanga nyo pi gitum me bal.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Ka dong agamo ni, “Nen, an a en;</para>
  <para style="q1" vid="PSA 40:7">pi tiyo gin ducu ma kicoyo i buk adolani pira.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Cwinya bedo yom me tiyo gin ducu ma imito, Ai Lubanga;</para>
  <para style="q1" vid="PSA 40:8">amako ciki dok agwoko tye i cwinya.”<verse eid="PSA 40:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Dong atyeko tito lok maber me yomcwiny me lari</para>
  <para style="q1" vid="PSA 40:9">i dye lwak i coke madit;</para>
  <para style="q1" vid="PSA 40:9">nen, pe amiyo doga woko ma aling alinga,</para>
  <para style="q1" vid="PSA 40:9">kit macalo in bene ingeyoni, Ai Rwot.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Pe akano lok me lari pira kena,</para>
  <para style="q1" vid="PSA 40:10">ento aloko pi ada ki pi lari;</para>
  <para style="q1" vid="PSA 40:10">dok pe amungo mar meri ma pe loke kacel ki adani</para>
  <para style="q1" vid="PSA 40:10">bot lwak ma i kacoke madit.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Ai Rwot, pe itwona kicani,</para>
  <para style="q1" vid="PSA 40:11">wek mar meri ma pe loke ki adani,</para>
  <para style="q1" vid="PSA 40:11">gugwoka nakanaka.<verse eid="PSA 40:11" /></para>
  <para style="s1">Lega pi kony</para>
  <para style="r">(<ref loc="PSA 70:1-5">Jab 70:1-5</ref>)</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Gin marac ma welgi pe kwane</para>
  <para style="q1" vid="PSA 40:12">guruma woko dyere;</para>
  <para style="q1" vid="PSA 40:12">bala dong obwoyo koma woko, miyo pe dong aneno piny;</para>
  <para style="q1" vid="PSA 40:12">gipol gikato yer wiya woko;</para>
  <para style="q1" vid="PSA 40:12">tekcwiny dong orwenyo woko ki bota.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />Ai Rwot, mii cwinyi obed yom me lara!</para>
  <para style="q1" vid="PSA 40:13">Ai Rwot, bin oyotoyot ikonya!<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Wek lewic omak jo ma gimito neka,</para>
  <para style="q1" vid="PSA 40:14">dok gubed ki anyobanyoba bene; wek kidwokgi cen,</para>
  <para style="q1" vid="PSA 40:14">wek alee otwodgi,</para>
  <para style="q1" vid="PSA 40:14">gin jo ma mito tima maraci!<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Wek gubed ma piny orem kwedgi woko pi lewic ma dong omakogini,</para>
  <para style="q1" vid="PSA 40:15">gin jo ma ginyerani!<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Ento mii jo ducu ma giyenyo in</para>
  <para style="q1" vid="PSA 40:16">gubed ki yomcwiny madwong ikomi;</para>
  <para style="q1" vid="PSA 40:16">dok imii jo ma gimaro lari</para>
  <para style="q1" vid="PSA 40:16">gumede ki waco nakanaka ni, “Rwot dit!”<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />An gira lacan, dok piny obwoya woko;</para>
  <para style="q1" vid="PSA 40:17">ento Rwot tamo pira.</para>
  <para style="q1" vid="PSA 40:17">In aye lakony ki lalara;</para>
  <para style="q1" vid="PSA 40:17">Ai Lubangana, pe igale!<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s1">Lega pa latwo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Tye ki gum dano ma paro pi lucan;</para>
  <para style="q1" vid="PSA 41:1">Rwot bilare woko ikare me peko.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />Rwot bigwoko en dok weko en bedo kwo;</para>
  <para style="q1" vid="PSA 41:2">kibilwonge ni ngat ma kome gum i lobo;</para>
  <para style="q1" vid="PSA 41:2">Rwot pe bimiyo en bot lukwore wek gutime rac macalo gitwero.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Rwot gwoke ikare manongo en two,</para>
  <para style="q1" vid="PSA 41:3">dok cango twone woko liweng maber.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Ento an, awaco ni, “Ai Rwot, kica omaki ikoma;</para>
  <para style="q1" vid="PSA 41:4">canga do, kadi bed atimo bal ikomi!”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Lukwora giwaco lok marac ikoma ni,</para>
  <para style="q1" vid="PSA 41:5">“En bito awene, wek nyinge orweny woko?”<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Jo ma gibino kalima pe gitye ki ada, giloko lwak lok ma tere peke,</para>
  <para style="q1" vid="PSA 41:6">kun nongo cwinygi opong ki lok me tim aranyi;</para>
  <para style="q1" vid="PSA 41:6">ka dong gukato gucito woko, ci gitito loke woko kamaleng.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Jo ma daga ducu gikwilo lok ikoma;</para>
  <para style="q1" vid="PSA 41:7">dok giparo ni gin marac myero opot ikoma.<verse eid="PSA 41:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />Giwaco ni, “Two marac adada dong omake,</para>
  <para style="q1" vid="PSA 41:8">pe dong bitwero a ki i kabutu kadi ki acel.”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:9: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:23">Mat 26:23</ref>; <ref loc="MRK 14:18">Mar 14:18</ref>; <ref loc="LUK 22:21">Luk 22:21</ref>; <ref loc="JHN 13:18">Jon 13:18</ref></char>
    </note>Kadi larema maber atika mayam ageno,</para>
  <para style="q1" vid="PSA 41:9">ma ocamo kwona bene, en aye dok oloke katimo gin marac ikoma.<verse eid="PSA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Ento in, Ai Rwot, kica omaki ikoma,</para>
  <para style="q1" vid="PSA 41:10">canga ikom twonani wek aa malo, ci abiculu kwor ikomgi.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Kace lakwora pe loya dok pe bedo ki wake ikoma,</para>
  <para style="q1" vid="PSA 41:11">ci miyo angeyo ni in kara cwinyi yom ikoma.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Ento dong ityeko konya pi lengcwinya,</para>
  <para style="q1" vid="PSA 41:12">ka dong iketa me bedo inyimi matwal.<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:48">Jab 106:48</ref>
      </char>
    </note>Kipak Rwot Lubanga pa Icrael,</para>
  <para style="q1" vid="PSA 41:13">kipake nakanaka! Amen! Amen!<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">BUK ME ARYO</para>
  <para style="mr">
    <ref loc="PSA 42-72">Jab 42—72</ref></para>
  <para style="s1">Lega pa oringayela</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Kit macalo til yenyo kwede kulu ma piine tye kamol,</para>
  <para style="q1" vid="PSA 42:1">an bene atye kayenyo Rwot ki i cwinya kitmeno,</para>
  <para style="q1" vid="PSA 42:1">ayenyo in, Ai Lubanga.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Cwinya mito anen Lubanga, en Lubanga makwoni.</para>
  <para style="q1" vid="PSA 42:2">Abicito kaneno wang Lubanga awene wek awore?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Pig wanga dong odoko cama,</para>
  <para style="q1" vid="PSA 42:3">i dyeceng naka wa i dyewor benebene,</para>
  <para style="q1" vid="PSA 42:3">ma nongo dano gipenya teretere ni,</para>
  <para style="q1" vid="PSA 42:3">“Lubangani mono tye kwene?”<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Cwinya dem woko ka apo ikom lok magi,</para>
  <para style="q1" vid="PSA 42:4">kit macalo yam acito kacel ki lwak,</para>
  <para style="q1" vid="PSA 42:4">kun atelo wigi i rek ma gurye aryeya me cito i Ot pa Lubanga,</para>
  <para style="q1" vid="PSA 42:4">kun lwak gidange ki yomcwiny ma giwero wer me pwoc,</para>
  <para style="q1" vid="PSA 42:4">ikare me kwero nino madito.<verse eid="PSA 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Pingo cwinya obale woko, dok pingo abedo ki cwercwiny?</para>
  <para style="q1" vid="PSA 42:5">Pingo awinyo lwak par madwong i cwinya?</para>
  <para style="q1" vid="PSA 42:5">Abigeno Lubanga aye, dok abipake bene,</para>
  <para style="q1" vid="PSA 42:5">en lalar mera ki Lubangana.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Cwinya obale woko, oweko apo piri,</para>
  <para style="q1" vid="PSA 42:6">ki i lobo me Jordan ki Kermon, ki i got Mijar kama aringo ayela iye.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Calo nam madongo matut ma lwongo nam wadigi,</para>
  <para style="q1" vid="PSA 42:7">ki i mor pii ki iwang acurcurni;</para>
  <para style="q1" vid="PSA 42:7">calo biamwonyini ducu me pii ma twage ma dong otyeko mwonya woko lipuk.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Rwot miyo mar mere ma pe loke ryeny ikoma i dyeceng;</para>
  <para style="q1" vid="PSA 42:8">ci i dyewor awero wer me pake,</para>
  <para style="q1" vid="PSA 42:8">kun alego Lubanga mamiyo ki an kwo.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Abiwaco bot Lubanga ma en gota ni,</para>
  <para style="q1" vid="PSA 42:9">“Pingo wii owil woko ikoma?</para>
  <para style="q1" vid="PSA 42:9">Pingo awoto ma akumu akuma</para>
  <para style="q1" vid="PSA 42:9">pien lakwora tye kauna tutwal?”<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Nen calo atye ki bur marac tutwal mudet ikoma,</para>
  <para style="q1" vid="PSA 42:10">pien lukwora gibedo kayeta, kun gipenya teretere ni,</para>
  <para style="q1" vid="PSA 42:10">“Lubangani ni tye kwene?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Pingo cwinya obale woko, dok pingo abedo ki cwercwiny?</para>
  <para style="q1" vid="PSA 42:11">Pingo awinyo lwak par madwong i cwinya?</para>
  <para style="q1" vid="PSA 42:11">Abigeno Lubanga aye, dok abipake bene,</para>
  <para style="q1" vid="PSA 42:11">en lalar mera ki Lubangana.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s1">Lega pa oringayela</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Ai Lubanga, pid pira dok imii alo kop,</para>
  <para style="q1" vid="PSA 43:1">dok igeng ngeya ki ikom lwak me rok ma pe gingeyi;</para>
  <para style="q1" vid="PSA 43:1">lara ki i cing jo maracu ma lubwola.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />In aye Lubanga ma oweko aringo alaro boti;</para>
  <para style="q1" vid="PSA 43:2">pingo ibola woko cen kamabor?</para>
  <para style="q1" vid="PSA 43:2">Pingo wii owil woko ikoma?</para>
  <para style="q1" vid="PSA 43:2">Pingo awoto ma akumu akuma</para>
  <para style="q1" vid="PSA 43:2">ma nongo lakwora tye kauna tutwal?<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Dong icwal deroni ki adani;</para>
  <para style="q1" vid="PSA 43:3">wek gutela,</para>
  <para style="q1" vid="PSA 43:3">wek gukela ikom got meri maleng,</para>
  <para style="q1" vid="PSA 43:3">wa i odi kama ibedo iye!<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Ci abicito wa ikom keno tyer pa Lubanga,</para>
  <para style="q1" vid="PSA 43:4">bot Lubanga ma yomo cwinya mada;</para>
  <para style="q1" vid="PSA 43:4">ci dong abipaki ki opuk agoya,</para>
  <para style="q1" vid="PSA 43:4">Ai Lubanga, in Lubangana.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Pingo cwinya obale woko, dok pingo abedo ki cwercwiny?</para>
  <para style="q1" vid="PSA 43:5">Pingo awinyo lwak par madwong i cwinya?</para>
  <para style="q1" vid="PSA 43:5">Abigeno Lubanga aye, dok abipake bene,</para>
  <para style="q1" vid="PSA 43:5">en lalar mera ki Lubangana.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s1">Lega pi gwok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />Ai Lubanga, dong watyeko winyone ki itwa,</para>
  <para style="q1" vid="PSA 44:1">dok kwariwa bene gutito botwa,</para>
  <para style="q1" vid="PSA 44:1">tic ducu mayam itiyo i karegi,</para>
  <para style="q1" vid="PSA 44:1">ikare macon mukato.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Kit ma in kikomi iryemo lurok woko ki tweroni,</para>
  <para style="q1" vid="PSA 44:2">ci imiyo joni gubedo i lobogi macalo yadi ma ipito;</para>
  <para style="q1" vid="PSA 44:2">iunu lwak me rok mapol</para>
  <para style="q1" vid="PSA 44:2">ento imiyo kwariwa gubedo ki kuc.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Lwaki pe guloyo lobo meno ki pala lucwan gi,</para>
  <para style="q1" vid="PSA 44:3">pe gulimo loc pi twerogi;</para>
  <para style="q1" vid="PSA 44:3">ento meno obedo pi tweroni ki pi teki,</para>
  <para style="q1" vid="PSA 44:3">dok pi deroni ma ocaro komgi;</para>
  <para style="q1" vid="PSA 44:3">pien onongo in cwinyi yom ikomgi.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />In keken aye Rwota ki Lubangana,</para>
  <para style="q1" vid="PSA 44:4">mayam iciko pi loc bot Yakobo.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Pi konyi miyo wabiloyo lukworwa,</para>
  <para style="q1" vid="PSA 44:5">dok wabinyono jo ma gibino kamonyowa pi nyingi.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Pe ageno atuma,</para>
  <para style="q1" vid="PSA 44:6">dok pala lucwana bene pe twero lara.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Ento in aye ma ilarowa ki i cing lukworwa,</para>
  <para style="q1" vid="PSA 44:7">ci imiyo lewic mako jo ma gidagwa.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Wabedo kanyate i Lubanga teretere,</para>
  <para style="q1" vid="PSA 44:8">dok wabimede kapwoyo nyingi matwal.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Ento in dong ityeko bolowa woko dok imiyo wadoko mayot,</para>
  <para style="q1" vid="PSA 44:9">pe itelo wiwa ka wacito kalweny ikom lumerokwa.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Imiyo waringo woko ki bot lumerokwa wadwogo woko cen;</para>
  <para style="q1" vid="PSA 44:10">ci imiyo lukworwa guyako jamiwa mapol ata.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Imiyo wadoko calo romi me aneka,</para>
  <para style="q1" vid="PSA 44:11">dok ikeyowa woko ikin lurok.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Icato lwaki i wel manok mo,</para>
  <para style="q1" vid="PSA 44:12">pe imito ni kicul wel madwong pirgi.<verse eid="PSA 44:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Imiyo luwotwa ma gibedo cok kwedwa loko lok me cac ikomwa,</para>
  <para style="q1" vid="PSA 44:13">imiyo jo ma gibedo i kabedo ma orumuwa gicayowa dok gingalowa.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Imiyo wadoko lok aboka ikin lurok,</para>
  <para style="q1" vid="PSA 44:14">wadoko ginanyera ikin rok ducu.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Abedo ki cwercwiny dyeceng jwi,</para>
  <para style="q1" vid="PSA 44:15">ma nongo wanga olwal woko ki lewic,<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />pi winyo lok cac pa jo ma giloko lok agec ikomwa,</para>
  <para style="q1" vid="PSA 44:16">ki lok pa jo ma ginywarowa,</para>
  <para style="q1" vid="PSA 44:16">dok pi neno lukworwa ma gin lucul kwor</para>
  <para style="q1" vid="PSA 44:16">ma gubino kalweny ikomwa.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Man ducu dong otime ikomwa,</para>
  <para style="q1" vid="PSA 44:17">kadi bed wiwa pe owil ikomi,</para>
  <para style="q1" vid="PSA 44:17">dok bene kadi pe waturu gicikeni.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Cwinywa pe oa ki ikomi wa ki acel,</para>
  <para style="q1" vid="PSA 44:18">dok bene pe wangak waweko lubu ciki.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Itenyowa woko liyak ikin lee tim,</para>
  <para style="q1" vid="PSA 44:19">iumuwa woko lipuk ki colpiny mapek.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Kace nene wiwa owil woko ikom nying Lubangawa,</para>
  <para style="q1" vid="PSA 44:20">nyo ka onongo wacako woro lubanga mukene mayam pe wangeyo,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />kono Lubanga mono pe oroto man ongeyo woko?</para>
  <para style="q1" vid="PSA 44:21">En ngeyo mung ducu matye i cwiny dano.<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:22: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:36">Rom 8:36</ref>
      </char>
    </note> Ento piri oweko kibedo kanekowa dyeceng jwi,</para>
  <para style="q1" vid="PSA 44:22">kikwanowa macalo romi me aneka.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Coo woko, Ai Rwot! Pingo inino anina?</para>
  <para style="q1" vid="PSA 44:23">Coo woko! Pe ibolwa woko matwal!<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Pingo ikane woko ki botwa?</para>
  <para style="q1" vid="PSA 44:24">Pingo wii wil woko ikom can ma watye kwede</para>
  <para style="q1" vid="PSA 44:24">kun ineno anena ka kiunuwa?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Kiretowa woko ducu piny i ngom;</para>
  <para style="q1" vid="PSA 44:25">waryebe piny i apwa pien kiloyowa woko.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />A malo, ibin ilarwa!</para>
  <para style="q1" vid="PSA 44:26">Larwa pi mar meri ma pe loke!<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s1">Wer ma kiwero pi nyom pa rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Cwinya opong ki lok mabeco adada;</para>
  <para style="q1" vid="PSA 45:1">lok magi ducu atye kalokone bot rwot;</para>
  <para style="q1" vid="PSA 45:1">dok leba tye atera calo leb kalam pa karan ma oyube pi coc.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />In keken aye imunya makato co mukene ducu,</para>
  <para style="q1" vid="PSA 45:2">lok ma iloko ducu obedo me kica keken;</para>
  <para style="q1" vid="PSA 45:2">pimeno Lubanga dong otyeko miyi gum woko matwal.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Twe pala lucwani i taci, in twon oteka,</para>
  <para style="q1" vid="PSA 45:3">i deyoni ki dit meri.<verse eid="PSA 45:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Ring ngwec me loc kikome kideyo kalweny pi ada dok pi gwoko kit ma atir;</para>
  <para style="q1" vid="PSA 45:4">wek cingi ma lacuc otim tim me aura makelo lworo.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Ateroni bit,</para>
  <para style="q1" vid="PSA 45:5">celo tucu adunu pa lukwori woko pil;</para>
  <para style="q1" vid="PSA 45:5">lwak me rok ducu gipoto ite loci.<verse eid="PSA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:6: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:8-9">Ibru 1:8-9</ref>
      </char>
    </note>Komkeri ma Lubanga omiyi bedo nakanaka,</para>
  <para style="q1" vid="PSA 45:6">odoo keri aye odoo me kit ma atir;<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />imaro kit ma atir, idag tim maracu.</para>
  <para style="q1" vid="PSA 45:7">Pimeno Lubanga, ma Lubangani, dong, otyeko wiri ki moo,</para>
  <para style="q1" vid="PSA 45:7">owiri ki moo me yomcwiny makato luwoti mukene ducu.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Ginarukani ducu kikiro iye murra ma ngwece kur,</para>
  <para style="q1" vid="PSA 45:8">ki kit moo makur ducu, ki kacia mamit.</para>
  <para style="q1" vid="PSA 45:8">I gang kali ma kideyo ki lak lyec</para>
  <para style="q1" vid="PSA 45:8">wer pa lugo nangagu miyo cwinyi bedo yom.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Anyira pa rwot bene gitye ikin moni me awora;</para>
  <para style="q1" vid="PSA 45:9">daker ocung tung cingi ma lacuc ma oruku ruk ma kideyo ki jabu me Opir.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Nyara, kong iwiny, ci itam mot, dok icik iti;</para>
  <para style="q1" vid="PSA 45:10">wii myero owil woko ikom lutuwu ki ikom jo me dogola pa kwaru.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Beri bimiyo rwot miti;</para>
  <para style="q1" vid="PSA 45:11">en obedo rwodi, gung inyime iwore.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Jo Turo gibikelo mot mapol boti kun giyenyo yo me weko cwinyi omargi,</para>
  <para style="q1" vid="PSA 45:12">jo ma lulonyo gibilego kony ki boti kun gikeli lwak lonyo mapatpat.<verse eid="PSA 45:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Nyako ker oruke woko maber ki i kicikane</para>
  <para style="q1" vid="PSA 45:13">ki bongo ma kideyo maber ki jabu,<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />oruku bongi ma rangigi patpat ka kitere kwede bot rwot,</para>
  <para style="q1" vid="PSA 45:14">kun anyira luwote ma gilwoke gilubu kore.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Gitelo wigi kun gitye ki yomcwiny madwong,</para>
  <para style="q1" vid="PSA 45:15">ikare ma gicito ka donyo i gangkal pa rwot.<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Lutino awobeni gibileyo ka kwarini calo rwodi</para>
  <para style="q1" vid="PSA 45:16">ibiketogi gibedo rwodi i lobo ducu.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Abikoro pi ywekani i yalwak ducu;</para>
  <para style="q1" vid="PSA 45:17">dok lwak me rok ducu gibipaki nakanaka.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s1">Lubanga tye kwedwa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />Lubanga aye kalarewa dok tekwa bene,</para>
  <para style="q1" vid="PSA 46:1">en oyube me konyowa ikare me can.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Pimeno pe wabibedo ki lworo mo kadi bed lobo yenge,</para>
  <para style="q1" vid="PSA 46:2">kadi ka godi gupute yaka gupoto woko i dye nam;<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />kadi ka pii me nam mor dok twage,</para>
  <para style="q1" vid="PSA 46:3">kadi ka godi giyenge pi twage mere matek.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Tye kulu mo ma jange kelo yomcwiny i taun madit pa Lubanga,</para>
  <para style="q1" vid="PSA 46:4">i kabedo maleng pa Ngat Mamalo Twal!<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />Lubanga tye i dye taun madit meno, pimeno pe kitwero balone wa ki acel;</para>
  <para style="q1" vid="PSA 46:5">Lubanga konye woko oyotoyot okokgweno.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Rok ducu komgi oonyo koyo,</para>
  <para style="q1" vid="PSA 46:6">ki ker ducu oyenge woko;</para>
  <para style="q1" vid="PSA 46:6">Lubanga loko ki dwon mamor malongo, ci lobo leny woko.<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />Rwot me mony tye kwedwa;</para>
  <para style="q1" vid="PSA 46:7">Lubanga pa Yakobo aye kalarewa.<verse eid="PSA 46:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Bin inen gin me aura ma Rwot otiyo,</para>
  <para style="q1" vid="PSA 46:8">kit macalo omiyo lobo odong obur kwede.<verse eid="PSA 46:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />En juku lweny woko ki iwi lobo ducu;</para>
  <para style="q1" vid="PSA 46:9">kun turu atum ducu dok nginyo wa tong woko,</para>
  <para style="q1" vid="PSA 46:9">en wango lwak kwot woko liweng ki mac.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Rwot owaco ni,</para>
  <para style="q1" vid="PSA 46:10">“Wubed mot ma cwinywu opye, dok wunge ni an Lubanga,</para>
  <para style="q1" vid="PSA 46:10">atye malo iwi rok ducu,</para>
  <para style="q1" vid="PSA 46:10">dok kidwora iwi lobo ducu!”<verse eid="PSA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />Rwot me mony tye kwedwa;</para>
  <para style="q1" vid="PSA 46:11">Lubanga pa Yakobo aye kalarewa.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s1">Lubanga aye lawi luloc ducu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />Wudong cingwu, wun lwak ducu me wi lobo ducu!</para>
  <para style="q1" vid="PSA 47:1">Wudange kun wuwero wer me yomcwiny bot Lubanga ki dwon malongo!<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Pien Rwot, ma en Ngat Mamalo Twal, aye myero kilwor,</para>
  <para style="q1" vid="PSA 47:2">en rwot madit maloyo wi lobo ducu.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />En aye omiyo waloyo lwak me rok ducu,</para>
  <para style="q1" vid="PSA 47:3">en oketowa me bedo luloc pa lurok.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />En aye ma oyero lobo man pirwa kama wabedo iyeni,</para>
  <para style="q1" vid="PSA 47:4">man aye gipiny me wake pa Yakobo ma en maro.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Lubanga dong oito malo kun lwak gidange matek,</para>
  <para style="q1" vid="PSA 47:5">Rwot oito malo ma lwak gikutu tum.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Wuwer wer me pako Lubanga, wuwer wer me pake!</para>
  <para style="q1" vid="PSA 47:6">Wuwer wer me pako Rwotwa, wuwer wer me pake!<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />Lubanga aye Rwot maloyo wi lobo ducu;</para>
  <para style="q1" vid="PSA 47:7">wuwer wer me pak ki jabuli!<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />Lubanga loyo rok ducu;</para>
  <para style="q1" vid="PSA 47:8">Lubanga bedo iwi komkere maleng.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Rwodi ma giloyo lwak me rok ducu gucoke</para>
  <para style="q1" vid="PSA 47:9">ma guribe kacel ki jo pa Lubanga pa Abraim.</para>
  <para style="q1" vid="PSA 47:9">Pien teko pa Lubanga dit makato tek me kwot ducu me wi lobo;</para>
  <para style="q1" vid="PSA 47:9">piman myero kidwore matek tutwal!<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s1">Cion, taun madit pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />Rwot dit, pimeno myero kipake matek i taun madit pa Lubangawa!<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:2: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:35">Mat 5:35</ref>
      </char>
    </note>Got mere maleng ber, dok wiye bor,</para>
  <para style="q1" vid="PSA 48:2">ma yomo cwiny lwak me wi lobo ducu,</para>
  <para style="q1" vid="PSA 48:2">en got Cion matye kamabor tung kumalo,</para>
  <para style="q1" vid="PSA 48:2">en aye gang pa Rwot madit.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />Ki i gogone Lubanga onyute</para>
  <para style="q1" vid="PSA 48:3">ni en aye lagwok matek.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Nen, luker gucoke,</para>
  <para style="q1" vid="PSA 48:4">gubino gugure kacel pi monyo Got Cion.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Ikare ma guneno, cutcut gubedo ki ur madit mada,</para>
  <para style="q1" vid="PSA 48:5">ci lworo omakogi marac, ka guringo woko ata.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Komgi omyel matek ki kunu,</para>
  <para style="q1" vid="PSA 48:6">macalo arem madwong pa dako matye kanywal,<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />macalo mel me Tarcic mayamo ma oa tung kunyango twago.<verse eid="PSA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Kit ma watyeko winyone, dong bene waneno</para>
  <para style="q1" vid="PSA 48:8">i taun madit pa Rwot me mony, i taun madit pa Lubangawa,</para>
  <para style="q1" vid="PSA 48:8">ma Lubanga miyo cung liking nakanaka.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Wabedo ki tam ikom mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 48:9">Ai Lubanga, i dye odi.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Kit macalo nyingi oywek kwedeni, Ai Lubanga,</para>
  <para style="q1" vid="PSA 48:10">omiyo pak ma kipaki kwede oromo wi lobo ducu.</para>
  <para style="q1" vid="PSA 48:10">Cingi ma lacuc opong ki twero me loc;<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />wek got Cion obed ki yomcwiny!</para>
  <para style="q1" vid="PSA 48:11">Wek taun madito ma i Juda gubed ki yomcwiny</para>
  <para style="q1" vid="PSA 48:11">pi kit ma ingolo kwede kop!<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Wucit i Cion, wuwot wurum cele woko,</para>
  <para style="q1" vid="PSA 48:12">wukwan wel lubelene,<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />ka dok wutam maber ikom cele,</para>
  <para style="q1" vid="PSA 48:13">wucit wuwot wa i gogone bene;</para>
  <para style="q1" vid="PSA 48:13">wek wutit bot yalwak ma bilubuwu ni,<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />“Man aye Lubanga,</para>
  <para style="q1" vid="PSA 48:14">en Lubangawa ma bedo nakanaka.</para>
  <para style="q1" vid="PSA 48:14">En bibedo latelawa matwal.”<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s1">Geno lonyo obedo mingo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Wuwiny lok man, wun lwak me rok ducu!</para>
  <para style="q1" vid="PSA 49:1">Wuwiny, wun jo ducu ma wubedo iwi lobo,<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />jo matye ki rwom mamalo ki jo me rwom ma piny,</para>
  <para style="q1" vid="PSA 49:2">lulonyo kacel ki lucan.<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Abibedo katamo tam wek aniang maber ki i cwinya,</para>
  <para style="q1" vid="PSA 49:3">dok abiloko lok me ryeko keken.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Abiciko ita me winyo carolok;</para>
  <para style="q1" vid="PSA 49:4">abigonyo telok me koclit ki wer ma agoyo agoya ki opuk.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Pe abibedo ki lworo ikare me can,</para>
  <para style="q1" vid="PSA 49:5">ma nongo lumonena ma gitima marac guruma woko dyere!<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />Gin jo ma geno lonyogi,</para>
  <para style="q1" vid="PSA 49:6">ma ginyate pi lwak lonyogi madwong ma gitye kwede.<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Adada, pe tye dano mo matwero koke kekene,</para>
  <para style="q1" vid="PSA 49:7">nyo matwero miyo wel mo bot Lubanga me wilo kwone.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Pien gin kok me kwo pa dano wele dit tutwal,</para>
  <para style="q1" vid="PSA 49:8">dok bene pe tye gicul mo ma romo bot Lubanga,<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />ma weko en omede ki bedo kwo nakanaka,</para>
  <para style="q1" vid="PSA 49:9">ma pe en to.<verse eid="PSA 49:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Eyo, ngat mo keken neno ki wange ni kadi wa jo maryek bene gito,</para>
  <para style="q1" vid="PSA 49:10">luming kacel ki jo ma wigi oding bene gito,</para>
  <para style="q1" vid="PSA 49:10">ci giweko lonyogi dong bot jo mukene.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Lyelgi doko ganggi matwal,</para>
  <para style="q1" vid="PSA 49:11">bibedo kabedogi pi kare pa yalwak ducu,</para>
  <para style="q1" vid="PSA 49:11">kadi bed gucak nying lobo ma gibedo iye ni meggi kikomgi.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Deyo pa dano pe twero lare ki i to;</para>
  <para style="q1" vid="PSA 49:12">en obedo macalo lee tim ma gito gitum woko.<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Man aye can ma poto ikom jo matye ki gen me mingo;</para>
  <para style="q1" vid="PSA 49:13">man agiki pa jo ma cwinygi yom pi dul jami ma gitye kwede.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Adada gin bito macalo romi;</para>
  <para style="q1" vid="PSA 49:14">to aye ma bibedo kakwayogi, ci gibicito atir gidonyo wa i lyel,</para>
  <para style="q1" vid="PSA 49:14">ci komgi bitop woko;</para>
  <para style="q1" vid="PSA 49:14">lyel bibedo ganggi.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Ento Lubanga bikoko tipuna ki i twero pa lyel,</para>
  <para style="q1" vid="PSA 49:15">pien en gire bigama.<verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Pe iwek lworo omaki kace inen ngat mo doko lalonyo,</para>
  <para style="q1" vid="PSA 49:16">ma lonyone tye kamede ameda.<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />En pe bikwanyo gin mo cito kwede ikare ma en to;</para>
  <para style="q1" vid="PSA 49:17">lonyone pe bilube i bur lyel.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Kadi bed en tamo ni etye ki yomcwiny ikare ma pud ekwo,</para>
  <para style="q1" vid="PSA 49:18">kun dano gipake pi lonyoneni,<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />en bicito kabedo kacel ki yalwak pa kwarine i lyel</para>
  <para style="q1" vid="PSA 49:19">ma pe dong bimedo ki neno dero ceng matwal.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Deyo ma dano tye kwede pe bigengo en to;</para>
  <para style="q1" vid="PSA 49:20">en pud bito macalo lee tim.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s1">Woro me ada</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Lubanga Matwero ducu,</para>
  <para style="q1" vid="PSA 50:1">ma en Rwot, dong oloko;</para>
  <para style="q1" vid="PSA 50:1">en lwongo jo me wi lobo ducu cake ki tung kunyango nio kwede tung kupotoceng.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Lubanga tye karyeny ki i Cion,</para>
  <para style="q1" vid="PSA 50:2">en taun madit maber tutwali.<verse eid="PSA 50:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Lubangawa tye kabino, en pe biling,</para>
  <para style="q1" vid="PSA 50:3">mac mager tye ka wang inyime,</para>
  <para style="q1" vid="PSA 50:3">yamo magwa ma kodo matek orume woko dyere.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />En lwongo polo ki malo, ka dok lwongo lobo,</para>
  <para style="q1" vid="PSA 50:4">wek dong ecak ngolo kop ikom lwake.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />En waco ni, “Wucok jona ma lugen, wukelgi bota,</para>
  <para style="q1" vid="PSA 50:5">jo ma guketo gicike kweda ki gitum!”<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Polo tucu ni Lubanga opore,</para>
  <para style="q1" vid="PSA 50:6">pien Lubanga aye langolkop.<verse eid="PSA 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />“Wuwiny, wun jona, an dong abilok, wun jo Icrael,</para>
  <para style="q1" vid="PSA 50:7">abimiyo lok me caden ikomwu.</para>
  <para style="q1" vid="PSA 50:7">An Lubanga, Lubangawu.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Pe ajukuwu pi lwak gitumwu mapol,</para>
  <para style="q1" vid="PSA 50:8">ki gitum awanga ma wutyero bota kare ki kare.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Pe abigamo twon mo ma wukelo ki i gangwu,</para>
  <para style="q1" vid="PSA 50:9">kadi nyok dyel ma wukwanyo ki i dwolwu.<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Lee me bunga ducu mera,</para>
  <para style="q1" vid="PSA 50:10">wa lwak dyangi ma gitye iwi cere alip kuluni bene gin mera.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Angeyo winyi ducu ma gituk i dye yamo,</para>
  <para style="q1" vid="PSA 50:11">ki gin makwo ma gibedo i tim ducu mera.<verse eid="PSA 50:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Kace nene kec neka pe onongo atwero tito botwu?</para>
  <para style="q1" vid="PSA 50:12">Pien lobo ki jami ducu matye iye mera.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />An mono acamo ringo twoni,</para>
  <para style="q1" vid="PSA 50:13">nyo wuneno amato remo nyogi romi?<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Wutyer gityer me miyo pwoc bot Lubanga,</para>
  <para style="q1" vid="PSA 50:14">wucob kwongwu bot en Mamalo Twal.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />Wukok bota ikare me can;</para>
  <para style="q1" vid="PSA 50:15">an abilarowu,</para>
  <para style="q1" vid="PSA 50:15">ci wubipaka.”<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Ento bot dano marac Lubanga waco ni,</para>
  <para style="q1" vid="PSA 50:16">“Kit twer ango ma itye kwede me kwano cika,</para>
  <para style="q1" vid="PSA 50:16">ki me bedo kaloko lok ikom gicikena?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />In ikwero ni pe myero kijuki,</para>
  <para style="q1" vid="PSA 50:17">dok ibolo lok ma aciko odok tung ngeyi.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Kace ineno lakwo, ci imako doko laremi;</para>
  <para style="q1" vid="PSA 50:18">dok ibedo kacel ki lutim abor.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Kare ducu iyube me loko gin marac;</para>
  <para style="q1" vid="PSA 50:19">lok ma a ki i dogi obedo lok goba.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Kama ibedo iye icako loko lok marac ikom omeru;</para>
  <para style="q1" vid="PSA 50:20">ikwoto omeru kikome ma latin pa meni.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Meno ducu itiyo ento an aling alinga:</para>
  <para style="q1" vid="PSA 50:21">omiyo itamo ni gwok nyo abedo ngat mo ma kite rom ki merini.</para>
  <para style="q1" vid="PSA 50:21">Ento kombedi dong ajuki, dok anyuti bali ducu kamaleng.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />Kong wutam man, wun jo ma wiwu wil woko ikom Lubangani,</para>
  <para style="q1" vid="PSA 50:22">wek pe atyekwu woko, ci dong ngat mo ma bilarowu bibedo peke.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Ngat ma miya pwoc macalo gitume nongo keto deyo ikoma;</para>
  <para style="q1" vid="PSA 50:23">ki ngat ma bedo ki kit ma atir kun lubu cika abinyutu lara bote.”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s1">Lega me kwayo kica</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Ai Lubanga, tima kica</para>
  <para style="q1" vid="PSA 51:1">pi mar meri ma pe loke;</para>
  <para style="q1" vid="PSA 51:1">dok pi kicani madwong ci i jwa bala woko ducu.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Lwok gin marac woko liweng ki ikoma,</para>
  <para style="q1" vid="PSA 51:2">dok ilonya ikom bala.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Angeyo bala ducu maber,</para>
  <para style="q1" vid="PSA 51:3">dok kare ducu wiya po ikom bal ma atimo.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:4: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:4">Rom 3:4</ref>
      </char>
    </note> An dong atyeko timo bal ikomi, ikom in keken,</para>
  <para style="q1" vid="PSA 51:4">kun atimo gin manen marac i wangi;</para>
  <para style="q1" vid="PSA 51:4">pimeno lok ma iwaco ikoma tye atir,</para>
  <para style="q1" vid="PSA 51:4">dok kop ma ingolo ikoma tye kakare.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Nen, abedo labalo cake ikare ma kinywala,</para>
  <para style="q1" vid="PSA 51:5">ikare ma maa ogama i ic onongo an dong atye ki bal.<verse eid="PSA 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Nen, in imito ni dano obed ki ada i iye;</para>
  <para style="q1" vid="PSA 51:6">pimeno pwonya ki lok me ryeko wek odony matut i cwinya.<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Lonya ki anyero, nia ikom bala ci abibedo maleng;</para>
  <para style="q1" vid="PSA 51:7">lwoka ci abibedo matar makato pee.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Miya abed ki yomcwiny madwong;</para>
  <para style="q1" vid="PSA 51:8">mi cwinya mayam ituruni dok obed ki yomcwiny bene.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Mii wangi woko, pe inen roc mera,</para>
  <para style="q1" vid="PSA 51:9">dok i jwa bala woko ducu.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />Ai Lubanga, miya abed ki cwiny ma olony,</para>
  <para style="q1" vid="PSA 51:10">ket cwiny manyen ma pe loke obed i iya.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Pe iryema woko ki inyimi,</para>
  <para style="q1" vid="PSA 51:11">dok pe ikwany Cwiny meri maleng woko ki bota.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Lara, ci imii abed ki yomcwiny;</para>
  <para style="q1" vid="PSA 51:12">miya cwiny me lubu ciki.<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Ci abipwonyo lujemo me lubu yoni,</para>
  <para style="q1" vid="PSA 51:13">ki lubalo gibiloke gidwogo boti.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />Ai Lubanga, lara ki ikom jo ma gimito oyo remona,</para>
  <para style="q1" vid="PSA 51:14">in Lubanga ma lalara,</para>
  <para style="q1" vid="PSA 51:14">ci abiwero wer me paki ki dwon malongo pi kiti ma atir.<verse eid="PSA 51:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Ai Rwot, yab doga,</para>
  <para style="q1" vid="PSA 51:15">ci abiwero wer me paki.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Gitum ma dano kelo boti pe mini yomcwiny mo;</para>
  <para style="q1" vid="PSA 51:16">kadi bed atyer boti gitum awanga, in pe ibipwoyo.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Gitum ma Lubanga pwoyo aye cwiny ma ongut.</para>
  <para style="q1" vid="PSA 51:17">Ai Lubanga, in pe ibicayo ngat ma cwinye cwer pi bale ki ma ngut.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Tim ber ki Cion ma oporo leng cwinyi,</para>
  <para style="q1" vid="PSA 51:18">dok icwe cel me Jerucalem odoco.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Ci dong cwinyi bibedo yom pi gitum ma atir,</para>
  <para style="q1" vid="PSA 51:19">pi gitum awanga ki gitum ma kiwango woko ducu ki bere;</para>
  <para style="q1" vid="PSA 51:19">ka dong kibityero twoni iwi keno tyeri.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s1">Ngolo kop pa Lubanga ki kicane</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />In twon oteka, pingo inyate pi gin marac ma itimo</para>
  <para style="q1" vid="PSA 52:1">ikom jo ma ngeyo Lubanga?<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Ipiro lok me tyeko jo mukene woko i dyeceng jwi.</para>
  <para style="q1" vid="PSA 52:2">Lebi tye mabit calo lyedi,</para>
  <para style="q1" vid="PSA 52:2">imaro loko lok me roro.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Imaro timo gin marac makato timo gin maber,</para>
  <para style="q1" vid="PSA 52:3">dok imaro loko lok goba makato loko lok ada.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Imaro miyo arem ikom dano ki lok maracu ma iloko,</para>
  <para style="q1" vid="PSA 52:4">in dano ma lagoba.<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Ento Lubanga binginyi woko piny matwal;</para>
  <para style="q1" vid="PSA 52:5">en bimaki ci ywayi woko ki ikemani;</para>
  <para style="q1" vid="PSA 52:5">ka dok en biputi woko ki i lobo pa jo makwo.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Jo ma kitgi atir bineno ci gibedo ki lworo,</para>
  <para style="q1" vid="PSA 52:6">gibinyere bene kun giwaco ni,<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />“Nen, man aye dano ma onongo pe mito ringo kalare bot Lubanga,</para>
  <para style="q1" vid="PSA 52:7">ento obedo kageno lwak lonyone ma dwongi,</para>
  <para style="q1" vid="PSA 52:7">dok ogeno ni lime aye kalarene!”<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Ento an abedo macalo yat jeituni ma jange olot ojany matye i Ot pa Lubanga.</para>
  <para style="q1" vid="PSA 52:8">Abedo ma ageno mar pa Lubanga ma pe loke nakanaka.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Abipwoyo in nakanaka,</para>
  <para style="q1" vid="PSA 52:9">pien dong ityeko tiyo man.</para>
  <para style="q1" vid="PSA 52:9">Nyingi ber, abibedo katucune inyim joni ma gingeyi.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s1">Kit maracu pa dano</para>
  <para style="r">(<ref loc="PSA 14">Jab 14</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">53:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Rom 3:10-12</ref>
      </char>
    </note>Dano ma laming waco ki i cwinye ni,</para>
  <para style="q1" vid="PSA 53:1">“Lubanga gire peke.”</para>
  <para style="q1" vid="PSA 53:1">Gin jo ma kitgi racu ma gitimo gin me kwer;</para>
  <para style="q1" vid="PSA 53:1">pe tye ngat mo ma tiyo gin maber.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />Lubanga neno dano ducu kun neno piny ki i polo,</para>
  <para style="q1" vid="PSA 53:2">me neno kace tye jo mogo ikin gi ma giryek,</para>
  <para style="q1" vid="PSA 53:2">ma giyenyo en.<verse eid="PSA 53:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Gin ducu dong gungak woko, gudoko jo ma kitgi racu;</para>
  <para style="q1" vid="PSA 53:3">pe tye ngat mo ma tiyo gin maber, pe tye kadi ki acel.<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Gin lutim maracu ni, pe gitye ki ngec?</para>
  <para style="q1" vid="PSA 53:4">Giyako lim pa jona calo gicamo kwon,</para>
  <para style="q1" vid="PSA 53:4">ma pe bene gilwongo nying Lubanga.<verse eid="PSA 53:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Gitye kunu ki lworo madwong</para>
  <para style="q1" vid="PSA 53:5">kit lworo mayam peya onen!</para>
  <para style="q1" vid="PSA 53:5">Lubanga biketo cogo pa jo ma pe gingeyo en woko ata;</para>
  <para style="q1" vid="PSA 53:5">lewic bimakogi, pien Lubanga dong okwerogi woko.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Eyo, onongo alego ni lare pa jo Icrael omyero obin ki i Cion!</para>
  <para style="q1" vid="PSA 53:6">Ka Lubanga bidwoko gum bot jone.</para>
  <para style="q1" vid="PSA 53:6">Ci Yakobo bibedo ki yomcwiny madwong, ki Icrael bene cwinye bibedo yom.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s1">Lega pi gwok ki ikom lukwor</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Ai Lubanga, lara pi nyingi, dok imii alo kop pi tweroni.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Winy legana, Ai Lubanga;</para>
  <para style="q1" vid="PSA 54:2">cik iti iwiny lok ma awaco.<verse eid="PSA 54:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Jo ma luwake gubino kalweny ikoma,</para>
  <para style="q1" vid="PSA 54:3">jo mager gimito neka woko;</para>
  <para style="q1" vid="PSA 54:3">gin jo ma pe tamo pi Lubanga.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Angeyo ni Lubanga aye lakony mera;</para>
  <para style="q1" vid="PSA 54:4">Rwot aye ma gwoko kwona.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />En biculu kwor ikom lukwora ki gin marac;</para>
  <para style="q1" vid="PSA 54:5">tyekgi woko liweng pien in Lubanga ma gene.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Abityero gityer boti pi yomcwiny;</para>
  <para style="q1" vid="PSA 54:6">abimiyi pwoc, Ai Rwot, pien in iber.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Nen dong ityeko lara ki ikit can ducu ma opoto ikoma,</para>
  <para style="q1" vid="PSA 54:7">dong aneno ni atyeko loyo lukwora woko.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s1">Lega pa dano ma lawote odobo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />Cik iti iwiny legana, Ai Lubanga;</para>
  <para style="q1" vid="PSA 55:1">pe ikane woko ka abako doga boti!<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Winya, dok igam doga;</para>
  <para style="q1" vid="PSA 55:2">can dong obwoya woko.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Cwinya obale woko pi winyo woo pa lukwora,</para>
  <para style="q1" vid="PSA 55:3">ki pi aroma ma jo maracu giuna kwede.</para>
  <para style="q1" vid="PSA 55:3">Gin aye ma gikelo can ikoma,</para>
  <para style="q1" vid="PSA 55:3">kiniga omakogi ikoma, guloke gudoko lumonena.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Atye ki arem madwong i cwinya,</para>
  <para style="q1" vid="PSA 55:4">lworo me to dong opoto woko ikoma.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Lworo omaka dok koma bene tye kamyel amyela,</para>
  <para style="q1" vid="PSA 55:5">dong tipu koma oto woko lirut.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Omiyo awaco ni, “Kono nene atye ki bwoma calo akuri!</para>
  <para style="q1" vid="PSA 55:6">Kono atuk acito woko wek aywe.<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Ada, kono atuk acito wa kamabor,</para>
  <para style="q1" vid="PSA 55:7">onongo atwero butu i dye tim ata.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Onongo kono arune oyotoyot pi nongo kalare,</para>
  <para style="q1" vid="PSA 55:8">wek agwoke ki ikom yamo lapiru mager wa ki ikom yamo ma kodo matek.”<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Ai Rwot, bal yub pa jo ducu ma gidaga, dok irub lebgi woko;</para>
  <para style="q1" vid="PSA 55:9">pien atye kaneno tim bwami ki lweny matye i taun madit.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Dyeceng ki dyewor giwoto ki iwi cel girumu gang woko;</para>
  <para style="q1" vid="PSA 55:10">dok tim aranyi ki can madwong tye kanen iye.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Nek tye kanen i kabedo ducu;</para>
  <para style="q1" vid="PSA 55:11">wa i cukgu gitye kaunu dano ki tim aranyi ki bwola.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Ka lamonena aye ma onongo loko lok agec ikoma,</para>
  <para style="q1" vid="PSA 55:12">kono onongo atwero cirone;</para>
  <para style="q1" vid="PSA 55:12">ka lakwora aye ma onongo tye kanywara,</para>
  <para style="q1" vid="PSA 55:12">kono onongo aa woko ki bote ci akane woko.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Ento man in aye, ma warom kwedini,</para>
  <para style="q1" vid="PSA 55:13">ngat ma wabedo kwede kacel,</para>
  <para style="q1" vid="PSA 55:13">larema kikome ma dong wangiyo kwede.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Yam wabedo kaboko lok mamit kwedi kacel;</para>
  <para style="q1" vid="PSA 55:14">i Ot pa Lubanga bene wawoto ma waribe kacel.<verse eid="PSA 55:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Wek to obin onekgi woko;</para>
  <para style="q1" vid="PSA 55:15">wek gulor piny i lyel ma pud gikwo,</para>
  <para style="q1" vid="PSA 55:15">pien tim maracu tye i dye pacogi.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Ento ka akok bot Lubanga,</para>
  <para style="q1" vid="PSA 55:16">ci Rwot bilara.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Akok bote kun acur bene,</para>
  <para style="q1" vid="PSA 55:17">i odiko, dyeceng ki otyeno;</para>
  <para style="q1" vid="PSA 55:17">pimeno en biwinyo dwona.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />En bilara dok miyo abedo ki kuc ki ilweny ma abedo kalwenyone,</para>
  <para style="q1" vid="PSA 55:18">pien jo mapol guero lweny ikoma.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Lubanga ma obedo iwi komker nia wa con</para>
  <para style="q1" vid="PSA 55:19">biwinyo kokona, dok bimiyo lewic makogi;</para>
  <para style="q1" vid="PSA 55:19">pien pe gin luwiny dok pe gilubu loke,</para>
  <para style="q1" vid="PSA 55:19">dok bene pe gitye kilworo ikom Lubanga.<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Lawota mayam ca olwenyo ikom lureme,</para>
  <para style="q1" vid="PSA 55:20">oturu cikene mayam ocike kwede woko.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Loke onongo pwot makato moo dyang,</para>
  <para style="q1" vid="PSA 55:21">ento cwinye onongo opong mere ki mony;</para>
  <para style="q1" vid="PSA 55:21">loke ducu onongo kweyo cwiny dano macalo moo,</para>
  <para style="q1" vid="PSA 55:21">ento gingolo dano macalo pala lucwan.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Kel pekoni ducu bot Rwot,</para>
  <para style="q1" vid="PSA 55:22">ci en bikonyi;</para>
  <para style="q1" vid="PSA 55:22">en pe biye ni myero kidir dano ma kite atir woko wa ki acel.<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Ento in, Ai Lubanga, ibiretogi woko piny</para>
  <para style="q1" vid="PSA 55:23">i bur matut adada;</para>
  <para style="q1" vid="PSA 55:23">gin jo ma oyo remo pa jo mukene ma gin luroro bene,</para>
  <para style="q1" vid="PSA 55:23">pe gibibedo ma gicobo nucu kare me kwogi.</para>
  <para style="q1" vid="PSA 55:23">Ento an abigeno mera in.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s1">Lega me gen ikom Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />Kica omaki ikoma, Ai Lubanga,</para>
  <para style="q1" vid="PSA 56:1">pien dano mapol gitye kalweny ikoma;</para>
  <para style="q1" vid="PSA 56:1">lumonena giuna dyeceng jwi.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Lukwora ginyona woko dyeceng jwi,</para>
  <para style="q1" vid="PSA 56:2">pien jo mapol gilwenyo ikoma.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Ka lworo omaka, Ai Lubanga,</para>
  <para style="q1" vid="PSA 56:3">ageno mera in.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Ageno Lubanga, dok apake pi loke,</para>
  <para style="q1" vid="PSA 56:4">ageno Lubanga labongo lworo mo.</para>
  <para style="q1" vid="PSA 56:4">Dano mamwani kono timo gin ango bota?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Lukwora giketo ayela dyeceng jwi pi gin ducu ma atiyo;</para>
  <para style="q1" vid="PSA 56:5">tamgi ducu tye marac pi keto arem ikoma.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Gigure woko kacel kun giliba,</para>
  <para style="q1" vid="PSA 56:6">dok guketo cwinygi me neno kit gin ducu ma atimo.</para>
  <para style="q1" vid="PSA 56:6">Kit macalo gubedo kakiya kun gimito neka woko.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Pimeno omyero ipwodgi, iculgi pi balgi;</para>
  <para style="q1" vid="PSA 56:7">ret lwak man woko piny ki akemoni, Ai Lubanga.<verse eid="PSA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />In dong ingeyo lwak ayelayela ma abedo kwede;</para>
  <para style="q1" vid="PSA 56:8">dok ibedo kaneno kit ma pig wanga cwer kwede!</para>
  <para style="q1" vid="PSA 56:8">Meno ducu pe kicoyo i buki?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Inino ma abikok iye boti,</para>
  <para style="q1" vid="PSA 56:9">lukwora kibilokogi gidok cen.</para>
  <para style="q1" vid="PSA 56:9">Man gin ma angeyo ada ni Lubanga tye kalweny pira.<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Ageno Lubanga, dok apake pi loke;</para>
  <para style="q1" vid="PSA 56:10">ageno Rwot, dok apake pi lok ma en oloko.<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Ageno Lubanga labongo lworo mo.</para>
  <para style="q1" vid="PSA 56:11">Dano mamwani kono twero timo gin ango bota?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Abicobo kwonga boti, Ai Lubanga;</para>
  <para style="q1" vid="PSA 56:12">abityero gityer me miyo pwoc boti.<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />In aye ma ilara ki i to,</para>
  <para style="q1" vid="PSA 56:13">pe iweko tyena ocer apoto piny kun imiyo ki an loc.</para>
  <para style="q1" vid="PSA 56:13">Pimeno abibedo kawot inyim Lubanga</para>
  <para style="q1" vid="PSA 56:13">i ceng meri maryeny ikom gin makwo ducu.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s1">Lega pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />Tima kica, Ai Lubanga, tima kica do,</para>
  <para style="q1" vid="PSA 57:1">pien aringo kalare boti.</para>
  <para style="q1" vid="PSA 57:1">Abiringo kalare ite tipu bwomi,</para>
  <para style="q1" vid="PSA 57:1">nio ka yamo kot ma neko piny okato.<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Akok bot Lubanga Mamalo Twal,</para>
  <para style="q1" vid="PSA 57:2">bot Lubanga macobo gin ma en oyubu pira.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Lubanga bicwalo mar mere ma pe loke, kacel ki adane,</para>
  <para style="q1" vid="PSA 57:3">en bicwalo ki i polo ci lara;</para>
  <para style="q1" vid="PSA 57:3">en biloyo lukwora ma ginyona woko pinyi,</para>
  <para style="q1" vid="PSA 57:3">dok miyo lewic makogi bene.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Abutu piny ikin labwor</para>
  <para style="q1" vid="PSA 57:4">ma guwor atika kamwodo dano.</para>
  <para style="q1" vid="PSA 57:4">Lakgi bit calo tong ki atero,</para>
  <para style="q1" vid="PSA 57:4">lebgi bene bit calo pala lucwan.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Ai Lubanga, nyut diti malo i polo,</para>
  <para style="q1" vid="PSA 57:5">dok imii deyoni oryeny iwi lobo ducu!<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Lukwora guciko owic, gimito maka;</para>
  <para style="q1" vid="PSA 57:6">cwinya dong ool woko ki can.</para>
  <para style="q1" vid="PSA 57:6">Gukwinyo bur i yoo kama awoto ki iye,</para>
  <para style="q1" vid="PSA 57:6">ento gin dok gupoto iye keken gi.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Cwinya omoko ikomi, Ai Lubanga,</para>
  <para style="q1" vid="PSA 57:7">cwinya omoko ikomi ma pe loke!</para>
  <para style="q1" vid="PSA 57:7">Abiwero wer kun apaki ki dwon malongo!<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />In tipuna, coo woko!</para>
  <para style="q1" vid="PSA 57:8">Wun nanga ki opuk bene wucoo woko!</para>
  <para style="q1" vid="PSA 57:8">An bene abicoyo rupiny miyo ceng tuc!<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Abimiyo pwoc boti ikin lwak me rok ducu, Ai Rwot;</para>
  <para style="q1" vid="PSA 57:9">abiwero wer me paki ikin lurok.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Pien mar meri ma pe loke dit, o wa i polo,</para>
  <para style="q1" vid="PSA 57:10">dok ada meri bene dit, o wa i pol.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Ai Lubanga, nyut diti malo i polo,</para>
  <para style="q1" vid="PSA 57:11">dok imii deyoni oryeny iwi lobo ducu!<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s1">Lega bot Lubanga ni opwod jo maracu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Wun tika wumoko lok ma atir, wun luloc?</para>
  <para style="q1" vid="PSA 58:1">Wun tika wungolo kop pa dano ducu ki cwiny ma atir?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Pe wa ki acel, wupiro lok maracu ki icwinywu;</para>
  <para style="q1" vid="PSA 58:2">dok wutimo bal ki timo aranyi i lobo.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Jo maracu gingak woko ikare me kwogi ducu,</para>
  <para style="q1" vid="PSA 58:3">gibalo nia ikare ma kinywalogi iye kun giloko lok goba keken.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Gitye ki kwir marac macalo kwir pa twol,</para>
  <para style="q1" vid="PSA 58:4">gidingo itgi woko akaka calo twol uyu ma dingo ite,<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />ni wek pe ewiny dwon jo ma bito twol,</para>
  <para style="q1" vid="PSA 58:5">wek pe ewiny dwon ngat ma timo tango.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Ai Lubanga, tur lakgi woko;</para>
  <para style="q1" vid="PSA 58:6">dok iput lak lutino labwor mageri woko, Ai Rwot!<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Wek gutum woko macalo pii mamol cito woko;</para>
  <para style="q1" vid="PSA 58:7">wek kinyongi piny calo lum ci gutwo woko.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Wek gubed macalo okoro ma obab woko,</para>
  <para style="q1" vid="PSA 58:8">nyo macalo latin ma kibwogo abwoga ma pe oneno ceng.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Ma pud peya gungeyo myero kitonggi woko macalo yadi okutu;</para>
  <para style="q1" vid="PSA 58:9">Lubanga omii yamo okolgi otergi woko ki kiniga madwong!<verse eid="PSA 58:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Jo ma kitgi atir gibibedo ki yomcwiny ka guneno culu kwor man;</para>
  <para style="q1" vid="PSA 58:10">dok gibilwoko tyen gi ki remo pa jo maracu.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Dano gibiwaco ni, “Adada jo ma kitgi atir gilimo pwoc;</para>
  <para style="q1" vid="PSA 58:11">adada Lubanga ma ngolo kop i lobo bene tye.”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s1">Lega pi gwok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />Lara ki i cing lukwora, Ai Lubanga,</para>
  <para style="q1" vid="PSA 59:1">gwoka ki ikom jo ma bino kalweny ikoma.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Lara ki bot jo ma lutim maracu,</para>
  <para style="q1" vid="PSA 59:2">ki ikom jo ma gioyo remo pa dano.<verse eid="PSA 59:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Nen, gubutu kun gikiya ma gimito neka woko;</para>
  <para style="q1" vid="PSA 59:3">gin jo mageri guribe woko kalweny ikoma.</para>
  <para style="q1" vid="PSA 59:3">Pe pi gin marac mo nyo bal ma an atimo, Ai Rwot,<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />pe atimo kit roc mo, ma omiyo giringo oyotoyot i kakanegi pi lweny ikoma.<verse eid="PSA 59:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />A ibin, in Rwot Lubanga me mony ci ilara;</para>
  <para style="q1" vid="PSA 59:5">dok inen gi piri keni, in Lubanga pa Icrael!</para>
  <para style="q1" vid="PSA 59:5">Coo woko ipwod lwak me rok ducu;</para>
  <para style="q1" vid="PSA 59:5">pe omyero i tim kica ki ngat mo kadi ki acel</para>
  <para style="q1" vid="PSA 59:5">ki ikom lutim roro ma gipiro lok me timo tim maracu.<verse eid="PSA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Otyeno ki otyeno gidwogo cen kun gikok calo gwogi,</para>
  <para style="q1" vid="PSA 59:6">ka giwoto kun girumu kwede gang.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Kong iwiny gin ma giwaco!</para>
  <para style="q1" vid="PSA 59:7">Lok ma i dogi bit calo pala lucwan.</para>
  <para style="q1" vid="PSA 59:7">Gitamo tam ki i cwinygi ma giwaco ni,</para>
  <para style="q1" vid="PSA 59:7">“Anga kono ma biwinyo lok ma wawaco?”<verse eid="PSA 59:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Ento in inyerogi anyera, Ai Rwot;</para>
  <para style="q1" vid="PSA 59:8">dok ingalo rok ducu angala.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />In i teka, abiwero wer me paki;</para>
  <para style="q1" vid="PSA 59:9">pien in icel gogona, Ai Lubanga.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />Lubangana ma mara ki mar mere ma pe loke bibino bota;</para>
  <para style="q1" vid="PSA 59:10">en bimiyo aneno lukwora macalo jo ma dong aloyogi woko.<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Pe inekgi woko, miyo lutuwa wigi wil;</para>
  <para style="q1" vid="PSA 59:11">ketgi woko ata ki tweroni ci ityekgi woko,</para>
  <para style="q1" vid="PSA 59:11">Ai Rwot, in kwotwa!<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Doggi opong ki bal,</para>
  <para style="q1" vid="PSA 59:12">giloko lok me bal keken;</para>
  <para style="q1" vid="PSA 59:12">mi gumok woko i owic pi wakegi!</para>
  <para style="q1" vid="PSA 59:12">Pi lok me ceno dano ki goba ma gin loko,<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />myero ityekgi woko ki akemoni;</para>
  <para style="q1" vid="PSA 59:13">tyekgi wang ma gutum woko liweng.</para>
  <para style="q1" vid="PSA 59:13">Man bimiyo lwak ducu ngeyo ni,</para>
  <para style="q1" vid="PSA 59:13">Lubanga aye maloyo jo pa Yakobo nio i agiki lobo.<verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Otyeno ki otyeno gidwogo cen, kun gikok calo gwogi,</para>
  <para style="q1" vid="PSA 59:14">ka giwoto girumu kwede gang.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Giwoto atata giyenyo cam,</para>
  <para style="q1" vid="PSA 59:15">gibedo kangur angura ka peya guyeng.<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Ento an abiwero wer ma apaki kwede pi teki,</para>
  <para style="q1" vid="PSA 59:16">abiwero wer ki dwon malongo odiko con pi mar meri ma pe loke.</para>
  <para style="q1" vid="PSA 59:16">In aye ibedo cel gogona,</para>
  <para style="q1" vid="PSA 59:16">dok in kalarena inino ma atye ki can.<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />In i teka, abiwero wer me paki, pien in icel gogona, Ai Lubanga,</para>
  <para style="q1" vid="PSA 59:17">in Lubanga ma imara ki mar ma pe loke.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s1">Lega pi kony ki i cing lukwor</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />Ai Lubanga, ikwerowa woko do dok iloyowa;</para>
  <para style="q1" vid="PSA 60:1">nene kiniga omaki ikomwa.</para>
  <para style="q1" vid="PSA 60:1">Aya, ye wadwog boti do!<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Imiyo lobo oyenge, ibaro dyere woko;</para>
  <para style="q1" vid="PSA 60:2">yub kama obarri, pien yenge, matye kapoto apota woko.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Imiyo lwaki gulimo arem me can matego;</para>
  <para style="q1" vid="PSA 60:3">imiyowa kongo bwino wamato, wamer ma wabange woko calo lumero kongo.<verse eid="PSA 60:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Ingabo bendera malo pi ciko jo ma gilwori,</para>
  <para style="q1" vid="PSA 60:4">wek guring iye gulare ki ilak atum.<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Larwa ki teki imii walo lukworwa, dok igam legawa,</para>
  <para style="q1" vid="PSA 60:5">wek lwak ma imaroni gubwot.<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Lubanga oloko ki ikabedone maleng ni,</para>
  <para style="q1" vid="PSA 60:6">“Abipoko Cekem woko kideyo madit me loc,</para>
  <para style="q1" vid="PSA 60:6">dok abipoko nota me Cukot woko i dul ki dul bot jona.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Gilead mera, ki Manace bene mera;</para>
  <para style="q1" vid="PSA 60:7">Epraim aye tok nyonyo me wiya, ki Juda mere odo kera.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Ento Moab aye becen me lwoka;</para>
  <para style="q1" vid="PSA 60:8">ki Edom mera, obedo kabolo war tyena;</para>
  <para style="q1" vid="PSA 60:8">dok abidange matek me loc ikom jo Piliciti.”<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Anga ma bikelo an i gang man ma kirumu ki cel gogoni?</para>
  <para style="q1" vid="PSA 60:9">Anga ma bitelo wiya tera i Edom?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />In mono pe dong ikwerowa woko, Ai Lubanga?</para>
  <para style="q1" vid="PSA 60:10">In pe dong icito kacel ki dul monywa kalweny, Ai Lubanga.<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Konywa me lweny ikom lukworwa,</para>
  <para style="q1" vid="PSA 60:11">pien kony ma dano miyo pe gin mo!<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Ka Lubanga tye kalweny kacel kwedwa ci wabiloyo;</para>
  <para style="q1" vid="PSA 60:12">en aye ma binyono lukworwa diyogi woko piny.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s1">Lega pi gwok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />Winy kokona, Ai Lubanga,</para>
  <para style="q1" vid="PSA 61:1">dok iwiny legana.<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Akok boti ki kamabor, ki i agiki lobo,</para>
  <para style="q1" vid="PSA 61:2">ka cwinya dong odem woko.</para>
  <para style="b" vid="PSA 61:2" />
  <para style="q1" vid="PSA 61:2">Tela itera ikom got mabor kagwokena;<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />pien in aye kalarena,</para>
  <para style="q1" vid="PSA 61:3">in wir matek me gwoka ki ikom lukwora.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Wek abed i kemani nakanaka!</para>
  <para style="q1" vid="PSA 61:4">Wek akane ite bwomi abed iye ki gwok ma oromo!<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />In dong ityeko winyo lok me kwong mera, Ai Lubanga,</para>
  <para style="q1" vid="PSA 61:5">dok ityeko miya gipiny pa jo ma gilworo nyingi.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Med mwaka mapol ikom nino me kwo pa rwot;</para>
  <para style="q1" vid="PSA 61:6">wek obed kwo nakanaka ikare pa yalwak ducu!<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Mii en obed iwi komkere matye inyimi nakanaka, Ai Lubanga;</para>
  <para style="q1" vid="PSA 61:7">dok igwoke ki mar meri ma pe loke, pien in Lubanga ma lagen icobo cike meri kakare.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Pimeno abiwero wer me pako nyingi,</para>
  <para style="q1" vid="PSA 61:8">kun acobo bene kwong ma mera ma akwongo inyimi nino ki nino.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s1">Bedo ki gen i gwok ma Lubanga aye miyo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />An abedo gira mot kena kun akuru Lubanga ki cwinya ducu;</para>
  <para style="q1" vid="PSA 62:1">pien lar ma mera a ki bote.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />En kene aye got ki Lalara,</para>
  <para style="q1" vid="PSA 62:2">en aye cel gogo ma gwoka, pe kibidira cen wa ki acel.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Wun ducu mono wubiero lweny ikom dano pi kare marom mene,</para>
  <para style="q1" vid="PSA 62:3">wek wuloye woko calo cel madong cok poto?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Giyubu lok me kwanye woko ki irwom me dito wek kidwoke piny.</para>
  <para style="q1" vid="PSA 62:4">Ginongo yomcwiny iloko lok goba.</para>
  <para style="q1" vid="PSA 62:4">Gin lamo gum ikom dano ki lok doggi nono,</para>
  <para style="q1" vid="PSA 62:4">ento ki i cwinygi giceno dano acena.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Ageno mera Lubanga keken ma nongo abedo aling gira mot,</para>
  <para style="q1" vid="PSA 62:5">pien gena ducu a ki bote.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />En aye got ki lalara,</para>
  <para style="q1" vid="PSA 62:6">en cel gogo ma gwoka, pe kibiyenga wa ki acel.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Larena kacel kideyona ducu tye bot Lubanga;</para>
  <para style="q1" vid="PSA 62:7">en aye gota matek, dok en aye kalarena.<verse eid="PSA 62:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Wun dano, wugen Lubanga kare ducu,</para>
  <para style="q1" vid="PSA 62:8">wutite lok ducu matye i cwinywu woko bote;</para>
  <para style="q1" vid="PSA 62:8">Lubanga aye kalarewa.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Dano ma rwomgi piny gibedo calo yamo me yweyo mamwa,</para>
  <para style="q1" vid="PSA 62:9">dok jo matye ki rwom mamalo bene obedo gin ma konye peke.</para>
  <para style="q1" vid="PSA 62:9">Ka kipimogi i mijan,</para>
  <para style="q1" vid="PSA 62:9">gin ducu kacel nongo giyot maloyo yamo me yweyo.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Pe wuket genwu ikom tim me bumu dano,</para>
  <para style="q1" vid="PSA 62:10">pe wugen tim me yak, pien konye peke;</para>
  <para style="q1" vid="PSA 62:10">kadi bed lonyowu tye kamede,</para>
  <para style="q1" vid="PSA 62:10">pe wuket cwinywu iye.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Lubanga oloko lok makato tyen acel woko ni</para>
  <para style="q1" vid="PSA 62:11">en aye ewon twero;<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />dok ni en Rwot aye i won mar ma pe loke.</para>
  <para style="q1" vid="PSA 62:12">In giri iculu dano acel acel muporo kit tice.<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s1">Kee me bedo cok ki Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />Ai Lubanga, in Lubangana, kee me bedo cok kwedi tye kaneka,</para>
  <para style="q1" vid="PSA 63:1">kwona ducu paro piri;</para>
  <para style="q1" vid="PSA 63:1">koma dong gomo piri atika,</para>
  <para style="q1" vid="PSA 63:1">calo i lobo mutwo, ma ool, ma gomo pii.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Pimeno abedo kayenyi i kabedoni maleng,</para>
  <para style="q1" vid="PSA 63:2">pi neno tweroni kacel kideyoni.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Pien mar meri ma pe loke ber kato kwo,</para>
  <para style="q1" vid="PSA 63:3">pimeno abipaki gira kare ducu.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Abipwoyi pi kare me kwona ducu;</para>
  <para style="q1" vid="PSA 63:4">abikok boti kun atango cinga.<verse eid="PSA 63:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Kwona biyeng calo acamo moo ma i cogo ki moo dwolo,</para>
  <para style="q1" vid="PSA 63:5">abiwero wer kun apaki ki yomcwiny madwong.<verse eid="PSA 63:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Kadi ka atye iwi kitandana wiya po ikomi,</para>
  <para style="q1" vid="PSA 63:6">dok abedo kalwodo lok ikomi dyewor benebene;<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />pien in ibedo lakonya ikare ducu,</para>
  <para style="q1" vid="PSA 63:7">dok akane i tipu te bwomi kun awero wer ki yomcwiny.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Amoko ikomi woko liking,</para>
  <para style="q1" vid="PSA 63:8">ci igwoka woko maber ki cingi ma lacuc.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Ento jo ma giyenya ma gimito neka</para>
  <para style="q1" vid="PSA 63:9">gibidonyo gicito piny ite ngom matut.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Kibinekogi woko ilweny ki pala lucwan,</para>
  <para style="q1" vid="PSA 63:10">gibidoko cam pa too me tim.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Ento rwot bibedo mere ki yomcwiny pi Lubanga;</para>
  <para style="q1" vid="PSA 63:11">jo ducu ma gikwongo kwong ki nying Lubanga gibipake;</para>
  <para style="q1" vid="PSA 63:11">ento jo ma lugoba kibiumu doggi woko lipuk.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s1">Lega pi gwok</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Winy dwona ma akok kwede boti, Ai Lubanga;</para>
  <para style="q1" vid="PSA 64:1">an atye ki can, lar kwona do ki i cing lukwora!<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Gwoka ki ikom lok pa jo maracu ma gipiro ikoma i mung,</para>
  <para style="q1" vid="PSA 64:2">konya ikom lwak lutim maracu.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Gipako lebgi calo gipako pala lucwan,</para>
  <para style="q1" vid="PSA 64:3">ma giketo cwinygi iloko lok makec calo lak atero ma kicelo ki atum.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Komgi mit kaboko lokgi me gobani kun gimiyo ngece oyotoyot dok lewic mo pe makogi wa ki acel;</para>
  <para style="q1" vid="PSA 64:4">wek gityek jo mabeco i yo me lworo ki keto lok roro ikomgi.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Tamgi omoko liking ikom gin marac ma giparo ni omyero gitim;</para>
  <para style="q1" vid="PSA 64:5">nen gitye kalok keken gi pi ciko owicgi i mung,</para>
  <para style="q1" vid="PSA 64:5">kun giwaco ni, “Anga matwero nenowa?<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Anga kono matwero yenyo balwa wek enong?</para>
  <para style="q1" vid="PSA 64:6">Wabedo ki tam me ryeko omiyo wapiro lok ma pe wace.”</para>
  <para style="q1" vid="PSA 64:6">Dong gin matye itam ki i cwiny dano niang iye tek,</para>
  <para style="q1" vid="PSA 64:6">pien tye kamatut!<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Ento Lubanga bicelo aterone cito ikomgi;</para>
  <para style="q1" vid="PSA 64:7">ci gibilimo rete cutcut.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />En bityekogi woko matwal pi lokgi ma guloko;</para>
  <para style="q1" vid="PSA 64:8">ci dano ducu ma binenogi gibiyengo wigi.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Bimiyo jo ducu gibedo ki lworo;</para>
  <para style="q1" vid="PSA 64:9">ci gibitito pi gin ma Lubanga otimo,</para>
  <para style="q1" vid="PSA 64:9">kun gitamo bene mot pi gin ma en otyeko tiyone.<verse eid="PSA 64:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Wek jo ma kitgi atir gubed ki yomcwiny i Rwot,</para>
  <para style="q1" vid="PSA 64:10">dok guring gular bote,</para>
  <para style="q1" vid="PSA 64:10">wek jo ducu ma cwinygi atir gupake.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s1">Pak ki pwoc bot Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Dano myero gupaki i Cion, Ai Lubanga;</para>
  <para style="q1" vid="PSA 65:1">dok myero gumini gin ducu mayam gukwongo pire,<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />pien in aye ma igamo lega pa jo ducu.</para>
  <para style="q1" vid="PSA 65:2">Dano ducu gibia gibino boti ki i lobo weng.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Ka balwa ma watimo dong obwoyowa,</para>
  <para style="q1" vid="PSA 65:3">in itimowa kica ci iweko balwa.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Dano ma iyero ci ikwanyo ikelo cok boti tye ki gum,</para>
  <para style="q1" vid="PSA 65:4">me bedo idyekal meri i kabedoni maleng.</para>
  <para style="q1" vid="PSA 65:4">Wabiyeng ki jami ducu mabeco matye i odi,</para>
  <para style="q1" vid="PSA 65:4">ma en aye kabedoni maleng.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Gam legawa, Ai Lubanga Lalarwa,</para>
  <para style="q1" vid="PSA 65:5">ilarowa kun itiyo jami madito me aura makelo lworo.</para>
  <para style="q1" vid="PSA 65:5">Jo ducu ma gibedo i lobo gigeno in,</para>
  <para style="q1" vid="PSA 65:5">kadi wa jo ma gibedo kama lobo ogik iye,</para>
  <para style="q1" vid="PSA 65:5">ki jo ma gibedo kamabor wa i agiki nam.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />In ma icibo godi ocung matek i kabedogi ki teki,</para>
  <para style="q1" vid="PSA 65:6">ma iruke woko ki tweroni madwong.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />In aye ma ijuku mor pa nam ki twage me biamwonyi bene;</para>
  <para style="q1" vid="PSA 65:7">dok ijuku woo pa lwak me rok ducu.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Ma omiyo dano ducu ma gibedo kamabor iwang apoki me agiki lobo</para>
  <para style="q1" vid="PSA 65:8">gitye ki lworo pi lanyut ma itiyo;</para>
  <para style="q1" vid="PSA 65:8">dok imiyo lwak gigoyo kijira pi yomcwiny</para>
  <para style="q1" vid="PSA 65:8">cake tung kunyango o kwede wa i tung kupotoceng.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />I maro lobo omiyo kot cwer iye,</para>
  <para style="q1" vid="PSA 65:9">imiyo lobo oceko cam mabup;</para>
  <para style="q1" vid="PSA 65:9">kuluni ducu ma iketo pong woko ki pii;</para>
  <para style="q1" vid="PSA 65:9">in bene ma imiyo bel cek, pien in yam iyubu kumeno.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Imiyo kot cwer bino i poti ma kipuru ki kweri dyang,</para>
  <para style="q1" vid="PSA 65:10">dok ipiro ngom mutinge ma idyere woko maber,</para>
  <para style="q1" vid="PSA 65:10">imiyo kot cwer iye madwong ci obido woko,</para>
  <para style="q1" vid="PSA 65:10">dok imiyo gum ikom kodi ducu ma i poto gitwi gidongo maber.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Mwaka ki mwaka imiyo cam cek bot dano madwong pi gum ma imiyo;</para>
  <para style="q1" vid="PSA 65:11">kabedo ducu ma i wok ki iye pong ki lonyo.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Olet ma i tim ducu lum lot mabup iye,</para>
  <para style="q1" vid="PSA 65:12">iweko wi cere ducu gibedo ki yomcwiny madwong.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Olet ducu pong ki lwak romi mapol ma pe wace;</para>
  <para style="q1" vid="PSA 65:13">notagu ducu pong ki kal matye kadongo iye,</para>
  <para style="q1" vid="PSA 65:13">ma gigoyo kijira ma giwero wer kacel ki yomcwiny.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s1">Wer me pak ki pwoc bot Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Wun jo ducu ma wubedo iwi lobo,</para>
  <para style="q1" vid="PSA 66:1">wugo kijira bot Lubanga ki yomcwiny;<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />wuwer wer me pak ki me deyo pi woro nyinge,</para>
  <para style="q1" vid="PSA 66:2">wupake ki pak me deyo madit adada!<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Wuwac bot Lubanga ni,</para>
  <para style="q1" vid="PSA 66:3">“Gin me aura ducu ma itiyo kelo lworo madit mada!</para>
  <para style="q1" vid="PSA 66:3">Tweroni giri dit adada,</para>
  <para style="q1" vid="PSA 66:3">miyo lumoneni ducu gimwole amwola inyimi.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Dano ducu ma i lobo giworo in;</para>
  <para style="q1" vid="PSA 66:4">giwero wer me paki,</para>
  <para style="q1" vid="PSA 66:4">giwero wer ma gipako nyingi.”<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Wubin, wunen gin ma Lubanga otiyo.</para>
  <para style="q1" vid="PSA 66:5">En otiyo gin makelo lworo mada ikin dano.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:6: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Nia 14:21</ref>; <ref loc="JOS 3:14-17">Yoc 3:14-17</ref></char>
    </note>En oloko nam odoko ngom mutwo;</para>
  <para style="q1" vid="PSA 66:6">omiyo dano guwoto ki tyen gi ki i dye kulu gukato loka tungcel,</para>
  <para style="q1" vid="PSA 66:6">ma omiyo wabedo ki yomcwiny pi gin ma en otiyo kunu.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />En loyo loc nakanaka ki tek me twerone,</para>
  <para style="q1" vid="PSA 66:7">dok ociko wange me neno rok ducu.</para>
  <para style="q1" vid="PSA 66:7">Jo ma gin lujemo myero pe guwake.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Wupwo Lubanga, wun lwak me rok ducu,</para>
  <para style="q1" vid="PSA 66:8">wuwek dwon me pak ma wupake kwede owinye.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />En ma ogwokowa omiyo pud wakwo,</para>
  <para style="q1" vid="PSA 66:9">dok pe oweko kiloyowa kadi ki acel.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />In dong ityeko temowa, Ai Lubanga;</para>
  <para style="q1" vid="PSA 66:10">dong itemowa macalo ryal ma kiliyo imac.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Ikelowa imiyo wamoko i obwo;</para>
  <para style="q1" vid="PSA 66:11">dok bene imiyowa yec mapek ni wating.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Iweko lukworwa gingweco ginyono wiwa woko piny;</para>
  <para style="q1" vid="PSA 66:12">wawoto ki i dye mac wa i dye pii,</para>
  <para style="q1" vid="PSA 66:12">ento in dong ikelowa wao ikabedo ma opong ki jami mabeco.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Abibino i odi kun akelo boti gityer me gitum awanga;</para>
  <para style="q1" vid="PSA 66:13">abicobo kwonga inyimi kun amiyi gin mayam acike pire.<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />Abimiyo gin madong awaco kidoga ni abimini,</para>
  <para style="q1" vid="PSA 66:14">gin ma acike pire ikare ma onongo atye i can.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Abityero boti gitum awanga me lee makwo ma gucwe,</para>
  <para style="q1" vid="PSA 66:15">dok abidunyu boti yito mac ma kiwango ki gitum me nyogi romi;</para>
  <para style="q1" vid="PSA 66:15">abityero boti twoni dyangi kacel ki dyegi.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Wubin wuwiny, wun jo ducu ma wulworo Lubanga,</para>
  <para style="q1" vid="PSA 66:16">ci abitito botwu gin ma Lubanga otiyo pira.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Ceng akok bote matek,</para>
  <para style="q1" vid="PSA 66:17">dok bene apake ki wer pi dworo nyinge.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Ka nene aumu bala i cwinya,</para>
  <para style="q1" vid="PSA 66:18">kono Rwot pe owinyo kokona wa ki acel.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Adada Lubanga dong owinyo kokona;</para>
  <para style="q1" vid="PSA 66:19">dong owinyo legana ducu.<verse eid="PSA 66:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Kipwo Lubanga,</para>
  <para style="q1" vid="PSA 66:20">pien pe okwero winyo legana,</para>
  <para style="q1" vid="PSA 66:20">dok bene pe okwanyo mar mere ma pe loke woko ki ikoma.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s1">Wer me miyo pwoc bot Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />Lubanga onyut ki wan kicane dok omii ki wan gum,</para>
  <para style="q1" vid="PSA 67:1">ci onenwa bene ki wang me kica,<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />wek dano ma i lobo ducu gunge miti;</para>
  <para style="q1" vid="PSA 67:2">wek rok ducu onge lok me lari ki tweroni makelo lare bot jo ducu.<verse eid="PSA 67:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Mii rok ducu ma iwi lobo gupaki, Ai Lubanga;</para>
  <para style="q1" vid="PSA 67:3">wek lwak me rok ducu gupaki!<verse eid="PSA 67:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Wek lurok ducu cwinygi obed yom kun giwero wer me pwoc ki yomcwiny,</para>
  <para style="q1" vid="PSA 67:4">pien in aye ingolo kop pa rok ducu ikit mupore,</para>
  <para style="q1" vid="PSA 67:4">dok in aye ma itye katelo rok me wi lobo ducu.<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Mii rok ducu ma iwi lobo gupaki, Ai Lubanga;</para>
  <para style="q1" vid="PSA 67:5">wek lwak me rok ducu gupaki!<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Lobo dong oceko cam mabup;</para>
  <para style="q1" vid="PSA 67:6">Lubanga ma Lubangawa dong omiyowa gum.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Lubanga dong omiyowa gum;</para>
  <para style="q1" vid="PSA 67:7">pimeno dano ducu ma i lobo myero guwore.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s1">Wer me loc</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />Wek Lubanga oa malo, ci oket lukwore woko atata;</para>
  <para style="q1" vid="PSA 68:1">wek jo ma lukwore ducu guring woko ki inyime pi loc ma en oloyo!<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Macalo yito duny cito woko,</para>
  <para style="q1" vid="PSA 68:2">gin bene gibirwenyo woko kitmeno;</para>
  <para style="q1" vid="PSA 68:2">macalo odok kic leny woko ka kiketo inget mac,</para>
  <para style="q1" vid="PSA 68:2">wek jo maracu bene guto woko inyim Lubanga kitmeno!<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Ento wek jo ma kitgi atir gubed ki yomcwiny;</para>
  <para style="q1" vid="PSA 68:3">wek gunyate ki yomcwiny madwong inyim Lubanga;</para>
  <para style="q1" vid="PSA 68:3">wek gudange ma yomcwiny mito nekogi woko!<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Wuwer bot Lubanga, wuwer wer wupak nyinge;</para>
  <para style="q1" vid="PSA 68:4">wuil dwonwu malo ki wer bot en</para>
  <para style="q1" vid="PSA 68:4">matye kangwec ki gadigadine iwi pol;</para>
  <para style="q1" vid="PSA 68:4">nyinge Rwot, wudwore, dok wubed ki yomcwiny inyime!<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />Lubanga, en won jo ma won gi peke, dok en bene magwoko mon to;</para>
  <para style="q1" vid="PSA 68:5">en Lubanga ma bedo i ot mere maleng.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Lubanga miyo paco bot jo mudong ken gi mapiny oloyo, wek gubed iye;</para>
  <para style="q1" vid="PSA 68:6">en aye ma kwanyo mabuc woko ki i ot kol mot maber miyo gibedo ki kuc;</para>
  <para style="q1" vid="PSA 68:6">ento jo ma gin lujemo gibedo i lobo mutwo.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Ai Lubanga, ikare ma itelo wi lwaki,</para>
  <para style="q1" vid="PSA 68:7">ikare ma iwoto kwedgi ki i dye tim,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:18">Nia 19:18</ref>
      </char>
    </note>ngom oyenge, kot bene oa ki i polo ocore i lobo,</para>
  <para style="q1" vid="PSA 68:8">got Cinai bene oyenge inyim Lubanga;</para>
  <para style="q1" vid="PSA 68:8">oyenge inyim Lubanga,</para>
  <para style="q1" vid="PSA 68:8">ma en Lubanga pa jo Icrael.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Imiyo kot madwong ocwer i lobo, Ai Lubanga;</para>
  <para style="q1" vid="PSA 68:9">ci iroco loboni ma ool woko odoco.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Lwaki gubedo iye macalo pacogi;</para>
  <para style="q1" vid="PSA 68:10">dok bene pi beri, Ai Lubanga,</para>
  <para style="q1" vid="PSA 68:10">ipito jo mapiny obwoyogi ki cam.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Rwot omiyo cik,</para>
  <para style="q1" vid="PSA 68:11">dong mon mapol gukubu lok maber meno oweko onya kun giwaco ni,<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />“Luker kacel ki monygi gitye karingo woko aringa!”</para>
  <para style="q1" vid="PSA 68:12">Mon ma gudong paco gupoko jami ma kiyako woko ikin gi.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Kadi ma gibutu i dwol romi,</para>
  <para style="q1" vid="PSA 68:13">ginen calo akuri ma kideyo bwome ki ryal,</para>
  <para style="q1" vid="PSA 68:13">dok yece kideyo ki jabu ma obedo alumalum.</para>
  <para style="q1" vid="PSA 68:13">(Pingo jo mogo ikinwu obutu i dwol romo ikare me cito kalweny?)<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Ma Lubanga Matwero ducu oketo luker woko iwi got Jalmon,</para>
  <para style="q1" vid="PSA 68:14">ci omiyo pee bene ocwer kunu.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Got Bacan kara tek kuman,</para>
  <para style="q1" vid="PSA 68:15">got ma lacol wiye pol,</para>
  <para style="q1" vid="PSA 68:15">en got me Bacan!<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Pingo wun jo ma bedo iwi got Bacan wuneno ki nyeko ikom</para>
  <para style="q1" vid="PSA 68:16">got ma Lubanga oyero me bedo iyeni?</para>
  <para style="q1" vid="PSA 68:16">Eyo, ento Rwot bibedo kunu gire matwal!<verse eid="PSA 68:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Rwot oa ki i got Cinai bino i kabedone maleng,</para>
  <para style="q1" vid="PSA 68:17">en obino ki lwak gadigadi matego maromo alip ki alip.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:18: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:8">Epe 4:8</ref>
      </char>
    </note>Lubanga oito wa iwi got malo, kama Ot pa Lubanga tye iye</para>
  <para style="q1" vid="PSA 68:18">kun coko jo ma kimakogi i dog lweny cito kwedgi;</para>
  <para style="q1" vid="PSA 68:18">dok obedo kagamo mot ki bot dano,</para>
  <para style="q1" vid="PSA 68:18">kadi wa ki bot jo mayam gujemo woko.</para>
  <para style="q1" vid="PSA 68:18">Rwot Lubanga dong bibedo kunu.<verse eid="PSA 68:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Kipak Rwot, pien nino ki nino</para>
  <para style="q1" vid="PSA 68:19">en tingowa wa ki pekowa ducu ikore;</para>
  <para style="q1" vid="PSA 68:19">Lubanga aye lalarwa.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Lubangawa en Lubanga me lar;</para>
  <para style="q1" vid="PSA 68:20">en Rwot Lubangawa, ma larowa ki i to.<verse eid="PSA 68:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Ento Lubanga bigoyo wi lukwore turu woko,</para>
  <para style="q1" vid="PSA 68:21">bigoyo wi dano ma yer wigi bocogu ma gilubu timgi me bal.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Rwot owaco ni,</para>
  <para style="q1" vid="PSA 68:22">“Abidwoko lukworwu cen ki i Bacan;</para>
  <para style="q1" vid="PSA 68:22">abiwotogi woko kamaleng ki ite nam matut,<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />wek wubin wulwok tyenwu ki remogi,</para>
  <para style="q1" vid="PSA 68:23">wek gwogiwu bene gunang remo pa lukworwu madwong macalo gimito.”<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Ai Lubanga, jo ducu gitye kaneno kit ma i dore kwede kacel ki lwaki,</para>
  <para style="q1" vid="PSA 68:24">dore pa Lubangana, Lakera, ma cito kwede i kabedone maleng.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Luwer gutelo nyim, lugo wer gudong i ngec,</para>
  <para style="q1" vid="PSA 68:25">ka dong anyira ma gigoyo ajaa gubedo idyere.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Onongo gubedo kawer ni, “Kipak Lubanga i coke madit pa lwake,</para>
  <para style="q1" vid="PSA 68:26">wupak Rwot, wun likwayo pa Icrael ducu!”<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Ma otelo yoo bino ca ni aye Benjamin, ma en kaka matidi loyo,</para>
  <para style="q1" vid="PSA 68:27">ka dok rwodi me Juda ki lwakgi madwong gulubu,</para>
  <para style="q1" vid="PSA 68:27">ka dong rwodi me Jabulon ki rwodi me Naputali i korgi.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Nyut tweroni, Ai Lubanga;</para>
  <para style="q1" vid="PSA 68:28">nyut teki, en tek ma itiyo kwede pirwani.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Pi odi matye i Jerucalem,</para>
  <para style="q1" vid="PSA 68:29">omiyo luker gikelo mot gityero boti.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Juk Ejipt, ma en lee tim mager ma bedo ikin lagada,</para>
  <para style="q1" vid="PSA 68:30">ma en lwak twoni ki lutino dyangigi.</para>
  <para style="q1" vid="PSA 68:30">Nyon jo ma yenyo lim ajog woko piny ki tyeni,</para>
  <para style="q1" vid="PSA 68:30">ket lwak me rok ma cwinygi yom pi lwenygu woko ata.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Wek kikel mola ki i Ejipt;</para>
  <para style="q1" vid="PSA 68:31">dok wek jo Etiopia gubin oyotoyot kun giilo cinggi malo ma guryeyo bot Lubanga ka gilego bote.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Wuwer wer bot Lubanga, wun ker ducu ma iwi lobo;</para>
  <para style="q1" vid="PSA 68:32">wuwer wer me pak bot Rwot;<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Wuwer wer bot en matye kawot iwi polo,</para>
  <para style="q1" vid="PSA 68:33">en wi polo macon; winy, en tye kadange ki dwon mamor kiteko adada.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Wutit pi twero pa Lubanga,</para>
  <para style="q1" vid="PSA 68:34">ma en ngat madit ma loce tye i Icrael,</para>
  <para style="q1" vid="PSA 68:34">ma twerone bene tye malo i polo.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Lubanga me aura makelo lworo tye i kabedone maleng,</para>
  <para style="q1" vid="PSA 68:35">en Lubanga pa Icrael,</para>
  <para style="q1" vid="PSA 68:35">mamiyo twero ki tek bot jone.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q1" vid="PSA 68:35">Kipwo Lubanga!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s1">Koko pi kony ki i can</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />Lara, Ai Lubanga!</para>
  <para style="q1" vid="PSA 69:1">Nen pii dong omwonya woko oo wa i nguta.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Atye kalwiny woko i coto kamatut,</para>
  <para style="q1" vid="PSA 69:2">kama gin mo peke ma atwero cung ikome;</para>
  <para style="q1" vid="PSA 69:2">atye kamwony woko i pii matut,</para>
  <para style="q1" vid="PSA 69:2">ki biamwonyi me pii ma twage bene kato ki i ka wiya kun acok ki mwony.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Dong aol woko ki koko pi kony,</para>
  <para style="q1" vid="PSA 69:3">dwona dong okak woko.</para>
  <para style="q1" vid="PSA 69:3">Wanga bene dong ocido woko,</para>
  <para style="q1" vid="PSA 69:3">pi kuru kony ma a ki bot Lubangana.<verse eid="PSA 69:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:19">Jab 35:19</ref>; <ref loc="JHN 15:25">Jon 15:25</ref></char>
    </note>Jo ma daga nonono labongo tyen lok mo</para>
  <para style="q1" vid="PSA 69:4">gipol ma gikato yer wiya woko.</para>
  <para style="q1" vid="PSA 69:4">Jo ma gin lukwora ma giloko lok goba pi lweny ikoma;</para>
  <para style="q1" vid="PSA 69:4">gitek dok gimito neka woko.</para>
  <para style="q1" vid="PSA 69:4">Gimito adwok jami ma pe akwalo akwala cen</para>
  <para style="q1" vid="PSA 69:4">kadi pe akwalo gin mo.<verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Bala ducu ma atiyo, Ai Lubanga, pe okane ki boti wa ki acel;</para>
  <para style="q1" vid="PSA 69:5">in giri ingeyo mingona liweng.<verse eid="PSA 69:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Pe iwek aket lewic ikom jo ma geno in,</para>
  <para style="q1" vid="PSA 69:6">Ai Rwot Lubanga Matwero ducu!</para>
  <para style="q1" vid="PSA 69:6">Dok pe iwek akel lewic ikom dano ma giworo in.</para>
  <para style="q1" vid="PSA 69:6">Ai Lubanga pa Icrael!<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Aciro yet madwong mada pi nyingi,</para>
  <para style="q1" vid="PSA 69:7">omiyo lewic oumu wanga woko lipuk.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Adoko calo larok bot utmegina,</para>
  <para style="q1" vid="PSA 69:8">dok macalo ngat ma labedo ki bot lutino awobe pa maa.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:9: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:17">Jon 2:17</ref>; <ref loc="ROM 15:3">Rom 15:3</ref></char>
    </note>Arima pi odi mito neka woko ma wang i iya calo mac;</para>
  <para style="q1" vid="PSA 69:9">dok yet pa dano ma gin yeti kwede bene dong otyeko poto ikoma.<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Ikare ma amwole kena i cwinya kun arii kec,</para>
  <para style="q1" vid="PSA 69:10">meno odoko lok anywar ikoma.<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />Ikare ma abedo karuke ki bongo cola,</para>
  <para style="q1" vid="PSA 69:11">aloke adoko lok aboka ikin gi.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Jo ma bedo i dog cel gibedo kaloko lok ikoma ma pe wace,</para>
  <para style="q1" vid="PSA 69:12">lumero bene giwera awera ki wer.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Ento kitung bota, abikelo legana boti, Ai Rwot.</para>
  <para style="q1" vid="PSA 69:13">Gam legana ikare ma iyero, Ai Lubanga.</para>
  <para style="q1" vid="PSA 69:13">Gam legana pi mar meri madwong ma pe loke,</para>
  <para style="q1" vid="PSA 69:13">pien igwoko cikeni pi laro joni.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Lara wek pe alwiny woko i coto;</para>
  <para style="q1" vid="PSA 69:14">lara ki i cing lukwora,</para>
  <para style="q1" vid="PSA 69:14">lara bene ki i pii matut.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Pe iwek biamwonyi otwage</para>
  <para style="q1" vid="PSA 69:15">omwony wiya woko;</para>
  <para style="q1" vid="PSA 69:15">pe iwek amwony woko i pii matut</para>
  <para style="q1" vid="PSA 69:15">nyo kadi ki donyo piny i bur lyel.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />Gam doga, Ai Rwot, pien mar meri ma pe loke ber;</para>
  <para style="q1" vid="PSA 69:16">loke bota pi kicani madwong.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Pe ikane woko ki bot latic ma megi;</para>
  <para style="q1" vid="PSA 69:17">gam doga oyotoyot kombedi, pien atye i can.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Nyik cok bota i koka,</para>
  <para style="q1" vid="PSA 69:18">ci lara ki i cing lukwora.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Ingeyo kit anywar ducu ma kinywara kwede,</para>
  <para style="q1" vid="PSA 69:19">ki kit ma kimiya kwede lewic marac mada;</para>
  <para style="q1" vid="PSA 69:19">dong in ingeyo lumonena ducu.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Cwinya obale woko pi yet ma kiyeta kwede,</para>
  <para style="q1" vid="PSA 69:20">omiyo dong pe atye ki kit gen mo.</para>
  <para style="q1" vid="PSA 69:20">Ayenyo ngat matwero nyutu kicane ikoma, ento pe anongo;</para>
  <para style="q1" vid="PSA 69:20">ayenyo jo ma omyero gukwe cwinya ci pe anongo ngat mo.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:21: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:48">Mat 27:48</ref>; <ref loc="MRK 15:36">Mar 15:36</ref>; <ref loc="LUK 23:36">Luk 23:36</ref>; <ref loc="JHN 19:28-29">Jon 19:28-29</ref></char>
    </note>Gumiya kwir marac ma kaka cam,</para>
  <para style="q1" vid="PSA 69:21">dok ikare ma orwo pii oneka gumiya kongo bwino mawace ni amati.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:22: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 11:9-10">Rom 11:9-10</ref>
      </char>
    </note>Wek karamagi ma gicamoni otyekgi woko macalo owic;</para>
  <para style="q1" vid="PSA 69:22">karama me gityer ma gicamoni myero oloke odok owic ma makogi.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Mii wanggi ocore woko, wek pe gunen piny;</para>
  <para style="q1" vid="PSA 69:23">mi pyergi onyonge obed ka myel amyela nakanaka.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Too akemoni woko ducu ikomgi,</para>
  <para style="q1" vid="PSA 69:24">mii kinigani ma lyeti otyekgi woko.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:25: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Tic 1:20</ref>
      </char>
    </note>Mii gonygi odok obur,</para>
  <para style="q1" vid="PSA 69:25">pe iwek ngati mo odong obed i kemagi.<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Giyelo dano ma in dong ityeko pwodo,</para>
  <para style="q1" vid="PSA 69:26">dok giketo can gimedo ameda ikom jo mayam dong ityeko keto ret ikomgi.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Mede ki keto can ikomgi muporo balgi,</para>
  <para style="q1" vid="PSA 69:27">pe ikwany kop woko ki i wigi kadi ki acel.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:28: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:32">Nia 32:32</ref>; <ref loc="REV 3:5">Niy 3:5</ref>; <ref loc="REV 13:8">13:8</ref>; <ref loc="REV 17:8">17:8</ref></char>
    </note>Jwa nyinggi woko ki i buk ma nying jo makwo ducu kicoyo iyeni; pe iwek kicoo nyinggi ikin nying jo ma kitgi atir.<verse eid="PSA 69:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />An dong atye ican ki arem madwong;</para>
  <para style="q1" vid="PSA 69:29">wek lari oila malo, Ai Lubanga!<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Abipako nying Lubanga ki wer;</para>
  <para style="q1" vid="PSA 69:30">abidworo nyinge kun amiye pwoc.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Pwoc man biyomo cwiny Rwot makato twon dyang,</para>
  <para style="q1" vid="PSA 69:31">nyo twon ma tunge olot, ma obonge dito.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Wek jo ma kiunugi gunen,</para>
  <para style="q1" vid="PSA 69:32">ci gubed ki yomcwiny;</para>
  <para style="q1" vid="PSA 69:32">wun jo ma wutye kayenyo Lubanga,</para>
  <para style="q1" vid="PSA 69:32">wubed ki kwo manyen icwinywu.<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />Rwot winyo koko pa jo ma piny obwoyogi,</para>
  <para style="q1" vid="PSA 69:33">dok pe cayo jone kikome ma kitweyogi i buc.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Wek polo ki lobo ducu gupake,</para>
  <para style="q1" vid="PSA 69:34">nam ki jami makwo ducu matye kawot iye.<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Lubanga bilaro jo Cion</para>
  <para style="q1" vid="PSA 69:35">dok bigero gangi me Juda odoco; lutice gibibedo kunu,</para>
  <para style="q1" vid="PSA 69:35">gibicamo doko meggi;<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />lutino pa lutice gibileyo doko meggi,</para>
  <para style="q1" vid="PSA 69:36">dok jo ma mare gibibedo iye.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s1">Lega pi kony</para>
  <para style="r">(<ref loc="PSA 40:13-17">Jab 40:13-17</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Ai Lubanga, bed ki yomcwiny pi bino kalara!</para>
  <para style="q1" vid="PSA 70:1">Ai Rwot, bin oyotoyot ikonya!<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Wek lewic omak jo ma gimito neka,</para>
  <para style="q1" vid="PSA 70:2">dok gubed ki anyobanyoba bene;</para>
  <para style="q1" vid="PSA 70:2">wek kidwokgi cen,</para>
  <para style="q1" vid="PSA 70:2">wek lewic omakgi,</para>
  <para style="q1" vid="PSA 70:2">gin jo ma mito tima maraci!<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Wek gubed ki lewic madwong,</para>
  <para style="q1" vid="PSA 70:3">gin jo ma ginyerani!<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Ento i mii dano ducu ma giyenyo in,</para>
  <para style="q1" vid="PSA 70:4">gubed ki yomcwiny madwong ikomi;</para>
  <para style="q1" vid="PSA 70:4">dok i mii jo ma gimaro lari</para>
  <para style="q1" vid="PSA 70:4">gumede ki waco nakanaka ni, “Lubanga dit!”<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />An gira lacan, dok piny obwoya woko;</para>
  <para style="q1" vid="PSA 70:5">bin bota oyotoyot,</para>
  <para style="q1" vid="PSA 70:5">Ai Lubanga!</para>
  <para style="q1" vid="PSA 70:5">In aye lakony ki lalara;</para>
  <para style="q1" vid="PSA 70:5">Ai Rwot, pe igale!<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s1">Lega pa dano ma otii</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Aringo alaro boti, Ai Rwot;</para>
  <para style="q1" vid="PSA 71:1">pe imii lewic omaka!<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Kit macalo in kiti atiri, lara dok ikonya;</para>
  <para style="q1" vid="PSA 71:2">cik iti iwiny legana, ci ilara!<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Bed got me kalarena,</para>
  <para style="q1" vid="PSA 71:3">dok ibed cel gogo matek ma gwoka;</para>
  <para style="q1" vid="PSA 71:3">pien in igot ki cel gogona.<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Lara ki i cing jo maracu do, Ai Lubangana,</para>
  <para style="q1" vid="PSA 71:4">lara ki itwero pa jo mager ma lubwami.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Gena ducu tye ikomi, Ai Rwot;</para>
  <para style="q1" vid="PSA 71:5">abedo kageno in cake wa ka tinona.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Cake ma kinywala abedo kajenge ikomi;</para>
  <para style="q1" vid="PSA 71:6">in aye mayam ikwanya ki iot nyodo pa maa.</para>
  <para style="q1" vid="PSA 71:6">Abibedo kapako in nino ducu.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Abedo lanen bot jo mapol,</para>
  <para style="q1" vid="PSA 71:7">ento in aye kalarena matek.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Abedo kapaki dyeceng jwi,</para>
  <para style="q1" vid="PSA 71:8">dok amiyi deyo bene dyeceng jwi.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Pe ibola woko ikare ma dong atii woko kuman;</para>
  <para style="q1" vid="PSA 71:9">pe ibwota bene ikare ma teka dong otum woko.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Lukwora gipiro lok mapol ikoma,</para>
  <para style="q1" vid="PSA 71:10">gin jo ma mito neka wokoni gicoke kacel kayubu lok ikoma.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Gin waco ni, “Lubanga dong otyeko bwote woko;</para>
  <para style="q1" vid="PSA 71:11">wuring ikore wek wumake woko,</para>
  <para style="q1" vid="PSA 71:11">pien pe tye ngat mo ma myero olare.”<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Ai Lubanga, pe ibed bor kweda;</para>
  <para style="q1" vid="PSA 71:12">Ai Lubangana, bin oyotoyot ilara!<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Mii lewic omak jo ma gin dotani,</para>
  <para style="q1" vid="PSA 71:13">dok kityekgi woko liweng;</para>
  <para style="q1" vid="PSA 71:13">wek kicagi, dok can omakgi malit,</para>
  <para style="q1" vid="PSA 71:13">gin jo ma mito keto can ikomani.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Ento an pud abimede ki bedo ki gen ikomi,</para>
  <para style="q1" vid="PSA 71:14">abimede kapaki nakanaka.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Abitucu pi tic ma atir ducu ma itiyo,</para>
  <para style="q1" vid="PSA 71:15">abitucu bene pi tic me lari dyeceng jwi,</para>
  <para style="q1" vid="PSA 71:15">kadi bed welgi dong dwong ma okato ngeca woko.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Abibino pi tito pi tic madito me aura pa Rwot Lubanga,</para>
  <para style="q1" vid="PSA 71:16">abitito pi kiti ma atir, pi kit ma meri ma atir keken.<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Ai Lubanga, ibedo kapwonyo an cake wa ka tinona,</para>
  <para style="q1" vid="PSA 71:17">pimeno pud atucu pi tici me aura ducu ma itiyo.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Pe ibwota ata, Ai Lubanga,</para>
  <para style="q1" vid="PSA 71:18">kadi bed ikare ma dong atii ma, wiya otwi lwar,</para>
  <para style="q1" vid="PSA 71:18">ento bed kweda nio ka atucu pi teki</para>
  <para style="q1" vid="PSA 71:18">bot yalwak me kare man ducu ki me anyim.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Ai Lubanga, tweri ki timi ma atiri</para>
  <para style="q1" vid="PSA 71:19">dong otyeko o wa malo i polo.</para>
  <para style="q1" vid="PSA 71:19">In aye ma itiyo jami madito ducu,</para>
  <para style="q1" vid="PSA 71:19">pe tye ngat mo macalo in, Ai Lubanga!<verse eid="PSA 71:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />In aye ma icwalo ayelayela ki arem madwong ikoma,</para>
  <para style="q1" vid="PSA 71:20">in giri bene ma ibidwoko teko ikoma;</para>
  <para style="q1" vid="PSA 71:20">dok ibikwanya woko ki ite ngom ka matuti,</para>
  <para style="q1" vid="PSA 71:20">ibikela woko kamaleng dok.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Ibimiya abedo ki dit makato,</para>
  <para style="q1" vid="PSA 71:21">dok bene ibikweyo cwinya.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Dok bene abipaki ki nanga</para>
  <para style="q1" vid="PSA 71:22">pi geni, Ai Lubangana;</para>
  <para style="q1" vid="PSA 71:22">abiwero wer me paki kun agoyo agoya ki opuk,</para>
  <para style="q1" vid="PSA 71:22">in Ngat Maleng pa jo Icrael.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Abidange matek pi yomcwiny,</para>
  <para style="q1" vid="PSA 71:23">ikare ma nongo atye kawero wer me paki;</para>
  <para style="q1" vid="PSA 71:23">abipaki ki tipuna bene, pien dong ilara.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Dok abitito pi timi ma atiri ma ikonya kwede dyeceng jwi,</para>
  <para style="q1" vid="PSA 71:24">pien lewic ki can dong otyeko makogi woko,</para>
  <para style="q1" vid="PSA 71:24">gin jo ma onongo giyenya wek giket can ikomani.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s1">Lega pi rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />Pwony rwot wek ongol kop atir macalo in, Ai Lubanga;</para>
  <para style="q1" vid="PSA 72:1">dok inyut tic ki ada bot latini me ker,<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />wek en ongol kop pa lwaki i yo ma atir,</para>
  <para style="q1" vid="PSA 72:2">dok oloo lwaki ma gin lucan i yo mupore.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Wek godi ki ceregu gukel kuc bot dano,</para>
  <para style="q1" vid="PSA 72:3">pien lwaki gitye ki kit ma atir.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Myero rwot owiny pido pa lucan dok ongol kopgi kakare,</para>
  <para style="q1" vid="PSA 72:4">wek olar bene jo mapiny oloyogi ki jo ma kidiyogi,</para>
  <para style="q1" vid="PSA 72:4">ento onginy jo ma unu dano mukenegu woko!<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Lwaki myero guwori nakanaka ikare pa yalwakgi ducu, Ai Lubanga,</para>
  <para style="q1" vid="PSA 72:5">pi kare ducu ma ceng ki dwe pud tye!<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Wek rwot obed macalo kot ma cwer i poti,</para>
  <para style="q1" vid="PSA 72:6">nyo calo ngido kot ma cwer bido ngom.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Wek kit ma atir omede ameda ikare me loce,</para>
  <para style="q1" vid="PSA 72:7">dok kuc ki lonyo onya bene obed i lobone nakanaka calo dwe!<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:8: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 9:10">Jek 9:10</ref>
      </char>
    </note>En biloyo lobo cake i dog nam tungi nio kwede wa i dog nam tungcel,</para>
  <para style="q1" vid="PSA 72:8">dok biloyo cake ki i kulu Euprate o kwede wa i agiki piny.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Lumonene ducu gibigungo inyime kawore,</para>
  <para style="q1" vid="PSA 72:9">lukwore gibibutu aryeba ic ci gibimoko apwa.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Luker me Tarcic ki pa jo ma bedo i cula nam,</para>
  <para style="q1" vid="PSA 72:10">myero gucul mucoro bote,</para>
  <para style="q1" vid="PSA 72:10">dok luker me Ceba ki me Seba gukel mot bote.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Luker ducu myero guryebe piny inyime,</para>
  <para style="q1" vid="PSA 72:11">dok rok ducu myero gutii bote!<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />En laro dano ma piny obwoyo ka okok bote,</para>
  <para style="q1" vid="PSA 72:12">konyo lapiny oloyo ki jo ma pe gitye ki ngat ma konyogi.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Kica make ikom jo magoro ki ma piny obwoyogi,</para>
  <para style="q1" vid="PSA 72:13">ci laro kwo pa jo ma piny oloyo.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />En kokogi ki i tim bwami ki i aun ma kibedo kaunugi kwede;</para>
  <para style="q1" vid="PSA 72:14">kwogi pire tek bote ma pe wace.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Wek rwoti obed kwo nakanaka!</para>
  <para style="q1" vid="PSA 72:15">Myero kimii jabu ma kikelo ki i Ceba bot rwot;</para>
  <para style="q1" vid="PSA 72:15">dok gibed kalega pire kare ducu ma pe gikeng,</para>
  <para style="q1" vid="PSA 72:15">kileg Lubanga wek oony gum mere ikome kare ducu!<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Wek cam bene ocek mabup i lobone,</para>
  <para style="q1" vid="PSA 72:16">opong wa iwi godigu woko ducu;</para>
  <para style="q1" vid="PSA 72:16">wek onyak nyig mabeco calo godi me Lebanon;</para>
  <para style="q1" vid="PSA 72:16">wek taun madito ducu opong ki lwak dano madwong ata,</para>
  <para style="q1" vid="PSA 72:16">ma gipol calo lum ma i tim!<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Wek nying rwot orii nakanaka,</para>
  <para style="q1" vid="PSA 72:17">ki ywekane orii kit macalo ceng rii kwede.</para>
  <para style="q1" vid="PSA 72:17">Jo me rok ducu myero gulwonge ni lagumkom,</para>
  <para style="q1" vid="PSA 72:17">dok bene gunong gum pire!<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Kipak Rwot, Lubanga pa Icrael!</para>
  <para style="q1" vid="PSA 72:18">En keken aye ma tiyo gin me aura.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Kipak nyinge me deyoni nakanaka,</para>
  <para style="q1" vid="PSA 72:19">wek deyone bene opong lobo woko ducu!</para>
  <para style="q1" vid="PSA 72:19">Amen! Amen!<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Lega pa Daudi wod pa Yece ogik kany.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">BUK ME ADEK</para>
  <para style="mr">
    <ref loc="PSA 73-89">Jab 73—89</ref></para>
  <para style="s1">Ngolo kop atir pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Adada Lubanga ber bot dano ma cwinygi atir,</para>
  <para style="q1" vid="PSA 73:1">dok en ber bot jo ma cwinygi leng.<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Ento an onongo dong acok poto woko;</para>
  <para style="q1" vid="PSA 73:2">niyena onongo dong tye karwenyo woko.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Pien nyeko onongo omaka woko ikom jo ma luwake,</para>
  <para style="q1" vid="PSA 73:3">ikare ma aneno jo maracu gilony mere alonya.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Pe gitye kawinyo kit arem mo liweng;</para>
  <para style="q1" vid="PSA 73:4">komgi yot dok tye mere mapwot apwota.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Pe gibedo kaneno can kit ma jo mukene gineno kwedeni;</para>
  <para style="q1" vid="PSA 73:5">pe gitye ki ayela ikomgi macalo jo mukene.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Pimeno wake odoko calo gideyo ma giruku mere i ngutgi;</para>
  <para style="q1" vid="PSA 73:6">tim bwamigi bene oboyo komgi woko calo bongo.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Tam ma a i igi nen wa i wanggi ni opong ki yub me tim maracu,</para>
  <para style="q1" vid="PSA 73:7">ki cwinygi bene opong ki yub me mingo keken.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Gingalo jo mukenegu kun giloko lok maracu;</para>
  <para style="q1" vid="PSA 73:8">giyubu yubgi me buru dano dok giunugi bene.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Giloko lok marac ikom Lubanga matye i poloni;</para>
  <para style="q1" vid="PSA 73:9">lok bura ma a idoggi oromo i lobo woko ducu.<verse eid="PSA 73:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Pimeno omiyo lwak pa Lubanga bene gibedo kapakogi pi gin ma gutiyo;</para>
  <para style="q1" vid="PSA 73:10">pe kineno bal mo ikomgi kadi ki acel.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Giwaco ni, “Lubanga kono twero ngeyone ningning?</para>
  <para style="q1" vid="PSA 73:11">En Ngat Mamalo Twal tye ki kit ngec mo?”<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Nen jo maracu aye tye kitmeno;</para>
  <para style="q1" vid="PSA 73:12">kare ducu gilimo lwak jami mapol,</para>
  <para style="q1" vid="PSA 73:12">dok pud gimede ameda ki nongo lonyo makato.<verse eid="PSA 73:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Pimeno dong abedo ma iya leng gira mere nono,</para>
  <para style="q1" vid="PSA 73:13">dok alwoko cinga ma pe abalo.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Gibedo kaketo ayela ikoma dyeceng jwi,</para>
  <para style="q1" vid="PSA 73:14">kun gipwoda nino ducu odiko ki odiko.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Kono nene aloko lok mo marac macalo jo meno maracuni;</para>
  <para style="q1" vid="PSA 73:15">kono pe abedo ki ada mo bot joni.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Ento ateme ki teka ducu me niang lok man,</para>
  <para style="q1" vid="PSA 73:16">kadi bed kumeno an anongo gira ni tek tutwal kitung bota ci oolo koma tutwal;<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />nio ka acito i Ot maleng pa Lubanga;</para>
  <para style="q1" vid="PSA 73:17">ka dong acako niang ikom gin ma bitime ikom jo maracu.<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />I adane in yam iketogi ikabedo mapwot ma gicer acera ki iye;</para>
  <para style="q1" vid="PSA 73:18">ibimiyo gipoto piny ci gibito woko ducu.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Kibityekogi woko oyotoyot labongo gale;</para>
  <para style="q1" vid="PSA 73:19">ibirwenyo wanggi woko oyotoyot ki i lobo man ki gin maracu makelo lworo.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Jonu gibedo macalo lek ma rwenyo woko oyot ka dano oco odiko, ki iwang nino ci temo tamo pire;</para>
  <para style="q1" vid="PSA 73:20">dong Ai Rwot ka i a malo ci jonu girwenyo woko ki iwangi wa ki itami bene.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Ikare ma abedo ma iya kec,</para>
  <para style="q1" vid="PSA 73:21">ma ton cwiny bene omaka adada,<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />onongo aming dok pud akwiya piny,</para>
  <para style="q1" vid="PSA 73:22">onongo abedo calo lee tim inyimi.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Ento kare ducu abedo cok kwedi;</para>
  <para style="q1" vid="PSA 73:23">kun imako cinga ma lacuc bene.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Itela ki tam ma ibedo kamiya,</para>
  <para style="q1" vid="PSA 73:24">wek i agikine ka ato ci ibijola ideyoni.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Gin ango mukene madok atye kwede i polo, kono in keken?</para>
  <para style="q1" vid="PSA 73:25">Gin mo ma amito i lobo kany tutwal makato in pe tye.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Koma ki cwinya twero doko goro,</para>
  <para style="q1" vid="PSA 73:26">ento Lubanga aye tek me cwinya,</para>
  <para style="q1" vid="PSA 73:26">dok Rwot aye dul ma kipoka matwal.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Adada jo matye kamabor ki in gibito gitum woko;</para>
  <para style="q1" vid="PSA 73:27">dok ibijwero jo ducu ma pe gigeno in.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Ento ki tung bota, bedo cok ki Lubanga aye ber;</para>
  <para style="q1" vid="PSA 73:28">in Rwot Lubanga matwero ducu aye lagwok mera,</para>
  <para style="q1" vid="PSA 73:28">ci weko abitito pi tici ducu ma itiyo.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s1">Koko bot Lubanga ikom lukwor pa jone</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />Ai Lubanga, pingo ibolowa woko matwal?</para>
  <para style="q1" vid="PSA 74:1">Pingo imiyo akemoni duny ikomwa wan romini ma in aye ikwayogi?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Po pi lwaki mayam iyerogi cake wacon,</para>
  <para style="q1" vid="PSA 74:2">gin jo mayam ikokogi ki ican wek gubed joni kikome.</para>
  <para style="q1" vid="PSA 74:2">Po pi got Cion, kabedo mayam ibedo iye.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Bin iwot i kabedo man madong odoko obur matwali;</para>
  <para style="q1" vid="PSA 74:3">lukwori gujwero jami woko ducu ki ikabedoni malengi.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Lukwori gudange matek ki loc ikabedo mayam joni gicoke iye kawori;</para>
  <para style="q1" vid="PSA 74:4">guketo benderagi malo me nyutu ni dong odoko meggi.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Gicalo lutong yat ma i bunga</para>
  <para style="q1" vid="PSA 74:5">ma gitye ka tongo yadi ki latong.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Gubaro bao ma kipayo maber ki iye,</para>
  <para style="q1" vid="PSA 74:6">gutiyo ki latong ki nyol.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Gumuku ka gureto Ot pa Lubanga woko piny, ci gucwinyo woko ki mac;</para>
  <para style="q1" vid="PSA 74:7">gupyedo kabedo meno maleng ka mayam dano giworo iye nyingi.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Guwaco ni, “Wabinginyo joni watyekogi woko likwicikwici”;</para>
  <para style="q1" vid="PSA 74:8">guwango kabedo ni maleng woko liweng ki i lobo tuwa.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Jami maleng me woro ducu dong pe nen,</para>
  <para style="q1" vid="PSA 74:9">pe tye lanebi mo ma odong,</para>
  <para style="q1" vid="PSA 74:9">pe tye ngat mo ikinwa ma ngeyo kare ma can man bitero.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Ai Lubanga, lukworwa mono gibibedo kacayowa pi kare marom mene?</para>
  <para style="q1" vid="PSA 74:10">Lukworwa myero gubed kayeto nying in Lubanga nakanaka?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Pingo idolo cingi woko pe ikonyowa?</para>
  <para style="q1" vid="PSA 74:11">Idolo cingi idwoko tung ngeyi do pingo?<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Ento in Lubanga, ma ibedo Rwotwa cake wacon,</para>
  <para style="q1" vid="PSA 74:12">ibedo katiyo tici me laro dano iwi lobo.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Nia 14:21</ref>
      </char>
    </note>Ipoko dye nam woko ki teki;</para>
  <para style="q1" vid="PSA 74:13">inyoto wi megi kulugu woko ducu i pii.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:1">Yub 41:1</ref>; <ref loc="PSA 104:26">Jab 104:26</ref>; <ref loc="ISA 27:1">Ica 27:1</ref></char>
    </note> Inginyo wi Leviatan ma min kuluni woko ducu do,</para>
  <para style="q1" vid="PSA 74:14">ka imiyo odoko cam pa lee ma gibedo i tim.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Iyabo wang it, imiyo piine obedo kagunye odoko ora,</para>
  <para style="q1" vid="PSA 74:15">ci imiyo pii otwo woko liweng ki i kulu mukene mayam gimol.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Dyeceng meri ki wor bene meri;</para>
  <para style="q1" vid="PSA 74:16">in aye iketo ceng ki dwe ikabedogi.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Iketo wang apoki ducu me lobo;</para>
  <para style="q1" vid="PSA 74:17">in bene ma iketo oro ki cwir gubedo tye.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />Ai Rwot, po ikit ma lukworwa gicayi kwede,</para>
  <para style="q1" vid="PSA 74:18">gin jo ma pe gilwori ma giyeti nono.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Pe imii joni marom ki akurini bot lukwor magi mageri ma girom ki lee timi;</para>
  <para style="q1" vid="PSA 74:19">wii pe myero owil matwal ikom lwaki ma gin lucan.<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Po ikom gicikeni mayam icike kwede ki wan con;</para>
  <para style="q1" vid="PSA 74:20">pien tim bwami tye ikabedo macol ducu matye i lobowani.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Pe iwek lewic omak jo ma kidiyogi;</para>
  <para style="q1" vid="PSA 74:21">wek lucan ki jo ma piny obwoyogi gupak nyingi.<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />A malo, Ai Lubanga, wek ipid pidoni;</para>
  <para style="q1" vid="PSA 74:22">po bene kit ma jo ma pe gilwori gicayi kwede dyeceng jwi!<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Wii pe owil ikom dange me kiniga ma lumoneni gidange kwede mateki,</para>
  <para style="q1" vid="PSA 74:23">en woo pa gin lukwori ma gimede kwede ameda ma pe gilingi.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s1">Lubanga ma langolkop</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />Wapwoyi, Ai Lubanga, wapwoyi pien itye cok kwedwa!</para>
  <para style="q1" vid="PSA 75:1">Jo ducu gitito pi dit me nyingi</para>
  <para style="q1" vid="PSA 75:1">ki pi tic me aura ducu madong ityeko tiyogi.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Lubanga owaco ni, “Atyeko moko nino me ngolo kop,</para>
  <para style="q1" vid="PSA 75:2">abingolo kop ma atir dok kakare.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Kadi bed lobo yenge, kacel ki jo ducu ma bedo iye;</para>
  <para style="q1" vid="PSA 75:3">abigwoko wir ma lobo ocung iye ducu wek ocung matek kakargi liking.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Dong atito bot luwake ducu ni, ‘Pe wuwake,’</para>
  <para style="q1" vid="PSA 75:4">dok bot jo maracu bene awaco ni, ‘Pe wulyere ma wuwake awaka.’<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Dok atito botgi ni pe myero gukete ken gi malo tutwal,</para>
  <para style="q1" vid="PSA 75:5">dok bene gugik loko lok anywaranywar woko ki ikin gi.”<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Medo rwom pa dano pe bino kun a ki tung kunyango onyo tung kupotoceng,</para>
  <para style="q1" vid="PSA 75:6">kadi ki tung tim onyo tung godi;<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />ento Lubanga kene aye ma ngolo kop pa dano,</para>
  <para style="q1" vid="PSA 75:7">Lubanga dwoko dano acel piny kun juke pi bale dok tingo dano mukene ilo malo pi tito ni pe obalo ilok meno ma kikelo ikome.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Rwot pi kinigane dong omako kikopo i cinge ma opong ki kongo bwino,</para>
  <para style="q1" vid="PSA 75:8">ma yenyo ayenya ki bwoyo, ma kirubu maber.</para>
  <para style="q1" vid="PSA 75:8">En miyo jo maracu ducu matye i lobo gimato,</para>
  <para style="q1" vid="PSA 75:8">gimato nio wang ma gutyeko woko liweng.<verse eid="PSA 75:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Ento an abibedo katito lok ikom Lubanga pa Yakobo nakanaka,</para>
  <para style="q1" vid="PSA 75:9">dok abiwero wer me pake ikare ducu.<verse eid="PSA 75:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />En Lubanga aye bityeko teko pa jo maracu woko liweng,</para>
  <para style="q1" vid="PSA 75:10">ento Rwot bimedo teko bot jo ma kitgi atir.<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s1">Lubanga aye laloyo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />I Juda dano gingeyo Lubanga maber tutwal,</para>
  <para style="q1" vid="PSA 76:1">nyinge bene dit i Icrael.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Kabedone tye i Jerucalem,</para>
  <para style="q1" vid="PSA 76:2">en bedo iwi got Cion.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />En oturu atero ma lake wil awila woko ki kunu,</para>
  <para style="q1" vid="PSA 76:3">oturu wa kwot, pala lucwan ki jami lwenygigu ducu.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Itye kideyo makato, Ai Lubanga,</para>
  <para style="q1" vid="PSA 76:4">ki dit me loc tye i cingi,</para>
  <para style="q1" vid="PSA 76:4">makato godi ducu ma rii nakanaka.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Acikarigi macir ducu kiyako jamigi woko;</para>
  <para style="q1" vid="PSA 76:5">gitye kanino nino to;</para>
  <para style="q1" vid="PSA 76:5">pe tye ngat mo mudong ki ikin gin lumony</para>
  <para style="q1" vid="PSA 76:5">matwero tic ki jami lweny.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Ikare ma i jukugi, Ai Lubanga pa Yakobo,</para>
  <para style="q1" vid="PSA 76:6">aguragura ki jo ma ngweco kwedgi gupoto guwile woko ducu.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Ento in, Rwot, dano lwori matek!</para>
  <para style="q1" vid="PSA 76:7">Anga matwero cung inyimi</para>
  <para style="q1" vid="PSA 76:7">ka onongo kiniga dong omaki woko?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />In dong ingolo kopi woko wa ki i polo;</para>
  <para style="q1" vid="PSA 76:8">jo ducu ma bedo i lobo gulworo,</para>
  <para style="q1" vid="PSA 76:8">omiyo guling mot,<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />ikare ma ia malo kangolo kop,</para>
  <para style="q1" vid="PSA 76:9">pi laro jo ducu ma kiunugi i loboni.<verse eid="PSA 76:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Adada akemo pa dano miyo jo giloke gidok kapako in;</para>
  <para style="q1" vid="PSA 76:10">jo mudong ma gubwot ki i dog lweny gibicoke boti.<verse eid="PSA 76:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Wukwong kwong bot Rwot Lubangawu,</para>
  <para style="q1" vid="PSA 76:11">dok wucob gin ma wukwongo bote;</para>
  <para style="q1" vid="PSA 76:11">wek dano ducu ma gibedo cok,</para>
  <para style="q1" vid="PSA 76:11">gukel motgi bote;</para>
  <para style="q1" vid="PSA 76:11">Lubanga myero kilwor,<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />pien en dwoko rwodi ma luwake woko piny,</para>
  <para style="q1" vid="PSA 76:12">dok miyo luker me lobo gibedo ki lworo madwong.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s1">Kweyo cwiny ikare me can</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Akok matek bot Lubanga,</para>
  <para style="q1" vid="PSA 77:1">akok bote matek, ci en owinyo kokona.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Ayenyo Rwot ikare ma atye ki can;</para>
  <para style="q1" vid="PSA 77:2">i dyewor atango cinga bote kun alego ma pe aol;</para>
  <para style="q1" vid="PSA 77:2">ento meno ducu mwa, cwinya pe romo kwe.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Ka aparo pi Lubanga, ci acur;</para>
  <para style="q1" vid="PSA 77:3">ka alwodo lok, ci nen cwinya bale woko.<verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />En miyo abedo ma pe anino i dyewor benebene;</para>
  <para style="q1" vid="PSA 77:4">atye ki par mapol tutwal omiyo pe atwero loko lok mo.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Abedo katamo pi kare macon,</para>
  <para style="q1" vid="PSA 77:5">dok apo ikom lwak mwaka ducu ma okato.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Abedo katamo tam matut ki i cwinya i dyewor;</para>
  <para style="q1" vid="PSA 77:6">alwodo lok dok apenye kekena ki icwinya ni,<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />“Rwot mono bikwerowa woko matwal kare ducu?</para>
  <para style="q1" vid="PSA 77:7">Wa cwinye dok pe bibedo yom ikomwa bene?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />En dong pe marowa ki mar mere ma pe lokeni?</para>
  <para style="q1" vid="PSA 77:8">Wa cikene mono dong ogik woko ikomwa pi kare me kwowa ducu?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Lubanga mono dong wiye owil woko pi nyutu kicane ikom dano?</para>
  <para style="q1" vid="PSA 77:9">En dong mono pe romo timowa kica,</para>
  <para style="q1" vid="PSA 77:9">pi kiniga ma omakeni?”<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Dok awaco ni, “Gin ma cwero cwinya makato ducu en aye ni,</para>
  <para style="q1" vid="PSA 77:10">twero pa en Ngat Mamalo Twali dong peke botwa kit ma con ca.”<verse eid="PSA 77:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Abipo ikom tic madito ma Rwot otiyo;</para>
  <para style="q1" vid="PSA 77:11">ada, abipo ikom tici ducu me aura mayam itiyo ikare macon.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Abibedo katamo pi gin ducu ma dong itimo,</para>
  <para style="q1" vid="PSA 77:12">dok abilwodo lok ikom tici madito ducu mayam itiyo.<verse eid="PSA 77:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Kit gin ducu ma itiyo, leng, Ai Lubanga!</para>
  <para style="q1" vid="PSA 77:13">Pe tye kit lubanga mo madit calo in!<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />In keken aye Lubanga ma tiyo tango me aura;</para>
  <para style="q1" vid="PSA 77:14">dok inyutu teki ikin lwak me rok ducu.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Yam ikoko lwaki ki i can pi tweroni,</para>
  <para style="q1" vid="PSA 77:15">gin likwayo pa Yakobo ki Yucepu.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Ka pii me nam oneni, ci obedo ki lworo, Ai Lubanga,</para>
  <para style="q1" vid="PSA 77:16">ka oneni obedo ki lworo adada, dok nam matut ducu oyenge.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Kot oa ki i pol ocwer i lobo;</para>
  <para style="q1" vid="PSA 77:17">piny omor ki i pol matek,</para>
  <para style="q1" vid="PSA 77:17">ci lutkot owil ikabedo ducu.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Dwoni omor owinye wa i yamo lapiru mager;</para>
  <para style="q1" vid="PSA 77:18">lutkoti bene omeny ocaro lobo woko ducu;</para>
  <para style="q1" vid="PSA 77:18">lobo oyenge ki jo ma bedo iye ducu komgi omyel.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Iwoto ikato ki i dye nam,</para>
  <para style="q1" vid="PSA 77:19">ingolo ki i dye nam ma dongo matut;</para>
  <para style="q1" vid="PSA 77:19">ento ojwe tyeni pe omedo ki nen.<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Itelo wi lwaki macalo lakwat romi,</para>
  <para style="q1" vid="PSA 77:20">kun imiyo Moses ki Aron me gwokogi.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s1">Lubanga ki jone</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Wucik itwu, wuwiny lok ma apwonyowu kwede, wun lwaka;</para>
  <para style="q1" vid="PSA 78:1">wucik itwu, wuwiny lok ma abicito kalokoneni.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:2: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:35">Mat 13:35</ref>
      </char>
    </note>Abiwaco botwu lok i carolok;</para>
  <para style="q1" vid="PSA 78:2">abitito botwu lok macon me koc lit,<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />lok ma wan kikomwa wawinyo dok wangeyo,</para>
  <para style="q1" vid="PSA 78:3">ma kwarowa yam gutito botwa.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Pe wakano lok man wek obedo me mung bot likwayogi,</para>
  <para style="q1" vid="PSA 78:4">ento wabitito bot yalwak ma lubuwa;</para>
  <para style="q1" vid="PSA 78:4">ki wabitito pi twero pa Rwot, ki pi tic matego ma en otiyo ducu,</para>
  <para style="q1" vid="PSA 78:4">ki pi tango mapol me aura ma en dong otiyo.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />En omiyo cik bot jo Icrael,</para>
  <para style="q1" vid="PSA 78:5">dok omiyo cik bene bot likwayo pa Yakobo.</para>
  <para style="q1" vid="PSA 78:5">En yam omiyo cik bot kwarowa me pwonyo ki lutinogi;<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />wek yalwak malubu i anyim bene gunge cik magi,</para>
  <para style="q1" vid="PSA 78:6">gin lutino ma onongo pud peya kinywalogi,</para>
  <para style="q1" vid="PSA 78:6">wek gin bene lacen gutit lok man bot lutinogi.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Wek ka guwinyo lok man ci gugen Lubanga,</para>
  <para style="q1" vid="PSA 78:7">wek wigi pe owil ikom tic ducu pa Lubanga,</para>
  <para style="q1" vid="PSA 78:7">dok bene gugwok cike ducu.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Gin pe myero gubed macalo kwarigi,</para>
  <para style="q1" vid="PSA 78:8">gin yalwak ma cwinygi opong ki jemo,</para>
  <para style="q1" vid="PSA 78:8">yalwak ma tamgi pe omoko matek</para>
  <para style="q1" vid="PSA 78:8">ma pe gigeno Lubanga ki cwinygi ducu.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Jo Epraim ma gilwenyo ki atum ki atero</para>
  <para style="q1" vid="PSA 78:9">guloke gudok woko cen inino me lweny.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Pe gugwoko gicikegi ki Lubanga,</para>
  <para style="q1" vid="PSA 78:10">ento gukwero lubu cike woko.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Wigi bene owil woko ikom tic mayam en otiyo,</para>
  <para style="q1" vid="PSA 78:11">kadi ki lwak tango mapol mayam onyutu botgi.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:8-12">Nia 7:8-12</ref>; <ref loc="EXO 32">32</ref></char>
    </note> Lubanga yam otiyo lwak tango me aura ma kwarigi guneno</para>
  <para style="q1" vid="PSA 78:12">i bar me Joan, i lobo Ejipt.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-22">Nia 14:21-22</ref>
      </char>
    </note>En opoko dye nam woko aryo,</para>
  <para style="q1" vid="PSA 78:13">omiyo gukato ki iye wa loka tung cel,</para>
  <para style="q1" vid="PSA 78:13">en omiyo pii otinge malo likung.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21-22">Nia 13:21-22</ref>
      </char>
    </note>En obedo katelo wigi ki i dyeceng ki pol,</para>
  <para style="q1" vid="PSA 78:14">ento i dyewor obedo katelo wigi ki mac ma lyel.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:15: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Nia 17:1-7</ref>; <ref loc="NUM 20:2-13">Wel 20:2-13</ref></char>
    </note>En obaro got i dye tim,</para>
  <para style="q1" vid="PSA 78:15">omiyo gumato pii madit adada macalo pii matye ikut matut.<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />En omiyo ora kulu mapol gumol ki igot ma obari,</para>
  <para style="q1" vid="PSA 78:16">omiyo pii ocako mol ki iye cito piny macalo kulu madit.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Ento pud gumede ki timo bal ikom Lubanga,</para>
  <para style="q1" vid="PSA 78:17">gujemo woko ikom Ngat Mamalo Twali i dye tim.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:18: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Nia 16:2-15</ref>; <ref loc="NUM 11:4-23">Wel 11:4-23</ref>; <ref loc="NUM 11:31-35">Wel 11:31-35</ref></char>
    </note>Gutemo Lubanga i cwinygi</para>
  <para style="q1" vid="PSA 78:18">kun gilege ni omii ki gin cam ma cwinygi opuke iyeni.<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Guloko lok marac ikom Lubanga kun giwaco ni,</para>
  <para style="q1" vid="PSA 78:19">“Lubanga twero miyo ki wan gin acama i dye tim kany?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Kadi bed en obaro got ci pii okati ki iye,</para>
  <para style="q1" vid="PSA 78:20">ci kulu ducu gupong woko libyeny wa iwi tura;</para>
  <para style="q1" vid="PSA 78:20">ento en mono tika twero miyowa cam bene,</para>
  <para style="q1" vid="PSA 78:20">nyo miyo bene ringo bot lwake wek gucam?”<verse eid="PSA 78:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Pimeno akemo omako Rwot matek ikare ma owinyo lokgi meno;</para>
  <para style="q1" vid="PSA 78:21">omiyo olwenyo ikom jo pa Yakobo ki mac,</para>
  <para style="q1" vid="PSA 78:21">ci kinigane onya omede ameda ikom jo Icrael,<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />pien pe gubedo ki niye ikome,</para>
  <para style="q1" vid="PSA 78:22">dok pe gugeno ni en twero larogi.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Ento en ociko pol matye malo,</para>
  <para style="q1" vid="PSA 78:23">ci oyabo dogola me polo;<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:24: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:31">Jon 6:31</ref>
      </char>
    </note>ka dong ocako cwalo botgi manna me acama,</para>
  <para style="q1" vid="PSA 78:24">omiyo botgi kal ma oa ki i polo.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Dano gucamo kwon ma lumalaika gicamo;</para>
  <para style="q1" vid="PSA 78:25">ci ocwalo botgi cam madwong ata.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />En omiyo yamo ma a tung kunyango okodo ki i polo,</para>
  <para style="q1" vid="PSA 78:26">dok bene otelo yamo ma kodo a tung kunyango ki twerone.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />En ocwalo lwak winyi opye botgi calo apwa,</para>
  <para style="q1" vid="PSA 78:27">gipol ma girom ki kweyo ma i dog nam;<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />omiyo gupoto woko i dye gonygi,</para>
  <para style="q1" vid="PSA 78:28">ikabedo ducu ma orumu kemagi.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Lwak gucamo ci guyeng bene matek,</para>
  <para style="q1" vid="PSA 78:29">pien Lubanga onongo dong omiyo botgi gin ma cwinygi opuke iye.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Ento ma pud kee ringogi tye, ma peya guyeng maber,</para>
  <para style="q1" vid="PSA 78:30">ma onongo cam bene pud tye idoggi,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />kiniga omako Lubanga matek ikomgi,</para>
  <para style="q1" vid="PSA 78:31">ci oneko jo matego woko ki ikin gi,</para>
  <para style="q1" vid="PSA 78:31">ojwero twoni oteka ma kiyerogi ki ikin jone me Icrael woko.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Kadi bed kumeno, jo Icrael pud gumede ameda ki timo bal;</para>
  <para style="q1" vid="PSA 78:32">kadi bed Lubanga otiyo jami tango mapol ento gin pe guye.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Pimeno ogiko nino me kwogi woko calo yweyo,</para>
  <para style="q1" vid="PSA 78:33">ka orwenyo kwogi woko bene ki can madwong ma opoto atura.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Ka inen en oneko jo mogo, ci jo mudong giloke giyenye ci gidwogo bote;</para>
  <para style="q1" vid="PSA 78:34">gin gingut ci giyenyo Lubanga ki cwinygi ducu.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Gucako po ni Lubanga aye kalaregi,</para>
  <para style="q1" vid="PSA 78:35">Lubanga Mamalo Twal yam okokogi ki ican.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Ento gubedo kabwole abwola ki lok doggi nono,</para>
  <para style="q1" vid="PSA 78:36">lok ducu ma gubedo kaloko bote obedo goba keken.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />Pe gumare ma kun omyero gumok ikome ki cwinygi ducu;</para>
  <para style="q1" vid="PSA 78:37">pe bene gubedo ki ada me gwoko gicike matye ikin gi ki Lubanga.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Ento kica omako Lubanga ikom lwake.</para>
  <para style="q1" vid="PSA 78:38">En oweko balgi,</para>
  <para style="q1" vid="PSA 78:38">omiyo pe otyekogi woko.</para>
  <para style="q1" vid="PSA 78:38">Obedo kajuku kinigane tyen mapol,</para>
  <para style="q1" vid="PSA 78:38">pe obedo katugu akemone ducu.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Wiye opo ni gin dano mamwa,</para>
  <para style="q1" vid="PSA 78:39">gubedo calo yamo ma kodo cito mere matwal ma pe dok dwogo cen.<verse eid="PSA 78:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Gin gujemo ikome i tim pi kare mapol;</para>
  <para style="q1" vid="PSA 78:40">gucwero cwinye i aroo.<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Gubedo katemo Lubanga teretere,</para>
  <para style="q1" vid="PSA 78:41">gumiyo kiniga omako Ngat Maleng pa Icrael.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Wigi owil woko ikom twerone,</para>
  <para style="q1" vid="PSA 78:42">kadi ikom nino ma en okokogi kwede ki i cing lukworgini,<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />ikare ma en otiyo lanyut me jami tango mapol,</para>
  <para style="q1" vid="PSA 78:43">i bar Joan, i lobo Ejipt.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:44: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Nia 7:17-21</ref>
      </char>
    </note>En oloko pii ma i kulu pa jo Ejipt ducu odoko remo,</para>
  <para style="q1" vid="PSA 78:44">wek pe gumat piine ma i ora kulu.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:45: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-6">Nia 8:1-6</ref>; <ref loc="EXO 8:20-24">Nia 8:20-24</ref></char>
    </note>En ocwalo lwangi ikin gi ci ocamogi matek,</para>
  <para style="q1" vid="PSA 78:45">ocwalo ogwal bene ma obalo lobogi.<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:46: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Nia 10:12-15</ref>
      </char>
    </note>En omiyo okwil ocamo ginapitagi woko,</para>
  <para style="q1" vid="PSA 78:46">ki camgi ma dong guyele kwede i poto omiyo bonyo ocamo woko ducu.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:47: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Nia 9:22-25</ref>
      </char>
    </note>En omiyo pee ogoyo olokgi obalo woko,</para>
  <para style="q1" vid="PSA 78:47">ki yadi olamgi obalo woko ki ngico.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />En omiyo pee oneko dyangigi woko,</para>
  <para style="q1" vid="PSA 78:48">ki lutkot bene ocelo romigi.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />En obangogi woko ki akemone mageri,</para>
  <para style="q1" vid="PSA 78:49">ki kiniga, acena ki can,</para>
  <para style="q1" vid="PSA 78:49">kun ocwalo lumalaika me jwerogi woko.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />En pe ojuku kinigane;</para>
  <para style="q1" vid="PSA 78:50">pe oye laro kwogi ki i to,</para>
  <para style="q1" vid="PSA 78:50">ento omiyo two gemo onekogi woko.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:51: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Nia 12:29</ref>
      </char>
    </note>En oneko lutino kayo ducu ki i Ejipt,</para>
  <para style="q1" vid="PSA 78:51">ma gin jo ma gukwongo nywalo ki tekogi ki i kema pa Kam.<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:52: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:17-22">Nia 13:17-22</ref>
      </char>
    </note>Ka dong otelo wi lwake okelogi woko macalo lakwat romi,</para>
  <para style="q1" vid="PSA 78:52">obedo katelogi kun gwokogi i tim macalo lwak lim.<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:53: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:26-28">Nia 14:26-28</ref>
      </char>
    </note>En otelogi ki kuc, omiyo pe gubedo ki lworo;</para>
  <para style="q1" vid="PSA 78:53">ento nam aye omwonyo lukworgi woko.<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:54: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:17">Nia 15:17</ref>; <ref loc="JOS 3:14-17">Yoc 3:14-17</ref></char>
    </note>En okelogi i lobone maleng,</para>
  <para style="q1" vid="PSA 78:54">i got ma en omayo ki twerone i lweny ma en oloyo.<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:55: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 11:16-23">Yoc 11:16-23</ref>
      </char>
    </note>En oryemo lurok woko ki inyimgi;</para>
  <para style="q1" vid="PSA 78:55">ci opoko dul lobo ikin gi ma myero gucam obed meggi,</para>
  <para style="q1" vid="PSA 78:55">ci omiyo jo me kaka pa Icrael ducu gubedo mot i kemagi.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:56: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:11-15">Lung 2:11-15</ref>
      </char>
    </note>Ento jo Icrael gutemo Lubanga Mamalo Twal,</para>
  <para style="q1" vid="PSA 78:56">dok gujemo woko ikome,</para>
  <para style="q1" vid="PSA 78:56">kun pe gilubu loke me caden,<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />ento guloke gungayo wange woko macalo yam kwarigi gutimo;</para>
  <para style="q1" vid="PSA 78:57">guweke woko, gubole macalo atum ma ogom.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Gumiyo kiniga omake pi wang jogigi ma guketo iwi godigu;</para>
  <para style="q1" vid="PSA 78:58">gumiyo nyeko omake pi cal lubangagu ma gupayo.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Akemo omako Lubanga matek ikare ma oneno lok meno,</para>
  <para style="q1" vid="PSA 78:59">ci okwero jo Icrael woko marac tutwal.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:60: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 18:1">Yoc 18:1</ref>; <ref loc="JER 7:12-14">Jer 7:12-14</ref>; <ref loc="JER 26:6">26:6</ref></char>
    </note>Ci en obwoto kemane ma en bedo iye i Cilo ni woko,</para>
  <para style="q1" vid="PSA 78:60">ma en aye gang ma en yam bedo iye ikin dano.<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:61: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 4:4-22">1 Cam 4:4-22</ref>
      </char>
    </note>En omiyo Canduk me Gicike ma en aye lanyut me twerone woko wek kiter i opii,</para>
  <para style="q1" vid="PSA 78:61">lanen me deyone omiyo woko bot lumerok.<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Akemo onongo omake tutwal ikom lwake,</para>
  <para style="q1" vid="PSA 78:62">omiyo lukworgi onekogi woko ki pala lucwan.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Mac owango awobegi otyekogi woko liweng,</para>
  <para style="q1" vid="PSA 78:63">ki anyiragi bene pe dong giwero wer nyom mo.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />Kineko ajwakigi woko ki pala lucwan,</para>
  <para style="q1" vid="PSA 78:64">ci pe kiye montogi me kokogi.<verse eid="PSA 78:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Lacen Rwot opo litaku calo oco ki iwang nino,</para>
  <para style="q1" vid="PSA 78:65">calo oteka ma omer ki kongo bwino ka dong dange.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />En oryemo lukwore gudok cen,</para>
  <para style="q1" vid="PSA 78:66">dok lewic ma bedo nakanaka opoto ikomgi.<verse eid="PSA 78:66" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />En okwero kema pa Yucepu woko,</para>
  <para style="q1" vid="PSA 78:67">pe oyero kaka pa Epraim.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Ento oyero kaka pa Juda,</para>
  <para style="q1" vid="PSA 78:68">ki got Cion ma en maroni.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />En ogero kabedone maleng kunu, calo gange matye i polo;</para>
  <para style="q1" vid="PSA 78:69">ocibo ocung matek liking calo lobo,</para>
  <para style="q1" vid="PSA 78:69">ma en dong oketo bedo matwali.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:70: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:11-12">1 Cam 16:11-12</ref>; <ref loc="2SA 7:8">2 Cam 7:8</ref>; <ref loc="1CH 17:7">1 Tek 17:7</ref></char>
    </note>En oyero latice Daudi,</para>
  <para style="q1" vid="PSA 78:70">ci okwanye woko ki kakwayo romi;<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />En okwanye okele woko ki kagwoko mere romi ki lutinogi,</para>
  <para style="q1" vid="PSA 78:71">ci okete obedo lakwat pa jone Icrael,</para>
  <para style="q1" vid="PSA 78:71">omiye odoko lakwat pa likwayo pa Yakobo ma lwak pa Lubanga.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Daudi ogwokogi ki lengcwinye,</para>
  <para style="q1" vid="PSA 78:72">dok otelogi ki diro mada.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s1">Lega pi laro lobo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:1: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:8-10">2 Luk 25:8-10</ref>; <ref loc="2CH 36:17-19">2 Tek 36:17-19</ref>; <ref loc="JER 52:12-14">Jer 52:12-14</ref></char>
    </note>Ai Lubanga, lurok gubino gumayo lobo pa lwaki woko;</para>
  <para style="q1" vid="PSA 79:1">gubalo Ot meri malengi woko;</para>
  <para style="q1" vid="PSA 79:1">gujwero Jerucalem woko odong obur.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Gubwoto kom lutici ma oto me acama pa winyi me polo,</para>
  <para style="q1" vid="PSA 79:2">dok gubwoto kom joni ma geni bot lee tim wek gucam.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Guonyo remogi woko macalo kionyo pii,</para>
  <para style="q1" vid="PSA 79:3">orumu Jerucalem woko,</para>
  <para style="q1" vid="PSA 79:3">dok dano mo pe odong ma onongo myero oyikgi.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Rok ma gibedo ingetwa giloko lok agec ikomwa,</para>
  <para style="q1" vid="PSA 79:4">ma gicayowa dok gijwiyowa.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Ai Rwot, kiniga bimaki nakanaka?</para>
  <para style="q1" vid="PSA 79:5">Akemoni me nyeko bimede kun wang macalo mac?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Kiniga myero omaki ikom rok ma pe gingeyi,</para>
  <para style="q1" vid="PSA 79:6">ki ikom ker ducu ma pe giworo in.<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Gutyeko jo pa Yakobo woko,</para>
  <para style="q1" vid="PSA 79:7">gumiyo lobowa dong odoko obur.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Pe icul kwor ikomwa pi bal pa kwarowa;</para>
  <para style="q1" vid="PSA 79:8">wek kica omaki ikomwa oyotoyot,</para>
  <para style="q1" vid="PSA 79:8">pien piny dong oloyowa woko.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Konywa, Ai Lubanga lalarwa,</para>
  <para style="q1" vid="PSA 79:9">pi kelo deyo i nyingi;</para>
  <para style="q1" vid="PSA 79:9">larwa, dok iwek balwa,</para>
  <para style="q1" vid="PSA 79:9">wek dano guwor nyingi.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Pingo lurok myero gupeny ni,</para>
  <para style="q1" vid="PSA 79:10">“Lubangagi tye kwene?”</para>
  <para style="q1" vid="PSA 79:10">Cul kwor ikom lurok i nyimwa ma waneno</para>
  <para style="q1" vid="PSA 79:10">pi oyo remo pa lutici!<verse eid="PSA 79:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Winy cur pa lumabuc;</para>
  <para style="q1" vid="PSA 79:11">gwok jo ma dong kingolo kop me to iwigi ki tweroni maditi!<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Ai Rwot, cul kwor maromo tyen abiro ikom jo ma gibedo ingetwa</para>
  <para style="q1" vid="PSA 79:12">pi lok me yet ma giyeti kwede.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Ci wan lwaki, ma wan romini ma ikwayowani,</para>
  <para style="q1" vid="PSA 79:13">wabimiyo pwoc boti nakanaka;</para>
  <para style="q1" vid="PSA 79:13">wabipako nyingi nakanaka,</para>
  <para style="q1" vid="PSA 79:13">wan ki likwayowa ducu.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s1">Lega pi roco rok me Icrael</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:22">Nia 25:22</ref>
      </char>
    </note>Winywa, in lakwat pa jo Icrael, in ma itelo wi jo pa Yucepu</para>
  <para style="q1" vid="PSA 80:1">macalo itelo wi lwak romi!</para>
  <para style="q1" vid="PSA 80:1">In ma ibedo iwi komkeri i ka wi lukerubi,<verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />nyute bot kaka pa Epraim, pa Benjamin ki pa Manace!</para>
  <para style="q1" vid="PSA 80:2">Nyut teki, ci ibin ilarwa!<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Dwok lobowa wek odok tek kit ma con ca, Ai Lubanga;</para>
  <para style="q1" vid="PSA 80:3">nenwa ki wang me kica ci wabilare!<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />Ai Rwot Lubanga me mony,</para>
  <para style="q1" vid="PSA 80:4">ibibedo ki kiniga ikom lega pa lwaki pi kare marom mene?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Imiyo wacamo pig wangwa macalo wacamo kwon,</para>
  <para style="q1" vid="PSA 80:5">imiyowa pig wang pong kikopo madit ni wamati.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Imiyo jo ma bedo ingetwa dong gicayowa marac;</para>
  <para style="q1" vid="PSA 80:6">ki lukworwa bene ginyerowa anyera ikin gi ken gi.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Dwok lobowa wek odok tek kit ma con ca, Ai Lubanga;</para>
  <para style="q1" vid="PSA 80:7">nenwa ki wang me kica ci wabilare!<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />In aye mayam ikelowa ki i Ejipt macalo tyen olok;</para>
  <para style="q1" vid="PSA 80:8">ka iryemo lurok woko ki i lobogi ci ipitowa iye macalo oloki.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Ipuru kakare woko maber,</para>
  <para style="q1" vid="PSA 80:9">ci oroyo lwite odonyo matut i ngom,</para>
  <para style="q1" vid="PSA 80:9">omiyo odongo oumu lobo woko ducu.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Tipune oumu godi woko ducu,</para>
  <para style="q1" vid="PSA 80:10">oumu bene wa yadi cedar madito ki jangegu.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Jange ojany oo wa i nam,</para>
  <para style="q1" vid="PSA 80:11">ki pote ma pud lot alota oo wa i kulu Euprate.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Pingo imuku cel ma orumu woko,</para>
  <para style="q1" vid="PSA 80:12">omiyo iweko jo ducu makato kikenyo gupwono nyige?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Opego ma gibedo i bunga ginyono woko piny,</para>
  <para style="q1" vid="PSA 80:13">ki lee tim ducu gicamogi.<verse eid="PSA 80:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Loke idwog botwa, Ai Lubanga me mony!</para>
  <para style="q1" vid="PSA 80:14">Nen piny ki i polo ci inenwa;</para>
  <para style="q1" vid="PSA 80:14">bed ki tam ikom olok man,<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />bin ilar tyen olok man ma in aye ipitoni.<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Lumerok gutyeko wangone woko ki mac,</para>
  <para style="q1" vid="PSA 80:16">dok bene gutongo gureto woko piny;</para>
  <para style="q1" vid="PSA 80:16">nen gi ki kiniga ci ityekgi woko!<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Gwok jo ma dong ityeko yero,</para>
  <para style="q1" vid="PSA 80:17">en rok ma dong imiyo odongo odoko mateki.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Pe dok wabiloke wabwoto in;</para>
  <para style="q1" vid="PSA 80:18">gwokwa wabed kwo, ci wabipako nyingi.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Dwok lobowa wek odok tek kit ma con ca, Ai Lubanga;</para>
  <para style="q1" vid="PSA 80:19">nenwa ki wang me kica ci wabilare!<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s1">Wer pi karama me nino madito</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Wuwer wer ki dwon malongo bot Lubanga ma en tekwa;</para>
  <para style="q1" vid="PSA 81:1">wuwer wer me pak ki yomcwiny bot Lubanga pa Yakobo!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Wuwer dok wugo ajaa bene, wugo opuk ki nangagu.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:3: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 10:10">Wel 10:10</ref>
      </char>
    </note>Wukut tum ikare ma dwe pud opor apora,</para>
  <para style="q1" vid="PSA 81:3">dok ka dong ogudu got, ki i ninowa madito.<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Pien man obedo cik i Icrael,</para>
  <para style="q1" vid="PSA 81:4">gin ma Lubanga pa Yakobo yam ociko.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />En oketo cik man i kaka pa Yucepu,</para>
  <para style="q1" vid="PSA 81:5">ikare ma en owoto ocito kalweny ikom lobo Ejipt.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">Awinyo dwon mayam con pe angeyo, ma waco ni,<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />“Atingo yec mapek woko ki i gwoki;</para>
  <para style="q1" vid="PSA 81:6">amiyo iketo aduku woko piny.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:7">Nia 17:7</ref>; <ref loc="NUM 20:13">Wel 20:13</ref></char>
    </note>Ikok bota ikare ma itye ican, ci alari;</para>
  <para style="q1" vid="PSA 81:7">agamo dogi ki mor piny ki i kabedo me mung ma akane iye,</para>
  <para style="q1" vid="PSA 81:7">ci atemi bene inget pii me Meriba.<verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Wuwiny, wun jona, ka ajukuwu;</para>
  <para style="q1" vid="PSA 81:8">wun jo Icrael, amitoni wuwiny gin ma awaco botwu!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:2-3">Nia 20:2-3</ref>; <ref loc="DEU 5:6-7">Nwo 5:6-7</ref></char>
    </note>Pe myero kinong ikinwu kit lubanga mo ma pe ngene,</para>
  <para style="q1" vid="PSA 81:9">pe wuryebe piny ka woro lubanga pa lurok.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />An a Rwot Lubangawu,</para>
  <para style="q1" vid="PSA 81:10">ma akwanyowu, akelowu woko ki i lobo Ejipt.</para>
  <para style="q1" vid="PSA 81:10">Wungam dogwu malac, ci abipitowu ki cam.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />Ento jona pe guwinyo lok mayam aloko botgi;</para>
  <para style="q1" vid="PSA 81:11">jo Icrael onongo dong pe gitwero lubu cika kadi ki acel.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Pimeno omiyo awekogi woko pi tek wigi,</para>
  <para style="q1" vid="PSA 81:12">wek gutii gin ma cwinygi mito.<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />Kono nene jona guwinyo loka,</para>
  <para style="q1" vid="PSA 81:13">kono jo Icrael nene gulubu yona!<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />Kono onongo aloyo lukworgi woko oyotoyot,</para>
  <para style="q1" vid="PSA 81:14">kono aryeyo cinga ci atayo lumerokgi woko ducu.<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Kono onongo jo ma daga gumwole amwola inyima,</para>
  <para style="q1" vid="PSA 81:15">dok kono onongo can ma bipoto ikomgi obedo matwal.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Onongo atwero pitowu ki ngano maber tutwal,</para>
  <para style="q1" vid="PSA 81:16">dok onongo atwero miyo wuyeng ki moo kic matye ikom got.”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s1">Lubanga laloc madit makato ducu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />Lubanga dong obedo iwi kome i kacoke iwi polo,</para>
  <para style="q1" vid="PSA 82:1">ci ngolo kope i dye lwak lubanga ma gugure, kun waco ni,<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />“Pe wubingolo kop kakare pi kare marom mene,</para>
  <para style="q1" vid="PSA 82:2">kun wudworo kor jo maracu?<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Wungol kop pa lugoro ki pa jo ma won gi peke kakare;</para>
  <para style="q1" vid="PSA 82:3">wugwok twero pa jo matye ki can ki jo ma dong piny obwoyogi i yo mupore.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Wular lugoro ki jo ma piny obwoyogi;</para>
  <para style="q1" vid="PSA 82:4">wulargi ki i cing jo maracu.”<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />Pe gitye ki ngec, dok niang mo bene peke botgi,</para>
  <para style="q1" vid="PSA 82:5">giwoto meggi ata i colpiny;</para>
  <para style="q1" vid="PSA 82:5">ngolo kop atir orwenyo woko ki i lobo ducu omiyo lobo tye kayenge ayenga.<verse eid="PSA 82:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:6: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:34">Jon 10:34</ref>
      </char>
    </note>Awaco ni, “Wun wubedo lubanga,</para>
  <para style="q1" vid="PSA 82:6">wun ducu lutino pa Ngat Mamalo Twal!<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Kadi bed kumeno, wubito macalo dano,</para>
  <para style="q1" vid="PSA 82:7">dok bene wubipoto piny oto macalo rwot mo keken.”<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />A malo, Ai Lubanga, ingol kop ikom lobo;</para>
  <para style="q1" vid="PSA 82:8">rok ducu ma iwi lobo ni meri.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s1">Lega pi loyo lukwor pa jo Icrael</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />Ai Lubanga, pe iling;</para>
  <para style="q1" vid="PSA 83:1">pe ibed mot ki kuc ma iling woko, Ai Lubanga!<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Nen lukwori gitye kalweny ikomi;</para>
  <para style="q1" vid="PSA 83:2">jo ma gidagini dong gujemo woko.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Gitye kayubu yub mogo maracu imung ikom lwaki;</para>
  <para style="q1" vid="PSA 83:3">gicoke kacel giporo lok maracu ikom joni ma dong igwokogi wokoni.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Giwaco ni, “Wubin, wek watyek rokgi woko;</para>
  <para style="q1" vid="PSA 83:4">wek pe dong kipo pi nying Icrael matwal.”<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Eyo, gin ducu gipiro lok ki cwiny acel;</para>
  <para style="q1" vid="PSA 83:5">dok bene giketo gicike ikin gi me lweny ikomi.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />Gin jo Edom, ki jo Icmael, jo Moab ki jo Agri,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />jo Gebal, jo Ammon ki jo Amalek,</para>
  <para style="q1" vid="PSA 83:7">jo Piliciti ki jo ma gibedo i Turo.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Jo Aciria bene onongo guribe kwedgi;</para>
  <para style="q1" vid="PSA 83:8">gin aye dul mony matek pa likwayo pa Lot.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:9: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 4:6-22">Lung 4:6-22</ref>; <ref loc="JDG 7:1-23">7:1-23</ref></char>
    </note>Tim gin ma itimo ikom jo Midian ikomgi,</para>
  <para style="q1" vid="PSA 83:9">macalo itimo ikom Cicera ki Jabin i dog kulu Kicon,<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />ma kityekogi woko i En-dor,</para>
  <para style="q1" vid="PSA 83:10">ma kiradogi gudoko macalo cet dyang matye i lobo.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:11: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 7:25">Lung 7:25</ref>; <ref loc="JDG 8:12">8:12</ref></char>
    </note>Mii luditogi me awora gubed calo Oreb ki Jeeb,</para>
  <para style="q1" vid="PSA 83:11">dok ilo rwodigi woko macalo iloyo Jeba ki Jalmuna;<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />ma guwaco ni, “Wek wakwanyu obed pirwa kenwa,</para>
  <para style="q1" vid="PSA 83:12">en olet pa Lubangani.”<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Ai Lubangana, mii gubed macalo apwa ma yamo lapiru kolo,</para>
  <para style="q1" vid="PSA 83:13">calo cung kal ma yamo tero.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Kit macalo mac wango kwede bunga,</para>
  <para style="q1" vid="PSA 83:14">dok macalo leb mac matye kalyel iwi godi,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />in bene ibiryemogi ki yamo matek gicito woko kitmeno,</para>
  <para style="q1" vid="PSA 83:15">ci ibimiyo yamo lapiru mager kodo miyogi lworo ki myelkom.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />Mii lewic omakgi, Ai Rwot;</para>
  <para style="q1" vid="PSA 83:16">wek guloke guyenyi ci gutii boti.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Wek kiket lewic ikomgi dok omii cwinygi obale woko,</para>
  <para style="q1" vid="PSA 83:17">wek guto ican ki lewic madwong.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Wek gunge ni,</para>
  <para style="q1" vid="PSA 83:18">in keni aye ma nyingi Rwot,</para>
  <para style="q1" vid="PSA 83:18">in aye Ngat Mamalo Twal maloyo wi loboni ducu.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s1">Miti pi Ot pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />Odi ber tutwal Ai Rwot me mony!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Cwinya mito mada ni abed kunu!</para>
  <para style="q1" vid="PSA 84:2">Amito mada me bedo i dye kal pa Rwot.</para>
  <para style="q1" vid="PSA 84:2">Awero wer me pako Lubanga makwo ki yomcwiny madwong</para>
  <para style="q1" vid="PSA 84:2">kun amiyo iye kwona ducu.<verse eid="PSA 84:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Kadi lakalagwec bene tye ki ode,</para>
  <para style="q1" vid="PSA 84:3">ki aliboro bene tye ki ode kama en butu iye,</para>
  <para style="q1" vid="PSA 84:3">ki kama en twero bolo iye tonge,</para>
  <para style="q1" vid="PSA 84:3">macok ki keno tyeri, Ai Rwot me mony,</para>
  <para style="q1" vid="PSA 84:3">Rwota ma Lubangana.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Jo ma bedo i odi gitye ki gum,</para>
  <para style="q1" vid="PSA 84:4">ma gibedo kawero wer kun gipaki kare ducu!<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Komgi gum adada gin jo ma ginongo tek ma a ki boti,</para>
  <para style="q1" vid="PSA 84:5">gin jo matye ki cwiny me cito wa i Cion ka woro in.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Ka giwok gikato ki i nota me Baka mutwoni,</para>
  <para style="q1" vid="PSA 84:6">gimiyo doko wang it;</para>
  <para style="q1" vid="PSA 84:6">kot me poto kot bene cwer iye miyo pii pong ikabedo ducu.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Gimede gidoko tek ikare ma giwoto;</para>
  <para style="q1" vid="PSA 84:7">Lubanga maloyo lwak lubangagu ducu binen i Cion.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Winy legana, Ai Rwot Lubanga me mony;</para>
  <para style="q1" vid="PSA 84:8">cik iti iwinya, Ai Lubanga pa Yakobo!<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />In aye i kwotwa, Ai Lubanga;</para>
  <para style="q1" vid="PSA 84:9">nen ki kica danoni ma kiwiro ma in aye iyeroni!<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Bedo i dye kali pi nino acel keken ber</para>
  <para style="q1" vid="PSA 84:10">kato bedo kamukene pi nino alip.</para>
  <para style="q1" vid="PSA 84:10">Twora abedo lagwok dogola Ot pa Rwot,</para>
  <para style="q1" vid="PSA 84:10">kato ma abedo i kema kama tim maracu tye iye.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Rwot Lubanga aye ceng mewa dok kwotwa;</para>
  <para style="q1" vid="PSA 84:11">en onyo kicane ikomwa dok miyo wabedo ki deyo.</para>
  <para style="q1" vid="PSA 84:11">Rwot pe twono dano ma gilube ma cwinygi leng,</para>
  <para style="q1" vid="PSA 84:11">kit gin mo maber.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />Ai Rwot me mony,</para>
  <para style="q1" vid="PSA 84:12">dano ma geno in tye ki gum madwong!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s1">Lega pi timo kica ikom jo Icrael</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />Rwot, yam ibedo ki kica ikom loboni,</para>
  <para style="q1" vid="PSA 85:1">idwoko gum ikom jo pa Yakobo.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Yam iweko bal pa lwaki,</para>
  <para style="q1" vid="PSA 85:2">dok itimogi kica ikom roc ducu ma gutiyo.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Yam igiko bedo ki akemo ikomwa,</para>
  <para style="q1" vid="PSA 85:3">ci iloke ibwoto kinigani malyeti.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Mii wabed ki gum kit mayam con ca, Ai Lubanga lalarwa,</para>
  <para style="q1" vid="PSA 85:4">cwinyi pe omyero dong obed kawang ikomwa!<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Kiniga mono bimaki ikomwa matwal?</para>
  <para style="q1" vid="PSA 85:5">Ibimedo kinigani bedo ikom yalwak ki yalwak ducu?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Pe ibimiyo wanongo gum doki aye,</para>
  <para style="q1" vid="PSA 85:6">wek wan lwaki wabed ki yomcwiny piri?<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Ai Rwot, nyut botwa mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 85:7">dok imiwa lari.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Wek awiny gin ma Rwot Lubanga bilokone,</para>
  <para style="q1" vid="PSA 85:8">pien en biloko lok me kuc bot lwake,</para>
  <para style="q1" vid="PSA 85:8">bot jone ma gene, ma giloke ki i cwinygi gidwogo bote.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Adada, en tye ma oyube pi laro jo ma lwore,</para>
  <para style="q1" vid="PSA 85:9">wek deyo me larne obed i lobowa.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Mar ma pe loke ki gen gibiribe kacel,</para>
  <para style="q1" vid="PSA 85:10">kit ma atir ki kuc bene gibirwate.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Gen bia ki i lobo dongo malo,</para>
  <para style="q1" vid="PSA 85:11">Lubanga matye ki kit ma atir bineno piny ki i polo.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Eyo, Rwot bimiyo botwa gin maber,</para>
  <para style="q1" vid="PSA 85:12">ki lobowa bene biceko cam madwong.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Kit ma atir bitelo nyim Rwot,</para>
  <para style="q1" vid="PSA 85:13">dok biyubu yoo ma en biwot iye.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s1">Lega pi kwayo kony ki bot Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />Winy legana, Ai Rwot, dok igam doga,</para>
  <para style="q1" vid="PSA 86:1">pien an lacan, piny bene obwoya woko.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Lar kwona ki i to, pien atye ki mar me ada ikomi,</para>
  <para style="q1" vid="PSA 86:2">lara pien an latici dok ageno in.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />In Lubangana, pimeno bed ki kica ikoma, Ai Rwot,</para>
  <para style="q1" vid="PSA 86:3">akok boti dyeceng jwi.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Mii cwiny latici obed yom, Ai Rwot,</para>
  <para style="q1" vid="PSA 86:4">pien legana cito malo boti kun amiyi kwona ducu.<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Ai Rwot, in iber dok iweko bal pa dano,</para>
  <para style="q1" vid="PSA 86:5">dok mar meri ma pe loke dwong pi jo ducu ma kok boti.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Cik iti iwiny legana, Ai Rwot;</para>
  <para style="q1" vid="PSA 86:6">winy kokona ma abako kwede doga boti.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Ikare ma atye i can akok boti,</para>
  <para style="q1" vid="PSA 86:7">pien igamo doga.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Pe tye lubanga mo ikin lubanga mukenenigu macalo in,</para>
  <para style="q1" vid="PSA 86:8">dok pe tye kit tic mo marom ki tici.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:9: </char>
      <char style="xt" closed="false">
        <ref loc="REV 15:4">Niy 15:4</ref>
      </char>
    </note>Rok ducu ma icweyogi gibibino gibiryebe piny inyimi,</para>
  <para style="q1" vid="PSA 86:9">Ai Rwot, ci gibipako nyingi.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />In idit dok itiyo jami tango me aura mapol,</para>
  <para style="q1" vid="PSA 86:10">in aye Lubanga keni.<verse eid="PSA 86:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />Pwonya ki ciki, Ai Rwot,</para>
  <para style="q1" vid="PSA 86:11">wek atii gin ma imito;</para>
  <para style="q1" vid="PSA 86:11">mii abed lawiny ki bene abed lagen ikomi ci miyo abitiyo boti ki woro madit.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Amiyo pwoc boti ki cwinya ducu, Ai Rwot Lubangana,</para>
  <para style="q1" vid="PSA 86:12">abibedo kamiyo deyo boti kun atucu nyingi nakanaka.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Mar meri ma pe loke dit tutwal ikoma,</para>
  <para style="q1" vid="PSA 86:13">in aye ma ilara kare ma onongo atye kamatut ite bur lyel.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />Ai Lubanga, jo ma lunywar guero lweny ikoma;</para>
  <para style="q1" vid="PSA 86:14">dul pa jo ma lubwami gimito neka woko,</para>
  <para style="q1" vid="PSA 86:14">kun bene pe giketi anyim me telogi igin ducu.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Ento in, Ai Rwot, in Lubanga ma lakica dok i maro dano,</para>
  <para style="q1" vid="PSA 86:15">kiniga pe maki oyot, dok mar meri ma pe loke, ki geni, dwong.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Loke inena ci kica omaki ikoma;</para>
  <para style="q1" vid="PSA 86:16">ci imiya teko dok ilara,</para>
  <para style="q1" vid="PSA 86:16">pien atiyo boti, kit macalo yam maa otiyo kwede botini.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Nyuta lanyut ma tito pi beri bota, Ai Rwot,</para>
  <para style="q1" vid="PSA 86:17">wek lewic omak jo ma gidaga</para>
  <para style="q1" vid="PSA 86:17">ka gibineno ni, in dong ityeko kweyo cwinya dok ikonya.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s1">Wer me pak pi Jerucalem</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />Rwot ogero taun mere madit iwi got maleng;<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />dok en maro taun madit me Cion</para>
  <para style="q1" vid="PSA 87:2">makato kabedo mukeneni ducu ma jo pa Yakobo gibedo iye.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Winy, in taun madit pa Lubanga,</para>
  <para style="q1" vid="PSA 87:3">lok me aura me deyo ma en tye kalokone ikomi ni.<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />“Ikin jo ma ngeya abitucu nying Rakab ki Babilon;</para>
  <para style="q1" vid="PSA 87:4">dok abikwano Piliciti, Turo ki Etiopia</para>
  <para style="q1" vid="PSA 87:4">ikin jo ma kinywalogi kunu.”<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Ikom Cion gin biwaco ni,</para>
  <para style="q1" vid="PSA 87:5">“Dano man ki maca ducu kinywalogi iye”;</para>
  <para style="q1" vid="PSA 87:5">pien Ngat Mamalo Twal aye bimiyo Cion cung liking.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />Rwot bicoyo nying rok woko ducu kore ki kore, kun coyo ni,</para>
  <para style="q1" vid="PSA 87:6">“Man, kinywalo kunu, ki man bene kinywalo kunu.”<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Luwer ki lumyel ducu gibiwaco ni,</para>
  <para style="q1" vid="PSA 87:7">“Wang it me gumwa ducu tye i in.”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s1">Lega pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />Ai Rwot Lubanga, akok boti dyeceng jwi pi kony;</para>
  <para style="q1" vid="PSA 88:1">kadi i dyewor bene akok boti.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Winy legana,</para>
  <para style="q1" vid="PSA 88:2">cik iti iwiny kokona!<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Lwak can mapol opoto ikoma,</para>
  <para style="q1" vid="PSA 88:3">omiyo kwona dong onyiko cok ki to.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />An dong kikwana ikin jo macok ki to,</para>
  <para style="q1" vid="PSA 88:4">ma gibidonyo piny i bur;</para>
  <para style="q1" vid="PSA 88:4">tekona ducu dong otum woko.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Acalo ngat mo ma kibwoto ikin jo ma oto;</para>
  <para style="q1" vid="PSA 88:5">adoko calo jo ma kinekogi madong gubutu i lyelgi,</para>
  <para style="q1" vid="PSA 88:5">calo jo ma wii dong pe po ikomgi matwal,</para>
  <para style="q1" vid="PSA 88:5">ma dong gitye kamabor ma pe iromo konyogi.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />In dong ityeko bola woko ite bur kamatut,</para>
  <para style="q1" vid="PSA 88:6">ka macol dok matut adada.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Akemoni tye mapek ikoma,</para>
  <para style="q1" vid="PSA 88:7">imiyo amwony woko i biamwonyi me akemoni.<verse eid="PSA 88:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Imiyo lurema gutenya woko liyak;</para>
  <para style="q1" vid="PSA 88:8">imiyo adoko gin malik botgi.</para>
  <para style="q1" vid="PSA 88:8">Kiloro wiya woko i ot ma pe atwero lwi akato kamo keken;<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />wanga dong ocido woko pi cwercwiny.</para>
  <para style="q1" vid="PSA 88:9">Ai Rwot, akok boti nino ducu;</para>
  <para style="q1" vid="PSA 88:9">alegi kun atango cinga boti.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />In mono itiyo tango pi jo ma oto?</para>
  <para style="q1" vid="PSA 88:10">Tipugi mono gia malo kapaki?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Tika gitito pi mar meri ma pe loke wa i lyel,</para>
  <para style="q1" vid="PSA 88:11">nyo pi geni bene gibitito i lobo pa jo ma oto?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Tango me aura ma itiyogu ducu mono nen kunu i kabedo macoli,</para>
  <para style="q1" vid="PSA 88:12">nyo kony me lari binen i lobo pa jo ma wic owil ikomgi?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Ai Rwot akok boti pi kony,</para>
  <para style="q1" vid="PSA 88:13">odiko ki odiko ducu akelo legana inyimi.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Ai Rwot, pingo ibola woko?</para>
  <para style="q1" vid="PSA 88:14">Pingo ikane woko ki bota?<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Cake ma pud atidi abedo ki arem madwong ma onongo dong acok to;</para>
  <para style="q1" vid="PSA 88:15">abedo kaciro tim ma itimo ikoma makelo lworo,</para>
  <para style="q1" vid="PSA 88:15">koma dong oloc woko.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Akemoni ouma woko lipuk;</para>
  <para style="q1" vid="PSA 88:16">lwenyi mager ikoma otyeka woko.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Akemoni ki lwenyi giruma woko dyere dyeceng jwi calo lalele me pii,</para>
  <para style="q1" vid="PSA 88:17">ma uma woko lipuk tungi ki tungi.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Imiyo lurema macok kweda ma amaro ducu gutenya woko liyak;</para>
  <para style="q1" vid="PSA 88:18">colpiny aye dong odoko luwota.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s1">Wer ikare ma peko tye i lobo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Ai Rwot, abiwero wer nakanaka pi mar meri ma pe loke;</para>
  <para style="q1" vid="PSA 89:1">abitucu pi geni ki doga bot jo me yalwak ducu.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Angeyo ni mar meri ma pe loke bedo matwal,</para>
  <para style="q1" vid="PSA 89:2">geni bene tye ocung woko liking calo polo.<verse eid="PSA 89:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Iwaco ni, “Dong aketo gicike ki dano ma ayero,</para>
  <para style="q1" vid="PSA 89:3">akwongo kwong bot latica Daudi ni,<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:4: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:12-16">2 Cam 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Tek 17:11-14</ref>; <ref loc="PSA 132:11">Jab 132:11</ref>; <ref loc="ACT 2:30">Tic 2:30</ref></char>
    </note>‘Abimoko likwayi gibedo matwal,</para>
  <para style="q1" vid="PSA 89:4">dok abiketo komkeri cung pi kare pa yalwak ducu.’”<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />Ai Rwot, wek lwak ma i polo gupaki</para>
  <para style="q1" vid="PSA 89:5">pi tango me aura madong ityeko tiyogini,</para>
  <para style="q1" vid="PSA 89:5">wek guwer bene pi geni i coke pa joni maleng!<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Pe tye ngat mo i polo ma gitwero poro ki Rwot;</para>
  <para style="q1" vid="PSA 89:6">pe tye ngat mo kadi ki acel ikin lwak me polo marom kwedi, Rwot.<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />In aye Lubanga ma kilworo i coke pa jo maleng,</para>
  <para style="q1" vid="PSA 89:7">in idit dok iger iloyo jo ducu ma gurumi wokoni.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Ai Rwot Lubanga me mony,</para>
  <para style="q1" vid="PSA 89:8">anga matek calo in?</para>
  <para style="q1" vid="PSA 89:8">In lagen i jami ducu, Ai Rwot.<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Iloyo wa biamwonyi me nam ma twage;</para>
  <para style="q1" vid="PSA 89:9">ka biamwonyine otwage, ikweyogi woko cut.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Inyono Rakab piny ineko woko calo inyono geng lee ma oto,</para>
  <para style="q1" vid="PSA 89:10">ikeyo lukwori woko ducu pi tek me badi.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Polo ki lobo ducu meri;</para>
  <para style="q1" vid="PSA 89:11">lobo ki jami ducu matye iye in aye ma icweyogi.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />In aye ma icweyo lobo ma tung kumalo ki ma tung kupiny;</para>
  <para style="q1" vid="PSA 89:12">got Tabor ki got Kermon gipako nyingi ki yomcwiny madwong.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Itye kitwero madit mada;</para>
  <para style="q1" vid="PSA 89:13">teki dwong mada.<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Kit ma atir ki ngolo kop kakare aye guti me komkeri;</para>
  <para style="q1" vid="PSA 89:14">mar ma pe loke, ki gen, tye i gin ducu ma itiyo.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Gitye ki gum jo ma giwori kun giwero boti wer ki dwon malongo,</para>
  <para style="q1" vid="PSA 89:15">ma giwoto i dero me kicani, Ai Rwot.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Gibedo ki yomcwiny piri dyeceng jwi,</para>
  <para style="q1" vid="PSA 89:16">ma gidwori pi kiti mupore.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />In aye ma imiyogi tek miyo gubedo kideyo;</para>
  <para style="q1" vid="PSA 89:17">pi beri botwa miyo tekwa bene tinge malo.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />In aye i kwot ma gwokowa, Ai Rwot;</para>
  <para style="q1" vid="PSA 89:18">in Ngat Maleng pa Icrael imiyo botwa rwot me loyowa.<verse eid="PSA 89:18" /></para>
  <para style="s">Cike pa Lubanga bot Daudi</para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Yam con iloko ki latici ma lagen i ginanyuta, kun iwaco ni,</para>
  <para style="q1" vid="PSA 89:19">“Aketo lalukana ikom dano matye ki tek,</para>
  <para style="q1" vid="PSA 89:19">amiyo ngat ma ayero ki ikin lwak obedo iwi komker.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:20: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 13:14">1 Cam 13:14</ref>; <ref loc="ACT 13:22">Tic 13:22</ref>; <ref loc="1SA 16:12">1 Cam 16:12</ref></char>
    </note>Ayero latic ma mera Daudi,</para>
  <para style="q1" vid="PSA 89:20">awire ki moo maleng, aketo en obedo rwotwu.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Teka bibedo bote kare ducu,</para>
  <para style="q1" vid="PSA 89:21">twerona bimiyo en bedo tek.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Lukwore pe gibinongo yo me tayo en,</para>
  <para style="q1" vid="PSA 89:22">dok jo maracu pe gibiloye bene.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Abinyono lukwore woko piny ki inyime,</para>
  <para style="q1" vid="PSA 89:23">dok abineko jo madage woko liweng.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Abibedo kwede ki gen kun amare ki mar mera ma pe loke,</para>
  <para style="q1" vid="PSA 89:24">dok abimiye tek me loyo lukwore pi nyinga.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Abimiyo twero me loce mede o wa i nam madit,</para>
  <para style="q1" vid="PSA 89:25">dok abimiyo teke o wa i kulu Euprate.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />En bilwonga ni, ‘In i Wora, ki Lubangana;</para>
  <para style="q1" vid="PSA 89:26">in aye Got me larena.’<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:27: </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:5">Niy 1:5</ref>
      </char>
    </note>Abiloko en bedo latin kayo,</para>
  <para style="q1" vid="PSA 89:27">en bibedo rwot madit makato luker ducu ma iwi loboni.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Abigwoko mar mera ma pe loke nakanaka pire,</para>
  <para style="q1" vid="PSA 89:28">dok gicikena ikin an ki en bicung liking.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Abimiyo likwaye bedo rwodi kare ducu;</para>
  <para style="q1" vid="PSA 89:29">dok abimoko komkere bedo matwal macalo pol.<verse eid="PSA 89:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />Kace likwaye gibibwoto cika,</para>
  <para style="q1" vid="PSA 89:30">ma gibedo kun pe gilubu gin ma aciko;<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />kace guturu cika</para>
  <para style="q1" vid="PSA 89:31">ma pe gilubu cik ma amiyogi,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />ci abipwodogi ki odo pi balgi;</para>
  <para style="q1" vid="PSA 89:32">can madwong adada bipoto ikomgi pi balgi.<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Ento pe abikwanyo mar mera ma pe loke woko ki ikome,</para>
  <para style="q1" vid="PSA 89:33">dok pe abibwoto cikena bote matwal.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Pe abituru gicikena,</para>
  <para style="q1" vid="PSA 89:34">nyo kadi loko kit lok mo mayam dong otyeko a woko ki idoga.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Dong akwongo kwong kicel ma bibedo matwal inyinga maleng;</para>
  <para style="q1" vid="PSA 89:35">pe abiloko lok goba bot Daudi.<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />Kare ducu likwaye bibedo tye,</para>
  <para style="q1" vid="PSA 89:36">dok abigwoko kere bedo nakanaka calo ceng maryeny inyima.<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />Bibedo nakanaka ma omoko woko liking calo dwe matye ikabedone,</para>
  <para style="q1" vid="PSA 89:37">bicung woko matek liking calo polo ma oyare malo.”<verse eid="PSA 89:37" /></para>
  <para style="s">Koko pien kiloyo rwot</para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Ento kombedi kiniga dong omaki woko ikom rwot ma in aye i wiro ki moo;</para>
  <para style="q1" vid="PSA 89:38">dong itenye woko liyak dok ikwere woko adada.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Ityeko weko gicikeni woko ki latici,</para>
  <para style="q1" vid="PSA 89:39">ibolo lalukanane i apwa ibalo woko.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Ityeko muku cel me gange woko ducu;</para>
  <para style="q1" vid="PSA 89:40">cel gogone ducu dong ireto woko piny odoko obur.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Jo ma wok ki kenyo giyako jamine;</para>
  <para style="q1" vid="PSA 89:41">dong odoko gin me angala bot luwote ma gibedo cok kwede.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />In dong imiyo loc woko bot lumonene;</para>
  <para style="q1" vid="PSA 89:42">imiyo gin ducu gubedo ki yomcwiny.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Eyo, iloko lak pala lucwane odoko gin ma konye peke,</para>
  <para style="q1" vid="PSA 89:43">imiyo kiloye woko ilweny.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Ikwanyo odo kere woko ki i cinge,</para>
  <para style="q1" vid="PSA 89:44">ka ikwanyo komkere ituru ibolo woko piny i ngom.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Imiyo en otegi otii woko ma pud tidi,</para>
  <para style="q1" vid="PSA 89:45">ci ileyo wiye woko.<verse eid="PSA 89:45" /></para>
  <para style="s">Lega pi lar</para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />Ai Rwot, ibikane woko matwal?</para>
  <para style="q1" vid="PSA 89:46">Dok akemoni bibedo kawang calo mac pi kare marom mene?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Ai Rwot, po kit ma kare me kwona nok kwede,</para>
  <para style="q1" vid="PSA 89:47">dok ipo ni dano ma icweyoni ducu mwa!<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Anga matwero bedo kun pe to?</para>
  <para style="q1" vid="PSA 89:48">Dok anga matwero lare kene ki ikom twero me lyel?<verse eid="PSA 89:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Rwot, tic ducu mayam itiyo, ki mar meri ma pe lokeni, dong gitye kwene?</para>
  <para style="q1" vid="PSA 89:49">Geni ma ikwongo kwede kwong bot Daudini kono tye kwene?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Ai Rwot, po ikoma an latici, nen kit ma kiyeta kwede,</para>
  <para style="q1" vid="PSA 89:50">nen kit ma atye kaciro kwede yet pa lwak me rok ducu.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />Ai Rwot, nen kit ma lukwori giloko kwede lok agec,</para>
  <para style="q1" vid="PSA 89:51">kun bene giyeto dano ma in aye i wiro ki moo ikabedo ducu ma en woto iye.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />Kipak Rwot nakanaka!</para>
  <para style="q1" vid="PSA 89:52">Amen! Amen!<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">BUK ME ANGWEN</para>
  <para style="mr">
    <ref loc="PSA 90-106">Jab 90—106</ref></para>
  <para style="s1">Goro pa dano ki teko pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Rwot, in aye ibedo kalarewa</para>
  <para style="q1" vid="PSA 90:1">ikare ducu.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />In Lubanga ma bedo nakanaka;</para>
  <para style="q1" vid="PSA 90:2">ma pud peya icweyo godi ki lobo,</para>
  <para style="q1" vid="PSA 90:2">onongo in dong itye.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Iloko dano doko apwa,</para>
  <para style="q1" vid="PSA 90:3">kun iwaco ni, “Wudok cen, wun lutino pa dano!”<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:4: </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:8">2 Pet 3:8</ref>
      </char>
    </note>Mwaka alip kulu ki boti rom ki nino ma okato laworo;</para>
  <para style="q1" vid="PSA 90:4">nyo rom ki cawa acel ma i dyewor.<verse eid="PSA 90:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Ijwero dano woko, ci gikato calo lek,</para>
  <para style="q1" vid="PSA 90:5">gin calo lum ma lot odiko,<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />ci dongo;</para>
  <para style="q1" vid="PSA 90:6">otyeno ner, ci two woko.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Akemoni tyekowa woko;</para>
  <para style="q1" vid="PSA 90:7">kinigani miyowa lworo madwong.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Ityeko keto gin maracu ducu ma watimo inyimi,</para>
  <para style="q1" vid="PSA 90:8">wa balwa ma watimo i mung ducu nen iwangi kamaleng.<verse eid="PSA 90:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Kare me kwowa kato akata ki ite akemoni,</para>
  <para style="q1" vid="PSA 90:9">mwakawa bene tum woko, ikare manok tutwal.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Kare me kwowa twero romo mwaka pyere abiro,</para>
  <para style="q1" vid="PSA 90:10">nyo pyere aboro ka komwa yot;</para>
  <para style="q1" vid="PSA 90:10">ento gin ducu kelo can ki ayelayela keken,</para>
  <para style="q1" vid="PSA 90:10">pien gikato akata oyot, wangwa bene rwenyo woko.<verse eid="PSA 90:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Anga ma niang ikom teko me akemoni,</para>
  <para style="q1" vid="PSA 90:11">ki pi lworo ma kinigani kelo?<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Pwonywa me niang ni nino me kwowa cek tutwal,</para>
  <para style="q1" vid="PSA 90:12">wek wabed ki cwiny me ryeko.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Lok cwinyi, Ai Rwot!</para>
  <para style="q1" vid="PSA 90:13">Imito wanen can pi kare marom mene?</para>
  <para style="q1" vid="PSA 90:13">Wek kica omaki ikom lutici!<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Kwe cwinywa i odiko ki mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 90:14">wek wawer wer wabed ki yomcwiny pi kare me kwo mewa ducu.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Miwa yomcwiny pi kare marom ki nino ma imiyowa iye can;</para>
  <para style="q1" vid="PSA 90:15">marom bene ki mwaka ma walimo iye ayelayela.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Wek wan lutici wanen tic meri,</para>
  <para style="q1" vid="PSA 90:16">wek deyo me tek meri onen bene bot lutinowa.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Rwot Lubangawa, wek gum meri obed ikomwa;</para>
  <para style="q1" vid="PSA 90:17">mok ticwa ducu ma watiyo wek obed maber!</para>
  <para style="q1" vid="PSA 90:17">Eyo, mok tic mewa ducu ma watiyo wek obed maber!<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s1">Lubanga aye lagwokwa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Ngat ma bedo i kakane pa en Mamalo Twal,</para>
  <para style="q1" vid="PSA 91:1">ki ma bedo ite gwok pa Won Twer Ducu,<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />en biwaco bot Rwot ni, “In aye kalarena ki cela,</para>
  <para style="q1" vid="PSA 91:2">in Lubangana ma ageno.”<verse eid="PSA 91:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />En aye ma bilari ki i owic ma kiciko me maki,</para>
  <para style="q1" vid="PSA 91:3">ki i two gemo maracu ma neko dano.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />En biumi ki bwome,</para>
  <para style="q1" vid="PSA 91:4">ibiringo kalare ite bwome,</para>
  <para style="q1" vid="PSA 91:4">genene en aye kwot ki gin ma gengo kori.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Pe ibilworo gin marac i dyewor,</para>
  <para style="q1" vid="PSA 91:5">nyo kadi atero ma gicelo i dyeceng,<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />kadi two gemo ma neko dano atura i colpiny,</para>
  <para style="q1" vid="PSA 91:6">nyo can ma poto nekogi i dyeceng.<verse eid="PSA 91:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Jo alip gitwero to ka ngeti,</para>
  <para style="q1" vid="PSA 91:7">ki jo alip apar i tung cingi ma lacuc;</para>
  <para style="q1" vid="PSA 91:7">ento gin mo pe bigudu komi.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Ibineno ki wangi keken,</para>
  <para style="q1" vid="PSA 91:8">kit pwod ma kibipwodo ki lutim maracu.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Pien dong imiyo Rwot odoko kalareni,</para>
  <para style="q1" vid="PSA 91:9">en Mamalo Twal dong odoko kabedoni,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />pimeno can mo pe bipoto ikomi,</para>
  <para style="q1" vid="PSA 91:10">kit gemo mo bene pe bibino cok ki kemani.<verse eid="PSA 91:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:11: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:6">Mat 4:6</ref>; <ref loc="LUK 4:10">Luk 4:10</ref></char>
    </note> Lubanga biciko lumalaikane piri</para>
  <para style="q1" vid="PSA 91:11">me gwoki kama iwoto iye ducu.<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:12: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:6">Mat 4:6</ref>; <ref loc="LUK 4:11">Luk 4:11</ref></char>
    </note>Gin gibijoli ki cinggi,</para>
  <para style="q1" vid="PSA 91:12">wek pe iyok tyeni ikom got.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:19">Luk 10:19</ref>
      </char>
    </note>Ibinyono labwor ki ororo,</para>
  <para style="q1" vid="PSA 91:13">ibitoro latin labwor ki twol piny i ngom ki tyeni.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />Lubanga owaco ni, “Abilaro jo ducu ma mara,</para>
  <para style="q1" vid="PSA 91:14">ki abigwoko, jo ducu ma ngeya ni an a Rwot.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Ka gukok bota, ci abigamo doggi;</para>
  <para style="q1" vid="PSA 91:15">abibedo kwedgi ikare me can,</para>
  <para style="q1" vid="PSA 91:15">abilarogi dok abiketo deyo ikomgi.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Abimiyogi mot me bedo ki kwo ma rii pi mwaka mapol i lobo,</para>
  <para style="q1" vid="PSA 91:16">ci abimiyo gingeyo ni an aye alaro dano.”<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s1">Wer me pako Rwot pi ber mere</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Miyo pwoc bot Rwot en gin maber,</para>
  <para style="q1" vid="PSA 92:1">wero wer me pako nyingi bene en gin maber, Ai in Mamalo Twal.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />Tucu mar meri ma pe loke i odiko ber,</para>
  <para style="q1" vid="PSA 92:2">ki nyutu gen meri otyeno bene ber,<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />kun gigoyo nanga ki gita dok giwero ki nyamulere,</para>
  <para style="q1" vid="PSA 92:3">ma gilubu dwon opuk bene.<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Pien in, Ai Rwot, pi tici me aura ma itiyo omiyo abedo ki yomcwiny,</para>
  <para style="q1" vid="PSA 92:4">pi tic ma dong itiyo miyo awero wer ki yomcwiny.<verse eid="PSA 92:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Tici dito ma lapore peke, Ai Rwot!</para>
  <para style="q1" vid="PSA 92:5">Dok tami tut ma pe tite!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Dano ma laming pe twero ngeyo lok man,</para>
  <para style="q1" vid="PSA 92:6">dok dano ma wiye oding pe twero niang ikom lok man ni:<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />kadi lubal gudongo macalo lum,</para>
  <para style="q1" vid="PSA 92:7">dok kadi lutim maracu gubedo ki kwo maber,</para>
  <para style="q1" vid="PSA 92:7">ento kibityekogi woko matwal.<verse eid="PSA 92:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Ento in, Ai Rwot, ibedo dit nakanaka.<verse eid="PSA 92:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Lumeroki, Ai Rwot,</para>
  <para style="q1" vid="PSA 92:9">i ada kibinekogi woko liweng,</para>
  <para style="q1" vid="PSA 92:9">jo ducu ma gin lutim maracu kibiketogi ci gilal woko ata.<verse eid="PSA 92:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Imiyo adoko tek macalo jubi ma i tim,</para>
  <para style="q1" vid="PSA 92:10">ityeko wiro wiya woko ki moo maber.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Atyeko neno can ma poto ikom lukwora ki wanga,</para>
  <para style="q1" vid="PSA 92:11">dok atyeko winyo ki ita kit koko ma jo maracu</para>
  <para style="q1" vid="PSA 92:11">ma onongo gutinge ikoma gikok kwede.<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />Jo ma kitgi atir gidongo calo yadi otit,</para>
  <para style="q1" vid="PSA 92:12">gidongo maboco calo yadi cedar me Lebanon.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />Kipitogi i Ot pa Rwot,</para>
  <para style="q1" vid="PSA 92:13">gidongo ma gituru idyekal me Ot pa Lubangawa.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Kadi gutii ento pud ginyako nyiggi,</para>
  <para style="q1" vid="PSA 92:14">piggi bedo madwong.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />Man nyutu ni Rwot kite tye atir, en gota, ma pe tiyo gin mo ma pe opore nyo marac.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s1">Lubanga aye Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />Rwot en laloc madit, en oruke kideyo me twere;</para>
  <para style="q1" vid="PSA 93:1">Rwot dong oruke, ma otweyo pyere ki tek.</para>
  <para style="q1" vid="PSA 93:1">Eyo, en omiyo lobo dong ocung matek, pe kiromo dirone;<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />komkeri omoko matek;</para>
  <para style="q1" vid="PSA 93:2">nia wa con onongo in dong itye.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />Nam madongo dong otyeko mor, Ai Rwot,</para>
  <para style="q1" vid="PSA 93:3">nam madongo dong oilo dwon gi kun mor matek;</para>
  <para style="q1" vid="PSA 93:3">ma gitwage itwok nam ci gimol liwolwol.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Rwot tye kaloc kideyo madit i polo. Rwot dit kato mor me pii madwong,</para>
  <para style="q1" vid="PSA 93:4">twer me deyone kato biamwonyi me nam.</para>
  <para style="q1" vid="PSA 93:4">Rwot ma bedo i polo tye ki deyo.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Ciki pe loke matwal, Ai Rwot;</para>
  <para style="q1" vid="PSA 93:5">Ot meri leng adada,</para>
  <para style="q1" vid="PSA 93:5">dok bedo kitmeno nakanaka.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s1">Lubanga langolkop pa jo ducu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />Ai Rwot, in Lubanga ma lacul kwor,</para>
  <para style="q1" vid="PSA 94:1">in Lubanga ma lacul kwor, nyut akemoni.<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />A malo, in langolkop me lobo;</para>
  <para style="q1" vid="PSA 94:2">cul kwor ikom jo ma wake muporo timgi.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />Jo maracu gibibedo ki yomcwiny pi kare marom mene,</para>
  <para style="q1" vid="PSA 94:3">pi kare marom mene ka, Ai Rwot?<verse eid="PSA 94:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Giloko lok me cac ki wakegu,</para>
  <para style="q1" vid="PSA 94:4">lutim maracu ducu gin jo ma luwake.<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Ginginyo joni woko, Ai Rwot,</para>
  <para style="q1" vid="PSA 94:5">giketo can ikom joni ma gin ginaleyani.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Gineko wa mon to ki jo ma gin lubedo,</para>
  <para style="q1" vid="PSA 94:6">gineko wa lutino kic bene.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Gin waco ni, “Rwot pe neno;</para>
  <para style="q1" vid="PSA 94:7">Lubanga pa Yakobo pe ngeyo gin mo iye.”<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Wuniang, wun jo ma wiwu pe tiyo!</para>
  <para style="q1" vid="PSA 94:8">Wun luming mono wubidoko ryek awene?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />En ngat muketo it mono pe winyo?</para>
  <para style="q1" vid="PSA 94:9">En ngat mucweyo wang kono pe neno?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />En ma pwodo lurok, pe bipwodowu?</para>
  <para style="q1" vid="PSA 94:10">En ma pwonyo dano ki ryeko, pe ngeyo gin mo?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:11: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 3:20">1 Kor 3:20</ref>
      </char>
    </note>Rwot ngeyo tam pa dano,</para>
  <para style="q1" vid="PSA 94:11">ni gicalo aluu dog me yweyo keken.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />Dano ma in itiro tye ki gum, Ai Rwot,</para>
  <para style="q1" vid="PSA 94:12">ki dano ma ipwonyo ki lok me ciki.<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Imiyo giywe ikare me can,</para>
  <para style="q1" vid="PSA 94:13">nio ka kikwinyo bur me mako jo maracu.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Rwot pe bibwoto jone,</para>
  <para style="q1" vid="PSA 94:14">pe biweko jo ma gin mere kikome.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Kibingolo kop atir pi jo ma kitgi atir,</para>
  <para style="q1" vid="PSA 94:15">jo ma cwinygi atir gibilubune.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Anga matwero tinge ikom jo maracu?</para>
  <para style="q1" vid="PSA 94:16">Anga ma bicung ma kakara ikom lutim maracu?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Ka kono Rwot pe okonya,</para>
  <para style="q1" vid="PSA 94:17">tipuna kono onongo ocito woko oyot i lobo me lingo.<note caller="+" style="f"><char style="fr" closed="false">94:17 </char><char style="fk">Lobo me lingo </char> gonye ni lobo pa jo ma oto. </note><verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Ikare ma atamo ni, “Tyena tye kacer,”</para>
  <para style="q1" vid="PSA 94:18">mar meri ma pe loke okonya adada, Ai Rwot.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Ka abedo katamo pi jami mapol,</para>
  <para style="q1" vid="PSA 94:19">in kikomi aye ikweyo cwinya.<verse eid="PSA 94:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Jo maracu ma gin luloc gitwero ribe kwedi ningning,</para>
  <para style="q1" vid="PSA 94:20">ma giloko lok marac doko cik?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />Gicoke kacel kaneko dano ma kite atir,</para>
  <para style="q1" vid="PSA 94:21">dok gingolo kop me to ikom dano ma peke ki bal.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Ento Rwot aye dong cela,</para>
  <para style="q1" vid="PSA 94:22">en got me kalarena.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />En bidwoko balgi i wigi ken gi,</para>
  <para style="q1" vid="PSA 94:23">ci bityekogi woko pi timgi maracuni;</para>
  <para style="q1" vid="PSA 94:23">Rwot Lubangawa bityekogi woko.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s1">Wer me pako Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Wubin waweru bot Rwot;</para>
  <para style="q1" vid="PSA 95:1">wek cwinywa obed yom ikom got me larewa!<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Wabin wunu inyime kamiyo pwocwa;</para>
  <para style="q1" vid="PSA 95:2">wawer bote wer me pak ki yomcwiny!<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Rwot en aye Lubanga madit,</para>
  <para style="q1" vid="PSA 95:3">en Rwot madit makato lubanga mukene ducu.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Nota me lobo tye i twerone;</para>
  <para style="q1" vid="PSA 95:4">lacol wi godi gin mere bene.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Nam mere, pien en ma otiyo,</para>
  <para style="q1" vid="PSA 95:5">lobo bene mere, ma en ocweyo ki cinge.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Wubin wunu waryebe piny wawore,</para>
  <para style="q1" vid="PSA 95:6">warumu congwa inyim Rwot, en ma ocweyowa.<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:7: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 3:15">Ibru 3:15</ref>; <ref loc="HEB 4:7">4:7</ref></char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">95:7: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 3:7-11">Ibru 3:7-11</ref>
      </char>
    </note>Pien en aye Lubangawa,</para>
  <para style="q1" vid="PSA 95:7">wan jone ma en kwayo,</para>
  <para style="q1" vid="PSA 95:7">dok wan romi ma en aye gwoko.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">Wuwiny dwone tin ni,<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Nia 17:1-7</ref>; <ref loc="NUM 20:2-13">Wel 20:2-13</ref></char>
    </note>“Pe myero wumii cwinywu obed nwang macalo yam wutimo i Meriba,</para>
  <para style="q1" vid="PSA 95:8">macalo wutimo ikare ma wutye i Maca i tim.<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />Ikare meno kwariwu yam gutema,</para>
  <para style="q1" vid="PSA 95:9">kun gimito lanyut,</para>
  <para style="q1" vid="PSA 95:9">kadi bed guneno tica ma atiyo pirgi ki wanggi.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Cwinya okwero lwak meno woko pi mwaka pyere angwen;</para>
  <para style="q1" vid="PSA 95:10">omiyo awaco ni, ‘Gin lwak ma gungak woko ki i cwinygi, ma pe bene gulubu cika.’<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:11: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:20-23">Wel 14:20-23</ref>; <ref loc="DEU 1:34-36">Nwo 1:34-36</ref>; <ref loc="DEU 12:9-10">12:9-10</ref>; <ref loc="HEB 4:3-5">Ibru 4:3-5</ref></char>
    </note>Ma omiyo akwongo kwong ki kiniga ni,</para>
  <para style="q1" vid="PSA 95:11">‘Pe gibidonyo i lobo kama abimiyogi iye yweyo.’”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s1">Lubanga en Rwot Madit</para>
  <para style="r">(<ref loc="1CH 16:23-33">1 Tek 16:23-33</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Wuwer bot Rwot wer manyen;</para>
  <para style="q1" vid="PSA 96:1">wuwer bot Rwot, wun lobo ducu!<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Wuwer bot Rwot, wupwo nyinge;</para>
  <para style="q1" vid="PSA 96:2">wutit nino ki nino ni en dong otyeko larowa.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Wutuc pi deyone bot lurok</para>
  <para style="q1" vid="PSA 96:3">wutit pi tice me aura bot rok ducu!<verse eid="PSA 96:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Rwot dit, myero kipake tutwal</para>
  <para style="q1" vid="PSA 96:4">myero kilwore makato lubanga mukene ducu.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Pien lubanga pa lurok ducu gin cal jogi apaya,</para>
  <para style="q1" vid="PSA 96:5">ento Rwot aye ocweyo polo.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Deyo ki dit tye bote</para>
  <para style="q1" vid="PSA 96:6">tek ki ber tye ikabedo mere maleng.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:1-2">Jab 29:1-2</ref>
      </char>
    </note>Wun kaka me rok ducu,</para>
  <para style="q1" vid="PSA 96:7">wumii deyo ki tek bot Rwot!<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Wumii deyo bot Rwot muporo nyinge;</para>
  <para style="q1" vid="PSA 96:8">wukel gityer, wubin wa i dyekale!<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Wuwor Rwot en ngat maleng ka otuc ki deyone;</para>
  <para style="q1" vid="PSA 96:9">komwu omyel inyime, wun lobo ducu!<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Wutit ikin lurok ni, “Rwot tye kaloc!</para>
  <para style="q1" vid="PSA 96:10">Ada, lobo ocung matek ma pe yenge;</para>
  <para style="q1" vid="PSA 96:10">en bingolo kop ikom dano maromrom.”<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Polo iye obed yom, lobo bene obed ma cwinye yom,</para>
  <para style="q1" vid="PSA 96:11">wek nam omor, ki jami ducu matye iye;<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />wek poto obed ki yomcwiny, ki jami ducu matye iye!</para>
  <para style="q1" vid="PSA 96:12">Man bimiyo yadi ma i bunga ducu, giwero wer ki yomcwiny<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />inyim Rwot, pien tye kabino kangolo kop ki lobo.</para>
  <para style="q1" vid="PSA 96:13">En bingolo kop matye atir ikom lobo;</para>
  <para style="q1" vid="PSA 96:13">bingolo kop ikom rok ducu ki adane.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s1">Lubanga en laloc madit</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />Rwot tye kaloc; wek lobo obed ki yomcwiny;</para>
  <para style="q1" vid="PSA 97:1">wek lobo ma i dog nam ducu cwinygi obed yom!<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Pol ki mutu ma ocido licuc orumu en woko dyere;</para>
  <para style="q1" vid="PSA 97:2">kit ma atir ki ngolo kop matye atir aye miyo komkere cung matek.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Mac telo nyime,</para>
  <para style="q1" vid="PSA 97:3">kun wango lumeroke ma gugure dyereni woko.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Dero ma mere mil menyo lobo;</para>
  <para style="q1" vid="PSA 97:4">lobo neno ci yenge.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Godi leny inyim Rwot calo odok kic,</para>
  <para style="q1" vid="PSA 97:5">inyim Rwot me lobo ducu.<verse eid="PSA 97:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Polo tito pi porene;</para>
  <para style="q1" vid="PSA 97:6">ki lwak me rok ducu gineno deyone.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Jo ducu ma woro cal jogi ma kipayo lewic bimakogi,</para>
  <para style="q1" vid="PSA 97:7">gin jo ma wake pi cal jogi ma gupayo;</para>
  <para style="q1" vid="PSA 97:7">dok lwak lubangagu ducu giryebe piny inyim Rwot.<verse eid="PSA 97:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Jo Cion giwinyo ci gibedo ki yomcwiny,</para>
  <para style="q1" vid="PSA 97:8">ki taun madito ducu me Juda cwinygi yom ma pe twere,</para>
  <para style="q1" vid="PSA 97:8">pi kop ma ingolo, Ai Lubanga.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Pien in Ngat Mamalo Twal ibedo laloc me lobo ducu, Ai Rwot;</para>
  <para style="q1" vid="PSA 97:9">in idit ikato lubanga mukene ducu.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Rwot maro jo ma dag gin marac;</para>
  <para style="q1" vid="PSA 97:10">en gwoko kwo pa jone ma gene;</para>
  <para style="q1" vid="PSA 97:10">en larogi woko ki i cing jo maracu.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Derone ryeny pi jo ma kitgi atir,</para>
  <para style="q1" vid="PSA 97:11">en bene miyo yomcwiny bot jo ma cwinygi atir.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Wubed ki yomcwiny i Rwot, wun jo ma kitwu atir,</para>
  <para style="q1" vid="PSA 97:12">wupwo nyinge maleng!<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s1">Lubanga aye laloc maloyo lobo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Wuwer wer manyen bot Rwot,</para>
  <para style="q1" vid="PSA 98:1">pien en dong otyeko tiyo jami me aura!</para>
  <para style="q1" vid="PSA 98:1">Tek mere ki kerune maleng omiyo en oloyo lweny.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />Rwot dong omiyo loce ongene,</para>
  <para style="q1" vid="PSA 98:2">en dong otyeko nyutu porene kamaleng inyim lurok ducu.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />En opo ikom mar mere ma pe loke kacel ki genene</para>
  <para style="q1" vid="PSA 98:3">bot jo me ot pa Icrael.</para>
  <para style="q1" vid="PSA 98:3">Wa i agiki me piny loc pa Lubangawa dong onen iye.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Wudange ki yomcwiny inyim Rwot wun lobo ducu;</para>
  <para style="q1" vid="PSA 98:4">wupake ki wer kun wudange ki yomcwiny.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Wuwer wer me pak bot Rwot ki opuk;</para>
  <para style="q1" vid="PSA 98:5">wuwer kun wugoyo opuk ki dwon mamit!<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />Wukut tum ki obute,</para>
  <para style="q1" vid="PSA 98:6">wudange ki yomcwiny inyim Laloc, ma en aye Rwot!<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Wek nam omor, ki gin mupong iye,</para>
  <para style="q1" vid="PSA 98:7">lobo kacel ki jo ducu ma bedo iye bene guwer!<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Wek nam gudong cinggi,</para>
  <para style="q1" vid="PSA 98:8">wek godi ducu guwer kacel ki yomcwiny<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />inyim Rwot, pien tye kabino kangolo kop ikom lobo.</para>
  <para style="q1" vid="PSA 98:9">En bingolo kop ma atir ikom lobo,</para>
  <para style="q1" vid="PSA 98:9">en bingolo kop pi lwak me rok ducu ki ada ma pe lenge ikom ngat mo.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s1">Lubanga en Rwot maloyo ducu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:22">Nia 25:22</ref>
      </char>
    </note>Rwot tye kaloc, wek rok ducu komgi omyel!</para>
  <para style="q1" vid="PSA 99:1">En obedo iwi komker mere ma kicibo iwi lukerubi; wek lobo oyenge!<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />Rwot dit i Cion;</para>
  <para style="q1" vid="PSA 99:2">en loyo lwak me rok ducu.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Wek dano ducu gupak nyingi madit me deyo makelo lworo!</para>
  <para style="q1" vid="PSA 99:3">En obedo ngat maleng!<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />In i Rwot matek, ma maro ngolo kop kakare,</para>
  <para style="q1" vid="PSA 99:4">in aye ma ikelo ngolo kop ki ada ma pe i lenge ikom ngat mo:</para>
  <para style="q1" vid="PSA 99:4">ikelo ngolo kop kakare ki kit ma atir,</para>
  <para style="q1" vid="PSA 99:4">imiyo ngolo kop ma atir omoko matek ikin jo pa Yakobo.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Wudwor Rwot Lubangawa,</para>
  <para style="q1" vid="PSA 99:5">wuwore inyim kom me teno tyene.</para>
  <para style="q1" vid="PSA 99:5">En obedo ngat maleng!<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Moses ki Aron bene onongo gubedo tye ikin ajwakine,</para>
  <para style="q1" vid="PSA 99:6">Camuel bene onongo tye ikin jo ma gilwongo nyinge.</para>
  <para style="q1" vid="PSA 99:6">Gukok bot Rwot, ci Rwot ogamo doggi.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 33:9">Nia 33:9</ref>
      </char>
    </note>En oloko kwedgi ki i wir pol;</para>
  <para style="q1" vid="PSA 99:7">gugwoko lok me cadene,</para>
  <para style="q1" vid="PSA 99:7">ki cik ma en omiyo botgi.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />Ai Rwot Lubangawa, in ceng igamo doggi,</para>
  <para style="q1" vid="PSA 99:8">inyutu bot lwaki ni, in Lubanga ma lawek bal,</para>
  <para style="q1" vid="PSA 99:8">ento ibedo laculkwor me gin maracu ma gutiyo.<verse eid="PSA 99:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Wudwor Rwot Lubangawa,</para>
  <para style="q1" vid="PSA 99:9">dok wuwore iwi got mere maleng;</para>
  <para style="q1" vid="PSA 99:9">pien Rwot Lubangawa leng.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s1">Wer me pak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Wuwer ki dwon me yomcwiny bot Rwot,</para>
  <para style="q1" vid="PSA 100:1">wun lobo ducu!<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />Wuwor Rwot ki yomcwiny,</para>
  <para style="q1" vid="PSA 100:2">wubin inyime ki wer me yomcwiny!<verse eid="PSA 100:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Wunge ni Rwot en Lubanga!</para>
  <para style="q1" vid="PSA 100:3">En aye ocweyowa, wan wa danone,</para>
  <para style="q1" vid="PSA 100:3">wan jone dok romi ma en kwayogi.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Wudony i dog gang mere ki pwoc,</para>
  <para style="q1" vid="PSA 100:4">ki idyekal mere kun wupake,</para>
  <para style="q1" vid="PSA 100:4">wupwoye, wupwo nyinge!<verse eid="PSA 100:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">100:5: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Tek 16:34</ref>; <ref loc="2CH 5:13">2 Tek 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Eji 3:11</ref>; <ref loc="PSA 106:1">Jab 106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jer 33:11</ref></char>
    </note>Pien Rwot ber;</para>
  <para style="q1" vid="PSA 100:5">mar mere ma pe loke bedo nakanaka,</para>
  <para style="q1" vid="PSA 100:5">ki genene bene bedo nakanaka bot yalwak ducu.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s1">Cike pa rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Abiwero wer mamako adani ki ngolo kop atir ma meri;</para>
  <para style="q1" vid="PSA 101:1">abiwero wer boti, Ai Rwot.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Abiketo cwinya me lubu yo ma atir ma pe tera i bal.</para>
  <para style="q1" vid="PSA 101:2">Ibibino bota awene?</para>
  <para style="b" vid="PSA 101:2" />
  <para style="q1" vid="PSA 101:2">An abibedo gira i oda ma cwinya leng;<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />pe abiketo kit mo marac inyima me aluba.</para>
  <para style="q1" vid="PSA 101:3">Adag tic pa jo ma giloke ci gibwoto Lubanga woko;</para>
  <para style="q1" vid="PSA 101:3">pe abiye ni aribe kwedgi wek kitgi oguda.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Pe abibedo ki cwiny me ngak woko ki i yo ma atir wa ki acel,</para>
  <para style="q1" vid="PSA 101:4">pe abitamo tam mo me timo gin marac.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Abineko dano ma kwoto lawote woko;</para>
  <para style="q1" vid="PSA 101:5">pe abiciro dano ma nyate dok labwami.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Abineno jo ma bedo i lobo ma gigeno Lubanga ki kica,</para>
  <para style="q1" vid="PSA 101:6">wek gubin gubed kacel kweda i gang kala;</para>
  <para style="q1" vid="PSA 101:6">ngat ma lubu yo ma atir ma pe tere i bal bitiyo tic bota.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Lagoba mo pe bibedo i oda;</para>
  <para style="q1" vid="PSA 101:7">ngat ma labwolo pe bimede ki tic inyima.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Nino ki nino abijwero jo maracu woko ducu ki i lobo,</para>
  <para style="q1" vid="PSA 101:8">abiryemo lutim maracu woko liweng ki i taun madit pa Rwot.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s1">Lega pa bulu matye ki ayelayela</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />Ai Rwot, winy legana;</para>
  <para style="q1" vid="PSA 102:1">wek kokona owinye boti!<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Pe ikane woko ki bota do,</para>
  <para style="q1" vid="PSA 102:2">ikare ma atye ki ayelayela!</para>
  <para style="q1" vid="PSA 102:2">Cik iti iwiny loka,</para>
  <para style="q1" vid="PSA 102:2">gam doga oyotoyot inino ma akok iye botini!<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Kwona tye karwenyo woko calo yito,</para>
  <para style="q1" vid="PSA 102:3">ma cogona ducu wang awanga calo rukmac.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Cwinya tye katwo woko calo lum mutwo,</para>
  <para style="q1" vid="PSA 102:4">miti me cam mo peke i cwinya.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Acur matek malongo;</para>
  <para style="q1" vid="PSA 102:5">ringo koma omoko woko ikom cogona liking.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Abedo calo tula ma bedo i tim aroo,</para>
  <para style="q1" vid="PSA 102:6">calo tula ma bedo iwi obur.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Abutu ma nino pe mako wanga,</para>
  <para style="q1" vid="PSA 102:7">atye calo winyo ma bedo kene iwi ot malo.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Lukwora giloko lok agec ikoma dyeceng jwi,</para>
  <para style="q1" vid="PSA 102:8">jo ma nywara gilwongo nyinga kun giceno ki jo mukene.<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Buru dong oloke odoko cama,</para>
  <para style="q1" vid="PSA 102:9">arubu pig wanga ki gin amatana,<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />pi lyeto me akemoni ki kinigani;</para>
  <para style="q1" vid="PSA 102:10">i ila malo yaka ibola woko cen.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Kwona obedo calo tipu me otyeno ma rwenyo woko oyotoyot;</para>
  <para style="q1" vid="PSA 102:11">atye kaner woko calo lum.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Ento in ibedo iwi komkeri matwal, Ai Rwot;</para>
  <para style="q1" vid="PSA 102:12">yalwak me kare ducu gibipo piri.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Ibia ci kica bimaki ikom Cion;</para>
  <para style="q1" vid="PSA 102:13">kare dong oromo me nyutu beri bote;</para>
  <para style="q1" vid="PSA 102:13">kare ma iciko pire dong oromo.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Pien lutici gimare, kadi bed dong kimuke kirete woko piny,</para>
  <para style="q1" vid="PSA 102:14">kica makogi ikome kadi bed dong odoko apwa.<verse eid="PSA 102:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Rok ducu bilworo Rwot,</para>
  <para style="q1" vid="PSA 102:15">luker ducu ma iwi lobo gibilwore pi tekone.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Rwot bigero Cion odoco;</para>
  <para style="q1" vid="PSA 102:16">ci en binyutu dit mere.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />En biwinyo lega pa jo ma piny dong obwoyogi woko adada,</para>
  <para style="q1" vid="PSA 102:17">pe bicayo lega me bako dog ma kikelo bote.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Kicoo lok ma otime pi yalwak me kare ma bibino anyim,</para>
  <para style="q1" vid="PSA 102:18">wek jo ma pud peya kinywalogi gupak Rwot kun giwaco ni,<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />“Rwot oneno piny ki i kabedone maleng matye malo,</para>
  <para style="q1" vid="PSA 102:19">en oneno piny i lobo nia ki i polo,<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />me winyo koko pa lumabuc,</para>
  <para style="q1" vid="PSA 102:20">wek egony jo ma dong kityeko ngolo kop me to iwigi.”<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Ci dano gibipako nying Rwot i Cion,</para>
  <para style="q1" vid="PSA 102:21">gibipake i Jerucalem,<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />ikare ma luker ki rok ducu coke kacel,</para>
  <para style="q1" vid="PSA 102:22">pi woro Rwot.<verse eid="PSA 102:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Rwot oturu teka woko ma pud atidi;</para>
  <para style="q1" vid="PSA 102:23">ojwiko nino me kwona obedo manok.<verse eid="PSA 102:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Awaco ni, “Ai Lubangana, pe ikwany</para>
  <para style="q1" vid="PSA 102:24">kwona woko ma pud peya atii!</para>
  <para style="q1" vid="PSA 102:24">Rwot, in ma ibedo nakanaka ikare pa yalwak ducu.”<verse eid="PSA 102:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:25: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:10-12">Ibru 1:10-12</ref>
      </char>
    </note>Ikare macon ma okato angec iketo guti me te lobo,</para>
  <para style="q1" vid="PSA 102:25">dok in aye ma itiyo polo ki cingi.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Gin birweny woko, ento in ibedo meri matwal;</para>
  <para style="q1" vid="PSA 102:26">gibitii woko macalo bongo.</para>
  <para style="q1" vid="PSA 102:26">In ilokogi macalo ginaruka, ci gitum woko liweng;<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />ento in kiti acel, mwaka me kwoni bene pe gik.<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Lutino pa lutici bikwo ite gwoki,</para>
  <para style="q1" vid="PSA 102:28">gibibedo ki kuc labongo peko mo;</para>
  <para style="q1" vid="PSA 102:28">dok in aye ma ibigwoko likwayogi.<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s1">Mar pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Pak Rwot, in tipuna;</para>
  <para style="q1" vid="PSA 103:1">kwona ducu myero opak</para>
  <para style="q1" vid="PSA 103:1">nying Rwot maleng!<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Pak Rwot, in tipuna;</para>
  <para style="q1" vid="PSA 103:2">wii pe owil ikom mot ducu mabeco ma en omiyi.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />En weko bala ducu,</para>
  <para style="q1" vid="PSA 103:3">en bene ma cango two ducu ki ikoma.<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />En laro kwona miyo pe adonyo i bur,</para>
  <para style="q1" vid="PSA 103:4">en keto mar mere ma pe loke kacel ki kicane ikoma.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />En miya jami mabeco pi kare me kwona ducu,</para>
  <para style="q1" vid="PSA 103:5">kun roco tekona kare ki kare macalo pa ocur.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />Rwot ngolo kop kakare,</para>
  <para style="q1" vid="PSA 103:6">dok ngolo kop atir pi jo ma kiunugi.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />En otucu yub ma mere bot Moses,</para>
  <para style="q1" vid="PSA 103:7">ci omiyo jo Icrael guneno tic ma mere me aura.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:8: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:11">Yak 5:11</ref>
      </char>
    </note>Rwot lakica dok maro dano,</para>
  <para style="q1" vid="PSA 103:8">kiniga pe make oyot, dok mare madwong pe loke.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />En pe bibedo kajukuwa kun juyuwa kare ducu,</para>
  <para style="q1" vid="PSA 103:9">kinigane bene pe ri nakanaka.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />En pe pwodowa kun poro ki bal ma watimo,</para>
  <para style="q1" vid="PSA 103:10">dok pe culu kwor ikomwa kun poro kit roc ducu ma watimo.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Kit macalo polo tye mabor malo iwi lobo,</para>
  <para style="q1" vid="PSA 103:11">mar mere ma pe loke bene dit kitmeno bot jo ma lwore.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Kit macalo tung kunyango bor kwede ki tung kupotoceng,</para>
  <para style="q1" vid="PSA 103:12">en kwanyo balwa woko ducu ki ikomwa cwalo kamabor kitmeno.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Macalo wegi lutino bedo ki kica ikom lutinogi,</para>
  <para style="q1" vid="PSA 103:13">Rwot bene kica mako kitmeno ikom jo ma lwore.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />En ngeyo kit gin ma en ocweyowa kwede;</para>
  <para style="q1" vid="PSA 103:14">en po ni wan apwa ma mwa.<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Nino me kwo pa dano obedo calo lum;</para>
  <para style="q1" vid="PSA 103:15">calo ature matye i poto;<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />ma ka yamo okodo ikome ci ner dok two woko liweng,</para>
  <para style="q1" vid="PSA 103:16">ci rwenyo woko matwal.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Ento mar pa Rwot ma pe loke bedo nakanaka</para>
  <para style="q1" vid="PSA 103:17">pi jo ma wore,</para>
  <para style="q1" vid="PSA 103:17">dok bere bedo nakanaka bot jo me yalwak ducu,<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />bot jo ducu ma gigwoko gicikene,</para>
  <para style="q1" vid="PSA 103:18">ma gipo pi tiyo gin ma en ociko.<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />Rwot ocibo komkere i polo;</para>
  <para style="q1" vid="PSA 103:19">en rwot maloyo ducu.<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Wupak Rwot, wun lumalaika matek,</para>
  <para style="q1" vid="PSA 103:20">ma wulubu cike,</para>
  <para style="q1" vid="PSA 103:20">kun wuwinyo lok ducu ma en waco botwu.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Wupak Rwot, wun monye ducu me polo,</para>
  <para style="q1" vid="PSA 103:21">wun lutice ma wutiyo gin ma en mito!<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Wupak Rwot, wun ginacweya ducu,</para>
  <para style="q1" vid="PSA 103:22">i kabedo ducu ma en loyo!</para>
  <para style="q1" vid="PSA 103:22">Pak Rwot, in tipuna!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s1">Wer me pako Lacwec</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Pak Rwot, in tipuna!</para>
  <para style="q1" vid="PSA 104:1">Ai Rwot Lubangana, in idit tutwal!</para>
  <para style="q1" vid="PSA 104:1">In iruke ki woro kacel ki deyo;<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />iumu komi woko ki dero calo iruku bongo.</para>
  <para style="q1" vid="PSA 104:2">Iyaro polo woko macalo kema ma kiyaro,<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />dok igero rii me ot ma meri malo iwi pii.</para>
  <para style="q1" vid="PSA 104:3">Iloko pol odoko gadigadini,</para>
  <para style="q1" vid="PSA 104:3">ingweco ki gadigadini i bwom yamo.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:4: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:7">Ibru 1:7</ref>
      </char>
    </note>Iloko yamo odoko lukwenani,</para>
  <para style="q1" vid="PSA 104:4">kun leb mac ma lyel gubedo lutici.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Iketo lobo ocung matek ikom gutine,</para>
  <para style="q1" vid="PSA 104:5">ma pe biyenge wa ki acel.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Iumu woko ki nam matut calo kiumu ki ginaruka,</para>
  <para style="q1" vid="PSA 104:6">ki pii bene omwonyo godi woko ducu.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Ento ikare ma ijuku pii, ci oringo woko;</para>
  <para style="q1" vid="PSA 104:7">ikare ma owinyo dwoni omor kun idange matek,</para>
  <para style="q1" vid="PSA 104:7">ci orwenyo woko liweng.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Omol ki iwi godi okato ocito piny i lung,</para>
  <para style="q1" vid="PSA 104:8">ikabedo mayam iyero pire.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Iketo wang lobo ma pe myero pii ongol okat i ngeye,</para>
  <para style="q1" vid="PSA 104:9">wek pe dok oum lobo woko odoco.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Imiyo wang it nyete mol i lung,</para>
  <para style="q1" vid="PSA 104:10">kun pii kulu mol ki ikin godi.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Lee tim ducu gimato pii meno,</para>
  <para style="q1" vid="PSA 104:11">kana me tim bene gimato me neko orwo pii.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Winyi gigero odigi iwi yadi ma inget kulu,</para>
  <para style="q1" vid="PSA 104:12">ci gibedo kakoko i jang yadi.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Icwalo kot ki i polo cwer piny iwi godi,</para>
  <para style="q1" vid="PSA 104:13">lobo opong ki jami mabeco ducu ma in imiyo.<verse eid="PSA 104:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Imiyo lum lot dongo me cam pa dyangi,</para>
  <para style="q1" vid="PSA 104:14">ki ginapita ma myero dano otii kwedgi,</para>
  <para style="q1" vid="PSA 104:14">wek dano opur lobo ci onong cam,<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />ki kongo bwino ma yomo cwiny dano,</para>
  <para style="q1" vid="PSA 104:15">ki moo me wir wek wange obed ma mil amila,</para>
  <para style="q1" vid="PSA 104:15">ki dok ocam kwon ma miye teko.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Yadi pa Rwot limo pii mabup,</para>
  <para style="q1" vid="PSA 104:16">gin aye yadi cedar me Lebanon mayam en opitogi.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Lwak winyi mapol gigero odigi iwi yadi kunu;</para>
  <para style="q1" vid="PSA 104:17">winyi aramatala bene gibedo iwi yadi maboco.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Dyegi me tim gibedo iwi godi mamalo tutwal,</para>
  <para style="q1" vid="PSA 104:18">ki okile giringo gikane i got.<verse eid="PSA 104:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Iketo dwe me poko kare;</para>
  <para style="q1" vid="PSA 104:19">ceng ngeyo cawa me potone.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />In aye ma iketo colpiny omiyo dyewor tye;</para>
  <para style="q1" vid="PSA 104:20">en aye cawa ma lee ma gibedo i bunga gicako kwede wotgi.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Lutino labwor gidwaro lee ki koko,</para>
  <para style="q1" vid="PSA 104:21">kun giyenyo cam ma Lubanga miyo botgi.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Ka ceng otuc, gidok woko cen,</para>
  <para style="q1" vid="PSA 104:22">ci gibutu i gorogi.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Ci dano kato woko cito katicgi</para>
  <para style="q1" vid="PSA 104:23">ci gitiyo tic nio wa otyeno.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />Ai Rwot, in dong itiyo lwak jami mapol!</para>
  <para style="q1" vid="PSA 104:24">Itiyogi ducu ki ryeko,</para>
  <para style="q1" vid="PSA 104:24">omiyo lobo opong ki ginacweyani.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Nam madit malac bene tye,</para>
  <para style="q1" vid="PSA 104:25">ma ginacweya ma welgi pe kwane bedo iye,</para>
  <para style="q1" vid="PSA 104:25">gin makwo matino ki madito.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:26: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:1">Yub 41:1</ref>; <ref loc="PSA 74:14">Jab 74:14</ref>; <ref loc="ISA 27:1">Ica 27:1</ref></char>
    </note>Mel bene woto ki iye,</para>
  <para style="q1" vid="PSA 104:26">dok twol ma min kulu ma icweyoni bene tuku iye.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Gin ducu gineno wangi,</para>
  <para style="q1" vid="PSA 104:27">gimitoni imii botgi cam ikare ma mite kikome.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Ka imiyogi cam, ci gigamo gicamo woko;</para>
  <para style="q1" vid="PSA 104:28">ka iyabo cingi imiyogi cam,</para>
  <para style="q1" vid="PSA 104:28">ci giyeng ki jami mabeco mada.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Ka ikane woko ki botgi, ci gineno can;</para>
  <para style="q1" vid="PSA 104:29">ka ikwanyo yamo me yweyoni woko ki botgi ci gito woko,</para>
  <para style="q1" vid="PSA 104:29">gidok i apwa.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Ka iketo yamo me yweyoni i igi ci gibedo kwo;</para>
  <para style="q1" vid="PSA 104:30">dok bene imiyo kwo manyen i lobo.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Deyo pa Rwot myero orii nakanaka!</para>
  <para style="q1" vid="PSA 104:31">Rwot myero obed ki yomcwiny pi gin ma en otiyo.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Rwot neno lobo ci miyo yenge,</para>
  <para style="q1" vid="PSA 104:32">en gudu godi ci giduny yito.<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Abiwero wer bot Rwot pi kare me kwona ducu;</para>
  <para style="q1" vid="PSA 104:33">abiwero wer me pako Lubangana ka pud akwo.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Wek lok ma alwodo ki i cwinya oyom cwiny Rwot,</para>
  <para style="q1" vid="PSA 104:34">pien en aye mamiyo abedo ki yomcwiny.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Wek kityek lubalo woko liweng ki i lobo,</para>
  <para style="q1" vid="PSA 104:35">dok wek jo maracu bene gurweny woko matwal!</para>
  <para style="q1" vid="PSA 104:35">Pak Rwot, in tipuna!</para>
  <para style="q1" vid="PSA 104:35">Wupak Rwot!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s1">Lubanga ki lwake</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 Tek 16:8-22</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Wumii pwoc bot Rwot, wulwong nyinge,</para>
  <para style="q1" vid="PSA 105:1">wumii tice ongene ikin rok ducu!<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Wuwer bote wer me pako en,</para>
  <para style="q1" vid="PSA 105:2">wutit tice me aura ducu!<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Wuket deyo ikom nyinge maleng;</para>
  <para style="q1" vid="PSA 105:3">wek jo ma yenyo Rwot cwinygi obed yom!<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Wuyeny Rwot ki tekone,</para>
  <para style="q1" vid="PSA 105:4">wuyeny tye mere kare ducu.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />Wupo ikom tic me aura ma en otiyo ducu,</para>
  <para style="q1" vid="PSA 105:5">tango mayam otiyo ki kop ma en ongolo,<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />wun likwayo pa Abraim mayam latice,</para>
  <para style="q1" vid="PSA 105:6">wun lutino pa Yakobo ma en oyerowu.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Rwot en aye Lubangawa;</para>
  <para style="q1" vid="PSA 105:7">en ngolo kop pi wi lobo ducu.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />En bigwoko gicikene pi nakanaka,</para>
  <para style="q1" vid="PSA 105:8">ki lok me cikene, pi yalwak alip ki alip.<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:9: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:7">Aca 12:7</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 26:3">26:3</ref></char>
    </note> En bigwoko gicike ma oketo ki Abraim,</para>
  <para style="q1" vid="PSA 105:9">ki lok mayam okwongo ki Icaka,<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:10: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 28:13">Aca 28:13</ref>
      </char>
    </note> ma omoko odoko cik bot Yakobo,</para>
  <para style="q1" vid="PSA 105:10">wek obed gicike ki Icrael matwal,<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />kun owaco ni, “Abimiyo lobo Kanaan boti,</para>
  <para style="q1" vid="PSA 105:11">wek obed lobo me aleyani.”<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Ikare ma onongo welgi pud nok,</para>
  <para style="q1" vid="PSA 105:12">ma pud gin adonyi i lobo meno,<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />ma giwire ikin rok mapatpat,</para>
  <para style="q1" vid="PSA 105:13">ma gia ki ite ker acel gikobo i ite ker mukene,<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:14: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 20:3-7">Aca 20:3-7</ref>
      </char>
    </note>Lubanga pe oye ngat mo odiyogi.</para>
  <para style="q1" vid="PSA 105:14">En ojuku luker mapol pirgi kun waco ni,<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />“Pe wugud kom jo ma an awirogi,</para>
  <para style="q1" vid="PSA 105:15">pe wutim lunebina marac!”<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:53-57">Aca 41:53-57</ref>
      </char>
    </note>Ikare ma Rwot ocwalo kec opoto i lobogi,</para>
  <para style="q1" vid="PSA 105:16">ci okwanyo camgi ma gikwo kwede woko ducu,<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:17: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 37:28">Aca 37:28</ref>; <ref loc="GEN 45:5">45:5</ref></char>
    </note>Lubanga onongo ocwalo Yucepu okwongo nyimgi,</para>
  <para style="q1" vid="PSA 105:17">en dano mayam kicato woko macalo opiini.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:18: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 39:20-40:23">Aca 39:20—40:23</ref>
      </char>
    </note>Kitweyo tyene woko ki nyor matek,</para>
  <para style="q1" vid="PSA 105:18">kirwako atego nyonyo i ngute,<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />nio kalok ma en olokoni ocobe kakare.</para>
  <para style="q1" vid="PSA 105:19">Lok pa Rwot oteme onongo ni en tye atir.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:20: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:14">Aca 41:14</ref>
      </char>
    </note>Ci rwot ocwalo dano ci kigonye woko,</para>
  <para style="q1" vid="PSA 105:20">laloc me lobo omiyo kigonyo nyor woko oweko en ocito gire.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:21: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:39-41">Aca 41:39-41</ref>
      </char>
    </note>Rwot me Ejipt oketo en obedo rwot maloyo ode,</para>
  <para style="q1" vid="PSA 105:21">ki ngat maloyo jamine ducu;<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />omiye bene twero me pwonyo luloce kit ma cwinye mito,</para>
  <para style="q1" vid="PSA 105:22">dok me pwonyo lutelane ki ryeko.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:23: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:6">Aca 46:6</ref>; <ref loc="GEN 47:11">47:11</ref></char>
    </note> Lacen Icrael obino i Ejipt,</para>
  <para style="q1" vid="PSA 105:23">ci odoko labedo i lobo pa Kam.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:24: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:7-14">Nia 1:7-14</ref>
      </char>
    </note>Rwot omiyo lwake gunywalo lutino mapol,</para>
  <para style="q1" vid="PSA 105:24">dok omiyo gudoko tek ma gikato lukworgi.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />Ci Lubanga oloko cwiny jo Ejipt omiyo gukwero jone woko,</para>
  <para style="q1" vid="PSA 105:25">ci guunu lutice iwi diro.<verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:26: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:1-4:17">Nia 3:1—4:17</ref>
      </char>
    </note>Ci en ocwalo latice Moses,</para>
  <para style="q1" vid="PSA 105:26">ki Aron ma en aye oyero.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Gutiyo lanyut pa Lubanga madito,</para>
  <para style="q1" vid="PSA 105:27">gutiyo tango mapol i lobo pa Kam.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:28: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:21-23">Nia 10:21-23</ref>
      </char>
    </note> Lubanga ocwalo colpiny, ci lobo ocido woko odoko col licuc;</para>
  <para style="q1" vid="PSA 105:28">ento gujemo woko pe guwinyo loke.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:29: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Nia 7:17-21</ref>
      </char>
    </note>Oloko pii ma i kulugi odoko remo,</para>
  <para style="q1" vid="PSA 105:29">omiyo rec matye iye ducu guto woko.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:30: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-6">Nia 8:1-6</ref>
      </char>
    </note>Ka dok omiyo lobogi opong ki lwak ogwal mapol ata,</para>
  <para style="q1" vid="PSA 105:30">kadi wa gangkal pa rwot nongo opong ki ogwal keken.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:31: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:16-17">Nia 8:16-17</ref>
      </char>
    </note> Ka Lubanga oloko, ci omiyo lwak lwangi madwong obino,</para>
  <para style="q1" vid="PSA 105:31">ki nyogi bene gucore i lobogi ducu.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:32: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Nia 9:22-25</ref>
      </char>
    </note>Dok en omiyo pee ocwer ma ka kot,</para>
  <para style="q1" vid="PSA 105:32">ki lutkot bene owil ma otyeko lobogi woko ducu.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />En ojwero olok ki yat odurogi ducu,</para>
  <para style="q1" vid="PSA 105:33">ci oturu yadi ducu ma i lobogi.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:34: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Nia 10:12-15</ref>
      </char>
    </note>Dok oloko ci bonyo ocore,</para>
  <para style="q1" vid="PSA 105:34">lwak lutino bonyo ma welgi pe kwane;<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />ci gucamo ginapita woko liweng ki i lobo,</para>
  <para style="q1" vid="PSA 105:35">gucamo kit kwayi ginapita me cam ducu ma gupuru i lobogi.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:36: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Nia 12:29</ref>
      </char>
    </note>Lacen oneko lutino kayogi ma co woko ducu,</para>
  <para style="q1" vid="PSA 105:36">ma gin aye jo ma gukwongo nywalo ki tekogi.<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:37: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:33-36">Nia 12:33-36</ref>
      </char>
    </note> Ci okwanyo jo Icrael okelogi woko</para>
  <para style="q1" vid="PSA 105:37">ma gutingo ryal ki jabu;</para>
  <para style="q1" vid="PSA 105:37">dano mo ma obedo goro ikin kakane ducu obedo peke.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Ikare ma gua woko ki kunu, cwiny jo Ejipt obedo yom,</para>
  <para style="q1" vid="PSA 105:38">pien onongo gilworogi mada.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:39: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21-22">Nia 13:21-22</ref>
      </char>
    </note>Lubanga oyaro pol malo ka wi jone me gwokogi,</para>
  <para style="q1" vid="PSA 105:39">dok omiyogi mac me menyo piny dyewor.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:40: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Nia 16:2-15</ref>
      </char>
    </note>Ka jone gulego pi ringo ci Lubanga ocwalo aluru,</para>
  <para style="q1" vid="PSA 105:40">dok ocwalo kwon mabup ki i polo wek gucam guyeng.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:41: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Nia 17:1-7</ref>; <ref loc="NUM 20:2-13">Wel 20:2-13</ref></char>
    </note>En obaro got ci pii onyete okati ki iye,</para>
  <para style="q1" vid="PSA 105:41">omol ki i dye tim aroo calo kulu.<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Pien en onongo opo ikom cikene maleng,</para>
  <para style="q1" vid="PSA 105:42">ki ikom Abraim ma latice.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />En okwanyo jone otelogi ki yomcwiny,</para>
  <para style="q1" vid="PSA 105:43">ma lwake ma en oyero gidange ki wer matek.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:44: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 11:16-23">Yoc 11:16-23</ref>
      </char>
    </note>Ci omiyogi lobo pa lurok,</para>
  <para style="q1" vid="PSA 105:44">omiyo gukwanyo lonyo pa jo mukene,<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />wek lwake gulub cike,</para>
  <para style="q1" vid="PSA 105:45">ki gugwok gin ma en ociko ducu.</para>
  <para style="q1" vid="PSA 105:45">Wupak Rwot!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s1">Ber pa Lubanga bot jone</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Tek 16:34</ref>; <ref loc="2CH 5:13">2 Tek 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Eji 3:11</ref>; <ref loc="PSA 100:5">Jab 100:5</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jer 33:11</ref></char>
    </note>Wupak Rwot!</para>
  <para style="q1" vid="PSA 106:1">Wumii pwoc bot Rwot, pien en ber;</para>
  <para style="q1" vid="PSA 106:1">Mar mere ma pe loke bedo nakanaka!<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Anga matwero tito pi tic madito matek ma Rwot otiyo,</para>
  <para style="q1" vid="PSA 106:2">dok anga matwero pako en ma oromo maber?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Jo ma gitiyo gin matye atir gitye ki yomcwiny,</para>
  <para style="q1" vid="PSA 106:3">gin jo ma gitye ki kwo ma opore kare ducu!<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Ai Rwot, po pira ka inyutu kicani bot lwaki;</para>
  <para style="q1" vid="PSA 106:4">konya bene, ka ilarogi,<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />wek bene anen kit ma lonyo pa joni ma iyero dongo kwede,</para>
  <para style="q1" vid="PSA 106:5">ci anywak yomcwiny kacel ki roki,</para>
  <para style="q1" vid="PSA 106:5">wek awake kacel ki joni ma gin aye luleyo ma meri.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Wan kacel ki kwariwa watimo bal;</para>
  <para style="q1" vid="PSA 106:6">wan watyeko timo bal, watimo gin maracu adada.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:10-12">Nia 14:10-12</ref>
      </char>
    </note>Kwariwa, ikare ma gitye i Ejipt,</para>
  <para style="q1" vid="PSA 106:7">pe gutamo pi tic meri me aura mayam itiyo botgi,</para>
  <para style="q1" vid="PSA 106:7">pe gupo ikom mari madit ma pe loke,</para>
  <para style="q1" vid="PSA 106:7">ento gujemo woko ikom en Mamalo Twal i dog Nam Makwar.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Ento en pud olarogi aye pi nyinge kene,</para>
  <para style="q1" vid="PSA 106:8">wek enyut tekone madit.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-31">Nia 14:21-31</ref>
      </char>
    </note>En ojuku Nam Makwar, ci nam otwo woko!</para>
  <para style="q1" vid="PSA 106:9">Ci otelo wi jone i dye nam matut calo gitye kawot i dye tim mutwo.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />En olaro jone ki i cing lukworgi,</para>
  <para style="q1" vid="PSA 106:10">olarogi ki i twero pa lumerokgi.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Pii omwonyo lumerokgi woko liweng;</para>
  <para style="q1" vid="PSA 106:11">ngat mo acel ki ikin gi pe ma odong.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:1-21">Nia 15:1-21</ref>
      </char>
    </note>Lacen lwak guye loke;</para>
  <para style="q1" vid="PSA 106:12">ci guwero wer bene me pake.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Ento wigi owil woko oyotoyot ikom tic ma en otiyo,</para>
  <para style="q1" vid="PSA 106:13">gubedo katic ma pe kong gikuru tam ma a ki bote.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:14: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 11:4-34">Wel 11:4-34</ref>
      </char>
    </note>Cwinygi opuke pi camo ringo i dye tim,</para>
  <para style="q1" vid="PSA 106:14">gutemo i Lubanga i tim aroo.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Ci en omiyogi gin ma gupenye pire,</para>
  <para style="q1" vid="PSA 106:15">ento ocwalo ikomgi kit two marac ma balo kom dano.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:16: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:1-35">Wel 16:1-35</ref>
      </char>
    </note> Ikare ma nyeko omakogi ikom Moses,</para>
  <para style="q1" vid="PSA 106:16">ki ikom Aron ma en ngat maleng ma Rwot oyero,<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />ci lobo obar omwonyo Datan woko,</para>
  <para style="q1" vid="PSA 106:17">ka oumu lwak pa Abiram woko bene.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Mac oturu ki lyel iwi lwakgi;</para>
  <para style="q1" vid="PSA 106:18">ci leb mac ma lyeli owango jo maracu woko ducu.<verse eid="PSA 106:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:19: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:1-14">Nia 32:1-14</ref>
      </char>
    </note>Gucweyo cal latin twon i Koreb,</para>
  <para style="q1" vid="PSA 106:19">ci gubedo ka woro cal twon ma gutiyoni.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Ma ka woro Lubanga, ma en aye won deyo,</para>
  <para style="q1" vid="PSA 106:20">gin oworo cal twon dyang ma mwa ma camo lum.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Wigi owil woko ikom Lubanga Lalargi,</para>
  <para style="q1" vid="PSA 106:21">mayam otiyo gin me aura madito i lobo Ejipt;<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />pe gupo pi gin me aura ma en otiyo i lobo pa Kam,</para>
  <para style="q1" vid="PSA 106:22">ki gin maracu makelo lworo ma en otiyo i dog Nam Makwar.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Ma omiyo en owaco ni onongo ebityekogi woko,</para>
  <para style="q1" vid="PSA 106:23">ka nene pe Moses, ma en aye dano ma en eyero,</para>
  <para style="q1" vid="PSA 106:23">ocung inyime, ikin en ki lwake,</para>
  <para style="q1" vid="PSA 106:23">ci eloko akemone woko omiyo pe etyekogi.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:24: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:1-35">Wel 14:1-35</ref>
      </char>
    </note>Gucayo lobo maber ma yomo cwiny danoni woko,</para>
  <para style="q1" vid="PSA 106:24">ma pe gubedo ki niye wa ki acel ikom gin ma Lubanga ociko.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Gubedo i kemagi kun gingur angura,</para>
  <para style="q1" vid="PSA 106:25">dok pe guwinyo lok ma Rwot owaco botgi.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Omiyo en otingo cinge malo okwongo kwong botgi ni,</para>
  <para style="q1" vid="PSA 106:26">ebimiyo gito i dye tim,<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:27: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:33">Lev 26:33</ref>
      </char>
    </note>dok ebikeyogi woko ikin rok mapatpat,</para>
  <para style="q1" vid="PSA 106:27">kun ekeyogi woko atata i lobo mapol.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:28: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 25:1-13">Wel 25:1-13</ref>
      </char>
    </note>Cutcut guribe ki rok mukene ka woro jok Baal i Peor,</para>
  <para style="q1" vid="PSA 106:28">dok gucamo gitum ma kityero bot lubangagu ma pe gikwo.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Gin gumiyo kiniga omako Rwot pi gin ma gutimo,</para>
  <para style="q1" vid="PSA 106:29">ci two gemo marac bene opoto ikomgi.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Ento Finekaci oa malo, omiine pi tyeko lok meno,</para>
  <para style="q1" vid="PSA 106:30">ci two gemo otugi gik woko cut.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Ci gubedo kapo pi lok man ni en dano ma kite atir,</para>
  <para style="q1" vid="PSA 106:31">dok gibipo iye bene pi kare pa yalwak ducu.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:32: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 20:2-13">Wel 20:2-13</ref>
      </char>
    </note>Ka dok inget pii me Meriba gin omiyo kiniga omako Rwot,</para>
  <para style="q1" vid="PSA 106:32">pimeno omiyo Moses oneno can malit pirgi.<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Gumiyo cwiny Moses odoko kec,</para>
  <para style="q1" vid="PSA 106:33">oweko oloko lok ma onongo myero pe en oloki.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:34: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:1-3">Lung 2:1-3</ref>; <ref loc="JDG 3:5-6">3:5-6</ref></char>
    </note>Pe guneko jo me rok mukene,</para>
  <para style="q1" vid="PSA 106:34">kit macalo onongo Rwot ocikogi kwede,<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />ento guribe woko ki lurok,</para>
  <para style="q1" vid="PSA 106:35">gubedo kalubu yo me woro cal jogi macalo lurok giworo.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Lwak pa Lubanga gubedo ka woro cal jogi,</para>
  <para style="q1" vid="PSA 106:36">ma oloke odoko owic botgi.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:37: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 17:17">2 Luk 17:17</ref>
      </char>
    </note>Gubedo katyero lutino awobegi ki anyiragi</para>
  <para style="q1" vid="PSA 106:37">macalo gitum bot jogi.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:38: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 35:33">Wel 35:33</ref>
      </char>
    </note>Guneko jo mapol ma gin peke ki bal,</para>
  <para style="q1" vid="PSA 106:38">ma gin aye lutino awobegi ki anyiragi,</para>
  <para style="q1" vid="PSA 106:38">mayam gutyero bot cal jogi me Kanaan macalo gitum;</para>
  <para style="q1" vid="PSA 106:38">ci pi remo pa dano ma guoyo omiyo lobo odoko gin me kwer.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Gudoko jo ma keni pi gin ma gutiyo;</para>
  <para style="q1" vid="PSA 106:39">i timgi gudoko jo ma pe gigene pi woro jogi.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:40: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:14-18">Lung 2:14-18</ref>
      </char>
    </note>Ma omiyo kiniga omako Rwot ikom jone,</para>
  <para style="q1" vid="PSA 106:40">omiyo okwero jone woko, ma gin aye gipinyeni.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Pimeno oweko omiyogi i cing lurok,</para>
  <para style="q1" vid="PSA 106:41">oweko lukworgi mayam gidagi aye gubedo kaloyogi.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Lukworgi ounugi mada,</para>
  <para style="q1" vid="PSA 106:42">gudiyogi piny ite locgi.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Rwot yam olaro jone tyen mapol,</para>
  <para style="q1" vid="PSA 106:43">ento gin gubedo kajemo woko ikome i gin ducu ma gutimo;</para>
  <para style="q1" vid="PSA 106:43">omiyo gudonyo matut i bal.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Ento Rwot pud owinyo kokogi aye ikare ma gukok,</para>
  <para style="q1" vid="PSA 106:44">dok oniang ada ni gitye ki can.<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />En opo pi gicikene pirgi;</para>
  <para style="q1" vid="PSA 106:45">pi mar mere ma pe loke omiyo Rwot odwoko cwinye ci oloko tame ikomgi.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Omiyo jo ducu ma loyogi macalo opii</para>
  <para style="q1" vid="PSA 106:46">me bedo ki kica ikomgi.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:47: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:35-36">1 Tek 16:35-36</ref>
      </char>
    </note>Larwa, Ai Rwot Lubangawa,</para>
  <para style="q1" vid="PSA 106:47">cokwa woko ki ikin lurok,</para>
  <para style="q1" vid="PSA 106:47">wek wapwo nyingi maleng, ka wapaki pi deyo.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />Kipwo Rwot Lubanga pa Icrael,</para>
  <para style="q1" vid="PSA 106:48">gipake nakanaka!</para>
  <para style="q1" vid="PSA 106:48">Jo ducu myero guwac ni, “Amen!”</para>
  <para style="q1" vid="PSA 106:48">Wupak Rwot!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">BUK ME ABIC</para>
  <para style="mr">
    <ref loc="PSA 107-150">Jab 107—150</ref></para>
  <para style="s1">Pwoc ki pak pi ber pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Tek 16:34</ref>; <ref loc="2CH 5:13">2 Tek 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Eji 3:11</ref>; <ref loc="PSA 100:5">Jab 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jer 33:11</ref></char>
    </note>Wumii pwoc bot Rwot, pien en ber;</para>
  <para style="q1" vid="PSA 107:1">mar mere ma pe loke bedo nakanaka!<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Wek jo ma Rwot okokogi guwac kitmeno,</para>
  <para style="q1" vid="PSA 107:2">jo ma en okoko ki i can,<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />en okwanyogi ki i lobo pa lurok odwokogi cen i lobogi,</para>
  <para style="q1" vid="PSA 107:3">ma ocokogi ki tung kunyango ki tung kupotoceng,</para>
  <para style="q1" vid="PSA 107:3">ki tung kumalo ki tung kupiny.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Jo mogo gubedo kalak ata i tim aroo,</para>
  <para style="q1" vid="PSA 107:4">pe gunongo yoo ma cito i taun madit kama omyero gubed iye;<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />kec ki orwo pii onekogi matek,</para>
  <para style="q1" vid="PSA 107:5">omiyo gen gi ducu orweny woko ki i cwinygi.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Ikare ma gitye ki can gukok bot Rwot,</para>
  <para style="q1" vid="PSA 107:6">ci en olarogi ki i can meggi.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />En otelogi ci guwoto i yoo atir,</para>
  <para style="q1" vid="PSA 107:7">nio ka guo wa i taun kama omyero gubed iye.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Myero gin gupwo Rwot pi mar mere ma pe loke,</para>
  <para style="q1" vid="PSA 107:8">ki pi tice me aura ma en otiyo pi dano!<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />En miyo jo ma orwo nekogi mato pii,</para>
  <para style="q1" vid="PSA 107:9">ki jo ma kec nekogi yeng ki jami mabeco.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Jo mogo gubedo i mutu ki colpiny,</para>
  <para style="q1" vid="PSA 107:10">lumabuc ma kitweyo ki nyor ma gitye kawinyo arem madwong,<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />pien onongo gujemo ma pe gulubu pwony pa Lubanga,</para>
  <para style="q1" vid="PSA 107:11">ma gukwero pwony pa En Mamalo Twal.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Komgi ool woko pi tic matek ma gubedo katiyone;</para>
  <para style="q1" vid="PSA 107:12">ci gupoto piny, ma ngat mo peke ma myero okonygi.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Ikare ma gitye ki can ci gukok bot Rwot,</para>
  <para style="q1" vid="PSA 107:13">ci en olarogi ki i can gi.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Ci okwanyogi woko ki i mutu ki i colpiny,</para>
  <para style="q1" vid="PSA 107:14">ka ocodo nyor ma kitweyogi kwede woko ci olarogi.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Myero gupwo Rwot pi mar mere ma pe loke,</para>
  <para style="q1" vid="PSA 107:15">ki pi tic me aura ma en otiyo pi dano.<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />En oturu kika mola woko ducu,</para>
  <para style="q1" vid="PSA 107:16">dok ongolo rii nyonyo me cego dogola opoko iye woko i dul aryo.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Jo mogo komgi obedo lit pi balgi,</para>
  <para style="q1" vid="PSA 107:17">gubedo ki can madwong pi gin maracu ma gutimo.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Cwinygi okwero kit cam ducu,</para>
  <para style="q1" vid="PSA 107:18">ma oweko onongo dong gicok to.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Ci gukok bot Rwot ikare ma gitye ki can,</para>
  <para style="q1" vid="PSA 107:19">ci en olarogi ki i can gi.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />En ocwalo lok ma mere ci ocangogi,</para>
  <para style="q1" vid="PSA 107:20">ci olarogi ki i to.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Myero gupwo Rwot pi mar mere ma pe loke,</para>
  <para style="q1" vid="PSA 107:21">ki pi tic me aura ma en otiyo pi dano.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Myero gupwoye kun gityero gityer me pwoc,</para>
  <para style="q1" vid="PSA 107:22">dok gutit pi tic ma en otiyo kun giwero wer me yomcwiny!<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Jo mogo gukwang ki mel i dye nam,</para>
  <para style="q1" vid="PSA 107:23">gin jo ma giyenyo yo me kwogi i nam madongo.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Gin guneno gin ma Rwot tiyo,</para>
  <para style="q1" vid="PSA 107:24">tice me aura ma en tiyo i cwiny nam.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />En oloko, ci yamo matek okodo,</para>
  <para style="q1" vid="PSA 107:25">omiyo pii me nam otwage.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Omiyo mel gutinge malo ma gicok gudu polo,</para>
  <para style="q1" vid="PSA 107:26">ka dok gudwogo piny gumwony woko kamatut ite nam;</para>
  <para style="q1" vid="PSA 107:26">tekcwinygi orwenyo woko i can gi meno.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Gucatu kun gipange apanga macalo lumero kongo,</para>
  <para style="q1" vid="PSA 107:27">ma ryeko otum woko liweng ki iwigi.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Ci gukok bot Rwot ikare ma gitye ki can,</para>
  <para style="q1" vid="PSA 107:28">ci en olarogi ki i can gi.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />En ojuku yamo matek ci nam opye mot,</para>
  <para style="q1" vid="PSA 107:29">ki biamwonyi me nam ducu oling woko mot.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Ci cwinygi obedo yom pi piny ma oling woko mot litik;</para>
  <para style="q1" vid="PSA 107:30">ci okelogi bene wa iwang wat kama gimito bino iye.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Myero gupwo Rwot pi mar mere ma pe loke,</para>
  <para style="q1" vid="PSA 107:31">ki pi tic me aura ma en otiyo pi dano.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Myero gudwore i coke pa lwak,</para>
  <para style="q1" vid="PSA 107:32">kun kipake bene i gure pa ludito.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Rwot Lubanga loko kulu ducu doko tim aroo mutwo,</para>
  <para style="q1" vid="PSA 107:33">dok en juku wang it woko ducu, ci pii dong pe mol ki iigi,<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />en loko lobo ma ceko cam doko lobo ma obedo kadokado ma konye dong peke;</para>
  <para style="q1" vid="PSA 107:34">man time pi bal pa jo ma bedo i lobo meno.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />En loko tim aroo mutwo doko kama pii pong iye,</para>
  <para style="q1" vid="PSA 107:35">ki kama otwo doko wangit ma pii mol ki iye.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />En miyo jo ma kec nekogi gibedo kunu,</para>
  <para style="q1" vid="PSA 107:36">ci gigero taun pi kabedogi.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Gicoyo kodi i poti,</para>
  <para style="q1" vid="PSA 107:37">ki gipito olok, ci camgi cek mabup.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />Ginya gidoko mapol pi gum ma Rwot omiyo botgi;</para>
  <para style="q1" vid="PSA 107:38">en pe weko wel dyangigi dok piny.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Ikare ma kiloyogi ma welgi odok piny kun kileyo wigi dok ki kiunugi,</para>
  <para style="q1" vid="PSA 107:39">kiyelogi, ma oweko cwinygi ocwer,<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />ci Lubanga culu kwor ikom rwodi ma unugi,</para>
  <para style="q1" vid="PSA 107:40">ci miyo gin giwoto i dye tim ata kama yoo mo peke iye.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Ento en laro jo ma piny obwoyogi ki i can gi,</para>
  <para style="q1" vid="PSA 107:41">ci weko welgi nya macalo romi.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Jo ma cwinygi atir gineno ci gibedo ki yomcwiny;</para>
  <para style="q1" vid="PSA 107:42">ento jo maracu ducu en juku lok woko ki idoggi weko giling litik.<verse eid="PSA 107:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Jo maryek myero gubed kalwodo pi jami magi matut ki i cwinygi,</para>
  <para style="q1" vid="PSA 107:43">wek dano gulwod pi mar pa Rwot ma pe loke.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s1">Lega pi kony ki i cing lukwor</para>
  <para style="r">(<ref loc="PSA 57:7-11">Jab 57:7-11</ref>; <ref loc="PSA 60:5-12">60:5-12</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Ai Lubanga, cwinya omoko ikomi;</para>
  <para style="q1" vid="PSA 108:1">cwinya omoko ikomi ma pe loke!</para>
  <para style="q1" vid="PSA 108:1">Abiwero wer kun apaki ki dwon malongo!</para>
  <para style="q1" vid="PSA 108:1">In tipuna, coo woko!<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Wun nangana ki opuka bene wucoo woko!</para>
  <para style="q1" vid="PSA 108:2">An bene abicoyo rupiny miyo ceng tuc!<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Abimiyo pwoc boti ikin lwak me rok ducu, Ai Rwot;</para>
  <para style="q1" vid="PSA 108:3">abiwero wer me paki ikin lurok.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Mar meri ma pe loke dit, o wa i polo,</para>
  <para style="q1" vid="PSA 108:4">dok adani bene dit, o wa i pol.<verse eid="PSA 108:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Ai Lubanga, nyut diti malo i polo,</para>
  <para style="q1" vid="PSA 108:5">dok imii deyoni oryeny iwi lobo ducu!<verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Larwa ki teki imii walo lukworwa, dok igam legawa,</para>
  <para style="q1" vid="PSA 108:6">wek lwak ma imaro gubwot.<verse eid="PSA 108:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Lubanga oloko ki i kabedone maleng ni,</para>
  <para style="q1" vid="PSA 108:7">“Abipoko Cekem woko kideyo madit me loc,</para>
  <para style="q1" vid="PSA 108:7">dok abipoko nota me Cukot woko i dul ki dul bot jona.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Gilead mera, ki Manace bene mera;</para>
  <para style="q1" vid="PSA 108:8">Epraim aye tok nyonyo me wiya,</para>
  <para style="q1" vid="PSA 108:8">ki Juda mere odo kera.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Ento Moab aye becen me lwoka;</para>
  <para style="q1" vid="PSA 108:9">ci abibolo war tyena ikom Edom, me nyutu ni en obedo mera;</para>
  <para style="q1" vid="PSA 108:9">dok abidange matek pi loyo jo Piliciti.”<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Anga ma bikelo an i gang man ma kirumu ki cel gogo?</para>
  <para style="q1" vid="PSA 108:10">Anga ma bitelo wiya tera i Edom?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />In pe mono dong ikwerowa woko, Ai Lubanga?</para>
  <para style="q1" vid="PSA 108:11">In pe dong itelo wi monywa me cito kalweny, Ai Lubanga?<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Konywa me lweny ikom lukworwa,</para>
  <para style="q1" vid="PSA 108:12">pien kony ma dano miyo pe gin mo!<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Ka Lubanga tye kalweny kacel kwedwa ci wabiloyo;</para>
  <para style="q1" vid="PSA 108:13">en aye ma binyono lukworwa diyo woko piny.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s1">Koko pa dano matye ki can</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Ai Lubanga ma apako,</para>
  <para style="q1" vid="PSA 109:1">pe iling woko!<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Pien jo maracu ki lugoba gubino kalweny ikoma,</para>
  <para style="q1" vid="PSA 109:2">kun giloko lok goba keken ikoma.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Gimiya cwercwiny pi lok maracu me adagadaga ma giloko ikoma,</para>
  <para style="q1" vid="PSA 109:3">gilwenyo ikoma nono ma pe abalo gin mo.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Gidota adota kadi bed an amarogi,</para>
  <para style="q1" vid="PSA 109:4">kadi wa ikare ma nongo atye kalego pirgi.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Gitimo gin marac ikoma pi gin maber ma atiyo botgi,</para>
  <para style="q1" vid="PSA 109:5">dok gidaga kadi bed amarogi.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Gin giwaco ni, “Yer langolkop marac wek opid kwede;</para>
  <para style="q1" vid="PSA 109:6">ci iwek ngat mo ikin lukwore odote.”<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Wek kipid ikome ci kinong ni kop oloye;</para>
  <para style="q1" vid="PSA 109:7">dok legane bene kikwan macalo bal ma en otimo!<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:8: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Tic 1:20</ref>
      </char>
    </note>Wek kijwik nino me kwone woko obed manok,</para>
  <para style="q1" vid="PSA 109:8">wek dano mukene aye ole dog tice!<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Wek lutinone gudok lutino kic,</para>
  <para style="q1" vid="PSA 109:9">ki dakone bene odok dato.<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Wek lutinone gubed lumalgang ma gilak ata kun gibedo kalego jami alega;</para>
  <para style="q1" vid="PSA 109:10">myero kiryemgi woko ki iwi obur kama onongo gibedo iye!<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Wek won banya ma en yam odeno banya bote, okwany jamine woko ducu ma en tye kwede,</para>
  <para style="q1" vid="PSA 109:11">dok dano mo ata oyak jamine ma en olimogi ki tic matek.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Wek ngat mo pe otim kica bote wa ki acel,</para>
  <para style="q1" vid="PSA 109:12">dok dano mo pe kica omake ikom lutino kice.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Wek likwaye ducu guto woko,</para>
  <para style="q1" vid="PSA 109:13">wek nyinge bene dano pe gupo pire ikare pa yalwak ma bilubu.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Wek Rwot opo ikom bal pa kwarine,</para>
  <para style="q1" vid="PSA 109:14">dok pe ojwa bal pa mine woko wa ki acel.<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Wek Rwot opo ikom balgi teretere,</para>
  <para style="q1" vid="PSA 109:15">ento dano pe opo ikomgi matwal i lobo kany.<verse eid="PSA 109:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Pien en pe otamo me bedo lakica,</para>
  <para style="q1" vid="PSA 109:16">ento obedo karyemo kor lucan ki jo ma piny obwoyogi,</para>
  <para style="q1" vid="PSA 109:16">kadi wa jo ma cwinygi cwer en onekogi woko.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />En omaro tutwal lok me ceno dano;</para>
  <para style="q1" vid="PSA 109:17">wek dong lok me ceno dano odok i wiye!</para>
  <para style="q1" vid="PSA 109:17">En onongo dag lamo gum;</para>
  <para style="q1" vid="PSA 109:17">pimeno wek ngat mo pe olam gum ikome.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Onongo lok me ceno dano odoko calo koti ma en ruku;</para>
  <para style="q1" vid="PSA 109:18">wek dong obid kome macalo pii,</para>
  <para style="q1" vid="PSA 109:18">dok macalo moo ma mido i cogone!<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Wek obed calo bongo ma en odwalo ikome;</para>
  <para style="q1" vid="PSA 109:19">obed calo del pyer ma nino ducu en tweyo i pyere!<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Man aye myero obed kit pwod ma Rwot pwodo ki jo ma dota,</para>
  <para style="q1" vid="PSA 109:20">gin jo maloko lok maracu ma gimito rwenyo kwona woko!<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Ento in, Ai Rwot Lubangana,</para>
  <para style="q1" vid="PSA 109:21">konya pi deyo me nyingi,</para>
  <para style="q1" vid="PSA 109:21">dok ilara bene pi mar meri ma pe loke!<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />An lacan, piny obwoya woko,</para>
  <para style="q1" vid="PSA 109:22">cwinya bedo katon atona keken.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Arwenyo woko calo tipu yat me otyeno;</para>
  <para style="q1" vid="PSA 109:23">kitenga woko cen macalo bonyo ma kitengo ki icing.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Pi rii kec kare ki kare omiyo conga dong odoko goro;</para>
  <para style="q1" vid="PSA 109:24">omiyo bene ajony woko dok adoko goro.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:25: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:39">Mat 27:39</ref>; <ref loc="MRK 15:29">Mar 15:29</ref></char>
    </note>Adoko dong ginanyera pa jo ma gidota;</para>
  <para style="q1" vid="PSA 109:25">ka gunena, ci giyengo wigi ayenga.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Konya, Ai Rwot Lubangana;</para>
  <para style="q1" vid="PSA 109:26">lara pi mar meri ma pe loke!<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Wek lukwora gunge ni</para>
  <para style="q1" vid="PSA 109:27">in aye ma ilaro an, Ai Rwot!<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Wek gin gucena, ento in imiya mere gum.</para>
  <para style="q1" vid="PSA 109:28">Wek alee otwod jo ma lwenyo ikomani,</para>
  <para style="q1" vid="PSA 109:28">ci an latici abed ma cwinya yom.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Wek jo ma gidota gulim lewic;</para>
  <para style="q1" vid="PSA 109:29">wek lewic oboo komgi woko calo guruku bongo.<verse eid="PSA 109:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Ci abimiyo pwoc bot Rwot ki dwon malongo;</para>
  <para style="q1" vid="PSA 109:30">dok abipake i dye lwake kama gucoke iye.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />En cung tung lacuc inget jo ma piny obwoyogi,</para>
  <para style="q1" vid="PSA 109:31">pi larogi ki i cing jo ma ngolo kop me to i wigi.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s1">Rwot ki laker ma en oyero</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:1: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:44">Mat 22:44</ref>; <ref loc="MRK 12:36">Mar 12:36</ref>; <ref loc="LUK 20:42-43">Luk 20:42-43</ref>; <ref loc="ACT 2:34-35">Tic 2:34-35</ref>; <ref loc="1CO 15:25">1 Kor 15:25</ref>; <ref loc="EPH 1:20-22">Epe 1:20-22</ref>; <ref loc="COL 3:1">Kol 3:1</ref>; <ref loc="HEB 1:13">Ibru 1:13</ref>; <ref loc="HEB 8:1">8:1</ref>; <ref loc="HEB 10:12-13">10:12-13</ref></char>
    </note>Rwot owaco bot rwoda ni,</para>
  <para style="q1" vid="PSA 110:1">“Bed ingeta tung acuc i kabedo me deyo,</para>
  <para style="q1" vid="PSA 110:1">nio ka abimiyo lukwori gidoko kom laten tyeni.”<verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />Rwot bicwalo odoo ker me tweroni ki i Cion.</para>
  <para style="q1" vid="PSA 110:2">En bimiyo ibedo kaloc i dye lukwori.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Inino ma ibilweny ikom lukwori,</para>
  <para style="q1" vid="PSA 110:3">lwaki gibimine ken gi boti me cito kalweny.</para>
  <para style="q1" vid="PSA 110:3">Calo toyo ma luk odiko con,</para>
  <para style="q1" vid="PSA 110:3">awobeni bibino boti kitmeno iwi godi maleng.<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:4: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 5:6">Ibru 5:6</ref>; <ref loc="HEB 6:20">6:20</ref>; <ref loc="HEB 7:17">7:17</ref>; <ref loc="HEB 7:21">7:21</ref></char>
    </note>Rwot dong okwongo kwong, pe dok biloko tame,</para>
  <para style="q1" vid="PSA 110:4">en owaco ni, “In ibibedo ajwaka nakanaka ikit pa Melkijedek.”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />Rwot tye tung lacuci;</para>
  <para style="q1" vid="PSA 110:5">inino ma kiniga omake en biloyo luker woko ducu.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />En bingolo kop ikom jo me rok ducu,</para>
  <para style="q1" vid="PSA 110:6">dok bipongo bar me lweny ki kom jo ma oto;</para>
  <para style="q1" vid="PSA 110:6">en biloyo luker ducu ma iwi loboni.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Laker bimato pii ki i ora kulu matye inget yoo,</para>
  <para style="q1" vid="PSA 110:7">meno bimiyo en ilo wiye malo pi loc ma en olimo.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s1">Pak pi tic me aura ma Rwot otiyo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Wupak Rwot!</para>
  <para style="q1" vid="PSA 111:1">Abimiyo pwoc bot Rwot ki cwinya ducu,</para>
  <para style="q1" vid="PSA 111:1">i coke pa jo ma cwinygi atir, i dye lwak ma gucoke.<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Tic ma Rwot tiyo dito dok me aura mada!</para>
  <para style="q1" vid="PSA 111:2">Jo ducu ma tice yomo cwinygi giketo cwinygi tutwal me niang iye.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Gin ducu ma en tiyo opong kideyo madit;</para>
  <para style="q1" vid="PSA 111:3">dok pore mere bedo nakanaka.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />En pe weko wiwa wil ikom tice me aura ma en otiyo;</para>
  <para style="q1" vid="PSA 111:4">Rwot ber dok lakica.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />En miyo cam bot jo ma lwore;</para>
  <para style="q1" vid="PSA 111:5">wiye bene po tutwal ikom gicikene.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />En onyutu twero me tice bot lwake,</para>
  <para style="q1" vid="PSA 111:6">ci miyogi lobo pa lurok wek gucam obed meggi.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Tic me cinge ducu bedo me ada dok tye atir,</para>
  <para style="q1" vid="PSA 111:7">cike ducu gene mada.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Gimoko matwal dok giri nakanaka,</para>
  <para style="q1" vid="PSA 111:8">ma myero kilubgi ki ada dok ki cwiny ma atir.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />En olaro jone,</para>
  <para style="q1" vid="PSA 111:9">dok oketo gicikene kwedgi me bedo matwal.</para>
  <para style="q1" vid="PSA 111:9">En leng dok myero kilwor nyinge!<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Yub 28:28</ref>; <ref loc="PRO 1:7">Car 1:7</ref>; <ref loc="PRO 9:10">9:10</ref></char>
    </note>Lworo Rwot aye acaki me ryeko,</para>
  <para style="q1" vid="PSA 111:10">dong jo malubu gin ma en ociko gibedo ki niang maber.</para>
  <para style="q1" vid="PSA 111:10">Kibipake nakanaka!<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s1">Yomcwiny pa dano ma lworo Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Wupak Rwot!</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q1" vid="PSA 112:1">Tye ki gum dano ma lworo Rwot,</para>
  <para style="q1" vid="PSA 112:1">ma cwinye yom kalubu cike.<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Likwayone gibibedo twoni oteka i lobo ma gibedo iye;</para>
  <para style="q1" vid="PSA 112:2">likwayo pa ngat ma cwinye atir kibimiyogi gum.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Jo me ote gibilony dok gibedo ki lwak jami mapol,</para>
  <para style="q1" vid="PSA 112:3">dok kite ma atiri bene bibedo nakanaka.<verse eid="PSA 112:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />En bibedo dero maryeny i colpiny pi jo ma cwinygi atir,</para>
  <para style="q1" vid="PSA 112:4">gin jo maber, lukica, dok kitgi atir.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Dano ma cwinye yom,</para>
  <para style="q1" vid="PSA 112:5">mamiyo banya bot luwote, bibedo maber,</para>
  <para style="q1" vid="PSA 112:5">en cato cate ki gen.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Dano ma kite atir pe kibidiro cen;</para>
  <para style="q1" vid="PSA 112:6">kibipo pire nakanaka.<verse eid="PSA 112:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />En pe bedo ki lworo kadi ka owinyo lok marac me cwercwiny;</para>
  <para style="q1" vid="PSA 112:7">bedo ma cwinye tek kun geno Rwot.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />En bedo ma cwinye opye mot, pe bilworo gin mo,</para>
  <para style="q1" vid="PSA 112:8">nio wang ma oneno ka kiloyo lukwore.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:9: </char>
      <char style="xt" closed="false">
        <ref loc="2CO 9:9">2 Kor 9:9</ref>
      </char>
    </note>En poko jami nono bot lucan;</para>
  <para style="q1" vid="PSA 112:9">dok kite ma atiri bibedo nakanaka;</para>
  <para style="q1" vid="PSA 112:9">en bibedo ki twer dok kibiwore.<verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Dano marac ka oneno, ci kiniga mako woko;</para>
  <para style="q1" vid="PSA 112:10">bibedo kamwodo lake ma cwinye poto;</para>
  <para style="q1" vid="PSA 112:10">gen pa dano marac rwenyo woko matwal.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s1">Pak pi ber pa Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Wupak Rwot!</para>
  <para style="q1" vid="PSA 113:1">Wun lutic pa Rwot wupake,</para>
  <para style="q1" vid="PSA 113:1">wupak nying Rwot!<verse eid="PSA 113:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Kipak nying Rwot nakanaka</para>
  <para style="q1" vid="PSA 113:2">nia tin nio nino ma pe tum!<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Cake kunyango nio kupotoceng</para>
  <para style="q1" vid="PSA 113:3">myero kipak nying Rwot!<verse eid="PSA 113:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Rwot en laloc pa rok ducu,</para>
  <para style="q1" vid="PSA 113:4">ki deyone bene tye malo ma okato polo woko.<verse eid="PSA 113:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Anga macalo Rwot Lubangawa,</para>
  <para style="q1" vid="PSA 113:5">ma bedo i kabedone matye malo,<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />ma kule neno piny kamabor ki kunu,</para>
  <para style="q1" vid="PSA 113:6">ma neno polo ki lobo?<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />En ilo lucan malo nia ki i apwa,</para>
  <para style="q1" vid="PSA 113:7">dok tingo jo ma piny obwoyogi kwanyogi woko ki iwi odur,<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />ci miyo gibedo kacel ki rwodi,</para>
  <para style="q1" vid="PSA 113:8">ma gin aye rwodi pa lwake.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />En miyo paco bot dako ma lalur,</para>
  <para style="q1" vid="PSA 113:9">dok miyo nongo lutino ci dong bedo ki yomcwiny madwong.</para>
  <para style="q1" vid="PSA 113:9">Wupak Rwot!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s1">Wer me Karama me Kato</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Nia 12:51</ref>
      </char>
    </note>Ikare ma jo Icrael gua woko ki i Ejipt,</para>
  <para style="q1" vid="PSA 114:1">ikare ma likwayo pa Yakobo</para>
  <para style="q1" vid="PSA 114:1">guweko lobo pa lurok ma jone loko leb mapat atika,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />Juda odoko jo maleng pa Lubanga,</para>
  <para style="q1" vid="PSA 114:2">ci Icrael odoko lobone ma en loyo.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:3: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Nia 14:21</ref>; <ref loc="JOS 3:16">Yoc 3:16</ref></char>
    </note>Nam oneno ci oringo woko,</para>
  <para style="q1" vid="PSA 114:3">kulu Jordan ocung woko ma pe mol.<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Godi gupye calo nyogi romi,</para>
  <para style="q1" vid="PSA 114:4">ki cere bene gupye calo lutino romi.<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />In nam, ango mutime ma omiyo iringo wokoni?</para>
  <para style="q1" vid="PSA 114:5">Dok in Jordan, icung woko ma pe imol pingo?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Wun godi kono, pingo wubedo kapye calo nyogi romi?</para>
  <para style="q1" vid="PSA 114:6">Wun cere, pingo wubedo kapye calo lutino romi?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />In lobo, myero komi omyel, pien Rwot dong cok bino;</para>
  <para style="q1" vid="PSA 114:7">myero komi omyel inyim Rwot Lubanga pa Yakobo,<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Nia 17:1-7</ref>; <ref loc="NUM 20:2-13">Wel 20:2-13</ref></char>
    </note>maloko pata got doko kama pii pong iye,</para>
  <para style="q1" vid="PSA 114:8">ki lacol got loko doko wang it ma gunye agunya.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s1">Lubanga me ada</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Deyo obed boti keken, Ai Rwot,</para>
  <para style="q1" vid="PSA 115:1">ento pe obed botwa,</para>
  <para style="q1" vid="PSA 115:1">pi mar meri ma pe loke kacel ki geneni.<verse eid="PSA 115:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Pingo lurok myero gupenywa ni,</para>
  <para style="q1" vid="PSA 115:2">“Lubangawu tye kwene?”<verse eid="PSA 115:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Lubangawa tye i polo,</para>
  <para style="q1" vid="PSA 115:3">en timo gin ma cwinye mito.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:15-18">Jab 135:15-18</ref>; <ref loc="REV 9:20">Niy 9:20</ref></char>
    </note>Cal lubangagi kiyubu ki ryal dok ki jabu;</para>
  <para style="q1" vid="PSA 115:4">meno gin ma dano yubu ki cinggi.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Doggi tye, ento pe gitwero lok,</para>
  <para style="q1" vid="PSA 115:5">wanggi bene tye, ento pe gitwero neno piny.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Itgi tye, ento pe gitwero winyo lok,</para>
  <para style="q1" vid="PSA 115:6">umgi tye, ento pe gitwero ngweyo piny.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Cinggi tye, ento pe gitwero bongo piny,</para>
  <para style="q1" vid="PSA 115:7">tyen gi bene tye ento pe gitwero wot;</para>
  <para style="q1" vid="PSA 115:7">pe tye gin mo matwero winye ki i dwon gi.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Jo ma gitiyo cal lubanga magi girom aroma kwedgi,</para>
  <para style="q1" vid="PSA 115:8">ki jo ducu ma geno cal lubanga magi bene gitye kitmeno.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Wun jo Icrael, wugen Rwot!</para>
  <para style="q1" vid="PSA 115:9">En aye ma konyowu dok gwokowu.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Wun jo me ot pa Aron bene wugen Rwot!</para>
  <para style="q1" vid="PSA 115:10">En aye ma konyowu dok gwokowu.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Wun jo ma wulworo Rwot, wugen Rwot!</para>
  <para style="q1" vid="PSA 115:11">En aye ma konyowu dok gwokowu.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />Rwot pud po ikomwa dok bimiyowa gum;</para>
  <para style="q1" vid="PSA 115:12">en bimiyo gum bot jo Icrael,</para>
  <para style="q1" vid="PSA 115:12">ki bot jo me ot pa Aron ducu.<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:13: </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:18">Niy 11:18</ref>; <ref loc="REV 19:5">19:5</ref></char>
    </note>Rwot bimiyo gum bot jo ducu ma gilwore,</para>
  <para style="q1" vid="PSA 115:13">jo matino ki bot jo madito maromrom.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Rwot myero omed lutino botwu,</para>
  <para style="q1" vid="PSA 115:14">wun kacel ki likwayowu.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Rwot myero omii ki wun gum,</para>
  <para style="q1" vid="PSA 115:15">en Rwot ma ocweo polo ki lobo!<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Polo obedo polo pa Rwot,</para>
  <para style="q1" vid="PSA 115:16">ento en omiyo lobo bot dano ni gubed iye.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Jo ma oto pe gipako Rwot,</para>
  <para style="q1" vid="PSA 115:17">kadi wa jo ma dong gitye piny kama piny oling mot bene pe gipako Rwot.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Ento wan jo makwo wabimiyo pwocwa bot Rwot</para>
  <para style="q1" vid="PSA 115:18">nia tin nio nino ma pe tum.</para>
  <para style="q1" vid="PSA 115:18">Wupak Rwot!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s1">Pako Lubanga pi laro dano ki i to</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Amaro Rwot, pien en winyo kokona;</para>
  <para style="q1" vid="PSA 116:1">en winyo dwona kacel ki legana me bako dog ma alege kwede.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Kit macalo en ociko ite me winyo leganani,</para>
  <para style="q1" vid="PSA 116:2">pimeno abibedo kakok bote nino ki nino pi kare me kwona ducu.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />To onongo ociko owicce oruma kwede woko dyere,</para>
  <para style="q1" vid="PSA 116:3">arem me lyel onongo bene otwene woko ikoma liking;</para>
  <para style="q1" vid="PSA 116:3">onongo abedo ki can dok ki remcwiny madwong.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />Cutcut akok bot Rwot ni, “Ai Rwot, alegi, lara do!”<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />Rwot lakica dok opore;</para>
  <para style="q1" vid="PSA 116:5">Lubangawa latim kica.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />Rwot gwoko jo ma lakonygi peke;</para>
  <para style="q1" vid="PSA 116:6">ikare ma kidiya woko piny, en olara.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />In cwinya, ywe mot,</para>
  <para style="q1" vid="PSA 116:7">pien Rwot dong otyeko nyutu ber ma mere bene bota.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />Rwot olara ki i to;</para>
  <para style="q1" vid="PSA 116:8">en odunyu pig wanga woko,</para>
  <para style="q1" vid="PSA 116:8">dok ogwoka omiyo tyena pe ocato.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Piman, atye kawot inyim Rwot</para>
  <para style="q1" vid="PSA 116:9">i lobo pa jo makwo.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:10: </char>
      <char style="xt" closed="false">
        <ref loc="2CO 4:13">2 Kor 4:13</ref>
      </char>
    </note>Amede ki ye en, kadi onongo awaco ni,</para>
  <para style="q1" vid="PSA 116:10">“Can dong oketo koma woko,”<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />kadi ikare ma onongo abedo ki lworo ma awaco ni,</para>
  <para style="q1" vid="PSA 116:11">“Dano ducu pe gene.”<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Abimiyo gin ango bot Rwot</para>
  <para style="q1" vid="PSA 116:12">pi gin maber ducu ma en otiyo pira?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Abitingo kikopo ma nyutu lar mere,</para>
  <para style="q1" vid="PSA 116:13">abipwoye kun alwongo nyinge, pien en olara.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Abicobo kwong mayam akwongo bot Rwot,</para>
  <para style="q1" vid="PSA 116:14">inyim lwake ducu kama gucoke iye.<verse eid="PSA 116:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Ka ngat acel ki ikin jo ma geno Rwot oto</para>
  <para style="q1" vid="PSA 116:15">cwero cwiny Rwot mada.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Ai Rwot, an latici;</para>
  <para style="q1" vid="PSA 116:16">an latici, macalo maa bene yam otiyo boti.</para>
  <para style="q1" vid="PSA 116:16">In dong ityeko gonyo nyor me to ma kitweya kwede woko.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Abityero boti gitum me pwoc</para>
  <para style="q1" vid="PSA 116:17">dok abilwongo nying Rwot.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Abicobo kwong mayam akwongo bot Rwot,</para>
  <para style="q1" vid="PSA 116:18">inyim lwake ducu kama gucoke iye,<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />idyekal me Ot pa Rwot,</para>
  <para style="q1" vid="PSA 116:19">i dyeri, in Jerucalem.</para>
  <para style="q1" vid="PSA 116:19">Wupak Rwot.<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s1">Wer me pako Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">117:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:11">Rom 15:11</ref>
      </char>
    </note>Wupak Rwot, wun rok ducu!</para>
  <para style="q1" vid="PSA 117:1">Wudwore, wun lwak ducu!<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Mar mere ma pe loke dit pirwa,</para>
  <para style="q1" vid="PSA 117:2">ki genene bene bedo matwal.</para>
  <para style="q1" vid="PSA 117:2">Wupak Rwot!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s1">Lega me pwoc pi loc</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Tek 16:34</ref>; <ref loc="2CH 5:13">2 Tek 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Eji 3:11</ref>; <ref loc="PSA 100:5">Jab 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Jer 33:11</ref></char>
    </note>Wumii pwoc bot Rwot, pien en ber,</para>
  <para style="q1" vid="PSA 118:1">mar mere ma pe loke bedo nakanaka!<verse eid="PSA 118:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Jo Icrael myero guwac ni,</para>
  <para style="q1" vid="PSA 118:2">“Mar mere ma pe loke bedo nakanaka.”<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Jo me ot pa Aron myero guwac ni,</para>
  <para style="q1" vid="PSA 118:3">“Mar mere ma pe loke bedo nakanaka.”<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Jo ma lworo Rwot bene myero guwac ni,</para>
  <para style="q1" vid="PSA 118:4">“Mar mere ma pe loke bedo nakanaka.”<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Akok bot Rwot ki i can ma odiya;</para>
  <para style="q1" vid="PSA 118:5">Rwot ogamo legana ci ogonya woko.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:6: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 13:6">Ibru 13:6</ref>
      </char>
    </note>Rwot tye kweda, pe abilworo gin mo.</para>
  <para style="q1" vid="PSA 118:6">Dano adana kono twero timo gin ango ikoma?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />Rwot tye kweda, en aye ma konya.</para>
  <para style="q1" vid="PSA 118:7">Abineno ki wang me loc jo ma daga.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Ringo kalare bot Rwot</para>
  <para style="q1" vid="PSA 118:8">ber kato geno dano.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Ringo kalare bot Rwot</para>
  <para style="q1" vid="PSA 118:9">ber kato geno luloc me lobo.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Rok ducu onongo oruma woko dyere,</para>
  <para style="q1" vid="PSA 118:10">ento atyekogi woko ducu i nying Rwot!<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Gin onongo guruma woko dyere,</para>
  <para style="q1" vid="PSA 118:11">guruma woko dyere i kabedo ducu;</para>
  <para style="q1" vid="PSA 118:11">ento atyekogi woko ducu i nying Rwot!<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Gin onongo guruma woko dyere calo nyig kic,</para>
  <para style="q1" vid="PSA 118:12">gubino ikoma oyotoyot macalo mac ma wango okutu,</para>
  <para style="q1" vid="PSA 118:12">ento atyekogi woko ducu i nying Rwot!<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Gucora matek ma onongo dong acok poto,</para>
  <para style="q1" vid="PSA 118:13">ento Rwot okonya.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:2">Nia 15:2</ref>; <ref loc="ISA 12:2">Ica 12:2</ref></char>
    </note>Rwot aye teka ki kerona,</para>
  <para style="q1" vid="PSA 118:14">en dong odoko lalara.<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Wuwiny wer ma kiwero me loc i kema pa jo ma kitgi atir ni,</para>
  <para style="q1" vid="PSA 118:15">“Twero pa Rwot olwenyo lweny matek!<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />Twerone omiyo waloyo,</para>
  <para style="q1" vid="PSA 118:16">twero pa Rwot kelo loc!”<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Pe abito, ento abibedo kwo,</para>
  <para style="q1" vid="PSA 118:17">kun abitito pi gin ma Rwot dong otiyo.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />Rwot dong opwoda marac tutwal,</para>
  <para style="q1" vid="PSA 118:18">ento pe oneka woko gire.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Yaba dog gang me kit ma atir,</para>
  <para style="q1" vid="PSA 118:19">wek adony ki iye,</para>
  <para style="q1" vid="PSA 118:19">ci amii pwoc bot Rwot.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Man aye dog gang pa Rwot,</para>
  <para style="q1" vid="PSA 118:20">jo ma kitgi atir gibidonyo ki iye.<verse eid="PSA 118:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Apwoyi pien dong igamo doga,</para>
  <para style="q1" vid="PSA 118:21">dong idoko lalara.<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:22: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:17">Luk 20:17</ref>; <ref loc="ACT 4:11">Tic 4:11</ref>; <ref loc="1PE 2:7">1 Pet 2:7</ref></char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">118:22: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:42">Mat 21:42</ref>; <ref loc="MRK 12:10-11">Mar 12:10-11</ref></char>
    </note>Got ma lugedo gukwero,</para>
  <para style="q1" vid="PSA 118:22">en aye odoko got madit me twok ot.<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Man Rwot aye ma otimo,</para>
  <para style="q1" vid="PSA 118:23">obedo botwa lok me aura.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Man aye nino ma Rwot oyubu;</para>
  <para style="q1" vid="PSA 118:24">wabibedo iye ki yomcwiny madwong.<verse eid="PSA 118:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:25: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mat 21:9</ref>; <ref loc="MRK 11:9">Mar 11:9</ref>; <ref loc="JHN 12:13">Jon 12:13</ref></char>
    </note>Ai Rwot, walegi, ilarwa!</para>
  <para style="q1" vid="PSA 118:25">Rwot walegi, mii ticwa ducu ocobe kakare!<verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:26: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mat 21:9</ref>; <ref loc="MAT 23:39">23:39</ref>; <ref loc="MRK 11:9">Mar 11:9</ref>; <ref loc="LUK 13:35">Luk 13:35</ref>; <ref loc="LUK 19:38">19:38</ref>; <ref loc="JHN 12:13">Jon 12:13</ref></char>
    </note>Lubanga omii gum ikom ngat ma bino i nying Rwot!</para>
  <para style="q1" vid="PSA 118:26">Walamo gum ikomi ki i Ot pa Rwot.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />Rwot aye Lubanga</para>
  <para style="q1" vid="PSA 118:27">en dong obedo ber ikomwa.</para>
  <para style="q1" vid="PSA 118:27">Wumak jang yat wuwot kwede ma wurye i tyeng,</para>
  <para style="q1" vid="PSA 118:27">wuwot wurum kwede keno tyer.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />In Lubangana, abimiyo pwoc boti;</para>
  <para style="q1" vid="PSA 118:28">in Lubangana, abidwori.<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Wumii pwoc bot Rwot, pien en ber,</para>
  <para style="q1" vid="PSA 118:29">mar mere ma pe loke bedo nakanaka!<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s1">Cik pa Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Gitye ki gum jo ma pe tye ki bal mo,</para>
  <para style="q1" vid="PSA 119:1">ma gibedo kun gilubu cik pa Rwot!<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Gitye ki gum jo ma gwoko lok me cadene,</para>
  <para style="q1" vid="PSA 119:2">ma giyenyo en ki cwinygi ducu,<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />gin jo ma pe timo gin marac,</para>
  <para style="q1" vid="PSA 119:3">ento gibedo kun gilubu yo pa Rwot.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Dong ityeko miyowa ciki</para>
  <para style="q1" vid="PSA 119:4">ni walubgi ducu ki cwinywa ducu.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Cwinya mito mada ni myero abed lagen i yona ducu me gwoko ciki!<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Ka aketo cwinya me lubu gin ducu ma ceng dong iciko,</para>
  <para style="q1" vid="PSA 119:6">ci bimiyo lewic pe bimaka.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Abipaki ki cwiny matye atir,</para>
  <para style="q1" vid="PSA 119:7">ka dong apwonye i ciki matye atiri.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Abigwoko gin ma iciko;</para>
  <para style="q1" vid="PSA 119:8">pimeno pe ibwota woko!<verse eid="PSA 119:8" /></para>
  <para style="s1">Lubu cik pa Rwot</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Jo matino gibigwoke ningning ma pe gibalo?</para>
  <para style="q1" vid="PSA 119:9">Gin bigwoke kun gilubu lok ma in iciko.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />An ayenyo in ki cwinya ducu;</para>
  <para style="q1" vid="PSA 119:10">gwoka wek pe angak woko ma abwoto lubu ciki.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />An dong akano loki i cwinya,</para>
  <para style="q1" vid="PSA 119:11">wek pe atim bal mo inyimi.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Apaki, Ai Rwot;</para>
  <para style="q1" vid="PSA 119:12">pwonya ki ciki!<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Abitucu ki doga kamaleng</para>
  <para style="q1" vid="PSA 119:13">lok ducu mayam iciko ma oa ki idogi.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Cwinya yom kalubu cik meri,</para>
  <para style="q1" vid="PSA 119:14">makato lonyo madwong ma alimo ducu.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Abilwodo lok me pwonyi ki i cwinya,</para>
  <para style="q1" vid="PSA 119:15">dok abiketo wanga me ngiyo kit yo me pwonyi ducu.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Abibedo ki yomcwiny pi ciki;</para>
  <para style="q1" vid="PSA 119:16">wiya pe biwil ikom loki wa ki acel.<verse eid="PSA 119:16" /></para>
  <para style="s1">Yomcwiny pi lubu cik pa Rwot</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Nyut beri bota an latici,</para>
  <para style="q1" vid="PSA 119:17">wek abed kun alubu loki.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Yab wanga wek abed ma aneno piny,</para>
  <para style="q1" vid="PSA 119:18">wek anen jami aura matye i ciki.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />An atye macalo labedo iwi lobo man;</para>
  <para style="q1" vid="PSA 119:19">pe ikan ciki woko ki bota!<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Cwinya puke pi kare ducu</para>
  <para style="q1" vid="PSA 119:20">kun amito niang lok me ciki.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Ijuku jo ma lungala, ma dong kiceno,</para>
  <para style="q1" vid="PSA 119:21">gin jo ma gungak gubwoto ciki.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Kwany yetgi ki cacgi woko ki ikoma,</para>
  <para style="q1" vid="PSA 119:22">pien abedo ka gwoko lok me cadeni.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Kadi bed rwodi gicoke kacel gibedo kapiro lok ikoma,</para>
  <para style="q1" vid="PSA 119:23">ento an latici pud abimede kalwodo lok ikom ciki.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Lok me cadeni yomo cwinya mada;</para>
  <para style="q1" vid="PSA 119:24">gin aye lumiina tam.<verse eid="PSA 119:24" /></para>
  <para style="s1">Keto cwiny pi lubu cik pa Rwot</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Abutu piny i apwa ma dong kiloya woko;</para>
  <para style="q1" vid="PSA 119:25">roc kwona odoco kit macalo yam iciko!<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Ikare ma atucu boti gin ducu ma ceng atiyo,</para>
  <para style="q1" vid="PSA 119:26">in igamo doga;</para>
  <para style="q1" vid="PSA 119:26">pwonya dong ki lok me ciki.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Konya wek ange kit yo ma myero alub kwede ciki,</para>
  <para style="q1" vid="PSA 119:27">ci abibedo kalwodo lok ikom tici me aura ma dong itiyo.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Cwercwiny dong obwoya woko;</para>
  <para style="q1" vid="PSA 119:28">miya teko, kit macalo yam iciko.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Gwoka wek pe alub yo marac,</para>
  <para style="q1" vid="PSA 119:29">ci ipwonya ki ciki pi kicani.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Ayero dong me bedo ngat ma gene,</para>
  <para style="q1" vid="PSA 119:30">kun aketo cwinya ikom ciki tutwal.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Ai Rwot, atyeko mako lok me cadeni woko liking;</para>
  <para style="q1" vid="PSA 119:31">pe iwek lewic omaka.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Cwinya mito lubu ciki,</para>
  <para style="q1" vid="PSA 119:32">pien dong ityeko medo niang matut bota.<verse eid="PSA 119:32" /></para>
  <para style="s1">Lega me bedo ki niang matut</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />Ai Rwot, pwonya wek ange kit yo ma myero alub kwede ciki,</para>
  <para style="q1" vid="PSA 119:33">ci abigwoko nio wa i agiki.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Miya aniang i ciki, wek agwokgi,</para>
  <para style="q1" vid="PSA 119:34">ci abibedo kalubune ki cwinya ducu.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Tela i yo me ciki,</para>
  <para style="q1" vid="PSA 119:35">pien yomo cwinya mada.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Wek abed ki miti me lubu lok me cadeni,</para>
  <para style="q1" vid="PSA 119:36">ma ka nongo lonyo pira kena.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Pe iwek abed kaneno jami atata ma konygi peke;</para>
  <para style="q1" vid="PSA 119:37">ento miya kwo me lubu yoni.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Cob cikeni bota an latici,</para>
  <para style="q1" vid="PSA 119:38">ma icike kwede bot jo ma gilwori.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Kwany tim cac ma alworo woko ki ikoma;</para>
  <para style="q1" vid="PSA 119:39">pien ciki ducu beco.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Nen, cwinya puke pi nongo ciki;</para>
  <para style="q1" vid="PSA 119:40">pien in ipore, miya dong kwo!<verse eid="PSA 119:40" /></para>
  <para style="s1">Geno cik pa Rwot</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />Nyuta kit macalo mar meri ma pe loke tye kwede ikoma, Ai Rwot,</para>
  <para style="q1" vid="PSA 119:41">dok ilara, kit macalo yam iciko.<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />Man bimiyo abedo ki lagam bot jo maloko lok me yet ikoma,</para>
  <para style="q1" vid="PSA 119:42">pien ageno loki.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Pe ikwany lok me ada woko ki idoga,</para>
  <para style="q1" vid="PSA 119:43">pien gena tye i cik ma meri.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Abigwoko ciki teretere ma pe akeng,</para>
  <para style="q1" vid="PSA 119:44">abigwoko nakanaka!<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Abibedo agonya,</para>
  <para style="q1" vid="PSA 119:45">pien dong ateme me lubu ciki.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Abitito lok me cadeni bene inyim luker,</para>
  <para style="q1" vid="PSA 119:46">ma lewic pe bimaka wa ki acel.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Anongo yomcwiny i lubu ciki ducu,</para>
  <para style="q1" vid="PSA 119:47">pien amarogi mada.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Aworo ciki, dok amarogi,</para>
  <para style="q1" vid="PSA 119:48">abilwodo lok me ciki ki i cwinya.<verse eid="PSA 119:48" /></para>
  <para style="s1">Gen ikom cik pa Rwot</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Po pi lok ma iloko bot latici,</para>
  <para style="q1" vid="PSA 119:49">ma imiya dong aketo gena iyeni.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Kadi ka atye i can, loki kweyo cwinya;</para>
  <para style="q1" vid="PSA 119:50">pien cikeni dong omiya kwo.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Jo ma luwake dong ginywara anywara,</para>
  <para style="q1" vid="PSA 119:51">ento pe aloke aweko ciki.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />Ka apo ikom cik mayam ipwonya kwede ikare ma okato angec,</para>
  <para style="q1" vid="PSA 119:52">kweyo cwinya, Ai Rwot.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Akemo malyet omaka woko pi jo maracu,</para>
  <para style="q1" vid="PSA 119:53">gin jo ma gibwoto ciki pe gilubu.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Ka mo ducu ma abedo iye,</para>
  <para style="q1" vid="PSA 119:54">ayubu wer ma awero pi ciki.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />Apo piri i dyewor, Ai Rwot,</para>
  <para style="q1" vid="PSA 119:55">dok alubu ciki.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Man aye gum ma alimo</para>
  <para style="q1" vid="PSA 119:56">pien agwoko ciki ducu.<verse eid="PSA 119:56" /></para>
  <para style="s1">Keto cwiny i cik pa Rwot</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />In aye gin ma amito, Ai Rwot;</para>
  <para style="q1" vid="PSA 119:57">acike me lubu loki ducu.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Alegi ki cwinya ducu,</para>
  <para style="q1" vid="PSA 119:58">tima kica, kit macalo yam icike kwede.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Ka atamo pi yoni,</para>
  <para style="q1" vid="PSA 119:59">ci aloke acike me lubu lok me cadeni.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Arune woko oyotoyot ma pe agale</para>
  <para style="q1" vid="PSA 119:60">pi lubu ciki.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Kadi bed jo maracu giciko tolgi giruma kwede dyere,</para>
  <para style="q1" vid="PSA 119:61">ento wiya pe biwil ikom ciki.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />I dyewor aa malo kapaki,</para>
  <para style="q1" vid="PSA 119:62">pi ciki matye atir.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />An larem dano ducu ma lwori,</para>
  <para style="q1" vid="PSA 119:63">ki jo ma gilubu ciki.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />Ai Rwot, lobo opong ki mar meri ma pe loke;</para>
  <para style="q1" vid="PSA 119:64">pwonya ki ciki!<verse eid="PSA 119:64" /></para>
  <para style="s1">Ber matye i cik pa Rwot</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Ai Rwot, igwoko cikeni giri,</para>
  <para style="q1" vid="PSA 119:65">dok itiyo kweda maber, an latici.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Pwonya ki ryeko ki ngec maber,</para>
  <para style="q1" vid="PSA 119:66">pien ageno gin ma iciko.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Ikare ma pud peya imiya can,</para>
  <para style="q1" vid="PSA 119:67">onongo angak woko ata;</para>
  <para style="q1" vid="PSA 119:67">ento kombedi dong agwoko loki.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />In iber, dok itimo gin maber bene;</para>
  <para style="q1" vid="PSA 119:68">pwonya ki ciki.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Jo ma luwake gimedo lok goba ikoma,</para>
  <para style="q1" vid="PSA 119:69">ento an alubu ciki ki cwinya ducu.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Jo meno wigi oding woko,</para>
  <para style="q1" vid="PSA 119:70">ento an anongo yomcwiny i lubu ciki.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Can ma alimoni obedo ber bota matek,</para>
  <para style="q1" vid="PSA 119:71">oweko apwonye ikom lok me ciki.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Lok me cik ma imiya ber bota</para>
  <para style="q1" vid="PSA 119:72">makato lwak lim me jabu ki ryal alip ki alip.<verse eid="PSA 119:72" /></para>
  <para style="s1">Ngolo kop ki cik pa Rwot</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Cingi aye ocweya dok igwoka bene maber;</para>
  <para style="q1" vid="PSA 119:73">miya niang matut wek apwony lok me ciki.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Jo ma lwori gibinena ci gibedo ki yomcwiny,</para>
  <para style="q1" vid="PSA 119:74">pien dong ageno loki.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />Ai Rwot, angeyo ni ngolo kopi tye atir,</para>
  <para style="q1" vid="PSA 119:75">imiyo aneno can pi gene ma itye kwede.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Wek mar meri ma pe loke obed pi kweyo cwinya,</para>
  <para style="q1" vid="PSA 119:76">kit macalo yam icike kwede bota an latici.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Tima kica wek abed kwo,</para>
  <para style="q1" vid="PSA 119:77">pien anongo yomcwiny i ciki.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Wek lewic omak jo ma giwake pien gidota ki lok goba;</para>
  <para style="q1" vid="PSA 119:78">ento an abibedo kalwodo lok ikom pwonyi.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Wek jo ma gilwori gubin bota,</para>
  <para style="q1" vid="PSA 119:79">ci gunge lok me caden meri.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Wek abed ma cwinya leng kun alubu ciki,</para>
  <para style="q1" vid="PSA 119:80">wek lewic pe omaka.<verse eid="PSA 119:80" /></para>
  <para style="s1">Lega pi lar</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />An dong aol woko pi kuru lar meri;</para>
  <para style="q1" vid="PSA 119:81">an ageno lok meri keken.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Wanga dong ojony woko pi kuru neno gin ma icike pire;</para>
  <para style="q1" vid="PSA 119:82">apenye ni, “In ibikweyo cwinya naka awene?”<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Dong adoko calo opoko kongo bwino ma yito obalo woko,</para>
  <para style="q1" vid="PSA 119:83">ento wiya pud peya owil ikom ciki.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Imito an latici akur pi kare marom mene?</para>
  <para style="q1" vid="PSA 119:84">Ibingolo kop ikom jo ma gilibani awene?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Jo ma luwake ma pe gilubu cikini</para>
  <para style="q1" vid="PSA 119:85">gukwinyo bur ma myero apot iye.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Ciki ducu tye ada;</para>
  <para style="q1" vid="PSA 119:86">ento dano giliba labongo tyen lok mo;</para>
  <para style="q1" vid="PSA 119:86">konya do!<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Onongo dong gicok kwanyo kwona woko ki i lobo,</para>
  <para style="q1" vid="PSA 119:87">ento an pe abwoto ciki.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Miya abed kwo pi mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 119:88">wek agwok lok me cadeni mayam iloko ki dogini.<verse eid="PSA 119:88" /></para>
  <para style="s1">Bedo ki niye i cik pa Rwot</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />Ai Rwot, lok ma meri bedo nakanaka;</para>
  <para style="q1" vid="PSA 119:89">tye ma ocung woko liking i polo.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Gene ma itye kwede bedo bot yalwak me kare ducu;</para>
  <para style="q1" vid="PSA 119:90">iketo lobo ocung matek i kabedone.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Jami ducu ocung nio wa onyo pi ciki;</para>
  <para style="q1" vid="PSA 119:91">pien gin ducu lutici.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Ka nene pe anongo yomcwiny i ciki,</para>
  <para style="q1" vid="PSA 119:92">kono ato i cana.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Wiya pe biwil ikom ciki,</para>
  <para style="q1" vid="PSA 119:93">pien igwoka ma pud akwo pi lubu ciki.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />An a danoni, lara do!</para>
  <para style="q1" vid="PSA 119:94">Atemo lubu ciki mada.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Jo maracu gikane gikiya wek gineka woko,</para>
  <para style="q1" vid="PSA 119:95">ento an atamo pi lok me ciki.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Dong aneno ni jami ducu ma iwi loboni agikigi tye,</para>
  <para style="q1" vid="PSA 119:96">ento ciki pe tye ki agikine.<verse eid="PSA 119:96" /></para>
  <para style="s1">Mar pi cik pa Rwot</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Amaro ciki tutwal!</para>
  <para style="q1" vid="PSA 119:97">Dok abedo kalwodo lok ikom ciki dyeceng jwi.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Ciki miyo abedo ryek ma akato lukwora woko,</para>
  <para style="q1" vid="PSA 119:98">pien atye kwede nino ducu.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Dong atye ki niang maber ma oromo,</para>
  <para style="q1" vid="PSA 119:99">akato lupwonya woko ducu,</para>
  <para style="q1" vid="PSA 119:99">pien abedo kalwodo lok ikom lok me cadeni kare ki kare.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Aniang bene aloyo jo muteggi,</para>
  <para style="q1" vid="PSA 119:100">pien alubu gin ma iciko.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Ajuke kena wek pe atim gin marac,</para>
  <para style="q1" vid="PSA 119:101">pien amito gwoko loki.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Pe aweko ciki,</para>
  <para style="q1" vid="PSA 119:102">pien in dong ityeko pwonya.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Loki bile mamit adada ki bota</para>
  <para style="q1" vid="PSA 119:103">lim idoga makato moo kic woko!<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Alimo niang madwong ki i ciki</para>
  <para style="q1" vid="PSA 119:104">pimeno omiyo akwero yo me goba ducu.<verse eid="PSA 119:104" /></para>
  <para style="s1">Dero matye i cik pa Rwot</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Loki calo tara ma menyo ka tyena,</para>
  <para style="q1" vid="PSA 119:105">dok tye calo ceng ma menyo yoo ma awoto iye.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Dong atyeko kwongo kwong dok amoko bene,</para>
  <para style="q1" vid="PSA 119:106">me lubu ciki matye atir.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Arem me can ma atye kwede dong oketo koma woko;</para>
  <para style="q1" vid="PSA 119:107">Ai Rwot, gwoka abed makwo kit macalo yam icike kwede.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />Gam pwoca me pak ma akelo boti, Ai Rwot,</para>
  <para style="q1" vid="PSA 119:108">dok ipwonya ki ciki.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Kare ducu ayube me dyero kwona i peko,</para>
  <para style="q1" vid="PSA 119:109">ento wiya pe wil ikom ciki.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Jo maracu guciko owic me maka,</para>
  <para style="q1" vid="PSA 119:110">ento an pe angak aweko lubu ciki.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Lok me ciki gin aye ginaleya ma mera ma bedo nakanaka;</para>
  <para style="q1" vid="PSA 119:111">gin aye yomcwiny ma mera.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Aketo cwinya ada me tiyo gin ma iciko</para>
  <para style="q1" vid="PSA 119:112">nakanaka, nio wa nino me agiki.<verse eid="PSA 119:112" /></para>
  <para style="s1">Cik pa Rwot miyo dano bedo gwoke</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Adag jo ma tamgi tye aryo,</para>
  <para style="q1" vid="PSA 119:113">ento amaro ciki.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />In aye kalarena ki kwota,</para>
  <para style="q1" vid="PSA 119:114">ageno lok ma iciko.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Ayu woko ki ingeta, wun lutim maracu,</para>
  <para style="q1" vid="PSA 119:115">wek an abed kun alubu cik pa Lubangana.<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Konya macalo yam iciko, wek abed kwo,</para>
  <para style="q1" vid="PSA 119:116">pe iwek kiket lewic ikoma pi gen ma dong atyeko geni kwede.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Tinga malo, ci abibedo maber i gwok ma meri,</para>
  <para style="q1" vid="PSA 119:117">miyo abiketo cwinya kalubu ciki kare ducu.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Ikwero jo ma ngak woko ma giweko lubu ciki;</para>
  <para style="q1" vid="PSA 119:118">tim bwologini konye peke.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Itero jo maracu ducu matye iwi loboni calo yugi;</para>
  <para style="q1" vid="PSA 119:119">pimeno an amaro lubu ciki.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Koma ducu myel amyela pi lworo in,</para>
  <para style="q1" vid="PSA 119:120">apong ki lworo pi ngolo kop ma meri.<verse eid="PSA 119:120" /></para>
  <para style="s1">Lubu cik pa Rwot</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Atiyo gin matye atir dok kakare;</para>
  <para style="q1" vid="PSA 119:121">pe iweka i cing jo ma giunani.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Cike bota ni ibitimo gin maber pira, an latici,</para>
  <para style="q1" vid="PSA 119:122">dok pe iwek jo ma pe gilworo Lubanga gutera marac.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Wanga dong ojony woko pi kuru lar meri,</para>
  <para style="q1" vid="PSA 119:123">ki pi cobo cikeni matye atiri.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Tii ki latici ki mar meri ma pe loke,</para>
  <para style="q1" vid="PSA 119:124">dok ipwonya ki lok me ciki.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />An latici, miya niang maber,</para>
  <para style="q1" vid="PSA 119:125">wek ange lok me cikeni.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />Rwot, kare dong oromo myero i tim gin mo,</para>
  <para style="q1" vid="PSA 119:126">pien lwak guturu ciki woko pe dong gilubu.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Adada amaro ciki</para>
  <para style="q1" vid="PSA 119:127">makato jabu, makato jabu ma kiliyo maber.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Atiyo ki ciki me tela i kwona;</para>
  <para style="q1" vid="PSA 119:128">adag kit yo ducu me goba.<verse eid="PSA 119:128" /></para>
  <para style="s1">Miti me lubu cik pa Rwot</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Ciki ducu tye me aura;</para>
  <para style="q1" vid="PSA 119:129">pimeno alubugi ki cwinya ducu.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Niang ikom loki miyo dero bot dano,</para>
  <para style="q1" vid="PSA 119:130">dok miyo niang bot jo ma peke ki ngec.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Angamo doga, abedo kaomo cwinya ki yweyo,</para>
  <para style="q1" vid="PSA 119:131">pien amito alub ciki.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Loke tung bota, ci itima kica,</para>
  <para style="q1" vid="PSA 119:132">kit macalo itimo kwede kica bot jo ma maro in.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Gwoka wek pe apoti,</para>
  <para style="q1" vid="PSA 119:133">kit macalo yam dong iciko,</para>
  <para style="q1" vid="PSA 119:133">pe iwek bal mo oloo kwona.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Lara woko ki i cing jo ma giuna,</para>
  <para style="q1" vid="PSA 119:134">wek abed kun agwoko ciki.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Nen latici ki wang me kica,</para>
  <para style="q1" vid="PSA 119:135">dok ipwonya ki lok me ciki.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Pig wanga cwer dok mol matek,</para>
  <para style="q1" vid="PSA 119:136">pien dano pe gigwoko ciki.<verse eid="PSA 119:136" /></para>
  <para style="s1">Cik pa Rwot tye atir dok kakare</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />In kiti tye atir, Ai Rwot,</para>
  <para style="q1" vid="PSA 119:137">dok kop ma ingolo tye atir.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Ciki ma imiyo ducu gitye atir,</para>
  <para style="q1" vid="PSA 119:138">dok bene gigene.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Arima ki kiniga wango koma calo mac,</para>
  <para style="q1" vid="PSA 119:139">pien lukwora wigi owil woko ikom loki.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Cikeni gene atika,</para>
  <para style="q1" vid="PSA 119:140">omiyo an latici amarogi mada.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />An pira pe tek, dok kicaya bene,</para>
  <para style="q1" vid="PSA 119:141">ento wiya pe wil ikom lok me ciki.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />In kiti tye atir dok bedo nakanaka,</para>
  <para style="q1" vid="PSA 119:142">ki ciki bene cik me ada.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Can ki cwercwiny dong opoto woko ikoma,</para>
  <para style="q1" vid="PSA 119:143">ento ciki aye miya yomcwiny.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Lok me ciki tye atir dok bedo nakanaka;</para>
  <para style="q1" vid="PSA 119:144">miya niang maber ci weko abedo kwo.<verse eid="PSA 119:144" /></para>
  <para style="s1">Lega pi lar</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />Akok boti ki cwinya ducu; gam doga, Ai Rwot!</para>
  <para style="q1" vid="PSA 119:145">Abigwoko ciki.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Akok boti;</para>
  <para style="q1" vid="PSA 119:146">lara do, ci abilubu lok me ciki.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Aa malo ma pud peya piny oru ci akok boti pi kony;</para>
  <para style="q1" vid="PSA 119:147">pud ageno loki.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Abutu i dyewor ci aco woko, wanga bedo twolo,</para>
  <para style="q1" vid="PSA 119:148">kun abedo kalwodo pi ciki ki i cwinya.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Ai Rwot, winy dwona pi mar meri ma pe loke;</para>
  <para style="q1" vid="PSA 119:149">roc kwona odoco i ngolo kopi matye atiri.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Jo ma giliba ginyiko cok kun gitamo me timo gin marac ikoma;</para>
  <para style="q1" vid="PSA 119:150">gin jo ma pe gilubu ciki.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Ento in icok kweda, Ai Rwot,</para>
  <para style="q1" vid="PSA 119:151">ki ciki ducu tye me ada.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Yam con apwonye ki ilok me cik ma meri,</para>
  <para style="q1" vid="PSA 119:152">ma iketogi me bedo nakanaka.<verse eid="PSA 119:152" /></para>
  <para style="s1">Koko pi kony</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Nen cana dok i lara,</para>
  <para style="q1" vid="PSA 119:153">pien wiya pe wil ikom ciki.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Pid pira ci ikoka;</para>
  <para style="q1" vid="PSA 119:154">miya kwo kit macalo yam iciko.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Lare bor mada ki bot jo maracu,</para>
  <para style="q1" vid="PSA 119:155">pien pe giye lubu ciki.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />Ento kicani dit makato, Ai Rwot;</para>
  <para style="q1" vid="PSA 119:156">miya kwo kit macalo loci tye atiri.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Jo ma lwenyo ikoma ki lumeroka gipol,</para>
  <para style="q1" vid="PSA 119:157">ento pe alenge aweko lubu ciki.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Ka aneno jo ma pe gigene, ci cwinya lema,</para>
  <para style="q1" vid="PSA 119:158">pien pe gigwoko ciki.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Tam kit macalo amaro kwede lok me ciki!</para>
  <para style="q1" vid="PSA 119:159">Gwok kwona pi mar meri ma pe loke.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Loki ducu ocung ikom ada,</para>
  <para style="q1" vid="PSA 119:160">ciki ducu tye atir gibedo nakanaka.<verse eid="PSA 119:160" /></para>
  <para style="s1">Keto cwiny pi lubu cik pa Rwot</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Rwodi lwenyo ikoma labongo tyen lok mo,</para>
  <para style="q1" vid="PSA 119:161">ento abedo kun atye ki lworo i cwinya pi loki,<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Abedo ki yomcwiny pi loki</para>
  <para style="q1" vid="PSA 119:162">calo dano ma onongo jami mapol ma kiyako.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Adag dok akwero lok goba,</para>
  <para style="q1" vid="PSA 119:163">ento amaro ciki.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Apaki nino ki nino tyen abiro</para>
  <para style="q1" vid="PSA 119:164">pi ciki matye atir.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Jo ma maro ciki limo kuc madit;</para>
  <para style="q1" vid="PSA 119:165">pe tye gin mo mamiyo giyoke atata.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />Ai Rwot, ageno lari,</para>
  <para style="q1" vid="PSA 119:166">dok bene atiyo gin ma ciki mito.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Agwoko lok me ciki ducu i cwinya,</para>
  <para style="q1" vid="PSA 119:167">dok amarogi ma pe twere.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Agwoko ciki ki lok ma ipwonya kwede ducu;</para>
  <para style="q1" vid="PSA 119:168">gin ducu ma atiyo tye kamaleng inyimi.<verse eid="PSA 119:168" /></para>
  <para style="s1">Lega pi kony</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />Wek kokona oo boti do, Ai Rwot;</para>
  <para style="q1" vid="PSA 119:169">miya abed ki niang maber ma lubu kit ma iciko.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Wek lega me bako doga bene oo boti;</para>
  <para style="q1" vid="PSA 119:170">lara kit macalo yam icike kwede.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Abingamo doga kun apaki,</para>
  <para style="q1" vid="PSA 119:171">pien in ipwonya ki ciki.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Abiwero awera ki leba lok me ciki,</para>
  <para style="q1" vid="PSA 119:172">pien ciki ducu tye atir.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Yube kun iketo cingi me konya,</para>
  <para style="q1" vid="PSA 119:173">pien dong ayero me lubu ciki.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />Cwinya mito mada me neno lari, Ai Rwot,</para>
  <para style="q1" vid="PSA 119:174">dok ciki aye miya yomcwiny.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Miya abed kwo, wek abed ka paki,</para>
  <para style="q1" vid="PSA 119:175">wek pwony me ciki bene okonya.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Angak woko ata calo romo murwenyo;</para>
  <para style="q1" vid="PSA 119:176">myero iyenya, an latici,</para>
  <para style="q1" vid="PSA 119:176">pien wiya pe owil ikom ciki.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s1">Lega pi lar</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Ikare ma atye i can, akok bot Rwot,</para>
  <para style="q1" vid="PSA 120:1">kun, akok ni,<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />“Lara do, Ai Rwot,</para>
  <para style="q1" vid="PSA 120:2">ki bot jo ma doggi loko lok goba,</para>
  <para style="q1" vid="PSA 120:2">ki bot jo ma lebgi bwolo dano.”<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Kibimiyowu gin ango kono?</para>
  <para style="q1" vid="PSA 120:3">Dok gin ango makato ma kibitiyo ikomwu,</para>
  <para style="q1" vid="PSA 120:3">wun jo ma lebwu bwolo danoni?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Kibicwalo atero mabit pa lulweny ikomwu,</para>
  <para style="q1" vid="PSA 120:4">ki lodi mac yen opok ma otwak!<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Aneno can adada, pien bedo ikinwu rac calo bedo i Mecek,</para>
  <para style="q1" vid="PSA 120:5">onyo macalo bedo i kema pa jo Kedar!<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Abedo dong arii pi kare malac tutwal</para>
  <para style="q1" vid="PSA 120:6">ikin jo ma dag kuc.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Amito ni wabed ki kuc; ento tek aloko lok mo me kuc,</para>
  <para style="q1" vid="PSA 120:7">gin gimito cako lweny!<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s1">Rwot aye ma gwokowa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Atingo wanga malo ikom godi;</para>
  <para style="q1" vid="PSA 121:1">kony ma amitoni a ki kwene?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Kony ma amitoni a ki bot Rwot,</para>
  <para style="q1" vid="PSA 121:2">ma ocweyo polo ki lobo.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />En pe biweko tyeni cer,</para>
  <para style="q1" vid="PSA 121:3">ngat ma gwoki pe bibutu nino woko ata.<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Nen, ngat ma gwoko jo Icrael,</para>
  <para style="q1" vid="PSA 121:4">pe binuru woko nyo bene pe binino ma kwiya kome.<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />Rwot aye ngat ma gwoki;</para>
  <para style="q1" vid="PSA 121:5">dok tye calo tipu me ka yweyoni, en tye cok kwedi pi gwoki.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Ceng pe biwangi i dyeceng,</para>
  <para style="q1" vid="PSA 121:6">kadi dwe bene pe bikeli arem mo i dyewor.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />Rwot bigwoki ki i gin maracu woko ducu,</para>
  <para style="q1" vid="PSA 121:7">en bigwoko kwoni.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />Rwot bigwoki ka icito woko nyo kadi ka idwogo cen,</para>
  <para style="q1" vid="PSA 121:8">nia tin nio inino ma pe tum.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s1">Wer me pak pi Jerucalem</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Abedo ki yomcwiny ikare ma kiwaca ni,</para>
  <para style="q1" vid="PSA 122:1">“Wacitu i Ot pa Rwot!”<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Kombedi dong tyenwa ocung i dog taun madit meri in Jerucalem!<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Jerucalem dong kigero odoco matek,</para>
  <para style="q1" vid="PSA 122:3">dok ogure kacel ma nen maber atika!<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Man aye kama kaka gicito iye</para>
  <para style="q1" vid="PSA 122:4">kaka pa Rwot;</para>
  <para style="q1" vid="PSA 122:4">kit macalo yam kiciko kwede pirgi,</para>
  <para style="q1" vid="PSA 122:4">wek gumi pwoc bot Rwot.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Komker me ngolo kop kiketo tye kunu,</para>
  <para style="q1" vid="PSA 122:5">gin komker me ot pa Daudi.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Wuleg pi kuc me Jerucalem:</para>
  <para style="q1" vid="PSA 122:6">“Wek jo ma mari gubed ki lonyo dok ki kwo maber.<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Kuc obed i i cel ma orumi,</para>
  <para style="q1" vid="PSA 122:7">dok kuc madwong myero obed i lubeleni ma wigi ocudu maloni!”<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Pi utmega ki pi luwota</para>
  <para style="q1" vid="PSA 122:8">abiwaco ni, “Kuc obed ii in Jerucalem!”<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Pi Ot pa Rwot Lubangawa matye ii kanyi,</para>
  <para style="q1" vid="PSA 122:9">abilego ni in Jerucalem ibed maber.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s1">Lega pi kica</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Ai Rwot, ailo wanga aneno boti,</para>
  <para style="q1" vid="PSA 123:1">in ma ibedo iwi komkeri i polo!<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Macalo wang lutic</para>
  <para style="q1" vid="PSA 123:2">gineno bot rwotgi,</para>
  <para style="q1" vid="PSA 123:2">macalo wang angeca</para>
  <para style="q1" vid="PSA 123:2">neno bot mego ma en bedo bote,</para>
  <para style="q1" vid="PSA 123:2">ci wan bene waneno boti in Rwot Lubangawa,</para>
  <para style="q1" vid="PSA 123:2">nio wang ma kica omake ikomwa.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Kica omaki ikomwa, Ai Rwot,</para>
  <para style="q1" vid="PSA 123:3">kica omaki ikomwa do,</para>
  <para style="q1" vid="PSA 123:3">pien dong kicayowa tutwal!<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Dong waol woko ki cac pa lulonyo</para>
  <para style="q1" vid="PSA 123:4">wa ki ngala pa jo ma gitye ki kwo mayot.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s1">Lubanga laro jone ki i cing lukworgi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Jo Icrael myero guwac ni,</para>
  <para style="q1" vid="PSA 124:1">“Ka kono Rwot pe obedo tung botwa,<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />ka kono Rwot pe obedo tung botwa,</para>
  <para style="q1" vid="PSA 124:2">ikare ma lukworwa gubino kalweny ikomwa,<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />kono gumwonyowa woko makwo,</para>
  <para style="q1" vid="PSA 124:3">ikare ma kinigagi olyeti woko marac tutwal ikomwa;<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />kono nene lalele omolowa oterowa woko,</para>
  <para style="q1" vid="PSA 124:4">kono biamwonyi me pii oumuwa woko lipuk;<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />kono omiyo pii otwage i wiwa.”<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Kipwo Rwot,</para>
  <para style="q1" vid="PSA 124:6">ma pe omiyowa botgi</para>
  <para style="q1" vid="PSA 124:6">macalo ringo ma myero gukil woko ki lakgi!<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Wabwot woko calo winyo</para>
  <para style="q1" vid="PSA 124:7">ma obwot ki i owic pa ladwar;</para>
  <para style="q1" vid="PSA 124:7">ma tol owic ocod woko,</para>
  <para style="q1" vid="PSA 124:7">ci wan wabwot!<verse eid="PSA 124:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Kony ducu ma wamito a ki bot Rwot,</para>
  <para style="q1" vid="PSA 124:8">ma ocweyo polo ki lobo.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s1">Rwot aye gwoko jone</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Jo ma geno Rwot, gitye macalo got Cion,</para>
  <para style="q1" vid="PSA 125:1">ma pe kitwero dirone kikobo kamukene,</para>
  <para style="q1" vid="PSA 125:1">ento cung mere kacel matwal.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Kit macalo godi orumu Jerucalem woko dyereni,</para>
  <para style="q1" vid="PSA 125:2">Rwot bene orumu jone woko kitmeno,</para>
  <para style="q1" vid="PSA 125:2">nia ikare man cito kwede anyim nakanaka.<verse eid="PSA 125:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Jo ma kitgi racu kadi gumak odo ker me loc</para>
  <para style="q1" vid="PSA 125:3">ci pe gibiloyo lobo ma kimiyo bot jo ma kitgi atir,</para>
  <para style="q1" vid="PSA 125:3">wek jo ma kitgi atir pe gurye cinggi me timo gin marac.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Tim ber bot jo ma kitgi beco, Ai Rwot,</para>
  <para style="q1" vid="PSA 125:4">ki bot jo ma cwinygi tye atir.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Ento jo ma loke gilubu yogi mugom</para>
  <para style="q1" vid="PSA 125:5">Rwot biterogi ribogi ki lutim maracu!</para>
  <para style="q1" vid="PSA 125:5">Kuc obed ikom Icrael!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s1">Lega pi lar</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Ikare ma Rwot odwokowa cen i Cion,</para>
  <para style="q1" vid="PSA 126:1">onongo wabedo macalo jo ma leko lek!<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Omiyo wabedo ki twon yomcwiny madit atika,</para>
  <para style="q1" vid="PSA 126:2">dok wadange bene matek ki nyero;</para>
  <para style="q1" vid="PSA 126:2">ci lurok guwaco lok ikomwa ni,</para>
  <para style="q1" vid="PSA 126:2">“Rwot dong otyeko tiyo jami me aura pirgi.”<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Rwot dong otiyo jami me aura pirwa,</para>
  <para style="q1" vid="PSA 126:3">omiyo cwinywa yom.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />Ai Rwot, dwok gum botwa do,</para>
  <para style="q1" vid="PSA 126:4">macalo icwalo pii pongo kulu matye i Negeb ma gudwon woko ni!<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Wek jo ma gucoyo kodigi kun gikok</para>
  <para style="q1" vid="PSA 126:5">gukaa camgi kun gidange ki yomcwiny madwong!<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Ngat ma woto kun kok,</para>
  <para style="q1" vid="PSA 126:6">ma nongo omako kodi cito ka coyone,</para>
  <para style="q1" vid="PSA 126:6">bidwogo i pacone ma dange adanga ki yomcwiny,</para>
  <para style="q1" vid="PSA 126:6">kun kelo kal ma okayo ki i poto.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s1">Wer me pako ber pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Ka pe Rwot aye ma ogero ot,</para>
  <para style="q1" vid="PSA 127:1">jo ma gero gicane nono.</para>
  <para style="q1" vid="PSA 127:1">Ka pe Rwot aye ma okuru taun madit,</para>
  <para style="q1" vid="PSA 127:1">lakurpiny bedo kakuru piny nono.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Kadi ka wupuk con katic,</para>
  <para style="q1" vid="PSA 127:2">ma wudok paco kayweyo wa mot,</para>
  <para style="q1" vid="PSA 127:2">kun wucamo kwon wuparo kwede pi tic ma wutiyo,</para>
  <para style="q1" vid="PSA 127:2">meno ducu nongo pe konyowu;</para>
  <para style="q1" vid="PSA 127:2">pien Rwot miyo jami bot jo ma en maro, kadi ka gunino.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Nen, lutino aye mot ma oa ki bot Rwot,</para>
  <para style="q1" vid="PSA 127:3">gin aye mot ma kinywalogi anywala.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Lutino ma dano mo onywalo ma pud en tidi,</para>
  <para style="q1" vid="PSA 127:4">gitye calo atero matye i cing ngat ma lalweny.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Ngat ma ajurune opong ki lwak atero ma kitmeno</para>
  <para style="q1" vid="PSA 127:5">bedo ki yomcwiny!</para>
  <para style="q1" vid="PSA 127:5">Pe kiloye wa ki acel</para>
  <para style="q1" vid="PSA 127:5">ikare ma en bilok ki lukwore ki i dog cel.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s1">Gum ma Rwot miyo bot ngat ma lawiny</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Tye ki gum dano ma winyo dog Rwot,</para>
  <para style="q1" vid="PSA 128:1">ma bedo kun lubu yone!<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Ibicamo cam ma oa ki i tic ma itiyo ki cingi;</para>
  <para style="q1" vid="PSA 128:2">ibibedo ki yomcwiny dok ilimo lwak lonyo madwong.<verse eid="PSA 128:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Dakoni bibedo calo olok ma nyako nyige madwong i odi;</para>
  <para style="q1" vid="PSA 128:3">ki lutinoni bene gibibedo calo yat ma pote lot</para>
  <para style="q1" vid="PSA 128:3">kun gibedo girumu mejani woko.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Nen, meno aye kit gum ma poto ikom dano</para>
  <para style="q1" vid="PSA 128:4">ma lworo Rwot.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Rwot myero omini gum ki i Cion.</para>
  <para style="q1" vid="PSA 128:5">Wek inen lonyo matye i Jerucalem,</para>
  <para style="q1" vid="PSA 128:5">pi kare me kwoni ducu!<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Wek bene inen likwayu!</para>
  <para style="q1" vid="PSA 128:6">Kuc obed ikom Icrael!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s1">Lega ikom lukwor pa jo Icrael</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />Jo Icrael myero guwac ni,</para>
  <para style="q1" vid="PSA 129:1">“Kiketo can ikoma marac</para>
  <para style="q1" vid="PSA 129:1">tutwal nia wa ka tinona.<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />Lukwora guketo can ikoma marac tutwal nia wa ka tinona,</para>
  <para style="q1" vid="PSA 129:2">ento pe guloya kadi ki acel.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Gin guketo ret matut i dye ngeya;</para>
  <para style="q1" vid="PSA 129:3">macalo wegi kweri dyang ma gipuru potigi kun gigoro tyeng maboco iye.”<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Ento Rwot opore,</para>
  <para style="q1" vid="PSA 129:4">en dong ogonya woko ki i opii.<verse eid="PSA 129:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Wek dano ducu ma dag Cion</para>
  <para style="q1" vid="PSA 129:5">kiket lewic i wigi, dok kilogi kiryemgi, kidwokgi bene cen!<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Wek gubed macalo lum ma otwi iwi ot,</para>
  <para style="q1" vid="PSA 129:6">ma two woko ma peya odongo ocito malo,<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />pe tye dano mo maromo nyaro pongo cinge,</para>
  <para style="q1" vid="PSA 129:7">kadi ngat ma tweyo kacel bene pe gwaro pong kore.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Pe tye ngat mo makato ki kenyo matwero waco ni,</para>
  <para style="q1" vid="PSA 129:8">“Gum pa Rwot obed ikomwu!</para>
  <para style="q1" vid="PSA 129:8">Walamo gum ikomwu i nying Rwot!”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s1">Lega pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />Ai Rwot, akok boti ki ite bur matut!<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />Rwot, winy kokona do!</para>
  <para style="q1" vid="PSA 130:2">Cik iti iwiny legana me bako dog do!<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Ai Rwot, ka nene onongo imako balwa ducu icwinyi,</para>
  <para style="q1" vid="PSA 130:3">anga mono ma onongo twero bwot?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Ento in iweko balwa,</para>
  <para style="q1" vid="PSA 130:4">wek kilwori.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Akuru kony pa Rwot ki cwinya ducu,</para>
  <para style="q1" vid="PSA 130:5">dok ageno loke bene.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Kwona ducu ocung ikom Rwot;</para>
  <para style="q1" vid="PSA 130:6">akure makato lukurpiny ma gikuru kwar piny,</para>
  <para style="q1" vid="PSA 130:6">dok makato lukurpiny ma gimito ni piny oru.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Wun jo Icrael, myero wugen Rwot!</para>
  <para style="q1" vid="PSA 130:7">Rwot tye ki mar ma pe loke,</para>
  <para style="q1" vid="PSA 130:7">dok lar madwong bene tye bote.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 1:21">Mat 1:21</ref>; <ref loc="TIT 2:14">Tit 2:14</ref></char>
    </note>En bikoko jo Icrael ki i balgi ducu.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s1">Lega me mwolo dok ki gen</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Ai Rwot, pe atye ki gin mo i cwinya mamiyo anyate pire,</para>
  <para style="q1" vid="PSA 131:1">dok bene pe akete kena i rwom ma lamal.</para>
  <para style="q1" vid="PSA 131:1">An pe acore ikom lok madito ata</para>
  <para style="q1" vid="PSA 131:1">ma gidito dok me aura makato ngeca woko.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Ento dong akweyo cwinya woko, aywe dong gira mot,</para>
  <para style="q1" vid="PSA 131:2">calo latin matye i kor mine ma oling mot;</para>
  <para style="q1" vid="PSA 131:2">cwinya dong okwe calo latin ma dong ki gengo woko ki i cak.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Wun jo Icrael, wugen Rwot!</para>
  <para style="q1" vid="PSA 131:3">Nia ikare man cito kwede anyim nakanaka!<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s1">Wer me pak pi Ot pa Lubanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Ai Rwot, po pi Daudi,</para>
  <para style="q1" vid="PSA 132:1">ki pi can ducu bene mayam en ociro.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Po kit mayam en okwongo kwede kwong bot Rwot,</para>
  <para style="q1" vid="PSA 132:2">ma okwongo bot en ngat Matek pa Yakobo ni,<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />“Pe abidonyo i oda,</para>
  <para style="q1" vid="PSA 132:3">nyo kadi me ito iwi kitandana;<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />nino bene pe bimako wanga,</para>
  <para style="q1" vid="PSA 132:4">dok pe abinuru,<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />nio ka anongo kabedo pi Rwot,</para>
  <para style="q1" vid="PSA 132:5">kabedo ma en ngat Matek pa Yakobo twero bedo iye.”<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:6: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 6:41-42">2 Tek 6:41-42</ref>
      </char>
    </note>Nen, ikare ma watye i Eprata wawinyo pi Canduk me Gicike,</para>
  <para style="q1" vid="PSA 132:6">ci wanongo tye i poti me Jaar.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />Ci wawaco ni, “Wucitu kama en bedo iye,</para>
  <para style="q1" vid="PSA 132:7">wek wawore inyim komkere!”<verse eid="PSA 132:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />Ai Rwot, a icit i kabedoni me yweyo,</para>
  <para style="q1" vid="PSA 132:8">kacel ki Canduk me tweroni.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Wek ajwakini guruke ki kit ma atir,</para>
  <para style="q1" vid="PSA 132:9">wek joni ma gigeni gudange ki yomcwiny.<verse eid="PSA 132:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />In yam icike bot latici Daudi;</para>
  <para style="q1" vid="PSA 132:10">pe myero ikwer rwot ma in aye yam iyero ka i wiro, ai Rwot.<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:11: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:12-16">2 Cam 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Tek 17:11-14</ref>; <ref loc="PSA 8:3-4">Jab 8:3-4</ref>; <ref loc="ACT 2:30">Tic 2:30</ref></char>
    </note>Rwot okwongo kwong me ada bot Daudi,</para>
  <para style="q1" vid="PSA 132:11">kwong ma en pe dok bilokone.</para>
  <para style="q1" vid="PSA 132:11">En owaco ni, “Abiketo latin awobi acel ki ikin awobeni bedo rwot,</para>
  <para style="q1" vid="PSA 132:11">en bibedo kaloc lacen ki i ngeyi.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Ka likwayu ducu gibigwoko gicikena ki ada</para>
  <para style="q1" vid="PSA 132:12">ki lok me caden ma apwonyogi kwede,</para>
  <para style="q1" vid="PSA 132:12">ci abiketo lutinogi bene bedo iwi komkeri,</para>
  <para style="q1" vid="PSA 132:12">gibibedo kaloc nakanaka.”<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Pien Rwot dong oyero Cion;</para>
  <para style="q1" vid="PSA 132:13">en mito ni obed pacone kama en bibedo iye.<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />En owaco ni, “Man aye kabedo me yweyona ma abibedo iye matwal;</para>
  <para style="q1" vid="PSA 132:14">abibedo kany, pien dong amito.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Abimiyo gum ikom Cion ci binongo gin ducu ma en mito;</para>
  <para style="q1" vid="PSA 132:15">dok abimiyo lucan ducu ma bedo iye giyeng ki cam.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Abimiyo ajwakine gibiruku lar,</para>
  <para style="q1" vid="PSA 132:16">ki jone ma geno Rwot gibidange ki yomcwiny.<verse eid="PSA 132:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:17: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 11:36">1 Luk 11:36</ref>
      </char>
    </note>Abiyero ngat mo acel ki ikom likwayo pa Daudi me bedo rwot;</para>
  <para style="q1" vid="PSA 132:17">dong atyeko yubu danona ma kiwiro me bedo macalo mac tara ma pe to.<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Abimiyo lewic umu lukwore woko limuk,</para>
  <para style="q1" vid="PSA 132:18">ento kere bidoko dit dok bibedo maber.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s1">Wer me pak pi kwo kacel ki kuc</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Nen kit ma bedo ber ki me yomcwiny,</para>
  <para style="q1" vid="PSA 133:1">ka jo pa Lubanga gibedo kacel ki mer ikin gi!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Rom ki moo ma ngwece kur ma kionyo i wic,</para>
  <para style="q1" vid="PSA 133:2">ma mol bino piny wa i tik dano,</para>
  <para style="q1" vid="PSA 133:2">moo ma con omol ki iwi Aron obino piny wa i tike,</para>
  <para style="q1" vid="PSA 133:2">ma omol bene odyako wa ngut bongone woko liweng!<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Dok rom ki toyo me got Kermon,</para>
  <para style="q1" vid="PSA 133:3">ma luk iwi godi me Cion!</para>
  <para style="q1" vid="PSA 133:3">Kunu en aye kama Rwot ociko</para>
  <para style="q1" vid="PSA 133:3">iye pi miyo gum,</para>
  <para style="q1" vid="PSA 133:3">ki kwo ma bedo matwal.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s1">Lwongo dano me bino kapako Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Wubin, wupak Rwot,</para>
  <para style="q1" vid="PSA 134:1">wun ducu ma lutic pa Rwot,</para>
  <para style="q1" vid="PSA 134:1">ma wucung i Ot pa Rwot dyewor!<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Wuting cingwu malo</para>
  <para style="q1" vid="PSA 134:2">wutang cingwu i kabedo man maleng,</para>
  <para style="q1" vid="PSA 134:2">ci wupwo Rwot!<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Rwot ma ocweyo Polo ki lobo</para>
  <para style="q1" vid="PSA 134:3">omii ki wun gum ki i Cion!<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s1">Wer me pako Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Wupak Rwot!</para>
  <para style="q1" vid="PSA 135:1">Wupak nying Rwot, wun lutice ducu,<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />wun ma wucung i Ot pa Rwot,</para>
  <para style="q1" vid="PSA 135:2">idyekal me Ot pa Lubangawa!<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Wupak Rwot, pien en ber;</para>
  <para style="q1" vid="PSA 135:3">wuwer wer me pako nyinge, pien en lakica.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Rwot oyero Yakobo me bedo mere,</para>
  <para style="q1" vid="PSA 135:4">jo Icrael me bedo lwake kikome.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Angeyo pira kena ni Rwot dit,</para>
  <para style="q1" vid="PSA 135:5">dok angeyo ni Rwotwa loyo lubanga mukene ducu.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />Gin mo keken ma Rwot mito en tiyo,</para>
  <para style="q1" vid="PSA 135:6">i polo ki iwi lobo,</para>
  <para style="q1" vid="PSA 135:6">i nam kadi i pii matut matye piny ite lobo.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />En aye mamiyo pol tinge malo ki i agiki me lobo,</para>
  <para style="q1" vid="PSA 135:7">en mamiyo lutkot wil,</para>
  <para style="q1" vid="PSA 135:7">en bene ma cwalo yamo ki i odine me kano jami, ci kodo.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />En aye mayam oneko lutino kayo pa jo Ejipt woko,</para>
  <para style="q1" vid="PSA 135:8">lutino kayo pa dano ki pa lee.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />En otiyo lwak tango ki ginaura mapol i Ejipt,</para>
  <para style="q1" vid="PSA 135:9">kun pwodo Parao ki lutice ducu.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Dok oneko lwak me rok mapol,</para>
  <para style="q1" vid="PSA 135:10">ci oneko luker matego woko liweng;<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Cikon, rwot pa jo Amor,</para>
  <para style="q1" vid="PSA 135:11">Og, rwot me Bacan,</para>
  <para style="q1" vid="PSA 135:11">ki luker ducu matye i Kanaan.<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />En omiyo lobogi woko me bedo gipinygi,</para>
  <para style="q1" vid="PSA 135:12">gipiny pa lwake jo Icrael.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Ai Rwot, nyingi bedo nakanaka,</para>
  <para style="q1" vid="PSA 135:13">dok bene kibipo piri ikare pa yalwak ducu.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Rwot bimiyo jone loyo kop,</para>
  <para style="q1" vid="PSA 135:14">kica bimake ikom lutice.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:4-8">Jab 115:4-8</ref>; <ref loc="REV 9:20">Niy 9:20</ref></char>
    </note> Lurok giworo cal lubanga ma kitiyogi ki ryal ki jabu;</para>
  <para style="q1" vid="PSA 135:15">man obedo tic ma dano gutiyo ki cinggi.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Doggi tye, ento pe giloko,</para>
  <para style="q1" vid="PSA 135:16">wanggi bene tye, ento pe gitwero neno piny.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Itgi tye, ento pe gitwero winyo lok,</para>
  <para style="q1" vid="PSA 135:17">yamo me yweyo bene peke idoggi.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Jo ma gutiyo cal lubanga magi,</para>
  <para style="q1" vid="PSA 135:18">ki jo ducu ma geno cal lubanga magi</para>
  <para style="q1" vid="PSA 135:18">gin bibedo calo cal lubanga magi bene.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Wun jo Icrael, wupak Rwot!</para>
  <para style="q1" vid="PSA 135:19">Wun jo me ot pa Aron wupak Rwot!<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Wun jo me ot pa Levi, wupak Rwot!</para>
  <para style="q1" vid="PSA 135:20">Wun bene ma wulworo Rwot, wupake!<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Kipak Rwot ki i Cion,</para>
  <para style="q1" vid="PSA 135:21">i kabedone i Jerucalem!</para>
  <para style="q1" vid="PSA 135:21">Wupak Rwot!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s1">Wer me miyo pwoc bot Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Tek 16:34</ref>; <ref loc="2CH 5:13">2 Tek 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Eji 3:11</ref>; <ref loc="PSA 100:5">Jab 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="JER 33:11">Jer 33:11</ref></char>
    </note>Wumii pwoc bot Rwot, pien en ber;</para>
  <para style="q1" vid="PSA 136:1">mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Wumii pwoc bot Lubanga maloyo lwak lubangagu ducu,</para>
  <para style="q1" vid="PSA 136:2">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Wumii pwoc bot Rwot maloyo rwodi ducu,</para>
  <para style="q1" vid="PSA 136:3">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />En keken aye ma tiyo ginaura madito,</para>
  <para style="q1" vid="PSA 136:4">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:5: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1">Aca 1:1</ref>
      </char>
    </note>En ocweyo polo ki ryekone,</para>
  <para style="q1" vid="PSA 136:5">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:2">Aca 1:2</ref>
      </char>
    </note>En bene ma opeto lobo iwi pii matut,</para>
  <para style="q1" vid="PSA 136:6">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:16">Aca 1:16</ref>
      </char>
    </note>En ma ocweyo ceng ki dwe,</para>
  <para style="q1" vid="PSA 136:7">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />En ocweyo ceng me loyo dyeceng,</para>
  <para style="q1" vid="PSA 136:8">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />En ocweyo dwe ki lakalatwe me loyo dyewor,</para>
  <para style="q1" vid="PSA 136:9">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:10: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Nia 12:29</ref>
      </char>
    </note>En oneko lutino kayo pa jo Ejipt ma co woko ducu,</para>
  <para style="q1" vid="PSA 136:10">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:11: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:15">Nia 1:15</ref>
      </char>
    </note>Ci okwanyo jo Icrael okelogi woko ki ikin jo Ejipt,</para>
  <para style="q1" vid="PSA 136:11">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />En okelogi woko pi twero me bade ki cinge ma oryeyo,</para>
  <para style="q1" vid="PSA 136:12">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-29">Nia 14:21-29</ref>
      </char>
    </note>En opoko i Nam Makwar woko ki idyere,</para>
  <para style="q1" vid="PSA 136:13">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />En omiyo jo Icrael gukato ki idyere wa loka tungcel,</para>
  <para style="q1" vid="PSA 136:14">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Ento omiyo Parao kacel ki mony ma mere gumwony guto woko i Nam Makwar,</para>
  <para style="q1" vid="PSA 136:15">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />En ma otelo lwake i dye tim,</para>
  <para style="q1" vid="PSA 136:16">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />En oneko luker madito woko ducu,</para>
  <para style="q1" vid="PSA 136:17">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />En oneko luker ma guywek;</para>
  <para style="q1" vid="PSA 136:18">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:19: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:21-30">Wel 21:21-30</ref>
      </char>
    </note>En oneko Cikon, ma rwot pa jo Amor,</para>
  <para style="q1" vid="PSA 136:19">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />En oneko bene Og, rwot me Bacan,</para>
  <para style="q1" vid="PSA 136:20">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />En omiyo lobogi woko bot lwake me bedo gipinygi,</para>
  <para style="q1" vid="PSA 136:21">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />En omiyo lobogi bot lutice jo Icrael wek obed ginaleyagi,</para>
  <para style="q1" vid="PSA 136:22">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />En opo pirwa ikare ma dong kiloyowa woko marac,</para>
  <para style="q1" vid="PSA 136:23">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />En olarowa ki i cing lumerokwa,</para>
  <para style="q1" vid="PSA 136:24">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />En miyo cam bot gin makwo ducu,</para>
  <para style="q1" vid="PSA 136:25">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Wumii pwoc bot Lubanga me polo,</para>
  <para style="q1" vid="PSA 136:26">pien mar mere ma pe loke bedo nakanaka.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s1">Koko pa jo Icrael ikare me opii i Babilon</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Wabedo piny inget kulu me Babilon,</para>
  <para style="q1" vid="PSA 137:1">ci wakok matek ikare ma wapo pi Cion.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Wangabo opukwa malo</para>
  <para style="q1" vid="PSA 137:2">i kor yadi ma i dog kulu kunu.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Pien jo ma gumakowa ma guterowa i opii guwaco ni myero wawer botgi;</para>
  <para style="q1" vid="PSA 137:3">gin jo ma giunuwa gumito ni wawer wer me yomo cwiny,</para>
  <para style="q1" vid="PSA 137:3">kun giwaco ni, “Wuwer ki wan wer mo ma loko lok ikom Cion!”<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Wan watwero wero wer pa Rwot i lobo pa lurok ningning?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Wek cinga ma lacuc otwo woko,</para>
  <para style="q1" vid="PSA 137:5">kace wiya wil ikomi, in Jerucalem!<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Wek leba omok woko i dana,</para>
  <para style="q1" vid="PSA 137:6">ka pe apo piri,</para>
  <para style="q1" vid="PSA 137:6">ka pe atamo piri, in Jerucalem, macalo gin ma miya yomcwiny makato!<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />Ai Rwot, po pi nino ma Jerucalem oneno can iye,</para>
  <para style="q1" vid="PSA 137:7">ci icul wange ikom jo Edom. Po kit ma gubedo ka waco ni,</para>
  <para style="q1" vid="PSA 137:7">“Ret woko, ret woko piny wa i ngom ite gutine!”<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">137:8: </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:6">Niy 18:6</ref>
      </char>
    </note>Dong wun jo Babilon, kibityekowu woko!</para>
  <para style="q1" vid="PSA 137:8">Ngat ma biculu kworwa ikomi</para>
  <para style="q1" vid="PSA 137:8">pi gin ma itimo ikomwa, bibedo ki yomcwiny.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Gibimako lutinoni,</para>
  <para style="q1" vid="PSA 137:9">ci kijwatogi woko ikom got!<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s1">Lega me pwoc bot Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />Apwoyi ki cwinya ducu, Ai Rwot;</para>
  <para style="q1" vid="PSA 138:1">awero wer me paki inyim lubangagu.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Aryebe piny akemo Ot meri maleng,</para>
  <para style="q1" vid="PSA 138:2">apako nyingi pi mar meri ma pe loke ki pi geneni;</para>
  <para style="q1" vid="PSA 138:2">pien itingo nyingi ki loki ducu malo makato jami mukene ducu.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Inino ma akok boti, in igamo doga,</para>
  <para style="q1" vid="PSA 138:3">ci imedo tekcwiny bota.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Luker ducu ma iwi lobo gibipaki, Ai Rwot,</para>
  <para style="q1" vid="PSA 138:4">pien dong guwinyo loki ma icike kwede.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Gin biwero wer pi gin ma in Rwot itiyo,</para>
  <para style="q1" vid="PSA 138:5">ki pi deyo madit pa Rwot.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Kadi bed Rwot bedo malo kamabor tutwal,</para>
  <para style="q1" vid="PSA 138:6">pud neno jo mamwol ma lucan i cwinygi;</para>
  <para style="q1" vid="PSA 138:6">ento jo ma luwake en ngeyogi woko wa ki kamabor.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Kadi bed awoto ma can oruma woko dyere,</para>
  <para style="q1" vid="PSA 138:7">in pud igwoko kwona;</para>
  <para style="q1" vid="PSA 138:7">iryeyo cingi me juku akemo pa lukwora,</para>
  <para style="q1" vid="PSA 138:7">ci i lara ki cingi ma lacuc.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />Rwot bicobo yub ma mere ducu pira;</para>
  <para style="q1" vid="PSA 138:8">Ai Rwot, mar meri ma pe loke bedo nakanaka.</para>
  <para style="q1" vid="PSA 138:8">Pe ibwot gin ma itiyo ki cingi woko.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s1">Lubanga tye i kabedo ducu dok ngeyo jami ducu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />Ai Rwot, in dong ingiyo kwona ci ingeya woko!<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Kadi abedo piny nyo kadi aa malo, in ingeyo;</para>
  <para style="q1" vid="PSA 139:2">iniang tama woko ki kamabor.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Ingiyo yona ki kama abutu iye piny,</para>
  <para style="q1" vid="PSA 139:3">dok ingeyo kit yo me kwona ducu.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Ma nongo peya aloko lok mo,</para>
  <para style="q1" vid="PSA 139:4">nen, Ai Rwot, nongo in dong ingeyo lok ma abiloko woko ducu.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />In iruma woko tungi ki tungi,</para>
  <para style="q1" vid="PSA 139:5">kun igwoka ma iketo cingi ikoma.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Kit ngec ma itye kwede tye me aura mada ki tung bota;</para>
  <para style="q1" vid="PSA 139:6">tye wa malo tutwal makato ngeca woko.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Abicito kwene wek aa woko ki boti?</para>
  <para style="q1" vid="PSA 139:7">Abia ki inyimi aringo acito kwene?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Kadi ka ait malo i polo,</para>
  <para style="q1" vid="PSA 139:8">in bene itye kunu.</para>
  <para style="q1" vid="PSA 139:8">Kadi ka abutu piny i lyel,</para>
  <para style="q1" vid="PSA 139:8">in pud itye kunu aye!<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Ka atuk acito malo ma awoto macalo rupiny,</para>
  <para style="q1" vid="PSA 139:9">nyo abed i kabedo mo i dog nam matye kamabor adada,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />in pud i bibedo kunu ka peyo an,</para>
  <para style="q1" vid="PSA 139:10">dok bene ibimaka ki cingi me twer.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Ka awaco ni, “Wek colpiny ouma woko,</para>
  <para style="q1" vid="PSA 139:11">onyo dero me ceng ma oruma odok dyewor,”<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />ento colpiny bene pe col ki boti,</para>
  <para style="q1" vid="PSA 139:12">ki dyewor bene leng alenga calo dyeceng;</para>
  <para style="q1" vid="PSA 139:12">pien ki tung boti colpiny rom ki dyeceng.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />In aye ma iketo dul me koma ducu,</para>
  <para style="q1" vid="PSA 139:13">dok icweyo woko kacel ki i i maa.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Abipaki, pien in aye ma myero kilwori dok itye me aura.</para>
  <para style="q1" vid="PSA 139:14">Tici ducu ma itiyo obedo tic me aura! An angeyo man maber tutwal.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Yam ineno ka kiribo cogo koma ikare ma kicweya i maa,</para>
  <para style="q1" vid="PSA 139:15">ma kicweyo koma piny ite lobo kamatut ki diro madwong.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />In i neno koma ki wangi ma pud peya kicweyo otum,</para>
  <para style="q1" vid="PSA 139:16">wel ninona ma iciko pira ducu kicoyogi woko i buki</para>
  <para style="q1" vid="PSA 139:16">ma peya nino mo acel ikin gi oo.<verse eid="PSA 139:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Ai Lubanga, niang tami ikoma tek ki tung bota tutwal!</para>
  <para style="q1" vid="PSA 139:17">Gin ducu mono gitye adi!<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Ka awaco ni akwan welgi akwana,</para>
  <para style="q1" vid="PSA 139:18">gipol ma gikato kweyo woko.</para>
  <para style="q1" vid="PSA 139:18">Ka acoo ki iwang nino, nongo pud atye boti.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Ai Lubanga, onongo amito ni inek jo maracu woko,</para>
  <para style="q1" vid="PSA 139:19">wek jo ma oyo remo pa dano gurweny woko ki bota,<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />gin jo ma gibedo kaloko lok marac i komini,</para>
  <para style="q1" vid="PSA 139:20">ma guile malo kun giloko lok marac ikomi.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />Ai Rwot, an adag jo ma gin dagi,</para>
  <para style="q1" vid="PSA 139:21">dok bene iya okwero jo ma gijemo woko ikomi.<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Adaggi adada ki adagadaga ma otum,</para>
  <para style="q1" vid="PSA 139:22">anenogi macalo lukwora.<verse eid="PSA 139:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Ngi kwona, Ai Lubanga, wek inge gin matye i cwinya;</para>
  <para style="q1" vid="PSA 139:23">kong itema, wek inge kama tama tye iye.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Inen ka kit mo marac tye i iya,</para>
  <para style="q1" vid="PSA 139:24">ci dong itela i yoni ma bedo nakanaka.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s1">Lega pi gwoke ki ikom jo maracu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Ai Rwot; lara ki bot jo maracu,</para>
  <para style="q1" vid="PSA 140:1">gwoka bene ki ikom jo ma gin lutim bwami,<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />ma giyubu lok maracu ki i cwinygi,</para>
  <para style="q1" vid="PSA 140:2">ci gitugu lweny teretere.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:3: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Rom 3:13</ref>
      </char>
    </note>Lebgi bit calo lak twol madongo,</para>
  <para style="q1" vid="PSA 140:3">lok ma giloko obedo calo kwir pa twol ororo.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />Ai Rwot, gwoka ki i cing jo maracu;</para>
  <para style="q1" vid="PSA 140:4">gwoka ki ikom jo ma gin lutim bwami,</para>
  <para style="q1" vid="PSA 140:4">ma dong gupiro lok me dwalo tyena wek apoti.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Jo ma nyate guciko owicgi gukano woko pira,</para>
  <para style="q1" vid="PSA 140:5">guciko obwo ki tol kun gimito maka kwede;</para>
  <para style="q1" vid="PSA 140:5">inget yoo ducu nongo guciko obwo tye kakura akura.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Awaco bot Rwot ni, “In Lubangana.</para>
  <para style="q1" vid="PSA 140:6">Winy legana me bako dog, Ai Rwot!”<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />Ai Rwot Lubangana, lalara matek,</para>
  <para style="q1" vid="PSA 140:7">igwoka maber ikare me lweny.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />Ai Rwot, pe imii bot jo maracu gin ma gimito;</para>
  <para style="q1" vid="PSA 140:8">dok pe iwek tim maracu ma gupironi ocobe.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Pe iwek lukwora guloya woko,</para>
  <para style="q1" vid="PSA 140:9">wek tim aranyi ma gimito timone odok ikomgi.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Wek lodi mac ocore ikomgi owanggi woko;</para>
  <para style="q1" vid="PSA 140:10">wek kibolgi i bur matut, pe dok gunong yoo me kati woko!<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Wek jo ma giloko lok gobagoba me balo nying luwotgi pe gubed i lobo;</para>
  <para style="q1" vid="PSA 140:11">wek gin marac omak gin lutim bwami ci ityekgi woko.<verse eid="PSA 140:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Angeyo ni Rwot konyo jo ma lucan,</para>
  <para style="q1" vid="PSA 140:12">dok ngolo kop kakare pi jo ma piny obwoyogi.<verse eid="PSA 140:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Adada jo ma kitgi atir bimiyo pwoc boti;</para>
  <para style="q1" vid="PSA 140:13">ki jo ma cwinygi atir gibibedo inyimi.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s1">Lega pi gwok ikom gin marac</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />Ai Rwot, akok boti, bin bota oyotoyot do!</para>
  <para style="q1" vid="PSA 141:1">Winy dwona ka akok boti!<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:2: </char>
      <char style="xt" closed="false">
        <ref loc="REV 5:8">Niy 5:8</ref>
      </char>
    </note>Wek legana obed inyimi macalo odok eceta ma kiwango;</para>
  <para style="q1" vid="PSA 141:2">ki cinga ma atango botini myero obed calo gitum ma kityero boti i otyeno.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Ai Rwot, konya i gwok doga,</para>
  <para style="q1" vid="PSA 141:3">wek pe angam doga kaloko gin ma pe opore.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Gwoka wek pe abed ki cwiny me timo gin mo marac,</para>
  <para style="q1" vid="PSA 141:4">wek pe aribe ki jo maracu pi timo bal,</para>
  <para style="q1" vid="PSA 141:4">wek bene pe aribe kwedgi kacamo cam mamit ma gin yubu!<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Wek dano ma kite ber aye opwoda,</para>
  <para style="q1" vid="PSA 141:5">dano ma gene aye ojuka,</para>
  <para style="q1" vid="PSA 141:5">ento pe iwek dano mo marac owir wiya ki moo;</para>
  <para style="q1" vid="PSA 141:5">pien legana ma atye ka legi kwede teretereni</para>
  <para style="q1" vid="PSA 141:5">tye pi dago gin marac ma gin gitimo.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Ka inen lutelagi kibologi woko piny ki iwi got,</para>
  <para style="q1" vid="PSA 141:6">ci dano gibiye ni lok pa Rwot kara tye ada.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Macalo got ma kityero kinginyo iwi lobo,</para>
  <para style="q1" vid="PSA 141:7">kitmeno cogogi bene kibiketo woko atata ma pe kiyikogi.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Ento an, Ai Rwot, wanga kemo boti;</para>
  <para style="q1" vid="PSA 141:8">ayenyo kalare boti, pe iweka ata ma pe igwoka!<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Gwoka wek pe amok i owic ma guciko pirani,</para>
  <para style="q1" vid="PSA 141:9">gwoka pe amok i obwo pa lutim maracu.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Wek jo maracu gumok i obwogi keken gi,</para>
  <para style="q1" vid="PSA 141:10">ento mi an abwot ma pe gin mo oguda.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s1">Lega pi kony ki i can</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Akok bot Rwot pi kony,</para>
  <para style="q1" vid="PSA 142:1">kun abako doga bene bote.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Akelo lok me kokona ducu inyime,</para>
  <para style="q1" vid="PSA 142:2">dok atite bene kit can ducu ma atye ka nongone.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Ka cwinya dong oari woko,</para>
  <para style="q1" vid="PSA 142:3">in ingeyo gin ma myero atim.</para>
  <para style="b" vid="PSA 142:3" />
  <para style="q1" vid="PSA 142:3">I yoo ma awoto ki iye kare ducu,</para>
  <para style="q1" vid="PSA 142:3">lukwora guciko owic woko pira.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Ka aloko wanga tung acuc,</para>
  <para style="q1" vid="PSA 142:4">ci anongo ni pe tye dano mo ma myero okonya;</para>
  <para style="q1" vid="PSA 142:4">kalare mo mudong pira bene peke,</para>
  <para style="q1" vid="PSA 142:4">pe tye ngat mo ma paro pira.<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Ai Rwot, akok boti pi kony;</para>
  <para style="q1" vid="PSA 142:5">Rwot, in aye kalarena,</para>
  <para style="q1" vid="PSA 142:5">in aye dul ma kipoka i lobo pa jo makwo.<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Winy kokona do,</para>
  <para style="q1" vid="PSA 142:6">pien piny dong obwoya woko!</para>
  <para style="b" vid="PSA 142:6" />
  <para style="q1" vid="PSA 142:6">Lara ki i cing jo ma gitye ka liba,</para>
  <para style="q1" vid="PSA 142:6">pien gitek giloya woko.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Gonya woko ki i buc,</para>
  <para style="q1" vid="PSA 142:7">wek amii pwoc boti.</para>
  <para style="q1" vid="PSA 142:7">Jo ma kitgi atir gibiruma dyere,</para>
  <para style="q1" vid="PSA 142:7">pien dong itiyo kweda i yo maber atika.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s1">Lega pi kony</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />Ai Rwot, winy legana;</para>
  <para style="q1" vid="PSA 143:1">winy legana me bako dog ma akelo inyimi!</para>
  <para style="q1" vid="PSA 143:1">Gam doga pien in ipore!<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:2: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:20">Rom 3:20</ref>; <ref loc="GAL 2:16">Gal 2:16</ref></char>
    </note>Pe ingol kop ikom latici,</para>
  <para style="q1" vid="PSA 143:2">pien pe tye dano mo makwo ma kite atir inyimi.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Lakwora oryemo kora,</para>
  <para style="q1" vid="PSA 143:3">ci oloya woko adada,</para>
  <para style="q1" vid="PSA 143:3">omiyo abedo i colpiny calo jo mayam dong guto wacon.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Pimeno cwinya dong ool woko,</para>
  <para style="q1" vid="PSA 143:4">gen bene dong orwenyo woko ki cwinya bene oari woko.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Apo ikom kare macon ma dong okato,</para>
  <para style="q1" vid="PSA 143:5">ci abedo kalwodo lok ikom gin ducu ma dong itiyo;</para>
  <para style="q1" vid="PSA 143:5">gin ducu ma itiyo bino i tama.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Aryeyo cinga atango boti ka alego,</para>
  <para style="q1" vid="PSA 143:6">cwinya mito neni calo lobo ma otwo woko ma mito pii.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />Ai Rwot, gam doga oyotoyot!</para>
  <para style="q1" vid="PSA 143:7">Cwinya mito ari woko!</para>
  <para style="q1" vid="PSA 143:7">Pe ikane woko ki bota,</para>
  <para style="q1" vid="PSA 143:7">miyo abedo rom ki jo ma gicito gidonyo piny i bur lyel.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Ageno in mada;</para>
  <para style="q1" vid="PSA 143:8">wek awinyi i odiko kun ipoyo wiya ikom mar meri ma pe loke.</para>
  <para style="q1" vid="PSA 143:8">Pwonya ki yo ma imito ni myero alubi,</para>
  <para style="q1" vid="PSA 143:8">pien legana ducu acwalo malo boti kunu.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Ai Rwot, lara ki i cing lukwora!</para>
  <para style="q1" vid="PSA 143:9">An dong aringo kalare boti.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Pwonya wek atii gin ma imito, pien in Lubangana.</para>
  <para style="q1" vid="PSA 143:10">Wek Cwiny meri maberi otela i yo ma opire maromrom!<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Lara, Ai Rwot, pi deyo me nyingi;</para>
  <para style="q1" vid="PSA 143:11">dok ikwanya woko ki i can pi poreni!<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Pi mar meri ma pe loke pira,</para>
  <para style="q1" vid="PSA 143:12">dong inek lukwora ityekgi woko,</para>
  <para style="q1" vid="PSA 143:12">pien an abedo latici.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s1">Lega pa rwot pi loyo lweny</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Kipwo Rwot ma en aye gota,</para>
  <para style="q1" vid="PSA 144:1">ma opwonyo cinga pi lweny.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />En gota ki cel gogona matek,</para>
  <para style="q1" vid="PSA 144:2">en kakanena ki lalara,</para>
  <para style="q1" vid="PSA 144:2">en gwoka macalo kwot, aringo alaro bote,</para>
  <para style="q1" vid="PSA 144:2">en ma obwoyo rok mapol, omiyo gubedo ite loca.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:3: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:17-18">Yub 7:17-18</ref>; <ref loc="PSA 8:4">Jab 8:4</ref></char>
    </note>Ai Rwot, dano gin ango mamiyo ipo pire?</para>
  <para style="q1" vid="PSA 144:3">Dano adana ma mwani pingo ibedo ka tamo pire?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Dano obedo calo yamo me yweyo keken,</para>
  <para style="q1" vid="PSA 144:4">nino me kwone bene obedo calo tipu yat makato woko oyotoyot.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />Ai Rwot, ywa polo idwok cen, ci ilor ibin piny!</para>
  <para style="q1" vid="PSA 144:5">Gud kom godi ci wek guduny yito!<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Mii lutkot owil omeny piny wek oket lukwori woko ata,</para>
  <para style="q1" vid="PSA 144:6">celgi ki ateroni ci wek guket woko ki ngwec ata.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Rye cingi piny ki i polo,</para>
  <para style="q1" vid="PSA 144:7">ywaya ci ikwanya woko ki i pii matut,</para>
  <para style="q1" vid="PSA 144:7">lara ki i cing lurok,<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />ma gibedo kaloko lok goba keken.</para>
  <para style="q1" vid="PSA 144:8">Kadi bed gutingo cinggi me kwongo kwong,</para>
  <para style="q1" vid="PSA 144:8">ento pud inongo ni giloko lok goba.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Abiwero wer manyen boti, Ai Rwot;</para>
  <para style="q1" vid="PSA 144:9">abigoyo nanga ma kiciko ki tol puc apar kun apaki kwede.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />In aye ma imiyo loc bot luker,</para>
  <para style="q1" vid="PSA 144:10">dok ilaro latici Daudi.<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Lara ki i lak pala lucwan mager,</para>
  <para style="q1" vid="PSA 144:11">dok ilara ki i cing lurok</para>
  <para style="q1" vid="PSA 144:11">ma giloko meggi lok goba kekeni;</para>
  <para style="q1" vid="PSA 144:11">kadi bed gutingo cinggi me kwongo kwong,</para>
  <para style="q1" vid="PSA 144:11">ento pud inongo ni giloko lok goba.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Mii lutino awobewa, ikare me bulugi</para>
  <para style="q1" vid="PSA 144:12">gubed calo ginapita ma dong otyeko dongo woko;</para>
  <para style="q1" vid="PSA 144:12">ki anyirawa bene gubed macalo wir me twoke</para>
  <para style="q1" vid="PSA 144:12">ma kitongo me gero gangkal madit.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Mii derowa ducu gupong woko libic</para>
  <para style="q1" vid="PSA 144:13">ki kit wit cam mapatpat.</para>
  <para style="q1" vid="PSA 144:13">Mii romiwa bene gunywal lutinogi alip ki alip</para>
  <para style="q1" vid="PSA 144:13">ki dok alip apar i oletwa.<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />Mii dyangiwa bene ma guduru gunywal lutinogi.</para>
  <para style="q1" vid="PSA 144:14">Pe imii koko me can mo owinye i dye gang kalwa.<verse eid="PSA 144:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Gitye ki yomcwiny jo ma kit gum man bipoto ikomgi!</para>
  <para style="q1" vid="PSA 144:15">Gitye ki gum jo ma Lubangagi aye Rwot!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s1">Wer me Pak</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Abidwori ki wer, in Lubangana ki Rwota,</para>
  <para style="q1" vid="PSA 145:1">dok abipako nyingi nakanaka.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Abipwoyi nino ducu,</para>
  <para style="q1" vid="PSA 145:2">dok abipako nyingi nakanaka.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />Rwot dit, myero kipake tutwal,</para>
  <para style="q1" vid="PSA 145:3">dite pe romo tite, tere bene pe tate.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Lwak me kare ducu gibipako tici bot lutinogi;</para>
  <para style="q1" vid="PSA 145:4">gibitito pi tic matego mayam itiyogi.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Dok abilwodo lok ikom deyo me dit me keri,</para>
  <para style="q1" vid="PSA 145:5">ki ikom tic me aura mayam itiyo.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Dano gibilok ikom tek me tici makelo lworo bot jo ducu,</para>
  <para style="q1" vid="PSA 145:6">ki an bene abitito pi diti.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Kibimiyo pi beri madwong ywek ngene mada ikin dano,</para>
  <para style="q1" vid="PSA 145:7">dok kibiwero wer ki dwon malongo pi poreni.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />Rwot lakica dok maro dano,</para>
  <para style="q1" vid="PSA 145:8">kiniga pe mako oyot, mar mere ma pe loke dwong.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />Rwot ber bot dano ducu,</para>
  <para style="q1" vid="PSA 145:9">dok kica make ikom gin ducu ma en ocweyo.<verse eid="PSA 145:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />Ai Rwot, jami ducu ma in icweyo gibimiyi pwoc,</para>
  <para style="q1" vid="PSA 145:10">ki joni ma genene ducu gibipaki.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Gibiloko ikom deyo me keri,</para>
  <para style="q1" vid="PSA 145:11">dok gibitito pi tweroni bene,<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />wek dano ducu gunge pi tic matego ma in dong itiyo,</para>
  <para style="q1" vid="PSA 145:12">kideyo me dit me keri.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Keri en ker ma rii nakanaka,</para>
  <para style="q1" vid="PSA 145:13">dok loci birii nakanaka ikare pa yalwak ducu.</para>
  <para style="b" vid="PSA 145:13" />
  <para style="q1" vid="PSA 145:13">Rwot lagen iloke ducu ma en ociko,</para>
  <para style="q1" vid="PSA 145:13">dok bene lakica i tice ducu ma en tiyo.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />Rwot kwako dano ma mito poto,</para>
  <para style="q1" vid="PSA 145:14">dok ilo jo ma piny obwoyogi woko ada malo.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Wang ducu neno boti,</para>
  <para style="q1" vid="PSA 145:15">in aye ma imiyogi cam ikare ma mite kikome.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />In iyabo cingi,</para>
  <para style="q1" vid="PSA 145:16">ci imiyo gin makwo ducu giyeng.<verse eid="PSA 145:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />Gin ducu ma Rwot tiyo tye atir,</para>
  <para style="q1" vid="PSA 145:17">gin ma en timo ducu tiyo ki mar.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />Rwot tye cok bot jo ducu ma kok bote,</para>
  <para style="q1" vid="PSA 145:18">ma gikok bote ki ada.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />En miyo jami ducu ma mite bot jo ma lwore,</para>
  <para style="q1" vid="PSA 145:19">dok winyo kokogi, ci larogi bene.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />Rwot gwoko jo ducu ma mare;</para>
  <para style="q1" vid="PSA 145:20">ento jo maracu ducu en binekogi tyekogi woko.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Abipako Rwot kare ducu;</para>
  <para style="q1" vid="PSA 145:21">wek gin makwo ducu matye ki kom gupak nying Rwot nakanaka.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s1">Wer me pako Lubanga ma Lalar</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Wupak Rwot!</para>
  <para style="q1" vid="PSA 146:1">Pak Rwot, in tipuna!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Abipako Rwot pi kare ducu me kwona;</para>
  <para style="q1" vid="PSA 146:2">abiwero wer me pako Lubangana ka pud akwo.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Pe ibed kageno rwodi,</para>
  <para style="q1" vid="PSA 146:3">pe igen dano adana mamwa ma pe romo konyi.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Ka oto dok i ngom ka mayam oa ki iye;</para>
  <para style="q1" vid="PSA 146:4">yube ducu mayam oyubu rwenyo woko liweng inino meno kikome.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Tye ki gum jo ma Lubanga pa Yakobo konyogi;</para>
  <para style="q1" vid="PSA 146:5">ma gen gi ducu tye ikom Rwot Lubangagi,<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:6: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 4:24">Tic 4:24</ref>; <ref loc="ACT 14:15">14:15</ref></char>
    </note>ma ocweyo polo ki lobo, ki nam,</para>
  <para style="q1" vid="PSA 146:6">ki jami ducu matye i igi.</para>
  <para style="q1" vid="PSA 146:6">En gwoko cikene nakanaka;<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />en ngolo kop pa jo ma kiunugi kakare,</para>
  <para style="q1" vid="PSA 146:7">dok miyo cam bot jo ma kec nekogi.</para>
  <para style="b" vid="PSA 146:7" />
  <para style="q1" vid="PSA 146:7">Rwot gonyo lumabuc woko;<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />Rwot yabo wang jo ma wanggi oto.</para>
  <para style="q1" vid="PSA 146:8">Rwot ilo malo, jo ma piny obwoyogi woko ada.</para>
  <para style="q1" vid="PSA 146:8">Rwot maro jo ma kitgi atir.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />Rwot gwoko jo ma gin lubedo i lobo moni,</para>
  <para style="q1" vid="PSA 146:9">en konyo mon to ki lutino kic;</para>
  <para style="q1" vid="PSA 146:9">ento balo yub pa jo maracu woko.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />Rwot bibedo kaloc nakanaka;</para>
  <para style="q1" vid="PSA 146:10">Lubangani, in Cion, bibedo pi kare pa yalwak ducu.</para>
  <para style="q1" vid="PSA 146:10">Wupak Rwot!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s1">Wer me pako Lubanga Matwero ducu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Wupak Rwot!</para>
  <para style="q1" vid="PSA 147:1">Wero wer me pako Lubangawa ber,</para>
  <para style="q1" vid="PSA 147:1">pien en lakica, mumiyo wer me pak myero kwede.<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />Rwot tye ka roco Jerucalem odoco;</para>
  <para style="q1" vid="PSA 147:2">en coko jo Icrael mayam kiterogi i opii kelogi paco.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />En cango jo ma cwinygi cwer,</para>
  <para style="q1" vid="PSA 147:3">dok tweyo wang retgi woko.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />En omoko wel lakalatwe woko ducu,</para>
  <para style="q1" vid="PSA 147:4">dok ocako nyinggi woko ducu liweng.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />Rwotwa dit, dok tek tutwal; tye ki niang matut ma pe pime.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />Rwot tingo jo ma kinyonogi piny, iloogi malo,</para>
  <para style="q1" vid="PSA 147:6">ci reto jo maracu gipoto woko ducu i ngom.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Wuwer wer bot Rwot kun wumiye pwoc;</para>
  <para style="q1" vid="PSA 147:7">wupak Lubangawa ki opuk agoya.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />En umu polo woko ki pol,</para>
  <para style="q1" vid="PSA 147:8">dok miyo kot cwer i lobo;</para>
  <para style="q1" vid="PSA 147:8">en miyo lum dongo wa iwi godigu.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />En miyo cam bot lee tim,</para>
  <para style="q1" vid="PSA 147:9">dok pito lutino agak matye kakoko.<verse eid="PSA 147:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Tek pa aguragura pe miye yomcwiny,</para>
  <para style="q1" vid="PSA 147:10">ki dwiro pa langwec bene pe yomo cwinye;<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />ento Rwot cwinye yom ikom jo ma gilwore,</para>
  <para style="q1" vid="PSA 147:11">ki ikom jo ma geno mar mere ma pe loke.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Pak Rwot, in Jerucalem!</para>
  <para style="q1" vid="PSA 147:12">Pak Lubangani, in Cion!<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />En aye ma gwoko dog gangi cung matek;</para>
  <para style="q1" vid="PSA 147:13">en bene ma miyo gum ikom lutinoni.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />En miyo wang apoki loboni bedo ki kuc,</para>
  <para style="q1" vid="PSA 147:14">dok pitowu ki ngano maber adada ci wuyeng.<verse eid="PSA 147:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />En cwalo cike bot lobo;</para>
  <para style="q1" vid="PSA 147:15">ci kitiyo kwede oyotoyot.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />En cwalo pee mayom calo yer romo;</para>
  <para style="q1" vid="PSA 147:16">dok keto bwoyo pee woko atata calo buru.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />En bolo pee piny calo nginyinginyi cam ma poto i ngom;</para>
  <para style="q1" vid="PSA 147:17">anga matwero cung i ngico ma en miyo?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />En dok cwalo loke, ci lenyo pee woko;</para>
  <para style="q1" vid="PSA 147:18">en miyo yamone kodo, ci pii bene mol.<verse eid="PSA 147:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />En otito loke bot Yakobo;</para>
  <para style="q1" vid="PSA 147:19">cike ki gin ducu ma en ociko en otito bot jo Icrael.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />En pe obedo katic ki rok mo mukene kitmeno;</para>
  <para style="q1" vid="PSA 147:20">pe gingeyo cike ki gin ma en ociko ducu.</para>
  <para style="q1" vid="PSA 147:20">Wupak Rwot!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s1">Kilwongo ginacweya ducu me pako Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Wupak Rwot!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Wupak Rwot ki i polo,</para>
  <para style="q1" vid="PSA 148:1">ki wun jo ma wubedo malo kamabor bene wupake!<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Wun lumalaikane ducu, wupake;</para>
  <para style="q1" vid="PSA 148:2">ki wun dul monye bene wupake!<verse eid="PSA 148:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Wun ceng ki dwe wupake,</para>
  <para style="q1" vid="PSA 148:3">wun lakalatwe maryeny, wupake!<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Wupake, wun polo matye malo tutwal,</para>
  <para style="q1" vid="PSA 148:4">ki wun pii ma wutye malo iwi polo bene wupake!<verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Wek jami ducu gupak nying Rwot!</para>
  <para style="q1" vid="PSA 148:5">Pien en ociko acika keken ci kicweyogi.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />En oketogi i kabedogi kikome wek gubedo iye matwal,</para>
  <para style="q1" vid="PSA 148:6">en oketo cik ma pe kitwero turune.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Wupak Rwot ki i lobo,</para>
  <para style="q1" vid="PSA 148:7">wun min kulu madongo matye i nam,</para>
  <para style="q1" vid="PSA 148:7">kacel ki kut madongo me nam!<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />Wun mac ki pee, toyo ki ngico,</para>
  <para style="q1" vid="PSA 148:8">ki yamo lapiru ma kodo matek pi cobo gin ma en ociko!<verse eid="PSA 148:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />Wupake, wun godi ki ceregu,</para>
  <para style="q1" vid="PSA 148:9">wun yadi ma nyak ki yadi cedar ducu!<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />Lee tim ki dyangi ducu,</para>
  <para style="q1" vid="PSA 148:10">gin makwo ma lak alaka i ngom ki winyo ducu ma tuk!<verse eid="PSA 148:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />Wupake, wun luker me lobo kacel ki lwak me rok ducu,</para>
  <para style="q1" vid="PSA 148:11">rwodi ki luloc ducu me lobo!<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />Awobe ki anyira kacel,</para>
  <para style="q1" vid="PSA 148:12">jo ma otii ki lutino bene!<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Wek gupak nying Rwot,</para>
  <para style="q1" vid="PSA 148:13">pien nyinge keken aye dit makato ducu;</para>
  <para style="q1" vid="PSA 148:13">deyone bene kato polo ki lobo woko.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />En omiyo lwake odoko tek,</para>
  <para style="q1" vid="PSA 148:14">ci omiyo jone ducu gipake,</para>
  <para style="q1" vid="PSA 148:14">gin jo Icrael ma pirgi tek mada bote.</para>
  <para style="q1" vid="PSA 148:14">Wupak Rwot!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s1">Wer me pako Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Wupak Rwot!</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q1" vid="PSA 149:1">Wuwer wer manyen bot Rwot;</para>
  <para style="q1" vid="PSA 149:1">wupake i coke pa lwak ma gin gene!<verse eid="PSA 149:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Wun jo Icrael, cwinywu myero obed yom ikom Lubanga ma ocweyowu;</para>
  <para style="q1" vid="PSA 149:2">wun jo Cion, wubed ki yomcwiny pi Rwotwu!<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Wupak nyinge ki myel;</para>
  <para style="q1" vid="PSA 149:3">wugo bul ki nanga kun wupake kwede.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Pien Rwot cwinye yom ikom lwake;</para>
  <para style="q1" vid="PSA 149:4">en miyo deyo bot jo mamwol, miyo giloyo.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Wek jone ma gigene gugo kijira kideyo;</para>
  <para style="q1" vid="PSA 149:5">wek guwer wer me yomcwiny i karamagi.<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Wek gudange matek ki dwon malongo ka gipako Rwot,</para>
  <para style="q1" vid="PSA 149:6">dok gumak pala lucwan ma lebe bit ryoryo i cinggi,<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />me culu kwor ikom lurok,</para>
  <para style="q1" vid="PSA 149:7">ki dok me pwodo lwak me rok mapol,<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />me tweyo lukergi woko ducu ki nyor,</para>
  <para style="q1" vid="PSA 149:8">ki me tweyo luditogi me awora woko ducu ki nyor me nyonyo,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />ki me miyogi pwod ikomgi kit mayam Lubanga ociko!</para>
  <para style="q1" vid="PSA 149:9">Man aye loc pi lwake ducu ma gin gene.</para>
  <para style="q1" vid="PSA 149:9">Wupak Rwot!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s1">Wupak Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Wupak Rwot.</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q1" vid="PSA 150:1">Wupak Rwot i kabedone maleng;</para>
  <para style="q1" vid="PSA 150:1">wupake bene i dan polone matek!<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Wupake pi tic me twer ma en otiyo;</para>
  <para style="q1" vid="PSA 150:2">wupake pi dite madwong makato ducu.<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Wupake kun wukutu tum;</para>
  <para style="q1" vid="PSA 150:3">wupake ki nyamulere ki nanga!<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Wupake ki myel ki ajaa;</para>
  <para style="q1" vid="PSA 150:4">wupake ki nanga ki lukeme!<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Wupake ki bul ma kok malongo;</para>
  <para style="q1" vid="PSA 150:5">wupake bene ki gara ma kok malongo!<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Wek gin ducu ma ywe gupak Rwot!</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">Wupak Rwot!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>