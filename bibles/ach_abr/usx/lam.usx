<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id" />
  <para style="h">KOKO</para>
  <para style="toc1">Koko</para>
  <para style="toc2">Koko</para>
  <para style="toc3">Kok</para>
  <para style="mt2">Buk me</para>
  <para style="mt1">KOKO</para>
  <para style="imt">Lanyut wilok madito ma i buk man</para>
  <para style="ip">
    <char style="bk">Koko </char> obedo dul me lwod abic mapatpat ma kiketogi i buk acel pi koko kit ma kibalo kwede Jerucalem woko i mwaka miya abic ki pyere aboro wiye abicel, ma peya onongo kinywalo Yecu. Man obedo kare ma onongo kitero dano woko i opii i lobo pa lurok. Kadi bed ni lok ma i buk man opong ki kumu, ento buk man bene tye ki lok mogo me keto gen ikom Lubanga kacel ki bedo ki gen pi kwo me anyim. Lujudaya gitiyo ki lwod magi ka giworo Lubanga i ninogi me rii kec ki me kumu ikare ma gipoyo wigi ikom atwom ma opoto i lobogi i mwaka miya abic ki pyere aboro wiye abicel, ma peya onongo kinywalo Yecu.</para>
  <para style="iot">Lacim wilok madito ma i buk man</para>
  <para style="io1">Cwercwiny pa jo Jerucalem <char style="ior"><ref loc="LAM 1:1-22">1:1-22</ref></char></para>
  <para style="io1">Pwod ikom Jerucalem <char style="ior"><ref loc="LAM 2:1-22">2:1-22</ref></char></para>
  <para style="io1">Pwod kacel ki gen <char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref></char></para>
  <para style="io1">Jerucalem kibalo woko <char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref></char></para>
  <para style="io1">Lega me kwayo kica <char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref></char></para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s1">Cwercwiny pa jo Jerucalem</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />Jerucalem mayam opong ki dano,</para>
  <para style="q1" vid="LAM 1:1">dong odong nono ningning kaa!</para>
  <para style="q1" vid="LAM 1:1">En ma onongo obedo taun madit mada ikin lurok, odoko calo dato.</para>
  <para style="q1" vid="LAM 1:1">En mayam obedo daker ikin taun maditogu ducu,</para>
  <para style="q1" vid="LAM 1:1">kombedi odoko calo opii.<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />En kok malit i dyewor benebene,</para>
  <para style="q1" vid="LAM 1:2">pig wange mol piny wa i leme.</para>
  <para style="q1" vid="LAM 1:2">Pe tye ngat mo kadi ki acel ikin jo ma en ribe kwedgi,</para>
  <para style="q1" vid="LAM 1:2">maromo kweyo cwinye.</para>
  <para style="q1" vid="LAM 1:2">Jo ducu ma en ribe kwedgi dong guloke gudoko lukwore, ma gitimo en marac ki lok me roro.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />Kitero jo Juda woko i opii kaneno can madwong, ki katiyo tic matego.</para>
  <para style="q1" vid="LAM 1:3">Kombedi dong gitye kamal ata ikin lurok,</para>
  <para style="q1" vid="LAM 1:3">ma pe ginongo kamo ma myero guywe iye;</para>
  <para style="q1" vid="LAM 1:3">jo ma guryemo korgi gumakogi woko i wangayo</para>
  <para style="q1" vid="LAM 1:3">ikare ma onongo can dong obwoyogi woko marac.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />Yoo mayam dano giwok ki iye ka gicito i Cion tye kakumu,</para>
  <para style="q1" vid="LAM 1:4">pien ngat mo peke ma cito kakwero nino madito ma kiciko.</para>
  <para style="q1" vid="LAM 1:4">Anyirane mayam giwero kunu cwinygi ton mada dok tamgi obale woko pien kidirogi cen,</para>
  <para style="q1" vid="LAM 1:4">ki ajwakine bene gicur acura.</para>
  <para style="q1" vid="LAM 1:4">Dog gange ducu dong odong nono,</para>
  <para style="q1" vid="LAM 1:4">dok Cion kikome tye ki arem malit adada.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />Lumeroke dong gitye maber ki kuc; dok gudoko luloc ikome.</para>
  <para style="q1" vid="LAM 1:5">Pien Rwot oye ni can opot ikome,</para>
  <para style="q1" vid="LAM 1:5">pi lwak bale mapol.</para>
  <para style="q1" vid="LAM 1:5">Lutinone dong kiterogi woko,</para>
  <para style="q1" vid="LAM 1:5">dok gudoko opii pa lumerok ma oyakogi.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />Deyo ki dit dong oa woko ki ikom Cion.</para>
  <para style="q1" vid="LAM 1:6">Rwodine ducu dong gudoko calo til ma tekogi dong peke pi kec ma onekogi,</para>
  <para style="q1" vid="LAM 1:6">ma pe ginongo olet mo kama myero gucam iye lum;</para>
  <para style="q1" vid="LAM 1:6">ka gingweco woko ki inyim jo ma ryemo korgi.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />Ikare me can ki me atwom;</para>
  <para style="q1" vid="LAM 1:7">jo Jerucalem wigi po pi jami me welgu ducu</para>
  <para style="q1" vid="LAM 1:7">mayam gitye kwede nia wacon.</para>
  <para style="q1" vid="LAM 1:7">Ento kombedi dong jone gupoto i cing lumerokgi;</para>
  <para style="q1" vid="LAM 1:7">dok bene pe tye ngat mo ma myero okonygi,</para>
  <para style="q1" vid="LAM 1:7">lumerok gutyeko taun gi madit woko,</para>
  <para style="q1" vid="LAM 1:7">kun gingalo can ma opoto ikomgini angala.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />Jo Jerucalem gutimo bal madito adada, omiyo gudoko gin anyera;</para>
  <para style="q1" vid="LAM 1:8">jo ducu mayam worogi dong cayogi acaya,</para>
  <para style="q1" vid="LAM 1:8">pien guneno ni gin dong gitye munero.</para>
  <para style="q1" vid="LAM 1:8">Jerucalem tye kacur,</para>
  <para style="q1" vid="LAM 1:8">kun oloko wange okemo kamukene.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />Kenine tye ma dong omoko woko ikom bongone,</para>
  <para style="q1" vid="LAM 1:9">ento yam pe obedo ki tam mo ni kwone bigik ki can.</para>
  <para style="q1" vid="LAM 1:9">Can ma opoto ikomeni rac atikatika,</para>
  <para style="q1" vid="LAM 1:9">dok ngat ma kweyo cwinye bene peke.</para>
  <para style="q1" vid="LAM 1:9">En kok ni, “Ai Rwot, nen can ma opoto ikoma magwani,</para>
  <para style="q1" vid="LAM 1:9">pien lukwor gitye kawayo iwiya ki wayu me loc!”<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />Lamerok dong oryeyo cinge oyako jamine mabeco me welgu woko ducu.</para>
  <para style="q1" vid="LAM 1:10">Eyo en onongo oneno lurok</para>
  <para style="q1" vid="LAM 1:10">ka gidonyo i kabedone malengi.</para>
  <para style="q1" vid="LAM 1:10">Gin jo mayam onongo kigengogi woko</para>
  <para style="q1" vid="LAM 1:10">ni pe gudony i coke pa Lubanga.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />Lwake ducu gitye kacur acura kun giyenyo gin acama:</para>
  <para style="q1" vid="LAM 1:11">gicato jamigi mabeco woko liweng pi cam,</para>
  <para style="q1" vid="LAM 1:11">wek komgi dok olim tek.</para>
  <para style="q1" vid="LAM 1:11">Giwaco ni, “Nenwa, ai Rwot, pien dong kitye kacayowa mada.”<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />En kok ni, “Man pe gin mo ki tung botwu ce,</para>
  <para style="q1" vid="LAM 1:12">wun ducu ma wutye kakato akata ki ingetani?</para>
  <para style="q1" vid="LAM 1:12">Wulok wangwu wunen ka tye kit cwercwiny mo</para>
  <para style="q1" vid="LAM 1:12">marom ki kit cwercwiny ma kikelo ikomani,</para>
  <para style="q1" vid="LAM 1:12">ma Rwot omiyo opoto ikoma, ikare me kinigane.<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />En ocwalo mac oa ki malo,</para>
  <para style="q1" vid="LAM 1:13">opoto ikom cogona:</para>
  <para style="q1" vid="LAM 1:13">ociko obwo wek tyena omok iye,</para>
  <para style="q1" vid="LAM 1:13">ci oloka woko atataro;</para>
  <para style="q1" vid="LAM 1:13">ka dong oweka ma abange woko,</para>
  <para style="q1" vid="LAM 1:13">kun abedo ma koma lit dyeceng jwi.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />Bala ducu en otweyogi woko ikom okol,</para>
  <para style="q1" vid="LAM 1:14">ci oridogi woko liking;</para>
  <para style="q1" vid="LAM 1:14">ka dong orwakogi i nguta, omiyo tekona otum liweng;</para>
  <para style="q1" vid="LAM 1:14">Rwot omiya woko i cing lumerokwa,</para>
  <para style="q1" vid="LAM 1:14">ma pe dong aromo lweny kwedgi.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />Rwot otero oteka lwenya ducu ma ikin jona calo gin me tuku ma konygi peke;</para>
  <para style="q1" vid="LAM 1:15">en olwongo coke me neno lok ikoma,</para>
  <para style="q1" vid="LAM 1:15">wek kingid awobena woko.</para>
  <para style="q1" vid="LAM 1:15">Rwot onyono jo Juda piny, kit macalo kinyono kwede kongo bwino i bur.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />Akok pi lok magi</para>
  <para style="q1" vid="LAM 1:16">ma pig wanga mol adada.</para>
  <para style="q1" vid="LAM 1:16">Pe tye ngat mo ma myero okwe cwinya,</para>
  <para style="q1" vid="LAM 1:16">ngat ma kono oteg cwinya bene peke.</para>
  <para style="q1" vid="LAM 1:16">Gen pa jona dong otum woko liweng,</para>
  <para style="q1" vid="LAM 1:16">pien lamerok aye dong oloyo.”<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />Cion oryeyo cinge,</para>
  <para style="q1" vid="LAM 1:17">ento pe tye dano mo ma kweyo cwinye;</para>
  <para style="q1" vid="LAM 1:17">Rwot yam oywayo mony ikom Yakobo,</para>
  <para style="q1" vid="LAM 1:17">wek jo ma gurume gudok lumeroke.</para>
  <para style="q1" vid="LAM 1:17">Jo Jerucalem guloke gudoko gin me cilo ma kicayo.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />Jerucalem waco ni, “Gin ducu ma Rwot otiyo ikoma tye atir,</para>
  <para style="q1" vid="LAM 1:18">pien onongo ajemo akwero winyo loke;</para>
  <para style="q1" vid="LAM 1:18">ento wun lwak me rok ducu wuwiny,</para>
  <para style="q1" vid="LAM 1:18">dok wunen arem ma atye kwede;</para>
  <para style="q1" vid="LAM 1:18">pien anyirana ki awobena dong kiterogi woko i opii.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />Alwongo jo ma aribe kwedgini,</para>
  <para style="q1" vid="LAM 1:19">ento gubwola abwola;</para>
  <para style="q1" vid="LAM 1:19">ajwakina ki ludongona ducu,</para>
  <para style="q1" vid="LAM 1:19">guto gutum woko i taun madit,</para>
  <para style="q1" vid="LAM 1:19">ikare ma onongo giyenyo cam wek omii komgi dok olim tek.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />Ai Rwot, nen, atye ki can marac, cwinya dong orube woko marac;</para>
  <para style="q1" vid="LAM 1:20">nen, cwinya tye kapoto niling malit, pien abedo ngat ma lajemo;</para>
  <para style="q1" vid="LAM 1:20">kitye kaneko dano woko i wangayo ki pala lucwan, kadi wa ki i ot bene to poto ikomgi.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />Kong iwiny ka acur,</para>
  <para style="q1" vid="LAM 1:21">pe tye ngat mo ma kweyo cwinya.</para>
  <para style="q1" vid="LAM 1:21">Lukwora ducu dong guwinyo pi can ma opoto ikoma; cwinygi yom ni itimo man maber ikoma.</para>
  <para style="q1" vid="LAM 1:21">Cwal nino mayam dong itito pireni obin,</para>
  <para style="q1" vid="LAM 1:21">wek gin bene gubed ki can calo an.<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />Wek gin marac ducu ma gutiyo oo inyimi,</para>
  <para style="q1" vid="LAM 1:22">ci ipwodgi bene kit ma ipwoda kwede,</para>
  <para style="q1" vid="LAM 1:22">pi lwak bala ducu mayam atimo;</para>
  <para style="q1" vid="LAM 1:22">pien atye kacur mada,</para>
  <para style="q1" vid="LAM 1:22">dok tek dong otum woko ki i cwinya.”<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s1">Pwod ma Rwot oketo ikom Jerucalem</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />Rwot oumu Cion woko ki pol macol licuc,</para>
  <para style="q1" vid="LAM 2:1">kun onongo tye ki kiniga.</para>
  <para style="q1" vid="LAM 2:1">En okwanyo deyo pa Icrael woko ci obolo woko piny odoko gin me lewic i lobo.</para>
  <para style="q1" vid="LAM 2:1">Pe dok wiye opo ikom kabedone maleng,</para>
  <para style="q1" vid="LAM 2:1">ikare ma dong onongo kiniga omake.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />Rwot ojwero odi pa jo pa Yakobo woko ducu labongo kica mo.</para>
  <para style="q1" vid="LAM 2:2">Dok omuku cel gogo pa jo Juda woko ducu pi kinigane,</para>
  <para style="q1" vid="LAM 2:2">ci odwoko rwomgi wa piny i ngom ki lewic,</para>
  <para style="q1" vid="LAM 2:2">ker kacel ki luloce ducu.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />En oturu tek pa Icrael woko ducu pi kinigane mager atika;</para>
  <para style="q1" vid="LAM 2:3">dok bene okwero konyogi woko,</para>
  <para style="q1" vid="LAM 2:3">ikare ma lukworgi opoto ikomgi.</para>
  <para style="q1" vid="LAM 2:3">Kinigane olyel ikom Yakobo calo mac ma lyel,</para>
  <para style="q1" vid="LAM 2:3">ma wango jami ma kangete woko ducu.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />En otelo atume calo lamerok,</para>
  <para style="q1" vid="LAM 2:4">kun ojingo bade ma lacuc woko ikomwa calo lakwor;</para>
  <para style="q1" vid="LAM 2:4">ci oneko jo mayam wagenoni woko ducu ki i Cion.</para>
  <para style="q1" vid="LAM 2:4">En ocoro kinigane mager ikomwa calo mac.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />Rwot dong odoko macalo lakwor pa jo Icrael,</para>
  <para style="q1" vid="LAM 2:5">ci otyekogi woko liweng.</para>
  <para style="q1" vid="LAM 2:5">En otyeko gang kal madongo mapol woko ducu,</para>
  <para style="q1" vid="LAM 2:5">omiyo cel gogo ducu dong gudoko obur;</para>
  <para style="q1" vid="LAM 2:5">dong onyayo kumu ki koko odoko dwong bot jo Juda.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />En oturu Ot mere woko piny macalo bolo mo ata ma i poto,</para>
  <para style="q1" vid="LAM 2:6">omiyo kabedo me kwero nino madito ma kiciko odong obur.</para>
  <para style="q1" vid="LAM 2:6">Rwot dong omiyo kwero nino madito ki ceng me Cabit ogik woko i Cion;</para>
  <para style="q1" vid="LAM 2:6">pi akemone mager,</para>
  <para style="q1" vid="LAM 2:6">omiyo kicayo rwot ki ajwaka pa Lubanga.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />Rwot dong ocayo keno tyere mada,</para>
  <para style="q1" vid="LAM 2:7">okunu bene kabedone malengi woko;</para>
  <para style="q1" vid="LAM 2:7">otyeko dong miyo gang kal madongo woko ducu</para>
  <para style="q1" vid="LAM 2:7">i cing lukwore;</para>
  <para style="q1" vid="LAM 2:7">omiyo guwoo i Ot pa Rwot,</para>
  <para style="q1" vid="LAM 2:7">macalo ikare me kwero nino madit.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />Rwot onongo dong oyube woko pi muku cel me Cion</para>
  <para style="q1" vid="LAM 2:8">wek kabedone dong obed wi obur;</para>
  <para style="q1" vid="LAM 2:8">en opimo woko dong ki tol,</para>
  <para style="q1" vid="LAM 2:8">ci ocako tyekone woko dok bene pe ojuku cinge;</para>
  <para style="q1" vid="LAM 2:8">ci omiyo gogone ki cele ducu gukok,</para>
  <para style="q1" vid="LAM 2:8">kun komgi ducu oloc woko kacel.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />Dog cele ducu gumwony woko piny i ngom,</para>
  <para style="q1" vid="LAM 2:9">en omuku dok oturu wa kicikane woko bene liweng;</para>
  <para style="q1" vid="LAM 2:9">lukerne ki rwodine gitye i opii,</para>
  <para style="q1" vid="LAM 2:9">Cik dong pe kipwonyo matwal.</para>
  <para style="q1" vid="LAM 2:9">Wa lunebine bene dong pe gineno ginanyuta ma a ki bot Rwot.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Ludongo me Jerucalem, gibedo piny laling;</para>
  <para style="q1" vid="LAM 2:10">guonyo apwa iwigi, dong guruku bongo cola.</para>
  <para style="q1" vid="LAM 2:10">Anyira Jerucalem dong gukulu wigi piny.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />Abedo kakoko ki pig wanga,</para>
  <para style="q1" vid="LAM 2:11">ma cwinya dong orube woko;</para>
  <para style="q1" vid="LAM 2:11">cwinya opong woko ligwik ki can,</para>
  <para style="q1" vid="LAM 2:11">pi lwak jo Cion ma dong kityekogi woko.</para>
  <para style="q1" vid="LAM 2:11">Lutino matino ki lutino lukere gutum woko idye yoo ducu ma i taun madit.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />Gin gikok bot megigi pi kec ki orwo ma nekogi;</para>
  <para style="q1" vid="LAM 2:12">kun giwile calo jo ma ret omakogi, idye yoo ducu ma i taun madit,</para>
  <para style="q1" vid="LAM 2:12">kun kwogi tum woko, ki i kor megigi.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />In Jerucalem atwero loko gin ango piri,</para>
  <para style="q1" vid="LAM 2:13">dok atwero pori ki ngo?</para>
  <para style="q1" vid="LAM 2:13">Atwero waco gin ango,</para>
  <para style="q1" vid="LAM 2:13">ma romo kweyo cwinyi, in Cion ma amaroni?</para>
  <para style="q1" vid="LAM 2:13">Pien oburri dong lac calo nam.</para>
  <para style="q1" vid="LAM 2:13">Anga dong matwero dwoko cwinyi cen?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />Lunebini yam gutito ginanyuta me goba ki me bwola keken boti,</para>
  <para style="q1" vid="LAM 2:14">pe gunyutu bali kamaleng pi dwoko gumi ducu boti;</para>
  <para style="q1" vid="LAM 2:14">ento gubedo kaneno lok me goba me teri i can keken.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />Jo ma woto gikato ki i gudo gineni ki wang me cac;</para>
  <para style="q1" vid="LAM 2:15">kun gijwat ma giyengo wigi pi Jerucalem ni,</para>
  <para style="q1" vid="LAM 2:15">“Man aye taun madit mayam kilwongo ni mwonya tutwali,</para>
  <para style="q1" vid="LAM 2:15">ma onongo yomo cwiny lobo ducuni?”<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />Lukwori gingali, dok gijwat ma gikayo lakgi.</para>
  <para style="q1" vid="LAM 2:16">Gin gidange ni, “Dong watyeko neke woko!</para>
  <para style="q1" vid="LAM 2:16">Eyo, man en aye kare mayam wabedo kaparo pireni,</para>
  <para style="q1" vid="LAM 2:16">dong oo, dok waneno ki wangwa!”<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />Rwot dong otiyo kit macalo en oyubu wacon ca,</para>
  <para style="q1" vid="LAM 2:17">dok ocobo gin mayam en omoko.</para>
  <para style="q1" vid="LAM 2:17">En omuku taunwu madit oreto woko piny labongo kica mo;</para>
  <para style="q1" vid="LAM 2:17">omiyo lukworwa gubedo ki yomcwiny madwong ikomwa,</para>
  <para style="q1" vid="LAM 2:17">dok omiyo tek bot oteka lweny pa lumerokwa.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />Kok matek bot Rwot, in Cion!</para>
  <para style="q1" vid="LAM 2:18">Wek pig wangi omol ocit piny macalo pii ma i kulu,</para>
  <para style="q1" vid="LAM 2:18">ma mol dyeceng ki dyewor benebene.</para>
  <para style="q1" vid="LAM 2:18">Pe iwek komi ool ki koko, pe bene iwek pig wangi ocoki!<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />A malo, kok matek i dyewor benebene!</para>
  <para style="q1" vid="LAM 2:19">Ony can matye i cwinyi woko macalo pii inyim Rwot!</para>
  <para style="q1" vid="LAM 2:19">Tang cingi malo bot Rwot,</para>
  <para style="q1" vid="LAM 2:19">kun ikok bote pi kwo pa lutinoni,</para>
  <para style="q1" vid="LAM 2:19">ma kec miyo giwile woko i yoo ducu matye idye gang.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />Nen, ai Rwot, ci itam!</para>
  <para style="q1" vid="LAM 2:20">Pingo ipwodowa i yo macalo man?</para>
  <para style="q1" vid="LAM 2:20">Mon gitye kacamo lutino lukere ma gitingo i korgi.</para>
  <para style="q1" vid="LAM 2:20">Kitye kaneko ajwaki ki lunebi i kabedoni maleng ai Rwot.<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />Lutino ki ludito ma otii guto woko idye yoogu;</para>
  <para style="q1" vid="LAM 2:21">anyirana ki lutino awobena kinekogi woko liweng ki pala lucwan.</para>
  <para style="q1" vid="LAM 2:21">In inekogi woko ikare ma onongo itye ki kiniga;</para>
  <para style="q1" vid="LAM 2:21">ci inekogi labongo kica mo.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />In ilwongo lukwora ci guruma woko dyere kun gimiya lworo madit</para>
  <para style="q1" vid="LAM 2:22">macalo ilwongogi kakwero nino me karama.</para>
  <para style="q1" vid="LAM 2:22">Ki ikare ma Rwot onongo kiniga omako,</para>
  <para style="q1" vid="LAM 2:22">pe tye dano mo ma obwot nyo ma obedo kwo.</para>
  <para style="q1" vid="LAM 2:22">Lukwora guneko lutino mayam atingogi dok apitogini.<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s1">Pwod, Ngut, ki bedo ki Gen</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />An aye dano ma oneno can tutwal icing Rwot</para>
  <para style="q1" vid="LAM 3:1">pien awinyo lit me arem ma ogoya kwede ki akemo.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />En oryema woko ci otera i colpiny kama dero mo peke iye.<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />Adada en bedo kapwoda,</para>
  <para style="q1" vid="LAM 3:3">pwoda dok pwoda dyeceng jwi.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />En omiyo ringo koma ki del koma obale woko,</para>
  <para style="q1" vid="LAM 3:4">dok oturu cogona woko bene.<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />En omonya ci ogura woko dyere,</para>
  <para style="q1" vid="LAM 3:5">ma cwinye kec ki can ma mito keto ikoma.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />En oketa abedo i colpiny,</para>
  <para style="q1" vid="LAM 3:6">calo dano ma oto wayam con.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />En ocweyo cel oruma kwede woko dyere,</para>
  <para style="q1" vid="LAM 3:7">wek pe alwi akat woko abwot pi laro kwona;</para>
  <para style="q1" vid="LAM 3:7">ci otweyo okol i tyena, ki nyor mapek adada.<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />Kadi bed alwong lwongo ma kun akok ni kikonya,</para>
  <para style="q1" vid="LAM 3:8">ento en dingo ite woko pe winyo legana.<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />En otyeko cego yona woko ki godi ma kipayo,</para>
  <para style="q1" vid="LAM 3:9">omiyo yona obedo ma ogomogom.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />En obedo kakura calo nguu ma obutu ma tye kakiyo piny,</para>
  <para style="q1" vid="LAM 3:10">ci opoto ikoma calo labwor.<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />En oryema woko ki i yona dok okila matinotino,</para>
  <para style="q1" vid="LAM 3:11">ci obwota woko.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />En otelo atume, okema kwede,</para>
  <para style="q1" vid="LAM 3:12">omiyo adoko ginacela ki aterone.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />Ci ocelo adununa woko</para>
  <para style="q1" vid="LAM 3:13">ki atero ma okwanyo ki i jurune.<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />Dong adoko ginanyera pa lwak me rok ducu,</para>
  <para style="q1" vid="LAM 3:14">nyinga odoko lok aboka dok kiwera ki wer dyeceng jwi.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />Omiya apong ki can malit mada,</para>
  <para style="q1" vid="LAM 3:15">omiyo ayeng ki odir yat.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />En omiyo amwodo kweyo ki laka,</para>
  <para style="q1" vid="LAM 3:16">kun anywene woko ki buru.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />Kikwanyo kuc woko ki i cwinya,</para>
  <para style="q1" vid="LAM 3:17">wiya dong owil woko ikit ma yomcwiny tye kwede.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Omiyo awaco ni, “Kwona dong otum woko,</para>
  <para style="q1" vid="LAM 3:18">ki gin ma ageno ki bot Rwot dong peke.”<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />Ka atamo pi can ma atye kwede ki kit ma atye kamal kwede ata ikin piny,</para>
  <para style="q1" vid="LAM 3:19">ci rom aroma ki mato kwir makec!<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />Cwinya nino ducu tamo pire,</para>
  <para style="q1" vid="LAM 3:20">ci ngur woko piny ki iiya.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Ento abikano loke i iya,</para>
  <para style="q1" vid="LAM 3:21">pimeno miyo dok pud abedo ki gen.<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />Mar pa Rwot ma pe loke bedo matwal pe gik,</para>
  <para style="q1" vid="LAM 3:22">ki kicane bene pe gik.<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />Giroc gidoko nyen rupiny ki rupiny;</para>
  <para style="q1" vid="LAM 3:23">in aye i gene mada.<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />Awaco ki i cwinya ni, “Rwot aye gin ducu ma amito,</para>
  <para style="q1" vid="LAM 3:24">pimeno abigeno en.”<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />Rwot ber bot jo ma giketo gen gi ikome,</para>
  <para style="q1" vid="LAM 3:25">ki bot dano ma yenye ki i cwinye ducu.<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />Bedo ber ka dano kuru Rwot mot, kun gikuru lar ma a ki bote.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />Bedo ber ka dano oye juk pa Rwot ma nongo en pud tidi.<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Wek obed kene laling ka en limo can,</para>
  <para style="q1" vid="LAM 3:28">kun nongo ngeyo ni Rwot aye ma oketo can man ikome;<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />wek omwole piny i apwa,</para>
  <para style="q1" vid="LAM 3:29">gwok onyo gen pud bibedo tye.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />Wek olok leme bot ngat ma odonge,</para>
  <para style="q1" vid="LAM 3:30">ci wek opong ki lewic madwong.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />Pien Rwot gire lakica dok bene pe bolo dano woko matwal,<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />ento kadi bed en kel cwercwiny me can ikom dano, ci pud kica make aye</para>
  <para style="q1" vid="LAM 3:32">macalo mar mere ma pe loke tye dwong.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />Pien en pe keto can nyo cwercwiny ikom dano akaka.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />Rwot ngeyo ka kiunu lumabuc ma iwi lobo;<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />Rwot ngeyo ka kikwanyo twer ma dano tye kwede woko ma en omiyowa<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />dok bene en ngeyo ka kibalo te pido pa dano woko akaka.<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />Anga ma ociko lok ci otime bene,</para>
  <para style="q1" vid="LAM 3:37">ka pe Rwot aye ma ociko?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />Gin maber ki gin marac mono ducu</para>
  <para style="q1" vid="LAM 3:38">pe gia ki i dog Ngat Mamalo Twal?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />Dano makwo kok pingo ka can opoto ikome pi bale?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />Kong watemu neno kitwa dok wangiyu kwowa,</para>
  <para style="q1" vid="LAM 3:40">ci waloke wadwog bot Rwot.<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />Myero wamii cwinywa kun wailo cingwa</para>
  <para style="q1" vid="LAM 3:41">malo i polo bot Lubanga kun wawaco ni,<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />“Wan dong wabalo dok wajemo,</para>
  <para style="q1" vid="LAM 3:42">ci in bene pe iweko balwa.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />Imiyo kiniga oboyo komi woko kun iryemo korwa,</para>
  <para style="q1" vid="LAM 3:43">inekowa woko labongo paro pirwa.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Imiyo pol me gero oboyi woko</para>
  <para style="q1" vid="LAM 3:44">wek lega mo pe otuc oo boti.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />Imiyo wadoko calo bur yugi ma kicayo,</para>
  <para style="q1" vid="LAM 3:45">ikin lurok ducu.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />Lukworwa ducu dong gitye kangalowa angala.<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />Can ma wanenoni dong omiyo komwa omyel dok lworo bene opoto ikomwa,</para>
  <para style="q1" vid="LAM 3:47">dok topiny obino katyekowa woko.<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />Pig wanga mol calo pii ma i kulu</para>
  <para style="q1" vid="LAM 3:48">pien jona dong kinekogi woko matwal.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />Pig wanga bibedo kamol ma pe cok,</para>
  <para style="q1" vid="LAM 3:49">ci bimede mere ameda,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />nio wang ma Rwot oneno piny ki i polo.<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Gin ma aneno miyo cwercwiny bota,</para>
  <para style="q1" vid="LAM 3:51">ka aneno gin ma otime ikom anyira ducu ma i taunwa madit.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />Lukwora gibedo kadwara macalo gidwaro winyo,</para>
  <para style="q1" vid="LAM 3:52">kun tyen lok mo ma omiyo gidwara peke.<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />Gubola makwo i bur,</para>
  <para style="q1" vid="LAM 3:53">ci gubolo got woko iwiya.<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />Pii ocako mwonyo wiya woko,</para>
  <para style="q1" vid="LAM 3:54">omiyo atamoni dong acok ki to!<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />Ai Rwot, alwongo nyingi,</para>
  <para style="q1" vid="LAM 3:55">ki i bor piny kamatut;<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />ci iwinyo kokona ma akok kwede boti ni, ‘Pe i ding iti kawinyo kokona, konya do!’<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />Yam ibino cok ikare ma akok boti; dok in iwaco bota ni, ‘Pe ilwor!’<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />In dong icung kapido pira, ai Rwot ci ikoko kwona ki i to.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />Ai Rwot, in bene dong i neno gin marac ma kitimo ikoma;</para>
  <para style="q1" vid="LAM 3:59">in aye ingol kop ma mera ma nyutu ni bala mo peke.<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />In ingeyo lokgi maracu ducu ma gupiro ma gubedo kaporone me culu kwor ikoma.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />Ai Rwot, iwinyo bene lok ma giloko me yet,</para>
  <para style="q1" vid="LAM 3:61">ki lok ducu maracu ma gubedo kaporone ikoma.<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />Gin giloko lok ikoma iyub ma meggi,</para>
  <para style="q1" vid="LAM 3:62">gilwenyo ikoma dyeceng jwi.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />Kadi gubedo piny onyo gua malo;</para>
  <para style="q1" vid="LAM 3:63">gicako wer ikoma.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />Ai Rwot, cul kwora ikomgi,</para>
  <para style="q1" vid="LAM 3:64">kun lubu kit ma gin gutiyo.<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />Cen gi woko pien gin jo ma tokgi tek.<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />Ryem korgi ki kiniga,</para>
  <para style="q1" vid="LAM 3:66">ci ityekgi woko ki i lobo, ai Rwot.”<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s1">Gin ma otime inge poto pa Jerucalem</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />Jabu ma mili dong ocido woko licuc,</para>
  <para style="q1" vid="LAM 4:1">jabu ma yam kiliyo maberi dong kite oloke woko!</para>
  <para style="q1" vid="LAM 4:1">Godi me Ot maleng guket woko piny atata;</para>
  <para style="q1" vid="LAM 4:1">guromo yoo woko ducu.<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />Awobe Cion</para>
  <para style="q1" vid="LAM 4:2">onongo yam gubedo me wel calo jabu mapek mabeco;</para>
  <para style="q1" vid="LAM 4:2">ento kombedi dong kinenogi calo agulu mamwa ma kicweyo ki lobo!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />Kadi too bene miyo tunune wek lutino gudot cake;</para>
  <para style="q1" vid="LAM 4:3">ento jona dong gudoko ger ikom lutinogi,</para>
  <para style="q1" vid="LAM 4:3">calo udu ma gibedo i tim.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />Leb latin lakere maromo dot</para>
  <para style="q1" vid="LAM 4:4">omoko woko i dane pien doge otwo woko ki orwo pii;</para>
  <para style="q1" vid="LAM 4:4">lutino tye kalego cam,</para>
  <para style="q1" vid="LAM 4:4">ento ngat mo mamiyo botgi peke.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />Jo mayam camo cam mabeco,</para>
  <para style="q1" vid="LAM 4:5">gitye kato woko liweng idye gudo;</para>
  <para style="q1" vid="LAM 4:5">jo mayam gitye ki kwo maber i ot pa luker,</para>
  <para style="q1" vid="LAM 4:5">dong giyenyo cam iwi odur.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19:24">Aca 19:24</ref>
      </char>
    </note> Can ma kiketo ikom jo tuwa,</para>
  <para style="q1" vid="LAM 4:6">dit makato can ma kiketo ikom jo Codom woko,</para>
  <para style="q1" vid="LAM 4:6">mayam kireto woko piny oyotoyot iwang cawa mo manok keken,</para>
  <para style="q1" vid="LAM 4:6">ikare ma Lubanga oketo cinge ikome.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />Rwodine yam komgi leng makato pee woko,</para>
  <para style="q1" vid="LAM 4:7">dok komgi tar makato cak;</para>
  <para style="q1" vid="LAM 4:7">komgi yam kwar makato gweng makwar me wel,</para>
  <para style="q1" vid="LAM 4:7">yam ginen beco calo kidi capir ma olil mapwoti.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />Ento kombedi wanggi ocido woko licuc makato cuk bilo,</para>
  <para style="q1" vid="LAM 4:8">dong dano bene pe ngeyogi ka giwok ki i gudo;</para>
  <para style="q1" vid="LAM 4:8">komgi ojony woko lingok ikom cogogi,</para>
  <para style="q1" vid="LAM 4:8">dok komgi otwo woko matek calo yen ma otwo.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />Jo ma kinekogi ki pala lucwan komgi gum</para>
  <para style="q1" vid="LAM 4:9">makato jo ma kec aye tye ka nekogi,</para>
  <para style="q1" vid="LAM 4:9">ma gujony lingok ma komgi odong geng nono,</para>
  <para style="q1" vid="LAM 4:9">pien cam mo peke ma ocek i poto.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:10: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:57">Nwo 28:57</ref>; <ref loc="EZK 5:10">Eje 5:10</ref></char>
    </note> Mon ma lukica ma gimaro lutinogi</para>
  <para style="q1" vid="LAM 4:10">aye dong gutedo kom lutinogi ki komgi;</para>
  <para style="q1" vid="LAM 4:10">ci lutinogi odoko camgi</para>
  <para style="q1" vid="LAM 4:10">ikare ma kityeko iye lutuwa.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />Rwot dong omiyo akemone olyeti woko marac,</para>
  <para style="q1" vid="LAM 4:11">ci ocoro kinigane malyet ikom Cion.</para>
  <para style="q1" vid="LAM 4:11">Ci omoko mac i Cion,</para>
  <para style="q1" vid="LAM 4:11">ma owango te gutine otyeko woko liweng.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />Luker me lobo bene yam pe guye,</para>
  <para style="q1" vid="LAM 4:12">nyo kadi ngat mo ikin jo ma bedo iwi lobo,</para>
  <para style="q1" vid="LAM 4:12">ni lumerok nyo lukwor twero donyo i dog cel me Jerucalem.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />Man obedo pi bal pa lunebine ki pi bal pa ajwakine,</para>
  <para style="q1" vid="LAM 4:13">ma guneko jo ma kitgi atir woko idye taun.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />Gubedo kawot ata idye gudo calo lutowang,</para>
  <para style="q1" vid="LAM 4:14">gunyobo komgi woko ki remo,</para>
  <para style="q1" vid="LAM 4:14">omiyo gudoko gin me kwer ma dano dong dag gudo.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />Dano gidange ikomgi kun giwaco ni, “Wulengwa yoo!</para>
  <para style="q1" vid="LAM 4:15">Wun jo ma komwu ki keni! Wuleng yoo! Wuleng yoo!</para>
  <para style="q1" vid="LAM 4:15">Pe wugud kwede komwa bene!”</para>
  <para style="q1" vid="LAM 4:15">Ci guringo gubwot woko gire, kun gubedo kamal ata ikin lurok,</para>
  <para style="q1" vid="LAM 4:15">ci jo ma i rok guwaco ni, “Pe dong gibibedo kacel kwedwa kany wa ki acel.”<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />Rwot kikome aye ma dong okeyogi woko,</para>
  <para style="q1" vid="LAM 4:16">dok pe dong biparo pirgi matwal;</para>
  <para style="q1" vid="LAM 4:16">deyo mo ma kimiyo bot ajwaki bene obedo peke,</para>
  <para style="q1" vid="LAM 4:16">gin mo maber ma gutimo bot ludongo peke.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />Wangwa ocike kaneno yoo</para>
  <para style="q1" vid="LAM 4:17">ento jo ma konyowa peke;</para>
  <para style="q1" vid="LAM 4:17">wabedo kakuru rok ma pe gitwero larowa.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />Lumerok dong gudingo korwa woko</para>
  <para style="q1" vid="LAM 4:18">omiyo pe dong watwero wot idye gudowa;</para>
  <para style="q1" vid="LAM 4:18">agikiwa onongo dong onyiko cok,</para>
  <para style="q1" vid="LAM 4:18">wel ninowa bene dong kikwano woko,</para>
  <para style="q1" vid="LAM 4:18">pien agikiwa dong oo.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />Jo ma guryemo korwa gidwir</para>
  <para style="q1" vid="LAM 4:19">ma gikato acut ma tuk cito malo,</para>
  <para style="q1" vid="LAM 4:19">gulubu korwa wa iwi godi;</para>
  <para style="q1" vid="LAM 4:19">dok gukane woko ka gukiyowa idye tim aroo.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />Ngat ma Rwot oyero,</para>
  <para style="q1" vid="LAM 4:20">ma pire tek botwa macalo kwowa,</para>
  <para style="q1" vid="LAM 4:20">kimako kitere woko i opii,</para>
  <para style="q1" vid="LAM 4:20">en mayam watamo ni bilarowa ki ikom lumerok.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />Wun jo Edom, wubed ki wake,</para>
  <para style="q1" vid="LAM 4:21">cwinywu bene obed yom,</para>
  <para style="q1" vid="LAM 4:21">wun ma wubedo i lobo Uj,</para>
  <para style="q1" vid="LAM 4:21">ento wubimato bene ki ikikopo me can;</para>
  <para style="q1" vid="LAM 4:21">wubimer woko ci wubilunyu bongiwu woko wudong munero.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />Wun jo Cion,</para>
  <para style="q1" vid="LAM 4:22">can ma kiketo ikomwu pi balwu dong ocobe kakare,</para>
  <para style="q1" vid="LAM 4:22">Rwot dong pe bigwokowu i opii matwal.</para>
  <para style="q1" vid="LAM 4:22">Ento wun jo Edom, Rwot biketo can ikomwu bene pi balwu,</para>
  <para style="q1" vid="LAM 4:22">ci en binyutu balwu woko ducu kamaleng.<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s1">Lega pi kica</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />Ai Rwot, kong ipo ikom gin ma opoto ikomwani;</para>
  <para style="q1" vid="LAM 5:1">cik wangi inen lewic ma watye kwede!<verse eid="LAM 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />Kiloko gipinywa dong odoko pa jo mukene;</para>
  <para style="q1" vid="LAM 5:2">ki gangiwa gudoko pa lurok.<verse eid="LAM 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />Wan dong waloke wadoko calo lutino kic,</para>
  <para style="q1" vid="LAM 5:3">ma wegigi peke;</para>
  <para style="q1" vid="LAM 5:3">megiwa dong gudoko calo mon to.<verse eid="LAM 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />Myero wawil pii ma wamatoni awila ki lim,</para>
  <para style="q1" vid="LAM 5:4">yen me tedo bene omyero wawil awila.<verse eid="LAM 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />Kiryemowa woko ki tek kun bene watye ki okol i ngutwa;</para>
  <para style="q1" vid="LAM 5:5">komwa bene oloc woko,</para>
  <para style="q1" vid="LAM 5:5">kun bene pe kimiyowa kare me yweyo.<verse eid="LAM 5:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />Wamoko gicike ki jo Ejipt ki jo Aciria,</para>
  <para style="q1" vid="LAM 5:6">wek wabed kwo</para>
  <para style="q1" vid="LAM 5:6">ki wek gumiwa cam maromowa.<verse eid="LAM 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />Kwariwa yam gubalo; ci guto woko,</para>
  <para style="q1" vid="LAM 5:7">ci balgi aye ma dong okelo can ikomwa.<verse eid="LAM 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />Opii aye ma dong giloyowa;</para>
  <para style="q1" vid="LAM 5:8">ngat mo peke ma myero olarwa ki i cinggi.<verse eid="LAM 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />Wadyero komwa pi nongo cam,</para>
  <para style="q1" vid="LAM 5:9">ma nongo wawok ki i lak pala lucwan idye tim.<verse eid="LAM 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />Del komwa dong odoko lyet calo keno</para>
  <para style="q1" vid="LAM 5:10">pi lyeto me kec matye kanekowa.<verse eid="LAM 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />Kimako mon i Cion ci kibutu kwedgi tektek,</para>
  <para style="q1" vid="LAM 5:11">wa ki anyira ma pud girini kibutu kwedgi tektek igangi ducu ma Juda.<verse eid="LAM 5:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />Kiguro luker woko ikom yat ki cinggi;</para>
  <para style="q1" vid="LAM 5:12">woro mo ma kimiyo bot ludongo dong peke.<verse eid="LAM 5:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />Kidiyo lutino awobe tektek me rego kal</para>
  <para style="q1" vid="LAM 5:13">awobe gicato ki yen mapek ma guyeyo iwi gwokgi.<verse eid="LAM 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />Co ma oteggi pe dong gigure i dog gang,</para>
  <para style="q1" vid="LAM 5:14">awobe bene pe dong gigoyo wer.<verse eid="LAM 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />Gin mayam yomo cwinywa dong ogik woko;</para>
  <para style="q1" vid="LAM 5:15">myel mayam wamyeloni dong oloke odoko kumu.<verse eid="LAM 5:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />Lalukana dong opoto woko piny ki iwiwa.</para>
  <para style="q1" vid="LAM 5:16">Ci waneno can, pien wabalo!<verse eid="LAM 5:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />Pi lok man omiyo cwinywa dong odoko goro,</para>
  <para style="q1" vid="LAM 5:17">pi jami magi omiyo wangwa bene dong ocido woko.<verse eid="LAM 5:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />Got Cion ma dong odong oburri;</para>
  <para style="q1" vid="LAM 5:18">too aye ma dong gitye kawot iwiye.<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19" />Ento in, ai Rwot, ibedo i loc nakanaka;</para>
  <para style="q1" vid="LAM 5:19">komkeri bedo nakanaka ikare pa yalwak ducu.<verse eid="LAM 5:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />Pingo wii wil woko ikomwa,</para>
  <para style="q1" vid="LAM 5:20">ibwotowa woko liyak pi kare marom man pingo?<verse eid="LAM 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />Dwokwa boti, ai Rwot, ci wek wadwogi!</para>
  <para style="q1" vid="LAM 5:21">Roc kare me bedowa odok manyen kit macalo yam tye con ca!<verse eid="LAM 5:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />Dong ikwerowa woko matwal ce?</para>
  <para style="q1" vid="LAM 5:22">Kinigani dong agikine peke ce?<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>