<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id" />
  <para style="h">CAROLOK</para>
  <para style="toc1">Buk me Carolok</para>
  <para style="toc2">Carolok</para>
  <para style="toc3">Car</para>
  <para style="mt2">Buk me</para>
  <para style="mt1">CAROLOK</para>
  <para style="imt">Lanyut wilok madito ma i buk man</para>
  <para style="ip">
    <char style="bk">Buk me Carolok </char> obedo coc mapatpat ma pwonyo dano yo me kit ma atir kacel ki yo me dini macalo labol onyo carolok. Buk man pole opong ki lok me aketa i tic malube ki kwo me nino ducu. Buk man cake ki lok me lapowic kitman ni “Ka imito bedo ki ngec, ci myero kong icak ki lworo nyo woro Rwot Lubanga” 1:7, ka dok mede kun bene pe loko ikom yo me kit matye atir i dini keken ento loko bene ikom ngec ma dano adana tye kwede medo ki kwo maber ma myero kibed kwede. Labol lok ma cegocego mapol ma kibolo iyeni onongo nyutu niang ma lupwonye me Icrael gitye kwede ma tito gin ango ma dano maryek tiyo malube ki gin ma en wok ki iye i kwo me kare ducu. Ikin pwony magi tye iye lok mamako kwo ikin dano ki jo ma i odigi, kwo ikin lutim biacara bene. Mogo loko ikom kit ma omyero kikwo kwede i yo ma opore malube ki ma dano adana myero okwo kwede ki wadgi kun nongo gijuke keken gi. Buk man loko bene mapol ikom lok mamako mwole, diyocwiny, woro lucan, kacel ki bedo kun icukucwiny laremi nyo me bedo ki wat me ada ikom laremi.</para>
  <para style="iot">Lacim wilok madito ma i buk man</para>
  <para style="io1">Kit ma kipako kwede ki ryeko <char style="ior"><ref loc="PRO 1:1-9:18">1:1—9:18</ref> </char></para>
  <para style="io1">Carolok pa Solomon <char style="ior"><ref loc="PRO 10:1-29:27">10:1—29:27</ref> </char></para>
  <para style="io1">Lok pa Agur <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref> </char></para>
  <para style="io1">Carolok mapatpat <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref> </char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Kony pa carolok</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:32">1 Luk 4:32</ref>
      </char>
    </note>Carolok pa Solomon, wod pa Daudi, rwot me Icrael.<verse eid="PRO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 1:2" />Carolok magi konyo dano me ngeyo ryeko ki pwony maber, ki me niang lok mamiyo niang matut, <verse eid="PRO 1:2" /><verse number="3" style="v" sid="PRO 1:3" />dok gipwonyo dano me bedo ki ryeko i gin ducu ma en tiyo, bedo ki kit matye atir, ngolo kop atir, kun tiyo ki dano ducu maromrom. <verse eid="PRO 1:3" /><verse number="4" style="v" sid="PRO 1:4" />Gipwonyo dano ma pe tye ki kit ngec mo, ci doko ryek; dok miyo ngec bot jo matino me moko lok maber pirgi ken gi. <verse eid="PRO 1:4" /><verse number="5" style="v" sid="PRO 1:5" />Carolok magi bene medo ngec bot ngat maryek, telo dano matye ki niang matut i tice, <verse eid="PRO 1:5" /><verse number="6" style="v" sid="PRO 1:6" />wek guniang tyen lok moni ma i carolok moni ki cal gin ma giloko ikome, ki koclit ma luryeko gibolo.<verse eid="PRO 1:6" /></para>
  <para style="s">Miyo tam bot jo matino</para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 1:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Yub 28:28</ref>; <ref loc="PSA 111:10">Jab 111:10</ref>; <ref loc="PRO 9:10">Car 9:10</ref></char>
    </note>Lworo Rwot en aye acaki me ngec. Jo maming gicayo ryeko dok gikwero pwony woko.<verse eid="PRO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 1:8" />Latina, winy lok ma woru pwonyi kwede, pe ikwer winyo pwony pa meni bene <verse eid="PRO 1:8" /><verse number="9" style="v" sid="PRO 1:9" />pien pwonygi twero yubu kiti maber, tye calo tok maber me aketa iwii, dok calo gingut ma iketo inguti miyo inen mwonya.<verse eid="PRO 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 1:10" />Latina, ka lubalo giomo cwinyi ki lok mo, pe myero iye. <verse eid="PRO 1:10" /><verse number="11" style="v" sid="PRO 1:11" />Gwok nyo gibiwaco ni, “Bin kacel kwedwa, wek wakii dano mo wanek woko, wakur dano ma pe tye ki bal wanek woko; <verse eid="PRO 1:11" /><verse number="12" style="v" sid="PRO 1:12" />wek wamwonygi woko ducu makwo macalo lyel, gubed macalo jo ma donyo piny i bur. <verse eid="PRO 1:12" /><verse number="13" style="v" sid="PRO 1:13" />Lonyo mapatpat ducu bidoko mewa, odiwa bipong ki jami ma wayako; <verse eid="PRO 1:13" /><verse number="14" style="v" sid="PRO 1:14" />bin i ribe kwedwa, wan ducu wabitic ki kicaa lim acel.”<verse eid="PRO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 1:15" />Latina, pe i ribe kawot ki jo macalo meno, gwoke pe i lub korgi; <verse eid="PRO 1:15" /><verse number="16" style="v" sid="PRO 1:16" />tyen gi lyet me ngwec katimo bal, gin nino ducu gitye ma guyube me oyo remo pa dano. <verse eid="PRO 1:16" /><verse number="17" style="v" sid="PRO 1:17" />Ciko obwo konyo ango ka winyo tye kaneni? <verse eid="PRO 1:17" /><verse number="18" style="v" sid="PRO 1:18" />Ento jo macalo meno giciko owic pirgi ken gi, gin gibito i owicgi ken gi. <verse eid="PRO 1:18" /><verse number="19" style="v" sid="PRO 1:19" />Meno aye can ma mako jo ma gin lubwami, meno aye gin ma kwanyo kwogi woko.<verse eid="PRO 1:19" /></para>
  <para style="s1">Lwongo pa ryeko</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 1:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:1-3">Car 8:1-3</ref>
      </char>
    </note>Wuwiny, ryeko tye kalwongo i yoo gudogu; en kok ma lwongo lwongo i cuk ki dwone ma longo; <verse eid="PRO 1:20" /><verse number="21" style="v" sid="PRO 1:21" />en tye kalwongo matek ki iwi cel; wa i dog taun maditgu en bedo kalok aloka ni, <verse eid="PRO 1:21" /><verse number="22" style="v" sid="PRO 1:22" />“Wun jo ma luming, wumito wubed ming pi kare marom mene? Lucac mono gibibedo ki yomcwiny pi kare marom mene ki cacgini? Luming, wun mono wudag pwonye ma miyowu ngec? <verse eid="PRO 1:22" /><verse number="23" style="v" sid="PRO 1:23" />Wuwiny lok ma an awaco botwu; nen, abinyutu tama ducu botwu; abimiyo wungeyo loka. <verse eid="PRO 1:23" /><verse number="24" style="v" sid="PRO 1:24" />Abedo kalwongowu ni wubin, ento wun wukwero winyo lwongona; aryeyo cinga, ento pe tye ngat mo ma oketo iye cwinye. <verse eid="PRO 1:24" /><verse number="25" style="v" sid="PRO 1:25" />Wucayo tama ducu ma amiyo botwu, wun pe wuye ni ayubwu. <verse eid="PRO 1:25" /><verse number="26" style="v" sid="PRO 1:26" />Pimeno ka can opoto ikomwu an abinyerowu anyera; abingalowu bene angala ka gin makelo lworo opoto ikomwu ma obangowu woko. <verse eid="PRO 1:26" /><verse number="27" style="v" sid="PRO 1:27" />Ikare ma can man bibangowu woko macalo yamo me nam, can ma bene bino macalo yamo lapiru, en aye ikare meno wubibedo ki arem ki cwercwiny madwong. <verse eid="PRO 1:27" /><verse number="28" style="v" sid="PRO 1:28" />Ikare meno aye wubicako lwonga kwede, ento an pe abigamo dogwu; wubiyenya ki cwinywu ducu ento pe wubinonga. <verse eid="PRO 1:28" /><verse number="29" style="v" sid="PRO 1:29" />Wukwero ngec mamiyo wupwonye dok bene pe wuye lworo Rwot, <verse eid="PRO 1:29" /><verse number="30" style="v" sid="PRO 1:30" />pien wukwero winyo tama, dok wucayo yub ma mera pirwu woko. <verse eid="PRO 1:30" /><verse number="31" style="v" sid="PRO 1:31" />Pimeno wubikoko angee pi gin maracu ma wutimo dok wubikumu pi timwu maracu. <verse eid="PRO 1:31" /><verse number="32" style="v" sid="PRO 1:32" />Jo ma pe gitye ki ngec gito pien gikwero yenyo ryeko, kwero loko tam ma lumingo gitye kwede en aye tyekogi. <verse eid="PRO 1:32" /><verse number="33" style="v" sid="PRO 1:33" />Ento ngat ma biwinyo loka bibedo ma ocung matek; en bibedo ma pe lworo gin marac, labongo par mo.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1" />Latina, kace iketo loka i cwinyi, ma igwoko bene cika i tami, <verse eid="PRO 2:1" /><verse number="2" style="v" sid="PRO 2:2" />kun itero iti kawinyo lok me ryeko, dok iketo cwinyi bene me niang, <verse eid="PRO 2:2" /><verse number="3" style="v" sid="PRO 2:3" />kace ibako dogi pi yenyo ngec, dok i kok ki dwon malongo pi nongo niang, <verse eid="PRO 2:3" /><verse number="4" style="v" sid="PRO 2:4" />kace iyenyo macalo iyenyo lim ryal, kun iyenyo bene macalo itye kayenyo lonyo ma kikano; <verse eid="PRO 2:4" /><verse number="5" style="v" sid="PRO 2:5" />ka itimo meno, ci ibiniang ikit me lworo Rwot dok ibibedo ki ngec ikom Lubanga. <verse eid="PRO 2:5" /><verse number="6" style="v" sid="PRO 2:6" />Rwot aye mamiyo ryeko; ngec ki niang bene gia ki bote. <verse eid="PRO 2:6" /><verse number="7" style="v" sid="PRO 2:7" />En kano ryeko maber tutwal pi jo ma cwinygi atir; en kwot ma gwoko jo ma cwinygi leng, <verse eid="PRO 2:7" /><verse number="8" style="v" sid="PRO 2:8" />dok gwoko jo ma gitimo gin matye atir, gwoko bene jo ma gimiyo kwogi bote.<verse eid="PRO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 2:9" />Ka itimo kumeno, ci ibiniang gin matye atir, ma opore, dok maber, ci ibilubu yo matye atir keken. <verse eid="PRO 2:9" /><verse number="10" style="v" sid="PRO 2:10" />Pimeno cwinyi bipong ki ryeko, ki ngec ma ibilimo bimiyo ibedo ki yomcwiny. <verse eid="PRO 2:10" /><verse number="11" style="v" sid="PRO 2:11" />Ngec ma itye kwede bigwoki, niang maber bikuri; <verse eid="PRO 2:11" /><verse number="12" style="v" sid="PRO 2:12" />bilari ki i yo me gin marac, dok bilari ki i cing dano ma gikelo ayelayela, pi lok ma giwaco. <verse eid="PRO 2:12" /><verse number="13" style="v" sid="PRO 2:13" />Gin jo ma gibwoto bedo ki kwo matye atir, ma gimito wot i piny macol, <verse eid="PRO 2:13" /><verse number="14" style="v" sid="PRO 2:14" />kun cwinygi yom itimo gin marac dok ginongo yomcwinygi i gin marac makelo ayelayela: <verse eid="PRO 2:14" /><verse number="15" style="v" sid="PRO 2:15" />gin jo ma yogi ogom, dok kitgi pe atir, gimaro timo gin maracu.<verse eid="PRO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 2:16" />Ryeko bimiyo iloyo tam pa dako ma lakwele, ma nongo biti ki lok mapwot me ywayo tami. <verse eid="PRO 2:16" /><verse number="17" style="v" sid="PRO 2:17" />En dako ma bwoto cware ma onyome ka tinone, kun pe gwoko gicike ma okwonge kwede bot cware inyim Lubanga; <verse eid="PRO 2:17" /><verse number="18" style="v" sid="PRO 2:18" />ma ka idonyo i ode nongo itye kalubu yo me to, yo pa dakonu teri mere i lobo pa jo ma oto. <verse eid="PRO 2:18" /><verse number="19" style="v" sid="PRO 2:19" />Pe tye ngat mo ma donyo bote matwero nongo yone me dwogo cen, pe bene gitwero nongo yo ma tero dano i kwo. <verse eid="PRO 2:19" /><verse number="20" style="v" sid="PRO 2:20" />Pimeno myero inen ni ilubu yo pa jo ma kitgi beco, kun bene ilubu yo pa jo ma kitgi atir. <verse eid="PRO 2:20" /><verse number="21" style="v" sid="PRO 2:21" />Jo ma cwinygi atir gibibedo i lobo ki jo ma gin lugen ma pe gitye ki bal mo gibibedo iye matwal. <verse eid="PRO 2:21" /><verse number="22" style="v" sid="PRO 2:22" />Ento jo maracu kibityekogi woko ki i lobo meno, ki jo ma gungayo wang Rwot pi bal me nek bene kibiputugi macalo giputu doo.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">Miyo tam bot jo matino</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 3:1" />Latina, pe myero wii owil ikom pwony ma apwonyi kwede, ento gwok cika i cwinyi. <verse eid="PRO 3:1" /><verse number="2" style="v" sid="PRO 3:2" />Pwony ma mera ducu bimiyi irii i lobo pi kare malac, pi mwaka mapol, ki dok bimiyo ibedo ki kuc ki lonyo madwong. <verse eid="PRO 3:2" /><verse number="3" style="v" sid="PRO 3:3" />Pe ibwot ada ki gen ma itye kwede; twegi gubed inguti, dok icoogi i cwinyi macalo icoyo ikom got. <verse eid="PRO 3:3" /><verse number="4" style="v" sid="PRO 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3:4: </char><char style="xt" closed="false"><ref loc="LUK 2:52">Luk 2:52</ref></char></note>Kitmeno i binongo gum ki kit maber i wang Lubanga kacel ki iwang dano.<verse eid="PRO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 3:5" />Gen Rwot ki cwinyi ducu, pe ibed kajenge ikom niang ma itye kwede. <verse eid="PRO 3:5" /><verse number="6" style="v" sid="PRO 3:6" />I kit kwoni ducu wii myero opo ikom Rwot, ci en bitiro yo ma iwoto iye bedo atir. <verse eid="PRO 3:6" /><verse number="7" style="v" sid="PRO 3:7" /><note caller="-" style="x"><char style="xo" closed="false">3:7: </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rom 12:16</ref></char></note>Pe myero ibed katamo kekeni ni i ryek; lwor Rwot, ci iloke iwek timo gin marac. <verse eid="PRO 3:7" /><verse number="8" style="v" sid="PRO 3:8" />Ka itimo kumeno, ci bibedo yat ma bicango two ki ikomi, dok bikweyo komi. <verse eid="PRO 3:8" /><verse number="9" style="v" sid="PRO 3:9" />Wor Rwot ki lonyoni ma itye kwede ducu, dok ityer cam mukwongo cek i potoni me wi mwaka; <verse eid="PRO 3:9" /><verse number="10" style="v" sid="PRO 3:10" />ci deroni bipong ki cam madwong, ki kongo bwinoni bipongo opoko mapol ata.<verse eid="PRO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:17">Yub 5:17</ref>
      </char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:5-6">Ibru 12:5-6</ref>
      </char>
    </note> Latina, pe myero i caa juk pa Rwot, myero imak lok ma en yubi kwede macalo lok me poyo wii, <verse eid="PRO 3:11" /><verse number="12" style="v" sid="PRO 3:12" /><note caller="-" style="x"><char style="xo" closed="false">3:12: </char><char style="xt" closed="false"><ref loc="REV 3:19">Niy 3:19</ref></char></note>pien Rwot pwonyo dok yubu ngat ma en maro, en tye macalo wego ma pwodo latin ma cwinye maro adada. <verse eid="PRO 3:12" /><verse number="13" style="v" sid="PRO 3:13" />Dano ma dong onongo ryeko tye ki yomcwiny, ki dano ma dong olimo niang matut bedo kitmeno, <verse eid="PRO 3:13" /><verse number="14" style="v" sid="PRO 3:14" />pien kelo gin maber makato lonyo me ryal, ki magoba me lonyone bene kato me jabu. <verse eid="PRO 3:14" /><verse number="15" style="v" sid="PRO 3:15" />Ryeko ber kato jami me welgu, pe tye gin mo ma imito ma ki twero poro kwede. <verse eid="PRO 3:15" /><verse number="16" style="v" sid="PRO 3:16" />Ryeko tye ki kwo ma rii nakanaka i cinge tung acuc; lonyo kacel ki deyo gitye i cinge tung acam. <verse eid="PRO 3:16" /><verse number="17" style="v" sid="PRO 3:17" />Yone yo mamiyo yomcwiny madwong, ka iwoto i yone ducu inongo kuc keken. <verse eid="PRO 3:17" /><verse number="18" style="v" sid="PRO 3:18" />Ryeko tye macalo yat me kwo bot jo ma gumako matek liking; jo ma gumake matek liking kilwongogi ni jo ma cwinygi yom.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Rwot ocweyo lobo ki ryekone;</para>
  <para style="q1" vid="PRO 3:19">dok pi ngece omiyo en oketo polo i kabedone.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Pii matye ite lobo gunye pi ngece,</para>
  <para style="q1" vid="PRO 3:20">ki pol miyo kot cwer bino piny i lobo.<verse eid="PRO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 3:21" />Latina, gwok ryekoni kacel ki niang matut ma itye kwede; pe iwek gurweny woko ki iwangi. <verse eid="PRO 3:21" /><verse number="22" style="v" sid="PRO 3:22" />Gibimiyo ibedo ki kwo i cwinyi, dok gibibedo macalo gin mo ma iruku inguti me deyo. <verse eid="PRO 3:22" /><verse number="23" style="v" sid="PRO 3:23" />Man bimiyo kwoni bibedo maber ma pe i paro gin mo, wa gin mo ma kelo adwala inyimi bene bibedo peke. <verse eid="PRO 3:23" /><verse number="24" style="v" sid="PRO 3:24" />Kace ibedo piny, pe ibilworo gin mo liweng; ka dong ibutu piny, ci ibinino nino mamit atika. <verse eid="PRO 3:24" /><verse number="25" style="v" sid="PRO 3:25" />Pe ibibedo ki par mo ka ineno can opoto ikom jo maracu macalo yamo kot, kadi bed ka can opoto ikom jo maracu otyekogi woko liweng. <verse eid="PRO 3:25" /><verse number="26" style="v" sid="PRO 3:26" />Pien Rwot aye bibedo ngat ma igeno; dok en bigwoki, miyo owic pe mako tyeni. <verse eid="PRO 3:26" /><verse number="27" style="v" sid="PRO 3:27" />Pe ikwer tiyo gin maber bot dano ma mito ni ikonye, ma nongo itye ki twero me tiyone. <verse eid="PRO 3:27" /><verse number="28" style="v" sid="PRO 3:28" />Pe iwac ki lawoti ni, “Kong icit, ka dok idwog lacen,” makun nongo itwero konye icawa meno kikome. <verse eid="PRO 3:28" /><verse number="29" style="v" sid="PRO 3:29" />Pe myero ipir lok me timo gin marac ikom lawoti, ma kun nongo en bedo ki gen ikomi nino ducu. <verse eid="PRO 3:29" /><verse number="30" style="v" sid="PRO 3:30" />Pe myero ipyem ki dano mo labongo tyen lok mo, makun nongo en pe otimo gin mo marac ikomi. <verse eid="PRO 3:30" /><verse number="31" style="v" sid="PRO 3:31" />Pe iwek nyeko omaki ikom jo ma gin lubwami, dok pe ilub kitgi mo kadi ki acel; <verse eid="PRO 3:31" /><verse number="32" style="v" sid="PRO 3:32" />pien Rwot dag jo ma gitimo gin marac akaka, ento en tye ki gen ikom jo ma kitgi atir. <verse eid="PRO 3:32" /><verse number="33" style="v" sid="PRO 3:33" />Rwot ceno gangi pa jo maracu, ento en miyo gum ikom gangi pa jo ma kitgi atir. <verse eid="PRO 3:33" /><verse number="34" style="v" sid="PRO 3:34" /><note caller="-" style="x"><char style="xo" closed="false">3:34: </char><char style="xt" closed="false"><ref loc="REV 4:6">Niy 4:6</ref>; <ref loc="1PE 5:5">1 Pet 5:5</ref></char></note>Rwot cayo jo ma lungala, en nyutu kicane bot jo ma mwol. <verse eid="PRO 3:34" /><verse number="35" style="v" sid="PRO 3:35" />Jo ma gin luryeko kiketo deyo madit ikomgi, ento luming ginongo meggi can keken.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Gin maber ma ryeko kelo</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 4:1" />Lutino, wuwiny pwony ma wonwu pwonyowu kwede, wuket cwinywu kawinyone, miyo wubibedo ki niang matut. <verse eid="PRO 4:1" /><verse number="2" style="v" sid="PRO 4:2" />Gin ma atye kapwonyowu kwede en gin maber mada; pe myero wubwot, ento wiwu opo iye. <verse eid="PRO 4:2" /><verse number="3" style="v" sid="PRO 4:3" />Ikare ma onongo an pud latin matidi, ma pud abedo latin acel keken bot maa, <verse eid="PRO 4:3" /><verse number="4" style="v" sid="PRO 4:4" />wora obedo kapwonya, kun waca ni, “Ket lok ma apwonyi kwedegu ducu i cwinyi; lub cika wek ibed kwo. <verse eid="PRO 4:4" /><verse number="5" style="v" sid="PRO 4:5" />Wii pe owil, dok bene pe myero ibwot lok ma apwonyi kwede. Nong ryeko kacel ki niang matut. <verse eid="PRO 4:5" /><verse number="6" style="v" sid="PRO 4:6" />Myero imar ryeko, pe ikwer; pien en bigwoki miyo ibedo maber labongo ayela mo. <verse eid="PRO 4:6" /><verse number="7" style="v" sid="PRO 4:7" />Kit ma itwero doko ryek kwede ene: Nong ryeko, ket cwinyi wek ibed ki cwiny me niang makato jami mukene ducu. <verse eid="PRO 4:7" /><verse number="8" style="v" sid="PRO 4:8" />Mar ryeko, ci en bimiyo idoko dit; kace imako maber, ci bimiyo kiwori. <verse eid="PRO 4:8" /><verse number="9" style="v" sid="PRO 4:9" />Ryeko bikelo deyo boti, bimiyo dano giwori.”<verse eid="PRO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 4:10" />Latina, kong iwiny loka dok iket bene i cwinyi, ci ibirii i lobo pi mwaka mapol. <verse eid="PRO 4:10" /><verse number="11" style="v" sid="PRO 4:11" />Dong atyeko pwonyi ki yo me ryeko, atyeko nyutu boti bene kit yo me bedo ki kwo matye atir. <verse eid="PRO 4:11" /><verse number="12" style="v" sid="PRO 4:12" />Gin mo pe ma biriine inyimi kace itye kawot ki ryeko; ka ibingwec, ci pe ibitwome atata. <verse eid="PRO 4:12" /><verse number="13" style="v" sid="PRO 4:13" />Mak pwony ma kimiyo ki in matek, pe iwek obwoti; gwok maber, pien meno aye kwoni. <verse eid="PRO 4:13" /><verse number="14" style="v" sid="PRO 4:14" />Pe ilub yo pa jo maracu, pe ilub kit kwo pa jo ma gin lutim maracu. <verse eid="PRO 4:14" /><verse number="15" style="v" sid="PRO 4:15" />Gwoke, pe iwot ki i yogi; loke iwek timo gin marac, ci iwot meri anyim. <verse eid="PRO 4:15" /><verse number="16" style="v" sid="PRO 4:16" />Jo maracu pe gitwero nino ka peya gutimo tim marac; dok pe gitwero nino kace peya gumiyo dano mo opoto i can. <verse eid="PRO 4:16" /><verse number="17" style="v" sid="PRO 4:17" />Timo tim maracu odoko calo cam ki botgi ki timo bwami bene odoko calo kongo bwino ma gimatoni. <verse eid="PRO 4:17" /><verse number="18" style="v" sid="PRO 4:18" />Ento kit kwo pa jo ma kitgi atir obedo calo dero me rupiny, maryeny nio wang ma piny dong leng. <verse eid="PRO 4:18" /><verse number="19" style="v" sid="PRO 4:19" />Kit kwo pa jo maracu col calo dyewor; ka gupoto bene ci pe giniang gin ma nongo oyokogi.<verse eid="PRO 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 4:20" />Latina, ket cwinyi i loka; winy gin ma an awaco. <verse eid="PRO 4:20" /><verse number="21" style="v" sid="PRO 4:21" />Pe myero iwek orweny woko ki boti; myero igwok i cwinyi. <verse eid="PRO 4:21" /><verse number="22" style="v" sid="PRO 4:22" />Lok magi gimiyo kwo bot ngat ma owinyogi, dok cango two ma ikome woko ducu. <verse eid="PRO 4:22" /><verse number="23" style="v" sid="PRO 4:23" />Gwoke ikom tam ma itamo ki i cwinyi ducu; pien kwoni ducu a ki i lok ma i cwinyi. <verse eid="PRO 4:23" /><verse number="24" style="v" sid="PRO 4:24" />Pe myero ibed kaloko lok mugom, wek loko lok goba bene obedi. <verse eid="PRO 4:24" /><verse number="25" style="v" sid="PRO 4:25" />Myero inen anyim atir, dok icik wangi me neno jami ducu matye anyim. <verse eid="PRO 4:25" /><verse number="26" style="v" sid="PRO 4:26" /><note caller="-" style="x"><char style="xo" closed="false">4:26: </char><char style="xt" closed="false"><ref loc="HEB 12:13">Ibru 12:13</ref></char></note>Myero ingii gin ma ilubu, ci bimiyo gin ma itiyo ducu bedo atir. <verse eid="PRO 4:26" /><verse number="27" style="v" sid="PRO 4:27" />Pe ingak idok tung acuc nyo tung acam; loke, pe i mar timo gin marac.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Lok me juku tim me abor</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 5:1" />Latina, ket cwinyi kawinyo lok me ryekona, cik iti bene kawinyo kit ma nianga tye kwede. <verse eid="PRO 5:1" /><verse number="2" style="v" sid="PRO 5:2" />Miyo ibingeyo kit kwo ma mite, dok lok ducu ma ibiloko binyutu ada ni kara i tye ki ngec. <verse eid="PRO 5:2" /><verse number="3" style="v" sid="PRO 5:3" />Dako ma lakwele mere kite enu, lok doge lim calo kic, nongo loke bene pwot kato moo woko; <verse eid="PRO 5:3" /><verse number="4" style="v" sid="PRO 5:4" />ento i agikine inongo doko kec macalo yat roka, ma nongo bit ryoryo calo pala lucwan. <verse eid="PRO 5:4" /><verse number="5" style="v" sid="PRO 5:5" />Dakonu biteri wa i lyel; yo ma en woto ki iye cito i to keken. <verse eid="PRO 5:5" /><verse number="6" style="v" sid="PRO 5:6" />En pe tye kalubu yo matero dano ikwo; tye kacabe atata ki kwone pe ngeyo gin matye katime.<verse eid="PRO 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 5:7" />Latina, kombedi dong iwiny loka; pe myero iwek, dok wi pe owil ilok ma awaco. <verse eid="PRO 5:7" /><verse number="8" style="v" sid="PRO 5:8" />Pe icit bot dako ma lakweleni, pe icit cok ki dogolane. <verse eid="PRO 5:8" /><verse number="9" style="v" sid="PRO 5:9" />Ka icito bote, ci woro mayam kimiyo boti bidoko pa jo mukene, dok jo ma pe gin lukica gibineki woko ma nongo mwaka me toni peya oromo. <verse eid="PRO 5:9" /><verse number="10" style="v" sid="PRO 5:10" />Ji ata gibiyako lonyoni woko ducu, gin ma ibedo katic pire matek larok bitero woko ducu. <verse eid="PRO 5:10" /><verse number="11" style="v" sid="PRO 5:11" />Meno bimiyo icur ikare ma nongo dong icok to, ma nongo ringo komi kacel ki cogoni gibijunge woko. <verse eid="PRO 5:11" /><verse number="12" style="v" sid="PRO 5:12" />Dong i biwaco ni, “Pingo akwero winyo lok me pwony, dok abedo kacayo lok me juk ki i cwinya? <verse eid="PRO 5:12" /><verse number="13" style="v" sid="PRO 5:13" />Pe abedo kawinyo lok ma lupwonya gubedo ka pwonya kwede, ada pe awinyo lokgi. <verse eid="PRO 5:13" /><verse number="14" style="v" sid="PRO 5:14" />Cutcut anongo ni nyinga dong obale woko, dok lwak ma gucoke ducu gicayo an acaya.”<verse eid="PRO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 5:15" />Mat pii ma a ki iwang it ma meri kikome, ki pii ma mol bene ma a ki iwang it ma meri kikome. <verse eid="PRO 5:15" /><verse number="16" style="v" sid="PRO 5:16" />Pe myero iwek pii matye iwang it ma meri ducu omol oket woko ata, ma piine mol pong wa i yogu ducu. <verse eid="PRO 5:16" /><verse number="17" style="v" sid="PRO 5:17" />Wek piine obed meri keken me konyi, ento pe obed me konyo ji ata. <verse eid="PRO 5:17" /><verse number="18" style="v" sid="PRO 5:18" />Gum obed ikom dakoni ma inyomo ka tinoni ma en wang it ma meri, dok cwinyi myero obed yom ikome, <verse eid="PRO 5:18" /><verse number="19" style="v" sid="PRO 5:19" />en dako manen mwonya mada, ma yomo cwinyi atika. Nen bere wek oyom cwinyi ikare ducu, kare ducu wek mar mere oloo kwoni. <verse eid="PRO 5:19" /><verse number="20" style="v" sid="PRO 5:20" />Latina, pingo imiyo ki bwoli kun i maro dako ma malaya? Pingo ikwako kor dako ma lakwele? <verse eid="PRO 5:20" /><verse number="21" style="v" sid="PRO 5:21" />Rwot ngeyo kit kwo pa dano acel acel, dok neno kama en cito iye ducu. <verse eid="PRO 5:21" /><verse number="22" style="v" sid="PRO 5:22" />Bal pa ngat marac tye macalo owic ma mako tyene, bal ma en timoni aye mako en. <verse eid="PRO 5:22" /><verse number="23" style="v" sid="PRO 5:23" />En to pien pe twero juke kene, dong en rwenyo woko ki mingo madit ma en tye kwede.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Lok me juk mukene</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 6:1" />Latina, ka in iye me cung pi lawoti, dok ka ijengo jamini pi dano mo ata, <verse eid="PRO 6:1" /><verse number="2" style="v" sid="PRO 6:2" />ci nongo loki ma ilokoni odoko owic piri, pien nongo kimako lok ki idogi. <verse eid="PRO 6:2" /><verse number="3" style="v" sid="PRO 6:3" />Pimeno latina, tim kuman, ci ibilaro kwoni; cit oyotoyot ibak dogi bote, pien kombedi dong i poto i cing lawoti. <verse eid="PRO 6:3" /><verse number="4" style="v" sid="PRO 6:4" />Pe myero inin, pe myero iwek nino bene omak wangi ma miyi yweyo matek; <verse eid="PRO 6:4" /><verse number="5" style="v" sid="PRO 6:5" />lar komi macalo til ma ringo laro kome ki bot ladwar, macalo winyo ma tuk woko ki i owic pa ladwar.<verse eid="PRO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 6:6" />In lawackom, nen kit ma nginingini tiyo kwede; mito kong ibed ki ryeko me neno kitgi. <verse eid="PRO 6:6" /><verse number="7" style="v" sid="PRO 6:7" />Pe gitye ki rwot mo, kadi ladit nyo laloc mo; <verse eid="PRO 6:7" /><verse number="8" style="v" sid="PRO 6:8" />ento giyubu cam me akana ikare me oro, dok gicoko wit cam mapatpat ikare me kac. <verse eid="PRO 6:8" /><verse number="9" style="v" sid="PRO 6:9" />In lawackom mono, ibibedo kabutu abuta pi kare marom mene? Ibico awene ki iwang nino? <verse eid="PRO 6:9" /><verse number="10" style="v" sid="PRO 6:10" /><note caller="-" style="x"><char style="xo" closed="false">6:10: </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">Car 24:33-34</ref></char></note>En waco ni, “Kong abut anin manok, dok adol cinga woko me miya yweyo.” <verse eid="PRO 6:10" /><verse number="11" style="v" sid="PRO 6:11" />Ento man bimiyo can maki kit macalo layak mako kwede dano, ma nongo oruke woko ki jami lweny.<verse eid="PRO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 6:12" />Dano marac, ma konye peke, woto mere atata ki lok me bwola keken, <verse eid="PRO 6:12" /><verse number="13" style="v" sid="PRO 6:13" />kun gayo dano ki wange, dok gwelo ki tyene, ka dong cimo piny atata, <verse eid="PRO 6:13" /><verse number="14" style="v" sid="PRO 6:14" />ma nongo en tye ki cwiny mungak mupong ki tam maracu keken, dok miyo en tubu dano teretere. <verse eid="PRO 6:14" /><verse number="15" style="v" sid="PRO 6:15" />Pimeno can bipoto ikome atura; pi kare manok keken ret bimake ma pe dong bicang.<verse eid="PRO 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 6:16" />Rwot dag jami maromo abicel, tye jami abiro kulu ma gin ducu gin me kwer ki tung bote: <verse eid="PRO 6:16" /><verse number="17" style="v" sid="PRO 6:17" />en dag dano ma tamo ni eryek pire kene, ma loko lok goba, en bene dag jo ma gioyo remo pa jo ma peke ki bal. <verse eid="PRO 6:17" /><verse number="18" style="v" sid="PRO 6:18" />Rwot dag dano ma cwinye opong ki yub me timo gin marac, ki jo ma giringo oyotoyot katiyo gin marac. <verse eid="PRO 6:18" /><verse number="19" style="v" sid="PRO 6:19" />En dag bene caden ma loko lok goba, ki ngat ma tubu omegine.<verse eid="PRO 6:19" /></para>
  <para style="s1">Lok ma juku timo abor</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20" />Latina, myero ilub gin ma woru otito boti, dok pe ibwot pwony pa meni. <verse eid="PRO 6:20" /><verse number="21" style="v" sid="PRO 6:21" />Ket lok magi ducu i cwinyi kare ducu; gwok lok magi macalo igwoko gin mo ma itweyo inguti. <verse eid="PRO 6:21" /><verse number="22" style="v" sid="PRO 6:22" />Lok magi gibiteli i woti; kadi ka ibutu piny bene gin bikuri ikom gin marac; dok ka ico ki iwang nino gibipwonyi kit ma myero ibed kwede. <verse eid="PRO 6:22" /><verse number="23" style="v" sid="PRO 6:23" />Cik tye macalo tara, ki pwony bene tye macalo ceng maryeny, dong pwony me yubu kit pa dano en aye yo me kwo. <verse eid="PRO 6:23" /><verse number="24" style="v" sid="PRO 6:24" />Lok magi bimiyo igwoke ma pe ibedo ki mon maracu, kun gwoki bene ki ilok me bita pa mon ma gin lukwele. <verse eid="PRO 6:24" /><verse number="25" style="v" sid="PRO 6:25" />Pe myero cwinyi opar pi bereni, dok pe iwek wange ma en neni kwede oywa tami. <verse eid="PRO 6:25" /><verse number="26" style="v" sid="PRO 6:26" />Laco mo keken twero wilo dako ma lakwele ki mugati acel ci bedo kwede, ento tim me abor twero balo kwo pa laco mabedo ki dako pa ngat mukene. <verse eid="PRO 6:26" /><verse number="27" style="v" sid="PRO 6:27" />Itamoni dano twero kwanyo mac keto ikore, ci mac pe wango bongone woko? <verse eid="PRO 6:27" /><verse number="28" style="v" sid="PRO 6:28" />Anga matwero wot i lodi mac ma tyene pe biwang woko? <verse eid="PRO 6:28" /><verse number="29" style="v" sid="PRO 6:29" />Ngat ma cito bedo ki dako pa lawote bene limo can kitmeno; pe tye ngat mo ma bwot ma pe kiketo can ikome, ka obutu ki dako pa lawote. <verse eid="PRO 6:29" /><verse number="30" style="v" sid="PRO 6:30" />Dano pe gicayo lakwo ka okwalo cam ma nongo kec neke kun mito eyeng. <verse eid="PRO 6:30" /><verse number="31" style="v" sid="PRO 6:31" />Kace kimako en lakwo meno, en biculu cul maromo wang abiro kulu; dok bimiyo jami ma i ode woko ducu pi cul. <verse eid="PRO 6:31" /><verse number="32" style="v" sid="PRO 6:32" />Dano ma timo abor nongo pe ryek; ngat ma tiyo gin macalo meno nongo tye kaneke kene. <verse eid="PRO 6:32" /><verse number="33" style="v" sid="PRO 6:33" />Dano gibiketo ret ikome dok gibicaye, dok cwercwiny me can ma en bilimo pe biwany ki i cwinye. <verse eid="PRO 6:33" /><verse number="34" style="v" sid="PRO 6:34" />Laco matye ki nyeko pi dakone bedo ki kiniga madwong, ma ka oero lweny ci neko dano cut, nongo pe ye juk. <verse eid="PRO 6:34" /><verse number="35" style="v" sid="PRO 6:35" />En pe biye kit cul mo kadi ki acel, dok kadi kimito wile ki lwak mot mapol, magi ducu pe twero juku kinigane.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1" />Latina, mak loka, dok ikan gin ma an aciki kwede ducu macalo lonyo madit. <verse eid="PRO 7:1" /><verse number="2" style="v" sid="PRO 7:2" />Lub cika wek ibed kwo, gwok lok ma apwonyi kwede kit macalo igwoko kwede wangi. <verse eid="PRO 7:2" /><verse number="3" style="v" sid="PRO 7:3" />Gwokgi maber kare ducu, coogi woko ducu i cwinyi. <verse eid="PRO 7:3" /><verse number="4" style="v" sid="PRO 7:4" />Myero iwac ki ryeko ni, “In lamera,” ki niang matut bene myero ilwong ni laremi ma imaro adada. <verse eid="PRO 7:4" /><verse number="5" style="v" sid="PRO 7:5" />Man bigwoki wek pe ibed ki tam ikom mon pa jo mukene, bimiyo iloyo tam pa dako ma lakwele, kadi bed loko lok mamit calo ango.<verse eid="PRO 7:5" /></para>
  <para style="s1">Dako ma lakwele</para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 7:6" />Ikare ma ayabo wang dirica me oda, ci aneno piny wa ki iwang dirica me kicikana. <verse eid="PRO 7:6" /><verse number="7" style="v" sid="PRO 7:7" />Aneno lwak jo matino ma pe gitye ki ngec mo wa ki acel; aneno ikin jo magi matino, awobi mo ma laming atika. <verse eid="PRO 7:7" /><verse number="8" style="v" sid="PRO 7:8" />En obedo kawot ki i yoo kun kato ki itwok ot pa dako ma lakwele, kun lubu yoo ma cito i ot pa dako meno, <verse eid="PRO 7:8" /><verse number="9" style="v" sid="PRO 7:9" />wi otyeno, ma piny anga katoni, idyewor ma onongo piny dong col. <verse eid="PRO 7:9" /><verse number="10" style="v" sid="PRO 7:10" />Nen, dako mo orwate kwede, ma oruke calo lakwele kikome ma cwinye opong ki lok me bwola. <verse eid="PRO 7:10" /><verse number="11" style="v" sid="PRO 7:11" />En dano ma lewic pe make, lawot ata, kome pe ye bedo gang kacel; <verse eid="PRO 7:11" /><verse number="12" style="v" sid="PRO 7:12" />ka pud ineno tye kawot i gudu koni dok i neno nongo opile wa i cuk, itwok yoo ducu butu kuru piny. <verse eid="PRO 7:12" /><verse number="13" style="v" sid="PRO 7:13" />En oneno laco ci omwome omake woko liking, onoto leme, kun neno wange atir labongo lewic mo, ka owace ni, <verse eid="PRO 7:13" /><verse number="14" style="v" sid="PRO 7:14" />“Atyeko tyero gitum tin, dok tin acobo kwonga; <verse eid="PRO 7:14" /><verse number="15" style="v" sid="PRO 7:15" />kombedi an abino karwate kwedi, ayenyi ki cwinya ducu, ci dong anongi woko. <verse eid="PRO 7:15" /><verse number="16" style="v" sid="PRO 7:16" />Atyeko peto cuka iwi kitandana, bongo cuka ma rangigi patpat ma kikelogi ki i Ejipt; <verse eid="PRO 7:16" /><verse number="17" style="v" sid="PRO 7:17" />dok atyeko kiro moo mura ikom kitandana, akiro bene moo ma ngwece kur ki cinamon mamit. <verse eid="PRO 7:17" /><verse number="18" style="v" sid="PRO 7:18" />Bin, wek wabut kacel nio odiko ki mar keken; wek wabed ki yomcwiny pi mar ma watye kwede. <verse eid="PRO 7:18" /><verse number="19" style="v" sid="PRO 7:19" />Cwara tin peke paco; ocito woko welo iwot mabor. <verse eid="PRO 7:19" /><verse number="20" style="v" sid="PRO 7:20" />Omako lim ki kicaane ducu ocito kwede; en bidwogo paco kany ka dwe ogudu got.” <verse eid="PRO 7:20" /><verse number="21" style="v" sid="PRO 7:21" />Dakonu obedo kabito nyeri ki lwak lok gobagoba mapol ata; olo twal odiyo laco meno ki loke mapwoti. <verse eid="PRO 7:21" /><verse number="22" style="v" sid="PRO 7:22" />Cutcut nyeri otugi lubu kor dakonu, calo twon ma kipeyo kitero kanekone, <verse eid="PRO 7:22" /><verse number="23" style="v" sid="PRO 7:23" />nyo macalo til ma omoko i owic, nio ka atero ocelo cin iye otucu woko pil. Bedo calo winyo ma ringo laro i owic; en pe ngeyoni tim macalo meno bimiyo erwenyo kwone kulu.<verse eid="PRO 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 7:24" />Kombedi wun lutino, wuwiny loka, wucik itwu maber kawinyo lok ducu ma kati ki idoga. <verse eid="PRO 7:24" /><verse number="25" style="v" sid="PRO 7:25" />Pe myero iwek cwinyi obiti me lubu kit kwo pa dakonu, pe ingak ilub kore. <verse eid="PRO 7:25" /><verse number="26" style="v" sid="PRO 7:26" />Dakonu oneko lwak co mapol ata; ada, jo ma en onekogi welgi pe kwane. <verse eid="PRO 7:26" /><verse number="27" style="v" sid="PRO 7:27" />Ode ma en bedo iyeni meno mere lyel, meno aye yoo ma tero dano i to.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Pak pi Ryeko</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:20-21">Car 1:20-21</ref>
      </char>
    </note>Pe wutye kawinyo ka ryeko dange matek,</para>
  <para style="q1" vid="PRO 8:1">ki niang matut bene mito ni ki winy dwone?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Iwi cere ducu ma inget yoo</para>
  <para style="q1" vid="PRO 8:2">nongo en ocung i angakangaka yoogu ducu.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Idog cel ma kidonyo kwede i gang,</para>
  <para style="q1" vid="PRO 8:3">en tye kadange ki idog gang matek tutwal ni,<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“Wuwiny, atye kalwongo dano,</para>
  <para style="q1" vid="PRO 8:4">lwongonani tye pi jo ducu.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Wun jo ma pe wungeyo gin mo, wunong pwony wek wudok calo jo ma dong gutegi;</para>
  <para style="q1" vid="PRO 8:5">wun luming bene wuket cwinywu me niang.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Wuwiny, pien gin ma abititoni obedo lok mabeco,</para>
  <para style="q1" vid="PRO 8:6">dok lok ducu ma abiloko bibedo lok atir;<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />pien abiloko ada keken;</para>
  <para style="q1" vid="PRO 8:7">gin marac pe bikati ki idoga,</para>
  <para style="q1" vid="PRO 8:7">pien bedo me kwer ki tung bota.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Lok ducu ma awaco tye atir;</para>
  <para style="q1" vid="PRO 8:8">pe tye mo ma kidwalo tere nyo ma ogom i loka.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Loka ducu tye atir bot ngat matwero niang,</para>
  <para style="q1" vid="PRO 8:9">dok winye maber bot jo ma gitye ki ngec ma oromo.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Wumak pwony ma apwonyowu kwede maka kwanyo lim,</para>
  <para style="q1" vid="PRO 8:10">dok wugam ngec maka kwanyo lonyo.<verse eid="PRO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Ryeko ber makato jami me welgu,</para>
  <para style="q1" vid="PRO 8:11">kadi ki jami mukene ducu ma cwinywu maro pe kiromo poro kwede.<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />An ryeko, atye ki tam matut,</para>
  <para style="q1" vid="PRO 8:12">dok alimo ngec ki tam maber me moko lok.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Ngat ma lworo Lubanga pe tiyo gin marac.</para>
  <para style="q1" vid="PRO 8:13">Wake ki nyate ki yo me tiyo gin marac</para>
  <para style="q1" vid="PRO 8:13">ki lok ducu ma kidwalo tere ma pe tye atir ducu cwinya daggi.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Atye ki twero me miyo tam ki me keto yub ducu i tic,</para>
  <para style="q1" vid="PRO 8:14">atye ki niang matut dok atek.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Luker ducu giloyo loc pi twerona,</para>
  <para style="q1" vid="PRO 8:15">dok pira miyo luloc giketo cik matye atir.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Rwodi ma giloyo lobo giloyo pi kony mera,</para>
  <para style="q1" vid="PRO 8:16">ki ludito ducu ma giloyo lobo bene kitmeno.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />An amaro jo ma gimara,</para>
  <para style="q1" vid="PRO 8:17">jo ma gibedo kayenyo an ki cwinygi ducu bene gibinonga.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Atye ki lonyo kacel ki deyo,</para>
  <para style="q1" vid="PRO 8:18">lonyo ma rii, ki kwo maber, ma abimiyo botgi.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Gin ma amiyo botwu ber kato jabu,</para>
  <para style="q1" vid="PRO 8:19">kato kadi wa jabu mabere,</para>
  <para style="q1" vid="PRO 8:19">dok gin ma wulimo ki bota kato ryal ma kiliyo maber.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Alubu kit matye atir,</para>
  <para style="q1" vid="PRO 8:20">en aye yo me ngolo kop kakare;<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />amiyo lonyo bot jo ma gimara,</para>
  <para style="q1" vid="PRO 8:21">dok apongo odi me kano limgi ki lim madwong.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:22: </char>
      <char style="xt" closed="false">
        <ref loc="REV 3:14">Niy 3:14</ref>
      </char>
    </note>Rwot ocweyo an ryeko macalo acaki tice,</para>
  <para style="q1" vid="PRO 8:22">man aye obedo tice ma en otiyo ikare macon tutwal.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Ikare meno macon kicweyo an kena,</para>
  <para style="q1" vid="PRO 8:23">i acaki piny kikome ma peya kicweyo lobo.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Kinywala ma onongo nam maditogu bene pud gipeke,</para>
  <para style="q1" vid="PRO 8:24">dok wangit ducu bene onongo piine pud pe gunye ma kati woko.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Kinywala ma onongo godi ducu pud pe ginen,</para>
  <para style="q1" vid="PRO 8:25">ki ceregu bene onongo pud gipeke;<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />ma pud peya Lubanga ocweyo lobo ki poti ducu matye iye,</para>
  <para style="q1" vid="PRO 8:26">kadi ki apwa me ngom ma okwongo nen.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Ikare ma en ocweyo polo onongo an dong atye,</para>
  <para style="q1" vid="PRO 8:27">ikare ma Rwot oketo agiki obedo tye idye nam madongogu,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />ikare ma en omiyo polo ocung i kabedone malo,</para>
  <para style="q1" vid="PRO 8:28">ka dok omiyo wang pii me nam madongo gucako gunye.<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />Ikare ma en oketo kama nam myero ogik iye,</para>
  <para style="q1" vid="PRO 8:29">wek pii pe omol oket woko ata miyo balo gin ma en oloko,</para>
  <para style="q1" vid="PRO 8:29">ikare ma en oketo guti me te lobo ducu,<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />an onongo atye, abedo kangete macalo ladiro tic.</para>
  <para style="q1" vid="PRO 8:30">Dok cwinye obedo yom kare ducu pi an,</para>
  <para style="q1" vid="PRO 8:30">an abedo ki yomcwiny madwong mada inyime;<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />ma cwinya okwe pi bedo i lobo ma en ocweyoni,</para>
  <para style="q1" vid="PRO 8:31">dok cwinya obedo yom ikom lutino pa dano.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />Lutinona, kombedi wuwiny loka;</para>
  <para style="q1" vid="PRO 8:32">jo ma gitiyo gin ma awaco botgi aye gibedo ki yomcwiny.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Wuwiny pwonya dok wubed maryek,</para>
  <para style="q1" vid="PRO 8:33">pe myero wubwot pwonye ata.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Dano ma winyo loka bedo ki yomcwiny,</para>
  <para style="q1" vid="PRO 8:34">en dano ma bedo idog ganga nino ducu,</para>
  <para style="q1" vid="PRO 8:34">makura idogola me ganga.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Ngat ma onongo an meno onongo kwo,</para>
  <para style="q1" vid="PRO 8:35">ci Rwot bibedo ki yomcwiny ikome;<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />ento ngat ma pe onongo an biketo ret ikome kekene;</para>
  <para style="q1" vid="PRO 8:36">ki jo ducu ma gidaga nongo gimaro to.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Ryeko ki Mingo</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1" />Ryeko ogero ode, ci opayo wir abiro ocibo iye. <verse eid="PRO 9:1" /><verse number="2" style="v" sid="PRO 9:2" />En oneko lee pi karama me donyo iye, oonyo kongo bwinone, dok oyubu jami ducu oketo iwi meja. <verse eid="PRO 9:2" /><verse number="3" style="v" sid="PRO 9:3" />Dong ocwalo angecane ma gucito kalwongo dano ki i kabedo matye malo tutwal ma i gang madit, kun giwaco ni, <verse eid="PRO 9:3" /><verse number="4" style="v" sid="PRO 9:4" />“Wubin kany, wun jo ma pe wutye ki ngec!” Ki bot ngat ma wiye oding en waco ni, <verse eid="PRO 9:4" /><verse number="5" style="v" sid="PRO 9:5" />“Bin wucam kwona, dok wumat kongo bwino ma aonyoni. <verse eid="PRO 9:5" /><verse number="6" style="v" sid="PRO 9:6" />Wuwek kwiyapiny obedi, ci wubibedo kwo, dok bene wubibedo ki niang matut.”<verse eid="PRO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 9:7" />Dano ma mito ni ejuk langala, langala nywaro woko anywara, ki ngat ma mito ni ejuk latim marac, ci latim marac dok keto ret ikome. <verse eid="PRO 9:7" /><verse number="8" style="v" sid="PRO 9:8" />Pe myero ijuk ngat ma langala, pien miyo bikweri woko; juk dano maryek, ci bimari. <verse eid="PRO 9:8" /><verse number="9" style="v" sid="PRO 9:9" />Pwony dano maryek, ci ryekone bimede ameda; pwony dano ma kite tye atir ci en bimede ameda ki pwony meno. <verse eid="PRO 9:9" /><verse number="10" style="v" sid="PRO 9:10" /><note caller="-" style="x"><char style="xo" closed="false">9:10: </char><char style="xt" closed="false"><ref loc="JOB 28:28">Yub 28:28</ref>; <ref loc="PSA 111:10">Jab 111:10</ref>; <ref loc="PRO 1:7">Car 1:7</ref></char></note>Ka dano lworo Rwot, ci cako nongo ryeko; dano ma ngeyo Ngat Maleng bibedo ki niang matut. <verse eid="PRO 9:10" /><verse number="11" style="v" sid="PRO 9:11" />Ryeko bimiyo nino me kwoni nya doko mapol; dok bimedo mwaka me kwoni, miyo irii i lobo. <verse eid="PRO 9:11" /><verse number="12" style="v" sid="PRO 9:12" />Kace iryek, ci in kikomi aye ma ibinongo bere; ento ka ibedo langala, ci meno bene biketo peko ikomi keni.<verse eid="PRO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13" />Mingo obedo calo dako ma laming, ma lawoo tutwal; calo dako ma latarwang ma pe lewic mako. <verse eid="PRO 9:13" /><verse number="14" style="v" sid="PRO 9:14" />En bedo idogolane, nyo i kabedo mamalo matye i taun, <verse eid="PRO 9:14" /><verse number="15" style="v" sid="PRO 9:15" />ci cako lwongo jo ducu ma gikato ki kenyo, ma nongo gitye kawot me cito anyim i yoo wotgi ni, <verse eid="PRO 9:15" /><verse number="16" style="v" sid="PRO 9:16" />“Ngat matye ki ngec manok myero oloke obin kany!” Bot ngat ma wiye oding en waco ni, <verse eid="PRO 9:16" /><verse number="17" style="v" sid="PRO 9:17" />“Pii akwala lim matek, ki kwon ma icamo imung bene yomo cwinyi mada.” <verse eid="PRO 9:17" /><verse number="18" style="v" sid="PRO 9:18" />Ento jo macito bote pe gingeyo ni jo ducu ma gicito bote gito woko, jo ma gucito bote ducu guto kiyikogi i lyel.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Carolok pa Solomon</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Magi aye carolok pa Solomon.</para>
  <para style="p" vid="PRO 10:1">Latin maryek yomo cwiny wone, ento latin maming cwero cwiny mine matek.<verse eid="PRO 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 10:2" />Lonyo ma inongo ki tim maracu pe konyi, ento bedo ki kit ma atir twero lari ki ito.<verse eid="PRO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 10:3" />Rwot pe weko kec neko dano ma kite atir, ento en kwero dano marac miyo pe nongo gin ma iye mito.<verse eid="PRO 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 10:4" />Ka in lawackom ci ibedo meri lacan, ento ka itiyo tic matek ci itwero lony.<verse eid="PRO 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 10:5" />Ngat maryek coko cam woko ki i poto ka ocek, ento ngat ma nino mere anina ikare me kac kelo lewic iwiye kene.<verse eid="PRO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 10:6" />Rwot miyo gum ikom dano ma kite atir, dano marac mungu tim bwamine woko.<verse eid="PRO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 10:7" />Dano ma kite atir kipo pire pien en lakel gum, ento dano marac nyinge bibale woko, wi dano biwil woko ikome matwal.<verse eid="PRO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 10:8" />Ngat ma laryeko i cwinye twero lubu cik, ento dano ma laming ma loko lok me mingming agikine en aye can keken.<verse eid="PRO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 10:9" />Dano ma cwinye leng bedo labongo lworo mo, ento dano ma loko kite atata bingene woko.<verse eid="PRO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 10:10" />Dano ma bedo kamungu lok kun umu bal kelo ayela, ento ngat ma juku dano atir kelo kuc.<verse eid="PRO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 10:11" />Lok ma jo ma kitgi atir giloko en aye wang it me kwo, ento dano marac loko lok kun nongo omungu tim bwamine woko.<verse eid="PRO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 10:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:12: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:20">Yak 5:20</ref>; <ref loc="1PE 4:8">1 Pet 4:8</ref></char>
    </note>Adagadaga nyayo lweny ki mone, ento bedo ki mar umu bal ducu.<verse eid="PRO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 10:13" />Ngat ma nino ducu tye ki niang matut loko lok ki ryeko; ento dano ma wiye oding ka oloko lok mo, omyero ki miye mere pwod aye.<verse eid="PRO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 10:14" />Jo ma luryeko gilimo ngec ducu macalo gitwero, ento laming ka loko loke lwongo mere can me nyiko cok bote.<verse eid="PRO 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 10:15" />Lonyo bedo calo gang matek bot lulonyo, ento lucan can nekogi aneka.<verse eid="PRO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 10:16" />Cul pa dano ma kite atir en aye kwo, ento magoba ma dano marac nongo en aye mede ameda ki timo bal.<verse eid="PRO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 10:17" />Dano ma winyo pwony tye kalubu yo ma tere i kwo, ento dano ma dag juk ngak mere ki yone pat.<verse eid="PRO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 10:18" />Dano matye ki adagadaga nino ducu loko lok goba keken, ngat maloko lok me kwoto luwote nongo en laming.<verse eid="PRO 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 10:19" />Ka dano mo bedo kaloko lok madwong, ci twero timo bal i lok madwong ma en lokoni; dano maryek gire ling alinga.<verse eid="PRO 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 10:20" />Ngat ma kite atir loke bene leng calo ryal ma kiliyo maber: ento tam pa dano marac konye nok tutwal.<verse eid="PRO 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 10:21" />Dano ma kite atir pwonyo jo mapol ki loke ma en loko, ento luming gito atoya pi ding wigi.<verse eid="PRO 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 10:22" />Ka Rwot omiyo gum, dano doko lalonyo; Rwot pe medo cwercwiny ikom gin ma en omiyo.<verse eid="PRO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 10:23" />Tiyo gin marac obedo calo gituku ki bot laming, ento dano matye ki niang matut nongo yomcwiny iryeko ma en tye kwede.<verse eid="PRO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 10:24" />Gin ma dano marac lworo mada bipoto ikome, ento dano ma kite atir kibicobo mitine.<verse eid="PRO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 10:25" />Kace yamo mager okodo, ci bayo dano marac woko cen, ento ngat ma kite atir moko bedo mere matwal.<verse eid="PRO 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 10:26" />Pe myero icwal dano ma lawackom ni otii tic mo piri; pien tye calo kongo bwino mawac, dok calo yito ma duny donyo iwangi.<verse eid="PRO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 10:27" />Lwor Rwot ci ibirii iwi lobo pi mwaka mapol, ento dano marac mwakane me bedo i lobo bibedo manok.<verse eid="PRO 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 10:28" />Gen pa dano ma kite atir kelo bote yomcwiny, ento gen pa dano marac lal woko ata.<verse eid="PRO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 10:29" />Rwot tye macalo cel gogo matek pa ngat ma yo me kwone tye atir, ento jo ma gin lutim maracu en bityekogi woko liweng<verse eid="PRO 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 10:30" />Pe tye ngat mo ma bireto dano ma kite atir; dano marac aye pe bibedo i lobo.<verse eid="PRO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 10:31" />Ngat ma kite atir loko lok ki ryeko, ento ngat ma loko lok mungak me gobagoba kibingolo lebe woko.<verse eid="PRO 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 10:32" />Ngat ma kite atir loko lok mabeco ma dano pwoyo bene, kun dano marac nongo loko mere lok mungak ma rwenyo dano arwenya.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 11:1" />Rwot dag jo ma gipimo jami ki mijan ma pe pimo kakare, ento cwinye yom ikom jo ma gitye ki mijan ma pimo jami kakare.<verse eid="PRO 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 11:2" />Awaka kelo lewic; ento jo mamwol gitye ki ryeko.<verse eid="PRO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 11:3" />Jo ma cwinygi atir leng cwinygi telogi, ento jo ma gin lubal ma kitgi racu gito gitum woko.<verse eid="PRO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 11:4" />Ikare me akemo pa Rwot, lonyo doko gin ma konye peke, bedo ki kit ma atir aye twero laro dano ki ito.<verse eid="PRO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 11:5" />Dano ma pe ki bal mo, ma kite atir, woto i yo mapwot, ento ngat marac poto i peko pi race.<verse eid="PRO 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 11:6" />Kit ma atir pa jo ma cwinygi tye atir twero larogi, ento lubal giloke gidoko opii me bal ma gitimo pi tamgi maracu.<verse eid="PRO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 11:7" />Ka dano marac oto, ci gene bene tum woko cut, ki gen pa dano ma pe ngeyo Lubanga pe cobe.<verse eid="PRO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 11:8" />Dano ma kite atir kilaro ki i ayelayela, ento dano marac poto mere i can.<verse eid="PRO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 11:9" />Jo ma pe gilworo Lubanga gibalo luwotgi ki lok doggi, ento jo ma kitgi atir gibwot pi ngecgi.<verse eid="PRO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 11:10" />Jo ma i gang ducu gibedo ki yomcwiny, ka dano ma kite atir olimo gum odoko lalonyo; ka inen jo maracu aye guto, jo ma i gang ducu giwoo ki twon yomcwiny mo ma pe twere.<verse eid="PRO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 11:11" />Gum ma jo ma kitgi atir gilimo miyo gang doko dit, kun jo maracu gibalo meggi gang abala ki lok ma giloko.<verse eid="PRO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 11:12" />Dano ma wiye oding cayo lawote acaya, ento dano matye ki niang matut ling mere alinga mot.<verse eid="PRO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 11:13" />Ngat ma woto ki lok me kwot ikin gang tucu mung woko, ngat ma lagen aye kano lok me mung.<verse eid="PRO 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 11:14" />Kace ineno rok mo pe tye ki dano mo ma telogi maber, ci rok meno poto woko; bedo ki jo mapol ma gin lumiitam kelo kuc ki bedo maber.<verse eid="PRO 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 11:15" />Ngat ma cike me culu banya pa dano mo ata bikoko angee, ngat ma kwero cung pi cul macalo meno bedo mere mot ki kuc labongo lworo mo.<verse eid="PRO 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 11:16" />Dako maber ma lakica dano giworo, ento dako ma kite rac bedo ki lewic.</para>
  <para style="p" vid="PRO 11:16">Jo ma luwackom gibedo lucan, ento jo ma lubwami ginongo lonyo.<verse eid="PRO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 11:17" />Dano ma lakica limo kony pire kene, ento dano mager keto ret ikome kene.<verse eid="PRO 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 11:18" />Dano marac nongo mucara me bwolo, ento dano ma kite atir limo mere mot me ada.<verse eid="PRO 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 11:19" />Ngat ma omoko liking ibedo ki kit atir bibedo kwo, ento ngat ma mede kitiyo gin marac bito.<verse eid="PRO 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 11:20" />Rwot dag jo ma tamgi ongak, ento cwinye yom ikom jo ma gipe ki bal mo.<verse eid="PRO 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 11:21" />Myero wuniang ni, dano ma latim marac kibimiye can, ento jo ma kitgi atir keken aye kibilarogi.<verse eid="PRO 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 11:22" />Dako manen mwonya maber, kace pe romo poko kin gin maber ki marac, nongo rom ki agit jabu ma kirwako i um opego.<verse eid="PRO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 11:23" />Jo ma kitgi atir gimito megi jami maber keken; tam pa ngat marac tum mere i akemo.<verse eid="PRO 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 11:24" />Jo mogo ma gimiyo limgi kit ma cwinygi opwoyo, gilony gimede ameda; jo mukene gikano limgi akana ma pe gimito miyone, ci gidoko lucan marac.<verse eid="PRO 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 11:25" />Dano ma cwinye yom imiyo mot kimedo lonyo madwong bote, ngat ma konyo jo mukene en bene kibikonye.<verse eid="PRO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 11:26" />Dano giceno ngat ma kano kal woko ma kun nongo kimito, ento kilamo gum ikom ngat ma cato bel botgi.<verse eid="PRO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 11:27" />Ngat ma tame tye me nongo gin maber, dano gipwoye; ento ngat ma yenyo gin marac, nongo bene gin marac cut.<verse eid="PRO 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 11:28" />Ngat ma geno lonyone, bipoto; dano ma kite atir bedo mere ki kwo maber macalo yat ma pote dyak.<verse eid="PRO 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 11:29" />Ngat makelo ayela ikom jo ma i ode pe binongo gin mo matwal, ki ngat ma laming bibedo latic pa dano maryek.<verse eid="PRO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 11:30" />Ngat ma kite atir limo kwo macalo adwogi me bedone atir, dong bedo labongo lubu cik rwenyo kwo pa dano arwenya.<verse eid="PRO 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 11:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:31: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:18">1 Pet 4:18</ref>
      </char>
    </note>Kace dano ma kite atir kitwero miye mot ikare ma nongo en pud tye i lobo kany, ci jo maracu kacel ki jo ma gin lubalo kibipwodogi bene!<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 12:1" />Dano ma ye pwony nongo maro ni ebed ki ngec mo, ento ngat ma kwero pwony nongo ming.<verse eid="PRO 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 12:2" />Rwot bedo ki yomcwiny ikom dano ma kite ber, ento en ngolo kop loyo latim marac.<verse eid="PRO 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 12:3" />Dano pe cung matek pi timo gin marac, ento dano ma tiyo gin ma atir bedo calo lwit yat ma odonyo matut i ngom ma ngat mo pe romo putune.<verse eid="PRO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 12:4" />Dako makwiri ma kite ber miyo dano keto woro ikom cware, ento dako ma kelo lewic bedo calo bur adola mudet ityen cware ma ogudu cogo.<verse eid="PRO 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 12:5" />Tam pa ngat ma kite atir tye kakare ma rwate ki cik; lok ma jo maracu giyubu bwolo dano abwola.<verse eid="PRO 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 12:6" />Lok ma dano marac loko kelo to, ento lok pa ngat ma cwinye atir laro dano.<verse eid="PRO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 12:7" />Jo maracu kityekogi woko ducu pe mo dong, ento jo me dogola pa dano ma kite atir birii nakanaka.<verse eid="PRO 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 12:8" />Dano maryek matye ki ngec jo gipwoyo, ento gicayo ngat ma tame ongak.<verse eid="PRO 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 12:9" />Dano mabedo ki mwolo ma tiyo tic wek enong jami me gwoko kwone, ber kato ngat ma poro bedo dano madit ma nongo pe tye ki ginacama.<verse eid="PRO 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 12:10" />Dano ma kite atir gwoko lee matye i pacone maber, ento jo maracu giketo gero ikom leegi labongo kica mo.<verse eid="PRO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 12:11" />Ngat ma lapur matek twero limo cam mabup; ento ngat ma balo karene itimo tim ma konye peke nongo en ngat ma ryekone peke.<verse eid="PRO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 12:12" />Jo ma kitgi racu giyenyo mere yo me timo bal keken, ento jo ma kitgi atir gicung gigi matek liking.<verse eid="PRO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 12:13" />Dano ma latim marac ki make ki lok me bal ma en loko, ento ngat ma kite atir bwot ki i ayela ducu ma opoto ikome.<verse eid="PRO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 12:14" />Dano twero yeng ki jami mabeco ma en limo pi lok ma en loko, dok tic ma dano tiyo kicule bene pire.<verse eid="PRO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 12:15" />Dano ma laming tamo ni gin ma en etiyo ducu tye atir, ento dano maryek winyo mere tam ma kimiye.<verse eid="PRO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 12:16" />Ka kiniga omako laming kingeyo woko cut, ento dano maryek jalo yet ma kiyete kwede.<verse eid="PRO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 12:17" />Ngat ma lagen tito lok me caden matye ada, ento caden ma lagoba tito mere lok goba me bwola keken.<verse eid="PRO 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 12:18" />Lok pa ngat ma loko lapera winye malit macalo pala lucwan ka ocobo dano, ento lok ma a ki ileb ngat maryek twero cango dano.<verse eid="PRO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 12:19" />Lok goba rii pi kare manok keken, ento lok ada bedo matwal.<verse eid="PRO 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 12:20" />Jo ma giyubu lok me tiyo gin marac aye gikano lok me bwola i cwinygi, ento jo ma gitamo me tiyo gin maber gibedo ki yomcwiny.<verse eid="PRO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 12:21" />Pe tye gin mo marac matwero poto ikom ngat ma kite atir; ento dano marac nino ducu nongo mere ayelayela keken.<verse eid="PRO 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 12:22" />Rwot dag jo ma giloko lok goba, ento cwinye bedo yom ikom jo ma gitiyo ki gen.<verse eid="PRO 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 12:23" />Dano matye ki niang matut ling gire mot kadi en ngeyo gin moni, ento jo ma gin luming ginyutu kwiya pinygi kamaleng bot dano.<verse eid="PRO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 12:24" />Dano ma omiyo kwone me tiyo tic matek bedo ki twero me loyo luwote, ento ngat ma lawackom kibikete katiyo tic muroni mapek.<verse eid="PRO 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 12:25" />Par mapol gengo dano me bedo ki yomcwiny, lok maber me kica aye romo kweyo cwinye.<verse eid="PRO 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 12:26" />Dano ma kite atir miyo tam mabeco bot luwote, miyo pe gitiyo gin marac, ento yo pa jo maracu ngako luwote miyo girweny arwenya.<verse eid="PRO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 12:27" />Dano ma kome wac pe nongo gin ma en mito, ento dano ma tiyo tic matek twero bedo ki lonyo mabup.<verse eid="PRO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 12:28" />Bedo ki kit ma atir tero dano i kwo, ento lubu yo me bal tero mere dano i to.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 13:1" />Latin maryek winyo pwony ki juk pa wone, ento latin ma langala pe winyo lok ma kijuke kwede.<verse eid="PRO 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 13:2" />Jo ma kitgi beco gibilimo mot pi lok mabeco ma nongo giwaco; miti pa jo ma lubal tye mere me timo tim bwami keken.<verse eid="PRO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 13:3" />Ngat ma gwoke i lok ma en loko gwoko kwone; ento ngat ma loko lok ata, can poto ikome cut.<verse eid="PRO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 13:4" />Ngat ma lawackom kadi bed cwinye omito jami moni marom mene pe twero nongone, kun dano ma omiyo kwone me tiyo tic matek kimedo bote lonyo ameda.<verse eid="PRO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 13:5" />Dano ma kite atir dag goba, ento dano marac timo tim me lewic ki cac me bwola keken.<verse eid="PRO 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 13:6" />Kit ma atir gwoko ngat ma pe ki bal mo, ento bal tyeko jo maracu woko atyeka ducu.<verse eid="PRO 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 13:7" />Jo mogo giporo bedo ki lonyo, ma nongo pe gitye ki gin mo kadi ki acel; ki jo mukene giporo bedo lucan ma kun nongo gitye ki lwak lonyo madit ata.<verse eid="PRO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 13:8" />Dano ma lalonyo twero koko kwone ki lonyone; ento ngat ma lacan, ma gire mo peke, pe tye ki par pien ngat mo peke ma buru kwone.<verse eid="PRO 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 13:9" />Jo ma kitgi atir gimeny calo mac tara ma lyel maleng, ento jo maracu gibedo calo mac tara matye kato atoya.<verse eid="PRO 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 13:10" />Wake kelo peko keken, ento jo ma giwinyo lok me tam ma kimiyo botgi gibedo maryek.<verse eid="PRO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 13:11" />Lonyo ma kinongo oyotoyot i yo marac rwenyo woko, ento ngat ma nongo lonyo ma manoknok pi tice matek lonyone bimede.<verse eid="PRO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 13:12" />Gen ma pe ocobe kakare turu cwiny dano, ento miti ka ocobe kakare tye macalo yat me kwo.<verse eid="PRO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 13:13" />Ngat ma cayo lok ma kiwace lwongo to ikome kene, ento ngat ma lubu gin ma kiciko bilimo mot.<verse eid="PRO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 13:14" />Pwony ma jo maryek gipwonyo ki dano miyo kwo, miyo dano bene gibwot ki i owic me to.<verse eid="PRO 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 13:15" />Ngec ma dano tye kwede miyo jo mapol gipwonye, ento jo ma pe gene gilimo meggi can keken.<verse eid="PRO 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 13:16" />Dano ma wiye tiyo cobo tice ki ngec ma oromo, ento ngat ma laming bedo ka nyutu mingone kamaleng.<verse eid="PRO 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 13:17" />Lakwena marac miyo dano gilimo peko, ento lakwena ma gene kelo kuc.<verse eid="PRO 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 13:18" />Dano ma kwero juk nongo can ki cwercwiny; ento ngat ma ye juk dano giworo.<verse eid="PRO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 13:19" />Ka dano onongo gin ma en mito yomo cwinye mada; ento jo ma luming gidag bwoto tiyo gin marac.<verse eid="PRO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 13:20" />Ngat ma bedo kacel ki jo maryek pwonye doko ryek bene, ento ngat ma mako lurem ki luming kite bibale woko.<verse eid="PRO 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 13:21" />Gin marac lubu lubalo i kabedo ducu ma giwoto iye, ento jo ma kitgi atir kibimiyogi jami mabeco macalo bakacicgi.<verse eid="PRO 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 13:22" />Dano ma kite ber weko lonyone bot likwaye macalo ginaleyagi, ento ngat ma labal kano mere lonyone pi ngat ma kite atir.<verse eid="PRO 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 13:23" />Poto okang pa lacan ceko cam mabup, ento jo ma kitgi pe atir gikwanyo came woko ki tim ma pe atir.<verse eid="PRO 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 13:24" />Dano ma pe pwodo latine ki odoo nongo pe mare, ngat ma maro latine keto cwinye me pwode ka nongo obalo.<verse eid="PRO 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 13:25" />Ngat ma kite atir bedo ki cam ma oromo, ento dano marac kec neko kare ducu.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1" />Mon maryek miyo pacogi bedo maber ki kuc, ento mon ma luming aye giketo pacogi woko aketa pi mingogi.<verse eid="PRO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 14:2" />Dano ma kwone tye atir aye lworo Rwot, ngat ma yone ogom ma maro timo gin marac cayo Rwot acaya.<verse eid="PRO 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 14:3" />Lok pa laming calo odoo ma kigoye kwede, ento jo maryek lok ma giloko twero gwokogi.<verse eid="PRO 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 14:4" />Kama pe kipuru iye ki twoni dyang, inongo bel peke iye, ento kama kipuru iye ki twoni dyang i nongo cam cek madwong ata.<verse eid="PRO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 14:5" />Ngat ma lagen tito lok me caden matye ada, ento caden ma lagoba tito mere lok goba me bwola keken.<verse eid="PRO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 14:6" />Langala pe twero doko ryek wa ki acel, ento ngat matye ki niang matut twero nongo ngec oyotoyot.<verse eid="PRO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 14:7" />A woko ki bot laming, pien pe tye lok mo me ngec ma en romo pwonyi kwede.<verse eid="PRO 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 14:8" />Dano maryek tye ki niang matut me nongo kit ma myero ebed kwede, ento luming mingogi telogi i yo marac miyo gin bwole abwola ken gi.<verse eid="PRO 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 14:9" />Lubanga cayo jo maracu, ento timo kica ki jo ma cwinygi atir.<verse eid="PRO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 14:10" />Yomcwiny ma itye kwede bedo meri keni; ki keccwinyi bene meri; pe tye dano mo matwero nywako gin gu ducu kwedi.<verse eid="PRO 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 14:11" />Kibibalo ot pa dano marac woko, ento ot pa ngat ma cwinye atir bicung mere kakare.<verse eid="PRO 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 14:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:25">Car 16:25</ref>
      </char>
    </note>Tye gin ma dano tamo ni en aye yo ma atir, kun nongo yo ma kit enu tero en ito.<verse eid="PRO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 14:13" />Kadi bed ineno dano nyero nyero, kine mogo nongo cwinye bene tye kacwer; ka yomcwiny dong otum, ci ingeye bino cwercwiny madit.<verse eid="PRO 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 14:14" />Jo ma kitgi racu gipoto ican pi gin marac ma gitimo, ento jo ma kitgi ber gilimo mere mot maber pi gin maber ma gitiyo.<verse eid="PRO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 14:15" />Dano ma laming ye jami ducu ayeya, ento ngat maryek kong ngiyo kakwene ma en cito iye.<verse eid="PRO 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 14:16" />Dano maryek wiye po loke ci kwero timo gin marac, ento dano ma laming tiyo oyotoyot labongo par maromo juke.<verse eid="PRO 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 14:17" />Dano ma kinigane lyeti oyotoyot timo gin me mingo, ento dano matye ki ryeko diyo cwinye.<verse eid="PRO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 14:18" />Lukwiya piny gilubu yo me mingo, ento jo maryek kimiyogi mot me bedo ki ngec.<verse eid="PRO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 14:19" />Jo ma lutim maracu giryebe piny inyim jo ma kitgi beco kun gikwayo kony ki botgi.<verse eid="PRO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 14:20" />Pe tye ngat mo ma mito dano ma lacan, kadi wa jo ma inget ganggi kikome, ento jo ma lulonyo gitye ki lurem mapol.<verse eid="PRO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 14:21" />Ngat ma cayo lawote en labal; ngat ma kica mako ikom lacan bedo ki yomcwiny.<verse eid="PRO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 14:22" />Jo ma gibedo ki tam me timo gin marac gingak woko adada. Ento jo ma gitye ki tam me tiyo gin maber kigenogi dok bene kiworogi.<verse eid="PRO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 14:23" />Kit tic ducu ma dano tiyo magoba tye iye, lok aloka keken ki dog kelo can.<verse eid="PRO 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 14:24" />Bedo ki ryeko kelo lonyo, ento tim me mingo medo mingo ameda.<verse eid="PRO 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 14:25" />Caden me ada laro kwo pa jo mapol, ento caden ma loko lok goba nongo laroro.<verse eid="PRO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 14:26" />Dano ma lworo Rwot bedo ma cwinye opye, dok lutinone bene ginongo kama gilare iye.<verse eid="PRO 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 14:27" />Lworo Rwot miyo kwo bot dano, miyo dano bwot ki i owic me to.<verse eid="PRO 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 14:28" />Deyo pa rwot tye pi lwak dano mapol ma en loyogi; labongo dano rwot pe gin mo.<verse eid="PRO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 14:29" />Ngat ma kiniga pe mako oyot tye ki niang matut, ento ngat ma kiniga mako oyot nyutu mingone keken.<verse eid="PRO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 14:30" />Ka dano bedo ma cwinye opye, miyo kome bene bedo yot; ento nyeko tye macalo bur adola ma odet ma ogudu cogo.<verse eid="PRO 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 14:31" />Ngat ma unu dano ma lacan meno yeto Lubanga ma ocweyo danoni; ento ngat ma bedo ki kica ikom jo ma piny obwoyogi nongo woro Lubanga.<verse eid="PRO 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 14:32" />Dano marac can poto ikome pi time marac, ento dano ma kite atir nongo kalare pien bal mo peke ikome.<verse eid="PRO 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 14:33" />Ryeko bedo i tam pa dano matye ki niang, ento luming pe gitye ki ngec mo ikom ryeko.<verse eid="PRO 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="PRO 14:34" />Bedo ki kit ma atir miyo rok moni nyinge ywek matek, ento bal kelo lewic bot rok mo keken ma iwi lobo.<verse eid="PRO 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="PRO 14:35" />Latic ma tiyo tice ki ryeko miyo rwot bedo ki yomcwiny: ento kiniga make ikom latic ma tiyo tic mamiyo lewic bote.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 15:1" />Gamo lok ki mwolo kweyo kiniga woko, ento lok magwagwa tugu kiniga medo ameda.<verse eid="PRO 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 15:2" />Kace dano maryek tye kalok, loko loke mot maber ki ngec, ento jo ma gin luming gicoro lok me mingming keken.<verse eid="PRO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 15:3" />Rwot neno kabedo ducu, en neno jo ma lutim maracu kacel ki jo ma kitgi beco.<verse eid="PRO 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 15:4" />Lok ma kiloko mot ki kica tye macalo yat me kwo, ento lok mogo mungak balo cwiny dano woko.<verse eid="PRO 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 15:5" />Dano ma laming cayo pwony ma wone pwonye kwede, ngat maryek ye lok me juk.<verse eid="PRO 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 15:6" />Jo ma kitgi atir gikano lonyo madit i odigi, ento lonyo pa jo maracu rwenyo woko ikare me peko.<verse eid="PRO 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 15:7" />Lok pa jo maryek nyayo ngec bot jo mukene, kun tam pa luming pe tye kitmeno.<verse eid="PRO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 15:8" />Rwot dag gitum ma jo maracu gityero bote, ento cwinye bedo yom ikom lega pa jo ma kitgi atir.<verse eid="PRO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 15:9" />Rwot dag kit pa jo maracu, en maro ngat ma bedo ki kit kwo matye atir.<verse eid="PRO 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 15:10" />Ngat ma bwoto lubu yo ma atir kibimiye pwod marac mada; dok ngat ma dag winyo lok me juk bito woko.<verse eid="PRO 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 15:11" />Rwot ngeyo gin ducu matye piny i lyel ki i lobo pa jo ma oto, dong itamoni dano ma mwani gitwero kano mung mo ma Rwot pe ngeyo?<verse eid="PRO 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 15:12" />Dano ma langala pe mito ni kitire; en pe cito bot jo maryek.<verse eid="PRO 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 15:13" />Dano matye ki yomcwiny kineno ki iwange, ento dano ma cwinye cwer bedo ki aremcwiny.<verse eid="PRO 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 15:14" />Tam pa ngat matye ki niang matut tye me yenyo ngec, ento luming gimito ni giyeng meggi ki lok me mingo.<verse eid="PRO 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 15:15" />Kadi bed lucan gibedo i kwo matek ikare me kwogi ducu; ento dano ma cwinye yom bedo ki kuc i kwone kare ducu.<verse eid="PRO 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 15:16" />Bedo ber me bedo ki jami manok kun ilworo Rwot, kato ma ibedo ki lonyo madit kun nongo itye ki ayela keken.<verse eid="PRO 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 15:17" />Camo pot dek i paco pa jo ma gimari ber kato camo ringo twon ma moo i paco pa jo ma gidagi.<verse eid="PRO 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 15:18" />Dano ma kinigane lyet tugu mere daa, ento ngat ma diyo cwinye romo juku pyem.<verse eid="PRO 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 15:19" />Ngat ma lawackom rwate ki peko i kabedo ducu ma en cito iye, ento dano ma cwinye atir yone bedo calo yo gudo ma kigero maber.<verse eid="PRO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 15:20" />Latin maryek yomo cwiny wone, latin maming cayo mine acaya.<verse eid="PRO 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 15:21" />Ngat ma wiye oding cwinye bedo yom ikom lok me mingo, ento ngat matye ki niang aye bedo ki kwo ma atir.<verse eid="PRO 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 15:22" />Yub mo ma kiyubu labongo nongo tam ma oromo pe twero cobe maber, ento yub ma kiyubu ma kong kipenyo tam bot jo mapol cobe kakare.<verse eid="PRO 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 15:23" />Dano mamiyo lagam ma rwate ki lok moni bedo ki yomcwiny, ki lok ma en loko ikare ma mite kikome, ber mada!<verse eid="PRO 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 15:24" />Jo maryek gilubu yo ma dok malo ma terogi i kwo, ento pe yo ma dok piny i to.<verse eid="PRO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 15:25" />Rwot keto ot pa ngat ma lawake woko, ento gwoko wang lobo pa dato.<verse eid="PRO 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 15:26" />Rwot dag tam pa jo maracu, ento cwinye yom ikom lok me kica.<verse eid="PRO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 15:27" />Ngat ma wor ma nongo magoba i yo ma pe atir kelo can ikom jo ma i ode, ento ngat ma kwero gamo lim me wil i mung bibedo kwo pi kare malac.<verse eid="PRO 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 15:28" />Dano ma kite atir kong bedo ki tam matut ikom lagam ma myero edok iye, ento dano marac coro mere lok marac keken.<verse eid="PRO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 15:29" />Rwot tye cen kamabor ki bot jo maracu, ento winyo lega pa dano ma kite atir.<verse eid="PRO 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 15:30" />Wang manen ma opong ki bunyu miyo yomcwiny bot dano, dong winyo kwena maber miyo ibedo maber.<verse eid="PRO 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 15:31" />Ngat ma winyo lok maber ma ki juke kwede bibedo ikin luryeko.<verse eid="PRO 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 15:32" />Ngat ma weko lok me pwony nongo cane kekene; ento ngat ma ye lok me juk me yubu kite binongo niang matut.<verse eid="PRO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 15:33" />Ka dano lworo Rwot, ci limo pwony me ryeko, dok bedo ki mwolo aye yo me limo woro.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 16:1" />Dano twero bedo ki yub i tamgi, ento Rwot aye mamiyo cobe kakare.<verse eid="PRO 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 16:2" />Dano neno ni gin ducu ma en timo tye atir ki tung bote, ento Rwot aye neno ka kitimo ki cwiny ma atir.<verse eid="PRO 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 16:3" />Leg Rwot okonyi i tici ducu ma itiyo, ci yub ducu ma itye kwede bicobe maber dok kakare.<verse eid="PRO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 16:4" />Kit jami acel acel ma Rwot oketo tye ki tyen loke, dong en bene oyubu nino me pwodo jo maracu.<verse eid="PRO 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 16:5" />Rwot dag jo ma luwake; en pe biweko gibwot ma pe kong nongo opwodogi.<verse eid="PRO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 16:6" />Bed ki mar me ada dok ki gen ci Lubanga biweko bali; lwor Rwot ci gin mo marac pe bitime ikomi.<verse eid="PRO 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 16:7" />Ka inen kit pa dano yomo cwiny Rwot, ci Rwot bene cako miyo kuc bedo ikin dano meno ki lumonene.<verse eid="PRO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 16:8" />Gin matidi ma inongo ki yo ma atir ber kato lim madwong ma ilimo i yo me bwami.<verse eid="PRO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 16:9" />Dano yubu yube ki i cwinye, ento Rwot aye ma telo en miyo cobo maber.<verse eid="PRO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 16:10" />Laker loko lok kit ma nongo Lubanga omiye ni oloki; miyo doge bene pong ki ngolo kop atir kare ducu.<verse eid="PRO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 16:11" />Rwot cwinye yom ikom jo ma gitye ki mijan ma pimo jami kakare; kidi lapim jami me acata ducu en ma otiyogi.<verse eid="PRO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 16:12" />Luker pe gitwero ciro jo ma gitiyo gin marac, pien bedo ki kit ma atir aye miyo komker cung matek.<verse eid="PRO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 16:13" />Laker bedo ki yomcwiny ikom dano ma loko lok ki gen, dok en maro ngat ma loko lok ada.<verse eid="PRO 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 16:14" />Ka kiniga omako rwot ci en twero ngolo to iwi dano mo cut, ento ngat maryek twero kweyo akemo pa rwot ka kiniga omake.<verse eid="PRO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 16:15" />Yomcwiny ma rwot tye kwede nen wa i tur wange dok miyo kwo, ki kicane bene tye macalo pol mamiyo kot cwer i cwir.<verse eid="PRO 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 16:16" />Bedo ki ryeko kacel ki niang matut ber loyo bedo ki jabu ki ryal.<verse eid="PRO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 16:17" />Jo ma cwinygi atir giwoto i yo ma pe terogi katimo gin marac; ngat ma gwoko kite bilaro kwone bene.<verse eid="PRO 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 16:18" />Wake tero dano i can, ki cwiny me nyate miyo dano poto i can.<verse eid="PRO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 16:19" />Bedo kacel ki lucan ki cwiny me mwolo ber kato poko jami ayaka ki jo ma luwake.<verse eid="PRO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 16:20" />Ngat ma winyo lok me pwony ma kipwonye kwede bibedo ki kwo maber, dok ngat ma geno Rwot bedo ki yomcwiny.<verse eid="PRO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 16:21" />Dano maryek ki i cwinye ki ngeyo ni tye bene ki niang matut; en loko lok mamit ma bito ki tam pa dano.<verse eid="PRO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 16:22" />Ryeko miyo kwo bot ngat matye kwede, ento mingo kelo can keken ikom luming.<verse eid="PRO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 16:23" />Dano maryek lwodo lok ma en loko maber, miyo gin ma en waco ducu bedo lok me pwony ma winye mamit ma ywayo tam pa dano.<verse eid="PRO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 16:24" />Lok ma kiloko ki kica lim calo moo kic, lim mada mayomo cwiny dok miyo yotkom.<verse eid="PRO 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 16:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:12">Car 14:12</ref>
      </char>
    </note>Tye gin ma dano tamo ni en aye yo ma atir, kun nongo yo ma kit meno tero en ito.<verse eid="PRO 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 16:26" />Limdog ma latic tye kwede miyo en tiyo matek, pien mito ni ecam eyeng kare ducu wek kec pe obed kaneke.<verse eid="PRO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 16:27" />Jo maracu gipiro lok me wano jo mukene, dok lok ma giloko nongo lyet calo mac.<verse eid="PRO 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 16:28" />Dano ma cwinye rac bedo kun keto lok ma nyayo mone ikin dano, ki ngat ma maro kwoto dano, keyo larem pa jo mapol.<verse eid="PRO 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 16:29" />Dano ma labwami bwolo lawote, miyo lawote lubu yo ma pe ber ci poto woko ican.<verse eid="PRO 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 16:30" />Ngat ma gayo lawote ki wange nongo tye ki yub me timo gin marac ikom lawote; dano mamiyo doge liking bitimo gin marac.<verse eid="PRO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 16:31" />Lwar wic aye lalukana me deyo pa ludongo, bino macalo mic pi kwo matye atir.<verse eid="PRO 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 16:32" />Ngat ma kiniga pe mako oyot ber loyo twon oteka, ngat maloyo tam ma i cwinye kene loyo ngat ma omayo taun madit kulu.<verse eid="PRO 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 16:33" />Dano bolo kwir pi gin ma omyero gutim, ento Rwot aye ma moko gin ma bitime.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 17:1" />Kwon ma ngic mo ma icamo ki kuc ber kato karama ma icamo i ot ma opong ki daa.<verse eid="PRO 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 17:2" />Opii ma tiyo tice ki ryeko twero bedo ki loc ikom latin ma tiyo gin me lewic, dok twero nywako ginaleyagi kwedgi macalo ngat acel ma ikom omegigi.<verse eid="PRO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 17:3" />Jabu ki ryal kilenyo i ruk mac wek cilo opoke woko ki iye, Rwot bene temo cwiny dano.<verse eid="PRO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 17:4" />Lutim maracu giwinyo lok pa jo maracu; ki lugoba bene giwinyo lok ma balo nying dano.<verse eid="PRO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 17:5" />Ngat ma ngalo lacan meno yeto Lubanga ma ocweyo danoni; ki ngat ma bedo ki yomcwiny pi can ma opoto ikom lawote pe bibwot ma nongo pe kong kimiye pwod.<verse eid="PRO 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 17:6" />Ludito ma otii ginongo deyo pi likwayogi, ki lutino bene ginongo deyo pi won gi.<verse eid="PRO 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 17:7" />Laming pe twero loko lok maber, pe ber bene ki laloc ma kiworo me loko lok goba.<verse eid="PRO 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 17:8" />Lim me wil i mung nen bot lamiyone calo lwit ma dano otweyo ibade; en geno ni ebinongo gum pire.<verse eid="PRO 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 17:9" />Dano ma timo kica bot jo ma gitime marac gwoko larem, ento ngat ma wiye bedo kapo ikom bal ma lawote obalo bote keto larem woko ki ikin gi.<verse eid="PRO 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 17:10" />Dano ma niang matut twero ye lok acel keken me juk ki cwinye ducu, kato laming ma kadi ka kidongo tyen miya pe winyo lok moni.<verse eid="PRO 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 17:11" />Dano ma latim marac tamo lok me jemo keken; pimeno kibicwalo lakwena mager wek olweny ikome.<verse eid="PRO 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 17:12" />Bedo ber ka dano orwate ki nguu mager ma lutinone kineko woko, kato ma orwate ki laming ma tiyo gin me mingomingo.<verse eid="PRO 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 17:13" />Kace dano timo gin marac bot ngat ma otime ber, gin marac pe bia ki i ode wa ki acel.<verse eid="PRO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 17:14" />Lweny cake matitidi ki lok me pyem macalo pii ma ka i yabo doge kong kwongo mol ma manoknok; pimeno myero ijuke woko ma pud peya daa ocake.<verse eid="PRO 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 17:15" />Langolkop mamiyo dano marac loyo kop, ki langolkop ma ngolo lok loyo dano ma loke tye atir, gin aryo ducu Rwot daggi.<verse eid="PRO 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 17:16" />Kadi laming tye ki lim ma oromo maromo wilo ryeko, meno kono konyo ango, ma kun nongo wiye oding woko?<verse eid="PRO 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 17:17" />Luremi ginyuti mar ikare ducu, ki wadini gikonyi ikare me peko.<verse eid="PRO 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 17:18" />Dano ma wiye oding aye jengo jamine, kun miine me cung maka lawote.<verse eid="PRO 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 17:19" />Dano ma maro bal nongo bene maro kelo ayela; ki ngat ma lawake lwongo can keken ikome.<verse eid="PRO 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 17:20" />Dano ma tamo lok marac pe twero limo gin maber, ki ngat ma loko lok me rwenyo dano arwenya bipoto i can.<verse eid="PRO 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 17:21" />Latin ma laming cwero cwiny wone; ngat ma latine ming pe bedo ki yomcwiny.<verse eid="PRO 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 17:22" />Yomcwiny kelo yotkom, cwercwiny miyo dano mok<note caller="+" style="f"><char style="fr" closed="false">17:22 </char><char style="fk">Mok </char> obedo jonyo. </note> woko.<verse eid="PRO 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 17:23" />Langolkop marac ye gamo lim me wilo loyo kop i mung, ma balo ngolo kop atir woko.<verse eid="PRO 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 17:24" />Dano matye ki niang matut ngeyo gin ma myero etim, ento dano ma laming bedo mere ma pe romo moko lok mo pire kene.<verse eid="PRO 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 17:25" />Latin maming miyo wone bedo ki cwercwiny dok mine bene bedo ma cwinye kec adada.<verse eid="PRO 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 17:26" />Pe ber me ngolo cul ki dano ma peke ki bal; nyo me miyo pwod ikom jo ma kitgi beco pi lokgi me ada.<verse eid="PRO 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 17:27" />Ngat matye ki ngec loko lok manok, ki ngat ma kome pe ryange aye dano matye ki niang matut.<verse eid="PRO 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 17:28" />Kadi bed ngat ma laming, kace ling alinga miyo kitwero tamo ni ryek; ka pe ongamo doge kalok miyo kitamo ni niang telok.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1" />Ngat ma pe ribe ki jo mukene nongo kete kene, kun kwero lubu tam pa jo ma ticgi nyutu ryekogi.<verse eid="PRO 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 18:2" />Laming pe paro pi niang jami moni; ento gin ma en mito aye me nyutu ka tame kene.<verse eid="PRO 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 18:3" />Bal ki lewic giwoto kacel; ka woro orwenyo, ci yet bene cake.<verse eid="PRO 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 18:4" />Lok ma dano loko cal ki pii matut; ryeko cal ki wang it ma gunye doko kulu.<verse eid="PRO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 18:5" />Dworo kor dano marac pe ber; ngolo kop me loyo dano ma pe ki bal bene rac.<verse eid="PRO 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 18:6" />Laming loko gin ma nyayo daa ki pyem; pi lok maracu ma en loko aye miyo kigoye.<verse eid="PRO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 18:7" />Laming kelo can ikome kene ki lok ma en loko, dok gin ma en loko ducu tye macalo owic matwero mako en kekene.<verse eid="PRO 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 18:8" />Lok pa ngat ma lakwot dano mit calo cam ma kitedo makur atika, ma kimwonyo cito i ic kikome.<verse eid="PRO 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 18:9" />Dano ma kome wac katiyo tice rom ki dano ma balo jami abala.<verse eid="PRO 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 18:10" />Rwot obedo calo cel matek kama dano ma kite atir ringo iye ci laro kwone.<verse eid="PRO 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 18:11" />Lonyo bedo calo gang matek bot lalonyo, dok macalo cel ma kigero ocudu malo likung me gwoko en.<verse eid="PRO 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 18:12" />Cwiny me nyate miyo dano poto i can; bedo ki mwolo aye yo me limo woro.<verse eid="PRO 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 18:13" />Myero kong iwiny lok ma nongo peya igamo lok mo; ka pe, ci inyutu mingi dok iywayo yet ikomi.<verse eid="PRO 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 18:14" />Dano twero ciro arem matek ikare ma nongo en two, ento anga matwero ciro ka cwinye odoko nyap?<verse eid="PRO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 18:15" />Tam pa ngat matye ki niang matut tye me yenyo ngec, jo maryek bene gimito ni giwiny lok ma medo ngecgi.<verse eid="PRO 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 18:16" />Mot ma dano miyo twero yabo yo bote, dok miyo en o wa inyim jo madito.<verse eid="PRO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 18:17" />Dano ma kwongo tito lok inyim kot nen calo loke tye atir, nio ka lawote ma pido kwedeni openye ki peny madwong.<verse eid="PRO 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 18:18" />Ka jo aryo ma gitego gitye kapyem inyim kot, ce ka kibolo kwir ikin gi, ci tyeko daa ma ikin gi.<verse eid="PRO 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 18:19" />Kony omeru ci en bigwoki macalo ibedo i cel me gang matek, ento ka ibedo ka daa kwede ci en loro dogola woko piri.<verse eid="PRO 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 18:20" />Dano nongo gin maber nyo marac pi lok ma en oloko; lok ma oa ki idoge tye ki adwogine.<verse eid="PRO 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 18:21" />Lok ma i loko twero gwoko kwoni, nyo twero neki woko aneka; jo ma gimaro loko lok maracu gibineno can.<verse eid="PRO 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 18:22" />Ngat ma onongo dako, nongo onongo gin maber; en biniang atir ni Rwot kara pwoye.<verse eid="PRO 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 18:23" />Dano ma lacan ka loko, bako doge ki mwolo; ento ngat ma lalonyo gamo mere lok ki gero cut.<verse eid="PRO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 18:24" />Tye jo mogo ma giporo bedo lurem apora, ento tye dano ma moko mere ikom lareme liking maloyo omine kikome.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 19:1" />Dano ma lacan ma loko lok ada dok lagen ber kato ngat ma loko lok gobagoba ma nongo en laming kwede.<verse eid="PRO 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 19:2" />Miti ma dano tye kwede labongo ngec rac, dano ma pe diyo cwinye bipoto i peko.<verse eid="PRO 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 19:3" />Mingo ma dano tye kwede aye kelo can bote, ka dok cako keco mere ikom Rwot ki icwinye.<verse eid="PRO 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 19:4" />Ngat ma lalonyo nongo lurem manyen mapol kare ki kare, ento dano ma lacan kadiwa lareme kikome bene tenye woko liyak.<verse eid="PRO 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 19:5" />Caden ma lagoba pe kibiweko ma pe kong kipwodo, ki ngat ma loko lok goba bene pe bibwot.<verse eid="PRO 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 19:6" />Jo mapol giyenyo gum ki bot dano ma cwinye yom; ngat acel acel mito ni ebed larem dano mo ma maro miyo mot.<verse eid="PRO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 19:7" />Dano ma lacan kadiwa omegine ducu bene gidage, ki lureme bene ducu giket gicito woko cen kamabor kwede. Pe dong gitwero dwogo cen bote, kadi en obitgi ki lok mamit marom kwene.<verse eid="PRO 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 19:8" />Ngat ma mare kekene nongo ryeko; ki ngat ma wiye tiyo ikom gin ma en opwonyo bibedo ki kwo maber.<verse eid="PRO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 19:9" />Caden ma lagoba pe kibiweko ma pe kong ki pwodo, ki ngat ma loko lok goba bene bito.<verse eid="PRO 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 19:10" />Pe pore pi laming me bedo i kwo me lonyo, dok bedo rac ka opii bedo ki twero me loyo rwodi.<verse eid="PRO 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 19:11" />Dano matye ki ryeko maber kiniga pe mako oyot, en bedo ma cwinye tye atir pi jalo bal ma ngat mo otimo ikome.<verse eid="PRO 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 19:12" />Kiniga pa rwot bedo calo koko pa labwor, ento bere calo toyo ma ton ikom lum.<verse eid="PRO 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 19:13" />Latin ma ming kelo can ikom wone, ki daa pa dako obedo calo ot macwer ka kot cwer.<verse eid="PRO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 19:14" />Ot kacel ki lonyo kileyogi ki bot kwaro, ento dako maryek Rwot aye miyo.<verse eid="PRO 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 19:15" />Wackom miyo dano nino nino matut; dano ma lawackom kec bineko matek.<verse eid="PRO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 19:16" />Ngat ma lubu gin ma Rwot ociko, meno nongo tye kagwoko kwone; ento ngat ma cayo loke bito.<verse eid="PRO 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 19:17" />Ngat ma konyo lucan nongo omiyo banya bot Rwot; pimeno Rwot bicule pi gin ma en otiyo.<verse eid="PRO 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 19:18" />Pwony lutinoni me bedo ki kit kwo maber ma nongo pud gin tino; ka pe imiyogi pwod nongo itye ka balogi abala.<verse eid="PRO 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 19:19" />Dano ma kinigane lyet bilimo pwod ma oporo kinigane; ka ikwanyo en woko ki ican kicel, en pud dok bimitoni ikonye dok aye ikare mukene.<verse eid="PRO 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 19:20" />Winy tam ma kimiyi dok imak pwony ma kipwonyi kwede, ci ibibedo dano ma laryeko ikare me anyim.<verse eid="PRO 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 19:21" />Dano twero bedo ki yub pi jami mapol i tame, ento gin ma Rwot mito aye ma bicobe kakare.<verse eid="PRO 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 19:22" />Gin ma myero dano obed kwede aye mar me ada; dano ma lacan ber kato ngat ma lagoba.<verse eid="PRO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 19:23" />Lwor Rwot, ci ibibedo kwo; ngat ma lworo Rwot bedo ki yweyo ma oromo i cwinye; gin marac bene pe twero gudu kome.<verse eid="PRO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 19:24" />Lawackom lutu cinge i atabo, ento kwanyo cinge me tero cam idoge loye woko.<verse eid="PRO 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 19:25" />Pwod jo ma gin lungala, ci jo ma kwiya piny gibipwonye; juk dano ma niang, ci bilimo ngec ma oromo.<verse eid="PRO 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 19:26" />Ngat ma timo bwami ikom wone, ma ryemo mine woko bene ki igang, meno latin makelo lewic ki cwercwiny bot lunyodone.<verse eid="PRO 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 19:27" />Latina, ka iweko pwony, ci ibingak ibwoto lok me ngec ma dong itye kwede con.<verse eid="PRO 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 19:28" />Caden ma konye peke kelo ngala ikom ngolo kop atir, jo maracu bene guloko bal odoko camgi.<verse eid="PRO 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 19:29" />Pwod dong tye ma kitero woko pi jo ma gin lungala, ki luming bene kibigoyo ngegi ki odoo.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1" />Mato kongo bwino makec madwong mukato kare loki idoko lakolo dok miyo kicayi bene; ngat ma mato kongo bwino mer kwede nongo pe ryek.<verse eid="PRO 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 20:2" />Kiniga pa rwot kelo lworo calo koko pa labwor; ngat mamiyo kiniga mako rwot kelo to ikome kene.<verse eid="PRO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 20:3" />Bedo cen ki kama daa tye iye kelo woro ikomi; ento ngat ma laming maro daa.<verse eid="PRO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 20:4" />Lapur ma lawackom pe puru potone i poto kot kikome; pimeno en pe binongo cam mo ma myero eka ikare me kac.<verse eid="PRO 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 20:5" />Tam ma dano tye kwede i cwinye tye calo pii matut, ento dano matye ki niang matut twero golo woko kamaleng.<verse eid="PRO 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 20:6" />Dano acel acel loko pi genene ki mar me ada ma en tye kwede, ento anga matwero nongo dano ma gene?<verse eid="PRO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 20:7" />Likwayo pa dano ma cwinye leng dok ma tiyo gin matye atir gitye ki gum!<verse eid="PRO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 20:8" />Ka rwot obedo iwi komker me ngolo kop wange yeko gin marac ducu.<verse eid="PRO 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 20:9" />Tye ngat mo matwero waco ni, “Dong atyeko lwoko cwinya odoko leng kombedi atye maleng, bala ducu dong kijwayo woko”?<verse eid="PRO 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 20:10" />Rwot dag jo ma gitiyo ki agwata ki mijan ma pe pimo jami kakare.<verse eid="PRO 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 20:11" />Kadi wa latin bene nyutu kit ma etye kwede i gin ma en tiyo, ka gin ma en tiyoni ber nyo tye atir ci nongo en latin maber.<verse eid="PRO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 20:12" />Rwot aye ma omiyowa it me winyo lok ki wang me neno piny, en aye ma oketo gin aryonu ducu.<verse eid="PRO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 20:13" />Pe ibed kanino anina, miyo idoko lacan; yab wangi itii tic, ci ibibedo ki cam madwong.<verse eid="PRO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 20:14" />Lawil ngur bot lacatwil kun waco ni, “Wel rac, wel rac” ento ka dong okato ocito woko ci nyate ni kidwoke wel maber.<verse eid="PRO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 20:15" />Kace ingeyo gin ma itye kalok ikome, ci itye giri ki gin me wel makato jabu ki godi me welgu.<verse eid="PRO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 20:16" />Pore me gamo ginaruka pa dano ma ocung pi banya pa dano mo ata, dok ber me mako gin ma en ocibo kace ocung pi banya pa jo ma gin lurok.<verse eid="PRO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 20:17" />Jami ma dano nongo i yo me bwola bedo lim alima bote, ento lacen bibedo calo kweyo mupong idoge.<verse eid="PRO 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 20:18" />Yub ducu cobe maber ka kong ityeko nongo tam mabeco ma oromo; pe icit ilweny ka pe iyube maber.<verse eid="PRO 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 20:19" />Ngat ma bedo kawire ki lok me kwot ikin dano tucu mung woko; pimeno pe myero iribe ki ngat ma loko lok mapol.<verse eid="PRO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 20:20" />Kace ngat mo oceno wone nyo mine, ci kwone bitum woko macalo mac tara ma to woko i colpiny.<verse eid="PRO 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 20:21" />Lonyo ma dano limo oyotoyot i acaki pe gibilimo iye gum i agikine.<verse eid="PRO 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 20:22" />Pe myero iwac ni, “Abiculu wang gin marac ma kitimo ikoma”; ber iket gen ma meri ikom Rwot, ci en bikonyi.<verse eid="PRO 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 20:23" />Rwot dag jo ma gitiyo ki lapim jami ma pe pimo kakare; ki mijan ma pe pimo jami kakare me bwolo dano pe ber.<verse eid="PRO 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 20:24" />Rwot aye ma telo dano i yo me kwone; dano twero niang kit kwo ma etye kwede ningning?<verse eid="PRO 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 20:25" />Dano ma waco oyotoyot ni, “Man adyero bot Rwot”, ka dok tamo lacen ma nongo dong otyeko kwongo kwong, rom ki winyo ma omoko i owic.<verse eid="PRO 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 20:26" />Laloc maryek yeko jo maracu, ci miyo pwod ikomgi labongo dwoko cwinye.<verse eid="PRO 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 20:27" />Cwiny dano aye tara pa Rwot, ma menyo wa gin ducu ma okane i kwogi.<verse eid="PRO 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 20:28" />Rwot twero rii i loc kace tye ki mar me ada ki gen; dok bedo ki kit ma atir aye miyo komker cung matek.<verse eid="PRO 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 20:29" />Deyo ma co matino gitye kwede aye tek komgi, ento co ma oteggi kiworogi pi yer lwar ma otwi iwigi.<verse eid="PRO 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 20:30" />Adong ma keto ret ikom dano kwanyo gin marac woko; dok odoo ma kigoyo ki dano malit aye loko kwone.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 21:1" />Rwot aye maloyo cwiny laloc, macalo kulu ma mol, en loko piine mol cito kama en mito.<verse eid="PRO 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 21:2" />Dano neno ni gin ducu ma etimo tye atir ki tung bote, ento Rwot aye neno cwinye ka leng.<verse eid="PRO 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 21:3" />Tiyo gin ma atir, ki ngolo kop atir, yomo cwiny Rwot makato gitum.<verse eid="PRO 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 21:4" />Wang dano ma lakete, ki cwiny me wake, magi ducu bal; ento gin tye macalo tara ki bot jo maracu.<verse eid="PRO 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 21:5" />Ngat ma yubu yube ma nongo kong oketo i tam dok tiyo matek, bilimo jami madwong ata; ento ngat ma mito nongo lonyo aruya bibedo lacan.<verse eid="PRO 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 21:6" />Lonyo ma inongo ki loko lok goba duny woko macalo lupuu, dok tye calo owic ma tero dano ito.<verse eid="PRO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 21:7" />Jo maracu bito pi tim bwamigi, pien gukwero tiyo gin ma atir.<verse eid="PRO 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 21:8" />Jo ma lubalo giwoto i yo ma ogom, gitiyo gin ma pe atir; ento jo mabeco ma gipe ki bal mo gitiyo gin ma atir.<verse eid="PRO 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 21:9" />Bedo woko ite ot, ber kato ribo ot kacel ki dako ma lapyem.<verse eid="PRO 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 21:10" />Dano marac bedo ki miti i cwinye pi timo gin marac, ma nongo pe tye ki kica ikom lawote wa ki acel.<verse eid="PRO 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 21:11" />Kace kimiyo pwod ki ngat ma langala, ci ngat ma kwiya piny bene cako doko ryek; dano ma laryeko mako pwony ma kipwonye kwede, ci medo ngece doko dwong.<verse eid="PRO 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 21:12" />Lubanga ma kite atirni, neno odi pa jo maracu ki gin ma gitimo; ci bityekogi woko matwal.<verse eid="PRO 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 21:13" />Ngat ma dingo ite woko kawinyo koko pa lucan, en bene ka bikok pi kony, ngat mo pe biwinyo kokone wa ki acel.<verse eid="PRO 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 21:14" />Mot ma kimiyo laling i mung kweyo cwiny dano matye ki kiniga; ki lim ma kimiyo i mung me wilo dano kwanyo akemo madit woko.<verse eid="PRO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 21:15" />Ka ngolo kop woto kakare, jo ma kitgi atir bedo ki yomcwiny madwong, ento lutim maracu aye gibedo ki kumu.<verse eid="PRO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 21:16" />Dano ma ngak weko yo me niang maber bito, ci kiyiko woko nywako kabedo ki jo ma oto.<verse eid="PRO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 21:17" />Ngat ma lacam kwo bibedo lacan; ki ngat ma lamat matek ma mito mere kwo ma lamal pe bilony.<verse eid="PRO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 21:18" />Jo maracu gikelo can ma onongo gimito keto ikom jo ma kitgi atirni ikomgi ken gi.<verse eid="PRO 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 21:19" />Bedo i tim aroo ber, kato bedo kacel ki dako ma lapyem ma lakel ayela.<verse eid="PRO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 21:20" />Dano maryek bedo ki jami ma beco ki lonyo i pacone, ento dano ma ming tyeko lime woko ducu oyotoyot.<verse eid="PRO 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 21:21" />Ngat ma bedo ki leng cwiny dok ki kica, bibedo kwo pi kare malac; ci jo mapol bene gibiwore.<verse eid="PRO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 21:22" />Dano maryek twero mayo taun madit pa jo ma gin oteka woko, dok muku cel gogogi ma gigenoni reto woko piny lirum.<verse eid="PRO 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 21:23" />Ngat ma gwoke ikom lok ducu ma en loko, pe twero bedo ki ayela mo.<verse eid="PRO 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 21:24" />Langala aye dano ma lawake dok ma lakete, ma gin ma en tiyo ducu bedo tim me anywaranywar ki wake marac.<verse eid="PRO 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 21:25" />Miti ma lawackom tye kwede twero neke bene, pien en dag tiyo tic pi nongo gin ma en mito.<verse eid="PRO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 21:26" />Dano marac bedo ka paro jami pa jo mukene dyeceng ki dyewor benebene, ento dano ma kite atir miyo jamine me konyo jo mukene ki cwinye ducu.<verse eid="PRO 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 21:27" />Gitum ma dano marac otyero en gin me kwer bot Rwot; race bedo rom mene kace en tyero gitum bot Rwot ma nongo tye ki tam marac i cwinye?<verse eid="PRO 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 21:28" />Caden me goba pe kiye loke; ento dano ma loko lok ada, kiwinyo loke.<verse eid="PRO 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 21:29" />Dano marac poro bedo ngat cir ma tame atir, ento dano ma cwinye atir bedo katamo motmot ikom gin ma myero etim i lobo.<verse eid="PRO 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 21:30" />Ryeko, niang ki tam ma kimiyo me konyi, pe konyi ka ipyem ki Rwot.<verse eid="PRO 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 21:31" />Kitwero coko aguragura kacel ma dong kiyubugi pi kuru nino me lweny, ento loyo lweny twerone tye bot Rwot.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1" />Yer bedo ki nying maber, pien en aye ber kato lonyo madwong, dok pwoc ma dano gipwoyi kwede ber loyo ryal nyo jabu.<verse eid="PRO 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 22:2" />Pe tye apokapoka ikin lalonyo ki lacan, pien Rwot aye mucweyo gin aryonu ducu.<verse eid="PRO 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 22:3" />Dano ma wiye tiyo ka oneno gin ma rac bino ikome, kane woko; ento lakwiya piny mede mere ameda, ci neno can ada.<verse eid="PRO 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 22:4" />Mot ma dano limo pi bedo ki mwolo ki pi lworo Rwot, en aye lwak lonyo mapol, woro kacel ki kwo.<verse eid="PRO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 22:5" />Okutu ki owic tye i yo pa jo mungak: ento ngat ma gwoko kome pe biwok i yo meno.<verse eid="PRO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 22:6" />Pwony latin con ma nongo en pud tidi kit yo ma myero en obed kwede, ci ka en odongo pe biweko lubune.<verse eid="PRO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 22:7" />Ngat ma lacan bedo ite loc pa dano ma olony, ki ngat ma deno lim bedo opii pa won lim.<verse eid="PRO 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 22:8" />Ngat ma timo tim bwami limo can keken, dok tim me gerogi bidoko gin ma konye peke.<verse eid="PRO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 22:9" />Ngat ma wange leng ikom dano bilimo gum ma a ki bot Rwot, pien en poko came mogo ki lucan.<verse eid="PRO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 22:10" />Ryem ngat ma lacac woko, ci lweny bene bibedo peke boti, dok daa kacel ki anywar bene bigik woko.<verse eid="PRO 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 22:11" />Ngat ma bedo ki lengcwiny, ma loko lok maber me kica, bibedo larem rwot.<verse eid="PRO 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 22:12" />Rwot gwoko jo ducu ma gitye ki lok me ngec maber, ento en bolo yub pa jo ma gungayo wange woko.<verse eid="PRO 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 22:13" />Ngat ma lawackom bedo mere mot paco, en waco ni, “Labwor tye woko, ka akato miyo bineka woko iwanga yoo!”<verse eid="PRO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 22:14" />Lok pa dako ma lakwele obedo calo bur matut; ngat ma kiniga omako Rwot ikome bipoto woko i bur meno.<verse eid="PRO 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 22:15" />Mingo aye gin matye i cwiny latin matidi, ento ka ipwonye ki odoo, ci mingo a woko ki bote.<verse eid="PRO 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 22:16" />Ngat ma diyo lucan ni wek lonyone omede, nyo ma miyo jamine bot lulonyo keken, bidoko lacan.<verse eid="PRO 22:16" /></para>
  <para style="s">Lok pyere adek me ryeko</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 22:17" />Cik iti iwiny lok ma luryeko guwaco, dok myero iket cwinyi ikom ngec ma apwonyi kwede. <verse eid="PRO 22:17" /><verse number="18" style="v" sid="PRO 22:18" />Ka igwoko lok magi i cwinyi, ci bedo ber matek; kace ibipo ikomgi ci ibibolo lok ikomgi ikare ma mite. <verse eid="PRO 22:18" /><verse number="19" style="v" sid="PRO 22:19" />Dong amito ni igen Rwot, en aye gin ma omiyo atito lok magi boti tinni. <verse eid="PRO 22:19" /><verse number="20" style="v" sid="PRO 22:20" />Atyeko coyo lok abola pyere adek kun amiyi tam ma beco kacel ki ngec ma oromo, <verse eid="PRO 22:20" /><verse number="21" style="v" sid="PRO 22:21" />pi nyutu boti gin ma atir dok ada, wek in bene idwok lok ada bot jo mucwali.<verse eid="PRO 22:21" /></para>
  <para style="s">Lok mukwongo me ryeko</para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 22:22" />Pe myero i yak jami pa lacan ni pien en lacan mamwa, nyo kadi me tic ki anywar ikom jo ma gitye ki can i kabedo me ngolo kop; <verse eid="PRO 22:22" /><verse number="23" style="v" sid="PRO 22:23" />pien Rwot bipido pirgi, bineko jo ma guyakogi woko.<verse eid="PRO 22:23" /></para>
  <para style="s">Lok me aryo me ryeko</para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 22:24" />Pe myero i mak larem ki dano ma kiniga mako oyotoyot; dok pe myero i wot kacel ki dano ma cwinye opong ki akemo tutwal, <verse eid="PRO 22:24" /><verse number="25" style="v" sid="PRO 22:25" />weko ibilubu kite ducu ci imoko i owic.<verse eid="PRO 22:25" /></para>
  <para style="s">Lok me adek me ryeko</para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 22:26" />Pe myero ibed ngat acel ikom jo ma gijengo jamigi, ma gicung pi jo ma lubanya. <verse eid="PRO 22:26" /><verse number="27" style="v" sid="PRO 22:27" />Kace pe itye ki gin mo ma myero icul kwede banya, ci kimayo kitandani ma ibutu iyeni woko.<verse eid="PRO 22:27" /></para>
  <para style="s">Lok me angwen me ryeko</para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 22:28" />Pe myero ikob got macon ma poko wang lobo mayam kwariwu dong gutyeko ketone.<verse eid="PRO 22:28" /></para>
  <para style="s">Lok me abic me ryeko</para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 22:29" />Itye kaneno dano makwiri i tice? En bibedo katic wa inyim luker; pe bitic inyim dano atagu.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s">Lok me abicel me ryeko</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1" />Ka ibedo kacam kacel ki rwot, myero iteme tutwal me keto woro ikome; <verse eid="PRO 23:1" /><verse number="2" style="v" sid="PRO 23:2" />kace ineno ni in lacam malac, ci omyero inen ni icamo kun iporo. <verse eid="PRO 23:2" /><verse number="3" style="v" sid="PRO 23:3" />Pe myero imwony laa pi came makur, mogo nongo tye katemo cwinyi.<verse eid="PRO 23:3" /></para>
  <para style="s">Lok me abiro me ryeko</para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 23:4" />Pe myero inek komi tutwal katiyo tic ma okato lacu ni wek inong lonyo; bed ki ryeko ma oromo weko itiyo kun iporo. <verse eid="PRO 23:4" /><verse number="5" style="v" sid="PRO 23:5" />Pien kare me rwenyo pa lonyo peke, ka iloke manok, ci inongo ni otyeko tuk orwenyo woko macalo ocur ma kemo polo.<verse eid="PRO 23:5" /></para>
  <para style="s">Lok me aboro me ryeko</para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 23:6" />Pe myero icam kwon pa dano ma ladur; pe i ket cwinyi ikom came makuri. <verse eid="PRO 23:6" /><verse number="7" style="v" sid="PRO 23:7" />En nongo tye kaparo pi wel came ki i cwinye.<note caller="+" style="f"><char style="fr" closed="false">23:7 </char><char style="ft" closed="false">Niang telok man tek i leb Ibru. </char></note> En waco ni, “Cam dok imat ba!” Kun nongo cwinye pe mito. <verse eid="PRO 23:7" /><verse number="8" style="v" sid="PRO 23:8" />Ka iniang tam me cwinye ci ibingoko kwon ma icamoni woko liweng, dok bibalo loki mamit ma i loko botegu ducu.<verse eid="PRO 23:8" /></para>
  <para style="s">Lok me abongwen me ryeko</para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 23:9" />Pe myero ilok lok me ryeko bot ngat ma laming, pien en pe twero niang ber pa lok ma iloko bote, cayo mere acaya keken.<verse eid="PRO 23:9" /></para>
  <para style="s">Lok me apar me ryeko</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 23:10" />Pe ikob got macon ma poko wang lobo nyo kadi donyo i poti pa jo ma won gi peke; <verse eid="PRO 23:10" /><verse number="11" style="v" sid="PRO 23:11" />pien Rwot ma lacungudwargi tek; en bipido pirgi kwedi, ci miyo lok loyi.<verse eid="PRO 23:11" /></para>
  <para style="s">Lok me apar wiye acel me ryeko</para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 23:12" />Ket cwinyi me winyo pwony ma ki pwonyi kwede, cik, iti bene me winyo lok me ngec.<verse eid="PRO 23:12" /></para>
  <para style="s">Lok me apar wiye aryo me ryeko</para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 23:13" />Pe ikwer pwonyo latin wek obed ki kit maber; ka igoye ki odoo pi pwonye pe bimiyo en to. <verse eid="PRO 23:13" /><verse number="14" style="v" sid="PRO 23:14" />Kace ipwonye kun igoye ki odoo kitmeno, ci i bilaro kwone ki i to.<verse eid="PRO 23:14" /></para>
  <para style="s">Lok me apar wiye adek me ryeko</para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 23:15" />Latina, kace ibedo ki ryeko i cwinyi, ci an bene cwinya bibedo yom. <verse eid="PRO 23:15" /><verse number="16" style="v" sid="PRO 23:16" />Abibedo ki yomcwiny ki tipu koma ducu, ka onongo iloko gin ma atir.<verse eid="PRO 23:16" /></para>
  <para style="s">Lok me apar wiye angwen me ryeko</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 23:17" />Pe myero ibed ki nyeko i cwinyi ikom lubalo, ento mede ki lworo Rwot nino ki nino. <verse eid="PRO 23:17" /><verse number="18" style="v" sid="PRO 23:18" />Adada kwoni matye anyim bibedo maber, dok geni bene pe kibibalo woko.<verse eid="PRO 23:18" /></para>
  <para style="s">Lok me apar wiye abic me ryeko</para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 23:19" />Latina winy loka, wek ibed ryek, dok iket tami pi lubu yo ma mite. <verse eid="PRO 23:19" /><verse number="20" style="v" sid="PRO 23:20" />Pe ibed ikin jo ma gin lumero ki kongo bwino, kadi bedo ikin jo ma luworo ma gin lucam ringo; <verse eid="PRO 23:20" /><verse number="21" style="v" sid="PRO 23:21" />pien lumero kacel ki luworo gibidoko lucan. Dok ka imaro cam ki nino keken ci ibiruku bongo ma oketoket.<verse eid="PRO 23:21" /></para>
  <para style="s">Lok me apar wiye abicel me ryeko</para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 23:22" />Winy lok pa woru ma onywali, dok pe myero i caa meni ka dong otii. <verse eid="PRO 23:22" /><verse number="23" style="v" sid="PRO 23:23" />Teme me bedo ki ada, ryeko, pwony, ki niang maber; ci inen ni pe ibologi woko. <verse eid="PRO 23:23" /><verse number="24" style="v" sid="PRO 23:24" />Latin ma kite atir miyo wone bedo ki yomcwiny madwong; ngat ma onywalo latin maryek bedo ki yomcwiny pire. <verse eid="PRO 23:24" /><verse number="25" style="v" sid="PRO 23:25" />Wek woru kacel ki meni gubed ma cwinygi yom, wek meni ma onywali obed ki yomcwiny.<verse eid="PRO 23:25" /></para>
  <para style="s">Lok me apar wiye abiro me ryeko</para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 23:26" />Latina, ket cwinyi ka mako lok ma awaci, dok inen kit kwona ducu wek obed lanyut ma biteli.<verse eid="PRO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 23:27" />Dako ma lakwele obedo bur matut; en tye wang it mading. <verse eid="PRO 23:27" /><verse number="28" style="v" sid="PRO 23:28" />Dakonu kane woko pi libo dano calo layak, dok en medo wel co ma gungayo wang Rwot doko dwong ikin dano.<verse eid="PRO 23:28" /></para>
  <para style="s">Lok me apar wiye aboro me ryeko</para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 23:29" />Abinyuti jo ma gitye ki can ki cwercwiny. Abinyuti jo gilaro lok ma gidaa matek. Abinyuti jo ma gilimo ret pi lweny ma wanggi ocek makwar. <verse eid="PRO 23:29" /><verse number="30" style="v" sid="PRO 23:30" />Meno aye jo ma girii kamato kongo bwino pi kare malac, ma gicito kamato kongo bwino ma kirubu makec. <verse eid="PRO 23:30" /><verse number="31" style="v" sid="PRO 23:31" />Pe imat kongo bwino ka dong odoko kwar, ma nongo tye karyeny aryenya i kikopo, dok donyo mapwot i i ngat matye kamatone. <verse eid="PRO 23:31" /><verse number="32" style="v" sid="PRO 23:32" />I agikine kayo i dano calo twol, kayo calo twol ororo matye ki kwir marac. <verse eid="PRO 23:32" /><verse number="33" style="v" sid="PRO 23:33" />Wangi bicako neno jami mapat mayam peya inenogi, dok pe ibitwero tamo kadi ki loko gin mo ma atir. <verse eid="PRO 23:33" /><verse number="34" style="v" sid="PRO 23:34" />Ibibedo calo ngat ma obutu piny idye nam, calo ngat ma oito malo iwi wir me mel. <verse eid="PRO 23:34" /><verse number="35" style="v" sid="PRO 23:35" />Ibiwaco ni, “Kigoya, ento pe alimo ret mo; kigoya, ento pe awinyo arem mo wa ki acel. Abico awene? Abicito kamato kongo bwino mukene dok aye.”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s">Lok me apar wiye abongwen me ryeko</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 24:1" />Pe myero nyeko omaki ikom jo ma gin lutim maracu, dok pe imar ribe kwedgi; <verse eid="PRO 24:1" /><verse number="2" style="v" sid="PRO 24:2" />pien tamgi ducu opong ki lok me tim bwami, ma nongo giloko lok ma keto can keken ikom dano.<verse eid="PRO 24:2" /></para>
  <para style="s">Lok me pyere aryo me ryeko</para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 24:3" />Ot ki gero pi ryeko, dok pi niang matut miyo cung matek liking; <verse eid="PRO 24:3" /><verse number="4" style="v" sid="PRO 24:4" />pi ngec ma dano moni tye kwede miyo pongo ode ki kit jami mabeco me wel ki lwak jami ma yomo cwiny.<verse eid="PRO 24:4" /></para>
  <para style="s">Lok me pyere aryo wiye acel me ryeko</para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 24:5" />Bedo ki ryeko ber kato bedo ki tekkom, jo ma gitye ki ngec bene gitwero cobo tiyo jami madito makato jo ma gitye ki teko. <verse eid="PRO 24:5" /><verse number="6" style="v" sid="PRO 24:6" />Kace itye ki lumii tam ma luryeko ci miyo itwero lweny maber, dok winyo tam mabeco ma dano gimiyo boti miyo iloyo lweny.<verse eid="PRO 24:6" /></para>
  <para style="s">Lok me pyere aryo wiye aryo me ryeko</para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 24:7" />Jo ma gin luming pe gitwero niang lok me ryeko kadi ki acel, pien tye malo tutwal ki tung botgi; pe gitwero waco lok kadi ki acel ka kitye kalaro lok ma pire tek.<verse eid="PRO 24:7" /></para>
  <para style="s">Lok me pyere aryo wiye adek me ryeko</para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 24:8" />Ngat ma bedo ki tam me timo gin marac ki lwonge ni lakelayela. <verse eid="PRO 24:8" /><verse number="9" style="v" sid="PRO 24:9" />Tam ma laming tamo bedo bal keken, dano ducu gidag ngat ma langala.<verse eid="PRO 24:9" /></para>
  <para style="s">Lok me pyere aryo wiye angwen me ryeko</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 24:10" />Kace cwinyi odoko nyap ikare ma ayelayela tye, ci tekoni nongo nok adada.<verse eid="PRO 24:10" /></para>
  <para style="s">Lok me pyere aryo wiye abic me ryeko</para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 24:11" />Omyero ilar kwo pa jo ma kingolo to iwigi labongo bal mo; lar kwogi ka kiywayogi me atera i kabedo me nek. <verse eid="PRO 24:11" /><verse number="12" style="v" sid="PRO 24:12" />Kace iwaco ni, “Nen, wan onongo pe wangeyo loke,” ento itamo ni Lubanga ma neno cwiny danoni pe biromo niang? Itamo ni en ngat ma neno kwowuni pe ngeyo? Itamo ni en pe biketo can ikom dano acel acel ma poro kit gin ma en otimo?<verse eid="PRO 24:12" /></para>
  <para style="s">Lok me pyere aryo wiye abicel me ryeko</para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 24:13" />Latina, cam moo kic, pien ber, dok moo kic ma cwer ki i pedakic lim matek ka ibilo. <verse eid="PRO 24:13" /><verse number="14" style="v" sid="PRO 24:14" />I yo acelu, ryeko bene tye kitmeno pi kwoni; kace inongo ryeko, ci ibedo ki gen ni kwoni me anyim bibedo maber, dok geni pe bigik.<verse eid="PRO 24:14" /></para>
  <para style="s">Lok me pyere aryo wiye abiro me ryeko</para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 24:15" />Pe ikane inget ot pa dano ma kite atir pi time rac; pe myero itim bwami ikom gange; <verse eid="PRO 24:15" /><verse number="16" style="v" sid="PRO 24:16" />pien dano ma kite atir kadi opot piny tyen abiro, dok pud twero a malo aye; ento ka can opoto ikom jo maracu ci tyekogi woko liweng.<verse eid="PRO 24:16" /></para>
  <para style="s">Lok me pyere aryo wiye aboro me ryeko</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 24:17" />Pe ibed ki yomcwiny ka ineno lakwori opoto i can, dok cwinyi pe obed yom ka ineno en yoke atata; <verse eid="PRO 24:17" /><verse number="18" style="v" sid="PRO 24:18" />pien Rwot bineno gin ma itimo, ci pe biyomo cwinye, ci miyo kwanyo kinigane woko ki ikom danoni.<verse eid="PRO 24:18" /></para>
  <para style="s">Lok me pyere aryo wiye abongwen me ryeko</para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 24:19" />Pe myero cwinyi ocwer pi jo ma gin lutim maracu, dok pe ibed ki mone ikom jo maracu; <verse eid="PRO 24:19" /><verse number="20" style="v" sid="PRO 24:20" />pien dano ma latim marac pe tye ki gen pi kwone pi kare me anyim; bitum woko calo tol tara ma lyel tum woko.<verse eid="PRO 24:20" /></para>
  <para style="s">Lok me pyere adek me ryeko</para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 24:21" />Latina, lwor Lubanga dok ilwor rwot bene, pe myero ijem ikomgi. <verse eid="PRO 24:21" /><verse number="22" style="v" sid="PRO 24:22" />Ka ijemo ci gibiketo can ikomi oyotoyot; dok anga ma ngeyo kit can ma bia ki bot Lubanga nyo ki bot rwot?<verse eid="PRO 24:22" /></para>
  <para style="s1">Lok mukene me ryeko</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Magi bene obedo lok mukene ma luryeko guwaco:</para>
  <para style="p" vid="PRO 24:23">Ngolo kop makun ilenge ikom ngat acel obedo gin marac. <verse eid="PRO 24:23" /><verse number="24" style="v" sid="PRO 24:24" />Ngat ma biwaco bot dano ma labal ni, “Pe itye ki bal mo kun bene gonye woko,” kibicene dok jo ducu bikwere woko. <verse eid="PRO 24:24" /><verse number="25" style="v" sid="PRO 24:25" />Ento lungolkop ma gimiyo pwod ikom lutim maracu gibibedo ki yomcwiny, dok gibilimo gum maber makato ducu.<verse eid="PRO 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 24:26" />Ngat mamiyo lagam ma atir meno aye larem me ada.<verse eid="PRO 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 24:27" />Mukwongo, kong ikwong tiyo tici matye woko, pur poto dok ipit iye ginapita ducu ma mite; ka lacen dong icak gero odi.<verse eid="PRO 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 24:28" />Pe ibed caden ma lagoba ikom lawoti ma pe ki bal; pe myero ibwol dano ki lok gobagoba. <verse eid="PRO 24:28" /><verse number="29" style="v" sid="PRO 24:29" />Pe myero iwac ni, “Abitimo gin ma en otimo ikomani bene ikome; abiculu wang gin ma dano meno otimo.”<verse eid="PRO 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 24:30" />Awoto akato ki inget poto pa dano ma lawackom, ki inget poto olok pa dano ma wiye oding; <verse eid="PRO 24:30" /><verse number="31" style="v" sid="PRO 24:31" />nen, potone ducu obake ki okutu keken; doo ayila oumu ngom woko, cele ma kigero ki got bene omuk orete woko piny. <verse eid="PRO 24:31" /><verse number="32" style="v" sid="PRO 24:32" />Ka aneno ci abedo ki tam matut pire; aneno dok omiya pwony madit. <verse eid="PRO 24:32" /><verse number="33" style="v" sid="PRO 24:33" /><note caller="-" style="x"><char style="xo" closed="false">24:33: </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">Car 6:10-11</ref></char></note>Ka ibutu inino manok, dok idolo cingi woko kayweyo, <verse eid="PRO 24:33" /><verse number="34" style="v" sid="PRO 24:34" />ci can bimaki macalo layak ma mako dano, ma oruke woko ki jami lwenye ducu.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Carolok mogo ma Solomon oloko</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Lok magi aye carolok pa Solomon ma lucoc pa rwot Kejekia gucoyo i buk.<verse eid="PRO 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 25:2" />Kimiyi deyo bot Lubanga pi jami ma en okano woko i mung ma pe nen, ento kimiyo deyo bot luker pi nyutu telok woko bot lwak kamaleng.<verse eid="PRO 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 25:3" />Pe itwero ngeyo gin ma rwot tye katamone, pien tame bor calo polo, dok tut calo pete te lobo.<verse eid="PRO 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 25:4" />Ka kiliyo ryal maber ce kikwanyo cete woko liweng, ci latet ryal twero yubu kwede gin mo ma munya maber. <verse eid="PRO 25:4" /><verse number="5" style="v" sid="PRO 25:5" />I yo acelu, ryem lumiitam maracu woko ki inyim rwot, pien bedo ki kit ma atir miyo komkere cung matek.<verse eid="PRO 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 25:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:6: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:8-10">Luk 14:8-10</ref>
      </char>
    </note>Pe ikete keni me bedo dano madit inyim laloc, dok pe myero ibed i kabedo pa jo madito. <verse eid="PRO 25:6" /><verse number="7" style="v" sid="PRO 25:7" />Pien bedo ber makato ka ki waci ni, “Bin malo kany i kabedo pa ludito,” ber kato ma ki dwoki i kabedo ma piny ma nongo kun itye inyim laloc.<verse eid="PRO 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 25:8" />Pe myero ikel adot ikom gin ma ineno ki wangi oyotoyot inyim jo me otkot. Kace ngat mo mukene ma oneno gin acelu okelo lok ma pat ci ibitimo ango?<verse eid="PRO 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 25:9" />Ka lok mo tye ikin in ki lawoti, myero wutyek loke ikin wun aryoni; wek munge pe otuc bot jo mukene. <verse eid="PRO 25:9" /><verse number="10" style="v" sid="PRO 25:10" />Wek pe omii lewic omaki, miyo nyingi bibale woko matwal. <verse eid="PRO 25:10" /><verse number="11" style="v" sid="PRO 25:11" />Lok ma kiloko kakare obedo calo jabu ma kimwono ikom ryal. <verse eid="PRO 25:11" /><verse number="12" style="v" sid="PRO 25:12" />Pwony ma laryeko juku ki dano ma winyo pwony ber makato gin mo me jabu ma kiyubu me deyo kom dano.<verse eid="PRO 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 25:13" />Lakwena ma gene kweyo cwiny jo ma guore calo pii ma ngic ikare me kac; en kweyo cwiny ludito ma loye kumeno.<verse eid="PRO 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 25:14" />Dano ma nyate ki mot ma en pe twero miyone obedo calo pol ki yamo ma bino labongo kot mo.<verse eid="PRO 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 25:15" />Diyo cwiny ki loko lok mot ki mwolo twero loko tam pa laloc dok miyo iloyo lok mapol kadi ka tek calo ngo.<verse eid="PRO 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 25:16" />Kace inongo moo kic, cam maromo ii keken, pien ka icamo ma okato kare miyo ingoko woko. <verse eid="PRO 25:16" /><verse number="17" style="v" sid="PRO 25:17" />Pe ibed kawot me limo lawoti i ode kare ki kare, miyo en biol woko kwedi ci cako kweri woko.<verse eid="PRO 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 25:18" />Lacaden ma tito lok goba ikom lawote obedo macalo odoo me lweny, nyo pala lucwan, nyo atero mabit.<verse eid="PRO 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 25:19" />Bedo ki gen ikom dano ma pe gene ikare me ayela obedo calo cam ki lak marem, onyo wot ki tyen ma ongol.<verse eid="PRO 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 25:20" />Ngat ma wero wer bot dano matye ki kumu mapek i cwinye rom ki ngat ma okwanyo ginaruka woko ki ikome inino ma piny ngic, dok tye macalo kado ma kiketo iwang bur.<verse eid="PRO 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 25:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:21: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:20">Rom 12:20</ref>
      </char>
    </note>Ka kec neko lakwori, miye kwon ocam; dok ka orwo pii neke, miye pii omati. <verse eid="PRO 25:21" /><verse number="22" style="v" sid="PRO 25:22" />Ka itimo kumeno, ci ibicoko lewic ibako iwiye, Rwot bene biculi pire.<verse eid="PRO 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 25:23" />Yamo ma kodo a ki tung kumalo kelo kot; lok me kwoto dano bene kelo kiniga.<verse eid="PRO 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 25:24" />Bedo woko ite ot kakeni ber kato bedo i ot kacel ki dako ma lapyem.<verse eid="PRO 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 25:25" />Lok maber me yomcwiny ma dano owinyo ma oa ki i lobo mabor, obedo calo pii ma ngic ma kweyo cwiny dano ma orwo oneko.<verse eid="PRO 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 25:26" />Dano ma kite atir ma oye tam pa jo maracu, cal ki wang it ma piine opong coto, ki wang it ma obale woko.<verse eid="PRO 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 25:27" />Pe bedo ber me camo moo kic madwong, dok bene bito dano ki lok mapol ni wek kipwoyi pe ber.<verse eid="PRO 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 25:28" />Kace pe itwero loyo kinigani, ci irom ki taun ma peke ki cel.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1" />Kit macalo pe opore pi pee me poto ikare me oro, onyo kot me cwer ikare me kac, kitmeno bene pe opore me woro dano ma laming.<verse eid="PRO 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 26:2" />Lok ma kiceni kwede pe twero timo gin mo ikomi kace pe ibalo, bedo calo winyo lakalagwec ma tuk yenge atata, dok calo aliboro ma tuk tware cito woko.<verse eid="PRO 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 26:3" />Kigoyo aguragura ki del, kitweyo dog kana ki ogwil, odoo aye kigoyo ki nge dano ma laming.<verse eid="PRO 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 26:4" />Pe idok ipeny pa dano ma ming marom ki mingone, miyo in bene i loke idoko laming calo en.<verse eid="PRO 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 26:5" />Tii ki dano ma ming marom ki mingone, wek pe otam pire kene ni eryek.<verse eid="PRO 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 26:6" />Ngat ma oro laming me cwalo lok kamo meno rom ma onguno tyene kekene dok tye kayenyo ayela ni obin ikome.<verse eid="PRO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 26:7" />Carolok ma luming giloko, cal ki tyen dano ma langolo ma lyere alyera ma konye dong peke.<verse eid="PRO 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 26:8" />Ngat ma woro laming rom ki dano ma otweyo gweng i latangdingo ma pe kitwero celo ki gin mo.<verse eid="PRO 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 26:9" />Carolok ma luming giloko, rom ki okutu ma ocobo cing lamero.<verse eid="PRO 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 26:10" />Won tic ma coyo laming nyo lamero me tic bote rom ki won atero ma bayo aterone akaka ikin dano mapol ata.<verse eid="PRO 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 26:11" />Ngat ma laming ma nwoyo tim mingone rom ki gwok ma loke dok kanango ngoke kekene.<verse eid="PRO 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 26:12" />Twero bedo yot me pwonyo ngat ma laming makato pwonyo ngat ma tamo ki icwinye kene ni eryek.<verse eid="PRO 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 26:13" />Dano ma lawackom bedo mere mot i ode, en waco ni, “Labwor tye iwanga yoo!”<verse eid="PRO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 26:14" />Dano ma lawackom bedo kaloke aloka iwi kitandane, macalo kika ma wire ikom pete.<verse eid="PRO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 26:15" />Lawackom lutu cinge i atabo; ento kwanyo cinge me tero cam idoge loye woko.<verse eid="PRO 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 26:16" />Dano ma lawackom nene kekene ni eryek ekato kadi wa jo abiro ma gitwero dok ipeny ki ryeko.<verse eid="PRO 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 26:17" />Ngat ma donyo i lok daa ma pe okemo en rom ki ngat ma mako gwok matye kakato akata ki ite.<verse eid="PRO 26:17" /></para>
  <para style="p">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />Ngat ma bwolo lawote kun waco ni, “An atye kaloko lok oree keken,” rom ki lapoya ma cwinyo mac iwi ot, nyo ma bayo atero ci neko dano.<verse eid="PRO 26:18-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 26:20" />Ka yen peke, miyo mac to woko; kama ngat ma maro kwoto dano pe iye, daa bene bedo peke.<verse eid="PRO 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 26:21" />Macalo bilo kano lodi mac, yen bene miyo mac lyel, dano ma maro daa bene tye kitmeno, miyo daa mede ameda.<verse eid="PRO 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 26:22" />Lok pa ngat ma lakwot dano mit calo cam ma kitedo makur atika, ma kimwonyo cito i ic kikome.<verse eid="PRO 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 26:23" />Dano ma loko lok mamit ki doge ma kun nongo tye ki tam marac i cwinye rom ki atabo lobo ma kideyo ki libi maryeny aryenya.<verse eid="PRO 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 26:24" />Ngat ma lakwori twero loko boti lok mamit ki doge nono kun nongo tye ki adagadaga i cwinye; <verse eid="PRO 26:24" /><verse number="25" style="v" sid="PRO 26:25" />kadi ka loko lok mamit ningo, pe iye loke, pien cwinye opong ki adagadaga keken. <verse eid="PRO 26:25" /><verse number="26" style="v" sid="PRO 26:26" />En twero umu adagadaga ma en tye kwede i cwinye ki bwola, ento lwak bineno gin marac ma en tiyo.<verse eid="PRO 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 26:27" />Ngat ma kwinyo bur bipoto iye; ki ngat ma cako loro got, got bipoto ikome.<verse eid="PRO 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 26:28" />Ngat ma loko lok goba bot lawote nongo dage, dok dano ma bwolo dano ki lok mamit kelo can keken.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 27:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:1: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 4:13-16">Yak 4:13-16</ref>
      </char>
    </note>Pe myero inyate kekeni pi nino ma diki, pien pe ingeyo gin ma bitime ikin tin ki diki.<verse eid="PRO 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 27:2" />Pe ipake keni ki lok ma i loko; wek ngat mukene aye opaki, kadi en larok.<verse eid="PRO 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 27:3" />Got pek, kweyo bene pek, ento ayela ma laming kelo pek makato ducu.<verse eid="PRO 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 27:4" />Akemo ger, dok kiniga nyayo nek; ento nyeko rac ma katogi ducu.<verse eid="PRO 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 27:5" />Juku dano atyer kamaleng ber kato mar ma kikano woko.<verse eid="PRO 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 27:6" />Kadi bed laremi ogoyi pud itwero geno en, ento ka lakwori obino me kwako kori, myero igwoke mada.<verse eid="PRO 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 27:7" />Ngat ma oyeng kwero camo moo kic, ento ngat ma kec neko kadi gin makec nongo lim alima idoge.<verse eid="PRO 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 27:8" />Dano ma weko gange a cito woko kamukene, rom ki winyo ma obwoto ode otuk ocito woko kamabor.<verse eid="PRO 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 27:9" />Moo wir ki gin ma ngwece kur miyo dano bedo ma cwinye yom, ento ayela balo cwiny dano woko marac.<verse eid="PRO 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 27:10" />Pe ibwot ngat ma laremi, nyo larem woru; dok ikare ma itye ki can pe myero icit i borpiny kayenyo kony bot wat. Lawoti matye cok twero konyi makato omeru matye kamabor.<verse eid="PRO 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 27:11" />Latina, bed ryek, wek iyom cwinya, wek anong lagam ma myero adok iye i lok ki ngat ma caya.<verse eid="PRO 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 27:12" />Dano ma wiye tiyo ka oneno gin marac bino ikome, ci kane woko; ento lakwiya piny mede mere ameda, ci neno can ada.<verse eid="PRO 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 27:13" />Gam ginaruka pa dano ma jengo jamine pi banya pa dano mo ata, dok ber imak en kikome ka onongo ocibo jami mo pi jo ma gin lurok.<verse eid="PRO 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 27:14" />Ngat ma a malo odiko con, ci cako lamo gum ikom lawote ki dwon malongo, kibiwaco ni en tye kaceno lawoteni acena.<verse eid="PRO 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 27:15" />Dako ma lapyem ma nyayo ayela rom ki ngido kot ma pe cok ikare me cwir. <verse eid="PRO 27:15" /><verse number="16" style="v" sid="PRO 27:16" />Dakonu jukune tek macalo juku yamo, dok tek macalo mako moo pongcing.<verse eid="PRO 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 27:17" />Nyonyo twero pako nyonyo lawote doko bit, kitmeno bene dano acel acel twero pwonyo lawote.<verse eid="PRO 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 27:18" />Ngat ma pito yat oduru ka ogwoko maber bicamo nyige, ki ngat ma kuru piny kun gwoko ladite maber dano biwore.<verse eid="PRO 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 27:19" />Kit macalo dano ka okulu wiye i pii neno kit ma etye kwede, cwiny dano bene nyutu kit ma kit dano meno tye kwede.<verse eid="PRO 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 27:20" />Dano ma pe twero yeng ki gin ma iye mito, obedo calo lyel ma pe yeng ki jo ma oto.<verse eid="PRO 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 27:21" />Ryal ki jabu kilenyo i ruk mac wek kinen ka leng, dong ber pa dano nen ikit ma jo mukene gipake kwede.<verse eid="PRO 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 27:22" />Kadi bed igo laming ma kun iodo ki lalek i pany, ci pud mingo matye iwiyeni pe bia wa ki acel.<verse eid="PRO 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 27:23" />Myero igwok romini dok ingegi maber, ket cwinyi bene kagwoko dyangini: <verse eid="PRO 27:23" /><verse number="24" style="v" sid="PRO 27:24" />pien lonyo pe bedo matwal, dok ker bene pe rii nakanaka pi yalwak ducu. <verse eid="PRO 27:24" /><verse number="25" style="v" sid="PRO 27:25" />Ka kinyaro lum pi pito lee, ci lum ma nyen dok cako lot, ka dok ki nyaro lum ma olot iwi godi ci kigwoko. <verse eid="PRO 27:25" /><verse number="26" style="v" sid="PRO 27:26" />Itwero yubu bongini nia ki ikom yer romini, dok itwero wilo ngom ki ciling ma inongo ki ikom dyegini. <verse eid="PRO 27:26" /><verse number="27" style="v" sid="PRO 27:27" />Ibinongo cak ma oromo ma a ki ikom dyegini, maromo pito jo ma i odi ducu, dok biromo gwoko anyira ma gin angecani ducu.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="s1">Jo maracu ki jo ma kitgi atir</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 28:1" />Jo maracu giringo woko aringa kadi bed pe ngat mo tye ka ryemogi, ento dano ma kite atir cwinye tek calo cwiny labwor.<verse eid="PRO 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 28:2" />Ka lobo obedo katimo bal ci luloce bedo mapol. Lobo twero cung matek dok bedo ki kuc ma rii nakanaka kace onongo tye ki luloc maryek ma giniang dok ma gitye ki ngec maber.<verse eid="PRO 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 28:3" />Laloc ma unu lucan obedo calo kot ma cwer ki pee ci balo cam woko liweng.<verse eid="PRO 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 28:4" />Jo ma gibwoto cik pa Lubanga gipako jo maracu, ento jo ma gigwoko cik pe gibedo ki cwak ikom jo maracu.<verse eid="PRO 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 28:5" />Jo ma lutim gin marac pe giniang ilok me ngolo kop atir, ento jo ma giworo Rwot giniang iye ducu maber.<verse eid="PRO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 28:6" />Dano ma lacan ma loko lok ada dok lagen ber kato lalonyo ma kite pe atir.<verse eid="PRO 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 28:7" />Latin ma gwoko cik nongo ngat maryek, ento latin ma mako larem ki dano ma konygi peke kelo lewic ikom wone.<verse eid="PRO 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 28:8" />Ngat ma medo lonyone ki gamo magoba ki bot jo ma gitye ki peko nongo tye kacokone pi ngat ma lakica ma konyo lucan.<verse eid="PRO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 28:9" />Ngat ma pe tero ite kawinyo lok me cik ki lubune, Rwot bene bikwero winyo legane woko.<verse eid="PRO 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 28:10" />Dano ma telo ngat ma cwinye atir me timo gin marac bipoto i bure kekene; ento ngat ma pe ki bal kibimiye lobo maber me bedo ginaleyane.<verse eid="PRO 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 28:11" />Dano ma olony tamo ki icwinye ni en eryek, ento dano ma lacan matye ki niang matut neno kit ma en tye kwede.<verse eid="PRO 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 28:12" />Ka jo ma kitgi atir aye gitye kaloc, ci dano gibedo ki deyo madit; ento ka jo maracu gitye kaloc, ci dano gikane woko akana.<verse eid="PRO 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 28:13" />Ngat ma kano bale ma pe tucu, pe bimede ki bedo ki kwo maber; ento ngat ma tucu bale ka bwoto timogi matwal aye kica bimako Lubanga ikome.<verse eid="PRO 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 28:14" />Dano ma lworo Rwot kare ducu tye ki gum; ento can bipoto ikom dano ma pe lubu cik pa Rwot.<verse eid="PRO 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 28:15" />Laloc ma maloyo lwak jo ma lucan i yo marac obedo calo labwor ma kok nyo nguu matye kalibo lee.<verse eid="PRO 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 28:16" />Laloc ma pe ki niang matut en ngat mager ma unu dano; ento ngat ma kwero lim ma kinongo i yo ma pe atir birii i lobo pi mwaka mapol.<verse eid="PRO 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 28:17" />Dano ma oneko lawote, myero kinek woko bene; pe myero ngat mo okonye.<verse eid="PRO 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 28:18" />Ngat ma loko lok ada dok lagen, Lubanga bilaro ki i gin marac ducu; ento ngat ma ngak woko ma pe lubu cik bipoto atura.<verse eid="PRO 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 28:19" />Ngat ma lapur matek twero limo cam mabup, ento ngat ma balo karene itimo tim ma konye peke can bimako malit.<verse eid="PRO 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 28:20" />Dano ma lagen bilimo gum madwong, ento ngat ma laro ni elony woko oyotoyot pe bibwot ki ipwod.<verse eid="PRO 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 28:21" />Poko kin dano pe ber; ento jo mukene gitwero timo roc pi gamo latin lim mo me wil imung.<verse eid="PRO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 28:22" />Dano ma lagem laro ni en aye ebed ki lonyo, ma pe ngeyo ni can cok bimake.<verse eid="PRO 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 28:23" />Ngat ma juku dano kibibedo kwede maber lacen, en loyo ngat ma pwoyo dano ki doge nono.<verse eid="PRO 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 28:24" />Ngat ma yako jami pa wone nyo pa mine kun waco ni, “Gin ma atimoni pe bal” nongo obedo ngat ma layak.<verse eid="PRO 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 28:25" />Dano ma laworo tugu mere daa ento ngat ma geno Rwot bilimo lonyo madwong.<verse eid="PRO 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 28:26" />Ngat ma gene kene ki itame meno laming; ento ngat ma lubu lok pa jo ma ryek bilare.<verse eid="PRO 28:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 28:27" />Ngat ma konyo lucan Rwot bimedo bote jami mapol, ento ngat ma kwero konyo lucan kibicene woko.<verse eid="PRO 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 28:28" />Ka jo maracu gitye kaloc, dano gikane woko akana, ento ka dong guto woko, jo ma kitgi atir ginya gimede ameda.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 29:1" />Ngat ma ki pwonyo jwijwi, ce mede ki kwero winyo pwony, ceng mo bipoto i can ma pe dok bibwot matwal.<verse eid="PRO 29:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 29:2" />Lwak gibedo ki yomcwiny, ka jo ma kitgi atir aye tye kaloc; ento ka jo maracu aye loyo lwak, ci lwak cur marac.<verse eid="PRO 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 29:3" />Latin ma maro ryeko kweyo cwiny wone, ento latin ma mako larem ki dako ma lakwele balo lime ducu itim me carocaro.<verse eid="PRO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 29:4" />Laloc ma ngolo kop kakare miyo kuc bedo tye i lobo, ento ngat ma gamo lim ma dano gimiye i mung balo lobo abala.<verse eid="PRO 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 29:5" />Ngat ma bwolo lawote ki lok doge meno nongo tye kaciko obwo ma bimako en kekene.<verse eid="PRO 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 29:6" />Dano ma latim marac gire moko i owic me bal ma en timo, ento ngat ma kite atir bedo ma opong ki yomcwiny.<verse eid="PRO 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 29:7" />Dano ma kite atir ngeyo gin ma myero pi ngat ma lacan; ento dano marac pe niang kit gin macalo meno wa ki acel.<verse eid="PRO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 29:8" />Jo ma lungala gitwero tugu ayela mamiyo gang lyeti woko, ma nongo jo maryek gikweyo meggi kiniga woko akweya.<verse eid="PRO 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 29:9" />Kace dano maryek tye kapido gin ki laming, laming bedo kalok anywaranywar ki yet, dok pe twero ling.<verse eid="PRO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 29:10" />Jo ma cwinygi puke pi oyo remo pa luwotgi, gidag neno ngat ma pe ki bal; gin jo maracuni giyenyo yo me rwenyo kwone woko.<verse eid="PRO 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 29:11" />Laming loko ki teko me dwone ducu ka kiniga omako, ento dano maryek juku kinigane motmot.<verse eid="PRO 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 29:12" />Kace dano ma laloc bedo kawinyo lok gobagoba, ci luditone ducu gibiloke gidoko jo maracu.<verse eid="PRO 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 29:13" />Dano ma lacan ki ngat ma unu lacan gitye ki gin acel ma romrom, gin aryoni ducu Rwot aye ma miyogi wang me neno.<verse eid="PRO 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 29:14" />Kace laloc ngolo kop atir kun paro pi lucan, ci birii kaloc matwal.<verse eid="PRO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 29:15" />Kace ipwodo latin ka obalo i yo me pwony bimiyo en doko ryek, ento ka itenyo latin liyak ma pe ipwonyo ci bikelo lewic iwi mine.<verse eid="PRO 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 29:16" />Ka jo maracu aye gitye kaloc ci dano gimede ameda ki timo bal; ento jo ma kitgi atir gibineno can ma poto ikomgi.<verse eid="PRO 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 29:17" />Pwony latini me bedo ki kit maber, ci ibibedo ma pe iparo gin mo; dok en bikweyo cwinyi bene.<verse eid="PRO 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 29:18" />Kama lok pa Lubanga pe iye me telo dano, lwak me lobo gipong ki bwami, ento Lubanga miyo gum ki jo ma gwoko cik.<verse eid="PRO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 29:19" />Ka ibedo kalok aloka keken bot latici miyo en pe pwonye, kadi bed en niang gin ma iloko bote, pe bilubu wa ki acel.<verse eid="PRO 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 29:20" />Ineno dano ma laro lok oyotoyot ma kun pe tamo gin ma etye kawacone? Itwero bedo ki gen ikom ngat ma laming makato en.<verse eid="PRO 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 29:21" />Ngat mamiyo jamine ducu bot latice kit macalo latice mito nia katinone, i agikine binongo ni laticu dong odoko lale jamine.<verse eid="PRO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 29:22" />Dano ma opong ki akemo kare ducu tugu mere daa nyo lweny, ki ngat ma kinigane lyet kelo ayela dok timo bal mapol ata.<verse eid="PRO 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 29:23" />Wake miyo dano poto i can, ento dano ma bedo mwol i cwinye jo mapol gibiworo.<verse eid="PRO 29:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 29:24" />Ngat ma larem lakwo nongo lamonene kekene dok dag kwone; pien kadi bed en owinyo lok ma kiceno ki dano, ci pe twero tucu lok ada.<verse eid="PRO 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 29:25" />Bedo kaparo gin ma dano tamo ikomi tye macalo owic, ento ngat ma geno Rwot bedo maber labongo ayela.<verse eid="PRO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 29:26" />Jo mapol gimito ni laloc opwogi, ento Rwot aye timo gin ma myero ki dano acel acel.<verse eid="PRO 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 29:27" />Dano ma kite atir dag ngat ma labal, dok jo maracu gidag ngat ma bedo ki kit kwo ma atir.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Lok me ryeko pa Agur</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Magi aye lok ki kwena ma Agur wod pa Jake me Maca oloko:</para>
  <para style="q1" vid="PRO 30:1">“Koma ool woko dong do ai Lubanga; koma ool dok onyot woko dong ai Lubanga.<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Adada an aming ma pe dong apore me bedo dano.</para>
  <para style="q1" vid="PRO 30:2">Pe atye ki kit niang mo wa ki acel macalo dano.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Pe apwonyo lok mo me ryeko,</para>
  <para style="q1" vid="PRO 30:3">dok pe angeyoni Lubanga obedo anga.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Anga ma dong oito iwi polo ka dok odwogo piny i lobo kany?</para>
  <para style="q1" vid="PRO 30:4">Anga ma otyeko mako yamo i cingeni?</para>
  <para style="q1" vid="PRO 30:4">Anga ma oboyo pii ki bongo?</para>
  <para style="q1" vid="PRO 30:4">Anga ma oketo agiki lobo ducu ma tyeni?</para>
  <para style="q1" vid="PRO 30:4">Nyinge anga, ki nying latine kono anga, ka ingeyo?<verse eid="PRO 30:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 30:5" />Lubanga cobo lok ducu ma en ociko ada; en tye macalo kwot pa jo ma giringo gilaro bote. <verse eid="PRO 30:5" /><verse number="6" style="v" sid="PRO 30:6" />Pe imed lok mukene ma pe en owaco ikom loke ma en owaco, miyo en bijuki dok nyutu kamaleng ni in lagoba.”<verse eid="PRO 30:6" /></para>
  <para style="s1">Carolok mukene</para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 30:7" />Lubanga, alegi imiya jami aryo ma pud peya ato: <verse eid="PRO 30:7" /><verse number="8" style="v" sid="PRO 30:8" />kwany lok me bwola ki goba woko ki idoga; pe amito imiya abed lacan nyo lalonyo; ento amito imiya jami ma oromo me gwoko kwona. <verse eid="PRO 30:8" /><verse number="9" style="v" sid="PRO 30:9" />Ka abibedo ki cam madwong mukato kare, miyo atwero kweri woko, kun awaco ni, “Rwot en anga?” Dok pe myero abed lacan, miyo akwalo kwo, ci apyedo nying Lubangana.<verse eid="PRO 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 30:10" />Pe myero ilok marac ikom latic bot rwode, miyo laticu biceni.<verse eid="PRO 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 30:11" />Tye jo mukene ma giloko lok me ceno won gi dok giloko lok marac ikom megigi.<verse eid="PRO 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 30:12" />Tye jo mukene ma ginene keken gi ni gitye labongo bal mo ikomgi, ento nongo gupong ki bal mapol ata.<verse eid="PRO 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 30:13" />Tye jo mukene ma ginene kun gitamoni gin aye giber makato, dok gicayo jo mukene!<verse eid="PRO 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 30:14" />Tye dano mogo ma gitimo tim gero matek ikom lucan, gubedo calo pala ma lakgi bit ma gineko ki lucan gityekogi woko ducu ki i lobo, gijwero bene jo ma piny obwoyogi woko ducu ki ikin dano.<verse eid="PRO 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 30:15" />Kwidi karadini tye ki anyirane aryo, ma gikok ni, “Miwa, miwa.”</para>
  <para style="p" vid="PRO 30:15">Tye jami adek ma pe twero yeng; tye jami angwen kulu ma pe giwaco ni, “Dong oromo”:<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />lyel, dako ma lalur,</para>
  <para style="q1" vid="PRO 30:16">ngom ma cwiyo pii madwong,</para>
  <para style="q1" vid="PRO 30:16">ki mac ma lyel ma pe twero waco bene ni, “Dong oromo.”<verse eid="PRO 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 30:17" />Dano ma ngalo wone ki ngat ma cayo mine, agak ma i laora kulu gibigolo wange woko dok acut bicamo kome woko.<verse eid="PRO 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 30:18" />Tye jami angwen ma abedo ki ur madit ikomgi; dok pe aniang kitgi, gin ene:<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />kit ma ocur tuk kwede ki i polo,</para>
  <para style="q1" vid="PRO 30:19">kit ma twol mol kwede ki ikom got,</para>
  <para style="q1" vid="PRO 30:19">kit ma mel woto kwede idye nam madit,</para>
  <para style="q1" vid="PRO 30:19">ki kit ma laco gin ki nyako gicako miti kwede.<verse eid="PRO 30:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 30:20" />Man aye kit pa dako ma lakwele: en timo abor, lwoko kome woko, ci waco ni, “An pe atimo bal mo.”<verse eid="PRO 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 30:21" />Tye jami adek mamiyo lobo yenge; tye jami angwen kulu ma lobo kikome pe twero ciro:<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />opii ka odoko rwot,</para>
  <para style="q1" vid="PRO 30:22">ki laming ka tye ki gin acama ducu ma iye mito,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />nyako ma kidag, ka kinyomo woko,</para>
  <para style="q1" vid="PRO 30:23">ki nyako angeca ka oleyo katyen min ot.<verse eid="PRO 30:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 30:24" />Tye jami angwen iwi loboni ma gitino mo, ento gitye ki ryeko madwong:<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Nginingini pe gitek,</para>
  <para style="q1" vid="PRO 30:25">ento gicoko cam me acamagi ikare me oro;<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />okile pe gitwoni oteka,</para>
  <para style="q1" vid="PRO 30:26">ento kabedogi tye ikom got;<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />bonyo pe tye ki rwot mo</para>
  <para style="q1" vid="PRO 30:27">ento pud gitware kun gilube aluba i dul ki dul.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Itwero mako lagwe i cingi,</para>
  <para style="q1" vid="PRO 30:28">ento pud ibinongo ni lagwe tye i gang pa luker.<verse eid="PRO 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 30:29" />Tye jami adek manen me deyo ka gitye kawot; tye jami angwen ma girye aryeya i rek ka giwoto:<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />labwor keken aye matye twon oteka makato lee mukene ducu</para>
  <para style="q1" vid="PRO 30:30">dok pe lworo lee mo wa ki acel;<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />twon gweno ma lanywar, nyok dyel,</para>
  <para style="q1" vid="PRO 30:31">ki rwot matye kawot ma ngate angata inyim lwake.<verse eid="PRO 30:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="PRO 30:32" />Kace onongo ming omaki, ma ibedo kakete malo piri keni, nyo ka ibedo ka tamo gin marac, ci myero i juk lebi cut. <verse eid="PRO 30:32" /><verse number="33" style="v" sid="PRO 30:33" />Ka ipwayo cak dyang ci inongo moo, ka itwomo um ngat mo matek ci remo kati cut, kitmeno bene ka itugu kiniga ki i cwiny dano mo, ci inyayo lweny cut.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Tam ma kimiyo bot laloc</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Magi aye lok pa Lemuel, rwot me Maca, ma mine opwonye kwede.<verse eid="PRO 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 31:2" />Latina, gin ango, abiwaci lok ango? In latina, an aye ma anywali, dok in ibedo lagam me legana bot Lubanga. <verse eid="PRO 31:2" /><verse number="3" style="v" sid="PRO 31:3" />Pe myero ityek teki woko ikom mon, pe iribe kwedgi pien gin jo ma gineko luker gityeko woko. <verse eid="PRO 31:3" /><verse number="4" style="v" sid="PRO 31:4" />Lemuel, mat pe opore pi luker, luker myero pe gumat kongo bwino, kadi luloc pe myero gubed ki miti me mato kongo makec; <verse eid="PRO 31:4" /><verse number="5" style="v" sid="PRO 31:5" />ka gumato miyo wigi wil woko ikom cik ma kiketo, dok bimiyo gingako pido pa jo ma gitye ki can ki gin ma myero botgi. <verse eid="PRO 31:5" /><verse number="6" style="v" sid="PRO 31:6" />Mii kongo makec bot ngat ma dong cok to, ki kongo bwino bot jo matye ki kumu pi can malit; <verse eid="PRO 31:6" /><verse number="7" style="v" sid="PRO 31:7" />wek gumat ci wigi owil woko ikom can gi, wek wigi pe opo ikom cwercwiny ma gitye kwede.<verse eid="PRO 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 31:8" />Lok pi jo ma pe gitwero lok pirgi ken gi, ki pi jo ma kituru twerogi.<verse eid="PRO 31:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 31:9" />Lok pirgi, dok ingol kopgi atir. Cung pi twero pa lucan ki jo ma piny obwoyogi.<verse eid="PRO 31:9" /></para>
  <para style="s">Dako ma kwiri ma kite atir</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 31:10" />Anga matwero nongo dako ma kwiri ma kite atir? En ber kato jami me welgu ducu.<verse eid="PRO 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 31:11" />Cware keto gene ducu ikome, pimeno cware pe bibedo lacan.<verse eid="PRO 31:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 31:12" />Dakonu timo cware maber, pe miye peko mo pi kare me kwone ducu.<verse eid="PRO 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 31:13" />En tiyo tic matek ki cinge, kun cweyo bongi me yer romo, ki mukene ma a ikom pamba.<verse eid="PRO 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 31:14" />En tye macalo lwak mel pa lucat, en kelo came nia ki kamabor.<verse eid="PRO 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 31:15" />En a malo dyewor ci yubu cam ki jo ma i ode ducu, ka dok poko tic ki angecane.<verse eid="PRO 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 31:16" />En neno lobo ci wilo woko wek epur iye oloke; man en wilo ki lim ma en onongo ma oa ikom tic matek ma en otiyo.<verse eid="PRO 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 31:17" />En dako matye ki kero ma kome mit bene i tice, en tye ki teko ma rome tic.<verse eid="PRO 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 31:18" />En bene tye kaneno ni tice me cat kelo bote magoba maber. Dok mac tarane bedo kalyel alyela wa i dyeworgu ducu ma pe to.<verse eid="PRO 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 31:19" />En wiyo ucine pire kene, dok en kikome aye cweyo bongine.<verse eid="PRO 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 31:20" />En gire konyo jo ma lucan, dok bene konyo jo ma piny obwoyogi.<verse eid="PRO 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 31:21" />En pe tye ki lworo mo pi jo ma i ode ikare me koyo, pien jo ma i ode ducu guruku bongo mapek me uci makwar.<verse eid="PRO 31:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 31:22" />En cweyo bongi me giume; bongine ducu obedo bongi camanini mabere ki ma lamarlamar.<verse eid="PRO 31:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 31:23" />Cware dong ngene mada bot jo ma i dog gang, ka obedo ikin ludongo me lobo.<verse eid="PRO 31:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 31:24" />Dakone cweyo bongi nia ki ikom pamba ci catogi woko; en bene poko del me tweyo pyer bot lucat.<verse eid="PRO 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 31:25" />En ruke ki tek kacel ki deyo, ma nongo pe tye ki lworo pi kare mabino anyimgu ducu.<verse eid="PRO 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 31:26" />En loko loke ducu ki ryeko, pwony ma en pwonyo ki dano bene obedo pwony me kica.<verse eid="PRO 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 31:27" />En tye kagwoko jo ma i ode ikit yo ducu ma mite, en pe lawackom.<verse eid="PRO 31:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 31:28" />Ka lutinone gua malo gilwonge ni lagumkom; cware bene lwonge ni lagumkom, dok pake matek kun waco ni,<verse eid="PRO 31:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 31:29" />“Mon mapol gutyeko tiyo tic mabeco makato, ento in itiyo dong ma ikatogi ducu.”<verse eid="PRO 31:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 31:30" />Pe igen dako ma labuta, ki ber kom dano konye peke; ento myero kipak dako ma lworo Rwot aye.<verse eid="PRO 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 31:31" />Myero kipwoye pi tic matek ducu ma en tiyo, dok myero jo ducu guwore pi tice magi ducu.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>