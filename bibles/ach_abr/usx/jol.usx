<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id" />
  <para style="h">JOEL</para>
  <para style="toc1">Buk pa Joel</para>
  <para style="toc2">Joel</para>
  <para style="toc3">Joe</para>
  <para style="mt2">Buk pa</para>
  <para style="mt1">JOEL</para>
  <para style="imt">Lanyut wilok madito ma i buk man</para>
  <para style="ip">Lanebi Joel obedo ngat ma lok kome mo ma kingeyo ma adii tutwal obedo peke, wa kare ma en okwo iye bene pe kingeyo ento kibyeko abyeka. Ento nen calo buk man pa Joel twero bedoni kicoyo ikine ka mwaka miya abic nio kwede mwaka miya angwen ma peya kinywalo Yecu Kricito. Man obedo ikare me loc pa jo Percia. Joel otito lok ikom kit ma bonyo ki peke pa kot bibalo kwede ki lobo Palestine. Joel oneno lanyut me bino pa Rwot ikare man ma bonyo ki two piny bitime iye, ma en aye kare ma Rwot bipwodo iye jo ma lujemo ma pe gilubu mitine ma atirni. Lanebi man cwalo lwongo pa Rwot bot dano kun waco botgi ni omyero gin gungut ikom balgi, ki bene nyutu botgi cikene me dwokogi cen ikwogi mayam con ki gum ma en bimiyo ki jone.</para>
  <para style="ip">Lok ma pire tek ma omyero kinen en aye cike pa Lubanga me cwalo Cwiny mere Maleng ikom jo ducu, co ki mon, jo matino ki jo ma otegi ducu maromrom.</para>
  <para style="iot">Lacim wilok madito ma i buk man</para>
  <para style="io1">Gemo me bonyo <char style="ior"><ref loc="JOL 1:1-2:17">1:1—2:17</ref></char></para>
  <para style="io1">Cike me roco lobo <char style="ior"><ref loc="JOL 2:18-27">2:18-27</ref></char></para>
  <para style="io1">Nino pa Rwot <char style="ior"><ref loc="JOL 2:28-3:21">2:28—3:21</ref></char></para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Man lok pa Rwot mayam obino bot Joel wod pa Petuel.<verse eid="JOL 1:1" /></para>
  <para style="s1">Dano gukumu pi bale pa cam ma i poto</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Wuwiny lok man, wun ludongo ma otegi,</para>
  <para style="q1" vid="JOL 1:2">wuter itwu, wun jo ducu ma wubedo i lobo man.</para>
  <para style="q1" vid="JOL 1:2">Gin macalo man kong yam dong otime</para>
  <para style="q1" vid="JOL 1:2">ikarewu, onyo ikare pa kwariwu?<verse eid="JOL 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Wutit pire bot lutinowu,</para>
  <para style="q1" vid="JOL 1:3">wek lutinowu gutit bot lutinogi,</para>
  <para style="q1" vid="JOL 1:3">ki likwayogi bene guwac bot yalwak ma bilubugi.<verse eid="JOL 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Gin ma bonyo adwek ocamo odong, bonyo abum ocamo woko.</para>
  <para style="q1" vid="JOL 1:4">Gin ma abum ocamo odong,</para>
  <para style="q1" vid="JOL 1:4">bonyo lagara ocamo woko.</para>
  <para style="q1" vid="JOL 1:4">Gin ma lagara ocamo odong,</para>
  <para style="q1" vid="JOL 1:4">labar ocamo otyeko woko liweng.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Wucoo woko, wun jo ma lumero, wukoki;</para>
  <para style="q1" vid="JOL 1:5">wukok matek, wun jo ducu ma mato kongo bwino,</para>
  <para style="q1" vid="JOL 1:5">pi kongo bwino malingoni,</para>
  <para style="q1" vid="JOL 1:5">pien dong kityeko nyig olok woko me yubu botwu kongo bwino malingoni.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="REV 9:8">Niy 9:8</ref>
      </char>
    </note>Pien lwak bonyo dong ocore i lobo ma calo rok matek<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fk">Rok matek </char> te loke ni mony me bonyo. </note> ma dong obino ka lweny ikom lobona,</para>
  <para style="q1" vid="JOL 1:6">mony matek ma pe kwane, lakgi tek calo lak labwor,</para>
  <para style="q1" vid="JOL 1:6">ki lakgi bene boco calo lagili lak min labwor.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Gubalo olokwa woko ducu, ki oduruwa bene gungido woko;</para>
  <para style="q1" vid="JOL 1:7">gupaco poke, gubolo woko piny,</para>
  <para style="q1" vid="JOL 1:7">janggi okwor woko matar ligwek.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Wukok, macalo nyako ma oruku bongo cola,</para>
  <para style="q1" vid="JOL 1:8">ma kumu pi cware ma pud onyome anyoma.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Gityer me moko kwon ki gityer amata ma omyero kikel i Ot pa Rwot dong peke.</para>
  <para style="q1" vid="JOL 1:9">Ajwaki ma lutic pa Rwot, gitye kakumu pien gityer me amiya bot Rwot dong peke.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Poti dong odong nono labongo gin mo iye,</para>
  <para style="q1" vid="JOL 1:10">obedo calo lobo ma dong tye kakumu.</para>
  <para style="q1" vid="JOL 1:10">Ngano ki cayiri obale woko,</para>
  <para style="q1" vid="JOL 1:10">nyig olok bene otwo woko omiyo kongo bwino dong peke,</para>
  <para style="q1" vid="JOL 1:10">moo pe pien Jeituni ducu dong gutwo woko liweng i poti.<verse eid="JOL 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Cwinywu myero otur, wun lupur, wukok matek,</para>
  <para style="q1" vid="JOL 1:11">wun lupur olok ki ngano ki cayiri;</para>
  <para style="q1" vid="JOL 1:11">pien cam me poto dong obale woko.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Olok oner,</para>
  <para style="q1" vid="JOL 1:12">oduru bene obale woko;</para>
  <para style="q1" vid="JOL 1:12">okwer pomegranat, ki otit ki acuga, yadi ducu ma i poto guner woko;</para>
  <para style="q1" vid="JOL 1:12">yomcwiny dong peke bot dano.<verse eid="JOL 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Wuruk bongo cola, wun ajwaki, wukok can,</para>
  <para style="q1" vid="JOL 1:13">wukok matek, wun lutic i keno tyer.</para>
  <para style="q1" vid="JOL 1:13">Wudony i ot, wubut i bongo cola,</para>
  <para style="q1" vid="JOL 1:13">wun lutic pa Lubanga.</para>
  <para style="q1" vid="JOL 1:13">Pien gityer me moko kwon ki gityer amata</para>
  <para style="q1" vid="JOL 1:13">dong kijuku kelogi woko i Ot pa Lubangawu.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Wukwer kare me rii kec,</para>
  <para style="q1" vid="JOL 1:14">wulwong coke madit me woro Lubanga.</para>
  <para style="q1" vid="JOL 1:14">Wucok ludongo ki jo ducu ma gibedo i lobo man,</para>
  <para style="q1" vid="JOL 1:14">wek gubin i Ot pa Rwot Lubangawu,</para>
  <para style="q1" vid="JOL 1:14">wek gukok bot Rwot.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:6">Ica 13:6</ref>
      </char>
    </note>Nino pa Rwot dong onyiko cok;</para>
  <para style="q1" vid="JOL 1:15">en nino ma Rwot dong bibalo lobo woko</para>
  <para style="q1" vid="JOL 1:15">nino meno bibino ki topiny madit atika.<verse eid="JOL 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Cam dong kibalo ki i nyimwa ma wangwa neno.</para>
  <para style="q1" vid="JOL 1:16">Yomcwiny ki um dong peke i Ot pa Lubangawa.<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Kodi otung woko i ngom kama kicoyogi iye,</para>
  <para style="q1" vid="JOL 1:17">dula odong nono;</para>
  <para style="q1" vid="JOL 1:17">dero ducu obale woko, pien ngano pe ocek.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Winy kit ma lee cur kwede!</para>
  <para style="q1" vid="JOL 1:18">Piny oloyo dyangi woko,</para>
  <para style="q1" vid="JOL 1:18">pien kakwayogi dong peke;</para>
  <para style="q1" vid="JOL 1:18">wa romi bene gujony woko lingok.<verse eid="JOL 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />Akok boti, ai Rwot,</para>
  <para style="q1" vid="JOL 1:19">pien olet ma i tim kacel ki yadi ducu ma i poti</para>
  <para style="q1" vid="JOL 1:19">dong gutwo woko macalo mac aye dong owangogi.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Wa lee me tim ducu gikok boti,</para>
  <para style="q1" vid="JOL 1:20">pien pii ma i nota dong otwo woko,</para>
  <para style="q1" vid="JOL 1:20">mac dong owango olet ma i tim woko.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Bonyo obedo macalo gin me ciko dano pi nino pa Rwot</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Wukut tum; wugo oduru</para>
  <para style="q1" vid="JOL 2:1">i Cion, iwi got mera maleng!</para>
  <para style="q1" vid="JOL 2:1">Wuwek jo ducu mabedo i lobo komgi omyel,</para>
  <para style="q1" vid="JOL 2:1">pien nino pa Rwot tye kabino, dong cok.<verse eid="JOL 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2" />Bibedo nino me colpiny ki me mutu,</para>
  <para style="q1" vid="JOL 2:2">nino me pol ma ocido ki mutu macol licuc.</para>
  <para style="q1" vid="JOL 2:2">Lwak bonyo dong ocore i lobo mapol, calo rok madit, ma jone tego,</para>
  <para style="q1" vid="JOL 2:2">gumone iwi got macalo piny macol licuc.</para>
  <para style="q1" vid="JOL 2:2">Gin mo macalo man peya onen nia wacon,</para>
  <para style="q1" vid="JOL 2:2">dok pe binen i anyim</para>
  <para style="q1" vid="JOL 2:2">ikare pa yalwak ducu.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Macalo mac gin ginango cam woko ki i poti,</para>
  <para style="q1" vid="JOL 2:3">Inyimgi lobo nen calo poto Eden,</para>
  <para style="q1" vid="JOL 2:3">ento tung ngegi calo tim ma odong nono;</para>
  <para style="q1" vid="JOL 2:3">gin mo ma obwot iye peke.<verse eid="JOL 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:4: </char>
      <char style="xt" closed="false">
        <ref loc="REV 9:7-9">Niy 9:7-9</ref>
      </char>
    </note>Calgi nen calo aguragura,</para>
  <para style="q1" vid="JOL 2:4">giringo macalo aguragura me lweny.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Gipye iwi lacol godi,</para>
  <para style="q1" vid="JOL 2:5">kun gimor calo gadigadi lweny,</para>
  <para style="q1" vid="JOL 2:5">gimor calo leb mac ma wango reng kal ma otwo;</para>
  <para style="q1" vid="JOL 2:5">gical ki dul mony matek ma oyube pi lweny.<verse eid="JOL 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Rok ducu gitye ki remcwiny ka gunenoni gitye kabino,</para>
  <para style="q1" vid="JOL 2:6">wang jo ducu bale woko.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Gimwome ki ngwec macalo lulweny matek,</para>
  <para style="q1" vid="JOL 2:7">gimonyo taun madito kun giito ki iwi cel matego ma orumugi calo lumony.</para>
  <para style="q1" vid="JOL 2:7">Ngat acel acel lubu yone kene pe giwire giweko tyeng meggi.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Pe tye ngat mo ikin gi ma twomo lawote,</para>
  <para style="q1" vid="JOL 2:8">ngat acel acel lubu yone kene;</para>
  <para style="q1" vid="JOL 2:8">gicoro jami lweny ma kibayogi kwede,</para>
  <para style="q1" vid="JOL 2:8">gin mo peke ma jukugi.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Gimwome ikom taun madit, giringo iwi cel;</para>
  <para style="q1" vid="JOL 2:9">giito malo i odi,</para>
  <para style="q1" vid="JOL 2:9">giito ki iwang dirica macalo lakwo.<verse eid="JOL 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:10: </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:12">Niy 8:12</ref>
      </char>
    </note>Lobo yenge inyimgi ka giwoto,</para>
  <para style="q1" vid="JOL 2:10">polo bene yenge,</para>
  <para style="q1" vid="JOL 2:10">Ceng ki dwe gucido macol,</para>
  <para style="q1" vid="JOL 2:10">lakalatwe bene dong pe giryeny.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:17">Niy 6:17</ref>
      </char>
    </note>Dwon Rwot mwoc,</para>
  <para style="q1" vid="JOL 2:11">winye ki inyim monye;</para>
  <para style="q1" vid="JOL 2:11">monye tek makato dok bene pol atika.</para>
  <para style="q1" vid="JOL 2:11">Jo ma mako cike gibedo tek tutwal.</para>
  <para style="q1" vid="JOL 2:11">Adada nino pa Rwot dit, dok kelo atiba ikom dano;</para>
  <para style="q1" vid="JOL 2:11">anga mono matwero ciro?<verse eid="JOL 2:11" /></para>
  <para style="s1">Kilwongo dano me ngut ikom balgi</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />Rwot kikome owaco ni, “Kombedi dong,</para>
  <para style="q1" vid="JOL 2:12">wudwog bota ki cwinywu ducu,</para>
  <para style="q1" vid="JOL 2:12">kun wurii kec, ki koko, dok ki kumu madwong.<verse eid="JOL 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Pe wuyec ginaruka mewu, ento wulok cwinywu aye.”</para>
  <para style="b" vid="JOL 2:13" />
  <para style="q1" vid="JOL 2:13">Wudwog bot Rwot Lubangawu,</para>
  <para style="q1" vid="JOL 2:13">pien en latim kica,</para>
  <para style="q1" vid="JOL 2:13">en won kica madwong.</para>
  <para style="q1" vid="JOL 2:13">Kiniga pe make oyot,</para>
  <para style="q1" vid="JOL 2:13">mar mere ma pe loke dwong, dok loko tame pe timo gin marac.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />Anga ma ngeyo ka pe biloko tame,</para>
  <para style="q1" vid="JOL 2:14">ci biweko camwu cek mapol,</para>
  <para style="q1" vid="JOL 2:14">ci wubityero bote gityer me moko kwon ki gityer amata pi Rwot Lubangawu?<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Wukut tum i Cion,</para>
  <para style="q1" vid="JOL 2:15">wukwer kare me rii kec;</para>
  <para style="q1" vid="JOL 2:15">wulwong coke madit me woro Lubanga.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Wucok dano kacel.</para>
  <para style="q1" vid="JOL 2:16">Wulony lwak mucoke;</para>
  <para style="q1" vid="JOL 2:16">wugur ludongo kacel;</para>
  <para style="q1" vid="JOL 2:16">wucok lutino bene,</para>
  <para style="q1" vid="JOL 2:16">wa lukere ma gitye i kor.</para>
  <para style="q1" vid="JOL 2:16">Lanyom oa woko owek ode,</para>
  <para style="q1" vid="JOL 2:16">nyako ger bene owek kicikane.<verse eid="JOL 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Wek ajwaki ma lutic pa Rwot gukok,</para>
  <para style="q1" vid="JOL 2:17">i dye dogola Ot pa Rwot ki keno tyer,</para>
  <para style="q1" vid="JOL 2:17">kun giwaco ni, “Ai Rwot, tim kica ki joni,</para>
  <para style="q1" vid="JOL 2:17">pe imii kingal ginaleyani,</para>
  <para style="q1" vid="JOL 2:17">pe imii nyinggi odok carolok me abola ikin lurok.</para>
  <para style="q1" vid="JOL 2:17">Pingo iweko rok mukene giwaco ni, ‘Lubangagi tye kwene?’”<verse eid="JOL 2:17" /></para>
  <para style="s1">Lubanga oroco lobo ocako ceko cam</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Omiyo nyeko omako Rwot pi lobone,</para>
  <para style="q1" vid="JOL 2:18">kica omake ikom jone.<verse eid="JOL 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19" />Rwot odok iye ki jone ni,</para>
  <para style="q1" vid="JOL 2:19">“Nen abimiyo botwu ngano ki kongo bwino ki moo,</para>
  <para style="q1" vid="JOL 2:19">ma wubiyeng kwede;</para>
  <para style="q1" vid="JOL 2:19">pe dok abiweko kingalowu ikin lurok.<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />Abiryemo mony ma gua ki tung kumaloni woko kamabor ki wun,</para>
  <para style="q1" vid="JOL 2:20">dok abiryemo monygi woko wa i lobo ma i aroo;</para>
  <para style="q1" vid="JOL 2:20">jo ma otelo yo bicore i nam me kado tung kunyango,</para>
  <para style="q1" vid="JOL 2:20">ki jo ma i ngegi bicore i nam Mediterranean ma tung kupotoceng.</para>
  <para style="q1" vid="JOL 2:20">Komgi ma okwok ma ngweni biduny marac.</para>
  <para style="q1" vid="JOL 2:20">Abityekogi woko pi gin ma gutiyo ikomwu.<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21" />Pe ilwor, wun poti;</para>
  <para style="q1" vid="JOL 2:21">wubed ki yomcwiny ki um,</para>
  <para style="q1" vid="JOL 2:21">pien Rwot dong otiyo tic madito pirwu!<verse eid="JOL 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOL 2:22" />Pe wulwor, wun lee me tim,</para>
  <para style="q1" vid="JOL 2:22">pien olet ma i tim dong olot.</para>
  <para style="q1" vid="JOL 2:22">Yadi tye kanyak,</para>
  <para style="q1" vid="JOL 2:22">oduru ki olok gitye kanyak maber.<verse eid="JOL 2:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Cwinywu obed yom, wun lutino me Cion,</para>
  <para style="q1" vid="JOL 2:23">cwinywu obed yom ikom Rwot Lubangawu;</para>
  <para style="q1" vid="JOL 2:23">pien omiyowu kot me cwir me kwanyo kop ikomwu,</para>
  <para style="q1" vid="JOL 2:23">omiyo kot ocwer pirwu madwong,</para>
  <para style="q1" vid="JOL 2:23">omiyowu kot me cwir ki me oro, kit macon.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Laro bipong ki kal me adina,</para>
  <para style="q1" vid="JOL 2:24">bur me kongo bwino ki me moo ducu, gibipong woko libyeny.<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />Abiculu wang mwaka ducu ma bonyo abum ocamo,</para>
  <para style="q1" vid="JOL 2:25">ki bonyo adwek, ki lagara, ki labar,</para>
  <para style="q1" vid="JOL 2:25">ma gin mony mera madit ma ceng acwalo i dyewu.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Wubicamo cam madwong dok wubiyeng,</para>
  <para style="q1" vid="JOL 2:26">wubipako nying Rwot Lubangawu,</para>
  <para style="q1" vid="JOL 2:26">ma otiyo kwedwu ikit me aura.</para>
  <para style="q1" vid="JOL 2:26">Jona pe dok kibiketo lewic ikomgi.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Wubingeyo ni an atye i dye Icrael,</para>
  <para style="q1" vid="JOL 2:27">dok ni an Rwot, an Lubangawu,</para>
  <para style="q1" vid="JOL 2:27">pe dok tye mukene.</para>
  <para style="q1" vid="JOL 2:27">Pe dok kibiketo lewic ikomwu.<verse eid="JOL 2:27" /></para>
  <para style="s1">Nino pa Rwot</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:28: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:17-21">Tic 2:17-21</ref>
      </char>
    </note>Lacen abicwalo Cwiny mera Maleng ikom jo ducu;</para>
  <para style="q1" vid="JOL 2:28">lutino awobewu ki anyirawu gibitito lok pa Lubanga,</para>
  <para style="q1" vid="JOL 2:28">jowu ma otii gibileko lek,</para>
  <para style="q1" vid="JOL 2:28">awobewu gibineno ginanyuta.<verse eid="JOL 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JOL 2:29" />Ikare meno abicwalo Cwiny mera wa ikom lutic ma co ki ma mon.<verse eid="JOL 2:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Abinyutu tango pi nino meno</para>
  <para style="q1" vid="JOL 2:30">i polo ki iwi lobo,</para>
  <para style="q1" vid="JOL 2:30">oyo remo ki mac ki yito ma duny bibedo tye.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:31: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:29">Mat 24:29</ref>; <ref loc="MRK 13:24-25">Mar 13:24-25</ref>; <ref loc="LUK 21:25">Luk 21:25</ref>; <ref loc="REV 6:12-13">Niy 6:12-13</ref></char>
    </note> Ceng bicido woko macol,</para>
  <para style="q1" vid="JOL 2:31">dwe bidoko remo</para>
  <para style="q1" vid="JOL 2:31">ma nongo nino pa Rwot madit makelo lworo peya oo.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:32: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:13">Rom 10:13</ref>
      </char>
    </note> Ento jo ducu ma gilwongo nying Rwot kibilarogi;</para>
  <para style="q1" vid="JOL 2:32">macalo Rwot yam owaco;</para>
  <para style="q1" vid="JOL 2:32">‘Jo mogo ma iwi got Cion ki i Jerucalem gibibwot.’”<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">Lubanga bingolo kop ikom rok ducu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1" />Rwot owaco ni,</para>
  <para style="q1" vid="JOL 3:1">“Nen, inino meno, ki ikare maca,</para>
  <para style="q1" vid="JOL 3:1">abidwoko gum me Juda ki me Jerucalem pien jo ma bibwot bibedo tye.<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />Abicoko rok ducu ma gin lumerok pa Juda, abikelogi i nota pa Yekocapat.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fk">Yekocapat </char> te loke “Rwot ngolo kop.” </note></para>
  <para style="q1" vid="JOL 3:2">Ci abingolo kop ikomgi ki kunu,</para>
  <para style="q1" vid="JOL 3:2">pi jona Icrael ma ginaleyana, pien gukeyogi woko ikin lurok,</para>
  <para style="q1" vid="JOL 3:2">dok gupoko lobona woko.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Gin gubedo kabolo kwir pi jo mera,</para>
  <para style="q1" vid="JOL 3:3">kun gicato awobi pi culu malaya,</para>
  <para style="q1" vid="JOL 3:3">dok gicato nyako me wilo kongo bwino wek gumat gumer kwede.<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:29-31">Ica 14:29-31</ref>; <ref loc="ISA 23:1-18">23:1-18</ref>; <ref loc="JER 47:1-7">Jer 47:1-7</ref>; <ref loc="EZK 25:15-28:26">Eje 25:15—28:26</ref>; <ref loc="AMO 1:6-10">Amo 1:6-10</ref>; <ref loc="ZEP 2:4-7">Jep 2:4-7</ref>; <ref loc="ZEC 9:1-7">Jek 9:1-7</ref>; <ref loc="MAT 11:21-22">Mat 11:21-22</ref>; <ref loc="LUK 10:13-14">Luk 10:13-14</ref></char>
    </note>Wun jo Turo ki jo Cidon, ki wun jo ducu ma i lobo Piliciti, gin ango ma wumito timo ikoma? Wun wumito culu wang kwor mo ikoma? Kace wubiculu, ci abidwoko cul me tim mewu iwiwu kenwu oyotoyot dok aruya bene. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Pien wukwanyo ryal mera ki jabuna, dok wutero jamina mabeco ma pirgi tego bota, ci wuketogi i ot jogiwu. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Wucato jo Juda ki jo me Jerucalem bot jo Grik, kun wuterogi kamabor ki wang lobo meggi. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />Ento koni abitwarogi malo wek gua woko ki i kabedo kama yam wucatogi iye; ci abitimo ikomwu kit mayam wutimo ikomgi. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Abiweko kicato lutino awobewu ki anyirawu bot jo Juda. Ci gin bicatogi bot jo Ceba, en rok matye kamabor. An Rwot dong atyeko waco.<verse eid="JOL 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Wutit lok man ikin rok ducu:</para>
  <para style="q1" vid="JOL 3:9">wuywak mony</para>
  <para style="q1" vid="JOL 3:9">wulyet cwiny oteka lweny;</para>
  <para style="q1" vid="JOL 3:9">wek lulweny ducu gurwa cok, gubin ka lweny.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:4">Ica 2:4</ref>; <ref loc="MIC 4:3">Mik 4:3</ref></char>
    </note>Wutet kweri dyang gudok pala lucwan,</para>
  <para style="q1" vid="JOL 3:10">wutet pala langol wulok gudok tong;</para>
  <para style="q1" vid="JOL 3:10">wupwony kadi wa lugorowu wek gudok oteka lweny.<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Wurune, wubin oyot,</para>
  <para style="q1" vid="JOL 3:11">wun rok ducu ma wutye kabedo ducu;</para>
  <para style="q1" vid="JOL 3:11">wucit, wugure kunu i nota pa Yekocapat.”</para>
  <para style="b" vid="JOL 3:11" />
  <para style="q1" vid="JOL 3:11">Ai Rwot, dong icwal cogi coni ka lweny ikomgi!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />“Wek rok ducu dong gumuke gubin,</para>
  <para style="q1" vid="JOL 3:12">gubin kany wa i nota pa Yekocapat.</para>
  <para style="q1" vid="JOL 3:12">An Rwot kikoma abibedo piny kunu kangolo kop ki rok ducu ma gitye cok.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13: </char>
      <char style="xt" closed="false">
        <ref loc="REV 14:14-16">Niy 14:14-16</ref>; <ref loc="REV 19-20">19—20</ref>; <ref loc="REV 19:15">19:15</ref></char>
    </note>Gin gicalo kal madong ocek<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Leb Grik coyoni </char><char style="fp" closed="false">Pien kare kac dong oromo. </char></note> woko i poto me akaya.</para>
  <para style="q1" vid="JOL 3:13">Wucit ikomgi macalo lapur cito kakayo kal.</para>
  <para style="q1" vid="JOL 3:13">Gin gicalo nyig olok madong kiduru opong i bur me anyona,</para>
  <para style="q1" vid="JOL 3:13">pien balgi dwong tutwal.”<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Lwak alip ki alip,</para>
  <para style="q1" vid="JOL 3:14">dong gucoke i nota me ngolo kop.</para>
  <para style="q1" vid="JOL 3:14">Pien nino pa Rwot dong tye cok, nino ma en bimiyogi iye pwod.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Ceng ki dwe bicido woko licuc,</para>
  <para style="q1" vid="JOL 3:15">lakalatwe bene pe gibiryeny.<verse eid="JOL 3:15" /></para>
  <para style="s">Lubanga bimiyo gum ki jone</para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 1:2">Amo 1:2</ref>
      </char>
    </note>Rwot mor ki i Cion,</para>
  <para style="q1" vid="JOL 3:16">dwone winye ki i Jerucalem,</para>
  <para style="q1" vid="JOL 3:16">polo ki lobo giyenge.</para>
  <para style="q1" vid="JOL 3:16">Ento Rwot aye kalare pa jone,</para>
  <para style="q1" vid="JOL 3:16">en kama jo Icrael gibwot iye.<verse eid="JOL 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />Rwot waco ni, “Kitmeno wun jo Icrael wubingeyo ni An a Rwot Lubangawu,</para>
  <para style="q1" vid="JOL 3:17">ma abedo i Cion ma got mera maleng,</para>
  <para style="q1" vid="JOL 3:17">Jerucalem bene bibedo maleng,</para>
  <para style="q1" vid="JOL 3:17">dok mony pa lurok dong pe biloyone matwal.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />Inino meno wi godi bipong ki poti olok,</para>
  <para style="q1" vid="JOL 3:18">ki dyangi bene bipong iwi cere ducu,</para>
  <para style="q1" vid="JOL 3:18">pii bipong kun mol ki i kulu ma i Juda ducu.</para>
  <para style="q1" vid="JOL 3:18">Wang it bigunye ki i Ot pa Rwot,</para>
  <para style="q1" vid="JOL 3:18">ci bipongo nota me Citim.<verse eid="JOL 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Ejipt bidoko tim aroo ata,</para>
  <para style="q1" vid="JOL 3:19">ki Edom bene bidoko obur,</para>
  <para style="q1" vid="JOL 3:19">pi timgi me gero ikom jo Juda,</para>
  <para style="q1" vid="JOL 3:19">pien guonyo remo pa jo ma peke ki bal i lobogi.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />Ento dano dong bibedo i Juda matwal,</para>
  <para style="q1" vid="JOL 3:20">ki i Jerucalem pi kare ducu.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Abiculu kwor me remogi,</para>
  <para style="q1" vid="JOL 3:21">pe abikwanyo kop woko ki ikom luting alii,</para>
  <para style="q1" vid="JOL 3:21">pien an Rwot abibedo i got Cion.”<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>