<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Biblica® Open Luganda Contemporary Bible 2014</book>
  <para style="h">Abaruumi</para>
  <para style="toc1">Ebbaluwa ya Pawulo Omutukuvu eri Abaruumi</para>
  <para style="toc2">Abaruumi</para>
  <para style="toc3">Bar</para>
  <para style="mt2">Ebbaluwa ya Pawulo Omutukuvu eri</para>
  <para style="mt1">Abaruumi</para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>Nze Pawulo, omuddu<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Omukkiriza eyeeteeka mu kifo ky’omuddu eri Kristo talina bwetwaze wadde eddembe erirye ku bubwe. Akola ebyo byokka mukama we by’alagira.</char></note> wa Yesu Kristo, Mukama waffe Kristo, nayitibwa okuba omutume, eyayawulibwa okubuulira Enjiri ya Katonda, <verse eid="ROM 1:1"/><verse number="2" style="v" sid="ROM 1:2"/>gye yasuubiriza mu bannabbi be mu byawandiikibwa ebitukuvu, <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>ebyogera ku Mwana we, eyava mu zadde lya Dawudi mu mubiri, <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>eyakakasibwa okuba Omwana wa Katonda mu maanyi aga Mwoyo Mutukuvu olw’okuzuukira kw’abafu, ye Yesu Kristo Mukama waffe. <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>Mu Yesu Kristo Mukama waffe, mwe twaweerwa ekisa, ne mpitibwa okuba omutume, amawanga gonna galyoke gamugondere mu kukkiriza ku lw’erinnya lye. <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>Nammwe muli mu abo abaayitibwa okuba abayigirizwa ba Yesu Kristo.<verse eid="ROM 1:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>Mpandikira abo bonna ababeera mu Ruumi, abaagalwa ba Katonda, abaayitibwa okuba abatukuvu.<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">abatukuvu kitegeeza omuntu ayawuliddwa.</char></note></para>
  <para style="b" vid="ROM 1:7"/>
  <para style="p" vid="ROM 1:7">Ekisa n’emirembe ebiva eri Katonda Kitaffe ne Yesu Kristo Mukama waffe, bibeerenga nammwe.<verse eid="ROM 1:7"/></para>
  <para style="s1">Pawulo Ayagala Okukyala mu Ruumi</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>Okusooka neebaza nnyo Katonda wange ku lwammwe mwenna, ku bwa Yesu Kristo, olw’okukkiriza kwammwe okunywevu okwogerwako mu nsi yonna. <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>Katonda gwe mpeereza n’omutima gwange gwonna nga mbulira Enjiri ey’Omwana we, ye mujulirwa wange, nga bwe mbasabira bulijjo, <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>nga mbegayiririra bulijjo mu kusaba kwange, ndyoke nsobole okubatuukako nga Katonda bw’anaayagala.<verse eid="ROM 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11"/>Kubanga neesunga nnyo okubalaba, ndyoke mbawe ku kirabo eky’omwoyo, mulyoke munywezebwe okutuuka ku nkomerero, <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>kwe kugamba: twezengamu amaanyi ffekka ne ffekka olw’okukkiriza kwe tulina. <verse eid="ROM 1:12"/><verse number="13" style="v" sid="ROM 1:13"/>Wabula njagala mumanye kino, abooluganda nti, Emirundi mingi nateekateeka okujja gye muli naye ne nziyizibwa okutuusa kaakano, ndyoke nkungule ebibala mu mmwe, nga bwe kiri mu mawanga amalala.<verse eid="ROM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14"/>Kubanga nnina ebbanja eri Abayonaani n’abatali Bayonaani, n’eri ab’amagezi n’eri abasirusiru, <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>era nammwe ab’e Ruumi kyenva njagala okubabuulira Enjiri.<verse eid="ROM 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>Enjiri tenkwasa nsonyi: kubanga ge maanyi ga Katonda agalokola buli muntu akkiriza, okusooka eri Omuyudaaya n’eri Omunnamawanga. <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>Kubanga mu yo obutuukirivu bwa Katonda bubikkulibwa. Obutuukirivu obwo butuweebwa olw’okukkiriza, olw’okukkiriza kwokka, nga bwe kyawandiikibwa nti, “Abatuukirivu banaabeeranga balamu lwa kukkiriza.”<verse eid="ROM 1:17"/></para>
  <para style="s1">Obusungu bwa Katonda eri Abantu</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>Kubanga obusungu bwa Katonda bubikkulibbwa okuva mu ggulu ku abo abatatya Katonda bonna n’abakaafiiri bonna ku bye bakola okuziyiza amazima okuvaayo. <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>Kubanga ebisoboka okumanyibwa ku Katonda bibabikkuliddwa, kubanga Katonda abibalaze byonna mu bujjuvu. <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>Kubanga okuviira ddala ku kutondebwa kw’ensi, ebintu bye ebitalabika, bwe buyinza bwe obutaggwaawo n’obwa Katonda bwe, bitegeerwa ne birabikira ddala mu by’obutonde bwe, abantu balyoke baleme kubaako na kya kwewolereza.<verse eid="ROM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21"/>Kubanga newaakubadde nga Katonda bamumanyi, tebaamugulumiza nga Katonda wadde okumwebazanga, naye ne bagobereranga ebitaliimu mu mpaka zaabwe, omutima gwabwe omusirusiru ne gujjuzibwa ekizikiza. <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>Beeyita ab’amagezi ne bafuuka abasirusiru, <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>ne bawanyisa ekitiibwa kya Katonda ataggwaawo okukifaananyiriza ekifaananyi ky’omuntu aggwaawo, n’eky’ebinyonyi, n’eky’ebirina amagulu ana n’eky’ebyewalula.<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>Katonda kyeyava abaleka, emitima gyabwe ne girulunkanira eby’obugwagwa ne bawemula emibiri gyabwe bokka na bokka. <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>Ne bafuula amazima ga Katonda okuba obulimba ne basinza era ne baweereza ebitonde, mu kifo ky’okusinza eyabitonda, eyeebazibwa emirembe n’emirembe. Amiina.<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>Katonda kyeyava abaleka ne beeyongera mu kwegomba kwabwe okw’obuwemu. Abakazi baabwe baawanyisa enkolagana yaabwe ey’obuzaaliranwa n’abasajja, ne bakola ebitali bya buzaaliranwa. <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>Abasajja nabo baalekayo okwegatta ne bakazi baabwe mu ngeri ey’obuzaaliranwa, ne bajjuzibwa obukaba ne beegatta ne basajja bannaabwe. N’ekyava mu bikolwa ebyo eby’obugwagwa, kwe kusasulibwa empeera esaanira okwonoona kwabwe.<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>Bwe baagaana okumanya Katonda, Katonda kyeyava abaleka ne babeera n’omutima omwonoonefu ne bakola ebitasaana. <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>Bajjuzibbwa obutali butuukirivu bwonna, n’ebibi, n’omululu, n’obukyayi, n’obuggya, n’obussi, n’entalo, n’obulimba, n’enkwe, n’okwogera ebitasaana, nga basala ku bannaabwe ebigambo, <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>era nga bageya, nga bakyawa Katonda, nga bavuma bannaabwe, nga bajjudde amalala n’okwekulumbaza, nga bagunjawo enkola y’ebikyamu, era nga bajeemera bakadde baabwe. <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>Tebategeera so tebalina kukkiriza, tebalina kwagala, era tebalina mutima gusaasira. <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>Newaakubadde nga bamanyi nga Katonda yagamba nti abantu abakola ebintu ng’ebyo balizikirizibwa, tebakoma ku kubikola kyokka, naye basiima n’abo ababikola.<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s1">Omusango Katonda Aligusala na Bwenkanya</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>Gwe anenya omuntu omulala, okola ebibi bye bimu ne by’onenyeza omuntu oyo. Kyonoova olema okubeera n’eky’okuwoza, kubanga bw’okola bw’otyo, weesalira wekka omusango. <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>Naye kaakano, tumanyi nga Katonda mutuufu okunenya abo abakola ebiri ng’ebyo. <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>Naye ggwe omuntu obuntu, akola ebiri ng’ebyo, kyokka n’onenya abantu abalala, olowooza nga Katonda alikuleka? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>Oba onyooma ekisa kya Katonda ekingi, n’okugumiikiriza kwe n’obukwatampola bwe? Tomanyi ng’ekisa kya Katonda kikuleeta mu kwenenya?<verse eid="ROM 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5"/>Naye olw’obukakanyavu bwo n’omutima oguteenenya, weeterekera ekiruyi ku lunaku lw’ekiruyi n’okubikkulirwa, Katonda lw’alisalirako omusango ogw’obutuukirivu. <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>Katonda aliwa buli omu empeera esaanira ebikolwa bye. <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>Aliwa obulamu obutaggwaawo abo abaakola obulungi, nga balina essuubi ery’okuweebwa ekitiibwa, ettendo n’obulamu obw’emirembe n’emirembe. <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>Naye abo abeenoonyeza ebyabwe, abajeemera amazima nga bagondera obutali butuukirivu, kiriba kiruyi na busungu. <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>Walibaawo ennaku n’okubonaabona ku buli mmeeme y’omuntu akola ebibi, okusookera ku Muyudaaya n’oluvannyuma ku Munnaggwanga. <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>Naye ekitiibwa n’ettendo n’emirembe biriba ku buli akola ebituufu, okusookera ku Muyudaaya n’oluvannyuma ku Munnaggwanga. <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>Kubanga Katonda tasosola mu bantu.<verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>Abo bonna abaayonoona olw’obutamanya mateeka, balizikirira; era n’abo bonna abaamanya amateeka ne boonoona, bwe batyo bwe balisalirwa omusango, okusinziira mu Mateeka. <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>Kuba abawulira obuwulizi amateeka, si be bejjeerera eri Katonda, wabula abo abakola bye galagira, be baliweebwa obutuukirivu. <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>Abaamawanga abatalina mateeka bwe bakolera mu buzaaliranwa ebintu eby’Amateeka, ebintu ebyo byennyini bifuuka amateeka gye bali, newaakubadde ng’Amateeka tegaabaweebwa. <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>Ekyo kiraga ng’Amateeka gawandiikibbwa mu mitima gyabwe, era kikakasa munda mu birowoozo byabwe, ng’emitima gyabwe giribasaliriza omusango oba okubejjeereza okusinziira ku ekyo kye bamanyi. <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>Kino kiribaawo ku lunaku Katonda kw’aliramulira abantu olw’ebyo bye baakisa, ng’enjiri yange bw’eri ku bwa Yesu Kristo.<verse eid="ROM 2:16"/></para>
  <para style="s1">Abayudaaya n’Amateeka</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>Abamu ku mmwe mweyita Bayudaaya. Mwesiga amateeka ne mwewaana nga bwe mumanyi Katonda. <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>Bwe musoma ebyawandiikibwa muyiga engeri Katonda gy’ayagala mweyise ne muzuula ekituufu. <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>Mukakasa nga bwe muli abakulembeze b’abazibe b’amaaso, era ettabaaza eri abo bonna abali mu kizikiza. <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>Naye olwokubanga, amateeka ga Katonda gatuwa amagezi n’amazima, mulowooza muyinza okuyigiriza abatali bagezi n’abaana abato. <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>Kale ggwe ayigiriza abalala, lwaki toyinza kweyigiriza wekka? Ategeeza abalala obutabba, tobba? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>Ategeeza obutayenda, toyenda? Akyawa ebifaananyi, si ggwe onyaga eby’omu masabo? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>Mwenyumiririza mu mateeka, naye ne muswaza Katonda olw’obutagatuukiriza. <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>Ekyawandiikibwa kigamba nti, “Olw’ebikolwa byammwe ebyo, erinnya lya Katonda kyelivudde livvoolebwa mu mawanga.”<verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>Okukomolebwa kugasiza ddala bw’okwata amateeka, naye bw’otagatuukiriza tewaba njawulo wakati wo n’atali mukomole. <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>Kale obanga atali mukomole akwata amateeka, talibalibwa ng’eyakomolebwa? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>Noolwekyo ataakomolebwa mu buzaaliranwa naye ng’akuuma amateeka, alikusaliza omusango gwe alina amateeka amawandiike n’otagatuukiriza ate nga wakomolebwa.<verse eid="ROM 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28"/>Okweyisa ng’Omuyudaaya ate nga wakomolebwa, tekikufuula Muyudaaya yennyini. <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>Okuba Omuyudaaya yennyini oteekwa okugondera amateeka. Okukomolebwa okutuufu kwe kukomolebwa okubaawo mu mutima, so si okw’omubiri. Omuntu ng’oyo atenderezebwa Katonda, so si abantu.<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="s1">Obwesigwa bwa Katonda</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>Kaakano olwo Omuyudaaya alina nkizo ki? Oba okukomolebwa kugasa ki? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>Kugasa nnyo mu ngeri nnyingi. Okusookera ddala, Abayudaaya be baateresebwa ebigambo bya Katonda.<verse eid="ROM 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3"/>Kituufu nti abamu ku bo tebakkiriza bigambo ebyo. Obutakkiriza bwabwe buliggyawo obwesigwa bwa Katonda, olw’okuba nga bo tebaalina kukkiriza? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>Tekisoboka. Katonda ye wa mazima, newaakubadde nga buli muntu yenna mulimba. Ebyawandiikibwa bigamba nti,</para>
  <para style="q1" vid="ROM 3:4">“Olyoke otuukirire mu bigambo byo,</para>
  <para style="q2" vid="ROM 3:4">era osinge bw’osala omusango.”<verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>Naye obanga obutali butuukirivu bwaffe bulagira ddala obutuukirivu bwa Katonda, tunaayogera ki? Kikyamu Katonda okutunyiigira era n’atubonereza? Mu kino njogera ng’omuntu. <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>Nedda, sikikyamu. Katonda alisalira atya ensi omusango? <verse eid="ROM 3:6"/><verse number="7" style="v" sid="ROM 3:7"/>Naye obanga obulimba bwammwe bweyongera okugulumiza Katonda, nga kiraga Katonda bw’ali ow’amazima, oyinza okwebuuza lwaki okyasalirwa omusango ng’omwonoonyi? <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>Era okyayinza okwongerako na kino nti tukolenga ebibi mulyoke muveemu ebirungi, ng’abamu bwe batuwaayiriza nti, bwe tugamba. Kyokka Katonda mwenkanya, era alibasalira nga bwe kibagwanira.<verse eid="ROM 3:8"/></para>
  <para style="s1">Tewali Mutuukirivu n’Omu</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>Bino byonna bitegeeza ki? Kitegeeza nti ffe Abayudaaya tuli bulungi nnyo okusinga abantu abalala bonna? Nedda, n’akatono. Ffenna tufugibwa kibi, ne bwe baba Abayudaaya oba Abaamawanga. <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>Ng’ebyawandiikibwa bwe bigamba nti:</para>
  <para style="q1" vid="ROM 3:10">“Tewali mutuukirivu n’omu.<verse eid="ROM 3:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11"/>Tewali ategeera</para>
  <para style="q2" vid="ROM 3:11">wadde anoonya Katonda.<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>Bonna baakyama,</para>
  <para style="q2" vid="ROM 3:12">bonna awamu baafuuka kitagasa;</para>
  <para style="q1" vid="ROM 3:12">tewali n’omu akola obulungi,</para>
  <para style="q2" vid="ROM 3:12">tewali n’omu.”<verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>“Emimiro gyabwe giringa entaana ezaasaamiridde,</para>
  <para style="q2" vid="ROM 3:13">n’emimwa gyabwe gijjudde obulimba.”</para>
  <para style="q1" vid="ROM 3:13">“Buli kigambo ekibavaamu kiri ng’obusagwa bw’omusota.”<verse eid="ROM 3:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14"/>“Emimwa gyabwe gijjudde okukolima n’obukyayi.”<verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>“Ebigere byabwe byanguwa okuyiwa omusaayi,<verse eid="ROM 3:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16"/>buli gye balaga baleka abantu baayo mu kuzikirira na mu nnaku njereere.<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>Tebamanyi kkubo lya mirembe.”<verse eid="ROM 3:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18"/>“N’okutya tebatya Katonda.”<verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>Tumanyi nga buli kyawandiikibwa mu mateeka, kyawandiikibwa ku lw’abo abafugibwa amateeka. Amateeka malambulukufu ku nsonga ezo, omuntu yenna aleme okwekwasa ensonga yonna, ate era ne Katonda okwongera okulaga ng’ensi yonna bwe yasobya. <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>Kubanga tewali n’omu aliweebwa obutuukirivu mu maaso ga Katonda olw’ebikolwa by’amateeka. Mu mateeka mwe tutegeerera ddala ekibi.<verse eid="ROM 3:20"/></para>
  <para style="s1">Obutuukirivu Buva mu Kukkiriza</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>Kale kaakano tutegeere ng’obutuukirivu bwa Katonda tebutuweebwa lwa kugondera Mateeka. Ekyo kikakasibwa Amateeka ne bannabbi. <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>Obutuukirivu bwa Katonda butuweebwa olw’okukkiriza Yesu Kristo. Katonda tasosola. <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>Ffenna twayonoona era tetusaanira kitiibwa kya Katonda. <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>Kyokka twaweebwa obutuukirivu bwa buwa olw’ekisa kye ekiri mu kununulibwa okuli mu Yesu Kristo; <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>Katonda yaweereza Kristo okuba omutango, bwe tukkiriza Kristo olw’omusaayi gwe yayiwa. Alaga obutuukirivu bwe mu kugumiikiriza ebibi ebyakolebwa edda, be bantu abaayonoona mu biseera biri eby’edda. <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>Kino kiraga Katonda bw’alaga okwaniriza kw’alina eri abantu mu biro bino, bwe baba n’okukkiriza mu Yesu.<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>Kale lwaki twenyumiriza? Tewali nsonga etwenyumirizisa. Lwa kuba nga twagoberera amateeka? Nedda, lwa kukkiriza. <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>Noolwekyo omuntu aweebwa obutuukirivu lwa kukkiriza so si lwa kugoberera mateeka. <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>Oba Katonda wa Bayudaaya bokka? Si ye Katonda w’amawanga amalala gonna? Weewaawo nabo Katonda waabwe. <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>Kubanga ye Katonda omu awa obutuukirivu abaakomolebwa, n’abo abataakomolebwa olw’okukkiriza kwabwe. <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>Kale amateeka tugaggyewo olw’okukkiriza? Kikafuuwe. Tunyweza manyweze.<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s1">Ibulayimu Yaweebwa Obutuukirivu lwa Kukkiriza</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>Kale kiki kye tunaayogera ku jjajjaffe Ibulayimu ku bikwata ku by’omubiri? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>Singa Ibulayimu yaweebwa obutuukirivu lwa bikolwa, yandyenyumirizza, naye si eri Katonda. <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/>Ebyawandiikibwa bitugamba bitya? Ibulayimu yakkiriza Katonda ne kimubalirwa okuba obutuukirivu.<verse eid="ROM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4"/>Omuntu bw’akola omulimu, asasulwa empeera ye. Empeera gy’aweebwa, teba kirabo. <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>Katonda tayinza kukusembeza olw’ebikolwa byo. Katonda asembeza aboonoonyi olw’okukkiriza kwe balina mu ye. <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>Kabaka Dawudi naye yayogera kye kimu ku muntu ono Katonda gw’awa obutuukirivu obutavudde mu bikolwa bye ng’agamba nti:<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>“Baweereddwa omukisa,</para>
  <para style="q2" vid="ROM 4:7">abasonyiyiddwa ebyonoono byabwe,</para>
  <para style="q2" vid="ROM 4:7">ne baggyibwako ebibi byabwe.<verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>Aweereddwa omukisa omuntu,</para>
  <para style="q2" vid="ROM 4:8">Mukama gw’atalibalira kibi.”<verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>Kale omukisa guno, gw’abakomole bokka oba n’abatali bakomole? Ebyawandiikibwa bitugamba nti okukkiriza kwa Ibulayimu kwamubalirwa okuba obutuukirivu. <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>Kale, kwamubalirwa kutya? Ng’akomolebbwa oba nga tannakomolebwa? Nedda si ng’akomolebbwa naye nga tannakomolebwa. <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>Akabonero ke yafuna ak’okukomolebwa, ye nvumbo ku butuukirivu olw’okukkiriza kwe, nga tannakomolebwa, alyoke abeere jjajja w’abo bonna abakkiriza nga si bakomole, nabo balyoke babalirwe obutuukirivu. <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>Ate era ye jjajja w’abantu bonna, abakomole, era abatambulira mu kkubo ery’okukkiriza, jjajjaffe Ibulayimu kwe yalina nga tannakomolebwa.<verse eid="ROM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>Ibulayimu n’ezzadde lye tebaaweebwa kisuubizo eky’okulya ensi yonna, ng’omugabo gwe, lwa kukwata mateeka. Katonda, ensi yagimusuubiza lwa butuukirivu obwamuweebwa olw’okukkiriza. <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>Kale obanga baweebwa obusika lw’amateeka, okukkiriza kuba tekugasa, era nga n’ekisuubizo tekirina makulu. <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>Katonda anyiiga Amateeka ge bwe gatagonderwa. Naye bwe wataba mateeka, tewaba mateeka ga kujeemera.<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>Noolwekyo ekisuubizo kijja lwa kukkiriza, kiryoke kiweebwe lwa kisa, eri ezzadde lyonna, so si ezzadde erigondera amateeka lyokka naye n’eri ezzadde erya Ibulayimu olw’okukkiriza; era oyo ye jjajjaffe ffenna. <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>Kyawandiikibwa nti, “Nkufudde jjajja w’amawanga amangi.” Ye jjajjaffe mu maaso g’oyo gwe yakkiriza, Katonda azuukiza abafu, era alaba ebitaliiwo ng’ebiriwo, era atonda ebintu ebiggya.<verse eid="ROM 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18"/>Katonda yasuubiza Ibulayimu abazzukulu bangi. Ne bwe kyalabika ng’ekitasoboka, Ibulayimu yalina okukkiriza mu Katonda, n’oluvannyuma n’abeera jjajja w’amawanga mangi, okusinziira ku ekyo ekyayogerwa nti, “Ezadde lyo bwe liriba.” <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>Teyatendewererwa mu kukkiriza, newaakubadde nga yali wa myaka nga kikumi, nga n’omubiri gwe munafu nnyo, ate nga ne Saala mugumba. <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>Teyabuusabuusa kisuubizo kya Katonda mu butakkiriza, naye yaweebwa amaanyi lwa kukkiriza; n’agulumiza Katonda. <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>Yakakasiza ddala nti Katonda kye yasuubiza asobola okukituukiriza, <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>era bwe kityo ne kimubalirwa okuba obutuukirivu. <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>Naye tekyawandiikibwa ku lulwe yekka nti, “Kyamubalirwa okuba obutuukirivu;” <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>naye era naffe, abakkiririza mu oyo eyazuukiza Yesu Mukama waffe mu bafu. <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>Kristo yaweebwayo okuttibwa olw’ebibi byaffe, n’azuukizibwa tulyoke tuweebwe obutuukirivu.<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s1">Emirembe n’Essanyu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>Kale nga bwe twaweebwa obutuukirivu olw’okukkiriza tulina emirembe ne Katonda, mu Mukama waffe Yesu Kristo, <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>era olw’okukkiriza mu Kristo tufunye ekisa kya Katonda mwe tubeera, era mwe twenyumiririza, nga tusuubira ekitiibwa kya Katonda. <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>Tetukoma ku ekyo kyokka, naye twenyumiririza ne mu kubonaabona, nga tumanyi ng’okubonaabona kutuyigiriza okugumiikiriza. <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>Era okugumiikiriza kututuusa ku mbala ennungi, n’embala ennungi ne zitutuusa ku ssuubi. <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>Era essuubi teritukwasa nsonyi kubanga Katonda atuwadde Mwoyo Mutukuvu ajjuza emitima gyaffe okwagala kwe.<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>Bwe twali tukyali banafu wakati mu bibi, Kristo yatufiirira ffe aboonoonyi. <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>Kizibu okufiirira omuntu omutuukirivu. Oboolyawo omuntu ayinza okwewaayo okufa ku lw’omuntu omulungi. <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>Kyokka Katonda alaga okwagala kwe gye tuli mu ngeri eno: bwe twali tukyali boonoonyi, Kristo n’atufiirira.<verse eid="ROM 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9"/>Kale obanga twaweebwa obutuukirivu olw’omusaayi gwe, alitulokola okuva mu busungu bwa Katonda. <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>Kale obanga bwe twali tukyali balabe ba Katonda twatabaganyizibwa naye mu kufa kw’Omwana we, bwe tutabagana naye tetulisingawo nnyo okulokolebwa olw’obulamu bwe? <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>So si ekyo kyokka, twenyumiririza mu Katonda, kubanga Katonda yaweereza Mukama waffe Yesu Kristo, mwe twatabaganyizibwa.<verse eid="ROM 5:11"/></para>
  <para style="s1">Okufa mu Adamu n’Obulamu mu Kristo</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>Ekibi kyajja mu nsi olw’omuntu omu, ne kireeta okufa mu nsi. Mu ngeri y’emu olw’okuba nga bonna baayonoona, bonna balifa. <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>Ekibi kyaliwo mu nsi ng’amateeka tegannabaawo. Kyokka Katonda teyagamba nti be balina okuvunaanyizibwa olw’ebibi byabwe, kubanga Amateeka gaali tegannabeerawo. <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>Kyokka okufa kwali kukyafuga okuva ku Adamu okutuusa ku Musa, nga kutwaliramu n’abo abataayonoona mu ngeri Adamu gye yayonoonamu. Mu ngeri endala, Adamu ali mu kifaananyi kya Kristo eyajja oluvannyuma. <verse eid="ROM 5:14"/><verse number="15" style="v" sid="ROM 5:15"/>Naye Katonda wa kisa nnyo, kubanga ekirabo kye yali agenda okutuwa, kyali kya njawulo ku kibi kya Adamu. Okwonoona kw’omuntu omu, Adamu, kwaleetera bangi okufa, kyokka ekisa kya Katonda n’ekirabo ekiri mu kisa ky’omuntu omu Yesu Kristo kyasukkirira nnyo ne kibuna mu bantu bangi. <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>Waliwo enjawulo nnene wakati w’ekibi kya Adamu n’ekirabo kya Katonda. Ekibi ekimu kyatuweesa ekibonerezo. Kyokka ekirabo kya Katonda kyatukkirizisa gy’ali, newaakubadde nga twonoona emirundi mingi. <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>Obanga olw’okwonoona kw’omuntu omu okufa kwabuna, abaliweebwa ekisa kya Katonda n’ekirabo eky’obutuukirivu, tebalisinga nnyo okufugira mu bulamu olw’omuntu omu Yesu Kristo?<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>Kale ng’abantu bonna bwe baasalirwa omusango olw’ekibi ekimu, bwe kityo n’olw’ekikolwa ekimu eky’obutuukirivu abantu bonna mwe baaweerwa obutuukirivu ne bafuna obulamu. <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>Obujeemu bw’omuntu omu bwafuula abangi okuba aboonoonyi. Bwe butyo n’obuwulize bw’omuntu omu Yesu, bulifuula bangi okuba abatuukirivu.<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>Amateeka gaatekebwawo, amaanyi g’ekibi galyoke galabisibwe. Kyokka ekibi bwe kyeyongera, ekisa kya Katonda kyo ne kyeyongera nnyo okusingawo. <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>Ng’ekibi bwe kyafugira mu kufa, n’ekisa kya Katonda kifugira mu butuukirivu ne kitutuusa mu bulamu obutaggwaawo mu Yesu Kristo Mukama waffe.<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s1">Okuba Abalamu mu Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>Kale tunaagamba tutya? Tweyongere okwonoona, olwo ekisa kya Katonda kiryoke kyeyongere? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>Kikafuuwe, kubanga ffe abaafa eri ekibi tuyinza tutya okweyongera okukikola? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>Oba temumanyi nga bonna bwe baabatizibwa mu Yesu Kristo, baafiira wamu naye? <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/>Bwe twabatizibwa twaziikibwa wamu ne Kristo. Nga Kristo bwe yazuukizibwa okuva mu bafu olw’ekitiibwa kya Kitaawe, naffe twafuna obulamu obuggya, era bwe tutyo tutambulirenga mu bulamu obwo obuggya.<verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>Obanga twegatta wamu naye mu kifaananyi eky’okufa kwe, bwe tutyo bwe tulyegattira awamu naye mu kuzuukira kwe. <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>Tumanyi kino nti omuntu waffe ow’edda yakomererwa wamu naye ku musaalaba, omubiri gw’ekibi guleme kuba gwa mugaso, tuleme kuddamu kuba baddu ba kibi. <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>Omuntu bw’afa aba takyafugibwa kibi.<verse eid="ROM 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8"/>Naye obanga twafiira wamu ne Kristo, tukkiriza nga tuliba balamu wamu naye <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>Tumanyi nti, nga Kristo bwe yazuukizibwa mu bafu, takyafa nate, okufa tekukyamufuga. <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>Okufa kwe yafa eri ekibi, yafa omulundi gumu, naye kaakano mulamu era mulamu ku bwa Katonda.<verse eid="ROM 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11"/>Bwe mutyo nammwe mwerowoozenga okuba abaafiira ddala eri ekibi, naye abalamu eri Katonda mu Kristo Yesu. <verse eid="ROM 6:11"/><verse number="12" style="v" sid="ROM 6:12"/>Noolwekyo ekibi kiremenga okufuga omubiri gwammwe ogufa, nga mugondera okwegomba kwagwo. <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>Temuwangayo bitundu byammwe eby’omubiri okukozesebwa ebitali bya butuukirivu eri ekibi, naye mweweereyo ddala eri Katonda, ng’abantu abalamu abaava mu bafu. Ebitundu byammwe eby’omubiri gwammwe bikozesebwe eby’obutuukirivu eri Katonda. <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>Temukkiriza kibi kwongera kubafuga, kubanga temukyafugibwa mateeka, wabula ekisa kya Katonda.<verse eid="ROM 6:14"/></para>
  <para style="s1">Baddu ba butuukirivu</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>Kale tukole tutya? Kale tukole ekibi kubanga tetufugibwa mateeka wabula ekisa kya Katonda? Kikafuuwe. <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>Temumanyi nga muba baddu b’oyo gwe muwulira? Muyinza okuba abaddu b’ekibi ne kibaleetera okufa, oba muyinza okuba abaddu abawulira Katonda n’abawa obutuukirivu. <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>Kyokka Katonda yeebazibwe kubanga mwabanga baddu ba kibi, naye bwe mwagondera okuyigiriza kwe mwayigirizibwa n’omutima gwammwe gwonna, ne mukugondera. <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>Noolwekyo mwasumululwa okuva mu kibi, ne mufuuka baddu ba butuukirivu abasanyusa Katonda.<verse eid="ROM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19"/>Njogera nga nkozesa olulimi olwa bulijjo kubanga mukyali banafu. Nga bwe mwawangayo ebitundu byammwe eby’omubiri okuba abaddu b’ebirowoozo eby’obugwagwa, ne mweyongeranga okukola ebitali bya butuukirivu, bwe mutyo muweeyo ebitundu byammwe eby’omubiri okuba abaddu b’obutuukirivu, nga mweweerayo ddala eri Katonda, mube batukuvu. <verse eid="ROM 6:19"/><verse number="20" style="v" sid="ROM 6:20"/>Bwe mwali abaddu b’ekibi, temwafugibwanga butuukirivu. <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>Kale mwagasibwa ki mu kukola ebintu ebyo, ebibaleetera ensonyi? Enkomerero yaabyo kufa. <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>Naye kaakano obanga mwasumululwa mu kibi, ne mufuuka baddu ba Katonda, ebivaamu bibatuusa ku kutukuzibwa, n’enkomerero bwe bulamu obutaggwaawo. <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>Empeera y’ekibi kwe kufa, naye ekirabo kya Katonda, bwe bulamu obutaggwaawo mu Yesu Kristo Mukama waffe.<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s1">Ekyokulabirako Ekiva mu Bufumbo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>Temumanyi abooluganda, kubanga njogera eri abamanyi amateeka, ng’amateeka gafuga oyo yekka akyali omulamu? <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>Ka mbawe ekyokulabirako: mu mateeka omukazi omufumbo, asigala nga wa bba, bba bw’aba ng’akyali mulamu. Naye bba bw’afa, omukazi oyo ng’asumuluddwa mu tteeka eribagatta. <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>Noolwekyo omukazi oyo bwe yeegatta n’omusajja omulala, bba ng’akyali mulamu, omukazi oyo anaayitibwanga mwenzi. Naye bba bw’afanga, olwo omukazi omufumbo anaabanga asumuluddwa mu tteeka, era taabenga mwenzi bw’anaafumbirwanga omusajja omulala.<verse eid="ROM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4"/>Nammwe baganda bange mwafa eri amateeka, muli ba mubiri gwa Kristo. Mwegatta ku Kristo eyazuukizibwa okuva mu bafu, tulyoke tubale ebibala ebisanyusa Katonda. <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>Kubanga bwe twali tukyafugibwa omubiri, okwegomba kw’ebibi kwakoleranga mu bitundu byaffe eby’omubiri olw’amateeka, era enkomerero kwali kufa. <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>Naye kaakano tetukyafugibwa mateeka. Tuli bafu eri ebyo ebyali bitusibye, era tebitulinaako buyinza. Noolwekyo tuyinza okuweereza Katonda mu ngeri empya eya Mwoyo Mutukuvu, so si mu nkola enkadde ey’amateeka.<verse eid="ROM 7:6"/></para>
  <para style="s1">Okulwanagana n’Ekibi</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>Kale tunaayogera ki? Amateeka kye kibi? Kikafuuwe. Singa tewaali mateeka, sanditegedde kibi. N’okwegomba kw’omubiri sandikutegeeredde ddala singa amateeka tegaagamba nti, “Teweegombanga.” <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>Ekibi kyeyambisa etteeka lino, ne kindeetera okwegomba okwa buli ngeri. Noolwekyo awatali mateeka, ekibi kiba kifu. <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>Edda nali mulamu awatali mateeka, naye etteeka bwe lyajja, ekibi ne kiramuka, n’okufa ne nfa. <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>Era ne nkizuula ng’etteeka eryali liteekwa okumpa obulamu, lye lyandetera okufa. <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>Ekibi kyeyambisa ekiragiro ekyo ne kinnimba, era ne kinzita. <verse eid="ROM 7:11"/><verse number="12" style="v" sid="ROM 7:12"/>Noolwekyo amateeka matukuvu, era n’ekiragiro kitukuvu, kiruŋŋamya era kirungi.<verse eid="ROM 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13"/>Kale ekirungi gye ndi, ate kye kyafuuka okufa? Nedda. Ekibi kye kyakozesa ekiragiro ekirungi kiryoke kinzite. Noolwekyo tulaba ekibi bwe kiri, ekibi ddala.<verse eid="ROM 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>Tumanyi ng’amateeka mwoyo, naye nze omuntu obuntu, natundibwa ng’omuddu nfugibwe ekibi. <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>Kubanga kye nkola sikimanyi. Kye njagala si kye nkola, naye kye nkyawa kye nkola. <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>Newaakubadde nga nkola kye mmanyi nga kikyamu, nzikiriza ng’amateeka malungi. <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>Noolwekyo si nze nkola ebintu ebyo ebibi, wabula ekibi ekiri mu nze. <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>Mmanyi nga mu nze, temuli kalungi n’akamu. Ne bwe njagala okukola ekirungi, tewali kirungi kye nkola. <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>Ekirungi kye njagala okukola si kye nkola, naye ekibi kye saagala kye nkola. <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>Naye obanga kye saagala kye nkola, si nze mba nkikola, wabula ekibi ekibeera mu nze.<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>Noolwekyo nzudde mu mateeka nga bwe njagala okukola ebirungi, ekibi kimbeera kumpi. <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>Mu nze mu muntu ow’omunda njagala nnyo okugondera amateeka ga Katonda. <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>Naye mu mubiri gwange gwonna, ndaba amateeka ag’enjawulo nga gawakana n’etteeka lya Katonda amagezi gange ge limanyi. Ekyo kinfuula omusibe w’amateeka ag’ekibi, ekikolera mu mubiri gwange. <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>Nga ndi muntu munaku! Ani alindokola mu mubiri guno ogugenda okufa? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>Kyokka Katonda yeebazibwe mu Yesu Kristo Mukama waffe.</para>
  <para style="p" vid="ROM 7:25">Nze kennyini mu birowoozo byange, ndi muddu w’amateeka ga Katonda era gwe mpeereza, newaakubadde ng’okwegomba kwange okw’omubiri, mpeereza etteeka ly’ekibi.<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s1">Obulamu Obuva mu Mwoyo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>Noolwekyo abo abali mu Kristo Yesu, tebaliiko musango; abo abatagoberera kwegomba okw’omubiri wabula ne bagoberera Omwoyo. <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>Kubanga etteeka ery’Omwoyo aleeta obulamu mu Kristo Yesu, lyannunula okuva mu tteeka ly’ekibi n’okufa. <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>Amateeka ga Musa kye gataayinza kukola, olw’okunafuyizibwa omubiri, Katonda yakikola mu Mwana we yennyini bwe yamutuma mu kifaananyi ky’omubiri ogw’ekibi, n’asalira ekibi omusango mu mubiri. <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>Ekyo kyabaawo, eby’obutuukirivu mu mateeka biryoke bituukirire mu ffe bwe tugondera Omwoyo, ffe abatatambulira mu mubiri naye abatambulira mu Mwoyo.<verse eid="ROM 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5"/>Abo abalowooleza mu mubiri balowooza bintu bya mubiri, naye abalowooleza mu Mwoyo balowooza bya Mwoyo. <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>Okulowooleza mu by’omubiri kwe kufa, naye okufugibwa Omwoyo bwe bulamu n’emirembe. <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>Kubanga okulowooza eby’omubiri kya bulabe eri Katonda. Ebirowoozo eby’omubiri tebiyinza kuwulira mateeka ga Katonda. <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>N’abo abafugibwa omubiri tebayinza kusanyusa Katonda.<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>Naye mmwe temufugibwa mubiri wabula mufugibwa Mwoyo, kubanga Omwoyo wa Katonda abeera mu mmwe. Era omuntu yenna bw’ataba na Mwoyo wa Kristo, oyo si wa Kristo. <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>Era obanga Kristo ali mu mmwe, omubiri gwammwe mufu olw’ekibi, ate ng’omwoyo gwammwe mulamu olw’obutuukirivu. <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>Era obanga Omwoyo w’oyo eyazuukiza Yesu okuva mu bafu abeera mu mmwe, oyo eyazuukiza Kristo mu bafu, alifuula emibiri gyammwe egifa okuba emiramu ku bw’Omwoyo we abeera mu mmwe.<verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>Noolwekyo abooluganda tulina ebbanja, so si eri omubiri okugondera bye gutulagira. <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>Kubanga bwe munaagobereranga omubiri, mugenda kufa. Naye bwe munnatta ebikolwa eby’omubiri, muliba balamu, <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>kubanga abo bonna abakulemberwa Omwoyo wa Katonda be baana ba Katonda. <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>Temwaweebwa mwoyo gwa buddu ate mutye, wabula mwaweebwa Omwoyo eyabafuula abaana, era ku bw’oyo tumukoowoola nti, “<char style="tl">Aba,</char> Kitaffe.” <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>Omwoyo yennyini akakasiza wamu n’omwoyo waffe nga bwe tuli abaana ba Katonda. <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>Kale nga bwe tuli abaana, tuli basika ba Katonda, era tulisikira wamu ne Kristo, bwe tubonaabonera awamu naye, tulyoke tuweerwe wamu naye ekitiibwa.<verse eid="ROM 8:17"/></para>
  <para style="s1">Ekitiibwa Ekijja</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>Okubonaabona kwe tubonaabona kaakano kutono nnyo bwe kugeraageranyizibwa n’ekitiibwa ekiritubikulirwa. <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>Ebitonde birindirira n’essuubi lingi ekiseera abaana ba Katonda lwe baliragibwa. <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>Kubanga ebitonde tebyafugibwa butaliimu nga byeyagalidde, wabula ku bw’oyo eyabifugisa, mu kusuubira. <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>Ebitonde birifuulibwa bya ddembe okuva mu kufugibwa okuvunda ne bigabanira wamu n’abaana ba Katonda ekitiibwa eky’okuba mu ddembe.<verse eid="ROM 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22"/>Tumanyi ng’ebitonde byonna bisinda era ne birumwa ng’omukazi alumwa okuzaala bw’abeera. <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>Naye ate si ekyo kyokka, era naffe abalina ebibala ebibereberye eby’Omwoyo, naffe tusinda munda yaffe nga tulindirira okufuuka abaana, kwe kununulibwa kw’emibiri gyaffe. <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>Twalokolebwa lwa ssuubi eryo. Naye essuubi erirabibwa si ssuubi; kubanga ani asuubira ky’alabako? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>Naye bwe tusuubira kye tutalabako, tukirindirira n’okugumiikiriza.<verse eid="ROM 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26"/>N’Omwoyo bw’atyo atubeera mu bunafu bwaffe. Tetumanyi kusaba nga bwe kitugwanira, naye Omwoyo yennyini atwegayiririra n’okusinda okutayogerekeka. <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>Oyo akebera emitima, amanyi Omwoyo ky’alowooza, kubanga yeegayiririra abatukuvu ng’okusiima kwa Katonda bwe kuli. <verse eid="ROM 8:27"/><verse number="28" style="v" sid="ROM 8:28"/>Era tumanyi nga eri abo abaagala Katonda, era abo abayitibwa ng’okuteesa kwe bwe kuli, ebintu byonna bibatuukako olw’obulungi. <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>Kubanga abo be yamanya olubereberye, yabalonda okufaananyizibwa mu kifaananyi ky’Omwana we, ye abeerenga omubereberye mu booluganda abangi. <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>Abo be yalonda, n’okubayita yabayita, n’abo be yayita, yabawa obutuukirivu, n’abo be yawa obutuukirivu yabagulumiza.<verse eid="ROM 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>Kale tunaagamba ki ku bintu bino? Katonda bw’abeera ku lwaffe, ani asobola okutulwanyisa? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>Oyo ataasaasira Mwana we ye, naye n’amuwaayo ku lwaffe ffenna, talituwa buwi bintu byonna awamu naye? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>Ani aliroopa abalonde ba Katonda? Katonda y’awa obutuukirivu. <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>Ani alibasalira omusango? Kristo Yesu yafa, kyokka okusinga byonna yazuukizibwa, era ali ku mukono ogwa ddyo ogwa Katonda, ng’atwegayiririra. <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>Ani alitwawukanya n’okwagala kwa Kristo? Kubonaabona, oba bulumi, oba kuyigganyizibwa, oba njala, oba kuba bwerere, oba kabi, oba kitala? <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>Kyawandiikibwa nti:</para>
  <para style="q1" vid="ROM 8:36">“Ku lulwo tutiisibwatiisibwa n’okuttibwa obudde okuziba,</para>
  <para style="q2" vid="ROM 8:36">era tubalibwa ng’endiga ez’okusalibwa.”<verse eid="ROM 8:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37"/>Naye mu bino byonna tuwangudde n’okukirawo ku bw’oyo eyatwagala. <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>Kubanga nkakasiza ddala nga newaakubadde okufa, wadde obulamu, wadde bamalayika, wadde abafuzi, wadde ebiriwo, wadde ebigenda okujja, wadde amaanyi, <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>wadde obugulumivu, wadde okukka wansi, wadde ekitonde ekirala kyonna, tewali kiriyinza kutwawukanya n’okwagala kwa Katonda okuli mu Kristo Yesu Mukama waffe.<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s1">Okulonda kwa Katonda</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>Njogera amazima mu Kristo, sirimba, omwoyo gwange nga gunkakasa mu Mwoyo Mutukuvu, <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>nga ndimunakuwavu nnyo era nga nnumwa mu mutima. <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>Nnali njagala nze mwene nkolimirwe Katonda era njawukanyizibwe ku Kristo olwa baganda bange, bwe tuli ab’omu mubiri, <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>be Bayisirayiri, abantu ba Katonda abalonde. Katonda yabalaga ekitiibwa kye, n’akola nabo endagaano, n’abawa n’amateeka ge. Yeekaalu yagibawa, n’abawa n’ebyasuubizibwa. <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>Balina bajjajjaabwe abamanyiddwa, Kristo be yasibukamu mu mubiri. Nsaba Katonda afuga byonna atenderezebwenga emirembe gyonna, Amiina.<verse eid="ROM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>Naye si kuba nti Katonda yalemwa okutuukiriza kye yasuubiza. Si bonna ab’omu Isirayiri nti bantu ba Katonda ddala. <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>Ate so si nti ly’ezzadde lya Ibulayimu bonna balyoke babeere abaana, naye ekisuubizo kyali ku Isaaka bwe kyagambibwa nti, “Mu Isaaka mwe ndituukiririza ebyo byonna bye nakusuubiza.” <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>Kino kitegeeza nti abaana ab’omubiri si be baana ba Katonda, wabula abo ab’okusuubiza be babalibwa okuba ezzadde lya Ibulayimu. <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>Kubanga ekigambo ky’okusuubiza kye kino nti, “Mu kiseera nga kino Saala alizaala omwana owoobulenzi.”<verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>Ate si ekyo kyokka, naye ne Isaaka jjajjaffe yalina Lebbeeka eyali olubuto. <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>Naye ng’abalongo tebannazaalibwa, era nga tebannabaako kye bakola kyonna ekirungi oba ekibi, okusiima kwa Katonda nga bwe kuli, <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>si lwa bikolwa wabula ku bw’oyo eyabayita, kyategeezebwa Lebbeeka nti, “Omukulu y’aliba omuweereza w’omuto.” <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>Era nga bwe kyawandiikibwa nti, “Yakobo namwagala, naye Esawu namukyawa.”<verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>Kale tunaagamba ki? Ddala ddala Katonda talina bwenkanya? Kikafuuwe. <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>Agamba Musa nti,</para>
  <para style="q1" vid="ROM 9:15">“Ndisaasira oyo gwe ndisaasira,</para>
  <para style="q2" vid="ROM 9:15">era ndikwatirwa ekisa oyo gwe ndikwatirwa ekisa.”<verse eid="ROM 9:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16"/>Noolwekyo tekiva ku ebyo omuntu by’ayagala newaakubadde by’akola, wabula ku kusaasira kwa Katonda. <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/>Ebyawandiikibwa kyebyava byogera ku Falaawo nti, “Kyennava nkuyimusa, ndyoke njolese amaanyi gange mu ggwe, erinnya lyange liryoke litegeezebwe mu nsi zonna.” <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>Noolwekyo Katonda asaasira oyo gw’ayagala okusaasira, ate n’akakanyaza omutima gw’oyo gw’ayagala okukakanyaza.<verse eid="ROM 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>Omu akyayinza okumbuuza nti, Lwaki Katonda atunenya, obanga y’atuleetera okukola nga bw’asiima? <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>Naye ggwe omuntu obuntu, ggwe ani addamu ng’owakanya Katonda? Ekibumbe kiyinza okubuuza eyakibumba nti, “Lwaki wammumba bw’oti?” <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>Oba omubumbi talina buyinza ku bbumba, okubumbamu ekibya eky’omugaso, oba okubumbamu ekitali kya mugaso?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>Katonda yayagala okulaga obusungu bwe, n’amaanyi ge eri abo bonna abaali basaanira okuzikirizibwa, kyokka n’abalaga obugumiikiriza. <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>Ekyo yakikola alyoke amanyise obugagga bw’ekitiibwa kye, eri abo bonna be yeerondera okugabanira awamu ekitiibwa kye. <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>Naffe yatuyita, si Bayudaaya bokka naye n’Abaamawanga. <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>Ne mu Koseya agamba nti,</para>
  <para style="q1" vid="ROM 9:25">“Abataali bantu bange ndibayita abantu bange,</para>
  <para style="q2" vid="ROM 9:25">Ne gwe nnali ssaagala, ndimwagala.”<verse eid="ROM 9:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26"/>Mu kifo omwo mwe baayitirwa nti,</para>
  <para style="q1" vid="ROM 9:26">“Temuli bantu bange,</para>
  <para style="q2" vid="ROM 9:26">mwe baliyitirwa abaana ba Katonda omulamu.”<verse eid="ROM 9:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27"/>Isaaya ayogera eri Isirayiri mu ddoboozi ery’omwanguka nti,</para>
  <para style="q1" vid="ROM 9:27">“Omuwendo gw’abaana ba Isirayiri ne bwe gulyenkana ng’omusenyu gw’ennyanja,</para>
  <para style="q2" vid="ROM 9:27">ekitundu ekirisigalawo kye kirirokolebwa.<verse eid="ROM 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28"/>Kubanga Mukama alisalawo</para>
  <para style="q2" vid="ROM 9:28">era alituukiriza mangu ekyo kye yagamba okukola ku nsi.”<verse eid="ROM 9:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29"/>Era nga Isaaya bwe yayogera edda nti,</para>
  <para style="q1" vid="ROM 9:29">“Singa Mukama ow’Eggye</para>
  <para style="q2" vid="ROM 9:29">teyatulekerawo zzadde,</para>
  <para style="q1" vid="ROM 9:29">twandifuuse nga Sodomu,</para>
  <para style="q2" vid="ROM 9:29">era twandifaananye nga Ggomola.”<verse eid="ROM 9:29"/></para>
  <para style="s1">Obutakkiriza bw’Abayudaaya</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>Kale tunaagamba ki? Tugambe nti Abaamawanga abataagobereranga butuukirivu, baafuna obutuukirivu, bwe butuukirivu obuva mu kukkiriza, <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>naye Isirayiri mu kugobereranga amateeka ag’obutuukirivu, teyafuna butuukirivu obwo? <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>Lwaki? Ekyo baalema okukituukako kubanga tebaagoberera butuukirivu mu kukkiriza wabula mu bikolwa. Beesittala ku jjinja eryo eryesittalwako, <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>nga bwe kyawandiikibwa nti,</para>
  <para style="q1" vid="ROM 9:33">“Laba, nteeka mu Sayuuni ejjinja eryesittalwako<note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false">Ejjinja eryesittalwako ye Kristo.</char></note></para>
  <para style="q2" vid="ROM 9:33">n’olwazi olulibasuula.</para>
  <para style="q2" vid="ROM 9:33">Oyo amukkiriza taliswazibwa.”<verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>Abooluganda, kye njagala mu mutima gwange era kye nsabira Abayisirayiri eri Katonda, kwe kulokolebwa. <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>Kubanga nkakasa nga balina obunyiikivu eri Katonda, naye si mu kutegeera. <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>Mu butamanya butuukirivu bwa Katonda, bagezaako okwenoonyeza obutuukirivu, nga bagondera amateeka mu kifo ky’okugondera obutuukirivu bwa Katonda. <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>Kristo atuwa amakulu amajjuvu, buli amukkiriza n’amuwa obutuukirivu.<verse eid="ROM 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>Musa awandiika ku butuukirivu obuva mu mateeka nti, “Omuntu alikola ebintu ebyo aliba mulamu mu byo.” <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>Naye okukkiriza okuva mu butuukirivu, kugamba nti, “Toyogeranga mu mutima gwo nti, ‘Ani alirinnya mu ggulu?’ (kwe kuggya Kristo mu ggulu) <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>newaakubadde okugamba nti, ‘Ani alikka emagombe?’ (kwe kuggya Kristo mu bafu.)” <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>Abo bonna abalina okukkiriza mu Kristo bagamba nti, “Ekigambo kiri kumpi naawe, kiri mu kamwa ko era kiri mu mutima gwo,” kye kigambo eky’okukkiriza kye tubuulira. <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>Bw’oyatula n’akamwa ko nti, Yesu ye Mukama, n’okkiriza n’omutima gwo nga Katonda yamuzuukiza mu bafu, olokoka. <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>Kubanga omuntu akkiriza na mutima gwe n’aweebwa obutuukirivu, era ayatula na kamwa ke n’alokoka. <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>Kubanga Ebyawandiikibwa bigamba nti, “Buli amukkiriza taliswazibwa.” <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>Tewali njawulo wakati wa Muyudaaya na Muyonaani, kubanga Mukama waabwe y’omu era ayanukula abo bonna abamukoowoola. <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>Buli alikoowoola erinnya lya Mukama alirokoka. <verse eid="ROM 10:13"/><verse number="14" style="v" sid="ROM 10:14"/>Kale balikoowoola batya oyo gwe batakkiririzaamu? Era balikkiriza batya oyo gwe batawulirangako? Era baliwulira batya awatali abuulira? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>Era balibuulira batya nga tebatumiddwa? Ekyawandiikibwa nga bwe kigamba nti, “Ebigere by’abo abategeeza amawulire amalungi, nga birungi.” <verse eid="ROM 10:15"/><verse number="16" style="v" sid="ROM 10:16"/>Naye si bonna abaagondera Enjiri. Isaaya agamba nti, “Mukama, waliwo akkirizza obubaka bwaffe?” <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>Noolwekyo okukkiriza kujja olw’okuwulira ekigambo kya Kristo. <verse eid="ROM 10:17"/><verse number="18" style="v" sid="ROM 10:18"/>Naye mulowooza Abayisirayiri tebaawulira? Weewaawo baawulira. Ebyawandiikibwa bigamba nti,</para>
  <para style="q1" vid="ROM 10:18">“Eddoboozi lyabwe lyabuna mu nsi zonna,</para>
  <para style="q2" vid="ROM 10:18">n’ebigambo byabwe byatuuka ku nkomerero z’ensi.”<verse eid="ROM 10:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19"/>Abayisirayiri baabitegeera oba tebaabitegeera? Bw’ati Musa bw’addamu ekibuuzo ekyo:</para>
  <para style="q1" vid="ROM 10:19">“Ndibaleetera okukwatirwa obuggya abatali ggwanga,</para>
  <para style="q2" vid="ROM 10:19">ne mbasunguwaza olw’eggwanga eritalina kutegeera.”<verse eid="ROM 10:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20"/>Ne Isaaya yali muvumu bwe yagamba nti,</para>
  <para style="q1" vid="ROM 10:20">“Nazuulibwa abo abatannoonya,</para>
  <para style="q2" vid="ROM 10:20">ne ndabika eri abo abatambuulirizaako.”<verse eid="ROM 10:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21"/>Naye eri Isirayiri agamba nti,</para>
  <para style="q1" vid="ROM 10:21">“Olunaku lwonna nalumala nga ngolodde emikono gyange</para>
  <para style="q2" vid="ROM 10:21">eri eggwanga ekkakanyavu era abantu abeewaggula.”<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>Kale ka mbuuze: Katonda yeegoberako ddala abantu be? Kikafuuwe. Kubanga nange ndi Muyisirayiri, era muzzukulu wa Ibulayimu, ow’omu kika kya Benyamini. <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>Katonda tasuulanga bantu be, be yalonda okuva ku lubereberye. Oba temumanyi ekyawandiikibwa ekyogera ku Eriya bwe yeegayirira Katonda nga yeemulugunya olwa Isirayiri? <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>Yagamba nti, “Mukama, basse bannabbi bo ne bamenyaamenya n’ebyoto byo. Nze nzekka nze nsigaddewo, ate bannoonya okunzita.” <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>Naye Katonda yamuddamu atya? Yamugamba nti: “Neesigalizzaawo abasajja kasanvu abatafukaamirira Baali.” <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>Era bwe kityo ne mu biro bino waliwo ekitundu ekyasigalawo abaalondebwamu olw’ekisa. <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>Naye obanga lwa kisa, si lwa bikolwa nate, kubanga ekisa kyandibadde tekikyali kisa.<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>Kale tugambe ki? Abayisirayiri baalemwa okufuna kye baali banoonya, wabula be yalondamu be baakifuna, abalala ne bakakanyazibwa, emitima, <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>nga bwe kyawandiikibwa nti,</para>
  <para style="q1" vid="ROM 11:8">“Katonda yabawa omwoyo ogw’okubongoota,</para>
  <para style="q2" vid="ROM 11:8">n’aleetera amaaso gaabwe obutalaba,</para>
  <para style="q2" vid="ROM 11:8">n’amatu gaabwe obutawulira</para>
  <para style="q1" vid="ROM 11:8">okutuusa leero.”<verse eid="ROM 11:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9"/>Ne Dawudi yagamba nti,</para>
  <para style="q1" vid="ROM 11:9">“Leka ekijjulo kyabwe kibafuukire omutego, era ekitimba,</para>
  <para style="q2" vid="ROM 11:9">eky’okubatega era empeera ebasaanira.<verse eid="ROM 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10"/>Amaaso gaabwe ka gabeeko ekifu, baleme okulaba.</para>
  <para style="q2" vid="ROM 11:10">Era batambule nga bakootakoota emirembe n’emirembe.”<verse eid="ROM 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>Kale ka mbuuze, kyebaava beesittala balyoke bagwe? Kikafuuwe. Naye olw’okwonoona kwabwe, obulokozi kyebwava bujja eri Abaamawanga, Abayudaaya balyoke bakwatibwe obuggya. <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>Kale obanga okwonoona kwabwe kutegeeza bugagga eri ensi, n’okulemwa kwabwe nga kutegeeza bugagga eri Abaamawanga, okuganyulwa kwabwe tekulisingawo!<verse eid="ROM 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>Kaakano njogera gye muli Abaamawanga, nga bwe ndi omutume eri Abaamawanga, ngulumiza obuweereza bwange, <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>singa kisoboka nkwase baganda bange obuggya abamu ku bo basobole okulokolebwa. <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>Kubanga obanga okugobebwa kwabwe kwe kutabaganya ensi, okusembezebwa kwabwe kulitegeeza ki, bwe kutaliwa bafu bulamu? <verse eid="ROM 11:15"/><verse number="16" style="v" sid="ROM 11:16"/>Kale kaakano obanga ekitole ky’eŋŋano ekandiddwa ne kiweebwayo ng’ekibala ekibereberye kitukuvu, n’eŋŋaano yonna ntukuvu; era obanga ekikolo kitukuvu, n’amatabi matukuvu.<verse eid="ROM 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17"/>Naye obanga amatabi agamu gaawogolebwa, ate nga ggwe eyali omuzeyituuni ogw’omu nsiko wasimbibwa ku kikolo kyagwo, n’ogabana ku bugimu bw’ekikolo ky’omuzeyituuni, <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>teweenyumiririzanga ku matabi ago; naye bwe weenyumirizanga, jjukira nga si gwe owaniridde ekikolo, naye ekikolo kye kikuwaniridde. <verse eid="ROM 11:18"/><verse number="19" style="v" sid="ROM 11:19"/>Oyinza okwogera nti, “Amatabi gaawogolwako, ndyoke nsimbibweko.” <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>Ky’oyogedde kiba kituufu. Weewaawo gaawogolwako lwa butakkiriza, kyokka ggwe onywedde lwa kukkiriza. Teweenyumirizanga, naye otyanga. <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>Kuba obanga Katonda teyasaasira matabi ga buzaaliranwa, nammwe ayinza obutabasaasira.<verse eid="ROM 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22"/>Kale mufumiitirize ku kisa n’obukambwe bwa Katonda. Aba mukambwe eri abo abaagwa, naye n’aba wa kisa eri ggwe, bwe weeyongera okunywerera mu kisa kye, kubanga naawe bw’otonywere oliwogolwako. <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>Era n’abo oluvannyuma bwe balikkiriza, balizzibwako ku nduli kubanga Katonda ayinza okubazaako kuli. <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>Kuba obanga ggwe mu buzaaliranwa bwo gwe eyawogolwa ku muzeyituuni, wazzibwa ku muzeyituuni ogutali gwa buzaaliranwa bo, abo ab’obuzaaliranwa tebalisinga nnyo okuzzibwa ku muzeyituuni gwabwe bo?<verse eid="ROM 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>Kubanga ssaagala mmwe abooluganda obutamanya kyama kino nga mwelowooza okuba ab’amagezi, ng’abamu ku Bayisirayiri bwe baakakanyaza emitima gyabwe, okutuusa mmwe Abaamawanga, lwe muliyingira. <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>N’oluvannyuma Isirayiri yenna alirokolebwa, ng’Ekyawandiikibwa bwe kigamba nti,</para>
  <para style="q1" vid="ROM 11:26">“Omulokozi aliva mu Sayuuni,</para>
  <para style="q2" vid="ROM 11:26">era aliggyawo obutatya Katonda mu bazzukulu ba Yakobo.<verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>Era eyo ye ndagaano yange nabo,</para>
  <para style="q2" vid="ROM 11:27">bwe ndibaggyako ebibi byabwe.”<verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>Mu njiri balabe ku lwammwe, naye mu kulondebwa baagalwa olwa bajjajjaabwe. <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>Kubanga Katonda bw’agabira abantu ebirabo oba bw’abayita, teyejjusa. <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>Kuba nga mmwe edda bwe mwajeemera Katonda, kyokka kaakano nga musaasiddwa olw’obujeemu bw’Abayudaaya, <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>bwe batyo nabo kaakano bajeemu, eri ekyo ekyali okusaasira gye muli, balyoke basaasirwe. <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>Kubanga Katonda yaleka abantu bonna mu bujeemu alyoke abakwatirwe ekisa.<verse eid="ROM 11:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33"/>Kale nga Katonda wa kitalo,</para>
  <para style="q2" vid="ROM 11:33">ng’amagezi ge mangi n’okutegeera kwe kungi era n’obugagga bungi;</para>
  <para style="q2" vid="ROM 11:33">ensala ye ey’emisango nga tekeberekeka, n’amakubo ge tegekkaanyizika.<verse eid="ROM 11:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34"/>“Kubanga ani ayinza okutegeera okulowooza kwa Mukama?</para>
  <para style="q2" vid="ROM 11:34">Oba ani ayinza okumuluŋŋamya?”<verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>“Oba ani eyali asoose okumuwa ekintu,</para>
  <para style="q2" vid="ROM 11:35">alyoke amuddizeewo?”<verse eid="ROM 11:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36"/>Kubanga byonna biva gy’ali, era biyita mu ye era bidda gy’ali.</para>
  <para style="q2" vid="ROM 11:36">Ekitiibwa kibe gy’ali emirembe gyonna. Amiina.<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s1">Ssaddaaka Ennamu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>Noolwekyo abooluganda mbeegayirira olw’okusaasira kwa Katonda, muwengayo emibiri gyammwe nga ssaddaaka ennamu entukuvu esanyusa Katonda, kwe kuweereza kwammwe okw’omwoyo. <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>So temwefaananyirizanga ba mirembe gino, naye mukyusibwe olw’okudda obuggya mu birowoozo byammwe okukakasibwa okusiimibwa kwa Katonda, okusanyusa era okw’amazima.<verse eid="ROM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>Kubanga njogera olw’ekisa kye naweebwa, eri buli muntu mu mmwe, obuteerowooza okusinga ekyo ky’asaanidde okulowooza, naye okulowoozanga nga yeegendereza, nga Katonda bwe yagabira buli muntu ekigera ky’okukkiriza. <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>Kubanga nga bwe tulina ebitundu ebingi mu mubiri ogumu, ebitundu ebyo byonna bikola emirimu gya njawulo. <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>Noolwekyo nga bwe tuli omubiri ogumu mu Kristo, buli muntu kitundu ku mubiri ogumu ogwo. <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>Tulina ebirabo, ng’ekisa kye tulina bwe kyatuweebwa mu ngeri ey’enjawulo, oba bunnabbi, ng’ekigera ky’okukkiriza bwe kiri, <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>oba buweereza, mu buweereza, oba omu okuyigiriza, mu kuyigiriza; <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>oba omulala okugumya banne mu kubazzaamu amaanyi, oba omulala mu kugaba, oba omulala, okufuga n’obunyiikivu, n’omulala okulaga ekisa nga musanyufu.<verse eid="ROM 12:8"/></para>
  <para style="s1">Okwagala</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>Mube n’okwagala okutaliimu bukuusa. Mukyawenga ekibi, munywererenga ku kirungi, <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>nga mwagalana mu kwagala okw’abooluganda, nga muwaŋŋana ekitiibwa, <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>mu kunyiikira so si mu kugayaala. Musanyukirenga mu mwoyo nga muweereza Mukama, <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>nga musanyukira mu kusuubira, nga mugumiikiriza mu kubonaabona era nga munyiikira mu kusaba. <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>Mufengayo ku byetaago by’abantu ba Katonda, era mwanirizenga abagenyi.<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>Musabirenga ababayigganya; mubasabirenga so temubakolimiranga. <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>Musanyukirenga wamu n’abo abasanyuka, era mukaabirenga wamu n’abo abakaaba. <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>Buli muntu abeerenga mu mirembe muntu ne munne, nga temwegulumiza naye nga muba bakkakkamu. Temwekulumbazanga.<verse eid="ROM 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17"/>Temusasulanga kibi olw’ekibi, naye mukolenga birungi byereere eri bonna. <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>Mukolenga kyonna ekisoboka okutabagana n’abantu bonna; <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>abaagalwa, temuwalananga ggwanga, era ekiruyi mukirekere Katonda, nga bwe kyawandiikibwa nti, “Okuwoolera eggwanga kwange, nze ndisasula,” bw’ayogera Mukama. <verse eid="ROM 12:19"/><verse number="20" style="v" sid="ROM 12:20"/>“Noolwekyo omulabe wo bw’alumwanga enjala, muliisenga; bw’alumwanga ennyonta muwenga ekyokunywa, bw’okola bw’otyo olimukumira amanda g’omuliro ku mutwe gwe.” <verse eid="ROM 12:20"/><verse number="21" style="v" sid="ROM 12:21"/>Towangulwanga kibi, naye wangulanga ekibi ng’okola obulungi.<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>Buli muntu awulirenga abafuzi, kubanga tewali buyinza butava eri Katonda, era n’abafuzi abaliwo Katonda ye yabalonda. <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>Noolwekyo abawakanya abafuzi, bawakanya buyinza bwa Katonda. Era baba bawakanya kiragiro kye, bwe batyo ne beereetako bokka omusango. <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>Kubanga abafuzi baba tebalwanyisa bikolwa birungi naye ebibi. Oyagala obutakangibwa wa buyinza, kola bulungi osiimibwe, <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>kubanga muweereza wa Katonda ku lw’obulungi bwo. Naye bw’onookolanga ekibi, osaanidde otye kubanga ekitala ky’alina si kya bwereere, kubanga muweereza wa Katonda awoolera eggwanga eri oyo akola ekibi. <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>Noolwekyo kibagwanira okuba abawulize, si lwa busungu bwokka, naye n’olw’okumanya nga kye kituufu.<verse eid="ROM 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6"/>Era kyemuva muwa omusolo kubanga abakozi abo baweereza ba Katonda nga banyiikirira emirimu gyabwe. <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>Abantu bonna basasulenga ebibabanjibwa; musasulenga emisolo eri abo be muteekwa okuwa omusolo, n’ow’empooza mumuwenga empooza; n’oyo ateekwa okutiibwa mumutyenga, n’oyo ateekwa okuweebwa ekitiibwa mumuwenga ekitiibwa.<verse eid="ROM 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>Temubeeranga na bbanja lyonna eri omuntu yenna, wabula okwagalananga; kubanga ayagala muntu munne ng’atuukiriza amateeka. <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>Kubanga amateeka gano nti, “Toyendanga, tottanga, tobbanga, teweegombanga,” n’etteeka eddala, ligattiddwa mu kino nti, “Yagalanga muliraanwa wo nga bwe weeyagala wekka.” <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>Ayagala muliraanwa we tamukola bubi; noolwekyo okwagala kyekuva kutuukiriza amateeka.<verse eid="ROM 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>Mumanye nga kino kye kiseera, era essaawa etuuse mugolokoke okuva mu tulo, kubanga kaakano obulokozi bwaffe buli kumpi okusinga ne we twakkiririza. <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>Ekiro kiyise, obudde bunaatera okukya, noolwekyo tweyambulemu ebikolwa eby’ekizikiza, twambale ebyokulwanyisa eby’omusana. <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>Tutambulenga ng’ab’omu musana, so si mu binyumu ne mu kutamiira, ne mu bwenzi n’obukaba, ne mu kuyombagana n’obuggya, <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>naye twambale Mukama waffe Yesu Kristo so tetuwanga mubiri bbanga kukola ng’okwegomba kwagwo bwe kuli.<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s1">Obutanenyagananga lwa Byakulya</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>Mwanirizenga omunafu mu kukkiriza, nga temumusalira musango. <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>Wabaawo omuntu omu akkiririza mu kulya ebintu byonna, nga so ye omunafu akoma ku nva kwokka. <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>Omuntu asalawo okubaako ky’alya tanyoomanga atakirya, n’oyo atalya kintu alemenga kusalira musango oyo akirya kubanga Katonda yamusembeza. <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>Ggwe ani asalira omusango omuweereza w’omuntu omulala? Mukama we y’amanya oba atuukiriza emirimu gye oba tagituukiriza. Naye aligituukiriza kubanga Mukama we alimusobozesa.<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>Omuntu omu agulumiza olunaku olumu okusinga olulala, naye omulala n’alowooza nti ennaku zonna zenkanankana. Noolwekyo buli muntu anywererenga ku ky’alowooza bwe kiba nga kye kituufu. <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>Akuza olunaku aba alukuza eri Mukama. Oyo alya aba alya ku bwa Mukama, kubanga aba agulumiza Katonda. N’oyo atalya aba talya ku bwa Mukama, era aba agulumiza Katonda. <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>Kubanga tewali n’omu ku ffe abeera omulamu ku bubwe yekka, era tewali n’omu afa ku lulwe. <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>Kubanga bwe tuba abalamu, tuba balamu ku bwa Mukama, oba bwe tufa, tufa ku bwa Mukama. Kale nno bwe tuba abalamu oba bwe tufa, tuli ba Mukama.<verse eid="ROM 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9"/>Kubanga ekyo Kristo kye yafiira ate n’abeera omulamu, alyoke abeere Mukama w’abo abaafa era n’abalamu. <verse eid="ROM 14:9"/><verse number="10" style="v" sid="ROM 14:10"/>Kale ggwe lwaki osalira muganda wo omusango? Oba lwaki onyooma muganda wo? Kubanga ffenna tuliyimirira mu maaso g’entebe ya Katonda, ey’okulamula. <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>Kubanga kyawandiikibwa nti,</para>
  <para style="q1" vid="ROM 14:11">“ ‘Nga bwe ndi omulamu,’ bw’ayogera Mukama,</para>
  <para style="q1" vid="ROM 14:11">‘buli vviivi lirinfukaamirira</para>
  <para style="q2" vid="ROM 14:11">era na buli lulimi lulyatula Katonda.’ ”<verse eid="ROM 14:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12"/>Noolwekyo buli omu ku ffe alyennyonnyolako eri Katonda.<verse eid="ROM 14:12"/></para>
  <para style="s1">Okwesittaza Abalala</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>Noolwekyo tetusaliragananga misango. Tumalirire obuteesittaza waluganda wadde okumutega okugwa mu kibi. <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>Mmanyi era nkakasiza ddala mu Mukama waffe Yesu, nga tewali kya muzizo ku bwakyo, wabula kya muzizo eri oyo akirowooza nga kya muzizo. <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>Kubanga obanga muganda wo anakuwala olw’ekyo ky’olya, oba tokyatambulira mu kwagala; tolyanga kintu kyonna ky’omanyi nga kinaakyamya omuntu oyo Kristo gwe yafiirira. <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>Ekirungi ekiri mu mmwe kireme okuvumibwa. <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>Kubanga obwakabaka bwa Katonda si kulya na kunywa, wabula butuukirivu na mirembe, na ssanyu mu Mwoyo Omutukuvu. <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>Kubanga aweereza Kristo mu ebyo asanyusa nnyo Katonda era asiimibwa abantu.<verse eid="ROM 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19"/>Noolwekyo tunyiikirirenga eby’emirembe, n’eby’okuzimbagana ffekka ne ffekka. <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>Toyonoonanga mulimu gwa Katonda olw’emmere. Ebintu byonna birongoofu, naye ekibi kwe kulya ekyo ekireetera omulala okwesittala. <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>Kirungi obutalya nnyama newaakubadde okunywa wayini newaakubadde ekintu kyonna ekyesittaza muganda wo.<verse eid="ROM 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22"/>Ky’okkiririzaamu mu kulya kikuume nga kya kyama ne Katonda. Alina omukisa ateesalira musango kumusinga mu ekyo ky’alowooza nga kituufu. <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>Naye oyo abuusabuusa bw’alya, omusango gumaze okumusinga, kubanga talya lwa kukkiriza, era na buli ekitava mu kukkiriza kiba kibi.<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s1">Temwesanyusa Mwekka</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>Ffe abanywevu kitugwanidde okwetikkanga obunafu bw’abo abatali banywevu, so si okwesanyusa ffekka. <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>Buli omu ku ffe asanyusenga muliraanwa we mu bulungi olw’okumuzimba mu kukkiriza. <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>Kubanga ne Kristo teyeesanyusa yekka, nga bwe kyawandiikibwa nti, “Ebivume by’abo abaakuvuma byagwa ku nze.” <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>Kubanga ebyawandiikibwa byonna edda, byawandiikibwa kutuyigiriza, tulyoke tugumiikirizenga era tuzzibwemu amaanyi, ate tube n’essuubi.<verse eid="ROM 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5"/>Kaakano Katonda w’okugumiikiriza era azaamu amaanyi, abawe okulowoozanga obumu buli omu eri munne mu Kristo Yesu, <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>mu mwoyo gumu n’eddoboozi limu mulyoke mugulumizenga Katonda, Kitaawe wa Mukama waffe Yesu Kristo.<verse eid="ROM 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>Noolwekyo mwanirizaganenga, nga Kristo bwe yabaaniriza olw’ekitiibwa kya Katonda. <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>Kubanga njogera nti Kristo yafuuka muweereza w’abakomole olw’amazima ga Katonda alyoke anyweze ebisuubizo bya bajjajjaffe <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>n’Abaamawanga balyoke bagulumize Katonda olw’okusaasira kwe, nga bwe kyawandiikibwa nti,</para>
  <para style="q1" vid="ROM 15:9">“Kyendiva nkutendereza mu Baamawanga,</para>
  <para style="q2" vid="ROM 15:9">era ne ntendereza erinnya lyo.”<verse eid="ROM 15:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10"/>Era n’ayongera n’agamba nti:</para>
  <para style="q1" vid="ROM 15:10">“Mmwe Abaamawanga musanyukirenga wamu n’abantu be.”<verse eid="ROM 15:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11"/>Era nate nti,</para>
  <para style="q1" vid="ROM 15:11">“Abaamawanga mwenna, mutendereze Mukama,</para>
  <para style="q2" vid="ROM 15:11">era abantu bonna bamutenderezenga.”<verse eid="ROM 15:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12"/>Ne Nnabbi Isaaya agamba nate nti,</para>
  <para style="q1" vid="ROM 15:12">“Walibaawo muzzukulu wa Yese alijja</para>
  <para style="q2" vid="ROM 15:12">era alisituka okufuga Abaamawanga,</para>
  <para style="q1" vid="ROM 15:12">era mu ye mwe muliba essuubi lyabwe.”<verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>Kaakano Katonda w’okusuubira, abajjuze essanyu lyonna n’emirembe mu kukkiriza, mulyoke mweyongerenga mu ssuubi ery’amaanyi aga Mwoyo Mutukuvu.<verse eid="ROM 15:13"/></para>
  <para style="s1">Pawulo Omuweereza w’Abaamawanga</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>Era matidde baganda bange, nze kennyini, nga nammwe bennyini mujjudde obulungi, nga mujjudde okutegeera kwonna, era nga muyinza okubuuliriragana. <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>Naye mu bitundu ebimu eby’ebbaluwa eno nabawandiikira n’obuvumu nga mbajjukiza olw’ekisa ekyampebwa okuva eri Katonda, <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>kubanga nze ndi muweereza wa Kristo Yesu eri Abaamawanga, nga nkola obuweereza obutukuvu nga mbulira Enjiri ya Katonda, ekiweebwayo ky’Abaamawanga kiryoke kikkirizibwe, nga kitukuzibbwa Mwoyo Mutukuvu.<verse eid="ROM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17"/>Noolwekyo neenyumiririza mu Kristo olw’omulimu gwa Katonda; <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>kubanga siryaŋŋanga kwogera bintu Kristo by’atakolera mu nze Abaamawanga balyoke babeere abawulize mu kigambo ne mu bikolwa, <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>ne mu maanyi ag’obubonero n’eby’amagero, ne mu maanyi ag’Omwoyo wa Katonda. Bwe ntyo okuva e Yerusaalemi n’okwetooloola okutuuka mu Iruliko<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">Iruliko: mu biro bino y’ensi ya Yugosiloviya mu nsi z’Ebulaaya</char></note>, mbulidde Enjiri ya Kristo mu bujjuvu. <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>Nduubirira okubuulira Enjiri mu bifo etayatulwanga linnya lya Kristo, nneme okuzimba ku musingi gw’omuntu omulala, <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>nga bwe kyawandiikibwa nti,</para>
  <para style="q1" vid="ROM 15:21">“Abo abatategeezebwanga bimufaako baliraba,</para>
  <para style="q2" vid="ROM 15:21">n’abo abatawulirangako balitegeera.”<verse eid="ROM 15:21"/></para>
  <para style="s1">Pawulo Ategeka Okukyalira Ruumi</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22"/>Kyennava nziyizibwanga ennyo okujja gye muli; <verse eid="ROM 15:22"/><verse number="23" style="v" sid="ROM 15:23"/>naye kaakano nga bwe sikyalina kifo mu bitundu by’eno, ate nga maze emyaka mingi nga njagala okujja gye muli, nsubira okujjayo, <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>bwe ndiba nga ndaga mu Esupaniya. Kubanga nsuubira okubalaba nga mpitayo, n’oluvannyuma munnyambe okuva eyo ndyoke ntuukirize ekitundu ekisooka. <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/>Naye kaakano ndaga e Yerusaalemi okuweereza abatukuvu. <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>Ab’omu Makedoniya ne mu Akaya baasanyuka okuwaayo ku byabwe eri abatukuvu abaavu ab’omu Yerusaalemi. <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>Baasanyuka era balina ebbanja gye bali, kubanga ng’Abaamawanga bwe baagabana ku bintu eby’omwoyo okuva gye bali, n’Abaamawanga nabo basaanye okubaweereza mu bintu eby’omubiri. <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>Noolwekyo bwe ndimaliriza ekyo ne mbakwasa ekibala ekyo, ndiyitira ewammwe nga ŋŋenda Esupaniya. <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>Era mmanyi nga bwe ndijja gye muli, ndijja n’omukisa gwa Kristo mu bujjuvu.<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>Kaakano mbakuutira abooluganda, mu Mukama waffe Yesu Kristo ne mu kwagala kw’Omwoyo, okufubiranga awamu nange, nga munsabira eri Katonda, <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>mpone abo abajeemu mu Buyudaaya, n’obuweereza bwange busiimibwe abatukuvu mu Yerusaalemi, <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>ndyoke nsobole okujja gye muli olw’okwagala kwa Katonda, okuwummulira awamu nammwe, nga ndi musanyufu. <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>Kale kaakano Katonda ow’emirembe, abeerenga nammwe mwenna. Amiina.<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s1">Okulamusa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>Kaakano mbanjulira Foyibe mwannyinaffe, era omuweereza w’ekkanisa<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="fq" closed="false">Foyibe </char><char style="ft" closed="false">yali mudiikoni mu kkanisa eyo</char></note> ey’omu Kenkereya. <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>Mumwanirize mu Mukama waffe, nga bwe kigwanidde abatukuvu, era muyimirire naye nga mumuyamba mu nsonga yonna gye yeetaaga, kubanga naye yennyini yayamba bangi era nange kennyini.<verse eid="ROM 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3"/>Mundabire Pulisikira ne Akula, bwe tukola omulimu mu Kristo Yesu, <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>abeewaayo wakiri okutemwako emitwe olw’obulamu bwange, era si beebaza bokka wabula n’Ekkanisa z’Abamawanga zonna.<verse eid="ROM 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 16:5"/>Mutuuse okulamusa kwange eri abo bonna abakuŋŋaana ng’ekkanisa mu maka gaabwe.</para>
  <para style="p" vid="ROM 16:5">Mundabire mukwano gwange omwagalwa Epayineeto, kye kibala eky’olubereberye eky’omu Asiya eri Kristo.<verse eid="ROM 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 16:6"/>Mundabire Maliyamu eyabakolera ennyo.<verse eid="ROM 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 16:7"/>Mundabire Anduloniiko ne Yuniya ab’ekika kyange, abaasibibwa awamu nange mu kkomera, era bassibwamu nnyo ekitiibwa abatume era be bansooka okubeera mu Kristo.<verse eid="ROM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8"/>Mundabire Ampuliyaato omwagalwa wange mu Mukama waffe.<verse eid="ROM 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 16:9"/>Mundabire Ulubano, mukozi munnaffe mu Kristo, n’omwagalwa waffe Sutaku.<verse eid="ROM 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 16:10"/>Mundabire Apere, asiimibwa mu Kristo.</para>
  <para style="p" vid="ROM 16:10">Mundabire n’ab’omu nnyumba ya Alisutobulo.<verse eid="ROM 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 16:11"/>Mundabire Kerodiyoni muganda wange.</para>
  <para style="p" vid="ROM 16:11">Mundabire ab’omu nnyumba ya Nalukiso.<verse eid="ROM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12"/>Mundabire Terufayina ne Terufoosa, abaakola ennyo omulimu gwa Mukama waffe.</para>
  <para style="p" vid="ROM 16:12">Mundabire Perusi omwagalwa eyakola ennyo omulimu mu Mukama waffe.<verse eid="ROM 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 16:13"/>Mundabire Luufo Mukama gwe yalonda, era ne nnyina ali nga mmange.<verse eid="ROM 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 16:14"/>Mundabire Asunkulito ne Felegoni, ne Kerume, ne Patuloba, ne Keruma era n’abooluganda abali nabo.<verse eid="ROM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 16:15"/>Mundabire Firologo ne Yuliya, ne Nerewu ne mwannyina, ne Olumpa n’abatukuvu bonna abali awamu nabo.<verse eid="ROM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16"/>Mulamusagane n’okunywegera okutukuvu.</para>
  <para style="p" vid="ROM 16:16">Ekkanisa zonna eza Kristo, zibalamusizza.<verse eid="ROM 16:16"/></para>
  <para style="s1">Ebisembayo</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>Noolwekyo mbakuutira abooluganda mwegenderezenga abo abaleeta enjawukana, n’eby’esittaza ebikontana n’okuyigiriza kwe mwayiga, era mubakubenga amabega. <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>Kubanga abantu ng’abo tebaweereza Mukama waffe Yesu, wabula embuto zaabwe. Bakozesa ebigambo ebirungi eby’okuwaanawaana nga balimbalimba emitima gy’abanafu. <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>Kubanga amawulire ag’okuwulira kwammwe gaabuna mu bantu bonna, kyenvudde mbasanyukira. Naye njagala mubenga bagezi mu kukola obulungi, era abalongoofu abeewala ekibi.<verse eid="ROM 16:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20"/>Kaakano Katonda ow’emirembe ajja kubetentera Setaani wansi w’ebigere byammwe, mangu.</para>
  <para style="b" vid="ROM 16:20"/>
  <para style="p" vid="ROM 16:20">Ekisa kya Mukama waffe Yesu kibeerenga nammwe.<verse eid="ROM 16:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21"/>Timoseewo mukozi munnange, ne Lukiyo ne Yasooni wamu ne Sosipateri, baganda bange, babatumidde.<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>Nange Terutiyo<note caller="+" style="f"><char style="fr" closed="false">16:22 </char><char style="fq" closed="false">Terutiyo </char><char style="ft" closed="false">ye yakubanga tayipu nga Pawulo awandiika ebbaluwa ze</char></note> awandiika ebbaluwa eno, mbatumidde mu Mukama waffe.<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>Gaayo<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="fq" closed="false">Gaayo </char><char style="ft" closed="false">yandiba Gaayo ow’omu <char style="xt"><ref loc="1CO 1:14">1Ko 1:14</ref></char>, Pawulo gwe yabatiza</char></note> ansuza, n’ekkanisa yonna babalamusizza. Mundabire Erasuto omuwanika w’ekibuga, ne Kwaluto muganda we.<verse eid="ROM 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24"/>Ekisa kya Mukama waffe Yesu Kristo kibeerenga nammwe mwenna. Amiina.<verse eid="ROM 16:24"/></para>
  <para style="s1">Pawulo Abasiibula n’Okusaba</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>Kaakano eri oyo ayinza okubanyweza ng’enjiri yange n’okubuulira mu Kristo Yesu bwe biri, ng’ekyama ky’okubikkulirwa eby’ebiro eby’emirembe n’emirembe ebyasirikirwa, bwe kiri, <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>kaakano nga bannabbi bwe baayogerera mu byawandiikibwa, ng’ekiragiro kya Katonda ataggwaawo bwe kiri, olw’okugonda mu kukkiriza eri Abaamawanga bonna abaamanyibwa, <verse eid="ROM 16:26"/><verse number="27" style="v" sid="ROM 16:27"/>Katonda omu yekka ow’amagezi, agulumizibwenga ku bwa Yesu Kristo, emirembe n’emirembe. Amiina.<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
