<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Luganda Contemporary Bible 2014</book>
  <para style="h">Engero</para>
  <para style="toc1">Engero</para>
  <para style="toc2">Engero</para>
  <para style="toc3">Nge</para>
  <para style="mt2">Ekitabo Ekiyitibwa</para>
  <para style="mt1">Engero</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>Engero za Sulemaani, mutabani wa Dawudi, kabaka wa Isirayiri.<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>Yaziwandiika okuyigiriza abantu okuba n’amagezi n’okuyiga,</para>
  <para style="q2" vid="PRO 1:2">era n’okutegeera ebigambo eby’obulabufu; eby’obulamu eby’amagezi n’empisa.<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>Sulemaani yayagala abantu okuba n’empisa, n’obulamu obw’amagezi,</para>
  <para style="q2" vid="PRO 1:3">okukolanga ebituufu, n’okubeera abenkanya n’okugobereranga ensonga;<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>okuyigiriza amagezi abatalina bumanyirivu,</para>
  <para style="q2" vid="PRO 1:4">n’abavubuka okufuna okumanya n’okutegeera.<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>N’abantu ab’amagezi nabo bwe bawulira beeyongere okuyiga</para>
  <para style="q2" vid="PRO 1:5">n’abategeevu beeyongere okubangulwa.<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>Era engero zino zaawandiikibwa okutegeera engero,</para>
  <para style="q2" vid="PRO 1:6">enjogera n’ebikokyo.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>Kale mu kutya <char style="nd">Mukama</char> amagezi mwe gasookera,</para>
  <para style="q2" vid="PRO 1:7">naye abasirusiru banyooma amagezi n’okulagirirwa.<verse eid="PRO 1:7"/></para>
  <para style="s1">Amagezi eri Abavubuka</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Mwana wange ossangayo omwoyo eri ebiragiro bya kitaawo,</para>
  <para style="q2" vid="PRO 1:8">era tolekanga kukuutira kwa maama wo;<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>bijja kuba ngule eneeweesanga omutwe gwo ekitiibwa,</para>
  <para style="q2" vid="PRO 1:9">n’emikuufu mu bulago bwo.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Mwana wange abakozi b’ebibi bwe bakusendasendanga,</para>
  <para style="q2" vid="PRO 1:10">tokkirizanga.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Bwe bakugambanga nti, “Tugende ffenna twesanyuse,</para>
  <para style="q2" vid="PRO 1:11">tunyage, tubbe n’okutta;</para>
  <para style="q2" vid="PRO 1:11">tokkirizanga;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ng’entaana bw’emira abantu, naffe tubamire tutyo nga bakyali balamu,</para>
  <para style="q2" vid="PRO 1:12">era nga balamba, ng’abagenda mu bunnya obuwanvu;<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>nga twefunira eby’obugagga bye tutakoleredde,</para>
  <para style="q2" vid="PRO 1:13">ne tujjuza amayumba gaffe obugagga obubbe;<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>ng’ababi batuyita tubeegatteko,</para>
  <para style="q2" vid="PRO 1:14">tugabane kyenkanyi ebibbe n’ebinyage.”<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>Mwana wange totambuliranga wamu nabo,</para>
  <para style="q2" vid="PRO 1:15">era ekigere kyo kiziyize okukwatanga ekkubo lyabwe:<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>Kubanga ebigere byabwe bidduka bunnambiro okukola ebibi,</para>
  <para style="q2" vid="PRO 1:16">era kibanguyira okuyiwa omusaayi.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>Nga kuba kumala biseera okutega omutego,</para>
  <para style="q2" vid="PRO 1:17">ng’ekinyonyi ky’oyagala okukwata kikulaba,<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>naye abantu ng’abo baba beetega bokka,</para>
  <para style="q2" vid="PRO 1:18">baba beetega omutego ogunaabakwasa bo bennyini.<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Bwe lityo bwe libeera ekkubo lya buli muntu anoonya okugaggawalira mu bukyamu.</para>
  <para style="q2" vid="PRO 1:19">Obugagga obw’engeri eyo busaanyaawo obulamu bw’abo ababufuna.<verse eid="PRO 1:19"/></para>
  <para style="s1">Okulabula Eri Abanyooma Amagezi</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>Amagezi galeekaanira waggulu mu nguudo;</para>
  <para style="q2" vid="PRO 1:20">gayimusa amaloboozi gaago, mu bifo ebigazi eby’omu bibuga.<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>Ne galeekaanira waggulu, mu kifo enguudo ennene we zisisinkanira,</para>
  <para style="q2" vid="PRO 1:21">era gasinzira mu miryango gy’ekibuga ne googera:<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>Mulituusa ddi mmwe ab’amagezi amatono obutayagala kweyongera kuyiga by’amagezi,</para>
  <para style="q2" vid="PRO 1:22">nammwe ab’amalala okunyoomanga eby’amagezi n’abasirusiru okukyawanga okumanya?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Kale singa muwuliriza okunenya kwange,</para>
  <para style="q2" vid="PRO 1:23">laba, ndifuka omutima gwange</para>
  <para style="q2" vid="PRO 1:23">n’ebirowoozo byange mu mmwe.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>Kubanga na bayita ne mugaana okuwuliriza,</para>
  <para style="q2" vid="PRO 1:24">ne ngolola omukono ne wataba n’omu afaayo,<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>era ne mutafaayo ku magezi ge nabawa,</para>
  <para style="q2" vid="PRO 1:25">era ne mugaana okubuulirira kwange kwonna,<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>kale nange ndibasekerera nga muli mu nnaku,</para>
  <para style="q2" vid="PRO 1:26">era mbakudaalire ng’entiisa ebagwiridde.<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>Entiisa bw’eribajjira ng’omuyaga omungi,</para>
  <para style="q2" vid="PRO 1:27">ennaku n’okubonaabona, okulumwa n’obubalagaze,<verse eid="PRO 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>kale balinkoowoola, naye siriyitaba;</para>
  <para style="q2" vid="PRO 1:28">balinnoonya obutaweera naye ne batandaba.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>Kubanga baakyawa okuyigirizibwa, n’okumanya,</para>
  <para style="q2" vid="PRO 1:29">era ne bamalirira obutatya <char style="nd">Mukama</char>.<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>Ne bagaana okuwuliriza amagezi gange;</para>
  <para style="q2" vid="PRO 1:30">ne banyooma okunenya kwange kwonna.<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>Kyebaliva balya ebibala eby’ekkubo lyabwe ebbi,</para>
  <para style="q2" vid="PRO 1:31">era ne bajjula ebibala eby’enkwe zaabwe.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Obusirusiru bulitta ab’amagezi amatono</para>
  <para style="q2" vid="PRO 1:32">n’obutafaayo bulizikiriza abasirusiru,<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>naye buli ampuliriza anaabeeranga mirembe,</para>
  <para style="q2" vid="PRO 1:33">ng’agumye nga talina kutya kwonna.<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Empeera y’Okunoonya Amagezi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Mwana wange, bw’onookwatanga ebigambo byange,</para>
  <para style="q2" vid="PRO 2:1">n’otereka ebiragiro byange mu bulamu bwo,<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>era n’ossaayo omwoyo eri amagezi,</para>
  <para style="q2" vid="PRO 2:2">era n’ossa omutima gwo eri okutegeera,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>ddala ddala singa oyaayaanira okumanya</para>
  <para style="q2" vid="PRO 2:3">era n’oyimusa eddoboozi lyo osabe okutegeera,<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>bw’onooganoonyanga nga ffeeza,</para>
  <para style="q2" vid="PRO 2:4">era n’oganoonyanga ng’ekyobugagga ekyakwekebwa,<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>awo w’olitegeerera okutya <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 2:5">era n’ovumbula okumanya Katonda.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>Kubanga <char style="nd">Mukama</char> awa amagezi;</para>
  <para style="q2" vid="PRO 2:6">era mu kamwa ke muvaamu okumanya n’okutegeera.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>
    <char style="nd">Mukama</char> aterekera abatuukirivu amagezi amalungi,</para>
  <para style="q2" vid="PRO 2:7">era aba ngabo y’abo abatambulira mu bugolokofu.<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>Abatambuliza mu makubo ag’obwenkanya,</para>
  <para style="q2" vid="PRO 2:8">era bw’atyo <char style="nd">Mukama</char> akuuma ekkubo ly’abatukuvu be.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Olwo lw’olitegeera obutuukirivu, amazima n’obwenkanya;</para>
  <para style="q2" vid="PRO 2:9">weewaawo buli kkubo eddungi.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Kubanga amagezi galiyingira mu mutima gwo,</para>
  <para style="q2" vid="PRO 2:10">n’okumanya kulisanyusa omwoyo gwo.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>Okwesalirawo obulungi kunaakulabiriranga</para>
  <para style="q2" vid="PRO 2:11">n’okutegeera kunaakukuumanga:<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>Amagezi ganaakuwonyanga ekkubo ly’omubi,</para>
  <para style="q2" vid="PRO 2:12">n’abantu aboogera eby’obugwagwa,<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>abaleka amakubo ag’obutuukirivu</para>
  <para style="q2" vid="PRO 2:13">ne batambulira mu makubo ag’ekizikiza,<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>abasanyukira okukola ebikolwa ebibi,</para>
  <para style="q2" vid="PRO 2:14">abanyumirwa eby’obusirusiru,<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>abantu abo be b’amakubo amakyamu,</para>
  <para style="q2" vid="PRO 2:15">era abakujjukujju mu ngeri zaabwe.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Amagezi <char style="nd">Mukama</char> g’awa ge gokka agajja okukuwonya ekkubo ly’omukazi omwenzi,</para>
  <para style="q2" vid="PRO 2:16">n’okukuwonya ebigambo bye ebisendasenda,<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>eyaleka bba ow’omu buvubuka bwe</para>
  <para style="q2" vid="PRO 2:17">era eyeerabira endagaano gye yakola mu maaso ga Katonda we.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>Kubanga ennyumba ye ekka mu kufa,</para>
  <para style="q2" vid="PRO 2:18">n’amakubo ge galaga eri abafu.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Tewali n’omu agenda ewuwe adda</para>
  <para style="q2" vid="PRO 2:19">wadde okufunirayo amakubo g’obulamu.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>Kale tambuliranga mu kkubo ly’abo abatya Katonda</para>
  <para style="q2" vid="PRO 2:20">era onywerere mu makubo g’abatuukirivu.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Kubanga abatuukirivu balituula mu nsi,</para>
  <para style="q2" vid="PRO 2:21">era abo abagolokofu baligisigalamu.<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>Naye abakozi b’ebibi balifiirwa ebirungi eby’ensi,</para>
  <para style="q2" vid="PRO 2:22">n’abatali beesigwa balizikirizibwa.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Emikisa Egiva mu kuba n’Amagezi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Mwana wange, teweerabiranga bintu bye nakuyigiriza,</para>
  <para style="q2" vid="PRO 3:1">era okuumanga ebiragiro byange mu mutima gwo,<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>kubanga bijja kuwangaaza obulamu bwo ku nsi,</para>
  <para style="q2" vid="PRO 3:2">era bikukulaakulanye.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Amazima n’ekisa tobyerabiranga;</para>
  <para style="q2" vid="PRO 3:3">byesibe mu bulago bwo,</para>
  <para style="q2" vid="PRO 3:3">obiwandiike ku mutima gwo.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Bw’otyo bw’onoofuna okuganja n’okusiimibwa</para>
  <para style="q2" vid="PRO 3:4">eri Katonda n’eri abantu.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>Weesige <char style="nd">Mukama</char> n’omutima gwo gwonna,</para>
  <para style="q2" vid="PRO 3:5">so teweesigamanga ku magezi go gokka.<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>
    <char style="nd">Mukama</char> mukulembezenga mu by’okola byonna,</para>
  <para style="q2" vid="PRO 3:6">naye anaakuluŋŋamyanga n’owangula.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>Amagezi go tegakusigulanga,</para>
  <para style="q2" vid="PRO 3:7">naye otyanga <char style="nd">Mukama</char>, era weewale okukola ebibi.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Onoofunanga obulamu mu mubiri gwo</para>
  <para style="q2" vid="PRO 3:8">n’amagumba go ne gadda buggya.<verse eid="PRO 3:8"/></para>
  <para style="s1">Amagezi n’Obugagga</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>
    <char style="nd">Mukama</char> mugulumizenga n’eby’obugagga byo; n’ebibala ebisooka eby’ebintu byo byonna eby’omu nnimiro yo,<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>olwo amaterekero go lwe ganajjulanga ebintu enkumu,</para>
  <para style="q2" vid="PRO 3:10">era n’amasenero go ne gajjula ne gabooga omwenge omusu.<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>Mwana wange tonyoomanga kukangavvula kwa <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 3:11">n’okunenya kwe kulemenga okukukooya,<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>kubanga <char style="nd">Mukama</char> anenya oyo gw’ayagala,</para>
  <para style="q2" vid="PRO 3:12">nga kitaawe w’omwana bw’anenya mutabani we gwe yeenyumiririzaamu.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>Aweereddwa omukisa oyo afuna amagezi,</para>
  <para style="q2" vid="PRO 3:13">omuntu oyo afuna okutegeera,<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>kubanga amagezi gasinga ffeeza</para>
  <para style="q2" vid="PRO 3:14">era galimu amagoba okusinga zaabu.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Amagezi ga muwendo mungi okusinga amayinja ag’omuwendo omungi:</para>
  <para style="q2" vid="PRO 3:15">era tewali kyegombebwa kiyinza kugeraageranyizibwa nago.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Mu mukono gwago ogwa ddyo mwe muli obuwanguzi;</para>
  <para style="q2" vid="PRO 3:16">ne mu mukono gwago ogwa kkono ne mubaamu obugagga n’ekitiibwa.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Mu magezi mulimu essanyu,</para>
  <para style="q2" vid="PRO 3:17">era n’amakubo gaago ga mirembe.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>Amagezi muti gwa bulamu eri abo abagakwata ne baganyweza;</para>
  <para style="q2" vid="PRO 3:18">abo abagakwata ne baganyweza baliweebwa omukisa.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>Amagezi, <char style="nd">Mukama</char> ge yakozesa okuteekawo emisingi gy’ensi;</para>
  <para style="q2" vid="PRO 3:19">n’okutegeera kwe yakozesa okuteekawo eggulu;<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>n’okumanya kwe, kwe yakozesa okwawula obuziba bw’ennyanja,</para>
  <para style="q2" vid="PRO 3:20">era n’ebire ne bivaamu omusulo.<verse eid="PRO 3:20"/></para>
  <para style="s1">Ab’amagezi Baweebwa Ekitiibwa</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>Mwana wange, beeranga n’okuteesa okulungi n’okusalawo ebisaana,</para>
  <para style="q2" vid="PRO 3:21">ebyo biremenga okukuvaako,<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>binaabeeranga obulamu eri emmeeme yo,</para>
  <para style="q2" vid="PRO 3:22">era ekyokwambala ekirungi ekinaawoomesanga obulago bwo.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Bw’otyo bw’onootambulanga nga onyweredde mu kkubo lyo,</para>
  <para style="q2" vid="PRO 3:23">era ekigere kyo tekijjanga kwesittala.<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>Bw’onoogalamiranga toobenga na kutya,</para>
  <para style="q2" vid="PRO 3:24">weewaawo bw’oneebakanga otulo tunaakuwoomeranga.<verse eid="PRO 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Totyanga kabenje kootomanyiridde,</para>
  <para style="q2" vid="PRO 3:25">wadde okuzikirira okujjira abakozi b’ebibi,<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>Kubanga <char style="nd">Mukama</char> y’anaabeeranga obwesigwa bwo,</para>
  <para style="q2" vid="PRO 3:26">era anaalabiriranga ekigere kyo ne kitakwatibwa mu mutego.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>Tommanga birungi abo be bisaanira</para>
  <para style="q2" vid="PRO 3:27">bwe kibeera mu buyinza bwo okukikola.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Togambanga muliraanwa wo nti,</para>
  <para style="q2" vid="PRO 3:28">“Genda, onodda enkya ne nkuwa,”</para>
  <para style="q2" vid="PRO 3:28">ate nga kye yeetaaga okirina.<verse eid="PRO 3:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>Totegekanga kukola bulabe ku muliraanwa wo,</para>
  <para style="q2" vid="PRO 3:29">atudde emirembe ng’akwesiga.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Tovunaananga muntu n’omu awatali nsonga</para>
  <para style="q2" vid="PRO 3:30">nga talina kabi k’akukoze.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>Tokwatirwanga obuggya omuntu ayigganya abalala,</para>
  <para style="q2" vid="PRO 3:31">era tokolanga nga ye bw’akola,<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>kubanga omuntu omugwagwa wa muzizo eri <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 3:32">naye abo abagolokofu abalinamu obwesige.<verse eid="PRO 3:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>Ekikolimo kya <char style="nd">Mukama</char> kiri ku nnyumba y’ababi,</para>
  <para style="q2" vid="PRO 3:33">naye awa omukisa ennyumba y’abatuukirivu.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>Ddala ddala, <char style="nd">Mukama</char> anyooma abanyoomi,</para>
  <para style="q2" vid="PRO 3:34">naye abeetoowaza abawa ekisa.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>Ab’amagezi balisikira ekitiibwa,</para>
  <para style="q2" vid="PRO 3:35">naye abasirusiru baliswazibwa.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Amagezi ge gali ku Ntikko</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Muwulirize baana bange okuyigiriza kwange ng’okwa kitammwe,</para>
  <para style="q2" vid="PRO 4:1">era musseeyo omwoyo mufune okutegeera.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Kubanga mbawa okuyigiriza okulungi;</para>
  <para style="q2" vid="PRO 4:2">temulekanga biragiro byange.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Bwe nnali omuvubuka nga ndi ne kitange,</para>
  <para style="q2" vid="PRO 4:3">omwana omu yekka omwagalwa, owa mmange,<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>yanjigiriza n’aŋŋamba nti, “Ebigambo byange bikuumenga ku mutima gwo,</para>
  <para style="q2" vid="PRO 4:4">kuuma ebiragiro byange obeere mulamu.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Funa amagezi; funa okutegeera,</para>
  <para style="q2" vid="PRO 4:5">teweerabiranga era tovanga ku bigambo bya mu kamwa kange.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Togalekanga, nago ganaakukuumanga,</para>
  <para style="q2" vid="PRO 4:6">gaagale nago ganaakulabiriranga.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Ddala amagezi kye kintu ekisingira ddala obukulu;</para>
  <para style="q2" vid="PRO 4:7">noolwekyo fuba ofune amagezi, era fubira ddala nnyo ofune okutegeera.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>Amagezi gagulumize, nago gajja kukuyimusa,</para>
  <para style="q2" vid="PRO 4:8">gaanirize, nago gajja kukuweesa ekitiibwa.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Amagezi gajja kukutikkira engule ey’ekisa,</para>
  <para style="q2" vid="PRO 4:9">era gakuwe n’engule ey’ekitiibwa.”<verse eid="PRO 4:9"/></para>
  <para style="s1">Enjawulo wakati w’Ab’amagezi n’Abagwenyufu</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Wuliriza ggwe, mutabani, era okkirize ebigambo byange</para>
  <para style="q2" vid="PRO 4:10">olyoke owangaalire ku nsi n’essanyu eringi.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Nkuluŋŋamya mu kkubo ery’amagezi,</para>
  <para style="q2" vid="PRO 4:11">ne nkukulembera mu makubo ag’obutuukirivu.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Bw’onootambulanga, ekigere kyo kireme okuziyizibwa;</para>
  <para style="q2" vid="PRO 4:12">era bw’onoddukanga, tojjanga kwesittala.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>Nywerezanga ddala okuyigirizibwa, tokutanga:</para>
  <para style="q2" vid="PRO 4:13">kukuumenga kubanga bwe bulamu bwo.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>Toyingiranga mu kkubo ly’abakozi b’ebibi,</para>
  <para style="q2" vid="PRO 4:14">wadde okutambulira mu kkubo ly’abantu aboonoonyi.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Lyewalenga, tolitambulirangamu,</para>
  <para style="q2" vid="PRO 4:15">liveeko okwate ekkubo lyo.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Kubanga abakozi b’ebibi tebayinza kwebaka okuggyako nga bakoze ebibi,</para>
  <para style="q2" vid="PRO 4:16">era otulo tubabulira ddala bwe baba tebalina gwe bakozeeko bulabe.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Okukola ebibi y’emmere yaabwe,</para>
  <para style="q2" vid="PRO 4:17">n’okukozesa eryanyi kye kyokunywa kyabwe.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Ekkubo ly’abatuukirivu liri ng’enjuba eyakavaayo,</para>
  <para style="q2" vid="PRO 4:18">eyeeyongera okwaka okutuusa obudde lwe butangaalira ddala.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>Naye ekkubo ly’ababi liri ng’ekizikiza ekikutte,</para>
  <para style="q2" vid="PRO 4:19">tebamanyi kibaleetera kwesittala.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Mutabani wange wuliriza n’obwegendereza ebigambo byange;</para>
  <para style="q2" vid="PRO 4:20">osseeyo omwoyo eri bye nkutegeeza;<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>ebigambo bino tebikuvangako,</para>
  <para style="q2" vid="PRO 4:21">bikuumire ddala mu mutima gwo,<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>kubanga bya bulamu eri abo ababifuna,</para>
  <para style="q2" vid="PRO 4:22">era biwonya omubiri gwabwe gwonna.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>Ekisinga byonna kuuma omutima gwo,</para>
  <para style="q2" vid="PRO 4:23">kubanga y’ensulo y’obulamu bwo.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Weewalire ddala eby’obubambavu</para>
  <para style="q2" vid="PRO 4:24">era n’okwogera ebya swakaba.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Amaaso go gatunulenga butereevu,</para>
  <para style="q2" vid="PRO 4:25">era otunulenga n’obumalirivu eyo gy’olaga.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>Ttereeza bulungi amakubo go;</para>
  <para style="q2" vid="PRO 4:26">okwate amakubo ageesigika gokka.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>Tokyamanga ku mukono ogwa ddyo oba ogwa kkono;</para>
  <para style="q2" vid="PRO 4:27">ebigere byo byewalenga ekkubo ekyamu.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Okulabula ku Bwenzi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Mutabani, ossangayo omwoyo eri ebiragiro byange,</para>
  <para style="q2" vid="PRO 5:1">era owulirizanga bulungi ebigambo byange eby’amagezi,<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>olyoke oyige okusalawo okw’amagezi,</para>
  <para style="q2" vid="PRO 5:2">era akamwa ko kavengamu eby’obutegevu.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Kubanga emimwa gy’omukazi omwenzi gitonnya omubisi gw’enjuki,</para>
  <para style="q2" vid="PRO 5:3">n’ebigambo bye biweweevu okusinga omuzigo;<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>naye enkomerero ya byonna, akaawa ng’omususa</para>
  <para style="q2" vid="PRO 5:4">era asala ng’ekitala eky’obwogi obubiri.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Ebigere bye bituuka mu kufa,</para>
  <para style="q2" vid="PRO 5:5">ebisinde bye biraga emagombe.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Tafaayo ku kkubo lya bulamu,</para>
  <para style="q2" vid="PRO 5:6">amakubo ge gaakyamakyama dda, naye nga takimanyi.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Kaakano, batabani bange mumpulirize,</para>
  <para style="q2" vid="PRO 5:7">temuvanga ku bigambo bya kamwa kange.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Mwewalenga omukazi oyo</para>
  <para style="q2" vid="PRO 5:8">era temusembereranga luggi lwa nnyumba ye;<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>si kulwa nga mufiirwa ekitiibwa kyammwe,</para>
  <para style="q2" vid="PRO 5:9">n’okumalira ebiseera byammwe ku oyo alina ettima,<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>ate si kulwa nga b’otolina ky’obamanyiiko bakwavuwaza,</para>
  <para style="q2" vid="PRO 5:10">n’amaanyi go n’ogamalira ku maka g’omulala.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>Ku nkomerero y’obulamu bwo olisinda,</para>
  <para style="q2" vid="PRO 5:11">ennyama yo n’omubiri gwo nga biweddewo.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>Oligamba nti, “Nga nakyawa okulabulwa,</para>
  <para style="q2" vid="PRO 5:12">n’omutima gwange ne gukyawa okunenyezebwa,<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>era ne sigondera ddoboozi ly’abasomesa bange,</para>
  <para style="q2" vid="PRO 5:13">wadde okussaayo omwoyo eri abo abampanga amagezi.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Ntuuse ku njegoyego z’okuzikirira</para>
  <para style="q2" vid="PRO 5:14">nga ndi wakati mu kuŋŋaaniro ly’ekibiina.”<verse eid="PRO 5:14"/></para>
  <para style="s1">Obuvunaanyizibwa n’Essanyu mu Bufumbo</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Onoonywanga amazzi ag’omu kidiba kyo,</para>
  <para style="q2" vid="PRO 5:15">n’amazzi agava mu luzzi lwo goonoonywanga.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>Ensulo zo zisaanye okukulukutira mu nguudo,</para>
  <para style="q2" vid="PRO 5:16">n’enzizi zo mu bifo ebigazi eby’omu kibuga?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Leka bibeere bibyo wekka,</para>
  <para style="q2" vid="PRO 5:17">bireme kugabanibwako b’otomanyiiko n’akamu.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Kale leka ensulo yo ebeere n’omukisa,</para>
  <para style="q2" vid="PRO 5:18">era osanyuke ne mukazi wo ow’omu buvubuka bwo.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Ng’ennangaazi eyeeyagaza n’empeewo esanyusa,</para>
  <para style="q2" vid="PRO 5:19">leka okusuuta kwe kukumalenga ennaku zonna era naye akwetoloozenga okwagala kwe.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Lwaki mwana wange osendebwasendebwa omukazi omwenzi,</para>
  <para style="q2" vid="PRO 5:20">n’ogwa mu kifuba ky’omukazi w’omusajja omulala?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>Kubanga <char style="nd">Mukama</char> alaba amakubo g’omuntu gonna,</para>
  <para style="q2" vid="PRO 5:21">era n’akebera n’amakubo ge gonna.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>Ebikolwa by’omukozi w’ebibi bimufuukira omutego,</para>
  <para style="q2" vid="PRO 5:22">era emiguwa gy’ebikolwa bye ebibi girimusibira ddala.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Alifa, kubanga yagaana okwekuuma,</para>
  <para style="q2" vid="PRO 5:23">era alizikirira olw’obusirusiru bwe obungi.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Okulabula ku Butamanya n’Obusirusiru</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Mutabani obanga weeyimirira muliraanwa wo,</para>
  <para style="q2" vid="PRO 6:1">ne weeyama okuyamba omuntu gw’otomanyi, oli mu katyabaga.<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>Obanga weesibye n’ebigambo ggwe kennyini bye wayogera,</para>
  <para style="q2" vid="PRO 6:2">ng’ebigambo by’omu kamwa ko bikusibye,<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>kino mwana wange ky’oba okola okusobola okwewonya,</para>
  <para style="q2" vid="PRO 6:3">kubanga kaakano oli mu buyinza bwa muliraanwa wo:</para>
  <para style="q1" vid="PRO 6:3">Yanguwa, ogende weetoowaze,</para>
  <para style="q2" vid="PRO 6:3">weegayirire muliraanwa wo.<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Amaaso go togaganya kwebaka,</para>
  <para style="q2" vid="PRO 6:4">wadde ebikowe byo okubongoota.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>Onunule obulamu bwo ng’empeewo bw’edduka okuva mu ngalo z’omuyizzi,</para>
  <para style="q2" vid="PRO 6:5">era ng’ekinyonyi, bwe kiva mu mutego gw’omutezi.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>Yigira ku biwuka, mugayaavu ggwe;</para>
  <para style="q2" vid="PRO 6:6">fumiitiriza engeri gye bikolamu obiyigireko.<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Tebirina mukulembeze,</para>
  <para style="q2" vid="PRO 6:7">mukungu oba mufuzi yenna abikulembera,<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>kyokka byekuŋŋaanyiza emmere mu biseera eby’amakungula,</para>
  <para style="q2" vid="PRO 6:8">ne bitereka emmere mu biseera ebituufu mu mwaka.<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>Olituusa ddi okwebaka mugayaavu ggwe?</para>
  <para style="q2" vid="PRO 6:9">Oligolokoka ddi n’ova mu tulo two?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>Otulo otutonotono, n’okusumagira akatono,</para>
  <para style="q2" vid="PRO 6:10">n’okufunya emikono okuwummulako,<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>obwavu bulikutuukako ng’omutemu,</para>
  <para style="q2" vid="PRO 6:11">era n’obwetaavu ng’omutemu.<verse eid="PRO 6:11"/></para>
  <para style="s1">Okulabula eri Omuntu Omutabuzitabuzi</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Omuntu ataliiko ky’agasa, omusajja omubi</para>
  <para style="q2" vid="PRO 6:12">agenda ayogera ebigambo ebitabulatabula,<verse eid="PRO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13"/>agenda atemyatemya ku liiso,</para>
  <para style="q2" vid="PRO 6:13">nga bw’akuba ebigere</para>
  <para style="q2" vid="PRO 6:13">ate nga bw’asongasonga olunwe,<verse eid="PRO 6:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14"/>olw’omutima omukyamu, ateekateeka okukola ebibi,</para>
  <para style="q2" vid="PRO 6:14">bulijjo aleeta obutakkaanya mu bantu!<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Noolwekyo okuzikirira kulimujjira mbagirawo,</para>
  <para style="q2" vid="PRO 6:15">mu kaseera buseera alibetentebwa awatali kuwona.<verse eid="PRO 6:15"/></para>
  <para style="s1">Okulabula ku Bibi Omusanvu</para>
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16"/>Waliwo ebintu mukaaga <char style="nd">Mukama</char> by’akyawa,</para>
  <para style="li2" vid="PRO 6:16">weewaawo musanvu eby’omuzizo gy’ali.<verse eid="PRO 6:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17"/>Amaaso ag’amalala,</para>
  <para style="li3" vid="PRO 6:17">emimwa egirimba,</para>
  <para style="li3" vid="PRO 6:17">okuttira abantu obwereere;<verse eid="PRO 6:17"/></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18"/>omutima ogutegeka okukola ebibi,</para>
  <para style="li3" vid="PRO 6:18">ebigere ebyanguwa okukola ebibi,<verse eid="PRO 6:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19"/>obujulizi obw’obulimba,</para>
  <para style="li3" vid="PRO 6:19">n’omuntu aleeta obutakkaanya mu booluganda.<verse eid="PRO 6:19"/></para>
  <para style="s1">Okulabula Ku Bwenzi</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>Mwana wange nyweza ebiragiro bya kitaawo,</para>
  <para style="q2" vid="PRO 6:20">era togayaalirira kuyigiriza kwa maama wo.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>Bisibenga ku mutima gwo ennaku zonna</para>
  <para style="q2" vid="PRO 6:21">era obisibe binywerere mu bulago bwo.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Bijja kukuluŋŋamyanga buli gy’onoolaganga,</para>
  <para style="q2" vid="PRO 6:22">ne bw’onoobanga weebase binaakukuumanga,</para>
  <para style="q2" vid="PRO 6:22">ate ng’ozuukuse binaabanga naawe.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Kubanga amateeka ttabaaza,</para>
  <para style="q2" vid="PRO 6:23">era n’okuyigiriza kitangaala,</para>
  <para style="q1" vid="PRO 6:23">okukulabula olw’okukuluŋŋamya,</para>
  <para style="q2" vid="PRO 6:23">ly’ekkubo ery’obulamu,<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>okukuwonya omukazi ow’ebibi,</para>
  <para style="q2" vid="PRO 6:24">okukuggya mu kunyumiikiriza kw’omukazi omwenzi.<verse eid="PRO 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>Teweegombanga bulungi bwe mu mutima gwo,</para>
  <para style="q2" vid="PRO 6:25">wadde okumukkiriza okukuwamba n’amaaso ge,<verse eid="PRO 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>kubanga malaaya akussa ku muwendo ogugula omugaati,</para>
  <para style="q2" vid="PRO 6:26">era omukazi omwenzi anoonya kuzikiririza ddala bulamu bwo.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Omuntu ayinza okuwambaatira omuliro mu kifuba kye,</para>
  <para style="q2" vid="PRO 6:27">ebyambalo bye ne bitaggya?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Oba omuntu ayinza okutambulira ku manda agookya,</para>
  <para style="q2" vid="PRO 6:28">ebigere bye ne bitasiriira?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Bwe kityo bwe kiri eri omusajja agenda ne muka muliraanwa we,</para>
  <para style="q2" vid="PRO 6:29">buli akwata ku mukazi ng’oyo talirema kubonerezebwa olw’ekibi kye.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Abantu tebasekerera muntu bw’abba,</para>
  <para style="q2" vid="PRO 6:30">olw’okwewonya enjala.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>Naye bwe bamukwata aba alina okuwa engassi ya mirundi musanvu;</para>
  <para style="q2" vid="PRO 6:31">ne bwe kiba nga kimumalako ebintu bye byonna eby’omu nju ye.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>Naye buli ayenda ku mukazi talina magezi;</para>
  <para style="q2" vid="PRO 6:32">kubanga azikiririza ddala emmeeme ye ye.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>Alifuna ebiwundu n’okunyoomebwa;</para>
  <para style="q2" vid="PRO 6:33">n’obuswavu tebulimusangulibwako.<verse eid="PRO 6:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>Kubanga obuggya buleetera omusajja okuswakira,</para>
  <para style="q2" vid="PRO 6:34">era taliba na kisa n’akatono nga yeesasuza.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Talikkiriza mutango gwonna,</para>
  <para style="q2" vid="PRO 6:35">wadde okuwooyawooyezebwa enguzi ennene.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">Emitawaana Egiva mu Kukwana Omukazi Omwenzi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Mutabani nyweeza ebigambo byange,</para>
  <para style="q2" vid="PRO 7:1">era okuumenga ebiragiro byange.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Kwata ebiragiro byange obeere mulamu,</para>
  <para style="q2" vid="PRO 7:2">n’amateeka gange ogakuume ng’emmunye y’eriiso lyo;<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>togalekanga kuva mu ngalo zo,</para>
  <para style="q2" vid="PRO 7:3">gawandiike ku mutima gwo.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Amagezi gatwalire ddala nga mwannyoko,</para>
  <para style="q2" vid="PRO 7:4">n’okutegeera, ng’owooluganda ow’omu kika kyo.<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>Binaakuwonyanga omukazi omwenzi,</para>
  <para style="q2" vid="PRO 7:5">omukazi omutambuze awaanawaana n’ebigambo ebisendasenda.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Lumu nnali nnyimiridde</para>
  <para style="q2" vid="PRO 7:6">ku ddirisa ly’ennyumba yange.<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>Ne ndaba mu bavubuka abatoototo,</para>
  <para style="q2" vid="PRO 7:7">omulenzi atalina magezi,<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>ng’ayita mu luguudo okumpi n’akafo k’omukazi omwenzi,</para>
  <para style="q2" vid="PRO 7:8">n’akwata ekkubo eridda ku nnyumba y’omukazi oyo,<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>olw’eggulo ng’obudde buzibye,</para>
  <para style="q2" vid="PRO 7:9">ekizikiza nga kikutte.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Awo omukazi n’ajja okumusisinkana</para>
  <para style="q2" vid="PRO 7:10">ng’ayambadde nga malaaya, ng’ajjudde ebirowoozo eby’obukaba mu mutima gwe.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>Omukazi omukalukalu,</para>
  <para style="q2" vid="PRO 7:11">atambulatambula ennyo atabeerako waka,<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>wuuyo mu luguudo, wuuyo mu bifo ebikuŋŋaanirwamu,</para>
  <para style="q2" vid="PRO 7:12">mu buli kafo konna ng’ateega!<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>N’amuvumbagira, n’amunywegera</para>
  <para style="q2" vid="PRO 7:13">era ng’amutunuulidde nkaliriza n’amaaso agatatya n’amugamba nti:<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“Nnina ssaddaaka ez’ebiweebwayo olw’emirembe,</para>
  <para style="q2" vid="PRO 7:14">leero ntukiriza obweyamo bwange.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Noolwekyo nzize okukusisinkana,</para>
  <para style="q2" vid="PRO 7:15">mbadde njagala nnyo okukulaba, era kaakano nkusanze.<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Obuliri bwange mbwaze bulungi</para>
  <para style="q2" vid="PRO 7:16">n’engoye eza linena ava mu Misiri.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Mbukubye n’akaloosa,</para>
  <para style="q2" vid="PRO 7:17">n’omugavu, n’obubaane, ne kinamoni, ne kalifuuwa.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Jjangu tuwoomerwe omukwano okutuusa obudde okukya;</para>
  <para style="q2" vid="PRO 7:18">leka twesanyuse ffembi mu mukwano.<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Kubanga baze taliiyo eka;</para>
  <para style="q2" vid="PRO 7:19">yatambula olugendo luwanvu:<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Yagenda n’ensawo y’ensimbi;</para>
  <para style="q2" vid="PRO 7:20">era alikomawo nga wayiseewo wiiki bbiri.”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Yamusendasenda n’ebigambo ebisikiriza;</para>
  <para style="q2" vid="PRO 7:21">n’amuwabya n’ebigambo ebiwoomerera.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>Amangwago omuvubuka n’amugoberera</para>
  <para style="q2" vid="PRO 7:22">ng’ente etwalibwa okuttibwa</para>
  <para style="q1" vid="PRO 7:22">obanga empeewo egwa mu mutego,<verse eid="PRO 7:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23"/>okutuusa akasaale lwe kafumita ekibumba kyayo,</para>
  <para style="q1" vid="PRO 7:23">ng’akanyonyi bwe kanguwa okugwa mu mutego,</para>
  <para style="q2" vid="PRO 7:23">so tamanyi ng’alifiirwa obulamu bwe.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>Kaakano nno batabani bange mumpulirize,</para>
  <para style="q2" vid="PRO 7:24">era musseeyo nnyo omwoyo eri ebigambo byange.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Temukkiriza mitima gyammwe kugoberera bigambo bye;</para>
  <para style="q2" vid="PRO 7:25">temukkiriza bigere byammwe kukyamira mu makubo ge.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Kubanga bangi bazikiridde,</para>
  <para style="q2" vid="PRO 7:26">ddala ab’amaanyi bangi bagudde.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>Ennyumba ye, lye kkubo eridda emagombe,</para>
  <para style="q2" vid="PRO 7:27">nga likka mu bisenge eby’okufa.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Amagezi Gakoowoola</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Amagezi tegakoowoolera waggulu,</para>
  <para style="q2" vid="PRO 8:1">n’okutegeera ne kuyimusa eddoboozi lyakwo?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Ku ntikko y’ebifo ebigulumivu okumpi n’ekkubo,</para>
  <para style="q2" vid="PRO 8:2">mu masaŋŋanzira, amagezi we gayimirira butengerera,<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>ku mabbali g’enzigi eziyingira mu kibuga,</para>
  <para style="q2" vid="PRO 8:3">ku miryango, gakoowoolera waggulu nga gagamba nti,<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>Mmwe abantu, mmwe b’empita;</para>
  <para style="q2" vid="PRO 8:4">nnyimusa eddoboozi lyange eri buli omu ali ku nsi.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>Mmwe abatategeera mufune okutegeera;</para>
  <para style="q2" vid="PRO 8:5">nammwe abasirusiru mufune amagezi.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Muwulirize kubanga nnina ebintu ebikulu eby’okubagamba,</para>
  <para style="q2" vid="PRO 8:6">era mu kamwa kange muvaamu ebituufu.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Akamwa kange koogera bituufu byereere;</para>
  <para style="q2" vid="PRO 8:7">kubanga emimwa gyange gikyawa ebitali bya butuukirivu.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Ebigambo by’emimwa gyange byonna bya bwenkanya</para>
  <para style="q2" vid="PRO 8:8">tewali na kimu kikyamu oba kya bukuusa.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Ebigambo byange byonna bitegeerekeka eri oyo ategeera,</para>
  <para style="q2" vid="PRO 8:9">era tebirina kabi eri oyo alina amagezi.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Mu kifo kya ffeeza, londawo okuyigiriza kwange,</para>
  <para style="q2" vid="PRO 8:10">era n’okumanya mu kifo kya zaabu ennongoose obulungi,<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>kubanga amagezi gasinga amayinja ag’omuwendo omungi,</para>
  <para style="q2" vid="PRO 8:11">era n’ebyo byonna bye weegomba tebiyinza kugeraageranyizibwa nago.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>Nze Magezi, mbeera wamu n’okuteesa okulungi,</para>
  <para style="q2" vid="PRO 8:12">era mu nze mulimu okumanya n’okwawula ekirungi n’ekibi.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>Okutya <char style="nd">Mukama</char> kwe kukyawa ekibi;</para>
  <para style="q2" vid="PRO 8:13">nkyawa amalala n’okwemanya,</para>
  <para style="q2" vid="PRO 8:13">n’obuteeyisa bulungi n’enjogera ey’obubambaavu.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>Okuteesa okulungi n’okusalawo okw’amagezi bye byange;</para>
  <para style="q2" vid="PRO 8:14">ntegeera era ndi wa buyinza.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>Ku bwange, Magezi, bakabaka bafuga,</para>
  <para style="q2" vid="PRO 8:15">abafuzi ne bakola amateeka ag’obwenkanya.<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>Abalangira bafuga ku bwange,</para>
  <para style="q2" vid="PRO 8:16">n’abakungu bonna abafuga ku nsi.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Njagala abo abanjagala,</para>
  <para style="q2" vid="PRO 8:17">n’abo abanyiikira okunnoonya bandaba.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>Obugagga n’ekitiibwa biri mu nze,</para>
  <para style="q2" vid="PRO 8:18">obugagga obutakoma n’okukulaakulana.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Ekibala kyange kisinga zaabu ennongoose,</para>
  <para style="q2" vid="PRO 8:19">n’ebinvaamu bisinga ffeeza ey’omuwendo omungi.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Ntambulira mu kkubo ery’obutuukirivu,</para>
  <para style="q2" vid="PRO 8:20">mu kkubo ery’obwenkanya,<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>n’abo abanjagala mbagaggawaza</para>
  <para style="q2" vid="PRO 8:21">era nzijuza amawanika gaabwe.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>
    <char style="nd">Mukama</char> nze gwe yasooka okwoleka</para>
  <para style="q2" vid="PRO 8:22">nga tannabaako kirala ky’akola.<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>Nateekebwawo dda nnyo,</para>
  <para style="q2" vid="PRO 8:23">ku lubereberye ng’ensi tennabaawo.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Nateekebwawo ng’obuziba bw’ennyanja tebunnateekebwawo,</para>
  <para style="q2" vid="PRO 8:24">nga n’emigga egireeta amazzi teginnabaawo,<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ng’ensozi tezinnateekebwa mu bifo byazo,</para>
  <para style="q2" vid="PRO 8:25">nga n’obusozi tebunnabaawo;<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>nga tannakola nsi newaakubadde amalundiro gaakwo,</para>
  <para style="q2" vid="PRO 8:26">wadde enfuufu eyasooka ey’oku nsi.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Naliwo ng’ateekawo eggulu mu kifo kyalyo,</para>
  <para style="q2" vid="PRO 8:27">ne bwe yakola enkulungo kungulu ku buziba,<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>ate ne bwe yawanika ebire n’abinywereza waggulu mu bbanga,</para>
  <para style="q2" vid="PRO 8:28">n’anywereza ddala ensulo z’amazzi,<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>bwe yawa ennyanja ensalo zaazo we zikoma,</para>
  <para style="q2" vid="PRO 8:29">amazzi galeme kusukka we yagalagira,</para>
  <para style="q2" vid="PRO 8:29">ne bwe yali ng’alamba emisingi gy’ensi.<verse eid="PRO 8:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30"/>Nnali naye ng’omukozi omukugu,</para>
  <para style="q2" vid="PRO 8:30">nga nzijudde essanyu lye erya buli lunaku,</para>
  <para style="q2" vid="PRO 8:30">nga nsanyukira mu maaso ge bulijjo,<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>nga nsanyukira mu nsi ye yonna,</para>
  <para style="q2" vid="PRO 8:31">era nga ne nesiima olw’abaana b’abantu.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>Kale nno, batabani bange mumpulirize;</para>
  <para style="q2" vid="PRO 8:32">balina omukisa abo abakwata amakubo gange!<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>Muwulirizenga okuyigirizibwa, mubenga n’amagezi,</para>
  <para style="q2" vid="PRO 8:33">so temugalekanga.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>Alina omukisa omuntu ampuliriza,</para>
  <para style="q2" vid="PRO 8:34">alindirira nga bw’akuuma ku nzigi zange</para>
  <para style="q2" vid="PRO 8:34">buli lunaku.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Kubanga buli andaba afuna obulamu,</para>
  <para style="q2" vid="PRO 8:35">era afuna okuganja eri <char style="nd">Mukama</char>.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>Oyo atannoonya yeerumya yekka,</para>
  <para style="q2" vid="PRO 8:36">era n’abo bonna abankyawa banoonya kufa.<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Empagi z’Amagezi Omusanvu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>Amagezi gazimbye ennyumba yaago,</para>
  <para style="q2" vid="PRO 9:1">gagizimbidde ku mpagi musanvu.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Gategese ennyama yaago ne wayini<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Wayini yatabulwangamu ebyakaloosa aka mooli, yeeyongere okuwoomerera.</char></note> waago;</para>
  <para style="q2" vid="PRO 9:2">gategese ekijjulo.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Gatumye abawala abaweereza bakoowoolere</para>
  <para style="q2" vid="PRO 9:3">mu bifo ebigulumivu nti,<verse eid="PRO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4"/>“Buli atalina kutegeera akyameko wano!”</para>
  <para style="q2" vid="PRO 9:4">Eri abo abatalina magezi gabagamba nti,<verse eid="PRO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5"/>“Mujje mulye ku mmere yange</para>
  <para style="q2" vid="PRO 9:5">era munywe ne ku nvinnyo gwe ntabudde.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Mulekeraawo obutaba na kutegeera mubeere balamu,</para>
  <para style="q2" vid="PRO 9:6">era mutambulire mu kkubo ly’okumanya.”<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>Oyo anenya omunyoomi ayolekera kuvumwa,</para>
  <para style="q2" vid="PRO 9:7">n’oyo abuulirira omukozi w’ebibi yeeretera kuvumibwa.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Tonenyanga munyoomi, aleme okukukyawa, naye</para>
  <para style="q2" vid="PRO 9:8">nenya ow’amagezi naye anaakwagalanga.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Yigirizanga ow’amagezi naye aneeyongeranga okuba n’amagezi,</para>
  <para style="q2" vid="PRO 9:9">yigirizanga omutuukirivu, aneeyongerangako okuyiga.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>“Mu kutya <char style="nd">Mukama</char> amagezi mwe gasookera,</para>
  <para style="q2" vid="PRO 9:10">era n’okumanya oyo Omutukuvu Katonda, kwe kutegeera.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Ku lwange oliwangaala emyaka mingi nnyo,</para>
  <para style="q2" vid="PRO 9:11">era olyongerwako emyaka.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Bw’obeera omugezi, amagezi go gakuyamba,</para>
  <para style="q2" vid="PRO 9:12">naye bw’onyooma amagezi weerumya wekka.”<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>Omukazi omusirusiru aleekaana,</para>
  <para style="q2" vid="PRO 9:13">taba na mpisa era taba na magezi!<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Era atuula mu mulyango gw’ennyumba ye,</para>
  <para style="q2" vid="PRO 9:14">ne ku ntebe mu bifo eby’ekibuga ebisinga obugulumivu,<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>ng’akoowoola abo abayitawo,</para>
  <para style="q2" vid="PRO 9:15">ababa batambula amakubo gaabwe abali ku byabwe.<verse eid="PRO 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16"/>Abagamba nti, “Buli alina okumanya okutono ajje muno.”</para>
  <para style="q2" vid="PRO 9:16">Era eri oyo atalina kutegeera agamba nti,<verse eid="PRO 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17"/>“Amazzi amabbe nga gawooma!</para>
  <para style="q2" vid="PRO 9:17">emmere eriibwa mu kyama ng’ewooma!”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>Naye oyo agwa mu kitimba kye tamanya nti nnyumba yakuzikirira,</para>
  <para style="q2" vid="PRO 9:18">era nti abagenyi be bali mu buziba obw’emagombe.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">Engero za Sulemaani</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>Engero za Sulemaani:</para>
  <para style="q1" vid="PRO 10:1">Omwana ow’amagezi asanyusa kitaawe;</para>
  <para style="q2" vid="PRO 10:1">naye omwana omusirusiru anakuwaza nnyina.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>Eby’obugagga ebifuniddwa mu makubo amakyamu tebirina kye bigasa,</para>
  <para style="q2" vid="PRO 10:2">naye abatuukirivu banunulwa okuva mu kufa.<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>
    <char style="nd">Mukama</char> taalekenga mutuukirivu we kufa njala,</para>
  <para style="q2" vid="PRO 10:3">naye aziyiza abakozi b’ebibi okufuna bye beetaaga.<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Emikono emigayaavu gyavuwaza,</para>
  <para style="q2" vid="PRO 10:4">naye emikono eminyiikivu gireeta obugagga.<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Omuvubuka ow’amagezi akungulira mu biseera ebituufu,</para>
  <para style="q2" vid="PRO 10:5">naye oyo eyeebakira mu biro eby’okukunguliramu mwana aswaza ennyo.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>Omukisa gubeera ku mutwe gw’omutuukirivu,</para>
  <para style="q2" vid="PRO 10:6">naye akamwa k’omukozi w’ebibi kajjula obukambwe.<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Omutuukirivu anajjukirwanga n’essanyu,</para>
  <para style="q2" vid="PRO 10:7">naye erinnya ly’omubi linaavundanga.<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>Alina omutima ogw’amagezi agondera ebiragiro,</para>
  <para style="q2" vid="PRO 10:8">naye omusirusiru ayogerayogera, azikirizibwa.<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Atambulira mu bwesimbu y’atambula emirembe,</para>
  <para style="q2" vid="PRO 10:9">naye akwata amakubo amakyamu alitegeerebwa.<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Oyo atta ku liiso ng’akweka amazima aleeta ennaku,</para>
  <para style="q2" vid="PRO 10:10">n’omusirusiru ayogerayogera alizikirizibwa.<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>Akamwa ak’omutuukirivu nsulo ya bulamu,</para>
  <para style="q2" vid="PRO 10:11">naye akamwa k’omukozi w’ebibi kajjula bulabe.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Obukyayi buleeta enjawukana,</para>
  <para style="q2" vid="PRO 10:12">naye okwagala kubikka ku bibi bingi.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Amagezi gasangibwa ku mimwa gy’oyo alina okutegeera,</para>
  <para style="q2" vid="PRO 10:13">naye omuggo gukangavvula oyo atamanyi kusalawo bulungi.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>Abantu ab’amagezi batereka okumanya,</para>
  <para style="q2" vid="PRO 10:14">naye akamwa k’omusirusiru kaaniriza kuzikirira.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Obugagga bw’omugagga kye kibuga kye ekiriko ebigo,</para>
  <para style="q2" vid="PRO 10:15">naye obwavu kwe kuzikirira kw’omwavu.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>Empeera y’omutuukirivu bulamu,</para>
  <para style="q2" vid="PRO 10:16">naye empeera y’omukozi w’ebibi emuleetera kubonerezebwa.<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Oyo assaayo omwoyo eri okubuulirirwa aba mu kkubo ery’obulamu,</para>
  <para style="q2" vid="PRO 10:17">naye oyo atassaayo mwoyo ku kunenyezebwa aleetera abalala okuwaba.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Oyo akisa obukyayi alina emimwa egirimba,</para>
  <para style="q2" vid="PRO 10:18">era omuntu akonjera, musirusiru.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Mu bigambo ebingi temubula kwonoona,</para>
  <para style="q2" vid="PRO 10:19">naye akuuma olulimi lwe aba wa magezi.<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Olulimi lw’omutuukirivu ffeeza ya muwendo,</para>
  <para style="q2" vid="PRO 10:20">naye omutima gw’omukozi w’ebibi gugasa katono.<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>Ebigambo by’omutuukirivu biriisa abantu bangi,</para>
  <para style="q2" vid="PRO 10:21">naye abasirusiru bazikirira olw’okubulwa amagezi.<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>Omukisa gwa <char style="nd">Mukama</char> guleeta obugagga</para>
  <para style="q2" vid="PRO 10:22">era tagwongerako buyinike.<verse eid="PRO 10:22"/></para>
  <para style="s1">Okuwangaala Okuli mu Kutya <char style="nd">Mukama</char></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Omusirusiru asanyukira okukola ebibi,</para>
  <para style="q2" vid="PRO 10:23">naye omuntu alina okutegeera asanyukira eby’amagezi.<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Omukozi w’ebibi ky’atayagala kirimutuukako,</para>
  <para style="q2" vid="PRO 10:24">naye abatuukirivu bye baagala biribaweebwa.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Embuyaga bw’ejja, abakozi b’ebibi batwalibwa,</para>
  <para style="q2" vid="PRO 10:25">naye abatuukirivu banywera emirembe gyonna.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Ng’omususa bwe gunyeenyeza amannyo, n’omukka nga bwe gubalagala mu maaso,</para>
  <para style="q2" vid="PRO 10:26">n’omugayaavu bw’abeera bw’atyo eri abamutuma.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>Okutya <char style="nd">Mukama</char> kuwangaaza omuntu,</para>
  <para style="q2" vid="PRO 10:27">naye emyaka gy’ababi girisalibwako.<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Essuubi ly’abatuukirivu livaamu ssanyu,</para>
  <para style="q2" vid="PRO 10:28">naye okusuubira kw’abakozi b’ebibi tekulivaamu kantu.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>Ekkubo lya <char style="nd">Mukama</char> kye kiddukiro ky’abatuukirivu, naye abakozi b’ebibi libasaanyaawo.<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Abatuukirivu tebajjululwenga ennaku zonna,</para>
  <para style="q2" vid="PRO 10:30">naye abakozi b’ebibi tebalisigala mu nsi.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>Akamwa k’omutuukirivu koogera eby’amagezi,</para>
  <para style="q2" vid="PRO 10:31">naye olulimi olwogera eby’obubambavu lulisalibwamu.<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Emimwa gy’omutuukirivu gyogera ebisaanidde;</para>
  <para style="q2" vid="PRO 10:32">naye emimwa gy’omukozi w’ebibi gyogera eby’obubambavu.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>Minzaani eteri ya mazima ya muzizo eri <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 11:1">naye ebipimo ebituufu bye bimusanyusa.<verse eid="PRO 11:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Amalala bwe gajja, ng’obuswavu butuuse,</para>
  <para style="q2" vid="PRO 11:2">naye obwetoowaze buleeta amagezi.<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Obwesimbu bw’abatuukirivu bubaluŋŋamya,</para>
  <para style="q2" vid="PRO 11:3">naye enkwe z’abatali beesigwa zibazikirizisa.<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Obugagga tebugasa ku lunaku olw’okusalirwako omusango,</para>
  <para style="q2" vid="PRO 11:4">naye obutuukirivu buwonya okufa.<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Obutuukirivu bw’abalongoofu bubatambuliza mu kkubo eggolokofu</para>
  <para style="q2" vid="PRO 11:5">naye abakozi b’ebibi bagwa olw’ebikolwa byabwe ebibi.<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Obutuukirivu bw’abagolokofu bubawonya,</para>
  <para style="q2" vid="PRO 11:6">naye abatali beesigwa bagwa mu mutego olw’okwegomba ebibi.<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Omukozi w’ebibi bw’afa, essuubi lye libula,</para>
  <para style="q2" vid="PRO 11:7">ne byonna bye yasuubira mu maanyi bikoma.<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Omutuukirivu aggyibwa mu mitawaana,</para>
  <para style="q2" vid="PRO 11:8">naye jjijjira omukozi w’ebibi.<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Akamwa k’oyo atatya Katonda, kazikiriza muliraanwa,</para>
  <para style="q2" vid="PRO 11:9">naye olw’okumanya, abatuukirivu bawona.<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Abatuukirivu bwe bakulaakulana ekibuga kijaguza;</para>
  <para style="q2" vid="PRO 11:10">abakozi b’ebibi bwe bazikirira wawulirwawo amaloboozi ag’essanyu.<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Omukisa gw’abatuukirivu gukulaakulanya ekibuga:</para>
  <para style="q2" vid="PRO 11:11">naye olw’akamwa k’abakozi b’ebibi, ekibuga kizikirizibwa.<verse eid="PRO 11:11"/></para>
  <para style="s1">Abeesigwa n’Abatambuza Eŋŋambo</para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Omuntu atalina magezi anyooma muliraanwa we,</para>
  <para style="q2" vid="PRO 11:12">naye omuntu ategeera akuuma olulimi lwe.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Aseetula olugambo atta obwesigwa,</para>
  <para style="q2" vid="PRO 11:13">naye omuntu omwesigwa akuuma ekyama.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Awatali kuluŋŋamizibwa eggwanga lidobonkana,</para>
  <para style="q2" vid="PRO 11:14">naye abawi b’amagezi abangi baleeta obuwanguzi.<verse eid="PRO 11:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Eyeeyimirira omuntu gw’atamanyiko alibonaabona,</para>
  <para style="q2" vid="PRO 11:15">naye oyo akyawa okweyimirira aliba bulungi.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Omukazi ow’ekisa aweebwa ekitiibwa,</para>
  <para style="q2" vid="PRO 11:16">naye abasajja ab’amawaggali bakoma ku bugagga bwokka.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Omusajja alina ekisa aganyulwa,</para>
  <para style="q2" vid="PRO 11:17">naye alina ettima yeereetako akabi.<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Omukozi w’ebibi afuna empeera ey’obukuusa,</para>
  <para style="q2" vid="PRO 11:18">naye oyo asiga eby’obutuukirivu akungula empeera eya nnama ddala.<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Omuntu omutuukirivu ddala alifuna obulamu,</para>
  <para style="q2" vid="PRO 11:19">naye oyo akola ebitali bya butuukirivu alifa.<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>
    <char style="nd">Mukama</char> akyawa abantu abalina emitima emikyamu,</para>
  <para style="q2" vid="PRO 11:20">naye ab’amakubo amagolokofu be bamusanyusa.<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Mutegeerere ddala ng’abakozi b’ebibi tebalirema kubonerezebwa,</para>
  <para style="q2" vid="PRO 11:21">naye bazzukulu b’abatuukirivu tebalibaako musango.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Ng’empeta ya zaabu mu nnyindo y’embizzi,</para>
  <para style="q2" vid="PRO 11:22">bw’atyo bw’abeera omukazi omulungi atalaba njawulo wakati w’ekirungi n’ekibi.<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Abatuukirivu bye beegomba bivaamu birungi byereere,</para>
  <para style="q2" vid="PRO 11:23">naye abakozi b’ebibi bye bakola bisunguwaza.<verse eid="PRO 11:23"/></para>
  <para style="s1">Omuntu Omugabi</para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Omuntu agaba obuteerekereza, yeeyongera bweyongezi kugaggawala;</para>
  <para style="q2" vid="PRO 11:24">naye akwatirira kye yandigabye, yeeyongera kwavuwala.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Omuntu agaba anagaggawalanga,</para>
  <para style="q2" vid="PRO 11:25">n’oyo ayamba talibulako amuyamba.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Abantu bakolimira oyo akweka eŋŋaano mu kiseera eky’obwetaavu,</para>
  <para style="q2" vid="PRO 11:26">naye oyo agitunda mu kiseera ekyo afuna emikisa.<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Oyo anyiikira okukola obulungi afuna okuganja,</para>
  <para style="q2" vid="PRO 11:27">naye oyo anoonya ekibi, kimujjira.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Oyo eyeesiga obugagga bwe aligwa,</para>
  <para style="q2" vid="PRO 11:28">naye abatuukirivu banaakulaakulananga ne baba ng’amalagala amalamu.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Omuntu aleeta emitawaana mu maka g’ewaabwe, alisikira mpewo;</para>
  <para style="q2" vid="PRO 11:29">era n’omusirusiru aliba muddu w’oyo alina omutima ogw’amagezi.<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Ekibala ky’omutuukirivu muti gwa bulamu,</para>
  <para style="q2" vid="PRO 11:30">era n’oyo asikiriza emyoyo gy’abantu ne balokoka wa magezi.<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Obanga omutuukirivu alifuna ekimusaanidde ku nsi kuno,</para>
  <para style="q2" vid="PRO 11:31">oyo atatya Katonda n’omwonoonyi balirema obutafuna ekibasaanidde?<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Buli asanyukira okukangavvulwa ayagala amagezi;</para>
  <para style="q2" vid="PRO 12:1">naye oyo akyawa okunenyezebwa musirusiru.<verse eid="PRO 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Omuntu omulungi aganja mu maaso ga <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 12:2">naye <char style="nd">Mukama</char> asalira omusango omuntu ow’enkwe.<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Omuntu tanywezebwa lwa kukola bitali bya butuukirivu,</para>
  <para style="q2" vid="PRO 12:3">naye omulandira gw’omutuukirivu tegulisigulwa.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Omukyala ow’empisa ennungi ssanyu era ngule ya mwami we,</para>
  <para style="q2" vid="PRO 12:4">naye omukazi eyeeyisa obubi ali nga kookolo mu magumba ga bba.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Enteekateeka z’omutuukirivu ziba za mazima,</para>
  <para style="q2" vid="PRO 12:5">naye amagezi g’abakozi b’ebibi ge bawa gaba ga bulimba.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Ebiteeso by’abakozi b’ebibi kuyiwa musaayi,</para>
  <para style="q2" vid="PRO 12:6">naye ebigambo by’abatuukirivu bye bibawonya.<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Abakozi b’ebibi bagwa ne basaanirawo ddala,</para>
  <para style="q2" vid="PRO 12:7">naye ennyumba y’omutuukirivu teesagaasaganenga emirembe gyonna.<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Ebigambo by’omugezi bimuleetera okusiimibwa,</para>
  <para style="q2" vid="PRO 12:8">naye eby’omusirusiru bimunyoomesa.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Omuntu eyeetoowaza ne yeekolera,</para>
  <para style="q2" vid="PRO 12:9">asinga oyo eyeegulumiza n’abulwa ky’alya.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Omutuukirivu afaayo ku bisolo bye,</para>
  <para style="q2" vid="PRO 12:10">naye omukozi w’ebibi abiraga bukambwe bwereere.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Oyo eyeerimira aliba n’emmere nnyingi,</para>
  <para style="q2" vid="PRO 12:11">naye oyo anoonya ebitaliimu talina magezi.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Abakozi b’ebibi baagala okubba omunyago gwa babbi bannaabwe,</para>
  <para style="q2" vid="PRO 12:12">naye omulandira gw’abatuukirivu gunywera.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Ebigambo by’omukozi w’ebibi bimusuula mu mitawaana,</para>
  <para style="q2" vid="PRO 12:13">naye omutuukirivu awona akabi.<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Omuntu ajjuzibwa ebirungi okuva mu bibala bye bigambo by’akamwa ke,</para>
  <para style="q2" vid="PRO 12:14">n’emirimu gy’emikono gye gimusasula bulungi.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Ekkubo ly’omusirusiru ddungi mu kulaba kwe ye,</para>
  <para style="q2" vid="PRO 12:15">naye omugezi assaayo omwoyo ku magezi agamuweebwa.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Omusirusiru alaga mangu obusungu bwe,</para>
  <para style="q2" vid="PRO 12:16">naye omutegeevu tassa mwoyo ku kivume.<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Omujulizi ow’amazima awa obujulizi obutuufu,</para>
  <para style="q2" vid="PRO 12:17">naye omujulizi ow’obulimba ayogera bya bulimba.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Ebigambo ebyanguyirize bisala ng’ekitala ekyogi,</para>
  <para style="q2" vid="PRO 12:18">naye olulimi lw’omuntu omugezi luwonya.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Emimwa egyogera amazima gibeerera emirembe gyonna,</para>
  <para style="q2" vid="PRO 12:19">naye olulimi olulimba lwa kiseera buseera.<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Obulimba buli mu mitima gyabo abategeka okukola ebibi,</para>
  <para style="q2" vid="PRO 12:20">naye essanyu liri n’abo abakolerera emirembe.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>Tewali kabi konna kagwa ku batuukirivu,</para>
  <para style="q2" vid="PRO 12:21">naye abakozi b’ebibi tebaggwaako mitawaana.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>
    <char style="nd">Mukama</char> akyawa emimwa egirimba,</para>
  <para style="q2" vid="PRO 12:22">naye asanyukira ab’amazima.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Omuntu omutegeevu talaga nnyo by’amanyi,</para>
  <para style="q2" vid="PRO 12:23">naye abasirusiru balaga obutamanya bwabwe.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>Omukono gw’omunyiikivu gulimufuula omufuzi,</para>
  <para style="q2" vid="PRO 12:24">naye obugayaavu bufuula omuntu omuddu.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Omutima ogweraliikirira guleetera omuntu okwennyika,</para>
  <para style="q2" vid="PRO 12:25">naye ekigambo eky’ekisa kimusanyusa.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Omutuukirivu yeegendereza mu mikwano gye,</para>
  <para style="q2" vid="PRO 12:26">naye ekkubo ly’ababi libabuza.<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Omuntu omugayaavu tayokya muyiggo gwe,</para>
  <para style="q2" vid="PRO 12:27">naye omunyiikivu kyayizze, kiba kya muwendo gyali.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>Mu kkubo ery’obutuukirivu mulimu obulamu,</para>
  <para style="q2" vid="PRO 12:28">era mu kkubo eryo temuli kufa.<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="s1">Ensibuko y’Obugagga Obungi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Omwana omugezi assaayo omwoyo eri ebiragiro bya kitaawe,</para>
  <para style="q2" vid="PRO 13:1">naye omunyoomi tafaayo ku kunenyezebwa.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Omuntu asanyuka olw’ebirungi ebiva mu bibala bya kamwa ke,</para>
  <para style="q2" vid="PRO 13:2">naye atali mwesigwa yeegomba kuleeta ntalo.<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Oyo eyeegendereza by’ayogera akuuma obulamu bwe,</para>
  <para style="q2" vid="PRO 13:3">naye oyo amala googera, alizikirira.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Omuntu omugayaavu yeegomba kyokka n’atabaako ky’afuna,</para>
  <para style="q2" vid="PRO 13:4">naye omunyiikivu byayagala byonna abifuna.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Omuntu omutuukirivu akyawa obulimba,</para>
  <para style="q2" vid="PRO 13:5">naye omukozi w’ebibi yeereetera kunyoomebwa.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Obutuukirivu bukuuma omuntu omwesimbu,</para>
  <para style="q2" vid="PRO 13:6">naye okukola ebibi kuzikiriza omwonoonyi.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Omuntu omu ayinza okwefuula omugagga ate nga taliiko ky’alina,</para>
  <para style="q2" vid="PRO 13:7">ate omulala ne yeefuula okuba omwavu so nga mugagga nnyo.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Obugagga bw’omuntu buyinza okumununula,</para>
  <para style="q2" vid="PRO 13:8">naye omwavu talina ky’atya.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>Ekitangaala ky’abatuukirivu kyaka nnyo,</para>
  <para style="q2" vid="PRO 13:9">naye ettaala y’abakozi b’ebibi ezikira.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Amalala gazaala buzaazi nnyombo,</para>
  <para style="q2" vid="PRO 13:10">naye amagezi gasangibwa mu abo abakkiriza okulabulwa.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Ensimbi enkumpanye ziggwaawo,</para>
  <para style="q2" vid="PRO 13:11">naye ezijja empolampola zeeyongera obungi.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Essuubi erirwawo okutuukirira lirwaza omutima,</para>
  <para style="q2" vid="PRO 13:12">naye ekyegombebwa bwe kituukirira kiba muti gwa bulamu.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Omuntu anyooma ebiragiro aligwa mu mitawaana,</para>
  <para style="q2" vid="PRO 13:13">naye oyo awuliriza ebimulagirwa aliweebwa empeera.<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Okuyigiriza kw’omuntu alina amagezi nsulo ya bulamu,</para>
  <para style="q2" vid="PRO 13:14">era kuggya omuntu mu mitego gy’okufa.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>Okutegeera okulungi kuleeta okuganja,</para>
  <para style="q2" vid="PRO 13:15">naye ekkubo ly’abateesigibwa liba zzibu.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Omuntu omwegendereza akola amaze kulowooza,</para>
  <para style="q2" vid="PRO 13:16">naye omusirusiru alaga obutamanya bwe.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Omubaka omubi yeesuula mu mitawaana,</para>
  <para style="q2" vid="PRO 13:17">naye omubaka omwesigwa aleeta kuwonyezebwa.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>Anyooma okukangavvulwa yeereetako obwavu n’obuswavu,</para>
  <para style="q2" vid="PRO 13:18">naye oyo assaayo omwoyo ku kunenyezebwa aweebwa ekitiibwa.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Ekyegombebwa bwe kituukirira kisanyusa omutima,</para>
  <para style="q2" vid="PRO 13:19">naye okulekayo okukola ebibi kya muzizo eri abasirusiru.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>Oyo atambula n’abantu abagezi ageziwala,</para>
  <para style="q2" vid="PRO 13:20">naye oyo atambula n’abasirusiru alaba ennaku.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Emitawaana gigoberera aboonoonyi,</para>
  <para style="q2" vid="PRO 13:21">naye okukulaakulana y’empeera y’abatuukirivu.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>Omuntu omulungi alekera bazzukulu be ebyobusika,</para>
  <para style="q2" vid="PRO 13:22">naye obugagga bw’omwonoonyi buterekerwa omutuukirivu.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Ennimiro z’abaavu ziyinza okuvaamu emmere nnyingi,</para>
  <para style="q2" vid="PRO 13:23">naye obutali bwenkanya ne bugyera yonna.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Atakozesa kaggo akyawa omwana we,</para>
  <para style="q2" vid="PRO 13:24">naye oyo amwagala afaayo okumukangavvula.<verse eid="PRO 13:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Omutuukirivu alya emmere ye n’akkuta,</para>
  <para style="q2" vid="PRO 13:25">naye abakozi b’ebibi basigala nga bayala.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>Omukazi ow’amagezi yeezimbira ennyumba ye,</para>
  <para style="q2" vid="PRO 14:1">naye omusirusiru eyiye agyemenyera n’emikono gye.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Omuntu atambulira mu bugolokofu atya <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 14:2">naye ow’amakubo amakyamu anyooma <char style="nd">Mukama</char>.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Ebigambo by’omusirusiru bye bimuviirako okukubwa,</para>
  <para style="q2" vid="PRO 14:3">naye eby’abatuukirivu binaabakuumanga.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Awataba nte nnume ezirima ebyagi biba bikalu,</para>
  <para style="q2" vid="PRO 14:4">naye emmere ennyingi eva mu maanyi gaazo.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Omujulizi ow’amazima talimba,</para>
  <para style="q2" vid="PRO 14:5">naye ow’obulimba ayogera bya bulimba.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Omukudaazi anoonya amagezi n’atagalaba,</para>
  <para style="q2" vid="PRO 14:6">naye okumanya kwanguyira omuntu ategeera.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Teweeretereza muntu musirusiru,</para>
  <para style="q2" vid="PRO 14:7">kubanga tewali by’amagezi biva mu kamwa ke.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Omutegeevu mugezi kubanga afaayo okutegeera by’akola,</para>
  <para style="q2" vid="PRO 14:8">naye atalina magezi musirusiru kubanga yeerimba nti amanyi.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Abasirusiru banyooma okugololwa nga bakoze ensobi,</para>
  <para style="q2" vid="PRO 14:9">naye abalongoofu baagala emirembe.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Buli mutima gumanya okulumwa kwagwo,</para>
  <para style="q2" vid="PRO 14:10">tewali ayinza kugusanyukirako.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>Ennyumba y’abakozi b’ebibi erizikirizibwa,</para>
  <para style="q2" vid="PRO 14:11">naye eweema y’abatuukirivu erikulaakulana.<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Waliwo ekkubo erirabika nga ttuufu eri omuntu,</para>
  <para style="q2" vid="PRO 14:12">naye ng’enkomerero yaalyo kufa.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>Enseko zandibaawo naye ng’omutima gujjudde ennaku,</para>
  <para style="q2" vid="PRO 14:13">era n’enkomerero y’essanyu eyinza okufuuka obuyinike.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Omuntu atalina kukkiriza alisasulwa empeera emusaanira olw’ebikolwa bye,</para>
  <para style="q2" vid="PRO 14:14">n’omuntu omulungi naye alisasulwa eyiye.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Ow’amagezi amatono amala gakkiriza buli kigambo ky’awulira,</para>
  <para style="q2" vid="PRO 14:15">naye omuntu omutegeevu yeegendereza amakubo ge.<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Omuntu ow’amagezi atya <char style="nd">Mukama</char> n’aleka okukola ebibi,</para>
  <para style="q2" vid="PRO 14:16">naye omusirusiru yeepankapanka era teyeegendereza.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Omuntu asunguwala amangu akola eby’obusirusiru,</para>
  <para style="q2" vid="PRO 14:17">n’omukalabakalaba akyayibwa.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Abatalina magezi basikira butaliimu,</para>
  <para style="q2" vid="PRO 14:18">naye abategeevu batikkirwa engule ey’okumanya.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>Abakozi b’ebibi balivuunamira abatuukirivu,</para>
  <para style="q2" vid="PRO 14:19">n’aboonoonyi ne bavuunama mu miryango gy’abatuukirivu.<verse eid="PRO 14:19"/></para>
  <para style="s1">Omugagga n’Omwavu</para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>Omwavu alagajjalirwa abantu nga ne muliraanwa we omutwaliddemu,</para>
  <para style="q2" vid="PRO 14:20">naye abagagga baba n’emikwano mingi.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Anyooma muliraanwa we akola kibi,</para>
  <para style="q2" vid="PRO 14:21">naye alina omukisa oyo asaasira abaavu.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>Abateekateeka okukola ebibi, tebawaba?</para>
  <para style="q2" vid="PRO 14:22">Naye okwagala n’amazima binaabeeranga n’abo abateesa okukola obulungi.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Buli mulimu ogukolebwa n’amaanyi gubaako amagoba,</para>
  <para style="q2" vid="PRO 14:23">naye okwogera obwogezi kireeta bwavu bwokka.<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>Abagezi bafuna engule ey’obugagga,</para>
  <para style="q2" vid="PRO 14:24">naye obusirusiru bw’abatalina magezi buzaala busirusiru.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Omujulizi ow’amazima awonya obulamu bw’abantu,</para>
  <para style="q2" vid="PRO 14:25">naye omujulizi ow’obulimba aba mulimba.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Atya <char style="nd">Mukama</char> alina ekiddukiro eky’amaanyi,</para>
  <para style="q2" vid="PRO 14:26">era n’abaana be balibeera n’obuddukiro.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>Okutya <char style="nd">Mukama</char> ye nsulo y’obulamu,</para>
  <para style="q2" vid="PRO 14:27">kuleetera omuntu okwewala emitego gy’okufa.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Ekitiibwa kya kabaka kiri mu kuba n’abantu bangi,</para>
  <para style="q2" vid="PRO 14:28">naye omukulembeze ataba n’abantu abeera mu kabi.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Omuntu omugumiikiriza aba n’okutegeera kungi,</para>
  <para style="q2" vid="PRO 14:29">naye oyo asunguwala amangu ayolesa obusirusiru.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Omutima ogulina emirembe guwangaaza omuntu,</para>
  <para style="q2" vid="PRO 14:30">naye obuggya buvunza amagumba ge.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Omuntu atulugunya abaavu anyooma oyo eyabatonda,</para>
  <para style="q2" vid="PRO 14:31">naye buli abakwatirwa ekisa, agulumiza Katonda.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Akacwano bwe kajja, omukozi w’ebibi agwa,</para>
  <para style="q2" vid="PRO 14:32">naye omutuukirivu ne mu kufa aba n’obuddukiro.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Amagezi gabeera mu mutima gw’omuntu alina okutegeera,</para>
  <para style="q2" vid="PRO 14:33">era yeeyoleka ne mu basirusiru.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Obutuukirivu buzimba eggwanga,</para>
  <para style="q2" vid="PRO 14:34">naye ekibi kiswaza abantu ab’engeri zonna.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Kabaka asanyukira omuddu akola eby’amagezi,</para>
  <para style="q2" vid="PRO 14:35">naye obusungu bwa kabaka bunaabuubuukiranga ku oyo akola ebiswaza.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Okuddamu n’eggonjebwa kumalawo ekiruyi,</para>
  <para style="q2" vid="PRO 15:1">naye ekigambo eky’obukambwe kisaanuula obusungu.<verse eid="PRO 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>Olulimi lw’omugezi lwogera by’amagezi,</para>
  <para style="q2" vid="PRO 15:2">naye akamwa k’abasirusiru kafukumula busirusiru bwereere.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>Amaaso ga <char style="nd">Mukama</char> galaba buli wantu,</para>
  <para style="q2" vid="PRO 15:3">alaba abatuukirivu n’abakozi b’ebibi.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Olulimi oluzimba muti gwa bulamu,</para>
  <para style="q2" vid="PRO 15:4">naye olulimi olulimba lubetenta omutima.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Omusirusiru anyooma okubuulirirwa kwa kitaawe,</para>
  <para style="q2" vid="PRO 15:5">naye omutegeevu assaayo omwoyo eri okunenyezebwa.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Mu nnyumba y’omutuukirivu mubaamu obugagga bungi,</para>
  <para style="q2" vid="PRO 15:6">naye omukozi w’ebibi by’afuna, bimuleetera emitawaana.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Akamwa k’amagezi kabunyisa okumanya,</para>
  <para style="q2" vid="PRO 15:7">naye omutima gw’abasirusiru si bwe gukola.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>Ssaddaaka y’aboonoonyi ya muzizo eri <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 15:8">naye okusaba kw’abalongoofu lye ssanyu lye.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>Ekkubo ly’omwonoonyi lya muzizo eri <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 15:9">naye <char style="nd">Mukama</char> ayagala oyo anoonya obutuukirivu.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Oyo aleka ekkubo ettuufu alikangavvulwa n’amaanyi,</para>
  <para style="q2" vid="PRO 15:10">n’oyo akyawa okunenyezebwa alifa.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Okufa n’okuzikirira biri mu maaso ga <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 15:11">n’okulaba alaba nnyo emitima gy’abaana b’abantu!<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>Omunyoomi tayagala kunenyezebwa,</para>
  <para style="q2" vid="PRO 15:12">era teeyeebuuza ku b’amagezi.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Omutima omusanyufu guleeta essanyu ku maaso,</para>
  <para style="q2" vid="PRO 15:13">naye omutima omunyiikaavu gunafuya emmeeme.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>Omutima omutegeevu gunoonya okumanya,</para>
  <para style="q2" vid="PRO 15:14">naye akamwa k’abasirusiru kalya busirusiru.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Omuntu bw’aba omunyiikaavu, buli kimu kimwononekera,</para>
  <para style="q2" vid="PRO 15:15">naye omutima omusanyufu gujaguza buli kaseera.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Okuba n’akatono ng’otya <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 15:16">kusinga okuba n’ebingi naye ng’oli mu mitawaana.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Okulya emmere ng’eriko enva endiirwa awali okwagalana,</para>
  <para style="q2" vid="PRO 15:17">kisinga okuliirako ebyassava awali obukyayi.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Omuntu asunguwala amangu asaanuula oluyombo,</para>
  <para style="q2" vid="PRO 15:18">naye omugumiikiriza akakkanya embeera.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Ekkubo ly’omugayaavu lijjula amaggwa,</para>
  <para style="q2" vid="PRO 15:19">naye ekkubo ly’omutuukirivu golokofu.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Omwana omugezi asanyusa kitaawe,</para>
  <para style="q2" vid="PRO 15:20">naye omuntu omusirusiru anyooma nnyina.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Obusirusiru ssanyu eri oyo atalina magezi,</para>
  <para style="q2" vid="PRO 15:21">naye omuntu ategeera atambulira mu kkubo eggolokofu.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>Awatali kuluŋŋamizibwa entegeka zifa,</para>
  <para style="q2" vid="PRO 15:22">naye awali abawi b’amagezi abangi ziyitamu.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Okuddamu obulungi kisanyusa,</para>
  <para style="q2" vid="PRO 15:23">era kirungi ekigambo ekirungi okujjira mu kiseera ekituufu.<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Ekkubo ery’obulamu liyimusa omugezi,</para>
  <para style="q2" vid="PRO 15:24">ne limuziyiza okukka emagombe.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>
    <char style="nd">Mukama</char> azikiriza ennyumba y’ab’amalala,</para>
  <para style="q2" vid="PRO 15:25">kyokka akuuma ensalo za nnamwandu.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>Enkwe za muzizo eri <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 15:26">naye ebigambo ebisaanidde, bimusanyusa.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Oyo anoonya okugaggawalira mu bukyamu aleetera ennyumba ye emitawaana,</para>
  <para style="q2" vid="PRO 15:27">naye oyo akyawa enguzi aliba mulamu.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Omutima gw’omutuukirivu gufumiitiriza bye gunaayanukula,</para>
  <para style="q2" vid="PRO 15:28">naye akamwa k’omwonoonyi kafubutula ebitasaana.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>
    <char style="nd">Mukama</char> ali wala n’aboonoonyi,</para>
  <para style="q2" vid="PRO 15:29">naye awulira okusaba kw’abatuukirivu.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Amaaso agajjudde essanyu gasanyusa omutima,</para>
  <para style="q2" vid="PRO 15:30">n’amawulire amalungi galeetera amagumba obulamu.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Oyo assaayo omwoyo eri okunenyezebwa okuleeta obulamu,</para>
  <para style="q2" vid="PRO 15:31">alituula wamu n’abagezi.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Agayaalirira okubuulirirwa yeerumya yekka,</para>
  <para style="q2" vid="PRO 15:32">naye oyo assaayo omwoyo eri okunenyezebwa afuna okutegeera.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>Okutya <char style="nd">Mukama</char> kuyigiriza omuntu amagezi,</para>
  <para style="q2" vid="PRO 15:33">n’obwetoowaze kye kitiibwa ky’omuntu oyo.<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="s1">
    <char style="nd">Mukama</char> Agera Ekkubo ly’Omuntu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>Omuntu ateekateeka by’ayagala okukola mu mutima gwe,</para>
  <para style="q2" vid="PRO 16:1">Naye okuddamu kuva eri <char style="nd">Mukama</char>.<verse eid="PRO 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Amakubo g’omuntu gonna gaba matuufu mu maaso ge ye,</para>
  <para style="q2" vid="PRO 16:2">naye <char style="nd">Mukama</char> y’apima ebigendererwa.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>Emirimu gyo gyonna gikwasenga <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 16:3">naye anaatuukirizanga entegeka zo.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>
    <char style="nd">Mukama</char> buli kimu akikola ng’alina ekigendererwa,</para>
  <para style="q2" vid="PRO 16:4">n’abakozi b’ebibi y’abakolera olunaku lwe batuukibwako ebizibu.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>Buli muntu alina omutima ogw’amalala wa muzizo eri <char style="nd">Mukama</char>;</para>
  <para style="q2" vid="PRO 16:5">weewaawo talirema kubonerezebwa.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Olw’okwagala n’olw’obwesigwa, ekibi kisasulibwa,</para>
  <para style="q2" vid="PRO 16:6">n’okutya <char style="nd">Mukama</char> kuleetera omuntu okwewala okukola ebibi.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Amakubo g’omuntu bwe gaba gasanyusa <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 16:7">aleetera abalabe b’omuntu oyo okubeera naye mu mirembe.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Akatono akafune mu butuukirivu,</para>
  <para style="q2" vid="PRO 16:8">kasinga obugagga obungi obufune mu bukyamu.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>Omutima gw’omuntu guteekateeka ekkubo lye,</para>
  <para style="q2" vid="PRO 16:9">naye <char style="nd">Mukama</char> y’aluŋŋamya bw’anaatambula.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Kabaka ky’ayogera kiba ng’ekiva eri Katonda,</para>
  <para style="q2" vid="PRO 16:10">n’akamwa ke tekasaanye kwogera bitali bya bwenkanya.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Ebipimo ne minzaani ebituufu bya <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 16:11">ebipimo byonna ebikozesebwa y’abikola.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Kya muzizo bakabaka okukola ebibi,</para>
  <para style="q2" vid="PRO 16:12">kubanga entebe ye ey’obwakabaka enywezebwa butuukirivu.<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Akamwa akogera eby’amazima bakabaka ke basanyukira,</para>
  <para style="q2" vid="PRO 16:13">era baagala oyo ayogera amazima.<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Obusungu bwa kabaka buli ng’ababaka abaleese okufa,</para>
  <para style="q2" vid="PRO 16:14">omusajja ow’amagezi alibukkakkanya.<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Kabaka bw’asanyuka kireeta obulamu;</para>
  <para style="q2" vid="PRO 16:15">n’okuganza kwe, kuli nga ekire eky’enkuba<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="ft" closed="false">Ekire ky’enkuba mu biseera ebya ttoggo etegeeza kujimuka, era kabonero ka kukulaakulana na ssanyu</char></note> mu biseera ebya ttoggo.<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>Okufuna amagezi nga kusinga nnyo okufuna zaabu,</para>
  <para style="q2" vid="PRO 16:16">era n’okufuna okutegeera kikira ffeeza!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>Ekkubo ly’abagolokofu kwe kwewala ebibi,</para>
  <para style="q2" vid="PRO 16:17">n’oyo eyeekuuma mu kutambula kwe, awonya emmeeme ye.<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Amalala gakulembera okuzikirira,</para>
  <para style="q2" vid="PRO 16:18">n’omwoyo ogwegulumiza gukulembera ekigwo.<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Okubeera n’omwoyo ogwetoowaza era n’okubeera n’abaavu,</para>
  <para style="q2" vid="PRO 16:19">kisinga okugabana omunyago n’ab’amalala.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Oyo assaayo omwoyo ku kuyigirizibwa alikulaakulana,</para>
  <para style="q2" vid="PRO 16:20">era alina omukisa oyo eyeesiga <char style="nd">Mukama</char>.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>Abalina emitima egy’amagezi baliyitibwa bategeevu,</para>
  <para style="q2" vid="PRO 16:21">n’enjogera ennungi eyongera okuyamba okutegeera.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Amagezi nsulo ya bulamu eri oyo agalina,</para>
  <para style="q2" vid="PRO 16:22">naye obusirusiru buleetera abasirusiru okubonerezebwa.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>Omutima gw’omuntu ow’amagezi gumuwa enjogera ennungi,</para>
  <para style="q2" vid="PRO 16:23">era akamwa ke kayigiriza abalala.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>Ebigambo ebirungi biri ng’ebisenge by’omubisi gw’enjuki,</para>
  <para style="q2" vid="PRO 16:24">biwoomera emmeeme, ne biwonya n’amagumba.<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>Wabaawo ekkubo erirabika ng’ettuufu eri omuntu,</para>
  <para style="q2" vid="PRO 16:25">naye ku nkomerero limutuusa mu kufa.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>Okwagala okulya kuleetera omuntu okukola n’amaanyi,</para>
  <para style="q2" vid="PRO 16:26">kubanga enjala emukubiriza okweyongera okukola.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Omuntu omusirusiru ategeka okukola ebitali bya butuukirivu,</para>
  <para style="q2" vid="PRO 16:27">era n’ebigambo bye, biri ng’omuliro ogwokya ennyo.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Omuntu omubambaavu asiikuula entalo,</para>
  <para style="q2" vid="PRO 16:28">n’ow’olugambo ayawukanya ab’omukwano enfirabulago.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Omuntu omukyamu asendasenda muliraanwa we</para>
  <para style="q2" vid="PRO 16:29">n’amutwala mu kkubo eritali ttuufu.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Omuntu atemya ku liiso ateekateeka kwonoona,</para>
  <para style="q2" vid="PRO 16:30">n’oyo asongoza emimwa ategeka kukola bitali birungi.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Omutwe ogw’envi ngule ya kitiibwa,</para>
  <para style="q2" vid="PRO 16:31">gufunibwa abo abatambulira mu bulamu obutuukirivu.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Omuntu omugumiikiriza asinga omutabaazi,</para>
  <para style="q2" vid="PRO 16:32">n’oyo afuga obusungu bwe akira awamba ekibuga.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Akalulu kayinza okukubibwa,</para>
  <para style="q2" vid="PRO 16:33">naye okusalawo kwa byonna kuva eri <char style="nd">Mukama</char>.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Okulya akamere akaluma awali emirembe,</para>
  <para style="q2" vid="PRO 17:1">kisinga okuba mu nnyumba ejjudde ebyassava nga mulimu entalo.<verse eid="PRO 17:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Omuddu omugezi alifuga omwana wa bowo akwasa ensonyi,</para>
  <para style="q2" vid="PRO 17:2">era alifuna ebyobusika ng’omu ku baana b’awaka.<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Entamu erongoosa yakolebwa lwa ffeeza, n’ekikoomi ky’okulongoosa lwa zaabu,</para>
  <para style="q2" vid="PRO 17:3">naye <char style="nd">Mukama</char> agezesa emitima.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Omubi assaayo omwoyo eri eby’obulimba,</para>
  <para style="q2" vid="PRO 17:4">era n’omulimba awuliriza olulimi olukuusa.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Oyo akudaalira omwavu avvoola eyamutonda,</para>
  <para style="q2" vid="PRO 17:5">n’oyo asanyukira obuyinike bw’abalala talirema kubonerezebwa.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Abazzukulu ngule ya bajjajjaabwe,</para>
  <para style="q2" vid="PRO 17:6">era n’abaana beenyumiririza mu bakadde baabwe.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Enjogerannungi teba ya musirusiru,</para>
  <para style="q2" vid="PRO 17:7">ng’oweekitiibwa bw’atasaana kwogera bya bulimba.<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Enguzi eri ng’ejjinja ery’omufuusa mu maaso g’oyo agigaba,</para>
  <para style="q2" vid="PRO 17:8">alowooza nti buli gy’akyukira eneemuyamba.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Okwagala tekulondoola nsobi,</para>
  <para style="q2" vid="PRO 17:9">naye oyo atasonyiwa nsobi akyawaganya ab’omukwano enfirabulago.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Okunenya kuyamba nnyo omuntu ategeera,</para>
  <para style="q2" vid="PRO 17:10">okusinga okukuba omusirusiru embooko ekikumi.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Omukozi w’ebibi anoonya bujeemu bwereere,</para>
  <para style="q2" vid="PRO 17:11">era kyaliva asindikirwa omubaka omukambwe.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Okusisinkana eddubu enyagiddwako abaana baayo,</para>
  <para style="q2" vid="PRO 17:12">kisinga okusisinkana omusirusiru mu busirusiru bwe.<verse eid="PRO 17:12"/></para>
  <para style="s1">Ebbeeyi y’Amagezi</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Omuntu bw’asasula ekibi olw’obulungi,</para>
  <para style="q2" vid="PRO 17:13">ekibi tekiriva mu nnyumba ye.<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Okutandika oluyombo kuli ng’omuntu bw’asumulula omudumu gw’amazzi,</para>
  <para style="q2" vid="PRO 17:14">noolwekyo vvaawo ng’oluyombo terunnatandika.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>Eyejjeereza omukozi w’ebibi n’oyo avumirira omutuukirivu,</para>
  <para style="q2" vid="PRO 17:15">bombi ba muzizo eri <char style="nd">Mukama</char>.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Omusirusiru agasibwa ki okuba ne ssente ezisasulibwa amagezi,</para>
  <para style="q2" vid="PRO 17:16">ng’ate ye talina mutima gwegomba magezi?<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Omukwano ogw’amagezi guba gwa lubeerera,</para>
  <para style="q2" vid="PRO 17:17">era owooluganda yeesigibwa mu biro eby’ennaku.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Omuntu atalina magezi awa obweyamo</para>
  <para style="q2" vid="PRO 17:18">ne yeetema okusasula amabanja ga muliraanwa we.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Oyo ayagala ekibi anyumirwa ennyombo,</para>
  <para style="q2" vid="PRO 17:19">n’oyo akola omulyango omunene ogw’omu maaso gwa bbugwe ye nga guyitiridde obunene gulimuteganya nnyo.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Omuntu ow’omutima omubambaavu takulaakulana,</para>
  <para style="q2" vid="PRO 17:20">n’oyo ow’olulimi olulimba agwa mu katyabaga.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Omwana omusirusiru aleetera kitaawe obuyinike,</para>
  <para style="q2" vid="PRO 17:21">kitaawe w’omusirusiru taba na ssanyu.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Omutima ogw’essanyu ddagala ddungi,</para>
  <para style="q2" vid="PRO 17:22">naye omwoyo omunyiikaavu gukozza omubiri.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Omuntu omubi alya enguzi mu kyama,</para>
  <para style="q2" vid="PRO 17:23">alyoke aziyize amazima okweyoleka.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Omuntu omutegeevu, ebirowoozo abissa eri amagezi,</para>
  <para style="q2" vid="PRO 17:24">naye amaaso g’omusirusiru gasamaalirira ensi gy’ekoma.<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Omwana omusirusiru buyinike eri kitaawe,</para>
  <para style="q2" vid="PRO 17:25">era aleeta ennaku eri nnyina eyamuzaala.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Si kirungi okuweesa omutuukirivu engassi ey’obwereere</para>
  <para style="q2" vid="PRO 17:26">wadde okukuba ab’ekitiibwa embooko olw’obwesimbu bwabwe.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Omuntu omwegendereza mu bigambo bye abeera n’okutegeera,</para>
  <para style="q2" vid="PRO 17:27">n’oyo alina omwoyo omuteefu aba muntu wa magezi.<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>Omusirusiru bw’asirika alowoozebwa okuba n’amugezi,</para>
  <para style="q2" vid="PRO 17:28">era aba mutegeevu bw’afuga akamwa ke.<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="s1">Ebigambo by’Abagezi n’Abasirusiru</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Eyeggya ku banne aba yeerowoozako yekka,</para>
  <para style="q2" vid="PRO 18:1">era tawuliriza magezi gamuweebwa.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Omusirusiru tasanyukira kutegeera,</para>
  <para style="q2" vid="PRO 18:2">ky’asanyukira kyokka kwe kwogera by’alowooza.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Okukola ekibi bwe kujja n’okunyooma kujjirako,</para>
  <para style="q2" vid="PRO 18:3">era awali okuyisaamu omuntu amaaso wabaawo okunyoomoola.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Ebigambo by’omu kamwa k’omuntu mazzi ga buziba,</para>
  <para style="q2" vid="PRO 18:4">naye ensulo ey’amagezi mugga ogukulukuta.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Si kirungi kuttira mubi ku liiso,</para>
  <para style="q2" vid="PRO 18:5">oba okusaliriza omutuukirivu.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Akamwa k’omusirusiru kamuleetera entalo</para>
  <para style="q2" vid="PRO 18:6">era akamwa ke kamuleetera okukubwa emiggo.<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Akamwa k’omusirusiru ke kamuleetera okuzikirira,</para>
  <para style="q2" vid="PRO 18:7">era n’emimwa gye mutego eri emmeeme ye.<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Ebigambo by’omuntu ageya biri ng’emmere ewoomerera,</para>
  <para style="q2" vid="PRO 18:8">bigenda mu bitundu by’omubiri eby’ewala.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Omuntu omugayaavu mu mirimu gy’akola,</para>
  <para style="q2" vid="PRO 18:9">waluganda n’oyo azikiriza.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>Erinnya lya <char style="nd">Mukama</char> kigo ky’amaanyi,</para>
  <para style="q2" vid="PRO 18:10">omutuukirivu addukira omwo n’afuna emirembe.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Obugagga bw’omugagga, kye kibuga kye ekiriko bbugwe ow’amaanyi,</para>
  <para style="q2" vid="PRO 18:11">era mu kulaba kwe, kigo kye ekigumu ekitarinnyika.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>Omuntu nga tannagwa, omutima gwe gwegulumiza, naye okwetoowaza kumuweesa ekitiibwa.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Oyo addamu amangu mu nsonga gy’ateetegerezza,</para>
  <para style="q2" vid="PRO 18:13">buba busirusiru bwe era buswavu.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Omwoyo gw’omuntu gumuwanirira mu bulwadde,</para>
  <para style="q2" vid="PRO 18:14">naye emmeeme eyennyise ani ayinza okugigumiikiriza?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>Omutima gw’omwegendereza guyiga okumanya,</para>
  <para style="q2" vid="PRO 18:15">amatu g’omuntu omugezi gawuliriza.<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>Ekirabo ky’omuntu kimuseguliza,</para>
  <para style="q2" vid="PRO 18:16">era kimutuusa ne mu maaso g’abeekitiibwa.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Asooka okweyogerako y’afaanana ng’omutuufu,</para>
  <para style="q2" vid="PRO 18:17">okutuusa omulala lw’amubuuza ebibuuzo.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>Okukuba akalulu kimalawo empaka,</para>
  <para style="q2" vid="PRO 18:18">era kisalawo eggoye wakati w’abawakana ab’amaanyi.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Kyangu okuwamba ekibuga ekiriko bbugwe ow’amaanyi, okusinga okukomyawo owooluganda anyiize,</para>
  <para style="q2" vid="PRO 18:19">era ennyombo ziba ng’empagi z’ekigo.<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Omuntu anakkutanga ebigambo ebiva mu kamwa ke;</para>
  <para style="q2" vid="PRO 18:20">ebibala ebijjula akamwa ke bye binamukkusanga.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>Olulimi lulina obuyinza okuwa obulamu oba okutta,</para>
  <para style="q2" vid="PRO 18:21">era n’abo abalwagala balirya ebibala byalwo.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Azuula omukazi omulungi ow’okuwasa aba azudde ekirungi,</para>
  <para style="q2" vid="PRO 18:22">era aganja eri <char style="nd">Mukama</char>.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>Omwavu yeegayirira,</para>
  <para style="q2" vid="PRO 18:23">naye omugagga addamu na bbogo.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Akwana emikwano emingi yeereetera okuzikirira,</para>
  <para style="q2" vid="PRO 18:24">naye wabaawo ow’omukwano akwagala ennyo okusinga owooluganda.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>Omuntu omwavu atambulira mu butuukirivu,</para>
  <para style="q2" vid="PRO 19:1">asinga akamwa ak’omusirusiru akaweebuula.<verse eid="PRO 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Si kirungi okuba omujjumbize naye nga tolina kumanya,</para>
  <para style="q2" vid="PRO 19:2">n’okwanguyiriza okukola ekintu kuleetera omuntu okukwata ekkubo ekyamu.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Obusirusiru bw’omuntu bwe bwonoona obulamu bwe,</para>
  <para style="q2" vid="PRO 19:3">kyokka omutima gwe ne gunenya <char style="nd">Mukama</char>.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>Obugagga buleeta emikwano mingi,</para>
  <para style="q2" vid="PRO 19:4">naye emikwano gy’omwavu gimuddukako.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Omujulizi ow’obulimba talirema kubonerezebwa,</para>
  <para style="q2" vid="PRO 19:5">era oyo ayogera eby’obulimba taliba na buddukiro.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>Bangi banoonya okuganja mu maaso g’omufuzi,</para>
  <para style="q2" vid="PRO 19:6">era buli muntu aba mukwano gw’oyo agaba ebirabo.<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Baganda b’omwavu bonna bamwewala,</para>
  <para style="q2" vid="PRO 19:7">mikwano gye tebaasingewo nnyo okumwewala?</para>
  <para style="b" vid="PRO 19:7"/>
  <para style="q1" vid="PRO 19:7">Wadde abagoberera ng’abeegayirira,</para>
  <para style="q2" vid="PRO 19:7">naye tabalaba.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Oyo afuna amagezi ayagala emmeeme ye,</para>
  <para style="q2" vid="PRO 19:8">n’oyo asanyukira okutegeera, akulaakulana.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Omujulizi ow’obulimba talirema kubonerezebwa,</para>
  <para style="q2" vid="PRO 19:9">n’oyo ayogera eby’obulimba alizikirira.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Omusirusiru tasaana kubeera mu bulamu bwa kwejalabya,</para>
  <para style="q2" vid="PRO 19:10">kale kiwulikika kitya ng’omuddu afuga abalangira?<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Omuntu omutegeevu alwawo okusunguwala,</para>
  <para style="q2" vid="PRO 19:11">era kiba kya kitiibwa obutafa ku bye bamusobezza.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>Obusungu bwa kabaka buli ng’okuwuluguma kw’empologoma,</para>
  <para style="q2" vid="PRO 19:12">naye ekisa kye kiri ng’omusulo ku ssubi.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Omwana omusirusiru aleetera kitaawe okuzikirira,</para>
  <para style="q2" vid="PRO 19:13">n’omukazi omuyombi ali ng’enkuba etonnya olutata.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Ennyumba n’obugagga bisikirwa okuva ku bazadde,</para>
  <para style="q2" vid="PRO 19:14">naye omukazi omutegeevu ava eri <char style="nd">Mukama</char>.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>Obugayaavu buleeta otulo tungi,</para>
  <para style="q2" vid="PRO 19:15">n’omuntu atakola mirimu alirumwa enjala.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Oyo akwata ebiragiro akuuma obulamu bwe,</para>
  <para style="q2" vid="PRO 19:16">naye oyo eyeeyisa mu ngeri embi alifa.<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Oyo akwatirwa omwavu ekisa awola <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 19:17">era <char style="nd">Mukama</char> alimusasula olw’ekikolwa kye ekyo.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>Kangavvulanga omwana wo kubanga mu ekyo mulimu essuubi,</para>
  <para style="q2" vid="PRO 19:18">oleme kumuwaayo mu kuzikirira.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Omuntu omukambwe ennyo alisasula ebiriva mu bukambwe bwe,</para>
  <para style="q2" vid="PRO 19:19">kubanga ne bw’omununula ogusooka era oteekwa okukiddiŋŋaana.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Ssangayo omwoyo ku magezi agakuweebwa ne ku kuyigirizibwa,</para>
  <para style="q2" vid="PRO 19:20">oluvannyuma lwa byonna oliba n’amagezi.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Enteekateeka z’omuntu ziba nnyingi mu mutima gwe;</para>
  <para style="q2" vid="PRO 19:21">byo ebigendererwa bya <char style="nd">Mukama</char> bituukirira.<verse eid="PRO 19:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Ekintu omuntu kye yeegomba kwe kwagala okutaggwaawo,</para>
  <para style="q2" vid="PRO 19:22">okuba omwavu kisinga okuba omulimba.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>Okutya <char style="nd">Mukama</char> kutuusa mu bulamu;</para>
  <para style="q2" vid="PRO 19:23">olwo omuntu n’awummula nga mumativu nga tatuukiddwako kabi.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Omugayaavu annyika omukono gwe mu kibya,</para>
  <para style="q2" vid="PRO 19:24">n’atagukomyawo nate ku mumwa gwe.<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Kangavvula omunyoomi, abatamanyi bayigire ku ye,</para>
  <para style="q2" vid="PRO 19:25">buulirira ategeera, ajja kweyongera okutegeera.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Omwana abba ebya kitaawe n’agobaganya ne nnyina,</para>
  <para style="q2" vid="PRO 19:26">aleeta obuswavu n’obuyinike.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Mwana wange konoolekayo okuyigirizibwa,</para>
  <para style="q2" vid="PRO 19:27">onoowaba okuva ku bigambo by’okumanya.<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Omujulizi omulimba atyoboola ensala ey’amazima,</para>
  <para style="q2" vid="PRO 19:28">n’akamwa k’ababi, kavaabira ebitali bya butuukirivu.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Ebibonerezo bitekebwawo kukangavvula banyoomi,</para>
  <para style="q2" vid="PRO 19:29">n’embooko zaakolebwa lwa migongo gy’abasirusiru.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Omwenge mukudaazi, ekitamiiza muleekaanyi,</para>
  <para style="q2" vid="PRO 20:1">era buli alaga mu kkubo ekyamu olw’ebyo talina magezi.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Obusungu bwa kabaka buli ng’okuwuluguma kw’empologoma,</para>
  <para style="q2" vid="PRO 20:2">n’oyo amusunguwaza yeefiiriza bulamu bwe.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>Kya kitiibwa omuntu okwewala entalo,</para>
  <para style="q2" vid="PRO 20:3">naye buli musirusiru ayagala okuyomba.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Omugayaavu talima mu budde butuufu,</para>
  <para style="q2" vid="PRO 20:4">kyanaavanga anoonya eby’amakungula nga talina kantu.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Ebigendererwa ebiba mu mutima gw’omuntu biba ng’amazzi ag’ebuziba,</para>
  <para style="q2" vid="PRO 20:5">naye omuntu alina okutegeera alibiggyayo.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Abantu bangi bagamba nti balina okwagala okutaggwaawo,</para>
  <para style="q2" vid="PRO 20:6">naye ani ayinza okuzuula omuntu omwesigwa?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Omuntu omutuukirivu, atambulira mu bulamu obutaliiko kyakunenyezebwa;</para>
  <para style="q2" vid="PRO 20:7">ba mukisa abaana be abalimuddira mu bigere.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>Kabaka bw’atuula ku ntebe ye ey’obwakabaka ng’asala emisango,</para>
  <para style="q2" vid="PRO 20:8">amaaso ge gasunsulamu ne gaggyamu ebibi byonna.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>Ani ayinza okugamba nti, “Ntukuzza omutima gwange,</para>
  <para style="q2" vid="PRO 20:9">ndi mulongoofu era sirina kibi?”<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>Ebipima obuzito ebitatuuka n’ebigera ebikyamu,</para>
  <para style="q2" vid="PRO 20:10">byombi bya muzizo eri <char style="nd">Mukama</char>.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>Omuvubuka naye amanyibwa olw’ebikolwa bye,</para>
  <para style="q2" vid="PRO 20:11">obanga birongoofu era nga birungi.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>Okutu okuwulira n’eriiso eriraba</para>
  <para style="q2" vid="PRO 20:12">byombi <char style="nd">Mukama</char> ye y’abikola.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>Toyagalanga kwebaka oleme kwavuwala,</para>
  <para style="q2" vid="PRO 20:13">tunula, obeerenga n’ebyokulya bingi.<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>“Si kirungi, si kirungi,” bw’ayogera agula;</para>
  <para style="q2" vid="PRO 20:14">naye bw’agenda n’alyoka yeenyumiririza mu ky’aguze.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Zaabu n’amayinja ag’omuwendo weebiri,</para>
  <para style="q2" vid="PRO 20:15">naye emimwa egyogera eby’amagezi kye ky’omuwendo ekisingako.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Omuntu bw’aleeta ekyambalo kye ne yeeyimiririra gw’atamanyi,</para>
  <para style="q2" vid="PRO 20:16">kitwalire ddala, na ddala bw’abanga yeeyimiririra omukazi omubambaavu.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>Emmere enfune mu bukyamu ewooma mu kulya,</para>
  <para style="q2" vid="PRO 20:17">naye emufuukira amayinja mu kamwa.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Kola entegeka nga weebuuza ku magezi,</para>
  <para style="q2" vid="PRO 20:18">bw’oba onoolangirira olutalo sooka weebuuze.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Oyo agenda ng’asaasaanya olugambo abotola ebyama,</para>
  <para style="q2" vid="PRO 20:19">noolwekyo weewale omuntu ayogerayogera ennyo ebitaliimu.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Omuntu akolimira kitaawe oba nnyina,</para>
  <para style="q2" vid="PRO 20:20">ettabaaza ye erizikizibwa n’asigala mu kizikiza ekikutte ennyo.<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Eby’obusika ebifune ng’ekiseera kyabyo tekinnatuuka,</para>
  <para style="q2" vid="PRO 20:21">ku nkomerero tebiba na mukisa.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>Toyogera nti, “Nzija kukusasula olw’ekibi kino!”</para>
  <para style="q2" vid="PRO 20:22">Lindirira <char style="nd">Mukama</char> alikuyamba.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>Ebipima ebikyamu bya muzizo eri <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 20:23">ne minzaani ez’obulimba tezisanyusa.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>Amakubo g’omuntu gategekebwa <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 20:24">omuntu ayinza atya okutegeera ekkubo lya <char style="nd">Mukama</char>?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>Kyambika eri omuntu okwanguyiriza okweyama eri <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 20:25">naye oluvannyuma n’afumiitiriza ku bye yeeyamye.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Kabaka omugezi asengejja n’aggyamu abakozi b’ebibi,</para>
  <para style="q2" vid="PRO 20:26">n’ababonereza awatali kusaasira.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>Ettabaaza ya <char style="nd">Mukama</char> ekebera omwoyo gw’omuntu,</para>
  <para style="q2" vid="PRO 20:27">n’enoonya mu bitundu eby’omunda ennyo.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Okwagala n’obwesigwa bikuuma kabaka mu butebenkevu,</para>
  <para style="q2" vid="PRO 20:28">era obufuzi bwe bunywezebwa na kwagala.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Amaanyi kye kitiibwa ky’abavubuka,</para>
  <para style="q2" vid="PRO 20:29">envi kye kitiibwa ky’abakadde.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>Emiggo n’ebiwundu biggyawo ebibi,</para>
  <para style="q2" vid="PRO 20:30">n’embooko zitereeza ebifo eby’omunda ennyo.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Omutima gwa kabaka guli ng’amazzi agakulukutira mu mukono gwa <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 21:1">era agukyusiza gy’ayagala yonna.<verse eid="PRO 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Buli kkubo lya muntu liba ng’ettuufu mu maaso ge,</para>
  <para style="q2" vid="PRO 21:2">naye <char style="nd">Mukama</char> apima omutima.<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>Okukola ebituufu n’eby’amazima</para>
  <para style="q2" vid="PRO 21:3">kisanyusa <char style="nd">Mukama</char> okusinga ssaddaaka.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Amaaso ageegulumiza, n’omutima ogw’amalala,</para>
  <para style="q2" vid="PRO 21:4">ye ttabaaza y’ababi, era ebyo kwonoona.<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Enteekateeka z’omunyiikivu zivaamu magoba meereere,</para>
  <para style="q2" vid="PRO 21:5">naye okwanguyiriza okutalina nteekateeka kuvaamu bwavu.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Okufuna obugagga n’olulimi olulimba,</para>
  <para style="q2" vid="PRO 21:6">mpewo buwewo etwalibwa eruuyi n’eruuyi era mutego gwa kufa.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Obukambwe bw’ababi bulibamalawo,</para>
  <para style="q2" vid="PRO 21:7">kubanga bagaana okukola eby’ensonga.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Ekkubo ly’abazza emisango liba kyamu,</para>
  <para style="q2" vid="PRO 21:8">naye ery’abataliiko musango liba golokofu.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Okusula ku kasolya k’ennyumba,</para>
  <para style="q2" vid="PRO 21:9">kisinga okubeera mu nnyumba n’omukazi omuyombi.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Emmeeme y’omubi yeegomba okukola ebibi;</para>
  <para style="q2" vid="PRO 21:10">talaga muliraanwa we kisa n’akatono.<verse eid="PRO 21:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Omukudaazi bw’abonerezebwa, atalina magezi agafuna;</para>
  <para style="q2" vid="PRO 21:11">n’ow’amagezi bw’ayigirizibwa afuna okutegeera.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Katonda alaba ebifa mu nnyumba y’omubi,</para>
  <para style="q2" vid="PRO 21:12">era abakozi b’ebibi abazikkiririza ddala.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Oyo aziba amatu ge eri okulaajana kw’omwavu,</para>
  <para style="q2" vid="PRO 21:13">naye alikoowoola nga talina amwanukula.<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Ekirabo ekigabire mu kyama kikakkanya obusungu obungi,</para>
  <para style="q2" vid="PRO 21:14">n’enguzi ebikiddwa mu munagiro eggyawo ekiruyi ekingi.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Ensonga bwe zisalibwa mu bwenkanya, lye ssanyu eri abatuukirivu,</para>
  <para style="q2" vid="PRO 21:15">naye kiba kyekango eri abakozi b’ebibi.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Omuntu awaba okuva mu kkubo ly’okutegeera,</para>
  <para style="q2" vid="PRO 21:16">agukira mu bafu.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Aganza eby’amasanyu anaabanga mwavu, n’oyo</para>
  <para style="q2" vid="PRO 21:17">ayagala omwenge n’amafuta taligaggawala.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Abakozi b’ebibi batuukibwako emitawaana egyandigudde ku balungi,</para>
  <para style="q2" vid="PRO 21:18">n’ekyandituuse ku b’amazima kituuka ku batali beesigwa.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>Okubeera mu ddungu,</para>
  <para style="q2" vid="PRO 21:19">kisinga okubeera n’omukazi omuyombi anyiiganyiiga.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Mu nnyumba y’omutuukirivu mubaamu eby’obugagga eby’omuwendo,</para>
  <para style="q2" vid="PRO 21:20">naye omusirusiru ebibye byonna abyonoona.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Agoberera obutuukirivu n’ekisa,</para>
  <para style="q2" vid="PRO 21:21">alibeera n’obulamu obukulaakulana n’ekitiibwa.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Omuntu ow’amagezi alumba ekibuga eky’abazira nnamige,</para>
  <para style="q2" vid="PRO 21:22">era n’asesebbula enfo yaabwe gye beesiga.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Afuga akamwa ke n’olulimi lwe,</para>
  <para style="q2" vid="PRO 21:23">yeewoonya emitawaana.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>“Mukudaazi,” lye linnya ly’ab’amalala abeeraga,</para>
  <para style="q2" vid="PRO 21:24">abeetwalira mu kwemanya okw’ekitalo mwe batambulira.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Okwetaaga kw’omugayaavu lwe luliba olumbe lwe,</para>
  <para style="q2" vid="PRO 21:25">kubanga emikono gye tegyagala kukola.<verse eid="PRO 21:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Olunaku lwonna aba yeegomba kweyongezaako,</para>
  <para style="q2" vid="PRO 21:26">naye omutuukirivu agaba awatali kwebalira.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Ssaddaaka y’omubi ya muzizo,</para>
  <para style="q2" vid="PRO 21:27">na ddala bw’agireeta ng’alina ekigendererwa ekitali kirungi.<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Omujulizi ow’obulimba alizikirira,</para>
  <para style="q2" vid="PRO 21:28">naye ekigambo ky’oyo ayogera eby’amazima kiribeerera emirembe gyonna.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Omuntu omubi yeekazaakaza,</para>
  <para style="q2" vid="PRO 21:29">naye omuntu ow’amazima yeegendereza amakubo ge.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>Tewali magezi, newaakubadde okutegeera, wadde ebiteeso</para>
  <para style="q2" vid="PRO 21:30">ebiyinza okulemesa <char style="nd">Mukama</char>.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Embalaasi etegekerwa olunaku olw’olutalo,</para>
  <para style="q2" vid="PRO 21:31">naye obuwanguzi buva eri <char style="nd">Mukama</char>.<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="s1">Omugaso gw’Erinnya Eddungi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Erinnya eddungi lyagalibwa okusinga eby’obugagga ebingi,</para>
  <para style="q2" vid="PRO 22:1">n’okuganja kusinga ffeeza oba zaabu.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Abagagga n’abaavu balina kimu ekibagatta,</para>
  <para style="q2" vid="PRO 22:2">
    <char style="nd">Mukama</char> ye Mutonzi waabwe bonna.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Omuntu omutegeevu bw’alaba akabi yeekweka,</para>
  <para style="q2" vid="PRO 22:3">naye abatalina magezi bagenda bugenzi mu maaso ne balumizibwa.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Obugagga n’ekitiibwa n’obulamu</para>
  <para style="q2" vid="PRO 22:4">y’empeera ey’okwetoowazanga n’okutyanga <char style="nd">Mukama</char>.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>Amaggwa n’emitego biri mu kkubo ly’omubambaavu;</para>
  <para style="q2" vid="PRO 22:5">naye oyo akuuma emmeeme ye anaabyewalanga.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Manyiiriza omwana mu kkubo erimugwanira okutambulirangamu,</para>
  <para style="q2" vid="PRO 22:6">ne bw’alikula talirivaamu.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>Omugagga afuga abaavu,</para>
  <para style="q2" vid="PRO 22:7">naye eyeewola aba muddu w’oyo amuwola.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Asiga obutali butuukirivu akungula mitawaana,</para>
  <para style="q2" vid="PRO 22:8">n’oluga olw’obusungu bwe lulizikirizibwa.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Omuntu omugabi anaabanga n’omukisa,</para>
  <para style="q2" vid="PRO 22:9">kubanga emmere ye agirya n’abaavu.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>Goba omunyoomi, entalo zinaagenda,</para>
  <para style="q2" vid="PRO 22:10">ennyombo n’okuvumagana binaakoma.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Omuntu eyeegomba omutima omulongoofu</para>
  <para style="q2" vid="PRO 22:11">era ayogera n’eggonjebwa, talirema kuganja ewa kabaka.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>Amaaso ga <char style="nd">Mukama</char> galabirira amazima,</para>
  <para style="q2" vid="PRO 22:12">era adibya entegeka z’abatali beesigwa.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>Omugayaavu ayogera nti, “Ebweru eriyo empologoma,”</para>
  <para style="q2" vid="PRO 22:13">oba nti, “Nnyinza okutemulirwa mu kkubo.”<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Malaaya mutego gwa kabi,</para>
  <para style="q2" vid="PRO 22:14">akolimiddwa <char style="nd">Mukama</char> mw’afiira.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Obusirusiru busibiddwa ku mutima gw’omwana omuto,</para>
  <para style="q2" vid="PRO 22:15">naye omuggo ogukangavvula gulimuwonyeza ddala.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Omuntu atulugunya abaavu ne yeeyongera okugaggawala,</para>
  <para style="q2" vid="PRO 22:16">n’oyo agabira omugagga awa abagagga enguzi, enkomerero ya bombi bwavu.<verse eid="PRO 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>Ossangayo omwoyo okuwuliriza ebigambo by’omugezi,</para>
  <para style="q2" vid="PRO 22:17">n’omutima gwo eri ebyo bye njigiriza.<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>Kibeera kya ssanyu bw’obikwata ku mutima gwo,</para>
  <para style="q2" vid="PRO 22:18">n’oba mwetegefu okubiddamu byonna.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Mbikumanyisa leero ggwe,</para>
  <para style="q2" vid="PRO 22:19">obwesige bwo bubeerenga mu <char style="nd">Mukama</char>.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>Kale sikuwandiikidde ebintu amakumi asatu ebikuwabula</para>
  <para style="q2" vid="PRO 22:20">era ebikuwa okumanya?<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>Sikulaze ekirungi n’ekituufu,</para>
  <para style="q2" vid="PRO 22:21">olyoke obe n’eky’okuddamu eri oyo eyakutuma?<verse eid="PRO 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Tonyaganga mwavu, kubanga mwavu,</para>
  <para style="q2" vid="PRO 22:22">oba okutulugunyanga aleeteddwa mu mbuga.<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>Kubanga <char style="nd">Mukama</char> alibawolereza,</para>
  <para style="q2" vid="PRO 22:23">n’abo ababanyaga alibanyaga.<verse eid="PRO 22:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Tokwananga muntu wa busungu,</para>
  <para style="q2" vid="PRO 22:24">oba okuyitanga n’omuntu anyiiganyiiga amangu,<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>oleme okuyiga amakubo ge</para>
  <para style="q2" vid="PRO 22:25">ne weesuula mu mitawaana.<verse eid="PRO 22:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Teweegattanga ku abo abeeyama,</para>
  <para style="q2" vid="PRO 22:26">newaakubadde ku abo abeeyimirira ab’amabanja.<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>Bw’oliba nga tolina kya kusasula</para>
  <para style="q2" vid="PRO 22:27">ekitanda kyo kyennyini kye kirikuggyibwako.<verse eid="PRO 22:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>Tojjululanga nsalo</para>
  <para style="q2" vid="PRO 22:28">bajjajjaabo gye bassaawo edda.<verse eid="PRO 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Omanyi omuntu omunyiikivu era omukugu mu mulimu gwe?</para>
  <para style="q2" vid="PRO 22:29">Aliweereza bakabaka; taliweereza bantu batamanyiddwa.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Bw’otuulanga okulya n’omufuzi,</para>
  <para style="q2" vid="PRO 23:1">weetegerezanga ebiri mu maaso go;<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>era weegendereze</para>
  <para style="q2" vid="PRO 23:2">bw’obanga omanyi ng’olulunkanira ebyokulya.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Tolulunkanira mmere ye ennungi,</para>
  <para style="q2" vid="PRO 23:3">kubanga erimbalimba.<verse eid="PRO 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Teweemalangako mirembe ng’oyaayaanira obugagga;</para>
  <para style="q2" vid="PRO 23:4">weefuge obeere mukkakkamu.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Eby’obugagga obikubako eriiso limu nga by’agenze dda,</para>
  <para style="q2" vid="PRO 23:5">kubanga ddala bimera ebiwaawaatiro</para>
  <para style="q2" vid="PRO 23:5">ne bibuuka mu bbanga ng’empungu.<verse eid="PRO 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Tolyanga mmere ya muntu mukodo,</para>
  <para style="q2" vid="PRO 23:6">wadde okwegomba ebirungi by’alya.<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>Kubanga ye muntu</para>
  <para style="q2" vid="PRO 23:7">abalirira ensimbi z’asaasaanyizza,</para>
  <para style="q2" vid="PRO 23:7">n’akugamba nti, “Weeriire, weenywere,”</para>
  <para style="q2" vid="PRO 23:7">naye ng’omutima gwe tegukusanyukira.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Akatono k’onooba olidde onookasesema,</para>
  <para style="q2" vid="PRO 23:8">ebigambo byo ebirungi eby’okwebaza bibe bya bwereere.<verse eid="PRO 23:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>Totegana kubuulirira musirusiru,</para>
  <para style="q2" vid="PRO 23:9">kubanga ajja kunyooma ebigambo byo eby’amagezi.<verse eid="PRO 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Tojjululanga nsalo ey’edda,</para>
  <para style="q2" vid="PRO 23:10">so toyingiriranga nnimiro za bamulekwa,<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>kubanga abalwanirira w’amaanyi,</para>
  <para style="q2" vid="PRO 23:11">alikuggulako omusango.<verse eid="PRO 23:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Ossangayo omwoyo eri okuyigirizibwa,</para>
  <para style="q2" vid="PRO 23:12">n’amatu go eri ebigambo by’okutegeera.<verse eid="PRO 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>Tolekangayo kukangavvula mwana,</para>
  <para style="q2" vid="PRO 23:13">bw’omubonereza n’akaggo tekimutta.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Mubonerezenga n’akaggo,</para>
  <para style="q2" vid="PRO 23:14">kiwonye emmeeme ye okufa.<verse eid="PRO 23:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Mwana wange, bw’oba n’omutima ogw’amagezi,</para>
  <para style="q2" vid="PRO 23:15">kinsanyusa.<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>Nnaajjaguzanga okuva ku ntobo y’omutima gwange,</para>
  <para style="q2" vid="PRO 23:16">bw’onooyogeranga ebituufu.<verse eid="PRO 23:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>Omutima gwo gulemenga okukwatirwa aboonoonyi obuggya,</para>
  <para style="q2" vid="PRO 23:17">kyokka nyiikira okutya <char style="nd">Mukama</char> ebbanga lyonna.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Mazima ddala onoobanga n’essuubi mu biseera eby’omu maaso,</para>
  <para style="q2" vid="PRO 23:18">n’essuubi lyo eryo teririggwaawo.<verse eid="PRO 23:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Mwana wange wulirizanga, obeerenga n’amagezi,</para>
  <para style="q2" vid="PRO 23:19">okumenga omutima gwo mu kkubo ettuufu.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Teweegattanga ku abo abeekamirira omwenge,</para>
  <para style="q2" vid="PRO 23:20">n’abalulunkanira ennyama:<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>Kubanga omutamiivu n’omuluvu baavuwala,</para>
  <para style="q2" vid="PRO 23:21">n’okubongoota olutata kubambaza enziina.<verse eid="PRO 23:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>Wulirizanga kitaawo eyakuzaala,</para>
  <para style="q2" vid="PRO 23:22">so togayanga nnyoko ng’akaddiye.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>Gula amazima so togatunda,</para>
  <para style="q2" vid="PRO 23:23">ffuna amagezi, n’okuyigirizibwa n’okutegeera.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Kitaawe w’omutuukirivu alina essanyu lingi,</para>
  <para style="q2" vid="PRO 23:24">n’oyo azaala omwana ow’amagezi amwenyumiririzaamu.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Leka kitaawo ne nnyoko basanyuke,</para>
  <para style="q2" vid="PRO 23:25">omukazi eyakuzaala ajaguzenga.<verse eid="PRO 23:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Mwana wange mpa omutima gwo,</para>
  <para style="q2" vid="PRO 23:26">n’amaaso go geekalirize amakubo gange,<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>kubanga omukazi omwenzi lukonko luwanvu,</para>
  <para style="q2" vid="PRO 23:27">n’omukazi omubambaavu luzzi lufunda.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Ateega ng’omutemu,</para>
  <para style="q2" vid="PRO 23:28">n’ayongera ku muwendo gw’abasajja abatali beesigwa eri bakazi baabwe.<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>Ani alina obuyinike? Ani alina ennaku?</para>
  <para style="q2" vid="PRO 23:29">Ani alina ennyombo? Ani alina okwemulugunya?</para>
  <para style="q2" vid="PRO 23:29">Ani alina ebiwundu eby’obwereere? Ani amyuse amaaso?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Abo abatava ku mwenge,</para>
  <para style="q2" vid="PRO 23:30">nga bagenda baloza ku mwenge omutabule.<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Totunuulira wayini ng’amyuse,</para>
  <para style="q2" vid="PRO 23:31">bw’atemaganira mu ggiraasi</para>
  <para style="q2" vid="PRO 23:31">ng’akka empolampola;<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>ku nkomerero aluma ng’omusota,</para>
  <para style="q2" vid="PRO 23:32">wa busagwa ng’essalambwa.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Amaaso go galiraba ebyewuunyo,</para>
  <para style="q2" vid="PRO 23:33">n’omutwe gwo ne gulowooza ebitategeerekeka.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Oliba ng’omuntu eyeebase wakati mu nnyanja,</para>
  <para style="q2" vid="PRO 23:34">obanga oyo alengejjera waggulu ku mulongooti.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>Olyogera nti, “Bankubye, naye sirumiddwa.</para>
  <para style="q2" vid="PRO 23:35">Bankubye naye sirina kye mpuliddemu.</para>
  <para style="q1" vid="PRO 23:35">Nnaazuukuka ddi,</para>
  <para style="q2" vid="PRO 23:35">neeyongere okunywa?”<verse eid="PRO 23:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Teweegombanga bakozi ba bibi</para>
  <para style="q2" vid="PRO 24:1">era tobeesemberezanga.<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>Kubanga emitima gyabwe giteesa kukola bya butemu,</para>
  <para style="q2" vid="PRO 24:2">era akamwa kaabwe koogera ku kukola bya ffujjo.<verse eid="PRO 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>Amagezi ge gazimba ennyumba,</para>
  <para style="q2" vid="PRO 24:3">n’okutegeera kwe kugiggumiza.<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>Olw’amagezi ebisenge by’ayo bijjula ebintu ebirungi,</para>
  <para style="q2" vid="PRO 24:4">eby’obugagga ebitalabikalabika eby’omuwendo omungi.<verse eid="PRO 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Omuntu ow’amagezi aba n’obuyinza,</para>
  <para style="q2" vid="PRO 24:5">n’omuntu alina okumanya yeeyongera amaanyi.<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>Kubanga okulwana olutalo weetaaga okuluŋŋamizibwa,</para>
  <para style="q2" vid="PRO 24:6">n’okuluwangula, weetaaga abawi b’amagezi bangi.<verse eid="PRO 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Amagezi gasukkirira nnyo omusirusiru,</para>
  <para style="q2" vid="PRO 24:7">talina ky’asobola kwogera mu lukuŋŋaana olw’oku wankaaki.<verse eid="PRO 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Oyo asala enkwe ez’okukola ebibi,</para>
  <para style="q2" vid="PRO 24:8">aliyitibwa mukujjukujju.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Entegeka ez’obusirusiru muvaamu kwonoona,</para>
  <para style="q2" vid="PRO 24:9">abantu beetamwa omukudaazi.<verse eid="PRO 24:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Bw’oyongobera mu kiseera eky’ebizibu,</para>
  <para style="q2" vid="PRO 24:10">olwo ng’olina amaanyi matono!<verse eid="PRO 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>Odduukiriranga n’owonya abo abatwalibwa okuttibwa,</para>
  <para style="q2" vid="PRO 24:11">n’abo abali ku njegoyego z’okuttibwa, obawonye okuttirwa obwemage.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Bw’ogambanga nti, “Laba kino twali tetukimanyi,”</para>
  <para style="q2" vid="PRO 24:12">oyo akebera emitima aba talaba?</para>
  <para style="q1" vid="PRO 24:12">Oyo akuuma obulamu bwo takimanyi?</para>
  <para style="q2" vid="PRO 24:12">Talisasula buli muntu ng’omulimu gwe bwe guli?<verse eid="PRO 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Mwana wange olyanga omubisi gw’enjuki kubanga mulungi,</para>
  <para style="q2" vid="PRO 24:13">omubisi oguva mu bisenge byagwo guwoomerera.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Era manya nti amagezi gawoomera emmeeme yo,</para>
  <para style="q2" vid="PRO 24:14">bw’onoogafuna onoobeera n’essuubi mu bulamu obw’omu maaso,</para>
  <para style="q2" vid="PRO 24:14">n’essuubi lyo teririkoma.<verse eid="PRO 24:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>Toteeganga, ng’omunyazi bw’akola ku nnyumba y’omutuukirivu,</para>
  <para style="q2" vid="PRO 24:15">tonyaganga maka ge.<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>Omuntu omutuukirivu ne bw’agwa emirundi omusanvu, addamu n’ayimuka,</para>
  <para style="q2" vid="PRO 24:16">naye abakozi b’ebibi basuulibwa mu mitawaana.<verse eid="PRO 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>Tosanyukanga ng’omulabe wo agudde,</para>
  <para style="q2" vid="PRO 24:17">bwe yeesittalanga omutima gwo gulemenga okujaguza.<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>Si kulwa nga <char style="nd">Mukama</char> akiraba ne kitamusanyusa,</para>
  <para style="q2" vid="PRO 24:18">n’amusunguwalira.<verse eid="PRO 24:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>Teweeraliikiriranga olw’abo abakola ebibi,</para>
  <para style="q2" vid="PRO 24:19">so abakozi b’ebibi tobakwatirwanga buggya.<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>Kubanga omuntu omubi talina ssuubi mu maaso,</para>
  <para style="q2" vid="PRO 24:20">ettabaaza y’abakozi b’ebibi erizikizibwa.<verse eid="PRO 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Mwana wange otyanga <char style="nd">Mukama</char>, ne kabaka,</para>
  <para style="q2" vid="PRO 24:21">era teweetabanga na bajeemu.<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>Kubanga obusungu bwabwe bulibuubuukira ku bajeemu</para>
  <para style="q2" vid="PRO 24:22">era ani amaanyi akabi akalibatuukako?<verse eid="PRO 24:22"/></para>
  <para style="s1">Ebigambo Eby’amagezi</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23"/>Bino nabyo era bigambo by’abalina amagezi.</para>
  <para style="q2" vid="PRO 24:23">Okwekubiira ng’osala emisango si kirungi.<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Kale oyo agamba azizza omusango nti, “Toliiko ky’ovunaanibwa,”</para>
  <para style="q2" vid="PRO 24:24">abantu banaamukolimiranga, n’amawanga ganaamwetamwanga.<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>Naye abo abasalira omusobya omusango ne gumusinga banaabanga n’essanyu,</para>
  <para style="q2" vid="PRO 24:25">n’omukisa omulungi gulibatuukako.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Eky’okuddamu eky’amazima,</para>
  <para style="q2" vid="PRO 24:26">kiri ng’okunywegerwa.<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Malirizanga omulimu gwo ogw’ebweru,</para>
  <para style="q2" vid="PRO 24:27">oteeketeeke ennimiro zo,</para>
  <para style="q2" vid="PRO 24:27">n’oluvannyuma olyoke weezimbire ennyumba yo.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Towanga bujulizi bwa bulimba ku muliraanwa wo,</para>
  <para style="q2" vid="PRO 24:28">so akamwa ko tekalimbanga.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>Toyogeranga nti, “Omuntu oyo ndimukola nga bw’ankoze,</para>
  <para style="q2" vid="PRO 24:29">era ndimusasuza nga bw’ampisizza.”<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Nayita ku nnimiro ey’omugayaavu,</para>
  <para style="q2" vid="PRO 24:30">ne mpita ne ku nnimiro y’emizabbibu ey’oyo atalina kutegeera.<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>Kale laba, ng’ennimiro eyo ebunye amaggwa,</para>
  <para style="q2" vid="PRO 24:31">wansi wonna nga wabikkiddwa omuddo,</para>
  <para style="q2" vid="PRO 24:31">n’olukomera lwayo olw’amayinja nga lugudde.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Ne neekaliriza ne ntegeera</para>
  <para style="q2" vid="PRO 24:32">ne nfuna ekyokuyiga mu bye nalaba.<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>Otulo otutonotono, n’okusumagira akatono,</para>
  <para style="q2" vid="PRO 24:33">n’okufunya emikono okuwummulako,<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>obwavu bulikutuukako ng’omutemu,</para>
  <para style="q2" vid="PRO 24:34">era n’obwetaavu ng’omutemu.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">Engero Endala Eza Sulemaani</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>Zino nazo ngero za Sulemaani abasajja ba Keezeekiya kabaka wa Yuda ze baakoppolola.<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Okukisa ensonga kitiibwa kya Katonda,</para>
  <para style="q2" vid="PRO 25:2">naye okunoonyereza ensonga kitiibwa kya bakabaka.<verse eid="PRO 25:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>Ng’eggulu bwe lyewanise waggulu ennyo n’ensi bw’ekka ennyo wansi,</para>
  <para style="q2" vid="PRO 25:3">bwe gityo n’emitima gya bakabaka bwe gitategeerekeka.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Effeeza giggyeemu ebisejja,</para>
  <para style="q2" vid="PRO 25:4">olyoke ofune omuweesi ky’anaakozesa.<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>Ggyawo abakozi b’ebibi mu maaso ga kabaka,</para>
  <para style="q2" vid="PRO 25:5">entebe ye ey’obwakabaka eryoke enywezebwe mu butuukirivu.<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Teweekuzanga mu maaso ga kabaka,</para>
  <para style="q2" vid="PRO 25:6">wadde okwewa ekifo mu bantu ab’ekitiibwa.<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>Kubanga okukugamba nti, “Jjangu wano mu maaso,”</para>
  <para style="q2" vid="PRO 25:7">kisingako okukuswaza mu maaso g’ow’ekitiibwa.<verse eid="PRO 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8"/>Amaaso go bye galabye</para>
  <para style="q2" vid="PRO 25:8">tobyanguyirizanga kubireeta mu mbuga,</para>
  <para style="q1" vid="PRO 25:8">kubanga oluvannyuma onookola otya</para>
  <para style="q2" vid="PRO 25:8">munno bw’anaakuswaza?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>Bw’owozanga ne muliraanwa wo,</para>
  <para style="q2" vid="PRO 25:9">tobikkulanga kyama kya muntu mulala,<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>akiwulira aleme okukuswaza;</para>
  <para style="q2" vid="PRO 25:10">n’onyoomebwa ebbanga lyonna.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Ekigambo ekyogere nga bwe kisaanidde,</para>
  <para style="q2" vid="PRO 25:11">kiba kya muwendo nnyo nga zaabu gwe batonye mu bintu bye bakoze mu ffeeza.<verse eid="PRO 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Ng’empeta ey’omu kutu eya zaabu, oba akakomo aka zaabu ennungi,</para>
  <para style="q2" vid="PRO 25:12">bw’atyo omuntu ow’amagezi anenya, bw’abeera eri okutu okuwuliriza.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Ng’obunnyogovu bw’omuzira bwe bubeera mu biseera eby’okukunguliramu,</para>
  <para style="q2" vid="PRO 25:13">bw’atyo bw’abeera omubaka omwesigwa eri abo abamutuma,</para>
  <para style="q2" vid="PRO 25:13">aweweeza emmeeme ya bakama be.<verse eid="PRO 25:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>Ng’ebire n’empewo omutali nkuba,</para>
  <para style="q2" vid="PRO 25:14">omuntu asuubiza ebirabo by’atagaba bw’abeera.<verse eid="PRO 25:14"/></para>
  <para style="s1">Muliraanwa n’Omulabe</para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Okugumiikiriza okungi kuyinza okukkirizisa omufuzi,</para>
  <para style="q2" vid="PRO 25:15">n’olulimi olw’eggonjebwa lumenya eggumba.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Bw’ozuula omubisi gw’enjuki, lyako ogwo gwokka ogukumala,</para>
  <para style="q2" vid="PRO 25:16">si kulwa ng’ogukkuta nnyo n’ogusesema.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Tokyalanga lunye ewa muliraanwa wo,</para>
  <para style="q2" vid="PRO 25:17">si kulwa ng’akwetamwa n’akukyawa.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Omuntu awa obujulizi obw’obulimba ku muliraanwa we,</para>
  <para style="q2" vid="PRO 25:18">ali ng’embuukuuli, oba ekitala, oba akasaale akoogi.<verse eid="PRO 25:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Okwesiga omuntu ateesigika,</para>
  <para style="q2" vid="PRO 25:19">kiri ng’oli alina erinnyo eddwadde oba ekigere ekirema.<verse eid="PRO 25:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Ng’omuntu eyeeyambula engoye mu kiseera eky’obutiti,</para>
  <para style="q2" vid="PRO 25:20">era ng’omwenge omukaatuufu bwe guteekebwako oluvu,</para>
  <para style="q2" vid="PRO 25:20">bw’atyo bw’abeera ayimbira oyo ali mu buyinike.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Omulabe wo bw’aba alumwa enjala, muwe emmere alye,</para>
  <para style="q2" vid="PRO 25:21">bw’aba alumwa ennyonta muwe amazzi anywe.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Kubanga oliba otuuma amanda g’omuliro ku mutwe gwe,</para>
  <para style="q2" vid="PRO 25:22">era <char style="nd">Mukama</char> alikuwa empeera.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>Ng’empewo ey’obukiikakkono bwereeta enkuba,</para>
  <para style="q2" vid="PRO 25:23">n’olulimi oluyomba bwe luleetera omuntu obusungu.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Okusulanga mu kasonda waggulu ku nnyumba,</para>
  <para style="q2" vid="PRO 25:24">kisinga okubeera n’omukazi omuyombi mu nnyumba.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>Ng’amazzi amannyogovu bwe gaba eri emmeeme erumwa ennyonta,</para>
  <para style="q2" vid="PRO 25:25">bwe gatyo bwe gaba amawulire amalungi agava mu nsi ey’ewala.<verse eid="PRO 25:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>Ng’oluzzi olusiikuuse, oba ensulo eyonoonese,</para>
  <para style="q2" vid="PRO 25:26">bw’atyo bw’abeera omutuukirivu eyeewaayo eri omukozi w’ebibi.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Si kirungi kulya mubisi gwa njuki mungi,</para>
  <para style="q2" vid="PRO 25:27">bwe kityo si kirungi omuntu okwenoonyeza ekitiibwa.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Omuntu ateefuga</para>
  <para style="q2" vid="PRO 25:28">ali ng’ekibuga ekimenyeemenye ne kirekebwa nga tekirina bbugwe.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="s1">Omusirusiru n’Obusirusiru bwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>Ng’omuzira bwe gutasaana mu biseera bya kusiga oba enkuba mu makungula,</para>
  <para style="q2" vid="PRO 26:1">n’ekitiibwa bwe kitasaanira musirusiru.<verse eid="PRO 26:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Ng’enkazaluggya ewabye, ng’akataayi akabuukabuuka,</para>
  <para style="q2" vid="PRO 26:2">ekikolimo ekitasaanidde tekibaako kye kikola.<verse eid="PRO 26:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Embooko ya mbalaasi, n’olukoba lwa ndogoyi,</para>
  <para style="q2" vid="PRO 26:3">n’omuggo gusaanira migongo gya basirusirusiru.<verse eid="PRO 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>Toyanukulanga musirusiru ng’obusirusiru bwe, bwe buli,</para>
  <para style="q2" vid="PRO 26:4">oleme kubeera nga ye.<verse eid="PRO 26:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>Omusirusiru omuddangamu ng’obusirusiru bwe, bwe buli,</para>
  <para style="q2" vid="PRO 26:5">si kulwa nga yeerowooza nti mugezi.<verse eid="PRO 26:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Omuntu atuma omusirusiru,</para>
  <para style="q2" vid="PRO 26:6">aba ng’eyeetemyeko ebigere n’anywa obusungu.<verse eid="PRO 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>Ng’amagulu g’omulema bwe galengejja obulengezzi,</para>
  <para style="q2" vid="PRO 26:7">bwe lutyo n’olugero bwe lubeera mu kamwa k’omusirusiru.<verse eid="PRO 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Ng’atadde ejjinja mu nvuumuulo bw’aba,</para>
  <para style="q2" vid="PRO 26:8">n’oyo awa omusirusiru ekitiibwa bw’atyo bw’abeera.<verse eid="PRO 26:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Ng’eriggwa bwe lifumita mu mukono gw’omutamiivu,</para>
  <para style="q2" vid="PRO 26:9">bwe lutyo n’olugero bwe lubeera mu kamwa k’abasirusiru.<verse eid="PRO 26:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Ng’omulasi w’akasaale, amala galasa buli gw’asanze,</para>
  <para style="q2" vid="PRO 26:10">bw’abeera bw’atyo apangisa omusirusiru oba omuyise yenna gw’asanze.<verse eid="PRO 26:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Ng’embwa bw’eddira ebisesemye by’ayo,</para>
  <para style="q2" vid="PRO 26:11">bw’atyo bw’abeera omusirusiru adda mu nsobi ze.<verse eid="PRO 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Olaba omuntu omugezi mu maaso ge ye?</para>
  <para style="q2" vid="PRO 26:12">Omusirusiru alina essuubi okumusinga.<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>Omugayaavu agamba nti, “Mu kkubo eriyo empologoma,</para>
  <para style="q2" vid="PRO 26:13">empologoma enkambwe eyita mu luguudo!”<verse eid="PRO 26:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Ng’oluggi bwe lukyukira ku ppata zaalwo,</para>
  <para style="q2" vid="PRO 26:14">bw’atyo omugayaavu bw’akyukira ku kitanda kye.<verse eid="PRO 26:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>Omugayaavu akoza n’engalo ze mu kibya,</para>
  <para style="q2" vid="PRO 26:15">naye olw’obunafu bwe n’atasobola kuzizza mu kamwa.<verse eid="PRO 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Omugayaavu alowooza nti mugezi,</para>
  <para style="q2" vid="PRO 26:16">okusinga abantu omusanvu abaddamu ebibuuzo mu butuufu.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Ng’asika embwa amatu,</para>
  <para style="q2" vid="PRO 26:17">omuyise bw’abeera eyeeyingiza mu luyombo olutali lulwe.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Ng’omulalu akasuka</para>
  <para style="q2" vid="PRO 26:18">emmuli ez’omuliro oba obusaale obutta,<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>bw’abeera omuntu alimba munne,</para>
  <para style="q2" vid="PRO 26:19">n’agamba nti, “Mbadde nsaaga busaazi.”<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Enku bwe zibula omuliro guzikira,</para>
  <para style="q2" vid="PRO 26:20">awatali lugambo ennyombo ziggwaawo.<verse eid="PRO 26:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Ng’amanda ku gannaago agaliko omuliro, oba enku ku muliro,</para>
  <para style="q2" vid="PRO 26:21">bw’abeera omusajja omuyombi mu kuwakula entalo.<verse eid="PRO 26:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>Ebigambo by’omuntu ageya biri ng’emmere ewoomerera,</para>
  <para style="q2" vid="PRO 26:22">bigenda mu bitundu by’omubiri eby’ewala.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Ng’ekintu eky’ebbumba ekibikkiddwako amasengere,</para>
  <para style="q2" vid="PRO 26:23">bwe gibeera emimwa eminyiikivu egisibuka ku mutima omubi.<verse eid="PRO 26:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Omuntu ow’enkwe alimbalimba n’emimwa gye</para>
  <para style="q2" vid="PRO 26:24">naye ng’aterese obulimba mu mutima gwe.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>Wadde nga by’ayogera bisanyusa, tomukkiririzaamu</para>
  <para style="q2" vid="PRO 26:25">kubanga eby’emizizo musanvu bijjuza mu mutima gwe.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Enkwe ze ziyinza okubikkibwa mu kubuzaabuuza,</para>
  <para style="q2" vid="PRO 26:26">naye obutali butuukirivu bwe buliggyibwayo mu lukuŋŋaana.<verse eid="PRO 26:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Buli asima ekinnya y’alikigwamu,</para>
  <para style="q2" vid="PRO 26:27">n’oyo aliyiringisa ejjinja gwe liriddira.<verse eid="PRO 26:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Olulimi olulimba lukyawa abo be lufumita,</para>
  <para style="q2" vid="PRO 26:28">n’akamwa akawaanawaana kaleeta okuzikirira.<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="s1">Amagezi aga Leero n’Ebiseera eby’omu mu Maaso</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Teweenyumirizanga mu bya nkya,</para>
  <para style="q2" vid="PRO 27:1">kubanga olunaku bye lunaaleeta tobimanyi.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>Leka omulala akutenderezenga so si kamwa ko ggwe,</para>
  <para style="q2" vid="PRO 27:2">omuntu omulala so si mimwa gyo.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Ejjinja lizitowa, n’omusenyu muzito,</para>
  <para style="q2" vid="PRO 27:3">naye obulumbaganyi bw’omusirusiru businga byonna okuzitowa.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Obusungu bwa ttima, n’ekiruyi kifugira ddala nnyo,</para>
  <para style="q2" vid="PRO 27:4">naye ani ayinza okwolekera amaaso g’obuggya?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Okunenya mu lwatu,</para>
  <para style="q2" vid="PRO 27:5">kisinga okwagala okukisibbwa.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Okunywegera kw’omulabe kwandiba okungi,</para>
  <para style="q2" vid="PRO 27:6">naye ebiwundu by’okunenya kw’owoomukwano tebitiisa.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Oyo akkuse akyawa omubisi gw’enjuki,</para>
  <para style="q2" vid="PRO 27:7">naye eri omuyala n’ekikaawa kiba kiwoomerera.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Ng’akanyonyi akadduka mu kisu kyako,</para>
  <para style="q2" vid="PRO 27:8">bw’atyo bw’abeera omuntu abula mu maka ge.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>Ebyakaloosa bisanyusa omutima,</para>
  <para style="q2" vid="PRO 27:9">n’obuwoomerevu bw’omukwano gw’omuntu bwe butyo bwe buvaamu okubuulirira okw’amazima.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Mukwano gwo ne mukwano gwa kitaawo tobaabuuliranga,</para>
  <para style="q2" vid="PRO 27:10">olemenga okutawaana okuswala ewa muganda wo ng’ogudde mu mitawaana.</para>
  <para style="q2" vid="PRO 27:10">Muliraanwa wo akira muganda wo akuli ewala.<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>Beeranga n’amagezi mwana wange, osanyusenga omutima gwange,</para>
  <para style="q2" vid="PRO 27:11">ndyoke nyanukule oyo yenna ansekerera.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Omuntu omutegeevu alaba akabenje ne yeekweka,</para>
  <para style="q2" vid="PRO 27:12">naye abatalina magezi batambula butambuzi ne bagwa mu kabi.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Twalanga ekyambalo ky’oyo eyeeyimirira gw’atamanyi,</para>
  <para style="q2" vid="PRO 27:13">era kwatanga eky’oyo eyeeyimirira omukazi omwenzi kye yeeyamye.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Okulamusa ku muliraanwa wo mu makya ennyo, ng’oleekaana,</para>
  <para style="q2" vid="PRO 27:14">obanga amukolimidde.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>Omukazi omuyombi ali ng’enkuba etonnya olutata,</para>
  <para style="q2" vid="PRO 27:15">ku lunaku olw’enkuba ennyingi.<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>Okumuziyiza obanga aziyiza empewo oba</para>
  <para style="q2" vid="PRO 27:16">ng’anyweza omuzigo mu ngalo.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>Ng’ekyuma bwe kiwagala ekyuma,</para>
  <para style="q2" vid="PRO 27:17">n’omuntu bw’abangula muntu munne.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Buli alabirira omutiini alirya ku bibala byagwo,</para>
  <para style="q2" vid="PRO 27:18">n’oyo aweereza mukama we alissibwamu ekitiibwa.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>Ng’amazzi bwe galaga omuntu bw’afaanana mu maaso,</para>
  <para style="q2" vid="PRO 27:19">bwe gutyo omutima gw’omuntu bwe gulaga omuntu bw’afaanana.<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>Amagombe ne ggeyeena tebikkuta,</para>
  <para style="q2" vid="PRO 27:20">n’amaaso g’abantu nago bwe gatyo tegakkuta.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Entamu erongoosa ya ffeeza n’ekikoomi kikola ku zaabu,</para>
  <para style="q2" vid="PRO 27:21">naye omuntu ekimugezesa kutenderezebwa.<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>Ne bw’osekula omusirusiru mu kinu,</para>
  <para style="q2" vid="PRO 27:22">nga bw’osekula emmere y’empeke mu kinu,</para>
  <para style="q2" vid="PRO 27:22">obusirusiru bwe tobumuggyaamu.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>Okakasanga nti omanyi bulungi embeera z’ekisibo kyo,</para>
  <para style="q2" vid="PRO 27:23">ossangayo omwoyo ku ggana lyo.<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>Kubanga eby’obugagga tebibeerera mirembe gyonna,</para>
  <para style="q2" vid="PRO 27:24">n’engule tebeerera mirembe gyonna.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Ng’omuddo gw’ensolo omukulu gumaze okusalibwawo, ng’omutoototo gutandise okusibukawo,</para>
  <para style="q2" vid="PRO 27:25">nga n’omuddo ogw’omu busozi guleeteddwa,<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>abaana b’endiga balikuwa engoye ez’okwambala,</para>
  <para style="q2" vid="PRO 27:26">n’embuzi ziritundibwa ne zivaamu ensimbi.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Olibeera n’amata mangi g’onoggyanga mu mbuzi, okukuliisa ggwe n’ab’omu nnyumba yo,</para>
  <para style="q2" vid="PRO 27:27">n’okuliisa abaweereza bo abawala.<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Abakozi b’ebibi badduka nga tewali abagoba,</para>
  <para style="q2" vid="PRO 28:1">naye abatuukirivu babeera n’obuvumu ng’empologoma.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Eggwanga bwe lijeema, liba n’abafuzi bangi,</para>
  <para style="q2" vid="PRO 28:2">naye olw’omuntu alina okutegeera n’okumanya obutebenkevu budda nate mu nsi.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Omufuzi anyigiriza abaavu,</para>
  <para style="q2" vid="PRO 28:3">afaanana nga enkuba etonnya ezikiriza n’eterekaawo birime.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Abo abava ku mateeka ga <char style="nd">Mukama</char> batendereza aboonoonyi,</para>
  <para style="q2" vid="PRO 28:4">naye abo abagakuuma babawakanya.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Abantu abakozi b’ebibi tebategeera bwenkanya,</para>
  <para style="q2" vid="PRO 28:5">naye abo abanoonya <char style="nd">Mukama</char> babutegeerera ddala bulungi.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>Omuntu omwavu atambulira mu butuukirivu,</para>
  <para style="q2" vid="PRO 28:6">asinga omugagga ow’amakubo amakyamu.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Oyo akuuma amateeka ga <char style="nd">Mukama</char> mwana eyeegendereza,</para>
  <para style="q2" vid="PRO 28:7">naye mukwano gw’ab’omululu akwasa kitaawe ensonyi.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Ayongera ku bugagga bwe mu bukumpanya,</para>
  <para style="q2" vid="PRO 28:8">abukuŋŋaanyiza omulala anaayinza okuba ow’ekisa eri abaavu.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Atassaayo mwoyo kuwulira mateeka ga <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 28:9">n’okusaba kwe tekukkirizibwa.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Buli akyamya abatuukirivu mu kkubo ebbi,</para>
  <para style="q2" vid="PRO 28:10">aligwa mu katego ke ye,</para>
  <para style="q2" vid="PRO 28:10">naye abatuukirivu balisikira ebirungi.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Omugagga alowooza nti mugezi,</para>
  <para style="q2" vid="PRO 28:11">naye omwavu alina okutegeera, amunyooma.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Abatuukirivu bwe bawangula wabaawo okujaguza okw’amaanyi,</para>
  <para style="q2" vid="PRO 28:12">naye abakakanyalira mu kukola ebikyamu bwe bafuna obuyinza abantu beekweka.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Oyo akweka ebibi bye, talifuna mukisa kukulaakulana,</para>
  <para style="q2" vid="PRO 28:13">naye buli abyatula n’abireka, alisaasirwa.<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>Alina omukisa omuntu atya <char style="nd">Mukama</char> ebbanga lyonna,</para>
  <para style="q2" vid="PRO 28:14">naye oyo akakanyaza omutima gwe abonaabona.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Ng’empologoma ewuluguma oba eddubu eritiisatiisa,</para>
  <para style="q2" vid="PRO 28:15">bw’abeera omufuzi omubi atulugunya abateesobola.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Omufuzi nantagambwako tafuga na bwenkanya,</para>
  <para style="q2" vid="PRO 28:16">naye oyo akyawa amagoba agafuniddwa mu bukyamu alibeera n’essanyu ery’obulamu obuwangaazi.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Omuntu alumirizibwa olw’okutta munne,</para>
  <para style="q2" vid="PRO 28:17">alibeera mu kutegana okutuusa okufa,</para>
  <para style="q2" vid="PRO 28:17">tewabanga n’omu amuyamba.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Omuntu atambulira mu bugolokofu alinunulibwa talibeerako kabi,</para>
  <para style="q2" vid="PRO 28:18">naye oyo ow’amakubo amabi aligwa mbagirawo.<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>Omuntu alima ennimiro ye aliba n’emmere nnyingi,</para>
  <para style="q2" vid="PRO 28:19">naye oyo ali mu birowoozo ebitaliimu alifa bwavu.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Omusajja omwesigwa aliweebwa emikisa mingi,</para>
  <para style="q2" vid="PRO 28:20">naye oyo ayanguyiriza okugaggawala talirema kubonerezebwa.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Okuttira abantu ku liiso ng’osala emisango si kirungi,</para>
  <para style="q2" vid="PRO 28:21">naye ate olw’okunoonya akookulya omuntu ayinza okuzza omusango.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Omusajja omukodo yeegomba okugaggawala,</para>
  <para style="q2" vid="PRO 28:22">naye nga tamanyi nti obwavu bumulindiridde.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Oyo anenya omuntu, oluvannyuma aliganja,</para>
  <para style="q2" vid="PRO 28:23">okusinga oyo awaaniriza n’olulimi.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Buli anyaga kitaawe, oba nnyina,</para>
  <para style="q2" vid="PRO 28:24">n’agamba nti, “Si nsonga,” afaanana n’oyo azikiriza.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Omuntu ow’omululu aleeta oluyombo,</para>
  <para style="q2" vid="PRO 28:25">naye oyo eyeesiga <char style="nd">Mukama</char> aligaggawazibwa.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Eyeesiga omutima gwe, musirusiru,</para>
  <para style="q2" vid="PRO 28:26">naye oyo atambulira mu magezi alifuna emirembe.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Agabira abaavu talibaako ne kye yeetaaga,</para>
  <para style="q2" vid="PRO 28:27">naye abakodowalira anaabanga n’ebikolimo bingi.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Abakozi b’ebibi bwe babeera mu buyinza, abantu beekweka,</para>
  <para style="q2" vid="PRO 28:28">naye abakozi b’ebibi bwe bazikirira, abatuukirivu bakulaakulana.<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="s1">Obukulembeze bw’Abatuukirivu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Omuntu akakanyaza omutima gwe oluvannyuma lw’okunenyezebwa emirundi emingi,</para>
  <para style="q2" vid="PRO 29:1">alizikirira ng’atamanyiridde awatali kuwona.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Abatuukirivu bwe bakulaakulana, abantu basanyuka,</para>
  <para style="q2" vid="PRO 29:2">naye abakakanyalira mu kukola ebikyamu bwe bafuga abantu babeera mu kusinda.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Ayagala amagezi asanyusa kitaawe,</para>
  <para style="q2" vid="PRO 29:3">naye munne w’abamalaaya ayiwaayiwa obugagga bwe.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>Kabaka afuga n’obwenkanya, abantu be baba mu butebenkevu,</para>
  <para style="q2" vid="PRO 29:4">naye oyo alulunkanira enguzi, ensi agyonoona.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Omuntu awaanawaana munne,</para>
  <para style="q2" vid="PRO 29:5">aba yeetega yekka ekitimba.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Ebibi by’omwonoonyi bye bimutega,</para>
  <para style="q2" vid="PRO 29:6">naye omutuukirivu abeera mu kuyimba na kusanyuka.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Omutuukirivu afaayo ku nsonga z’abaavu,</para>
  <para style="q2" vid="PRO 29:7">naye abakozi b’ebibi tebakola bwe batyo.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Abakudaazi basasamaza ekibuga,</para>
  <para style="q2" vid="PRO 29:8">naye abantu abalina amagezi baziyiza entalo.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Omuntu ow’amagezi bw’awoza n’omusirusiru,</para>
  <para style="q2" vid="PRO 29:9">omusirusiru ayongera kusunguwala, n’okujerega ne wataba mirembe.<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Abeegomba okuyiwa omusaayi bakyawa omuntu ow’amazima,</para>
  <para style="q2" vid="PRO 29:10">era banoonya okusaanyaawo obulamu bwe.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Omusirusiru alaga obusungu bwe bwonna,</para>
  <para style="q2" vid="PRO 29:11">naye omuntu ow’amagezi abuziyiza n’abukkakkanya.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Omufuzi bw’awuliriza eby’obulimba,</para>
  <para style="q2" vid="PRO 29:12">abakungu be bonna bafuuka babi.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Omwavu n’oyo amubonyaabonya balina ekibagatta:</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">Mukama</char> bombi ye yabawa amaaso.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Kabaka bw’asalira abaavu emisango n’obwesigwa,</para>
  <para style="q2" vid="PRO 29:14">obufuzi bwe bubeerera emirembe gyonna.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>Akaggo akakangavvula, kaleeta amagezi,</para>
  <para style="q2" vid="PRO 29:15">naye omwana alekeddwa awo, aswaza nnyina.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Abakozi b’ebibi bwe beeyongera obungi, okumenya amateeka kweyongera,</para>
  <para style="q2" vid="PRO 29:16">naye abatuukirivu baliraba okugwa kwabwe.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Kangavvula omwana wo, alikuwa emirembe,</para>
  <para style="q2" vid="PRO 29:17">alireetera emmeeme yo essanyu.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Awatali kwolesebwa abantu tebaba beegendereza,</para>
  <para style="q2" vid="PRO 29:18">naye wa mukisa oyo akuuma amateeka ga <char style="nd">Mukama</char>.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Omuweereza tayinza kubuulirirwa na bigambo byokka;</para>
  <para style="q2" vid="PRO 29:19">ne bw’aba ategedde tafaayo.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Olaba omuntu ayanguyiriza ebigambo bye?</para>
  <para style="q2" vid="PRO 29:20">Omusirusiru alina essuubi okumusinga.<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Atiitiibya omuweereza we ekiyitiridde ng’akyali mwana muto,</para>
  <para style="q2" vid="PRO 29:21">oluvannyuma omuweereza aleetera mukama we obuyinike.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Omuntu ow’obusungu aleeta ennyombo,</para>
  <para style="q2" vid="PRO 29:22">n’omuntu asunguwala amangu ayonoona nnyo.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Amalala g’omuntu galimuleetera okugwa,</para>
  <para style="q2" vid="PRO 29:23">naye omuntu ow’omwoyo ogwetoowaza alifuna ekitiibwa.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Buli assa ekimu n’omubbi akyawa obulamu bwe ye,</para>
  <para style="q2" vid="PRO 29:24">era ne bw’alayizibwa tasaanira kubaako ky’ayogera.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Okutya omuntu kuleeta ekyambika,</para>
  <para style="q2" vid="PRO 29:25">naye buli eyeesiga <char style="nd">Mukama</char> anaabanga mirembe.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Bangi abanoonya okuganja mu maaso g’omufuzi,</para>
  <para style="q2" vid="PRO 29:26">naye obwenkanya obwa nnama ddala buva eri <char style="nd">Mukama</char>.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Atali mutuukirivu wa muzizo eri abatuukirivu;</para>
  <para style="q2" vid="PRO 29:27">era omwesimbu wa muzizo eri abakozi b’ebibi.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">Ebigambo ba Aguli</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Bino bye bigambo bya Aguli mutabani wa Yake; obubaka bwe yawa bwe buno:</para>
  <para style="q1" vid="PRO 30:1">Bw’ati omusajja ono bwe yagamba Isiyeri, Isyeri ono ne Ukali.<verse eid="PRO 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>Ddala Ayi Katonda wange nze nsinga obutategeera,</para>
  <para style="q2" vid="PRO 30:2">sirina kutegeera kwa bantu.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>Siyize magezi,</para>
  <para style="q2" vid="PRO 30:3">so n’oyo Omutukuvu simumanyi.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>Ani eyali alinnye mu ggulu n’akka?</para>
  <para style="q2" vid="PRO 30:4">Ani eyali akuŋŋaanyiza empewo mu kibatu ky’engalo ze?</para>
  <para style="q1" vid="PRO 30:4">Ani eyali asibye amazzi mu kyambalo kye?</para>
  <para style="q2" vid="PRO 30:4">Ani eyatonda enkomerero zonna ez’ensi?</para>
  <para style="q1" vid="PRO 30:4">Erinnya lye y’ani, ne mutabani we y’ani?</para>
  <para style="q2" vid="PRO 30:4">Mbulira obanga obimanyi.<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>Buli kigambo kya Katonda kya mazima,</para>
  <para style="q2" vid="PRO 30:5">era aba ngabo eri abo abamwesiga.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>Toyongeranga ku bigambo bye,</para>
  <para style="q2" vid="PRO 30:6">alemenga okukunenya naawe olabike ng’omulimba.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>Ebintu bibiri bye nkusaba; Ayi <char style="nd">Mukama</char>,</para>
  <para style="q2" vid="PRO 30:7">tobinnyimanga nga sinnafa:<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>Ebigambo eby’obutaliimu n’eby’obulimba binteeke wala,</para>
  <para style="q2" vid="PRO 30:8">ate era tonjavuwazanga wadde okungaggawaza,</para>
  <para style="q2" vid="PRO 30:8">naye ndiisanga emmere eya buli lunaku.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>Nneme okukkutanga ne nkwegaana</para>
  <para style="q2" vid="PRO 30:9">ne njogera nti, “<char style="nd">Mukama</char> ye y’ani?”</para>
  <para style="q1" vid="PRO 30:9">Era nnemenga okuba omwavu ne nziba,</para>
  <para style="q2" vid="PRO 30:9">ne nvumisa erinnya lya Katonda wange.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>Tosekeetereranga muweereza eri mukama we,</para>
  <para style="q2" vid="PRO 30:10">alemenga okukukolimira, naawe omusango ne gukusinga.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>Waliwo abo abakolimira bakitaabwe</para>
  <para style="q2" vid="PRO 30:11">ne batasabira na bannyaabwe mukisa;<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>abo abeeraba ng’abatuukirivu bo mu maaso gaabwe,</para>
  <para style="q2" vid="PRO 30:12">ate nga tebanaazibwangako bibi byabwe.<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>Waliwo abo ab’amalala amayitirivu,</para>
  <para style="q2" vid="PRO 30:13">abatunuza okwemanya okw’ekitalo,<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>n’ebeerayo abo abalina amannyo agali ng’ebitala,</para>
  <para style="q2" vid="PRO 30:14">n’emba zaabwe nga zirimu ebiso,</para>
  <para style="q1" vid="PRO 30:14">okusaanyaawo abaavu mu nsi,</para>
  <para style="q2" vid="PRO 30:14">n’abo abali mu kwetaaga.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>Ekinoso kirina bawala baakyo babiri</para>
  <para style="q2" vid="PRO 30:15">abaleekaana nti, “Mpa! mpa!”</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="li1" vid="PRO 30:15">Waliwo ebintu bisatu ebitakkuta,</para>
  <para style="li2" vid="PRO 30:15">weewaawo bina ebitagamba nti, “Matidde,”<verse eid="PRO 30:15"/></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16"/>Amagombe,</para>
  <para style="li3" vid="PRO 30:16">olubuto olugumba,</para>
  <para style="li3" vid="PRO 30:16">ettaka eritakutta mazzi,</para>
  <para style="li3" vid="PRO 30:16">n’omuliro ogutayogera nti, “Ebyo binaamala!”<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>Eriiso ly’oyo anyooma kitaawe,</para>
  <para style="q2" vid="PRO 30:17">era n’atagondera nnyina,</para>
  <para style="q1" vid="PRO 30:17">liriggibwamu bannamuŋŋoona ab’omu kiwonvu,</para>
  <para style="q2" vid="PRO 30:17">ne liriibwa ensega.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18"/>Waliwo ebigambo bisatu eby’ekitalo ennyo gye ndi,</para>
  <para style="li2" vid="PRO 30:18">weewaawo bina bye sitegeera:<verse eid="PRO 30:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19"/>Empungu engeri gye yeeyisaamu mu bbanga,</para>
  <para style="li3" vid="PRO 30:19">n’omusota engeri gye gwewalulamu wakati mu mayinja,</para>
  <para style="li3" vid="PRO 30:19">n’ekyombo gye kiseeyeeyamu ku nnyanja,</para>
  <para style="li3" vid="PRO 30:19">n’engeri omusajja gye yeeyisaamu ng’ali n’embeerera.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>Bw’ati bwe yeeyisa omukazi omwenzi:</para>
  <para style="q2" vid="PRO 30:20">alya n’asiimuula emimwa gye</para>
  <para style="q2" vid="PRO 30:20">n’agamba nti, “Sirina kibi kye nkoze.”<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21"/>Ensi ekankanira wansi w’ebintu bisatu</para>
  <para style="li2" vid="PRO 30:21">weewaawo bina:<verse eid="PRO 30:21"/></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22"/>omuweereza bw’afuuka kabaka,</para>
  <para style="li3" vid="PRO 30:22">n’omusirusiru bw’akutta emmere;<verse eid="PRO 30:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23"/>n’omukazi eyadibira mu ddya;</para>
  <para style="li3" vid="PRO 30:23">n’omuweereza omuwala bw’afumbirwa bba wa mugole we.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24"/>Waliwo ebintu ebitono bina ku nsi,</para>
  <para style="li2" vid="PRO 30:24">ebirina amagezi amangi ennyo.<verse eid="PRO 30:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25"/>Enkolooto bye biwuka ebitalina maanyi mangi,</para>
  <para style="li3" vid="PRO 30:25">naye byeterekera emmere yaabyo mu kyeya;<verse eid="PRO 30:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26"/>obumyu busolo bunafu</para>
  <para style="li3" vid="PRO 30:26">naye bwezimbira ennyumba zaabwo mu mayinja;<verse eid="PRO 30:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27"/>enzige tezirina kabaka,</para>
  <para style="li3" vid="PRO 30:27">kyokka zitabaala zonna mu bibiina byazo;<verse eid="PRO 30:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28"/>omunya oyinza okugukwasa engalo,</para>
  <para style="li3" vid="PRO 30:28">naye mu mbiri za bakabaka gusangibwamu.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29"/>Waliwo ebintu bisatu ebyesimba obulungi mu kitiibwa nga bitambula,</para>
  <para style="li2" vid="PRO 30:29">weewaawo bina ebitambulira mu kitiibwa:<verse eid="PRO 30:29"/></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30"/>empologoma esinga ensolo zonna amaanyi era kabaka waazo, so tewali gy’esegulira yonna;<verse eid="PRO 30:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31"/>sseggwanga,</para>
  <para style="li3" vid="PRO 30:31">n’embuzi ennume,</para>
  <para style="li3" vid="PRO 30:31">ne kabaka eyeetooloddwa eggye lye.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>Bw’oba ng’obadde okoze eby’obusirusiru ne weegulumiza,</para>
  <para style="q2" vid="PRO 30:32">obanga obadde oteekateeka okukola ebibi,</para>
  <para style="q2" vid="PRO 30:32">weekomeko weekwate ku mumwa.<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Kubanga okusunda amata kuzaala omuzigo,</para>
  <para style="q2" vid="PRO 30:33">n’okunyiga ennyindo kuleeta omusaayi,</para>
  <para style="q2" vid="PRO 30:33">okutankuula obusungu, bwe kutyo kuleeta entalo.<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">Okulabula ku Kunywa Ekitamiiza</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Ebigambo bya kabaka Lemweri bye yayogera, nnyina bye yamuyigiriza.<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>Ggwe mutabani wange, ggwe mutabani w’enda yange,</para>
  <para style="q2" vid="PRO 31:2">ggwe mutabani w’obweyamo bwange.<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>Tomaliranga maanyi go ku bakazi,<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">Abakazi aboogerwako wano be baweereza abakazi abangi ababeera mu lubiri; batabulatabula kabaka ng’akola emirimu gye</char></note></para>
  <para style="q2" vid="PRO 31:3">newaakubadde amaanyi go ku abo abazikiriza bakabaka.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>Ggwe Lemweri, si kya bakabaka,</para>
  <para style="q2" vid="PRO 31:4">si kya bakabaka okunywanga omwenge,</para>
  <para style="q2" vid="PRO 31:4">so si kya balangira okwegombanga omwenge,<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>si kulwa nga bagunywa ne beerabira amateeka,</para>
  <para style="q2" vid="PRO 31:5">ne batalamula mu bwenkanya abantu baabwe abatulugunyizibwa.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Ekitamiiza mukiwenga oyo ayagala okufa,</para>
  <para style="q2" vid="PRO 31:6">n’omwenge oyo alina emmeeme eriko obuyinike.<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>Mumuleke anywenga yeerabire obwavu bwe,</para>
  <para style="q2" vid="PRO 31:7">alemenga kujjukira nate buyinike bwe.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>Yogereranga abo abatasobola kweyogerera,</para>
  <para style="q2" vid="PRO 31:8">otunulenga mu nsonga z’abo bonna abaasigala ettayo.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Yogera olamulenga n’obwenkanya,</para>
  <para style="q2" vid="PRO 31:9">olwanirirenga abaavu n’abali mu bwetaavu.<verse eid="PRO 31:9"/></para>
  <para style="s1">Omukazi ow’Amagezi</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Omukazi omwegendereza ani ayinza okumulaba?</para>
  <para style="q2" vid="PRO 31:10">Wa muwendo nnyo okusinga amayinja ag’omuwendo ennyo.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Bba amwesiga n’omutima gwe gwonna,</para>
  <para style="q2" vid="PRO 31:11">era bba talina kyonna kya muwendo ky’abulwa.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Aleetera bba essanyu so tamukola kabi,</para>
  <para style="q2" vid="PRO 31:12">obulamu bwe bwonna.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Anoonya ebyoya by’endiga n’anoonya ne ppamba,</para>
  <para style="q2" vid="PRO 31:13">n’akola emirimu gye mu ssanyu eritayogerekeka.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Ali ng’ebyombo by’abasuubuzi,</para>
  <para style="q2" vid="PRO 31:14">aleeta emmere okuva mu nsi ezeewala.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Agolokoka tebunnakya,</para>
  <para style="q2" vid="PRO 31:15">n’awa ab’omu nnyumba ye ebyokulya,</para>
  <para style="q2" vid="PRO 31:15">n’agabira abaweereza be abawala be abaweereza emirimu egy’okukola.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Alowooza ku nnimiro n’agigula;</para>
  <para style="q2" vid="PRO 31:16">asimba ennimiro ey’emizabbibu n’ebibala by’emikono gye.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Omukazi oyo akola n’amaanyi omulimu gwe,</para>
  <para style="q2" vid="PRO 31:17">emikono gye gikwata n’amaanyi emirimu gye.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Ayiiya ebyamaguzi ebirimu amagoba n’abisuubula,</para>
  <para style="q2" vid="PRO 31:18">era n’ettabaaza ye ekiro tezikira.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Anyweza omuti oguluka ppamba mu mukono gwe,</para>
  <para style="q2" vid="PRO 31:19">engalo ze ne zikwata akati akalanga.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Ayanjululiza abaavu omukono gwe,</para>
  <para style="q2" vid="PRO 31:20">n’agololera omukono gwe oyo ali mu bwetaavu.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Mu biseera by’obutiti taba na kutya,</para>
  <para style="q2" vid="PRO 31:21">kubanga ab’omu nnyumba ye bonna baba n’engoye ez’okwambala.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Yeekolera ebibikka obuliri bwe,</para>
  <para style="q2" vid="PRO 31:22">era engoye ze za linena omulungi, za ffulungu.<note caller="+" style="f"><char style="fr" closed="false">31:22 </char><char style="ft" closed="false">Engoye za ffulungu zaali za bbeeyi era nga kabonero ka kikungu</char></note><verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Bba amanyibbwa,</para>
  <para style="q2" vid="PRO 31:23">y’omu ku bakulu abakulembera ensi, era ateeseza mu nkiiko enkulu.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Omukazi atunga ebyambalo ebya linena n’abitunda,</para>
  <para style="q2" vid="PRO 31:24">n’aguza abasuubuzi enkoba.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Amaanyi n’ekitiibwa bye byambalo bye,</para>
  <para style="q2" vid="PRO 31:25">era tatya ebiro ebigenda okujja.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Ayogera n’amagezi,</para>
  <para style="q2" vid="PRO 31:26">era ayigiriza ebyekisa.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Alabirira nnyo empisa z’ab’omu nnyumba ye,</para>
  <para style="q2" vid="PRO 31:27">era talya mmere ya bugayaavu.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Abaana be bagolokoka ne bamuyita wa mukisa,</para>
  <para style="q2" vid="PRO 31:28">ne bba n’amutendereza ng’ayogera nti,<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“Abakazi bangi abakola eby’ekitiibwa</para>
  <para style="q2" vid="PRO 31:29">naye bonna ggwe obasinga.”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Obubalagavu bulimba n’endabika ennungi teriiko kyegasa,</para>
  <para style="q2" vid="PRO 31:30">naye omukazi atya <char style="nd">Mukama</char> anaatenderezebwanga.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Mumusasule empeera gy’akoleredde,</para>
  <para style="q2" vid="PRO 31:31">n’emirimu gye gimuweesenga ettendo ku miryango gy’ekibuga.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
