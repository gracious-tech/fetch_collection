<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Mika</para>
  <para style="toc1">Odiyifo Mika Nhoma</para>
  <para style="toc2">Mika</para>
  <para style="toc3">Mika</para>
  <para style="mt2">Odiyifo</para>
  <para style="mt1">Mika</para>
  <para style="mt2">Nhoma</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>
    <char style="nd">Awurade</char> de saa nsɛm yi brɛɛ Moresetni Mika<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">Mika nkyerɛase ne “Hena na ɔte sɛ Awurade,” a ɛfa Samaria ne Yerusalem ho: Saa nkuropɔn abien yi gyina hɔ ma Israel ne Yuda. Atemmu a Mika hyɛɛ ho nkɔm no fa aman abien no ho na ɛmfa wɔn nkuropɔn no nko ho.</char></note> bere a na Yotam, Ahas ne Hesekia di ade wɔ Yuda no. Anisoade a ohu faa Samaria ne Yerusalem ho.<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>Monyɛ aso, mo nnipa nyinaa,</para>
  <para style="q2" vid="MIC 1:2">muntie, asase ne mo a mote so nyinaa.</para>
  <para style="q1" vid="MIC 1:2">Otumfo <char style="nd">Awurade</char> redi adanse atia mo,</para>
  <para style="q2" vid="MIC 1:2">ɔkasa fi nʼasɔredan kronkron no mu.<verse eid="MIC 1:2"/></para>
  <para style="s1">Atemmu A Etia Samaria Ne Yerusalem</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>Monhwɛ! <char style="nd">Awurade</char> fi nʼatenae reba;</para>
  <para style="q2" vid="MIC 1:3">ɔresian na ɔnam asase sorɔnsorɔmmea so.<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>Mmepɔw nan wɔ nʼase,</para>
  <para style="q2" vid="MIC 1:4">aku mu paapae</para>
  <para style="q1" vid="MIC 1:4">te sɛ ama a aka ogya,</para>
  <para style="q2" vid="MIC 1:4">te sɛ nsu a ɛresian waa fi koko so.<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>Eyi nyinaa yɛ Yakob nnebɔne,</para>
  <para style="q2" vid="MIC 1:5">ne bɔne ahorow a ɛwɔ Israel fi nti.</para>
  <para style="q1" vid="MIC 1:5">Yakob nnebɔne ne dɛn?</para>
  <para style="q2" vid="MIC 1:5">Ɛnyɛ Samaria ana?</para>
  <para style="q1" vid="MIC 1:5">Na he ne Yuda sorɔnsorɔmmea?</para>
  <para style="q2" vid="MIC 1:5">Ɛnyɛ Yerusalem ana?<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>“Enti mɛyɛ Samaria kurow no nnwiriwii siw,</para>
  <para style="q2" vid="MIC 1:6">baabi a wɔbɛyɛ bobe turo.</para>
  <para style="q1" vid="MIC 1:6">Mehwie nʼabo agu obon mu</para>
  <para style="q2" vid="MIC 1:6">ama ne fapem ho ada hɔ.<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>Wobebubu nʼahoni nyinaa mu asinasin;</para>
  <para style="q2" vid="MIC 1:7">wɔde ogya bɛhyew nʼasɔredan mu ayɛyɛde nyinaa.</para>
  <para style="q2" vid="MIC 1:7">Mɛsɛe ne nsɛsode nyinaa.</para>
  <para style="q1" vid="MIC 1:7">Esiane sɛ nʼakyɛde a waboa ano no nyinaa,</para>
  <para style="q2" vid="MIC 1:7">onya fii nguamanfo akatua mu no nti</para>
  <para style="q2" vid="MIC 1:7">wɔde bɛma nguamanfo.”<verse eid="MIC 1:7"/></para>
  <para style="s1">Osu Ne Awerɛhow</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>Eyinom nti mesu atwa agyaadwo;</para>
  <para style="q2" vid="MIC 1:8">mede adagyaw bɛnantew na merenhyɛ mpaboa.</para>
  <para style="q1" vid="MIC 1:8">Mɛworo so sɛ odompo</para>
  <para style="q2" vid="MIC 1:8">na masu sɛ patu.<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>Nʼapirakuru no wu ayɛ den;</para>
  <para style="q2" vid="MIC 1:9">abedu Yuda.</para>
  <para style="q1" vid="MIC 1:9">Abedu me nkurɔfo pon ano</para>
  <para style="q2" vid="MIC 1:9">mpo adu Yerusalem ankasa.<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>Monnka no wɔ Gat</para>
  <para style="q2" vid="MIC 1:10">munnsu koraa</para>
  <para style="q1" vid="MIC 1:10">Mo a mowɔ Bet-Leafra de,</para>
  <para style="q2" vid="MIC 1:10">monyantam mfutuma mu.<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>Monsen nkɔ adagyaw ne aniwu mu,</para>
  <para style="q2" vid="MIC 1:11">mo a mote Safir.</para>
  <para style="q1" vid="MIC 1:11">Wɔn a wɔte Saanan ntumi mpue.</para>
  <para style="q2" vid="MIC 1:11">Bet-Esel wɔ awerɛhow mu;</para>
  <para style="q2" vid="MIC 1:11">efisɛ, wo hɔ na onya ne bammɔ.<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>Wɔn a wɔte Marot de ɔyaw nunununu wɔn mu</para>
  <para style="q2" vid="MIC 1:12">de twɛn mmoa,</para>
  <para style="q1" vid="MIC 1:12">efisɛ amanehunu a efi <char style="nd">Awurade</char> hɔ aba</para>
  <para style="q2" vid="MIC 1:12">abedu Yerusalem pon ano.<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>Mo a mote Lakis,</para>
  <para style="q2" vid="MIC 1:13">munsiesie nteaseɛnam no.</para>
  <para style="q1" vid="MIC 1:13">Mone bɔne farebae</para>
  <para style="q2" vid="MIC 1:13">ma Ɔbabea Sion,</para>
  <para style="q1" vid="MIC 1:13">na mudii Israel anim kɔɔ bɔne mu.<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>Enti mode ntetewmu akyɛde bɛma Moreset-Gat,</para>
  <para style="q2" vid="MIC 1:14">Aksib kurow bɛdaadaa Israel ahemfo.<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>Mede nkonimdifo bɛtoa mo;</para>
  <para style="q2" vid="MIC 1:15">mo a mote Maresa.</para>
  <para style="q1" vid="MIC 1:15">Nea ɔyɛ Israel onuonyamfo no</para>
  <para style="q2" vid="MIC 1:15">bɛba Adulam.<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>Munyi mo tinwi mfa nni awerɛhow,</para>
  <para style="q2" vid="MIC 1:16">wɔ mma a mo ani gye wɔn ho no ho;</para>
  <para style="q1" vid="MIC 1:16">mommɔ tikwaw te sɛ opete,</para>
  <para style="q2" vid="MIC 1:16">efisɛ, wɔbɛfa wɔn afi mo nkyɛn</para>
  <para style="q2" vid="MIC 1:16">akɔ nnommum mu.<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">Onipa Ne Onyankopɔn Nhyehyɛe</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>Nnome nka wɔn a wɔfa amumɔyɛ ho adwene,</para>
  <para style="q2" vid="MIC 2:1">wɔn a wɔbɔ pɔw bɔne wɔ wɔn mpa so!</para>
  <para style="q1" vid="MIC 2:1">Wɔsɔre anɔpa kodi dwuma no,</para>
  <para style="q2" vid="MIC 2:1">efisɛ wɔwɔ tumi sɛ wɔyɛ.<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>Wɔn ani bere mfuw, na wogye.</para>
  <para style="q2" vid="MIC 2:2">Na afi nso wɔfa.</para>
  <para style="q1" vid="MIC 2:2">Wɔde nyansakorɔn gye nkurɔfo afi,</para>
  <para style="q2" vid="MIC 2:2">na wɔn agyapade nso wogye.<verse eid="MIC 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 2:3"/>Enti, sɛnea <char style="nd">Awurade</char> se ni,</para>
  <para style="q2" vid="MIC 2:3">“Meredwene amanehunu a etia saa nkurɔfo yi ho</para>
  <para style="q1" vid="MIC 2:3">na worentumi nyi wo ho mfi mu.</para>
  <para style="q2" vid="MIC 2:3">Worentumi nnantew ahantan so bio,</para>
  <para style="q2" vid="MIC 2:3">efisɛ ɛbɛyɛ bere bɔne.<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>Saa da no, nnipa bɛserew mo.</para>
  <para style="q2" vid="MIC 2:4">Wɔde saa awerɛhow dwom yi</para>
  <para style="q1" vid="MIC 2:4">bedi mo ho fɛw se:</para>
  <para style="q2" vid="MIC 2:4">‘wɔasɛe yɛn koraa;</para>
  <para style="q1" vid="MIC 2:4">wɔakyekyɛ me nkurɔfo ahode mu.</para>
  <para style="q2" vid="MIC 2:4">Ogye fi me nsam!</para>
  <para style="q2" vid="MIC 2:4">Na ɔde yɛn mfuw ma akɔnkɔnsafo.’ ”<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>Enti morennya obi wɔ</para>
  <para style="q2" vid="MIC 2:5">
    <char style="nd">Awurade</char> asafo mu</para>
  <para style="q1" vid="MIC 2:5">a ɔde ntontobɔ bɛkyɛ asase no.<verse eid="MIC 2:5"/></para>
  <para style="s1">Atoro Adiyifo</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>“Monnhyɛ nkɔm,” saa na wɔn nkɔmhyɛfo no ka.</para>
  <para style="q2" vid="MIC 2:6">“Monnhyɛ saa nneɛma yi ho nkɔm;</para>
  <para style="q2" vid="MIC 2:6">animguase rento yɛn.”<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>Mo Yakobfi, so wɔnka se,</para>
  <para style="q2" vid="MIC 2:7">“<char style="nd">Awurade</char> Honhom nni boasetɔ ana?</para>
  <para style="q2" vid="MIC 2:7">Ɔyɛ nneɛma a ɛte sɛɛ ana?</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">“Ne nsɛm nyɛ nea nʼakwan teɛ</para>
  <para style="q2" vid="MIC 2:7">no yiye ana?<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>Akyiri no me nkurɔfo asɔre</para>
  <para style="q2" vid="MIC 2:8">te sɛ ɔtamfo.</para>
  <para style="q1" vid="MIC 2:8">Moworɔw ntade pa fi</para>
  <para style="q2" vid="MIC 2:8">wɔn a wɔretwa mu a ɛmfa mo ho,</para>
  <para style="q2" vid="MIC 2:8">ma wɔyɛ te sɛ asraafo a wofi akono.<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>Mopam mmea a wɔwɔ me nkurɔfo mu</para>
  <para style="q2" vid="MIC 2:9">fi wɔn afi afɛɛfɛ mu.</para>
  <para style="q1" vid="MIC 2:9">Mugye me nhyira</para>
  <para style="q2" vid="MIC 2:9">fi wɔn mma nsam afebɔɔ.<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>Sɔre, fi ha kɔ!</para>
  <para style="q2" vid="MIC 2:10">Ha nyɛ faako a wɔhome,</para>
  <para style="q1" vid="MIC 2:10">efisɛ ho agu fi,</para>
  <para style="q2" vid="MIC 2:10">Wɔasɛe no, na ɛrenyɛ yiye bio.<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>Sɛ ɔtorofo ne ɔdaadaafo ba bɛka se,</para>
  <para style="q2" vid="MIC 2:11">‘Mɛhyɛ nkɔm ama moanya nsa bebree a’</para>
  <para style="q2" vid="MIC 2:11">ɔbɛyɛ odiyifo a saa nkurɔfo yi pɛ.”<verse eid="MIC 2:11"/></para>
  <para style="s1">Ogye Ho Bɔhyɛ</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>“Mɛboaboa mo nyinaa ano Yakob;</para>
  <para style="q2" vid="MIC 2:12">nokware mɛka Israel nkae no nyinaa abɔ mu.</para>
  <para style="q1" vid="MIC 2:12">Mɛka wɔn abɔ mu te sɛ nguan a wogu nguannan mu,</para>
  <para style="q2" vid="MIC 2:12">te sɛ nguankuw a wɔwɔ adidibea;</para>
  <para style="q2" vid="MIC 2:12">nnipa bɛhyɛ beae hɔ manyamanya.<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>Nea obue ɔkwan no bedi wɔn anim;</para>
  <para style="q2" vid="MIC 2:13">wobebu apon no na wɔafi akɔ.</para>
  <para style="q1" vid="MIC 2:13">Wɔn Hene no bɛsen adi wɔn anim,</para>
  <para style="q2" vid="MIC 2:13">
    <char style="nd">Awurade</char> bɛyɛ wɔn ti.”<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">Akannifo Ne Adiyifo Animka</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>Afei mekae se,</para>
  <para style="q1" vid="MIC 3:1">“Muntie, mo Yakob akannifo,</para>
  <para style="q2" vid="MIC 3:1">mo a mudi Israelfi so.</para>
  <para style="q1" vid="MIC 3:1">Ɛsɛ sɛ muhu nea ɛyɛ atɛntrenee,<verse eid="MIC 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2"/>Mo a mukyi nea eye na modɔ bɔne</para>
  <para style="q1" vid="MIC 3:2">moworɔw me nkurɔfo were</para>
  <para style="q2" vid="MIC 3:2">na motetew nam no fi wɔn nnompe ho;<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>mowe me nkurɔfo nam,</para>
  <para style="q2" vid="MIC 3:3">mowae wɔn were,</para>
  <para style="q2" vid="MIC 3:3">bubu wɔn nnompe mu nketenkete;</para>
  <para style="q1" vid="MIC 3:3">mutwitwa wɔn sɛ nam a</para>
  <para style="q2" vid="MIC 3:3">mode regu kutu mu.”<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>Afei wobesu afrɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 3:4">nanso ɔrennye wɔn so.</para>
  <para style="q1" vid="MIC 3:4">Saa bere no ɔde nʼanim besie wɔn,</para>
  <para style="q2" vid="MIC 3:4">bɔne a wɔayɛ nti.<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>Nea <char style="nd">Awurade</char> se ni:</para>
  <para style="q1" vid="MIC 3:5">“Adiyifo a</para>
  <para style="q2" vid="MIC 3:5">wɔdaadaa me nkurɔfo no de,</para>
  <para style="q1" vid="MIC 3:5">obi ma wɔn biribi di a</para>
  <para style="q2" vid="MIC 3:5">wɔpae mu ka asomdwoe nsɛm,</para>
  <para style="q1" vid="MIC 3:5">na sɛ wɔamma wɔn biribi anni a,</para>
  <para style="q2" vid="MIC 3:5">adiyifo no siesie wɔn ho sɛ wobetu wɔn so sa.<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>Enti ade bɛsa mo a morennya adaeso,</para>
  <para style="q2" vid="MIC 3:6">sum beduru mo a morennya ahintasɛm biara.</para>
  <para style="q1" vid="MIC 3:6">Owia bɛtɔ ama adiyifo no,</para>
  <para style="q2" vid="MIC 3:6">na adekyee bɛdan sum ama wɔn.<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>Adehufo ani bewu</para>
  <para style="q2" vid="MIC 3:7">na wobegu asamanfrɛfo anim ase.</para>
  <para style="q1" vid="MIC 3:7">Wɔn nyinaa bɛkatakata wɔn anim,</para>
  <para style="q2" vid="MIC 3:7">efisɛ mmuae biara mfi Onyankopɔn hɔ mma.”<verse eid="MIC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>Nanso me de, tumi ahyɛ me ma,</para>
  <para style="q2" vid="MIC 3:8">
    <char style="nd">Awurade</char> Honhom ahyɛ me ma</para>
  <para style="q1" vid="MIC 3:8">trenee ne ahoɔden</para>
  <para style="q2" vid="MIC 3:8">a mede bɛpae mu aka</para>
  <para style="q1" vid="MIC 3:8">Yakob amumɔyɛ ne Israel bɔne.<verse eid="MIC 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>Muntie, mo Yakobfi akannifo,</para>
  <para style="q2" vid="MIC 3:9">mo a mudi Israel so,</para>
  <para style="q1" vid="MIC 3:9">a mukyi atɛntrenee</para>
  <para style="q2" vid="MIC 3:9">na mokyea nea ɛteɛ nyinaa;<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>Mo a mode mogyahwiegu kyekyeree Sion</para>
  <para style="q2" vid="MIC 3:10">ne awurukasɛm kyekyeree Yerusalem.<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>Nʼakannifo no gye adanmude ansa na wobu atɛn,</para>
  <para style="q2" vid="MIC 3:11">nʼasɔfo gye sika ansa na wɔakyerɛkyerɛ,</para>
  <para style="q1" vid="MIC 3:11">nʼadiyifo de nkɔmhyɛ ayɛ sikapɛ.</para>
  <para style="q2" vid="MIC 3:11">Nanso wɔdan <char style="nd">Awurade</char>, na wɔka se,</para>
  <para style="q1" vid="MIC 3:11">“<char style="nd">Awurade</char> nni yɛn ntam ana?</para>
  <para style="q2" vid="MIC 3:11">Ɔhaw biara remma yɛn so.”<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>Na mo nti,</para>
  <para style="q2" vid="MIC 3:12">wobefuntum Sion te sɛ afuw,</para>
  <para style="q1" vid="MIC 3:12">Yerusalem bɛyɛ nnwiriwii siw,</para>
  <para style="q2" vid="MIC 3:12">na asɔredan no pampa bɛyɛ nkɔmoa so nkyɛkyerɛ.<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">
    <char style="nd">Awurade</char> Bepɔw No</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>Nna a edi akyi no mu no,</para>
  <para style="q1" vid="MIC 4:1">
    <char style="nd">Awurade</char> asɔredan bepɔw no betim</para>
  <para style="q2" vid="MIC 4:1">sɛ mmepɔw no nyinaa ti;</para>
  <para style="q1" vid="MIC 4:1">ebegye din aboro nkoko nyinaa,</para>
  <para style="q2" vid="MIC 4:1">na nnipa ahorow bɛbɔ yuu akɔ hɔ.<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>Aman bebree bɛba abɛka se,</para>
  <para style="q1" vid="MIC 4:2">“Mommra mma yɛnkɔ <char style="nd">Awurade</char> bepɔw no so,</para>
  <para style="q2" vid="MIC 4:2">nkɔ Yakob Nyankopɔn fi.</para>
  <para style="q1" vid="MIC 4:2">Ɔbɛkyerɛkyerɛ yɛn nʼakwan</para>
  <para style="q2" vid="MIC 4:2">sɛnea ɛbɛyɛ a yɛbɛnantew nʼatempɔn so.”</para>
  <para style="q1" vid="MIC 4:2">Mmara no befi Sion aba,</para>
  <para style="q2" vid="MIC 4:2">na <char style="nd">Awurade</char> asɛm afi Yerusalem.<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>Obebu amanaman ntam atɛn</para>
  <para style="q2" vid="MIC 4:3">na obesiesie nnipa bebree ntam asɛm.</para>
  <para style="q1" vid="MIC 4:3">Wɔde wɔn afoa bɛbobɔ nsɔw</para>
  <para style="q2" vid="MIC 4:3">na wɔde wɔn mpeaw ayɛ asosɔw.</para>
  <para style="q1" vid="MIC 4:3">Ɔman bi rentwe ɔman foforo so afoa,</para>
  <para style="q2" vid="MIC 4:3">na wɔrenyɛ ahoboa biara mma ɔko bio.<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>Obiara bɛtena ne bobe</para>
  <para style="q2" vid="MIC 4:4">anaa ne borɔdɔma nnua ase,</para>
  <para style="q1" vid="MIC 4:4">na obiara remmehunahuna wɔn,</para>
  <para style="q2" vid="MIC 4:4">efisɛ, Asafo <char style="nd">Awurade</char> akasa.<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>Amanaman no nyinaa betumi anantew</para>
  <para style="q2" vid="MIC 4:5">wɔn anyame din mu,</para>
  <para style="q1" vid="MIC 4:5">na yɛn de, yɛbɛnantew <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 4:5">yɛn Nyankopɔn Din mu daa daa.<verse eid="MIC 4:5"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Atirimpɔw</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>“Saa da no,” sɛnea <char style="nd">Awurade</char> se ni,</para>
  <para style="q2" vid="MIC 4:6">“Mɛboaboa mmubuafo, atukɔfo</para>
  <para style="q2" vid="MIC 4:6">ɛne wɔn a mede awerɛhow aba wɔn so ano.<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>Mɛma mmubuafo ayɛ me nkurɔfo wɔ asase no so,</para>
  <para style="q2" vid="MIC 4:7">atukɔfo no bɛyɛ ɔman kɛse.</para>
  <para style="q1" vid="MIC 4:7">
    <char style="nd">Awurade</char> bedi wɔn so hene wɔ Sion bepɔw so</para>
  <para style="q2" vid="MIC 4:7">afi da no akosi daa.<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>Na wo, nguankuw no abantenten,</para>
  <para style="q2" vid="MIC 4:8">Ɔbabea Sion, abandennen,</para>
  <para style="q1" vid="MIC 4:8">wɔde wo tete tumidi no bɛsan abrɛ wo;</para>
  <para style="q2" vid="MIC 4:8">Ɔbabea Yerusalem nsa bɛsan aka nʼahenni.”<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>Adɛn nti na afei woresu dennen,</para>
  <para style="q2" vid="MIC 4:9">wunni ɔhene ana?</para>
  <para style="q1" vid="MIC 4:9">Wo futufo ayera, na enti</para>
  <para style="q2" vid="MIC 4:9">ɔyaw aka wo sɛ ɔbea a ɔwɔ awoko mu?<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>Bukabukaw wo mu wɔ yawdi mu, Ɔbabea Sion,</para>
  <para style="q2" vid="MIC 4:10">te sɛ ɔbea a awo aka no,</para>
  <para style="q1" vid="MIC 4:10">mprempren ɛsɛ sɛ wufi kuropɔn no mu</para>
  <para style="q2" vid="MIC 4:10">kɔtena sare so.</para>
  <para style="q1" vid="MIC 4:10">Wobɛkɔ Babilonia;</para>
  <para style="q2" vid="MIC 4:10">na hɔ na wobegye wo.</para>
  <para style="q1" vid="MIC 4:10">Ɛhɔ na <char style="nd">Awurade</char> begye wo</para>
  <para style="q2" vid="MIC 4:10">afi wʼatamfo nsam.<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>Mprempren de, aman bebree aka abɔ mu atia wo.</para>
  <para style="q2" vid="MIC 4:11">Wɔka se, “Wongu Sion ho fi,</para>
  <para style="q1" vid="MIC 4:11">na yɛmfa yɛn ani nhwɛ no!”<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>Nanso wonnim <char style="nd">Awurade</char> adwene.</para>
  <para style="q2" vid="MIC 4:12">Wɔnte nʼagyinatu ase.</para>
  <para style="q1" vid="MIC 4:12">Wonnim sɛ ɔno na ɔboaboa wɔn ano te sɛ afiafi</para>
  <para style="q2" vid="MIC 4:12">de kɔ awiporowbea.<verse eid="MIC 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>“Sɔre, na porow, Ɔbabea Sion,</para>
  <para style="q2" vid="MIC 4:13">mɛma wo dade mmɛn;</para>
  <para style="q1" vid="MIC 4:13">mɛma wo kɔbere tɔte</para>
  <para style="q2" vid="MIC 4:13">na wubebubu aman bebree mu nketenkete.”</para>
  <para style="q1" vid="MIC 4:13">Wode wɔn mfaso a wɔampɛ no ɔkwan pa so bɛbrɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 4:13">wode wɔn ahonyade bɛbrɛ asase nyinaa so wura.<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">Bɔhyɛhene Bi A Ofi Betlehem</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>Mommoaboa mo asraafo ano,</para>
  <para style="q2" vid="MIC 5:1">akofo kuropɔn,</para>
  <para style="q1" vid="MIC 5:1">efisɛ atamfo atwa yɛn ho ahyia.</para>
  <para style="q2" vid="MIC 5:1">Wɔde abaa bɛbɔ nea odi Israel so no wɔ nʼafono so.<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>“Nanso wo, Betlehem Efrata,</para>
  <para style="q2" vid="MIC 5:2">ɛwɔ mu sɛ woyɛ ketewa wɔ Yuda mmusua mu de,</para>
  <para style="q1" vid="MIC 5:2">nanso wo mu na obi befi ama me</para>
  <para style="q2" vid="MIC 5:2">a obedi Israel so,</para>
  <para style="q2" vid="MIC 5:2">na nʼase fi teteete.”<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>Enti wobɛto Israelfo paahwii,</para>
  <para style="q2" vid="MIC 5:3">kosi sɛ ɔbea a awo aka no no bɛwo</para>
  <para style="q1" vid="MIC 5:3">na ne nuanom mmarima nkae</para>
  <para style="q2" vid="MIC 5:3">bɛsan akɔka Israelfo ho.<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>Ɔbɛsɔre ahwɛ ne nguankuw</para>
  <para style="q2" vid="MIC 5:4">wɔ <char style="nd">Awurade</char> ahoɔden mu,</para>
  <para style="q2" vid="MIC 5:4">wɔ <char style="nd">Awurade</char> ne Nyankopɔn din kɛseyɛ mu.</para>
  <para style="q1" vid="MIC 5:4">Na wɔbɛtena asomdwoe mu, na afei</para>
  <para style="q2" vid="MIC 5:4">ne kɛseyɛ bedu asase awiei.<verse eid="MIC 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>Na ɔbɛyɛ wɔn asomdwoe.</para>
  <para style="q1" vid="MIC 5:5">Sɛ Asiriafo bɛtow ahyɛ yɛn asase so,</para>
  <para style="q2" vid="MIC 5:5">na wɔbɔ nsra fa yɛn aban mu a,</para>
  <para style="q1" vid="MIC 5:5">yɛde nguanhwɛfo baason,</para>
  <para style="q2" vid="MIC 5:5">mpo asahene baawɔtwe behyia wɔn.<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>Wɔde afoa bedi Asiria asase so,</para>
  <para style="q2" vid="MIC 5:6">wɔbɛtwe afoa de adi Nimrod asase so.</para>
  <para style="q1" vid="MIC 5:6">Sɛ Asiriafo tow hyɛ yɛn so,</para>
  <para style="q2" vid="MIC 5:6">bɔ nsra fa yɛn ahye so a,</para>
  <para style="q2" vid="MIC 5:6">obegye yɛn afi wɔn nsam.<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>Yakob asefo nkae no</para>
  <para style="q2" vid="MIC 5:7">bɛfrafra nnipa bebree mu</para>
  <para style="q1" vid="MIC 5:7">te sɛ obosu a efi <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 5:7">te sɛ osu a ɛpete gu sare so</para>
  <para style="q1" vid="MIC 5:7">a ɛntwɛn ɔdesani,</para>
  <para style="q2" vid="MIC 5:7">na ɔdesani biara rentumi nsiw ho kwan.<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>Wɔbɛkan Yakob asefo nkae no afra aman no mu,</para>
  <para style="q2" vid="MIC 5:8">wɔbɛfrafra nnipa bebree mu</para>
  <para style="q1" vid="MIC 5:8">te sɛ gyata a ɔfra mmoa mu wɔ kwae mu,</para>
  <para style="q2" vid="MIC 5:8">te sɛ gyata ba a ɔfra nguankuw mu</para>
  <para style="q1" vid="MIC 5:8">a ɔbobɔ wɔn tetew wɔn mu</para>
  <para style="q2" vid="MIC 5:8">na obiara ntumi nnye wɔn.<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>Wɔbɛma wo nsa so sɛ woadi wʼatamfo so nkonim,</para>
  <para style="q2" vid="MIC 5:9">na wɔbɛsɛe wʼatamfo nyinaa.<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>“Saa da no,” sɛnea <char style="nd">Awurade</char> se ni,</para>
  <para style="q1" vid="MIC 5:10">“Mɛsɛe apɔnkɔ a wowɔ</para>
  <para style="q2" vid="MIC 5:10">na mabubu wo nteaseɛnam.<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>Mɛsɛe nkuropɔn a ɛwɔ wʼasase so</para>
  <para style="q2" vid="MIC 5:11">na madwiriw wo bammɔ dennen nyinaa agu.<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>Mɛsɛe wʼabayisɛm</para>
  <para style="q2" vid="MIC 5:12">na wo ntafowayi to betwa.<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>Mɛsɛe nsɛsode a wode wo nsa ayɛ</para>
  <para style="q2" vid="MIC 5:13">ne abo ahoni a wowɔ no,</para>
  <para style="q1" vid="MIC 5:13">na worenkotow nsɔre</para>
  <para style="q2" vid="MIC 5:13">wo nsa ano adwuma bio.<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>Metutu Asera abosomnnua no afi wo mu</para>
  <para style="q2" vid="MIC 5:14">na masɛe wo nkuropɔn.<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>Aman a wɔantie mʼasɛm no nyinaa,</para>
  <para style="q2" vid="MIC 5:15">mede abufuw ne abufuwhyew bɛtɔ wɔn so were.”<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">
    <char style="nd">Awurade</char> Sobo A Ɔbɔ Israel</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>Muntie asɛm a <char style="nd">Awurade</char> reka:</para>
  <para style="q1" vid="MIC 6:1">“Monsɔre na mommɔ mo nkuro wɔ mmepɔw no anim;</para>
  <para style="q2" vid="MIC 6:1">momma nkoko nte nea mowɔ ka.<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>“Na afei, mmepɔw, muntie <char style="nd">Awurade</char> sobo;</para>
  <para style="q2" vid="MIC 6:2">tie, asase nnyinaso a ɛwɔ hɔ daa.</para>
  <para style="q1" vid="MIC 6:2">Na <char style="nd">Awurade</char> wɔ asɛm a etia ne nkurɔfo;</para>
  <para style="q2" vid="MIC 6:2">ɔrebɔ Israel sobo.<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>“Me nkurɔfo, dɛn na mayɛ mo?</para>
  <para style="q2" vid="MIC 6:3">Mede adesoa bi asoa mo? Mummua me!<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>Miyii mo fii Misraim</para>
  <para style="q2" vid="MIC 6:4">migyee mo fii nkoasom asase so.</para>
  <para style="q1" vid="MIC 6:4">Mesomaa Mose bedii mo anim,</para>
  <para style="q2" vid="MIC 6:4">Aaron ne Miriam nso.<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>Me nkurɔfo, monkae</para>
  <para style="q2" vid="MIC 6:5">afotu a Moabhene Balak mae</para>
  <para style="q2" vid="MIC 6:5">ne mmuae a Beor babarima Balaam mae.</para>
  <para style="q1" vid="MIC 6:5">Monkae mo kwan a mutu fii Sitim kɔɔ Gilgal,</para>
  <para style="q2" vid="MIC 6:5">na munhu <char style="nd">Awurade</char> akwantrenee.”<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>Dɛn na memfa mmra <char style="nd">Awurade</char> anim</para>
  <para style="q2" vid="MIC 6:6">mmɛkotow ɔsorosoro Onyankopɔn no?</para>
  <para style="q1" vid="MIC 6:6">Memfa nantwimma a wadi afe</para>
  <para style="q2" vid="MIC 6:6">mmɛbɔ ɔhyew afɔre wɔ nʼanim ana?<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>
    <char style="nd">Awurade</char> ani bɛsɔ adwennini mpempem</para>
  <para style="q2" vid="MIC 6:7">ne ngodua mu ngo asuten mpem du ana?</para>
  <para style="q1" vid="MIC 6:7">Memfa mʼabakan mmɔ me bɔne ho afɔre,</para>
  <para style="q2" vid="MIC 6:7">anaa me yafunumma, me kra bɔne nti?<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>Ɔde nea eye akyerɛ wo, Ao onipa.</para>
  <para style="q2" vid="MIC 6:8">Na dɛn na <char style="nd">Awurade</char> hwehwɛ afi wo hɔ?</para>
  <para style="q1" vid="MIC 6:8">Yɛ adetrenee ne mmɔborɔhunu,</para>
  <para style="q2" vid="MIC 6:8">na wo ne wo Nyankopɔn nnantew ahobrɛase mu.<verse eid="MIC 6:8"/></para>
  <para style="s1">Israel Afɔdi Ne Asotwe</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>Muntie! <char style="nd">Awurade</char> refrɛ kuropɔn no,</para>
  <para style="q2" vid="MIC 6:9">Wo din suro yɛ nyansahu,</para>
  <para style="q2" vid="MIC 6:9">“Muntie abaa no ne nea Ɔmaa no tumi no.<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>Mo amumɔyɛfo, menkɔ so mma me werɛ mfi mo ahonya a monam asisi so apɛ,</para>
  <para style="q2" vid="MIC 6:10">ne nkontompo susukoraa a ɛde nnome ba no ana?<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>Minnyae onipa a okura nsania a wɔamia mu,</para>
  <para style="q2" vid="MIC 6:11">ne asisi nkaribo</para>
  <para style="q2" vid="MIC 6:11">na ɔmfa ne ho nni ana?<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>Adefo a wɔwɔ mo mu no di akakabensɛm;</para>
  <para style="q2" vid="MIC 6:12">mo nkurɔfo no yɛ atorofo</para>
  <para style="q1" vid="MIC 6:12">na wɔn tɛkrɛma ka nnaadaasɛm.<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>Ɛno nti, mafi ase resɛe mo,</para>
  <para style="q2" vid="MIC 6:13">Mo bɔne ahorow nti, mɛsɛe mo.<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>Mubedidi, nanso moremmee;</para>
  <para style="q2" vid="MIC 6:14">ɔkɔm bɛkɔ so ade mo.</para>
  <para style="q1" vid="MIC 6:14">Mobɛboaboa ano, nanso ɛrenkosi hwee,</para>
  <para style="q2" vid="MIC 6:14">efisɛ mede nea moakora no bɛma afoa.<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>Mubedua nanso morentwa.</para>
  <para style="q2" vid="MIC 6:15">Mubekyi ngodua mu ngo, nanso morensra bi,</para>
  <para style="q2" vid="MIC 6:15">mubetiatia bobe so, nanso morennom nsa a mubenya afi mu no bi.<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>Moadi Omri mmara so.</para>
  <para style="q2" vid="MIC 6:16">Moayɛ nea wɔyɛɛ wɔ Ahab fi.</para>
  <para style="q2" vid="MIC 6:16">Moasua wɔn nneyɛe no bi,</para>
  <para style="q1" vid="MIC 6:16">ɛno nti mɛma ɔsɛe aba mo so.</para>
  <para style="q2" vid="MIC 6:16">Wɔbɛserew mo nkurɔfo;</para>
  <para style="q2" vid="MIC 6:16">na amanaman bebu mo animtiaa.”<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">Israel Ahohia</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>Mayɛ mmɔbɔ!</para>
  <para style="q1" vid="MIC 7:1">Mete sɛ otwabere nnuaba tasefo a</para>
  <para style="q2" vid="MIC 7:1">otwabere akyi mikodi mpɛpɛ wɔ bobeturo mu;</para>
  <para style="q1" vid="MIC 7:1">minnya bobe kasiaw na madi,</para>
  <para style="q2" vid="MIC 7:1">borɔdɔma aba a edi kan a mekɔn dɔ nso, saa ara.<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>Wɔapra Onyamefɛrefo nyinaa afi asase so.</para>
  <para style="q2" vid="MIC 7:2">Anka ɔbaako a ɔteɛ mpo.</para>
  <para style="q1" vid="MIC 7:2">Nnipa nyinaa tetɛw na wɔhwehwɛ sɛ wɔbɛka mogya agu;</para>
  <para style="q2" vid="MIC 7:2">wɔde ɔtan sunsum wɔn ho wɔn ho mfiri.<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>Nsa abien no nyinaa akokwaw bɔneyɛ mu;</para>
  <para style="q2" vid="MIC 7:3">ɔsodifo bisa akyɛde,</para>
  <para style="q1" vid="MIC 7:3">otemmufo gye adanmude,</para>
  <para style="q2" vid="MIC 7:3">wɔn a tumi wɔ wɔn nsa mu no yɛ nea wɔpɛ,</para>
  <para style="q2" vid="MIC 7:3">wɔn nyinaa bɔ mu dwene amumɔyɛ ho.<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>Nea oye wɔ wɔn mu no te sɛ ohwirem;</para>
  <para style="q2" vid="MIC 7:4">nea ɔteɛ pa ara no, nsɔeban ye sen no.</para>
  <para style="q1" vid="MIC 7:4">Wʼatemmuda no aso,</para>
  <para style="q2" vid="MIC 7:4">da a Onyankopɔn reba wo nsrahwɛ.</para>
  <para style="q2" vid="MIC 7:4">Eyi ne bere a wɔn ani so bɛyɛ wɔn totɔtotɔ.<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>Nnye obiara nni;</para>
  <para style="q2" vid="MIC 7:5">mfa wo werɛ nhyɛ adamfo mu.</para>
  <para style="q1" vid="MIC 7:5">Mpo, ɔbea a ɔda wo koko mu no</para>
  <para style="q2" vid="MIC 7:5">to wo tɛkrɛma nnareka wɔ ne ho.<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>Ɔbabarima twiri nʼagya,</para>
  <para style="q2" vid="MIC 7:6">Ɔbabea sɔre tia ne na,</para>
  <para style="q1" vid="MIC 7:6">asebea nso tia nʼase</para>
  <para style="q2" vid="MIC 7:6">onipa atamfo ne nʼankasa ne fifo.<verse eid="MIC 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>Me de, mede anidaso hwɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="MIC 7:7">Metwɛn me Nkwagye Nyankopɔn;</para>
  <para style="q2" vid="MIC 7:7">na me Nyankopɔn betie me.<verse eid="MIC 7:7"/></para>
  <para style="s1">Israel Bɛsɔre</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>Mma wʼani nnye, me tamfo!</para>
  <para style="q2" vid="MIC 7:8">Mahwe ase de, nanso mɛsɔre.</para>
  <para style="q1" vid="MIC 7:8">Sum aduru me de,</para>
  <para style="q2" vid="MIC 7:8">nanso <char style="nd">Awurade</char> bɛyɛ me hann.<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>Sɛ mayɛ bɔne atia no nti,</para>
  <para style="q2" vid="MIC 7:9">
    <char style="nd">Awurade</char> abufuw bɛba me so,</para>
  <para style="q1" vid="MIC 7:9">kosi sɛ ɔbɛka mʼasɛm ama me</para>
  <para style="q2" vid="MIC 7:9">na wada me bembu adi.</para>
  <para style="q1" vid="MIC 7:9">Ɔde me bɛba hann no mu;</para>
  <para style="q2" vid="MIC 7:9">na mehu ne trenee.<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>Afei, mʼatamfo behu</para>
  <para style="q2" vid="MIC 7:10">na wɔn ani bewu,</para>
  <para style="q1" vid="MIC 7:10">nea osee me sɛ,</para>
  <para style="q2" vid="MIC 7:10">“Ɛhe na <char style="nd">Awurade</char> wo Nyankopɔn no wɔ?”</para>
  <para style="q1" vid="MIC 7:10">Mʼani behu nʼasehwe;</para>
  <para style="q2" vid="MIC 7:10">mpo mprempren no, wobetiatia no so</para>
  <para style="q2" vid="MIC 7:10">te sɛ dontori a ɛwɔ mmɔnten so.<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>Da a wɔbɛto wʼafasu no bɛba,</para>
  <para style="q2" vid="MIC 7:11">da a wɔbɛtrɛw wʼahye mu.<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>Da no, nnipa bɛba wo nkyɛn</para>
  <para style="q2" vid="MIC 7:12">afi Asiria ne Misraim nkuropɔn mu,</para>
  <para style="q1" vid="MIC 7:12">mpo wobefi Misraim akosi Eufrate</para>
  <para style="q2" vid="MIC 7:12">afi po akosi po</para>
  <para style="q2" vid="MIC 7:12">ne bepɔw so akosi bepɔw so.<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>Asase no bɛyɛ amamfo, esiane nnipa a wɔtete so</para>
  <para style="q2" vid="MIC 7:13">ne wɔn nneyɛe nti.<verse eid="MIC 7:13"/></para>
  <para style="s1">Mpaebɔ Ne Nkamfo</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>Fa wo pema di wo nkurɔfo anim,</para>
  <para style="q2" vid="MIC 7:14">nguan a wɔyɛ wʼagyapade no,</para>
  <para style="q1" vid="MIC 7:14">a wɔn nko ara tete kwae mu,</para>
  <para style="q2" vid="MIC 7:14">wura frɔmfrɔm adidibea hɔ.</para>
  <para style="q1" vid="MIC 7:14">Ma wonnidi wɔ Basan ne Gilead</para>
  <para style="q2" vid="MIC 7:14">sɛ tete nna no mu.<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>“Mɛyɛ anwonwade akyerɛ wo,</para>
  <para style="q2" vid="MIC 7:15">sɛnea meyɛɛ nna a wufi Misraim bae mu no.”<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>Aman behu wo na wɔn ani bewu,</para>
  <para style="q2" vid="MIC 7:16">wɔn a tumi nyinaa afi wɔn nsa no.</para>
  <para style="q1" vid="MIC 7:16">Wɔde wɔn nsa betuatua wɔn ano</para>
  <para style="q2" vid="MIC 7:16">na wɔn aso besisiw.<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>Wobedi dɔte sɛ awɔ,</para>
  <para style="q2" vid="MIC 7:17">ne mmoa a wɔwea wɔ fam.</para>
  <para style="q1" vid="MIC 7:17">Wɔde ahopopo befi wɔn abon mu aba;</para>
  <para style="q2" vid="MIC 7:17">wɔde osuro bɛdan wɔn ho ama <char style="nd">Awurade</char> yɛn Nyankopɔn,</para>
  <para style="q2" vid="MIC 7:17">na wobesuro wo.<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>Hena na ɔte sɛ wo,</para>
  <para style="q2" vid="MIC 7:18">Onyankopɔn a wode bɔne kyɛ?</para>
  <para style="q1" vid="MIC 7:18">Wo a wode agyanom asefo nkae amumɔyɛ kyɛ wɔn.</para>
  <para style="q2" vid="MIC 7:18">Wʼabufuw ntena hɔ daa,</para>
  <para style="q2" vid="MIC 7:18">na mmom wʼani gye sɛ wobɛda mmɔborɔhunu adi.<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>Wubehu yɛn mmɔbɔ bio,</para>
  <para style="q2" vid="MIC 7:19">wubetiatia yɛn bɔne so,</para>
  <para style="q2" vid="MIC 7:19">na woatow yɛn amumɔyɛ agu po bun mu.<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>Wobɛyɛ ɔnokwafo ama Yakob</para>
  <para style="q2" vid="MIC 7:20">na woahu Abraham mmɔbɔ</para>
  <para style="q1" vid="MIC 7:20">sɛnea wokaa yɛn agyanom ntam</para>
  <para style="q2" vid="MIC 7:20">teteete no.<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
