<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">4 Mose (Numeri)</para>
  <para style="toc1">Mose Nhoma A Ɛto So Anan (Numeri)</para>
  <para style="toc2">4 Mose</para>
  <para style="toc3">4 Mose</para>
  <para style="mt1">Mose Nhoma A Ɛto So Anan</para>
  <para style="mt4">Anaasɛ</para>
  <para style="mt3">Numeri</para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="s1">Nnipakan</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>
    <char style="nd">Awurade</char> kasa kyerɛɛ Mose wɔ Ahyiae Ntamadan a ɛwɔ Sinai nweatam so. Eyi sii wɔ mfe abien a Israelfo fii Misraim no akyi, ɔsram a ɛto so abien no da a edi kan. Ɔkae se: <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>“Gyina Israelfo no mmusuakuw ne wɔn mmusua so kan wɔn nyinaa. Kyerɛw ɔbarima biara din. <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>Wo ne Aaron na mobɛkan mmarima a wɔadi mfe aduonu no ne nea ɛboro saa a wotumi kɔ ɔsa. <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>Ɔbarima a ofi abusuakuw biara mu a ɔyɛ ntuanoni na ɛsɛ sɛ ɔboa mo.<verse eid="NUM 1:4"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="5" style="v" sid="NUM 1:5"/>“Mmarima a wɔbɛboa mo no din ni:</para>
  <para style="b" vid="NUM 1:5"/>
  <para style="li1" vid="NUM 1:5">“Ruben abusuakuw no ntuanoni ne Sedeur babarima Elisur;<verse eid="NUM 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6"/>Simeon abusuakuw no ntuanoni ne Surisadai babarima Selumiel;<verse eid="NUM 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7"/>Yuda abusuakuw no ntuanoni ne Aminadab babarima Nahson;<verse eid="NUM 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8"/>Isakar abusuakuw no ntuanoni ne Suar babarima Netanel;<verse eid="NUM 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9"/>Sebulon abusuakuw no ntuanoni ne Helon babarima Eliab;<verse eid="NUM 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10"/>Yosef mmabarima no:</para>
  <para style="li2" vid="NUM 1:10">Efraim abusuakuw no ntuanoni ne Amihud babarima Elisama;</para>
  <para style="li2" vid="NUM 1:10">Manase abusuakuw no ntuanoni ne Pedahsur babarima Gamaliel;<verse eid="NUM 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11"/>Benyamin abusuakuw ntuanoni ne Gideoni babarima Abidan;<verse eid="NUM 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12"/>Dan abusuakuw ntuanoni ne Amisadai babarima Ahieser;<verse eid="NUM 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13"/>Aser abusuakuw ntuanoni ne Okran babarima Pagiel;<verse eid="NUM 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14"/>Gad abusuakuw ntuanoni ne Deguel babarima Eliasaf;<verse eid="NUM 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15"/>Naftali abusuakuw ntuanoni ne Enan babarima Ahira.”<verse eid="NUM 1:15"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="16" style="v" sid="NUM 1:16"/>Eyinom ne mmarima a woyii wɔn fii nnipa no mu, a wɔyɛ wɔn agyanom mmusua no ntuanofo.<verse eid="NUM 1:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>Mose ne Aaron faa saa nnipa a wɔabobɔ wɔn din yi, <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>na da a edi kan wɔ ɔsram a ɛto so abien no mu no, wɔfrɛɛ ɔmanfo no nyinaa. Nnipa no nam wɔn mmusuakuw ne wɔn mmusua so kyerɛɛ wɔn anato na wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa no din mmaako mmaako, <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no. Enti ɔkan wɔn wɔ Sinai sare so.<verse eid="NUM 1:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20"/>Ruben a ɔyɛ Israel abakan asefo:</para>
  <para style="li2" vid="NUM 1:20">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wotumi kɔ ɔsa no, wɔkyerɛw wɔn din mmaako mmaako sɛnea wɔn mmusua te. <verse eid="NUM 1:20"/><verse number="21" style="v" sid="NUM 1:21"/>Nnipa dodow a wofi Ruben abusuakuw no mu no yɛ mpem aduanan asia ne ahannum (46,500).<verse eid="NUM 1:21"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22"/>Simeon asefo:</para>
  <para style="li2" vid="NUM 1:22">Mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no, wɔkyerɛw wɔn din mmaako mmaako sɛnea wɔn mmusua te. <verse eid="NUM 1:22"/><verse number="23" style="v" sid="NUM 1:23"/>Nnipa dodow a wofi Simeon abusuakuw no mu no yɛ mpem aduonum akron ne ahaasa (59,300).<verse eid="NUM 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24"/>Gad asefo:</para>
  <para style="li2" vid="NUM 1:24">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:24"/><verse number="25" style="v" sid="NUM 1:25"/>Nnipa dodow a wofi Gad abusuakuw no mu no yɛ mpem aduanan anum ahansia ne aduonum (45,650).<verse eid="NUM 1:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26"/>Yuda asefo:</para>
  <para style="li2" vid="NUM 1:26">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:26"/><verse number="27" style="v" sid="NUM 1:27"/>Nnipa dodow a wofi Yuda abusuakuw no mu no yɛ mpem aduɔson anan ne ahansia (74,600).<verse eid="NUM 1:27"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28"/>Isakar asefo:</para>
  <para style="li2" vid="NUM 1:28">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:28"/><verse number="29" style="v" sid="NUM 1:29"/>Nnipa dodow a wofi Isakar abusuakuw no mu no yɛ mpem aduonum anan ne ahannan (54,400).<verse eid="NUM 1:29"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30"/>Sebulon asefo:</para>
  <para style="li2" vid="NUM 1:30">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:30"/><verse number="31" style="v" sid="NUM 1:31"/>Nnipa dodow a wofi Sebulon abusuakuw no mu no yɛ mpem aduonum ason ne ahannan (57,400).<verse eid="NUM 1:31"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="32" style="v" sid="NUM 1:32"/>Yosef mmabarima no:</para>
  <para style="li1" vid="NUM 1:32">Efraim asefo:</para>
  <para style="li2" vid="NUM 1:32">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:32"/><verse number="33" style="v" sid="NUM 1:33"/>Nnipa dodow a wofi Efraim abusuakuw no mu no yɛ mpem aduanan ne ahannum (40,500).<verse eid="NUM 1:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34"/>Manase asefo:</para>
  <para style="li2" vid="NUM 1:34">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:34"/><verse number="35" style="v" sid="NUM 1:35"/>Nnipa dodow a wofi Manase abusuakuw no mu no yɛ mpem aduasa abien ne ahannu (32,200).<verse eid="NUM 1:35"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36"/>Benyamin asefo:</para>
  <para style="li2" vid="NUM 1:36">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:36"/><verse number="37" style="v" sid="NUM 1:37"/>Nnipa dodow a wofi Benyamin abusuakuw no mu no yɛ mpem aduasa anum ne ahannan (35,400).<verse eid="NUM 1:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38"/>Dan asefo:</para>
  <para style="li2" vid="NUM 1:38">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:38"/><verse number="39" style="v" sid="NUM 1:39"/>Nnipa dodow a wofi Dan abusuakuw no mu no yɛ mpem aduosia abien ne ahanson (62,700).<verse eid="NUM 1:39"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40"/>Aser asefo:</para>
  <para style="li2" vid="NUM 1:40">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:40"/><verse number="41" style="v" sid="NUM 1:41"/>Nnipa dodow a wofi Aser abusuakuw no mu no yɛ mpem aduanan baako ne ahannum (41,000).<verse eid="NUM 1:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42"/>Naftali asefo:</para>
  <para style="li2" vid="NUM 1:42">Wɔkyerɛw mmarima a wɔadi mfe aduonu ne nea ɛboro saa a wobetumi akɔ ɔsa no din sɛnea wɔn mmusua te. <verse eid="NUM 1:42"/><verse number="43" style="v" sid="NUM 1:43"/>Nnipa dodow a wofi Naftali abusuakuw no mu no yɛ mpem aduonum abiɛsa ne ahannan (53,400).<verse eid="NUM 1:43"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="44" style="v" sid="NUM 1:44"/>Eyinom ne mmarima a Mose ne Aaron ne Israel mmusuakuw dumien no ntuanofo kan wɔn. <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>Israelfo a na wɔadi mfe aduonu anaa nea ɛboro saa no a wobetumi adɔm Israel asraafodɔm no nso, wogyinaa wɔn mmusua so kan wɔn. <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>Na wɔn nyinaa dodow yɛ mpem ahansia ne abiɛsa ne ahannum aduonum (603,550).<verse eid="NUM 1:46"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>Mmusua a wɔwɔ Lewi abusuakuw no de, wɔankan wɔn anka wɔn a aka no ho. <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/>Na <char style="nd">Awurade</char> aka akyerɛ Mose se, <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>“Nkan Lewifo abusuakuw no, na mfa wɔn nka Israelfo a wɔaka no ho. <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>Fa Ahyiae Ntamadan no ho dwumadi hyɛ Lewifo no nsa. Wɔnhwɛ nneɛma a wɔde asiesie mu ne nea ɛkeka ho nyinaa so. Wɔn na wɔbɛsoa Ahyiae Ntamadan no ne mu nneɛma, wɔbɛhwɛ so na wɔatenatena ho. <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>Bere biara a ɛsɛ sɛ wotu Ahyiae Ntamadan no, Lewifo no na ɛsɛ sɛ wotutu, na baabiara a wɔde besi no, wɔn na wɔbɛyɛ. Onipa foforo biara a ɔbɛbɛn ho no, wobekum no. <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>Israel abusuakuw biara benya ne tenabea ne ne frankaa. <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>Lewifo no besisi wɔn ntamadan atwa Ahyiae Ntamadan no ho ahyia, sɛnea ɛbɛyɛ a Onyankopɔn abufuwhyew remma Israelfo no so. Lewifo no na wɔbɛhwɛ Ahyiae Ntamadan no so.”<verse eid="NUM 1:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54"/>Israelfo no yɛɛ eyinom nyinaa sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no.<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">Israel Mmusuakuw Atenae Ho Nhyehyɛe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose ne Aaron se: <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>“Abusua biara benya nʼafa wɔ atenae hɔ, na kuw biara bɛtena nʼabusua frankaa ase. Na mmusua no atenae ahorow no mfimfini na wɔde Ahyiae Ntamadan no besi.”<verse eid="NUM 2:2"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="3" style="v" sid="NUM 2:3"/>Apuei fam,</para>
  <para style="li1" vid="NUM 2:3">baabi a owia pue fi hɔ no na ɛsɛ sɛ Yuda nnipa nkyekyɛmu ahorow no nyinaa bɔ wɔn atenae wɔ wɔn frankaa ase. Yudafo ntuanoni ne Aminadab ba Nahson. <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>Na ne dɔm no ano si mpem aduɔson anan ne ahansia (74,600).<verse eid="NUM 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 2:5"/>Isakar abusuakuw na wobedi so. Wɔn ntuanoni ne Suar babarima Netanel. <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>Na ne dɔm no ano si mpem aduonum anan ne ahannan (54,400).<verse eid="NUM 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 2:7"/>Sebulon abusuakuw na wobedi so. Wɔn ntuanoni ne Helon babarima Eliab. <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>Na ne dɔm no ano si mpem aduonum ason ne ahannan (57,400).<verse eid="NUM 2:8"/></para>
  <para style="li4">
    <verse number="9" style="v" sid="NUM 2:9"/>Enti na nnipa dodow a wɔwɔ Yuda atenae no nyinaa sɛnea wɔn nkyekyɛmu te no ano si mpem ɔha aduɔwɔtwe asia ne ahannan (186,400). Sɛ Israelfo no tu a, saa mmusuakuw abiɛsa yi na edi kan.<verse eid="NUM 2:9"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="10" style="v" sid="NUM 2:10"/>Anafo fam na Ruben nnipa nkyekyɛmu ahorow no nyinaa bɛbɔ wɔn atenae de wɔn frankaa asi. Wɔn ntuanoni ne Sedeur babarima Elisur. <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>Ne dɔm ano si mpem aduanan asia ne ahannum (46,500).<verse eid="NUM 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 2:12"/>Simeon abusuakuw na wobedi so. Wɔn ntuanoni ne Surisadai babarima Selumiel. <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>Ne dɔm ano si mpem aduonum akron ne ahaasa (59,300).<verse eid="NUM 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 2:14"/>Gad abusuakuw na wobedi so. Wɔn ntuanoni ne Reuel babarima Eliasaf. <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>Na ne dɔm ano si mpem aduanan anum ahansia ne aduonum (45,650).<verse eid="NUM 2:15"/></para>
  <para style="li4">
    <verse number="16" style="v" sid="NUM 2:16"/>Na mmarima a wɔwɔ Ruben atenae ne sɛnea wɔn nkyekyɛmu te no ano si mpem ɔha aduonum baako ahannan ne aduonum (151,450). Na sɛ Israelfo tu a, wɔn na wɔto so abien.<verse eid="NUM 2:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 2:17"/>Afei Lewifo no de Ahyiae Ntamadan befi wɔn atenae mfimfini hɔ akɔ. Mmusuakuw no nyinaa bɛkɔ no nnidiso sɛnea wɔn atenae nhyehyɛe te wɔ wɔn mmusuakuw mfrankaa akyi.<verse eid="NUM 2:17"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="18" style="v" sid="NUM 2:18"/>Efraim abusuakuw bɛfa atenae hɔ atɔe fam adi wɔn abusua frankaa akyi. Wɔn ntuanoni ne Amihud babarima Elisama. <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>Ne dɔm ano si mpem aduanan ne ahannum (40,500).<verse eid="NUM 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 2:20"/>Manase abusuakuw na wobedi so. Wɔn ntuanoni ne Pedahsur babarima Gamaliel. <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>Ne dɔm ano si mpem aduasa abien ne ahannu (32,200).<verse eid="NUM 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 2:22"/>Benyamin abusuakuw na wodi so. Wɔn ntuanoni ne Gideoni babarima Abidan. <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>Ne dɔm ano si mpem aduasa anum ne ahannan (35,400).<verse eid="NUM 2:23"/></para>
  <para style="li4">
    <verse number="24" style="v" sid="NUM 2:24"/>Na mmarima a wɔwɔ Efraim atenae ne sɛnea wɔn nkyekyɛmu te no ano si mpem ɔha ne awotwe ne ɔha baako (108,100). Na sɛ Israelfo tu a, wɔn na wɔto so abiɛsa.<verse eid="NUM 2:24"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="25" style="v" sid="NUM 2:25"/>Dan abusuakuw bɛfa atifi fam adi wɔn abusua frankaa akyi. Wɔn ntuanoni ne Amisadai babarima Ahieser. <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>Ne dɔm ano si mpem aduosia abien ne ahanson (62,700).<verse eid="NUM 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 2:27"/>Aser abusuakuw no bedi so. Wɔn ntuanoni ne Okran babarima Pagiel. <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>Ne dɔm ano si mpem aduanan baako ne ahannum (41,500).<verse eid="NUM 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 2:29"/>Naftali abusuakuw no bedi so. Wɔn ntuanoni ne Enan ba Ahira. <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>Ne dɔm ano si mpem aduonum abiɛsa ne ahannan (53,400).<verse eid="NUM 2:30"/></para>
  <para style="li4">
    <verse number="31" style="v" sid="NUM 2:31"/>Mmarima a wɔwɔ Dan atenae no ano si mpem ɔha aduonum ason ne ahansia (157,600).<verse eid="NUM 2:31"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="32" style="v" sid="NUM 2:32"/>Sɛɛ na Israelfo a wɔkan wɔn mmusuakuw mmusuakuw no te. Wɔn a wɔwɔ atenae hɔ nyinaa, sɛnea wɔn nkyekyɛmu te no ano si mpem ahansia ne abiɛsa ahannum ne aduonum (603,550). <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>Sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no, wɔankan Lewifo no anka Israelfo no ho.<verse eid="NUM 2:33"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34"/>Enti Israelfo yɛɛ biribiara sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no. Wɔbobɔɔ wɔn atenae, tenatenaa wɔn frankaa ahorow ase, na wɔnantew nnidiso nnidiso sɛnea wɔn mmusua ne wɔn afi te.<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">Lewifo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>Eyi ne nea ɛfa Aaron ne Mose mmusua ho bere a <char style="nd">Awurade</char> kasa kyerɛɛ Mose wɔ Sinai Bepɔw so no.<verse eid="NUM 3:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2"/>Aaron mmabarima din na edidi so yi: Nadab, nʼabakan, Abihu, Eleasar ne Itamar. <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>Eyinom ne Aaron mma a wɔasra wɔn ngo na wɔayi wɔn asi hɔ sɛ asɔfo. <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>Nadab ne Abihu de, wowuwuu wɔ <char style="nd">Awurade</char> anim bere a wɔhyew afɔrebɔde wɔ ogya a ɛmfata so wɔ Sinai sare so no. Na wonni mma nti, Eleasar ne Itamar nko ara na wɔsom sɛ asɔfo, bere a wɔn agya Aaron te ase no.<verse eid="NUM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se: <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>“Frɛ Lewifo no, na fa wɔn ma ɔsɔfo Aaron sɛ nʼaboafo. <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>Wɔbɛyɛ adwuma wɔ Ahyiae Ntamadan no mu ama ɔsɔfo Aaron ne nnipa no nyinaa. <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>Afei, wɔbɛhwɛ nneɛma a wɔde siesie Ahyiae Ntamadan mu no so de asi Israelfo no anan mu ayɛ asodi a wɔyɛ wɔ Ahyiae Ntamadan no mu. <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>Fa Lewifo no ma Aaron ne ne mmabarima; wɔn ne Israelfo a wɔde wɔn bɛma no korakora. <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>Ma Aaron ne ne mmabarima no nsom sɛ asɔfo; onipa foforo biara a ɔbɛbɛn kronkronbea hɔ no, ɛsɛ sɛ wokum no.”<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>“Mayi Lewifo no afi Israelfo no mu de wɔn asi Israel babea biara abakan a ɔyɛ ɔbarima anan mu. Lewifo no yɛ me de, <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>efisɛ abakan biara wɔ me. Bere a mikunkum mmakan wɔ Misraim no, migyaw Israel mmakan, sɛ wɔyɛ nnipa anaa mmoa. Wɔyɛ me dea. Mene <char style="nd">Awurade</char>.”<verse eid="NUM 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose wɔ Sinai sare so se, <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>“Kan Lewifo no wɔ wɔn mmusua ne afi mu. Kan ɔbarima biara fi nea wadi ɔsram baako so.” <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>Enti Mose kan wɔn sɛnea <char style="nd">Awurade</char> hyɛɛ no no.<verse eid="NUM 3:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17"/>Eyinom ne Lewi mmabarima:</para>
  <para style="li2" vid="NUM 3:17">Gerson, Kohat ne Merari.<verse eid="NUM 3:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18"/>Gerson asefo ni:</para>
  <para style="li2" vid="NUM 3:18">Libni ne Simei.<verse eid="NUM 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19"/>Kohat asefo:</para>
  <para style="li2" vid="NUM 3:19">Amram, Ishar, Hebron ne Usiel.<verse eid="NUM 3:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20"/>Merari asefo:</para>
  <para style="li2" vid="NUM 3:20">Mahli ne Musi.</para>
  <para style="b" vid="NUM 3:20"/>
  <para style="li4" vid="NUM 3:20">Eyinom ne Lewifo, sɛnea wɔn mmusua ne wɔn afi te.<verse eid="NUM 3:20"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="21" style="v" sid="NUM 3:21"/>Gerson asefo no na wɔyɛ mmusua a wofi Libni ne Simei ase.<verse eid="NUM 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 3:22"/>Na Gersonfo mmarima a wɔadi ɔsram ne nea ɛboro saa a wofi Gerson mmusua mu no dodow yɛ mpem ahanson ne ahannum (7,500).<verse eid="NUM 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 3:23"/>Wɔn atenae wɔ Ahyiae Ntamadan no akyi wɔ atɔe fam.<verse eid="NUM 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 3:24"/>Na Gersonfo no ntuanoni ne Lael babarima Eliasaf.<verse eid="NUM 3:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 3:25"/>Saa mmusua abien yi na na wɔhwɛ Ahyiae Ntamadan no ne ne nkataho no ne ɔkwan nkataano no so. <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>Afei, na wɔhwɛ adiwo nkataano a etwa Ahyiae Ntamadan no ho ne afɔremuka ne adiwo nkataano nhoma ne ɛhɔ nneɛma a wɔde di dwuma ahorow no nyinaa so.<verse eid="NUM 3:26"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="27" style="v" sid="NUM 3:27"/>Kohat asefo yɛ mmusua a wofi Amram, Ishar, Hebron ne Usiel ase.<verse eid="NUM 3:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 3:28"/>Na Kehat mmusua no mu mmarima a wɔadi ɔsram ne nea ɛboro saa no dodow yɛ mpem awotwe ne ahansia (8,600).</para>
  <para style="li1" vid="NUM 3:28">Wɔn na na wɔhwɛ kronkronbea no so.<verse eid="NUM 3:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 3:29"/>Wɔmaa wɔn atenae wɔ Ahyiae Ntamadan no anafo fam.<verse eid="NUM 3:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 3:30"/>Na Kohatfo ntuanoni no ne Usiel babarima Elisafan.<verse eid="NUM 3:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 3:31"/>Saa mmusua anan yi na na wɔhwɛ apam adaka, ɔpon, kaneadua, afɔremuka ahorow, ne nea ɛkeka ho a na wɔde di dwuma wɔ kronkronbea hɔ, mfimfini ntwamtam ne nneɛma a wɔde di dwuma ahorow wɔ hɔ nyinaa no so.<verse eid="NUM 3:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="NUM 3:32"/>Aaron babarima ɔsɔfo Eleasar no na na ɔyɛ ɔpanyin wɔ Lewifo no nyinaa so. Ɔyɛɛ no panyin wɔ asɔfo a wɔhwɛ kronkronbea no so.<verse eid="NUM 3:32"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="33" style="v" sid="NUM 3:33"/>Na Merari asefo no yɛ mmusua a wofi Mahli ne Musi ase.<verse eid="NUM 3:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 3:34"/>Merarifo mmusua no mu na mmarima a wɔadi ɔsram ne nea ɛboro saa no dodow yɛ mpem asia ne ahannu (6,200).<verse eid="NUM 3:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 3:35"/>Merari abusua no ntuanoni ne Abihail babarima Suriel,</para>
  <para style="li1" vid="NUM 3:35">na wɔtenaa Ahyiae Ntamadan no atifi fam.<verse eid="NUM 3:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 3:36"/>Dwumadi a wɔde hyɛɛ saa mmusuakuw abien yi nsa ne sɛ, wɔbɛhwɛ Ahyiae Ntamadan no nnyinaso so. Afei, wɔbɛhwɛ mmeamu nnua, mpuran, nsisiso ne ɛho nneɛma a wɔde di dwuma no nyinaa, <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>ne mpuran a ɛwɔ adiwo hɔ nyinaa ne ne nsisiso, nnyinaso, ne ntampehama nyinaa, wɔbɛhwɛ so.<verse eid="NUM 3:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 3:38"/>Ahyiae Ntamadan no apuei fam, nea owia pue fi no, wogyaw maa Mose ne Aaron ne ne mmabarima sɛ wonsisi wɔn ntamadan wɔ hɔ.</para>
  <para style="li1" vid="NUM 3:38">Saa nnipa yi na na wosi Israelfo no anan mu di Ahyiae Ntamadan no ho dwuma nyinaa.</para>
  <para style="li1" vid="NUM 3:38">Obi foforo biara a ɔbɛbɛn kronkronbea hɔ no, ɛsɛ sɛ wokum no.<verse eid="NUM 3:38"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="39" style="v" sid="NUM 3:39"/>Lewifo a <char style="nd">Awurade</char> hyɛɛ Mose ne Aaron sɛ wɔnkan wɔn sɛnea wɔn mmusua te a ɔbarima biara a wɔadi ɔsram ne nea ɛboro saa ka ho no dodow yɛ mpem aduonu abien (22,000).<verse eid="NUM 3:39"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Kan Israelfo mmakan a wɔyɛ mmarima na wɔadi ɔsram ne nea ɛboro saa no, na kyerɛw wɔn din. <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>Lewifo no bɛyɛ me de. Ma wonsi Israelfo mmakan nyinaa anan mu, na Lewifo nyɛmmoa mmakan nsi Israelfo nyɛmmoa mmakan anan mu. Mene <char style="nd">Awurade</char>.”<verse eid="NUM 3:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42"/>Enti Mose kan Israelfo mmakan nyinaa sɛnea <char style="nd">Awurade</char> hyɛɛ no no. <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>Mmakan mmarima a wɔadi ɔsram ne nea ɛboro saa no a ɔkyerɛw wɔn din no ano si mpem aduonu abien ahannu ne aduɔson abiɛsa (22,273).<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>“Ma Lewifo nsi Israelfo mmakan anan mu. Na Lewifo nyɛmmoa mmakan nso nsi Israelfo nyɛmmoa mmakan anan mu. Lewifo yɛ me dea. Mene <char style="nd">Awurade</char>. <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>Ansa na mubegye Israelfo mmakan ahannu aduɔson abiɛsa no a wɔboro Lewifo no dodow so no, <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>momma wontua ti ade, sɛnea hyiadan mu nnwetɛbona te, a emu duru yɛ gram aduonum nson. <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>Fa ti ade sika no ma Aaron ne ne mma.”<verse eid="NUM 3:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49"/>Enti Mose gyigyee Israelfo ahannu aduɔson abiɛsa a na wɔboro Lewifo no dodow so no ti ade. <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>Sika a wogyigyee no nyinaa ano sii dwetɛ kilogram dunum ne fa. <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>Na Mose de maa Aaron ne ne mmabarima sɛnea <char style="nd">Awurade</char> hyɛɛ no no.<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">Kohar Mmabarima</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose ne Aaron se: <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>“Kan Kohatfo no dodow a wɔwɔ Lewifo no abusua mu. <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>Saa nnipakan yi bɛyɛ mmarima nko ara a wɔadi fi mfe aduasa kosi aduonum a wobetumi ayɛ adwuma wɔ Ahyiae Ntamadan mu.<verse eid="NUM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4"/>“Kohat mma no dwumadi ne sɛ wɔbɛhwɛ akronkronne no so wɔ Ahyiae Ntamadan no mu. <verse eid="NUM 4:4"/><verse number="5" style="v" sid="NUM 4:5"/>Sɛ wɔretu afi atenae hɔ a, Aaron ne ne mma mmarima na wobedi kan akɔ Ahyiae Ntamadan no mu akɔfa nkataanim no de akata adaka no ho. <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>Afei, wɔde abirekyi nhoma bɛkata nkataanim no ho na wɔde ntama tuntum akata abirekyi nhoma no ho na wɔde nnua a wɔde soa adaka no ahyehyɛ ne nkaa no mu.<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>“Afei, wɔmfa ntama tuntum nsɛw ɔpon a Daa Daa Brodo no da so no so; na wɔmfa mprɛte, nsanka, ne adidi nkankyee ne ɔnom afɔre nkuruwa no; brodo no ngu ntama no so ara. <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>Wɔde ntama kɔkɔɔ bɛkata so na wɔasan de abirekyi nhoma akata ntama kɔkɔɔ no so. Na afei, wɔde nnua a wɔde bɛsoa no ahyehyɛ ɔpon no mu.<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>“Ɛsɛ sɛ wɔde ntama tuntum kata kaneadua no, akanea no, adabaw no, nkuku apampaa no ne ngo tumpan no ho. <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>Saa nneɛma yi nyinaa nso wɔde abirekyi nhoma a ɛyɛ den bɛkata ho na wɔde nea wɔakyekyere no nyinaa abegu ɔpon no so.<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>“Ɛsɛ sɛ wɔde ntama tuntum kata sikakɔkɔɔ afɔremuka no so na wɔsan de abirekyi nhoma kata so bio na wɔde nnua a wɔde soa no hyehyɛ afɔremuka no mu.<verse eid="NUM 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12"/>“Hyiadan no mu som no ho nneɛma a aka no nyinaa, ɛsɛ sɛ wɔde ntama bibiri kyekyere ho a wɔde abirekyi nhoma asan akyekyere ho na wɔde ato mpata a wɔde soa no so.<verse eid="NUM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13"/>“Ɛsɛ sɛ wotu nsõ no nyinaa fi afɔremuka no mu gu, na wɔde ntama kɔkɔɔ kyekyere ho. <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>Ɛsɛ sɛ wɔde afɔremuka no ho ɔsom nneɛma nyinaa gu ntama no so. Saa nneɛma no ne nkankyee a wɔnoa mu, adinam, sofi, ne nkankyee a wɔde nsu a wɔde pete gu mu. Ɛsɛ sɛ wɔde abirekyi nhoma kata ne nyinaa so na wɔde nnua a wɔde soa no gu faako a ɛsɛ sɛ wɔde gu.<verse eid="NUM 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15"/>“Sɛ Aaron ne ne mma mmarima no wie kronkronbea hɔ nneɛma no anoboa a, Kohat ne nʼabusuafo bɛba abɛsoa akɔ baabiara a wɔretu nneɛma akɔ. Nanso wonni ho kwan sɛ wɔde wɔn nsa ka nneɛma a ɛho tew no bi. Wɔyɛ saa a, wobewuwu. Ɛsɛ sɛ Kohat mmabarima no soa nneɛma a ɛwɔ Ahyiae Ntamadan no mu no.<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>“Aaron babarima Eleasar a ɔyɛ ɔsɔfo no na ɔbɛhwɛ ngo a wɔde bɛsɔ kanea, nnuhuam, daa aduan a wɔde bɔ afɔre, ɔsra ngo ne Ahyiae Ntamadan no nyinaa so. Biribiara a ɛwɔ Ahyiae Ntamadan no mu no nso, ɔbɛhwɛ so.”<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose ne Aaron se, <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>“Monhwɛ sɛ wɔrentwa Kohatfo abusuakuw no mfi Lewifo mu. <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>Sɛ wɔresoa nneɛma a ɛho tew no a, nea ɛsɛ sɛ wɔyɛ a wɔrenwuwu ni: Ɛsɛ sɛ Aaron ne ne mma mmarima no ne wɔn kɔ hɔ kɔkyerɛ wɔn ade a ɛsɛ sɛ wɔn mu biara soa. <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>Ɛnsɛ sɛ Kohatfo no kɔ hɔ kɔhwɛ akronkronne no koraa, na wɔanwuwu.”<verse eid="NUM 4:20"/></para>
  <para style="s1">Gerson Mmabarima</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>“Kan Gerson asefo a wɔfra Lewifo abusua mu no, <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>fi mmarima a wɔadi mfe aduasa kosi aduonum a wobetumi ayɛ adwuma kronkron wɔ Ahyiae Ntamadan mu hɔ no so.<verse eid="NUM 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24"/>“Gerson mmusua no dwuma a wobedi ni: <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>Wɔbɛsoa ntama a etwa Ahyiae Ntamadan mu hɔ, Ahyiae Ntamadan no ankasa ne nea ɛkata ho, abirekyi nhoma nkuruso ne ntama a ɛsɛn Ahyiae Ntamadan no ano no. <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>Afei, wɔbɛsoa nkataho a ɛkata adiwo hɔ fasu no ho no. Wɔbɛsoa ntama a etwa adiwo hɔ kwan no ano ne afɔremuka ne Ahyiae Ntamadan no ntam no. Wɔbɛsoa afɔremuka no, ntampehama ne nea ɛkeka ho nyinaa. Wɔn na ɛsɛ sɛ wɔhwɛ twe eyinom nyinaa. <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>Aaron anaa ne mmabarima no bi tumi ma Gerson asefo no bi dwuma di. <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>Eyi ne Gersonfo no adwuma wɔ Ahyiae Ntamadan no mu. Ɛsɛ sɛ wodi Aaron ba Itamar a ɔyɛ ɔsɔfo no nan ase.<verse eid="NUM 4:28"/></para>
  <para style="s1">Merari Mmabarima</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>“Kan Merari asefo a wɔfra Lewifo abusua mu no. <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>Kan mmarima a wɔadi mfe aduasa kosi aduonum so a wobetumi ayɛ adwuma wɔ Ahyiae Ntamadan mu hɔ. <verse eid="NUM 4:30"/><verse number="31" style="v" sid="NUM 4:31"/>Sɛ wɔpagyaw Ahyiae Ntamadan no a, wɔn na ɛsɛ sɛ wɔsoa ne nnyinaso, nnua a esisi mu, ne nsisiso, <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>mpuran a wɔde yɛɛ adiwo hɔ afasu no ne ne nsisiso, nnyinaso, ntampehama ne biribiara a wɔde di ho dwuma. Fa dwumadi ahorow no hyɛ nnipa a wobɛbobɔ wɔn din no nsa. <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>Merari asefo no, Aaron babarima Itamar na ɔbɛhwɛ wɔn so.”<verse eid="NUM 4:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 4:34"/>Enti Mose ne Aaron ne mpanyimfo no bi kɔkan Kohatfo<verse eid="NUM 4:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 4:35"/>a mmarima a wɔadi mfe aduasa kosi aduonum nyinaa a wobetumi ayɛ Ahyiae Ntamadan mu adwuma ka ho, <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>na wohuu sɛ wɔn nyinaa dodow yɛ mpem abien ne ahanson aduonum. <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>Eyinom ne Kohat asefo dodow a na wɔsom wɔ Ahyiae Ntamadan no mu Wɔyɛɛ eyinom nyinaa de dii <char style="nd">Awurade</char> ahyɛde a ɔmaa Mose no so.<verse eid="NUM 4:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 4:38"/>Wɔkan Gersonfo no mmusua ne wɔn mmusuakuw.<verse eid="NUM 4:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 4:39"/>Wɔkan mmarima a wɔadi mfe aduasa kosi aduonum a wobetumi ayɛ adwuma wɔ Ahyiae Ntamadan no mu. <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>Wɔn nyinaa dodow yɛɛ mpem abien ahansia ne aduasa. <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>Enti na Gersonfo a wɔfata sɛ wɔsom wɔ Ahyiae Ntamadan no mu no nyinaa dodow ne no. Mose ne Aaron na wɔkan wɔn sɛnea <char style="nd">Awurade</char> hyɛɛ wɔn no.<verse eid="NUM 4:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 4:42"/>Merarifo no nso, wɔkan wɔn mmusua ne wɔn mmusuakuw.<verse eid="NUM 4:42"/></para>
  <para style="li2">
    <verse number="43" style="v" sid="NUM 4:43"/>Wɔkan wɔn mmarima a wɔadi mfe aduasa kosi aduonum a wɔfata sɛ wɔyɛ adwuma wɔ Ahyiae Ntamadan no mu. <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>Wɔn nyinaa dodow yɛɛ mpem abiɛsa ne ahannu. <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>Enti Merarifo a wɔfata sɛ wɔsom wɔ Ahyiae Ntamadan no mu no nyinaa dodow ne no. Mose ne Aaron na wɔkan wɔn sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no.<verse eid="NUM 4:45"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="46" style="v" sid="NUM 4:46"/>Enti Mose ne Aaron ne Israel mpanyimfo nam Lewifo no mmusua ne wɔn afi so kan wɔn nyinaa. <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>Mmarima a na wɔadi fi mfe aduasa kosi mfe aduonum no nyinaa a na wɔfata sɛ wɔyɛ adwuma wɔ Ahyiae Ntamadan no mu hɔ no ne wɔn a wɔbɛsoa akɔ no <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>dodow yɛ mpem ahanwɔtwe ahannum ne aduɔwɔtwe.<verse eid="NUM 4:48"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="49" style="v" sid="NUM 4:49"/>
    <char style="nd">Awurade</char> hyɛ a ɔhyɛɛ Mose no nti na wɔnam so kan nnipa no.<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="s1">Israelfo Atenae Hɔ Kronkronyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>Eyi ne mmara a <char style="nd">Awurade</char> san hyɛ maa Mose: <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>“Ka kyerɛ Israelfo no se, ɛsɛ sɛ wɔpam akwatafo nyinaa fi atenae hɔ. Wɔn a kuru atutu wɔn ne wɔn a wɔde wɔn nsa akɔka funu nti wɔn ho agu fi nyinaa no, ɛsɛ sɛ wɔpam wɔn. <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>Mmarima ne mmea nyinaa ka ho. Yi wɔn nyinaa fi hɔ, sɛnea ɛbɛyɛ na atenae a me ne mo bɛtena no ho rengu fi.” <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>Wodii <char style="nd">Awurade</char> mmara no so.<verse eid="NUM 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>“Ka kyerɛ Israelfo no se, sɛ ɔbarima o, ɔbea o, odi <char style="nd">Awurade</char> huammɔ a, ɛyɛ bɔne. <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>Ɛsɛ sɛ ɔka ne bɔne na ade a owiae no, otua ho ka nyinaa na ɔsan de ɛho ka no nkyɛmu ɔha mu aduonu ka ho de ma onipa ko a ɔbɔɔ no korɔn no. <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>Na sɛ onipa ko a wɔyɛɛ no bɔne no awu na onni obusuani biara a ɔbɛn no a wobetua ho ka ama no, na ɛsɛ sɛ wotua ma ɔsɔfo a, ɛsɛ sɛ wɔde odwennini ka ho sɛ mpatade. Ɛyɛ <char style="nd">Awurade</char> de. <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>Akyɛde kronkron a Israelfo de bɛkyɛ ɔsɔfo no yɛ ne de. <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>Ɔsɔfo biara bɛfa akyɛde kronkron biara a ne nsa bɛka.”<verse eid="NUM 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>“Ka kyerɛ Israelfo no se, sɛ ɔbarima bi yere kɔbɔ aguaman <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>nanso onhu asɛm no mu nokware na onya ɔdanseni <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>na ɔtwe ho ninkunu na ɔnte ne ho ase a, <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>ɔbarima no de ne yere no bɛkɔ ɔsɔfo anim a ɔbea no ho afɔrebɔde a ɛyɛ atokosiam a wɔmfaa ohuam ngo mfrae lita abien ka ho. Efisɛ ɛyɛ ninkutwe afɔrebɔ. Ɛno na ɛbɛma nokware ada adi ama wɔahu sɛ ɔbea no di fɔ anaa odi bem.<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>“Ɔsɔfo no de ɔbea no bɛba Awurade anim, <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>na wasaw Ahyiae Ntamadan no mu mfutuma de afra nsu kronkron<note caller="+" style="f"><char style="fr" closed="false">5.17 </char><char style="ft" closed="false">Nsu kronkron ne mfutuma a wɔde afra no kyerɛ atɛntrenee a wobebu nnebɔneyɛfo no.</char></note> a egu asuhina kɛse bi mu no. <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>Ɔbɛsan ne ti a wakyekyere no na ɔde ninkunu afɔrebɔde no agu ne nsam de ahwɛ sɛ ɔbarima no nsusuwii no yɛ nokware ampa ara anaasɛ ɛnyɛ nokware. Ɔsɔfo no begyina nʼanim a okura nsu nwenweenwen a ɛde mmusu ba no. <verse eid="NUM 5:18"/><verse number="19-22" style="v" sid="NUM 5:19-22"/>Ɔbɛma no aka ntam sɛ onnim asɛm no ho hwee na waka akyerɛ no se, sɛ wo ne ɔbarima biara nnae ka wo kunu nko ara ho de a, ɛno de, wo ho ntew mfi nsu nwenweenwen a ɛde mmusu ba yi ho. Na sɛ woabɔ aguaman a, ɛno de, <char style="nd">Awurade</char> bɛdome wo wɔ wo nkurɔfo mu. Ɔbɛma wo srɛ aporɔw na wo yafunu ahon. Na ɔbea no bɛka se, ‘Yiw, saa na ɛsɛ sɛ ɛba.’<verse eid="NUM 5:19-22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>“Ɔsɔfo no bɛkyerɛw nnome yi nyinaa agu nhoma bi mu na wahohoro agu nsu nwenweenwen no mu. <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>Sɛ ɛsɛ sɛ ɔbea no nom nsu no na sɛ ɔnom wɔ bere a wayɛ bɔne a, ɛyɛ nwenweenwen wɔ ne mu. <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>Afei, ɔsɔfo no begye ninkunu afɔrebɔde no afi ɔbea no nsam na wahinhim wɔ <char style="nd">Awurade</char> anim na ɔde akɔ afɔremuka no so. <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>Ɔbɛsaw ne nsa ma de asi ne nyinaa anan na wahyew no wɔ afɔremuka no so na wama ɔbea no anom nsu no. <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>Sɛ ne ho agu fi na wabɔ aguaman atia ne kunu a, nsu a wanom no bɛyɛ nwenweenwen wɔ ne mu na ne yafunu ahon na ne srɛ aporɔw na wayɛ nnome wɔ ne nkurɔfo mu. <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>Sɛ ɔyɛ kronkron a ɔmmɔɔ aguaman a, wɔrenhaw no, na ɛrenkyɛ, obenyinsɛn.<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29"/>“Eyi ne mmara a ɛfa ɔbea a ne bra nye na ne kunu twe ne ho ninkunu <verse eid="NUM 5:29"/><verse number="30" style="v" sid="NUM 5:30"/>de hwehwɛ mu hu sɛ odi ne kunu nokware anaa onni no nokware no ho. Ɔde no bɛba <char style="nd">Awurade</char> anim na ɔsɔfo no adi dwuma a wɔabobɔ so no nyinaa. <verse eid="NUM 5:30"/><verse number="31" style="v" sid="NUM 5:31"/>Wɔrenni ne kunu no asɛm wɔ baabiara sɛ wama ɔyare bɔne bi aba ne yere so, efisɛ ɛyɛ ɔno ara na ɔma ɛbaa saa.”<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">Ahotuafo Mmara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>
    <char style="nd">Awurade</char> san ka kyerɛɛ Mose se, <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>“Ka kyerɛ Israelfo no se, sɛ ɔbarima anaa ɔbea kɔyɛ Nasareni de tew ne ho wɔ <char style="nd">Awurade</char> anim a, <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>ɛno akyi, saa bere a ɔwɔ ahotew no mu no, onni ho kwan sɛ ɔnom nsa a ɛyɛ den anaa bobesa anaa nsa a emu kaw. <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>Saa bere no mu no, onni ho kwan sɛ odi biribiara a efi bobe mu, sɛ ɛyɛ nʼaba anaa ne hono.<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>“Saa bere no mu no, ɛnsɛ sɛ oyi ne tinwi, efisɛ ɔyɛ kronkron na wɔatew ne ho ama <char style="nd">Awurade</char>; ɛno nti na ɛsɛ sɛ ɔma ne tinwi fuw no.<verse eid="NUM 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6"/>“Ne bɔhyɛ no nna no mu a watew ne ho ama <char style="nd">Awurade</char> no, onni ho kwan sɛ ɔkɔ owufo ho. <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>Sɛ owufo no yɛ nʼagya, ne na, ne nuabarima anaa ne nuabea koraa a, ɔnnkɔ ne ho, efisɛ ɔda so hyɛ ne bɔ a ɔhyɛ de tew ne ho maa Onyankopɔn no ase. <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>Saa bere no mu nyinaa, wɔatew ne ho ama <char style="nd">Awurade</char>.<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>“Sɛ obi wu tɔ ne nkyɛn de gu ne ho fi a, nnanson akyi no, ɛsɛ sɛ oyi ne tinwi a ɛho agu fi no. Afei, wobedwira ne ho afi fi a owufo no de aka no no ho. <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>Nʼadekyee a ɛyɛ da a ɛto so awotwe no, ɛsɛ sɛ ɔde nturukuku abien anaa mmorɔnoma mma abien brɛ ɔsɔfo wɔ Ahyiae Ntamadan no kwan ano. <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>Ɔsɔfo no de nnomaa no mu baako bɛbɔ bɔne ho afɔre na ɔde ɔbaako abɔ ɔhyew afɔre, na ayɛ mpata ama nea ne ho agu fi no. Na da no ara, ɛsɛ sɛ oti ne bɔhyɛ mu na ɔsan ma ne tinwi no fuw bio. <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>Nna dodow a odii wɔ ne bɔhyɛ a edi kan no mu no nyinaa ahyew agu. Ɔbɛhyɛ <char style="nd">Awurade</char> bɔ foforo de afi ase, na ɔde odwennini ba a wadi afe bɛba abɛbɔ afɔdi ho afɔre.<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>“Da a ne bɔhyɛ a ɛtew ɔno ne <char style="nd">Awurade</char> ntam no wie du no, ɛsɛ sɛ ɔkɔ Ahyiae Ntamadan no ano. <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>Ɛhɔ na ɔbɛbɔ ɔhyew afɔre ama <char style="nd">Awurade</char>. Ɔde oguan ba a wadi afe a onnii dɛm na ɛbɛbɔ saa afɔre no. Ɛsɛ sɛ ɔde oguammere a wadi afe a onnii dɛm bɔ bɔne ho afɔre na ɔde odwennini a onnii dɛm bɔ asomdwoe afɔre. <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>Nneɛma a ɔde bɛka ho no ne brodo a mmɔkaw mfra mu, asikresiam tetare a wɔde ngo afra; brodo ntrantraa bi a mmɔkaw mfra mu a wɔde ngo ayɛ so a aduan ne nsa afɔrebɔde ka ho.<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>“Ɛsɛ sɛ Ɔsɔfo no de saa afɔrebɔde yi nyinaa ba <char style="nd">Awurade</char> anim na wabɛbɔ bɔne ho afɔre ne ɔhyew afɔre. <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>Ɛsɛ sɛ ɔde odwennini a wɔde no bɛbɔ asomdwoe afɔre a brodo kɛntɛnma a mmɔkaw nni mu nso ka ho na ɔde abɛbɔ aduan ne nsa afɔre.<verse eid="NUM 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18"/>“Afei, ɔhotuafo no beyi ne tinwi a afuw kuhaa no; ɛno ne nsɛnkyerɛnne a ɛkyerɛ sɛ ɔnhyɛ bɔhyɛ no ase bio. Wɔbɛyɛ eyi wɔ Ahyiae Ntamadan no ano, na wɔde nwi no agu asomdwoe afɔre a wɔrebɔ no wɔ gya mu no ahyew no.<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>“Wɔayi ɔbarima no tinwi no awie no, ɔsɔfo no de odwennini no basa a wɔatoto tetare a mmɔkaw nni mu no baako ne brodo ntrantraa a mmɔkaw nni mu bɛhyɛ ɔbarima no nsam. <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>Ɔsɔfo no behim akɔ nʼanim aba nʼakyi wɔ <char style="nd">Awurade</char> anim a ɛkyerɛ ma a ɔde rema <char style="nd">Awurade</char>. Ne nyinaa yɛ kyɛfa a ɛho tew ma ɔsɔfo no. Wɔbɛyɛ no sɛnea wɔyɛ odwennini no basa mu mfe mparow a wohim no wɔ <char style="nd">Awurade</char> anim no. Eyi akyi no, ɔhotuafo no tumi nom bobesa a ɛkyerɛ sɛ wɔayi no afi ne bɔhyɛ no mu.<verse eid="NUM 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21"/>“Eyinom ne mmara a ɛda hɔ ma Nasareni a wahyɛ nʼahofama ho bɔ awie, na ɔde afɔrebɔ ahorow brɛ <char style="nd">Awurade</char>. Saa afɔrebɔ yi akyi no, otumi de afɔrebɔde biara a ɔrebɛyɛ Nasareni no, ɔhyɛɛ ho bɔ sɛ ɔde bɛba no ba.”<verse eid="NUM 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>“Ka kyerɛ Aaron ne ne mmabarima no se, ɛsɛ sɛ wohyira Israelfo yi sononko sɛ:<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>“ ‘<char style="nd">Awurade</char> nhyira mo</para>
  <para style="q2" vid="NUM 6:24">na ɔnhwɛ mo so.<verse eid="NUM 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25"/>
    <char style="nd">Awurade</char> ntew nʼanim nkyerɛ mo</para>
  <para style="q2" vid="NUM 6:25">na ɔnnom mo.<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>
    <char style="nd">Awurade</char> mma nʼani so nhwɛ mo</para>
  <para style="q2" vid="NUM 6:26">na ɔmma mo asomdwoe.’<verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>“Saa na ɛsɛ sɛ Aaron ne ne mmabarima hyira Israelfo, na mʼankasa nso mehyira wɔn.”<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>Da a Mose wiee Ahyiae Ntamadan no hyehyɛ no, ɔsraa ho nyinaa ngo, tew mu nneɛma nyinaa ho. Ɔsan sraa afɔremuka ne ho nkuku ne nkaka nyinaa ngo, tew ho nso. <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>Afei, Israel mpanyimfo ne mmusuakuw no mu mpanyin a wɔhwɛɛ nnipakan no so no nyinaa de wɔn afɔrebɔde bae. <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>Wɔde nteaseɛnam asia a wɔakatakata ho ne anantwi dumien na ɛbae. Na nteaseɛnam no baako biara yɛ mpanyimfo baanu de, a nantwi baako yɛ wɔn mu biara de. Wɔde ne nyinaa maa <char style="nd">Awurade</char> wɔ Ahyiae Ntamadan no anim.<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>“Gye wɔn akyɛde no na fa nteaseɛnam no yɛ Ahyiae Ntamadan no ho adwuma. Fa ma Lewifo no na obiara mfa nni dwuma biara a ɛsɛ sɛ odi.”<verse eid="NUM 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6"/>Enti Mose de nteaseɛnam no ne anantwi no maa Lewifo no. <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>Ɔmaa Gerson ne ne nkurɔfo nteaseɛnam abien ne anantwi anan sɛnea na ehia ma wɔn dwumadi, <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>na ɔmaa Merari ne ne nkurɔfo nso nteaseɛnam anan ne anantwi awotwe a Aaron babarima Itamar na na odi so panyin. <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>Wɔamma Kohat nkurɔfo nteaseɛnam no bi, efisɛ na ɛsɛ sɛ wɔsoa wɔn kyɛfa a ɛfa Ahyiae Ntamadan no ho nneɛma no ho no wɔ wɔn mmati so.<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>Mpanyimfo a wodi anim no nso de nsrabɔ akyɛde beguu afɔremuka no anim da a wɔresra afɔremuka no ngo no. <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/><char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Kyekyɛ nna a obiara de nʼafɔrebɔde bɛba afɔremuka no so.”<verse eid="NUM 7:11"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="12" style="v" sid="NUM 7:12"/>Aminadab babarima Nahson a ofi Yuda abusuakuw mu na ɔde nʼafɔrebɔde baa da a edi kan no.<verse eid="NUM 7:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 7:13"/>Nneɛma a ɔde bae no yɛ:</para>
  <para style="li2" vid="NUM 7:13">dwetɛ prɛte baako a emu duru yɛ kilogram baako ne fa, dwetɛ kuruwa kɛse bi a ɛbɛyɛ kilogram baako a ne nyinaa na wɔde asikresiam muhumuhu a wɔde ngo afra ahyɛ no amaama;<verse eid="NUM 7:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="NUM 7:14"/>sikakɔkɔɔ adaka baako a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="NUM 7:15"/>ɔde nantwinini ba, odwennini ne oguamma a wadi afe bae sɛ ɔhyew afɔrebɔde.<verse eid="NUM 7:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 7:16"/>Wɔde ɔpapo bae sɛ bɔne ho afɔrebɔde<verse eid="NUM 7:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 7:17"/>ne anantwi abien, adwennini anum, mmirekyi anum ne nguantenmma a wɔn mu biara adi afe, anum bae sɛ wɔn asomdwoe afɔrebɔde.</para>
  <para style="li4" vid="NUM 7:17">Eyi ne Nahson, Aminadab ba afɔrebɔde.<verse eid="NUM 7:17"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="18" style="v" sid="NUM 7:18"/>Da a ɛto so abien no, Suar babarima Netanel a ɔda Isakar abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 7:19"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:19">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako a wɔde atoko afɔrebɔde a ɛyɛ asikresiam muhumuhu a wɔde ngo afra ahyehyɛ no amaama.<verse eid="NUM 7:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="NUM 7:20"/>Sikakɔkɔɔ nnwetɛbona baako a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 7:21"/>nantwi ba, odwennini ne oguamma a wɔadi afe bae sɛ ɔhyew afɔre,<verse eid="NUM 7:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="NUM 7:22"/>ɔpapo sɛ bɔne ho afɔre<verse eid="NUM 7:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="NUM 7:23"/>ne anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:23">Eyi ne afɔre a Suar babarima Netanel de bae.<verse eid="NUM 7:23"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="24" style="v" sid="NUM 7:24"/>Ne nnansa so no, Helon babarima Eliab a ɔda Sebulon abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 7:25"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:25">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu a wɔde ngo afra ahyɛ no amaama;<verse eid="NUM 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="NUM 7:26"/>sikakɔkɔɔ akorade a emu duru yɛ gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="NUM 7:27"/>nantwi ba, odwennini ne oguamma a wɔadi afe bae sɛ ɔhyew afɔre,<verse eid="NUM 7:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="NUM 7:28"/>ɔpapo sɛ bɔne ho afɔre<verse eid="NUM 7:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="NUM 7:29"/>ne anantwi abien, adwennini anum ne mpapo anum sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:29">Eyi ne afɔre a Helon babarima Eliab de bae.<verse eid="NUM 7:29"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="30" style="v" sid="NUM 7:30"/>Ne nnaanan so no, Sedeur babarima Elisur a ɔda Ruben abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 7:31"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:31">dwetɛ prɛte a ɛyɛ kilogram baako ne fa. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu a wɔde ngo afra ahyɛ no amaama.<verse eid="NUM 7:31"/></para>
  <para style="li2">
    <verse number="32" style="v" sid="NUM 7:32"/>Sikakɔkɔɔ akorade a emu duru yɛ gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma.<verse eid="NUM 7:32"/></para>
  <para style="li2">
    <verse number="33" style="v" sid="NUM 7:33"/>Nantwi ba, odwennini ne oguamma onini a wadi afe bae sɛ ɔhyew afɔre,<verse eid="NUM 7:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="NUM 7:34"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 7:35"/>ne anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe.</para>
  <para style="li4" vid="NUM 7:35">Eyi ne afɔre a Sedeur babarima Elisur de bae.<verse eid="NUM 7:35"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="36" style="v" sid="NUM 7:36"/>Ne nnaanum so no, Surisadai babarima Selumiel a ɔda Simeon abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="NUM 7:37"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:37">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako na wɔde atoko afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu a wɔde ngo afra ahyɛ no amaama;<verse eid="NUM 7:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="NUM 7:38"/>sikakɔkɔɔ akorade a emu duru yɛ gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 7:39"/>nantwi ba, odwennini ne oguamma onini a wɔadi afe bae sɛ ɔhyew afɔre,<verse eid="NUM 7:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 7:40"/>ɔpapo sɛ bɔne ho afɔre,<verse eid="NUM 7:40"/></para>
  <para style="li2">
    <verse number="41" style="v" sid="NUM 7:41"/>ne anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre bae.</para>
  <para style="li4" vid="NUM 7:41">Eyi ne afɔre a Surisadai ba Selumiel de bae.<verse eid="NUM 7:41"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="42" style="v" sid="NUM 7:42"/>Ne nnansia so no, Deguel babarima Eliasaf a ɔda Gad abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="NUM 7:43"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:43">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako a wɔde atoko afɔrebɔde a ɛyɛ asikresiam muhumuhu a wɔde ngo afra ahyehyɛ no amaama;<verse eid="NUM 7:43"/></para>
  <para style="li2">
    <verse number="44" style="v" sid="NUM 7:44"/>sikakɔkɔɔ akorade bi a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 7:45"/>nantwi ba, odwennini ne oguamma a wadi afe bae sɛ ɔhyew afɔre,<verse eid="NUM 7:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="NUM 7:46"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:46"/></para>
  <para style="li2">
    <verse number="47" style="v" sid="NUM 7:47"/>anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:47">Eyi ne afɔre a Deguel ba Eliasaf de bae.<verse eid="NUM 7:47"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="48" style="v" sid="NUM 7:48"/>Ne nnanson so no, Amihud babarima Elisama a ɔda Efraim abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="NUM 7:49"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:49">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam muhumuhu a wɔde ngo afra ahyehyɛ no amaama;<verse eid="NUM 7:49"/></para>
  <para style="li2">
    <verse number="50" style="v" sid="NUM 7:50"/>sikakɔkɔɔ akorade a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:50"/></para>
  <para style="li2">
    <verse number="51" style="v" sid="NUM 7:51"/>nantwi ba, odwennini ne oguamma a wadi afe bae sɛ ɔhyew afɔre;<verse eid="NUM 7:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="NUM 7:52"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:52"/></para>
  <para style="li2">
    <verse number="53" style="v" sid="NUM 7:53"/>ne anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:53">Eyi ne afɔre a Amihud babarima Elisama de bae.<verse eid="NUM 7:53"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="54" style="v" sid="NUM 7:54"/>Ne nnaawɔtwe so no, Pedahsur babarima Gamaliel a ɔda Manase abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:54"/></para>
  <para style="li2">
    <verse number="55" style="v" sid="NUM 7:55"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:55">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam muhumuhu a wɔde ngo afra ahyehyɛ no amaama;<verse eid="NUM 7:55"/></para>
  <para style="li2">
    <verse number="56" style="v" sid="NUM 7:56"/>sikakɔkɔɔ akorade bi a ɛkari nnwetɛbona du a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:56"/></para>
  <para style="li2">
    <verse number="57" style="v" sid="NUM 7:57"/>nantwi ba, odwennini ne oguamma a wadi afe bae sɛ ɔhyew afɔre;<verse eid="NUM 7:57"/></para>
  <para style="li2">
    <verse number="58" style="v" sid="NUM 7:58"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:58"/></para>
  <para style="li2">
    <verse number="59" style="v" sid="NUM 7:59"/>ne anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:59">Eyi ne afɔre a Pedahsur ba Gamaliel de bae.<verse eid="NUM 7:59"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="60" style="v" sid="NUM 7:60"/>Ne nnankron so no, Gideoni babarima Abidan a ɔda Benyamin abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:60"/></para>
  <para style="li1">
    <verse number="61" style="v" sid="NUM 7:61"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:61">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam muhumuhu a wɔde ngo afra ahyehyɛ no amaama;<verse eid="NUM 7:61"/></para>
  <para style="li2">
    <verse number="62" style="v" sid="NUM 7:62"/>sikakɔkɔɔ akorade a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:62"/></para>
  <para style="li2">
    <verse number="63" style="v" sid="NUM 7:63"/>nantwi ba, odwennini ne oguamma a wadi afe bae sɛ ɔhyew afɔre;<verse eid="NUM 7:63"/></para>
  <para style="li2">
    <verse number="64" style="v" sid="NUM 7:64"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:64"/></para>
  <para style="li2">
    <verse number="65" style="v" sid="NUM 7:65"/>ne nantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:65">Eyi ne afɔre a Gideoni babarima Abidan de bae.<verse eid="NUM 7:65"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="66" style="v" sid="NUM 7:66"/>Ne nnadu so no, Amisadai babarima Ahieser a ɔda Dan abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="NUM 7:67"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:67">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu a wɔde ngo afra ahyehyɛ no amaama;<verse eid="NUM 7:67"/></para>
  <para style="li2">
    <verse number="68" style="v" sid="NUM 7:68"/>sikakɔkɔɔ akorade a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:68"/></para>
  <para style="li2">
    <verse number="69" style="v" sid="NUM 7:69"/>nantwi ba, odwennini ne oguamma onini a wadi afe bae sɛ ɔhyew afɔre;<verse eid="NUM 7:69"/></para>
  <para style="li2">
    <verse number="70" style="v" sid="NUM 7:70"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:70"/></para>
  <para style="li2">
    <verse number="71" style="v" sid="NUM 7:71"/>ne anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:71">Eyi ne afɔre a Amisadai babarima Ahieser de bae.<verse eid="NUM 7:71"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="72" style="v" sid="NUM 7:72"/>Ne nna dubaako so no, Okran babarima Pagiel a ɔda Aser abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:72"/></para>
  <para style="li1">
    <verse number="73" style="v" sid="NUM 7:73"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:73">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu a wɔde ngo afra ahyehyɛ no amaama;<verse eid="NUM 7:73"/></para>
  <para style="li2">
    <verse number="74" style="v" sid="NUM 7:74"/>sikakɔkɔɔ akorade a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:74"/></para>
  <para style="li2">
    <verse number="75" style="v" sid="NUM 7:75"/>nantwi ba, odwennini ne oguamma onini a wadi afe bae sɛ ɔhyew afɔre;<verse eid="NUM 7:75"/></para>
  <para style="li2">
    <verse number="76" style="v" sid="NUM 7:76"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:76"/></para>
  <para style="li2">
    <verse number="77" style="v" sid="NUM 7:77"/>ne anantwi abien, adwennini anum, mmirekyinini anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:77">Eyi ne afɔre a Okran babarima Pagiel de bae.<verse eid="NUM 7:77"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="78" style="v" sid="NUM 7:78"/>Ne nnadumien so no, Enan babarima Ahira a ɔda Naftali abusuakuw ano no de nʼafɔrebɔde bae.<verse eid="NUM 7:78"/></para>
  <para style="li1">
    <verse number="79" style="v" sid="NUM 7:79"/>Na nʼafɔrebɔde no yɛ:</para>
  <para style="li2" vid="NUM 7:79">dwetɛ prɛte a ɛyɛ kilogram baako ne fa ne dwetɛ hweaseammɔ a emu duru yɛ kilogram baako. Na wɔde atoko afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu a wɔde ngo afra ahyehyɛ no amaama;<verse eid="NUM 7:79"/></para>
  <para style="li2">
    <verse number="80" style="v" sid="NUM 7:80"/>sikakɔkɔɔ akorade a ɛkari gram ɔha ne dunan (114) a wɔde aduhuam ahyɛ no ma;<verse eid="NUM 7:80"/></para>
  <para style="li2">
    <verse number="81" style="v" sid="NUM 7:81"/>nantwi ba, odwennini ne oguamma onini a wadi afe bae sɛ ɔhyew afɔre;<verse eid="NUM 7:81"/></para>
  <para style="li2">
    <verse number="82" style="v" sid="NUM 7:82"/>ɔpapo sɛ bɔne ho afɔre;<verse eid="NUM 7:82"/></para>
  <para style="li2">
    <verse number="83" style="v" sid="NUM 7:83"/>ne anantwi abien, adwennini anum, mpapo anum ne nguantenmma anum a wɔn mu biara adi afe sɛ asomdwoe afɔre.</para>
  <para style="li4" vid="NUM 7:83">Eyi ne afɔre a Enan babarima Ahira de bae.<verse eid="NUM 7:83"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="84" style="v" sid="NUM 7:84"/>Eyinom ne afɔremuka no afɔrebɔde a Israel mpanyimfo de ba bɛsraa afɔremuka no, nam so bɔɔ no atenase:</para>
  <para style="li2" vid="NUM 7:84">dwetɛ mprɛte dumien, dwetɛ hweaseammɔ dumien ne sikakɔkɔɔ aduhuam nnwetɛbona dumien. <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>Ne nyinaa mu, na dwetɛ nneɛma no kari bɛyɛ kilogram aduasa, na prɛte biara kari bɛyɛ kilogram baako ne fa, na hweaseammɔ no nso mu duru yɛ kilogram baako. <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>Sikakɔkɔɔ a wɔde bɛkyɛe no mu duru yɛɛ bɛyɛ kilogram baako ne fa a ɛkyerɛ sɛ, sikakɔkɔɔ no akorade no mu biara duru yɛ nnwetɛbona du a wɔde aduhuam ahyɛ no ma.<verse eid="NUM 7:86"/></para>
  <para style="li2">
    <verse number="87" style="v" sid="NUM 7:87"/>Wɔde anantwi dumien ne adwennini a wɔn mu biara adi afe na ɛbɛbɔɔ ɔhyew afɔre no a atoko afɔrebɔ nso ka ho. Wɔde mpapo bɛbɔɔ bɔne ho afɔre.<verse eid="NUM 7:87"/></para>
  <para style="li2">
    <verse number="88" style="v" sid="NUM 7:88"/>Asomdwoe afɔre nneɛma a wɔde bae ni: nantwininimma aduonu anan, adwennini aduosia, mmirekyi aduosia, adwennini a wɔn mu biara adi afe aduosia.<verse eid="NUM 7:88"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>Bere a Mose kɔɔ Ahyiae Ntamadan no mu sɛ ɔne <char style="nd">Awurade</char> rekɔkasa no, ɔtee nne bi fi soro a ɛrekasa kyerɛ no fi Mpata Beae no atifi hɔ, wɔ adaka no ho baabi a kerubim abien no sisi no ntam. Awurade faa saa kwan yi so kasa kyerɛɛ no.<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>“Ka kyerɛ Aaron se, ‘Sɛ wosɔ akanea ason a ɛwɔ kaneadua no so no a, sɔ no sɛnea ɛbɛyɛ a, ɛbɛtow ne hann no akɔ kaneadua no nʼanim.’ ”<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>Aaron yɛɛ saa; ɔsɔɔ akanea no ma ɛtow hann kɔɔ kaneadua no anim, sɛnea Awurade hyɛɛ Mose no. <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>Sɛnea Wosi yɛɛ kaneadua no ni: Sikakɔkɔɔ a wɔaboro na wɔde yɛ fii nʼase kosi ne soro. Wɔyɛɛ no sɛnea <char style="nd">Awurade</char> kyerɛɛ Mose sɛ wɔnyɛ no ara pɛ.<verse eid="NUM 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>Na <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>“Yi Lewifo no fi Israelfo no mu na tew wɔn ho. <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>Sɛ ɛbɛyɛ a wɔn ho ni yɛ eyi: Fa ahodwira nsu pete wɔn so. Ma wonyi wɔn ho nwi nyinaa, na wɔnhoro wɔn nneɛma nyinaa, na ama wɔn ho atew. <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>Afei, ma wɔmfa nantwinini ba ne aduan afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu a wɔde ngo afra a nantwinini ba baako ka ho a wɔde no bɛbɔ bɔne ho afɔre mmra. <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>Frɛ Israelfo no nyinaa hyia na fa Lewifo no bra Ahyiae Ntamadan no pon ano. <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>Ɛhɔ na mpanyimfo a wotuatua mmusuakuw no ano no de wɔn nsa begu wɔn so. <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>Ɛsɛ sɛ Aaron yɛ nsɛnkyerɛnne bi sɛ ɔde wɔn rema <char style="nd">Awurade</char> sɛ akyɛde a efi Israel manfo nyinaa nkyɛn, na asiesie Lewifo no ama wɔayɛ <char style="nd">Awurade</char> adwuma.<verse eid="NUM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12"/>“Afei, Lewifo mpanyimfo no de wɔn nsa begu nantwimma no apampam na wɔde wɔn ama <char style="nd">Awurade</char>. Wɔde ɔbaako bɛbɔ bɔne ho afɔre na wɔde ɔbaako nso abɔ ɔhyew afɔre de ayɛ mpata ama Lewifo no. <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>Afei, wɔde Lewifo no bɛma Aaron ne ne mma te sɛnea wɔde afɔrebɔde biara fa asɔfo so de ma <char style="nd">Awurade</char> no.” <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>Mobɛfa saa kwan yi so ayi Lewifo no afi Israelfo no mu ama me, na wɔayɛ me dea.<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>“Sɛ motew wɔn ho na mofa saa kwan yi so de wɔn ma me a, afei, wobedi ahyɛmfiri wɔ Ahyiae Ntamadan no mu, adi wɔn dwuma. <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>Israelfo mu nyinaa, wɔn na wɔyɛ me nkurɔfo, na magye wɔn ato mu asi Israelfo mmakan nyinaa anan, Israelni bea biara abakan barima. <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>Israel abakan biara yɛ me de; nnipa ne mmoa nyinaa. Bere a mikunkum Misraimfo mmakan nyinaa no ara na mefaa wɔn de wɔn yɛɛ me nkurɔfo. <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>Mafa Lewifo no asi Israelfo mmakan nyinaa anan mu. <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>Na mede Lewifo no bɛkyɛ Aaron ne ne mmabarima. Lewifo no na wɔbɛyɛ Ahyiae Ntamadan no mu nnwuma kronkron a anka ɛsɛ sɛ Israelfo no na wɔyɛ, na wɔn na wɔbɛbɔ afɔre ama nkurɔfo de ayɛ mpata ama wɔn sɛnea sɛ Israelfo no kɔ kronkronbea hɔ a ɔyaredɔm biara renka wɔn.”<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>Mose ne Aaron ne Israelfo no nyinaa faa ɔkwan a <char style="nd">Awurade</char> kyerɛɛ Mose no so pɛpɛɛpɛ de Lewifo no maa Awurade. <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>Lewifo no dwiraa wɔn ho, horoo wɔn nneɛma. Na Aaron de wɔn hyɛɛ <char style="nd">Awurade</char> nsa sɛ ohim afɔre na ɔyɛɛ wɔn ho mpata adwuma de tew wɔn ho. <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>Ɛno akyi no, Lewifo no kɔyɛɛ adwuma wɔ Ahyiae Ntamadan no mu a na Aaron ne ne mmabarima no hwɛ wɔn so Wɔyɛɛ biribiara sɛnea <char style="nd">Awurade</char> hyɛɛ Mose sɛ wɔnyɛ no.<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>“Eyi kɔ ma Lewifo no: Sɛ Lewini barima biara di mfe aduonu anum a, ma no nsom wɔ Ahyiae Ntamadan mu, <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>na sɛ wodi mfe aduonum a, ɛsɛ sɛ wɔapɔn fi adwuma mu a wɔnnyɛ adwuma bio. <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>Sɛ wɔpɔn a, wotumi adi dwuma wɔ Ahyiae Ntamadan mu hɔ de boa wɔn nuanom, mmom wɔn ankasa de, ɛnsɛ sɛ wɔhyɛ da yɛ adwuma. Eyi ne ɔkwan a momfa so mma Lewifo no adwuma nyɛ.”<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s1">Twam Afahyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>Ɔsram a edi kan no mu afe a ɛto so abien no mu a wɔafi Misraim no na <char style="nd">Awurade</char> kaa saa asɛm yi kyerɛɛ Mose bere a ɔne Israelfo wɔ Sinai sare no so no se, <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>“Ma Israelfo no nni Twam Afahyɛ no wɔ ne bere ano. <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>Munni no wɔ ne bere ano, na mofa ne mmara akwan ahorow no nyinaa so nni wɔ ɔsram yi da a ɛto so dunan no anwummere.”<verse eid="NUM 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4"/>Enti Mose ka kyerɛɛ Israelfo no se wonni Twam Afahyɛ no, <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>na wɔyɛɛ saa wɔ Sinai Nweatam no so wɔ ɔsram a edi kan no da a ɛto so dunan no anwummere. Na Israelfo no yɛɛ biribiara pɛpɛɛpɛ sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no.<verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>Nanso na nnipa no bi fi ayi aba a esiane sɛ wɔde wɔn ho aka owufo nti na wɔn ho agu fi. Eyi nti wɔantumi anni Twam Afahyɛ no bi. Enti wɔbaa Mose ne Aaron nkyɛn da no ara <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>bɛka kyerɛɛ Mose se, “Yɛde yɛn ho aka funu ama yɛn ho agu fi, nanso dɛn nti na yɛne Israelfo nyinaa rentumi mfa yɛn afɔrebɔde mmrɛ <char style="nd">Awurade</char> sɛnea nhyehyɛe no te no?”<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>Mose buaa wɔn se, “Montwɛn mma mimmisa sɛnea <char style="nd">Awurade</char> mmara no ka fa mo ho.”<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>Na <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>“Ka kyerɛ Israelfo no se, Obiara a obeso funu mu, sɛ ɔyɛ nnɛmma anaa ofi awo ntoatoaso a ɛreba no mu wɔ Twam Afahyɛ bere a ɛbɛma ne ho agu fi anaa ɔnam akwantu so nti wɔantumi amma no tumi di <char style="nd">Awurade</char> Twam Afahyɛ no, <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>nanso ɔsram a ɛto so abien no da a ɛto so dunan no anwummere na ɛsɛ sɛ wodi. Saa bere no na ɛsɛ sɛ wɔwe oguamma no a brodo a mmɔkaw nni mu ka ho a naban nweenwen ka ho. <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>Ɛnsɛ sɛ wogyaw bi ma ade kye so, anaa wɔbɔ ne dompe mu. Na ɛsɛ sɛ wodi Twam Afahyɛ no mmara no nyinaa so pɛpɛɛpɛ. <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>Nanso obiara a ne ho nguu fi anaa obi a ontuu kwan nanso wanni Twam Afahyɛ no wɔ ne bere ano no, ɛsɛ sɛ wotwa no asu afi Israelfo no mu wɔ afɔre a wamma ammɛbɔ amma <char style="nd">Awurade</char> bere a ɛsɛ mu no nti. Wɔbɛsoa wɔn afɔdi ho sodi.<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>“Ɛsɛ sɛ ɔhɔho a ɔfra mo mu no fa mmara koro no ara so di <char style="nd">Awurade</char> Twam Afahyɛ no. Ɛsɛ sɛ ɔhɔho ne okuroni nyinaa di mmara koro no so.”<verse eid="NUM 9:14"/></para>
  <para style="s1">Ogyamununkum</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>Da a wɔmaa Ahyiae Ntamadan no so sii hɔ no, omununkum kataa so. Anwummere no ara, omununkum no dan yɛɛ sɛ ogya na ɛyɛɛ saa ara anadwo mu no nyinaa de kosii adekyee. <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>Saa ara na ɛte bere biara, na edu anadwo a, mununkum no dan yɛ sɛ ogya. <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>Omununkum no maa ne ho so no, Israelfo no dii akyi kosii baabiara a ɛkɔ kogyina ma wɔbɔɔ hɔ atenae. <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>Eyi kyerɛ sɛ, sɛ <char style="nd">Awurade</char> ka se wɔnkɔ a, wɔkɔ, na sɛ ɔka se wonnyina a, wogyina. Na sɛ Omununkum no gyina a, wɔn nso gyina mmere dodow a egyina hɔ no nyinaa. <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>Sɛ egyina baabi kyɛ a, wɔn nso gyina hɔ kyɛ. Na sɛ egyina hɔ nna kakraa bi a, wɔn nso gyina hɔ nna kakraa bi saa ara, efisɛ saa na <char style="nd">Awurade</char> ahyɛ wɔn sɛ wɔnyɛ. <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>Ɛtɔ da bi a, omununkum no tena Ahyiae Ntamadan no so nna kakraa bi. Sɛ ɛba saa a, nnipa no nso tena nna kakraa bi. Na <char style="nd">Awurade</char> nhyɛ mu, wotu fii wɔn atenae. <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>Ɛtɔ da bi nso a, omununkum no tena anadwo na akɔ adekyee. Nanso sɛ ɛyɛ awia anaa anadwo na omununkum no ma ne ho so a, nnipa no tu fi atenae hɔ di akyi. <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>Sɛ omununkum no ba Ahyiae Ntamadan no atifi na edi nnaanu, ɔsram anaa afe a, saa nna no ara so na Israelfo no hwɛ de tena hɔ. Nanso enya tu ara pɛ a, na wɔn nso atu. <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>Eyi kyerɛ sɛ, wɔn nsrabɔ ne wɔn akwantu nyinaa gyina <char style="nd">Awurade</char> mmara a ɔhyɛ ma wɔn no so; na biribiara a Awurade ka kyerɛɛ Mose sɛ wɔnyɛ no, wɔyɛe.<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s1">Dwetɛ Ntorobɛnto No</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>“Fa dwetɛ a wɔaboro yɛ ntorobɛnto abien, na ɛyɛ a wɔahyɛn de afrɛ nnipa no, na edu ntamadan no tu so nso a, wɔahyɛn. <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>Sɛ wɔhyɛn ntorobɛnto abien no a, nnipa no behu sɛ, ɛsɛ sɛ wɔboa wɔn ho ano wɔ Ahyiae Ntamadan no ano. <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>Na sɛ wɔhyɛn baako pɛ a, na ɛkyerɛ sɛ Israel mmusua no mu mpanyimfo na ɛsɛ sɛ wɔba wo nkyɛn. <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>Sɛ mohyɛn de kyerɛ sɛ monkɔ mo anim a, mmusuakuw a wɔwɔ Ahyiae Ntamadan apuei fam no betu afi wɔn atenae hɔ na wɔakɔ. <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>Sɛ mohyɛn nea ɛto so abien no a, mmusuakuw a wɔwɔ anafo fam no bedi so. Monhyɛn no ntiantia mu mfa nkyerɛ sɛ wɔnkɔ. <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>Na sɛ mofrɛ nnipa no ama wɔabehyia a, momfa ɔkwan foforo so nhyɛn ntorobɛnto no.<verse eid="NUM 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 10:8"/>“Aaron mmabarima asɔfo nko ara na wɔbɛma wɔn kwan ama wɔahyɛn ntorobɛnto no. Eyi yɛ mmara a ɛbɛtena hɔ daa ama awo ntoatoaso a ɛbɛba no nyinaa. <verse eid="NUM 10:8"/><verse number="9" style="v" sid="NUM 10:9"/>Sɛ mudu Bɔhyɛ Asase no so na mo ne mo atamfo a wɔhyɛ mo so no ko a mohyɛn ntorobɛnto no. Na, <char style="nd">Awurade</char>, mo Nyankopɔn bɛkae mo na wagye mo afi mo atamfo nsam. <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>Anigyebere mu nso, monhyɛn ntorobɛnto no. Afe mu dapɔnna nso, monhyɛn. Ɔsram biara mfiase nso, monhyɛn mfa nnye mo ani wɔ ɔhyew afɔre ne asomdwoe afɔre ho. Sɛ moyɛ saa a, ɛbɛkae Onyankopɔn apam a ɔne mo wɔ no. Na mene <char style="nd">Awurade</char> mo Nyankopɔn.”<verse eid="NUM 10:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>Ɔsram a ɛto so abien no da a ɛto so aduonu no a ɛyɛ mfe abien a Israelfo fii Misraim no, omununkum no pagyaw ne ho fii Ahyiae Ntamadan no so, <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>enti Israelfo no fii Sinai sare so hɔ dii omununkum no akyi kosii sɛ ekogyinaa Paran sare so. <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>Bere a ɛsɛ sɛ wotu no duu no, <char style="nd">Awurade</char> nam Mose so ka kyerɛɛ wɔn.<verse eid="NUM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14"/>Akwantu no mu no, mmusua a wɔhyɛ Yuda abusuakuw no ase, a Aminadab babarima Nahson tua ano na otuu wɔn frankaa ma wodii kan. <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>Wɔn a wodii so ne Isakar abusuakuw a Suar babarima Netanel di wɔn anim. <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>Sebulon abusuakuw na wodii hɔ a Helon babarima Eliab na na odi wɔn anim. <verse eid="NUM 10:16"/><verse number="17" style="v" sid="NUM 10:17"/>Wotutuu Ahyiae Ntamadan no, na Gerson ne Merari mmusua a wofi Lewifo mu no soaa Ahyiae Ntamadan no dii wɔn afa wɔ santen no mu.<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>Ruben abusuakuw tuu wɔn frankaa de dii so a Sedeur babarima Elisur di wɔn anim. <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>Wɔn a na wodi so ne Simeon abusuakuw a Surisadai babarima Selumiel di wɔn anim; <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>Gad abusuakuw nso, na Deguel babarima Eliasaf na odi wɔn anim. <verse eid="NUM 10:20"/><verse number="21" style="v" sid="NUM 10:21"/>Na Kohatfo no nso na na wodi hɔ a wɔsoso kronkronbea hɔ nneɛma. Na ɛsɛ sɛ wɔhyehyɛ Ahyiae Ntamadan no wɔ beae foforo hɔ ansa na wɔadu hɔ.<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>Wɔn a na wodi so ne Efraim abusuakuw a na wodi wɔn frankaa no akyi a Amihud babarima Elisama na odi wɔn anim; <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>Wɔn a na wodi so ne Manase abusuakuw a Pedahsur babarima Gamaliel di wɔn anim; <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>na Benyamin abusuakuw na na wodi so a Gideoni babarima Abidan di wɔn anim.<verse eid="NUM 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25"/>Wɔn a na wotwa to koraa no ne Dan abusuakuw a wɔyɛ wɔn nyinaa awɛmfo na Amisadai babarima Ahieser da wɔn ano na frankaa di wɔn anim. <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>Okran babarima Pagiel na na odi Aser abusuakuw anim, <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>na Enan babarima Ahira nso di Naftali abusuakuw anim. <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>Saa nhyehyɛe yi na Israel mmusuakuw yi faa so tuu wɔn kwan no.<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>Afei, Mose ka kyerɛɛ nʼase Hobab, Midiani Reuel ba se, “Eyi nyinaa akyi no, yɛrekɔ beae a Awurade kae se, ‘Mede bɛma mo no.’ Bra na yɛnkɔ na yɛbɛhwɛ wo so yiye; efisɛ <char style="nd">Awurade</char> ahyɛ Israelfo nnepa ho bɔ.”<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>Obuae se, “Dabi, merenkɔ; merekɔ mʼasase so ne mʼabusuafo nkyɛn.”<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>Nanso Mose kae se, “Mesrɛ wo, nnyaw yɛn. Wo na wunim faako a ɛsɛ sɛ yɛtena wɔ sare no so, na wubetumi ayɛ yɛn kwankyerɛfo. <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>Sɛ wo ne yɛn kɔ a, nneɛma pa a <char style="nd">Awurade</char> de bɛma yɛn no nyinaa, wubenya bi.”<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>Enti wofi Awurade Bepɔw so nantew nnansa. Awurade Apam Adaka no dii wɔn anim hwehwɛɛ baabi a wɔbɛsoɛ maa wɔn. <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>Wofii wɔn akwantu no ase awia a wɔrekɔ no nyinaa na <char style="nd">Awurade</char> mununkum no di wɔn anim.<verse eid="NUM 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35"/>Bere biara a wɔbɛma adaka no so asi mu no, Mose teɛ mu se,</para>
  <para style="q1" vid="NUM 10:35">“<char style="nd">Awurade</char>, sɔre!</para>
  <para style="q2" vid="NUM 10:35">Ma wʼatamfo nhwete;</para>
  <para style="q2" vid="NUM 10:35">ma wɔn nyinaa nguan mfi wʼanim.”<verse eid="NUM 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36"/>Bere biara a wɔbɛsoɛ adaka no, ɔka se,</para>
  <para style="q1" vid="NUM 10:36">“<char style="nd">Awurade</char>, san bra</para>
  <para style="q2" vid="NUM 10:36">Israelfo mpempem a wontumi nkan wɔn no mu.”<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s1">Israelfo Anwiinwii</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>Ankyɛ biara na nnipa no fii ase nwiinwii sɛ nneɛma nkɔ yiye mma wɔn, na <char style="nd">Awurade</char> tee. Nʼabufuw sɔree wɔ wɔn anwiinwii no ho. Eyi nti, <char style="nd">Awurade</char> maa ogya bɛhyew beae a na wɔte hɔ no mfikyiri baabi. <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>Wɔteɛteɛɛ mu frɛɛ Mose sɛ ommegye wɔn no, ɔbɔɔ mpae srɛɛ <char style="nd">Awurade</char> maa wɔn na ogya no dumii. <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>Efi saa bere no, wɔtoo beae hɔ din se Tabera a ne nkyerɛase ne “Ahyewee,” efisɛ ogya a efi <char style="nd">Awurade</char> nkyɛn no hyew wɔn atenae hɔ.<verse eid="NUM 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>Misraimfo a na wɔwɔ wɔn ntam no kɔn dɔɔ nneɛma pa a na ɛwɔ Misraim no. Eyi amma Israelfo no ani ansɔ baabi a na wɔwɔ hɔ no, enti wosui se, “Hena na ɔbɛma yɛn aduan adi? <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>Yɛkae nsumnam a yɛwee wɔ Misraim mpoano no. Saa ara nso na na yenya kokumba, ɛfere, gyeene ne galik di no. <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>Nanso mprempren de, yɛn anom ato; yenhu hwee sɛ mana nko ara.”<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>Na mana no kɛse te sɛ wusa aba na ɛsɛ ɛhyɛ a awaawae afi dubona ho agu fam. <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>Nnipa no tase fii fam na wɔayam anaa wɔasiw wɔ ɔwaduru mu ma adan esiam. Wowie a, wɔnoa de bi yɛ tetare. Woka wʼano a, ɛte sɛ tetare a wɔakyew wɔ nhabamma ngo mu. <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>Obosu tɔ wɔ wɔn atenae hɔ Anadwo a na mana no nso tɔ.<verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>Mose tee sɛ mmusuakuw no nyinaa gyinagyina, atwa wɔn ntamadan ho ahyia resu. Eyi hyɛɛ <char style="nd">Awurade</char> abufuw yiye, na ɛhaw Mose nso. <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>Mose bisaa <char style="nd">Awurade</char> se, “Adɛn nti na wode ɔhaw sɛɛ aba wʼakoa so? Dɛn na mayɛ atia wo a na wode saa nnipa a wɔte sɛɛ yi nyinaa adesoa abɛsoa me? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>Me na minyinsɛn nnipa yi nyinaa? Me na mewoo wɔn? Adɛn nti na wuse minturu wɔn wɔ me nsa so sɛ nkokoaa nkosi sɛ yebedu asase a wohyɛɛ wɔn agyanom ho bɔ no so? <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>Ɛhefa na merekɔfa nam abrɛ nnipa yi? Wosu kyerɛ me se, ‘Ma yɛn nam nwe!’ <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>Me nko ara rentumi nsoa ɔman yi! Adesoa no mu yɛ duru ma me dodo! <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>Na sɛ saa na wo ne me bedi no de a, mesrɛ, kum me, sɛ manya wʼanim anuonyam a, na mma minnhyia mʼankasa me sɛe.”<verse eid="NUM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Frɛ Israelfo mpanyimfo no mu aduɔson ma me; fa wɔn bra Ahyiae Ntamadan no mu na wo ne wɔn nnyina hɔ. <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>Mɛba hɔ na me ne wo abɛkasa na honhom a ɛwɔ wo so no, mɛfa na mede akogu wɔn nso so bi; ɛba saa a, wɔne wo bɛsoa nnipa no adesoa sɛnea ɛrenyɛ wo nko ara wʼadesoa.<verse eid="NUM 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18"/>“Ka kyerɛ nnipa no se: Munnwira mo ho na ɔkyena, mubenya nam awe. Ka kyerɛ wɔn se, ‘<char style="nd">Awurade</char> ate mo sufrɛ a ɛfa nneɛma a mugyaw no Misraim no ho na ɔrebɛma mo nam na mobɛwe. <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>Ɛnyɛ da koro anaa nnaanu anaa nnaanum anaa nnadu anaa aduonu! <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>Na ɔsram baako mu, mobɛwe nam ara ama afono mo ama afa mo hwene mu. Efisɛ moapo <char style="nd">Awurade</char> a ɔka mo ho wɔ ha no, na moasu wɔ nʼanim se, adɛn nti na yefii Misraim?’ ”<verse eid="NUM 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>Mose kae se, “Mmarima nko ara mpem ahansia na wɔwɔ ha, ɛno na woahyɛ wɔn bɔ sɛ wobɛma wɔn nam awe ara ɔsram! <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>Sɛ yekum nguan ne anantwi ma wɔn a ɛbɛso wɔn ana? Sɛ wɔkyere po mu nam nyinaa ma wɔn a ɛbɛso wɔn ana?”<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>Na <char style="nd">Awurade</char> bisaa Mose se, “So <char style="nd">Awurade</char> basa yɛ tiaa dodo ana? Afei wubehu sɛ mʼasɛm yɛ nokware anaa ɛnyɛ nokware.”<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>Enti Mose fii Ahyiae Ntamadan no mu hɔ kɔkaa nsɛm a <char style="nd">Awurade</char> ka kyerɛɛ no no nyinaa kyerɛɛ nnipa no. Ɔboaboaa mpanyimfo aduɔson ano ma wotwaa Ahyiae Ntamadan no ho hyiae. <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>Na <char style="nd">Awurade</char> nam omununkum mu baa fam ne Mose kasae, na ɔfaa honhom a ɛwɔ Mose so no de guu mpanyimfo aduɔson no so. Bere a honhom no baa wɔn so kakra no, wɔhyɛɛ nkɔm mmere tiaa bi mu.<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>Nanso na mpanyimfo aduɔson no mu baanu a wɔfrɛ wɔn Eldad ne Medad da so wɔ wɔn atenae hɔ. Na bere a honhom no baa wɔn so wɔ hɔ no, wɔhyɛɛ nkɔm wɔ hɔ. <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>Mmerante bi tuu mmirika kɔbɔɔ Mose asɛm a asi no ho amanneɛ <verse eid="NUM 11:27"/><verse number="28" style="v" sid="NUM 11:28"/>na Nun babarima Yosua a na wɔayi no sɛ ɔnyɛ Mose boafo no ampene so, na ɔkae se, “Me wura Mose, ma wonnyae!”<verse eid="NUM 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29"/>Mose bisaa no se, “Me ho na woretwe ninkunu yi? Ɛkaa me nko a, na anka <char style="nd">Awurade</char> nkurɔfo nyinaa yɛ adiyifo a <char style="nd">Awurade</char> de ne honhom agu wɔn nyinaa so!” <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>Na Mose ne Israel mpanyimfo no san kɔɔ wɔn atenae hɔ.<verse eid="NUM 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>Na <char style="nd">Awurade</char> bɔɔ ahum maa ɛde mmoko fi po mu beguu atenae hɔ ne ɛho mmaa nyinaa. Baabiara a obi bɛfa no, na nnomaa yi bi atu nenam asase ani bɛyɛ anammɔn anan. <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>Enti da mu no nyinaa, nnipa kyekyeree mmoko no bi kunkum wɔn awia ne anadwo ne nʼadekyee nso. Nea wannya bi no koraa na onyaa susukoraa ɔha! Mmoko buu so wɔ atenae hɔ nyinaa. <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>Na nnipa no fii ase wee mmoa no bi no, <char style="nd">Awurade</char> bo san fuw wɔn maa ɔde ɔyaredɔm kum wɔn mu fa kɛse no ara. <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>Enti wɔtoo beae hɔ din se Kibrot-Hataawa a nkyerɛase ne, “Akɔnnɔ ɔda” efisɛ wɔn a na wɔn ani bere nam na wɔn kɔn adɔ Misraim tena no na wosiee wɔn wɔ hɔ.<verse eid="NUM 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35"/>Ɔman no tu fii Kibrot-Hataawa hɔ kɔtenaa Haserot.<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">Miriam Ne Aaron Tia Mose</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>Miriam ne Aaron kasa tiaa Mose sɛ ne yere yɛ Etiopiani. <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>Wɔkae se, “Mose nko ara na <char style="nd">Awurade</char> akasa afa ne so ana? Na yɛn nso ɔnkasa mfa yɛn so bi ana?” Na <char style="nd">Awurade</char> tee wɔn anwiinwii no.<verse eid="NUM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3"/>Na Mose yɛ ɔhobrɛaseni sen obiara a ɔte asase yi so.<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>Ntɛm so, <char style="nd">Awurade</char> frɛɛ Mose, Aaron ne Miriam kɔɔ Ahyiae Ntamadan no mu. Ɔhyɛɛ wɔn se, “Mo baasa no mommra Ahyiae Ntamadan mu ha.” Enti wobegyinagyinaa <char style="nd">Awurade</char> anim. <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>Afei, <char style="nd">Awurade</char> nam omununkum fadum mu sian ba begyinaa Ahyiae Ntamadan no kwan ano, na ɔfrɛɛ Aaron ne Miriam. Bere a wotwiw kɔɔ wɔn anim no, <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>ɔkae se, “Muntie me nsɛm:</para>
  <para style="q1" vid="NUM 12:6">“Sɛ odiyifo wɔ mo mu a,</para>
  <para style="q2" vid="NUM 12:6">Me, <char style="nd">Awurade</char>, menam anisoadehu so da me ho adi kyerɛ no,</para>
  <para style="q2" vid="NUM 12:6">me kasa kyerɛ no wɔ dae mu.<verse eid="NUM 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7"/>Nanso ɛnte saa wɔ me somfo Mose ho.</para>
  <para style="q2" vid="NUM 12:7">Me fi nyinaa mu no, ɔyɛ ɔnokwafo.<verse eid="NUM 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8"/>Me ne no kasa anim ne anim,</para>
  <para style="q2" vid="NUM 12:8">kasa a emu da hɔ na ɛnyɛ abisae mu.</para>
  <para style="q2" vid="NUM 12:8">Na ohu <char style="nd">Awurade</char> sɛnea ɔte.</para>
  <para style="q1" vid="NUM 12:8">Adɛn nti na moansuro</para>
  <para style="q2" vid="NUM 12:8">sɛ mobɛkasa atia me somfo Mose?”<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>
    <char style="nd">Awurade</char> bo fuw wɔn dennen pa ara na ofii hɔ kɔe.<verse eid="NUM 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10"/>Bere a omununkum no fii Ahyiae Ntamadan no atifi no, kwata beduruu Miriam ho fitaa sɛ sukyerɛmma. Aaron twaa nʼani huu sɛ ɔwɔ ɔhonam ani yare a ɛyɛ fi no, <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>ɔka kyerɛɛ Mose se, “Me wura, mesrɛ wo, nnyina saa bɔne a yɛnam nkwaseasɛm so adi yi so ntwe yɛn aso. <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>Mma no nyɛ sɛ akokoaa a wawu wɔ ne yam a ne fa aporɔw.”<verse eid="NUM 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13"/>Na Mose teɛɛ mu frɛɛ <char style="nd">Awurade</char> se, “Onyankopɔn, mesrɛ wo sɛ sa no yare!”<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>
    <char style="nd">Awurade</char> buaa Mose se, “Sɛ nʼagya tew ntasu guu nʼanim a, anka nʼanim rengu ase nnanson? Munyi no mfi atenae ha nkɔhyɛ baabi nnanson na akyiri no, obetumi asan aba.” <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>Enti wotwaa Miriam asu fii atenae hɔ ma okodii nnanson. Nnipa no twɛn kosii sɛ wɔsan de no bae ansa na wɔretu kwan no bio.<verse eid="NUM 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 12:16"/>Ɛno akyi no, wofii Haserot bɛbɔɔ atenae wɔ Paran sare so.<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">Akwansrafo Kɔ Kanaan Asase So</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>Na <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>“Soma akwansrafo na wɔnkɔ Kanaan asase so; asase a mede rema Israelfo no. Soma mmusuakuw dumien no mu biara ntuanoni.”<verse eid="NUM 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3"/>Enti Mose yɛɛ sɛnea <char style="nd">Awurade</char> hyɛɛ no no. Ɔsomaa mmarima dumien a wɔn nyinaa yɛ mmusuakuw ntuanofo fi wɔn atenae wɔ Paran sare so.<verse eid="NUM 13:3"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="4" style="v" sid="NUM 13:4"/>Saa mmusuakuw no ne wɔn mpanyimfo no din na edidi so yi:</para>
  <para style="b" vid="NUM 13:4"/>
  <para style="li1" vid="NUM 13:4">Ruben abusuakuw no ntuanoni ne Sakur babarima Samua;<verse eid="NUM 13:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5"/>Simeon abusuakuw no ntuanoni ne Hori babarima Safat;<verse eid="NUM 13:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6"/>Yuda abusuakuw no ntuanoni ne Yefune babarima Kaleb;<verse eid="NUM 13:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7"/>Isakar abusuakuw no ntuanoni ne Yosef babarima Igal;<verse eid="NUM 13:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8"/>Efraim abusuakuw no ntuanoni ne Nun babarima Hosea;<verse eid="NUM 13:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9"/>Benyamin abusuakuw no ntuanoni ne Rafu babarima Palti;<verse eid="NUM 13:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10"/>Sebulon abusuakuw no ntuanoni ne Sodi babarima Gadiel;<verse eid="NUM 13:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11"/>Manase abusuakuw (a ɛyɛ Yosef abusuakuw no mu fa) no ntuanoni ne Susi babarima Gadi;<verse eid="NUM 13:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12"/>Dan abusuakuw no ntuanoni ne Gemali babarima Amiel;<verse eid="NUM 13:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13"/>Aser abusuakuw no ntuanoni ne Mikael babarima Setur;<verse eid="NUM 13:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14"/>Naftali abusuakuw no ntuanoni ne Wofsi babarima Nahbi;<verse eid="NUM 13:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15"/>Gad abusuakuw no ntuanoni ne Maki babarima Geuel.<verse eid="NUM 13:15"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="16" style="v" sid="NUM 13:16"/>Nnipa yi na Mose somaa wɔn ma wɔkɔsraa Kanaan asase no. Mose na ɔmaa Nun ba Hosea din Yosua.<verse eid="NUM 13:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>Mose ka kyerɛɛ wɔn se, “Monkɔ atifi fam wɔ Negeb bepɔw no so. <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>Monhwɛ sɛnea ɛhɔ asase no te; na monhwɛ wɔn a wɔte hɔ no nso tebea sɛ wɔwɔ ahoɔden anaa wɔyɛ mmerɛw, sɛ wɔdɔɔso anaa wosua. <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>Asasesu bɛn na wɔte so? Eye anaasɛ enye? Nkurowsu bɛn na wɔtete mu? Ɛdeda hɔ petee anaasɛ afasu wowɔ ho? <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>Dɔte no te dɛn? Srade wɔ mu anaasɛ ɛyɛ kwaboo? Nnua wɔ so anaasɛ nnua nni so? Mommɔ mmɔden na momfa ɛhɔ nnɔbae no bi mmra.” Saa bere no na wɔretew bobe aba kan.<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>Enti wɔkɔsraa asase no fi Sin sare so kosii Rehob a ɛbɛn Hamat no. <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>Wɔfaa atifi fam kɔfaa Negeb beduu Hebron. Ɛhɔ na wohuu Anak asefo a wɔfrɛ wɔn Ahiman, Sesai ne Talmai. Hebron yɛ kurow dedaw. Wɔkyekyeree saa kurow no mfe ason ansa na wɔrekyekyere Soan a ɛwɔ Misraim no. <verse eid="NUM 13:22"/><verse number="23" style="v" sid="NUM 13:23"/>Woduu Eskol bon mu no, wotwaa mman a bobe kasiaw wɔ so. Mmarima baanu na wɔworaa no dua soa kaa borɔdɔma aba ho de kɔe. <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>Saa bere no, Israelfo no too subon hɔ din sɛ “Eskol bon mu” a nkyerɛase ne “Kasiaw,” efisɛ wohuu bobe kasiaw pii wɔ hɔ. <verse eid="NUM 13:24"/><verse number="25" style="v" sid="NUM 13:25"/>Adaduanan akyi no, wofii wɔn akwansra no mu bae.<verse eid="NUM 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26"/>Wɔkaa nea wokohui nyinaa kyerɛɛ Mose ne Aaron ne nnipa a wɔwɔ Israel nyinaa ne wɔn a wɔwɔ Paran sare so wɔ Kades na wɔde aduaba a wɔde bae no kyerɛe. <verse eid="NUM 13:26"/><verse number="27" style="v" sid="NUM 13:27"/>Asɛm a wɔbɛkae ne sɛ, “Yeduu asase a wosomaa yɛn sɛ yɛnkɔsra so no so, na ɛwo ne nufusu sen wɔ so ampa! Ɛso aduaba a yɛde bae ni. <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>Nanso na nnipa a wɔtete hɔ no yɛ den. Wɔn nkurow no soso na wɔabɔ ho ban nso. Yehuu Anak asefo wɔ hɔ mpo. <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>Amalekfo te anafo na Hetifo, Yebusifo ne Amorifo nso tete mmepɔw so. Na Kanaanfo nso tete Ntam Po no ne Yordan subon ho.”<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>Na Kaleb bɔɔ nnipa no ano wɔ Mose anim kae se, “Momma yɛmforo nkɔ hɔ prɛko pɛ na yɛnkɔfa asase no, efisɛ yebetumi adi wɔn so nkonim.”<verse eid="NUM 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31"/>Nanso mmarima a wɔne no kɔe no kae se, “Yɛrentumi nkɔtoa saa nnipa yi; wɔn ho yɛ den sen yɛn.” <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>Na wɔde asɛm a ɛmma akomatɔyam fa asase a wɔkɔsraa so no ho tene faa Israelfo no mu nyinaa. Wose, “Asase a yɛkɔsraa so no sofo no yɛ awudifo nkutoo. Nnipa a yehuu wɔn wɔ hɔ no yɛ abran. <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>Yehuu Anakfo no bi a efi awo ntoatoaso mu wɔyɛ abran no. Sɛ yɛne wɔn gyina hɔ a, na yɛayɛ te sɛ nketekre wɔ yɛn ani so. Na saa ara nso na yɛyɛɛ wɔ wɔn ani so.”<verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">Nnipa No Tew Atua</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>Saa anadwo no, nnipa no nyinaa fii ase suu denneennen. <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>Wɔde nne koro nwiinwii tiaa Mose ne Aaron. Wɔkae se, “Sɛ yewuwuu wɔ Misraim anaa sare so ha a, anka eye. <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/>Adɛn nti na <char style="nd">Awurade</char> de yɛn reba ha sɛ yɛmmɛtotɔ wɔ mfoa ano? Wɔbɛfow yɛn yerenom ne yɛn mma. So ennye mma yɛn sɛ yɛbɛsan akɔ Misraim ana?” <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>Na wosisee wɔn ho wɔn ho sɛ, “Ɛsɛ sɛ yɛpaw ɔkannifo na yɛsan kɔ Misraim.”<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>Afei, Mose ne Aaron de wɔn anim butubutuu fam wɔ Israelfo a wɔahyia hɔ no nyinaa anim. <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>Akwansrafo no mu baanu, a wɔne Nun babarima Yosua ne Yefune babarima Kaleb sunsuan wɔn ntade mu <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>na wɔka kyerɛɛ Israelfo no nyinaa se, “Asase a yɛfaa mu no yɛ asase pa yiye. <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/>Na sɛ yɛsɔ <char style="nd">Awurade</char> ani a, ɔde yɛn bedu asase no so dwoodwoo, asase bere a nufusu ne ɛwo sen wɔ so, na ɔde bɛma yɛn. <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>Monnyɛ dɔm ntia <char style="nd">Awurade</char>. Na munnsuro nnipa a wɔwɔ asase no so no nso, efisɛ yɛbɛmemene wɔn. Wonni bammɔ, nanso <char style="nd">Awurade</char> ka yɛn ho. Munnsuro wɔn.”<verse eid="NUM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10"/>Nanso mmuae a nnipa no mae ara ne sɛ, wobesiw wɔn abo. Afei, <char style="nd">Awurade</char> anuonyam baa Ahyiae Ntamadan no mu kyerɛɛ Israelfo no nyinaa. <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/><char style="nd">Awurade</char> bisaa Mose se, “Nnipa yi bebu me animtiaa akosi da bɛn? Anwonwade dodow a mayɛ akyerɛ wɔn yi nyinaa akyi no, wonnye me nni ara? <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>Mɛma ɔyaredɔm abeduru wɔn na asɛe wɔn, nanso mɛyɛ mo ɔman kɛse a ɛwɔ ahoɔden sen wɔn.”<verse eid="NUM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>Mose ka kyerɛɛ <char style="nd">Awurade</char> se, “Na Misraimfo no bɛte! Wonam wo tumi so yii saa nnipa yi fii wɔn mu. <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>Wɔaka saa asɛm yi akyerɛ wɔn a wɔte asase yi so a wonim sɛ wowɔ Israel afa, na wo ne wɔn kasa anim ne anim. Wohu omununkum dum ne ogya sɛ egyina yɛn atifi, na wonim sɛ wudi yɛn anim bɔ yɛn ho ban awia ne anadwo. <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>Na sɛ wukum wo nkurɔfo yi nyinaa a, aman a wɔate wo din no bɛka se, <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>‘<char style="nd">Awurade</char> kum wɔn wɔ sare no so, efisɛ wantumi amfa wɔn ankodu asase a ɔkaa ho ntam sɛ ɔde bɛma wɔn no so.’<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17"/>“Afei <char style="nd">Awurade</char> nna nʼahoɔden adi, sɛnea wahyɛ no: <verse eid="NUM 14:17"/><verse number="18" style="v" sid="NUM 14:18"/>‘<char style="nd">Awurade</char> yɛ nyaa wɔ nʼabufuw mu, na ne dɔ ne bɔne ne atuatew so bɔnefakyɛ no boro so. Nanso onnyaw ɔfɔdifo a ɔntwe nʼaso; ɔtwe mma aso wɔ agyanom bɔne ho kosi awo ntoatoaso abiɛsa ne nan mu.’ <verse eid="NUM 14:18"/><verse number="19" style="v" sid="NUM 14:19"/>Wo dɔ kɛse no nti, fa saa nnipa yi bɔne kyɛ wɔn sɛnea wode akyɛ wɔn afi Misraim abesi saa bere yi.”<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>
    <char style="nd">Awurade</char> kaa se, “Mede akyɛ wɔn sɛnea woabisa no. <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>Nanso sɛ mete ase yi, na <char style="nd">Awurade</char> anuonyam ahyɛ asase nyinaa ma yi, <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>saa nnipa yi a wohuu mʼanuonyam ne anwonwade a meyɛɛ wɔ Misraim ne sare so no nanso wɔyɛɛ asoɔden de sɔɔ me hwɛɛ mpɛn du no, <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>wɔn mu biara renhu asase a mekaa ntam de hyɛɛ wɔn agyanom bɔ no. Wɔn a wobuu me animtiaa no mu biara renhu. <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>Nanso sɛnea ɛsono mʼakoa Kaleb honhom na ofi ne koma nyinaa mu di mʼakyi no nti mede no bɛkɔ asase a ɔkɔɔ so no so, na nʼasefo benya ɛhɔ mu kyɛfa. <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>Esiane sɛ Amalekfo na Kanaanfo tete abon mu no nti, ɔkyena, momfa mo ani nkyerɛ Po Kɔkɔɔ no nkɔ sare no so.”<verse eid="NUM 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>
    <char style="nd">Awurade</char> bisaa Mose ne Aaron se, <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>“Enkosi da bɛn na saa nnipa bɔnefo yi benwiinwii atia me? Na mate saa Israelfo yi anwiinwiisɛm yi nyinaa. <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>Enti ka kyerɛ wɔn se, ‘<char style="nd">Awurade</char> na ose, sɛ mete ase yi, mɛyɛ nea metee sɛ moreka no ama mo. <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>Mo nyinaa mubewuwu wɔ sare no so: Efi wɔn a wɔadi mfe aduonu rekɔ no a wɔkan wɔn bi na wɔka ho nwiinwii tiaa me no. <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>Mo mu biara renkɔ Bɔhyɛ Asase no so. Wɔn a wɔbɛkɔ hɔ ara ne Yefune babarima Kaleb ne Nun babarima Yosua. <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>Moka se mo mma bɛyɛ nnipa a wɔte asase no so no nkoa. Mede wɔn bɛkɔ asase no so dwoodwoo ama wɔakɔfa nea muse mompɛ no. <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>Na mo de, mo amu na ɛbɛka sare so ha. <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>Wɔbɛhwɛ mo mma so wɔ ha mfe aduanan, na wɔahu amane wɔ mo gyidi a munni no nti; akosi sɛ onipa a otwa to no bewu atɔ sare so ha. <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>Esiane sɛ akwansrafo no tenaa asase no so adaduanan no nti, ɛsɛ sɛ mo nso mukyinkyin sare no so mfe aduanan a afe biara gyina hɔ ma da koro a ɛyɛ mo bɔne so akatua, na moahu sɛnea ɛte sɛ mɛsɔre atia mo.’ <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>Me, <char style="nd">Awurade</char>, na makasa, na nea ɛte biara no mɛyɛ eyinom atia saa nnipa bɔnefo yi a wayɛ dɔm atia me no. Wobehu wɔn awiei wɔ sare yi so; ɛha na wobewuwu.”<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>Enti mmarima a Mose somaa wɔ ma wɔkɔsraa asase no so no, wɔn a wɔsan ba bɛbɔɔ amanneɛ bɔne a ɛnam so maa nnipa no nyinaa nwiinwii tiaa me no, <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>wɔde ɔyare bɔne kunkum saa mmarima a wɔde amanneɛ bɔne tenee wɔ <char style="nd">Awurade</char> anim no. <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>Akwansrafo no nyinaa, Nun ba Yosua ne Yefune ba Kaleb nko ara na wɔtenaa ase.<verse eid="NUM 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>Mose kɔkaa nsɛm a Onyankopɔn ka kyerɛɛ no no kyerɛɛ nnipa no no, wɔn nyinaa werɛ howee yiye. <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>Wɔsɔree anɔpahema sɛ wɔrekɔ Bɔhyɛ Asase no so. Wɔkae se, “Yɛahu sɛ yɛayɛ bɔne, nanso yɛasiesie yɛn ho sɛ yɛbɛkɔ asase a <char style="nd">Awurade</char> hyɛɛ yɛn ho bɔ no so.”<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>Nanso Mose kae se, “Adɛn na morebu <char style="nd">Awurade</char> ahyɛde so? Eyi renyɛ ye! <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>Monsan, mo atamfo no bedi mo so nkonim, efisɛ <char style="nd">Awurade</char> nka mo ho. <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>Amalekfo ne Kanaanfo no behyia mo wɔ hɔ wɔ hɔ? Esiane sɛ moapa <char style="nd">Awurade</char> nti, ɔrenka mo ho na mobɛtotɔ wɔ afoa no.”<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>Nanso wofii wɔn nsusuwii mu foro kɔɔ bepɔw no so a amfa wɔn ho sɛ <char style="nd">Awurade</char> Apam adaka no ne Mose mu biara antu amfi atenae hɔ bi. <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>Na Amalekfo ne Kanaanfo a wɔte bepɔw no so no sian ba bɛtow hyɛɛ wɔn so boroo wɔn ara kosii Horma.<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s1">Afɔrebɔ Nkekaho Ahorow Ho Mmara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>“Ka kyerɛ Israelfo no se, ‘Sɛ mokɔtena asase a mede rema mo no so <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>na mopɛ sɛ mobɔ ɔhyew afɔre anaa afɔre biara a wɔbɔ a eyi hua a ɛsɔ <char style="nd">Awurade</char> ani a, ɛsɛ sɛ afɔrebɔde no yɛ aboa a ofi mo nguankuw anaa nantwibuw mu. Sɛ ɛyɛ ɔhyew afɔre, anaa afɔrebɔ a wɔde hyɛ bɔ, anaa afɔrebɔ a efi ɔpɛ mu, anaa afɔrebɔ a wɔbɔ no afirihyia mu nnapɔnna bi mu no a, ɛsɛ sɛ wɔde aduan afɔrebɔde ka ho. <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>Nea ɔde ba no, ɛsɛ sɛ ɔde aduan afɔrebɔde a ɛyɛ esiam muhumuhu kilogram abien a wɔde ngo lita baako afra ka ho ma <char style="nd">Awurade</char>. <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>Oguamma biara a wɔde bɔ ɔhyew afɔre no, ɛsɛ sɛ wɔde nsa afɔrebɔde a ɛyɛ bobesa lita baako ka ho.<verse eid="NUM 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6"/>“ ‘Sɛ odwennini na wode rebɔ afɔre a, fa esiam muhumuhu lita abiɛsa fra ngo lita baako, <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>ne bobesa lita baako sɛ ɔnom afɔrebɔde. Mommɔ mma enyi hua a ɛbɛsɔ <char style="nd">Awurade</char> ani.<verse eid="NUM 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8"/>“ ‘Sɛ wosiesie nantwi ba ma ɔhyew afɔre anaa afɔrebɔde de hyɛ bɔ sononko bi anaa ayɔnkofa asikresiam afɔre a worebɔ ama <char style="nd">Awurade</char> a, <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>fa atoko afɔrebɔde a ɛyɛ asikresiam a wɔayam no muhumuhu lita asia ne fa ne ngo lita abien ka nantwi no ho <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>a bobesa lita abien ka ho sɛ ɔnom afɔrebɔde. Eyi bɛyɛ aduan afɔrebɔ a ebeyi hua asɔ <char style="nd">Awurade</char> ani. <verse eid="NUM 15:10"/><verse number="11" style="v" sid="NUM 15:11"/>Ɛsɛ sɛ wɔfa saa kwan yi so siesie nantwi, odwennini, oguamma anaa abirekyi ba a wɔde bɔ afɔre no. <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>Afɔrebɔde biara no, ɛsɛ sɛ mofa saa ɔkwan yi so siesie no.<verse eid="NUM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13"/>“ ‘Ɛsɛ sɛ Israelni biara fa saa ɔkwan yi so siesie ne aduan afɔrebɔ a eyi hua na ɛsɔ <char style="nd">Awurade</char> ani na ɔde ba. <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>Na sɛ ahɔho a wɔte mo mu no pɛ sɛ wɔbɔ ɔhyew afɔre ma eyi hua a ɛsɔ <char style="nd">Awurade</char> ani a, ɛsɛ sɛ wɔfa saa ɔkwan koro no ara so wɔ awo ntoatoaso a ɛbɛba no nyinaa mu. <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>Mmara no wɔ hɔ ma mo nyinaa; ɔmanfo ne ahɔho; na ɛyɛ nokware a etim hɔ daa de kosi awo ntoatoaso a ɛbɛba no mu. Mo ne ahɔho nyinaa yɛ pɛ wɔ <char style="nd">Awurade</char> anim. <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>Mmara baako na ɛwɔ hɔ ma mo ne ahɔho a wɔtete mo mu no nyinaa.’ ”<verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>“Kasa kyerɛ Israelfo no se: ‘Sɛ mudu asase a mede mo rekɔ so no so <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>na mudi asase no so aduan a, momfa bi mmɔ afɔre mma <char style="nd">Awurade</char>. <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>Atoko a mobɛyam a edi kan no, momfa nto ɔfam nto nkyɛn sɛ akyɛde sɛnea moyɛ atoko otwakan no wɔ awiporowbea no. <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>Awo ntoatoaso a ɛbɛba no nyinaa mu no, ɛsɛ sɛ mode saa afɔre a efi mo aduan a edi kan a moanya mu yi ma <char style="nd">Awurade</char>.<verse eid="NUM 15:21"/></para>
  <para style="s1">Bɔne A Wɔanhyɛ Da Anyɛ Ho Afɔrebɔ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>“ ‘Sɛ mo, sɛ nnipakuw, anhyɛ da na mubu saa mmara a <char style="nd">Awurade</char> nam Mose so de ama mo yi so, <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>mmara ahorow a <char style="nd">Awurade</char> nam ne so de ama mo yi so, efi da a <char style="nd">Awurade</char> de maa mo de fa awo ntoatoaso a ɛbɛba no nyinaa mu, <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>na sɛ wɔnam awerɛfiri so fom a nnipa no nyinaa nnim a, ɛsɛ sɛ ɔman no nyinaa de aduan afɔrebɔde ne ɔnom afɔrebɔde ne ɔpapo a wɔde no bɛbɔ bɔne ho afɔre ka ho. <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>Na ɛsɛ sɛ ɔsɔfo no yɛ mpata ma Israelfo nyinaa na wɔde wɔn bɔne akyɛ wɔn; efisɛ, ɛyɛ mfomso, na wɔnam ɔhyew afɔrebɔ so abɔ afɔre wɔ <char style="nd">Awurade</char> anim a wɔn bɔne afɔrebɔde ka ho. <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>Wɔde nnipa no nyinaa a ahɔho a wɔte wɔn mu ka ho no bɔne bɛkyɛ wɔn, efisɛ ɔmanfo no nyinaa na wɔyɛɛ mfomso a wɔanhyɛ da; na wɔde akyɛ wɔn nyinaa.<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>“ ‘Nanso sɛ onipa baako bi yɛ mfomso awerɛfiri mu a, ɛsɛ sɛ ɔde abirekyibere ba a wadi afe bɛbɔ bɔne ho afɔre. <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>Ɛsɛ sɛ ɔsɔfo no yɛ mpata ma nea ɔfom no wɔ <char style="nd">Awurade</char> anim na wɔde ne bɔne akyɛ no. <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>Saa mmara yi wɔ hɔ ma Israelfo ne ananafo a wɔte mo mu no nyinaa.<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>“ ‘Na sɛ obi boa pa yɛ mfomso a, sɛ ɔyɛ Israelni anaa ɔnanani no, ogu <char style="nd">Awurade</char> din ho fi, enti ɛsɛ sɛ woyi no fi Israelfo no mu. <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>Mpɛn dodow a wabu <char style="nd">Awurade</char> asɛm animtiaa na wahyɛ da abu <char style="nd">Awurade</char> mmara so no, ɛsɛ sɛ woyi no fi Israelfo no mu; na ne bɔne gu ne ti so.’ ”<verse eid="NUM 15:31"/></para>
  <para style="s1">Homeda Sobu Ho Asotwe</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>Bere a Israelfo no wɔ sare so no, wɔkyeree wɔn mu baako sɛ ɔrebubu mmabaa homeda. <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>Wɔn a wɔkyeree no no de no kɔɔ Mose ne Aaron ne atemmufo no anim, <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>na wɔde no too afiase, efisɛ na wonhu ɔkwan pɔtee a ɛsɛ sɛ wɔde no fa so. <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Ɛsɛ sɛ wokum saa onipa no. Nnipa no nyinaa nsiw no abo wɔ atenae no akyi baabi.” <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>Enti wɔde no kɔɔ atenae no akyi baabi kosiw no abo sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no.<verse eid="NUM 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>“Kasa kyerɛ Israelfo no se: Awo ntoatoaso nyinaa mu no, momma biribi nsensɛn mo ntade ano na momfa hama tuntum nkyekyere sɛ nkae ade ntetare ntade no ano. <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>Saa mmara yi botae ne sɛ, bere biara a mubehu saa ade yi no, mobɛkae <char style="nd">Awurade</char> mmara a wɔahyɛ mo no, na moadi nʼapɛde so, na moamfa mo ankasa mo akwan sɛnea na moyɛ de som anyame afoforo no. <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>Ɛbɛkae mo ama moadi me mmara nyinaa so na wɔbɛtew mo ho ama mo Nyankopɔn. <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>Mene <char style="nd">Awurade</char>, mo Nyankopɔn a mede mo fi Misraim asase so bae sɛ mɛyɛ mo Nyankopɔn. Mene <char style="nd">Awurade</char> mo Nyankopɔn no.”<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">Kora Atuatew</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>Kora, Ishar a ɔyɛ Lewi babarima Kohat aseni ne Datan ne Abiram a wɔyɛ Eliab mmabarima ne On a ɔyɛ Pelet babarima a wɔn baasa no fi Ruben abusuakuw mu no yɛɛ ahomaso <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>na wɔsɔre tiaa Mose. Na mpanyimfo atitiriw ahannu aduonum a wɔn nyinaa fra agyinatukuw no mu no ka ho. <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>Wɔkɔɔ Mose ne Aaron hɔ kɔka kyerɛɛ wɔn se, “Mo ahomaso no amee yɛn; monnyɛ kronkron nsen obiara. <char style="nd">Awurade</char> na wayi obiara a ɔwɔ Israel ha na ɔka yɛn nyinaa ho. Tumi bɛn na mowɔ sɛ moma mo ho so sɛ moyɛ mpanyimfo a ɛsɛ sɛ yetie mo na afei moma mo ho so sen obiara wɔ bere a yɛn nyinaa yɛ <char style="nd">Awurade</char> mma?”<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>Mose tee saa asɛm no, ɔde nʼanim butuw fam. <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>Ɔka kyerɛɛ Kora ne wɔn a wɔka ne ho no se, “Anɔpa, <char style="nd">Awurade</char> bɛkyerɛ mo wɔn a wɔyɛ ne dea ne nea ɔyɛ kronkron ne nea wayi no sɛ ɔmmɛn no. <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>Nea ɛsɛ sɛ wo, Kora ne wʼakyidifo nyinaa yɛ ni: Momfa aduhuamyɛfo nkuku <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>na ɔkyena monhyew aduhuam wɔ mu wɔ <char style="nd">Awurade</char> anim. Na nea Awurade bɛpaw no no na ɔbɛyɛ ɔkronkronni. Afei de, Lewifo moayɛ ama aboro so!”<verse eid="NUM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8"/>Mose san bisaa Kora se, “Afei mo Lewifo, muntie! <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>Yi a Israel Nyankopɔn ayi wo afi nnipa bebree mu ama woabɛn no pɛɛ no, a woyɛ <char style="nd">Awurade</char> Ahyiae Ntamadan mu adwuma, na wutumi gyina nnipa anim yɛ asɔfodwuma no sua ma wo ana? <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>Ɔde wo ne wo mfɛfo Lewifo nyinaa abɛn no pɛɛ, nanso afei de, woagyina pintinn sɛ woregye asɔfodwuma no nso. <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>Ɛyɛ <char style="nd">Awurade</char> na wo ne wʼakyidifo abɔ mu atia no no. Hena ne Aaron a wunwiinwii tia no?”<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>Afei Mose frɛɛ Eliab mmabarima Datan ne Abiram, nanso wobuae se, “Yɛremma! <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>So esua ma wo sɛ wode yɛn fi yɛn asase a nufusu ne ɛwo sen wɔ so no so de yɛn aba sare so sɛ worebekum yɛn ana? Na afei, wopɛ sɛ wohyɛ yɛn so nso! <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>Bio, womfaa yɛn mmaa asase a ɛwo ne nufusu sen wɔ so so anaa nso wommaa yɛn asase ne bobeturo biara sɛ yɛn agyapade. Wopɛ sɛ wode saa nnipa yi yɛ nkoa ana? Dabi, yɛremma.”<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>Mose bo fuw na ɔka kyerɛɛ <char style="nd">Awurade</char> se, “Nnye wɔn afɔrebɔde biara! Minwiaa wɔn afurum baako mpo na menyɛɛ wɔn mu biara bɔne bi.”<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>Mose ka kyerɛɛ Kora se, “Ɔkyena wo ne wʼakyidifo no nyinaa mmra <char style="nd">Awurade</char> anim wɔ ha; wo ne wɔn ne Aaron. <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>Obiara mfa nʼaduhuamyɛfo nkuku a aduhuam gu so mmra. Obiara mfa aduhuamyɛfo kuku mmra. Ne nyinaa dodow yɛ ahannu aduonum; na momfa mmra <char style="nd">Awurade</char> anim. Mo ne Aaron na ɛsɛ sɛ mode ba.” <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>Enti wɔn mu biara de nʼaduhuamyɛfo kuku a wasɔ aduhuam wɔ mu bae na wɔne Mose ne Aaron begyinagyinaa Ahyiae Ntamadan no ano. <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>Bere a Kora aboa nʼakyidifo a wɔasɔre atia wɔn no nyinaa ano wɔ Ahyiae Ntamadan no ano no, <char style="nd">Awurade</char> daa nʼanuonyam adi kyerɛɛ nnipa no nyinaa. <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/>Na Awurade ka kyerɛɛ Mose ne Aaron se, <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>“Montwe mo ho mfi saa nnipa yi ho na manya kwan asɛe wɔn prɛko.”<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>Nanso Mose ne Aaron de wɔn anim butubutuw fam wɔ <char style="nd">Awurade</char> anim. Wɔsrɛe se, “Ao, Onyankopɔn, amansan nyinaa Nyankopɔn, sɛ onipa baako yɛ bɔne a, na ɛsɛ sɛ wo bo fu nnipa no nyinaa?”<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>“Ka kyerɛ nnipa no se, ‘Mumfi Kora, Datan ne Abiram ntamadan no mu.’ ”<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>Enti Mose kɔɔ Datan ne Abiram ntamadan no mu a na Israel mpanyimfo di nʼakyi. Ɔka kyerɛɛ nnipa no se, <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>Ɔka kyerɛɛ nnipa no se, “Monsan mfi saa nnipabɔnefo yi ntamadan no mu! Mommfa mo nsa nka wɔn biribiara, anyɛ saa a wɔbɛsɛe mo ne wɔn nyinaa, esiane wɔn bɔne nti.” <verse eid="NUM 16:26"/><verse number="27" style="v" sid="NUM 16:27"/>Enti nnipa no fii Kora, Datan ne Abiram ntamadan no mu. Na Datan ne Abiram nso ne wɔn yerenom ne wɔn mma begyinagyinaa wɔn ntamadan no akwan ano.<verse eid="NUM 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28"/>Mose kae se, “Ɛnam eyi so bɛma moahu sɛ, <char style="nd">Awurade</char> na ɔsomaa me sɛ menyɛ nea mayɛ yi nyinaa. Ɛnyɛ me ara mʼadwene mu na mifi yɛɛ saa. <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>Sɛ owu nko ara na ɛbɛto saa nnipa yi, anaa sɛ wohu nea ɛtaa ba nnipa so nko ara a, na ɛnyɛ <char style="nd">Awurade</char> na wasoma me. <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>Na sɛ <char style="nd">Awurade</char> ma ade a ɛyɛ foforo koraa ba, na asase bue nʼanom mene wɔn ne wɔn ahode na sɛ wɔkɔ asaman anikann a, ɛbɛma moahu sɛ, saa nnipa yi abu Awurade animtiaa.”<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>Ka a ɔkaa eyinom wiei ara pɛ, na asase a ɛwɔ wɔn ase no mu paee, <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>na ɛbaee nʼanom menee wɔn ne wɔn abusuafo, wɔn nnamfonom a na wogyinagyina wɔn ho ne wɔn agyapade nyinaa. <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>Wowuraa asase mu anikann kɔɔ asaman na asase no san ka too mu ma wɔyera fii ɔman no mu. <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>Israelfo nyinaa guanee a na wɔreteɛteɛ mu se, “Asase rebɛmene yɛn nso!”<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>Na ogya fi <char style="nd">Awurade</char> nkyɛn bɛhyew nnipa ahannu aduonum a na wɔrehyew aduhuam no nyinaa.<verse eid="NUM 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>“Ka kyerɛ ɔsɔfo Aaron babarima Eleasar sɛ onyi aduhuamyɛfo nkuku no mfi nso no mu, efisɛ ɛyɛ kronkron, na ɔntrɛtrɛw nnyansramma no mu nkɔ akyiri <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>mfi saa nnipa a wɔayɛ bɔne awu no aduhuamyɛfo nkuku no ase. Boro aduhuamhyew nkuku no mma ɛnyɛ ntrantraa na momfa nkata afɔremuka no so. Saa aduhuamyɛfo nkuku yi yɛ kronkron, efisɛ wɔde baa <char style="nd">Awurade</char> anim. Ma ɛnyɛ nsɛnkyerɛnne mma Israelfo no.”<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>Enti ɔsɔfo Eleasar faa wɔn a wɔahyew no aduhuamyɛfo nkuku no na ɔboro maa ɛyɛɛ ntrantraa na ɔde kataa afɔremuka no so, <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>sɛnea <char style="nd">Awurade</char> nam Mose so kyerɛɛ no no. Na Israelfo no nam so akae se obiara a omfi Aaron ase no nni ho kwan sɛ ɔba <char style="nd">Awurade</char> anim bɛhyew aduhuam. Sɛ ɔyɛ saa a, asɛm a ɛtoo Kora ne ne ne dɔm no bi bɛto no.<verse eid="NUM 16:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>Ade kyee anɔpa no, Israelfo no nyinaa nwiinwii tiaa Mose ne Aaron se, “Moakum <char style="nd">Awurade</char> nkurɔfo.”<verse eid="NUM 16:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 16:42"/>Nanso bere a nnipa no nyinaa boaa wɔn ho ano sɛ wɔretia Mose ne Aaron na wotwaa wɔn ani hwɛɛ Ahyiae Ntamadan no, prɛko pɛ, omununkum no kataa so ma wohuu <char style="nd">Awurade</char> anuonyam. <verse eid="NUM 16:42"/><verse number="43" style="v" sid="NUM 16:43"/>Mose ne Aaron begyinaa Ahyiae Ntamadan no kwan ano, <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/>na <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>“Twe wo ho fi saa nnipa yi mu na matumi asɛe wɔn prɛko pɛ.” Na Mose ne Aaron de wɔn anim butubutuu fam.<verse eid="NUM 16:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46"/>Na Mose ka kyerɛɛ Aaron se, “Fa aduhuamyɛfo kuku no na yi ogya fi afɔremuka no so gu mu. Fa aduhuam gu so na fa nnipa no mu ntɛm so fa kɔyɛ mpata ma wɔn, efisɛ <char style="nd">Awurade</char> abufuw adu wɔn so. Ɔyaredɔm no afi ase.” <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>Aaron yɛɛ nea Mose hyɛɛ no no, na otuu mmirika kɔɔ nnipa no mu. Na ɔyaredɔm no aba ampa, na ɔhyew aduhuam no de yɛɛ mpata maa wɔn. <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>Na ogyinaa ateasefo ne awufo ntam, na ɔyaredɔm no gyaee. <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>Nanso na nnipa mpem dunan ne ahanson awuwu dedaw abɛka wɔn a wɔne Kora wuwui da a edi anim no ho. <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>Ɔyaredɔm no gyaee no, Aaron san kɔɔ Mose nkyɛn wɔ Ahyiae Ntamadan no ano.<verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">Aaron Pema Ho Fefɛw</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>“Ka kyerɛ Israelfo no na wɔnyɛ pema dumien, abusua biara panyin ntwa baako. Kyerɛw obiara din wɔ ne de ho. <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>Aaron din na wɔbɛkyerɛw agu Lewi abusuakuw pema no ho, efisɛ ɛsɛ sɛ abusuapanyin biara nya pema baako. <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>Momfa pema yi ngu Ahyiae Ntamadan no mu ahyiae mu wɔ baabi a mihyia mo wɔ adaka no anim hɔ no. <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>Menam pema yi so bɛkyerɛ onipa a meyi no no na ne pema no ho bɛfefɛw, na meyi Israelfo anwiinwii a wɔtaa nwiinwii tia wo no nyinaa afi hɔ.”<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>Enti Mose maa Israelfo no maa no pema dumien a wɔn abusua no biara panyin de wɔ mu a na Aaron ka de ka ho bi. <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>Mose de guu <char style="nd">Awurade</char> anim wɔ Adanse Ntamadan no mu hɔ.<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>Ade kyee a ɔkɔɔ mu no, ohuu sɛ Aaron pema a ɛwɔ hɔ ma Lewi abusuakuw no afefɛw ayɛ frɔmm, asow aba a ɛsensɛn so. <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>Na Mose de pema no fii <char style="nd">Awurade</char> anim ba bɛkyerɛɛ Israelfo no. Wɔhwɛe, na ɔpanyin biara faa ne pema.<verse eid="NUM 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Fa Aaron pema no san kɔto adaka no anim na fa yɛ nsɛnkyerɛnne ma atuatewfo no. Eyi de anwiinwii a wonwiinwii tia me no bɛba awiei na wɔanwuwu.” Na ɛsɛ sɛ ɔde ba bɛkyerɛ nnipa no bio na sɛ anwiinwii bi wɔ hɔ a etia Aaron tumi a, ebesiw amanehunu foforo a anka ɛbɛba nnipa no so no ano. <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>Mose yɛɛ nea <char style="nd">Awurade</char> hyɛɛ no sɛ ɔnyɛ no pɛpɛɛpɛ.<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>Israelfo no ka kyerɛɛ Mose se, “Yebewuwu! Yɛayera, yɛayera! <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>Mpo, obiara a ɔbɛbɛn <char style="nd">Awurade</char> Ahyiae Ntamadan no bewu. Yɛn nyinaa rebewuwu ana?”<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">Asɔfo Ne Lewifo Asɛde</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>
    <char style="nd">Awurade</char> kasa kyerɛɛ Aaron se, “Wo, wo mmabarima ne wʼabusuafo a wofi Lewi abusuakuw mu no, mfomso biara a ɛfa kronkronbea hɔ no ho asodi bɛda mo so. Na sɛ biribi ankɔ so yiye wɔ asɔfodwuma no mu a, wobebisa wo ne wo mmabarima ho asɛm. <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>Fa wo nkurɔfo a wɔwɔ Lewi abusuakuw no mu na wɔmmoa wo mmabarima no wɔ dwuma kronkron a wodi no Ahyiae Ntamadan no anim no ho. <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>Ɛsɛ sɛ Lewifo no hwɛ yiye na wɔammɛn biribiara a ɛyɛ kronkron wɔ afɔremuka no so. Sɛ wɔyɛ saa a, wo ne wɔn bewuwu. <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>Ɛsɛ sɛ wɔka mo ho na mohwɛ Ahyiae Ntamadan mu hɔ; ɛhɔ nnwuma nyinaa. Ɛnsɛ sɛ onipa foforo biara bɛn beae a wowɔ no.<verse eid="NUM 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5"/>“Wo na ɛsɛ sɛ wohwɛ kronkronbea hɔ ne afɔremuka no so, na mʼabufuwhyew amma Israelfo no so bio. <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>Mʼankasa na mapaw wo nkurɔfo Lewifo afi Israelfo mu sɛ akyɛde ama wo, atew wɔ ho ama <char style="nd">Awurade</char> sɛ wɔnyɛ adwuma wɔ Ahyiae Ntamadan no mu. <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>Nanso wo ne wo mmabarima nkutoo na na mubedi dwuma sɛ asɔfo wɔ nea ɛfa afɔremuka ne nea ɛwɔ ntwamtam no mu no ho. Mede asɔfodwuma ɔsom rema mo sɛ akyɛde. Ɛsɛ sɛ wokum onipa foforo biara a ɔbɛbɛn kronkronbea hɔ no.”<verse eid="NUM 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>
    <char style="nd">Awurade</char> san ka kyerɛɛ Aaron se: “Mʼankasa na mede akyɛde a nkurɔfo de abrɛ <char style="nd">Awurade</char> no ahyɛ wo nsa; afɔrebɔde a Israelfo no de ma me no nyinaa no mede ma wo ne wo mmabarima sɛ mo kyɛfa; ɛyɛ mo kyɛfa afebɔɔ. <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>Aduan afɔrebɔ, bɔne afɔrebɔ ne afɔbu afɔrebɔ nyinaa mowɔ mu kyɛfa. Eyinom nyinaa yɛ afɔrebɔde a ɛyɛ kronkron pa ara. <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>Munni no sɛ ade a ɛyɛ kronkron pa ara; ɔbarima biara nni bi. Mummu no sɛ ade kronkron.<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>“Eyi nso yɛ mo de: nea wobeyi agu nkyɛn afi Israelfo ohim afɔrebɔde mu no. Mede ma wo ne wo mmabarima ne wo mmabea nyinaa sɛ mo kyɛfa afebɔɔ. Obiara a ɔwɔ wo fi na ne ho tew no tumi di bi.<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>“Aba a edi kan mu akyɛde a nnipa no de bɛba sɛ afɔrebɔde a wɔde rebrɛ <char style="nd">Awurade</char> no a ɛyɛ ngo pa, bobesa pa, aburow ne nnɔbae biara no, mede ma mo. <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>Asase no so aba a edi kan a wɔde bɛbrɛ <char style="nd">Awurade</char> no bɛyɛ mo de. Obiara a ɔwɔ wo fi na ne ho tew no tumi di bi.<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>“Biribiara a ɛwɔ Israel a wɔde bɛma <char style="nd">Awurade</char> no yɛ mo de. <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>Israelfo abakan ne wɔn mmoa nyinaa abakan a wɔde bɛma <char style="nd">Awurade</char> no yɛ mo dea. Nanso mmoa a memmaa mo kwan sɛ wɔnwe wɔn nam no de, munnnye wɔn abakan. Na mmom, ɛsɛ sɛ wotua sika kakra de si abakan biara anan. <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>Sɛ abakan no di ɔsram a, na ɛsɛ sɛ wɔde ogye bo a ɛyɛ dwetɛ nkaribo gram aduonum asia sɛnea kronkronbea hɔ nkaribo a ɛyɛ gram dubaako ne nkyemu anum mu baako no te no ba.<verse eid="NUM 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17"/>“Nanso anantwi, nguan ne mmirekyi mmakan de, ɛnsɛ sɛ wogye wɔn; wɔyɛ kronkron. Fa wɔn mogya pete afɔremuka no so na hyew wɔn srade no sɛ aduan afɔre, ehua a ɛsɔ <char style="nd">Awurade</char> ani. <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>Saa mmoa yi nyinaa nam bɛyɛ mo de te sɛnea ohim afɔrebɔde koko ne ne srɛ nifa yɛ mo de no. <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>Biribiara a Israelfo de bɛbrɛ <char style="nd">Awurade</char> a wobefi afɔrebɔ kronkron mu ayi ato hɔ no, mede ma wo ne wo mmabarima ne wo mmabea sɛ mo kyɛfa afebɔɔ. Ɛyɛ ahyɛde a ɛda mo ne <char style="nd">Awurade</char> ne mo asefo ntam daa nyinaa.”<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Aaron se, “Morennya agyapade biara mfi wɔn asase mu, na morennya kyɛfa biara mfi wɔn mu; mene mo kyɛfa ne mo agyapade wɔ Israelfo no mu.<verse eid="NUM 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>“Mede Israel ntotoso du du no nyinaa ma Lewifo no sɛ wɔn agyapade de retua wɔ som a wɔsom wɔ Ahyiae Ntamadan no mu no so ka. <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>Efi nnɛ rekɔ, Israelfo no nni ho kwan sɛ wɔbɛn Ahyiae Ntamadan no mu; anyɛ saa a, wobɛsoa wɔn bɔne ho asodi ama wɔawuwu. <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>Lewifo no nko ara na wɔbɛyɛ adwuma wɔ hɔ, na wɔasoa mfomso biara a wɔbɛyɛ no ho asodi. Ɛyɛ mmara a ɛda hɔ afebɔɔ ma awo ntoatoaso a ɛbɛba no. Wɔrennya agyapade biara wɔ Israelfo no mu. <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>Mmom, ntotoso du du a Israelfo no de ba sɛ <char style="nd">Awurade</char> afɔrebɔde no na mede rema Lewifo no. Ɛno nti na meka faa wɔn ho se: ‘Wɔrennya agyapade wɔ Israelfo no mu no.’ ”<verse eid="NUM 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>“Ka kyerɛ Lewifo no se, ‘Sɛ munya ntotoso du du a mede rema mo sɛ mo agyapade no fi Israelfo no nkyɛn a, momfa nkyɛmu du mu baako mmrɛ <char style="nd">Awurade</char> sɛ nʼafɔrebɔde. <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>Na <char style="nd">Awurade</char> begye no sɛ mo afɔrebɔde a efi mo awiporowbea anaa nsa a efi mo nsakyi amoa mu. <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>Saa ɔkwan yi so na mobɛfa de mo afɔrebɔ a efi ntotoso du du a mubenya afi Israelfo no nkyɛn no abrɛ <char style="nd">Awurade</char>. Mumfi ntotoso du du yi mu mfa <char style="nd">Awurade</char> kyɛfa no mma ɔsɔfo Aaron. <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>Biribiara a wɔde bɛma mo no, momfa emu nea eye pa ara na ɛyɛ kronkron no mma <char style="nd">Awurade</char>.’<verse eid="NUM 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30"/>“Ka kyerɛ Lewifo no se: ‘Sɛ mode emu nea eye pa ara no ba a, wɔbɛfa no sɛ nea efi mo ankasa mo awiporowbea anaa mo nsakyibea hɔ. <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>Mo ne mo fifo betumi adi nkae no wɔ baabiara a mopɛ, efisɛ ɛyɛ mo adwuma a moyɛ no wɔ Ahyiae Ntamadan mu no so akatua. <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>Sɛ mode emu nea ɛsɔ ani no ba a, munni eyi ho afɔbu; saayɛ remma mungu Israelfo no afɔrebɔ kronkron no ho fi, na morenwuwu.’ ”<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">Ahodwira Nsu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose ne Aaron se, <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>“Eyi yɛ mmara a ɛsɛ sɛ wodi so a <char style="nd">Awurade</char> ahyɛ: Ka kyerɛ Israelfo se wɔmfa nantwi ba bere kɔkɔɔ a onnii dɛm na ɔntwee nneɛma da mmrɛ me. <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>Momfa no mma ɔsɔfo Eleasar na ɔde no bɛkɔ atenae no akyi baabi na wɔakum no wɔ nʼanim. <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>Na ɔsɔfo Eleasar de ne nsateaa bɛbɔ mogya no mu na ɔde apete Ahyiae Ntamadan no anim mpɛn ason. <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>Afei, ɔbɛhwɛ ama obi ahyew nantwi ba no. Wɔbɛhyew ne ho nhoma, ne nam, ne mogya ne ne nsono. <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>Na egu so rehyew no, Eleasar bɛfa sida dua, adwerɛ ne asaawa kɔkɔɔ na watow agu nantwi ba bere a wɔrehyew no so. <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>Eyi akyi no, ɛsɛ sɛ ɔsɔfo no horo ne ntade na oguare. Afei obetumi aba atenae hɔ, nanso ne ho rentew kosi anwummere. <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>Onipa a ɔhyew aboa no nso, ɛsɛ sɛ ɔhoro ne ntade na oguare, na ɔno nso ho rentew kosi anwummere.<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>“Ɔbarima a ne ho nguu fi no bɛsesaw aboa a wɔhyew no no nsõ de akogu atenae no akyi baabi a ɛhɔ yɛ kronkron. Ɛsɛ sɛ Israelfo no de sie na wɔde agu wɔn ahodwira nsu mu; ɛyɛ nea wɔde dwira wɔn ho fi bɔne ho. <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>Onipa a ɔbɛboaboa nantwi ba no nsõ no ano no nso, ɛsɛ sɛ ɔhoro ne ntade, na ɔno nso ho rentew kosi anwummere. Eyi bɛyɛ mmara a ɛbɛtena hɔ afebɔɔ ama Israelfo no ne ahɔho a wɔte wɔn mu no nyinaa.<verse eid="NUM 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>“Obiara a obeso onipa funu mu no ho begu fi nnanson. <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>Na ne nnansa ne ne nnanson so no, ɛsɛ sɛ ɔde nsu dwira ne ho ma ne ho tew. Sɛ wannwira ne ho nnansa ne nnanson so a ne ho rentew. <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>Wɔn a woso nnipa funu mu na wonnwira wɔn ho no, wogu <char style="nd">Awurade</char> Ntamadan no ho fi. Ɛsɛ sɛ woyi saa nnipa no fi Israelfo mu. Esiane sɛ wɔamfa ahodwira nsu no bi ampete wɔn ho no nti, wɔn ho ntew; wɔn ho a agu fi no da so wɔ wɔn so.<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>“Sɛ obi wu wɔ ntamadan mu a, ɛho mmara ni: Obiara a obewura saa ntamadan no mu ne wɔn a wɔwɔ mu dedaw ansa na onipa no rewu no nyinaa ho begu fi nnanson, <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>na ade biara a enni mmuaso na wɔde asa no nso ho begu fi.<verse eid="NUM 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16"/>“Sɛ obi a ɔwɔ abɔnten de ne nsa ka obi a ɔtɔɔ wɔ afoa ano funu anaasɛ obi a ɔnyɛ ɔtɔfo funu, anaasɛ obi de ne nsa ka onipa dompe anaa ɔda a, ne ho begu fi nnanson.<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>“Nea ne ho agu fi no, fa ahodwira nsõ no bi gu kuruwa mu na hwie nsu gu so. <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>Na obi a ne ho tew no mfa adwerɛ mmɔ nsu no mu mpete ntamadan no so ne nkuku ne nkaka a ɛwɔ ntamadan no mu no nso so ne obiara a na ɔwɔ ntamadan no mu a ne ho agu fi no so. Saa ara nso na obi a osoo dompe mu anaa obi a wokum no anaa nea ɔde ne ho aka ɔda no nso, wodwira ne ho. <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>Wɔyɛ eyi ne nnansa ne ne nnanson so. Na nea ne ho agu fi no nso, ɛsɛ sɛ ɔhoro ne ntade na oguare, na saa anwummere no ne ho bɛtew. <verse eid="NUM 19:19"/><verse number="20" style="v" sid="NUM 19:20"/>Nanso sɛ wɔn a wɔn ho agu fi na annwira wɔn ho a, ɛsɛ sɛ wotwa wɔn asu, efisɛ wɔagu <char style="nd">Awurade</char> kronkronbea hɔ ho fi. Wɔmfaa ahodwira nsu mpetee wɔn so ɛ, na wɔn ho ntew. <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>Eyi yɛ mmara a ɛbɛtena hɔ afebɔɔ ama wɔn.</para>
  <para style="p" vid="NUM 19:21">“Onipa a obetu ahodwira nsu no apete no nso, ɛsɛ sɛ ɔhoro ne ntade, na obiara a ɔde ne nsa bɛka ahodwira nsu no nso ho begu fi akosi anwummere. <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>Na biribiara a obi a ne ho agu fi no beso mu no nso ho begu fi akosi anwummere.”<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s1">Nsu Fi Ɔbotan Mu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>Israelfo no nyinaa duu Sin sare so ɔsram a edi kan no mu, na wɔtenaa Kades. Ɛhɔ na Miriam wu maa wosiee no.<verse eid="NUM 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>Na nsu a wɔbɛnom nni hɔ nti, nnipa no sɔre tiaa Mose ne Aaron. <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>Nnipa no ne Mose hamee se, “Sɛ yɛne yɛn nuanom wuwuu wɔ <char style="nd">Awurade</char> anim a anka yɛpɛ. <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>Adɛn nti na mode <char style="nd">Awurade</char> man ne yɛn nguan ne yɛn anantwi aba sare yi so sɛ yemmewuwu? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>Adɛn nti na muyii yɛn fii Misraim de yɛn baa asase bɔne yi so? Borɔdɔma, atoko ne bobe nni asase yi so. Nsu a yɛbɛnom nso nni ha.”<verse eid="NUM 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6"/>Mose ne Aaron fii dɔm no hɔ kɔɔ Ahyiae Ntamadan no ano de wɔn anim butubutuw fam wɔ <char style="nd">Awurade</char> anim; na wohuu <char style="nd">Awurade</char> anuonyam. <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/>Na <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>“Fa abaa no na wo ne wo nua Aaron mfrɛ nnipa no nyinaa. Wɔrehwɛ mo no, kasa kyerɛ ɔbotan no na nsu befi mu aba. Mubenya wɔn nsu a ɛbɛso wɔn ne wɔn anantwi afi ɔbotan no mu!”<verse eid="NUM 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9"/>Mose yɛɛ nea <char style="nd">Awurade</char> hyɛe no. Ɔfaa abaa no fii baabi a wɔde asie wɔ <char style="nd">Awurade</char> anim. <verse eid="NUM 20:9"/><verse number="10" style="v" sid="NUM 20:10"/>Mose ne Aaron frɛɛ nnipa no nyinaa ma wobehyiaa wɔ ɔbotan no anim na Mose ka kyerɛɛ wɔn se, “Atuatewfo, muntie! Yɛmma nsu mfi saa ɔbotan yi mu mmra ana?” <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>Afei Mose maa ne nsa so de abaa no bɔɔ ɔbotan no mprenu maa nsu bebree fii mu ba maa nnipa no ne wɔn anantwi nomee.<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>Nanso <char style="nd">Awurade</char> ka kyerɛɛ Mose ne Aaron se, “Esiane sɛ moannya me mu ahotoso anhyɛ me anuonyam sɛ ɔkronkronni wɔ Israelfo no ani so nti, moremfa wɔn nkɔ asase a mede rema wɔn no so.”<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>Wɔfrɛɛ beae hɔ Meriba a ase ne: Atuatew Nsu, efisɛ ɛhɔ ne baabi a Israelfo tew <char style="nd">Awurade</char> atua, na ɛhɔ ara nso na <char style="nd">Awurade</char> daa ne ho adi kyerɛɛ wɔn sɛ ɔyɛ ɔkronkron.<verse eid="NUM 20:13"/></para>
  <para style="s1">Edom Siw Israel Kwan</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>Mose somaa abɔfo fii Kades kɔɔ Edomhene nkyɛn sɛ wɔnkɔka nkyerɛ no se:</para>
  <para style="pm" vid="NUM 20:14">“Sɛɛ na wo nua Israelfo reka: Wunim abɛbrɛsɛ a yɛafa mu no nyinaa. <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>Yɛn agyanom kɔtenaa Misraim, yɛtenaa hɔ mfe bebree. Misraimfo no yɛɛ yɛne yɛn agyanom ayayade, <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>nanso yesu frɛɛ <char style="nd">Awurade</char> no, otiee yɛn na ɔsomaa ɔbɔfo ma obeyii yɛn fii Misraim.</para>
  <para style="pm" vid="NUM 20:16">“Mprempren yɛwɔ Kades wɔ mo asase hye so. <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>Yɛsrɛ mo sɛ, ma yentwa mu mfa wo man yi mu. Yɛbɛhwɛ yiye sɛ yɛremfa mo mfuw ne mo bobe nturo mu. Na mpo, yɛrennom mo abura mu nsu. Yɛbɛfa Ɔhene Tempɔn so na yɛremfi so kosi sɛ yɛbɛtra wo hye no.”<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>Nanso Edomhene buae se,</para>
  <para style="pm" vid="NUM 20:18">“Mommfa mʼasase so, anyɛ saa a mede asraafo ne afoa betua mo ano!”<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>Israelfo no buae se,</para>
  <para style="pm" vid="NUM 20:19">“Owura, yɛbɛfa ɔtempɔn no so. Sɛ yɛn nyɛmmoa nom mo nsu a, yebetua ka. Yɛpɛ sɛ yetwa mu wɔ mo asase so na yenni adwemmɔne bi.”<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>Nanso Edomhene buae se,</para>
  <para style="pm" vid="NUM 20:20">“Mommfa yɛn asase so!”</para>
  <para style="p" vid="NUM 20:20">Ɔboaboaa nʼakofo ano de wɔn kɔɔ ɔhye no so. <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>Esiane sɛ Edom amma wɔn kwan amma Israelfo no amfa wɔn man mu no nti, wɔman faa nkyɛn.<verse eid="NUM 20:21"/></para>
  <para style="s1">Aaron Wu</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>Israelfo no nyinaa fii Kades kɔɔ Bepɔw Hor so. <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/><char style="nd">Awurade</char> ka kyerɛɛ Mose ne Aaron wɔ Bepɔw Hor a ɛwɔ Edom hye so no se, <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>“Bere adu sɛ Aaron wu, na ɔrenkɔ asase a mede ama Israelfo no so bi, efisɛ mo baanu no tew mʼahyɛde ho atua wɔ Meriba nsu no ho. <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>Fa Aaron ne ne babarima Eleasar kɔ Bepɔw Hor so. <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>Ɛhɔ na wubeyi Aaron asɔfotade no de ahyɛ ne babarima Eleasar. Ɛhɔ na Aaron bewu na watoa nʼagyanom.”<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>Mose yɛɛ nea <char style="nd">Awurade</char> hyɛɛ no no. Wɔn baasa nyinaa kɔɔ bepɔw Hor so a nnipa no nyinaa hwɛ wɔn. <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>Mose yii Aaron asɔfotade no de hyɛɛ ne babarima Eleasar, na Aaron wuu wɔ bepɔw no apampam. Na Mose ne Eleasar san fii bepɔw no so bae, <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>na nnipa no tee Aaron wu no, Israelfo no suu no adaduasa.<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">Kanaanfo So Nkonimdi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>Arad hene a ɔyɛ Kanaanni a ɔte Negeb tee sɛ Israelfo nam Atarim kwan so reba no, ɔboaboaa nʼakofo ano kɔtow hyɛɛ Israelfo no so kyekyeree ebinom nnommum. <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>Afei, Israelfo no kaa ntam kyerɛɛ <char style="nd">Awurade</char> se, “Sɛ wode saa nnipa yi bɛhyɛ yɛn nsa a, anka yebegu wɔn nkurow akɛse no.” <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/><char style="nd">Awurade</char> tiee wɔn adesrɛ no na ɔde Kanaanfo no maa wɔn. Israelfo no sɛee wɔn ne wɔn nkurow akɛse pasaa; wɔtoo hɔ din Horma a ase ne “Ɔsɛe.”<verse eid="NUM 21:3"/></para>
  <para style="s1">Kɔbere Mfrafrae Ɔwɔ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>Afei, Israelfo no fii Bepɔw Hor so de wɔn ani kyerɛɛ Po Kɔkɔɔ sɛ wobetwa dantaban afa Edom ho. Nanso wɔrekɔ no nipa no aba mu bui; <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>wonwiinwii tiaa Onyankopɔn ne Mose se, “Adɛn nti na moayi yɛn afi Misraim de yɛn aba sɛ yemmewuwu wɔ sare yi so? Aduan nni ha! Nsu nni ha! Yɛmpɛ saa awerɛhow aduan yi!”<verse eid="NUM 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6"/>Enti, <char style="nd">Awurade</char> maa awɔ a wɔn ano wɔ bɔre yiye kɔkekaa wɔn mu bebree ma wowuwui. <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>Na nnipa no baa Mose nkyɛn bɛsrɛɛ se, “Yɛayɛ bɔne, efisɛ yɛakasa atia <char style="nd">Awurade</char> ne wo. Bɔ mpae kyerɛ <char style="nd">Awurade</char> na awɔ no nkɔ.” Enti Mose bɔɔ mpae maa nnipa no.<verse eid="NUM 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Fa kɔbere yɛ saa awɔ yi mu baako sɛso na fa no sɛn abaa tenten bi so, na sɛ awɔ no bi ka obi na ɔhwɛ no a, ɔrenwu.” <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>Enti Mose yɛɛ ɔwɔ sɛso no, de sɛn dua tenten so. Na obiara a ɔwɔ no bi bɛka no no, sɛ ɔma nʼani so hwɛ no a, onwu.<verse eid="NUM 21:9"/></para>
  <para style="s1">Israelfo Kɔ Moab</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>Israelfo no fi hɔ no, wɔtoaa wɔn akwantu no so kɔɔ Obot kɔtenaa hɔ. <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>Afei, wɔtoaa so kɔɔ Iye-Haabarim wɔ sare so wɔ Moab apuei fam. <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>Wofi hɔ no, wɔtoaa so kɔɔ asuwa Sered Subon mu kɔbɔɔ atenae wɔ hɔ. <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>Afei, wotu fii hɔ kɔɔ Asubɔnten Arnon nkyɛn hɔ baabi a wɔne Amorifo bɔ hye. Asubɔnten Arnon na ɛyɛ ɔhye a ɛda Moabfo ne Amorifo ntam. <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>Ɛno nti na, wɔka wɔ <char style="nd">Awurade</char> akodi nhoma no mu se,</para>
  <para style="q1" vid="NUM 21:14">asubɔnten Arnon subon</para>
  <para style="q2" vid="NUM 21:14">ne kurow Waheb <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>da Amorifo ne Moabfo ntam.<verse eid="NUM 21:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 21:16"/>Israelfo no fi hɔ toaa wɔn akwantu no so kɔɔ Beer a ase ne “Abura.” Ɛha na <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Frɛfrɛ nnipa no nyinaa bra na mɛma wɔn nsu.”<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>Ɛhɔ na Israelfo too dwom yi,</para>
  <para style="q1" vid="NUM 21:17">“Tue Ao, Abura!</para>
  <para style="q2" vid="NUM 21:17">To ho dwom!<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>To dwom fa abura a mmapɔmma tutu no ho,</para>
  <para style="q2" vid="NUM 21:18">sɛ nnipa mu akunini na wotitii mu;</para>
  <para style="q2" vid="NUM 21:18">akunini a wokura ahempeaw ne pema.”</para>
  <para style="m" vid="NUM 21:18">Afei, Israelfo no fii sare no so kɔfaa Matana, <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>Nahaliel ne Bamot, <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>na wɔkɔɔ Pisga atifi a ɛwɔ Moab bon no mu, baabi a wugyina a wuhu asase tamaa no.<verse eid="NUM 21:20"/></para>
  <para style="s1">Sihon Ne Og So Nkonimdi</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>Israelfo no tuu abɔfo ma wɔde nkra kɔmaa Amorihene Sihon se:<verse eid="NUM 21:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="NUM 21:22"/>“Momma yentwa mu mfa mo man yi mu. Yɛbɛfa ɔtempɔn no so tee, na yɛremfi so kosi sɛ yɛbɛtra mo hye. Yɛrentiatia mo nnɔbae so, yɛremfa yɛn nsa nka mo bobe nturo, na yɛrennom mo abura mu nsu kosi sɛ yebefi mo man no mu.”<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>Nanso ɔhene Sihon ampene so. Na mmom, ɔboaboaa nʼakofo ano kɔtow hyɛɛ Israelfo no so wɔ sare so hɔ ne wɔn koo wɔ Yahas. <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>Nanso Israelfo no kunkum wɔn faa wɔn asase a efi Asubɔnten Arnon kosi asu Yabok ho toaa so kosii Amorifo ahye so a na bammɔ wɔ hɔ no. <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>Israelfo no faa Amorifo no nkurow akɛse nyinaa a Hesbon kuropɔn ne ne nkuraase nyinaa ka ho tenaa mu. <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>Na Hesbon yɛ Amorihene Sihon kuropɔn. Sihon na da bi ɔko tiaa Moabhene faa ne nsase nyinaa besii Asubɔnten Arnon no.<verse eid="NUM 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27"/>Ne saa nti, tete anwensɛm kyerɛwfo kyerɛw eyi faa ne ho se,</para>
  <para style="q1" vid="NUM 21:27">“Bra Hesbon, Sihon kuropɔn,</para>
  <para style="q2" vid="NUM 21:27">yɛnkyekye na ensi ne dedaw mu.<verse eid="NUM 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>“Ogya turuw fii Hesbon</para>
  <para style="q2" vid="NUM 21:28">Ogyaframa fii Sihon ahenkurow mu,</para>
  <para style="q1" vid="NUM 21:28">Ɛhyew Ar kuropɔn a ɛwɔ Moab;</para>
  <para style="q2" vid="NUM 21:28">ɛsɛee kurowmma a wɔwɔ Arnon mmepɔw so.<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>Ao Moabfo, mo sɛe bɛba mu!</para>
  <para style="q2" vid="NUM 21:29">Wɔawie mo, mo a mosom Kemos!</para>
  <para style="q1" vid="NUM 21:29">Wagyaw ne mmabarima sɛ atutenafo,</para>
  <para style="q2" vid="NUM 21:29">Ne ne mmabea</para>
  <para style="q2" vid="NUM 21:29">sɛ Amorihene Sihon nnommum.<verse eid="NUM 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>“Yɛatu wɔn agu,</para>
  <para style="q2" vid="NUM 21:30">efi Hesbon tɔnn kosi Dibon.</para>
  <para style="q1" vid="NUM 21:30">Yɛasɛe wɔn ara akosi Nofa</para>
  <para style="q2" vid="NUM 21:30">De kɔ ara kosi Medeba.”<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>Enti Israelfo no tenaa Amorifo asase no so.<verse eid="NUM 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 21:32"/>Mose somaa akwansrafo sɛ wɔnkɔsrasra Yaser fa mu hɔ. Ɔde asraafo toaa wɔn, faa wɔn nkurow nyinaa, pam Amorifo no. <verse eid="NUM 21:32"/><verse number="33" style="v" sid="NUM 21:33"/>Afei, wɔde wɔn ani kyerɛɛ kurow kɛse Basan, nanso Basanhene Og de nʼasraafo hyiaa wɔn wɔ Edrei.<verse eid="NUM 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 21:34"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Nsuro no, efisɛ mede nʼasraafo ne nʼasase nyinaa ahyɛ wo nsa. Yɛ no sɛnea woyɛɛ Amorihene Sihon a odii Hesbon so no.”<verse eid="NUM 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35"/>Israelfo dii nkonim na wokum ɔhene Og ne ne mmabarima ne ne nkurɔfo nyinaa a anka wɔn mu baako mpo. Na Israelfo no faa nʼasase no.<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s1">Balak Frɛ Balaam</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>Afei, Israelfo no kɔɔ Moab tataw so kɔtenaa Asubɔnten Yordan apuei fam a ɛhɔ ne Yeriko di nhwɛanim no.<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>Sipor babarima Balak huu nea Israelfo ayɛ Amorifo no nyinaa, <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>na Moab huu Israelfo dodow a wɔwɔ hɔ no, ɔne ne nkurɔfo bɔɔ huboa.<verse eid="NUM 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 22:4"/>Moabfo no ka kyerɛɛ Midian mpanyimfo no se, “Saa dɔm yi bɛwe biribiara a ɛwɔ ha no, sɛnea nantwi we sare.”</para>
  <para style="p" vid="NUM 22:4">Enti Sipor ba Balak a na ɔyɛ Moabhene saa bere no <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>somaa nnipa ma wɔkɔɔ Beor babarima Balaam nkyɛn wɔ Petor a ɛbɛn Asubɔnten Eufrate ho. Balak kae se,</para>
  <para style="pm" vid="NUM 22:5">“Nnipadɔm bi fi Misraim aba. Wɔkata asase ani nyinaa na wɔabɛtena abɛn me. <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>Mɛsrɛ wo, bra na bɛdome wɔn ma me, efisɛ wɔyɛ den sen me. Ebia ɛbɛma matumi adi wɔn so nkonim na mapam wɔn afi asase no so. Efisɛ minim nhyira a ɛba wɔn a wuhyira wɔn no so, na minim mmusu a ɛba wɔn a wodome wɔn no so nso.”<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>Moab ne Midian mpanyimfo no fii hɔ a na wokita sika a wɔde rekotua Balaam ka ama wadome Israelfo no. Enti wɔkɔɔ Balaam nkyɛn kɔkaa nea ehia Balak no kyerɛɛ no.<verse eid="NUM 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 22:8"/>Balaam kae se, “Monna mma ade nkye mo. Ade kye a, nea <char style="nd">Awurade</char> bɛkyerɛ me sɛ menyɛ no, mɛka akyerɛ mo.” Enti Moab mpanyimfo no dae.<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>Anadwo no, Onyankopɔn baa Balaam nkyɛn bebisaa no se, “Saa nnipa yi yɛ hefo?”<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>Obuae se, “Wɔde nkra afi Moabhene Balak nkyɛn abrɛ me se: <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>Nnipadɔm bi fi Misraim aba ne hye so. Enti bra na bɛdome wɔn sɛnea ɛbɛyɛ a metumi ne wɔn ako apam wɔn.”<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>Onyankopɔn ka kyerɛɛ Balaam se, “Nkɔ. Ɛnsɛ sɛ wodome wɔn, efisɛ mahyira wɔn!”<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>Ade kyee anɔpa no, Balaam ka kyerɛɛ Balak nkurɔfo no se, “Monsan nkɔ fie! <char style="nd">Awurade</char> ampene sɛ me ne mo nkɔ.”<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>Enti Balak mpanyimfo no san bɛbɔɔ amanneɛ se, “Balaam ne yɛn amma.”<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>Balak somaa nnipa dodow pa ara a anuonyamfo a wɔkyɛn kan dɔm no fra wɔn mu. <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>Wɔbaa Balaam nkyɛn bɛka kyerɛɛ no se,</para>
  <para style="pm" vid="NUM 22:16">“Sɛnea Sipor ba Balak se ni, ‘Mma biribiara nsiw wo kwan sɛ wobɛba me nkyɛn, <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>efisɛ metua wo ka yiye. Bra na bɛdome saa nnipa no ma me.’ ”<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>Nanso, Balaam buae se, “Sɛ Balak ma me dwetɛ ne sikakɔkɔɔ a ɛwɔ nʼahemfi hɔ nyinaa mpo a, merentumi nyɛ biribiara mmu saa ahyɛde a <char style="nd">Awurade</char> a ɔyɛ me Nyankopɔn no ahyɛ no so. <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>Nanso, monna ha mma ade nkye na yɛnhwɛ sɛ <char style="nd">Awurade</char> bɛka asɛm foforo bi aka nea waka dedaw no ho anaa.”<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>Anadwo no, Onyankopɔn ka kyerɛɛ Balaam se, “Esiane sɛ nnipa no abɛfrɛ wo no nti, Sɔre na wo ne saa nnipa no nkɔ na mmom, hwɛ yiye na yɛ nea mɛkyerɛ wo sɛ yɛ no nko ara.”<verse eid="NUM 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>Ade kyee anɔpa no, ɔhyehyɛɛ nʼafurum, tenaa ne so ne Moab mpanyimfo no sii mu. <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>Nanso, Onyankopɔn bo fuw Balaam ahopere a ɔde kɔe no; enti ɔsomaa <char style="nd">Awurade</char> bɔfo ma ogyinaa akwantemfi sɛ onsiw no kwan. Na Balaam te nʼafurum so a nʼasomfo baanu ka ne ho. <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>Afurum no huu <char style="nd">Awurade</char> bɔfo no sɛ okura afoa gyina kwan no mfimfini no, ɔman faa wuram. Balaam hwee no sɛnea ɛbɛyɛ a ɔbɛfa ɔkwan no so.<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>Na <char style="nd">Awurade</char> ɔbɔfo no gyina ɔkwan hiahiaa bi a ɛwɔ bobeturo afasu abien ntam. <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>Bere a afurum no huu <char style="nd">Awurade</char> bɔfo no, otwerii ɔfasu no ho maa Balaam nan pemee. Enti Balaam san hwee aboa no.<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>Afei, <char style="nd">Awurade</char> bɔfo no kɔɔ nʼanim kogyinaa baabi a ɛhɔ kyere pa ara a na afurum no nnya baabi nnan ne ho mfa nifa anaa benkum. <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>Enti obutuw ɔkwan no mu. Balaam bo fuw yiye ma ɔde abaa no hwee no. <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>Afei, <char style="nd">Awurade</char> buee afurum no ano, na obisaa Balaam se, “Mayɛ wo dɛn na nti a wohwe me mprɛnsa saa?”<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>Balaam nso buaa no se, “Woama mayɛ ɔkwasea! Na sɛ mikura afoa a, anka mekum wo mprempren.”<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>Afurum no nso bisaa no se, “Menyɛ wʼafurum a woatena me so daa de abesi nnɛ? So mayɛ sɛɛ pɛn?”</para>
  <para style="p" vid="NUM 22:30">Obuae se, “Dabi.”<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>Afei, <char style="nd">Awurade</char> buee Balaam ani ma ohuu ɔsoro bɔfo no sɛ watwe afoa gyina ɔkwan no mfimfini. Enti ɔde nʼanim butuw fam.<verse eid="NUM 22:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 22:32"/>
    <char style="nd">Awurade</char> bɔfo no bisaa no se, “Adɛn nti na woahwe wʼafurum no mprɛnsa saa? Maba sɛ merebesiw wo kwan, efisɛ wʼakwan mu no wunni ahwɛyie wɔ mʼanim. <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>Afurum no huu me a ɔman faa nkyɛn mprɛnsa. Sɛ wamman a, anka mekum wo na magyaa no.”<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>Balaam ka kyerɛɛ <char style="nd">Awurade</char> bɔfo no se, “Mafom. Na minnim sɛ wugyina ɔkwan no mu a worebesiw me kwan. Sɛ wʼani nnye ho a mɛsan akɔ.”<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>
    <char style="nd">Awurade</char> bɔfo no ka kyerɛɛ no se, “Wo ne nnipa no nkɔ, nanso asɛm a mɛka akyerɛ wo no nko ara na ka.” Enti Balaam ne Balak mpanyimfo no kɔe.<verse eid="NUM 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>Bere a Balak tee sɛ Balaam reba no, ofii kurow no mu kohyiaa no wɔ Moabfo kurow mu wɔ Arnon hye so, wɔ nʼasase ano. <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>Balak bisaa Balaam se, “Mamfrɛ wo ɔhare so ana? Adɛn nti na woamma me nkyɛn? So merentumi ntua wo ka ana?”<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>Balaam buae se, “Ɛwɔ mu sɛ maba de, nanso merentumi nka nea mepɛ biara. Asɛm a Onyankopɔn de bɛhyɛ mʼano no nko ara na ɛsɛ sɛ meka.”<verse eid="NUM 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39"/>Balaam kaa Balak ho ne no kɔɔ Kiria-Husot. <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>Balak kum anantwi ne nguan bɔɔ afɔre na ɔde mmoa no bi maa Balaam ne ne mpanyimfo a wɔka ne ho. <verse eid="NUM 22:40"/><verse number="41" style="v" sid="NUM 22:41"/>Ade kyee anɔpa no, Balak faa Balaam de no kɔɔ Bamot-Baal atifi. Ofi hɔ too nʼani huu sɛ Israelfo no sam wɔn atenae hɔ.<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s1">Balaam Nkɔmhyɛ A Edi Kan</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>Balaam ka kyerɛɛ ɔhene no se, “Si afɔremuka ason wɔ ha, na siesie anantwinini ason ne adwennini ason ma me.” <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>Balak yɛɛ sɛnea Balaam kae no, na wɔn baanu no de nantwinini ne odwennini bɔɔ afɔremuka no biara so afɔre.<verse eid="NUM 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3"/>Afei Balaam ka kyerɛɛ Balak se, “Tena wʼafɔre no ho na merekɔ nkyɛn. Ebia na <char style="nd">Awurade</char> bɛba abehyia me, na nea ɔbɛda no adi akyerɛ me biara no mɛka akyerɛ wo.” Enti, ɔforo kɔɔ sorosoro baabi a ɛhɔ yɛ petee.<verse eid="NUM 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4"/>Ɛhɔ na Onyankopɔn hyiaa no ma ɔkae se, “Masiesie afɔremuka ason, na mede nantwinini ne odwennini abɔ afɔre wɔ biara so.”<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>
    <char style="nd">Awurade</char> de asɛm hyɛɛ Balaam anom se, “San kɔ Balak nkyɛn na kɔka asɛm yi kyerɛ no.”<verse eid="NUM 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6"/>Ɔsan bae no ɔbɛtoo no sɛ ɔne Moab mpanyimfo no nyinaa gyinagyina afɔre no ho. <verse eid="NUM 23:6"/><verse number="7" style="v" sid="NUM 23:7"/>Na Balaam hyɛɛ ne nkɔm:</para>
  <para style="q1" vid="NUM 23:7">“Balak soma bɛfrɛɛ me fii Aram,</para>
  <para style="q2" vid="NUM 23:7">Moabhene frɛɛ me fii apuei fam nkoko so.</para>
  <para style="q1" vid="NUM 23:7">Ɔkae se, ‘Bra bɛdome Yakob ma me;</para>
  <para style="q2" vid="NUM 23:7">bra bɛka mmususɛm gu Israel so.’<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>Ɛbɛyɛ dɛn na matumi adome</para>
  <para style="q2" vid="NUM 23:8">wɔn a Onyankopɔn nnome ɛ?</para>
  <para style="q1" vid="NUM 23:8">Ɛbɛyɛ dɛn na matumi aka mmususɛm agu</para>
  <para style="q2" vid="NUM 23:8">wɔn a <char style="nd">Awurade</char> mmuu wɔn fɔ so?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>Mihu wɔn fi ɔbotan atifi;</para>
  <para style="q2" vid="NUM 23:9">mehwɛ wɔn fi nkoko so.</para>
  <para style="q1" vid="NUM 23:9">Mihu nnipa a wɔatew wɔn ho</para>
  <para style="q2" vid="NUM 23:9">a wommu wɔn ho sɛ wɔyɛ aman no bi mu nnipa.<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>Hena na obetumi akan Yakob mfutuma,</para>
  <para style="q2" vid="NUM 23:10">anaa ɔbɛkan Israelfo nkyemu anan mu baako?</para>
  <para style="q1" vid="NUM 23:10">Ma minwu atreneefo wu,</para>
  <para style="q2" vid="NUM 23:10">na mʼawiei nyɛ sɛ wɔn de.”<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>Balak bisaa Balaam se, “Dɛn na woayɛ me yi? Mede wo baa sɛ bɛdome mʼatamfo, nanso woahyira wɔn mmom!”<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>Obuae se, “So ɛnsɛ sɛ meka nea <char style="nd">Awurade</char> de ahyɛ mʼano no ana?”<verse eid="NUM 23:12"/></para>
  <para style="s1">Balaam Nkɔmhyɛ A Ɛto So Abien</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>Afei, Balak ka kyerɛɛ no se, “Bra na yɛnkɔ baabi foforo a yebehu wɔn; worenhu wɔn nyinaa, gye wɔn atenae no nkyɛn nkyɛn. Gyina hɔ na dome wɔn ma me.” <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>Enti ɔde no kɔɔ Sofim bepɔw Pisga atifi. Osii afɔremuka ason wɔ hɔ na ɔde nantwinini ne odwennini bɔɔ afɔre afɔre wɔ afɔremuka biara so.<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>Balaam ka kyerɛɛ Balak se, “Tena wʼafɔre no ho wɔ ha na me nso merekohyia <char style="nd">Awurade</char>wɔ hɔ.”<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>
    <char style="nd">Awurade</char> hyiaa Balaam na ɔde asɛm hyɛɛ nʼanom se, “San kɔ Balak hɔ na kɔka asɛm yi kyerɛ no.”<verse eid="NUM 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17"/>Enti ɔsan ba bɛtoo no no sɛ ogyina nʼafɔre no ho a Moab mpanyimfo no ka ne ho. Balak bisae se, “<char style="nd">Awurade</char> aka dɛn?”<verse eid="NUM 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18"/>Na ɔhyɛɛ ne nkɔm:</para>
  <para style="q1" vid="NUM 23:18">“Balak, sɔre na tie;</para>
  <para style="q2" vid="NUM 23:18">Sipor babarima tie me.<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>Onyankopɔn nyɛ onipa na wadi atoro;</para>
  <para style="q2" vid="NUM 23:19">Ɔnyɛ onipa na wasesa nʼadwene.</para>
  <para style="q1" vid="NUM 23:19">Ɔka asɛm a ɔnyɛ ana?</para>
  <para style="q2" vid="NUM 23:19">Wahyɛ bɔ bi pɛn a wanni so ana?<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>Wɔahyɛ me sɛ minhyira;</para>
  <para style="q2" vid="NUM 23:20">wahyira, na merentumi nnan ani!<verse eid="NUM 23:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>“Wonhu ɔyawdi bi wɔ Yakob mu,</para>
  <para style="q2" vid="NUM 23:21">wonhuu awerɛhowdi biara wɔ Israel mu.</para>
  <para style="q1" vid="NUM 23:21">
    <char style="nd">Awurade</char>, wɔn Nyankopɔn ka wɔn ho;</para>
  <para style="q2" vid="NUM 23:21">Ɔhene ka wɔn ho!<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>Onyankopɔn yii wɔn fii Misraim;</para>
  <para style="q2" vid="NUM 23:22">ɔte sɛ nantwi hoɔdenfo ma wɔn.<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>Nnome biara mmaa Yakob so ɛ,</para>
  <para style="q2" vid="NUM 23:23">mmusu biara nni Israel so.</para>
  <para style="q1" vid="NUM 23:23">Afei, wɔbɛka afa Yakob</para>
  <para style="q2" vid="NUM 23:23">ne Israel ho se, ‘Hwɛ nea Onyankopɔn ayɛ!’<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>Nnipa no sɔre sɛ gyatabere.</para>
  <para style="q2" vid="NUM 23:24">Wɔwosow wɔn ho sɛ gyata</para>
  <para style="q1" vid="NUM 23:24">a onnye nʼahome de kosi sɛ ɔbɛtetew nea wakyere no no nam pasaa</para>
  <para style="q2" vid="NUM 23:24">na ɔnom nea wakyere no no mogya.”<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>Na Balak ka kyerɛɛ Balaam se, “Sɛ worennome wɔn a, ɛno de nhyira wɔn koraa.”<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>Balaam buaa no se, “Manka ankyerɛ wo se nea <char style="nd">Awurade</char> bɛka biara na mɛyɛ ana?”<verse eid="NUM 23:26"/></para>
  <para style="s1">Balaam Nkɔmhyɛ A Ɛto So Abiɛsa</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>Afei, Balak ka kyerɛɛ Balaam se, “Bra mma memfa wo nkɔ baabi foforo. Ebia, ɛhɔ bɛyɛ anisɔ ama Onyankopɔn sɛ wubegyina hɔ adome wɔn.” <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>Na Balak faa Balaam de no kɔɔ bepɔw Peor a ani kyerɛ nweatam no atifi pɛɛ no so.<verse eid="NUM 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29"/>Bio, Balaam kae se, “Si afɔremuka ason na siesie anantwinini ason ne adwennini ason ma me.” <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>Balak yɛɛ nea Balaam kae no, enti ɔde nantwinini ne odwennini bɔɔ afɔre wɔ afɔremuka no biara so.<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>Afei, Balaam huu sɛ ɛsɔ <char style="nd">Awurade</char> ani sɛ ohyira Israel no, wankɔ abisa sɛnea ɔtaa yɛ no; mmom, ɔtoo nʼani hwɛɛ sare no so. <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>Bere a Balaam huu sɛ Israelfo no abobɔ wɔn atenae sɛnea wɔn mmusuakuw te no, Onyankopɔn honhom baa ne so, <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>na eyi ne nkɔmhyɛ a ɔmae:</para>
  <para style="q1" vid="NUM 24:3">“Beor ba Balaam nkɔmhyɛ,</para>
  <para style="q2" vid="NUM 24:3">nkɔmhyɛ a efi obi a nʼani hu ade yiye,<verse eid="NUM 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4"/>nea ɔte Onyankopɔn nsɛm nkɔmhyɛ;</para>
  <para style="q2" vid="NUM 24:4">nea onya anisoadehu a efi Otumfo no hɔ;</para>
  <para style="q2" vid="NUM 24:4">na ɔda fam, a nʼani hu ade:<verse eid="NUM 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>“Yakob, mo ntamadan yɛ fɛ,</para>
  <para style="q2" vid="NUM 24:5">Israel, mo atenae yɛ ahomeka!<verse eid="NUM 24:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>“Ɛtrɛtrɛw sɛ abon,</para>
  <para style="q2" vid="NUM 24:6">sɛ nturo a ɛwɔ asubɔnten ho.</para>
  <para style="q1" vid="NUM 24:6">Wɔte sɛ pɛprɛ a <char style="nd">Awurade</char> adua,</para>
  <para style="q2" vid="NUM 24:6">te sɛ sida a esisi nsu ho.<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>Nsu bɛsen afi wɔn ahina mu.</para>
  <para style="q2" vid="NUM 24:7">Wɔn aba benya nsu ama aboro so.</para>
  <para style="b" vid="NUM 24:7"/>
  <para style="q1" vid="NUM 24:7">“Wɔn hene bɛyɛ kɛse asen Agag;</para>
  <para style="q2" vid="NUM 24:7">wɔn ahenni bɛkorɔn.<verse eid="NUM 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>“Onyankopɔn de wɔn fii Misraim na ɛbae;</para>
  <para style="q2" vid="NUM 24:8">wɔwɔ ahoɔden sɛ wuram nantwi.</para>
  <para style="q1" vid="NUM 24:8">Wɔsɛe atirimɔdenfo aman</para>
  <para style="q2" vid="NUM 24:8">na wobubu wɔn nnompe mu asinasin,</para>
  <para style="q2" vid="NUM 24:8">wɔde wɔn bɛmma wowɔ wɔn.<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>Wobutuw da sɛ gyata;</para>
  <para style="q2" vid="NUM 24:9">te sɛ gyatabere, hena na obetumi agyigye wɔn?</para>
  <para style="b" vid="NUM 24:9"/>
  <para style="q1" vid="NUM 24:9">“Wobehyira wɔn a wohyira wo,</para>
  <para style="q2" vid="NUM 24:9">na wɔbɛdome wɔn a wɔdome wo.”<verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>Balak bo fuw Balaam. Ɔbɔɔ ne nsam guu ne so kae se, “Mefrɛɛ wo se bɛdome mʼatamfo, nanso woahyira wɔn mprɛnsa yi nyinaa. <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>Fi ha kɔ wo nkyi ntɛm! Mekae se mɛkyɛ wo ade a ɛsom bo nanso, <char style="nd">Awurade</char> amma woannya akyɛde no.”<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>Balaam buaa no se, “So manka ankyerɛ abɔfo a wosomaa wɔn baa me nkyɛn no se, <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>‘Sɛ Balak ma me dwetɛ ne sikakɔkɔɔ a ɛwɔ nʼahemfi hɔ nyinaa koraa a, minni tumi sɛ mɛyɛ biribi atia <char style="nd">Awurade</char> ahyɛde, sɛ ɛyɛ papa anaa bɔne.’ Mmom nea <char style="nd">Awurade</char> aka no nko ara na ɛsɛ sɛ meka. <verse eid="NUM 24:13"/><verse number="14" style="v" sid="NUM 24:14"/>Afei, meresan akɔ me nkurɔfo nkyɛn. Nanso ma menka nea Israelfo no bɛyɛ wo nkurɔfo no daakye no nkyerɛ wo.”<verse eid="NUM 24:14"/></para>
  <para style="s1">Balaam Nkɔmhyɛ A Ɛto So Anan</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15"/>Eyi ne nkɔmhyɛ a Balaam de mae:</para>
  <para style="q1" vid="NUM 24:15">“Beor ba Balaam nkɔmhyɛ,</para>
  <para style="q2" vid="NUM 24:15">nkɔmhyɛ a efi ɔbarima a nʼani hu ade yiye,<verse eid="NUM 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16"/>nea ɔte Onyankopɔn nsɛm no nkɔmhyɛ,</para>
  <para style="q2" vid="NUM 24:16">nea ɔwɔ nimdeɛ a efi Ɔsorosoroni no hɔ,</para>
  <para style="q1" vid="NUM 24:16">nea onya anisoadehu a efi Otumfo no hɔ,</para>
  <para style="q2" vid="NUM 24:16">na ɔda fam, a nʼani hu ade no:<verse eid="NUM 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>“Mihu no, nanso ɛnyɛ mprempren;</para>
  <para style="q2" vid="NUM 24:17">mehwɛ no, nanso ɔmmɛn.</para>
  <para style="q1" vid="NUM 24:17">Nsoromma bepue afi Yakob mu;</para>
  <para style="q2" vid="NUM 24:17">ahempema bepue afi Israel mu.</para>
  <para style="q1" vid="NUM 24:17">Ɔbɛdwerɛw Moabfo ti,</para>
  <para style="q2" vid="NUM 24:17">Moabfo nyinaa tikora.<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>Wɔbɛfa Edom,<note caller="+" style="f"><char style="fr" closed="false">24.18 </char><char style="ft" closed="false">Edomfo yɛ Esau asefo.</char></note></para>
  <para style="q2" vid="NUM 24:18">na Seir a ɔyɛ ne tamfo no, wobedi ne so nkonim,</para>
  <para style="q2" vid="NUM 24:18">na Israel bɛkɔ so ayɛ den.<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>Ɔhene bi bɛsɔre wɔ Yakob mu</para>
  <para style="q2" vid="NUM 24:19">ɔno na ɔbɛsɛe kurow no mu nkaefo.”<verse eid="NUM 24:19"/></para>
  <para style="s1">Balaam Nkɔmhyɛ A Ɛto So Anum</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>Afei, Balaam hwɛɛ Amalekfo na ɔhyɛɛ nkɔm:</para>
  <para style="q1" vid="NUM 24:20">“Amalek na na ɔyɛ aman nyinaa abakan,</para>
  <para style="q2" vid="NUM 24:20">nanso nʼawiei bɛyɛ ɔsɛe pasaa.”<verse eid="NUM 24:20"/></para>
  <para style="s1">Balaam Nkɔmhyɛ A Ɛto So Asia</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>Afei, ohuu Kenifo, na ɔhyɛɛ ne nkɔm:</para>
  <para style="q1" vid="NUM 24:21">“Mo atenae wɔ bammɔ,</para>
  <para style="q2" vid="NUM 24:21">wɔanwen mo berebuw wɔ abotan mu;<verse eid="NUM 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22"/>Nanso wɔbɛsɛe mo Kenifo</para>
  <para style="q2" vid="NUM 24:22">bere a Asur fa mo nnommum no.”<verse eid="NUM 24:22"/></para>
  <para style="s1">Balaam Nkɔmhyɛ A Ɛto So Ason</para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23"/>Afei ɔhyɛɛ ne nkɔm:</para>
  <para style="q1" vid="NUM 24:23">“Aa! Sɛ Onyankopɔn yɛ sɛɛ a, hena na ɔbɛtena nkwa mu?<verse eid="NUM 24:23"/></para>
  <para style="q2">
    <verse number="24" style="v" sid="NUM 24:24"/>Ahyɛn befi Kipro mpoano aba;</para>
  <para style="q1" vid="NUM 24:24">wobedi Eber<note caller="+" style="f"><char style="fr" closed="false">24.24 </char><char style="ft" closed="false">Eber asefo yɛ Hebrifo (<char style="xt"><ref loc="1CH 25-27">1 Be 25–27</ref></char>).</char></note> ne Asur so.</para>
  <para style="q2" vid="NUM 24:24">Nanso wɔn nso, wɔbɛsɛe wɔn pasaa.”<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>Afei, Balaam sɔree na ɔsan kɔɔ ne kurom, na Balak nso kɔɔ ne kwan.<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">Moabfo Daadaa Israelfo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>Bere a Israelfo no tenaa Sitim no, wɔn mu mmarima no bi fii ase ne Moab mmea no bɔɔ aguaman de guu wɔn ho fi. <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>Saa mmea yi too nsa frɛɛ wɔn ma wɔkɔbɔɔ afɔre maa wɔn anyame. Wodii Moabfo anyame so afɔrebɔ nnuan na wɔkotow wɔn nso. <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>Enti Baal a ɛwɔ Peor no som bɛyɛɛ ɔhyɛ maa Israelfo. Eyi maa <char style="nd">Awurade</char> bo fuw ne nkurɔfo no yiye.<verse eid="NUM 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 25:4"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Fa saa nnipa yi ntuanofo no nyinaa, kunkum wɔn na fa wɔn gu owia so wɔ <char style="nd">Awurade</char> anim sɛnea ɛbɛyɛ a, nʼabufuwhyew no befi Israel so.”<verse eid="NUM 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5"/>Enti Mose ka kyerɛɛ Israel atemmufo no no se, “Ɛsɛ sɛ mo mu biara kunkum mo nkurɔfo a wɔde wɔn ho akɔhyɛ Baal a ɛwɔ Peor no ase no nyinaa.”<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>Na Israelni bi de Midiani bea bi baa wɔn atenae hɔ maa Mose ne nnipa no nyinaa huu wɔn bere a na wogyinagyina Ahyiae Ntamadan pon no ano retwa adwo no. <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>Bere a Pinehas a ɔyɛ Eleasar babarima a na ɔyɛ ɔsɔfo Aaron nena huu eyi no, ofii wɔn mu, kɔfaa peaw kitae; <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>na odii Israelni no akyi kɔɔ ntamadan no mu. Ɔde peaw no wɔɔ ɔbarima no san de wɔɔ ɔbea no yafunu mu. Enti ɔyaredɔm a na aba Israelfo no so no to twae; <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>nanso saa bere no, na nnipa mpem aduonu anan (24,000) awuwu dedaw.<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>“Eleasar babarima Pinehas a ɔyɛ ɔsɔfo Aaron nena ayi mʼabufuw afi Israelfo no so. Esiane sɛ wako apere mʼanuonyam wɔ wɔn mu sɛnea mepɛ ayɛ no nti, sɛnea meyɛɛ mʼadwene sɛ mɛsɛe Israelfo no, magyae. <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>Enti ka kyerɛ no se, me ne no rebɛyɛ asomdwoe apam. <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>Saa apam yi mu, ɔno ne nʼasefo bɛyɛ asɔfo afebɔɔ, efisɛ watwe me ho ninkunu wɔ Israelfo mu de ayɛ mpata ama wɔn.”<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>Ɔbarima a wokum no ne Midiani bea no, na ne din de Simri a na ɔyɛ Salu a otua Simeon abusuakuw ano no babarima. <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>Ɔbea no nso, na ne din de Kosbi a na ɔyɛ Midianhene babarima Sur babea.<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>“Tow hyɛ Midianfo no so sɛ atamfo na kunkum wɔn. <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>Efisɛ wɔfaa mo sɛ atamfo, na wɔdaadaa mo ma mo som Baal a ɛwɔ Peor, ne Kosbi a ɔyɛ Midian ntuanoni babea, a wokum no wɔ Peor ɔyaredɔm da no.”<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s1">Israel Nnipakan A Ɛto So Abien</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>Ɔyaredɔm no akyi no, <char style="nd">Awurade</char> ka kyerɛɛ Mose ne ɔsɔfo Aaron babarima Eleasar se, <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>“Monkan Israelfo mmarima a wɔadi mfe aduonu ne nea ɛboro saa nyinaa na monhwɛ dodow a wobetumi akɔ ɔsa ama Israel wɔ abusua biara mu.” <verse eid="NUM 26:2"/><verse number="3" style="v" sid="NUM 26:3"/>Enti Mose ne ɔsɔfo Eleasar kasa kyerɛɛ wɔn wɔ Moab tataw so, wɔ Asubɔnten Yordan ho a na wɔatra Yeriko no se, <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>“Monkan mmarima a wɔadi mfe aduonu ne nea ɛboro saa sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no.”</para>
  <para style="b" vid="NUM 26:4"/>
  <para style="li4" vid="NUM 26:4">Eyinom ne Israelfo a wofi Misraim bae no:<verse eid="NUM 26:4"/></para>
  <para style="s1">Ruben Abusuakuw</para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 26:5"/>Eyinom ne Yakob babarima panyin Ruben asefo:</para>
  <para style="li2" vid="NUM 26:5">Hanokfo abusua, wɔde too wɔn tete agya Hanok;</para>
  <para style="li2" vid="NUM 26:5">Palufo abusua, wɔde too a wɔn tete agya Palu;<verse eid="NUM 26:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="NUM 26:6"/>Hesronfo abusua, wɔde too wɔn tete agya Hesron;</para>
  <para style="li2" vid="NUM 26:6">Karmifo abusua, wɔde too wɔn tete agya Karmi.<verse eid="NUM 26:6"/></para>
  <para style="li4">
    <verse number="7" style="v" sid="NUM 26:7"/>Mmarima a na wɔwɔ Ruben mmusua nyinaa mu no dodow yɛ mpem aduanan abiɛsa ahanson aduasa (43,730).<verse eid="NUM 26:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="NUM 26:8"/>Na Palu yɛ Eliab babarima, <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>na Eliab mmabarima ne Nemuel, Datan ne Abiram. Saa Datan ne Abiram yi ara na wɔyɛ nnipa no ntuanofo a wɔka Kora akyidifo a wɔyɛɛ adwene tiaa Mose ne Aaron, de buu <char style="nd">Awurade</char> animtiaa no ho. <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>Na asase mu bue menee wɔne Kora. Ogya fi <char style="nd">Awurade</char> nkyɛn bɛsɛee wɔn akyidifo ahannu aduonum. Na wɔyɛɛ kɔkɔbɔ nsɛnkyerɛnne. <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>Nanso Kora ase antɔre.<verse eid="NUM 26:11"/></para>
  <para style="s1">Simeon Abusuakuw</para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 26:12"/>Eyinom ne mmusua a wofi Simeon ase:</para>
  <para style="li2" vid="NUM 26:12">Nemuelfo abusua, wɔde too wɔn tete agya Nemuel.</para>
  <para style="li2" vid="NUM 26:12">Yaminfo abusua, wɔde too wɔn tete agya Yamin.</para>
  <para style="li2" vid="NUM 26:12">Yakinfo abusua, wɔde too wɔn tete agya Yakin.<verse eid="NUM 26:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="NUM 26:13"/>Serafo abusua, wɔde too wɔn tete agya Serah;</para>
  <para style="li2" vid="NUM 26:13">Saulfo abusua, wɔde too wɔn tete agya Saulo.<verse eid="NUM 26:13"/></para>
  <para style="li4">
    <verse number="14" style="v" sid="NUM 26:14"/>Mmarima a na wɔwɔ Simeon mmusua mu nyinaa dodow yɛ mpem aduonu abien ne ahannu (22,200).<verse eid="NUM 26:14"/></para>
  <para style="s1">Gad Abusuakuw</para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 26:15"/>Eyinom ne mmusua a wɔyɛ Gad asefo:</para>
  <para style="li2" vid="NUM 26:15">Sefonfo abusua, wɔde too wɔn tete agya Sefon;</para>
  <para style="li2" vid="NUM 26:15">Hagifo abusua, wɔde too wɔn tete agya Hagi;</para>
  <para style="li2" vid="NUM 26:15">Sunifo abusua no, wɔde too wɔn tete agya Suni;<verse eid="NUM 26:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 26:16"/>Osnifo abusua, wɔde too wɔn tete agya Osni;</para>
  <para style="li2" vid="NUM 26:16">Erifo abusua, wɔde too wɔn tete agya Eri;<verse eid="NUM 26:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 26:17"/>Arodfo abusua, wɔde too wɔn agya Arod;</para>
  <para style="li2" vid="NUM 26:17">Arelifo abusua, wɔde too wɔn tete agya Areli.<verse eid="NUM 26:17"/></para>
  <para style="li4">
    <verse number="18" style="v" sid="NUM 26:18"/>Mmarima a na wɔwɔ Gad mmusua mu no dodow yɛ mpem aduanan ne ahannum (40,500).<verse eid="NUM 26:18"/></para>
  <para style="s1">Yuda Abusuakuw</para>
  <para style="li4">
    <verse number="19" style="v" sid="NUM 26:19"/>Na Yuda wɔ mmabarima baanu a wɔn din de Er ne Onan a wowuwuu wɔ Kanaan asase so.<verse eid="NUM 26:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 26:20"/>Yuda asefo mmusua a edidi so yi:</para>
  <para style="li2" vid="NUM 26:20">Selafo abusua, wɔde too wɔn tete agya Sela;</para>
  <para style="li2" vid="NUM 26:20">Peresfo abusua, wɔde too wɔn tete agya Peres;</para>
  <para style="li2" vid="NUM 26:20">Serafo abusua, wɔde too wɔn tete agya Serah.<verse eid="NUM 26:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 26:21"/>Eyinom ne mmusua a wofi Peres ase.</para>
  <para style="li3" vid="NUM 26:21">Hesronfo abusua, a wɔde too wɔn tete agya Hesron;</para>
  <para style="li3" vid="NUM 26:21">Hamulfo abusua, wɔde too wɔn tete agya Hamul.<verse eid="NUM 26:21"/></para>
  <para style="li4">
    <verse number="22" style="v" sid="NUM 26:22"/>Mmarima a na wɔwɔ Yuda mmusua mu no nyinaa dodow yɛ mpem aduɔson asia ne ahannum (76,500).<verse eid="NUM 26:22"/></para>
  <para style="s1">Isakar Asefo</para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 26:23"/>Eyinom ne mmusua a wofi Isakar ase:</para>
  <para style="li2" vid="NUM 26:23">Tolafo abusua, wɔde too wɔn tete agya Tola;</para>
  <para style="li2" vid="NUM 26:23">Puwafo abusua, wɔde too wɔn tete agya Puwa;<verse eid="NUM 26:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="NUM 26:24"/>Yasubfo abusua, wɔde too wɔn tete agya Yasub;</para>
  <para style="li2" vid="NUM 26:24">Simronfo abusua, wɔde too wɔn tete agya Simron.<verse eid="NUM 26:24"/></para>
  <para style="li4">
    <verse number="25" style="v" sid="NUM 26:25"/>Mmarima a na wɔwɔ Isakar mmusua no mu no nyinaa dodow yɛ mpem aduosia anan ne ahaasa (64,300).<verse eid="NUM 26:25"/></para>
  <para style="s1">Sebulon Asefo</para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 26:26"/>Eyinom ne mmusua a wofi Sebulon ase:</para>
  <para style="li2" vid="NUM 26:26">Seredfo abusua, wɔde too wɔn tete agya Sered;</para>
  <para style="li2" vid="NUM 26:26">Elonfo abusua, wɔde too wɔn tete agya Elon.</para>
  <para style="li2" vid="NUM 26:26">Yakleefo abusua, wɔde too wɔn tete agya Yakleel.<verse eid="NUM 26:26"/></para>
  <para style="li4">
    <verse number="27" style="v" sid="NUM 26:27"/>Mmarima a na wɔwɔ Sebulon mmusua no mu no nyinaa dodow yɛ mpem aduosia ne ahannum (60,500).<verse eid="NUM 26:27"/></para>
  <para style="s1">Manase Abusuakuw</para>
  <para style="li4">
    <verse number="28" style="v" sid="NUM 26:28"/>Ɛnam Manase ne Efraim so na mmusua abien fii Yosef mu bae.<verse eid="NUM 26:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 26:29"/>Manase asefo:</para>
  <para style="li2" vid="NUM 26:29">Makirfo abusua, wɔde too wɔn tete agya Makir;</para>
  <para style="li2" vid="NUM 26:29">Gileadfo abusua, wɔde too wɔn tete agya, Makir babarima, Gilead.<verse eid="NUM 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="NUM 26:30"/>Eyinom ne mmusua a wofi Gileadfo ase:</para>
  <para style="li3" vid="NUM 26:30">Yeserfo abusua, wɔde too wɔn tete agya Yeser;</para>
  <para style="li3" vid="NUM 26:30">Helekfo abusua, wɔde too wɔn agya Helek.<verse eid="NUM 26:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="NUM 26:31"/>Asrielfo abusua, wɔde too wɔn tete agya Asriel;</para>
  <para style="li3" vid="NUM 26:31">Sekemfo abusua, wɔde too wɔn tete agya Sekem;<verse eid="NUM 26:31"/></para>
  <para style="li3">
    <verse number="32" style="v" sid="NUM 26:32"/>Semidafo abusua, wɔde too wɔn tete agya Semida;</para>
  <para style="li3" vid="NUM 26:32">Heferfo abusua, wɔde too wɔn tete agya Hefer.<verse eid="NUM 26:32"/></para>
  <para style="li3">
    <verse number="33" style="v" sid="NUM 26:33"/>Hefer babarima Selofehad annya mmabarima nanso na ɔwɔ mmabea a wɔn din de Mahla, Noa, Hogla, Milka ne Tirsa.<verse eid="NUM 26:33"/></para>
  <para style="li4">
    <verse number="34" style="v" sid="NUM 26:34"/>Mmarima a na wɔwɔ Manase mmusua no nyinaa mu dodow yɛ mpem aduonum abien ne ahanson (52,700).<verse eid="NUM 26:34"/></para>
  <para style="s1">Efraim Abusuakuw</para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 26:35"/>Eyinom ne mmusua a wofi Efraim ase:</para>
  <para style="li2" vid="NUM 26:35">Sutelafo abusua, wɔde too wɔn tete agya Sutela;</para>
  <para style="li2" vid="NUM 26:35">Bekerfo abusua, wɔde too wɔn tete agya Beker;</para>
  <para style="li2" vid="NUM 26:35">Tahanfo abusua, wɔde too wɔn tete agya Tahan.<verse eid="NUM 26:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="NUM 26:36"/>Eyinom ne Sutela asefo:</para>
  <para style="li3" vid="NUM 26:36">Eranfo abusua, wɔde too wɔn tete agya Eran.<verse eid="NUM 26:36"/></para>
  <para style="li4">
    <verse number="37" style="v" sid="NUM 26:37"/>Eyinom Efraim mmusua; wɔn dodow yɛ mpem aduasa abien ne ahannum (32,500).</para>
  <para style="li4" vid="NUM 26:37">Eyinom ne mmusua a wɔyɛ Yosef asefo.<verse eid="NUM 26:37"/></para>
  <para style="s1">Benyamin Abusuakuw</para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 26:38"/>Eyinom ne mmusua a wofi Benyamin ase.</para>
  <para style="li2" vid="NUM 26:38">Belafo abusua no, wɔde too wɔn tete agya Bela;</para>
  <para style="li2" vid="NUM 26:38">Asbelfo abusua no, wɔde too wɔn tete agya Asbel;</para>
  <para style="li2" vid="NUM 26:38">Ahiramfo abusua no, wɔde too wɔn tete agya Ahiram;<verse eid="NUM 26:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 26:39"/>Sufamfo abusua no, wɔde too wɔn tete agya Sufam;</para>
  <para style="li2" vid="NUM 26:39">Hufamfo abusua no, wɔde too wɔn tete agya Hufam.<verse eid="NUM 26:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 26:40"/>Eyinom ne mmusua a wofi Belafo mu;</para>
  <para style="li3" vid="NUM 26:40">Ardfo a wɔde wɔn too wɔn tete agya Ard;</para>
  <para style="li3" vid="NUM 26:40">Naamanfo a wɔde wɔn too wɔn tete agya Naaman.<verse eid="NUM 26:40"/></para>
  <para style="li4">
    <verse number="41" style="v" sid="NUM 26:41"/>Na mmarima a na wɔwɔ Benyamin mmusua no mu nyinaa dodow yɛ mpem aduanan anum ne ahansia (45,600).<verse eid="NUM 26:41"/></para>
  <para style="s1">Dan Abusuakuw</para>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 26:42"/>Eyi ne abusua a efi Dan ase.</para>
  <para style="li2" vid="NUM 26:42">Suhamfo abusua no, wɔde too wɔn tete agya Suham.</para>
  <para style="li4" vid="NUM 26:42">Na Dan asefo no nyinaa yɛ Suhamfo. <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>Mmarima a na wɔwɔ saa mu no nyinaa dodow yɛ mpem aduosia anan ne ahannan (64,400).<verse eid="NUM 26:43"/></para>
  <para style="s1">Aser Abusuakuw</para>
  <para style="li1">
    <verse number="44" style="v" sid="NUM 26:44"/>Eyinom ne mmusua a wofi Aser ase:</para>
  <para style="li2" vid="NUM 26:44">Yimnafo abusua no, wɔde too wɔn tete agya Yimna;</para>
  <para style="li2" vid="NUM 26:44">Isuifo abusua no, wɔde too wɔn tete agya Isui;</para>
  <para style="li2" vid="NUM 26:44">Beriafo abusua no, wɔde too wɔn tete agya Beria.<verse eid="NUM 26:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 26:45"/>Eyinom ne mmusua a wofi Beria ase:</para>
  <para style="li3" vid="NUM 26:45">Heberfo de wɔn ho too wɔn tete agya Heber;</para>
  <para style="li3" vid="NUM 26:45">Malkielfo de wɔn ho too wɔn tete agya Malkiel.<verse eid="NUM 26:45"/></para>
  <para style="li4">
    <verse number="46" style="v" sid="NUM 26:46"/>Na Aser wɔ ɔbabea bi a ne din de Sera.<verse eid="NUM 26:46"/></para>
  <para style="li4">
    <verse number="47" style="v" sid="NUM 26:47"/>Mmarima a na wɔyɛ Aser asefo no nyinaa dodow yɛ mpem aduonum abiɛsa ne ahannan (53,400).<verse eid="NUM 26:47"/></para>
  <para style="s1">Naftali Abusuakuw</para>
  <para style="li1">
    <verse number="48" style="v" sid="NUM 26:48"/>Eyinom ne mmusua a wofi Naftali ase:</para>
  <para style="li2" vid="NUM 26:48">Yakseelfo abusua no, wɔde too wɔn tete agya Yakseel;</para>
  <para style="li2" vid="NUM 26:48">Gunifo abusua no, wɔde too wɔn agya Guni;<verse eid="NUM 26:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="NUM 26:49"/>Yeserfo abusua no, wɔde too wɔn tete agya Yeser;</para>
  <para style="li2" vid="NUM 26:49">Silemfo abusua no, wɔde too wɔn tete agya Silem.<verse eid="NUM 26:49"/></para>
  <para style="li4">
    <verse number="50" style="v" sid="NUM 26:50"/>Mmarima a na wɔwɔ Naftali mmusua nyinaa mu no dodow yɛ mpem aduanan anum ne ahannan (45,400).<verse eid="NUM 26:50"/></para>
  <para style="s1">Nnipa Dodow A Wɔkan Wɔn</para>
  <para style="li4">
    <verse number="51" style="v" sid="NUM 26:51"/>Nnipa dodow a wɔkan wɔn no ano si mpem ahansia ne baako ahanson aduasa (601,730).<verse eid="NUM 26:51"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>Afei, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>“Kyekyɛ asase no ma mmusua no sɛ wɔn agyapade, sɛnea wɔn dodow te. <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>Ma abusua a ɛso no agyapade kɛse na abusua a esua no agyapade ketewa. <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>Hwɛ sɛ wɔnam ntontobɔ so bɛkyekyɛ asase no. Nea ɛsɛ sɛ kuw biara nya no begyina nʼagyanom abusuakuw din dodow so. <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>Ɛsɛ sɛ wɔbɔ ntonto wɔ agyapade no kyekyɛ so wɔ akuw akɛse ne nketewa no mu.”<verse eid="NUM 26:56"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="57" style="v" sid="NUM 26:57"/>Eyinom ne Lewifo a wɔnam wɔn mmusua so kan wɔn:</para>
  <para style="li2" vid="NUM 26:57">Wɔde Gersonfo too wɔn tete agya Gerson.</para>
  <para style="li2" vid="NUM 26:57">Wɔde Kohatfo too wɔn tete agya Kohat.</para>
  <para style="li2" vid="NUM 26:57">Wɔde Merarifo too wɔn tete agya Merari.<verse eid="NUM 26:57"/></para>
  <para style="li1">
    <verse number="58" style="v" sid="NUM 26:58"/>Eyinom nso yɛ Lewifo mmusua:</para>
  <para style="li2" vid="NUM 26:58">Libnifo,</para>
  <para style="li2" vid="NUM 26:58">Hebronfo,</para>
  <para style="li2" vid="NUM 26:58">Mahlifo,</para>
  <para style="li2" vid="NUM 26:58">Musifo ne</para>
  <para style="li2" vid="NUM 26:58">Korafo.</para>
  <para style="li2" vid="NUM 26:58">Kohat yɛ Amram tete agya. <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>Bere a Lewi wɔ Misraim no, wɔwoo ɔbabea a ne din de Yokebed. Kehat babarima Amram waree no. Wɔn na wɔwoo Aaron, Mose ne Miriam. <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>Aaron woo Nadab, Abihu, Eleasar ne Itamar. <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>Nanso, bere a Nadab ne Abihu de ogya a ɛnyɛ kronkron brɛɛ <char style="nd">Awurade</char> no, wowuwui.<verse eid="NUM 26:61"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="62" style="v" sid="NUM 26:62"/>Nnipakan no mu no, na Lewifo nyinaa dodow yɛ mpem aduonu abiɛsa (23,000). Wɔkan mmarima a wɔadi fi ɔsram kosi mpanyimfo so. Nanso, wɔammu Lewifo no ano anka Israel nnipakan no ho, efisɛ wɔrekyɛ nsase no ama mmusuakuw no, wɔamma Lewifo no bi.<verse eid="NUM 26:62"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>Enti sɛnea Mose ne ɔsɔfo Eleasar fa kyerɛɛ nnipa no ano wɔ Moab bepɔw a ɛbɛn Asubɔnten Yordan a na wɔatwa Yeriko ne no. <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>Na saa nnipa yi mu biara nni hɔ a ɔfra wɔn a Mose ne Aaron kan wɔn wɔ Sinai sare so no mu. <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>Efisɛ <char style="nd">Awurade</char> ka kyerɛɛ saa Israelfo no se wobewuwu wɔ sare no so. Anka wɔn mu biara, gye Yefune ba Kaleb ne Nun babarima Yosua.<verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">Selofehad Mmabea</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>Hefer a ɔyɛ Manase ba, Mika ba, Gilead ba no babarima Selofehad a wofi Manase mmusua a efi Yosef ase no mmabea a wɔn din ne Mahla, Noa, Hogla, Milka ne Tirsa sɔree. <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>Wɔbaa Mose, ɔsɔfo Eleasar, mpanyimfo ne wɔn a wɔahyia wɔ Ahyiae Ntamadan no ano no nyinaa anim bɛkaa se, <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>“Yɛn agya wuu wɔ sare so nanso na ɔnka wɔn a wɔne Kora yɛɛ dɔm tiaa <char style="nd">Awurade</char> a enti ɛma wowuwuu no ho. Ɔno ankasa bɔne nti na owui a wannyaw mmabarima. <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>Adɛn nti na esiane sɛ yɛn agya anwo ɔbabarima nti ne din ayera fi nʼabusua mu? Momma yɛn yɛn agya abusua mu agyapade no bi.”<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>Enti Mose de wɔn asɛm too <char style="nd">Awurade</char> anim. <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/><char style="nd">Awurade</char> buaa no se, <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>“Asɛm a Selofehad mmabea no ka no yɛ nokware. Ma wɔn ne wɔn agya nuanom no asase. Fa agyapade a sɛ wɔn agya no te ase a anka obenya no ma wɔn.<verse eid="NUM 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 27:8"/>“Ka kyerɛ Israelfo no se sɛ obi wu na onni mmabarima a ɛsɛ sɛ nʼagyapade kɔ ne mmabea hɔ. <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>Na sɛ onni ɔbabea nso a, ɛsɛ sɛ agyapade no kɔ ne nuabarimanom nkyɛn. <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>Na sɛ onni nuabarimanom a, ɛkɔ ne wɔfanom nkyɛn. <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>Na sɛ onni wɔn mu biara bi a, ɛkɔ ne busuani bi a ɔbɛn no nkyɛn. Ɛsɛ sɛ Israelfo di saa mmara a <char style="nd">Awurade</char> hyɛɛ Mose no so.”<verse eid="NUM 27:11"/></para>
  <para style="s1">Woyi Yosua Sɛ Mose Abediakyiri</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, “Kɔ bepɔw a ɛwɔ Abarim mmepɔw no so na hwɛ asase a mede maa Israelfo no. <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>Sɛ wohwɛ wie a, wubewu sɛnea wo nua Aaron wui no, <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>efisɛ wɔsɔre tiaa me mmara wɔ Sin sare so hɔ, mo baanu no buu mʼahyɛde so na moanhyɛ me anuonyam sɛ ɔkronkronni wɔ wɔn ani so.” Na ɔretwe nʼadwene aba Meriba nsu “Akoe” a ɛwɔ Kades a ɛwɔ Sin sare so no so.<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>Mose ka kyerɛɛ <char style="nd">Awurade</char> se, <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>“<char style="nd">Awurade</char>, Onyankopɔn a woyɛ nnipa nyinaa honhom ti, yi obi ma onni dɔm yi anim <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>a ɔde wɔn befi adi na ɔde wɔn aba mu sɛnea ɛbɛyɛ a <char style="nd">Awurade</char> nnipa renyɛ sɛ nguan a wonni ɔhwɛfo.”<verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>Enti <char style="nd">Awurade</char> buaa Mose se, “Kɔ na kɔfrɛ Nun babarima Yosua a ɔwɔ akanni honhom wɔ ne mu no, na fa wo nsa to no so. <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>Fa no kɔ ɔsɔfo Eleasar ne nnipa no nyinaa anim na fa ne dwumadi hyɛ ne nsa. <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>Fa wo tumi no bi ma no sɛnea ɛbɛyɛ a Israelfo nyinaa betie no. <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>Sɛ wohia akwankyerɛ a efi <char style="nd">Awurade</char> hɔ a, Yosua begyina ɔsɔfo Eleasar anim, na ɔsɔfo Eleasar abɔ ntonto kronkron de abisa <char style="nd">Awurade</char> apɛde. Ɔno na ɔbɛhyɛ ama Israelfo no nyinaa afi adi na wahyɛ ama wɔaba mu.”<verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>Mose yɛɛ sɛnea <char style="nd">Awurade</char> hyɛɛ no no. Ɔde Yosua kyerɛɛ ɔsɔfo Eleasar ne nnipa no nyinaa. <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>Na ɔde ne nsa guu no so, de nʼadwuma hyɛɛ ne nsa sɛnea <char style="nd">Awurade</char> nam ne so hyɛe no.<verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">Afɔrebɔ Ahorow</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>“Ka kyerɛ Israelfo se, ‘Monhwɛ na momfa mʼaduan afɔre mmrɛ me wɔ ne bere ano sɛ ehua a ɛsɔ mʼani.’ <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>Ka kyerɛ wɔn se, ‘Eyi ne aduan afɔre a ɛsɛ sɛ mode brɛ <char style="nd">Awurade</char>: nguamma abien a wɔadi afe a dɛm nni wɔn ho; momfa mmra sɛ daa ɔhyew afɔre. <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>Momfa oguamma no baako mmɔ afɔre anɔpa na momfa ɔbaako mmɔ anwummere, <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>na momfa aburow lita abien ne fa a wɔayam no muhumuhu na wɔde ngo lita baako afra nka ho. <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>Eyi ne ɔhyew afɔre a wofii ase wɔ Sinai Bepɔw so a ɛsɛ sɛ wɔbɔ no bere ano bere ano ma eyi hua. Ɛyɛ aduan afɔre a wɔbɔ ma <char style="nd">Awurade</char>. <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>Ɛsɛ sɛ wɔde ɔnom afɔrebɔde a ɛyɛ nsa a apae lita baako a oguamma ka ho ka afɔrebɔde no ho a wobehwie agu beae bi a ɛhɔ yɛ kronkron wɔ <char style="nd">Awurade</char> anim. <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>Momfa oguamma a ɔto so abien no mmɔ afɔre anwummere a atoko ne nsa afɔrebɔ ka ho. Ɛno nso yɛ <char style="nd">Awurade</char> huam. Ɛyɛ ɔhyew afɔre.’ <verse eid="NUM 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>“ ‘Sɛ edu homeda a, momfa nguantenmma a wɔadi afe a wonnii dɛm biara ne afɔrebɔde ahorow a ɛsɛ sɛ mode ka ho no mmɔ afɔre. Ɛsɛ sɛ atoko afɔrebɔde lita anan ne fa a wɔayam no muhumuhu de ngo afra a nsa ka ho saa ara na wɔde bɔ saa afɔre no. <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>Eyi ne ɔhyew afɔre a wɔbɔ no homeda biara de ka bere ano ɔhyew afɔre ne nsa afɔre ho no.<verse eid="NUM 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>“ ‘Saa ara nso na da a edi kan wɔ ɔsram biara mu no, ɛsɛ sɛ mobɔ ɔhyew afɔre foforo bi ka ho de ma <char style="nd">Awurade</char>. Afɔrebɔde no bɛyɛ nantwinini abien, Odwennini baako ne nguantenmma ason a wɔadi afe a wonnii dɛm biara. <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>Nantwinini biara no, ɛsɛ sɛ mode ka ho ne asikresiam lita asia ne fa a wɔayam no muhumuhu de ngo afra. Afei, mode asikresiam a wɔayam no muhumuhu lita anan ne fa a wɔde ngo afra bɛbɔ aburow afɔre a Odwennini no ka ho; <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>na oguamma biara nso, mode asikresiam lita abiɛsa. Eyi bɛyɛ ɔhyew afɔre a ɛsɔ ani, aduan afɔre a wɔbɔ ma <char style="nd">Awurade</char>. <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>Nantwi biara, nsa afɔrebɔde lita abien ka ho. Odwennini biara, nsa afɔrebɔde lita baako ne fa ka ho. Oguamma biara nso, nsa afɔrebɔde lita baako ka ho. Afe mu no, eyi na ɛbɛyɛ ɔhyew afɔre wɔ ɔsram biara mu. <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>Mo bere ano bere ano ɔhyew ne nsa afɔrebɔ akyi no, ɛsɛ sɛ mode ɔpapo bɛbɔ bɔne ho afɔre ma <char style="nd">Awurade</char>.<verse eid="NUM 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>“ ‘Ɛsɛ sɛ mudi <char style="nd">Awurade</char> Twam Afahyɛ no afe biara sram a edi kan no da a ɛto so dunan no so. <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>Da a edi so no, mubefi ase adi afahyɛ; munnni brodo a mmɔkaw wɔ mu nnanson. <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>Afahyɛ no da a edi kan no, nnipa no nyinaa bɛbɔ ahotew gua na obiara renyɛ adwuma a ɛyɛ den biara. <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>Momfa nantwimma anini abien, Odwennini baako ne nguantenmma ason a wɔadi afe a wonnii dɛm mmɛbɔ ɔhyew afɔre ama <char style="nd">Awurade</char>. <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>Mode esiam muhumuhu lita ason a wɔde ngo afra bɛka nantwi baako biara ho. Afei, mode esiam lita anum bɛka odwennini no ho, <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>na nguanten ason no biara nso, mode esiam lita abiɛsa aka ho. <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>Ɛsɛ sɛ mode ɔpapo bɔ bɔne ho afɔre sɛ mpata ma mo ho. <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>Momfa saa afɔrebɔde yi nka nea daadaa mobɔ no ho. <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>Momfa saa kwan yi so mmɔ aduan afɔre da biara saa ara nnanson sɛ ehua a ɛsɔ <char style="nd">Awurade</char> ani; ɛsɛ sɛ mobɔ ka ɔhyew afɔre ne nsa afɔre a mobɔ daa no ho. <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>Da a ɛto so ason no, monyɛ nhyiamu kronkron na monnyɛ adwuma a ɛyɛ den biara.<verse eid="NUM 28:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>“ ‘Aduankan da no a wɔfrɛ no Nnaawɔtwe mu Afahyɛ anaasɛ Pentekoste no, ɛsɛ sɛ nnipa no nyinaa de kronkronyɛ sononko hyia, de di Otwabere Afahyɛ no. Da no, ɛsɛ sɛ mode mo mfuw mu nnɔbae foforo bɛbɔ <char style="nd">Awurade</char> aduan afɔre. Ɛnsɛ sɛ moyɛ adwuma a ɛyɛ den biara. <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>Momfa nantwimma anini abien, odwennini baako ne nguantenmma anini ason mmɛbɔ ɔhyew afɔre sɛ ehua a ɛsɔ <char style="nd">Awurade</char> ani. <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>Mode mo aburow lita asia ne fa a wɔayam no muhumuhu a mode ngo afra bɛka nantwi baako biara ho. Mode lita anan bɛka Odwennini no ho; <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>na mode lita abiɛsa bɛka nguantenmma ason no biara ho. <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>Momfa ɔpapo baako na wɔmfa nyɛ mpata mma mo. <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>Saa afɔre ahorow yi ka daa ɔhyew afɔre, aburow afɔre ne nsa afɔre no ho. Monhwɛ sɛ mmoa a mode wɔn bɛbɔ saa afɔre no nnii dɛm biara ɛ.<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s1">Ntorobɛnto Afahyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>“ ‘Ɔsram a ɛto so ason no da a edi kan wɔ afe biara mu no, munni torobɛnto afahyɛ no. Monyɛ nhyiamu kronkron no na obiara nyɛ adwumaden biara. <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>Momfa nantwi ba onini baako, Odwennini baako ne adwennini ason a wɔadi afe a wonnii dɛm mmɛbɔ ɔhyew afɔre a eyi hua a ɛsɔ <char style="nd">Awurade</char> ani. <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>Momfa esiam lita asia ne fa a wɔayam no muhumuhu a wɔde ngo afra mmɔ atoko afɔre no a nantwi no ka ho. Odwennini no, momfa lita anan ne fa nka ho <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>na lita abien ne fa nso nka nguantenmma no biara ho. <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>Momfa ɔpapo baako nka ho mmɔ bɔne ho afɔre mfa nyɛ mpata mma mo. <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>Eyinom ka ɔhyew afɔre ne nsa afɔre a mobɔ no ɔsram biara ne daa de a wɔakyerɛ no ho. Ɛyɛ aduan afɔre a wɔde brɛ <char style="nd">Awurade</char> sɛ ehua a ɛsɔ ani.<verse eid="NUM 29:6"/></para>
  <para style="s1">Mpata Da Afɔrebɔ</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>“ ‘Ɔsram a ɛto so ason no da a ɛto so du so no monyɛ nhyiamu kronkron. Ɛyɛ da a ɛsɛ sɛ nnipa no nyinaa yɛ komm ahobrɛase mu wɔ <char style="nd">Awurade</char> anim na ɛnsɛ sɛ biara yɛ adwuma biara. <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>Mommɔ ɔhyew afɔre a eyi hua a ɛsɔ <char style="nd">Awurade</char> ani. Afɔrebɔde no yɛ nantwi ba baako, odwennini baako, nguamma a wɔadi afe ason a wonnii dɛm biara. <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>Momfa nantwi ba no nsiesie atoko afɔre a mode asikresiam a wɔayam no muhumuhu ne ngo lita asia ne fa afra, <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>na momfa lita anan ne fa nka odwennini no ho na momfa lita abien ne fa aka nguamma ason no mu biara ho. <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>Ɛsɛ sɛ mode ɔpapo baako bɔ bɔne ho afɔre. Eyi ka bɔne afɔrebɔde a wɔbɔ de pata ne ɔhyew afɔre a wɔbɔ no daadaa a aduan afɔrebɔde ne nsa afɔre ka ho no ho.<verse eid="NUM 29:11"/></para>
  <para style="s1">Ntamadan Afahyɛ</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>“ ‘Monyɛ nhyiamu kronkron wɔ ɔsram a ɛto so ason no da a ɛto so dunum no so, na monnyɛ adwumaden biara. Munni afahyɛ no nnanson mma <char style="nd">Awurade</char>. <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>Nneɛma a mode bɛbɔ ɔhyew afɔre na ama ayi hua a ɛsɔ <char style="nd">Awurade</char> ani no yɛ nantwimma anini dumiɛnsa, adwennini abien ne adwennini dunan a wɔadi afe na wonnii dɛm biara. <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>Ɛsɛ sɛ mode asikresiam a wɔayam no muhumuhu lita asia ne fa a wɔde ngo afra ka nantwimma dumiɛnsa no biara ho. Lita anan ne fa nka adwennini no baako biara ho, <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>na lita abien ne fa nka nguantenmma dunan no biara ho. <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>Momfa ɔpapo mmɔ bɔne ho afɔre nka daa ɔhyew afɔre, atoko ne nsa afɔre a mobɔ no daa no ho.<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>“ ‘Da a ɛto so abien no, momfa anantwi anini mma dumien, adwennini abien ne adwennini a wɔadi afe dunan a wonnii dɛm biara mmɛbɔ afɔre. <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>Saa afɔrebɔde yi mu biara no, mode anantwinini, adwennini ne nguantenmma no ho aduan ne nsa afɔrebɔde dodow a wɔahyɛ no bɛka ho. <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>Ɔhyew afɔre a mobɔ no daa akyi no, mode ɔpapo bɛka atoko afɔrebɔde ne nsa afɔrebɔde no ho abɔ bɔne ho afɔre.<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>“ ‘Afahyɛ no da a ɛto so abiɛsa no, mode anantwinini dubaako, adwennini abien, nguantenmma a wɔadi afe no dunan a wonnii dɛm biara; <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>na sɛnea moyɛ no daa no, mode anantwi, adwennini ne nguantenmma no ne aduan ne nsa afɔrebɔde bɛka afɔrebɔde biara ho. <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>Ɛsɛ sɛ mode ɔpapo bɔ bɔne ho afɔre de ka daa ɔhyew afɔrebɔ no ho a atoko afɔrebɔde ne nsa afɔrebɔde ka ho.<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>“ ‘Afahyɛ no da a ɛto so anan no, momfa anantwinini du, adwennini abien, ne nguantenmma a wɔadi afe no dunan a wonnii dɛm biara mmɔ afɔre. <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>Momfa atoko afɔrebɔde ne nsa afɔrebɔde dodow a wɔakyerɛ no nka biara ho. <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>Momfa ɔpapo baako nyɛ bɔne ho afɔrebɔ nka daa ɔhyew, atoko ne nsa afɔrebɔde no ho.<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>“ ‘Afahyɛ no da a ɛto so anum no, momfa anantwinini akron, adwennini abien ne nguantenmma a wɔadi afe no dunan a wonnii dɛm biara mmɔ afɔre. <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>Momfa atoko ne nsa afɔrebɔde dodow a wɔakyerɛ no nka anantwinini, adwennini ne nguamma afɔrebɔ no ho. <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>Momfa ɔpapo baako nyɛ bɔne ho afɔrebɔ nka daa ɔhyew, atoko ne nsa afɔrebɔde no ho.<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>“ ‘Afahyɛ no da a ɛto so asia no, momfa de anantwinini awotwe, adwennini abien ne nguantenmma a wɔadi afe dunan a wonnii dɛm biara mmɔ afɔre. <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>Momfa atoko ne nsa afɔrebɔde dodow a wɔakyerɛ no nka anantwinini, adwennini ne nguantenmma afɔrebɔ no ho. <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>Momfa ɔpapo baako mmɔ bɔne ho afɔrebɔ nka daa ɔhyew, atoko ne nsa afɔrebɔde no ho.<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>“ ‘Afahyɛ no da a ɛto so ason no, momfa anantwinini ason, adwennini abien ne nguamma a wɔadi afe a wonnii dɛm biara dunan mmɔ afɔre. <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>Momfa atoko ne nsa afɔrebɔde dodow a wɔakyerɛ no nka anantwinini, adwennini ne nguantenmma afɔrebɔ no ho. <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>Momfa ɔpapo baako mmɔ bɔne ho afɔre nka daa ɔhyew, atoko ne nsa afɔrebɔde no ho.<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>“ ‘Da a ɛto so awotwe no, monyɛ ɔpɔn nhyiamu sononko. Ɛnsɛ sɛ moyɛ adwumaden biara saa da no. <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>Mommɔ aduan afɔre a ɔhyew afɔre a ɛwɔ hua a ɛsɔ <char style="nd">Awurade</char> ani wɔ mu. Momfa nantwinini baako, Odwennini baako, nguantenmma ason a wɔadi afe a wonnii dɛm mmɔ. <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>Momfa atoko ne nsa afɔrebɔde dodow a wɔakyerɛ no nka nantwinini, odwennini ne nguantenmma no ho. <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>Momfa ɔpapo baako mmɔ bɔne ho afɔre nka daa ɔhyew, atoko ne nsa afɔrebɔde no ho.<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>“ ‘Mommɔ afɔre yinom mma mo <char style="nd">Awurade</char> wɔ mo afahyɛ ahorow no nu: mo hyew, atoko, nsa ne asomdwoe afɔre no; na momfa nka afɔre a mufi mo pɛ mu hyɛ ho bɔ no no ho. Muhyia, didi afirihyia no mu a, twa ara na etwa sɛ mobɔ saa afɔre yi. Na ɛka mo afɔre a mobɔ fa bɔ a moahyɛ anaa nea efi mo pɛ mu a ɛyɛ ɔhyew afɔre, atoko afɔre, nsa afɔre anaa asomdwoe afɔre no ho.’ ”<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>Mose kaa saa mmara yi nyinaa kyerɛɛ Israelfo no sɛnea Awurade hyɛɛ no no.<verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s1">Bɔhyɛ Ho Mmara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>Mose hyiaa Israel mmusua no mu mpanyimfo no ka kyerɛɛ wɔn se, “<char style="nd">Awurade</char> ahyɛ se: <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>Sɛ obi hyɛ <char style="nd">Awurade</char> bɔ anaa ɔka ntam hyɛ bɔ a, ɛnsɛ sɛ obu so. Ɛsɛ sɛ ɔyɛ nea ɔkaa se ɔbɛyɛ no pɛpɛɛpɛ.<verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>“Sɛ ababaa bi hyɛ <char style="nd">Awurade</char> bɔ anaa ɔka ntam hyɛ bɔ bere a ɔda so te nʼagya fi, <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>na nʼagya no te sɛ ne ba no ahyɛ bɔ, na wanka hwee a, ne bɔhyɛ ne ne ntam a ɔkaa no nyinaa no di mu. <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>Nanso sɛ ɛba sɛ nʼagya no siw no bɔhyɛ no ho kwan a, etwa ne bɔhyɛ ne ntam a ɔkae no mu. <char style="nd">Awurade</char> de bɛkyɛ ababaa no, efisɛ nʼagya ampene sɛ obedi so.<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>“Sɛ ɔhyɛ bɔ anaa ɔka ntam ansa na ɔware na ɛbɛyɛ asodi ma no <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>na ne kunu no te saa bɔhyɛ no ho asɛm nanso wanka ho hwee a, na ne bɔhyɛ no gyina hɔ. <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>Na sɛ ne kunu no te na osiw no ho kwan a na ɛkyerɛ sɛ watwa mu a bɔhyɛ no anaa ntam no ho asodi nna ne so bio, enti <char style="nd">Awurade</char> de ne ho bɛkyɛ no.<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>“Ɛsɛ sɛ ɔbea kunafo anaa nea wɔagyaa no aware no di ne ntam a ɔbɛka anaa bɔ a ɔbɛhyɛ no biara so.<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>“Sɛ waware na ɔte ne kunu fi na ɔhyɛ bɔ anaa ɔka ntam, <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>na ne kunu no te na wansiw no ho kwan a, na ɛkyerɛ sɛ ne bɔhyɛ no gyina hɔ. <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>Na sɛ ne kunu no te na, sɛ wampene so na, otwa mu a, na ne bɔhyɛ no nni mu na <char style="nd">Awurade</char> de ne ho bɛkyɛ no. <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>Enti ne kunu no betumi asi ne bɔ a ɔhyɛ anaa ntam a ɔka no so dua anaasɛ obetwa mu. <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>Sɛ da mu no nyinaa wanka ho hwee ankyerɛ no de a, na ɛkyerɛ sɛ ɔpene so wɔ hwee a wanka amfa ho no nti. <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>Sɛ ɔtwɛn ma mmere bi fa so ansa na ɔka se bɔhyɛ no nni mu a, ɛno de, ɛsɛ sɛ ɔsoa ɔbea no mfomso no ho asodi.”<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>Eyinom ne mmara a <char style="nd">Awurade</char> nam Mose so de maa ɔbarima ne ne yere, ne agya ne ne babea a ɔda so te ne fi no.<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s1">Midianfo So Aweretɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>“Esiane sɛ Midianfo daadaa mo de mo kɔɔ abosonsom mu no nti, tɔ so were ma Israelfo no. Eyi akyi no wubewu na woakɔ wʼagyanom nkyɛn.”<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>Mose ka kyerɛɛ nkurɔfo so se, “Munyi mo mmarima no mu bi na wɔnkɔ <char style="nd">Awurade</char> aweretɔ sa a ɔde tia Midianfo no. <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>Momfa Israel abusua biara mu nnipa apem nkɔ ɔsa no.” <verse eid="NUM 31:4"/><verse number="5" style="v" sid="NUM 31:5"/>Wɔyɛɛ saa nyaa mmarima mpem dumien siesie wɔn maa ɔko no; Israel abusuakuw biara maa mmarima apem. <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>Afei Mose ma wɔkɔe, nnipa apem baako a wofi abusuakuw biara mu. Ɔsɔfo Eleasar babarima Pinehas na odii wɔn anim kɔɔ ɔko no. Wɔrekɔ no, wɔde akronkronne a ɛwɔ kronkronbea hɔ ne ntorobɛnto a wɔbɛhyɛn de ama asraafo no nsɛnkyerɛnne kɔe.<verse eid="NUM 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7"/>Wɔne Midiafo no koe, na sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no wokum Midian mmarima no nyinaa. <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>Wɔn a wokum wɔn no bi ne Midian ahemfo baanum a wɔn din de Ewi, Rekem, Sur, Hur ne Reba. Beor babarima Balaam nso, wɔde afoa kum no. <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>Afei, Israel asraafo no kyekyeree Midian mmea ne mmofra nyinaa ne wɔn anantwi ne wɔn nguan fom nneɛma pii kaa ho sɛ asade. <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>Wɔtoo Midian no atenae, nkurow ne nkuraa nyinaa mu gya, hyew no pasaa. <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>Wɔfaa asade ne afowde a nnipa no ne mmoa ka ho. <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>Wɔde nnommum no ne ɔko no mu nneɛma a wonyae no nyinaa brɛɛ Mose, ɔsɔfo Eleasar ne Israelfo a na wɔabɔ wɔn atenase wɔ Moab tataw so baabi a na ɛbɛn Asubɔnten Yordan a wotwa fi Yeriko baa hɔ no.<verse eid="NUM 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>Mose ne ɔsɔfo Eleasar ne mpanyimfo a wotuatua nnipa no ano no fii atenae hɔ kohyiaa nkonimdifo no kwan. <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>Nanso Mose bo fuw mpanyimfo a wotuatua nsraadɔm apem ne ɔha no ano a wofi ɔsa no bae no.<verse eid="NUM 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15"/>Obisaa wɔn se, “So moankunkum mmea no? <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>Wɔn ne nnipa no a wotie Balaam nti wɔtwetwee Israelfo na amma wɔanni <char style="nd">Awurade</char> nokware kɔsom abosom wɔ bepɔw Peor so a enti ɛmaa ɔhaw ne abɛbrɛsɛ bebree baa <char style="nd">Awurade</char> nkurɔfo so no. <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>Munkunkum mmarimaa no nyinaa. Na munkunkum mmea a wɔne mmarima adeda no nyinaa. <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>Mmeawa nketewa a wɔne mmarima nnae no na munnyaa wɔn na mo ne wɔn ntena.<verse eid="NUM 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19"/>“Ɛsɛ sɛ obiara a wakum obi, anaa ɔde ne nsa kaa nea wɔakum no no, fi atenae ha nkɔtena baabi nnanson. Munnwira mo ho ne mo nnommum no nnansa ne ne nnanson so. <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>Munnwira mo ntade ne biribiara a wɔde aboa nhoma, abirekyi nwi anaa dua ayɛ.”<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>Afei, ɔsɔfo Eleasar ka kyerɛɛ mmarima a wɔkɔɔ ɔko no se, “Eyi ne mmara a <char style="nd">Awurade</char> ahyɛ a waka akyerɛ Mose: <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>Sikakɔkɔɔ, dwetɛ, kɔbere, dade, sanyaa, sumpii <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>ne biribiara a etumi etumi gyina ogya ano no ɛsɛ sɛ wɔde fa ogya mu sɛnea ɛho bɛtew. Eyi akyi, ɛsɛ sɛ wɔde ahodwira nsu dwira ho ma ɛtew ho. Nanso, biribiara a ɛrentumi nnyina ogya ano no de, wɔmfa nsu nnwira ho. <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>Nnanson so no, ɛsɛ sɛ mohoro mo ntade na mo ho afi. Afei mubetumi asan aba atenae hɔ.”<verse eid="NUM 31:24"/></para>
  <para style="s1">Wɔkyɛ Asade</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>“Ɛsɛ sɛ wo ne ɔsɔfo Eleasar ne mmusua no mpanyimfo nyinaa kan asade a nnipa ne mmoa a mofaa wɔ ɔko no mu no. <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>Monkyɛ asade no mu abien pɛpɛɛpɛ mfa fa mma asraafo a wɔkɔɔ ɔko no na momfa fa a aka no mma nnipa a wɔaka no. <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>Asraafo a wɔkoo no kyɛfa mu no, munyi ahannum biara so baako; sɛ ɛyɛ nnipa, anantwi, mfurum anaa nguan na momfa nsom <char style="nd">Awurade</char>. <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>Fa saa kyɛfa yi ma ɔsɔfo Eleasar na onhim no afɔremuka no anim mfa mma <char style="nd">Awurade</char>. <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>Afei Israelfo a wɔaka no kyɛfa no, munyi aduonum biara mu baako; sɛ ɛyɛ nnipa, anantwi, mfurum, nguanten anaa mmoa foforo biara no, momfa mma Lewifo a wɔhwɛ <char style="nd">Awurade</char> Ahyiae Ntamadan no so no.” <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>Enti Mose ne ɔsɔfo Eleasar yɛɛ nea <char style="nd">Awurade</char> hyɛɛ wɔn sɛ wɔnyɛ no.<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32"/>Asade a ɛkae a akofo no fae no dodow yɛ nguan mpem ahansia ne aduɔson anum (675,000); <verse eid="NUM 31:32"/><verse number="33" style="v" sid="NUM 31:33"/>anantwi mpem aduɔson abien (72,000); <verse eid="NUM 31:33"/><verse number="34" style="v" sid="NUM 31:34"/>mfurum mpem aduosia baako (61,000); <verse eid="NUM 31:34"/><verse number="35" style="v" sid="NUM 31:35"/>ne mmeawa mpem aduasa abien (32,000).<verse eid="NUM 31:35"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="36" style="v" sid="NUM 31:36"/>Nneɛma no fa a wɔde maa asraafo no dodow ni:</para>
  <para style="b" vid="NUM 31:36"/>
  <para style="li1" vid="NUM 31:36">Nguan mpem ahaasa aduasa ason ne ahannum (337,500) <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>a wɔde mu ahansia aduɔson anum (675) som <char style="nd">Awurade</char>;<verse eid="NUM 31:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 31:38"/>Anantwi mpem aduasa asia (36,000) a wɔde mu aduɔson abien (72) som <char style="nd">Awurade</char>;<verse eid="NUM 31:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 31:39"/>mfurum mpem aduasa ne ahannum (30,500) a wɔde emu aduosia baako (61) som <char style="nd">Awurade</char>;<verse eid="NUM 31:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 31:40"/>mmeawa mpem dunsia (16,000); wɔde wɔn mu aduasa abien (32) som <char style="nd">Awurade</char>.<verse eid="NUM 31:40"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41"/>Kyɛfa a wɔde <char style="nd">Awurade</char> no nyinaa no wɔde maa ɔsɔfo Eleasar sɛnea <char style="nd">Awurade</char> kyerɛɛ Mose sɛ ɔnyɛ no ara pɛ.<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42"/>Asade no a Israelfo no nyaa no na edidi so yi: <verse eid="NUM 31:42"/><verse number="43" style="v" sid="NUM 31:43"/>nguan mpem ahaasa aduasa ason ne ahannum (337,500), <verse eid="NUM 31:43"/><verse number="44" style="v" sid="NUM 31:44"/>anantwi mpem aduasa asia (36,000), <verse eid="NUM 31:44"/><verse number="45" style="v" sid="NUM 31:45"/>mfurum Mpem aduasa ne ahannum (30,500) ne <verse eid="NUM 31:45"/><verse number="46" style="v" sid="NUM 31:46"/>mmeawa mpem dunsia (16,000). <verse eid="NUM 31:46"/><verse number="47" style="v" sid="NUM 31:47"/>Nnipa no kyɛfa a wonyae no, Mose yiyii nnommum ne mmoa aduonum biara mu baako de maa Lewifo a wɔhwɛ <char style="nd">Awurade</char> Ahyiae Ntamadan so no. Wɔyɛɛ eyi nyinaa sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no.<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>Afei, asraafo no so mpanyimfo baa Mose nkyɛn <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>bɛka kyerɛɛ no se, “Yɛabu nnipa a yɛde wɔn kɔɔ ɔko no nyinaa ano akyerɛ wo na ɔbaako koraa anyera. <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>Ɛno nti, yefi nea yenyaa no ɔko no mu no bi mu rebɛda <char style="nd">Awurade</char> ase. Yɛn asedade no yɛ sika nnwinne, nkapo, nkaa, asokaa ne kɔnmuade. Eyinom bɛyɛ mpata ama yɛn kra wɔ Awurade anim.”<verse eid="NUM 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51"/>Mose ne ɔsɔfo Eleasar gyee saa akyɛde yi a ɛyɛ sikakɔkɔɔ ne nnwinne no fii asraafo mpanyimfo no nkyɛn. <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>Ne nyinaa mu sikakɔkɔɔ a asahene no de bae sɛ akyɛde a wɔde rebrɛ <char style="nd">Awurade</char> no ano si nkaribo kilogram ɔha ne aduɔkron. <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>Na asraafo no afa ɔko no mu nneɛma a wonyae no bi. <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>Enti Mose ne Eleasar gyee akyɛde no fii asraafo mpanyimfo no hɔ, na wɔde sikakɔkɔɔ no baa Ahyiae Ntamadan no mu sɛ ɛnyɛ nkae ade mma <char style="nd">Awurade</char> sɛ Israelfo yɛ ne dea.<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">Mmusuakuw A Wɔwɔ Yordan Agya</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>Na Ruben ne Gad mmusuakuw no wɔ nyɛmmoa pii, enti wuhuu sɛ Yaser ne Gilead nsase no beye ama wɔn nguan ne anantwi no. <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>Enti wɔkɔɔ Mose ne ɔsɔfo Eleasar ne nnipa no ntuanofo no nkyɛn kɔka kyerɛɛ wɔn se, <verse eid="NUM 32:2"/><verse number="3" style="v" sid="NUM 32:3"/>“Atarot, Dibon, Yaser, Nimra, Hesbon, Eleale, Sebam, Nebo ne Beon yɛ <verse eid="NUM 32:3"/><verse number="4" style="v" sid="NUM 32:4"/>nsase a <char style="nd">Awurade</char> ako, agye ama Israelfo na eye ma yɛn nguan ne yɛn anantwi. <verse eid="NUM 32:4"/><verse number="5" style="v" sid="NUM 32:5"/>Sɛ yɛanya adom wɔ mo anim a, yɛsrɛ mo momfa saa asase yi mma yɛn sɛ yɛn kyɛfa na munnyae Asubɔnten Yordan agya nohɔ a mopɛ sɛ mode ma yɛn no.”<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>Mose nso bisaa Rubenfo ne Gadfo no se, “Mokyerɛ sɛ, mopɛ sɛ motena ha bere a mo nuanom atwa mu rekɔko? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>Adɛn nti na mopɛ sɛ mubu Israelfo no aba mu ma wɔsan sɛ wɔrenkɔ asase a <char style="nd">Awurade</char> de ama wɔn no so no? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>Ade koro yi ara na mo agyanom yɛe. Mesomaa wɔn fii Kades-Barnea sɛ wɔnkɔsra asase no. <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>Wowiee nsra no na wofi Eskol subon mu bae no, wobuu nnipa no aba mu sɛ wɔnnkɔ asase a <char style="nd">Awurade</char> de ama wɔn no so. <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>Da no <char style="nd">Awurade</char> abufuw sɔree na ɔkaa saa ntam yi: <verse eid="NUM 32:10"/><verse number="11" style="v" sid="NUM 32:11"/>‘Esiane sɛ wɔamfi wɔn koma nyinaa mu anni mʼakyi nti wɔn mu biara nni hɔ a bere a wɔrefi Misraim no a na wadi mfe aduonu anaa nea ɛboro saa a no behu asase a mehyɛɛ Abraham, Isak ne Yakob ho bɔ no, <verse eid="NUM 32:11"/><verse number="12" style="v" sid="NUM 32:12"/>ɔbaako mpo nni hɔ, gye Kenesini<note caller="+" style="f"><char style="fr" closed="false">32.12 </char><char style="ft" closed="false">Sɛnea 1 Mose 15.19 ne 36.11 kyerɛ no, Kenesifo yɛ Kanaanfo a wɔyɛ Esau asefo.</char></note> Yefune babarima Kaleb ne Nun babarima Yosua, efisɛ wɔde wɔn koma nyinaa dii <char style="nd">Awurade</char> akyi, hyɛɛ nnipa nkuran sɛ wɔnkɔ Bɔhyɛ Asase no so.’ <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/><char style="nd">Awurade</char> maa yekyinkyin sare no so hɔ mfirihyia aduanan kosii sɛ saa awo ntoatoaso amumɔyɛfo no nyinaa wuwui.<verse eid="NUM 32:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 32:14"/>“Nanso monhwɛ, abɔnefo, moregyina mo agyanom anan mu ama <char style="nd">Awurade</char> bo afuw Israel nea ɛkyɛn so. <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>Sɛ mosan fi nʼakyi a, ɔbɛsan agyaw ne nnipa no nyinaa wɔ sare so hɔ na wɔn sɛe no befi mo.”<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>Wɔteɛɛ mu se, “Ɛnte saa koraa! Yɛbɛyɛ yɛn nguannan na yɛakyekyere nkurow akɛse ama yɛn mmea ne mmofra. <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>Na yɛn ankasa de akode bɛhyehyɛ yɛn ho adi Israelfo a wɔaka no anim akosi sɛ yɛde wɔn bɛba asomdwoe mu ama wɔabɛfa wɔn agyapade. Na nea edi kan no, ɛsɛ sɛ yɛkyekye nkurow a yebegye afasu afa ho ama yɛn nkurɔfo atena mu na ɛhɔfo no ankɔtow anhyɛ wɔn so. <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>Sɛ Israelfo no nyinaa nsa nkaa wɔn agyapade no a, yɛrensan mma yɛn afi mu. <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>Yɛne wɔn renkyɛ Yordan agya hɔ asase biara, efisɛ yɛanya yɛn agyapade no wɔ Yordan apuei fam hɔ.”<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>Mose kae se, “Sɛ mobɛyɛ sɛnea moaka no, sɛ mobɛhyehyɛ mo ho wɔ <char style="nd">Awurade</char> anim ama ɔko, <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>na mode mo asraafo no atwa Yordan kosi sɛ <char style="nd">Awurade</char> bɛpam nʼatamfo no, <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>na sɛ asase no ho asɛm dwo brɛoo wɔ <char style="nd">Awurade</char> anim a, ɛno de mutumi san ba. Ɛba saa a, na ɛkyerɛ sɛ, moayɛ mo asɛde ama <char style="nd">Awurade</char> ne Israelfo nyinaa. Na asase a ɛda apuei no nso, Awurade de bɛma mo.<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>“Sɛ moanni asɛm a moaka no so a, na moayɛ bɔne atia <char style="nd">Awurade</char>, munhu sɛ, ɛho asotwe bɛba mo so. <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>Monkɔ so nkyekyere nkurow mma mo fifo na monyɛ nguannan mma mo nguan na munni asɛm a mokae no nyinaa so.”<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>Ruben ne Gad nkurɔfo no kae se, “Yebedi wʼahyɛde no so pɛpɛɛpɛ. <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>Yɛn mma, yɛn yerenom, yɛn nguan ne yɛn anantwi bɛtena Gilead nkuropɔn mu. <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>Nanso yɛn a wɔakyere yɛn sɛ asraafo no bɛko ama <char style="nd">Awurade</char> sɛnea woaka no.”<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>Enti Mose penee so ka kyerɛɛ Eleasar, Yosua ne mpanyimfo a wotuatua Israel mmusuakuw ano no se, <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>“Sɛ Gad ne Ruben abusuakuw mu mmarima nyinaa a wɔakyere wɔn ayɛ wɔn asraafo sɛ wɔnkɔko mma <char style="nd">Awurade</char> no ne me kɔ Yordan na sɛ wɔkɔko di nkonim wɔ hɔ a, momfa Gilead asase no mma wɔn; <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>na sɛ wɔankɔ a, ɛno de, wɔmpene so mfa nsase a mowɔ wɔ Kanaan asase so no bi.”<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>Gad ne Ruben abusuafo kaa bio se, “Wo nkoa bedi <char style="nd">Awurade</char> asɛm so; <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>yɛde akode bɛhyehyɛ yɛn ho adi <char style="nd">Awurade</char> akyi akɔ Kanaan, nanso yɛn ara yɛn asase bɛda Yordan fa ha.”<verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>Enti Mose ma wɔde Amorihene Sihon ne Basanhene Og nsasetam ne wɔn nkurow akɛse maa Gad, Ruben ne Yosef babarima Manase mmusuakuw.<verse eid="NUM 32:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34"/>Gad nkurɔfo na wɔkyekyeree saa nkurow yi: Dibon, Atarot, Aroer. <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>Atrot-Sofan, Yaser Yogbeha, <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>Bet-Nimra ne Betharan. Na ɛyɛ nkurow a nguan wɔ mu yiye. <verse eid="NUM 32:36"/><verse number="37" style="v" sid="NUM 32:37"/>Ruben mmabarima na wɔkyekyeree saa nkurow a edidi so yi: Hesbon, Eleale ne Kiriataim, <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>Nebo, Baal-Meon a akyiri no wɔsesaa wɔn din, ne Sibma. Wɔtotoo nkurow a wɔsan kyekyee no din.<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>Makir asefo a wofi Manase abusuakuw mu kɔɔ Gilead kɔko dii hɔ so pam Amorifo a saa bere no na wɔte hɔ no nyinaa. <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>Enti Mose de Gilead maa Makirfo a wɔyɛ Manase asefo no, ma wɔtenaa hɔ. <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>Manase abusuakuw mu nnipa foforo bi a wofi Yair nso tenatenaa Gilead nkurow bebree so, sesaa beae a wɔwɔ hɔ no din frɛɛ hɔ Hafrotyair. <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>Ɔbarima bi a ne din de Noba dii asraafo bi anim de wɔn kɔɔ Kenat ne ne nkuraase kɔbɔɔ wɔn atenae wɔ hɔ enti ɔde ne din Noba too saa beae hɔ.<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">Israelfo Akwantu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>Eyi ne akwantu nhyehyɛe a Israelfo dii so bere a Mose ne Aaron de wɔn fi Misraim no. <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>Mose kyerɛw faako a wɔfaa nyinaa sɛnea <char style="nd">Awurade</char> kyerɛɛ no sɛ ɔnyɛ no. Eyinom ne mmeae ahorow a wɔsoɛɛ wɔ wɔn akwantu no mu.<verse eid="NUM 33:2"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="3" style="v" sid="NUM 33:3"/>Wosii mu fii Rameses kuropɔn no mu wɔ Twam Afahyɛ a edi kan no akyi ɔsram edi kan da ɛto so dunum. Wɔde akokoduru fii hɔ a Misraimfo no rehwɛ wɔn. <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>Saa bere no na Misraimfo no resie wɔn mmakan a <char style="nd">Awurade</char> kunkum wɔn anadwo a ade rebɛkye ama wɔatu kwan no, efisɛ na <char style="nd">Awurade</char> de atemmu aba wɔn anyame no nyinaa so.<verse eid="NUM 33:4"/></para>
  <para style="pi1">
    <verse number="5" style="v" sid="NUM 33:5"/>Wofii Rameses no, wɔbɛbɔɔ atenae wɔ Sukot.<verse eid="NUM 33:5"/></para>
  <para style="pi1">
    <verse number="6" style="v" sid="NUM 33:6"/>Wofii Sukot bɛbɔɔ atenae wɔ Etam, sare no ano.<verse eid="NUM 33:6"/></para>
  <para style="pi1">
    <verse number="7" style="v" sid="NUM 33:7"/>Wofii Etam san wɔn akyi baa Pihahirot a ɛwɔ Baal-Sefon apuei fam, na wɔbɔɔ atenae bɛnee bepɔw Migdol.<verse eid="NUM 33:7"/></para>
  <para style="pi1">
    <verse number="8" style="v" sid="NUM 33:8"/>Wofi Pihahirot, na wotwaa Po Kɔkɔɔ no kɔɔ sare so. Wɔde nnansa nantew faa Etam sare so kɔbɔɔ atenae wɔ Mara.<verse eid="NUM 33:8"/></para>
  <para style="pi1">
    <verse number="9" style="v" sid="NUM 33:9"/>Wofii Mara no, wɔbaa Elim; baabi a na mmura dumien ne mmedua aduɔson wɔ hɔ.<verse eid="NUM 33:9"/></para>
  <para style="pi1">
    <verse number="10" style="v" sid="NUM 33:10"/>Wofii Elim no, wɔbɔɔ atenae wɔ Po Kɔkɔɔ no ho.<verse eid="NUM 33:10"/></para>
  <para style="pi1">
    <verse number="11" style="v" sid="NUM 33:11"/>Wofii Po Kɔkɔɔ no ho, kɔbɔɔ atenae wɔ Sin nweatam so.<verse eid="NUM 33:11"/></para>
  <para style="pi1">
    <verse number="12" style="v" sid="NUM 33:12"/>Wotu fii Sin sare so kɔbɔɔ atenae Dofka.<verse eid="NUM 33:12"/></para>
  <para style="pi1">
    <verse number="13" style="v" sid="NUM 33:13"/>Wofii Dofka kɔbɔɔ atenae wɔ Alus.<verse eid="NUM 33:13"/></para>
  <para style="pi1">
    <verse number="14" style="v" sid="NUM 33:14"/>Wofii Alus kɔbɔɔ atenae wɔ Refidim, baabi a na wonnya nsu mma nnipa no nnom.<verse eid="NUM 33:14"/></para>
  <para style="pi1">
    <verse number="15" style="v" sid="NUM 33:15"/>Wofii Refidim no, wɔkɔbɔɔ atenae wɔ Sinai sare so.<verse eid="NUM 33:15"/></para>
  <para style="pi1">
    <verse number="16" style="v" sid="NUM 33:16"/>Wofii Sinai sare so no, wɔkɔɔ atenae wɔ Kibrot-Hataawa.<verse eid="NUM 33:16"/></para>
  <para style="pi1">
    <verse number="17" style="v" sid="NUM 33:17"/>Wofii Kibrot-Hataawa no, wɔkɔbɔɔ atenae wɔ Haserot.<verse eid="NUM 33:17"/></para>
  <para style="pi1">
    <verse number="18" style="v" sid="NUM 33:18"/>Wofii Haserot kɔbɔɔ atenae wɔ Ritma.<verse eid="NUM 33:18"/></para>
  <para style="pi1">
    <verse number="19" style="v" sid="NUM 33:19"/>Wofii Ritma kɔbɔɔ atenae wɔ Rimon Peres.<verse eid="NUM 33:19"/></para>
  <para style="pi1">
    <verse number="20" style="v" sid="NUM 33:20"/>Wofii Rimon Peres kɔbɔɔ atenae wɔ Libna.<verse eid="NUM 33:20"/></para>
  <para style="pi1">
    <verse number="21" style="v" sid="NUM 33:21"/>Wofii Libna kɔbɔɔ atenae wɔ Risa.<verse eid="NUM 33:21"/></para>
  <para style="pi1">
    <verse number="22" style="v" sid="NUM 33:22"/>Wofii Risa kɔbɔɔ atenae wɔ Kahelata.<verse eid="NUM 33:22"/></para>
  <para style="pi1">
    <verse number="23" style="v" sid="NUM 33:23"/>Wofii Kahelata kɔbɔɔ atenae wɔ Sefer Bepɔw so.<verse eid="NUM 33:23"/></para>
  <para style="pi1">
    <verse number="24" style="v" sid="NUM 33:24"/>Wofii Sefer Bepɔw so kɔbɔɔ atenae wɔ Harada.<verse eid="NUM 33:24"/></para>
  <para style="pi1">
    <verse number="25" style="v" sid="NUM 33:25"/>Wofii Harada kɔbɔɔ atenae wɔ Makhelot.<verse eid="NUM 33:25"/></para>
  <para style="pi1">
    <verse number="26" style="v" sid="NUM 33:26"/>Wofii Makhelot kɔbɔɔ atenae wɔ Tahat.<verse eid="NUM 33:26"/></para>
  <para style="pi1">
    <verse number="27" style="v" sid="NUM 33:27"/>Wofii Tahat kɔbɔɔ atenae wɔ Tera.<verse eid="NUM 33:27"/></para>
  <para style="pi1">
    <verse number="28" style="v" sid="NUM 33:28"/>Wofii Tera kɔbɔɔ atenae wɔ Mitka.<verse eid="NUM 33:28"/></para>
  <para style="pi1">
    <verse number="29" style="v" sid="NUM 33:29"/>Wofii Mitka kɔbɔɔ atenae wɔ Hasmona.<verse eid="NUM 33:29"/></para>
  <para style="pi1">
    <verse number="30" style="v" sid="NUM 33:30"/>Wofii Hasmona kɔbɔɔ atenae wɔ Moserot.<verse eid="NUM 33:30"/></para>
  <para style="pi1">
    <verse number="31" style="v" sid="NUM 33:31"/>Wofii Moserot kɔbɔɔ atenae wɔ Beneyaakan.<verse eid="NUM 33:31"/></para>
  <para style="pi1">
    <verse number="32" style="v" sid="NUM 33:32"/>Wofii Beneyaakan kɔbɔɔ atenae wɔ Horhagidgad.<verse eid="NUM 33:32"/></para>
  <para style="pi1">
    <verse number="33" style="v" sid="NUM 33:33"/>Wofii Horhagidgad kɔbɔɔ atenae wɔ Yotbata.<verse eid="NUM 33:33"/></para>
  <para style="pi1">
    <verse number="34" style="v" sid="NUM 33:34"/>Wofii Yotbata kɔbɔɔ atenae wɔ Abrona.<verse eid="NUM 33:34"/></para>
  <para style="pi1">
    <verse number="35" style="v" sid="NUM 33:35"/>Wofii Abrona kɔbɔɔ atenae wɔ Esion-Geber.<verse eid="NUM 33:35"/></para>
  <para style="pi1">
    <verse number="36" style="v" sid="NUM 33:36"/>Wofii Esion-Geber kɔbɔɔ atenae wɔ Kades, wɔ Sin sare so.<verse eid="NUM 33:36"/></para>
  <para style="pi1">
    <verse number="37" style="v" sid="NUM 33:37"/>Wofii Kades kɔbɔɔ atenae wɔ Bepɔw Hor so, wɔ Edom hye ano. <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>Bere a woduu Bepɔw Hor ase no, <char style="nd">Awurade</char> ka kyerɛɛ ɔsɔfo Aaron se ɔnkɔ bepɔw no atifi, na ɛhɔ na okowui. Asɛm yi sii mfe aduanan so a Israelfo tu fii Misraim no. <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>Aaron dii mfe ɔha aduonu abiɛsa, bere a owuu wɔ Bepɔw Hor so no.<verse eid="NUM 33:39"/></para>
  <para style="pi1">
    <verse number="40" style="v" sid="NUM 33:40"/>Saa bere no ara mu na Kanaanhene Arad a ɔtenaa Negeb wɔ Kanaan asase so no tee sɛ Israelfo no reba nʼasase so.<verse eid="NUM 33:40"/></para>
  <para style="pi1">
    <verse number="41" style="v" sid="NUM 33:41"/>Israelfo no toaa wɔn akwantu no so fi Bepɔw Hor so kɔbɔɔ atenae wɔ Salmona.<verse eid="NUM 33:41"/></para>
  <para style="pi1">
    <verse number="42" style="v" sid="NUM 33:42"/>Wofii Salmona kɔtenaa Punon.<verse eid="NUM 33:42"/></para>
  <para style="pi1">
    <verse number="43" style="v" sid="NUM 33:43"/>Wofii Punon kɔtenaa Obot.<verse eid="NUM 33:43"/></para>
  <para style="pi1">
    <verse number="44" style="v" sid="NUM 33:44"/>Wɔtoaa so kɔɔ Iye-Abarim, Moab hye so kɔtenaa hɔ.<verse eid="NUM 33:44"/></para>
  <para style="pi1">
    <verse number="45" style="v" sid="NUM 33:45"/>Wofii hɔ no, wɔkɔtenaa Dibon Gad.<verse eid="NUM 33:45"/></para>
  <para style="pi1">
    <verse number="46" style="v" sid="NUM 33:46"/>Wofii Dibon Gad kɔtenaa Almon Diblataim.<verse eid="NUM 33:46"/></para>
  <para style="pi1">
    <verse number="47" style="v" sid="NUM 33:47"/>Wofii Almon Diblataim kɔtenaa Abarim mmepɔw a ɛbɛn Nebo no so.<verse eid="NUM 33:47"/></para>
  <para style="pi1">
    <verse number="48" style="v" sid="NUM 33:48"/>Akyiri no, wotutu fii hɔ twaa mu wɔ Yeriko kɔbɔɔ atenae wɔ Moab tataw so wɔ Asubɔnten Yordan ho. <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>Wɔwɔ saa beae hɔ no, wɔtenaa mmeae bebree a ɛbɛn Asubɔnten Yordan ho—efi Bet-Yesimot kosi Abel Sitim a ɛwɔ Moab tataw so no.<verse eid="NUM 33:49"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>Bere a wɔabɔ atenase wɔ hɔ no na <char style="nd">Awurade</char> nam Mose so kasa kyerɛɛ Israelfo no se, <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>“Sɛ mutwa Asubɔnten Yordan kodu Kanaan asase so a, <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>mompam nnipa a wɔte hɔ no nyinaa na monsɛe wɔn abosom ne ahoni a wɔde abo ayɛ ne nsɔree a wɔasisi no petee mu wɔ mmepɔw so ne mmeae a wɔsom wɔn ahoni no nyinaa. <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>Mede asase no ama mo. Momfa na montena so. <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>Munnyina ntontobɔ so nkyekyɛ asase no, sɛnea mo mmusua no te. Wɔn a wɔdɔɔso no, wɔbɛma wɔn asase kɛse na wɔn a wosua no nso benya asase ketewa. Sɛnea ntonto no besi abɔ biara no na ɛbɛyɛ wɔn de. Monhwɛ mo agyanom mmusua so mfa nkyekyɛ.<verse eid="NUM 33:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55"/>“Sɛ moampam nnipa a wɔte hɔ no a, wɔbɛyɛ mo ani ase mpe ne mo honam mu nsɔe. Wɔbɛhaw mo wɔ asase a mobɛtena so no so. <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>Na mede nea masusuw sɛ mɛyɛ wɔn no, bɛyɛ mo.”<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">Kanaan Ahye</para>
  <para style="li4">
    <verse number="1" style="v" sid="NUM 34:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>“Ka kyerɛ Israelfo no se: ‘Sɛ mubedu Kanaan asase no so a, asase a mede rema mo sɛ mo ankasa asase no a, sɛɛ na mo ahye bɛyɛ:<verse eid="NUM 34:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="NUM 34:3"/>“ ‘Asase no anafo fam no bɛyɛ Sin sare so a ɛda Edom hye ano no fa bi. Anafo hye no ano befi apuei fam, Nkyene Po no anafo. <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>Ɛbɛtoa so akɔtra Akrabbim wɔ anafo hɔ a ɛrekɔ Sin no. Nʼanafo pa ara no bɛyɛ Kades-Barnea, na efi hɔ akosi Hasarada de akowie Asmon. <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>Efi Asmon a, ɔhye no bɛkɔ ara akosi Misraim asuwa no mu na ano akɔpem Ntam Po no ano.<verse eid="NUM 34:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 34:6"/>Mo hye a ɛwɔ atɔe no bɛyɛ Ntam Po no ano.<verse eid="NUM 34:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 34:7"/>Mo hye a ɛda atifi no befi ase wɔ Ntam Po no ano na atoa so akosi bepɔw Hor, <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>de akɔ Lebo Hamat na akɔ Sedad <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>na atoa so akɔ Sifron na akowie wɔ Hasar-Enan.<verse eid="NUM 34:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 34:10"/>Apuei hye no befi Hasar-Enan akɔ Sefam. <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>Ɔhye no besian afi Sefam akosi Ribla wɔ Ain apuei fam. Efi hɔ a, ebesiansian afa mmepɔw no ase wɔ Galilea Po no apuei fam. <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>Ɔhye no besian afa Asubɔnten Yordan ho na akɔpem Nkyene Po no.</para>
  <para style="b" vid="NUM 34:12"/>
  <para style="li4" vid="NUM 34:12">“ ‘Sɛnea mo nsase ne mo ahye te ni.’ ”<verse eid="NUM 34:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>Afei Mose hyɛɛ Israelfo no se, “Momfa ntontobɔ so nkyekyɛ asase yi sɛ mo agyapade. <char style="nd">Awurade</char> ahyɛ sɛ wɔmfa mma mmusua akron ne fa no, <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>efisɛ Ruben ne Gad mmusuakuw no ne Manase abusua no fa no de, wɔanya wɔn agyapade dedaw. <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>Saa mmusua abien ne fa yi anya wɔn agyapade wɔ Yeriko akyi, Yordan apuei fam a ɛhwɛ apuei no.”<verse eid="NUM 34:15"/></para>
  <para style="s1">Ntuanofo A Wɔbɛkyɛ Asase No</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>“Nnipa a wɔn din didi so yi na mayi wɔn sɛ wɔnkyekyɛ asase no mu mma mo sɛ mo agyapade: Ɔsɔfo Eleasar ne, Nun babarima Yosua. <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>Yi abusua biara mu ɔpanyin baako na ɔmmoa nkyekyɛ asase no.<verse eid="NUM 34:18"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="19" style="v" sid="NUM 34:19"/>“Wɔn din na edidi so yi:</para>
  <para style="b" vid="NUM 34:19"/>
  <para style="li1" vid="NUM 34:19">“Yefune babarima Kaleb, Yuda abusuakuw ntuanoni;<verse eid="NUM 34:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20"/>Amihud babarima Semuel, Simeon abusuakuw ntuanoni;<verse eid="NUM 34:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21"/>Kislon babarima Elidad, Benyamin abusuakuw ntuanoni;<verse eid="NUM 34:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22"/>Yogli babarima Buki, Dan abusuakuw ntuanoni;<verse eid="NUM 34:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23"/>Efod babarima Haniel, Yosef babarima Manase abusuakuw ntuanoni;<verse eid="NUM 34:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24"/>Siftan babarima Kemuel, Yosef babarima Efraim abusuakuw ntuanoni;<verse eid="NUM 34:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25"/>Parknak babarima Elisafan, Sebulon abusuakuw ntuanoni;<verse eid="NUM 34:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26"/>Asan babarima Paltiel, Isakar abusuakuw ntuanoni;<verse eid="NUM 34:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27"/>Selomi babarima Ahihud, Aser abusuakuw ntuanoni;<verse eid="NUM 34:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28"/>Amihud babarima Pedahel, Naftali abusuakuw ntuanoni.”<verse eid="NUM 34:28"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="29" style="v" sid="NUM 34:29"/>Saa nnipa yi na <char style="nd">Awurade</char> yii wɔn sɛ wɔnhwɛ nkyekyɛ agyapade no mu mma Israelfo no wɔ Kanaan asase so no.<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">Lewifo Nkurow</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>Bere a Israelfo bɔɔ atenase wɔ Yordan ho, Moab tataw so wɔ Yeriko akyi no, <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>“Ka kyerɛ Israelfo no na wɔmfa wɔn agyapade no mu bi a ɛyɛ nkurow ne ɛho mmoa adidibea mma Lewifo no. <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>Nkurow no mu na wɔbɛtena na wɔn anantwi, wɔn nguan ne wɔn mmoa a aka no nso akɔ adidi wɔ adidibea hɔ.<verse eid="NUM 35:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 35:4"/>“Wɔn mmoa adidibea no kɛse befi kurow no afasu ho a ne fa biara trɛw yɛ anammɔn apem ne ahannum. <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>Munsusuw anammɔn mpensa mfi kurow no afasu no ho wɔ nʼafanan nyinaa. Eyi bɛyɛ mmoa adidibea kɛse ama nkurow no.<verse eid="NUM 35:5"/></para>
  <para style="s1">Guankɔbea Nkuropɔn</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>“Nkurow a mode bɛma Lewifo no no mu asia bɛyɛ guankɔbea nkuropɔn, baabi a obi a wafom akum ɔfoforo no, betumi aguan akɔ. Momfa nkurow aduanan abien nka ho mma wɔn. <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>Ne nyinaa bɛyɛ nkurow aduanan awotwe ne ho mmoa adidibea. <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>Saa nkurow yi befi Israelfo no agyapade mu. Mmusuakuw no mu akɛse bɛma Lewifo no nkurow bebree na mmusuakuw nketewa no ama kakraa bi. Abusuakuw biara bɛma sɛnea nʼagyapade kɛse te.”<verse eid="NUM 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>
    <char style="nd">Awurade</char> ka kyerɛɛ Mose se, <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>“Ka kyerɛ Israelfo no se, ‘Sɛ mutwa Yordan du Kanaan a, <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>mompaw nkurow bi mfa nyɛ guankɔbea nkurow a, obiara a ɔbɛfom akum onipa no betumi aguan akɔ hɔ. <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>Saa nkurow yi bɛyɛ guankɔbea a ebegye no afi owufo no abusuafo a wɔpɛ sɛ wɔtɔ owufo no wu so were no nsa mu; na ɛnsɛ sɛ wokum owudifo no gye sɛ wɔadi nʼasɛm abu no kumfɔ ansa. <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>Ɛsɛ sɛ wosisi guankɔbea nkurow yi mu abiɛsa wɔ Kanaan asase so <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>na wosisi abiɛsa nso wɔ Asubɔnten Yordan apuei fam. <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>Ɛnyɛ Israelfo nko na ɛhɔ bɛyɛ wɔn guankɔbea, na mmom, ɛbɛyɛ guankɔbea ama ahɔho ne akwantufo nyinaa.<verse eid="NUM 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>“ ‘Nanso sɛ obi de dade pema sin bi bɔ obi kum no a, wɔfa no sɛ wadi awu enti ɛsɛ sɛ wokum owudifo no. <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>Anaasɛ, sɛ wɔde ɔbo kɛse bi bɔ obi ma owu a, ɛyɛ awudi enti ɛsɛ sɛ wokum owudifo no. <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>Saa ara nso na sɛ wɔde dua na ekum no a ɛte ara ne no. <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>Sɛ ɔweretɔni no hyia owudifo no wɔ baabiara a, ɔwɔ ho kwan sɛ okum no bi. <verse eid="NUM 35:19"/><verse number="20" style="v" sid="NUM 35:20"/>Enti sɛ obi nam ɔtan so tow biribi bɔ obi, anaa, sɛ ɔtetɛw no, <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>anaa ɔde abufuw bɔ no kuturuku na onii no wu a, ɔyɛ owudifo nti ɛsɛ sɛ wokum no.<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>“ ‘Na sɛ emfi ɔtan so na obi sum ɔfoforo, anaa wanhyɛ da na ɔtow biribi ma ɛkɔbɔ obi, <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>anaasɛ wanhu no na ogyaa ɔbo bi a ɛso a ebetumi akum no mu ma ekokum no a, esiane sɛ saa onipa no nyɛ ɔtamfo na onkura adwene bɔne bi nti, <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>ɛyɛ bagua no asɛde sɛ wodi asɛm na wɔfa saa mmarakwan yi so bu ɔweretɔni no nea ne nsa apa no ntam atɛn. <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>Ɛsɛ sɛ bagua no bɔ nea ne nsa apa no ho ban fi ɔweretɔni no nsam na wɔde nea ne nsa apa no san kɔ guankɔbea kuropɔn a oguan kɔɔ mu no mu. Ɛsɛ sɛ nea ne nsa apa no tena hɔ ara kosi sɛ ɔsɔfopanyin a wɔsraa no ngo bewu.<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>“ ‘Nanso sɛ nea ne nsa apa no no fi guankɔbea kuropɔn a waguan akɔ mu no no ahye so <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>na ɔweretɔni no hu no wɔ hɔ a obetumi akum no a ɔrenni awudi ho fɔ. <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>Ɛsɛ sɛ nea ne nsa apa no tena guankɔbea kuropɔn no mu ara kosi sɛ ɔsɔfopanyin bewu. Ɔsɔfopanyin wu akyi nkutoo na obetumi asan akɔ nʼankasa agyapade ho.<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>“ ‘Ɛsɛ sɛ eyi yɛ mmara a mudi so wɔ awo ntoatoaso a ɛbɛba no nyinaa mu wɔ baabiara a mobɛtena.<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>“ ‘Ɛsɛ sɛ wokum obiara a obekum obi, nanso gye sɛ nnansefo a wɔboro onipa baako di tia no ansa na ɛsɛ sɛ wokum no. Sɛ onipa baako pɛ na odi adanse tia no de a, ɛno de, ɛnsɛ sɛ wokum no.<verse eid="NUM 35:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31"/>“ ‘Munnnye owudifo a ɛsɛ sɛ owu no ti mpata, nnyina so nnyaa no. Ɛsɛ sɛ wokum no.<verse eid="NUM 35:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32"/>“ ‘Munnnye obi a waguan akɔ guankɔbea kuropɔn mu no ti mpata nnyina so mma no nsan mmɛtena nʼasase so bere a ɔsɔfopanyin bi nwui.<verse eid="NUM 35:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33"/>“ ‘Munngu asase a mote so no ho fi. Awudi gu asase ho fi, na wɔrentumi nyɛ mpata foforo biara mma asase a wɔahwie mogya agu so gye sɛ wɔde nea ohwiee mogya gui no mogya yɛ okum owudifo no. <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>Munngu asase a mote so ne faako a mete no ho fi, efisɛ Me, <char style="nd">Awurade</char> no, mete Israelfo no mu.’ ”<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">Mmabea Bi Agyapade</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>Gilead abusua no ntuanofo, Makir a ɔyɛ Manase babarima ne Yosef nena asefo, kɔɔ Mose ne Israel mmusua ntuanofo no nkyɛn de adesrɛde kɔtoo wɔn anim. <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>Wɔkae se, “<char style="nd">Awurade</char> hyɛɛ wo se bɔ ntonto na gyina so kyekyɛ asase no ma Israelfo no. <char style="nd">Awurade</char> ɔhyɛɛ wo se fa yɛn nuabarima Selofehad agyapade ma ne mmabea. <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>Na sɛ ɛba sɛ wɔn mu bi kɔware wɔ abusua foforo mu a, ɔde asase a wɔde ama no no bɛkɔ aware. Sɛ ɛba saa a, yɛn abusua no asase a wɔde ama yɛn no so bɛtew. <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>Sɛ Israelfo Mfirihyia Aduonum Afahyɛ no du so a, wɔde wɔn agyapade no bɛka abusua a wɔkɔwaree wɔ mu no de ho, na wobeyi afi yɛn agyanom abusua agyapade mu.”<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>Enti Mose de saa ɔhyɛ nsɛm a efi <char style="nd">Awurade</char> yi maa Israelfo no: “Yosef abusuakuw mu nnipa no asɛm no yɛ nokware. <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>Nea <char style="nd">Awurade</char> rehyɛ ama Selofehad mmabea no ni: Wotumi ware ɔbarima biara a wɔpɛ a ofi wɔn agya abusuakuw mu. <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>Ɛnsɛ sɛ Israel agyapade biara fi abusuakuw bi mu kɔ abusuakuw foforo nsam, efisɛ ɛsɛ sɛ Israel agyanom abusuakuw biara agyapade tena hɔ sɛnea ɛte no. <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>Ɛsɛ sɛ mmabea a wɔwɔ Israel mmusuakuw mu nyinaa a agyapade tumi kɔ wɔn nsam no wareware wɔ wɔn agyanom mmusuakuw mu na Israel abusuakuw biara agyanom agyapade amfi wɔn abusuakuw mu. <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>Ɛnsɛ sɛ agyapade biara fi abusuakuw bi nsam kodi ɔfoforo nsam, ɛsɛ sɛ Israel Abusuakuw biara asase a wanya no tena hɔ.”<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>Selofehad mmabea no yɛɛ sɛnea <char style="nd">Awurade</char> hyɛɛ Mose no. <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>Mahla, Tirsa, Hogla, Milka ne Noa nyinaa wareware wɔn agyanom nuabarimanom mma. <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>Wɔwarewaree wɔ Yosef babarima Manase mmusua mu enti wɔn agyapade no kaa wɔn abusuakuw no mu.<verse eid="NUM 36:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>Eyinom ne mmara ne nhyehyɛe a <char style="nd">Awurade</char> nam Mose so de maa Israelfo wɔ Moab tataw so no, wɔ Asubɔnten Yordan a na wɔafi Yeriko atwa no.<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
