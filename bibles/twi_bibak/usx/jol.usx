<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Yoɛl</para>
  <para style="toc1">Odiyifo Yoɛl Nhoma</para>
  <para style="toc2">Yoɛl</para>
  <para style="toc3">Yoɛl</para>
  <para style="mt2">Odiyifo</para>
  <para style="mt1">Yoɛl</para>
  <para style="mt2">Nhoma</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>
    <char style="nd">Awurade</char> asɛm a ɛbaa Petuel babarima Yoel so ni.<verse eid="JOL 1:1"/></para>
  <para style="s1">Mmoadabi San Tue</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>Muntie saa asɛm yi, mo mpanyimfo;</para>
  <para style="q2" vid="JOL 1:2">muntie, mo a mote asase no so nyinaa.</para>
  <para style="q1" vid="JOL 1:2">Asɛm bi a ɛte sɛɛ asi mo mmere so</para>
  <para style="q2" vid="JOL 1:2">anaa mo mpanyimfo mmere so pɛn?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>Monka nkyerɛ mo mma,</para>
  <para style="q2" vid="JOL 1:3">na mo mma nso nka nkyerɛ wɔn mma</para>
  <para style="q2" vid="JOL 1:3">na wɔn mma nso nka nkyerɛ awo ntoatoaso a edi so no.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>Nea mmoadabikuw no gyawee no,</para>
  <para style="q2" vid="JOL 1:4">mmoadabi akɛse no awe;</para>
  <para style="q1" vid="JOL 1:4">nea mmoadabi akɛse no gyawee no,</para>
  <para style="q2" vid="JOL 1:4">mmoadabi nkumaa no awe;</para>
  <para style="q1" vid="JOL 1:4">nea mmoadabi nkumaa no gyawee no,</para>
  <para style="q2" vid="JOL 1:4">mmoadabi afoforo awe.<verse eid="JOL 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>Mo asabowfo, munnyan, na munsu!</para>
  <para style="q2" vid="JOL 1:5">Mo a monom bobesa nyinaa, muntwa adwo;</para>
  <para style="q1" vid="JOL 1:5">muntwa adwo, nsa foforo no nti,</para>
  <para style="q2" vid="JOL 1:5">efisɛ wɔahuam afi mo ano.<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>Ɔman bi atu mʼasase so sa;</para>
  <para style="q2" vid="JOL 1:6">dɔm a wɔyɛ den na wontumi nkan wɔn;</para>
  <para style="q1" vid="JOL 1:6">wɔn se te sɛ gyata se</para>
  <para style="q2" vid="JOL 1:6">na wɔwɔ gyatabere sebɔmmɔfo.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>Wasɛe me bobe</para>
  <para style="q2" vid="JOL 1:7">ne me borɔdɔma nnua.</para>
  <para style="q1" vid="JOL 1:7">Wawaawae nnua no ho bona,</para>
  <para style="q2" vid="JOL 1:7">atow agu</para>
  <para style="q2" vid="JOL 1:7">agyaw ne mman ho fitaa.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>Di awerɛhow sɛ ababaa a ofura atweaatam</para>
  <para style="q2" vid="JOL 1:8">na ɔresu ne kunu a ɔwaree no ne mmabaabere mu.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>Aduan ne ahwiesa afɔrebɔde,</para>
  <para style="q2" vid="JOL 1:9">wɔayi afi <char style="nd">Awurade</char> fi.</para>
  <para style="q1" vid="JOL 1:9">Asɔfo no retwa adwo,</para>
  <para style="q2" vid="JOL 1:9">wɔn a wɔsom wɔ <char style="nd">Awurade</char> anim no.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>Mfuw asɛe,</para>
  <para style="q2" vid="JOL 1:10">asase no so awo wosee</para>
  <para style="q1" vid="JOL 1:10">aduan no asɛe</para>
  <para style="q2" vid="JOL 1:10">nsa foforo no ayow</para>
  <para style="q2" vid="JOL 1:10">ngo nyinaa asa.<verse eid="JOL 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>Mo ani nwu, mo akuafo,</para>
  <para style="q2" vid="JOL 1:11">muntwa adwo, mo a mudua bobe;</para>
  <para style="q1" vid="JOL 1:11">Munsi apini mma awi ne atoko,</para>
  <para style="q2" vid="JOL 1:11">efisɛ otwabere no asɛe.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>Bobe no akisa</para>
  <para style="q2" vid="JOL 1:12">na borɔdɔma nnua no awuwu.</para>
  <para style="q1" vid="JOL 1:12">Atoaa nnua, mmedua, aprɛ ne</para>
  <para style="q2" vid="JOL 1:12">nnua a ɛwɔ mfuw no so nyinaa ahyew.</para>
  <para style="q1" vid="JOL 1:12">Nokware, anigye a nnipa wɔ no</para>
  <para style="q2" vid="JOL 1:12">atu ayera.<verse eid="JOL 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>Mumfura atweaatam na munni awerɛhow, asɔfo;</para>
  <para style="q2" vid="JOL 1:13">mo a mosom wɔ afɔremuka anim, muntwa adwo.</para>
  <para style="q1" vid="JOL 1:13">Mumfura atweaatam mmesi pɛ,</para>
  <para style="q2" vid="JOL 1:13">mo a mosom wɔ Onyankopɔn anim;</para>
  <para style="q1" vid="JOL 1:13">efisɛ aduan ne ahwiesa afɔrebɔde no</para>
  <para style="q2" vid="JOL 1:13">to atwa wɔ Onyankopɔn fi.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>Mommɔ mmuadadi kronkron ho dawuru;</para>
  <para style="q2" vid="JOL 1:14">momfrɛ nhyiamu kronkron.</para>
  <para style="q1" vid="JOL 1:14">Momfrɛ mpanyimfo</para>
  <para style="q2" vid="JOL 1:14">ne wɔn a wɔte asase no so nyinaa</para>
  <para style="q1" vid="JOL 1:14">mmra <char style="nd">Awurade</char> mo Nyankopɔn fi</para>
  <para style="q2" vid="JOL 1:14">na wommesu mfrɛ <char style="nd">Awurade</char>.<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>A, da no de!</para>
  <para style="q2" vid="JOL 1:15">
    <char style="nd">Awurade</char> da no abɛn;</para>
  <para style="q2" vid="JOL 1:15">Ɛbɛba sɛ ɔsɛe a efi Otumfo hɔ.<verse eid="JOL 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>So aduan ho nkɔɔ wɛn, a yɛani tua,</para>
  <para style="q2" vid="JOL 1:16">anigye ne ahosɛpɛw to atwa</para>
  <para style="q2" vid="JOL 1:16">wɔ yɛn Nyankopɔn fi ana?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>Aba no wu wɔ asase wosee mu,</para>
  <para style="q2" vid="JOL 1:17">adekoradan abubu,</para>
  <para style="q1" vid="JOL 1:17">aburowpata nso so nni mfaso,</para>
  <para style="q2" vid="JOL 1:17">efisɛ nnuan no ahyew.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>Sɛnea anantwi su!</para>
  <para style="q2" vid="JOL 1:18">na anantwikuw kyinkyin kwa.</para>
  <para style="q1" vid="JOL 1:18">Nguankuw mpo rebrɛ</para>
  <para style="q2" vid="JOL 1:18">efisɛ wonni didibea.<verse eid="JOL 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>
    <char style="nd">Awurade</char>, wo na misu frɛ wo,</para>
  <para style="q2" vid="JOL 1:19">efisɛ ogya ahyew sare so adidibea,</para>
  <para style="q2" vid="JOL 1:19">na ogyatannaa ahyew mfuw no so nnua nyinaa.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>Wuram mmoa mpo pere hwehwɛ wo.</para>
  <para style="q2" vid="JOL 1:20">Nsuwansuwa ayoyow,</para>
  <para style="q2" vid="JOL 1:20">na ogya ahyew sare so adidibea.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">Mmoadabi Dɔm</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>Hyɛn torobɛnto no wɔ Sion;</para>
  <para style="q2" vid="JOL 2:1">hyɛn abɛn no wɔ me bepɔw kronkron no so.</para>
  <para style="q1" vid="JOL 2:1">Ma wɔn a wɔte asase no so nyinaa ho mpopo,</para>
  <para style="q2" vid="JOL 2:1">efisɛ <char style="nd">Awurade</char> da no reba,</para>
  <para style="q2" vid="JOL 2:1">na abɛn koraa.<verse eid="JOL 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 2:2"/>Sum ne kusukuukuu da.<note caller="+" style="f"><char style="fr" closed="false">2.2 </char><char style="ft" closed="false">Sum…da. Sum yɛ daa daa adiyisɛm a wɔka fa Awurade da no ho. (<char style="xt"><ref loc="AMO 5:18">Amos 5.18</ref>; <ref loc="ZEP 1:15">Sef 1.15</ref></char>).</char></note></para>
  <para style="q2" vid="JOL 2:2">Omununkum ne sum kabii da.</para>
  <para style="q1" vid="JOL 2:2">Sɛnea adekyee hann trɛtrɛw wɔ mmepɔw so no,</para>
  <para style="q2" vid="JOL 2:2">saa ara na asraafo a wɔdɔɔso na wɔyɛ den ba no te.</para>
  <para style="q1" vid="JOL 2:2">Wonhuu wɔn sɛso bi da,</para>
  <para style="q2" vid="JOL 2:2">na wɔrenhu ne sɛso nso da.<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>Ogya rehyew wɔ wɔn anim,</para>
  <para style="q2" vid="JOL 2:3">ogyatannaa dɛw wɔ wɔn akyi,</para>
  <para style="q1" vid="JOL 2:3">asase a ɛda wɔn anim no te sɛ Eden turo,</para>
  <para style="q2" vid="JOL 2:3">nea ɛda wɔn akyi no te sɛ nweatam,</para>
  <para style="q2" vid="JOL 2:3">hwee nguan wɔn.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>Wɔte sɛ apɔnkɔ.</para>
  <para style="q2" vid="JOL 2:4">Wohuruhuruw te sɛ apɔnkɔsotefo asraafo.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>Wɔyɛ gyegyeegye te sɛ nteaseɛnam</para>
  <para style="q2" vid="JOL 2:5">na wotu fa mmepɔw atifi,</para>
  <para style="q1" vid="JOL 2:5">wɔte sɛ ogyatannaa a ɛhyew nwuraguanee</para>
  <para style="q2" vid="JOL 2:5">wɔte sɛ asraafo akantinka a wɔrekɔ ɔsa.<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>Aman ani bɔ wɔn so a, ehu bɔ wɔn;</para>
  <para style="q2" vid="JOL 2:6">na wɔn anim hoa.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>Wɔko kɔ wɔn anim te sɛ akofo;</para>
  <para style="q2" vid="JOL 2:7">wɔforo afasu te sɛ asraafo</para>
  <para style="q1" vid="JOL 2:7">na wɔn nyinaa kɔ wɔn anim tee,</para>
  <para style="q2" vid="JOL 2:7">na wɔmman benkum anaa nifa.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>Wontwintwan wɔn ho wɔn ho anan mu;</para>
  <para style="q2" vid="JOL 2:8">obiara nantew kɔ nʼanim tee.</para>
  <para style="q1" vid="JOL 2:8">Wobu fa abandennen so,</para>
  <para style="q2" vid="JOL 2:8">na wɔpem kɔ wɔn anim ara.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>Wɔtow hyɛ kuropɔn no so</para>
  <para style="q2" vid="JOL 2:9">wotu mmirika fa afasu no so</para>
  <para style="q1" vid="JOL 2:9">wɔforo kɔ afi mu,</para>
  <para style="q2" vid="JOL 2:9">wɔfa mfɛnsere mu te sɛ akorɔmfo.<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>Asase wosow wɔ wɔn anim,</para>
  <para style="q2" vid="JOL 2:10">na ɔsoro hinhim.</para>
  <para style="q1" vid="JOL 2:10">Owia ne ɔsram duru sum,</para>
  <para style="q2" vid="JOL 2:10">na nsoromma nhyerɛn bio.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>
    <char style="nd">Awurade</char> bobɔ mu</para>
  <para style="q2" vid="JOL 2:11">de di nʼasraafo no anim.</para>
  <para style="q1" vid="JOL 2:11">Nʼakofo no dɔɔso bebree,</para>
  <para style="q2" vid="JOL 2:11">ahoɔdenfo ne wɔn a wodi nʼahyɛde so.</para>
  <para style="q1" vid="JOL 2:11">
    <char style="nd">Awurade</char> da no yɛ kɛse na ɛyɛ hu;</para>
  <para style="q2" vid="JOL 2:11">hena na obetumi agyina ano?<verse eid="JOL 2:11"/></para>
  <para style="s1">Ahonu</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“Na afei,” sɛnea <char style="nd">Awurade</char> se ni,</para>
  <para style="q2" vid="JOL 2:12">“San fa wo koma nyinaa bra me nkyɛn,</para>
  <para style="q2" vid="JOL 2:12">wɔ akɔnkyen, osu ne awerɛhow mu.”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>Sunsuan wo koma</para>
  <para style="q2" vid="JOL 2:13">na ɛnyɛ wo ntade mu.</para>
  <para style="q1" vid="JOL 2:13">San bra <char style="nd">Awurade</char> wo Nyankopɔn nkyɛn,</para>
  <para style="q2" vid="JOL 2:13">efisɛ, ɔyɛ ɔdomfo, ne yam ye.</para>
  <para style="q1" vid="JOL 2:13">Ne bo kyɛ fuw na ne dɔ boro so,</para>
  <para style="q2" vid="JOL 2:13">na ɛnyɛ no anigye sɛ ɔtwe yɛn aso.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>Hena na onim? Ebia ɔbɛsesa nʼadwene na wahu mmɔbɔ</para>
  <para style="q2" vid="JOL 2:14">na wagyaw nhyira,</para>
  <para style="q1" vid="JOL 2:14">a ɛyɛ aduan ne ahwiesa afɔrebɔde</para>
  <para style="q2" vid="JOL 2:14">a mode ma <char style="nd">Awurade</char> mo Nyankopɔn no.<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>Hyɛn torobɛnto wɔ Sion!</para>
  <para style="q2" vid="JOL 2:15">Mommɔ akɔnkyen kronkron ho dawuru,</para>
  <para style="q1" vid="JOL 2:15">momfrɛ nhyiamu kronkron.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>Mommoaboa nnipa no ano</para>
  <para style="q2" vid="JOL 2:16">montew nhyiamu no ho na ɛnyɛ kronkron;</para>
  <para style="q1" vid="JOL 2:16">mommoaboa mpanyimfo,</para>
  <para style="q2" vid="JOL 2:16">mmofra ne mmea a wɔrema nufu ano.</para>
  <para style="q2" vid="JOL 2:16">Ma ayeforo ne ayeforokunu mfi wɔn pia mu mmra.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>Asɔfo a wɔsom wɔ <char style="nd">Awurade</char> anim no,</para>
  <para style="q2" vid="JOL 2:17">nsu wɔ afɔremuka no ne abrannaa no ntam;</para>
  <para style="q1" vid="JOL 2:17">na wɔnka se, “<char style="nd">Awurade</char> fa wo nkurɔfo ho kyɛ wɔn.</para>
  <para style="q2" vid="JOL 2:17">Mma wʼagyapade nyɛ ahohorade</para>
  <para style="q2" vid="JOL 2:17">anaa fɛwdi wɔ aman no mu.</para>
  <para style="q1" vid="JOL 2:17">Adɛn nti na ɛsɛ sɛ wubisa wɔ nnipa no mu se,</para>
  <para style="q2" vid="JOL 2:17">‘Wɔn Nyame no wɔ he?’ ”<verse eid="JOL 2:17"/></para>
  <para style="s1">Awurade Mmuae</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>Na <char style="nd">Awurade</char> bɛtwe ninkunu wɔ nʼasase ho</para>
  <para style="q2" vid="JOL 2:18">na ne nkurɔfo ayɛ no mmɔbɔ.<verse eid="JOL 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 2:19"/>
    <char style="nd">Awurade</char> bebua se,</para>
  <para style="q2" vid="JOL 2:19">“Merebrɛ mo aduan, nsa foforo ne ngo,</para>
  <para style="q1" vid="JOL 2:19">a ɛbɛso mo ama moamee pintinn.</para>
  <para style="q2" vid="JOL 2:19">Merenyɛ mo ahohorade</para>
  <para style="q2" vid="JOL 2:19">mma aman no bio.<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“Mɛpam atifi fam asraafo no afi wo nkyɛn akɔ akyirikyiri,</para>
  <para style="q2" vid="JOL 2:20">mepia wɔn akɔ asase a awo na ɛyɛ kesee so.</para>
  <para style="q1" vid="JOL 2:20">Nifa dɔm no bɛmem wɔ Nkyene Po no mu,</para>
  <para style="q2" vid="JOL 2:20">na kyidɔm no bɛmem wɔ Ntam Po no mu.</para>
  <para style="q1" vid="JOL 2:20">Na afunu no bɛbɔn</para>
  <para style="q2" vid="JOL 2:20">na ne nka betu.”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">Nokware wayɛ nneɛma akɛse!<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>Munnsuro, me nkurɔfo!</para>
  <para style="q2" vid="JOL 2:21">Momma mo ani nnye, na monsɛpɛw mo ho.</para>
  <para style="q1" vid="JOL 2:21">Nokware <char style="nd">Awurade</char> ayɛ nneɛma akɛse.<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>Munnsuro, mo wuram mmoa!</para>
  <para style="q2" vid="JOL 2:22">Efisɛ sare so adidibea reyɛ frɔmfrɔm.</para>
  <para style="q1" vid="JOL 2:22">Nnua no resow wɔn aba;</para>
  <para style="q2" vid="JOL 2:22">borɔdɔma ne bobe nso resow wɔn aba.<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>Momma mo ani nnye, mo Sion mma,</para>
  <para style="q2" vid="JOL 2:23">Munni ahurusi wɔ <char style="nd">Awurade</char> mo Nyankopɔn mu,</para>
  <para style="q1" vid="JOL 2:23">efisɛ watɔ asusowsu ama mo,</para>
  <para style="q2" vid="JOL 2:23">ne nokwaredi nti.</para>
  <para style="q1" vid="JOL 2:23">Watɔ osu bebree ama mo</para>
  <para style="q2" vid="JOL 2:23">wɔ ne bere mu te sɛ kan no.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>Aduan bɛyɛ awiporowbea hɔ ma,</para>
  <para style="q2" vid="JOL 2:24">nsa foforo ne ngo bebu so wɔ kyi amoa mu.<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“Mɛhyɛ mo anan mu,</para>
  <para style="q2" vid="JOL 2:25">nea mohweree</para>
  <para style="q2" vid="JOL 2:25">mfe dodow a mmoadabi bɛsɛee mo nneɛma,</para>
  <para style="q1" vid="JOL 2:25">mmoadabi akɛse ne nkumaa,</para>
  <para style="q2" vid="JOL 2:25">ne wɔn a aka no nyinaa,</para>
  <para style="q2" vid="JOL 2:25">me dɔm a mesomaa wɔn baa mo so no.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>Mubedidi amee,</para>
  <para style="q2" vid="JOL 2:26">na mubeyi <char style="nd">Awurade</char> mo Nyankopɔn din ayɛ.</para>
  <para style="q1" vid="JOL 2:26">Ɔno na wayɛ anwonwade ama mo;</para>
  <para style="q2" vid="JOL 2:26">me nkurɔfo ani renwu bio.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>Afei, mubehu sɛ, mewɔ Israel,</para>
  <para style="q2" vid="JOL 2:27">mubehu sɛ mene <char style="nd">Awurade</char>, mo Nyankopɔn,</para>
  <para style="q1" vid="JOL 2:27">na obiara nni hɔ sɛ me;</para>
  <para style="q2" vid="JOL 2:27">Me nkurɔfo ani renwu bio da.”<verse eid="JOL 2:27"/></para>
  <para style="s1">Awurade Da</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“Na akyiri no,</para>
  <para style="q2" vid="JOL 2:28">mehwie me honhom agu nnipa nyinaa so,</para>
  <para style="q1" vid="JOL 2:28">mo mmabarima ne mo mmabea bɛhyɛ nkɔm,</para>
  <para style="q2" vid="JOL 2:28">mo nkwakoraa bɛsoso adae,</para>
  <para style="q1" vid="JOL 2:28">mo mmerante benya anisoadehu.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>Saa mmere no mu no,</para>
  <para style="q2" vid="JOL 2:29">mehwie me Honhom agu</para>
  <para style="q1" vid="JOL 2:29">mʼasomfo so, mmarima ne mmea.<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>Mɛyɛ anwonwade wɔ ɔsoro ne asase so,</para>
  <para style="q2" vid="JOL 2:30">mede mogya, ogya ne wusiw kumɔnn.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>Ansa na Awurade da kɛse no bɛba no, owia beduru sum na ɔsram nso ayɛ sɛ mogya.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>Na obiara a ɔbɔ <char style="nd">Awurade</char> din no,</para>
  <para style="q2" vid="JOL 2:32">wobegye no nkwa.</para>
  <para style="q1" vid="JOL 2:32">Efisɛ nkwagye bɛba</para>
  <para style="q2" vid="JOL 2:32">ama wɔn a wɔanya wɔn ti adidi mu</para>
  <para style="q2" vid="JOL 2:32">a <char style="nd">Awurade</char> afrɛ wɔn</para>
  <para style="q2" vid="JOL 2:32">wɔ Sion bepɔw so ne Yerusalem nyinaa,”</para>
  <para style="q1" vid="JOL 2:32">sɛnea <char style="nd">Awurade</char> aka no.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">Aman No Atemmu</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“Saa nna no mu,</para>
  <para style="q2" vid="JOL 3:1">mede Yuda ne Yerusalem ahonyade bɛsan aba.<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>Mɛboa aman nyinaa ano,</para>
  <para style="q2" vid="JOL 3:2">na mede wɔn aba Yehosafat bon mu.</para>
  <para style="q1" vid="JOL 3:2">Ɛhɔ na mebu wɔn atɛn</para>
  <para style="q2" vid="JOL 3:2">wɔ nea wɔyɛɛ mʼagyapade, a ɛyɛ Israelfo ho,</para>
  <para style="q1" vid="JOL 3:2">efisɛ wɔbɔɔ me nkurɔfo hwetee aman so,</para>
  <para style="q2" vid="JOL 3:2">na wɔkyekyɛɛ mʼasase mu.<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>Wɔbɔɔ me nkurɔfo so ntonto,</para>
  <para style="q2" vid="JOL 3:3">Wɔtɔn mmerantewa de mu sika bɔɔ aguaman.</para>
  <para style="q1" vid="JOL 3:3">Wɔtɔn mmeawa nso de gyee nsa,</para>
  <para style="q2" vid="JOL 3:3">a wɔbɛnom.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“Dɛn na mowɔ tia me, Tiro ne Sidon ne mo Filisti amantam nyinaa? Mopɛ sɛ motɔ me so were ana? Sɛ saa na ɛte de a, monhwɛ yiye. Mɛyɛ ntɛm, atua mo biribiara a moayɛ no so ka. <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>Mofaa me dwetɛ ne me sikakɔkɔɔ ne mʼagyapade a ɛsom bo, na mosoa koguu mo abosonnan mu. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>Motontɔn nnipa a wɔte Yuda ne Yerusalem maa Helafo<note caller="+" style="f"><char style="fr" closed="false">3.6 </char><char style="ft" closed="false">Helafo ne Foenikefo dii gua fi afe 800 AWA.</char></note> sɛnea ɛbɛyɛ a, wobefi wɔn asase so akɔ akyirikyiri.<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“Nanso, mɛsan de wɔn afi faako a mokɔtɔn wɔn no aba, na nea moayɛ no nyinaa, metua mo so ka. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>Mɛtontɔn mo mmabarima ne mo mmabea ama Yudafo, na wɔn nso atɔn wɔn ama Arabfo, ɔman a ɛwɔ akyirikyiri no.” Me, <char style="nd">Awurade</char>, na makasa.<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>Mompae mu nka eyi wɔ aman so:</para>
  <para style="q2" vid="JOL 3:9">Munsiesie mo ho mma ɔko!</para>
  <para style="q1" vid="JOL 3:9">Monkanyan asraafo!</para>
  <para style="q2" vid="JOL 3:9">Momma mo mmarima akofo no ntwiw mmra, na wɔmmɛko.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>Momfa mo funtumnnade no mmɔ afoa,</para>
  <para style="q2" vid="JOL 3:10">na momfa mo asosɔw mmɔ mpeaw.</para>
  <para style="q1" vid="JOL 3:10">Ma nea wɔayɛ mmerɛw nka se,</para>
  <para style="q2" vid="JOL 3:10">“mewɔ ahoɔden!”<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>Monyɛ ntɛm mmra,</para>
  <para style="q2" vid="JOL 3:11">mo amanaman a moatwa ahyia,</para>
  <para style="q1" vid="JOL 3:11">mommɛboa mo ho ano wɔ hɔ.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">Fa wʼakofo bra, <char style="nd">Awurade</char>!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“Wɔnkanyan aman no;</para>
  <para style="q2" vid="JOL 3:12">wontu nteɛ nkɔ Yehosafat bon no mu,</para>
  <para style="q1" vid="JOL 3:12">efisɛ ɛhɔ na mɛtena</para>
  <para style="q2" vid="JOL 3:12">na mabu aman a atwa ahyia no nyinaa atɛn.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>Munhwim kantankrankyi no,</para>
  <para style="q2" vid="JOL 3:13">efisɛ otwabere no adu so.</para>
  <para style="q1" vid="JOL 3:13">Mommra, muntiatia bobe no so,</para>
  <para style="q2" vid="JOL 3:13">efisɛ nsakyiamoa no ayɛ ma</para>
  <para style="q1" vid="JOL 3:13">na ahina no ayɛ ma abu so.</para>
  <para style="q2" vid="JOL 3:13">Saa ara na wɔn amumɔyɛ dɔɔso!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>Nnipadɔm, nnipadɔm</para>
  <para style="q2" vid="JOL 3:14">wɔ gyinaesi subon no mu!</para>
  <para style="q1" vid="JOL 3:14">
    <char style="nd">Awurade</char> da no abɛn</para>
  <para style="q2" vid="JOL 3:14">wɔ gyinaesi subon no mu.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>Owia ne ɔsram beduru sum,</para>
  <para style="q2" vid="JOL 3:15">na nsoromma renhyerɛn bio.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>
    <char style="nd">Awurade</char> bɛbobɔ mu afi Sion,</para>
  <para style="q2" vid="JOL 3:16">ne nne gyegyeegye afi Yerusalem,</para>
  <para style="q2" vid="JOL 3:16">asase ne ɔsoro bɛwosow.</para>
  <para style="q1" vid="JOL 3:16">Nanso <char style="nd">Awurade</char> bɛyɛ guankɔbea ama ne nkurɔfo,</para>
  <para style="q2" vid="JOL 3:16">ɔbɛyɛ abandennen ama Israelfo.<verse eid="JOL 3:16"/></para>
  <para style="s1">Onyankopɔn Nkurɔfo Nhyira</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“Afei mubehu sɛ, me <char style="nd">Awurade</char>, mo Nyankopɔn,</para>
  <para style="q2" vid="JOL 3:17">mete Sion, me bepɔw kronkron so.</para>
  <para style="q1" vid="JOL 3:17">Yerusalem bɛyɛ kronkron;</para>
  <para style="q2" vid="JOL 3:17">na ananafo rentu wɔn so sa bio.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“Saa da no, nsa foforo bɛsosɔ afi mmepɔw no mu,</para>
  <para style="q2" vid="JOL 3:18">na nufusu ateɛ wɔ nkoko so;</para>
  <para style="q1" vid="JOL 3:18">Nsu bɛba Yuda nsuwansuwa mu,</para>
  <para style="q2" vid="JOL 3:18">na asuti betue afi <char style="nd">Awurade</char> fi,</para>
  <para style="q2" vid="JOL 3:18">na agugu akasia subon no so nsu.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>Nanso Misraim bɛdan amamfo,</para>
  <para style="q2" vid="JOL 3:19">na Edom nso bɛyɛ nweatam,</para>
  <para style="q1" vid="JOL 3:19">esiane awurukasɛm a wɔyɛ de tiaa nnipa a wɔwɔ Yuda nti.</para>
  <para style="q2" vid="JOL 3:19">Ɛhɔ na wohwiee mogya a enni fɔ gui.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>Nnipa bɛtena Yuda afebɔɔ</para>
  <para style="q2" vid="JOL 3:20">na Yerusalem de, wɔbɛtena hɔ awo ntoatoaso nyinaa mu.<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>So merentɔ wɔn mogya a edi bem no so were ana?</para>
  <para style="q2" vid="JOL 3:21">Mɛtɔ kɛ.”</para>
  <para style="qc" vid="JOL 3:21">Awurade te Sion!<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
