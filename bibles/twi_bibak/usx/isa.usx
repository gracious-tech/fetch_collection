<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Yesaia</para>
  <para style="toc1">Odiyifo Yesaia Nhoma</para>
  <para style="toc2">Yesaia</para>
  <para style="toc3">Yes</para>
  <para style="mt2">Odiyifo</para>
  <para style="mt1">Yesaia</para>
  <para style="mt2">Nhoma</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>Saa anisoadehu a ɛfa Yuda ne Yerusalem ho no baa Amos babarima Yesaia so wɔ Yuda ahemfo Usia, Yotam, Ahas ne Hesekia mmere so.<verse eid="ISA 1:1"/></para>
  <para style="b"/>
  <para style="s1">Atuatewman</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>Ɔsoro, muntie! Asase, yɛ aso!</para>
  <para style="q2" vid="ISA 1:2">Na <char style="nd">Awurade</char> akasa:</para>
  <para style="q1" vid="ISA 1:2">“Matetew mma ama wɔanyinyin,</para>
  <para style="q2" vid="ISA 1:2">nanso wɔatew me so atua.<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>Nantwi nim ne wura,</para>
  <para style="q2" vid="ISA 1:3">afurum nso nim ne wura mmoa adididaka,</para>
  <para style="q1" vid="ISA 1:3">nanso Israel nnim,</para>
  <para style="q2" vid="ISA 1:3">me nkurɔfo nte ase.”<verse eid="ISA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>Nnome nka, amumɔyɛ man,</para>
  <para style="q2" vid="ISA 1:4">ɔman a wɔn afɔdi so,</para>
  <para style="q1" vid="ISA 1:4">nnebɔneyɛfo kuw,</para>
  <para style="q2" vid="ISA 1:4">mma a porɔwee ahyɛ wɔn ma!</para>
  <para style="q1" vid="ISA 1:4">Wɔatwe wɔn ho afi <char style="nd">Awurade</char> ho;</para>
  <para style="q2" vid="ISA 1:4">wɔapo Israel Kronkronni no,</para>
  <para style="q2" vid="ISA 1:4">wɔadan wɔn akyi akyerɛ no.<verse eid="ISA 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>Adɛn nti na mopɛ sɛ wɔkɔ so boro mo?</para>
  <para style="q2" vid="ISA 1:5">Adɛn nti na moda so tew atua?</para>
  <para style="q1" vid="ISA 1:5">Wɔapira mo ti,</para>
  <para style="q2" vid="ISA 1:5">na mo koma nso di yaw.<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>Efi mo nan ase kosi mo ti so,</para>
  <para style="q2" vid="ISA 1:6">ahomeka biara nni mu,</para>
  <para style="q1" vid="ISA 1:6">apirakuru ne ahonhon nko ara</para>
  <para style="q2" vid="ISA 1:6">akuru a anim deda hɔ</para>
  <para style="q1" vid="ISA 1:6">na wɔnhohoro so anaa wɔnkyekyeree</para>
  <para style="q2" vid="ISA 1:6">anaa wɔmfaa ngo nsrasraa so ɛ.<verse eid="ISA 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>Mo man ada mpan,</para>
  <para style="q2" vid="ISA 1:7">wɔde ogya ahyehyew mo nkuropɔn;</para>
  <para style="q1" vid="ISA 1:7">ananafo regye mo mfuw</para>
  <para style="q2" vid="ISA 1:7">a mo ani tua,</para>
  <para style="q2" vid="ISA 1:7">na asɛe sɛnea ɛyɛɛ bere a ahɔho tuu mo gui no.<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>Wɔagyaw Ɔbabea Sion</para>
  <para style="q2" vid="ISA 1:8">te sɛ bobeturo mu sese</para>
  <para style="q1" vid="ISA 1:8">te sɛ akuraa a esi ɛfere afuw mu,</para>
  <para style="q2" vid="ISA 1:8">te sɛ kuropɔn a atamfo atwa ho ahyia.<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>Sɛ Asafo <char style="nd">Awurade</char></para>
  <para style="q2" vid="ISA 1:9">annyaw yɛn asefo a,</para>
  <para style="q1" vid="ISA 1:9">anka yɛayɛ sɛ Sodom,</para>
  <para style="q2" vid="ISA 1:9">na yɛadan ayɛ sɛ Gomora.<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>Muntie <char style="nd">Awurade</char> asɛm,</para>
  <para style="q2" vid="ISA 1:10">mo Sodom sodifo;</para>
  <para style="q1" vid="ISA 1:10">muntie yɛn Nyankopɔn mmara,</para>
  <para style="q2" vid="ISA 1:10">mo Gomorafo!<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>“Mo afɔrebɔ ahorow bebree no,</para>
  <para style="q2" vid="ISA 1:11">dɛn na ɛyɛ ma me?”</para>
  <para style="q2" vid="ISA 1:11">Sɛnea <char style="nd">Awurade</char> se ni.</para>
  <para style="q1" vid="ISA 1:11">“Mewɔ ɔhyew afɔrebɔde ma ɛboro so,</para>
  <para style="q2" vid="ISA 1:11">nea ɛyɛ adwennini ne mmoa a wɔadɔ srade;</para>
  <para style="q1" vid="ISA 1:11">mʼani nnye</para>
  <para style="q2" vid="ISA 1:11">anantwinini, nguantenmma ne mpapo mogya ho.<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>Sɛ moba mʼanim a</para>
  <para style="q2" vid="ISA 1:12">hena na obisa eyi fi mo hɔ,</para>
  <para style="q2" vid="ISA 1:12">sɛ mutiatia me fi yi?<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>Munnyae afɔrebɔde a ɛmfra a mode ba no!</para>
  <para style="q2" vid="ISA 1:13">Mo aduhuam yɛ me tan.</para>
  <para style="q1" vid="ISA 1:13">Ɔsram foforo, homenna ne nhyiamu ahorow,</para>
  <para style="q2" vid="ISA 1:13">mo nhyiamu hunu no afono me.<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>Mo ɔsram foforo afahyɛ ne mo aponto a moahyehyɛ,</para>
  <para style="q2" vid="ISA 1:14">me kra kyi.</para>
  <para style="q1" vid="ISA 1:14">Ayɛ adesoa ama me;</para>
  <para style="q2" vid="ISA 1:14">masoa abrɛ.<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>Sɛ momema mo nsa so bɔ mpae a,</para>
  <para style="q2" vid="ISA 1:15">meyi mʼani ato nkyɛn.</para>
  <para style="q1" vid="ISA 1:15">Sɛ mobɔ mpae bebree mpo a</para>
  <para style="q2" vid="ISA 1:15">merentie.</para>
  <para style="b" vid="ISA 1:15"/>
  <para style="q1" vid="ISA 1:15">“Mogya bebree agu mo nsa ho fi.<verse eid="ISA 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>“Munnwira mo ho na mo ho ntew.</para>
  <para style="q2" vid="ISA 1:16">Munnyi mo nnebɔne mfi mʼani so!</para>
  <para style="q2" vid="ISA 1:16">Munnyae bɔneyɛ,<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>Monyɛ papa! Monhwehwɛ atɛntrenee.</para>
  <para style="q2" vid="ISA 1:17">Monhyɛ wɔn a wɔhyɛ wɔn so nkuran</para>
  <para style="q1" vid="ISA 1:17">Munni mma ayisaa,</para>
  <para style="q2" vid="ISA 1:17">monka akunafo nsɛm mma wɔn.<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18"/>“Afei mommra na yennwen mmɔ mu,”</para>
  <para style="q2" vid="ISA 1:18">sɛnea <char style="nd">Awurade</char> se ni.</para>
  <para style="q1" vid="ISA 1:18">“Sɛ mo bɔne te sɛ ɔkɔben a,</para>
  <para style="q2" vid="ISA 1:18">ɛbɛyɛ fitaa sɛ sukyerɛmma;</para>
  <para style="q1" vid="ISA 1:18">mpo sɛ ɛyɛ kɔkɔɔ te sɛ mogya a</para>
  <para style="q2" vid="ISA 1:18">ɛbɛyɛ fitaa sɛ asaawa mfuturu.<verse eid="ISA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19"/>Sɛ mopene so na moyɛ osetie a,</para>
  <para style="q2" vid="ISA 1:19">mubedi asase no so nnepa.<verse eid="ISA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20"/>Na sɛ moampene na motew atua a,</para>
  <para style="q2" vid="ISA 1:20">afoa bedi mo nam.”</para>
  <para style="q2" vid="ISA 1:20">
    <char style="nd">Awurade</char> na wakasa.<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21"/>Hwɛ sɛnea kuropɔn nokwafo no</para>
  <para style="q2" vid="ISA 1:21">adan oguamanfo.</para>
  <para style="q1" vid="ISA 1:21">Bere bi, na atɛntrenee ahyɛ no ma</para>
  <para style="q2" vid="ISA 1:21">na anka trenee te ne mu,</para>
  <para style="q2" vid="ISA 1:21">nanso mprempren, awudifo ahyɛ mu ma!<verse eid="ISA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22"/>Wo dwetɛ adan ade a so nni mfaso,</para>
  <para style="q2" vid="ISA 1:22">wɔde nsu afra wo nsa papa mu.<verse eid="ISA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23"/>Wo sodifo yɛ atuatewfo,</para>
  <para style="q2" vid="ISA 1:23">akorɔmfo yɔnkonom;</para>
  <para style="q1" vid="ISA 1:23">wɔn nyinaa pɛ adanmude,</para>
  <para style="q2" vid="ISA 1:23">na wɔpere akyɛde ho.</para>
  <para style="q1" vid="ISA 1:23">Wonni mma ayisaa;</para>
  <para style="q2" vid="ISA 1:23">na akunafo nsɛm nkɔ wɔn anim.<verse eid="ISA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24"/>Enti, <char style="nd">Awurade</char>, Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 1:24">nea ɔyɛ Ɔkɛse ma Israel no ka se,</para>
  <para style="q1" vid="ISA 1:24">“Aa, menya ahomegye afi mʼatamfo hɔ</para>
  <para style="q2" vid="ISA 1:24">na matɔ wɔn so were.<verse eid="ISA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25"/>Mɛma me nsa so, atia mo;</para>
  <para style="q2" vid="ISA 1:25">mɛhohoro mo ho fi korakora</para>
  <para style="q2" vid="ISA 1:25">na mayi mo ho nkekae nyinaa.<verse eid="ISA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26"/>Mɛma mo atemmufo bio sɛ kan no,</para>
  <para style="q2" vid="ISA 1:26">ne mo afotufo sɛnea na ɛte, mfiase no.</para>
  <para style="q1" vid="ISA 1:26">Eyi akyi no, wɔbɛfrɛ wo</para>
  <para style="q2" vid="ISA 1:26">Kuropɔn Trenee,</para>
  <para style="q2" vid="ISA 1:26">Kuropɔn Nokwafo.”<verse eid="ISA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27"/>Wɔde atɛntrenee begye Sion bio,</para>
  <para style="q2" vid="ISA 1:27">na wɔn a wonu wɔn ho no, wɔde trenee begye wɔn.<verse eid="ISA 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28"/>Nanso atuatewfo ne nnebɔneyɛfo de, wɔbɛdwerɛw wɔn abɔ mu,</para>
  <para style="q2" vid="ISA 1:28">na wɔn a wɔpa <char style="nd">Awurade</char> akyi bɛyera.<verse eid="ISA 1:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29"/>“Mo ani bewu, esiane odum anyame a</para>
  <para style="q2" vid="ISA 1:29">munyaa wɔn mu anigye no;</para>
  <para style="q1" vid="ISA 1:29">wobegu mo anim ase, esiane nturo</para>
  <para style="q2" vid="ISA 1:29">a mosom abosom wɔ mu no nti.<verse eid="ISA 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30"/>Mobɛyɛ sɛ odum a ne nhaban apo,</para>
  <para style="q2" vid="ISA 1:30">ne turo a ennya nsu.<verse eid="ISA 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31"/>Ɔhoɔdenfo bɛyɛ sɛ ade a ɛhyew ntɛm</para>
  <para style="q2" vid="ISA 1:31">nʼadwuma bɛyɛ sɛ ogya a aturuw;</para>
  <para style="q1" vid="ISA 1:31">abien no bɛhyew abɔ mu,</para>
  <para style="q2" vid="ISA 1:31">a obiara rentumi nnum.”<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s1">
    <char style="nd">Awurade</char> Bepɔw No</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>Eyi ne nea Amos babarima Yesaia hui, a ɛfa Yuda ne Yerusalem ho.<verse eid="ISA 2:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>Nna a edi akyi no mu no,</para>
  <para style="q1" vid="ISA 2:2">
    <char style="nd">Awurade</char> asɔredan bepɔw no betim</para>
  <para style="q2" vid="ISA 2:2">sɛ mmepɔw no nyinaa ti;</para>
  <para style="q1" vid="ISA 2:2">ebegye din aboro nkoko nyinaa so</para>
  <para style="q2" vid="ISA 2:2">na aman nyinaa bɛbɔ yuu akɔ hɔ.<verse eid="ISA 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3"/>Aman bebree bɛba abɛka se,</para>
  <para style="q1" vid="ISA 2:3">“Mommra mma yɛnkɔ <char style="nd">Awurade</char> bepɔw no so,</para>
  <para style="q2" vid="ISA 2:3">nkɔ Yakob Nyankopɔn fi.</para>
  <para style="q1" vid="ISA 2:3">Ɔbɛkyerɛkyerɛ yɛn nʼakwan</para>
  <para style="q2" vid="ISA 2:3">sɛnea ɛbɛyɛ a yɛbɛnantew nʼatempɔn so.”</para>
  <para style="q1" vid="ISA 2:3">Mmara no befi Sion aba,</para>
  <para style="q2" vid="ISA 2:3">na <char style="nd">Awurade</char> asɛm afi Yerusalem.<verse eid="ISA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4"/>Obebu amanaman ntam atɛn</para>
  <para style="q2" vid="ISA 2:4">na obesiesie nnipa bebree ntam asɛm.</para>
  <para style="q1" vid="ISA 2:4">Wɔde wɔn afoa bɛbobɔ nsɔw</para>
  <para style="q2" vid="ISA 2:4">na wɔde wɔn mpeaw ayɛ asosɔw.</para>
  <para style="q1" vid="ISA 2:4">Ɔman bi rentwe ɔman foforo so afoa,</para>
  <para style="q2" vid="ISA 2:4">na wɔrenyɛ ahoboa biara mma ɔko bio.<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5"/>Mommra. Yakob fifo,</para>
  <para style="q2" vid="ISA 2:5">momma yɛnnantew <char style="nd">Awurade</char> hann mu.<verse eid="ISA 2:5"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Da No</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6"/>
    <char style="nd">Awurade</char>, woagyaw wo nkurɔfo,</para>
  <para style="q2" vid="ISA 2:6">Yakob fifo.</para>
  <para style="q1" vid="ISA 2:6">Gyidihunu a efi apuei fam ahyɛ wɔn ma;</para>
  <para style="q2" vid="ISA 2:6">wɔhyɛ nkɔm sɛ Filistifo</para>
  <para style="q2" vid="ISA 2:6">na wɔne abosonsomfo fa ayɔnko.<verse eid="ISA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7"/>Dwetɛ ne sikakɔkɔɔ ahyɛ wɔn asase no so ma;</para>
  <para style="q2" vid="ISA 2:7">wɔn ademude dɔɔso bebree.</para>
  <para style="q1" vid="ISA 2:7">Apɔnkɔ ayɛ wɔn asase no so ma;</para>
  <para style="q2" vid="ISA 2:7">na wɔn nteaseɛnam dodow nni ano.<verse eid="ISA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8"/>Ahoni ahyɛ wɔn asase no so ma;</para>
  <para style="q2" vid="ISA 2:8">wɔkotow sɔre wɔn ankasa nsa ano adwuma,</para>
  <para style="q2" vid="ISA 2:8">nea wɔn nsateaa ayɛ.<verse eid="ISA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9"/>Enti, <char style="nd">Awurade</char> bɛbrɛ onipa ase</para>
  <para style="q2" vid="ISA 2:9">na wama adesamma abotow,</para>
  <para style="q1" vid="ISA 2:9">mfa wɔn ho nkyɛ wɔn.<verse eid="ISA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10"/>Kɔhyɛn abotan no mu,</para>
  <para style="q2" vid="ISA 2:10">fa wo ho kosie asase no mu esiane <char style="nd">Awurade</char> ho hu</para>
  <para style="q2" vid="ISA 2:10">ne nʼanuonyam kɛseyɛ nti!<verse eid="ISA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11"/>Wɔbɛbrɛ ɔhantanni ase,</para>
  <para style="q2" vid="ISA 2:11">na wɔde nnipa ahomaso ahwe fam;</para>
  <para style="q1" vid="ISA 2:11">
    <char style="nd">Awurade</char> nko ara na wɔbɛma no so da no.<verse eid="ISA 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12"/>Asafo <char style="nd">Awurade</char> ahyɛ da bi</para>
  <para style="q2" vid="ISA 2:12">ama ahomasofo nyinaa</para>
  <para style="q1" vid="ISA 2:12">ne nea ɛma ne ho so nyinaa</para>
  <para style="q2" vid="ISA 2:12">(wɔbɛbrɛ wɔn ase),<verse eid="ISA 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13"/>Lebanon<note caller="+" style="f"><char style="fr" closed="false">2.13 </char><char style="ft" closed="false">Lebanon yɛ ɔmantam bi a na ɛda Yordan apuei fam a, ɛnam sida ne anantwi a na ɛwɔ hɔ no nti, agye din.</char></note> sida nyinaa, atenten ne nea ɛkorɔn,</para>
  <para style="q2" vid="ISA 2:13">ne Basan odum nnua no,<verse eid="ISA 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14"/>mmepɔw atenten nyinaa</para>
  <para style="q2" vid="ISA 2:14">ne nkoko a ɛwowaree nyinaa,<verse eid="ISA 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15"/>ne abantenten a ɛkorɔn</para>
  <para style="q2" vid="ISA 2:15">ne ɔfasu biara a ɛyɛ den,<verse eid="ISA 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16"/>aguadi hyɛn biara</para>
  <para style="q2" vid="ISA 2:16">ne hyɛn kɛse fɛfɛ biara.<verse eid="ISA 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17"/>Wɔbɛbrɛ ɔhantanni ase,</para>
  <para style="q2" vid="ISA 2:17">na wɔde nnipa ahomaso ahwe fam;</para>
  <para style="q1" vid="ISA 2:17">
    <char style="nd">Awurade</char> nko ara na wɔbɛma no so da no,<verse eid="ISA 2:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18"/>na ahoni no bɛyera korakora.<verse eid="ISA 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19"/>Nnipa beguan akɔhyɛ abodan a ɛwɔ abotan mu</para>
  <para style="q2" vid="ISA 2:19">ne ntokuru a ɛdeda asase mu</para>
  <para style="q1" vid="ISA 2:19">esiane <char style="nd">Awurade</char> ho hu</para>
  <para style="q2" vid="ISA 2:19">ne nʼanuonyam kɛseyɛ nti,</para>
  <para style="q2" vid="ISA 2:19">bere a ɔbɛsɔre awosow asase.<verse eid="ISA 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20"/>Saa da no, nnipa bɛtow</para>
  <para style="q2" vid="ISA 2:20">wɔn dwetɛ ne sikakɔkɔɔ ahoni</para>
  <para style="q1" vid="ISA 2:20">a wɔyɛɛ sɛ wɔbɛsom no</para>
  <para style="q2" vid="ISA 2:20">agu ama akisi ne mpan.<verse eid="ISA 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21"/>Wobeguan akɔhyɛ abotan mu ntokuru mu</para>
  <para style="q2" vid="ISA 2:21">ne abotan mpaapae mu</para>
  <para style="q1" vid="ISA 2:21">esiane <char style="nd">Awurade</char> ho hu</para>
  <para style="q2" vid="ISA 2:21">ne nʼanuonyam kɛseyɛ nti,</para>
  <para style="q2" vid="ISA 2:21">bere a ɔbɛsɔre awosow asase.<verse eid="ISA 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22"/>Munnyae sɛ mode mo ho to nnipa,</para>
  <para style="q2" vid="ISA 2:22">a wɔwɔ ɔhome kɛkɛ so.</para>
  <para style="q2" vid="ISA 2:22">Wɔyɛ dɛn koraa?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">Yerusalem Ne Yuda Atemmu</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1"/>Afei hwɛ, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 3:1">Asafo <char style="nd">Awurade</char>,</para>
  <para style="q1" vid="ISA 3:1">rebegyae nea ɔde ma</para>
  <para style="q2" vid="ISA 3:1">wɔ Yerusalem ne Yuda nyinaa:</para>
  <para style="q2" vid="ISA 3:1">aduan ne nsu a ɔde ma wɔn nyinaa.<verse eid="ISA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 3:2"/>Dɔmmarima ne akofo,</para>
  <para style="q2" vid="ISA 3:2">otemmufo ne odiyifo,</para>
  <para style="q2" vid="ISA 3:2">nkɔmhyɛni ne ɔpanyin,<verse eid="ISA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3"/>aduonum so panyin ne nea ɔwɔ dibea,</para>
  <para style="q2" vid="ISA 3:3">ɔfotufo, odwumfo nyansafo ne nkaberekyerefo onifirifo.<verse eid="ISA 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4"/>“Mede mmerantewa bɛyɛ wɔn nnwuma so mpanyimfo;</para>
  <para style="q2" vid="ISA 3:4">na mmofra adi wɔn so.”<verse eid="ISA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5"/>Nnipa bɛhyɛ wɔn ho wɔn ho so,</para>
  <para style="q2" vid="ISA 3:5">ɔbarima betia ɔbarima, ɔyɔnko betia ne yɔnko.</para>
  <para style="q1" vid="ISA 3:5">Mmabun bɛsɔre atia wɔn mpanyimfo,</para>
  <para style="q2" vid="ISA 3:5">apapahwekwa betia onuonyamfo.<verse eid="ISA 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6"/>Ɔbarima beso ne nuanom mu baako mu</para>
  <para style="q2" vid="ISA 3:6">wɔ nʼagya fi aka se,</para>
  <para style="q1" vid="ISA 3:6">“Wowɔ atade, bɛyɛ yɛn dikanfo;</para>
  <para style="q2" vid="ISA 3:6">wɔ kurow a adan mmubui siw yi so.”<verse eid="ISA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7"/>Nanso da no ɔbɛteɛ mu se,</para>
  <para style="q2" vid="ISA 3:7">“Minni nea mede bɛyɛ.</para>
  <para style="q1" vid="ISA 3:7">Minni aduan anaa ntama wɔ me fi;</para>
  <para style="q2" vid="ISA 3:7">mfa me nyɛ nnipa no so kannifo.”<verse eid="ISA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8"/>Yerusalem retɔ ntintan,</para>
  <para style="q2" vid="ISA 3:8">Yuda rehwe ase;</para>
  <para style="q1" vid="ISA 3:8">wɔn nsɛm ne nneyɛe tia <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="ISA 3:8">Wommu nʼanuonyam a ɛwɔ wɔn mu no.<verse eid="ISA 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9"/>Sɛnea wɔn anim te no di adanse tia wɔn;</para>
  <para style="q2" vid="ISA 3:9">wɔda wɔn bɔne adi te sɛ Sodom;</para>
  <para style="q2" vid="ISA 3:9">wɔmmfa nsie.</para>
  <para style="q1" vid="ISA 3:9">Nnome nka wɔn!</para>
  <para style="q2" vid="ISA 3:9">Wɔakɔfa amanehunu aba wɔn ho so.<verse eid="ISA 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10"/>Ka kyerɛ atreneefo se ebesi wɔn yiye,</para>
  <para style="q2" vid="ISA 3:10">efisɛ wobedi wɔn nneyɛe so aba.<verse eid="ISA 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11"/>Nnome nka amumɔyɛfo!</para>
  <para style="q2" vid="ISA 3:11">Amanehunu wɔ wɔn so!</para>
  <para style="q1" vid="ISA 3:11">Wobetua wɔn nea</para>
  <para style="q2" vid="ISA 3:11">wɔn nsa ayɛ no so ka.<verse eid="ISA 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12"/>Mmabun hyɛ me nkurɔfo so,</para>
  <para style="q2" vid="ISA 3:12">mmea di wɔn so.</para>
  <para style="q1" vid="ISA 3:12">Me nkurɔfo, mo akwankyerɛfo ma moyera;</para>
  <para style="q2" vid="ISA 3:12">wɔma moman fi ɔtempɔn no so.<verse eid="ISA 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13"/>
    <char style="nd">Awurade</char> tena ase wɔ nʼasennii.</para>
  <para style="q2" vid="ISA 3:13">Ɔma ne mu so bu nkurɔfo no atɛn.<verse eid="ISA 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14"/>
    <char style="nd">Awurade</char> bu atɛn</para>
  <para style="q2" vid="ISA 3:14">de tia ne nkurɔfo mpanyimfo ne akannifo se,</para>
  <para style="q1" vid="ISA 3:14">“Mo na moasɛe me bobeturo;</para>
  <para style="q2" vid="ISA 3:14">apoobɔde a efi ahiafo nkyɛn wɔ mo afi mu.<verse eid="ISA 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15"/>Ase ne dɛn nti na modwerɛw me nkurɔfo</para>
  <para style="q2" vid="ISA 3:15">na mode ahiafo anim twitwiw fam?”</para>
  <para style="q2" vid="ISA 3:15">Sɛnea Asafo <char style="nd">Awurade</char> se ni.<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16"/>
    <char style="nd">Awurade</char> kasa se,</para>
  <para style="q2" vid="ISA 3:16">“Sion mmabea yɛ ahantan;</para>
  <para style="q1" vid="ISA 3:16">wɔnantew toto wɔn kɔn,</para>
  <para style="q2" vid="ISA 3:16">wɔdeda wɔn ani akyi,</para>
  <para style="q1" vid="ISA 3:16">wotutu wɔn anammɔn ntiantia,</para>
  <para style="q2" vid="ISA 3:16">na wɔn anan ase nkaa gyigye.<verse eid="ISA 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17"/>Enti Awurade bɛma tikuru abegu Sion mmea ti ho.</para>
  <para style="q2" vid="ISA 3:17">
    <char style="nd">Awurade</char> bɛma wɔn ti so apa.”<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>Da no <char style="nd">Awurade</char> beyiyi wɔn afɛfɛde: nkaa, ntamabamma ne kɔnmuade, <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>asokaa, nkapo ne nkataanim, <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>Wɔn mmotiri, anan ase ntweaban, nkyekyeremu, nnuhuam ntoa ne nkabere, <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>nsɔwano mpɛtea ne hwenem nkaa, <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>ntade atenten pa, nguguso tiaa a enni nsa, ntade yuu ne sika nkotoku; <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>nhwehwɛ, sirikyi ntade, tinwi so nkaa ne mmati so nguguso.<verse eid="ISA 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24"/>Nkabɔne besi nea ɛyɛ huam anan mu;</para>
  <para style="q2" vid="ISA 3:24">ntampehama besi nkatakɔnmu anan mu;</para>
  <para style="q1" vid="ISA 3:24">ti a ɛso apa besi tinwi a wɔasiesie anan mu;</para>
  <para style="q2" vid="ISA 3:24">atweaatam besi ntama pa anan mu;</para>
  <para style="q2" vid="ISA 3:24">honam ani atwaatwa besi ahoɔfɛ anan mu.<verse eid="ISA 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25"/>Wo mmarima bɛtotɔ afoa ano,</para>
  <para style="q2" vid="ISA 3:25">wʼakofo wɔ ɔko mu.<verse eid="ISA 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26"/>Sion apon betwa adwo, adi awerɛhow;</para>
  <para style="q2" vid="ISA 3:26">onnibi, ɔbɛtena fam.<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1"/>Saa da no, mmea baason</para>
  <para style="q2" vid="ISA 4:1">beso ɔbarima baako mu aka se,</para>
  <para style="q1" vid="ISA 4:1">“Yɛbɛbɔ yɛn ho akɔnhama</para>
  <para style="q2" vid="ISA 4:1">na yɛn ankasa apɛ yɛn adurade;</para>
  <para style="q1" vid="ISA 4:1">ma wo din nna yɛn so kɛkɛ.</para>
  <para style="q2" vid="ISA 4:1">Yi ahohora fi yɛn so!”<verse eid="ISA 4:1"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Baa No</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>Saa da no <char style="nd">Awurade</char> Baa no bɛyɛ fɛ na anya anuonyam, na asase no so aba bɛyɛ ahohoahoa ne anuonyam ama Israel nkae no. <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>Wɔn a wɔaka wɔ Sion, a wɔte Yerusalem no, wɔbɛfrɛ wɔn kronkron, wɔn a wɔakyerɛw wɔn din aka ateasefo ho wɔ Yerusalem nyinaa. <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>Awurade bɛhohoro Sion mmea ho fi; ɔde atemmu honhom ne ogya honhom bɛpepa mogya nkekae a ɛwɔ Yerusalem. <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>Afei, Bepɔw Sion ne wɔn a wɔboa wɔn ano wɔ hɔ nyinaa, <char style="nd">Awurade</char> de wusiw mununkum bɛkata wɔn so awia, na ɔde ogya a ɛdɛw akata wɔn so anadwo; ntama kyinii bɛkata anuonyam yi nyinaa so. <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>Ɛbɛyɛ hintabea ne onwini wɔ awia anoden mu, na osu ne ahum mu nso, ɛbɛyɛ guankɔbea ne hintabea.<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">Bobe Turo Ho Dwom</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>Mɛto dwom ama me dɔfo</para>
  <para style="q2" vid="ISA 5:1">dwom a ɛfa ne bobeturo ho:</para>
  <para style="q1" vid="ISA 5:1">Na me dɔfo wɔ bobe turo bi</para>
  <para style="q2" vid="ISA 5:1">wɔ asasebere bi a ɛda bepɔw ani.<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>Ofuntum asase no, yiyii mu abo,</para>
  <para style="q2" vid="ISA 5:2">na oduaa bobe a ɛyɛ papa wɔ so.</para>
  <para style="q1" vid="ISA 5:2">Osii ɔwɛn aban wɔ mfimfini</para>
  <para style="q2" vid="ISA 5:2">na otuu nsakyiamoa nso.</para>
  <para style="q1" vid="ISA 5:2">Afei ɔhwɛɛ anim sɛ obetwa bobe aba pa,</para>
  <para style="q2" vid="ISA 5:2">nanso ɛsow aba bɔne.<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>“Afei mo a motete Yerusalem ne Yuda mmarima,</para>
  <para style="q2" vid="ISA 5:3">mummu me ne me bobeturo ntam atɛn.<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>Dɛn bio na anka ɛsɛ sɛ meyɛ ma me bobeturo</para>
  <para style="q2" vid="ISA 5:4">boro nea mayɛ yi so?</para>
  <para style="q1" vid="ISA 5:4">Bere a merehwɛ anim sɛ minya bobe a eye no</para>
  <para style="q2" vid="ISA 5:4">adɛn nti na ɛsow aba bɔne?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>Afei mɛka</para>
  <para style="q2" vid="ISA 5:5">nea merebɛyɛ me bobeturo no akyerɛ wo:</para>
  <para style="q1" vid="ISA 5:5">Meyi ho ban no afi hɔ,</para>
  <para style="q2" vid="ISA 5:5">na wɔbɛsɛe no;</para>
  <para style="q1" vid="ISA 5:5">mebubu ho ɔfasu,</para>
  <para style="q2" vid="ISA 5:5">na wobetiatia so.<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>Mɛma ayɛ asase a ɛda mpan</para>
  <para style="q2" vid="ISA 5:6">a worenyiyi mu na wɔnyɛ so adwuma,</para>
  <para style="q2" vid="ISA 5:6">ohwirem ne nsɔe benyin wɔ so.</para>
  <para style="q1" vid="ISA 5:6">Mɛhyɛ omununkum</para>
  <para style="q2" vid="ISA 5:6">na wantɔ osu angu so.”<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>Asafo <char style="nd">Awurade</char> bobeturo no</para>
  <para style="q2" vid="ISA 5:7">yɛ Israelfi,</para>
  <para style="q1" vid="ISA 5:7">na Yuda mmarima yɛ turo a nʼani gye ho.</para>
  <para style="q1" vid="ISA 5:7">Ɔpɛɛ atɛntrenee nanso ohuu mogyahwiegu;</para>
  <para style="q2" vid="ISA 5:7">ɔpɛɛ trenee nanso ɔtee mmɔborɔsu.<verse eid="ISA 5:7"/></para>
  <para style="s1">Nnome Ne Atemmu</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>Nnome nka mo a mode ofi ka ofi ho</para>
  <para style="q2" vid="ISA 5:8">na mugyigye mfuw bobɔ so</para>
  <para style="q1" vid="ISA 5:8">kosi sɛ asase no bɛsa</para>
  <para style="q2" vid="ISA 5:8">na ɛka mo nko ara wɔ asase no so.<verse eid="ISA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9"/>Asafo <char style="nd">Awurade</char> apae mu aka ama mate:</para>
  <para style="q1" vid="ISA 5:9">“Nokwarem, afi akɛse no bɛda mpan,</para>
  <para style="q2" vid="ISA 5:9">na aban afɛɛfɛ no, obiara rentena mu.<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>Bobeturo kɛse pa ara no</para>
  <para style="q2" vid="ISA 5:10">nsa kakraa bi na ebefi mu.</para>
  <para style="q1" vid="ISA 5:10">Aba lita aduonu baako a wodua no</para>
  <para style="q2" vid="ISA 5:10">wobenya so lita aduonu abien pɛ.”<verse eid="ISA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>Wonnue, wɔn a wɔsɔre anɔpahema</para>
  <para style="q2" vid="ISA 5:11">kɔhwehwɛ wɔn nsa akyi kwan</para>
  <para style="q1" vid="ISA 5:11">wɔn a wosii pɛ anadwo</para>
  <para style="q2" vid="ISA 5:11">kosi sɛ nsa bɛbow wɔn.<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>Wɔbɔ sankuten ne bɛnta wɔ wɔn aponto ase,</para>
  <para style="q2" vid="ISA 5:12">akasae, ne atɛntɛbɛn ne nsa,</para>
  <para style="q1" vid="ISA 5:12">nanso wotwiri nea <char style="nd">Awurade</char> ayɛ,</para>
  <para style="q2" vid="ISA 5:12">na wommu ne nsa ano adwuma.<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>Ɛno nti, me nkurɔfo bɛkɔ nnommum mu,</para>
  <para style="q2" vid="ISA 5:13">efisɛ wonni ntease;</para>
  <para style="q1" vid="ISA 5:13">ɔkɔm bekum wɔn mu atitiriw</para>
  <para style="q2" vid="ISA 5:13">na osukɔm betware wɔn mu bebree.<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>Enti Owu bae nʼabogye mu</para>
  <para style="q2" vid="ISA 5:14">na obue nʼanom bayaa;</para>
  <para style="q1" vid="ISA 5:14">na mu na atitiriw ne dɔm no bɛkɔ</para>
  <para style="q2" vid="ISA 5:14">wɔne wɔn a wɔsaw na wogye wɔn ani no.<verse eid="ISA 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15"/>Enti wɔbɛbrɛ onipa ase</para>
  <para style="q2" vid="ISA 5:15">na wama adesamma abotow.</para>
  <para style="q2" vid="ISA 5:15">Wɔbɛbrɛ ɔhantanni ase,<verse eid="ISA 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16"/>nanso Asafo <char style="nd">Awurade</char> atɛntrenee bɛma no so,</para>
  <para style="q2" vid="ISA 5:16">na Ɔkronkron Nyankopɔn de ne trenee bɛda ne ho adi sɛ Ɔkronkronni.<verse eid="ISA 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17"/>Afei nguan bɛkɔ adidi te sɛnea wɔwɔ wɔn adidibea;</para>
  <para style="q2" vid="ISA 5:17">nguantenmma bedidi wɔ asikafo amamfo so.<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18"/>Munnue, mo a mode nnaadaa nhoma twetwe bɔne,</para>
  <para style="q2" vid="ISA 5:18">na mode nteaseɛnam ntampehama twetwe amumɔyɛ.<verse eid="ISA 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19"/>Munnue, mo a moka se, “Onyankopɔn nyɛ ntɛm,</para>
  <para style="q2" vid="ISA 5:19">ɔnyɛ nʼadwuma ntɛm</para>
  <para style="q1" vid="ISA 5:19">sɛnea yebehu.</para>
  <para style="q2" vid="ISA 5:19">Ma ɛmmɛn,</para>
  <para style="q1" vid="ISA 5:19">Israel Ɔkronkronni no nhyehyɛe no mmra,</para>
  <para style="q2" vid="ISA 5:19">sɛnea yebehu.”<verse eid="ISA 5:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20"/>Munnue, mo a mofrɛ bɔne sɛ papa</para>
  <para style="q2" vid="ISA 5:20">na papa nso sɛ bɔne,</para>
  <para style="q1" vid="ISA 5:20">mo a mode sum si hann anan mu</para>
  <para style="q2" vid="ISA 5:20">na hann si sum anan mu,</para>
  <para style="q1" vid="ISA 5:20">mo a mofrɛ nweenwen se dɛɛdɛ</para>
  <para style="q2" vid="ISA 5:20">ne dɛɛdɛ se nweenwen.<verse eid="ISA 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21"/>Munnue, mo a mubu mo ho anyansafo, mo ankasa ani so</para>
  <para style="q2" vid="ISA 5:21">ne anitewfo mo ankasa ani so.<verse eid="ISA 5:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22"/>Munnue mo a wɔfrɛ mo akatakyi wɔ nsanom mu</para>
  <para style="q2" vid="ISA 5:22">ne ahoɔdenfo wɔ nsa afrafra mu.<verse eid="ISA 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23"/>Mo a mugye adanmude, na mugyaa nea odi fɔ</para>
  <para style="q2" vid="ISA 5:23">na mubu nea odi bem no fɔ.<verse eid="ISA 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24"/>Enti sɛnea ogyaframa hyew nwuraguanee</para>
  <para style="q2" vid="ISA 5:24">na sare a awo yera wɔ ogyaframa mu no,</para>
  <para style="q1" vid="ISA 5:24">saa ara na mo ntin bɛporɔw,</para>
  <para style="q2" vid="ISA 5:24">na mo nhwiren nso atu akɔ sɛ mfutuma;</para>
  <para style="q1" vid="ISA 5:24">efisɛ moapo Asafo <char style="nd">Awurade</char> mmara</para>
  <para style="q2" vid="ISA 5:24">na moatwiri Israel Kronkronni no asɛm.<verse eid="ISA 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25"/>Enti <char style="nd">Awurade</char> abufuw aba ne nkurɔfo so,</para>
  <para style="q2" vid="ISA 5:25">wama ne nsa so, na ɔde rebɔ wɔn ahwe fam.</para>
  <para style="q1" vid="ISA 5:25">Mmepɔw no wosow,</para>
  <para style="q2" vid="ISA 5:25">na afunu ayɛ sɛ mmɔnten so nwura.</para>
  <para style="b" vid="ISA 5:25"/>
  <para style="q1" vid="ISA 5:25">Nanso eyi nyinaa akyi, ne bo nnwoo ɛ,</para>
  <para style="q2" vid="ISA 5:25">na ne nsa da so wɔ soro.<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26"/>Ɔma frankaa so ma akyirikyiri aman,</para>
  <para style="q2" vid="ISA 5:26">ɔhyɛn abɛn de frɛ wɔn a wɔwɔ asase ano.</para>
  <para style="q1" vid="ISA 5:26">Wɔn na wɔreba no,</para>
  <para style="q2" vid="ISA 5:26">afrɛ so ne ntɛm so!<verse eid="ISA 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27"/>Wɔn mu biara mmmrɛ na onhintiw,</para>
  <para style="q2" vid="ISA 5:27">obiara ntɔ nko na ɔnna;</para>
  <para style="q1" vid="ISA 5:27">abɔso biara mu nnwow wɔ asen mu</para>
  <para style="q2" vid="ISA 5:27">na mpaboa hama biara nso rentew.<verse eid="ISA 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28"/>Wɔn agyan ano yɛ nnam,</para>
  <para style="q2" vid="ISA 5:28">na wɔn tadua nyinaa ayɛ krado;</para>
  <para style="q1" vid="ISA 5:28">wɔn apɔnkɔ tɔte te sɛ ɔtwɛrebo,</para>
  <para style="q2" vid="ISA 5:28">wɔn nteaseɛnam nkyimii te sɛ mfɛtɛ.<verse eid="ISA 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29"/>Wɔn mmobɔmu te sɛ gyata de,</para>
  <para style="q2" vid="ISA 5:29">na wɔbobɔ mu sɛ gyatamma;</para>
  <para style="q1" vid="ISA 5:29">wɔbobɔ mu kyere wɔn hanam</para>
  <para style="q2" vid="ISA 5:29">na wɔde no kɔ a ogyefo biara nni hɔ.<verse eid="ISA 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30"/>Da no wɔbɛbobɔ mu agu no so</para>
  <para style="q2" vid="ISA 5:30">sɛnea po woro so no.</para>
  <para style="q1" vid="ISA 5:30">Na sɛ obi hwɛ asase no a,</para>
  <para style="q2" vid="ISA 5:30">obehu sum kabii ne ahohiahia;</para>
  <para style="q2" vid="ISA 5:30">omununkum bɛma hann aduru sum.<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s1">Yesaia Soma</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>Afe a ɔhene Usia wui mu no, mihuu <char style="nd">Awurade</char> sɛ ɔte ahengua a ɛkorɔn na wapagyaw so na nʼatade mmuano ayɛ hyiadan mu hɔ ma. <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>Na Serafim a wɔn mu biara wɔ ntaban asia wɔ nʼatifi. Wɔde ntaban no abien kata wɔn anim, na wɔde abien nso kata wɔn nan ho na wɔde abien nso tu. <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>Na obiara teɛ mu kyerɛ ne yɔnko se,</para>
  <para style="q1" vid="ISA 6:3">“Kronkron! Kronkron! Kronkron ne Asafo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="ISA 6:3">Nʼanuonyam ahyɛ asase nyinaa so ma!”<verse eid="ISA 6:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4"/>Wɔn nne nnyigyei maa apon ne abobow ano wosowee, na wusiw yɛɛ hyiadan mu hɔ ma.<verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>Meteɛɛ mu kae se, “Minnue! Memfata! Meyɛ onipa a mʼano ho ntew, na mete nnipa a wɔn ano ho ntew mu, na mʼani ahu Ɔhene, <char style="nd">Awurade</char> Asafo no yi.”<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>Na Serafim no mu baako a okura nnyansramma, a ɔde ɔdaban kɔfa fii afɔremuka no so tu baa me nkyɛn. <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>Ɔde eyi kaa mʼano kae se, “Hwɛ, eyi aka wʼanofafa, wɔayi wʼafɔdi na wɔatua wo bɔne so ka.”<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>Afei, metee <char style="nd">Awurade</char> nne a ɛrebisa se, “Hena na mensoma no? Na hena na ɔbɛkɔ ama yɛn?”</para>
  <para style="p" vid="ISA 6:8">Na mekae se, “Mini. Soma me!”<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>Na ɔkae se, “Kɔ na kɔka kyerɛ saa nkurɔfo yi se,</para>
  <para style="q1" vid="ISA 6:9">“ ‘Ɔte de mobɛte, nanso morente ase;</para>
  <para style="q2" vid="ISA 6:9">Ɔhwɛ de mobɛhwɛ, nanso morenhu.’<verse eid="ISA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10"/>Efisɛ mo, moapirim mo koma;</para>
  <para style="q2" vid="ISA 6:10">moasisiw mo aso,</para>
  <para style="q2" vid="ISA 6:10">akatakata mo ani.</para>
  <para style="q1" vid="ISA 6:10">Ɛnyɛ saa a, anka mo ani behu ade,</para>
  <para style="q2" vid="ISA 6:10">na mo koma ate asɛm ase,</para>
  <para style="q1" vid="ISA 6:10">na moanu mo ho asan aba me nkyɛn, na masa mo yare.”<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>Na mekae se, “Enkosi da bɛn, Awurade?”</para>
  <para style="p" vid="ISA 6:11">Na obuae se,</para>
  <para style="q1" vid="ISA 6:11">“Enkosi sɛ nkuropɔn no bɛyɛ amamfo</para>
  <para style="q2" vid="ISA 6:11">a nnipa ntete so,</para>
  <para style="q1" vid="ISA 6:11">enkosi sɛ afi no bɛyɛ afituw</para>
  <para style="q2" vid="ISA 6:11">na mfuw no asɛe ayɛ pasaa,<verse eid="ISA 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12"/>enkosi sɛ, <char style="nd">Awurade</char> bɛpam obiara akɔ akyirikyiri</para>
  <para style="q2" vid="ISA 6:12">na asase no ada mpan.<verse eid="ISA 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13"/>Mpo, sɛ nkyɛmu du mu baako ka asase no so a</para>
  <para style="q2" vid="ISA 6:13">wɔbɛsɛe no bio.</para>
  <para style="q1" vid="ISA 6:13">Nso sɛnea dupɔn anaa odum</para>
  <para style="q2" vid="ISA 6:13">gyaw dunsin, bere a wɔatwa ato fam no,</para>
  <para style="q2" vid="ISA 6:13">saa ara na aba kronkron no bɛyɛ dunsin wɔ asase no so.”<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">Immanuel Ho Nsɛnkyerɛnne</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>Bere a Usia babarima Yotam babarima Ahas<note caller="+" style="f"><char style="fr" closed="false">7.1 </char><char style="ft" closed="false">Ɛbɛyɛ afe 735 AWK mu no, Israel ne Siria ka bɔɔ mu tiaa Asiria, na wɔpɛɛ sɛ wɔhyɛ Ahas a na ɔyɛ Yuda hempɔn no na ɔne wɔn bɔ mu kɔko.</char></note> bedii Yudaman so hene no, Aramhene Resin ne Remalia babarima Peka a ɔyɛ Israelhene baa Yerusalem ne wɔn bɛkoe, nanso wɔantumi anni ne so.<verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>Na wɔka kyerɛɛ Dawidfi se, “Aram ne Efraim ayɛ apam;” Enti Ahas ne ne nkurɔfo ho wosow sɛnea kwaennua wosow wɔ mframa ano no.<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>Na <char style="nd">Awurade</char> ka kyerɛɛ Yesaia se, “Wo ne wo babarima Sear-Yasub nkohyia Ahas wɔ Atifi Tare no subon a ɛwɔ Ntamahorofo Afuw no kwan so. <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>Ka kyerɛ no se, ‘Hwɛ yiye, yɛ komm na nsuro. Mma wo koma ntu wɔ saa nnyentia abien a ɛrefi wusiw yi ho; wɔ Resin Aramhene ne Remalia babarima abufuwhyew no nti. <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>Aram, Efraim ne Remalia babarima abɔ wo sɛe ho pɔw se, <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>“Momma yɛntow nhyɛ Yuda so, na yɛntetew wɔn mu na yɛnkyɛ mfa, na yensi Tabeel babarima hene wɔ so.” <verse eid="ISA 7:6"/><verse number="7" style="v" sid="ISA 7:7"/>Nanso nea Asafo <char style="nd">Awurade</char> se ni:</para>
  <para style="q1" vid="ISA 7:7">“ ‘Ɛremma so,</para>
  <para style="q2" vid="ISA 7:7">na ɛrensi da,<verse eid="ISA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8"/>Aram ti ne Damasko,</para>
  <para style="q2" vid="ISA 7:8">na Resin pɛ na ɛyɛ Damasko ti.</para>
  <para style="q1" vid="ISA 7:8">Mfirihyia aduosia anum mu no</para>
  <para style="q2" vid="ISA 7:8">Efraim mu bɛtetew koraa a ɛrentumi nnyɛ ɔman.<verse eid="ISA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9"/>Efraim ti ne Samaria</para>
  <para style="q2" vid="ISA 7:9">Remalia babarima pɛ ne Samaria ti.</para>
  <para style="q1" vid="ISA 7:9">Sɛ woannyina pintinn wɔ wo gyidi mu a,</para>
  <para style="q2" vid="ISA 7:9">worennyina koraa.’ ”<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>
    <char style="nd">Awurade</char> kasa kyerɛɛ Ahas bio se, <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“Bisa <char style="nd">Awurade</char>, wo Nyankopɔn hɔ nsɛnkyerɛnne, sɛ ɛwɔ bun ase tɔnn anaa ɔsorosoro nohɔ.”<verse eid="ISA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12"/>Nanso Ahas buae se, “Meremmisa, merensɔ <char style="nd">Awurade</char> nhwɛ.”<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>Na Yesaia kae se, “Muntie Dawidfi! Ɛnso mma mo sɛ mobɛsɔ nnipa ntoboase ahwɛ? Na mobɛsɔ me Nyankopɔn nso ntoboase ahwɛ ana? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>Ɛno de, Onyankopɔn ankasa bɛma mo nsɛnkyerɛnne; ɔbabun no benyinsɛn, na wawo ɔbabarima, na wɔbɛfrɛ no Immanuel. <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>Obedi nufusu ani srade ne ɛwo, bere a wahu nea ɛbɛma watumi apo bɔne na wafa nea eye no. <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>Nanso ansa na abarimaa no behu nea ɛbɛma watumi apo bɔne na wafa nea eye no, wɔbɛma ahemfo abien a wusuro wɔn no nsase ada mpan. <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/><char style="nd">Awurade</char> de bere bi bɛba wo ne wo nkurɔfo ne wʼagya fi so a ɛso bi mmaa da, efi bere a Efraim tew ne ho fii Yuda ho; ɔde Asiriahene bɛba.”<verse eid="ISA 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>Da no, <char style="nd">Awurade</char> bɛhyɛn abɛn afrɛ nwansena afi nsuwansuwa a ɛwɔ akyirikyiri wɔ Misraim ne nnowa a wofi Asiria asase so. <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>Wɔn nyinaa bɛba abegu aku a mu dɔ ne ntokuru a ɛwɔ abotan mu, nkyɛkyerɛ ne suka mu. <verse eid="ISA 7:19"/><verse number="20" style="v" sid="ISA 7:20"/>Da no, <char style="nd">Awurade</char> de oyiwan a obegye wɔ Asubɔnten no agya nohɔ wɔ Asiriahene nkyɛn, no beyi mo ti so ne mo anan ho nwi na wayi mo abogyesɛ nso. <verse eid="ISA 7:20"/><verse number="21" style="v" sid="ISA 7:21"/>Saa da no, obiara bɛyɛn nantwi ba baako ne mmirekyi abien. <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>Na esiane nufusu dodow a wɔbɛma nti, obenya nufusu ani srade adi. Wɔn a wɔbɛka wɔ asase no so nyinaa bedi nufusu ani srade ne ɛwo. <verse eid="ISA 7:22"/><verse number="23" style="v" sid="ISA 7:23"/>Saa da no, baabiara a na anka bobe apem a ne bo yɛ dwetɛ kilogram dubaako ne fa wɔ no, wobehu nnɛnkyɛnse ne nsɔe. <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>Nnipa de agyan ne tadua bɛkɔ hɔ, efisɛ nnɛnkyɛnse ne nsɔe agye hɔ. <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>Nkoko a na anka kan no wɔde nsɔw yɛ so adwuma, nnɛnkyɛnse ne nsɔe ho hu nti wɔrenkɔ hɔ bio; ɛbɛdan mmeaemmeae a wogyaa anantwi ne nguan ma wɔkɔ.<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">Asiria, <char style="nd">Awurade</char> Nsa Mu Dade</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ me se, “Fa nhoma mmobɔwee kɛse no na fa kyerɛwdua biara kyerɛw so. <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>Na mɛfrɛ ɔsɔfo Uria ne Yeberekia babarima Sakaria sɛ me dansefo nokwafo aba.” <verse eid="ISA 8:2"/><verse number="3" style="v" sid="ISA 8:3"/>Afei mekɔɔ nkɔmhyɛnibea no ho, na onyinsɛnee, woo ɔbabarima. Na <char style="nd">Awurade</char> ka kyerɛɛ me se, “Frɛ no Maher-Salal-Has-Bas. <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>Ansa na abarimaa no betumi aka, ‘Mʼagya’ anaasɛ ‘me na’ no, Asiriahene bɛba abɛfa Damasko ahode ne Samaria asade nyinaa akɔ.”<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>
    <char style="nd">Awurade</char> kasa kyerɛɛ me bio se,<verse eid="ISA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6"/>“Esiane sɛ saa nkurɔfo yi apo</para>
  <para style="q2" vid="ISA 8:6">Siloa nsu a ɛsen brɛoo</para>
  <para style="q1" vid="ISA 8:6">na wodi ahurusi wɔ Resin</para>
  <para style="q2" vid="ISA 8:6">ne Remalia babarima no ho nti,<verse eid="ISA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7"/>
    <char style="nd">Awurade</char> reyɛ de Asubɔnten no</para>
  <para style="q2" vid="ISA 8:7">yiri kɛse no atia wɔn,</para>
  <para style="q1" vid="ISA 8:7">Asiriahene ne ne kɛseyɛ nyinaa.</para>
  <para style="q2" vid="ISA 8:7">Ebeyiri afa nʼabon nyinaa mu,</para>
  <para style="q2" vid="ISA 8:7">na abu afa ne konkɔn so<verse eid="ISA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8"/>na apra abɛfa Yuda, akɔntɔn afa ho,</para>
  <para style="q2" vid="ISA 8:8">ateɛ afa mu abɛdeda kɔn mu.</para>
  <para style="q1" vid="ISA 8:8">Na atrɛtrɛw akata asase no nyinaa so</para>
  <para style="q2" vid="ISA 8:8">Immanuel.”<verse eid="ISA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9"/>Momma ɔko nteɛmu so, mo aman na wɔnnwerɛw mo!</para>
  <para style="q2" vid="ISA 8:9">Muntie mo akyirikyiri aman.</para>
  <para style="q1" vid="ISA 8:9">Munsiesie mo ho mma ɔko, na wɔnnwerɛw mo!</para>
  <para style="q2" vid="ISA 8:9">Munsiesie mo ho mma ɔko, na wɔnnwerɛw mo!<verse eid="ISA 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10"/>Hwehwɛ ɔkwan a wobɛfa so, nanso wɔbɛsɛe no;</para>
  <para style="q2" vid="ISA 8:10">da wo nsusuwii adi, nanso ɛrennyina,</para>
  <para style="q2" vid="ISA 8:10">efisɛ Onyankopɔn ne yɛn wɔ hɔ.<verse eid="ISA 8:10"/></para>
  <para style="s1">Suro Onyankopɔn</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>
    <char style="nd">Awurade</char> de ne nsa dennen no too me so, ka kyerɛ me, bɔɔ me kɔkɔ se mennantew saa nkurɔfo yi kwan so. Ɔkae se,<verse eid="ISA 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12"/>“Mommfrɛ no tirisopam</para>
  <para style="q2" vid="ISA 8:12">biribiara a saa nkurɔfo yi frɛ no tirisopam no;</para>
  <para style="q1" vid="ISA 8:12">Munnsuro nea wosuro,</para>
  <para style="q2" vid="ISA 8:12">na momma ɛmmɔ mo hu.<verse eid="ISA 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13"/>Asafo <char style="nd">Awurade</char> nko ara na ɛsɛ sɛ wubu no ɔkronkron,</para>
  <para style="q2" vid="ISA 8:13">ɔno na ɛsɛ sɛ wusuro no,</para>
  <para style="q2" vid="ISA 8:13">ɔno na ne ho yɛ hu,<verse eid="ISA 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14"/>ɔbɛyɛ kronkronbea:</para>
  <para style="q2" vid="ISA 8:14">nanso Israel ne Yuda de,</para>
  <para style="q1" vid="ISA 8:14">ɔbɛyɛ hintibo</para>
  <para style="q2" vid="ISA 8:14">ne ɔbotan a ɛma wɔhwe ase.</para>
  <para style="q1" vid="ISA 8:14">Na ne nnipa a wɔwɔ Yerusalem de,</para>
  <para style="q2" vid="ISA 8:14">ɔbɛyɛ afiri a ebeyi wɔn.<verse eid="ISA 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15"/>Wɔn mu bebree bɛwatiri;</para>
  <para style="q2" vid="ISA 8:15">wɔbɛhwe ase a wɔrensɔre bio,</para>
  <para style="q2" vid="ISA 8:15">wobesum wɔn afiri na ayi wɔn.”<verse eid="ISA 8:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16"/>Kyekyere kɔkɔbɔ adanse no</para>
  <para style="q2" vid="ISA 8:16">sɔw mmara no ano ma mʼasuafo.<verse eid="ISA 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17"/>Mɛtwɛn <char style="nd">Awurade</char></para>
  <para style="q2" vid="ISA 8:17">a wayi nʼani afi Yakobfi so</para>
  <para style="q2" vid="ISA 8:17">mede me werɛ bɛhyɛ ne mu.<verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>Me ne mma a <char style="nd">Awurade</char> de wɔn ama me no ni. Yɛyɛ nsɛnkyerɛnne ne agyiraehyɛde wɔ Israel, na yefi Asafo <char style="nd">Awurade</char> a ɔte Sion Bepɔw so no nkyɛn.<verse eid="ISA 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>Sɛ nnipa tu mo fo sɛ monkohu samanfrɛfo ne nnunsifo a wɔkasa aso mu na emu ntew a, adɛn nti na wommmisa wɔn Nyankopɔn? Adɛn nti na mubisa ade wɔ awufo nkyɛn ma ateasefo? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>Sɛ wɔannyina mmara ne adanse yi so anka asɛm yi a, wunni adekyee mu hann. <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>Wɔde ahohiahia ne ɔkɔm bɛnantenantew asase no so; na sɛ wɔtɔ beraw a, wɔn bo befuw na wɔbɛma wɔn ani so adome wɔn hene ne wɔn Nyankopɔn. <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>Afei wɔbɛhwɛ asase no so, na wubehu ahohiahia ne sum a ɛyɛ hu, na wɔde wɔn bɛhyɛn sum kabii mu.<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="s1">Wɔawo Akokoaa Ama Yɛn</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>Nanso wɔn a na wɔwɔ ahohiahia mu no renni awerɛhow bio. Kan no ɔbrɛɛ Sebulon ne Naftali nsase no ase, nanso daakye bi ɔbɛhyɛ Galilea a ɛyɛ amanamanmufo man na ne kwan da Yordan ne po ntam no anuonyam.<verse eid="ISA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2"/>Nnipa a wɔnam sum mu</para>
  <para style="q2" vid="ISA 9:2">ahu Hann kɛse;</para>
  <para style="q1" vid="ISA 9:2">wɔn a wɔte asase a so sum kabii no,</para>
  <para style="q2" vid="ISA 9:2">hann bi apue wɔn so.<verse eid="ISA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3"/>Woatrɛw ɔman no mu</para>
  <para style="q2" vid="ISA 9:3">woama wɔn ani agye mmoroso</para>
  <para style="q1" vid="ISA 9:3">wodi ahurusi wɔ wʼanim</para>
  <para style="q2" vid="ISA 9:3">sɛnea nnipa di ahurusi otwabere,</para>
  <para style="q1" vid="ISA 9:3">sɛnea nnipa ho sɛpɛw wɔn</para>
  <para style="q2" vid="ISA 9:3">wɔ bere a wɔrekyɛ asade no.<verse eid="ISA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4"/>Te sɛ da a Midian dii nkogu no,</para>
  <para style="q2" vid="ISA 9:4">woadwerɛw konnua a ɛda wɔn so no,</para>
  <para style="q1" vid="ISA 9:4">abaa a ɛda wɔn mmati,</para>
  <para style="q2" vid="ISA 9:4">wɔn nhyɛsofo pema.<verse eid="ISA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5"/>Ɔkofo mpaboa a wɔhyɛ de kɔ sa</para>
  <para style="q2" vid="ISA 9:5">ne atade biara a mogya akeka mu,</para>
  <para style="q1" vid="ISA 9:5">wobegyaw agu hɔ na wɔahyew;</para>
  <para style="q2" vid="ISA 9:5">ɛbɛyɛ nea ɛma ogya dɛw.<verse eid="ISA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6"/>Na wɔawo akokoaa ama yɛn,</para>
  <para style="q2" vid="ISA 9:6">wɔama yɛn ɔbabarima,</para>
  <para style="q1" vid="ISA 9:6">na amammui no bɛda ne mmati so.</para>
  <para style="q2" vid="ISA 9:6">Na wɔbɛfrɛ no</para>
  <para style="q1" vid="ISA 9:6">Ɔfotufo Nwonwani, Otumfo Nyankopɔn,</para>
  <para style="q2" vid="ISA 9:6">Daa Agya, Asomdwoe Wura.<verse eid="ISA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7"/>Nʼamammui no nkɔso ne Nʼasomdwoe</para>
  <para style="q2" vid="ISA 9:7">bɛtena hɔ daa.</para>
  <para style="q1" vid="ISA 9:7">Ɔbɛtena Dawid ahengua so</para>
  <para style="q2" vid="ISA 9:7">abu Nʼahenni,</para>
  <para style="q1" vid="ISA 9:7">Ɔde atɛntrenee ne treneeyɛ</para>
  <para style="q2" vid="ISA 9:7">befi ase na wama atim</para>
  <para style="q1" vid="ISA 9:7">afi saa bere no akosi daa apem.</para>
  <para style="q2" vid="ISA 9:7">Asafo <char style="nd">Awurade</char> mmɔdemmɔ</para>
  <para style="q2" vid="ISA 9:7">bɛyɛ eyi.<verse eid="ISA 9:7"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Abufuw A Etia Israel</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8"/>Awurade ama Yakob nkra a etia no,</para>
  <para style="q2" vid="ISA 9:8">na ɛbɛka Israel.<verse eid="ISA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9"/>Nnipa no nyinaa behu,</para>
  <para style="q2" vid="ISA 9:9">Efraim ne wɔn a wɔtete Samaria</para>
  <para style="q1" vid="ISA 9:9">a wɔde ahohoahoa</para>
  <para style="q2" vid="ISA 9:9">ne ahomaso koma kasa no,<verse eid="ISA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10"/>“Ntayaa no abubu agu fam</para>
  <para style="q2" vid="ISA 9:10">nanso yɛde abo a wɔatwa bɛto bio.</para>
  <para style="q1" vid="ISA 9:10">Wɔabubu borɔdɔma nnua no</para>
  <para style="q2" vid="ISA 9:10">nanso yɛde sida besi anan mu.”<verse eid="ISA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11"/>Nanso <char style="nd">Awurade</char> ahyɛ Resin atamfo den atia wɔn,</para>
  <para style="q2" vid="ISA 9:11">na ɔhyɛ wɔn atamfo no nkuran.<verse eid="ISA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12"/>Aramfo a wofi apuei fam,</para>
  <para style="q2" vid="ISA 9:12">Filistifo a wofi atɔe fam,</para>
  <para style="q2" vid="ISA 9:12">abue wɔn anom amene Israel.</para>
  <para style="b" vid="ISA 9:12"/>
  <para style="q1" vid="ISA 9:12">Nanso eyinom nyinaa akyi no ne bo nnwoo ɛ,</para>
  <para style="q2" vid="ISA 9:12">na ne nsa da so wɔ soro.<verse eid="ISA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13"/>Nanso nnipa no nsan nkɔɔ nea ɔtwee wɔn aso no nkyɛn,</para>
  <para style="q2" vid="ISA 9:13">na wɔnhwehwɛɛ Asafo <char style="nd">Awurade</char> no akyi kwan nso.<verse eid="ISA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14"/>Enti <char style="nd">Awurade</char> betwa eti ne dua afi Israel ho</para>
  <para style="q2" vid="ISA 9:14">na berɛw ne demmire nso, ɔde da koro pɛ;<verse eid="ISA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15"/>mpanyimfo ne akunini no ne eti no,</para>
  <para style="q2" vid="ISA 9:15">na atoro adiyifo no ne dua no.<verse eid="ISA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16"/>Wɔn a wɔkyerɛ nnipa yi kwan no, nkyerɛ wɔn ɔkwan pa,</para>
  <para style="q2" vid="ISA 9:16">na wɔn a wonya akwankyerɛ no nso, fom kwan.<verse eid="ISA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17"/>Enti Awurade ani rennye mmerante no ho,</para>
  <para style="q2" vid="ISA 9:17">na ɔrenhu ayisaa ne akunafo mmɔbɔ</para>
  <para style="q1" vid="ISA 9:17">efisɛ, obiara nni nyamesu na wɔyɛ amumɔyɛfo,</para>
  <para style="q2" vid="ISA 9:17">ano biara ka ahuhusɛm.</para>
  <para style="b" vid="ISA 9:17"/>
  <para style="q1" vid="ISA 9:17">Nanso eyinom nyinaa akyi no ne bo nnwoo ɛ,</para>
  <para style="q2" vid="ISA 9:17">na ne nsa da so wɔ soro.<verse eid="ISA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18"/>Nokware, atirimɔden hye te sɛ ogya;</para>
  <para style="q2" vid="ISA 9:18">ɛhyew nnɛnkyɛnse ne nsɔe,</para>
  <para style="q1" vid="ISA 9:18">ɛde ogya to kwaeberentuw mu hyew no,</para>
  <para style="q2" vid="ISA 9:18">na ɛnam wusiw kumɔnn mu foro kɔ soro.<verse eid="ISA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19"/>Ɛnam Asafo <char style="nd">Awurade</char> abufuw so,</para>
  <para style="q2" vid="ISA 9:19">asase no bɛkyen</para>
  <para style="q1" vid="ISA 9:19">na nnipa bɛyɛ mmabaa ama ogya no;</para>
  <para style="q2" vid="ISA 9:19">na obiara remfa ne nua ho nkyɛ no.<verse eid="ISA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20"/>Nifa so, wɔbɛfom aduan adi,</para>
  <para style="q2" vid="ISA 9:20">nanso ɔkɔm bɛde wɔn;</para>
  <para style="q1" vid="ISA 9:20">benkum so wobedidi,</para>
  <para style="q2" vid="ISA 9:20">nanso wɔremmee.</para>
  <para style="q1" vid="ISA 9:20">Obiara bɛwe ne ba nam.<verse eid="ISA 9:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21"/>Manase bɛdan Efraim na Efraim adan Manase</para>
  <para style="q2" vid="ISA 9:21">na wɔbɛbɔ mu atia Yuda.</para>
  <para style="b" vid="ISA 9:21"/>
  <para style="q1" vid="ISA 9:21">Nanso eyinom nyinaa akyi no ne bo nnwoo ɛ,</para>
  <para style="q2" vid="ISA 9:21">na ne nsa da so wɔ soro.<verse eid="ISA 9:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1"/>Wonnue, wɔn a wɔhyɛ mmara a ɛmfa ne kwan mu,</para>
  <para style="q2" vid="ISA 10:1">wɔn a wɔhyɛ mmara dennen a ɛde nhyɛso ba,<verse eid="ISA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2"/>de siw ahiafo ahofadi ho kwan,</para>
  <para style="q2" vid="ISA 10:2">de atɛntrenee bɔ me nkurɔfo a wɔhyɛ wɔn so no atirimɔden.</para>
  <para style="q1" vid="ISA 10:2">Wɔma akunafo yɛ amanehunufo</para>
  <para style="q2" vid="ISA 10:2">na wɔbɔ ayisaa korɔn.<verse eid="ISA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3"/>Dɛn na mobɛyɛ wɔ akontaabu da no,</para>
  <para style="q2" vid="ISA 10:3">bere a amanehunu fi akyirikyiri reba?</para>
  <para style="q1" vid="ISA 10:3">Hena nkyɛn na mubeguan akɔpɛ mmoa?</para>
  <para style="q2" vid="ISA 10:3">Ɛhefa na mubegyaw mo ahode?<verse eid="ISA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4"/>Ɛrenka mo hwee sɛ mobɛfra nneduafo mu</para>
  <para style="q2" vid="ISA 10:4">anaasɛ mobɛtotɔ wɔ atɔfo mu.</para>
  <para style="b" vid="ISA 10:4"/>
  <para style="q1" vid="ISA 10:4">Nanso eyinom nyinaa akyi no ne bo nnwoo ɛ,</para>
  <para style="q2" vid="ISA 10:4">na ne nsa da so wɔ soro.<verse eid="ISA 10:4"/></para>
  <para style="s1">Asiria Atemmu A Efi Onyankopɔn</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5"/>“Nnome nka Asiriani no, mʼabufuw abaa,</para>
  <para style="q2" vid="ISA 10:5">nea okura mʼabufuwhyew pema no!<verse eid="ISA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6"/>Mesoma no akɔ ɔman a wonnim Onyankopɔn so</para>
  <para style="q2" vid="ISA 10:6">migya no kwan ma wakɔ nnipa a wɔhyɛ me abufuw so</para>
  <para style="q1" vid="ISA 10:6">sɛ wonkogye akorɔnne abran so na wonhuam afowde,</para>
  <para style="q2" vid="ISA 10:6">na wontiatia wɔn so sɛ dɔte wɔ mmɔnten so.<verse eid="ISA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7"/>Nanso ɛnyɛ eyi ne nea ɔpɛ sɛ ɔyɛ</para>
  <para style="q2" vid="ISA 10:7">ɛnyɛ eyi ne nea ɛwɔ nʼadwene mu;</para>
  <para style="q1" vid="ISA 10:7">ne botae ne sɛ ɔbɛsɛe,</para>
  <para style="q2" vid="ISA 10:7">sɛ ɔde aman bebree bɛba wɔn awiei.<verse eid="ISA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8"/>Na obisa se, ‘Ahemfo nyinaa nyɛ mʼasahene ana?<verse eid="ISA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9"/>Kalno nyɛɛ sɛ Karkemis ana?</para>
  <para style="q1" vid="ISA 10:9">Hamat nte sɛ Arpad</para>
  <para style="q2" vid="ISA 10:9">na Samaria nte sɛ Damasko ana?<verse eid="ISA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10"/>Sɛnea migyee ahoni ahenni ahorow abran so,</para>
  <para style="q2" vid="ISA 10:10">ahenni a wɔn nsɛsode sen nea ɛwɔ Yerusalem ne Samaria no.<verse eid="ISA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11"/>Merentumi ne Yerusalem ne ne nsɛsode nni,</para>
  <para style="q2" vid="ISA 10:11">sɛnea me ne Samaria ne nʼahoni dii no?’ ”<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>Sɛ Awurade wie nʼadwuma a etia Bepɔw Sion ne Yerusalem nyinaa a, ɔbɛka se, “Mɛtwe Asiriahene aso wɔ ne komapirim ne nʼani a ɛnsɔ ade no ho. <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>Efisɛ ɔka se,</para>
  <para style="q1" vid="ISA 10:13">“ ‘Mede mʼahoɔden na ayɛ eyi,</para>
  <para style="q2" vid="ISA 10:13">na mifi me nyansa mu, efisɛ mewɔ nimdeɛ.</para>
  <para style="q1" vid="ISA 10:13">Mesɛee aman aman ahye,</para>
  <para style="q2" vid="ISA 10:13">mefow wɔn ademude;</para>
  <para style="q2" vid="ISA 10:13">mebrɛɛ wɔn ahemfo ase te sɛ ɔbran.<verse eid="ISA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14"/>Sɛnea obi teɛ ne nsa hyɛ berebuw mu no,</para>
  <para style="q2" vid="ISA 10:14">saa ara nso na mɛteɛ me nsa wɔ amanaman no ahonyade so;</para>
  <para style="q1" vid="ISA 10:14">sɛnea wɔtase nkesua a wɔagyaw hɔ no,</para>
  <para style="q2" vid="ISA 10:14">saa ara na mɛboaboa amanaman no nyinaa ano;</para>
  <para style="q2" vid="ISA 10:14">obiara ammɔ ne ntaban mu,</para>
  <para style="q2" vid="ISA 10:14">na wammue nʼano ansu.’ ”<verse eid="ISA 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15"/>Abonnua ma ne ho so tra nea ɔtow,</para>
  <para style="q2" vid="ISA 10:15">anaasɛ ɔwan hoahoa ne ho kyɛn nea ɔde no yɛ adwuma ana?</para>
  <para style="q1" vid="ISA 10:15">Ayɛ te sɛnea abaa tumi dannan nea ɔmaa no so,</para>
  <para style="q2" vid="ISA 10:15">anaasɛ poribaa tumi hinhim nea ɔnyɛ dua!<verse eid="ISA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16"/>Afei Awurade, Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 10:16">de ɔyaredɔm bɛbɔ nʼakofo ahoɔdenfo no;</para>
  <para style="q1" vid="ISA 10:16">ne kɛseyɛ mu wobefita ogya mu ama adɛw</para>
  <para style="q2" vid="ISA 10:16">te sɛ gyaframa.<verse eid="ISA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17"/>Israel Hann no bɛdan ogya.</para>
  <para style="q2" vid="ISA 10:17">Wɔn Kronkronni no bɛyɛ ogya a ɛdɛw;</para>
  <para style="q1" vid="ISA 10:17">ɔde da koro bɛhyew na wasɛe</para>
  <para style="q2" vid="ISA 10:17">ne nsɔe ne nnɛnkyɛnse.<verse eid="ISA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18"/>Ne kwae ne nʼasasebere anuonyam no,</para>
  <para style="q2" vid="ISA 10:18">ɛbɛsɛe pasapasa</para>
  <para style="q2" vid="ISA 10:18">te sɛ ɔyarefo a ɔrefɔn.<verse eid="ISA 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19"/>Nnua a ɛbɛka wɔ ne kwae mu bɛyɛ kakraa bi</para>
  <para style="q2" vid="ISA 10:19">a abofra betumi akyerɛ ne dodow.<verse eid="ISA 10:19"/></para>
  <para style="s1">Israel Nkaefo</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20"/>Da no, Israel nkae,</para>
  <para style="q2" vid="ISA 10:20">Yakob fifo a wɔbɛka no,</para>
  <para style="q1" vid="ISA 10:20">remfa wɔn ho nto no so bio</para>
  <para style="q2" vid="ISA 10:20">nea ɔbɔɔ wɔn hwee fam no;</para>
  <para style="q1" vid="ISA 10:20">na mmom wɔde wɔn ho bɛto <char style="nd">Awurade</char> so nokware mu,</para>
  <para style="q2" vid="ISA 10:20">Israel Kronkronni no.<verse eid="ISA 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21"/>Nkae bi bɛsan aba, Yakob nkae bi</para>
  <para style="q2" vid="ISA 10:21">bɛsan aba Otumfo Onyankopɔn no nkyɛn.<verse eid="ISA 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22"/>Israel, ɛwɔ mu sɛ wo nkurɔfo dɔɔso sɛ mpoano nwea de,</para>
  <para style="q2" vid="ISA 10:22">nanso nkae bi pɛ na wɔbɛsan.</para>
  <para style="q1" vid="ISA 10:22">Wɔahyɛ ɔsɛe ho mmara dennen</para>
  <para style="q2" vid="ISA 10:22">a ebebunkam so na ɛteɛ.<verse eid="ISA 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23"/>Awurade, Asafo <char style="nd">Awurade</char> de ɔsɛe</para>
  <para style="q2" vid="ISA 10:23">a wɔahyɛ ho mmara ketee na ɛbɛba asase no so nyinaa.<verse eid="ISA 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 10:24"/>Enti sɛɛ na Awurade, Asafo <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 10:24">“Me nkurɔfo a mote Sion,</para>
  <para style="q2" vid="ISA 10:24">munnsuro Asiriafo no,</para>
  <para style="q1" vid="ISA 10:24">wɔn a wɔde mmaa hwe mo</para>
  <para style="q2" vid="ISA 10:24">na wɔma kontibaa so tia mo, sɛnea Misraim yɛe no.<verse eid="ISA 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25"/>Ɛrenkyɛ koraa mʼabufuw a etia mo no ano bedwo</para>
  <para style="q2" vid="ISA 10:25">na mʼanibere bɛkɔ wɔn sɛe so.”<verse eid="ISA 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26"/>Asafo <char style="nd">Awurade</char> de mpire bɛhwe wɔn,</para>
  <para style="q2" vid="ISA 10:26">sɛnea ɔbɔɔ Midian hwee fam wɔ Oreb Ɔbotan ho no;</para>
  <para style="q1" vid="ISA 10:26">na ɔbɛteɛ ne pema wɔ nsu no so,</para>
  <para style="q2" vid="ISA 10:26">sɛnea ɔyɛɛ wɔ Misraim no.<verse eid="ISA 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27"/>Da no wobeyi wɔn adesoa no afi wɔn mmati so</para>
  <para style="q2" vid="ISA 10:27">wɔn konnua afi wo kɔn mu;</para>
  <para style="q1" vid="ISA 10:27">wobubu konnua no</para>
  <para style="q2" vid="ISA 10:27">efisɛ woayɛ ɔbran yiye.<verse eid="ISA 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28"/>Wɔhyɛn Ayat;</para>
  <para style="q2" vid="ISA 10:28">wɔfa Migron;</para>
  <para style="q2" vid="ISA 10:28">na wɔkora wɔn nneɛma wɔ Mikmas.<verse eid="ISA 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29"/>Wɔfaa ɔtempɔn no so, na wɔka se,</para>
  <para style="q2" vid="ISA 10:29">“Yɛbɛwɛn wɔ Geba anadwo yi.”</para>
  <para style="q1" vid="ISA 10:29">Rama ho popo;</para>
  <para style="q2" vid="ISA 10:29">Saulo kurow Gibea nso guan.<verse eid="ISA 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30"/>Teɛ mu, Galim Babea!</para>
  <para style="q2" vid="ISA 10:30">Tie, Laisa!</para>
  <para style="q2" vid="ISA 10:30">Anatot Mmɔborɔni!<verse eid="ISA 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31"/>Madmena reguan;</para>
  <para style="q2" vid="ISA 10:31">Gebimfo kɔtetɛw.<verse eid="ISA 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32"/>Nnɛ ara wobegyina wɔ Nob;</para>
  <para style="q2" vid="ISA 10:32">wobehim wɔn nsa</para>
  <para style="q1" vid="ISA 10:32">wɔ Ɔbabea Sion bepɔw no so,</para>
  <para style="q2" vid="ISA 10:32">wɔ Yerusalem koko no so.<verse eid="ISA 10:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33"/>Hwɛ, Awurade, Asafo <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="ISA 10:33">ɔde tumi kɛse betwitwa dua mman no.</para>
  <para style="q1" vid="ISA 10:33">Wobebubu nnua atenten no agu fam</para>
  <para style="q2" vid="ISA 10:33">nea ɛwowaree no bɛba fam.<verse eid="ISA 10:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34"/>Ɔde abonnua betwitwa kwaedɔtɔ agu fam</para>
  <para style="q2" vid="ISA 10:34">Lebanon bɛhwe ase wɔ Ɔkɛse no anim.<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">Yisai Ase Dubaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1"/>Dua foforo bi befifi wɔ Yisai dunsin ho;</para>
  <para style="q2" vid="ISA 11:1">efi ne ntin mu na Dubaa bi bɛsow aba.<verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>
    <char style="nd">Awurade</char> Honhom bɛtena ne so,</para>
  <para style="q2" vid="ISA 11:2">nyansa ne ntease Honhom,</para>
  <para style="q1" vid="ISA 11:2">afotu ne tumi Honhom,</para>
  <para style="q2" vid="ISA 11:2">nimdeɛ ne <char style="nd">Awurade</char> suro Honhom,<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>Na nʼani begye wɔ <char style="nd">Awurade</char> suro mu.</para>
  <para style="q2" vid="ISA 11:3">Ɛnyɛ nea ɔde nʼani hu so na obegyina abu atɛn,</para>
  <para style="q1" vid="ISA 11:3">anaa nea ɔde nʼaso bɛte so na obegyina asi gyinae;<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>na mmom ɔde trenee bebu mmɔborɔfo atɛn,</para>
  <para style="q2" vid="ISA 11:4">ɔde atɛntrenee besi gyinae ama asase so ahiafo.</para>
  <para style="q1" vid="ISA 11:4">Ɔde nʼano abaa na ɛbɛbɔ asase;</para>
  <para style="q2" vid="ISA 11:4">ɔde nʼanofafa home bekunkum amumɔyɛfo.<verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>Trenee bɛyɛ nʼabɔso</para>
  <para style="q2" vid="ISA 11:5">na nokwaredi ayɛ nʼabɔso.<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>Pataku ne oguamma bɛtena,</para>
  <para style="q2" vid="ISA 11:6">ɔsebɔ ne abirekyi bɛda,</para>
  <para style="q1" vid="ISA 11:6">nantwi ba ne gyata ne ne ba bɛbɔ mu;</para>
  <para style="q2" vid="ISA 11:6">na abofra ketewa bi adi wɔn anim.<verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>Nantwi ne sisi bɛbɔ mu adidi,</para>
  <para style="q2" vid="ISA 11:7">wɔn mma bɛdeda faako,</para>
  <para style="q2" vid="ISA 11:7">na gyata bɛwe wura te sɛ nantwi.<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>Akokoaa bedi agoru abɛn ɔprammiri amoa ano,</para>
  <para style="q2" vid="ISA 11:8">na abofra ketewa de ne nsa ahyɛ ahurutoa bon mu.<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>Wɔrenyɛ obi bɔne na wɔrensɛe ade</para>
  <para style="q2" vid="ISA 11:9">wɔ me bepɔw Kronkron nyinaa so,</para>
  <para style="q1" vid="ISA 11:9">na <char style="nd">Awurade</char> ho nimdeɛ bɛyɛ asase so ma</para>
  <para style="q2" vid="ISA 11:9">sɛnea nsu ayɛ po ma no.<verse eid="ISA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>Na da no, Yisai aseni bɛsɔre; nea ɔbɛsɔre abedi aman aman no so; ɔno na wɔn ani bɛda ne so, na nʼahomegyebea benya anuonyam. <verse eid="ISA 11:10"/><verse number="11" style="v" sid="ISA 11:11"/>Saa da no, Awurade bɛma ne nsa so ne mprenu so de agye ne nkurɔfo a wɔaka afi Asiria, Misraim anafo fam, Misraim atifi fam, Kus, Elam, Babilonia, Hamat ne Po so asupɔw.<verse eid="ISA 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12"/>Ɔbɛma frankaa so ama aman no</para>
  <para style="q2" vid="ISA 11:12">na wɔaboaboa Israelfo a wɔatwa wɔn asu no ano;</para>
  <para style="q1" vid="ISA 11:12">Ɔbɛboaboa Yudafo a wɔahwete no ano</para>
  <para style="q2" vid="ISA 11:12">afi asase ntwea anan no so.<verse eid="ISA 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13"/>Efraim anibere betu ayera,</para>
  <para style="q2" vid="ISA 11:13">na wɔbɛsɛe Yuda atamfo.</para>
  <para style="q1" vid="ISA 11:13">Efraim ani remmere Yuda bio,</para>
  <para style="q2" vid="ISA 11:13">na Yuda nso rentan Efraim ani.<verse eid="ISA 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14"/>Wobetwiw afa Filistia asiansian ahorow no so akɔ atɔe fam;</para>
  <para style="q2" vid="ISA 11:14">na wɔbɛbɔ mu afow nnipa akɔ apuei fam.</para>
  <para style="q1" vid="ISA 11:14">Wɔbɛfa Edom ne Moab,</para>
  <para style="q2" vid="ISA 11:14">na Amonfo bɛhyɛ wɔn ase.<verse eid="ISA 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15"/>
    <char style="nd">Awurade</char> bɛma nsu</para>
  <para style="q2" vid="ISA 11:15">a ɛwɔ Misraim Po no mu ayow korakora;</para>
  <para style="q1" vid="ISA 11:15">ɔbɛma ne nsa mu mframa a mu yɛ hyew</para>
  <para style="q2" vid="ISA 11:15">abɔ afa Asubɔnten Eufrate so.</para>
  <para style="q1" vid="ISA 11:15">Ɔbɛpaapae mu ayɛ no nsuwansuwa ason</para>
  <para style="q2" vid="ISA 11:15">sɛnea ɛbɛyɛ a obiara betumi ahyɛ mpaboa atwa.<verse eid="ISA 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16"/>Ɔtempɔn bi bɛda hɔ ama ne nkurɔfo nkae</para>
  <para style="q2" vid="ISA 11:16">a wɔaka Asiria,</para>
  <para style="q1" vid="ISA 11:16">sɛnea bi daa hɔ maa Israel</para>
  <para style="q2" vid="ISA 11:16">bere a wofi Misraim bae no.<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">Ayeyi Nnwom</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>Saa da no, wobɛka se:</para>
  <para style="q1" vid="ISA 12:1">“Mɛkamfo wo, <char style="nd">Awurade</char>!</para>
  <para style="q1" vid="ISA 12:1">Ɛwɔ mu wo bo fuw me de,</para>
  <para style="q1" vid="ISA 12:1">nanso afei wʼabufuw ano adwo.</para>
  <para style="q2" vid="ISA 12:1">Na woakyekye me werɛ.<verse eid="ISA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>Nokware, Onyankopɔn ne mʼagyenkwa;</para>
  <para style="q2" vid="ISA 12:2">mede me ho bɛto no so, na merensuro.</para>
  <para style="q1" vid="ISA 12:2">
    <char style="nd">Awurade</char>, <char style="nd">Awurade</char> ne mʼahoɔden ne me dwom;</para>
  <para style="q2" vid="ISA 12:2">na wabɛyɛ me nkwagye.”<verse eid="ISA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3"/>Wode anigye bɛsaw nsu</para>
  <para style="q2" vid="ISA 12:3">afi nkwagye mmura mu.<verse eid="ISA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4"/>Saa da no wobɛka se,</para>
  <para style="q1" vid="ISA 12:4">“Da <char style="nd">Awurade</char> ase, bɔ ne din</para>
  <para style="q2" vid="ISA 12:4">ma amanaman nhu nea wayɛ,</para>
  <para style="q1" vid="ISA 12:4">na pae mu ka se wɔama ne din so.<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>To dwom ma <char style="nd">Awurade</char>, efisɛ, wayɛ nea ɛwɔ anuonyam bebree.</para>
  <para style="q1" vid="ISA 12:5">Da eyi adi kyerɛ wiase nyinaa.<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>Momma mo nne so nto dwom anigye so</para>
  <para style="q2" vid="ISA 12:6">mo a mowɔ Sion,</para>
  <para style="q1" vid="ISA 12:6">efisɛ Israel Kronkronni a ɔte mo mu no yɛ ɔkɛse.”<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">Nkɔmhyɛ A Etia Babilonia</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>Amos babarima Yesaia adehu a ɛfa Babilonia ho ni:<verse eid="ISA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2"/>Ma frankaa so wɔ bepɔw a hwee nni so no atifi,</para>
  <para style="q2" vid="ISA 13:2">teɛ mu frɛ wɔn:</para>
  <para style="q1" vid="ISA 13:2">nyama wɔn</para>
  <para style="q2" vid="ISA 13:2">ma wɔnhyɛn atitiriw no apon mu.<verse eid="ISA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3"/>Mahyɛ mʼahotewfo;</para>
  <para style="q2" vid="ISA 13:3">mafrɛ mʼakofo sɛ wɔnna mʼabufuwhyew adi,</para>
  <para style="q2" vid="ISA 13:3">wɔn a wodi me nkonimdi ho ahurusi.<verse eid="ISA 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4"/>Tie huuyɛ bi a ɛwɔ mmepɔw no so</para>
  <para style="q2" vid="ISA 13:4">te sɛ dɔm kɛse bi de!</para>
  <para style="q1" vid="ISA 13:4">Tie akasakasa a ɛwɔ ahenni ahorow mu,</para>
  <para style="q2" vid="ISA 13:4">te sɛ amanaman a wɔreboaboa wɔn ho ano!</para>
  <para style="q1" vid="ISA 13:4">Asafo <char style="nd">Awurade</char> reboa dɔm ano akɔ ɔko.<verse eid="ISA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5"/>Wofifi akyirikyiri aman so,</para>
  <para style="q2" vid="ISA 13:5">wofifi ɔsoro ahye so,</para>
  <para style="q2" vid="ISA 13:5">
    <char style="nd">Awurade</char> ne nʼakode a ɛyɛ nʼabufuwhyew;</para>
  <para style="q2" vid="ISA 13:5">bɛsɛe ɔman no nyinaa.<verse eid="ISA 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6"/>Twa adwo, na <char style="nd">Awurade</char> da no abɛn;</para>
  <para style="q2" vid="ISA 13:6">ɛbɛba te sɛ ɔsɛe a efi Otumfo no.<verse eid="ISA 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7"/>Eyi nti, nsa nyinaa bedwudwo,</para>
  <para style="q2" vid="ISA 13:7">obiara koma bɛbotow.<verse eid="ISA 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8"/>Wɔbɛbɔ hu,</para>
  <para style="q2" vid="ISA 13:8">ɔyaw ne apinisi bekita wɔn;</para>
  <para style="q2" vid="ISA 13:8">wobebubu wɔn mu te sɛ ɔbea a awo aka no.</para>
  <para style="q1" vid="ISA 13:8">Wɔde ahodwiriw bɛhwɛ wɔn ho wɔn ho anim,</para>
  <para style="q2" vid="ISA 13:8">a wɔn ani asosɔ gya.<verse eid="ISA 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9"/>Hwɛ, <char style="nd">Awurade</char> da no reba</para>
  <para style="q2" vid="ISA 13:9">da bɔne a abufuw ne abufuwhyew wɔ mu,</para>
  <para style="q1" vid="ISA 13:9">ɛrebɛsɛe asase no</para>
  <para style="q2" vid="ISA 13:9">na asɛe abɔnefo a wɔte so no.<verse eid="ISA 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10"/>Ɔsoro nsoromma ne wɔn akuw renhyerɛn.</para>
  <para style="q2" vid="ISA 13:10">Sum beduru owia a ɛrepue</para>
  <para style="q2" vid="ISA 13:10">na ɔsram nso renhyerɛn.<verse eid="ISA 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11"/>Mɛtwe wiase aso, ne bɔne nti,</para>
  <para style="q2" vid="ISA 13:11">ne amumɔyɛfo wɔ wɔn nnebɔne ho.</para>
  <para style="q1" vid="ISA 13:11">Metwa ahantanfo ahomaso so</para>
  <para style="q2" vid="ISA 13:11">mɛbrɛ nea odi awurukasɛm no ahantan ase.<verse eid="ISA 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12"/>Mɛma onipa ho ayɛ na asen sika kɔkɔɔ ankasa</para>
  <para style="q2" vid="ISA 13:12">ɔbɛsen Ofir sikakɔkɔɔ.<verse eid="ISA 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13"/>Enti mɛma ɔsoro awosow;</para>
  <para style="q2" vid="ISA 13:13">na asase ahinhim wɔ ne sibea</para>
  <para style="q1" vid="ISA 13:13">wɔ Asafo <char style="nd">Awurade</char> abufuwhyew ano</para>
  <para style="q2" vid="ISA 13:13">nʼabufuwhyewda no.<verse eid="ISA 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14"/>Te sɛ ɔwansan a ɔbɔmmɔfo rehwehwɛ no akum no,</para>
  <para style="q2" vid="ISA 13:14">te sɛ nguan a wonni ɔhwɛfo,</para>
  <para style="q1" vid="ISA 13:14">obiara bɛkɔ ne nkurɔfo mu,</para>
  <para style="q2" vid="ISA 13:14">obiara beguan akɔ nʼasase so.<verse eid="ISA 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15"/>Obiara a wɔbɛfa no dedua no, wobehwirew no afoa akum no;</para>
  <para style="q2" vid="ISA 13:15">wɔn a wɔbɛkyere wɔn no nyinaa bɛtotɔ wɔ afoa ano.<verse eid="ISA 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16"/>Wɔbɛtotow nkokoaa ahwehwe fam wɔ wɔn anim:</para>
  <para style="q2" vid="ISA 13:16">wɔbɛfom wɔn afi mu nneɛma na wɔato wɔn yerenom mmonnaa.<verse eid="ISA 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17"/>Hwɛ mɛhwanyan Mediafo atia wɔn,</para>
  <para style="q2" vid="ISA 13:17">wɔn na wɔmfa dwetɛ nyɛ hwee</para>
  <para style="q2" vid="ISA 13:17">na wɔn ani nnye sikakɔkɔɔ ho.<verse eid="ISA 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18"/>Wɔn tadua bɛbobɔ mmerante ahwehwe fam;</para>
  <para style="q2" vid="ISA 13:18">wɔrenhu nkokoaa mmɔbɔ</para>
  <para style="q2" vid="ISA 13:18">na wɔrennya ayamhyehye mma mmofra.<verse eid="ISA 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19"/>Babilonia, ahenni ahorow mu ɔbohemaa,</para>
  <para style="q2" vid="ISA 13:19">anuonyam a Babiloniafo de hoahoa wɔn ho no</para>
  <para style="q1" vid="ISA 13:19">Onyankopɔn bɛdan abutuw</para>
  <para style="q2" vid="ISA 13:19">te sɛ Sodom ne Gomora.<verse eid="ISA 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20"/>Nnipa rentena hɔ bio</para>
  <para style="q2" vid="ISA 13:20">awo ntoatoaso nyinaa mu;</para>
  <para style="q1" vid="ISA 13:20">Arabni biara rensi ne ntamadan wɔ hɔ</para>
  <para style="q2" vid="ISA 13:20">oguanhwɛfo biara remfa ne nguan nkɔhome wɔ hɔ.<verse eid="ISA 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21"/>Nanso sare so mmoa bɛda hɔ.</para>
  <para style="q2" vid="ISA 13:21">Sakraman bɛyɛ nʼafi no mu ma;</para>
  <para style="q1" vid="ISA 13:21">hɔ na mpatu bɛtena,</para>
  <para style="q2" vid="ISA 13:21">hɔ na wura mu mmirekyi nso bedi agoru.<verse eid="ISA 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22"/>Mpataku bɛtena nʼabandennen mu,</para>
  <para style="q2" vid="ISA 13:22">adompo bɛyɛ nʼahemfi fɛfɛ no mu ma.</para>
  <para style="q1" vid="ISA 13:22">Ne bere aso,</para>
  <para style="q2" vid="ISA 13:22">na wɔrentwe ne nna mu.<verse eid="ISA 13:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1"/>
    <char style="nd">Awurade</char> behu Yakob mmɔbɔ;</para>
  <para style="q2" vid="ISA 14:1">ɔbɛsan afa Israel</para>
  <para style="q2" vid="ISA 14:1">na ɔbɛbɔ wɔn atenase wɔ wɔn ankasa asase so.</para>
  <para style="q1" vid="ISA 14:1">Ananafo bɛba abɛka wɔn ho</para>
  <para style="q2" vid="ISA 14:1">na wɔne Yakobfi aka abɔ mu.<verse eid="ISA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2"/>Amanaman bɛfa wɔn</para>
  <para style="q2" vid="ISA 14:2">de wɔn aba wɔn ankasa atenae.</para>
  <para style="q1" vid="ISA 14:2">Na Israelfi bɛfa amanaman no ayɛ wɔn de</para>
  <para style="q2" vid="ISA 14:2">sɛ nkoa ne mfenaa wɔ <char style="nd">Awurade</char> asase so.</para>
  <para style="q1" vid="ISA 14:2">Wɔbɛyɛ wɔn a wɔyɛɛ wɔn nnommumfo no nnommum</para>
  <para style="q2" vid="ISA 14:2">na wobedi wɔn sohwɛfo so.<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>Na da a <char style="nd">Awurade</char> bɛma mo ɔhome afi amanehunu, ahoyeraw ne nkoasom dennen mu no, <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>mubedi Babiloniahene ho fɛw se:</para>
  <para style="q1" vid="ISA 14:4">hwɛ sɛnea sohyɛfo no aba nʼawie!</para>
  <para style="q2" vid="ISA 14:4">ne sɛnea nʼabufuw nso to atwa!<verse eid="ISA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5"/>
    <char style="nd">Awurade</char> abubu otirimɔdenfo no abaa mu,</para>
  <para style="q2" vid="ISA 14:5">sodifo ahempema no,<verse eid="ISA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6"/>nea abufuw mu no ɔde bobɔɔ wɔn</para>
  <para style="q2" vid="ISA 14:6">toatoaa so hwehwee fam,</para>
  <para style="q1" vid="ISA 14:6">na abufuwhyew mu otintim wɔn so a ahomegye nni mu</para>
  <para style="q2" vid="ISA 14:6">de brɛɛ amanaman no ase no.<verse eid="ISA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7"/>Nsase no nyinaa rehome wɔ asomdwoe mu;</para>
  <para style="q2" vid="ISA 14:7">na wɔto dwom.<verse eid="ISA 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8"/>Mpo, ɔpepaw nnua ne Lebanon sida</para>
  <para style="q2" vid="ISA 14:8">nya ho anigye na wɔka se,</para>
  <para style="q1" vid="ISA 14:8">“Afei a wɔabrɛ wo ase yi,</para>
  <para style="q2" vid="ISA 14:8">duatwafo biara remmetwa yɛn.”<verse eid="ISA 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9"/>Awufo nna a ɛwɔ ase no rekeka ne ho</para>
  <para style="q2" vid="ISA 14:9">abehyia wo kwan;</para>
  <para style="q1" vid="ISA 14:9">ɛkanyan wɔn a wɔafi mu no honhom</para>
  <para style="q2" vid="ISA 14:9">sɛ wɔmmɛma wo akwaaba,</para>
  <para style="q1" vid="ISA 14:9">wɔn a na wɔyɛ akannifo wɔ wiase</para>
  <para style="q2" vid="ISA 14:9">ɛma wɔsɔre fi wɔn nhengua so,</para>
  <para style="q2" vid="ISA 14:9">wɔn a na wɔyɛ ahemfo wɔ amanaman so.<verse eid="ISA 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10"/>Wɔn nyinaa begye so,</para>
  <para style="q2" vid="ISA 14:10">wɔbɛka akyerɛ wo se,</para>
  <para style="q1" vid="ISA 14:10">“Wo nso woayɛ mmerɛw sɛ yɛn;</para>
  <para style="q2" vid="ISA 14:10">woayɛ sɛ yɛn ara.”<verse eid="ISA 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11"/>Wo kɛseyɛ nyinaa wɔde aba ɔda mu,</para>
  <para style="q2" vid="ISA 14:11">ne huuyɛ a efi wo asanku no;</para>
  <para style="q1" vid="ISA 14:11">wɔde nsaammoa asɛw kɛtɛ ama wo</para>
  <para style="q2" vid="ISA 14:11">na asunson akata wo so.<verse eid="ISA 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12"/>Sɛnea wufi ɔsoro abɛhwe fam,</para>
  <para style="q2" vid="ISA 14:12">anɔpa nsoromma, adekyee babarima!</para>
  <para style="q1" vid="ISA 14:12">Wɔato wo abɛhwe asase so,</para>
  <para style="q2" vid="ISA 14:12">wo a na kan no wobrɛ amanaman ase!<verse eid="ISA 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13"/>Wokaa no wo koma mu se,</para>
  <para style="q2" vid="ISA 14:13">“Mɛforo akɔ ɔsoro;</para>
  <para style="q1" vid="ISA 14:13">mɛma mʼahengua so</para>
  <para style="q2" vid="ISA 14:13">asi Onyankopɔn nsoromma atifi;</para>
  <para style="q1" vid="ISA 14:13">mɛtena ase adi hene wɔ ahyiae bepɔw so,</para>
  <para style="q2" vid="ISA 14:13">nea ɛkorɔn pa ara wɔ bepɔw kronkron no so.<verse eid="ISA 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14"/>Mɛforo atra omununkum atifi;</para>
  <para style="q2" vid="ISA 14:14">mɛyɛ me ho sɛ Ɔsorosoroni no.”<verse eid="ISA 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15"/>Nanso wɔde wo abɛto ɔda mu,</para>
  <para style="q2" vid="ISA 14:15">amoa donkudonku ase tɔnn.<verse eid="ISA 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16"/>Wɔn a wuhu wo no hwɛ wo haw,</para>
  <para style="q2" vid="ISA 14:16">wodwen nea ato wo no ho bisa se,</para>
  <para style="q1" vid="ISA 14:16">“Ɛnyɛ ɔbarima a ɔwosow asase</para>
  <para style="q2" vid="ISA 14:16">na ɔmaa ahenni ho popoe,<verse eid="ISA 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17"/>ɔbarima a ɔmaa wiase dan nweatam,</para>
  <para style="q2" vid="ISA 14:17">nea ɔdan ne nkuropɔn butuwii</para>
  <para style="q1" vid="ISA 14:17">na wamma ne nneduafo ankɔ wɔn nkyi no ni?”<verse eid="ISA 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18"/>Amanaman ahemfo no nyinaa wɔadeda wɔn</para>
  <para style="q2" vid="ISA 14:18">obiara wɔ ne da mu.<verse eid="ISA 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19"/>Nanso wɔapam wo afi wo da mu</para>
  <para style="q2" vid="ISA 14:19">te sɛ dubaa a wɔapo;</para>
  <para style="q1" vid="ISA 14:19">wɔde wɔn a wɔatotɔ akata wo so,</para>
  <para style="q2" vid="ISA 14:19">wɔn a wɔtɔɔ wɔ afoa ano,</para>
  <para style="q1" vid="ISA 14:19">wɔn a wosian kɔ abo amoa mu,</para>
  <para style="q2" vid="ISA 14:19">te sɛ funu a wɔatiatia so,<verse eid="ISA 14:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20"/>Wɔrensie wo nka wɔn ho,</para>
  <para style="q2" vid="ISA 14:20">efisɛ woasɛe wʼasase</para>
  <para style="q1" vid="ISA 14:20">na wakunkum wo nkurɔfo.</para>
  <para style="b" vid="ISA 14:20"/>
  <para style="b" vid="ISA 14:20"/>
  <para style="q1" vid="ISA 14:20">Otirimɔdenfo asefo no</para>
  <para style="q2" vid="ISA 14:20">wɔrenkae wɔn bio. Wo babarima renni wʼade sɛ ɔhene.<verse eid="ISA 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21"/>Siesie faako a wobekunkum ne mmabarima</para>
  <para style="q2" vid="ISA 14:21">wɔ wɔn agyanom bɔne nti;</para>
  <para style="q1" vid="ISA 14:21">ɛnsɛ sɛ wɔsɔre di asase no so</para>
  <para style="q2" vid="ISA 14:21">na wɔde wɔn nkuropɔn pete so.<verse eid="ISA 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22"/>“Mɛsɔre atia wɔn,”</para>
  <para style="q2" vid="ISA 14:22">Sɛnea Asafo <char style="nd">Awurade</char> se ni.</para>
  <para style="q1" vid="ISA 14:22">“Metwa ne din ne ne nkae,</para>
  <para style="q2" vid="ISA 14:22">ne mma ne ne nenanom afi Babilonia ho,”</para>
  <para style="q2" vid="ISA 14:22">sɛnea Asafo <char style="nd">Awurade</char> se ni.<verse eid="ISA 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23"/>“Mɛdan no ayɛ faako a mpatu wɔ</para>
  <para style="q2" vid="ISA 14:23">ne ɔwora;</para>
  <para style="q1" vid="ISA 14:23">mede ɔsɛeprae bɛpra no,”</para>
  <para style="q2" vid="ISA 14:23">sɛnea Asafo <char style="nd">Awurade</char> se ni.<verse eid="ISA 14:23"/></para>
  <para style="s1">Nkɔmhyɛ A Etia Asiria</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>Asafo <char style="nd">Awurade</char> aka ntam se,</para>
  <para style="q1" vid="ISA 14:24">“Nokware, sɛnea mahyehyɛ no, saa ara na ɛbɛyɛ,</para>
  <para style="q2" vid="ISA 14:24">na sɛnea masusuw no, ɛrensesa.<verse eid="ISA 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25"/>Mɛsɛe Asiria pasaa wɔ mʼasase so;</para>
  <para style="q2" vid="ISA 14:25">metiatia no so me mmepɔw so.</para>
  <para style="q1" vid="ISA 14:25">Obeyi ne konnua afi me nkurɔfo so,</para>
  <para style="q2" vid="ISA 14:25">na nʼadesoa nso afi wɔn so.”<verse eid="ISA 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26"/>Eyi ne nhyehyɛe a wɔayɛ ama wiase nyinaa;</para>
  <para style="q2" vid="ISA 14:26">eyi ne nsa a wɔateɛ wɔ aman nyinaa so.<verse eid="ISA 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27"/>Na sɛ Asafo <char style="nd">Awurade</char> ayɛ nʼadwene a hena na obesiw no kwan?</para>
  <para style="q2" vid="ISA 14:27">Na sɛ wateɛ ne nsa, hena na obesianka no?<verse eid="ISA 14:27"/></para>
  <para style="s1">Nkɔmhyɛ A Etia Filistifo</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>Saa adehu yi baa afe a ɔhene Ahas wui no:<verse eid="ISA 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29"/>Munnni ahurusi, mo Filistifo,</para>
  <para style="q2" vid="ISA 14:29">sɛ abaa a ɛbɔɔ mo no mu abubu;</para>
  <para style="q1" vid="ISA 14:29">saa ɔwɔ no ase na ahurutoa befi aba,</para>
  <para style="q2" vid="ISA 14:29">na nʼaba bɛyɛ ɔwɔ a ne ho yɛ hare na nʼano wɔ bɔre.<verse eid="ISA 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30"/>Ahiafo mu hiani benya didibea,</para>
  <para style="q2" vid="ISA 14:30">na mmɔborɔni bɛda asomdwoe mu.</para>
  <para style="q1" vid="ISA 14:30">Nanso wʼasefo de, mede ɔkɔm bɛtɔre wɔn ase;</para>
  <para style="q2" vid="ISA 14:30">ebekunkum wo nkae no.<verse eid="ISA 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31"/>Twa adwo, kurow pon! Su teɛ mu kuropɔn!</para>
  <para style="q2" vid="ISA 14:31">munguan, mo Filistifo!</para>
  <para style="q1" vid="ISA 14:31">Wusiw kumɔnn bi fi atifi fam reba,</para>
  <para style="q2" vid="ISA 14:31">na obiara ntwentwɛn ne nan ase wɔ wɔn mu.<verse eid="ISA 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ISA 14:32"/>Mmuae bɛn na wɔde bɛma</para>
  <para style="q2" vid="ISA 14:32">saa ɔman no ananmusifo?</para>
  <para style="q1" vid="ISA 14:32">“<char style="nd">Awurade</char> de Sion atim hɔ,</para>
  <para style="q2" vid="ISA 14:32">ne mu na nʼamanehunufo benya guankɔbea.”<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">Nkɔmhyɛ A Etia Moab</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>Adehu a ɛfa Moab ho:</para>
  <para style="q1" vid="ISA 15:1">Wɔasɛe Ar a ɛwɔ Moab</para>
  <para style="q2" vid="ISA 15:1">Da koro anadwo bi,</para>
  <para style="q1" vid="ISA 15:1">wɔasɛe Kir a ɛwɔ Moab</para>
  <para style="q2" vid="ISA 15:1">da koro anadwo bi!<note caller="+" style="f"><char style="fr" closed="false">15.1 </char><char style="ft" closed="false">Ar ne Kir yɛ Moabfo nkurow atitiriw abien.</char></note><verse eid="ISA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2"/>Dibon foro kɔ nʼasɔredan mu,</para>
  <para style="q2" vid="ISA 15:2">ɔkɔ ne sorɔnsorɔmmea kosu;</para>
  <para style="q2" vid="ISA 15:2">Moab twa adwo wɔ Nebo ne Medeba ho.</para>
  <para style="q1" vid="ISA 15:2">Wɔayi eti biara so nwi</para>
  <para style="q2" vid="ISA 15:2">na abogyesɛ biara nso wɔatwitwa.<verse eid="ISA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3"/>Wofurafura atweaatam wɔ mmɔnten so;</para>
  <para style="q2" vid="ISA 15:3">wɔ adan atifi ne ɔman ahyiae</para>
  <para style="q1" vid="ISA 15:3">wɔn nyinaa retwa adwo,</para>
  <para style="q2" vid="ISA 15:3">wɔdeda fam na wosu.<verse eid="ISA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4"/>Hesbon ne Eleale teɛ mu su,</para>
  <para style="q2" vid="ISA 15:4">wɔte wɔn nne kodu Yahas nohɔ.</para>
  <para style="q1" vid="ISA 15:4">Enti Moab mmarima akofo teɛ mu su,</para>
  <para style="q2" vid="ISA 15:4">na wɔbotobotow.<verse eid="ISA 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5"/>Midi Moab ho awerɛhow wɔ me koma mu;</para>
  <para style="q2" vid="ISA 15:5">nʼaguanfo guan kodu Soar,</para>
  <para style="q2" vid="ISA 15:5">ne Eglat Selisiya.</para>
  <para style="q1" vid="ISA 15:5">Wɔforo kɔ Luhit,</para>
  <para style="q2" vid="ISA 15:5">wɔrekɔ nyinaa na wɔresu;</para>
  <para style="q1" vid="ISA 15:5">Horonaim kwan so nso</para>
  <para style="q2" vid="ISA 15:5">wodi wɔn sɛe ho awerɛhow.<verse eid="ISA 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6"/>Nimrim nsuwansuwa ayoyow</para>
  <para style="q2" vid="ISA 15:6">na sare no ahyew</para>
  <para style="q1" vid="ISA 15:6">afifide nyinaa ayera</para>
  <para style="q2" vid="ISA 15:6">na ɛnkaa wura biara a ɛyɛ amono.<verse eid="ISA 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7"/>Enti ahonyade a wɔapɛ agu hɔ no</para>
  <para style="q2" vid="ISA 15:7">wɔsoa de kotwa mpampuro bon.<verse eid="ISA 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8"/>Wɔn nkekawmu gyigye wɔ Moab ahye so;</para>
  <para style="q2" vid="ISA 15:8">wɔn agyaadwotwa kodu Eglaim</para>
  <para style="q2" vid="ISA 15:8">na wɔn abubuwbɔ kodu Beer Elim.<verse eid="ISA 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9"/>Dimon nsu ayɛ mogya nko ara</para>
  <para style="q2" vid="ISA 15:9">nanso mɛkɔ so ne no adi</para>
  <para style="q1" vid="ISA 15:9">gyata bɛba Moab aguanfo so</para>
  <para style="q2" vid="ISA 15:9">ne wɔn a wɔbɛka asase no so no so.<verse eid="ISA 15:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1"/>Momfa nguantenmma sɛ sonkahiri</para>
  <para style="q2" vid="ISA 16:1">nkɔma asase no sodifo,</para>
  <para style="q1" vid="ISA 16:1">efi Sela fa nweatam no so,</para>
  <para style="q2" vid="ISA 16:1">kɔka Ɔbabea Sion bepɔw no so.<verse eid="ISA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2"/>Te sɛ nnomaa a wɔaka wɔn afi berebuw mu</para>
  <para style="q2" vid="ISA 16:2">na wotu nenam wim no</para>
  <para style="q1" vid="ISA 16:2">saa na Moabfo mmea te</para>
  <para style="q2" vid="ISA 16:2">wɔ Arnon asutwabea.<verse eid="ISA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3"/>Moab ka se, “Munsi mo adwene pi,</para>
  <para style="q2" vid="ISA 16:3">monna mo gyinaesi adi.</para>
  <para style="q1" vid="ISA 16:3">Monyɛ mo sunsuma sɛ anadwo,</para>
  <para style="q2" vid="ISA 16:3">awia ketee.</para>
  <para style="q1" vid="ISA 16:3">Momfa aguanfo no nhintaw</para>
  <para style="q2" vid="ISA 16:3">munnyi atubrafo no mma.<verse eid="ISA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4"/>Momma Moabfo aguanfo no ne mo ntena;</para>
  <para style="q2" vid="ISA 16:4">monyɛ wɔn bammɔ wɔ ɔsɛefo no ho.”</para>
  <para style="b" vid="ISA 16:4"/>
  <para style="q1" vid="ISA 16:4">Ɔhyɛsoni no bɛba nʼawie</para>
  <para style="q2" vid="ISA 16:4">na adesɛe to betwa;</para>
  <para style="q2" vid="ISA 16:4">opoobɔfo no bɛyera wɔ asase no so.<verse eid="ISA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5"/>Ɔdɔ mu na Onyankopɔn besi ahengua bi;</para>
  <para style="q2" vid="ISA 16:5">ɔbarima bi de nokwaredi bɛtena so,</para>
  <para style="q2" vid="ISA 16:5">obi a ofi Dawid fi,</para>
  <para style="q1" vid="ISA 16:5">nea atemmu mu no ɔpɛ atɛntrenee</para>
  <para style="q2" vid="ISA 16:5">na ɔntwentwɛn adetreneeyɛ ho.<verse eid="ISA 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6"/>Yɛate Moab ahantan a ɔyɛ,</para>
  <para style="q2" vid="ISA 16:6">nʼani a atra ne ntɔn mmoroso,</para>
  <para style="q1" vid="ISA 16:6">nʼahomaso ne nʼasoɔden</para>
  <para style="q2" vid="ISA 16:6">nanso hwee nni nʼahomaso no mu.<verse eid="ISA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7"/>Enti Moabfo twa adwo,</para>
  <para style="q2" vid="ISA 16:7">wɔbɔ mu su ma Moab.</para>
  <para style="q1" vid="ISA 16:7">Wodi awerɛhow na wɔbɔ abubuw,</para>
  <para style="q2" vid="ISA 16:7">ma Kir Hereset bobe aba ɔfam.<verse eid="ISA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8"/>Hesbon mfuw no hyew,</para>
  <para style="q2" vid="ISA 16:8">Sibma bobe mfuw nso saa ara.</para>
  <para style="q1" vid="ISA 16:8">Aman sodifo no atiatia bobe papa no so,</para>
  <para style="q2" vid="ISA 16:8">nea kan na wɔde kɔ Yaser</para>
  <para style="q1" vid="ISA 16:8">na ɛtrɛtrɛw kɔ nweatam so no.</para>
  <para style="q2" vid="ISA 16:8">Wɔn mman trɛtrɛw kɔka mpoano pɛɛ.<verse eid="ISA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9"/>Enti misu sɛnea Yaser su,</para>
  <para style="q2" vid="ISA 16:9">de ma Sibma bobe mfuw.</para>
  <para style="q1" vid="ISA 16:9">Hesbon ne Eleale,</para>
  <para style="q2" vid="ISA 16:9">mede misu fɔw mo!</para>
  <para style="q1" vid="ISA 16:9">Mo aduaba a abere ho ahurusi</para>
  <para style="q2" vid="ISA 16:9">ne otwabere de no aka.<verse eid="ISA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10"/>Ahosɛpɛw ne anigye nni mfikyifuw no mu;</para>
  <para style="q2" vid="ISA 16:10">obiara nto dwom, na ɔnteɛteɛ mu wɔ bobeturo mu;</para>
  <para style="q1" vid="ISA 16:10">obiara nkyi nsa wɔ nsakyiamoa so,</para>
  <para style="q2" vid="ISA 16:10">efisɛ mede nteɛteɛmu aba nʼawiei.<verse eid="ISA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11"/>Misi apini wɔ me koma mu wɔ Moab ho</para>
  <para style="q2" vid="ISA 16:11">te sɛ sankuten so kwadwom;</para>
  <para style="q2" vid="ISA 16:11">na me yam hyehye me ma Kir Hereset.<verse eid="ISA 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12"/>Sɛ Moab kɔ ne sorɔnsorɔmmea a</para>
  <para style="q2" vid="ISA 16:12">ɔhaw ne ho kwa;</para>
  <para style="q1" vid="ISA 16:12">sɛ ɔkɔ nʼabosonnan mu kɔbɔ mpae a,</para>
  <para style="q2" vid="ISA 16:12">ɛrenkosi hwee.<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>Eyi ne asɛm a <char style="nd">Awurade</char> aka dedaw afa Moab ho. <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>Nanso mprempren <char style="nd">Awurade</char> ka se, “Mfe abiɛsa mu, sɛnea akoa a nhyehyɛe kyekyere no no bebu nna no, wobebu Moab anuonyam ne ne nkurɔfo dodow no nyinaa animtiaa, na ne nkae no bɛyɛ kakraa bi a wonni ahoɔden.”<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">Nkɔmhyɛ A Etia Damasko</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>Nkɔmhyɛ a ɛfa Damasko ho:</para>
  <para style="q1" vid="ISA 17:1">“Hwɛ, Damasko renyɛ kuropɔn bio</para>
  <para style="q2" vid="ISA 17:1">ɛbɛdan ayɛ nnwiriwii siw.<verse eid="ISA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2"/>Aroer nkuropɔn bɛdan amamfo</para>
  <para style="q2" vid="ISA 17:2">na wɔagyaw ama nguankuw ama wɔadeda hɔ,</para>
  <para style="q2" vid="ISA 17:2">a obiara renyi wɔn hu.<verse eid="ISA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3"/>Kuropɔn a wɔabɔ ho ban bɛyera wɔ Efraim,</para>
  <para style="q2" vid="ISA 17:3">adehyetumi nso befi Damasko;</para>
  <para style="q1" vid="ISA 17:3">Aram nkae bɛyɛ</para>
  <para style="q2" vid="ISA 17:3">Israelfo anuonyam,”</para>
  <para style="q2" vid="ISA 17:3">Sɛnea Asafo <char style="nd">Awurade</char> se ni.<verse eid="ISA 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4"/>“Da no Yakob anuonyam bɛpa;</para>
  <para style="q2" vid="ISA 17:4">na ne mu srade bɛsa.<verse eid="ISA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5"/>Ɛbɛyɛ sɛnea nnɔbaetwafo twa aburow a egyina afuw so</para>
  <para style="q2" vid="ISA 17:5">na ɔde ne nsa penpan,</para>
  <para style="q1" vid="ISA 17:5">sɛ bere a obi redi mpɛpɛwa</para>
  <para style="q2" vid="ISA 17:5">wɔ Refaim Bon mu.<verse eid="ISA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6"/>Nanso mpɛpɛwa no mu bi bɛka,</para>
  <para style="q2" vid="ISA 17:6">sɛnea wɔwosow ngodua a ɛyɛ no,</para>
  <para style="q1" vid="ISA 17:6">ɛka aba no abien anaa abiɛsa wɔ atifi mman no so,</para>
  <para style="q2" vid="ISA 17:6">ne anan anaa anum wɔ mman a ɛso no so,”</para>
  <para style="q2" vid="ISA 17:6">sɛnea <char style="nd">Awurade</char>, Israel Nyankopɔn se ni.<verse eid="ISA 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7"/>Saa da no, nnipa de wɔn ani bɛto wɔn Yɛfo so</para>
  <para style="q2" vid="ISA 17:7">na wɔadan wɔn ani ahwɛ Israel Ɔkronkronni no.<verse eid="ISA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8"/>Wɔremfa wɔn ho nto afɔremuka a</para>
  <para style="q2" vid="ISA 17:8">ɛyɛ wɔn nsa ano adwuma no so,</para>
  <para style="q1" vid="ISA 17:8">na wobebu Asera nnua ne nnuhuam afɔremuka</para>
  <para style="q2" vid="ISA 17:8">a wɔde wɔn nsateaa ayɛ no animtiaa.<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>Da no wɔn nkuropɔn a ɛwɔ bammɔ dennen, a Israelfo nti wogyaw hɔ no, bɛyɛ sɛ mmeaemmeae a wɔagyaw ama nnɔtɔ ne nwura. Ne nyinaa bɛda mpan.<verse eid="ISA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10"/>Mo werɛ afi Onyankopɔn, mo Agyenkwa,</para>
  <para style="q2" vid="ISA 17:10">na monkaee Ɔbotan no, mo abandennen no.</para>
  <para style="q1" vid="ISA 17:10">Enti ɛwɔ mu sɛ mopɛ nnua papa</para>
  <para style="q2" vid="ISA 17:10">na mudua bobe a moatɔ afi amannɔne,<verse eid="ISA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11"/>ɛwɔ mu, da a muduae no, moma enyinii</para>
  <para style="q2" vid="ISA 17:11">anɔpa a muduae no, moma eguu nhwiren,</para>
  <para style="q1" vid="ISA 17:11">nanso otwa no renyɛ hwee sɛ</para>
  <para style="q2" vid="ISA 17:11">ɔyare ne ɔyaw a wontumi nsa.<verse eid="ISA 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12"/>Nnome nka aman dodow a wohuru so no,</para>
  <para style="q2" vid="ISA 17:12">wohuru so te sɛ po a ɛrebɔ asorɔkye!</para>
  <para style="q1" vid="ISA 17:12">Nnome nka nnipa dodow a wɔworo so,</para>
  <para style="q2" vid="ISA 17:12">wɔworo so sɛ asu akɛse!<verse eid="ISA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13"/>Ɛwɔ mu, nnipa dodow woro so te sɛ, asu a ɛresen mmirika so,</para>
  <para style="q2" vid="ISA 17:13">sɛ ɔka wɔn anim a woguan kɔ akyirikyiri,</para>
  <para style="q1" vid="ISA 17:13">te sɛ ntɛtɛ a mframa bɔ gu wɔ bepɔw so</para>
  <para style="q2" vid="ISA 17:13">te sɛ nweatam so nwura a mframaden rebɔ no.<verse eid="ISA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14"/>Anwummere, wɔbɔ yɛn hu awerɛfiri mu</para>
  <para style="q2" vid="ISA 17:14">ansa na ade bɛkyɛ no na wɔkɔ dedaw!</para>
  <para style="q1" vid="ISA 17:14">wɔn a wɔfow yɛn nneɛma,</para>
  <para style="q2" vid="ISA 17:14">ne wɔn a wɔbɔ yɛn korɔn kyɛfa ni.<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">Nkɔmhyɛ A Etia Kus</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1"/>Due asase a ntaban nnyigyei wɔ so</para>
  <para style="q2" vid="ISA 18:1">wɔ Kus nsubɔnten ho,<verse eid="ISA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2"/>ɔsoma ananmusifo a wɔnam po so</para>
  <para style="q2" vid="ISA 18:2">wɔde paparɔso akorow fa nsu ani.</para>
  <para style="b" vid="ISA 18:2"/>
  <para style="q1" vid="ISA 18:2">Monkɔ, asomafo ahoɔharefo,</para>
  <para style="q1" vid="ISA 18:2">monkɔ nnipa a wɔwoware na wɔn honam yɛ trontrom,</para>
  <para style="q2" vid="ISA 18:2">nnipa a wɔn ho yɛ hu wɔ mmaa nyinaa,</para>
  <para style="q1" vid="ISA 18:2">anuɔdenfo man a yɛnte wɔn kasa,</para>
  <para style="q2" vid="ISA 18:2">na nsubɔnten akyekyɛ nʼasase mu no nkyɛn.<verse eid="ISA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3"/>Mo wiasefo nyinaa,</para>
  <para style="q2" vid="ISA 18:3">mo a motete asase so,</para>
  <para style="q1" vid="ISA 18:3">sɛ wɔma frankaa so wɔ bepɔw no so a,</para>
  <para style="q2" vid="ISA 18:3">mubehu</para>
  <para style="q1" vid="ISA 18:3">sɛ wɔhyɛn torobɛnto a,</para>
  <para style="q2" vid="ISA 18:3">mobɛte.<verse eid="ISA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4"/>Sɛɛ na <char style="nd">Awurade</char> ka kyerɛ me,</para>
  <para style="q2" vid="ISA 18:4">“Mɛtena mʼatenae, na mahwɛ biribiara dinn.</para>
  <para style="q1" vid="ISA 18:4">Mɛyɛ dinn te sɛ owia a ɛrebɔ,</para>
  <para style="q2" vid="ISA 18:4">te sɛ bɔ a esi wɔ otwabere mu.”<verse eid="ISA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5"/>Ennya nnuu twabere, a nhwiren bere atwam no</para>
  <para style="q2" vid="ISA 18:5">na nhwiren no anyin adan bobe no,</para>
  <para style="q1" vid="ISA 18:5">wɔde asosɔw betwitwa mman no,</para>
  <para style="q2" vid="ISA 18:5">wobetwitwa mman a ɛredennan no akɔ.<verse eid="ISA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6"/>Wobegyaw wɔn nyinaa ama bepɔw so nnomaa</para>
  <para style="q2" vid="ISA 18:6">a wokum mmoa we ne wuram mmoa;</para>
  <para style="q1" vid="ISA 18:6">nnomaa no bedi wɔn nam wɔ ahuhuru bere mu.</para>
  <para style="q2" vid="ISA 18:6">Wuram mmoa bɛwe wɔn nam wɔ awɔw bere mu.<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>Saa bere no, wɔde akyɛde bɛbrɛ Asafo <char style="nd">Awurade</char></para>
  <para style="q1" vid="ISA 18:7">ebefi nnipa a wɔwoware na wɔn honam yɛ trontrom hɔ,</para>
  <para style="q2" vid="ISA 18:7">nnipa a wɔn ho yɛ hu wɔ mmaa nyinaa,</para>
  <para style="q1" vid="ISA 18:7">aniɔdenfo man a yɛnte wɔn kasa,</para>
  <para style="q2" vid="ISA 18:7">na nsubɔnten akyekyɛ nʼasase mu,</para>
  <para style="m" vid="ISA 18:7">wɔde akyɛde bɛba Sion Bepɔw so, faako a Asafo <char style="nd">Awurade</char> din atim no.<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">Nkɔmhyɛ A Ɛfa Misraim</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>Nkɔmhyɛ a ɛfa Misraim ho:</para>
  <para style="q1" vid="ISA 19:1">Monhwɛ! <char style="nd">Awurade</char> nam ahoɔhare omununkum mu</para>
  <para style="q2" vid="ISA 19:1">na ɔreba Misraim.</para>
  <para style="q1" vid="ISA 19:1">Misraim ahoni ho popo wɔ nʼanim,</para>
  <para style="q2" vid="ISA 19:1">na Misraimfo koma botow wɔ wɔn mu.<verse eid="ISA 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2"/>“Mɛma Misraimfo atwa wɔn ho ako,</para>
  <para style="q2" vid="ISA 19:2">onua bɛko atia onua,</para>
  <para style="q2" vid="ISA 19:2">ɔyɔnko atia ɔyɔnko,</para>
  <para style="q2" vid="ISA 19:2">kuropɔn atia kuropɔn,</para>
  <para style="q2" vid="ISA 19:2">ahenni atia ahenni.<verse eid="ISA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3"/>Misraimfo no rennya abodwo,</para>
  <para style="q2" vid="ISA 19:3">na mɛma wɔn nhyehyɛe ayɛ ɔkwa.</para>
  <para style="q1" vid="ISA 19:3">Wɔbɛkɔ abisa wɔ ahoni, ne awufo ahonhom,</para>
  <para style="q2" vid="ISA 19:3">samanfrɛfo ne nkonyaayifo nkyɛn.<verse eid="ISA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4"/>Mede Misraim bɛhyɛ</para>
  <para style="q2" vid="ISA 19:4">owura tirimuɔdenfo tumi ase,</para>
  <para style="q1" vid="ISA 19:4">na ɔhene a ɔyɛ keka bedi wɔn so,”</para>
  <para style="q2" vid="ISA 19:4">sɛnea Asafo <char style="nd">Awurade</char> se ni.<verse eid="ISA 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5"/>Nsubɔnten mu nsu bɛyow,</para>
  <para style="q2" vid="ISA 19:5">na konkɔn bɛwo ayɛ wosee.<verse eid="ISA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6"/>Nsuka beyi hua;</para>
  <para style="q2" vid="ISA 19:6">na nsuwa a ɛwɔ Misraim bɛtwe na ayow.</para>
  <para style="q1" vid="ISA 19:6">Demmire ne sare bekisakisa,<verse eid="ISA 19:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7"/>Nil nsunoa nnua nso,</para>
  <para style="q2" vid="ISA 19:7">nea ɛwɔ asubɔnten no abɔe no.</para>
  <para style="q1" vid="ISA 19:7">Nil nsunoa so mfuw nyinaa</para>
  <para style="q2" vid="ISA 19:7">bɛwo wosee na awu koraa.<verse eid="ISA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8"/>Apopofo nyinaa besi apini atwa adwo,</para>
  <para style="q2" vid="ISA 19:8">wɔn a wɔto darewa wɔ Nil mu nyinaa;</para>
  <para style="q1" vid="ISA 19:8">wɔn a wogu asau wɔ nsu no so</para>
  <para style="q2" vid="ISA 19:8">bedi awerɛhow.<verse eid="ISA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9"/>Wɔn a wɔde asaawa yɛ adwuma aba mu bebu,</para>
  <para style="q2" vid="ISA 19:9">wɔn a wɔnwen nwera no anidaso bɛsa.<verse eid="ISA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10"/>Wɔn a wɔyɛ ntama ho adwuma bɛyɛ mmɔbɔ</para>
  <para style="q2" vid="ISA 19:10">na wɔn a wogye akatua nyinaa koma bɛbotow.<verse eid="ISA 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11"/>Soan adwumayɛfo nka hwee sɛ nkwaseafo;</para>
  <para style="q2" vid="ISA 19:11">Farao agyinatufo anyansafo ma afotu bɔne.</para>
  <para style="q1" vid="ISA 19:11">Ɛbɛyɛ dɛn na woaka akyerɛ Farao se,</para>
  <para style="q2" vid="ISA 19:11">“Meyɛ anyansafo no mu baako,</para>
  <para style="q2" vid="ISA 19:11">tete ahemfo no kyidifo?”<verse eid="ISA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12"/>Wʼanyansafo no wɔ he afei?</para>
  <para style="q2" vid="ISA 19:12">Ma wɔnkyerɛ wo na ma wonhu</para>
  <para style="q1" vid="ISA 19:12">nea Asafo <char style="nd">Awurade</char></para>
  <para style="q2" vid="ISA 19:12">ahyehyɛ atia Misraim.<verse eid="ISA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13"/>Soan adwumayɛfo abɛyɛ nkwaseafo,</para>
  <para style="q2" vid="ISA 19:13">wɔadaadaa Memfis<note caller="+" style="f"><char style="fr" closed="false">19.13 </char><char style="ft" closed="false">Na Memfis yɛ Misraim kuropɔn.</char></note> akwankyerɛfo</para>
  <para style="q1" vid="ISA 19:13">ne nnipa no ntuano</para>
  <para style="q2" vid="ISA 19:13">ama Misraim afom kwan.<verse eid="ISA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14"/>
    <char style="nd">Awurade</char> ahwie</para>
  <para style="q2" vid="ISA 19:14">anisobiri honhom agu wɔn mu;</para>
  <para style="q1" vid="ISA 19:14">wɔma Misraim tɔ ntintan wɔ biribiara a ɔyɛ mu,</para>
  <para style="q2" vid="ISA 19:14">te sɛ nea ɔsabowfo tɔ ntintan wɔ ne fe ho no.<verse eid="ISA 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15"/>Biribiara nni hɔ a Misraim betumi ayɛ,</para>
  <para style="q2" vid="ISA 19:15">sɛ eti anaa ɛto, abɛ anaa demmire.<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>Saa da no, Misraimfo bɛyɛ sɛ mmea, Asafo <char style="nd">Awurade</char> nsa a wama so atia wɔn no bɛma wɔn abɔ hu na wɔn ho apopo. <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>Na Yuda asase no bɛma Misraimfo abɔ hu, obiara a ɔbɛte Yuda din no besuro, esiane nea Asafo <char style="nd">Awurade</char> rehyehyɛ atia wɔn nti.<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>Saa da no, Misraim nkurɔpɔn anum bɛka Kanaan kasa na wɔaka Asafo <char style="nd">Awurade</char> ntam. Wɔbɛfrɛ wɔn mu ɔbaako se Ɔsɛe Kuropɔn.<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>Saa da no, wobesi afɔremuka wɔ Misraim mfimfini ama <char style="nd">Awurade</char>, na wɔasi nkaedum wɔ ne hye so nso ama <char style="nd">Awurade</char>. <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>Ɛbɛyɛ nsɛnkyerɛnne ne adansede ama Asafo <char style="nd">Awurade</char> wɔ Misraim asase so. Sɛ wɔn nhyɛsofo nti wosu frɛ <char style="nd">Awurade</char> a, ɔbɛsoma ogyefo ne bammɔni, na obegye wɔn. <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>Enti <char style="nd">Awurade</char> bɛda ne ho adi akyerɛ Misraimfo, na saa da no wobehu <char style="nd">Awurade</char>. Wɔde afɔrebɔ ne nnuan bɛsom, wɔbɛhyɛ <char style="nd">Awurade</char> bɔ, na wɔadi so. <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/><char style="nd">Awurade</char> de ɔyaredɔm bɛbɔ Misraim; ɔde bɛbɔ wɔn na wasa wɔn yare. Wɔbɛdan akɔ <char style="nd">Awurade</char> nkyɛn, na obetie wɔn sufrɛ, na wasa wɔn yare.<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>Saa da no, ɔtempɔn befi Misraim ne Asiria. Asiriafo bɛkɔ Misraim na Misraimfo akɔ Asiria. Misraimfo ne Asiriafo bɛbɔ mu asom. <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>Saa da no Israel bɛto Misraim ne Asiria so sɛ abiɛsa, a ayɛ nhyira wɔ asase so. <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>Na Asafo <char style="nd">Awurade</char> behyira wɔn, aka se, “Nhyira nka Misraim, me nkurɔfo, Asiria me nsa ano adwuma ne Israel mʼagyapade.”<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">Nkɔmhyɛ A Etia Misraim Ne Kus</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>Afe a Asiriahene Sargon somaa ne man no sahene kɔɔ Asdod kɔtow hyɛɛ no so na odii ne so nkonim no, <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>saa bere no <char style="nd">Awurade</char> faa Yesaia, Amos babarima so kasae se, “Yi atweaatam no fi wo ho ne mpaboa no fi wo nan ase.” Ɔyɛɛ saa de adagyaw a nʼanan nso sisi fam dii akɔneaba.<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>Na <char style="nd">Awurade</char> kae se, “Sɛnea me somfo Yesaia de adagyaw anantew mfe abiɛsa a nʼanan nso sisi fam yi de, ayɛ ɔhaw nsɛnkyerɛnne a etia Misraim ne Kus no, <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>saa ara na Asiriahene bedi Misraim nneduafo ne Kus nnommum a wɔdeda adagyaw na wɔn nan sisi fam, mmabun ne mpanyin a wɔn to deda so no anim, de agu Misraim anim ase. <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>Wɔn a wɔde wɔn ho too Kus so, na wɔde Misraim hoahoaa wɔn ho no besuro na wɔn ani awu. <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>Saa da no nnipa a wɔtete mpoano ha bɛka se, ‘Monhwɛ asɛm a ato wɔn a yɛde yɛn ho too wɔn so no, wɔn a yeguan kɔɔ wɔn nkyɛn kɔpɛɛ mmoa sɛ wobegye yɛn afi Asiriahene nsam no! Yɛbɛyɛ dɛn na yɛaguan?’ ”<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">Nkɔmhyɛ A Etia Babilonia</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>Nkɔmhyɛ a ɛfa Nweatam a ɛda Po ho no ho:</para>
  <para style="q1" vid="ISA 21:1">Te sɛ mfɛtɛ a ɛbɔ fa anafo fam asase so no,</para>
  <para style="q2" vid="ISA 21:1">ɔtamfo bi fi nweatam so reba,</para>
  <para style="q2" vid="ISA 21:1">ofi asase a ɛyɛ ahuabɔbrim so.<verse eid="ISA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2"/>Wɔde adaeso a ɛyɛ nwonwa akyerɛ me:</para>
  <para style="q1" vid="ISA 21:2">Ɔfatwafo di huammɔ, ɔfomfo fa asade.</para>
  <para style="q1" vid="ISA 21:2">Elam tow hyɛ so! Media bɔ pampim!</para>
  <para style="q2" vid="ISA 21:2">Mede apinisi a ɔde bae no nyinaa bɛba awiei.<verse eid="ISA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3"/>Eyi ama ɔyaw bi abɛhyɛ me mu,</para>
  <para style="q2" vid="ISA 21:3">ɔyaw aka me, te sɛ ɔbea a awo aka no;</para>
  <para style="q1" vid="ISA 21:3">nea metee no nti mintumi nnyina me nan so,</para>
  <para style="q2" vid="ISA 21:3">nea mihu no ama me ho adwiriw me.<verse eid="ISA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4"/>Me koma bɔ kitirikitiri,</para>
  <para style="q2" vid="ISA 21:4">ehu ma me ho popo;</para>
  <para style="q1" vid="ISA 21:4">na hann a mepɛɛ sɛ mihu no</para>
  <para style="q2" vid="ISA 21:4">abɛyɛ aninyanne ama me.<verse eid="ISA 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5"/>Wɔto pon,</para>
  <para style="q2" vid="ISA 21:5">wɔde kuntu akɛtɛ sesɛw fam,</para>
  <para style="q2" vid="ISA 21:5">wodidi, na wɔnom!</para>
  <para style="q1" vid="ISA 21:5">Monsɔre, mo asraafo mpanyimfo,</para>
  <para style="q2" vid="ISA 21:5">momfa ngo nsrasra mo akatabo ho!<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>Sɛɛ na Awurade ka kyerɛ me:</para>
  <para style="q1" vid="ISA 21:6">“Fa ɔwɛmfo kogyina hɔ</para>
  <para style="q2" vid="ISA 21:6">na ɔnka nea ohu nkyerɛ wo.<verse eid="ISA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7"/>Sɛ ohu nteaseɛnam</para>
  <para style="q2" vid="ISA 21:7">ne apɔnkɔ akuwakuw,</para>
  <para style="q1" vid="ISA 21:7">wɔn a wɔtete mfurum so</para>
  <para style="q2" vid="ISA 21:7">ne wɔn a wɔtete yoma so a,</para>
  <para style="q1" vid="ISA 21:7">ɔnwɛn nʼaso,</para>
  <para style="q2" vid="ISA 21:7">nwɛn no pa ara.”<verse eid="ISA 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 21:8"/>Na ɔwɛmfo no teɛɛ mu se,</para>
  <para style="q2" vid="ISA 21:8">“Me wura, da biara migyina ɔwɛn aban no so</para>
  <para style="q1" vid="ISA 21:8">Anadwo biara, migyina hɔ.<verse eid="ISA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9"/>Hwɛ, ɔbarima bi a ɔte teaseɛnam mu na ɔreba yi</para>
  <para style="q2" vid="ISA 21:9">ɔne apɔnkɔ dɔm.</para>
  <para style="q1" vid="ISA 21:9">Na ɔwɛmfo no kae se,</para>
  <para style="q2" vid="ISA 21:9">‘Babilon ahwe ase, wahwe ase!</para>
  <para style="q1" vid="ISA 21:9">Nʼanyame ne nʼahoni nyinaa</para>
  <para style="q2" vid="ISA 21:9">abubu agu fam!’ ”<verse eid="ISA 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10"/>Ao, me nkurɔfo a, wɔadwerɛw mo wɔ awiporowbea ase</para>
  <para style="q2" vid="ISA 21:10">meka nea mate kyerɛ mo</para>
  <para style="q1" vid="ISA 21:10">nea efi Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 21:10">nea efi Israel Nyankopɔn hɔ.<verse eid="ISA 21:10"/></para>
  <para style="s1">Nkɔmhyɛ A Etia Edom</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>Adehu a ɛfa Duma ho:</para>
  <para style="q1" vid="ISA 21:11">Obi frɛ me fi Seir,</para>
  <para style="q2" vid="ISA 21:11">“Ɔwɛmfo, bere bɛn na ade bɛkyɛ?</para>
  <para style="q2" vid="ISA 21:11">Ɔwɛmfo, aka nnɔnhwerew ahe ansa na ade akye?”<verse eid="ISA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12"/>Ɔwɛmfo no bua se,</para>
  <para style="q2" vid="ISA 21:12">“Ade rekye, nanso ade bɛsa.</para>
  <para style="q1" vid="ISA 21:12">Sɛ wubebisa bio a</para>
  <para style="q2" vid="ISA 21:12">san bra bebisa.”<verse eid="ISA 21:12"/></para>
  <para style="s1">Nkɔmhyɛ A Etia Arabia</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>Adehu a ɛfa Arabia ho:</para>
  <para style="q1" vid="ISA 21:13">Mo Dedan akwantufo a</para>
  <para style="q2" vid="ISA 21:13">mosoɛ wɔ Arabia adɔtɔ ase,<verse eid="ISA 21:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14"/>Momfa nsu mmrɛ wɔn a osukɔm de wɔn;</para>
  <para style="q1" vid="ISA 21:14">mo a motete Tema,</para>
  <para style="q2" vid="ISA 21:14">mommrɛ aguanfo no aduan.<verse eid="ISA 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15"/>Woguan fi afoa a watwe</para>
  <para style="q2" vid="ISA 21:15">tadua a wɔakuntun mu</para>
  <para style="q1" vid="ISA 21:15">ne ɔko a egyina mu ano.<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>Sɛɛ na Awurade ka kyerɛ me, “Afe baako mu, sɛnea ɔsomfo a wayɛ nhyehyɛe bebubu nna no, Kedar kɛseyɛ to betwa. <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>Na agyantowfo a wɔbɛka ne Kedar akofo bɛyɛ kakraa bi.” Nea <char style="nd">Awurade</char>, Israel Nyankopɔn, aka ni.<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">Nkɔmhyɛ A Ɛfa Yerusalem Ho</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>Nkɔmhyɛ a etia Anisoadehu Bon no:</para>
  <para style="q1" vid="ISA 22:1">Dɛn na ɛhaw mo mprempren,</para>
  <para style="q2" vid="ISA 22:1">a mo nyinaa aforo kɔ adan atifi yi,<verse eid="ISA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2"/>kurow a basabasayɛ ahyɛ no ma,</para>
  <para style="q2" vid="ISA 22:2">huuyɛ ne ahosɛpɛw kuropɔn?</para>
  <para style="q1" vid="ISA 22:2">Ɛnyɛ afoa ano na wʼatɔfo hweree wɔn nkwa,</para>
  <para style="q2" vid="ISA 22:2">na wɔanwuwu wɔ ɔko ano nso.<verse eid="ISA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3"/>Mo akannifo nyinaa abɔ mu aguan;</para>
  <para style="q2" vid="ISA 22:3">wɔamfa tadua ankyekye wɔn.</para>
  <para style="q1" vid="ISA 22:3">Mo a wɔkyeree mo nyinaa wɔfaa mo nneduafo</para>
  <para style="q2" vid="ISA 22:3">mo a muguan wɔ bere a na atamfo no wɔ akyirikyiri.<verse eid="ISA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4"/>Enti mekae se, “Mumfi me so</para>
  <para style="q2" vid="ISA 22:4">na mintwa adwo.</para>
  <para style="q1" vid="ISA 22:4">Monnkyekye me werɛ</para>
  <para style="q2" vid="ISA 22:4">wɔ me nkurɔfo sɛe ho.”<verse eid="ISA 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5"/>Awurade, Asafo <char style="nd">Awurade</char> wɔ da bi</para>
  <para style="q2" vid="ISA 22:5">ma huuyɛ, ntiatiaso ne ehu</para>
  <para style="q2" vid="ISA 22:5">wɔ Anisoadehu Bon no mu,</para>
  <para style="q1" vid="ISA 22:5">da a wɔde bubu afasu</para>
  <para style="q2" vid="ISA 22:5">na wɔde su kyerɛ mmepɔw.<verse eid="ISA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6"/>Elam fa bɛmma no</para>
  <para style="q2" vid="ISA 22:6">ka ne nteaseɛnamkafo ne apɔnkɔ ho;</para>
  <para style="q2" vid="ISA 22:6">Kir ama kyɛm no so.<verse eid="ISA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7"/>Nteaseɛnam ayɛ mo bon fɛfɛ no ma,</para>
  <para style="q2" vid="ISA 22:7">na wɔde apɔnkɔsotefo agyinagyina kuropɔn apon no ano.<verse eid="ISA 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8"/>Wɔayi Yuda ho bammɔ no.</para>
  <para style="q2" vid="ISA 22:8">Na da no wode wʼani too</para>
  <para style="q2" vid="ISA 22:8">akode a ɛwɔ Kwae mu Ahemfi no so;<verse eid="ISA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9"/>wuhuu sɛ Dawid Kuropɔn no,</para>
  <para style="q2" vid="ISA 22:9">akwan bebree deda ne bammɔ mu</para>
  <para style="q1" vid="ISA 22:9">woboaa nsu ano</para>
  <para style="q2" vid="ISA 22:9">wɔ Ase Abura mu.<verse eid="ISA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10"/>Wokan adan a ɛwɔ Yerusalem no</para>
  <para style="q2" vid="ISA 22:10">na wudwiriw afi de boaa ɔfasu no ahoɔden.<verse eid="ISA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11"/>Woyɛɛ nsukorae wɔ afasu abien no ntam</para>
  <para style="q2" vid="ISA 22:11">maa nsu a ɛwɔ Abura Dedaw mu no,</para>
  <para style="q1" vid="ISA 22:11">nanso woanhwehwɛ Onipa ko a ɔyɛe,</para>
  <para style="q2" vid="ISA 22:11">na woammu Onipa a ɔhyehyɛe dedaada no.<verse eid="ISA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12"/>Awurade, Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 22:12">frɛɛ wo saa da no</para>
  <para style="q1" vid="ISA 22:12">sɛ su na twa adwo,</para>
  <para style="q2" vid="ISA 22:12">sɛ yi wo tinwi na fura atweaatam.<verse eid="ISA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13"/>Nanso hwɛ, anigye ne ahosɛpɛw wɔ hɔ;</para>
  <para style="q2" vid="ISA 22:13">wokunkum anantwi ne nguan;</para>
  <para style="q2" vid="ISA 22:13">wɔwe nam na wɔbow nsa!</para>
  <para style="q1" vid="ISA 22:13">Wɔka se, “Momma yennidi na yɛnnom,</para>
  <para style="q2" vid="ISA 22:13">efisɛ, ɔkyena yebewu!”<verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>Awurade, Asafo <char style="nd">Awurade</char> ayi me asotiw se, “Wɔremfa saa bɔne yi nkyɛ wo da kosi wo wuda,” sɛnea Awurade, Asafo <char style="nd">Awurade</char> se ni.<verse eid="ISA 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>Sɛɛ na Awurade, Asafo <char style="nd">Awurade</char> se,</para>
  <para style="q1" vid="ISA 22:15">“Kɔ, kɔka kyerɛ saa ɔsomfo yi,</para>
  <para style="q2" vid="ISA 22:15">Sebna a, ɔhwɛ ahemfi no so se,<verse eid="ISA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16"/>Dɛn na woreyɛ wɔ ha na hena na ɔmaa wo kwan</para>
  <para style="q2" vid="ISA 22:16">sɛ bɔ wo da wɔ ha,</para>
  <para style="q1" vid="ISA 22:16">worebɔ wo da wɔ baabi a ɛkorɔn</para>
  <para style="q2" vid="ISA 22:16">na woretwa wo homebea wɔ ɔbotan mu?<verse eid="ISA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17"/>“Hwɛ yiye, na <char style="nd">Awurade</char> rebeso wo mu den</para>
  <para style="q2" vid="ISA 22:17">atow wo akyene, wo ɔhoɔdenfo.<verse eid="ISA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18"/>Ɔbɛbobɔw wo, ama woayɛ kurukuruwa,</para>
  <para style="q1" vid="ISA 22:18">na watow wo akyene ɔman kɛse bi so</para>
  <para style="q2" vid="ISA 22:18">hɔ na wubewu</para>
  <para style="q1" vid="ISA 22:18">na wo teaseɛnam fɛfɛ no aka hɔ,</para>
  <para style="q2" vid="ISA 22:18">wo a woyɛ ahohora ma wo wura fi!<verse eid="ISA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19"/>Megye wʼadwuma afi wo nsa mu</para>
  <para style="q2" vid="ISA 22:19">na wɔayi wo afi wo dibea so.<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>“Saa da no, mɛfrɛ me somfo Eliakim a ɔyɛ Hilkia babarima. <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>Mede wʼatade yuu bɛhyɛ no na mede wʼabɔso abebare nʼasen mu na mede wo tumi ahyɛ ne nsa. Ɔbɛyɛ agya ama wɔn a wɔtete Yerusalem ne Yuda fi. <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>Mede Dawid fi safe bɛma no; nea obebue no obiara rentumi nto mu; na nea ɔbɛto mu nso a obiara rentumi mmue. <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>Mɛbɔ ne so sɛ pɛe ama watim, ɔbɛyɛ anuonyam agua ama nʼagya fi. <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>Nʼabusua anuonyam nyinaa begyina ne so: nʼasefo ne ne nenanom, ne nkuku ne nkaka, fi nsanka, mprɛte so kosi nhina nyinaa so.<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>“Saa da no,” sɛnea Asafo <char style="nd">Awurade</char> se ni, “pɛe a wɔabɔ so ama atim no, betu ahwe fam na nʼadesoa no nso asɛe, <char style="nd">Awurade</char>, akasa!”<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">Nkɔmhyɛ A Ɛfa Tiro Ho</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>Nkɔmhyɛ a ɛfa Tiro ho:</para>
  <para style="q1" vid="ISA 23:1">Tarsis ahyɛn, muntwa adwo!</para>
  <para style="q2" vid="ISA 23:1">Efisɛ wɔasɛe Tiro</para>
  <para style="q2" vid="ISA 23:1">na wɔannyaw no ofi anaa hyɛngyinabea.</para>
  <para style="q1" vid="ISA 23:1">Wufi Kipro asase so</para>
  <para style="q2" vid="ISA 23:1">abɛka asɛm akyerɛ wɔn.<verse eid="ISA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2"/>Monyɛ komm, mo nnipa a mowɔ supɔw no so</para>
  <para style="q2" vid="ISA 23:2">ne mo Sidon aguadifo a</para>
  <para style="q2" vid="ISA 23:2">po so adwumayɛfo ama mo ayɛ adefo.<verse eid="ISA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3"/>Nsu akɛse no so</para>
  <para style="q2" vid="ISA 23:3">na aduan fi Sihor nam bae;</para>
  <para style="q1" vid="ISA 23:3">Nil ho nnɔbae na ɛyɛɛ Tiro foto,</para>
  <para style="q2" vid="ISA 23:3">na ɔbɛyɛɛ amanaman aguadibea.<verse eid="ISA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4"/>Animguase nka wo, Sidon, ne wo, po so abandennen,</para>
  <para style="q2" vid="ISA 23:4">efisɛ po akasa se,</para>
  <para style="q1" vid="ISA 23:4">“Menkyemee da, na menwoo da;</para>
  <para style="q2" vid="ISA 23:4">mentetew mmabarima anaa mmabea da.”<verse eid="ISA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5"/>Sɛ asɛm no du Misraim a,</para>
  <para style="q2" vid="ISA 23:5">wobedi yaw wɔ nkra a efi Tiro no ho.<verse eid="ISA 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6"/>Muntwa nkɔ Tarsis;</para>
  <para style="q2" vid="ISA 23:6">muntwa adwo, mo a mowɔ supɔw no so.<verse eid="ISA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7"/>Eyi ne mo ahosɛpɛw kuropɔn no,</para>
  <para style="q2" vid="ISA 23:7">teteete kuropɔn no,</para>
  <para style="q1" vid="ISA 23:7">nea wɔatu akɔtena</para>
  <para style="q2" vid="ISA 23:7">akyirikyiri nsase so no ana?<verse eid="ISA 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8"/>Hena na ɔbɔɔ atirimpɔw yi de tiaa Tiro,</para>
  <para style="q2" vid="ISA 23:8">nea ɔkyekyɛ ahenkyɛw,</para>
  <para style="q1" vid="ISA 23:8">nea nʼaguadifo yɛ ahenemma,</para>
  <para style="q2" vid="ISA 23:8">na nʼadetɔnfo agye din wɔ asase so?<verse eid="ISA 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9"/>Asafo <char style="nd">Awurade</char> na ɔbɔɔ ne tirimpɔw se,</para>
  <para style="q2" vid="ISA 23:9">ɔbɛbrɛ anuonyam mu ahomaso ase</para>
  <para style="q2" vid="ISA 23:9">na wabrɛ wɔn a wɔagye din wɔ asase yi so nyinaa ase.<verse eid="ISA 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10"/>Yɛ wʼasase so adwuma te sɛnea wɔyɛ wɔ Nil ho no</para>
  <para style="q2" vid="ISA 23:10">Tarsis Babea,</para>
  <para style="q2" vid="ISA 23:10">efisɛ wunni hyɛngyinabea bio.<verse eid="ISA 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11"/>
    <char style="nd">Awurade</char> ama ne nsa so wɔ po no so</para>
  <para style="q2" vid="ISA 23:11">ama ahenni ahorow a ɛwɔ hɔ no repopo.</para>
  <para style="q1" vid="ISA 23:11">Wahyɛ Kanaan ho mmara se,</para>
  <para style="q2" vid="ISA 23:11">wɔnsɛe nʼaban.<verse eid="ISA 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12"/>Ɔkae se, “Wʼahurisidi no nso ha ara,</para>
  <para style="q2" vid="ISA 23:12">Sidon Babea Ɔbabun a wɔadwerɛw wo!</para>
  <para style="b" vid="ISA 23:12"/>
  <para style="q1" vid="ISA 23:12">“Sɔre, twa kɔ Kipro;</para>
  <para style="q2" vid="ISA 23:12">hɔ mpo worennya ahotɔ.”<verse eid="ISA 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13"/>Monhwɛ Babiloniafo asase no</para>
  <para style="q2" vid="ISA 23:13">saa nnipa a mprempren wɔnka hwee no!</para>
  <para style="q1" vid="ISA 23:13">Asiriafo ayɛ no</para>
  <para style="q2" vid="ISA 23:13">baabi a nweatam so mmoa te;</para>
  <para style="q1" vid="ISA 23:13">wosisii wɔn anotua aban bebree,</para>
  <para style="q2" vid="ISA 23:13">wodwiriw nʼaban gui</para>
  <para style="q2" vid="ISA 23:13">ma ɛdan nnwiriwii.<verse eid="ISA 23:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14"/>Muntwa adwo, Tarsis ahyɛn;</para>
  <para style="q2" vid="ISA 23:14">wɔasɛe wʼaban!<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>Saa bere no wɔrenkae Tiro mfe aduɔson a ɛyɛ ɔhene nkwanna. Nanso mfe aduɔson akyi no, nea ɛbɛto Tiro no bɛyɛ sɛnea ɛwɔ oguamanfo no dwom mu no:<verse eid="ISA 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16"/>“Ma sankuten no so, pase fa kuropɔn no mu,</para>
  <para style="q2" vid="ISA 23:16">oguamanfo a wɔnnkae wo;</para>
  <para style="q1" vid="ISA 23:16">bɔ sankuten no yiye, to nnwom bebree,</para>
  <para style="q2" vid="ISA 23:16">sɛnea wɔbɛkae wo.”<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>Mfe aduɔson akyi, <char style="nd">Awurade</char> ne Tiro bedi. Ɔbɛsan akodi ne paa sɛ oguamanfo na ɔne ahenni a ɛwɔ asase so nyinaa adi gua. <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>Nanso nea obenya ne ne mfaso nyinaa wɔde bɛto hɔ ama <char style="nd">Awurade</char>; wɔremmoaboa ano na wɔremfa nsie. Ne mfaso no bɛkɔ wɔn a wɔsom wɔ <char style="nd">Awurade</char> anim no nkyɛn, na wɔanya aduan bebree ne ntade pa.<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s1">Asase Sɛe A Efi <char style="nd">Awurade</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1"/>Hwɛ, <char style="nd">Awurade</char> rebɛma asase ada mpan</para>
  <para style="q2" vid="ISA 24:1">na wasɛe no;</para>
  <para style="q1" vid="ISA 24:1">ɔbɛsɛe asase ani</para>
  <para style="q2" vid="ISA 24:1">na wabɔ sotefo ahwete,<verse eid="ISA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2"/>ɛbɛyɛ saa ara</para>
  <para style="q2" vid="ISA 24:2">ama ɔsɔfo sɛnea ɛbɛyɛ ama nnipa,</para>
  <para style="q2" vid="ISA 24:2">ama owura sɛnea ɛbɛyɛ ama asomfo,</para>
  <para style="q2" vid="ISA 24:2">ama awuraa sɛnea ɛbɛyɛ ama afenaa,</para>
  <para style="q2" vid="ISA 24:2">ama nea ɔtɔn sɛnea ɛbɛyɛ ama nea ɔtɔ,</para>
  <para style="q2" vid="ISA 24:2">ama nea ogye bosea sɛnea ɛbɛyɛ ama nea ɔma bosea,</para>
  <para style="q2" vid="ISA 24:2">ama ɔkafo sɛnea ɛbɛyɛ ama nea ɔde ma.<verse eid="ISA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3"/>Asase bɛda mpan koraa,</para>
  <para style="q2" vid="ISA 24:3">na wɔafom so nneɛma.</para>
  <para style="q2" vid="ISA 24:3">
    <char style="nd">Awurade</char>, na waka saa asɛm yi.<verse eid="ISA 24:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4"/>Asase so yɛ wosee, na ekisa</para>
  <para style="q2" vid="ISA 24:4">wiase kɔ ahoyeraw mu, na ekisa,</para>
  <para style="q2" vid="ISA 24:4">nea wɔama no so wɔ asase so ho yeraw no.<verse eid="ISA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5"/>Asase so nnipa agu ne ho fi;</para>
  <para style="q2" vid="ISA 24:5">wɔanni mmara no so,</para>
  <para style="q1" vid="ISA 24:5">wɔabu ahyɛde no so</para>
  <para style="q2" vid="ISA 24:5">na wɔasɛe apam a ɛwɔ hɔ daa no.<verse eid="ISA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6"/>Enti nnome amene asase no</para>
  <para style="q2" vid="ISA 24:6">ɛsɛ sɛ so nnipa nya wɔn afɔdi so akatua</para>
  <para style="q1" vid="ISA 24:6">ne saa nti wɔahyew asase no so nnipa,</para>
  <para style="q2" vid="ISA 24:6">na kakraa bi pɛ na wɔaka.<verse eid="ISA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7"/>Nsa foforo no ho yow na bobe no guan;</para>
  <para style="q2" vid="ISA 24:7">wɔn a wogye wɔn ani no si apini.<verse eid="ISA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8"/>Akasaebɔ mu anigye no agyae,</para>
  <para style="q2" vid="ISA 24:8">ahosɛpɛwfo no nteɛteɛmu no agyae.</para>
  <para style="q2" vid="ISA 24:8">Sankuten so nnwom dɛdɛ no ayɛ dinn.<verse eid="ISA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9"/>Wɔnnto dwom mfa nnom nsa bio;</para>
  <para style="q2" vid="ISA 24:9">mmorɔsa ayɛ nwen ama anomfo.<verse eid="ISA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10"/>Kuropɔn a wɔasɛe no ada mpan;</para>
  <para style="q2" vid="ISA 24:10">wɔatoto ofi biara apon mu.<verse eid="ISA 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11"/>Wɔpere nsa wɔ mmɔnten so;</para>
  <para style="q2" vid="ISA 24:11">ahosɛpɛw nyinaa adan bosooyɛ,</para>
  <para style="q2" vid="ISA 24:11">anigye nyinaa atu ayera wɔ asase no so.<verse eid="ISA 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12"/>Kuropɔn no asɛe,</para>
  <para style="q2" vid="ISA 24:12">wɔabubu nʼapon mu nketenkete.<verse eid="ISA 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13"/>Saa ara na ɛbɛyɛ wɔ asase no so</para>
  <para style="q2" vid="ISA 24:13">ne amanaman no mu,</para>
  <para style="q1" vid="ISA 24:13">sɛnea wɔboro ngodua a ɛyɛ no,</para>
  <para style="q2" vid="ISA 24:13">anaa sɛnea wogyaw mpɛpɛ wɔ bobe twabere akyi no.<verse eid="ISA 24:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14"/>Wɔma wɔn nne so, wɔde anigye teɛteɛ mu;</para>
  <para style="q2" vid="ISA 24:14">efi atɔe fam, wɔkamfo <char style="nd">Awurade</char> kɛseyɛ.<verse eid="ISA 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15"/>Enti apuei fam, monhyɛ <char style="nd">Awurade</char> anuonyam;</para>
  <para style="q2" vid="ISA 24:15">momma <char style="nd">Awurade</char> din so, Israel Nyankopɔn no,</para>
  <para style="q2" vid="ISA 24:15">wɔ supɔw a ɛwɔ po so no so.<verse eid="ISA 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16"/>Yɛte nnwonto fi asase ano yɛte se,</para>
  <para style="q2" vid="ISA 24:16">“Anuonyam nka Ɔtreneeni no.”</para>
  <para style="b" vid="ISA 24:16"/>
  <para style="q1" vid="ISA 24:16">Nanso mekae se, “Matɔ beraw, mapa abaw!</para>
  <para style="q2" vid="ISA 24:16">Minnue!</para>
  <para style="q1" vid="ISA 24:16">Ɔfatwafo di huammɔ!</para>
  <para style="q2" vid="ISA 24:16">Ɔnam nnaadaa so di huammɔ.”<verse eid="ISA 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17"/>Ehu, amoa ne afiri retwɛn mo,</para>
  <para style="q2" vid="ISA 24:17">nnipa a mote asase so.<verse eid="ISA 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18"/>Nea ehu nti oguan no</para>
  <para style="q2" vid="ISA 24:18">bɛtɔ amoa mu;</para>
  <para style="q1" vid="ISA 24:18">nea ɔforo fi amoa mu no</para>
  <para style="q2" vid="ISA 24:18">afiri beyi no.</para>
  <para style="b" vid="ISA 24:18"/>
  <para style="q1" vid="ISA 24:18">Wɔabue nsu apon wɔ ɔsoro,</para>
  <para style="q2" vid="ISA 24:18">na asase nnyinaso wosow.<verse eid="ISA 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19"/>Wɔadwiriw asase no</para>
  <para style="q2" vid="ISA 24:19">na emu apaapae,</para>
  <para style="q2" vid="ISA 24:19">na asase awosow ankasa.<verse eid="ISA 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20"/>Asase tɔ ntintan te sɛ ɔsabowfo.</para>
  <para style="q2" vid="ISA 24:20">Ehinhim biribiri te sɛ ntamadan wɔ mframa ano;</para>
  <para style="q1" vid="ISA 24:20">nʼatuatew ho afɔdi ayɛ adesoa ama no</para>
  <para style="q2" vid="ISA 24:20">na ɛhwe ase a ɛrensɔre bio.<verse eid="ISA 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21"/>Saa da no, <char style="nd">Awurade</char> bɛtwe</para>
  <para style="q2" vid="ISA 24:21">ɔsoro atumfo</para>
  <para style="q2" vid="ISA 24:21">ne ahemfo a wɔwɔ asase so aso.<verse eid="ISA 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22"/>Wɔbɛka wɔn nyinaa abɔ mu</para>
  <para style="q2" vid="ISA 24:22">sɛ nneduafo ahyɛ afiase amoa mu;</para>
  <para style="q1" vid="ISA 24:22">wɔbɛto wɔn mu wɔ afiase</para>
  <para style="q2" vid="ISA 24:22">na nna bebree akyi no wɔatwe wɔn aso.<verse eid="ISA 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23"/>Ɔsram anim begu ase na owia ani awu;</para>
  <para style="q2" vid="ISA 24:23">na Asafo <char style="nd">Awurade</char> bedi hene</para>
  <para style="q1" vid="ISA 24:23">wɔ Sion bepɔw so ne Yerusalem,</para>
  <para style="q2" vid="ISA 24:23">ne wɔn mpanyimfo anim, wɔ anuonyam mu.<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">Ayeyi Nka <char style="nd">Awurade</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1"/>
    <char style="nd">Awurade</char>, wo ne me Nyankopɔn;</para>
  <para style="q2" vid="ISA 25:1">mɛma wo so na mayi wo din ayɛ,</para>
  <para style="q1" vid="ISA 25:1">efisɛ wufi nokwaredi mu,</para>
  <para style="q2" vid="ISA 25:1">ayɛ anwonwade bebree,</para>
  <para style="q2" vid="ISA 25:1">nneɛma a wɔahyehyɛ fi teteete.<verse eid="ISA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2"/>Woayɛ kuropɔn no nnwiriwii siw,</para>
  <para style="q2" vid="ISA 25:2">kurow no a ɛwɔ bammɔ no asɛe;</para>
  <para style="q1" vid="ISA 25:2">ananafo abandennen no nyɛ kuropɔn bio;</para>
  <para style="q2" vid="ISA 25:2">na wɔrensi bio.<verse eid="ISA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3"/>Enti aman a wɔyɛ den bedi wo ni</para>
  <para style="q2" vid="ISA 25:3">atutuwpɛfo aman bɛhyɛ wo anuonyam.<verse eid="ISA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4"/>Woayɛ ahiafo guankɔbea,</para>
  <para style="q2" vid="ISA 25:4">ohiani mmɔborɔni guankɔbea,</para>
  <para style="q1" vid="ISA 25:4">ahum ano ahintawee</para>
  <para style="q2" vid="ISA 25:4">ɔhyew mu nwini</para>
  <para style="q1" vid="ISA 25:4">na atirimɔdenfo home</para>
  <para style="q2" vid="ISA 25:4">te sɛ ahum a ɛrebɔ dwira ɔfasu<verse eid="ISA 25:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 25:5"/>ne ɔhyew a ɛwɔ nweatam so.</para>
  <para style="q1" vid="ISA 25:5">Wobrɛ ananafo huuyɛ ase;</para>
  <para style="q2" vid="ISA 25:5">sɛnea omununkum brɛ owia hyew ano ase no,</para>
  <para style="q2" vid="ISA 25:5">saa ara na atirimɔdenfo nnwom nso begyae.<verse eid="ISA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6"/>Asafo <char style="nd">Awurade</char> bɛto pon wɔ saa bepɔw yi so</para>
  <para style="q1" vid="ISA 25:6">obesiesie nnuan pa ne nsa a adi nna;</para>
  <para style="q2" vid="ISA 25:6">nam pa ne nsa pa ama nnipa nyinaa.<verse eid="ISA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7"/>Wɔ bepɔw yi so, ɔbɛsɛe</para>
  <para style="q2" vid="ISA 25:7">ntama a ɛkata nnipa nyinaa ho</para>
  <para style="q1" vid="ISA 25:7">ne nkataso a ɛkata aman nyinaa so no;<verse eid="ISA 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8"/>Ɔbɛmene owu afebɔɔ.</para>
  <para style="q1" vid="ISA 25:8">Asafo <char style="nd">Awurade</char> bɛpepa</para>
  <para style="q2" vid="ISA 25:8">ani so nusu nyinaa.</para>
  <para style="q1" vid="ISA 25:8">Obeyi ne nkurɔfo ahohora,</para>
  <para style="q2" vid="ISA 25:8">afi nsase nyinaa so.</para>
  <para style="q2" vid="ISA 25:8">
    <char style="nd">Awurade</char>, na waka.<verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>Saa da no, wɔbɛka se,</para>
  <para style="q1" vid="ISA 25:9">“Ampa ara yɛn Nyankopɔn ni;</para>
  <para style="q2" vid="ISA 25:9">yɛde yɛn ho too no so na ogyee yɛn;</para>
  <para style="q1" vid="ISA 25:9">
    <char style="nd">Awurade</char> no ni, yegyee no dii;</para>
  <para style="q2" vid="ISA 25:9">momma yenni ahurusi na yɛn ani nnye wɔ ne nkwagye no mu.”<verse eid="ISA 25:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10"/>
    <char style="nd">Awurade</char> nsa bɛda saa bepɔw yi so;</para>
  <para style="q2" vid="ISA 25:10">nanso obetiatia Moab so</para>
  <para style="q2" vid="ISA 25:10">te sɛ sare a wotiatia so de fra sumina.<verse eid="ISA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11"/>Wɔbɛtrɛtrɛw wɔn nsa mu wɔ so,</para>
  <para style="q2" vid="ISA 25:11">sɛnea asuguarefo trɛtrɛw wɔn nsa mu de guare.</para>
  <para style="q1" vid="ISA 25:11">Onyankopɔn bɛbrɛ wɔn ahomaso ase</para>
  <para style="q2" vid="ISA 25:11">a ɔrenhwɛ wɔn nsa ano dwumadi ho.<verse eid="ISA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12"/>Obebubu mo bammɔ afasu atenten no agu,</para>
  <para style="q2" vid="ISA 25:12">obebubu agu fam</para>
  <para style="q2" vid="ISA 25:12">ama ayɛ mfutuma.<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">Ayeyi Dwom</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>Saa da no, wɔbɛto saa dwom yi wɔ Yuda asase so:</para>
  <para style="q1" vid="ISA 26:1">Yɛwɔ kuropɔn dennen;</para>
  <para style="q2" vid="ISA 26:1">Onyankopɔn de nkwagye</para>
  <para style="q2" vid="ISA 26:1">ayɛ nʼafasu ne ne hankare a ɛkorɔn.<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>Mummuebue apon no</para>
  <para style="q2" vid="ISA 26:2">na atreneefo man no nhyɛn mu,</para>
  <para style="q2" vid="ISA 26:2">ɔman nokwafo no.<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>Wobɛkora no so asomdwoe mu</para>
  <para style="q2" vid="ISA 26:3">nea wasi nʼadwene pi,</para>
  <para style="q2" vid="ISA 26:3">efisɛ ɔde ne ho to wo so.<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>Fa wo ho to <char style="nd">Awurade</char> so afebɔɔ,</para>
  <para style="q2" vid="ISA 26:4">efisɛ, <char style="nd">Awurade</char>, <char style="nd">Awurade</char> yɛ daa Botan.<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>Ɔbrɛ wɔn a wɔtete soro ase,</para>
  <para style="q2" vid="ISA 26:5">na ɔbrɛ kuropɔn a ɛkorɔn no ase;</para>
  <para style="q1" vid="ISA 26:5">obubu gu fam pasaa</para>
  <para style="q2" vid="ISA 26:5">ma ɛda mfutuma mu.<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>Anammɔn tiatia so,</para>
  <para style="q2" vid="ISA 26:6">wɔn a wɔhyɛ wɔn so anammɔn</para>
  <para style="q2" vid="ISA 26:6">ahiafo anammɔntu.<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>Ɔtreneeni kwan so yɛ tamaa;</para>
  <para style="q2" vid="ISA 26:7">wo, Ɔnokwafo, woma ɔtreneeni kwan so yɛ trontrom.<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>Yiw, <char style="nd">Awurade</char>, yɛnam wo mmara kwan so yi,</para>
  <para style="q2" vid="ISA 26:8">yɛretwɛn wo;</para>
  <para style="q1" vid="ISA 26:8">na wo din ne ne kɛseyɛ</para>
  <para style="q2" vid="ISA 26:8">yɛ nea yɛn koma pɛ.<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>Me kra pere hwehwɛ wo anadwo;</para>
  <para style="q2" vid="ISA 26:9">anɔpa nso me honhom ani gyina wo.</para>
  <para style="q1" vid="ISA 26:9">Sɛ wʼatemmu ba asase yi so a,</para>
  <para style="q2" vid="ISA 26:9">nnipa a wɔwɔ wiase sua treneeyɛ.<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>Ɛwɔ mu sɛ wuyi adom adi kyerɛ amumɔyɛfo de,</para>
  <para style="q2" vid="ISA 26:10">nanso wonsua treneeyɛ;</para>
  <para style="q1" vid="ISA 26:10">na mpo atreneefo asase so no, wɔkɔ so yɛ bɔne</para>
  <para style="q2" vid="ISA 26:10">na wommu <char style="nd">Awurade</char> kɛseyɛ.<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>Ao <char style="nd">Awurade</char>, wɔama wo nsa so kɔ soro,</para>
  <para style="q2" vid="ISA 26:11">nanso wonhu.</para>
  <para style="q1" vid="ISA 26:11">Ma wonhu wo mmɔdemmɔ wɔ wo nkurɔfo ho na ɛnhyɛ wɔn aniwu;</para>
  <para style="q2" vid="ISA 26:11">ma ogya a wɔasɔ ama wʼatamfo no nhyew wɔn.<verse eid="ISA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>
    <char style="nd">Awurade</char>, woama yɛn asomdwoe;</para>
  <para style="q2" vid="ISA 26:12">nea yɛatumi ayɛ nyinaa wo na woayɛ ama yɛn.<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>
    <char style="nd">Awurade</char> yɛn Nyankopɔn, awuranom afoforo bi adi yɛn so,</para>
  <para style="q2" vid="ISA 26:13">nanso wo din nko ara na yɛ kamfo.<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>Afei wɔawuwu, na wɔnte ase bio;</para>
  <para style="q2" vid="ISA 26:14">ahonhom a wɔafi mu no wɔrensɔre.</para>
  <para style="q1" vid="ISA 26:14">Wotwee wɔn aso na wosɛee wɔn</para>
  <para style="q2" vid="ISA 26:14">wɔama yɛn werɛ afi wɔn.<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>Woama ɔman no ayɛ kɛse, <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="ISA 26:15">woama ɔman no ayɛ kɛse;</para>
  <para style="q1" vid="ISA 26:15">woahyɛ wo ho anuonyam;</para>
  <para style="q2" vid="ISA 26:15">woatrɛtrɛw asase no ahye nyinaa mu.<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>
    <char style="nd">Awurade</char>, wofi ahohia mu baa wo nkyɛn;</para>
  <para style="q2" vid="ISA 26:16">bere a wotwee wɔn aso no,</para>
  <para style="q2" vid="ISA 26:16">na wontumi mmue wɔn ano mpo mmɔ mpae.<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>Sɛnea ɔpemfo a awo aka no</para>
  <para style="q2" vid="ISA 26:17">fi ɔyaw mu bukabukaw ne mu na osu no,</para>
  <para style="q2" vid="ISA 26:17">saa ara na yɛyɛe wɔ wʼanim, <char style="nd">Awurade</char>.<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>Yenyinsɛnee, yɛkyemee wɔ ɔyaw mu</para>
  <para style="q2" vid="ISA 26:18">nanso yɛwoo mframa.</para>
  <para style="q1" vid="ISA 26:18">Yɛamfa nkwagye amma asase so;</para>
  <para style="q2" vid="ISA 26:18">wɔanwo nnipa amma asase so.<verse eid="ISA 26:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>Nanso wʼawufo benya nkwa;</para>
  <para style="q2" vid="ISA 26:19">wɔn nipadua bɛsɔre.</para>
  <para style="q1" vid="ISA 26:19">Ma wɔn a wɔtete mfutuma mu no,</para>
  <para style="q2" vid="ISA 26:19">nsɔre mfa anigye nteɛ mu.</para>
  <para style="q1" vid="ISA 26:19">Mo bosu te sɛ anɔpa bosu;</para>
  <para style="q2" vid="ISA 26:19">asase beyi nʼafunu apue.<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>Monkɔ, me nkurɔfo, monhyɛnhyɛn mo adan mu</para>
  <para style="q2" vid="ISA 26:20">na montoto apon no mu;</para>
  <para style="q1" vid="ISA 26:20">momfa mo ho nsie bere tiaa bi</para>
  <para style="q2" vid="ISA 26:20">kosi sɛ nʼabufuwhyew ano bedwo.<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>Hwɛ, <char style="nd">Awurade</char> refi nʼatenae</para>
  <para style="q2" vid="ISA 26:21">abɛtwe nnipa a wɔte asase so aso wɔ wɔn bɔne ho.</para>
  <para style="q1" vid="ISA 26:21">Asase bɛda mogya a wɔahwie agu no so no adi;</para>
  <para style="q2" vid="ISA 26:21">ɔrentumi mfa nʼatɔfo nsie bio.<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s1">Israel Ogye</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>Saa da no,</para>
  <para style="q1" vid="ISA 27:1">
    <char style="nd">Awurade</char> de nʼafoa bɛtwe aso,</para>
  <para style="q2" vid="ISA 27:1">ɔde nʼafoa a ɛyɛ hu na ɛso na ɛyɛ nnam no,</para>
  <para style="q1" vid="ISA 27:1">ɔwɔ Lewiatan a ɔde ahoɔhare tu hoo,</para>
  <para style="q2" vid="ISA 27:1">ɔwɔ Lewiatan a ɔbobɔw ne ho;</para>
  <para style="q1" vid="ISA 27:1">obekum po mu aboa kɛse a ne ho yɛ hu no.<verse eid="ISA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2"/>Saa da no,</para>
  <para style="q1" vid="ISA 27:2">“To dwom fa bobeturo a ɛsow no ho se:<verse eid="ISA 27:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3"/>Me, <char style="nd">Awurade</char>, mehwɛ so;</para>
  <para style="q2" vid="ISA 27:3">migugu so nsu bere biara.</para>
  <para style="q1" vid="ISA 27:3">Mebɔ ho ban awia ne anadwo</para>
  <para style="q2" vid="ISA 27:3">sɛnea obiara rensɛe no.<verse eid="ISA 27:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4"/>Me bo mfuw ɛ.</para>
  <para style="q1" vid="ISA 27:4">Sɛ ɛkaa nware ne nsɔe nko ara na ɛko tia me a</para>
  <para style="q2" vid="ISA 27:4">anka me ne wɔn de bɛbɔ ani;</para>
  <para style="q2" vid="ISA 27:4">na mahyew wɔn nyinaa.<verse eid="ISA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5"/>Sɛ ɛnte saa a, ma wɔmmra me nkyɛn mmehintaw;</para>
  <para style="q2" vid="ISA 27:5">ne me mmɛdwene asomdwoe ho</para>
  <para style="q2" vid="ISA 27:5">Yiw, asomdwoe ho na mo ne me mmɛdwene.”<verse eid="ISA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6"/>Nna a ɛreba no mu no, Yakob ase betim,</para>
  <para style="q2" vid="ISA 27:6">Israel begu nhwiren na anyin fɛfɛɛfɛ</para>
  <para style="q1" vid="ISA 27:6">na ɔde ne nnuaba ahyɛ wiase nyinaa ma.<verse eid="ISA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7"/>
    <char style="nd">Awurade</char> abɔ Israel</para>
  <para style="q2" vid="ISA 27:7">sɛnea ɔbɔɔ wɔn a wɔbɔɔ Israel hwee fam no ana?</para>
  <para style="q1" vid="ISA 27:7">
    <char style="nd">Awurade</char> akum Israel</para>
  <para style="q2" vid="ISA 27:7">sɛnea okum wɔn a wokum Israel no ana?<verse eid="ISA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8"/>Wode ɔko ne asutwa twe nʼaso,</para>
  <para style="q2" vid="ISA 27:8">wode mframa a ano yɛ den pam no</para>
  <para style="q2" vid="ISA 27:8">te sɛ da a apuei mframa bɔ no.<verse eid="ISA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9"/>Eyi na ɛbɛyɛ mpata ama Yakob afɔdi,</para>
  <para style="q2" vid="ISA 27:9">eyi na ɛbɛyɛ ne bɔne asetu so aba a edi mu:</para>
  <para style="q1" vid="ISA 27:9">bere a ɔyɛ afɔremuka so abo</para>
  <para style="q2" vid="ISA 27:9">sɛ hyirew a wɔabubu mu nketenkete,</para>
  <para style="q1" vid="ISA 27:9">na Asera nnua</para>
  <para style="q2" vid="ISA 27:9">ne nnuhuam afɔremuka nsisi hɔ bio no.<verse eid="ISA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10"/>Kuropɔn a wɔabɔ ho ban no ada mpan</para>
  <para style="q2" vid="ISA 27:10">wɔagyaw atenae a wɔafi so no te sɛ nweatam</para>
  <para style="q1" vid="ISA 27:10">hɔ na nantwimma didi,</para>
  <para style="q2" vid="ISA 27:10">hɔ na wɔdeda;</para>
  <para style="q2" vid="ISA 27:10">wɔwe so nnua no mman ma ho yɛ kokwakokwa.<verse eid="ISA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11"/>Sɛ nnubaa no wo a, wobubu</para>
  <para style="q2" vid="ISA 27:11">na mmea bɛfa de kɔsɔ ogya.</para>
  <para style="q1" vid="ISA 27:11">Na saa nnipa yi nni ntease</para>
  <para style="q2" vid="ISA 27:11">enti wɔn yɛfo nhu wɔn mmɔbɔ,</para>
  <para style="q2" vid="ISA 27:11">na wonnya adom mfi nea ɔbɔɔ wɔn no nkyɛn.<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>Saa da no, <char style="nd">Awurade</char> bɛporow afi asuten Eufrate akosi Misraim Bon Wosee mu, na mo, Israelfo de, wɔbɛfa mo mmaako mmaako aboaboa mo ano. <verse eid="ISA 27:12"/><verse number="13" style="v" sid="ISA 27:13"/>Saa da no, wɔbɛhyɛn torobɛnto kɛse no. Wɔn a na wɔrewuwu wɔ Asiria ne wɔn a na wɔwɔ nnommum mu wɔ Misraim bɛba abɛsom <char style="nd">Awurade</char> wɔ Yerusalem bepɔw kronkron no so.<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s1">Efraim Ne Yuda Akannifo Nnue</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1"/>Nnome nka nhwiren abotiri a ɛyɛ Efraim asabowfo ahohoahoade no</para>
  <para style="q2" vid="ISA 28:1">nhwiren a ɛrepa, nʼahoɔfɛ a ɛho wɔ nyam,</para>
  <para style="q1" vid="ISA 28:1">a ɛda asasebere bon so.</para>
  <para style="q2" vid="ISA 28:1">Nnome nka kuropɔn no, nea nnipa a nsa asɛe wɔn no de hoahoa wɔn ho no.<verse eid="ISA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2"/>Hwɛ, Awurade wɔ obi a ɔwɔ tumi ne ahoɔden.</para>
  <para style="q2" vid="ISA 28:2">Ɔte sɛ mparuwbo ne mframa a ɛsɛe ade</para>
  <para style="q1" vid="ISA 28:2">ɔte sɛ osu a ɛne mframa nam, ne osuhweam a ɛhyɛ suka ma</para>
  <para style="q2" vid="ISA 28:2">ɔbɛtow no ahwe fam ahoɔden so.<verse eid="ISA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3"/>Saa nhwiren abotiri no a ɛyɛ Efraim asabowfo ahohoahoade no,</para>
  <para style="q2" vid="ISA 28:3">wobetiatia so.<verse eid="ISA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4"/>Saa nhwiren a ɛrepa, nʼahoɔfɛ a ɛho wɔ nyam,</para>
  <para style="q2" vid="ISA 28:4">a ɛda asasebere bon so no,</para>
  <para style="q1" vid="ISA 28:4">bɛyɛ sɛ borɔdɔma a ɛbere ansa na otwabere adu,</para>
  <para style="q2" vid="ISA 28:4">sɛ obi hu na ɔte a</para>
  <para style="q2" vid="ISA 28:4">odi no ntɛm so.<verse eid="ISA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5"/>Saa da no Asafo <char style="nd">Awurade</char></para>
  <para style="q2" vid="ISA 28:5">bɛyɛ Anuonyam ahenkyɛw,</para>
  <para style="q1" vid="ISA 28:5">nhwiren abotiri fɛfɛ</para>
  <para style="q2" vid="ISA 28:5">ama ne nkurɔfo nkae no.<verse eid="ISA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6"/>Ɔbɛyɛ atɛntrenee honhom</para>
  <para style="q2" vid="ISA 28:6">ama otemmufo a ɔte agua mu.</para>
  <para style="q1" vid="ISA 28:6">Ɔbɛyɛ ahoɔden farebae</para>
  <para style="q2" vid="ISA 28:6">ama wɔn a wɔpam atamfo wɔ nkurow apon ano.<verse eid="ISA 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7"/>Na eyinom nso nsa ma wɔtɔ ntintan</para>
  <para style="q2" vid="ISA 28:7">na bobesa ma wohinhim;</para>
  <para style="q1" vid="ISA 28:7">bobesa ma asɔfo ne adiyifo tɔ ntintan</para>
  <para style="q2" vid="ISA 28:7">na nsa ma wɔn ani so yɛ wɔn totɔtotɔ;</para>
  <para style="q1" vid="ISA 28:7">na wohinhim</para>
  <para style="q2" vid="ISA 28:7">wɔtɔ ntintan bere a wɔrenya anisoadehu,</para>
  <para style="q2" vid="ISA 28:7">na wɔn ano fomfom wɔ adwenkyerɛ mu.<verse eid="ISA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8"/>Ɔfe agugu apon nyinaa so,</para>
  <para style="q2" vid="ISA 28:8">na baabiara ayɛ fi.<verse eid="ISA 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9"/>“Hena na ɔpɛ sɛ ɔkyerɛkyerɛ no?</para>
  <para style="q2" vid="ISA 28:9">Na hena nso na ɔrekyerɛ nʼasɛm ase akyerɛ no?</para>
  <para style="q1" vid="ISA 28:9">Mmofra a wɔatwa wɔn nufu,</para>
  <para style="q2" vid="ISA 28:9">wɔn a wotwaa wɔn nufu nkyɛe no ana?<verse eid="ISA 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10"/>Na ɛyɛ:</para>
  <para style="q2" vid="ISA 28:10">Yɛ eyi, anaa eyi</para>
  <para style="q1" vid="ISA 28:10">mmara foforo akyi mmara;</para>
  <para style="q2" vid="ISA 28:10">ɛha kakra, ɛhɔ kakra.”<verse eid="ISA 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11"/>Eye, na afei ananafo ano ne kasa foforo</para>
  <para style="q2" vid="ISA 28:11">na Onyankopɔn de bɛkasa akyerɛ saa nkurɔfo yi,<verse eid="ISA 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12"/>Ɔka kyerɛɛ wɔn se,</para>
  <para style="q2" vid="ISA 28:12">“Ha ne ahomegyebea no, momma abrɛfo no nhome;</para>
  <para style="q1" vid="ISA 28:12">ahodwobea nso ni,”</para>
  <para style="q2" vid="ISA 28:12">nanso wɔantie no.<verse eid="ISA 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13"/>Enti afei wɔbɛfa <char style="nd">Awurade</char> asɛm a ɔde ma wɔn no sɛ:</para>
  <para style="q2" vid="ISA 28:13">Yɛ eyi anaa eyi,</para>
  <para style="q2" vid="ISA 28:13">mmara foforo akyi mmara;</para>
  <para style="q1" vid="ISA 28:13">ha kakra, hɔ kakra,</para>
  <para style="q2" vid="ISA 28:13">sɛnea wɔrekɔ no ɛbɛma wɔapini wɔn akyi;</para>
  <para style="q2" vid="ISA 28:13">wobepirapira, na wɔatɔ afiri mu, na wɔakyere wɔn.<verse eid="ISA 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14"/>Ɛno nti, muntie <char style="nd">Awurade</char> asɛm, mo fɛwdifo</para>
  <para style="q2" vid="ISA 28:14">a mudi saa nkurɔfo yi so wɔ Yerusalem.<verse eid="ISA 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15"/>Mohoahoa mo ho se, “Yɛne owu ayɛ apam,</para>
  <para style="q2" vid="ISA 28:15">yɛne ɔda ayɛ nhyehyɛe</para>
  <para style="q1" vid="ISA 28:15">sɛ asotwe a ano yɛ den ba a,</para>
  <para style="q2" vid="ISA 28:15">ɛrentumi nka yɛn,</para>
  <para style="q1" vid="ISA 28:15">efisɛ yɛde atoro ayɛ yɛn guankɔbea</para>
  <para style="q2" vid="ISA 28:15">ne nnaadaa ayɛ yɛn hintabea.”<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>Enti nea Otumfo <char style="nd">Awurade</char> se ni,</para>
  <para style="q1" vid="ISA 28:16">“Hwɛ! Mede ɔbo bi retim Sion,</para>
  <para style="q2" vid="ISA 28:16">ɔbo a wɔasɔ ahwɛ,</para>
  <para style="q1" vid="ISA 28:16">tweatibo a ɛsom bo ama fapem a ɛyɛ den;</para>
  <para style="q2" vid="ISA 28:16">nea ɔde ne ho to so no remmɔ hu.<verse eid="ISA 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17"/>Mede atɛntrenee bɛyɛ susuhama</para>
  <para style="q2" vid="ISA 28:17">na treneeyɛ ayɛ ɔfasu kirebennyɛ susuhama</para>
  <para style="q1" vid="ISA 28:17">mparuwbo bɛsɛe wo guankɔbea a ɛyɛ atoro no,</para>
  <para style="q2" vid="ISA 28:17">na nsu abɛkata wo hintabea hɔ.<verse eid="ISA 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18"/>Wobetwa apam a wo ne owu ayɛ no mu;</para>
  <para style="q2" vid="ISA 28:18">nhyehyɛe a wo ne ɔda ayɛ no nso rennyina</para>
  <para style="q1" vid="ISA 28:18">sɛ asotwe a ano yɛ den no ba a,</para>
  <para style="q2" vid="ISA 28:18">ebetwiw afa mo so.<verse eid="ISA 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19"/>Mpɛn dodow biara a ɛbɛba no ɛbɛsoa mo akɔ;</para>
  <para style="q2" vid="ISA 28:19">anɔpa, awia ne anadwo biara,</para>
  <para style="q2" vid="ISA 28:19">ɛbɛfa mu akɔ.”</para>
  <para style="b" vid="ISA 28:19"/>
  <para style="q1" vid="ISA 28:19">Saa nkra yi ntease</para>
  <para style="q2" vid="ISA 28:19">de ehu bɛba.<verse eid="ISA 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20"/>Mpa no yɛ tia dodo ma sɛ wɔteɛ wɔn mu wɔ so,</para>
  <para style="q2" vid="ISA 28:20">kuntu no yɛ hiahiaa sɛ ɛbɛso wɔn ho kata.<verse eid="ISA 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21"/>
    <char style="nd">Awurade</char> bɛsɔre sɛnea ɔsɔree wɔ Perasim bepɔw so no,</para>
  <para style="q2" vid="ISA 28:21">ɔbɛkanyan ne ho sɛnea ɔyɛɛ wɔ Gibeon Bon mu,</para>
  <para style="q1" vid="ISA 28:21">yɛɛ nʼadwuma, nʼadwuma nwonwaso no</para>
  <para style="q2" vid="ISA 28:21">dii ne dwuma, dwumadi a bi mmaa da.<verse eid="ISA 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22"/>Afei gyae wo fɛwdi no,</para>
  <para style="q2" vid="ISA 28:22">anyɛ saa a wo nkɔnsɔnkɔnsɔn mu bɛyɛ duru;</para>
  <para style="q1" vid="ISA 28:22">Awurade, Asafo <char style="nd">Awurade</char> aka akyerɛ me</para>
  <para style="q2" vid="ISA 28:22">ɔsɛe ho mmaraden a wɔahyɛ atia asase no nyinaa.<verse eid="ISA 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23"/>Muntie na monte me nne;</para>
  <para style="q2" vid="ISA 28:23">monwɛn mo aso na muntie nea meka.<verse eid="ISA 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24"/>Sɛ okuafo funtum asase sɛ ɔrebedua so a, ɔyɛ no daa ana?</para>
  <para style="q2" vid="ISA 28:24">Ɔkɔ so tutu, fɛntɛm asase no ana?<verse eid="ISA 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25"/>Sɛ osiesie asase no ani a,</para>
  <para style="q2" vid="ISA 28:25">onnua ɛme, na ɔmpete ntɛtɛ wɔ so ana?</para>
  <para style="q1" vid="ISA 28:25">Onnua awi ne atoko mu biara wɔ nʼafa ana?<verse eid="ISA 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26"/>Ne Nyankopɔn ma no akwankyerɛ</para>
  <para style="q2" vid="ISA 28:26">na ɔkyerɛ no ɔkwan pa.<verse eid="ISA 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27"/>Wɔmfa asae mpo ɛme ho,</para>
  <para style="q2" vid="ISA 28:27">wɔmfa teaseɛnam hankare mfa ntɛtɛ so;</para>
  <para style="q1" vid="ISA 28:27">wɔde pema na ɛboro ɛme,</para>
  <para style="q2" vid="ISA 28:27">na wɔde abaa aboro ntɛtɛ.<verse eid="ISA 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28"/>Wɔyam aburow de to brodo</para>
  <para style="q2" vid="ISA 28:28">nti obi nkɔ so nyam a onnwie da.</para>
  <para style="q1" vid="ISA 28:28">Ɛwɔ mu, ɔde nʼawiporowee teaseɛnam hankare fa so de,</para>
  <para style="q2" vid="ISA 28:28">nanso ɛnyɛ nʼapɔnkɔ na wɔyam.<verse eid="ISA 28:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29"/>Eyinom nyinaa fi Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 28:29">afotu mu nwonwani,</para>
  <para style="q1" vid="ISA 28:29">na ne nyansa boro so.<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">Nnome Nka Dawid Kuropɔn</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1"/>Due wo Ariel,</para>
  <para style="q2" vid="ISA 29:1">Ariel, kuropɔn a Dawid tenaa mu!</para>
  <para style="q1" vid="ISA 29:1">Fa afe ka afe ho</para>
  <para style="q2" vid="ISA 29:1">na ma wo mfirihyia mu afahyɛ ahorow no nkɔ so.<verse eid="ISA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2"/>Nanso metua Ariel ano;</para>
  <para style="q2" vid="ISA 29:2">obedi awerɛhow na wato kwadwom,</para>
  <para style="q2" vid="ISA 29:2">ɔbɛyɛ sɛ afɔremuka so gya.<verse eid="ISA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3"/>Mede dɔm betwa wo ho ahyia;</para>
  <para style="q2" vid="ISA 29:3">mesisi abantenten atwa wo ho ahyia</para>
  <para style="q2" vid="ISA 29:3">na madi ntuano dwuma atia wo.<verse eid="ISA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4"/>Wɔasie wo no, wobɛkasa afi asase mu;</para>
  <para style="q2" vid="ISA 29:4">wo kasa a mu ntew no befi mfutuma mu aba.</para>
  <para style="q1" vid="ISA 29:4">Wo nne befi asase no mu aba te sɛ ɔsaman de;</para>
  <para style="q2" vid="ISA 29:4">wo kasa befi mfutuma mu aka asomsɛm.<verse eid="ISA 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5"/>Nanso wʼatamfo bebrebe no bɛyɛ sɛ mfutuma muhumuhu,</para>
  <para style="q2" vid="ISA 29:5">na atirimɔdenfo bebrebe no ayɛ sɛ ntɛtɛ a mframa abɔ.</para>
  <para style="q1" vid="ISA 29:5">Ɛbɛba prɛko pɛ, amono mu hɔ ara.<verse eid="ISA 29:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6"/>Asafo <char style="nd">Awurade</char> bɛba.</para>
  <para style="q1" vid="ISA 29:6">Ɔde aprannaa ne asasewosow ne huuyɛ kɛse,</para>
  <para style="q2" vid="ISA 29:6">mframahweam ne ahum ne ogyaframa a ɛhyew ade bɛba.<verse eid="ISA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7"/>Afei amanaman bebrebe a wotu Ariel so sa nyinaa,</para>
  <para style="q2" vid="ISA 29:7">wɔn a wɔtow hyɛ ɔne nʼaban so na wotua nʼano no,</para>
  <para style="q1" vid="ISA 29:7">ɛbɛyɛ wɔn sɛ adaeso,</para>
  <para style="q2" vid="ISA 29:7">anaa anadwo mu anisoadehu.<verse eid="ISA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8"/>Sɛnea obi a ɔkɔm de no so dae sɛ ɔredidi,</para>
  <para style="q2" vid="ISA 29:8">na sɛ onyan a ɔte sɛ ɔkɔm de no no;</para>
  <para style="q1" vid="ISA 29:8">sɛnea obi a osukɔm de no so dae sɛ ɔrenom nsu,</para>
  <para style="q2" vid="ISA 29:8">nanso onyan a na watɔ beraw, na osukɔm de no ara no.</para>
  <para style="q1" vid="ISA 29:8">Saa ara na ɛbɛyɛ ama amanaman dodow a</para>
  <para style="q2" vid="ISA 29:8">wɔko tia Bepɔw Sion no.<verse eid="ISA 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9"/>Mo ho nnwiriw mo na ɛnyɛ mo nwonwa,</para>
  <para style="q2" vid="ISA 29:9">mo ani mfura a munhu ade;</para>
  <para style="q1" vid="ISA 29:9">mommobow a emfi nsa,</para>
  <para style="q2" vid="ISA 29:9">montotɔ ntintan a emfi bobesa.<verse eid="ISA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10"/>
    <char style="nd">Awurade</char> de nnahɔɔ ato mo so:</para>
  <para style="q2" vid="ISA 29:10">Wakata mo ani (adiyifo no);</para>
  <para style="q2" vid="ISA 29:10">wakata mo ti so (adehufo no).<verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>Mo de, saa anisoadehu yi nyinaa nka hwee mma mo, ɛte sɛ nsɛm a wɔasɔw ano wɔ nhoma mmobɔwee mu. Sɛ mode nhoma mmobɔwee no ma obi a, otumi kenkan, na moka kyerɛ no se, “Mesrɛ wo kenkan eyi” a, obebua se, “Merentumi, efisɛ wɔasɔw ano.” <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>Sɛ nso, mode nhoma mmobɔwee no ma nea onnim akenkan, na moka kyerɛ no se, “Mesrɛ wo kenkan eyi” a, obebua se, “Minnim akenkan.”<verse eid="ISA 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>Awurade ka se,</para>
  <para style="q2" vid="ISA 29:13">“Saa nnipa yi de anohunu twiw bɛn me</para>
  <para style="q1" vid="ISA 29:13">na wɔde wɔn anofafa hyɛ me anuonyam,</para>
  <para style="q2" vid="ISA 29:13">nanso wɔn koma mmɛn me.</para>
  <para style="q1" vid="ISA 29:13">Som a wɔsom me no</para>
  <para style="q2" vid="ISA 29:13">yɛ mmara a nnipa akyerɛ wɔn no nko ara.<verse eid="ISA 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14"/>Enti mɛma nnipa yi ho adwiriw wɔn bio</para>
  <para style="q2" vid="ISA 29:14">mede anwonwade ntoatoaso bɛyɛ;</para>
  <para style="q1" vid="ISA 29:14">mɛsɛe anyansafo nyansa,</para>
  <para style="q2" vid="ISA 29:14">na mɛma nimdefo adenim ayɛ ɔkwa.”<verse eid="ISA 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15"/>Wonnue, wɔn a wɔyɛ biribiara sɛ</para>
  <para style="q2" vid="ISA 29:15">wɔde wɔn atirimpɔw behintaw <char style="nd">Awurade</char>,</para>
  <para style="q1" vid="ISA 29:15">wɔn a wɔyɛ wɔn nnwuma wɔ sum ase na wosusuw sɛ,</para>
  <para style="q2" vid="ISA 29:15">“Hena na ohu yɛn? Hena na ɔbɛte ase?”<verse eid="ISA 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16"/>Musisi nneɛma ti ase,</para>
  <para style="q2" vid="ISA 29:16">sɛnea modwene sɛ ɔnwemfo te sɛ dɔte no!</para>
  <para style="q1" vid="ISA 29:16">Nea wayɛ betumi aka akyerɛ nea ɔyɛe no se,</para>
  <para style="q2" vid="ISA 29:16">“Ɛnyɛ wo na woyɛɛ me ana”?</para>
  <para style="q1" vid="ISA 29:16">Kuku betumi aka afa ɔnwemfo ho se</para>
  <para style="q2" vid="ISA 29:16">“Onnim hwee ana”?<verse eid="ISA 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17"/>Ɛrenkyɛ koraa, wɔrennan Lebanon nyɛ no asasebere</para>
  <para style="q2" vid="ISA 29:17">na asasebere no nso nyɛ sɛ kwae ana?<verse eid="ISA 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18"/>Saa da no, ɔsotifo bɛte nsɛm a ɛwɔ nhoma mmobɔwee no mu</para>
  <para style="q2" vid="ISA 29:18">na kusuuyɛ ne esum mu mpo</para>
  <para style="q2" vid="ISA 29:18">onifuraefo ani behu ade.<verse eid="ISA 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19"/>Ahobrɛasefo bedi ahurusi wɔ <char style="nd">Awurade</char> mu bio;</para>
  <para style="q2" vid="ISA 29:19">ahiafo ho bɛsɛpɛw wɔn wɔ Israel Ɔkronkronni no mu.<verse eid="ISA 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20"/>Atutuwpɛfo bɛyera,</para>
  <para style="q2" vid="ISA 29:20">wɔrenhu fɛwdifo bio,</para>
  <para style="q2" vid="ISA 29:20">na wɔn a wodwen bɔne nyinaa, wobetwa wɔn agu,<verse eid="ISA 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21"/>wɔn a wɔka asɛm baako ma obi di fɔ,</para>
  <para style="q2" vid="ISA 29:21">wɔn a wosum nea ɔreyi ne ho ano afiri wɔ asennii</para>
  <para style="q2" vid="ISA 29:21">na wodi adansekurum ma wobu nea odi bem no fɔ no nso wobetwa wɔn agu.<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>Enti sɛɛ na <char style="nd">Awurade</char> a ogyee Abraham nkwa no</para>
  <para style="q2" vid="ISA 29:22">ka kyerɛ Yakob fifo:</para>
  <para style="q1" vid="ISA 29:22">“Yakob anim rengu ase bio;</para>
  <para style="q2" vid="ISA 29:22">wɔn anim rehoa bio.<verse eid="ISA 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23"/>Sɛ wohu wɔn mma wɔ wɔn mu,</para>
  <para style="q2" vid="ISA 29:23">wɔn a wɔyɛ me nsa ano adwuma no a</para>
  <para style="q1" vid="ISA 29:23">wɔbɛyɛ me din no kronkron;</para>
  <para style="q2" vid="ISA 29:23">wobegye Yakob ɔkronkronni no kronkronyɛ ato mu,</para>
  <para style="q2" vid="ISA 29:23">na wɔde fɛre agyina Israel Nyankopɔn no anim.<verse eid="ISA 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24"/>Wɔn a wɔfom kwan wɔ honhom mu benya ntease;</para>
  <para style="q2" vid="ISA 29:24">wɔn a wonwiinwii nso begye nkyerɛkyerɛ ato mu.”<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">Munnue, Ɔman Asoɔdenfo</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1"/>“Munnue mmofra asoɔdenfo,”</para>
  <para style="q2" vid="ISA 30:1">sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q1" vid="ISA 30:1">“Wɔn a wɔde nhyehyɛe a emfi me yɛ adwuma,</para>
  <para style="q2" vid="ISA 30:1">na wɔyɛ apam a emfi me honhom mu,</para>
  <para style="q2" vid="ISA 30:1">na wɔboaboa bɔne ano;<verse eid="ISA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2"/>wɔn a wɔkɔ Misraim</para>
  <para style="q2" vid="ISA 30:2">a wommisa me ansa;</para>
  <para style="q1" vid="ISA 30:2">wɔhwehwɛ mmoa a ɛyɛ bammɔ fi Farao nkyɛn,</para>
  <para style="q2" vid="ISA 30:2">wɔkɔ Misraim kɔhwehwɛ hintabea.<verse eid="ISA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3"/>Nanso Farao bammɔ bɛyɛ animguase ama mo,</para>
  <para style="q2" vid="ISA 30:3">Misraim nwini de ahohora bɛbrɛ mo.<verse eid="ISA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4"/>Ɛwɔ mu, wɔwɔ adwumayɛfo wɔ Soan</para>
  <para style="q2" vid="ISA 30:4">na wɔn ananmusifo adu Hanes de,<verse eid="ISA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5"/>nanso wɔn nyinaa anim begu ase</para>
  <para style="q2" vid="ISA 30:5">nnipa bi a wɔn so nni wɔn mfaso nti,</para>
  <para style="q1" vid="ISA 30:5">wɔmmfa mmoa anaa mfaso mma,</para>
  <para style="q2" vid="ISA 30:5">na mmom animguase ne ahohora.”<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>Adehunu a ɛfa Negeb mmoa ho:</para>
  <para style="q1" vid="ISA 30:6">wɔfa ahokyere ne ahohiahia asase so,</para>
  <para style="q2" vid="ISA 30:6">nea gyata ne gyatabere,</para>
  <para style="q2" vid="ISA 30:6">nhurutoa ne awɔ a wɔn ho yɛ hare wɔ,</para>
  <para style="q1" vid="ISA 30:6">ananmusifo no de wɔn ahonyade soa mfurum</para>
  <para style="q2" vid="ISA 30:6">ne wɔn ademude wɔ yoma afu so,</para>
  <para style="q1" vid="ISA 30:6">de kɔ saa ɔman a ne so nni mfaso no so,<verse eid="ISA 30:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7"/>de kɔ Misraim a ne mmoa so nni mfaso,</para>
  <para style="q1" vid="ISA 30:7">enti mefrɛ no</para>
  <para style="q2" vid="ISA 30:7">Rahab nea Onsi Hwee.<verse eid="ISA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8"/>Kɔ afei, kyerɛw wɔ kyerɛwpon so ma wɔn,</para>
  <para style="q2" vid="ISA 30:8">kurukyerɛw wɔ nhoma mmobɔwee so</para>
  <para style="q1" vid="ISA 30:8">sɛnea nna a ɛreba no mu no</para>
  <para style="q2" vid="ISA 30:8">ɛbɛyɛ adansede a ɛbɛtena hɔ afebɔɔ.<verse eid="ISA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9"/>Saa nnipa yi yɛ atuatewfo, mma asisifo,</para>
  <para style="q2" vid="ISA 30:9">mma a wɔmpɛ sɛ wotie <char style="nd">Awurade</char> nkyerɛkyerɛ.<verse eid="ISA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10"/>Wɔka kyerɛ adehufo se,</para>
  <para style="q2" vid="ISA 30:10">“Munhu mo ani so ade bio!”</para>
  <para style="q1" vid="ISA 30:10">ne adiyifo no nso se,</para>
  <para style="q2" vid="ISA 30:10">“Monnka anisoadehu a ɛyɛ nokware no nkyerɛ yɛn bio!</para>
  <para style="q1" vid="ISA 30:10">Monka abodwosɛm nkyerɛ yɛn,</para>
  <para style="q2" vid="ISA 30:10">monhyɛ nnaadaa nkɔm.<verse eid="ISA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11"/>Mumfi saa ɔtempɔn yi so,</para>
  <para style="q2" vid="ISA 30:11">momman mfi saa ɔkwan yi ho</para>
  <para style="q1" vid="ISA 30:11">na munnyae Israel Kronkronni</para>
  <para style="q2" vid="ISA 30:11">a mode no haw yɛn yi!”<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>Enti sɛɛ na Israel Ɔkronkronni no se:</para>
  <para style="q1" vid="ISA 30:12">“Esiane sɛ moapo saa nkra yi,</para>
  <para style="q2" vid="ISA 30:12">na mode mo ho ato nhyɛso</para>
  <para style="q2" vid="ISA 30:12">ne nnaadaa so nti,<verse eid="ISA 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13"/>saa bɔne yi bɛyɛ sɛ</para>
  <para style="q2" vid="ISA 30:13">ɔfasu tenten bi a ahyɛ kam na akyea</para>
  <para style="q2" vid="ISA 30:13">na ebu mpofirim, ama mo.<verse eid="ISA 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14"/>Ebebubu nketenkete ayɛ sɛ kuku.</para>
  <para style="q2" vid="ISA 30:14">Ɛbɛyam pasaa a,</para>
  <para style="q1" vid="ISA 30:14">sin koraa renka a</para>
  <para style="q2" vid="ISA 30:14">wobetumi de asɔ gya afi muka mu</para>
  <para style="q2" vid="ISA 30:14">anaa wɔde bɛsaw nsu afi ahina mu.”<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>Sɛɛ na Otumfo <char style="nd">Awurade</char>, Israel Kronkronni no se:</para>
  <para style="q1" vid="ISA 30:15">“Ahonu mu ne ntoboase mu na mo nkwagye wɔ</para>
  <para style="q2" vid="ISA 30:15">kommyɛ ne ahotoso mu na mo ahoɔden wɔ,</para>
  <para style="q2" vid="ISA 30:15">nanso, morennya mu biara.<verse eid="ISA 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16"/>Mokaa se, ‘Dabi da, yɛbɛtena apɔnkɔ so aguan.’</para>
  <para style="q2" vid="ISA 30:16">Enti mubeguan!</para>
  <para style="q1" vid="ISA 30:16">Mokaa se, ‘yɛbɛtena apɔnkɔ a wɔn ho yɛ hare so akɔ.’</para>
  <para style="q2" vid="ISA 30:16">Enti wɔn a wɔtaa mo no ho bɛyɛ hare!<verse eid="ISA 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17"/>Apem beguan</para>
  <para style="q2" vid="ISA 30:17">ɔbaako ho hu nti;</para>
  <para style="q1" vid="ISA 30:17">baanum ho hu nti</para>
  <para style="q2" vid="ISA 30:17">mo nyinaa beguan akɔ,</para>
  <para style="q1" vid="ISA 30:17">akosi sɛ wobegyaw mo</para>
  <para style="q2" vid="ISA 30:17">te sɛ frankaa dua a esi bepɔw atifi,</para>
  <para style="q2" vid="ISA 30:17">te sɛ frankaa a esi koko so.”<verse eid="ISA 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18"/>Nanso <char style="nd">Awurade</char> pɛ sɛ ɔdom mo;</para>
  <para style="q2" vid="ISA 30:18">ɔma ne ho so, kyerɛ wo nʼahummɔbɔ.</para>
  <para style="q1" vid="ISA 30:18">Efisɛ <char style="nd">Awurade</char> yɛ ɔtreneeni Nyankopɔn.</para>
  <para style="q2" vid="ISA 30:18">Nhyira ne wɔn a wɔtwɛn no nyinaa!<verse eid="ISA 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>Sionfo a mote Yerusalem, morentwa adwo bio. Sɛ musu frɛ no hwehwɛ mmoa a, ɔbɛdom mo! Sɛ ɔte a obegye mo so prɛko pɛ. <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>Ɛwɔ mu, Awurade brɛ mo amanehunu sɛ aduan ne ɔhaw sɛ nsu de, nanso, afei mubehu <char style="nd">Awurade</char>, mo kyerɛkyerɛfo no bio, na ɔbɛkyerɛ mo kwan. <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>Sɛ mofa nifa anaa benkum a, mobɛte nne bi wɔ mo akyi a ɛka se, “Ɔkwan no ni na momfa so.” <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>Afei mobɛtow mo ahoni a mode dwetɛ adura ho ne nsɛsode a mode sikakɔkɔɔ afa ho no nyinaa agu. Mobɛtow wɔn agu sɛ ntamagow fi, na moaka kyerɛ wɔn se, “Mumfi yɛn so nkɔ.”<verse eid="ISA 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>Afei ɔde osu behyira mo bere a mudua nnuaba, na aduan a asase no bɛbɔ no bɛyɛ papa na ɛbɛdɔɔso nso. Da no, mo anantwi bedidi wɔ adidibea a ɛtrɛw so. <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>Mo anantwi ne mo mfurum a wofuntum asase no bɛwe atoko pa ne ne ntɛtɛ a, wɔde sofi ne nkorata trɛtrɛw mu. <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>Saa okum kɛse da no a abantenten ahwehwe ase no, nsuwa bɛteɛ wɔ bepɔw tenten ne koko a ɛkorɔn biara so. <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>Ɔsram bɛhyerɛn sɛ owia, na owia hyerɛn no bɛyɛ mpɛn ason, te sɛ nnafua ason mu hyerɛn, bere a <char style="nd">Awurade</char> kyekyere ne nkurɔfo akuru na ɔsa apirakuru a ɔde ama wɔn no.<verse eid="ISA 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27"/>Hwɛ! <char style="nd">Awurade</char> fi akyirikyiri reba,</para>
  <para style="q2" vid="ISA 30:27">ɔde abufuwhyew ne wusiw kumɔnn;</para>
  <para style="q1" vid="ISA 30:27">abufuw ahyɛ nʼanom ma,</para>
  <para style="q2" vid="ISA 30:27">na ne tɛkrɛma yɛ ogya a ɛhyew nneɛma.<verse eid="ISA 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28"/>Ne home te sɛ asuworoe a ɛsen ntɛmntɛm,</para>
  <para style="q2" vid="ISA 30:28">na ɛforo kɔdeda kɔn mu.</para>
  <para style="q1" vid="ISA 30:28">Ɔwosow aman no wɔ ɔsɛe sɔnee so;</para>
  <para style="q2" vid="ISA 30:28">ɔde nnareka a ɛma wɔfom kwan</para>
  <para style="q2" vid="ISA 30:28">hyehyɛ nnipa no nnyepi.<verse eid="ISA 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29"/>Na mobɛto dwom</para>
  <para style="q2" vid="ISA 30:29">te sɛ anadwo a mudi afahyɛ kronkron no;</para>
  <para style="q1" vid="ISA 30:29">mo koma bedi ahurusi</para>
  <para style="q2" vid="ISA 30:29">te sɛ bere a nnipa de atɛntɛbɛn foro</para>
  <para style="q1" vid="ISA 30:29">kɔ <char style="nd">Awurade</char> bepɔw no so,</para>
  <para style="q2" vid="ISA 30:29">kɔ Israel Ɔbotan no nkyɛn.<verse eid="ISA 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30"/>
    <char style="nd">Awurade</char> bɛma nnipa ate nʼabrɛmpɔnnne</para>
  <para style="q2" vid="ISA 30:30">na ɔbɛma wɔahu ne basa a ɛresian</para>
  <para style="q1" vid="ISA 30:30">na ɛde abufuwhyew ne ogya a ɛhyew nneɛma</para>
  <para style="q2" vid="ISA 30:30">osu dennen, aprannaa ne mparuwbo reba.<verse eid="ISA 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31"/>
    <char style="nd">Awurade</char> nne bɛhwe Asiria;</para>
  <para style="q2" vid="ISA 30:31">ɔde nʼabaa bɛbɔ wɔn ahwe fam.<verse eid="ISA 30:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32"/>Ɔbɛbɔ wɔn wɔ ɔko mu,</para>
  <para style="q2" vid="ISA 30:32">na bere biara a ɔbɛbɔ wɔn no</para>
  <para style="q2" vid="ISA 30:32">ɛbɛyɛ sɛ akasae ne sankuten so nnwonto koro.<verse eid="ISA 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33"/>Wɔasiesie Topet dedaada;</para>
  <para style="q2" vid="ISA 30:33">wɔayɛ no krado ama ɔhene no.</para>
  <para style="q1" vid="ISA 30:33">Wɔahyehyɛ ogya ne nnyentia bebree</para>
  <para style="q2" vid="ISA 30:33">wɔ ne gya amoa no a emu dɔ na ɛtrɛw no mu;</para>
  <para style="q1" vid="ISA 30:33">
    <char style="nd">Awurade</char> home</para>
  <para style="q2" vid="ISA 30:33">te sɛ sufre asuten no</para>
  <para style="q2" vid="ISA 30:33">bɛsɔ mu gya.<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">Wɔn A Wɔde Wɔn Ho To Misraim So No Nnue</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1"/>Wonnue, wɔn a wɔkɔ Misraim kɔhwehwɛ mmoa,</para>
  <para style="q2" vid="ISA 31:1">wɔn a wɔde wɔn ho to apɔnkɔ so,</para>
  <para style="q1" vid="ISA 31:1">wɔn a wogye wɔn nteaseɛnam dodow</para>
  <para style="q2" vid="ISA 31:1">ne wɔn apɔnkɔsotefo ahoɔden mmoroso no di,</para>
  <para style="q1" vid="ISA 31:1">na wɔnhwɛ Israel Kronkronni no,</para>
  <para style="q2" vid="ISA 31:1">anaasɛ wɔmpɛ mmoa mfi <char style="nd">Awurade</char> hɔ.<verse eid="ISA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2"/>Nanso <char style="nd">Awurade</char> yɛ onyansafo a obetumi de ɔhaw aba;</para>
  <para style="q2" vid="ISA 31:2">ɔnsesa nʼano.</para>
  <para style="q1" vid="ISA 31:2">Ɔbɛsɔre atia amumɔyɛfo fi,</para>
  <para style="q2" vid="ISA 31:2">ne wɔn a wɔboa nnebɔneyɛfo.<verse eid="ISA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3"/>Na Misraimfo yi yɛ nnipa kɛkɛ, wɔnyɛ Onyankopɔn.</para>
  <para style="q2" vid="ISA 31:3">Wɔn apɔnkɔ yɛ ɔhonam na wɔnyɛ honhom.</para>
  <para style="q1" vid="ISA 31:3">Sɛ <char style="nd">Awurade</char> teɛ ne nsa a,</para>
  <para style="q2" vid="ISA 31:3">ɔboafo bɛwatiri</para>
  <para style="q2" vid="ISA 31:3">na nea wɔboa no no bɛhwe ase;</para>
  <para style="q2" vid="ISA 31:3">wɔn baanu bɛbɔ mu asɛe.<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>Sɛɛ na <char style="nd">Awurade</char> ka kyerɛ me:</para>
  <para style="q2" vid="ISA 31:4">“Sɛnea gyata woro so,</para>
  <para style="q1" vid="ISA 31:4">sɛnea gyata kokroo woro so gu ne hanam so no</para>
  <para style="q2" vid="ISA 31:4">a mpo sɛ wɔfrɛ nguanhwɛfo dɔm kɔ no so a,</para>
  <para style="q1" vid="ISA 31:4">wɔn nteɛteɛmu mmɔ no hu</para>
  <para style="q2" vid="ISA 31:4">na wɔn huuyɛ nso nhaw no no,</para>
  <para style="q1" vid="ISA 31:4">saa ara na Asafo <char style="nd">Awurade</char> besian</para>
  <para style="q2" vid="ISA 31:4">abɛko wɔ Sion Bepɔw ne ne sorɔnsorɔmmea so.<verse eid="ISA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5"/>Sɛnea nnomaa tu gyina faako wɔ wim no</para>
  <para style="q2" vid="ISA 31:5">saa ara na Asafo <char style="nd">Awurade</char> bɛbɔ Yerusalem ho ban;</para>
  <para style="q1" vid="ISA 31:5">ɔbɛbɔ ne ho ban na wagye no,</para>
  <para style="q2" vid="ISA 31:5">obegyaa no na wagye no asi hɔ.”<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>Monsan nkɔ nea moayɛ dɔm atia no no nkyɛn, Israelfo. <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>Da no mo mu biara bɛpo dwetɛ ne sikakɔkɔɔ ahoni a mode mo nsa a ɛho agu fi ayɛ no.<verse eid="ISA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8"/>“Asiria bɛhwe ase wɔ afoa a ɛnyɛ onipa de ano;</para>
  <para style="q2" vid="ISA 31:8">afoa a ɛnyɛ onipa de bɛsɛe wɔn.</para>
  <para style="q1" vid="ISA 31:8">Wobeguan afi afoa no ano</para>
  <para style="q2" vid="ISA 31:8">na wɔbɛma wɔn mmerante ayɛ ɔhyɛ adwuma.<verse eid="ISA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9"/>Wɔn abandennen bebubu, ehu nti;</para>
  <para style="q2" vid="ISA 31:9">wohu akofo frankaa a, wɔn asraafo mpanyimfo bɛbɔ huboa,”</para>
  <para style="q1" vid="ISA 31:9">sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 31:9">nea ne gya wɔ Sion,</para>
  <para style="q2" vid="ISA 31:9">na ne fononoo si Yerusalem no.<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s1">Trenee Ahenni</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1"/>Hwɛ, ɔhene bi bedi hene wɔ trenee mu</para>
  <para style="q2" vid="ISA 32:1">na ahemfo de atɛntrenee adi nnipa so.<verse eid="ISA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2"/>Onipa biara bɛyɛ mframa ano hintabea</para>
  <para style="q2" vid="ISA 32:2">ne ahum mu guankɔbea,</para>
  <para style="q1" vid="ISA 32:2">ɔbɛyɛ sɛ nsuwansuwa a ɛwɔ nweatam so</para>
  <para style="q2" vid="ISA 32:2">ne ɔbotan kɛse sunsuma a ɛwɔ osukɔm asase so.<verse eid="ISA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3"/>Wɔn a wohu no ani renkata bio,</para>
  <para style="q2" vid="ISA 32:3">na wɔn a wɔte asɛm no aso betie.<verse eid="ISA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4"/>Nea ɔyɛ adwene mu hare behu na wate ase,</para>
  <para style="q2" vid="ISA 32:4">wɔn a wɔpo dodow bɛkasa na mu ada hɔ.<verse eid="ISA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5"/>Wɔremfrɛ ɔkwasea sɛ onuonyamfo bio</para>
  <para style="q2" vid="ISA 32:5">na wɔremfa nidi mma apapahwekwa.<verse eid="ISA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6"/>Ɔkwasea ka nkwaseasɛm</para>
  <para style="q2" vid="ISA 32:6">na osusuw bɔne ho:</para>
  <para style="q1" vid="ISA 32:6">ɔyɛ anyame apɛde</para>
  <para style="q2" vid="ISA 32:6">ɔka <char style="nd">Awurade</char> ho nsɛm a enye;</para>
  <para style="q1" vid="ISA 32:6">ɔmma nea ɔkɔm de no no aduan</para>
  <para style="q2" vid="ISA 32:6">ɔde nsu kame nea osukɔm de no.<verse eid="ISA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7"/>Apapahwekwa akwan yɛ amumɔyɛ,</para>
  <para style="q2" vid="ISA 32:7">ɔyɛ bɔne ho nhyehyɛe</para>
  <para style="q1" vid="ISA 32:7">de atoro sɛe ohiani,</para>
  <para style="q2" vid="ISA 32:7">wɔ bere a ohiani asɛm yɛ nokware mpo.<verse eid="ISA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8"/>Nanso onuonyamfo yɛ nhyehyɛe a ɛho wɔ nyam</para>
  <para style="q2" vid="ISA 32:8">na nneyɛe pa no nti ɔda nsow.<verse eid="ISA 32:8"/></para>
  <para style="s1">Yerusalem Mmabaa</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9"/>Mo mmea a mugye mo ho di,</para>
  <para style="q2" vid="ISA 32:9">monsɔre na muntie me;</para>
  <para style="q1" vid="ISA 32:9">mo mmabea a mususuw sɛ mowɔ bammɔ</para>
  <para style="q2" vid="ISA 32:9">monyɛ aso mma nea mewɔ ka!<verse eid="ISA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10"/>Afe akyi nna kakra bi no</para>
  <para style="q2" vid="ISA 32:10">mo a mugye di sɛ mowɔ bammɔ ho bɛpopo;</para>
  <para style="q1" vid="ISA 32:10">bobe twabere no bedi mo huammɔ,</para>
  <para style="q2" vid="ISA 32:10">nnuaba no twabere nso remma.<verse eid="ISA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11"/>Mo ho mpopo, mo mmea a mugye mo ho di</para>
  <para style="q2" vid="ISA 32:11">mommɔ hu, mo mmabea a mugye di sɛ mowɔ bammɔ!</para>
  <para style="q1" vid="ISA 32:11">Mompa mo ho ntama</para>
  <para style="q2" vid="ISA 32:11">na momfa atweaatam mmɔ mo asen.<verse eid="ISA 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12"/>Mommobɔ mo koko so sɛ mowɔ mfuw afɛfɛ</para>
  <para style="q2" vid="ISA 32:12">ne bobe a ɛso no nti,<verse eid="ISA 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13"/>ne me nkurɔfo asase,</para>
  <para style="q2" vid="ISA 32:13">asase a nsɔe ne nnɛnkyɛnse agye afa.</para>
  <para style="q1" vid="ISA 32:13">Yiw, montwa adwo mma afi a wogye wɔn ani wɔ mu</para>
  <para style="q2" vid="ISA 32:13">ne saa ahosɛpɛw kuropɔn yi.<verse eid="ISA 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14"/>Wobegyaw aban no hɔ,</para>
  <para style="q2" vid="ISA 32:14">na gyegyeegye kuropɔn no ada mpan;</para>
  <para style="q1" vid="ISA 32:14">abanwa ne ɔwɛn aban bɛdan asasehunu afebɔɔ,</para>
  <para style="q2" vid="ISA 32:14">nea mfurum pɛ ne nguankuw didibea,<verse eid="ISA 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15"/>kosi sɛ wobehwie honhom afi ɔsoro agu yɛn so,</para>
  <para style="q2" vid="ISA 32:15">na nweatam bɛdan asasebere</para>
  <para style="q2" vid="ISA 32:15">na asasebere ayɛ sɛ kwae.<verse eid="ISA 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16"/>Trenee bɛtena nweatam so</para>
  <para style="q2" vid="ISA 32:16">na adetreneeyɛ atena asasebere so.<verse eid="ISA 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17"/>Adetreneeyɛ bɛsow asomdwoe aba;</para>
  <para style="q2" vid="ISA 32:17">nea adetreneeyɛ de ba no bɛyɛ kommyɛ ne ahotoso a enni awiei.<verse eid="ISA 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18"/>Me nkurɔfo bɛtenatena mmeae a asomdwoe wɔ</para>
  <para style="q2" vid="ISA 32:18">afi a wɔabɔ ho ban</para>
  <para style="q2" vid="ISA 32:18">homebea a ɔhaw biara nni hɔ.<verse eid="ISA 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19"/>Mpo sɛ mparuwbo sɛe kwae no</para>
  <para style="q2" vid="ISA 32:19">na kuropɔn no sɛe koraa a,<verse eid="ISA 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20"/>wobehyira wo,</para>
  <para style="q2" vid="ISA 32:20">wubedua wʼaba wɔ nsuwa biara ho,</para>
  <para style="q2" vid="ISA 32:20">na wama wʼanantwi ne wo mfurum anantew baabiara.<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">Ahohia Ne Mmoa</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1"/>Due, ɔdesɛefo,</para>
  <para style="q2" vid="ISA 33:1">wo a wɔnsɛee wo!</para>
  <para style="q1" vid="ISA 33:1">Due, ɔfatwafo,</para>
  <para style="q2" vid="ISA 33:1">wo a wonnii wo huammɔ!</para>
  <para style="q1" vid="ISA 33:1">sɛ wugyae adesɛe a,</para>
  <para style="q2" vid="ISA 33:1">wɔbɛsɛe wo;</para>
  <para style="q1" vid="ISA 33:1">sɛ wuwie huammɔdi a,</para>
  <para style="q2" vid="ISA 33:1">wobedi wo huammɔ.<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2"/>Ao <char style="nd">Awurade</char>, hu yɛn mmɔbɔ;</para>
  <para style="q2" vid="ISA 33:2">yɛn ani da wo so.</para>
  <para style="q1" vid="ISA 33:2">Yɛ yɛn ahoɔden anɔpa biara,</para>
  <para style="q2" vid="ISA 33:2">ne yɛn nkwagye wɔ ahohia mu.<verse eid="ISA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3"/>Aman no te wo nne mmubomu a, woguan;</para>
  <para style="q2" vid="ISA 33:3">sɛ woma wo ho so a amanaman no bɔ ahwete.<verse eid="ISA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4"/>Wɔtase mo asade, Ao amanaman, sɛnea mmoadabimma yɛ;</para>
  <para style="q2" vid="ISA 33:4">nnipa tow hyɛ so te sɛ mmoadabi dɔm.<verse eid="ISA 33:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5"/>Wɔama <char style="nd">Awurade</char> so, na ɔte ɔsorosoro;</para>
  <para style="q2" vid="ISA 33:5">ɔde trenee ne adetreneeyɛ bɛhyɛ Sion ma.<verse eid="ISA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6"/>Ɔbɛyɛ fapem a atim yiye wɔ mo mmere so,</para>
  <para style="q2" vid="ISA 33:6">nkwagye, nyansa ne nhumu mmoroso akorae;</para>
  <para style="q2" vid="ISA 33:6">
    <char style="nd">Awurade</char> suro ne ademude yi akorae ano safe.<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7"/>Monhwɛ, wɔn mmarima akokodurufo su teɛteɛɛ mu wɔ mmɔnten so;</para>
  <para style="q2" vid="ISA 33:7">asomdwoe ho abɔfo su yayaayaw.<verse eid="ISA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8"/>Atempɔn no so da hɔ kwa,</para>
  <para style="q2" vid="ISA 33:8">akwantufo biara nni akwan no so.</para>
  <para style="q1" vid="ISA 33:8">Wɔabu apam no so,</para>
  <para style="q2" vid="ISA 33:8">wobu nʼadansefo animtiaa</para>
  <para style="q2" vid="ISA 33:8">wommu obiara.<verse eid="ISA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9"/>Asase no wo kesee na ɛsɛe,</para>
  <para style="q2" vid="ISA 33:9">Lebanon agyigya na nʼanim agu ase;</para>
  <para style="q1" vid="ISA 33:9">Saron ayɛ sɛ Araba,</para>
  <para style="q2" vid="ISA 33:9">Basan ne Karmel porow wɔn nhaban.<verse eid="ISA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10"/>“Afei na mɛsɔre,” sɛɛ na <char style="nd">Awurade</char> se.</para>
  <para style="q2" vid="ISA 33:10">“Afei na wɔbɛpagyaw me ɛ;</para>
  <para style="q2" vid="ISA 33:10">afei na wɔbɛma me so.<verse eid="ISA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11"/>Munyinsɛn ntɛtɛ,</para>
  <para style="q2" vid="ISA 33:11">na mowo sare;</para>
  <para style="q2" vid="ISA 33:11">mo home yɛ ogya a ɛhyew mo.<verse eid="ISA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12"/>Wɔbɛhyew aman no ama wɔatɔ nso;</para>
  <para style="q2" vid="ISA 33:12">wɔbɛto wɔn mu gya te sɛ nsɔe a wɔatwa.”<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13"/>Mo a mowɔ akyirikyiri no, muntie nea mayɛ;</para>
  <para style="q2" vid="ISA 33:13">mo a mobɛn no, monkamfo me kɛseyɛ!<verse eid="ISA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14"/>Nnebɔneyɛfo a wɔwɔ Sion abɔ huboa;</para>
  <para style="q2" vid="ISA 33:14">ahopopo aka wɔn a wonnim Onyame:</para>
  <para style="q1" vid="ISA 33:14">“Yɛn mu hena na obetumi ne ogya a ɛhyew ade atena?</para>
  <para style="q2" vid="ISA 33:14">Yɛn mu hena na obetumi ne daa ogyatannaa atena?”<verse eid="ISA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15"/>Nea ɔnantew trenee mu</para>
  <para style="q2" vid="ISA 33:15">na odi nokware</para>
  <para style="q1" vid="ISA 33:15">nea ɔpo mfaso a asisi de ba</para>
  <para style="q2" vid="ISA 33:15">na onnye adanmude,</para>
  <para style="q1" vid="ISA 33:15">nea ontie awudi ho pɔwbɔ</para>
  <para style="q2" vid="ISA 33:15">nea ɔmpɛ sɛ ohu bɔneyɛ ho agyinatu,<verse eid="ISA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16"/>saa onipa yi na ɔbɛtena ɔsorosoro hɔ,</para>
  <para style="q2" vid="ISA 33:16">ne guankɔbea bɛyɛ bepɔw aban no.</para>
  <para style="q1" vid="ISA 33:16">Wɔde nʼaduan bɛma no</para>
  <para style="q2" vid="ISA 33:16">na ne nsu remmɔ no.<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17"/>Mo ani behu ɔhene no wɔ nʼanuonyam mu</para>
  <para style="q2" vid="ISA 33:17">na ahwɛ asase a ɛtrɛw kɔ akyirikyiri no.<verse eid="ISA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18"/>Mo adwennwen mu, mobɛbooboo nea na ohunahuna mo no ho:</para>
  <para style="q2" vid="ISA 33:18">“Odwumayɛni panyin no wɔ he?</para>
  <para style="q1" vid="ISA 33:18">Nea na ogyigye tow no wɔ he?</para>
  <para style="q2" vid="ISA 33:18">Nea na ɔhwɛ abantenten so no wɔ he?”<verse eid="ISA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19"/>Morenhu saa ahantanfo no bio,</para>
  <para style="q2" vid="ISA 33:19">wɔn a wɔn kasa mu nna hɔ,</para>
  <para style="q2" vid="ISA 33:19">na monte nea wɔka no ase no.<verse eid="ISA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20"/>Monhwɛ Sion, yɛn afahyɛ kuropɔn no;</para>
  <para style="q2" vid="ISA 33:20">mo ani behu Yerusalem,</para>
  <para style="q2" vid="ISA 33:20">asomdwoe tenabea, ntamadan a wontutu;</para>
  <para style="q1" vid="ISA 33:20">wɔrentutu ne nnyinaso da,</para>
  <para style="q2" vid="ISA 33:20">na wɔrentetew ne ntampehama mu nso.<verse eid="ISA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21"/>Ɛhɔ na <char style="nd">Awurade</char> bɛyɛ yɛn Tumfo.</para>
  <para style="q2" vid="ISA 33:21">Ɛbɛyɛ sɛ faako a nsu akɛse ne nsuwansuwa wɔ.</para>
  <para style="q1" vid="ISA 33:21">Akorow a wɔhare remfa so</para>
  <para style="q2" vid="ISA 33:21">ahyɛn akɛse rennantew so.<verse eid="ISA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22"/>Na <char style="nd">Awurade</char> ne yɛn temmufo,</para>
  <para style="q2" vid="ISA 33:22">
    <char style="nd">Awurade</char> ne yɛn mmarahyɛfo,</para>
  <para style="q1" vid="ISA 33:22">
    <char style="nd">Awurade</char> ne yɛn hene;</para>
  <para style="q2" vid="ISA 33:22">na ɔno na obegye yɛn nkwa.<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23"/>Wo ntampehama mu agow</para>
  <para style="q2" vid="ISA 33:23">enti hyɛn dua no nni nnyinaso,</para>
  <para style="q1" vid="ISA 33:23">na wɔntrɛw hyɛn so ntama no mu.</para>
  <para style="q2" vid="ISA 33:23">Afei wɔbɛkyɛ asade bebree no mu</para>
  <para style="q2" vid="ISA 33:23">na mpakye mpo bɛsoa asade akɔ.<verse eid="ISA 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24"/>Obiara nni Sion a ɔbɛka se, “Meyare;”</para>
  <para style="q2" vid="ISA 33:24">na wɔde wɔn a wɔte hɔ no bɔne bɛkyɛ wɔn.<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">Atemmu A Etia Amanaman No</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1"/>Muntwiw mmɛn, mo amanaman, na muntie;</para>
  <para style="q2" vid="ISA 34:1">monyɛ aso, mo ɔmanfo!</para>
  <para style="q1" vid="ISA 34:1">Momma asase ne nea ɛwɔ so nyinaa ntie,</para>
  <para style="q2" vid="ISA 34:1">wiase ne nea efi mu ba nyinaa!<verse eid="ISA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2"/>
    <char style="nd">Awurade</char> bo afuw amanaman nyinaa;</para>
  <para style="q2" vid="ISA 34:2">nʼabufuwhyew no tia wɔn asraafo nyinaa.</para>
  <para style="q1" vid="ISA 34:2">Ɔbɛsɛe wɔn pasaa,</para>
  <para style="q2" vid="ISA 34:2">ɔbɛma wɔakunkum wɔn.<verse eid="ISA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3"/>Wɔbɛtow wɔn mu atɔfo no agu,</para>
  <para style="q2" vid="ISA 34:3">wɔn afunu no beyi hua;</para>
  <para style="q2" vid="ISA 34:3">wɔn mogya afɔw mmepɔw no.<verse eid="ISA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4"/>Ɔsoro nsoromma nyinaa bɛyera</para>
  <para style="q2" vid="ISA 34:4">na wɔbɛbobɔw ɔsoro te sɛ nhoma mmobɔwee;</para>
  <para style="q1" vid="ISA 34:4">ɔsoro atumfo bɛhwe ase</para>
  <para style="q2" vid="ISA 34:4">sɛnea nhaban tew fi bobe so,</para>
  <para style="q2" vid="ISA 34:4">sɛnea mman a awo pan fi borɔdɔma dua ho.<verse eid="ISA 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5"/>Mʼafoa anom nea ɛmee no no wɔ ɔsoro;</para>
  <para style="q2" vid="ISA 34:5">hwɛ, ɛresian de atemmu aba Edom so,</para>
  <para style="q2" vid="ISA 34:5">wɔn a masɛe wɔn koraa no.<verse eid="ISA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6"/>Mogya aguare <char style="nd">Awurade</char> afoa ho,</para>
  <para style="q2" vid="ISA 34:6">wɔde srade asra ho,</para>
  <para style="q1" vid="ISA 34:6">nguantenmma ne mmirekyi mogya,</para>
  <para style="q2" vid="ISA 34:6">adwennini asaabo mu srade.</para>
  <para style="q1" vid="ISA 34:6">
    <char style="nd">Awurade</char> wɔ afɔre bi bɔ wɔ Bosra</para>
  <para style="q2" vid="ISA 34:6">ne okum kɛse wɔ Edom.<verse eid="ISA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7"/>Anantwi anuɔdenfo ne wɔn bɛtotɔ,</para>
  <para style="q2" vid="ISA 34:7">anantwinini nketewa ne akɛse.</para>
  <para style="q1" vid="ISA 34:7">Mogya afɔw wɔn asase no,</para>
  <para style="q2" vid="ISA 34:7">na srade ayɛ so dɔte no sɔkyee.<verse eid="ISA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8"/>Na <char style="nd">Awurade</char> wɔ aweretɔ da</para>
  <para style="q2" vid="ISA 34:8">ananmuhyɛ afe, a obedi ama Sion.<verse eid="ISA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9"/>Edom nsuwansuwa bɛdan agodibea,</para>
  <para style="q2" vid="ISA 34:9">ne dɔte bɛdan sufre a ɛdɛw</para>
  <para style="q2" vid="ISA 34:9">nʼasase bɛyɛ agoprama a ɛdɛw!<verse eid="ISA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10"/>Ɛrennum awia anaa anadwo;</para>
  <para style="q2" vid="ISA 34:10">ne wusiw befi a ɛto rentwa da.</para>
  <para style="q1" vid="ISA 34:10">Ɛbɛda mpan fi awo ntoatoaso akosi awo ntoatoaso;</para>
  <para style="q2" vid="ISA 34:10">obiara remfa ho bio koraa.<verse eid="ISA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11"/>Nweatam so patu ne ɔbonsamnoma</para>
  <para style="q2" vid="ISA 34:11">begye hɔ afa;</para>
  <para style="q1" vid="ISA 34:11">patu ne kwaakwaadabi bɛtena hɔ.</para>
  <para style="q2" vid="ISA 34:11">Onyankopɔn bɛtwe wɔ Edom so</para>
  <para style="q1" vid="ISA 34:11">basabasayɛ susuhama</para>
  <para style="q2" vid="ISA 34:11">ne amamfoyɛ kirebennyɛ susudua.<verse eid="ISA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12"/>Nʼatitiriw rennya biribiara a ɛbɛma wɔafrɛ no ahenni,</para>
  <para style="q2" vid="ISA 34:12">nʼahenemma mmarima nyinaa betu ayera.<verse eid="ISA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13"/>Nsɔe begye nʼabankɛse afa,</para>
  <para style="q2" vid="ISA 34:13">nsansono ne nsɔe befuw wɔ nʼabankɛse hɔ.</para>
  <para style="q1" vid="ISA 34:13">Hɔ bɛyɛ adompo atu,</para>
  <para style="q2" vid="ISA 34:13">ne mpatu tenabea.<verse eid="ISA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14"/>Nweatam so mmoa ne mpataku behyia adi afra,</para>
  <para style="q2" vid="ISA 34:14">mmirekyi anuɔdenfo besu akyerɛ wɔn ho wɔn ho;</para>
  <para style="q1" vid="ISA 34:14">hɔ na anadwommoa bɛdeda</para>
  <para style="q2" vid="ISA 34:14">na wɔde ayɛ wɔn homebea.<verse eid="ISA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15"/>Ɛhɔ na patu bɛyɛ ne berebuw, na watow ne nkesua.</para>
  <para style="q2" vid="ISA 34:15">Obesow ne mma, na ɔde ne ntaban akata wɔn so;</para>
  <para style="q1" vid="ISA 34:15">ɛhɔ na nkorɔma bɛboaboa wɔn ho ano,</para>
  <para style="q2" vid="ISA 34:15">obiara ne nea ɔka ne ho.<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>Hwɛ <char style="nd">Awurade</char> nhoma mmobɔwee no mu, na kenkan:</para>
  <para style="q1" vid="ISA 34:16">Eyinom mu biara renyera,</para>
  <para style="q2" vid="ISA 34:16">obiara benya nea ɔka ne ho.</para>
  <para style="q1" vid="ISA 34:16">Efisɛ nʼanom na ɔhyɛ asɛm no fi,</para>
  <para style="q2" vid="ISA 34:16">na ne honhom bɛboaboa wɔn ano.<verse eid="ISA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17"/>Ɔde wɔn kyɛfa ma wɔn;</para>
  <para style="q2" vid="ISA 34:17">ɔde ne nsa yɛ susudua kyekyɛ.</para>
  <para style="q1" vid="ISA 34:17">Wɔbɛfa no sɛ wɔn de afebɔɔ</para>
  <para style="q2" vid="ISA 34:17">na wofi awo ntoatoaso akosi awo ntoatoaso atena hɔ.<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">Wɔn A Wɔagye Wɔn No Ahosɛpɛw</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1"/>Nweatam ne asase a awo no ani begye;</para>
  <para style="q2" vid="ISA 35:1">sare bedi ahurusi na ayɛ frɔmfrɔm.</para>
  <para style="q1" vid="ISA 35:1">Te sɛ nhwiren no, <verse eid="ISA 35:1"/><verse number="2" style="v" sid="ISA 35:2"/>ɛbɛpae ayɛ fɛfɛɛfɛ</para>
  <para style="q2" vid="ISA 35:2">ebedi ahurusi na ɛde anigye ateɛ mu,</para>
  <para style="q1" vid="ISA 35:2">wɔde Lebanon anuonyam bɛma no</para>
  <para style="q2" vid="ISA 35:2">Karmel ne Saron ahoɔfɛ;</para>
  <para style="q1" vid="ISA 35:2">wobehu <char style="nd">Awurade</char> anuonyam,</para>
  <para style="q2" vid="ISA 35:2">yɛn Nyankopɔn tumi no.<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3"/>Hyɛ nsa a emu agow no mu den,</para>
  <para style="q2" vid="ISA 35:3">hyɛ nkotodwe a ahodwow no mu den;<verse eid="ISA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4"/>Ka kyerɛ wɔn a wɔn koma atu no se,</para>
  <para style="q2" vid="ISA 35:4">“Monhyɛ mo ho den, na munnsuro;</para>
  <para style="q1" vid="ISA 35:4">mo Nyankopɔn bɛba,</para>
  <para style="q2" vid="ISA 35:4">ɔde aweretɔ bɛba;</para>
  <para style="q1" vid="ISA 35:4">ananmuhyɛ a efi ɔsoro</para>
  <para style="q2" vid="ISA 35:4">bɛba abegye mo nkwa.”<verse eid="ISA 35:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5"/>Ɛno na wobebue anifuraefo ani,</para>
  <para style="q2" vid="ISA 35:5">na wɔama asotifo aso ate asɛm.<verse eid="ISA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6"/>Ɛno na mpakye behuruw te sɛ ɔforote,</para>
  <para style="q2" vid="ISA 35:6">na mum tɛkrɛma de anigye ateɛ mu.</para>
  <para style="q1" vid="ISA 35:6">Nsu betue wɔ sare so,</para>
  <para style="q2" vid="ISA 35:6">na nsuwansuwa apue wɔ nweatam so.<verse eid="ISA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7"/>Nwea a so yɛ hyew no bɛdan ɔtare,</para>
  <para style="q2" vid="ISA 35:7">na nsuwansuwa atue wɔ asase wosee so.</para>
  <para style="q1" vid="ISA 35:7">Atu a anka sakraman te mu no,</para>
  <para style="q2" vid="ISA 35:7">ɛhɔ na sare ne demmire ne paparɔso befifi.<verse eid="ISA 35:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8"/>Na ɔtempɔn bɛda hɔ;</para>
  <para style="q2" vid="ISA 35:8">wɔbɛfrɛ no Ahotefo Kwan.</para>
  <para style="q1" vid="ISA 35:8">Wɔn a wɔn ho ntew rentu kwan wɔ so;</para>
  <para style="q2" vid="ISA 35:8">ɛbɛda hɔ ama wɔn a wɔnantew saa Kwan no so;</para>
  <para style="q2" vid="ISA 35:8">amumɔyɛfo nkwaseafo rennantenantew so.<verse eid="ISA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9"/>Gyata biara rentena hɔ,</para>
  <para style="q2" vid="ISA 35:9">na akekaboa biara rensi so;</para>
  <para style="q2" vid="ISA 35:9">wɔrenhu wɔn wɔ hɔ.</para>
  <para style="q1" vid="ISA 35:9">Na wɔn a wɔagye wɔn nko ara na wɔbɛfa so,<verse eid="ISA 35:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10"/>na wɔn a <char style="nd">Awurade</char> agye wɔn no bɛsan aba.</para>
  <para style="q1" vid="ISA 35:10">Wɔde nnwonto bɛhyɛn Sion;</para>
  <para style="q2" vid="ISA 35:10">anigye a ɛnsa da bɛyɛ wɔn ahenkyɛw.</para>
  <para style="q1" vid="ISA 35:10">Wobenya anigye ne ahosɛpɛw mmoroso,</para>
  <para style="q2" vid="ISA 35:10">na awerɛhow ne apinisi beguan akɔ.<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s1">Sanaherib Hunahuna Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>Ɔhene Hesekia adedi mfe dunan so no, Asiriahene Sanaherib bɛtow hyɛɛ Yuda nkuropɔn a wɔabɔ ho ban no so dii so. <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>Afei Asiriahene somaa nʼananmusifo fi Lakis a asraafo dɔm kɛse ka ne ho kohyiaa Ɔhene Hesekia wɔ Yerusalem. Bere a ɔsahene begyinaa nsudorobɛn bi a efi Atifi Tare de kɔ Ntamahorofo Atenae hɔ no, <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>Hilkia babarima Eliakim a na ɔhwɛ ahemfi no ntotoe so; Sebna a na ɔyɛ ɔkyerɛwfo ne Asaf babarima Yoa a na ɔno nso yɛ ɔkyerɛwfo kohyiaa no.<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>Na ɔsahene no ka kyerɛɛ wɔn se, “Monka nkyerɛ Hesekia se,</para>
  <para style="pm" vid="ISA 36:4">“ ‘Asɛm a otumfo, Asiriahene ka ni: Dɛn na wode wo ho to so a ɛma wugye wo ho di saa? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>Woka se wowɔ akodi ho nyansa ne nʼahoɔden, nanso woka nsɛm hunu. Hena na ɔtaa wʼakyi a enti wotew mʼanim atua? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>Hwɛ wʼani da Misraim so, demmire a emu abu a ɛte sɛ pema a wutweri a ɛbɛwɔ wo nsa mu apira wo no! Saa na Misraimhene Farao te ma wɔn a wɔde wɔn ho to ne so no nyinaa. <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>Ebia wobɛka se, “Yɛde yɛn ho to <char style="nd">Awurade</char>, yɛn Nyankopɔn so!” Ɛnyɛ ɔno na ɔhene Hesekia atutu nʼabosonnan ne afɔremuka nyinaa, ahyɛ Yudafo sɛ wɔnsom wɔ afɔremuka a ɛwɔ Yerusalem ha nko ara so no?<verse eid="ISA 36:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8"/>“ ‘Mɛka asɛm bi akyerɛ wo! Me wura Asiriahene ne wo bɛyɛ nhyehyɛe bi. Sɛ wubenya apɔnkɔsotefo mpenu, afi wo asraafo mu a, ɔbɛma wɔn apɔnkɔ mpenu ama wɔatenatena wɔn so. <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>Na wʼasraafo ketewa sɛɛ yi, ɛbɛyɛ dɛn na woaso dae, sɛ wubetumi ne me wura asraafo no mu fa bi a wɔyɛ mmerɛw no mpo adi asi. Minim sɛ wode wo ho ato Misraim nteaseɛnam ne apɔnkɔsotefo mmoa so. <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>Bio, wugye di sɛ, maba sɛ merebɛtow ahyɛ asase yi so asɛe no kwa a <char style="nd">Awurade</char> nsa nni mu? <char style="nd">Awurade</char> ankasa ka kyerɛɛ me se menkɔko ntia saa asase yi na mensɛe no.’ ”<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>Na Eliakim, Sebna ne Yoa ka kyerɛɛ ɔsahene no se, “Yɛsrɛ mo, monka Arameike kasa nkyerɛ mo asomfo, efisɛ, yɛte ase yiye. Monnka Hebri<note caller="+" style="f"><char style="fr" closed="false">36.11 </char><char style="ft" closed="false">Hebri kasa yɛɛ kasa a na wɔde di nkitaho saa bere no. Efi 5 AWK no, Hebri kasa bɛyɛɛ Yudafo kasa.</char></note> na nnipa a wɔwɔ ɔfasu no so no bɛte ase.”<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>Na Senaherib nanmusini no buae se, “Me wura pɛ sɛ obiara a ɔwɔ Yerusalem te saa asɛm yi, na ɛnyɛ mo nko. Ɔpɛ sɛ wɔte sɛ, sɛ moamma mo nsa so a, wobetua kuropɔn yi. Ɔkɔm ne osukɔm werɛmfo bɛde nkurɔfo no ara kosi sɛ, wobedi wɔn ara agyanan, anom wɔn dwonsɔ.”<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>Afei ɔsahene no sɔre gyina kasaa wɔ Hebri mu se, “Muntie saa nkra yi a efi ɔhempɔn, Asiriahene nkyɛn no! <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>Sɛnea ɔhene no se ni: Mommma Hesekia nnaadaa mo. Ɔrentumi nnye mo! <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>Mommma Hesekia mfa saa asɛm a ɔkae se, ‘<char style="nd">Awurade</char> begye yɛn! Wɔremfa saa kurow yi mma Asiriahene’ no mma mo tirim nyɛ mo dɛ.<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“Munntie Hesekia. Nea Asiriahene ka ni: Mo ne me nyɛ asomdwoe nhyehyɛe na mommra me nkyɛn. Na afei, mɛma mo mu biara adi ɔno ankasa bobe ne borɔdɔma na woanom nsu afi ɔno ankasa abura mu, <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>kosi sɛ mɛba abɛfa mo akɔ asase a ɛte sɛ mo de yi so, awi ne nsa foforo asase, aduan ne bobe mfuw asase.<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“Mommma Hesekia nka se, ‘<char style="nd">Awurade</char> begye yɛn,’ mfa nnaadaa mo. Ɔman bi so nyame atumi agye ne man afi Asiriahene nsam pɛn ana? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>Ɛhe na Hamat ne Arpad anyame no wɔ? Na Sefarwaim anyame no nso wɔ he? Wɔagye Samaria afi me nsam ana? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>Ɔman bɛn so nyame na watumi agye ne manfo afi me tumi ase? Na afei ɛbɛyɛ dɛn na <char style="nd">Awurade</char> betumi agye Yerusalem afi me nsam.”<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>Na nnipa no yɛɛ komm a wɔamma mmuae biara, efisɛ na Hesekia aka akyerɛ wɔn se wɔnnkasa.<verse eid="ISA 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22"/>Afei Hilkia babarima Eliakim a na ɔhwɛ ahemfi no ntotoe so, Sebna a na ɔyɛ ɔkyerɛwfo ne Asaf babarima Yoa a ɔno nso yɛ ɔkyerɛwfo kɔɔ Hesekia nkyɛn a wɔasunsuane wɔn ntade mu, kɔkaa nea ɔsahene no aka akyerɛ no no.<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">Wɔhyɛ Yerusalem Gye Ho Nkɔm</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>Bere a ɔhene Hesekia tee eyinom no, osunsuan ne ntade mu, na ofuraa atweaatam, na ɔkɔɔ <char style="nd">Awurade</char> asɔredan mu. <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>Na ɔsomaa Eliakim a ɔhwɛ ahemfi ntotoe so, Sebna, a ɔyɛ ɔkyerɛwfo ne asɔfo akunini a wɔn nyinaa furafura atweaatam, kɔɔ Amos babarima Odiyifo Yesaia nkyɛn. <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>Wɔka kyerɛɛ no se, “Sɛnea ɔhene Hesekia ka ni: Saa da yi yɛ ɔhaw, animka ne animguase da. Ayɛ te sɛ nea mmofra awo du so, na ahoɔden a wɔde bɛwo wɔn nni hɔ. <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>Nanso ebia <char style="nd">Awurade</char>, mo Nyankopɔn ate sɛ Asiria nanmusini no regu Onyankopɔn teasefo no anim ase, na wɔbɛtwe nʼaso wɔ ne nsɛnkeka no ho. Enti bɔ mpae ma yɛn a yɛaka no!”<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>Bere a Ɔhene Hesekia mpanyimfo no de ɔhene no nkra brɛɛ Yesaia no, <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>Yesaia ka kyerɛɛ wɔn se, “Ka kyerɛ wo wura se, ‘Sɛnea <char style="nd">Awurade</char> se ni: Mma abususɛm a Asiriahene asomafo no ka tiaa me no nhaw wo. <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>Muntie! Mede honhom bi rebɛhyɛ ne mu, sɛnea ɛbɛyɛ a sɛ ɔte asɛm bi a ɔbɛsan akɔ ne man mu na hɔ na mɛma wɔde afoa akum no.’ ”<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>Bere a ɔsahene no tee sɛ Asiriahene afi Lakis no, ɔsan nʼakyi kohuu sɛ ɔhene no ne Libna reko.<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>Ankyɛ, ɔhene Sanaherib nyaa nkra se, Tirhaka Etiopiani a ɔyɛ Misraimhene di asraafo anim rebɛko atia no. Bere a ɔtee no, ɔsomaa abɔfo kɔɔ Hesekia nkyɛn de nkra kɔmaa no se, <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“Monka nkyerɛ Yudahene Hesekia se: Mma onyame a wode wo ho ato no so no nnaadaa mo nka se, ‘Wɔremfa Yerusalem mma Asiriahene.’ <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>Moate nea Asiria ahemfo ayɛ amanaman no nyinaa. Wɔasɛe wɔn pasaa. Na mo de, wobegye mo ana? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>Anyame a wɔwɔ aman a me nenanom sɛee wɔn no, aman te sɛ, Gosan, Haran, Resef ne Edenfo a na wɔwɔ Talasar no anyame gyee wɔn ana? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>Nsɛm bɛn na ɛtotoo Hamathene ne Arpadhene? Nsɛm bɛn nso na ɛtotoo Sefarwaim, Hena ne Iwa ahemfo?”<verse eid="ISA 37:13"/></para>
  <para style="s1">Hesekia Mpaebɔ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>Hesekia nsa kaa krataa a abɔfo no de bae no, ɔkenkanee. Afei ɔforo kɔɔ <char style="nd">Awurade</char> asɔredan no mu kɔtrɛw mu wɔ <char style="nd">Awurade</char> anim. <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>Na Hesekia bɔɔ mpae kyerɛɛ <char style="nd">Awurade</char> se, <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“Asafo <char style="nd">Awurade</char>, Israel Nyankopɔn a wɔasi wo hene wɔ Kerubim ntam. Wo nko ara na woyɛ Onyankopɔn wɔ asase so ahenni nyinaa so. Wo na wobɔɔ ɔsoro ne asase. <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>Brɛ wʼaso ase, <char style="nd">Awurade</char>, na tie! Bue wʼani, <char style="nd">Awurade</char>, na hwɛ. Tie nsɛm a Sanaherib asoma de abɛsopa Onyankopɔn teasefo no.<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“<char style="nd">Awurade</char>, ɛyɛ nokware sɛ Asiria ahemfo asɛe aman yi nyinaa, sɛnea nkra no ka no. <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>Na wɔatow anyame a wɔwɔ saa aman yi so no agu gya mu, ahyew wɔn, efisɛ wɔnyɛ anyame, na mmom wɔyɛ nnua ne abo a nnipa de wɔn nsa ayɛ. <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>Afei <char style="nd">Awurade</char>, yɛn Nyankopɔn, gye yɛn fi ne nsam, na ama ahenni a ɛwɔ asase so nyinaa ahu sɛ, wo nko ara, <char style="nd">Awurade</char>, ne Onyankopɔn.”<verse eid="ISA 37:20"/></para>
  <para style="s1">Sanaherib Asehwe</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>Na Amos babarima Yesaia de saa nkra yi kɔmaa Hesekia se, “Sɛɛ na <char style="nd">Awurade</char>, Israel Nyankopɔn se: Esiane sɛ woabɔ me mpae afa Asiriahene Sanaherib ho nti, <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>eyi ne asɛm a <char style="nd">Awurade</char> aka atia no:</para>
  <para style="q1" vid="ISA 37:22">“Ɔbabeabun Sion sopa wo,</para>
  <para style="q2" vid="ISA 37:22">na ɔserew wo.</para>
  <para style="q1" vid="ISA 37:22">Ɔbabea Yerusalem di wo ho fɛw,</para>
  <para style="q2" vid="ISA 37:22">na ɔwosow ne ti bere a woreguan.<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>Hena na wugye di sɛ woyeyaw no, di ne ho fɛw nso?</para>
  <para style="q2" vid="ISA 37:23">Hena na womaa wo nne so tiaa no</para>
  <para style="q1" vid="ISA 37:23">na wohwɛɛ no ahantan so?</para>
  <para style="q2" vid="ISA 37:23">Ɛyɛ Israel ɔkronkronni no!<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>Wonam wʼasomafo so</para>
  <para style="q2" vid="ISA 37:24">adi <char style="nd">Awurade</char> ho fɛw.</para>
  <para style="q1" vid="ISA 37:24">Na woaka se,</para>
  <para style="q2" vid="ISA 37:24">‘Me nteaseɛnam dodow nti</para>
  <para style="q1" vid="ISA 37:24">maforo mmepɔw atenten.</para>
  <para style="q2" vid="ISA 37:24">Yiw Lebanon mmepɔw a ɛwoware pa ara no.</para>
  <para style="q1" vid="ISA 37:24">Matwitwa ne sida atenten no,</para>
  <para style="q2" vid="ISA 37:24">ne nʼapepaw a ɛyɛ fɛ no agu fam.</para>
  <para style="q1" vid="ISA 37:24">Madu ne mmepɔw a ɛwɔ akyirikyiri no so,</para>
  <para style="q2" vid="ISA 37:24">ne ne kwaeberentuw mu.<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>Matutu mmura wɔ ahɔho nsase bebree so</para>
  <para style="q2" vid="ISA 37:25">de ne nsu pa no adwudwo me ho.</para>
  <para style="q1" vid="ISA 37:25">Mpo, mepaee Misraim nsubɔnten mu</para>
  <para style="q2" vid="ISA 37:25">sɛnea mʼakofo betumi atwa!’<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“Na Montee ɛ?</para>
  <para style="q2" vid="ISA 37:26">Bere tenten a atwam, na mehyɛ too hɔ.</para>
  <para style="q1" vid="ISA 37:26">Bere bi a atwam no na medwenee ho;</para>
  <para style="q2" vid="ISA 37:26">afei mama aba mu sɛ,</para>
  <para style="q1" vid="ISA 37:26">moadan ɔman a mosɛe nkuropɔn a wɔabɔ</para>
  <para style="q2" vid="ISA 37:26">ho ban.<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>Wɔn nkurɔfo a tumi afi wɔn nsa no</para>
  <para style="q2" vid="ISA 37:27">ho adwiriw wɔn, na animguase aka wɔn.</para>
  <para style="q1" vid="ISA 37:27">Wɔte sɛ afuw so nnua,</para>
  <para style="q2" vid="ISA 37:27">ne afifide foforo a ɛyɛ mmrɛw.</para>
  <para style="q1" vid="ISA 37:27">Wɔte sɛ sare a efifi ɔdan atifi</para>
  <para style="q2" vid="ISA 37:27">a ɛhyew ansa na anyin.<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“Nanso minim nea wote</para>
  <para style="q2" vid="ISA 37:28">bere a woba ne bere a wokɔ</para>
  <para style="q2" vid="ISA 37:28">ne sɛnea wo bo huru tia me.<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>Na esiane sɛ wo bo huru tia me</para>
  <para style="q2" vid="ISA 37:29">na wʼahantan adu mʼasom nti,</para>
  <para style="q1" vid="ISA 37:29">mede me darewa bɛhyɛ wo hwenem,</para>
  <para style="q2" vid="ISA 37:29">na mede akwankyerɛ dade ahyɛ wʼanom,</para>
  <para style="q1" vid="ISA 37:29">mɛma wo afa ɔkwan a wofaa so bae no so</para>
  <para style="q2" vid="ISA 37:29">asan wʼakyi.<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>“Eyi na ɛbɛyɛ nsɛnkyerɛnne ama wo, Hesekia:</para>
  <para style="q1" vid="ISA 37:30">“Saa afe yi wubedi nea ɛno ankasa fifii.</para>
  <para style="q2" vid="ISA 37:30">Afe a ɛto so abien no, wubedi nea efi mu ba.</para>
  <para style="q1" vid="ISA 37:30">Nanso afe a ɛto so abiɛsa no de, wo ara dua na twa,</para>
  <para style="q2" vid="ISA 37:30">yɛ bobe nturo na di so aba.<verse eid="ISA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31"/>Bio, nkae bi a ofi Yuda fi</para>
  <para style="q2" vid="ISA 37:31">begye ntin wɔ fam na wasow aba wɔ soro.<verse eid="ISA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32"/>Na nkae bi befi Yerusalem aba,</para>
  <para style="q2" vid="ISA 37:32">na nkae dɔm afi Bepɔw Sion so.</para>
  <para style="q1" vid="ISA 37:32">Asafo <char style="nd">Awurade</char> pɛ mu na eyi bɛyɛ.<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“Eyi ne asɛm a <char style="nd">Awurade</char> ka fa Asiriahene ho:</para>
  <para style="q1" vid="ISA 37:33">“Ɔrenhyɛn saa kuropɔn yi mu</para>
  <para style="q2" vid="ISA 37:33">na ɔrentow bɛmma wɔ ha.</para>
  <para style="q1" vid="ISA 37:33">Ɔremfa nkatabo mmegyina kuropɔn no akyi</para>
  <para style="q2" vid="ISA 37:33">na ɔrensi pie ntua nʼano.<verse eid="ISA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34"/>Ɔhene no kwan a ɔfaa so bae no ara so na ɔbɛsan afa akɔ nʼankasa man mu.”</para>
  <para style="q2" vid="ISA 37:34">
    <char style="nd">Awurade</char> ka se,</para>
  <para style="q2" vid="ISA 37:34">“Ɔrenwura saa kurow yi mu.<verse eid="ISA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35"/>Esiane mʼankasa mʼanuonyam ne mʼakoa Dawid nti,</para>
  <para style="q2" vid="ISA 37:35">mɛbɔ ho ban.”<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>Afei <char style="nd">Awurade</char> bɔfo fii adi na okunkum asraafo mpem ɔha aduɔwɔtwe anum wɔ Asiria nsraban mu. Bere a nnipa no sɔree anɔpa no, wohuu sɛ amu gugu baabiara! <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>Enti Asiriahene Sanaherib pɔn nʼakofo. Ɔsan kɔɔ Ninewe kɔtenaa hɔ.<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>Da bi a na ɔresɔre ne nyame Nisrok wɔ abosonnan mu no, ne mma mmarima baanu, Adramelek ne Sareser de afoa kokum no, na woguan kɔɔ Ararat asase so. Na ne babarima Esarhadon bedii nʼade sɛ Asiriahene.<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">Hesekia Yare</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>Saa nna no mu no, Hesekia yaree owuyare, na Amos babarima Odiyifo Yesaia kɔɔ ne nkyɛn kɔkae se, “Sɛnea <char style="nd">Awurade</char> se ni: Toto wʼakwan yiye, efisɛ worebewu; na wo ho renyɛ wo den bio.”<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>Bere a Hesekia tee asɛm yi, otwaa nʼani hwɛɛ ɔfasu, bɔɔ <char style="nd">Awurade</char> mpae se, <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>“Kae, <char style="nd">Awurade</char>, sɛnea manantew wʼanim nokware mu na mede me koma ayɛ nea ɛfata wɔ wʼanim.” Na Hesekia suu bebree.<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>Na saa asɛm yi fii <char style="nd">Awurade</char> nkyɛn kɔɔ Yesaia hɔ se, <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“San kɔ Hesekia nkyɛn, na kɔka kyerɛ no se, ‘Sɛɛ na <char style="nd">Awurade</char>, wʼagya Dawid Nyankopɔn, ka: Mate wo mpaebɔ no, na mahu wo nisu. Mede mfe dunum bɛka wo nkwanna ho. <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>Na megye wo ne kuropɔn yi afi Asiriahene nsam. Mɛbɔ kuropɔn yi ho ban.<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>“ ‘Na eyi ne nsɛnkyerɛnne a <char style="nd">Awurade</char> bɛyɛ de adi ho adanse sɛ, obedi ne bɔhyɛ so: <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>Mɛma owia ano sunsuma atwe akɔ nʼakyi anammɔn du wɔ Ahas antweri so.’ ” Ɛno nti, owiahyerɛn no kɔɔ nʼakyi anammɔn du.<verse eid="ISA 38:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>Nea Yudahene Hesekia kyerɛw wɔ ne yare ne nʼayaresa akyi ni:<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>Mekae se, “Mʼasetena mu nnapa yi mu</para>
  <para style="q2" vid="ISA 38:10">ɛsɛ sɛ mefa owu apon mu</para>
  <para style="q1" vid="ISA 38:10">na wogye me mfe a aka yi ana?”<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>Mekae se, “Merenhu <char style="nd">Awurade</char> Nyankopɔn bio</para>
  <para style="q2" vid="ISA 38:11">
    <char style="nd">Awurade</char> a ɔwɔ ateasefo asase so.</para>
  <para style="q1" vid="ISA 38:11">Merenhu adesamma bio,</para>
  <para style="q1" vid="ISA 38:11">anaa merenka wɔn a wɔte wiase yi ho bio.<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>Wɔadwiriw me fi agu agye afi me nsam,</para>
  <para style="q2" vid="ISA 38:12">te sɛ, oguanhwɛfo ntamadan.</para>
  <para style="q1" vid="ISA 38:12">Matwa me nkwa so sɛnea ɔnwemfo</para>
  <para style="q2" vid="ISA 38:12">twa me fi asadua so;</para>
  <para style="q2" vid="ISA 38:12">awia ne anadwo wutwaa me nkwa so.<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>Mede ntoboase twɛn kosii ahemadakye,</para>
  <para style="q2" vid="ISA 38:13">nanso wɔbobɔɔ me nnompe mu te sɛ gyata;</para>
  <para style="q2" vid="ISA 38:13">awia ne anadwo wutwaa me nkwa so.<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>Misuu sɛ asomfena anaa asukɔnkɔn;</para>
  <para style="q2" vid="ISA 38:14">mitwaa adwo sɛ, aborɔnoma a ɔredi awerɛhow.</para>
  <para style="q1" vid="ISA 38:14">Mʼani yɛɛ siamoo bere a mehwɛɛ soro.</para>
  <para style="q2" vid="ISA 38:14">Mewɔ ɔhaw mu, <char style="nd">Awurade</char>, bra bɛboa me!”<verse eid="ISA 38:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>Na dɛn na metumi aka?</para>
  <para style="q2" vid="ISA 38:15">Wakasa akyerɛ me, na ɔno ankasa na wayɛ eyi.</para>
  <para style="q1" vid="ISA 38:15">Mede ahobrɛase bɛnantew mʼasetena nyinaa mu</para>
  <para style="q2" vid="ISA 38:15">me kra ahoyeraw yi nti.<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>Awurade, ɛnam saa nneɛma yi so na nnipa nya nkwa</para>
  <para style="q2" vid="ISA 38:16">na me honhom nso nya nkwa wɔ mu.</para>
  <para style="q1" vid="ISA 38:16">Wode mʼakwahosan asan ama me</para>
  <para style="q2" vid="ISA 38:16">nam so ama manya nkwa.<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>Yiw, ɛyɛ me yiyeyɛ nti</para>
  <para style="q2" vid="ISA 38:17">na mekɔɔ saa ahoyeraw yi mu.</para>
  <para style="q1" vid="ISA 38:17">Wo dɔ nti, wode me siei</para>
  <para style="q2" vid="ISA 38:17">na mankɔ ɔsɛe amoa mu;</para>
  <para style="q1" vid="ISA 38:17">na wode me bɔne nyinaa akyɛ me.<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>Ɔda rentumi nkamfo wo;</para>
  <para style="q2" vid="ISA 38:18">owu rentumi nto wo ayeyi nnwom;</para>
  <para style="q1" vid="ISA 38:18">wɔn a wosian kɔ amoa mu no</para>
  <para style="q2" vid="ISA 38:18">rentumi nnya anidaso wɔ wo nokware mu bio.<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>Ateasefo nko na wobetumi akamfo wo,</para>
  <para style="q2" vid="ISA 38:19">sɛnea mereyɛ nnɛ yi;</para>
  <para style="q1" vid="ISA 38:19">agyanom ka wo nokwaredi ho asɛm</para>
  <para style="q2" vid="ISA 38:19">kyerɛ wɔn mma.<verse eid="ISA 38:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>
    <char style="nd">Awurade</char> begye me nkwa,</para>
  <para style="q2" vid="ISA 38:20">na yɛde asanku bɛto nnwom</para>
  <para style="q1" vid="ISA 38:20">yɛn nkwanna nyinaa</para>
  <para style="q2" vid="ISA 38:20">wɔ <char style="nd">Awurade</char> fi.<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>Na Yesaia kae se, “Momfa borɔdɔma nyɛ nku mfa nsra pɔmpɔ no so, na ne ho bɛtɔ no.”<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>Na Hesekia bisae se, “Dɛn nsɛnkyerɛnne na ɛbɛda no adi sɛ, mɛkɔ Awurade asɔredan mu?”<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">Asomafo A Wofi Babilonia</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>Saa bere no Merodak-Baladan a ɔyɛ Babiloniahene Baladan babarima soma ma wɔde krataa ne akyɛde kɔmaa Hesekia, efisɛ na wate sɛ wayare ama ne ho atɔ no. <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>Hesekia gyee asomafo no fɛw so, na afei ɔde nea ɔwɔ wɔ ne adekoradan mu kyerɛɛ wɔn; dwetɛ, sikakɔkɔɔ, nnuhuam, ngohuam, nʼakode akorae ne biribiara a ɛka nʼademude ho. Biribiara nni nʼahemfi ne nʼahenni mu a Hesekia amfa ankyerɛ wɔn.<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>Afei Odiyifo Yesaia kɔɔ ɔhene Hesekia nkyɛn, kobisaa no se, “Asɛm bɛn na saa mmarima no kae na he na wofi bae?”</para>
  <para style="p" vid="ISA 39:3">Hesekia buae se, “Wofi akyirikyiri asase bi so. Wofi Babilonia, na wɔbaa me nkyɛn.”<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>Odiyifo no bisae se, “Dɛn na wohuu wɔ wʼahemfi hɔ?”</para>
  <para style="p" vid="ISA 39:4">Hesekia buae se, “Wohuu biribiara a ɛwɔ mʼahemfi ha. Biribiara nni mʼademude mu a mamfa ankyerɛ wɔn.”<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>Afei Yesaia ka kyerɛɛ Hesekia se, “Tie asɛm a efi Asafo <char style="nd">Awurade</char> nkyɛn: <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>Nokware, bere bi bɛba a, wɔbɛsoa biribiara a ɛwɔ wʼahemfi ne agyapade a wʼagyanom akora de abedu nnɛ no akɔ Babilonia. Biribiara renka, sɛɛ na <char style="nd">Awurade</char> se. <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>Wʼankasa wʼasefo bi mpo, wɔbɛfa wɔn nnommum. Wɔbɛyɛ piamfo a wɔbɛsom wɔ Babiloniahene ahemfi.”<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>Na Hesekia ka kyerɛɛ Yesaia se, “Saa asɛm yi a efi <char style="nd">Awurade</char> nkyɛn a woaka akyerɛ me yi yɛ asɛm papa.” Nanso na ɔhene no redwene sɛ, ne bere so de, obenya asomdwoe ne bammɔ.<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s1">Onyankopɔn Nkurɔfo Awerɛkyekye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1"/>Monkyekye, monkyekye me nkurɔfo werɛ.</para>
  <para style="q2" vid="ISA 40:1">Saa na mo Nyankopɔn se.<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>Monka asomdwoesɛm nkyerɛ Yerusalem,</para>
  <para style="q2" vid="ISA 40:2">na mompae mu nka nkyerɛ no se</para>
  <para style="q1" vid="ISA 40:2">ne som dennen no aba awiei,</para>
  <para style="q2" vid="ISA 40:2">wɔatua ne bɔne no so ka,</para>
  <para style="q1" vid="ISA 40:2">na wɔanya ne bɔne nyinaa so akatua mmɔho</para>
  <para style="q2" vid="ISA 40:2">afi <char style="nd">Awurade</char> nsam.<verse eid="ISA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>Nne bi reteɛ mu se,</para>
  <para style="q2" vid="ISA 40:3">“Munsiesie ɔkwan mma <char style="nd">Awurade</char></para>
  <para style="q1" vid="ISA 40:3">wɔ nweatam no so.</para>
  <para style="q2" vid="ISA 40:3">Monteɛ ɔtempɔn wɔ sare no so</para>
  <para style="q2" vid="ISA 40:3">mma yɛn Nyankopɔn.<verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>Obon biara bɛyɛ ma,</para>
  <para style="q2" vid="ISA 40:4">bepɔw ne nkoko nyinaa bɛkɔ fam,</para>
  <para style="q1" vid="ISA 40:4">asase a ɛyɛ abonkyiabonkyi no bɛyɛ tamaa,</para>
  <para style="q2" vid="ISA 40:4">na mmeae a ɛyɛ akɔntɔnkye no ayɛ tataw.<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>Na <char style="nd">Awurade</char> anuonyam bɛda adi,</para>
  <para style="q2" vid="ISA 40:5">na nnipa nyinaa behu.</para>
  <para style="q2" vid="ISA 40:5">Efisɛ <char style="nd">Awurade</char> na waka!”<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>Nne bi kae se, “Teɛ mu.”</para>
  <para style="q2" vid="ISA 40:6">Na mekae se, “Menteɛ mu nka dɛn?”</para>
  <para style="b" vid="ISA 40:6"/>
  <para style="q1" vid="ISA 40:6">“Nnipa nyinaa te sɛ sare,</para>
  <para style="q2" vid="ISA 40:6">na wɔn anuonyam nyinaa te sɛ afuw so nhwiren.<verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>Sare hyew, na nhwiren twintwam</para>
  <para style="q2" vid="ISA 40:7">efisɛ <char style="nd">Awurade</char> ahomegu fa wɔn so.</para>
  <para style="q2" vid="ISA 40:7">Nokware, nnipa no yɛ sare.<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>Sare hyew, na nhwiren twintwam,</para>
  <para style="q2" vid="ISA 40:8">nanso yɛn Nyankopɔn asɛm no tim hɔ daa.”<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9"/>Wo a wode asɛm pa reba Sion,</para>
  <para style="q2" vid="ISA 40:9">foro kɔ bepɔw tenten bi so.</para>
  <para style="q1" vid="ISA 40:9">Wo a wode asɛm pa reba Yerusalem,</para>
  <para style="q2" vid="ISA 40:9">ma wo nne so na teɛ mu,</para>
  <para style="q1" vid="ISA 40:9">ma so, nsuro;</para>
  <para style="q2" vid="ISA 40:9">ka kyerɛ Yuda nkurow se,</para>
  <para style="q2" vid="ISA 40:9">“Mo Nyankopɔn ni!”<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>Hwɛ, Asafo <char style="nd">Awurade</char> de tumi reba,</para>
  <para style="q2" vid="ISA 40:10">na nʼabasa bedi hene ama no.</para>
  <para style="q1" vid="ISA 40:10">Hwɛ, nʼakatua ka ne ho,</para>
  <para style="q2" vid="ISA 40:10">na ɔde nʼabasobɔde nam.<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>Ɔhwɛ ne nguankuw sɛ oguanhwɛfo.</para>
  <para style="q2" vid="ISA 40:11">Ɔboa nguantenmma no wɔ nʼabasa so</para>
  <para style="q1" vid="ISA 40:11">oturu wɔn ne koko so;</para>
  <para style="q2" vid="ISA 40:11">na nguan a wɔwɔ mma no, ɔka wɔn brɛoo.<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>Hena na wasusuw obon mu nsu wɔ ne nsam</para>
  <para style="q2" vid="ISA 40:12">anaa ɔde ne nsateaa asusuw ɔsoro?</para>
  <para style="q1" vid="ISA 40:12">Hena na ɔde asase so mfutuma agu kɛntɛn mu,</para>
  <para style="q2" vid="ISA 40:12">anaa wakari mmepɔw wɔ nsania so</para>
  <para style="q2" vid="ISA 40:12">ne nkoko wɔ nsania apampaa so?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>Hena na wate <char style="nd">Awurade</char> ase,</para>
  <para style="q2" vid="ISA 40:13">anaa wakyerɛkyerɛ no sɛ ne fotufo?<verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>Hena na <char style="nd">Awurade</char> abisa no sɛ ɔnkyerɛ no biribi ase,</para>
  <para style="q2" vid="ISA 40:14">na hena na ɔkyerɛɛ no ɔkwan pa no?</para>
  <para style="q1" vid="ISA 40:14">Hena na ɔmaa no nimdeɛ</para>
  <para style="q2" vid="ISA 40:14">anaa ɔkyerɛɛ no nhumu kwan?<verse eid="ISA 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>Ampa ara aman no te sɛ nsu sope wɔ bokiti mu;</para>
  <para style="q2" vid="ISA 40:15">wɔde wɔn toto mfutuma a egu nsania so ho;</para>
  <para style="q2" vid="ISA 40:15">ɔkari nsupɔw te sɛnea ɛyɛ mfutuma muhumuhu.<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>Lebanon nnɔɔso mma afɔremuka so gya,</para>
  <para style="q2" vid="ISA 40:16">na ne mmoa renso mma ɔhyew afɔrebɔde.<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>Aman nyinaa nsɛ hwee wɔ nʼanim;</para>
  <para style="q2" vid="ISA 40:17">obu wɔn adehunu bi</para>
  <para style="q2" vid="ISA 40:17">a wɔnka hwee.<verse eid="ISA 40:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>Afei hena ho na wode Onyankopɔn bɛtoto?</para>
  <para style="q2" vid="ISA 40:18">Nsɛsode bɛn ho na wode no bɛto?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>Ohoni de, odwumfo na ɔyɛ,</para>
  <para style="q2" vid="ISA 40:19">na sikadwumfo de sikakɔkɔɔ agu ho</para>
  <para style="q2" vid="ISA 40:19">na wasiesie dwetɛ nkɔnsɔnkɔnsɔn ama no.<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>Ohiani a ɔrentumi mfa saa ayɛyɛde yi mma no</para>
  <para style="q2" vid="ISA 40:20">kɔhwehwɛ dua a ɛremporɔw.</para>
  <para style="q1" vid="ISA 40:20">Ɔhwehwɛ odwumfo nyansafo</para>
  <para style="q2" vid="ISA 40:20">na wayɛ ohoni a ɛremmunum nhwe fam asi hɔ.<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>Wunnim ana?</para>
  <para style="q2" vid="ISA 40:21">Wontee ana?</para>
  <para style="q1" vid="ISA 40:21">Wɔnnka nkyerɛɛ wo mfii mfiase no ana?</para>
  <para style="q2" vid="ISA 40:21">Efi bere a wɔbɔɔ asase no, wontee ase ana?<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>Ɔte ahengua so wɔ asase dantaban no atifi</para>
  <para style="q2" vid="ISA 40:22">ɛso nnipa te sɛ tɛwtɛw</para>
  <para style="q1" vid="ISA 40:22">ɔtwe ɔsoro mu te sɛ bamkyinii,</para>
  <para style="q2" vid="ISA 40:22">na ɔtrɛw mu sɛ ntamadan tena mu.<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>Ɔma ahemmea yɛ nnipahunu</para>
  <para style="q2" vid="ISA 40:23">na wiase yi sodifo nso, ɔbrɛ wɔn ase.<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>Wɔtɛw wɔn ara pɛ,</para>
  <para style="q2" vid="ISA 40:24">woduaa wɔn ara pɛ,</para>
  <para style="q2" vid="ISA 40:24">wogyee ntin wɔ asase mu pɛ,</para>
  <para style="q1" vid="ISA 40:24">na wahome agu wɔn so ama wɔakisa,</para>
  <para style="q2" vid="ISA 40:24">na mframa abɔ wɔn kɔ te sɛ ntɛtɛ.<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>“Hena ho na wode me bɛto?</para>
  <para style="q2" vid="ISA 40:25">Anaasɛ hena na ɔne me sɛ?” Ɔkronkronni no na ose.<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>Momma mo ani so nhwɛ ɔsoro:</para>
  <para style="q2" vid="ISA 40:26">Hena na ɔbɔɔ eyinom nyinaa?</para>
  <para style="q1" vid="ISA 40:26">Nea oyiyi ɔsoro nsoromma mmaako mmaako,</para>
  <para style="q2" vid="ISA 40:26">na ɔbɔ obiara din frɛ no.</para>
  <para style="q1" vid="ISA 40:26">Nʼahoɔden ne ne tumi nti</para>
  <para style="q2" vid="ISA 40:26">wɔn mu baako mpo nyera.<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>Adɛn na wunwiinwii, Yakob,</para>
  <para style="q2" vid="ISA 40:27">na woka se, Israel,</para>
  <para style="q1" vid="ISA 40:27">“Mʼakwan ahintaw <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="ISA 40:27">na me Nyankopɔn abɔ mʼasɛm agu”?<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>Wunnim ana?</para>
  <para style="q2" vid="ISA 40:28">Wontee ana?</para>
  <para style="q1" vid="ISA 40:28">
    <char style="nd">Awurade</char> yɛ daapem Nyankopɔn,</para>
  <para style="q2" vid="ISA 40:28">na ɔyɛ asase nyinaa yɛfo.</para>
  <para style="q1" vid="ISA 40:28">Ɔremmrɛ na ɔrentɔ beraw,</para>
  <para style="q2" vid="ISA 40:28">na ne nhumu nni nhwehwɛmu.<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>Ɔma nea watɔ beraw ahoɔden</para>
  <para style="q2" vid="ISA 40:29">nea wayɛ mmerɛw nso, ɔto nʼahoɔden so.<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>Mpo, mmabun brɛ, na wɔtɔ beraw,</para>
  <para style="q2" vid="ISA 40:30">na mmerante hintihintiw hwehwe ase;<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>Nanso, wɔn a wɔn ani da <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="ISA 40:31">benya ahoɔden foforo.</para>
  <para style="q1" vid="ISA 40:31">Wɔde ntaban sɛ akɔre de betu akɔ wim;</para>
  <para style="q2" vid="ISA 40:31">wobetu mmirika, na wɔrentɔ beraw.</para>
  <para style="q2" vid="ISA 40:31">Wɔbɛnantew, na wɔrentɔ piti.<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">Israel Boafo</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>“Monyɛ komm wɔ mʼanim, mo nsupɔw!</para>
  <para style="q2" vid="ISA 41:1">Ma aman no nhyɛ wɔn ho den!</para>
  <para style="q1" vid="ISA 41:1">Ma wɔmmra ha mmɛkasa;</para>
  <para style="q2" vid="ISA 41:1">momma yɛmmɔ mu nhyia wɔ asennii hɔ.<verse eid="ISA 41:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>“Hena na wakanyan nea ofi apuei no,</para>
  <para style="q2" vid="ISA 41:2">afrɛ no trenee mu sɛ ɔmmɛsom no?</para>
  <para style="q1" vid="ISA 41:2">Ɔde aman hyɛ ne nsa</para>
  <para style="q2" vid="ISA 41:2">na ɔbrɛ ahemfo ase wɔ nʼanim.</para>
  <para style="q1" vid="ISA 41:2">Ɔde nʼafoa ma wɔdan mfutuma,</para>
  <para style="q2" vid="ISA 41:2">ɔde ne bɛmma ma wɔdan ntɛtɛ a mframa bɔ hwete.<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>Ɔtaa wɔn na ɔkɔ nʼanim a biribiara nti ne ho,</para>
  <para style="q2" vid="ISA 41:3">wɔ kwan a ɔmfaa so da no so.<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>Hena na wayɛ eyi akosi awiei,</para>
  <para style="q2" vid="ISA 41:4">afrɛ awo ntoatoaso afi mfiase?</para>
  <para style="q1" vid="ISA 41:4">Me <char style="nd">Awurade</char>, meka adikanfo</para>
  <para style="q2" vid="ISA 41:4">ne akyikafo ho, Mene ɔno ara.”<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>Nsupɔw no ahu na wɔbɔ hu;</para>
  <para style="q2" vid="ISA 41:5">nsase ano ho popo.</para>
  <para style="q1" vid="ISA 41:5">Wotwiw bɛn, na wɔba anim;<verse eid="ISA 41:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6"/>na obiara boa ne yɔnko</para>
  <para style="q2" vid="ISA 41:6">na ɔka kyerɛ ne nua se, “Yɛ den!”<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>Odwumfo hyɛ sikadwumfo nkuran,</para>
  <para style="q2" vid="ISA 41:7">na nea ɔde asae yɛ no trontrom</para>
  <para style="q2" vid="ISA 41:7">boa nea ɔbɔ atommo so.</para>
  <para style="q1" vid="ISA 41:7">Ɔka fa nea ɔsɔw no ho se, “Eye pa ara.”</para>
  <para style="q2" vid="ISA 41:7">Ɔbobɔ ohoni no mu nnadewa sɛnea ɛrentu nhwe fam.<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>“Nanso wo, Israel, me somfo,</para>
  <para style="q2" vid="ISA 41:8">Yakob, nea mayi no no,</para>
  <para style="q2" vid="ISA 41:8">mo, mʼadamfo Abraham asefo.<verse eid="ISA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9"/>Mefaa wo fii nsase ano,</para>
  <para style="q2" vid="ISA 41:9">fii nʼakyirikyiri ntwea so, na mefrɛɛ wo.</para>
  <para style="q1" vid="ISA 41:9">Mekae se, ‘Woyɛ me somfo’;</para>
  <para style="q2" vid="ISA 41:9">mapaw wo na mempoo wo ɛ.<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>Enti nsuro, na mene wo wɔ hɔ;</para>
  <para style="q2" vid="ISA 41:10">mma wo werɛ nhow, na mene wo Nyankopɔn.</para>
  <para style="q1" vid="ISA 41:10">Mɛhyɛ wo den, na mɛboa wo;</para>
  <para style="q2" vid="ISA 41:10">mede me trenee nsa nifa bɛma wo so.<verse eid="ISA 41:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>“Wɔn a wɔn bo afuw wo no nyinaa, ampa ara</para>
  <para style="q2" vid="ISA 41:11">wɔn ani bewu na wɔn anim agu ase;</para>
  <para style="q1" vid="ISA 41:11">wɔn a wɔsɔre tia wo no</para>
  <para style="q2" vid="ISA 41:11">rensɛ hwee na wobewuwu.<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>Ɛwɔ mu sɛ wobɛhwehwɛ wʼatamfo de,</para>
  <para style="q2" vid="ISA 41:12">nanso worenhu wɔn.</para>
  <para style="q1" vid="ISA 41:12">Wɔn a wotu wo so sa no</para>
  <para style="q2" vid="ISA 41:12">rensɛ hwee koraa.<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>Na mene <char style="nd">Awurade</char>, wo Nyankopɔn,</para>
  <para style="q2" vid="ISA 41:13">nea okura wo nsa nifa mu</para>
  <para style="q1" vid="ISA 41:13">na ɔka kyerɛ wo se, Nsuro;</para>
  <para style="q2" vid="ISA 41:13">mɛboa wo.<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>Nsuro, osunson Yakob,</para>
  <para style="q2" vid="ISA 41:14">Israel a wusua,</para>
  <para style="q1" vid="ISA 41:14">na me ankasa mɛboa wo,” <char style="nd">Awurade</char> na ose,</para>
  <para style="q2" vid="ISA 41:14">wo gyefo, Israel Ɔkronkronni no.<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>“Hwɛ, mede wo bɛyɛ nhuwso apa,</para>
  <para style="q2" vid="ISA 41:15">a ɛyɛ amono, ano yɛ nnam na ɛwɔ ɛse bebree.</para>
  <para style="q1" vid="ISA 41:15">Wubehuhuw mmepɔw no so na woadwiriw wɔn,</para>
  <para style="q2" vid="ISA 41:15">na woama nkoko ayɛ sɛ ntɛtɛ.<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>Wubehuhuw wɔn so, mframa bɛma wɔn so,</para>
  <para style="q2" vid="ISA 41:16">na ahum abɔ wɔn akɔ.</para>
  <para style="q1" vid="ISA 41:16">Nanso wʼani begye wɔ <char style="nd">Awurade</char> mu</para>
  <para style="q2" vid="ISA 41:16">na woahyɛ Israel Ɔkronkronni no anuonyam.<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>“Ohiani ne mmɔborɔni kyin pɛ nsu,</para>
  <para style="q2" vid="ISA 41:17">nanso bi nni hɔ;</para>
  <para style="q2" vid="ISA 41:17">osukɔm ama wɔn tɛkrɛma so ayow.</para>
  <para style="q1" vid="ISA 41:17">Nanso me <char style="nd">Awurade</char>, mɛma wɔn mmuae.</para>
  <para style="q2" vid="ISA 41:17">Me, Israel Nyankopɔn, merennyaw wɔn.<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>Mɛma nsubɔnten ateɛ wɔ sorɔnsorɔmmea a awu no so,</para>
  <para style="q2" vid="ISA 41:18">na nsuti apue wɔ abon mu.</para>
  <para style="q1" vid="ISA 41:18">Mɛdan nweatam ayɛ no mmura,</para>
  <para style="q2" vid="ISA 41:18">na nsase a awo adan nsuti bebree.<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>Meduadua wɔ nweatam so,</para>
  <para style="q2" vid="ISA 41:19">sida, ɔkanto, ohuam ne ngonnua.</para>
  <para style="q1" vid="ISA 41:19">Meduadua ɔpepaw wɔ asase wosee so</para>
  <para style="q2" vid="ISA 41:19">asɛsɛ ne kwabɔhɔre abɔ mu,<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>sɛnea nnipa behu na wɔate,</para>
  <para style="q2" vid="ISA 41:20">na wɔasusuw ho na wɔate ase sɛ,</para>
  <para style="q1" vid="ISA 41:20">
    <char style="nd">Awurade</char> nsa na ayɛ saa ade yi,</para>
  <para style="q2" vid="ISA 41:20">Israel ɔkronkronni no na ɔma ɛbae.<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>“Bɔ wo nkuro,” <char style="nd">Awurade</char> na ose.</para>
  <para style="q2" vid="ISA 41:21">“Kyerɛkyerɛ wʼasɛm mu,” Yakob Hene na ose.<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>“Fa wʼahoni no bra</para>
  <para style="q2" vid="ISA 41:22">na wɔmmɛka nea ebesi nkyerɛ yɛn.</para>
  <para style="q1" vid="ISA 41:22">Wɔmmɛka sɛnea na kan nneɛma no te nkyerɛ yɛn,</para>
  <para style="q2" vid="ISA 41:22">sɛnea yebedwen ho afa</para>
  <para style="q2" vid="ISA 41:22">na yɛahu nea ebefi mu aba.</para>
  <para style="q1" vid="ISA 41:22">Anaasɛ wɔmpae mu nka nneɛma a ebesi nkyerɛ yɛn.<verse eid="ISA 41:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23"/>Monka yɛn nea ebesi daakye,</para>
  <para style="q2" vid="ISA 41:23">na ama yɛahu sɛ moyɛ anyame.</para>
  <para style="q1" vid="ISA 41:23">Monyɛ biribi, sɛ eye anaa enye,</para>
  <para style="q2" vid="ISA 41:23">sɛnea ɛbɛyɛ a yɛn werɛ bɛhow na ehu aka yɛn.<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>Nanso, monnka hwee,</para>
  <para style="q2" vid="ISA 41:24">na mo nnwuma so nni mfaso;</para>
  <para style="q2" vid="ISA 41:24">nea ɔfa mo no yɛ akyiwade.<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>“Makanyan obi a ofi atifi fam na ɔreba,</para>
  <para style="q2" vid="ISA 41:25">nea ofi owia apuei na ɔbɔ me din.</para>
  <para style="q1" vid="ISA 41:25">Otiatia ahemfo so te sɛ dɔte a wɔde si dan,</para>
  <para style="q2" vid="ISA 41:25">te sɛ ɔnwemfo a ɔrewɔw dɔte.<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>Hena na ɔkaa eyi ho asɛm fii mfiase, sɛnea anka ɛbɛma yɛahu,</para>
  <para style="q2" vid="ISA 41:26">anaa waka ato hɔ, sɛnea yebetumi aka se, ‘Ne de no ye’?</para>
  <para style="q1" vid="ISA 41:26">Obiara anka eyi,</para>
  <para style="q2" vid="ISA 41:26">obiara anni kan anka,</para>
  <para style="q2" vid="ISA 41:26">obiara ante nsɛm biara amfi wo nkyɛn.<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>Me na midii kan ka kyerɛɛ Sion, ‘Hwɛ, woni!’</para>
  <para style="q2" vid="ISA 41:27">Memaa Yerusalem ɔsomafo a ɔde asɛmpa ba.<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>Mehwɛ, nanso obiara nni hɔ,</para>
  <para style="q2" vid="ISA 41:28">obiara nni wɔn mu a obetu wɔn fo,</para>
  <para style="q2" vid="ISA 41:28">sɛ mibisa wɔn a, obiara ntumi mma mmuae.<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>Hwɛ, wɔn nyinaa yɛ atorofo!</para>
  <para style="q2" vid="ISA 41:29">Wɔn nneyɛe nka hwee;</para>
  <para style="q2" vid="ISA 41:29">wɔn nsɛsode yɛ mframa ne basabasayɛ nko ara.<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">
    <char style="nd">Awurade</char> Somfo No</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“Me somfo a mahyɛ no den ni,</para>
  <para style="q2" vid="ISA 42:1">nea mayi no na ɔsɔ mʼani;</para>
  <para style="q1" vid="ISA 42:1">mede me Honhom begu no so</para>
  <para style="q2" vid="ISA 42:1">na ɔde atɛntrenee bɛbrɛ aman no.<verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>Ɔrenteɛ mu anaa ɔremma ne nne so.</para>
  <para style="q2" vid="ISA 42:2">Ɔremma ne nne so wɔ mmɔnten so.<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>Demmire a ayɛ mmerɛw no, ɔremmu mu.</para>
  <para style="q2" vid="ISA 42:3">Kanea ntamabamma a ɛnnɛw yiye no, ɔrennum.</para>
  <para style="q1" vid="ISA 42:3">Nokware mu na ɔbɛda trenee adi;<verse eid="ISA 42:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4"/>ɔrenhinhim na ɔrempa abaw</para>
  <para style="q1" vid="ISA 42:4">kosi sɛ ɔde trenee bɛba asase so.</para>
  <para style="q2" vid="ISA 42:4">Ne mmara so na amanaman no de wɔn ani bɛto.”<verse eid="ISA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>Sɛɛ na Onyankopɔn, <char style="nd">Awurade</char> no se,</para>
  <para style="q1" vid="ISA 42:5">nea ɔbɔɔ ɔsoro na ɔtrɛw mu,</para>
  <para style="q2" vid="ISA 42:5">nea ɔtwee asase mu ne nea efi mu nyinaa,</para>
  <para style="q1" vid="ISA 42:5">nea ɔma wɔn a wɔte so home,</para>
  <para style="q2" vid="ISA 42:5">na ɔma wɔn a wɔnantew so no nkwa:<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6"/>“Me, <char style="nd">Awurade</char>, mafrɛ wo trenee mu;</para>
  <para style="q2" vid="ISA 42:6">meso wo nsa.</para>
  <para style="q1" vid="ISA 42:6">Mɛhwɛ wo so na mede wo ayɛ</para>
  <para style="q2" vid="ISA 42:6">apam ama nkurɔfo no</para>
  <para style="q2" vid="ISA 42:6">ne kanea ama amanamanmufo,<verse eid="ISA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7"/>na woabue ani a afura,</para>
  <para style="q2" vid="ISA 42:7">na woayi nneduafo afi afiase</para>
  <para style="q2" vid="ISA 42:7">na woagye wɔn a wɔda afiase amoa mu, wɔn a wɔte sum kabii mu no.<verse eid="ISA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>“Mene <char style="nd">Awurade</char>; me din ne no!</para>
  <para style="q2" vid="ISA 42:8">Meremfa mʼanuonyam mma obi</para>
  <para style="q2" vid="ISA 42:8">anaa mʼayeyi mma ahoni.<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>Hwɛ, nneɛma dedaw no asisi,</para>
  <para style="q2" vid="ISA 42:9">na nneɛma foforo no mepae mu ka;</para>
  <para style="q1" vid="ISA 42:9">ansa na ɛbɛba mu no,</para>
  <para style="q2" vid="ISA 42:9">meka kyerɛ mo.”<verse eid="ISA 42:9"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Ayeyi Dwom</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>Monto dwom foforo mma <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="ISA 42:10">Nʼayeyi mfi asase ano,</para>
  <para style="q1" vid="ISA 42:10">mo a mokɔ po so ne nea ɛwo mu nyinaa,</para>
  <para style="q2" vid="ISA 42:10">mo asupɔw ne wɔn a wɔtete so nyinaa.<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>Ma nweatam ne so nkurow mma wɔn nne so;</para>
  <para style="q2" vid="ISA 42:11">ma atenae a Kedar te so no nsɛpɛw wɔn ho.</para>
  <para style="q1" vid="ISA 42:11">Ma nnipa a wɔwɔ Sela nto nnwom nnye wɔn ani;</para>
  <para style="q2" vid="ISA 42:11">ma wɔnteɛ mu mfi mmepɔw no atifi!<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>Ma wɔnhyɛ <char style="nd">Awurade</char> anuonyam;</para>
  <para style="q2" vid="ISA 42:12">na wɔmpae mu nka nʼayeyi no wɔ asupɔw no so.<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>
    <char style="nd">Awurade</char> bepue aba sɛ ɔkatakyi,</para>
  <para style="q2" vid="ISA 42:13">te sɛ ɔkofo no, ɔbɛhyɛ ne mmɔdemmɔ mu den;</para>
  <para style="q1" vid="ISA 42:13">ɔde nteɛmu bɛyɛ ɔkofo nkanyan</para>
  <para style="q2" vid="ISA 42:13">na obedi nʼatamfo so nkonim.<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>“Mayɛ komm akyɛ,</para>
  <para style="q2" vid="ISA 42:14">mayɛ dinn na mahyɛ me ho so.</para>
  <para style="q1" vid="ISA 42:14">Nanso afei, te sɛ ɔbea a ɔrewo no,</para>
  <para style="q2" vid="ISA 42:14">meteɛ mu, mehome a ensi so na mehome afrɛ so.<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>Mɛsɛe mmepɔw ne nkoko no</para>
  <para style="q2" vid="ISA 42:15">na mahyew so afifide nyinaa.</para>
  <para style="q1" vid="ISA 42:15">Mɛdan nsubɔnten ama ayɛ asupɔw,</para>
  <para style="q2" vid="ISA 42:15">na mama atare ayoyow.<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>Medi anifuraefo anim afa akwan a wonnim so so,</para>
  <para style="q2" vid="ISA 42:16">akwan a wonnim so papa so na mɛkyerɛ wɔn kwan.</para>
  <para style="q1" vid="ISA 42:16">Mɛma sum no ayɛ hann wɔ wɔn anim,</para>
  <para style="q2" vid="ISA 42:16">na mayɛ mmeae a ɛyɛ abonkyiabonkyi no trontrom.</para>
  <para style="q1" vid="ISA 42:16">Eyinom ne nneɛma a mɛyɛ;</para>
  <para style="q2" vid="ISA 42:16">merennyaw wɔn mu.<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>Na wɔn a wɔde wɔn ho to ahoni so,</para>
  <para style="q2" vid="ISA 42:17">na wɔka kyerɛ nsɛsode se, ‘Moyɛ yɛn anyame’ no,</para>
  <para style="q2" vid="ISA 42:17">wɔbɛpam wɔn wɔ animguase mu.”<verse eid="ISA 42:17"/></para>
  <para style="s1">Israel, Onifuraefo Ne Ɔsotifo</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>“Tie, wo ɔsotifo;</para>
  <para style="q2" vid="ISA 42:18">hwɛ, wo onifuraefo na hu!<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>Hena ne onifuraefo sɛ me somfo,</para>
  <para style="q2" vid="ISA 42:19">na ɔyɛ ɔsotifo sɛ ɔbɔfo a mesoma no?</para>
  <para style="q1" vid="ISA 42:19">Hena na nʼani afura sɛ nea ɔde ne werɛ ahyɛ me mu,</para>
  <para style="q2" vid="ISA 42:19">nʼani afura sɛ <char style="nd">Awurade</char> somfo?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>Woahu nneɛma bebree, nanso amfa wo ho;</para>
  <para style="q2" vid="ISA 42:20">Ɔkwan da wʼasom, nanso wonte hwee.”<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>Ɛsɔɔ <char style="nd">Awurade</char> ani,</para>
  <para style="q2" vid="ISA 42:21">ne trenee nti</para>
  <para style="q2" vid="ISA 42:21">sɛ ɔbɛma ne mmara ayɛ kɛse na anya anuonyam.<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>Nanso saa nnipa a wɔawia wɔn na wɔafow wɔn yi,</para>
  <para style="q2" vid="ISA 42:22">wɔn nyinaa aka amoa mu</para>
  <para style="q2" vid="ISA 42:22">anaa wɔde wɔn asie wɔ afiase.</para>
  <para style="q1" vid="ISA 42:22">Wɔayɛ wɔn asade</para>
  <para style="q2" vid="ISA 42:22">na wonni obi a obegye wɔn;</para>
  <para style="q1" vid="ISA 42:22">wɔayɛ wɔn akorɔnne</para>
  <para style="q2" vid="ISA 42:22">na wonni obi a ɔbɛka se, “Momfa wɔn nsan nkɔ.”<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>Mo mu hena na obetie eyi</para>
  <para style="q2" vid="ISA 42:23">anaa nʼani beku ho yiye akyiri yi?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>Hena na ɔde Yakob maa sɛ ɔmmɛyɛ akorɔnne,</para>
  <para style="q2" vid="ISA 42:24">na ɔde Israel maa afowfo?</para>
  <para style="q1" vid="ISA 42:24">Ɛnyɛ <char style="nd">Awurade</char> a</para>
  <para style="q2" vid="ISA 42:24">yɛayɛ bɔne atia no no?</para>
  <para style="q1" vid="ISA 42:24">Efisɛ wɔannantew nʼakwan so;</para>
  <para style="q2" vid="ISA 42:24">na wɔanni ne mmara so.<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>Enti ohwiee nʼabufuwhyew guu wɔn so,</para>
  <para style="q2" vid="ISA 42:25">akodi mu basabasayɛ.</para>
  <para style="q1" vid="ISA 42:25">Ɛde ogyaframa bunkam wɔn so, nanso wɔante ase.</para>
  <para style="q2" vid="ISA 42:25">Ɛhyew wɔn, nanso amfa wɔn ho.<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">Israel Agyenkwa Koro</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>Na afei, sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 43:1">nea ɔbɔɔ wo, Yakob</para>
  <para style="q2" vid="ISA 43:1">nea ɔnwen wo, Israel;</para>
  <para style="q1" vid="ISA 43:1">“Nsuro na magye wo;</para>
  <para style="q2" vid="ISA 43:1">mabɔ wo din afrɛ wo; woyɛ me dea.<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>Sɛ wofa nsu mu a,</para>
  <para style="q2" vid="ISA 43:2">mɛka wo ho;</para>
  <para style="q1" vid="ISA 43:2">na sɛ wutwa nsubɔnten no a,</para>
  <para style="q2" vid="ISA 43:2">ɛremmu mfa wo so.</para>
  <para style="q1" vid="ISA 43:2">Sɛ wonantew ogya no mu a,</para>
  <para style="q2" vid="ISA 43:2">worenhyew;</para>
  <para style="q2" vid="ISA 43:2">ogyaframa no renhye wo.<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>Na mene <char style="nd">Awurade</char>, wo Nyankopɔn,</para>
  <para style="q2" vid="ISA 43:3">Israel Kronkronni, wo Agyenkwa.</para>
  <para style="q1" vid="ISA 43:3">Mede Misraim yɛ mpata ma wo</para>
  <para style="q2" vid="ISA 43:3">na mede Kus ne Seba si wʼanan mu.<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>Sɛ wosom bo ma me na wowɔ anuonyam wɔ mʼanim</para>
  <para style="q2" vid="ISA 43:4">na medɔ wo nti,</para>
  <para style="q1" vid="ISA 43:4">mede nnipa bɛsesa wo,</para>
  <para style="q2" vid="ISA 43:4">na mede nkurɔfo asesa wo nkwa.<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>Nsuro, efisɛ meka mo ho;</para>
  <para style="q2" vid="ISA 43:5">mede wo mma befi apuei fam aba</para>
  <para style="q2" vid="ISA 43:5">na maboa wɔn ano afi atɔe fam.<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>Mɛka akyerɛ atifi fam se, ‘Munnyaa wɔn!’</para>
  <para style="q2" vid="ISA 43:6">ne anafo fam se, ‘Munnye wɔn ntena ha.’</para>
  <para style="q1" vid="ISA 43:6">Momfa me mmabarima mfi akyirikyiri mmra</para>
  <para style="q2" vid="ISA 43:6">na me mmabea mfi asase ano mmra,<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>obiara a me din da no so,</para>
  <para style="q2" vid="ISA 43:7">nea mebɔɔ no de hyɛɛ me ho anuonyam,</para>
  <para style="q2" vid="ISA 43:7">nea menwen no na meyɛɛ no.”<verse eid="ISA 43:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>Momfa wɔn a wɔwɔ ani, nanso wonhu ade</para>
  <para style="q2" vid="ISA 43:8">wɔn a wɔwɔ aso nanso asisiw no mmra.<verse eid="ISA 43:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9"/>Aman no nyinaa boa wɔn ho ano,</para>
  <para style="q2" vid="ISA 43:9">na nnipa no hyia mu.</para>
  <para style="q1" vid="ISA 43:9">Wɔn mu hena na ɔkaa eyi fii mfiase</para>
  <para style="q2" vid="ISA 43:9">na ɔpaee mu kaa nneɛma a atwam no kyerɛɛ yɛn?</para>
  <para style="q1" vid="ISA 43:9">Ma wɔmmfa wɔn nnansefo mmra mmedi adanse sɛ wodi bem,</para>
  <para style="q2" vid="ISA 43:9">sɛnea afoforo bɛte na wɔaka se, “Ɛyɛ nokware.”<verse eid="ISA 43:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>“Mone me nnansefo, ne mʼasomfo a mapaw no,”</para>
  <para style="q2" vid="ISA 43:10">sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q1" vid="ISA 43:10">“Sɛnea mubehu na moagye me adi</para>
  <para style="q2" vid="ISA 43:10">na moate ase sɛ me ne no.</para>
  <para style="q1" vid="ISA 43:10">Wɔammɔ onyame bi anni mʼanim,</para>
  <para style="q2" vid="ISA 43:10">na mʼakyi nso obiara remma.<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>Me, Me ara, Mene <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 43:11">na agyenkwa biara nni hɔ sɛ me.<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>Mada no adi na magye nkwa na mapae mu aka se,</para>
  <para style="q2" vid="ISA 43:12">Me, na ɛnyɛ onyame nanani bi a ɔwɔ mo mu.</para>
  <para style="q1" vid="ISA 43:12">Mone me nnansefo,” <char style="nd">Awurade</char> na ose sɛ, “Mene Onyankopɔn.<verse eid="ISA 43:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13"/>Yiw, na efi teteete no me ne no.</para>
  <para style="q2" vid="ISA 43:13">Obiara rentumi nnye mfi me nsam</para>
  <para style="q1" vid="ISA 43:13">sɛ meyɛ biribi a, hena na obetumi adan no?”<verse eid="ISA 43:13"/></para>
  <para style="s1">Onyankopɔn Ahummɔbɔ Ne Israel Huammɔdi</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14"/>Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 43:14">wʼAgyenkwa, Israel Kronkronni no:</para>
  <para style="q1" vid="ISA 43:14">“Mo nti, mɛsoma akɔ Babilonia,</para>
  <para style="q2" vid="ISA 43:14">na mede Babiloniafo nyinaa bɛba sɛ aguanfo</para>
  <para style="q2" vid="ISA 43:14">wɔ ahyɛn a wɔde hoahoa wɔn ho no mu.<verse eid="ISA 43:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15"/>Mene <char style="nd">Awurade</char>, wo Kronkronni no,</para>
  <para style="q2" vid="ISA 43:15">Israel Yɛfo, wo Hene.”<verse eid="ISA 43:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16"/>Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 43:16">nea ɔbɔɔ kwan wɔ po mu,</para>
  <para style="q2" vid="ISA 43:16">kwan a ɛda asubun mu,<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>nea ɔtwee nteaseɛnam ne apɔnkɔ,</para>
  <para style="q2" vid="ISA 43:17">asraafo ne ne nkekaho nyinaa,</para>
  <para style="q1" vid="ISA 43:17">na wɔkaa hɔ a wɔansɔre bio,</para>
  <para style="q2" vid="ISA 43:17">wɔadum wɔn te sɛ kanea mu ntamabamma:<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>“Momma mo werɛ mfi kan nneɛma no</para>
  <para style="q2" vid="ISA 43:18">monntɔ nnkɔ nea atwam no so.<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>Hwɛ, mereyɛ ade foforo!</para>
  <para style="q2" vid="ISA 43:19">Mprempren, ɛrepue; na munhu ana?</para>
  <para style="q1" vid="ISA 43:19">Merebɔ kwan afa nweatam so</para>
  <para style="q2" vid="ISA 43:19">na mereyɛ nsuwansuwa wɔ asase wosee so.<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>Mmoa a wɔyɛ keka hyɛ me anuonyam,</para>
  <para style="q2" vid="ISA 43:20">adompo ne mpatu,</para>
  <para style="q1" vid="ISA 43:20">efisɛ mema nsu wɔ nweatam so</para>
  <para style="q2" vid="ISA 43:20">ne nsuwansuwa wɔ asase wosee so,</para>
  <para style="q2" vid="ISA 43:20">de ma me nkurɔfo, wɔn a mapaw wɔn no nsu,<verse eid="ISA 43:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 43:21"/>nnipa a meyɛɛ wɔn maa me ho</para>
  <para style="q2" vid="ISA 43:21">sɛ wɔmpae mu nka mʼayeyi.<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>“Nanso, womfrɛɛ me, Yakob,</para>
  <para style="q2" vid="ISA 43:22">wonhaw wo ho wɔ me ho, Israel.<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>Momfaa nguan mmrɛɛ me sɛ ɔhyew afɔrebɔde,</para>
  <para style="q2" vid="ISA 43:23">na momfaa mo afɔrebɔ nhyɛɛ me anuonyam nso.</para>
  <para style="q1" vid="ISA 43:23">Memmaa aduan afɔre nyɛɛ mo adesoa</para>
  <para style="q2" vid="ISA 43:23">na memfaa nnuhuamgye nhaw mo.<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>Montɔɔ nnuhuam mmrɛɛ me,</para>
  <para style="q2" vid="ISA 43:24">na mommaa mo afɔrebɔde mu srade mmuu me so.</para>
  <para style="q1" vid="ISA 43:24">Mmom, mode mo bɔne asoa me</para>
  <para style="q2" vid="ISA 43:24">na mode mo mfomso ho haw abɛto me so.<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>“Me, me ara, mene nea ɔpepa</para>
  <para style="q2" vid="ISA 43:25">mo bɔne, me nti,</para>
  <para style="q2" vid="ISA 43:25">na menkae mo amumɔyɛ bio.<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>Monhwehwɛ nea atwa mu no mu bio mma me,</para>
  <para style="q2" vid="ISA 43:26">momma yɛmmɔ mu nnye asɛm no ho akyinnye;</para>
  <para style="q2" vid="ISA 43:26">ka wʼasɛm a ɛkyerɛ sɛ wunni fɔ no.<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>Mo agya a odii kan no yɛɛ bɔne;</para>
  <para style="q2" vid="ISA 43:27">mo kasamafo tew mʼanim atua.<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>Enti magu mo asɔredan mu atitiriw anim ase,</para>
  <para style="q2" vid="ISA 43:28">na mede Yakob ama ɔsɛe</para>
  <para style="q2" vid="ISA 43:28">na mede Israel ama ahohora.<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">Israel, Nea Wɔapaw No</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1"/>“Na afei tie, Yakob me somfo,</para>
  <para style="q2" vid="ISA 44:1">Israel, nea mapaw no.<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 44:2">nea ɔnwen wo, na ɔyɛɛ wo wɔ awotwaa mu,</para>
  <para style="q2" vid="ISA 44:2">ɔno na ɔbɛboa wo:</para>
  <para style="q1" vid="ISA 44:2">Nsuro Yakob, me somfo,</para>
  <para style="q2" vid="ISA 44:2">Yeshurun, a mapaw no.<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>Na mehwie nsu agu asase a awo no so,</para>
  <para style="q2" vid="ISA 44:3">ne nsuten wɔ asase kesee so;</para>
  <para style="q1" vid="ISA 44:3">mehwie me Honhom agu wo mma so,</para>
  <para style="q2" vid="ISA 44:3">ne me nhyira agu wʼasefo so.<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>Wobefifi sɛnea sare fifi wɔ mmoa adidibea,</para>
  <para style="q2" vid="ISA 44:4">te sɛ mpampuro a ɛwɔ asuten ho.<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>Obi bɛka se, ‘Meyɛ <char style="nd">Awurade</char> de’;</para>
  <para style="q2" vid="ISA 44:5">ɔfoforo bɛfrɛ ne ho se Yakob;</para>
  <para style="q1" vid="ISA 44:5">afoforo bɛkɔ so akyerɛw wɔn nsa ho se, ‘<char style="nd">Awurade</char> de,’</para>
  <para style="q2" vid="ISA 44:5">na wɔafa din Israel.<verse eid="ISA 44:5"/></para>
  <para style="s1">Ɛyɛ <char style="nd">Awurade</char>, Ɛnyɛ Ahoni</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>“Sɛɛ na <char style="nd">Awurade</char></para>
  <para style="q2" vid="ISA 44:6">Israelhene ne Ogyefo, Asafo <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 44:6">Mene odikanfo ne okyikafo;</para>
  <para style="q2" vid="ISA 44:6">Onyankopɔn biara nni hɔ sɛ me.<verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>Hena na ɔne me sɛ? Ma ɔmpae mu nka.</para>
  <para style="q2" vid="ISA 44:7">Ma ɔnka na ɔnkyerɛ wɔ mʼanim</para>
  <para style="q1" vid="ISA 44:7">nea asisi fi bere a migyee me tete nkurɔfo sii hɔ,</para>
  <para style="q2" vid="ISA 44:7">ne nea ɛrebɛba.</para>
  <para style="q2" vid="ISA 44:7">Yiw, ma ɔnhyɛ nea ɛreba ho nkɔm.<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>Mommma mo ho mpopo, munnsuro.</para>
  <para style="q2" vid="ISA 44:8">Mampae mu anka eyi, manhyɛ ho amfi teteete ana?</para>
  <para style="q1" vid="ISA 44:8">Mone me nnansefo. Onyankopɔn foforo bi ka me ho ana?</para>
  <para style="q2" vid="ISA 44:8">Dabi, Ɔbotan foforo bi nni hɔ; minnim baako mpo.”<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>Wɔn a wɔyɛ ahoni nyinaa nka hwee,</para>
  <para style="q2" vid="ISA 44:9">na nneɛma a ɛsom wɔn bo no so nni mfaso.</para>
  <para style="q1" vid="ISA 44:9">Wɔn a anka wɔkasa ma wɔn no ani afura;</para>
  <para style="q2" vid="ISA 44:9">wonnim wɔn ankasa animguase ho hwee.<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>Hena na ɔbɔ onyame na ogu ohoni,</para>
  <para style="q2" vid="ISA 44:10">a ne so mma no mfaso biara?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>Ɔno ne wɔn a wɔte sɛ no nyinaa anim begu ase;</para>
  <para style="q2" vid="ISA 44:11">adwumfo nyɛ hwee sɛ nnipa.</para>
  <para style="q1" vid="ISA 44:11">Momma wɔn nyinaa mmɔ mu nsɔre nnyina,</para>
  <para style="q2" vid="ISA 44:11">ehu ne animguase na ɛbɛka wɔn.<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>Ɔtomfo fa nʼatonnade</para>
  <para style="q2" vid="ISA 44:12">ɔde hyehyɛ nnyansramma mu;</para>
  <para style="q1" vid="ISA 44:12">ɔde asae bobɔ so yɛ no ohoni,</para>
  <para style="q2" vid="ISA 44:12">ɔde nʼabasa mu ahoɔden mmoroso na ɛyɛ;</para>
  <para style="q1" vid="ISA 44:12">ɔkɔm de no na ɔyɛ mmrɛw;</para>
  <para style="q2" vid="ISA 44:12">ɔnnom nsu nti ɔtɔ beraw.<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>Duadwumfo de hama susuw</para>
  <para style="q2" vid="ISA 44:13">na ɔde kyerɛwdua sensan;</para>
  <para style="q1" vid="ISA 44:13">na ɔde pɛe yiyi ho</para>
  <para style="q2" vid="ISA 44:13">afei ɔde kɔmpaase hyɛ no agyirae.</para>
  <para style="q1" vid="ISA 44:13">Osen na ɛyɛ sɛ onipa sɛso,</para>
  <para style="q2" vid="ISA 44:13">ɛyɛ sɛ onipa wɔ nʼanuonyam nyinaa mu,</para>
  <para style="q2" vid="ISA 44:13">sɛ wɔde besi abosonnan mu.<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>Otwitwaa sida,</para>
  <para style="q2" vid="ISA 44:14">anaasɛ ebia ɔfaa kwabɔhɔre anaa odum.</para>
  <para style="q1" vid="ISA 44:14">Ɔma enyinii wɔ kwae mu,</para>
  <para style="q2" vid="ISA 44:14">anaa oduaa ɔpepaw, na osu ma enyinii.<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>Ɛyɛ nea onipa de sɔ ogya;</para>
  <para style="q2" vid="ISA 44:15">ɔde bi ka ne ho hyew,</para>
  <para style="q2" vid="ISA 44:15">ɔde bi sɔ ogya to brodo.</para>
  <para style="q1" vid="ISA 44:15">Nanso ɔde bi sen onyame na ɔsɔre no;</para>
  <para style="q2" vid="ISA 44:15">ɔyɛ ohoni na ɔkotow no.<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>Ɔde dua no mu fa sɔ ogya;</para>
  <para style="q2" vid="ISA 44:16">so na ɔnoa nʼaduan,</para>
  <para style="q2" vid="ISA 44:16">ɔtoto ne nam wɔ so na wawe amee.</para>
  <para style="q1" vid="ISA 44:16">Afei ɔka ne ho hyew na ɔka se,</para>
  <para style="q2" vid="ISA 44:16">Aa! mahu ogya; me ho ayɛ me hyew.<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>Nkae no ɔde yɛ onyame, ne ohoni;</para>
  <para style="q2" vid="ISA 44:17">ɔkotow no na ɔsɔre no.</para>
  <para style="q1" vid="ISA 44:17">Ɔbɔ no mpae se,</para>
  <para style="q2" vid="ISA 44:17">“Gye me; wo ne me nyame.”<verse eid="ISA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>Wonnim hwee, na wɔnte hwee ase;</para>
  <para style="q2" vid="ISA 44:18">wɔatare wɔn ani so nti wonhu ade,</para>
  <para style="q2" vid="ISA 44:18">wɔato wɔn adwene mu nti wɔnte hwee ase.<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>Obiara nna nnwen ho,</para>
  <para style="q2" vid="ISA 44:19">obiara nni nimdeɛ anaa nhumu a ɔde bɛka se,</para>
  <para style="q1" vid="ISA 44:19">“Mede fa sɔɔ ogya;</para>
  <para style="q2" vid="ISA 44:19">na mpo metoo brodo wɔ ne nnyansramma so;</para>
  <para style="q2" vid="ISA 44:19">metotoo nam wɔ so wee.</para>
  <para style="q1" vid="ISA 44:19">Ɛsɛ sɛ mede nkae no yɛ akyiwade ana?</para>
  <para style="q2" vid="ISA 44:19">Ɛsɛ sɛ mekotow gyentia ana?”<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>Saa onipa no di nsõ, nnaadaa koma ma no to kwan;</para>
  <para style="q2" vid="ISA 44:20">ɔrentumi nnye ne ho, anaa nka se,</para>
  <para style="q2" vid="ISA 44:20">“Nea mikura wɔ me nsa nifa yi nyɛ atoro ana?”<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21"/>“Kae saa nneɛma yi, Yakob,</para>
  <para style="q2" vid="ISA 44:21">efisɛ, woyɛ me somfo, Israel.</para>
  <para style="q1" vid="ISA 44:21">Me na meyɛɛ wo, woyɛ me somfo;</para>
  <para style="q2" vid="ISA 44:21">Ao Israel, me werɛ remfi wo.<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>Mapra wo mfomso agu te sɛ omununkum</para>
  <para style="q2" vid="ISA 44:22">ne wo bɔne te sɛ anɔpa bosu.</para>
  <para style="q1" vid="ISA 44:22">San bra me nkyɛn,</para>
  <para style="q2" vid="ISA 44:22">efisɛ magye wo.”<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>Momfa ahosɛpɛw nto dwom, ɔsorosoro,</para>
  <para style="q2" vid="ISA 44:23">na <char style="nd">Awurade</char> na wayɛ eyi.</para>
  <para style="q1" vid="ISA 44:23">Mommɔ ose, asase ase.</para>
  <para style="q2" vid="ISA 44:23">Momma nnwonto so, mo mmepɔw,</para>
  <para style="q1" vid="ISA 44:23">mo kwae ne emu nnua nyinaa,</para>
  <para style="q2" vid="ISA 44:23">na <char style="nd">Awurade</char> agye Yakob,</para>
  <para style="q2" vid="ISA 44:23">wada nʼanuonyam adi wɔ Israel.<verse eid="ISA 44:23"/></para>
  <para style="s1">Wɔbɛtena Yerusalem</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>“Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 44:24">wo Gyefo a ɔnwen wo wɔ awotwaa mu no:</para>
  <para style="b" vid="ISA 44:24"/>
  <para style="q1" vid="ISA 44:24">“Mene <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 44:24">nea wayɛ nneɛma nyinaa,</para>
  <para style="q1" vid="ISA 44:24">nea ɔno nko ara trɛw ɔsoro mu</para>
  <para style="q2" vid="ISA 44:24">nea ɔno nko ara twee asase mu,<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>nea ɔsɛe atoro adiyifo nsɛnkyerɛnne</para>
  <para style="q2" vid="ISA 44:25">na ɔma nkɔmhyɛfo yɛ nkwaseafo,</para>
  <para style="q1" vid="ISA 44:25">nea otutu anyansafo adenim gu</para>
  <para style="q2" vid="ISA 44:25">na ɔdan no nkwaseasɛm,<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>nea ɔma nʼasomfo nsɛm ba mu</para>
  <para style="q2" vid="ISA 44:26">nea ɔhyɛ nʼasomafo nkɔmhyɛ mu ma,</para>
  <para style="b" vid="ISA 44:26"/>
  <para style="q1" vid="ISA 44:26">“nea ɔka fa Yerusalem ho se, ‘Wɔbɛtena mu,’</para>
  <para style="q2" vid="ISA 44:26">ne Yuda nkurow ho se, ‘Wɔbɛkyekye,’</para>
  <para style="q2" vid="ISA 44:26">ne mmubui ho se, ‘Mɛyɛ no foforo,’<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>nea ɔka kyerɛ asubun se, ‘Yow,</para>
  <para style="q2" vid="ISA 44:27">na mɛma wo nsuwa ayoyow,’<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>nea ɔka wɔ Kores ho se, ‘Ɔyɛ me guanhwɛfo</para>
  <para style="q2" vid="ISA 44:28">na obewie nea mepɛ nyinaa yɛ;</para>
  <para style="q2" vid="ISA 44:28">ɔbɛka afa Yerusalem ho se, “Ma wɔnkyekyere bio,”</para>
  <para style="q2" vid="ISA 44:28">na waka afa asɔredan no ho se, “Ma wɔnto ne fapem.” ’ ”<verse eid="ISA 44:28"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1"/>“Sɛɛ na <char style="nd">Awurade</char> ka kyerɛ nea wasra no ngo,</para>
  <para style="q2" vid="ISA 45:1">Kores a maso ne nsa nifa mu</para>
  <para style="q1" vid="ISA 45:1">sɛ ɔmmrɛ aman ase wɔ nʼanim</para>
  <para style="q2" vid="ISA 45:1">na onnye ahemfo akode mfi wɔn nsam</para>
  <para style="q1" vid="ISA 45:1">sɛ ommuebue apon a ɛwɔ nʼanim</para>
  <para style="q2" vid="ISA 45:1">sɛnea kurow apon no mu rentoto.<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>Medi wʼanim</para>
  <para style="q2" vid="ISA 45:2">mɛyɛ mmepɔw tamaa;</para>
  <para style="q1" vid="ISA 45:2">mebubu kɔbere mfrafrae apon agu</para>
  <para style="q2" vid="ISA 45:2">na matwitwa nnade adaban mu.<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>Mede sum mu ademude bɛma wo</para>
  <para style="q2" vid="ISA 45:3">ahonyade a wɔde asie kokoa mu</para>
  <para style="q1" vid="ISA 45:3">sɛnea wubehu sɛ, mene <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 45:3">Israel Nyankopɔn, a ɔbɔ wo din frɛ wo no.<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>Me somfo Yakob nti,</para>
  <para style="q2" vid="ISA 45:4">Israel a mapaw no nti,</para>
  <para style="q1" vid="ISA 45:4">mebɔ wo din frɛ wo</para>
  <para style="q2" vid="ISA 45:4">na mɛma wo anuonyamhyɛ abodin,</para>
  <para style="q2" vid="ISA 45:4">ɛwɔ mu sɛ wunnyee me ntoo mu de.<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>Mene <char style="nd">Awurade</char>, obiara nni hɔ bio;</para>
  <para style="q2" vid="ISA 45:5">Onyankopɔn biara nni hɔ ka me ho.</para>
  <para style="q1" vid="ISA 45:5">Mɛhyɛ wo den,</para>
  <para style="q2" vid="ISA 45:5">ɛwɔ mu sɛ wunnyee me ntoo mu de,<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>sɛnea ɛbɛyɛ a efi nea owia pue</para>
  <para style="q2" vid="ISA 45:6">kosi beae a ɛtɔ no</para>
  <para style="q1" vid="ISA 45:6">nnipa behu sɛ obiara nka me ho.</para>
  <para style="q2" vid="ISA 45:6">Mene <char style="nd">Awurade</char>, na obiara nni hɔ bio.<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>Meyɛ hann, na mebɔ sum.</para>
  <para style="q2" vid="ISA 45:7">Mede yiyedi ba na mede ɔhaw ba;</para>
  <para style="q2" vid="ISA 45:7">Me, <char style="nd">Awurade</char>, na meyɛ eyinom nyinaa.<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>“Mo ɔsorosoro munhwie trenee ngu fam;</para>
  <para style="q2" vid="ISA 45:8">momma emfi omununkum mu ntɔ</para>
  <para style="q1" vid="ISA 45:8">momma asase mu mmue kɛse,</para>
  <para style="q2" vid="ISA 45:8">na nkwagye mpue mfi mu,</para>
  <para style="q1" vid="ISA 45:8">na trenee ne no nnyin;</para>
  <para style="q2" vid="ISA 45:8">Me, <char style="nd">Awurade</char> na mayɛ.<verse eid="ISA 45:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>“Nnome nka nea ɔne ne Yɛfo ham</para>
  <para style="q2" vid="ISA 45:9">ɛnka nea ɔmfra te sɛ kyɛmfɛre a ɛfra nea egugu fam mu.</para>
  <para style="q1" vid="ISA 45:9">Dɔte betumi abisa ɔnwemfo se,</para>
  <para style="q2" vid="ISA 45:9">‘Dɛn na woreyɛ yi?’</para>
  <para style="q1" vid="ISA 45:9">Wʼadwuma betumi abisa wo se</para>
  <para style="q2" vid="ISA 45:9">‘Wunni nsa’?<verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>Nnome nka nea ose nʼagya se</para>
  <para style="q2" vid="ISA 45:10">‘Dɛn na woawo yi?’</para>
  <para style="q1" vid="ISA 45:10">Anaa obisa ne na se,</para>
  <para style="q2" vid="ISA 45:10">‘Dɛn na wokyem woe?’<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>“Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 45:11">Israel Ɔkronkronni ne ne Yɛfo;</para>
  <para style="q1" vid="ISA 45:11">Nea ɛfa nneɛma a ɛreba ho no,</para>
  <para style="q2" vid="ISA 45:11">wubisa me nsɛm a ɛfa me mma ho,</para>
  <para style="q2" vid="ISA 45:11">anaa wohyɛ me wɔ me nsa ano adwuma ho?<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>Ɛyɛ me na meyɛɛ asase</para>
  <para style="q2" vid="ISA 45:12">na mebɔɔ adesamma guu so.</para>
  <para style="q1" vid="ISA 45:12">Me ara me nsa na mede trɛw ɔsoro mu;</para>
  <para style="q2" vid="ISA 45:12">nsoromma ahorow nyinaa hyɛ mʼase.<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>Mɛma Kores so wɔ me trenee mu;</para>
  <para style="q2" vid="ISA 45:13">meteɛteɛ nʼakwan nyinaa.</para>
  <para style="q1" vid="ISA 45:13">Ɔbɛsan akyekyere me kuropɔn</para>
  <para style="q2" vid="ISA 45:13">na wagyaa me nnommumfo,</para>
  <para style="q1" vid="ISA 45:13">nanso ɔrennye akatua anaa akyɛde,</para>
  <para style="q2" vid="ISA 45:13">Asafo <char style="nd">Awurade</char> na ose.”<verse eid="ISA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14"/>Sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 45:14">“Nneɛma a efi Misraim ne aguade a efi Kus,</para>
  <para style="q2" vid="ISA 45:14">ne Sebafo atenten no,</para>
  <para style="q1" vid="ISA 45:14">wɔbɛba wo nkyɛn</para>
  <para style="q2" vid="ISA 45:14">abɛyɛ wo dea;</para>
  <para style="q1" vid="ISA 45:14">wobedi wʼakyi brɛoo aba a</para>
  <para style="q2" vid="ISA 45:14">wogu nkɔnsɔnkɔnsɔn mu.</para>
  <para style="q1" vid="ISA 45:14">Wobebu nkotodwe wʼanim</para>
  <para style="q2" vid="ISA 45:14">na wɔasrɛ wo aka se,</para>
  <para style="q1" vid="ISA 45:14">‘Ampa ara, Onyankopɔn ka wo ho, na obi nni hɔ;</para>
  <para style="q2" vid="ISA 45:14">onyame biara nni hɔ.’ ”<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>Ampa ara, woyɛ Onyankopɔn a ɔde ne ho sie,</para>
  <para style="q2" vid="ISA 45:15">Ao Onyankopɔn ne Israel Agyenkwa.<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>Wɔn a wɔyɛ ahoni nyinaa bɛfɛre na wɔn anim agu ase;</para>
  <para style="q2" vid="ISA 45:16">wɔbɛbɔ mu akɔ animguase mu.<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>Nanso <char style="nd">Awurade</char> begye Israel nkwa,</para>
  <para style="q2" vid="ISA 45:17">ɔde daapem nkwagye;</para>
  <para style="q1" vid="ISA 45:17">wɔremma wʼani nwu na wʼanim rengu ase bio</para>
  <para style="q2" vid="ISA 45:17">kosi daapem.<verse eid="ISA 45:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>Na sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 45:18">nea ɔbɔɔ ɔsorosoro no</para>
  <para style="q1" vid="ISA 45:18">ɔno ne Onyankopɔn;</para>
  <para style="q2" vid="ISA 45:18">nea ɔmaa asase, ne tebea na ɔbɔe no,</para>
  <para style="q1" vid="ISA 45:18">ɔno na ɔtoo ne fapem;</para>
  <para style="q2" vid="ISA 45:18">wammɔ no sɛ so nna hɔ kwa,</para>
  <para style="q1" vid="ISA 45:18">mmom, ɔyɛe se nnipa ntena so,</para>
  <para style="q2" vid="ISA 45:18">ɔka se:</para>
  <para style="q1" vid="ISA 45:18">“Mene <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 45:18">na obi nni hɔ.<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>Menkasaa wɔ kokoa mu,</para>
  <para style="q2" vid="ISA 45:19">mfi asase so baabi a aduru sum;</para>
  <para style="q1" vid="ISA 45:19">menka nkyerɛɛ Yakob asefo se,</para>
  <para style="q2" vid="ISA 45:19">‘Monhwehwɛ me na munhu me.’</para>
  <para style="q1" vid="ISA 45:19">Me <char style="nd">Awurade</char>, meka nokware no;</para>
  <para style="q2" vid="ISA 45:19">meka nea eye.<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>“Mommoaboa mo ho ano na mommra;</para>
  <para style="q2" vid="ISA 45:20">munhyia mu, mo aguanfo a mufi amanaman so.</para>
  <para style="q1" vid="ISA 45:20">Wɔn a wonnim de na wɔsoa nnua ahoni de kyinkyin</para>
  <para style="q2" vid="ISA 45:20">wɔn a wɔbɔ anyame a wontumi nnye nkwa no mpae.<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>Mompae mu nka nea ebesi, momfa nto gua,</para>
  <para style="q2" vid="ISA 45:21">ma wɔmmɔ mu ntu agyina.</para>
  <para style="q1" vid="ISA 45:21">Hena na odii kan kaa no teteete,</para>
  <para style="q2" vid="ISA 45:21">hena na ɔdaa no adi fi tete nteredee?</para>
  <para style="q1" vid="ISA 45:21">Ɛnyɛ me <char style="nd">Awurade</char> ana?</para>
  <para style="q2" vid="ISA 45:21">Onyankopɔn bi nni hɔ ka me ho,</para>
  <para style="q1" vid="ISA 45:21">trenee Nyankopɔn ne Agyenkwa;</para>
  <para style="q2" vid="ISA 45:21">obiara nni hɔ sɛ me.<verse eid="ISA 45:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>“Monnan mmra me nkyɛn na munnya nkwa,</para>
  <para style="q2" vid="ISA 45:22">mo a mowɔ asase ano nyinaa;</para>
  <para style="q1" vid="ISA 45:22">efisɛ mene Onyankopɔn, na obiara nni hɔ.<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>Maka me ho ntam,</para>
  <para style="q2" vid="ISA 45:23">mʼano aka wɔ nokwaredi nyinaa mu</para>
  <para style="q2" vid="ISA 45:23">asɛm a wɔntwe nsan sɛ:</para>
  <para style="q1" vid="ISA 45:23">obiara bebu nkotodwe wɔ mʼanim.</para>
  <para style="q2" vid="ISA 45:23">Na obiara bɛpae mu aka se, mene Onyankopɔn.<verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>Wɔbɛka me ho asɛm se, ‘<char style="nd">Awurade</char> nko ara mu</para>
  <para style="q2" vid="ISA 45:24">na trenee ne ahoɔden wɔ.’ ”</para>
  <para style="q1" vid="ISA 45:24">Wɔn a wɔn bo huru tia no nyinaa</para>
  <para style="q2" vid="ISA 45:24">bɛba ne nkyɛn na wɔn anim begu ase.<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>Nanso <char style="nd">Awurade</char> mu, Israel asefo nyinaa</para>
  <para style="q2" vid="ISA 45:25">wobebu wɔn bem, na wɔahoahoa wɔn ho.<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">Babilonia Anyame</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1"/>Bel bɔ ne mu ase, Nebo brɛ ne dibea ase;</para>
  <para style="q2" vid="ISA 46:1">mfurum soa wɔn ahoni.</para>
  <para style="q1" vid="ISA 46:1">Nsɛsode a wɔso nenam no mu yɛ duru,</para>
  <para style="q2" vid="ISA 46:1">ɛyɛ adesoa ma nea wabrɛ.<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>Wɔbɔ mu kotow, bɔ wɔn mu ase;</para>
  <para style="q2" vid="ISA 46:2">wontumi nsiw amanehunu ano,</para>
  <para style="q2" vid="ISA 46:2">wɔn ankasa kɔ nkoasom mu.<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>“Muntie me, Yakobfifo,</para>
  <para style="q2" vid="ISA 46:3">mo a moaka wɔ Israelfi nyinaa,</para>
  <para style="q1" vid="ISA 46:3">mo a maso mo mu fi mo nyinsɛn mu,</para>
  <para style="q2" vid="ISA 46:3">na maturu mo afi bere a wɔwoo mo.<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>Mpo kosi mo nkwakoraa bere ne bere a mubefuw dwen mu,</para>
  <para style="q2" vid="ISA 46:4">Me ne no, Me ne nea obeso mo mu.</para>
  <para style="q1" vid="ISA 46:4">Mabɔ mo na meturu mo;</para>
  <para style="q2" vid="ISA 46:4">mɛwowaw mo na megye mo.<verse eid="ISA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>“Hena ho na mode me bɛto, anaa mubebu no me sɛso?</para>
  <para style="q2" vid="ISA 46:5">Hena na mode me besusuw no, na mode no atoto me ho?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>Ebinom hwie sikakɔkɔɔ fi wɔn nkotoku mu</para>
  <para style="q2" vid="ISA 46:6">na wɔkari dwetɛ wɔ nsania so;</para>
  <para style="q1" vid="ISA 46:6">wɔbɔ sika dwumfo paa, ma ɔde yɛ onyame bi,</para>
  <para style="q2" vid="ISA 46:6">na wɔkotow sɔre no.<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>Wɔsoa no wɔ wɔn mmati so,</para>
  <para style="q2" vid="ISA 46:7">wɔde kosi nʼafa, na ɛka hɔ ara.</para>
  <para style="q2" vid="ISA 46:7">Ɛrentumi mfi faako a esi.</para>
  <para style="q1" vid="ISA 46:7">Obi teɛ mu frɛ no de, nanso ommua;</para>
  <para style="q2" vid="ISA 46:7">ɛrentumi nyi no mfi ne haw mu.<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>“Monkae yiye, momma ɛnka mo tirim,</para>
  <para style="q2" vid="ISA 46:8">munnwen ho mo atuatewfo.<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>Monkae nneɛma a atwam no, teteete nneɛma no;</para>
  <para style="q2" vid="ISA 46:9">Mene Onyankopɔn, na obi nni hɔ;</para>
  <para style="q2" vid="ISA 46:9">Mene Onyankopɔn, na obiara nte sɛ me.<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>Meda awiei adi fi mfiase,</para>
  <para style="q2" vid="ISA 46:10">efi tete, meka nea ɛbɛba.</para>
  <para style="q1" vid="ISA 46:10">Meka se: ‘Mʼatirimpɔw begyina,</para>
  <para style="q2" vid="ISA 46:10">na mɛyɛ nea mepɛ nyinaa.’<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>Mɛfrɛ anomaa a ɔkyere mmoa afi apuei fam;</para>
  <para style="q2" vid="ISA 46:11">afi akyirikyiri asase so, onipa a ɔbɛhyɛ me botae ma.</para>
  <para style="q1" vid="ISA 46:11">Nea maka no, ɛno na mɛma aba mu;</para>
  <para style="q2" vid="ISA 46:11">nea madwen ho no, ɛno na mɛyɛ.<verse eid="ISA 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>Muntie me, mo a moyɛ akokodurufo,</para>
  <para style="q2" vid="ISA 46:12">mo a mo ne trenee ntam kwan ware;<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>Mede me trenee rebɛn,</para>
  <para style="q2" vid="ISA 46:13">enni akyirikyiri;</para>
  <para style="q2" vid="ISA 46:13">na me nkwagye nso renkyɛ.</para>
  <para style="q1" vid="ISA 46:13">Mɛma Sion nkwagye,</para>
  <para style="q2" vid="ISA 46:13">na mede mʼanuonyam ama Israel.<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">Babilonia Asehwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1"/>“Sian kɔ, tena mfutuma mu,</para>
  <para style="q2" vid="ISA 47:1">Ɔbabea Babilonia;</para>
  <para style="q1" vid="ISA 47:1">tena fam na mfa ahengua,</para>
  <para style="q2" vid="ISA 47:1">Babiloniafo hemmea kuropɔn.</para>
  <para style="q1" vid="ISA 47:1">Wɔremfrɛ wo bio se,</para>
  <para style="q2" vid="ISA 47:1">nsiforo anaa nea ne ho yɛ na.<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>Fa awiyammo na yam esiam;</para>
  <para style="q2" vid="ISA 47:2">yi wo nkataanim no.</para>
  <para style="q1" vid="ISA 47:2">Ma wʼatade so kɔ soro, na wo nan ho ngu hɔ,</para>
  <para style="q2" vid="ISA 47:2">na fa nsuwansuwa no mu.<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>Wʼadagyaw bɛda adi</para>
  <para style="q2" vid="ISA 47:3">na wʼanimguase so renkata.</para>
  <para style="q1" vid="ISA 47:3">Mɛtɔ were;</para>
  <para style="q2" vid="ISA 47:3">meremfa obiara ho nkyɛ no.”<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>Yɛn Gyefo, Asafo <char style="nd">Awurade</char> ne ne din,</para>
  <para style="q2" vid="ISA 47:4">ɔno ne Israel Kronkronni.<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>“Tena ase dinn, kɔhyɛ sum mu,</para>
  <para style="q2" vid="ISA 47:5">Babiloniafo hemmea kurow;</para>
  <para style="q1" vid="ISA 47:5">wɔremfrɛ wo bio se</para>
  <para style="q2" vid="ISA 47:5">ahenni ahorow so hemmea.<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>Me bo fuw me nkurɔfo,</para>
  <para style="q2" vid="ISA 47:6">na miguu mʼagyapade ho fi;</para>
  <para style="q1" vid="ISA 47:6">mede wɔn hyɛɛ wo nsa,</para>
  <para style="q2" vid="ISA 47:6">na woanhu wɔn mmɔbɔ.</para>
  <para style="q1" vid="ISA 47:6">Nkwakoraa koraa mpo,</para>
  <para style="q2" vid="ISA 47:6">wosoaa wɔn konnua duruduru.<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>Wokae se, ‘Mɛkɔ so daa,</para>
  <para style="q2" vid="ISA 47:7">ayɛ ɔhemmea afebɔɔ.’</para>
  <para style="q1" vid="ISA 47:7">Nanso woannwen saa nneɛma yi ho</para>
  <para style="q2" vid="ISA 47:7">na woansusuw nea ebetumi asi ho.<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“Afei tie, wo oguamanfo,</para>
  <para style="q2" vid="ISA 47:8">woredwudwo wo ho wɔ wo bammɔ mu</para>
  <para style="q1" vid="ISA 47:8">na woka kyerɛ wo ho se,</para>
  <para style="q2" vid="ISA 47:8">‘me ne no, na obiara nni hɔ sɛ me.</para>
  <para style="q1" vid="ISA 47:8">Merenyɛ okunafo da</para>
  <para style="q2" vid="ISA 47:8">na merenni awommawu.’<verse eid="ISA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9"/>Saa nneɛma abien yi bɛto wo</para>
  <para style="q2" vid="ISA 47:9">prɛko pɛ, da koro pɛ:</para>
  <para style="q1" vid="ISA 47:9">awommawu ne kunayɛ.</para>
  <para style="q2" vid="ISA 47:9">Saa nneɛma yi bɛba wo so pa ara,</para>
  <para style="q1" vid="ISA 47:9">wʼabayisɛm bebrebe yi</para>
  <para style="q2" vid="ISA 47:9">ne ntafowayi a mu yɛ den nyinaa akyi.<verse eid="ISA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10"/>Wode wo ho ato wʼamumɔyɛ so</para>
  <para style="q2" vid="ISA 47:10">na waka se, ‘Obiara nhu me.’</para>
  <para style="q1" vid="ISA 47:10">Wo nyansa ne nimdeɛ ma wo fom kwan</para>
  <para style="q2" vid="ISA 47:10">bere a woka kyerɛ wo ho se,</para>
  <para style="q2" vid="ISA 47:10">‘Me ne no, obiara nni hɔ ka me ho.’<verse eid="ISA 47:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11"/>Amanehunu bɛto wo,</para>
  <para style="q2" vid="ISA 47:11">na worenhu ɔkwan ko a wobɛfa so ayi afi hɔ.</para>
  <para style="q1" vid="ISA 47:11">Ɔhaw bi bɛba wo so</para>
  <para style="q2" vid="ISA 47:11">a worentumi mfa mpata nyi mfi hɔ;</para>
  <para style="q1" vid="ISA 47:11">atoyerɛnkyɛm a ɛnnaa ne ho adi nkyerɛɛ wo</para>
  <para style="q2" vid="ISA 47:11">bɛba wo so mpofirim.<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12"/>“Kɔ so yɛ wo ntafowayi</para>
  <para style="q2" vid="ISA 47:12">ne wʼabayisɛm bebrebe</para>
  <para style="q2" vid="ISA 47:12">a wode adi dwuma fi wo mmofraase no.</para>
  <para style="q1" vid="ISA 47:12">Ebia wubedi nkonim,</para>
  <para style="q2" vid="ISA 47:12">ebia wode ehu bɛba.<verse eid="ISA 47:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13"/>Woabrɛ wɔ afotufo bebrebe a woanya no mu!</para>
  <para style="q2" vid="ISA 47:13">Ma wo nsoromma ho anyansafo mmra anim,</para>
  <para style="q1" vid="ISA 47:13">wɔn a wɔhwɛ nsoromma mu no, ka nea ɛreba ɔsram biara mu no,</para>
  <para style="q2" vid="ISA 47:13">ma wonnye wo mfi nea ɛreba wo so no mu.<verse eid="ISA 47:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14"/>Nokwarem, wɔte sɛ gyentia;</para>
  <para style="q2" vid="ISA 47:14">ogya bɛhyew wɔn.</para>
  <para style="q1" vid="ISA 47:14">Na wontumi nnye wɔn ankasa ho</para>
  <para style="q2" vid="ISA 47:14">mfi ogyaframa anoden no ho.</para>
  <para style="q1" vid="ISA 47:14">Nnyansramma biara nni ha a ɛbɛka obiara hyew;</para>
  <para style="q2" vid="ISA 47:14">ogya biara nni ha a wɔbɛtena ho ato.<verse eid="ISA 47:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15"/>Nea wobetumi ayɛ ama wo ara ne no,</para>
  <para style="q2" vid="ISA 47:15">eyinom na wo ne wɔn abrɛ</para>
  <para style="q2" vid="ISA 47:15">na wo ne wɔn anantew fi mmofraase.</para>
  <para style="q1" vid="ISA 47:15">Wɔn mu biara kɔ so yɛ ne mfomso;</para>
  <para style="q2" vid="ISA 47:15">ɔbaako mpo nni hɔ a obetumi agye wo.<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">Israel Ɔsoɔdenfo</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1"/>“Muntie eyi, Yakobfifo</para>
  <para style="q2" vid="ISA 48:1">mo a wɔde Israel din frɛ mo,</para>
  <para style="q1" vid="ISA 48:1">na moyɛ Yuda asefo,</para>
  <para style="q2" vid="ISA 48:1">mo a mobɔ <char style="nd">Awurade</char> din ka ntam,</para>
  <para style="q1" vid="ISA 48:1">na mofrɛ Israel Nyankopɔn,</para>
  <para style="q2" vid="ISA 48:1">nanso ɛnyɛ nokware anaa trenee mu,<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>mo a mofrɛ mo ho kurow kronkron no mma</para>
  <para style="q2" vid="ISA 48:2">na mode mo ho to Israel Nyankopɔn so,</para>
  <para style="q2" vid="ISA 48:2">Asafo <char style="nd">Awurade</char> ne ne din.<verse eid="ISA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>Mehyɛɛ nneɛma a atwa mu no ho nkɔm dedaada,</para>
  <para style="q2" vid="ISA 48:3">mebɔɔ nkae, na medaa no adi;</para>
  <para style="q2" vid="ISA 48:3">afei mpofirim mekekaa me ho na ɛbaa mu.<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>Na minim sɛnea moyɛ asoɔden fa</para>
  <para style="q2" vid="ISA 48:4">mo kɔn ho ntin yɛ dade</para>
  <para style="q2" vid="ISA 48:4">na mo moma yɛ kɔbere mfrafrae.<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>Enti, mekaa saa nsɛm yi kyerɛɛ mo dedaada</para>
  <para style="q2" vid="ISA 48:5">ansa na ɛrebesisi no, mebɔɔ mo nkae</para>
  <para style="q1" vid="ISA 48:5">sɛnea morentumi nka se,</para>
  <para style="q2" vid="ISA 48:5">‘Mʼahoni na wɔyɛe:</para>
  <para style="q2" vid="ISA 48:5">me dua nsɛsode ne me dade nyame na ɔhyɛe.’<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>Moate eyinom nyinaa; monhwɛ wɔn nyinaa.</para>
  <para style="q2" vid="ISA 48:6">Morennye wɔn nto mu ana?</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q1" vid="ISA 48:6">“Efi saa bere yi de rekɔ mɛka nsɛm foforo akyerɛ mo,</para>
  <para style="q2" vid="ISA 48:6">ɛfa nneɛma a ahintaw a munnim ho.<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>Afei na wɔayɛ koraa, ɛnkyɛe;</para>
  <para style="q2" vid="ISA 48:7">ebesi nnɛ no na anka montee ho hwee.</para>
  <para style="q1" vid="ISA 48:7">Enti morentumi nka se,</para>
  <para style="q2" vid="ISA 48:7">‘Yiw na minim dedaw!’<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>Wontee, na wontee ase;</para>
  <para style="q2" vid="ISA 48:8">efi tete nyinaa wʼaso asiw.</para>
  <para style="q1" vid="ISA 48:8">Na minim sɛ woyɛ ɔfatwafo;</para>
  <para style="q2" vid="ISA 48:8">wɔfrɛɛ wo otuatewfo fi ɔyafunu mu.<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>Me din nti metwentwɛn mʼabufuw so;</para>
  <para style="q2" vid="ISA 48:9">mʼayeyi nti miyi fi wo so,</para>
  <para style="q2" vid="ISA 48:9">sɛnea merensɛe wo koraa.<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>Hwɛ mahoa mo ho, ɛnyɛ sɛnea wɔnan dwetɛ ho;</para>
  <para style="q2" vid="ISA 48:10">mmom, masɔ wo ahwɛ wɔ amanehunu fononoo mu.<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>Me nti, me nti, na meyɛ eyi.</para>
  <para style="q2" vid="ISA 48:11">Adɛn nti na ɛsɛ sɛ mema ho kwan na wɔsɛe me din?</para>
  <para style="q2" vid="ISA 48:11">Memma obi nnye mʼanuonyam.<verse eid="ISA 48:11"/></para>
  <para style="s1">Israel Ahofadi</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>“Tie me, Yakob,</para>
  <para style="q2" vid="ISA 48:12">Israel a mafrɛ no;</para>
  <para style="q1" vid="ISA 48:12">Me ne no;</para>
  <para style="q2" vid="ISA 48:12">Me ne odikanfo ne okyikafo.<verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>Me ara me nsa na ɛtoo asase fapem,</para>
  <para style="q2" vid="ISA 48:13">na me nsa na ɛtrɛw ɔsorosoro mu;</para>
  <para style="q1" vid="ISA 48:13">sɛ mefrɛ wɔn a,</para>
  <para style="q2" vid="ISA 48:13">wɔn nyinaa bɔ mu sɔre.<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>“Mo nyinaa mommɔ mu mmra mmetie:</para>
  <para style="q2" vid="ISA 48:14">ahoni no mu nea ɔwɔ he na waka saa nsɛm yi dedaw?</para>
  <para style="q1" vid="ISA 48:14">
    <char style="nd">Awurade</char> boafo a wapaw no</para>
  <para style="q2" vid="ISA 48:14">bɛma nʼatirimpɔw a etia Babilonia aba mu;</para>
  <para style="q2" vid="ISA 48:14">ne basa betia Babiloniafo.<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>Me, me na makasa.</para>
  <para style="q2" vid="ISA 48:15">Yiw, mafrɛ no.</para>
  <para style="q1" vid="ISA 48:15">Mede no bɛba,</para>
  <para style="q2" vid="ISA 48:15">na obewie nʼadwuma nkonimdi so.<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“Montwiw mmɛn me na muntie eyi:</para>
  <para style="q1" vid="ISA 48:16">“Efi nkaebɔ a edi kan no, menkasaa wɔ kokoa mu;</para>
  <para style="q2" vid="ISA 48:16">bere biara a ebesi no, na mewɔ hɔ.”</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">Na afei Asafo <char style="nd">Awurade</char></para>
  <para style="q2" vid="ISA 48:16">de ne Honhom asoma me.<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 48:17">mo gyefo, Israel Kronkronni no:</para>
  <para style="q1" vid="ISA 48:17">“Mene <char style="nd">Awurade</char> mo Nyankopɔn,</para>
  <para style="q2" vid="ISA 48:17">nea ɔkyerɛ mo nea eye ma mo,</para>
  <para style="q2" vid="ISA 48:17">na ɔkyerɛ mo ɔkwan a ɛsɛ sɛ mofa so.<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>Sɛ mudii mʼahyɛde so a,</para>
  <para style="q2" vid="ISA 48:18">anka mo asomdwoe ayɛ sɛ asubɔnten,</para>
  <para style="q2" vid="ISA 48:18">na mo trenee ayɛ sɛ po asorɔkye.<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>Anka mo asefo ayɛ sɛ nwea,</para>
  <para style="q2" vid="ISA 48:19">na mo mma ayɛ sɛ ne mmosea a wontumi nkan;</para>
  <para style="q1" vid="ISA 48:19">wɔn din rempepa da</para>
  <para style="q2" vid="ISA 48:19">wɔrensɛe mfi mʼanim.”<verse eid="ISA 48:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>Mumfi Babilonia,</para>
  <para style="q2" vid="ISA 48:20">munguan mfi Babiloniafo nkyɛn!</para>
  <para style="q1" vid="ISA 48:20">Momfa osebɔ nteɛmu mmɔ nkae</para>
  <para style="q2" vid="ISA 48:20">na mompae mu nka eyi.</para>
  <para style="q1" vid="ISA 48:20">Momfa nkɔ nsase ano;</para>
  <para style="q2" vid="ISA 48:20">monka se, “<char style="nd">Awurade</char> abegye ne somfo Yakob.”<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>Osukɔm anne wɔn bere a odii wɔn anim, wɔ nweatam ahorow so no,</para>
  <para style="q2" vid="ISA 48:21">ɔmaa nsu fii ɔbotan mu ba maa wɔn;</para>
  <para style="q2" vid="ISA 48:21">ɔpaee ɔbotan no mu, maa nsu tue fii mu.<verse eid="ISA 48:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22"/>“Asomdwoe nni hɔ mma amumɔyɛfo.” Sɛɛ na <char style="nd">Awurade</char> se.<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s1">Awurade Somfo No</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1"/>Muntie me, mo mpoano aman;</para>
  <para style="q2" vid="ISA 49:1">monyɛ aso mo akyirikyiri aman</para>
  <para style="q1" vid="ISA 49:1">ansa na wɔrebɛwo me no, <char style="nd">Awurade</char> frɛɛ me</para>
  <para style="q2" vid="ISA 49:1">ɔbɔɔ me din ansa na wɔrewo me.<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>Ɔyɛɛ mʼano sɛ afoa nnamnam,</para>
  <para style="q1" vid="ISA 49:2">Ɔde me hintaw ne nsa ase nwini mu;</para>
  <para style="q2" vid="ISA 49:2">ɔde me yɛɛ agyan a ano yɛ nnam</para>
  <para style="q2" vid="ISA 49:2">na ɔde me hyɛɛ ne boha mu.<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>Ɔka kyerɛɛ me se, “Woyɛ me somfo,</para>
  <para style="q2" vid="ISA 49:3">Israel, wo mu na mɛda mʼanuonyam adi.”<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>Nanso mekae se, “Mabrɛ agu</para>
  <para style="q2" vid="ISA 49:4">masɛe mʼahoɔden kwa, mannya mu hwee</para>
  <para style="q1" vid="ISA 49:4">nanso nea ɛwɔ me wɔ <char style="nd">Awurade</char> nsam</para>
  <para style="q2" vid="ISA 49:4">na mʼakatua wɔ me Nyankopɔn nkyɛn.”<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5"/>Na afei, <char style="nd">Awurade</char> kasa se,</para>
  <para style="q2" vid="ISA 49:5">nea ɔnwen me wɔ awotwaa mu sɛ memmɛyɛ ne somfo</para>
  <para style="q1" vid="ISA 49:5">sɛ memfa Yakob nsan mmra ne nkyɛn</para>
  <para style="q2" vid="ISA 49:5">na me mmoaboa Israel ano mma no no,</para>
  <para style="q1" vid="ISA 49:5">wahyɛ me anuonyam wɔ <char style="nd">Awurade</char> ani so</para>
  <para style="q2" vid="ISA 49:5">na me Nyankopɔn ayɛ mʼahoɔden.<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>Ɔka se,</para>
  <para style="q1" vid="ISA 49:6">“Ɛyɛ ade ketewa bi ma wo sɛ wobɛyɛ me somfo</para>
  <para style="q2" vid="ISA 49:6">sɛ wode Yakob mmusuakuw bɛsan aba</para>
  <para style="q2" vid="ISA 49:6">na wode Israelfo a mede wɔn asie bɛsan aba.</para>
  <para style="q1" vid="ISA 49:6">Mɛma moayɛ amanamanmufo nyinaa kanea,</para>
  <para style="q2" vid="ISA 49:6">ɛnam mo so na wobegye wiasefo nyinaa nkwa.”<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 49:7">Ogyefo ne Israel ɔkronkronni no</para>
  <para style="q1" vid="ISA 49:7">de kɔma nea aman buu no animtiaa na wokyii no,</para>
  <para style="q2" vid="ISA 49:7">ahemfo somfo no;</para>
  <para style="q1" vid="ISA 49:7">“Ahene behu wo na wɔasɔre</para>
  <para style="q2" vid="ISA 49:7">ahenemma behu wo na wɔakotow wo</para>
  <para style="q1" vid="ISA 49:7">esiane <char style="nd">Awurade</char> a ɔyɛ ɔnokwafo,</para>
  <para style="q2" vid="ISA 49:7">Israel ɔkronkronni a wayi wo no nti.”<verse eid="ISA 49:7"/></para>
  <para style="s1">Israel Si Ne Dedaw Mu</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>Sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 49:8">“Bere a ɛsɛ mu no, mebua wo,</para>
  <para style="q2" vid="ISA 49:8">na nkwagyeda no, mɛboa wo;</para>
  <para style="q1" vid="ISA 49:8">mɛkora wo na mede wo ayɛ</para>
  <para style="q2" vid="ISA 49:8">apam ama nkurɔfo no,</para>
  <para style="q1" vid="ISA 49:8">de agye asase no asi hɔ</para>
  <para style="q2" vid="ISA 49:8">akyekyɛ agyapade ahorow a asɛe no bio,<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>wobɛka akyerɛ nneduafo se, ‘Mumfi mmra!’</para>
  <para style="q2" vid="ISA 49:9">ne wɔn a wɔwɔ sum mu se, ‘Momfa mo ho nni!’</para>
  <para style="b" vid="ISA 49:9"/>
  <para style="q1" vid="ISA 49:9">“Wobedidi wɔ akwan ho</para>
  <para style="q2" vid="ISA 49:9">wobenya adidibea wɔ koko kesee biara so.<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>Ɔkɔm renne wɔn na osukɔm nso renne wɔn;</para>
  <para style="q2" vid="ISA 49:10">nweatam so hyew ne owia ano hyew renka wɔn,</para>
  <para style="q1" vid="ISA 49:10">nea ɔwɔ ayamhyehye ma wɔn no bɛkyerɛ wɔn kwan</para>
  <para style="q2" vid="ISA 49:10">na ɔde wɔn akɔ nsuaniwa ho.<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>Mɛyɛ me mmepɔw nyinaa akwan,</para>
  <para style="q2" vid="ISA 49:11">na mʼatempɔn nso mɛma akrɔn.<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>Hwɛ, wufi akyirikyiri bɛba</para>
  <para style="q2" vid="ISA 49:12">ebinom befi atifi fam, ebinom befi atɔe fam</para>
  <para style="q2" vid="ISA 49:12">ebinom nso befi Sinin mantam mu.”<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>Momfa anigye nteɛ mu, ɔsoro;</para>
  <para style="q2" vid="ISA 49:13">di ahurusi, asase;</para>
  <para style="q2" vid="ISA 49:13">mompae mu nnwonto mu, mmepɔw!</para>
  <para style="q1" vid="ISA 49:13">Na <char style="nd">Awurade</char> kyekye ne nkurɔfo werɛ,</para>
  <para style="q2" vid="ISA 49:13">na obehu nʼamanehunufo mmɔbɔ.<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>Nanso Sion kae se, “<char style="nd">Awurade</char> agyaw me hɔ,</para>
  <para style="q2" vid="ISA 49:14">Awurade werɛ afi me.”<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>“Ɛna werɛ betumi afi ne ba a otua nufu ano</para>
  <para style="q2" vid="ISA 49:15">a ɔrennya ayamhyehye mma ɔba a waturu no no ana?</para>
  <para style="q1" vid="ISA 49:15">Ebia ne werɛ befi,</para>
  <para style="q2" vid="ISA 49:15">na me werɛ remfi wo!<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>Hwɛ, makurukyerɛw wo din agu me nsa yam</para>
  <para style="q2" vid="ISA 49:16">wʼafasu wɔ mʼani so daa.<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>Mo mmabarima resan aba ntɛm so;</para>
  <para style="q2" vid="ISA 49:17">na wɔn a wɔsɛe mo no refi mo nkyɛn akɔ.<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>Momma mo ani so nhwɛ mo ho nhyia;</para>
  <para style="q2" vid="ISA 49:18">mo mmabarima nyinaa reboa wɔn ho ano aba mo nkyɛn.</para>
  <para style="q1" vid="ISA 49:18">Sɛ mete ase yi” sɛnea <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 49:18">“mode wɔn bɛyɛ ahyehyɛde ama mo ho</para>
  <para style="q2" vid="ISA 49:18">mubefura wɔn sɛ ayeforokunu.<verse eid="ISA 49:18"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>“Ɛwɔ mu sɛ wɔsɛee mo yɛɛ mo pasaa</para>
  <para style="q2" vid="ISA 49:19">maa mo asase daa mpan,</para>
  <para style="q1" vid="ISA 49:19">afei nnipa bɛhyɛ wo so ma, ama aboro wo so,</para>
  <para style="q2" vid="ISA 49:19">na wɔn a wɔsɛee wo no bɛkɔ akyirikyiri.<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>Mmofra a wɔwoo wɔn wɔ mo nna bɔne mu no</para>
  <para style="q2" vid="ISA 49:20">bɛka ama moate sɛ,</para>
  <para style="q1" vid="ISA 49:20">‘Ɛha sua ma yɛn dodo;</para>
  <para style="q2" vid="ISA 49:20">momma yɛn asase no bi nka ho na yɛntena so.’<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>Na wobɛka wɔ wo koma mu se,</para>
  <para style="q2" vid="ISA 49:21">‘Hena na ɔwoo eyinom maa me?</para>
  <para style="q1" vid="ISA 49:21">Na meyɛ ɔwerɛhowni ne obonin;</para>
  <para style="q2" vid="ISA 49:21">wotuu me kɔɔ asase foforo so na wɔpoo me.</para>
  <para style="q2" vid="ISA 49:21">Hena na ɔtetew eyinom?</para>
  <para style="q1" vid="ISA 49:21">Wogyaw me nko ara</para>
  <para style="q2" vid="ISA 49:21">na eyinom, he na wofi bae?’ ”<verse eid="ISA 49:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22"/>Sɛɛ na Asafo <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 49:22">“Hwɛ, menyama amanamanmufo,</para>
  <para style="q2" vid="ISA 49:22">mɛma me frankaa no so akyerɛ nkurɔfo no</para>
  <para style="q1" vid="ISA 49:22">wobeturu wo mmabarima wɔ wɔn nsa so aba</para>
  <para style="q2" vid="ISA 49:22">na wɔbɛsoa wo mmabea wɔ wɔn mmati so.<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>Ahemfo bɛyɛ mo agyanom nsiananmu,</para>
  <para style="q2" vid="ISA 49:23">na wɔn ahemmea ayɛ ɛnanom a wɔbɛhwɛ mo.</para>
  <para style="q1" vid="ISA 49:23">Wɔbɛkotow mo a wɔn anim butubutuw fam;</para>
  <para style="q2" vid="ISA 49:23">wɔbɛtaforo mo nan ase mfutuma.</para>
  <para style="q1" vid="ISA 49:23">Afei mubehu sɛ mene <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="ISA 49:23">Wɔn a wɔn ani da me so no, merenni wɔn huammɔ.”<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>Wobetumi agye asade afi akofo nsam;</para>
  <para style="q2" vid="ISA 49:24">anaa wobetumi agye nnommumfo afi otirimɔdenfo nsam?<verse eid="ISA 49:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25"/>Nanso, sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 49:25">“Yiw, wobegye nnommumfo afi akofo nsam</para>
  <para style="q2" vid="ISA 49:25">na wɔagye asade afi otirimɔdenfo nsam;</para>
  <para style="q1" vid="ISA 49:25">me ne wɔn a wɔne wo nya no benya</para>
  <para style="q2" vid="ISA 49:25">na megye wo mma nkwa.<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>Mema wɔn a wɔhyɛ wo so no awe wɔn ankasa honam;</para>
  <para style="q2" vid="ISA 49:26">wɔn mogya bɛbow wɔn sɛnea wɔanom nsa.</para>
  <para style="q1" vid="ISA 49:26">Afei adesamma nyinaa behu</para>
  <para style="q2" vid="ISA 49:26">sɛ me, <char style="nd">Awurade</char>, me ne wʼAgyenkwa no,</para>
  <para style="q2" vid="ISA 49:26">wo Gyefo, Yakob Tumfo No.”<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s1">Israel Amumɔyɛ Ne Ɔsomfo No Setie</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>Sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 50:1">“Ɛhe na awaregyae ho adansedi nhoma,</para>
  <para style="q2" vid="ISA 50:1">nea migyinaa so gyaa no kwan no wɔ?</para>
  <para style="q1" vid="ISA 50:1">Anaa sɛ mʼadefirifo mu hena</para>
  <para style="q2" vid="ISA 50:1">na metɔn wo maa no?</para>
  <para style="q1" vid="ISA 50:1">Wo bɔne nti na wɔtɔn wo;</para>
  <para style="q2" vid="ISA 50:1">Wʼamumɔyɛ nti na wɔpam wo na.<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>Mebae no, adɛn nti na na obiara nni hɔ?</para>
  <para style="q2" vid="ISA 50:2">Mefrɛe no, adɛn nti na obiara annye so?</para>
  <para style="q1" vid="ISA 50:2">Na me nsa yɛ tia dodo sɛ ebegye wo ana?</para>
  <para style="q2" vid="ISA 50:2">Minni ahoɔden a mede begye wo ana?</para>
  <para style="q1" vid="ISA 50:2">Mede mʼanimka kɛkɛ no ma po yow,</para>
  <para style="q2" vid="ISA 50:2">medan nsubɔnten nweatam</para>
  <para style="q1" vid="ISA 50:2">mu mpataa porɔw esiane nsu a wonnya nti</para>
  <para style="q2" vid="ISA 50:2">na osukɔm kum wɔn.<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>Mede sum fura ɔsoro</para>
  <para style="q2" vid="ISA 50:3">na mema atweaatam yɛ ne nkataho.”<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>Asafo <char style="nd">Awurade</char> ama me nkyerɛkyerɛ tɛkrɛma</para>
  <para style="q2" vid="ISA 50:4">sɛ ɛnka asɛm a ɛhyɛ ɔbrɛfo den.</para>
  <para style="q1" vid="ISA 50:4">Onyan me anɔpa biara,</para>
  <para style="q2" vid="ISA 50:4">na obue mʼaso ma mitie sɛ obi a ɔregye nkyerɛkyerɛ.<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>Otumfo <char style="nd">Awurade</char> abue mʼaso</para>
  <para style="q2" vid="ISA 50:5">na menyɛɛ otuatewfo ɛ;</para>
  <para style="q2" vid="ISA 50:5">na mensan mʼakyi ɛ.<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>Mede mʼakyi maa wɔn a wɔboro me,</para>
  <para style="q2" vid="ISA 50:6">ne mʼafono maa wɔn a wotutu mʼabogyesɛ.</para>
  <para style="q1" vid="ISA 50:6">Mamfa mʼanim anhintaw wɔn</para>
  <para style="q2" vid="ISA 50:6">fɛwdi ne ntasu ho.<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>Esiane sɛ, Asafo <char style="nd">Awurade</char> boa me nti,</para>
  <para style="q2" vid="ISA 50:7">wɔrengu mʼanim ase.</para>
  <para style="q1" vid="ISA 50:7">Enti na mayɛ mʼanim sɛ ɔtwɛrebo,</para>
  <para style="q2" vid="ISA 50:7">na minim sɛ mʼanim rengu ase.<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>Nea obu me bem no abɛn.</para>
  <para style="q2" vid="ISA 50:8">Enti hena na ɔbɛbɔ me kwaadu?</para>
  <para style="q2" vid="ISA 50:8">Ɔmma yenhyia mu!</para>
  <para style="q1" vid="ISA 50:8">Hena na ɔbɔ me sobo?</para>
  <para style="q2" vid="ISA 50:8">Ma ɔnka nsi mʼanim!<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>Asafo <char style="nd">Awurade</char> na ɔboa me.</para>
  <para style="q2" vid="ISA 50:9">Hena ne nea obebu me fɔ?</para>
  <para style="q1" vid="ISA 50:9">Wɔn nyinaa bɛtetew sɛ atade;</para>
  <para style="q2" vid="ISA 50:9">nnwewemmoa bɛwe wɔn.<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>Mo mu hena na osuro <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 50:10">na odi ne somfo asɛm so?</para>
  <para style="q1" vid="ISA 50:10">Ma nea ɔnam sum mu</para>
  <para style="q2" vid="ISA 50:10">nea onni hann no,</para>
  <para style="q1" vid="ISA 50:10">onnye <char style="nd">Awurade</char> din nni</para>
  <para style="q2" vid="ISA 50:10">na ɔmfa ne ho nto ne Nyankopɔn so.<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>Na afei, mo a mososɔ ogya nyinaa</para>
  <para style="q2" vid="ISA 50:11">na moyɛ ogyatɛn ma mo ho,</para>
  <para style="q1" vid="ISA 50:11">monkɔ, nkɔnantew mo gya hann no,</para>
  <para style="q2" vid="ISA 50:11">ne ogyatɛn a wɔasɔ ano no mu.</para>
  <para style="q1" vid="ISA 50:11">Eyi ne nea mubenya afi me nsa mu;</para>
  <para style="q2" vid="ISA 50:11">mobɛdeda fam wɔ ɔyaw mu.<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">Sion Daapem Nkwagye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1"/>“Muntie me, mo a mopɛ trenee akyi kwan;</para>
  <para style="q2" vid="ISA 51:1">na mohwehwɛ <char style="nd">Awurade</char>;</para>
  <para style="q1" vid="ISA 51:1">Monhwɛ ɔbotan a wotwaa mo fii mu no</para>
  <para style="q2" vid="ISA 51:1">ne abopaebea a wotuu mo fii hɔ no;<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>Monhwɛ Abraham, mo agya,</para>
  <para style="q2" vid="ISA 51:2">ne Sara a ɔwoo mo no.</para>
  <para style="q1" vid="ISA 51:2">Bere a mefrɛɛ no no, na ɔyɛ ɔbaakofo,</para>
  <para style="q2" vid="ISA 51:2">na mihyiraa no maa nʼase trɛwee.<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>
    <char style="nd">Awurade</char> bɛkyekye Sion werɛ ampa ara</para>
  <para style="q2" vid="ISA 51:3">na ne yam bɛhyehye no wɔ ne nnwiriwii no ho;</para>
  <para style="q1" vid="ISA 51:3">ɔbɛyɛ ne nweatam ahorow sɛ Eden,</para>
  <para style="q2" vid="ISA 51:3">nʼasase a ada mpan bɛyɛ sɛ <char style="nd">Awurade</char> turo.</para>
  <para style="q1" vid="ISA 51:3">Wobehu anigye ne ahosɛpɛw,</para>
  <para style="q2" vid="ISA 51:3">aseda ne nnwonto wɔ ne mu.<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>“Muntie me, me nkurɔfo;</para>
  <para style="q2" vid="ISA 51:4">monyɛ aso mma me, me man:</para>
  <para style="q1" vid="ISA 51:4">Mmara no befi me nkyɛn akɔ;</para>
  <para style="q2" vid="ISA 51:4">na mʼatɛntrenee bɛyɛ hann ama aman no.<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>Me trenee reba ntɛm so,</para>
  <para style="q2" vid="ISA 51:5">me nkwagye nam kwan so,</para>
  <para style="q2" vid="ISA 51:5">na me basa de atɛntrenee bɛbrɛ aman no.</para>
  <para style="q1" vid="ISA 51:5">Asupɔw no bɛhwɛ me</para>
  <para style="q2" vid="ISA 51:5">na wɔde anidaso bɛtwɛn me basa.<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>Momma mo ani so nhwɛ ɔsorosoro,</para>
  <para style="q2" vid="ISA 51:6">monhwɛ asase wɔ fam;</para>
  <para style="q1" vid="ISA 51:6">ɔsorosoro betu ayera sɛ wusiw</para>
  <para style="q2" vid="ISA 51:6">na asase bɛtetew sɛ atade</para>
  <para style="q2" vid="ISA 51:6">na wɔn a wɔte so bewuwu sɛ nwansena.</para>
  <para style="q1" vid="ISA 51:6">Nanso me nkwagye bɛtena hɔ daa,</para>
  <para style="q2" vid="ISA 51:6">me trenee to rentwa da.<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>“Muntie me, mo a munim nea ɛteɛ,</para>
  <para style="q2" vid="ISA 51:7">mo a me mmara wɔ mo koma mu:</para>
  <para style="q1" vid="ISA 51:7">Munnsuro nnipa animka</para>
  <para style="q2" vid="ISA 51:7">anaa momma wɔn ahohora ntu mo koma.<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>Na nnwewemmoa bɛwe wɔn te sɛnea wɔwe atade;</para>
  <para style="q2" vid="ISA 51:8">asunson bɛsɛe wɔn te sɛnea wɔsɛe kuntu.</para>
  <para style="q1" vid="ISA 51:8">Nanso me trenee bɛtena hɔ daa,</para>
  <para style="q2" vid="ISA 51:8">me nkwagye befi awo ntoatoaso akosi awo ntoatoaso so.”<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>Nyan, nyan! <char style="nd">Awurade</char> basa,</para>
  <para style="q2" vid="ISA 51:9">hyɛ ahoɔden adurade;</para>
  <para style="q1" vid="ISA 51:9">nyan te sɛ nna a atwa mu no,</para>
  <para style="q2" vid="ISA 51:9">te sɛ tete awo ntoatoaso mu no.</para>
  <para style="q1" vid="ISA 51:9">Ɛnyɛ wo na wutwitwaa Rahab mu asinasin no,</para>
  <para style="q2" vid="ISA 51:9">na wuhwirew asuboa kɛse no mu no?<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>Ɛnyɛ wo na womaa po yowee,</para>
  <para style="q2" vid="ISA 51:10">asubun mu nsu no,</para>
  <para style="q1" vid="ISA 51:10">nea ɔpaee kwan wɔ po bun mu no</para>
  <para style="q2" vid="ISA 51:10">sɛnea wɔn a wɔagye wɔn no betumi atwa?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>Wɔn a <char style="nd">Awurade</char> apata ama wɔn bɛsan aba.</para>
  <para style="q2" vid="ISA 51:11">Wɔde nnwonto bɛhyɛn Sion;</para>
  <para style="q2" vid="ISA 51:11">anigye a ɛnsa da bɛyɛ wɔn abotiri,</para>
  <para style="q1" vid="ISA 51:11">anigye ne ahosɛpɛw bɛboro wɔn so,</para>
  <para style="q2" vid="ISA 51:11">awerɛhow ne apinisi betu ayera.<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>“Me, me ara, mene wo werɛkyekyefo.</para>
  <para style="q2" vid="ISA 51:12">Hena ne wo a wusuro ɔdesani,</para>
  <para style="q2" vid="ISA 51:12">nnipa mma a wɔyɛ sare yi.<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>Na wo werɛ afi <char style="nd">Awurade</char>, wo yɛfo</para>
  <para style="q2" vid="ISA 51:13">nea ɔtrɛw ɔsorosoro mu</para>
  <para style="q2" vid="ISA 51:13">na ɔhyɛɛ asase ase no,</para>
  <para style="q1" vid="ISA 51:13">a da biara na woabɔ hu</para>
  <para style="q2" vid="ISA 51:13">ɔhyɛsoni no abufuw nti,</para>
  <para style="q2" vid="ISA 51:13">nea ɔde ɔsɛe asi nʼani so no ana?</para>
  <para style="q1" vid="ISA 51:13">Na ɔhyɛsoni no abufuw wɔ he?<verse eid="ISA 51:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14"/>Ɛrenkyɛ, wobegyaa nneduafo ahufo no;</para>
  <para style="q1" vid="ISA 51:14">wɔrenwuwu wɔ afiase amoa mu,</para>
  <para style="q2" vid="ISA 51:14">na aduan remmɔ wɔn.<verse eid="ISA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>Na mene <char style="nd">Awurade</char>, wo Nyankopɔn</para>
  <para style="q2" vid="ISA 51:15">nea ɔhwanyan po, ma nʼasorɔkye woro so.</para>
  <para style="q2" vid="ISA 51:15">Asafo <char style="nd">Awurade</char> ne ne din.<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>Mede me nsɛm ahyɛ wʼanom,</para>
  <para style="q2" vid="ISA 51:16">na mede me nsa ase nwini akata wo so.</para>
  <para style="q1" vid="ISA 51:16">Me a mede ɔsorosoro sii hɔ</para>
  <para style="q2" vid="ISA 51:16">na mehyɛɛ asase ase,</para>
  <para style="q1" vid="ISA 51:16">na meka kyerɛ Sion se, ‘Moyɛ me nkurɔfo.’ ”<verse eid="ISA 51:16"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Abufuwhyew Kuruwa No</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>Nyan, nyan!</para>
  <para style="q2" vid="ISA 51:17">Sɔre, Yerusalem!</para>
  <para style="q1" vid="ISA 51:17">Wo a woanom afi <char style="nd">Awurade</char> nsam</para>
  <para style="q2" vid="ISA 51:17">nʼabufuw kuruwa no,</para>
  <para style="q1" vid="ISA 51:17">wo a woanom apɔɔdɔ mu nsa atu puw</para>
  <para style="q2" vid="ISA 51:17">nea ɛma nnipa tɔ ntintan no.<verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>Ne mma a ɔwoo wɔn nyinaa no</para>
  <para style="q2" vid="ISA 51:18">obiara nni hɔ a ɔkyerɛ no kwan;</para>
  <para style="q1" vid="ISA 51:18">mma a ɔtetew wɔn nyinaa no</para>
  <para style="q2" vid="ISA 51:18">obiara nni hɔ a oso ne nsa mu.<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>Saa ɔhaw prenu yi aba wo so,</para>
  <para style="q2" vid="ISA 51:19">hena na ɔbɛkyekye wo werɛ?</para>
  <para style="q1" vid="ISA 51:19">Nnwiriwii ne ɔsɛe, ɔkɔm ne afoa,</para>
  <para style="q2" vid="ISA 51:19">hena na ɔbɛhyɛ wo den?<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>Wo mma atotɔ beraw;</para>
  <para style="q2" vid="ISA 51:20">wɔdeda mmɔnten so baabiara,</para>
  <para style="q2" vid="ISA 51:20">te sɛ ɔtwe a afiri ayi no.</para>
  <para style="q1" vid="ISA 51:20">
    <char style="nd">Awurade</char> abufuw aba wɔn so,</para>
  <para style="q2" vid="ISA 51:20">wo Nyankopɔn animka no.<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>Enti tie eyi, wo a worehu amane</para>
  <para style="q2" vid="ISA 51:21">woabow, nanso ɛnyɛ nsa na abow wo.<verse eid="ISA 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>Sɛɛ na Otumfo <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 51:22">wo Nyankopɔn a ɔbɔ ne nkurɔfo ho ban:</para>
  <para style="q1" vid="ISA 51:22">Hwɛ, magye afi wo nsa mu,</para>
  <para style="q2" vid="ISA 51:22">kuruwa a ɛma wotɔɔ ntintan no,</para>
  <para style="q1" vid="ISA 51:22">kuruwa a ɛyɛ mʼabufuw pɔɔdɔ no,</para>
  <para style="q2" vid="ISA 51:22">worennom bio.<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>Mede bɛhyɛ wɔn a wɔhaw mo no nsa mu,</para>
  <para style="q2" vid="ISA 51:23">wɔn a wɔka kyerɛɛ mo se,</para>
  <para style="q2" vid="ISA 51:23">“Butuw fam na yɛnnantew wo so</para>
  <para style="q1" vid="ISA 51:23">na wode wʼakyi yɛɛ fam,</para>
  <para style="q2" vid="ISA 51:23">te sɛ abɔnten sɛ wɔnnantew so no.”<verse eid="ISA 51:23"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>Nyan, nyan, Sion,</para>
  <para style="q2" vid="ISA 52:1">hyɛ ahoɔden adurade no.</para>
  <para style="q1" vid="ISA 52:1">Hyɛ wo ntade fɛɛfɛ no</para>
  <para style="q2" vid="ISA 52:1">Yerusalem kuropɔn kronkron no.</para>
  <para style="q1" vid="ISA 52:1">Momonotofo ne wɔn a wɔn ho agu fi</para>
  <para style="q2" vid="ISA 52:1">renwura wʼapon mu bio.<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>Poroporow wo ho mfutuma.</para>
  <para style="q2" vid="ISA 52:2">Sɔre, tena ahengua so, Yerusalem.</para>
  <para style="q1" vid="ISA 52:2">Yiyi nkɔnsɔnkɔnsɔn no fi wo kɔn mu,</para>
  <para style="q2" vid="ISA 52:2">Ɔbabea Sion a wɔafa wo nnommum.<verse eid="ISA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3"/>Na sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 52:3">“Wɔantɔn wo annye hwee,</para>
  <para style="q2" vid="ISA 52:3">na ɛnyɛ sika na wɔde begye wo.”<verse eid="ISA 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4"/>Na sɛɛ na Otumfo Awurade se:</para>
  <para style="q1" vid="ISA 52:4">“Bere bi me nkurɔfo kɔɔ Misraim kɔtenaa hɔ;</para>
  <para style="q2" vid="ISA 52:4">akyiri no Asiria bɛhyɛɛ wɔn so.<verse eid="ISA 52:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5"/>“Na mprempren dɛn na mewɔ wɔ ha?” Sɛɛ na <char style="nd">Awurade</char> se.</para>
  <para style="q2" vid="ISA 52:5">“Wɔafa me nkurɔfo kɔ kwa,</para>
  <para style="q1" vid="ISA 52:5">na wɔn sodifo di fɛw,”</para>
  <para style="q2" vid="ISA 52:5">
    <char style="nd">Awurade</char> na ose.</para>
  <para style="q1" vid="ISA 52:5">“Da mu no nyinaa</para>
  <para style="q2" vid="ISA 52:5">wɔkɔ so gu me din ho fi.<verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>Enti me nkurɔfo behu me din;</para>
  <para style="q2" vid="ISA 52:6">enti da no wobehu sɛ</para>
  <para style="q1" vid="ISA 52:6">ɛyɛ me na mehyɛɛ ho nkɔm.</para>
  <para style="q2" vid="ISA 52:6">Yiw, ɛyɛ me.”<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>Hwɛ sɛnea wɔn a wɔde asɛmpa no reba</para>
  <para style="q2" vid="ISA 52:7">anammɔn si yɛ fɛ wɔ mmepɔw no so,</para>
  <para style="q1" vid="ISA 52:7">wɔn a wɔpae mu ka asomdwoesɛm,</para>
  <para style="q2" vid="ISA 52:7">wɔn a wɔbɔ amanneɛdɛ,</para>
  <para style="q1" vid="ISA 52:7">wɔn a wɔpae mu ka nkwagye ho asɛm</para>
  <para style="q2" vid="ISA 52:7">na wɔka kyerɛ Sion se,</para>
  <para style="q2" vid="ISA 52:7">“Mo Nyankopɔn di hene.”<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>Muntie! Mo awɛmfo ma wɔn nne so;</para>
  <para style="q2" vid="ISA 52:8">wɔbɔ mu de anigye teɛ mu.</para>
  <para style="q1" vid="ISA 52:8">Sɛ <char style="nd">Awurade</char> san ba Sion a,</para>
  <para style="q2" vid="ISA 52:8">wɔde wɔn ani behu.<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>Mommɔ mu ntue anigye nnwonto,</para>
  <para style="q2" vid="ISA 52:9">mo Yerusalem nnwiriwii,</para>
  <para style="q1" vid="ISA 52:9">efisɛ, <char style="nd">Awurade</char> akyekye ne nkurɔfo werɛ</para>
  <para style="q2" vid="ISA 52:9">wagye Yerusalem.<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>
    <char style="nd">Awurade</char> beyi ne basa kronkron no ho</para>
  <para style="q2" vid="ISA 52:10">wɔ amanaman nyinaa anim</para>
  <para style="q1" vid="ISA 52:10">na asase ano nyinaa behu yɛn Nyankopɔn nkwagye.<verse eid="ISA 52:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>Monkɔ. Mumfi hɔ nkɔ!</para>
  <para style="q2" vid="ISA 52:11">Mommfa mo ho nnka biribiara a ho ntew.</para>
  <para style="q1" vid="ISA 52:11">Mumfi ho na mo ho ntew,</para>
  <para style="q2" vid="ISA 52:11">mo a mukurakura <char style="nd">Awurade</char> nkuruwa.<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>Morentutu mmirika mfi ha</para>
  <para style="q2" vid="ISA 52:12">anaa morenguan;</para>
  <para style="q1" vid="ISA 52:12">efisɛ <char style="nd">Awurade</char> bedi mo anim,</para>
  <para style="q2" vid="ISA 52:12">Israel Nyankopɔn bɛbɔ mo kyidɔm.<verse eid="ISA 52:12"/></para>
  <para style="s1">Ɔsomfo No Amanehunu Ne Nʼanuonyam</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>Hwɛ, me somfo bedi yiye</para>
  <para style="q2" vid="ISA 52:13">wɔbɛma no so ayɛ no ɔkɛse.<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>Nea ɛmaa dodow a wohuu no ho dwiriw wɔn no,</para>
  <para style="q2" vid="ISA 52:14">wɔsɛee nʼanim a ansɛ onipa biara de</para>
  <para style="q2" vid="ISA 52:14">na nʼabɔsu sɛe a ɛnsɛ ɔdesani de,<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>saa ara na ɔbɛma aman bebree ho adwiriw wɔn</para>
  <para style="q2" vid="ISA 52:15">na ahemfo bemuamua wɔn ano, ne nti.</para>
  <para style="q1" vid="ISA 52:15">Wɔn a wɔnkaa ne ho asɛm nkyerɛɛ wɔn no behu,</para>
  <para style="q2" vid="ISA 52:15">na wɔn a wɔntee no nso bɛte ase.<verse eid="ISA 52:15"/></para>
  <para style="b"/>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>Hena na wagye yɛn asɛm no adi?</para>
  <para style="q2" vid="ISA 53:1">na <char style="nd">Awurade</char> abasa no, hena so na ada adi?<verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>Onyin wɔ nʼanim te sɛ dua amono ketewa bi,</para>
  <para style="q2" vid="ISA 53:2">te sɛ ntin a efi asase wosee mu.</para>
  <para style="q1" vid="ISA 53:2">Onni ahoɔfɛ anaa anuonyam a ɛbɛtwetwe yɛn akɔ ne nkyɛn.</para>
  <para style="q2" vid="ISA 53:2">Ne tebea mu nni biribiara a ɛbɛma yɛapɛ no.<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>Nnipa bɔɔ no ahohora na wɔpoo no,</para>
  <para style="q2" vid="ISA 53:3">Ɔwerɛhowni a onim ɔyaw.</para>
  <para style="q1" vid="ISA 53:3">Te sɛ obi a nnipa de wɔn anim hintaw no</para>
  <para style="q2" vid="ISA 53:3">wobuu no animtiaa na yɛammu no.<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4"/>Ampa ara ɔfaa yɛn mmerɛwyɛ,</para>
  <para style="q2" vid="ISA 53:4">na ɔsoaa yɛn awerɛhow,</para>
  <para style="q1" vid="ISA 53:4">nanso yebuu no sɛ Onyankopɔn na watwe nʼaso.</para>
  <para style="q2" vid="ISA 53:4">Yebuu no sɛ, Onyankopɔn na wabɔ no na wadwerɛw no.<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>Nanso yɛn mmarato nti na wopiraa no,</para>
  <para style="q2" vid="ISA 53:5">yɛn amumɔyɛ nti na wɔdwerɛw no;</para>
  <para style="q1" vid="ISA 53:5">asotwe a ɛde asomdwoe brɛɛ yɛn no daa no so,</para>
  <para style="q2" vid="ISA 53:5">na nʼapirakuru mu na yenya ayaresa.<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>Yɛn nyinaa ayerayera te sɛ nguan,</para>
  <para style="q2" vid="ISA 53:6">yɛn mu biara afa ne kwan;</para>
  <para style="q1" vid="ISA 53:6">na <char style="nd">Awurade</char> de yɛn nyinaa</para>
  <para style="q2" vid="ISA 53:6">amumɔyɛ ato no so.<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7"/>Wɔhyɛɛ no so, yɛɛ no ayayade,</para>
  <para style="q2" vid="ISA 53:7">nanso wammue nʼano;</para>
  <para style="q1" vid="ISA 53:7">wɔde no kɔɔ te sɛ oguamma a wɔrekokum no.</para>
  <para style="q2" vid="ISA 53:7">Sɛnea oguamma yɛ komm wɔ ne nwitwitwafo anim no,</para>
  <para style="q2" vid="ISA 53:7">saa ara na wammue nʼano.<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>Wɔnam nhyɛso ne atemmu so faa no kɔe.</para>
  <para style="q2" vid="ISA 53:8">Na hena na obetumi aka nʼasefo ho asɛm?</para>
  <para style="q1" vid="ISA 53:8">Efisɛ woyii no fii asase yi so;</para>
  <para style="q2" vid="ISA 53:8">me nkurɔfo mmarato nti wɔtwee nʼaso.<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>Wɔyɛɛ ne da wɔ abɔnefo mu,</para>
  <para style="q2" vid="ISA 53:9">na ne wu mu wɔde no too adefo mu</para>
  <para style="q1" vid="ISA 53:9">ɛwɔ mu, wanyɛ akakabensɛm biara,</para>
  <para style="q2" vid="ISA 53:9">na obiara ante atosɛm biara amfi nʼano.<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>Nanso ɛyɛɛ <char style="nd">Awurade</char> pɛ sɛ ɔbɛdwerɛw no ama no ahu amane</para>
  <para style="q2" vid="ISA 53:10">mpo ɔde ne nkwa yɛ afɔdi afɔrebɔde,</para>
  <para style="q1" vid="ISA 53:10">obehu nʼasefo na ne nna bɛware,</para>
  <para style="q2" vid="ISA 53:10">na <char style="nd">Awurade</char> pɛ bɛkɔ so wɔ ne nsam.<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>Ne kra amanehunu akyi,</para>
  <para style="q2" vid="ISA 53:11">obehu nkwa hann, na ne koma atɔ ne yam;</para>
  <para style="q1" vid="ISA 53:11">na ne suahu mu me somfo treneeni no bebu bebree bem,</para>
  <para style="q2" vid="ISA 53:11">na wasoa wɔn amumɔyɛ.<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>Enti mɛma no kyɛfa wɔ atitiriw mu,</para>
  <para style="q2" vid="ISA 53:12">na ɔne ahoɔdenfo bɛkyɛ asade</para>
  <para style="q1" vid="ISA 53:12">efisɛ ɔde ne nkwa too hɔ maa owu,</para>
  <para style="q2" vid="ISA 53:12">na wɔkan no fraa mmaratofo.</para>
  <para style="q1" vid="ISA 53:12">Ɔsoaa nnipa bebree bɔne,</para>
  <para style="q2" vid="ISA 53:12">na odi maa mmaratofo.<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s1">Sion Daakye Anuonyam</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1"/>“To nnwom, obonin,</para>
  <para style="q2" vid="ISA 54:1">wo a wonwoo da;</para>
  <para style="q1" vid="ISA 54:1">pae mu to nnwom, teɛ mu di ahurusi,</para>
  <para style="q2" vid="ISA 54:1">wo a awo nkaa wo da;</para>
  <para style="q1" vid="ISA 54:1">efisɛ ɔbea a wannya awo da no mma</para>
  <para style="q2" vid="ISA 54:1">dɔɔso sen nea ɔwɔ kunu,”</para>
  <para style="q2" vid="ISA 54:1">
    <char style="nd">Awurade</char> na ose.<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>“Trɛw wo ntamadan no mu;</para>
  <para style="q2" vid="ISA 54:2">twe wo ntamadan ntwamu no mu,</para>
  <para style="q2" vid="ISA 54:2">nnyae yɛ;</para>
  <para style="q1" vid="ISA 54:2">toa wo ntampehama no so,</para>
  <para style="q2" vid="ISA 54:2">bobɔ wo nnyinaso no so ma entim yiye.<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>Efisɛ wobɛtrɛw akɔ nifa ne benkum;</para>
  <para style="q2" vid="ISA 54:3">wʼasefo begye aman afa</para>
  <para style="q2" vid="ISA 54:3">na wɔatena wɔn nkuropɔn amamfo so.<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“Nsuro; wʼanim rengu ase.</para>
  <para style="q2" vid="ISA 54:4">Nsuro aniwu; wɔremmrɛ wo ase.</para>
  <para style="q1" vid="ISA 54:4">Wo werɛ befi wo mmabun mu aniwu</para>
  <para style="q2" vid="ISA 54:4">na wo kunayɛ mu ahohora nso worenkae bio.<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>Na wo Bɔfo yɛ wo kunu</para>
  <para style="q2" vid="ISA 54:5">Asafo <char style="nd">Awurade</char> ne ne din,</para>
  <para style="q1" vid="ISA 54:5">Israel Kronkronni no yɛ wo Gyefo.</para>
  <para style="q2" vid="ISA 54:5">Wɔfrɛ no asase nyinaa so Nyankopɔn.<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>
    <char style="nd">Awurade</char> bɛsan afrɛ wo</para>
  <para style="q2" vid="ISA 54:6">te sɛ ɔyere a woagyaa no na odi yaw wɔ ne koma mu,</para>
  <para style="q1" vid="ISA 54:6">ɔyere a ɔwaree mmabaabere mu</para>
  <para style="q2" vid="ISA 54:6">na wogyaa no mpofirim,” wo Nyankopɔn na ose.<verse eid="ISA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7"/>“Migyaw wo bere tiaa bi mu,</para>
  <para style="q2" vid="ISA 54:7">nanso mifi ayamhyehye a mu dɔ mu bɛsan de wo aba.<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>Abufuw mmoroso mu,</para>
  <para style="q2" vid="ISA 54:8">mede mʼani hintaw wo mmere tiaa bi,</para>
  <para style="q1" vid="ISA 54:8">nanso mʼayamye a ɛnsa da nti,</para>
  <para style="q2" vid="ISA 54:8">mehu wo mmɔbɔ,”</para>
  <para style="q2" vid="ISA 54:8">nea <char style="nd">Awurade</char>, wo Gyefo se ni.<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“Eyi te sɛ Noa mmere so a mekaa ntam se</para>
  <para style="q2" vid="ISA 54:9">meremma nsuyiri nkata asase ani bio.</para>
  <para style="q1" vid="ISA 54:9">Enti afei maka ntam se meremma me bo mfuw wo bio,</para>
  <para style="q2" vid="ISA 54:9">na merenka wʼanim bio.<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>Sɛ mmepɔw wosow,</para>
  <para style="q2" vid="ISA 54:10">na nkoko tutu a,</para>
  <para style="q1" vid="ISA 54:10">me dɔ a ɛnsa da a mewɔ ma wo no renhinhim</para>
  <para style="q2" vid="ISA 54:10">na mʼasomdwoe apam no rentwa mu,”</para>
  <para style="q2" vid="ISA 54:10">sɛɛ na <char style="nd">Awurade</char> a ɔwɔ ahummɔbɔ ma mo no se.<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>“Kuropɔn a ahum abubu wo na wɔnkyekyee wo werɛ ɛ,</para>
  <para style="q2" vid="ISA 54:11">mede abo anintɔnka besiesie wo,</para>
  <para style="q2" vid="ISA 54:11">na mede aboɔdemmo bibiri ayɛ wo fapem.<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>Mede bogyabo bɛto wʼabantifi afasu,</para>
  <para style="q2" vid="ISA 54:12">na mede abohemaa a ɛhyerɛn ayɛ wʼapon,</para>
  <para style="q2" vid="ISA 54:12">na mede aboɔdemmo ayɛ wʼafasu nyinaa.<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>
    <char style="nd">Awurade</char> bɛkyerɛkyerɛ wo mmabarima nyinaa,</para>
  <para style="q2" vid="ISA 54:13">na wo mma asomdwoe bɛdɔɔso.<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>Wubetim wɔ trenee mu:</para>
  <para style="q1" vid="ISA 54:14">Wo ne nhyɛsotraso ntam kwan bɛware</para>
  <para style="q2" vid="ISA 54:14">worensuro biribiara.</para>
  <para style="q1" vid="ISA 54:14">Ahupoo bɛkɔ akyirikyiri,</para>
  <para style="q2" vid="ISA 54:14">na ɛremmɛn wo.<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>Sɛ obi tow hyɛ wo so a, na emfi me;</para>
  <para style="q2" vid="ISA 54:15">na nea ɔtow hyɛ wo so no de ne ho bɛma wo.<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“Hwɛ, ɛyɛ me na mebɔɔ ɔtomfo</para>
  <para style="q2" vid="ISA 54:16">a ofita nnyansramma mu ma ɛdɛw</para>
  <para style="q2" vid="ISA 54:16">na ɔde ahoɔden bɔ akode a ɛfata ne dwumadi.</para>
  <para style="q1" vid="ISA 54:16">Na ɛyɛ me na mabɔ ɔsɛefo sɛ ɔmmɛsɛe ade;<verse eid="ISA 54:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17"/>akode biara a wɔabɔ atia wo no rennyina</para>
  <para style="q2" vid="ISA 54:17">na tɛkrɛma biara a ɛbɛbɔ wo sobo no wobɛbɔ agu.</para>
  <para style="q1" vid="ISA 54:17">Eyi ne <char style="nd">Awurade</char> nkoa agyapade,</para>
  <para style="q2" vid="ISA 54:17">ne wɔn bembu a efi me,”</para>
  <para style="q2" vid="ISA 54:17">
    <char style="nd">Awurade</char> na ose.<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">Osukɔm Ho Ɔfrɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1"/>“Mommra, mo a osukɔm de mo nyinaa,</para>
  <para style="q2" vid="ISA 55:1">mommra nsu no ho;</para>
  <para style="q1" vid="ISA 55:1">na mo a munni sika,</para>
  <para style="q2" vid="ISA 55:1">mommra mmɛtɔ na munni!</para>
  <para style="q1" vid="ISA 55:1">Mommra mmɛtɔ nsa ne nufusu</para>
  <para style="q2" vid="ISA 55:1">a munntua hwee.<verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>Adɛn nti na mosɛe sika wɔ nea ɛnyɛ aduan ho</para>
  <para style="q2" vid="ISA 55:2">ne mo ahoɔden wɔ nea ɛmmee ho?</para>
  <para style="q1" vid="ISA 55:2">Muntie, muntie me na munni nea eye,</para>
  <para style="q2" vid="ISA 55:2">na mo kra ani begye nnepa a ɛwɔ akatua pa ho.<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>Monyɛ aso, na mommra me nkyɛn;</para>
  <para style="q2" vid="ISA 55:3">muntie me, na mo kra anya nkwa.</para>
  <para style="q1" vid="ISA 55:3">Me ne mo bɛyɛ apam a ɛte hɔ daa,</para>
  <para style="q2" vid="ISA 55:3">me dɔ a to ntwa da a mede hyɛɛ Dawid bɔ no.<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>Hwɛ, mede no ayɛ adansedi ama nnipa no,</para>
  <para style="q2" vid="ISA 55:4">wɔn kannifo ne ɔsahene.<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>Ampa ara mobɛfrɛ aman a munnim wɔn,</para>
  <para style="q2" vid="ISA 55:5">na aman a munnim no bɛyɛ ntɛm aba mo nkyɛn,</para>
  <para style="q1" vid="ISA 55:5">
    <char style="nd">Awurade</char>, mo Nyankopɔn nti,</para>
  <para style="q2" vid="ISA 55:5">Israel Ɔkronkronni no,</para>
  <para style="q2" vid="ISA 55:5">efisɛ wahyɛ mo anuonyam.”<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>Monhwehwɛ <char style="nd">Awurade</char> bere a mubehu no.</para>
  <para style="q2" vid="ISA 55:6">Momfrɛ no bere a ɔbɛn.<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>Ma omumɔyɛfo ntwe ne ho mfi nʼakwan ho</para>
  <para style="q2" vid="ISA 55:7">na ɔbɔnefo nso mfi ne nsusuwii ho.</para>
  <para style="q1" vid="ISA 55:7">Ma ɔnnan nkɔ <char style="nd">Awurade</char> nkyɛn, na obehu no mmɔbɔ,</para>
  <para style="q2" vid="ISA 55:7">ɔnnan nkɔ yɛn Nyankopɔn nkyɛn, na ɔde ne ho bɛkyɛ no.<verse eid="ISA 55:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>“Na mʼadwene nyɛ mo adwene,</para>
  <para style="q2" vid="ISA 55:8">na mo akwan nso nyɛ mʼakwan,”</para>
  <para style="q2" vid="ISA 55:8">sɛnea <char style="nd">Awurade</char> se ni.<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>Sɛnea ɔsoro korɔn sen asase no,</para>
  <para style="q2" vid="ISA 55:9">saa ara na mʼakwan korɔn sen mo akwan</para>
  <para style="q2" vid="ISA 55:9">na mʼadwene nso korɔn sen mo adwene.<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>Sɛnea osu ne sukyerɛmma</para>
  <para style="q2" vid="ISA 55:10">tɔ fi soro gu fam,</para>
  <para style="q1" vid="ISA 55:10">na wɔnnsan nkɔ hɔ bio</para>
  <para style="q2" vid="ISA 55:10">wɔ bere a ɛmfɔw asase</para>
  <para style="q1" vid="ISA 55:10">mma enguu nhwiren mpaee,</para>
  <para style="q2" vid="ISA 55:10">sɛnea ɛbɛsow aba ama ogufo ne aduan ama odifo no,<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>saa ara na mʼasɛm a efi mʼanom no te:</para>
  <para style="q2" vid="ISA 55:11">Ɛrensan mma me nkyɛn kwa.</para>
  <para style="q1" vid="ISA 55:11">Mmom ɛbɛyɛ nea mepɛ</para>
  <para style="q2" vid="ISA 55:11">na awie botae a ɛno nti mesomaa no.<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>Mode ahosɛpɛw bepue</para>
  <para style="q2" vid="ISA 55:12">na wɔagya mo kwan asomdwoe mu;</para>
  <para style="q1" vid="ISA 55:12">mmepɔw ne nkoko</para>
  <para style="q2" vid="ISA 55:12">betue nnwonto wɔ mo anim,</para>
  <para style="q1" vid="ISA 55:12">na mfuw so nnua nyinaa</para>
  <para style="q2" vid="ISA 55:12">bɛbɔ wɔn nsam.<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>Nsɔe anan mu ɔpepaw befifi,</para>
  <para style="q2" vid="ISA 55:13">na nnɛnkyɛnse anan mu ohuam dua befifi.</para>
  <para style="q1" vid="ISA 55:13">Eyi bɛyɛ nea ɛhyɛ <char style="nd">Awurade</char> anuonyam,</para>
  <para style="q2" vid="ISA 55:13">ɛbɛyɛ daapem nsɛnkyerɛnne,</para>
  <para style="q2" vid="ISA 55:13">a ɛrentwa mu da.<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">Afoforo Nkwagye</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>Sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 56:1">“Monkɔ so mmu atɛntrenee</para>
  <para style="q2" vid="ISA 56:1">na monyɛ nea eye,</para>
  <para style="q1" vid="ISA 56:1">efisɛ me nkwagye abɛn</para>
  <para style="q2" vid="ISA 56:1">na ɛrenkyɛ me trenee bɛda adi.<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>Nhyira nka onipa a ɔyɛ eyi,</para>
  <para style="q2" vid="ISA 56:2">onipa a okura mu dennen,</para>
  <para style="q1" vid="ISA 56:2">nea ɔkae Homeda na ɔyɛ no kronkron,</para>
  <para style="q2" vid="ISA 56:2">na ɔkame ne ho fi bɔneyɛ ho.”<verse eid="ISA 56:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>Mma ɔnanani a ɔde ne ho ama <char style="nd">Awurade</char> nka se,</para>
  <para style="q2" vid="ISA 56:3">“Ampa ara <char style="nd">Awurade</char> renkan me mfra ne nkurɔfo mu.”</para>
  <para style="q1" vid="ISA 56:3">Na piamni biara nso nwiinwii sɛ,</para>
  <para style="q2" vid="ISA 56:3">“Meyɛ duwui.”<verse eid="ISA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4"/>Sɛɛ na <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="ISA 56:4">“Piamfo a wɔkae me homenna,</para>
  <para style="q1" vid="ISA 56:4">wɔn a wɔyɛ nea ɛsɔ mʼani</para>
  <para style="q2" vid="ISA 56:4">na wokura mʼapam mu dennen,<verse eid="ISA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5"/>mɛma wɔn, wɔ mʼasɔredan ne ho afasu no</para>
  <para style="q2" vid="ISA 56:5">nkae ade ne din a,</para>
  <para style="q2" vid="ISA 56:5">ɛkyɛn mmabarima ne mmabea;</para>
  <para style="q1" vid="ISA 56:5">mɛma wɔn din a ɛbɛtena hɔ afebɔɔ</para>
  <para style="q2" vid="ISA 56:5">din a ɛrentwa mu.<verse eid="ISA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>Na ananafo a wɔde wɔn ho bata <char style="nd">Awurade</char> ho</para>
  <para style="q2" vid="ISA 56:6">sɛ wɔbɛsom no,</para>
  <para style="q1" vid="ISA 56:6">sɛ wɔbɛdɔ <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="ISA 56:6">na wɔasɔre no,</para>
  <para style="q1" vid="ISA 56:6">wɔn a wɔkae Homeda na wɔyɛ no kronkron nyinaa</para>
  <para style="q2" vid="ISA 56:6">na wokura mʼapam mu dennen,<verse eid="ISA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7"/>eyinom na mede wɔn bɛba me bepɔw kronkron no so</para>
  <para style="q2" vid="ISA 56:7">na mama wɔn anigye wɔ me mpaebɔfi.</para>
  <para style="q1" vid="ISA 56:7">Wɔn ɔhyew afɔrebɔde ne afɔrebɔ ahorow no</para>
  <para style="q2" vid="ISA 56:7">megye wɔ mʼafɔremuka so;</para>
  <para style="q1" vid="ISA 56:7">na wɔbɛfrɛ me fi</para>
  <para style="q2" vid="ISA 56:7">aman nyinaa mpaebɔfi.”<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>Otumfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 56:8">nea ɔboaboa Israelfo a wɔatwa wɔn asu ano no ka se:</para>
  <para style="q1" vid="ISA 56:8">“Mɛkɔ so aboaboa afoforo ano aka wɔn ho</para>
  <para style="q2" vid="ISA 56:8">aka wɔn a maboa wɔn ano dedaw no ho.”<verse eid="ISA 56:8"/></para>
  <para style="s1">Onyankopɔn Sobo A Etia Amumɔyɛfo</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>Mommra, mo wuram mmoadoma nyinaa,</para>
  <para style="q2" vid="ISA 56:9">mummedidi, mo kwae mu mmoa nyinaa!<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>Israel awɛmfo yɛ anifuraefo,</para>
  <para style="q2" vid="ISA 56:10">wɔn mu biara nni nimdeɛ;</para>
  <para style="q1" vid="ISA 56:10">wɔn nyinaa yɛ akraman mum,</para>
  <para style="q2" vid="ISA 56:10">wontumi mmobɔ mu;</para>
  <para style="q1" vid="ISA 56:10">wɔdeda hɔ na wɔsoso dae,</para>
  <para style="q2" vid="ISA 56:10">nna yɛ wɔn dɛ.<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>Wɔyɛ akraman a wɔpɛ aduan yiye;</para>
  <para style="q2" vid="ISA 56:11">wonnidi mmee da.</para>
  <para style="q1" vid="ISA 56:11">Wɔyɛ nguanhwɛfo a wonni ntease;</para>
  <para style="q2" vid="ISA 56:11">wɔn nyinaa fa wɔn kwan,</para>
  <para style="q2" vid="ISA 56:11">obiara pɛ nʼankasa mfaso.<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>“Mommra,” obiara teɛ mu se, “momma me nsa!</para>
  <para style="q2" vid="ISA 56:12">Momma yɛnnom bobesa mmow!</para>
  <para style="q1" vid="ISA 56:12">Na ɔkyena bɛyɛ sɛ nnɛ,</para>
  <para style="q2" vid="ISA 56:12">ebia ɛbɛsen nnɛ koraa.”<verse eid="ISA 56:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1"/>Atreneefo wu,</para>
  <para style="q2" vid="ISA 57:1">na obiara nnwen ho wɔ ne koma mu;</para>
  <para style="q1" vid="ISA 57:1">wɔfa nyamesurofo kɔ,</para>
  <para style="q2" vid="ISA 57:1">na obiara nte ase</para>
  <para style="q1" vid="ISA 57:1">sɛ wɔfa atreneefo kɔ</para>
  <para style="q2" vid="ISA 57:1">sɛnea wobeyi wɔn afi bɔne mu.<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>Wɔn a wɔnantew tee no</para>
  <para style="q2" vid="ISA 57:2">wɔhyɛn asomdwoe mu;</para>
  <para style="q2" vid="ISA 57:2">wonya ahomegye bere a wɔadeda sɛ awufo.<verse eid="ISA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“Nanso mo, mommra ha, mo ɔbayifo mma,</para>
  <para style="q2" vid="ISA 57:3">mo nguaman ne mmea nguamanfo mma!<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>Hena na moreserew no?</para>
  <para style="q2" vid="ISA 57:4">Hena na moredi ne ho fɛw</para>
  <para style="q2" vid="ISA 57:4">na morebɔ no adapaa yi?</para>
  <para style="q1" vid="ISA 57:4">Monnyɛ atuatewfo fekuw</para>
  <para style="q2" vid="ISA 57:4">ne atorofo asefo ana?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>Mode ɔpɛ mmoroso bɔ afɔre wɔ adum mu</para>
  <para style="q2" vid="ISA 57:5">ne dua biara a adennan ase;</para>
  <para style="q1" vid="ISA 57:5">mode mo mma bɔ afɔre wɔ aku a mu dɔ mu</para>
  <para style="q2" vid="ISA 57:5">ne abotan mpaapae ase.<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>Anyame a wɔyɛ abo trontrom, a ɛwɔ aku a mu dɔ mu no,</para>
  <para style="q2" vid="ISA 57:6">wɔyɛ mo kyɛfa. Wɔn na mopɛ.</para>
  <para style="q1" vid="ISA 57:6">Yiw, moahwie nsa afɔrebɔde agu wɔn so</para>
  <para style="q2" vid="ISA 57:6">na mode aduan afɔrebɔde ama wɔn.</para>
  <para style="q2" vid="ISA 57:6">Eyinom nyinaa akyi, mingow me nsam ana?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>Moasiesie mo nnabea wɔ koko a ɛkorɔn so;</para>
  <para style="q2" vid="ISA 57:7">ɛhɔ na mokɔ kɔbɔ afɔre.<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>Mo apon ne apongua akyi</para>
  <para style="q2" vid="ISA 57:8">na mo de mo abosonsom nsɛsode asisi.</para>
  <para style="q1" vid="ISA 57:8">Mufii mʼakyi koyii mo mpa so ntama,</para>
  <para style="q2" vid="ISA 57:8">mokɔdaa so na motrɛw mu;</para>
  <para style="q1" vid="ISA 57:8">mo ne wɔn a modɔ wɔn mpa yɛɛ apam,</para>
  <para style="q2" vid="ISA 57:8">na mohwɛɛ wɔn adagyaw mu.<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>Mode ngo kɔɔ Molek nkyɛn</para>
  <para style="q2" vid="ISA 57:9">na momaa mo nnuhuam dɔɔso.</para>
  <para style="q1" vid="ISA 57:9">Mosomaa mo ananmusifo kɔɔ akyirikyiri;</para>
  <para style="q2" vid="ISA 57:9">mosian kɔɔ ɔda mu ankasa!<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>Mo nneyɛe maa mo ɔbrɛ,</para>
  <para style="q2" vid="ISA 57:10">nanso moanka da se, ‘Yenni anidaso.’</para>
  <para style="q1" vid="ISA 57:10">Mopɛɛ ahoɔden foforo</para>
  <para style="q2" vid="ISA 57:10">enti moantɔ piti.<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>“Hena na wama mo koma atu na wabɔ mo hu sɛɛ</para>
  <para style="q2" vid="ISA 57:11">a enti moanni me nokware,</para>
  <para style="q1" vid="ISA 57:11">na moankae me</para>
  <para style="q2" vid="ISA 57:11">anaa moannwene eyi ho wɔ mo koma mu yi?</para>
  <para style="q1" vid="ISA 57:11">So ɛnyɛ komm a mayɛ akyɛ no nti</para>
  <para style="q2" vid="ISA 57:11">na munsuro me no ana?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>Mɛda mo trenee ne mo nnwuma adi,</para>
  <para style="q2" vid="ISA 57:12">na so remma mo mfaso.<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>Sɛ moteɛ mu pɛ mmoa a,</para>
  <para style="q2" vid="ISA 57:13">momma mo ahoni a moaboa ano no nnye mo!</para>
  <para style="q1" vid="ISA 57:13">Mframa bɛbɔ wɔn nyinaa akɔ,</para>
  <para style="q2" vid="ISA 57:13">home kɛkɛ bɛfa wɔn.</para>
  <para style="q1" vid="ISA 57:13">Nanso onipa a ɔde me yɛ ne guankɔbea no</para>
  <para style="q2" vid="ISA 57:13">bedi asase no so</para>
  <para style="q2" vid="ISA 57:13">na wafa me bepɔw kronkron no.”<verse eid="ISA 57:13"/></para>
  <para style="s1">Koma A Abubu No Awerɛkyekye</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 57:14"/>Na wɔbɛka se:</para>
  <para style="q1" vid="ISA 57:14">“Monyɛ, monyɛ, munsiesie ɔkwan no!</para>
  <para style="q2" vid="ISA 57:14">Munyiyi akwanside mfi me nkurɔfo akwan mu.”<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>Na oyi ne nea ɔkorɔn no,</para>
  <para style="q2" vid="ISA 57:15">nea ɔte ase daa a ne din yɛ kronkron no se:</para>
  <para style="q1" vid="ISA 57:15">“Mete beae a ɛkorɔn na ɛyɛ kronkron,</para>
  <para style="q2" vid="ISA 57:15">mene nea ɔwɔ ahonu na ɔyɛ honhom mu hiani nso te,</para>
  <para style="q1" vid="ISA 57:15">sɛ mɛkanyan honhom mu hiani no honhom,</para>
  <para style="q2" vid="ISA 57:15">na makanyan ne koma a abubu no.<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>Meremmɔ sobo afebɔɔ,</para>
  <para style="q2" vid="ISA 57:16">na me bo remfuw daa,</para>
  <para style="q1" vid="ISA 57:16">sɛ anyɛ saa a onipa honhom bɛtɔ beraw wɔ mʼanim,</para>
  <para style="q2" vid="ISA 57:16">onipa ahome a me na mabɔ no.<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>Ne nnebɔne adifudepɛ maa me bo fuwii;</para>
  <para style="q2" vid="ISA 57:17">metwee nʼaso, na mede abufuw yii mʼani,</para>
  <para style="q2" vid="ISA 57:17">nso ɔkɔɔ so yɛɛ nea ne koma pɛ.<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>Mahu ne nneyɛe, nanso mɛsa no yare.</para>
  <para style="q2" vid="ISA 57:18">Mɛkyerɛ no kwan na makyekye ne werɛ,<verse eid="ISA 57:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19"/>na mama ayeyi aba wɔn a wɔredi awerɛhow wɔ Israel no ano.</para>
  <para style="q1" vid="ISA 57:19">Asomdwoe, asomdwoe mmra wɔn a wɔwɔ akyirikyiri ne wɔn a wɔbɛn so,”</para>
  <para style="q2" vid="ISA 57:19">sɛɛ na <char style="nd">Awurade</char> se. “Na mɛsa wɔn yare.”<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>Na amumɔyɛfo te sɛ po a ɛrehuru,</para>
  <para style="q2" vid="ISA 57:20">entumi nyɛ komm,</para>
  <para style="q2" vid="ISA 57:20">nʼasorɔkye yiyi dontori ne fi.<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>“Amumɔyɛfo nni asomdwoe.” Sɛɛ na me Nyankopɔn se.<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">Nokware Mmuadadi</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>“Monteɛ mu dennen, monnnyae.</para>
  <para style="q2" vid="ISA 58:1">Momma mo nne so sɛ torobɛnto.</para>
  <para style="q1" vid="ISA 58:1">Mompae mu nka me nkurɔfo atuatew nkyerɛ wɔn</para>
  <para style="q2" vid="ISA 58:1">na monka Yakobfi nso nnebɔne nkyerɛ no.<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>Da biara da wɔhwehwɛ me;</para>
  <para style="q2" vid="ISA 58:2">ayɛ sɛ wɔpere sɛ wobehu mʼakwan,</para>
  <para style="q1" vid="ISA 58:2">te sɛ wɔyɛ ɔman a wɔyɛ nea ɛteɛ</para>
  <para style="q2" vid="ISA 58:2">na wɔmpoo ne Nyankopɔn ahyɛde.</para>
  <para style="q1" vid="ISA 58:2">Wobisa me hɔ gyinae a ɛteɛ</para>
  <para style="q2" vid="ISA 58:2">na ayɛ sɛ wɔpɛ sɛ Onyankopɔn bɛn wɔn.<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>Wɔka se, ‘Adɛn nti na yɛadi mmuada</para>
  <para style="q2" vid="ISA 58:3">na woanhu yi?</para>
  <para style="q1" vid="ISA 58:3">Adɛn nti na yɛabrɛ yɛn ho ase,</para>
  <para style="q2" vid="ISA 58:3">na woanhwɛ yi?’</para>
  <para style="b" vid="ISA 58:3"/>
  <para style="q1" vid="ISA 58:3">“Nanso mo mmuada da no, moyɛ nea mopɛ</para>
  <para style="q2" vid="ISA 58:3">na musisi mo adwumayɛfo nyinaa.<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>Ntɔkwaw ne akasakasa na mode wie mo mmuadadi,</para>
  <para style="q2" vid="ISA 58:4">ne akuturuku a mode bobɔ mo ho.</para>
  <para style="q1" vid="ISA 58:4">Morentumi nni mmuada sɛnea moyɛ no nnɛ yi</para>
  <para style="q2" vid="ISA 58:4">na moahwɛ anim sɛ wɔbɛte mo nne wɔ ɔsoro.<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>Eyi ne mmuadadi a mepɛ ana?</para>
  <para style="q2" vid="ISA 58:5">Da koro pɛ a onipa de brɛ ne ho ase no ana?</para>
  <para style="q1" vid="ISA 58:5">Ɛne sɛ obi si ne ti ase te sɛ mfea</para>
  <para style="q2" vid="ISA 58:5">na ɔtena atweaatam so ne nsõ mu nko ara ana?</para>
  <para style="q1" vid="ISA 58:5">Eyi na mofrɛ no mmuadadi,</para>
  <para style="q2" vid="ISA 58:5">da a ɛsɔ <char style="nd">Awurade</char> ani yi ni ana?<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“Saa mmuadadi yi na mepɛ:</para>
  <para style="q2" vid="ISA 58:6">sɛ mubeyiyi ntɛnkyew nkɔnsɔnkɔnsɔn</para>
  <para style="q1" vid="ISA 58:6">na moasan konnua ahama,</para>
  <para style="q1" vid="ISA 58:6">sɛ mubegyaa wɔn a wɔhyɛ wɔn so</para>
  <para style="q2" vid="ISA 58:6">na moabubu konnua biara.<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>So ɛnsɛ sɛ mo ne wɔn a ɔkɔm de wɔn kyɛ mo aduan</para>
  <para style="q2" vid="ISA 58:7">na moma ohiani a ɔnenam no baabi tena;</para>
  <para style="q1" vid="ISA 58:7">na muhu nea ɔda adagyaw a mumfura no ntama</para>
  <para style="q2" vid="ISA 58:7">na munnyi mo ani mfi mo ankasa mo nkurɔfo ne mo abusuafo so ana?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>Ɛno na mo hann bepue te sɛ ahemadakye,</para>
  <para style="q2" vid="ISA 58:8">na mo ayaresa aba ntɛm so;</para>
  <para style="q1" vid="ISA 58:8">afei mo trenee bedi mo anim,</para>
  <para style="q2" vid="ISA 58:8">na <char style="nd">Awurade</char> anuonyam bɛbɔ mo kyidɔm.<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>Afei mobɛfrɛ, na <char style="nd">Awurade</char> begye mo so;</para>
  <para style="q2" vid="ISA 58:9">mobɛteɛ mu ahwehwɛ mmoa, na ɔbɛka se: Mini.</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“Sɛ muyi nhyɛso konnua,</para>
  <para style="q2" vid="ISA 58:9">nsa a moteɛ wɔ nnipa so ne ntwatoso fi hɔ,<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>na sɛ mohaw mo ho ma wɔn a ɔkɔm de wɔn</para>
  <para style="q2" vid="ISA 58:10">na moma wɔn a wɔhyɛ wɔn so no nea ehia wɔn a,</para>
  <para style="q1" vid="ISA 58:10">ɛno de, mo akanea bɛhyerɛn wɔ sum mu,</para>
  <para style="q2" vid="ISA 58:10">na mo anadwo bɛyɛ sɛ owigyinae.<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>
    <char style="nd">Awurade</char> bɛkyerɛ mo kwan bere biara;</para>
  <para style="q2" vid="ISA 58:11">ɔbɛma mo nea ehia mo wɔ asase wosee so</para>
  <para style="q2" vid="ISA 58:11">na ɔbɛhyɛ mo nipadua den.</para>
  <para style="q1" vid="ISA 58:11">Mobɛyɛ sɛ turo a wogugu so nsu yiye,</para>
  <para style="q2" vid="ISA 58:11">sɛ asuwa a mu nsu nyow da.<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>Mo nkurɔfo bɛsan asi teteete nnwiriwii no,</para>
  <para style="q2" vid="ISA 58:12">na wɔato fapem a akyɛ no;</para>
  <para style="q1" vid="ISA 58:12">wɔbɛfrɛ mo Nea Osiesie Afasu a Abubu no,</para>
  <para style="q2" vid="ISA 58:12">Nea Ogye Atenae Si Hɔ.<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“Sɛ mohwɛ mo anammɔntu so yiye Homeda</para>
  <para style="q2" vid="ISA 58:13">na moanyɛ nea mopɛ wɔ me da kronkron no,</para>
  <para style="q1" vid="ISA 58:13">sɛ mofrɛ Homeda no anigye da</para>
  <para style="q2" vid="ISA 58:13">na mudi <char style="nd">Awurade</char> da kronkron no ni</para>
  <para style="q1" vid="ISA 58:13">na moamfa mo ara mo akwan so</para>
  <para style="q2" vid="ISA 58:13">na moanyɛ nea mopɛ anaa moanka nsɛnhunu a,<verse eid="ISA 58:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14"/>ɛno de mubenya anigye wɔ <char style="nd">Awurade</char> mu</para>
  <para style="q2" vid="ISA 58:14">na mɛma mo anantew asase no sorɔnsorɔmmea so</para>
  <para style="q1" vid="ISA 58:14">na moato pon wɔ mo agya Yakob agyapade so.”</para>
  <para style="q2" vid="ISA 58:14">
    <char style="nd">Awurade</char> na waka.<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">Bɔne, Bɔneka Ne Ogye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>Ampa ara <char style="nd">Awurade</char> nsa nyɛ tiaa sɛ ɛrennye nkwa,</para>
  <para style="q2" vid="ISA 59:1">na nʼasom nyɛ den sɛ ɛrente asɛm.<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>Nanso mo amumɔyɛ na atetew</para>
  <para style="q2" vid="ISA 59:2">mo ne mo Nyankopɔn ntam;</para>
  <para style="q1" vid="ISA 59:2">mo bɔne ama nʼanim ahintaw mo,</para>
  <para style="q2" vid="ISA 59:2">a enti ɔrente.<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>Na mogya akeka mo nsa ho,</para>
  <para style="q2" vid="ISA 59:3">afɔdi asra mo nsateaa ho.</para>
  <para style="q1" vid="ISA 59:3">Mo ano akeka atosɛm,</para>
  <para style="q2" vid="ISA 59:3">mo tɛkrɛma de amumɔyɛsɛm di nseku.<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>Obiara nhwehwɛ atɛntrenee;</para>
  <para style="q2" vid="ISA 59:4">obiara mfa nokwaredi mmɔ ne nkurow.</para>
  <para style="q1" vid="ISA 59:4">Wɔde wɔn ho to nsɛnhuhuw so na wotwa nkontompo;</para>
  <para style="q2" vid="ISA 59:4">wonyinsɛn ɔhaw na wɔwo bɔne.<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>Wosow nhurutoa nkesua</para>
  <para style="q2" vid="ISA 59:5">na wɔnwen ananse ntontan.</para>
  <para style="q1" vid="ISA 59:5">Nea odi wɔn nkesua biara bewu,</para>
  <para style="q2" vid="ISA 59:5">mu baako nso bɔ a, ɛpae ahurutoa.<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>Wɔn ntontan nye mma adurade;</para>
  <para style="q2" vid="ISA 59:6">wɔrentumi mfa nea wɔyɛ nkata wɔn ho.</para>
  <para style="q1" vid="ISA 59:6">Wɔn nneyɛe yɛ nneyɛe bɔne,</para>
  <para style="q2" vid="ISA 59:6">na wodi akakabensɛm.<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>Wotu mmirika kɔyɛ bɔne;</para>
  <para style="q2" vid="ISA 59:7">wɔnkyɛ opira ne awudi ho.</para>
  <para style="q1" vid="ISA 59:7">Baabiara a wɔbɛkɔ no, wɔsɛe hɔ pasaa.<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>Asomdwoe kwan no, wonnim;</para>
  <para style="q2" vid="ISA 59:8">atɛntrenee nni wɔn akwan so.</para>
  <para style="q1" vid="ISA 59:8">Wɔadan wɔn akwan kɔntɔnkye</para>
  <para style="q2" vid="ISA 59:8">obiara a ɔnantew so no rennya asomdwoe.<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>Enti atɛntrenee ne yɛn ntam aware,</para>
  <para style="q2" vid="ISA 59:9">na adetrenee mmɛn yɛn.</para>
  <para style="q1" vid="ISA 59:9">Yɛhwehwɛ hann, nanso ne nyinaa yɛ sum;</para>
  <para style="q2" vid="ISA 59:9">nea ɛhyerɛn, nanso yɛnam sum kabii mu.<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>Te sɛ anifuraefo no, yɛkeka wɔ afasu ho</para>
  <para style="q2" vid="ISA 59:10">hwehwɛ ɔkwan te sɛ nnipa a wonni ani.</para>
  <para style="q1" vid="ISA 59:10">Owigyinae no yehintihintiw sɛnea onwini adwo;</para>
  <para style="q2" vid="ISA 59:10">yedu ahoɔdenfo mu a yɛte sɛ awufo.<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>Yɛn nyinaa woro so te sɛ sisi;</para>
  <para style="q2" vid="ISA 59:11">yɛde awerɛhow kurum sɛ mmorɔnoma.</para>
  <para style="q1" vid="ISA 59:11">Yɛhwehwɛ atɛntrenee nso yenhu bi;</para>
  <para style="q2" vid="ISA 59:11">ogye, nanso ɛwɔ akyirikyiri.<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>Efisɛ, yɛn mfomso adɔɔso wɔ wʼani so,</para>
  <para style="q2" vid="ISA 59:12">na yɛn bɔne di adanse tia yɛn.</para>
  <para style="q1" vid="ISA 59:12">Yɛn mfomso da yɛn anim daa,</para>
  <para style="q2" vid="ISA 59:12">na yegye yɛn amumɔyɛ to mu:<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>atuatew ne nkontompo a etia <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="ISA 59:13">yɛn akyi a yɛdan kyerɛ yɛn Nyankopɔn,</para>
  <para style="q1" vid="ISA 59:13">nhyɛso ne atuatew a yɛfoa so,</para>
  <para style="q2" vid="ISA 59:13">atosɛm a efi koma mu a yɛka.<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>Enti wɔapam atɛntrenee kɔ nʼakyi,</para>
  <para style="q2" vid="ISA 59:14">na adetrenee akogyina baabi;</para>
  <para style="q1" vid="ISA 59:14">nokware ahwe ase wɔ mmɔnten so</para>
  <para style="q2" vid="ISA 59:14">nokwaredi ntumi mma mu.<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>Nokware nni baabiara,</para>
  <para style="q2" vid="ISA 59:15">obiara a ɔtwe ne ho fi bɔne ho no bɛyɛ ɔtamfo.</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q1" vid="ISA 59:15">
    <char style="nd">Awurade</char> hwɛe na ansɔ nʼani</para>
  <para style="q2" vid="ISA 59:15">sɛ atɛntrenee nni hɔ.<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>Ohuu sɛ obiara nni hɔ,</para>
  <para style="q2" vid="ISA 59:16">ɛyɛɛ no nwonwa sɛ obiara nni hɔ a ɔbɛpata;</para>
  <para style="q1" vid="ISA 59:16">enti ɔno ankasa basa dii nkwagye ho dwuma maa no,</para>
  <para style="q2" vid="ISA 59:16">na ne trenee wowaw no.<verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>Ɔhyɛɛ trenee sɛ nkatabo,</para>
  <para style="q2" vid="ISA 59:17">ne nkwagye dadekyɛw wɔ ne ti so.</para>
  <para style="q1" vid="ISA 59:17">Ɔhyɛɛ aweretɔ ntade</para>
  <para style="q2" vid="ISA 59:17">na ofuraa mmɔdemmɔ sɛ ntama.<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>Obegyina nea wɔayɛ so</para>
  <para style="q2" vid="ISA 59:18">atua so ka</para>
  <para style="q1" vid="ISA 59:18">nʼatamfo benya nʼabufuwhyew</para>
  <para style="q2" vid="ISA 59:18">wɔn a wɔne no ayɛ dɔm benya so akatua;</para>
  <para style="q2" vid="ISA 59:18">nsupɔw no nso obetua wɔn ka sɛnea ɛfata wɔn.<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>Efi atɔe fam, nnipa besuro <char style="nd">Awurade</char> din</para>
  <para style="q2" vid="ISA 59:19">na efi apuei, wɔde nidi bɛma nʼanuonyam.</para>
  <para style="q1" vid="ISA 59:19">Na ɔbɛba sɛ asu a ayiri tɛnn</para>
  <para style="q2" vid="ISA 59:19">na <char style="nd">Awurade</char> ahomegu repia no.<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>“Ogyefo no bɛba Sion,</para>
  <para style="q2" vid="ISA 59:20">na obeyi amumɔyɛsɛm nyinaa afi Yakob asefo mu,”</para>
  <para style="q2" vid="ISA 59:20">sɛɛ na <char style="nd">Awurade</char> se.<verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>“Me de, eyi yɛ me ne wɔn apam,” sɛnea <char style="nd">Awurade</char> se ni. “Me Honhom a ɔwɔ mo so, ne me nsɛm a mede ahyɛ mo anom, remfi mo anom, anaa mo mma, ne mo mma asefo anom, efi saa bere yi kosi daa apem,” sɛɛ na <char style="nd">Awurade</char> se.<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">Sion Anuonyam</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1"/>“Sɔre, hyerɛn, na wo hann aba,</para>
  <para style="q2" vid="ISA 60:1">na <char style="nd">Awurade</char> anuonyam apue wo so.<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>Hwɛ, sum akata asase so</para>
  <para style="q2" vid="ISA 60:2">na sum kabii akata aman no so,</para>
  <para style="q1" vid="ISA 60:2">nanso <char style="nd">Awurade</char> apue wo so</para>
  <para style="q2" vid="ISA 60:2">na nʼanuonyam ada adi wɔ wo so.<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>Amanaman bɛba wo hann no mu,</para>
  <para style="q2" vid="ISA 60:3">na Ahemfo bɛba wo adekyee hann no mu.<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>“Ma wʼani so na hwɛ wo ho hyia:</para>
  <para style="q2" vid="ISA 60:4">wɔn nyinaa aboa wɔn ho ano reba wo nkyɛn;</para>
  <para style="q1" vid="ISA 60:4">wo mmabarima fifi akyirikyiri,</para>
  <para style="q2" vid="ISA 60:4">na wokura wo mmabea wɔ abasa so.<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>Afei wobɛhwɛ na wʼanim atew,</para>
  <para style="q2" vid="ISA 60:5">wo koma bɛbɔ na anigye ahyɛ no ma;</para>
  <para style="q1" vid="ISA 60:5">ahonya a ɛwɔ po so, wɔde bɛbrɛ wo,</para>
  <para style="q2" vid="ISA 60:5">na amanaman no ahode nso bɛba wo nkyɛn.<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>Yoma akuwakuw bɛyɛ wʼasase so ma,</para>
  <para style="q2" vid="ISA 60:6">yomaforo a wufi Midian ne Efa.</para>
  <para style="q1" vid="ISA 60:6">Na wɔn a wofi Seba nyinaa bɛba,</para>
  <para style="q2" vid="ISA 60:6">wɔsoso sika kɔkɔɔ ne nnuhuam</para>
  <para style="q2" vid="ISA 60:6">na wɔpae mu ka <char style="nd">Awurade</char> ayeyi.<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>Wɔbɛboaboa Kedar nguankuw nyinaa ano abrɛ wo,</para>
  <para style="q2" vid="ISA 60:7">Nebaiot adwennini bɛsom wo;</para>
  <para style="q1" vid="ISA 60:7">wobegye wɔn sɛ afɔrebɔde wɔ mʼafɔremuka so,</para>
  <para style="q2" vid="ISA 60:7">na mɛhyɛ mʼasɔredan kronkron no anuonyam.<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>“Henanom ne eyinom a wotu sɛ omununkum,</para>
  <para style="q2" vid="ISA 60:8">te sɛ mmorɔnoma a wɔrekɔ wɔn berebuw mu yi?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>Ampa ara asupɔw no ani da me so;</para>
  <para style="q2" vid="ISA 60:9">Tarsis ahyɛn na wodi anim,</para>
  <para style="q1" vid="ISA 60:9">wɔde wo mmabarima fifi akyirikyiri reba,</para>
  <para style="q2" vid="ISA 60:9">wɔsoso wɔn dwetɛ ne wɔn sikakɔkɔɔ,</para>
  <para style="q1" vid="ISA 60:9">de rebɛhyɛ <char style="nd">Awurade</char>, wo Nyankopɔn anuonyam,</para>
  <para style="q2" vid="ISA 60:9">Israel Kronkronni No,</para>
  <para style="q2" vid="ISA 60:9">efisɛ wahyɛ wo anuonyam.<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>“Ananafo bɛto wʼafasu no bio,</para>
  <para style="q2" vid="ISA 60:10">na wɔn ahemfo bɛsom wo.</para>
  <para style="q1" vid="ISA 60:10">Ɛwɔ mu, mede abufuw asɛe wo de,</para>
  <para style="q2" vid="ISA 60:10">nanso menam adom so behu wo mmɔbɔ.<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>Wo apon ano bɛdeda hɔ bere biara,</para>
  <para style="q2" vid="ISA 60:11">wɔrentoto mu awia anaa anadwo,</para>
  <para style="q1" vid="ISA 60:11">sɛnea ɛbɛyɛ a nkurɔfo de amanaman no ahonya bɛbrɛ wo,</para>
  <para style="q2" vid="ISA 60:11">wɔn ahemfo dii nkonimdi santen no anim.<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>Na ɔman anaa ahenni a wɔrensom wo no bɛyera,</para>
  <para style="q1" vid="ISA 60:12">wɔbɛsɛe no pasaa.<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>“Lebanon anuonyam bɛba wo nkyɛn,</para>
  <para style="q2" vid="ISA 60:13">ɔpepaw, ɔsɛsɛ ne kwabɔhɔre bɛbɔ mu,</para>
  <para style="q1" vid="ISA 60:13">abesiesie me kronkronbea hɔ;</para>
  <para style="q2" vid="ISA 60:13">na mɛhyɛ beae a me nan sisi no anuonyam.<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>Wo nhyɛsofo mmabarima bɛba abɛkotow wo;</para>
  <para style="q2" vid="ISA 60:14">wɔn a wobu wo animtiaa nyinaa bɛkotow wʼanan ase</para>
  <para style="q1" vid="ISA 60:14">na wɔbɛfrɛ wo <char style="nd">Awurade</char> Kuropɔn,</para>
  <para style="q2" vid="ISA 60:14">Israel Kronkronni, Sion.<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>“Ɛwɔ mu, wɔapa wʼakyi atan wo,</para>
  <para style="q2" vid="ISA 60:15">a obiara ntu kwan mfa wo mu,</para>
  <para style="q1" vid="ISA 60:15">nanso mɛyɛ wo ahohoahoade a ɛte hɔ daa</para>
  <para style="q2" vid="ISA 60:15">ne awo ntoatoaso nyinaa anigyede.<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>Wobɛnom amanaman nufusu no</para>
  <para style="q2" vid="ISA 60:16">na woanum adehye nufu.</para>
  <para style="q1" vid="ISA 60:16">Afei wubehu sɛ me <char style="nd">Awurade</char>, me ne wo Agyenkwa,</para>
  <para style="q2" vid="ISA 60:16">wo gyefo, Yakob Tumfo no.<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>Mede sikakɔkɔɔ besi kɔbere anan mu abrɛ wo,</para>
  <para style="q2" vid="ISA 60:17">na dwetɛ asi dade anan mu.</para>
  <para style="q1" vid="ISA 60:17">Mede kɔbere besi dua anan mu abrɛ wo,</para>
  <para style="q2" vid="ISA 60:17">na dade asi abo anan mu.</para>
  <para style="q1" vid="ISA 60:17">Mede asomdwoe bɛyɛ wo so amrado</para>
  <para style="q2" vid="ISA 60:17">na trenee ayɛ wo sodifo.<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>Wɔrente awurukasɛm wɔ wʼasase so bio,</para>
  <para style="q2" vid="ISA 60:18">anaa nnwiriwii ne ɔsɛe wɔ wʼahye so</para>
  <para style="q1" vid="ISA 60:18">mmom wobɛfrɛ wʼafasu se Nkwagye</para>
  <para style="q2" vid="ISA 60:18">ne wʼapon se Ayeyi.<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>Owia renyɛ wo hann adekyee mu bio</para>
  <para style="q2" vid="ISA 60:19">na ɔsram hann renhyerɛn wo so,</para>
  <para style="q1" vid="ISA 60:19">efisɛ <char style="nd">Awurade</char> bɛyɛ wo daapem hann,</para>
  <para style="q2" vid="ISA 60:19">na wo Nyankopɔn bɛyɛ wo anuonyam.<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>Wo wia rentɔ bio,</para>
  <para style="q2" vid="ISA 60:20">wo sram rennum bio,</para>
  <para style="q1" vid="ISA 60:20">
    <char style="nd">Awurade</char> bɛyɛ wo daapem hann,</para>
  <para style="q2" vid="ISA 60:20">na wʼawerɛhownna to betwa.<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>Na afei wo nkurɔfo nyinaa bɛyɛ atreneefo</para>
  <para style="q2" vid="ISA 60:21">na wɔbɛfa asase no adi so afebɔɔ.</para>
  <para style="q1" vid="ISA 60:21">Wɔyɛ ade a madua na afefɛw</para>
  <para style="q2" vid="ISA 60:21">me nsa ano adwuma a</para>
  <para style="q2" vid="ISA 60:21">ɛbɛda mʼanuonyam adi.<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>Mo mu akumaa koraa bɛdɔ ayɛ apem,</para>
  <para style="q2" vid="ISA 60:22">na aketewa no ayɛ ɔman kɛse.</para>
  <para style="q1" vid="ISA 60:22">Mene <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="ISA 60:22">na ne bere mu, mɛyɛ eyi ntɛm so.”<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">
    <char style="nd">Awurade</char> Adom Afe</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>Otumfo <char style="nd">Awurade</char> Honhom wɔ me so,</para>
  <para style="q2" vid="ISA 61:1">efisɛ, wɔafrɛ me</para>
  <para style="q2" vid="ISA 61:1">sɛ memmɛka asɛmpa nkyerɛ ahiafo.</para>
  <para style="q1" vid="ISA 61:1">Wasoma me se, menkɔkyekye wɔn a wɔn koma abubu werɛ,</para>
  <para style="q2" vid="ISA 61:1">se mempae mu nka ahofadi nkyerɛ nnommum</para>
  <para style="q2" vid="ISA 61:1">na wonyi nneduafo mfi sum mu,<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>se mempae mu nka <char style="nd">Awurade</char> adom no ho asɛm,</para>
  <para style="q2" vid="ISA 61:2">ne yɛn Nyankopɔn aweretɔ da.</para>
  <para style="q1" vid="ISA 61:2">Wasoma me se, menkyekye wɔn a wodi awerɛhow nyinaa werɛ,<verse eid="ISA 61:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3"/>na memma wɔn a wodi awerɛhow wɔ Sion no nea wohia,</para>
  <para style="q1" vid="ISA 61:3">na menhyɛ wɔn ahenkyɛw fɛfɛ</para>
  <para style="q2" vid="ISA 61:3">nsi nsõ anan mu,</para>
  <para style="q1" vid="ISA 61:3">anigye ngo</para>
  <para style="q2" vid="ISA 61:3">nsi awerɛhowdi anan mu,</para>
  <para style="q1" vid="ISA 61:3">ayeyi atade</para>
  <para style="q2" vid="ISA 61:3">nsi abasamtu honhom anan mu.</para>
  <para style="q1" vid="ISA 61:3">Wɔbɛfrɛ wɔn trenee adum</para>
  <para style="q2" vid="ISA 61:3">nea <char style="nd">Awurade</char> adua</para>
  <para style="q2" vid="ISA 61:3">de ada nʼanuonyam adi.<verse eid="ISA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>Wobesi tete mmubui no bio,</para>
  <para style="q2" vid="ISA 61:4">na wɔasiesie mmeaemmeae a asɛe dedaada no;</para>
  <para style="q1" vid="ISA 61:4">wɔbɛyɛ nkuropɔn a asɛe no foforo</para>
  <para style="q2" vid="ISA 61:4">nea asɛe awo ntoatoaso bebree no.<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>Ananafo bɛhwɛ mo nguankuw;</para>
  <para style="q2" vid="ISA 61:5">ahɔho bɛyɛ adwuma wɔ mo mfuw ne bobeturo mu.<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>Na wɔbɛfrɛ mo <char style="nd">Awurade</char> asɔfo,</para>
  <para style="q2" vid="ISA 61:6">wɔbɛto mo din sɛ yɛn Nyankopɔn asomfo.</para>
  <para style="q1" vid="ISA 61:6">Amanaman no ahonya no na mubedi</para>
  <para style="q2" vid="ISA 61:6">na wɔn ahode na mode bɛhoahoa mo ho.<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>Wɔn animguase anan mu</para>
  <para style="q2" vid="ISA 61:7">me nkurɔfo benya anuonyam mmɔho,</para>
  <para style="q1" vid="ISA 61:7">na ahohora anan mu</para>
  <para style="q2" vid="ISA 61:7">wɔbɛsɛpɛw wɔn ho wɔ wɔn adedi mu;</para>
  <para style="q1" vid="ISA 61:7">ne saa nti wɔn asase no so kyɛfa bɛyɛ mmɔho,</para>
  <para style="q2" vid="ISA 61:7">na anigye a enni awiei bɛyɛ wɔn dea.<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>“Na me <char style="nd">Awurade</char>, mepɛ atɛntrenee.</para>
  <para style="q2" vid="ISA 61:8">Mikyi korɔn ne nnebɔne.</para>
  <para style="q1" vid="ISA 61:8">Me nokware mu, mɛbɔ wɔn aba so</para>
  <para style="q2" vid="ISA 61:8">na me ne wɔn ayɛ apam a ɛbɛtena hɔ daa.<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>Wɔn asefo begye din wɔ amanaman no mu</para>
  <para style="q2" vid="ISA 61:9">ne wɔn mma wɔ nkurɔfo no mu.</para>
  <para style="q1" vid="ISA 61:9">Wɔn a wohu wɔn nyinaa begye ato mu sɛ</para>
  <para style="q2" vid="ISA 61:9">wɔyɛ nnipa a <char style="nd">Awurade</char> ahyira wɔn.”<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>
    <char style="nd">Awurade</char> mu na me ho sɛpɛw me mmoroso,</para>
  <para style="q2" vid="ISA 61:10">me Nyankopɔn mu na me kra di ahurusi.</para>
  <para style="q1" vid="ISA 61:10">Efisɛ, ɔde nkwagye ntama afura me</para>
  <para style="q2" vid="ISA 61:10">na ɔde trenee atade yuu awura me,</para>
  <para style="q1" vid="ISA 61:10">sɛnea ayeforokunu siesie me ti so sɛ ɔsɔfo,</para>
  <para style="q2" vid="ISA 61:10">ne sɛnea ayeforo de nnwinne hyehyɛ ne ho no.<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>Na sɛnea asase ma afifide pue</para>
  <para style="q2" vid="ISA 61:11">na turo nso ma aba nyin no,</para>
  <para style="q1" vid="ISA 61:11">saa ara na Otumfo <char style="nd">Awurade</char> bɛma trenee ne ayeyi</para>
  <para style="q2" vid="ISA 61:11">apue wɔ amanaman anim.<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s1">Sion Din Foforo</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>Sion nti, merenyɛ komm,</para>
  <para style="q2" vid="ISA 62:1">Yerusalem nti, merenyɛ dinn,</para>
  <para style="q1" vid="ISA 62:1">kosi sɛ ne trenee bɛhyerɛn sɛ adekyee,</para>
  <para style="q2" vid="ISA 62:1">na ne nkwagye adɛw sɛ ogyatɛn.<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>Amanaman no behu wo trenee,</para>
  <para style="q2" vid="ISA 62:2">na ahemfo nyinaa ahu wʼanuonyam;</para>
  <para style="q1" vid="ISA 62:2">wɔbɛfrɛ wo din foforo</para>
  <para style="q2" vid="ISA 62:2">a <char style="nd">Awurade</char> de bɛto wo no.<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>Wobɛyɛ anuonyam ahenkyɛw wɔ <char style="nd">Awurade</char> nsam,</para>
  <para style="q2" vid="ISA 62:3">ne adehye anuonyam abotiri wɔ wo Nyankopɔn nsam.<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>Wɔremfrɛ wo amamfo bio,</para>
  <para style="q2" vid="ISA 62:4">anaa wʼasase sɛ amamfo.</para>
  <para style="q1" vid="ISA 62:4">Na mmom wɔbɛfrɛ wo Hefsiba anaa anisɔ Kuropɔn</para>
  <para style="q2" vid="ISA 62:4">ne wʼasase sɛ Beula anaa ɔwarefo</para>
  <para style="q1" vid="ISA 62:4">efisɛ <char style="nd">Awurade</char> ani begye wo ho,</para>
  <para style="q2" vid="ISA 62:4">na ɔbɛware wʼasase.<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>Sɛnea aberante ware ababaa no,</para>
  <para style="q2" vid="ISA 62:5">saa ara na wo mmabarima bɛware wo;</para>
  <para style="q1" vid="ISA 62:5">sɛ ayeforokunu ani gye nʼayeforo ho no,</para>
  <para style="q2" vid="ISA 62:5">saa ara na wo Nyankopɔn ani begye wo ho.<verse eid="ISA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>Mede awɛmfo agyinagyina wʼafasu so, Yerusalem;</para>
  <para style="q2" vid="ISA 62:6">wɔremmua wɔn ano awia anaa anadwo.</para>
  <para style="q1" vid="ISA 62:6">Mo a musu frɛ <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="ISA 62:6">monnhome koraa,<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>na mommma onnye nʼahome kosi sɛ, ɔbɛma Yerusalem atim</para>
  <para style="q2" vid="ISA 62:7">na wayɛ no nea asase nyinaa bɛkamfo.<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>
    <char style="nd">Awurade</char> de ne basa nifa aka ntam</para>
  <para style="q2" vid="ISA 62:8">ne basa a ɛyɛ den no se,</para>
  <para style="q1" vid="ISA 62:8">“Meremfa mo awi</para>
  <para style="q2" vid="ISA 62:8">mma mo atamfo sɛ wɔn aduan bio,</para>
  <para style="q1" vid="ISA 62:8">na ananafo rennom nsa foforo</para>
  <para style="q2" vid="ISA 62:8">a moabrɛ ho no bio;<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>wɔn a wotwa no na wobedi</para>
  <para style="q2" vid="ISA 62:9">na wɔakamfo <char style="nd">Awurade</char>,</para>
  <para style="q1" vid="ISA 62:9">na wɔn a wɔboaboa bobe ano no bɛnom</para>
  <para style="q2" vid="ISA 62:9">wɔ me kronkronbea adiwo.”<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>Momfa mu, momfa kuropɔn apon no mu!</para>
  <para style="q2" vid="ISA 62:10">Munsiesie ɔkwan no mma nkurɔfo no.</para>
  <para style="q1" vid="ISA 62:10">Mompae, mompae ɔtempɔn no!</para>
  <para style="q2" vid="ISA 62:10">Munyiyi so abo no.</para>
  <para style="q1" vid="ISA 62:10">Munsi frankaa mma amanaman no.<verse eid="ISA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>
    <char style="nd">Awurade</char> abɔ no dawuru</para>
  <para style="q2" vid="ISA 62:11">akosi nsase ano se,</para>
  <para style="q1" vid="ISA 62:11">“Monka nkyerɛ Ɔbabea Sion se,</para>
  <para style="q2" vid="ISA 62:11">‘Hwɛ, wo Agyenkwa reba!</para>
  <para style="q1" vid="ISA 62:11">Hwɛ nʼakatua ka ne ho,</para>
  <para style="q2" vid="ISA 62:11">na nʼanamuhyɛde nso ka ne ho.’ ”<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>Wɔbɛfrɛ wɔn Nnipa Kronkron,</para>
  <para style="q2" vid="ISA 62:12">wɔn a <char style="nd">Awurade</char> Agye Wɔn;</para>
  <para style="q1" vid="ISA 62:12">na wɔbɛfrɛ wo Nea Wɔrehwehwɛ Nʼakyi Kwan,</para>
  <para style="q2" vid="ISA 62:12">Kuropɔn a Ɛrenyɛ Amamfo Bio.<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s1">Onyankopɔn Aweretɔ Ne Ogye Da No</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>Hena ne oyi a ofi Edom reba,</para>
  <para style="q2" vid="ISA 63:1">nea ofi Bosra a nkekae kɔkɔɔ wɔ nʼatade mu yi?</para>
  <para style="q1" vid="ISA 63:1">Hena ne oyi a wɔahyehyɛ no kɔsɔɔ yi,</para>
  <para style="q2" vid="ISA 63:1">a ɔde nʼahoɔden kɛse retutu taataa yi?</para>
  <para style="b" vid="ISA 63:1"/>
  <para style="q1" vid="ISA 63:1">“Ɛyɛ me a, mekasa wɔ trenee mu,</para>
  <para style="q2" vid="ISA 63:1">nea otumi gye nkwa no.”<verse eid="ISA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>Adɛn nti na mo ntade bere kɔɔ,</para>
  <para style="q2" vid="ISA 63:2">te sɛ obi a ɔretiatia nsakyiamoa so de yi?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>“Me nko ara atiatia nsakyiamoa so,</para>
  <para style="q2" vid="ISA 63:3">na amanaman no mu obiara anka me ho.</para>
  <para style="q1" vid="ISA 63:3">Mitiatia wɔn so wɔ mʼabufuw mu</para>
  <para style="q2" vid="ISA 63:3">na mimiaa wɔn so wɔ mʼabufuwhyew mu;</para>
  <para style="q1" vid="ISA 63:3">wɔn mogya bɔ petee me ntade mu,</para>
  <para style="q2" vid="ISA 63:3">maa nkekae yɛɛ mʼadurade nyinaa mu.<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>Na aweretɔda wɔ me koma mu</para>
  <para style="q2" vid="ISA 63:4">na me gye afe aba.<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>Mehwɛe, nanso na ɔboafo biara nni hɔ,</para>
  <para style="q2" vid="ISA 63:5">ɛyɛɛ me ahodwiriw sɛ obiara anso me mu;</para>
  <para style="q1" vid="ISA 63:5">enti mʼankasa abasa yɛɛ nkwagyedwuma maa me,</para>
  <para style="q2" vid="ISA 63:5">na mʼabufuw wowaw me.<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>Mitiatiaa amanaman no so wɔ mʼabufuw mu;</para>
  <para style="q2" vid="ISA 63:6">mema wɔbobowee wɔ mʼabufuwhyew mu</para>
  <para style="q2" vid="ISA 63:6">na mihwiee wɔn mogya guu fam.”<verse eid="ISA 63:6"/></para>
  <para style="s1">Ayeyi Ne Mpaebɔ</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7"/>Mɛka <char style="nd">Awurade</char> ayamye ho asɛm,</para>
  <para style="q2" vid="ISA 63:7">ne nneyɛe a enti ɔsɛ ayeyi,</para>
  <para style="q2" vid="ISA 63:7">wɔ nea <char style="nd">Awurade</char> ayɛ ama yɛn nyinaa ho</para>
  <para style="q1" vid="ISA 63:7">Yiw, wɔ nneɛma pa bebree a wayɛ</para>
  <para style="q2" vid="ISA 63:7">ama Israelfifo.</para>
  <para style="q2" vid="ISA 63:7">Wɔ nʼayamhyehye ne ne mmɔborɔhunu a ɛdɔɔso no nti.<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>Ɔkae se, “Ampa ara wɔyɛ me nkurɔfo,</para>
  <para style="q2" vid="ISA 63:8">mmabarima a wɔrenni me huammɔ;”</para>
  <para style="q2" vid="ISA 63:8">ɛno nti ɔbɛyɛɛ wɔn Agyenkwa.<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>Wɔn amanehunu nyinaa mu, ɔno nso huu amane,</para>
  <para style="q2" vid="ISA 63:9">na ɔbɔfo a ɔka ne ho no nso gyee wɔn.</para>
  <para style="q1" vid="ISA 63:9">Ne dɔ ne ne mmɔborɔhunu mu, ogyee wɔn;</para>
  <para style="q2" vid="ISA 63:9">ɔmaa wɔn so na ɔsoaa wɔn</para>
  <para style="q2" vid="ISA 63:9">mfe a atwa mu no nyinaa mu.<verse eid="ISA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>Nanso wɔtew atua</para>
  <para style="q2" vid="ISA 63:10">de how ne Honhom Kronkron werɛ.</para>
  <para style="q1" vid="ISA 63:10">Enti ɔbɛyɛɛ wɔn tamfo</para>
  <para style="q2" vid="ISA 63:10">na ɔno ankasa ko tiaa wɔn.<verse eid="ISA 63:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>Afei ne nkurɔfo kae tete nna no,</para>
  <para style="q2" vid="ISA 63:11">Mose ne ne nkurɔfo nna no.</para>
  <para style="q1" vid="ISA 63:11">Ɛhe na nea ɔde wɔn faa po mu no wɔ?</para>
  <para style="q2" vid="ISA 63:11">Ɔne ne nguan no hwɛfo no?</para>
  <para style="q1" vid="ISA 63:11">Ɛhe na nea ɔmaa ne Honhom Kronkron no</para>
  <para style="q2" vid="ISA 63:11">tenaa wɔn mu no wɔ,<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>nea ɔsomaa nʼanuonyam basa a ɛwɔ tumi</para>
  <para style="q2" vid="ISA 63:12">sɛ ommegyina Mose nsa nifa so no,</para>
  <para style="q1" vid="ISA 63:12">nea ɔpaee asu no mu wɔ wɔn anim,</para>
  <para style="q2" vid="ISA 63:12">de gyee din maa ne ho afebɔɔ no,<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>nea odii wɔn anim faa bun mu</para>
  <para style="q2" vid="ISA 63:13">sɛnea ɔpɔnkɔ fa asase tamaa so,</para>
  <para style="q2" vid="ISA 63:13">wɔanhintiw;<verse eid="ISA 63:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14"/>te sɛ anantwi a wɔkɔ sare so,</para>
  <para style="q2" vid="ISA 63:14">
    <char style="nd">Awurade</char> Honhom ma wɔhomee.</para>
  <para style="q1" vid="ISA 63:14">Sɛnea wokyerɛɛ wo nkurɔfo kwan</para>
  <para style="q2" vid="ISA 63:14">de gyee anuonyam abodin maa wo ho ni.<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>Brɛ wʼani ase hwɛ fam</para>
  <para style="q2" vid="ISA 63:15">fi wʼahengua a ɛkorɔn, ɛyɛ kronkron na ho wɔ nyam no so.</para>
  <para style="q1" vid="ISA 63:15">Mo mmɔdemmɔ ne mo ahoɔden wɔ he?</para>
  <para style="q2" vid="ISA 63:15">Wɔayi wʼayamhyehye ne wʼahummɔbɔ afi yɛn so.<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>Nanso wo ara wo ne yɛn Agya</para>
  <para style="q2" vid="ISA 63:16">ɛwɔ mu, Abraham nnim yɛn</para>
  <para style="q2" vid="ISA 63:16">na Israel nso nnye yɛn nto mu de;</para>
  <para style="q1" vid="ISA 63:16">nanso wo, <char style="nd">Awurade</char>, wo ne yɛn Agya;</para>
  <para style="q2" vid="ISA 63:16">efi tete, wo din ne; Yɛn Gyefo.<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>Adɛn, <char style="nd">Awurade</char>, na woma yɛkwati wʼakwan</para>
  <para style="q2" vid="ISA 63:17">na wupirim yɛn koma enti ɛmma yenni wo ni?</para>
  <para style="q1" vid="ISA 63:17">San bra, esiane wʼasomfo,</para>
  <para style="q2" vid="ISA 63:17">mmusuakuw a wɔyɛ wʼagyapade no nti.<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>Bere tiaa bi mu wo nkurɔfo faa wo kronkronbea</para>
  <para style="q2" vid="ISA 63:18">nanso mprempren yɛn atamfo atiatia so.<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>Enti yɛyɛ wo de fi tete,</para>
  <para style="q2" vid="ISA 63:19">nanso wɔn de, wunnii wɔn so hene</para>
  <para style="q2" vid="ISA 63:19">na wɔmmɔɔ wo din mfrɛɛ wɔn da.<verse eid="ISA 63:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1"/>Ao, sɛ anka wubesunsuane ɔsorosoro mu, asian aba fam a,</para>
  <para style="q2" vid="ISA 64:1">ɛno na anka mmepɔw no ho bɛpopo wɔ wʼanim!<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>Sɛnea ogya ma mmabaa dɛw</para>
  <para style="q2" vid="ISA 64:2">na ɛma nsu huru no,</para>
  <para style="q1" vid="ISA 64:2">sian bra fam na ma wʼatamfo nhu wo din,</para>
  <para style="q2" vid="ISA 64:2">na ma amanaman no ho mpopo wɔ wʼanim!<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>Na bere a woyɛɛ nneɛma a ɛyɛ nwonwa a yɛanhwɛ anim no,</para>
  <para style="q2" vid="ISA 64:3">wusian baa fam na mmepɔw no ho popoo wɔ wʼanim.<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>Efi teteete obiara ntee,</para>
  <para style="q2" vid="ISA 64:4">entwaa obiara aso mu,</para>
  <para style="q1" vid="ISA 64:4">ani biara nhuu Onyankopɔn bi sɛ wo,</para>
  <para style="q2" vid="ISA 64:4">nea odi dwuma ma wɔn a wɔtwɛn no no.<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>Woboa wɔn a wɔde anigye yɛ nea ɛteɛ,</para>
  <para style="q2" vid="ISA 64:5">wɔn a wɔkae wʼakwan.</para>
  <para style="q1" vid="ISA 64:5">Nanso yɛkɔɔ so yɛɛ bɔne tiaa wɔn no,</para>
  <para style="q2" vid="ISA 64:5">wo bo fuwii.</para>
  <para style="q2" vid="ISA 64:5">Na afei ɛbɛyɛ dɛn na woagye yɛn nkwa?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>Yɛn nyinaa ayɛ sɛ obi a ne ho ntew,</para>
  <para style="q2" vid="ISA 64:6">na yɛn trenee nneyɛe nyinaa te sɛ ntamagow fi;</para>
  <para style="q1" vid="ISA 64:6">yɛn nyinaa akisa te sɛ ahaban,</para>
  <para style="q2" vid="ISA 64:6">na yɛn bɔne pra yɛn kɔ te sɛ mframa.<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>Obiara mmɔ wo din,</para>
  <para style="q2" vid="ISA 64:7">na obiara mpere sɛ obeso wo mu;</para>
  <para style="q1" vid="ISA 64:7">efisɛ wode wʼanim ahintaw yɛn</para>
  <para style="q2" vid="ISA 64:7">na yɛn bɔne nti woama yɛasɛe.<verse eid="ISA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>Nanso wo, <char style="nd">Awurade</char>, ne yɛn Agya.</para>
  <para style="q2" vid="ISA 64:8">Yɛyɛ dɔte, na wo ne ɔnwemfo no;</para>
  <para style="q2" vid="ISA 64:8">yɛn nyinaa yɛ wo nsa ano adwuma.<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>Mma wo bo mfuw ntra so, <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="ISA 64:9">nkae yɛn bɔne da biara da.</para>
  <para style="q1" vid="ISA 64:9">Ao, brɛ wʼani ase hwɛ yɛn, yɛsrɛ wo,</para>
  <para style="q2" vid="ISA 64:9">efisɛ yɛn nyinaa yɛ wo nkurɔfo.<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>Wo nkuropɔn kronkron no adan nweatam;</para>
  <para style="q2" vid="ISA 64:10">Sion mpo ayɛ nweatam, Yerusalem ada mpan.<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>Yɛn asɔredan kronkron a ɛwɔ anuonyam, faako a yɛn nenanom yii wo ayɛ no,</para>
  <para style="q2" vid="ISA 64:11">wɔde ogya ahyew,</para>
  <para style="q2" vid="ISA 64:11">na nea ɛsom bo ma yɛn no, abubu.<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>Eyi nyinaa akyi, <char style="nd">Awurade</char>, wode wo ho bɛkame yɛn ana?</para>
  <para style="q2" vid="ISA 64:12">Wobɛkɔ so ayɛ komm atwe yɛn aso aboro so ana?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">Atemmu Ne Nkwagye</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>“Medaa me ho adi kyerɛɛ wɔn a wɔammisa mʼase;</para>
  <para style="q2" vid="ISA 65:1">wɔn a wɔnhwehwɛ me no huu me.</para>
  <para style="q1" vid="ISA 65:1">Ɔman a wonsu mfrɛ me no,</para>
  <para style="q2" vid="ISA 65:1">meka kyerɛɛ wɔn se, ‘Mini, Mini.’<verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>Da mu nyinaa, matrɛw me nsa mu ama</para>
  <para style="q2" vid="ISA 65:2">nnipa a wɔyɛ asoɔden ne nyiyiano,</para>
  <para style="q1" vid="ISA 65:2">a wɔnenam akwammɔne so,</para>
  <para style="q2" vid="ISA 65:2">na wodi wɔn ankasa nsusuwii akyi.<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>Nnipa a daa no woyi me ahi</para>
  <para style="q2" vid="ISA 65:3">wɔ mʼanim pɛɛ,</para>
  <para style="q1" vid="ISA 65:3">wɔbɔ afɔre wɔ nturo mu</para>
  <para style="q2" vid="ISA 65:3">na wɔhyew nnuhuam wɔ ntayaa afɔremuka so;<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>wɔn a wɔtenatena nna so</para>
  <para style="q2" vid="ISA 65:4">na anadwo wosii pɛ kokoa mu;</para>
  <para style="q1" vid="ISA 65:4">wɔwe mprakonam</para>
  <para style="q2" vid="ISA 65:4">na wɔn nkutu mu wɔ nkwan a wɔde nam a ɛho ntew ayɛ;<verse eid="ISA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>wɔka se, ‘Mumfi ha; mommmɛn me,</para>
  <para style="q2" vid="ISA 65:5">efisɛ me ho tew dodo ma mo!’</para>
  <para style="q1" vid="ISA 65:5">Saa nnipa yi yɛ wusiw wɔ me hwenem,</para>
  <para style="q2" vid="ISA 65:5">ogya a ɛkɔ so hyew da mu nyinaa.<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6"/>“Hwɛ; wɔakyerɛw ato hɔ wɔ mʼanim se,</para>
  <para style="q2" vid="ISA 65:6">merenyɛ komm, metua so ka pɛpɛɛpɛ;</para>
  <para style="q1" vid="ISA 65:6">metua so ka agu wɔn asrɛ so,<verse eid="ISA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7"/>mo ne mo agyanom bɔne nti,”</para>
  <para style="q2" vid="ISA 65:7">sɛɛ na <char style="nd">Awurade</char> se.</para>
  <para style="q1" vid="ISA 65:7">“Esiane sɛ wɔhyew afɔrebɔde wɔ mmepɔw so</para>
  <para style="q2" vid="ISA 65:7">na wotwirii me wɔ nkoko so nti</para>
  <para style="q1" vid="ISA 65:7">mesusuw bɔne a wɔyɛɛ kan no so akatua pɛpɛɛpɛ</para>
  <para style="q2" vid="ISA 65:7">agu wɔn asrɛ so.”<verse eid="ISA 65:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>Sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 65:8">“Sɛnea wonya nsu fi bobe kasiaw mu,</para>
  <para style="q2" vid="ISA 65:8">na nnipa ka se, ‘Monnsɛe no,</para>
  <para style="q2" vid="ISA 65:8">efisɛ ade pa bi da so wɔ mu’ no</para>
  <para style="q1" vid="ISA 65:8">saa ara na mʼasomfo no nti mɛyɛ.</para>
  <para style="q2" vid="ISA 65:8">Merensɛe wɔn nyinaa.<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>Mede Yakob asefo bɛba,</para>
  <para style="q2" vid="ISA 65:9">na me mmepɔw no sodifo afi Yuda aba;</para>
  <para style="q1" vid="ISA 65:9">me nkurɔfo a mapaw wɔn no bedi wɔn ade,</para>
  <para style="q2" vid="ISA 65:9">na hɔ na mʼasomfo bɛtena.<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>Saron bɛyɛ nguankuw adidibea,</para>
  <para style="q2" vid="ISA 65:10">na Akor bon no ayɛ anantwikuw homebea</para>
  <para style="q2" vid="ISA 65:10">ama me nkurɔfo a wɔhwehwɛ me.<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“Na mo a mo de mugyaw <char style="nd">Awurade</char></para>
  <para style="q2" vid="ISA 65:11">na mo werɛ fi ne bepɔw kronkron no,</para>
  <para style="q1" vid="ISA 65:11">mo a moto pon ma Ahonya</para>
  <para style="q2" vid="ISA 65:11">na mohyɛ afrasa wɔ nkuruwa mu ma Nkrabea no,<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>mede mo bɛto afoa ano,</para>
  <para style="q2" vid="ISA 65:12">na mo nyinaa akotow ama wɔakum mo;</para>
  <para style="q1" vid="ISA 65:12">efisɛ mefrɛe nanso moannye so,</para>
  <para style="q2" vid="ISA 65:12">mekasae nanso moantie.</para>
  <para style="q1" vid="ISA 65:12">Moyɛɛ nea ɛyɛ mʼani so bɔne</para>
  <para style="q2" vid="ISA 65:12">na moyɛɛ nea mempɛ.”<verse eid="ISA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 65:13"/>Enti sɛɛ na Otumfo <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 65:13">“Mʼasomfo bedidi,</para>
  <para style="q2" vid="ISA 65:13">nanso ɔkɔm bɛde mo,</para>
  <para style="q1" vid="ISA 65:13">mʼasomfo bɛnom,</para>
  <para style="q2" vid="ISA 65:13">nanso osukɔm bɛde mo;</para>
  <para style="q1" vid="ISA 65:13">mʼasomfo ani begye,</para>
  <para style="q2" vid="ISA 65:13">nanso mo anim begu ase.<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>Mʼasomfo bɛto nnwom</para>
  <para style="q2" vid="ISA 65:14">afi koma mu anigye mu</para>
  <para style="q1" vid="ISA 65:14">na mobɛteɛ mu asu</para>
  <para style="q2" vid="ISA 65:14">afi mo koma ahoyeraw mu,</para>
  <para style="q2" vid="ISA 65:14">na mubetwa adwo afi honhom a ayɛ mmrɛw mu.<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>Wubegyaw din bi a ɛbɛyɛ mmusu</para>
  <para style="q2" vid="ISA 65:15">ama wɔn a mapaw wɔn;</para>
  <para style="q1" vid="ISA 65:15">Otumfo <char style="nd">Awurade</char> bekum wo</para>
  <para style="q2" vid="ISA 65:15">na nʼasomfo de, mɛma wɔn din foforo.<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>Obiara a ɔsrɛ nhyira wɔ asase no so no,</para>
  <para style="q2" vid="ISA 65:16">bɛyɛ wɔ nokware Nyankopɔn koro no mu;</para>
  <para style="q1" vid="ISA 65:16">obiara a ɔka ntam wɔ asase no so</para>
  <para style="q2" vid="ISA 65:16">bɛka no wɔ nokware Nyankopɔn koro no mu.</para>
  <para style="q1" vid="ISA 65:16">Na ɔhaw a atwa mu no wɔn werɛ befi</para>
  <para style="q2" vid="ISA 65:16">na wɔde behintaw me.<verse eid="ISA 65:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17"/>“Hwɛ! Mɛbɔ</para>
  <para style="q2" vid="ISA 65:17">ɔsorosoro foforo ne asase foforo.</para>
  <para style="q1" vid="ISA 65:17">Wɔrenkae nneɛma a atwam no bio,</para>
  <para style="q2" vid="ISA 65:17">na ɛremma adwene mu nso.<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>Nanso momma mo ani nnye na munni ahurusi afebɔɔ</para>
  <para style="q2" vid="ISA 65:18">wɔ nea merebɛbɔ ho,</para>
  <para style="q1" vid="ISA 65:18">efisɛ mɛbɔ Yerusalem ama ayɛ anigye,</para>
  <para style="q2" vid="ISA 65:18">na mu nnipa ayɛ anigye farebae.<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>Mɛsɛpɛw me ho wɔ Yerusalem mu,</para>
  <para style="q2" vid="ISA 65:19">na madi ahurusi wɔ me nkurɔfo ho.</para>
  <para style="q1" vid="ISA 65:19">Na wɔrente agyaadwo ne osu nnyigyei</para>
  <para style="q2" vid="ISA 65:19">wɔ mu bio.<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“Ɛrensi bio wɔ mu</para>
  <para style="q2" vid="ISA 65:20">abofra a ne nkwanna yɛ kakraa bi,</para>
  <para style="q2" vid="ISA 65:20">anaa akwakoraa a onni ne mfe nwie;</para>
  <para style="q1" vid="ISA 65:20">nea odi mfe ɔha na owu no</para>
  <para style="q2" vid="ISA 65:20">wɔbɛfa no sɛ ɔbabun bi kɛkɛ;</para>
  <para style="q1" vid="ISA 65:20">na nea wannya mfe ɔha no</para>
  <para style="q2" vid="ISA 65:20">wɔbɛfa no sɛ wɔadome no.<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>Wobesisi afi na wɔatena mu,</para>
  <para style="q2" vid="ISA 65:21">wɔbɛyɛ bobe nturo na wɔadi mu aba.<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>Wɔrensisi afi mma afoforo mmɛtena mu bio,</para>
  <para style="q2" vid="ISA 65:22">na wɔrennua mma afoforo mmedi.</para>
  <para style="q1" vid="ISA 65:22">Na nna a dua di no,</para>
  <para style="q2" vid="ISA 65:22">saa ara na me nkurɔfo nna bɛyɛ;</para>
  <para style="q1" vid="ISA 65:22">me nkurɔfo a mapaw wɔn no bedi</para>
  <para style="q2" vid="ISA 65:22">wɔn nsa ano adwuma so aba akyɛ.<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>Wɔremmrɛ ngu</para>
  <para style="q2" vid="ISA 65:23">na wɔrenwo mma a wɔn nkrabea nye;</para>
  <para style="q1" vid="ISA 65:23">efisɛ wɔbɛyɛ nnipa a <char style="nd">Awurade</char> ahyira wɔn,</para>
  <para style="q2" vid="ISA 65:23">wɔne wɔn asefo.<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>Mebua wɔn ansa, mpo, na wɔafrɛ me.</para>
  <para style="q2" vid="ISA 65:24">Bere a wogu so rekasa no metie.<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>Pataku ne oguamma bedidi abɔ mu</para>
  <para style="q2" vid="ISA 65:25">gyata bɛwe sare sɛ nantwi,</para>
  <para style="q1" vid="ISA 65:25">nanso mfutuma bɛyɛ ɔwɔ aduan.</para>
  <para style="q2" vid="ISA 65:25">Wɔrempira obi anaa wɔrensɛe obi</para>
  <para style="q1" vid="ISA 65:25">wɔ me bepɔw kronkron so nyinaa,”</para>
  <para style="q2" vid="ISA 65:25">sɛnea <char style="nd">Awurade</char> se ni.<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">Atemmu Ne Anidaso</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>Sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 66:1">“Ɔsoro yɛ mʼahengua,</para>
  <para style="q2" vid="ISA 66:1">na asase yɛ me nan ntiaso.</para>
  <para style="q1" vid="ISA 66:1">Ofi a wubesi ama me no wɔ he?</para>
  <para style="q2" vid="ISA 66:1">Ɛhe na ɛbɛyɛ me homebea?<verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>Ɛnyɛ me nsa na ɛyɛɛ eyinom nyinaa,</para>
  <para style="q2" vid="ISA 66:2">na ɛma ɛbae ana?”</para>
  <para style="q2" vid="ISA 66:2">
    <char style="nd">Awurade</char> na ose.</para>
  <para style="b" vid="ISA 66:2"/>
  <para style="q1" vid="ISA 66:2">“Obi a mʼani sɔ no ni:</para>
  <para style="q2" vid="ISA 66:2">nea ɔwɔ ahobrɛase ne ahonu honhom,</para>
  <para style="q2" vid="ISA 66:2">na ne ho popo wɔ mʼasɛm ho.<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>Nanso obi a ɔde nantwinini bɔ afɔre no</para>
  <para style="q2" vid="ISA 66:3">saa onipa no ara kum nnipa,</para>
  <para style="q1" vid="ISA 66:3">na nea ɔma oguamma no,</para>
  <para style="q2" vid="ISA 66:3">saa onipa no ara bu ɔkraman kɔn mu;</para>
  <para style="q1" vid="ISA 66:3">nea ɔbɔ aduan afɔre no</para>
  <para style="q2" vid="ISA 66:3">saa onipa no ara de prako mogya bɔ afɔre,</para>
  <para style="q1" vid="ISA 66:3">nea ɔhyew nnuhuam a ɛwɔ din no</para>
  <para style="q2" vid="ISA 66:3">saa onipa no ara som ɔbosom.</para>
  <para style="q1" vid="ISA 66:3">Wɔafa wɔn ankasa akwan</para>
  <para style="q2" vid="ISA 66:3">na wɔn akra ani gye wɔn akyiwade ho;<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>enti me nso mɛpɛ ayayade ayɛ wɔn</para>
  <para style="q2" vid="ISA 66:4">na mede nea wosuro bɛba wɔn so.</para>
  <para style="q1" vid="ISA 66:4">Efisɛ mefrɛe no, obiara annye so,</para>
  <para style="q2" vid="ISA 66:4">mekasae no, obiara antie.</para>
  <para style="q1" vid="ISA 66:4">Wɔyɛɛ bɔne wɔ mʼani so</para>
  <para style="q1" vid="ISA 66:4">na wɔyɛɛ nea mempɛ.”<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>Muntie <char style="nd">Awurade</char> asɛm,</para>
  <para style="q2" vid="ISA 66:5">mo a mote nʼasɛm a mo ho popo:</para>
  <para style="q1" vid="ISA 66:5">“Mo nuanom mmarima a wɔtan mo,</para>
  <para style="q2" vid="ISA 66:5">na me din nti wotwa mo gyaw no, aka se,</para>
  <para style="q1" vid="ISA 66:5">‘Momma wɔnhyɛ <char style="nd">Awurade</char> anuonyam,</para>
  <para style="q2" vid="ISA 66:5">na yɛahu mo anigye!’</para>
  <para style="q2" vid="ISA 66:5">Nanso wɔn anim begu ase.<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>Muntie huuyɛ a efi kuropɔn no mu,</para>
  <para style="q2" vid="ISA 66:6">muntie gyegyeegye a efi asɔredan no mu!</para>
  <para style="q1" vid="ISA 66:6">Ɛyɛ <char style="nd">Awurade</char> nnyigyei</para>
  <para style="q2" vid="ISA 66:6">a ɔde retua nʼatamfo ka sɛnea ɛfata wɔn.<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“Ansa na ɔbea bɛkyem no,</para>
  <para style="q2" vid="ISA 66:7">ɔwo;</para>
  <para style="q1" vid="ISA 66:7">ansa na ɔbɛte awoyaw no</para>
  <para style="q2" vid="ISA 66:7">ɔwo ɔbabarima.<verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>Hena na wate biribi sɛɛ ho asɛm pɛn?</para>
  <para style="q2" vid="ISA 66:8">Hena na wahu biribi sɛɛ pɛn?</para>
  <para style="q1" vid="ISA 66:8">Wobetumi de da koro akyekyere ɔmansin,</para>
  <para style="q2" vid="ISA 66:8">anaa ɔman mu, bere sin bi mu ana?</para>
  <para style="q1" vid="ISA 66:8">Nanso awo ka Sion ara pɛ a</para>
  <para style="q2" vid="ISA 66:8">ɔwo ne mma.<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>Mede obi bedu awoko ano a</para>
  <para style="q2" vid="ISA 66:9">memma no nwo ana?” Sɛnea <char style="nd">Awurade</char> se ni.</para>
  <para style="q1" vid="ISA 66:9">“Misiw awotwaa ano</para>
  <para style="q2" vid="ISA 66:9">bere a awo adu so ana?” Wo Nyankopɔn na ose.<verse eid="ISA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>Mo ne Yerusalem ani nnye na munni ahurusi mma no,</para>
  <para style="q2" vid="ISA 66:10">mo a modɔ no nyinaa;</para>
  <para style="q1" vid="ISA 66:10">mo ne no nsɛpɛw mo ho yiye,</para>
  <para style="q2" vid="ISA 66:10">mo a mudi ne ho awerɛhow nyinaa.<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>Mubenum nʼawerɛkyekye nufu</para>
  <para style="q2" vid="ISA 66:11">no amee;</para>
  <para style="q1" vid="ISA 66:11">mobɛnom aboro so</para>
  <para style="q2" vid="ISA 66:11">na mo ani begye nea abu so atra so no ho.<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>Na sɛɛ na <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="ISA 66:12">“Mede asomdwoe bɛma no sɛ asubɔnten,</para>
  <para style="q2" vid="ISA 66:12">ne amanaman no ahonya nso sɛ asuten a ayiri.</para>
  <para style="q1" vid="ISA 66:12">Mubenum na waturu mo wɔ ne basa so</para>
  <para style="q2" vid="ISA 66:12">na obegyigye mo agoru wɔ nʼanankoroma so.<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>Sɛnea ɛna kyekye ne ba werɛ no</para>
  <para style="q2" vid="ISA 66:13">saa ara na mɛkyekye mo werɛ;</para>
  <para style="q2" vid="ISA 66:13">na mubenya awerɛkyekye wɔ Yerusalem.”<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>Sɛ muhu eyi a, mo koma ani begye</para>
  <para style="q2" vid="ISA 66:14">na mobɛyɛ frɔmfrɔm sɛ sare;</para>
  <para style="q1" vid="ISA 66:14">wobehu <char style="nd">Awurade</char> nsa wɔ ne nkoa so,</para>
  <para style="q2" vid="ISA 66:14">nanso wobehu nʼabufuwhyew wɔ nʼatamfo so.<verse eid="ISA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>Hwɛ, <char style="nd">Awurade</char> de ogya reba,</para>
  <para style="q2" vid="ISA 66:15">na ne nteaseɛnam te sɛ mfɛtɛ;</para>
  <para style="q1" vid="ISA 66:15">ɔde nʼabufuw bɛba wɔ anibere so,</para>
  <para style="q2" vid="ISA 66:15">na ɔde gyaframa ayɛ nʼanimka.<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>Ogya ne nʼafoa,</para>
  <para style="q2" vid="ISA 66:16">na <char style="nd">Awurade</char> de bebu nnipa nyinaa atɛn,</para>
  <para style="q2" vid="ISA 66:16">na wɔn a wɔbɛtotɔ wɔ <char style="nd">Awurade</char> nsa ano bɛyɛ bebree.<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>“Wɔn a wɔtew wɔn ho na wodwira wɔn ho de kɔ nturo mu, na wodi ɔbaako a ɔfra wɔn a wɔwe mprakonam ne akisi ne nneɛma a ɛyɛ akyiwade akyi no, wɔbɛbɔ mu ahu wɔn awiei,” sɛnea <char style="nd">Awurade</char> se ni.<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“Esiane wɔn nneyɛe ne wɔn nsusuwii nti, Me, mereba abɛboaboa amanaman ne ɔkasa ahorow ano, na wɔbɛba abehu mʼanuonyam.<verse eid="ISA 66:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19"/>“Na mɛyɛ nsɛnkyerɛnne bi wɔ wɔn mu, na mede nkae no mu bi bɛkɔ amanaman no mu: Tarsis, Libiafo ne Lidiafo (wɔn a wɔagye din wɔ agyantow mu), Tubal ne Helafo, ne asupɔw a ɛwɔ akyirikyiri a wɔntee me din a ahyeta na wonhuu mʼanuonyam no. Wɔbɛpae mu aka mʼanuonyam wɔ amanaman mu. <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>Na wɔde mo nuabarimanom nyinaa befi amanaman nyinaa so bɛba me bepɔw kronkron a ɛwɔ Yerusalem no so sɛ, afɔrebɔde ama <char style="nd">Awurade</char>. Wɔtete apɔnkɔ so ne nteaseɛnam mu ne asako mu ne mfurumpɔnkɔ ne yoma so bɛba,” sɛɛ na <char style="nd">Awurade</char> se. “Wɔde wɔn bɛba sɛnea Israelfo de wɔn aduan afɔre kɔ <char style="nd">Awurade</char> asɔredan mu, wɔ afahyɛ nkuruwa a ho tew mu. <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>Na meyi wɔn mu bi ayɛ asɔfo ne Lewifo,” <char style="nd">Awurade</char>, na ose!<verse eid="ISA 66:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>“Sɛnea ɔsorosoro foforo ne asase foforo bɛtena hɔ no, saa ara na mo din ne mo asefo bɛtena hɔ,” sɛnea <char style="nd">Awurade</char> se ni. <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>“Efi Ɔsram Foforo baako kɔpem foforo, efi Homeda baako kosi foforo no, adesamma nyinaa bɛba abɛkotow me,” sɛnea <char style="nd">Awurade</char> se ni. <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>“Na wobefi adi akohu wɔn a wɔtew atua tiaa me no afunu; wɔn asunson renwu, na wɔn gya nso rennum, na wɔn ho bɛyɛ adesamma nyinaa nwini.”<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
