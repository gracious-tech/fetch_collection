<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Kwadwom</para>
  <para style="toc1">Kwadwom</para>
  <para style="toc2">Kwadwom</para>
  <para style="toc3">Kwa</para>
  <para style="mt1">Kwadwom</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>Sɛnea kuropɔn no adan amamfo ni,</para>
  <para style="q2" vid="LAM 1:1">kuropɔn a anka nnipa ahyɛ no ma!</para>
  <para style="q1" vid="LAM 1:1">Adɛn nti na wayɛ okunafobea a</para>
  <para style="q2" vid="LAM 1:1">kan no na anka ɔyɛ ɔkɛse wɔ amanaman no mu?</para>
  <para style="q1" vid="LAM 1:1">Nea na ɔyɛ ɔhemmea wɔ amantam no mu no</para>
  <para style="q2" vid="LAM 1:1">abɛyɛ afenaa nnɛ.<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>Osu yayaayaw anadwo,</para>
  <para style="q2" vid="LAM 1:2">nusu sensan nʼafono so.</para>
  <para style="q1" vid="LAM 1:2">Nʼadɔfo nyinaa mu no,</para>
  <para style="q2" vid="LAM 1:2">obiara nni hɔ a ɔkyekyee ne werɛ.</para>
  <para style="q1" vid="LAM 1:2">Ne nnamfonom nyinaa ayi no ama</para>
  <para style="q2" vid="LAM 1:2">Wɔayɛ nʼatamfo.<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>Amanehunu ne adwumaden akyi no,</para>
  <para style="q2" vid="LAM 1:3">Yuda kɔ nnommum mu.</para>
  <para style="q1" vid="LAM 1:3">Ɔte amanaman no mu</para>
  <para style="q2" vid="LAM 1:3">na onni ahomegyebea.</para>
  <para style="q1" vid="LAM 1:3">Wɔn a wɔtaa no nyinaa ato no</para>
  <para style="q2" vid="LAM 1:3">wɔ nʼahokyere mu.<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>Akwan a ɛkɔ Sion no resu,</para>
  <para style="q2" vid="LAM 1:4">efisɛ obiara nkɔ nʼafahyɛ ase.</para>
  <para style="q1" vid="LAM 1:4">Nʼapon nyinaa adeda mpan,</para>
  <para style="q2" vid="LAM 1:4">na nʼasɔfo si apini,</para>
  <para style="q1" vid="LAM 1:4">ne mmabaa di yaw,</para>
  <para style="q2" vid="LAM 1:4">na ɔwɔ yawdi a mu yɛ den mu.<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>Nʼatamfo abɛyɛ ne wuranom;</para>
  <para style="q2" vid="LAM 1:5">wɔn a wɔne no ayɛ adɔm ho adwo wɔn.</para>
  <para style="q1" vid="LAM 1:5">Awurade ama awerɛhow aba ne so</para>
  <para style="q2" vid="LAM 1:5">nʼamumɔyɛ bebrebe nti.</para>
  <para style="q1" vid="LAM 1:5">Ne mma kɔ nnommum mu.</para>
  <para style="q2" vid="LAM 1:5">Wɔayɛ nneduafo ama ɔtamfo.<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>Anuonyam nyinaa atu</para>
  <para style="q2" vid="LAM 1:6">afi Ɔbabea Sion so kɔ.</para>
  <para style="q1" vid="LAM 1:6">Ne mmapɔmma ayɛ sɛ aforote</para>
  <para style="q2" vid="LAM 1:6">a wonnya adidibea;</para>
  <para style="q1" vid="LAM 1:6">na wɔde mmerɛwyɛ aguan</para>
  <para style="q2" vid="LAM 1:6">wɔ wɔn ataafo anim.<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>Nʼamanehunu ne akyinkyinakyinkyin nna mu no,</para>
  <para style="q2" vid="LAM 1:7">Yerusalem kae ademude nyinaa</para>
  <para style="q2" vid="LAM 1:7">a na ɛwɔ no wɔ nna a atwa mu no mu.</para>
  <para style="q1" vid="LAM 1:7">Ne nkurɔfo kɔtɔɔ ɔtamfo no nsa mu no,</para>
  <para style="q2" vid="LAM 1:7">na obiara nni hɔ a ɔbɛboa no.</para>
  <para style="q1" vid="LAM 1:7">Nʼatamfo de wɔn ani hwɛɛ no</para>
  <para style="q2" vid="LAM 1:7">na wɔserew ne sɛe.<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>Yerusalem ayɛ bɔne kɛse</para>
  <para style="q2" vid="LAM 1:8">enti ne ho agu fi.</para>
  <para style="q1" vid="LAM 1:8">Wɔn a wodi no ni no sopa no,</para>
  <para style="q2" vid="LAM 1:8">efisɛ wɔahu nʼadagyaw;</para>
  <para style="q1" vid="LAM 1:8">ɔno ankasa gu ahome</para>
  <para style="q2" vid="LAM 1:8">na ɔdan nʼani.<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>Nʼafideyɛ atu aka ne ntade mu;</para>
  <para style="q2" vid="LAM 1:9">wannwene ne daakye ho.</para>
  <para style="q1" vid="LAM 1:9">Nʼasehwe yɛ nwonwa;</para>
  <para style="q2" vid="LAM 1:9">obiara ankyekye ne werɛ.</para>
  <para style="q1" vid="LAM 1:9">“<char style="nd">Awurade</char>, hwɛ mʼamanehunu,</para>
  <para style="q2" vid="LAM 1:9">efisɛ ɔtamfo adi nkonim.”<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>Ɔtamfo no de ne nsa too</para>
  <para style="q2" vid="LAM 1:10">nʼademude nyinaa so;</para>
  <para style="q1" vid="LAM 1:10">ohuu sɛ amanaman</para>
  <para style="q2" vid="LAM 1:10">rehyɛn ne kronkronbea hɔ,</para>
  <para style="q1" vid="LAM 1:10">nnipa a woabra sɛ</para>
  <para style="q2" vid="LAM 1:10">wɔnnhyɛn wʼasafo mu no.<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>Ne nkurɔfo nyinaa si apini</para>
  <para style="q2" vid="LAM 1:11">bere a wɔrehwehwɛ aduan;</para>
  <para style="q1" vid="LAM 1:11">wɔde wɔn ademude sesa aduan</para>
  <para style="q2" vid="LAM 1:11">de nya ahoɔden.</para>
  <para style="q1" vid="LAM 1:11">“Awurade, hwɛ na dwene me ho,</para>
  <para style="q2" vid="LAM 1:11">efisɛ wobu me animtiaa.”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>“Ɛmfa mo ho ana, mo a mutwa mu wɔ hɔ nyinaa?</para>
  <para style="q2" vid="LAM 1:12">Monhwɛ na munhu.</para>
  <para style="q1" vid="LAM 1:12">Ɔyaw bi wɔ hɔ a ɛte sɛ me de</para>
  <para style="q2" vid="LAM 1:12">a wɔma ɛbaa me so yi,</para>
  <para style="q1" vid="LAM 1:12">nea <char style="nd">Awurade</char> de baa me so</para>
  <para style="q2" vid="LAM 1:12">wɔ nʼabufuwhyew da no ana?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>“Ɔsomaa ogya fii ɔsoro,</para>
  <para style="q2" vid="LAM 1:13">ma ɛbaa me nnompe mu.</para>
  <para style="q1" vid="LAM 1:13">Osum afiri maa mʼanan</para>
  <para style="q2" vid="LAM 1:13">na ɔsan me kɔɔ mʼakyi.</para>
  <para style="q1" vid="LAM 1:13">Ɔyɛɛ me pasaa,</para>
  <para style="q2" vid="LAM 1:13">metɔɔ beraw da mu nyinaa.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>“Woakyekyere me bɔne ahyɛ konnua mu;</para>
  <para style="q2" vid="LAM 1:14">ɔde ne nsa nwen bɔɔ mu.</para>
  <para style="q1" vid="LAM 1:14">Wɔde asɛn me kɔn mu</para>
  <para style="q2" vid="LAM 1:14">na <char style="nd">Awurade</char> atwe mʼahoɔden.</para>
  <para style="q1" vid="LAM 1:14">Ɔde me ahyɛ wɔn a</para>
  <para style="q2" vid="LAM 1:14">merentumi nnyina wɔn anim no nsa.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>“Awurade apo</para>
  <para style="q2" vid="LAM 1:15">akofo a wɔwɔ me ntam nyinaa;</para>
  <para style="q1" vid="LAM 1:15">wafrɛ asraafo atia me</para>
  <para style="q2" vid="LAM 1:15">sɛ wɔmmɛdwerɛw me mmerante.</para>
  <para style="q1" vid="LAM 1:15">
    <char style="nd">Awurade</char> atiatia Ɔbabea Ɔbabun Yuda so</para>
  <para style="q2" vid="LAM 1:15">wɔ ne nsakyiamoa mu.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>“Eyinom nti na misu</para>
  <para style="q2" vid="LAM 1:16">na nusu aguare me.</para>
  <para style="q1" vid="LAM 1:16">Obiara mmɛn a ɔbɛkyekye me werɛ,</para>
  <para style="q2" vid="LAM 1:16">nea ɔbɛhyɛ me honhom den nni hɔ.</para>
  <para style="q1" vid="LAM 1:16">Me mma agyigya</para>
  <para style="q2" vid="LAM 1:16">efisɛ ɔtamfo no adi nkonim.”<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>Sion trɛw ne nsa mu</para>
  <para style="q2" vid="LAM 1:17">nanso obiara nni hɔ a ɔbɛkyekye ne werɛ.</para>
  <para style="q1" vid="LAM 1:17">
    <char style="nd">Awurade</char> ahyɛ ama Yakob se</para>
  <para style="q2" vid="LAM 1:17">ne mfɛfo bɛyɛ nʼatamfo;</para>
  <para style="q1" vid="LAM 1:17">Yerusalem abɛyɛ</para>
  <para style="q2" vid="LAM 1:17">afide wɔ wɔn mu.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>“<char style="nd">Awurade</char> yɛ ɔtreneeni,</para>
  <para style="q2" vid="LAM 1:18">nanso manni nʼahyɛde so.</para>
  <para style="q1" vid="LAM 1:18">Muntie, mo amanaman nyinaa</para>
  <para style="q2" vid="LAM 1:18">monhwɛ me yaw.</para>
  <para style="q1" vid="LAM 1:18">Me mmerante ne mmabaa</para>
  <para style="q2" vid="LAM 1:18">kɔ nnommum mu.<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>“Mefrɛɛ mʼadɔfo</para>
  <para style="q2" vid="LAM 1:19">nanso woyii me mae.</para>
  <para style="q1" vid="LAM 1:19">Mʼasɔfo ne me mpanyimfo</para>
  <para style="q2" vid="LAM 1:19">ase tɔree wɔ kuropɔn no mu,</para>
  <para style="q1" vid="LAM 1:19">bere a wɔrehwehwɛ aduan adi</para>
  <para style="q2" vid="LAM 1:19">na wɔanwuwu.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>“Awurade, hwɛ me mmɔbɔ!</para>
  <para style="q2" vid="LAM 1:20">Meredi yaw wɔ me mu,</para>
  <para style="q1" vid="LAM 1:20">na me koma mu nso minni ahotɔ,</para>
  <para style="q2" vid="LAM 1:20">efisɛ mayɛ otuatewfo kɛse.</para>
  <para style="q1" vid="LAM 1:20">Afoa hyɛ me awerɛhow wɔ abɔnten so;</para>
  <para style="q2" vid="LAM 1:20">ofie nso yɛ owu nko ara.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>“Nnipa ate mʼapinisi,</para>
  <para style="q2" vid="LAM 1:21">nanso obiara nni hɔ a ɔbɛkyekye me werɛ.</para>
  <para style="q1" vid="LAM 1:21">Mʼatamfo nyinaa ate mʼamanehunu</para>
  <para style="q2" vid="LAM 1:21">wɔn ani gye nea woayɛ no ho.</para>
  <para style="q1" vid="LAM 1:21">Ma nna a woahyɛ no mmra</para>
  <para style="q2" vid="LAM 1:21">sɛnea wɔbɛyɛ sɛ me.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>“Fa wɔn atirimɔdensɛm nyinaa si wʼanim;</para>
  <para style="q2" vid="LAM 1:22">na wo ne wɔn nni</para>
  <para style="q1" vid="LAM 1:22">sɛnea wo ne me adi;</para>
  <para style="q2" vid="LAM 1:22">esiane mʼamumɔyɛ no nti.</para>
  <para style="q1" vid="LAM 1:22">Mʼapinisi dɔɔso</para>
  <para style="q2" vid="LAM 1:22">na me koma abotow.”<verse eid="LAM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>Sɛnea <char style="nd">Awurade</char> de nʼabufuwhyew mununkum</para>
  <para style="q2" vid="LAM 2:1">akata Ɔbabea Sion so ni?</para>
  <para style="q1" vid="LAM 2:1">Watow Israel anuonyam</para>
  <para style="q2" vid="LAM 2:1">afi ɔsoro abɛhwe fam;</para>
  <para style="q1" vid="LAM 2:1">wankae ne nan ntiaso</para>
  <para style="q2" vid="LAM 2:1">wɔ nʼabufuw da no.<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>
    <char style="nd">Awurade</char> annya ahummɔbɔ</para>
  <para style="q2" vid="LAM 2:2">na wamene Yakob atenae nyinaa;</para>
  <para style="q1" vid="LAM 2:2">nʼabufuwhyew mu, wadwiriw</para>
  <para style="q2" vid="LAM 2:2">Yuda Babea abandennen no agu fam.</para>
  <para style="q1" vid="LAM 2:2">Wagu nʼahenni ne ne mmapɔmma</para>
  <para style="q2" vid="LAM 2:2">ho fi.<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>Ɔde abufuwhyew atwitwa</para>
  <para style="q2" vid="LAM 2:3">Israel mmɛn nyinaa.</para>
  <para style="q1" vid="LAM 2:3">Wayi ne bammɔ</para>
  <para style="q2" vid="LAM 2:3">wɔ bere a atamfo no reba.</para>
  <para style="q1" vid="LAM 2:3">Wasɔ wɔ Yakob mu sɛ ogyatannaa</para>
  <para style="q2" vid="LAM 2:3">a ɛhyew biribiara a atwa ho ahyia.<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>Wapema ne bɛmma sɛ ɔtamfo;</para>
  <para style="q2" vid="LAM 2:4">ne nsa nifa ayɛ krado.</para>
  <para style="q1" vid="LAM 2:4">Te sɛ ɔtamfo no, wakunkum</para>
  <para style="q2" vid="LAM 2:4">wɔn a wɔyɛ fɛ wɔ ani so nyinaa;</para>
  <para style="q1" vid="LAM 2:4">wahwie nʼabufuwhyew sɛ ogya</para>
  <para style="q2" vid="LAM 2:4">agu Ɔbabea Sion ntamadan so.<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>
    <char style="nd">Awurade</char> ayɛ sɛ ɔtamfo;</para>
  <para style="q2" vid="LAM 2:5">wamene Israel.</para>
  <para style="q1" vid="LAM 2:5">Wamene nʼahemfi nyinaa</para>
  <para style="q2" vid="LAM 2:5">asɛe nʼabandennen.</para>
  <para style="q1" vid="LAM 2:5">Wama awerɛhowdi ne agyaadwotwa adɔɔso</para>
  <para style="q2" vid="LAM 2:5">ama Yuda Babea.<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>Wama nʼatenae ada mpan sɛ turo;</para>
  <para style="q2" vid="LAM 2:6">wasɛe nʼaguabɔbea.</para>
  <para style="q1" vid="LAM 2:6">
    <char style="nd">Awurade</char> ama Sion werɛ afi</para>
  <para style="q2" vid="LAM 2:6">nʼafahyɛ ne homenna;</para>
  <para style="q1" vid="LAM 2:6">nʼabufuwhyew mu no</para>
  <para style="q2" vid="LAM 2:6">wabu ɔhene ne ɔsɔfo animtiaa.<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>
    <char style="nd">Awurade</char> apo nʼafɔremuka</para>
  <para style="q2" vid="LAM 2:7">na wagyaa ne kronkronbea mu.</para>
  <para style="q1" vid="LAM 2:7">Ɔde nʼahemfi afasu</para>
  <para style="q2" vid="LAM 2:7">ahyɛ nʼatamfo nsa.</para>
  <para style="q1" vid="LAM 2:7">Wɔteɛ mu wɔ <char style="nd">Awurade</char> fi</para>
  <para style="q2" vid="LAM 2:7">te sɛ afahyɛ da.<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>
    <char style="nd">Awurade</char> sii nʼadwene pi sɛ ɔbɛsɛe</para>
  <para style="q2" vid="LAM 2:8">Ɔbabea Sion fasu a atwa ne ho ahyia no.</para>
  <para style="q1" vid="LAM 2:8">Ɔde susuhama too ho</para>
  <para style="q2" vid="LAM 2:8">na wannyae ɔsɛe no.</para>
  <para style="q1" vid="LAM 2:8">Ɔmaa pie ne afasu dii abooboo;</para>
  <para style="q2" vid="LAM 2:8">wɔn nyinaa sɛee.<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>Nʼapon amem fam;</para>
  <para style="q2" vid="LAM 2:9">wɔn adaban nso, wabubu mu asɛe no.</para>
  <para style="q1" vid="LAM 2:9">Ne hene ne ne mmapɔmma, watwa wɔn asu kɔ amanaman no mu,</para>
  <para style="q2" vid="LAM 2:9">mmara nni hɔ bio,</para>
  <para style="q1" vid="LAM 2:9">na nʼadiyifo nnya anisoadehu a</para>
  <para style="q2" vid="LAM 2:9">efi <char style="nd">Awurade</char> hɔ bio.<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>Ɔbabea Sion mpanyimfo</para>
  <para style="q2" vid="LAM 2:10">tete fam ayɛ komm;</para>
  <para style="q1" vid="LAM 2:10">wɔde mfutuma agu wɔn tirim</para>
  <para style="q2" vid="LAM 2:10">afurafura atweaatam.</para>
  <para style="q1" vid="LAM 2:10">Yerusalem mmabaa</para>
  <para style="q2" vid="LAM 2:10">asisi wɔn ti ase.<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>Mʼani rentumi nnyae nisutew,</para>
  <para style="q2" vid="LAM 2:11">me yafunu mu retwa me,</para>
  <para style="q1" vid="LAM 2:11">me koma retew atɔ fam,</para>
  <para style="q2" vid="LAM 2:11">efisɛ wɔasɛe me nkurɔfo,</para>
  <para style="q1" vid="LAM 2:11">efisɛ mmofra ne mmotafowa totɔ piti</para>
  <para style="q2" vid="LAM 2:11">wɔ kuropɔn no mmɔnten so.<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>Wobisa wɔn nanom se,</para>
  <para style="q2" vid="LAM 2:12">“Ɛhe na brodo ne nsa wɔ?”</para>
  <para style="q1" vid="LAM 2:12">Bere a wɔtotɔ beraw sɛ apirafo</para>
  <para style="q2" vid="LAM 2:12">wɔ kuropɔn no mmɔnten so,</para>
  <para style="q1" vid="LAM 2:12">bere a wɔn nkwa resa</para>
  <para style="q2" vid="LAM 2:12">wɔ wɔn nanom abasa so.<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>Asɛm bɛn na metumi aka ama wo?</para>
  <para style="q2" vid="LAM 2:13">Dɛn ho na metumi de wo atoto,</para>
  <para style="q1" vid="LAM 2:13">Ɔbabea Yerusalem?</para>
  <para style="q2" vid="LAM 2:13">Dɛn na metumi de asusuw wo,</para>
  <para style="q1" vid="LAM 2:13">de akyekye wo werɛ,</para>
  <para style="q2" vid="LAM 2:13">Sion Babea Ɔbabun?</para>
  <para style="q1" vid="LAM 2:13">Wʼapirakuru so sɛ po.</para>
  <para style="q2" vid="LAM 2:13">Hena na obetumi asa wo yare?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>Wʼadiyifo anisoadehu</para>
  <para style="q2" vid="LAM 2:14">yɛ atoro a so nni mfaso;</para>
  <para style="q1" vid="LAM 2:14">wɔanna mo amumɔyɛ adi</para>
  <para style="q2" vid="LAM 2:14">ansiw mo nnommumfa ano.</para>
  <para style="q1" vid="LAM 2:14">Nkɔmhyɛ a wɔde maa mo no</para>
  <para style="q2" vid="LAM 2:14">yɛ atoro ne nnaadaa.<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>Wɔn a wotwa mu wo kwan so nyinaa</para>
  <para style="q2" vid="LAM 2:15">bobɔ wɔn nsam gu wo so;</para>
  <para style="q1" vid="LAM 2:15">wodi wo ho fɛw na wɔwosow wɔn ti</para>
  <para style="q2" vid="LAM 2:15">gu Yerusalem Babea so ka se,</para>
  <para style="q1" vid="LAM 2:15">“Eyi ne kuropɔn a na wɔfrɛ no</para>
  <para style="q2" vid="LAM 2:15">ahoɔfɛ a edi mu no?</para>
  <para style="q2" vid="LAM 2:15">Asase nyinaa anigyede no ni?”<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>Wʼatamfo nyinaa baa wɔn anom</para>
  <para style="q2" vid="LAM 2:16">tɛtrɛɛ tia wo;</para>
  <para style="q1" vid="LAM 2:16">wɔserew na wɔtwɛre wɔn se</para>
  <para style="q2" vid="LAM 2:16">na wɔka se, “Yɛamene no.</para>
  <para style="q1" vid="LAM 2:16">Da a na yɛretwɛn no ni;</para>
  <para style="q2" vid="LAM 2:16">Yɛatena ase ahu.”<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>
    <char style="nd">Awurade</char> ayɛ nea ɔhyehyɛe;</para>
  <para style="q2" vid="LAM 2:17">wama nʼasɛm a</para>
  <para style="q1" vid="LAM 2:17">ɔhyɛɛ dedaada no aba mu.</para>
  <para style="q1" vid="LAM 2:17">Watu wo agu a wanhu wo mmɔbɔ,</para>
  <para style="q2" vid="LAM 2:17">wama ɔtamfo no ani agye</para>
  <para style="q2" vid="LAM 2:17">wama wʼatamfo no mmɛn so.<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>Nnipa no koma</para>
  <para style="q2" vid="LAM 2:18">su frɛ <char style="nd">Awurade</char>.</para>
  <para style="q1" vid="LAM 2:18">Ɔbabea Sion afasu,</para>
  <para style="q2" vid="LAM 2:18">momma mo nusu nsen sɛ asubɔnten</para>
  <para style="q2" vid="LAM 2:18">awia ne anadwo;</para>
  <para style="q1" vid="LAM 2:18">munnye mo ahome</para>
  <para style="q2" vid="LAM 2:18">momma mo ani nso nnya ɔhome.<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>Sɔre, su dennen anadwo,</para>
  <para style="q2" vid="LAM 2:19">ɔdasu mu mfiase;</para>
  <para style="q1" vid="LAM 2:19">hwie wo koma mu nsɛm sɛ nsu</para>
  <para style="q2" vid="LAM 2:19">gu <char style="nd">Awurade</char> anim.</para>
  <para style="q1" vid="LAM 2:19">Ma wo nsa so kyerɛ no</para>
  <para style="q2" vid="LAM 2:19">wo mma nkwa nti,</para>
  <para style="q1" vid="LAM 2:19">wɔn a ɔkɔm ama wɔatotɔ beraw</para>
  <para style="q2" vid="LAM 2:19">wɔ mmɔnten so.<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>“Hwɛ na dwene ho, Awurade:</para>
  <para style="q2" vid="LAM 2:20">Hena na wode no afa saa ɔkwan yi so pɛn?</para>
  <para style="q1" vid="LAM 2:20">Ɛsɛ sɛ mmea we wɔn yafunumma nam ana,</para>
  <para style="q2" vid="LAM 2:20">mma a wɔahwɛ wɔn?</para>
  <para style="q1" vid="LAM 2:20">Ɛsɛ sɛ wokunkum ɔsɔfo ne odiyifo</para>
  <para style="q2" vid="LAM 2:20">wɔ <char style="nd">Awurade</char> kronkronbea ana?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>“Mmofra ne mpanyin da adabum</para>
  <para style="q2" vid="LAM 2:21">wɔ mmɔnten so mfutuma mu so,</para>
  <para style="q1" vid="LAM 2:21">me mmerante ne mmabaa</para>
  <para style="q2" vid="LAM 2:21">atotɔ wɔ afoa ano.</para>
  <para style="q1" vid="LAM 2:21">Woakum wɔn wɔ wʼabufuwda;</para>
  <para style="q2" vid="LAM 2:21">woayam wɔn na woannya ahummɔbɔ.<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>“Sɛnea wotoo wo nsa frɛ wɔ aponto da no,</para>
  <para style="q2" vid="LAM 2:22">saa ara na wofrɛfrɛɛ</para>
  <para style="q2" vid="LAM 2:22">amanehunu fii afanan nyinaa tiaa me.</para>
  <para style="q1" vid="LAM 2:22">
    <char style="nd">Awurade</char> abufuw da no,</para>
  <para style="q2" vid="LAM 2:22">obiara anguan na anka obiara:</para>
  <para style="q1" vid="LAM 2:22">wɔn a mehwɛɛ wɔn na metetew wɔn no,</para>
  <para style="q2" vid="LAM 2:22">me tamfo adwerɛw wɔn.”<verse eid="LAM 2:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>Mene ɔbarima a mahu amane</para>
  <para style="q2" vid="LAM 3:1">wɔ nʼabufuw abaa ano.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>Wapam me afi ne ho ama manantew</para>
  <para style="q2" vid="LAM 3:2">sum mu na ɛnyɛ hann mu;<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>Ampa ara wama nsa so atia me</para>
  <para style="q2" vid="LAM 3:3">mpɛn bebree, da mu nyinaa.<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>Wama me were ne me nam anyin</para>
  <para style="q2" vid="LAM 3:4">Na wabubu me nnompe.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>Waka me ahyɛ mu, na watua me ano</para>
  <para style="q2" vid="LAM 3:5">ɔde nweenwen ne ahokyere atwa me ho ahyia.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>Wama matena sum mu</para>
  <para style="q2" vid="LAM 3:6">sɛ wɔn a wɔawuwu dedaw no.<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>Wato ɔfasu atwa me ho ahyia enti mintumi nguan;</para>
  <para style="q2" vid="LAM 3:7">wagu me nkɔnsɔnkɔnsɔn ama matɔ beraw.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>Mpo sɛ mefrɛ anaasɛ mebɔ mpae srɛ mmoa a</para>
  <para style="q2" vid="LAM 3:8">osiw me mpaebɔ ano.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>Ɔde abotan asiw me kwan;</para>
  <para style="q2" vid="LAM 3:9">wama mʼakwan ayɛ kɔntɔnkye.<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>Te sɛ sisi a ɔda hɔ retwɛn,</para>
  <para style="q2" vid="LAM 3:10">te sɛ gyata a watɛw,<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>ɔtwee me fii ɔkwan no mu bebaree me</para>
  <para style="q2" vid="LAM 3:11">na ogyaw me a minni mmoa biara.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>Okuntun ne ta mu</para>
  <para style="q2" vid="LAM 3:12">na ɔde ne bɛmma kyerɛɛ me so.<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>Ɔde bɛmma a efi ne kotoku mu</para>
  <para style="q2" vid="LAM 3:13">hwirew me koma mu.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>Meyɛɛ akyiwade maa me nkurɔfo nyinaa;</para>
  <para style="q2" vid="LAM 3:14">wɔto akutia nnwom</para>
  <para style="q2" vid="LAM 3:14">de di me ho fɛw da mu nyinaa.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>Ɔde nhaban nweenwen ahyɛ me ma.</para>
  <para style="q2" vid="LAM 3:15">Wama me bɔnwoma anom.<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>Ɔde mmosea abubu me se;</para>
  <para style="q2" vid="LAM 3:16">na watiatia me so wɔ mfutuma mu.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>Wɔama asomdwoe abɔ me;</para>
  <para style="q2" vid="LAM 3:17">na me werɛ afi yiyedi.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>Enti mise, “Mʼanuonyam asa,</para>
  <para style="q2" vid="LAM 3:18">nea mede mʼani too so Awurade mu no nyinaa.”<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>Mekae mʼamanehunu wɔ mʼakyinkyinakyinkyin mu,</para>
  <para style="q2" vid="LAM 3:19">nweenwen ne bɔnwoma mu.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>Mekae yiye,</para>
  <para style="q2" vid="LAM 3:20">na me kra abotow wɔ me mu.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>Nanso midwen eyi ho;</para>
  <para style="q2" vid="LAM 3:21">saa nti mewɔ anidaso.<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>Awurade dɔ kɛse nti yɛnsɛee ɛ.</para>
  <para style="q2" vid="LAM 3:22">Nʼayamhyehye nni huammɔ.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>Ɛyɛ foforo anɔpa biara;</para>
  <para style="q2" vid="LAM 3:23">wo nokwaredi yɛ kɛse.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>Meka kyerɛ me ho se,</para>
  <para style="q2" vid="LAM 3:24">“<char style="nd">Awurade</char> yɛ me kyɛfa, enti mɛtwɛn no.”<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>
    <char style="nd">Awurade</char> ye ma wɔn a wɔn anidaso wɔ ne mu,</para>
  <para style="q2" vid="LAM 3:25">onipa a ɔhwehwɛ no no;<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>Eye sɛ wɔyɛ komm</para>
  <para style="q2" vid="LAM 3:26">de twɛn <char style="nd">Awurade</char> nkwagye.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>Eye ma ɔbarima sɛ ɔsoa konnua no</para>
  <para style="q2" vid="LAM 3:27">wɔ ne mmerantebere mu.<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>Ma ɔntena ase komm,</para>
  <para style="q2" vid="LAM 3:28">efisɛ <char style="nd">Awurade</char> de ato ne so.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>Ma ɔmfa nʼanim nsie wɔ mfutuma mu,</para>
  <para style="q2" vid="LAM 3:29">ebia anidaso wɔ hɔ.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>Ma ɔmfa nʼafono mma nea ɔpɛɛ sɛ ɔbɔ no no</para>
  <para style="q2" vid="LAM 3:30">na ɔnhyɛ no aniwu.<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>Na <char style="nd">Awurade</char> ntow onipa biara nkyene koraa.<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>Ɛwɔ mu, ɔde awerɛhow ba de, nanso obenya ayamhyehye.</para>
  <para style="q2" vid="LAM 3:32">Ne dɔ kɛse no to rentwa da.<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>Ofi amemenemfe mu de amanehunu</para>
  <para style="q2" vid="LAM 3:33">anaa awerɛhow brɛ nnipa mma.<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>Sɛ wɔde wɔn nan dwerɛw</para>
  <para style="q2" vid="LAM 3:34">nneduafo a wɔwɔ asase no so a,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>sɛ wotiatia obi ahofadi so</para>
  <para style="q2" vid="LAM 3:35">wɔ Ɔsorosoroni no anim a,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>anaa sɛ wobu obi ntɛnkyew a,</para>
  <para style="q2" vid="LAM 3:36">Awurade renhu saa nneɛma yi ana?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>Hena na obetumi aka na wama aba mu</para>
  <para style="q2" vid="LAM 3:37">wɔ bere a ɛnyɛ Awurade na ɔhyɛe?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>Ɛnyɛ Ɔsorosoroni no anom</para>
  <para style="q2" vid="LAM 3:38">na mmusu ne nnepa fi ana?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>Adɛn nti na ɛsɛ sɛ ɔteasefo nwiinwii</para>
  <para style="q2" vid="LAM 3:39">bere a wɔatwe nʼaso wɔ ne bɔne ho?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>Momma yɛnhwehwɛ yɛn akwan mu na yɛnsɔ nhwɛ,</para>
  <para style="q2" vid="LAM 3:40">na yɛnsan nkɔ <char style="nd">Awurade</char> nkyɛn.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>Momma yɛmma yɛn koma ne yɛn nsa so,</para>
  <para style="q2" vid="LAM 3:41">nkyerɛ Onyankopɔn wɔ ɔsoro, na yɛnka se:<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>“Yɛayɛ bɔne, na yɛatew atua</para>
  <para style="q2" vid="LAM 3:42">na wamfa ankyɛ.<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>“Wode abufuw akata wo ho ataa yɛn;</para>
  <para style="q2" vid="LAM 3:43">na woakunkum a woannya ahummɔbɔ.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>Wode wo ho asie omununkum mu</para>
  <para style="q2" vid="LAM 3:44">nti mpaebɔ biara nnu wo nkyɛn.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>Woayɛ yɛn atantanne ne nwura</para>
  <para style="q2" vid="LAM 3:45">wɔ amanaman no mu.<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>“Yɛn atamfo nyinaa abaa wɔn anom tɛtrɛɛ</para>
  <para style="q2" vid="LAM 3:46">de tia yɛn.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>Yɛabrɛ ne ahunahuna ne akukuruhwease,</para>
  <para style="q2" vid="LAM 3:47">mmubui ne ɔsɛe.”<verse eid="LAM 3:47"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>Me nusu sen sɛ asuten</para>
  <para style="q2" vid="LAM 3:48">efisɛ wɔasɛe me nkurɔfo.<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>Me nusu bɛsen ara,</para>
  <para style="q2" vid="LAM 3:49">na ɛrennyae,<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>kosi sɛ <char style="nd">Awurade</char> bɛhwɛ</para>
  <para style="q2" vid="LAM 3:50">afi ɔsoro, na wahu.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>Nea mihu no ma me kra werɛ how,</para>
  <para style="q2" vid="LAM 3:51">me kuropɔn no mu mmea nyinaa nti.<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>Mʼatamfo a menyɛɛ wɔn hwee</para>
  <para style="q2" vid="LAM 3:52">pampam me sɛ anomaa.<verse eid="LAM 3:52"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>Wɔpɛɛ sɛ wotwa me nkwa so</para>
  <para style="q2" vid="LAM 3:53">na wosiw me abo wɔ amoa mu;<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>nsu bu faa me ti so,</para>
  <para style="q2" vid="LAM 3:54">na ɛyɛɛ me sɛnea wɔrewie me.<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>Mebɔɔ wo din, <char style="nd">Awurade</char></para>
  <para style="q2" vid="LAM 3:55">fii amoa no ase tɔnn.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>Wotee me sufrɛ: “Nsiw wʼaso</para>
  <para style="q2" vid="LAM 3:56">wɔ me gye sufrɛ ho.”<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>Wutwiw bɛn me bere a mefrɛɛ wo no,</para>
  <para style="q2" vid="LAM 3:57">na wokae se, “Nsuro.”<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>Wo Awurade, wudii mʼasɛm maa me;</para>
  <para style="q2" vid="LAM 3:58">na wugyee me nkwa.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>Woahu bɔne a wɔayɛ me, <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="LAM 3:59">Di mʼasɛm ma me!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>Woahu wɔn aweretɔ no mu den,</para>
  <para style="q2" vid="LAM 3:60">wɔn pɔw a wɔbɔ tia me no nyinaa.<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>
    <char style="nd">Awurade</char>, woate wɔn ntwirii,</para>
  <para style="q2" vid="LAM 3:61">wɔn pɔw a wɔbɔ tia me no nyinaa,<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>nea mʼatamfo ka no asomsɛm na wɔka no brɛoo</para>
  <para style="q2" vid="LAM 3:62">de tia me da mu nyinaa.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>Hwɛ wɔn! Sɛ wogyinagyina hɔ anaasɛ wɔtete hɔ,</para>
  <para style="q1" vid="LAM 3:63">wɔto akutia nnwom de di me ho fɛw.<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>Fa nea ɛfata tua wɔn so ka, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="LAM 3:64">nea wɔn nsa ayɛ nti.<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>Pirim wɔn koma,</para>
  <para style="q2" vid="LAM 3:65">na ma wo nnome mmra wɔn so.<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>Fa abufuw taa wɔn, na sɛe wɔn</para>
  <para style="q2" vid="LAM 3:66">fi <char style="nd">Awurade</char> ɔsorosoro ase.<verse eid="LAM 3:66"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>Hwɛ sɛnea sikakɔkɔɔ ayera ne hyerɛn no ni</para>
  <para style="q2" vid="LAM 4:1">Sikakɔkɔɔ ankasa na ho abiri saa!</para>
  <para style="q1" vid="LAM 4:1">Wɔatoto aboɔdemmo kronkron apete</para>
  <para style="q2" vid="LAM 4:1">wɔ abɔnten biara so.<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>Hwɛ sɛnea Sion mmabarima a wodi mu</para>
  <para style="q2" vid="LAM 4:2">na anka wɔsom bo sɛ sikakɔkɔɔ no ayɛ,</para>
  <para style="q1" vid="LAM 4:2">mprempren wɔfa wɔn sɛ dɔte nkuku,</para>
  <para style="q2" vid="LAM 4:2">ɔnwemfo nsa ano adwuma!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>Mpo adompo yi wɔn nufu</para>
  <para style="q2" vid="LAM 4:3">ma wɔn mma num,</para>
  <para style="q1" vid="LAM 4:3">nanso me nkurɔfo ayɛ atirimɔdenfo</para>
  <para style="q2" vid="LAM 4:3">sɛ sohori a ɔwɔ sare so.<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>Osukɔm nti, akokoaa tɛkrɛma</para>
  <para style="q2" vid="LAM 4:4">fam ne dodo mu;</para>
  <para style="q1" vid="LAM 4:4">mmofra no srɛ aduan,</para>
  <para style="q2" vid="LAM 4:4">nanso obiara mfa mma wɔn.<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>Wɔn a na anka wodi nnuan pa no</para>
  <para style="q2" vid="LAM 4:5">ohia buruburoo aka wɔn wɔ mmɔnten so.</para>
  <para style="q1" vid="LAM 4:5">Wɔn a wɔde sirikyi tetew wɔn no</para>
  <para style="q2" vid="LAM 4:5">mprempren wɔdeda nso a wɔaboa ano so.<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>Me nkurɔfo asotwe</para>
  <para style="q2" vid="LAM 4:6">so sen Sodom a</para>
  <para style="q1" vid="LAM 4:6">wotuu wɔn mpofirim no,</para>
  <para style="q2" vid="LAM 4:6">a wɔannya ɔboafo biara de.<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>Na wɔn ahenemma ho twa sen sukyerɛmma,</para>
  <para style="q2" vid="LAM 4:7">na wɔnan sen nufusu,</para>
  <para style="q1" vid="LAM 4:7">na wɔn nipadua no bere, na ɛwɔ ahoɔden te sɛ abohemaa,</para>
  <para style="q2" vid="LAM 4:7">na wɔte sɛ hoabo.<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>Nanso mprempren de, wobiri sen wusiw bɔtɔ;</para>
  <para style="q2" vid="LAM 4:8">na wonhu wɔn yiye wɔ mmɔnten so.</para>
  <para style="q1" vid="LAM 4:8">Wɔn were atwintwam wɔ wɔn nnompe so;</para>
  <para style="q2" vid="LAM 4:8">ho awo wosee sɛ abaa.<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>Wɔn a wɔtotɔɔ wɔ afoa ano no ye koraa</para>
  <para style="q2" vid="LAM 4:9">sen wɔn a ɔkɔm kunkum wɔn;</para>
  <para style="q1" vid="LAM 4:9">ɔkɔm tware wɔn ma wowuwu,</para>
  <para style="q2" vid="LAM 4:9">esiane aduan a enni mfuw so nti.<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>Mmea a wɔwɔ ayamhyehye</para>
  <para style="q2" vid="LAM 4:10">de wɔn nsa anoa wɔn ankasa mma,</para>
  <para style="q1" vid="LAM 4:10">ayɛ wɔn aduan,</para>
  <para style="q2" vid="LAM 4:10">bere a wɔsɛee me nkurɔfo no.<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>
    <char style="nd">Awurade</char> ada nʼabufuwhyew nyinaa adi;</para>
  <para style="q2" vid="LAM 4:11">wahwie nʼabufuw a ano yɛ den no.</para>
  <para style="q1" vid="LAM 4:11">Ɔsɔɔ ogya ano wɔ Sion</para>
  <para style="q2" vid="LAM 4:11">ma ɛhyew ne fapem.<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>Asase so ahemfo annye anni,</para>
  <para style="q2" vid="LAM 4:12">wiase mu nnipa nso annye anni</para>
  <para style="q1" vid="LAM 4:12">sɛ atamfo betumi ahyɛn</para>
  <para style="q2" vid="LAM 4:12">Yerusalem apon mu.<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>Nanso esii, nʼadiyifo no bɔne</para>
  <para style="q2" vid="LAM 4:13">ne nʼasɔfo amumɔyɛ nti,</para>
  <para style="q1" vid="LAM 4:13">wɔn na wohwiee atreneefo mogya</para>
  <para style="q2" vid="LAM 4:13">guu wɔ kuropɔn no mu.<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>Afei wɔkeka wɔ mmɔnten so</para>
  <para style="q2" vid="LAM 4:14">te sɛ nnipa a wɔn ani afura.</para>
  <para style="q1" vid="LAM 4:14">Mogya a ama wɔn ho agu fi no nti</para>
  <para style="q2" vid="LAM 4:14">obiara suro sɛ ɔde ne ho bɛka wɔn ntade.<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>Nnipa teɛteɛɛ mu gu wɔn so se, “Mumfi ha nkɔ! Mo ho ntew!”</para>
  <para style="q2" vid="LAM 4:15">“Monkɔ, monkɔ! Mommfa mo ho nka yɛn.”</para>
  <para style="q1" vid="LAM 4:15">Sɛ woguan kɔnenam a</para>
  <para style="q2" vid="LAM 4:15">amanaman no mu nnipa ka se,</para>
  <para style="q2" vid="LAM 4:15">“Wɔrentumi ntena ha bio.”<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>
    <char style="nd">Awurade</char> ankasa abɔ wɔn ahwete;</para>
  <para style="q2" vid="LAM 4:16">nʼani nni wɔn so bio.</para>
  <para style="q1" vid="LAM 4:16">Wɔmmfa nidi mma asɔfo,</para>
  <para style="q2" vid="LAM 4:16">na wɔn ani nsɔ mpanyimfo.<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>Nea ɛka ho bio, yɛn ani anni ammoa yɛn,</para>
  <para style="q2" vid="LAM 4:17">yɛpɛɛ sɛ yebenya mmoa, nanso ɛyɛɛ ɔkwa;</para>
  <para style="q1" vid="LAM 4:17">yefi yɛn abantenten so de yɛn ani too</para>
  <para style="q2" vid="LAM 4:17">ɔman a wɔrentumi nnye yɛn so.<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>Nnipa dii yɛn ntɛntɛnso wɔ yɛn anammɔntu mu,</para>
  <para style="q2" vid="LAM 4:18">enti yɛantumi annantew yɛn mmɔnten so.</para>
  <para style="q1" vid="LAM 4:18">Yɛn awiei bɛnee, na wɔkan yɛn nna,</para>
  <para style="q2" vid="LAM 4:18">efisɛ na yɛn awiei adu so.<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>Yɛn ataafo ho yɛ hare</para>
  <para style="q2" vid="LAM 4:19">sen akɔre a wɔwɔ wim;</para>
  <para style="q1" vid="LAM 4:19">wɔtaa yɛn faa mmepɔw so</para>
  <para style="q2" vid="LAM 4:19">na wɔtɛw yɛn wɔ sare so.<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>Nea <char style="nd">Awurade</char> asra no ngo, yɛn nkwa home ankasa no,</para>
  <para style="q2" vid="LAM 4:20">kɔtɔɔ wɔn mfiri mu.</para>
  <para style="q1" vid="LAM 4:20">Yegye dii sɛ ne nwini ase,</para>
  <para style="q2" vid="LAM 4:20">yebenya nkwa wɔ amanaman no mu.<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>Di ahurusi na ma wʼani nnye, Edom Babea,</para>
  <para style="q2" vid="LAM 4:21">wo a wote Us asase so.</para>
  <para style="q1" vid="LAM 4:21">Wɔde kuruwa no bɛma wo nso bi;</para>
  <para style="q2" vid="LAM 4:21">wobɛbow na wɔabɔ wo adagyaw.<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>Ɔbabea Sion, wʼasotwe bɛba awiei;</para>
  <para style="q2" vid="LAM 4:22">ɔremma wo nkɔ so ntena nnommum mu.</para>
  <para style="q1" vid="LAM 4:22">Nanso Ɔbabea Edom, obetua wo bɔne so ka</para>
  <para style="q2" vid="LAM 4:22">na wada wʼamumɔyɛ adi.<verse eid="LAM 4:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>
    <char style="nd">Awurade</char>, kae nea aba yɛn so;</para>
  <para style="q2" vid="LAM 5:1">hwɛ, na hu yɛn animguase.<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>Wɔadan yɛn agyapade ama ahɔho,</para>
  <para style="q2" vid="LAM 5:2">wɔde yɛn afi ama ananafo.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>Yɛayɛ nyisaa na yenni agyanom,</para>
  <para style="q2" vid="LAM 5:3">yɛn nanom yɛ akunafo.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>Ɛsɛ sɛ yɛtɔ nsu a yɛnom;</para>
  <para style="q2" vid="LAM 5:4">yebenya nnyina a, gye sɛ yɛtɔ.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>Wɔn a wɔtaa yɛn no abɛn yɛn pɛɛ;</para>
  <para style="q2" vid="LAM 5:5">Yɛabrɛ na yennya ahomegye.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>Yɛde yɛn ho maa Misraim ne Asiria</para>
  <para style="q2" vid="LAM 5:6">sɛnea yebenya aduan a ɛbɛso yɛn.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>Yɛn agyanom yɛɛ bɔne, na wonni hɔ bio,</para>
  <para style="q2" vid="LAM 5:7">na yɛn na wɔn asotwe abɛda yɛn so.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>Nkoa di yɛn so,</para>
  <para style="q2" vid="LAM 5:8">na obiara nni hɔ a obegye yɛn afi wɔn nsam.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>Yɛde yɛn nkwa bɔ afɔre de pɛ yɛn anoduan,</para>
  <para style="q2" vid="LAM 5:9">afoa a ɛwɔ sare so no nti.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>Yɛn honam adɔ sɛ fononoo.</para>
  <para style="q2" vid="LAM 5:10">Ɔkɔm ama atiridii abɔ yɛn.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>Wɔato mmea mmonnaa wɔ Sion,</para>
  <para style="q2" vid="LAM 5:11">ne mmabun a wɔwɔ Yuda nkurow so.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>Wɔkyekyere mmapɔmma nsa na wɔasɛn wɔn;</para>
  <para style="q2" vid="LAM 5:12">wɔmmfa nidi mma mpanyimfo.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>Mmerante yɛ adwumaden wɔ awiyammo so;</para>
  <para style="q2" vid="LAM 5:13">na mmerantewa nan toto wɔ nnyina duruduru ase.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>Mpanyimfo ntena kuropɔn apon ano bio;</para>
  <para style="q2" vid="LAM 5:14">mmerante agyae wɔn nnwonto.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>Ahosɛpɛw afi yɛn koma mu;</para>
  <para style="q2" vid="LAM 5:15">yɛn asaw adan agyaadwotwa.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>Ahenkyɛw afi yɛn ti so.</para>
  <para style="q2" vid="LAM 5:16">Yɛn ara, yennue sɛ yɛayɛ bɔne!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>Eyi nti yɛn koma atɔ beraw,</para>
  <para style="q2" vid="LAM 5:17">eyinom nti yɛn ani so ayɛ kusuu<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>wɔ Sion bepɔw a ada mpan</para>
  <para style="q2" vid="LAM 5:18">na sakraman nenam so no nti.<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>Wo, <char style="nd">Awurade</char>, di hene afebɔɔ;</para>
  <para style="q2" vid="LAM 5:19">wʼahengua fi awo ntoatoaso kosi awo ntoatoaso.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>Adɛn nti na wo werɛ fi yɛn daa yi?</para>
  <para style="q2" vid="LAM 5:20">Adɛn nti na wagyaw yɛn, mmere tenten mu yi?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>Ka yɛn bata wo ho bio, <char style="nd">Awurade</char>, na yɛatumi asan aba wo nkyɛn;</para>
  <para style="q2" vid="LAM 5:21">yɛ yɛn nna foforo sɛ tete no<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>gye sɛ woapo yɛn koraa</para>
  <para style="q2" vid="LAM 5:22">anaasɛ wo bo afuw yɛn mmoroso.<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
