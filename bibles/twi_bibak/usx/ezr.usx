  <para style="b" vid="EZR 2:35">
    <verse eid="EZR 2:35"/>
  </para>
  <para style="li4">
    <verse number="36" style="v" sid="EZR 2:36"/>Eyinom ne asɔfo dodow a wofi nnommum mu bae:</para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Yedaia asefo (a wɔnam Yesua fi so) dodow yɛ </cell>
      <cell style="tcr2" align="end">973</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:36"/>
        <verse number="37" style="v" sid="EZR 2:37"/>Imer asefo dodow yɛ </cell>
      <cell style="tcr2" align="end">1,052</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:37"/>
        <verse number="38" style="v" sid="EZR 2:38"/>Pashur asefo dodow yɛ </cell>
      <cell style="tcr2" align="end">1,247</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:38"/>
        <verse number="39" style="v" sid="EZR 2:39"/>Harim asefo dodow yɛ </cell>
      <cell style="tcr2" align="end">1,017</cell>
    </row>
  </table>
  <para style="b" vid="EZR 2:39">
    <verse eid="EZR 2:39"/>
  </para>
  <para style="li4">
    <verse number="40" style="v" sid="EZR 2:40"/>Eyinom ne Lewifo a wofi nnommum mu bae:</para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Yesua ne Kadmiel asefo (Hodawia asefo) dodow yɛ </cell>
      <cell style="tcr2" align="end">74</cell>
    </row>
  </table>
  <para style="b" vid="EZR 2:40">
    <verse eid="EZR 2:40"/>
  </para>
  <para style="li4">
    <verse number="41" style="v" sid="EZR 2:41"/>Nnwontofo:</para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Asaf<note caller="+" style="f"><char style="fr" closed="false">2.41 </char><char style="ft" closed="false">Na Asaf yɛ Lewifo no mu baako a Dawid yii no ma ɔhwɛɛ nnwomkyerɛ so.</char></note> asefo mu nnwontofo dodow yɛ </cell>
      <cell style="tcr2" align="end">128</cell>
    </row>
  </table>
  <para style="b" vid="EZR 2:41">
    <verse eid="EZR 2:41"/>
  </para>
  <para style="li4">
    <verse number="42" style="v" sid="EZR 2:42"/>Aponanohwɛfo:<note caller="+" style="f"><char style="fr" closed="false">2.42 </char><char style="ft" closed="false">Na aponanohwɛfo no yɛ Lewifo a wɔwɛn Asɔredan no kwan ano.</char></note></para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Salum, Ater, Talmon asefo</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">Akub, Hatita ne Sobai asefo </cell>
      <cell style="tcr2" align="end">139</cell>
    </row>
  </table>
  <para style="b" vid="EZR 2:42">
    <verse eid="EZR 2:42"/>
  </para>
  <para style="li4">
    <verse number="43" style="v" sid="EZR 2:43"/>Saa asɔredan mu asomfo asefo yi na wofi nnommum mu bae:</para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Siha, Hasufa, Tabaot,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:43"/>
        <verse number="44" style="v" sid="EZR 2:44"/>Keros, Siaha, Padon,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:44"/>
        <verse number="45" style="v" sid="EZR 2:45"/>Lebana, Hagaba, Akub,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:45"/>
        <verse number="46" style="v" sid="EZR 2:46"/>Hagab, Samlai, Hanan,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:46"/>
        <verse number="47" style="v" sid="EZR 2:47"/>Gidel, Gahar, Reaia,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:47"/>
        <verse number="48" style="v" sid="EZR 2:48"/>Resin, Nekoda, Gasam,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:48"/>
        <verse number="49" style="v" sid="EZR 2:49"/>Usa, Paseah, Besai,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:49"/>
        <verse number="50" style="v" sid="EZR 2:50"/>Asna, Meunim, Nefisi,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:50"/>
        <verse number="51" style="v" sid="EZR 2:51"/>Bakbuk, Hakufa, Harhur,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:51"/>
        <verse number="52" style="v" sid="EZR 2:52"/>Baslut, Mehida, Harsa,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:52"/>
        <verse number="53" style="v" sid="EZR 2:53"/>Barkos, Sisera, Tema,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:53"/>
        <verse number="54" style="v" sid="EZR 2:54"/>Nesia ne Hatifa.</cell>
    </row>
  </table>
  <para style="li4" vid="EZR 2:54">
    <verse eid="EZR 2:54"/>
    <verse number="55" style="v" sid="EZR 2:55"/>Ɔhene Salomo asomfo asefo yi nso fi nnommum mu bae:</para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">Sotai, Hasoferet, Peruda,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:55"/>
        <verse number="56" style="v" sid="EZR 2:56"/>Yaala, Darkon, Gidel,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:56"/>
        <verse number="57" style="v" sid="EZR 2:57"/>Sefatia, Hatil,</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">Pokeret-Hasebaim ne Ami.</cell>
    </row>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse eid="EZR 2:57"/>
        <verse number="58" style="v" sid="EZR 2:58"/>Na asɔredan mu asomfo ne Salomo asomfo asefo no dodow yɛ </cell>
      <cell style="tcr2" align="end">362</cell>
    </row>
  </table>
  <para style="b" vid="EZR 2:58">
    <verse eid="EZR 2:58"/>
  </para>
  <para style="li4">
    <verse number="59" style="v" sid="EZR 2:59"/>Saa bere no, kuw foforo a wofi Tel-Melah, Tel-Harsa, Kerub, Adan ne Imer nkurow so san baa Yerusalem. Nanso wɔantumi ankyerɛ mu sɛ, wɔn anaa wɔn abusuafo yɛ Israel asefo.</para>
  <para style="li4" vid="EZR 2:59">Saa nnipakuw yi ne:<verse eid="EZR 2:59"/></para>
  <table>
    <row style="tr">
      <cell style="tc1" align="start">
        <verse number="60" style="v" sid="EZR 2:60"/>Delaia, Tobia ne Nekoda mmusua a wɔn dodow yɛ </cell>
      <cell style="tcr2" align="end">652</cell>
    </row>
  </table>
  <para style="b" vid="EZR 2:60">
    <verse eid="EZR 2:60"/>
  </para>
  <para style="li4">
    <verse number="61" style="v" sid="EZR 2:61"/>Asɔfo mmusua abiɛsa:</para>
  <para style="li1" vid="EZR 2:61">Habaia, Hakos ne Barsilai no nso san baa Yerusalem. (Saa Barsilai yi, na waware Barsilai a ofi Gilead no mmabea no mu baako a enti na wafa nʼabusua din.)<verse eid="EZR 2:61"/></para>
  <para style="li4">
    <verse number="62" style="v" sid="EZR 2:62"/>Nanso, na wɔayera wɔn anato nhoma no nti wɔmma wɔn ho kwan ansom sɛ asɔfo. <verse eid="EZR 2:62"/><verse number="63" style="v" sid="EZR 2:63"/>Na amrado no mma kwan mma wonnni afɔrebɔ nnuan mu kyɛfa mpo, gye sɛ ɔsɔfo bi wɔ hɔ a ɔnam ntontobɔ kronkron so bisa <char style="nd">Awurade</char>.<verse eid="EZR 2:63"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="64" style="v" sid="EZR 2:64"/>Enti nnipa a wɔsan baa Yuda no nyinaa dodow yɛ mpem aduanan abien, ahaasa ne aduosia (42,360), <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>a asomfo mpem ason ahaasa aduasa ason (7,337) nka ho, ne nnwontofo<note caller="+" style="f"><char style="fr" closed="false">2.65 </char><char style="ft" closed="false">Lewifo nnwontofo no akyi no na nnwontofo foforo bi wɔ hɔ a wɔto nnwom wɔ afahyɛ, aware ne ayi ase.</char></note> ahannu (200) a wɔyɛ mmarima ne mmea. <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>Wɔde apɔnkɔ ahanson aduasa asia (736), mfurum ahannu aduanan anum (245), <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>yoma ahannan aduasa anum (435) ne mfurumpɔnkɔ mpem asia ne ahanson aduonu (6,720) kaa wɔn ho kɔe.<verse eid="EZR 2:67"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>Bere a woduu <char style="nd">Awurade</char> asɔredan no ho wɔ Yerusalem no, abusua ntuanofo no bi fii koma pa mu yii ntoboa a wɔde besiesie <char style="nd">Awurade</char> asɔredan no wɔ ne sibea dedaw mu hɔ. <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>Na ntuanoni biara maa nea obetumi. Akyɛde a wɔde mae no nyinaa ano sii sikakɔkɔɔ sika nnwetɛbona mpem aduosia baako (61,000), dwetɛ nkaribo pɔn mpem ahansia ahannu aduonum (600,250) na asɔfotade ɔha (100) a wɔde bɛma asɔfo.<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>Enti asɔfo, Lewifo, nnwontofo, aponanohwɛfo, asɔredan mu asomfo ne ɔmanmma no bi tenaa nkuraa a ɛbɛn Yerusalem no. Nkae no san kɔɔ Yuda nkurow afoforo bi a wofi hɔ bae no so.<verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s1">Wɔsan Si Afɔremuka No</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>Ɔsram a ɛto so ason mfiase a Israelfo abɔ atenase wɔ wɔn nkurow mu no, nnipa no nyinaa hyiaa sɛ nnipa koro wɔ Yerusalem. <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>Na Yosadak babarima Yesua ne ne mfɛfo asɔfo ne Sealtiel babarima Serubabel ne nʼabusuafo fii ase siesiee Israel Nyankopɔn afɔremuka no, sɛnea wobetumi abɔ ɔhyew afɔre wɔ so, sɛnea wɔahyɛ wɔ Mose a ɔyɛ Onyankopɔn nipa no mmara mu no. <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>Ɛwɔ mu sɛ na nkurɔfo no suro amannifo a wɔtete hɔ no de, nanso wɔsan sii afɔremuka no wɔ ne dedaw mu hɔ. Ɛhɔ ara na wofii ase bɔɔ ɔhyew afɔre maa <char style="nd">Awurade</char>. Wɔyɛɛ saa anɔpa ne anwummere biara. <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>Wodii Asese Afahyɛ no sɛnea wɔakyerɛ wɔ Mose mmara nhoma no mu no, na wɔbɔɔ ɔhyew afɔre, sɛnea afahyɛ da biara de te no. <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>Ɛno akyi no, wɔbɔɔ daa ɔhyew afɔre no ne afɔre a ɛsɛ sɛ wɔbɔ ma Ɔsram Foforo Afahyɛ no ne mfe ahorow afahyɛ de maa <char style="nd">Awurade</char>. Na nnipa no bɔɔ ɔpɛ pa mu afɔre nso de maa <char style="nd">Awurade</char>. <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>Aka nnaawɔtwe abien na Guankɔbea Afahyɛ no adu so no, asɔfo no fii ase bɔɔ ɔhyew afɔre maa <char style="nd">Awurade</char>. Wofii eyi nso ase ansa na wɔreto <char style="nd">Awurade</char> asɔredan no fapem.<verse eid="EZR 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>Na wɔbɔɔ adansifo ne nnuadwumfo paa na wɔtɔɔ sida nnua fi Tirofo ne Sidonfo nkyɛn, na wɔde nnuan, nsa ne ngo tuaa wɔn ka. Wɔde nnua no fi Lebanon mmepɔw so guu po ani baa Yopa, a na ɔhene Kores ama ho kwan.<verse eid="EZR 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8"/>Wofii Onyankopɔn asɔredan no si ase wɔ ɔsram a ɛto so abien mu afe a ɛto so abien fi bere a wokoduu Yerusalem no. Wɔn a wofi asutwa mu bae no nyinaa yɛɛ ho adwumayɛfo a Sealtiel babarima Serubabel, Yosadak babarima Yesua ne ne mfɛfo asɔfo ne Lewifo nyinaa nso ka ho. Lewifo a na wɔadi mfe aduonu ne wɔn a wɔboro saa no na wɔde <char style="nd">Awurade</char> asɔredan no asiesie hyɛɛ wɔn nsa. <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>Yesua ne ne mmabarima ne nʼabusuafo ne Kadmiel ne ne mmabarima ne Hodawia asefo nyinaa na wɔde Onyankopɔn asɔredan ho adwumayɛfo hyɛɛ wɔn nsa sɛ wɔnhwɛ wɔn so. Henadad abusuafo Lewifo na wɔboaa hwɛɛ saa dwumadi yi so.<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>Bere a adansifo no wiee <char style="nd">Awurade</char> asɔredan no fapem no, asɔfo no hyɛɛ wɔn asɔfotade, kɔtenaa wɔn tenabea, hyɛn wɔn ntorobɛnto. Na Asaf asefo Lewifo no bɔɔ wɔn kyɛnkyɛn, de kamfoo <char style="nd">Awurade</char> sɛnea na ɔhene Dawid ahyɛ no pɛpɛɛpɛ. <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>Wɔde nkamfo ne aseda too saa dwom yi maa <char style="nd">Awurade</char> se:</para>
  <para style="q1" vid="EZR 3:11">“Oye,</para>
  <para style="q2" vid="EZR 3:11">Na nʼadɔe wɔ hɔ daa ma Israel afebɔɔ!”</para>
  <para style="m" vid="EZR 3:11">Na ɔmanfo no nyinaa teɛɛ mu ahoɔden so, de kamfoo Awurade, efisɛ <char style="nd">Awurade</char> asɔredan fapem no, wɔato. <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>Asɔfo mpanyimfo no bebree, Lewifo ne ntuanofo no kaee asɔredan a edi kan no, sui bere a wohuu asɔredan foforo no fapem a wɔato no. Na afoforo nso teɛteɛɛ mu anigye so. <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>Anigye nteɛteɛmu ne osu a adi afra no ano yɛɛ den, na nnipa tee wɔ akyirikyiri.<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">Atamfo Sɔre Tia Asɔredan No Asiesie</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>Yuda ne Benyamin<note caller="+" style="f"><char style="fr" closed="false">4.1 </char><char style="ft" closed="false">Na Benyaminfo yɛ Samariafo.</char></note> atamfo no tee sɛ wɔn a wotwaa wɔn asu no resiesie <char style="nd">Awurade</char>, Israel Nyankopɔn, asɔredan no. <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>Enti wɔkɔɔ Serubabel ne ntuanofo no a wɔaka no nkyɛn, na wɔkae se, “Momma yɛne mo nsi, efisɛ yɛsom mo Nyankopɔn sɛnea mosom no no. Efi bere a Asiriahene Esarhadon de yɛn baa ha yi, yɛabɔ afɔre ama no.”<verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>Na Serubabel, Yesua ne Israel ntuanofo bi buae se, “Munni kyɛfa wɔ saa dwuma yi di mu, efisɛ yɛne mo nni hwee yɛ. Yɛn nko ara na yebesi <char style="nd">Awurade</char>, Israel Nyankopɔn, asɔredan no sɛnea Persiahene Kores ahyɛ yɛn no.”<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>Na ɔmanfo no pɛɛ sɛ wobu Yudafo no aba mu na wohunahunaa wɔn wɔ adwuma no yɛ ho. <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>Wɔhyɛɛ ananmusifo bi afono mu sɛ wɔnhaw wɔn na wɔnsɛe wɔn botae no. Eyi kɔɔ so wɔ Persiahene Kores ahenni nyinaa mu kosii bere a Persiahene Dario bedii ahengua no.<verse eid="EZR 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>Bere a Ahasweros dii ade mfe kakraa bi akyi no, Yudafo atamfo kyerɛw no krataa, bɔɔ kwaadu tiaa Yuda ne Yerusalem.<verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>Na ɛno akyi no mpo, Persiahene Artasasta bere so no, Yuda atamfo a Bislam, Mitredat ne Tabeel di anim, kyerɛw krataa wɔ Arameike kasa mu kɔmaa Artasasta, na wɔkyerɛɛ ase kyerɛɛ ɔhene no.<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>Amrado Rehum ne Simsai a ɔyɛ asennii kyerɛwfo kyerɛw krataa kɔkyerɛɛ ɔhene Artasasta sɛnea ɔman Yerusalem mu te.<verse eid="EZR 4:8"/></para>
  <para style="pmo">
    <verse number="9" style="v" sid="EZR 4:9"/>Wokyiaa ɔhene no ma ɛkɔtoo wɔn a wɔne wɔn bɔ, atemmufo ne ɔman no mu ntuanofo, Tarpela manfo, Persiafo, Babelfo ne Elamfo. <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>Wɔsan kyiaa nnipa a wɔaka no a ɔkɛse ne otitiriw Asurbanipa atwa wɔn asu, de wɔn akogu Samaria ne nsase a atwa hɔ ahyia wɔ asu Eufrate atɔe fam no so no.<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>Eyi yɛ krataa a wɔde kɔmaa no no nsɛso:</para>
  <para style="pmo" vid="EZR 4:11">Efi wʼasomfo a wɔwɔ asu Eufrate agya no nkyɛn de kɔma Artasasta:<verse eid="EZR 4:11"/></para>
  <para style="pm">
    <verse number="12" style="v" sid="EZR 4:12"/>Yɛrebɔ wo amanneɛ sɛ, Yudafo a wofi Babilonia baa Yerusalem ha no resiesie atuatewfo ne abɔnefo kurow no. Wɔato afasu no fapem dedaw, na ɛrenkyɛ na wɔawie.<verse eid="EZR 4:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 4:13"/>Na yɛpɛ sɛ wote sɛ, sɛ wosiesie kurow yi ne nʼafasu no wie a, ɛremmoa wo koraa, efisɛ Yudafo no rentua wɔn tow ne aguade biara mma wo. <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>Esiane sɛ yɛyɛ wʼasomfo nokwafo nti, yɛmpɛ sɛ wʼanim begu ase wɔ saa kwan yi so nti na yɛrebɔ wo saa amanneɛ yi. <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>Yɛpɛ sɛ wohwehwɛ wʼagyanom nkrataa mu, hu sɛnea saa kurow yi yɛɛ atuatew kurow tete no. Nokware ni, wɔsɛee no, esiane abakɔsɛm tenten a ɛda hɔ sɛ wɔsɔre tiaa ahemfo ne aman a wɔpɛe sɛ wodi wɔn so no nti. <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>Yɛpae mu ka se, sɛ wosiesie kurow yi na wowie nʼafasu no a, wobɛhwere asu Eufrate agya asase no.<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>Artasasta mmuae ni:</para>
  <para style="pmo" vid="EZR 4:17">Mede krataa yi kɔma amrado Rehum, asennii kyerɛwfo Simsai ne wɔn mfɛfo a wɔte Samaria ne wɔn a wɔwɔ asu Eufrate agya no nyinaa.<verse eid="EZR 4:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 4:18"/>Mikyia mo nyinaa. Krataa a mokyerɛwee no, wɔakyerɛ ase, akenkan akyerɛ me. <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>Mahyɛ sɛ wɔnkɔyɛ nkrataa mu mpɛnsɛnpɛnsɛnmu, na mahu sɛ, ampa ara, mmere bi a atwa mu no, na Yerusalem yɛ atuatewman a etiaa ahemfo bebree a na abantugu yɛ ade a wɔyɛ daa wɔ hɔ. <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>Ahemfo atumfo a adi ade wɔ Yerusalem ne asu Eufrate agya no nyinaa agye tow ne aguade bebree. <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>Ɛno nti, hyɛ na saa nnipa yi nnyae wɔn adwuma. Ɛnsɛ sɛ wosiesie kurow no, gye sɛ mema ho kwan. <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>Monntwentwɛn so koraa, efisɛ ɛnsɛ sɛ yɛma asɛm no gye nsam.<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>Bere a wɔkenkan saa krataa a efi ɔhene Artasasta nkyɛn kyerɛɛ Rehum, Simsai ne wɔn mfɛfo no, wɔyɛɛ ntɛm kɔɔ Yerusalem kɔhyɛɛ Yudafo no ma wogyaee adansi no.<verse eid="EZR 4:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24"/>Wogyaee Onyankopɔn asɔredan a ɛwɔ Yerusalem no ho adwumayɛ, wɔ nea adu hɔ ara, kosii Persiahene Dario ahenni afe a ɛto so abien no so.<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">Serubabel San Besiesie Asɔredan No</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>Saa bere no, adiyifo Hagai ne Ido babarima Sakaria de Israel Nyankopɔn din hyɛɛ nkɔm kyerɛɛ Yudafo a wɔwɔ Yuda ne Yerusalem no. <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>Na Sealtiel babarima Serubabel ne Yosadak babarima Yesua tiei, fitii ase sii Onyankopɔn asɔredan no wɔ Yerusalem. Na Onyankopɔn adiyifo no ka wɔn ho a wɔboaa wɔn.<verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>Saa bere no mu na Tatenai a ɔyɛ amrado wɔ asu Eufrate agya no ne Setar-Bosnai ne wɔn mfɛfo kɔɔ Yerusalem kobisae se, “Hena na ɔmaa mo kwan sɛ munsiesie asɔredan yi?” <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>Wɔsan ka kyerɛɛ wɔn se, wɔmfa nnipa a wɔreyɛ adwuma wɔ asɔredan no ho no nyinaa din mma wɔn. <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>Nanso esiane sɛ na wɔn Nyankopɔn hwɛ wɔn so nti, wɔansiw Yudafo ntuanofo no adansi no ho kwan kosii sɛ wɔde ɛho asɛm kɔdan Dario ma ɔsesaa nʼadwene.<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>Eyi ne krataa a amrado Tatenai, Setar-Bosnai ne mpanyimfo a wɔwɔ asu Eufrate agya no bi kyerɛw kɔmaa ɔhene Dario: <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>Yekyia wo, ɔhene Dario.<verse eid="EZR 5:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 5:8"/>Yɛpɛ sɛ yɛma wo te sɛ, yɛkɔɔ beae a wɔresiesie Onyankopɔn asɔredan no wɔ Yudaman mu no. Abo sononko a wɔasiesie ne nnua na wɔde resi afasu no. Adwuma no rekɔ so ahoɔden so.<verse eid="EZR 5:8"/></para>
  <para style="pm">
    <verse number="9" style="v" sid="EZR 5:9"/>Yebisaa ntuanofo no se, “Hena na ɔmaa mo kwan sɛ munsiesie asɔredan yi?” <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>Na yebisaa wɔn adwumayɛfo din sɛnea yebetumi akyerɛ wo wɔn ntuanofo no.<verse eid="EZR 5:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 5:11"/>Wɔn mmuae ni:</para>
  <para style="b" vid="EZR 5:11"/>
  <para style="pm" vid="EZR 5:11">“Yɛyɛ ɔsorosoro ne asase Nyankopɔn no asomfo, na yɛresan asi asɔredan a ɔhene kɛse bi a na ɔwɔ Israel sii mfe bebree a atwa mu no. <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>Na esiane sɛ yɛn agyanom hyɛɛ ɔsorosoro Nyankopɔn abufuw nti, ogyaa wɔn maa Babiloniahene Nebukadnessar, ma ɔsɛee saa asɔredan yi, na otwaa nkurɔfo no asu kɔɔ Babilonia.<verse eid="EZR 5:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 5:13"/>“Nanso Babiloniahene Kores adedi mu afe a edi kan no, ɔhyɛɛ mmara sɛ, ɛsɛ sɛ wosiesie Onyankopɔn asɔredan no. <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>Ɔhene Kores de sikakɔkɔɔ ne dwetɛ, nkuku ne nkaka a Nebukadnessar tase fii Onyankopɔn asɔredan no mu wɔ Yerusalem de koguu Babilonia asɔredan mu no san bae. Wɔtasee saa nneɛma no fii saa asɔredan no mu de kɔmaa ɔbarima bi a ne din de Sesbasar a ɔhene Kores hyɛɛ no amrado wɔ Yuda no sɛ ɔnhwɛ so. <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>Ɔhene no hyɛɛ no sɛ, ɔnsan mfa nkuku ne nkaka no nsan nkogu wɔn afa wɔ Yerusalem, na ɔnsan nsi Onyankopɔn asɔredan no wɔ faako a na esi kan no.<verse eid="EZR 5:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="EZR 5:16"/>“Enti Sesbasar yi bɛtoo Onyankopɔn asɔredan yi fapem wɔ Yerusalem. Efi saa bere no, nnipa no gu so reyɛ ho adwuma nanso wonwiee ɛ.”<verse eid="EZR 5:16"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="17" style="v" sid="EZR 5:17"/>Enti mprempren, sɛ ɛbɛyɛ ɔhene anisɔ a, monkɔsampam Babilonia ahemfi nneɛma dedaw akorae hɔ nhwɛ sɛ ɔhene Kores anhyɛ mmara sɛ wonsiesie Onyankopɔn asɔredan a ɛwɔ Yerusalem no ana. Na momma ɔhene no nkyerɛ nʼadwene wɔ saa asɛm yi ho.<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">Dario Ma Asɔredansi No Ho Kwan</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>Enti ɔhene Dario hyɛɛ sɛ, wɔnkɔhwehwɛ Babilonia nneɛma dedaw akorae hɔ faako a wɔkora nneɛma a ɛsom bo no. <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>Na Ekbatana aban a ɛwɔ Mediaman no mu hɔ no na wohuu krataa mmobɔwee bi. Na emu nsɛm ni:</para>
  <para style="pmo" vid="EZR 6:2">Amanneɛbɔ krataa:<verse eid="EZR 6:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="EZR 6:3"/>Ɔhene Kores dii ade nʼafe a edi so no, wɔhyɛɛ mmara faa Onyankopɔn asɔredan a ɛwɔ Yerusalem no ho.</para>
  <para style="b" vid="EZR 6:3"/>
  <para style="pm" vid="EZR 6:3">Ɛkae se ɛsɛ sɛ wɔsan si no wɔ beae a na Yudafo bɔ wɔn afɔre hɔ, wɔ fapem dedaw no so. Ɛsɛ sɛ ne sorokɔ yɛ anammɔn aduɔkron, na ne trɛw nso anammɔn aduɔkron. <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>Abo a wɔasiesie no sononko no mmeaso abiɛsa biara so no, ɛsɛ sɛ wɔde nnua gu. Na adehye foto mu na wobefi atua ho ka. <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>Sikakɔkɔɔ ne dwetɛ nkuku ne nkaka a Nebukadnessar tase fii Onyankopɔn asɔredan a esi Yerusalem no mu de kɔɔ Babilonia no, ɛsɛ sɛ wɔsan de kɔ Yerusalem, de kogu Onyankopɔn asɔredan no mu sɛnea na ɛte no.<verse eid="EZR 6:5"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="6" style="v" sid="EZR 6:6"/>Na ɔhene Dario de saa nkra yi somae: Mede krataa yi kɔma amrado Tatenai a ɔwɔ asu Eufrate agya ne Setar-Bosnai ne mo mfɛfo ne mpanyimfo a wɔwɔ Eufrate agya sɛ monnkɔ hɔ. <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>Monnkotwintwan Onyankopɔn asɔredan no si anan mu. Wonsi no wɔ beae dedaw mu hɔ ara, na monntoto Yuda amrado ne Yudafo mpanyimfo anan mu wɔ adwuma no yɛ ho.<verse eid="EZR 6:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 6:8"/>Na mesan hyɛ mo bio sɛ, mommoa saa Yudafo mpanyimfo no wɔ Onyankopɔn asɔredan no si mu.</para>
  <para style="pm" vid="EZR 6:8">Ɛsɛ sɛ mutua adansi no ho ka nyinaa fi tow a mugyigye fi mo man mu a monntwentwɛn so koraa, sɛnea adwuma no yɛ renka. <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>Biribiara a ɛho hia asɔfo a wɔwɔ Yerusalem, sɛ ebia, nantwimma, adwennini ne nguantenmma a wɔde bɛbɔ ɔhyew afɔre ama Onyankopɔn a ɔwɔ ɔsorosoro no, momfa mma wɔn. Afei, momma wɔn atoko, nkyene, nsa ne ngo a ɛho behia wɔn da biara a monnto mu. <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>Sɛ ɛba saa a, wobetumi abɔ afɔre a ɛsɔ ani ama ɔsorosoro Nyankopɔn, na wɔabɔ mpae ama me ne me mmabarima.<verse eid="EZR 6:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 6:11"/>Wɔn a wobebu mmara no so wɔ ɔkwan biara so no, wobeyi wɔn adan so mpuran, na wɔde wɔn abobɔ mu, abɔ wɔn mmaa, ama wɔn afi adwiriw, adan sumina siw. <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>Onyankopɔn a wayi Yerusalem kurow sɛ beae a wɔnhyɛ ne din anuonyam no nsɛe ɔhene anaa ɔman biara a wobebu ne mmara so, asɛe asɔredan no.</para>
  <para style="pm" vid="EZR 6:12">Me Dario na mahyɛ saa mmara yi. Ma ɔmanfo ntie no aso pa mu.<verse eid="EZR 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>Na Tatenai a ɔyɛ asu Eufrate agya amrado ne Setar-Bosnai ne ne mfɛfo dii Dario mmara a ɔhyɛɛ no so prɛko pɛ. <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>Enti Yudafo mpanyimfo toaa wɔn dwumadi no so na asɛm a adiyifo Hagai ne Ido babarima Sakaria kae no hyɛɛ wɔn nkuran. Na wowiee asɔredan no si, sɛnea Israel Nyankopɔn hyɛe na Kores, Dario ne Persiahene Artasasta hyɛɛ mmara no. <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>Wowiee asɔredan no si wɔ Abib (bɛyɛ Ɔbɛnem) da a ɛto so dumien, ɔhene Dario ahenni mfe asia so.<verse eid="EZR 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16"/>Israelfo, asɔfo, Lewifo ne nnipa no nkae a wofi nnommum mu aba no de ahosɛpɛw too Onyankopɔn asɔredan no din. <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>Onyankopɔn asɔredan no dinto afahyɛ no mu no, wɔde nantwimma ɔha, adwennini ahannu ne nguantenmma ahannan bɔɔ afɔre. Na wɔmaa mmirekyi dumien sɛ bɔne ho afɔrebɔde, de gyinaa hɔ maa Israel mmusuakuw dumien no. <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>Na wɔkyekyɛɛ asɔfo ne Lewifo no mu, sɛnea wɔn akuw ahorow te no ma wɔsom wɔ Onyankopɔn asɔredan no mu wɔ Yerusalem, sɛnea wɔakyerɛw wɔ Mose Nhoma mu no.<verse eid="EZR 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>Adar ɔsram (bɛyɛ Oforisuo) da a ɛto so aduonu baako no, wɔn a wofi nnommum mu bae no dii Twam Afahyɛ. <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>Asɔfo no ne Lewifo no dwiraa wɔn ho maa wɔn ho tew maa afahyɛ no. Enti wokum Twam Afahyɛ guamma maa wɔn a wofi nnommum mu bae no nyinaa ne asɔfo a wɔaka ne wɔn ankasa wɔn ho. <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>Nnipa a wɔwɔ Israel a wofi nnommum mu aba no ne nnipa no nkae a wɔwɔ ɔman no mu no a wɔadan afi wɔn amumɔyɛ akwan ho abɛsom <char style="nd">Awurade</char>, Israel Nyankopɔn, no na wodii twam aduan no. <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>Wodii Twam Afahyɛ aduan no, na wɔde nnanson nso dii Apiti Afahyɛ no. Ahosɛpɛw baa ɔman no mmaa nyinaa, efisɛ <char style="nd">Awurade</char> sakraa Asiriahene adwene a ɔwɔ wɔ wɔn ho ma ɔboaa wɔn sii Onyankopɔn, Israel Nyankopɔn, asɔredan no.<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">Ɛsra Kɔ Yerusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>Persiahene Artasasta ahenni mu no, na ɔbarima bi wɔ hɔ a ne din de Ɛsra. Na ɔyɛ Seraia babarima a ɔyɛ Asaria babarima, na ɔno nso yɛ Hilkia babarima <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>na ɔno nso yɛ Salum babarima a ɔyɛ Sadok babarima a ɔyɛ Ahitub babarima <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>na ɔno nso yɛ Amaria babarima a ɔyɛ Asaria babarima na ɔno nso yɛ Meraiot babarima <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>a ɔyɛ Serahia babarima a ɔyɛ Usi babarima a ɔno nso yɛ Buki babarima <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>a ɔno yɛ Abisua babarima, a ɔyɛ Pinehas babarima, a ɔno nso yɛ Eleasar babarima, a ɔyɛ Aaron a ɔyɛ ɔsɔfopanyin no babarima. <verse eid="EZR 7:5"/><verse number="6" style="v" sid="EZR 7:6"/>Na saa Ɛsra yi yɛ mmara no kyerɛkyerɛfo a onim Mose mmara no a <char style="nd">Awurade</char>, Israel Nyankopɔn, de ama Israelfo no yiye. Ofi Babilonia baa Yerusalem na biribiara a obisaa ɔhene no ɔde maa no, efisɛ na <char style="nd">Awurade</char> nsa no wɔ ne so. <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>Israelhene no ne asɔfo, Lewifo, nnwontofo, aponanohwɛfo ne asɔredan mu asomfo ne no kɔɔ Yerusalem, ɔhene Artasasta ahenni mfe ason so.<verse eid="EZR 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 7:8"/>Saa afe no, Ab ɔsram (bɛyɛ Ɔsannaa) mu na Ɛsra kɔɔ Yerusalem. <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>Ofii Babilonia Abib ɔsram (bɛyɛ Oforisuo) da a ɛto so awotwe, na ɔkɔɔ Yerusalem Ab ɔsram (bɛyɛ Ɔsannaa) da a ɛto so anan. Na Onyankopɔn adom nsa wɔ ne so. <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>Efisɛ na Ɛsra asi nʼadwene pi sɛ, obesua, na wadi <char style="nd">Awurade</char> mmara so, na wakyerɛ Israelfo saa mmara no.<verse eid="EZR 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>Na ɔhene Artasasta de krataa no sɛso ama ɔsɔfo Ɛsra, a ɔyɛ mmara no kyerɛkyerɛfo a osuae, na ɔkyerɛɛ Israelfo <char style="nd">Awurade</char> mmara no. Ɔkyerɛw se:<verse eid="EZR 7:11"/></para>
  <para style="pmo">
    <verse number="12" style="v" sid="EZR 7:12"/>Me ahene mu hene Artasasta, nkyia a mede rekyia ɔsɔfo Ɛsra ne <char style="nd">Awurade</char> a ɔte ɔsorosoro no mmarakyerɛni no ni:<verse eid="EZR 7:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 7:13"/>Mahyɛ mmara sɛ, Israelni biara a ɔte mʼaheman mu a asɔfo ne Lewifo ka ho no nyinaa, mfi wɔn pɛ mu ne wo nkɔ Yerusalem. <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>Me ne mʼagyinatufo baason no ahyɛ wo sɛ, gyina wo Nyankopɔn mmara a ɛhyɛ wo nsam no so yɛ nhwehwɛmu fa Yuda ne Yerusalem tebea ho. <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>Fa dwetɛ ne sikakɔkɔɔ bi a yɛde rema wo sɛ afɔre a yɛrebɔ ama Israel Nyankopɔn a ɔte Yerusalem no kɔ, <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>na gye dwetɛ anaa sikakɔkɔɔ biara a wubenya afi Babilonia ne nea wɔde bɛkyɛ wo biara afi ɔmanfo ne asɔfo nkyɛn a wɔde ama sɛ, wɔmfa nkɔ wɔn Nyankopɔn asɔredan a ɛwɔ Yerusalem no kɔ. <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>Saa akyɛde yi, nea ɛsɛ sɛ wɔde tɔ ara yɛ anantwinini, adwennini, nguantenmma ne atoko afɔrebɔde a ɛfata, ne nsa afɔrebɔde a wɔde ne nyinaa bɛbɔ afɔre wɔ Onyankopɔn asɔredan a ɛwɔ Yerusalem no afɔremuka so.<verse eid="EZR 7:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 7:18"/>Sika biara a ɛbɛka no, wo ne wo mfɛfo mfa nni dwuma biara a mugye di sɛ ɛyɛ mo Nyankopɔn pɛ. <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>Na nkuku ne nkaka a yɛde rehyɛ wo nsa de adi mo Nyankopɔn asɔredan no ho dwuma no, fa ne nyinaa ma Onyankopɔn a ɔwɔ Yerusalem no. <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>Sɛ mo sika sa wɔ biribi a ɛho hia mo Onyankopɔn asɔredan ho anaa biribi a ɛte saa ho a, mummisa sika mfi adehye foto mu.<verse eid="EZR 7:20"/></para>
  <para style="pm">
    <verse number="21" style="v" sid="EZR 7:21"/>Me ɔhene Artasasta, hyɛ mmara de kɔ agyapade akorae a ɛwɔ asu Efrate agya no sɛ: Biribiara a Ɛsra bisa no, momfa mma no, efisɛ ɔyɛ ɔsɔfo ne ɔsorosoro Nyankopɔn no mmara kyerɛkyerɛfo. <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>Ɛsɛ sɛ moma no kosi dwetɛ nkaribo pɔn mpem ason ne ahannum, atoko susukoraa ahannum, nsa gyare ahannum aduonum, ngo gyare ahannum aduonum ne nkyene a wontumi mmu ano. <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>Monhwɛ yiye, na biribiara a Onyankopɔn a ɔte ɔsorosoro no abisa ama nʼasɔredan no, momfa mmra. Adɛn nti na ɛsɛ sɛ yɛma Onyankopɔn abufuw ba ɔhene ne ne mmabarima so? <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>Mesan hyɛ sɛ, ɛnsɛ sɛ ɔsɔfo, Lewini, nnwontofo, ɔpon ano hwɛfo, asɔredan mu somfo anaa obiara a ɔyɛ adwuma wɔ asɔredan mu no tua tow biara.<verse eid="EZR 7:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="EZR 7:25"/>Na wo Ɛsra, ɛsɛ sɛ wode nyansa a Onyankopɔn de ama wo no yi asennifo ne atemmufo a wonim mo Nyankopɔn mmara no, na wodi nnipa a wɔwɔ asu Eufrate agya no nyinaa so. Sɛ nnipa nnim saa mmara no a, ɛsɛ sɛ wokyerɛkyerɛ wɔn. <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>Obiara a obebu mo Nyankopɔn, ne ɔhene mmara so no, wobekum no, wobetwa no asu, wɔbɛfa nʼagyapade anaa wɔde no bɛto afiase sɛ asotwe.<note caller="+" style="f"><char style="fr" closed="false">7.26 </char><char style="ft" closed="false"><char style="xt"><ref loc="EZR 7:21-26">7.21-26</ref></char> Wɔkyerɛw saa ɔfa yi wɔ Arameike kasa a saa bere no na wɔde di dwuma no mu.</char></note><verse eid="EZR 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>Ayeyi nka <char style="nd">Awurade</char>, yɛn agyanom Nyankopɔn a ɔmaa ɔhene adwene sɛ onsiesie <char style="nd">Awurade</char> asɔredan a ɛwɔ Yerusalem no. <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>Na ayeyi nka no sɛ, ɔdaa ne dɔ kann adi kyerɛɛ me, hyɛɛ me anuonyam wɔ ɔhene, nʼagyinatufo ne nʼahenemma atumfo no anim. Ɛhyɛɛ me nkuran, efisɛ na <char style="nd">Awurade</char>, me Nyankopɔn, nsa wɔ me so. Na meboaboaa Israel ntuanofo no bi ano sɛ wɔnka me ho mma yɛnkɔ Yerusalem.<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">Nnommum A Wɔne Ɛsra Bae</para>
  <para style="li4">
    <verse number="1" style="v" sid="EZR 8:1"/>Eyinom ne abusua mu ntuanofo ne anato ahorow a ɔhene Artasasta di ade no, wɔne me fi Babilonia bae:<verse eid="EZR 8:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="EZR 8:2"/>Pinehas asefo mu no:</para>
  <para style="li2" vid="EZR 8:2">Gersom;</para>
  <para style="li1" vid="EZR 8:2">Itamar asefo mu no:</para>
  <para style="li2" vid="EZR 8:2">Daniel.</para>
  <para style="li1" vid="EZR 8:2">Dawid asefo mu no:</para>
  <para style="li2" vid="EZR 8:2">Sekania babarima Hatus.<verse eid="EZR 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 8:3"/>Paros asefo mu no:</para>
  <para style="li2" vid="EZR 8:3">Sakaria ne mmarima afoforo bi ɔha aduonum.<verse eid="EZR 8:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 8:4"/>Pahat-Moab asefo mu no:</para>
  <para style="li2" vid="EZR 8:4">Serahia babarima Eliehoenai ne mmarima afoforo bi ahannu.<verse eid="EZR 8:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 8:5"/>Satu asefo mu no:</para>
  <para style="li2" vid="EZR 8:5">Yahasiel babarima Sekania ne mmarima afoforo bi ahaasa.<verse eid="EZR 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 8:6"/>Adin asefo mu no:</para>
  <para style="li2" vid="EZR 8:6">Yonatan babarima Ebed ne mmarima afoforo bi aduonum.<verse eid="EZR 8:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 8:7"/>Elam asefo mu no:</para>
  <para style="li2" vid="EZR 8:7">Yesaia babarima Atalia ne mmarima afoforo bi aduɔson.<verse eid="EZR 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 8:8"/>Sefatia asefo mu no:</para>
  <para style="li2" vid="EZR 8:8">Mikael babarima Sebadia ne mmarima afoforo bi aduɔwɔtwe.<verse eid="EZR 8:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 8:9"/>Yoab asefo mu no:</para>
  <para style="li2" vid="EZR 8:9">Yehiel babarima Obadia ne mmarima afoforo bi ahannu ne dunwɔtwe.<verse eid="EZR 8:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 8:10"/>Bani asefo mu no:</para>
  <para style="li2" vid="EZR 8:10">Yosifia babarima Selomit ne mmarima afoforo bi ɔha aduosia.<verse eid="EZR 8:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 8:11"/>Bebai asefo mu no:</para>
  <para style="li2" vid="EZR 8:11">Bebai babarima Sakaria ne mmarima afoforo bi aduonu awotwe.<verse eid="EZR 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 8:12"/>Asgad asefo mu no:</para>
  <para style="li2" vid="EZR 8:12">Hakatan babarima Yohanan ne mmarima afoforo bi ɔha ne du.<verse eid="EZR 8:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 8:13"/>Adonikam asefo a wotwa to no:</para>
  <para style="li2" vid="EZR 8:13">wɔn din de Elifelet, Yeiel, ne Semaia a, mmarima afoforo bi aduosia ka wɔn ho.<verse eid="EZR 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 8:14"/>Bigwai asefo mu no:</para>
  <para style="li2" vid="EZR 8:14">Utai ne Sakur a mmarima afoforo bi aduɔson ka wɔn ho.<verse eid="EZR 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>Meboaa nnommum no ano wɔ Ahawa nsukwan no so, na yɛma wɔtenaa hɔ nnansa, bere a merehwɛ nnipa no ne asɔfo a wɔabedu hɔ no din mu no, mihuu sɛ Lewifo no mu baako mpo antu ne ho ansi hɔ. <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>Enti mesoma ma wɔkɔfrɛɛ Elieser, Ariel, Semaia, Elnatan, Yarib, Elnatan, Natan, Sakaria ne Mesulam, a wɔyɛ ɔmanfo no ntuanofo no. Mesan soma ma wɔkɔfrɛɛ Yoiarib ne Elnatan, a na wɔyɛ nimdefo no nso; <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>na mema wɔkɔɔ Ido a na otua Lewifo no ano no nkyɛn wɔ Kasifia. Mekyerɛɛ wɔn nea wɔnka nkyerɛ Ido ne nʼabusuafo ne asɔredan no mu asomfo no wɔ Kasifia, sɛnea ɛbɛyɛ a wɔde ahwɛfo bɛbrɛ yɛn wɔ yɛn Nyankopɔn fi. <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>Esiane sɛ Onyankopɔn adom nsa wɔ yɛn so no nti, wɔbrɛɛ yɛn ɔbarima bi a ne din de Serebia, a ne mmabarima ne ne nuabarimanom dunwɔtwe ka ne ho. Na ɔyɛ onyansafo a ɔyɛ Mahli a na ɔyɛ Israel babarima Lewi no aseni, <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>ne Merari asefo Yesaia, Hasabia ne ne mmabarima ne ne nuabarimanom aduonu <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>ne asɔredan no mu asomfo ahannu ne aduonu bae. Na asɔredan mu asomfo no yɛ Lewifo no aboafo a na wɔyɛ asɔredan mu adwumayɛfo kuw bi a Dawid na ɔfaa wɔn kan. Wɔkyerɛw wɔn nyinaa din.<verse eid="EZR 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>Na Ahawa Suka no ho no, mehyɛɛ sɛ yenni mmuada, na yɛmmrɛ yɛn ho ase mma Onyankopɔn. Yɛbɔɔ mpae sɛ ɔbɛma yɛakodu dwoodwoo, na wabɔ yɛn ne yɛn mma ne yɛn nneɛma a yɛde rebetu kwan no ho ban. <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>Na mefɛree sɛ mebisa ɔhene no sɛ ɔmma yɛn asraafo ne apɔnkɔsotefo na wɔnka yɛn ho mmɔ yɛn ho ban wɔ ɔkwan so, efisɛ na yɛaka akyerɛ ɔhene no se, “Yɛn Nyankopɔn bɔ wɔn a wɔsom no no ho ban, na nʼabufuwhyew no tia wɔn a wɔpo no.” <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>Enti yedii mmuada, bɔɔ mpae srɛɛ yɛn Nyankopɔn wɔ eyi ho, na otiee yɛn mpaebɔ.<verse eid="EZR 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>Na miyii asɔfo no ntuanofo dumien a wɔne Serebia, Hasabia ne asɔfo afoforo du a wɔka wɔn ho <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>sɛ wɔnhwɛ dwetɛ, sikakɔkɔɔ, sikakɔkɔɔ hweaseammɔ ne nneɛma a ɛka ho a ɔhene no nʼagyinatufo, ne ntuanofo ne Israelfo de ama Onyankopɔn fi no so. <verse eid="EZR 8:25"/><verse number="26" style="v" sid="EZR 8:26"/>Mede agude no rema wɔn no, mekarii na mihuu sɛ emu duru yɛ: dwetɛ nkaribo tɔn aduonu anan, sikakɔkɔɔ nkuku ne nkaka nkaribo pɔn mpem ahanson ne ahannum, sikakɔkɔɔ nkaribo pɔn mpem ahanson ne ahannum, <verse eid="EZR 8:26"/><verse number="27" style="v" sid="EZR 8:27"/>sikakɔkɔɔ hweaseammɔ aduonu a ɛne sikakɔkɔɔ nnwetɛbona apem bo yɛ pɛ, kɔbere nneɛma abien a wɔabere ho ma ɛrekɔyɛ sɛ sikakɔkɔɔ ankasa.<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>Na meka kyerɛɛ saa asɔfo yi se, “Wɔayi mo ne saa agyapade yi nyinaa asi nkyɛn sɛ ade kronkron ama <char style="nd">Awurade</char>. Saa dwetɛ ne sikakɔkɔɔ yi yɛ koma pa mu afɔrebɔde a wɔde rema <char style="nd">Awurade</char>, yɛn agyanom Nyankopɔn. <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>Monhwɛ saa agyapade yi so yiye, na momfa mma asɔfo mpanyin, Lewifo ne Israel ntuanofo wɔ adekorae a ɛwɔ Yerusalem asɔredan no mu no.” <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>Enti asɔfo no ne Lewifo no gye too wɔn ho so sɛ wɔde saa Onyankopɔn asɔre sika no bɛkɔ Yerusalem.<verse eid="EZR 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>Yefii Ahawa Suka atenae hɔ Ab ɔsram (bɛyɛ Oforisuo) da a ɛto so dunkron, sii mu kɔɔ Yerusalem. Na Onyankopɔn nsa no bɔɔ yɛn ho ban, gyee yɛn fii atamfo ne akwamukafo nsam. <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>Enti yekoduu Yerusalem dwoodwoo, homee wɔ hɔ nnansa.<verse eid="EZR 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33"/>Yeduu no, ne nnaanan so no, wɔkarii dwetɛ, sikakɔkɔɔ ne aboɔdenne a aka no wɔ Onyankopɔn asɔredan no mu, na wɔde hyɛɛ Uria babarima ɔsɔfo Meremot ne Pinehas babarima Eleasar ne Yesua babarima Yosabad ne Binui babarima Noadia a wɔn baanu no yɛ Lewifo no nsa. <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>Wɔkan biribiara dodow, karii mu duru, kyerɛw biribiara.<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>Na wɔn a wofi nnommum mu bae no de anantwi dumien, adwennini aduɔkron asia ne nguantenmma aduɔson ason, bɔɔ ɔhyew afɔre, maa Israel Nyankopɔn. Afei, wɔmaa mmirekyi dumien sɛ bɔne ho afɔrebɔde. Wɔde eyinom nyinaa bae sɛ ɔhyew afɔre maa <char style="nd">Awurade</char>. <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>Wɔde ɔhene no mmara no maa ne mpanyimfo ne amradofo a wɔwɔ asu Eufrate agya no, na wɔn nyinaa yɛɛ baako boaa Onyankopɔn asɔredan no si.<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">Ɛsra Bɔ Ahɔhoware Ho Mpae</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>Na Yudafo ntuanofo no baa me nkyɛn bɛkae se, “Israelfo bebree, na mpo, asɔfo ne Lewifo ntwee wɔn ho mfii nnipa afoforo bi a wɔte asase no so no ho. Wodi akyiwade a na Kanaanfo, Hetifo, Perisifo, Yebusifo, Amonfo, Moabfo, Misraimfo ne Amorifo yɛ no akyi. <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>Na Israelfo mmarima ware fi saa nnipa no mu, na wɔpɛ yerenom fi wɔn mu, ma wɔn mmabarima. Enti ananafo aware no ama nnipa kronkron no ho agu fi. Nea ɛsɛee asɛm no koraa ne sɛ, mpanyimfo ne ntuanofo no koraa na wodi ho fɔ kɛse.”<verse eid="EZR 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3"/>Metee saa asɛm no, misunsuan me ntade mu,<note caller="+" style="f"><char style="fr" closed="false">9.3 </char><char style="ft" closed="false">Ntade mu sunsuan kyerɛ osu ne awerɛhowdi.</char></note> tutuu me tinwi fii me ti so, tutuu mʼabogyesɛ nso, tew tenaa fam ahodwiriw so. <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>Na wɔn a na wonya ayamhyehye wɔ Israel Nyankopɔn asɛm ho no bɛtenaa me nkyɛn wɔ ne nkurɔfo nokware a wɔanni no ho. Metenaa ase ahodwiriw so kosii anwummere afɔrebɔbere.<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>Eduu afɔrebɔbere no, mesɔre gyinaa faako a na mete hɔ awerɛhow mu a masunsuan mʼatade mu no, na mibuu nkotodwe, maa me nsa so kyerɛɛ <char style="nd">Awurade</char>, me Nyankopɔn no. <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>Mebɔɔ mpae se:</para>
  <para style="pm" vid="EZR 9:6">“Me Nyankopɔn, mʼani awu yiye, na mafɛre sɛ merema mʼani so kyerɛ wo. Na yɛn bɔne akɔ soro sen yɛn ti, na yɛn afɔdi adu ɔsorosoro. <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>Yɛn abakɔsɛm nyinaa yɛ bɔne kɛse. Ɛno nti na yɛn ne yɛn ahemfo ne yɛn asɔfo de yɛn ho akɔhyɛ abosonsomfo ahemfo a wɔwɔ asase no so ase no. Wɔakunkum yɛn, wɔakyere yɛn nnommum, wɔabɔ yɛn korɔn, agu yɛn anim ase sɛnea yɛte nnɛ yi<verse eid="EZR 9:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 9:8"/>“Nanso mprempren, <char style="nd">Awurade</char>, yɛn Nyankopɔn, ayɛ yɛn adom ama yɛn mu kakra atena nkwa mu sɛ nkaase. Wabɔ yɛn ho ban wɔ beae kronkron ha. Yɛn Nyankopɔn abue yɛn ani, ama yɛn ahomegye kakra afi yɛn nkoasom mu. <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>Efisɛ na yɛyɛ nkoa, nanso ne dɔ a ɔde dɔ yɛn daa no nti, Onyankopɔn annyaa yɛn wɔ yɛn nkoasom mu. Mmom, ɔmaa Persiahene hwɛɛ yɛn yiye. Ɔkanyan yɛn, sɛnea yebetumi asan asi yɛn Nyankopɔn asɔredan no, asiesie nʼamamfo no. Wama yɛn bammɔ afasu wɔ Yuda ne Yerusalem.<verse eid="EZR 9:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="EZR 9:10"/>“Na mprempren, yɛn Nyankopɔn, asɛm bɛn na yɛwɔ ka wɔ eyinom nyinaa akyi? Efisɛ yɛapo wo mmara nsɛm <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>a wonam wʼasomfo adiyifo no so bɔɔ yɛn kɔkɔ sɛ, ‘Asase a mobɛfa no, nnipa a wɔte so no nam wɔn nneyɛe bɔne so agu ho fi koraa. Porɔwee ahyɛ asase no so ma, fi ti kosi ti. <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>Enti mommma mo mmabea nware wɔn mmabarima, na mo mmabarima nso nware wɔn mmabea, na ɛnsɛ sɛ moboa saa aman no wɔ ɔkwan biara so, na yɛayɛ ɔman kɛse, adi asase no so nnepa, na yɛagyaw ama yɛn mma sɛ daapem agyapade.’<verse eid="EZR 9:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 9:13"/>“Nea ato yɛn yi fi yɛn amumɔyɛsɛm ne yɛn afɔdi. Nanso asotwe a wode ama yɛn no sua koraa sen sɛnea ɛfata yɛn, efisɛ wo <char style="nd">Awurade</char>, yɛn Nyankopɔn ama yɛn mu bi atena sɛ nkaase. <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>Nanso mprempren, yɛresan abu wo mmara nsɛm so, na yɛne wɔn a wɔyɛ saa akyiwade no redi aware. Nokware, wʼabufuw bɛsɛe yɛn ara akosi sɛ, nkaefo kakra no ase bɛtɔre koraa. <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/><char style="nd">Awurade</char>, Israel Nyankopɔn, woyɛ ɔtreneeni. Yɛnka hwee sɛ nkaefo a wɔafi nkoasom mu. Yɛde yɛn afɔdi gyina wʼanim a anka yɛn mu biara rentumi nnyina wʼanim wɔ saa tebea yi mu.”<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">Bɔneka</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>Bere a Ɛsra rebɔ mpae, reka saa bɔne yi no, na ɔresu, de ne ho toto fam wɔ Onyankopɔn Asɔredan no anim, na nnipadɔm a wɔyɛ Israelfo, mmarima, mmea ne mmofra bɛkaa ne ho ne no twaa adwo. <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>Na Yehiel babarima Sekania a ɔyɛ Elam aseni no ka kyerɛɛ Ɛsra se, “Yɛpae mu ka sɛ yɛanni yɛn Nyankopɔn nokware, efisɛ yɛawareware abosonsomfo mmea a wɔwɔ asase no so. Nanso eyi akyi no, anidaso wɔ hɔ ma Israel. <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>Afei, momma yɛne yɛn Nyankopɔn nyɛ apam, na yennyaa yɛn yerenom abosonsomfo no aware, na yɛmpam wɔne wɔn mma. Yebetie afotu a wo ne afoforo a wodi yɛn Nyankopɔn mmara so no de ama yɛn. Yebedi Onyankopɔn mmara no so. <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>Sɔre, na nya akokoduru, efisɛ ɛyɛ wʼasɛde sɛ wokyerɛ yɛn ɔkwan a yɛbɛfa so ama biribiara akɔ so tee, na yɛde yɛn ahoɔden nyinaa bɛboa.”<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>Na Ɛsra sɔre gyinae, na ɔhyɛɛ sɛ asɔfo no ntuanofo, Lewifo ne Israelfo nyinaa nka ntam sɛ wɔbɛyɛ nea Sekania aka no. Na wɔn nyinaa kaa ntam a ano yɛ den. <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>Na Ɛsra sɔre fii Onyankopɔn Asɔredan no anim kɔɔ Eliasib babarima Yehohanan dan mu. Ɔdaa hɔ, nanso wannidi annom. Na ɔda so di awerɛhow esiane nnommum a wɔasan aba no nokware a wɔanni no nti.<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>Afei, wɔbɔɔ dawuru wɔ Yuda ne Yerusalem nyinaa se, nnommum a wɔasan aba no nyinaa mmra Yerusalem. <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>Na wɔn a wɔamma nnansa ntam no, sɛ ntuanofo ne mpanyimfo pɛ a, wɔde wɔn nsa bɛto wɔn agyapade so, na wɔapam wɔn afi wɔn mu.<verse eid="EZR 10:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9"/>Nnansa ntam no, na Yudafo ne Benyaminfo aboa wɔn ho ano wɔ Yerusalem. Asɛm yi sii wɔ Kislev ɔsram (bɛyɛ Ɔpɛnimma) da a ɛto so dunkron, na wɔn nyinaa tenatenaa aguabɔbea hɔ wɔ Onyankopɔn Asɔredan no anim. Na wɔn ho repopo, efisɛ nea edi kan no, na asɛm no mu yɛ duru, na nea ɛto so abien no, na osu nso retɔ. <verse eid="EZR 10:9"/><verse number="10" style="v" sid="EZR 10:10"/>Na ɔsɔfo Ɛsra sɔre gyina kae se, “Moayɛ bɔne, efisɛ moawareware mmea abosonsomfo. Enti mprempren, yɛwɔ afɔbu a ano yɛ den mu sen kan de no. <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>Mompae mu nka mo bɔne nkyerɛ <char style="nd">Awurade</char>, mo agyanom Nyankopɔn, na monyɛ nʼapɛde. Montwe mo ho mfi nnipa a wɔwɔ asase no so ne mmea abosonsomfo no ho.”<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>Afei bagua no nyinaa maa wɔn nne so ka se, “Ampa, wʼasɛm no yɛ nokware. Ɛsɛ sɛ yɛyɛ nea woaka no. <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>Nanso nnipa bebree wɔ ha na ɛyɛ asusow bere, enti yɛrentumi ntena mfikyiri. Bio, yɛrentumi mfa da koro anaa nnaanu nni saa asɛm yi, efisɛ, yɛn mu bebree na saa bɔne kɛse yi ka yɛn. <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>Momma yɛn mpanyimfo nsi yɛn anan nyɛ biribiara. Obiara a ɔware ɔbea bosonsomni no ne ntuanofo ne atemmufo a wɔwɔ kurow yi mu behyia bere a wɔahyɛ no sɛnea ɛbɛyɛ a Onyankopɔn abufuwhyew a ɛfa saa asɛm yi ho no befi yɛn so.” <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>Asahel babarima Yonatan ne Tikwa babarima Yahasia na wotiaa saa asɛm yi mu, na Mesulam ne Sabetai a ɔyɛ Lewini no foaa wɔn so.<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>Enti eyi ne nhyehyɛe a wɔfaa so. Ɛsra yii ntuanofo ma wosii wɔn mmusua no anan, na ɔde din bi too ntuanoni biara so. Ɔsram Kislev (bɛyɛ Ɔpɛnimma) da a ɛto so aduonu akron no, ntuanofo no tenaa ase hwehwɛɛ asɛm no mu. <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>Afe a edi so no mu, Abib ɔsram (bɛyɛ Ɔbɛnem) da a ɛto so aduonu ason no na wɔawie mmarima a wɔawareware mmea abosonsomfo no nyinaa ho asɛnka.<verse eid="EZR 10:17"/></para>
  <para style="li4">
    <verse number="18" style="v" sid="EZR 10:18"/>Asɔfo a na wɔawareware abosonsomfo no din ni:</para>
  <para style="li1" vid="EZR 10:18">Yosadak babarima Yesua ne ne nuabarimanom:</para>
  <para style="li2" vid="EZR 10:18">Maaseia, Elieser, Yarib ne Gedalia. <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>Wɔkaa ntam sɛ wobegyaa wɔn yerenom, wɔn mu biara gyee nʼafɔdi too mu, na wɔde adwennini bɛbɔɔ afɔdi ho afɔre.<verse eid="EZR 10:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 10:20"/>Imer asefo mu no:</para>
  <para style="li2" vid="EZR 10:20">Hanani ne Sebadia.<verse eid="EZR 10:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 10:21"/>Harim asefo mu no:</para>
  <para style="li2" vid="EZR 10:21">Maaseia, Elia, Semaia, Yehiel ne Usia.<verse eid="EZR 10:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 10:22"/>Pashur asefo mu no:</para>
  <para style="li2" vid="EZR 10:22">Elioenai, Maaseia, Ismael, Netanel, Yosabad ne Elasa.<verse eid="EZR 10:22"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="23" style="v" sid="EZR 10:23"/>Eyinom ne Lewifo a na afɔdi da wɔn so:</para>
  <para style="li2" vid="EZR 10:23">Yosabad, Simei, Kelaia, a ɛyɛ Kelita, Petahia, Yuda ne Elieser.<verse eid="EZR 10:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 10:24"/>Nnwontofo a na afɔdi da ne so no yɛ:</para>
  <para style="li2" vid="EZR 10:24">Eliasib.</para>
  <para style="li1" vid="EZR 10:24">Eyinom ne aponanohwɛfo a na afɔdi da wɔn so:</para>
  <para style="li2" vid="EZR 10:24">Salum, Telem ne Uri.<verse eid="EZR 10:24"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="25" style="v" sid="EZR 10:25"/>Eyinom ne nnipa bi a wɔyɛ Israelfo a na afɔdi da wɔn so:</para>
  <para style="li1" vid="EZR 10:25">Paros asefo mu no:</para>
  <para style="li2" vid="EZR 10:25">Ramia, Yisia, Malkia, Miamin, Eleasar, Malkia ne Benaia.<verse eid="EZR 10:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 10:26"/>Elam asefo mu no:</para>
  <para style="li2" vid="EZR 10:26">Matania, Sakaria, Yehiel, Abdi, Yeremot ne Elia.<verse eid="EZR 10:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 10:27"/>Satu asefo mu no:</para>
  <para style="li2" vid="EZR 10:27">Elioenai, Eliasib, Matania, Yeremot, Sabad ne Asisa.<verse eid="EZR 10:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 10:28"/>Bebai asefo mu no:</para>
  <para style="li2" vid="EZR 10:28">Yehohanan, Hanania, Sabai ne Atlai.<verse eid="EZR 10:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 10:29"/>Bani asefo mu no:</para>
  <para style="li2" vid="EZR 10:29">Mesulam, Maluk, Adaia, Yasub, Seal ne Yeremot.<verse eid="EZR 10:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 10:30"/>Pahat-Moab asefo mu no:</para>
  <para style="li2" vid="EZR 10:30">Adna, Kelal, Benaia, Maaseia, Matania, Basaleel, Binui ne Manase.<verse eid="EZR 10:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 10:31"/>Harim asefo mu no:</para>
  <para style="li2" vid="EZR 10:31">Elieser, Yisia, Malkia Semaia ne Simeon. <verse eid="EZR 10:31"/><verse number="32" style="v" sid="EZR 10:32"/>Benyamin, Maluk ne Semaria.<verse eid="EZR 10:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 10:33"/>Hasum asefo mu no:</para>
  <para style="li2" vid="EZR 10:33">Matenai, Matata, Sabad, Elifelet, Yeremai, Manase ne Simei.<verse eid="EZR 10:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 10:34"/>Bani asefo mu no:</para>
  <para style="li2" vid="EZR 10:34">Maadai, Amram ne Uel, <verse eid="EZR 10:34"/><verse number="35" style="v" sid="EZR 10:35"/>Benaia, Bedeia, Keluhi, <verse eid="EZR 10:35"/><verse number="36" style="v" sid="EZR 10:36"/>Wania, Meremot, Eliasib, <verse eid="EZR 10:36"/><verse number="37" style="v" sid="EZR 10:37"/>Matania, Matenai ne Yaasu.<verse eid="EZR 10:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 10:38"/>Binui asefo mu no:</para>
  <para style="li2" vid="EZR 10:38">Simei, <verse eid="EZR 10:38"/><verse number="39" style="v" sid="EZR 10:39"/>Selemia, Natan, Adaia, <verse eid="EZR 10:39"/><verse number="40" style="v" sid="EZR 10:40"/>Maknadebai, Sasai, Sarai, <verse eid="EZR 10:40"/><verse number="41" style="v" sid="EZR 10:41"/>Asarel, Selemia, Semaria, <verse eid="EZR 10:41"/><verse number="42" style="v" sid="EZR 10:42"/>Salum, Amaria ne Yosef.<verse eid="EZR 10:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="EZR 10:43"/>Nebo asefo mu no:</para>
  <para style="li2" vid="EZR 10:43">Yeiel, Matitia, Sabad, Sebina, Yadau, Yoel ne Benaia.<verse eid="EZR 10:43"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="44" style="v" sid="EZR 10:44"/>Na mmarima yi mu biara aware ɔbea bosonsomni a na wɔn mu bi mpo ne wɔn yerenom yi wɔ mma.<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
