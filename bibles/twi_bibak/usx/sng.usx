<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Nnwom Mu Dwom</para>
  <para style="toc1">Nnwom Mu Dwom</para>
  <para style="toc2">Nnwom Mu Dwom</para>
  <para style="toc3">Nmd</para>
  <para style="mt1">Nnwom Mu Dwom</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>Salomo nnwom mu dwom.<verse eid="SNG 1:1"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>Ma ɔmfa nʼano mfewano no mfew mʼano,</para>
  <para style="q2" vid="SNG 1:2">efisɛ wo dɔ no yɛ anigye sen bobesa.<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>Wʼaduhuam yi hua a ɛyɛ anigye;</para>
  <para style="q2" vid="SNG 1:3">wo din te sɛ aduhuam a wɔahwie.</para>
  <para style="q2" vid="SNG 1:3">Na ɛnyɛ nwonwa sɛ mmabaa no dɔ wo!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>Fa me kɔ, ma yɛnyɛ ntɛm!</para>
  <para style="q2" vid="SNG 1:4">Ma ɔhene mfa me nkɔ ne pia mu.</para>
  <para style="sp" vid="SNG 1:4">Nnamfonom:</para>
  <para style="q1" vid="SNG 1:4">Yebedi ahurusi na yɛn ani agye wo ho.</para>
  <para style="q2" vid="SNG 1:4">Yɛbɛkamfo wo dɔ asen bobesa.</para>
  <para style="sp" vid="SNG 1:4">Ababaa:</para>
  <para style="q1" vid="SNG 1:4">Sɛ wɔkamfo wo a, na ne kwan so ara ne no!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>Mibiri de, nanso me ho yɛ fɛ,</para>
  <para style="q2" vid="SNG 1:5">Yerusalem mmabea,</para>
  <para style="q1" vid="SNG 1:5">mobiri te sɛ Kedar ntamadan,</para>
  <para style="q2" vid="SNG 1:5">te sɛ, Salomo ntamadan mu ntwamtam!<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>Nhwɛ me haw sɛ mibiri nti,</para>
  <para style="q2" vid="SNG 1:6">efisɛ owia na ayɛ me saa.</para>
  <para style="q1" vid="SNG 1:6">Me na mmabarima bu fuw me,</para>
  <para style="q2" vid="SNG 1:6">enti wɔma me kɔhwɛɛ bobe nturo so;</para>
  <para style="q2" vid="SNG 1:6">na amma manhwɛ mʼankasa me bobeturo.<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>Kyerɛ me, me dɔfo,</para>
  <para style="q2" vid="SNG 1:7">faako a wode wo nguankuw kɔ adidi</para>
  <para style="q2" vid="SNG 1:7">na owigyinae nso, faako a woma wo nguan home.</para>
  <para style="q1" vid="SNG 1:7">Adɛn nti na ɛsɛ sɛ meyɛ sɛ ɔbea a wakata nʼanim</para>
  <para style="q2" vid="SNG 1:7">wɔ wo nnamfonom nguankuw ho?<verse eid="SNG 1:7"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>Sɛ wunnim a, mmea mu ɔhoɔfɛfo koraa,</para>
  <para style="q2" vid="SNG 1:8">fa ɔkwan a nguan fa so so</para>
  <para style="q1" vid="SNG 1:8">na fa wo mpapomma kɔ adidi</para>
  <para style="q2" vid="SNG 1:8">wɔ nguanhwɛfo no ntamadan ho.<verse eid="SNG 1:8"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>Me dɔfo, mede wo toto ɔpɔnkɔbere</para>
  <para style="q2" vid="SNG 1:9">a wɔde hama asa no wɔ Farao nteaseɛnam baako ho no ho.<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>Asokaa ama wʼafono ho ayɛ fɛ,</para>
  <para style="q2" vid="SNG 1:10">na abohemaa a woasina agu wo kɔn mu no fata wo.<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>Yɛbɛyɛ sikakɔkɔɔ asokaa</para>
  <para style="q2" vid="SNG 1:11">a wɔde dwetɛ asisi mu ama wo.<verse eid="SNG 1:11"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>Bere a ɔhene te ne didipon ho no,</para>
  <para style="q2" vid="SNG 1:12">nʼaduhuam hua no gyee hɔ.<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>Me dɔfo ayɛ me sɛ kurobow<note caller="+" style="f"><char style="fr" closed="false">1.13 </char><char style="ft" closed="false">Kurobow yɛ aduhuam bi a wonya fi “balsam” dua a bi wɔ Etiopia, Ntam Po ne India. Nnipa de yɛ wɔn ho ma wɔn ho yɛ huam.</char></note> toa</para>
  <para style="q2" vid="SNG 1:13">a ɛda me nufu ntam.<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>Me dɔfo ayɛ me sɛ nhwiren boa a ayɛ frɔmfrɔm</para>
  <para style="q2" vid="SNG 1:14">wɔ En-Gedi<note caller="+" style="f"><char style="fr" closed="false">1.14 </char><char style="ft" closed="false">En-Gedi yɛ kwae a ɛwɔ sare so wɔ Nkyene Po atɔe fam a afifide a ɛyɛ huam bebree wɔ.</char></note> bobeturo mu.<verse eid="SNG 1:14"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>Me dɔfo, wo ho yɛ fɛ!</para>
  <para style="q2" vid="SNG 1:15">Ao, ahoɔfɛ ni!</para>
  <para style="q2" vid="SNG 1:15">Wʼaniwa aba te sɛ mmorɔnoma.<verse eid="SNG 1:15"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>Me dɔfo, wo ho yɛ fɛ!</para>
  <para style="q2" vid="SNG 1:16">Ao, ahoɔfɛ ni!</para>
  <para style="q2" vid="SNG 1:16">Yɛn mpa so yɛ akɔnnɔakɔnnɔ.<verse eid="SNG 1:16"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>Yɛn fi mpuran yɛ sida;</para>
  <para style="q2" vid="SNG 1:17">yɛn nsɛmso yɛ ɔpepaw.<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>Meyɛ Saron nhwiren<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false">Yehu Saron nhwiren wɔ Karmel mpoano anafo fam.</char></note></para>
  <para style="q2" vid="SNG 2:1">ne abon mu sukooko.<verse eid="SNG 2:1"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>Sɛnea sukooko a ɛwɔ nsɔe mu te no,</para>
  <para style="q2" vid="SNG 2:2">saa ara na me dɔfo te wɔ mmabaa mu.<verse eid="SNG 2:2"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>Sɛnea aprɛ te wɔ kwae mu nnua mu no,</para>
  <para style="q2" vid="SNG 2:3">saa ara na me dɔfo te wɔ mmerante mu.</para>
  <para style="q1" vid="SNG 2:3">Sɛ metena ne nwini mu a minya ahomeka</para>
  <para style="q2" vid="SNG 2:3">na nʼaba nso yɛ mʼanom dɛ.<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>Ɔde me akɔ aponto ase,</para>
  <para style="q2" vid="SNG 2:4">na mʼagyiraehyɛde yɛ ɔdɔ.<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>Momma me bobe aba na minya ahoɔden,</para>
  <para style="q2" vid="SNG 2:5">momma me aprɛ na ennwudwo me,</para>
  <para style="q2" vid="SNG 2:5">efisɛ ɔdɔ ama matɔ beraw.<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>Ne nsa benkum da mʼatiko,</para>
  <para style="q2" vid="SNG 2:6">na ne nsa nifa aka me afam ne bo.<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>Yerusalem mmabea, mede atwewa</para>
  <para style="q2" vid="SNG 2:7">ne wuram ɔforote hyɛ mo sɛ:</para>
  <para style="q1" vid="SNG 2:7">Monnkanyan na munnyan ɔdɔ</para>
  <para style="q2" vid="SNG 2:7">kosi bere a ɛsɛ mu.<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>Tie! me dɔfo!</para>
  <para style="q2" vid="SNG 2:8">Hwɛ! ɔno na ɔreba no,</para>
  <para style="q1" vid="SNG 2:8">ɔrehuruhuruw wɔ mmepɔw no so</para>
  <para style="q2" vid="SNG 2:8">na ɔbɔ pentenkwa wɔ nkoko no so.<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>Me dɔfo te sɛ ɔtwe anaa ɔforote.</para>
  <para style="q2" vid="SNG 2:9">Hwɛ! ogyina yɛn fasu akyi,</para>
  <para style="q1" vid="SNG 2:9">ɔhwɛ mfɛnsere no mu,</para>
  <para style="q2" vid="SNG 2:9">wagyen nʼani rehwɛ mfɛnsere no mu.<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>Me dɔfo kasa kyerɛɛ me se,</para>
  <para style="q2" vid="SNG 2:10">“Sɔre, me dɔfo ne mʼahoɔfɛ</para>
  <para style="q2" vid="SNG 2:10">na bra me nkyɛn.<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>Hwɛ! awɔwbere atwa mu;</para>
  <para style="q2" vid="SNG 2:11">na asusow atwa mu kɔ.<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>Nhwiren afifi asase ani:</para>
  <para style="q2" vid="SNG 2:12">nnwonto bere aso.</para>
  <para style="q1" vid="SNG 2:12">Wɔte mmorɔnoma su</para>
  <para style="q2" vid="SNG 2:12">wɔ yɛn asase so.<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>Borɔdɔma agu nhwiren;</para>
  <para style="q2" vid="SNG 2:13">na bobe hua agye baabiara.</para>
  <para style="q1" vid="SNG 2:13">Sɔre bra, me dɔfo;</para>
  <para style="q2" vid="SNG 2:13">mʼahoɔfɛ, bra me nkyɛn.”<verse eid="SNG 2:13"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>Mʼaborɔnoma a wohyɛ abotan ntokuru mu,</para>
  <para style="q2" vid="SNG 2:14">ahintaw wɔ mmepɔw so,</para>
  <para style="q1" vid="SNG 2:14">ma minhu wʼanim;</para>
  <para style="q2" vid="SNG 2:14">ma mente wo nne;</para>
  <para style="q1" vid="SNG 2:14">wo nne yɛ dɛ,</para>
  <para style="q2" vid="SNG 2:14">na wʼanim yɛ fɛ.<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>Monkyekyere sakraman no mma yɛn,</para>
  <para style="q2" vid="SNG 2:15">sakraman nketewa no</para>
  <para style="q1" vid="SNG 2:15">a wɔsɛe bobe nturo,</para>
  <para style="q2" vid="SNG 2:15">yɛn bobe nturo a ayɛ frɔmfrɔm no.<verse eid="SNG 2:15"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>Me dɔfo yɛ me dea, na mewɔ no;</para>
  <para style="q2" vid="SNG 2:16">ɔhwehwɛ sukooko no mu.<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>Enkosi sɛ ade bɛkyɛ</para>
  <para style="q2" vid="SNG 2:17">na sunsuma bɛsen akɔ no,</para>
  <para style="q1" vid="SNG 2:17">dan wo ho, me dɔfo,</para>
  <para style="q2" vid="SNG 2:17">na yɛ sɛ ɔtwewa</para>
  <para style="q1" vid="SNG 2:17">anaa ɔforote a</para>
  <para style="q2" vid="SNG 2:17">ɔwɔ nkoko mmonkyi mmonka no so.<verse eid="SNG 2:17"/></para>
  <para style="b"/>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>Anadwo mu nyinaa, wɔ me mpa so</para>
  <para style="q2" vid="SNG 3:1">mehwehwɛɛ nea me koma da no so;</para>
  <para style="q2" vid="SNG 3:1">mehwehwɛɛ no, nanso manhu no.<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>Mɛsɔre afei na makokyinkyin kuropɔn no mu,</para>
  <para style="q2" vid="SNG 3:2">ne mmɔnten so ne gua so;</para>
  <para style="q1" vid="SNG 3:2">na mahwehwɛ nea me koma da no so.</para>
  <para style="q2" vid="SNG 3:2">Enti mehwehwɛɛ no nanso manhu no.<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>Awɛmfo no huu me</para>
  <para style="q2" vid="SNG 3:3">bere a wɔrebɔ aprɔw wɔ kuropɔn no mu.</para>
  <para style="q2" vid="SNG 3:3">“Moahu nea me koma da no so no ana?”<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>Mereyɛ atwa wɔn ho pɛ</para>
  <para style="q2" vid="SNG 3:4">na mihuu nea me koma da no so no.</para>
  <para style="q1" vid="SNG 3:4">Misoo ne nsa sɛ meremma no nkɔ</para>
  <para style="q2" vid="SNG 3:4">kosii sɛ mede no baa me na fi,</para>
  <para style="q2" vid="SNG 3:4">de no kɔɔ nea onyinsɛnee me no dan mu.<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>Yerusalem mmabea, mede atwewa</para>
  <para style="q2" vid="SNG 3:5">ne wuram ɔforote hyɛ mo sɛ</para>
  <para style="q1" vid="SNG 3:5">Monnkanyan na munnyan ɔdɔ</para>
  <para style="q2" vid="SNG 3:5">kosi bere a ɛsɛ mu.<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>Hena na ofi sare so reba</para>
  <para style="q2" vid="SNG 3:6">te sɛ wusiw kumɔnn a</para>
  <para style="q1" vid="SNG 3:6">efi kurobow, aduhuam</para>
  <para style="q2" vid="SNG 3:6">ne aguadifo pɛprɛ ahorow mu, atutu ne ho yi?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>Monhwɛ, ɛyɛ Salomo teaseɛnam a</para>
  <para style="q2" vid="SNG 3:7">akofo aduosia bɔ no kyidɔm;</para>
  <para style="q2" vid="SNG 3:7">ade a ɛwɔ anuonyam pa ara wɔ Israel,<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>Wɔn nyinaa bobɔ afoa,</para>
  <para style="q2" vid="SNG 3:8">wɔn nyinaa wɔ akodi ho nyansa.</para>
  <para style="q1" vid="SNG 3:8">Wɔn afoa bobɔ wɔn nkyɛn mu,</para>
  <para style="q2" vid="SNG 3:8">na obiara asiesie ne ho ama nea ebesi anadwo a ɛyɛ hu biara.<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>Ɔhene Salomo yɛɛ teaseɛnam no maa ne ho;</para>
  <para style="q2" vid="SNG 3:9">ɔde Lebanon nnua na ɛyɛe.<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>Ɔde dwetɛ na ɛyɛɛ nʼadum,</para>
  <para style="q2" vid="SNG 3:10">ɔde sikakɔkɔɔ na ɛyɛɛ ne nnyinaso.</para>
  <para style="q1" vid="SNG 3:10">Wɔde biridum ntama na eduraa mu nkongua ho;</para>
  <para style="q2" vid="SNG 3:10">mu asiesie yɛ ahomeka</para>
  <para style="q1" vid="SNG 3:10">na Yerusalem mmabea na wɔyɛe. <verse eid="SNG 3:10"/><verse number="11" style="v" sid="SNG 3:11"/>Mumfi adi, mo Sion mmabea,</para>
  <para style="q2" vid="SNG 3:11">mommɛhwɛ ɔhene Salomo sɛ ɔhyɛ ahenkyɛw</para>
  <para style="q1" vid="SNG 3:11">nea ne na de hyɛɛ no nʼayeforohyia da no,</para>
  <para style="q2" vid="SNG 3:11">da a odii ahurusi wɔ ne koma mu no.<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>Wo ho yɛ fɛ, me dɔfo!</para>
  <para style="q2" vid="SNG 4:1">Ao, wo ho yɛ fɛ!</para>
  <para style="q2" vid="SNG 4:1">Wʼaniwa a ɛhyehyɛ wo nkataanim mu no te sɛ aborɔnoma.</para>
  <para style="q1" vid="SNG 4:1">Wo nwi te sɛ mpapokuw a</para>
  <para style="q2" vid="SNG 4:1">wɔresian Gilead Bepɔw.<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>Wo se te sɛ nguankuw a wɔatwitwa wɔn ho nwi foforo,</para>
  <para style="q2" vid="SNG 4:2">a wofi aguaree.</para>
  <para style="q1" vid="SNG 4:2">Baako mpo nyeraa ɛ.<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>Wʼanofafa te sɛ koogyan hama;</para>
  <para style="q2" vid="SNG 4:3">wʼano yɛ fɛ.</para>
  <para style="q1" vid="SNG 4:3">Wʼasontɔre a ɛhyɛ wo nkataanim mu</para>
  <para style="q2" vid="SNG 4:3">te sɛ ntunkum aduaba fa.<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>Wo kɔn te sɛ Dawid abantenten,</para>
  <para style="q2" vid="SNG 4:4">a wɔasi no fɛɛfɛ;</para>
  <para style="q1" vid="SNG 4:4">na akokyɛm apem sensɛn ho,</para>
  <para style="q2" vid="SNG 4:4">a ne nyinaa yɛ akofo kyɛm.<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>Wo nufu te sɛ atwemma abien,</para>
  <para style="q2" vid="SNG 4:5">atwemma nta a</para>
  <para style="q2" vid="SNG 4:5">wodidi wɔ sukooko mu.<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>Enkosi sɛ ade bɛkye,</para>
  <para style="q2" vid="SNG 4:6">ama honhom aguan no,</para>
  <para style="q1" vid="SNG 4:6">mɛkɔ kurobow bepɔw</para>
  <para style="q2" vid="SNG 4:6">ne aduhuam nkoko no so.<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>Me dɔfo, wo ho yɛ fɛ papa;</para>
  <para style="q2" vid="SNG 4:7">wo ho nni dɛm biara.<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>Ma yemfi Lebanon, mʼayeforo,</para>
  <para style="q2" vid="SNG 4:8">wo ne me mfi Lebanon nkɔ.</para>
  <para style="q1" vid="SNG 4:8">Sian fi Amana atifi bra,</para>
  <para style="q2" vid="SNG 4:8">fi Senir atifi, Hermon apampam hɔ,</para>
  <para style="q1" vid="SNG 4:8">fi gyata buw mu</para>
  <para style="q2" vid="SNG 4:8">ne mmepɔw a asebɔ dɛɛdɛɛ hɔ.<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>Woagye me koma abɔ so, me nuabea, mʼayeforo;</para>
  <para style="q2" vid="SNG 4:9">woagye me koma abɔ so;</para>
  <para style="q1" vid="SNG 4:9">wode wʼani a ɛbɔɔ me so,</para>
  <para style="q2" vid="SNG 4:9">ne wo kɔnmuade mu ɔbohemaa baako.<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>Wo dɔ yɛ anigye, me nuabea, mʼayeforo!</para>
  <para style="q2" vid="SNG 4:10">Hwɛ, wo dɔ sɔ ani sen bobesa,</para>
  <para style="q2" vid="SNG 4:10">na wʼaduhuam yɛ huam sen pɛprɛ biara.<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>Asɛm dɛdɛ fi wʼano sɛ ɛwokyɛm, mʼayeforo;</para>
  <para style="q2" vid="SNG 4:11">nufusu ne ɛwo wɔ wo tɛkrɛma ase.</para>
  <para style="q2" vid="SNG 4:11">Wo ntade mu hua te sɛ Lebanon de.<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>Wote sɛ turo a wɔato ano pon mu, me nuabea, mʼayeforo;</para>
  <para style="q2" vid="SNG 4:12">woyɛ asuti a wɔagye ho ban, asubura a wɔasɔw ano.<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>Wo nnua yɛ nnuabafuw so ntunkum</para>
  <para style="q2" vid="SNG 4:13">a ɛsow aba pa,</para>
  <para style="q2" vid="SNG 4:13">ahuahaa ne nnuannua,<verse eid="SNG 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14"/>nnuannua ne mmetire,</para>
  <para style="q2" vid="SNG 4:14">osiko ne sinamon,</para>
  <para style="q2" vid="SNG 4:14">a ohuamfufu nnua ahorow,</para>
  <para style="q2" vid="SNG 4:14">kurobow ne dupapo</para>
  <para style="q2" vid="SNG 4:14">ne pɛprɛ papa ahorow nyinaa ka ho.<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>Woyɛ asubura turo,</para>
  <para style="q2" vid="SNG 4:15">abura a nsu sen fi mu</para>
  <para style="q2" vid="SNG 4:15">a ɛsen fi Lebanon.<verse eid="SNG 4:15"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>Sɔre, atifi fam mframa!</para>
  <para style="q2" vid="SNG 4:16">Bra, anafo fam mframa!<note caller="+" style="f"><char style="fr" closed="false">4.16 </char><char style="ft" closed="false">Mframa a ɛbɔ fi atifi fam no mu dwo enti ɛma nnuaba yɛ foforo daa. Mframa a ɛbɔ fi anafo fam no mu yɛ hyew na ɛma nnuaba no bere. Ne abien ka bɔ mu a, ɛma mframa a ɛyɛ huam fa turo no mu.</char></note></para>
  <para style="q1" vid="SNG 4:16">Bɔ fa me turo mu,</para>
  <para style="q2" vid="SNG 4:16">sɛnea ɛbɛyɛ a ne hua no begyigye afa baabiara.</para>
  <para style="q1" vid="SNG 4:16">Ma me dɔfo mmra ne turo mu</para>
  <para style="q2" vid="SNG 4:16">na ɔmmɛka ne nnuaba papa no nhwɛ.<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>Maba me turo mu, me nuabea, mʼayeforo;</para>
  <para style="q2" vid="SNG 5:1">maboaboa me kurobow ne me nnuhuam ano.</para>
  <para style="q1" vid="SNG 5:1">Madi me wokyɛm ne ɛwo;</para>
  <para style="q2" vid="SNG 5:1">manom me bobesa ne me nufusu.</para>
  <para style="sp" vid="SNG 5:1">Nnamfonom:</para>
  <para style="q1" vid="SNG 5:1">Nnamfonom, munnidi na monnom;</para>
  <para style="q2" vid="SNG 5:1">Adɔfonom, monnom nea ɛbɛmee mo dɔ.<verse eid="SNG 5:1"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>Medae, nanso me koma anna.</para>
  <para style="q2" vid="SNG 5:2">Tie! me dɔfo rebɔ pon no mu;</para>
  <para style="q1" vid="SNG 5:2">“Bue me, me nuabea, me dɔ,</para>
  <para style="q2" vid="SNG 5:2">mʼaborɔnoma, a ne ho nni dɛm.</para>
  <para style="q1" vid="SNG 5:2">Obosu afɔw me tirim,</para>
  <para style="q2" vid="SNG 5:2">anadwo mu bosu afɔw me nwi.”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>Maworɔw mʼatade,</para>
  <para style="q2" vid="SNG 5:3">mensan mfa nhyɛ ana?</para>
  <para style="q1" vid="SNG 5:3">Mahohoro mʼanan ase,</para>
  <para style="q2" vid="SNG 5:3">memma ho nyɛ fi bio ana?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>Me dɔfo yɛɛ sɛ ɔrebue pon no</para>
  <para style="q2" vid="SNG 5:4">me koma fii ase bɔɔ kim kim wɔ me mu.<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>Mesɔree sɛ merekobue me dɔfo,</para>
  <para style="q2" vid="SNG 5:5">na me nsa ho kurobow</para>
  <para style="q1" vid="SNG 5:5">ne me nsateaa ho aduhuam,</para>
  <para style="q2" vid="SNG 5:5">yɛɛ korɔkorɔ no nsa ho.<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>Mibue maa me dɔfo no,</para>
  <para style="q2" vid="SNG 5:6">nanso na ɔkɔ.</para>
  <para style="q2" vid="SNG 5:6">Ne kɔ no maa me ho dwiriw me.</para>
  <para style="q1" vid="SNG 5:6">Mehwehwɛɛ no nanso manhu no baabiara.</para>
  <para style="q2" vid="SNG 5:6">Mefrɛɛ no nanso wannye me so.<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>Awɛmfo no huu me</para>
  <para style="q2" vid="SNG 5:7">bere a wɔrebɔ aporɔw wɔ kuropɔn no mu.</para>
  <para style="q1" vid="SNG 5:7">Wɔbobɔɔ me pirapiraa me;</para>
  <para style="q2" vid="SNG 5:7">woyii mʼatade kɔe;</para>
  <para style="q2" vid="SNG 5:7">saa awɛmfo a wɔwɛn afasu no!<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>Yerusalem mmabea, mehyɛ mo,</para>
  <para style="q2" vid="SNG 5:8">sɛ muhu me dɔfo no a,</para>
  <para style="q1" vid="SNG 5:8">asɛm bɛn na mobɛka akyerɛ no?</para>
  <para style="q2" vid="SNG 5:8">Monka nkyerɛ no se ɔdɔ ama matɔ beraw.<verse eid="SNG 5:8"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>Dɛn na wo dɔfo de sen afoforo,</para>
  <para style="q2" vid="SNG 5:9">mmea ahoɔfɛfo mu ahoɔfɛ?</para>
  <para style="q1" vid="SNG 5:9">Dɛn na wo dɔfo de sen afoforo a</para>
  <para style="q2" vid="SNG 5:9">enti wohyɛ yɛn sɛɛ?<verse eid="SNG 5:9"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>Me dɔfo ho twa na ogyigye,</para>
  <para style="q2" vid="SNG 5:10">wɔfa mpem du a, ɔyɛ sononko.<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>Ne ti yɛ sikakɔkɔɔ ankasa;</para>
  <para style="q2" vid="SNG 5:11">ne ti so nwi yɛ kuhaa,</para>
  <para style="q2" vid="SNG 5:11">na ɛyɛ tuntum sɛ kwaakwaadabi.<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>Nʼaniwa aba te sɛ aborɔnoma a</para>
  <para style="q2" vid="SNG 5:12">ogyina asuwa bi ho;</para>
  <para style="q1" vid="SNG 5:12">ɛte sɛ nea wɔde nufusu aguare no,</para>
  <para style="q2" vid="SNG 5:12">na etuatua hɔ sɛ abohemaa.<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>Nʼafono te sɛ pɛprɛ a wɔasɛw no kɛtɛ.</para>
  <para style="q2" vid="SNG 5:13">Ɛho hua te sɛ aduhuam.</para>
  <para style="q1" vid="SNG 5:13">Nʼanofafa te sɛ sukooko</para>
  <para style="q2" vid="SNG 5:13">a ɛsosɔ kurobow.<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>Nʼabasa te sɛ sikakɔkɔɔ abaa</para>
  <para style="q2" vid="SNG 5:14">a wɔde sikabereɛbo asisi mu.</para>
  <para style="q1" vid="SNG 5:14">Ne nipadua te sɛ asonse a wɔatwiw ho</para>
  <para style="q2" vid="SNG 5:14">na wɔde hoabo adura ho.<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>Nʼanan te sɛ abohemaa afadum a</para>
  <para style="q2" vid="SNG 5:15">esisi sikakɔkɔɔ ankasa nnyinaso so.</para>
  <para style="q1" vid="SNG 5:15">Ne bɔbea te sɛ Lebanon a</para>
  <para style="q2" vid="SNG 5:15">ɔyɛ sononko sɛ ne sida.<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>Nʼano te sɛ ɔdɛ ankasa;</para>
  <para style="q2" vid="SNG 5:16">ɔkwan biara so, ne ho yɛ fɛ.</para>
  <para style="q1" vid="SNG 5:16">Me dɔfo ni, mʼadamfo ni,</para>
  <para style="q2" vid="SNG 5:16">Yerusalem mmabea.<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>Ɛhe na wo dɔfo no kɔ</para>
  <para style="q2" vid="SNG 6:1">mmea ahoɔfɛfo mu ahoɔfɛ?</para>
  <para style="q1" vid="SNG 6:1">Ɛhe na wo dɔfo man fae,</para>
  <para style="q2" vid="SNG 6:1">na yɛne wo nkɔhwehwɛ no?<verse eid="SNG 6:1"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>Me dɔfo kɔ ne turo mu,</para>
  <para style="q2" vid="SNG 6:2">faako a woduadua nnua ahorow,</para>
  <para style="q1" vid="SNG 6:2">okokyinkyin turo no mu</para>
  <para style="q2" vid="SNG 6:2">akɔboaboa sukooko ano.<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>Me dɔfo yɛ me de, na me nso meyɛ ne de;</para>
  <para style="q2" vid="SNG 6:3">okyinkyin sukooko no mu.<verse eid="SNG 6:3"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>Me dɔfo, wo ho yɛ fɛ te sɛ Tirsa,<note caller="+" style="f"><char style="fr" closed="false">6.4 </char><char style="ft" closed="false">Tirsa yɛ Kanaan tete kurow bi a Yeroboam de yɛɛ nʼahenkurow wɔ afe 930 AWK (ansa na wɔrewo Kristo) kosi afe 909 AWK wɔ atifi fam ahemman mu.</char></note></para>
  <para style="q2" vid="SNG 6:4">wʼahoɔfɛ te sɛ Yerusalem,</para>
  <para style="q2" vid="SNG 6:4">wusi pi te sɛ asraafo a wɔretu frankaa.<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>Nhwɛ me saa;</para>
  <para style="q2" vid="SNG 6:5">wobunkam me so.</para>
  <para style="q1" vid="SNG 6:5">Wo ti nwi te sɛ mpapokuw a</para>
  <para style="q2" vid="SNG 6:5">wɔresian afi Gilead.<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>Wo se te sɛ nguankuw a wɔatwitwa wɔn ho nwi foforo,</para>
  <para style="q2" vid="SNG 6:6">a wofi aguaree.</para>
  <para style="q1" vid="SNG 6:6">Baako mpo nyeraa ɛ.<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>Wʼasontɔre a ɛhyɛ wo nkataanim mu</para>
  <para style="q2" vid="SNG 6:7">te sɛ ntunkum aduaba fa.<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>Ebia na ɔyerenom yɛ aduosia,</para>
  <para style="q2" vid="SNG 6:8">mpenanom bɛyɛ aduɔwɔtwe,</para>
  <para style="q2" vid="SNG 6:8">ne mmabaa dodow a wontumi nkan wɔn;<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>nanso mʼaborɔnoma a ne ho nni asɛm yɛ sononko;</para>
  <para style="q2" vid="SNG 6:9">ɔno nko ara ne ne na babea,</para>
  <para style="q2" vid="SNG 6:9">ɔno na nea ɔwoo no no pɛ nʼasɛm.</para>
  <para style="q1" vid="SNG 6:9">Mmabaa huu no no, wɔfrɛɛ no nhyira;</para>
  <para style="q2" vid="SNG 6:9">ahemmea ne mpenanom kamfoo no.<verse eid="SNG 6:9"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>Hena na wapue sɛ ahemadakye yi,</para>
  <para style="q2" vid="SNG 6:10">ɔyɛ frɔmfrɔm sɛ ɔsram, na ɔhyerɛn sɛ owia,</para>
  <para style="q2" vid="SNG 6:10">nʼanuonyam te sɛ nsoromma a wɔsa so.<verse eid="SNG 6:10"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>Misian kɔɔ nnuaba pɔw mu hɔ</para>
  <para style="q2" vid="SNG 6:11">sɛ merekɔhwehwɛ afifide foforo a ɛwɔ obon no mu,</para>
  <para style="q1" vid="SNG 6:11">sɛ bobe no agu nhwiren,</para>
  <para style="q2" vid="SNG 6:11">anaasɛ ntunkum no ayɛ frɔmfrɔm.<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>Mʼani baa me ho so no</para>
  <para style="q2" vid="SNG 6:12">na mʼadwene de me abesi me nkurɔfo adehye nteaseɛnam so.<verse eid="SNG 6:12"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>San wʼakyi, san wʼakyi, Sulamit babea;</para>
  <para style="q2" vid="SNG 6:13">San bra, san bra ma yɛnhwɛ wo!</para>
  <para style="sp" vid="SNG 6:13">Aberante:</para>
  <para style="q1" vid="SNG 6:13">Adɛn nti na ɛsɛ sɛ mohwɛ Sulamit abeawa</para>
  <para style="q2" vid="SNG 6:13">sɛnea mohwɛ Mahanaim asaw no?<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>Wo nan ne mpaboa yɛ fɛ,</para>
  <para style="q2" vid="SNG 7:1">Ɔdehye babea!</para>
  <para style="q1" vid="SNG 7:1">Wʼanantu a wugyina so te sɛ abohemaa,</para>
  <para style="q2" vid="SNG 7:1">odwumfo nsa ano adwuma.<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>Wo funuma yɛ kuruwa a enni nsa</para>
  <para style="q2" vid="SNG 7:2">a nsa pa wɔ mu bere biara.</para>
  <para style="q1" vid="SNG 7:2">Wo sisi yɛ atoko a wɔaboa ano</para>
  <para style="q2" vid="SNG 7:2">na sukooko atwa ho ahyia.<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>Wo nufu te sɛ atwemma abien,</para>
  <para style="q2" vid="SNG 7:3">atwemma nta.<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>Wo kɔn te sɛ asonse abantenten.</para>
  <para style="q1" vid="SNG 7:4">Wʼaniwa aba te sɛ Hesbon ntade</para>
  <para style="q2" vid="SNG 7:4">a ɛwɔ Bat Rabim pon nkyɛn.</para>
  <para style="q1" vid="SNG 7:4">Wo hwene te sɛ Lebanon abantenten</para>
  <para style="q2" vid="SNG 7:4">a ɛkyerɛ Damasko no.<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>Wo ti si so sɛ Karmel Bepɔw.</para>
  <para style="q2" vid="SNG 7:5">Wo tinwi te sɛ adehyetam a wɔadi mu adwinni;</para>
  <para style="q2" vid="SNG 7:5">wo tinwi atenten no kyere ɔhene dommum.<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>Wo ho yɛ fɛ, ɔdɔ,</para>
  <para style="q2" vid="SNG 7:6">wo ho yɛ anigye na ɛma ahomeka ara!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>Wo sibea te sɛ abɛ dua,</para>
  <para style="q2" vid="SNG 7:7">na wo nufu te sɛ aduaba kasiaw.<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>Mekae se, “Mɛforo abɛ dua no;</para>
  <para style="q2" vid="SNG 7:8">na maso nʼaba mu.”</para>
  <para style="q1" vid="SNG 7:8">Wo nufu nyɛ sɛ bobe kasiaw,</para>
  <para style="q2" vid="SNG 7:8">na wo home mu hua nyɛ sɛ aprɛ.<verse eid="SNG 7:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9"/>Na wʼanom hua nyɛ sɛ bobesa papa.</para>
  <para style="sp" vid="SNG 7:9">Ababaa:</para>
  <para style="q1" vid="SNG 7:9">Ma bobesa no nkɔ me dɔfo hɔ tee,</para>
  <para style="q2" vid="SNG 7:9">ɛnsen mfa nʼanofafa ne ne se no so brɛoo.<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>Meyɛ me dɔfo de,</para>
  <para style="q2" vid="SNG 7:10">na nʼapɛde ne me.<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>Bra, me dɔfo; ma yɛnkɔ akuraa,</para>
  <para style="q2" vid="SNG 7:11">ma yɛnkɔda akuraa anadwo baako.<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>Ma yɛnkɔ bobeturo mu ntɛm</para>
  <para style="q2" vid="SNG 7:12">nkɔhwɛ sɛ bobe no agu nhwiren,</para>
  <para style="q1" vid="SNG 7:12">sɛ nhwiren no apaapae,</para>
  <para style="q2" vid="SNG 7:12">anaasɛ ntunkum no ayɛ frɔmfrɔm.</para>
  <para style="q2" vid="SNG 7:12">Ɛhɔ na mede me dɔ bɛma wo.<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>Adesaa yi ne hua,</para>
  <para style="q2" vid="SNG 7:13">na akɔnnɔduan nyinaa begu yɛn pon ano,</para>
  <para style="q1" vid="SNG 7:13">foforo ne dedaw,</para>
  <para style="q2" vid="SNG 7:13">a mede asie ama wo, me dɔfo.<verse eid="SNG 7:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>Sɛ anka woyɛɛ me nuabarima</para>
  <para style="q2" vid="SNG 8:1">a wunum me na nufu ano,</para>
  <para style="q1" vid="SNG 8:1">na mihuu wo wɔ abɔnten so a,</para>
  <para style="q2" vid="SNG 8:1">anka mefew wʼano,</para>
  <para style="q2" vid="SNG 8:1">a obiara rentumi mmu me animtiaa.<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>Anka medi wʼanim</para>
  <para style="q2" vid="SNG 8:2">na mede wo aba me na fi,</para>
  <para style="q2" vid="SNG 8:2">ɔno a wakyerɛkyerɛ me.</para>
  <para style="q1" vid="SNG 8:2">Anka mɛma wo bobesa a wɔde pɛprɛ afra mu,</para>
  <para style="q2" vid="SNG 8:2">me ntunkum mu nsu dɔkɔdɔkɔ no bi.<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>Ne nsa benkum da mʼatiko</para>
  <para style="q2" vid="SNG 8:3">na ne nsa nifa aka me afam ne bo.<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>Yerusalem mmabea, mehyɛ mo sɛ,</para>
  <para style="q2" vid="SNG 8:4">morennyan na morenhwanyan ɔdɔ mu</para>
  <para style="q2" vid="SNG 8:4">kosi bere a ɛsɛ mu.<verse eid="SNG 8:4"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>Hena na ofi sare so reba a</para>
  <para style="q2" vid="SNG 8:5">otweri ne dɔfo koko mu yi?</para>
  <para style="sp" vid="SNG 8:5">Ababaa:</para>
  <para style="q1" vid="SNG 8:5">Mekanyan wo wɔ aprɛ dua no ase;</para>
  <para style="q2" vid="SNG 8:5">ɛhɔ na wo na nyinsɛnee wo,</para>
  <para style="q2" vid="SNG 8:5">ɛhɔ na nea ɔkoo awo no woo wo.<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>Fa me to wo koma so sɛ nsɔwanode,</para>
  <para style="q2" vid="SNG 8:6">sɛ nsɔwanode wɔ wʼabasa so,</para>
  <para style="q1" vid="SNG 8:6">efisɛ ɔdɔ ano yɛ den sɛ owu,</para>
  <para style="q2" vid="SNG 8:6">ne ninkutwe tim hɔ sɛ ɔda.</para>
  <para style="q1" vid="SNG 8:6">Ɛhyehye sɛ ogyatannaa,</para>
  <para style="q2" vid="SNG 8:6">sɛ ogyatannaa a ano yɛ den pa ara.<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>Nsu dodow rentumi nnum ɔdɔ;</para>
  <para style="q2" vid="SNG 8:7">nsubɔnten rentumi nhohoro nkɔ.</para>
  <para style="q1" vid="SNG 8:7">Sɛ obi de ne fi ahonya nyinaa bɛsesa ɔdɔ a</para>
  <para style="q2" vid="SNG 8:7">anka wɔremmu no ade a ɛsom bo.<verse eid="SNG 8:7"/></para>
  <para style="sp">Nnamfonom:</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>Yɛwɔ nuabea akumaa bi a,</para>
  <para style="q2" vid="SNG 8:8">ne nufu mmobɔɔ ɛ.</para>
  <para style="q1" vid="SNG 8:8">Dɛn na yɛbɛyɛ ama yɛn nuabea yi</para>
  <para style="q2" vid="SNG 8:8">wɔ da a wobebisa no ase?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>Sɛ ɔyɛ ɔfasu a,</para>
  <para style="q2" vid="SNG 8:9">yebesi dwetɛ abantenten abɔ ne ho ban.</para>
  <para style="q1" vid="SNG 8:9">Sɛ ɔyɛ ɔpon a,</para>
  <para style="q2" vid="SNG 8:9">yɛde sida besiw ne pon ano kwan.<verse eid="SNG 8:9"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>Meyɛ ɔfasu,</para>
  <para style="q2" vid="SNG 8:10">na me nufu te sɛ abantenten.</para>
  <para style="q1" vid="SNG 8:10">Enti nʼani so no mayɛ sɛ obi a</para>
  <para style="q2" vid="SNG 8:10">ɔde nea ɛsɔ ani reba.<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>Na Salomo wɔ bobeturo wɔ Baal-Hamon;</para>
  <para style="q2" vid="SNG 8:11">ɔde ne bobeturo no maa apaafo.</para>
  <para style="q1" vid="SNG 8:11">Na ɛsɛ sɛ wɔn mu biara tua no</para>
  <para style="q2" vid="SNG 8:11">nnwetɛbona apem.<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>Nanso me bobeturo yi yɛ me de.</para>
  <para style="q2" vid="SNG 8:12">Me de, meremfa mma;</para>
  <para style="q2" vid="SNG 8:12">Salomo de ne de gye nnwetɛbona apem,</para>
  <para style="q2" vid="SNG 8:12">na otua nʼapaafo nnwetɛbona ahannu ma wɔhwɛ ne nnuaba no so.<verse eid="SNG 8:12"/></para>
  <para style="sp">Aberante:</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>Wo a wote turo no mu</para>
  <para style="q2" vid="SNG 8:13">ne nnamfonom a wɔka wo ho,</para>
  <para style="q2" vid="SNG 8:13">ma mente wo nne.<verse eid="SNG 8:13"/></para>
  <para style="sp">Ababaa:</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>Bra ma yɛnkɔ, me dɔfo,</para>
  <para style="q2" vid="SNG 8:14">na yɛ wo ho sɛ ɔdabɔ ba</para>
  <para style="q1" vid="SNG 8:14">anaasɛ ɔforote ba a</para>
  <para style="q2" vid="SNG 8:14">ɔwɔ mmepɔw a nnuhuam ahyɛ so ma so.<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
