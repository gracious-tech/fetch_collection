<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Mmebusɛm</para>
  <para style="toc1">Mmebusɛm</para>
  <para style="toc2">Mmebusɛm</para>
  <para style="toc3">Mmb</para>
  <para style="mt1">Mmebusɛm</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s1">Botae Ne Nsɛmpɔw</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>Dawid babarima Salomo, Israelhene, mmebusɛm ni:<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>Ne botae ne sɛ ɛbɛkyerɛ nnipa nyansa ne ahohyɛso;</para>
  <para style="q2" vid="PRO 1:2">ne sɛ ɛbɛboa ama wɔate nsɛm a emu dɔ ase;<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>sɛ wobenya akwankyerɛ wɔ abrabɔ pa mu,</para>
  <para style="q2" vid="PRO 1:3">a ɛbɛma wɔayɛ ade pa, nea ɛteɛ na ho nni asɛm;<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>sɛ ɛbɛma nea nʼadwene mu nnɔ anya nyansa</para>
  <para style="q2" vid="PRO 1:4">na mmabun anya nimdeɛ ne adwene,<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>anyansafo ntie na wɔmfa nka nea wonim ho,</para>
  <para style="q2" vid="PRO 1:5">na nea ɔwɔ nhumu nya akwankyerɛ a<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>ɛbɛma wate mmɛ ne kasammebu,</para>
  <para style="q2" vid="PRO 1:6">anyansafo nsɛnka ne abisaa ase.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>
    <char style="nd">Awurade</char> suro yɛ nimdeɛ mfiase,</para>
  <para style="q2" vid="PRO 1:7">na nkwaseafo bu nyansa ne ahohyɛso animtiaa.<verse eid="PRO 1:7"/></para>
  <para style="ms1">Nyansapɛ Ho Afotusɛm</para>
  <para style="s1">Nnaadaa Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Me ba, tie wʼagya akwankyerɛ</para>
  <para style="q2" vid="PRO 1:8">na mpo wo na nkyerɛkyerɛ.<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>Ɛbɛyɛ wo ti anuonyam abotiri</para>
  <para style="q2" vid="PRO 1:9">ne wo kɔn mu atweaban.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Me ba, sɛ nnebɔneyɛfo twetwe wo a,</para>
  <para style="q2" vid="PRO 1:10">mma wɔn ho kwan.<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Sɛ wɔka se, “Bra ma yɛnkɔ;</para>
  <para style="q2" vid="PRO 1:11">ma yɛnkɔtetɛw na yenkum obi,</para>
  <para style="q2" vid="PRO 1:11">ma yɛnkɔtɛw ntwɛn mmɔborɔni bi;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ma yɛmmemene wɔn anikann sɛ ɔda,</para>
  <para style="q2" vid="PRO 1:12">koraa, te sɛ wɔn a wɔkɔ ɔda mu;<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>yebenya nneɛma a ɛsom bo ahorow</para>
  <para style="q2" vid="PRO 1:13">na yɛde asade ahyɛ yɛn afi ma;<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>fa wo ho bɛhyɛ mu,</para>
  <para style="q2" vid="PRO 1:14">na wubenya wo kyɛfa wɔ ahonyade no mu.”<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>Me ba, wo ne wɔn nnantew,</para>
  <para style="q2" vid="PRO 1:15">mfa wo nan nsi wɔn akwan so;<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>Wɔn anan de ntɛmpɛ kɔ bɔne mu,</para>
  <para style="q2" vid="PRO 1:16">na wɔde ahoɔhare ka mogya gu.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>So nni mfaso sɛ obi besum nnomaafiri</para>
  <para style="q2" vid="PRO 1:17">wɔ beae a anomaa biara hu!<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>Saa nnipa yi tetɛw pɛ wɔn ankasa mogya;</para>
  <para style="q2" vid="PRO 1:18">wɔtetɛw wɔn ankasa wɔn ho!<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Saa na wɔn a wodi akorɔnne akyi no awiei te;</para>
  <para style="q2" vid="PRO 1:19">ɛma wɔhwere wɔn nkwa!<verse eid="PRO 1:19"/></para>
  <para style="s1">Nyansa A Wɔpo Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>Nyansa teɛ mu wɔ mmɔnten so,</para>
  <para style="q2" vid="PRO 1:20">ɔma ne nne so wɔ aguabɔbea,<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>ɔteɛ mu wɔ afasu no atifi,</para>
  <para style="q2" vid="PRO 1:21">ɔkasa wɔ kuropɔn no apon ano se,<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“Mo adwenharefo, mobɛyɛ adwenhare akosi da bɛn?</para>
  <para style="q2" vid="PRO 1:22">Fɛwdifo bedi fɛw akosi da bɛn?</para>
  <para style="q2" vid="PRO 1:22">Nkwaseafo bekyi nimdeɛ akosi da bɛn?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Sɛ mutiee mʼanimka a,</para>
  <para style="q2" vid="PRO 1:23">anka mekaa me koma mu nsɛm nyinaa kyerɛɛ mo</para>
  <para style="q2" vid="PRO 1:23">ma muhuu me nsusuwii.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>Nanso sɛ muyii mo aso, bere a mefrɛɛ mo</para>
  <para style="q2" vid="PRO 1:24">na amfa obiara ho, bere a meteɛɛ me nsa mu,<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>sɛ mopoo mʼafotu,</para>
  <para style="q2" vid="PRO 1:25">na moampɛ mʼanimka nti,<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>me nso mɛserew mo wɔ mo amanehunu mu;</para>
  <para style="q2" vid="PRO 1:26">sɛ abɛbrɛsɛ bi bu fa mo so a, midi mo ho fɛw,<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>sɛ abɛbrɛsɛ bi bu fa mo so te sɛ ahum,</para>
  <para style="q2" vid="PRO 1:27">na amanehunu bi bɔ fa mo so sɛ mfɛtɛ,</para>
  <para style="q2" vid="PRO 1:27">na awerɛhow ne ɔhaw mene mo a,<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>“Afei wɔbɛfrɛ me, nanso meremmua;</para>
  <para style="q2" vid="PRO 1:28">wɔbɛhwehwɛ me, nanso wɔrenhu me.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>Esiane sɛ wokyii nimdeɛ</para>
  <para style="q2" vid="PRO 1:29">na wɔampɛ sɛ wobesuro <char style="nd">Awurade</char>,<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>sɛ wɔpoo mʼafotu,</para>
  <para style="q1" vid="PRO 1:30">na wobuu me nteɛso animtiaa nti,<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>wobedi wɔn akwan so aba;</para>
  <para style="q2" vid="PRO 1:31">na wɔn nhyehyɛe mu aduan bɛmee wɔn.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Na ntetekwaafo asoɔden bekum wɔn,</para>
  <para style="q2" vid="PRO 1:32">na nkwaseafo tirimudɛ bɛsɛe wɔn;<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>Nanso obiara a obetie me no, ɔbɛtena ase asomdwoe mu</para>
  <para style="q1" vid="PRO 1:33">na ne ho bɛtɔ no a ɔrensuro ɔhaw biara.”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Nyansa So Mfaso Wɔ Abrabɔ Mu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Me ba, sɛ wutie me nsɛm,</para>
  <para style="q2" vid="PRO 2:1">na woma me mmaransɛm tena wo mu a,<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>sɛ wowɛn wʼaso ma nyansa</para>
  <para style="q2" vid="PRO 2:2">na wode wo koma ma ntease,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>na woma wo nne so frɛ nhumu</para>
  <para style="q2" vid="PRO 2:3">na wusu frɛ ntease,<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>na sɛ wohwehwɛ no te sɛnea wohwehwɛ dwetɛ</para>
  <para style="q2" vid="PRO 2:4">na wohwehwɛ no sɛnea worepɛ ademude a ahintaw a,<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>ɛno na wobɛte <char style="nd">Awurade</char> suro ase</para>
  <para style="q2" vid="PRO 2:5">na woahu Onyankopɔn ho nimdeɛ.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>
    <char style="nd">Awurade</char> ma nimdeɛ,</para>
  <para style="q2" vid="PRO 2:6">na nʼanom na nyansa ne ntease fi ba.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>Ɔkora nkonimdi ma wɔn a wɔteɛ,</para>
  <para style="q2" vid="PRO 2:7">ɔyɛ kyɛm ma wɔn a wɔn akwan yɛ pɛ,<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>ɔwɛn nea ɔyɛ pɛ kwan,</para>
  <para style="q2" vid="PRO 2:8">na ɔbɔ wɔn a wodi no nokware no akwan ho ban.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Ɛno na wobɛte nea eye ne nea ɛyɛ pɛ,</para>
  <para style="q2" vid="PRO 2:9">ne nea ɛfata, ɔkwan biara a eye ase.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Afei nyansa bewura wo koma mu,</para>
  <para style="q2" vid="PRO 2:10">na nimdeɛ ayɛ ahomeka ama wo kra.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>Adwene bɛbɔ wo ho ban</para>
  <para style="q2" vid="PRO 2:11">na ntease ahwɛ wo so.<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>Nyansa beyi wo afi amumɔyɛfo akwan mu,</para>
  <para style="q2" vid="PRO 2:12">ebeyi wo afi nnipa a wɔn nsɛm yɛ basabasa nsam,<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>wɔn a wɔaman afi akwan pa so</para>
  <para style="q2" vid="PRO 2:13">akɔnantew sum akwan so no,<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>wɔn a wɔn ani gye bɔneyɛ ho,</para>
  <para style="q2" vid="PRO 2:14">na wodi ahurusi wɔ bɔne mu basabasayɛ ho,<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>wɔn a wɔn akwan yɛ kɔntɔnkye</para>
  <para style="q2" vid="PRO 2:15">na wɔyɛ abonsam wɔ wɔn akwan mu.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Nimdeɛ begye wo afi ɔbea waresɛefo no nsam,</para>
  <para style="q2" vid="PRO 2:16">afi ɔbea warefo huhuni a ɔka nnaadaasɛm ho,<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>nea wagyaa ne mmabaabere mu kunu</para>
  <para style="q2" vid="PRO 2:17">na wapo apam a ɔyɛɛ wɔ Onyankopɔn anim no.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>Ne fi yɛ ɔkwan a ɛkɔ owu mu</para>
  <para style="q2" vid="PRO 2:18">na nʼakwan kɔ awufo honhom nkyɛn.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Obiara a ɔkɔ ne nkyɛn no nsan mma</para>
  <para style="q2" vid="PRO 2:19">anaasɛ ɔrensi nkwa akwan so.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>Enti wubedi nnipa pa anammɔn akyi</para>
  <para style="q2" vid="PRO 2:20">na woanantew atreneefo akwan so.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Efisɛ wɔn a wɔteɛ bɛtena asase no so,</para>
  <para style="q2" vid="PRO 2:21">na wɔn a asɛm nni wɔn ho no na wɔbɛka hɔ;<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>na wobetwa amumɔyɛfo afi asase no so,</para>
  <para style="q1" vid="PRO 2:22">na wɔatɔre atorofo ase.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Nyansa De Yiyedi Ba</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Me ba, mma wo werɛ mfi me nkyerɛkyerɛ,</para>
  <para style="q2" vid="PRO 3:1">kora me mmara wɔ wo koma mu,<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>na ɛbɛma wo nkwa aware, mfe bebree</para>
  <para style="q2" vid="PRO 3:2">na ɛde yiyedi abrɛ wo.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Mma adɔe ne nokware mmfi wo nkyɛn</para>
  <para style="q2" vid="PRO 3:3">fa yan wo kɔn mu</para>
  <para style="q2" vid="PRO 3:3">kyerɛw gu wo koma pon so.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Na wubenya adom ne din pa</para>
  <para style="q2" vid="PRO 3:4">wɔ Onyankopɔn ne nnipa anim.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>Fa wo koma nyinaa to <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PRO 3:5">na mfa wo ho nto wʼankasa ntease so;<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>hu no wʼakwan nyinaa mu,</para>
  <para style="q2" vid="PRO 3:6">na ɔbɛteɛ wʼakwan.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>Nnye wo ho nni sɛ woyɛ onyansafo;</para>
  <para style="q2" vid="PRO 3:7">suro <char style="nd">Awurade</char> na kyi bɔne.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Ɛde ahoɔden bɛbrɛ wo nipadua,</para>
  <para style="q2" vid="PRO 3:8">na ayɛ aduan ama wo nnompe.<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>Fa wʼahonya hyɛ <char style="nd">Awurade</char> anuonyam,</para>
  <para style="q2" vid="PRO 3:9">ne wo nnɔbae a edi kan nyinaa;<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>na ɛno na ɛbɛma wo pata ayɛ ma abu so,</para>
  <para style="q2" vid="PRO 3:10">na nsa foforo abu afa wʼahina so.<verse eid="PRO 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>Me ba, sɛ <char style="nd">Awurade</char> teɛ wo so a, tie no yiye,</para>
  <para style="q2" vid="PRO 3:11">na mmu nʼanimka so,<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>Efisɛ, obiara a <char style="nd">Awurade</char> pɛ nʼasɛm no, ɔtwe nʼaso,</para>
  <para style="q2" vid="PRO 3:12">sɛnea agya teɛ ɔba a ɔdɔ no no.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>Nhyira nka onipa a ohu nyansa,</para>
  <para style="q2" vid="PRO 3:13">onipa a onya ntease,<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>efisɛ, nimdeɛ so mfaso sen dwetɛ,</para>
  <para style="q2" vid="PRO 3:14">na nea efi mu ba sen sikakɔkɔɔ.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Ne bo yɛ den sen bota;</para>
  <para style="q2" vid="PRO 3:15">na worentumi mfa wʼapɛde biara ntoto no ho.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Nkwa tenten wɔ ne nsa nifa mu;</para>
  <para style="q2" vid="PRO 3:16">ahonyade ne anuonyam wɔ ne nsa benkum mu.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Nʼakwan yɛ ahomeka,</para>
  <para style="q2" vid="PRO 3:17">na nʼanammɔnkwan nyinaa yɛ asomdwoe.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>Ɔyɛ nkwadua ma wɔn a woso ne mu;</para>
  <para style="q2" vid="PRO 3:18">wɔn a wokura no mu no benya nhyira.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>Nyansa mu na <char style="nd">Awurade</char> yɛɛ asase fapem,</para>
  <para style="q2" vid="PRO 3:19">na ntease mu na ɔde ɔsoro tim hɔ.<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>Efi ne nimdeɛ mu na ɔkyekyɛɛ ebun mu,</para>
  <para style="q2" vid="PRO 3:20">na omununkum nso tɔɔ obosu.<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>Me ba, fa atemmu pa ne nhumu sie,</para>
  <para style="q2" vid="PRO 3:21">na mma emfi wʼani so;<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>ɛbɛyɛ nkwa ama wo,</para>
  <para style="q2" vid="PRO 3:22">nnwinne a ɛma wo kɔn anuonyam wie pɛyɛ.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Afei wo kwan so bɛyɛ wo dwoodwoo,</para>
  <para style="q2" vid="PRO 3:23">na wo nan renhintiw;<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>sɛ woda a worensuro;</para>
  <para style="q2" vid="PRO 3:24">sɛ woda a wʼani bekum.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Nsuro mpofirim amanehunu</para>
  <para style="q2" vid="PRO 3:25">anaa ɔsɛe a ɛba amumɔyɛfo so,<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>efisɛ <char style="nd">Awurade</char> bɛwɔ wʼafa</para>
  <para style="q2" vid="PRO 3:26">na ɔbɛkora wo nan afi afiri mu.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>Mfa ade pa nkame wɔn a wɔfata,</para>
  <para style="q2" vid="PRO 3:27">bere a tumi wɔ wo nsam.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Nka nkyerɛ wo yɔnko se:</para>
  <para style="q2" vid="PRO 3:28">“Kɔ na bra; mede bɛma wo ɔkyena”</para>
  <para style="q2" vid="PRO 3:28">wɔ bere a wowɔ no saa bere no.<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>Mpam ɔhaw mma wo yɔnko</para>
  <para style="q2" vid="PRO 3:29">bere a ɔne wo te yiye.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Mmɔ obi sobo kwa</para>
  <para style="q2" vid="PRO 3:30">bere a ɔnyɛɛ wo bɔne biara ɛ.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>Mma wʼani mmere basabasayɛfo,</para>
  <para style="q2" vid="PRO 3:31">na mfa nʼakwan no mu biara,<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>efisɛ <char style="nd">Awurade</char> kyi basabasayɛfo</para>
  <para style="q2" vid="PRO 3:32">na ɔde ne werɛ hyɛ ɔtreneeni mu.<verse eid="PRO 3:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>
    <char style="nd">Awurade</char> nnome wɔ omumɔyɛfo fi so,</para>
  <para style="q2" vid="PRO 3:33">na ohyira ɔtreneeni fi.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>Odi fɛwdifo a wɔyɛ ahantan no ho fɛw,</para>
  <para style="q2" vid="PRO 3:34">na ɔdom ahobrɛasefo ne wɔn a wɔhyɛ wɔn so no.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>Anyansafo benya anuonyam adi,</para>
  <para style="q1" vid="PRO 3:35">nanso nkwaseafo de, ɔma wɔn anim gu ase.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Pere Hwehwɛ Nyansa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Me mma, muntie me, muntie agya nkyerɛkyerɛ;</para>
  <para style="q2" vid="PRO 4:1">monyɛ aso na moanya ntease.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Mema mo adesua a ɛkɔ anim,</para>
  <para style="q2" vid="PRO 4:2">enti munnnyaa me nkyerɛkyerɛ mu.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Efisɛ na me nso, meyɛ mʼagya babarima,</para>
  <para style="q2" vid="PRO 4:3">meda so yɛ akokoaa no, na me na ani gye me ho.<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>Na ɔkyerɛkyerɛɛ me se,</para>
  <para style="q2" vid="PRO 4:4">“Ma me nsɛm nni wo koma mu dɛm,</para>
  <para style="q2" vid="PRO 4:4">di me nkyerɛkyerɛ so na wubenya nkwa.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Nya nyansa, nya ntease;</para>
  <para style="q2" vid="PRO 4:5">mma wo werɛ mfi me nsɛm anaa ntwe wo ho mfi ho.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Nnyaw nyansa hɔ, na ɛbɛbɔ wo ho ban;</para>
  <para style="q2" vid="PRO 4:6">dɔ no, na ɛbɛhwɛ wo so.<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Nyansa boro biribiara so; enti hwehwɛ nyansa.</para>
  <para style="q2" vid="PRO 4:7">Ɛwɔ mu sɛ ne bo te sɛ wʼahode nyinaa de, nanso nya ntease.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>Di no ni na ɛbɛma wo so;</para>
  <para style="q2" vid="PRO 4:8">yɛ no atuu, na ɛbɛhyɛ wo anuonyam.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Ɔde nkonimdi nhwiren hankare begu wo ti so</para>
  <para style="q2" vid="PRO 4:9">na wama wo ahenkyɛw a ɛyɛ fɛ.”<verse eid="PRO 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Me ba, tie na fa nea meka no,</para>
  <para style="q2" vid="PRO 4:10">na wo nkwanna bɛyɛ bebree.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Mɛkyerɛ wo nyansa kwan so</para>
  <para style="q2" vid="PRO 4:11">na mede wo afa akwan a ɛteɛ so.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Sɛ wonantew a, wʼanammɔntu bɛkɔ waa</para>
  <para style="q2" vid="PRO 4:12">na sɛ wutu mmirika a, worenhintiw.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>Di nkyerɛkyerɛ so; na nnyaa mu,</para>
  <para style="q2" vid="PRO 4:13">bɔ ho ban yiye, efisɛ ɛyɛ wo nkwa.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>Ntu wo nan nsi amumɔyɛfo kwan so</para>
  <para style="q2" vid="PRO 4:14">na nnantew abɔnefo kwan so.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Kwati no, ntu kwan mfa so;</para>
  <para style="q2" vid="PRO 4:15">dan fi so na kɔ wo kwan.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Efisɛ wɔnyɛɛ bɔne a wontumi nna;</para>
  <para style="q2" vid="PRO 4:16">na wɔn nna tew yera kosi sɛ wɔbɛma obi ahwe ase.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Wodi amumɔyɛsɛm brodo,</para>
  <para style="q2" vid="PRO 4:17">na wɔnom kitikitiyɛ nsa.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Atreneefo kwan te sɛ adekyee hann a edi kan,</para>
  <para style="q2" vid="PRO 4:18">ɛkɔ so hyerɛn yiye kodu awia ketee.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>Nanso amumɔyɛfo kwan te sɛ sum kabii;</para>
  <para style="q2" vid="PRO 4:19">wonnim nea ɛma wohintiw.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Me ba, yɛ aso ma nea meka;</para>
  <para style="q2" vid="PRO 4:20">tie me nsɛm no yiye.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>Mma emfi wʼani so,</para>
  <para style="q2" vid="PRO 4:21">fa sie wo koma mu;<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>efisɛ, ɛyɛ nkwa ma wɔn a wohu</para>
  <para style="q2" vid="PRO 4:22">ne akwahosan ma nipadua no nyinaa.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>Ne nyinaa akyi, bɔ wo koma ho ban,</para>
  <para style="q2" vid="PRO 4:23">efisɛ, ɛno ne wo nkwa asuti.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Mma oburu kasa mfi wʼano;</para>
  <para style="q2" vid="PRO 4:24">mma nkontomposɛm mmɛn wʼano koraa.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Hwɛ wʼanim tee,</para>
  <para style="q2" vid="PRO 4:25">na ma wʼani nkɔ nea ɛwɔ wʼanim no so.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>Bɔ ɔkwan tamaa ma wʼanan</para>
  <para style="q2" vid="PRO 4:26">na fa akwan a atim so.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>Mman mfa nifa anaa benkum;</para>
  <para style="q2" vid="PRO 4:27">twe wo nan fi bɔne ho.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Aguamammɔ Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Me ba, yɛ aso ma me nyansa;</para>
  <para style="q2" vid="PRO 5:1">tie me nhumu nsɛm no yiye,<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>sɛnea ɛbɛma woahwɛ yiye,</para>
  <para style="q2" vid="PRO 5:2">na wʼano akora nimdeɛ.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Efisɛ ɔbea aguaman ano sosɔ ɛwo,</para>
  <para style="q2" vid="PRO 5:3">na ne kasa yɛ fɔmm sen ngo;<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>nanso awiei no, ɛyɛ nwen sen bɔnwoma,</para>
  <para style="q2" vid="PRO 5:4">ɛyɛ nam sɛ afoa anofanu.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Nʼanan kɔ owu mu;</para>
  <para style="q2" vid="PRO 5:5">nʼanammɔntutu kɔ ɔda mu tee.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Onsusuw ɔkwan a ɛkɔ nkwa mu ho;</para>
  <para style="q2" vid="PRO 5:6">nʼakwan yɛ kɔntɔnkye, nanso onnim.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Enti afei, me mma, muntie me;</para>
  <para style="q2" vid="PRO 5:7">Monntwe mo ho mmfi nea meka ho.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Ɔkwan a ɛmmɛn no no na momfa so;</para>
  <para style="q2" vid="PRO 5:8">mommmɛn ne fi pon ano,<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>anyɛ saa a, mode mo ahoɔden bɛma afoforo</para>
  <para style="q2" vid="PRO 5:9">na mode mo mfe ama otirimɔdenfo,<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>anyɛ saa a, ahɔho bɛfom mo ahonyade</para>
  <para style="q2" vid="PRO 5:10">na mo brɛ de ahonya akɔ afoforo fi.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>Mo nkwanna akyi, mubesi apini,</para>
  <para style="q2" vid="PRO 5:11">bere a mo honam ne mo nipadua asa no.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>Na moaka se, “Na mikyi ahohyɛso!</para>
  <para style="q2" vid="PRO 5:12">Me koma ampɛ nteɛso!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>Manyɛ osetie amma mʼakyerɛkyerɛfo</para>
  <para style="q2" vid="PRO 5:13">na mantie me kwankyerɛfo asɛm.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Madu ɔsɛe ano</para>
  <para style="q2" vid="PRO 5:14">wɔ asafo no nyinaa mu.”<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Nom nsu fi wʼankasa ahina mu,</para>
  <para style="q2" vid="PRO 5:15">nsu a ɛteɛ fi wʼankasa abura mu.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>So ɛsɛ sɛ wʼasuti yiri fa mmɔnten so</para>
  <para style="q2" vid="PRO 5:16">na wo nsuwa kokɔ ɔman aguabɔbea ana?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Ma ɛnyɛ wo nko ara de,</para>
  <para style="q2" vid="PRO 5:17">a wo ne ahɔho nkyɛ da.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Nhyira nka wʼasubura</para>
  <para style="q2" vid="PRO 5:18">na wʼani nnye wo mmrantebere mu yere ho.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Ɔte sɛ ɔtwe bere dɔfo, ɔwansan nuonyamfo;</para>
  <para style="q2" vid="PRO 5:19">ma ne nufu nsɔ wʼani daa</para>
  <para style="q2" vid="PRO 5:19">na ne dɔ nkyekyere wo.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Me ba, adɛn nti na woma ɔbea aguaman kyekyere wo?</para>
  <para style="q2" vid="PRO 5:20">Adɛn nti na woda ɔbarima foforo bi yere kokom?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>
    <char style="nd">Awurade</char> hu onipa akwan nyinaa,</para>
  <para style="q2" vid="PRO 5:21">na ɔhwehwɛ ne nyinaa mu.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>Omumɔyɛfo nnebɔne sum no afiri;</para>
  <para style="q2" vid="PRO 5:22">na ne bɔne ahama kyekyere no papee.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Wobewu, esiane ahohyɛso a wonni nti,</para>
  <para style="q2" vid="PRO 5:23">na wɔayera, esiane wɔn agyennyentwisɛm nti.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Agyimisɛm Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Me ba, sɛ woadi akagyinamu ama ɔyɔnko bi,</para>
  <para style="q2" vid="PRO 6:1">sɛ wode wo biribi asi awowa ama obi,<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>sɛ nea wokae ayi ka ama wo</para>
  <para style="q2" vid="PRO 6:2">na sɛ wʼano asɛm afiri ayi wo a,<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>ɛno de yɛ eyi, me ba, na fa tetew wo ho,</para>
  <para style="q2" vid="PRO 6:3">sɛ ɔyɔnko nsa aka wo no nti:</para>
  <para style="q1" vid="PRO 6:3">fa ahobrɛase kɔ nʼanim;</para>
  <para style="q2" vid="PRO 6:3">na kɔ so pa wo yɔnko no kyɛw!<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Mma wʼani nkum</para>
  <para style="q2" vid="PRO 6:4">na ntɔ nko.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>Gye wo ho, sɛnea ɔforote guan fi ɔbɔmmɔfo nsam</para>
  <para style="q2" vid="PRO 6:5">anaa sɛnea anomaa guan fi ofirisumfo afiri mu no.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>Ɔkwadwofo, kɔ ɔtɛtea nkyɛn;</para>
  <para style="q2" vid="PRO 6:6">hwɛ nʼakwan, na hu nyansa!<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Onni ɔsahene,</para>
  <para style="q2" vid="PRO 6:7">onni ɔhwɛfo anaa sodifo bi,<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>nanso ɔde aduan sie wɔ ahuhurubere mu,</para>
  <para style="q2" vid="PRO 6:8">ɔboaboa nnuan ano wɔ twabere.<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>Wo, ɔkwadwofo, wobɛda akosi da bɛn?</para>
  <para style="q2" vid="PRO 6:9">Wubenyan bere bɛn?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>Nna kakra, nkotɔ kakra,</para>
  <para style="q2" vid="PRO 6:10">nsa a woabobɔw de rehome kakra,<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>ɛbɛma ohia aba wo so sɛ ɔkwanmukafo</para>
  <para style="q2" vid="PRO 6:11">na ahokyere atow akyere wo sɛnea okura otuo.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Onipa teta ne ohuhuni a</para>
  <para style="q2" vid="PRO 6:12">odi atoro kyin,<verse eid="PRO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13"/>nea obu nʼani,</para>
  <para style="q2" vid="PRO 6:13">na ɔde ne nan yɛ nsɛnkyerɛnne</para>
  <para style="q2" vid="PRO 6:13">na ɔde ne nsateaa kyerɛkyerɛ ade,<verse eid="PRO 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14"/>nea ɔde ne koma mu nnaadaa bɔ pɔw bɔne,</para>
  <para style="q2" vid="PRO 6:14">na ɔde mpaapaemu ba bere biara.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Ɛno nti amanehunu bɛba no so prɛko pɛ;</para>
  <para style="q2" vid="PRO 6:15">wɔbɛsɛe no mpofirim, a wɔrenya ano aduru.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16"/>Nneɛma asia na <char style="nd">Awurade</char> mpɛ,</para>
  <para style="li2" vid="PRO 6:16">nneɛma ason na ɛyɛ nʼakyiwade:<verse eid="PRO 6:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17"/>ani a ɛtra ntɔn,</para>
  <para style="li3" vid="PRO 6:17">atoro tɛkrɛma,</para>
  <para style="li3" vid="PRO 6:17">nsa a ɛka mogya a edi bem gu,<verse eid="PRO 6:17"/></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18"/>koma a edwen amumɔyɛ ho,</para>
  <para style="li3" vid="PRO 6:18">anan a etutu mmirika kɔyɛ bɔne,<verse eid="PRO 6:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19"/>ɔdansekurumni a odi atoro</para>
  <para style="li3" vid="PRO 6:19">ne onipa a ɔde mpaapaemu ba anuanom mu.<verse eid="PRO 6:19"/></para>
  <para style="s1">Aguamammɔ Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>Me ba, tie wʼagya ahyɛde</para>
  <para style="q2" vid="PRO 6:20">na nnyaa wo na nkyerɛkyerɛ mu.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>Fa kyekyere wo koma ho daa;</para>
  <para style="q2" vid="PRO 6:21">na fa kyekyere wɔ kɔn mu.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Wonantew a, ɛbɛkyerɛ wo kwan;</para>
  <para style="q2" vid="PRO 6:22">sɛ woda a, ɛbɛwɛn wo;</para>
  <para style="q2" vid="PRO 6:22">sɛ wunyan a, ɛbɛkasa akyerɛ wo.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Na saa ahyɛde yi yɛ kanea</para>
  <para style="q2" vid="PRO 6:23">saa nkyerɛkyerɛ yi yɛ hann,</para>
  <para style="q1" vid="PRO 6:23">na ahohyɛso nteɛso yi</para>
  <para style="q2" vid="PRO 6:23">yɛ nkwa kwan,<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>ɛtwe wo fi ɔbea a onni suban pa no ho,</para>
  <para style="q2" vid="PRO 6:24">fi ɔbeawarefo huhuni tɛkrɛmadɛ ho.<verse eid="PRO 6:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>Mma wo kɔn nnɔ nʼahoɔfɛ,</para>
  <para style="q2" vid="PRO 6:25">mma nʼani akyideda no ntwetwe wo,<verse eid="PRO 6:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>efisɛ oguamanfo ma wʼanuonyam yɛ sɛ brodosin,</para>
  <para style="q2" vid="PRO 6:26">na obi yere gyigye wo kɔ owu mu.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Obi betumi asɔ gya agu ne srɛ so a</para>
  <para style="q2" vid="PRO 6:27">nhyew nʼatade ana?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Obi betumi anantew nnyansramma so a</para>
  <para style="q2" vid="PRO 6:28">mpumpunnya mmobɔ nʼanan ho ana?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Saa na ɔbarima a ɔne ɔbarima foforo yere da no te;</para>
  <para style="q2" vid="PRO 6:29">obiara a ɔde ne nsa bɛka no no, remfa ne ho nni da.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Nnipa mmu ɔkorɔmfo a wakowia ade animtiaa</para>
  <para style="q2" vid="PRO 6:30">sɛ ɔkɔm de no na ɔde rekodwudwo ano nti.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>Mmom, sɛ wɔkyere no a, ɛsɛ sɛ otua mmɔho ason;</para>
  <para style="q2" vid="PRO 6:31">sɛ ɛbɛma wahwere ne fi agyapade nyinaa mpo a.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>Ɔbarima a ɔsɛe aware no nni adwene;</para>
  <para style="q2" vid="PRO 6:32">obiara a ɔyɛ saa no sɛe ne ho.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>Ɔhwe ne animguase na obenya,</para>
  <para style="q2" vid="PRO 6:33">na nʼahohora rempepa da.<verse eid="PRO 6:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>Ninkutwe hwanyan okunu abufuw</para>
  <para style="q2" vid="PRO 6:34">na sɛ ɔtɔ were a, ahummɔbɔ biara nni mu.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Ɔrennye mpata biara;</para>
  <para style="q2" vid="PRO 6:35">na ɔbɛpo adanmude, sɛ ɛso sɛ dɛn mpo a.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">Ɔbeawaresɛefo Ho Kɔkɔbɔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Me ba, fa me nsɛm sie</para>
  <para style="q2" vid="PRO 7:1">na kora mʼahyɛde wɔ wo mu.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Di mʼahyɛde so na wubenya nkwa;</para>
  <para style="q2" vid="PRO 7:2">bɔ me nkyerɛkyerɛ ho ban sɛ nea wodɔ no.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>Kyekyere bɔ wo nsateaa ho;</para>
  <para style="q2" vid="PRO 7:3">kyerɛw no yiye gu wo koma pon so.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Ka kyerɛ nyansa se, “Woyɛ me nuabea,”</para>
  <para style="q2" vid="PRO 7:4">na frɛ ntease wo busuani;<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>Wɔbɛtwe wo afi ɔbeawaresɛefo ho,</para>
  <para style="q2" vid="PRO 7:5">afi ɔbeawarefo huhuni nsɛmmɔdɛ ho.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Me fi mfɛnsere ano,</para>
  <para style="q2" vid="PRO 7:6">mede mʼani faa mfɛnsere mu.<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>Mihuu wɔ ntetekwaafo mu,</para>
  <para style="q2" vid="PRO 7:7">mehyɛɛ mmerante no mu baako nsow,</para>
  <para style="q2" vid="PRO 7:7">ɔbabun a onni adwene.<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>Na ɔnam borɔn a ɛbɛn ɔbea no fi so</para>
  <para style="q2" vid="PRO 7:8">a nʼani kyerɛ ɔbea no fi<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>bere a onwini redwo,</para>
  <para style="q2" vid="PRO 7:9">na anim rebiribiri no.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Afei ɔbea bi fi behyiaa no a</para>
  <para style="q2" vid="PRO 7:10">wasiesie ne ho sɛ oguamanfo a nnaadaa wɔ ne koma mu.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>(Ɔyɛ hyirenn na hwee mfa ne ho,</para>
  <para style="q2" vid="PRO 7:11">ɔntena fie koraa;<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>nnɛ wohu no mmɔnten so, ɔkyena na ɔte aguabɔbea,</para>
  <para style="q2" vid="PRO 7:12">ɔtetɛw wɔ mmantwea mmantwea.)<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>Osoo ne mu few nʼano,</para>
  <para style="q2" vid="PRO 7:13">wamfɛre, na ɔkae se,<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“Mewɔ asomdwoe afɔrebɔde wɔ fie;</para>
  <para style="q2" vid="PRO 7:14">nnɛ madi me bɔhyɛ so.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Enti mebae sɛ merebehyia wo;</para>
  <para style="q2" vid="PRO 7:15">mehwehwɛɛ wo na mahu wo!<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Mato me mpa,</para>
  <para style="q2" vid="PRO 7:16">mede nwera a wɔahyɛ no aduru a efi Misraim.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Mede nnuhuam apete me mpa so:</para>
  <para style="q2" vid="PRO 7:17">kurobow, pɛprɛ ne dupapo.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Bra, ma yɛmfa ɔdɔ mmɔ ɔdɔ mu nkosi anɔpa;<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Me kunu nni fie;</para>
  <para style="q2" vid="PRO 7:19">watu kwan na ɔbɛkyɛ.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Ɔde sika a ɛdɔɔso hyɛɛ ne sika kotoku ma</para>
  <para style="q2" vid="PRO 7:20">na ɔremma kosi ɔsram no kurokumatwa bere mu.”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Ɔde tɛkrɛmakyene bɔɔ no adafa;</para>
  <para style="q2" vid="PRO 7:21">ɔde nnaadaa nyaa no ne no dae.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>Odii nʼakyi prɛko pɛ</para>
  <para style="q2" vid="PRO 7:22">te sɛ nantwi a ɔrekɔ akumii,</para>
  <para style="q1" vid="PRO 7:22">anaa ɔwansan a ɔde ne ti rekɔhyɛ hankare fi mu<verse eid="PRO 7:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23"/>kosi sɛ bɛmma bɛwɔ ne brɛbo mu,</para>
  <para style="q1" vid="PRO 7:23">te sɛ anomaa a ɔrekɔtɔ anomaa afiri mu</para>
  <para style="q2" vid="PRO 7:23">na onnim sɛ ɔbɛhwere ne nkwa.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>Na afei, me mma, muntie me;</para>
  <para style="q2" vid="PRO 7:24">monyɛ aso mma nea meka.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Mommma mo koma mpatiri nkɔ no so</para>
  <para style="q2" vid="PRO 7:25">na momman mmfa nʼakwan so.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Bebree na wɔnam no so ahwehwe ase;</para>
  <para style="q2" vid="PRO 7:26">wɔn a wakum wɔn dɔɔso pa ara.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>Ne fi yɛ ɔda tempɔn a</para>
  <para style="q2" vid="PRO 7:27">ɛkɔ owu pia mu.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Nyansa Frɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Tie: Nyansa refrɛ.</para>
  <para style="q2" vid="PRO 8:1">Ntease ma ne nne so.<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Ɔkwan no so, sorɔnsorɔmmea hɔ,</para>
  <para style="q2" vid="PRO 8:2">nkwantanan no so, ɛhɔ na egyina,<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>apon a ɛkɔ kuropɔn no mu no ho,</para>
  <para style="q2" vid="PRO 8:3">ɛteɛ mu wɔ abobow ano hɔ se,<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>“Ao, mo nnipa na meteɛ mu refrɛ;</para>
  <para style="q2" vid="PRO 8:4">meteɛ mu frɛ adesamma nyinaa.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>Mo a moyɛ ntetekwaa, momma mo ani ntew;</para>
  <para style="q2" vid="PRO 8:5">mo a moyɛ nkwaseafo, munnya ntease.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Muntie, na mewɔ nsɛm pa bi ka kyerɛ mo;</para>
  <para style="q2" vid="PRO 8:6">mibue mʼano ka nea eye.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Mʼano ka nea ɛyɛ nokware,</para>
  <para style="q2" vid="PRO 8:7">efisɛ mʼanofafa kyi amumɔyɛsɛm.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Mʼanom nsɛm nyinaa yɛ pɛ;</para>
  <para style="q2" vid="PRO 8:8">biara nni mu a ɛyɛ nkontompo anaa nnaadaasɛm.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Ne nyinaa mu da hɔ ma nea ɔwɔ nhumu;</para>
  <para style="q2" vid="PRO 8:9">ɛho nni asɛm ma wɔn a wɔwɔ nimdeɛ.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Mompo dwetɛ na momfa mʼakwankyerɛ,</para>
  <para style="q2" vid="PRO 8:10">momfa nimdeɛ na mompo sikakɔkɔɔ ankasa.<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>Efisɛ nimdeɛ som bo sen bota,</para>
  <para style="q2" vid="PRO 8:11">na worentumi mfa nea wopɛ biara ntoto no ho.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>“Me, nyansa, mene anitew na ɛte;</para>
  <para style="q2" vid="PRO 8:12">nimdeɛ ne nhumu wɔ me.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>Sɛ wosuro <char style="nd">Awurade</char> ɛne sɛ wokyi bɔne;</para>
  <para style="q2" vid="PRO 8:13">mikyi ahantan ne ahomaso,</para>
  <para style="q2" vid="PRO 8:13">ɔbra bɔne ne nnaadaasɛm.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>Afotu ne atemmu pa wɔ me;</para>
  <para style="q2" vid="PRO 8:14">mewɔ ntease ne tumi.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>Me so na ahemfo nam di ade</para>
  <para style="q2" vid="PRO 8:15">na sodifo nam me so hyehyɛ mmara a ɛyɛ pɛ;<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>Mmapɔmma de me bu ɔman</para>
  <para style="q2" vid="PRO 8:16">ne atitiriw nyinaa a wodi asase so hene.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Medɔ wɔn a wɔdɔ me,</para>
  <para style="q2" vid="PRO 8:17">na wɔn a wɔhwehwɛ me no hu me.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>Ahonyade ne anuonyam wɔ me nkyɛn,</para>
  <para style="q2" vid="PRO 8:18">ahode a ɛkyɛ ne yiyedi nso saa ara.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Mʼaba ye sen sikakɔkɔɔ ankasa;</para>
  <para style="q2" vid="PRO 8:19">nea efi me mu boro dwetɛ a wɔasɔn so so.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Trenee akwan so na menam,</para>
  <para style="q2" vid="PRO 8:20">atɛntrenee akwan so,<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>mede ahode ma wɔn a wɔdɔ me</para>
  <para style="q2" vid="PRO 8:21">na mehyɛ wɔn adekoradan amaama.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>“<char style="nd">Awurade</char> bɔɔ me sɛ nʼabɔde mu abakan</para>
  <para style="q2" vid="PRO 8:22">dii ne tete nneyɛe anim;<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>oyii me sii hɔ fi tete,</para>
  <para style="q2" vid="PRO 8:23">ansa na wiase refi ase.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Wɔwoo me ansa na wɔrebɔ po kakraka no,</para>
  <para style="q2" vid="PRO 8:24">ansa na wɔreyɛ nsuti a nsu ahyɛ no ma no,<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ansa na wɔde mmepɔw resisi hɔ;</para>
  <para style="q2" vid="PRO 8:25">wɔwoo me ansa na nkoko reba,<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>ansa na ɔbɔɔ asase ne ne mfuw</para>
  <para style="q2" vid="PRO 8:26">anaa dɔte biara a ɛwɔ asase so.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Mewɔ hɔ ansa na wɔbɔɔ ɔsoro,</para>
  <para style="q2" vid="PRO 8:27">bere a otwaa ɔhye too ebun no ani no,<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>bere a ɔbɔɔ omununkum wɔ soro</para>
  <para style="q2" vid="PRO 8:28">na ɔde ebun mu nsuti tintim hɔ dennen no;<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>bere a otwaa ɔhye maa po</para>
  <para style="q2" vid="PRO 8:29">sɛnea nsu no rentra ne hye,</para>
  <para style="q1" vid="PRO 8:29">ne bere a otwaa asase fapem no,<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>na meyɛ odwumfo a mete ne nkyɛn.</para>
  <para style="q1" vid="PRO 8:30">Anigye hyɛɛ me ma daa</para>
  <para style="q2" vid="PRO 8:30">na midii ahurusi wɔ nʼanim bere biara,<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>na mʼani gye wɔ ne wiase nyinaa mu</para>
  <para style="q2" vid="PRO 8:31">na mʼani ka wɔ adesamma mu.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“Enti me mma, muntie me;</para>
  <para style="q2" vid="PRO 8:32">nhyira ne wɔn a wɔnantew mʼakwan so.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>Muntie mʼakwankyerɛ na munhu nyansa;</para>
  <para style="q2" vid="PRO 8:33">mummmu mo ani ngu so.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>Nhyira ne onipa a otie me,</para>
  <para style="q2" vid="PRO 8:34">ɔwɛn mʼabobow ano daa,</para>
  <para style="q2" vid="PRO 8:34">na ɔtwɛn wɔ hɔ.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Na obiara a ohu me no nya nkwa,</para>
  <para style="q2" vid="PRO 8:35">na onya anisɔ fi <char style="nd">Awurade</char> nkyɛn.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>Na nea wanhwehwɛ me no haw ne ho</para>
  <para style="q2" vid="PRO 8:36">na wɔn a wɔtan me no dɔ owu.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Nyansa Ne Nkwaseasɛm Frɛ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>Nyansa asi ne fi;</para>
  <para style="q2" vid="PRO 9:1">wasisi nʼafadum ason.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Wasiesie ne nam de afra ne nsa,</para>
  <para style="q2" vid="PRO 9:2">wato ne pon.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Wasoma ne mmaawa, na ɔfrɛ</para>
  <para style="q2" vid="PRO 9:3">fi kuropɔn no sorɔnsorɔmmea hɔ se,<verse eid="PRO 9:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4"/>“Momma ntetekwaafo nyinaa mmra ha!”</para>
  <para style="q1" vid="PRO 9:4">Ɔka kyerɛ wɔn a wonni atemmu se,<verse eid="PRO 9:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5"/>“Mommra mmedi mʼaduan</para>
  <para style="q2" vid="PRO 9:5">na monnom nsa a mafra no.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Munnyaw mo ntetekwaasɛm no na mubenya nkwa;</para>
  <para style="q2" vid="PRO 9:6">monnantew ntease akwan so.”<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>Nea ɔteɛteɛ ɔfɛwdifo no frɛ ahohorabɔ;</para>
  <para style="q2" vid="PRO 9:7">na nea ɔka amumɔyɛfo anim no nya ɔyaw.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Ɛno nti, nka ɔfɛwdifo anim na ɔmmɛtan wo;</para>
  <para style="q2" vid="PRO 9:8">ka onyansafo anim na ɔbɛdɔ wo.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Ma onyansafo akwankyerɛ na ɔbɛkɔ so ahu nyansa;</para>
  <para style="q2" vid="PRO 9:9">kyerɛkyerɛ ɔtreneeni na ɔde bɛka nʼadesua ho.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>
    <char style="nd">Awurade</char> suro yɛ nyansa mfiase</para>
  <para style="q2" vid="PRO 9:10">Ɔkronkronni no ho nimdeɛ yɛ ntease.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Me mu na wo nna bɛdɔɔso,</para>
  <para style="q2" vid="PRO 9:11">na wɔde mfe bɛka wo nkwa ho.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Sɛ woyɛ onyansafo a, wubenya wo nyansa so mfaso;</para>
  <para style="q2" vid="PRO 9:12">sɛ woyɛ ɔfɛwdifo a, wo nko ara na wubehu amane.<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>Ɔbea ɔkwasea yɛ ɔkasafo;</para>
  <para style="q2" vid="PRO 9:13">onni ahohyɛso na onni nimdeɛ.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Ɔte ne fi pon ano,</para>
  <para style="q2" vid="PRO 9:14">na ɔte akongua a esi kuropɔn no sorɔnsorɔmmea,<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>na ɔfrɛfrɛ wɔn a wotwa mu wɔ hɔ,</para>
  <para style="q2" vid="PRO 9:15">wɔn a wɔnam wɔn kwan so tee se,<verse eid="PRO 9:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16"/>“Momma ntetekwaafo nyinaa mmra ha”</para>
  <para style="q1" vid="PRO 9:16">ɔka kyerɛ wɔn a wonni atemmu se,<verse eid="PRO 9:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17"/>“Nsu a wowia no yɛ fremfrem</para>
  <para style="q2" vid="PRO 9:17">na aduan a wodi no ahintawee no yɛ dɛ!”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>Nanso wonnim koraa sɛ awufo wɔ hɔ</para>
  <para style="q2" vid="PRO 9:18">sɛ nʼahɔho wɔ ɔda no ase tɔnn.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">Salomo Mmebusɛm</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>Salomo mmebusɛm:</para>
  <para style="q1" vid="PRO 10:1">Ɔba nyansafo ma nʼagya ani gye,</para>
  <para style="q2" vid="PRO 10:1">na ɔba kwasea brɛ ne na awerɛhow.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>Ɔkwan bɔne so ahonya nni bo,</para>
  <para style="q2" vid="PRO 10:2">nanso trenee gye onipa fi owu mu.<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>
    <char style="nd">Awurade</char> remma ɔkɔm nne ɔtreneeni</para>
  <para style="q2" vid="PRO 10:3">na omumɔyɛfo de, ɔka nʼadepa gu.<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Nsa a ɛnyɛ adwuma ma onipa di hia,</para>
  <para style="q2" vid="PRO 10:4">nanso nsiyɛfo nsa de ahonya ba.<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Nea ɔboaboa nnɔbae ano wɔ ahuhurubere no yɛ ɔba nyansafo</para>
  <para style="q2" vid="PRO 10:5">na nea ɔda wɔ twabere mu no yɛ ɔba nimguaseni.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>Atreneefo hyɛ nhyira kyɛw</para>
  <para style="q2" vid="PRO 10:6">na akakabensɛm ayɛ omumɔyɛfo anom ma.<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Ɔtreneeni nkae yɛ nhyira,</para>
  <para style="q2" vid="PRO 10:7">na omumɔyɛfo din bɛporɔw.<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>Koma mu nyansafo tie ɔhyɛ nsɛm,</para>
  <para style="q2" vid="PRO 10:8">na ɔkwasea kasafo hwe ase.<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Ɔnokwafo nantew dwoodwoo,</para>
  <para style="q2" vid="PRO 10:9">na nea ɔfa akwan kɔntɔnkye so no ho bɛda adi.<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Nea ɔde nitan bu nʼani no de ɔhaw ba,</para>
  <para style="q2" vid="PRO 10:10">na ɔkwasea kasafo hwe ase.<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>Ɔtreneeni anom yɛ nkwa asuti,</para>
  <para style="q2" vid="PRO 10:11">na akakabensɛm ayɛ omumɔyɛfo anom ma.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Ɔtan kanyan mpaapaemu,</para>
  <para style="q2" vid="PRO 10:12">nanso ɔdɔ kata mfomso nyinaa so.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Wohu nyansa wɔ nhumufo anom,</para>
  <para style="q2" vid="PRO 10:13">na abaa fata nea onni adwene akyi.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>Anyansafo kora nimdeɛ,</para>
  <para style="q2" vid="PRO 10:14">nanso ɔkwasea ano frɛfrɛ ɔsɛe.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Adefo ahonya yɛ wɔn kuropɔn a wɔabɔ ho ban,</para>
  <para style="q2" vid="PRO 10:15">nanso ahiafo hia yɛ wɔn asehwe.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>Atreneefo akatua de nkwa brɛ wɔn,</para>
  <para style="q2" vid="PRO 10:16">na nea amumɔyɛfo nya no de asotwe brɛ wɔn.<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Nea otie ntetew pa no kyerɛ nkwa kwan,</para>
  <para style="q2" vid="PRO 10:17">na nea ɔpo nteɛso no di afoforo anim yera kwan.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Nea ɔkata nitan so no yɛ ɔtorofo,</para>
  <para style="q2" vid="PRO 10:18">na nea odi nseku no yɛ ɔkwasea.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Mfomso mpa ɔkasa bebree mu,</para>
  <para style="q2" vid="PRO 10:19">na nea ɔkora ne tɛkrɛma no yɛ onyansafo.<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Ɔtreneeni tɛkrɛma yɛ dwetɛ ankasa</para>
  <para style="q2" vid="PRO 10:20">nanso omumɔyɛfo koma nni bo.<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>Atreneefo ano ma bebree aduan,</para>
  <para style="q2" vid="PRO 10:21">na atemmu a nkwaseafo nni nti wowuwu.<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>
    <char style="nd">Awurade</char> nhyira de ahonya ba,</para>
  <para style="q2" vid="PRO 10:22">na ɔmfa ɔbrɛ mmata ne nya ho.<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Bɔneyɛ yɛ anigyede ma ɔkwasea,</para>
  <para style="q2" vid="PRO 10:23">nanso nea ɔwɔ nimdeɛ anigye wɔ nyansa mu.<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Nea amumɔyɛfo suro no bɛba wɔn so;</para>
  <para style="q2" vid="PRO 10:24">na nea atreneefo pɛ no, wɔde bɛma wɔn.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Sɛ ahum no betwa mu a, amumɔyɛfo yera,</para>
  <para style="q2" vid="PRO 10:25">nanso atreneefo gyina hɔ pintinn afebɔɔ.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Sɛnea nsa keka ɛse, na wusiw kɔ aniwa no,</para>
  <para style="q2" vid="PRO 10:26">saa ara na ɔkwadwofo yɛ ma wɔn a wɔsoma no.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>
    <char style="nd">Awurade</char> suro ma nkwa tenten,</para>
  <para style="q2" vid="PRO 10:27">nanso wotwa amumɔyɛfo nkwa so.<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Atreneefo anidaso de ahotɔ ba,</para>
  <para style="q2" vid="PRO 10:28">nanso amumɔyɛfo anidaso nkosi hwee.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>
    <char style="nd">Awurade</char> kwan yɛ guankɔbea ma ɔtreneeni,</para>
  <para style="q2" vid="PRO 10:29">nanso ɛyɛ ɔsɛe ma wɔn a wɔyɛ bɔne.<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Wɔrentɔre atreneefo ase da,</para>
  <para style="q2" vid="PRO 10:30">nanso amumɔyɛfo renka asase no so.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>Nyansa fi ɔtreneeni anom ba</para>
  <para style="q2" vid="PRO 10:31">nanso tɛkrɛma a ɛdaadaa no, wobetwa akyene.<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Ɔtreneeni ano nim ade a ɛfata</para>
  <para style="q2" vid="PRO 10:32">na omumɔyɛfo ano nim nea ɛyɛ nnaadaasɛm nko ara.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>
    <char style="nd">Awurade</char> kyi asisi nsania,</para>
  <para style="q2" vid="PRO 11:1">na nʼani gye nokware nkaribo ho.<verse eid="PRO 11:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Ahantan ba a, animguase na edi so,</para>
  <para style="q2" vid="PRO 11:2">nanso ahobrɛase de nyansa ba.<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Teefo nokwaredi kyerɛ wɔn kwan;</para>
  <para style="q2" vid="PRO 11:3">nanso nkontompofo ano ntanta sɛe wɔn.<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Ahonya nka hwee wɔ abufuwhyew da no,</para>
  <para style="q2" vid="PRO 11:4">nanso trenee gye nkwa fi owu mu.<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Wɔn a wonni bɔne no trenee bɔ kwan tee ma wɔn,</para>
  <para style="q2" vid="PRO 11:5">nanso amumɔyɛfo amumɔyɛsɛm brɛ wɔn ase.<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Pɛyɛfo treneeyɛ gye wɔn,</para>
  <para style="q2" vid="PRO 11:6">nanso akɔnnɔ bɔne afiri yi nkontompofo.<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Sɛ omumɔyɛfo wu a, nʼanidaso yera;</para>
  <para style="q2" vid="PRO 11:7">nea osusuw sɛ obenya afi ne tumi mu nyinaa no yɛ ɔkwa.<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Wogye ɔtreneeni fi amane mu,</para>
  <para style="q2" vid="PRO 11:8">na ɛba omumɔyɛfo so mmom.<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Nea onsuro Onyame de nʼano sɛe ne yɔnko,</para>
  <para style="q2" vid="PRO 11:9">nanso ɔtreneeni nam nimdeɛ so fi mu.<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Sɛ atreneefo di yiye a, kuropɔn no di ahurusi;</para>
  <para style="q2" vid="PRO 11:10">nanso amumɔyɛfo wu a, wɔbɔ ose.<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Pɛyɛfo nhyira ma kuropɔn no kɔ so,</para>
  <para style="q2" vid="PRO 11:11">nanso amumɔyɛfo ano ma ɛbɔ.<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Onipa a onni adwene no bu ne yɔnko animtiaa,</para>
  <para style="q2" vid="PRO 11:12">nanso nea ɔwɔ nhumu no to ne tɛkrɛma nnareka.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Nsekudi sɛe ahotoso,</para>
  <para style="q2" vid="PRO 11:13">nanso nea wɔwɔ ne mu ahotoso no kora ahintasɛm.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Ɔman a enni akwankyerɛ no bɔ,</para>
  <para style="q2" vid="PRO 11:14">nanso afotufo dodow ma nkonimdi ba.<verse eid="PRO 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Nea odi akagyinamu ma ɔfoforo no behu amane,</para>
  <para style="q2" vid="PRO 11:15">na nea ɔmmfa ne nsa nhyɛ awowasi ase no aso mu dwo no.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Ɔbea a ne yam ye no, wɔde obu ma no,</para>
  <para style="q2" vid="PRO 11:16">nanso mmarima atirimɔdenfo nya ahode nkutoo.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Ɔyamyefo ye ma ne ho,</para>
  <para style="q2" vid="PRO 11:17">na otirimɔdenfo de ɔhaw ba nʼankasa so.<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Omumɔyɛfo nya akatua a ennyina,</para>
  <para style="q2" vid="PRO 11:18">nanso nea ogu trenee aba no twa aba a edi mu.<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Nea ɔyɛ nokware treneeni no nya nkwa,</para>
  <para style="q2" vid="PRO 11:19">nanso nea ɔkɔ so yɛ bɔne no kɔ owu mu.<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>
    <char style="nd">Awurade</char> kyi nnipa a wɔn koma akyea,</para>
  <para style="q2" vid="PRO 11:20">na nʼani gye wɔn a wɔn akwan ho nni asɛm no ho.<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Gye to mu sɛ, amumɔyɛfo benya wɔn akatua,</para>
  <para style="q2" vid="PRO 11:21">na atreneefo benya wɔn ti adidi mu.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Ɔbea hoɔfɛfo a ontumi nsi gyinae no</para>
  <para style="q2" vid="PRO 11:22">te sɛ sika kaa a ɛhyɛ prako hwene mu.<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Atreneefo apɛde wie yiye,</para>
  <para style="q2" vid="PRO 11:23">nanso amumɔyɛfo anidaso wie abufuwhyew.<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Obi yɛ adɔe, na onya ne ho bebree;</para>
  <para style="q2" vid="PRO 11:24">obi nso yɛ pɛpɛe, nanso ehia no.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Ɔyamyefo bɛkɔ so anya ne ho;</para>
  <para style="q2" vid="PRO 11:25">na nea ɔma ebinom mee no nso bɛmee.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Nnipa dome nea ɔde atoko sie,</para>
  <para style="q2" vid="PRO 11:26">na nhyira ba nea ɔtɔn ne de so.<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Nea ɔhwehwɛ papa akyi kwan no nya anisɔ,</para>
  <para style="q2" vid="PRO 11:27">na nea ɔhwehwɛ bɔne no, bɔne ba ne so.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Nea ɔde ne ho to nʼahonyade so no bɛhwe ase,</para>
  <para style="q2" vid="PRO 11:28">na ɔtreneeni bɛyɛ frɔmfrɔm sɛ ahabammono.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Nea ɔde ɔhaw bɛto nʼabusua so no bedi mframa ade,</para>
  <para style="q2" vid="PRO 11:29">na ɔkwasea bɛyɛ onyansafo somfo.<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Ɔtreneeni aba yɛ nkwadua,</para>
  <para style="q2" vid="PRO 11:30">na nea ogye akra no yɛ onyansafo.<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Kyerɛwsɛm no ka se, “Ɛyɛ den sɛ wobegye onipa pa nkwa;</para>
  <para style="q2" vid="PRO 11:31">na wɔn a wonnye asɛm no nni ne nnebɔneyɛfo no de, dɛn na ɛbɛba wɔn so?”<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Obiara a ɔpɛ ahohyɛso no pɛ nimdeɛ,</para>
  <para style="q2" vid="PRO 12:1">na nea okyi nteɛso no yɛ ogyimifo.<verse eid="PRO 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Nnipa pa nya <char style="nd">Awurade</char> nkyɛn adom,</para>
  <para style="q2" vid="PRO 12:2">na <char style="nd">Awurade</char> bu amumɔyɛfo fɔ.<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Amumɔyɛsɛm rentumi mma onipa ase ntim,</para>
  <para style="q2" vid="PRO 12:3">na wɔrentumi ntu ɔtreneeni ase.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Ɔyere a ɔwɔ suban pa yɛ ne kunu ahenkyɛw,</para>
  <para style="q2" vid="PRO 12:4">nanso ɔyere nimguasefo te sɛ porɔwee wɔ ne kunu nnompe mu.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Atreneefo nhyehyɛe yɛ pɛ,</para>
  <para style="q2" vid="PRO 12:5">na amumɔyɛfo afotu yɛ nnaadaa.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Amumɔyɛfo nsɛm da hɔ twɛn mogya,</para>
  <para style="q2" vid="PRO 12:6">na ɔtreneeni kasa yi wɔn fi mu.<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Wotu amumɔyɛfo gu na wɔyera,</para>
  <para style="q2" vid="PRO 12:7">nanso atreneefo fi gyina pintinn.<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Wɔkamfo onipa sɛnea ne nyansa te</para>
  <para style="q2" vid="PRO 12:8">na nnipa a wɔn adwene yɛ kɔntɔnkye de, wobu wɔn animtiaa.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Eye sɛ wobɛyɛ wo ho sɛ ɔteta nanso wowɔ ɔsomfo,</para>
  <para style="q2" vid="PRO 12:9">sen sɛ wobɛyɛ wo ho sɛ obi, nanso wunni aduan.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Ɔtreneeni ma ne nyɛmmoa nea wɔpɛ,</para>
  <para style="q2" vid="PRO 12:10">na amumɔyɛfo nneyɛe a eye pa ara yɛ atirimɔden.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Nea ɔyɛ nʼasase so adwuma no benya aduan bebree,</para>
  <para style="q2" vid="PRO 12:11">na nea odi nsɛm huhuw akyi no nni adwene.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Amumɔyɛfo pɛ abɔnefo asade,</para>
  <para style="q2" vid="PRO 12:12">nanso ɔtreneeni ase dɔ.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Ɔbɔnefo anosɛm yi no sɛ afiri,</para>
  <para style="q2" vid="PRO 12:13">nanso ɔtreneeni nya ne ho tetew wɔ ahohia mu.<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Nneɛma pa fi onipa anom aba mu hyɛ no ma</para>
  <para style="q2" vid="PRO 12:14">sɛnea ne nsa ano adwuma ma no akatua no.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Ɔkwasea akwan teɛ nʼani so,</para>
  <para style="q2" vid="PRO 12:15">na onyansafo tie afotu.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Nkwaseafo bo nkyɛ fuw,</para>
  <para style="q2" vid="PRO 12:16">nanso mmadwemma bu wɔn ani gu animka so.<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Ɔdanseni nokwafo di adanse turodoo,</para>
  <para style="q2" vid="PRO 12:17">na nea odi adansekurum no twa nkontompo.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Nsɛm hunu keka wowɔ te sɛ afoa</para>
  <para style="q2" vid="PRO 12:18">nanso onyansafo tɛkrɛma ma abodwo.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Ano a ɛka nokware no tim hɔ daa,</para>
  <para style="q2" vid="PRO 12:19">na atoro tɛkrɛma renkyɛ koraa.<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Nnaadaa hyɛ wɔn a wodwen bɔne ho no koma mu,</para>
  <para style="q2" vid="PRO 12:20">na wɔn a wɔpɛ asomdwoe nya ahosɛpɛw.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>Ɔhaw biara rento ɔtreneeni,</para>
  <para style="q2" vid="PRO 12:21">nanso amanehunu mee amumɔyɛfo.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>
    <char style="nd">Awurade</char> kyi ano a etwa atoro,</para>
  <para style="q2" vid="PRO 12:22">na nʼani gye nnipa a wodi nokware ho.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Ɔtreneeni mmɔ ne nimdeɛ ho dawuru</para>
  <para style="q2" vid="PRO 12:23">nanso ɔkwasea koma da agyimisɛm adi.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>Nsa a ɛyɛ adwuma no bedi tumi,</para>
  <para style="q2" vid="PRO 12:24">nanso akwadworɔ wie nkoasom mu.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Koma a ɛpere ade ho ma onipa botow,</para>
  <para style="q2" vid="PRO 12:25">nanso nkuranhyɛsɛm bi hyɛ no den.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Ɔtreneeni wɔ ntoboase wɔ ayɔnkofa mu,</para>
  <para style="q2" vid="PRO 12:26">nanso amumɔyɛfo kwan ma wɔfom.<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Onihawfo ntoto ne hanam,</para>
  <para style="q2" vid="PRO 12:27">nanso nsiyɛfo ahonyade som bo ma wɔn.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>Trenee kwan mu wɔ nkwa;</para>
  <para style="q2" vid="PRO 12:28">na owu nni saa kwan no so.<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Ɔba nyansafo tie nʼagya nkyerɛkyerɛ;</para>
  <para style="q2" vid="PRO 13:1">na ɔfɛwdifo ntie animka.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Nneɛma pa a efi onipa anom no ma no anigye,</para>
  <para style="q2" vid="PRO 13:2">na wɔn a wonni nokware no kɔn dɔ kitikitiyɛ.<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Nea ɔkora nʼano no kora ne nkwa so,</para>
  <para style="q2" vid="PRO 13:3">nanso nea ɔkasa a onsusuw ho no bɛba ɔsɛe mu.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Onihawfo pere hwehwɛ nanso onya hwee,</para>
  <para style="q2" vid="PRO 13:4">na nea ɔyɛ adwuma no nya nea ɔpɛ biara.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Atreneefo kyi nea ɛnyɛ nokware,</para>
  <para style="q2" vid="PRO 13:5">nanso amumɔyɛfo de aniwu ne ahohora ba.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Trenee bɔ ɔnokwafo ho ban,</para>
  <para style="q2" vid="PRO 13:6">na amumɔyɛsɛm tu ɔbɔnefo gu.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Obi yɛ ne ho sɛ ɔdefo, a nso onni hwee,</para>
  <para style="q2" vid="PRO 13:7">ɔfoforo yɛ ne ho sɛ ohiani, nso ɔwɔ ahonya bebree.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Obi ahonya betumi agye no nkwa,</para>
  <para style="q2" vid="PRO 13:8">nanso ohiani nte ahunahuna biara.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>Atreneefo kanea hyerɛn pa ara,</para>
  <para style="q2" vid="PRO 13:9">nanso wodum amumɔyɛfo kanea.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Ahantan de ntɔkwaw nko ara na ɛba,</para>
  <para style="q2" vid="PRO 13:10">na wohu nyansa wɔ wɔn a wotie afotu mu.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Ahonya a ɛnam ɔkwammɔne so no hwere ntɛm so,</para>
  <para style="q2" vid="PRO 13:11">na nea ɔboa sika ano nkakrankakra no ma ɛdɔɔso.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Anidaso a wotu hyɛ da no bɔ koma ɔyare,</para>
  <para style="q2" vid="PRO 13:12">nanso anigyinade a nsa aka no yɛ nkwadua.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Nea otwiri akwankyerɛ no betua so ka,</para>
  <para style="q2" vid="PRO 13:13">nanso wɔma nea ɔde obu ma mmara no akatua.<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Onyansafo nkyerɛkyerɛ te sɛ nkwa asuti,</para>
  <para style="q2" vid="PRO 13:14">eyi onipa fi owu afiri mu.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>Nhumu pa de adom ba,</para>
  <para style="q2" vid="PRO 13:15">nanso atorofo akwan so yɛ den.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Ɔbadwemma biara yɛ nʼade wɔ nimdeɛ mu,</para>
  <para style="q2" vid="PRO 13:16">nanso ɔkwasea da nʼagyimisɛm adi.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Ɔsomafo mumɔyɛfo tɔ amane mu,</para>
  <para style="q2" vid="PRO 13:17">nanso ɔnanmusini nokwafo de abodwo ba.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>Nea ɔpo nteɛso no kɔ ohia ne animguase mu,</para>
  <para style="q2" vid="PRO 13:18">na wɔhyɛ nea otie nteɛso no anuonyam.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Akɔnnɔde a nsa aka ma ɔkra ani gye,</para>
  <para style="q2" vid="PRO 13:19">nanso nkwaseafo kyi sɛ wɔtwe wɔn ho fi bɔne ho.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>Nea ɔne onyansafo nantew no hu nyansa,</para>
  <para style="q2" vid="PRO 13:20">na nea ɔne nkwaseafo bɔ no hu amane.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Ɔhaw di ɔbɔnefo akyi,</para>
  <para style="q2" vid="PRO 13:21">na nkɔso yɛ ɔtreneeni akatua.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>Onipa pa de agyapade gyaw ne nenanom,</para>
  <para style="q2" vid="PRO 13:22">na wɔkora ɔbɔnefo ahonyade so ma ɔtreneeni.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Ohiani afum nnɔbae tumi ba pii,</para>
  <para style="q2" vid="PRO 13:23">nanso ntɛnkyew pra kɔ.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Nea ɔkyɛe nʼabaa so no tan ne ba,</para>
  <para style="q2" vid="PRO 13:24">na nea ɔdɔ no no hwɛ sɛ ɔbɛteɛ no.<verse eid="PRO 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Atreneefo didi ma wɔn koma mee,</para>
  <para style="q2" vid="PRO 13:25">nanso ɔkɔm de amumɔyɛfo.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>Ɔbea nyansafo si ne dan,</para>
  <para style="q2" vid="PRO 14:1">nanso ɔbea kwasea de nʼankasa ne nsa dwiriw ne de gu fam.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Nea ne nantew teɛ no suro <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PRO 14:2">na nea nʼakwan kyea no bu no animtiaa.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Ɔkwasea kasa ma wɔbɔ nʼakyi abaa,</para>
  <para style="q2" vid="PRO 14:3">nanso anyansafo ano bɔ wɔn ho ban.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Faako a anantwi nni no, adididaka no mu da mpan,</para>
  <para style="q2" vid="PRO 14:4">na nantwi ahoɔden mu na nnɔbae pii fi ba.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Ɔdanseni nokwafo rennaadaa,</para>
  <para style="q2" vid="PRO 14:5">ɔdansekurumni hwie atoro gu hɔ.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Ɔfɛwdifo hwehwɛ nyansa nanso onya,</para>
  <para style="q2" vid="PRO 14:6">nanso wɔn a wɔwɔ nhumu nya nimdeɛ ntɛm.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Twe wo ho fi ɔkwasea ho,</para>
  <para style="q2" vid="PRO 14:7">efisɛ, worennya nimdeɛ mfi nʼano.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Anitewfo nyansa ne sɛ wɔbɛdwene wɔn akwan ho,</para>
  <para style="q2" vid="PRO 14:8">na nkwaseafo agyimisɛm yɛ nnaadaa.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Nkwaseafo de bɔne ho adwensakra di fɛw,</para>
  <para style="q2" vid="PRO 14:9">na wɔn a wɔteɛ mu na anisɔ wɔ.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Koma biara nim ɔyaw wɔ ne mu,</para>
  <para style="q2" vid="PRO 14:10">na obi foforo rentumi ne no nkyɛ nʼanigye.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>Wɔbɛsɛe amumɔyɛfo fi,</para>
  <para style="q2" vid="PRO 14:11">nanso teefo ntamadan bɛyɛ frɔmfrɔm.<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Ɔkwan bi wɔ hɔ a ɛteɛ wɔ onipa ani so,</para>
  <para style="q2" vid="PRO 14:12">nanso awiei no, ɛkɔ owu mu.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>Ɔserew mu mpo, koma tumi di yaw,</para>
  <para style="q2" vid="PRO 14:13">na anigye tumi wie awerɛhow.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Akyirisanfo benya akatua sɛnea wɔn akwan te,</para>
  <para style="q2" vid="PRO 14:14">na onipa pa nso benya ne de.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Atetekwaa gye biribiara di,</para>
  <para style="q2" vid="PRO 14:15">nanso onitefo dwene nʼanammɔntu ho.<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Onyansafo suro <char style="nd">Awurade</char> na oguan bɔne,</para>
  <para style="q2" vid="PRO 14:16">nanso ɔkwasea yɛ asowui ne basabasa.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Onipa a ne bo nkyɛ fuw no yɛ nkwaseade,</para>
  <para style="q2" vid="PRO 14:17">na wɔtɔn nea ɔpam apam bɔne no.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Ntetekwaafo agyapade ne gyimi,</para>
  <para style="q2" vid="PRO 14:18">na wɔde nimdeɛ bɔ anitewfo abotiri.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>Nnipa bɔnefo bɛkotow nnipa pa anim,</para>
  <para style="q2" vid="PRO 14:19">na amumɔyɛfo akotow atreneefo apon ano.<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>Ahiafo de, wɔn yɔnkonom mpo mpɛ wɔn anim ahwɛ,</para>
  <para style="q2" vid="PRO 14:20">nanso adefo wɔ nnamfonom bebree.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Nea obu ne yɔnko animtiaa yɛ bɔne,</para>
  <para style="q2" vid="PRO 14:21">na nhyira nka nea ne yam ye ma ohiani.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>So wɔn a wɔbɔ pɔw bɔne nyera kwan ana?</para>
  <para style="q2" vid="PRO 14:22">Nanso wɔn a wɔhyehyɛ nea eye no nya adɔe ne nokware.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Adwumadenyɛ nyinaa de mfaso ba,</para>
  <para style="q2" vid="PRO 14:23">na kasahunu de, ɛkɔ ohia mu.<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>Anyansafo ahonya ne wɔn abotiri,</para>
  <para style="q2" vid="PRO 14:24">na nkwaseafo agyimisɛm sow gyimi aba.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Ɔdanseni nokwafo gye nkwa,</para>
  <para style="q2" vid="PRO 14:25">nanso ɔdansekurumni yɛ ɔdaadaafo.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Nea osuro <char style="nd">Awurade</char> no wɔ bammɔ a mu yɛ den,</para>
  <para style="q2" vid="PRO 14:26">na ɛbɛyɛ guankɔbea ama ne mma.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>
    <char style="nd">Awurade</char> suro yɛ nkwa asuti,</para>
  <para style="q2" vid="PRO 14:27">eyi onipa fi owu afiri mu.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Ɔman mu nnipa dodow yɛ ɔhene anuonyam,</para>
  <para style="q2" vid="PRO 14:28">nanso sɛ asomfo nni hɔ a mmapɔmma no sɛe.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Onipa a ɔwɔ abodwokyɛre wɔ ntease a mu dɔ,</para>
  <para style="q2" vid="PRO 14:29">na nea ne bo fu ntɛm no da agyimisɛm adi.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Koma mu asomdwoe ma nipadua nkwa,</para>
  <para style="q2" vid="PRO 14:30">na anibere ma nnompe porɔw.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Nea ɔhyɛ ahiafo so no bu wɔn Yɛfo animtiaa,</para>
  <para style="q2" vid="PRO 14:31">nanso nea ohu ohiani mmɔbɔ no hyɛ Onyankopɔn anuonyam.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Sɛ amanehunu ba a amumɔyɛfo hwe ase,</para>
  <para style="q2" vid="PRO 14:32">nanso owu mu mpo atreneefo wɔ guankɔbea.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Nyansa te ntease koma mu,</para>
  <para style="q2" vid="PRO 14:33">na nkwaseafo mu mpo, oyi ne ho adi.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Trenee pagyaw ɔman,</para>
  <para style="q2" vid="PRO 14:34">na bɔne yɛ animguase ma nnipa nyinaa.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Ɔhene ani sɔ ɔsomfo nyansani,</para>
  <para style="q2" vid="PRO 14:35">na ɔsomfo nimguasefo hyɛ no abufuw.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Mmuae pa sianka abufuwhyew,</para>
  <para style="q2" vid="PRO 15:1">nanso asɛm a ano yɛ den hwanyan abufuw mu.<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>Onyansafo tɛkrɛma yi nimdeɛ ayɛ,</para>
  <para style="q2" vid="PRO 15:2">nanso ɔkwasea ano woro agyimisɛm.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>
    <char style="nd">Awurade</char> ani hu baabiara,</para>
  <para style="q2" vid="PRO 15:3">na ɛhwɛ amumɔyɛfo ne apapafo.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Tɛkrɛma a ɛde abodwo ba yɛ nkwadua,</para>
  <para style="q2" vid="PRO 15:4">nanso nnaadaa tɛkrɛma dwerɛw honhom.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Ɔkwasea mfa nʼagya nteɛso nyɛ hwee,</para>
  <para style="q2" vid="PRO 15:5">na nea otie nteɛso no kyerɛ sɛ ɔyɛ onitefo.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Ahonya bebree wɔ ɔtreneeni fi,</para>
  <para style="q2" vid="PRO 15:6">nanso amumɔyɛfo adenya de ɔhaw brɛ wɔn.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Anyansafo ano trɛtrɛw nimdeɛ mu,</para>
  <para style="q2" vid="PRO 15:7">nanso ɛnyɛ saa na nkwaseafo koma te.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>
    <char style="nd">Awurade</char> kyi amumɔyɛfo afɔrebɔ,</para>
  <para style="q2" vid="PRO 15:8">nanso teefo mpaebɔ sɔ nʼani.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>
    <char style="nd">Awurade</char> kyi amumɔyɛfo akwan,</para>
  <para style="q2" vid="PRO 15:9">nanso ɔdɔ wɔn a wotiw trenee.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Asotwe dennen wɔ hɔ ma nea ɔman fi ɔkwan no so,</para>
  <para style="q2" vid="PRO 15:10">nea ɔtan nteɛso no bewu.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Owu ne Ɔsɛe da <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PRO 15:11">na nnipa koma mu de, onim ma ɛboro so.<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>Ɔfɛwdifo mpɛ nteɛso;</para>
  <para style="q2" vid="PRO 15:12">onkobisa anyansafo hwee.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Anigye koma ma anim yɛ sereserew,</para>
  <para style="q2" vid="PRO 15:13">na koma a abotow dwerɛw honhom.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>Nhumufo koma hwehwɛ nimdeɛ,</para>
  <para style="q2" vid="PRO 15:14">nanso ɔkwasea ano ka agyimisɛm.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Wɔn a wɔhyɛ wɔn so nna nyinaa yɛ mmɔbɔmmɔbɔ,</para>
  <para style="q2" vid="PRO 15:15">nanso anigye koma wɔ daa ahosɛpɛw mu.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Ketewa bi a yenya a <char style="nd">Awurade</char> suro ka ho no ye</para>
  <para style="q2" vid="PRO 15:16">sen ahonyade bebree a ɔhaw bata ho.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Nhabamma aduan a ɔdɔ wɔ mu no ye</para>
  <para style="q2" vid="PRO 15:17">sen nantwi sradenam a ɔtan bata ho.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Nea ne bo fuw ntɛm no de mpaapaemu ba,</para>
  <para style="q2" vid="PRO 15:18">nanso nea ɔwɔ ntoboase pata ntɔkwaw.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Nsɔe ama onihawfo kwan asiw,</para>
  <para style="q2" vid="PRO 15:19">nanso teefo kwan yɛ ɔtempɔn.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Ɔba nyansafo ma nʼagya ani gye,</para>
  <para style="q2" vid="PRO 15:20">nanso ɔba kwasea bu ne na animtiaa.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Agyimisɛm ma nea onni adwene ani gye,</para>
  <para style="q2" vid="PRO 15:21">nanso nea ɔwɔ ntease no fa ɔkwan a ɛteɛ so.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>Nhyehyɛe a enni afotu no sɛe,</para>
  <para style="q2" vid="PRO 15:22">nanso afotufo bebree ma ɛyɛ yiye.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Onipa a ɔma mmuae a ɛfata no ani gye,</para>
  <para style="q2" vid="PRO 15:23">asɛm a ɛba bere pa mu no nso ye.<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Onyansafo asetena mu kwan ma no nkɔso,</para>
  <para style="q2" vid="PRO 15:24">esiw ne da mukɔ ho kwan.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>
    <char style="nd">Awurade</char> sɛe ɔhantanni fi,</para>
  <para style="q2" vid="PRO 15:25">na ɔma akunafo ahye yɛ pɛpɛɛpɛ.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>
    <char style="nd">Awurade</char> kyi amumɔyɛfo nsusuwii,</para>
  <para style="q2" vid="PRO 15:26">nanso nʼani sɔ wɔn a wɔyɛ kronkron no de.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Odifudepɛfo de ɔhaw brɛ nʼabusua,</para>
  <para style="q2" vid="PRO 15:27">nanso nea okyi kɛtɛasehyɛ no benya nkwa.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Ɔtreneeni koma kari ne mmuae,</para>
  <para style="q2" vid="PRO 15:28">nanso omumɔyɛfo ano woro bɔne.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>
    <char style="nd">Awurade</char> mmɛn amumɔyɛfo koraa,</para>
  <para style="q2" vid="PRO 15:29">nanso ɔte ɔtreneeni mpaebɔ.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Anim a ɛtew ma koma nya ahomeka,</para>
  <para style="q2" vid="PRO 15:30">na asɛm pa ma nnompe ahoɔden.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Nea otie animka a ɛma nkwa no</para>
  <para style="q2" vid="PRO 15:31">ne anyansafo bɛbɔ mu atena ase.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Nea ɔmfa ahohyɛso no bu ne ho animtiaa,</para>
  <para style="q2" vid="PRO 15:32">na nea otie nteɛso no nya nhumu.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>
    <char style="nd">Awurade</char> suro kyerɛ onipa nyansa,</para>
  <para style="q2" vid="PRO 15:33">ahobrɛase di anuonyam anim.<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>Koma mu nhyehyɛe yɛ onipa de,</para>
  <para style="q2" vid="PRO 16:1">na tɛkrɛma mmuae fi <char style="nd">Awurade</char>.<verse eid="PRO 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Ɛyɛ onipa sɛ nʼakwan nyinaa yɛ kronkron,</para>
  <para style="q2" vid="PRO 16:2">nanso <char style="nd">Awurade</char> na ɔpɛɛpɛɛ adwene mu.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>Fa nea woyɛ nyinaa hyɛ <char style="nd">Awurade</char> nsam,</para>
  <para style="q2" vid="PRO 16:3">na wo nhyehyɛe besi yiye.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>
    <char style="nd">Awurade</char> yɛ biribiara ma nʼankasa botae,</para>
  <para style="q2" vid="PRO 16:4">mpo, ɔhwɛ omumɔyɛfo so kosi amanehunu da.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>
    <char style="nd">Awurade</char> kyi koma mu ahantanfo nyinaa.</para>
  <para style="q2" vid="PRO 16:5">Nya saa ntease yi sɛ, wɔremfa wɔn ho nni.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Wɔnam ɔdɔ ne nokware so pata bɔne;</para>
  <para style="q2" vid="PRO 16:6">onipa nam <char style="nd">Awurade</char> suro so yi bɔne akwa.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Sɛ onipa akwan sɔ <char style="nd">Awurade</char> ani a,</para>
  <para style="q2" vid="PRO 16:7">ɔma nʼatamfo mpo ne no tena asomdwoe mu.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Kakraa bi a wɔnam trenee kwan so nya no ye</para>
  <para style="q2" vid="PRO 16:8">sen mfaso pii a wɔnam ntɛnkyew so nya.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>Onipa yɛ ne nhyehyɛe wɔ ne koma mu,</para>
  <para style="q2" vid="PRO 16:9">nanso <char style="nd">Awurade</char> na ɔhwɛ nʼanammɔntu.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Ɔhene anom kasa te sɛ nkɔmhyɛ,</para>
  <para style="q2" vid="PRO 16:10">enti ɛnsɛ sɛ nʼano ka nea ɛnyɛ atɛntrenee.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Nsania ne abrammo a asisi nni mu fi <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PRO 16:11">nkaribo a ɛwɔ kotoku mu no, ɔno na ɔyɛe.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Ahemfo kyi bɔneyɛ,</para>
  <para style="q2" vid="PRO 16:12">efisɛ ahengua si trenee so.<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Ahemfo ani sɔ ano a ɛka nokware;</para>
  <para style="q2" vid="PRO 16:13">na wobu onipa a ɔka nokware.<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Ɔhene abufuwhyew yɛ owu somafo,</para>
  <para style="q2" vid="PRO 16:14">nanso onyansafo bedwudwo ano.<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Sɛ ɔhene anim tew a, ɛyɛ nkwa,</para>
  <para style="q2" vid="PRO 16:15">nʼadom te sɛ asusowbere mu omununkum.<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>Eye sɛ wubenya nyansa sen sɛ wubenya sikakɔkɔɔ,</para>
  <para style="q2" vid="PRO 16:16">sɛ wubenya nhumu sen sɛ wubenya dwetɛ!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>Ɔtreneeni tempɔn kwati bɔne;</para>
  <para style="q2" vid="PRO 16:17">nea ɔhwɛ nʼakwan yiye no bɔ ne nkwa ho ban.<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Ahantan di ɔsɛe anim,</para>
  <para style="q2" vid="PRO 16:18">na ahomaso honhom nso di asehwe anim.<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Eye sɛ wobɛyɛ honhom mu hiani wɔ wɔn a wɔhyɛ wɔn so mu</para>
  <para style="q2" vid="PRO 16:19">sen sɛ wo ne ahantanfo bɛkyɛ asade.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Nea ɔyɛ osetie ma nkyerɛkyerɛ no nya nkɔso;</para>
  <para style="q2" vid="PRO 16:20">nhyira nka nea ɔde ne ho to <char style="nd">Awurade</char> so.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>Wɔfrɛ koma mu anyansafo se nhumufo,</para>
  <para style="q2" vid="PRO 16:21">na kasa pa ma nkyerɛkyerɛ kɔ so.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Ntease yɛ nkwa asuti ma wɔn a wɔwɔ bi,</para>
  <para style="q2" vid="PRO 16:22">nanso agyimisɛm de asotwe brɛ nkwaseafo.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>Onyansafo koma kyerɛ nʼano kwan,</para>
  <para style="q2" vid="PRO 16:23">na nʼanofafa ma nkyerɛkyerɛ kɔ so.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>Abodwosɛm te sɛ ɛwokyɛm;</para>
  <para style="q2" vid="PRO 16:24">ɛyɛ ɔkra dɛ, na ɛsa nnompe yare.<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>Ɔkwan bi wɔ hɔ a ɛteɛ wɔ onipa ani so,</para>
  <para style="q2" vid="PRO 16:25">nanso awiei no, ɛkɔ owu mu.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>Apaafo akɔnnɔ ma wɔyɛ adwumaden;</para>
  <para style="q2" vid="PRO 16:26">efisɛ wɔpɛ sɛ wokum wɔn kɔm.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Ohuhuni bɔ pɔw bɔne,</para>
  <para style="q2" vid="PRO 16:27">ne kasa te sɛ ogya a ɛhyew ade.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Onipa kɔntɔnkye de mpaapaemu ba,</para>
  <para style="q2" vid="PRO 16:28">na ɔsututufo tetew nnamfonom ntam.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Kitikitiyɛni daadaa ne yɔnko,</para>
  <para style="q2" vid="PRO 16:29">na ɔde no fa ɔkwammɔne so.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Nea obu nʼani no redwene bɔneyɛ ho;</para>
  <para style="q2" vid="PRO 16:30">na nea omua nʼano no ani wɔ bɔne so.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Dwen yɛ anuonyam abotiri;</para>
  <para style="q2" vid="PRO 16:31">trenee mu asetena na ɛde ba.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Nea ɔwɔ abodwokyɛre no ye sen ɔkofo,</para>
  <para style="q2" vid="PRO 16:32">na nea ɔmfa abufuw ye sen nea ɔko fa kuropɔn.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Wɔbɔ ntonto de hwehwɛ nea <char style="nd">Awurade</char> pɛ,</para>
  <para style="q2" vid="PRO 16:33">nanso ne gyinaesi biara fi <char style="nd">Awurade</char>.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Aduan sakoo a asomdwoe wɔ ho</para>
  <para style="q2" vid="PRO 17:1">ye sen ofi a aponto ahyɛ no ma nanso basabasayɛ wɔ mu.<verse eid="PRO 17:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Ɔsomfo nyansafo bedi ɔba nimguasefo so,</para>
  <para style="q2" vid="PRO 17:2">na obenya ne kyɛfa wɔ agyapade no mu sɛ anuanom no mu baako.<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Kyɛmfɛre wɔ hɔ ma dwetɛ na fononoo wɔ hɔ ma sikakɔkɔɔ</para>
  <para style="q2" vid="PRO 17:3">nanso <char style="nd">Awurade</char> na ɔsɔ koma hwɛ.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Omumɔyɛfo tie nsusuwii bɔne;</para>
  <para style="q2" vid="PRO 17:4">ɔtorofo yɛ aso ma adwene bɔne tɛkrɛma.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Nea odi ahiafo ho fɛw no bu wɔn Yɛfo animtiaa;</para>
  <para style="q2" vid="PRO 17:5">na nea ɔfoa amanehunu so no benya asotwe.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Nananom yɛ mmasiriwa anuonyam,</para>
  <para style="q2" vid="PRO 17:6">na awofo yɛ wɔn mma ahohoahoa.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Anotew nye mma ɔkwasea,</para>
  <para style="q2" vid="PRO 17:7">saa ara na ano a edi atoro mfata ɔhene.<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Nea ɔma adanmude no hu sɛ ɛyɛ suman;</para>
  <para style="q2" vid="PRO 17:8">osusuw sɛ nkonimdi bɛba bere biara.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Nea obu nʼani gu mfomso so no ma ɔdɔ kwan,</para>
  <para style="q2" vid="PRO 17:9">na nea ɔkɔ so bɔ so no tetew nnamfonom ntam.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Animka sɔ onipa a ɔwɔ nhumu ani</para>
  <para style="q2" vid="PRO 17:10">sen mmaa ɔha a wɔbɔ ɔkwasea.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Onipa bɔnefo ani wɔ atuatew nko ara so</para>
  <para style="q2" vid="PRO 17:11">na wɔbɛsoma odwumayɛni tirimuɔdenfo akɔ no so.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Eye sɛ wubehyia sisi a wɔawia ne mma</para>
  <para style="q2" vid="PRO 17:12">sen ɔkwasea a ɔregyimi.<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Sɛ obi de bɔne tua papa so ka a,</para>
  <para style="q2" vid="PRO 17:13">bɔne rempa ne fi da.<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Ntɔkwaw mfiase te sɛ nea wɔretue suka;</para>
  <para style="q2" vid="PRO 17:14">enti gyae ma ɛnka na ankɔfa ɔham amma.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>Sɛ wobegyaa nea odi fɔ ne sɛ wobebu nea odi bem kumfɔ no,</para>
  <para style="q2" vid="PRO 17:15">
    <char style="nd">Awurade</char> kyi nʼabien no nyinaa.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Sika a ɛwɔ ɔkwasea nsam so nni mfaso,</para>
  <para style="q2" vid="PRO 17:16">efisɛ onni botae biara sɛ obehu nyansa.<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Adamfo kyerɛ ɔdɔ bere nyinaa mu,</para>
  <para style="q2" vid="PRO 17:17">wɔwo onuabarima ma ahokyere bere.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Obi a onni adwene no na ɔde ne nsa hyɛ krataa ase di akagyinamu</para>
  <para style="q2" vid="PRO 17:18">nam so de si awowa ma ne yɔnko.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Nea ɔpɛ ntɔkwaw no dɔ bɔne;</para>
  <para style="q2" vid="PRO 17:19">nea osi ɔpon tenten no frɛfrɛ ɔsɛe.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Onipa a ɔwɔ porɔwee koma no nnya nkɔso;</para>
  <para style="q2" vid="PRO 17:20">nea ɔwɔ nnaadaa tɛkrɛma no tɔ amane mu.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Nea ɔwo ɔbakwasea no di awerɛhow,</para>
  <para style="q2" vid="PRO 17:21">ɔbakwasea agya nni anigye.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Koma mu anigye yɛ aduru, ɛsa ɔyare,</para>
  <para style="q2" vid="PRO 17:22">nanso honhom a abotow no yoyow nnompe.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Omumɔyɛfo gye adanmude wɔ sum ase</para>
  <para style="q2" vid="PRO 17:23">de kyea atɛntrenee.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Onipa a ɔwɔ nhumu no ani kɔ nyansa so,</para>
  <para style="q2" vid="PRO 17:24">na ɔkwasea toto nʼani kosi asase ano.<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Ɔbakwasea hyɛ nʼagya awerɛhow,</para>
  <para style="q2" vid="PRO 17:25">na ɔma nea onyinsɛn no no di yaw.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Enye sɛ wɔtwe nea odi bem aso,</para>
  <para style="q2" vid="PRO 17:26">anaasɛ wotwa adwumayɛfo mmaa wɔ wɔn nokwaredi nti.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Onimdefo dwene nʼanom kasa ho,</para>
  <para style="q2" vid="PRO 17:27">na nea ɔwɔ nhumu no wɔ abodwo.<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>Mpo sɛ ɔkwasea yɛ dinn a wobu no sɛ onyansafo,</para>
  <para style="q2" vid="PRO 17:28">na sɛ omua nʼano a wobu no sɛ ɔwɔ nhumu.<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Ɔhonamkani yɛ pɛsɛmenkominya;</para>
  <para style="q2" vid="PRO 18:1">na nea ɛmfa atɛntrenee mma no turuw ɔham.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Ɔkwasea nni nhumu ho anigye,</para>
  <para style="q2" vid="PRO 18:2">na mmom nea ɔpɛ ara ne sɛ ɔde nʼadwene bɛto gua.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Sɛ amumɔyɛsɛm ba a animtiaabu di so,</para>
  <para style="q2" vid="PRO 18:3">na aniwu nso di animguase akyi.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Onipa anom nsɛm yɛ nsu a emu dɔ,</para>
  <para style="q2" vid="PRO 18:4">na nyansa asuti yɛ asuwa a ɛrefi ahuru.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Enye sɛ wodi ma omumɔyɛfo</para>
  <para style="q2" vid="PRO 18:5">anaasɛ wobu nea odi bem ntɛnkyew.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Nkwaseafo ano de akasakasa ba,</para>
  <para style="q2" vid="PRO 18:6">na wɔn ano frɛfrɛ ɔhwe.<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Nkwaseafo ano yɛ wɔn ara wɔn sɛe,</para>
  <para style="q2" vid="PRO 18:7">na wɔn anofafa yɛ wɔn ara wɔn kra afiri.<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Osekuni ano asɛm te sɛ aduan a ɛyɛ dɛ;</para>
  <para style="q2" vid="PRO 18:8">ɛhyɛnhyɛn onipa akwaa mu nyinaa.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Nea ɔtoto nʼadwuma ase no</para>
  <para style="q2" vid="PRO 18:9">yɛ ɔsɛefo nuabarima.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>
    <char style="nd">Awurade</char> din yɛ abantenten a ɛyɛ den;</para>
  <para style="q2" vid="PRO 18:10">ahotefo guan kɔtoa na wonya bammɔ.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Adefo ahonyade ne wɔn kuropɔn a wɔabɔ ho ban</para>
  <para style="q2" vid="PRO 18:11">wɔfa no sɛ ɔfasu tenten a wontumi mforo.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>Ansa na onipa bɛhwe ase no onya ahomaso koma,</para>
  <para style="q2" vid="PRO 18:12">na ahobrɛase di anuonyam anim.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Nea ontie asɛm ansa na wama mmuae no,</para>
  <para style="q2" vid="PRO 18:13">ɛno ne ne gyimi ne nʼanimguase.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Onipa honhom na ɛhyɛ no den wɔ ɔyare mu</para>
  <para style="q2" vid="PRO 18:14">na honhom a abotow de, hena na ɔpɛ?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>Nhumu koma nya nimdeɛ;</para>
  <para style="q2" vid="PRO 18:15">na anyansafo aso nso hwehwɛ.<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>Akyɛde bue kwan ma nea ɔde ma</para>
  <para style="q2" vid="PRO 18:16">na ɛde no ba atitiriw anim.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Ɛyɛ nea ɔbɔ ne nkuro kan no sɛ nʼasɛm yɛ dɛ,</para>
  <para style="q2" vid="PRO 18:17">kosi sɛ ɔfoforo bɛba abebisa no nsɛm no mu.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>Ntontobɔ twa akyinnyegye so,</para>
  <para style="q2" vid="PRO 18:18">na ɛpata atamfo.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Onua a wɔafom no no asɛm yɛ den sen kuropɔn a ɛwɔ bammɔ,</para>
  <para style="q2" vid="PRO 18:19">akyinnyegye te sɛ abankɛse apon a wɔabram akyi.<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Onipa anom asɛm so aba ma ɔyafunu mee,</para>
  <para style="q2" vid="PRO 18:20">nnɔbae a nʼanofafa twa no mee no.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>Tɛkrɛma kura nkwa ne owu tumi,</para>
  <para style="q2" vid="PRO 18:21">na wɔn a wɔdɔ no no bedi nʼaba.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Nea wanya yere no anya ade pa</para>
  <para style="q2" vid="PRO 18:22">na onya adom fi <char style="nd">Awurade</char> hɔ.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>Ohiani srɛ ahummɔbɔ,</para>
  <para style="q2" vid="PRO 18:23">nanso ɔdefo de kasaden bua no.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Ɔbarima a ne nnamfonom dɔɔso betumi ahwe ase,</para>
  <para style="q2" vid="PRO 18:24">nanso adamfo bi wɔ hɔ a ɔbɛfam ne ho asen onua.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>Ohiani a ne nantew ho nni asɛm no</para>
  <para style="q2" vid="PRO 19:1">ye sen ɔkwasea a nʼasɛm mfa kwan mu.<verse eid="PRO 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Mmɔdemmɔ a nimdeɛ nka ho no nye,</para>
  <para style="q2" vid="PRO 19:2">saa ara na ntɛmpɛ a ɛma obi yera kwan nso nye.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Onipa agyimisɛm sɛe nʼabrabɔ,</para>
  <para style="q2" vid="PRO 19:3">nanso ne koma huru tia <char style="nd">Awurade</char>.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>Ahonya frɛfrɛ nnamfonom bebree;</para>
  <para style="q2" vid="PRO 19:4">nanso ohiani adamfo gyaw no hɔ.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Adansekurumni benya nʼakatua,</para>
  <para style="q2" vid="PRO 19:5">na nea otwa nkontompo remfa ne ho nni.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>Nnipa pii pɛ adom fi sodifo nkyɛn,</para>
  <para style="q2" vid="PRO 19:6">na nea ɔkyɛ ade yɛ obiara adamfo.<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Ohiani abusuafo nyinaa po no,</para>
  <para style="q2" vid="PRO 19:7">na saa ara na ne nnamfonom po no!</para>
  <para style="q1" vid="PRO 19:7">Mpo ɔhwehwɛ wɔn, pɛ sɛ ɔpa wɔn kyɛw,</para>
  <para style="q2" vid="PRO 19:7">nanso onhu wɔn baabiara.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Nea onya nyansa no dɔ ne kra;</para>
  <para style="q2" vid="PRO 19:8">nea ɔpɛ nhumu no nya nkɔso.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Adansekurumni benya asotwe,</para>
  <para style="q1" vid="PRO 19:9">na nea otwa nkontompo no bɛyera.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Ɛmfata sɛ ɔkwasea bedi taamu,</para>
  <para style="q2" vid="PRO 19:10">anaasɛ akoa bedi mmapɔmma so!<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Onipa nyansa ma no ntoboase;</para>
  <para style="q2" vid="PRO 19:11">ɛyɛ anuonyam ma obi sɛ obebu nʼani gu mfomso bi so.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>Ɔhene abufuw te sɛ gyata mmubomu,</para>
  <para style="q2" vid="PRO 19:12">na nʼadom te sɛ sare so bosu.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Ɔba kwasea yɛ nʼagya ɔsɛe,</para>
  <para style="q2" vid="PRO 19:13">ɔyere tɔkwapɛfo te sɛ ɔdan a ne nwini to ntwa da.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Afi ne ahonyade yɛ agyapade a efi awofo,</para>
  <para style="q2" vid="PRO 19:14">na ɔyere nimdefo fi <char style="nd">Awurade</char>.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>Akwadworɔ de nnahɔɔ ba,</para>
  <para style="q2" vid="PRO 19:15">na ɔkɔm de ɔkwadwofo.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Nea odi nkyerɛkyerɛ so no bɔ ne nkwa ho ban,</para>
  <para style="q2" vid="PRO 19:16">na nea ogyaagyaa ne ho no bewu.<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Nea ɔyɛ adɔe ma ohiani no yɛ de fɛm <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PRO 19:17">na obetua no nea ɔyɛ no so ka.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>Teɛ wo ba, na ɛno mu na anidaso wɔ,</para>
  <para style="q2" vid="PRO 19:18">na nyɛ wɔn a wɔde no kɔ owu mu no mu baako.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Ɛsɛ sɛ onipa a ne koma haw no no nya so asotwe;</para>
  <para style="q2" vid="PRO 19:19">sɛ woka ma no a, wobɛyɛ bio.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Tie afotu na gye nkyerɛkyerɛ to mu,</para>
  <para style="q2" vid="PRO 19:20">na awiei no, wubehu nyansa.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Nhyehyɛe bebree wɔ onipa koma mu,</para>
  <para style="q2" vid="PRO 19:21">nanso nea <char style="nd">Awurade</char> pɛ no na ɛba mu.<verse eid="PRO 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Nea onipa pɛ ne nokware dɔ;</para>
  <para style="q2" vid="PRO 19:22">eye sɛ wobɛyɛ ohiani sen sɛ wobɛyɛ ɔtorofo.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>
    <char style="nd">Awurade</char> suro kɔ nkwa mu;</para>
  <para style="q2" vid="PRO 19:23">na onipa de abotɔyam home a ɔhaw bi nni mu.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Ɔkwadwofo de ne nsa si aduan mu,</para>
  <para style="q2" vid="PRO 19:24">na ɛyɛ no anihaw sɛ obeyi akɔ nʼano.<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Twa ɔfɛwdifo mmaa, na atetekwaa bɛfa adwene;</para>
  <para style="q2" vid="PRO 19:25">ka nea ɔwɔ nhumu anim, na obenya nimdeɛ.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Nea ɔbɔ nʼagya korɔn na ɔpam ne na no</para>
  <para style="q2" vid="PRO 19:26">yɛ ɔba a ɔde aniwu ne animguase ba.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Me ba, sɛ wugyae nkyerɛkyerɛ tie a,</para>
  <para style="q2" vid="PRO 19:27">wobɛman afi nimdeɛ nsɛm ho.<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Adansekurumni di atɛntrenee ho fɛw;</para>
  <para style="q2" vid="PRO 19:28">na omumɔyɛfo ano mene bɔne.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Wɔasiesie asotwe ama fɛwdifo,</para>
  <para style="q2" vid="PRO 19:29">ne mmaabɔ ama nkwaseafo akyi.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Nsa yɛ ɔfɛwdifo na nsaden yɛ ɔtɔkwapɛfo;</para>
  <para style="q2" vid="PRO 20:1">na obiara a nsa bɛma wafom kwan no nyɛ onyansafo.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Ɔhene abufuwhyew te sɛ gyata mmubomu;</para>
  <para style="q2" vid="PRO 20:2">na nea ɔhyɛ no abufuw no de nkwa twa so.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>Ɛyɛ onipa anuonyam sɛ ɔbɛkwati akasakasa,</para>
  <para style="q2" vid="PRO 20:3">nanso ogyimifo biara pɛ ntɔkwaw.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Onihawfo mfuntum nʼasase wɔ ne bere mu;</para>
  <para style="q2" vid="PRO 20:4">enti edu twabere a onya hwee.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Onipa koma botae yɛ asubun,</para>
  <para style="q2" vid="PRO 20:5">nanso nea ɔwɔ nhumu no twetwe ma epue.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Nnipa dodow no ara ka se wɔwɔ ɔdɔ a ɛnsa da,</para>
  <para style="q2" vid="PRO 20:6">na hena na obetumi ahu ɔnokwafo?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Ɔtreneeni bu ɔbra kronkron;</para>
  <para style="q2" vid="PRO 20:7">nhyira nka ne mma a wɔba wɔ nʼakyi.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>Sɛ ɔhene tena nʼahengua so bu atɛn a,</para>
  <para style="q2" vid="PRO 20:8">ɔde nʼani huhuw bɔne nyinaa so gu.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>Hena na obetumi aka se, “Mapra me koma mu;</para>
  <para style="q2" vid="PRO 20:9">meyɛ kronkron na minni bɔne?”<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>Nkaribo ne susudua a ɛnyɛ papa no,</para>
  <para style="q2" vid="PRO 20:10">
    <char style="nd">Awurade</char> kyi nʼabien no nyinaa.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>Mpo wɔnam abofra nketewa nneyɛe so hu wɔn,</para>
  <para style="q2" vid="PRO 20:11">saa ara na ne suban yɛ kronkron ne papa no.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>Aso a wɔde te asɛm ne ani a wɔde hu ade,</para>
  <para style="q2" vid="PRO 20:12">
    <char style="nd">Awurade</char> na wayɛ nʼabien no nyinaa.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>Mma nna nyɛ wo dɛ, na woanni hia;</para>
  <para style="q2" vid="PRO 20:13">nna, na wubenya aduan ama abu so.<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>Adetɔni ka se, “Enye, enye!”</para>
  <para style="q2" vid="PRO 20:14">nanso sɛ ɔkɔ a ɔde nea watɔ no hoahoa ne ho.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Sika kɔkɔɔ wɔ hɔ, na nhene pa nso abu so,</para>
  <para style="q2" vid="PRO 20:15">na ano a ɛka nimdeɛ nsɛm yɛ ɔbohemaa a ɛho yɛ na.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Fa obi a odi ɔhɔho akagyinamu atade;</para>
  <para style="q2" vid="PRO 20:16">sɛ ɔregyina ɔbea huhufo akyi a, fa si awowa.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>Aduan a wonya no ɔkwan bɔne so no yɛ onipa anom dɛ,</para>
  <para style="q2" vid="PRO 20:17">nanso akyiri no, ɛdan mmosea wɔ nʼanom.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Pɛ afotu yɛ wo nhyehyɛe;</para>
  <para style="q2" vid="PRO 20:18">sɛ wutu ɔsa a, nya ho akwankyerɛ.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Osekuni da kokoamsɛm adi;</para>
  <para style="q2" vid="PRO 20:19">enti twe wo ho fi onipa a ɔkasa bebree ho.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Sɛ obi dome nʼagya anaasɛ ne na a,</para>
  <para style="q2" vid="PRO 20:20">wobedum ne kanea wɔ sum kabii mu.<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Agyapade a wɔpere ho nya no,</para>
  <para style="q2" vid="PRO 20:21">renyɛ nhyira akyiri no.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>Nka se, “Metua wo saa bɔne yi so ka!”</para>
  <para style="q2" vid="PRO 20:22">Twɛn <char style="nd">Awurade</char>, na obegye wo.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>
    <char style="nd">Awurade</char> kyi nkaribo a ɛnyɛ papa,</para>
  <para style="q2" vid="PRO 20:23">na asisi nsania nso nsɔ nʼani.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>
    <char style="nd">Awurade</char> na ɔkyerɛ onipa anammɔntu.</para>
  <para style="q2" vid="PRO 20:24">Na ɛbɛyɛ dɛn na obi bɛte nʼankasa akwan ase?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>Obi pɛ ntɛm hyɛ bɔ, ansa na wadwene ho a,</para>
  <para style="q2" vid="PRO 20:25">osum ne ho afiri.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Ɔhene nyansafo hu amumɔyɛfo;</para>
  <para style="q2" vid="PRO 20:26">na ɔde awiyam afiri hankare fa wɔn so.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>
    <char style="nd">Awurade</char> kanea hwehwɛ onipa honhom mu,</para>
  <para style="q2" vid="PRO 20:27">ɛhwehwɛ ne mu baabiara.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Ɔdɔ ne nokwaredi bɔ ɔhene ho ban;</para>
  <para style="q2" vid="PRO 20:28">nʼadɔe ma nʼahengua tim.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Mmerante anuonyam ne wɔn ahoɔden,</para>
  <para style="q2" vid="PRO 20:29">tidwen nso ne mmasiriwa anuonyam.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>Ɔhwe ne apirakuru hohoro amumɔyɛ,</para>
  <para style="q2" vid="PRO 20:30">mmaatwa tew koma mu.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Ɔhene koma da <char style="nd">Awurade</char> nsam;</para>
  <para style="q2" vid="PRO 21:1">ɔkyerɛ no ɔkwan te sɛ asuten ma ɔkɔ baabiara a ɔpɛ.<verse eid="PRO 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Onipa akwan nyinaa teɛ wɔ nʼani so,</para>
  <para style="q2" vid="PRO 21:2">nanso <char style="nd">Awurade</char> na ɔkari koma.<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>Sɛ woyɛ ade pa ne ade a ɛteɛ a,</para>
  <para style="q2" vid="PRO 21:3">ɛsɔ <char style="nd">Awurade</char> ani sen afɔrebɔ.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Ani a ɛtra ntɔn ne ahomaso koma,</para>
  <para style="q2" vid="PRO 21:4">ne amumɔyɛfo asetena nyinaa yɛ bɔne!<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Nsiyɛfo nhyehyɛe de mfaso ba,</para>
  <para style="q2" vid="PRO 21:5">sɛnea ntɛmpɛ kowie ohia no.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Ahonya a nkontompo tɛkrɛma de ba no,</para>
  <para style="q2" vid="PRO 21:6">ɛyɛ omununkum a etwa mu kɔ, na ɛsan yɛ owu afiri.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Amumɔyɛfo basabasayɛ bɛtwe wɔn akɔ,</para>
  <para style="q2" vid="PRO 21:7">efisɛ wɔmpɛ sɛ wɔyɛ nea ɛteɛ.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Onipa a odi fɔ no akwan yɛ kɔntɔnkye,</para>
  <para style="q2" vid="PRO 21:8">na nea ne ho nni asɛm no nneyɛe teɛ.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Suhyɛ twɔtwɔw ase baabi tena</para>
  <para style="q2" vid="PRO 21:9">ye sen sɛ wo ne ɔyere tɔkwapɛfo bɛtena fie.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Omumɔyɛfo kɔn dɔ bɔne;</para>
  <para style="q2" vid="PRO 21:10">onni ahummɔbɔ mma ne yɔnko.<verse eid="PRO 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Sɛ wɔtwe ɔfɛwdifo aso a, ntetekwaafo hu nyansa,</para>
  <para style="q2" vid="PRO 21:11">sɛ wɔkyerɛkyerɛ onyansafo a, onya nimdeɛ.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Ɔtreneeni no hu nea ɛrekɔ so wɔ omumɔyɛfo fi,</para>
  <para style="q2" vid="PRO 21:12">na ɔde omumɔyɛfo no kɔ ɔsɛe mu.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Sɛ onipa sisiw nʼaso wɔ mmɔborɔni su ho a,</para>
  <para style="q2" vid="PRO 21:13">ɔno nso besu afrɛ, na wɔrennye no so.<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Kokoa mu adekyɛ dwudwo koma,</para>
  <para style="q2" vid="PRO 21:14">kɛtɛasehyɛ nso pata abufuwhyew.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Sɛ wubu atɛntrenee a, atreneefo ani gye,</para>
  <para style="q2" vid="PRO 21:15">nanso ɛyɛ ahunahuna ma abɔnefo.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Onipa a ɔman fi nhumu kwan so no</para>
  <para style="q2" vid="PRO 21:16">bɛhome wɔ awufo fekuw mu.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Nea odi ahosɛpɛw akyi no bɛyɛ ohiani;</para>
  <para style="q2" vid="PRO 21:17">nea ɔpɛ nsa ne ngo no rennya ne ho da.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Amumɔyɛfo de wɔn nkwa to hɔ ma atreneefo,</para>
  <para style="q2" vid="PRO 21:18">na atorofo yɛ saa ma wɔn a wɔyɛ pɛ.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>Eye sɛ wobɛtena sare so,</para>
  <para style="q2" vid="PRO 21:19">sen sɛ wo ne ɔyere tɔkwapɛfo a ne koma haw no no bɛtena.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Nnuan pa ne ngo ayɛ onyansafo fi ma,</para>
  <para style="q2" vid="PRO 21:20">nanso ɔkwasea di nea ɔwɔ nyinaa.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Nea otiw trenee ne ɔdɔ no</para>
  <para style="q2" vid="PRO 21:21">nya nkwa, yiyedi ne anuonyam.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Onyansafo tow hyɛ ahoɔdenfo kuropɔn so,</para>
  <para style="q2" vid="PRO 21:22">na odwiriw abandennen a wɔn werɛ hyɛ mu no gu fam.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Nea ɔkora nʼano ne ne tɛkrɛma no</para>
  <para style="q2" vid="PRO 21:23">twe ne ho fi amanenya ho.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>Ɔhantanni a ɔma ne ho so no, ne din ne “Ɔfɛwdifo”</para>
  <para style="q2" vid="PRO 21:24">ɔde ahantan ntraso yɛ ade.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Nea ɔkwadwofo kɔn dɔ no bɛyɛ owu ama no,</para>
  <para style="q2" vid="PRO 21:25">efisɛ ne nsa mpɛ adwumayɛ.<verse eid="PRO 21:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Da mu nyinaa ɔpere sɛ obenya bebree,</para>
  <para style="q2" vid="PRO 21:26">nanso ɔtreneeni de, ɔma a ɔnnodow ho.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Omumɔyɛfo afɔrebɔ yɛ akyiwade,</para>
  <para style="q2" vid="PRO 21:27">ne titiriw ne sɛ ɔde adwemmɔne bata ho.<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Ɔdansekurumni bɛyera,</para>
  <para style="q2" vid="PRO 21:28">na wɔbɛsɛe obiara a otie no no nso.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Amumɔyɛfo di akakabensɛm,</para>
  <para style="q2" vid="PRO 21:29">na ɔtreneeni de, osusuw nʼakwan ho.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>Nyansa, nhumu ne nhyehyɛe biara nni hɔ a</para>
  <para style="q2" vid="PRO 21:30">ebetumi ayɛ yiye atia <char style="nd">Awurade</char>.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Wosiesie apɔnkɔ ma ɔko da,</para>
  <para style="q2" vid="PRO 21:31">nanso nkonimdi yɛ <char style="nd">Awurade</char> dea.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Din pa ye sen ahonya bebrebe;</para>
  <para style="q2" vid="PRO 22:1">sɛ wobedi wo ni ye sen dwetɛ anaa sikakɔkɔɔ.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Ɔdefo ne ohiani wɔ ade baako,</para>
  <para style="q2" vid="PRO 22:2">
    <char style="nd">Awurade</char> ne wɔn nyinaa Yɛfo.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Onitefo hu amanehunu a ɛreba na ohintaw ne ho,</para>
  <para style="q2" vid="PRO 22:3">nanso atetekwaa kɔ nʼanim konya amane.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Ahobrɛase ne <char style="nd">Awuradesuro</char></para>
  <para style="q2" vid="PRO 22:4">ɛma ahonya ne anuonyam ne nkwa.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>Nsɔe ne mfiri wɔ amumɔyɛfo akwan so,</para>
  <para style="q2" vid="PRO 22:5">nanso nea ɔbɔ ne kra ho ban no mmɛn ho.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Kyerɛ abofra ɔkwan a ɔmfa so,</para>
  <para style="q2" vid="PRO 22:6">na sɛ onyin a ɔremfi so.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>Adefo di ahiafo so,</para>
  <para style="q2" vid="PRO 22:7">na boseagyefo yɛ nea ɔde fɛm somfo.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Nea odua amumɔyɛsɛm no twa ɔhaw</para>
  <para style="q2" vid="PRO 22:8">na wɔbɛsɛe nʼabufuwhyew abaa.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Ɔyamyefo benya nhyira</para>
  <para style="q2" vid="PRO 22:9">efisɛ ɔne ahiafo kyɛ nʼaduan.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>Pam ɔfɛwdifo na basabasayɛ nso bɛkɔ;</para>
  <para style="q2" vid="PRO 22:10">ntɔkwaw ne animka to atwa.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Obi a ɔdɔ koma a mu tew na ne kasa ho yɛ nyam no,</para>
  <para style="q2" vid="PRO 22:11">benya ɔhene afa no adamfo.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>
    <char style="nd">Awurade</char> ani wɛn nimdeɛ,</para>
  <para style="q2" vid="PRO 22:12">na ɔsɛe ɔtorofo nsɛm.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>Ɔkwadwofo ka se, “Gyata bi wɔ mfikyiri hɔ!”</para>
  <para style="q2" vid="PRO 22:13">anaasɛ, “Wobekum me wɔ mmɔnten so.”<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Ɔbea waresɛefo anom yɛ amoa donkudonku;</para>
  <para style="q2" vid="PRO 22:14">nea ɔhyɛ <char style="nd">Awurade</char> abufuw ase no bɛtɔ mu.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Agyimisɛm kyekyere abofra koma ho,</para>
  <para style="q2" vid="PRO 22:15">nanso nteɛso abaa bɛpam no akɔ akyiri.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Obi besisi ohiani de apɛ ahonya,</para>
  <para style="q2" vid="PRO 22:16">anaa ɔbɛkyɛ ɔdefo ade, ne nyinaa de no kɔ ohia mu.<verse eid="PRO 22:16"/></para>
  <para style="s1">Anyansasɛm</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>Yɛ aso na tie anyansasɛm yi;</para>
  <para style="q2" vid="PRO 22:17">fa wo koma di me nkyerɛkyerɛ akyi,<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>efisɛ eye sɛ wokora saa nsɛm yi wɔ wo koma mu,</para>
  <para style="q2" vid="PRO 22:18">na ne nyinaa ada wʼano.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Sɛ ɛbɛyɛ a wode wo ho bɛto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PRO 22:19">merekyerɛkyerɛ wo nnɛ, yiw ɛyɛ wo.<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>Menkyerɛw mmɛ aduasa mmaa wo,</para>
  <para style="q2" vid="PRO 22:20">nea ɛyɛ afotusɛm ne nimdeɛ,<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>a ɛkyerɛkyerɛ wo nokware ne nea akyinnye nni ho,</para>
  <para style="q2" vid="PRO 22:21">sɛnea wubenya mmuae pa ama nea ɔsomaa wo no ana?<verse eid="PRO 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Mmɔ ahiafo korɔn, sɛ wɔyɛ ahiafo nti,</para>
  <para style="q2" vid="PRO 22:22">na nsisi wɔn a wonni bi wɔ asennii,<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>efisɛ <char style="nd">Awurade</char> bedi wɔn asɛm ama wɔn,</para>
  <para style="q2" vid="PRO 22:23">na wafom afa wɔn a wɔfom ahiafo fa.<verse eid="PRO 22:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Mfa obi a ne koma yɛ den no adamfo,</para>
  <para style="q2" vid="PRO 22:24">na mfa wo ho mmɔ nea ne bo nkyɛ fuw,<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>anyɛ saa a, wubesua nʼakwan</para>
  <para style="q2" vid="PRO 22:25">na woakɔtɔ afiri mu.<verse eid="PRO 22:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Nyɛ nea ɔde ne nsa hyɛ krataa ase di akagyinamu</para>
  <para style="q2" vid="PRO 22:26">anaasɛ odi akagyinamu;<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>na sɛ wunni nea wɔde tua a</para>
  <para style="q2" vid="PRO 22:27">wobehuam wo mpa mpo afi wʼase.<verse eid="PRO 22:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>Ntutu tete abo a wɔde ato hye,</para>
  <para style="q2" vid="PRO 22:28">nea wo nenanom de sisii hɔ no.<verse eid="PRO 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Wuhu obi a ne nsa akokwaw nʼadwuma ho ana?</para>
  <para style="q2" vid="PRO 22:29">Ahemfo anim na ɔbɛsom,</para>
  <para style="q2" vid="PRO 22:29">na ɔrensom wɔ mpapahwekwa anim.<verse eid="PRO 22:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Sɛ wo ne ɔhene bi to nsa didi a,</para>
  <para style="q2" vid="PRO 23:1">hwɛ nea esi wʼanim no yiye,<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>Sɛ woyɛ adidibrada a,</para>
  <para style="q2" vid="PRO 23:2">hyɛ wo ho so.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Nni nʼaduan akɔnnɔ akɔnnɔ no akyi,</para>
  <para style="q2" vid="PRO 23:3">efisɛ saa aduan no daadaa nnipa.<verse eid="PRO 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Mmiri wo mogya ani mpɛ sika;</para>
  <para style="q2" vid="PRO 23:4">hu nyansa na tɔ wo bo ase.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>Wʼani bɔɔ sika so ara pɛ, na atu ayera,</para>
  <para style="q2" vid="PRO 23:5">ampa ara ebefuw ntaban</para>
  <para style="q2" vid="PRO 23:5">na atu akɔ wim sɛ ɔkɔre.<verse eid="PRO 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Nni obi a ɔyɛ pɛpɛe aduan,</para>
  <para style="q2" vid="PRO 23:6">nni nʼakɔnnɔ aduan akyi;<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>efisɛ ɔyɛ obi a</para>
  <para style="q2" vid="PRO 23:7">bere biara osusuw sika ho.</para>
  <para style="q1" vid="PRO 23:7">Ɔka se, “Didi na nom,”</para>
  <para style="q2" vid="PRO 23:7">nanso ɛnyɛ ne koma mu.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Kakra a woadi no wobɛfe,</para>
  <para style="q2" vid="PRO 23:8">na ɛno nti wo nkamfo so remma mfaso.<verse eid="PRO 23:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>Nkasa nkyerɛ ɔkwasea,</para>
  <para style="q2" vid="PRO 23:9">efisɛ ɔremfa nyansa a ɛwɔ wo kasa mu no.<verse eid="PRO 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Ntutu tete abo a wɔde ato hye ngu,</para>
  <para style="q2" vid="PRO 23:10">na ntra ɔhye nkɔ ayisaa mfuw mu,<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>efisɛ wɔn Gyefo yɛ den,</para>
  <para style="q2" vid="PRO 23:11">na obedi wɔn asɛm ama wɔn.<verse eid="PRO 23:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Ma wo koma mmra nkyerɛkyerɛ so,</para>
  <para style="q2" vid="PRO 23:12">na wɛn wʼaso tie nimdeɛ.<verse eid="PRO 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>Ntwentwɛn abofra nteɛso so;</para>
  <para style="q2" vid="PRO 23:13">sɛ wode abaa teɛ no a, ɔrenwu.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Fa abaa twe nʼaso</para>
  <para style="q2" vid="PRO 23:14">na gye ne kra fi owu mu.<verse eid="PRO 23:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Me ba, sɛ wo koma hu nyansa a,</para>
  <para style="q2" vid="PRO 23:15">ɛno de, me koma ani begye;<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>sɛ wʼano ka nea ɛteɛ a</para>
  <para style="q2" vid="PRO 23:16">me mu ade nyinaa ani begye.<verse eid="PRO 23:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>Mma wʼani mmere abɔnefo,</para>
  <para style="q2" vid="PRO 23:17">mmom bɔ <char style="nd">Awurade</char> suro ho mmɔden bere biara.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Ampa ara anidaso wɔ hɔ ma wo daakye,</para>
  <para style="q2" vid="PRO 23:18">na wʼanidaso renyɛ ɔkwa.<verse eid="PRO 23:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Me ba, tie, na hu nyansa,</para>
  <para style="q2" vid="PRO 23:19">ma wo koma mfa ɔkwantrenee so.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Mfa wo ho mmɔ akɔwensafo</para>
  <para style="q2" vid="PRO 23:20">anaasɛ wɔn a wɔpɛ nam mmoroso ho,<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>efisɛ, akɔwensafo ne adidibradafo bɛyɛ ahiafo,</para>
  <para style="q2" vid="PRO 23:21">na anikum fura wɔn ntamagow.<verse eid="PRO 23:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>Tie wʼagya a ɔwoo wo no,</para>
  <para style="q2" vid="PRO 23:22">na sɛ wo na bɔ aberewa a, mmu no animtiaa.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>Tɔ nokware na ntɔn da;</para>
  <para style="q2" vid="PRO 23:23">nya nyansa, ahohyɛso ne nhumu.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Ɔtreneeni agya wɔ anigye bebree;</para>
  <para style="q2" vid="PRO 23:24">nea ɔwɔ ɔba nyansafo no ani gye ne ho.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Ma wʼagya ne wo na ani nnye;</para>
  <para style="q2" vid="PRO 23:25">ma ɔbea a ɔwoo wo no nnya ahosɛpɛw.<verse eid="PRO 23:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Me ba, fa wo koma ma me</para>
  <para style="q2" vid="PRO 23:26">na ma wʼani nkɔ mʼakwan ho,<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>na oguamanfo yɛ amoa donkudonku</para>
  <para style="q2" vid="PRO 23:27">ɔyere huhuni yɛ ɔdaadaafo.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Ɔtɛw, twɛn, te sɛ ɔkwanmukafo,</para>
  <para style="q2" vid="PRO 23:28">na ɔma mmarima mu atorofo dɔɔso.<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>Hena na wɔadome no? Hena na odi awerɛhow?</para>
  <para style="q2" vid="PRO 23:29">Hena na odi aperepere? Hena na onwiinwii?</para>
  <para style="q2" vid="PRO 23:29">Hena na ɔwɔ atape nko ara? Hena na mogya ada nʼani so?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Wɔn a wɔkyɛ nsa ho,</para>
  <para style="q2" vid="PRO 23:30">na wɔka nsa a wɔafrafra hwɛ.<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Nhwɛ nsa ani kɔkɔɔ no haa,</para>
  <para style="q2" vid="PRO 23:31">bere a ɛretwa yerɛw yerɛw wɔ kuruwa mu,</para>
  <para style="q2" vid="PRO 23:31">na ɛkɔ yɔɔ no.<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>Awiei no, ɛka te sɛ ɔwɔ</para>
  <para style="q2" vid="PRO 23:32">na ɛwɔ bɔre te sɛ ahurutoa.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Wʼani behu nneɛma a wunhuu da,</para>
  <para style="q2" vid="PRO 23:33">na woadwene nneɛma basabasa ho.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Wobɛtɔ ntintan te sɛ hyɛn mu dwumayɛni a,</para>
  <para style="q2" vid="PRO 23:34">okura hyɛn dua a, ɛrehinhim mu den, na ehinhim wɔ po so.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>Na wobɛka se, “Wɔbɔ me, nanso mimpira.</para>
  <para style="q2" vid="PRO 23:35">Wɔboro me, nanso mente ɔyaw biara.</para>
  <para style="q1" vid="PRO 23:35">Bere bɛn na menyan</para>
  <para style="q2" vid="PRO 23:35">akɔpɛ nsa anom bio?”<verse eid="PRO 23:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Mma wʼani mmere amumɔyɛfo,</para>
  <para style="q2" vid="PRO 24:1">mfa wo ho mmɔ wɔn;<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>Efisɛ wɔn koma dwene atirimɔdensɛm ho,</para>
  <para style="q2" vid="PRO 24:2">na wɔn ano ka nea ɛde basabasayɛ ba ho asɛm.<verse eid="PRO 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>Wɔde nyansa na esi fi,</para>
  <para style="q2" vid="PRO 24:3">na nhumu mu na wɔma etim;<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>ɛnam nimdeɛ so na wonya ademude a ɛho yɛ na</para>
  <para style="q2" vid="PRO 24:4">na ɛyɛ fɛ hyehyɛ nʼadan mu.<verse eid="PRO 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Onyansafo wɔ tumi a ɛso,</para>
  <para style="q2" vid="PRO 24:5">na onimdefo nyin ahoɔden mu;<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>nea ɔretu sa hia akwankyerɛ,</para>
  <para style="q2" vid="PRO 24:6">nea ɔrehwehwɛ nkonimdi no hia afotufo pii.<verse eid="PRO 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Nyansa wɔ soro dodo ma ɔkwasea;</para>
  <para style="q2" vid="PRO 24:7">wɔ apon ano aguabɔ mu no, ɛnsɛ sɛ wobue wɔn ano.<verse eid="PRO 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Onipa a ɔbɔ pɔw bɔne no,</para>
  <para style="q2" vid="PRO 24:8">wɔbɛfrɛ no ɔkɔtwebrɛfo.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Ogyimifo nhyehyɛe yɛ bɔne,</para>
  <para style="q2" vid="PRO 24:9">nnipa kyi ɔfɛwdifo.<verse eid="PRO 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Sɛ wʼaba mu gow wɔ ɔhaw mu a,</para>
  <para style="q2" vid="PRO 24:10">na wʼahoɔden sua!<verse eid="PRO 24:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>Gye wɔn a wɔde wɔn rekɔ akokum wɔn no nkwa;</para>
  <para style="q2" vid="PRO 24:11">na sianka wɔn a wɔtɔ ntintan kɔ akumii.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Sɛ woka se, “Na yennim eyi ho hwee a,”</para>
  <para style="q2" vid="PRO 24:12">nea ɔkari koma hwɛ no nhu ana?</para>
  <para style="q1" vid="PRO 24:12">Nea ɔbɔ wo nkwa ho ban no nnim ana?</para>
  <para style="q2" vid="PRO 24:12">Ɔrentua nea obiara ayɛ so ka ana?<verse eid="PRO 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Me ba, di ɛwo, efisɛ eye;</para>
  <para style="q2" vid="PRO 24:13">ɛwokyɛm mu wo yɛ wʼanom dɛ.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Hu nso sɛ nyansa yɛ wo kra dɛ;</para>
  <para style="q2" vid="PRO 24:14">sɛ wunya a, wowɔ anidaso ma daakye,</para>
  <para style="q2" vid="PRO 24:14">na wʼanidaso renyɛ ɔkwa.<verse eid="PRO 24:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>Nkɔtɛw ɔtreneeni fi sɛ ɔkwanmukafo,</para>
  <para style="q2" vid="PRO 24:15">na nkɔtow nhyɛ nʼatenae so,<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>Ɛwɔ mu sɛ ɔtreneeni hwe ase mpɛn ason de, nanso ɔsɔre bio,</para>
  <para style="q2" vid="PRO 24:16">na amumɔyɛfo de amanehunu baako ma wɔhwe ase.<verse eid="PRO 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>Sɛ wo tamfo hwe ase a mma ɛnyɛ wo dɛ;</para>
  <para style="q2" vid="PRO 24:17">na sɛ ohintiw a mma wo koma nni ahurusi,<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>efisɛ <char style="nd">Awurade</char> behu wʼadwene na ɔrempɛ</para>
  <para style="q2" vid="PRO 24:18">na obeyi nʼabufuwhyew afi no so.<verse eid="PRO 24:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>Nhaw wo ho wɔ abɔnefo nti,</para>
  <para style="q2" vid="PRO 24:19">na mma wʼani mmere amumɔyɛfo nso,<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>efisɛ, ɔbɔnefo nni anidaso biara daakye,</para>
  <para style="q2" vid="PRO 24:20">na wobedum amumɔyɛfo kanea.<verse eid="PRO 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Me ba, suro <char style="nd">Awurade</char> ne ɔhene,</para>
  <para style="q2" vid="PRO 24:21">na mfa wo ho mmɔ atuatewfo ho,<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>efisɛ saa baanu yi de, ɔsɛe bɛba wɔn so mpofirim;</para>
  <para style="q2" vid="PRO 24:22">na hena na onim amanehunu ko a wobetumi de aba?<verse eid="PRO 24:22"/></para>
  <para style="s1">Anyansafo Nsɛnka A Ɛkeka Ho</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>Eyinom nso yɛ anyansafo Nsɛnka:</para>
  <para style="q1" vid="PRO 24:23">Atemmu a nhwɛanim wɔ mu no nye:<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Obiara a ɔbɛka akyerɛ nea odi fɔ se, “Wo ho nni asɛm” no,</para>
  <para style="q2" vid="PRO 24:24">nnipa bɛdome no na amanaman remmɔ no din pa.<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>Na wɔn a wobu afɔdifo fɔ no, ebesi wɔn yiye,</para>
  <para style="q2" vid="PRO 24:25">na nhyira bɛba wɔn so.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Mmuae pa</para>
  <para style="q2" vid="PRO 24:26">te sɛ mfewano.<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Wie wo mfikyidwuma</para>
  <para style="q2" vid="PRO 24:27">na siesie wo mfuw;</para>
  <para style="q2" vid="PRO 24:27">ɛno akyi, si wo fi.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Nni adanse ntia ɔyɔnko a ɔnyɛɛ wo hwee,</para>
  <para style="q2" vid="PRO 24:28">na mfa wʼano nnaadaa.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>Nka se, “Nea wayɛ me no me nso mɛyɛ no bi;</para>
  <para style="q2" vid="PRO 24:29">nea ɔyɛe no mitua no so ka.”<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Menantew faa onihawfo afuw ho,</para>
  <para style="q2" vid="PRO 24:30">twaa mu wɔ nea onni adwene bobeturo nso ho;<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>nsɔe afuw wɔ baabiara,</para>
  <para style="q2" vid="PRO 24:31">wura afuw akata asase no so,</para>
  <para style="q2" vid="PRO 24:31">na abo afasu no nso abubu.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Mede me koma kɔɔ nea mihuu no so</para>
  <para style="q2" vid="PRO 24:32">na misuaa biribi fii mu:<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>nna kakra, nkotɔ kakra,</para>
  <para style="q2" vid="PRO 24:33">nsa a woabobɔw de rehome kakra<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>bɛma ohia aba wo so sɛ ɔkwanmukafo,</para>
  <para style="q2" vid="PRO 24:34">na nneɛma ho nna bɛba wo so sɛ obi a okura akode. Na ohia bɛtow akyere wo sɛ ɔkwanmukafo; ahokyere bɛtoa wo sɛ ɔkorɔmfowerɛmfo.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">Salomo Mmebusɛm Nkekaho</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>Eyinom yɛ Salomo mmebusɛm nkekaho a Yudahene Hesekia afotufo kyerɛwee:<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Ɛyɛ Onyankopɔn anuonyamhyɛ sɛ wɔde asɛm sie;</para>
  <para style="q2" vid="PRO 25:2">sɛ wɔpɛɛpɛɛ asɛm mu nso hyɛ ahemfo anuonyam.<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>Sɛnea ɔsoro korɔn na asase mu dɔ no,</para>
  <para style="q2" vid="PRO 25:3">saa ara na wɔrentumi nhwehwɛ ahemfo koma mu.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Sɛ woyi dwetɛ ho fi a,</para>
  <para style="q2" vid="PRO 25:4">na ato nea ɛkɔ dwetɛdwumfo nsam;<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>Yi amumɔyɛfo fi ɔhene anim,</para>
  <para style="q2" vid="PRO 25:5">na trenee bɛma nʼahengua atim.<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Mma wo ho so wɔ ɔhene anim,</para>
  <para style="q2" vid="PRO 25:6">na mpere dibea wɔ atitiriw mu;<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>Eye ma no sɛ ɔbɛka akyerɛ wo se, “Bra soro ha,”</para>
  <para style="q2" vid="PRO 25:7">sen sɛ ɔbɛbrɛ wo ase wɔ otitiriw bi anim.</para>
  <para style="b" vid="PRO 25:7"/>
  <para style="q1" vid="PRO 25:7">Nea wode wʼani ahu no<verse eid="PRO 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8"/>mpɛ ntɛm mfa nkɔ asennii,</para>
  <para style="q1" vid="PRO 25:8">na sɛ awiei no wo yɔnko gu wʼanim ase a</para>
  <para style="q2" vid="PRO 25:8">dɛn na wobɛyɛ?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>Sɛ wo ne wo yɔnko di asɛm a</para>
  <para style="q2" vid="PRO 25:9">nna obi foforo ahintasɛm adi,<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>anyɛ saa a, nea ɔbɛte no begu wʼanim ase</para>
  <para style="q2" vid="PRO 25:10">na din bɔne a wubenya no rempepa da.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Asɛm a wɔka no sɛnea ɛfata no</para>
  <para style="q2" vid="PRO 25:11">te sɛ sika kɔkɔɔ a wɔabɔ sɛ aprɛ</para>
  <para style="q2" vid="PRO 25:11">de atuatua dwetɛ nsiesiei mu.<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Sikakɔkɔɔ asokaa anaa sikakɔkɔɔ ankasa ahyehyɛde</para>
  <para style="q2" vid="PRO 25:12">te sɛ onyansafo animka a ɔde ma nea ɔyɛ aso ma no.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Sɛnea sukyerɛmma ma wim dwo wɔ otwabere mu no,</para>
  <para style="q2" vid="PRO 25:13">saa ara na ɔsomafo nokwafo te ma wɔn a wɔsoma no no;</para>
  <para style="q2" vid="PRO 25:13">na ɔma ne wuranom akomatɔyam.<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>Omununkum ne mframa a ɛmfa osu mma no</para>
  <para style="q2" vid="PRO 25:14">te sɛ onipa a ɔde akyɛde a ɔmmfa mma hoahoa ne ho.<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Ntoboase ma sodifo ti da,</para>
  <para style="q2" vid="PRO 25:15">na tɛkrɛmabere tumi bu dompe mu.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Sɛ wunya ɛwo a, nni ntra so,</para>
  <para style="q2" vid="PRO 25:16">ne bebrebe bɛma woafe.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Ntaa nkɔ wo yɔnko fi,</para>
  <para style="q2" vid="PRO 25:17">wo ho fono no a, ɔbɛtan wo.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Onipa a odi adansekurum tia ne yɔnko no</para>
  <para style="q2" vid="PRO 25:18">te sɛ kontibaa, afoa anaa bɛmma a ano yɛ nnam.<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Ɛse a ɛyare ɔkekaw anaa nan a ɛyɛ apakye</para>
  <para style="q2" vid="PRO 25:19">te sɛ nea wode wo ho to ɔtorofo so hiada mu.<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Nea ɔto dwom kyerɛ ɔwerɛhowni no,</para>
  <para style="q2" vid="PRO 25:20">te sɛ nea ɔpa ntama gu awɔwbere mu</para>
  <para style="q2" vid="PRO 25:20">anaa te sɛ nsa nyinyanyinya a wohwie gu apirakuru so.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Sɛ ɔkɔm de wo tamfo a, ma no aduan nni;</para>
  <para style="q2" vid="PRO 25:21">sɛ osukɔm de no a, ma no nsu nnom.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Sɛ woyɛ saa a, wobɛsosɔ nnyansramma agu nʼatifi,</para>
  <para style="q2" vid="PRO 25:22">na <char style="nd">Awurade</char> bɛma wo akatua.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>Sɛnea atifi fam mframa de osu ba no,</para>
  <para style="q2" vid="PRO 25:23">saa ara na tɛkrɛma a edi nseku de omuna ba.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Eye sɛ wobɛtena suhyɛ twɔtwɔw ase baabi,</para>
  <para style="q2" vid="PRO 25:24">sen sɛ wo ne ɔyere tɔkwapɛfo bɛtena fie.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>Nsuonwini a ɔkra a atɔ beraw nya no</para>
  <para style="q2" vid="PRO 25:25">te sɛ anigyesɛm a efi akyirikyiri.<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>Asuti a afono anaa abura a ayɛ pɔtɔɔ</para>
  <para style="q2" vid="PRO 25:26">te sɛ ɔtreneeni a ogyaa ne ho ma amumɔyɛfo.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Enye sɛ wodi ɛwo ntraso,</para>
  <para style="q2" vid="PRO 25:27">saa ara na ɛnyɛ anuonyam sɛ obi bɛhwehwɛ nsɛm a mu dɔ mu.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Onipa a onni ahohyɛso no</para>
  <para style="q2" vid="PRO 25:28">te sɛ kuropɔn a nʼafasu abubu agu fam.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>Sɛnea sukyerɛmma te ahuhurubere anaasɛ osu wɔ otwabere no,</para>
  <para style="q2" vid="PRO 26:1">saa ara na anuonyam mfata ɔkwasea.<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Sɛnea apatuprɛw tu anaasɛ asomfena tu dannan ne ho no,</para>
  <para style="q2" vid="PRO 26:2">saa ara na nnuabɔ hunu nsi hwee.<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Ɔkafo abaa wɔ hɔ ma ɔpɔnkɔ, nnareka wɔ hɔ ma afurum,</para>
  <para style="q2" vid="PRO 26:3">na abaa wɔ hɔ ma nkwaseafo akyi.<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>Nhwɛ ɔkwasea agyimisɛm so mma no mmuae,</para>
  <para style="q2" vid="PRO 26:4">anyɛ saa a wo nso bɛyɛ sɛ ɔno.<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>Gyina ɔkwasea agyimisɛm so ma no mmuae,</para>
  <para style="q2" vid="PRO 26:5">anyɛ saa a ɛbɛyɛ no sɛ onim nyansa.<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Sɛ wode nkra bi soma ɔkwasea a,</para>
  <para style="q2" vid="PRO 26:6">ɛte sɛ wutwitwa wʼankasa wʼanan anaasɛ wonom awuduru.<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>Apakye nan a awu na ɛsensɛn hɔ no,</para>
  <para style="q2" vid="PRO 26:7">yɛ mmebusɛm a ɛda ɔkwasea ano.<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Ɔbo a wɔakyekyere afam ahwimmo so</para>
  <para style="q2" vid="PRO 26:8">te sɛ anuonyam a wɔde ama ɔkwasea.<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Nsɔe dua a ɔkɔwensani kita no</para>
  <para style="q2" vid="PRO 26:9">te sɛ mmebusɛm a ɛda ɔkwasea ano.<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Nea ɔbɔ ɔkwasea anaa obi hunu paa no</para>
  <para style="q2" vid="PRO 26:10">te sɛ agyantowni a opira nnipa kwa.<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Sɛnea ɔkraman san kɔ ne fe ho no,</para>
  <para style="q2" vid="PRO 26:11">saa ara na ɔkwasea ti nʼagyimisɛm mu.<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Wuhu obi a ɔyɛ onyansafo wɔ nʼankasa ani so ana?</para>
  <para style="q2" vid="PRO 26:12">Anidaso pii wɔ ɔkwasea mu sen no.<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>Ɔkwadwofo ka se, “Gyata wɔ ɔkwan no mu,</para>
  <para style="q2" vid="PRO 26:13">gyatakeka nenam mmɔnten no so!”<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Sɛnea ɔpon di akɔneaba wɔ ne mpontare so no,</para>
  <para style="q2" vid="PRO 26:14">saa ara na ɔkwadwofo twa ne ho wɔ ne mpa so.<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>Ɔkwadwofo de ne nsa si aduan mu,</para>
  <para style="q2" vid="PRO 26:15">na ɛyɛ no anihaw sɛ obeyi akɔ nʼano.<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Ɔkwadwofo yɛ onyansafo wɔ ɔno ankasa ani so</para>
  <para style="q2" vid="PRO 26:16">sen nnipa baason a wodwen asɛm ho na wɔabua.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Obi a oso ɔkraman aso twe no no</para>
  <para style="q2" vid="PRO 26:17">te sɛ obi a ɔretwa mu na ɔde ne ho kɔfra ntɔkwaw a ɛmfa ne ho mu.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Ɔbɔdamfo a ɔtotow atuo</para>
  <para style="q2" vid="PRO 26:18">anaa agyanwerɛmfo no<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>te sɛ obi a, ɔdaadaa ne yɔnko</para>
  <para style="q2" vid="PRO 26:19">na ɔka se, “Na mede redi agoru!”<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Nnyansin hi a ogya dum;</para>
  <para style="q2" vid="PRO 26:20">nseku nni hɔ a ntɔkwaw to twa.<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>Sɛnea gyabiriw dan nnyansramma na nnyina dan ogya no,</para>
  <para style="q2" vid="PRO 26:21">saa ara na ɔtɔkwapɛfo hyɛ ntɔkwaw mu takramugya.<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>Osekuni ano asɛm te sɛ aduan a ɛyɛ dɛ;</para>
  <para style="q2" vid="PRO 26:22">ɛhyɛnhyɛn onipa akwaa mu nyinaa.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Sɛnea ama kata asankagow ho no</para>
  <para style="q2" vid="PRO 26:23">saa ara na tɛkrɛmadɛ kata amumɔyɛ koma so.<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Onipa bɔne kasa te sɛ nea oye,</para>
  <para style="q2" vid="PRO 26:24">nanso nnaadaa ahyɛ ne koma ma.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>Ɛwɔ mu sɛ ne kasa yɛ dɛ de, nanso nnye no nni,</para>
  <para style="q2" vid="PRO 26:25">efisɛ abususɛm ason ahyɛ ne koma ma.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Ebia nnaadaa bɛkata nʼadwemmɔne so,</para>
  <para style="q2" vid="PRO 26:26">nanso nʼamumɔyɛsɛm bɛda adi wɔ bagua mu.<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Sɛ onipa tu amoa a, ɔbɛtɔ mu;</para>
  <para style="q2" vid="PRO 26:27">sɛ onipa pirew ɔbo a, ɛbɛsan aba no so.<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Atoro tɛkrɛma kyi wɔn a ogu wɔn ho fi,</para>
  <para style="q2" vid="PRO 26:28">na adɛfɛdɛfɛ ano de ɔsɛe ba.<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Mfa ɔkyena nhoahoa wo ho,</para>
  <para style="q2" vid="PRO 27:1">na wunnim nea ɛda bi de bɛba.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>Ma ɔfoforo nkamfo wo; na ɛnyɛ wo ankasa;</para>
  <para style="q2" vid="PRO 27:2">ma emfi ɔfoforo anom na ɛnyɛ wo.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Ɔbo mu yɛ duru, na nwea yɛ adesoa,</para>
  <para style="q2" vid="PRO 27:3">nanso ɔkwasea abufuwhyew yɛ duru sen emu biara.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Abufuw tirim yɛ den, na abufuwhyew sɛe ade,</para>
  <para style="q2" vid="PRO 27:4">na hena na obetumi agyina ninkutwe ano?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Animka a ɛda gua</para>
  <para style="q2" vid="PRO 27:5">ye sen ɔdɔ a asuma.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Apirakuru a efi adamfo nkyɛn no ye</para>
  <para style="q2" vid="PRO 27:6">sen ɔtamfo mfewano bebrebe.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Ɛwo nyɛ nea wamee akɔnnɔ,</para>
  <para style="q2" vid="PRO 27:7">nanso nea ɛyɛ nwen mpo yɛ nea ɔkɔm de no no nʼanom dɛ.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Onipa a wayera ne fi kwan,</para>
  <para style="q2" vid="PRO 27:8">te sɛ anomaa a wafi ne berebuw mu rekyinkyin.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>Ngo ne aduhuam ma koma ani gye,</para>
  <para style="q2" vid="PRO 27:9">adamfo ho anigye fi nʼafotu pa a ɔma.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Nnyaa wʼadamfo ne wʼagya adamfo mu,</para>
  <para style="q2" vid="PRO 27:10">nkɔ wo nuabarima fi bere a ɔhaw ato wo,</para>
  <para style="q2" vid="PRO 27:10">na ɔyɔnko a ɔbɛn wo no ye sen onuabarima a ɔwɔ akyirikyiri.<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>Me ba, hu nyansa na ma me koma ani nnye;</para>
  <para style="q2" vid="PRO 27:11">ɛno na ɛbɛma manya mmuae ama obiara a obu me animtiaa.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Mmadwemma hu asiane na wohintaw,</para>
  <para style="q2" vid="PRO 27:12">nanso ntetekwaafo kɔ wɔn anim kɔtɔ mu.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Fa atade a ɛhyɛ obi a odi ɔhɔho akagyinamu;</para>
  <para style="q2" vid="PRO 27:13">sɛ ɔregyina ɔbea huhufo akyi a, fa si awowa.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Sɛ obi teɛ mu hyira ne yɔnko anɔpahema a,</para>
  <para style="q2" vid="PRO 27:14">wɔbɛfa no sɛ ɛyɛ nnome.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>Ɔyere tɔkwapɛfo te sɛ</para>
  <para style="q2" vid="PRO 27:15">ahumtuda nsusosɔ wɔ ɔdan a enwin so;<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>sɛ wopata no a, ɛte sɛ nea wopata mframa</para>
  <para style="q2" vid="PRO 27:16">anaa wode wo nsa beso ngo mu.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>Dade sew dade,</para>
  <para style="q2" vid="PRO 27:17">saa ara na onipa sew ɔfoforo.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Nea ɔhwɛ borɔdɔma dua so no bedi so aba,</para>
  <para style="q2" vid="PRO 27:18">na nea ɔsom ne wura no, wɔbɛhyɛ no anuonyam.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>Sɛnea nsu yi animdua kyerɛ no,</para>
  <para style="q2" vid="PRO 27:19">saa ara na onipa koma da onipa no adi.<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>Sɛnea Owu ne Ɔsɛe bo ntɔ da no,</para>
  <para style="q2" vid="PRO 27:20">saa ara, na onipa ani nso bo ntɔ da.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Kyɛmfɛre wɔ hɔ ma dwetɛ na fononoo wɔ hɔ ma sikakɔkɔɔ,</para>
  <para style="q2" vid="PRO 27:21">nanso wɔnam nkamfo a onipa nya so na ɛsɔ no hwɛ.<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>Sɛ wowɔw ɔkwasea wɔ ɔwaduru mu,</para>
  <para style="q2" vid="PRO 27:22">sɛ wode ɔwɔma wɔw no te sɛnea wusiw aburow a,</para>
  <para style="q2" vid="PRO 27:22">worentumi nyi agyimisɛm mfi ne ho.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>Ma ɛnyɛ wo asɛnhia sɛ wubehu wo nguankuw tebea,</para>
  <para style="q2" vid="PRO 27:23">na ma wʼani nkɔ wo anantwikuw so;<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>efisɛ, ahonya ntena hɔ daa,</para>
  <para style="q2" vid="PRO 27:24">na ahenkyɛw ntena hɔ mma awo ntoantoaso nyinaa.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Sɛ wotwa sare no na foforo fifi,</para>
  <para style="q2" vid="PRO 27:25">na wɔboaboa nkoko so sare no ano a,<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>ɛno de, nguantenmma no bɛma wo ntama,</para>
  <para style="q2" vid="PRO 27:26">na mmirekyi ama sika a ɛtɔ mfuw.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Wubenya mmirekyi nufusu bebree</para>
  <para style="q2" vid="PRO 27:27">ama wo ne wʼabusuafo adi</para>
  <para style="q2" vid="PRO 27:27">ne aduan ama wo mmaawa.<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Omumɔyɛfo guan bere a obiara ntaa no,</para>
  <para style="q2" vid="PRO 28:1">nanso atreneefo koko yɛ duru sɛ gyata.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Atuatewman nya sodifo pii,</para>
  <para style="q2" vid="PRO 28:2">nanso onipa a ɔwɔ nhumu ne nimdeɛ ma mmara yɛ adwuma.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Sodifo a ɔhyɛ ahiafo so no</para>
  <para style="q2" vid="PRO 28:3">te sɛ osu mu ahum a ennyaw nnɔbae bi wɔ akyi.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Wɔn a wɔpo mmara no kamfo amumɔyɛfo,</para>
  <para style="q2" vid="PRO 28:4">na wɔn a wodi mmara so no siw wɔn kwan.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Abɔnefo nte atɛntrenee ase,</para>
  <para style="q2" vid="PRO 28:5">nanso wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no, te ase yiye.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>Ohiani a ne nantew ho nni asɛm</para>
  <para style="q2" vid="PRO 28:6">ye sen ɔdefo a nʼakwan yɛ kɔntɔnkye.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Nea odi mmara so yɛ ɔba a ɔwɔ nhumu,</para>
  <para style="q2" vid="PRO 28:7">nanso nea ɔne adidibradafo bɔ no gu nʼagya anim ase.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Nea ogye mfɛntom mmoroso de nya ne ho no,</para>
  <para style="q2" vid="PRO 28:8">ɔboaboa ano ma nea ɔbɛyɛ ahiafo adɔe.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Sɛ obi nni mmara so a,</para>
  <para style="q2" vid="PRO 28:9">ne mpaebɔ mpo yɛ akyiwade.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Nea odi atreneefo anim de wɔn fa ɔkwan bɔne so no</para>
  <para style="q2" vid="PRO 28:10">bɛhwe ɔno ankasa afiri mu,</para>
  <para style="q2" vid="PRO 28:10">nanso wɔn a wɔn ho nni asɛm no benya agyapade a eye.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Ɔdefo tumi yɛ onyansafo wɔ nʼankasa ani so,</para>
  <para style="q2" vid="PRO 28:11">nanso ohiani a ɔwɔ nhumu no hu sɛnea ɔte.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Sɛ atreneefo di nkonim a, nnipa di ahurusi pii;</para>
  <para style="q2" vid="PRO 28:12">nanso sɛ amumɔyɛfo nya tumi a nnipa kohintaw.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Onipa a ɔkata ne bɔne so no nnya nkɔso,</para>
  <para style="q2" vid="PRO 28:13">na nea ɔka ne bɔne na ogyae yɛ no nya ahummɔbɔ.<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>Nhyira nka nea osuro <char style="nd">Awurade</char> bere nyinaa,</para>
  <para style="q2" vid="PRO 28:14">nanso nea opirim ne koma no tɔ amane mu.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Omumɔyɛfo a odi nnipa a wonni mmoa so no</para>
  <para style="q2" vid="PRO 28:15">te sɛ gyata a ɔbobɔ mu anaa sisi a nʼani abere.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Ɔsodifo tirimɔdenfo nni adwene,</para>
  <para style="q2" vid="PRO 28:16">na nea okyi mfaso a wɔnam ɔkwan bɔne so nya no benya nkwa tenten.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Nea awudi ma ne tiboa bu no fɔ no</para>
  <para style="q2" vid="PRO 28:17">bɛyɛ ɔkobɔfo akosi ne wu da;</para>
  <para style="q2" vid="PRO 28:17">wɔmma obiara nsiw no kwan.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Nea ne nantew ho nni asɛm no, wogye no fi ɔhaw mu,</para>
  <para style="q2" vid="PRO 28:18">nanso nea nʼakwan yɛ kɔntɔnkye no bɛhwe ase mpofirim.<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>Nea ɔyɛ nʼasase so adwuma no benya aduan pii,</para>
  <para style="q2" vid="PRO 28:19">nanso wɔn a wodi nnaadaasɛm akyi no benya wɔn so ne wɔn hia.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Wobehyira onipa nokwafo pii,</para>
  <para style="q2" vid="PRO 28:20">na nea ɔpere pɛ ahonyade no remfa ne ho nni.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Nhwɛanim nye,</para>
  <para style="q2" vid="PRO 28:21">nanso aduan kakraa bi nti nnipa bɛyɛ bɔne.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Nea ɔyɛ pɛpɛe pere sɛ ɔbɛyɛ ɔdefo</para>
  <para style="q2" vid="PRO 28:22">na onnim sɛ ohia retwɛn no.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Nea ɔka obi anim no bɛsɔ nnipa ani akyiri no</para>
  <para style="q2" vid="PRO 28:23">asen nea ɔwɔ tɛkrɛmadɛ.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Nea ɔbɔ nʼagya anaa ne na korɔn</para>
  <para style="q2" vid="PRO 28:24">na ɔka se, “Ɛnyɛ bɔne no,”</para>
  <para style="q2" vid="PRO 28:24">ɔne ɔsɛefo na ɛbɔ.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Odifudepɛfo de mpaapaemu ba</para>
  <para style="q2" vid="PRO 28:25">na nea ɔde ne ho to <char style="nd">Awurade</char> so no benya nkɔso.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Nea ogye ne ho di no yɛ ɔkwasea,</para>
  <para style="q2" vid="PRO 28:26">na nea ɔnantew nyansa mu no wobegye no.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Nea ɔma ahiafo no, hwee renhia no,</para>
  <para style="q2" vid="PRO 28:27">nanso nea obu nʼani gu wɔn so no nya nnome pii.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Sɛ amumɔyɛfo nya tumi a, nnipa kohintaw;</para>
  <para style="q2" vid="PRO 28:28">na sɛ amumɔyɛfo ase tɔre a, atreneefo ase dɔ.<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Obi a ɔkɔ so yɛ tufoante wɔ animka pii akyi no</para>
  <para style="q2" vid="PRO 29:1">wɔbɛsɛe no mpofirim a wɔrennya ano aduru.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Sɛ atreneefo di yiye a, nnipa no di ahurusi;</para>
  <para style="q2" vid="PRO 29:2">sɛ amumɔyɛfo di nnipa so a, wusi apini.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Onipa a ɔdɔ nyansa no ma nʼagya anigye,</para>
  <para style="q2" vid="PRO 29:3">nanso nguamanfo yɔnko sɛe nʼahonya.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>Ɔhene nam atɛntrenee so ma ɔman no asomdwoe,</para>
  <para style="q2" vid="PRO 29:4">nanso nea ɔde adifudepɛ gye adanmude no bɔ ɔman no.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Obiara a ɔdaadaa ne yɔnko no</para>
  <para style="q2" vid="PRO 29:5">sum ne nan afiri.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Ɔdebɔneyɛni bɔne sum no afiri,</para>
  <para style="q2" vid="PRO 29:6">nanso ɔtreneeni betumi ato dwom ama nʼani agye.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Ahiafo atɛntreneebu ho hia atreneefo,</para>
  <para style="q2" vid="PRO 29:7">nanso amumɔyɛfo nni saa ɔtema no.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Fɛwdifo de basabasayɛ ba kuropɔn mu,</para>
  <para style="q2" vid="PRO 29:8">nanso anyansafo sianka abufuw.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Sɛ onyansafo de ɔkwasea kɔ asennii a,</para>
  <para style="q2" vid="PRO 29:9">ɔkwasea no bobɔ mu kasa di fɛw, na asomdwoe mma.<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Mogyapɛfo kyi ɔnokwafo,</para>
  <para style="q2" vid="PRO 29:10">na wɔhwehwɛ sɛ wobekum nea ɔteɛ.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Ɔkwasea da abufuw nyinaa adi,</para>
  <para style="q2" vid="PRO 29:11">nanso onyansafo hyɛ ne ho so.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Sɛ ɔsodifo tie nkontomposɛm a,</para>
  <para style="q2" vid="PRO 29:12">nʼadwumayɛfo nyinaa bɛyɛ amumɔyɛfo.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Ohiani ne ɔsohyɛfo nyinaa wɔ saa ade baako yi:</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">Awurade</char> ma wɔn baanu nyinaa ani a wɔde hu ade.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Sɛ ɔhene di ahiafo asɛm yiye a,</para>
  <para style="q2" vid="PRO 29:14">nʼahengua betim hɔ daa.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>Nteɛso abaa ma nyansa,</para>
  <para style="q2" vid="PRO 29:15">na abofra a wɔde ne pɛ ma no no, gu ne na anim ase.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Sɛ amumɔyɛfo di yiye a, bɔne nso kɔ so,</para>
  <para style="q2" vid="PRO 29:16">na atreneefo behu wɔn asehwe.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Teɛ wo ba, na ɔbɛma wo asomdwoe;</para>
  <para style="q2" vid="PRO 29:17">ɔbɛma wo kra ani agye.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Sɛ anisoadehu nni hɔ a nnipa no yɛ basaa;</para>
  <para style="q2" vid="PRO 29:18">na nhyira nka nea odi mmara so.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Wɔmfa anom nsɛm kɛkɛ nteɛ ɔsomfo;</para>
  <para style="q2" vid="PRO 29:19">ɔte ase de, nanso ɔremfa.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Wuhu obi a ɔpɛ ntɛm kasa ana?</para>
  <para style="q2" vid="PRO 29:20">Ɔkwasea wɔ anidaso sen no.<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Sɛ obi kokɔ ne somfo fi ne mmofraase a,</para>
  <para style="q2" vid="PRO 29:21">awiei no ɔde awerɛhow na ɛbɛba.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Onipa a ne bo afuw de mpaapaemu ba,</para>
  <para style="q2" vid="PRO 29:22">na nea ne bo nkyɛ fuw no yɛ bɔne pii.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Onipa ahomaso brɛ no ase,</para>
  <para style="q2" vid="PRO 29:23">nanso nea ɔwɔ ahobrɛase no nya anuonyam.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Nea ɔboa ɔkorɔmfo no haw ɔno ankasa ho.</para>
  <para style="q2" vid="PRO 29:24">Wɔama waka ntam nti osuro sɛ obedi adanse.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Onipa ho suro betumi ayɛ afiri,</para>
  <para style="q2" vid="PRO 29:25">na nea ɔde ne ho to <char style="nd">Awurade</char> so no, wobegye no.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Bebree hwehwɛ sɛ wobenya ɔhene ne no akasa,</para>
  <para style="q2" vid="PRO 29:26">nanso onipa nya atɛntrenee fi <char style="nd">Awurade</char> nkyɛn.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Atreneefo kyi atorofo;</para>
  <para style="q2" vid="PRO 29:27">na amumɔyɛfo kyi wɔn a wɔn akwan teɛ.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">Agur Nsɛm A Ɔkae</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Yake babarima Agur nsɛm a ɔkae a ɛyɛ nkuranhyɛ:</para>
  <para style="q1" vid="PRO 30:1">Saa ɔbarima yi ka kyerɛɛ Itiel ne Ukal se:<verse eid="PRO 30:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>“Me na minnim hwee koraa wɔ nnipa mu,</para>
  <para style="q2" vid="PRO 30:2">minni onipa ntease.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>Minsuaa nyansa,</para>
  <para style="q2" vid="PRO 30:3">na minni Ɔkronkronni no ho nimdeɛ nso.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>Hena na waforo akɔ ɔsoro na wasian aba fam?</para>
  <para style="q2" vid="PRO 30:4">Hena na wabɔ mframa boa wɔ ne nsam?</para>
  <para style="q1" vid="PRO 30:4">Hena na ɔde nʼatade abɔ nsu boa?</para>
  <para style="q2" vid="PRO 30:4">Hena na ɔbɔɔ asase tamaa yi?</para>
  <para style="q1" vid="PRO 30:4">Ne din de dɛn, na ne babarima nso din de dɛn?</para>
  <para style="q2" vid="PRO 30:4">Sɛ wunim a ka kyerɛ me!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“Onyankopɔn asɛm biara yɛ nokware;</para>
  <para style="q2" vid="PRO 30:5">ɔyɛ nkatabo ma wɔn a woguan toa no.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>Mfa biribi nka nʼasɛm ho,</para>
  <para style="q2" vid="PRO 30:6">anyɛ saa a ɔbɛka wʼanim ama woayɛ ɔtorofo.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“<char style="nd">Awurade</char>, nneɛma abien na mehwehwɛ afi wo nkyɛn;</para>
  <para style="q2" vid="PRO 30:7">mfa nkame me ansa na mawu:<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>ma me ne atoro ne nnaadaasɛm ntam nware koraa;</para>
  <para style="q2" vid="PRO 30:8">mma mennyɛ ohiani anaa ɔdefo;</para>
  <para style="q2" vid="PRO 30:8">nanso ma me me daa aduan nkutoo.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>Anyɛ saa a, ebia minya me ho pii a ɛbɛma mapa wo</para>
  <para style="q2" vid="PRO 30:9">na maka se, ‘Hena ne <char style="nd">Awurade</char>?’</para>
  <para style="q1" vid="PRO 30:9">Anaa mɛyɛ ohiani na mabɔ korɔn,</para>
  <para style="q2" vid="PRO 30:9">na ama magu me Nyankopɔn din ho fi.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“Nsɛe ɔsomfo din nkyerɛ ne wura;</para>
  <para style="q2" vid="PRO 30:10">sɛ woyɛ saa a, ɔbɛdome wo na wubetua so ka.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>“Nnipa bi dome wɔn agyanom,</para>
  <para style="q2" vid="PRO 30:11">na wonhyira wɔn nanom nso;<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>Wɔn a wɔteɛ wɔ wɔn ankasa ani so</para>
  <para style="q2" vid="PRO 30:12">nanso wɔnhohoroo wɔn ho fi no;<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>wɔn a wɔn ani tra ntɔn,</para>
  <para style="q2" vid="PRO 30:13">na wobu animtiaa;<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>wɔn a wɔn se yɛ afoa</para>
  <para style="q2" vid="PRO 30:14">na asekan hyehyɛ wɔn abogye mu</para>
  <para style="q1" vid="PRO 30:14">wɔn na wɔbɛtɔre ahiafo ase afi asase so,</para>
  <para style="q2" vid="PRO 30:14">na wɔayi ahiafo afi adesamma mu.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“Amemem wɔ mmabea baanu</para>
  <para style="q2" vid="PRO 30:15">a wɔteɛ mu se, ‘Fa ma! Fa ma!’ </para>
  <para style="b" vid="PRO 30:15"/>
  <para style="li1" vid="PRO 30:15">“Nneɛma abiɛsa na ɛmmee da</para>
  <para style="li2" vid="PRO 30:15">anan na ɛnka da se, ‘Eye!’<verse eid="PRO 30:15"/></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16"/>Ɔda,</para>
  <para style="li3" vid="PRO 30:16">obonin awotwaa,</para>
  <para style="li3" vid="PRO 30:16">asase a ɛyɛ wosee daa,</para>
  <para style="li3" vid="PRO 30:16">ne ogya a ɛnka da se, ‘Eye!’ <verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“Ani a eyi agya ahi,</para>
  <para style="q2" vid="PRO 30:17">na ebu ɛna animtiaa no,</para>
  <para style="q1" vid="PRO 30:17">obon mu kwaakwaadabi betutu,</para>
  <para style="q2" vid="PRO 30:17">na apete abedi.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18"/>“Nneɛma abiɛsa na ɛyɛ me nwonwa,</para>
  <para style="li2" vid="PRO 30:18">anan na mente ase:<verse eid="PRO 30:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19"/>Ɔkwan a ɔkɔre nam so wɔ wim,</para>
  <para style="li3" vid="PRO 30:19">sɛnea ɔwɔ nantew ɔbotan so,</para>
  <para style="li3" vid="PRO 30:19">ɔkwan a hyɛn nam so wɔ po tamaa so,</para>
  <para style="li3" vid="PRO 30:19">ne sɛnea ɔbarima dɔ ababaa.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“Ɔbea ɔwaresɛefo kwan ni:</para>
  <para style="q2" vid="PRO 30:20">Odidi, ɔpepa nʼano</para>
  <para style="q2" vid="PRO 30:20">na ɔka se, ‘Menyɛɛ mfomso biara.’ <verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21"/>“Nneɛma abiɛsa na ɛma asase wosow,</para>
  <para style="li2" vid="PRO 30:21">anan na asase ntumi nnyina ano:<verse eid="PRO 30:21"/></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22"/>akoa a wabɛyɛ ɔhene,</para>
  <para style="li3" vid="PRO 30:22">ɔkwasea a wadidi amee,<verse eid="PRO 30:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23"/>ɔbea a wɔmpɛ no na waware,</para>
  <para style="li3" vid="PRO 30:23">afenaa a otu nʼawuraa tena nʼanan mu.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24"/>“Nneɛma nketenkete anan na ɛwɔ asase so,</para>
  <para style="li2" vid="PRO 30:24">nanso wɔyɛ anyansafo ankasa:<verse eid="PRO 30:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25"/>Ntɛtea yɛ abɔde nketewa a wonni ahoɔden,</para>
  <para style="li3" vid="PRO 30:25">nanso wɔboaboa wɔn aduan ano ahuhuru bere mu;<verse eid="PRO 30:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26"/>Nkukuban<note caller="+" style="f"><char style="fr" closed="false">30.26 </char><char style="ft" closed="false">Nkukuban yɛ nnanko mu ahorow bi a, wɔtena akuwakuw wɔ mmepɔw mu.</char></note> yɛ abɔde a wonni ahoɔden,</para>
  <para style="li3" vid="PRO 30:26">nanso wɔyɛ wɔn afi wɔ abotan mu,<verse eid="PRO 30:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27"/>mmoadabi nni ɔhene,</para>
  <para style="li3" vid="PRO 30:27">nanso wɔsa so akuwakuw, kɔ wɔn anim;<verse eid="PRO 30:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28"/>wotumi de nsa kyere ɔketew,</para>
  <para style="li3" vid="PRO 30:28">nanso wohu no abirɛmpɔn ahemfi.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29"/>“Nneɛma abiɛsa na wɔwɔ abirɛmpɔnnantew,</para>
  <para style="li2" vid="PRO 30:29">anan na wɔkeka wɔn ho te sɛ abirɛmpɔn:<verse eid="PRO 30:29"/></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30"/>gyata, mmoadoma hene a, biribiara mmɔ no hu;<verse eid="PRO 30:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31"/>akokɔnini a ɔretutu taataa,</para>
  <para style="li3" vid="PRO 30:31">ɔpapo,</para>
  <para style="li3" vid="PRO 30:31">ne ɔhene a nʼasraafo atwa no ho ahyia.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“Sɛ woayɛ ɔkwasea ama wo ho so,</para>
  <para style="q2" vid="PRO 30:32">anaa woadwene bɔne a,</para>
  <para style="q2" vid="PRO 30:32">ma wʼani nwu na mua wʼano!<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Sɛnea wɔka nufusu nu mu a srade fi mu ba,</para>
  <para style="q2" vid="PRO 30:33">na wokyinkyim hwene a etu mogya no,</para>
  <para style="q2" vid="PRO 30:33">saa ara na abufuw de akasakasa ba.”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">Ɔhene Lemuel Nsɛm</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Ɔhene Lemuel nsɛm a ɛyɛ nkuranhyɛ a ne na kyerɛɛ no:<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>Tie, me babarima! Tie, me yafunu ba,</para>
  <para style="q2" vid="PRO 31:2">Tie, me bɔhyɛ ba, me mpaebɔ ho mmuae!<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>Nsɛe wʼahoɔden wɔ mmea<note caller="+" style="f"><char style="fr" closed="false">31.3 </char><char style="ft" closed="false">Saa mmea yi yɛ mmea nguamanfo a wɔwɔ ahemfi a wobetumi atwe ɔhene adwene afi nʼadwuma so.</char></note> ho,</para>
  <para style="q2" vid="PRO 31:3">wɔn a wogu ahemfo asu no.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>Enye mma ahemfo, Lemuel,</para>
  <para style="q2" vid="PRO 31:4">asanom nye mma ahemfo,</para>
  <para style="q2" vid="PRO 31:4">ɛnsɛ sɛ sodifo pere bobesa ho;<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>sɛ wɔnom nsa a wɔn werɛ befi nea mmara no ka,</para>
  <para style="q2" vid="PRO 31:5">na wɔn a wɔhyɛ wɔn so no rennya nea ɛyɛ wɔn kyɛfa.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Fa bobesa ma wɔn a wɔresɛe,</para>
  <para style="q2" vid="PRO 31:6">na fa nsa ma wɔn a wɔwɔ amanehunu mu;<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>Momma wɔnnom, na wɔn werɛ mfi wɔn hia,</para>
  <para style="q2" vid="PRO 31:7">na wɔnnkae wɔn awerɛhow bio.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>Kasa ma wɔn a wontumi nkasa mma wɔn ho,</para>
  <para style="q2" vid="PRO 31:8">kasa ma mmɔborɔfo yiyedi.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Kasa na bu atɛntrenee;</para>
  <para style="q2" vid="PRO 31:9">kasa ma ahiafo ne onnibi yiyedi.<verse eid="PRO 31:9"/></para>
  <para style="s1">Awiei: Ɔyere A Ɔsom Bo</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Ɔyere pa, hena na obenya?</para>
  <para style="q2" vid="PRO 31:10">Ɔsom bo pa ara sen nhene pa.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Ne kunu wɔ ne mu ahotoso pa ara,</para>
  <para style="q2" vid="PRO 31:11">na biribiara a ɛwɔ bo nhia no.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Ɔde nea eye brɛ no, na ɛnyɛ ɔhaw,</para>
  <para style="q2" vid="PRO 31:12">ne nkwanna nyinaa mu.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Ɔhwehwɛ oguannwi ne asaawa</para>
  <para style="q2" vid="PRO 31:13">na ɔde ne nsa nwen wɔ fɛw so.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Ɔte sɛ aguadifo ahyɛn,</para>
  <para style="q2" vid="PRO 31:14">ɔde ne nnuan fi akyirikyiri ba.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Ade nnya nkyee no na wasɔre;</para>
  <para style="q2" vid="PRO 31:15">osiesie aduan ma nʼabusuafo</para>
  <para style="q2" vid="PRO 31:15">na ɔkyekyɛ nnwuma ma ne mmaawa.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Osusuw afuw ho na ɔtɔ;</para>
  <para style="q2" vid="PRO 31:16">ofi nea onya mu yɛ bobeturo.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Ɔde nsi yɛ nʼadwuma;</para>
  <para style="q2" vid="PRO 31:17">nʼabasa mu wɔ ahoɔden ma nʼadwuma.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Ɔhwɛ sɛ nʼaguadi so wɔ mfaso,</para>
  <para style="q2" vid="PRO 31:18">na ne kanea anum anadwo.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Daa, na ne nsa kura tadua mu</para>
  <para style="q2" vid="PRO 31:19">a ne nsateaa nso retoatoa asaawa.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Ogow ne nsam ma ahiafo</para>
  <para style="q2" vid="PRO 31:20">na ne nsa so ohiani so.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Sɛ sukyerɛmma tɔ a ne yam nhyehye no wɔ ne fifo ho;</para>
  <para style="q2" vid="PRO 31:21">efisɛ wɔn nyinaa wɔ adurade a wɔde ko awɔw.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Ɔyɛ ne mpasotam;</para>
  <para style="q2" vid="PRO 31:22">na ofura nwera ne sirikyi ntama.<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Ne kunu wɔ anuonyam wɔ kuropɔn pon ano,</para>
  <para style="q2" vid="PRO 31:23">faako a ɔne asase no so mpanyimfo tena.<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Ɔpempam nwera ntade tontɔn,</para>
  <para style="q2" vid="PRO 31:24">na otu nkyekyeremu ma aguadifo.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Ɔwɔ ahoɔden ne anuonyam;</para>
  <para style="q2" vid="PRO 31:25">na onsuro nna a ɛwɔ nʼanim.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Ɔkasa nyansa mu,</para>
  <para style="q2" vid="PRO 31:26">na nokware nkyerɛkyerɛ wɔ ne tɛkrɛma so.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Ɔhwɛ ne fi mu nnwuma so</para>
  <para style="q2" vid="PRO 31:27">na onnyigye anihaw so.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Ne mma sɔre a wɔfrɛ no nhyira;</para>
  <para style="q2" vid="PRO 31:28">ne kunu nso saa ara, na ɔkamfo no se,<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“Mmea pii yɛ nneɛma a ɛwɔ din</para>
  <para style="q2" vid="PRO 31:29">na wo de, wosen wɔn nyinaa.”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Ɔbea kɔnnɔfo yɛ nnaadaa, na ahoɔfɛ twa mu ntɛm so;</para>
  <para style="q2" vid="PRO 31:30">nanso ɔbea a osuro <char style="nd">Awurade</char> no fata nkamfo.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Fa abasobɔde a wanya no ma no,</para>
  <para style="q2" vid="PRO 31:31">na wɔnkamfo ne nnwuma wɔ kuropɔn pon ano.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
