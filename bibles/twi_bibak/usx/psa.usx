<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Nnwom</para>
  <para style="toc1">Nnwom</para>
  <para style="toc2">Nnwom</para>
  <para style="toc3">Nnw</para>
  <para style="mt1">Nnwom</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">ƆFA A EDI KAN</para>
  <para style="mr">
    <ref loc="PSA 1-41">Nnwom 1–41</ref></para>
  <para style="cl">Dwom 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Nhyira ne onipa a</para>
  <para style="q2" vid="PSA 1:1">ontie amumɔyɛfo afotu</para>
  <para style="q1" vid="PSA 1:1">na onni nnebɔneyɛfo nhwɛso akyi</para>
  <para style="q2" vid="PSA 1:1">na ɔntena fɛwdifo tenabea.<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>Na mmom, <char style="nd">Awurade</char> mmara sɔ nʼani,</para>
  <para style="q2" vid="PSA 1:2">na osusuw ho awia ne anadwo.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Ɔte sɛ dua a wɔatɛw wɔ asuten ho,</para>
  <para style="q2" vid="PSA 1:3">na ɛsow nʼaba ne bere mu a</para>
  <para style="q1" vid="PSA 1:3">nʼahaban no nguan da.</para>
  <para style="q2" vid="PSA 1:3">Nea ɔyɛ biara yɛ yiye.<verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Nanso nnebɔneyɛfo nte saa;</para>
  <para style="q2" vid="PSA 1:4">wɔte sɛ ntɛtɛ a</para>
  <para style="q2" vid="PSA 1:4">mframa bɔ gu.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Enti amumɔyɛfo rentumi nnyina atemmu no ano,</para>
  <para style="q2" vid="PSA 1:5">na nnebɔneyɛfo nso rentena atreneefo asafo mu.<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Efisɛ <char style="nd">Awurade</char> kyerɛ ɔtreneeni kwan</para>
  <para style="q2" vid="PSA 1:6">nanso amumɔyɛfo kwan de, ɛbɛyera.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">Dwom 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>Adɛn nti na amanaman no hyehyɛ bɔne ho</para>
  <para style="q2" vid="PSA 2:1">na nnipa no bɔ pɔw hunu yi?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Asase so ahemfo sɔre gyina</para>
  <para style="q2" vid="PSA 2:2">na sodifo ka wɔn ho bɔ mu</para>
  <para style="q2" vid="PSA 2:2">tia <char style="nd">Awurade</char> ne Nea Wɔasra no no.<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>Wɔka se,</para>
  <para style="q2" vid="PSA 2:3">“Momma yemmubu wɔn nkɔnsɔnkɔnsɔn</para>
  <para style="q2" vid="PSA 2:3">na yɛntow wɔn mpokyerɛ ngu.”<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Nea ɔte agua so wɔ ɔsoro no serew;</para>
  <para style="q2" vid="PSA 2:4">
    <char style="nd">Awurade</char> di wɔn ho fɛw.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Afei ɔka wɔn anim wɔ nʼabufuw mu,</para>
  <para style="q2" vid="PSA 2:5">hunahuna wɔn wɔ nʼabufuwhyew mu, ka se,<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“Masi me Hene</para>
  <para style="q2" vid="PSA 2:6">wɔ Sion, me bepɔw kronkron no so.”<verse eid="PSA 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>Mɛpae mu aka <char style="nd">Awurade</char> ahyɛde:</para>
  <para style="q1" vid="PSA 2:7">Ɔka kyerɛɛ me se, “Woyɛ me Ba;</para>
  <para style="q2" vid="PSA 2:7">nnɛ mayɛ wʼAgya.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Bisa me,</para>
  <para style="q2" vid="PSA 2:8">na mede amanaman nyinaa bɛyɛ wʼagyapade,</para>
  <para style="q2" vid="PSA 2:8">asase ano nyinaa bɛyɛ wo de.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Wode dade ahempema bedi wɔn so;</para>
  <para style="q2" vid="PSA 2:9">na woabobɔ wɔn sɛ ɔnwemfo ahina.”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Enti mo ahemfo, munsua nyansa;</para>
  <para style="q2" vid="PSA 2:10">monkae kɔkɔbɔ yi, mo asase sodifo.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Momfa osuro nsom <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 2:11">na monsɛpɛw mo ho ahopopo mu.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Mumfew Ɔba no ano, na ne bo amfuw</para>
  <para style="q2" vid="PSA 2:12">na mo akwan de mo bɛkɔ ɔsɛe mu,</para>
  <para style="q1" vid="PSA 2:12">efisɛ nʼabufuwhyew tumi sɔre mpofirim.</para>
  <para style="q2" vid="PSA 2:12">Nhyira ne wɔn a woguan toa no nyinaa.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">Dwom 3</para>
  <para style="d">Dawid dwom a ɔtoe bere a ɔreguan afi ne babarima Absalom anim.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>
    <char style="nd">Awurade</char>, hwɛ sɛnea mʼatamfo dɔɔso fa!</para>
  <para style="q2" vid="PSA 3:1">dodow no ara na wɔsɔre tia me!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Bebree no ara ka fa me ho se,</para>
  <para style="q2" vid="PSA 3:2">“Onyankopɔn rennye no.”<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>Nanso wo, <char style="nd">Awurade</char>, woyɛ nkatabo a atwa me ho ahyia</para>
  <para style="q2" vid="PSA 3:3">mʼanuonyam, nea Ɔpagyaw me ti.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Meteɛ mu su frɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 3:4">na ogye me so fi ne bepɔw kronkron no so.<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Metɔ hɔ na meda a,</para>
  <para style="q2" vid="PSA 3:5">minyan bio, efisɛ <char style="nd">Awurade</char> ma migyina.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Merensuro atamfo mpem mpem a</para>
  <para style="q2" vid="PSA 3:6">wɔatwa me ho ahyia no.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Sɔre, <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 3:7">Gye me, me Nyankopɔn!</para>
  <para style="q1" vid="PSA 3:7">Bobɔ mʼatamfo nyinaa abogye;</para>
  <para style="q2" vid="PSA 3:7">na tutu amumɔyɛfo se.<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>
    <char style="nd">Awurade</char> hɔ na ogye fi ba.</para>
  <para style="q2" vid="PSA 3:8">Ma wo nhyira mmra wo nkurɔfo so.</para>
  <para style="d" vid="PSA 3:8">Wɔde ma dwonkyerɛfo. Wɔto wɔ sankuhama so.<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">Dwom 4</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>Sɛ misu frɛ wo a, gye me so,</para>
  <para style="q2" vid="PSA 4:1">me trenee Nyankopɔn.</para>
  <para style="q1" vid="PSA 4:1">Ma me ɔhome wɔ mʼahohia mu;</para>
  <para style="q2" vid="PSA 4:1">hu me mmɔbɔ na tie me mpaebɔ.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>Enkosi da bɛn na mobɛdan mʼanuonyam ahohora?</para>
  <para style="q2" vid="PSA 4:2">Enkosi da bɛn na mobɛdɔ nneɛma hunu na moadi ahoni ahuhuw akyi?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Hu sɛ <char style="nd">Awurade</char> ayi nea ɔwɔ nyamesu ama ne ho;</para>
  <para style="q2" vid="PSA 4:3">
    <char style="nd">Awurade</char> betie, sɛ misu mefrɛ no a.<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Sɛ mo bo fuw a, monnyɛ bɔne;</para>
  <para style="q2" vid="PSA 4:4">sɛ modeda mo mpa so a,</para>
  <para style="q2" vid="PSA 4:4">monyɛ komm na monhwehwɛ mo koma mu.<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Mommɔ afɔre a ɛfata</para>
  <para style="q2" vid="PSA 4:5">na momfa mo werɛ nhyɛ <char style="nd">Awurade</char> mu.<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>Nnipa bebree bisa se:</para>
  <para style="q2" vid="PSA 4:6">“Hena na ɔde yiyeyɛ bɛbrɛ yɛn?”</para>
  <para style="q2" vid="PSA 4:6">
    <char style="nd">Awurade</char>, ma wʼanim hann no nhyerɛn yɛn so.<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Fa anigye mmoroso hyɛ me koma ma</para>
  <para style="q2" vid="PSA 4:7">bere a wɔn aburow ne nsa foforo abu so no.<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Mɛtɔ hɔ, na mada asomdwoe mu,</para>
  <para style="q2" vid="PSA 4:8">efisɛ wo nko ara, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 4:8">na woma metena dwoodwoo.</para>
  <para style="d" vid="PSA 4:8">Wɔde ma dwonkyerɛfo sɛ wɔmfa atɛntɛbɛn nto.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">Dwom 5</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>
    <char style="nd">Awurade</char>, yɛ aso ma me nsɛm</para>
  <para style="q2" vid="PSA 5:1">na dwen mʼapinisi ho.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Tie me mmoa ho sufrɛ,</para>
  <para style="q2" vid="PSA 5:2">me Hene ne me Nyankopɔn,</para>
  <para style="q2" vid="PSA 5:2">efisɛ wo na mebɔ wo mpae.<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>
    <char style="nd">Awurade</char>, wote me nne anɔpa;</para>
  <para style="q2" vid="PSA 5:3">anɔpa, mede mʼadesrɛ ba wʼanim</para>
  <para style="q2" vid="PSA 5:3">na mede anidaso twɛn.<verse eid="PSA 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Wonyɛ Onyankopɔn a wʼani gye bɔne ho;</para>
  <para style="q2" vid="PSA 5:4">na amumɔyɛfo rentumi ne wo ntena.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Ahantanfo rentumi nnyina wʼanim;</para>
  <para style="q2" vid="PSA 5:5">wukyi wɔn a wɔyɛ bɔne nyinaa.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Wosɛe wɔn a wɔka atosɛm;</para>
  <para style="q2" vid="PSA 5:6">
    <char style="nd">Awurade</char> kyi</para>
  <para style="q2" vid="PSA 5:6">mogyapɛfo ne asisifo.<verse eid="PSA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Nanso me, wo mmɔborɔhunu bebrebe nti,</para>
  <para style="q2" vid="PSA 5:7">mɛba wo fi;</para>
  <para style="q1" vid="PSA 5:7">na nidi mu na mɛkotow</para>
  <para style="q2" vid="PSA 5:7">akyerɛ wʼasɔredan kronkron no.<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>
    <char style="nd">Awurade</char> kyerɛ me kwan</para>
  <para style="q2" vid="PSA 5:8">wɔ wo trenee mu</para>
  <para style="q2" vid="PSA 5:8">mʼatamfo nti,</para>
  <para style="q2" vid="PSA 5:8">bɔ wo kwan tee wɔ mʼanim.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Wɔn anom asɛm baako mpo nyɛ nokware;</para>
  <para style="q2" vid="PSA 5:9">ɔsɛe ahyɛ wɔn koma ma.</para>
  <para style="q1" vid="PSA 5:9">Wɔn menewa yɛ ɔda a so abue</para>
  <para style="q2" vid="PSA 5:9">wɔde wɔn tɛkrɛma ka nnaadaasɛm.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Onyankopɔn, bu wɔn fɔ!</para>
  <para style="q2" vid="PSA 5:10">Ma wɔn pɔw bɔne nyɛ wɔn asehwe.</para>
  <para style="q1" vid="PSA 5:10">Pam wɔn; esiane wɔn bɔne dodow no nti,</para>
  <para style="q2" vid="PSA 5:10">efisɛ wɔasɔre atia wo.<verse eid="PSA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>Nanso ma wɔn a woguan ba wo nkyɛn no ani nnye;</para>
  <para style="q2" vid="PSA 5:11">ma wɔmfa anigye nto dwom daa.</para>
  <para style="q1" vid="PSA 5:11">Trɛw wo bammɔ mu wɔ wɔn so,</para>
  <para style="q2" vid="PSA 5:11">na wɔn a wɔdɔ wo din no</para>
  <para style="q2" vid="PSA 5:11">ma wɔn ani nnye wɔ wo mu.<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>
    <char style="nd">Awurade</char>, ampa ara, wuhyira atreneefo;</para>
  <para style="q2" vid="PSA 5:12">na wode wʼayamye twa wɔn ho hyia sɛ nkatabo.</para>
  <para style="d" vid="PSA 5:12">Wɔde ma dwonkyerɛfo sɛ ɔmfa sankuhama nto wɔ Seminit nne so.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">Dwom 6</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>
    <char style="nd">Awurade</char> nka mʼanim wɔ wʼabufuw mu,</para>
  <para style="q2" vid="PSA 6:1">na ntwe mʼaso nso wɔ wʼabufuwhyew mu.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Hu me mmɔbɔ, <char style="nd">Awurade</char>, efisɛ meyɛ mmrɛw;</para>
  <para style="q2" vid="PSA 6:2">
    <char style="nd">Awurade</char> sa me yare</para>
  <para style="q2" vid="PSA 6:2">na me nnompe wɔ ahoyeraw mu.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Me kra wɔ ahohia mu.</para>
  <para style="q2" vid="PSA 6:3">Enkosi da bɛn, Ao <char style="nd">Awurade</char>, enkosi da bɛn?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>San bra, <char style="nd">Awurade</char>, na begye me nkwa;</para>
  <para style="q2" vid="PSA 6:4">gye me, wo dɔ a enni nhuammɔ no nti.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Obi a wawu no renkae wo da,</para>
  <para style="q2" vid="PSA 6:5">hena na ofi ɔda mu kamfo wo?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Apinisi ama mayɛ mmerɛw.</para>
  <para style="q2" vid="PSA 6:6">Anadwo mu nyinaa mede agyaadwotwa fɔw me mpa,</para>
  <para style="q2" vid="PSA 6:6">na me nusu fɔw me sumii.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Awerɛhow ama mʼani so ayɛ me kusuu.</para>
  <para style="q2" vid="PSA 6:7">Ɛredum; mʼatamfo nyinaa nti.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Mo nnebɔneyɛfo, montwe mo ho mfi me ho!</para>
  <para style="q2" vid="PSA 6:8">efisɛ <char style="nd">Awurade</char> ate me sufrɛ.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>
    <char style="nd">Awurade</char> ate me mmɔborɔsu;</para>
  <para style="q2" vid="PSA 6:9">
    <char style="nd">Awurade</char> tie me sufrɛ.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Mʼatamfo nyinaa anim begu ase</para>
  <para style="q2" vid="PSA 6:10">na wɔn ho adwiriw wɔn;</para>
  <para style="q2" vid="PSA 6:10">na wɔapatuw de fɛre asan wɔn akyi.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">Dwom 7</para>
  <para style="d">Dawid adesrɛ dwom a Benyaminni Kus nsɛm nti ɔto maa <char style="nd">Awurade</char>.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>
    <char style="nd">Awurade</char> me Nyankopɔn,</para>
  <para style="q2" vid="PSA 7:1">miguan toa wo;</para>
  <para style="q2" vid="PSA 7:1">Gye me fi wɔn a wɔtaa me nyinaa nsam,<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>anyɛ saa a wɔbɛtetew me mu sɛ gyata</para>
  <para style="q2" vid="PSA 7:2">na wɔatetew me mu asinasin a</para>
  <para style="q2" vid="PSA 7:2">obiara rentumi nnye me.<verse eid="PSA 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>
    <char style="nd">Awurade</char> me Nyankopɔn, sɛ mayɛ eyi</para>
  <para style="q2" vid="PSA 7:3">na sɛ afɔdi aba me so a,<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>sɛ mayɛ bɔne atia nea ɔne me te yiye,</para>
  <para style="q2" vid="PSA 7:4">anaasɛ mabɔ me tamfo korɔn kwa a,<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>ɛno de ma mʼatamfo ntaa me na wɔmmɛto me;</para>
  <para style="q2" vid="PSA 7:5">ma wontiatia me so wɔ fam,</para>
  <para style="q2" vid="PSA 7:5">na wɔmma me funu nna mfutuma mu.<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>Sɔre wɔ wʼabufuw mu, <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 7:6">Sɔre tia mʼatamfo abufuw.</para>
  <para style="q2" vid="PSA 7:6">Nyan, me Nyankopɔn; hyɛ atɛntrenee mmara.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>Ma nnipadɔm mmetwa wo ho nhyia.</para>
  <para style="q2" vid="PSA 7:7">Fi ɔsoro hɔ di wɔn so;<verse eid="PSA 7:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8"/>ma <char style="nd">Awurade</char> mmu nnipa no atɛn.</para>
  <para style="q1" vid="PSA 7:8">Bu me atɛn, <char style="nd">Awurade</char> sɛnea me trenee te,</para>
  <para style="q2" vid="PSA 7:8">sɛnea me nokwaredi te, Ao, Ɔsorosoroni.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>Onyankopɔn treneeni,</para>
  <para style="q2" vid="PSA 7:9">wo a wohwehwɛ adwene ne koma mu,</para>
  <para style="q1" vid="PSA 7:9">fa amumɔyɛfo basabasayɛ bra awiei</para>
  <para style="q2" vid="PSA 7:9">na ma atreneefo nnya bammɔ.<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Me nkatabo ne Ɔsorosoro Nyankopɔn</para>
  <para style="q2" vid="PSA 7:10">nea ogye koma mu treneeni no.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Onyankopɔn yɛ otemmufo treneeni,</para>
  <para style="q2" vid="PSA 7:11">Onyame a ɔda nʼabufuwhyew adi da biara.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Sɛ wansesa nʼadwene a,</para>
  <para style="q2" vid="PSA 7:12">ɔbɛsew nʼafoa ano;</para>
  <para style="q2" vid="PSA 7:12">obekuntun ne tadua na ɔde bɛmma ahyɛ mu.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>Wasiesie nʼakode a ɛyɛ hu;</para>
  <para style="q2" vid="PSA 7:13">ayɛ ne bɛmma a ɛredɛw no krado.<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Nea onyinsɛn amumɔyɛ</para>
  <para style="q2" vid="PSA 7:14">na basabasayɛ ahyɛ no ma no, ɔwo nnaadaa.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Nea otu tokuru, na oyi mu dɔte no</para>
  <para style="q2" vid="PSA 7:15">hwe tokuru a watu no mu.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Ɔhaw a ɔde ba no dan bɔ nʼankasa so;</para>
  <para style="q2" vid="PSA 7:16">ne basabasayɛ bɔ nʼankasa ti so.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Mede aseda bɛma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 7:17">ne trenee nti,</para>
  <para style="q1" vid="PSA 7:17">na mato ayeyi dwom ayi <char style="nd">Awurade</char>, Ɔsorosoroni no din ayɛ.</para>
  <para style="d" vid="PSA 7:17">Wɔde ma dwonkyerɛfo se wɔnto no “gittit” sanku nne so.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">Dwom 8</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>
    <char style="nd">Awurade</char>, yɛn <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 8:1">wo din kɛseyɛ ada adi wiase mmaa nyinaa.</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">Wode wʼanuonyam</para>
  <para style="q2" vid="PSA 8:1">atimtim ɔsoro nohɔ,<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>mmofra ne nkokoaa mpo de wɔn ano</para>
  <para style="q2" vid="PSA 8:2">kamfo wo, wʼatamfo nti;</para>
  <para style="q2" vid="PSA 8:2">na wode bɔ atamfo ne aweretɔfo ano.<verse eid="PSA 8:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Sɛ mehwɛ wo ɔsorosoro,</para>
  <para style="q2" vid="PSA 8:3">wo nsateaa ano adwuma;</para>
  <para style="q1" vid="PSA 8:3">ɔsram ne nsoromma a</para>
  <para style="q2" vid="PSA 8:3">wode obiara asi nʼafa a,<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>onipa ne hena a wokae no,</para>
  <para style="q2" vid="PSA 8:4">na onipa ba nso ne hena a wʼani ku ne ho?<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Wobɔɔ no ma ɔyɛɛ akumaa kakra sen abɔfo</para>
  <para style="q2" vid="PSA 8:5">na wode wʼanuonyam ne nidi abɔ no abotiri.<verse eid="PSA 8:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Woyɛɛ no ɔsodifo maa wo nsa ano nnwuma</para>
  <para style="q2" vid="PSA 8:6">wode nneɛma nyinaa ahyɛ nʼanan ase:<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>nguankuw ne anantwikuw nyinaa</para>
  <para style="q2" vid="PSA 8:7">ne wuram mmoa nso,<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>wim nnomaa</para>
  <para style="q2" vid="PSA 8:8">ne po mu mpataa,</para>
  <para style="q2" vid="PSA 8:8">nea ɛnenam po mu akwan so nyinaa.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>
    <char style="nd">Awurade</char>, yɛn <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 8:9">wo din yɛ kɛse wɔ asase nyinaa so!</para>
  <para style="d" vid="PSA 8:9">Wɔde ma dwonkyerɛfo. Wɔto no sɛnea wɔto “Ɔba no wu”.<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">Dwom 9</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>
    <char style="nd">Awurade</char>, mefi me koma nyinaa mu ada wo ase.</para>
  <para style="q2" vid="PSA 9:1">Mɛka wʼanwonwade no nyinaa.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Mɛma mʼani agye na madi ahurusi wɔ wo mu.</para>
  <para style="q2" vid="PSA 9:2">Mɛto ayeyi dwom ama wo din, Ɔsorosoroni.<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Mʼatamfo san wɔn akyi;</para>
  <para style="q2" vid="PSA 9:3">wɔtetew hwe, na wowuwu wɔ wʼanim.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Woadi mʼasɛm ama me, na menya mʼahofadi;</para>
  <para style="q2" vid="PSA 9:4">woatena wʼahengua so, abu atɛntrenee.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Woatwe amanaman no aso, na woasɛe amumɔyɛfo.</para>
  <para style="q2" vid="PSA 9:5">Woapepa wɔn din a wɔrenkae wɔn bio.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Ɔsɛe a enni awiei ato ɔtamfo no,</para>
  <para style="q2" vid="PSA 9:6">woatutu wɔn nkuropɔn;</para>
  <para style="q2" vid="PSA 9:6">na wɔnkae wɔn bio mpo.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>
    <char style="nd">Awurade</char> di hene daa daa;</para>
  <para style="q2" vid="PSA 9:7">wasi nʼatemmu ahengua.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Ɔde trenee bebu wiase atɛn;</para>
  <para style="q2" vid="PSA 9:8">ɔde atɛntrenee bedi nnipa no so.<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>
    <char style="nd">Awurade</char> yɛ guankɔbea ma wɔn a wodi wɔn nya no,</para>
  <para style="q2" vid="PSA 9:9">ɔyɛ abandennen wɔ ahohia mmere mu.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Wɔn a wonim wo din no de wɔn ho bɛto wo so,</para>
  <para style="q2" vid="PSA 9:10">efisɛ, wo <char style="nd">Awurade</char>, wunnyaw obiara a ɔhwehwɛ wo no mu da.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Monto ayeyi dwom mma <char style="nd">Awurade</char> a ɔte ahengua so wɔ Sion;</para>
  <para style="q2" vid="PSA 9:11">mompae mu nka nea wayɛ wɔ amanaman no mu.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Na ɔkae nea ɔtɔ mogya so were no;</para>
  <para style="q2" vid="PSA 9:12">ommu nʼani ngu ɔbrɛfo sufrɛ so.<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>
    <char style="nd">Awurade</char>, hwɛ sɛnea mʼatamfo teetee me!</para>
  <para style="q2" vid="PSA 9:13">Hu me mmɔbɔ na yi me fi owu apon ano,<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>na matumi apae mu aka wʼayeyi</para>
  <para style="q2" vid="PSA 9:14">wɔ Ɔbabea Sion apon ano,</para>
  <para style="q2" vid="PSA 9:14">na madi ahurusi wɔ wo nkwagye no mu hɔ.<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Amanaman mufo atɔ amoa a wɔatu no mu;</para>
  <para style="q2" vid="PSA 9:15">afiri a wosum hintaw no ayi wɔn anan.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>
    <char style="nd">Awurade</char> atɛntrenee da no adi;</para>
  <para style="q2" vid="PSA 9:16">amumɔyɛfo nsa ano adwuma ayi wɔn.<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>Amumɔyɛfo san kɔ ɔda mu,</para>
  <para style="q2" vid="PSA 9:17">amanaman a wɔn werɛ fi Onyankopɔn nyinaa.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Nanso ɛnyɛ daa na ne werɛ befi ohiani,</para>
  <para style="q2" vid="PSA 9:18">anaasɛ mmɔborɔni anidaso bɛyera korakora.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Sɔre! <char style="nd">Awurade</char>, mma ɔdesani nni nkonim,</para>
  <para style="q2" vid="PSA 9:19">bu amanaman no atɛn wɔ wʼanim.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>Bɔ wɔn hu, <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 9:20">na ma wonhu sɛ, wɔyɛ adesa bi kɛkɛ.<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">Dwom 10</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>Adɛn, <char style="nd">Awurade</char>, na wugyina akyirikyiri saa?</para>
  <para style="q2" vid="PSA 10:1">Adɛn na wode wo ho ahintaw wɔ amanehunu mmere mu yi?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Omumɔyɛfo de ahantan taataa mmɔborɔfo,</para>
  <para style="q2" vid="PSA 10:2">wɔn a ne nneyɛe mfiri yiyi wɔn no.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Ɔde nea ne koma hwehwɛ hoahoa ne ho;</para>
  <para style="q2" vid="PSA 10:3">ohyira odifudepɛfo na oyi <char style="nd">Awurade</char> ahi.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Ahantan nti omumɔyɛfo nhwehwɛ <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 10:4">ne nsusuwii mu no Onyankopɔn nsi hwee.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Nʼakwan nyinaa mu odi yiye;</para>
  <para style="q2" vid="PSA 10:5">ɔma ne ho so, na wo mmara mfa no ho;</para>
  <para style="q2" vid="PSA 10:5">na odi nʼatamfo nyinaa ho fɛw.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Ɔka kyerɛ ne ho se: “Hwee remma minhinhim;</para>
  <para style="q2" vid="PSA 10:6">mʼani begye daa, na merenkɔ amanehunu mu da.”<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Nnome, atoro ne ahunahuna ahyɛ nʼanom ma;</para>
  <para style="q2" vid="PSA 10:7">Ɔhaw ne mmusu hyɛ ne tɛkrɛma ase.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Ɔtɛw bɛn nkuraa no;</para>
  <para style="q2" vid="PSA 10:8">ofi ahintawee kum nea onnim hwee,</para>
  <para style="q2" vid="PSA 10:8">ohintaw hwɛ wɔn a ɔrehwehwɛ wɔn ayɛ wɔn bɔne no.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Ɔte sɛ gyata a wahintaw;</para>
  <para style="q2" vid="PSA 10:9">ɔtɛw sɛ ɔbɛkyere mmɔborɔni;</para>
  <para style="q2" vid="PSA 10:9">ɔkyere wɔn twe wɔn ase de wɔn kɔ ne bon mu.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Ɔdwerɛw wɔn a ɔkyere wɔn no ma wɔtɔ beraw;</para>
  <para style="q2" vid="PSA 10:10">na ɔde nʼahoɔden ka wɔn hyɛ.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>Ɔka kyerɛ ne ho se, “Onyankopɔn werɛ afi;</para>
  <para style="q2" vid="PSA 10:11">wayi nʼani afi so na onhu.”<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>Sɔre, <char style="nd">Awurade</char>! Ma wo nsa so, Onyankopɔn.</para>
  <para style="q2" vid="PSA 10:12">Mma wo werɛ mfi wɔn a wonni aboafo.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Adɛn nti na omumɔyɛfo yi Onyankopɔn ahi?</para>
  <para style="q2" vid="PSA 10:13">Adɛn nti na ɔka kyerɛ ne ho se,</para>
  <para style="q2" vid="PSA 10:13">“Ɔremfrɛ me akontaabu so?”<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Nanso wo, Onyankopɔn, wuhu amanehunufo haw;</para>
  <para style="q2" vid="PSA 10:14">na wayɛ wʼadwene sɛ wobɛhwɛ.</para>
  <para style="q1" vid="PSA 10:14">Mmɔborɔni de ne ho ma wo;</para>
  <para style="q2" vid="PSA 10:14">wo na woyɛ ayisaa boafo.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Bubu omumɔyɛfo ne ɔbɔnefo aprɛw;</para>
  <para style="q2" vid="PSA 10:15">frɛ no na ommebu nʼamumɔyɛ ho nkontaa,</para>
  <para style="q2" vid="PSA 10:15">nʼamumɔyɛ a anka wɔrenhu no.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>
    <char style="nd">Awurade</char> yɛ ɔhene daa nyinaa;</para>
  <para style="q2" vid="PSA 10:16">amanaman no bɛyera nʼasase so.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>
    <char style="nd">Awurade</char>, wutie mmɔborɔfo adesrɛ;</para>
  <para style="q2" vid="PSA 10:17">wohyɛ wɔn nkuran, na wutie wɔn sufrɛ,<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>na wudi ma ayisaa ne nea wɔhyɛ no so,</para>
  <para style="q2" vid="PSA 10:18">sɛnea ɛbɛyɛ a ɔdesani a ofi asase mu</para>
  <para style="q2" vid="PSA 10:18">renhunahuna bio.</para>
  <para style="d" vid="PSA 10:18">Wɔde ma dwonkyerɛfo.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">Dwom 11</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>
    <char style="nd">Awurade</char> mu na mede me werɛ ahyɛ.</para>
  <para style="q2" vid="PSA 11:1">Adɛn na wutumi ka kyerɛ me se,</para>
  <para style="q2" vid="PSA 11:1">“Tu te sɛ anomaa kɔ wo bepɔw so.<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Na hwɛ, amumɔyɛfo akuntun wɔn ta mu,</para>
  <para style="q2" vid="PSA 11:2">na wɔde wɔn mmɛmma asisi ahama so</para>
  <para style="q1" vid="PSA 11:2">sɛ wɔbɛtow wɔ sum mu</para>
  <para style="q2" vid="PSA 11:2">de awɔ koma mu ahotefo.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Sɛ wɔresɛe fapem no a,</para>
  <para style="q2" vid="PSA 11:3">dɛn na ɔtreneeni betumi ayɛ?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>
    <char style="nd">Awurade</char> wɔ nʼasɔredan kronkron no mu;</para>
  <para style="q2" vid="PSA 11:4">
    <char style="nd">Awurade</char> te ne soro ahengua so.</para>
  <para style="q1" vid="PSA 11:4">Ɔhwɛ nnipa mma,</para>
  <para style="q2" vid="PSA 11:4">nʼani hwehwɛ wɔn mu.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>
    <char style="nd">Awurade</char> hwehwɛ ɔtreneeni mu,</para>
  <para style="q2" vid="PSA 11:5">na amumɔyɛfo ne wɔn a wɔpɛ basabasayɛ de,</para>
  <para style="q2" vid="PSA 11:5">ne kra kyi wɔn.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Ɔbɛtɔ ogyatannaa ne sufre a ɛredɛw</para>
  <para style="q2" vid="PSA 11:6">agu amumɔyɛfo so;</para>
  <para style="q2" vid="PSA 11:6">na mframa a mu yɛ hyew bɛyɛ wɔn kyɛfa.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>
    <char style="nd">Awurade</char> yɛ ɔtreneeni,</para>
  <para style="q2" vid="PSA 11:7">na ɔpɛ atɛntrenee;</para>
  <para style="q2" vid="PSA 11:7">wɔn a wɔteɛ no behu nʼanim.</para>
  <para style="d" vid="PSA 11:7">Wɔde ma dwonkyerɛfo se wɔnto no wɔ “Seminit” sanku nne so.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">Dwom 12</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>Boa yɛn, <char style="nd">Awurade</char>, na nyamesurofo asa;</para>
  <para style="q2" vid="PSA 12:1">nokwafo ayera wɔ nnipa mu.<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Obiara di atoro kyerɛ ne yɔnko;</para>
  <para style="q2" vid="PSA 12:2">wɔn ano a ɛdɛfɛdɛfɛ no ka nnaadaasɛm.<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Ma <char style="nd">Awurade</char> ntwa nnaadaa ano</para>
  <para style="q2" vid="PSA 12:3">ne tɛkrɛma biara a ɛhoahoa ne ho nkyene;<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>nea ɛka se, “Yɛde yɛn tɛkrɛma bedi nkonim;</para>
  <para style="q2" vid="PSA 12:4">yɛn ano bedi ama yɛn, na hena na odi yɛn so tumi?”<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>“Esiane ɔhyɛ a wɔde hyɛ mmɔborɔni</para>
  <para style="q2" vid="PSA 12:5">ne ohiani apinisi no nti,</para>
  <para style="q1" vid="PSA 12:5">mɛsɔre afei,” <char style="nd">Awurade</char> na ose.</para>
  <para style="q2" vid="PSA 12:5">“Mɛbɔ wɔn ho ban afi wɔn a wɔhaw wɔn no ho.”<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>
    <char style="nd">Awurade</char> asɛm yɛ nokware</para>
  <para style="q2" vid="PSA 12:6">te sɛ dwetɛ a wɔasɔn so wɔ fononoo mu,</para>
  <para style="q2" vid="PSA 12:6">na wɔahoa ho mpɛn ason.<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>
    <char style="nd">Awurade</char>, wobɛkora mmɔborɔni</para>
  <para style="q2" vid="PSA 12:7">na woabɔ yɛn ho ban afi saa nnipa yi ho afebɔɔ.<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>Amumɔyɛfo nenam sɛnea wɔpɛ,</para>
  <para style="q2" vid="PSA 12:8">bere a adesamma de nidi ma afide.</para>
  <para style="d" vid="PSA 12:8">Wɔde ma dwonkyerɛfo.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">Dwom 13</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>
    <char style="nd">Awurade</char> enkosi da bɛn? Wo werɛ befi me afebɔɔ ana?</para>
  <para style="q2" vid="PSA 13:1">Enkosi da bɛn na wode wʼanim behintaw me?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Enkosi da bɛn na mene mʼadwennwene bedi aperepere</para>
  <para style="q2" vid="PSA 13:2">na awerɛhow ahyɛ me koma mu daa?</para>
  <para style="q2" vid="PSA 13:2">Mʼatamfo nni me so nkonim nkosi da bɛn?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Twa wʼani hwɛ me na bua me, <char style="nd">Awurade</char>, me Nyankopɔn.</para>
  <para style="q2" vid="PSA 13:3">Ma mʼani so nyɛ hann, na manna owu nna.<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>Me tamfo bɛka se, “Madi ne so nkonim.”</para>
  <para style="q2" vid="PSA 13:4">Na mʼahohiahiafo bedi ahurusi bere a mahwe ase.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Nanso mede me ho to wo dɔ a ɛnsa da no so;</para>
  <para style="q2" vid="PSA 13:5">me koma di ahurusi wɔ wo nkwagye mu.<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Mɛto dwom ama <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 13:6">efisɛ ɔne me adi no yiye.</para>
  <para style="d" vid="PSA 13:6">Wɔde ma dwonkyerɛfo no.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">Dwom 14</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>Ɔkwasea ka wɔ ne koma mu se,</para>
  <para style="q2" vid="PSA 14:1">“Onyankopɔn bi nni hɔ.”</para>
  <para style="q1" vid="PSA 14:1">Wɔaporɔw, na wɔn nneyɛe yɛ fi</para>
  <para style="q2" vid="PSA 14:1">na wɔn mu biara nni hɔ a ɔyɛ ade pa.<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>
    <char style="nd">Awurade</char> fi ɔsoro hwɛ</para>
  <para style="q2" vid="PSA 14:2">adesamma wɔ fam</para>
  <para style="q1" vid="PSA 14:2">sɛ obehu wɔn mu bi a wɔwɔ ntease,</para>
  <para style="q2" vid="PSA 14:2">anaa ebinom a wɔhwehwɛ Onyankopɔn.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Nanso nnipa nyinaa atwe wɔn ho afi Onyankopɔn ho;</para>
  <para style="q2" vid="PSA 14:3">wɔn nyinaa ayɛ bɔne.</para>
  <para style="q1" vid="PSA 14:3">Obiara nni hɔ a ɔyɛ papa.</para>
  <para style="q2" vid="PSA 14:3">Ɔbaako mpo nni hɔ.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Enti abɔnefo rensua nyansa ana?</para>
  <para style="b" vid="PSA 14:4"/>
  <para style="q1" vid="PSA 14:4">Wɔwe me nkurɔfo te sɛnea nnipa di aduan.</para>
  <para style="q2" vid="PSA 14:4">Wonnsu mfrɛ <char style="nd">Awurade</char>?<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Nanso wonni, ehu akyekyere wɔn,</para>
  <para style="q2" vid="PSA 14:5">efisɛ Onyankopɔn te wɔn a wɔteɛ mu.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Mo nnebɔneyɛfo sɛe ahiafo nhyehyɛe,</para>
  <para style="q2" vid="PSA 14:6">nanso, <char style="nd">Awurade</char> ne wɔn guankɔbea.<verse eid="PSA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>Ao, Israel nkwagye mfi Sion mmra!</para>
  <para style="q2" vid="PSA 14:7">
    <char style="nd">Awurade</char> bɛsan de ne nkurɔfo agyapade ama wɔn.</para>
  <para style="q2" vid="PSA 14:7">Na Yakob adi ahurusi, na Israel ani agye!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">Dwom 15</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>
    <char style="nd">Awurade</char>, hena na ɔbɛtena wo kronkronbea ntamadan no mu?</para>
  <para style="q2" vid="PSA 15:1">Hena na ɔbɛtena wo bepɔw kronkron no so?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Nea ne ho nni asɛm</para>
  <para style="q2" vid="PSA 15:2">na ɔyɛ nea ɛteɛ,</para>
  <para style="q1" vid="PSA 15:2">nea ɔka nokware a efi ne koma mu<verse eid="PSA 15:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3"/>na ɔmfa ne tɛkrɛma nsɛe nnipa</para>
  <para style="q1" vid="PSA 15:3">nea ɔnyɛ ne yɔnko bɔne</para>
  <para style="q2" vid="PSA 15:3">na ommu ne yɔnko nipa abomfiaa,<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>nea obu afideyɛni animtiaa</para>
  <para style="q2" vid="PSA 15:4">na ɔde nidi ma wɔn a wosuro <char style="nd">Awurade</char>,</para>
  <para style="q1" vid="PSA 15:4">nea odi ne ntam so,</para>
  <para style="q2" vid="PSA 15:4">bere a etia no mpo,<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>nea ɔde ne sika bɔ bosea a onnye nsiho</para>
  <para style="q2" vid="PSA 15:5">na onnye adanmude ntia nea odi bem.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">Nea ɔyɛ eyinom no</para>
  <para style="q2" vid="PSA 15:5">renhinhim da.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">Dwom 16</para>
  <para style="d">Dawid mpaebɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>Bɔ me ho ban, me Nyankopɔn,</para>
  <para style="q2" vid="PSA 16:1">na wo mu na minya guankɔbea.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Meka kyerɛɛ <char style="nd">Awurade</char> se,</para>
  <para style="q2" vid="PSA 16:2">“MʼAwurade ne wo;</para>
  <para style="q2" vid="PSA 16:2">minni ade pa biara ka wo ho.”<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Ahotefo a wɔwɔ asase no so de,</para>
  <para style="q2" vid="PSA 16:3">wɔne anuonyamfo a</para>
  <para style="q2" vid="PSA 16:3">mʼanigye wɔ wɔn mu.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Wɔn a wodi anyame afoforo akyi no,</para>
  <para style="q2" vid="PSA 16:4">wɔn awerɛhow bɛdɔɔso.</para>
  <para style="q1" vid="PSA 16:4">Merengu mogya nsa mma saa anyame no</para>
  <para style="q2" vid="PSA 16:4">na meremfa mʼano mmɔ wɔn din.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>
    <char style="nd">Awurade</char>, wode me kyɛfa ne me kuruwa ama me;</para>
  <para style="q2" vid="PSA 16:5">woama me kyɛfa anya bammɔ.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Mʼahye akɔdeda mmeae a eye ama me;</para>
  <para style="q2" vid="PSA 16:6">ampa ara mewɔ agyapade a ho yɛ anigye.<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Mɛkamfo <char style="nd">Awurade</char> a otu me fo;</para>
  <para style="q2" vid="PSA 16:7">na anadwo mpo, me koma kyerɛkyerɛ me.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>Mihu <char style="nd">Awurade</char> wɔ mʼani so daa nyinaa.</para>
  <para style="q2" vid="PSA 16:8">Esiane sɛ ɔwɔ me nsa nifa nti, merenhinhim da.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Ɛno nti, me kra ani gye, na mede me tɛkrɛma di ahurusi;</para>
  <para style="q2" vid="PSA 16:9">me nipadua nso bɛhome asomdwoe mu,<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>efisɛ, worennyaw me awufo mu.</para>
  <para style="q2" vid="PSA 16:10">Na woremma wo Kronkronni no mporɔw.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Woakyerɛ me nkwagye kwan,</para>
  <para style="q2" vid="PSA 16:11">na wobɛma mʼani agye wɔ wʼanim,</para>
  <para style="q2" vid="PSA 16:11">na anigye a ɛrensa da wɔ wo nifa so.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">Dwom 17</para>
  <para style="d">Dawid Mpaebɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>
    <char style="nd">Awurade</char>, tie me trenee abisade;</para>
  <para style="q2" vid="PSA 17:1">tie me sufrɛ.</para>
  <para style="q1" vid="PSA 17:1">Yɛ aso ma me mpaebɔ;</para>
  <para style="q2" vid="PSA 17:1">nea emfi nnaadaa anofafa mu.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Ma me bembu mfi wo;</para>
  <para style="q2" vid="PSA 17:2">ma wʼani nhu nea ɛyɛ pɛ.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Wopɛɛpɛɛ me koma mu,</para>
  <para style="q2" vid="PSA 17:3">wohwehwɛ me mu anadwo,</para>
  <para style="q1" vid="PSA 17:3">na wosɔ me hwɛ de, nanso wubehu sɛ minsusuw bɔne bi ɛ;</para>
  <para style="q2" vid="PSA 17:3">mʼano nkaa bɔne bi ɛ.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Nnipa nneyɛe fam no,</para>
  <para style="q2" vid="PSA 17:4">anom asɛm nti</para>
  <para style="q1" vid="PSA 17:4">matwe me ho afi</para>
  <para style="q2" vid="PSA 17:4">basabasayɛfo akwan ho.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Menam wʼakwan so daa;</para>
  <para style="q2" vid="PSA 17:5">me nan nhintiw ɛ.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Misu mefrɛ wo, Onyankopɔn</para>
  <para style="q2" vid="PSA 17:6">na wubegye me so;</para>
  <para style="q2" vid="PSA 17:6">yɛ aso ma me na tie me mpaebɔ.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Da wo dɔ nwonwaso no adi;</para>
  <para style="q2" vid="PSA 17:7">wo a wode wo nsa nifa</para>
  <para style="q1" vid="PSA 17:7">gye wɔn a wɔde wɔn ho to wo so no nkwa</para>
  <para style="q2" vid="PSA 17:7">fi wɔn atamfo nsam no.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Hwɛ me so sɛ obi a wodɔ no;</para>
  <para style="q2" vid="PSA 17:8">fa me sie wo ntaban nwini no ase,<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>fi amumɔyɛfo a wɔretaataa me no nsam,</para>
  <para style="q2" vid="PSA 17:9">mʼatamfo a wɔatwa me ho ahyia no.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Wopirim wɔn koma,</para>
  <para style="q2" vid="PSA 17:10">na wɔkasa ahantan so.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Wɔadi me ntɛntɛ, afei wɔatwa me ho ahyia;</para>
  <para style="q2" vid="PSA 17:11">wɔn ani abere sɛ wɔbɛbɔ me ahwe fam.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Wɔte sɛ gyata a hanam ho kɔm de no,</para>
  <para style="q2" vid="PSA 17:12">te sɛ gyata kɛse bi a wabutuw wɔ ahintawee.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Sɔre, <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 17:13">Wone wɔn mfa mmɔ ani na ka wɔn hyɛ;</para>
  <para style="q2" vid="PSA 17:13">fa wʼafoa no gye me fi amumɔyɛfo no nsam.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>
    <char style="nd">Awurade</char>, fa wo nsa</para>
  <para style="q2" vid="PSA 17:14">gye me fi nnipa a wɔte sɛɛ nsam;</para>
  <para style="q2" vid="PSA 17:14">asase so nnipa a wɔn akatua wɔ nkwa yi mu no.</para>
  <para style="q1" vid="PSA 17:14">Womma ɔkɔm nne wɔn a wʼani ku wɔn ho;</para>
  <para style="q2" vid="PSA 17:14">wɔn mmabarima wɔ bebree,</para>
  <para style="q2" vid="PSA 17:14">na wɔkora agyapade ma wɔn mma.<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Na me trenee mu, mehu wʼanim;</para>
  <para style="q2" vid="PSA 17:15">sɛ minyan na mihu wo a me koma bɛtɔ me yam.</para>
  <para style="d" vid="PSA 17:15">Wɔde ma dwonkyerɛfo.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">Dwom 18</para>
  <para style="d">
    <char style="nd">Awurade</char> akoa Dawid dwom. Ɔtoo saa dwom yi maa <char style="nd">Awurade</char>, bere a ogyee no fii nʼatamfo nyinaa ne Saulo nsam no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>Medɔ wo, <char style="nd">Awurade</char>, mʼahoɔden.<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>
    <char style="nd">Awurade</char> ne me botantim;</para>
  <para style="q2" vid="PSA 18:2">mʼaban ne me gyefo;</para>
  <para style="q1" vid="PSA 18:2">me Nyankopɔn yɛ me botan.</para>
  <para style="q2" vid="PSA 18:2">Ne mu na minya me hintabea.</para>
  <para style="q2" vid="PSA 18:2">Ɔyɛ me nkatabo, me nkwagye abɛn ne mʼabandennen.<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Misu frɛ <char style="nd">Awurade</char>; ɔno na ayeyi sɛ no,</para>
  <para style="q2" vid="PSA 18:3">efisɛ ogye me fi mʼatamfo nsam.<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Owu nkɔnsɔnkɔnsɔn kyekyeree me;</para>
  <para style="q2" vid="PSA 18:4">na ɔsɛe asorɔkye bu faa me so.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Ɔda mu hama kyekyeree me;</para>
  <para style="q2" vid="PSA 18:5">mihyiaa owu mfiri.<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Mʼahohia mu, misu frɛɛ <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 18:6">Misu frɛɛ me Nyankopɔn hwehwɛɛ mmoa.</para>
  <para style="q1" vid="PSA 18:6">Ofi nʼasɔrefi hɔ tee me nne;</para>
  <para style="q2" vid="PSA 18:6">me sufrɛ baa nʼanim, na ɛkɔɔ nʼasom.<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Asase wosowee na ehinhimii,</para>
  <para style="q2" vid="PSA 18:7">na mmepɔw fapem wosowee</para>
  <para style="q2" vid="PSA 18:7">wosuroe, efisɛ na ne bo afuw.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Wusiw fii ne hwene mu;</para>
  <para style="q2" vid="PSA 18:8">ogyaframa fii nʼanom,</para>
  <para style="q2" vid="PSA 18:8">na nnyansramma dɛw fii mu.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Ofii ɔsoro baa fam;</para>
  <para style="q2" vid="PSA 18:9">na omununkum kabii duruu nʼanan ase.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Ɔte kerubim so tu kɔɔ soro;</para>
  <para style="q2" vid="PSA 18:10">gyaagyaa ne ho wɔ mframa ntaban so.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Ɔde sum kataa ne ho,</para>
  <para style="q2" vid="PSA 18:11">osu a amuna tumm atwa ne ho ahyia.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Hann kɛse hyerɛn wɔ nʼanim,</para>
  <para style="q2" vid="PSA 18:12">na omununkum a mparuwbo ne anyinam wɔ mu fii ne ho hyerɛn mu bae.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>
    <char style="nd">Awurade</char> bobɔɔ mu fii ɔsoro;</para>
  <para style="q2" vid="PSA 18:13">Ɔsorosoroni no nne gyigyee bio.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Ɔtow ne bɛmma no de bɔɔ atamfo no ahwete,</para>
  <para style="q2" vid="PSA 18:14">ɔde anyinam a ano yɛn den pam wɔn.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Po mu abon ho yiyii</para>
  <para style="q2" vid="PSA 18:15">na asase nnyinaso ho daa hɔ,</para>
  <para style="q1" vid="PSA 18:15">esiane wʼanimka ne ahomegu a efi wo hwene mu no nti,</para>
  <para style="q2" vid="PSA 18:15">
    <char style="nd">Awurade</char>.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Ofi soro baa fam besoo me mu;</para>
  <para style="q2" vid="PSA 18:16">ɔtwee me fii nsu a mu dɔ mu.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Ogyee me fii me tamfo hoɔdenfo nsam,</para>
  <para style="q2" vid="PSA 18:17">wɔn a wɔn ani sa me, na wɔn ho yɛ den dodo ma me no.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Wɔbaa me so wɔ mʼamanehunu da mu,</para>
  <para style="q2" vid="PSA 18:18">nanso <char style="nd">Awurade</char> maa me so,<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>wode me baa baabi a hɔ trɛw;</para>
  <para style="q2" vid="PSA 18:19">ogyee me, efisɛ nʼani sɔɔ me.<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>
    <char style="nd">Awurade</char> ne me adi no sɛnea me trenee te;</para>
  <para style="q2" vid="PSA 18:20">wahwɛ me nsa a ho tew so atua me ka.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Manantew <char style="nd">Awurade</char> akwan so.</para>
  <para style="q2" vid="PSA 18:21">Mentwee me ho mfii me Nyankopɔn ho nkɔyɛɛ bɔne ɛ.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Madi ne mmara nyinaa so:</para>
  <para style="q2" vid="PSA 18:22">mimmuu nʼahyɛde so.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Me ho nni asɛm wɔ Onyankopɔn anim,</para>
  <para style="q2" vid="PSA 18:23">na matwe me ho afi bɔne ho.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>
    <char style="nd">Awurade</char> agyina me treneeyɛ</para>
  <para style="q2" vid="PSA 18:24">ne me nsa a ho tew wɔ nʼanim no so atua me ka.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Woda wo ho adi sɛ ɔnokwafo kyerɛ wɔn a wodi nokware,</para>
  <para style="q1" vid="PSA 18:25">wɔn a wodi mu nso wokyerɛ wɔn sɛ wodi mu.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>Woyɛ kronkron ma wɔn a wɔyɛ kronkron,</para>
  <para style="q2" vid="PSA 18:26">na amumɔyɛfo de, wukyi wɔn.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Wugye ahobrɛasefo nkwa,</para>
  <para style="q2" vid="PSA 18:27">na wobrɛ ahantanfo ase.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>
    <char style="nd">Awurade</char>, woma me kanea hyerɛn.</para>
  <para style="q2" vid="PSA 18:28">Yiw, woma me sum dan hann.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Wʼahoɔden a wode ma me nti, mitumi ka asraafo gu;</para>
  <para style="q2" vid="PSA 18:29">me Nyankopɔn nti, mitumi foro ɔfasu.<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Onyankopɔn de, nʼakwan yɛ pɛ;</para>
  <para style="q2" vid="PSA 18:30">
    <char style="nd">Awurade</char> bɔhyɛ nyinaa ba mu.</para>
  <para style="q1" vid="PSA 18:30">Ɔyɛ nkatabo</para>
  <para style="q2" vid="PSA 18:30">ma wɔn a wɔhwehwɛ bammɔ wɔ ne mu.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Na hena na ɔyɛ Onyankopɔn ka <char style="nd">Awurade</char> ho?</para>
  <para style="q1" vid="PSA 18:31">Hena na ɔyɛ Ɔbotan no? Gye sɛ yɛn Nyankopɔn no.<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Ɛyɛ Onyankopɔn na ɔma me ahoɔden,</para>
  <para style="q2" vid="PSA 18:32">na ɔma me kwan yɛ pɛ.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>Ɔma mʼanammɔn ho yɛ hare sɛ ɔforote de.</para>
  <para style="q2" vid="PSA 18:33">Ɔma me gyina sorɔnsorɔmmea.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Osiesie me ma ɔko,</para>
  <para style="q2" vid="PSA 18:34">na me basa tumi kuntun kɔbere mfrafrae tadua.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Wode wo ogye boa me nkatabo,</para>
  <para style="q2" vid="PSA 18:35">na wo nsa nifa ma me gyina.</para>
  <para style="q2" vid="PSA 18:35">Wobrɛ wo ho ase ma meyɛ ɔkɛse.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Woabɔ kwan tɛtrɛɛ ama mʼanan</para>
  <para style="q2" vid="PSA 18:36">sɛnea me nkotodwe rengurow.<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Metaa mʼatamfo kɔtoo wɔn;</para>
  <para style="q2" vid="PSA 18:37">mansan mʼakyi kosii sɛ mesɛee wɔn.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Mɛdwerɛw wɔn, na wɔantumi ansɔre,</para>
  <para style="q2" vid="PSA 18:38">wɔhwehwee ase wɔ mʼanan ase.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Wode akodi ahoɔden maa me;</para>
  <para style="q2" vid="PSA 18:39">womaa mʼatamfo bɔɔ wɔn mu ase wɔ me nan ase.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Womaa mʼatamfo dan wɔn ho guanee,</para>
  <para style="q2" vid="PSA 18:40">na mesɛe wɔn a wɔtan me.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Wosu hwehwɛɛ mmoa, nanso obiara ammegye wɔn,</para>
  <para style="q2" vid="PSA 18:41">wɔfrɛɛ <char style="nd">Awurade</char>, nanso wammua.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Meyam wɔn sɛ mfutuma a mframa bɔ gu;</para>
  <para style="q2" vid="PSA 18:42">mihwiee wɔn guu sɛ mmɔnten so dontori.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Woagye me afi nnipa no ɔfow mu,</para>
  <para style="q2" vid="PSA 18:43">woayɛ me amanaman no ti;</para>
  <para style="q2" vid="PSA 18:43">nnipa a minnim wɔn abɛyɛ mʼasomfo.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Wɔte me nka pɛ a, wɔyɛ osetie ma me;</para>
  <para style="q2" vid="PSA 18:44">ananafo kotow mʼanim.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Wɔn nyinaa botobotow;</para>
  <para style="q2" vid="PSA 18:45">wofi wɔn abandennen mu ba ahopopo so.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>
    <char style="nd">Awurade</char> te ase! Ayeyi nka me Botan!</para>
  <para style="q2" vid="PSA 18:46">Wɔmma Onyankopɔn, me Gyefo no din so!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>Ɔno ne Onyankopɔn a ɔtɔ were ma me,</para>
  <para style="q2" vid="PSA 18:47">ɔno na ɔka amanaman hyɛ mʼase,<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>ɔno na ogye me fi mʼatamfo nsam.</para>
  <para style="q2" vid="PSA 18:48">Wopagyaw me sii mʼatamfo so,</para>
  <para style="q2" vid="PSA 18:48">wugyee me fii basabasayɛfo nsam.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>Ɛno nti, mɛkamfo wo wɔ amanaman mu, Ao <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 18:49">Mɛto ayeyi dwom ama wo din.<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>Wode nkonimdi akɛse ama wo hene;</para>
  <para style="q2" vid="PSA 18:50">woda ɔdɔ a ɛnsa da adi kyerɛ nea woasra no ngo,</para>
  <para style="q2" vid="PSA 18:50">wode kyerɛ Dawid, ne nʼasefo afebɔɔ.</para>
  <para style="d" vid="PSA 18:50">Wɔde ma dwonkyerɛfo.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">Dwom 19</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>Ɔsoro ka Onyankopɔn anuonyam!</para>
  <para style="q2" vid="PSA 19:1">Wim pae mu ka ne nsa ano adwuma,<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Da biara, wɔkasa;</para>
  <para style="q2" vid="PSA 19:2">anadwo biara, wɔda nimdeɛ adi.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Wonni ɔkasa, wɔnnka nsɛm;</para>
  <para style="q2" vid="PSA 19:3">wɔnnte wɔn nne.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Wɔn nne akodu asase so mmaa nyinaa,</para>
  <para style="q2" vid="PSA 19:4">na wɔn nsɛm nso akodu asase ano.</para>
  <para style="b" vid="PSA 19:4"/>
  <para style="q1" vid="PSA 19:4">Onyankopɔn asi ntamadan ama owia wɔ ɔsoro hɔ.<verse eid="PSA 19:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5"/>Ɛte sɛ ayeforokunu a ofi ne pia mu,</para>
  <para style="q2" vid="PSA 19:5">te sɛ ɔbran a ne ho pere no sɛ obetu ne mmirika.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Epue wɔ ɔsoro fa baabi</para>
  <para style="q2" vid="PSA 19:6">na atwa ne ho akosi ano;</para>
  <para style="q2" vid="PSA 19:6">biribiara nsiw ne hyew ho kwan.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>
    <char style="nd">Awurade</char> mmara yɛ pɛ,</para>
  <para style="q2" vid="PSA 19:7">ɛkanyan ɔkra no.</para>
  <para style="q1" vid="PSA 19:7">Ahotoso wɔ <char style="nd">Awurade</char> nhyehyɛe mu,</para>
  <para style="q2" vid="PSA 19:7">ɛma nea onnim nyansa hu nyansa.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>
    <char style="nd">Awurade</char> ahyɛde teɛ;</para>
  <para style="q2" vid="PSA 19:8">ɛma koma mu anigye.</para>
  <para style="q1" vid="PSA 19:8">
    <char style="nd">Awurade</char> ɔhyɛ nsɛm mu da hɔ;</para>
  <para style="q2" vid="PSA 19:8">na ebue ani.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>
    <char style="nd">Awurade</char> suro yɛ kronkron,</para>
  <para style="q2" vid="PSA 19:9">ɛte hɔ daa.</para>
  <para style="q1" vid="PSA 19:9">
    <char style="nd">Awurade</char> mmara nsɛm yɛ nokware</para>
  <para style="q2" vid="PSA 19:9">na ne nyinaa teɛ.<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Ɛsom bo sen sikakɔkɔɔ</para>
  <para style="q2" vid="PSA 19:10">ɛsen sikakɔkɔɔ kann;</para>
  <para style="q1" vid="PSA 19:10">ɛyɛ dɛ sen ɛwo,</para>
  <para style="q2" vid="PSA 19:10">ɛsen ɛwo a efi ɛwokyɛm mu.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Wɔnam so bɔ wo somfo kɔkɔ se,</para>
  <para style="q2" vid="PSA 19:11">sodi so akatua yɛ bebree.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Hena na ohu nʼankasa mfomso?</para>
  <para style="q2" vid="PSA 19:12">Fa me mfomso a ahintaw kyɛ me.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Bɔ wʼakoa ho ban fi ɔboayɛ bɔne ho,</para>
  <para style="q2" vid="PSA 19:13">na anhyɛ me so.</para>
  <para style="q1" vid="PSA 19:13">Ɛno na ɛbɛma madi bem,</para>
  <para style="q2" vid="PSA 19:13">a merenni fɔ wɔ bɔne akɛse ho.<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Ma mʼanom nsɛm ne me koma mu adwene</para>
  <para style="q2" vid="PSA 19:14">nyɛ nea ɛsɔ wʼani, <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 19:14">me Botan ne me Gyefo.</para>
  <para style="d" vid="PSA 19:14">Wɔde ma dwonkyerɛfo.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">Dwom 20</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>
    <char style="nd">Awurade</char> ntie wo wɔ wʼahohia mu;</para>
  <para style="q2" vid="PSA 20:1">Yakob Nyankopɔn din mmɔ wo ho ban.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Ɔmfa mmoa mfi kronkronbea hɔ mmrɛ wo,</para>
  <para style="q2" vid="PSA 20:2">na omfi Sion mmɛhyɛ wo den.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>Ɔnkae wʼafɔrebɔ nyinaa,</para>
  <para style="q2" vid="PSA 20:3">na ɔmma wo hyew afɔre nsɔ nʼani.<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Ɔmma wo nea wo koma pɛ,</para>
  <para style="q2" vid="PSA 20:4">na wo nhyehyɛe nyinaa nyɛ yiye.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Yɛbɛbɔ ose bere a woadi nkonim,</para>
  <para style="q2" vid="PSA 20:5">na yɛama yɛn frankaa so wɔ yɛn Nyankopɔn din mu.</para>
  <para style="b" vid="PSA 20:5"/>
  <para style="q1" vid="PSA 20:5">
    <char style="nd">Awurade</char> nyɛ wʼabisade nyinaa mma wo.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Afei mahu sɛ <char style="nd">Awurade</char> ma nea wasra no no nkonimdi,</para>
  <para style="q2" vid="PSA 20:6">ofi ne kronkronbea wɔ ɔsoro gye no so,</para>
  <para style="q2" vid="PSA 20:6">ɔde ne nkonimdi tumi a ɛwɔ ne nsa nifa mu no.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Ebinom de wɔn ho to wɔn nteaseɛnam so</para>
  <para style="q2" vid="PSA 20:7">na afoforo nso, wɔn apɔnkɔ so,</para>
  <para style="q2" vid="PSA 20:7">nanso yɛn de, yɛde yɛn ho to <char style="nd">Awurade</char> yɛn Nyankopɔn din so.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Wɔbrɛ wɔn ase ma wɔhwehwe ase,</para>
  <para style="q2" vid="PSA 20:8">na yɛn de, yɛsɔre gyina kirebenn.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>
    <char style="nd">Awurade</char>, ma ɔhene nkonimdi!</para>
  <para style="q2" vid="PSA 20:9">Yɛfrɛ a, gye yɛn so!</para>
  <para style="d" vid="PSA 20:9">Wɔde ma dwonkyerɛfo.<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">Dwom 21</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>
    <char style="nd">Awurade</char>, ɔhene di anigye wɔ wʼahoɔden mu.</para>
  <para style="q2" vid="PSA 21:1">Nʼani gye mmoroso wɔ nkonimdi a woma no nti!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Woama no nea ne koma pɛ;</para>
  <para style="q2" vid="PSA 21:2">woamfa nʼabisade ankame no.<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Wode nhyira a edi mu hyiaa no</para>
  <para style="q2" vid="PSA 21:3">na wode sikakɔkɔɔ ankasa ahenkyɛw hyɛɛ no.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>Obisaa wo hɔ nkwa, na wode maa no,</para>
  <para style="q2" vid="PSA 21:4">nna tenten a enni awiei.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Nkonimdi a woma no nti, nʼanuonyam so;</para>
  <para style="q2" vid="PSA 21:5">wode kɛseyɛ ne nidi adom no.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Ampa ara, woama no nhyira a ɛnsa da</para>
  <para style="q2" vid="PSA 21:6">na woama no ahosɛpɛw wɔ wʼanim anigye mu.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Ɔhene no de ne ho to <char style="nd">Awurade</char> so;</para>
  <para style="q2" vid="PSA 21:7">Ɔsorosoroni no nokware dɔ no nti,</para>
  <para style="q2" vid="PSA 21:7">ɔrenhinhim.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Wo nsa bɛka wʼatamfo nyinaa;</para>
  <para style="q2" vid="PSA 21:8">wo nsa nifa beso wɔn a wokyi wo no mu.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Bere a wubeyi wo ho adi no</para>
  <para style="q2" vid="PSA 21:9">wobɛyɛ wɔn sɛ fononoo a mu adɔ.</para>
  <para style="q1" vid="PSA 21:9">
    <char style="nd">Awurade</char> fi nʼabufuwhyew mu bɛmene wɔn,</para>
  <para style="q2" vid="PSA 21:9">na ne gya no ahyew wɔn.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Wobɛtɔre wɔn ase wɔ asase so,</para>
  <para style="q2" vid="PSA 21:10">na wɔn asefo afi adesamma mu.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Ɛwɔ mu sɛ wɔbɔ pɔw tia wo</para>
  <para style="q2" vid="PSA 21:11">na wɔyɛ nhyehyɛe bɔne, nanso wɔrenni nkonim;<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>efisɛ wobɛma wɔasan wɔn akyi</para>
  <para style="q2" vid="PSA 21:12">bere a woatwe bɛmma akyerɛ wɔn so no.<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Yɛma wo so, <char style="nd">Awurade</char>, wɔ wʼahoɔden mu;</para>
  <para style="q2" vid="PSA 21:13">yɛbɛto nnwom na yɛakamfo wo kɛseyɛ.</para>
  <para style="d" vid="PSA 21:13">Wɔde ma dwonkyerɛfo. Wɔto no sɛnea wɔto “Adekyee forote” dwom.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">Dwom 22</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>Me Nyankopɔn, me Nyankopɔn, adɛn nti na woagyaw me?</para>
  <para style="q2" vid="PSA 22:1">Adɛn nti na me nkwagye ne wo ntam aware,</para>
  <para style="q2" vid="PSA 22:1">adɛn na mʼapinisi nsɛm ne wo ntam aware?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>Me Nyankopɔn, misu frɛ wo awia, nanso wunnye me so,</para>
  <para style="q2" vid="PSA 22:2">mefrɛ wo anadwo, nanso minnya ɔhome.<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>Nanso wɔasi wo hene sɛ Ɔkronkronni;</para>
  <para style="q2" vid="PSA 22:3">wo na Israel kamfo wo.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Wo mu na yɛn agyanom de wɔn werɛ hyɛe;</para>
  <para style="q2" vid="PSA 22:4">wogyee wo dii, na wugyee wɔn.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Wosu frɛɛ wo na wugyee wɔn,</para>
  <para style="q2" vid="PSA 22:5">wɔde wɔn ho too wo so na woanni wɔn nhuammɔ.<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Nanso meyɛ osunson, na menyɛ onipa</para>
  <para style="q2" vid="PSA 22:6">nnipa bɔ me ahohora na wobu me animtiaa.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Obiara a ohu me di me ho fɛw;</para>
  <para style="q2" vid="PSA 22:7">wotwa me adapaa, wosow wɔn ti ka se:<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“Ɔde ne ho to <char style="nd">Awurade</char> so;</para>
  <para style="q2" vid="PSA 22:8">ma <char style="nd">Awurade</char> mmegye no.</para>
  <para style="q1" vid="PSA 22:8">Ma ɔmmɛboa no,</para>
  <para style="q2" vid="PSA 22:8">efisɛ ɔwɔ no mu anigye.”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>Wo na wuyii me fii awotwaa mu bae</para>
  <para style="q2" vid="PSA 22:9">na womaa me de me ho too wo so</para>
  <para style="q2" vid="PSA 22:9">bere a mitua me na nufu ano mpo.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Efi mʼawo mu na wɔde me too wo so;</para>
  <para style="q2" vid="PSA 22:10">efi me na yafunu mu, woayɛ me Nyankopɔn.<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Ntwe wo ho mfi me ho!</para>
  <para style="q2" vid="PSA 22:11">Efisɛ amane abɛn</para>
  <para style="q2" vid="PSA 22:11">na ɔboafo nni baabi.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Anantwinini bebree atwa me ho ahyia;</para>
  <para style="q2" vid="PSA 22:12">Basan anantwinini a wɔn ho yɛ den atwa me ho ahyia.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Gyata a wɔbobɔ mu na wɔtetew wɔn hanam mu</para>
  <para style="q2" vid="PSA 22:13">abuebue wɔn anom tɛtrɛɛ de kyerɛ me.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Wɔahwie me agu sɛ nsu,</para>
  <para style="q2" vid="PSA 22:14">na me nnompe nyinaa ahodwow.</para>
  <para style="q1" vid="PSA 22:14">Me koma adan amane;</para>
  <para style="q2" vid="PSA 22:14">anan wɔ me mu.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Mʼanom ayow te sɛ kyɛmfɛre mu.</para>
  <para style="q2" vid="PSA 22:15">Na me tɛkrɛma atare mʼanom.</para>
  <para style="q2" vid="PSA 22:15">Wode me to owu mfutuma mu.<verse eid="PSA 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Akraman atwa me ho ahyia,</para>
  <para style="q2" vid="PSA 22:16">nnebɔneyɛfo kuw atwa me ahyia,</para>
  <para style="q2" vid="PSA 22:16">wɔahwirew me nsa ne mʼanan mu.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Me nnompe nyinaa gu petee mu;</para>
  <para style="q2" vid="PSA 22:17">Mʼatamfo hwɛ me haa na wɔserew me.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Wɔkyɛ me atade mu fa,</para>
  <para style="q2" vid="PSA 22:18">na wɔbɔ me ntama so ntonto.<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>Na wo, <char style="nd">Awurade</char>, ntwe wo ho;</para>
  <para style="q2" vid="PSA 22:19">wone mʼahoɔden, bra ntɛm bɛboa me.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Gye me kra fi afoa ano;</para>
  <para style="q2" vid="PSA 22:20">gye me nkwa a ɛsom bo no fi akraman tumi ase.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Gye me nkwa fi gyata anom;</para>
  <para style="q2" vid="PSA 22:21">gye me fi ɛko mmɛn so.<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Mɛbɔ wo din akyerɛ me nuanom;</para>
  <para style="q2" vid="PSA 22:22">mɛkamfo wo wɔ wɔn a wɔahyia hɔ no nyinaa anim.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>Monkamfo <char style="nd">Awurade</char>, mo a musuro no no!</para>
  <para style="q2" vid="PSA 22:23">Mo a moyɛ Yakob asefo, monhyɛ no anuonyam!</para>
  <para style="q2" vid="PSA 22:23">Mo Israel asefo nyinaa, munni no ni!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>Ommuu nʼani nguu</para>
  <para style="q2" vid="PSA 22:24">ɔmanehunufo ateetee so ɛ,</para>
  <para style="q1" vid="PSA 22:24">ɔmfaa nʼanim nhintaw no;</para>
  <para style="q2" vid="PSA 22:24">na mmom watie ne sufrɛ a ɔde rehwehwɛ mmoa no.<verse eid="PSA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Me botae a mede yi wo ayɛ wɔ bagua mu no fi wo;</para>
  <para style="q2" vid="PSA 22:25">medi me bɔhyɛ so wɔ wɔn a wosuro wo no anim.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Ahiafo bedidi na wɔamee;</para>
  <para style="q2" vid="PSA 22:26">wɔn a wɔhwehwɛ <char style="nd">Awurade</char> beyi no ayɛ,</para>
  <para style="q2" vid="PSA 22:26">mo koma nnya nkwa daa.<verse eid="PSA 22:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Asase ano nyinaa</para>
  <para style="q2" vid="PSA 22:27">bɛkae akɔ <char style="nd">Awurade</char> nkyɛn,</para>
  <para style="q1" vid="PSA 22:27">na amanaman no mmusua nyinaa</para>
  <para style="q2" vid="PSA 22:27">bɛkotow nʼanim,<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>efisɛ tumi wɔ <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 22:28">na odi amanaman so hene.<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Asase so adefo nyinaa bedidi na wɔasɔre no;</para>
  <para style="q2" vid="PSA 22:29">wɔn a wɔkɔ dɔte mu nyinaa bebu nkotodwe nʼanim,</para>
  <para style="q2" vid="PSA 22:29">wɔn a wɔrentumi mma nkwa mu.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Nkyirimma nyinaa bɛsom no;</para>
  <para style="q2" vid="PSA 22:30">wɔbɛka Awurade ho asɛm akyerɛ awo ntoatoaso a edidi so.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Wɔbɛka ne trenee akyerɛ</para>
  <para style="q2" vid="PSA 22:31">nnipa a wonnya nwoo wɔn</para>
  <para style="q2" vid="PSA 22:31">efisɛ ɔno na wayɛ.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">Dwom 23</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>
    <char style="nd">Awurade</char> ne me hwɛfo, hwee renhia me.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>Ɔma meda wura frɔmfrɔm adidibea;</para>
  <para style="q1" vid="PSA 23:2">ogya me kɔ nsu a ɛho dwo ho,<verse eid="PSA 23:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3"/>odwudwo me kra.</para>
  <para style="q1" vid="PSA 23:3">Ɔde me fa akwantrenee so,</para>
  <para style="q2" vid="PSA 23:3">ne din nti.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Sɛ menam</para>
  <para style="q2" vid="PSA 23:4">owu sum kabii mu mpo a,</para>
  <para style="q1" vid="PSA 23:4">minsuro bɔne bi,</para>
  <para style="q2" vid="PSA 23:4">efisɛ wo ne me na ɛwɔ hɔ;</para>
  <para style="q1" vid="PSA 23:4">wʼabaa ne wo pema</para>
  <para style="q2" vid="PSA 23:4">na ɛkyekye me werɛ.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Woto me pon wɔ</para>
  <para style="q2" vid="PSA 23:5">mʼatamfo anim.</para>
  <para style="q1" vid="PSA 23:5">Wode ngo fɔw me tirim;</para>
  <para style="q2" vid="PSA 23:5">me kuruwa yɛ ma bu so.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Yiye ne adɔe nko na ebedi mʼakyi</para>
  <para style="q2" vid="PSA 23:6">me nkwanna nyinaa;</para>
  <para style="q1" vid="PSA 23:6">na mɛtena <char style="nd">Awurade</char> fi</para>
  <para style="q2" vid="PSA 23:6">daa.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">Dwom 24</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>Asase ne nea ɛwɔ mu nyinaa yɛ <char style="nd">Awurade</char> de;</para>
  <para style="q2" vid="PSA 24:1">wiase ne wɔn a wɔte mu nyinaa wɔ no;<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>efisɛ ɔno na ɔtoo ne fapem wɔ po so</para>
  <para style="q2" vid="PSA 24:2">na ɔde sii nsu ani.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Hena na obetumi aforo <char style="nd">Awurade</char> bepɔw no?</para>
  <para style="q2" vid="PSA 24:3">Hena na obetumi agyina ne tenabea kronkron hɔ?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>Nea ɔyɛ ade trenee na ne koma mu tew,</para>
  <para style="q2" vid="PSA 24:4">nea ne kra nni ahoni akyi</para>
  <para style="q2" vid="PSA 24:4">na ɔnka ntamhunu.<verse eid="PSA 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>Obenya <char style="nd">Awurade</char> nsam nhyira</para>
  <para style="q2" vid="PSA 24:5">ne bembu a efi ne Nkwagye Nyankopɔn.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Saa na awo ntoatoaso a wɔhwehwɛ <char style="nd">Awurade</char> no te</para>
  <para style="q2" vid="PSA 24:6">wɔn a wɔhwehwɛ wʼanim no, Yakob Nyankopɔn.<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>Mo aponkɛse, momma mo ti so;</para>
  <para style="q2" vid="PSA 24:7">wɔmma mo so, mo tete apon,</para>
  <para style="q2" vid="PSA 24:7">na Anuonyam Hene nhyɛn mu.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>Hena ne saa Anuonyam Hene yi?</para>
  <para style="q2" vid="PSA 24:8">Ɔno ne <char style="nd">Awurade</char> hoɔdenfo ne otumfo no</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">Awurade</char> a ɔyɛ ɔko mu nkonimdifo.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Momma mo ti so, mo aponkɛse</para>
  <para style="q2" vid="PSA 24:9">momma wɔn so, mo tete apon,</para>
  <para style="q2" vid="PSA 24:9">na anuonyam Hene no nkɔ mu.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Hena ne saa anuonyam Hene yi?</para>
  <para style="q2" vid="PSA 24:10">Asafo <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="PSA 24:10">ɔno ne anuonyam Hene no.<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">Dwom 25</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>
    <char style="nd">Awurade</char>, me Nyankopɔn, wo mu na mede me werɛ hyɛ.<verse eid="PSA 25:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 25:2"/>Wo so, me Nyankopɔn, na mede me ho to,</para>
  <para style="q1" vid="PSA 25:2">mma mʼanim ngu ase,</para>
  <para style="q2" vid="PSA 25:2">na mma mʼatamfo nso nni me so nkonim.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Wɔn a wɔde wɔn ho to wo so no mu biara</para>
  <para style="q2" vid="PSA 25:3">anim rengu ase da,</para>
  <para style="q1" vid="PSA 25:3">mmom, wɔn a wɔyɛ kɔntɔnkye kwa no</para>
  <para style="q2" vid="PSA 25:3">anim begu ase.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>Kyerɛ me wʼakwan, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 25:4">na minhu wʼatempɔn.<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>Fa wo nokware no so kyerɛkyerɛ me,</para>
  <para style="q2" vid="PSA 25:5">efisɛ woyɛ Onyankopɔn, me Gyefo,</para>
  <para style="q2" vid="PSA 25:5">na mʼani da wo so daa nyinaa.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>Kae, <char style="nd">Awurade</char>, wo mmɔborɔhunu ne wo dɔ kɛse</para>
  <para style="q2" vid="PSA 25:6">a ɛwɔ hɔ fi tete no.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Nkae me mmabun bere mu bɔne</para>
  <para style="q2" vid="PSA 25:7">ne mʼatuatew akwan;</para>
  <para style="q1" vid="PSA 25:7">kae me sɛnea wʼadɔe te,</para>
  <para style="q2" vid="PSA 25:7">
    <char style="nd">Awurade</char>, efisɛ wuye.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>
    <char style="nd">Awurade</char> ye na ɔteɛ;</para>
  <para style="q2" vid="PSA 25:8">enti ɔkyerɛkyerɛ nnebɔneyɛfo nʼakwan.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Ɔde ahobrɛasefo fa ɔkwan pa so</para>
  <para style="q2" vid="PSA 25:9">na ɔkyerɛ wɔn nʼapɛde.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>
    <char style="nd">Awurade</char> akwan nyinaa yɛ ɔdɔ ne nokwaredi</para>
  <para style="q2" vid="PSA 25:10">ma wɔn a wodi nʼapam mu ahyɛde so.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>
    <char style="nd">Awurade</char>, me bɔne so de,</para>
  <para style="q2" vid="PSA 25:11">nanso wo din nti, fa kyɛ me.<verse eid="PSA 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Enti hena ne onipa a osuro <char style="nd">Awurade</char>?</para>
  <para style="q2" vid="PSA 25:12">Ɔbɛkyerɛ no ɔkwan a wabɔ ama no.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>Obedi yiye wɔ ne nkwanna mu,</para>
  <para style="q2" vid="PSA 25:13">na nʼasefo afa asase no sɛ wɔn agyapade.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>
    <char style="nd">Awurade</char> da nʼatirimsɛm adi kyerɛ wɔn a wosuro no;</para>
  <para style="q2" vid="PSA 25:14">na ɔma wohu nʼapam.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Mʼani da <char style="nd">Awurade</char> so daa,</para>
  <para style="q2" vid="PSA 25:15">efisɛ ɔno nko ara na obeyi mʼanan afi afiri mu.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Dan wʼani hwɛ me, na dom me,</para>
  <para style="q2" vid="PSA 25:16">efisɛ meyɛ ankonam na meyɛ mmɔbɔ.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Me koma mu dadwen adɔɔso;</para>
  <para style="q2" vid="PSA 25:17">yi me dadwen fi me so.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Hwɛ me haw ne mʼahohiahia</para>
  <para style="q2" vid="PSA 25:18">na yi me bɔne nyinaa fi me so.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Hwɛ sɛnea mʼatamfo adɔɔso</para>
  <para style="q2" vid="PSA 25:19">ne ɔtan kɛse a wɔde tan me!<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Bɔ me nkwa ho ban na gye me;</para>
  <para style="q2" vid="PSA 25:20">mma mʼanim ngu ase,</para>
  <para style="q2" vid="PSA 25:20">efisɛ me guankɔbea ne wo.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Ma trenee ne nokware mmɔ me ho ban,</para>
  <para style="q2" vid="PSA 25:21">efisɛ mʼani da wo so.<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>Gye Israel, Onyankopɔn,</para>
  <para style="q2" vid="PSA 25:22">fi wɔn haw nyinaa mu.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">Dwom 26</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>Bu me bem, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 26:1">efisɛ, mabɔ bra a asɛm nni ho:</para>
  <para style="q1" vid="PSA 26:1">mede me ho too <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 26:1">na manhinhim.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>Sɔ me hwɛ, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 26:2">hwehwɛ me koma ne mʼadwene mu.<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>Wʼadɔe wɔ mʼanim daa</para>
  <para style="q2" vid="PSA 26:3">na mɛnantew wo nokware mu.<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Me ne nnaadaafo ntena</para>
  <para style="q2" vid="PSA 26:4">na me ne nyaatwomfo nso nni hwee yɛ.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Mikyi nnebɔneyɛfo guabɔ</para>
  <para style="q2" vid="PSA 26:5">na mempɛ sɛ me ne amumɔyɛfo tena.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Mehohoro me nsa wɔ bembu mu,</para>
  <para style="q2" vid="PSA 26:6">na mekɔ wʼafɔremuka ho ahyia, <char style="nd">Awurade</char>,<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>na mepae mu ka wʼayeyi</para>
  <para style="q2" vid="PSA 26:7">na meka wʼanwonwade nyinaa.<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>Mʼani gye ofi a wote mu ho, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 26:8">faako a wʼanuonyam wɔ no.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Mfa me kra nka nnebɔneyɛfo de ho nkɔ,</para>
  <para style="q2" vid="PSA 26:9">ne me nkwa nka mogyapɛfo de ho,<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>wɔn a amumɔyɛ nhyehyɛe wɔ wɔn nsam</para>
  <para style="q2" vid="PSA 26:10">na adanmude ayɛ wɔn nsa nifa ma.<verse eid="PSA 26:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Nanso mebɔ ɔbra a ho tew;</para>
  <para style="q2" vid="PSA 26:11">hu me mmɔbɔ na gye me nkwa.<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Mʼanan sisi asase tamaa so;</para>
  <para style="q2" vid="PSA 26:12">na guabɔ kɛse ase na mɛkamfo <char style="nd">Awurade</char>.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">Dwom 27</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>
    <char style="nd">Awurade</char> ne me hann ne me nkwagye;</para>
  <para style="q2" vid="PSA 27:1">hena na minsuro no?</para>
  <para style="q1" vid="PSA 27:1">
    <char style="nd">Awurade</char> ne me nkwa ahoɔden,</para>
  <para style="q2" vid="PSA 27:1">na hena anim na me ho mpopo?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Sɛ nnipa bɔne bɔ toa me</para>
  <para style="q2" vid="PSA 27:2">pɛ sɛ wokum me,</para>
  <para style="q1" vid="PSA 27:2">sɛ mʼatamfo tow hyɛ me so a,</para>
  <para style="q2" vid="PSA 27:2">wobehintihintiw ahwehwe ase.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Sɛ dɔm mpo twa me ho hyia a,</para>
  <para style="q2" vid="PSA 27:3">me koma rentu;</para>
  <para style="q1" vid="PSA 27:3">mpo sɛ wotu me so sa a,</para>
  <para style="q2" vid="PSA 27:3">ɛno mu koraa na minya awerehyɛmu.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Ade baako na mibisa <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 27:4">na ɛno na mehwehwɛ;</para>
  <para style="q1" vid="PSA 27:4">sɛ mɛtena <char style="nd">Awurade</char> fi</para>
  <para style="q2" vid="PSA 27:4">me nkwanna nyinaa,</para>
  <para style="q1" vid="PSA 27:4">na mahwɛ <char style="nd">Awurade</char> ahoɔfɛ</para>
  <para style="q2" vid="PSA 27:4">na mahwehwɛ no wɔ nʼasɔrefi.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Hiada mu no,</para>
  <para style="q2" vid="PSA 27:5">ɔde me besie nʼatenae dwoodwoo;</para>
  <para style="q1" vid="PSA 27:5">ɔbɛkora me wɔ Ahyiae Ntamadan kronkron mu</para>
  <para style="q2" vid="PSA 27:5">ɔde me si ɔbotan so wɔ sorosoro.<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>Afei ɔbɛma me ti so</para>
  <para style="q2" vid="PSA 27:6">wɔ atamfo a wɔatwa me ho ahyia no so;</para>
  <para style="q1" vid="PSA 27:6">mede anigye bɛbɔ afɔre wɔ nʼAhyiae Ntamadan mu;</para>
  <para style="q2" vid="PSA 27:6">na mɛto dwom, ahyehyɛ nnwom ama <char style="nd">Awurade</char>.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>
    <char style="nd">Awurade</char>, sɛ misu frɛ wo a, tie me!</para>
  <para style="q2" vid="PSA 27:7">Hu me mmɔbɔ na gye me so!<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Me koma ka wɔ wo ho se, “Hwehwɛ nʼanim!”</para>
  <para style="q2" vid="PSA 27:8">Wʼanim, <char style="nd">Awurade</char> na mɛhwehwɛ.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Mfa wʼanim nhintaw me,</para>
  <para style="q2" vid="PSA 27:9">mfa abufuw mpam wo somfo</para>
  <para style="q2" vid="PSA 27:9">me boafo ne wo.</para>
  <para style="q1" vid="PSA 27:9">Mpo me, na nnyaw me,</para>
  <para style="q2" vid="PSA 27:9">mʼAgyenkwa Nyankopɔn.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Mʼagya ne me na begyaw me hɔ de,</para>
  <para style="q2" vid="PSA 27:10">nanso <char style="nd">Awurade</char> begye me.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>Kyerɛ me wʼakwan, <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 27:11">fa me fa ɔkwan tee so,</para>
  <para style="q2" vid="PSA 27:11">me nhyɛsofo nti.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Nnyaa me mma sɛnea mʼatamfo pɛ,</para>
  <para style="q2" vid="PSA 27:12">nnansekurumfo sɔre tia me</para>
  <para style="q2" vid="PSA 27:12">na wopuw awurukasɛm.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Meda so wɔ saa anidaso yi sɛ:</para>
  <para style="q2" vid="PSA 27:13">mehu <char style="nd">Awurade</char> ayamye</para>
  <para style="q2" vid="PSA 27:13">wɔ ateasefo asase so.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Twɛn <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 27:14">Hyɛ wo ho den na ma wo bo nyɛ duru</para>
  <para style="q2" vid="PSA 27:14">na twɛn <char style="nd">Awurade</char>.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">Dwom 28</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>Wo na misu frɛ wo,</para>
  <para style="q2" vid="PSA 28:1">
    <char style="nd">Awurade</char> me Botan;</para>
  <para style="q2" vid="PSA 28:1">nsiw wʼaso wɔ me ho.</para>
  <para style="q1" vid="PSA 28:1">Sɛ woyɛ komm a,</para>
  <para style="q2" vid="PSA 28:1">mɛyɛ sɛ wɔn a wɔasian kɔ amoa mu no.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Tie me mmɔborɔsu</para>
  <para style="q2" vid="PSA 28:2">bere a mefrɛ wo apɛ mmoa,</para>
  <para style="q1" vid="PSA 28:2">bere a mema me nsa so</para>
  <para style="q2" vid="PSA 28:2">kyerɛ wo Tenabea Kronkron hɔ.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Mfa me mfra amumɔyɛfo mu ntwe me nkɔ,</para>
  <para style="q2" vid="PSA 28:3">mfa me nka wɔn a wɔyɛ bɔne no ho.</para>
  <para style="q1" vid="PSA 28:3">Wɔne wɔn yɔnkonom kasa fɛfɛ,</para>
  <para style="q2" vid="PSA 28:3">nanso wɔde ɔtan sie wɔn koma mu.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Twe wɔn aso wɔ nea wɔayɛ no so;</para>
  <para style="q2" vid="PSA 28:4">wɔn adwuma bɔne no so;</para>
  <para style="q1" vid="PSA 28:4">tua nea wɔde wɔn nsa ayɛ so ka</para>
  <para style="q2" vid="PSA 28:4">na fa nea ɛfata wɔn san bra wɔn so.<verse eid="PSA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Sɛ wommu nea <char style="nd">Awurade</char> ayɛ</para>
  <para style="q2" vid="PSA 28:5">ne nea ɔde ne nsa ayɛ no nti</para>
  <para style="q1" vid="PSA 28:5">ɔbɛbrɛ wɔn ase</para>
  <para style="q2" vid="PSA 28:5">na ɔremma wɔnnsɔre bio.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Ayeyi nka <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 28:6">efisɛ watie me mmɔborɔsu.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>
    <char style="nd">Awurade</char> ne mʼahoɔden ne me nkatabo</para>
  <para style="q2" vid="PSA 28:7">me koma wɔ ne mu ahotoso, na ɔboa me.</para>
  <para style="q1" vid="PSA 28:7">Me koma di ahurusi</para>
  <para style="q2" vid="PSA 28:7">na mede dwonto bɛda no ase.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>
    <char style="nd">Awurade</char> yɛ ahoɔden ma ne nkurɔfo;</para>
  <para style="q2" vid="PSA 28:8">ne nkwagye nsraban ma nea wɔasra no ngo.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Gye wo nkurɔfo na hyira wʼagyapade;</para>
  <para style="q2" vid="PSA 28:9">yɛ wɔn hwɛfo, na wo ne wɔn nnantew afebɔɔ.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">Dwom 29</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>Momfa mma <char style="nd">Awurade</char> no, mo ɔsoro abɔde,</para>
  <para style="q2" vid="PSA 29:1">momfa anuonyam ne tumi mma <char style="nd">Awurade</char>.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Momfa anuonyam a ɛfata <char style="nd">Awurade</char> din mma no;</para>
  <para style="q2" vid="PSA 29:2">monsɔre <char style="nd">Awurade</char> wɔ nʼanuonyam kronkron mu.<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>
    <char style="nd">Awurade</char> nne wɔ nsu no so;</para>
  <para style="q2" vid="PSA 29:3">anuonyam Nyankopɔn bobɔ mu,</para>
  <para style="q1" vid="PSA 29:3">
    <char style="nd">Awurade</char> bobɔ mu wɔ nsu akɛse so.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>
    <char style="nd">Awurade</char> nne mu wɔ tumi;</para>
  <para style="q2" vid="PSA 29:4">
    <char style="nd">Awurade</char> nne mu wɔ anuonyam.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>
    <char style="nd">Awurade</char> nne bubu sida;</para>
  <para style="q2" vid="PSA 29:5">
    <char style="nd">Awurade</char> nne bubu Lebanon sida mu nketenkete<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Ɔma Lebanon huruhuruw te sɛ nantwi ba,</para>
  <para style="q2" vid="PSA 29:6">na Sirion nso sɛ ɛko ba.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>
    <char style="nd">Awurade</char> nne pa ma anyinam gya dɛw.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>
    <char style="nd">Awurade</char> nne wosow sare so;</para>
  <para style="q2" vid="PSA 29:8">
    <char style="nd">Awurade</char> wosow Kades sare.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>
    <char style="nd">Awurade</char> nne kyinkyim adum</para>
  <para style="q2" vid="PSA 29:9">na ɛma kwae yɛ kwaterekwa.</para>
  <para style="q1" vid="PSA 29:9">Nʼasɔredan mufo nyinaa teɛ mu ka se,</para>
  <para style="q2" vid="PSA 29:9">“Anuonyam nka Onyankopɔn!”<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>
    <char style="nd">Awurade</char> di hene wɔ nsuyiri so;</para>
  <para style="q2" vid="PSA 29:10">wɔasi <char style="nd">Awurade</char> hene afebɔɔ.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>
    <char style="nd">Awurade</char> ma ne nkurɔfo ahoɔden,</para>
  <para style="q2" vid="PSA 29:11">na ɔde asomdwoe hyira wɔn.</para>
  <para style="d" vid="PSA 29:11">Dwom a wɔto de buee Asɔredan no ano.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">Dwom 30</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>Mɛma wo so, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 30:1">efisɛ, woayi me afi bun mu</para>
  <para style="q2" vid="PSA 30:1">na woamma mʼatamfo anserew me.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>
    <char style="nd">Awurade</char> me Nyankopɔn, misu frɛɛ wo sɛ boa me</para>
  <para style="q2" vid="PSA 30:2">na wosaa me yare.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>
    <char style="nd">Awurade</char>, wuyii me fii ɔda mu;</para>
  <para style="q2" vid="PSA 30:3">wode me ho kyɛɛ me na woamma mankɔ amoa mu.<verse eid="PSA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Monto ayeyi nnwom mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 30:4">mo a moyɛ nʼahotewfo!</para>
  <para style="q1" vid="PSA 30:4">Monkamfo ne din kronkron no.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Nʼabufuw nkyɛ,</para>
  <para style="q2" vid="PSA 30:5">na nʼadɔe wɔ hɔ daa;</para>
  <para style="q1" vid="PSA 30:5">agyaadwotwa bɛwɔ hɔ anadwo,</para>
  <para style="q2" vid="PSA 30:5">nanso ahosɛpɛw bɛba anɔpa.<verse eid="PSA 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Metee nka sɛ mewɔ bammɔ no, mekae se,</para>
  <para style="q2" vid="PSA 30:6">“Merenhinhim da.”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>
    <char style="nd">Awurade</char>, woyɛɛ me adom no</para>
  <para style="q2" vid="PSA 30:7">womaa me bepɔw gyinaa pintinn</para>
  <para style="q1" vid="PSA 30:7">na wode wʼanim hintaw me no,</para>
  <para style="q2" vid="PSA 30:7">me koma tui.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>Wo, <char style="nd">Awurade</char> na mefrɛɛ wo;</para>
  <para style="q2" vid="PSA 30:8">wo hɔ na misu mesrɛɛ mmɔborɔhunu se:<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Mfaso bɛn na ɛwɔ me sɛe so,</para>
  <para style="q2" vid="PSA 30:9">sɛ mɛkɔ amoa mu?</para>
  <para style="q1" vid="PSA 30:9">Mfutuma beyi wo ayɛ ana?</para>
  <para style="q2" vid="PSA 30:9">Ɛbɛpae mu aka wo nokwaredi ana?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>Tie me, <char style="nd">Awurade</char>, na hu me mmɔbɔ!</para>
  <para style="q2" vid="PSA 30:10">
    <char style="nd">Awurade</char>, yɛ me boafo.”<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Wodan mʼagyaadwotwa yɛɛ no asaw;</para>
  <para style="q2" vid="PSA 30:11">wuyii mʼatweaatam fii me ho</para>
  <para style="q2" vid="PSA 30:11">na wode anigye furaa me,<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>sɛ me koma bɛto nnwom ama wo na ɛrenyɛ komm.</para>
  <para style="q2" vid="PSA 30:12">
    <char style="nd">Awurade</char> me Nyankopɔn, meyi wo ayɛ daa.</para>
  <para style="d" vid="PSA 30:12">Wɔde ma dwonkyerɛfo.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">Dwom 31</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>Wo mu, <char style="nd">Awurade</char> na manya guankɔbea;</para>
  <para style="q2" vid="PSA 31:1">mma mʼanim ngu ase;</para>
  <para style="q2" vid="PSA 31:1">fi wo trenee mu gye me.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Yɛ aso ma me,</para>
  <para style="q2" vid="PSA 31:2">bra ntɛm begye me;</para>
  <para style="q1" vid="PSA 31:2">yɛ me bammɔ botan,</para>
  <para style="q2" vid="PSA 31:2">aban a mʼatamfo nsa renka me.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Sɛ woyɛ me botan ne mʼaban nti,</para>
  <para style="q2" vid="PSA 31:3">wo din nti di mʼanim na kyerɛ me kwan.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Gye me fi afiri a wɔasum me no mu,</para>
  <para style="q2" vid="PSA 31:4">efisɛ wo ne me guankɔbea.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Wo nsam na mede me kra hyɛ;</para>
  <para style="q2" vid="PSA 31:5">gye me bio, <char style="nd">Awurade</char>, Onyankopɔn nokwafo.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Mikyi wɔn a wɔsom abosom huhuw;</para>
  <para style="q2" vid="PSA 31:6">mede me ho to <char style="nd">Awurade</char> so.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Mʼani begye na madi ahurusi wɔ wo dɔ mu,</para>
  <para style="q2" vid="PSA 31:7">efisɛ wuhu mʼamanehunu,</para>
  <para style="q2" vid="PSA 31:7">na wunim me kra mu haw.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Womfaa me nhyɛɛ ɔtamfo no nsa</para>
  <para style="q2" vid="PSA 31:8">mmom wode me nan asisi petee mu.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Hu me mmɔbɔ, <char style="nd">Awurade</char>, efisɛ me ho yeraw me;</para>
  <para style="q2" vid="PSA 31:9">awerɛhow ama mʼani so ayɛ kusuu</para>
  <para style="q2" vid="PSA 31:9">ɔyaw ama me kra ne me honam ayɛ mmerɛw.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Ɔyawdi retew me nkwa so,</para>
  <para style="q2" vid="PSA 31:10">na abooboo tew me mfe so;</para>
  <para style="q1" vid="PSA 31:10">ɔhaw nti mʼahoɔden kɔ fam,</para>
  <para style="q2" vid="PSA 31:10">na me nnompe nso ahodwow.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Mʼatamfo nyinaa nti,</para>
  <para style="q2" vid="PSA 31:11">mayɛ ahohora wɔ me nnamfonom mu;</para>
  <para style="q1" vid="PSA 31:11">nnipa a wonim me suro me,</para>
  <para style="q2" vid="PSA 31:11">na wɔn a wohu me mmɔnten so guan.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Obiara werɛ afi me te sɛ nea mawu;</para>
  <para style="q2" vid="PSA 31:12">mayɛ sɛ kuku a abɔ.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Mete asomsɛm dodow a wɔka</para>
  <para style="q2" vid="PSA 31:13">ahunahuna atwa me ho ahyia.</para>
  <para style="q1" vid="PSA 31:13">Wɔrepam me ti so,</para>
  <para style="q2" vid="PSA 31:13">na wɔbɔ pɔw sɛ wobekum me.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Nanso mede me ho ato wo so, <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 31:14">meka se, “Woyɛ me Nyankopɔn.”<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Me mmere wɔ wo nsam</para>
  <para style="q2" vid="PSA 31:15">gye me fi mʼatamfo</para>
  <para style="q2" vid="PSA 31:15">ne wɔn a wɔtaa me no nsam.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Tew wʼanim kyerɛ wo somfo;</para>
  <para style="q2" vid="PSA 31:16">gye me wɔ wo dɔ a enni huammɔ no mu.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Mma mʼanim ngu ase, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 31:17">efisɛ masu afrɛ wo;</para>
  <para style="q1" vid="PSA 31:17">mmom, ma amumɔyɛfo anim ngu ase</para>
  <para style="q2" vid="PSA 31:17">na wɔnna wɔn nna mu komm.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>Mua atorofo ano,</para>
  <para style="q2" vid="PSA 31:18">efisɛ wɔde ahantan ne animtiaabu</para>
  <para style="q2" vid="PSA 31:18">kasa tia atreneefo.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Wo papayɛ dɔɔso,</para>
  <para style="q2" vid="PSA 31:19">ɛno na woakora ama wɔn a wosuro wo no</para>
  <para style="q1" vid="PSA 31:19">ɛno na wode ma wɔn a woguan toa wo no</para>
  <para style="q2" vid="PSA 31:19">wɔ nnipa anim.<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Wode wɔn sie wʼanim bammɔ mu</para>
  <para style="q2" vid="PSA 31:20">fi nnipa nsusuwii bɔne ho;</para>
  <para style="q1" vid="PSA 31:20">wo tenabea hɔ na wode wɔn sie dwoodwoo</para>
  <para style="q2" vid="PSA 31:20">fi tɛkrɛma a ɛbɔ sobo ho.<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Ayeyi nka <char style="nd">Awurade</char>!</para>
  <para style="q2" vid="PSA 31:21">Sɛ wayi ne dɔ nwonwaso akyerɛ me</para>
  <para style="q2" vid="PSA 31:21">bere a na mewɔ kuropɔn a atamfo atwa ho ahyia no mu no.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Mebɔɔ huboa no mekae se:</para>
  <para style="q2" vid="PSA 31:22">“Woayi wʼani afi me so!”</para>
  <para style="q1" vid="PSA 31:22">Nanso wotee me mmɔborɔsu</para>
  <para style="q2" vid="PSA 31:22">bere a mekotow srɛɛ wo no.<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Monnɔ <char style="nd">Awurade</char> mo a moyɛ nʼahotewfo nyinaa!</para>
  <para style="q2" vid="PSA 31:23">
    <char style="nd">Awurade</char> kora wɔn a wodi nokware so,</para>
  <para style="q2" vid="PSA 31:23">na ahomasofo de, otua wɔn ka pɛpɛɛpɛ.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Monyɛ den na momma mo bo ntɔ mo yam,</para>
  <para style="q2" vid="PSA 31:24">mo a mowɔ anidaso wɔ <char style="nd">Awurade</char> mu nyinaa.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">Dwom 32</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>Nhyira ne wɔn a</para>
  <para style="q2" vid="PSA 32:1">wɔde wɔn amumɔyɛ akyɛ wɔn,</para>
  <para style="q2" vid="PSA 32:1">na wɔakata wɔn bɔne so.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Nhyira nka onipa a</para>
  <para style="q2" vid="PSA 32:2">
    <char style="nd">Awurade</char> mmu ne bɔne ngu no so</para>
  <para style="q2" vid="PSA 32:2">na nnaadaa nni ne honhom mu.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Bere a meyɛɛ komm no,</para>
  <para style="q2" vid="PSA 32:3">me nnompe yɛɛ mmrɛw,</para>
  <para style="q2" vid="PSA 32:3">apini a misii no da mu nyinaa nti.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Awia ne anadwo</para>
  <para style="q2" vid="PSA 32:4">wo nsa yɛɛ den wɔ me so;</para>
  <para style="q1" vid="PSA 32:4">mʼahoɔden sae</para>
  <para style="q2" vid="PSA 32:4">te sɛ awia bere mu ɔhyew.<verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Afei, migyee me bɔne too mu.</para>
  <para style="q2" vid="PSA 32:5">Mankata mʼamumɔyɛ so.</para>
  <para style="q1" vid="PSA 32:5">Mekae se, “Mɛka</para>
  <para style="q2" vid="PSA 32:5">me bɔne akyerɛ <char style="nd">Awurade</char>,”</para>
  <para style="q2" vid="PSA 32:5">na wode me bɔne ho afɔdi kyɛɛ me.<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Enti, ma agyidifo nyinaa mmɔ wo mpae</para>
  <para style="q2" vid="PSA 32:6">bere a wohu wo;</para>
  <para style="q1" vid="PSA 32:6">ampa ara sɛ asu akɛse yiri a,</para>
  <para style="q2" vid="PSA 32:6">ɛrenka no.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Wone me hintabea;</para>
  <para style="q2" vid="PSA 32:7">wobɛbɔ me ho ban wɔ amanehunu mu</para>
  <para style="q2" vid="PSA 32:7">na wode nkwagye nnwom atwa me ho ahyia.<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Mɛkyerɛkyerɛ wo ɔkwan a wobɛfa so</para>
  <para style="q2" vid="PSA 32:8">metu wo fo na mahwɛ wo so.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Ɛnyɛ sɛ ɔpɔnkɔ anaa afurumpɔnkɔ a</para>
  <para style="q2" vid="PSA 32:9">onni ntease nti</para>
  <para style="q1" vid="PSA 32:9">wɔde nnareka ne hama na ɛdannan no,</para>
  <para style="q2" vid="PSA 32:9">sɛ ɛbɛyɛ a wɔbɛba wo nkyɛn.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Omumɔyɛfo amanehunu dɔɔso,</para>
  <para style="q2" vid="PSA 32:10">nanso <char style="nd">Awurade</char> adɔe a ɛnsa da no</para>
  <para style="q2" vid="PSA 32:10">twa onipa a ɔde ne ho to no so no ho hyia.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Munni ahurusi na mo ani nnye wɔ <char style="nd">Awurade</char> mu, mo atreneefo;</para>
  <para style="q2" vid="PSA 32:11">monto dwom, mo a mo koma mu tew.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">Dwom 33</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>Momfa ahurusi nto dwom mma <char style="nd">Awurade</char>, mo atreneefo,</para>
  <para style="q2" vid="PSA 33:1">ɛfata sɛ wɔn a wɔteɛ no yi no ayɛ.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Momfa sanku nkamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 33:2">monto dwom mma no wɔ sankuten so.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Monto dwom foforo mma no.</para>
  <para style="q2" vid="PSA 33:3">Momfa nimdeɛ mmɔ sanku no na monteɛ mu ahurusi so!<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>
    <char style="nd">Awurade</char> asɛm teɛ na ɛyɛ nokware</para>
  <para style="q2" vid="PSA 33:4">odi nokware wɔ nea ɔyɛ nyinaa mu.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>
    <char style="nd">Awurade</char> dɔ treneeyɛ ne atɛntrenee.</para>
  <para style="q2" vid="PSA 33:5">Nʼadɔe a ɛnsa da no ahyɛ asase so ma.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>
    <char style="nd">Awurade</char> asɛm so na wɔnam yɛɛ ɔsorosoro,</para>
  <para style="q2" vid="PSA 33:6">nʼanom home so na wɔnam yɛɛ ɔsoro asafo.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Ɔka po nsu boa ano kuw;</para>
  <para style="q2" vid="PSA 33:7">na ɔde bun sie nea hɔ dɔ.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Momma asase sofo nyinaa nsuro <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 33:8">na wiasefo nyinaa mfa nidi mma no.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Ɔno na ɔkasa ma ɛbaa mu</para>
  <para style="q2" vid="PSA 33:9">na ɔhyɛ ma egyinaa pintinn.<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>
    <char style="nd">Awurade</char> sɛe amanaman no nhyehyɛe;</para>
  <para style="q2" vid="PSA 33:10">ɔma adesamma nsusuwii yɛ ɔkwa.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>Nanso <char style="nd">Awurade</char> nhyehyɛe tim hɔ daa,</para>
  <para style="q2" vid="PSA 33:11">ne koma mu botae wɔ hɔ ma awo ntoatoaso.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Nhyira ne ɔman a ne Nyankopɔn ne <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 33:12">nnipa a oyii wɔn sɛ nʼagyapade no.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>
    <char style="nd">Awurade</char> hwɛ adesamma nyinaa fi ɔsoro.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>Ofi nʼatenae hwɛ wɔn a wɔte asase so nyinaa.<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>Ɔno ne nea ɔbɔɔ wɔn nyinaa koma,</para>
  <para style="q2" vid="PSA 33:15">na osusuw nea wɔyɛ nyinaa ho.<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Ɛnyɛ ɔhene asraafo dɔm kɛse na ebegye no;</para>
  <para style="q1" vid="PSA 33:16">ɔkofo biara nni hɔ a ofi nʼahoɔden mu guan.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Ɔpɔnkɔ mu ahotoso yɛ ɔkwa wɔ nkwagye mu;</para>
  <para style="q2" vid="PSA 33:17">nʼahoɔden nyinaa akyi no, ɔrentumi nnye nkwa.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Nanso <char style="nd">Awurade</char> ani wɔ wɔn a wosuro no no so,</para>
  <para style="q2" vid="PSA 33:18">wɔn a wɔwɔ anidaso wɔ ne dɔ a ɛnsa da no mu,<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>sɛ obegye wɔn afi owu mu</para>
  <para style="q2" vid="PSA 33:19">na wama wɔatena nkwa mu wɔ ɔkɔm bere mu.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Yɛde anidaso twɛn <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 33:20">ɔyɛ yɛn boafo ne yɛn nkatabo.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Ne mu na yɛn koma di ahurusi,</para>
  <para style="q2" vid="PSA 33:21">efisɛ yɛde yɛn ho to ne din kronkron no so.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>Ma wʼadɔe a ɛnsa da no ntena yɛn so, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 33:22">sɛnea anidaso a yɛwɔ wɔ mu no te.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">Dwom 34</para>
  <para style="d">Dawid dwom a ɔtoo bere a ɔboapa dan ɔbɔdamfo wɔ Abimelek anim no na ɔpanyin no gyaa no ma ɔkɔe no akyi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>Mede aseda bɛma <char style="nd">Awurade</char> bere nyinaa;</para>
  <para style="q2" vid="PSA 34:1">nʼayeyi wɔ mʼanom daa.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Me kra bɛhoahoa ne ho wɔ <char style="nd">Awurade</char> mu;</para>
  <para style="q2" vid="PSA 34:2">ma amanehunufo nte na wonni ahurusi.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Mo ne me nkamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 34:3">momma yɛmmɔ mu nkamfo ne din!<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Mefrɛɛ <char style="nd">Awurade</char> na ogyee me so;</para>
  <para style="q2" vid="PSA 34:4">na ogyee me wɔ nea misuro nyinaa mu.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Wɔn a wɔhwɛ nʼanim no hyerɛn</para>
  <para style="q2" vid="PSA 34:5">na wɔn anim rengu ase da.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Ohiani yi frɛe, na <char style="nd">Awurade</char> tiee no;</para>
  <para style="q2" vid="PSA 34:6">na ogyee no fii nʼahohia nyinaa mu.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>
    <char style="nd">Awurade</char> bɔfo wɛn wɔn a wosuro no,</para>
  <para style="q2" vid="PSA 34:7">na ogye wɔn.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Monka nhwɛ na munhu sɛ <char style="nd">Awurade</char> ye.</para>
  <para style="q2" vid="PSA 34:8">Nhyira ne onipa a oguan toa no.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Munsuro <char style="nd">Awurade</char>, mo a moyɛ nʼahotefo,</para>
  <para style="q2" vid="PSA 34:9">na wɔn a wosuro no no nhia hwee.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Gyata yɛ mmerɛw na ɔkɔm de wɔn,</para>
  <para style="q2" vid="PSA 34:10">nanso wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no, ade pa biara remmɔ wɔn.<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Mommra, me mma, monyɛ aso mma me;</para>
  <para style="q2" vid="PSA 34:11">mɛkyerɛkyerɛ mo <char style="nd">Awurade</char> ho suro.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Mo mu hena na ɔpɛ nkwa</para>
  <para style="q2" vid="PSA 34:12">na ɔpɛ sɛ ohu nna pa bebree?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>Ɛne ɛnsɛ sɛ ɔka kasa bɔne, na ɛsɛ sɛ ogyae atorotwa.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Twe wo ho fi bɔne ho, na yɛ papa;</para>
  <para style="q2" vid="PSA 34:14">hwehwɛ asomdwoe na tiw no.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>
    <char style="nd">Awurade</char> ani wɔ atreneefo so</para>
  <para style="q2" vid="PSA 34:15">na otie wɔn mpaebɔ;<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>
    <char style="nd">Awurade</char> ani sa wɔn a wɔyɛ bɔne,</para>
  <para style="q2" vid="PSA 34:16">sɛ obeyi wɔn nkae afi asase yi so.<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>Atreneefo teɛ mu su, na <char style="nd">Awurade</char> tie wɔn;</para>
  <para style="q2" vid="PSA 34:17">oyi wɔn fi wɔn haw nyinaa mu.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>
    <char style="nd">Awurade</char> bɛn wɔn a wɔn koma abotow</para>
  <para style="q2" vid="PSA 34:18">na ogye wɔn a wɔadwerɛw wɔn wɔ honhom mu no nkwa.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Onipa trenee behu amane bebree</para>
  <para style="q2" vid="PSA 34:19">nanso <char style="nd">Awurade</char> gye no fi ne nyinaa mu;<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ɔbɔ ne nnompe nyinaa ho ban,</para>
  <para style="q2" vid="PSA 34:20">sɛnea mu baako mpo mu remmu.<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Bɔne bekum ɔdebɔneyɛni;</para>
  <para style="q2" vid="PSA 34:21">ɔtreneeni atamfo benya afɔbu.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>
    <char style="nd">Awurade</char> gye nʼasomfo nkwa;</para>
  <para style="q2" vid="PSA 34:22">wɔn a woguan toa no no mu biara renkɔ afɔbu mu.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">Dwom 35</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>
    <char style="nd">Awurade</char> wo ne wɔn a wɔne me di asi no nni asi;</para>
  <para style="q2" vid="PSA 35:1">ko tia wɔn a wɔko tia me.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Fa wo nkatabo ne wʼakode;</para>
  <para style="q2" vid="PSA 35:2">na sɔre bra bɛboa me.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Twe peaw ne abonnua</para>
  <para style="q2" vid="PSA 35:3">wɔ wɔn a wɔtaa me no so.</para>
  <para style="q1" vid="PSA 35:3">Ka kyerɛ me kra se,</para>
  <para style="q2" vid="PSA 35:3">“Mene wʼagyenkwa.”<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Wɔn a wɔpɛ sɛ wokum me no,</para>
  <para style="q2" vid="PSA 35:4">ma wɔn anim ngu ase;</para>
  <para style="q1" vid="PSA 35:4">wɔn a wɔbɔ me sɛe ho pɔw no,</para>
  <para style="q2" vid="PSA 35:4">ma wɔmfa aniwu nsan wɔn akyi.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Ma wɔnyɛ sɛ ntɛtɛ a mframa bɔ gu</para>
  <para style="q2" vid="PSA 35:5">wɔn a <char style="nd">Awurade</char> bɔfo repam wɔn no.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>Ma wɔn akwan so nnuru sum na ɛso ɛnyɛ toro,</para>
  <para style="q2" vid="PSA 35:6">na <char style="nd">Awurade</char> bɔfo ntaa wɔn.<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Esiane sɛ wɔde ɔtan sum me afiri kwa,</para>
  <para style="q2" vid="PSA 35:7">na wotuu amoa maa me a menyɛɛ wɔn hwee no nti<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>ma ɔsɛe mmefu wɔn mu</para>
  <para style="q2" vid="PSA 35:8">na ɔtan no a wɔde hintaw no nyi wɔn,</para>
  <para style="q2" vid="PSA 35:8">na ma wɔnhwe amoa no mu nsɛe.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>Afei me kra ani begye wɔ <char style="nd">Awurade</char> mu</para>
  <para style="q2" vid="PSA 35:9">na wasɛpɛw ne ho wɔ ne nkwagye mu.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Me nipadua nyinaa bɛteɛ mu aka se,</para>
  <para style="q2" vid="PSA 35:10">“Hena na ɔte sɛ wo, <char style="nd">Awurade</char>?</para>
  <para style="q1" vid="PSA 35:10">Wugye ohiani fi ahoɔdenfo nsam,</para>
  <para style="q2" vid="PSA 35:10">ne nea onni bi fi apoobɔfo nsam.”<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Adansekurumfo sɔre;</para>
  <para style="q2" vid="PSA 35:11">wobisa me nneɛma a minnim ho hwee ho asɛm.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Wɔde bɔne tua papa a meyɛ so ka</para>
  <para style="q2" vid="PSA 35:12">na wɔma me kra yɛ basaa.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Nanso bere a wɔyaree no, mifuraa atweaatam</para>
  <para style="q2" vid="PSA 35:13">na mede akɔnkyen brɛɛ me ho ase.</para>
  <para style="q1" vid="PSA 35:13">Bere a me mpaebɔ ho mmuae nnya mmae no,<verse eid="PSA 35:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14"/>mekɔɔ so twaa adwo,</para>
  <para style="q2" vid="PSA 35:14">sɛnea meyɛ ma mʼadamfo anaa onuabarima.</para>
  <para style="q1" vid="PSA 35:14">Mede awerɛhow sii me ti ase</para>
  <para style="q2" vid="PSA 35:14">te sɛ nea meregyam me na.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Nanso bere a mihintiw no wɔde anigye boaa wɔn ho ano;</para>
  <para style="q2" vid="PSA 35:15">afowfo twaa me ho hyiae a minnim,</para>
  <para style="q2" vid="PSA 35:15">na wodii me ho nseku a wɔantwa so da.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Wɔde adwemmɔne dii me ho fɛw te sɛ nnipa a wonni nyamesu,</para>
  <para style="q2" vid="PSA 35:16">wɔtwɛree wɔn se guu me so.<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>
    <char style="nd">Awurade</char>, wobɛhwɛ wɔn akosi da bɛn?</para>
  <para style="q2" vid="PSA 35:17">Gye me nkwa fi wɔn sɛe mu,</para>
  <para style="q2" vid="PSA 35:17">gye me nkwa a ɛsom bo no fi saa gyata yi nsam.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>Na mɛda wo ase wɔ guabɔ kɛse ase;</para>
  <para style="q2" vid="PSA 35:18">wɔ nnipa dodow mu na mɛkamfo wo.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Mma mʼatamfo a wɔtan me kwa no</para>
  <para style="q2" vid="PSA 35:19">nhwɛ me haw nserew.</para>
  <para style="q1" vid="PSA 35:19">Mma wɔn a menyɛɛ wɔn hwee nanso wɔtan me no</para>
  <para style="q2" vid="PSA 35:19">mmfa adwene bɔne mmu me anikyiw.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Wɔnnkasa asomdwoe so,</para>
  <para style="q2" vid="PSA 35:20">na mmom, wɔde ntwatoso</para>
  <para style="q2" vid="PSA 35:20">tia nnipa a wɔmpɛ wɔn ho asɛm wɔ asase yi so.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Wɔhwɛ me haw ka se, “Yiw! Yiw,</para>
  <para style="q2" vid="PSA 35:21">yɛde yɛn ankasa ani ahu.”<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>
    <char style="nd">Awurade</char>, woahu na mmua wʼano.</para>
  <para style="q2" vid="PSA 35:22">Ntwe wo ho nkɔ akyiri, Awurade.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>Nyan, sɔre na bɛbɔ me ho ban!</para>
  <para style="q2" vid="PSA 35:23">Ka bi ma me, me Nyankopɔn ne mʼAwurade.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>Di mʼasɛm ma me wɔ wo trenee no mu, <char style="nd">Awurade</char> me Nyankopɔn;</para>
  <para style="q2" vid="PSA 35:24">mma wɔnnhwɛ me haw nserew.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Mma wɔnnwene nka se, “Yiw, nea yɛpɛ ni!”</para>
  <para style="q2" vid="PSA 35:25">anaa wɔnnka se, “Yɛanya no.”<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Ma wɔn a wɔhwɛ me haw serew me wɔ mʼahohiahia mu no</para>
  <para style="q2" vid="PSA 35:26">nyinaa anim ngu ase na wɔnyɛ basaa;</para>
  <para style="q1" vid="PSA 35:26">ma wɔn a wodi me so akokurokosɛm no</para>
  <para style="q2" vid="PSA 35:26">nhyɛ aniwu ne animguase atade.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Ma wɔn a wodi ahurusi wɔ me bembu ho no</para>
  <para style="q2" vid="PSA 35:27">mfa anigye ne ahosɛpɛw nteɛ mu</para>
  <para style="q1" vid="PSA 35:27">bere nyinaa mu; ma wɔnka se, “Momma <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 35:27">ɔno na nʼani gye ne somfo yiyedi ho.”<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Me tɛkrɛma bɛka wo trenee,</para>
  <para style="q2" vid="PSA 35:28">ne wʼayeyi, da mu nyinaa.</para>
  <para style="d" vid="PSA 35:28">Wɔde ma dwonkyerɛfo.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">Dwom 36</para>
  <para style="d">
    <char style="nd">Awurade</char> somfo Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>Nkɔmhyɛ bi wɔ me koma mu a efi Onyankopɔn hɔ</para>
  <para style="q2" vid="PSA 36:1">a ɛfa omumɔyɛfo mmarato ho.</para>
  <para style="q1" vid="PSA 36:1">Onyankopɔn suro nni wɔn ani so.<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>Na ɔno ankasa ani so no ɔdaadaa no ho dodo,</para>
  <para style="q2" vid="PSA 36:2">nti ɛmma onhu ne bɔne nnyae yɛ.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>Nʼanom nsɛm yɛ atirimɔden ne nnaadaa;</para>
  <para style="q2" vid="PSA 36:3">onnim nyansa bio na wayɛ papa.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Ɔda ne mpa so mpo a ɔbɔ pɔw bɔne;</para>
  <para style="q2" vid="PSA 36:4">na ogyaa ne ho ma bɔne kwan</para>
  <para style="q2" vid="PSA 36:4">na ɔmpo nea enye.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>
    <char style="nd">Awurade</char>, wʼadɔe du ɔsorosoro</para>
  <para style="q2" vid="PSA 36:5">wo nokwaredi du wim tɔnn.<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Wo trenee te sɛ mmepɔw akɛse.</para>
  <para style="q2" vid="PSA 36:6">Wʼatɛntrenee mu dɔ sɛ po bun.</para>
  <para style="q1" vid="PSA 36:6">Ao <char style="nd">Awurade</char>, wokora nnipa ne mmoa nyinaa so.<verse eid="PSA 36:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 36:7"/>Wʼadɔe a ɛnsa da no som bo!</para>
  <para style="q1" vid="PSA 36:7">Nnipa mu akɛse ne nketewa</para>
  <para style="q2" vid="PSA 36:7">nya guankɔbea wɔ wo ntaban nwini ase.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Wodi nea abu so wɔ wo fi,</para>
  <para style="q2" vid="PSA 36:8">woma wɔnom fi wʼanika asuten no mu.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>Wo nkyɛn na nkwa asuti wɔ;</para>
  <para style="q2" vid="PSA 36:9">wo hann mu na yehu hann.<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Kɔ so dɔ wɔn a wonim wo,</para>
  <para style="q2" vid="PSA 36:10">ma wo trenee ntena wɔn a wɔteɛ, koma mu.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Mma ɔhantanni nan ntia me</para>
  <para style="q2" vid="PSA 36:11">anaa omumɔyɛfo nsa nnsunsum me.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Hwɛ sɛnea nnebɔneyɛfo ahwehwe ase,</para>
  <para style="q2" vid="PSA 36:12">wɔdeda hɔ a wɔrentumi nsɔre bio.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">Dwom 37</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>Nhaw wo ho, nnebɔneyɛfo nti;</para>
  <para style="q2" vid="PSA 37:1">mma wʼani mmmere wɔn a wɔyɛ bɔne;<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>Wɔte sɛ sare, ɛrenkyɛ na ahyew,</para>
  <para style="q2" vid="PSA 37:2">wɔte sɛ dua amono, ɛrenkyɛ na awu.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Fa wo ho to <char style="nd">Awurade</char> so na yɛ papa.</para>
  <para style="q2" vid="PSA 37:3">Tena asase no so na ma wʼani nka asomdwoe adidibea hɔ.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Ma wʼani nnye wɔ <char style="nd">Awurade</char> mu</para>
  <para style="q2" vid="PSA 37:4">na wama wo nea wo koma pɛ.<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Fa wʼakwan hyɛ <char style="nd">Awurade</char> nsam;</para>
  <para style="q2" vid="PSA 37:5">na fa wo ho to no so, na ɔno na ɔbɛyɛ:<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>ɔbɛma wo treneeyɛ ahyerɛn sɛ adekyee,</para>
  <para style="q2" vid="PSA 37:6">na wʼatɛntrenee ayɛ sɛ owigyinae.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Yɛ komm wɔ <char style="nd">Awurade</char> anim na tɔ wo bo ase twɛn no,</para>
  <para style="q2" vid="PSA 37:7">nhaw wo ho wɔ wɔn a asi wɔn yiye ho</para>
  <para style="q2" vid="PSA 37:7">efisɛ wɔnam bɔne akwan so.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Mma wo bo mmfuw na gyae abufuwhyew;</para>
  <para style="q2" vid="PSA 37:8">nhaw wo ho, ekowie bɔne nko ara.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Wobetwa nnebɔneyɛfo agu,</para>
  <para style="q2" vid="PSA 37:9">nanso wɔn a wɔn ani da <char style="nd">Awurade</char> so no</para>
  <para style="q2" vid="PSA 37:9">wobenya asase no adi so.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Ɛrenkyɛ, nnebɔneyɛfo bɛyera.</para>
  <para style="q2" vid="PSA 37:10">Wɔbɛhwehwɛ wɔn, nanso wɔrenhu wɔn.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>Nanso ahobrɛasefo benya asase no adi so</para>
  <para style="q2" vid="PSA 37:11">na wɔanya asomdwoe mmoroso.<verse eid="PSA 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Amumɔyɛfo bɔ pɔw bɔne tia atreneefo</para>
  <para style="q2" vid="PSA 37:12">na wɔtwɛre wɔn se gu wɔn so;<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>nanso <char style="nd">Awurade</char> serew amumɔyɛfo,</para>
  <para style="q2" vid="PSA 37:13">na onim sɛ wɔn nna abɛn.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Amumɔyɛfo twe afoa</para>
  <para style="q2" vid="PSA 37:14">na wokuntun wɔn ta mu</para>
  <para style="q1" vid="PSA 37:14">sɛ wobekum ahiafo ne mmɔborɔfo,</para>
  <para style="q2" vid="PSA 37:14">sɛ wobekum wɔn a wɔn akwan teɛ.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Nanso wɔn afoa bɛwowɔ wɔn ankasa koma mu,</para>
  <para style="q2" vid="PSA 37:15">na wɔn ta mu abubu.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Kakra a atreneefo wɔ no som bo</para>
  <para style="q2" vid="PSA 37:16">sen amumɔyɛfo bebree ahonya;<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>efisɛ amumɔyɛfo ahoɔden bɛsa</para>
  <para style="q2" vid="PSA 37:17">nanso <char style="nd">Awurade</char> bɛwowaw atreneefo.<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>
    <char style="nd">Awurade</char> nim wɔn a wɔn ho nni asɛm no nna,</para>
  <para style="q2" vid="PSA 37:18">na wɔn agyapade bɛtena hɔ daa.<verse eid="PSA 37:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Ahohiahia bere mu wɔremmrɛ.</para>
  <para style="q2" vid="PSA 37:19">Ɔkɔm bere mu wobenya ama abu so.<verse eid="PSA 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Nanso amumɔyɛfo bɛyera.</para>
  <para style="q2" vid="PSA 37:20">
    <char style="nd">Awurade</char> atamfo bɛyɛ sɛ nwura mu nhwiren;</para>
  <para style="q2" vid="PSA 37:20">wobetu ayera sɛ wusiw.<verse eid="PSA 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Amumɔyɛfo pɛ bosea, na wontua,</para>
  <para style="q2" vid="PSA 37:21">nanso ɔtreneeni de ahummɔbɔ ma;<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>Wɔn a <char style="nd">Awurade</char> ahyira wɔn no benya asase no adi so,</para>
  <para style="q2" vid="PSA 37:22">na wobetwa wɔn a ɔdome wɔn no agu.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>Sɛ <char style="nd">Awurade</char> ani sɔ onipa akwan a,</para>
  <para style="q2" vid="PSA 37:23">ɔma nʼanammɔntu si pi.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>Sɛ ohintiw a ɔrenhwe ase,</para>
  <para style="q2" vid="PSA 37:24">efisɛ <char style="nd">Awurade</char> kura no wɔ ne nsam.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Na meyɛ aberante, na mprempren mabɔ akwakoraa,</para>
  <para style="q2" vid="PSA 37:25">na minhuu ɔtreneeni a <char style="nd">Awurade</char> apa nʼakyi</para>
  <para style="q2" vid="PSA 37:25">anaasɛ ne mma resrɛ aduan.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>Bere biara ɔyɛ adɔe, na ɔde fɛm kwa;</para>
  <para style="q2" vid="PSA 37:26">na ne mma benya nhyira.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Twe wo ho fi bɔne ho na yɛ papa</para>
  <para style="q2" vid="PSA 37:27">na wobɛtena asase no so afebɔɔ.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Efisɛ, <char style="nd">Awurade</char> pɛ nea ɛteɛ,</para>
  <para style="q2" vid="PSA 37:28">na ɔrennyaw ne nkurɔfo anokwafo no.</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">Wobenya bammɔ daa nyinaa.</para>
  <para style="q2" vid="PSA 37:28">Nanso amumɔyɛfo asefo de, wobetwa wɔn agu.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Atreneefo benya asase no adi so</para>
  <para style="q2" vid="PSA 37:29">na wɔatena so afebɔɔ.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Ɔtreneeni ano ka nyansasɛm,</para>
  <para style="q2" vid="PSA 37:30">na ne tɛkrɛma ka nea ɛteɛ.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Ne Nyankopɔn mmara wɔ ne koma mu;</para>
  <para style="q1" vid="PSA 37:31">wɔn anan nwatiri.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Amumɔyɛfo tetɛw atreneefo</para>
  <para style="q2" vid="PSA 37:32">hwehwɛ sɛ wobekum wɔn,<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>nanso <char style="nd">Awurade</char> nnyaa wɔn mma wɔn,</para>
  <para style="q2" vid="PSA 37:33">na ɔremma wommu wɔn kumfɔ wɔ asennii.<verse eid="PSA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Montwɛn <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 37:34">na monhwɛ nʼakwan.</para>
  <para style="q1" vid="PSA 37:34">Ɔbɛma mo so na moanya asase no adi so;</para>
  <para style="q2" vid="PSA 37:34">sɛ wotwitwa amumɔyɛfo no gu a, mubehu.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Mahu omumɔyɛfo a ɔyɛ basabasa</para>
  <para style="q2" vid="PSA 37:35">sɛ ɔredi yiye sɛ dua amono a esi asase pa so,<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>nanso ankyɛ na nʼawiei bae a wonhu no bio;</para>
  <para style="q2" vid="PSA 37:36">mehwehwɛɛ no, nanso manhu no.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Susuw nea ɔyɛ pɛ ho, na hwɛ nea ɔteɛ;</para>
  <para style="q2" vid="PSA 37:37">na asomdwoe nipa benya asetena pa daakye.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Nanso wɔbɛsɛe nnebɔneyɛfo nyinaa;</para>
  <para style="q2" vid="PSA 37:38">na wɔbɛtɔre wɔn asefo ase.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Atreneefo nkwagye fi <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 37:39">ɔne wɔn aban wɔ amanehunu bere mu.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>
    <char style="nd">Awurade</char> boa wɔn na ogye wɔn;</para>
  <para style="q2" vid="PSA 37:40">oyi wɔn fi amumɔyɛfo nsam, na ogye wɔn nkwa,</para>
  <para style="q2" vid="PSA 37:40">efisɛ wohintaw wɔ ne mu.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">Dwom 38</para>
  <para style="d">Dawid dwom. Adesrɛ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>
    <char style="nd">Awurade</char>, nka mʼanim wɔ wʼabufuw mu</para>
  <para style="q2" vid="PSA 38:1">na ntwe mʼaso wɔ wʼabufuwhyew mu.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>Wo bɛmma hwirew me mu,</para>
  <para style="q2" vid="PSA 38:2">na wo nsa adwerɛw me.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Wʼabufuwhyew no nti ahoɔden biara nni me mu;</para>
  <para style="q2" vid="PSA 38:3">me bɔne nti, me nnompe ahodwow.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Mʼafɔdi amene me</para>
  <para style="q2" vid="PSA 38:4">te sɛ adesoa a mu yɛ duru dodo.<verse eid="PSA 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Mʼakuru bɔn na aporɔw</para>
  <para style="q2" vid="PSA 38:5">esiane me bɔne mu agyimisɛm nti.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Makotow na wɔabrɛ me ase;</para>
  <para style="q2" vid="PSA 38:6">da mu nyinaa menantenantew twa agyaadwo.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Mʼakyi dompe mu yaw boro so:</para>
  <para style="q2" vid="PSA 38:7">ahoɔden biara nni me nipadua mu.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Mabrɛ na mapɛtɛw koraa.</para>
  <para style="q2" vid="PSA 38:8">Me koma mu yaw ma misi apini.<verse eid="PSA 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>
    <char style="nd">Awurade</char>, nea merehwɛ anim nyinaa da wʼanim;</para>
  <para style="q2" vid="PSA 38:9">mʼapinisi nhintaw wo.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Me koma bɔ kitirikitiri, na mʼahoɔden asa</para>
  <para style="q2" vid="PSA 38:10">mpo mʼaniwa aduru sum.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Mʼapirakuru nti me nnamfonom ne me yɔnkonom mmɛn me;</para>
  <para style="q2" vid="PSA 38:11">mʼafipamfo twe wɔn ho fi me ho.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Wɔn a wɔpɛ sɛ wokum me no sum me mfiri,</para>
  <para style="q2" vid="PSA 38:12">wɔn a wɔpɛ sɛ wɔhaw me no di me sɛe ho nkɔmmɔ</para>
  <para style="q2" vid="PSA 38:12">da mu nyinaa wodwen nnaadaasɛm ho.<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Mete sɛ ɔsotifo a ɔnte asɛm,</para>
  <para style="q2" vid="PSA 38:13">mete sɛ mum a ontumi nkasa.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Mayɛ sɛ obi a ɔnte asɛm,</para>
  <para style="q2" vid="PSA 38:14">nea nʼano ntumi mma mmuae.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>
    <char style="nd">Awurade</char>, meretwɛn wo;</para>
  <para style="q2" vid="PSA 38:15">
    <char style="nd">Awurade</char> me Nyankopɔn, wubegye me so.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Mekae se, “Mma wɔn ani nnye;</para>
  <para style="q2" vid="PSA 38:16">anaa wɔmma wɔn ho so bere a mʼanan awatiri no.”<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Mereyɛ mahwe ase,</para>
  <para style="q2" vid="PSA 38:17">na me yaw da so wɔ me mu.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Meka me mfomso kyerɛ;</para>
  <para style="q2" vid="PSA 38:18">me bɔne hyɛ me so.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Bebree na wɔyɛ mʼatamfo;</para>
  <para style="q2" vid="PSA 38:19">wɔn a wɔtan me kwa no dɔɔso.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Wɔn a wɔde bɔne tua me papa so ka no,</para>
  <para style="q2" vid="PSA 38:20">bɔ me ahohora bere a mereyɛ papa.<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>
    <char style="nd">Awurade</char> nnyaw me.</para>
  <para style="q2" vid="PSA 38:21">Me Nyankopɔn, nkɔ akyiri!<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Bra ntɛm bɛboa me,</para>
  <para style="q2" vid="PSA 38:22">
    <char style="nd">Awurade</char>, mʼAgyenkwa.</para>
  <para style="d" vid="PSA 38:22">Wɔde ma dwonkyerɛfo no. Yedutun.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">Dwom 39</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>Mekae se, “Mɛhwɛ mʼakwan yiye</para>
  <para style="q2" vid="PSA 39:1">na mamfa me tɛkrɛma anyɛ bɔne;</para>
  <para style="q1" vid="PSA 39:1">mɛto mʼano nnareka</para>
  <para style="q2" vid="PSA 39:1">bere a amumɔyɛfo bɛn me yi.<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Enti meyɛɛ komm</para>
  <para style="q2" vid="PSA 39:2">a manka asɛm papa biara mpo</para>
  <para style="q2" vid="PSA 39:2">nanso mʼapinisi mu yɛɛ den.<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>Me koma ho guan no wɔ me mu.</para>
  <para style="q2" vid="PSA 39:3">Midwinnwen no, ogya dɛwee;</para>
  <para style="q2" vid="PSA 39:3">afei mede me tɛkrɛma kasae se:<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>“<char style="nd">Awurade</char>, ma minhu me nkwa awiei</para>
  <para style="q2" vid="PSA 39:4">ne me nna dodow;</para>
  <para style="q1" vid="PSA 39:4">ma minhu sɛnea me nkwa si twa mu ntɛm so.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Woayɛ me nna sɛ nsateaa baako pɛ;</para>
  <para style="q2" vid="PSA 39:5">na me mfe dodow nyɛ hwee wɔ wʼani so.</para>
  <para style="q2" vid="PSA 39:5">Onipa nkwa yɛ ɔhome bi kɛkɛ.<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Onipa redi akɔneaba nyinaa no, ɔte sɛ sunsuma bi kwa;</para>
  <para style="q2" vid="PSA 39:6">ɔhaw ne ho nanso ɔyɛ kwa;</para>
  <para style="q2" vid="PSA 39:6">ɔboa ahonya ano na onnim nea ɛbɛyɛ ne de.<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“Afei <char style="nd">Awurade</char>, dɛn na merehwehwɛ?</para>
  <para style="q2" vid="PSA 39:7">Mʼanidaso wɔ wo mu.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>Gye me fi me bɔne nyinaa mu;</para>
  <para style="q2" vid="PSA 39:8">mma mennyɛ nkwaseafo aserewde.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Meyɛɛ komm, na mammue mʼano,</para>
  <para style="q2" vid="PSA 39:9">efisɛ wo na woayɛ eyi.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Yi wʼasotwe fi me so;</para>
  <para style="q2" vid="PSA 39:10">wo nsa ano amanehunu amene me.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Woka nnipa anim, na wotwe wɔn aso wɔ wɔn bɔne ho;</para>
  <para style="q2" vid="PSA 39:11">wosɛe wɔn ahonya te sɛ nwewee;</para>
  <para style="q2" vid="PSA 39:11">onipa biara yɛ ɔhome kɛkɛ.<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“<char style="nd">Awurade</char>, tie me mpaebɔ,</para>
  <para style="q2" vid="PSA 39:12">tie me sufrɛ;</para>
  <para style="q2" vid="PSA 39:12">nsiw wʼaso wɔ me su ho.</para>
  <para style="q1" vid="PSA 39:12">Me ne wo te hɔ sɛ ɔnanani,</para>
  <para style="q2" vid="PSA 39:12">sɛnea na mʼagyanom nyinaa te no.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>Yi wʼani fi me so na manya nkwa bio,</para>
  <para style="q2" vid="PSA 39:13">ansa na mafi ha a mente ase bio.”</para>
  <para style="d" vid="PSA 39:13">Wɔde ma dwonkyerɛfo.<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">Dwom 40</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>Mede boasetɔ twɛn <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 40:1">na ɔhwɛɛ me, na ɔtee me sufrɛ.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Oyii me fii amoa a mu yɛ toro mu,</para>
  <para style="q2" vid="PSA 40:2">fii dɔte ne dontori mu;</para>
  <para style="q1" vid="PSA 40:2">ɔde mʼanan sii ɔbotan so</para>
  <para style="q2" vid="PSA 40:2">na ɔmaa me baabi pa gyinae.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Ɔde dwom foforo hyɛɛ mʼanom,</para>
  <para style="q2" vid="PSA 40:3">ayeyi dwom a yɛde ma yɛn Nyankopɔn.</para>
  <para style="q1" vid="PSA 40:3">Bebree behu na wɔasuro,</para>
  <para style="q2" vid="PSA 40:3">na wɔde wɔn werɛ ahyɛ <char style="nd">Awurade</char> mu.<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Nhyira ne onipa a</para>
  <para style="q2" vid="PSA 40:4">ɔde <char style="nd">Awurade</char> yɛ nʼahotoso,</para>
  <para style="q1" vid="PSA 40:4">nea ɔmfa nʼani nto ahomaso so,</para>
  <para style="q2" vid="PSA 40:4">ne wɔn a wɔman di anyame huhuw akyi.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>
    <char style="nd">Awurade</char> me Nyankopɔn</para>
  <para style="q2" vid="PSA 40:5">woayɛ anwonwade bebree.</para>
  <para style="q1" vid="PSA 40:5">Nneɛma a wohyehyɛ maa yɛn no</para>
  <para style="q2" vid="PSA 40:5">obiara ntumi nka ne nyinaa nkyerɛ wo;</para>
  <para style="q1" vid="PSA 40:5">sɛ meka se mereka ne nyinaa ho asɛm a</para>
  <para style="q2" vid="PSA 40:5">ɛbɛdɔɔso dodo.<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>Wompɛ afɔrebɔ ne ayɛyɛde,</para>
  <para style="q2" vid="PSA 40:6">nanso woabue mʼaso;</para>
  <para style="q2" vid="PSA 40:6">woampɛ ɔhyew afɔre ne bɔne afɔre.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>Na mekae se, “Mini, maba,</para>
  <para style="q2" vid="PSA 40:7">sɛnea wɔakyerɛw afa me ho wɔ nhoma mmobɔwee no mu no.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Me Nyankopɔn, mepɛ sɛ meyɛ wʼapɛde;</para>
  <para style="q2" vid="PSA 40:8">wo mmara wɔ me koma mu.”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Meka wo trenee ho asɛm wɔ guabɔ kɛse ase;</para>
  <para style="q2" vid="PSA 40:9">mimmua mʼano,</para>
  <para style="q2" vid="PSA 40:9">
    <char style="nd">Awurade</char>, sɛnea wunim no.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Memmfa wo trenee ho asɛm nsie me koma mu;</para>
  <para style="q2" vid="PSA 40:10">meka wo nokware ne wo nkwagye ho asɛm.</para>
  <para style="q1" vid="PSA 40:10">Mankata wʼadɔe ne wo nokware so</para>
  <para style="q2" vid="PSA 40:10">wɔ guabɔ kɛse no ase.<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>
    <char style="nd">Awurade</char>, nyi wʼahummɔbɔ mfi me so;</para>
  <para style="q2" vid="PSA 40:11">ma wʼadɔe ne wo nokware mmɔ me ho ban daa.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>Ɔhaw bebree atwa me ho ahyia;</para>
  <para style="q2" vid="PSA 40:12">mʼamumɔyɛ abu afa me so enti minhu ade bio.</para>
  <para style="q1" vid="PSA 40:12">Ɛdɔɔso sen me ti so nwi,</para>
  <para style="q2" vid="PSA 40:12">na me koma abotow wɔ me mu.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>
    <char style="nd">Awurade</char>, ma ɛnsɔ wʼani sɛ wubegye me;</para>
  <para style="q2" vid="PSA 40:13">
    <char style="nd">Awurade</char>, bra ntɛm bɛboa me.<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Wɔn a wɔpɛ sɛ wokum me no nyinaa,</para>
  <para style="q2" vid="PSA 40:14">ma wɔn anim ngu ase na wɔnyɛ basaa;</para>
  <para style="q1" vid="PSA 40:14">ma wɔn a wɔpɛ sɛ mesɛe no</para>
  <para style="q2" vid="PSA 40:14">mfa aniwu nsan wɔn akyi.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Ma wɔn a wɔka, “Ɔtwea! Ɔtwea!” kyerɛ me no</para>
  <para style="q2" vid="PSA 40:15">nsan wɔn akyi, esiane wɔn aniwu nti.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Nanso ma wɔn a wɔhwehwɛ wo nyinaa</para>
  <para style="q2" vid="PSA 40:16">nsɛpɛw wɔn ho na wɔn ani nnye wɔ wo mu;</para>
  <para style="q1" vid="PSA 40:16">ma wɔn a wɔdɔ wo nkwagye no nka da biara se,</para>
  <para style="q2" vid="PSA 40:16">“<char style="nd">Awurade</char> yɛ ɔkɛse!”<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Nanso meyɛ ohiani ne mmɔborɔni;</para>
  <para style="q2" vid="PSA 40:17">ma <char style="nd">Awurade</char> nnwen me ho.</para>
  <para style="q1" vid="PSA 40:17">Wo ne me boafo ne me gyefo;</para>
  <para style="q2" vid="PSA 40:17">wo ne me Nyankopɔn, bra ntɛm.</para>
  <para style="d" vid="PSA 40:17">Wɔde ma dwonkyerɛfo.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">Dwom 41</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>Nhyira ne onipa a mmɔborɔni asɛm ho hia no;</para>
  <para style="q2" vid="PSA 41:1">
    <char style="nd">Awurade</char> gye no wɔ amanehunu bere mu.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>
    <char style="nd">Awurade</char> bɛbɔ ne ho ban na wakora ne kra;</para>
  <para style="q2" vid="PSA 41:2">obehyira no wɔ asase no so;</para>
  <para style="q2" vid="PSA 41:2">ɔrennyaa no mma nʼatamfo apɛde.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>
    <char style="nd">Awurade</char> bɛhwɛ no wɔ ne yare mpa so</para>
  <para style="q2" vid="PSA 41:3">na wagye no asi hɔ.<verse eid="PSA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Mekae se, “Ao <char style="nd">Awurade</char> hu me mmɔbɔ;</para>
  <para style="q2" vid="PSA 41:4">sa me yare, efisɛ mayɛ bɔne atia wo.”<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Mʼatamfo de adwene bɔne ka fa me ho se:</para>
  <para style="q2" vid="PSA 41:5">“Da bɛn na obewu ama ne din ayera?”<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Bere biara a obi ba me nkyɛn no,</para>
  <para style="q2" vid="PSA 41:6">ɔka atosɛm, na ne koma hɔre dinsɛe;</para>
  <para style="q2" vid="PSA 41:6">ofi adi kɔ a, ɔde kodi nseku.<verse eid="PSA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Mʼatamfo nyinaa keka asomsɛm fa me ho;</para>
  <para style="q2" vid="PSA 41:7">wosusuw bɔne ma me na wɔka se:<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“Ɔyare bɔne bi abɔ no;</para>
  <para style="q2" vid="PSA 41:8">ɔrensɔre mfi nea ɔda hɔ bio.”<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Mpo me yɔnko pa ara a mede me ho too no so,</para>
  <para style="q2" vid="PSA 41:9">nea me ne no too nsa didii no,</para>
  <para style="q2" vid="PSA 41:9">asɔre atia me.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>Nanso wo, <char style="nd">Awurade</char>, hu me mmɔbɔ;</para>
  <para style="q2" vid="PSA 41:10">ma me so, na mintua wɔn so ka.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Minim sɛ wʼani sɔ me,</para>
  <para style="q2" vid="PSA 41:11">na me tamfo renni me so nkonim.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Me nokwaredi mu, wukura me mu</para>
  <para style="q2" vid="PSA 41:12">na wode me gyina wʼanim afebɔɔ.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>Nhyira nka <char style="nd">Awurade</char>, Israel Nyankopɔn,</para>
  <para style="q2" vid="PSA 41:13">nnɛ ne daa nyinaa.</para>
  <para style="qc" vid="PSA 41:13">Amen! ne Amen!</para>
  <para style="d" vid="PSA 41:13">Wɔde ma dwonkyerɛfo.<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">1 NHOMA A ƐTO SO ABIEN</para>
  <para style="mr">
    <ref loc="PSA 42-72">Nnwom 42–72</ref></para>
  <para style="cl">Dwom 42</para>
  <para style="d">Koramma “maskil” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>Sɛnea ɔforote pere hwehwɛ nsuwansuwa no,</para>
  <para style="q2" vid="PSA 42:1">saa ara na me kra pere hwehwɛ wo, me Nyankopɔn.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>Onyankopɔn ho sukɔm de me kra, Onyankopɔn teasefo no.</para>
  <para style="q2" vid="PSA 42:2">Da bɛn na metumi akohyia Onyankopɔn?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Me nisu ayɛ mʼaduan</para>
  <para style="q2" vid="PSA 42:3">awia ne anadwo,</para>
  <para style="q1" vid="PSA 42:3">na da mu nyinaa nnipa bisa me se:</para>
  <para style="q2" vid="PSA 42:3">“Wo Nyankopɔn wɔ he?”<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Saa nneɛma yi na mekae</para>
  <para style="q2" vid="PSA 42:4">bere a mereka me koma mu nsɛm;</para>
  <para style="q1" vid="PSA 42:4">sɛnea na midi asafokuw anim,</para>
  <para style="q2" vid="PSA 42:4">na yɛde anigye nteɛteɛmu ne aseda nnwom</para>
  <para style="q1" vid="PSA 42:4">nantew yuu bɔ mu kɔ Onyankopɔn fi</para>
  <para style="q2" vid="PSA 42:4">wɔ afahyɛ da no.<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Me kra, adɛn, na woabotow?</para>
  <para style="q2" vid="PSA 42:5">Adɛn na woayɛ basaa wɔ me mu saa?</para>
  <para style="q1" vid="PSA 42:5">Fa wo ho to Onyankopɔn so,</para>
  <para style="q2" vid="PSA 42:5">na mɛkɔ so ayi no ayɛ,</para>
  <para style="q2" vid="PSA 42:5">mʼAgyenkwa ne me Nyankopɔn.<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Me kra abotow wɔ me mu,</para>
  <para style="q2" vid="PSA 42:6">enti mɛkae wo</para>
  <para style="q1" vid="PSA 42:6">fi Yordan asase so,</para>
  <para style="q2" vid="PSA 42:6">Hermon mmepɔw so, fi Bepɔw Misar so.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Ebun kɔ bun mu</para>
  <para style="q2" vid="PSA 42:7">wɔ wo nsu a ɛworo gu no nnyigyei mu;</para>
  <para style="q1" vid="PSA 42:7">wʼasorɔkye nyinaa</para>
  <para style="q2" vid="PSA 42:7">abu afa me so.<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>Adekyee mu, <char style="nd">Awurade</char> kyerɛ nʼadɔe,</para>
  <para style="q2" vid="PSA 42:8">adesae mu, ne dwom ba me nkyɛn,</para>
  <para style="q2" vid="PSA 42:8">mpae a mebɔ srɛ me nkwa Nyankopɔn.<verse eid="PSA 42:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Mibisa Onyankopɔn, me Botan no se,</para>
  <para style="q2" vid="PSA 42:9">“Adɛn nti na wo werɛ afi me?</para>
  <para style="q1" vid="PSA 42:9">Adɛn nti na ɛsɛ sɛ menantenantew twa adwo,</para>
  <para style="q2" vid="PSA 42:9">mʼatamfo nhyɛso nti?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Me nnompe te ɔdesani yawdi,</para>
  <para style="q2" vid="PSA 42:10">mʼahohiahiafo ateetee nti,</para>
  <para style="q1" vid="PSA 42:10">daa nyinaa wobisa me se,</para>
  <para style="q2" vid="PSA 42:10">“Wo Nyankopɔn wɔ he?”<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Me kra, adɛn, na woabotow?</para>
  <para style="q2" vid="PSA 42:11">Adɛn na woayɛ basaa wɔ me mu saa?</para>
  <para style="q1" vid="PSA 42:11">Fa wo ho to Onyankopɔn so,</para>
  <para style="q2" vid="PSA 42:11">na mɛkɔ so ayi no ayɛ,</para>
  <para style="q2" vid="PSA 42:11">mʼAgyenkwa ne me Nyankopɔn.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">Dwom 43</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>Me Nyankopɔn, bu me bem,</para>
  <para style="q2" vid="PSA 43:1">na ka mʼasɛm a etia ɔman a wonsuro wo no ma me;</para>
  <para style="q2" vid="PSA 43:1">gye me fi nnaadaafo ne amumɔyɛfo nsam.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>Woyɛ Onyankopɔn, mʼabandennen.</para>
  <para style="q2" vid="PSA 43:2">Adɛn nti na woapo me?</para>
  <para style="q1" vid="PSA 43:2">Adɛn nti na ɛsɛ sɛ menantenantew twa adwo</para>
  <para style="q2" vid="PSA 43:2">mʼatamfo nhyɛso nti?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Soma wo hann ne wo nokware</para>
  <para style="q2" vid="PSA 43:3">ma wɔnkyerɛ me kwan;</para>
  <para style="q1" vid="PSA 43:3">ma wɔmfa me mmra wo Bepɔw Kronkron no so,</para>
  <para style="q2" vid="PSA 43:3">faako a wote no.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>Afei, mɛkɔ Onyankopɔn afɔremuka anim,</para>
  <para style="q2" vid="PSA 43:4">mʼanigye ne mʼahosɛpɛw Nyankopɔn nkyɛn.</para>
  <para style="q1" vid="PSA 43:4">Mede sanku beyi wo ayɛ,</para>
  <para style="q2" vid="PSA 43:4">Onyankopɔn, me Nyankopɔn.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>Me kra, adɛn, na woabotow?</para>
  <para style="q2" vid="PSA 43:5">Adɛn na woayɛ basaa wɔ me mu saa?</para>
  <para style="q1" vid="PSA 43:5">Fa wo ho to Onyankopɔn so,</para>
  <para style="q2" vid="PSA 43:5">na mɛkɔ so ayi no ayɛ,</para>
  <para style="q2" vid="PSA 43:5">mʼAgyenkwa ne me Nyankopɔn.</para>
  <para style="d" vid="PSA 43:5">Dwom a wɔde ma dwonkyerɛfo.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">Dwom 44</para>
  <para style="d">Koramma “maskil” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>Ao, Onyankopɔn, yɛde yɛn aso ate;</para>
  <para style="q2" vid="PSA 44:1">yɛn agyanom aka akyerɛ yɛn;</para>
  <para style="q1" vid="PSA 44:1">nea woyɛɛ wɔ wɔn bere so,</para>
  <para style="q2" vid="PSA 44:1">wɔ tete mmere no mu.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Wode wo nsa pam amanaman no</para>
  <para style="q2" vid="PSA 44:2">na wobɔɔ yɛn agyanom atenase;</para>
  <para style="q1" vid="PSA 44:2">wodwerɛw nnipa no</para>
  <para style="q2" vid="PSA 44:2">na womaa yɛn agyanom dii yiye.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Ɛnyɛ wɔn afoa na wɔde nyaa asase no,</para>
  <para style="q2" vid="PSA 44:3">na ɛnyɛ wɔn nsa na ɛmaa wɔn nkonimdi;</para>
  <para style="q1" vid="PSA 44:3">ɛyɛ wo nsa nifa, wo basa,</para>
  <para style="q2" vid="PSA 44:3">ne wʼanim hann, efisɛ na wodɔ wɔn.<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Woyɛ me Hene ne me Nyankopɔn,</para>
  <para style="q2" vid="PSA 44:4">nea ɔhyɛ nkonimdi ma Yakob.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>Ɛnam wo so na yɛpam yɛn Atamfo;</para>
  <para style="q2" vid="PSA 44:5">wo din mu na yetiatia wɔn a wokyi yɛn no so.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Memmfa me ho nto mʼagyan so,</para>
  <para style="q2" vid="PSA 44:6">mʼafoa remfa nkonimdi mmrɛ me;<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>na wo na woma yedi yɛn atamfo so</para>
  <para style="q2" vid="PSA 44:7">wugu wɔn a wɔtan yɛn no anim ase.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Onyankopɔn mu na yɛhoahoa yɛn ho da mu nyinaa,</para>
  <para style="q2" vid="PSA 44:8">na yɛbɛkamfo wo din no daa daa.<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Nanso mprempren woapo yɛn abrɛ yɛn ase;</para>
  <para style="q2" vid="PSA 44:9">wone yɛn asraafo nkɔ ɔsa bio.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Woma yeguan fii dɔm anim,</para>
  <para style="q2" vid="PSA 44:10">ma yɛn atamfo fom yɛn agyapade.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Wuyii yɛn maa sɛ wonkum yɛn sɛ nguan</para>
  <para style="q2" vid="PSA 44:11">na woahwete yɛn wɔ amanaman no mu.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Wotɔn wo nkurɔfo fofoofow,</para>
  <para style="q2" vid="PSA 44:12">na woannya mfaso biara amfi mu.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Woayɛ yɛn ahohorade ama yɛn afipamfo,</para>
  <para style="q2" vid="PSA 44:13">animtiaabude ne aserewde ama wɔn a wɔatwa yɛn ho ahyia.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Woayɛ yɛn kasabebui wɔ aman no mu</para>
  <para style="q2" vid="PSA 44:14">na nnipa no wosow wɔn ti de gu yɛn so.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Mʼanimguase di mʼanim daa,</para>
  <para style="q2" vid="PSA 44:15">na aniwu akata mʼanim,<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>esiane wɔn a wɔbɔ me ahohora na wɔkasa tia me de yi me ahi,</para>
  <para style="q2" vid="PSA 44:16">esiane ɔtamfo a nʼani abere sɛ ɔbɛtɔ were no nti.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Eyinom nyinaa too yɛn de,</para>
  <para style="q2" vid="PSA 44:17">nanso yɛn werɛ mfii wo,</para>
  <para style="q2" vid="PSA 44:17">na yemmuu wʼapam no nso so ɛ.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Yɛn koma ntwe mfii wo ho;</para>
  <para style="q2" vid="PSA 44:18">na yɛn anan nso mman mfii wo kwan so ɛ.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>Nanso wodwerɛw yɛn yɛɛ yɛn sakraman tu</para>
  <para style="q2" vid="PSA 44:19">na wode sum kabii kataa yɛn so.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Sɛ na yɛn werɛ afi yɛn Nyankopɔn din</para>
  <para style="q2" vid="PSA 44:20">anaa sɛ yɛatrɛw yɛn nsam akyerɛ ananafo nyame a,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>anka Onyankopɔn behu,</para>
  <para style="q2" vid="PSA 44:21">efisɛ onim koma mu ahintasɛm.<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Nanso wo nti wokum yɛn daa nyinaa;</para>
  <para style="q2" vid="PSA 44:22">wobu yɛn sɛ nguan a wɔrekokum wɔn.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Nyan, <char style="nd">Awurade</char>! Adɛn nti na woada?</para>
  <para style="q2" vid="PSA 44:23">Keka wo ho! Nnyaw yɛn hɔ afebɔɔ.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Adɛn nti na wode wʼanim ahintaw</para>
  <para style="q2" vid="PSA 44:24">na wo werɛ fi yɛn ahohia ne nhyɛso?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Wɔabrɛ yɛn ase kɔ dɔte mu</para>
  <para style="q2" vid="PSA 44:25">na yɛn nipadua aka afam dɔte.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Sɔre bɛboa yɛn;</para>
  <para style="q2" vid="PSA 44:26">wʼadɔe a ɛnsa da no nti, gye yɛn.</para>
  <para style="d" vid="PSA 44:26">Wɔde ma dwonkyerɛfo. Wɔde “lilie” sanku dwontobea na ɛtoe.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">Dwom 45</para>
  <para style="d">Koramma dwom. Ayeforohyia dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>Botae bi a edi mu akanyan me koma</para>
  <para style="q2" vid="PSA 45:1">bere a merebɔ ɔhene mmran no;</para>
  <para style="q2" vid="PSA 45:1">me tɛkrɛma yɛ ɔkyerɛwfo kunini bi kyerɛwdua.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Wudi mu koraa wɔ mmarima mu</para>
  <para style="q2" vid="PSA 45:2">na wɔde adom bi asra wʼano,</para>
  <para style="q2" vid="PSA 45:2">esiane sɛ Onyankopɔn ahyira wo afebɔɔ no nti.<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Fa wʼafoa bɔ wo nkyɛn mu, okokuroko;</para>
  <para style="q2" vid="PSA 45:3">fa anuonyam ne kɛseyɛ fura.<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Fa wo kɛseyɛ mu kɔ wʼanim nkonimdi so</para>
  <para style="q2" vid="PSA 45:4">wɔ nokware, ahobrɛase ne trenee mu;</para>
  <para style="q2" vid="PSA 45:4">ma wo nsa nifa nna wo nnwuma a ɛyɛ nwonwa no adi.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Ma wo bɛmma nnamnam no nhwirew ɔhene atamfo koma mu;</para>
  <para style="q2" vid="PSA 45:5">na ma amanaman nhwe wʼanan ase.<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Ao Onyankopɔn, wʼahengua no bɛtena hɔ daa daa;</para>
  <para style="q2" vid="PSA 45:6">trenee ahempema bɛyɛ wʼahenni no ahempema.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Wodɔ trenee na wukyi bɔne.</para>
  <para style="q2" vid="PSA 45:7">Ɛno nti Onyankopɔn, wo Nyankopɔn de wo asi wo mfɛfo so,</para>
  <para style="q2" vid="PSA 45:7">na ɔde anigye ngo asra wo.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Kurobow, pɛprɛ ne bɛwewonua hua agye wo batakari mu nyinaa;</para>
  <para style="q2" vid="PSA 45:8">sanku so nnwom a efi ahemfi a wɔde asonse asiesie ho mu</para>
  <para style="q2" vid="PSA 45:8">ma wʼani gye.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Ahemfo mmabea ka wo mmea atitiriw ho;</para>
  <para style="q2" vid="PSA 45:9">wo nsa nifa so na ayeforo dehye a ɔhyɛ Ofir sikakɔkɔɔ gyina.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>Ɔbabea tie, dwene ho, na yɛ osetie;</para>
  <para style="q2" vid="PSA 45:10">ma wo werɛ mfi wo nkurɔfo ne wo papa fi.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Wʼahoɔfɛ asɔ ɔhene no ani;</para>
  <para style="q2" vid="PSA 45:11">di no ni, efisɛ ɔno ne wo wura.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Tiro Babea de ayɛyɛde bɛba;</para>
  <para style="q2" vid="PSA 45:12">mmarima adefo bɛdɛfɛdɛfɛ wo.<verse eid="PSA 45:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Ɔhene babea a ɔwɔ ne pia mu no yɛ onuonyamfo</para>
  <para style="q2" vid="PSA 45:13">wɔde sikakɔkɔɔ abobɔ nʼatade yuu mu.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Ɔhyɛ ntade a wɔadi mu adwinni na wɔde no kɔma ɔhene;</para>
  <para style="q2" vid="PSA 45:14">ne mfɛfo mmabun di nʼakyi</para>
  <para style="q2" vid="PSA 45:14">na wɔde wɔn nyinaa brɛ wo.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Wɔde ahosɛpɛw ne anigye kɔ mu;</para>
  <para style="q1" vid="PSA 45:15">wɔhyɛn ɔhempɔn no ahemfi.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Wo mmabarima besi wʼagyanom anan mu</para>
  <para style="q2" vid="PSA 45:16">wobɛyɛ wɔn mmapɔmma wɔ asase no so nyinaa.<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Mɛma wɔakae wo wɔ awo ntoatoaso nyinaa mu;</para>
  <para style="q2" vid="PSA 45:17">ɛno nti amanaman bɛkamfo wo daa nyinaa.</para>
  <para style="d" vid="PSA 45:17">Wɔde ma dwonkyerɛfo.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">Dwom 46</para>
  <para style="d">Koramma dwom. Wɔto no “alamot” sanku nne so.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>Onyankopɔn ne yɛn guankɔbea ne yɛn ahoɔden,</para>
  <para style="q2" vid="PSA 46:1">amanehunu mu boafo a ɔwɔ hɔ bere biara.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Enti sɛ asase ani dan butuw,</para>
  <para style="q2" vid="PSA 46:2">na mmepɔw tutu kogu po ase a, yɛrensuro,<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>sɛ po bɔ asorɔkye na ehuru</para>
  <para style="q2" vid="PSA 46:3">na ɛma nkoko wosow mpo a, yɛrensuro.<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Asuten bi wɔ hɔ a</para>
  <para style="q2" vid="PSA 46:4">ne nsuwansuwa de anigye ba Onyankopɔn kuropɔn mu,</para>
  <para style="q2" vid="PSA 46:4">beae kronkron a Ɔsorosoroni no te.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Onyankopɔn te kuropɔn no mu, na ɔrenhwe ase;</para>
  <para style="q2" vid="PSA 46:5">Onyankopɔn bɛboa no anɔpahema.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Amanaman yɛ hoo, na ahenni hwehwe ase;</para>
  <para style="q2" vid="PSA 46:6">ɔma ne nne so ma asase nan.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>Asafo <char style="nd">Awurade</char> ka yɛn ho.</para>
  <para style="q2" vid="PSA 46:7">Yakob Nyankopɔn yɛ yɛn aban.<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Bra bɛhwɛ <char style="nd">Awurade</char> nnwuma,</para>
  <para style="q2" vid="PSA 46:8">ɔsɛe a ɔde aba asase no so.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>Ɔma akodi gyae kosi asase ano.</para>
  <para style="q2" vid="PSA 46:9">Obubu agyan mu na ɔsɛe peaw;</para>
  <para style="q2" vid="PSA 46:9">ɔde ogya hyew nkatabo.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>Monyɛ komm na munhu sɛ me ne Onyankopɔn;</para>
  <para style="q2" vid="PSA 46:10">wɔbɛma me so wɔ amanaman no mu,</para>
  <para style="q2" vid="PSA 46:10">wɔbɛma me so wɔ asase so.<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>Asafo <char style="nd">Awurade</char> ka yɛn ho;</para>
  <para style="q2" vid="PSA 46:11">Yakob Nyankopɔn yɛ yɛn aban.</para>
  <para style="d" vid="PSA 46:11">Wɔde ma dwonkyerɛfo.<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">Dwom 47</para>
  <para style="d">Koramma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>Amanaman nyinaa, mommɔ mo nsam;</para>
  <para style="q2" vid="PSA 47:1">momfa anigye nteɛ mu mfrɛ Onyankopɔn.<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>
    <char style="nd">Awurade</char> Ɔsorosoroni no ho yɛ nwonwa,</para>
  <para style="q2" vid="PSA 47:2">Ɔyɛ Ɔhene kɛse wɔ asase nyinaa so!<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Ɔde amanaman hyɛɛ yɛn ase,</para>
  <para style="q2" vid="PSA 47:3">na ɔde nnipa hyɛɛ yɛn anan ase.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>Oyii yɛn agyapade maa yɛn,</para>
  <para style="q2" vid="PSA 47:4">nea ɛyɛ Yakob a ɔdɔ no no ahohoahoade.<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Onyankopɔn aforo kɔ soro wɔ anigye nteɛteɛmu mu,</para>
  <para style="q2" vid="PSA 47:5">
    <char style="nd">Awurade</char> wɔ torobɛnto nnyigyei mu.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>To ayeyi nnwom ma Onyankopɔn, to ayeyi nnwom;</para>
  <para style="q2" vid="PSA 47:6">to ayeyi nnwom ma yɛn Hene, to ayeyi nnwom.<verse eid="PSA 47:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Efisɛ Onyankopɔn yɛ asase nyinaa so Hene.</para>
  <para style="q2" vid="PSA 47:7">Monto ahurusi nnwom mma no.<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Onyankopɔn di hene wɔ amanaman no so;</para>
  <para style="q2" vid="PSA 47:8">Onyankopɔn te nʼahengua kronkron so.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Amanaman no mu akunini boaboa wɔn ho ano</para>
  <para style="q2" vid="PSA 47:9">sɛ Abraham Nyankopɔn nkurɔfo,</para>
  <para style="q1" vid="PSA 47:9">efisɛ asase so ahemfo yɛ Onyankopɔn de;</para>
  <para style="q2" vid="PSA 47:9">na wɔma no so kɛse.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">Dwom 48</para>
  <para style="d">Koramma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>
    <char style="nd">Awurade</char> yɛ ɔkɛse na ɔsɛ nkamfo,</para>
  <para style="q2" vid="PSA 48:1">wɔ yɛn Nyankopɔn kuropɔn mu, ne bepɔw kronkron so.<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Ne sorokɔ ma ɛyɛ fɛ,</para>
  <para style="q2" vid="PSA 48:2">ɛyɛ wiase nyinaa anigyede.</para>
  <para style="q1" vid="PSA 48:2">Bepɔw Sion te sɛ Safon sorɔnsorɔmmea,</para>
  <para style="q2" vid="PSA 48:2">Ɔhenkɛse no kuropɔn.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Onyankopɔn te nʼabankɛse mu</para>
  <para style="q2" vid="PSA 48:3">wada ne ho adi sɛ ɔyɛ nʼabandennen.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Bere a ahemfo yi boaa wɔn ho ano,</para>
  <para style="q2" vid="PSA 48:4">na wotuu ɔsa bɔɔ mu no,<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>wohuu no ma ɛyɛɛ wɔn ahodwiriw,</para>
  <para style="q2" vid="PSA 48:5">na wɔde ehu guanee.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Wɔbɔɔ huboa wɔ hɔ,</para>
  <para style="q2" vid="PSA 48:6">ɔyaw a ɛte sɛ ɔbea a awo aka no.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Wosɛe wɔn sɛ Tarsis ahyɛn a</para>
  <para style="q2" vid="PSA 48:7">apuei mframa abɔ adwira wɔn.<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Sɛnea yɛate no,</para>
  <para style="q2" vid="PSA 48:8">saa ara na yɛahu</para>
  <para style="q1" vid="PSA 48:8">wɔ Asafo <char style="nd">Awurade</char> kuropɔn no mu,</para>
  <para style="q2" vid="PSA 48:8">yɛn Nyankopɔn kuropɔn mu;</para>
  <para style="q2" vid="PSA 48:8">Onyankopɔn ma etim hɔ afebɔɔ.<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Wʼasɔredan no mu; Ao, Onyankopɔn,</para>
  <para style="q2" vid="PSA 48:9">na yɛdwene wo dɔ a enni huammɔ da no ho,<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>Ao, Onyankopɔn, wʼayeyi du asase ano</para>
  <para style="q2" vid="PSA 48:10">te sɛ wo din te;</para>
  <para style="q2" vid="PSA 48:10">trenee ayɛ wo nsa nifa mu ma.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Sion bepɔw di ahurusi,</para>
  <para style="q2" vid="PSA 48:11">Yuda nkuraase no ani gye</para>
  <para style="q1" vid="PSA 48:11">esiane wʼatemmu no nti.<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Nantew Sion na twa ho hyia,</para>
  <para style="q2" vid="PSA 48:12">kan nʼabantenten dodow,<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>dwene nʼafasu ho yiye,</para>
  <para style="q2" vid="PSA 48:13">hwɛ nʼabankɛse no,</para>
  <para style="q2" vid="PSA 48:13">na woaka ho asɛm akyerɛ nkyirimma.<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Saa Onyankopɔn yi yɛ yɛn Nyankopɔn daa daa;</para>
  <para style="q2" vid="PSA 48:14">ɔbɛyɛ yɛn kwankyerɛfo akosi awiei mpo.</para>
  <para style="d" vid="PSA 48:14">Wɔde ma dwonkyerɛfo.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">Dwom 49</para>
  <para style="d">Koramma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>Muntie, mo saa nnipa yi nyinaa;</para>
  <para style="q2" vid="PSA 49:1">monyɛ aso, mo a mowɔ wiase yi mu nyinaa,<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>nea ɔyɛ abomfiaa ne nea odi mu,</para>
  <para style="q2" vid="PSA 49:2">adefo ne ahiafo nyinaa.<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Mʼano bɛka anyansasɛm;</para>
  <para style="q2" vid="PSA 49:3">nsɛm a efi me koma mu bɛma nhumu.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Mɛbrɛ mʼaso ase atie mmebusɛm;</para>
  <para style="q2" vid="PSA 49:4">na sanku na mede bɛkyerɛ mʼabisae ase.<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Adɛn nti na ɛsɛ sɛ misuro, bere a nna bɔne aba,</para>
  <para style="q2" vid="PSA 49:5">bere a amumɔyɛfo nnaadaafo atwa me ho ahyia,<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>wɔn a wɔde wɔn ho to wɔn ahonya so</para>
  <para style="q2" vid="PSA 49:6">na wɔde wɔn ade dodow hoahoa wɔn ho?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Onipa biara rentumi nnye ne yɔnko nkwa</para>
  <para style="q2" vid="PSA 49:7">na ɔrentumi mfa mpata biara mma Onyankopɔn,<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>nkwa ho mpata bo yɛ den,</para>
  <para style="q2" vid="PSA 49:8">akatua biara renso,<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>sɛ ɛbɛma no atena ase afebɔɔ</para>
  <para style="q2" vid="PSA 49:9">a ɔrenhu porɔwee.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Obiara nim pefee sɛ anyansafo wu;</para>
  <para style="q2" vid="PSA 49:10">saa ara na nkwaseafo ne agyimifo nso wu,</para>
  <para style="q2" vid="PSA 49:10">na wogyaw wɔn ahonya hɔ ma afoforo.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Wɔn nna bɛyɛ wɔn afi afebɔɔ,</para>
  <para style="q2" vid="PSA 49:11">wɔn atenae wɔ awo ntoatoaso bere a enni awiei mu,</para>
  <para style="q2" vid="PSA 49:11">ɛmfa ho sɛ wɔde wɔn din atoto nsase so.<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Na onipa ahonya nyinaa akyi no, ɔrentena hɔ daa;</para>
  <para style="q2" vid="PSA 49:12">ɔte sɛ mmoa a wowu no ara.<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Eyi ne nea ɛda hɔ ma wɔn a wogye wɔn ho di,</para>
  <para style="q2" vid="PSA 49:13">ne wɔn akyidifo a wɔfoa wɔn nsɛm so.<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Wɔte sɛ nguan, na wɔbɛkɔ ɔda mu,</para>
  <para style="q2" vid="PSA 49:14">na owu de wɔn bɛyɛ nʼaduan.</para>
  <para style="q1" vid="PSA 49:14">Atreneefo bedi wɔn so anɔpa;</para>
  <para style="q2" vid="PSA 49:14">wɔn nipadua bɛporɔw wɔ ɔda mu,</para>
  <para style="q2" vid="PSA 49:14">na wɔne wɔn adan akɛse no ntam akwan bɛware.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Nanso Onyankopɔn begye me afi ɔda mu;</para>
  <para style="q2" vid="PSA 49:15">ampa ara, ɔde me bɛkɔ ne nkyɛn.<verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Sɛ onipa nya ne ho a, mma ɛnnhaw wo;</para>
  <para style="q2" vid="PSA 49:16">na sɛ ne fi anigye yɛ bebree a, mma ɛnnhaw wo;<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>efisɛ, sɛ owu a ɔremmfa hwee nkɔ,</para>
  <para style="q2" vid="PSA 49:17">nʼanuonyam ne no renkɔ amoa mu.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>Mpo ɔte ase no, ɔfaa no sɛ wɔahyira no,</para>
  <para style="q2" vid="PSA 49:18">efisɛ wɔkamfo nnipa bere a wodi yiye,<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>nanso ɔbɛkɔ akɔka nʼagyanom ho,</para>
  <para style="q2" vid="PSA 49:19">wɔn a wɔrenhu nkwa hann ara da no.<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Onipa a ɔwɔ ahonya na onni nhumu no</para>
  <para style="q2" vid="PSA 49:20">te sɛ mmoa a wowu.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">Dwom 50</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>Tweduampɔn, Onyankopɔn, <char style="nd">Awurade</char> no kasa,</para>
  <para style="q2" vid="PSA 50:1">na ɔfrɛ asase nyinaa</para>
  <para style="q2" vid="PSA 50:1">efi apuei kosi atɔe.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Onyankopɔn hyerɛn fi Sion</para>
  <para style="q2" vid="PSA 50:2">kurow a ne fɛ wie pɛyɛ.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Yɛn Nyankopɔn reba nanso ɔrenyɛ komm;</para>
  <para style="q2" vid="PSA 50:3">ogya a ɛhyew nneɛma di nʼanim,</para>
  <para style="q2" vid="PSA 50:3">ahum a ɛretu atwa ne ho ahyia.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Ɔfrɛ ɔsorosoro ne asase,</para>
  <para style="q2" vid="PSA 50:4">sɛ ɔrebu ne nkurɔfo atɛn;<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>Ɔka se, “Boaboa nnipa a wɔatew wɔn ho no ano ma me;</para>
  <para style="q2" vid="PSA 50:5">wɔn a wɔnam afɔrebɔ so ne me yɛɛ apam no.”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Ɔsoro pae mu ka ne trenee,</para>
  <para style="q2" vid="PSA 50:6">na Onyankopɔn ankasa ne otemmufo.<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“Muntie, me nkurɔfo, na mɛkasa,</para>
  <para style="q2" vid="PSA 50:7">medi adanse atia wo, Israel;</para>
  <para style="q2" vid="PSA 50:7">Mene Onyankopɔn, wo Nyankopɔn no.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Merenka mo anim wɔ mo afɔrebɔde</para>
  <para style="q2" vid="PSA 50:8">anaa mo hyew afɔre a ɛwɔ mʼanim daa no ho.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Anantwinini a wofi mo mfuw so</para>
  <para style="q2" vid="PSA 50:9">anaa mpapo a wofi mo buw mu ho nhia me,<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>efisɛ kwae mu aboa biara yɛ me de,</para>
  <para style="q2" vid="PSA 50:10">anantwi a wɔwɔ nkoko mpempem so nso saa ara.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Minim anomaa biara a ɔwɔ mmepɔw no so,</para>
  <para style="q2" vid="PSA 50:11">na wuram abɔde nyinaa yɛ me de.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Sɛ ɔkɔm dee me a, anka merenka nkyerɛ mo;</para>
  <para style="q2" vid="PSA 50:12">efisɛ, wiase ne nea ɛwɔ mu nyinaa yɛ me de.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Mewe anantwinini nam,</para>
  <para style="q2" vid="PSA 50:13">na menom mpapo mogya ana?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>Momfa aseda afɔre mma Onyankopɔn,</para>
  <para style="q2" vid="PSA 50:14">na munni bɔ a mohyɛɛ Ɔsorosoroni no so,<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>na momfrɛ me hiada;</para>
  <para style="q2" vid="PSA 50:15">na megye mo na moahyɛ me anuonyam.”<verse eid="PSA 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>Nanso amumɔyɛfo de, Onyankopɔn bisa wɔn se,</para>
  <para style="q1" vid="PSA 50:16">“Adɛn nti na moka me mmara</para>
  <para style="q2" vid="PSA 50:16">na mʼapam da mo ano?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Mukyi me nkyerɛkyerɛ,</para>
  <para style="q2" vid="PSA 50:17">na motow me nsɛm gu mo akyi.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Sɛ muhu ɔkorɔmfo a mode mo ho bɔ no;</para>
  <para style="q2" vid="PSA 50:18">na mo ne nguaman nso bɔ.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Mode mo ano yɛ bɔne,</para>
  <para style="q2" vid="PSA 50:19">na mode mo tɛkrɛma boaboa nnaadaa ano.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Mokasa tia mo nuabarima bere biara</para>
  <para style="q2" vid="PSA 50:20">na mosopa mo ankasa na ba.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Moayɛ eyinom nyinaa; nanso manka hwee,</para>
  <para style="q2" vid="PSA 50:21">enti mususuw sɛ mete sɛ mo.</para>
  <para style="q1" vid="PSA 50:21">Nanso mɛka mo anim,</para>
  <para style="q2" vid="PSA 50:21">na mede mo sobo asi mo anim.<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“Munnwen eyi ho, mo a mo werɛ fi Onyankopɔn,</para>
  <para style="q2" vid="PSA 50:22">anyɛ saa a, mɛtetew mo mu nketenkete a obiara remmegye mo;<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Nea ɔbɔ aseda afɔre no hyɛ me anuonyam,</para>
  <para style="q2" vid="PSA 50:23">na osiesie kwan</para>
  <para style="q2" vid="PSA 50:23">sɛnea mɛda Onyankopɔn nkwagye adi akyerɛ no.”</para>
  <para style="d" vid="PSA 50:23">Wɔde ma dwonkyerɛfo.<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">Dwom 51</para>
  <para style="d">Dawid dwom a ɔtoo no bere a ɔde ne ho kaa Batseba na odiyifo Natan kɔɔ ne nkyɛn no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>Ao, Onyankopɔn hu me mmɔbɔ,</para>
  <para style="q2" vid="PSA 51:1">sɛnea wʼadɔe a ɛnsa da no te;</para>
  <para style="q1" vid="PSA 51:1">wʼahummɔbɔ kɛse no nti,</para>
  <para style="q2" vid="PSA 51:1">pepa me mmarato.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Hohoro mʼamumɔyɛ nyinaa</para>
  <para style="q2" vid="PSA 51:2">na tew me ho fi me bɔne mu!<verse eid="PSA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Na mahu me mmarato,</para>
  <para style="q2" vid="PSA 51:3">na mekae me bɔne daa.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Mayɛ mfomso atia wo; atia wo nko ara</para>
  <para style="q2" vid="PSA 51:4">na mayɛ nea ɛyɛ bɔne wɔ wʼani so,</para>
  <para style="q1" vid="PSA 51:4">enti wudi bem wɔ wʼatemmu mu</para>
  <para style="q2" vid="PSA 51:4">na woteɛ wɔ wʼatemmu mu.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Ampa ara wɔwoo me wɔ bɔne mu,</para>
  <para style="q2" vid="PSA 51:5">na bɔne mu na me na nyinsɛn me.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Ampa ara nokware na wohwehwɛ wɔ me mu.</para>
  <para style="q2" vid="PSA 51:6">Wokyerɛ me nyansa a mu dɔ.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Fa adwerɛ hohoro me ho, na me ho afi;</para>
  <para style="q2" vid="PSA 51:7">guare me, na mɛhoa asen sukyerɛmma.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Ma mente ahosɛpɛw ne anigye nka;</para>
  <para style="q2" vid="PSA 51:8">na ma nnompe a woabubu no nni ahurusi.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Kata wʼani wɔ me bɔne ho</para>
  <para style="q2" vid="PSA 51:9">na pepa mʼamumɔyɛ nyinaa.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Ao, Onyankopɔn, bɔ koma a mu tew wɔ me mu,</para>
  <para style="q2" vid="PSA 51:10">na yɛ honhom a atim no foforo wɔ me mu.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Mpam me mfi wʼanim,</para>
  <para style="q2" vid="PSA 51:11">na nyi wo Honhom Kronkron mfi me mu.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Fa wo nkwagye mu anigye no ma me bio,</para>
  <para style="q2" vid="PSA 51:12">na ma me ɔpɛ honhom a ɛbɛma magyina.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Afei mɛkyerɛ nnebɔneyɛfo wʼakwan,</para>
  <para style="q2" vid="PSA 51:13">na amumɔyɛfo bɛsan aba wo nkyɛn.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Ao, Onyankopɔn, gye me fi mogya ho afɔdi mu.</para>
  <para style="q2" vid="PSA 51:14">Onyame a wugye me nkwa,</para>
  <para style="q2" vid="PSA 51:14">na me tɛkrɛma bɛto wo trenee ho dwom.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>Awurade, bue mʼano fafa,</para>
  <para style="q2" vid="PSA 51:15">na mede mʼano bɛpae mu aka wʼayeyi.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Wompɛ afɔrebɔ, anka mɛbɔ;</para>
  <para style="q2" vid="PSA 51:16">wʼani nnye ɔhyew afɔre ho.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Onyankopɔn afɔre yɛ honhom a abotow,</para>
  <para style="q2" vid="PSA 51:17">Onyankopɔn,</para>
  <para style="q2" vid="PSA 51:17">worempo ahonu ne ahobrɛase koma.<verse eid="PSA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Ma ɛnyɛ wo fɛ sɛ wobɛma Sion anya nkɔso wɔ wʼanigye mu;</para>
  <para style="q2" vid="PSA 51:18">na woasi Yerusalem afasu.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Afei wʼani begye ɔtreneeni afɔrebɔ ho,</para>
  <para style="q2" vid="PSA 51:19">ɔhyew afɔre a edi mu;</para>
  <para style="q2" vid="PSA 51:19">na wɔde anantwinini bɛbɔ afɔre wʼafɔremuka so.</para>
  <para style="d" vid="PSA 51:19">Wɔde ma dwonkyerɛfo.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">Dwom 52</para>
  <para style="d">Dawid “maskil” dwom. Ɔtoo bere a Edomni Doeg bɛka kyerɛɛ Saulo se, “Dawid akɔ Ahimelek fi” no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>Ɔkɛse, adɛn nti na wohoahoa wo ho wɔ wo bɔne ho?</para>
  <para style="q2" vid="PSA 52:1">Adɛn nti na wohoahoa wo ho da mu nyinaa,</para>
  <para style="q2" vid="PSA 52:1">wo a woyɛ animguasede wɔ Onyankopɔn ani so?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Wo tɛkrɛma bɔ ɔsɛe ho pɔw;</para>
  <para style="q2" vid="PSA 52:2">ɛte sɛ oyiwan a ano yɛ nam yiye.</para>
  <para style="q1" vid="PSA 52:2">Wo a wutwa nkontompo nko ara.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Wʼani gye bɔne ho sen papa,</para>
  <para style="q2" vid="PSA 52:3">wopɛ atoro sen sɛ wobɛka nokware.<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Wodɔ asɛm biara a ɛde ɔhaw ba,</para>
  <para style="q2" vid="PSA 52:4">wo tɛkrɛma daadaafo!<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Ampa ara Onyankopɔn de ɔsɛe a enni awiei bɛbrɛ wo;</para>
  <para style="q2" vid="PSA 52:5">ɔbɛtwe wo afi wo ntamadan mu na watetew wo mu;</para>
  <para style="q2" vid="PSA 52:5">Ɔbɛtɔre wʼase wɔ ateasefo asase so.<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Atreneefo behu eyi na wɔasuro;</para>
  <para style="q2" vid="PSA 52:6">wɔbɛserew no na wɔaka se,<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Hwɛ, onipa no ni,</para>
  <para style="q2" vid="PSA 52:7">nea wamfa Onyankopɔn anyɛ nʼabandennen</para>
  <para style="q1" vid="PSA 52:7">na mmom ɔde ne ho too nʼahonya dodow so,</para>
  <para style="q2" vid="PSA 52:7">na onyaa ahoɔden de sɛee afoforo no!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Nanso mete sɛ ngodua a</para>
  <para style="q2" vid="PSA 52:8">ɛrenyin wɔ Onyankopɔn fi:</para>
  <para style="q1" vid="PSA 52:8">mede me ho to Onyankopɔn dɔ a ɛnsa da no so</para>
  <para style="q2" vid="PSA 52:8">daa nyinaa.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Meyi wo ayɛ daa wɔ nea woayɛ nti;</para>
  <para style="q2" vid="PSA 52:9">wo din so na mʼani bɛda, efisɛ eye.</para>
  <para style="q2" vid="PSA 52:9">Meyi wo ayɛ wɔ wʼahotefo anim.</para>
  <para style="d" vid="PSA 52:9">Wɔde ma dwonkyerɛfo. Wɔde “mahalat” sanku nne na ɛto.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">Dwom 53</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>Ɔkwasea ka wɔ ne koma mu se,</para>
  <para style="q2" vid="PSA 53:1">“Onyankopɔn bi nni hɔ.”</para>
  <para style="q1" vid="PSA 53:1">Porɔwee adi wɔn, na wɔn akwan yɛ animguase.</para>
  <para style="q2" vid="PSA 53:1">Obiara nni hɔ a ɔyɛ ade pa.<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Onyankopɔn fi ɔsoro hwɛ adesamma wɔ fam</para>
  <para style="q2" vid="PSA 53:2">sɛ obehu wɔn mu bi a</para>
  <para style="q1" vid="PSA 53:2">wɔwɔ ntease,</para>
  <para style="q2" vid="PSA 53:2">anaa ebinom a wɔhwehwɛ Onyankopɔn.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Nanso nnipa nyinaa atwe wɔn ho afi Onyankopɔn ho;</para>
  <para style="q2" vid="PSA 53:3">wɔn nyinaa ayɛ bɔne.</para>
  <para style="q1" vid="PSA 53:3">Obiara nni hɔ a ɔyɛ papa.</para>
  <para style="q2" vid="PSA 53:3">Ɔbaako mpo nni hɔ.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Enti abɔnefo rensua nyansa ana?</para>
  <para style="q2" vid="PSA 53:4">Wɔwe me nkurɔfo sɛnea nnipa di aduan.</para>
  <para style="q2" vid="PSA 53:4">Wonnsu mfrɛ Onyankopɔn.<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>Wɔn na wɔwɔ hɔ a wɔabɔ huboa</para>
  <para style="q2" vid="PSA 53:5">wɔ faako a ehu nni.</para>
  <para style="q1" vid="PSA 53:5">Onyankopɔn hwetee wɔn a wɔtow hyɛɛ wo so no nnompe mu;</para>
  <para style="q2" vid="PSA 53:5">wuguu wɔn anim ase, efisɛ Onyankopɔn buu wɔn animtiaa.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>Ao, Israel nkwagye mfi Sion mmra!</para>
  <para style="q2" vid="PSA 53:6">
    <char style="nd">Awurade</char> bɛsan de ne nkurɔfo agyapade ama wɔn.</para>
  <para style="q2" vid="PSA 53:6">Na Yakob adi ahurusi, na Israel ani agye!</para>
  <para style="d" vid="PSA 53:6">Wɔde ma dwonkyerɛfo. Wɔbɔ no sanku so.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">Dwom 54</para>
  <para style="d">Dawid “maskil” dwom. Ɔtoo no bere a Sififo kɔka kyerɛɛ Saulo se, “Dawid abehintaw wɔ yɛn mu.”</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>Ao, Onyankopɔn, gye me wɔ wo din mu;</para>
  <para style="q2" vid="PSA 54:1">fa wo tumi bu me bem.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>Ao, Onyankopɔn, tie me mpaebɔ;</para>
  <para style="q2" vid="PSA 54:2">tie mʼanom nsɛm.<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Ahɔho retow ahyɛ me so.</para>
  <para style="q2" vid="PSA 54:3">Atirimɔdenfo rehwehwɛ me akum me;</para>
  <para style="q2" vid="PSA 54:3">nnipa a wɔmmfa Onyankopɔn nyɛ hwee.<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Ampa ara, Onyankopɔn ne me boafo;</para>
  <para style="q2" vid="PSA 54:4">Awurade ne me hwɛfo.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Ma mmusu nkyim mmra wɔn a wodi me ho nseku no so;</para>
  <para style="q2" vid="PSA 54:5">wo nokwaredi mu, sɛe wɔn.<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Mefi me pɛ mu abɔ afɔre ama wo;</para>
  <para style="q2" vid="PSA 54:6">
    <char style="nd">Awurade</char>, meyi wo din ayɛ,</para>
  <para style="q2" vid="PSA 54:6">efisɛ eye.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Woagye me afi me haw nyinaa mu,</para>
  <para style="q2" vid="PSA 54:7">na mʼani ahu nkonimdi wɔ mʼatamfo so.</para>
  <para style="d" vid="PSA 54:7">Wɔde ma dwonkyerɛfo. Wɔde sanku na ɛto.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">Dwom 55</para>
  <para style="d">Dawid “maskil” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>Ao Onyankopɔn, tie me mpaebɔ,</para>
  <para style="q2" vid="PSA 55:1">mmu wʼani ngu me nkotosrɛ so,<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>tie me na gye me so.</para>
  <para style="q2" vid="PSA 55:2">Me dadwen haw me na ama mayɛ basaa,<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>esiane nea me tamfo reka,</para>
  <para style="q2" vid="PSA 55:3">esiane omumɔyɛfo ahunahuna nti;</para>
  <para style="q1" vid="PSA 55:3">efisɛ wɔde amanehunu ba me so;</para>
  <para style="q2" vid="PSA 55:3">na wofi wɔn abufuw mu kum me.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>Me koma wɔ ahoyeraw mu;</para>
  <para style="q2" vid="PSA 55:4">na owu huboa aba me so.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Ehu ne ahopopo akyekyere me.</para>
  <para style="q2" vid="PSA 55:5">Ahodwiriw abu afa me so.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Mekae se, “Ao, sɛ mewɔ ntaban sɛ aburuburu a,</para>
  <para style="q2" vid="PSA 55:6">anka metu akɔ ama me ho atɔ me,<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>anka metu akɔ akyirikyiri</para>
  <para style="q2" vid="PSA 55:7">akɔtena sare so;<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>anka mɛyɛ ntɛm akɔ me hintabea,</para>
  <para style="q2" vid="PSA 55:8">faako a mframahweam ne ahum mmɛn koraa.”<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Awurade, ma amumɔyɛfo nyɛ basaa, na ma wɔn kasa ntoto,</para>
  <para style="q2" vid="PSA 55:9">efisɛ mihu basabasayɛ ne aperepere wɔ kuropɔn no mu.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Awia ne anadwo wɔtetɛw nʼafasu ho;</para>
  <para style="q2" vid="PSA 55:10">adwemmɔne ne asisi wɔ mu.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Adesɛefo dɔm reyɛ adwuma wɔ kuropɔn no mu.</para>
  <para style="q2" vid="PSA 55:11">Ahunahuna ne nnaadaa wɔ ne mmɔnten so daa.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Sɛ ɛyɛɛ ɔtamfo na ɔresopa me a,</para>
  <para style="q2" vid="PSA 55:12">anka metumi agyina ano;</para>
  <para style="q2" vid="PSA 55:12">sɛ ɛyɛɛ ɔtamfo na ɔrema ne ho so atia me a,</para>
  <para style="q2" vid="PSA 55:12">anka metumi de me ho ahintaw no.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>Nanso ɛyɛ wo, ɔdesani te sɛ me,</para>
  <para style="q1" vid="PSA 55:13">me yɔnko, mʼadamfo kann,<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>a kan no na me ne no wɔ ayɔnkofa a mu yɛ den</para>
  <para style="q2" vid="PSA 55:14">bere a yɛn nyinaa bɔɔ mu yuu kɔɔ Onyankopɔn fi na yɛka asomfo no ho no.<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Ma owu mmɛfa mʼatamfo mpofirim;</para>
  <para style="q2" vid="PSA 55:15">ma wɔnkɔ ɔda mu anikann,</para>
  <para style="q2" vid="PSA 55:15">efisɛ bɔne te wɔn mu.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Nanso misu frɛ Onyankopɔn,</para>
  <para style="q2" vid="PSA 55:16">na <char style="nd">Awurade</char> gye me nkwa.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Anwummere, anɔpa ne awia,</para>
  <para style="q2" vid="PSA 55:17">mede mmɔborɔnne su frɛ no,</para>
  <para style="q2" vid="PSA 55:17">na ɔte me nne.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Ɔde ne ho bɔ afɔre ma minya me ti didi mu</para>
  <para style="q2" vid="PSA 55:18">wɔ ako a wodi tia me no mu,</para>
  <para style="q2" vid="PSA 55:18">mpo dodow na wɔsɔre tia me.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Onyankopɔn a wɔasi no hene afebɔɔ no,</para>
  <para style="q2" vid="PSA 55:19">ɔbɛte wɔn nka na wahaw wɔn,</para>
  <para style="q1" vid="PSA 55:19">ɔbɛhaw nnipa a wɔnsakra wɔn akwan da</para>
  <para style="q2" vid="PSA 55:19">na wonsuro Onyankopɔn nso.<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Me yɔnko tow hyɛ ne nnamfonom so;</para>
  <para style="q2" vid="PSA 55:20">na obu nʼapam so.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Ɔwɔ tɛkrɛmawo,</para>
  <para style="q2" vid="PSA 55:21">nanso ɔtan wɔ ne koma mu.</para>
  <para style="q1" vid="PSA 55:21">Nʼano asɛm dwudwo sen ngo,</para>
  <para style="q2" vid="PSA 55:21">nanso ɛyɛ afoa a wɔatwe.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Fa wo haw to <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 55:22">na ɔno na obegye wo;</para>
  <para style="q2" vid="PSA 55:22">ɔremma ɔtreneeni nhwe ase.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>Nanso wo, Onyankopɔn, wobɛbrɛ amumɔyɛfo ase</para>
  <para style="q2" vid="PSA 55:23">ama wɔakɔ ɔporɔw amoa mu;</para>
  <para style="q1" vid="PSA 55:23">mogyapɛfo ne nnaadaafo</para>
  <para style="q2" vid="PSA 55:23">renni wɔn nkwanna mu fa.</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">Nanso me de, mede me ho to wo so.</para>
  <para style="d" vid="PSA 55:23">Wɔde ma dwonkyerɛfo. Wɔto no sɛnea wɔto “Aburuburu a osi Akyirikyiri Odum so,” nne so.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">Dwom 56</para>
  <para style="d">Dawid dwom a ɔtoo bere a Filistifo kyeree no wɔ Gat no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>Onyankopɔn, hu me mmɔbɔ na nnipa taa me anibere so;</para>
  <para style="q2" vid="PSA 56:1">da mu nyinaa womia wɔn taa no mu.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Wɔn a wɔbɔ me ahohora taa me da mu nyinaa;</para>
  <para style="q2" vid="PSA 56:2">wɔn a wɔma wɔn ho so tia me no dɔɔso.<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Sɛ mebɔ hu a,</para>
  <para style="q2" vid="PSA 56:3">mede me ho bɛto wo so.<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>Onyankopɔn a mekamfo nʼasɛm no,</para>
  <para style="q2" vid="PSA 56:4">mede me ho to Onyankopɔn so, na merensuro.</para>
  <para style="q2" vid="PSA 56:4">Dɛn na onipa desani betumi ayɛ me?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Da mu nyinaa wogye mʼano si bɔne;</para>
  <para style="q2" vid="PSA 56:5">bere biara wɔbɔ pɔw sɛ wɔbɛsɛe me.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Wɔbɔ pɔw, wɔtetɛw,</para>
  <para style="q2" vid="PSA 56:6">wɔhwɛ mʼanammɔntu,</para>
  <para style="q2" vid="PSA 56:6">susuw sɛ wobekum me.<verse eid="PSA 56:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Wɔn amumɔyɛ nti mma wɔmmfa wɔn ho nni;</para>
  <para style="q2" vid="PSA 56:7">Onyankopɔn, brɛ amanaman no ase wɔ wʼabufuw mu.<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Kyerɛw me kwadwom to hɔ;</para>
  <para style="q2" vid="PSA 56:8">sese me nusu wɔ wo nhoma mmobɔwee no mu.</para>
  <para style="q2" vid="PSA 56:8">Enni nea woakyerɛw ato hɔ no mu ana?<verse eid="PSA 56:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Sɛ mepɛ mmoa fi wo hɔ a,</para>
  <para style="q2" vid="PSA 56:9">mʼatamfo bɛsan wɔn akyi.</para>
  <para style="q2" vid="PSA 56:9">Eyi bɛma mahu sɛ Onyankopɔn wɔ mʼafa.<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Onyankopɔn a mekamfo nʼasɛm no,</para>
  <para style="q2" vid="PSA 56:10">
    <char style="nd">Awurade</char> a mekamfo nʼasɛm no,<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>mede me ho to Onyankopɔn so; na merensuro.</para>
  <para style="q2" vid="PSA 56:11">Dɛn na ɔdesani betumi ayɛ me?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>Me Onyankopɔn, mehyɛ bɔ a mahyɛ wo no ase,</para>
  <para style="q2" vid="PSA 56:12">mede mʼaseda afɔre bɛbrɛ wo.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>Efisɛ, woagye me afi owu mu,</para>
  <para style="q2" vid="PSA 56:13">na mʼanan anhintiw,</para>
  <para style="q1" vid="PSA 56:13">na matumi anantew Onyankopɔn anim</para>
  <para style="q2" vid="PSA 56:13">wɔ nkwa hann no mu.</para>
  <para style="d" vid="PSA 56:13">Wɔde ma dwonkyerɛfo no. Wɔto no sɛnea wɔto “Mma Wɔnnsɛe No” nne so.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">Dwom 57</para>
  <para style="d">Dawid dwom a ɔtoo bere a oguan fii Saulo nkyɛn kɔɔ ɔbodan no mu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>Hu me mmɔbɔ, me Onyankopɔn, hu me mmɔbɔ,</para>
  <para style="q2" vid="PSA 57:1">na wo mu na me kra nya guankɔbea.</para>
  <para style="q1" vid="PSA 57:1">Wo ntaban nwini ase na mɛpɛ guankɔbea</para>
  <para style="q2" vid="PSA 57:1">kosi sɛ amanehunu no betwa mu.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Misu frɛ Onyankopɔn, Ɔsorosoroni no;</para>
  <para style="q2" vid="PSA 57:2">Onyankopɔn a ɔma ne pɛ ba mu wɔ me ho.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Ɔsoma fi ɔsoro hɔ begye me nkwa,</para>
  <para style="q2" vid="PSA 57:3">ɔka wɔn a wɔtaa me anibere so no anim;</para>
  <para style="q2" vid="PSA 57:3">Onyankopɔn soma ne dɔ ne ne nokware.<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Gyata atwa me ho ahyia;</para>
  <para style="q2" vid="PSA 57:4">meda mmoa a wɔwe nam amono mu,</para>
  <para style="q2" vid="PSA 57:4">nnipa a wɔn se te sɛ mpeaw ne mmɛmma</para>
  <para style="q2" vid="PSA 57:4">na wɔn tɛkrɛma te sɛ afoa a ɛyɛ nnam.<verse eid="PSA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Onyankopɔn, ɛsɛ sɛ wɔma wo so tra ɔsoro,</para>
  <para style="q2" vid="PSA 57:5">na ama wʼanuonyam aba asase nyinaa so.<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Wɔtrɛw asau mu de sum mʼanan afiri,</para>
  <para style="q2" vid="PSA 57:6">ahohiahia brɛɛ me ase.</para>
  <para style="q1" vid="PSA 57:6">Wotuu amoa wɔ me kwan mu,</para>
  <para style="q2" vid="PSA 57:6">nanso wɔn ankasa akɔtotɔ mu.<verse eid="PSA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Ao, Onyankopɔn, me koma agyina pintinn,</para>
  <para style="q2" vid="PSA 57:7">me koma yɛ pintinn;</para>
  <para style="q2" vid="PSA 57:7">mɛto dwom na mayi wo ayɛ.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Me kra nyan!</para>
  <para style="q2" vid="PSA 57:8">Sanku ne bɛnta, munnyan!</para>
  <para style="q2" vid="PSA 57:8">Me nso menyan anɔpahema.<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>
    <char style="nd">Awurade</char>, mɛkamfo wo wɔ aman no mu;</para>
  <para style="q2" vid="PSA 57:9">mɛto wo ho nnwom wɔ nnipa mu.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Wʼadɔe so, ɛkorɔn sen ɔsoro;</para>
  <para style="q2" vid="PSA 57:10">wo nokwaredi du wim.<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Ao, Onyankopɔn, wɔmma wo so mmoro ɔsoro;</para>
  <para style="q2" vid="PSA 57:11">ma wʼanuonyam nkata asase nyinaa so.</para>
  <para style="d" vid="PSA 57:11">Wɔde ma dwonkyerɛfo. Wɔto no sɛnea wɔto “Mma Wɔnnsɛe No” sanku nne so.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">Dwom 58</para>
  <para style="d">Dawid “miktam” dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>So mo asodifo, ampa ara sɛ, moka asɛm a ɛteɛ ana?</para>
  <para style="q2" vid="PSA 58:1">Mubu atɛntrenee wɔ nnipa mu ana?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Dabi da! Modwene ntɛnkyew wɔ mo koma mu</para>
  <para style="q2" vid="PSA 58:2">na mo nsa de akakabensɛm ba asase so.<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Amumɔyɛfo fom kwan fi awo mu;</para>
  <para style="q2" vid="PSA 58:3">wɔyɛ mmaratofo fi awotwaa mu na wodi atoro.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Wɔn ano bɔre te sɛ ɔwɔ de,</para>
  <para style="q2" vid="PSA 58:4">ɛte sɛ ɔprammiri a wawɛn nʼaso,<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>a ɔnte ntafowayifo dwom,</para>
  <para style="q2" vid="PSA 58:5">na ne dwom dɛdɛ no mpo mfa ne ho.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>Ao Onyankopɔn, bubu ɛse a egu wɔn anom,</para>
  <para style="q2" vid="PSA 58:6">
    <char style="nd">Awurade</char>, tutu gyata no sebɔmmɔfo no gu!<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Ma wontwa mu nkɔ sɛ sunsuan;</para>
  <para style="q2" vid="PSA 58:7">sɛ wɔtwe wɔn agyan a, ma wɔn bɛmma no ano nwu.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Ma wɔnyɛ sɛ nwaw horɔdɔhorɔdɔ bi a ɔrenan agu wɔ bere a ɔretene no.</para>
  <para style="q2" vid="PSA 58:8">Ma wɔnyɛ sɛ ɔba a owu wɔ awoe a onhu owia koraa.<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Ansa na mo nkuku bɛte nsɔe ano yaw,</para>
  <para style="q2" vid="PSA 58:9">sɛ ɛyɛ amono anaa awo no, wɔbɛpra amumɔyɛfo akɔ.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Sɛ wɔtɔ were ma atreneefo a wɔn ani begye,</para>
  <para style="q2" vid="PSA 58:10">na wɔbɛhohoro wɔn anan ho wɔ amumɔyɛfo mogya mu.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>Afei nnipa bɛka se, “Ampa ara atreneefo kɔ so nya wɔn akatua;</para>
  <para style="q2" vid="PSA 58:11">na ampa ara Onyankopɔn bi wɔ hɔ a obu wiase atɛn.”</para>
  <para style="d" vid="PSA 58:11">Wɔde ma dwonkyerɛfo.<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">Dwom 59</para>
  <para style="d">Wɔto no sɛnea wɔto “Nsɛe No” sanku nne so. Dawid “miktam” dwom. Ɔtoo no bere a Saulo soma kɔwɛn Dawid fi sɛ wonkokum no no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>Ao, Onyankopɔn, gye me fi mʼatamfo nsam;</para>
  <para style="q2" vid="PSA 59:1">bɔ me ho ban fi wɔn a wɔtaa me no ho.<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Gye me fi amumɔyɛfo nsam.</para>
  <para style="q2" vid="PSA 59:2">Gye me nkwa fi mogyapɛfo nsam.<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Hwɛ sɛnea wɔatɛw rehwehwɛ me akum me!</para>
  <para style="q2" vid="PSA 59:3">Nnipa a wɔn ho yɛ hu bɔ pɔw bɔne tia me</para>
  <para style="q2" vid="PSA 59:3">a emfi me mfomso anaa bɔne bi, <char style="nd">Awurade</char>.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Menyɛɛ mfomso bi, nanso wɔayɛ krado sɛ wɔbɛtow ahyɛ me so.</para>
  <para style="q2" vid="PSA 59:4">Sɔre begye me; hwɛ mʼamanehunu!<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>Wo, <char style="nd">Awurade</char> Nyankopɔn, Israel Nyankopɔn,</para>
  <para style="q2" vid="PSA 59:5">ma wo ho so na twe amanaman no nyinaa aso;</para>
  <para style="q2" vid="PSA 59:5">nhu amumɔyɛfo nkontompofo no mmɔbɔ.<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Wɔsan ba anwummere,</para>
  <para style="q2" vid="PSA 59:6">wɔbobɔ mu sɛ akraman,</para>
  <para style="q2" vid="PSA 59:6">na wokyinkyin kuropɔn no mu.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Hwɛ nea wɔfe fi wɔn anom,</para>
  <para style="q2" vid="PSA 59:7">wɔn anofafa mu nsɛm ano yɛ nnam sɛ mfoa,</para>
  <para style="q2" vid="PSA 59:7">na wosusuw se: “Hena na ɔbɛte yɛn nka?”<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>Nanso wo <char style="nd">Awurade</char>, woserew wɔn;</para>
  <para style="q2" vid="PSA 59:8">wudi saa aman no nyinaa ho fɛw.<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>Wone mʼAhoɔden, mehwɛ wo kwan;</para>
  <para style="q2" vid="PSA 59:9">wo, Onyankopɔn, ne mʼabandennen,<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>me Nyankopɔn a metumi atweri no.</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">Onyankopɔn bedi mʼanim</para>
  <para style="q2" vid="PSA 59:10">na ɔbɛma mahwɛ wɔn a wɔbɔ me ahohora no haw.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Nanso nkum wɔn, Awurade, yɛn nkatabo,</para>
  <para style="q2" vid="PSA 59:11">na me nkurɔfo werɛ amfi wɔn.</para>
  <para style="q1" vid="PSA 59:11">Wo tumi mu no tutu wɔn ase,</para>
  <para style="q2" vid="PSA 59:11">na brɛ wɔn ase.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Bɔne a efi wɔn anom,</para>
  <para style="q2" vid="PSA 59:12">ne wɔn ano nsɛm nti</para>
  <para style="q1" vid="PSA 59:12">ma wɔn ahomaso nkyekyere wɔn.</para>
  <para style="q2" vid="PSA 59:12">Abususɛm a wɔka ne atoro a wotwa nti,<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>sɛe wɔn wɔ abufuwhyew mu,</para>
  <para style="q2" vid="PSA 59:13">kosi sɛ wɔn ase bɛtɔre.</para>
  <para style="q1" vid="PSA 59:13">Afei ɛbɛma asase so mmaa nyinaa ahu</para>
  <para style="q2" vid="PSA 59:13">sɛ Onyankopɔn di Yakob so.<verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Wɔsan ba anwummere,</para>
  <para style="q2" vid="PSA 59:14">wɔbobɔ mu sɛ akraman,</para>
  <para style="q2" vid="PSA 59:14">na wokyinkyin kuropɔn no mu.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Wokyinkyin pɛ aduan</para>
  <para style="q2" vid="PSA 59:15">na sɛ wɔammee a, wosu bobɔ mu.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Nanso mɛto wʼahoɔden ho dwom,</para>
  <para style="q2" vid="PSA 59:16">mɛto wʼadɔe ho dwom anɔpa;</para>
  <para style="q1" vid="PSA 59:16">efisɛ woyɛ mʼabandennen,</para>
  <para style="q2" vid="PSA 59:16">me guankɔbea wɔ ahohia mmere mu.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>Ao mʼAhoɔden, mɛto ayeyi dwom ama wo;</para>
  <para style="q2" vid="PSA 59:17">wo, Onyankopɔn, ne mʼabandennen, me Nyankopɔn a ɔyɛ ɔdɔ.</para>
  <para style="d" vid="PSA 59:17">Wɔde ma dwonkyerɛfo. Wɔto no sɛnea wɔto “Susan Edut.”<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">Dwom 60</para>
  <para style="d">Dawid “Miktam” dwom. Wɔde yɛ nkyerɛkyerɛ. Ɔtoo no bere a ɔne Aram Naharanfo ne Aram Zobafo koe na Yoab san kokum Edomfo mpem dumien wɔ Nkyene Bon mu no.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>Onyankopɔn, woapo yɛn, woabɔ yɛn agu;</para>
  <para style="q2" vid="PSA 60:1">wo bo afuw yɛn, nanso gye yɛn bio!<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Woawosow asase no na woapae mu;</para>
  <para style="q2" vid="PSA 60:2">toatoa nea abubu no, efisɛ ɛrehinhim.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Woama wo nkurɔfo ahu mmere bɔne;</para>
  <para style="q2" vid="PSA 60:3">woama yɛn nsa a ɛma yɛtɔ ntintan.<verse eid="PSA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>Nanso wɔn a wosuro wo de, woama wɔn frankaa so</para>
  <para style="q2" vid="PSA 60:4">sɛ wontu ntia agyan no.<verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Gye yɛn nkwa na fa wo nsa nifa boa yɛn,</para>
  <para style="q2" vid="PSA 60:5">na ama wɔn a wodɔ wɔn no anya nkwa.<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Onyankopɔn akasa afi ne kronkronbea se,</para>
  <para style="q2" vid="PSA 60:6">“Nkonim mu, mɛkyɛ Sekem mu,</para>
  <para style="q2" vid="PSA 60:6">na masusuw Sukot bon no.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Gilead yɛ me de; Manase nso saa ara;</para>
  <para style="q2" vid="PSA 60:7">Efraim yɛ me dade kyɛw,</para>
  <para style="q2" vid="PSA 60:7">Yuda yɛ mʼahempema.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Moab yɛ me guasɛn,</para>
  <para style="q2" vid="PSA 60:8">Edom so na metow me mpaboa gu;</para>
  <para style="q2" vid="PSA 60:8">na meteɛ mu nkonimdi so gu Filistifo so.”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Hena na ɔde me bɛkɔ kuropɔn a wɔabɔ ho ban no mu?</para>
  <para style="q2" vid="PSA 60:9">Hena na obedi mʼanim akɔ Edom?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Onyankopɔn, ɛnyɛ wo na woapo yɛn</para>
  <para style="q2" vid="PSA 60:10">na wo ne yɛn asraafo nkɔ ɔsa bio ana?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Boa yɛn tia ɔtamfo no,</para>
  <para style="q2" vid="PSA 60:11">na ɔdesani mmoa nka hwee.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>Onyankopɔn wɔ yɛn afa yi, yebedi nkonim,</para>
  <para style="q2" vid="PSA 60:12">na obetiatia yɛn atamfo so.</para>
  <para style="d" vid="PSA 60:12">Wɔde ma dwonkyerɛfo. Wɔde sanku na ɛto.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">Dwom 61</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>Ao, Onyankopɔn, tie me sufrɛ;</para>
  <para style="q2" vid="PSA 61:1">tie me mpaebɔ.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Mifi asase ano frɛ wo,</para>
  <para style="q2" vid="PSA 61:2">mefrɛ wo, efisɛ me koma atɔ beraw;</para>
  <para style="q2" vid="PSA 61:2">fa me kɔ ɔbotan a ɛware sen me no so.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Woayɛ me guankɔbea,</para>
  <para style="q2" vid="PSA 61:3">aban a ɛyɛ den ma ɔtamfo no.<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Me kɔn dɔ sɛ metena wo ntamadan no mu afebɔɔ</para>
  <para style="q2" vid="PSA 61:4">na manya guankɔbea wɔ wo ntaban nwini ase.<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Woate me bɔ a mehyɛe no, Onyankopɔn;</para>
  <para style="q2" vid="PSA 61:5">na wode wɔn a wosuro wo din no agyapade ama me.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>To ɔhene nkwanna mu bebree;</para>
  <para style="q2" vid="PSA 61:6">na ne mfe mfi awo ntoatoaso nkodu awo ntoatoaso.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>Ma onni hene wɔ Onyankopɔn anim daa</para>
  <para style="q2" vid="PSA 61:7">fa wʼadɔe ne wo nokware bɔ ne ho ban.<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Afei mɛto ayeyi dwom ama wo din daa</para>
  <para style="q2" vid="PSA 61:8">na madi me bɔhyɛ so daa nyinaa.</para>
  <para style="d" vid="PSA 61:8">Wɔde ma dwonkyerɛfo. De ma Yedutun.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">Dwom 62</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>Me kra wɔ ahomegye wɔ Onyankopɔn nko ara mu;</para>
  <para style="q2" vid="PSA 62:1">me nkwagye fi ne nkyɛn.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Ampa, ɔyɛ me botan ne me nkwagye;</para>
  <para style="q2" vid="PSA 62:2">ɔyɛ mʼabandennen, hwee renhinhim me da.<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Mobɛkɔ so ahyɛ onipa so akosi da bɛn,</para>
  <para style="q2" vid="PSA 62:3">mo nyinaa besum me ahwe fam ana?</para>
  <para style="q2" vid="PSA 62:3">Ɔfasu a akyea yi, ban a ɛrebu yi?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Ampa, wɔayɛ adwene se wobetu no</para>
  <para style="q2" vid="PSA 62:4">afi ne dibea a ɛkorɔn no so;</para>
  <para style="q1" vid="PSA 62:4">wɔn ani gye atorodi ho.</para>
  <para style="q2" vid="PSA 62:4">Wɔde wɔn ano hyira</para>
  <para style="q1" vid="PSA 62:4">na wɔn koma mu de, wɔdome.<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Yiw me kra, gye wʼahome wɔ Onyankopɔn nko ara mu;</para>
  <para style="q2" vid="PSA 62:5">na ne mu na mʼanidaso wɔ.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>Ampa, ɔyɛ me botan ne me nkwagye;</para>
  <para style="q2" vid="PSA 62:6">ɔyɛ mʼabandennen, hwee renhinhim me.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Me nkwagye ne mʼanuonyam gyina Onyankopɔn so;</para>
  <para style="q2" vid="PSA 62:7">ɔyɛ me botan a ɛkorɔn, ne me guankɔbea.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Mo nnipa, momfa mo ho nto ne so daa;</para>
  <para style="q2" vid="PSA 62:8">monka mo koma mu nsɛm nyinaa nkyerɛ no,</para>
  <para style="q2" vid="PSA 62:8">efisɛ Onyankopɔn ne yɛn guankɔbea.<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Nnipa nyinaa te sɛ home;</para>
  <para style="q2" vid="PSA 62:9">akɛse ne nkumaa nyinaa nka hwee;</para>
  <para style="q1" vid="PSA 62:9">sɛ wɔkari wɔn wɔ nsania so a, wɔnka hwee;</para>
  <para style="q2" vid="PSA 62:9">wɔn nyinaa bɔ mu a wɔyɛ home nko.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Mommfa mo ho nto asisi so</para>
  <para style="q2" vid="PSA 62:10">na monnhoahoa mo ho akorɔnne ho;</para>
  <para style="q1" vid="PSA 62:10">ɛwɔ mu sɛ mo ahonya dɔɔso de,</para>
  <para style="q2" vid="PSA 62:10">nanso mommfa mo koma nto so.<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Asɛm baako na Onyankopɔn aka,</para>
  <para style="q2" vid="PSA 62:11">nsɛm abien na mate sɛ,</para>
  <para style="q1" vid="PSA 62:11">wo, Onyankopɔn, na wowɔ ahoɔden,<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>na wo, Awurade, na woyɛ adɔe,</para>
  <para style="q2" vid="PSA 62:12">ampa ara wubetua obiara ka</para>
  <para style="q2" vid="PSA 62:12">sɛnea nʼadwuma te.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">Dwom 63</para>
  <para style="d">Dawid dwom. Bere a ɔwɔ Yuda Sare so no na ɔtoe.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>Wo, Onyankopɔn, ne me Nyankopɔn</para>
  <para style="q2" vid="PSA 63:1">Mehwehwɛ wo anibere so;</para>
  <para style="q1" vid="PSA 63:1">wo ho sukɔm de me kra,</para>
  <para style="q2" vid="PSA 63:1">me nipadua ani agyina wo,</para>
  <para style="q1" vid="PSA 63:1">wɔ asase a awo na asade nni mu so,</para>
  <para style="q2" vid="PSA 63:1">faako a nsu nni.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Mahu wo wɔ Kronkronbea hɔ</para>
  <para style="q2" vid="PSA 63:2">mahu wo tumi ne wʼanuonyam.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Esiane sɛ wʼadɔe di mu sen nkwa nti</para>
  <para style="q2" vid="PSA 63:3">mʼanofafa bɛhyɛ wo anuonyam.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Sɛ mete ase yi, mɛkamfo wo,</para>
  <para style="q2" vid="PSA 63:4">na wo din mu na mɛma me nsa so.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Me kra bɛmee sɛnea wadi aduan papa bi;</para>
  <para style="q2" vid="PSA 63:5">mede anofafa a ɛto dwom beyi wo ayɛ.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Meda me mpa so a, mekae wo.</para>
  <para style="q2" vid="PSA 63:6">Anadwo dasu mu nyinaa, midwen wo ho.<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Efisɛ wone me boafo,</para>
  <para style="q2" vid="PSA 63:7">wo ntaban ase nwini mu na mɛto dwom.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Me kra bata wo ho;</para>
  <para style="q2" vid="PSA 63:8">na wo nsa nifa kura me mu.<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Wɔn a wɔpɛ me akum me no bɛsɛe;</para>
  <para style="q2" vid="PSA 63:9">wɔbɛkɔ asase ase tɔnn.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Wɔbɛdan wɔn ama afoa</para>
  <para style="q2" vid="PSA 63:10">na wɔbɛyɛ aduan ama sakraman.<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>Nanso ɔhene bedi ahurusi wɔ Onyankopɔn mu;</para>
  <para style="q2" vid="PSA 63:11">wɔn a wɔka ntam wɔ Onyankopɔn din mu nyinaa bɛkamfo no,</para>
  <para style="q2" vid="PSA 63:11">na wobemua atorofo ano.</para>
  <para style="d" vid="PSA 63:11">Wɔde ma dwonkyerɛfo.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">Dwom 64</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>Me Nyankopɔn, tie me, bere a mereka me haw;</para>
  <para style="q2" vid="PSA 64:1">bɔ me kra ho ban fi ɔtamfo ahunahuna ho.<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Fa me sie fi amumɔyɛfo agyinatu ho,</para>
  <para style="q2" vid="PSA 64:2">ne nnebɔneyɛfo pɔwbɔ ho.<verse eid="PSA 64:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Wɔsew wɔn tɛkrɛma sɛ afoa</para>
  <para style="q2" vid="PSA 64:3">na wɔde atirimɔden nsɛm sɔn sɛ mmɛmma werɛmfo.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Wofi ahintawee mu, tow bɔ onipa a ne ho nni asɛm;</para>
  <para style="q2" vid="PSA 64:4">wɔtow bɔ no mpofirim a wonsuro.<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Wɔhyehyɛ wɔn ho wɔn ho nkuran wɔ wɔn amumɔyɛ nhyehyɛe ho,</para>
  <para style="q2" vid="PSA 64:5">wɔka sɛnea wobesum wɔn mfiri asie;</para>
  <para style="q2" vid="PSA 64:5">wɔka se, “Hena na obehu yɛn?”<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Wɔbɔ ntɛnkyew ho pɔw na wɔka se,</para>
  <para style="q2" vid="PSA 64:6">“Yɛayɛ nhyehyɛe a ɛso nni koraa!”</para>
  <para style="q1" vid="PSA 64:6">Ampa ara onipa koma ne nʼadwene yɛ anifere.<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>Nanso Onyankopɔn bɛto bɛmma abɔ wɔn;</para>
  <para style="q2" vid="PSA 64:7">na wɔbɛhwe fam prɛko pɛ.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Ɔbɛdan wɔn ankasa tɛkrɛma atia wɔn</para>
  <para style="q2" vid="PSA 64:8">na ɔde wɔn aba ɔsɛe mu;</para>
  <para style="q2" vid="PSA 64:8">na wɔn a wobehu wɔn nyinaa de animka bɛbɔ wɔn ti nko.<verse eid="PSA 64:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>Adesamma nyinaa besuro;</para>
  <para style="q2" vid="PSA 64:9">wɔbɛpae mu aka Onyankopɔn nnwuma</para>
  <para style="q2" vid="PSA 64:9">na wɔasusuw nea wayɛ ho.<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Ma atreneefo nni ahurusi wɔ Awurade mu</para>
  <para style="q2" vid="PSA 64:10">na wɔmpɛ guankɔbea wɔ no mu;</para>
  <para style="q2" vid="PSA 64:10">ma wɔn a wɔn koma mu tew nyinaa nyi no ayɛ!</para>
  <para style="d" vid="PSA 64:10">Wɔde ma dwonkyerɛfo.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">Dwom 65</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>Yɛn Nyankopɔn, ayeyi retwɛn wo wɔ Sion,</para>
  <para style="q2" vid="PSA 65:1">na yebedi yɛn bɔ a yɛahyɛ wo no so.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>Wo a woyɛ mpaebɔ tiefo,</para>
  <para style="q2" vid="PSA 65:2">wo nkyɛn na nnipa nyinaa bɛba.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Bere a yɛn bɔne menee yɛn no,</para>
  <para style="q2" vid="PSA 65:3">wo na wode yɛn mmarato kyɛɛ yɛn.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Nhyira nka wɔn a wuyi wɔn</para>
  <para style="q2" vid="PSA 65:4">ma wɔbɛn wo sɛ wɔntena wʼadiwo hɔ!</para>
  <para style="q1" vid="PSA 65:4">Nneɛma pa a ɛwɔ wo fi ahyɛ yɛn ma,</para>
  <para style="q2" vid="PSA 65:4">nea ɛwɔ wʼasɔredan kronkron mu no.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Wode trenee nnwuma a ɛyɛ nwonwa ma yɛn mmuae,</para>
  <para style="q2" vid="PSA 65:5">Onyankopɔn, yɛn agyenkwa,</para>
  <para style="q1" vid="PSA 65:5">asase so mmaa nyinaa anidaso</para>
  <para style="q2" vid="PSA 65:5">ne po so akyirikyiri nso.<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>Wonam wo tumi so yɛɛ mmepɔw</para>
  <para style="q2" vid="PSA 65:6">de daa wʼahoɔden adi.<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>Wudwudwoo po asorɔkye ano,</para>
  <para style="q2" vid="PSA 65:7">asorɔkye no mmobɔwee,</para>
  <para style="q2" vid="PSA 65:7">ne amanaman no hooyɛ.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Wɔn a wɔte akyirikyiri no suro wʼanwonwade;</para>
  <para style="q2" vid="PSA 65:8">faako a ade kye, nea anwummere yera,</para>
  <para style="q2" vid="PSA 65:8">wofrɛ ahurusi nnwom wɔ hɔ.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Wohwɛ asase no gugu so nsu;</para>
  <para style="q2" vid="PSA 65:9">woma no yɛ asase pa ma ɛboro so.</para>
  <para style="q1" vid="PSA 65:9">Wode nsu hyɛ Onyankopɔn nsuwansuwa ma</para>
  <para style="q2" vid="PSA 65:9">sɛnea ɛbɛma nnipa no aduan,</para>
  <para style="q2" vid="PSA 65:9">efisɛ saa ne nea woahyɛ.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Wofɔw nea woafuntum hɔ no fɔkyee</para>
  <para style="q2" vid="PSA 65:10">na wokaa nkɔmoa no kataa so;</para>
  <para style="q1" vid="PSA 65:10">wode nsu petee so ma no yɛɛ bɛtɛɛ</para>
  <para style="q2" vid="PSA 65:10">na wuhyiraa so afifide.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Wode nnɔbae bebree wiee afe no,</para>
  <para style="q2" vid="PSA 65:11">na wo nteaseɛnam yɛɛ ma buu so.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Sare so nwura dɔɔso</para>
  <para style="q2" vid="PSA 65:12">na anigye baa nkoko so.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Nguankuw ahyɛ adidibea hɔ ma</para>
  <para style="q2" vid="PSA 65:13">na awi akata aku no so;</para>
  <para style="q2" vid="PSA 65:13">wɔbɔ ose, to ahosɛpɛw dwom.</para>
  <para style="d" vid="PSA 65:13">Wɔde ma dwonkyerɛfo.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">Dwom 66</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>Asase nyinaa momfa ahosɛpɛw nteɛ mu mma Onyankopɔn!<verse eid="PSA 66:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2"/>Monto ne din anuonyamhyɛ ho dwom;</para>
  <para style="q2" vid="PSA 66:2">momma nʼayeyi nyɛ anuonyamhyɛ!<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Munse Onyankopɔn sɛ, “Wo nneyɛe yɛ nwonwa dodo!</para>
  <para style="q2" vid="PSA 66:3">Wo tumi so mmoroso</para>
  <para style="q2" vid="PSA 66:3">a wʼatamfo nyinaa de osuro kotow wʼanim.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Asase nyinaa kotow wo;</para>
  <para style="q2" vid="PSA 66:4">wɔto ayeyi dwom ma wo,</para>
  <para style="q2" vid="PSA 66:4">wɔto dwom kamfo wo din.”<verse eid="PSA 66:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Mommra mmɛhwɛ nea Onyankopɔn ayɛ;</para>
  <para style="q2" vid="PSA 66:5">anwonwade a wayɛ wɔ nnipa mu.<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>Ɔmaa po yɛɛ asase kesee;</para>
  <para style="q2" vid="PSA 66:6">wɔnantew twaa nsu no</para>
  <para style="q2" vid="PSA 66:6">mommra mma yenni ahurusi wɔ no mu.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>Ɔde ne tumi di hene daa daa,</para>
  <para style="q2" vid="PSA 66:7">na ɔde nʼani nso hwɛ aman so.</para>
  <para style="q2" vid="PSA 66:7">Mma atuatewfo nsɔre ntia no.<verse eid="PSA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Aman nyinaa, munhyira yɛn Nyankopɔn,</para>
  <para style="q2" vid="PSA 66:8">momma wɔnte mo nkamfo no nnyigyei;<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>wahwɛ yɛn nkwa so</para>
  <para style="q2" vid="PSA 66:9">na wamma yɛn anan anwatiri.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Na wo, Onyankopɔn, wosɔɔ yɛn hwɛe;</para>
  <para style="q2" vid="PSA 66:10">na wonan yɛn sɛ dwetɛ.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Wode yɛn koguu afiase</para>
  <para style="q2" vid="PSA 66:11">na wode nneɛma a ɛyɛ duru too yɛn akyi.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Womaa yɛn atamfo twiw faa yɛn so;</para>
  <para style="q2" vid="PSA 66:12">yɛfaa ogya ne nsu mu,</para>
  <para style="q2" vid="PSA 66:12">nanso wode yɛn baa faako a nnepa abu so.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Mede ɔhyew afɔre bɛba wʼasɔredan mu</para>
  <para style="q2" vid="PSA 66:13">na madi bɔ a mahyɛ wo no so,<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>bɔ a mʼanofafa hyɛe, na mʼano kaa</para>
  <para style="q2" vid="PSA 66:14">bere a na mewɔ ɔhaw mu no.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Mede mmoa a wɔadɔ srade bɛbɔ afɔre ama wo;</para>
  <para style="q2" vid="PSA 66:15">adwennini ayɛyɛde;</para>
  <para style="q2" vid="PSA 66:15">mede anantwinini ne mpapo bɛbɔ afɔre.<verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Mommra mmetie, mo a musuro Onyankopɔn nyinaa;</para>
  <para style="q2" vid="PSA 66:16">momma menka nea wayɛ ama me nkyerɛ mo.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Mede mʼano su frɛɛ no;</para>
  <para style="q2" vid="PSA 66:17">na me tɛkrɛma yii no ayɛ.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Sɛ mede bɔne hyɛɛ me koma mu a,</para>
  <para style="q2" vid="PSA 66:18">anka Awurade antie me.<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>Nanso nokware, Onyankopɔn atie me,</para>
  <para style="q2" vid="PSA 66:19">wate me mpaebɔ.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Nhyira nka Onyankopɔn,</para>
  <para style="q2" vid="PSA 66:20">a wampo me mpaebɔ</para>
  <para style="q2" vid="PSA 66:20">na wanyi nʼadɔe amfi me so.</para>
  <para style="d" vid="PSA 66:20">Wɔde ma dwonkyerɛfo. Wɔde sanku na ɛto.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">Dwom 67</para>
  <para style="d">Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>Onyankopɔn nnom yɛn na onhyira yɛn</para>
  <para style="q2" vid="PSA 67:1">ɔmma nʼanim nhyerɛn wɔ yɛn so,<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>na ɔmma wonhu nʼakwan wɔ asase so,</para>
  <para style="q2" vid="PSA 67:2">ne ne nkwagye wɔ amanaman no nyinaa mu.<verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>Ma adesamma nyi wo ayɛ, Onyankopɔn;</para>
  <para style="q2" vid="PSA 67:3">ma nnipa nyinaa nkamfo wo.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Ma amanaman ani nnye na wɔnto ahosɛpɛw dwom,</para>
  <para style="q2" vid="PSA 67:4">efisɛ wudi nnipa no so trenee mu</para>
  <para style="q2" vid="PSA 67:4">na woma asase so amanaman no akwankyerɛ.<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Ma adesamma nyi wo ayɛ, Onyankopɔn;</para>
  <para style="q2" vid="PSA 67:5">ma nnipa nyinaa nkamfo wo!<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Afei asase no bɛbɔ ne nnɔbae,</para>
  <para style="q2" vid="PSA 67:6">na Onyankopɔn, yɛn Nyankopɔn ahyira yɛn.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Onyankopɔn behyira yɛn,</para>
  <para style="q2" vid="PSA 67:7">na asase mmaa nyinaa besuro no.</para>
  <para style="d" vid="PSA 67:7">Wɔde ma dwonkyerɛfo.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">Dwom 68</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>Ma Onyankopɔn nsɔre, ma nʼatamfo nhwete;</para>
  <para style="q2" vid="PSA 68:1">wɔn a wɔtan no no nguan mfi nʼanim.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Sɛnea mframa bɔ wusiw gu no,</para>
  <para style="q2" vid="PSA 68:2">saa ara na bɔ wɔn gu;</para>
  <para style="q1" vid="PSA 68:2">sɛnea srade nan wɔ ogya so no,</para>
  <para style="q2" vid="PSA 68:2">saa ara na amumɔyɛfo nyera mfi Onyankopɔn anim.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Nanso ma atreneefo ani nnye</para>
  <para style="q2" vid="PSA 68:3">na wɔnsɛpɛw wɔn ho wɔ Onyankopɔn anim;</para>
  <para style="q2" vid="PSA 68:3">ma wɔn ho ntɔ wɔn na wonni ahurusi.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>To dwom ma Onyankopɔn, to dwom yi ne din ayɛ.</para>
  <para style="q2" vid="PSA 68:4">Ma nea ɔnantew omununkum so no din so.</para>
  <para style="q1" vid="PSA 68:4">Ne din ne <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 68:4">ma wʼani nnye wɔ nʼanim.<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Ayisaa agya ne nea odi akunafo asɛm ma wɔn</para>
  <para style="q2" vid="PSA 68:5">ne Onyankopɔn a ɔte nʼatenae kronkron hɔ.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Ɔma ohiani tena mmusua mu,</para>
  <para style="q2" vid="PSA 68:6">na ɔde nnwonto yi nneduafo ma wɔde wɔn ho;</para>
  <para style="q2" vid="PSA 68:6">na atuatewfo de, wɔtena asase a awo so.<verse eid="PSA 68:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>Onyankopɔn, bere a wudii wo nkurɔfo anim,</para>
  <para style="q2" vid="PSA 68:7">bere a wode wɔn faa sare so no,<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>asase wosowee,</para>
  <para style="q2" vid="PSA 68:8">na ɔsoro tuee osu guu fam,</para>
  <para style="q1" vid="PSA 68:8">wɔ Onyankopɔn, Sinai Nyankopɔn,</para>
  <para style="q2" vid="PSA 68:8">Onyankopɔn, Israel Nyankopɔn no anim.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>Womaa osu tɔɔ bebree, Ao, Onyankopɔn,</para>
  <para style="q2" vid="PSA 68:9">guu wʼagyapade a abotow no so ma ɛyɛɛ frɔmfrɔm.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Wo nkurɔfo bɔɔ atenase wɔ so,</para>
  <para style="q2" vid="PSA 68:10">Onyankopɔn, wonam wʼadɔe bebree no so hwɛɛ ahiafo.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Awurade kaa asɛm no,</para>
  <para style="q2" vid="PSA 68:11">na dodow no ara ne wɔn a wɔpaee mu kae;<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“Ahemfo ne wɔn asraafo guan ntɛm so;</para>
  <para style="q2" vid="PSA 68:12">mmea a wɔwɔ fie no kyɛ asade.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Mpo bere a woda nguanban mu no,</para>
  <para style="q2" vid="PSA 68:13">wɔde dwetɛ duraa mʼaborɔnoma ntaban ho,</para>
  <para style="q2" vid="PSA 68:13">de sikakɔkɔɔ a ɛhyerɛn guu wɔn ntakra so.”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Bere a Otumfo bɔɔ ahene a wɔwɔ asase no so hwetee no,</para>
  <para style="q2" vid="PSA 68:14">na ɛte sɛ sukyerɛmma a agu Bepɔw Salmon so.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Basan mmepɔw gyinagyina hɔ,</para>
  <para style="q1" vid="PSA 68:15">Basan mmepɔw so yɛ abonkyiabonkyi.<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>Wo bepɔw abonkyiabonkyi, adɛn nti na wode ani bɔne hwɛ</para>
  <para style="q2" vid="PSA 68:16">bepɔw a Onyankopɔn ayi sɛ obedi so hene,</para>
  <para style="q2" vid="PSA 68:16">faako a <char style="nd">Awurade</char> ankasa bɛtena afebɔɔ?<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Onyankopɔn nteaseɛnam yɛ mpem mpem</para>
  <para style="q2" vid="PSA 68:17">ne mpem mpem mu mpem;</para>
  <para style="q2" vid="PSA 68:17">Awurade fi Sinai aba ne kronkronbea.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Bere a woforo kɔɔ soro no,</para>
  <para style="q2" vid="PSA 68:18">wode nnommum kaa wo ho;</para>
  <para style="q2" vid="PSA 68:18">wunyaa ayɛyɛde fii nnipa hɔ,</para>
  <para style="q1" vid="PSA 68:18">fii atuatewfo hɔ mpo,</para>
  <para style="q2" vid="PSA 68:18">sɛ ɛbɛyɛ a wobɛtena hɔ, <char style="nd">Awurade</char> Nyankopɔn.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Ayeyi nka Awurade, nka Onyankopɔn yɛn Agyenkwa,</para>
  <para style="q2" vid="PSA 68:19">nea ɔsoa yɛn nnesoa da biara no.<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Yɛn Nyankopɔn yɛ Onyankopɔn a ogye nkwa;</para>
  <para style="q2" vid="PSA 68:20">na <char style="nd">Awurade</char> mu na owu tow fom yɛn.<verse eid="PSA 68:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Ampa ara Onyankopɔn bɛdwerɛw nʼatamfo ti,</para>
  <para style="q2" vid="PSA 68:21">wɔn a wɔkɔ so yɛ bɔne ti kusuu no.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>
    <char style="nd">Awurade</char> ka se, “Mede wɔn befi Basan aba;</para>
  <para style="q2" vid="PSA 68:22">mede wɔn befi po bun mu aba,<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>na moanantew wɔn a wokyi mo no mogya mu</para>
  <para style="q2" vid="PSA 68:23">na mo akraman tɛkrɛma anya wɔn kyɛfa.”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>Onyankopɔn, yɛahu wo santen yuu no,</para>
  <para style="q2" vid="PSA 68:24">me Nyankopɔn ne me Hene santen yuu no a ɔde reba ne kronkronbea hɔ.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Nnwontofo no wɔ anim, na asankubɔfo no nso di so,</para>
  <para style="q2" vid="PSA 68:25">na mmabaa a wɔrewosow akasae nso ka wɔn ho.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Monkamfo Onyankopɔn wɔ asafo kɛse no mu;</para>
  <para style="q2" vid="PSA 68:26">monkamfo <char style="nd">Awurade</char> wɔ Israel nnipakuw no mu.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>Abusuakuw ketewa, Benyamin na odi wɔn kan,</para>
  <para style="q2" vid="PSA 68:27">Yuda mmapɔmma kuw kɛse no di so,</para>
  <para style="q2" vid="PSA 68:27">na Sebulon ne Naftali mmapɔmma aba.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Kyerɛ wo tumi, Onyankopɔn;</para>
  <para style="q2" vid="PSA 68:28">da wʼahoɔden adi kyerɛ yɛn, sɛnea woayɛ pɛn no.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Wʼasɔredan a ɛwɔ Yerusalem nti</para>
  <para style="q2" vid="PSA 68:29">ahemfo de ayɛyɛde bɛbrɛ wo.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Ka aboa a ɔhyɛ mfea mu no anim,</para>
  <para style="q2" vid="PSA 68:30">ne anantwinini kuw a wɔhyɛ amanaman no nantwimma mu no.</para>
  <para style="q1" vid="PSA 68:30">Brɛ wɔn ase kosi sɛ wɔde dwetɛ mpɔw bɛba.</para>
  <para style="q2" vid="PSA 68:30">Bɔ wɔn a wɔn ani gye ɔko ho no pansam.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Ananmusifo befi Misraim aba,</para>
  <para style="q2" vid="PSA 68:31">na Kus de ne ho bɛma Onyankopɔn.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Wiase ahemman, monto dwom mma Onyankopɔn,</para>
  <para style="q2" vid="PSA 68:32">monto ayeyi nnwom mma <char style="nd">Awurade</char>,<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>monto mma nea ɔte tete ɔsorosoro so no,</para>
  <para style="q2" vid="PSA 68:33">na ɔde nne kɛse bobɔ mu no.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Mompae mu nka Onyankopɔn tumi,</para>
  <para style="q2" vid="PSA 68:34">nea ne kɛseyɛ kata Israel so no,</para>
  <para style="q2" vid="PSA 68:34">na ne tumi wɔ soro ɔsoro no.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>Wo ho yɛ hu, Onyankopɔn, wɔ wo kronkronbea hɔ;</para>
  <para style="q2" vid="PSA 68:35">Israel Nyankopɔn de tumi ne ahoɔden ma ne nkurɔfo.</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">Ayeyi nka Onyankopɔn!</para>
  <para style="d" vid="PSA 68:35">Wɔde ma dwonkyerɛfo. Wɔto no sɛ “Sukooko.”<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">Dwom 69</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>Ao, Onyankopɔn, gye me nkwa</para>
  <para style="q2" vid="PSA 69:1">na nsu no abɛdeda me kɔn mu.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Meremem wɔ dontori a mu dɔ mu,</para>
  <para style="q2" vid="PSA 69:2">wɔ baabi a mʼanan nnya sibea.</para>
  <para style="q1" vid="PSA 69:2">Madu bun mu</para>
  <para style="q2" vid="PSA 69:2">na nsu abu afa me so.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Mafrɛ abrɛ rehwehwɛ mmoa.</para>
  <para style="q2" vid="PSA 69:3">Me mene mu ayow.</para>
  <para style="q1" vid="PSA 69:3">Mʼani so ayɛ kusuu,</para>
  <para style="q1" vid="PSA 69:3">na merehwehwɛ me Nyankopɔn.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Wɔn a wɔtan me kwa no</para>
  <para style="q2" vid="PSA 69:4">dɔɔso sen me ti so nwi;</para>
  <para style="q1" vid="PSA 69:4">wɔn a wɔtan me kwa no dɔɔso,</para>
  <para style="q2" vid="PSA 69:4">wɔn a wɔhwehwɛ sɛ wɔbɛsɛe me no.</para>
  <para style="q1" vid="PSA 69:4">Wɔhyɛ me sɛ mennan</para>
  <para style="q2" vid="PSA 69:4">nea minnwiae no mma.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>Wo, Onyankopɔn, nim me nkwaseasɛm;</para>
  <para style="q2" vid="PSA 69:5">mʼafɔdi nhintaw wo.<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>Awurade, Awurade Tweduampɔn,</para>
  <para style="q2" vid="PSA 69:6">mma wɔn a wɔn ani da wo so no,</para>
  <para style="q2" vid="PSA 69:6">anim ngu ase esiane me nti, Awurade, Asafo <char style="nd">Awurade</char>;</para>
  <para style="q1" vid="PSA 69:6">Israel Nyankopɔn,</para>
  <para style="q2" vid="PSA 69:6">mma wɔn a wɔhwehwɛ wo no</para>
  <para style="q2" vid="PSA 69:6">anim ngu ase esiane me nti.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Wo nti migyina animka ano,</para>
  <para style="q2" vid="PSA 69:7">na aniwu kata mʼanim.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Mete sɛ ɔhɔho wɔ me nuanom mu,</para>
  <para style="q2" vid="PSA 69:8">mete sɛ ɔmamfrani wɔ me na mmabarima mu,<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>na wo fi ho mmɔdemmɔ hyɛ me so,</para>
  <para style="q2" vid="PSA 69:9">wɔn a wɔbɔ wo ahohora no animtiaabu bɛda me so.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Sɛ mitwa adwo na midi mmuada a</para>
  <para style="q2" vid="PSA 69:10">wɔbɔ me ahohora;<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>sɛ mifura atweaatam a</para>
  <para style="q2" vid="PSA 69:11">nnipa de me yɛ aserewde.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Wɔn a wɔtete ɔpon no ano no serew me,</para>
  <para style="q2" vid="PSA 69:12">na akɔwensafo de me din to dwom.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>Nanso mɛbɔ wo mpae, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 69:13">wɔ wʼadom bere mu;</para>
  <para style="q1" vid="PSA 69:13">wɔ wʼadɔe kɛse no nti, Ao, Onyankopɔn,</para>
  <para style="q2" vid="PSA 69:13">fa wo nokware nkwagye no gye me so.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Yi me fi dontori no mu,</para>
  <para style="q2" vid="PSA 69:14">mma memmem wɔ mu;</para>
  <para style="q1" vid="PSA 69:14">gye me fi wɔn a wɔtan me no nsam,</para>
  <para style="q2" vid="PSA 69:14">ne nsu bun mu.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Mma nsu nnyiri mmfa me</para>
  <para style="q2" vid="PSA 69:15">anaa bun mmene me</para>
  <para style="q2" vid="PSA 69:15">anaa amoa nkata me so.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>
    <char style="nd">Awurade</char>, gye me so fi wʼadɔe a eye no mu;</para>
  <para style="q2" vid="PSA 69:16">wʼadom nti, dan bɛhwɛ me.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>Mfa wʼanim nhintaw wo somfo;</para>
  <para style="q2" vid="PSA 69:17">gye me so ntɛm, na mewɔ ɔhaw mu.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Twiw bɛn me na gye me;</para>
  <para style="q2" vid="PSA 69:18">gye me nkwa, mʼatamfo nti.<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Wunim sɛnea wɔkasa tia me, gu mʼanim ase na wotiatia mʼanim;</para>
  <para style="q2" vid="PSA 69:19">wʼani tua mʼatamfo nyinaa.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Kasatia ahyɛ me koma so</para>
  <para style="q2" vid="PSA 69:20">ama mayɛ sɛ obi a onni ɔboafo;</para>
  <para style="q1" vid="PSA 69:20">mepɛɛ awerɛkyekye, nanso mannya bi,</para>
  <para style="q2" vid="PSA 69:20">mepɛɛ ɔwerɛkyekyefo, nanso manhu bi.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Wɔde bɔnwoma guu mʼaduan mu,</para>
  <para style="q2" vid="PSA 69:21">osukɔm dee me no, wɔmaa me nsa nwenweenwen.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Ma wɔn didipon a esi wɔn anim nyi wɔn sɛ afiri;</para>
  <para style="q2" vid="PSA 69:22">ma ɛnyɛ akatua ne afide mma wɔn.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Ma wɔn ani so nyɛ wɔn kusuu na wɔanhu ade,</para>
  <para style="q2" vid="PSA 69:23">na ma wɔn akyi nkuntun afebɔɔ.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Hwie wʼabufuwhyew gu wɔn so;</para>
  <para style="q2" vid="PSA 69:24">na ma wʼabufuw huhuhuhu no mmra wɔn so.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Ma wɔn fi nyɛ amamfo;</para>
  <para style="q2" vid="PSA 69:25">mma obiara ntena wɔn ntamadan mu.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Wɔtaa wɔn a wupira wɔn no,</para>
  <para style="q2" vid="PSA 69:26">wɔka wɔn a wupira wɔn no yawdi ho asɛm.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Fa amumɔyɛ mu amumɔyɛ ho sobo bɔ wɔn;</para>
  <para style="q2" vid="PSA 69:27">mma wonnya wo nkwagye mu kyɛfa.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Pepa wɔn din fi nkwa nhoma no mu,</para>
  <para style="q2" vid="PSA 69:28">mfa wɔn din nka atreneefo de ho.<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>Mewɔ ɔyaw ne ahohiahia mu;</para>
  <para style="q2" vid="PSA 69:29">Onyankopɔn, ma wo nkwagye no mmɔ me ho ban.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Mede dwonto beyi Onyankopɔn din ayɛ</para>
  <para style="q2" vid="PSA 69:30">na mede aseda ahyɛ no anuonyam.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Eyi bɛsɔ <char style="nd">Awurade</char> ani yiye asen nantwi,</para>
  <para style="q2" vid="PSA 69:31">asen nantwinini a otua mmɛn na ɔwɔ tɔte.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Mmɔborɔni behu na nʼani agye,</para>
  <para style="q2" vid="PSA 69:32">mo a mohwehwɛ Onyankopɔn no koma benya nkwa.<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>
    <char style="nd">Awurade</char> tie wɔn a ade ahia wɔn,</para>
  <para style="q2" vid="PSA 69:33">na ommu ne nkurɔfo nneduafo animtiaa.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Ma ɔsoro ne asase nkamfo no,</para>
  <para style="q2" vid="PSA 69:34">po ne nea ɛkeka ne ho wɔ mu nyinaa,<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>efisɛ Onyankopɔn begye Sion nkwa</para>
  <para style="q2" vid="PSA 69:35">na wakyekye Yuda nkuropɔn no bio.</para>
  <para style="q1" vid="PSA 69:35">Afei nnipa bɛtena mu na ayɛ wɔn de;<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>Nʼasomfo asefo na wɔbɛfa hɔ,</para>
  <para style="q2" vid="PSA 69:36">na wɔn a wɔdɔ ne din no bɛtena hɔ.</para>
  <para style="d" vid="PSA 69:36">Wɔde ma dwonkyerɛfo.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">Dwom 70</para>
  <para style="d">Dawid adesrɛ dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>Ao, Onyankopɔn, yɛ ntɛm gye me nkwa;</para>
  <para style="q2" vid="PSA 70:1">
    <char style="nd">Awurade</char> bra ntɛm bɛboa me.<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>Ma wɔn a wɔhwehwɛ me kra no</para>
  <para style="q2" vid="PSA 70:2">anim ngu ase na wɔnyɛ basaa;</para>
  <para style="q1" vid="PSA 70:2">ma wɔn a wɔhwehwɛ me sɛe no nyinaa</para>
  <para style="q2" vid="PSA 70:2">mfa animguase nsan wɔn akyi.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Ma wɔn a wɔka, “Ɔtwea! Ɔtwea!” kyerɛ me no</para>
  <para style="q2" vid="PSA 70:3">nsan wɔn akyi, esiane wɔn aniwu nti.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Nanso ma wɔn a wɔhwehwɛ wo nyinaa</para>
  <para style="q2" vid="PSA 70:4">nsɛpɛw wɔn ho na wɔn ani nnye wɔ wo mu;</para>
  <para style="q1" vid="PSA 70:4">ma wɔn a wɔdɔ wo nkwagye no nka da biara se,</para>
  <para style="q2" vid="PSA 70:4">“Onyankopɔn yɛ ɔkɛse!”<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Me de meyɛ ohiani a minni ɔboafo;</para>
  <para style="q2" vid="PSA 70:5">Ao, Onyankopɔn, bra me nkyɛn ntɛm.</para>
  <para style="q1" vid="PSA 70:5">Wo ne me boafo ne me gyefo;</para>
  <para style="q2" vid="PSA 70:5">
    <char style="nd">Awurade</char>, ntwentwɛn wʼanan ase.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">Dwom 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>
    <char style="nd">Awurade</char>, wo mu na maguan ahintaw;</para>
  <para style="q2" vid="PSA 71:1">mma mʼanim ngu ase da.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Wo trenee no nti, yi me na gye me;</para>
  <para style="q2" vid="PSA 71:2">tie me na gye me nkwa.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Yɛ me nkwagye botan,</para>
  <para style="q2" vid="PSA 71:3">faako a metumi akɔ daa;</para>
  <para style="q1" vid="PSA 71:3">hyɛ ma wommegye me nkwa,</para>
  <para style="q2" vid="PSA 71:3">na wone me botan ne mʼabandennen.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>Me Nyankopɔn, gye me fi amumɔyɛfo nsam,</para>
  <para style="q2" vid="PSA 71:4">gye me fi nnebɔneyɛfo ne atirimɔdenfo nsam.<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Na woayɛ mʼanidaso, Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 71:5">mʼahotoso fi me mmabun bere mu.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Mede me ho ato wo so fi awo mu;</para>
  <para style="q2" vid="PSA 71:6">wo na wuyii me fii me na yafunu mu.</para>
  <para style="q2" vid="PSA 71:6">Mɛkamfo wo daa.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Mayɛ nsɛnkyerɛnne ama bebree,</para>
  <para style="q2" vid="PSA 71:7">nanso wo ne me guankɔbea dennen.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Wo nkamfo ahyɛ mʼanom ma,</para>
  <para style="q2" vid="PSA 71:8">mekamfo wʼanuonyam da mu nyinaa.<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Ntow me nkyene bere a mabɔ akwakoraa;</para>
  <para style="q2" vid="PSA 71:9">mʼahoɔden sa wɔ me mu a, nnyaw me.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Efisɛ mʼatamfo kasa tia me</para>
  <para style="q2" vid="PSA 71:10">wɔn a wɔtwɛn sɛ wobekum me no bɔ mu pam me ti so.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Wɔka se, “Onyankopɔn agyaw no mu;</para>
  <para style="q2" vid="PSA 71:11">momma yentiw no na yɛnkyere no,</para>
  <para style="q2" vid="PSA 71:11">na obiara nni hɔ a obegye no.”<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>Me Nyankopɔn, mfi me nkyɛn nkɔ akyiri;</para>
  <para style="q2" vid="PSA 71:12">Onyankopɔn, yɛ ntɛm bɛboa me.<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Ma wɔn a wɔbɔ me sobo no nsɛe wɔ animguase mu;</para>
  <para style="q2" vid="PSA 71:13">wɔn a wɔpɛ sɛ wopira me no</para>
  <para style="q2" vid="PSA 71:13">ma ahohora ne animguase nkata wɔn so.<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Nanso me de, menya anidaso daa;</para>
  <para style="q2" vid="PSA 71:14">mɛkɔ so akamfo wo.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Mɛka wo trenee ho asɛm,</para>
  <para style="q2" vid="PSA 71:15">ne wo nkwagye da mu nyinaa,</para>
  <para style="q2" vid="PSA 71:15">nanso minnim ano.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Otumfo <char style="nd">Awurade</char>, mɛba abɛpae mu aka wo nnwuma akɛse no;</para>
  <para style="q2" vid="PSA 71:16">mɛpae mu aka wo trenee, wo nko ara de no, akyerɛ.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>Onyankopɔn, efi me mmabun bere na wokyerɛkyerɛɛ me,</para>
  <para style="q2" vid="PSA 71:17">na ebesi nnɛ yi meka wʼanwonwade a woayɛ kyerɛ.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Mpo sɛ mebɔ akwakoraa na mifuw dwen a,</para>
  <para style="q2" vid="PSA 71:18">Onyankopɔn, nnyaw me,</para>
  <para style="q1" vid="PSA 71:18">kosi sɛ mɛka wo tumi ho asɛm akyerɛ nkyirimma,</para>
  <para style="q2" vid="PSA 71:18">ne wo kɛseyɛ akyerɛ wɔn a wɔbɛba nyinaa.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>Onyankopɔn, wo trenee du ɔsorosoro,</para>
  <para style="q2" vid="PSA 71:19">wo a woayɛ nneɛma akɛse.</para>
  <para style="q2" vid="PSA 71:19">Onyankopɔn, hena na ɔte sɛ wo?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Mmom woama mahu ɔhaw bebree a ɛyɛ yaw;</para>
  <para style="q2" vid="PSA 71:20">nanso wobɛma me nkwa bio;</para>
  <para style="q1" vid="PSA 71:20">na wubeyi me bio,</para>
  <para style="q2" vid="PSA 71:20">afi asase yam.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Wobɛhyɛ me anuonyam bebree</para>
  <para style="q2" vid="PSA 71:21">na woakyekye me werɛ bio.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Mede sanku bɛkamfo wo</para>
  <para style="q2" vid="PSA 71:22">me Nyankopɔn, wo trenee nti</para>
  <para style="q1" vid="PSA 71:22">mɛto wʼayeyi dwom wɔ sankuten so,</para>
  <para style="q2" vid="PSA 71:22">Israel Kronkronni.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Mʼanofafa de anigye bɛteɛ mu</para>
  <para style="q2" vid="PSA 71:23">bere a meto dwom kamfo wo,</para>
  <para style="q2" vid="PSA 71:23">me a woagye me no.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Me tɛkrɛma bɛka wo trenee nnwuma</para>
  <para style="q2" vid="PSA 71:24">da mu nyinaa,</para>
  <para style="q1" vid="PSA 71:24">efisɛ wɔn a wɔpɛ sɛ wɔhaw me no</para>
  <para style="q2" vid="PSA 71:24">kɔ animguase ne basaayɛ mu.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">Dwom 72</para>
  <para style="d">Salomo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>Ao, Onyankopɔn, fa wʼatɛntrenee dom ɔhene no,</para>
  <para style="q2" vid="PSA 72:1">na fa wo trenee ma ɔhene babarima.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>Ɔde trenee bebu wo nkurɔfo atɛn,</para>
  <para style="q2" vid="PSA 72:2">obebu wo nkurɔfo a wɔrehu amane no atɛntrenee.<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Mmepɔw no de yiyedi bɛbrɛ nnipa no,</para>
  <para style="q2" vid="PSA 72:3">nkoko no de trenee bɛba.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Ɔbɛko ama nnipa no mu amanehunufo</para>
  <para style="q2" vid="PSA 72:4">na wagye wɔn a wonni bi mma nkwa;</para>
  <para style="q2" vid="PSA 72:4">ɔbɛdwerɛw nhyɛsofo.<verse eid="PSA 72:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Owia ne ɔsram da so wɔ hɔ yi</para>
  <para style="q2" vid="PSA 72:5">wobesuro wo awo ntoatoaso nyinaa mu.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Ɔbɛyɛ sɛ osu a ɛtɔ gu asase a wɔadɔw so so,</para>
  <para style="q2" vid="PSA 72:6">te sɛ obosu a egugu asase so.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Atreneefo benyin frɔmfrɔm wɔ ne bere so;</para>
  <para style="q2" vid="PSA 72:7">yiyedi bebu so akosi da a ɔsram nni hɔ bio.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Obedi hene afi po akosi po,</para>
  <para style="q2" vid="PSA 72:8">afi Asubɔnten Efrata akosi asase ano.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Sare so mmusua bɛkotow nʼanim</para>
  <para style="q2" vid="PSA 72:9">na nʼatamfo adi mfutuma.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Tarsis ne mpoano ahemfo a wɔwɔ akyirikyiri</para>
  <para style="q2" vid="PSA 72:10">de sonkahiri bɛbrɛ no;</para>
  <para style="q1" vid="PSA 72:10">Saba ne Seba ahemfo</para>
  <para style="q2" vid="PSA 72:10">de ayɛyɛde bɛbrɛ no.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Ahemfo nyinaa bɛkotow no,</para>
  <para style="q2" vid="PSA 72:11">amanaman nyinaa bɛsom no.<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Na obegye mmɔborɔfo a wosu frɛ no,</para>
  <para style="q2" vid="PSA 72:12">ne amanehunufo a wonni ɔboafo.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Obehu wɔn a wɔayɛ mmrɛw ne ahiafo mmɔbɔ</para>
  <para style="q2" vid="PSA 72:13">na wagye ahiafo nkwa.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Obegye wɔn afi nhyɛso ne akakabensɛm ase,</para>
  <para style="q2" vid="PSA 72:14">efisɛ wɔn mogya som bo wɔ nʼanim.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Ɔhene nkwa so!</para>
  <para style="q2" vid="PSA 72:15">ma wɔmfa sikakɔkɔɔ mfi Seba mmrɛ no.</para>
  <para style="q1" vid="PSA 72:15">Ma nnipa mmɔ mpae mma no</para>
  <para style="q2" vid="PSA 72:15">na wonhyira no da mu nyinaa.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Aburow mmu so wɔ asase no so nyinaa;</para>
  <para style="q2" vid="PSA 72:16">nnuan mmu so wɔ nkoko so,</para>
  <para style="q2" vid="PSA 72:16">ma nʼaba mmɔ sɛ Lebanon;</para>
  <para style="q1" vid="PSA 72:16">na enyin sɛ mfuw so sare.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Ne din bɛtena hɔ daa;</para>
  <para style="q2" vid="PSA 72:17">ɛntena hɔ nkyɛ sɛ owia.</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">Wɔbɛfa no so ahyira amanaman no,</para>
  <para style="q2" vid="PSA 72:17">na wɔbɛfrɛ no nhyira.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Nhyira nka <char style="nd">Awurade</char> Nyankopɔn, Israel Nyankopɔn!</para>
  <para style="q2" vid="PSA 72:18">Ɔno nko ara na ɔyɛ anwonwade.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Nhyira nka ne din a anuonyam ahyɛ no ma no daa daa.</para>
  <para style="q2" vid="PSA 72:19">Ma nʼanuonyam nhyɛ wiase nyinaa ma.</para>
  <para style="qc" vid="PSA 72:19">Amen! Amen!<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Yisai ba Dawid mpaebɔ no awiei ni.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">NHOMA A ƐTO SO ABIƐSA</para>
  <para style="mr">
    <ref loc="PSA 73-89">Nnwom 73–89</ref></para>
  <para style="cl">Dwom 73</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>Ampa ara Onyankopɔn ye ma Israel,</para>
  <para style="q2" vid="PSA 73:1">oye ma wɔn a wɔn koma mu tew.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Nanso me de, anka me nan reyɛ awatiri;</para>
  <para style="q2" vid="PSA 73:2">anka merehwere me nnyinaso,<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>efisɛ mʼani beree ahantanfo</para>
  <para style="q2" vid="PSA 73:3">bere a mihuu amumɔyɛfo yiyedi no.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Wonni aperepere;</para>
  <para style="q2" vid="PSA 73:4">na wɔwɔ ahoɔden ne apɔwmuden.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Dadwen a ɛtaa ba nnipa so biara nna wɔn so;</para>
  <para style="q2" vid="PSA 73:5">ɔdesani haw biara nna wɔn so.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Enti ahantan yɛ wɔn kɔnmuade,</para>
  <para style="q2" vid="PSA 73:6">na wofura akakabensɛm.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Wɔn koma a apirim no mu na nnebɔne fi;</para>
  <para style="q2" vid="PSA 73:7">na wɔn amumɔyɛ adwene nni awiei.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Wɔserew afoforo na wɔka wɔn ho nsɛm a enye;</para>
  <para style="q2" vid="PSA 73:8">wɔde nhyɛso hunahuna afoforo wɔ ahomaso mu.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Wɔn ano ka ɔsoro nsɛm,</para>
  <para style="q2" vid="PSA 73:9">na wɔn tɛkrɛma agye asase afa.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Ɛno nti wɔn nkurɔfo kɔ wɔn nkyɛn</para>
  <para style="q2" vid="PSA 73:10">na wonya nsu nom ma ebu so.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Wobisa se, “Ɛbɛyɛ dɛn na Onyankopɔn ahu?</para>
  <para style="q2" vid="PSA 73:11">Na Ɔsorosoroni no wɔ nhumu ana?”<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Sɛɛ na amumɔyɛfo no te,</para>
  <para style="q2" vid="PSA 73:12">hwee mfa wɔn ho, na wɔkɔ so pɛ ahonyade.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Ampa ara, mannya hwee amfi me komamtew mu;</para>
  <para style="q2" vid="PSA 73:13">me nsa a enni fɔ no ayɛ ɔkwa.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Da mu nyinaa mihu amane;</para>
  <para style="q2" vid="PSA 73:14">anɔpa biara wɔtwe mʼaso.<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Sɛ mekae se, “Mɛkasa saa” a,</para>
  <para style="q2" vid="PSA 73:15">anka midii wo mma no huammɔ.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Mebɔɔ mmɔden sɛ mɛte eyinom nyinaa ase,</para>
  <para style="q2" vid="PSA 73:16">nanso na ɛhyɛ me so<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>kosii sɛ mekɔɔ Onyankopɔn kronkronbea hɔ;</para>
  <para style="q2" vid="PSA 73:17">ɛhɔ na metee nea awiei no ɛbɛba wɔn so no ase.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Ampa ara wode wɔn gu faako a hɔ yɛ toro</para>
  <para style="q2" vid="PSA 73:18">wode wɔn hwe fam sɛe wɔn pasaa.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Sɛnea wɔsɛe prɛko pɛ,</para>
  <para style="q2" vid="PSA 73:19">na ehu hwim wɔn kɔ no.<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>Ɛte sɛ adaeso, bere a onipa anyan,</para>
  <para style="q2" vid="PSA 73:20">
    <char style="nd">Awurade</char>, sɛ wokanyan wo ho a,</para>
  <para style="q2" vid="PSA 73:20">wubebu wʼani agu wɔn so sɛ biribi a enni hɔ.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Bere a awerɛhow hyɛɛ me koma mu</para>
  <para style="q2" vid="PSA 73:21">na me honhom dii yaw no,<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>meyɛɛ sɛ obi a onnim hwee na onni adwene;</para>
  <para style="q2" vid="PSA 73:22">meyɛɛ sɛ aboa gyimfo wɔ wʼanim.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Nanso na me ne wo wɔ hɔ bere biara;</para>
  <para style="q2" vid="PSA 73:23">na wode wo nsa nifa aso me mu.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Wode wʼafotu kyerɛ me kwan;</para>
  <para style="q2" vid="PSA 73:24">na akyiri no, wode me bɛkɔ anuonyam mu.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>Hena na mewɔ wɔ ɔsoro ka wo ho?</para>
  <para style="q2" vid="PSA 73:25">Na biribiara nni asase so a mepɛ ka wo ho.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Me honam, ne me koma bedi me huammɔ,</para>
  <para style="q2" vid="PSA 73:26">nanso Onyankopɔn ne me koma ahoɔden</para>
  <para style="q2" vid="PSA 73:26">ne me kyɛfa daa nyinaa.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Wɔn a wɔmmɛn wo no bɛyera.</para>
  <para style="q2" vid="PSA 73:27">Wosɛe wɔn a wonni wo nokware nyinaa.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Nanso me de, minim sɛ eye sɛ wobɛbɛn Onyankopɔn.</para>
  <para style="q2" vid="PSA 73:28">Mede Otumfo <char style="nd">Awurade</char> ayɛ me guankɔbea;</para>
  <para style="q2" vid="PSA 73:28">mɛka wo nneyɛe nyinaa akyerɛ.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">Dwom 74</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>Ao, Onyankopɔn, adɛn nti na woapo yɛn koraa yi?</para>
  <para style="q2" vid="PSA 74:1">Adɛn nti na wʼabufuw hyew wʼadidibea nguan?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Kae nkurɔfo a wotɔɔ wɔn teteete no,</para>
  <para style="q2" vid="PSA 74:2">abusua a ɛyɛ wʼagyapade a wugyee wɔn no,</para>
  <para style="q2" vid="PSA 74:2">Bepɔw Sion, faako a wote hɔ.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Dan wʼanammɔntu kyerɛ saa nnwiriwii a ɛto ntwa da yi,</para>
  <para style="q2" vid="PSA 74:3">ɔtamfo no de saa ɔsɛe yi nyinaa aba wo kronkronbea no so.<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Wʼatamfo bobɔɔ mu wɔ faako a wuhyiaa yɛn no;</para>
  <para style="q2" vid="PSA 74:4">wɔasisi wɔn mfrankaa sɛ agyiraehyɛde wɔ hɔ.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Wɔyɛɛ wɔn sɛ nnipa a wɔrehwim mmonnua</para>
  <para style="q2" vid="PSA 74:5">de abubu nnua a ayɛ nkyɛkyerɛ.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Wɔde wɔn mmonnua ne nname</para>
  <para style="q2" vid="PSA 74:6">bubuu nnua a wɔasen adi ho adwinni no.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Wɔhyew wo kronkronbea no dwerɛbee;</para>
  <para style="q2" vid="PSA 74:7">woguu faako a wo Din te no ho fi.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Wɔkaa wɔ wɔn koma mu se, “Yebetiatia wɔn so ayɛ wɔn pasaa!”</para>
  <para style="q2" vid="PSA 74:8">Wɔhyew baabiara a wɔsom Onyankopɔn wɔ asase no so.<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>Wɔmmaa yɛn nsɛnkyerɛnne a ɛyɛ nwonwa biara;</para>
  <para style="q2" vid="PSA 74:9">adiyifo no asa,</para>
  <para style="q2" vid="PSA 74:9">na yɛn mu biara nnim nna dodow a ebedi.<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>Onyankopɔn, wʼatamfo bɛserew wo akosi da bɛn?</para>
  <para style="q2" vid="PSA 74:10">Wɔn a wokyi wo no begu wo din ho fi daa ana?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Adɛn nti na woatwe wo nsa, wo nsa nifa no?</para>
  <para style="q2" vid="PSA 74:11">Yi fi wʼatade mmobɔwee no mu na sɛe wɔn.<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Nanso Onyankopɔn yɛ me hene fi tete;</para>
  <para style="q2" vid="PSA 74:12">wode nkwagye ba asase so.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>Ɛyɛ wo na wode wo tumi paee po mu no;</para>
  <para style="q2" vid="PSA 74:13">wopɛtɛw nsu mu ɔwɔ no ti.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>Wopɛtɛw Lewiatan no ti</para>
  <para style="q2" vid="PSA 74:14">na wode no maa sare so abɔde sɛ wɔn aduan.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Wo na womaa nsuwa ne nsuti tuei;</para>
  <para style="q2" vid="PSA 74:15">na womaa nsubɔnten a ɛsen yoyowee.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Adekyee wɔ wo na adesae nso yɛ wo dea;</para>
  <para style="q2" vid="PSA 74:16">wode owia ne ɔsram sisii hɔ.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Ɛyɛ wo na wototoo asase so ahye nyinaa;</para>
  <para style="q2" vid="PSA 74:17">wobɔɔ ahohuru ne awɔw mmere.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>
    <char style="nd">Awurade</char>, kae sɛnea ɔtamfo no aserew wo,</para>
  <para style="q2" vid="PSA 74:18">sɛnea nkwaseafo agu wo din ho fi.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Mmfa wʼaborɔnoma nkwa mma nkekaboa;</para>
  <para style="q2" vid="PSA 74:19">mma wo werɛ mfi wo nkurɔfo a wɔrehu amane no nkwa afebɔɔ.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Ma wʼapam no ho nhia wo,</para>
  <para style="q2" vid="PSA 74:20">efisɛ akakabensɛm ahyɛ asase no so sum mu ma.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Mma wɔn a wɔhyɛ wɔn so no mmfa animguase nsan;</para>
  <para style="q2" vid="PSA 74:21">ma ahiafo ne mmɔborɔfo nkamfo wo din.<verse eid="PSA 74:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>Ao, Onyankopɔn, ma wo ho so na ka wo ara wʼasɛm;</para>
  <para style="q2" vid="PSA 74:22">kae sɛnea nkwaseafo serew wo da mu nyinaa.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Mmu wʼani ngu wɔn a wɔsɔre tia wo no nteɛteɛmu so,</para>
  <para style="q2" vid="PSA 74:23">wʼatamfo gyegyeegyeyɛ a ɛkɔ soro daa no.</para>
  <para style="d" vid="PSA 74:23">Wɔde ma dwonkyerɛfo no. Wɔnto no sɛnea wɔto “Nsɛe No” nne so.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">Dwom 75</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>Onyankopɔn, yɛda wo ase,</para>
  <para style="q2" vid="PSA 75:1">yɛda wo ase, efisɛ wo Din abɛn;</para>
  <para style="q2" vid="PSA 75:1">nnipa ka wʼanwonwade kyerɛ.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Woka se, “Me na mehyɛɛ bere a ɛsɛ no;</para>
  <para style="q2" vid="PSA 75:2">ɛyɛ me na mibu atɛntrenee.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Sɛ asase ne so nnipa nyinaa wosow a,</para>
  <para style="q2" vid="PSA 75:3">me na mema nʼafadum gyina hɔ pintinn.<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Meka kyerɛ ahantanfo se, ‘Monnhoahoa mo ho bio,’</para>
  <para style="q2" vid="PSA 75:4">na meka kyerɛ amumɔyɛfo nso se, ‘Mommma mo mmɛn so.<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>Mommma mo mmɛn so ntia ɔsoro;</para>
  <para style="q2" vid="PSA 75:5">mommfa animtiaabu nkasa.’ ”<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Obiara mmfi apuei anaa atɔe</para>
  <para style="q2" vid="PSA 75:6">anaa sare no so a obetumi ama obi so.<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>Ɛyɛ Onyankopɔn na obu atɛn:</para>
  <para style="q2" vid="PSA 75:7">Ɔbrɛ ɔbaako ase, na ɔma ɔfoforo so.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Kuruwa bi hyɛ <char style="nd">Awurade</char> nsam</para>
  <para style="q2" vid="PSA 75:8">nsa bi a etwa ahuru a wɔde nnuhuam afra ahyɛ no ma;</para>
  <para style="q1" vid="PSA 75:8">ohwie, na asase so amumɔyɛfo nyinaa</para>
  <para style="q2" vid="PSA 75:8">nom ma ɛka ase puw.<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Me de, mɛpae mu aka eyi daa daa;</para>
  <para style="q2" vid="PSA 75:9">mɛto ayeyi dwom ama Yakob Nyankopɔn.<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>Mebubu amumɔyɛfo nyinaa mmɛn,</para>
  <para style="q2" vid="PSA 75:10">na atreneefo mmɛn de, wɔbɛma so.</para>
  <para style="d" vid="PSA 75:10">Wɔde ma dwonkyerɛfo. Wɔde sanku na ɛto.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">Dwom 76</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>Onyankopɔn din ahyeta wɔ Yuda;</para>
  <para style="q2" vid="PSA 76:1">ne din so wɔ Israel.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Ne ntamadan si Salem,</para>
  <para style="q2" vid="PSA 76:2">ne tenabea wɔ Sion.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Ɛhɔ na obubuu mmemma a ɛpa gya,</para>
  <para style="q2" vid="PSA 76:3">nkatabo ne afoa, akode nyinaa mu.<verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Wo ho hann no hyerɛn,</para>
  <para style="q2" vid="PSA 76:4">na woso sen mmepɔw a mmoadoma ahyɛ mu ma no.<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Mmarima akokodurufo deda hɔ a wɔagye wɔn ho nneɛma,</para>
  <para style="q2" vid="PSA 76:5">wɔadeda awufo nna;</para>
  <para style="q1" vid="PSA 76:5">na akofo no mu baako mpo</para>
  <para style="q2" vid="PSA 76:5">ntumi mma ne nsa so.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Yakob Nyankopɔn, wokaa wɔn anim no</para>
  <para style="q2" vid="PSA 76:6">apɔnkɔ no ne nteaseɛnam no adeda dinn.<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>Wo nko ara na ɛsɛ sɛ wosuro wo.</para>
  <para style="q2" vid="PSA 76:7">Sɛ wo bo fuw a hena na obetumi agyina wʼanim?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Wubuu atɛn fii ɔsoro,</para>
  <para style="q2" vid="PSA 76:8">asase suroe, na ɛyɛɛ komm,<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>bere a wo, Onyankopɔn, sɔre buu atɛn,</para>
  <para style="q2" vid="PSA 76:9">de gyee amanehunufo wɔ asase no so no.<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Ampa ara wʼabufuwhyew a etia nnipa no de ayeyi brɛ wo,</para>
  <para style="q2" vid="PSA 76:10">na wɔn a wotumi gyina ano no nya kɔkɔbɔ.<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>Monhyɛ <char style="nd">Awurade</char> mo Nyankopɔn no bɔ na munni so;</para>
  <para style="q2" vid="PSA 76:11">momma nsase a atwa ne ho ahyia</para>
  <para style="q2" vid="PSA 76:11">mfa ayɛyɛde mmrɛ Ɔbaako a ɛsɛ sɛ wosuro no no.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>Ɔbrɛ sodifonom honhom ase;</para>
  <para style="q2" vid="PSA 76:12">na asase so ahemfo suro no.</para>
  <para style="d" vid="PSA 76:12">Wɔde ma dwonkyerɛfo. Wɔde ma Yedutun.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">Dwom 77</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>Misu mefrɛɛ Onyankopɔn srɛɛ mmoa;</para>
  <para style="q2" vid="PSA 77:1">misu mefrɛɛ no sɛ ontie me.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Bere a mewɔ ahohiahia mu no, mehwehwɛɛ Awurade;</para>
  <para style="q2" vid="PSA 77:2">metrɛw me nsa a ɛmpa abaw mu anadwo</para>
  <para style="q2" vid="PSA 77:2">na me kra ampene sɛ wɔbɛkyekye ne werɛ.<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>Onyankopɔn mekaee wo, na misii apini;</para>
  <para style="q2" vid="PSA 77:3">medwenee, na me honhom tɔɔ beraw.<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Woamma mʼani ankum;</para>
  <para style="q2" vid="PSA 77:4">amanehunu dodow nti, mantumi ankasa.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Medwenee nna a atwam no ho,</para>
  <para style="q2" vid="PSA 77:5">teteete mfe no ho;<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>mekaee me nnwom a na meto no anadwo.</para>
  <para style="q2" vid="PSA 77:6">Me koma dwenee ho na me honhom bisae se:<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“Enti, <char style="nd">Awurade</char> bɛpo yɛn daa?</para>
  <para style="q2" vid="PSA 77:7">Ɔrenhu yɛn mmɔbɔ bio ana?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Nʼadɔe a ɛnsa da atu ayera koraa ana?</para>
  <para style="q2" vid="PSA 77:8">Na ne bɔhyɛ no, amma mu koraa ana?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Onyankopɔn werɛ afi sɛ ɔbɛyɛ mmɔborɔhunufo ana?</para>
  <para style="q2" vid="PSA 77:9">Ɔde abufuw atwe nʼayamhyehye no asan ana?”<verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Afei misusuwii se, “Eyi de, mɛsrɛ:</para>
  <para style="q2" vid="PSA 77:10">mfe a Ɔsorosoroni no teɛɛ ne nsa nifa mu no.”<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Mɛkae nneɛma a <char style="nd">Awurade</char> ayɛ;</para>
  <para style="q2" vid="PSA 77:11">yiw, mɛkae wo tete anwonwade no.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Mɛdwene wo nnwuma nyinaa ho</para>
  <para style="q2" vid="PSA 77:12">na masusuw wo nneyɛe akɛse nyinaa ho.<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Onyankopɔn, wʼakwan yɛ kronkron.</para>
  <para style="q2" vid="PSA 77:13">Onyame bɛn na ɔso sɛ yɛn Nyankopɔn?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Wone Onyankopɔn a woyɛ anwonwade;</para>
  <para style="q2" vid="PSA 77:14">wokyerɛ wo tumi wɔ aman mu.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Wode wo tumi nsa no gyee wo nkurɔfo,</para>
  <para style="q2" vid="PSA 77:15">Yakob ne Yosef asefo no.<verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>Onyankopɔn, nsu no huu wo,</para>
  <para style="q2" vid="PSA 77:16">nsu no huu wo na wɔpopoe;</para>
  <para style="q2" vid="PSA 77:16">bun no mpo ho wosowee.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>Omununkum tɔɔ nsu,</para>
  <para style="q2" vid="PSA 77:17">aprannaa gyigyee wɔ ɔsoro;</para>
  <para style="q2" vid="PSA 77:17">na wo bɛmma paa gya dii akɔneaba.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Wʼaprannaa bobɔɔ mu wɔ mfɛtɛ no mu,</para>
  <para style="q2" vid="PSA 77:18">wʼanyinam hyerɛn wiase;</para>
  <para style="q2" vid="PSA 77:18">asase popoe, na ɛwosowee.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Wode wo kwan faa po mu,</para>
  <para style="q2" vid="PSA 77:19">wode faa nsu kɛse mu,</para>
  <para style="q2" vid="PSA 77:19">nanso wɔanhu wʼanammɔn.<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Wonam Mose ne Aaron abasa so,</para>
  <para style="q2" vid="PSA 77:20">dii wo nkurɔfo anim sɛ nguankuw.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">Dwom 78</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>Me nkurɔfo, muntie me nkyerɛkyerɛ;</para>
  <para style="q2" vid="PSA 78:1">monyɛ aso mma mʼanom nsɛm.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Mɛkasa wɔ abebu mu,</para>
  <para style="q2" vid="PSA 78:2">mɛka ahintasɛm, teteete nneɛma no,<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>nneɛma a yɛate na yɛahu;</para>
  <para style="q2" vid="PSA 78:3">nneɛma a yɛn agyanom aka ho asɛm akyerɛ yɛn.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Yɛremfa nkame wɔn mma;</para>
  <para style="q2" vid="PSA 78:4">yɛbɛka akyerɛ nkyirimma</para>
  <para style="q1" vid="PSA 78:4">
    <char style="nd">Awurade</char> nneyɛe a ɛfata nkamfo no,</para>
  <para style="q2" vid="PSA 78:4">ne tumi ne anwonwade a wayɛ no.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>Ɔyɛɛ ahyɛde maa Yakob</para>
  <para style="q2" vid="PSA 78:5">na ɔyɛɛ mmara wɔ Israel,</para>
  <para style="q1" vid="PSA 78:5">nea ɔhyɛɛ yɛn nenanom</para>
  <para style="q2" vid="PSA 78:5">sɛ wɔnkyerɛ wɔn mma,<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>sɛnea ɛbɛyɛ a nkyirimma besua,</para>
  <para style="q2" vid="PSA 78:6">mpo mmofra a wonnya nwoo wɔn,</para>
  <para style="q2" vid="PSA 78:6">na wɔn nso akyerɛkyerɛ wɔn mma.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>Afei wɔde wɔn ho bɛto Onyankopɔn so,</para>
  <para style="q2" vid="PSA 78:7">na wɔn werɛ remfi ne nneyɛe,</para>
  <para style="q2" vid="PSA 78:7">na wobedi nʼahyɛde so.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Wɔrenyɛ sɛ wɔn nenanom,</para>
  <para style="q2" vid="PSA 78:8">a na wɔyɛ asoɔdenfo ne atuatewfo,</para>
  <para style="q1" vid="PSA 78:8">wɔn a wonni Onyankopɔn nokware wɔ wɔn koma mu</para>
  <para style="q2" vid="PSA 78:8">na woyɛ honhom mu atorofo ma no no.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Ɛwɔ mu sɛ na Efraim mmarima kurakura agyan,</para>
  <para style="q2" vid="PSA 78:9">nanso ɔko da no woguanee;<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Wɔanni Onyankopɔn apam no so,</para>
  <para style="q2" vid="PSA 78:10">wɔampɛ sɛ wodi ne mmara no so.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Wɔn werɛ fii nea wayɛ,</para>
  <para style="q2" vid="PSA 78:11">anwonwade a wayɛ akyerɛ wɔn no.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>Ɔyɛɛ anwonwade wɔ wɔn nenanom anim,</para>
  <para style="q2" vid="PSA 78:12">wɔ Soan mantam a ɛwɔ Misraim asase so.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Ɔkyɛɛ po mu na ɔde wɔn faa mu.</para>
  <para style="q2" vid="PSA 78:13">Ɔmaa nsu no gyinaa sɛ afasu.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>Ɔde omununkum dii wɔn anim awia</para>
  <para style="q2" vid="PSA 78:14">na ɔde ogyatɛn dii wɔn anim anadwo nyinaa.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>Ɔpaee ɔbotan mu wɔ sare so,</para>
  <para style="q2" vid="PSA 78:15">na ɔmaa wɔn nsu a ɛdɔɔso sɛ po;<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Ɔmaa asuti fii abotan mu</para>
  <para style="q2" vid="PSA 78:16">na ɔmaa nsu sen sɛ nsubɔnten.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Nanso wɔkɔɔ so yɛɛ bɔne tiaa no,</para>
  <para style="q2" vid="PSA 78:17">wɔsɔre tiaa Ɔsorosoroni no wɔ sare no so.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Wɔhyɛɛ da kaa aduan a wɔpɛ,</para>
  <para style="q2" vid="PSA 78:18">de sɔɔ Onyankopɔn hwɛe.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Wɔkasa tiaa Onyankopɔn se,</para>
  <para style="q2" vid="PSA 78:19">“Onyankopɔn betumi ato pon wɔ sare so ana?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Ɔde ade bɔɔ ɔbotan mu no, nsu tue fii mu,</para>
  <para style="q2" vid="PSA 78:20">na nsuwa sen buu so.</para>
  <para style="q1" vid="PSA 78:20">Na obetumi ama yɛn aduan nso?</para>
  <para style="q2" vid="PSA 78:20">Obetumi ama ne nkurɔfo nam ana?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Bere a <char style="nd">Awurade</char> tee nea wɔreka no, ne bo fuw yiye;</para>
  <para style="q2" vid="PSA 78:21">ne gya beguu Yakob so,</para>
  <para style="q2" vid="PSA 78:21">na nʼabufuwhyew sɔre tiaa Israel,<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>efisɛ na wonni Onyankopɔn mu gyidi</para>
  <para style="q2" vid="PSA 78:22">anaasɛ ne nkwagye mu ahotoso.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Nanso ɔkasa kyerɛɛ ɔsoro wɔ ɔhyɛ so;</para>
  <para style="q2" vid="PSA 78:23">na obuee ɔsorosoro apon.<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>Ɔtɔɔ mana guu fam maa nnipa no sɛ wunni,</para>
  <para style="q2" vid="PSA 78:24">ɔmaa wɔn ɔsoro aduan.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Nnipa dii abɔfo aduan;</para>
  <para style="q2" vid="PSA 78:25">ɔmaa wɔn aduan a wobetumi adi nyinaa.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Ogyaa apuei mframa fi ɔsoro,</para>
  <para style="q2" vid="PSA 78:26">na ofi ne tumi mu bɔɔ atɔe mframa.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>Ɔtɔɔ nam sɛ mfutuma guu wɔn so,</para>
  <para style="q2" vid="PSA 78:27">nnomaa a wotu bebree sɛ mpoano nwea.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Ɔma wɔbaa fam kɔɔ wɔn atenae,</para>
  <para style="q2" vid="PSA 78:28">ne wɔn ntamadan ho nyinaa.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Wodidi maa aduan no boroo wɔn so</para>
  <para style="q2" vid="PSA 78:29">efisɛ ɔmaa wɔn nea wɔhwehwɛ.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Nanso ansa na wobefi aduan a wɔhwehwɛ no ho,</para>
  <para style="q2" vid="PSA 78:30">bere a ɛhyehyɛ wɔn anom mpo no,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>Onyankopɔn abufuw sɔree wɔn so;</para>
  <para style="q2" vid="PSA 78:31">okum ahoɔdenfo a wɔwɔ wɔn mu</para>
  <para style="q2" vid="PSA 78:31">twitwaa Israel mmerante gui.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>Eyinom nyinaa akyi, wɔkɔɔ so yɛɛ bɔne;</para>
  <para style="q2" vid="PSA 78:32">nʼanwonwade akyi no, wɔannye anni.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Enti otwaa wɔn nna so te sɛ ahuru</para>
  <para style="q2" vid="PSA 78:33">yɛɛ wɔn mfe awiei huhuuhu.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Bere biara a Onyankopɔn bekum wɔn no, wɔhwehwɛ no</para>
  <para style="q2" vid="PSA 78:34">na wɔpere wɔn ho san ba ne nkyɛn.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Wɔkaee sɛ Onyankopɔn yɛ wɔn botan,</para>
  <para style="q2" vid="PSA 78:35">sɛ Ɔsorosoro Nyankopɔn no yɛ wɔn Gyefo.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Nanso wɔde wɔn ano bɛdaadaa no,</para>
  <para style="q2" vid="PSA 78:36">na wɔde wɔn tɛkrɛma atwa atoro akyerɛ no;<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>wɔn koma nni no nokware,</para>
  <para style="q2" vid="PSA 78:37">na wonni nʼapam no so.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Nanso na ɔyɛ ahummɔbɔ;</para>
  <para style="q2" vid="PSA 78:38">ɔde wɔn amumɔyɛ kyɛɛ wɔn</para>
  <para style="q2" vid="PSA 78:38">a wansɛe wɔn.</para>
  <para style="q1" vid="PSA 78:38">Mpɛn pii, ɔtwentwɛn nʼabufuw so</para>
  <para style="q2" vid="PSA 78:38">na wanhwie nʼabufuwhyew nyinaa.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Ɔkaee sɛ wɔyɛ ɔhonam ara kwa,</para>
  <para style="q2" vid="PSA 78:39">mframa bi a ɛbɔ twa mu na ɛnsan nʼakyi.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Mpɛn ahe na wɔansɔre antia no wɔ sare no so hɔ,</para>
  <para style="q2" vid="PSA 78:40">na mpɛn ahe na wɔamma ne werɛ anhow wɔ asase wosee no so!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Wɔsɔɔ Onyankopɔn hwɛɛ bere biara;</para>
  <para style="q2" vid="PSA 78:41">na woyii Israel Ɔkronkronni no abufuw.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Wɔn werɛ fii ne tumi no,</para>
  <para style="q2" vid="PSA 78:42">da a ogyee wɔn fii wɔn nhyɛsofo nsam no,<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>da a ɔyɛɛ nsɛnkyerɛnne nwonwaso wɔ Misraim no</para>
  <para style="q2" vid="PSA 78:43">ne nʼanwonwade wɔ Soan mantam mu no.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>Ɔmaa wɔn nsubɔnten dan mogya;</para>
  <para style="q2" vid="PSA 78:44">wɔantumi annom wɔn nsuten mu nsu.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Ɔmaa nwansenadɔm baa wɔn so bɛhaw wɔn</para>
  <para style="q2" vid="PSA 78:45">na mpɔtorɔ nso bɛsɛee wɔn asase.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Ɔmaa tɛwtɛw bedii wɔn mfuw so aduan</para>
  <para style="q2" vid="PSA 78:46">na ɔde wɔn nnɔbae nso maa mmoadabi.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Ɔde mparuwbo sɛee wɔn bobe</para>
  <para style="q2" vid="PSA 78:47">na ɔde sukyerɛmma sɛee wɔn ankye nnua.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Ɔde sukyerɛmma kum wɔn anantwi</para>
  <para style="q2" vid="PSA 78:48">ɔde anyinam kum wɔn nyɛmmoa.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Ohwiee nʼabufuwhyew guu wɔn so,</para>
  <para style="q2" vid="PSA 78:49">abufuw, anibere ne ɔtan;</para>
  <para style="q2" vid="PSA 78:49">abɔfo asɛefo kuw no.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Ɔbɔɔ kwan maa nʼabufuw;</para>
  <para style="q2" vid="PSA 78:50">na wamfa wɔn nkwa ankyɛ wɔn,</para>
  <para style="q2" vid="PSA 78:50">mmom, ɔde wɔn maa ɔyaredɔm.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Okunkum Misraimfo mmakan nyinaa,</para>
  <para style="q2" vid="PSA 78:51">Ham ntamadan mu nnipa mu abakan.<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>Nanso oyii ne nkurɔfo fii mu sɛ nguankuw;</para>
  <para style="q2" vid="PSA 78:52">odii wɔn anim sɛ nguan wɔ sare no so.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>Odii wɔn anim dwoodwoo, enti wɔansuro;</para>
  <para style="q2" vid="PSA 78:53">nanso wɔn atamfo de, po asorɔkye bu faa wɔn so.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>Sɛɛ na ɔyɛ de wɔn baa nʼasase kronkron no ahye so,</para>
  <para style="q2" vid="PSA 78:54">bepɔw asase a ɔde ne nsa nifa gyee no.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>Ɔpam amanaman a wɔwɔ wɔn anim no</para>
  <para style="q2" vid="PSA 78:55">na ɔkyekyɛɛ wɔn nsase no mu maa wɔn sɛ wɔn agyapade;</para>
  <para style="q2" vid="PSA 78:55">ɔbɔɔ Israel mmusuakuw no atenase wɔ wɔn afi mu.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Nanso wɔsɔɔ Onyankopɔn hwɛe,</para>
  <para style="q2" vid="PSA 78:56">na wɔsɔre tiaa Ɔsorosoroni no;</para>
  <para style="q2" vid="PSA 78:56">na wɔanni ne mmara so.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>Wɔyɛɛ sɛ wɔn agyanom, wɔanni nokware na wɔannya gyidi,</para>
  <para style="q2" vid="PSA 78:57">ahotoso nni wɔn mu na wɔte sɛ agyan a asɛe.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Wɔde wɔn sorɔnsorɔmmea hyɛɛ no abufuw</para>
  <para style="q2" vid="PSA 78:58">na wɔn ahoni maa ne ninkutwe mu yɛɛ den.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Onyankopɔn tee wɔn nka no, ne bo fuwii;</para>
  <para style="q2" vid="PSA 78:59">na ɔpoo Israel korakora.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Ogyaw nʼatenae a ɛwɔ Silo no,</para>
  <para style="q2" vid="PSA 78:60">ntamadan a wasi wɔ nnipa mu no.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Ɔde Apam Adaka a ɛyɛ ne tumi no kɔɔ nnommum mu,</para>
  <para style="q2" vid="PSA 78:61">nʼanuonyam kɔɔ atamfo nsam.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>Ɔde ne nkurɔfo maa afoa;</para>
  <para style="q2" vid="PSA 78:62">ne bo fuw nʼagyapade yiye.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Ogya hyew wɔn mmerante kum wɔn,</para>
  <para style="q2" vid="PSA 78:63">na wɔn mmabaa annya ayeforohyia dwom anto;<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>Wɔn asɔfo wuwuu afoa ano,</para>
  <para style="q2" vid="PSA 78:64">na wɔn akunafo antumi ansu.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Afei Awurade sɔree sɛnea ofi nna mu no,</para>
  <para style="q2" vid="PSA 78:65">sɛnea ɔbarima a wabow nsa nyan fi nnahɔɔ mu no.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>Ɔbobɔɔ nʼatamfo ma woguan kɔɔ wɔn akyi;</para>
  <para style="q2" vid="PSA 78:66">ɔhyɛɛ wɔn aniwu afebɔɔ.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Afei ɔpoo Yosef ntamadan no,</para>
  <para style="q2" vid="PSA 78:67">na wamfa Efraim abusuakuw no nso;<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>Na mmom, ɔfaa Yuda abusuakuw no,</para>
  <para style="q2" vid="PSA 78:68">Bepɔw Sion a ɔdɔ no no.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Osii ne kronkronbea te sɛ sorɔnsorɔmmea,</para>
  <para style="q2" vid="PSA 78:69">te sɛ asase a etim hɔ daa.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Oyii ne somfo Dawid,</para>
  <para style="q2" vid="PSA 78:70">ɔfrɛɛ no fii nguannan mu;<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>fii nguan akyi na ɔde no bae</para>
  <para style="q2" vid="PSA 78:71">se ɔmmɛyɛ oguanhwɛfo mma ne nkurɔfo Yakob,</para>
  <para style="q2" vid="PSA 78:71">mma Israel a wɔyɛ nʼagyapade.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Na Dawid de koma pa hwɛɛ wɔn so</para>
  <para style="q2" vid="PSA 78:72">na ɔde ne nimdeɛ dii wɔn anim.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">Dwom 79</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>Ao Onyankopɔn, amanaman no atow ahyɛ wʼagyapade so;</para>
  <para style="q2" vid="PSA 79:1">wɔagu wʼasɔredan kronkron no ho fi,</para>
  <para style="q2" vid="PSA 79:1">wɔama Yerusalem adan nnwiriwii.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Wɔde wʼasomfo afunu ayɛ aduan</para>
  <para style="q2" vid="PSA 79:2">ama wim nnomaa,</para>
  <para style="q1" vid="PSA 79:2">na wɔde wʼahotefo nam ama asase so mmoa.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Wɔahwie mogya agu te sɛ nsu</para>
  <para style="q2" vid="PSA 79:3">wɔ Yerusalem ho nyinaa,</para>
  <para style="q2" vid="PSA 79:3">na obiara nni hɔ a obesie awufo no.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Yɛayɛ animtiaabude ama yɛn mfɛfo,</para>
  <para style="q2" vid="PSA 79:4">fɛwdi ne nsopa ama wɔn a wɔatwa yɛn ho ahyia.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>
    <char style="nd">Awurade</char>, enkosi da bɛn? Wo bo befuw afebɔɔ ana?</para>
  <para style="q2" vid="PSA 79:5">Wo ninkunu bɛdɛw sɛ ogya akosi da bɛn?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Hwie wʼabufuw gu amanaman</para>
  <para style="q2" vid="PSA 79:6">a wonnye wo nto mu no so,</para>
  <para style="q1" vid="PSA 79:6">ahenni a</para>
  <para style="q2" vid="PSA 79:6">wɔmmɔ wo din no;<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>efisɛ wɔakum Yakob</para>
  <para style="q2" vid="PSA 79:7">na wɔasɛe nʼatenae.<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Mfa yɛn agyanom bɔne so asotwe mma yɛn;</para>
  <para style="q2" vid="PSA 79:8">ma wo mmɔborɔhunu mmra yɛn so ntɛm,</para>
  <para style="q2" vid="PSA 79:8">na yɛwɔ ahohiahia mu.<verse eid="PSA 79:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>Onyankopɔn yɛn Agyenkwa, boa yɛn,</para>
  <para style="q2" vid="PSA 79:9">wo din no anuonyam nti;</para>
  <para style="q1" vid="PSA 79:9">gye yɛn na fa yɛn bɔne kyɛ yɛn</para>
  <para style="q2" vid="PSA 79:9">wo din nti.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Adɛn nti na ɛsɛ sɛ amanaman ka se,</para>
  <para style="q2" vid="PSA 79:10">“Wɔn Nyankopɔn wɔ he?”</para>
  <para style="q1" vid="PSA 79:10">Yɛn anim ha ara, ma wonhu wɔ amanaman mu sɛ</para>
  <para style="q2" vid="PSA 79:10">wotɔ wʼasomfo mogya a wɔahwie agu no so werɛ.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Ma nneduafo no apinisi nnu wʼanim;</para>
  <para style="q2" vid="PSA 79:11">fa wo basa ahoɔden no</para>
  <para style="q2" vid="PSA 79:11">kora wɔn a wɔabu wɔn kumfɔ no.<verse eid="PSA 79:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Awurade, ahohora a yɛn mfɛfo asum agu wo so no,</para>
  <para style="q2" vid="PSA 79:12">tua wɔn so ka mpɛn ason.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>Na yɛn a yɛyɛ wo nkurɔfo, wʼadidibea nguan no,</para>
  <para style="q2" vid="PSA 79:13">beyi wo ayɛ daa nyinaa;</para>
  <para style="q1" vid="PSA 79:13">efi awo ntoatoaso kosi awo ntoatoaso,</para>
  <para style="q2" vid="PSA 79:13">yɛbɛkɔ so aka wʼayeyi akyerɛ.</para>
  <para style="d" vid="PSA 79:13">Wɔde ma dwonkyerɛfo sɛ wɔnto no “Sonannim Edut” sanku nne so.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">Dwom 80</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>Israel guanhwɛfo, tie yɛn,</para>
  <para style="q2" vid="PSA 80:1">wo a wudii Yosef anim sɛnea wodi nguankuw anim;</para>
  <para style="q1" vid="PSA 80:1">wo a wote ahengua so wɔ kerubim ntam no, hyerɛn<verse eid="PSA 80:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 80:2"/>wɔ Efraim, Benyamin ne Manase anim.</para>
  <para style="q1" vid="PSA 80:2">Kanyan wo tumi;</para>
  <para style="q2" vid="PSA 80:2">bra begye yɛn nkwa.<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>Ao Onyankopɔn, gye yɛn bio;</para>
  <para style="q2" vid="PSA 80:3">ma wʼanim nhyerɛn yɛn so,</para>
  <para style="q2" vid="PSA 80:3">na wɔagye yɛn nkwa.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>Asafo <char style="nd">Awurade</char> Nyankopɔn,</para>
  <para style="q2" vid="PSA 80:4">wʼabufuw bɛdɛw akosi da bɛn,</para>
  <para style="q2" vid="PSA 80:4">wʼabufuw a etia wo nkurɔfo mpaebɔ no?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Wode nusu yɛɛ aduan maa wɔn dii;</para>
  <para style="q2" vid="PSA 80:5">wode nusu kuruwama maa wɔn nomee.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Wode yɛn ayɛ nea yɛn mfɛfo ko ho,</para>
  <para style="q2" vid="PSA 80:6">na yɛn atamfo serew yɛn.<verse eid="PSA 80:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>Asafo Nyankopɔn, gye yɛn bio;</para>
  <para style="q2" vid="PSA 80:7">ma wʼanim nhyerɛn wɔ yɛn so,</para>
  <para style="q2" vid="PSA 80:7">na wɔagye yɛn nkwa.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Wutuu bobe fi Misraim beduae;</para>
  <para style="q2" vid="PSA 80:8">wopam amanaman no na wuduae.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Wosiesiee asase no baabi maa no,</para>
  <para style="q2" vid="PSA 80:9">egyee ntin na ɛtrɛw asase no so.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Ne nwini kataa mmepɔw no so</para>
  <para style="q2" vid="PSA 80:10">ne mman kataa sida akɛse no so.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Ɛdennan trɛw kɔɔ Po no so,</para>
  <para style="q2" vid="PSA 80:11">na ɛfefɛw trɛw koduu Asubɔnten no ho.<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Adɛn nti na woabubu nʼafasu</para>
  <para style="q2" vid="PSA 80:12">ama wɔn a wotwa mu wɔ hɔ no tetew ne bobe aba no?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Kɔkɔte fi wuram bɛsɛe no pasaa</para>
  <para style="q2" vid="PSA 80:13">na mmoadoma a wɔwɔ sare so de yɛ wɔn aduan.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Asafo Nyankopɔn, san bra yɛn nkyɛn!</para>
  <para style="q2" vid="PSA 80:14">fi ɔsoro hɔ hwɛ na wubehu!</para>
  <para style="q1" vid="PSA 80:14">Hwɛ saa bobe yi so,<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>ntin a wo nsa nifa adua no,</para>
  <para style="q2" vid="PSA 80:15">ɔbabarima a woatetew no ama wo ho no.<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Wɔatwa wo bobe no ato fam, ato mu gya ama ahyew;</para>
  <para style="q2" vid="PSA 80:16">wʼanimka ma wo nkurɔfo ase tɔre.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Fa wo nsa kata ɔbarima a ɔwɔ wo nifa no so,</para>
  <para style="q2" vid="PSA 80:17">onipa ba a woatetew no ama wo ho no.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Afei yɛrentwe yɛn ho mfi wo nkyɛn;</para>
  <para style="q2" vid="PSA 80:18">kanyan yɛn, na yɛbɛbɔ wo din.<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>Asafo <char style="nd">Awurade</char> Nyankopɔn, gye yɛn bio,</para>
  <para style="q2" vid="PSA 80:19">na ma wʼanim nhyerɛn yɛn so,</para>
  <para style="q2" vid="PSA 80:19">na wɔagye yɛn nkwa.</para>
  <para style="d" vid="PSA 80:19">Wɔde ma dwonkyerɛfo sɛ wɔnto sɛ “gittit” sanku nne so.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">Dwom 81</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>Monto ahurusi dwom mma Onyankopɔn yɛn ahoɔden;</para>
  <para style="q2" vid="PSA 81:1">mommɔ ose mma Yakob Nyankopɔn no!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Momma nnwom no so na monwosow akasaa.</para>
  <para style="q1" vid="PSA 81:2">Mommɔ sanku ne bɛnta dɛdɛ no.<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Monhyɛn mmentia ɔsram foforo da no,</para>
  <para style="q2" vid="PSA 81:3">ne ne kurokumatwa mu, yɛn Aponto da no;<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Eyi yɛ Israelfo ahyɛde,</para>
  <para style="q2" vid="PSA 81:4">Yakob Nyankopɔn mmara.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>Otintimii sɛ nhyehyɛe maa Yosef</para>
  <para style="q2" vid="PSA 81:5">bere a ɔsɔre tiaa Misraim no,</para>
  <para style="q2" vid="PSA 81:5">faako a yɛtee kasa a yɛnte ase no.<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>Ɔka se, “Miyii adesoa no fii wɔn mmati so,</para>
  <para style="q2" vid="PSA 81:6">ne wɔn nsa fii kɛntɛn ho.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Mo ahohiahia mu mofrɛɛ me na migyee mo,</para>
  <para style="q2" vid="PSA 81:7">migyee mo so wɔ aprannaa mu;</para>
  <para style="q2" vid="PSA 81:7">mesɔɔ mo hwɛɛ wɔ Meriba nsu ho.<verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>“Me nkurɔfo, muntie me kɔkɔbɔ yi,</para>
  <para style="q2" vid="PSA 81:8">Israel, sɛ mubetie me a!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Ɛnsɛ sɛ munya anyame foforo bi wɔ mo mu;</para>
  <para style="q2" vid="PSA 81:9">ɛnsɛ sɛ mokotow ananafo anyame.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>Mene <char style="nd">Awurade</char>, mo Nyankopɔn a</para>
  <para style="q2" vid="PSA 81:10">miyii mo fii Misraim asase so no.</para>
  <para style="q2" vid="PSA 81:10">Mummue mo anom tɛtrɛɛ na mɛhyɛ mu ma.<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“Nanso me nkurɔfo rentie me;</para>
  <para style="q2" vid="PSA 81:11">Israel remmrɛ ne ho ase mma me.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>Enti migyaa wɔn maa wɔn komaden</para>
  <para style="q2" vid="PSA 81:12">sɛ wɔnyɛ nea wɔpɛ biara.<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“Sɛ me nkurɔfo tie me,</para>
  <para style="q2" vid="PSA 81:13">na Israel nantew mʼakwan so a,<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>anka medi wɔn atamfo so ama wɔn ntɛm</para>
  <para style="q2" vid="PSA 81:14">na mama me basa so atia wɔn a wokyi wɔn!<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>Wɔn a wɔtan <char style="nd">Awurade</char> no de osuro bɛkotow no,</para>
  <para style="q2" vid="PSA 81:15">na wɔn asotwe to rentwa da.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Nanso wɔde atoko mu atoko papa bɛma mo adi;</para>
  <para style="q2" vid="PSA 81:16">mede ɔbotan mu wo bɛma mo amee.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">Dwom 82</para>
  <para style="d">Asaf dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>Onyankopɔn di hene wɔ ɔsoro asafo mu;</para>
  <para style="q2" vid="PSA 82:1">obu atɛn wɔ “anyame” mu.<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“Wobɛbɔ wɔn a wɔnteɛ ho ban</para>
  <para style="q2" vid="PSA 82:2">na woayɛ nhwɛanim ama amumɔyɛfo akosi da bɛn?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>Monka mmɔborɔfo ne ayisaa asɛm mma wɔn;</para>
  <para style="q2" vid="PSA 82:3">mommɔ ahiafo ne wɔn a wɔhyɛ wɔn so yiyedi ho ban.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Munnye ɔbrɛfo ne ahiafo;</para>
  <para style="q2" vid="PSA 82:4">munnye wɔn mfi amumɔyɛfo nsam.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“Anyame no nnim de, na wɔnte hwee ase.</para>
  <para style="q2" vid="PSA 82:5">Wokyinkyin wɔ sum mu;</para>
  <para style="q2" vid="PSA 82:5">na asase fapem nyinaa wosow.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“Mekae se, ‘Moyɛ “anyame;”</para>
  <para style="q2" vid="PSA 82:6">mo nyinaa yɛ Ɔsorosoroni no mma.’<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>Nanso mubewuwu sɛ nnipa pɛ;</para>
  <para style="q2" vid="PSA 82:7">na moahwe ase sɛ ɔsodifo biara.”<verse eid="PSA 82:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>Ao Onyankopɔn, sɔre, bu wiase atɛn;</para>
  <para style="q2" vid="PSA 82:8">efisɛ amanaman nyinaa yɛ wo de.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">Dwom 83</para>
  <para style="d">Asaf Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>Ao, Onyankopɔn, ntena hɔ komm;</para>
  <para style="q2" vid="PSA 83:1">mmua wʼano, Ao, Onyankopɔn, keka wo ho.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Hwɛ sɛnea wʼatamfo keka wɔn ho fa,</para>
  <para style="q2" vid="PSA 83:2">na wɔn a wɔmpɛ wʼasɛm nso ama wɔn ti so.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Wɔde anifere repam atia wo nkurɔfo,</para>
  <para style="q2" vid="PSA 83:3">wɔrepam atia wɔn a wo koma da wɔn so no.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>Wɔka se, “Mommra na yɛnsɛe wɔn sɛ ɔman,</para>
  <para style="q2" vid="PSA 83:4">sɛnea wɔrenkae Israel din bio.”<verse eid="PSA 83:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Wɔde adwene koro bɔ pɔw;</para>
  <para style="q2" vid="PSA 83:5">na wɔpam tia wo,<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>Edom ntamadan ne Ismaelfo,</para>
  <para style="q2" vid="PSA 83:6">Moabfo ne Hagarfo,<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Gebalfo ne Amonfo ne Amalekfo,</para>
  <para style="q2" vid="PSA 83:7">Filistifo ne Tirofo.<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Asiria mpo akɔka wɔn ho</para>
  <para style="q2" vid="PSA 83:8">de wɔn ahoɔden akɔhyɛ Lot asefo de no mu den.<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Yɛ wɔn sɛnea woyɛɛ Midian,</para>
  <para style="q2" vid="PSA 83:9">sɛnea woyɛɛ Sisera ne Yabin wɔ asubɔnten Kison ho no,<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>wɔn a wɔsɛe wɔ En-Dor</para>
  <para style="q2" vid="PSA 83:10">na wɔdan nwura no.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Yɛ wɔn atitiriw sɛ Oreb ne Seeb,</para>
  <para style="q2" vid="PSA 83:11">ne wɔn mmapɔmma nyinaa sɛ Seba ne Salmuna,<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>a wɔkae se, “Momma yɛmfa</para>
  <para style="q2" vid="PSA 83:12">Onyankopɔn adidibea nsase no no.”<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>Me Nyankopɔn, yɛ wɔn sɛ mfɛtɛ mu mfutuma,</para>
  <para style="q2" vid="PSA 83:13">sɛ ntɛtɛ a mframa bɔ gu.<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>Sɛnea ogya hyew kwae,</para>
  <para style="q2" vid="PSA 83:14">na ogyatannaa so nkoko mu hyew no no,<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>saa ara na fa wʼahum taa wɔn</para>
  <para style="q2" vid="PSA 83:15">na fa wo mframa a ano yɛ den no hunahuna wɔn.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>Ma animguase nka wɔn,</para>
  <para style="q2" vid="PSA 83:16">na ama nnipa ahwehwɛ wo din akyi kwan, <char style="nd">Awurade</char>.<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Ma wɔn anim ngu ase na wonni yaw;</para>
  <para style="q2" vid="PSA 83:17">ma wonwuwu wɔ animguase mu.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Ma wonhu sɛ wo a wo din de <char style="nd">Awurade</char> no,</para>
  <para style="q2" vid="PSA 83:18">wo nko ara ne Ɔsorosoroni wɔ asase nyinaa so.</para>
  <para style="d" vid="PSA 83:18">Wɔde ma dwonkyerɛfo sɛ wɔnto no wɔ gittit sanku nne so.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">Dwom 84</para>
  <para style="d">Koramma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>
    <char style="nd">Awurade</char> Asafo,</para>
  <para style="q2" vid="PSA 84:1">wʼatenae hɔ yɛ ahomeka!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Me kra pere, mpo ɛtɔ beraw,</para>
  <para style="q2" vid="PSA 84:2">sɛ ɔbɛkɔ <char style="nd">Awurade</char> adiwo;</para>
  <para style="q1" vid="PSA 84:2">me koma ne me honam teɛ mu</para>
  <para style="q2" vid="PSA 84:2">frɛ Onyankopɔn teasefo.<verse eid="PSA 84:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Mpo akasanoma anya ofi,</para>
  <para style="q2" vid="PSA 84:3">na asomfena nso anwen ne berebuw,</para>
  <para style="q2" vid="PSA 84:3">faako a obesow ne mma</para>
  <para style="q1" vid="PSA 84:3">wɔ beae bi a ɛbɛn wʼafɔremuka,</para>
  <para style="q2" vid="PSA 84:3">
    <char style="nd">Awurade</char> Asafo, me Hene ne me Nyankopɔn.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Nhyira nka wɔn a wɔte wo fi;</para>
  <para style="q2" vid="PSA 84:4">na wɔkamfo wo din daa.<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Nhyira nka wɔn a wɔwɔ wo mu ahoɔden,</para>
  <para style="q2" vid="PSA 84:5">na wɔde wɔn koma fi akwantu ase kɔhwehwɛ wo.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Sɛ wɔfa Baka Bon no mu a</para>
  <para style="q2" vid="PSA 84:6">wɔma hɔ yɛ nsuwansuwa;</para>
  <para style="q2" vid="PSA 84:6">asusow bere nsu so taataa hɔ.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Wɔkɔ no ahoɔden so bere nyinaa,</para>
  <para style="q2" vid="PSA 84:7">kosi sɛ wɔn mu biara bepue Onyankopɔn anim wɔ Sion.<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Asafo <char style="nd">Awurade</char> Nyankopɔn, tie me mpaebɔ;</para>
  <para style="q2" vid="PSA 84:8">Yakob Nyankopɔn, yɛ aso ma me.<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>Ao, Onyankopɔn, hwɛ yɛn nkatabo;</para>
  <para style="q2" vid="PSA 84:9">fa ahummɔbɔ hwɛ nea woasra no ngo no.<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Wʼadiwo hɔ da koro tena</para>
  <para style="q2" vid="PSA 84:10">ye sen nnafua apem wɔ baabi foforo;</para>
  <para style="q1" vid="PSA 84:10">mepɛ sɛ mɛyɛ ɔponanohwɛfo wɔ Onyankopɔn fi</para>
  <para style="q2" vid="PSA 84:10">sen sɛ mɛtena amumɔyɛfo ntamadan mu.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>Efisɛ <char style="nd">Awurade</char> Nyankopɔn yɛ owia ne kyɛm;</para>
  <para style="q2" vid="PSA 84:11">
    <char style="nd">Awurade</char> hu mmɔbɔ na ɔhyɛ anuonyam;</para>
  <para style="q1" vid="PSA 84:11">ɔmmfa ade pa biara nkame</para>
  <para style="q2" vid="PSA 84:11">wɔn a wɔteɛ.<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 84:12">nhyira nka onipa a ɔde ne ho to wo so.</para>
  <para style="d" vid="PSA 84:12">Wɔde ma dwonkyerɛfo.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">Dwom 85</para>
  <para style="d">Koramma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>Wo <char style="nd">Awurade</char>, wodom wʼasase;</para>
  <para style="q2" vid="PSA 85:1">wode Yakob ahonyade san maa no.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Wode wo nkurɔfo bɔne kyɛɛ wɔn</para>
  <para style="q2" vid="PSA 85:2">na wokataa wɔn nnebɔne nyinaa so.<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Wode wʼabufuw nyinaa too nkyɛn</para>
  <para style="q2" vid="PSA 85:3">na wodan fii wʼabufuwhyew ho.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>San gye yɛn bio, Onyankopɔn, yɛn Gyefo,</para>
  <para style="q2" vid="PSA 85:4">na ma wʼani nnye yɛn ho.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Wo bo befuw yɛn akosi daa ana?</para>
  <para style="q2" vid="PSA 85:5">Wʼabufuw bɛtoa so akɔ awo ntoantoaso nyinaa so ana?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Worenhyɛ yɛn den bio,</para>
  <para style="q2" vid="PSA 85:6">na ama wo nkurɔfo asɛpɛw wɔn ho wɔ wo mu ana?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>
    <char style="nd">Awurade</char>, kyerɛ yɛn wo dɔ a ɛnsa da no,</para>
  <para style="q2" vid="PSA 85:7">na ma yɛn wo nkwagye no.<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Metie nea <char style="nd">Awurade</char> Nyankopɔn bɛka;</para>
  <para style="q2" vid="PSA 85:8">ɔde asomdwoe hyɛ ne nkurɔfo, ahotefo no bɔ,</para>
  <para style="q2" vid="PSA 85:8">enti ɛnsɛ sɛ wɔsan kɔ agyimisɛm ho.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Ampa ara, ne nkwagye bɛn wɔn a wosuro no,</para>
  <para style="q2" vid="PSA 85:9">na nʼanuonyam bɛtena yɛn asase so.<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Ɔdɔ ne nokwaredi behyia,</para>
  <para style="q2" vid="PSA 85:10">na trenee ne asomdwoe befew wɔn ho wɔn ho ano.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Nokwaredi bepue afi asase no so,</para>
  <para style="q2" vid="PSA 85:11">na trenee ahwɛ afi ɔsoro.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>
    <char style="nd">Awurade</char> bɛma yɛn nea eye ampa ara</para>
  <para style="q2" vid="PSA 85:12">na yɛn asase bɛma ne nnɔbae.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Trenee di nʼanim</para>
  <para style="q2" vid="PSA 85:13">siesie ɔkwan ma nʼanammɔntu.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">Dwom 86</para>
  <para style="d">Dawid mpaebɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>
    <char style="nd">Awurade</char>, tie me na gye me so,</para>
  <para style="q2" vid="PSA 86:1">efisɛ meyɛ ohiani ne mmɔborɔni.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Bɔ me nkwa ho ban, efisɛ mede me ho ama wo.</para>
  <para style="q2" vid="PSA 86:2">Wo ne me Nyankopɔn, gye wʼakoa a</para>
  <para style="q2" vid="PSA 86:2">ɔde ne ho to wo so.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>
    <char style="nd">Awurade</char>, hu me mmɔbɔ,</para>
  <para style="q2" vid="PSA 86:3">na misu frɛ wo daa nyinaa.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Ma wʼakoa ani nnye,</para>
  <para style="q2" vid="PSA 86:4">na wo <char style="nd">Awurade</char>, wo nkyɛn</para>
  <para style="q2" vid="PSA 86:4">na mema me kra so ba.<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>
    <char style="nd">Awurade</char>, wuye na wode bɔne kyɛ,</para>
  <para style="q2" vid="PSA 86:5">wowɔ ɔdɔ mmoroso ma wɔn a wosu frɛ wo nyinaa.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>
    <char style="nd">Awurade</char>, tie me mpaebɔ;</para>
  <para style="q2" vid="PSA 86:6">tie me mmɔborɔsu.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Mɛfrɛ wo mʼahohia da mu,</para>
  <para style="q2" vid="PSA 86:7">na wubegye me so.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>
    <char style="nd">Awurade</char>, onyame bi nni hɔ a ɔte sɛ wo;</para>
  <para style="q2" vid="PSA 86:8">na wɔn nnwuma biara nto wo de.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>
    <char style="nd">Awurade</char>, aman a woakyekyere nyinaa</para>
  <para style="q2" vid="PSA 86:9">bɛba abɛsom wo wɔ wʼanim;</para>
  <para style="q2" vid="PSA 86:9">wɔbɛba abɛhyɛ wo din anuonyam.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Woyɛ ɔkɛse na woyɛ anwonwa nnwuma;</para>
  <para style="q2" vid="PSA 86:10">wo nko ara ne Onyankopɔn.<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>
    <char style="nd">Awurade</char>, kyerɛ me wʼakwan,</para>
  <para style="q2" vid="PSA 86:11">na mɛnantew wo nokware mu;</para>
  <para style="q1" vid="PSA 86:11">ma memfa me koma nyinaa mma wo</para>
  <para style="q2" vid="PSA 86:11">na masuro wo din.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Mede me koma nyinaa meyi wo ayɛ, Awurade me Nyankopɔn</para>
  <para style="q2" vid="PSA 86:12">na mahyɛ wo din anuonyam daa nyinaa.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Efisɛ ɔdɔ a wode dɔ me no so;</para>
  <para style="q2" vid="PSA 86:13">woayi me afi owu amoa mu tɔnn.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>Ao, Onyankopɔn, ahomasofo atow ahyɛ me so;</para>
  <para style="q2" vid="PSA 86:14">basabasayɛfo kuw rehwehwɛ me akum me,</para>
  <para style="q2" vid="PSA 86:14">nnipa a wɔmmfa wo nyɛ hwee no.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>Nanso wo, <char style="nd">Awurade</char>, woyɛ mmɔborɔhunufo ne ɔdomfo Nyankopɔn,</para>
  <para style="q2" vid="PSA 86:15">wo bo kyɛ fuw, na wʼadɔe ne wo nokware dɔɔso.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Dan wʼani hwɛ me na dom me;</para>
  <para style="q2" vid="PSA 86:16">fa wʼahoɔden ma wʼakoa</para>
  <para style="q2" vid="PSA 86:16">na gye wʼafenaa babarima nkwa.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Ma me wo papayɛ ho nsɛnkyerɛnne,</para>
  <para style="q2" vid="PSA 86:17">na mʼatamfo nhu na wɔn anim ngu ase</para>
  <para style="q2" vid="PSA 86:17">na wo, <char style="nd">Awurade</char>, wo na woaboa me akyekye me werɛ.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">Dwom 87</para>
  <para style="d">Koramma dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>Wato ne fapem wɔ bepɔw kronkron no so;<verse eid="PSA 87:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 87:2"/>
    <char style="nd">Awurade</char> dɔ Sion apon no</para>
  <para style="q2" vid="PSA 87:2">sen Yakob atenae nyinaa.<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Wɔka wo ho anuonyamsɛm</para>
  <para style="q2" vid="PSA 87:3">Onyankopɔn kuropɔn:<verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“Mede Rahab ne Babilonia</para>
  <para style="q2" vid="PSA 87:4">bɛka wɔn a wɔyɛ osetie ma me no ho,</para>
  <para style="q1" vid="PSA 87:4">Filistia, Tiro ne Kus nso</para>
  <para style="q2" vid="PSA 87:4">na maka se, ‘Wɔwoo eyinom wɔ Sion.’ ”<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Ampa ara wɔbɛka afa Sion ho se,</para>
  <para style="q2" vid="PSA 87:5">“Wɔwoo oyi ne ɔno wɔ no mu,</para>
  <para style="q2" vid="PSA 87:5">na Ɔsorosoroni no ankasa de no betim hɔ.”<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>
    <char style="nd">Awurade</char> bɛkyerɛw wɔ nnipa dinkyerɛw nhoma no mu se,</para>
  <para style="q2" vid="PSA 87:6">“Wɔwoo oyi wɔ Sion.”<verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Na wɔbɛto dwom se,</para>
  <para style="q2" vid="PSA 87:7">“Me ntin nyinaa wɔ wo mu.”</para>
  <para style="d" vid="PSA 87:7">Kora mma dwom a wɔde ma dwonkyerɛfo sɛ wɔnto no “Mahalat Leannot” sanku so.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">Dwom 88</para>
  <para style="d">Esrahini Heman ɔhaw ne amanehunu dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>
    <char style="nd">Awurade</char>, woyɛ me nkwagye Nyankopɔn</para>
  <para style="q2" vid="PSA 88:1">misu wɔ wʼanim adekyee ne adesae.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Ma me mpaebɔ nnu wʼanim;</para>
  <para style="q2" vid="PSA 88:2">brɛ wʼaso ase tie me sufrɛ.<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Ɔhaw ahyɛ me kra ma</para>
  <para style="q2" vid="PSA 88:3">na me nkwa rebɛn owu.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Wɔkan me fra wɔn a wɔrekɔ ɔda mu no;</para>
  <para style="q2" vid="PSA 88:4">mete sɛ obi a onni ahoɔden.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Wɔayi me asi nkyɛn wɔ awufo mu,</para>
  <para style="q2" vid="PSA 88:5">te sɛ atɔfo a wɔdeda ɔda mu,</para>
  <para style="q1" vid="PSA 88:5">wɔn a wonkae wɔn bio,</para>
  <para style="q2" vid="PSA 88:5">na wonhwɛ wɔn bio.<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Woatow me akyene ɔda ase tɔnn,</para>
  <para style="q2" vid="PSA 88:6">wɔ sum kabii mu.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Wʼabufuwhyew ayɛ duru wɔ me so;</para>
  <para style="q2" vid="PSA 88:7">woama wʼasorɔkye nyinaa abu afa me so.<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Woafa me nnamfonom a wɔbɛn me afi me nkyɛn</para>
  <para style="q2" vid="PSA 88:8">woama me ho ayɛ wɔn ahi.</para>
  <para style="q1" vid="PSA 88:8">Woaka me ahyɛ mu na mintumi nguan;<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>awerɛhow ama mʼani so ayɛ kusuu.</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">
    <char style="nd">Awurade</char> misu frɛ wo da biara;</para>
  <para style="q2" vid="PSA 88:9">metrɛw me nsam kyerɛ wo.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Woyɛ anwonwade kyerɛ awufo ana?</para>
  <para style="q2" vid="PSA 88:10">Wɔn a wɔawuwu no sɔre kamfo wo ana?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Wɔka wʼadɔe ho asɛm wɔ ɔda mu,</para>
  <para style="q2" vid="PSA 88:11">anaasɛ wo nokware ho asɛm wɔ ɔsɛe kurom ana?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Wohu wʼanwonwade wɔ beae a hɔ aduru sum,</para>
  <para style="q2" vid="PSA 88:12">anaa wo trenee nnwuma no wɔ awerɛfiri asase so ana?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Nanso <char style="nd">Awurade</char>, misu frɛ wo sɛ boa me;</para>
  <para style="q2" vid="PSA 88:13">me mpaebɔ du wʼanim adekyee mu.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>Adɛn, <char style="nd">Awurade</char>, na wopo me</para>
  <para style="q2" vid="PSA 88:14">na wode wʼanim hintaw me?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Mahu amane fi me mmofraase na mabɛn owu;</para>
  <para style="q2" vid="PSA 88:15">wʼahunahuna ama mabrɛ na mapa abaw.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Wʼabufuwhyew abu afa me so;</para>
  <para style="q2" vid="PSA 88:16">wʼahunahuna asɛe me.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Daa nyinaa wotwa me ho hyia sɛ nsuyiri,</para>
  <para style="q2" vid="PSA 88:17">na wɔabu afa me so koraa.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Woafa me yɔnkonom ne mʼadɔfo afi me nkyɛn kɔ;</para>
  <para style="q2" vid="PSA 88:18">na sum ayɛ mʼadamfo a ɔbɛn me pɛɛ.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">Dwom 89</para>
  <para style="d">Esrahini Etan ɔhaw ne amanehunu dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>Mɛto <char style="nd">Awurade</char> adɔe ho dwom daa daa;</para>
  <para style="q2" vid="PSA 89:1">mede mʼano bɛda wo nokwaredi adi awo ntoatoaso nyinaa mu.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Mɛka se wʼadɔe no tim hɔ daa nyinaa,</para>
  <para style="q2" vid="PSA 89:2">na woatim wo nokwaredi wɔ ɔsoro hɔ ankasa.<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Wokae se, “Mene onipa a mayi no no ayɛ apam;</para>
  <para style="q2" vid="PSA 89:3">maka ntam akyerɛ me somfo Dawid.<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘Mɛma wʼase atim hɔ daa</para>
  <para style="q2" vid="PSA 89:4">na wʼahengua nso atim wɔ awo ntoantoaso nyinaa mu.’ ”<verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>
    <char style="nd">Awurade</char>, ɔsorosorofo kamfo wʼanwonwade,</para>
  <para style="q2" vid="PSA 89:5">na wo nokwaredi nso, wɔkamfo wɔ ahotefo asafo mu.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Na hena na ɔne wo <char style="nd">Awurade</char> sɛ wɔ ɔsoro hɔ?</para>
  <para style="q2" vid="PSA 89:6">Hena na ɔte sɛ <char style="nd">Awurade</char> wɔ ɔsoro abɔde mu?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Akronkronfo agyinatufo mu, wosuro Onyankopɔn;</para>
  <para style="q2" vid="PSA 89:7">wɔde osuro kɛse ma Onyankopɔn wɔ akronkronfo nhyiamu ase.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>Asafo <char style="nd">Awurade</char> Nyankopɔn, hena na ɔte sɛ wo?</para>
  <para style="q2" vid="PSA 89:8">Wo, <char style="nd">Awurade</char>, woyɛ ɔkɛse na wo nokwaredi atwa wo ho ahyia.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Wudi po a ɛworo no so;</para>
  <para style="q2" vid="PSA 89:9">nʼasorɔkye bobɔ kɔ soro a, wobrɛ no ase.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Wodwerɛw Rahab sɛ atɔfo no mu baako;</para>
  <para style="q2" vid="PSA 89:10">wode wo basa dennen no bɔɔ wʼatamfo pansamee.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Ɔsoro wɔ wo, na asase nso wɔ wo;</para>
  <para style="q2" vid="PSA 89:11">wiase ne nea ɛwɔ mu nyinaa wo na wufii ase.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Wobɔɔ atifi ne anafo.</para>
  <para style="q2" vid="PSA 89:12">Tabor ne Hermon de ahosɛpɛw to dwom ma wo din.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>Tumi ayɛ wo basa ma;</para>
  <para style="q2" vid="PSA 89:13">wo nsam wɔ ahoɔden, woama wo nsa nifa so.<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Wʼahengua no fapem yɛ trenee ne atɛntrenee;</para>
  <para style="q2" vid="PSA 89:14">adɔe ne nokwaredi di wʼanim.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Nhyira nka wɔn a wɔasua sɛnea wɔbɔ wo abodin,</para>
  <para style="q2" vid="PSA 89:15">wɔn a wɔnantew wʼanim hann no mu, <char style="nd">Awurade</char>.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Wogye wɔn ani wɔ wo din mu da mu nyinaa;</para>
  <para style="q2" vid="PSA 89:16">wodi ahurusi wɔ wo trenee mu.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Wone wɔn anuonyam ne ahoɔden,</para>
  <para style="q2" vid="PSA 89:17">na wʼadom nti yɛyɛ nkonimdifo.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Ampa ara, yɛn kyɛm wɔ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 89:18">na yɛn hene wɔ Israel Kronkronni no.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Da bi wokasaa wɔ anisoadehu mu,</para>
  <para style="q2" vid="PSA 89:19">kyerɛɛ wʼahotefo se,</para>
  <para style="q1" vid="PSA 89:19">“Madom ɔkofo bi ahoɔden;</para>
  <para style="q2" vid="PSA 89:19">mapagyaw aberante bi afi nnipa no mu.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Mahu Dawid, me somfo;</para>
  <para style="q2" vid="PSA 89:20">mede me ngo kronkron no asra no.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Me nsa bɛwowaw no;</para>
  <para style="q2" vid="PSA 89:21">ampa ara me basa bɛhyɛ no den.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Ɔtamfo biara renhyɛ no sɛ ontua tow;</para>
  <para style="q2" vid="PSA 89:22">omumɔyɛfo biara rentumi nhyɛ no so.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Mɛdwerɛw nʼatamfo wɔ nʼanim</para>
  <para style="q1" vid="PSA 89:23">na mabobɔ nʼahohiahiafo ahwe fam.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Me nokware adɔe bɛka ne ho,</para>
  <para style="q2" vid="PSA 89:24">na me din mu, wɔbɛma nʼabɛn so.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Mɛtrɛw nʼahye mu akosi po so,</para>
  <para style="q2" vid="PSA 89:25">na ɔde ne nsa nifa bɛto nsubɔnten so.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>Ɔbɛfrɛ me aka se, ‘Wone mʼagya,</para>
  <para style="q2" vid="PSA 89:26">me Nyankopɔn, me nkwagye botan.’<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Mɛyɛ no mʼabakan,</para>
  <para style="q2" vid="PSA 89:27">asase so ahene nyinaa no mu ɔkɛse.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Mɛma mʼadɔe a mewɔ ma no no atena hɔ daa,</para>
  <para style="q2" vid="PSA 89:28">na apam a me ne no ayɛ nso bɛtena hɔ daa.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Mɛma nʼase atim afebɔɔ,</para>
  <para style="q2" vid="PSA 89:29">nʼahengua nso betim hɔ akosi sɛ ɔsoro betwa mu.<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“Sɛ ne mmabarima po me mmara</para>
  <para style="q2" vid="PSA 89:30">na sɛ wɔanni mʼahyɛde so,<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>sɛ wobu mʼahyɛde so</para>
  <para style="q2" vid="PSA 89:31">na sɛ wɔanni me hyɛ nsɛm so a,<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>ɛno de mede abaa bɛtwe wɔn aso wɔ wɔn bɔne ho</para>
  <para style="q2" vid="PSA 89:32">na wɔn amumɔyɛ nso mede mmaatwa atwe wɔn aso;<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>Nanso merennyae mʼadɔe a meyɛ ma no no</para>
  <para style="q2" vid="PSA 89:33">na mɛkɔ so adi no nokware.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Meremmu mʼapam no so</para>
  <para style="q2" vid="PSA 89:34">na merensesa nea mede mʼano aka no.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Menam me din kronkron no so aka ntam prɛko,</para>
  <para style="q2" vid="PSA 89:35">na merentwa Dawid atoro da,<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>meremma nʼase ntɔre da</para>
  <para style="q2" vid="PSA 89:36">na nʼahengua nso betim wɔ mʼanim te sɛ owia;<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>ebetim hɔ daa te sɛ ɔsram,</para>
  <para style="q2" vid="PSA 89:37">ɔdanseni nokwafo a ɔwɔ wim no.”<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>Nanso woapo no, woapa nʼakyi,</para>
  <para style="q2" vid="PSA 89:38">wo bo afuw nea woasra no ngo no.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Woagu apam a wo ne wo somfo pamee no,</para>
  <para style="q2" vid="PSA 89:39">woagu nʼahenkyɛw ho fi wɔ mfutuma mu.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Woabubu nʼafasu nyinaa</para>
  <para style="q2" vid="PSA 89:40">ama nʼabandennen adan nnwiriwii.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Wɔn a wotwa mu wɔ hɔ nyinaa fow no fa;</para>
  <para style="q2" vid="PSA 89:41">na wayɛ aniwude ama ne mfɛfo.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Woama nʼatamfo nsa nifa so;</para>
  <para style="q2" vid="PSA 89:42">ama wɔn nyinaa di ahurusi.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Woama nʼafoa ayɛ ɔkwa,</para>
  <para style="q2" vid="PSA 89:43">na woannyina nʼakyi wɔ ɔko mu.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Wode nʼanuonyam aba awiei</para>
  <para style="q2" vid="PSA 89:44">na woatow nʼahengua akyene fam.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Woatwa ne mmerantebere nna so</para>
  <para style="q2" vid="PSA 89:45">na wode animguase nguguso akata no so.<verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>
    <char style="nd">Awurade</char>, enkosi da bɛn? Na wode wo ho behintaw?</para>
  <para style="q2" vid="PSA 89:46">Wʼabufuwhyew bɛkɔ so adɛw akosi da bɛn?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Kae sɛnea me nkwanna twa mu ntɛm so.</para>
  <para style="q2" vid="PSA 89:47">Efisɛ woabɔ yɛn nyinaa sɛ ade a etwa mu ntɛm so!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Hena na ɔbɛtena ase a ɔrenwu da?</para>
  <para style="q2" vid="PSA 89:48">Anaasɛ hena na obetumi agye ne ho afi owu tumi nsam?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>Awurade, ɛhe na wo tete adɔe kɛse no wɔ,</para>
  <para style="q2" vid="PSA 89:49">nea wufi wo nokwaredi mu de kaa ntam kyerɛɛ Dawid no?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Kae, Awurade, sɛnea wɔadi wo somfo ho fɛw</para>
  <para style="q2" vid="PSA 89:50">ne sɛnea manya koma ama amanaman no akutiabɔ,<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>
    <char style="nd">Awurade</char>, akutiabɔ a wʼatamfo de adi fɛw</para>
  <para style="q2" vid="PSA 89:51">de adi nea woasra no ngo no anammɔntu biara ho fɛw.<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Ayeyi nka <char style="nd">Awurade</char> daa!</para>
  <para style="qr" vid="PSA 89:52">Amen, Amen.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">NHOMA A ƐTO SO ANAN</para>
  <para style="mr">
    <ref loc="PSA 90-106">Nnwom 90–106</ref></para>
  <para style="cl">Dwom 90</para>
  <para style="d">Onyankopɔn nipa Mose mpaebɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>Awurade, wo na woayɛ yɛn tenabea</para>
  <para style="q2" vid="PSA 90:1">awo ntoatoaso nyinaa mu.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Ansa na wɔrebɛbɔ mmepɔw</para>
  <para style="q2" vid="PSA 90:2">anaasɛ worebɛda asase ne wiase adi no,</para>
  <para style="q2" vid="PSA 90:2">na woyɛ Onyankopɔn fi mmeresanten kosi mmeresanten.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Woma adesamma san dan mfutuma,</para>
  <para style="q2" vid="PSA 90:3">ka se, “Mo adesamma, monsan nkɔ mfutuma mu.”<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Mfirihyia apem yɛ wʼani so sɛ</para>
  <para style="q2" vid="PSA 90:4">da koro a abɛsen mprempren,</para>
  <para style="q2" vid="PSA 90:4">anaasɛ anadwo mu dɔnhwerew kakraa bi.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Wopra nnipa kɔ, wɔ owu nna mu;</para>
  <para style="q2" vid="PSA 90:5">wɔte sɛ sare a afefɛw anɔpa,<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>ɛfefɛw yɛ frɔmfrɔm anɔpa de,</para>
  <para style="q2" vid="PSA 90:6">nanso anwummere ɛwo na etwintwam.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Yɛresa wɔ wʼabufuw ano</para>
  <para style="q2" vid="PSA 90:7">na wʼanibere abɔ yɛn hu.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Wode yɛn amumɔyɛ asi wʼanim,</para>
  <para style="q2" vid="PSA 90:8">na yɛn kokoa mu bɔne da wʼanim hann no mu.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Yɛn nna nyinaa twa mu wɔ wʼabufuwhyew mu;</para>
  <para style="q2" vid="PSA 90:9">na yɛde awerɛhowdi na ewie yɛn mfe.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Yɛn nkwa nna si mfe aduɔson,</para>
  <para style="q2" vid="PSA 90:10">anaasɛ aduɔwɔtwe, sɛ yɛwɔ ahoɔden a;</para>
  <para style="q1" vid="PSA 90:10">na mu ahohoahoade yɛ ɔhaw ne awerɛhow,</para>
  <para style="q2" vid="PSA 90:10">na etwa mu ntɛmntɛm, na yetu kɔ.<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Sɛ anka yebehu sɛ wʼabufuw mu tumi te ɛ!</para>
  <para style="q2" vid="PSA 90:11">Wʼabufuwhyew kɛse te sɛnea wo ho suro te.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Ma yenhu yɛn nna kan sɛnea ɛte,</para>
  <para style="q2" vid="PSA 90:12">na yɛanya nyansa koma.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>Tɔ wo bo ase, <char style="nd">Awurade</char>, enkosi da bɛn?</para>
  <para style="q2" vid="PSA 90:13">Hu wʼasomfo mmɔbɔ.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Ma wʼadɔe a ɛnsa da no mmee yɛn adekyee mu,</para>
  <para style="q2" vid="PSA 90:14">na yɛde anigye ato dwom adi ahurusi yɛn nna nyinaa mu.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Ma yɛn ani nnye nna bebree sɛ nna dodow a wode yɛn kɔɔ amanehunu mu no,</para>
  <para style="q2" vid="PSA 90:15">sɛ mfirihyia dodow a yehuu ateetee no.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Ma wʼasomfo nhu wo nneyɛe</para>
  <para style="q2" vid="PSA 90:16">na wɔn mma nhu wʼanuonyam.<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Ma Awurade yɛn Nyankopɔn adom no ntena yɛn so;</para>
  <para style="q2" vid="PSA 90:17">na yɛn nsa ano adwuma nyɛ yiye mma yɛn;</para>
  <para style="q2" vid="PSA 90:17">yiw, ma yɛn nsa ano adwuma nyɛ yiye.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">Dwom 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>Nea ɔte Ɔsorosoroni no hintabea no biara</para>
  <para style="q2" vid="PSA 91:1">bɛhome wɔ Otumfo no nwini ase.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>Mese <char style="nd">Awurade</char> se, “Ɔyɛ me guankɔbea ne mʼabandennen,</para>
  <para style="q2" vid="PSA 91:2">me Nyankopɔn a mewɔ no mu ahotoso.”<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>Ampa ara, obegye wo afi firisumfo afiri</para>
  <para style="q2" vid="PSA 91:3">ne owuyare mu.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>Ɔde ne ntakra bɛkata wo so;</para>
  <para style="q2" vid="PSA 91:4">na ne ntaban ase na wubenya guankɔbea;</para>
  <para style="q2" vid="PSA 91:4">ne nokware bɛyɛ wo nkatabo ne wo kyɛm.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Worensuro ɔdasu mu ɔsɛe,</para>
  <para style="q2" vid="PSA 91:5">anaa bɛmma a etu awia,<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>anaa owuyare a ɛba sum mu,</para>
  <para style="q2" vid="PSA 91:6">anaa ɔyaredɔm a ɛsɛe ade wɔ owigyinae bere.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Apem bɛtotɔ wo nkyɛn mu,</para>
  <para style="q2" vid="PSA 91:7">na mpem du atotɔ wo nifa a,</para>
  <para style="q2" vid="PSA 91:7">wo de, ɛremmɛn wo.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Wʼaniwa nko ara na wode bɛhwɛ</para>
  <para style="q2" vid="PSA 91:8">na woahu nnebɔneyɛfo asotwe.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Sɛ woka se, “Awurade ne me guankɔbea,”</para>
  <para style="q2" vid="PSA 91:9">na wode Ɔsorosoroni no hɔ yɛ wo tenabea a,<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>ɔhaw biara remmunkam wo so,</para>
  <para style="q2" vid="PSA 91:10">na ɔsɛe biara remmɛn wo ntamadan.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>Efisɛ Onyankopɔn bɛsoma nʼabɔfo abɛbɔ wo ho ban</para>
  <para style="q2" vid="PSA 91:11">na wɔabɛwɛn wo wʼakwan nyinaa mu;<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>wɔde wɔn nsa bɛma wo so,</para>
  <para style="q2" vid="PSA 91:12">na wo nan ampem ɔbo.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Wubetiatia gyata ne aprammiri so,</para>
  <para style="q2" vid="PSA 91:13">wobɛnantew gyataforo ne ɔwɔ so.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>
    <char style="nd">Awurade</char> ka se, “Esiane sɛ ɔdɔ me nti, megye no;</para>
  <para style="q2" vid="PSA 91:14">mɛbɔ ne ho ban, efisɛ ogye me din to mu.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>Ɔbɛfrɛ me na megye ne so;</para>
  <para style="q2" vid="PSA 91:15">mɛka ne ho wɔ amanehunu mu,</para>
  <para style="q2" vid="PSA 91:15">megye no na mahyɛ no anuonyam.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Mɛma nkwa nna a ɛware amee no</para>
  <para style="q2" vid="PSA 91:16">na makyerɛ no me nkwagye.”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">Dwom 92</para>
  <para style="d">Dwom a wɔto no Homeda.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>Eye sɛ wɔkamfo wo <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 92:1">na wɔto dwom de hyɛ wo anuonyam, Ɔsorosoroni,<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>na wɔpae mu ka wʼadɔe anɔpa</para>
  <para style="q2" vid="PSA 92:2">ne wo nokware anadwo,<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>wɔ hama du sanku so</para>
  <para style="q2" vid="PSA 92:3">ne sankuten nnwom mu.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>
    <char style="nd">Awurade</char>, wo nneyɛe ma mʼani gye;</para>
  <para style="q2" vid="PSA 92:4">mede anigye to nnwom, wo nsa ano nnwuma nti.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>
    <char style="nd">Awurade</char>, wo nnwuma yɛ akɛse,</para>
  <para style="q2" vid="PSA 92:5">na wo nyansa mu dɔ!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Agyimifo nnim</para>
  <para style="q2" vid="PSA 92:6">na nkwaseafo nte ase,<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>amumɔyɛfo benyin sɛ sare</para>
  <para style="q2" vid="PSA 92:7">na abɔnefo bɛyɛ frɔmfrɔm de,</para>
  <para style="q1" vid="PSA 92:7">nanso wɔbɛsɛe wɔn pasaa.<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Na wo <char style="nd">Awurade</char>, wɔayɛ wo ɔkɛse afebɔɔ.<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>
    <char style="nd">Awurade</char>, ampa ara,</para>
  <para style="q2" vid="PSA 92:9">wʼatamfo bɛyera;</para>
  <para style="q2" vid="PSA 92:9">na wɔbɛhwete abɔnefo nyinaa.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Woama me ahoɔden te sɛ ɛko;</para>
  <para style="q2" vid="PSA 92:10">woahwie ngohuam papa agu me so.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Mahu mʼatamfo nkogu a wɔadi,</para>
  <para style="q2" vid="PSA 92:11">mate sɛnea mʼatamfo atirimɔdenfo aguan afi akono.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Atreneefo bɛyɛ frɔmfrɔm te sɛ abedua,</para>
  <para style="q2" vid="PSA 92:12">wobenyin sɛ Lebanon sida;<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>nea wɔadua wɔ <char style="nd">Awurade</char> fi,</para>
  <para style="q2" vid="PSA 92:13">wobenyin frɔmfrɔm wɔ yɛn Nyankopɔn adiwo hɔ.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Wɔbɛkɔ so asow aba, onyinkyɛ mu mpo,</para>
  <para style="q2" vid="PSA 92:14">wɔbɛyɛ frɔmfrɔm sɛ ahabammono,<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>de akyerɛ sɛ, “<char style="nd">Awurade</char> yɛ ɔtreneeni;</para>
  <para style="q2" vid="PSA 92:15">ɔyɛ me botan, na atirimɔdensɛm biara nni ne mu.”<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">Dwom 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>
    <char style="nd">Awurade</char> di hene, wɔde tumi ahentade ahyɛ no;</para>
  <para style="q2" vid="PSA 93:1">wɔde tumi ahentade ahyɛ <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 93:1">na wɔde ahoɔden ayɛ nʼakode.</para>
  <para style="q1" vid="PSA 93:1">Wɔde wiase atim hɔ pintinn;</para>
  <para style="q2" vid="PSA 93:1">na wɔrentumi ntutu.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Wʼahengua tim hɔ fi tete;</para>
  <para style="q2" vid="PSA 93:2">na wowɔ hɔ fi mmeresanten.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>
    <char style="nd">Awurade</char>, po ama wɔn ho so,</para>
  <para style="q2" vid="PSA 93:3">po ama wɔn nne so;</para>
  <para style="q2" vid="PSA 93:3">po ama wɔn asorɔkye a ɛbɔ dennen no so.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Nea ɔwɔ tumi sen nsu akɛse mmubomu,</para>
  <para style="q2" vid="PSA 93:4">nea ɔwɔ tumi sen po nworoso,</para>
  <para style="q2" vid="PSA 93:4">
    <char style="nd">Awurade</char> a ɔte ɔsoro no yɛ ɔkɛse.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>
    <char style="nd">Awurade</char>, wo nhyehyɛe gyina hɔ pintinn;</para>
  <para style="q2" vid="PSA 93:5">kronkronyɛ hyɛ wo fi anuonyam</para>
  <para style="q2" vid="PSA 93:5">daa nyinaa.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">Dwom 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>
    <char style="nd">Awurade</char>, Onyankopɔn a wotɔ were,</para>
  <para style="q2" vid="PSA 94:1">Onyankopɔn a wotɔ were, hyerɛn.<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Sɔre, asase so Temmufo,</para>
  <para style="q2" vid="PSA 94:2">tua ahantanfo ka sɛnea ɛfata wɔn.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>
    <char style="nd">Awurade</char>, enkosi da bɛn,</para>
  <para style="q2" vid="PSA 94:3">amumɔyɛfo nnye wɔn ani nkosi da bɛn?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Wɔkasa ahantan so;</para>
  <para style="q2" vid="PSA 94:4">ahohoahoa ahyɛ abɔnefo nyinaa ma.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>
    <char style="nd">Awurade</char>, wɔdwerɛw wo nkurɔfo;</para>
  <para style="q2" vid="PSA 94:5">wɔhyɛ wʼagyapade so.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Wokunkum akunafo ne ananafo;</para>
  <para style="q2" vid="PSA 94:6">na wodi ayisaa awu.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Wɔka se, “<char style="nd">Awurade</char> nhu,</para>
  <para style="q2" vid="PSA 94:7">Yakob Nyankopɔn ayi nʼani.”<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Monhwɛ yiye, mo agyimifo a mowɔ nnipa no mu;</para>
  <para style="q2" vid="PSA 94:8">nkwaseafo, da bɛn na mubehu nyansa?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Nea ɔbɔɔ aso no rente asɛm ana?</para>
  <para style="q2" vid="PSA 94:9">Nea ɔyɛɛ ani no renhu ade ana?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Nea ɔteɛteɛ aman so no rentwe aso ana?</para>
  <para style="q2" vid="PSA 94:10">Nea ɔkyerɛkyerɛ onipa no nnim nyansa ana?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>
    <char style="nd">Awurade</char> nim onipa nsusuwii;</para>
  <para style="q2" vid="PSA 94:11">onim sɛ enkosi hwee.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>
    <char style="nd">Awurade</char>, nhyira ne onipa a woteɛteɛ no so,</para>
  <para style="q2" vid="PSA 94:12">onipa a wokyerɛ no wo mmara no;<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>Woma ɔhome fi amanehunu nna mu,</para>
  <para style="q2" vid="PSA 94:13">kosi sɛ wobetu amoa ama amumɔyɛfo.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>
    <char style="nd">Awurade</char> rempo ne nkurɔfo;</para>
  <para style="q2" vid="PSA 94:14">na ɔrennyaw nʼagyapade hɔ da.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Atemmu begyina treneeyɛ so bio,</para>
  <para style="q2" vid="PSA 94:15">na wɔn a wɔn koma mu tew nyinaa bedi so.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Hena na ɔbɛsɔre atia amumɔyɛfo ama me?</para>
  <para style="q2" vid="PSA 94:16">Hena na ɔbɛsɔre atia abɔnefo ama me?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Sɛ <char style="nd">Awurade</char> ammoa me a,</para>
  <para style="q2" vid="PSA 94:17">anka mekɔɔ owu kommyɛ mu ntɛm so.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Bere a mekae se, “Me nan rewatiri” no,</para>
  <para style="q2" vid="PSA 94:18">
    <char style="nd">Awurade</char>, wo dɔ no soo me mu.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Bere a me dadwen dɔɔso no,</para>
  <para style="q2" vid="PSA 94:19">wʼawerɛkyekye maa me kra abotɔyam.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Ahengua a porɔwee ahyɛ no mma no ne wo wɔ ayɔnkofa ana?</para>
  <para style="q2" vid="PSA 94:20">Ahengua a ne hyɛ nsɛm de amanehunu na ɛba no?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Wɔka bɔ mu tia atreneefo</para>
  <para style="q2" vid="PSA 94:21">na wɔn a wodi bem no, wobu wɔn kumfɔ.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>Nanso <char style="nd">Awurade</char> yɛ mʼaban;</para>
  <para style="q2" vid="PSA 94:22">na me Nyankopɔn ayɛ ɔbotan a ne mu na minya ahintawee.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Obetua wɔn nnebɔne no so ka</para>
  <para style="q2" vid="PSA 94:23">na wɔn amumɔyɛ nti wasɛe wɔn;</para>
  <para style="q2" vid="PSA 94:23">
    <char style="nd">Awurade</char> yɛn Nyankopɔn bɛsɛe wɔn.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">Dwom 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>Mommra mma yɛnto dwom wɔ anigye so mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 95:1">momma yɛmmɔ ose mma yɛn nkwagye Botan no.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Momma yɛmfa aseda mmra nʼanim,</para>
  <para style="q2" vid="PSA 95:2">na yɛmfa ahosɛpɛw nnwom mma no so.<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Efisɛ <char style="nd">Awurade</char> yɛ Onyankopɔn kɛse,</para>
  <para style="q2" vid="PSA 95:3">ɔhenkɛse wɔ anyame nyinaa so.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Ne nsam na asase mu nneɛma nyinaa wɔ,</para>
  <para style="q2" vid="PSA 95:4">na mmepɔw mpampam wɔ no.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>Po wɔ no, ɔno na ɔbɔe,</para>
  <para style="q2" vid="PSA 95:5">na ne nsa na ɛnwenee asase kesee no.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Mommra, mma yɛnkotow nsom no.</para>
  <para style="q2" vid="PSA 95:6">Momma yemmu nkotodwe wɔ <char style="nd">Awurade</char> yɛn Yɛfo no anim!<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>Ɔyɛ yɛn Nyankopɔn;</para>
  <para style="q2" vid="PSA 95:7">yɛyɛ ne didibea nnipa,</para>
  <para style="q2" vid="PSA 95:7">ne nguankuw a ɔhwɛ wɔn so.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">Nnɛ, sɛ mote ne nne a,<verse eid="PSA 95:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 95:8"/>mummpirim mo koma sɛnea moyɛɛ wɔ Meriba no,</para>
  <para style="q2" vid="PSA 95:8">sɛnea moyɛɛ da no wɔ Masa, sare no so no,<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>Ɛhɔ no, mo mpanyimfo sɔɔ no hwɛe,</para>
  <para style="q2" vid="PSA 95:9">a na wonim nea meyɛ maa wɔn.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Me bo fuw saa nnipa no mfe aduanan</para>
  <para style="q2" vid="PSA 95:10">na mekae se, “Wɔyɛ nnipa a wɔn koma aman afi me ho,</para>
  <para style="q2" vid="PSA 95:10">na wɔanhu mʼakwan.”<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Ɛno nti mekaa ntam wɔ mʼabufuw mu se,</para>
  <para style="q2" vid="PSA 95:11">“Wɔrenhyɛn mʼahomegye mu da.”<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">Dwom 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>Monto dwom foforo mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 96:1">asase nyinaa monto dwom mma <char style="nd">Awurade</char>.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Monto dwom mma <char style="nd">Awurade</char>, monkamfo ne din;</para>
  <para style="q2" vid="PSA 96:2">mompae mu nka ne nkwagye no daa daa.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Monka nʼanuonyam wɔ amanaman mu,</para>
  <para style="q2" vid="PSA 96:3">monka nʼanwonwade a wayɛ wɔ nnipa mu.<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>
    <char style="nd">Awurade</char> yɛ ɔkɛse na nkamfo fata no;</para>
  <para style="q2" vid="PSA 96:4">ɛsɛ sɛ wosuro no sen anyame nyinaa.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Aman so anyame nyinaa yɛ ahoni bi kwa,</para>
  <para style="q2" vid="PSA 96:5">nanso <char style="nd">Awurade</char> na ɔbɔɔ ɔsoro.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Anuonyam ne kɛseyɛ wɔ nʼanim;</para>
  <para style="q2" vid="PSA 96:6">ahoɔden ne anuonyam wɔ ne kronkronbea hɔ.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>Momfa mma <char style="nd">Awurade</char>, amanaman mmusuakuw,</para>
  <para style="q2" vid="PSA 96:7">momfa anuonyam ne tumi mma <char style="nd">Awurade</char>.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Momfa anuonyam ne din a ɛfata mma <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 96:8">momfa afɔrebɔde nhyɛn nʼadiwo hɔ.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Monsɔre <char style="nd">Awurade</char> wɔ ne kronkronyɛ fɛfɛ mu;</para>
  <para style="q2" vid="PSA 96:9">asase nyinaa momma mo ho mpopo wɔ nʼanim.<verse eid="PSA 96:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Monka nkyerɛ aman nyinaa se, “<char style="nd">Awurade</char> di hene.”</para>
  <para style="q2" vid="PSA 96:10">Wɔabɔ asase atim hɔ pintinn, wɔrentumi ntutu;</para>
  <para style="q2" vid="PSA 96:10">ɔde pɛpɛyɛ bebu nnipa atɛn.<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Momma ɔsorosoro ani nnye, na asase nni ahurusi;</para>
  <para style="q2" vid="PSA 96:11">momma po ne mu nneɛma nyinaa nworo;<verse eid="PSA 96:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 96:12"/>Momma mfuw ne so nneɛma nyinaa mmɔ ose;</para>
  <para style="q1" vid="PSA 96:12">momma kwae mu nnua nyinaa mfa ahosɛpɛw nto nnwom.<verse eid="PSA 96:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 96:13"/>Momma abɔde nyinaa nni ahurusi wɔ <char style="nd">Awurade</char> anim, efisɛ ɔreba,</para>
  <para style="q2" vid="PSA 96:13">ɔreba abebu asase no atɛn.</para>
  <para style="q1" vid="PSA 96:13">Ɔde trenee bebu wiase atɛn</para>
  <para style="q2" vid="PSA 96:13">na woabu nnipa nso atɛn wɔ ne nokware mu.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">Dwom 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>
    <char style="nd">Awurade</char> di hene, ma asase ani nnye;</para>
  <para style="q2" vid="PSA 97:1">ma akyirikyiri mpoano ahorow no nsɛpɛw wɔn ho.<verse eid="PSA 97:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Omununkum ne sum kabii atwa no ho ahyia;</para>
  <para style="q2" vid="PSA 97:2">trenee ne atɛntrenee yɛ nʼahengua no fapem.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Ogya di nʼanim</para>
  <para style="q2" vid="PSA 97:3">na ɛhyew nʼatamfo wɔ afanan nyinaa.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Nʼanyinam hyerɛn wiase;</para>
  <para style="q2" vid="PSA 97:4">asase hu na ne ho popo.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Mmepɔw nan sɛ nku wɔ <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 97:5">
    <char style="nd">Awurade</char> a asase nyinaa wɔ no no anim.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Ɔsoro pae mu ka ne trenee kyerɛ</para>
  <para style="q2" vid="PSA 97:6">na aman nyinaa hu nʼanuonyam.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Ahonisomfo nyinaa anim agu ase,</para>
  <para style="q2" vid="PSA 97:7">wɔn a wɔde abosomhuhuw hoahoa wɔn ho no,</para>
  <para style="q2" vid="PSA 97:7">anyame nyinaa monsɔre no.<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Sion te, na ne ho sɛpɛw no</para>
  <para style="q2" vid="PSA 97:8">na Yuda nkuraa ani gye</para>
  <para style="q2" vid="PSA 97:8">
    <char style="nd">Awurade</char>, esiane wʼatɛntrenee nti.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Wo, <char style="nd">Awurade</char> ne Ɔsorosoroni wɔ asase so nyinaa;</para>
  <para style="q2" vid="PSA 97:9">wɔama wo so pa ara wɔ anyame nyinaa mu.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>Ma wɔn a wɔdɔ <char style="nd">Awurade</char> no nkyi bɔne,</para>
  <para style="q2" vid="PSA 97:10">ɔbɔ ne nkurɔfo a wɔyɛ nokwafo no ho ban</para>
  <para style="q2" vid="PSA 97:10">na ogye wɔn fi amumɔyɛfo nsam.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Hann hyerɛn wɔ atreneefo so</para>
  <para style="q2" vid="PSA 97:11">na anigye ba wɔn a wɔn koma mu tew no so.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Momma mo ani nnye <char style="nd">Awurade</char> mu, mo a moyɛ atreneefo,</para>
  <para style="q2" vid="PSA 97:12">na monkamfo ne din kronkron no.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">Dwom 98</para>
  <para style="d">Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>Monto dwom foforo mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 98:1">efisɛ wayɛ anwonwade bebree;</para>
  <para style="q1" vid="PSA 98:1">ne nsa nifa ne ne basa kronkron no</para>
  <para style="q2" vid="PSA 98:1">anya nkwagye ama no.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>
    <char style="nd">Awurade</char> ama wɔahu ne nkwagye</para>
  <para style="q2" vid="PSA 98:2">na wada ne trenee adi akyerɛ amanaman no.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>Wakae nʼadɔe</para>
  <para style="q2" vid="PSA 98:3">ne ne nokware a odi kyerɛɛ Israelfo no;</para>
  <para style="q1" vid="PSA 98:3">asase ano nyinaa ahu</para>
  <para style="q2" vid="PSA 98:3">yɛn Nyankopɔn nkwagye.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Asase nyinaa mommɔ ose mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 98:4">momfa nnwonto nni ahurusi;<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>Momfa sanku nto dwom mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 98:5">sanku ne nnwonto nnyigyei,<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>momfa torobɛnto ne adwennini mmɛn,</para>
  <para style="q2" vid="PSA 98:6">nteɛ mu ahosɛpɛw so wɔ <char style="nd">Awurade</char>, yɛn hene no anim.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Momma po ne abɔde a ɛwɔ mu nyinaa nhuru so;</para>
  <para style="q2" vid="PSA 98:7">asase ne wɔn a wɔte so nyinaa.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Momma nsubɔnten mmɔ wɔn nsam,</para>
  <para style="q2" vid="PSA 98:8">mmepɔw nka mmom nto ahurusi nnwom;<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>ma wɔnto nnwom wɔ <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 98:9">efisɛ ɔreba abebu wiase atɛn.</para>
  <para style="q1" vid="PSA 98:9">Ɔde trenee bebu wiase atɛn</para>
  <para style="q2" vid="PSA 98:9">na ɔde pɛpɛyɛ abu nnipa atɛn.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">Dwom 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>
    <char style="nd">Awurade</char> di hene,</para>
  <para style="q2" vid="PSA 99:1">momma amanaman no ho mpopo;</para>
  <para style="q1" vid="PSA 99:1">ɔte nʼahengua so wɔ kerubim ntam,</para>
  <para style="q2" vid="PSA 99:1">ma asase nwosow.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>
    <char style="nd">Awurade</char> a ɔwɔ Sion yɛ ɔkɛse;</para>
  <para style="q2" vid="PSA 99:2">wɔama no so wɔ amanaman nyinaa mu.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Ma wɔnkamfo wo din a ɛso na ɛyɛ nwonwa no,</para>
  <para style="q2" vid="PSA 99:3">ɔyɛ ɔkronkron.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Ɔhene no yɛ ɔkɛse, ɔdɔ atɛntrenee,</para>
  <para style="q2" vid="PSA 99:4">woama pɛpɛyɛ atim;</para>
  <para style="q1" vid="PSA 99:4">wayɛ nea eye na ɛteɛ</para>
  <para style="q2" vid="PSA 99:4">wɔ Yakob mu.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Momma <char style="nd">Awurade</char>, yɛn Nyankopɔn so</para>
  <para style="q2" vid="PSA 99:5">na monsɔre no wɔ ne nan ntiaso anim;</para>
  <para style="q2" vid="PSA 99:5">ɔyɛ ɔkronkron.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Na Mose ne Aaron ka nʼasɔfo no ho,</para>
  <para style="q2" vid="PSA 99:6">na Samuel ka wɔn a wɔbɔɔ ne din no ho;</para>
  <para style="q1" vid="PSA 99:6">wɔfrɛɛ <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 99:6">na ogyee wɔn so.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>Ofi omununkum dum mu kasa kyerɛɛ wɔn;</para>
  <para style="q2" vid="PSA 99:7">wodii mmara ne ahyɛde a ɔmaa wɔn no so.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>
    <char style="nd">Awurade</char>, yɛn Nyankopɔn,</para>
  <para style="q2" vid="PSA 99:8">wugyee wɔn so;</para>
  <para style="q1" vid="PSA 99:8">woyɛɛ bɔnefakyɛ Nyankopɔn maa Israel,</para>
  <para style="q2" vid="PSA 99:8">nanso wotwee wɔn aso wɔ wɔn nnebɔne ho.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Momma <char style="nd">Awurade</char> yɛn Nyankopɔn so</para>
  <para style="q2" vid="PSA 99:9">na monsɔre no wɔ ne bepɔw kronkron no so,</para>
  <para style="q2" vid="PSA 99:9">na <char style="nd">Awurade</char> yɛn Nyankopɔn yɛ ɔkronkron.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">Dwom 100</para>
  <para style="d">Ayeyi Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>Mommɔ ose mma <char style="nd">Awurade</char>, asase nyinaa.<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>Momfa ahosɛpɛw nsom <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 100:2">momfa anigye nnwom mmra nʼanim.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Munhu sɛ <char style="nd">Awurade</char> yɛ Onyankopɔn;</para>
  <para style="q2" vid="PSA 100:3">ɔno na ɔyɛɛ yɛn, na yɛyɛ ne de;</para>
  <para style="q2" vid="PSA 100:3">yɛyɛ ne nkurɔfo ne ne didibea nguan.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Momfa aseda nhyɛn nʼapon mu,</para>
  <para style="q2" vid="PSA 100:4">na momfa nkamfo nkɔ nʼadiwo;</para>
  <para style="q2" vid="PSA 100:4">momfa aseda mma no, na monkamfo ne din.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>
    <char style="nd">Awurade</char> ye; na nʼadɔe wɔ hɔ daa;</para>
  <para style="q2" vid="PSA 100:5">ne nokwaredi kodu awo ntoatoaso nyinaa so.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">Dwom 101</para>
  <para style="d">Dawid Dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>Mɛto wo dɔ ne wo trenee ho nnwom;</para>
  <para style="q2" vid="PSA 101:1">
    <char style="nd">Awurade</char>, mɛto ayeyi nnwom ama wo.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Mɛhwɛ yiye abu ɔbra a ho tew;</para>
  <para style="q2" vid="PSA 101:2">da bɛn na wobɛba me nkyɛn?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">Mede koma a afɔdi nni mu</para>
  <para style="q2" vid="PSA 101:2">bɛhwɛ me fi so.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Merennye ade a ɛyɛ tan</para>
  <para style="q2" vid="PSA 101:3">biara nto mu.</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">Mikyi nnipa a wonni gyidi nneyɛe;</para>
  <para style="q2" vid="PSA 101:3">meremfa me ho mmata ho.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Nnipa a wɔn koma yɛ kɔntɔnkye remmɛn me;</para>
  <para style="q2" vid="PSA 101:4">me ne bɔne nni hwee yɛ.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Obiara a odi ne yɔnko ho nseku wɔ kokoa mu no,</para>
  <para style="q2" vid="PSA 101:5">ɔno na mɛsɛe;</para>
  <para style="q1" vid="PSA 101:5">nea ɔwɔ ahantan ani ne ahomaso koma,</para>
  <para style="q2" vid="PSA 101:5">ɔno na merennyigye no so.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Mʼani bɛkɔ anokwafo a wɔwɔ asase no so no so</para>
  <para style="q2" vid="PSA 101:6">na me ne wɔn atena;</para>
  <para style="q1" vid="PSA 101:6">nea ne nantew ho nni asɛm no</para>
  <para style="q2" vid="PSA 101:6">ɔno na ɔbɛsom me.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Nea ɔyɛ ɔdaadaafo biara</para>
  <para style="q2" vid="PSA 101:7">rentena me fi;</para>
  <para style="q1" vid="PSA 101:7">nea otwa nkontompo no</para>
  <para style="q2" vid="PSA 101:7">rennyina mʼanim.<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Adekyee biara,</para>
  <para style="q2" vid="PSA 101:8">mɛsɛe amumɔyɛfo a wɔwɔ asase yi so nyinaa;</para>
  <para style="q1" vid="PSA 101:8">na mapam ɔdebɔneyɛni biara</para>
  <para style="q2" vid="PSA 101:8">afi <char style="nd">Awurade</char> kuropɔn mu.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">Dwom 102</para>
  <para style="d">Aberante mmɔborɔni mpaebɔ. Osu kyerɛ Awurade bere a ɔwɔ ahohia mu.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>
    <char style="nd">Awurade</char>, tie me mpaebɔ;</para>
  <para style="q2" vid="PSA 102:1">na ma me mmoa ho sufrɛ nnu wʼanim.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Mmfa wʼanim nhintaw me</para>
  <para style="q2" vid="PSA 102:2">bere a mewɔ ahohia mu.</para>
  <para style="q1" vid="PSA 102:2">Brɛ wʼaso ase ma me;</para>
  <para style="q2" vid="PSA 102:2">na sɛ misu frɛ wo a, gye me so ntɛm.<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Me nkwanna reyera te sɛ wusiw;</para>
  <para style="q2" vid="PSA 102:3">me nnompe adɔ sɛ nyansramma.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Me koma abotow na akisa sɛ sare;</para>
  <para style="q2" vid="PSA 102:4">na me kɔn nnɔ aduan.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Mʼapinisi dennen nti</para>
  <para style="q2" vid="PSA 102:5">maka ɔhonam ne nnompe.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Mete sɛ sare so patu,</para>
  <para style="q2" vid="PSA 102:6">te sɛ patu a ɔte nnwiriwii mu.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Meda hɔ a, mʼani gu so; mayɛ sɛ</para>
  <para style="q2" vid="PSA 102:7">anomaa bi a ɔno nko ara si ɔdan atifi.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Da mu nyinaa mʼatamfo bɔ me akutia.</para>
  <para style="q2" vid="PSA 102:8">Wɔn a wodi me ho fɛw no bɔ me din de dome.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Mede nsõ ayɛ mʼaduan</para>
  <para style="q2" vid="PSA 102:9">na mede nusu fra me nsu mu<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>esiane wʼabufuwhyew dennen no nti,</para>
  <para style="q2" vid="PSA 102:10">woama me so, ayi me asi nkyɛn.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Me nkwa nna te sɛ anwummere sunsuma;</para>
  <para style="q2" vid="PSA 102:11">na mehyew sɛ sare.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>Nanso wo <char style="nd">Awurade</char>, woyɛ ɔhene daa daa;</para>
  <para style="q2" vid="PSA 102:12">na wo din a ahyeta no te hɔ daa awo ntoatoaso nyinaa mu.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Wobɛsɔre na woahu Sion mmɔbɔ;</para>
  <para style="q2" vid="PSA 102:13">bere adu sɛ wuhu no mmɔbɔ;</para>
  <para style="q2" vid="PSA 102:13">bere a wohyɛe no aso.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>Nʼabo som bo ma wʼasomfo;</para>
  <para style="q2" vid="PSA 102:14">ne mfutuma hyɛ wɔn awerɛhow.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Amanaman no besuro <char style="nd">Awurade</char> din;</para>
  <para style="q2" vid="PSA 102:15">asase so ahemfo nyinaa bedi wʼanuonyam ni.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>
    <char style="nd">Awurade</char> bɛkyekyere Sion bio,</para>
  <para style="q2" vid="PSA 102:16">na wapue wɔ nʼanuonyam mu.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>Obetie mmɔborɔfo mpaebɔ;</para>
  <para style="q2" vid="PSA 102:17">na ɔremmu nʼani ngu wɔn sufrɛ so.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Monkyerɛw eyi mma nkyirimma,</para>
  <para style="q2" vid="PSA 102:18">sɛnea ɛbɛyɛ a wɔn a wonnya nwoo wɔn no bɛkamfo <char style="nd">Awurade</char>;<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>“<char style="nd">Awurade</char> hwɛɛ fam fi ne kronkronbea wɔ ɔsoro hɔ;</para>
  <para style="q2" vid="PSA 102:19">ofi ɔsoro hwɛɛ asase,<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>sɛnea ɔbɛte nneduafo apinisi,</para>
  <para style="q2" vid="PSA 102:20">na wɔagyaa wɔn a wɔabu wɔn kumfɔ no.”<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>Enti wɔbɛpae mu abɔ <char style="nd">Awurade</char> din wɔ Sion</para>
  <para style="q2" vid="PSA 102:21">na wɔakamfo no wɔ Yerusalem,<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>bere a amanaman ne ahenni ahorow</para>
  <para style="q2" vid="PSA 102:22">behyia mu na wɔasom <char style="nd">Awurade</char>.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Ɔmaa me yɛɛ mmerɛw wɔ bere a merenyin.</para>
  <para style="q2" vid="PSA 102:23">Otwaa me nkwa nna so.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>Enti mekae se,</para>
  <para style="q2" vid="PSA 102:24">“Me Onyankopɔn, mfa me nkɔ, wɔ me nkwa nna mfimfini;</para>
  <para style="q2" vid="PSA 102:24">wo mfe wɔ hɔ daa kodu awo ntoatoaso nyinaa mu.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Mfiase no wotoo asase fapem,</para>
  <para style="q2" vid="PSA 102:25">na ɔsoro yɛ wo nsa ano adwuma.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Ne nyinaa betwa mu na wo de, wobɛtena hɔ daa;</para>
  <para style="q2" vid="PSA 102:26">wɔbɛtetew te sɛ atade.</para>
  <para style="q1" vid="PSA 102:26">Wobɛsesa wɔn te sɛ ntama,</para>
  <para style="q2" vid="PSA 102:26">na wɔbɛtow wɔn agu.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Nanso wote sɛnea wote,</para>
  <para style="q2" vid="PSA 102:27">na wo mfe to rentwa da.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Wʼasomfo mma bɛtena nkwa mu wɔ wʼanim;</para>
  <para style="q2" vid="PSA 102:28">na wɔn asefo ase betim wɔ wʼanim.”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">Dwom 103</para>
  <para style="d">Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>Me kra, kamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 103:1">na me mu ade nyinaa nkamfo ne din kronkron no.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Me kra, kamfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 103:2">na mma wo werɛ mmfi ne nneyɛe pa nyinaa,<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>ɔno na ɔde wo mfomso nyinaa kyɛ wo</para>
  <para style="q2" vid="PSA 103:3">na ɔsa wo nyarewa nyinaa,<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>ogye wo nkwa fi ɔda mu,</para>
  <para style="q2" vid="PSA 103:4">na ɔde adɔe ne mmɔborɔhunu bɔ wo abotiri,<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>ɔde nnepa ma wo sɛ wʼapɛde,</para>
  <para style="q2" vid="PSA 103:5">na wo mmerantebere yɛ foforo sɛ ɔkɔre.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>
    <char style="nd">Awurade</char> yɛ adetrenee,</para>
  <para style="q2" vid="PSA 103:6">na obu wɔn a wɔhyɛ wɔn so nyinaa atɛntrenee.<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>Ɔkyerɛɛ Mose nʼakwan,</para>
  <para style="q2" vid="PSA 103:7">na ɔmaa Israelfo huu ne nneyɛe.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>Mmɔborɔhunufo ne ɔdomfo ne <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 103:8">ne bo kyɛ fuw na nʼadɔe dɔɔso.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>Ɔrenkɔ so mmɔ sobo,</para>
  <para style="q2" vid="PSA 103:9">na ɔrennya yɛn ho menasepɔw nkosi daa;<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>Ɔnhwɛ yɛn bɔne ne yɛn nni sɛnea ɛfata</para>
  <para style="q2" vid="PSA 103:10">na ontua yɛn nnebɔne so ka sɛnea ɛte.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Na sɛnea ɔsoro ne asase ntam ware no,</para>
  <para style="q2" vid="PSA 103:11">saa ara na nʼadɔe so wɔ wɔn a wosuro no no so.<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>Sɛnea apuei ne atɔe ntam ware no,</para>
  <para style="q2" vid="PSA 103:12">saa ara na wama yɛn ne yɛn mmarato ntam kwan aware.<verse eid="PSA 103:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Sɛnea agya yam hyehyew no wɔ ne mma ho no,</para>
  <para style="q2" vid="PSA 103:13">saa ara na <char style="nd">Awurade</char> yam hyehye no ma wɔn a wosuro no no;<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>na onim sɛnea wɔyɛɛ yɛn,</para>
  <para style="q2" vid="PSA 103:14">ɔkae se yɛyɛ mfutuma.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Ɔdesani de, ne nna te sɛ sare,</para>
  <para style="q2" vid="PSA 103:15">ɔyɛ frɔmfrɔm sɛ nwura mu nhwiren;<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>sɛ mframa bɔ fa ne so a, na onni hɔ,</para>
  <para style="q2" vid="PSA 103:16">na ne sibea nkae no bio.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Nanso efi mmeresanten kosi nnasanten</para>
  <para style="q2" vid="PSA 103:17">
    <char style="nd">Awurade</char> adɔe wɔ wɔn a wosuro no so,</para>
  <para style="q2" vid="PSA 103:17">na ne trenee wɔ wɔn mma mma so,<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>wɔn a wodi nʼapam no so</para>
  <para style="q2" vid="PSA 103:18">na wɔkae di ne mmara so.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>
    <char style="nd">Awurade</char> asi nʼahengua wɔ ɔsoro,</para>
  <para style="q2" vid="PSA 103:19">na nʼahenni di ade nyinaa so.<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Monkamfo <char style="nd">Awurade</char>, mo a moyɛ nʼabɔfo,</para>
  <para style="q2" vid="PSA 103:20">mo atumfo a moyɛ nʼahyɛde,</para>
  <para style="q2" vid="PSA 103:20">mo a mutie nʼasɛm.<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Monkamfo <char style="nd">Awurade</char>, ɔsoro asafo nyinaa,</para>
  <para style="q2" vid="PSA 103:21">nʼasomfo a moyɛ nʼapɛde.<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Monkamfo <char style="nd">Awurade</char>, ne nnwuma nyinaa;</para>
  <para style="q2" vid="PSA 103:22">nea ɛwɔ nʼahenni mu nyinaa.</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">Me kra, kamfo <char style="nd">Awurade</char>!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">Dwom 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>Me kra, kamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q1" vid="PSA 104:1">
    <char style="nd">Awurade</char> me Nyankopɔn, woyɛ ɔkɛse!</para>
  <para style="q2" vid="PSA 104:1">Wɔafura wo tumi ne anuonyam.<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Ɔde hann akata ne ho sɛ atade;</para>
  <para style="q2" vid="PSA 104:2">ɔtrɛw ɔsoro mu te sɛ ntamadan,<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>na ɔde ne mpia mu mpuran sisi nsu so.</para>
  <para style="q1" vid="PSA 104:3">Ɔde omununkum yɛ ne teaseɛnam</para>
  <para style="q2" vid="PSA 104:3">na ɔde nantew mframa ntaban so.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Ɔsoma nʼabɔfo sɛ mframa,</para>
  <para style="q2" vid="PSA 104:4">na ɔsoma nʼasomfo sɛ ogyaframa.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Ɔde asase asi ne fapem so</para>
  <para style="q2" vid="PSA 104:5">na ɛrenhinhim da.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Wode bun kataa so sɛ atade</para>
  <para style="q2" vid="PSA 104:6">na nsu gyinaa mmepɔw no so.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Nanso wʼanimka maa nsu no guanee,</para>
  <para style="q2" vid="PSA 104:7">wʼaprannaa nnyigyei maa woguanee;<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Wɔsen faa mmepɔw so,</para>
  <para style="q2" vid="PSA 104:8">kɔɔ aku mu tɔnn,</para>
  <para style="q2" vid="PSA 104:8">koguu faako a wode ama wɔn no.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Wotoo ɔhye a wɔrentumi ntra;</para>
  <para style="q2" vid="PSA 104:9">na wɔammɛkata asase so bio.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Ɔma nsuwa sen fa abon mu,</para>
  <para style="q2" vid="PSA 104:10">ɛsen fa mmepɔw ntam.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Wɔma wuram mmoa nyinaa nsu nom;</para>
  <para style="q2" vid="PSA 104:11">atorɔm de kum wɔn sukɔm.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Wim nnomaa nwen wɔn berebuw wɔ nsu no ho;</para>
  <para style="q2" vid="PSA 104:12">na wɔto nnwom wɔ nnua no mman so.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Ofi ne soro mpia mu tɔ nsu gugu mmepɔw so;</para>
  <para style="q2" vid="PSA 104:13">ne nnwuma so aba mee asase.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Ɔma sare fifi ma anantwi,</para>
  <para style="q2" vid="PSA 104:14">na ɔbɔɔ nnua maa onipa sɛ onnua</para>
  <para style="q2" vid="PSA 104:14">na ɛmma aduan mfi asase mu:<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>nsa a ɛma onipa koma tɔ ne yam,</para>
  <para style="q2" vid="PSA 104:15">ngo a ɛma onipa anim tɔ so,</para>
  <para style="q2" vid="PSA 104:15">ne aduan a ekura onipa koma.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Wogugu <char style="nd">Awurade</char> nnua no so yiye,</para>
  <para style="q2" vid="PSA 104:16">Lebanon sida a oduae no.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Ɛsow na nnomaa yɛ wɔn mmerebuw,</para>
  <para style="q2" vid="PSA 104:17">na asukɔnkɔn nso yɛ nʼatenae wɔ ɔpepaw nnua no mu.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Mmepɔw atenten no yɛ wuram mmirekyi de;</para>
  <para style="q2" vid="PSA 104:18">na abotan yɛ guankɔbea ma ewi.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Ɔsram kyerɛ bere nkyekyɛmu,</para>
  <para style="q2" vid="PSA 104:19">na owia nim bere a ɔkɔtɔ.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Wode sum ba ma ɛyɛ adesae</para>
  <para style="q2" vid="PSA 104:20">na kwae mu mmoa nyinaa kɔ ahayɛ.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Gyata bobɔ mu pɛ wɔn hanam,</para>
  <para style="q2" vid="PSA 104:21">wɔhwehwɛ wɔn aduan fi Onyankopɔn hɔ.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Owia pue ma wɔsan wɔn akyi;</para>
  <para style="q2" vid="PSA 104:22">wɔsan kɔdeda wɔn atu mu.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>Afei, onipa kɔ nʼadwuma so</para>
  <para style="q2" vid="PSA 104:23">kɔyɛ adwuma ara kosi anwummere.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>
    <char style="nd">Awurade</char>, wo nnwuma dɔɔso!</para>
  <para style="q2" vid="PSA 104:24">Nyansa mu na woyɛɛ ne nyinaa;</para>
  <para style="q2" vid="PSA 104:24">wʼabɔde ahyɛ asase so ma.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Po na ɛda hɔ tɛtrɛɛ tamaa yi,</para>
  <para style="q2" vid="PSA 104:25">a abɔde bebree a enni ano;</para>
  <para style="q2" vid="PSA 104:25">akɛse ne nketewa ahyɛ no ma.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>So na ahyɛn di akɔneaba,</para>
  <para style="q2" vid="PSA 104:26">na ɔdɛnkyɛmmirampɔn a woyɛɛ no di agoru.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Wɔn nyinaa hwɛ wo kwan</para>
  <para style="q2" vid="PSA 104:27">sɛ wobɛma wɔn wɔn aduan wɔ bere a ɛsɛ mu.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Wode ma wɔn a, wɔtase;</para>
  <para style="q2" vid="PSA 104:28">wubue wo nsam a nnepa mee wɔn.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Wode wʼanim hintaw wɔn a,</para>
  <para style="q2" vid="PSA 104:29">wɔbɔ hu;</para>
  <para style="q1" vid="PSA 104:29">sɛ wugye wɔn home a,</para>
  <para style="q2" vid="PSA 104:29">wowuwu na wɔsan kɔ mfutuma mu.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Sɛ wode wo Honhom no ma wɔn a</para>
  <para style="q2" vid="PSA 104:30">na wɔabɔ wɔn,</para>
  <para style="q2" vid="PSA 104:30">na woyɛ asase ani foforo.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Ma <char style="nd">Awurade</char> anuonyam ntena hɔ daa;</para>
  <para style="q2" vid="PSA 104:31">ma <char style="nd">Awurade</char> ani nnye ne nnwuma ho,<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>nea ɔhwɛ asase na ɛwosow,</para>
  <para style="q2" vid="PSA 104:32">na ɔde ne nsa ka mmepɔw a wusiw fi mu ba.<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Mɛto dwom ama <char style="nd">Awurade</char> me nkwa nna nyinaa;</para>
  <para style="q2" vid="PSA 104:33">sɛ mete ase yi, mɛto ayeyi dwom ama me Nyankopɔn.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Ɔmma me mpaebɔ nsɔ nʼani</para>
  <para style="q2" vid="PSA 104:34">bere a meregye mʼani wɔ <char style="nd">Awurade</char> mu yi.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Ma nnebɔneyɛfo nyera wɔ asase so;</para>
  <para style="q2" vid="PSA 104:35">na amumɔyɛfo ase nhyew.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Me kra, kamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">Kamfo <char style="nd">Awurade</char>.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">Dwom 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>Da <char style="nd">Awurade</char> ase na da ne kɛseyɛ adi.</para>
  <para style="q2" vid="PSA 105:1">Ma wiase nyinaa nhu nea wayɛ.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Monto dwom mma no, monto ayeyi dwom mma no;</para>
  <para style="q2" vid="PSA 105:2">monka nʼanwonwade no nyinaa.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Monhoahoa mo ho wɔ ne din kronkron mu;</para>
  <para style="q2" vid="PSA 105:3">momma wɔn a wɔhwehwɛ <char style="nd">Awurade</char> no nnya koma mu anigye.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Momma mo ani nna <char style="nd">Awurade</char> ne nʼahoɔden no so;</para>
  <para style="q2" vid="PSA 105:4">na monhwehwɛ nʼanim bere biara.<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>Monkae anwonwade a wayɛ</para>
  <para style="q2" vid="PSA 105:5">ne nsɛnkyerɛnne, ne atɛn a obui,<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>Abraham mma, Onyankopɔn asomfo,</para>
  <para style="q2" vid="PSA 105:6">Yakob mma a wapaw wɔn.<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>Ɔyɛ <char style="nd">Awurade</char>, yɛn Nyankopɔn.</para>
  <para style="q2" vid="PSA 105:7">Nʼahenni da adi wɔ asase so nyinaa.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>Ɔkae nʼapam daa nyinaa,</para>
  <para style="q2" vid="PSA 105:8">asɛm a ɔhyɛ maa awo ntoantoaso apem no,<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>apam a ɔne Abraham yɛe no,</para>
  <para style="q2" vid="PSA 105:9">ntam a ɔka kyerɛɛ Isak no.<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Ɔhyɛɛ mu den maa Yakob sɛ mmara,</para>
  <para style="q2" vid="PSA 105:10">de maa Israel sɛ apam a ɛbɛtena hɔ afebɔɔ.<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>Ɔkae se, “Mede Kanaan asase no bɛma wo</para>
  <para style="q2" vid="PSA 105:11">sɛ kyɛfa a ɛbɛyɛ wʼagyapade.”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Ɔkaa eyi bere a na wɔnnɔɔso,</para>
  <para style="q2" vid="PSA 105:12">ahɔhokuw ketewa bi a wɔwɔ Kanaan.<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>Wofii aman so kɔɔ aman so;</para>
  <para style="q2" vid="PSA 105:13">fii ahemman mu kɔɔ ahemman mu.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Wamma obi anhyɛ wɔn so;</para>
  <para style="q2" vid="PSA 105:14">wɔn nti, ɔkaa ahene anim se:<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“Mommfa mo nsa nka wɔn a masra wɔn ngo;</para>
  <para style="q2" vid="PSA 105:15">na monnyɛ mʼadiyifo bɔne bi.”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Ɔmaa ɔkɔm baa asase no so</para>
  <para style="q2" vid="PSA 105:16">na ɔsɛee akwan a wɔfa so nya wɔn aduan nyinaa;<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>na ɔsomaa ɔbarima bi dii wɔn anim,</para>
  <para style="q2" vid="PSA 105:17">Yosef a wɔtɔn no sɛ akoa no.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Wɔde mpokyerɛ guu ne nʼanan,</para>
  <para style="q2" vid="PSA 105:18">na wɔde dade nkɔnsɔnkɔnsɔn hyɛɛ ne kɔn,<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>kosii sɛ nea ɔhyɛɛ ho nkɔm no baa mu,</para>
  <para style="q2" vid="PSA 105:19">kosii sɛ <char style="nd">Awurade</char> asɛm no daa no adi sɛ ɔyɛ ɔnokwafo.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>Ɔhene no soma ma wokoyii no;</para>
  <para style="q2" vid="PSA 105:20">aman no sodifo gyaa no.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Ɔyɛɛ no ne fi so wura</para>
  <para style="q2" vid="PSA 105:21">nea ɔwɔ nyinaa sodifo,<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>sɛ ɔnkyerɛ ne mmapɔmma nea ɔpɛ</para>
  <para style="q2" vid="PSA 105:22">na ɔnkyerɛ ne mpanyimfo nyansa.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Na Israel kɔɔ Misraim;</para>
  <para style="q2" vid="PSA 105:23">Yakob kɔtenaa Ham asase so sɛ ɔnanani.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>
    <char style="nd">Awurade</char> maa ne nkurɔfo ase dɔe;</para>
  <para style="q2" vid="PSA 105:24">ɔyɛɛ wɔn bebree dodo maa wɔn atamfo,<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>wɔn a ɔdan wɔn koma sɛ wɔntan ne nkurɔfo</para>
  <para style="q2" vid="PSA 105:25">na wɔmpam nʼasomfo ti so.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Ɔsomaa ne somfo Mose,</para>
  <para style="q2" vid="PSA 105:26">ne Aaron a na wayi no no.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Wɔyɛɛ ne nsɛnkyerɛnne nwonwaso wɔ wɔn mu,</para>
  <para style="q2" vid="PSA 105:27">nʼanwonwade wɔ Ham asase so.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Ɔsomaa sum, na ɔmaa asase duruu sum,</para>
  <para style="q2" vid="PSA 105:28">efisɛ na wɔatew nʼasɛm no so atua.<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Ɔmaa wɔn nsu nyinaa dan mogya,</para>
  <para style="q2" vid="PSA 105:29">nam so kum mu mpataa.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Mpɔtorɔ bɛhyɛɛ asase no so ma,</para>
  <para style="q2" vid="PSA 105:30">na wɔhyɛn ɔman no sodifo mpia mu.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>Ɔkasae, na nwansena bebree</para>
  <para style="q2" vid="PSA 105:31">ne ntontom baa ɔman no mu baabiara.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Ɔmaa wɔn osu dan mparuwbo</para>
  <para style="q2" vid="PSA 105:32">a anyinam nenam mu wɔ ɔman no nyinaa mu;<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>Ɔsɛee wɔn bobe ne borɔdɔma nnua</para>
  <para style="q2" vid="PSA 105:33">na obubuu ɔman no so nnua pasaa.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>Ɔkasae, na mmoadabi bae,</para>
  <para style="q2" vid="PSA 105:34">tɛwtɛw a wontumi nkan wɔn;<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>wɔwee ahabammono biara a ɛwɔ wɔn asase no so,</para>
  <para style="q2" vid="PSA 105:35">na wodii wɔn mfuw so nnuan.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Afei okunkum wɔn asase so mmakan nyinaa,</para>
  <para style="q2" vid="PSA 105:36">wɔn mmarimayɛ mu aba a edi kan nyinaa.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Oyii Israel a ɔso dwetɛ ne sikakɔkɔɔ</para>
  <para style="q2" vid="PSA 105:37">fii wɔn mmusuakuw mu a obiara ho antɔ kyima.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Misraim ani gyei, bere a wɔkɔe,</para>
  <para style="q2" vid="PSA 105:38">efisɛ na Israelfo ho hu atɔ wɔn so.<verse eid="PSA 105:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Ɔtrɛw omununkum mu kataa wɔn so,</para>
  <para style="q2" vid="PSA 105:39">na ogya maa wɔn hann anadwo.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Wobisae, na ɔbrɛɛ wɔn mparuwbo</para>
  <para style="q2" vid="PSA 105:40">ɔmaa ɔsoro aduan mee wɔn.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>Obuee ɔbotan mu maa nsu fii mu bae;</para>
  <para style="q2" vid="PSA 105:41">na ɛsen faa sare no so sɛ asubɔnten.<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>Ɔkaee ne bɔ kronkron bi a</para>
  <para style="q2" vid="PSA 105:42">ɔhyɛɛ ne somfo Abraham no.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>Oyii ne nkurɔfo maa wɔn ani gyei;</para>
  <para style="q2" vid="PSA 105:43">wɔn a wapaw wɔn no dii ahurusi;<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>ɔde amanaman no nsase maa wɔn,</para>
  <para style="q2" vid="PSA 105:44">na nea ebinom abrɛ anya no bɛyɛɛ wɔn agyapade<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>na wɔahwɛ nʼahyɛde</para>
  <para style="q2" vid="PSA 105:45">adi ne mmara so.</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">Munyi <char style="nd">Awurade</char> ayɛ.<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">Dwom 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>Monkamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">Monna <char style="nd">Awurade</char> ase na oye;</para>
  <para style="q2" vid="PSA 106:1">na nʼadɔe wɔ hɔ daa.<verse eid="PSA 106:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Hena na obetumi aka nneɛma akɛse a <char style="nd">Awurade</char> ayɛ?</para>
  <para style="q2" vid="PSA 106:2">Anaasɛ obetumi aka ne nkamfo awie?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Nhyira nka wɔn a wɔkɔ so bu atɛntrenee,</para>
  <para style="q2" vid="PSA 106:3">na daa wɔyɛ nea eye.<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>
    <char style="nd">Awurade</char>, sɛ wuhu wo nkurɔfo mmɔbɔ a kae me,</para>
  <para style="q2" vid="PSA 106:4">sɛ wugye wɔn nkwa a, boa me,<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>na manya wɔn a wapaw wɔn no yiyedi mu kyɛfa,</para>
  <para style="q2" vid="PSA 106:5">na manya wo manfo anigye no mu kyɛfa,</para>
  <para style="q2" vid="PSA 106:5">na me ne wʼagyapade no abɔ mu de nkamfo ama wo.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Yɛayɛ bɔne sɛnea yɛn nenanom yɛe no;</para>
  <para style="q2" vid="PSA 106:6">yɛayɛ mfomso na yɛadi atirimɔdensɛm.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Bere a yɛn nenanom wɔ Misraim no,</para>
  <para style="q2" vid="PSA 106:7">wɔannwene wo nsɛnkyerɛnne ho;</para>
  <para style="q1" vid="PSA 106:7">wɔankae wʼadɔe bebrebe no,</para>
  <para style="q2" vid="PSA 106:7">na wɔtew atua wɔ Po Kɔkɔɔ no ho.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Nanso ne din nti ogyee wɔn nkwa,</para>
  <para style="q2" vid="PSA 106:8">sɛnea ɔbɛda ne tumi kɛse no adi.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>Ɔteɛɛ Po Kɔkɔɔ no ma ɛyowee;</para>
  <para style="q2" vid="PSA 106:9">ɔde wɔn faa bun mu te sɛ sare so.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>Ogyee wɔn fii ɔtamfo no nsam;</para>
  <para style="q2" vid="PSA 106:10">nea ɔtan wɔn no nsam na oyii wɔn fii.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Nsu kataa wɔn atamfo so;</para>
  <para style="q2" vid="PSA 106:11">na ɔbaako mpo annya nkwa.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>Afei wogyee ne bɔhyɛ no dii</para>
  <para style="q2" vid="PSA 106:12">na wɔtoo nʼayeyi nnwom.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Nanso ntɛm so, wɔn werɛ fii nea wayɛ</para>
  <para style="q2" vid="PSA 106:13">na wɔantwɛn nʼagyinatu.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Akɔnnɔ bɛhyɛɛ wɔn mu wɔ sare so hɔ,</para>
  <para style="q2" vid="PSA 106:14">asase paradada no so na wɔsɔɔ Onyankopɔn hwɛe,<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>enti ɔmaa wɔn nea wobisae,</para>
  <para style="q2" vid="PSA 106:15">nanso ɔde ɔfɔn yare baa wɔn so.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Na nsraban mu hɔ wɔn ani beree Mose</para>
  <para style="q2" vid="PSA 106:16">ne Aaron a <char style="nd">Awurade</char> atew ne ho no.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Asase mu bue ma ɛmenee Datan</para>
  <para style="q2" vid="PSA 106:17">na esiee Abiram asafo no.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Ogya tɔɔ wɔn akyidifo no mu;</para>
  <para style="q2" vid="PSA 106:18">ogyatannaa hyew amumɔyɛfo no.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Wɔyɛɛ nantwi ba wɔ Horeb</para>
  <para style="q2" vid="PSA 106:19">na wɔkotow ohoni a wɔde fagude ayɛ.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Wɔsesaa wɔn Anuonyam</para>
  <para style="q2" vid="PSA 106:20">wɔde nantwinini, a ɔwe sare nsɛsode.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Wɔn werɛ fii Onyankopɔn a ogyee wɔn nkwa,</para>
  <para style="q2" vid="PSA 106:21">nea ɔyɛɛ nneɛma akɛse wɔ Misraim no,<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>nsɛnkyerɛnne a ɔyɛɛ wɔ Ham asase so</para>
  <para style="q2" vid="PSA 106:22">ne nneɛma a ɛyɛ hu wɔ Po Kɔkɔɔ ho no.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Enti ɔkae se ɔbɛsɛe wɔn,</para>
  <para style="q2" vid="PSA 106:23">nanso Mose a ɔyɛ nea wapaw no no,</para>
  <para style="q1" vid="PSA 106:23">sɔre gyinaa Onyankopɔn ne nnipa no ntam;</para>
  <para style="q2" vid="PSA 106:23">ɔsrɛ de dwudwoo nʼabufuwhyew no ano sɛnea ɔrensɛe wɔn.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Afei wɔn ani ansɔ asase fɛfɛ no;</para>
  <para style="q2" vid="PSA 106:24">na wɔannye ne bɔhyɛ no anni.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Wonwiinwii wɔ wɔn ntamadan mu</para>
  <para style="q2" vid="PSA 106:25">na wɔanyɛ osetie amma <char style="nd">Awurade</char>.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Enti ɔmaa ne nsa so kaa ntam kyerɛɛ wɔn se</para>
  <para style="q2" vid="PSA 106:26">ɔbɛma wɔatotɔ wɔ sare no so,<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ɔbɛma wɔn asefo atotɔ wɔ amanaman mu</para>
  <para style="q2" vid="PSA 106:27">na wabɔ wɔn ahwete nsase nyinaa so.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Wɔde wɔn ho bɔɔ Baal-Peor ho</para>
  <para style="q2" vid="PSA 106:28">na wodii afɔrebɔde a wɔde ama anyame a wonni nkwa;<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>wɔde wɔn atirimɔdensɛm hyɛɛ <char style="nd">Awurade</char> abufuw</para>
  <para style="q2" vid="PSA 106:29">na ɔyaredɔm sii wɔn mu.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Na Pinehas sɔre dii akagyinamu,</para>
  <para style="q2" vid="PSA 106:30">na wosiw ɔyaredɔm no ano.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Wɔde eyi yɛɛ trenee maa no</para>
  <para style="q2" vid="PSA 106:31">wɔ awo ntoatoaso a enni awiei a ɛbɛba no mu.<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Meriba nsu ho nso, wɔhyɛɛ <char style="nd">Awurade</char> abufuw,</para>
  <para style="q2" vid="PSA 106:32">na wɔn nti, ɔhaw baa Mose so,<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>efisɛ wɔtew Onyankopɔn Honhom anim atua,</para>
  <para style="q2" vid="PSA 106:33">na asɛm a wannwene ho fii Mose anom.<verse eid="PSA 106:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Wɔansɛe nnipa no</para>
  <para style="q2" vid="PSA 106:34">sɛnea <char style="nd">Awurade</char> hyɛɛ wɔn no,<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>nanso wɔde wɔn ho frafraa amanaman no</para>
  <para style="q2" vid="PSA 106:35">yɛɛ nneɛma a wɔyɛ no bi.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Wɔsom wɔn ahoni,</para>
  <para style="q2" vid="PSA 106:36">na ɛbɛyɛɛ afide maa wɔn.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Wɔde wɔn mmabarima</para>
  <para style="q2" vid="PSA 106:37">ne wɔn mmabea bɔɔ afɔre maa abosom.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Wɔkaa mogya a edi bem gui,</para>
  <para style="q2" vid="PSA 106:38">wɔn mmabarima ne wɔn mmabea mogya a</para>
  <para style="q1" vid="PSA 106:38">wɔde bɔɔ afɔre maa Kanaan ahoni no</para>
  <para style="q2" vid="PSA 106:38">maa asase no ho guu fi.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Wɔde nea wɔyɛɛ no guu wɔn ankasa ho fi;</para>
  <para style="q2" vid="PSA 106:39">wɔnam nea wɔyɛɛ no so bɔɔ aguaman.<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Enti <char style="nd">Awurade</char> bo fuw ne nkurɔfo;</para>
  <para style="q2" vid="PSA 106:40">na okyii nʼagyapade.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>Ɔdan wɔn maa amanaman no,</para>
  <para style="q2" vid="PSA 106:41">na wɔn atamfo dii wɔn so.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Wɔn atamfo hyɛɛ wɔn so</para>
  <para style="q2" vid="PSA 106:42">na wɔkaa wɔn hyɛɛ wɔn tumi ase.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>Mpɛn bebree, <char style="nd">Awurade</char> gyee wɔn,</para>
  <para style="q2" vid="PSA 106:43">nanso wɔkɔɔ so tew atua</para>
  <para style="q2" vid="PSA 106:43">na wɔsɛe wɔ wɔn bɔne mu.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Nanso ohuu wɔn ahohiahia</para>
  <para style="q2" vid="PSA 106:44">bere a wosu frɛɛ no no.<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>Wɔn nti ɔkaee nʼapam no,</para>
  <para style="q2" vid="PSA 106:45">na ofii nʼadɔe kɛse no mu huu wɔn mmɔbɔ.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Ɔmaa asodifo a wɔafa wɔn nnommum no</para>
  <para style="q2" vid="PSA 106:46">nyaa ahummɔbɔ maa wɔn.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>Gye yɛn, <char style="nd">Awurade</char> yɛn nkwagye Nyankopɔn,</para>
  <para style="q2" vid="PSA 106:47">na boaboa yɛn ano fi amanaman so,</para>
  <para style="q1" vid="PSA 106:47">na yɛada wo din kronkron no ase,</para>
  <para style="q2" vid="PSA 106:47">na yɛde nkamfo ahyɛ wo anuonyam.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>Ayeyi nka <char style="nd">Awurade</char>, Israel Nyankopɔn,</para>
  <para style="q2" vid="PSA 106:48">emfi mmeresanten nkosi nnasanten.</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Momma nnipa no nyinaa nka se, “Amen!”</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">NHOMA A ƐTO SO ANUM</para>
  <para style="mr">
    <ref loc="PSA 107-150">Nnwom 107–150</ref></para>
  <para style="cl">Dwom 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>Monna <char style="nd">Awurade</char> ase na oye;</para>
  <para style="q2" vid="PSA 107:1">na nʼadɔe wɔ hɔ daa.<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Momma wɔn a <char style="nd">Awurade</char> agye wɔn nka saa,</para>
  <para style="q2" vid="PSA 107:2">wɔn a wagye wɔn afi ɔtamfo nsam no;<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>wɔn a ɔboaboaa wɔn ano fii nsase so no,</para>
  <para style="q2" vid="PSA 107:3">efi apuei kosi atɔe, atifi kosi anafo.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Ebinom kyinkyinii wɔ nsase pradada so,</para>
  <para style="q2" vid="PSA 107:4">a wɔanhu ɔkwan ankɔ kuropɔn no mu, faako a wobetumi anya atenae.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Ɔkɔm ne osukɔm dee wɔn</para>
  <para style="q2" vid="PSA 107:5">na wɔtotɔɔ beraw.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Afei wosu frɛɛ <char style="nd">Awurade</char> wɔ wɔn amanehunu mu,</para>
  <para style="q2" vid="PSA 107:6">na ogyee wɔn fii wɔn ahohiahia mu.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Ɔde wɔn faa ɔkwan tee so</para>
  <para style="q2" vid="PSA 107:7">baa kuropɔn a wotumi tena mu no mu.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔe a ɛnsa da</para>
  <para style="q2" vid="PSA 107:8">ne nʼanwonwade a ɔyɛ ma nnipa no ho,<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>ɔma wɔn a osukɔm de wɔn nsu</para>
  <para style="q2" vid="PSA 107:9">na ɔde nnepa hyɛ wɔn a ɔkɔm de wɔn ma.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Ebinom tenaa sum ne awerɛhow mu,</para>
  <para style="q2" vid="PSA 107:10">nneduafo a wɔde dade nkɔnsɔnkɔnsɔn agu wɔn,<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>efisɛ wɔatew Onyankopɔn nsɛm ho atua</para>
  <para style="q2" vid="PSA 107:11">na wɔabu Ɔsorosoroni no agyinatu animtiaa.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>Enti ogyaa wɔn maa adwumaden;</para>
  <para style="q2" vid="PSA 107:12">wohintihintiwii, na wɔannya ɔboafo.<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Afei wosu frɛɛ <char style="nd">Awurade</char> wɔ wɔn amanehunu mu,</para>
  <para style="q2" vid="PSA 107:13">na ogyee wɔn fii wɔn ahohia mu.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>Oyii wɔn fii sum ne awerɛhow mu,</para>
  <para style="q2" vid="PSA 107:14">na obubuu wɔn nkɔnsɔnkɔnsɔn mu.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔe a ɛnsa da</para>
  <para style="q2" vid="PSA 107:15">ne nʼanwonwade a ɔyɛ ma nnipa no ho,<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>efisɛ obubu kɔbere mfrafra apon</para>
  <para style="q2" vid="PSA 107:16">na otwitwa nnadeban mu.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Ebinom bɛyɛɛ nkwaseafo, wɔn atuatew nti,</para>
  <para style="q2" vid="PSA 107:17">na wohuu amane, wɔn nnebɔne nti.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Wokyii aduan nyinaa</para>
  <para style="q2" vid="PSA 107:18">na wotwiw bɛnee owu pon ano.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Afei wosu frɛɛ <char style="nd">Awurade</char>, wɔn amanehunu mu</para>
  <para style="q2" vid="PSA 107:19">na ogyee wɔn fii wɔn ahohia mu.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>Ɔsomaa nʼasɛm na ɔsaa wɔn yare;</para>
  <para style="q2" vid="PSA 107:20">na ogyee wɔn fii ɔda mu.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔe a ɛnsa da</para>
  <para style="q2" vid="PSA 107:21">ne nʼanwonwade a ɔyɛ ma nnipa no ho.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Momma wɔmmɔ aseda afɔre</para>
  <para style="q2" vid="PSA 107:22">na wɔmfa ahurusi nnwom nka ne nnwuma ho asɛm.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Ebinom tenaa ahyɛn mu wɔ po so;</para>
  <para style="q2" vid="PSA 107:23">wɔyɛ aguadifo wɔ nsu akɛse so.<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>Wohuu <char style="nd">Awurade</char> nnwuma,</para>
  <para style="q2" vid="PSA 107:24">nʼanwonwade a ɛwɔ bun mu.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>Ɔkasa maa ahum tui</para>
  <para style="q2" vid="PSA 107:25">na ekukuru asorɔkye.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Wokukuru kɔɔ ɔsorosoro na wosian kɔɔ bun mu tɔnn;</para>
  <para style="q2" vid="PSA 107:26">wɔn amanehunu mu no wɔn koma tui.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Wokyim totɔɔ ntintan sɛ asabowfo;</para>
  <para style="q2" vid="PSA 107:27">na wonhu nea wɔnnyɛ bio.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Afei wosu frɛɛ <char style="nd">Awurade</char>, wɔn amanehunu mu,</para>
  <para style="q2" vid="PSA 107:28">na ogyee wɔn fii wɔn ahohia mu.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>Ɔmaa ahum no yɛɛ dinn;</para>
  <para style="q2" vid="PSA 107:29">po so asorɔkye ano brɛɛ ase.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Wɔn ani gyei, bere a ɛyɛɛ dinn no,</para>
  <para style="q2" vid="PSA 107:30">na ɔkyerɛɛ wɔn ɔkwan de wɔn koduu gyinabea a wɔpɛ.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Momma wɔnna <char style="nd">Awurade</char> ase, nʼadɔe a ɛnsa da</para>
  <para style="q2" vid="PSA 107:31">ne nʼanwonwade a ɔyɛ ma nnipa no ho.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Wɔmma no so wɔ asafo no mu</para>
  <para style="q2" vid="PSA 107:32">na wɔnkamfo no wɔ mpanyimfo nhyiamu ase.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Ɔdan nsubɔnten maa no yɛɛ sare,</para>
  <para style="q2" vid="PSA 107:33">asuten yɛɛ asase wosee,<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>na asasebere dan nkyenenkyene,</para>
  <para style="q2" vid="PSA 107:34">wɔn a wɔte asase no so amumɔyɛ nti.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>Ɔdan sare so maa no yɛɛ nsuwansuwa</para>
  <para style="q2" vid="PSA 107:35">na nkyɛkyerɛ yɛɛ sɛ nsuten anan mu;<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>Ɛhɔ na ɔde wɔn a ɔkɔm de wɔn kɔsoɛe,</para>
  <para style="q2" vid="PSA 107:36">na wɔkyekyeree kuropɔn tenaa mu.<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>Wɔyɛɛ mfuw ne bobe nturo</para>
  <para style="q2" vid="PSA 107:37">na ɛmaa wɔn nnɔbae bebree.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>Ohyiraa wɔn na wɔn ase dɔe.</para>
  <para style="q2" vid="PSA 107:38">Wamma wɔn nyɛmmoa dodow so anhuan.<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Afei wɔn dodow so huanee</para>
  <para style="q2" vid="PSA 107:39">na nhyɛso, amanehunu ne awerɛhow brɛɛ wɔn ase;<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>nea obu abirɛmpɔn animtiaa no</para>
  <para style="q2" vid="PSA 107:40">ma wokyinkyin asase kesee a ɔkwan nni hɔ so.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Nanso ɔmaa ahiafo so fii wɔn ahohia mu</para>
  <para style="q2" vid="PSA 107:41">na ɔmaa wɔn mmusua dɔɔ sɛ nguankuw.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Atreneefo hu ma wɔn ani gye,</para>
  <para style="q2" vid="PSA 107:42">nanso amumɔyɛfo nyinaa mua wɔn ano.<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Momma nea ɔyɛ onyansafo no mmu eyinom,</para>
  <para style="q2" vid="PSA 107:43">na onsusuw <char style="nd">Awurade</char> adɔe kɛse no ho.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">Dwom 108</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>Onyankopɔn, me koma asi pi;</para>
  <para style="q2" vid="PSA 108:1">mede me kra nyinaa bɛto wʼayeyi nnwom.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Munnyan, sanku ne bɛnta!</para>
  <para style="q2" vid="PSA 108:2">Menyan anɔpahema.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>
    <char style="nd">Awurade</char>, mɛkamfo wo wɔ aman mu;</para>
  <para style="q2" vid="PSA 108:3">mɛto wo ho nnwom wɔ nnipa no mu.<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Wʼadɔe so, ɛkorɔn sen ɔsoro;</para>
  <para style="q2" vid="PSA 108:4">wo nokwaredi du wim.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>Onyankopɔn, ɛsɛ sɛ wɔma wo so tra ɔsoro,</para>
  <para style="q2" vid="PSA 108:5">na ama wʼanuonyam aba asase nyinaa so.<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>Fa wo nsa nifa gye yɛn na boa yɛn,</para>
  <para style="q2" vid="PSA 108:6">na ama wɔn a wodɔ wɔn no anya nkwa.<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Onyankopɔn akasa afi ne kronkronbea se,</para>
  <para style="q2" vid="PSA 108:7">“Nkonim mu na mɛkyɛ Sekem mu</para>
  <para style="q2" vid="PSA 108:7">na masusuw Sukot Bon.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Gilead yɛ me de; Manase nso saa ara;</para>
  <para style="q2" vid="PSA 108:8">Efraim yɛ me dade kyɛw,</para>
  <para style="q2" vid="PSA 108:8">Yuda yɛ mʼahempema.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Moab yɛ me guasɛn,</para>
  <para style="q2" vid="PSA 108:9">Edom so na metow me mpaboa gu;</para>
  <para style="q2" vid="PSA 108:9">na meteɛ mu nkonimdi so gu Filistifo so.”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Hena na ɔde me bɛkɔ kuropɔn a wɔabɔ ho ban no mu?</para>
  <para style="q2" vid="PSA 108:10">Hena na obedi mʼanim akɔ Edom?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Onyankopɔn, ɛnyɛ wo na woapo yɛn</para>
  <para style="q2" vid="PSA 108:11">na wo ne yɛn asraafo nkɔ ɔsa bio ana?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>Boa yɛn tia ɔtamfo no,</para>
  <para style="q2" vid="PSA 108:12">na ɔdesani mmoa nka hwee.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Onyankopɔn wɔ yɛn afa yi, yebedi nkonim,</para>
  <para style="q2" vid="PSA 108:13">na obetiatia yɛn atamfo so.</para>
  <para style="d" vid="PSA 108:13">Wɔde ma dwonkyerɛfo no.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">Dwom 109</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>Me Nyankopɔn a mekamfo wo,</para>
  <para style="q2" vid="PSA 109:1">nyɛ komm,<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>na amumɔyɛfo ne nkontompofo</para>
  <para style="q2" vid="PSA 109:2">atu wɔn ano agu me so;</para>
  <para style="q2" vid="PSA 109:2">wɔde atoro tɛkrɛma akasa atia me.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Wɔde nitansɛm atwa me ho ahyia</para>
  <para style="q2" vid="PSA 109:3">na wɔtow hyɛ me so a menkaa wɔn.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>Wɔka nsɛm to me so de tua mʼadɔeyɛ so ka,</para>
  <para style="q2" vid="PSA 109:4">nanso meyɛ obi a mepɛ mpaebɔ.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Wɔde bɔne tua me papayɛ so ka,</para>
  <para style="q2" vid="PSA 109:5">na wɔde ɔtan tua mʼadɔeyɛ so ka.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Ma onipa bɔne bi nsɔre ntia no;</para>
  <para style="q2" vid="PSA 109:6">na Satan nnyina ne nsa nifa so.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Wodi nʼasɛm a, ma onni fɔ,</para>
  <para style="q2" vid="PSA 109:7">na ne mpaebɔ mmu no kumfɔ.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Ma ne nkwa nna nyɛ kakraa bi;</para>
  <para style="q2" vid="PSA 109:8">na ɔfoforo nsi nʼanan mu sɛ ɔkannifo.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Ma ne mma nyɛ ayisaa</para>
  <para style="q2" vid="PSA 109:9">na ne yere nyɛ okunafo.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Ma ne mma nkyinkyin nsrɛsrɛ ade;</para>
  <para style="q2" vid="PSA 109:10">ma wɔmpam wɔn mfi wɔn afi a abubu no mu.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Ma ɔdefirifo bi mfa nea ɔwɔ nyinaa;</para>
  <para style="q2" vid="PSA 109:11">na ananafo mfom nʼadwuma so aba.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Mma obiara nhu no,</para>
  <para style="q2" vid="PSA 109:12">anaa ne ayisaa mmɔbɔ.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Ma nʼase nhyew,</para>
  <para style="q2" vid="PSA 109:13">na wɔn din nyera wɔ awo ntoatoaso a ɛreba no mu.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Ma wɔnkae nʼagyanom nnebɔne wɔ <char style="nd">Awurade</char> anim;</para>
  <para style="q2" vid="PSA 109:14">na ne na bɔne no ntena hɔ daa.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Wɔn bɔne nyinaa nka <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 109:15">na wɔankae wɔn bio wɔ asase so.<verse eid="PSA 109:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>Efisɛ wannwene da sɛ ɔbɛyɛ adɔe,</para>
  <para style="q2" vid="PSA 109:16">na mmom ɔtaa ahiafo</para>
  <para style="q2" vid="PSA 109:16">mmɔborɔfo ne wɔn a wɔn werɛ ahow de kɔɔ owu mu.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>Nʼani gyee sɛ ɔbɛdome</para>
  <para style="q2" vid="PSA 109:17">enti nnome mmra no so;</para>
  <para style="q1" vid="PSA 109:17">wampɛ sɛ obehyira</para>
  <para style="q2" vid="PSA 109:17">enti nhyira mmɔ no.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Ɔhyɛɛ nnome sɛ atade;</para>
  <para style="q2" vid="PSA 109:18">ɛno kɔɔ ne nipadua mu sɛ nsu,</para>
  <para style="q2" vid="PSA 109:18">ne ne nnompe mu sɛ ngo.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Ma ɛnyɛ sɛ atade a ɛkyekyere ne ho,</para>
  <para style="q2" vid="PSA 109:19">ne abɔso a ɛbɔ no daa.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Ma eyi nyɛ <char style="nd">Awurade</char> akatua a ɔde ma me sobobɔfo,</para>
  <para style="q2" vid="PSA 109:20">wɔn a wɔka nsɛmmɔne fa me ho no.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Nanso wo Asafo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 109:21">wo din nti wo ne me nni no yiye;</para>
  <para style="q2" vid="PSA 109:21">fi wʼadɔe mu gye me.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>Efisɛ meyɛ ohiani ne nea onni bi,</para>
  <para style="q2" vid="PSA 109:22">na me koma atɔ beraw wɔ me mu.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Mitwaa mu sɛ anwummere sunsuma;</para>
  <para style="q2" vid="PSA 109:23">wopia me kyene sɛ mmoadabi.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Mmuadadi ama me nkotodwe mu agugow;</para>
  <para style="q2" vid="PSA 109:24">mafɔn, na ama aka me nnompe.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Mayɛ aserewde ama wɔn a wɔbɔ me sobo;</para>
  <para style="q2" vid="PSA 109:25">sɛ wohu me a, wɔwosow wɔn ti.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>Boa me, <char style="nd">Awurade</char> me Nyankopɔn;</para>
  <para style="q2" vid="PSA 109:26">gye me sɛnea wʼadɔe te.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Ma wonhu sɛ ɛyɛ wo nsa,</para>
  <para style="q2" vid="PSA 109:27">na wo na woayɛ, <char style="nd">Awurade</char>.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Wɔbɛdome, nanso wubehyira;</para>
  <para style="q2" vid="PSA 109:28">sɛ wɔtow hyɛ me so a wɔn anim begu ase,</para>
  <para style="q2" vid="PSA 109:28">nanso wo somfo ani begye.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Mʼatamfo befura animguase;</para>
  <para style="q2" vid="PSA 109:29">na akyekyere wɔn ho sɛ atade.<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Mede mʼano bɛma <char style="nd">Awurade</char> so ayɛ no kɛse;</para>
  <para style="q2" vid="PSA 109:30">mɛkamfo no wɔ dɔm mu.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>Efisɛ ogyina ohiani nsa nifa so</para>
  <para style="q2" vid="PSA 109:31">sɛ obegye no nkwa afi wɔn a wobu no kumfɔ nsam.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">Dwom 110</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>
    <char style="nd">Awurade</char> ka kyerɛɛ me Wura se,</para>
  <para style="q2" vid="PSA 110:1">“Tena me nifa so</para>
  <para style="q1" vid="PSA 110:1">kosi sɛ mede wʼatamfo</para>
  <para style="q2" vid="PSA 110:1">bɛyɛ wʼanan ase ntiaso.”<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>
    <char style="nd">Awurade</char> bɛterɛw wʼahempema dennen mu afi Sion;</para>
  <para style="q2" vid="PSA 110:2">na wubedi hene wɔ wʼatamfo so.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Wʼasraafo beyi wɔn koma mu</para>
  <para style="q2" vid="PSA 110:3">da a wobɛkɔ ɔsa.</para>
  <para style="q1" vid="PSA 110:3">Tumi kronkron bɛyɛ wʼadurade</para>
  <para style="q2" vid="PSA 110:3">na wo mmabun bɛba wo nkyɛn</para>
  <para style="q2" vid="PSA 110:3">sɛnea obosu gugu anɔpahema.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>
    <char style="nd">Awurade</char> aka ntam</para>
  <para style="q2" vid="PSA 110:4">na ɔrensesa nʼadwene:</para>
  <para style="q1" vid="PSA 110:4">“Woyɛ daapem sɔfo</para>
  <para style="q2" vid="PSA 110:4">sɛ Melkisedek sɛso.”<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>
    <char style="nd">Awurade</char> wɔ wo nifa so;</para>
  <para style="q2" vid="PSA 110:5">ɔbɛdwerɛw ahemfo wɔ nʼabufuwhyew da no.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>Obebu amanaman atɛn aboaboa awufo ano;</para>
  <para style="q2" vid="PSA 110:6">na wadwerɛw asodifo a wɔwɔ asase so nyinaa.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Ɔbɛnom asuwa a ɛda ɔkwankyɛn mu nsu</para>
  <para style="q2" vid="PSA 110:7">enti obedi nkonim.</para>
  <para style="q1" vid="PSA 110:7">Ɔhene no bɛnom asuwa a ɛda ɔkwankyɛn mu nsu,</para>
  <para style="q2" vid="PSA 110:7">na wanya ahoɔden, na wagyina nkonimdi mu.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">Dwom 111</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>Monkamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">Mefi me koma nyinaa mu ama <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 111:1">wɔ atreneefo aguabɔ ne asafo no mu.<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>
    <char style="nd">Awurade</char> nnwuma yɛ akɛse;</para>
  <para style="q2" vid="PSA 111:2">wɔn a wɔn ani gye ho nyinaa susuw ho.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Ne nnwuma yɛ tumi ne anuonyam,</para>
  <para style="q2" vid="PSA 111:3">na ne trenee wɔ hɔ daa.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Ɔma yɛkae nʼanwonwade;</para>
  <para style="q2" vid="PSA 111:4">
    <char style="nd">Awurade</char> yɛ ɔdomfo ne mmɔborɔhunufo.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Ɔma wɔn a wosuro no no aduan;</para>
  <para style="q2" vid="PSA 111:5">ɔkae nʼapam no daa.<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Wakyerɛ ne nkurɔfo tumi a ɛwɔ ne nnwuma mu,</para>
  <para style="q2" vid="PSA 111:6">sɛ ɔde aman afoforo nsase ama wɔn.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Ne nsa ano nnwuma yɛ nokware na ɛteɛ;</para>
  <para style="q2" vid="PSA 111:7">nʼahyɛde nyinaa mu wɔ ahotoso.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Etim hɔ daa daa,</para>
  <para style="q2" vid="PSA 111:8">nokware ne trenee mu na ɔyɛe.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>Ɔde ogye maa ne nkurɔfo;</para>
  <para style="q2" vid="PSA 111:9">ɔde nʼapam sii hɔ afebɔɔ,</para>
  <para style="q2" vid="PSA 111:9">ne din yɛ kronkron na ɛyɛ hu.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>
    <char style="nd">Awurade</char> suro yɛ nyansa mfiase;</para>
  <para style="q2" vid="PSA 111:10">wɔn a wodi nʼahyɛde so nyinaa wɔ nhumu pa.</para>
  <para style="q2" vid="PSA 111:10">Ɔno na daa ayeyi wɔ no.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">Dwom 112</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">Nhyira nka onipa a osuro <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 112:1">na onya nʼahyɛde mu anigye pii.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Ne mma bɛyɛ atumfo wɔ asase no so;</para>
  <para style="q2" vid="PSA 112:2">atreneefo awo ntoatoaso benya nhyira.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Ahonya ne sika wɔ ne fi,</para>
  <para style="q2" vid="PSA 112:3">na ne trenee tena hɔ daa.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Sum mu mpo hann pue ma nnipa a wɔteɛ,</para>
  <para style="q2" vid="PSA 112:4">ma ɔdomfo, mmɔborɔhunufo ne ɔnokwafo.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Yiyedi bɛba wɔn a wɔn tirim yɛ mmerɛw na wɔde fɛm kwa,</para>
  <para style="q2" vid="PSA 112:5">wɔn a wɔde atɛntrenee yɛ wɔn nneɛma no so.<verse eid="PSA 112:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Ampa ara ɔrenhinhim da biara da;</para>
  <para style="q2" vid="PSA 112:6">wɔbɛkae onipa trenee daa.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Ɔte asɛmmɔne a, ɛmmɔ no hu;</para>
  <para style="q2" vid="PSA 112:7">ne koma si pi wɔ <char style="nd">Awurade</char> mu ahotoso mu.<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Ne koma wɔ bammɔ, na onsuro;</para>
  <para style="q2" vid="PSA 112:8">awiei no ɔde nkonimdi behyia nʼatamfo.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>Ɔtow nʼakyɛde pete aman so ma ahiafo nea wohia,</para>
  <para style="q2" vid="PSA 112:9">nʼadɔe no tena hɔ daa;</para>
  <para style="q2" vid="PSA 112:9">wɔbɛkae wɔn daa na wɔahyɛ wɔn anuonyam.<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Omumɔyɛfo behu ama ayɛ no yaw,</para>
  <para style="q2" vid="PSA 112:10">ɔbɛtwɛre ne se na wafɔn;</para>
  <para style="q2" vid="PSA 112:10">omumɔyɛfo tirimpɔw bɛyɛ ɔkwa.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">Dwom 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 113:1"/>
  <para style="q1" vid="PSA 113:1">Monkamfo <char style="nd">Awurade</char>, mo a moyɛ nʼasomfo no,</para>
  <para style="q2" vid="PSA 113:1">monkamfo <char style="nd">Awurade</char> din.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Momma wɔnkamfo <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="PSA 113:2">mprempren ne daa nyinaa.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Efi faako a owia pue kosi faako a ɛkɔtɔ,</para>
  <para style="q2" vid="PSA 113:3">ma wɔnkamfo <char style="nd">Awurade</char> din.<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>Wɔama <char style="nd">Awurade</char> so aman nyinaa so,</para>
  <para style="q2" vid="PSA 113:4">nʼanuonyam tra ɔsorosoro.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Hena na ɔte sɛ <char style="nd">Awurade</char> yɛn Nyankopɔn,</para>
  <para style="q2" vid="PSA 113:5">Ɔbaako no a odi hene wɔ ɔsorosoro,<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>ɔno na ɔbɔ ne mu ase</para>
  <para style="q2" vid="PSA 113:6">hwɛ ɔsorosoro ne asase?<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>Ɔma ahiafo so fi mfutuma mu</para>
  <para style="q2" vid="PSA 113:7">na ɔma onnibi so fi nso siw so;<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>ɔde wɔn tena mmapɔmma mu,</para>
  <para style="q2" vid="PSA 113:8">wɔn nkurɔfo mmapɔmma mu.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Ɔbɔ obonin atenase wɔ ne fi</para>
  <para style="q2" vid="PSA 113:9">sɛ ɔbeatan a nʼani gye.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">Dwom 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Bere a Israelfo fii Misraim,</para>
  <para style="q2" vid="PSA 114:1">na Yakobfifo fii ananafo asase so no,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Yuda bɛyɛɛ <char style="nd">Awurade</char> kronkronbea</para>
  <para style="q2" vid="PSA 114:2">na Israel bɛyɛɛ nʼaheman.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Po no hwɛe, na eguanee,</para>
  <para style="q2" vid="PSA 114:3">Yordan san nʼakyi;<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>Mmepɔw huruhuruwii sɛ adwennini,</para>
  <para style="q2" vid="PSA 114:4">nkoko nso huruhuruwii sɛ nguantenmma.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>Dɛn na ɛbae, ɛpo, na wuguanee?</para>
  <para style="q2" vid="PSA 114:5">Yordan, adɛn, na wosan wʼakyi?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>Mmepɔw, adɛn, na muhuruhuruw sɛ adwennini,</para>
  <para style="q2" vid="PSA 114:6">na mo nkoko, muhuruhuruw sɛ nguantenmma yi?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>Asase, ma wo ho mpopo wɔ <char style="nd">Awurade</char> anim,</para>
  <para style="q2" vid="PSA 114:7">wɔ Yakob Nyankopɔn anim,<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>ɔno na ɔmaa ɔbotan no dan asubura,</para>
  <para style="q2" vid="PSA 114:8">na ɔbotan dennen dan nsuwa aniwa no.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">Dwom 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Ɛnyɛ yɛn, <char style="nd">Awurade</char>, ɛnyɛ yɛn,</para>
  <para style="q2" vid="PSA 115:1">na wo din na anuonyam nka,</para>
  <para style="q2" vid="PSA 115:1">wʼadɔe ne wo nokwaredi nti.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Adɛn nti na aman no bisa se,</para>
  <para style="q2" vid="PSA 115:2">“Wɔn Nyankopɔn wɔ he?”<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Yɛn Nyankopɔn wɔ ɔsoro;</para>
  <para style="q2" vid="PSA 115:3">nea ɔpɛ biara na ɔyɛ.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>Nanso wɔn ahoni yɛ dwetɛ ne sikakɔkɔɔ a</para>
  <para style="q2" vid="PSA 115:4">wɔde onipa nsa na ayɛ.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Wɔwɔ ano, nanso wontumi nkasa;</para>
  <para style="q2" vid="PSA 115:5">wɔwɔ ani, nanso wonhu ade.<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>Wɔwɔ aso, nanso wɔnte asɛm;</para>
  <para style="q2" vid="PSA 115:6">wɔwɔ hwene, nanso wɔnte hua.<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>Wɔwɔ nsa, nanso wɔnte nka;</para>
  <para style="q2" vid="PSA 115:7">wɔwɔ anan, nanso wɔnnantew.</para>
  <para style="q1" vid="PSA 115:7">Wontumi mma nnyigyei bi mfi wɔn mene mu.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,</para>
  <para style="q2" vid="PSA 115:8">saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>Mo Israelfo nyinaa, momfa mo ho nto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 115:9">ɔyɛ mo boafo ne kyɛm.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>Ao Aaronfi, momfa mo ho nto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 115:10">ɔyɛ mo boafo ne kyɛm.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Mo a musuro no, momfa mo ho nto <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 115:11">ɔyɛ mo boafo ne kyɛm.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>
    <char style="nd">Awurade</char> kae yɛn na obehyira yɛn:</para>
  <para style="q2" vid="PSA 115:12">Obehyira Israelfi,</para>
  <para style="q2" vid="PSA 115:12">obehyira Aaronfi<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>Obehyira wɔn a wosuro <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 115:13">nketewa ne akɛse nyinaa.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>
    <char style="nd">Awurade</char> mma wʼase nnɔ,</para>
  <para style="q2" vid="PSA 115:14">wo ne wo mma.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>
    <char style="nd">Awurade</char> nhyira wo,</para>
  <para style="q2" vid="PSA 115:15">ɔsoro ne asase Yɛfo no.<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Ɔsorosoro tɔnn yɛ <char style="nd">Awurade</char> de,</para>
  <para style="q2" vid="PSA 115:16">nanso asase de, ɔde ama onipa.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Ɛnyɛ awufo na wɔkamfo <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 115:17">wɔn a wɔkɔ fam dinn no.<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>Yɛn na yɛma <char style="nd">Awurade</char> so</para>
  <para style="q2" vid="PSA 115:18">nnɛ ne daa nyinaa.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">Dwom 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>Medɔ <char style="nd">Awurade</char> efisɛ, ɔtee me nne.</para>
  <para style="q2" vid="PSA 116:1">Ɔtee me mmɔborɔsu.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>Esiane sɛ ɔbrɛɛ nʼaso ase maa me nti,</para>
  <para style="q2" vid="PSA 116:2">mɛfrɛ no wɔ bere a mete ase yi.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Owu ahama bebaree me,</para>
  <para style="q2" vid="PSA 116:3">ɔda ho yawdi baa me so,</para>
  <para style="q2" vid="PSA 116:3">ɔhaw ne awerɛhow hyɛɛ me so.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>Afei mebɔɔ <char style="nd">Awurade</char> din kae se,</para>
  <para style="q2" vid="PSA 116:4">“<char style="nd">Awurade</char>, gye me nkwa!”<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>
    <char style="nd">Awurade</char> yɛ ɔdomfo ne ɔtreneeni;</para>
  <para style="q2" vid="PSA 116:5">ayamhyehye ahyɛ yɛn Nyankopɔn ma.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>
    <char style="nd">Awurade</char> bɔ ɔwɛmfo ho ban;</para>
  <para style="q2" vid="PSA 116:6">bere a mewɔ ahohia mu no, ogyee me.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>Nya abotɔyam bio, me kra,</para>
  <para style="q2" vid="PSA 116:7">efisɛ <char style="nd">Awurade</char> ne wo adi no yiye.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>Na wo, <char style="nd">Awurade</char>, woagye me kra afi owu mu;</para>
  <para style="q2" vid="PSA 116:8">woamma mʼani amporow nisu,</para>
  <para style="q2" vid="PSA 116:8">na woamma mʼanan anhintiw<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>sɛ mɛnantew <char style="nd">Awurade</char> anim</para>
  <para style="q2" vid="PSA 116:9">wɔ ateasefo asase so.<verse eid="PSA 116:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Migye dii; ɛno nti mekae se,</para>
  <para style="q2" vid="PSA 116:10">“Mewɔ ahohia kɛse mu.”<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Na mʼahokyere mu mekae se,</para>
  <para style="q2" vid="PSA 116:11">“Nnipa nyinaa yɛ atorofo.”<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>Dɛn na metumi de atua <char style="nd">Awurade</char> ka</para>
  <para style="q2" vid="PSA 116:12">wɔ ne papa a wayɛ me nyinaa?<verse eid="PSA 116:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Mɛma nkwagye kuruwa no so</para>
  <para style="q2" vid="PSA 116:13">na mabɔ <char style="nd">Awurade</char> din.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Medi bɔ a mahyɛ <char style="nd">Awurade</char> no nyinaa so</para>
  <para style="q2" vid="PSA 116:14">wɔ ne nkurɔfo nyinaa anim.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Awurade nkoa nokwafo wu</para>
  <para style="q2" vid="PSA 116:15">som bo wɔ <char style="nd">Awurade</char> ani so.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>
    <char style="nd">Awurade</char>, ampa ara meyɛ wo somfo;</para>
  <para style="q2" vid="PSA 116:16">meyɛ wo somfo, wʼafenaa babarima;</para>
  <para style="q2" vid="PSA 116:16">woayi me afi me mpokyerɛ mu.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Mɛbɔ aseda afɔre ama wo</para>
  <para style="q2" vid="PSA 116:17">na mabɔ <char style="nd">Awurade</char> din.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Medi me ntam a maka <char style="nd">Awurade</char> no so</para>
  <para style="q2" vid="PSA 116:18">wɔ ne nkurɔfo nyinaa anim,<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>wɔ adiwo a ɛwɔ <char style="nd">Awurade</char> fi no,</para>
  <para style="q2" vid="PSA 116:19">wɔ wʼanim, Yerusalem.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">Dwom 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>Mo aman nyinaa, monkamfo <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 117:1">mo nnipa nyinaa, momma ne din so.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Na nʼadɔe so wɔ yɛn so,</para>
  <para style="q2" vid="PSA 117:2">na <char style="nd">Awurade</char> nokwaredi wɔ hɔ daa.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">Dwom 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>Monna <char style="nd">Awurade</char> ase efisɛ oye,</para>
  <para style="q2" vid="PSA 118:1">na nʼadɔe wɔ hɔ daa.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Momma Israel nka se,</para>
  <para style="q2" vid="PSA 118:2">“Nʼadɔe wɔ hɔ daa.”<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Momma Aaronfi nka se,</para>
  <para style="q2" vid="PSA 118:3">“Nʼadɔe wɔ hɔ daa.”<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Momma wɔn a wosuro <char style="nd">Awurade</char> nka se,</para>
  <para style="q2" vid="PSA 118:4">“Nʼadɔe wɔ hɔ daa.”<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Mʼahohia mu, misu frɛɛ <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 118:5">ogyee me so, na ɔma me dee me ho.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>
    <char style="nd">Awurade</char> ne me boafo; enti merensuro.</para>
  <para style="q2" vid="PSA 118:6">Dɛn na onipa betumi ayɛ me?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>
    <char style="nd">Awurade</char> ne me wɔ hɔ; ɔyɛ me boafo.</para>
  <para style="q2" vid="PSA 118:7">Mede nkonimdi bɛhwɛ mʼatamfo.<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Eye sɛ yebehintaw wɔ <char style="nd">Awurade</char> mu,</para>
  <para style="q2" vid="PSA 118:8">sen sɛ yɛde yɛn ho bɛto onipa so.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Eye sɛ yebehintaw <char style="nd">Awurade</char> mu,</para>
  <para style="q2" vid="PSA 118:9">sen sɛ yɛde yɛn ho bɛto mmapɔmma so.<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Amanaman no nyinaa twaa me ho hyiae,</para>
  <para style="q2" vid="PSA 118:10">nanso <char style="nd">Awurade</char> din mu mitwitwaa wɔn gui.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Wotwaa me ho hyiaa wɔ baabiara,</para>
  <para style="q2" vid="PSA 118:11">nanso <char style="nd">Awurade</char> din mu, mitwitwaa wɔn gui.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Wɔkyere guu me so sɛ nnowa,</para>
  <para style="q2" vid="PSA 118:12">nanso wɔhyew ntɛm so sɛ nsɔe a ogya atɔ mu;</para>
  <para style="q2" vid="PSA 118:12">
    <char style="nd">Awurade</char> din mu mitwitwaa wɔn gui.<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Wosum me kɔɔ mʼakyi a anka mereyɛ ahwe ase,</para>
  <para style="q2" vid="PSA 118:13">nanso <char style="nd">Awurade</char> boaa me.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>
    <char style="nd">Awurade</char> yɛ mʼahoɔden ne me bammɔ;</para>
  <para style="q2" vid="PSA 118:14">wayɛ me nkwagye.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Osebɔ ne nkonimdi</para>
  <para style="q2" vid="PSA 118:15">gyigye wɔ atreneefo ntamadan mu se,</para>
  <para style="q1" vid="PSA 118:15">“<char style="nd">Awurade</char> nsa nifa ayɛ nneɛma akɛse!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>Wɔama <char style="nd">Awurade</char> nsa nifa so;</para>
  <para style="q2" vid="PSA 118:16">
    <char style="nd">Awurade</char> nsa nifa ayɛ nneɛma akɛse!”<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Merenwu, mmom mɛtena ase</para>
  <para style="q2" vid="PSA 118:17">na mapae mu aka nea <char style="nd">Awurade</char> ayɛ.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>
    <char style="nd">Awurade</char> atwe mʼaso dennen,</para>
  <para style="q2" vid="PSA 118:18">nanso onyaa me mmaa owu ɛ.<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Bue trenee apon ma me;</para>
  <para style="q2" vid="PSA 118:19">na mɛhyɛn mu na mede aseda ama <char style="nd">Awurade</char>.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>
    <char style="nd">Awurade</char> ponkɛse ni;</para>
  <para style="q2" vid="PSA 118:20">ɛhɔ na atreneefo bɛfa ahyɛn mu.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Mɛda wo ase, efisɛ wugyee me so;</para>
  <para style="q2" vid="PSA 118:21">na woayɛ me nkwagye.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>Ɔbo a adansifo no poe no,</para>
  <para style="q2" vid="PSA 118:22">abɛyɛ tweatibo.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>
    <char style="nd">Awurade</char> na wayɛ eyi,</para>
  <para style="q2" vid="PSA 118:23">na ɛyɛ nwonwa wɔ yɛn ani so.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Nnɛ yɛ da a <char style="nd">Awurade</char> ayɛ.</para>
  <para style="q2" vid="PSA 118:24">Momma yɛn ani nnye na yenni ahurusi.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>
    <char style="nd">Awurade</char>, gye yɛn nkwa;</para>
  <para style="q2" vid="PSA 118:25">
    <char style="nd">Awurade</char>, ma yɛn nkonimdi.<verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>Nhyira ne nea ɔnam <char style="nd">Awurade</char> din mu reba.</para>
  <para style="q2" vid="PSA 118:26">Yehyira wo fi <char style="nd">Awurade</char> fi.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>
    <char style="nd">Awurade</char> yɛ Onyankopɔn,</para>
  <para style="q2" vid="PSA 118:27">na wama ne hann ahyerɛn yɛn so.</para>
  <para style="q1" vid="PSA 118:27">Momfa nnua mman nkura na yɛnto afɔrebɔ santen</para>
  <para style="q2" vid="PSA 118:27">nkɔ afɔremuka no mmɛn ho.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Woyɛ me Nyankopɔn na meyi wo ayɛ;</para>
  <para style="q2" vid="PSA 118:28">wone me Nyankopɔn na mɛma wo so.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Monna <char style="nd">Awurade</char> ase, efisɛ oye;</para>
  <para style="q2" vid="PSA 118:29">na nʼadɔe wɔ hɔ daa.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">Dwom 119</para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>Nhyira nka wɔn a wɔn akwan yɛ pɛ,</para>
  <para style="q2" vid="PSA 119:1">na wɔnantew sɛnea <char style="nd">Awurade</char> mmara kyerɛ.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Nhyira nka wɔn a wɔkora nʼahyɛde,</para>
  <para style="q2" vid="PSA 119:2">na wofi wɔn koma nyinaa mu hwehwɛ no.<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>Wɔnyɛ mfomso biara;</para>
  <para style="q2" vid="PSA 119:3">na wɔnam nʼakwan so.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Woayɛ nkyerɛkyerɛ pa ato hɔ</para>
  <para style="q2" vid="PSA 119:4">a ɛsɛ sɛ wodi so pɛpɛɛpɛ.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>Ao, sɛ anka mʼakwan besi pi,</para>
  <para style="q2" vid="PSA 119:5">ayɛ osetie wɔ wo hyɛ nsɛm ho ɛ!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Sɛ midwen wo mmaransɛm no nyinaa ho a,</para>
  <para style="q2" vid="PSA 119:6">ɛno de, anka mʼanim rengu ase.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Mede koma a mu tew bɛkamfo wo</para>
  <para style="q2" vid="PSA 119:7">bere a meresua wo mmara a ɛteɛ no.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Medi wo hyɛ nsɛm so;</para>
  <para style="q2" vid="PSA 119:8">na nnyaw me korakora.<verse eid="PSA 119:8"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Ho Osetie</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Aberante bɛyɛ dɛn na nʼakwan ho atew?</para>
  <para style="q2" vid="PSA 119:9">Ɛsɛ sɛ odi wʼasɛm so.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Mede me koma nyinaa hwehwɛ wo;</para>
  <para style="q2" vid="PSA 119:10">mma me mman mfi wo mmara nsɛm ho.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Mede wʼasɛm asie me koma mu</para>
  <para style="q2" vid="PSA 119:11">sɛnea merenyɛ bɔne ntia wo.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>
    <char style="nd">Awurade</char>, ayeyi nka wo;</para>
  <para style="q2" vid="PSA 119:12">kyerɛkyerɛ me wo hyɛ nsɛm.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Mede mʼano ka mmara</para>
  <para style="q2" vid="PSA 119:13">a efi wʼanom nyinaa.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Mʼani gye sɛ midi wʼahyɛde so,</para>
  <para style="q2" vid="PSA 119:14">sɛnea obi ani gye ahonya bebree ho no.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Midwinnwen wo nkyerɛkyerɛ ho</para>
  <para style="q2" vid="PSA 119:15">na mehwehwɛ wʼakwan mu.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Mʼani gye wo hyɛ nsɛm ho;</para>
  <para style="q2" vid="PSA 119:16">na merentoto wʼasɛm ase.<verse eid="PSA 119:16"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Mu Ahotɔ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Yɛ wo somfo yiye;</para>
  <para style="q2" vid="PSA 119:17">na matena ase adi wʼasɛm so.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Bue mʼani na minhu anwonwade a</para>
  <para style="q2" vid="PSA 119:18">ɛwɔ wo mmara no mu.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Meyɛ ɔnanani wɔ asase so;</para>
  <para style="q2" vid="PSA 119:19">mfa wo mmaransɛm no nhintaw me.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Me kra tɔ beraw bere biara,</para>
  <para style="q2" vid="PSA 119:20">wo mmara ho anigyina nti.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Woka ahantanfo anim, wɔn a wɔadome wɔn,</para>
  <para style="q2" vid="PSA 119:21">na wɔman fi wo mmaransɛm ho no.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Yi wɔn animka ne animtiaabu fi me mu,</para>
  <para style="q2" vid="PSA 119:22">efisɛ midi wʼahyɛde so.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Ɛwɔ mu sɛ sodifo hyia di me ho nseku,</para>
  <para style="q2" vid="PSA 119:23">nanso wo somfo bedwinnwen wʼahyɛde ho.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Wʼahyɛde yɛ mʼanigyede</para>
  <para style="q2" vid="PSA 119:24">na ɛyɛ me fotufo.<verse eid="PSA 119:24"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Sodi Ho Bɔhyɛ</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Woabrɛ me ase ma meda mfutuma mu;</para>
  <para style="q2" vid="PSA 119:25">kyɛe me nkwa so sɛnea wʼasɛm no te.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Mesesee mʼakwan na wugyee me so;</para>
  <para style="q2" vid="PSA 119:26">kyerɛkyerɛ me wʼahyɛde.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Ma mente nea ɛwɔ wo nkyerɛkyerɛ mu ase;</para>
  <para style="q2" vid="PSA 119:27">na mesusuw wʼanwonwade ho.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Awerɛhow ama me kra atɔ beraw;</para>
  <para style="q2" vid="PSA 119:28">hyɛ me den sɛnea wʼasɛm no kyerɛ.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Yi me fi nnaadaa akwan so;</para>
  <para style="q2" vid="PSA 119:29">na fa wo mmara so dom me.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Mafa nokware kwan no so;</para>
  <para style="q2" vid="PSA 119:30">mede me koma abata wo mmara ho.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>
    <char style="nd">Awurade</char>, mikura wo nkyerɛkyerɛ mu dennen,</para>
  <para style="q2" vid="PSA 119:31">mma mʼanim ngu ase.<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Mitu mmirika wɔ wo mmaransɛm kwan no so,</para>
  <para style="q2" vid="PSA 119:32">efisɛ woama mʼadwene mu adɔ.<verse eid="PSA 119:32"/></para>
  <para style="s1">Ntease Ho Mpaebɔ</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>Kyerɛkyerɛ me, <char style="nd">Awurade</char>, na minni wo hyɛ nsɛm so,</para>
  <para style="q2" vid="PSA 119:33">na medi so akosi awiei.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Ma me ntease, na medi wo mmara so,</para>
  <para style="q2" vid="PSA 119:34">na mede me koma nyinaa bedi so.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Kyerɛ me wo mmaransɛm kwan no</para>
  <para style="q2" vid="PSA 119:35">na hɔ na minya anigye.<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Dan me koma kɔ wʼahyɛde ho</para>
  <para style="q2" vid="PSA 119:36">na ɛnyɛ pɛsɛmenkominya so mfaso ho.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Yi mʼani fi nneɛma hunu so;</para>
  <para style="q2" vid="PSA 119:37">na kyɛe me nkwa so sɛnea wʼasɛm te.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>Di bɔ a woahyɛ wo somfo no so,</para>
  <para style="q2" vid="PSA 119:38">na wasuro wo.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Yi animguase a ɛbɔ me hu no fi hɔ,</para>
  <para style="q2" vid="PSA 119:39">efisɛ wo mmara yɛ papa.<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Mʼani agyina wo nkyerɛkyerɛ no!</para>
  <para style="q2" vid="PSA 119:40">Kyɛe me nkwa so wɔ wo trenee mu.<verse eid="PSA 119:40"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Mu Ahotoso</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>
    <char style="nd">Awurade</char>, ma wo dɔ a ɛnsa da no mmra me so,</para>
  <para style="q2" vid="PSA 119:41">wo nkwagye no, sɛnea wo bɔhyɛ no te.<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>Afei mebua nea oyi me ahi no,</para>
  <para style="q2" vid="PSA 119:42">efisɛ mewɔ wʼasɛm mu ahotoso.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Nyi nokwasɛm no mfi mʼanom,</para>
  <para style="q2" vid="PSA 119:43">efisɛ mʼanidaso wɔ wo mmara mu.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Medi wo mmara so bere biara</para>
  <para style="q2" vid="PSA 119:44">akosi daa apem.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Mede ahofadi bɛnantew,</para>
  <para style="q2" vid="PSA 119:45">efisɛ mahwehwɛ wo nkyerɛkyerɛ.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Mɛka wʼahyɛde ho asɛm wɔ ahemfo anim</para>
  <para style="q2" vid="PSA 119:46">na wɔrengu mʼanim ase,<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>efisɛ mʼani gye wo mmaransɛm ho,</para>
  <para style="q2" vid="PSA 119:47">na medɔ no.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Mede nidi ma wo mmaransɛm a medɔ no,</para>
  <para style="q2" vid="PSA 119:48">na midwinnwen wo hyɛ nsɛm ho.<verse eid="PSA 119:48"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara No Mu Ahotoso</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Kae asɛm a woaka akyerɛ wo somfo,</para>
  <para style="q2" vid="PSA 119:49">efisɛ woama me anidaso.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Mʼawerɛkyekye wɔ mʼamanehunu mu ne sɛ:</para>
  <para style="q2" vid="PSA 119:50">Wo bɔhyɛ kyɛe me nkwa so.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Ahantanfo bu me animtiaa bebree,</para>
  <para style="q2" vid="PSA 119:51">nanso mennan mfi wo mmara ho.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>
    <char style="nd">Awurade</char> mekae wo tete mmara no,</para>
  <para style="q2" vid="PSA 119:52">na minya awerɛkyekye wɔ mu.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Abufuw hyɛ me ma, esiane amumɔyɛfo</para>
  <para style="q2" vid="PSA 119:53">a wɔapo wo mmara nti.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Wo hyɛ nsɛm yɛ me dwom tiban</para>
  <para style="q2" vid="PSA 119:54">wɔ baabiara a mesoɛ.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>
    <char style="nd">Awurade</char>, anadwo mekae wo din,</para>
  <para style="q2" vid="PSA 119:55">na medi wo mmara so.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Eyi ne ade a meyɛ da biara,</para>
  <para style="q2" vid="PSA 119:56">midi wo nkyerɛkyerɛ so.<verse eid="PSA 119:56"/></para>
  <para style="s1">Ahofama Wɔ <char style="nd">Awurade</char> Mmara Sodi Mu</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>
    <char style="nd">Awurade</char>, wo ne me kyɛfa;</para>
  <para style="q2" vid="PSA 119:57">mahyɛ bɔ sɛ medi wo nsɛm so.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Mede me koma nyinaa ahwehwɛ wo;</para>
  <para style="q2" vid="PSA 119:58">hu me mmɔbɔ sɛnea wo bɔhyɛ no te.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Madwene mʼakwan ho</para>
  <para style="q2" vid="PSA 119:59">na madan mʼanammɔntu akyerɛ wʼahyɛde.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Mɛyɛ ntɛm, merentwentwɛn</para>
  <para style="q2" vid="PSA 119:60">sɛ medi wo mmara nsɛm so.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Ɛwɔ mu, amumɔyɛfo de hama kyekyere me,</para>
  <para style="q2" vid="PSA 119:61">nanso me werɛ remfi wo mmara.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Ɔdasu mu, mesɔre de wʼaseda ma wo,</para>
  <para style="q2" vid="PSA 119:62">wo mmara a ɛteɛ nti.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Meyɛ wɔn a wosuro wo nyinaa adamfo,</para>
  <para style="q2" vid="PSA 119:63">wɔn a wodi wo nkyerɛkyerɛ so nyinaa.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>
    <char style="nd">Awurade</char>, wʼadɔe ahyɛ asase so ma;</para>
  <para style="q2" vid="PSA 119:64">kyerɛkyerɛ me wo hyɛ nsɛm.<verse eid="PSA 119:64"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Sodi So Mfaso</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Wo ne wo somfo nni no yiye</para>
  <para style="q2" vid="PSA 119:65">sɛnea wʼasɛm te, <char style="nd">Awurade</char>.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Kyerɛkyerɛ me nimdeɛ ne atemmu pa,</para>
  <para style="q2" vid="PSA 119:66">efisɛ migye wo mmara nsɛm no di.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Mefom ɔkwan ansa na mihuu amane,</para>
  <para style="q2" vid="PSA 119:67">na mprempren de midi wʼasɛm so.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Wuye, na nea woyɛ nso ye;</para>
  <para style="q2" vid="PSA 119:68">kyerɛkyerɛ me wo hyɛ nsɛm.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Ahantanfo de atoro asra me ho de,</para>
  <para style="q2" vid="PSA 119:69">nanso mede me koma nyinaa di wo nkyerɛkyerɛ so.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Wɔn koma yɛ den na wonni ɔtema,</para>
  <para style="q2" vid="PSA 119:70">nanso mʼani gye wo mmara ho.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Eye sɛ mihuu amane</para>
  <para style="q2" vid="PSA 119:71">sɛnea mesua wo hyɛ nsɛm.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Mmara a efi wʼanom no som bo ma me</para>
  <para style="q2" vid="PSA 119:72">sen dwetɛ ne sikakɔkɔɔ mpem mpem.<verse eid="PSA 119:72"/></para>
  <para style="s1">Nokware A Ɛwɔ <char style="nd">Awurade</char> Mmara Mu</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Wo nsa na ɛbɔɔ me na ɛnwenee me;</para>
  <para style="q2" vid="PSA 119:73">ma me ntease a mede besua wo mmara nsɛm.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Sɛ wɔn a wosuro wo no hu me a, ma wɔn ani nnye,</para>
  <para style="q2" vid="PSA 119:74">efisɛ mede mʼanidaso ahyɛ wʼasɛm mu.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>
    <char style="nd">Awurade</char>, minim sɛnea wo mmara te,</para>
  <para style="q2" vid="PSA 119:75">na nokwaredi mu na woatwe mʼaso.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Ma wʼadɔe a ɛnsa da no nkyekye me werɛ</para>
  <para style="q2" vid="PSA 119:76">sɛnea bɔ a woahyɛ wo somfo no te no.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Ma wʼayamhyehye mmra me so, na minnya nkwa,</para>
  <para style="q2" vid="PSA 119:77">efisɛ mʼani ka wo mmara ho.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Ma ahantanfo ani nwu sɛ wɔfom me kwa nti</para>
  <para style="q2" vid="PSA 119:78">nanso mesusuw wo nkyerɛkyerɛ ho.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>Ma wɔn a wosuro wo no mmra me nkyɛn,</para>
  <para style="q2" vid="PSA 119:79">wɔn a wɔte wo mmara ase no.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Ma me koma nnya bembu wɔ wo hyɛ nsɛm ho,</para>
  <para style="q2" vid="PSA 119:80">na mʼanim angu ase.<verse eid="PSA 119:80"/></para>
  <para style="s1">Ogye Mpaebɔ</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Wo nkwagye ho anigyina ama me kra atɔ piti,</para>
  <para style="q2" vid="PSA 119:81">nanso mede mʼanidaso ahyɛ wʼasɛm mu.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Mahwɛ wo bɔhyɛ anim ama mʼani abu;</para>
  <para style="q2" vid="PSA 119:82">meka se, “Da bɛn na wobɛkyekye me werɛ?”<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Ɛwɔ mu sɛ mete sɛ nsa kotoku a ɛsɛn wusiw ano de,</para>
  <para style="q2" vid="PSA 119:83">nanso me werɛ mfi wo hyɛ nsɛm no.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Wo somfo ntwɛn nkosi da bɛn?</para>
  <para style="q2" vid="PSA 119:84">Da bɛn na wobɛtwe wɔn a wɔtaa me no aso?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Ahantanfo atu amoa de asum me afiri,</para>
  <para style="q2" vid="PSA 119:85">a ɛne wo mmara bɔ abira.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Wo mmara nsɛm nyinaa mu wɔ ahotoso;</para>
  <para style="q2" vid="PSA 119:86">boa me, efisɛ nnipa taa me kwa.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Ɛkaa kakraa bi a anka woyii me fii asase so,</para>
  <para style="q2" vid="PSA 119:87">nanso minnyaee wo nkyerɛkyerɛ sodi.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Kyɛe me nkwa so sɛnea wʼadɔe te,</para>
  <para style="q2" vid="PSA 119:88">na medi nkyerɛkyerɛ a efi wʼanom no so.<verse eid="PSA 119:88"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Mu Gyidi</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>
    <char style="nd">Awurade</char>, wʼasɛm no wɔ hɔ daa;</para>
  <para style="q2" vid="PSA 119:89">egyina hɔ pintinn wɔ ɔsorosoro.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Wo nokwaredi kɔ so wɔ awo ntoatoaso nyinaa mu;</para>
  <para style="q2" vid="PSA 119:90">wode asase sii hɔ, na etim hɔ.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Wo mmara wɔ hɔ besi nnɛ,</para>
  <para style="q2" vid="PSA 119:91">na nneɛma nyinaa som wo.<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Sɛ mʼani anka wo mmara no ho a,</para>
  <para style="q2" vid="PSA 119:92">anka mʼamanehunu akum me.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Me werɛ remfi wo nkyerɛkyerɛ no,</para>
  <para style="q2" vid="PSA 119:93">efisɛ ɛno so na wonam akyɛe me nkwa so.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Gye me nkwa, na meyɛ wo de;</para>
  <para style="q2" vid="PSA 119:94">na mahwehwɛ wo nkyerɛkyerɛ no.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Amumɔyɛfo retwɛn sɛ wɔbɛsɛe me,</para>
  <para style="q2" vid="PSA 119:95">nanso, misusuw wʼahyɛde ho.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Mahu sɛ pɛyɛ nyinaa wɔ nea ɛkɔpem;</para>
  <para style="q2" vid="PSA 119:96">nanso wo mmara nsɛm no nni ɔhye.<verse eid="PSA 119:96"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Ho Dɔ</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>Ao, medɔ wo mmara no yiye!</para>
  <para style="q2" vid="PSA 119:97">Midwinnwen ho da mu nyinaa.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Wo mmara nsɛm ma mihu nyansa sen mʼatamfo,</para>
  <para style="q2" vid="PSA 119:98">efisɛ ɛwɔ me nkyɛn daa.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Mewɔ nhumu sen mʼakyerɛkyerɛfo nyinaa,</para>
  <para style="q2" vid="PSA 119:99">efisɛ midwinnwen wʼahyɛde ho.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Mewɔ ntease sen mpanyimfo,</para>
  <para style="q2" vid="PSA 119:100">efisɛ midi wo nkyerɛkyerɛ so.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Memfaa mʼanan nsii ɔkwan bɔne biara so</para>
  <para style="q2" vid="PSA 119:101">sɛnea metumi ayɛ osetie ama wʼasɛm.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Memman mfii wo mmara ho,</para>
  <para style="q2" vid="PSA 119:102">efisɛ wʼankasa na woakyerɛkyerɛ me.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>Wo nsɛm yɛ me dɛ,</para>
  <para style="q2" vid="PSA 119:103">ɛyɛ dɛ sen ɛwo wɔ mʼanom.<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Minya ntease fi wo nkyerɛkyerɛ mu;</para>
  <para style="q2" vid="PSA 119:104">enti mikyi ɔkwan bɔne biara.<verse eid="PSA 119:104"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Yɛ Kanea</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Wʼasɛm yɛ mʼanan ase kanea</para>
  <para style="q2" vid="PSA 119:105">ne me kwan so hann.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Maka ntam ahyɛ mu kena se</para>
  <para style="q2" vid="PSA 119:106">medi wo trenee mmara no so.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Mahu amane bebree;</para>
  <para style="q2" vid="PSA 119:107">kyɛe me nkwa so, <char style="nd">Awurade</char>, sɛnea wʼasɛm te.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>
    <char style="nd">Awurade</char>, ma wʼani nsɔ mʼanom nkamfo a efi me pɛ mu,</para>
  <para style="q2" vid="PSA 119:108">na kyerɛkyerɛ me wo mmara.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Ɛwɔ mu sɛ daa metoto me nkwa ase de,</para>
  <para style="q2" vid="PSA 119:109">nanso me werɛ remfi wo mmara.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Amumɔyɛfo asum me afiri,</para>
  <para style="q2" vid="PSA 119:110">nanso memfom mfii wo nkyerɛkyerɛ ho.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Wʼahyɛde yɛ mʼagyapade afebɔɔ;</para>
  <para style="q2" vid="PSA 119:111">ɛma me koma ani gye.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Me koma ayɛ krado sɛ ɛbɛhwɛ wo hyɛ nsɛm so</para>
  <para style="q2" vid="PSA 119:112">akosi awiei.<verse eid="PSA 119:112"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Mu Bammɔ</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Mikyi nnipa a wɔn adwene yɛ wɔn ntanta,</para>
  <para style="q2" vid="PSA 119:113">na medɔ wo mmara.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Wone me guankɔbea ne me kyɛm;</para>
  <para style="q2" vid="PSA 119:114">mede mʼanidaso ahyɛ wʼasɛm mu.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Mumfi me so nkɔ, mo nnebɔneyɛfo,</para>
  <para style="q2" vid="PSA 119:115">na minni me Nyankopɔn mmara nsɛm so!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Wowaw me sɛnea wo bɔhyɛ no te, na mɛtena nkwa mu;</para>
  <para style="q2" vid="PSA 119:116">mma mʼanidaso nyɛ ɔkwa.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>So me mu, na menya ogye;</para>
  <para style="q2" vid="PSA 119:117">na bere biara mɛhwɛ wo hyɛ nsɛm no.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Wopo wɔn a wɔfom wo hyɛ nsɛm nyinaa,</para>
  <para style="q2" vid="PSA 119:118">na wɔn nnaadaa no yɛ ɔkwa.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Wotow amumɔyɛfo nyinaa gu sɛ afide;</para>
  <para style="q2" vid="PSA 119:119">enti medɔ wʼahyɛde.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Wo ho suro ma me ho popo;</para>
  <para style="q2" vid="PSA 119:120">wo mmara abɔ me hu.<verse eid="PSA 119:120"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Ho Setie</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Mayɛ nea ɛteɛ na ɛyɛ pɛ.</para>
  <para style="q2" vid="PSA 119:121">Nnyaa me mma wɔn a wɔhyɛ me so!<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Hwɛ ma wo somfo nni yiye;</para>
  <para style="q2" vid="PSA 119:122">mma ahantanfo nhyɛ me so.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Mahwɛ wo nkwagye anim ama mʼani abu,</para>
  <para style="q2" vid="PSA 119:123">ɛrehwehwɛ wo bɔhyɛ a ɛteɛ no.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Wo ne wo somfo nni no sɛnea wʼadɔe te,</para>
  <para style="q2" vid="PSA 119:124">na kyerɛkyerɛ me wo hyɛ nsɛm.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Meyɛ wo somfo; ma me nhumu</para>
  <para style="q2" vid="PSA 119:125">na mate wʼahyɛde ase.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>
    <char style="nd">Awurade</char>, bere aso sɛ woyɛ biribi;</para>
  <para style="q2" vid="PSA 119:126">wɔrebu wo mmara so.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Esiane sɛ medɔ wo mmara nsɛm</para>
  <para style="q2" vid="PSA 119:127">sen sikakɔkɔɔ, anaa sikakɔkɔɔ ankasa,<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>na midwen sɛ wo nkyerɛkyerɛ nyinaa ye nti,</para>
  <para style="q2" vid="PSA 119:128">mikyi ɔkwan bɔne biara.<verse eid="PSA 119:128"/></para>
  <para style="s1">Pere Sɛ Wubedi <char style="nd">Awurade</char> Mmara So</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Wʼahyɛde yɛ nwonwa;</para>
  <para style="q2" vid="PSA 119:129">enti midi so.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Wo nsɛm asete ma hann;</para>
  <para style="q2" vid="PSA 119:130">na ɛma ntetekwaa nya ntease.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Mibue mʼanom na migu ahome,</para>
  <para style="q2" vid="PSA 119:131">na mʼani gyina wo mmara nsɛm.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Dan wʼani hwɛ me na hu me mmɔbɔ</para>
  <para style="q2" vid="PSA 119:132">sɛnea woyɛ daa ma wɔn a wɔdɔ wo din no.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Tutu mʼanammɔn sɛnea wʼasɛm no te;</para>
  <para style="q2" vid="PSA 119:133">mma bɔne biara nni me so.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Gye me fi nnipa nhyɛso mu,</para>
  <para style="q2" vid="PSA 119:134">na madi wo nkyerɛkyerɛ so.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Ma wʼanim nhyerɛn wo somfo so</para>
  <para style="q2" vid="PSA 119:135">na kyerɛkyerɛ me wo hyɛ nsɛm.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Nsuten nisu aguare me,</para>
  <para style="q2" vid="PSA 119:136">efisɛ nnipa nni wo mmara so.<verse eid="PSA 119:136"/></para>
  <para style="s1">
    <char style="nd">Awurade</char> Mmara Yɛ Pɛ</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>Ɔtreneeni ne wo, <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 119:137">na wo mmara nso yɛ pɛ.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Ahyɛde a woayɛ no yɛ trenee;</para>
  <para style="q2" vid="PSA 119:138">ɛyɛ nea wonya mu ahotoso pa ara.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Abufuw ahyɛ me ma,</para>
  <para style="q2" vid="PSA 119:139">efisɛ mʼatamfo bu wɔn ani gu wo nsɛm so.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Wɔasɔ wo bɔhyɛ ahorow no ahwɛ pa ara,</para>
  <para style="q2" vid="PSA 119:140">na wo somfo dɔ wɔn.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Ɛwɔ mu sɛ menka hwee na memfra de,</para>
  <para style="q2" vid="PSA 119:141">nanso me werɛ mfi wo nkyerɛkyerɛ.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Wo trenee wɔ hɔ daa,</para>
  <para style="q2" vid="PSA 119:142">na wo mmara no yɛ nokware.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Ɔhaw ne awerɛhow aba me so,</para>
  <para style="q2" vid="PSA 119:143">nanso wo mmara nsɛm ma me ahosɛpɛw.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Wʼahyɛde yɛ nokware daa;</para>
  <para style="q2" vid="PSA 119:144">ma me ntease na manya nkwa.<verse eid="PSA 119:144"/></para>
  <para style="s1">Ogye Mpaebɔ</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>
    <char style="nd">Awurade</char>, mede me koma nyinaa mefrɛ wo, gye me so,</para>
  <para style="q2" vid="PSA 119:145">na medi wo hyɛ nsɛm no so.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Misu mefrɛ wo, gye me nkwa</para>
  <para style="q2" vid="PSA 119:146">na midi wʼahyɛde so.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Mesɔre anɔpahema, na misu pɛ mmoa;</para>
  <para style="q2" vid="PSA 119:147">mede me werɛ ahyɛ wo nsɛm mu.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Mʼani gu so anadwo nyinaa,</para>
  <para style="q2" vid="PSA 119:148">na misusuw wo bɔhyɛ ho.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Tie me nne sɛnea wʼadɔe no te;</para>
  <para style="q2" vid="PSA 119:149">
    <char style="nd">Awurade</char>, kyɛe me nkwa so sɛnea wo mmara te.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Wɔn a wɔhyehyɛ atirimɔdensɛm no abɛn,</para>
  <para style="q2" vid="PSA 119:150">nanso wɔne wo mmara ntam ware.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>
    <char style="nd">Awurade</char>, wo de, wobɛn me,</para>
  <para style="q2" vid="PSA 119:151">na wo mmara nsɛm nyinaa yɛ nokware.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Mmere bi a atwa mu no, misuaa wʼahyɛde</para>
  <para style="q2" vid="PSA 119:152">a wode tim hɔ sɛ ɛntena hɔ daa no.<verse eid="PSA 119:152"/></para>
  <para style="s1">Mmoa Ho Mpaebɔ</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Hwɛ mʼamanehunu na gye me nkwa</para>
  <para style="q2" vid="PSA 119:153">efisɛ me werɛ mfii wo mmara no.<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Di mʼasɛm ma me na gye me;</para>
  <para style="q2" vid="PSA 119:154">kyɛe me nkwa so sɛnea wo bɔhyɛ no te.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Nkwagye ne atirimɔdenfo ntam kwan ware,</para>
  <para style="q2" vid="PSA 119:155">efisɛ wɔnhwehwɛ wo hyɛ nsɛm no.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>
    <char style="nd">Awurade</char>, wʼayamhyehye yɛ kɛse;</para>
  <para style="q2" vid="PSA 119:156">kyɛe me nkwa so sɛnea wo mmara no te.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Atamfo a wɔteetee me dɔɔso,</para>
  <para style="q2" vid="PSA 119:157">nanso memman mfii wo nhyehyɛe ho.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Mehwɛ wɔn a wonni gyidi no a wɔn ho yɛ me nwini,</para>
  <para style="q2" vid="PSA 119:158">efisɛ wonni wʼasɛm so.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Hwɛ sɛnea mʼani gye wo nkyerɛkyerɛ ho;</para>
  <para style="q2" vid="PSA 119:159">
    <char style="nd">Awurade</char>, kyɛe me nkwa so sɛnea wʼadɔe te.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Wo nsɛm nyinaa yɛ nokware;</para>
  <para style="q2" vid="PSA 119:160">na wo mmara a ɛteɛ no to rentwa da.<verse eid="PSA 119:160"/></para>
  <para style="s1">Nya Ahofama Ma <char style="nd">Awurade</char> Mmara</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Sodifo taataa me kwa,</para>
  <para style="q2" vid="PSA 119:161">nanso ɛyɛ wʼasɛm nko ara na misuro.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Mʼani gye wo bɔhyɛ ho</para>
  <para style="q2" vid="PSA 119:162">te sɛ obi a wanya asade kɛse.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Mikyi nkontompo</para>
  <para style="q2" vid="PSA 119:163">na medɔ wo mmara.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Mekamfo wo mpɛn ason da biara,</para>
  <para style="q2" vid="PSA 119:164">wo mmara a ɛteɛ no nti.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Wɔn a wɔdɔ wo mmara no wɔ asomdwoe mmoroso,</para>
  <para style="q2" vid="PSA 119:165">na biribiara rentumi mma wonhintiw.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>
    <char style="nd">Awurade</char>, metwɛn wo nkwagye,</para>
  <para style="q2" vid="PSA 119:166">na midi wo mmara nsɛm so.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Midi wʼahyɛde so</para>
  <para style="q2" vid="PSA 119:167">na medɔ no yiye.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Midi wo nkyerɛkyerɛ ne wʼahyɛde so,</para>
  <para style="q2" vid="PSA 119:168">na wunim mʼakwan nyinaa.<verse eid="PSA 119:168"/></para>
  <para style="s1">Mmoa Ho Mpaebɔ</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>
    <char style="nd">Awurade</char>, ma me sufrɛ nnu wʼanim;</para>
  <para style="q2" vid="PSA 119:169">ma me ntease sɛnea wʼasɛm no te.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Ma me nkotosrɛ nnu wʼanim;</para>
  <para style="q2" vid="PSA 119:170">na gye me sɛnea wo bɔhyɛ no te.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Ma nkamfo nhyɛ mʼanom ma;</para>
  <para style="q2" vid="PSA 119:171">efisɛ wokyerɛkyerɛ me wo hyɛ nsɛm.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Ma me tɛkrɛma nto wʼasɛm ho dwom,</para>
  <para style="q2" vid="PSA 119:172">efisɛ wo mmara nsɛm nyinaa yɛ trenee.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Ma wo nsa nyɛ krado mmɛboa me,</para>
  <para style="q2" vid="PSA 119:173">efisɛ maso wo nkyerɛkyerɛ no mu.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>
    <char style="nd">Awurade</char>, mʼani agyina wo nkwagye,</para>
  <para style="q2" vid="PSA 119:174">na wo mmara yɛ mʼanigyede.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Ma mentena nkwa mu na matumi akamfo wo,</para>
  <para style="q2" vid="PSA 119:175">na wo mmara nso awowaw me.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Mafom kwan sɛ oguan a wayera.</para>
  <para style="q2" vid="PSA 119:176">Hwehwɛ wo somfo,</para>
  <para style="q2" vid="PSA 119:176">efisɛ me werɛ mfii wo mmara nsɛm no ɛ.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">Dwom 120</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>Misu frɛ <char style="nd">Awurade</char> wɔ mʼahohiahia mu,</para>
  <para style="q2" vid="PSA 120:1">na ogye me so.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>
    <char style="nd">Awurade</char>, gye me fi atoro ano,</para>
  <para style="q2" vid="PSA 120:2">ne nnaadaa tɛkrɛma nsam.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Dɛn na ɔbɛyɛ wo,</para>
  <para style="q2" vid="PSA 120:3">na dɛn na ɛka ho bio, wo nnaadaa tɛkrɛma?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>Ɔde asraafo bɛmma a ano yɛ nnam</para>
  <para style="q2" vid="PSA 120:4">ne nnyansramma bɛtwe wʼaso.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Nnome nka me sɛ metena Mesek,</para>
  <para style="q2" vid="PSA 120:5">na mete Kedar ntamadan mu!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Matena wɔn a wokyi asomdwoe</para>
  <para style="q2" vid="PSA 120:6">mu akyɛ dodo.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Meyɛ asomdwoe nipa;</para>
  <para style="q2" vid="PSA 120:7">nanso sɛ mekasa a, wɔde yɛ ɔko.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">Dwom 121</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>Mema mʼani so kyerɛ mmepɔw no,</para>
  <para style="q2" vid="PSA 121:1">ɛhe na me mmoa fi bɛba?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Me mmoa fi <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 121:2">ɔsoro ne asase yɛfo no.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>Ɔremma wo nan nwatiri,</para>
  <para style="q2" vid="PSA 121:3">nea ɔhwɛ wo no rentɔ nko.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>Ampa ara, nea ɔhwɛ Israel no</para>
  <para style="q2" vid="PSA 121:4">rentɔ nko na ɔrenna.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>
    <char style="nd">Awurade</char> hwɛ wo so;</para>
  <para style="q2" vid="PSA 121:5">
    <char style="nd">Awurade</char> ne wo nwini wɔ wo nsa nifa so;<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>Owia rensɛe wo wɔ adekyee mu,</para>
  <para style="q2" vid="PSA 121:6">na ɔsram nso rensɛe wo anadwo.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>
    <char style="nd">Awurade</char> bɛbɔ wo ho ban afi ɔsɛe nyinaa ho,</para>
  <para style="q2" vid="PSA 121:7">ɔbɛhwɛ wo nkwa so;<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>
    <char style="nd">Awurade</char> bɛhwɛ wʼadifi ne wo fieba so</para>
  <para style="q2" vid="PSA 121:8">mprempren ne daa.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">Dwom 122</para>
  <para style="d">Ɔsoroforo dwom. Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>Me ne wɔn a wosee me sɛ,</para>
  <para style="q2" vid="PSA 122:1">“Ma yɛnkɔ <char style="nd">Awurade</char> fi” no ani gyei.<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Yegyinagyina wʼaponkɛse ano,</para>
  <para style="q2" vid="PSA 122:2">Yerusalem.<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Wɔakyekyere Yerusalem yiye sɛ kuropɔn</para>
  <para style="q2" vid="PSA 122:3">wahyehyɛ mu nneɛma fɛfɛ.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Ɛhɔ na mmusuakuw no kɔ,</para>
  <para style="q2" vid="PSA 122:4">
    <char style="nd">Awurade</char> mmusuakuw no,</para>
  <para style="q1" vid="PSA 122:4">Wɔkɔkamfo <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="PSA 122:4">sɛnea nhyehyɛe a wɔde ama Israel no te.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Ɛhɔ na atemmu nhengua no sisi,</para>
  <para style="q2" vid="PSA 122:5">Dawid fi nhengua no.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Monsrɛ asomdwoe mma Yerusalem se,</para>
  <para style="q2" vid="PSA 122:6">“Ma wɔn a wɔdɔ wo no nnya bammɔ.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Ma asomdwoe mmra wʼafasu mu</para>
  <para style="q2" vid="PSA 122:7">na bammɔ mmra wʼaban mu.”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Me nuanom ne me nnamfonom nti,</para>
  <para style="q2" vid="PSA 122:8">mɛka se, “Asomdwoe ntena wo mu.”<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>
    <char style="nd">Awurade</char> yɛn Nyankopɔn fi nti,</para>
  <para style="q2" vid="PSA 122:9">mɛhwehwɛ wo yiyeyɛ.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">Dwom 123</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>Mema mʼani so kyerɛ wo,</para>
  <para style="q2" vid="PSA 123:1">wo a wʼahengua si ɔsoro.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Sɛnea nkoa ani hwɛ wɔn wura nsa no,</para>
  <para style="q2" vid="PSA 123:2">sɛnea afenaa ani hwɛ nʼawuraa nsa no no,</para>
  <para style="q1" vid="PSA 123:2">saa ara na yɛn ani hwɛ <char style="nd">Awurade</char>, yɛn Nyankopɔn</para>
  <para style="q2" vid="PSA 123:2">kosi sɛ obehu yɛn mmɔbɔ.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Hu yɛn mmɔbɔ, <char style="nd">Awurade</char>, hu yɛn mmɔbɔ,</para>
  <para style="q2" vid="PSA 123:3">na wɔabu yɛn animtiaa bebree.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Ahomasofo fɛwdi ama yɛabrɛ dodo,</para>
  <para style="q2" vid="PSA 123:4">ahantanfo animtiaabu afono yɛn.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">Dwom 124</para>
  <para style="d">Ɔsoroforo dwom. Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>Sɛ anka <char style="nd">Awurade</char> nni yɛn afa a,</para>
  <para style="q2" vid="PSA 124:1">ma Israel nka,<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>Sɛ anka <char style="nd">Awurade</char> nni yɛn afa</para>
  <para style="q2" vid="PSA 124:2">bere a nnipa tow hyɛɛ yɛn so,<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>bere a wɔn abufuw sɔre tiaa yɛn a</para>
  <para style="q2" vid="PSA 124:3">anka wɔmemenee yɛn anikann;<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>anka nsuyiri no bebu afa yɛn so,</para>
  <para style="q2" vid="PSA 124:4">anka ɔhweam no bɛtwe yɛn akɔ,<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>anka nsu a ano yɛ den no</para>
  <para style="q2" vid="PSA 124:5">bɛpra yɛn kɔ.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Ayeyi nka <char style="nd">Awurade</char> a</para>
  <para style="q2" vid="PSA 124:6">wamma ho kwan amma wɔamfa wɔn se antetew yɛn mu.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Yɛaguan sɛ anomaa</para>
  <para style="q2" vid="PSA 124:7">afi ofirisumfo afiri mu;</para>
  <para style="q1" vid="PSA 124:7">wɔabubu afiri no,</para>
  <para style="q2" vid="PSA 124:7">ama yɛaguan.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Yɛn mmoa wɔ <char style="nd">Awurade</char> din mu,</para>
  <para style="q2" vid="PSA 124:8">ɔsoro ne asase Yɛfo no.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">Dwom 125</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Wɔn a wɔde wɔn ho to <char style="nd">Awurade</char> so no te sɛ Bepɔw Sion,</para>
  <para style="q2" vid="PSA 125:1">a ɛnwosow na etim hɔ daa no.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Sɛnea mmepɔw atwa Yerusalem ho ahyia no,</para>
  <para style="q2" vid="PSA 125:2">saa ara na <char style="nd">Awurade</char> atwa ne nkurɔfo ho ahyia</para>
  <para style="q2" vid="PSA 125:2">mprempren ne daa.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Amumɔyɛfo ahempema renka asase a</para>
  <para style="q2" vid="PSA 125:3">wɔde ama atreneefo no so,</para>
  <para style="q1" vid="PSA 125:3">sɛ ɛba saa a, atreneefo</para>
  <para style="q2" vid="PSA 125:3">nam wɔn so bɛyɛ bɔne.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>
    <char style="nd">Awurade</char> wɔn a wɔyɛ papa no, yɛ wɔn papa,</para>
  <para style="q2" vid="PSA 125:4">wɔn a wɔteɛ wɔ koma mu no, yɛ wɔn papa.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Na wɔn a wɔman fa akwan kɔntɔnkye so no de,</para>
  <para style="q2" vid="PSA 125:5">
    <char style="nd">Awurade</char> betwa wɔn ne nnebɔneyɛfo asu.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">Asomdwoe nka Israel.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">Dwom 126</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>Bere a <char style="nd">Awurade</char> de Sion fi nnommum san bae no,</para>
  <para style="q2" vid="PSA 126:1">yɛyɛɛ sɛ wɔn a wɔsosoo adae.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Ɔserew hyɛɛ yɛn anom ma,</para>
  <para style="q2" vid="PSA 126:2">anigye nnwom hyɛɛ yɛn tɛkrɛma so ma.</para>
  <para style="q1" vid="PSA 126:2">Na wɔkaa wɔ amanaman no mu se,</para>
  <para style="q2" vid="PSA 126:2">“<char style="nd">Awurade</char> ayɛ nneɛma akɛse ama wɔn.”<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>
    <char style="nd">Awurade</char> ayɛ nneɛma akɛse ama yɛn,</para>
  <para style="q2" vid="PSA 126:3">na anigye ahyɛ yɛn ma.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>
    <char style="nd">Awurade</char>, san fa yɛn siade ma yɛn,</para>
  <para style="q2" vid="PSA 126:4">te sɛ nsuwansuwa a ɛwɔ Negeb no.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Wɔn a wodua no nusu mu no</para>
  <para style="q2" vid="PSA 126:5">de anigye nnwom betwa.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Wɔn a wɔde osu fi adi</para>
  <para style="q2" vid="PSA 126:6">so aba a wɔrekodua no,</para>
  <para style="q1" vid="PSA 126:6">de anigye nnwom bɛsan aba</para>
  <para style="q2" vid="PSA 126:6">a wɔsoso nnɔbae afiafi.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">Dwom 127</para>
  <para style="d">Ɔsoroforo dwom. Salomo de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>Sɛ <char style="nd">Awurade</char> ansi ɔdan no a,</para>
  <para style="q2" vid="PSA 127:1">adansifo no yɛ ho adwuma kwa.</para>
  <para style="q1" vid="PSA 127:1">Sɛ <char style="nd">Awurade</char> ammɔ kuropɔn no ho ban a,</para>
  <para style="q2" vid="PSA 127:1">awɛmfo no wɛn kwa.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Sɛ wosɔre anɔpahema</para>
  <para style="q2" vid="PSA 127:2">na wotena kosi anadwo,</para>
  <para style="q1" vid="PSA 127:2">na woyɛ adwumaden pɛ wʼano aduan a,</para>
  <para style="q2" vid="PSA 127:2">ɛyɛ ɔkwa, efisɛ wɔn a ɔdɔ wɔn no, ɔma wɔn wɔ wɔn nnae mu.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Mma yɛ agyapade a efi <char style="nd">Awurade</char> hɔ,</para>
  <para style="q2" vid="PSA 127:3">na mma yɛ akatua a efi no.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Mma a wɔwo wɔn mmabun bere mu no</para>
  <para style="q2" vid="PSA 127:4">te sɛ agyan a ɛhyɛ ɔsraani nsam.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Nhyira ne onipa a</para>
  <para style="q2" vid="PSA 127:5">nʼagyan kotoku ayɛ ma.</para>
  <para style="q1" vid="PSA 127:5">Nʼanim rengu ase</para>
  <para style="q2" vid="PSA 127:5">bere a wahyia nʼatamfo wɔ kurow pon ano no.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">Dwom 128</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>Nhyira ne wɔn a wosuro <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 128:1">na wɔnantew nʼakwan so.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Wubedi wʼadwuma so aba;</para>
  <para style="q2" vid="PSA 128:2">nhyira ne yiyedi bɛyɛ wo de.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Wo yere bɛyɛ sɛ bobe a ɛsow aba</para>
  <para style="q2" vid="PSA 128:3">wɔ wo fi;</para>
  <para style="q1" vid="PSA 128:3">na wo mmabarima ayɛ sɛ ngodua a afifi</para>
  <para style="q2" vid="PSA 128:3">atwa wo pon ho ahyia.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Yiw, sɛɛ ne nea wobehyira</para>
  <para style="q2" vid="PSA 128:4">onipa a osuro <char style="nd">Awurade</char> no.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>
    <char style="nd">Awurade</char> nhyira wo mfi Sion</para>
  <para style="q2" vid="PSA 128:5">na ɔmma wunhu Yerusalem yiyeyɛ;</para>
  <para style="q2" vid="PSA 128:5">wo nkwanna nyinaa.<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>Ɔmma wo ntena ase nhu wo mma mma.</para>
  <para style="q2" vid="PSA 128:6">Asomdwoe nka Israel.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">Dwom 129</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>“Wɔahyɛ me so pii afi me mmofraase,</para>
  <para style="q2" vid="PSA 129:1">ma Israel nka ɛ.<verse eid="PSA 129:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>“Wɔahyɛ me so pii afi me mmofraase,</para>
  <para style="q2" vid="PSA 129:2">nanso wontumi nnii me so nkonim ɛ.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Fɛntɛmfo afɛntɛm mʼakyi</para>
  <para style="q2" vid="PSA 129:3">ayɛ wɔn nkɔmoa atenten.<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>Nanso <char style="nd">Awurade</char> yɛ ɔtreneeni;</para>
  <para style="q2" vid="PSA 129:4">watwitwa amumɔyɛfo hama afi me ho ama made me ho.”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Ma wɔn a wɔtan Sion nyinaa</para>
  <para style="q2" vid="PSA 129:5">mfa animguase nsan wɔn akyi.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Ma wɔnnyɛ sɛ sare a ɛwɔ ɔdan atifi,</para>
  <para style="q1" vid="PSA 129:6">a ennyin na ɛhyew;<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>na nnɔbaetwafo ntumi nnya biribi mfi mu nhyɛ ne nsa ma,</para>
  <para style="q2" vid="PSA 129:7">na nea ɔboaboa ano nso nnya hwee nhyɛ nʼabasa ma.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Mma wɔn a wotwa mu wɔ hɔ no nka se,</para>
  <para style="q2" vid="PSA 129:8">“<char style="nd">Awurade</char> nhyira mmra mo so;</para>
  <para style="q2" vid="PSA 129:8">yehyira mo wɔ <char style="nd">Awurade</char> din mu.”<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">Dwom 130</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>
    <char style="nd">Awurade</char>, mifi bun mu su frɛ wo;<verse eid="PSA 130:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2"/>
    <char style="nd">Awurade</char>, tie me nne.</para>
  <para style="q1" vid="PSA 130:2">Wɛn wʼaso</para>
  <para style="q2" vid="PSA 130:2">ma me nkotosrɛ.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>
    <char style="nd">Awurade</char>, sɛ wubu yɛn bɔne ho nkontaa a,</para>
  <para style="q2" vid="PSA 130:3">anka hena na obetumi agyina ano?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Nanso wowɔ bɔnefakyɛ;</para>
  <para style="q2" vid="PSA 130:4">ɛno nti wosuro wo.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Metwɛn <char style="nd">Awurade</char>, me mu ade nyinaa twɛn,</para>
  <para style="q2" vid="PSA 130:5">na nʼasɛm mu na mede mʼanidaso ahyɛ.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Metwɛn <char style="nd">Awurade</char></para>
  <para style="q2" vid="PSA 130:6">sen sɛnea awɛmfo twɛn adekyee,</para>
  <para style="q2" vid="PSA 130:6">sen sɛnea awɛmfo twɛn adekyee.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>Israel, ma wʼani nna <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 130:7">efisɛ <char style="nd">Awurade</char> wɔ adɔe a enni huammɔ</para>
  <para style="q2" vid="PSA 130:7">na ogye ankasa wɔ ne mu.<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>Ɔno ankasa begye Israel</para>
  <para style="q2" vid="PSA 130:8">afi wɔn bɔne nyinaa mu.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">Dwom 131</para>
  <para style="d">Ɔsoroforo dwom. Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>
    <char style="nd">Awurade</char>, ahomaso nni me koma mu,</para>
  <para style="q2" vid="PSA 131:1">na mʼani ntraa me ntɔn ɛ;</para>
  <para style="q1" vid="PSA 131:1">memma nsɛm akɛse nhaw me</para>
  <para style="q2" vid="PSA 131:1">anaa nsɛm a ɛyɛ nwonwa dodo ma me.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>Na mmom, mama me kra anya abotɔyam</para>
  <para style="q2" vid="PSA 131:2">te sɛ akokoaa a ɔda ne na so renum no,</para>
  <para style="q1" vid="PSA 131:2">te sɛ akokoaa a otua nufu ano no,</para>
  <para style="q2" vid="PSA 131:2">saa ara na me kra ayɛ wɔ me mu.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>Israel, ma wʼani nna <char style="nd">Awurade</char> so,</para>
  <para style="q2" vid="PSA 131:3">mprempren ne daa nyinaa.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">Dwom 132</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>
    <char style="nd">Awurade</char> kae Dawid</para>
  <para style="q2" vid="PSA 132:1">ne ɔhaw ahorow a ogyinaa ano no.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>Ɔkaa <char style="nd">Awurade</char> ntam,</para>
  <para style="q2" vid="PSA 132:2">na ɔhyɛɛ nea ɔyɛ Otumfo ma Yakob no bɔ se,<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“Merenhyɛn me fi</para>
  <para style="q2" vid="PSA 132:3">na merenkɔda me mpa so,<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>meremma nna mmfa me</para>
  <para style="q2" vid="PSA 132:4">na meremma mʼani nkum,<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>kosi sɛ menya baabi ama <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 132:5">baabi a nea ɔyɛ Otumfo ma Yakob No bɛtena.”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Yɛtee wɔ Efrata,</para>
  <para style="q2" vid="PSA 132:6">yɛbɛtoo so wɔ Yaar mfuw so.<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“Momma yɛnkɔ nʼatenae;</para>
  <para style="q2" vid="PSA 132:7">momma yɛnsom wɔ ne nan ntiaso hɔ.<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>‘<char style="nd">Awurade</char>, sɔre bra wʼahomegyebea,</para>
  <para style="q2" vid="PSA 132:8">wo ne wo tumi adaka no.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Ma trenee nyɛ sɛ ntade mma wʼasɔfo;</para>
  <para style="q2" vid="PSA 132:9">ma wʼahotefo nto ahurusi nnwom.’ ”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Wo somfo Dawid nti,</para>
  <para style="q2" vid="PSA 132:10">nyi wʼani mfi nea woasra no ngo no so.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>
    <char style="nd">Awurade</char> kaa ntam kyerɛɛ Dawid,</para>
  <para style="q2" vid="PSA 132:11">nokware ntam a ɔntwe nsan se,</para>
  <para style="q1" vid="PSA 132:11">“Wʼasefo no mu baako</para>
  <para style="q2" vid="PSA 132:11">na mede no bɛtena wʼahengua so.<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>Sɛ wo mmabarima di mʼapam so</para>
  <para style="q2" vid="PSA 132:12">na wotie me nkyerɛkyerɛ a,</para>
  <para style="q1" vid="PSA 132:12">ɛno de wɔn mmabarima bɛtena</para>
  <para style="q2" vid="PSA 132:12">wʼahengua so afebɔɔ.”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>
    <char style="nd">Awurade</char> ayi Sion,</para>
  <para style="q1" vid="PSA 132:13">ɔde hɔ ayɛ nʼatenae:<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“Ɛha ne mʼahomegyebea daa nyinaa;</para>
  <para style="q2" vid="PSA 132:14">ɛha na mɛtena adi hene, efisɛ ha na mepɛ,<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>mede nneɛma pa bebree behyira no</para>
  <para style="q2" vid="PSA 132:15">na mama nʼahiafo adidi amee.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Mede nkwagye befura nʼasɔfo,</para>
  <para style="q2" vid="PSA 132:16">na nʼahotewfo ato ahurusi nnwom daa.<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“Mɛma obirɛmpɔn bi apue wɔ Dawid ahenni mu,</para>
  <para style="q2" vid="PSA 132:17">na mede kanea asi hɔ ama nea masra no ngo no.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Mede aniwu befura nʼatamfo,</para>
  <para style="q2" vid="PSA 132:18">nanso wɔbɛhyɛ no ahenkyɛw a ɛhyerɛn.”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">Dwom 133</para>
  <para style="d">Ɔsoroforo dwom. Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Hwɛ oye a eye ne fɛ a ɛyɛ</para>
  <para style="q2" vid="PSA 133:1">sɛ anuanom bɔ mu tena faako!<verse eid="PSA 133:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Ɛte sɛ ngo a ɛsom bo a wɔahwie agu apampam,</para>
  <para style="q2" vid="PSA 133:2">na esian kogu bɔgyesɛ mu,</para>
  <para style="q1" vid="PSA 133:2">esian kogu Aaron bɔgyesɛ mu,</para>
  <para style="q2" vid="PSA 133:2">ma bi kogu nʼatade kɔn mu.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Ɛte sɛ Hermon bosu a</para>
  <para style="q2" vid="PSA 133:3">ɛtɔ gu Bepɔw Sion so.</para>
  <para style="q1" vid="PSA 133:3">Ɛhɔ na <char style="nd">Awurade</char> ahyɛ ne nhyira,</para>
  <para style="q2" vid="PSA 133:3">nkwa a to ntwa da no.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">Dwom 134</para>
  <para style="d">Ɔsoroforo dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>
    <char style="nd">Awurade</char> asomfo nyinaa, monkamfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 134:1">mo a mosom wɔ <char style="nd">Awurade</char> fi anadwo nyinaa.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Momma mo nsa so wɔ kronkronbea hɔ</para>
  <para style="q2" vid="PSA 134:2">na monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>
    <char style="nd">Awurade</char> a ɔbɔɔ ɔsoro ne asase no,</para>
  <para style="q2" vid="PSA 134:3">mfi Sion nhyira mo.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">Dwom 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">Monkamfo <char style="nd">Awurade</char> din;</para>
  <para style="q2" vid="PSA 135:1">monkamfo no, mo <char style="nd">Awurade</char> asomfo,<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>mo a mosom wɔ <char style="nd">Awurade</char> fi,</para>
  <para style="q2" vid="PSA 135:2">wɔ adiwo a ɛwɔ yɛn Nyankopɔn fi.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>Monkamfo <char style="nd">Awurade</char> efisɛ oye;</para>
  <para style="q2" vid="PSA 135:3">monto ayeyi nnwom mma ne din, na ɛno na ɛyɛ anisɔ.<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>
    <char style="nd">Awurade</char> ayi Yakob sɛ ɔnyɛ ne de,</para>
  <para style="q2" vid="PSA 135:4">wayi Israel sɛ nʼade a ɛsom bo.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Minim sɛ <char style="nd">Awurade</char> so;</para>
  <para style="q2" vid="PSA 135:5">Ɔso sen anyame nyinaa.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>
    <char style="nd">Awurade</char> yɛ nea ɔpɛ biara</para>
  <para style="q2" vid="PSA 135:6">wɔ ɔsoro ne asase so,</para>
  <para style="q2" vid="PSA 135:6">po ne mu bun nyinaa.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Ɔma omununkum ma ne ho so fi asase ano ba;</para>
  <para style="q2" vid="PSA 135:7">ɔsoma anyinam ka osu ho</para>
  <para style="q2" vid="PSA 135:7">na ɔma ahum tu fi ne koradan mu.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Okum Misraim mmakan,</para>
  <para style="q2" vid="PSA 135:8">nnipa ne mmoa mmakan.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Ɔsomaa ne nsɛnkyerɛnne ne nʼanwonwade baa mo mfimfini, Misraim,</para>
  <para style="q2" vid="PSA 135:9">de tiaa Farao ne nʼasomfo nyinaa.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>Ɔsɛee amanaman pii,</para>
  <para style="q2" vid="PSA 135:10">na okunkum ahemfo akɛse,<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>Amorifo hene, Sihon</para>
  <para style="q2" vid="PSA 135:11">Basan hene, Og</para>
  <para style="q2" vid="PSA 135:11">ne Kanaan ahemfo nyinaa,<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>na ɔde wɔn nsase maa sɛ agyapade</para>
  <para style="q2" vid="PSA 135:12">ɔde maa ne nkurɔfo Israelfo.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>
    <char style="nd">Awurade</char>, wo din wɔ hɔ daa.</para>
  <para style="q2" vid="PSA 135:13">
    <char style="nd">Awurade</char> wo din ahyeta awo ntoatoaso nyinaa mu.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>
    <char style="nd">Awurade</char> bedi ama ne nkurɔfo</para>
  <para style="q1" vid="PSA 135:14">na obehu nʼasomfo mmɔbɔ.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>Amanaman no ahoni yɛ dwetɛ ne sikakɔkɔɔ</para>
  <para style="q2" vid="PSA 135:15">a wɔde onipa nsa na ayɛ.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Wɔwɔ ano, nanso wontumi nkasa,</para>
  <para style="q2" vid="PSA 135:16">wɔwɔ ani, nanso wonhu ade;<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>wɔwɔ aso, nanso wɔnte asɛm,</para>
  <para style="q2" vid="PSA 135:17">na ɔhome nso nni wɔn anom.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Wɔn a wɔyɛɛ ahoni no bɛyɛ sɛ wɔn ara,</para>
  <para style="q2" vid="PSA 135:18">saa ara na wɔn a wɔde wɔn ho to wɔn so no bɛyɛ.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>Monkamfo <char style="nd">Awurade</char>, mo Israelfo nyinaa;</para>
  <para style="q2" vid="PSA 135:19">monkamfo <char style="nd">Awurade</char>, Aaron fi;<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>monkamfo <char style="nd">Awurade</char>, Lewi fi;</para>
  <para style="q2" vid="PSA 135:20">monkamfo <char style="nd">Awurade</char>, mo a musuro no.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Mumfi Sion nkamfo <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 135:21">monkamfo nea ɔte Yerusalem no.</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">Dwom 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>Monna <char style="nd">Awurade</char> ase na oye.</para>
  <para style="qr" vid="PSA 136:1">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Monna anyame mu Nyankopɔn no ase.</para>
  <para style="qr" vid="PSA 136:2">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Monna awuranom mu Awurade no ase.</para>
  <para style="qr" vid="PSA 136:3">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>Ɔno nko ara na ɔyɛ anwonwade akɛse.</para>
  <para style="qr" vid="PSA 136:4">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>Ɔno na ofi ne ntease mu bɔɔ ɔsoro.</para>
  <para style="qr" vid="PSA 136:5">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>Ɔno na ɔtrɛw asase mu de kataa nsu so.</para>
  <para style="qr" vid="PSA 136:6">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>Ɔno na ɔbɔɔ akanea akɛse no.</para>
  <para style="qr" vid="PSA 136:7">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>Ɔbɔɔ owia sɛ enni adekyee so.</para>
  <para style="qr" vid="PSA 136:8">Nʼadɔe wɔ hɔ daa;<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>Ɔbɔɔ sram ne nsoromma sɛ wonni adesae so no.</para>
  <para style="qr" vid="PSA 136:9">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>Ɔno na okunkum Misraimfo mmakan,</para>
  <para style="qr" vid="PSA 136:10">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>na oyii Israelfo fii wɔn mu no.</para>
  <para style="qr" vid="PSA 136:11">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>Ɔde nsa kɛse ne basa a wateɛ mu.</para>
  <para style="qr" vid="PSA 136:12">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>Ɔno na ɔpaee Po Kɔkɔɔ no mu no,</para>
  <para style="qr" vid="PSA 136:13">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>na ɔde Israelfo faa mfimfini no.</para>
  <para style="qr" vid="PSA 136:14">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>Nanso ɔpraa Farao ne nʼasraafo guu Po Kɔkɔɔ mu no.</para>
  <para style="qr" vid="PSA 136:15">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>Ɔno na odii ne nkurɔfo anim wɔ sare no so.</para>
  <para style="qr" vid="PSA 136:16">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>Ɔno na okum ahemfo akɛse no,</para>
  <para style="qr" vid="PSA 136:17">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>na okum ahemfo akunini no.</para>
  <para style="qr" vid="PSA 136:18">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>Okum Amorifo hene, Sihon,</para>
  <para style="qr" vid="PSA 136:19">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>ne Basanhene, Og.</para>
  <para style="qr" vid="PSA 136:20">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>Na ɔde wɔn nsase maa sɛ agyapade.</para>
  <para style="qr" vid="PSA 136:21">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>Ɔde maa ne somfo Israel sɛ agyapade.</para>
  <para style="qr" vid="PSA 136:22">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>Ɔkaee yɛn, yɛn mmerɛwyɛ mu.</para>
  <para style="qr" vid="PSA 136:23">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>Na ogyee yɛn fii yɛn atamfo nsam.</para>
  <para style="qr" vid="PSA 136:24">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>Ɔno na ɔma abɔde biara aduan.</para>
  <para style="qr" vid="PSA 136:25">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Monna ɔsorosoro Nyankopɔn no ase.</para>
  <para style="qr" vid="PSA 136:26">Nʼadɔe wɔ hɔ daa.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">Dwom 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>Babilonia nsubɔnten ho, ɛhɔ na yɛtena suu</para>
  <para style="q2" vid="PSA 137:1">bere a yɛkaee Sion no.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>Ɛhɔ konkɔn so nnua mu</para>
  <para style="q2" vid="PSA 137:2">na yɛde yɛn asanku sensɛnee,<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>ɛhɔ na yɛn nnommumfafo kaa se yɛnto nnwom,</para>
  <para style="q2" vid="PSA 137:3">yɛn ahohiafo hwehwɛɛ anigye nnwom fii yɛn nkyɛn;</para>
  <para style="q2" vid="PSA 137:3">wɔkae se, “Monto Sion nnwom baako nkyerɛ yɛn!”<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Ɛbɛyɛ dɛn na yɛatumi ato <char style="nd">Awurade</char> nnwom,</para>
  <para style="q2" vid="PSA 137:4">bere a yɛwɔ ananafo asase so?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>Yerusalem, sɛ me werɛ fi wo a</para>
  <para style="q2" vid="PSA 137:5">ma me nsa nifa werɛ mfi sankubɔ.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Sɛ mankae wo a,</para>
  <para style="q2" vid="PSA 137:6">ma me tɛkrɛma nka ntare mʼanom</para>
  <para style="q1" vid="PSA 137:6">sɛ mamfa Yerusalem</para>
  <para style="q2" vid="PSA 137:6">sɛ mʼanigyede kɛse pa ara a.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>Kae, <char style="nd">Awurade</char>, nea Edomfo yɛɛ</para>
  <para style="q2" vid="PSA 137:7">da a Yerusalem hwee ase no.</para>
  <para style="q1" vid="PSA 137:7">Wɔteɛɛ mu se, “Munnwiriw,</para>
  <para style="q2" vid="PSA 137:7">munnwiriw ngu fam nkɔka ne fapem!”<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>Ɔbabea Babilonia, wɔadome wo akɔ ɔsɛe mu,</para>
  <para style="q2" vid="PSA 137:8">nea otua wo ka bio ani gye</para>
  <para style="q2" vid="PSA 137:8">wɔ nea wode ayɛ yɛn no ho.<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>Nea ɔkyere wo nkokoaa</para>
  <para style="q2" vid="PSA 137:9">de wɔn dwiradwira abotan no ani gye.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">Dwom 138</para>
  <para style="d">Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>
    <char style="nd">Awurade</char>, mede me koma nyinaa ayi wo ayɛ;</para>
  <para style="q2" vid="PSA 138:1">mɛto wʼayeyi dwom wɔ “anyame” no anim.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Mede mʼani bɛkyerɛ wʼasɔredan kronkron no, akotow wo</para>
  <para style="q2" vid="PSA 138:2">na makamfo wo din</para>
  <para style="q2" vid="PSA 138:2">wɔ wʼadɔe a enni huammɔ ne wo nokwaredi nti,</para>
  <para style="q1" vid="PSA 138:2">efisɛ woama wʼahyɛde no so yiye;</para>
  <para style="q2" vid="PSA 138:2">ama asen wo titiriwyɛ.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Bere a misu frɛɛ wo no, wugyee me so;</para>
  <para style="q2" vid="PSA 138:3">woma minyaa akokoduru ne nnamyɛ.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>
    <char style="nd">Awurade</char>, sɛ ahemfo a wɔwɔ wiase nyinaa te nea woahyɛ no a,</para>
  <para style="q2" vid="PSA 138:4">ma wɔnkamfo wo.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Ma wɔnto <char style="nd">Awurade</char> akwan ho nnwom,</para>
  <para style="q2" vid="PSA 138:5">na <char style="nd">Awurade</char> anuonyam yɛ kɛse.<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Ɛwɔ mu sɛ <char style="nd">Awurade</char> wɔ ɔsorosoro de, nanso ɔhwɛ mmɔborɔfo,</para>
  <para style="q2" vid="PSA 138:6">na ahantanfo de, ohu wɔn wɔ akyirikyiri.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Ɛwɔ mu sɛ menam ɔhaw mu de,</para>
  <para style="q2" vid="PSA 138:7">nanso wobɔ me nkwa ho ban;</para>
  <para style="q1" vid="PSA 138:7">woteɛ wo nsa wɔ mʼatamfo abufuw so,</para>
  <para style="q2" vid="PSA 138:7">na wode wo nsa nifa gye me nkwa.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>
    <char style="nd">Awurade</char> bɛma nea wahyehyɛ ama me no aba mu;</para>
  <para style="q2" vid="PSA 138:8">
    <char style="nd">Awurade</char>, wʼadɔe wɔ hɔ daa,</para>
  <para style="q2" vid="PSA 138:8">nnyaa wo nsa ano nnwuma akyidi.</para>
  <para style="d" vid="PSA 138:8">Wɔde ma dwonkyerɛfo.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">Dwom 139</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>
    <char style="nd">Awurade</char>, woahwehwɛ me mu</para>
  <para style="q2" vid="PSA 139:1">na woahu me.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Wunim mʼasetena ne me sɔre;</para>
  <para style="q2" vid="PSA 139:2">wufi akyirikyiri hu mʼadwene mu.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Wunim mʼadifi ne me nnae mu;</para>
  <para style="q2" vid="PSA 139:3">wunim mʼakwan nyinaa mu.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Ansa na mebue mʼano akasa no</para>
  <para style="q2" vid="PSA 139:4">
    <char style="nd">Awurade</char>, na wunim ne nyinaa dedaw.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Woakata me ho nyinaa ahyia</para>
  <para style="q2" vid="PSA 139:5">na wobɔ me ho ban.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Saa nimdeɛ yi yɛ me nwonwa dodo,</para>
  <para style="q2" vid="PSA 139:6">ɛkɔ soro dodo ma me sɛ medu ho.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Ɛhe na metumi afi wo honhom anim akɔ?</para>
  <para style="q2" vid="PSA 139:7">Ɛhe na metumi aguan afi wʼanim akɔ?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Sɛ meforo soro a, wowɔ hɔ.</para>
  <para style="q2" vid="PSA 139:8">Na mekɔsɛw me kɛtɛ wɔ asaman a, wo ni.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Sɛ mede adekyee ntaban tu</para>
  <para style="q2" vid="PSA 139:9">na mekɔtena po akyi nohɔ a,<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>mpo hɔ na wo nsa begya me akɔ,</para>
  <para style="q2" vid="PSA 139:10">na wo nsa nifa beso me mu.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>Na meka se, “Ampa ara sum mmɛkata me so</para>
  <para style="q2" vid="PSA 139:11">na hann nnan adesae ntwa me ho nhyia a,”<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>sum mpo nyɛ sum mma wo;</para>
  <para style="q2" vid="PSA 139:12">na anadwo bɛhyerɛn sɛ awia;</para>
  <para style="q2" vid="PSA 139:12">sum ne hann yɛ wo pɛ.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Na wo na wobɔɔ me honhom</para>
  <para style="q2" vid="PSA 139:13">wonwen me wɔ me na awotwaa mu.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Mekamfo wo, efisɛ woyɛɛ me anwonwakwan so a ɛyɛ hu;</para>
  <para style="q2" vid="PSA 139:14">wo nnwuma yɛ nwonwa.</para>
  <para style="q2" vid="PSA 139:14">Minim ɛno yiye pa ara.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Wɔamfa me bɔbea anhintaw wo</para>
  <para style="q2" vid="PSA 139:15">bere a wɔyɛɛ me kokoa mu no;</para>
  <para style="q1" vid="PSA 139:15">bere a wɔnwenee me wɔ asase bun mu no,<verse eid="PSA 139:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 139:16"/>wʼani huu me, bere a meyɛ mogyatɔw no.</para>
  <para style="q1" vid="PSA 139:16">Nna dodow a woatwa ama me no,</para>
  <para style="q2" vid="PSA 139:16">wɔakyerɛw ne nyinaa wɔ wo nhoma mu</para>
  <para style="q2" vid="PSA 139:16">ansa na mu baako reba mu.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>Onyankopɔn, wo nsusuwii som bo ma me!</para>
  <para style="q2" vid="PSA 139:17">woka ne nyinaa bɔ mu a, ɛtrɛw dodo!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Sɛ mise mɛkan a,</para>
  <para style="q2" vid="PSA 139:18">ne dodow bɛboro mpoano nwea,</para>
  <para style="q1" vid="PSA 139:18">sɛ minyan a,</para>
  <para style="q2" vid="PSA 139:18">me ne wo wɔ hɔ ara.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>Sɛ anka, Onyankopɔn, wubekunkum amumɔyɛfo ɛ!</para>
  <para style="q1" vid="PSA 139:19">Mumfi me so, mo a moyɛ mogyapɛfo!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Wɔde adwemmɔne ka wo ho asɛm;</para>
  <para style="q2" vid="PSA 139:20">wʼatamfo mmmɔ wo din pa.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>
    <char style="nd">Awurade</char>, metan wɔn a wɔtan wo,</para>
  <para style="q2" vid="PSA 139:21">na mikyi wɔn a wɔsɔre tia wo no ana?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Minni hwee sɛ ɔtan a mewɔ ma wɔn;</para>
  <para style="q2" vid="PSA 139:22">mefa wɔn sɛ mʼatamfo.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Hwehwɛ me mu, Onyankopɔn, na hu me koma;</para>
  <para style="q2" vid="PSA 139:23">sɔ me hwɛ, na hu mʼadwene.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Hwɛ sɛ bɔne bi wɔ me mu a,</para>
  <para style="q2" vid="PSA 139:24">na di mʼanim fa daa nkwa kwan so.</para>
  <para style="d" vid="PSA 139:24">Wɔde ma dwonkyerɛfo.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">Dwom 140</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>
    <char style="nd">Awurade</char>, gye me fi nnebɔneyɛfo nsam;</para>
  <para style="q2" vid="PSA 140:1">bɔ me ho ban fi basabasayɛfo nsam,<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>wɔn a wodwen bɔne wɔ wɔn koma mu</para>
  <para style="q2" vid="PSA 140:2">na wɔhwanyan ɔko mu da biara.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Wɔsew wɔn tɛkrɛma ano te sɛ ɔwɔ de;</para>
  <para style="q2" vid="PSA 140:3">nhurutoa bɔre wɔ wɔn ano.<verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>
    <char style="nd">Awurade</char>, yi me fi amumɔyɛfo nsam;</para>
  <para style="q2" vid="PSA 140:4">bɔ me ho ban fi basabasayɛfo a</para>
  <para style="q2" vid="PSA 140:4">wodwen sɛ wobetwintwan mʼanan mu no ho.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Ahantanfo asum me afiri;</para>
  <para style="q2" vid="PSA 140:5">wɔatrɛtrɛw wɔn asau ahama mu</para>
  <para style="q2" vid="PSA 140:5">wɔasunsum me mfiri wɔ me kwan so.<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>
    <char style="nd">Awurade</char>, meka kyerɛ wo se, “Wone me Nyankopɔn.”</para>
  <para style="q2" vid="PSA 140:6">
    <char style="nd">Awurade</char>, tie me mmɔborɔsu.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>Otumfo <char style="nd">Awurade</char>, me gyefo hoɔdenfo,</para>
  <para style="q2" vid="PSA 140:7">wokata me ti so wɔ ɔko da,<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>nyɛ amumɔyɛfo abisade mma wɔn, <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 140:8">mma wɔn nhyehyɛe nnyɛ yiye.<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Wɔatwa me ho ahyia,</para>
  <para style="q2" vid="PSA 140:9">nanso, ma amumɔyɛsɛm a efi wɔn anom no nsɛe wɔn.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Ma nnyansramma ngu wɔn so;</para>
  <para style="q2" vid="PSA 140:10">ma wɔntow wɔn ngu ogya mu,</para>
  <para style="q2" vid="PSA 140:10">ngu dontori amoa mu a wɔrensɔre bio.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Mma dinsɛefo ase ntim asase no so;</para>
  <para style="q2" vid="PSA 140:11">ma amanehunu ntaataa kitikitiyɛfo.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Minim sɛ <char style="nd">Awurade</char> bu ahiafo atɛntrenee</para>
  <para style="q2" vid="PSA 140:12">na odi onnibi asɛm ma no.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Ampa ara, atreneefo bɛkamfo wo din</para>
  <para style="q2" vid="PSA 140:13">na wɔn a wɔnam tee no bɛtena nkwa mu wɔ wʼanim.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">Dwom 141</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>
    <char style="nd">Awurade</char>, misu frɛ wo, bra me nkyɛn ntɛm so.</para>
  <para style="q2" vid="PSA 141:1">Sɛ misu frɛ wo a, gye me so.<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Ma me mpaebɔ mmra wʼanim sɛ aduhuam;</para>
  <para style="q2" vid="PSA 141:2">ma me nsa a mema so no nyɛ sɛ anwummere afɔrebɔ.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>
    <char style="nd">Awurade</char>, ma ɔwɛmfo nwɛn mʼano;</para>
  <para style="q2" vid="PSA 141:3">na wɛn mʼano pon.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Mma wɔnntwe me koma nnkɔ nea ɛyɛ bɔne ho,</para>
  <para style="q2" vid="PSA 141:4">na ankɔyɛ nea amumɔyɛfo yɛ no bi,</para>
  <para style="q1" vid="PSA 141:4">mma me ne abɔnefo</para>
  <para style="q2" vid="PSA 141:4">nni wɔn nnɔkɔnnɔkɔwade.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Ma ɔtreneeni mmɔ me, ɛyɛ ayamye;</para>
  <para style="q2" vid="PSA 141:5">ma ɔnka mʼanim, ɛyɛ me ti so ngo.</para>
  <para style="q1" vid="PSA 141:5">Me ti rempo.</para>
  <para style="q2" vid="PSA 141:5">Me mpaebɔ da so tia abɔnefo nneyɛe daa.<verse eid="PSA 141:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>Wɔbɛtow wɔn sodifo afi ɔbotan so abɛhwe fam;</para>
  <para style="q2" vid="PSA 141:6">na amumɔyɛfo behu sɛ me nsɛm no yɛ nokware.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Wɔbɛka se, “Sɛnea obi funtum na otutu asase no,</para>
  <para style="q2" vid="PSA 141:7">saa ara na wɔabɔ yɛn nnompe ahwete ɔda ano.”<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Nanso Otumfo <char style="nd">Awurade</char>, mʼani wɔ wo so;</para>
  <para style="q2" vid="PSA 141:8">wo mu na mihintaw, nnyaw me mma owu.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Bɔ me ho ban fi mfiri a wɔasunsum me no ho,</para>
  <para style="q2" vid="PSA 141:9">mfiri a abɔnefo asunsum no.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Ma amumɔyɛfo no ankasa ɔtan nyi wɔn,</para>
  <para style="q2" vid="PSA 141:10">bere a mitwa mu kɔ dwoodwoo no.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">Dwom 142</para>
  <para style="d">Dawid de. Bere a na ɔwɔ ɔbodan mu no. Mpaebɔ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>Meteɛ mu su frɛ <char style="nd">Awurade</char>;</para>
  <para style="q2" vid="PSA 142:1">mema me nne so su frɛ <char style="nd">Awurade</char> sɛ onhu me mmɔbɔ.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Mihwie mʼahiasɛm gu nʼanim;</para>
  <para style="q2" vid="PSA 142:2">meka me haw kyerɛ no.<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>Sɛ me kra tɔ beraw wɔ me mu a,</para>
  <para style="q2" vid="PSA 142:3">ɛyɛ wo na wunim me kwan.</para>
  <para style="q1" vid="PSA 142:3">Ɔkwan a menam so no</para>
  <para style="q2" vid="PSA 142:3">nnipa asum me afiri.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Hwɛ na hu, obiara nni me nifa so;</para>
  <para style="q2" vid="PSA 142:4">mʼasɛm mfa obiara ho;</para>
  <para style="q1" vid="PSA 142:4">minni guankɔbea bi;</para>
  <para style="q2" vid="PSA 142:4">me nkwa mfa obiara ho.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>
    <char style="nd">Awurade</char>, misu frɛ wo;</para>
  <para style="q2" vid="PSA 142:5">mise, “Wone me guankɔbea,</para>
  <para style="q2" vid="PSA 142:5">me kyɛfa wɔ ateasefo asase so.”<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>Tie me sufrɛ,</para>
  <para style="q2" vid="PSA 142:6">na mewɔ ahohia kɛse mu;</para>
  <para style="q1" vid="PSA 142:6">gye me fi mʼataafo nsam,</para>
  <para style="q2" vid="PSA 142:6">efisɛ wɔn ho yɛ den sen me.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Yi me fi mʼafiase,</para>
  <para style="q2" vid="PSA 142:7">na makamfo wo din.</para>
  <para style="b" vid="PSA 142:7"/>
  <para style="q1" vid="PSA 142:7">Afei atreneefo betwa me ho ahyia</para>
  <para style="q2" vid="PSA 142:7">esiane wo papa a woayɛ me no nti.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">Dwom 143</para>
  <para style="d">Dawid dwom.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>
    <char style="nd">Awurade</char>, tie me mpaebɔ,</para>
  <para style="q2" vid="PSA 143:1">tie me mmɔborɔsu;</para>
  <para style="q1" vid="PSA 143:1">fi wo nokwaredi ne trenee mu</para>
  <para style="q2" vid="PSA 143:1">bra bɛboa me.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Mfa wʼakoa nkɔ atemmu mu,</para>
  <para style="q2" vid="PSA 143:2">na ɔteasefo biara nteɛ wɔ wʼanim.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Ɔtamfo no taa me,</para>
  <para style="q2" vid="PSA 143:3">ɔbɔ me hwe fam;</para>
  <para style="q1" vid="PSA 143:3">ɔma me tena sum mu</para>
  <para style="q2" vid="PSA 143:3">te sɛ wɔn a wowuwuu dedaada.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Ɛno nti me honhom atɔ beraw wɔ me mu;</para>
  <para style="q2" vid="PSA 143:4">na me koma di yaw wɔ me mu.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Mekae tete nna no;</para>
  <para style="q2" vid="PSA 143:5">midwinnwen wo nnwuma</para>
  <para style="q2" vid="PSA 143:5">ne nea wo nsa ayɛ nyinaa ho.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Mema me nsa so kyerɛ wo;</para>
  <para style="q2" vid="PSA 143:6">wo ho sukɔm de me kra sɛ asase kesee.<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>
    <char style="nd">Awurade</char>, gye me so ntɛm;</para>
  <para style="q2" vid="PSA 143:7">me honhom tɔ piti.</para>
  <para style="q1" vid="PSA 143:7">Mfa wʼanim nhintaw me</para>
  <para style="q2" vid="PSA 143:7">anyɛ saa a mɛyɛ sɛ wɔn a wɔkɔ amoa mu no.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Ma mente wʼadɔe a ɛnsa da no ho asɛm daa anɔpa,</para>
  <para style="q2" vid="PSA 143:8">na mede me ho ato wo so.</para>
  <para style="q1" vid="PSA 143:8">Kyerɛ me ɔkwan a memfa so,</para>
  <para style="q2" vid="PSA 143:8">na wo na mema me kra so kyerɛ.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>
    <char style="nd">Awurade</char> gye me fi mʼatamfo nsam,</para>
  <para style="q2" vid="PSA 143:9">na wo mu na mede me ho hintaw.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Kyerɛ me na menyɛ wʼapɛde,</para>
  <para style="q2" vid="PSA 143:10">na wo ne me Nyankopɔn;</para>
  <para style="q1" vid="PSA 143:10">ma wo honhom pa no</para>
  <para style="q2" vid="PSA 143:10">nkogya me asasetaw so.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>
    <char style="nd">Awurade</char>, wo din nti, kyɛe me nkwa so;</para>
  <para style="q2" vid="PSA 143:11">wo trenee mu, yi me fi ɔhaw mu.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Fi wʼadɔe a ɛnsa da no mu mua mʼatamfo ano;</para>
  <para style="q2" vid="PSA 143:12">na sɛe wɔn a wokyi me no nyinaa,</para>
  <para style="q2" vid="PSA 143:12">na meyɛ wo somfo.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">Dwom 144</para>
  <para style="d">Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>Nkamfo nka <char style="nd">Awurade</char>, me Botan,</para>
  <para style="q2" vid="PSA 144:1">nea ɔma me nsa akodi ho ntetewee,</para>
  <para style="q2" vid="PSA 144:1">ne me nsateaa ma ɔsa.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>Ɔyɛ mʼadɔe Nyankopɔn ne mʼabandennen,</para>
  <para style="q2" vid="PSA 144:2">me bammɔ ne me gyefo,</para>
  <para style="q1" vid="PSA 144:2">me kyɛm a mewɔ guankɔbea wɔ no mu,</para>
  <para style="q2" vid="PSA 144:2">ɔno na ɔka nnipa hyɛ mʼase.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>
    <char style="nd">Awurade</char>, hena ne onipa a wʼani ku no ho</para>
  <para style="q2" vid="PSA 144:3">onipa ba a wudwen ne ho yi?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Onipa te sɛ ɔhome;</para>
  <para style="q2" vid="PSA 144:4">ne nna te sɛ sunsuma a ɛretwa mu.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>
    <char style="nd">Awurade</char>, fi ɔsoro hɔ na sian bra fam;</para>
  <para style="q2" vid="PSA 144:5">fa wo nsa ka mmepɔw, na emfi wusiw.<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Soma anyinam na bɔ atamfo no hwete;</para>
  <para style="q2" vid="PSA 144:6">to wo mmɛmma no ma wonguan.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Teɛ wo nsa fi ɔsoro bra fam;</para>
  <para style="q2" vid="PSA 144:7">gye me na yi me</para>
  <para style="q1" vid="PSA 144:7">fi nsu akɛse ho,</para>
  <para style="q2" vid="PSA 144:7">fi ananafo nsam,<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>wɔn a atoro ayɛ wɔn anom ma,</para>
  <para style="q2" vid="PSA 144:8">na wɔn nsa nifa yɛ nnaadaa.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Onyankopɔn, mɛto dwom foforo ama wo;</para>
  <para style="q2" vid="PSA 144:9">mɛto dwom wɔ sanku a ahama du gu so so ama wo,<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>ama Ɔbaako a ɔde nkonimdi ma ahemfo,</para>
  <para style="q2" vid="PSA 144:10">na ogye ne somfo Dawid fi afoawerɛmfo ano.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Gye me na yi me fi</para>
  <para style="q2" vid="PSA 144:11">ananafo nsam,</para>
  <para style="q1" vid="PSA 144:11">wɔn a atoro ayɛ wɔn anom ma</para>
  <para style="q2" vid="PSA 144:11">na wɔn nsa nifa yɛ nnaadaa.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Afei yɛn mmabarima mmerantebere mu</para>
  <para style="q2" vid="PSA 144:12">bɛyɛ sɛ afifide a wɔahwɛ so yiye,</para>
  <para style="q1" vid="PSA 144:12">na yɛn mmabea bɛyɛ sɛ adum</para>
  <para style="q2" vid="PSA 144:12">a wɔasen de asiesie ahemfi.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Yɛn asan bɛyɛ amaama;</para>
  <para style="q2" vid="PSA 144:13">aduan ahorow biara bɛba so.</para>
  <para style="q1" vid="PSA 144:13">Yɛn nguan dodow so bɛto mpem mpem,</para>
  <para style="q2" vid="PSA 144:13">wɔn so bɛto mpem du du wɔ yɛn mfuw so;<verse eid="PSA 144:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14"/>yɛn anantwi bɛtwe nnesoa duruduru.</para>
  <para style="q1" vid="PSA 144:14">Wɔrennwiriw afasu,</para>
  <para style="q2" vid="PSA 144:14">yɛrenkɔ nkoasom mu,</para>
  <para style="q2" vid="PSA 144:14">na agyaadwotwa remma yɛn mmɔnten so.<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Nhyira nka nnipa a ɛbɛba mu saa ama wɔn.</para>
  <para style="q2" vid="PSA 144:15">Nhyira nka nnipa a wɔn Nyankopɔn ne <char style="nd">Awurade</char>.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">Dwom 145</para>
  <para style="d">Ayeyi dwom. Dawid de.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>Mɛma wo so, me Nyankopɔn, Ɔhenkɛse;</para>
  <para style="q2" vid="PSA 145:1">mɛkamfo wo din daa daa.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Da biara, mɛkamfo wo;</para>
  <para style="q2" vid="PSA 145:2">na mama wo din so daa daa.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>
    <char style="nd">Awurade</char> so, na ɔsɛ nkamfo kɛse;</para>
  <para style="q2" vid="PSA 145:3">obiara ntumi nsusuw ne kɛseyɛ.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Awo ntoatoaso baako bɛkamfo wo nnwuma akyerɛ afoforo;</para>
  <para style="q2" vid="PSA 145:4">wɔbɛka wo nnwuma akɛse ho asɛm.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Wɔbɛka wʼanuonyam ne wo tumi a ɛheran no ho asɛm,</para>
  <para style="q2" vid="PSA 145:5">na mɛdwene wʼanwonwadwuma ho.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Wɔbɛka wo nnwuma a ɛyɛ hu no mu tumi ho asɛm;</para>
  <para style="q2" vid="PSA 145:6">na mapae mu aka wo nneyɛe akɛse no akyerɛ.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Wɔbɛhyɛ wo papayɛ mmoroso no ho fa,</para>
  <para style="q2" vid="PSA 145:7">na wɔde anigye ato wo trenee ho dwom.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>
    <char style="nd">Awurade</char> yɛ ɔdomfo ne mmɔborɔhunufo;</para>
  <para style="q2" vid="PSA 145:8">ne bo kyɛ fuw na nʼadɔe dɔɔso.<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>
    <char style="nd">Awurade</char> ye ma obiara;</para>
  <para style="q2" vid="PSA 145:9">na ɔwɔ ahummɔbɔ ma nʼabɔde nyinaa.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>
    <char style="nd">Awurade</char>, wʼabɔde nyinaa bɛkamfo wo;</para>
  <para style="q2" vid="PSA 145:10">na wʼahotefo bɛma wo so.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Wɔbɛka wʼahenni no anuonyam ho asɛm</para>
  <para style="q2" vid="PSA 145:11">na wɔaka wo mmaninyɛ ho asɛm,<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>sɛ ɛbɛyɛ a nnipa behu wo nnwuma akɛse</para>
  <para style="q2" vid="PSA 145:12">ne wʼahenni anuonyam a ɛheran no.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Wʼahenni yɛ daa ahenni,</para>
  <para style="q2" vid="PSA 145:13">na wo tumidi wɔ hɔ ma awo ntoantoaso nyinaa.</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">
    <char style="nd">Awurade</char> di ne bɔhyɛ nyinaa so,</para>
  <para style="q2" vid="PSA 145:13">na ɔwɔ ɔdɔ ma biribiara a wayɛ.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>
    <char style="nd">Awurade</char> wowaw wɔn a wɔhwe ase</para>
  <para style="q2" vid="PSA 145:14">na ɔpagyaw wɔn a wɔn nnesoa ama wɔakom.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Aniwa nyinaa hwɛ wo kwan,</para>
  <para style="q2" vid="PSA 145:15">na woma wɔn, wɔn aduan wɔ ne bere mu.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Wubue wo nsam,</para>
  <para style="q2" vid="PSA 145:16">na woma biribiara a ɛwɔ nkwa no nʼapɛde.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>
    <char style="nd">Awurade</char> teɛ wɔ nʼakwan nyinaa mu;</para>
  <para style="q2" vid="PSA 145:17">na ɔyɛ adɔe ma nea wayɛ nyinaa.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>
    <char style="nd">Awurade</char> bɛn wɔn a wɔfrɛ no nyinaa,</para>
  <para style="q2" vid="PSA 145:18">wɔn a wɔfrɛ no nokware mu nyinaa.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>Ɔyɛ wɔn a wosuro no no apɛde ma wɔn;</para>
  <para style="q2" vid="PSA 145:19">otie wɔn sufrɛ na ogye wɔn.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>
    <char style="nd">Awurade</char> hwɛ wɔn a wɔdɔ no no nyinaa so,</para>
  <para style="q2" vid="PSA 145:20">nanso amumɔyɛfo de, ɔbɛsɛe wɔn nyinaa.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Mʼano bɛkamfo <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 145:21">Ma abɔde nyinaa nkamfo ne din kronkron no</para>
  <para style="q2" vid="PSA 145:21">daa daa.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">Dwom 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q2" vid="PSA 146:1">Me kra, kamfo <char style="nd">Awurade</char>!<verse eid="PSA 146:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>Mɛkamfo <char style="nd">Awurade</char> me nkwanna nyinaa;</para>
  <para style="q2" vid="PSA 146:2">mɛto ayeyi dwom ama me Nyankopɔn, sɛ mete ase yi.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Mommfa mo ho nto mmapɔmma so,</para>
  <para style="q2" vid="PSA 146:3">adesamma a wɔrentumi nnye nkwa.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>Sɛ wɔn honhom tu kɔ a, wɔsan kɔ dɔte mu,</para>
  <para style="q2" vid="PSA 146:4">saa da no ara wɔn nsusuwii nyinaa yɛ ɔkwa.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Nhyira ne nea ne boafo ne Yakob Nyankopɔn,</para>
  <para style="q2" vid="PSA 146:5">nea nʼanidaso wɔ <char style="nd">Awurade</char>, ne Nyankopɔn mu.<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>Ɔno ne ɔsoro ne asase Yɛfo,</para>
  <para style="q2" vid="PSA 146:6">po ne biribiara a ɛwɔ mu nyinaa</para>
  <para style="q2" vid="PSA 146:6">
    <char style="nd">Awurade</char> a ɔyɛ nokwafo daa no.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Odi ma wɔn a wɔhyɛ wɔn so,</para>
  <para style="q2" vid="PSA 146:7">na ɔma wɔn a ɔkɔm de wɔn aduan.</para>
  <para style="q2" vid="PSA 146:7">
    <char style="nd">Awurade</char> gyaa nneduafo,<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>
    <char style="nd">Awurade</char> ma anifuraefo hu ade.</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">Awurade</char> ma wɔn a wɔakom no so,</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">Awurade</char> dɔ atreneefo.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>
    <char style="nd">Awurade</char> hwɛ ahɔho so,</para>
  <para style="q2" vid="PSA 146:9">na ɔwowaw ayisaa ne akunafo,</para>
  <para style="q2" vid="PSA 146:9">na amumɔyɛfo akwan de, ɔdan ani.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>
    <char style="nd">Awurade</char> di hene daa daa,</para>
  <para style="q2" vid="PSA 146:10">Ao, Sion, wo Nyankopɔn, wɔ awo ntoatoaso nyinaa so.</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">Dwom 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">Eye sɛ wɔto ayeyi nnwom ma yɛn Nyankopɔn,</para>
  <para style="q1" vid="PSA 147:1">ɛyɛ fɛ na ɛfata dodo sɛ wɔkamfo no!<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>
    <char style="nd">Awurade</char> kyekyere Yerusalem;</para>
  <para style="q2" vid="PSA 147:2">Ɔboaboa Israel nnommum ano.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Ɔsa wɔn a wɔn koma abotow no yare,</para>
  <para style="q2" vid="PSA 147:3">na ɔkyekyere wɔn akuru.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>Ɔkyerɛ nsoromma dodow a ɛwɔ hɔ,</para>
  <para style="q2" vid="PSA 147:4">na ɔde obiara din frɛ no.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Yɛn <char style="nd">Awurade</char> so, na ne tumi yɛ kɛse;</para>
  <para style="q2" vid="PSA 147:5">yɛrente nʼase nwie.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>
    <char style="nd">Awurade</char> wowaw ahobrɛasefo</para>
  <para style="q2" vid="PSA 147:6">na ɔtotow amumɔyɛfo hwehwe fam.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Monto aseda nnwom mma <char style="nd">Awurade</char>.</para>
  <para style="q2" vid="PSA 147:7">Momfa sanku nto dwom mma yɛn Nyankopɔn.<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>Ɔde omununkum kata ɔsoro ani;</para>
  <para style="q2" vid="PSA 147:8">ɔma asase osu</para>
  <para style="q2" vid="PSA 147:8">ma sare nyin wɔ nkoko so.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Ɔma anantwi aduan,</para>
  <para style="q2" vid="PSA 147:9">na sɛ kwaakwaadabimma su a, ɔma wɔn aduan.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>Ɛnyɛ ɔpɔnkɔ ahoɔden na nʼani sɔ</para>
  <para style="q2" vid="PSA 147:10">na ɛnyɛ onipa ahoɔden nso.<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>Na mmom, <char style="nd">Awurade</char> ani sɔ nnipa a wosuro no,</para>
  <para style="q2" vid="PSA 147:11">wɔn a wɔde wɔn ho to nʼadɔe a ɛnsa da no so no.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Momma <char style="nd">Awurade</char> so, Yerusalem;</para>
  <para style="q2" vid="PSA 147:12">kamfo wo Nyankopɔn, Sion,<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>ɔma wʼapon akyi adaban yɛ den,</para>
  <para style="q2" vid="PSA 147:13">na ohyira wo nkurɔfo a wɔte wo mu.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>Ɔma wʼahye so dwo,</para>
  <para style="q1" vid="PSA 147:14">na ɔde awi ankasa ma wo.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>Ɔsoma nʼahyɛde kɔ asase so;</para>
  <para style="q2" vid="PSA 147:15">nʼasɛm tu mmirika ntɛm so.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>Ɔtrɛw sukyerɛmma mu sɛ oguan ho nwi,</para>
  <para style="q2" vid="PSA 147:16">na ɔpete obosu sukyerɛmma sɛ nsõ.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>Ɔtotow mparuwbo gu fam sɛ mmosea.</para>
  <para style="q2" vid="PSA 147:17">Hena na obetumi agyina nʼawɔw dennen no ano?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>Ɔsoma nʼasɛm no ma ɛnan no;</para>
  <para style="q2" vid="PSA 147:18">ɔhwanyan ne mframa, na nsu sen.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>Wada nʼasɛm adi akyerɛ Yakob,</para>
  <para style="q2" vid="PSA 147:19">ne mmara ne ɔhyɛ nsɛm akyerɛ Israel.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>Ɔnyɛɛ eyi maa ɔman foforo biara ɛ;</para>
  <para style="q2" vid="PSA 147:20">wonnim ne mmara.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">Monkamfo <char style="nd">Awurade</char>!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">Dwom 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>Monkamfo <char style="nd">Awurade</char>!</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">Monkamfo <char style="nd">Awurade</char> mfi ɔsorosoro,</para>
  <para style="q2" vid="PSA 148:1">monkamfo no wɔ ɔsoro sorɔnsorɔmmea.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Nʼabɔfo nyinaa, monkamfo no,</para>
  <para style="q2" vid="PSA 148:2">ne ɔsoro asafo nyinaa, monkamfo no.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Owia ne ɔsram, monkamfo no,</para>
  <para style="q2" vid="PSA 148:3">nsoromma a ɛhyerɛn nyinaa, monkamfo no.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Monkamfo no, ɔsoro mu soro</para>
  <para style="q2" vid="PSA 148:4">ne mo nsu a mowɔ ɔsoro atifi.<verse eid="PSA 148:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Momma wɔn nyinaa nkamfo <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="PSA 148:5">efisɛ ɔno na ɔhyɛ ma wɔbɔɔ wɔn.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>Ɔde wɔn sisii hɔ afebɔɔ;</para>
  <para style="q2" vid="PSA 148:6">na ɔmaa ɔhyɛ nsɛm bi a ɛrentwa mu da.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Monkamfo <char style="nd">Awurade</char> mfi asase so,</para>
  <para style="q2" vid="PSA 148:7">mo po kɛse mu abɔde ne po bun nyinaa,<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>anyinam ne mparuwbo, sukyerɛmma ne omununkum,</para>
  <para style="q2" vid="PSA 148:8">ahum a moyɛ nʼapɛde,<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>mo mmepɔw ne nkoko nyinaa,</para>
  <para style="q2" vid="PSA 148:9">nnua a ɛsow aba ne sida nyinaa,<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>nwura mu mmoa ne anantwi,</para>
  <para style="q2" vid="PSA 148:10">abɔde nketewa ne nnomaa a wotu,<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>asase ne amanaman nyinaa so ahemfo,</para>
  <para style="q2" vid="PSA 148:11">mo mmapɔmma ne asase sodifo nyinaa,<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>mmerante ne mmabaa,</para>
  <para style="q2" vid="PSA 148:12">mmasiriwa ne mmofra nso.<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Ma wɔnkamfo <char style="nd">Awurade</char> din,</para>
  <para style="q2" vid="PSA 148:13">na ne din so sen din biara;</para>
  <para style="q2" vid="PSA 148:13">nʼanuonyam korɔn wɔ asase ne ɔsoro so.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Wapagyaw mmɛn bi ama ne nkurɔfo,</para>
  <para style="q2" vid="PSA 148:14">nʼahotewfo nyinaa nkamfo;</para>
  <para style="q2" vid="PSA 148:14">Israelfo, nnipa a wɔda ne koma so no nkamfo.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">Dwom 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">Monto dwom foforo mma <char style="nd">Awurade</char>,</para>
  <para style="q2" vid="PSA 149:1">monkamfo no wɔ ahotefo asafo mu.<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Ma Israel ani nnye ne Yɛfo mu.</para>
  <para style="q2" vid="PSA 149:2">Ma Sion mma ani nnye wɔn Hene mu.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Ma wɔmfa asaw nkamfo ne din</para>
  <para style="q2" vid="PSA 149:3">na wɔmfa sanku ne akasaa nto dwom mma no.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>Na <char style="nd">Awurade</char> ani sɔ ne nkurɔfo;</para>
  <para style="q2" vid="PSA 149:4">ɔde nkwagye kyɛw hyɛ ahobrɛasefo.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Momma ahotefo nni ahurusi wɔ anuonyam yi mu;</para>
  <para style="q2" vid="PSA 149:5">na wɔnto ahosɛpɛw dwom wɔ wɔn mpa so.<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Onyankopɔn nkamfo nhyɛ wɔn anom,</para>
  <para style="q2" vid="PSA 149:6">na ɛnyɛ afoa anofanu wɔ wɔn nsam,<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>sɛ wɔmfa ntɔ were wɔ amanaman no so</para>
  <para style="q2" vid="PSA 149:7">ne asotwe wɔ nnipa no so,<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>sɛ wɔmfa nyɛ nkɔnsɔnkɔnsɔn nkyekyere wɔn ahemfo,</para>
  <para style="q2" vid="PSA 149:8">ne dade mpokyerɛ ngu wɔn atitiriw,<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>sɛ wɔmfa mmu atɛn, sɛnea wɔakyerɛw atia wɔn no.</para>
  <para style="q2" vid="PSA 149:9">Eyi ne nʼahotewfo nyinaa anuonyam.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">Dwom 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Monkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">Monkamfo <char style="nd">Awurade</char> wɔ ne kronkronbea;</para>
  <para style="q2" vid="PSA 150:1">monkamfo no wɔ ɔsoro tumi mu.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Monkamfo no wɔ ne tumi mu nneyɛe ho;</para>
  <para style="q2" vid="PSA 150:2">monkamfo no wɔ ne kɛseyɛ a ɛboro biribiara so no ho.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Momfa torobɛnto nnyigyei nkamfo no,</para>
  <para style="q2" vid="PSA 150:3">momfa asanku ne bɛnta nkamfo no,<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>momfa akasaa ne asaw nkamfo no,</para>
  <para style="q2" vid="PSA 150:4">momfa sankuten ne atɛntɛbɛn nkamfo no,<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>momfa kyɛnkyɛn mmobɔmu so nkamfo no,</para>
  <para style="q2" vid="PSA 150:5">momfa kyɛnkyɛn nnyigyei nkamfo no.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Momma nea ɛhome nyinaa nkamfo <char style="nd">Awurade</char>.</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">Monkamfo <char style="nd">Awurade</char>.<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
