<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Akuapem Twi Contemporary Bible 2020</book>
  <para style="h">Obadia</para>
  <para style="toc1">Odiyifo Obadia Nhoma</para>
  <para style="toc2">Obadia</para>
  <para style="toc3">Oba</para>
  <para style="mt2">Odiyifo</para>
  <para style="mt1">Obadia</para>
  <para style="mt2">Nhoma</para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="s1">Edom Atemmu Ho Nkɔmhyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>Anisoadehu a <char style="nd">Awurade</char> Nyankopɔn daa no adi faa Edom asase ho kyerɛɛ Obadia ni:</para>
  <para style="q1" vid="OBA 1:1">Yɛate asɛm a efi <char style="nd">Awurade</char> nkyɛn.</para>
  <para style="q2" vid="OBA 1:1">Wɔsomaa ɔnanmusini bi kɔɔ aman so kɔkae se,</para>
  <para style="q1" vid="OBA 1:1">“Monsɔre na momma yɛnkɔko ntia Edom.”<verse eid="OBA 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2"/>
    <char style="nd">Awurade</char> ka kyerɛ Edom se:</para>
  <para style="q1" vid="OBA 1:2">“Hwɛ, mɛbrɛ wo ase.</para>
  <para style="q2" vid="OBA 1:2">Mɛyɛ wo ketewa wɔ aman no mu,</para>
  <para style="q2" vid="OBA 1:2">na wɔabu wo animtiaa.<verse eid="OBA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3"/>Wayɛ ahantan adaadaa wo ho,</para>
  <para style="q2" vid="OBA 1:3">Wo a wote abotan ntokuru mu</para>
  <para style="q1" vid="OBA 1:3">na woayɛ wʼatenae wɔ mmepɔw so,</para>
  <para style="q2" vid="OBA 1:3">na woka kyerɛ wo ho se,</para>
  <para style="q2" vid="OBA 1:3">‘Hena na obetumi ayi me asi fam?’<verse eid="OBA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4"/>Sɛ wutu kɔ wim sɛ akɔre,<note caller="+" style="f"><char style="fr" closed="false">1.4 </char><char style="ft" closed="false">Ɔkɔre. Anomaa a obu ne ho sɛ ɔhene na ɔwɔ ahoɔden a otumi de tu kɔ akyirikyiri na otumi hu ade kann nso. (<char style="xt"><ref loc="DEU 28:49">5 Mose 28.49</ref>; <ref loc="ISA 40:31">Yes 40.31</ref>; <ref loc="JER 4:13">Yer 4.13</ref>; <ref loc="JER 49:22">49.22</ref>; <ref loc="EZK 17:3">Hes 17.3</ref></char>).</char></note></para>
  <para style="q1" vid="OBA 1:4">na woyɛ wo berebuw wɔ nsoromma ntam mpo a,</para>
  <para style="q2" vid="OBA 1:4">hɔ na mɛba abɛtwe wo adwira fam.”</para>
  <para style="q1" vid="OBA 1:4">Sɛnea <char style="nd">Awurade</char> se ni.<verse eid="OBA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5"/>“Sɛ akorɔmfo ba wo so,</para>
  <para style="q2" vid="OBA 1:5">anaa adwowtwafo ba wo so anadwo a,</para>
  <para style="q1" vid="OBA 1:5">atoyerɛnkyɛm bɛn na ɛrento wo?</para>
  <para style="q2" vid="OBA 1:5">Na wɔrennwia wo nneɛma dodow a wɔpɛ ana?</para>
  <para style="q1" vid="OBA 1:5">Sɛ bobe abatewfo ba wo so a,</para>
  <para style="q2" vid="OBA 1:5">ɛnyɛ bobe aba kakraa bi pɛ na wobegyaw ama wo ana?<verse eid="OBA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6"/>Na wo Esau de, wobewia wʼademude</para>
  <para style="q2" vid="OBA 1:6">a wode asie na wɔayɛ wo dosodoso.<verse eid="OBA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7"/>Wɔn a wo ne wɔn wɔ nkabom nyinaa</para>
  <para style="q2" vid="OBA 1:7">bedi wo huammɔ.</para>
  <para style="q1" vid="OBA 1:7">Wɔn a wʼadwene yɛ wo sɛ</para>
  <para style="q2" vid="OBA 1:7">wo ne wɔn te asomdwoe mu no</para>
  <para style="q1" vid="OBA 1:7">bɛdaadaa wo adi wo so,</para>
  <para style="q2" vid="OBA 1:7">wɔn a wodi wʼaduan no asum wo afiri,</para>
  <para style="q2" vid="OBA 1:7">nanso, wunhui.<verse eid="OBA 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8"/>“Saa da no,” <char style="nd">Awurade</char> na ose,</para>
  <para style="q2" vid="OBA 1:8">“Merensɛe anyansafo a wɔwɔ Edom ana,</para>
  <para style="q1" vid="OBA 1:8">mmarima a wɔte asɛm ase</para>
  <para style="q2" vid="OBA 1:8">a wɔwɔ Esau mmepɔw so ana?<verse eid="OBA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9"/>Teman<note caller="+" style="f"><char style="fr" closed="false">1.9 </char><char style="ft" closed="false">Teman: Teman kyerɛ Edom nyinaa sɛnea Yeremia ka wɔ 49.7, 20. Teman nkyerɛase yɛ “anafo.” Saa din yi tumi yɛ Edom a ɛyɛ anafo asase. Ebinom nso kyerɛ Teman ase se Tawilan a ɛda borɔfokwansin abiɛsa wɔ Petra apuei fam.</char></note> wʼakofo bɛbɔ hu</para>
  <para style="q1" vid="OBA 1:9">ne obiara a ɔwɔ Esau bepɔw so no,</para>
  <para style="q2" vid="OBA 1:9">wobetwitwa mo atɔre mo ase.<verse eid="OBA 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10"/>Esiane basabasayɛ a woyɛ tiaa wo nua Yakob no nti</para>
  <para style="q1" vid="OBA 1:10">aniwu bɛka wo,</para>
  <para style="q2" vid="OBA 1:10">na wɔbɛsɛe wo koraa.<verse eid="OBA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11"/>Da a wugyinaa ntentenso hwɛɛ no haa,</para>
  <para style="q1" vid="OBA 1:11">maa ananafo faa nʼahonyade kɔe</para>
  <para style="q2" vid="OBA 1:11">na ahɔho hyɛn ne kurow apon mu,</para>
  <para style="q1" vid="OBA 1:11">na wɔbɔɔ Yerusalem so ntonto no,</para>
  <para style="q2" vid="OBA 1:11">na wote sɛ wɔn mu baako.<verse eid="OBA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12"/>Anka ɛnsɛ sɛ wubu wo nua animtiaa</para>
  <para style="q2" vid="OBA 1:12">bere a ɔwɔ asiane mu,</para>
  <para style="q1" vid="OBA 1:12">anaa sɛ wudi ahurusi wɔ Yudafo so</para>
  <para style="q2" vid="OBA 1:12">bere a wɔwɔ ɔsɛe mu,</para>
  <para style="q1" vid="OBA 1:12">na mpo wohoahoa wo ho</para>
  <para style="q2" vid="OBA 1:12">bere a wɔwɔ ahohia mu no.<verse eid="OBA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13"/>Anka ɛnsɛ sɛ wode nsrabɔ</para>
  <para style="q2" vid="OBA 1:13">hyɛn me nkurɔfo kurow apon no mu</para>
  <para style="q1" vid="OBA 1:13">wɔ wɔn amanehunuda,</para>
  <para style="q1" vid="OBA 1:13">anka ɛnsɛ sɛ woserew wɔ bere a</para>
  <para style="q2" vid="OBA 1:13">wɔwɔ ɔhaw mu.</para>
  <para style="q1" vid="OBA 1:13">Afei nso anka ɛnsɛ sɛ</para>
  <para style="q2" vid="OBA 1:13">wode wo nsa to wɔn ahode so gye</para>
  <para style="q2" vid="OBA 1:13">wɔ bere a wɔwɔ amanehunu mu.<verse eid="OBA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14"/>Anka ɛnsɛ sɛ wotɛw wɔn nkwantanan so</para>
  <para style="q2" vid="OBA 1:14">kunkum nʼaguanfo</para>
  <para style="q1" vid="OBA 1:14">Na wuyi wɔn a aka no ma</para>
  <para style="q2" vid="OBA 1:14">wɔ wɔn amanehunuda no mu.<verse eid="OBA 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15"/>“<char style="nd">Awurade</char> da no abɛn</para>
  <para style="q2" vid="OBA 1:15">ama amanaman nyinaa.</para>
  <para style="q1" vid="OBA 1:15">Na hwɛ, Edom, sɛnea woyɛɛ no</para>
  <para style="q2" vid="OBA 1:15">saa ara na wɔbɛyɛ wo.</para>
  <para style="q1" vid="OBA 1:15">Wo nneyɛe bɛsan abegu wʼapampam.<verse eid="OBA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16"/>Sɛnea mononom nsã wɔ me bepɔw kronkron so no,</para>
  <para style="q1" vid="OBA 1:16">saa ara na amanaman no nyinaa bɛkɔ so anom,</para>
  <para style="q2" vid="OBA 1:16">saa ara na ɛbɛkɔ so da biara</para>
  <para style="q2" vid="OBA 1:16">na wɔbɛyɛ te sɛ nea wonni hɔ.<verse eid="OBA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17"/>Na ogye bɛba Sion bepɔw so</para>
  <para style="q2" vid="OBA 1:17">na ɛbɛyɛ kronkronbea,</para>
  <para style="q1" vid="OBA 1:17">na Yakob nsa</para>
  <para style="q2" vid="OBA 1:17">bɛsan aka nʼagyapade.<verse eid="OBA 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18"/>Yakob bɛyɛ ogya</para>
  <para style="q2" vid="OBA 1:18">na Yosef ayɛ ogyatannaa;</para>
  <para style="q1" vid="OBA 1:18">Esau bɛyɛ adehunu bi</para>
  <para style="q2" vid="OBA 1:18">na wɔde no bɛto ogya so ahyew no a</para>
  <para style="q1" vid="OBA 1:18">obiara renka wɔ Esau ase.”</para>
  <para style="q2" vid="OBA 1:18">Nea <char style="nd">Awurade</char> se ni.<verse eid="OBA 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19"/>Nkurɔfo a wofi Negeb no</para>
  <para style="q2" vid="OBA 1:19">bɛtena Esau mmepɔw so,</para>
  <para style="q1" vid="OBA 1:19">Na wɔn a wofi nkoko no ase no,</para>
  <para style="q2" vid="OBA 1:19">bɛfa Filisti asase no,</para>
  <para style="q1" vid="OBA 1:19">na wɔbɛfa Efraim ne Samaria mfuw atena so,</para>
  <para style="q2" vid="OBA 1:19">na Benyamin nso afa Gilead.<verse eid="OBA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20"/>Nnipakuw yi a wɔyɛ Israelfo a wotwaa wɔn asu kɔɔ Kanaan no</para>
  <para style="q2" vid="OBA 1:20">bɛfa Kanaan asase no akosi Sarefat;</para>
  <para style="q1" vid="OBA 1:20">na Yerusalemfo a wotwaa wɔn asu a</para>
  <para style="q2" vid="OBA 1:20">wɔte Safarad no bɛfa Negeb nkurow no adi so.<verse eid="OBA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21"/>Agyefo bɛkɔ Sion bepɔw so,</para>
  <para style="q2" vid="OBA 1:21">akodi Edom mmepɔw no so.</para>
  <para style="q2" vid="OBA 1:21">Na ahenni no bɛyɛ <char style="nd">Awurade</char> de!<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
